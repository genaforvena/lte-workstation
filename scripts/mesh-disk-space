#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# mesh-disk-space — LOCAL FILESYSTEM SPACE & INODE usage sense (WORST mount, named).
# Scans every real local mount (df -P -T), takes the worst block% and worst inode%, and tests
# writeability of $HOME/.mesh.
# Why it matters:
#   - Disk exhaustion (100% blocks) halts database writes, logging, and sync tools.
#   - Inode exhaustion (100% inodes) prevents creating new files even with gigabytes free.
#   - Read-only filesystem remounts (due to ext4 / storage faults) drop the node into a zombie state.
#
# WHY ALL MOUNTS, NOT JUST $HOME's (2026-08-15, phaedra incident — the /tmp blindness):
#   this sense read `df -P "$HOME"` ALONE, i.e. exactly one filesystem. phaedra hit 100% /tmp
#   (59,234 leaked shell-mktemp files) — every write to /tmp failing — while this sense read its
#   root fs (58G, 88%) and published NORMAL, and mesh-storage-health fused that into
#   'HEALTHY|capacity=NORMAL' on the same box at the same moment. Nothing was wrong with the
#   reading: it was an honest claim about a DIFFERENT filesystem than the one that was broken.
#   A node's storage is not one number, and $HOME is not the only fs its tools write to (/tmp,
#   /var/tmp, /dev/shm, /boot all break things when full). So: enumerate, take the worst, and
#   NAME THE MOUNT in the reason — an unattributed 'use=96%' is the same class of mistake, one
#   level down. Exclusions are deliberate: read-only images (squashfs/iso9660) sit at 100% by
#   construction and would fake a permanent CRITICAL, and mounts below MIN_KB (64 MiB — /run/lock
#   at 5 MiB, efivarfs at 128 KiB) are pseudo-scratch whose percentage is noise, not capacity.
#
# Usage:
#   mesh-disk-space           one-shot status check
#   mesh-disk-space --json    machine-readable JSON
#   mesh-disk-space --edge    emit only on label change (reflex cron)
#   mesh-disk-space --test    smoke test (synthetic fixtures + real read gate)
#
# Exit codes:
#   0 = state assessed
#   2 = disk status unreadable / df failed — never faked

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.disk-space.state"
TEST_FILE="$HOME/.mesh/.fs_write_test_$$"
WRITE_SOFT_S="${MESH_DISK_WRITE_SOFT_S:-2}"
WRITE_HARD_S="${MESH_DISK_WRITE_HARD_S:-15}"
MIN_KB="${MESH_DISK_MIN_KB:-65536}"   # ignore mounts under 64 MiB (see header)
DF_X="-x squashfs -x iso9660 -x devtmpfs -x efivarfs -x tracefs -x fuse.snapfuse -x fuse.portal"

# mount_rows → one row per real local mount: "<mount> <size1k> <use_pct> <inode_pct>"
# (inode_pct is "-" for filesystems that don't report inodes, e.g. btrfs — that is a missing
#  AXIS on one mount, never a missing reading for the node.)
mount_rows() {
  local bt it
  bt="$(df -P -T $DF_X 2>/dev/null | tail -n +2)"
  [ -n "$bt" ] || bt="$(df -P -T 2>/dev/null | tail -n +2)"    # ancient df without -x
  [ -n "$bt" ] || return 1
  it="$(df -P -T -i $DF_X 2>/dev/null | tail -n +2)"
  [ -n "$it" ] || it="$(df -P -T -i 2>/dev/null | tail -n +2)"
  awk 'NR==FNR { gsub(/%/,"",$6); ip[$NF]=$6; next }
       { gsub(/%/,"",$6); print $NF, $3, $6, (($NF in ip) ? ip[$NF] : "-") }' \
      <(printf '%s\n' "$it") <(printf '%s\n' "$bt")
}

# scan_rows <min_kb> — PURE: reads mount rows on stdin, prints "<use>|<use_mount>|<inode>|<inode_mount>"
# taking the WORST of each axis over every mount at or above min_kb. No mount at all → OFFLINE.
scan_rows() {
  awk -v min_kb="${1:-0}" '
    { m=$1; sz=$2+0; u=$3; i=$4
      if (sz < min_kb+0) next
      if (u ~ /^[0-9]+$/) { if (bm=="" || u+0 > bu) { bu=u+0; bm=m } }
      if (i ~ /^[0-9]+$/) { if (im=="" || i+0 > bi) { bi=i+0; im=m } } }
    END {
      if (bm=="") { print "OFFLINE|-|OFFLINE|-"; exit }
      printf "%d|%s|%s|%s\n", bu, bm, (im=="" ? "OFFLINE" : bi""), (im=="" ? "-" : im) }'
}

# WRITE PROBE — three outcomes, not two (2026-08-16, the false-CRITICAL on mesh-home).
#   The probe was `timeout 2 touch`, and ANY non-zero rc became writeable=0 -> CRITICAL
#   "filesystem is read-only or unwritable". But a timeout is not a refusal: at 07:30 this node
#   was under a write-latency stall (mesh-disk-latency logged dm-0 write=1392ms/2199ms in the
#   same minutes) and the 2s touch simply did not finish. The capacity axis published CRITICAL
#   for a filesystem that was 23% full, writeable, and SMART-clean, and mesh-storage-health then
#   fused it with latency=STALLED into "capacity=CRITICAL,latency=STALLED (imminent storage
#   failure)". The whole point of that fusion is CORROBORATION ACROSS INDEPENDENT AXES — and the
#   writeability leg is latency-sensitive, so one slow write tripped both axes and got counted
#   twice. (Tell in the artifact: that CRITICAL carried no `@<mount>`, because no mount was full.)
#   So separate the claims by the rc the kernel actually gave us:
#     rc=0                      -> yes   writeable
#     rc!=0 and not a timeout   -> no    a real refusal (EROFS/EACCES/ENOSPC) — CRITICAL, as before
#     timed out, retry SUCCEEDS -> slow  a LATENCY symptom; capacity says nothing, and must not
#     timed out, retry TIMES OUT-> hung  genuinely unresponsive — CRITICAL, but NOT "read-only"
#   `hung` keeps the emergency detectable; `slow` is the one that used to lie.
probe_write() { # <file> [soft_s] [hard_s] -> yes|slow|hung|no
  local f="$1" soft="${2:-$WRITE_SOFT_S}" hard="${3:-$WRITE_HARD_S}" rc
  timeout "$soft" touch "$f" 2>/dev/null; rc=$?
  if [ "$rc" -eq 0 ]; then rm -f "$f" 2>/dev/null; echo yes; return; fi
  if [ "$rc" -ne 124 ] && [ "$rc" -ne 137 ]; then echo no; return; fi
  timeout "$hard" touch "$f" 2>/dev/null; rc=$?
  if [ "$rc" -eq 0 ]; then rm -f "$f" 2>/dev/null; echo slow; return; fi
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then echo hung; return; fi
  echo no
}

classify_disk() { # <use_pct> <inode_pct> <write_probe> [use_mount] [inode_mount] -> "LABEL|reason"
  local use="$1" inode="$2" writeable="$3" um="${4:-}" im="${5:-}"
  local uw iw note=""
  uw="${um:+ on $um}"; iw="${im:+ on $im}"
  case "$writeable" in
    1|yes) ;;
    slow)  note=" [write probe slow: >${WRITE_SOFT_S}s, completed under ${WRITE_HARD_S}s — a latency symptom, not capacity; see mesh-disk-latency]" ;;
    hung)  echo "CRITICAL|write probe HUNG >${WRITE_HARD_S}s — filesystem unresponsive (not a read-only remount)"; return ;;
    *)     echo "CRITICAL|filesystem is read-only or unwritable"; return ;;
  esac
  if [ "$use" = "OFFLINE" ] || [ "$inode" = "OFFLINE" ]; then
    echo "OFFLINE|could not read filesystem metrics${note}"
    return
  fi
  if [ "$use" -ge 95 ] 2>/dev/null || [ "$inode" -ge 95 ] 2>/dev/null; then
    echo "CRITICAL|exhausted (use=${use}%${uw} inode=${inode}%${iw})${note}"
    return
  fi
  if [ "$use" -ge 85 ] 2>/dev/null || [ "$inode" -ge 85 ] 2>/dev/null; then
    echo "WARNING|low space (use=${use}%${uw} inode=${inode}%${iw})${note}"
    return
  fi
  echo "NORMAL|space OK (use=${use}%${uw} inode=${inode}%${iw})${note}"
}

# --- Test mode ---
if [ "${1:-}" = --test ]; then
  fail=0
  # test cases for classification
  r="$(classify_disk 50 8 1)"
  echo "$r" | grep -q '^NORMAL' || { echo "  FAIL classify NORMAL: got=$r"; fail=1; }
  
  r="$(classify_disk 85 8 1)"
  echo "$r" | grep -q '^WARNING' || { echo "  FAIL classify WARNING blocks: got=$r"; fail=1; }
  
  r="$(classify_disk 50 88 1)"
  echo "$r" | grep -q '^WARNING' || { echo "  FAIL classify WARNING inodes: got=$r"; fail=1; }
  
  r="$(classify_disk 96 8 1)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL classify CRITICAL blocks: got=$r"; fail=1; }
  
  r="$(classify_disk 50 95 1)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL classify CRITICAL inodes: got=$r"; fail=1; }
  
  r="$(classify_disk 50 8 0)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL classify CRITICAL writeable: got=$r"; fail=1; }

  # --- WRITE-PROBE leg (the 2026-08-16 false CRITICAL): a slow write is not a full disk ---
  # A probe that TIMED OUT but then completed is a latency symptom. Calling it CRITICAL
  # "read-only or unwritable" hands mesh-storage-health a second, non-independent CRITICAL axis
  # and it escalates to "imminent storage failure" on a 23%-full, SMART-clean filesystem.
  r="$(classify_disk 50 8 slow)"
  echo "$r" | grep -q '^NORMAL' || { echo "  FAIL classify slow-probe must NOT be a capacity verdict: got=$r"; fail=1; }
  echo "$r" | grep -q 'write probe slow' || { echo "  FAIL classify slow-probe must SAY it was slow: got=$r"; fail=1; }
  # ...and a genuinely wedged fs must still raise, without claiming a read-only remount it never saw
  r="$(classify_disk 50 8 hung)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL classify hung-probe must raise CRITICAL: got=$r"; fail=1; }
  echo "$r" | grep -q 'read-only or unwritable' && { echo "  FAIL classify hung-probe must not claim the fs is read-only: got=$r"; fail=1; }
  r="$(classify_disk 50 8 no)"
  echo "$r" | grep -q 'read-only or unwritable' || { echo "  FAIL classify refused-probe: got=$r"; fail=1; }

  # REAL probe_write, all three non-happy paths driven against the kernel (no stubs):
  _pd="$(mktemp -d)" || { echo "  FAIL probe_write: mktemp -d"; fail=1; _pd=""; }
  if [ -n "$_pd" ]; then
    r="$(probe_write "$_pd/ok" 2 5)"
    [ "$r" = yes ] || { echo "  FAIL probe_write real write: expected yes got=$r"; fail=1; }
    # a real refusal (ENOENT on a missing dir) must stay 'no' — the errno path, not the clock path
    r="$(probe_write "$_pd/nodir/x" 2 5)"
    [ "$r" = no ] || { echo "  FAIL probe_write refusal: expected no got=$r"; fail=1; }
    # The CLOCK path. A wedged filesystem cannot be conjured here, so the slowness is synthetic —
    # but everything that decides the verdict is real: timeout(1) really SIGTERMs a write that
    # overran, the kernel really returns 124, and probe_write really reads that rc. (A reader-less
    # FIFO does NOT work: GNU touch opens O_NONBLOCK and returns instantly — measured, not assumed.)
    _sd="$_pd/shim"; mkdir -p "$_sd"
    _oldpath="$PATH"
    printf '#!/bin/sh\nsleep 30\n' > "$_sd/touch"; chmod +x "$_sd/touch"
    PATH="$_sd:$PATH"
    r="$(probe_write "$_pd/wedged" 1 1)"
    [ "$r" = hung ] || { echo "  FAIL probe_write overran both deadlines: expected hung got=$r"; fail=1; }
    # ...and the SAME overrun, completing before the HARD deadline, must read 'slow' — never 'no',
    # and never the read-only CRITICAL that made 07:34 look like imminent storage failure.
    printf '#!/bin/sh\nsleep 2\nexec /usr/bin/touch "$@"\n' > "$_sd/touch"; chmod +x "$_sd/touch"
    r="$(probe_write "$_pd/late" 1 8)"
    [ "$r" = slow ] || { echo "  FAIL probe_write overran soft deadline only: expected slow got=$r"; fail=1; }
    PATH="$_oldpath"
    # and the verdict that reaches storage-health from that 'slow' must not be a capacity CRITICAL
    r="$(classify_disk 23 2 slow / /)"
    echo "$r" | grep -q '^CRITICAL' && { echo "  FAIL slow probe still escalates capacity: got=$r"; fail=1; }
    rm -rf "$_pd"
  fi

  r="$(classify_disk OFFLINE 8 1)"
  echo "$r" | grep -q '^OFFLINE' || { echo "  FAIL classify OFFLINE blocks: got=$r"; fail=1; }

  # --- MULTI-MOUNT leg (the phaedra /tmp blindness) ---
  # A synthetic mount table where the ROOT fs is comfortable and a NON-root mount is exhausted.
  # Reading $HOME's fs alone answers NORMAL here; that is exactly the failure this leg exists for.
  _rows='/ 957682616 20 5
/tmp 8388608 100 97
/boot 1992552 11 1'
  r="$(printf '%s\n' "$_rows" | scan_rows "$MIN_KB")"
  [ "$r" = "100|/tmp|97|/tmp" ] || { echo "  FAIL scan_rows worst-mount: expected 100|/tmp|97|/tmp got=$r"; fail=1; }
  r="$(classify_disk "${r%%|*}" "$(printf '%s' "$r" | cut -d'|' -f3)" 1 "$(printf '%s' "$r" | cut -d'|' -f2)" "$(printf '%s' "$r" | cut -d'|' -f4)")"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL multi-mount CRITICAL: a 100% non-root mount must raise: got=$r"; fail=1; }
  # ...and the verdict must NAME the mount — an unattributed 'use=100%' sends the reader to the wrong fs
  echo "$r" | grep -q 'on /tmp' || { echo "  FAIL multi-mount attribution: verdict does not name the mount: got=$r"; fail=1; }
  # the root fs must still be able to win when IT is the worst (no bias toward the last row)
  r="$(printf '/ 957682616 91 5\n/tmp 8388608 3 1\n' | scan_rows "$MIN_KB")"
  [ "$r" = "91|/|5|/" ] || { echo "  FAIL scan_rows root-worst: got=$r"; fail=1; }
  # TINY pseudo-mounts are noise, not capacity: /run/lock at 100% of 5 MiB must NOT win
  r="$(printf '/ 957682616 20 5\n/run/lock 5120 100 100\n' | scan_rows "$MIN_KB")"
  [ "$r" = "20|/|5|/" ] || { echo "  FAIL scan_rows tiny-mount excluded: got=$r"; fail=1; }
  # a filesystem that reports no inode figures ('-', e.g. btrfs) must not blank the BLOCK axis
  r="$(printf '/data 209715200 77 -\n' | scan_rows "$MIN_KB")"
  [ "$r" = "77|/data|OFFLINE|-" ] || { echo "  FAIL scan_rows inode-less fs: got=$r"; fail=1; }
  # no mount at all -> OFFLINE, never a fabricated 0%
  r="$(printf '' | scan_rows "$MIN_KB")"
  [ "$r" = "OFFLINE|-|OFFLINE|-" ] || { echo "  FAIL scan_rows empty table: got=$r"; fail=1; }

  # REAL-READ GATE: verify the real df is running on this node and readable
  if ! df -P "$HOME" >/dev/null 2>&1; then
    echo "smoke-test: n/a — df not functional or no home directory"
    exit 2
  fi
  # REAL READ of the ACTUAL mount table: the parser must enumerate more than the one fs $HOME is on,
  # and the live scan must produce a numeric worst — a fixture-only pass would leave the real df
  # join (column indices, the -x flags, the two-table awk) entirely unasserted.
  _live="$(mount_rows)" || { echo "smoke-test: n/a — df -T unavailable"; exit 2; }
  _n="$(printf '%s\n' "$_live" | grep -c . )"
  [ "${_n:-0}" -ge 1 ] || { echo "  FAIL real-read: mount_rows enumerated nothing"; fail=1; }
  printf '%s\n' "$_live" | awk '$1=="/"{f=1} END{exit !f}' || { echo "  FAIL real-read: root fs missing from mount_rows"; fail=1; }
  _lw="$(printf '%s\n' "$_live" | scan_rows "$MIN_KB")"
  case "${_lw%%|*}" in
    ''|*[!0-9]*) echo "  FAIL real-read: live worst use% not numeric: got=$_lw"; fail=1 ;;
  esac

  [ "$fail" = 0 ] && { echo "smoke-test: ok (classifier x7 + write-probe x5 + real-probe x5 + multi-mount x6 + real-read x3; live mounts: $_n, worst: $_lw)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

# --- Live read path ---
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# 1. Check writeability of $HOME/.mesh — yes|slow|hung|no (see probe_write: a timeout is not a refusal)
writeable="$(probe_write "$TEST_FILE")"
rm -f "$TEST_FILE" 2>/dev/null || true

# 2+3. Worst block% and worst inode% across EVERY real local mount (see header: reading only
# $HOME's fs published NORMAL on a node whose /tmp was 100% and refusing every write).
use_pct="OFFLINE"; inode_pct="OFFLINE"; use_mnt=""; inode_mnt=""
worst="$(mount_rows 2>/dev/null | scan_rows "$MIN_KB")" || true
if [ -n "${worst:-}" ]; then
  val="$(printf '%s' "$worst" | cut -d'|' -f1)"; [[ "$val" =~ ^[0-9]+$ ]] && use_pct="$val"
  use_mnt="$(printf '%s' "$worst" | cut -d'|' -f2)"; [ "$use_mnt" = "-" ] && use_mnt=""
  val="$(printf '%s' "$worst" | cut -d'|' -f3)"; [[ "$val" =~ ^[0-9]+$ ]] && inode_pct="$val"
  inode_mnt="$(printf '%s' "$worst" | cut -d'|' -f4)"; [ "$inode_mnt" = "-" ] && inode_mnt=""
fi
# fall back to the single-fs read if the mount-table join produced nothing at all (exotic df)
if [ "$use_pct" = OFFLINE ]; then
  df_out="$(df -P "$HOME" 2>/dev/null | tail -n 1)" || true
  if [ -n "$df_out" ]; then
    val="$(printf '%s' "$df_out" | awk '{print $5}' | tr -d '%')"
    [[ "$val" =~ ^[0-9]+$ ]] && { use_pct="$val"; use_mnt="$(printf '%s' "$df_out" | awk '{print $NF}')"; }
  fi
fi
if [ "$inode_pct" = OFFLINE ]; then
  df_i_out="$(df -P -i "$HOME" 2>/dev/null | tail -n 1)" || true
  if [ -n "$df_i_out" ]; then
    val="$(printf '%s' "$df_i_out" | awk '{print $5}' | tr -d '%')"
    [[ "$val" =~ ^[0-9]+$ ]] && { inode_pct="$val"; inode_mnt="$(printf '%s' "$df_i_out" | awk '{print $NF}')"; }
  fi
fi

# Classify
result="$(classify_disk "$use_pct" "$inode_pct" "$writeable" "$use_mnt" "$inode_mnt")"
label="${result%%|*}"
reason="${result#*|}"

# If unable to assess, exit 2
if [ "$label" = "OFFLINE" ]; then
  echo "mesh-disk-space: OFFLINE — $reason" >&2
  exit 2
fi

# Write state + touch liveness on EVERY successful run
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
printf '%s|use_pct=%s|inode_pct=%s|writeable=%s|%s\n' \
  "$label" "$use_pct" "$inode_pct" "$writeable" "$reason" > "$STATE"
if [ -x "$HOME/.local/bin/mesh-state-touch" ]; then
  "$HOME/.local/bin/mesh-state-touch" "$STATE" >/dev/null 2>&1 || true
else
  touch "$STATE" 2>/dev/null || true
fi

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","use_pct":%s,"inode_pct":%s,"writeable":"%s","ts":"%s"}\n' \
    "$label" "$reason" "${use_pct:-null}" "${inode_pct:-null}" "$writeable" "$TS"
  exit 0
fi

if [ "${1:-}" = --edge ]; then
  prev=""
  [ -f "$STATE" ] && prev="$(head -1 "$STATE" 2>/dev/null | cut -d'|' -f1)" || true
  [ "$prev" = "$label" ] && exit 0
  printf '[disk-space-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr '_' '-')" "$label" "$reason"
  exit 0
fi

printf '[disk-space-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr '_' '-')" "$label" "$reason"
