#!/usr/bin/env python3
"""Persist content-free automatic wake intents; explicitly import synthetic events."""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import uuid

from mesh_mishe_delivery import atomic_json, core_feed, home, read_json


CHANNEL = re.compile(r"[a-z][a-z0-9-]{0,63}\Z")
SOURCE = re.compile(r"[a-z][a-z0-9-]{0,63}\Z")
DIGEST = re.compile(r"[a-f0-9]{64}\Z")
KEY = re.compile(r"([0-9]{20})-([a-f0-9]{32})\Z")
STAMP = re.compile(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z\Z")
TERMINAL = {"delivered", "refused", "unknown"}


def spool() -> Path:
    return Path(os.environ.get("MESH_MISHE_AUTO_EVENT_DIR", str(home() / "automatic-events")))


def event_path(key: str) -> Path:
    if not KEY.fullmatch(key):
        raise ValueError("invalid event key")
    return spool() / "events" / f"{key}.json"


def begin(channel: str, source: str, digest: str) -> str:
    if not CHANNEL.fullmatch(channel) or not SOURCE.fullmatch(source) or not DIGEST.fullmatch(digest):
        raise ValueError("invalid channel, source, or digest")
    root = spool()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    (root / "events").mkdir(parents=True, exist_ok=True, mode=0o700)
    with (root / ".lock").open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        cursor = root / "cursor.json"
        value = read_json(cursor) if cursor.exists() else {"sequence": 0}
        sequence = value.get("sequence")
        if type(sequence) is not int or sequence < 0:
            raise ValueError("invalid automatic event cursor")
        sequence += 1
        while list((root / "events").glob(f"{sequence:020d}-*.json")):
            sequence += 1  # event survived a crash before cursor publication
        key = f"{sequence:020d}-{uuid.uuid4().hex}"
        record = {"version": 1, "key": key, "sequence": sequence, "channel": channel,
                  "source": source, "prompt_sha256": digest, "status": "pending",
                  "observed_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")}
        atomic_json(event_path(key), record)
        atomic_json(cursor, {"sequence": sequence})
        return key


def finish(key: str, outcome: str) -> None:
    if outcome not in TERMINAL:
        raise ValueError("invalid outcome")
    root = spool()
    with (root / ".lock").open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        path = event_path(key)
        value = read_json(path)
        if value.get("key") != key or value.get("status") not in ({"pending"} | TERMINAL):
            raise ValueError("invalid automatic event")
        if value["status"] != "pending" and value["status"] != outcome:
            raise ValueError("conflicting automatic event outcome")
        value["status"] = outcome
        value["receipted_at"] = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
        atomic_json(path, value)


def import_synthetic(channel: str) -> int:
    if channel != "synthetic":
        raise ValueError("only synthetic automatic events may be imported during shadow work")
    feed = core_feed()
    count = 0
    for path in sorted((spool() / "events").glob("*.json")):
        value = read_json(path)
        key = value.get("key")
        if (not isinstance(key, str) or path != event_path(key) or value.get("version") != 1
                or type(value.get("sequence")) is not int or int(key[:20]) != value["sequence"]
                or not isinstance(value.get("channel"), str) or not CHANNEL.fullmatch(value["channel"])
                or not isinstance(value.get("source"), str) or not SOURCE.fullmatch(value["source"])
                or not isinstance(value.get("prompt_sha256"), str) or not DIGEST.fullmatch(value["prompt_sha256"])
                or value.get("status") not in ({"pending"} | TERMINAL)
                or not isinstance(value.get("observed_at"), str) or not STAMP.fullmatch(value["observed_at"])):
            raise ValueError(f"invalid automatic event {path.name}")
        if value["channel"] != channel:
            continue
        status = "unknown" if value["status"] == "pending" else value["status"]
        body = (f"automatic channel={channel} event={key} source={value['source']} "
                f"source-seq={value['sequence']} observed-at={value['observed_at']} "
                f"prompt-sha256={value['prompt_sha256']} status={status}")
        feed.append_runtime_once("automatic-wake", body)
        count += 1
    return count


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="mode", required=True)
    start = sub.add_parser("begin")
    start.add_argument("channel")
    start.add_argument("source")
    start.add_argument("digest")
    settle = sub.add_parser("finish")
    settle.add_argument("key")
    settle.add_argument("outcome")
    imported = sub.add_parser("import")
    imported.add_argument("channel")
    args = parser.parse_args()
    try:
        if args.mode == "begin":
            print(begin(args.channel, args.source, args.digest))
        elif args.mode == "finish":
            finish(args.key, args.outcome)
            print("ok")
        else:
            print(import_synthetic(args.channel))
        return 0
    except (ValueError, OSError, ImportError) as exc:
        print(f"mesh-mishe-auto-events: UNKNOWN {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
