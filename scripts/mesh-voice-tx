#!/usr/bin/env bash
# mesh-voice-tx — the mesh SPEAKS to the operator: TTS (Piper neural voice) -> a Telegram VOICE note
# and/or the Bose speaker on default-string. The reply half of the voice channel.
#
#   mesh-voice-tx "текст"                  send a voice note to the operator's Telegram
#   mesh-voice-tx --bose "текст"           ALSO play it on the Bose (default-string, card 1)
#   mesh-voice-tx --bose-only "текст"      only Bose, no Telegram
#   mesh-voice-tx --auto "текст"           PRESENCE-ROUTED: room PRESENT → Bose (aloud), else → Telegram
#                                          (reads mesh-room-sense's cron-fresh verdict; stale/UNKNOWN → Telegram)
#   mesh-voice-tx --verify "текст"         SOFTWARE loopback: transcribe our own WAV, compare to source
#   mesh-voice-tx --bose --verify-acoustic "текст"   + ACOUSTIC loopback: record room mic after play
#   mesh-voice-tx --loopback "<text>" [voice]        DEBUG/TEST: synth+loopback, no send
#   mesh-voice-tx --test                   smoke: piper synth + loopback self-test (no send, no Bose)
# Voice via $MESH_VOICE (default ruslan = ru male; also irina/ryan/lessac).
#
# VERIFICATION (operator 2026-06-24): the voice actuator used to report success on rc=0 = WAV made +
# sent, never checking the audio was INTELLIGIBLE or that sound CAME OUT. Two loopbacks now:
#   (a) SOFTWARE (--verify): transcribe the synthesized WAV with whisper and compare to the source
#       text. Catches EN text read by the ru 'ruslan' voice = gibberish (EN needs ryan/lessac).
#   (b) ACOUSTIC (--verify-acoustic, with --bose): right after playing to the Bose, record the room
#       mic and confirm non-silence. Catches the incident the operator hit: Bose powered OFF but still
#       connected → pw-play rc=0 → silent failure reported as success.
set -uo pipefail
TYPING_HELPER="$HOME/.local/bin/mesh-tg-typing"
stop_typing(){ [ -x "$TYPING_HELPER" ] && "$TYPING_HELPER" --stop >/dev/null 2>&1 || true; }
trap stop_typing EXIT INT TERM

# ── loopback helpers (defined early so --test/--loopback can use them) ──────────────────────────

_loopback_model(){
  # pick a REAL whisper model for loopback — the for-tests-* are EMPTY stubs ("no tensors loaded,
  # empty model for testing") that transcribe nothing. Prefer ggml-base: fast AND accurate enough on
  # clean Piper TTS, and MULTILINGUAL (loopback must handle RU source, so skip the .en-only variants).
  # Empty echo if no real model installed (loopback self-skips cleanly).
  local m
  for m in ggml-base ggml-small ggml-medium ggml-large-v3-turbo ggml-large-v3 ggml-large; do
    [ -f "$HOME/.mesh/whispercpp/models/$m.bin" ] && { echo "$HOME/.mesh/whispercpp/models/$m.bin"; return; }
  done
}

loopback(){ # $1=wav  $2=source-text  → ratio (0.00-1.00 or "n/a") on stdout; heard text on stderr
  # SOFTWARE loopback (operator 2026-06-24): transcribe our OWN synthesized wav and compare to the
  # source text. Catches wrong-language voice (EN source read by ru 'ruslan' = gibberish → near-0
  # similarity) and a piper that synthesizes garbage. Verification principle on the voice actuator.
  local wav="$1" text="$2" wm heard tf rw
  wm="${MVTX_LOOPBACK_MODEL:-$(_loopback_model)}"
  if ! { [ -x "$HOME/.mesh/whispercpp/main" ] && [ -n "$wm" ] && [ -f "$wm" ]; }; then
    printf 'n/a'; printf 'n/a (no whisper)' >&2; return; fi
  # Piper outputs 22050 Hz; whisper.cpp REQUIRES 16 kHz mono or it rejects the wav ("must be 16 kHz").
  # Resample first (ffmpeg, fast). Without this every loopback read empty → every check false-failed.
  rw="$(mktemp "${TMPDIR:-/tmp}"/mvtx-lb-XXXXXX-16k.wav)"
  if ! ffmpeg -hide_banner -loglevel error -y -i "$wav" -ar 16000 -ac 1 "$rw" 2>/dev/null; then
    rm -f "$rw"; printf 'n/a'; printf 'n/a (resample failed)' >&2; return; fi
  heard="$("$HOME/.mesh/whispercpp/main" -m "$wm" -f "$rw" -l auto -nt -t 2 2>/dev/null | tr -d '\r\n' | head -c 200)"
  rm -f "$rw"
  tf="$(mktemp)"; printf '%s' "$heard" > "$tf"
  python3 - "$text" "$tf" <<'PY'
import sys, difflib, re, unicodedata
def norm(s):
    s = unicodedata.normalize("NFKD", s).casefold()
    return re.sub(r"[^a-zа-яё0-9 ]", "", s).split()
with open(sys.argv[2]) as f:
    heard = f.read()
a, b = norm(sys.argv[1]), norm(heard)
if not a or not b:
    print("0.00"); print(" ".join(b[:10]), file=sys.stderr); sys.exit()
print("%.2f" % difflib.SequenceMatcher(None, a, b).ratio())
print(" ".join(b[:10]), file=sys.stderr)
PY
  rm -f "$tf"
}

_split_text(){ # $1=text $2=char-budget → sentence-grouped chunks, one per line, each ≤ budget
  # Mirrors the clone daemon's own _split (sentence boundaries) but BATCHED to the socket cap: each
  # emitted chunk is a whole synth call in mesh-voice-tx, so it must be small enough to finish inside
  # one MESH_CLONE_TIMEOUT. Unicode-safe (python len = chars). An over-long single sentence is
  # hard-sliced on spaces so no chunk can exceed the budget and re-trip the very timeout we split for.
  MVTX_TEXT="$1" MVTX_MAX="$2" python3 - <<'PY'
import os, re
text = " ".join(os.environ["MVTX_TEXT"].split())
lim = max(1, int(os.environ["MVTX_MAX"]))
out, cur = [], ""
for s in re.split(r"(?<=[.!?…])\s+", text):
    while len(s) > lim:                       # single sentence longer than the budget: slice on a space
        cut = s.rfind(" ", 0, lim)
        if cut <= 0: cut = lim
        seg, s = s[:cut].strip(), s[cut:].strip()
        if seg: out.append(seg)
    if not s: continue
    if not cur: cur = s
    elif len(cur) + 1 + len(s) <= lim: cur += " " + s
    else: out.append(cur); cur = s
if cur: out.append(cur)
print("\n".join(out))
PY
}

acoustic_loopback(){ # records the room mic right after a Bose play; prints RMS (empty = couldn't record)
  # ACOUSTIC loopback (operator 2026-06-24): --bose ssh-play returns rc=0 even when the speaker is
  # powered OFF but still connected → silent failure reported as success. After playing, record ~2.5s
  # on the Bose node's mic and check it's non-silent.
  [ -n "${BOSE_NODE:-}" ] || { echo ""; return; }
  ssh -o BatchMode=yes -o ConnectTimeout=10 "${BOSE_NODE}" bash -s 2>/dev/null <<'REOF' | tail -1
pu=$(ps -o user= -C pipewire 2>/dev/null | head -1); pu=${pu:-$(id -un)}
puid=$(id -u "$pu" 2>/dev/null)
rf=/tmp/mvtx-ac-$$.wav
cmd="export XDG_RUNTIME_DIR=/run/user/$puid; timeout 3 pw-record --rate 16000 --channels 1 --format s16 $rf 2>/dev/null; python3 -c 'import wave,audioop,sys; w=wave.open(sys.argv[1]); d=w.readframes(w.getnframes()); print(audioop.rms(d,2) if d else 0)' $rf 2>/dev/null; rm -f $rf"
if [ "$pu" = "$(id -un)" ]; then sh -c "$cmd"; else runuser -u "$pu" -- sh -c "$cmd"; fi
REOF
}

# ── --test: piper smoke + loopback self-test (no send, no Bose) ─────────────────────────────────
if [ "${1:-}" = --test ]; then
  _P="$HOME/.mesh/piper/piper/piper"; _V="$HOME/.mesh/piper/voices"; _VC="${MESH_VOICE:-ruslan}"
  [ -x "$_P" ] || { echo "smoke-test: n/a (piper not installed on this node)"; exit 2; }
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  [ -f "$_V/$_VC.onnx" ] || { echo "smoke-test: FAIL (voice model missing: $_VC.onnx)"; exit 1; }
  _tw="$(mktemp "${TMPDIR:-/tmp}"/mvtx-test-XXXXXX.wav)"
  printf 'тест\n' | "$_P" -m "$_V/$_VC.onnx" -f "$_tw" >/dev/null 2>&1
  if ! { [ -s "$_tw" ] && [ "$(stat -c%s "$_tw" 2>/dev/null || echo 0)" -gt 1000 ]; }; then
    rm -f "$_tw"; echo "smoke-test: FAIL (piper present but produced no audio — broken install/voice)"; exit 1
  fi
  rm -f "$_tw"
  # LOOPBACK self-test (operator 2026-06-24): synth a known phrase in the configured voice, transcribe
  # it back, assert similarity. Catches wrong-language voice (verification principle on the actuator).
  # Skips cleanly (still exit 0) if whisper isn't installed here — piper smoke already passed.
  # PHRASE is number-free + retry-on-low (genome 2026-06-24): whisper.cpp is run-to-run NON-deterministic
  # (threaded float-reduction order), so a single transcription flaps. The old "Раз два три" got rendered
  # as the digit "123" → 3 source words collapsed to 1 unmatched token → WORD sim 0.25 < 0.35 = FALSE-FAIL
  # on a HEALTHY ru actuator (observed). A number-free RU phrase scores WORD sim ~0.55–0.80 healthy vs
  # ~0.11 for EN-read-by-ruslan gibberish; one re-transcribe before declaring FAIL absorbs the flaky-low
  # tail (a genuine wrong-language voice fails BOTH tries — its near-0 sim has no healthy run to hit).
  _phrase="Проверка голоса связь работает нормально"
  _lw="$(mktemp "${TMPDIR:-/tmp}"/mvtx-lb-XXXXXX.wav)"
  printf '%s\n' "$_phrase" | "$_P" -m "$_V/$_VC.onnx" -f "$_lw" >/dev/null 2>&1
  _min="${MVTX_LOOPBACK_MIN:-0.35}"; _pass=0; _sim="n/a"; _heard=""
  for _try in 1 2; do
    _lbf="$(mktemp)"; _sim="$(loopback "$_lw" "$_phrase" 2>"$_lbf")"; _heard="$(cat "$_lbf")"; rm -f "$_lbf"
    [ "$_sim" = "n/a" ] && break                                      # whisper absent → skip cleanly
    awk "BEGIN{exit !($_sim >= $_min)}" 2>/dev/null && { _pass=1; break; }
  done
  rm -f "$_lw"
  if [ "$_sim" = "n/a" ]; then
    echo "loopback: SKIP (whisper not installed on this node — piper smoke ok)"
  elif [ "$_pass" = 1 ]; then
    echo "loopback: ok (sim=$_sim ≥ $_min; voice=$_VC; heard='$_heard')"
  else
    echo "loopback: FAIL (sim=$_sim < $_min after retry; voice=$_VC; heard='$_heard') — likely wrong-language voice (EN needs MESH_VOICE=ryan/lessac) or broken piper"
    echo "smoke-test: FAIL (loopback mismatch)"; exit 1
  fi
  # rc-DISCRIMINATION fixtures (chat-review/voice-tx-canned-clone-down-misdiagnosis, filed 07-18,
  # re-filed 07-21): the fallback hint must branch on mesh-voice-say's ACTUAL rc — only rc=5
  # (daemon unreachable) may say "fix mesh-voice-clone.service"; a TIMEOUT (rc=7: healthy daemon,
  # text outran the cap) misreported as a dead service sent tg@ chasing a healthy unit twice.
  # Drives the REAL script (child run; fake HOME so no env/creds/piper — the hint prints before the
  # piper gate) with the PAIRED mesh-voice-say from this script's own dir (src tests src).
  _sd="$(cd "$(dirname "$0")" && pwd)"
  _fh="$(mktemp -d "${TMPDIR:-/tmp}"/mvtx-rc-XXXXXX)"
  _e1="$(HOME="$_fh" PATH="$_sd:$PATH" "$0" "тест" 2>&1 >/dev/null)"
  case "$_e1" in *UNREACHABLE*mesh-voice-clone.service*) : ;; *) rm -rf "$_fh"
    echo "smoke-test: FAIL (rc5 fixture: unreachable daemon must hint at the service — got: $_e1)"; exit 1;; esac
  python3 - "$_fh/slow.sock" <<'PY' &
import socket, sys, time
s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(1); time.sleep(8)
PY
  _srv=$!
  for _i in $(seq 30); do [ -S "$_fh/slow.sock" ] && break; sleep 0.1; done
  _e2="$(HOME="$_fh" PATH="$_sd:$PATH" MESH_CLONE_SOCK="$_fh/slow.sock" MESH_CLONE_TIMEOUT=1 "$0" "тест" 2>&1 >/dev/null)"
  kill "$_srv" 2>/dev/null; wait "$_srv" 2>/dev/null; rm -rf "$_fh"
  case "$_e2" in *mesh-voice-clone.service*)
    echo "smoke-test: FAIL (rc7 fixture: TIMEOUT misdiagnosed as dead service — got: $_e2)"; exit 1;; esac
  case "$_e2" in *TIMEOUT*) : ;; *)
    echo "smoke-test: FAIL (rc7 fixture: timeout hint missing — got: $_e2)"; exit 1;; esac
  echo "rc-hints: ok (rc5→service hint, rc7→timeout hint, never crossed)"

  # CHUNKING gate (long text keeps the clone voice, 2026-07-23): the split must produce >1 batch each
  # ≤ budget with EVERY source word preserved, and synth_clone must CONCATENATE all batches — not just
  # synth the first. Drive both on the REAL script (child $0) so the tested code is the shipped code.
  _sd="${_sd:-$(cd "$(dirname "$0")" && pwd)}"
  _long="$(python3 -c 'print(" ".join("Проверка связи номер %d работает нормально." % i for i in range(1,25)))')"
  _bud=120
  _cout="$(MVTX_CHUNK_CHARS=$_bud "$0" --chunks "$_long")"
  _nchunks="$(printf '%s\n' "$_cout" | grep -c .)"
  [ "$_nchunks" -gt 1 ] || { echo "smoke-test: FAIL (chunk-split: long text gave $_nchunks batch, want >1)"; exit 1; }
  # every batch within budget, and no source word lost across the split
  if ! printf '%s\n' "$_cout" | MVTX_BUD=$_bud MVTX_SRC="$_long" python3 -c '
import os,sys
bud=int(os.environ["MVTX_BUD"]); src=os.environ["MVTX_SRC"].split()
chunks=[l for l in sys.stdin.read().splitlines() if l.strip()]
over=[c for c in chunks if len(c)>bud]
if over: print("OVER:%d"%len(over)); sys.exit(1)
if " ".join(chunks).split()!=src: print("WORDS-LOST"); sys.exit(1)
print("ok")'; then
    echo "smoke-test: FAIL (chunk-split: a batch exceeds budget or dropped words)"; exit 1
  fi
  # concat artifact: stub mesh-voice-say emits a fixed 0.5s wav per call; N batches must yield a wav of
  # ~N×0.5s — proves synth_clone joined ALL batches, not that it stopped after the first.
  _cs="$(mktemp -d "${TMPDIR:-/tmp}"/mvtx-cs-XXXXXX)"
  cat > "$_cs/mesh-voice-say" <<'STUB'
#!/usr/bin/env bash
python3 - "$2" <<'PY'
import wave,sys,struct
w=wave.open(sys.argv[1],"wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(24000)
w.writeframes(struct.pack("<%dh"%12000,*([0]*12000))); w.close()   # 0.5s of silence @24k
PY
STUB
  chmod +x "$_cs/mesh-voice-say"
  _cw="$_cs/out.wav"
  if MVTX_CHUNK_CHARS=$_bud PATH="$_cs:$PATH" "$0" --chunk-synth "$_long" "$_cw" >/dev/null 2>&1 && [ -s "$_cw" ]; then
    _dur="$(MVTX_N=$_nchunks python3 -c '
import wave,os,sys
w=wave.open(sys.argv[1]); d=w.getnframes()/w.getframerate()
exp=int(os.environ["MVTX_N"])*0.5
print("ok" if abs(d-exp)<0.2 else "BAD dur=%.2f exp=%.2f"%(d,exp))' "$_cw")"
    case "$_dur" in ok) echo "chunk-synth: ok ($_nchunks batches → concatenated ${_bud}-char clone wav)";;
      *) rm -rf "$_cs"; echo "smoke-test: FAIL (chunk-concat: $_dur — batches not all joined)"; exit 1;; esac
  else
    rm -rf "$_cs"; echo "smoke-test: FAIL (chunk-synth produced no wav)"; exit 1
  fi
  rm -rf "$_cs"

  echo "smoke-test: ok (piper synthesized $_VC + loopback verified)"; exit 0
fi

# ── --loopback: DEBUG/TEST entry — synth + loopback, no send ────────────────────────────────────
if [ "${1:-}" = "--loopback" ]; then
  shift; [ $# -ge 1 ] || { echo "usage: mesh-voice-tx --loopback <text> [voice]"; exit 1; }
  _text="$1"; _voice="${2:-${MESH_VOICE:-ruslan}}"
  _P="$HOME/.mesh/piper/piper/piper"; _V="$HOME/.mesh/piper/voices"
  [ -x "$_P" ] && [ -f "$_V/$_voice.onnx" ] || { echo "loopback: n/a (piper/voice '$_voice' missing)"; exit 2; }
  _w="$(mktemp "${TMPDIR:-/tmp}"/mvtx-lb-XXXXXX.wav)"
  printf '%s\n' "$_text" | "$_P" -m "$_V/$_voice.onnx" -f "$_w" >/dev/null 2>&1
  _lbf="$(mktemp)"; _sim="$(loopback "$_w" "$_text" 2>"$_lbf")"; _heard="$(cat "$_lbf")"; rm -f "$_w" "$_lbf"
  _min="${MVTX_LOOPBACK_MIN:-0.35}"
  echo "voice=$_voice text='$_text'"
  echo "heard='$_heard'"
  echo "sim=$_sim (min=$_min)"
  if [ "$_sim" = "n/a" ]; then echo "loopback: SKIP (no whisper)"; exit 0; fi
  if awk "BEGIN{exit !($_sim >= $_min)}" 2>/dev/null; then
    echo "loopback: OK"; exit 0
  else
    echo "loopback: MISMATCH (likely wrong-language voice — EN needs ryan/lessac)"; exit 1
  fi
fi

# ── --chunks: DEBUG — print how a text would batch for the clone daemon (no synth, no send) ──────
if [ "${1:-}" = "--chunks" ]; then
  shift; [ $# -ge 1 ] || { echo "usage: mesh-voice-tx --chunks <text>"; exit 1; }
  _split_text "$*" "${MVTX_CHUNK_CHARS:-500}"
  exit 0
fi

ENVF="$HOME/.config/remote-access/env"; set -a; . "$ENVF" 2>/dev/null; set +a
# THE ENV FILE WINS OVER THE CALLER — `set -a; . "$ENVF"` above overwrites CHAT_ID with the
# operator's, so `CHAT_ID=<someone else> mesh-voice-tx ...` silently addresses the OPERATOR. Measured
# 2026-08-26: a note meant for the second operator was aimed at the owner's DM and only mesh-tg-guard
# (audience=peer, id not in the peer set) stopped it — a fail-closed guard caught what an env
# precedence bug had already mis-addressed. The override therefore has to be applied AFTER the
# source, under its OWN name, so it cannot be clobbered by a file that has every right to set CHAT_ID.
[ -n "${MVTX_CHAT_ID:-}" ] && CHAT_ID="$MVTX_CHAT_ID"
PIPER="$HOME/.mesh/piper/piper/piper"; VOICES="$HOME/.mesh/piper/voices"
VOICE="${MESH_VOICE:-ruslan}"
FFMPEG="$(python3 -c 'import imageio_ffmpeg;print(imageio_ffmpeg.get_ffmpeg_exe())' 2>/dev/null || echo ffmpeg)"
BOSE_NODE="${BOSE_NODE:-}"; BOSE_DEV="${BOSE_DEV:-plughw:1,0}"
CLONE_MAX="${MVTX_CHUNK_CHARS:-500}"   # per-call char budget: a few sentences, seconds of clone synth

synth_clone(){ # $1=text $2=out_wav → clone-voice wav; rc 0 ok, else the FIRST failing mesh-voice-say rc
  # Keep the operator's OWN voice on long text: split into batches under CLONE_MAX and synth each in
  # its own mesh-voice-say call (fresh MESH_CLONE_TIMEOUT per call), then concat the wavs. A batch that
  # genuinely can't synth (daemon down rc=5 / error) aborts to the caller's piper fallback with that rc
  # — we never mix clone+piper mid-message, and "text was long" alone no longer forces piper.
  local text="$1" out="$2" rc c i=0 w tmpd lst
  if [ "${#text}" -le "$CLONE_MAX" ]; then mesh-voice-say "$text" "$out" 2>/dev/null; return $?; fi
  tmpd="$(mktemp -d "${TMPDIR:-/tmp}"/mvtx-chunks-XXXXXX)"; lst="$tmpd/list.txt"
  local _chunks=(); mapfile -t _chunks < <(_split_text "$text" "$CLONE_MAX")
  for c in "${_chunks[@]}"; do
    [ -n "${c// /}" ] || continue
    w="$tmpd/$(printf '%03d' "$i").wav"
    if ! mesh-voice-say "$c" "$w" 2>/dev/null; then rc=$?; rm -rf "$tmpd"; return "$rc"; fi
    printf "file '%s'\n" "$w" >> "$lst"; i=$((i+1))
  done
  [ "$i" -gt 0 ] || { rm -rf "$tmpd"; return 1; }
  # concat (daemon wavs are all 24kHz mono → -c copy; re-encode fallback if params ever drift)
  "$FFMPEG" -hide_banner -loglevel error -y -f concat -safe 0 -i "$lst" -c copy "$out" 2>/dev/null \
    || "$FFMPEG" -hide_banner -loglevel error -y -f concat -safe 0 -i "$lst" -ar 24000 -ac 1 "$out" 2>/dev/null
  rc=$?; rm -rf "$tmpd"
  [ -s "$out" ] && return 0; return "${rc:-1}"
}

# ── --chunk-synth: DEBUG/TEST — run the real synth_clone (chunk+concat) to a wav, print its path ──
if [ "${1:-}" = "--chunk-synth" ]; then
  shift; [ $# -ge 2 ] || { echo "usage: mesh-voice-tx --chunk-synth <text> <out.wav>"; exit 1; }
  synth_clone "$1" "$2"; exit $?
fi
# parse flags (any order) until the first non-flag = start of TEXT
bose=0; tg=1; verify=0; verify_acoustic=0; auto=0; auto_present=0
while [ $# -gt 0 ]; do
  case "$1" in
    --bose)            bose=1; shift;;
    --bose-only)       bose=1; tg=0; shift;;
    --auto)            auto=1; shift;;
    --verify)          verify=1; shift;;
    --verify-acoustic) verify_acoustic=1; verify=1; shift;;   # implies --verify
    *) break;;
  esac
done

# ── --auto: presence-routed channel selection (gen-pair mesh-room-sense × mesh-voice-tx, 2026-06-27)
# voice-tx has two channels (Bose=aloud-in-room, Telegram=reach-the-phone) but the caller picked blind:
# it would buzz the operator's phone while they stand in the room, or talk aloud to an empty room.
# --auto reads mesh-room-sense's cron-fresh cached verdict and routes: PRESENT → speak aloud on the Bose
# (no phone buzz); EMPTY/UNCERTAIN/stale/missing → Telegram voice note (reach the away operator).
# Honest-degrade rule: ANYTHING but a FRESH PRESENT falls to Telegram — a dead/stale reflex or an
# unreadable verdict must never silence the message by assuming someone's there to hear it aloud.
# (Robustness: if the Bose later gets voice-gate-suppressed, the gate block below re-enables Telegram so
#  an auto-PRESENT message is never dropped silently.)
if [ "$auto" = 1 ]; then
  RS_STATE="${MESH_DIR:-$HOME/.mesh}/.room-sense.state"
  RS_FRESH_MAX="${MVTX_ROOMSENSE_MAX:-900}"   # 3× the 5-min --edge cron stride; older ⇒ reflex suspect
  rs_verdict=""; rs_age=""
  if [ -f "$RS_STATE" ]; then
    rs_age=$(( $(date +%s) - $(stat -c %Y "$RS_STATE" 2>/dev/null || echo 0) ))
    # .room-sense.state is LABEL|dwell_s=N|changes_24h=N since the dwell enrichment — take the
    # label field, or PRESENT never matches and auto voice silently ALWAYS falls to Telegram
    # (found live 2026-07-03, same multi-field class as the home-state dead-veto).
    [ "$rs_age" -le "$RS_FRESH_MAX" ] && rs_verdict="$(tr -d '[:space:]' < "$RS_STATE" 2>/dev/null | cut -d'|' -f1)"
  fi
  if [ "$rs_verdict" = PRESENT ]; then
    bose=1; tg=0; auto_present=1
    echo "[voice-auto] room PRESENT (verdict ${rs_age}s old) → speak aloud on Bose, no Telegram" >&2
  else
    bose=0; tg=1
    echo "[voice-auto] room ${rs_verdict:-UNKNOWN}${rs_age:+ (verdict ${rs_age}s old)} → Telegram voice note" >&2
  fi
fi
TEXT="$*"; [ -n "${TEXT// /}" ] || { echo "usage: mesh-voice-tx [--bose|--bose-only|--auto] [--verify|--verify-acoustic] <text>" >&2; exit 1; }

# ── input + delivery CONTRACT (chat-review 07-24, from tg 02:24Z): the tool used to (a) accept
# unbounded text and grind a novel, (b) grind every clone chunk for a TG client that was already
# killed/revoked, then (c) on send failure exit rc=0 with EMPTY stdout = silent death (the caller
# saw success-shaped nothing). Now each is a loud refusal / non-zero exit — a call that delivers
# NOTHING may never look like it succeeded. cf the silent-death class (note3 termux-SSH 02:19Z).
# length contract: refuse BEFORE synth so we never grind past a sane voice-note bound.
_mvtx_max="${MVTX_MAX_CHARS:-4000}"
if [ "${#TEXT}" -gt "$_mvtx_max" ]; then
  echo "mesh-voice-tx: REFUSED — ${#TEXT} chars > MVTX_MAX_CHARS=$_mvtx_max (split the message or raise the cap)" >&2
  echo "[mesh-voice-tx: REFUSED too-long ${#TEXT}>$_mvtx_max chars]"; exit 8
fi
# TG liveness preflight (tg the SOLE sink): a killed/revoked client makes the whole clone grind
# wasted, so probe getMe BEFORE synth. Skipped when creds are absent (the post-synth mesh-tg-guard
# refuses that case) and when Bose is also on (Bose delivery needs no TG). Honest-degrade: a flaky
# TG refuses loud (rc=3) instead of grinding then dying silent.
#
# A PREFLIGHT TIMEOUT BELOW THE NODE'S OWN LATENCY IS A FALSE DEATH CERTIFICATE. The probe used a
# flat `--max-time 8` while a HEALTHY getMe from mesh-home measures 3.2–7.2s (n=5, 2026-08-14 —
# this node's egress is slow, not broken; cf memory egress-is-slow-not-truncating). Zero margin: one
# ordinary slow sample refused a live channel and the operator's reply was never synthesized OR sent
# — and the message BLAMED THE WRONG THING ("unreachable/revoked"), sending the reader to re-issue
# the bot token when nothing was wrong with it. So: a generous budget, one retry, and a verdict that
# distinguishes SLOW (curl rc=28, timeout) from REVOKED (a real answer that is not ok:true).
if [ "$tg" = 1 ] && [ "$bose" = 0 ] && [ -n "${BOT_TOKEN:-}" ] && [ -n "${CHAT_ID:-}" ]; then
  _mvtx_probe_t="${MVTX_PROBE_TIMEOUT:-20}"; _gm_ok=0; _gm_rc=0; _gm_body=''
  for _try in 1 2; do
    _gm_body=$(curl -s --max-time "$_mvtx_probe_t" "https://api.telegram.org/bot${BOT_TOKEN}/getMe" 2>/dev/null); _gm_rc=$?
    case "$_gm_body" in *'"ok":true'*) _gm_ok=1; break ;; esac
    [ "$_try" = 1 ] && sleep 2
  done
  if [ "$_gm_ok" != 1 ]; then
    # name the cause we can actually tell apart, and never say "revoked" on a timeout
    if [ "$_gm_rc" = 28 ] || [ -z "$_gm_body" ]; then
      _why="unreachable — getMe timed out twice at ${_mvtx_probe_t}s (SLOW/DOWN egress, NOT a revoked token; raise MVTX_PROBE_TIMEOUT if this node got slower)"
      _tag="TG-unreachable"
    else
      _why="REVOKED/rejected — getMe answered but not ok:true (the token or bot is actually bad)"
      _tag="TG-revoked"
    fi
    echo "mesh-voice-tx: REFUSED — TG $_why; not grinding ${#TEXT} chars for a dead channel" >&2
    echo "[mesh-voice-tx: REFUSED $_tag — synth skipped]"; exit 3
  fi
fi
WAV="$(mktemp "${TMPDIR:-/tmp}"/mvtx-XXXXXX.wav)"; OGG="${WAV%.wav}.ogg"; SRCV=clone; delivered=0
# THE MESH SPEAKS IN THE OPERATOR'S OWN VOICE — synthesize via the warm clone daemon; fall back to
# piper/ruslan ONLY if the clone fails, and say WHY loudly, branched on the daemon's ACTUAL rc
# (mesh-voice-say contract: 5=unreachable, 7=synth timeout). The old bare rc!=0 printed one canned
# "fix mesh-voice-clone.service" for EVERY failure — a long text outrunning the 180s synth cap on a
# HEALTHY daemon was misreported as a dead service (chat-review 07-18, re-bitten 07-21).
if synth_clone "$TEXT" "$WAV"; then :; else
  vs_rc=$?
  SRCV=piper
  case "$vs_rc" in
    5) echo "mesh-voice-tx: CLONE DAEMON UNREACHABLE → piper/ruslan fallback (fix mesh-voice-clone.service)" >&2;;
    8) echo "mesh-voice-tx: clone REFUSED — daemon healthy but SATURATED (queue full at MESH_CLONE_MAXDEPTH); it answered in ms, so this is not a slow synth and not a dead service → piper/ruslan fallback" >&2;;
    7) echo "mesh-voice-tx: clone synth TIMEOUT on ${#TEXT}-char text — daemon busy/slow, NOT down; chunk the text or raise MESH_CLONE_TIMEOUT → piper/ruslan fallback" >&2;;
    *) echo "mesh-voice-tx: clone synth failed (rc=$vs_rc, not a daemon-down signal) → piper/ruslan fallback" >&2;;
  esac
  [ -x "$PIPER" ] && [ -f "$VOICES/$VOICE.onnx" ] || { echo "no clone AND piper/voice missing ($VOICE)" >&2; rm -f "$WAV"; exit 1; }
  printf '%s\n' "$TEXT" | "$PIPER" -m "$VOICES/$VOICE.onnx" -f "$WAV" 2>/dev/null
fi
[ -s "$WAV" ] && [ "$(stat -c%s "$WAV")" -gt 1000 ] || { echo "TTS produced no audio ($SRCV)" >&2; rm -f "$WAV"; exit 1; }

# ── SOFTWARE loopback (runtime, --verify): is the synthesized voice actually intelligible? ───────
if [ "$verify" = 1 ]; then
  _lbf="$(mktemp)"; _sim="$(loopback "$WAV" "$TEXT" 2>"$_lbf")"; _heard="$(cat "$_lbf")"; rm -f "$_lbf"
  _min="${MVTX_LOOPBACK_MIN:-0.35}"
  if [ "$_sim" = "n/a" ]; then
    echo "[voice-loopback] SKIP (whisper n/a on this node)" >&2
  elif awk "BEGIN{exit !($_sim >= $_min)}" 2>/dev/null; then
    echo "[voice-loopback] ok (sim=$_sim voice=$VOICE)"
  else
    echo "[voice-loopback] MISMATCH (sim=$_sim voice=$VOICE heard='$_heard') — likely wrong-language voice (EN needs ryan/lessac)" >&2
    [ "${MVTX_LOOPBACK_STRICT:-0}" = 1 ] && { echo "[voice-loopback] STRICT → refuse to send garbled voice" >&2; rm -f "$WAV" "$OGG"; exit 4; }
  fi
fi

# voice gate (operator 2026-06-24): check the BOSE NODE's silence/thermal state BEFORE playing there
# (where the sound actually comes out). On suppress, skip Bose but still allow the TG voice note.
if [ "$bose" = 1 ] && command -v mesh-voice-gate >/dev/null 2>&1 && ! mesh-voice-gate --node "$BOSE_NODE" 2>/dev/null; then
  echo "[Bose suppressed — voice gate on $BOSE_NODE]" >&2; bose=0
  # --auto fallback: we picked aloud-only because the operator is PRESENT, but the room won't let us
  # play (quiet hours / thermal). Re-route to Telegram so the message still reaches them, never dropped.
  [ "$auto_present" = 1 ] && [ "$tg" = 0 ] && { tg=1; echo "[voice-auto] Bose suppressed → falling back to Telegram voice note" >&2; }
fi
if [ "$bose" = 1 ]; then
  # The Bose is a PipeWire sink owned by the DESKTOP user (uid 1000), not root — and the target
  # (default-string) has only pw-play, no pactl/paplay. The old root+pactl path always failed
  # there (root's /run/user/0 has no pipewire session). Fix (2026-06-19, operator's repeated "play
  # on the колонка"): detect the user that owns the pipewire process, runuser to it with ITS
  # XDG_RUNTIME_DIR, and pw-play to the default sink (= the Bose). Falls back to paplay if present.
  # SELF-PLAYBACK GATE (operator 2026-06-24): touch ~/.mesh/mesh-speaking on the room node DURING
  # playback so mesh-overhear's mic drains — don't capture our own Bose output as 'ambient music'.
  bose_ok=0
  if scp -q -o BatchMode=yes -o ConnectTimeout=8 "$WAV" "$BOSE_NODE:/tmp/mvtx.wav" 2>/dev/null; then
    if ssh -o BatchMode=yes -o ConnectTimeout=10 "$BOSE_NODE" bash -s 2>/dev/null <<'REOF' | grep -q OK
pu=$(ps -o user= -C pipewire 2>/dev/null | head -1); pu=${pu:-$(id -un)}
puid=$(id -u "$pu" 2>/dev/null)
touch "$HOME/.mesh/mesh-speaking" 2>/dev/null
cmd="export XDG_RUNTIME_DIR=/run/user/$puid; pw-play /tmp/mvtx.wav 2>/dev/null && echo PW_OK || paplay /tmp/mvtx.wav 2>/dev/null && echo PA_OK"
if [ "$pu" = "$(id -un)" ]; then sh -c "$cmd"; else runuser -u "$pu" -- sh -c "$cmd"; fi
rm -f "$HOME/.mesh/mesh-speaking" 2>/dev/null
REOF
    then bose_ok=1; fi
  fi
  [ "$bose_ok" = 1 ] && echo "[played on Bose via pipewire]" || echo "[Bose playback failed]" >&2
  # ACOUSTIC loopback (--verify-acoustic): pw-play rc=0 above does NOT prove sound came out — the
  # Bose may be powered OFF but still connected (the incident the operator hit). Record the room mic
  # right after and confirm it's non-silent.
  if [ "$bose_ok" = 1 ] && [ "$verify_acoustic" = 1 ]; then
    _micrms="$(acoustic_loopback)"
    _floor="${MVTX_ACOUSTIC_FLOOR:-400}"
    if [ -z "$_micrms" ]; then
      echo "[acoustic-loopback] SKIP (couldn't record mic on $BOSE_NODE)" >&2
    elif [ "$_micrms" -lt "$_floor" ] 2>/dev/null; then
      echo "[acoustic-loopback] SILENCE (mic rms=$_micrms < $_floor) — Bose powered off / muted / mic down?" >&2
      [ "${MVTX_LOOPBACK_STRICT:-0}" = 1 ] && { echo "[acoustic-loopback] STRICT → treat as failure" >&2; exit 5; }
    else
      echo "[acoustic-loopback] ok (mic rms=$_micrms ≥ $_floor)"
    fi
  fi
fi
[ "${bose_ok:-0}" = 1 ] && delivered=1
# gf-borrowing-4: gate the TG send through the SHARED sign-guard (fail-closed). A wrong-sign CHAT_ID
# (group/channel id, or wrong person) is REFUSED + logged and tg disabled — never sent. Bootstrap
# fallback (guard binary absent): refuse a negative/empty id inline. (Was UNguarded: 2 raw curls.)
# AUDIENCE (2026-08-26): default personal = the operator, byte-identical to before. A caller that
# is speaking to a RECOGNIZED SECOND HUMAN sets MVTX_AUDIENCE=peer + CHAT_ID=<her id>; the guard's
# peer allowlist, not this file, decides whether that id is real.
MVTX_AUDIENCE="${MVTX_AUDIENCE:-personal}"
if [ "$tg" = 1 ]; then
  if command -v mesh-tg-guard >/dev/null 2>&1; then
    mesh-tg-guard --check "${CHAT_ID:-}" "$MVTX_AUDIENCE" >/dev/null 2>&1 || { echo "[mesh-voice-tx: TG REFUSED by mesh-tg-guard — chat_id ${CHAT_ID:-unset} audience=$MVTX_AUDIENCE; not sent]" >&2; tg=0; }
  else
    case "${CHAT_ID:-}" in -*|'') echo "[mesh-voice-tx: TG REFUSED — bad/negative chat_id ${CHAT_ID:-unset} (mesh-tg-guard absent)]" >&2; tg=0 ;; esac
  fi
fi
if [ "$tg" = 1 ]; then
  "$FFMPEG" -hide_banner -loglevel error -y -i "$WAV" -c:a libopus -b:a 32k "$OGG" 2>/dev/null
  if [ -s "$OGG" ] && curl -s --max-time 30 "https://api.telegram.org/bot${BOT_TOKEN}/sendVoice" \
        -F "chat_id=${CHAT_ID}" -F "voice=@\"${OGG}\";type=audio/ogg" 2>/dev/null | grep -q '"ok":true'; then
    if [ "$MVTX_AUDIENCE" = personal ]; then echo "[voice note sent to operator Telegram]"; else echo "[voice note sent to $MVTX_AUDIENCE Telegram (chat_id ${CHAT_ID})]"; fi; delivered=1
  else echo "[Telegram sendVoice failed]" >&2; fi
  # duplicate as TEXT too (operator prefers text) unless --no-text
  if [ "${MVTX_NOTEXT:-0}" != 1 ]; then
    curl -s --max-time 15 "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${CHAT_ID}" --data-urlencode "text=🗣️ $TEXT" >/dev/null 2>&1 && echo "[text duplicated to Telegram]"
  fi
  # record the reply so mesh-tg-reply-watch sees a voice reply as a real reply (not silence) — else
  # the backstop false-fires an auto-receipt after every voice answer. Same format as mesh-tg.
  # PERSONAL ONLY: tg-sent.log is the tape of what the OPERATOR has been answered. A note spoken to
  # somebody else written into it would discharge his silence with a message he never received —
  # the backstop watching for an unanswered operator would go quiet on the strength of a reply
  # addressed to a third party.
  if [ "$MVTX_AUDIENCE" = personal ]; then
    printf '%sZ  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S)" "[voice] $(printf '%s' "$TEXT" | head -c 110 | tr '\n' ' ')" >> "$HOME/.mesh/tg-sent.log" 2>/dev/null || true
  fi
fi
# delivery CONTRACT (chat-review 07-24): if NO channel delivered the voice, exit non-zero with a loud
# STDOUT marker — never rc=0 + empty stdout (the silent death). Bose-failed, TG-send-failed,
# suppressed, or gate-refused-after-synth: all converge here as "not delivered" instead of
# success-shaped nothing. Same rc=3 as the TG preflight refusal (both = "voice did not deliver").
if [ "$delivered" = 0 ]; then
  _why="bose=${bose_ok:-0}"
  [ "$tg" = 1 ] && _why="$_why tg-send-attempted" || _why="$_why tg-off"
  echo "mesh-voice-tx: NOT DELIVERED — no channel delivered the voice ($_why)" >&2
  echo "[mesh-voice-tx: NOT DELIVERED — voice reached no channel]"; rm -f "$WAV" "$OGG"; exit 3
fi
rm -f "$WAV" "$OGG"
