#!/usr/bin/env bash
# mesh-voice-tx — the mesh SPEAKS to the operator: TTS (Piper neural voice) -> a Telegram VOICE note
# and/or the Bose speaker on default-string. The reply half of the voice channel.
#
#   mesh-voice-tx "текст"             send a voice note to the operator's Telegram
#   mesh-voice-tx --bose "текст"      ALSO play it on the Bose (default-string, card 1)
#   mesh-voice-tx --bose-only "текст" only Bose, no Telegram
# Voice via $MESH_VOICE (default ruslan = ru male; also irina/ryan/lessac).
set -uo pipefail
ENVF="$HOME/.config/remote-access/env"; set -a; . "$ENVF" 2>/dev/null; set +a
PIPER="$HOME/.mesh/piper/piper/piper"; VOICES="$HOME/.mesh/piper/voices"
VOICE="${MESH_VOICE:-ruslan}"
FFMPEG="$(python3 -c 'import imageio_ffmpeg;print(imageio_ffmpeg.get_ffmpeg_exe())' 2>/dev/null || echo ffmpeg)"
BOSE_NODE="${BOSE_NODE:-imozerov@100.125.157.75}"; BOSE_DEV="${BOSE_DEV:-plughw:1,0}"
bose=0; tg=1
case "${1:-}" in --bose) bose=1; shift;; --bose-only) bose=1; tg=0; shift;; esac
TEXT="$*"; [ -n "${TEXT// /}" ] || { echo "usage: mesh-voice-tx [--bose|--bose-only] <text>" >&2; exit 1; }
[ -x "$PIPER" ] && [ -f "$VOICES/$VOICE.onnx" ] || { echo "piper/voice missing ($VOICE)" >&2; exit 1; }
WAV="$(mktemp /tmp/mvtx-XXXXXX.wav)"; OGG="${WAV%.wav}.ogg"
printf '%s\n' "$TEXT" | "$PIPER" -m "$VOICES/$VOICE.onnx" -f "$WAV" 2>/dev/null
[ -s "$WAV" ] && [ "$(stat -c%s "$WAV")" -gt 1000 ] || { echo "TTS produced no audio" >&2; rm -f "$WAV"; exit 1; }
if [ "$bose" = 1 ]; then
  if scp -q -o BatchMode=yes -o ConnectTimeout=8 "$WAV" "$BOSE_NODE:/tmp/mvtx.wav" 2>/dev/null \
     && ssh -o BatchMode=yes -o ConnectTimeout=8 "$BOSE_NODE" \
          "export XDG_RUNTIME_DIR=/run/user/\$(id -u); aplay -q -D $BOSE_DEV /tmp/mvtx.wav 2>/dev/null || aplay -q /tmp/mvtx.wav 2>/dev/null" 2>/dev/null; then
    echo "[played on Bose]"
  else echo "[Bose playback failed]" >&2; fi
fi
if [ "$tg" = 1 ]; then
  "$FFMPEG" -hide_banner -loglevel error -y -i "$WAV" -c:a libopus -b:a 32k "$OGG" 2>/dev/null
  if [ -s "$OGG" ] && curl -s --max-time 30 "https://api.telegram.org/bot${BOT_TOKEN}/sendVoice" \
        -F "chat_id=${CHAT_ID}" -F "voice=@${OGG};type=audio/ogg" 2>/dev/null | grep -q '"ok":true'; then
    echo "[voice note sent to operator Telegram]"
  else echo "[Telegram sendVoice failed]" >&2; fi
fi
rm -f "$WAV" "$OGG"
