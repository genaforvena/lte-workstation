#!/usr/bin/env bash
# mesh-voice-tx — the mesh SPEAKS to the operator: TTS (Piper neural voice) -> a Telegram VOICE note
# and/or the Bose speaker on default-string. The reply half of the voice channel.
#
#   mesh-voice-tx "текст"             send a voice note to the operator's Telegram
#   mesh-voice-tx --bose "текст"      ALSO play it on the Bose (default-string, card 1)
#   mesh-voice-tx --bose-only "текст" only Bose, no Telegram
# Voice via $MESH_VOICE (default ruslan = ru male; also irina/ryan/lessac).
set -uo pipefail
ENVF="$HOME/.config/remote-access/env"; set -a; . "$ENVF" 2>/dev/null; set +a
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"   # node registry may define BOSE_NODE (no hardcoded IP — plantable)
PIPER="$HOME/.mesh/piper/piper/piper"; VOICES="$HOME/.mesh/piper/voices"
VOICE="${MESH_VOICE:-ruslan}"
FFMPEG="$(python3 -c 'import imageio_ffmpeg;print(imageio_ffmpeg.get_ffmpeg_exe())' 2>/dev/null || echo ffmpeg)"
BOSE_NODE="${BOSE_NODE:-}"   # where the Bose lives (user@host); set in ~/.mesh/nodes. Empty -> --bose unavailable.
bose=0; tg=1
case "${1:-}" in --bose) bose=1; shift;; --bose-only) bose=1; tg=0; shift;; esac
TEXT="$*"; [ -n "${TEXT// /}" ] || { echo "usage: mesh-voice-tx [--bose|--bose-only] <text>" >&2; exit 1; }
[ -x "$PIPER" ] && [ -f "$VOICES/$VOICE.onnx" ] || { echo "piper/voice missing ($VOICE)" >&2; exit 1; }
WAV="$(mktemp /tmp/mvtx-XXXXXX.wav)"; OGG="${WAV%.wav}.ogg"
printf '%s\n' "$TEXT" | "$PIPER" -m "$VOICES/$VOICE.onnx" -f "$WAV" 2>/dev/null
[ -s "$WAV" ] && [ "$(stat -c%s "$WAV")" -gt 1000 ] || { echo "TTS produced no audio" >&2; rm -f "$WAV"; exit 1; }
if [ "$bose" = 1 ]; then
  if [ -z "$BOSE_NODE" ]; then echo "[Bose: no BOSE_NODE configured — set it in ~/.mesh/nodes]" >&2
  else
  # Play ONCE on the Bose, which lives on $BOSE_NODE as a PipeWire sink. Pick the RIGHT sink — prefer the
  # live IEC958/USB link over a bluetooth duplicate — target it explicitly, and report only on REAL
  # success (no more "played" when nothing sounded). pactl is often absent (use wpctl+pw-play); the
  # remote helper is base64'd to dodge ssh/awk quoting hell. Match string overridable via BOSE_SINK_MATCH.
  RSH=$(base64 -w0 <<'REMOTE'
export XDG_RUNTIME_DIR=/run/user/$(id -u)
match="${BOSE_SINK_MATCH:-Bose}"
if command -v wpctl >/dev/null 2>&1 && command -v pw-play >/dev/null 2>&1; then
  sid=$(wpctl status 2>/dev/null | awk -v m="$match" '
    /Sinks:/{s=1;next} /endpoints:|Sources:/{s=0}
    s && index($0,m){l=$0; if(match(l,/[0-9]+\./)){id=substr(l,RSTART,RLENGTH-1);
      if(l ~ /IEC958/ && iec=="")iec=id; if(any=="")any=id}}
    END{print (iec!=""?iec:any)}')
  if [ -n "$sid" ]; then pw-play --target "$sid" /tmp/mvtx.wav && echo "PLAYED:$sid"
  else pw-play /tmp/mvtx.wav && echo "PLAYED:default"; fi
elif command -v pactl >/dev/null 2>&1; then
  sink=$(pactl list short sinks 2>/dev/null | awk -v m="$match" 'index($0,m){print $2;exit}')
  [ -n "$sink" ] && paplay --device="$sink" /tmp/mvtx.wav && echo "PLAYED:$sink"
elif command -v pw-play >/dev/null 2>&1; then
  pw-play /tmp/mvtx.wav && echo "PLAYED:default"
fi
rm -f /tmp/mvtx.wav
REMOTE
)
  played=""
  if scp -q -o BatchMode=yes -o ConnectTimeout=8 "$WAV" "$BOSE_NODE:/tmp/mvtx.wav" 2>/dev/null; then
    played=$(ssh -o BatchMode=yes -o ConnectTimeout=12 "$BOSE_NODE" "echo $RSH | base64 -d | bash" 2>/dev/null)
  fi
  if printf '%s' "$played" | grep -q '^PLAYED:'; then echo "[played once on Bose ($BOSE_NODE ${played#PLAYED:})]"
  else echo "[Bose playback failed — no reachable sink on $BOSE_NODE]" >&2; fi
  fi
fi
if [ "$tg" = 1 ]; then
  "$FFMPEG" -hide_banner -loglevel error -y -i "$WAV" -c:a libopus -b:a 32k "$OGG" 2>/dev/null
  if [ -s "$OGG" ] && curl -s --max-time 30 "https://api.telegram.org/bot${BOT_TOKEN}/sendVoice" \
        -F "chat_id=${CHAT_ID}" -F "voice=@${OGG};type=audio/ogg" 2>/dev/null | grep -q '"ok":true'; then
    echo "[voice note sent to operator Telegram]"
  else echo "[Telegram sendVoice failed]" >&2; fi
  # duplicate as TEXT too (operator prefers text) unless --no-text
  if [ "${MVTX_NOTEXT:-0}" != 1 ]; then
    curl -s --max-time 15 "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${CHAT_ID}" --data-urlencode "text=🗣️ $TEXT" >/dev/null 2>&1 && echo "[text duplicated to Telegram]"
  fi
fi
rm -f "$WAV" "$OGG"
