#!/usr/bin/env bash
# mesh-clock-sync — CLOCK-SYNC sense: is this node's wall clock actually disciplined to NTP,
#   and by how far is it off? The mesh's ENTIRE liveness model is timestamp-based leases
#   (memory liveness-is-lease-not-cached-status: a status is a live announce with a TTL, judged
#   by mtime/now deltas). A node whose clock silently drifts or whose time daemon died poisons
#   EVERY freshness check, staleness watchdog, and lease it participates in — reading fresh as
#   stale or stale as fresh — and nothing in the sensorium perceives that. mesh-ambient-clock is
#   activity-TEMPO, not NTP; this is the real time-discipline signal.
#   Reads systemd-timesyncd (`timedatectl`) or chrony (`chronyc tracking`) — whichever disciplines
#   the clock here — PLUS the kernel's own NTP discipline state via adjtimex(2) modes=0.
# HONEST: NO-NTP (no time daemon running) is a REAL perceived verdict (this node WILL drift), NOT
#   an unreachable. exit 2 (BLIND) is reserved for when we cannot even ASK — neither timedatectl nor
#   chronyc exists — so we never fake a SYNCED from an unreadable signal.
#
# A SAMPLE THE PRODUCER REFUSED IS NOT THE CLOCK'S ERROR (find {#51c547d8}, discover 2026-08-28,
# verified twice by health with its own sampler — 193 rows at 5s and 83 rows at 10s).
#   `timedatectl timesync-status`'s `Offset:` is the LAST RECEIVED packet, accepted or NOT. On
#   accept the two views AGREE (kernel -96.040 vs rendered -90.13ms); they diverge ONLY on reject.
#   The field is not wrong, it is UNQUALIFIED — and this tool used to key its whole verdict on it.
#   Both failure directions were caught on tape:
#     * FALSE ALARM  — pkt 35, Ignored=yes, rendered -727.908ms while the kernel's applied offset
#                      was -0.462ms. This tool printed DRIFT — offset 728ms.
#     * FALSE ALL-CLEAR (the worse one) — pkt 38, seven minutes later, Ignored=yes, rendered
#                      -238.946ms, UNDER the 250ms threshold => SYNCED. Same unbroken rejection
#                      condition, same dead axis, opposite words. The verdict was a coin-flip on
#                      which discarded packet landed last.
#   And the regime ALTERNATES packet by packet (41 ignored / 42 accepted, interleaved), so a verdict
#   keyed on "has there been an accept RECENTLY" reads healthy straight through it. The acceptance
#   bit must be read for the SAMPLE BEING RENDERED. It lives ONLY in the property view
#   (`timedatectl show-timesync --all`, inside NTPMessage=), which — measured — does NOT carry
#   Offset/Delay/RootDistance at all: a fix must read BOTH views, or take the offset from the kernel.
#   (Trap health hit: an unanchored `Delay=` matches `RootDelay=6.622ms` and renders 0.006ms.)
#
# THE VERDICT AXIS IS THE KERNEL'S maxerror, NOT A PACKET.
#   adjtimex(2) modes=0 is unprivileged (rc=0 as uid 1000) and sends no packet. `maxerror` ramps at
#   exactly `tolerance/65536` µs/s (500 µs/s here, measured twice independently) and is RESET at each
#   successful discipline, so `maxerror / rate` is SECONDS SINCE THE LAST ACCEPTED SAMPLE — the one
#   axis a rejected packet cannot move. The healthy ceiling is DERIVED from the live poll interval
#   (`poll_s × rate × slack`), never a constant: at a 1024 s poll a healthy sample sits anywhere in
#   0…512 ms by construction.
#   SATURATION: `maxerror` rails at NTP_PHASE_LIMIT = (MAXPHASE/NSEC_PER_USEC)<<5 = 16 000 000 µs
#   (this node's own headers, timex.h:135,140) — 8.9 h at 500 µs/s — and the kernel then sets
#   STA_UNSYNC. Past the rail it is a SATURATED LEVEL and the age is UNRECOVERABLE from it
#   (doctrine a-saturated-level-is-not-a-state), so since-sync renders SATURATED, never a number.
#   NOT LANDED, deliberately: the reset does NOT go to the root distance (resets read
#   1.0/2.5/0.5/3.5/3.5/3.0 ms against a root distance of 3.5-4.0 ms — below it and variable), and
#   Delay separates accept from reject perfectly over n=9 but that is a MEASURED CORRELATION, not
#   timesyncd's documented rule. Neither is a constant this tool is entitled to.
#
# ITS BOARD CHANNEL HAD NEVER PRODUCED A LINE IN 33 DAYS (health, same find, second defect).
#   The durable store held [access-state] 1320, [hw-fault] 552, [situation-change] 230 and
#   [clock-synced]/[clock-drift] ZERO, across transitions that demonstrably happened. post() was
#   `command -v mesh-chat && mesh-chat "$*" >/dev/null 2>&1` — the outcome swallowed, so a mesh-chat
#   that FAILED was byte-identical to one that succeeded, on the single line carrying this sense's
#   entire voice. post() now carries mesh-chat's rc and traces a failure, and every --edge eval
#   writes a RUN row to its own durable ledger whatever the outcome (doctrine
#   a-tape-of-only-positives-is-a-numerator), so "never fired" and "fired into a void" stop
#   rendering identically. The ledger is deliberately NOT the cron stdout tape ~/.mesh/clock-sync.log.
#
# AND THE 33-DAY SILENCE WAS NOT THE SWALLOWED rc — IT WAS THE PATH (genome, landing {#51c547d8}).
#   The swallowed rc is why nobody could SEE it, and it is fixed above; the cause is one line lower.
#   cron gives a user crontab PATH=/usr/bin:/bin, where mesh-chat does not exist, so post()'s
#   `command -v mesh-chat` was false at EVERY cron fire while being true in every hand-drive from a
#   login shell — which is exactly why health's manual drive of the branch succeeded and the board
#   stayed empty (memory a-login-shells-path-hides-a-dead-cron-reflex). Every reflex on this node
#   that DOES reach the board carries the export below (mesh-hw-fault-watch:81, mesh-access-probe:59,
#   mesh-exit-node-lan-heal:71); this one never had it. Gated by driving --edge under
#   `env -i HOME=<fake> PATH=/usr/bin:/bin` with the only mesh-chat living in the fake home's
#   .local/bin — the post must still land.
# reflex-cadence: 19,49 * * * *
# reflex-args: --edge
set -u
export PATH="$HOME/.local/bin:$PATH"

STATE="${MESH_CLOCKSYNC_STATE:-$HOME/.mesh/clock-sync.state}"
LEDGER="${MESH_CLOCKSYNC_LEDGER:-$HOME/.mesh/clock-sync-edges.log}"
DRIFT_MS="${MESH_CLOCK_DRIFT_MS:-250}"   # |offset| over this (ms), on an ACCEPTED sample, => DRIFT
# how many whole poll intervals without an accepted sample before the kernel axis says DRIFT.
# 1 would false-alarm: maxerror legitimately reaches poll_s*rate just before every healthy poll.
SLACK="${MESH_CLOCK_MAXERR_SLACK:-2}"
# kernel rail: NTP_PHASE_LIMIT µs. Past this maxerror is saturated and carries no age.
PHASE_LIMIT_US="${MESH_CLOCK_PHASE_LIMIT_US:-16000000}"

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ledger — durable, append-only, one row per --edge eval (RUN) plus one per transition (EDGE/POSTED/
# POST-FAIL). The RUN row is unconditional: it is the DENOMINATOR, so a silence in this tape is
# downtime and never "the verdict held".
ledger() {
  local d; d="$(dirname "$LEDGER")"
  [ -d "$d" ] || mkdir -p "$d" 2>/dev/null || return 0
  printf '%s %s %s\n' "$(now_iso)" "$1" "${2-}" >> "$LEDGER" 2>/dev/null || true
}

# verdict_for <synced> <ntp> <abs_offset_ms|NA> <off_qual:yes|no|NA> <maxerr_us|NA> <ceiling_us|NA> <saturated:yes|no|NA>
#   -> SYNCED|DRIFT|UNSYNCED|NO-NTP|UNKNOWN
# UNKNOWN is an ABSTENTION, not a fault: it says this run could not qualify any axis. It is in the
# consumer's alphabet (mesh-time-integrity ntp_class -> UNREACH, named in the degraded field).
verdict_for() {
  local synced="$1" ntp="$2" off="$3" qual="$4" maxerr="$5" ceil="$6" sat="$7"
  if [ "$ntp" != yes ]; then echo NO-NTP; return; fi
  if [ "$synced" != yes ]; then echo UNSYNCED; return; fi
  # 1. kernel axis first — it is packet-free and a rejected sample cannot move it.
  if [ "$sat" = yes ]; then echo DRIFT; return; fi
  if [ "$maxerr" != NA ] && [ "$ceil" != NA ]; then
    if [ "$maxerr" -gt "$ceil" ] 2>/dev/null; then echo DRIFT; else echo SYNCED; fi
    return
  fi
  # 2. no kernel axis — the packet offset may stand in ONLY if the producer accepted it.
  if [ "$qual" = yes ] && [ "$off" != NA ]; then
    if [ "$off" -gt "$DRIFT_MS" ] 2>/dev/null; then echo DRIFT; else echo SYNCED; fi
    return
  fi
  # 3. the sample was REFUSED (or unqualifiable) and no kernel axis: we cannot say. Abstain.
  echo UNKNOWN
}

# parse a systemd/chrony offset token (e.g. "-1.910ms", "12.3us", "0.000123 seconds") -> ABS whole ms
abs_ms() {
  awk -v s="$1" 'BEGIN{
    if (!match(s,/-?[0-9]+(\.[0-9]+)?/)) { print "NA"; exit }
    num=substr(s,RSTART,RLENGTH)+0
    if (index(s,"ms")>0)                    unit="ms"
    else if (index(s,"us")>0||index(s,"µs")>0) unit="us"
    else                                    unit="s"   # "seconds" / bare s
    if (unit=="us") num=num/1000; else if (unit=="s") num=num*1000
    if (num<0) num=-num
    printf "%.0f", num
  }'
}

# parse a systemd duration ("17min 4s", "34min 8s", "2h 5min 3s", "32s", "500ms") -> whole SECONDS.
# Longest-suffix-first so "min" is never eaten by "m"/"s".
dur_s() {
  awk -v s="$1" 'BEGIN{
    t=0; n=0
    while (match(s,/[0-9]+(\.[0-9]+)?(us|ms|min|h|d|s|w)/)) {
      tok=substr(s,RSTART,RLENGTH); s=substr(s,RSTART+RLENGTH)
      match(tok,/[0-9]+(\.[0-9]+)?/); v=substr(tok,RSTART,RLENGTH)+0
      u=substr(tok,RSTART+RLENGTH)
      if      (u=="us")  t+=v/1000000
      else if (u=="ms")  t+=v/1000
      else if (u=="s")   t+=v
      else if (u=="min") t+=v*60
      else if (u=="h")   t+=v*3600
      else if (u=="d")   t+=v*86400
      else if (u=="w")   t+=v*604800
      n++
    }
    if (n==0) { print "NA"; exit }
    printf "%.0f", t
  }'
}

# qual_from_ignored <the raw Ignored= value> -> "<accepted> <off_qual>"
# The whole find turns on this one mapping: Ignored=yes means the producer REFUSED the sample, so
# its offset is not a statement about the clock. Inverting it silently restores both the false alarm
# and the false all-clear, so it is gated offline in both directions and cross-checked live.
qual_from_ignored() {
  case "$1" in
    yes) echo "no no" ;;
    no)  echo "yes yes" ;;
    *)   echo "NA NA" ;;
  esac
}

# board post — carries mesh-chat's rc. A swallowed outcome on the single line that IS this sense's
# voice is how it stayed silent for 33 days; never restore the `|| true` here.
# sandbox-gated: MESH_CLOCKSYNC_NOCHAT=1 suppresses real outbound so --edge is testable.
post() {
  local msg="$*" rc=0
  if [ -n "${MESH_CLOCKSYNC_NOCHAT:-}" ]; then
    echo "[would-post] $msg" >&2; ledger WOULD-POST "$msg"; return 0
  fi
  if ! command -v mesh-chat >/dev/null 2>&1; then
    ledger POST-FAIL "no-mesh-chat-on-PATH :: $msg"
    echo "mesh-clock-sync: POST FAILED — no mesh-chat on PATH; this edge reached nobody" >&2
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "mesh-clock-sync: edge post FAILED (no mesh-chat on PATH)" >/dev/null 2>&1
    return 1
  fi
  mesh-chat "$msg" >/dev/null 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    ledger POST-FAIL "mesh-chat rc=$rc :: $msg"
    echo "mesh-clock-sync: POST FAILED — mesh-chat rc=$rc; this edge reached nobody" >&2
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "mesh-clock-sync: edge post FAILED (mesh-chat rc=$rc)" >/dev/null 2>&1
    return 1
  fi
  ledger POSTED "$msg"
  return 0
}

# --- the kernel's own NTP discipline state (adjtimex modes=0, unprivileged, ZERO packets) --------
# sets KMAXERR_US KOFF_MS KSTATUS KRATE KSAT; all NA when unreadable. NEVER 0 on failure.
KMAXERR_US=NA; KOFF_MS=NA; KSTATUS=NA; KRATE=NA; KSAT=NA
read_kernel() {
  command -v python3 >/dev/null 2>&1 || return 1
  local out
  out="$(timeout 5 python3 - <<'PYEOF' 2>/dev/null
import ctypes, ctypes.util
class TV(ctypes.Structure): _fields_=[("s",ctypes.c_long),("us",ctypes.c_long)]
class TX(ctypes.Structure):
    _fields_=[("modes",ctypes.c_uint),("offset",ctypes.c_long),("freq",ctypes.c_long),
      ("maxerror",ctypes.c_long),("esterror",ctypes.c_long),("status",ctypes.c_int),
      ("constant",ctypes.c_long),("precision",ctypes.c_long),("tolerance",ctypes.c_long),
      ("time",TV),("tick",ctypes.c_long),("ppsfreq",ctypes.c_long),("jitter",ctypes.c_long),
      ("shift",ctypes.c_int),("stabil",ctypes.c_long),("jitcnt",ctypes.c_long),
      ("calcnt",ctypes.c_long),("errcnt",ctypes.c_long),("stbcnt",ctypes.c_long),
      ("tai",ctypes.c_int),("pad",ctypes.c_int*11)]
libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
t = TX(); t.modes = 0
rc = libc.adjtimex(ctypes.byref(t))
if rc < 0: raise SystemExit(1)
# STA_NANO (0x2000): offset is ns when set, us when clear. A reader that hardcodes one unit is
# off by 1000x on the other discipliner.
off_ms = (t.offset / 1e6) if (t.status & 0x2000) else (t.offset / 1e3)
# ramp rate is the kernel's OWN tolerance (ppm), not a constant: 32768000/65536 = 500 us/s here.
rate = t.tolerance / 65536.0
print("%d %.3f 0x%04x %.0f" % (t.maxerror, off_ms, t.status & 0xffff, rate))
PYEOF
)" || return 1
  [ -n "$out" ] || return 1
  read -r KMAXERR_US KOFF_MS KSTATUS KRATE <<< "$out"
  case "$KMAXERR_US" in ''|*[!0-9-]*) KMAXERR_US=NA; KOFF_MS=NA; KSTATUS=NA; KRATE=NA; return 1;; esac
  [ "$KRATE" -gt 0 ] 2>/dev/null || { KRATE=NA; }
  # SATURATED: the kernel raises STA_UNSYNC (0x0040) at the rail. Check the flag AND the level, so
  # a discipliner that does not raise the flag still cannot publish a rail value as an age.
  local unsync=0
  [ "$(( $(printf '%d' "$KSTATUS") & 0x0040 ))" -ne 0 ] 2>/dev/null && unsync=1
  if [ "$unsync" -eq 1 ]; then KSAT=yes
  elif [ "$KRATE" != NA ] && [ "$KMAXERR_US" -ge "$(( PHASE_LIMIT_US - KRATE ))" ] 2>/dev/null; then KSAT=yes
  else KSAT=no; fi
  return 0
}

# read_clock: sets VERDICT OFFSET_MS SERVER STRATUM JITTER SRC ACCEPTED OFF_QUAL POLL_S CEIL_US AXIS
#   SAMPLE_MS; returns 0 if perceivable, 2 if BLIND.
VERDICT=""; OFFSET_MS="NA"; SAMPLE_MS="NA"; SERVER="?"; STRATUM="?"; JITTER="?"; SRC="?"
ACCEPTED="NA"; OFF_QUAL="NA"; POLL_S="NA"; CEIL_US="NA"; AXIS="none"
read_clock() {
  read_kernel || true
  if command -v chronyc >/dev/null 2>&1; then
    local tr leap off_s
    tr="$(timeout 5 chronyc tracking 2>/dev/null)" || tr=""
    if [ -n "$tr" ]; then
      SRC="chrony"
      leap="$(printf '%s\n' "$tr" | sed -n 's/^Leap status *: *//p')"
      SERVER="$(printf '%s\n' "$tr" | sed -n 's/^Reference ID *: *//p' | awk '{print $1}')"
      STRATUM="$(printf '%s\n' "$tr" | sed -n 's/^Stratum *: *//p')"
      off_s="$(printf '%s\n' "$tr" | sed -n 's/^System time *: *\([0-9.]*\).*/\1/p')"
      [ -n "$off_s" ] && SAMPLE_MS="$(abs_ms "${off_s} s")" || SAMPLE_MS="NA"
      # chrony's "System time" is the CURRENT system offset from the tracked source — a statement
      # about the clock, not a raw packet. It is qualified by construction; there is no per-packet
      # acceptance bit to read, so ACCEPTED stays n/a rather than borrowing a word it did not earn.
      OFF_QUAL=yes; ACCEPTED="n/a"
      OFFSET_MS="$SAMPLE_MS"
      local ntp=yes synced=no
      case "$leap" in Normal*|"Insert leap second"*|"Delete leap second"*) synced=yes;; *) synced=no;; esac
      finish_verdict "$synced" "$ntp"
      return 0
    fi
  fi
  if command -v timedatectl >/dev/null 2>&1; then
    SRC="timesyncd"
    local ntp synced ts prop off ign poll
    ntp="$(timedatectl show -p NTP --value 2>/dev/null)"
    synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
    ts="$(timeout 5 timedatectl timesync-status 2>/dev/null)"
    if [ -n "$ts" ]; then
      SERVER="$(printf '%s\n' "$ts" | sed -n 's/^[[:space:]]*Server: *//p' | head -1)"
      STRATUM="$(printf '%s\n' "$ts" | sed -n 's/^[[:space:]]*Stratum: *//p' | head -1)"
      JITTER="$(printf '%s\n' "$ts" | sed -n 's/^[[:space:]]*Jitter: *//p' | head -1)"
      off="$(printf '%s\n' "$ts" | sed -n 's/^[[:space:]]*Offset: *//p' | head -1)"
      [ -n "$off" ] && SAMPLE_MS="$(abs_ms "$off")" || SAMPLE_MS="NA"
    fi
    # THE ACCEPTANCE BIT LIVES ONLY IN THE PROPERTY VIEW, inside the NTPMessage= blob, and that view
    # carries NO Offset/Delay/RootDistance — so both views are required. Anchor on a non-letter
    # before Ignored= (there is no RootIgnored, but the sibling trap RootDelay/Delay is one field
    # away and cost health a rendered 0.006ms).
    prop="$(timeout 5 timedatectl show-timesync --all 2>/dev/null)" || prop=""
    if [ -n "$prop" ]; then
      ign="$(printf '%s\n' "$prop" | sed -n 's/.*[^A-Za-z]Ignored=\([A-Za-z]*\).*/\1/p' | head -1)"
      poll="$(printf '%s\n' "$prop" | sed -n 's/^PollIntervalUSec=//p' | head -1)"
      [ -n "$poll" ] || poll="$(printf '%s\n' "$prop" | sed -n 's/^PollIntervalMaxUSec=//p' | head -1)"
      [ -n "$poll" ] && POLL_S="$(dur_s "$poll")"
      read -r ACCEPTED OFF_QUAL <<< "$(qual_from_ignored "$ign")"
    fi
    # the clock's ERROR ESTIMATE: the kernel's applied offset when we have it (on ACCEPT the two
    # views agree to a few ms; on REJECT only the kernel is a statement about the clock), else the
    # sample but ONLY if the producer accepted it. A refused sample is never rendered as the error.
    if [ "$KOFF_MS" != NA ]; then OFFSET_MS="$(abs_ms "${KOFF_MS}ms")"
    elif [ "$OFF_QUAL" = yes ]; then OFFSET_MS="$SAMPLE_MS"
    else OFFSET_MS="NA"; fi
    [ "$ntp" = yes ] || { [ "$synced" = yes ] && ntp=yes || ntp=no; }
    [ "$synced" = yes ] || synced=no
    finish_verdict "$synced" "$ntp"
    return 0
  fi
  return 2   # neither chronyc nor timedatectl — cannot ASK -> BLIND
}

# derive the ceiling from the LIVE poll interval (never a constant) and pick the verdict.
finish_verdict() {
  local synced="$1" ntp="$2"
  if [ "$POLL_S" != NA ] && [ "$KRATE" != NA ]; then
    CEIL_US="$(( POLL_S * KRATE * SLACK ))"
  else
    CEIL_US=NA
  fi
  VERDICT="$(verdict_for "$synced" "$ntp" "$OFFSET_MS" "$OFF_QUAL" "$KMAXERR_US" "$CEIL_US" "$KSAT")"
  if   [ "$KSAT" = yes ];                                     then AXIS="kernel-maxerror(SATURATED)"
  elif [ "$KMAXERR_US" != NA ] && [ "$CEIL_US" != NA ];       then AXIS="kernel-maxerror"
  elif [ "$OFF_QUAL" = yes ] && [ "$OFFSET_MS" != NA ];       then AXIS="accepted-sample-offset"
  else                                                             AXIS="none(abstained)"; fi
}

# since-sync, or the honest word. A saturated level carries NO age.
since_sync() {
  if [ "$KSAT" = yes ]; then echo "SATURATED(>${PHASE_LIMIT_US}us rail — age unrecoverable)"; return; fi
  if [ "$KMAXERR_US" = NA ] || [ "$KRATE" = NA ]; then echo "na"; return; fi
  printf '%ss' "$(( KMAXERR_US / KRATE ))"
}

human_line() {
  local off="$OFFSET_MS" smp="$SAMPLE_MS" ceil
  [ "$off" = NA ] && off="?" || off="${off}ms"
  [ "$smp" = NA ] && smp="?" || smp="${smp}ms"
  case "$ACCEPTED" in
    no)  smp="$smp REJECTED" ;;
    yes) smp="$smp accepted" ;;
    n/a) smp="$smp (no per-packet bit)" ;;
    *)   smp="$smp acceptance-UNKNOWN" ;;
  esac
  if [ "$CEIL_US" = NA ]; then ceil="?"; else ceil="$(( CEIL_US / 1000 ))ms"; fi
  echo "clock-sync: ${VERDICT} — clock error ${off} [axis ${AXIS}] · last sample ${smp} · since-sync $(since_sync) (ceiling ${ceil}) (server ${SERVER:-?}, stratum ${STRATUM:-?}, src ${SRC})"
}

# --- --test ------------------------------------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
  fail=""
  # every write target moved into one scratch dir ONCE, exported, so no later test site can forge
  # the durable liveness artifacts by forgetting its own redirection.
  _tt="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp -d)"; exit 1; }
  trap 'rm -rf "$_tt"' EXIT INT HUP TERM
  export MESH_CLOCKSYNC_STATE="$_tt/state" MESH_CLOCKSYNC_LEDGER="$_tt/ledger" MESH_CLOCKSYNC_NOCHAT=1
  STATE="$MESH_CLOCKSYNC_STATE"; LEDGER="$MESH_CLOCKSYNC_LEDGER"
  SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
  # sandbox honesty, TRACE half (mesh-guardian shape; mesh-gpu-lid 180e578 is the pattern):
  # post()'s failure leg calls the REAL mesh-trace, so every --test appended a "post FAILED"
  # forgery to the durable ~/.mesh/traces.log — the shared trace a human/watchdog reads to answer
  # whether this organ ever fired. Measured 2026-09-03: one --test grew traces.log by 95B with
  # exactly that line. The dry-run gets its OWN sink (a *test*-named cap, exempt by name in
  # mesh-test-forgery), and MESH_DIR is diverted too so child-process mesh-trace calls land there.
  _REALTRACE="${MESH_DIR:-$HOME/.mesh}/traces.log"
  _REALTRACE_SZ="$(stat -c %s "$_REALTRACE" 2>/dev/null || echo 0)"
  _tcap="$_tt/trace-test.log"; : > "$_tcap"
  mesh-trace(){ printf '%s\n' "$*" >> "$_tcap"; return 0; }
  export MESH_DIR="$_tt/mesh"; mkdir -p "$MESH_DIR"
  _reallog_untouched(){
    local now; now="$(stat -c %s "$_REALTRACE" 2>/dev/null || echo 0)"
    [ "$now" = "$_REALTRACE_SZ" ] \
      || { echo "smoke-test: FAIL (sandbox: --test APPENDED to the production trace $_REALTRACE ($_REALTRACE_SZ → $now) — a dry-run that writes the liveness record forges it)"; exit 1; }
  }

  # -- legacy offline arms (kernel axis absent => the accepted-sample fallback) --
  [ "$(verdict_for yes yes 5    yes NA NA no)" = SYNCED ]   || fail="$fail synced!=SYNCED"
  [ "$(verdict_for yes yes 9999 yes NA NA no)" = DRIFT ]    || fail="$fail bigoff!=DRIFT"
  [ "$(verdict_for no  yes NA   NA NA NA NA)"  = UNSYNCED ] || fail="$fail nosync!=UNSYNCED"
  [ "$(verdict_for yes no  5    yes NA NA no)" = NO-NTP ]   || fail="$fail nontp!=NO-NTP"

  # -- THE FIND, arm A: a REJECTED sample must NOT produce DRIFT (the false alarm, pkt 35) --
  [ "$(verdict_for yes yes 728 no NA NA NA)" != DRIFT ] || fail="$fail rejected-sample-still-alarms"
  [ "$(verdict_for yes yes 728 no NA NA NA)" = UNKNOWN ] || fail="$fail rejected-no-kernel!=UNKNOWN"
  # -- THE FIND, arm B: a REJECTED sample must NOT produce SYNCED either (the FALSE ALL-CLEAR,
  #    pkt 38: -238.946ms is under DRIFT_MS and used to read SYNCED through a live rejection) --
  [ "$(verdict_for yes yes 239 no NA NA NA)" != SYNCED ] || fail="$fail FALSE-ALL-CLEAR-on-rejected-sample"
  # and the two rejected packets must not disagree with each other — the coin-flip is the defect
  [ "$(verdict_for yes yes 728 no NA NA NA)" = "$(verdict_for yes yes 239 no NA NA NA)" ] \
    || fail="$fail rejected-verdict-still-depends-on-the-discarded-offset"

  # -- THE FIND, arm C: a ramping maxerror with no accepted sample MUST produce a loud verdict,
  #    and it must do so REGARDLESS of how flattering the last discarded packet looked --
  [ "$(verdict_for yes yes 5 no 2000000 1024000 no)" = DRIFT ] || fail="$fail ramped-maxerror!=DRIFT"
  [ "$(verdict_for yes yes 512000 yes 180000 1024000 no)" = SYNCED ] || fail="$fail healthy-ramp!=SYNCED"
  # the kernel axis WINS over a fat accepted sample: 765ms of packet offset with a fresh kernel
  [ "$(verdict_for yes yes 765 yes 180000 1024000 no)" = SYNCED ] || fail="$fail kernel-axis-not-primary"

  # -- SATURATION: a railed accumulator is DRIFT, and it must never publish an age.
  #    The fixture must NOT be one the numeric maxerror>ceiling branch would also call DRIFT, or
  #    deleting the saturation branch passes for the wrong reason (this arm was blind once: with
  #    ceiling=1024000 the arm went green under a mutant that removed the branch entirely).
  #    Both fixtures here are ones where EVERY other branch says something else:
  #      ceil NA + a flattering accepted sample -> without the branch this is SYNCED
  #      ceil NA + a refused sample             -> without the branch this is UNKNOWN
  [ "$(verdict_for yes yes 5 yes 16000000 NA yes)" = DRIFT ] || fail="$fail saturated(no-ceiling,clean-sample)!=DRIFT"
  [ "$(verdict_for yes yes 5 no  16000000 NA yes)" = DRIFT ] || fail="$fail saturated(no-ceiling,refused-sample)!=DRIFT"
  [ "$(verdict_for yes yes 5 yes 16000000 1024000 yes)" = DRIFT ] || fail="$fail saturated!=DRIFT"
  ( KSAT=yes; KMAXERR_US=16000000; KRATE=500
    case "$(since_sync)" in *SATURATED*) exit 0;; *) exit 1;; esac ) || fail="$fail saturated-publishes-an-age"
  ( KSAT=no; KMAXERR_US=NA; KRATE=NA
    [ "$(since_sync)" = na ] || exit 1 ) || fail="$fail unreadable-maxerror-not-na"

  # -- ceiling is DERIVED from the live poll interval, not a constant --
  ( POLL_S=1024; KRATE=500; SLACK=2; KMAXERR_US=1; KSAT=no; OFF_QUAL=yes; OFFSET_MS=1
    finish_verdict yes yes; [ "$CEIL_US" = 1024000 ] || exit 1 ) || fail="$fail ceiling-not-derived-from-poll"
  ( POLL_S=NA; KRATE=500; KMAXERR_US=1; KSAT=no; OFF_QUAL=no; OFFSET_MS=NA
    finish_verdict yes yes; [ "$CEIL_US" = NA ] && [ "$VERDICT" = UNKNOWN ] || exit 1 ) \
    || fail="$fail no-poll-interval-did-not-abstain"

  # -- parsers --
  [ "$(abs_ms "-1.910ms")" = 2 ]  || fail="$fail abs_ms(ms)!=2"
  [ "$(abs_ms "12300us")"  = 12 ] || fail="$fail abs_ms(us)!=12"
  [ "$(abs_ms "0.5 s")"    = 500 ]|| fail="$fail abs_ms(s)!=500"
  [ "$(dur_s "17min 4s")"  = 1024 ] || fail="$fail dur_s(17min 4s)!=1024"
  [ "$(dur_s "34min 8s")"  = 2048 ] || fail="$fail dur_s(34min 8s)!=2048"
  [ "$(dur_s "32s")"       = 32 ]   || fail="$fail dur_s(32s)!=32"
  [ "$(dur_s "2h 5min")"   = 7500 ] || fail="$fail dur_s(2h 5min)!=7500"
  [ "$(dur_s "")"          = NA ]   || fail="$fail dur_s(empty)!=NA"
  # the sibling-field trap: an unanchored Ignored=/Delay= grab must not read a Root* twin
  _blob='NTPMessage={ RootDelay=6.622ms, RootDispersion=198us, Ignored=yes, PacketCount=43 }'
  [ "$(printf '%s\n' "$_blob" | sed -n 's/.*[^A-Za-z]Ignored=\([A-Za-z]*\).*/\1/p')" = yes ] \
    || fail="$fail ignored-parse-broken"

  # -- the acceptance MAPPING itself, in both directions. Without this arm an inverted mapping
  #    (Ignored=yes read as accepted) passes every other gate here and undoes the entire fix --
  [ "$(qual_from_ignored yes)" = "no no" ]   || fail="$fail Ignored=yes-not-read-as-REFUSED"
  [ "$(qual_from_ignored no)"  = "yes yes" ] || fail="$fail Ignored=no-not-read-as-accepted"
  [ "$(qual_from_ignored "")"  = "NA NA" ]   || fail="$fail unreadable-Ignored-not-NA"
  [ "$(qual_from_ignored wat)" = "NA NA" ]   || fail="$fail unlisted-Ignored-value-not-NA"

  # -- SECOND DEFECT: the post path must not swallow a failed mesh-chat --
  ( export PATH="$_tt/bin:$PATH"; mkdir -p "$_tt/bin"
    printf '#!/bin/sh\nexit 7\n' > "$_tt/bin/mesh-chat"; chmod +x "$_tt/bin/mesh-chat"
    unset MESH_CLOCKSYNC_NOCHAT
    LEDGER="$_tt/ledger-post"
    if post "[clock-drift] test" 2>/dev/null; then exit 1; fi   # a failed post must return non-zero
    grep -q 'POST-FAIL mesh-chat rc=7' "$_tt/ledger-post" || exit 1
  ) || fail="$fail failed-post-is-swallowed"
  # the failure leg's mesh-trace must still fire — into the sandboxed sink, never the durable one.
  # Without this arm a dropped trace call passes every other gate here and silences the failure path.
  grep -q 'edge post FAILED' "$_tcap" || fail="$fail failure-trace-not-sandboxed"
  ( export PATH="$_tt/bin-ok:$PATH"; mkdir -p "$_tt/bin-ok"
    printf '#!/bin/sh\nexit 0\n' > "$_tt/bin-ok/mesh-chat"; chmod +x "$_tt/bin-ok/mesh-chat"
    unset MESH_CLOCKSYNC_NOCHAT
    LEDGER="$_tt/ledger-ok"
    post "[clock-synced] test" 2>/dev/null || exit 1
    grep -q '^[0-9T:Z-]* POSTED ' "$_tt/ledger-ok" || exit 1
  ) || fail="$fail successful-post-not-ledgered"

  # -- THE CRON-PATH ARM: under a cron-like environment (PATH=/usr/bin:/bin, nothing inherited) the
  #    post must STILL reach mesh-chat. This is the arm that was missing for 33 days: every hand
  #    drive from a login shell passed while every cron fire posted into nothing.
  ( _fh="$_tt/fakehome"; mkdir -p "$_fh/.local/bin" "$_fh/.mesh"
    printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/stub-chat.log"\n' > "$_fh/.local/bin/mesh-chat"
    chmod +x "$_fh/.local/bin/mesh-chat"
    printf '999|DRIFT|seed|2\n' > "$_fh/.mesh/clock-sync.state"
    env -i HOME="$_fh" PATH=/usr/bin:/bin "$SELF" --edge >/dev/null 2>&1
    [ -s "$_fh/.mesh/stub-chat.log" ] || exit 1
    grep -q 'clock-' "$_fh/.mesh/stub-chat.log" || exit 1
  ) || fail="$fail cron-PATH-post-never-reached-mesh-chat"

  [ -n "$fail" ] && { echo "smoke-test: FAIL ($fail )"; exit 1; }

  # -- real-read gate (doctrine: --test must assert a LIVE read produces data) --
  if read_clock; then
    case "$VERDICT" in
      SYNCED|DRIFT|UNSYNCED|NO-NTP|UNKNOWN) : ;;
      *) echo "smoke-test: FAIL (live read produced no valid verdict: '$VERDICT')"; exit 1;;
    esac
    # -- WIRING: drive the real --edge entry point (not just its parts) under the scratch env and
    #    assert the durable ledger got its unconditional RUN row. A tape of only positives is a
    #    numerator; the RUN row is the denominator that separates "never fired" from "fired into
    #    a void". Seeds first (no post on first observation), so this needs two runs.
    # cross-check the rendered acceptance bit against an INDEPENDENT parse of the same view, so a
    # broken anchor in the tool's own sed cannot agree with itself.
    if _p="$(timeout 5 timedatectl show-timesync --all 2>/dev/null)" && [ -n "$_p" ]; then
      _ig="$(printf '%s\n' "$_p" | grep -o 'Ignored=[a-z]*' | head -1 | cut -d= -f2)"
      case "$_ig:$ACCEPTED" in
        yes:no|no:yes|:NA) : ;;
        *) echo "smoke-test: FAIL (live acceptance bit mis-rendered: Ignored=$_ig but ACCEPTED=$ACCEPTED)"; exit 1;;
      esac
    fi
    "$SELF" --edge >/dev/null 2>&1 || { echo "smoke-test: FAIL (--edge rc!=0)"; exit 1; }
    "$SELF" --edge >/dev/null 2>&1 || { echo "smoke-test: FAIL (--edge rc!=0 on second run)"; exit 1; }
    [ -s "$LEDGER" ] || { echo "smoke-test: FAIL (--edge wrote no ledger row — the 33-day silence)"; exit 1; }
    [ "$(grep -c ' RUN ' "$LEDGER")" -ge 2 ] \
      || { echo "smoke-test: FAIL (--edge did not write a RUN row per eval: $(cat "$LEDGER"))"; exit 1; }
    [ -s "$STATE" ] || { echo "smoke-test: FAIL (--edge wrote no state)"; exit 1; }
    _reallog_untouched
    echo "smoke-test: ok (logic sound; LIVE read -> $(human_line | sed 's/^clock-sync: //'); --edge wrote $(wc -l < "$LEDGER") ledger row(s))"
    exit 0
  else
    _reallog_untouched
    echo "smoke-test: ok (logic sound; no timedatectl/chronyc here -> sense reports BLIND/exit2, honest n/a)"
    exit 0
  fi
fi

# --- --rate: count the ledger by verb over the tape's OWN span. An ABSENT tape is UNKNOWN, never 0.
if [ "${1:-}" = "--rate" ]; then
  if [ ! -s "$LEDGER" ]; then
    echo "clock-sync edges: UNKNOWN — no ledger at $LEDGER (never run, or the tape was removed). Not zero."
    exit 2
  fi
  first="$(head -1 "$LEDGER" | awk '{print $1}')"; last="$(tail -1 "$LEDGER" | awk '{print $1}')"
  echo "clock-sync edges: $first -> $last ($(wc -l < "$LEDGER") rows)"
  awk '{c[$2]++} END{for (v in c) printf "  %-12s %d\n", v, c[v]}' "$LEDGER" | sort
  exit 0
fi

# --- read the real signal (or honest BLIND) ----------------------------------------------------
if ! read_clock; then
  echo "clock-sync: BLIND (no timedatectl/chronyc — cannot perceive time discipline) — not synced, UNKNOWN"
  exit 2
fi

# --- --edge: stateful reflex. CHANGE-GATED content + state-touch EVERY run (mtime=ran-live) -----
if [ "${1:-}" = "--edge" ]; then
  prev_verdict=NONE
  [ -r "$STATE" ] && IFS='|' read -r _ prev_verdict _ < "$STATE" 2>/dev/null || true
  [ -n "$prev_verdict" ] || prev_verdict=NONE
  mkdir -p "$(dirname "$STATE")" 2>/dev/null
  # UNCONDITIONAL run row — the denominator. Written before any change gate, so a silence in this
  # tape is downtime and never "the verdict held" (a-tape-of-only-positives-is-a-numerator).
  ledger RUN "verdict=$VERDICT prev=$prev_verdict axis=$AXIS error_ms=$OFFSET_MS sample_ms=$SAMPLE_MS accepted=$ACCEPTED maxerr_us=$KMAXERR_US ceil_us=$CEIL_US since_sync=$(since_sync) src=$SRC"
  # value-changed (content) — owned by this change-gated write
  if [ "$VERDICT" != "$prev_verdict" ]; then
    printf '%s|%s|%s|%s\n' "$OFFSET_MS" "$VERDICT" "${SERVER:-?}" "${STRATUM:-?}" > "$STATE"
  fi
  # ran-live (mtime) — owned by the shared primitive, refreshed on EVERY successful eval so a
  # long-stable SYNCED can never decay into a FALSE STALE (memory boot-grace/liveness-touch).
  if command -v mesh-state-touch >/dev/null 2>&1; then mesh-state-touch --create "$STATE" >/dev/null 2>&1
  else touch "$STATE"; fi
  [ "$prev_verdict" = NONE ] && { ledger SEED "verdict=$VERDICT (first observation — no post)"; exit 0; }
  if [ "$VERDICT" != "$prev_verdict" ]; then
    ledger EDGE "$prev_verdict -> $VERDICT axis=$AXIS"
    case "$VERDICT" in
      SYNCED) post "[clock-synced] $(hostname): clock re-disciplined to NTP — error ${OFFSET_MS}ms, since-sync $(since_sync), axis $AXIS (server ${SERVER:-?}). Timestamp leases trustworthy again." ;;
      UNKNOWN) post "[clock-drift] $(hostname): clock discipline UNKNOWN (was $prev_verdict) — the last NTP sample was REFUSED by the producer and the kernel's adjtimex axis is unreadable here, so nothing this run can qualify the clock's error. This is an ABSTENTION, not an all-clear: treat this node's timestamp leases as unverified. src ${SRC}." ;;
      *)      post "[clock-drift] $(hostname): clock $VERDICT (was $prev_verdict) — error ${OFFSET_MS}ms, since-sync $(since_sync) past a ${CEIL_US}us ceiling, axis $AXIS, last sample ${SAMPLE_MS}ms accepted=${ACCEPTED}, src ${SRC}. Timestamp-based liveness leases across the mesh are UNRELIABLE on this node until NTP recovers." ;;
    esac
  fi
  exit 0
fi

# --- --json ------------------------------------------------------------------------------------
if [ "${1:-}" = "--json" ]; then
  off="$OFFSET_MS";  [ "$off" = NA ] && off=null
  smp="$SAMPLE_MS";  [ "$smp" = NA ] && smp=null
  mxe="$KMAXERR_US"; [ "$mxe" = NA ] && mxe=null
  cel="$CEIL_US";    [ "$cel" = NA ] && cel=null
  pol="$POLL_S";     [ "$pol" = NA ] && pol=null
  printf '{"verdict":"%s","offset_ms":%s,"sample_offset_ms":%s,"sample_accepted":"%s","axis":"%s","maxerror_us":%s,"since_sync":"%s","saturated":"%s","ceiling_us":%s,"poll_s":%s,"server":"%s","stratum":"%s","jitter":"%s","source":"%s"}\n' \
    "$VERDICT" "$off" "$smp" "$ACCEPTED" "$AXIS" "$mxe" "$(since_sync)" "$KSAT" "$cel" "$pol" \
    "${SERVER:-?}" "${STRATUM:-?}" "${JITTER:-?}" "$SRC"
  exit 0
fi

# --- one-shot human read -----------------------------------------------------------------------
human_line
case "$VERDICT" in
  SYNCED) : ;;
  UNKNOWN) echo "  ABSTAINED: the last NTP sample was REFUSED by the producer and no kernel axis was readable — this run cannot say whether the clock is disciplined. Not an all-clear." ;;
  *) echo "  WARN: this node's clock is not cleanly NTP-disciplined — its mesh timestamps may be skewed." ;;
esac
echo "  (use --edge for the stateful reflex; --json for machines; --rate for the edge ledger)"
exit 0
