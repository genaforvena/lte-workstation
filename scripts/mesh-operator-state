#!/usr/bin/env bash
# mesh-operator-state — derived sense: WHERE IS THE OPERATOR'S ATTENTION?
# Folds body-motion (STILL/CARRIED/HANDLED/COVERED + lux + steps-delta + linaccel)
# + personal BLE device proximity (from cached presence.log) into one operator-state label.
# When phone SSH is unreachable, falls back to IdeaPad-local signals (mic + phone LAN)
# for a coarser but honest derived state instead of collapsing to UNKNOWN.
#
# States (full — phone SSH reachable):
#   AT-PHONE  — actively using phone (HANDLED, or steps increasing, or high accel)
#   NEARBY    — phone parked + personal device close (Quest VR at close range = in room)
#   AWAY      — STILL + no personal device signal + no activity → probably not in room
#   COVERED   — phone face-down on surface (COVERED body-state)
#   ASLEEP    — STILL + very dark + late night hours (23:00-07:00)
#
# States (degraded — phone SSH down, IdeaPad-local signals only):
#   AT-DESK   — IdeaPad mic LOUD/MODERATE + phone home on LAN → active at computer
#   NEARBY    — close personal BLE + quiet mic / no mic → operator still in the space
#   HOME-IDLE — IdeaPad mic QUIET/SILENCE + phone home on LAN → home but idle/resting
#   AWAY      — phone NOT on LAN → operator left (no phone = no operator)
#   UNKNOWN   — phone LAN unreachable AND ambient-level unavailable AND no close BLE → cannot assess
#
# Honest-degraded contract: SILENCE ≠ UNAVAILABLE — a silent mic is a real reading;
# UNAVAILABLE means the mic tool itself failed. Both are shown distinctly in signals.
# JSON field "degraded": true when local-only fallback was used (phone SSH was down).
#
# FOCUS axis (cross-sense fusion with mesh-jack — node-local analog-jack plug state):
#   orthogonal to location, it names the desk's listening/recording MODE so the attention read is
#   richer than position alone — "AT-DESK + PRIVATE-LISTENING" vs "AT-DESK + OPEN(speakers)".
#     HEADPHONES → PRIVATE-LISTENING · EXT-MIC → RECORDING · HEADSET → CALL-RIG · OPEN → OPEN
#   It is HEADLESS-SAFE (no phone, no SSH) so it survives the degraded path where every phone axis is
#   dead. Honest-degraded, THREE distinct non-readings (empty ≠ failed): focus=UNAVAILABLE (jack tool
#   missing) vs UNREACHABLE (jack exits 2 — no codec / headless VM, jacks absent) vs OPEN (jacks
#   present, nothing plugged — a REAL empty). jack reports a peripheral STATE not a plug EVENT (a
#   headset can sit plugged on an empty desk) → focus NEVER upgrades a non-present verdict to present.
#
# CALL_VERIFIED axis (2nd-order cross-sense fusion: focus × mesh-audio-mode, itself a fusion of
#   mic-capture + playback): jack alone cannot tell a plugged headset from a LIVE call — a headset
#   left on an empty desk still reads focus=CALL-RIG. Crossing it with mesh-audio-mode's real
#   capture+playback read corroborates or debunks that guess:
#     CONFIRMED   — focus=CALL-RIG AND audio-mode=CALL (headset + live call both independently seen)
#     UNCONFIRMED — focus=CALL-RIG but audio-mode says otherwise (headset plugged, no live call —
#                   catches the "headset left on" false-CALL-RIG case jack alone cannot)
#     UNKNOWN     — focus=CALL-RIG but mesh-audio-mode is absent/dark (cannot corroborate, honest gap)
#     N/A         — focus != CALL-RIG (nothing being claimed, nothing to verify)
#
# MEDIA_CONTEXT axis (2nd-order cross-sense fusion: operator presence × mesh-media-scene):
# mesh-media-scene attributes room sound using local playback, iMac playback, TV BLE, and mic.
# Crossing its fresh scene with this fusion's operator state distinguishes "operator at desk while
# the room sound is TV/live/unattributed" — a joint context no body or mic axis can provide alone.
# Missing/stale/malformed media state stays UNKNOWN and is shown as such.
#
# MOBILE_LINK axis (cross-sense fusion with mesh-wifi-link):
# body motion says what the phone is doing while Wi-Fi link quality says whether that moving
# phone still has a usable radio path. Their joint states name mobile continuity/degradation that
# neither axis can name alone. A transport failure is UNREACHABLE; a real phone read reporting
# DISCONNECTED is MOBILE-OFFLINE — these are intentionally different visible outcomes.
#
#   mesh-operator-state           one-line state + key signals
#   mesh-operator-state --watch   loop (refresh every MESH_OP_STATE_INTERVAL seconds, default 60)
#   mesh-operator-state --json    machine-readable
#   mesh-operator-state --test    smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PRESENCE_LOG="$HOME/.mesh/presence.log"
INTERVAL="${MESH_OP_STATE_INTERVAL:-60}"
# Personal device proximity: MESH_OP_BLE_DEVICES (colon-sep name substrings); same default as mesh-operator-home.
# Bose excluded: stationary desk speaker broadcasts BLE 24/7 in standby — not a proximity signal.
OP_BLE_DEVICES="${MESH_OP_BLE_DEVICES:-Quest}"
OP_BLE_RSSI="${MESH_OP_BLE_RSSI:--82}"        # dBm threshold for "device is close (in room)"
LUX_DARK="${MESH_OP_LUX_DARK:-5}"             # lux below which it's dark at the phone
STEP_MOVING="${MESH_OP_STEP_MOVING:-3}"       # Δsteps that counts as "walking"
ACCEL_ACTIVE="${MESH_OP_ACCEL_ACTIVE:-0.25}"  # linaccel g above which phone is in hand/moving
USB_STATE="${MESH_USB_EVENTS_STATE:-$HOME/.mesh/.usb-events-state}"
USB_ACTIVE_TTL=300
MEDIA_STATE="${MESH_MEDIA_STATE:-$HOME/.mesh/.media-scene.state}"
MEDIA_MAX_AGE=900
LOADAVG_STATE="${MESH_OPERATOR_LOADAVG_STATE:-$HOME/.mesh/.loadavg-state}"
LOADAVG_MAX_AGE="${MESH_OPERATOR_LOADAVG_MAX_AGE:-900}"
DISKIO_STATE="${MESH_OPERATOR_DISKIO_STATE:-$HOME/.mesh/.diskio-state}"
DISKIO_MAX_AGE="${MESH_OPERATOR_DISKIO_MAX_AGE:-900}"

# derive_cross_sense <state> <body> <focus> <audio_mode> <call_verified> <phone_lan> <ambient> <media_scene> <loadavg> <diskio>
# This is a relation across independent axes, not a selector: each positive label requires a
# joint pattern that no single input can provide. Missing/unreachable axes stay visible.
derive_cross_sense() {
  local state="$1" body="$2" focus="$3" audio="$4" call="$5" lan="$6" ambient="$7" media_scene="${8:-UNKNOWN}" loadavg="${9:-UNKNOWN}" diskio="${10:-UNKNOWN}"
  # OVERLOADED alone is a machine condition and AT-DESK alone is an attention condition.
  # The joint label exists only when both real axes are present; missing/stale load stays UNKNOWN.
  if [ "$state" = "AT-DESK" ] && [ "$loadavg" = "OVERLOADED" ]; then
    printf 'DESK-UNDER-LOAD'; return
  fi
  if [ "$state" = "AT-DESK" ] && [ "$diskio" = "PRESSURED" ]; then
    printf 'DESK-UNDER-IO'; return
  fi
  if [ "$body" = "UNKNOWN" ] || [ "$focus" = "UNREACHABLE" ] || [ "$call" = "UNKNOWN" ]; then
    printf 'UNREACHABLE'; return
  fi
  if { [ "$body" = "HANDLED" ] || [ "$body" = "CARRIED" ]; } && [ "$audio" = "CALL" ]; then
    printf 'MOBILE-CALL'; return
  fi
  if [ "$call" = "CONFIRMED" ] && [ "$state" = "AT-DESK" ]; then
    printf 'DESK-CALL'; return
  fi
  if [ "$state" = "AT-DESK" ] && [ "$focus" = "RECORDING" ] && [ "$audio" != "UNKNOWN" ] && [ "$audio" != "UNAVAILABLE" ]; then
    printf 'DESK-RECORDING'; return
  fi
  if [ "$state" = "AT-PHONE" ] && [ "$focus" = "PRIVATE-LISTENING" ]; then
    printf 'PHONE-FOCUSED'; return
  fi
  if [ "$state" = "AT-DESK" ]; then
    case "$media_scene" in
      TV-LIKELY)           printf 'DESK-WITH-TV'; return ;;
      LIVE-SOUND)          printf 'DESK-WITH-LIVE-SOUND'; return ;;
      SOUND-UNATTRIBUTED)  printf 'DESK-SOUND-UNATTRIBUTED'; return ;;
    esac
  fi
  if [ "$state" = "UNKNOWN" ] && { [ "$ambient" = "LOUD" ] || [ "$ambient" = "MODERATE" ]; } && [ "$lan" = "UNKNOWN" ]; then
    printf 'AMBIENT-UNATTRIBUTED'; return
  fi
  printf 'NO-JOINT-EVENT'
}

# read_diskio_state <state-file> <max-age-s> → one validated disk pressure label or UNKNOWN.
# The producer is mesh-diskio's real /proc/diskstats artifact; stale, absent, malformed, or
# missing utilization stays UNKNOWN so the fusion cannot turn a dead producer into calm.
read_diskio_state() {
  local file="$1" max_age="$2" age line state util
  [ -s "$file" ] || { printf 'UNKNOWN'; return; }
  age=$(( $(date +%s) - $(stat -c %Y "$file" 2>/dev/null || echo 0) ))
  [ "$age" -le "$max_age" ] 2>/dev/null || { printf 'UNKNOWN'; return; }
  line="$(head -n1 "$file" 2>/dev/null)"
  state="${line%%|*}"
  util="$(printf '%s' "$line" | sed -n 's/.*|util_pct=\([0-9][0-9]*\)\(|.*\|$\)/\1/p')"
  case "$state:$util" in
    IDLE:[0-9]*|ACTIVE:[0-9]*) printf '%s' "$state";;
    PRESSURED:[0-9]*) printf 'PRESSURED';;
    *) printf 'UNKNOWN';;
  esac
}

# read_loadavg_state <state-file> <max-age-s> → one validated label or UNKNOWN.
read_loadavg_state() {
  local file="$1" max_age="$2" age label
  [ -s "$file" ] || { printf 'UNKNOWN'; return; }
  age=$(( $(date +%s) - $(stat -c %Y "$file" 2>/dev/null || echo 0) ))
  [ "$age" -le "$max_age" ] 2>/dev/null || { printf 'UNKNOWN'; return; }
  label="$(head -n1 "$file" 2>/dev/null | cut -d'|' -f1 | tr -d '[:space:]')"
  case "$label" in
    OVERLOADED|SPIKE|RISING|FALLING|LIGHT|STABLE) printf '%s' "$label";;
    *) printf 'UNKNOWN';;
  esac
}

# derive_scene_context <light_level> <ambient_level> <media_scene> — a compact room relation that
# no one sensor can name. A dark light read plus live ambient sound distinguishes a lit/quiet room
# from a dark/noisy one; an unreachable light organ remains UNKNOWN rather than becoming DARK.
derive_scene_context() {
  local light="${1:-UNREACHABLE}" ambient="${2:-UNAVAILABLE}" media="${3:-UNKNOWN}"
  case "$light" in UNREACHABLE|UNAVAILABLE|UNKNOWN) printf 'UNKNOWN'; return ;; esac
  case "$ambient" in UNAVAILABLE|UNKNOWN) printf 'UNKNOWN'; return ;; esac
  case "$light:$ambient" in
    DARK:SILENCE|DARK:QUIET) printf 'DARK-QUIET';;
    DARK:MODERATE|DARK:LOUD) printf 'DARK-ACTIVE';;
    DIM:SILENCE|DIM:QUIET) printf 'DIM-QUIET';;
    DIM:MODERATE|DIM:LOUD) printf 'DIM-ACTIVE';;
    *) printf 'LIT-ACTIVE';;
  esac
}

# derive_mobile_link <body_state> <wifi_quality> — relation across phone motion + phone radio.
derive_mobile_link() {
  local body="${1:-UNKNOWN}" wifi="${2:-UNREACHABLE}"
  case "$body:$wifi" in
    *:UNREACHABLE|UNREACHABLE:*) printf 'UNREACHABLE'; return ;;
    *:UNKNOWN|*:UNAVAILABLE|UNKNOWN:*) printf 'UNKNOWN'; return ;;
  esac
  case "$body:$wifi" in
    HANDLED:EXCELLENT|HANDLED:GOOD|CARRIED:EXCELLENT|CARRIED:GOOD) printf 'MOBILE-ONLINE' ;;
    HANDLED:FAIR|HANDLED:POOR|CARRIED:FAIR|CARRIED:POOR) printf 'MOBILE-DEGRADED' ;;
    HANDLED:DISCONNECTED|CARRIED:DISCONNECTED) printf 'MOBILE-OFFLINE' ;;
    STILL:DISCONNECTED|COVERED:DISCONNECTED) printf 'PARKED-OFFLINE' ;;
    *) printf 'NO-MOBILE-JOINT' ;;
  esac
}

read_light_context() {
  light_level='UNREACHABLE'; light_source='UNKNOWN'
  local payload rc
  if [ -n "${MESH_OPERATOR_LIGHT_JSON:-}" ]; then
    payload="$MESH_OPERATOR_LIGHT_JSON"
  elif command -v mesh-light >/dev/null 2>&1; then
    payload="$(timeout 12 mesh-light --json 2>/dev/null)"; rc=$?
    [ "$rc" = 2 ] && return 0
  else
    light_level='UNAVAILABLE'; return 0
  fi
  [ -n "$payload" ] || return 0
  light_level="$(printf '%s' "$payload" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("level","UNKNOWN"))' 2>/dev/null)"
  light_source="$(printf '%s' "$payload" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("source","UNKNOWN"))' 2>/dev/null)"
  case "$light_level" in DARK|DIM|MODERATE|LIT|BRIGHT) ;; *) light_level='UNKNOWN' ;; esac
  [ -n "$light_source" ] || light_source='UNKNOWN'
}

read_wifi_context() {
  wifi_quality='UNREACHABLE'; wifi_reason='not read'
  local payload rc
  if ! command -v mesh-wifi-link >/dev/null 2>&1; then
    wifi_quality='UNAVAILABLE'; wifi_reason='mesh-wifi-link absent'; return 0
  fi
  payload="$(timeout 18 mesh-wifi-link --json 2>/dev/null)"; rc=$?
  if [ "$rc" -ge 2 ]; then
    wifi_quality='UNREACHABLE'; wifi_reason='Wi-Fi organ unreachable'; return 0
  fi
  [ -n "$payload" ] || { wifi_quality='UNKNOWN'; wifi_reason='Wi-Fi read empty'; return 0; }
  wifi_quality="$(printf '%s' "$payload" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("quality","UNKNOWN"))' 2>/dev/null)"
  [ -n "$wifi_quality" ] || wifi_quality='UNKNOWN'
  case "$wifi_quality" in
    EXCELLENT|GOOD|FAIR|POOR|DISCONNECTED) wifi_reason="$(printf '%s' "$payload" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("reason",""))' 2>/dev/null)" ;;
    *) wifi_quality='UNKNOWN'; wifi_reason='malformed Wi-Fi quality read' ;;
  esac
}

[ "${1:-}" = --test ] && {
  command -v mesh-body-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-body-motion)"; exit 1; }
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/home/.mesh" "$_td/bin"

  # MEDIA_CONTEXT relation: operator at desk + a fresh media-scene attribution is a joint event;
  # neither operator presence nor room sound alone can name it.
  [ "$(derive_cross_sense AT-DESK STILL OPEN IDLE N/A HOME LOUD TV-LIKELY)" = "DESK-WITH-TV" ] || {
    echo "smoke-test: FAIL (AT-DESK + TV-LIKELY must yield DESK-WITH-TV)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AT-DESK STILL OPEN IDLE N/A HOME LOUD UNKNOWN OVERLOADED)" = "DESK-UNDER-LOAD" ] || {
    echo "smoke-test: FAIL (AT-DESK + OVERLOADED loadavg must yield DESK-UNDER-LOAD)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AT-DESK STILL OPEN IDLE N/A HOME LOUD UNKNOWN LIGHT PRESSURED)" = "DESK-UNDER-IO" ] || {
    echo "smoke-test: FAIL (AT-DESK + PRESSURED diskio must yield desk-io relation)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AT-DESK STILL OPEN IDLE N/A HOME LOUD UNKNOWN LIGHT UNKNOWN)" = "NO-JOINT-EVENT" ] || {
    echo "smoke-test: FAIL (unknown diskio must not mint desk-io relation)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AT-DESK STILL OPEN IDLE N/A HOME LOUD UNKNOWN LIGHT)" = "NO-JOINT-EVENT" ] || {
    echo "smoke-test: FAIL (non-overloaded loadavg must not mint desk-load relation)"; rm -rf "$_td"; exit 1;
  }
  _la_fixture="$_td/loadavg.state"
  printf 'OVERLOADED|l1=40|nproc=16\n' > "$_la_fixture"
  [ "$(read_loadavg_state "$_la_fixture" 900)" = "OVERLOADED" ] || {
    echo "smoke-test: FAIL (fresh loadavg artifact was not consumed)"; rm -rf "$_td"; exit 1;
  }
  touch -d '20 minutes ago' "$_la_fixture"
  [ "$(read_loadavg_state "$_la_fixture" 900)" = "UNKNOWN" ] || {
    echo "smoke-test: FAIL (stale loadavg artifact must remain UNKNOWN)"; rm -rf "$_td"; exit 1;
  }
  printf 'PRESSURED|read_kb_s=1|write_kb_s=2|iops=3|util_pct=77|disk=fixture|ts=fixture\n' > "$_td/diskio.state"
  [ "$(read_diskio_state "$_td/diskio.state" 900)" = "PRESSURED" ] || {
    echo "smoke-test: FAIL (fresh diskio artifact was not consumed)"; rm -rf "$_td"; exit 1;
  }
  touch -d '2 hours ago' "$_td/diskio.state"
  [ "$(read_diskio_state "$_td/diskio.state" 900)" = "UNKNOWN" ] || {
    echo "smoke-test: FAIL (stale diskio artifact must remain UNKNOWN)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AT-DESK STILL OPEN IDLE N/A HOME LOUD UNKNOWN)" = "NO-JOINT-EVENT" ] || {
    echo "smoke-test: FAIL (missing media scene must not yield a fabricated media joint)"; rm -rf "$_td"; exit 1;
  }

  # Negative control: without mesh-body-motion the smoke test must fail fast.
  env -i PATH=/tmp/empty HOME="$_td/home" /bin/bash "$0" --test >/dev/null 2>&1 && {
    echo "smoke-test: FAIL (missing mesh-body-motion should fail)"; rm -rf "$_td"; exit 1;
  }

  cat > "$_td/bin/mesh-body-motion" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --json) echo '{"dummy":true}'; exit 0 ;;
esac
printf '%s\n' "2026-06-19T20:00:00Z  HANDLED body-motion stub lux=7 Δ+1 linaccel=0.31"
EOF
  chmod +x "$_td/bin/mesh-body-motion" || { echo "smoke-test: FAIL (stub chmod failed)"; rm -rf "$_td"; exit 1; }

  cat > "$_td/bin/mesh-ambient-level" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --json) echo '{"label":"SILENCE","rms_db":-99,"peak_db":-99}'; exit 0 ;;
esac
echo "ambient-level: SILENCE (rms=-99dB peak=-99dB)"
EOF
  chmod +x "$_td/bin/mesh-ambient-level" || { echo "smoke-test: FAIL (ambient stub chmod failed)"; rm -rf "$_td"; exit 1; }

  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --json) echo '{"status":"HOME","reason":"stub","phone_lan":1,"ble_home":0,"ts_online":0}'; exit 0 ;;
esac
echo "HOME — stub"
EOF
  chmod +x "$_td/bin/mesh-operator-home" || { echo "smoke-test: FAIL (home stub chmod failed)"; rm -rf "$_td"; exit 1; }

  cat > "$_td/bin/mesh-jack" <<'EOF'
#!/usr/bin/env bash
echo "[jack] HEADPHONES — headphone plugged — private/focused listening [headphone=on ext-mic=off card=0] @ stub"
exit 0
EOF
  chmod +x "$_td/bin/mesh-jack" || { echo "smoke-test: FAIL (jack stub chmod failed)"; rm -rf "$_td"; exit 1; }

  out="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" 2>/dev/null)" || {
    echo "smoke-test: FAIL (tool failed to run with stubs)"; rm -rf "$_td"; exit 1;
  }
  valid_re='operator: (AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN)'
  printf '%s' "$out" | grep -qE "$valid_re" || {
    echo "smoke-test: FAIL (unexpected output: '${out:0:120}')"; rm -rf "$_td"; exit 1;
  }
  label="$(printf '%s' "$out" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN' | head -1)"
  json="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (json run failed with stubs)"; rm -rf "$_td"; exit 1;
  }
  printf '%s' "$json" | python3 -c 'import sys,json; d=json.load(sys.stdin); assert "degraded" in d, "missing degraded field"; assert "ambient_level" in d, "missing ambient_level field"; assert "phone_lan" in d, "missing phone_lan field"; assert "focus" in d, "missing focus field"; assert "jack" in d, "missing jack field"; assert "usb_events" in d, "missing usb_events field"' 2>/dev/null \
    || { echo "smoke-test: FAIL (JSON missing new fields: degraded/ambient_level/phone_lan/focus/jack/usb_events)"; rm -rf "$_td"; exit 1; }
  deg="$(printf '%s' "$json" | python3 -c 'import sys,json; print(type(json.load(sys.stdin)["degraded"]).__name__)' 2>/dev/null)"
  [ "$deg" = "bool" ] || { echo "smoke-test: FAIL (degraded field is not bool: $deg)"; rm -rf "$_td"; exit 1; }
  # FOCUS fusion: jack=HEADPHONES stub must fuse to focus=PRIVATE-LISTENING (real cross-sense derive)
  focusval="$(printf '%s' "$json" | python3 -c 'import sys,json; print(json.load(sys.stdin)["focus"])' 2>/dev/null)"
  [ "$focusval" = "PRIVATE-LISTENING" ] || { echo "smoke-test: FAIL (jack=HEADPHONES must fuse focus=PRIVATE-LISTENING, got '$focusval')"; rm -rf "$_td"; exit 1; }
  modeval="$(printf '%s' "$json" | python3 -c 'import sys,json; print(json.load(sys.stdin)["attention_mode"])' 2>/dev/null)"
  [ "$modeval" = "PHONE_FOCUSED" ] || { echo "smoke-test: FAIL (jack=HEADPHONES must fuse attention_mode=PHONE_FOCUSED, got '$modeval')"; rm -rf "$_td"; exit 1; }

  # ---- Regression: appliance-vs-person honest-fusion. body=UNKNOWN (phone SSH dead) + mic=LOUD +
  # phone_lan=UNKNOWN (LAN ping inconclusive) must NOT yield AT-DESK — a LOUD mic alone cannot
  # attribute ambient sound to the operator (could be the TV), so asserting "operator present" would
  # be a false all-clear on an unreachable-dominated read. Honest verdict = UNKNOWN. ----
  cat > "$_td/bin/mesh-body-motion" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{}'; exit 0 ;; esac
# empty output → body_state=UNKNOWN (phone SSH unreachable)
EOF
  cat > "$_td/bin/mesh-ambient-level" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"label":"LOUD","rms_db":-20,"peak_db":-5}'; exit 0 ;; esac
echo "ambient-level: LOUD (rms=-20dB peak=-5dB)"
EOF
  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"status":"UNKNOWN","reason":"stub LAN inconclusive"}'; exit 0 ;; esac
echo "UNKNOWN — stub"
EOF
  chmod +x "$_td/bin/mesh-body-motion" "$_td/bin/mesh-ambient-level" "$_td/bin/mesh-operator-home"
  rout="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" 2>/dev/null)"
  rlabel="$(printf '%s' "$rout" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN' | head -1)"
  [ "$rlabel" = "UNKNOWN" ] || { echo "smoke-test: FAIL (regression: body=UNKNOWN + mic=LOUD + phone_lan=UNKNOWN gave '$rlabel', want UNKNOWN — false-positive AT-DESK from unreachable inputs)"; rm -rf "$_td"; exit 1; }

  # ---- Coverage enrichment: close personal BLE should lift the degraded path to NEARBY instead
  # of collapsing into HOME-IDLE/UNKNOWN. This is a richer derived state than any single input gives.
  cat > "$_td/bin/mesh-ambient-level" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"label":"QUIET","rms_db":-48,"peak_db":-30}'; exit 0 ;; esac
echo "ambient-level: QUIET (rms=-48dB peak=-30dB)"
EOF
  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"status":"HOME","reason":"stub LAN confirmed"}'; exit 0 ;; esac
echo "HOME — stub"
EOF
  chmod +x "$_td/bin/mesh-ambient-level" "$_td/bin/mesh-operator-home"
  cat > "$_td/home/.mesh/presence.log" <<'EOF'
2026-07-01T00:00:00Z stub n=1 devices=[-62|72:E4:B3:50:C7:1F|Quest 3] attribution=personal:1,appliance:0,ambiguous:0 unidentified=public:0,random:1,unknown:0
EOF
  nout="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" 2>/dev/null)"
  nlabel="$(printf '%s' "$nout" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN' | head -1)"
  [ "$nlabel" = "NEARBY" ] || { echo "smoke-test: FAIL (degraded close BLE should give NEARBY, got '$nlabel')"; rm -rf "$_td"; exit 1; }

  # ---- Regression: jack UNREACHABLE (exit 2 — no codec / headless VM) must render focus=UNREACHABLE,
  # NOT OPEN. Collapsing an unreadable jack to OPEN ("nothing plugged") would be a silent all-clear on
  # an input that could not be read at all — the empty-≠-failed contract this fusion exists to honor. ----
  cat > "$_td/bin/mesh-jack" <<'EOF'
#!/usr/bin/env bash
echo "[jack] UNREACHABLE — no analog jack-detect controls on card 0 @ stub" >&2
exit 2
EOF
  chmod +x "$_td/bin/mesh-jack"
  ujson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  ufocus="$(printf '%s' "$ujson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["focus"])' 2>/dev/null)"
  [ "$ufocus" = "UNREACHABLE" ] || { echo "smoke-test: FAIL (jack exit-2 must give focus=UNREACHABLE not '$ufocus' — empty≠failed all-clear)"; rm -rf "$_td"; exit 1; }
  umode="$(printf '%s' "$ujson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["attention_mode"])' 2>/dev/null)"
  printf '%s' "$umode" | grep -q '^DEGRADED:.*UNREACHABLE$' || { echo "smoke-test: FAIL (jack exit-2 must give degraded attention_mode, got '$umode')"; rm -rf "$_td"; exit 1; }
  # And an ABSENT jack tool must be UNAVAILABLE (a third, distinct non-reading) — not UNREACHABLE/OPEN.
  rm -f "$_td/bin/mesh-jack"
  ajson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  afocus="$(printf '%s' "$ajson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["focus"])' 2>/dev/null)"
  [ "$afocus" = "UNAVAILABLE" ] || { echo "smoke-test: FAIL (absent jack tool must give focus=UNAVAILABLE not '$afocus')"; rm -rf "$_td"; exit 1; }
  amode="$(printf '%s' "$ajson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["attention_mode"])' 2>/dev/null)"
  [ "$amode" = "UNAVAILABLE" ] || { echo "smoke-test: FAIL (absent jack tool must give attention_mode=UNAVAILABLE not '$amode')"; rm -rf "$_td"; exit 1; }

  # ---- usb-events tests (degraded close BLE/AT-DESK lift from USB) ----
  # 1. BLIND usb-events state → usb_status=BLIND, focus/state unaffected (except signals)
  printf 'BLIND bus-unreadable\n' > "$_td/home/.mesh/.usb-events-state"
  ujson_blind="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  ublind="$(printf '%s' "$ujson_blind" | python3 -c 'import sys,json; print(json.load(sys.stdin)["usb_events"])' 2>/dev/null)"
  [ "$ublind" = "BLIND" ] || { echo "smoke-test: FAIL (BLIND usb-events state must yield usb_events=BLIND, got '$ublind')"; rm -rf "$_td"; exit 1; }

  # 2. ACTIVE usb-events state (ATTACH in last 300s) → lifts degraded path to AT-DESK
  # First, set phone_lan=AWAY (which would normally result in AWAY)
  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"status":"AWAY","reason":"stub LAN away"}'; exit 0 ;; esac
echo "AWAY — stub"
EOF
  chmod +x "$_td/bin/mesh-operator-home"
  printf 'ATTACH 1/0 2\n' > "$_td/home/.mesh/.usb-events-state"
  # Set mtime to now
  touch "$_td/home/.mesh/.usb-events-state"
  ujson_active="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  ustate="$(printf '%s' "$ujson_active" | python3 -c 'import sys,json; print(json.load(sys.stdin)["state"])' 2>/dev/null)"
  [ "$ustate" = "AT-DESK" ] || { echo "smoke-test: FAIL (ACTIVE usb-events state must lift to AT-DESK on degraded path, got '$ustate')"; rm -rf "$_td"; exit 1; }
  u_usb_status="$(printf '%s' "$ujson_active" | python3 -c 'import sys,json; print(json.load(sys.stdin)["usb_events"])' 2>/dev/null)"
  [ "$u_usb_status" = "ACTIVE" ] || { echo "smoke-test: FAIL (ACTIVE usb-events state must report usb_events=ACTIVE, got '$u_usb_status')"; rm -rf "$_td"; exit 1; }

  # 3. UNAVAILABLE usb-events state (absent file) → fallback to UNAVAILABLE
  rm -f "$_td/home/.mesh/.usb-events-state"
  ujson_unavail="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  uunavail="$(printf '%s' "$ujson_unavail" | python3 -c 'import sys,json; print(json.load(sys.stdin)["usb_events"])' 2>/dev/null)"
  [ "$uunavail" = "UNAVAILABLE" ] || { echo "smoke-test: FAIL (absent usb-events state file must yield usb_events=UNAVAILABLE, got '$uunavail')"; rm -rf "$_td"; exit 1; }

  # ---- call_verified tests (CROSS-SENSE FUSION: focus × mesh-audio-mode) ----
  cat > "$_td/bin/mesh-jack" <<'EOF'
#!/usr/bin/env bash
echo "[jack] HEADSET — headset plugged — call rig [headphone=on ext-mic=on card=0] @ stub"
exit 0
EOF
  chmod +x "$_td/bin/mesh-jack"

  # 1. jack=HEADSET + audio-mode=CALL → CONFIRMED (headset AND a live call both independently seen)
  cat > "$_td/bin/mesh-audio-mode" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"ts":"stub","host":"stub","verdict":"CALL","mic":"FOREIGN","playing":"PLAYING","mic_ok":1,"play_ok":1}'; exit 0 ;; esac
echo "[audio-mode] CALL — stub"
EOF
  chmod +x "$_td/bin/mesh-audio-mode"
  cvjson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  cv="$(printf '%s' "$cvjson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["call_verified"])' 2>/dev/null)"
  [ "$cv" = "CONFIRMED" ] || { echo "smoke-test: FAIL (focus=CALL-RIG + audio-mode=CALL must give call_verified=CONFIRMED, got '$cv')"; rm -rf "$_td"; exit 1; }
  am="$(printf '%s' "$cvjson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["audio_mode"])' 2>/dev/null)"
  [ "$am" = "CALL" ] || { echo "smoke-test: FAIL (audio_mode field must passthrough CALL, got '$am')"; rm -rf "$_td"; exit 1; }

  # 2. jack=HEADSET + audio-mode=IDLE → UNCONFIRMED ("headset left on" — no live call detected)
  cat > "$_td/bin/mesh-audio-mode" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"ts":"stub","host":"stub","verdict":"IDLE","mic":"FREE","playing":"SILENT","mic_ok":1,"play_ok":1}'; exit 0 ;; esac
echo "[audio-mode] IDLE — stub"
EOF
  chmod +x "$_td/bin/mesh-audio-mode"
  ucjson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  ucv="$(printf '%s' "$ucjson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["call_verified"])' 2>/dev/null)"
  [ "$ucv" = "UNCONFIRMED" ] || { echo "smoke-test: FAIL (focus=CALL-RIG + audio-mode=IDLE must give call_verified=UNCONFIRMED, got '$ucv')"; rm -rf "$_td"; exit 1; }

  # 3. jack=HEADSET + mesh-audio-mode BOTH axes dark (exit 2) → UNKNOWN (cannot corroborate, honest gap)
  cat > "$_td/bin/mesh-audio-mode" <<'EOF'
#!/usr/bin/env bash
echo "[audio-mode] UNKNOWN — stub both axes dark" >&2
exit 2
EOF
  chmod +x "$_td/bin/mesh-audio-mode"
  dkjson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  dkv="$(printf '%s' "$dkjson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["call_verified"])' 2>/dev/null)"
  [ "$dkv" = "UNKNOWN" ] || { echo "smoke-test: FAIL (focus=CALL-RIG + audio-mode exit-2 must give call_verified=UNKNOWN, got '$dkv')"; rm -rf "$_td"; exit 1; }

  # 4. jack=HEADSET + mesh-audio-mode tool ABSENT → UNKNOWN, never a silent all-clear
  rm -f "$_td/bin/mesh-audio-mode"
  abjson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  abv="$(printf '%s' "$abjson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["call_verified"])' 2>/dev/null)"
  [ "$abv" = "UNKNOWN" ] || { echo "smoke-test: FAIL (absent mesh-audio-mode tool must give call_verified=UNKNOWN, got '$abv')"; rm -rf "$_td"; exit 1; }

  # 5. Regression: focus != CALL-RIG (jack=OPEN) → call_verified=N/A regardless of audio-mode —
  # nothing was claimed, so nothing should be reported as verified/unconfirmed.
  cat > "$_td/bin/mesh-jack" <<'EOF'
#!/usr/bin/env bash
echo "[jack] OPEN — nothing plugged [headphone=off ext-mic=off card=0] @ stub"
exit 0
EOF
  chmod +x "$_td/bin/mesh-jack"
  cat > "$_td/bin/mesh-audio-mode" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"ts":"stub","host":"stub","verdict":"CALL","mic":"FOREIGN","playing":"PLAYING","mic_ok":1,"play_ok":1}'; exit 0 ;; esac
echo "[audio-mode] CALL — stub"
EOF
  chmod +x "$_td/bin/mesh-audio-mode"
  najson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  nav="$(printf '%s' "$najson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["call_verified"])' 2>/dev/null)"
  [ "$nav" = "N/A" ] || { echo "smoke-test: FAIL (focus=OPEN must give call_verified=N/A even with audio-mode=CALL live, got '$nav')"; rm -rf "$_td"; exit 1; }

  # ---- cross-sense relation tests: no single axis can produce these labels ----
  [ "$(derive_cross_sense AT-PHONE HANDLED PRIVATE-LISTENING CALL N/A HOME QUIET)" = "MOBILE-CALL" ] || {
    echo "smoke-test: FAIL (body HANDLED + audio CALL must produce MOBILE-CALL)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AT-DESK STILL CALL-RIG CALL CONFIRMED HOME MODERATE)" = "DESK-CALL" ] || {
    echo "smoke-test: FAIL (AT-DESK + confirmed call must produce DESK-CALL)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense UNKNOWN UNKNOWN UNREACHABLE UNKNOWN UNKNOWN UNKNOWN MODERATE)" = "UNREACHABLE" ] || {
    echo "smoke-test: FAIL (unreachable inputs must remain visibly UNREACHABLE)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_scene_context DARK SILENCE QUIET)" = "DARK-QUIET" ] || {
    echo "smoke-test: FAIL (dark + quiet must produce DARK-QUIET)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_scene_context DARK MODERATE SOUND-UNATTRIBUTED)" = "DARK-ACTIVE" ] || {
    echo "smoke-test: FAIL (dark + ambient sound must produce DARK-ACTIVE)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_scene_context UNREACHABLE SILENCE QUIET)" = "UNKNOWN" ] || {
    echo "smoke-test: FAIL (unreachable light must remain UNKNOWN, not dark/quiet)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_mobile_link HANDLED GOOD)" = "MOBILE-ONLINE" ] || {
    echo "smoke-test: FAIL (handled phone + good Wi-Fi must yield MOBILE-ONLINE)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_mobile_link HANDLED DISCONNECTED)" = "MOBILE-OFFLINE" ] || {
    echo "smoke-test: FAIL (handled phone + real disconnected Wi-Fi must yield MOBILE-OFFLINE)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_mobile_link HANDLED UNREACHABLE)" = "UNREACHABLE" ] || {
    echo "smoke-test: FAIL (unreachable Wi-Fi must remain visibly UNREACHABLE)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_mobile_link HANDLED UNREACHABLE)" != "$(derive_mobile_link HANDLED DISCONNECTED)" ] || {
    echo "smoke-test: FAIL (unreachable Wi-Fi collapsed into genuine empty)"; rm -rf "$_td"; exit 1;
  }
  [ "$(derive_cross_sense AWAY STILL OPEN IDLE N/A AWAY SILENCE)" = "NO-JOINT-EVENT" ] || {
    echo "smoke-test: FAIL (genuine empty relation must differ from UNREACHABLE)"; rm -rf "$_td"; exit 1;
  }

  echo "smoke-test: ok ($label; JSON fields ok; degraded=$deg; attention-mode PHONE_FOCUSED + UNREACHABLE≠OPEN≠UNAVAILABLE regressions; +appliance-vs-person: UNKNOWN not AT-DESK; +degraded close BLE NEARBY; +usb-events BLIND/ACTIVE/UNAVAILABLE; +call_verified CONFIRMED/UNCONFIRMED/UNKNOWN(dark)/UNKNOWN(absent)/N-A; +cross-sense MOBILE-CALL/DESK-CALL/UNREACHABLE≠NO-JOINT-EVENT)"
  rm -rf "$_td"
  exit 0
}

derive_attention_mode() {
  local state="$1" focus="$2"
  case "$focus" in
    UNREACHABLE) printf 'DEGRADED:%s+UNREACHABLE' "$state"; return ;;
    UNAVAILABLE)  printf 'UNAVAILABLE'; return ;;
  esac
  case "$state:$focus" in
    AT-DESK:PRIVATE-LISTENING|AT-DESK:RECORDING) printf 'FOCUSED_DESK';;
    AT-DESK:OPEN)        printf 'OPEN_DESK';;
    AT-DESK:CALL-RIG)    printf 'CALL_DESK';;
    NEARBY:PRIVATE-LISTENING|NEARBY:RECORDING) printf 'NEARBY_FOCUSED';;
    NEARBY:OPEN)         printf 'NEARBY_OPEN';;
    NEARBY:CALL-RIG)      printf 'NEARBY_CALL';;
    HOME-IDLE:PRIVATE-LISTENING|HOME-IDLE:RECORDING) printf 'HOME_IDLE_FOCUSED';;
    HOME-IDLE:OPEN)      printf 'HOME_IDLE_OPEN';;
    AT-PHONE:PRIVATE-LISTENING|AT-PHONE:RECORDING) printf 'PHONE_FOCUSED';;
    AT-PHONE:OPEN)       printf 'PHONE_OPEN';;
    AWAY:OPEN)           printf 'AWAY_OPEN';;
    ASLEEP:PRIVATE-LISTENING|ASLEEP:RECORDING) printf 'ASLEEP_FOCUSED';;
    ASLEEP:OPEN)         printf 'ASLEEP_OPEN';;
    *)                   printf '%s_%s' "$state" "$focus";;
  esac
}

_sample() {
  TS="$(date -u +%H:%M:%SZ)"
  HOUR="$(date +%H)"

  # ---- body-motion (one SSH read: accel + orient + steps + lux) ----
  body_line="$(mesh-body-motion 2>/dev/null)" || body_line=""
  body_state="UNKNOWN"; lux="-"; steps_d="-"; linaccel="-"
  if [ -n "$body_line" ]; then
    case "$body_line" in
      *STILL*)   body_state="STILL";;
      *CARRIED*) body_state="CARRIED";;
      *HANDLED*) body_state="HANDLED";;
      *COVERED*) body_state="COVERED";;
    esac
    lux="$(printf '%s' "$body_line" | grep -oE 'lux=[0-9]+' | grep -oE '[0-9]+')"
    steps_d="$(printf '%s' "$body_line" | grep -oE 'Δ[+-][0-9]+' | tr -d 'Δ+')"
    linaccel="$(printf '%s' "$body_line" | grep -oE 'linaccel=[0-9]+\.[0-9]+' | grep -oE '[0-9]+\.[0-9]+')"
  fi
  # ---- body-motion × Wi-Fi link relation ----
  # mesh-wifi-link returns DISCONNECTED for a real empty radio association and rc=2 when its
  # phone transport is unreachable. Preserve that distinction in the fused artifact.
  read_wifi_context

  # ---- personal BLE device proximity from presence.log (cheap, no BLE scan) ----
  # Uses MESH_OP_BLE_DEVICES (colon-sep substrings, default: Quest).
  # Bose excluded: desk speaker broadcasts 24/7 in standby → never a valid proximity signal.
  op_dev_rssi="-999"; op_dev_tag="none"; op_dev_name=""
  if [ -s "$PRESENCE_LOG" ]; then
    IFS=':' read -ra _DEVS <<< "$OP_BLE_DEVICES"
    _pats="$(printf '%s\n' "${_DEVS[@]}" | tr '[:upper:]' '[:lower:]' | tr '\n' '|' | sed 's/|$//')"
    _result="$(tail -n 2 "$PRESENCE_LOG" | python3 -c "
import sys, re
pats = '${_pats}'.split('|')
best_rssi = None; best_name = ''
for line in sys.stdin:
    m = re.search(r'devices=\[(.+)\]', line)
    if not m: continue
    inner = m.group(1)
    entries = list(re.finditer(r'(-\d+)\|[0-9A-Fa-f:]{17}\|', inner))
    for i, e in enumerate(entries):
        rssi = int(e.group(1))
        nstart = e.end()
        nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
        name = inner[nstart:nend].rstrip('] ')
        if any(p in name.lower() for p in pats):
            if best_rssi is None or rssi > best_rssi:
                best_rssi = rssi; best_name = name
if best_rssi is not None: print(f'{best_rssi}|{best_name}')
" 2>/dev/null)"
    if [ -n "$_result" ]; then
      op_dev_rssi="${_result%%|*}"
      op_dev_name="${_result#*|}"
      op_dev_tag="${op_dev_rssi}dBm"
    fi
  fi

  # ---- IdeaPad-local fallback signals (always available, used when phone SSH fails) ----
  # These are read regardless so they enrich the JSON even on the full path.
  # ambient_level: LOUD/MODERATE/QUIET/SILENCE (mic heard something) vs UNAVAILABLE (no mic tool)
  # phone_lan: HOME/AWAY/UNKNOWN (LAN ping — faster than SSH, can succeed when SSH is dead)
  ambient_level="UNAVAILABLE"
  phone_lan="UNKNOWN"
  if command -v mesh-ambient-level >/dev/null 2>&1; then
    _al_out="$(timeout 5 mesh-ambient-level 2>/dev/null)" || true
    if printf '%s' "${_al_out:-}" | grep -q 'LOUD';     then ambient_level="LOUD"
    elif printf '%s' "${_al_out:-}" | grep -q 'MODERATE'; then ambient_level="MODERATE"
    elif printf '%s' "${_al_out:-}" | grep -q 'QUIET';    then ambient_level="QUIET"
    elif printf '%s' "${_al_out:-}" | grep -q 'SILENCE';  then ambient_level="SILENCE"
    fi
  fi
  if command -v mesh-operator-home >/dev/null 2>&1; then
    _oh_json="$(timeout 8 mesh-operator-home --json 2>/dev/null)" || true
    _oh_status="$(printf '%s' "${_oh_json:-}" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("status",""))' 2>/dev/null)" || true
    case "${_oh_status:-}" in HOME) phone_lan="HOME";; AWAY) phone_lan="AWAY";; esac
  fi
  read_light_context

  # ---- usb-events state (node-local USB changes) ----
  # Three DISTINCT non-readings:
  #   state file absent/empty → UNAVAILABLE
  #   state file contains BLIND → BLIND
  #   state file fresh (mtime < 300s) and starts with ATTACH/DETACH → active USB interaction
  usb_status="UNAVAILABLE"
  usb_token=""
  if [ -f "$USB_STATE" ]; then
    usb_line="$(head -1 "$USB_STATE" 2>/dev/null)"
    usb_token="${usb_line%% *}"
    usb_age=$(( $(date +%s) - $(stat -c %Y "$USB_STATE" 2>/dev/null || echo 0) ))
    if [ "$usb_token" = "BLIND" ]; then
      usb_status="BLIND"
    elif { [ "$usb_token" = "ATTACH" ] || [ "$usb_token" = "DETACH" ]; } && [ "$usb_age" -lt "$USB_ACTIVE_TTL" ]; then
      usb_status="ACTIVE"
    else
      usb_status="QUIET"
    fi
  fi

  # ---- jack-state (node-local analog-jack plug → FOCUS mode; headless-safe, see header) ----
  # Three DISTINCT non-readings so an unreadable jack never collapses to a silent "nothing plugged":
  #   tool absent → UNAVAILABLE · tool exit 2 (no codec) → UNREACHABLE · jacks present+all-off → OPEN.
  focus="UNAVAILABLE"; jack_verdict="UNAVAILABLE"
  if command -v mesh-jack >/dev/null 2>&1; then
    _jk_out="$(timeout 5 mesh-jack 2>/dev/null)"; _jk_rc=$?
    if [ "$_jk_rc" = 2 ]; then
      focus="UNREACHABLE"; jack_verdict="UNREACHABLE"   # jacks absent (headless/no codec) ≠ OPEN
    else
      case "$_jk_out" in
        *"[jack] HEADSET"*)    jack_verdict="HEADSET";    focus="CALL-RIG" ;;
        *"[jack] HEADPHONES"*) jack_verdict="HEADPHONES"; focus="PRIVATE-LISTENING" ;;
        *"[jack] EXT-MIC"*)    jack_verdict="EXT-MIC";    focus="RECORDING" ;;
        *"[jack] OPEN"*)       jack_verdict="OPEN";       focus="OPEN" ;;
        *)                     jack_verdict="UNAVAILABLE"; focus="UNAVAILABLE" ;;
      esac
    fi
  fi

  # ---- audio-mode corroboration (mesh-audio-mode: capture+playback fusion) — CROSS-SENSE FUSION:
  # jack alone only knows a peripheral is PLUGGED (focus=CALL-RIG on jack=HEADSET), it cannot tell
  # whether a call is actually live. mesh-audio-mode reads the real mic-capture+playback pair, so
  # crossing it with focus gives a call_verified axis no single sense provides:
  #   focus=CALL-RIG + audio-mode=CALL            → CONFIRMED   (headset AND a live call both seen)
  #   focus=CALL-RIG + audio-mode=other verdict    → UNCONFIRMED (headset plugged, no call detected —
  #                                                  catches "headset left on" false CALL-RIG reads)
  #   focus=CALL-RIG + audio-mode tool absent/dark → UNKNOWN     (cannot corroborate, honest gap)
  #   focus != CALL-RIG                            → N/A         (nothing claimed to verify)
  audio_mode_verdict="UNAVAILABLE"
  if command -v mesh-audio-mode >/dev/null 2>&1; then
    _am_json="$(timeout 5 mesh-audio-mode --json 2>/dev/null)"; _am_rc=$?
    if [ "$_am_rc" = 2 ] || [ -z "$_am_json" ]; then
      audio_mode_verdict="UNKNOWN"
    else
      audio_mode_verdict="$(printf '%s' "$_am_json" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("verdict","UNKNOWN"))' 2>/dev/null)"
      [ -n "$audio_mode_verdict" ] || audio_mode_verdict="UNKNOWN"
    fi
  fi
  call_verified="N/A"
  if [ "$focus" = "CALL-RIG" ]; then
    case "$audio_mode_verdict" in
      CALL)                 call_verified="CONFIRMED" ;;
      UNAVAILABLE|UNKNOWN)  call_verified="UNKNOWN" ;;
      *)                    call_verified="UNCONFIRMED" ;;
    esac
  fi

  # ---- media-scene attribution (fresh cached producer artifact; no live re-probe) ----
  # mesh-media-scene writes line 1 as the stable scene word and line 2 as enrichment. Age the
  # producer artifact independently: a stale TV/LIVE label is not current room context.
  media_scene="UNKNOWN"; media_age_s="na"
  if [ -s "$MEDIA_STATE" ]; then
    media_age_s=$(( $(date +%s) - $(stat -c %Y "$MEDIA_STATE" 2>/dev/null || echo 0) ))
    media_candidate="$(head -n1 "$MEDIA_STATE" 2>/dev/null | cut -d'|' -f1)"
    case "$media_candidate" in
      MEDIA|TV-LIKELY|LIVE-SOUND|SOUND-UNATTRIBUTED|QUIET|NO-MEDIA)
        if [ "$media_age_s" -le "$MEDIA_MAX_AGE" ]; then media_scene="$media_candidate"; else media_scene="UNKNOWN"; fi
        ;;
    esac
  fi

  # Cached mesh-loadavg producer artifact. It is a real /proc/loadavg read; stale, absent, or
  # malformed state is UNKNOWN and cannot be used to manufacture a machine-pressure relation.
  loadavg_state="$(read_loadavg_state "$LOADAVG_STATE" "$LOADAVG_MAX_AGE")"
  # Cached mesh-diskio producer artifact. It is a real /proc/diskstats read; stale, absent, or
  # malformed state is UNKNOWN and cannot be used to manufacture a desk-I/O relation.
  diskio_state="$(read_diskio_state "$DISKIO_STATE" "$DISKIO_MAX_AGE")"

  DEGRADED=false

  # ---- Derive operator state ----
  STATE="UNKNOWN"
  REASON=""

  if [ "$body_state" = "UNKNOWN" ]; then
    # Phone SSH failed — fall back to IdeaPad-local signals instead of giving up.
    # Honest degraded path: outputs a coarser state with DEGRADED=true.
    # UNAVAILABLE ambient_level ≠ SILENCE: if the mic tool itself is missing, we cannot
    # conclude the room is quiet — that would be a silent all-clear on an unreachable input.
    DEGRADED=true
    if [ "$usb_status" = "ACTIVE" ]; then
      STATE="AT-DESK"; REASON="recent local USB activity (${usb_token}) — operator active at machine (SSH offline)"
    elif [ "$phone_lan" = "AWAY" ]; then
      STATE="AWAY"; REASON="phone not on LAN → operator left (SSH+LAN both offline)"
    elif [ "$phone_lan" = "HOME" ]; then
      # Phone CONFIRMED present on LAN — only now may mic disambiguate active vs idle. A LOUD mic
      # with a confirmed-present phone is a real AT-DESK signal.
      if [ "$ambient_level" = "LOUD" ] || [ "$ambient_level" = "MODERATE" ]; then
        STATE="AT-DESK"; REASON="phone home on LAN + mic=${ambient_level} (SSH offline)"
      elif [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
        STATE="NEARBY"; REASON="phone home on LAN + ${op_dev_name} close (${op_dev_tag}) (SSH offline)"
      elif [ "$ambient_level" != "UNAVAILABLE" ]; then
        STATE="HOME-IDLE"; REASON="phone home on LAN + mic=${ambient_level} (SSH offline)"
      else
        if [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
          STATE="NEARBY"; REASON="phone home on LAN + ${op_dev_name} close (${op_dev_tag}) + mic unavailable (SSH offline)"
        else
          STATE="HOME-IDLE"; REASON="phone home on LAN, mic unavailable (SSH offline)"
        fi
      fi
    else
      # phone_lan=UNKNOWN: NEITHER hard presence signal is confirmed (SSH dead AND LAN-ping
      # inconclusive). A LOUD/MODERATE mic ALONE cannot attribute the sound to the operator — it
      # could be the TV or other ambient noise (the appliance-vs-person trap). Asserting AT-DESK /
      # HOME-IDLE here would be a false-positive "operator present" manufactured from an
      # unreachable-dominated read (a silent all-clear on UNKNOWN inputs). Render UNKNOWN honestly;
      # the mic reading is preserved in REASON + SIGNALS so the nuance is visible, not faked.
      if [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
        STATE="NEARBY"; REASON="phone presence UNKNOWN + ${op_dev_name} close (${op_dev_tag}) — close BLE beats silence"
      elif [ "$ambient_level" != "UNAVAILABLE" ]; then
        STATE="UNKNOWN"; REASON="phone presence UNKNOWN (SSH+LAN both unconfirmed) + mic=${ambient_level} — ambient sound unattributable to operator (could be TV)"
      else
        STATE="UNKNOWN"; REASON="phone SSH offline + LAN unknown + mic tool unavailable — cannot assess"
      fi
    fi
  elif [ "$body_state" = "COVERED" ]; then
    STATE="COVERED"; REASON="phone face-down"
  elif [ "$body_state" = "HANDLED" ]; then
    STATE="AT-PHONE"; REASON="phone in hand (HANDLED)"
  elif [ "$body_state" = "CARRIED" ]; then
    STATE="AT-PHONE"; REASON="walking with phone (CARRIED)"
  else
    # STILL — disambiguate with signals
    _steps_n="${steps_d//-/}"; _steps_n="${_steps_n:-0}"
    # Use awk for float comparison (bash can't do floats)
    _accel_active=0
    [ -n "${linaccel:-}" ] && _accel_active="$(awk -v a="${linaccel:-0}" -v t="$ACCEL_ACTIVE" 'BEGIN{print (a > t) ? 1 : 0}')"

    if [ "$_steps_n" -gt "$STEP_MOVING" ] 2>/dev/null; then
      STATE="AT-PHONE"; REASON="steps increasing (Δ${steps_d})"
    elif [ "$_accel_active" = 1 ]; then
      STATE="AT-PHONE"; REASON="linear accel ${linaccel}g (picked up)"
    elif [ "$usb_status" = "ACTIVE" ]; then
      STATE="AT-DESK"; REASON="recent local USB activity (${usb_token}) — operator active at machine"
    elif [ "${HOUR:-12}" -ge 23 ] || [ "${HOUR:-12}" -le 6 ]; then
      _lux_n="${lux:-999}"
      if [ "$_lux_n" -lt "$LUX_DARK" ] 2>/dev/null; then
        STATE="ASLEEP"; REASON="STILL + dark (${lux}lux) + night hours"
      else
        STATE="NEARBY"; REASON="STILL, night but lit (${lux}lux)"
      fi
    elif [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
      STATE="NEARBY"; REASON="STILL + ${op_dev_name} close (${op_dev_tag})"
    else
      STATE="AWAY"; REASON="STILL + no personal device in range"
    fi
  fi

  attention_mode="$(derive_attention_mode "$STATE" "$focus")"
  cross_sense="$(derive_cross_sense "$STATE" "$body_state" "$focus" "$audio_mode_verdict" "$call_verified" "$phone_lan" "$ambient_level" "$media_scene" "$loadavg_state" "$diskio_state")"
  mobile_link="$(derive_mobile_link "$body_state" "$wifi_quality")"
  scene_context="$(derive_scene_context "$light_level" "$ambient_level" "$media_scene")"
  SIGNALS="body=${body_state} wifi=${wifi_quality} mobile_link=${mobile_link} loadavg=${loadavg_state} diskio=${diskio_state} mic=${ambient_level} light=${light_level}(source=${light_source}) scene_context=${scene_context} media_scene=${media_scene} media_age_s=${media_age_s} phone_lan=${phone_lan} focus=${focus} audio=${audio_mode_verdict} call_verified=${call_verified} cross_sense=${cross_sense} usb_events=${usb_status} attention_mode=${attention_mode} lux=${lux} Δsteps=${steps_d} accel=${linaccel} ${op_dev_name:-no-op-dev}=${op_dev_tag}"
  [ "${1:-}" != --json ] && printf '%s  operator: %-9s | %s | %s\n' "$TS" "$STATE" "$SIGNALS" "$REASON"

  if [ "${1:-}" = --json ]; then
    printf '{"state":"%s","degraded":%s,"body":"%s","wifi_quality":"%s","wifi_reason":"%s","mobile_link":"%s","loadavg_state":"%s","diskio_state":"%s","ambient_level":"%s","light_level":"%s","light_source":"%s","scene_context":"%s","media_scene":"%s","media_age_s":"%s","phone_lan":"%s","focus":"%s","attention_mode":"%s","jack":"%s","audio_mode":"%s","call_verified":"%s","cross_sense":"%s","usb_events":"%s","lux":"%s","steps_delta":"%s","linaccel":"%s","op_dev_rssi":%s,"op_dev_name":"%s","reason":"%s","ts":"%s"}\n' \
      "$STATE" "$DEGRADED" "$body_state" "$wifi_quality" "$wifi_reason" "$mobile_link" "$loadavg_state" "$diskio_state" "$ambient_level" "$light_level" "$light_source" "$scene_context" "$media_scene" "$media_age_s" "$phone_lan" "$focus" "$attention_mode" "$jack_verdict" "$audio_mode_verdict" "$call_verified" "$cross_sense" "$usb_status" \
      "${lux:--}" "${steps_d:--}" "${linaccel:--}" \
      "$([ "$op_dev_rssi" = "-999" ] && echo null || echo "$op_dev_rssi")" \
      "${op_dev_name:-}" "$REASON" "$(date -u +%FT%TZ)"
  fi
}

case "${1:-}" in
  --json)   _sample --json;;
  --watch)
    while true; do
      clear 2>/dev/null || printf '\033[2J\033[H'
      echo "=== operator-state monitor @ $(hostname) ==="
      _sample
      echo ""
      echo "(refresh every ${INTERVAL}s — Ctrl-C to stop)"
      sleep "$INTERVAL"
    done
    ;;
  *)  _sample;;
esac
