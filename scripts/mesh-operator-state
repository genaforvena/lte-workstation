#!/usr/bin/env bash
# mesh-operator-state — derived sense: WHERE IS THE OPERATOR'S ATTENTION?
# Folds body-motion (STILL/CARRIED/HANDLED/COVERED + lux + steps-delta + linaccel)
# + personal BLE device proximity (from cached presence.log) into one operator-state label.
# This is an emergent sense — no new sensors, just correlation of existing signals.
#
# States:
#   AT-PHONE  — actively using phone (HANDLED, or steps increasing, or high accel)
#   NEARBY    — phone parked + personal device close (Quest VR at close range = in room)
#   AWAY      — STILL + no personal device signal + no activity → probably not in room
#   COVERED   — phone face-down on surface (COVERED body-state)
#   ASLEEP    — STILL + very dark + late night hours (23:00-07:00)
#   UNKNOWN   — phone unreachable or data too old
#
#   mesh-operator-state           one-line state + key signals
#   mesh-operator-state --watch   loop (refresh every MESH_OP_STATE_INTERVAL seconds, default 60)
#   mesh-operator-state --json    machine-readable
#   mesh-operator-state --test    smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PRESENCE_LOG="$HOME/.mesh/presence.log"
INTERVAL="${MESH_OP_STATE_INTERVAL:-60}"
# Personal device proximity: MESH_OP_BLE_DEVICES (colon-sep name substrings); same default as mesh-operator-home.
# Bose excluded: stationary desk speaker broadcasts BLE 24/7 in standby — not a proximity signal.
OP_BLE_DEVICES="${MESH_OP_BLE_DEVICES:-Quest}"
OP_BLE_RSSI="${MESH_OP_BLE_RSSI:--82}"        # dBm threshold for "device is close (in room)"
LUX_DARK="${MESH_OP_LUX_DARK:-5}"             # lux below which it's dark at the phone
STEP_MOVING="${MESH_OP_STEP_MOVING:-3}"       # Δsteps that counts as "walking"
ACCEL_ACTIVE="${MESH_OP_ACCEL_ACTIVE:-0.25}"  # linaccel g above which phone is in hand/moving

[ "${1:-}" = --test ] && {
  command -v mesh-body-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-body-motion)"; exit 1; }
  # Artifact test: tool must produce a valid state label (UNKNOWN is ok — phone offline is honest)
  out="$("$0" 2>/dev/null)" || { echo "smoke-test: FAIL (tool failed to run)"; exit 1; }
  if printf '%s' "$out" | grep -qE 'operator: (AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|UNKNOWN)'; then
    label="$(printf '%s' "$out" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|UNKNOWN' | head -1)"
    echo "smoke-test: ok ($label)"; exit 0
  else
    echo "smoke-test: FAIL (unexpected output: '${out:0:80}')"; exit 1
  fi
}

_sample() {
  TS="$(date -u +%H:%M:%SZ)"
  HOUR="$(date +%H)"

  # ---- body-motion (one SSH read: accel + orient + steps + lux) ----
  body_line="$(mesh-body-motion 2>/dev/null)" || body_line=""
  body_state="UNKNOWN"; lux="-"; steps_d="-"; linaccel="-"
  if [ -n "$body_line" ]; then
    case "$body_line" in
      *STILL*)   body_state="STILL";;
      *CARRIED*) body_state="CARRIED";;
      *HANDLED*) body_state="HANDLED";;
      *COVERED*) body_state="COVERED";;
    esac
    lux="$(printf '%s' "$body_line" | grep -oE 'lux=[0-9]+' | grep -oE '[0-9]+')"
    steps_d="$(printf '%s' "$body_line" | grep -oE 'Δ[+-][0-9]+' | tr -d 'Δ+')"
    linaccel="$(printf '%s' "$body_line" | grep -oE 'linaccel=[0-9]+\.[0-9]+' | grep -oE '[0-9]+\.[0-9]+')"
  fi

  # ---- personal BLE device proximity from presence.log (cheap, no BLE scan) ----
  # Uses MESH_OP_BLE_DEVICES (colon-sep substrings, default: Quest).
  # Bose excluded: desk speaker broadcasts 24/7 in standby → never a valid proximity signal.
  op_dev_rssi="-999"; op_dev_tag="none"; op_dev_name=""
  if [ -s "$PRESENCE_LOG" ]; then
    IFS=':' read -ra _DEVS <<< "$OP_BLE_DEVICES"
    _pats="$(printf '%s\n' "${_DEVS[@]}" | tr '[:upper:]' '[:lower:]' | tr '\n' '|' | sed 's/|$//')"
    _result="$(tail -n 2 "$PRESENCE_LOG" | python3 -c "
import sys, re
pats = '${_pats}'.split('|')
best_rssi = None; best_name = ''
for line in sys.stdin:
    m = re.search(r'devices=\[(.+)\]', line)
    if not m: continue
    inner = m.group(1)
    entries = list(re.finditer(r'(-\d+)\|[0-9A-Fa-f:]{17}\|', inner))
    for i, e in enumerate(entries):
        rssi = int(e.group(1))
        nstart = e.end()
        nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
        name = inner[nstart:nend].rstrip('] ')
        if any(p in name.lower() for p in pats):
            if best_rssi is None or rssi > best_rssi:
                best_rssi = rssi; best_name = name
if best_rssi is not None: print(f'{best_rssi}|{best_name}')
" 2>/dev/null)"
    if [ -n "$_result" ]; then
      op_dev_rssi="${_result%%|*}"
      op_dev_name="${_result#*|}"
      op_dev_tag="${op_dev_rssi}dBm"
    fi
  fi

  # ---- Derive operator state ----
  STATE="UNKNOWN"
  REASON=""

  if [ "$body_state" = "UNKNOWN" ]; then
    STATE="UNKNOWN"; REASON="phone unreachable"
  elif [ "$body_state" = "COVERED" ]; then
    STATE="COVERED"; REASON="phone face-down"
  elif [ "$body_state" = "HANDLED" ]; then
    STATE="AT-PHONE"; REASON="phone in hand (HANDLED)"
  elif [ "$body_state" = "CARRIED" ]; then
    STATE="AT-PHONE"; REASON="walking with phone (CARRIED)"
  else
    # STILL — disambiguate with signals
    _steps_n="${steps_d//-/}"; _steps_n="${_steps_n:-0}"
    # Use awk for float comparison (bash can't do floats)
    _accel_active=0
    [ -n "${linaccel:-}" ] && _accel_active="$(awk -v a="${linaccel:-0}" -v t="$ACCEL_ACTIVE" 'BEGIN{print (a > t) ? 1 : 0}')"

    if [ "$_steps_n" -gt "$STEP_MOVING" ] 2>/dev/null; then
      STATE="AT-PHONE"; REASON="steps increasing (Δ${steps_d})"
    elif [ "$_accel_active" = 1 ]; then
      STATE="AT-PHONE"; REASON="linear accel ${linaccel}g (picked up)"
    elif [ "${HOUR:-12}" -ge 23 ] || [ "${HOUR:-12}" -le 6 ]; then
      _lux_n="${lux:-999}"
      if [ "$_lux_n" -lt "$LUX_DARK" ] 2>/dev/null; then
        STATE="ASLEEP"; REASON="STILL + dark (${lux}lux) + night hours"
      else
        STATE="NEARBY"; REASON="STILL, night but lit (${lux}lux)"
      fi
    elif [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
      STATE="NEARBY"; REASON="STILL + ${op_dev_name} close (${op_dev_tag})"
    else
      STATE="AWAY"; REASON="STILL + no personal device in range"
    fi
  fi

  SIGNALS="body=${body_state} lux=${lux} Δsteps=${steps_d} accel=${linaccel} ${op_dev_name:-no-op-dev}=${op_dev_tag}"
  printf '%s  operator: %-8s | %s | %s\n' "$TS" "$STATE" "$SIGNALS" "$REASON"

  if [ "${1:-}" = --json ]; then
    printf '{"state":"%s","body":"%s","lux":"%s","steps_delta":"%s","linaccel":"%s","op_dev_rssi":%s,"op_dev_name":"%s","reason":"%s","ts":"%s"}\n' \
      "$STATE" "$body_state" "${lux:--}" "${steps_d:--}" "${linaccel:--}" \
      "$([ "$op_dev_rssi" = "-999" ] && echo null || echo "$op_dev_rssi")" \
      "${op_dev_name:-}" "$REASON" "$(date -u +%FT%TZ)"
  fi
}

case "${1:-}" in
  --json)   _sample --json;;
  --watch)
    while true; do
      clear 2>/dev/null || printf '\033[2J\033[H'
      echo "=== operator-state monitor @ $(hostname) ==="
      _sample
      echo ""
      echo "(refresh every ${INTERVAL}s — Ctrl-C to stop)"
      sleep "$INTERVAL"
    done
    ;;
  *)  _sample;;
esac
