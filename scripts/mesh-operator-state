#!/usr/bin/env bash
# mesh-operator-state — derived sense: WHERE IS THE OPERATOR'S ATTENTION?
# Folds body-motion (STILL/CARRIED/HANDLED/COVERED + lux + steps-delta + linaccel)
# + personal BLE device proximity (from cached presence.log) into one operator-state label.
# When phone SSH is unreachable, falls back to IdeaPad-local signals (mic + phone LAN)
# for a coarser but honest derived state instead of collapsing to UNKNOWN.
#
# States (full — phone SSH reachable):
#   AT-PHONE  — actively using phone (HANDLED, or steps increasing, or high accel)
#   NEARBY    — phone parked + personal device close (Quest VR at close range = in room)
#   AWAY      — STILL + no personal device signal + no activity → probably not in room
#   COVERED   — phone face-down on surface (COVERED body-state)
#   ASLEEP    — STILL + very dark + late night hours (23:00-07:00)
#
# States (degraded — phone SSH down, IdeaPad-local signals only):
#   AT-DESK   — IdeaPad mic LOUD/MODERATE + phone home on LAN → active at computer
#   NEARBY    — close personal BLE + quiet mic / no mic → operator still in the space
#   HOME-IDLE — IdeaPad mic QUIET/SILENCE + phone home on LAN → home but idle/resting
#   AWAY      — phone NOT on LAN → operator left (no phone = no operator)
#   UNKNOWN   — phone LAN unreachable AND ambient-level unavailable AND no close BLE → cannot assess
#
# Honest-degraded contract: SILENCE ≠ UNAVAILABLE — a silent mic is a real reading;
# UNAVAILABLE means the mic tool itself failed. Both are shown distinctly in signals.
# JSON field "degraded": true when local-only fallback was used (phone SSH was down).
#
# FOCUS axis (cross-sense fusion with mesh-jack — node-local analog-jack plug state):
#   orthogonal to location, it names the desk's listening/recording MODE so the attention read is
#   richer than position alone — "AT-DESK + PRIVATE-LISTENING" vs "AT-DESK + OPEN(speakers)".
#     HEADPHONES → PRIVATE-LISTENING · EXT-MIC → RECORDING · HEADSET → CALL-RIG · OPEN → OPEN
#   It is HEADLESS-SAFE (no phone, no SSH) so it survives the degraded path where every phone axis is
#   dead. Honest-degraded, THREE distinct non-readings (empty ≠ failed): focus=UNAVAILABLE (jack tool
#   missing) vs UNREACHABLE (jack exits 2 — no codec / headless VM, jacks absent) vs OPEN (jacks
#   present, nothing plugged — a REAL empty). jack reports a peripheral STATE not a plug EVENT (a
#   headset can sit plugged on an empty desk) → focus NEVER upgrades a non-present verdict to present.
#
#   mesh-operator-state           one-line state + key signals
#   mesh-operator-state --watch   loop (refresh every MESH_OP_STATE_INTERVAL seconds, default 60)
#   mesh-operator-state --json    machine-readable
#   mesh-operator-state --test    smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PRESENCE_LOG="$HOME/.mesh/presence.log"
INTERVAL="${MESH_OP_STATE_INTERVAL:-60}"
# Personal device proximity: MESH_OP_BLE_DEVICES (colon-sep name substrings); same default as mesh-operator-home.
# Bose excluded: stationary desk speaker broadcasts BLE 24/7 in standby — not a proximity signal.
OP_BLE_DEVICES="${MESH_OP_BLE_DEVICES:-Quest}"
OP_BLE_RSSI="${MESH_OP_BLE_RSSI:--82}"        # dBm threshold for "device is close (in room)"
LUX_DARK="${MESH_OP_LUX_DARK:-5}"             # lux below which it's dark at the phone
STEP_MOVING="${MESH_OP_STEP_MOVING:-3}"       # Δsteps that counts as "walking"
ACCEL_ACTIVE="${MESH_OP_ACCEL_ACTIVE:-0.25}"  # linaccel g above which phone is in hand/moving

[ "${1:-}" = --test ] && {
  command -v mesh-body-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-body-motion)"; exit 1; }
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/home/.mesh" "$_td/bin"

  # Negative control: without mesh-body-motion the smoke test must fail fast.
  env -i PATH=/tmp/empty HOME="$_td/home" /bin/bash "$0" --test >/dev/null 2>&1 && {
    echo "smoke-test: FAIL (missing mesh-body-motion should fail)"; rm -rf "$_td"; exit 1;
  }

  cat > "$_td/bin/mesh-body-motion" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --json) echo '{"dummy":true}'; exit 0 ;;
esac
printf '%s\n' "2026-06-19T20:00:00Z  HANDLED body-motion stub lux=7 Δ+1 linaccel=0.31"
EOF
  chmod +x "$_td/bin/mesh-body-motion" || { echo "smoke-test: FAIL (stub chmod failed)"; rm -rf "$_td"; exit 1; }

  cat > "$_td/bin/mesh-ambient-level" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --json) echo '{"label":"SILENCE","rms_db":-99,"peak_db":-99}'; exit 0 ;;
esac
echo "ambient-level: SILENCE (rms=-99dB peak=-99dB)"
EOF
  chmod +x "$_td/bin/mesh-ambient-level" || { echo "smoke-test: FAIL (ambient stub chmod failed)"; rm -rf "$_td"; exit 1; }

  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --json) echo '{"status":"HOME","reason":"stub","phone_lan":1,"ble_home":0,"ts_online":0}'; exit 0 ;;
esac
echo "HOME — stub"
EOF
  chmod +x "$_td/bin/mesh-operator-home" || { echo "smoke-test: FAIL (home stub chmod failed)"; rm -rf "$_td"; exit 1; }

  cat > "$_td/bin/mesh-jack" <<'EOF'
#!/usr/bin/env bash
echo "[jack] HEADPHONES — headphone plugged — private/focused listening [headphone=on ext-mic=off card=0] @ stub"
exit 0
EOF
  chmod +x "$_td/bin/mesh-jack" || { echo "smoke-test: FAIL (jack stub chmod failed)"; rm -rf "$_td"; exit 1; }

  out="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" 2>/dev/null)" || {
    echo "smoke-test: FAIL (tool failed to run with stubs)"; rm -rf "$_td"; exit 1;
  }
  valid_re='operator: (AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN)'
  printf '%s' "$out" | grep -qE "$valid_re" || {
    echo "smoke-test: FAIL (unexpected output: '${out:0:120}')"; rm -rf "$_td"; exit 1;
  }
  label="$(printf '%s' "$out" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN' | head -1)"
  json="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (json run failed with stubs)"; rm -rf "$_td"; exit 1;
  }
  printf '%s' "$json" | python3 -c 'import sys,json; d=json.load(sys.stdin); assert "degraded" in d, "missing degraded field"; assert "ambient_level" in d, "missing ambient_level field"; assert "phone_lan" in d, "missing phone_lan field"; assert "focus" in d, "missing focus field"; assert "jack" in d, "missing jack field"' 2>/dev/null \
    || { echo "smoke-test: FAIL (JSON missing new fields: degraded/ambient_level/phone_lan/focus/jack)"; rm -rf "$_td"; exit 1; }
  deg="$(printf '%s' "$json" | python3 -c 'import sys,json; print(type(json.load(sys.stdin)["degraded"]).__name__)' 2>/dev/null)"
  [ "$deg" = "bool" ] || { echo "smoke-test: FAIL (degraded field is not bool: $deg)"; rm -rf "$_td"; exit 1; }
  # FOCUS fusion: jack=HEADPHONES stub must fuse to focus=PRIVATE-LISTENING (real cross-sense derive)
  focusval="$(printf '%s' "$json" | python3 -c 'import sys,json; print(json.load(sys.stdin)["focus"])' 2>/dev/null)"
  [ "$focusval" = "PRIVATE-LISTENING" ] || { echo "smoke-test: FAIL (jack=HEADPHONES must fuse focus=PRIVATE-LISTENING, got '$focusval')"; rm -rf "$_td"; exit 1; }

  # ---- Regression: appliance-vs-person honest-fusion. body=UNKNOWN (phone SSH dead) + mic=LOUD +
  # phone_lan=UNKNOWN (LAN ping inconclusive) must NOT yield AT-DESK — a LOUD mic alone cannot
  # attribute ambient sound to the operator (could be the TV), so asserting "operator present" would
  # be a false all-clear on an unreachable-dominated read. Honest verdict = UNKNOWN. ----
  cat > "$_td/bin/mesh-body-motion" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{}'; exit 0 ;; esac
# empty output → body_state=UNKNOWN (phone SSH unreachable)
EOF
  cat > "$_td/bin/mesh-ambient-level" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"label":"LOUD","rms_db":-20,"peak_db":-5}'; exit 0 ;; esac
echo "ambient-level: LOUD (rms=-20dB peak=-5dB)"
EOF
  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"status":"UNKNOWN","reason":"stub LAN inconclusive"}'; exit 0 ;; esac
echo "UNKNOWN — stub"
EOF
  chmod +x "$_td/bin/mesh-body-motion" "$_td/bin/mesh-ambient-level" "$_td/bin/mesh-operator-home"
  rout="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" 2>/dev/null)"
  rlabel="$(printf '%s' "$rout" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN' | head -1)"
  [ "$rlabel" = "UNKNOWN" ] || { echo "smoke-test: FAIL (regression: body=UNKNOWN + mic=LOUD + phone_lan=UNKNOWN gave '$rlabel', want UNKNOWN — false-positive AT-DESK from unreachable inputs)"; rm -rf "$_td"; exit 1; }

  # ---- Coverage enrichment: close personal BLE should lift the degraded path to NEARBY instead
  # of collapsing into HOME-IDLE/UNKNOWN. This is a richer derived state than any single input gives.
  cat > "$_td/bin/mesh-ambient-level" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"label":"QUIET","rms_db":-48,"peak_db":-30}'; exit 0 ;; esac
echo "ambient-level: QUIET (rms=-48dB peak=-30dB)"
EOF
  cat > "$_td/bin/mesh-operator-home" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --json) echo '{"status":"HOME","reason":"stub LAN confirmed"}'; exit 0 ;; esac
echo "HOME — stub"
EOF
  chmod +x "$_td/bin/mesh-ambient-level" "$_td/bin/mesh-operator-home"
  cat > "$_td/home/.mesh/presence.log" <<'EOF'
2026-07-01T00:00:00Z stub n=1 devices=[-62|72:E4:B3:50:C7:1F|Quest 3] attribution=personal:1,appliance:0,ambiguous:0 unidentified=public:0,random:1,unknown:0
EOF
  nout="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" 2>/dev/null)"
  nlabel="$(printf '%s' "$nout" | grep -oE 'AT-PHONE|NEARBY|AWAY|COVERED|ASLEEP|AT-DESK|HOME-IDLE|UNKNOWN' | head -1)"
  [ "$nlabel" = "NEARBY" ] || { echo "smoke-test: FAIL (degraded close BLE should give NEARBY, got '$nlabel')"; rm -rf "$_td"; exit 1; }

  # ---- Regression: jack UNREACHABLE (exit 2 — no codec / headless VM) must render focus=UNREACHABLE,
  # NOT OPEN. Collapsing an unreadable jack to OPEN ("nothing plugged") would be a silent all-clear on
  # an input that could not be read at all — the empty-≠-failed contract this fusion exists to honor. ----
  cat > "$_td/bin/mesh-jack" <<'EOF'
#!/usr/bin/env bash
echo "[jack] UNREACHABLE — no analog jack-detect controls on card 0 @ stub" >&2
exit 2
EOF
  chmod +x "$_td/bin/mesh-jack"
  ujson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  ufocus="$(printf '%s' "$ujson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["focus"])' 2>/dev/null)"
  [ "$ufocus" = "UNREACHABLE" ] || { echo "smoke-test: FAIL (jack exit-2 must give focus=UNREACHABLE not '$ufocus' — empty≠failed all-clear)"; rm -rf "$_td"; exit 1; }
  # And an ABSENT jack tool must be UNAVAILABLE (a third, distinct non-reading) — not UNREACHABLE/OPEN.
  rm -f "$_td/bin/mesh-jack"
  ajson="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" /bin/bash "$0" --json 2>/dev/null)"
  afocus="$(printf '%s' "$ajson" | python3 -c 'import sys,json; print(json.load(sys.stdin)["focus"])' 2>/dev/null)"
  [ "$afocus" = "UNAVAILABLE" ] || { echo "smoke-test: FAIL (absent jack tool must give focus=UNAVAILABLE not '$afocus')"; rm -rf "$_td"; exit 1; }

  echo "smoke-test: ok ($label; JSON fields ok; degraded=$deg; focus-fusion PRIVATE-LISTENING + UNREACHABLE≠OPEN≠UNAVAILABLE regressions; +appliance-vs-person: UNKNOWN not AT-DESK; +degraded close BLE NEARBY)"
  rm -rf "$_td"
  exit 0
}

_sample() {
  TS="$(date -u +%H:%M:%SZ)"
  HOUR="$(date +%H)"

  # ---- body-motion (one SSH read: accel + orient + steps + lux) ----
  body_line="$(mesh-body-motion 2>/dev/null)" || body_line=""
  body_state="UNKNOWN"; lux="-"; steps_d="-"; linaccel="-"
  if [ -n "$body_line" ]; then
    case "$body_line" in
      *STILL*)   body_state="STILL";;
      *CARRIED*) body_state="CARRIED";;
      *HANDLED*) body_state="HANDLED";;
      *COVERED*) body_state="COVERED";;
    esac
    lux="$(printf '%s' "$body_line" | grep -oE 'lux=[0-9]+' | grep -oE '[0-9]+')"
    steps_d="$(printf '%s' "$body_line" | grep -oE 'Δ[+-][0-9]+' | tr -d 'Δ+')"
    linaccel="$(printf '%s' "$body_line" | grep -oE 'linaccel=[0-9]+\.[0-9]+' | grep -oE '[0-9]+\.[0-9]+')"
  fi

  # ---- personal BLE device proximity from presence.log (cheap, no BLE scan) ----
  # Uses MESH_OP_BLE_DEVICES (colon-sep substrings, default: Quest).
  # Bose excluded: desk speaker broadcasts 24/7 in standby → never a valid proximity signal.
  op_dev_rssi="-999"; op_dev_tag="none"; op_dev_name=""
  if [ -s "$PRESENCE_LOG" ]; then
    IFS=':' read -ra _DEVS <<< "$OP_BLE_DEVICES"
    _pats="$(printf '%s\n' "${_DEVS[@]}" | tr '[:upper:]' '[:lower:]' | tr '\n' '|' | sed 's/|$//')"
    _result="$(tail -n 2 "$PRESENCE_LOG" | python3 -c "
import sys, re
pats = '${_pats}'.split('|')
best_rssi = None; best_name = ''
for line in sys.stdin:
    m = re.search(r'devices=\[(.+)\]', line)
    if not m: continue
    inner = m.group(1)
    entries = list(re.finditer(r'(-\d+)\|[0-9A-Fa-f:]{17}\|', inner))
    for i, e in enumerate(entries):
        rssi = int(e.group(1))
        nstart = e.end()
        nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
        name = inner[nstart:nend].rstrip('] ')
        if any(p in name.lower() for p in pats):
            if best_rssi is None or rssi > best_rssi:
                best_rssi = rssi; best_name = name
if best_rssi is not None: print(f'{best_rssi}|{best_name}')
" 2>/dev/null)"
    if [ -n "$_result" ]; then
      op_dev_rssi="${_result%%|*}"
      op_dev_name="${_result#*|}"
      op_dev_tag="${op_dev_rssi}dBm"
    fi
  fi

  # ---- IdeaPad-local fallback signals (always available, used when phone SSH fails) ----
  # These are read regardless so they enrich the JSON even on the full path.
  # ambient_level: LOUD/MODERATE/QUIET/SILENCE (mic heard something) vs UNAVAILABLE (no mic tool)
  # phone_lan: HOME/AWAY/UNKNOWN (LAN ping — faster than SSH, can succeed when SSH is dead)
  ambient_level="UNAVAILABLE"
  phone_lan="UNKNOWN"
  if command -v mesh-ambient-level >/dev/null 2>&1; then
    _al_out="$(timeout 5 mesh-ambient-level 2>/dev/null)" || true
    if printf '%s' "${_al_out:-}" | grep -q 'LOUD';     then ambient_level="LOUD"
    elif printf '%s' "${_al_out:-}" | grep -q 'MODERATE'; then ambient_level="MODERATE"
    elif printf '%s' "${_al_out:-}" | grep -q 'QUIET';    then ambient_level="QUIET"
    elif printf '%s' "${_al_out:-}" | grep -q 'SILENCE';  then ambient_level="SILENCE"
    fi
  fi
  if command -v mesh-operator-home >/dev/null 2>&1; then
    _oh_json="$(timeout 8 mesh-operator-home --json 2>/dev/null)" || true
    _oh_status="$(printf '%s' "${_oh_json:-}" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("status",""))' 2>/dev/null)" || true
    case "${_oh_status:-}" in HOME) phone_lan="HOME";; AWAY) phone_lan="AWAY";; esac
  fi

  # ---- jack-state (node-local analog-jack plug → FOCUS mode; headless-safe, see header) ----
  # Three DISTINCT non-readings so an unreadable jack never collapses to a silent "nothing plugged":
  #   tool absent → UNAVAILABLE · tool exit 2 (no codec) → UNREACHABLE · jacks present+all-off → OPEN.
  focus="UNAVAILABLE"; jack_verdict="UNAVAILABLE"
  if command -v mesh-jack >/dev/null 2>&1; then
    _jk_out="$(timeout 5 mesh-jack 2>/dev/null)"; _jk_rc=$?
    if [ "$_jk_rc" = 2 ]; then
      focus="UNREACHABLE"; jack_verdict="UNREACHABLE"   # jacks absent (headless/no codec) ≠ OPEN
    else
      case "$_jk_out" in
        *"[jack] HEADSET"*)    jack_verdict="HEADSET";    focus="CALL-RIG" ;;
        *"[jack] HEADPHONES"*) jack_verdict="HEADPHONES"; focus="PRIVATE-LISTENING" ;;
        *"[jack] EXT-MIC"*)    jack_verdict="EXT-MIC";    focus="RECORDING" ;;
        *"[jack] OPEN"*)       jack_verdict="OPEN";       focus="OPEN" ;;
        *)                     jack_verdict="UNAVAILABLE"; focus="UNAVAILABLE" ;;
      esac
    fi
  fi

  DEGRADED=false

  # ---- Derive operator state ----
  STATE="UNKNOWN"
  REASON=""

  if [ "$body_state" = "UNKNOWN" ]; then
    # Phone SSH failed — fall back to IdeaPad-local signals instead of giving up.
    # Honest degraded path: outputs a coarser state with DEGRADED=true.
    # UNAVAILABLE ambient_level ≠ SILENCE: if the mic tool itself is missing, we cannot
    # conclude the room is quiet — that would be a silent all-clear on an unreachable input.
    DEGRADED=true
    if [ "$phone_lan" = "AWAY" ]; then
      STATE="AWAY"; REASON="phone not on LAN → operator left (SSH+LAN both offline)"
    elif [ "$phone_lan" = "HOME" ]; then
      # Phone CONFIRMED present on LAN — only now may mic disambiguate active vs idle. A LOUD mic
      # with a confirmed-present phone is a real AT-DESK signal.
      if [ "$ambient_level" = "LOUD" ] || [ "$ambient_level" = "MODERATE" ]; then
        STATE="AT-DESK"; REASON="phone home on LAN + mic=${ambient_level} (SSH offline)"
      elif [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
        STATE="NEARBY"; REASON="phone home on LAN + ${op_dev_name} close (${op_dev_tag}) (SSH offline)"
      elif [ "$ambient_level" != "UNAVAILABLE" ]; then
        STATE="HOME-IDLE"; REASON="phone home on LAN + mic=${ambient_level} (SSH offline)"
      else
        if [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
          STATE="NEARBY"; REASON="phone home on LAN + ${op_dev_name} close (${op_dev_tag}) + mic unavailable (SSH offline)"
        else
          STATE="HOME-IDLE"; REASON="phone home on LAN, mic unavailable (SSH offline)"
        fi
      fi
    else
      # phone_lan=UNKNOWN: NEITHER hard presence signal is confirmed (SSH dead AND LAN-ping
      # inconclusive). A LOUD/MODERATE mic ALONE cannot attribute the sound to the operator — it
      # could be the TV or other ambient noise (the appliance-vs-person trap). Asserting AT-DESK /
      # HOME-IDLE here would be a false-positive "operator present" manufactured from an
      # unreachable-dominated read (a silent all-clear on UNKNOWN inputs). Render UNKNOWN honestly;
      # the mic reading is preserved in REASON + SIGNALS so the nuance is visible, not faked.
      if [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
        STATE="NEARBY"; REASON="phone presence UNKNOWN + ${op_dev_name} close (${op_dev_tag}) — close BLE beats silence"
      elif [ "$ambient_level" != "UNAVAILABLE" ]; then
        STATE="UNKNOWN"; REASON="phone presence UNKNOWN (SSH+LAN both unconfirmed) + mic=${ambient_level} — ambient sound unattributable to operator (could be TV)"
      else
        STATE="UNKNOWN"; REASON="phone SSH offline + LAN unknown + mic tool unavailable — cannot assess"
      fi
    fi
  elif [ "$body_state" = "COVERED" ]; then
    STATE="COVERED"; REASON="phone face-down"
  elif [ "$body_state" = "HANDLED" ]; then
    STATE="AT-PHONE"; REASON="phone in hand (HANDLED)"
  elif [ "$body_state" = "CARRIED" ]; then
    STATE="AT-PHONE"; REASON="walking with phone (CARRIED)"
  else
    # STILL — disambiguate with signals
    _steps_n="${steps_d//-/}"; _steps_n="${_steps_n:-0}"
    # Use awk for float comparison (bash can't do floats)
    _accel_active=0
    [ -n "${linaccel:-}" ] && _accel_active="$(awk -v a="${linaccel:-0}" -v t="$ACCEL_ACTIVE" 'BEGIN{print (a > t) ? 1 : 0}')"

    if [ "$_steps_n" -gt "$STEP_MOVING" ] 2>/dev/null; then
      STATE="AT-PHONE"; REASON="steps increasing (Δ${steps_d})"
    elif [ "$_accel_active" = 1 ]; then
      STATE="AT-PHONE"; REASON="linear accel ${linaccel}g (picked up)"
    elif [ "${HOUR:-12}" -ge 23 ] || [ "${HOUR:-12}" -le 6 ]; then
      _lux_n="${lux:-999}"
      if [ "$_lux_n" -lt "$LUX_DARK" ] 2>/dev/null; then
        STATE="ASLEEP"; REASON="STILL + dark (${lux}lux) + night hours"
      else
        STATE="NEARBY"; REASON="STILL, night but lit (${lux}lux)"
      fi
    elif [ "$op_dev_rssi" -gt "$OP_BLE_RSSI" ] 2>/dev/null; then
      STATE="NEARBY"; REASON="STILL + ${op_dev_name} close (${op_dev_tag})"
    else
      STATE="AWAY"; REASON="STILL + no personal device in range"
    fi
  fi

  SIGNALS="body=${body_state} mic=${ambient_level} phone_lan=${phone_lan} focus=${focus} lux=${lux} Δsteps=${steps_d} accel=${linaccel} ${op_dev_name:-no-op-dev}=${op_dev_tag}"
  [ "${1:-}" != --json ] && printf '%s  operator: %-9s | %s | %s\n' "$TS" "$STATE" "$SIGNALS" "$REASON"

  if [ "${1:-}" = --json ]; then
    printf '{"state":"%s","degraded":%s,"body":"%s","ambient_level":"%s","phone_lan":"%s","focus":"%s","jack":"%s","lux":"%s","steps_delta":"%s","linaccel":"%s","op_dev_rssi":%s,"op_dev_name":"%s","reason":"%s","ts":"%s"}\n' \
      "$STATE" "$DEGRADED" "$body_state" "$ambient_level" "$phone_lan" "$focus" "$jack_verdict" \
      "${lux:--}" "${steps_d:--}" "${linaccel:--}" \
      "$([ "$op_dev_rssi" = "-999" ] && echo null || echo "$op_dev_rssi")" \
      "${op_dev_name:-}" "$REASON" "$(date -u +%FT%TZ)"
  fi
}

case "${1:-}" in
  --json)   _sample --json;;
  --watch)
    while true; do
      clear 2>/dev/null || printf '\033[2J\033[H'
      echo "=== operator-state monitor @ $(hostname) ==="
      _sample
      echo ""
      echo "(refresh every ${INTERVAL}s — Ctrl-C to stop)"
      sleep "$INTERVAL"
    done
    ;;
  *)  _sample;;
esac
