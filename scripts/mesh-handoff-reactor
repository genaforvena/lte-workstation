#!/usr/bin/env python3
# mesh-handoff-reactor — react to new [handoff] board lines by clearing the target mind pane.
# reflex-cadence: */5 * * * *
# reflex-args: --listen
# The cadence runs mesh-fsnotify around this script, so a handoff wakes promptly while the cron
# cadence remains the liveness floor. Working or unreachable panes stay pending for retry.
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

ROOT = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh")))
CHAT = Path(os.environ.get("MESH_CHAT_LOG", str(ROOT / "chat.log")))
STATE = Path(os.environ.get("MESH_HANDOFF_REACTOR_STATE", str(ROOT / "handoff-reactor.json")))
TARGET = re.compile(r"\[handoff\]\s+([A-Za-z0-9_.-]+):")
MIND_STATE_CMD = os.environ.get("MESH_MIND_STATE_CMD", "mesh-mind-state")
CLEAR_CMD = os.environ.get("MESH_CLEAR_CMD", "mesh-clear")


def load_state() -> dict:
    try:
        value = json.loads(STATE.read_text())
        if isinstance(value, dict) and isinstance(value.get("offset"), int) and isinstance(value.get("pending"), list):
            return value
    except (OSError, json.JSONDecodeError):
        pass
    return {"offset": 0, "inode": 0, "pending": []}


def save_state(state: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(STATE.suffix + ".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=False) + "\n")
    tmp.replace(STATE)


def run(*args: str) -> subprocess.CompletedProcess[str]:
    env = dict(os.environ)
    env["PATH"] = str(Path.home() / ".local/bin") + os.pathsep + env.get("PATH", "")
    return subprocess.run(args, text=True, capture_output=True, timeout=30, env=env)


def once() -> int:
    state = load_state()
    try:
        stat = CHAT.stat()
        if state["inode"] != stat.st_ino or state["offset"] > stat.st_size:
            state["offset"] = 0
        state["inode"] = stat.st_ino
        with CHAT.open("rb") as handle:
            handle.seek(state["offset"])
            new_text = handle.read().decode("utf-8", errors="replace")
            state["offset"] = handle.tell()
    except OSError as exc:
        print(f"handoff-reactor: chat.log unreadable: {exc}", file=sys.stderr)
        return 2

    pending = list(dict.fromkeys(str(x) for x in state["pending"] if TARGET.fullmatch(f"[handoff] {x}:")))
    for line in new_text.splitlines():
        match = TARGET.search(line)
        if match and match.group(1) not in pending:
            pending.append(match.group(1))

    remaining = []
    for window in pending:
        try:
            mind = run(MIND_STATE_CMD, window)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"handoff-reactor: defer {window}: mind-state unavailable ({exc})", file=sys.stderr)
            remaining.append(window)
            continue
        status = mind.stdout.split("\t", 1)[0].strip()
        if status != "IDLE":
            print(f"handoff-reactor: defer {window}: pane state={status or 'UNKNOWN'}", file=sys.stderr)
            remaining.append(window)
            continue
        try:
            cleared = run(CLEAR_CMD, window)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"handoff-reactor: defer {window}: mesh-clear unavailable ({exc})", file=sys.stderr)
            remaining.append(window)
            continue
        if cleared.returncode == 0:
            print(f"handoff-reactor: cleared {window}")
        else:
            print(f"handoff-reactor: defer {window}: mesh-clear rc={cleared.returncode} "
                  f"{(cleared.stderr or cleared.stdout).strip()}", file=sys.stderr)
            remaining.append(window)
    state["pending"] = remaining
    save_state(state)
    return 0


def selftest() -> int:
    assert TARGET.search("x :: [handoff] health: state")
    assert not TARGET.search("x :: [fyi] health: state")
    print("handoff-reactor: test ok (handoff parser and explicit command boundaries)")
    return 0


def main() -> int:
    if sys.argv[1:] == ["--test"]:
        return selftest()
    if sys.argv[1:] == ["--once"]:
        return once()
    if sys.argv[1:] == ["--listen"]:
        fsnotify = os.environ.get("MESH_FSN_CMD", "mesh-fsnotify")
        return subprocess.run([fsnotify, "--window", "290", "--debounce", "4", str(CHAT), "--",
                               sys.executable, str(Path(__file__).resolve()), "--once"], check=False).returncode
    print("usage: mesh-handoff-reactor --once|--listen", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
