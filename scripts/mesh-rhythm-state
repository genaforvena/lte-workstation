#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-rhythm-state — cross-sense fusion: WHAT IS THE OPERATOR'S CURRENT WORK RHYTHM?
#
# Complements the existing fusions with the TIME-AXIS:
#   mesh-room-context     → social context (engaged/solo/etc.) — who/what
#   mesh-physical-context → physical state (in-seat/resting/etc.) — where/how
#   mesh-operator-engagement → engagement level (active/media/passive) — how much
#   mesh-rhythm-state     → work rhythm (deep-work/break/sleeping) — WHEN in the daily cycle
#   mesh-home-state       → cause layer (what-is-happening inference) — why
#
# No single sensor tells you "the operator is in deep-work mode" — that requires combining
# the body state (still? walking?), the visual environment (well-lit?), the neighbor social
# context (everyone home? quiet hours?), the local room social context, and the room occupancy.
# Fused, they give a single "rhythm" label that captures the operator's CURRENT work pattern.
#
# Inputs (all best-effort, each independently OFFLINE-able; 2+ missing → DEGRADED):
#   mesh-body-motion   .body-motion-state   STILL/WALKING/HANDLED/CARRIED/COVERED
#   mesh-light         .light-state         DARK/DIM/MODERATE/LIT/BRIGHT
#   mesh-ambient-clock .ambient-clock.state QUIET/MODERATE/ACTIVE/NIGHT-QUIET/DATA-STALE
#   mesh-room-context  .room-context.state  ENGAGED-ACTIVE/SOLO-QUIET/PEER-ACTIVE/etc.
#   mesh-room-sense    .room-sense.state    PRESENT/EMPTY/UNCERTAIN
#
# Classification (FALSIFIABLE via --test):
#   DEEP_WORK       body STILL + light MODERATE+ + ambient ACTIVE + room PRESENT + context ENGAGED
#                    → operator is doing focused work in a normal environment
#   LIGHT_BROWSING  body STILL + light DIM + room PRESENT + context SOLO
#                    → casual/relaxed use (browsing, casual reading)
#   CONVERSATIONAL  body HANDLED + ambient ACTIVE + room PRESENT + context SOLO/SOCIAL
#                    → operator is interacting (call, conversation)
#   BREAK           body STILL + light DIM + ambient QUIET + room PRESENT + context SOLO
#                    → operator is taking a break (idle, dim, quiet)
#   WINDING_DOWN    ambient FALLING (or just quiet) + body STILL + light DIM/DARK + context QUIET/SOLO
#                    → day is ending, operator winding down
#   SLEEPING        body STILL + light DARK + ambient NIGHT-QUIET + room PRESENT + context QUIET
#                    → operator (or room) is sleeping
#   AWAY            room EMPTY
#                    → operator not in room
#   DEGRADED        2+ inputs unreachable — explicit missing list, never a confident label
#
# Honest-degraded: an UNREACHABLE input renders visibly distinct from a genuine empty:
#   AWAY   = "room is genuinely empty, inputs are healthy"
#   DEGRADED = "couldn't tell — light and ambient-clock are both missing"
#   A consumer reading the state file sees the missing list, never a silent all-clear.
#
#   mesh-rhythm-state              one-shot label + reason
#   mesh-rhythm-state --json       machine-readable {label, reason, inputs, missing, ts}
#   mesh-rhythm-state --edge       emit only on label change (for cron wiring)
#   mesh-rhythm-state --test       smoke test (synthetic state files, no network)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.rhythm-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=1800  # 30min — generous for the longest-cadence input (ambient-clock cron 6-59/30=1800s,
              # room-sense cron 2-59/15=900s; 600s flagged both OFFLINE by design, not broken —
              # chat-review 2026-07-01T12:03:07Z; matches sibling convention: mesh-tempo-context:53, mesh-arc:51)

# read_state <state-file> → echoes first token of first line, or OFFLINE if missing/stale.
# mesh-body-motion writes its state as "[body-still]|..." — we extract the [body-*] tag explicitly.
read_state() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | grep -oE '\[body-[a-z]+\]' | head -1)"
  [ -z "$v" ] && v="$(head -1 "$f" 2>/dev/null | awk '{print $1}')"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# read_label <state-file> → echoes the LABEL field, or OFFLINE.
# (For light/ambient-clock/room-context/room-sense which write a single label like "DARK" / "QUIET".)
# NB: room-sense/light/ambient-clock enrich the label as LABEL|dwell_s=N|changes_24h=N (dwell
# enrichment) — so we take the first WHITESPACE token AND its first |-field, or every consumer would
# match against the whole "DARK|dwell_s=..." string and silently fall through (cross-sense vocab contract).
read_label() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | awk '{print $1}' | cut -d'|' -f1)"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# classify_rhythm <body> <light> <ambient> <roomctx> <roomsense> → "LABEL|reason"
# Pure, offline-testable. The bands are FALSIFIABLE — change a threshold and the test asserts fail.
classify_rhythm() {
  local body="$1" light="$2" amb="$3" roomctx="$4" roomsense="$5"
  # Strip [body-*] brackets from motion for cleaner matching
  case "$body" in
    '['body-*) body="${body#[}"; body="${body%]}" ;;
  esac
  local degraded=""
  [ "$body"     = "OFFLINE" ] && degraded="${degraded}body-motion,"
  [ "$light"    = "OFFLINE" ] && degraded="${degraded}light,"
  [ "$amb"      = "OFFLINE" ] && degraded="${degraded}ambient-clock,"
  [ "$roomctx"  = "OFFLINE" ] && degraded="${degraded}room-context,"
  [ "$roomsense" = "OFFLINE" ] && degraded="${degraded}room-sense,"
  degraded="${degraded%,}"
  local degen=0
  [ "$body"     = "OFFLINE" ] && degen=$((degen+1))
  [ "$light"    = "OFFLINE" ] && degen=$((degen+1))
  [ "$amb"      = "OFFLINE" ] && degen=$((degen+1))
  [ "$roomctx"  = "OFFLINE" ] && degen=$((degen+1))
  [ "$roomsense" = "OFFLINE" ] && degen=$((degen+1))
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $degraded"
    return
  fi
  # AWAY (room-empty precedence — if the room is empty, override all other rules)
  if [ "$roomsense" = "EMPTY" ]; then
    echo "AWAY|room empty, no occupant"
    return
  fi
  # Body is now in its stripped form (e.g., "STILL", "HANDLED", "body-still"). Some inputs
  # come bracketed ([body-still]) — we stripped them above. Match against the bare forms.
  case "$body" in
    body-still) body_norm="STILL" ;;
    body-handled) body_norm="HANDLED" ;;
    body-carried) body_norm="CARRIED" ;;
    body-walking) body_norm="WALKING" ;;
    body-covered) body_norm="COVERED" ;;
    *) body_norm="$body" ;;
  esac
  # SLEEPING: body STILL + light DARK + ambient NIGHT-QUIET + room PRESENT
  if [ "$body_norm" = "STILL" ] \
     && [ "$light" = "DARK" ] \
     && [ "$amb" = "NIGHT-QUIET" ] \
     && [ "$roomsense" = "PRESENT" ]; then
    echo "SLEEPING|body still, dark, night-quiet, present"
    return
  fi
  # WINDING_DOWN: ambient QUIET (or NIGHT-QUIET) + body STILL + light DIM/DARK
  if [ "$body_norm" = "STILL" ] \
     && { [ "$light" = "DIM" ] || [ "$light" = "DARK" ]; } \
     && { [ "$amb" = "QUIET" ] || [ "$amb" = "NIGHT-QUIET" ] || [ "$amb" = "DATA-WARMUP" ]; } \
     && [ "$roomsense" = "PRESENT" ]; then
    echo "WINDING_DOWN|body still, dim/dark light, quiet ambient"
    return
  fi
  # CONVERSATIONAL: body HANDLED/CARRIED + ambient ACTIVE/MODERATE + room PRESENT
  if { [ "$body_norm" = "HANDLED" ] || [ "$body_norm" = "CARRIED" ] || [ "$body_norm" = "COVERED" ]; } \
     && { [ "$amb" = "ACTIVE" ] || [ "$amb" = "MODERATE" ]; } \
     && [ "$roomsense" = "PRESENT" ]; then
    echo "CONVERSATIONAL|body handled/carried, ambient active"
    return
  fi
  # DEEP_WORK: body STILL + light MODERATE/LIT/BRIGHT + ambient ACTIVE/MODERATE + context ENGAGED
  if [ "$body_norm" = "STILL" ] \
     && { [ "$light" = "MODERATE" ] || [ "$light" = "LIT" ] || [ "$light" = "BRIGHT" ]; } \
     && { [ "$amb" = "ACTIVE" ] || [ "$amb" = "MODERATE" ]; } \
     && [ "$roomsense" = "PRESENT" ] \
     && { [ "$roomctx" = "ENGAGED-ACTIVE" ] || [ "$roomctx" = "PEER-ACTIVE" ] || [ "$roomctx" = "VACANT" ]; }; then
    echo "DEEP_WORK|body still, lit, ambient active, room engaged (ctx=$roomctx)"
    return
  fi
  # LIGHT_BROWSING: body STILL + light DIM + room PRESENT
  if [ "$body_norm" = "STILL" ] \
     && [ "$light" = "DIM" ] \
     && [ "$roomsense" = "PRESENT" ]; then
    echo "LIGHT_BROWSING|body still, dim light, room present"
    return
  fi
  # BREAK: body STILL + ambient QUIET + room PRESENT (no context, no light rules matched)
  if [ "$body_norm" = "STILL" ] \
     && [ "$amb" = "QUIET" ] \
     && [ "$roomsense" = "PRESENT" ]; then
    echo "BREAK|body still, ambient quiet, room present"
    return
  fi
  # WALKING: body in motion
  if [ "$body_norm" = "WALKING" ]; then
    echo "WALKING|body in motion"
    return
  fi
  # DEGRADED with single missing (the verdict path didn't match any confident label)
  if [ -n "$degraded" ]; then
    echo "DEGRADED|missing: $degraded (body=$body light=$light amb=$amb roomctx=$roomctx roomsense=$roomsense)"
    return
  fi
  # UNKNOWN: all inputs reachable but no rule fired
  echo "UNKNOWN|body=$body light=$light amb=$amb roomctx=$roomctx roomsense=$roomsense"
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  fail=0
  # DEEP_WORK
  r="$(classify_rhythm STILL MODERATE ACTIVE ENGAGED-ACTIVE PRESENT)"
  [ "$r" = "DEEP_WORK|body still, lit, ambient active, room engaged (ctx=ENGAGED-ACTIVE)" ] || { echo "  FAIL: DEEP_WORK got=$r"; fail=1; }
  # SLEEPING
  r="$(classify_rhythm STILL DARK NIGHT-QUIET QUIET PRESENT)"
  [ "$r" = "SLEEPING|body still, dark, night-quiet, present" ] || { echo "  FAIL: SLEEPING got=$r"; fail=1; }
  # CONVERSATIONAL
  r="$(classify_rhythm HANDLED ACTIVE ACTIVE SOLO-QUIET PRESENT)"
  [ "$r" = "CONVERSATIONAL|body handled/carried, ambient active" ] || { echo "  FAIL: CONVERSATIONAL got=$r"; fail=1; }
  # LIGHT_BROWSING
  r="$(classify_rhythm STILL DIM MODERATE SOLO-QUIET PRESENT)"
  [ "$r" = "LIGHT_BROWSING|body still, dim light, room present" ] || { echo "  FAIL: LIGHT_BROWSING got=$r"; fail=1; }
  # BREAK: body STILL + light MODERATE (lit enough to not be winding down) + ambient QUIET + room PRESENT
  r="$(classify_rhythm STILL MODERATE QUIET SOLO-QUIET PRESENT)"
  [ "$r" = "BREAK|body still, ambient quiet, room present" ] || { echo "  FAIL: BREAK got=$r"; fail=1; }
  # WINDING_DOWN
  r="$(classify_rhythm STILL DARK QUIET QUIET PRESENT)"
  [ "$r" = "WINDING_DOWN|body still, dim/dark light, quiet ambient" ] || { echo "  FAIL: WINDING_DOWN got=$r"; fail=1; }
  # WALKING
  r="$(classify_rhythm WALKING MODERATE ACTIVE ENGAGED-ACTIVE PRESENT)"
  [ "$r" = "WALKING|body in motion" ] || { echo "  FAIL: WALKING got=$r"; fail=1; }
  # AWAY
  r="$(classify_rhythm STILL MODERATE ACTIVE ENGAGED-ACTIVE EMPTY)"
  [ "$r" = "AWAY|room empty, no occupant" ] || { echo "  FAIL: AWAY got=$r"; fail=1; }
  # Bracketed body tags (mesh-body-motion writes "[body-still]" — the function strips them)
  r="$(classify_rhythm '[body-still]' MODERATE ACTIVE ENGAGED-ACTIVE PRESENT)"
  [ "$r" = "DEEP_WORK|body still, lit, ambient active, room engaged (ctx=ENGAGED-ACTIVE)" ] || { echo "  FAIL: bracketed DEEP_WORK got=$r"; fail=1; }
  # 2 OFFLINE → DEGRADED
  r="$(classify_rhythm OFFLINE OFFLINE ACTIVE ENGAGED-ACTIVE PRESENT)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 2 OFFLINE should DEGRADED got=$r"; fail=1; }
  echo "$r" | grep -q 'body-motion' || { echo "  FAIL: should list body-motion in missing got=$r"; fail=1; }
  echo "$r" | grep -q 'light' || { echo "  FAIL: should list light in missing got=$r"; fail=1; }
  # 3 OFFLINE → DEGRADED
  r="$(classify_rhythm OFFLINE OFFLINE OFFLINE ENGAGED-ACTIVE PRESENT)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 3 OFFLINE should DEGRADED got=$r"; fail=1; }
  # All OFFLINE → DEGRADED
  r="$(classify_rhythm OFFLINE OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 5 OFFLINE should DEGRADED got=$r"; fail=1; }
  # 1 missing (offline file) doesn't block a confident label that doesn't need the missing input.
  # AWAY (room empty) is the most independent rule — it only needs roomsense. The other 4 inputs
  # can be OFFLINE and we still confidently assert AWAY. But 4+ OFFLINE flips to DEGRADED (the
  # safety rail — a 5th "room empty" claim isn't credible when 4 sensors are unreachable).
  r="$(classify_rhythm OFFLINE OFFLINE OFFLINE OFFLINE EMPTY)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 4 OFFLINE+roomsense=EMPTY must DEGRADED (safety rail) got=$r"; fail=1; }
  # Real 1-missing test: only body is missing, all other inputs are healthy AND signal AWAY (EMPTY)
  r="$(classify_rhythm OFFLINE MODERATE ACTIVE SOLO-QUIET EMPTY)"
  [ "$r" = "AWAY|room empty, no occupant" ] || { echo "  FAIL: 1-missing + roomsense=EMPTY should AWAY got=$r"; fail=1; }
  # AWAY overrides everything else (even with multiple inputs reachable)
  r="$(classify_rhythm WALKING LIT ACTIVE ENGAGED-ACTIVE EMPTY)"
  [ "$r" = "AWAY|room empty, no occupant" ] || { echo "  FAIL: AWAY overrides got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (15 cases: DEEP_WORK, SLEEPING, CONVERSATIONAL, LIGHT_BROWSING, BREAK, WINDING_DOWN, WALKING, AWAY, bracketed, DEGRADED×4, 1-missing-passes, AWAY-overrides)"
  # multi-field vocab-contract assert: room-sense/light/ambient enrich as LABEL|dwell_s=N|changes_24h=N.
  _mf="$(mktemp)"; printf 'PRESENT|dwell_s=120|changes_24h=5\n' > "$_mf"
  _got="$(read_label "$_mf")"; rm -f "$_mf"
  [ "$_got" = PRESENT ] || { echo "smoke-test: FAIL (read_label on LABEL|dwell_s= gave '$_got', expected PRESENT — dwell enrichment breaks label match)"; exit 1; }
  echo "smoke-test: ok (15 fusion assertions + multi-field label parse)"
  exit 0
fi

# --- Live read path ---
body="$(read_state "$MESH/.body-motion-state")"
light="$(read_label "$MESH/.light-state")"
amb="$(read_label "$MESH/.ambient-clock.state")"
roomctx="$(read_label "$MESH/.room-context.state")"
roomsense="$(read_label "$MESH/.room-sense.state")"

result="$(classify_rhythm "$body" "$light" "$amb" "$roomctx" "$roomsense")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|%s\n' "$label" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"body":"%s","light":"%s","ambient":"%s","room_context":"%s","room_sense":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$body" "$light" "$amb" "$roomctx" "$roomsense" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
  prev_label="${prev%%|*}"
  [ "$prev_label" = "$label" ] && exit 0
  printf '[rhythm-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[rhythm-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
