#!/usr/bin/env bash
# mesh-board-ledger-gate: deterministic board/ledger correlation gate.
# Checks exact [done] task-step claims against the canonical mesh-task ledger:
#   - duplicate completion keys (same task id completed 2+ times with distinct artifacts)
#   - nonterminal mismatches ([done] board claim whose ledger step is not done)
#   Live scope (default, no flag): only the last 24h of board claims are
#   checked for DUPLICATE/NONTERMINAL/UNTRACKED; MISSING-ARTIFACT is checked
#   for all claims minus the evidence-moved mirror (pre-2026-09-16 in-repo
#   task-receipts/ rows are historical, not actionable). Full-history audit:
#   MESH_BOARD_LEDGER_GATE_FULL=1.
# Usage: mesh-board-ledger-gate [--test] [--json]
set -u
CHAT_LOG="${MESH_CHAT_LOG:-${MESH_TASK_CHAT_LOG:-$HOME/.mesh/chat.log}}"
gate_check() { # <chat-log> -> verdict lines on stdout; rc 0 clean, 1 findings
  local log="$1" fails=0
  # collect [done] claims: task:<id> + artifact-sha256 + status:done
  # duplicate keys: same task id, >1 distinct artifact
  local dupes
  dupes=$(grep -oE 'task:[^ ,;]+' "$log" 2>/dev/null | grep '\[done\]' || true)
  # canonical implementation: python for exactness
  python3 - "$log" <<'PY'
import re, sys, os
from pathlib import Path
log = Path(sys.argv[1])
lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
import datetime as _dt
_full = os.environ.get("MESH_BOARD_LEDGER_GATE_FULL") == "1"
_cutoff = (_dt.datetime.now(_dt.timezone.utc) - _dt.timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
_ts_re = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)")
done_re = re.compile(r'\[done\]\s+(\S+):.*task:(\S+),.*status:(\S+)')
art_re = re.compile(r'artifact=(\S+)')
claims = {}  # task -> list of (line, artifact, status)
recent = set()  # tasks with >=1 claim inside the live window
for n, l in enumerate(lines, 1):
    m = done_re.search(l)
    if not m:
        continue
    body = l.split("::", 1)[-1] if "::" in l else l
    if "[task-ledger]" in body or "[task-state]" in body:
        continue
    task = m.group(2).rstrip(",;")
    status = m.group(3).rstrip(",;")
    a = art_re.search(l)
    art = a.group(1).rstrip(",;") if a else ""
    claims.setdefault(task, []).append((n, art, status))
    _tm = _ts_re.match(l)
    if _full or (_tm and _tm.group(1) >= _cutoff):
        recent.add(task)
live = {t: r for t, r in claims.items() if t in recent}
findings = []
for task, rows in sorted(live.items()):
    arts = {r[1] for r in rows if r[1]}
    if len(rows) > 1 and len(arts) > 1:
        findings.append(f"DUPLICATE-COMPLETION task={task} claims={len(rows)} artifacts={len(arts)} lines={[r[0] for r in rows]}")
    for (n, art, status) in rows:
        if art and not Path(os.path.expanduser(os.path.expandvars(art))).exists():
            # resolve node-local evidence mirror like mesh-task does
            alt = None
            for marker, root in (("/docs/task-receipts/", "evidence/receipts"), ("/docs/chat-range-reviews/", "evidence/chat-range-reviews"), ("docs/task-receipts/", "evidence/receipts"), ("/task-receipts/", "evidence/receipts"), ("task-receipts/", "evidence/receipts")):
                if marker in art:
                    cand = Path.home() / ".mesh" / root / art.split(marker)[-1]
                    if cand.exists():
                        alt = cand
                        break
            # historical in-repo rows (pre evidence-moved 2026-09-16) are not actionable
            if alt is None and ("/task-receipts/" in art or "task-receipts/" in art):
                continue
            if alt is None:
                findings.append(f"MISSING-ARTIFACT task={task} line={n} artifact={art}")
# nonterminal mismatches need the canonical ledger: query mesh-task replay
def check_ledger(claims):
    import json, subprocess
    try:
        r = subprocess.run(["mesh-task", "replay", "--json"], capture_output=True, text=True, timeout=60)
    except Exception as e:
        return [f"GATE-ERROR replay unavailable: {e}"]
    if r.returncode != 0 or not r.stdout.strip():
        return [f"GATE-ERROR replay rc={r.returncode}"]
    recs = {}
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            recs.update(json.loads(line))
        except Exception:
            continue
    steps = {}
    for rec in recs.values():
        d = rec.get("data", {}) if isinstance(rec, dict) else {}
        for s in d.get("steps", []) or []:
            if isinstance(s, dict) and s.get("id"):
                steps[s["id"]] = s
    out = []
    for task, rows in sorted(claims.items()):
        s = steps.get(task)
        if s is not None and s.get("status") != "done":
            out.append(f"NONTERMINAL-MISMATCH task={task} ledger={s.get('status')} claims={len(rows)}")
        if s is None:
            out.append(f"UNTRACKED-CLAIM task={task} claims={len(rows)}")
    return out
import os as _os
if _os.environ.get("MESH_TASK_REPLAY_STUB") != "1":
    findings.extend(check_ledger(claims))
for f in findings:
    print(f)
sys.exit(1 if findings else 0)
PY
}
if [ "${1:-}" = "--test" ]; then
  T=$(mktemp -d) || exit 1
  # FRESH timestamps: the live scope only checks the last 24h, so hardcoded
  # fixture dates time-rot out of the window and the red leg goes vacuously
  # green (duplicate never in `live`). Generate at test time.
  TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # RED fixture: duplicate keys + missing artifact + untracked claim
  cat > "$T/chat.log" <<EOF
${TS}  genome@mesh-home  ::  [done] demo/build: artifact=/nonexistent-evidence-x.md — ok task:demo/build, owner:genome, artifact-sha256:aaa, status:done
${TS}  genome@mesh-home  ::  [done] demo/build: artifact=/nonexistent-evidence-y.md — ok task:demo/build, owner:genome, artifact-sha256:bbb, status:done
${TS}  genome@mesh-home  ::  [done] ghost/step: artifact=/nonexistent-ghost.md — ok task:ghost/step, owner:genome, artifact-sha256:ccc, status:done
EOF
  out=$(gate_check "$T/chat.log" 2>&1); rc=$?
  [ $rc -ne 0 ] || { echo "FAIL: red fixture passed clean"; rm -rf "$T"; exit 1; }
  echo "$out" | grep -q "DUPLICATE-COMPLETION task=demo/build" || { echo "FAIL: duplicate not flagged"; echo "$out"; rm -rf "$T"; exit 1; }
  echo "$out" | grep -q "MISSING-ARTIFACT task=demo/build" || { echo "FAIL: missing artifact not flagged"; echo "$out"; rm -rf "$T"; exit 1; }
  echo "evidence" > "$T/real.md"
  cat > "$T/chat2.log" <<EOF
${TS}  genome@mesh-home  ::  [done] demo/build: artifact=$T/real.md — ok task:demo/build, owner:genome, artifact-sha256:aaa, status:done
EOF
  out2=$(MESH_TASK_REPLAY_STUB=1 gate_check "$T/chat2.log" 2>&1 | grep -v "UNTRACKED-CLAIM\|NONTERMINAL\|GATE-ERROR") || true
  echo "$out2" | grep -q "DUPLICATE-COMPLETION\|MISSING-ARTIFACT" && { echo "FAIL: green fixture flagged"; echo "$out2"; rm -rf "$T"; exit 1; }
  rm -rf "$T"
  echo "mesh-board-ledger-gate --test: PASS (red flags dup+missing, green clean)"
  exit 0
fi
if [ "${1:-}" = "--json" ]; then
  out=$(gate_check "$CHAT_LOG" 2>&1); rc=$?
  python3 -c "import json,sys; print(json.dumps({'rc': $rc, 'findings': '''$out'''.splitlines()}))"
  exit $rc
fi
gate_check "$CHAT_LOG"
