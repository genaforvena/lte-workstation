#!/usr/bin/env bash
# test-chaos-drill — CHAOS ENGINEERING DRILL
#
# Two drills:
#   1. Kill a supervised loop → verify mesh-supervise restarts it
#   2. Partition a node via SSH blackhole → verify detection + indirect-probe path
#
# Run: ./scripts/test-chaos-drill
# Requires: mesh-supervise, mesh-mind-watch, SSH to localhost
#
# Touches real state (~/.ssh/config, mind-beat.ts) — every mutation is backed up and
# restored by trap + a detached dead-man guard (fires even if the drill is kill -9'd),
# and the alarm path runs under MESH_ALERT_DRYRUN so no fabricated DOWN/RECOVER ever
# reaches the board or the operator.
set -uo pipefail
FAILS=0
PASSES=0
MW="$HOME/.local/bin/mesh-mind-watch"
MW_LOG="$HOME/.mesh/mind-watch.log"
STATE_DIR="$HOME/.mesh/.mind-watch-state"
BEAT="$HOME/.mesh/mind-beat.ts"
SSHCFG="$HOME/.ssh/config"
BAK="$HOME/.mesh/.chaos-drill-bak.$$"
MARK_BEGIN="# BEGIN chaos-drill partition"
MARK_END="# END chaos-drill partition"

pass(){ PASSES=$((PASSES+1)); echo "  PASS: $1"; }
fail(){ FAILS=$((FAILS+1)); echo "  FAIL: $1"; }
info(){ echo "  INFO: $1"; }

# ── restore safety: backups + trap + detached dead-man guard ──
mkdir -p "$BAK"
cp -p "$BEAT" "$BAK/mind-beat.ts" 2>/dev/null || true
restore(){
  sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" "$SSHCFG" 2>/dev/null || true
  [ -f "$BAK/mind-beat.ts" ] && cp -p "$BAK/mind-beat.ts" "$BEAT" 2>/dev/null
  rm -rf "$BAK"
}
trap restore EXIT INT TERM
# dead-man guard: a separate process survives kill -9 of the drill itself; no-op once
# restore() has cleaned up ($BAK gone). Removes the partition block, restores the beat.
( sleep 180
  [ -d "$BAK" ] || exit 0
  sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" "$SSHCFG" 2>/dev/null || true
  [ -f "$BAK/mind-beat.ts" ] && cp -p "$BAK/mind-beat.ts" "$BEAT" 2>/dev/null
  rm -rf "$BAK"
) >/dev/null 2>&1 &
disown 2>/dev/null || true

echo "=== CHAOS DRILL $(date -u +%FT%TZ) ==="
echo ""

# ── Drill 1: Kill supervised loop ──
echo "═══ DRILL 1: Kill supervised loop ═══"
TARGET="mesh-presence"
PID=$(pgrep -u "$(whoami)" -f "mesh-presence --loop" | head -1)
if [ -z "$PID" ]; then
  fail "$TARGET not running"
else
  kill -9 "$PID" 2>/dev/null; sleep 1
  # never rm .supervise.lock: flock holds the inode, removing the file just lets a second
  # supervisor race the cron one. If a pass is in flight we lose the lock and retry.
  for _try in 1 2 3; do
    mesh-supervise >/dev/null 2>&1; sleep 2
    pgrep -u "$(whoami)" -f "mesh-presence --loop" >/dev/null 2>&1 && break
  done
  if pgrep -u "$(whoami)" -f "mesh-presence --loop" >/dev/null 2>&1; then
    pass "$TARGET restarted by supervise"
  else
    fail "$TARGET did not restart"
  fi
  if tail -3 "$HOME/.mesh/supervise.log" 2>/dev/null | grep -q "RESTART.*$TARGET"; then
    pass "supervise.log shows RESTART entry"
  else
    info "supervise.log: $(tail -3 "$HOME/.mesh/supervise.log" 2>/dev/null)"
  fi
fi
echo ""

# ── Drill 2: Partition + indirect-probe ──
echo "═══ DRILL 2: Partition + indirect-probe ═══"

# 2a: SSH-level partition (marker-delimited Match block; removed by marker range, not
# line counting — and restored by trap/guard if the drill dies mid-partition)
TARGET_LABEL="${MESH_CHAOS_TARGET_LABEL:-default-string}"
TARGET_USER="${MESH_CHAOS_TARGET_USER:-${MESH_PEER_USER:-imozerov}}"
TARGET_IP="$(mesh-peer-addr "$TARGET_LABEL" 2>/dev/null || true)"
if [ -z "$TARGET_IP" ]; then
  fail "Partition: could not resolve target label '$TARGET_LABEL'"
else
  TARGET_NODE="$TARGET_USER@$TARGET_IP"
  {
    printf '%s\n' "$MARK_BEGIN"
    printf 'Match host=%s\n  ProxyCommand /bin/false\n' "$TARGET_IP"
    printf '%s\n' "$MARK_END"
  } >> "$SSHCFG"
  sleep 1
  if ssh -o BatchMode=yes -o ConnectTimeout=3 "$TARGET_NODE" "echo OK" 2>/dev/null; then
    fail "Partition: SSH still reaches $TARGET_NODE"
  else
    pass "Partition: SSH to $TARGET_NODE blocked (exit=$?)"
  fi
  sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" "$SSHCFG"
  sleep 2
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$TARGET_NODE" "echo OK" 2>/dev/null; then
    pass "Partition: connectivity restored"
  else
    fail "Partition: connectivity NOT restored"
  fi
fi

# 2b: Indirect-probe code path (ALERT on stale beat via coldstart phi).
# MESH_ALERT_DRYRUN keeps the fabricated DOWN/RECOVER off the board/operator; the
# log line the drill checks is written regardless of the gate.
rm -f "$STATE_DIR/$(hostname).state" "$STATE_DIR/$(hostname).phi"
echo "2000-01-01T00:00:00Z" > "$BEAT"
MESH_MIND_MAXAGE=30 MESH_CONFIRM_NODE="" MESH_ALERT_DRYRUN=1 "$MW" --node "$(whoami)@127.0.0.1" 2>/dev/null
if tail -1 "$MW_LOG" 2>/dev/null | grep -q "ALERT.*DOWN"; then
  pass "Indirect-probe: ALERT on stale beat (coldstart phi)"
else
  fail "Indirect-probe: no ALERT on stale beat"
fi
if [ "$(cat "$STATE_DIR/$(hostname).state" 2>/dev/null)" = "DOWN" ]; then
  pass "Indirect-probe: state set to DOWN"
else
  fail "Indirect-probe: state not DOWN"
fi
# Restore the REAL beat (not a fabricated fresh stamp) and recompute state at the
# production threshold, still dry-run — if the beat is genuinely stale the real cron
# watcher is the one that should say so.
[ -f "$BAK/mind-beat.ts" ] && cp -p "$BAK/mind-beat.ts" "$BEAT" || date -u +%FT%TZ > "$BEAT"
MESH_CONFIRM_NODE="" MESH_ALERT_DRYRUN=1 "$MW" --node "$(whoami)@127.0.0.1" 2>/dev/null
echo ""

echo "=== RESULTS ==="
echo "PASS: $PASSES  FAIL: $FAILS"
[ "$FAILS" -gt 0 ] && exit 1 || exit 0
