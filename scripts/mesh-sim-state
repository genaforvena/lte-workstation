#!/usr/bin/env bash
# mesh-sim-state — the phone BODY's CELLULAR NETWORK STATE sense: SIM readiness, home-vs-roaming,
# and cellular data connectivity via termux-telephony-deviceinfo over SSH.
#
# WHY this is a NEW, distinct signal: mesh-cell-info/mesh-cell-signal read the SERVING CELL TOWER
# (which mast the radio is camped on, RSRP/RSRQ) — a radio-layer reading. Nothing in the mesh reads
# termux-telephony-deviceinfo, which is a SUBSCRIBER-layer reading: is there a working SIM at all
# (sim_state), is the phone on its home carrier or ROAMING (network_roaming — a travel/location cue
# that works indoors with zero GPS fix, unlike mesh-location), and is cellular DATA actually up
# (data_state — distinct from the WiFi link mesh-wifi-link reports; the phone's beacon/SMS/relay
# organs ride whichever of WiFi or cellular data is actually connected, and nothing currently says
# which). A SIM ejected, a roaming leg abroad, or cellular data silently dropped are all real
# hardware/carrier events this sense could perceive and did not.
#
#   mesh-sim-state              one-line verdict (default; cached-free, always a fresh SSH read)
#   mesh-sim-state --status     alias for the default
#   mesh-sim-state --json       machine-readable JSON
#   mesh-sim-state --test       smoke test (offline classify fixtures + a real-read gate)
#
# Verdicts (vocab is a contract — consumers grep these tokens):
#   HOME         sim ready, not roaming, cellular data CONNECTED
#   NO-DATA      sim ready, not roaming, cellular data NOT connected (home carrier, no data path)
#   ROAMING      sim ready, network_roaming=true (data may or may not be up — travel signal itself)
#   NO-SIM       sim_state != READY (absent / locked / not-ready — no working subscriber identity)
#   UNKNOWN      deviceinfo read succeeded but a required field was missing/unparseable
#
# Honest contract: phone unreachable (no network path, SSH fails, or empty/unparseable JSON) ->
# UNREACHABLE, exit 2 — never a fabricated HOME/NO-SIM. This mirrors mesh-cell-info/mesh-tamper's
# OFFLINE-sentinel convention so downstream fusion can tell "read failed" from "read succeeded and
# says no SIM/no data".
#
# reflex-cadence: 12,27,42,57 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.sim-state"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"

# classify_sim_state <sim_state> <network_roaming> <data_state> — PURE, offline-testable.
# Priority: no working SIM first, then roaming (a travel event outranks a data hiccup), then data
# connectivity, else HOME. Echoes "VERDICT|reason".
classify_sim_state(){
  local sim="$1" roam="$2" data="$3"
  # CASE-FOLD BEFORE COMPARING. termux-telephony-deviceinfo emits LOWERCASE on this fleet
  # ('ready', 'disconnected' — measured off the Redmi 2026-08-30), and comparing it against the
  # uppercase literals classified every healthy SIM as NO-SIM. The `roam` leg already folded
  # (`[Tt]rue`), which is why only these two were wrong. The reason strings keep the device's
  # RAW value, so a reader can grep the device's own output for what we quote.
  local simU dataU
  simU="$(printf '%s' "$sim" | tr '[:lower:]' '[:upper:]')"
  dataU="$(printf '%s' "$data" | tr '[:lower:]' '[:upper:]')"
  case "$simU" in ""|NONE|NULL)
    echo "UNKNOWN|sim_state missing from read"; return 0;;
  esac
  if [ "$simU" != "READY" ]; then
    echo "NO-SIM|sim_state=$sim"; return 0
  fi
  case "$roam" in
    [Tt]rue|TRUE)
      echo "ROAMING|network_roaming=true data_state=${data:-?}"; return 0;;
  esac
  case "$dataU" in ""|NONE|NULL)
    echo "UNKNOWN|data_state missing from read"; return 0;;
  esac
  if [ "$dataU" != "CONNECTED" ]; then
    echo "NO-DATA|data_state=$data (home network)"; return 0
  fi
  echo "HOME|data_state=CONNECTED (home network)"; return 0
}

DEVICEINFO_PARSE_PY='
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("parse-error"); sys.exit(1)
if not isinstance(d, dict):
    print("parse-error"); sys.exit(1)
sim = d.get("sim_state")
roam = d.get("network_roaming")
data = d.get("data_state")
op = d.get("network_operator_name") or d.get("sim_operator_name")
print(json.dumps({"sim_state": sim, "network_roaming": roam, "data_state": data, "operator": op}))
'

if [ "${1:-}" = "--test" ]; then
  for x in ssh python3 mesh-phone-ip; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  _f=0
  r="$(classify_sim_state READY false CONNECTED)"
  [ "$r" = "HOME|data_state=CONNECTED (home network)" ] || { echo "  FAIL HOME: got=$r"; _f=1; }
  r="$(classify_sim_state READY false DISCONNECTED)"
  case "$r" in NO-DATA\|*) ;; *) echo "  FAIL NO-DATA: got=$r"; _f=1;; esac
  r="$(classify_sim_state READY true CONNECTED)"
  case "$r" in ROAMING\|*) ;; *) echo "  FAIL ROAMING(data up): got=$r"; _f=1;; esac
  r="$(classify_sim_state READY true DISCONNECTED)"
  case "$r" in ROAMING\|*) ;; *) echo "  FAIL ROAMING(data down): got=$r"; _f=1;; esac
  r="$(classify_sim_state ABSENT false CONNECTED)"
  case "$r" in NO-SIM\|*) ;; *) echo "  FAIL NO-SIM absent: got=$r"; _f=1;; esac
  r="$(classify_sim_state PIN_REQUIRED false "")"
  case "$r" in NO-SIM\|*) ;; *) echo "  FAIL NO-SIM pin: got=$r"; _f=1;; esac
  r="$(classify_sim_state "" false CONNECTED)"
  case "$r" in UNKNOWN\|*) ;; *) echo "  FAIL UNKNOWN missing-sim: got=$r"; _f=1;; esac
  r="$(classify_sim_state READY false "")"
  case "$r" in UNKNOWN\|*) ;; *) echo "  FAIL UNKNOWN missing-data: got=$r"; _f=1;; esac
  # NO-SIM must outrank ROAMING even if roaming happens to read true on a bad SIM
  r="$(classify_sim_state NOT_READY true CONNECTED)"
  case "$r" in NO-SIM\|*) ;; *) echo "  FAIL priority NO-SIM>ROAMING: got=$r"; _f=1;; esac
  # DEVICE CASING ARMS. termux-telephony-deviceinfo emits LOWERCASE ('ready',
  # 'disconnected'); every arm above feeds the code's own UPPERCASE, so the offline gate was
  # green by construction while the live phone classified NO-SIM on a healthy SIM. These arms
  # feed the string the DEVICE actually produces — measured off the Redmi 2026-08-30.
  r="$(classify_sim_state ready false connected)"
  [ "$r" = "HOME|data_state=CONNECTED (home network)" ] || { echo "  FAIL device-case HOME: got=$r"; _f=1; }
  r="$(classify_sim_state ready false disconnected)"
  case "$r" in NO-DATA\|*) ;; *) echo "  FAIL device-case NO-DATA: got=$r"; _f=1;; esac
  r="$(classify_sim_state ready true connected)"
  case "$r" in ROAMING\|*) ;; *) echo "  FAIL device-case ROAMING: got=$r"; _f=1;; esac
  r="$(classify_sim_state absent false connected)"
  case "$r" in NO-SIM\|*) ;; *) echo "  FAIL device-case NO-SIM absent: got=$r"; _f=1;; esac
  # the reason string must quote the device's RAW value, never the folded one a reader would
  # then search the device's own output for in vain
  r="$(classify_sim_state absent false connected)"
  case "$r" in *sim_state=absent*) ;; *) echo "  FAIL raw value in reason: got=$r"; _f=1;; esac
  # deviceinfo JSON parse dry-run (no phone)
  fix='{"sim_state":"READY","network_roaming":false,"data_state":"CONNECTED","network_operator_name":"MegaFon"}'
  got="$(printf '%s' "$fix" | python3 -c "$DEVICEINFO_PARSE_PY" 2>/dev/null)"
  printf '%s' "$got" | grep -q '"sim_state": "READY"' || { echo "  FAIL deviceinfo parse: got=$got"; _f=1; }
  none="$(printf 'not-json' | python3 -c "$DEVICEINFO_PARSE_PY" 2>/dev/null)"
  [ "$none" = "parse-error" ] || { echo "  FAIL parse-error on garbage input, got=$none"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_sim_state / deviceinfo-parse contract)"; exit 1; }
  # REAL-READ GATE (verification principle: a real hardware/carrier read, not just the offline
  # classifier — the mesh-mag/mesh-gyro precedent). Unreachable phone = honest n/a, exit 2.
  _mpip="$(mesh-phone-ip 2>/dev/null)"
  if [ -n "$_mpip" ]; then
    _live="$(timeout 15 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER}@$_mpip" \
      "timeout 10 termux-telephony-deviceinfo" </dev/null 2>/dev/null)"
    _parsed="$(printf '%s' "$_live" | python3 -c "$DEVICEINFO_PARSE_PY" 2>/dev/null)"
    if [ -z "$_parsed" ] || [ "$_parsed" = "parse-error" ]; then
      echo "smoke-test: n/a (phone resolved but termux-telephony-deviceinfo unreadable — sense not producing; classify-logic ok)"; exit 2
    fi
    # THE ARM THAT WOULD HAVE CAUGHT THE CASE BUG. Asserting the live read PARSED is not
    # asserting the sense is right: for as long as this tool existed the parse arm was green
    # while the classifier answered NO-SIM to a phone reporting sim_state=ready. Drive the live
    # read THROUGH the classifier and refuse a verdict that contradicts its own evidence.
    _lsim="$(printf '%s' "$_parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("sim_state") or "")')"
    _lroam="$(printf '%s' "$_parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("network_roaming"))')"
    _ldata="$(printf '%s' "$_parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("data_state") or "")')"
    _lv="$(classify_sim_state "$_lsim" "$_lroam" "$_ldata")"
    _lsimU="$(printf '%s' "$_lsim" | tr '[:lower:]' '[:upper:]')"
    if [ "$_lsimU" = "READY" ]; then
      case "$_lv" in
        NO-SIM\|*) echo "smoke-test: FAIL (live sim_state=$_lsim but verdict $_lv — the verdict contradicts its own evidence)"; exit 1;;
      esac
    fi
    echo "smoke-test: ok (deps + classify_sim_state + deviceinfo parse + REAL read: $_parsed -> $_lv)"; exit 0
  fi
  echo "smoke-test: ok (deps + classify_sim_state + deviceinfo parse (phone unreachable, real-read gate skipped))"; exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)"
if [ -z "$pip" ]; then
  echo "sim-state: UNREACHABLE — phone has no network path" >&2
  printf 'UNREACHABLE|%s|-|-|-\n' "$(date -u +%s)" > "$STATE"
  mesh-state-touch "$STATE"
  exit 2
fi

json="$(timeout 15 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@$pip" \
  "timeout 10 termux-telephony-deviceinfo" </dev/null 2>/dev/null)"

parsed=""
[ -n "$json" ] && parsed="$(printf '%s' "$json" | python3 -c "$DEVICEINFO_PARSE_PY" 2>/dev/null)"

if [ -z "$parsed" ] || [ "$parsed" = "parse-error" ]; then
  echo "sim-state: UNREACHABLE — no/unparseable termux-telephony-deviceinfo read" >&2
  printf 'UNREACHABLE|%s|-|-|-\n' "$(date -u +%s)" > "$STATE"
  mesh-state-touch "$STATE"
  exit 2
fi

sim="$(printf '%s' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("sim_state") or "")')"
roam="$(printf '%s' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("network_roaming"))')"
data="$(printf '%s' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("data_state") or "")')"
op="$(printf '%s' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("operator") or "")')"

verdict_line="$(classify_sim_state "$sim" "$roam" "$data")"
verdict="${verdict_line%%|*}"
reason="${verdict_line#*|}"

# STATE is written unconditionally every run (not change-gated) — mtime always reflects a live SSH
# attempt; mesh-state-touch called too, per convention, so a future change-gated refactor stays safe.
printf '%s|%s|%s|%s|%s\n' "$verdict" "$(date -u +%s)" "$sim" "$roam" "$data" > "$STATE"
mesh-state-touch "$STATE"

if [ "${1:-}" = "--json" ]; then
  op_json="null"; [ -n "$op" ] && op_json="\"$op\""
  printf '{"verdict":"%s","reason":"%s","sim_state":"%s","network_roaming":%s,"data_state":"%s","operator":%s,"ts":"%s"}\n' \
    "$verdict" "$reason" "$sim" "${roam:-null}" "$data" "$op_json" "$(date -u +%FT%TZ)"
  exit 0
fi

printf 'sim-state: %s — %s%s\n' "$verdict" "$reason" "${op:+ (operator=$op)}"
