#!/usr/bin/env python3
# orphan-ok: verification helper pulled by the scheduled mesh-task-unblock-sweep reflex, never itself scheduled.
"""Verify that task recovery leaves real self-pick work for idle mesh minds.

Called by the scheduled mesh-task-unblock-sweep reflex after it materializes missing
resolvers. Rebuilds the task journal from chat.log, reads the canonical audit and
dispatch queue, and verifies exact-owner dispatch checks. When ownerless work exists,
it checks that every idle mind sees and can claim it. It observes and reports; it
never assigns a mind's choice or claims work itself.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

from mesh_task_log import eligibility as task_eligibility

HOME = Path.home()
MESH = Path(os.environ.get("MESH_DIR", str(HOME / ".mesh"))).expanduser()
JOURNAL = Path(os.environ.get("MESH_WITNESS_TASK_JOURNAL", str(MESH / "tasks.journal"))).expanduser()
TAPE = Path(os.environ.get("MESH_WITNESS_AUTONOMY_TAPE", str(MESH / "witness-task-autonomy.log"))).expanduser()
STATE = Path(os.environ.get("MESH_WITNESS_AUTONOMY_STATE", str(MESH / ".witness-task-autonomy.json"))).expanduser()
FOLLOWTHROUGH = Path(os.environ.get(
    "MESH_WITNESS_AUTONOMY_FOLLOWTHROUGH", str(MESH / "task-followthrough.tsv"))).expanduser()
TASK = os.environ.get("MESH_WITNESS_AUTONOMY_TASK", "mesh-task")
JOURNAL_CMD = os.environ.get("MESH_WITNESS_AUTONOMY_JOURNAL_CMD", "mesh-task-journal")
MIND_STATE = os.environ.get("MESH_WITNESS_AUTONOMY_MIND_STATE", "mesh-mind-state")
CHAT = os.environ.get("MESH_WITNESS_AUTONOMY_CHAT", "mesh-chat")
TELL = os.environ.get("MESH_WITNESS_AUTONOMY_TELL", "mesh-tell")
ALERT_SECONDS = int(os.environ.get("MESH_WITNESS_AUTONOMY_ALERT_SECONDS", "1800"))
ACTIVE_STALL_SECONDS = int(os.environ.get("MESH_WITNESS_AUTONOMY_ACTIVE_STALL_SECONDS", "1800"))
LOCK = Path(os.environ.get("MESH_WITNESS_AUTONOMY_LOCK", str(MESH / "witness-task-autonomy.lock"))).expanduser()

LOCK_HOLDER: object = None


def acquire_singleflight():
    """Non-blocking single-flight guard, mirroring mesh-task-journal's flock skip.

    Overlapping --once invocations skip loudly (rc 0) instead of stacking
    competing runs against the same journal/state files.
    """
    global LOCK_HOLDER
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    handle = open(LOCK, "a+b")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    LOCK_HOLDER = handle
    return handle


def command(argv: list[str], timeout: int = 60) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(argv, text=True, capture_output=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"probe timed out after {timeout}s")
    except OSError as exc:
        return subprocess.CompletedProcess(argv, 127, "", str(exc))


def queue_rows(raw: str, label: str) -> list[tuple[str, str]]:
    rows = []
    seen = set()
    for line_number, line in enumerate(raw.splitlines(), 1):
        if not line:
            continue
        fields = line.split("\t")
        if (len(fields) < 3 or not fields[0] or not fields[1]
                or not re.fullmatch(r"-?\d+", fields[2])):
            raise ValueError(f"{label} row {line_number} is malformed")
        pair = (fields[0], fields[1])
        if pair in seen:
            raise ValueError(f"{label} row {line_number} duplicates {fields[0]}/{fields[1]}")
        seen.add(pair)
        rows.append(pair)
    return rows


def owner_key(owner: str) -> str:
    return owner.rsplit("/", 1)[-1] if owner else ""


def audit_index(raw: str) -> dict[str, tuple[str, str, list[str]]]:
    rows = {}
    states = {"DONE", "REJECTED", "IGNORED", "HELD_REJECTED", "HELD_EXPIRED",
              "OPEN_UNOWNED", "QUEUED", "BLOCKED", "READY_INDEPENDENT", "RUNNING", "OVERDUE"}
    for line_number, line in enumerate(raw.splitlines(), 1):
        if not line:
            continue
        fields = line.split("\t")
        if len(fields) < 3 or not fields[0] or not fields[1] or not fields[2]:
            raise ValueError(f"audit row {line_number} is malformed")
        if fields[0] not in states:
            raise ValueError(f"audit row {line_number} has unknown state {fields[0]!r}")
        if fields[2] in rows:
            raise ValueError(f"audit row {line_number} duplicates task {fields[2]}")
        rows[fields[2]] = (fields[0], fields[1], fields[3:])
    return rows


def idle_minds(raw: str) -> list[str]:
    result = []
    for line in raw.splitlines():
        fields = re.split(r"\s{2,}|\t", line.strip())
        if len(fields) >= 2 and fields[0] not in ("WINDOW", "bash", "shell", "sh", "reflex") \
                and fields[1].upper() == "IDLE":
            result.append(fields[0])
    return sorted(set(result))


def live_windows(raw: str) -> set[str]:
    """Every mind window the mesh can see, in any state.

    An owner with no live window has no hands: no idle mind can take its
    exact-owner work, so its queue rows are unroutable, never dispatchable.
    """
    result = set()
    for line in raw.splitlines():
        fields = re.split(r"\s{2,}|\t", line.strip())
        if len(fields) >= 2 and fields[0] not in ("WINDOW", "bash", "shell", "sh", "reflex"):
            result.add(fields[0])
    return result


def source_ok() -> bool:
    try:
        head = JOURNAL.read_text(encoding="utf-8").splitlines()[:4]
    except OSError:
        return False
    fields = " ".join(head)
    return "task_source=PASS" in fields and bool(re.search(r"\bsource_errors=0\b", fields))


def load_state() -> dict:
    try:
        value = json.loads(STATE.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(value: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_name(STATE.name + f".tmp.{os.getpid()}")
    temporary.write_text(json.dumps(value, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temporary, STATE)


def step_index(raw: str) -> dict[str, dict]:
    """Index canonical task steps without treating a malformed snapshot as empty evidence."""
    records = json.loads(raw)
    if not isinstance(records, dict):
        raise ValueError("task replay is not an object")
    result: dict[str, dict] = {}
    for record in records.values():
        data = record.get("data", {}) if isinstance(record, dict) else {}
        for step in data.get("steps", []) if isinstance(data, dict) else []:
            if isinstance(step, dict) and isinstance(step.get("id"), str):
                result[step["id"]] = step
    return result


def canonical_steps(raw: str) -> tuple[dict, dict[str, tuple[dict, int, dict]]]:
    """Validate a fresh mesh-task replay and retain each step's chain context."""
    records = json.loads(raw)
    if not isinstance(records, dict):
        raise ValueError("task replay is not an object")
    result: dict[str, tuple[dict, int, dict]] = {}
    for chain, record in records.items():
        if not isinstance(record, dict) or not isinstance(record.get("data"), dict):
            raise ValueError(f"task replay record {chain!r} is malformed")
        data = record["data"]
        steps = data.get("steps")
        current = data.get("current")
        if (data.get("chain") != chain or not isinstance(data.get("status"), str)
                or not isinstance(steps, list) or not steps or type(current) is not int
                or not 0 <= current < len(steps)):
            raise ValueError(f"task replay chain {chain!r} is malformed")
        for index, step in enumerate(steps):
            if (not isinstance(step, dict) or not isinstance(step.get("id"), str)
                    or not step["id"] or not isinstance(step.get("status"), str)
                    or (step.get("owner") is not None and not isinstance(step.get("owner"), str))):
                raise ValueError(f"task replay step {chain}/{index} is malformed")
            if step["id"] in result:
                raise ValueError(f"task replay duplicates task {step['id']}")
            result[step["id"]] = (data, index, step)
    return records, result


def reconcile_refused_check(task_id: str, owner: str) -> tuple[bool, dict[str, tuple[str, str]], str]:
    """Accept check code 2 only when fresh canonical state explains lost eligibility."""
    reads = (
        ("audit", [TASK, "audit"]),
        ("replay", [TASK, "replay", "--json"]),
        ("global-queue", [TASK, "queue", "--dispatch"]),
        ("owner-queue", [TASK, "queue", "--dispatch", "--owner", owner]),
    )
    outputs = {}
    for name, argv in reads:
        result = command(argv, 60)
        if result.returncode:
            return False, {}, f"{name}-rc-{result.returncode}"
        outputs[name] = result.stdout
    try:
        records, steps = canonical_steps(outputs["replay"])
    except (ValueError, TypeError, KeyError):
        return False, {}, "replay-parse"
    try:
        audit = audit_index(outputs["audit"])
    except (ValueError, TypeError, KeyError):
        return False, {}, "audit-parse"
    try:
        global_queue = queue_rows(outputs["global-queue"], "reconcile-global-queue")
        owner_queue = queue_rows(outputs["owner-queue"], "reconcile-owner-queue")
    except (ValueError, TypeError, KeyError):
        return False, {}, "queue-parse"

    entry = steps.get(task_id)
    if entry is None:
        return False, {}, "task-missing-from-replay"
    data, index, step = entry
    audit_row = audit.get(task_id)
    if audit_row is None:
        return False, {}, "task-missing-from-audit"
    audit_state, audit_owner, audit_details = audit_row
    canonical_owner = step.get("owner") or "-"
    # OPEN_UNOWNED is un-owned by definition: the audit row carries "-" regardless of
    # any stale owner field lingering on the open replay step, so there is nothing to
    # contradict. Only a claimed/running row must agree with the replay step.
    if audit_state != "OPEN_UNOWNED" and owner_key(audit_owner) != owner_key(canonical_owner):
        return False, {}, "audit-owner-contradicts-replay"
    owner_id = owner_key(owner)
    if any(task == task_id and owner_key(row_owner) in ("-", owner_id)
           for row_owner, task in owner_queue):
        return False, {}, "still-in-owner-queue"
    if any(task == task_id and row_owner != "-" and owner_key(row_owner) == owner_id
           for row_owner, task in global_queue):
        return False, {}, "still-in-global-queue"

    try:
        verdict = task_eligibility(records, task_id, "dispatch", owner)
    except (ValueError, TypeError, KeyError, IndexError):
        return False, {}, "replay-eligibility-parse"
    if verdict not in (0, 2):
        return False, {}, "task-untracked-after-refusal"

    current_running: dict[str, tuple[str, str]] = {}
    for current_id, (state, active_owner, details) in audit.items():
        if state not in ("RUNNING", "OVERDUE"):
            continue
        if not stalled_detector_eligible(current_id):
            continue
        current_entry = steps.get(current_id)
        if current_entry is None:
            return False, {}, "audit-running-task-missing-from-replay"
        current_step = current_entry[2]
        if (current_step.get("status") not in ("active", "claimed", "running")
                or owner_key(current_step.get("owner") or "-") != owner_key(active_owner)):
            return False, {}, "audit-running-task-contradicts-replay"
        lease = next((field[6:] for field in details if field.startswith("lease=")), "")
        if not lease:
            return False, {}, "audit-running-lease-missing"
        current_running[current_id] = (active_owner, lease)

    status = step["status"]
    active_states = ("active", "claimed", "running")
    expected_audit = {
        "done": {"DONE"}, "rejected": {"REJECTED"}, "ignored": {"IGNORED"},
        "blocked": {"BLOCKED"},
    }
    if status in active_states:
        if audit_state not in ("RUNNING", "OVERDUE") or task_id not in current_running:
            return False, {}, "active-task-audit-contradiction"
    elif status in expected_audit:
        if audit_state not in expected_audit[status]:
            return False, {}, "task-audit-contradiction"
    elif status == "open":
        if audit_state in ("RUNNING", "OVERDUE", "DONE", "REJECTED", "IGNORED"):
            return False, {}, "open-task-audit-contradiction"
        if verdict == 2 and owner_key(canonical_owner) == owner_id \
                and audit_state in ("OPEN_UNOWNED", "READY_INDEPENDENT"):
            return False, {}, "open-task-still-appears-eligible"
    else:
        return False, {}, "unknown-task-status"

    active_for_owner = [current_id for current_id, (_, _, current_step) in steps.items()
                        if owner_key(current_step.get("owner") or "") == owner_id
                        and current_step.get("status") in ("active", "claimed")]
    if verdict == 0 and not active_for_owner:
        return False, {}, "check-refusal-still-eligible"
    if any(current_id not in current_running for current_id in active_for_owner):
        return False, {}, "active-owner-audit-contradiction"
    return True, current_running, "eligibility-changed"


def task_age(step: dict, now: int) -> str:
    for key in ("last_progress", "blocked", "rejected", "started", "queued_at", "dispatched_at"):
        stamp = step.get(key)
        if not isinstance(stamp, str):
            continue
        try:
            epoch = int(time.mktime(time.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ")))
        except ValueError:
            continue
        return str(max(0, now - epoch))
    return "unknown"


def next_action(state: str, details: str) -> str:
    if state == "OPEN_UNOWNED":
        return "repair dispatch" if "dispatch=failed" in details else "owner takes exact task"
    if state == "QUEUED":
        return "complete named prerequisite" if "waiting_for=" in details else "owner takes exact task"
    if state in ("RUNNING", "OVERDUE"):
        return "record progress, completion, or concrete blocker"
    if state == "BLOCKED":
        return "resolve blocker, then resume exact task"
    if state == "HELD_REJECTED":
        return "recover or reject successor from predecessor evidence"
    return "inspect canonical task state"


def stalled_detector_eligible(task_id: str) -> bool:
    """Triage rows are the detector's own repair queue, not stalled work.

    report() pages triage for every error including stalled triages, so a
    stalled health-warning triage re-pages itself (2026-09-16: ace9180f triaged
    stalled 92f9dc0c). Exclude health-warning/* chains from stalled-active
    detection at every intake; they stay visible as unfinished obligations in
    audit and followthrough.
    """
    return not task_id.startswith("health-warning/")


TERMINAL_CANONICAL = frozenset({"done", "rejected", "ignored"})


def canonically_terminal(task_id: str, steps: dict[str, dict]) -> bool:
    """A lease row that the canonical ledger already settled is lag, not a stall.

    The audit/journal materialization lags the replay, so a DONE row can still
    hold a live RUNNING lease. Gate the stall error on the canonical step
    status: terminal steps drop silently, everything else keeps recovery-wake.
    """
    step = steps.get(task_id)
    return isinstance(step, dict) and step.get("status") in TERMINAL_CANONICAL


def write_followthrough(audit_raw: str, steps: dict[str, dict], now: int) -> int:
    """Write one human-readable row for every unfinished obligation on every sweep."""
    observed = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now))
    rows = ["observed_at\tstate\towner\ttask\tage_s\treason\tnext_action"]
    unfinished = 0
    for line in audit_raw.splitlines():
        fields = line.split("\t")
        if len(fields) < 3 or fields[0] in ("DONE", "REJECTED", "IGNORED"):
            continue
        state, owner, task_id = fields[:3]
        details = " ".join(field.replace("\t", " ").replace("\n", " ") for field in fields[3:]) or "none"
        rows.append("\t".join((observed, state, owner, task_id,
                               task_age(steps.get(task_id, {}), now), details,
                               next_action(state, details))))
        unfinished += 1
    FOLLOWTHROUGH.parent.mkdir(parents=True, exist_ok=True)
    temporary = FOLLOWTHROUGH.with_name(FOLLOWTHROUGH.name + f".tmp.{os.getpid()}")
    temporary.write_text("\n".join(rows) + "\n", encoding="utf-8")
    os.replace(temporary, FOLLOWTHROUGH)
    return unfinished


def report(errors: list[str], summary: str, now: int) -> str:
    health = "FAIL" if errors else "PASS"
    row = (f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(now))} RUN health={health} "
           f"{summary} errors={';'.join(errors) if errors else 'none'}")
    TAPE.parent.mkdir(parents=True, exist_ok=True)
    with TAPE.open("a", encoding="utf-8") as output:
        output.write(row + "\n")
        output.flush()
        os.fsync(output.fileno())

    state = load_state()
    if errors:
        signature = ";".join(errors)
        last_at = int(state.get("alert_at", 0))
        if signature != state.get("alert_signature") or now - last_at >= ALERT_SECONDS:
            posted = command([CHAT, f"[health-fail] witness-task-autonomy: {summary}; errors={signature}"], 15)
            state["alert_signature"] = signature
            if posted.returncode == 0:
                state["alert_at"] = now
            else:
                row += f" alert=failed-rc-{posted.returncode}"
                # Keep the initial failed RUN durable even if alert delivery hangs;
                # append the delivery outcome once it is known.
                with TAPE.open("a", encoding="utf-8") as output:
                    output.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(now))} "
                                 f"ALERT alert=failed-rc-{posted.returncode}\n")
                    output.flush()
                    os.fsync(output.fileno())
    else:
        state.pop("alert_signature", None)
        state.pop("alert_at", None)
    save_state(state)
    print(row)
    return health


def run_once() -> int:
    now = int(time.time())
    errors: list[str] = []
    rebuilt = command([JOURNAL_CMD], 90)
    if rebuilt.returncode:
        errors.append(f"journal-rc-{rebuilt.returncode}")
    journal_pass = rebuilt.returncode == 0 and source_ok()
    if not journal_pass:
        errors.append("journal-source-not-PASS")

    audit = command([TASK, "audit"])
    replayed = command([TASK, "replay", "--json"])
    queue = command([TASK, "queue", "--dispatch"])
    minds = command([MIND_STATE, "--stats"])
    for name, result in (("audit", audit), ("replay", replayed),
                         ("queue", queue), ("mind-state", minds)):
        if result.returncode:
            errors.append(f"{name}-rc-{result.returncode}")

    candidates: list[tuple[str, str]] = []
    idle: list[str] = []
    live: set[str] = set()
    checks = 0
    ownerless_count = 0
    blocked_count = 0
    unfinished_count = 0
    skipped_stale = 0
    running: dict[str, tuple[str, str]] = {}
    failed_dispatches: list[str] = []
    steps: dict[str, dict] = {}
    if not replayed.returncode:
        try:
            steps = step_index(replayed.stdout)
        except (ValueError, TypeError):
            errors.append("replay-parse")
    if not audit.returncode:
        for number, line in enumerate(audit.stdout.splitlines(), 1):
            if not line:
                continue
            fields = line.split("\t")
            if len(fields) < 3:
                errors.append(f"audit-row-{number}-malformed")
                continue
            if fields[0] == "BLOCKED":
                blocked_count += 1
            # A durable open task with a failed board send is neither work that
            # was offered to its owner nor a healthy queue entry.  The witness
            # owns this repair because it can repeat the normal exact-owner
            # receipt path without choosing or claiming the task.
            if fields[0] == "OPEN_UNOWNED" and any(
                    field == "dispatch=failed" for field in fields[3:]):
                failed_dispatches.append(fields[2])
            if fields[0] in ("RUNNING", "OVERDUE") and len(fields) >= 4:
                # audit rows carry owner, stable task id, and the current lease.  A
                # renewed lease is evidence that the owner made a structured task
                # update; the same lease across witness runs is a visible stalled
                # claim before it silently becomes an overdue row.
                if stalled_detector_eligible(fields[2]):
                    lease = next((field[6:] for field in fields[3:] if field.startswith("lease=")), "")
                    running[fields[2]] = (fields[1], lease)
            if fields[0] not in ("DONE", "REJECTED", "IGNORED"):
                unfinished_count += 1
        try:
            recorded = write_followthrough(audit.stdout, steps, now)
            if recorded != unfinished_count:
                errors.append(f"followthrough-count-{recorded}-expected-{unfinished_count}")
        except OSError as exc:
            errors.append(f"followthrough-write-{type(exc).__name__}")
    state = load_state()
    observed = state.get("active_observed", {})
    if not isinstance(observed, dict):
        observed = {}
    next_observed: dict[str, dict[str, object]] = {}
    active_recovery_wakes = 0
    for task_id, (owner, lease) in running.items():
        if canonically_terminal(task_id, steps):
            skipped_stale += 1
            continue
        prior = observed.get(task_id, {})
        if not isinstance(prior, dict) or prior.get("owner") != owner or prior.get("lease") != lease:
            first_seen = now
        else:
            first_seen = int(prior.get("first_seen", now))
        elapsed = max(0, now - first_seen)
        next_observed[task_id] = {"owner": owner, "lease": lease, "first_seen": first_seen}
        if elapsed >= ACTIVE_STALL_SECONDS:
            errors.append(f"active-task-stalled-{task_id}-for-{elapsed}s")
            # A claim remains owned until its owner settles it; recovery is a
            # bounded, durable re-invitation to that exact owner.
            recovery_at = int(prior.get("recovery_at", 0)) if isinstance(prior, dict) else 0
            if now - recovery_at >= ALERT_SECONDS:
                prompt = (f"[witness active-claim recovery] {task_id} has had no structured "
                          f"progress for {elapsed}s. Continue it now, or record its concrete block "
                          f"and create/take the prerequisite that unblocks it; then update or settle "
                          f"the exact task. Do not leave the claim silent.")
                woke = command([TELL, "--origin", owner, prompt], 30)
                next_observed[task_id]["recovery_at"] = now
                next_observed[task_id]["recovery_result"] = woke.returncode
                if woke.returncode:
                    errors.append(f"active-task-recovery-{task_id}-to-{owner}-rc-{woke.returncode}")
                else:
                    active_recovery_wakes += 1
    state["active_observed"] = next_observed
    save_state(state)
    dispatch_repairs = 0
    for task_id in failed_dispatches:
        repaired = command([TASK, "reschedule-task", task_id], 60)
        if repaired.returncode:
            errors.append(f"dispatch-repair-{task_id}-rc-{repaired.returncode}")
        else:
            dispatch_repairs += 1
    if not queue.returncode:
        try:
            candidates = queue_rows(queue.stdout, "global-queue")
            ownerless_count = sum(owner == "-" for owner, _ in candidates)
        except ValueError as exc:
            errors.append(f"queue-parse:{exc}")
    if not minds.returncode:
        idle = idle_minds(minds.stdout)
        live = live_windows(minds.stdout)

    # A candidate owned by a window nobody staffs has no hands behind it:
    # exact-owner dispatch can never claim it, so it must not inflate the
    # dispatchable count idle minds read as available work.  It stays a
    # visible unfinished obligation (followthrough + audit), just not a
    # dispatchable one.  When the mind census itself failed, live is empty
    # and every candidate stays checkable: blindness fails open, never quiet.
    routable: list[tuple[str, str]] = []
    unroutable: list[tuple[str, str]] = []
    for owner, task_id in candidates:
        if owner != "-" and live and owner_key(owner) not in live:
            unroutable.append((owner, task_id))
        else:
            routable.append((owner, task_id))

    def check_candidate(task_id: str, owner: str) -> None:
        nonlocal checks, active_recovery_wakes, skipped_stale
        checked = command([TASK, "check", "dispatch", task_id, owner], 45)
        checks += 1
        if checked.returncode == 0:
            return
        if checked.returncode != 2:
            errors.append(f"check-{task_id}-for-{owner}-rc-{checked.returncode}")
            return
        reconciled, current_running, reason = reconcile_refused_check(task_id, owner)
        if not reconciled:
            errors.append(f"check-{task_id}-for-{owner}-rc-2:reconcile-{reason}")
            return
        # A fresh canonical view supersedes the earlier audit snapshot. This
        # also restores active rows omitted by a raced or stale first read.
        running.clear()
        running.update(current_running)
        gate_steps = steps if isinstance(steps, dict) else {}
        for terminal_id in [cid for cid, centry in gate_steps.items()
                            if (centry[2].get("status") if isinstance(centry, tuple)
                                else centry.get("status") if isinstance(centry, dict)
                                else None) in ("done", "rejected", "ignored")]:
            if running.pop(terminal_id, None) is not None:
                skipped_stale += 1
            current_running.pop(terminal_id, None)
        refreshed_observed = {}
        for current_id, (current_owner, lease) in current_running.items():
            if current_id not in running:
                continue
            prior = state["active_observed"].get(current_id, {})
            if not isinstance(prior, dict) or prior.get("owner") != current_owner \
                    or prior.get("lease") != lease:
                prior = observed.get(current_id, {})
            first_seen = (prior.get("first_seen", now)
                          if isinstance(prior, dict) and prior.get("owner") == current_owner
                          and prior.get("lease") == lease else now)
            current = {"owner": current_owner, "lease": lease, "first_seen": first_seen}
            if isinstance(prior, dict):
                for key in ("recovery_at", "recovery_result"):
                    if key in prior:
                        current[key] = prior[key]
            elapsed = max(0, now - int(first_seen))
            if elapsed >= ACTIVE_STALL_SECONDS:
                stalled = f"active-task-stalled-{current_id}-for-{elapsed}s"
                if stalled not in errors:
                    errors.append(stalled)
                recovery_at = int(current.get("recovery_at", 0))
                if now - recovery_at >= ALERT_SECONDS:
                    prompt = (f"[witness active-claim recovery] {current_id} has had no structured "
                              f"progress for {elapsed}s. Continue it now, or record its concrete block "
                              f"and create/take the prerequisite that unblocks it; then update or settle "
                              f"the exact task. Do not leave the claim silent.")
                    woke = command([TELL, "--origin", current_owner, prompt], 30)
                    current["recovery_at"] = now
                    current["recovery_result"] = woke.returncode
                    if woke.returncode:
                        errors.append(f"active-task-recovery-{current_id}-to-{current_owner}-rc-{woke.returncode}")
                    else:
                        active_recovery_wakes += 1
            refreshed_observed[current_id] = current
        state["active_observed"] = refreshed_observed
        save_state(state)

    # Check every routable global candidate against its exact owner. A refusal
    # may race with a take(), so only code 2 gets a fresh canonical reconciliation.
    for owner, task_id in routable:
        if owner == "-":
            continue
        check_candidate(task_id, owner)

    # Ownerless tasks are a shared pool. Prove that every idle mind's normal
    # owner-scoped self-pick prompt can see them; no idle mind is assigned one.
    unowned_ids = {task_id for owner, task_id in routable if owner == "-"}
    visible = 0
    if unowned_ids and idle:
        for mind in idle:
            scoped = command([TASK, "queue", "--dispatch", "--owner", mind], 60)
            if scoped.returncode:
                errors.append(f"owner-queue-{mind}-rc-{scoped.returncode}")
                continue
            try:
                rows = queue_rows(scoped.stdout, f"owner-queue-{mind}")
            except ValueError as exc:
                errors.append(f"owner-queue-parse:{exc}")
                continue
            scoped_ids = {task_id for owner, task_id in rows if owner in ("-", mind)}
            for task_id in sorted(unowned_ids - scoped_ids):
                errors.append(f"unowned-{task_id}-invisible-to-idle-{mind}")
            for task_id in sorted(unowned_ids & scoped_ids):
                visible += 1
                check_candidate(task_id, mind)

    summary = (f"source={'PASS' if not errors else 'FAIL'} journal_pass={journal_pass} "
               f"unfinished={unfinished_count} "
               f"blocked={blocked_count} idle_minds={len(idle)} dispatchable={len(routable)} "
               f"unroutable={len(unroutable)} "
                f"ownerless={ownerless_count} ownerless_visible={visible} active={len(running)} "
                f"skipped_stale={skipped_stale} "
                f"active_recovery_wakes={active_recovery_wakes} dispatch_repairs={dispatch_repairs} checks={checks}")
    return 1 if report(errors, summary, now) == "FAIL" else 0


def run_selftest() -> int:
    holder = acquire_singleflight()
    if holder is None:
        print("mesh-witness-task-autonomy --test: FAIL (lock held before self-test)", file=sys.stderr)
        return 1
    try:
        child = subprocess.run(
            [sys.executable, os.path.abspath(__file__), "--once"],
            text=True, capture_output=True, timeout=120, check=False,
        )
    except subprocess.TimeoutExpired:
        print("mesh-witness-task-autonomy --test: FAIL (overlap probe timed out)", file=sys.stderr)
        return 1
    finally:
        fcntl.flock(holder.fileno(), fcntl.LOCK_UN)
        holder.close()
    if child.returncode != 0 or "skip" not in child.stderr.lower():
        print(f"mesh-witness-task-autonomy --test: FAIL (overlap probe rc={child.returncode} "
              f"stderr={child.stderr.strip()!r})", file=sys.stderr)
        return 1
    print("mesh-witness-task-autonomy --test: PASS (fixture coverage is in tests/test-mesh-witness-task-autonomy.py; overlap skips loudly)")
    return 0


def main(argv: list[str]) -> int:
    if argv == ["--test"]:
        return run_selftest()
    if argv not in ([], ["--once"]):
        print("usage: mesh-witness-task-autonomy [--once|--test]", file=sys.stderr)
        return 64
    if acquire_singleflight() is None:
        print("mesh-witness-task-autonomy: skip — another autonomy check owns this run", file=sys.stderr)
        return 0
    return run_once()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
