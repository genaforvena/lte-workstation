#!/usr/bin/env bash
# mesh-router-watch — proactive thermal watchdog for the GL-MT3000 router (the LAN gateway + NL VPN
# egress). The router is fanless AND cardless (no mesh-card → unmonitored): if it overheats while the
# operator is away it fails SILENTLY, taking LAN + egress with it. This polls its temp (read-only ssh)
# and EDGE-TRIGGERS [router-hot] when it crosses the threshold + [router-cool] on recovery — the same
# trustworthy-signal pattern as doctor/health/drift (problem AND resolution, no spam, transients OK).
# Runs on a node that holds the router SSH key (the steward). Unreachable router = can't-assess, never
# a false alarm.
# reflex-cadence: */15 * * * *
# (orphaned in the 2026-06-21 reorg → unwired 2h+, the fanless-gateway thermal watchdog went silently
# dead — exactly the silent-overheat-while-operator-away risk it exists to catch. reflex-health skips it
# too (only watches cron-present reflexes). A cadence header lets mesh-autowire keep it wired post-reorg.)
#
#   mesh-router-watch          poll once; alert only on a HOT/COOL transition
#   mesh-router-watch --status print current temp/load, no alert
#   mesh-router-watch --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# Registry-resolved (no hardcoded tailnet IP — plantable; ~/.mesh/nodes maps router:user@ip).
ROUTER="${MESH_ROUTER:-$(mesh-peer-addr router 2>/dev/null || mesh-peer-addr GL-MT3000 2>/dev/null)}"
RUSER="${MESH_ROUTER_USER:-root}"
HOT="${MESH_ROUTER_HOT_C:-85}"   # °C — "running hot" warning, well below thermal shutdown (~100C+)
STATE="$HOME/.mesh/.router-thermal-state"
# HOLLOW-STREAK tracking (chat-review/senses-liveness 2026-07-09): "unreachable-alive" is an honest
# signal for ONE tick, but reflex-health only gates on the STATE file's mtime — which this reflex
# rewrites every */15 run regardless of branch — so a router stuck thermal-BLIND for WEEKS (found
# live: GL-MT3000 tailscale offline 20d+, no LAN SSH key fallback) reads as fresh/ok forever with
# zero signal the watchdog's actual purpose (catch a silent overheat) has been structurally inert
# the whole time. BLIND_SINCE seeds on first blind tick, persists across ticks; once the streak
# exceeds BLIND_ALERT_S it fires ONE edge-triggered board notice (not every cycle) so the mesh
# stops silently assuming the sense is live. Cleared the moment a real reading resumes.
BLIND_SINCE="$HOME/.mesh/.router-thermal-blind-since"
BLIND_ALERTED="$HOME/.mesh/.router-thermal-blind-alerted"
BLIND_ALERT_S="${MESH_ROUTER_BLIND_ALERT_S:-21600}"   # 6h — well past any real transient
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new)
CHAT_LOG="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"     # the shared board mesh-chat appends to

# board_blind_recent <chat.log> <now_epoch> <window_s>: rc0 iff the SHARED board already carries a
# [router-watch-blind] post from ANY host whose UTC timestamp is within <window_s> of <now_epoch>
# — i.e. another node has already announced this same external fact recently, so this node must NOT
# post a duplicate. Cross-node dedup (chat-review/routerwatch-blind-alert-crossnode-dup 2026-07-10):
# BLIND_ALERTED is per-node LOCAL, so N nodes each independently crossing the 6h threshold posted the
# byte-identical board line N times (live: 3 nodes/75min, 2026-07-09 14:15/14:45/15:30Z). Mirrors the
# cross-node-dedup idiom mesh-mind-control's dispatch() already adopted. rc1 when there is no such
# line, the newest is older than the window (first-ever alert, or the window expired → post normally),
# or the log is unreadable (never suppress on a read failure). Pure/offline-testable — path+now injected.
board_blind_recent() {
  local log="$1" now="$2" win="$3" line ts tse
  [ -r "$log" ] || return 1
  line="$(grep -h '\[router-watch-blind\]' "$log" 2>/dev/null | tail -1)"
  [ -n "$line" ] || return 1
  ts="${line%% *}"                                    # leading ISO8601 UTC token
  tse="$(date -d "$ts" +%s 2>/dev/null)" || return 1
  [ -n "$tse" ] || return 1
  [ $(( now - tse )) -lt "$win" ]
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh — router probe impossible)"; exit 1; }
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout — router probe can wedge the watcher)"; exit 1; }
  command -v hostname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no hostname)"; exit 1; }
  _td="$(mktemp -d "${TMPDIR:-/tmp}"/mesh-router-watch-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT

  # Negative check: when ssh is absent, the test must fail immediately instead of pretending the
  # watcher is usable. This is the real dependency gate the runtime needs.
  mkdir -p "$_td/failbin" "$_td/home/.mesh"
  ln -s /usr/bin/hostname "$_td/failbin/hostname"
  if HOME="$_td/home" PATH="$_td/failbin" MESH_ROUTER=fake-router bash "$0" --status >/dev/null 2>&1; then
    echo "smoke-test: FAIL (missing ssh did not fail the router watcher)" ; exit 1
  fi
  echo "  ok: missing ssh makes the watcher fail — dependency gate is real"

  # Positive dry-run: a stub ssh returns a synthetic temp/load payload, and --status must parse it.
  mkdir -p "$_td/passbin"
  ln -s /usr/bin/bash "$_td/passbin/bash"
  ln -s /usr/bin/hostname "$_td/passbin/hostname"
  ln -s /usr/bin/timeout "$_td/passbin/timeout"
  cat > "$_td/passbin/ssh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '86000|1.23'
EOF
  chmod +x "$_td/passbin/ssh"
  out="$(HOME="$_td/home" PATH="$_td/passbin" MESH_ROUTER=fake-router "$0" --status 2>/dev/null)" || {
    echo "smoke-test: FAIL (status dry-run errored)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'router fake-router: 86C  load 1.23' || {
    echo "smoke-test: FAIL (status output did not parse the synthetic router temp/load)"; exit 1; }
  echo "  ok: status dry-run parsed synthetic router temp/load"

  # HOLLOW-STREAK regression (chat-review/senses-liveness 2026-07-09): unreachable-alive must seed
  # a blind-since streak, escalate ONCE past a long threshold, and clear the moment a real reading
  # resumes — the live gap found: GL-MT3000 tailscale down 20d+, watcher smoke-passed the whole time.
  _td2="$(mktemp -d "${TMPDIR:-/tmp}"/mesh-router-watch-test2.XXXXXX)" || { echo "smoke-test: FAIL (mktemp2)"; exit 1; }
  trap 'rm -rf "$_td" "$_td2"' EXIT
  mkdir -p "$_td2/home/.mesh" "$_td2/bin"
  for b in bash hostname timeout awk rm cat date mkdir touch; do ln -s "/usr/bin/$b" "$_td2/bin/$b"; done
  cat > "$_td2/bin/ssh" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
  cat > "$_td2/bin/ip" <<'EOF'
#!/usr/bin/env bash
echo "default via 10.0.0.1 dev eth0"
EOF
  cat > "$_td2/bin/ping" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$_td2/bin/ssh" "$_td2/bin/ip" "$_td2/bin/ping"

  HOME="$_td2/home" PATH="$_td2/bin" MESH_ROUTER=fake-router bash "$0" >/dev/null 2>&1
  [ "$(cat "$_td2/home/.mesh/.router-thermal-state" 2>/dev/null)" = unreachable-alive ] || {
    echo "smoke-test: FAIL (unreachable-alive not written on blind tick)"; exit 1; }
  [ -f "$_td2/home/.mesh/.router-thermal-blind-since" ] || {
    echo "smoke-test: FAIL (blind-since streak marker not seeded on first blind tick)"; exit 1; }
  echo "  ok: unreachable-alive seeds a blind-since streak marker"

  # age the streak past the alert threshold (rewrite content, not just mtime — the reflex reads
  # the epoch from the file's CONTENT) and re-run: must trip the one-time alert flag
  echo "$(( $(date +%s) - 25200 ))" > "$_td2/home/.mesh/.router-thermal-blind-since"   # 7h ago
  HOME="$_td2/home" PATH="$_td2/bin" MESH_ROUTER=fake-router bash "$0" >/dev/null 2>&1
  [ -f "$_td2/home/.mesh/.router-thermal-blind-alerted" ] || {
    echo "smoke-test: FAIL (7h-old blind streak did not trip the one-time alert flag)"; exit 1; }
  echo "  ok: a sustained (7h) thermal-BLIND streak trips the one-time alert flag"

  # a real thermal reading resuming must clear both streak markers
  cat > "$_td2/bin/ssh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '50000|0.10'
EOF
  chmod +x "$_td2/bin/ssh"
  HOME="$_td2/home" PATH="$_td2/bin" MESH_ROUTER=fake-router bash "$0" >/dev/null 2>&1
  [ -f "$_td2/home/.mesh/.router-thermal-blind-since" ] && {
    echo "smoke-test: FAIL (blind-since not cleared after a real reading resumed)"; exit 1; }
  [ -f "$_td2/home/.mesh/.router-thermal-blind-alerted" ] && {
    echo "smoke-test: FAIL (blind-alerted not cleared after a real reading resumed)"; exit 1; }
  echo "  ok: a resumed real thermal reading clears the blind-streak markers"

  # --- CROSS-NODE BOARD DEDUP (chat-review/routerwatch-blind-alert-crossnode-dup 2026-07-10) ---
  # Unit: board_blind_recent must treat a fresh board post from ANOTHER host as "already announced".
  _now=$(date +%s); _iso() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }
  _cl="$_td/recent.log";  printf '%s  router-watch@other  ::  [router-watch-blind] x\n' "$(_iso $((_now-3600)))"  > "$_cl"
  board_blind_recent "$_cl" "$_now" 21600 || { echo "smoke-test: FAIL (1h-old board line must count as recent)"; exit 1; }
  _cl="$_td/old.log";     printf '%s  router-watch@other  ::  [router-watch-blind] x\n' "$(_iso $((_now-25200)))" > "$_cl"
  board_blind_recent "$_cl" "$_now" 21600 && { echo "smoke-test: FAIL (7h-old board line must NOT count as recent — first/expired alert must post)"; exit 1; }
  _cl="$_td/none.log";    printf '%s  chat@x  ::  [idle] nothing\n' "$(_iso $((_now-60)))"                        > "$_cl"
  board_blind_recent "$_cl" "$_now" 21600 && { echo "smoke-test: FAIL (no board blind line must NOT count as recent)"; exit 1; }
  board_blind_recent "$_td/does-not-exist" "$_now" 21600 && { echo "smoke-test: FAIL (unreadable log must NOT count as recent)"; exit 1; }
  { printf '%s  router-watch@a  ::  [router-watch-blind] old\n' "$(_iso $((_now-25200)))";
    printf '%s  router-watch@b  ::  [router-watch-blind] new\n' "$(_iso $((_now-1800)))"; } > "$_td/multi.log"
  board_blind_recent "$_td/multi.log" "$_now" 21600 || { echo "smoke-test: FAIL (newest 30m-old line must count as recent even after an old one)"; exit 1; }
  echo "  ok: board_blind_recent — recent/expired/absent/unreadable/newest-of-many all classify correctly"

  # Integration: a 7h LOCAL blind streak with a RECENT board post from another node must NOT post a
  # 2nd board line, but MUST still touch BLIND_ALERTED; with only an EXPIRED board post it must post.
  _td3="$(mktemp -d "${TMPDIR:-/tmp}"/mesh-router-watch-test3.XXXXXX)" || { echo "smoke-test: FAIL (mktemp3)"; exit 1; }
  trap 'rm -rf "$_td" "$_td2" "$_td3"' EXIT
  mkdir -p "$_td3/home/.mesh" "$_td3/bin"
  printf '#!/usr/bin/env bash\nexit 1\n'                                              > "$_td3/bin/ssh"
  printf '#!/usr/bin/env bash\necho "default via 10.0.0.1 dev eth0"\n'                > "$_td3/bin/ip"
  printf '#!/usr/bin/env bash\nexit 0\n'                                              > "$_td3/bin/ping"
  printf '#!/usr/bin/env bash\necho "$*" >> "$HOME/.mesh/chat.log"\ntouch "$HOME/.mesh/.mesh-chat-was-called"\n' > "$_td3/bin/mesh-chat"
  chmod +x "$_td3/bin/ssh" "$_td3/bin/ip" "$_td3/bin/ping" "$_td3/bin/mesh-chat"
  _run3() { HOME="$_td3/home" PATH="$_td3/bin:$PATH" MESH_ROUTER=fake-router bash "$0" >/dev/null 2>&1; }
  # (A) SUPPRESS: recent (1h) board post present, 7h local streak, no local alert flag yet.
  printf '%s  router-watch@other  ::  [router-watch-blind] x\n' "$(_iso $((_now-3600)))" > "$_td3/home/.mesh/chat.log"
  echo "$(( _now - 25200 ))" > "$_td3/home/.mesh/.router-thermal-blind-since"
  rm -f "$_td3/home/.mesh/.router-thermal-blind-alerted" "$_td3/home/.mesh/.mesh-chat-was-called"
  _run3
  [ -f "$_td3/home/.mesh/.router-thermal-blind-alerted" ] || { echo "smoke-test: FAIL (dedup: BLIND_ALERTED must still be touched even when the post is suppressed)"; exit 1; }
  [ -f "$_td3/home/.mesh/.mesh-chat-was-called" ] && { echo "smoke-test: FAIL (dedup: must NOT post a 2nd board line when another host posted <6h ago)"; exit 1; }
  echo "  ok: a recent cross-node board post suppresses the duplicate — local flag still marked"
  # (B) POST: only an EXPIRED (7h) board post present -> the window lapsed -> must post normally.
  printf '%s  router-watch@other  ::  [router-watch-blind] x\n' "$(_iso $((_now-25200)))" > "$_td3/home/.mesh/chat.log"
  echo "$(( _now - 25200 ))" > "$_td3/home/.mesh/.router-thermal-blind-since"
  rm -f "$_td3/home/.mesh/.router-thermal-blind-alerted" "$_td3/home/.mesh/.mesh-chat-was-called"
  _run3
  [ -f "$_td3/home/.mesh/.mesh-chat-was-called" ] || { echo "smoke-test: FAIL (regression: an expired-window board post must NOT suppress — the alert must still fire)"; exit 1; }
  echo "  ok: an expired-window board post does not suppress — the alert still fires (regression guard)"

  echo "smoke-test: ok (status parse + hollow-streak seed/escalate/clear + cross-node board dedup all verified)"; exit 0
fi

[ -n "$ROUTER" ] || { echo "no router in ~/.mesh/nodes — nothing to watch on this node"; exit 0; }
raw="$(timeout 12 "${SSH[@]}" "$RUSER@$ROUTER" \
  'echo "$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)|$(cut -d" " -f1 /proc/loadavg 2>/dev/null)"' </dev/null 2>/dev/null)"
mt="${raw%%|*}"; load="${raw##*|}"
{ [ -n "$mt" ] && [ "$mt" -gt 0 ] 2>/dev/null; } || {
  # SSH thermal probe failed. Disambiguate a DEAD gateway (real LAN+egress risk) from a router that
  # is merely OFF-TAILNET but ALIVE on the LAN (probe path down → thermal-BLIND, no LAN SSH key
  # fallback = a monitoring gap, NOT a fire). A bare 'unreachable' reads identically for both and
  # would mask a genuine gateway-down — honest signal, empty ≠ failed. LAN proxy = this node's
  # default gateway (this watcher runs on the LAN-resident steward, where default-gw IS the router).
  # Write the state so consumers see current truth (not a stale 'cool' from days ago).
  gw="$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')"
  if [ -n "$gw" ] && timeout 4 ping -c1 -W3 "$gw" >/dev/null 2>&1; then
    echo "router temp unreadable: $ROUTER (tailnet probe path) down, but gateway $gw ALIVE on LAN — thermal-BLIND (no LAN SSH key), monitoring gap not a fire"
    echo unreachable-alive > "$STATE"
    now=$(date +%s)
    [ -f "$BLIND_SINCE" ] || echo "$now" > "$BLIND_SINCE"
    since="$(cat "$BLIND_SINCE" 2>/dev/null || echo "$now")"
    blind_age=$(( now - since ))
    if [ "$blind_age" -ge "$BLIND_ALERT_S" ] && [ ! -f "$BLIND_ALERTED" ]; then
      # Cross-node board dedup: if another host already announced this same external fact within the
      # window, still mark the LOCAL flag (so this node stops re-checking) but skip the redundant post.
      if board_blind_recent "$CHAT_LOG" "$now" "$BLIND_ALERT_S"; then
        : # already on the board from another node this window — suppress the duplicate
      else
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="router-watch@$(hostname)" \
          mesh-chat "[router-watch-blind] GL-MT3000 thermal probe has been BLIND for $((blind_age/3600))h+ (tailnet probe path down, no LAN SSH key fallback) — the overheat watchdog has been structurally inert this whole time, though reflex-health reports it fresh/ok (mtime-only gate). Not a code bug — honest no-LAN-key monitoring gap — flagging so it's not silently assumed live." >/dev/null 2>&1
      fi
      touch "$BLIND_ALERTED"
    fi
  else
    echo "router temp unreadable AND default gateway unreachable on LAN — gateway may be DOWN (LAN+egress at risk)"
    echo unreachable-down > "$STATE"
    rm -f "$BLIND_SINCE" "$BLIND_ALERTED"
  fi
  exit 0
}
tc=$((mt / 1000))
rm -f "$BLIND_SINCE" "$BLIND_ALERTED"   # a real reading just landed — any blind streak is over

[ "${1:-}" = --status ] && { echo "router $ROUTER: ${tc}C  load ${load}  (hot-threshold ${HOT}C)"; exit 0; }

prev="$(cat "$STATE" 2>/dev/null || echo cool)"
if [ "$tc" -ge "$HOT" ]; then
  if [ "$prev" != hot ]; then
    echo hot > "$STATE"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="router-watch@$(hostname)" \
      mesh-chat "[router-hot] GL-MT3000 ${tc}C ≥ ${HOT}C (load ${load}) — the fanless gateway is running HOT; LAN+egress at risk if it climbs. Check airflow/load." >/dev/null 2>&1
  fi
else
  if [ "$prev" = hot ]; then
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="router-watch@$(hostname)" \
      mesh-chat "[router-cool] GL-MT3000 back to ${tc}C (< ${HOT}C) — thermal recovered." >/dev/null 2>&1
  fi
  echo cool > "$STATE"
fi
exit 0
