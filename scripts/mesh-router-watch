#!/usr/bin/env bash
# mesh-router-watch — proactive thermal watchdog for the GL-MT3000 router (the LAN gateway + NL VPN
# egress). The router is fanless AND cardless (no mesh-card → unmonitored): if it overheats while the
# operator is away it fails SILENTLY, taking LAN + egress with it. This polls its temp (read-only ssh)
# and EDGE-TRIGGERS [router-hot] when it crosses the threshold + [router-cool] on recovery — the same
# trustworthy-signal pattern as doctor/health/drift (problem AND resolution, no spam, transients OK).
# Runs on a node that holds the router SSH key (the steward). Unreachable router = can't-assess, never
# a false alarm.
#
#   mesh-router-watch          poll once; alert only on a HOT/COOL transition
#   mesh-router-watch --status print current temp/load, no alert
#   mesh-router-watch --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
ROUTER="${MESH_ROUTER:-$(mesh-peer-addr router 2>/dev/null || mesh-peer-addr GL-MT3000 2>/dev/null || echo 100.105.241.84)}"
RUSER="${MESH_ROUTER_USER:-root}"
HOT="${MESH_ROUTER_HOT_C:-85}"   # °C — "running hot" warning, well below thermal shutdown (~100C+)
STATE="$HOME/.mesh/.router-thermal-state"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new)

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  [ -n "$ROUTER" ] || { echo "smoke-test: FAIL (no router address resolved)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

raw="$(timeout 12 "${SSH[@]}" "$RUSER@$ROUTER" \
  'echo "$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)|$(cut -d" " -f1 /proc/loadavg 2>/dev/null)"' </dev/null 2>/dev/null)"
mt="${raw%%|*}"; load="${raw##*|}"
{ [ -n "$mt" ] && [ "$mt" -gt 0 ] 2>/dev/null; } || { echo "router temp unreadable ($ROUTER unreachable?) — can't assess"; exit 0; }
tc=$((mt / 1000))

[ "${1:-}" = --status ] && { echo "router $ROUTER: ${tc}C  load ${load}  (hot-threshold ${HOT}C)"; exit 0; }

prev="$(cat "$STATE" 2>/dev/null || echo cool)"
if [ "$tc" -ge "$HOT" ]; then
  if [ "$prev" != hot ]; then
    echo hot > "$STATE"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="router-watch@$(hostname)" \
      mesh-chat "[router-hot] GL-MT3000 ${tc}C ≥ ${HOT}C (load ${load}) — the fanless gateway is running HOT; LAN+egress at risk if it climbs. Check airflow/load." >/dev/null 2>&1
  fi
else
  if [ "$prev" = hot ]; then
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="router-watch@$(hostname)" \
      mesh-chat "[router-cool] GL-MT3000 back to ${tc}C (< ${HOT}C) — thermal recovered." >/dev/null 2>&1
  fi
  echo cool > "$STATE"
fi
exit 0
