#!/usr/bin/env bash
# reflex-cadence: 7-59/10 * * * *
# reflex-args: --edge
# mesh-phone-ap — WIFI LOCATION sense: which AP is the phone body connected to?
# Reads termux-wifi-connectioninfo over SSH, compares SSID against the known home AP
# (MESH_HOME_SSID, default "GL-MT3000-765") to answer: "is the phone at home,
# at another WiFi location, or mobile (no WiFi)?"
#
# This is orthogonal to mesh-wifi-link (which measures link QUALITY, not LOCATION).
# SSID-based location is coarser than GPS but instant and battery-free.
#
# States:
#   HOME           phone on the home AP → operator home. Carries the EVIDENCE that bought the word:
#                  `bssid` (the AP's own radio identity) or `ssid-only` (a NAME, which is many-to-one)
#   HOME-SSID-ONLY the home SSID on a radio that is NOT a declared home BSSID — a repeater, the
#                  operator's own travel router, or a same-named foreign AP. NOT a location claim.
#   AWAY-WIFI      phone on a different AP → operator at another location with WiFi
#   NO-WIFI        phone not on any WiFi → on mobile data or WiFi off
#   UNKNOWN-AP     Android REDACTED the read (no location permission): ssid "<unknown ssid>" and/or
#                  bssid 02:00:00:00:00:00 while supplicant_state is COMPLETED. Never a location.
#   Exit 2         phone unreachable over SSH — never fakes a location
#
# Usage:
#   mesh-phone-ap          one-shot location
#   mesh-phone-ap --edge   emit only on state change (for cron)
#   mesh-phone-ap --json   machine-readable JSON
#   mesh-phone-ap --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no"
HOME_SSID="${MESH_HOME_SSID:-GL-MT3000-765}"
# ===================== OBSERVATION ALIASING: THE LIKELIHOOD IS MANY-TO-ONE =====================
# (literature review 2026-08-26, free energy principle & active inference, angle = a known CRITIQUE.
#  Artifact: docs/reviews/fep-observation-aliasing-inverse-ambiguity-phone-ap-2026-08-26.md)
#
# THE CRITIQUE. Active inference's own uncertainty bookkeeping measures the WRONG DIRECTION of the
# conditional for this failure. Expected free energy decomposes as risk + AMBIGUITY, and ambiguity is
# E_Q(s)[H[P(o|s)]] — the expected entropy of the LIKELIHOOD, i.e. how noisy the observation is GIVEN
# the state (arXiv:2402.14460 "Reframing the Expected Free Energy", arXiv:2001.07203 Da Costa et al.).
# A sensor can score ZERO ambiguity by that measure — perfectly repeatable, noise-free — and still be
# catastrophically ALIASED, because aliasing lives in the inverse direction: H[P(s|o)], many world
# states mapping onto one observation. The live literature treats this as an open gap rather than a
# solved case: de Tinguy/Verbelen/Dhoedt build cognitive maps precisely for "scenarios in which
# sensory observations provide ambiguous information about location" (arXiv:2308.08307), extended in
# arXiv:2408.05982 and arXiv:2411.08447 for "complex and aliased environments".
#
# THIS ORGAN IS THAT SENTENCE. It is a LOCATION sense whose whole observation is an SSID — a NAME
# that anyone may broadcast — and the pre-image of "ssid contains GL-MT3000-765" holds at least four
# distinct world states: the operator is home; the phone is home and the operator is not; the phone
# is on a REPEATER carrying the same name; or the phone is on this very GL-MT3000, which is a TRAVEL
# router and is designed to be carried away and rebroadcast its SSID somewhere else. The reading was
# equally confident in all four. Precision was never the problem — the SSID read is deterministic.
#
# THE REMEDY THE LITERATURE PRESCRIBES is not more precision: it is an observation whose likelihood
# is NOT degenerate. Here that channel is already in the same JSON at zero extra cost — the BSSID,
# the AP's own 48-bit radio identity. So: declare the home radios in MESH_HOME_BSSID (node-local
# ~/.mesh/nodes, space- or comma-separated) and HOME is bought by IDENTITY. Undeclared, the tool does
# NOT go silent and does NOT regress — it still says HOME and PUBLISHES that the word rests on a
# many-to-one channel (evidence=ssid-only), and prints the observed BSSID so the operator can end the
# ambiguity by pasting one line. A capability at zero adoption must not read as absent; the gap is
# rendered, not hidden.
HOME_BSSID="${MESH_HOME_BSSID:-}"
STATE_FILE="$HOME/.mesh/.phone-ap.state"
# OFFLINEFILE mtime is touched via mesh-state-touch on EVERY unreachable run (liveness-touch
# convention — was touch-once-on-first-detect, which froze its mtime and made "reflex confirming
# still-down" indistinguishable from "reflex silently died"; sense-liveness audit 2026-07-04).
OFFLINEFILE="$HOME/.mesh/.phone-ap-offline"
TS=$(date -u +%H:%M:%SZ)

# Python parser — reads termux-wifi-connectioninfo JSON from stdin, args: <home_ssid_pattern>
# Prints: <STATE> <ssid> <rssi> <freq_mhz> <band>
PARSE_PY='
import json, sys, re
home_pat = sys.argv[1]
home_bssids = set()
if len(sys.argv) > 2:
    for b in sys.argv[2].replace(",", " ").split():
        if b.strip():
            home_bssids.add(b.strip().strip("\"").lower())

def out(state, ssid, rssi, freq, band, bssid, evidence):
    # TAB-separated, and no field may be empty ("-" stands in). The old layout was space-separated,
    # so an SSID containing a space shifted every field after it and the band was read out of the
    # SSID — an aliasing of the RENDER on top of the aliasing of the sense.
    print("\t".join([state, ssid or "-", str(rssi), str(freq), band, bssid or "-", evidence]))

try:
    data = json.load(sys.stdin)
except Exception:
    out("PARSE-ERROR", "-", 0, 0, "unknown", "-", "none"); sys.exit(0)
ssid  = (data.get("ssid") or "").strip().strip("\"")
state = data.get("supplicant_state", "")
bssid = (data.get("bssid") or "").strip().lower()
try:
    rssi = int(data.get("rssi", 0) or 0)
except Exception:
    rssi = 0
try:
    freq = int(data.get("frequency_mhz", 0) or 0)
except Exception:
    freq = 0
band = "5GHz" if freq >= 5000 else "2.4GHz"
# ANDROID REDACTS, IT DOES NOT REFUSE: with the location permission withdrawn, getConnectionInfo()
# still returns supplicant_state COMPLETED while ssid becomes "<unknown ssid>" and bssid becomes
# 02:00:00:00:00:00. The old parser read that as a non-home SSID and boarded AWAY-WIFI — a location
# fabricated out of a permission failure, and the one pre-image an operator would act on.
REDACTED_SSID  = {"<unknown ssid>", "<unknown>", "0x"}
REDACTED_BSSID = {"02:00:00:00:00:00", "00:00:00:00:00:00"}
if state != "COMPLETED" or not ssid:
    out("NO-WIFI", "-", rssi, freq, band, bssid, "supplicant"); sys.exit(0)
if ssid.lower() in REDACTED_SSID or bssid in REDACTED_BSSID:
    out("UNKNOWN-AP", ssid, rssi, freq, band, bssid, "redacted"); sys.exit(0)
if re.search(re.escape(home_pat), ssid):
    if not home_bssids:
        out("HOME", ssid, rssi, freq, band, bssid, "ssid-only")
    elif bssid in home_bssids:
        out("HOME", ssid, rssi, freq, band, bssid, "bssid")
    else:
        # The home NAME on a radio we have never declared. This is the travel-router / repeater /
        # same-named-foreign-AP pre-image, and it is exactly the one an SSID can never separate.
        out("HOME-SSID-ONLY", ssid, rssi, freq, band, bssid, "ssid-contradicted")
else:
    out("AWAY-WIFI", ssid, rssi, freq, band, bssid, "ssid")
'

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0

  _try() {  # $1=label $2=json $3=want-state-prefix [$4=declared home bssids]
    local label="$1" input="$2" want="$3" decl="${4-}"
    got="$(printf '%s' "$input" | python3 -c "$PARSE_PY" "$HOME_SSID" "$decl" 2>/dev/null)"
    printf '%s' "$got" | grep -q "^$want" || { echo "  FAIL [$label]: want '$want…', got '$got'"; _f=1; }
  }
  _field() {  # $1=json $2=1-based field index $3=declared bssids -> that TAB field
    printf '%s' "$1" | python3 -c "$PARSE_PY" "$HOME_SSID" "${3-}" 2>/dev/null | cut -f"$2"
  }

  _HOME5='{"ssid":"GL-MT3000-765-5G","bssid":"94:83:c4:11:22:33","rssi":-52,"frequency_mhz":5220,"supplicant_state":"COMPLETED"}'
  _try "home-5G"  "$_HOME5" "HOME"
  _try "home-2.4" '{"ssid":"GL-MT3000-765","bssid":"94:83:c4:11:22:34","rssi":-63,"frequency_mhz":2437,"supplicant_state":"COMPLETED"}' "HOME"
  _try "away-ap"  '{"ssid":"OfficeWifi","bssid":"aa:bb:cc:dd:ee:ff","rssi":-55,"frequency_mhz":5180,"supplicant_state":"COMPLETED"}' "AWAY-WIFI"
  _try "no-wifi"  '{"ssid":"","rssi":0,"frequency_mhz":0,"supplicant_state":"DISCONNECTED"}' "NO-WIFI"

  # ---- OBSERVATION ALIASING arms (see the block above the parser) --------------------------------
  # (1) THE ALIASING ITSELF, and it is the arm that was RED before this landed: the SAME home SSID on
  #     a DIFFERENT radio. Nothing about the observation is noisy — it is the pre-image that is not a
  #     singleton — so no amount of precision separates these two, only the identity channel does.
  _try "alias-same-name-other-radio" \
    '{"ssid":"GL-MT3000-765-5G","bssid":"de:ad:be:ef:00:01","rssi":-52,"frequency_mhz":5220,"supplicant_state":"COMPLETED"}' \
    "HOME-SSID-ONLY" "94:83:c4:11:22:33"
  #     …and the CONTROL, without which the arm above only proves the tool stopped saying HOME: the
  #     declared radio must still buy HOME, and buy it with the word `bssid`.
  _try "declared-radio-is-home" "$_HOME5" "HOME" "94:83:c4:11:22:33"
  [ "$(_field "$_HOME5" 7 "94:83:c4:11:22:33")" = bssid ] \
    || { echo "  FAIL [evidence]: a BSSID-verified HOME does not say so (got '$(_field "$_HOME5" 7 "94:83:c4:11:22:33")')"; _f=1; }
  #     …case and comma/space forms of the declaration are the operator's, not a fixed spelling.
  _try "declaration-uppercase-comma" "$_HOME5" "HOME" "AA:BB:CC:DD:EE:FF,94:83:C4:11:22:33"
  # (2) NO REGRESSION, AND NO SILENT CONFIDENCE: with nothing declared the verdict is unchanged HOME,
  #     but it must PUBLISH that a name is all that bought it. A capability at zero adoption must not
  #     read as absent.
  _try "undeclared-still-home" "$_HOME5" "HOME" ""
  [ "$(_field "$_HOME5" 7 "")" = ssid-only ] \
    || { echo "  FAIL [evidence]: an SSID-only HOME does not publish its degeneracy (got '$(_field "$_HOME5" 7 "")')"; _f=1; }
  # (3) ANDROID REDACTS RATHER THAN REFUSES. With the location permission withdrawn the read is
  #     "<unknown ssid>" / 02:00:00:00:00:00 with supplicant COMPLETED — which this tool boarded as
  #     AWAY-WIFI, a location fabricated from a permission failure.
  _try "redacted-ssid" '{"ssid":"<unknown ssid>","bssid":"02:00:00:00:00:00","rssi":-55,"frequency_mhz":5180,"supplicant_state":"COMPLETED"}' "UNKNOWN-AP"
  _try "redacted-bssid-only" '{"ssid":"SomeNet","bssid":"02:00:00:00:00:00","rssi":-55,"frequency_mhz":5180,"supplicant_state":"COMPLETED"}' "UNKNOWN-AP"
  # (4) A FIELD LAYOUT THAT SHIFTS IS AN ALIASING OF THE RENDER: an SSID containing a space used to
  #     push every later field along, so the band was read out of the SSID. Assert by POSITION.
  _sp='{"ssid":"Cafe Wifi 5G","bssid":"aa:bb:cc:00:11:22","rssi":-70,"frequency_mhz":5180,"supplicant_state":"COMPLETED"}'
  [ "$(_field "$_sp" 2)" = "Cafe Wifi 5G" ] && [ "$(_field "$_sp" 5)" = "5GHz" ] && [ "$(_field "$_sp" 6)" = "aa:bb:cc:00:11:22" ] \
    || { echo "  FAIL [space-in-ssid]: fields shifted — ssid='$(_field "$_sp" 2)' band='$(_field "$_sp" 5)' bssid='$(_field "$_sp" 6)'"; _f=1; }
  # (5) Android's quoted-SSID form must not become a SECOND SPELLING of the same network downstream.
  #     Asserting the STATE here would be vacuous — a substring match finds the name inside the quotes
  #     either way (measured: the arm survived its own mutation until it asserted the FIELD instead).
  _q='{"ssid":"\"GL-MT3000-765\"","bssid":"94:83:c4:11:22:34","rssi":-60,"frequency_mhz":2437,"supplicant_state":"COMPLETED"}'
  _try "quoted-ssid" "$_q" "HOME"
  [ "$(_field "$_q" 2)" = "GL-MT3000-765" ] \
    || { echo "  FAIL [quoted-ssid]: the quoted form renders as a different name than the unquoted one (got '$(_field "$_q" 2)')"; _f=1; }

  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (parser assertions above)"; exit 1; }

  # ---- END-TO-END RENDER, with a stubbed phone. The parser arms above never touch the shell-side
  #      field split or the render, which is exactly the code this change moved from space- to
  #      tab-separated — a classifier that dies in the split that captures it is a live class here.
  #      The stub dir IS the fake HOME's ~/.local/bin, so this tool's own `export PATH="$HOME/.local/bin:$PATH"`
  #      puts the stubs AHEAD of the real tools (a-poisoned-binary-can-lose-a-path-race-to-the-real-one).
  _e2e="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  mkdir -p "$_e2e/home/.local/bin" "$_e2e/home/.mesh"
  printf '#!/bin/sh\necho 10.0.0.9\n' > "$_e2e/home/.local/bin/mesh-phone-ip"
  printf '#!/bin/sh\ncat "$AP_FIXTURE"\n' > "$_e2e/home/.local/bin/ssh"
  printf '#!/bin/sh\nexit 0\n' > "$_e2e/home/.local/bin/mesh-state-touch"
  chmod +x "$_e2e/home/.local/bin/"*
  _e2erun() {  # $1=fixture json  $2=declared home bssids  [$3=extra argv]
    printf '%s' "$1" > "$_e2e/fixture.json"
    HOME="$_e2e/home" AP_FIXTURE="$_e2e/fixture.json" MESH_HOME_SSID="$HOME_SSID" \
      MESH_HOME_BSSID="$2" bash "$0" ${3-} 2>/dev/null
  }
  _out="$(_e2erun "$_HOME5" "94:83:c4:11:22:33")"
  case "$_out" in
    *"HOME"*"94:83:c4:11:22:33"*"identity"*) : ;;
    *) echo "  FAIL [e2e home-by-bssid]: '$_out'"; _f=1 ;;
  esac
  # the aliased case must reach the RENDER as a non-location, not just the parser
  _out="$(_e2erun '{"ssid":"GL-MT3000-765-5G","bssid":"de:ad:be:ef:00:01","rssi":-52,"frequency_mhz":5220,"supplicant_state":"COMPLETED"}' "94:83:c4:11:22:33")"
  case "$_out" in
    *"HOME-SSID-ONLY"*"NOT a location claim"*) : ;;
    *) echo "  FAIL [e2e aliased radio]: the render did not carry the aliasing: '$_out'"; _f=1 ;;
  esac
  # …and an SSID with a SPACE must not shift the render's fields (the latent layout bug)
  _out="$(_e2erun "$_sp" "")"
  case "$_out" in
    *'"Cafe Wifi 5G"'*"5GHz"*"-70dBm"*) : ;;
    *) echo "  FAIL [e2e spaced ssid]: fields shifted in the render: '$_out'"; _f=1 ;;
  esac
  # --json must carry the evidence + bssid and parse
  _out="$(_e2erun "$_HOME5" "" --json)"
  printf '%s' "$_out" | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d["evidence"]=="ssid-only" and d["bssid"]=="94:83:c4:11:22:33" and d["home_bssid_declared"] is False else 1)' \
    || { echo "  FAIL [e2e json]: evidence/bssid/declared not carried: '$_out'"; _f=1; }
  rm -rf "$_e2e"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (end-to-end render assertions above)"; exit 1; }

  # REAL-READ GATE (verification principle: assert a real hardware read produces data, not just the
  # offline parser fixtures above — the mesh-mag/mesh-gyro precedent this tool was missing entirely).
  # Unreachable phone = honest n/a, exit 2 — never a fabricated HOME/AWAY-WIFI/NO-WIFI.
  _mpip=""
  command -v mesh-phone-ip >/dev/null 2>&1 && _mpip="$(mesh-phone-ip 2>/dev/null)"
  if [ -n "$_mpip" ]; then
    _live="$(timeout 12 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${_mpip}" \
      'termux-wifi-connectioninfo' </dev/null 2>/dev/null)"
    if [ -z "$_live" ]; then
      echo "smoke-test: n/a (phone resolved but termux-wifi-connectioninfo unreachable — sense not producing; parser-logic ok)"; exit 2
    fi
    _live_parsed="$(printf '%s' "$_live" | python3 -c "$PARSE_PY" "$HOME_SSID" "$HOME_BSSID" 2>/dev/null)"
    printf '%s' "$_live_parsed" | grep -qE '^(HOME|HOME-SSID-ONLY|AWAY-WIFI|NO-WIFI|UNKNOWN-AP|PARSE-ERROR)' \
      || { echo "smoke-test: FAIL (real read did not parse to a known state: '$_live_parsed')"; exit 1; }
    echo "smoke-test: ok (parser + aliasing arms: same-SSID-other-BSSID is HOME-SSID-ONLY, declared radio buys HOME by identity, undeclared still HOME but publishes ssid-only, redacted read is UNKNOWN-AP not AWAY, spaced/quoted SSIDs do not shift fields + REAL read: $_live_parsed)"
    exit 0
  fi
  echo "smoke-test: ok (parser + aliasing arms: same-SSID-other-BSSID is HOME-SSID-ONLY, declared radio buys HOME by identity, undeclared still HOME but publishes ssid-only, redacted read is UNKNOWN-AP not AWAY, spaced/quoted SSIDs do not shift fields; phone unreachable, real-read gate skipped)"
  exit 0
}

MODE=text; EDGE=0
case "${1:-}" in --json) MODE=json ;; --edge) EDGE=1 ;; esac

# ---- Resolve phone IP ----
PHONE_IP=""
if command -v mesh-phone-ip >/dev/null 2>&1; then
  PHONE_IP="$(timeout 10 mesh-phone-ip 2>/dev/null)" || true
fi
[ -n "$PHONE_IP" ] || PHONE_IP="${MESH_PHONE_LAN_IP:-}"
if [ -z "$PHONE_IP" ]; then
  [ -f "$OFFLINEFILE" ] || printf 'phone-ap: phone unreachable\n' >&2
  mesh-state-touch --create "$OFFLINEFILE"
  exit 2
fi

# ---- Read termux-wifi-connectioninfo ----
raw="$(timeout 12 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}" \
  'termux-wifi-connectioninfo' </dev/null 2>/dev/null)" || true

if [ -z "$raw" ]; then
  [ -f "$OFFLINEFILE" ] || printf 'phone-ap: phone unreachable\n' >&2
  mesh-state-touch --create "$OFFLINEFILE"
  exit 2
fi
rm -f "$OFFLINEFILE"

# ---- Parse ----
parsed="$(printf '%s' "$raw" | python3 -c "$PARSE_PY" "$HOME_SSID" "$HOME_BSSID" 2>/dev/null)"
[ -n "$parsed" ] || parsed=$'PARSE-ERROR\t-\t0\t0\tunknown\t-\tnone' 

IFS=$'\t' read -r ap_state ssid rssi freq band bssid evidence <<< "$parsed"
: "${ap_state:=PARSE-ERROR}" "${ssid:=-}" "${rssi:=0}" "${freq:=0}" "${band:=unknown}" "${bssid:=-}" "${evidence:=none}"

# ---- Edge mode ----
if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE_FILE" 2>/dev/null || true)"
  printf '%s\n' "$ap_state" > "$STATE_FILE"
  [ "$ap_state" != "$prev" ] || exit 0
fi

# ---- Output ----
if [ "$MODE" = json ]; then
  safe_ssid="${ssid//\"/\\\"}"
  printf '{"state":"%s","ssid":"%s","rssi":%s,"freq_mhz":%s,"band":"%s","bssid":"%s","evidence":"%s","home_pat":"%s","home_bssid_declared":%s,"ts":"%s"}\n' \
    "$ap_state" "$safe_ssid" "$rssi" "$freq" "$band" "$bssid" "$evidence" "$HOME_SSID" \
    "$([ -n "$HOME_BSSID" ] && echo true || echo false)" "$TS"
else
  case "$ap_state" in
    HOME)
      if [ "$evidence" = bssid ]; then
        printf '[phone-ap] HOME — %s %s %sdBm (bssid %s — identity, not just the name)\n' "$ssid" "$band" "$rssi" "$bssid"
      else
        # THE WORD IS PUBLISHED WITH WHAT BOUGHT IT. An SSID is a name anyone may broadcast, so this
        # HOME has at least four pre-images (operator home / phone home without the operator /
        # a repeater / this travel router carried elsewhere). Naming the observed BSSID is the whole
        # remedy: one line of node-local config ends the degeneracy.
        printf '[phone-ap] HOME — %s %s %sdBm (evidence: SSID ONLY — a name, many-to-one; declare MESH_HOME_BSSID="%s" in ~/.mesh/nodes to buy this with identity)\n' "$ssid" "$band" "$rssi" "$bssid"
      fi ;;
    HOME-SSID-ONLY)
      printf '[phone-ap] HOME-SSID-ONLY — SSID "%s" matches home but bssid %s is NOT a declared home radio (%s) %s %sdBm — a repeater, the travel router carried away, or a foreign AP wearing the name. NOT a location claim.\n' "$ssid" "$bssid" "$HOME_BSSID" "$band" "$rssi" ;;
    UNKNOWN-AP)
      printf '[phone-ap] UNKNOWN-AP — Android REDACTED the read (ssid "%s" bssid %s while supplicant is COMPLETED): the location permission is withdrawn on the phone, so no location can be inferred. This is n/a, not AWAY.\n' "$ssid" "$bssid" ;;
    AWAY-WIFI)   printf '[phone-ap] AWAY-WIFI — on "%s" (bssid %s) %s %sdBm (not home)\n' "$ssid" "$bssid" "$band" "$rssi" ;;
    NO-WIFI)     printf '[phone-ap] NO-WIFI — not connected to any WiFi (LTE or offline)\n' ;;
    PARSE-ERROR) printf '[phone-ap] PARSE-ERROR\n'; exit 1 ;;
    *)           printf '[phone-ap] %s\n' "$ap_state" ;;
  esac
fi
