#!/usr/bin/env bash
# reflex-cadence: 8-59/10 * * * *
# mesh-wifi-quality — NODE WiFi LINK QUALITY sense: signal strength, link quality,
# bitrate, frequency, AP MAC, + DISCARD RATES (misc/retry/beacon-missed). Reads from
# /proc/net/wireless (kernel wireless stats) + nl80211 via `iw` for the association fields
# (ESSID/freq/BSSID/bitrates), with `iwconfig` as a FALLBACK and not as the source. Real
# hardware signal from the wireless driver.
#
# THAT ORDER IS A FIX, NOT A PREFERENCE. This header used to name iwconfig as the source, and
# iwconfig is not installed on this node (`dpkg -l wireless-tools` reads `un`) — so the parse
# returned early, four published fields were empty from the first row onward (ESSID set in 0 of
# 3366 rendered rows), and the render turned two of them into NUMBERS: `bitrate_mbps: 0` and
# `freq_ghz: "0"` on a link running at 117 MBit/s. The grammar now lives in mesh-patterns.sh
# (`link_info_read`), asks nl80211 first, publishes WHICH surface answered, and renders `na`/null
# for anything unanswered. [[a-silent-fallback-turns-a-failure-into-a-plausible-constant]]
#
# DISCARD RATES (added 2026-07-03, discover find): /proc/net/wireless exposes discard
# counters this sense used to throw away. A radio can be "sick but looks fine" — good signal,
# retry=0, yet driver-level misc discards climbing (~2/s live-proven). We emit the delta-RATE
# (against STATE_FILE) so a GOOD-signal-but-lossy link is visible instead of mis-called GOOD;
# a leading input for mesh-egress-health / the substrate invariant.
#
# WHY: the mesh monitors phone WiFi (mesh-wifi-link), AP scanning (mesh-wifiscan),
# and passive radar (mesh-wifi-motion) — but has NO tool for the node's own WiFi
# link quality. This fills that gap.
#
#   mesh-wifi-quality              one-line signal state
#   mesh-wifi-quality --json       machine-readable {signal_dbm, link_pct, bitrate, ...}
#   mesh-wifi-quality --test       smoke test (synthetic /proc/net/wireless fixture)
#
# Exit codes:
#   0 = assessment produced (DISCONNECTED is a real assessment, not an error)
#   2 = no wireless interface or /proc/net/wireless unreadable
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PROC_WIRELESS="/proc/net/wireless"
STATE_FILE="$HOME/.mesh/.wifi-quality-state"

# --- Parse /proc/net/wireless ---
# Format: "  iface: status link level noise ..."
# link/level/noise are in dBm (level is negative). link is link quality (0-70 on this driver).
parse_proc_wireless() {
  local iface="$1"
  awk -v iface="$iface" '
    $1 ~ "^"iface":" {
      # fields: iface: status link level noise ...
      gsub(/:/, "", $1)
      printf "%s %s %s", $2, $3, $4   # status link level
      exit
    }
  ' "$PROC_WIRELESS" 2>/dev/null
}

# --- Level sentinel guard + retry-sampled read (driver-race class) ---
# Some USB drivers (rtl88XXau, mesh-home's uplink) intermittently emit an INVALID level of -256
# (paired with link snapping to 70) in /proc/net/wireless — a "driver not ready" sentinel that
# alternates with the real reading (~-48 dBm, live-proven ~50% of samples 2026-07-14). A single
# sample landing on -256 mis-reports a strong link as WEAK/POOR. level_valid rejects it; a real
# WiFi level is never below -200 dBm. (mesh-mag/mesh-gyro -n 2 driver-race fix, same class.)
# WIDENED 2026-08-24 (task {#43f0d1be}): that bound is a MAGNITUDE test and it worked only because
# -256 is out of range. The SAME driver blindness is rendered by nl80211 as a PERFECT 0 dBm — in
# range, well-formed, MAXIMAL, and accepted by every bound. Both renderings are now one predicate,
# rssi_valid in mesh-patterns.sh, so widening it again happens in ONE place.
# The RSSI sentinel grammar is SHARED (mesh-patterns.sh): ONE blindness, TWO renderings — the same
# blind instant this file has guarded as -256 since 2026-07-14 is rendered by nl80211 as a PERFECT
# 0 dBm, which this magnitude bound accepted because 0 is IN range (task {#43f0d1be}, 2026-08-24).
# The inline fallback is the SAME predicate, never a laxer one, so a node without the lib is not a
# node with the hole re-opened.
source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
command -v rssi_valid >/dev/null 2>&1 || { RSSI_GRAMMAR_SRC=inline; rssi_valid() {
  local v="${1:-}"; v="${v% dBm}"; v="${v%dBm}"; v="${v%.}"
  case "$v" in ''|-|NA|na|n/a) return 1;; esac
  case "$v" in *[!0-9.-]*) return 1;; esac
  case "$v" in *.*) v="${v%%.*}";; esac
  case "$v" in ''|-) return 1;; esac
  [ "$v" -lt 0 ] 2>/dev/null || return 1
  [ "$v" -gt "${RSSI_MIN_DBM:--200}" ] 2>/dev/null
}; }
level_valid() { rssi_valid "$1"; }   # the name this file's call sites use; the grammar is the shared one
# Retry-sample; keep the first read with a plausible level. All-invalid → return the last sample
# so a genuinely dead link still reads honestly (DISCONNECTED), never a faked value.
read_valid_wireless() {
  local iface="$1" tries="${MESH_WIFI_SAMPLES:-6}" out level i
  for i in $(seq 1 "$tries"); do
    out="$(parse_proc_wireless "$iface")"
    level="$(printf '%s' "$out" | awk '{print $3}')"
    level_valid "$level" && { printf '%s' "$out"; return; }
    sleep 0.25
  done
  printf '%s' "$out"
}

# --- Parse discard counters from /proc/net/wireless (the columns this sense historically dropped) ---
# Fields after "iface:": status link level noise | nwid crypt frag retry misc | beacon-missed
#   $9=retry  $10=misc  $11=beacon-missed  (integer counters, cumulative since driver load)
#   $11 IS DEAD ZERO ON rtw88 — the parse is right, the source is empty. It is re-sourced
#   from nl80211 below and never published as a bare 0; see mesh-patterns.sh.
# HEADLINE: misc climbs on driver-level packet discards → a radio "sick but looks fine" (good
# signal, retry=0, yet misc climbing). discover PROVED it live 2026-07-03: misc +~2/s while
# signal=-66dBm GOOD. wifi-quality used to read only status/link/level and call that link GOOD.
parse_proc_discards() {
  local iface="$1"
  awk -v iface="$iface" '
    $1 ~ "^"iface":" {
      gsub(/:/, "", $1)
      printf "%s %s %s", $9+0, $10+0, $11+0   # retry misc beacon-missed
      exit
    }
  ' "$PROC_WIRELESS" 2>/dev/null
}

# --- JSON scalar helpers (defined HERE, above --test, so the gate can drive them) ---
_jnum(){ [ "$1" = "na" ] && printf 'null' || printf '%s' "$1"; }
# A string field carries its OWN quotes so that unanswered can be bare `null`. `""` would not do:
# an SSID may legitimately BE empty (a hidden network broadcasts one), so an empty string is a
# possible READING and must not double as the blindness sentinel.
# [[a-blindness-sentinel-fused-as-a-reading]]
# Backslash first, then the quote — the other order escapes the backslash this step just inserted.
_jstr(){
  [ "$1" = "na" ] && { printf 'null'; return; }
  local v="$1"; v="${v//\\/\\\\}"; v="${v//\"/\\\"}"
  printf '"%s"' "$v"
}

# --- Find the active wireless interface ---
find_wifi_iface() {
  local iface=""
  for f in /sys/class/net/*/wireless; do
    [ -d "$f" ] || continue
    iface="$(basename "$(dirname "$f")")"
    break
  done
  echo "$iface"
}

# --- Signal classification ---
# classify_signal <signal_dbm> → EXCELLENT|GOOD|FAIR|WEAK|DISCONNECTED
classify_signal() {
  local sig="${1:-}"
  case "$sig" in ''|*[!0-9-]*) echo DISCONNECTED; return;; esac
  if   [ "$sig" -ge -50 ]; then echo EXCELLENT
  elif [ "$sig" -ge -65 ]; then echo GOOD
  elif [ "$sig" -ge -75 ]; then echo FAIR
  else echo WEAK; fi
}

# --- Smoke test ---
if [ "${1:-}" = --test ]; then
  for dep in awk sed date stat; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; exit 1; }
  done
  _f=0
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT

  # Synthetic /proc/net/wireless with known values
  cat > "$_td/wireless" <<'FIX'
Inter-| sta-|   Quality        |   Discarded packets               | Missed | WE
 face | tus | link level noise |  nwid  crypt   frag  retry  misc | beacon | 22
wlan0: 0000   62.  -48.  -256        0      0      0      0     0        0
FIX

  # Parse: should extract "0000 62. -48." for wlan0 (dots stripped by live path)
  r="$(awk '$1 ~ "^wlan0:" {gsub(/:/,"",$1); printf "%s %s %s", $2,$3,$4; exit}' "$_td/wireless")"
  r="${r//./}"   # strip dots to match live path behavior
  [ "$r" = "0000 62 -48" ] || { echo "  FAIL: parse wlan0 → '$r'"; _f=1; }

  # classify_signal boundary tests
  [ "$(classify_signal -45)" = EXCELLENT ] || { echo "  FAIL: -45 → EXCELLENT"; _f=1; }
  [ "$(classify_signal -55)" = GOOD ]     || { echo "  FAIL: -55 → GOOD";     _f=1; }
  [ "$(classify_signal -70)" = FAIR ]     || { echo "  FAIL: -70 → FAIR";     _f=1; }
  [ "$(classify_signal -85)" = WEAK ]     || { echo "  FAIL: -85 → WEAK";     _f=1; }
  [ "$(classify_signal nope)" = DISCONNECTED ] || { echo "  FAIL: non-numeric → DISCONNECTED"; _f=1; }
  [ "$(classify_signal)" = DISCONNECTED ]     || { echo "  FAIL: empty → DISCONNECTED";       _f=1; }

  # level_valid: the -256 driver sentinel (rtl88XXau flap) must be REJECTED, real dBm accepted
  level_valid -48   || { echo "  FAIL: level_valid -48 should be valid"; _f=1; }
  level_valid -50.  || { echo "  FAIL: level_valid -50. (trailing dot) should be valid"; _f=1; }
  level_valid -256  && { echo "  FAIL: level_valid -256 sentinel should be REJECTED"; _f=1; }
  level_valid -256. && { echo "  FAIL: level_valid -256. sentinel should be REJECTED"; _f=1; }
  # ONE blindness, TWO renderings (task {#43f0d1be}): nl80211 renders the instant this file has
  # rejected as -256 since 2026-07-14 as a PERFECT 0 dBm instead — in range, well-formed, MAXIMAL,
  # and accepted by any magnitude bound. Red if the predicate is ever narrowed back to a bound.
  level_valid 0     && { echo "  FAIL: 0 dBm is the driver's OTHER blind rendering, not a perfect link"; _f=1; }
  level_valid 0.    && { echo "  FAIL: 0. is the same sentinel with the trailing dot"; _f=1; }
  level_valid 7     && { echo "  FAIL: a receiver RSSI is never positive"; _f=1; }
  level_valid -200  && { echo "  FAIL: level_valid -200 should be rejected (< -199)"; _f=1; }
  level_valid ''    && { echo "  FAIL: level_valid empty should be rejected"; _f=1; }

  # Boundary: exactly -50 = EXCELLENT
  [ "$(classify_signal -50)" = EXCELLENT ] || { echo "  FAIL: -50 boundary"; _f=1; }
  # Boundary: -64 = GOOD (not EXCELLENT)
  [ "$(classify_signal -64)" = GOOD ] || { echo "  FAIL: -64 boundary"; _f=1; }
  # Boundary: -74 = FAIR (not GOOD)
  [ "$(classify_signal -74)" = FAIR ] || { echo "  FAIL: -74 boundary"; _f=1; }

  # Link quality percentage calculation: 62/70 = ~88%
  q="$(awk 'BEGIN{printf "%d", (62/70)*100}')"
  [ "$q" = "88" ] || { echo "  FAIL: 62/70 → $q% (expected 88)"; _f=1; }

  # parse_proc_discards: extract retry/misc/beacon-missed (the columns wifi-quality used to drop)
  cat > "$_td/wireless2" <<'FIX'
Inter-| sta-|   Quality        |   Discarded packets               | Missed | WE
 face | tus | link level noise |  nwid  crypt   frag  retry  misc | beacon | 22
wlan0: 0000   44.  -66.  -256        0      0      0      3 438991        7
FIX
  dr="$(awk '$1 ~ "^wlan0:" {gsub(/:/,"",$1); printf "%s %s %s", $9+0,$10+0,$11+0; exit}' "$_td/wireless2")"
  [ "$dr" = "3 438991 7" ] || { echo "  FAIL: parse_proc_discards → '$dr' (expected '3 438991 7')"; _f=1; }
  # delta-rate: (misc_now - misc_last)/dt — the live "sick-but-looks-fine" signal (discover: ~2/s)
  rr="$(awk 'BEGIN{printf "%.2f", (1200-0)/600}')"
  [ "$rr" = "2.00" ] || { echo "  FAIL: misc-rate (1200/600) → $rr (expected 2.00)"; _f=1; }
  # counter reset guard: now < last must NOT emit a rate (stays "?"), not a negative/garbage number
  rst="ok"; [ 5 -ge 99 ] 2>/dev/null && rst="bad"
  [ "$rst" = "ok" ] || { echo "  FAIL: counter-reset guard (now<last) computed a rate"; _f=1; }

  # Live path: verify /proc/net/wireless exists and has data
  if [ -r "$PROC_WIRELESS" ]; then
    _iface="$(find_wifi_iface)"
    [ -n "$_iface" ] || { echo "smoke-test: FAIL (no wireless iface)"; exit 1; }
  else
    echo "smoke-test: FAIL ($PROC_WIRELESS not readable)"; exit 1
  fi

  # ---- JSON scalar helpers, driven by FIXTURE ------------------------------------------------
  # These arms must NOT depend on the node's association state. On an associated node the live arm
  # below never reaches the `na` branch, so a mutant that renders absence as `0` or `""` passes it.
  # [[a-fixture-driven-gate-cannot-cover-the-live-path]] — the inverse also holds, so both run.
  [ "$(_jnum na)" = "null" ] || { echo "  FAIL: _jnum na -> '$(_jnum na)' — absence must be null, never 0"; _f=1; }
  [ "$(_jnum 52.0)" = "52.0" ] || { echo "  FAIL: _jnum passes a real number through unchanged"; _f=1; }
  [ "$(_jstr na)" = "null" ] || { echo "  FAIL: _jstr na -> '$(_jstr na)' — an empty string is a possible SSID and cannot be the sentinel"; _f=1; }
  [ "$(_jstr foo)" = '"foo"' ] || { echo "  FAIL: _jstr carries its own quotes"; _f=1; }
  [ "$(_jstr '')" = '""' ] || { echo "  FAIL: a genuinely EMPTY ssid (hidden network) must render \"\", not null"; _f=1; }

  # ---- LIVE association fields: a real hardware read, asserted in BOTH directions -------------
  # The defect this covers shipped for 3366 rows: an absent dependency rendered as `bitrate_mbps: 0`
  # and `freq_ghz: "0"`, which a consumer reads as a link carrying nothing rather than as silence.
  # So the arm is not "the fields are filled" — on an unassociated node they must NOT be — it is
  # that filled and unfilled are the two consistent halves of one answer, and neither wears a 0.
  # Re-exec by RESOLVED PATH, never bare $0: a bare name resolves through PATH to the deployed twin
  # and the arm would then bless a copy this run never touched.
  # [[a-test-re-exec-of-dollar-zero-resolves-to-the-deployed-twin]]
  _self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  _lj="$(bash "$_self" --json 2>/dev/null)"
  _f_get(){ printf '%s' "$_lj" | sed -nE "s/.*\"$1\":(\"[^\"]*\"|[^,}]*).*/\1/p"; }
  _assoc="$(_f_get link_assoc)"; _assoc="${_assoc//\"/}"
  _lsrc="$(_f_get link_info_src)"; _lsrc="${_lsrc//\"/}"
  case "$_assoc" in
    yes)
      for _fld in bitrate_mbps rx_bitrate_mbps freq_ghz; do
        _v="$(_f_get "$_fld")"
        [ -n "$_v" ] && [ "$_v" != "null" ] && [ "$_v" != "0" ] \
          || { echo "  FAIL: live assoc=yes but $_fld is '$_v' (must be a real number, never null/0)"; _f=1; }
      done
      _e="$(_f_get essid)"
      [ "$_e" != 'null' ] && [ "$_e" != '""' ] && [ -n "$_e" ] \
        || { echo "  FAIL: live assoc=yes but essid is '$_e' — the exact 0-of-3366 defect"; _f=1; }
      # A quote or backslash in an SSID must not be able to break the JSON this sense publishes.
      _jq_ssid='My "Odd" \ Net'
      _jq_out="$(_jstr "$_jq_ssid")"
      printf '{"s":%s}' "$_jq_out" | python3 -c 'import sys,json; json.load(sys.stdin)' 2>/dev/null \
        || { echo "  FAIL: an SSID containing a quote/backslash produces invalid JSON: $_jq_out"; _f=1; }
      [ "$_lsrc" = nl80211 ] || [ "$_lsrc" = iwconfig ] \
        || { echo "  FAIL: assoc=yes with link_info_src='$_lsrc' — a value with no surface behind it"; _f=1; }
      ;;
    no|unknown)
      # Not associated (or nobody could answer): the fields must be null/empty. A 0 here would be
      # the original bug wearing a different cause.
      for _fld in bitrate_mbps rx_bitrate_mbps freq_ghz; do
        _v="$(_f_get "$_fld")"
        [ "$_v" = "null" ] || { echo "  FAIL: assoc=$_assoc but $_fld is '$_v' — absence must render null, never 0"; _f=1; }
      done
      ;;
    *) echo "  FAIL: link_assoc='$_assoc' is not one of yes/no/unknown"; _f=1;;
  esac

  [ "$_f" = 0 ] || { echo "smoke-test: FAIL ($_f assertion(s))"; exit 1; }
  echo "smoke-test: ok (parse:1 + classify:6 + boundary:3 + pct:1 + discards:1 + rate:1 + reset-guard:1 + live:$_iface assoc:$_assoc/$_lsrc)"
  exit 0
fi

# --- Find wireless interface ---
IFACE="$(find_wifi_iface)"
[ -n "$IFACE" ] || { echo "mesh-wifi-quality: no wireless interface" >&2; exit 2; }

# --- Read /proc/net/wireless ---
[ -r "$PROC_WIRELESS" ] || { echo "mesh-wifi-quality: $PROC_WIRELESS not readable" >&2; exit 2; }
read -r status link_q raw_level <<< "$(read_valid_wireless "$IFACE")"
[ -n "$raw_level" ] || { echo "mesh-wifi-quality: no data for $IFACE in $PROC_WIRELESS" >&2; exit 2; }

# Strip trailing dot (kernel outputs "46." not "46")
link_q="${link_q%.}"
raw_level="${raw_level%.}"
signal="${raw_level}"  # already negative dBm

# --- Link quality percentage ---
# /proc/net/wireless link field is driver-specific (0-70 on iwlwifi, 0-100 on others).
# We compute a normalized % from the raw value — the denominator varies by driver.
# Heuristic: if link_q <= 70, denominator is 70; else denominator is 100.
if [ "$link_q" -le 70 ] 2>/dev/null; then
  link_pct="$(awk "BEGIN{printf \"%.0f\", ($link_q/70)*100}")"
else
  link_pct="$link_q"
fi

# --- Association fields (ESSID/freq/BSSID/bitrates) — nl80211 first, iwconfig only as fallback ---
# One `key=value` per line, read with IFS='=' so an SSID containing spaces or '=' survives whole;
# a positional split would mangle exactly the networks with human-written names.
if declare -F link_info_read >/dev/null 2>&1; then
  _li_out="$(link_info_read "$IFACE")"
else
  # Inline fallback for a node without the lib — THE SAME predicate and the same field set, and it
  # says which grammar answered so that is a checkable fact rather than a comment.
  LINK_INFO_GRAMMAR_SRC="inline"
  _li_out=""
  if [ -n "$IFACE" ] && command -v iw >/dev/null 2>&1; then
    _li_raw="$(iw dev "$IFACE" link 2>/dev/null)"
    case "$_li_raw" in
      *"Connected to"*)
        _li_out="$(printf '%s\n' \
          "ssid=$(printf '%s\n' "$_li_raw" | sed -nE 's/^[[:space:]]*SSID: (.*)$/\1/p' | head -1)" \
          "bssid=$(printf '%s\n' "$_li_raw" | sed -nE 's/^Connected to ([0-9A-Fa-f:]+).*/\1/p' | head -1)" \
          "freq_mhz=$(printf '%s\n' "$_li_raw" | sed -nE 's/^[[:space:]]*freq: ([0-9.]+).*/\1/p' | head -1)" \
          "rx_mbps=$(printf '%s\n' "$_li_raw" | sed -nE 's/^[[:space:]]*rx bitrate: ([0-9.]+) .*/\1/p' | head -1)" \
          "tx_mbps=$(printf '%s\n' "$_li_raw" | sed -nE 's/^[[:space:]]*tx bitrate: ([0-9.]+) .*/\1/p' | head -1)" \
          "assoc=yes" "src=nl80211")"
        ;;
      *"Not connected"*) _li_out=$'assoc=no\nsrc=nl80211';;
    esac
  fi
fi
essid="na"; ap_mac="na"; freq_mhz="na"; rx_mbps="na"; tx_mbps="na"; link_assoc="unknown"; link_src="none"
while IFS='=' read -r _k _v; do
  [ -n "$_k" ] || continue
  case "$_k" in
    ssid)     essid="${_v:-na}";;
    bssid)    ap_mac="${_v:-na}";;
    freq_mhz) freq_mhz="${_v:-na}";;
    rx_mbps)  rx_mbps="${_v:-na}";;
    tx_mbps)  tx_mbps="${_v:-na}";;
    assoc)    link_assoc="${_v:-unknown}";;
    src)      link_src="${_v:-none}";;
  esac
done <<< "$_li_out"
# freq is carried in MHz end-to-end and converted ONCE, here, for the field that is named _ghz.
freq="na"; [ "$freq_mhz" != "na" ] && freq="$(awk -v m="$freq_mhz" 'BEGIN{printf "%.3f", m/1000}')"
# JSON: `null`, never 0. A bitrate of 0 is a link carrying nothing — a loud reading — and it was
# published continuously by a link running at 117 MBit/s. [[a-blindness-sentinel-fused-as-a-reading]]

# --- Classify ---
signal_class="$(classify_signal "$signal")"

# --- Discard counters + delta-rate (the "sick-but-looks-fine" signal wifi-quality used to drop) ---
# Cumulative counters → the RATE (delta/dt against STATE_FILE) is the live signal, not the total.
# honest-fusion: first run (no baseline) or a counter reset (reboot/driver reload → now < last)
# emits "?" for that interval — never a faked 0 that would read as "healthy radio".
read -r d_retry d_misc d_beacon <<< "$(parse_proc_discards "$IFACE")"
# COLUMN 11 IS DEAD ZERO ON rtw88 AND THE PARSE ABOVE IS CORRECT — the source is empty, not the
# awk. Measured 2026-08-26: 3364/3364 readings in this tool's own log carried beacon-missed=0 while
# nl80211 read `beacon loss: 9` in the same association. The trap is the NEIGHBOUR: column 10
# (misc) tracks nl80211's `rx drop misc` exactly (950 vs 951), so the block looks alive and a
# careless check blesses the whole row. One grammar decides which surface answered; see
# mesh-patterns.sh. [[a-silent-fallback-turns-a-failure-into-a-plausible-constant]]
if command -v beacon_missed_read >/dev/null 2>&1 || declare -F beacon_missed_read >/dev/null 2>&1; then
  bm_pair="$(beacon_missed_read "$IFACE" "$d_beacon")"
else
  # Inline fallback — THE SAME predicate, never a laxer one, and it names itself.
  BEACON_GRAMMAR_SRC="inline"
  _bm_nl=""
  if command -v iw >/dev/null 2>&1; then
    _bm_nl="$(iw dev "$IFACE" station dump 2>/dev/null \
              | awk -F: '/beacon loss:/{gsub(/[^0-9]/,"",$2); if ($2 != "") {print $2; exit}}')"
    case "$_bm_nl" in ''|*[!0-9]*) _bm_nl="";; esac
  fi
  if [ -n "$_bm_nl" ]; then bm_pair="$_bm_nl nl80211"
  elif [ -n "$d_beacon" ] && [ "$d_beacon" -gt 0 ] 2>/dev/null; then bm_pair="$d_beacon proc"
  else bm_pair="na none"; fi
fi
d_beacon="${bm_pair%% *}"; d_beacon_src="${bm_pair##* }"
d_beacon_json="$d_beacon"; [ "$d_beacon" = "na" ] && d_beacon_json="null"
now_epoch="$(date -u +%s)"
misc_rate="?"; retry_rate="?"
if [ -r "$STATE_FILE" ]; then
  read -r last_epoch last_misc last_retry < "$STATE_FILE" 2>/dev/null || true
  if [ -n "${last_epoch:-}" ] && [ "$now_epoch" -gt "${last_epoch:-0}" ] 2>/dev/null; then
    dt=$(( now_epoch - last_epoch ))
    [ "${d_misc:-0}"  -ge "${last_misc:-0}"  ] 2>/dev/null && misc_rate="$(awk "BEGIN{printf \"%.2f\", ($d_misc-$last_misc)/$dt}")"
    [ "${d_retry:-0}" -ge "${last_retry:-0}" ] 2>/dev/null && retry_rate="$(awk "BEGIN{printf \"%.2f\", ($d_retry-$last_retry)/$dt}")"
  fi
fi
# liveness-touch: STATE_FILE rewritten EVERY run (mtime = ran-live), content = the rate baseline
printf '%s %s %s\n' "$now_epoch" "${d_misc:-0}" "${d_retry:-0}" > "$STATE_FILE" 2>/dev/null || true

# --- Timestamp ---
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- Output ---
if [ "${1:-}" = --json ]; then
  # bitrate_mbps keeps its historical meaning (the TX rate, which is all `Bit Rate=` ever was);
  # rx_bitrate_mbps is NEW rather than folded in, because rx and tx are different counters — 117.0
  # against 52.0 in one instant here — and one field cannot carry both without discarding one.
  printf '{"signal_dbm":%s,"signal_class":"%s","link_quality":%s,"link_pct":%s,"bitrate_mbps":%s,"rx_bitrate_mbps":%s,"freq_ghz":%s,"essid":%s,"ap_mac":%s,"link_assoc":"%s","link_info_src":"%s","link_info_grammar":"%s","iface":"%s","discard_misc_total":%s,"discard_retry_total":%s,"discard_beacon_missed":%s,"discard_beacon_missed_src":"%s","beacon_grammar":"%s","discard_misc_rate":"%s","discard_retry_rate":"%s","ts":"%s"}\n' \
    "$signal" "$signal_class" "$link_q" "$link_pct" "$(_jnum "$tx_mbps")" "$(_jnum "$rx_mbps")" "$(_jnum "$freq")" "$(_jstr "$essid")" "$(_jstr "$ap_mac")" "$link_assoc" "$link_src" "${LINK_INFO_GRAMMAR_SRC:-inline}" "$IFACE" "${d_misc:-0}" "${d_retry:-0}" "${d_beacon_json:-null}" "${d_beacon_src:-none}" "${BEACON_GRAMMAR_SRC:-inline}" "$misc_rate" "$retry_rate" "$ts"
else
  printf '[wifi-quality] %s — signal=%s dBm (%s) link=%s/%s (%s%%) bitrate=%s/%s Mb/s (tx/rx) freq=%s GHz essid=%s ap=%s assoc=%s(src=%s) discard_misc=%s/s (total=%s) retry=%s/s beacon-missed=%s(src=%s)\n' \
    "$signal_class" "$signal" "$signal_class" "$link_q" "70" "$link_pct" "$tx_mbps" "$rx_mbps" "$freq" "$essid" "$ap_mac" "$link_assoc" "$link_src" "$misc_rate" "${d_misc:-0}" "$retry_rate" "${d_beacon:-na}" "${d_beacon_src:-none}"
fi
