#!/usr/bin/env bash
# reflex-cadence: 8-59/10 * * * *
# mesh-wifi-quality — NODE WiFi LINK QUALITY sense: signal strength, link quality,
# bitrate, frequency, AP MAC, + DISCARD RATES (misc/retry/beacon-missed). Reads from
# /proc/net/wireless (kernel wireless stats) + iwconfig (ESSID/frequency/bitrate). Real
# hardware signal from the wireless driver.
#
# DISCARD RATES (added 2026-07-03, discover find): /proc/net/wireless exposes discard
# counters this sense used to throw away. A radio can be "sick but looks fine" — good signal,
# retry=0, yet driver-level misc discards climbing (~2/s live-proven). We emit the delta-RATE
# (against STATE_FILE) so a GOOD-signal-but-lossy link is visible instead of mis-called GOOD;
# a leading input for mesh-egress-health / the substrate invariant.
#
# WHY: the mesh monitors phone WiFi (mesh-wifi-link), AP scanning (mesh-wifiscan),
# and passive radar (mesh-wifi-motion) — but has NO tool for the node's own WiFi
# link quality. This fills that gap.
#
#   mesh-wifi-quality              one-line signal state
#   mesh-wifi-quality --json       machine-readable {signal_dbm, link_pct, bitrate, ...}
#   mesh-wifi-quality --test       smoke test (synthetic /proc/net/wireless fixture)
#
# Exit codes:
#   0 = assessment produced (DISCONNECTED is a real assessment, not an error)
#   2 = no wireless interface or /proc/net/wireless unreadable
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PROC_WIRELESS="/proc/net/wireless"
STATE_FILE="$HOME/.mesh/.wifi-quality-state"

# --- Parse /proc/net/wireless ---
# Format: "  iface: status link level noise ..."
# link/level/noise are in dBm (level is negative). link is link quality (0-70 on this driver).
parse_proc_wireless() {
  local iface="$1"
  awk -v iface="$iface" '
    $1 ~ "^"iface":" {
      # fields: iface: status link level noise ...
      gsub(/:/, "", $1)
      printf "%s %s %s", $2, $3, $4   # status link level
      exit
    }
  ' "$PROC_WIRELESS" 2>/dev/null
}

# --- Parse discard counters from /proc/net/wireless (the columns this sense historically dropped) ---
# Fields after "iface:": status link level noise | nwid crypt frag retry misc | beacon-missed
#   $9=retry  $10=misc  $11=beacon-missed  (integer counters, cumulative since driver load)
# HEADLINE: misc climbs on driver-level packet discards → a radio "sick but looks fine" (good
# signal, retry=0, yet misc climbing). discover PROVED it live 2026-07-03: misc +~2/s while
# signal=-66dBm GOOD. wifi-quality used to read only status/link/level and call that link GOOD.
parse_proc_discards() {
  local iface="$1"
  awk -v iface="$iface" '
    $1 ~ "^"iface":" {
      gsub(/:/, "", $1)
      printf "%s %s %s", $9+0, $10+0, $11+0   # retry misc beacon-missed
      exit
    }
  ' "$PROC_WIRELESS" 2>/dev/null
}

# --- Parse iwconfig for a specific interface ---
# Returns: essid freq ghz ap_mac bitrate_mbps
parse_iwconfig() {
  local iface="$1"
  local essid="" freq="" ap="" bitrate=""
  local iw_out
  iw_out="$(iwconfig "$iface" 2>/dev/null)" || return
  essid="$(printf '%s' "$iw_out" | sed -nE 's/.*ESSID:"([^"]*)".*/\1/p' | head -1)"
  freq="$(printf '%s' "$iw_out" | sed -nE 's/.*Frequency:([0-9.]+) .*/\1/p' | head -1)"
  ap="$(printf '%s' "$iw_out" | sed -nE 's/.*Access Point: ([0-9A-Fa-f:]+).*/\1/p' | head -1)"
  bitrate="$(printf '%s' "$iw_out" | sed -nE 's/.*Bit Rate=([0-9.]+) .*/\1/p' | head -1)"
  printf '%s %s %s %s' "${essid:-?}" "${freq:-0}" "${ap:-?}" "${bitrate:-0}"
}

# --- Find the active wireless interface ---
find_wifi_iface() {
  local iface=""
  for f in /sys/class/net/*/wireless; do
    [ -d "$f" ] || continue
    iface="$(basename "$(dirname "$f")")"
    break
  done
  echo "$iface"
}

# --- Signal classification ---
# classify_signal <signal_dbm> → EXCELLENT|GOOD|FAIR|WEAK|DISCONNECTED
classify_signal() {
  local sig="${1:-}"
  case "$sig" in ''|*[!0-9-]*) echo DISCONNECTED; return;; esac
  if   [ "$sig" -ge -50 ]; then echo EXCELLENT
  elif [ "$sig" -ge -65 ]; then echo GOOD
  elif [ "$sig" -ge -75 ]; then echo FAIR
  else echo WEAK; fi
}

# --- Smoke test ---
if [ "${1:-}" = --test ]; then
  for dep in awk sed date stat; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; exit 1; }
  done
  _f=0
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT

  # Synthetic /proc/net/wireless with known values
  cat > "$_td/wireless" <<'FIX'
Inter-| sta-|   Quality        |   Discarded packets               | Missed | WE
 face | tus | link level noise |  nwid  crypt   frag  retry  misc | beacon | 22
wlan0: 0000   62.  -48.  -256        0      0      0      0     0        0
FIX

  # Parse: should extract "0000 62. -48." for wlan0 (dots stripped by live path)
  r="$(awk '$1 ~ "^wlan0:" {gsub(/:/,"",$1); printf "%s %s %s", $2,$3,$4; exit}' "$_td/wireless")"
  r="${r//./}"   # strip dots to match live path behavior
  [ "$r" = "0000 62 -48" ] || { echo "  FAIL: parse wlan0 → '$r'"; _f=1; }

  # classify_signal boundary tests
  [ "$(classify_signal -45)" = EXCELLENT ] || { echo "  FAIL: -45 → EXCELLENT"; _f=1; }
  [ "$(classify_signal -55)" = GOOD ]     || { echo "  FAIL: -55 → GOOD";     _f=1; }
  [ "$(classify_signal -70)" = FAIR ]     || { echo "  FAIL: -70 → FAIR";     _f=1; }
  [ "$(classify_signal -85)" = WEAK ]     || { echo "  FAIL: -85 → WEAK";     _f=1; }
  [ "$(classify_signal nope)" = DISCONNECTED ] || { echo "  FAIL: non-numeric → DISCONNECTED"; _f=1; }
  [ "$(classify_signal)" = DISCONNECTED ]     || { echo "  FAIL: empty → DISCONNECTED";       _f=1; }

  # Boundary: exactly -50 = EXCELLENT
  [ "$(classify_signal -50)" = EXCELLENT ] || { echo "  FAIL: -50 boundary"; _f=1; }
  # Boundary: -64 = GOOD (not EXCELLENT)
  [ "$(classify_signal -64)" = GOOD ] || { echo "  FAIL: -64 boundary"; _f=1; }
  # Boundary: -74 = FAIR (not GOOD)
  [ "$(classify_signal -74)" = FAIR ] || { echo "  FAIL: -74 boundary"; _f=1; }

  # Link quality percentage calculation: 62/70 = ~88%
  q="$(awk 'BEGIN{printf "%d", (62/70)*100}')"
  [ "$q" = "88" ] || { echo "  FAIL: 62/70 → $q% (expected 88)"; _f=1; }

  # parse_proc_discards: extract retry/misc/beacon-missed (the columns wifi-quality used to drop)
  cat > "$_td/wireless2" <<'FIX'
Inter-| sta-|   Quality        |   Discarded packets               | Missed | WE
 face | tus | link level noise |  nwid  crypt   frag  retry  misc | beacon | 22
wlan0: 0000   44.  -66.  -256        0      0      0      3 438991        7
FIX
  dr="$(awk '$1 ~ "^wlan0:" {gsub(/:/,"",$1); printf "%s %s %s", $9+0,$10+0,$11+0; exit}' "$_td/wireless2")"
  [ "$dr" = "3 438991 7" ] || { echo "  FAIL: parse_proc_discards → '$dr' (expected '3 438991 7')"; _f=1; }
  # delta-rate: (misc_now - misc_last)/dt — the live "sick-but-looks-fine" signal (discover: ~2/s)
  rr="$(awk 'BEGIN{printf "%.2f", (1200-0)/600}')"
  [ "$rr" = "2.00" ] || { echo "  FAIL: misc-rate (1200/600) → $rr (expected 2.00)"; _f=1; }
  # counter reset guard: now < last must NOT emit a rate (stays "?"), not a negative/garbage number
  rst="ok"; [ 5 -ge 99 ] 2>/dev/null && rst="bad"
  [ "$rst" = "ok" ] || { echo "  FAIL: counter-reset guard (now<last) computed a rate"; _f=1; }

  # Live path: verify /proc/net/wireless exists and has data
  if [ -r "$PROC_WIRELESS" ]; then
    _iface="$(find_wifi_iface)"
    [ -n "$_iface" ] || { echo "smoke-test: FAIL (no wireless iface)"; exit 1; }
  else
    echo "smoke-test: FAIL ($PROC_WIRELESS not readable)"; exit 1
  fi

  [ "$_f" = 0 ] || { echo "smoke-test: FAIL ($_f assertion(s))"; exit 1; }
  echo "smoke-test: ok (parse:1 + classify:6 + boundary:3 + pct:1 + discards:1 + rate:1 + reset-guard:1 + live:$_iface)"
  exit 0
fi

# --- Find wireless interface ---
IFACE="$(find_wifi_iface)"
[ -n "$IFACE" ] || { echo "mesh-wifi-quality: no wireless interface" >&2; exit 2; }

# --- Read /proc/net/wireless ---
[ -r "$PROC_WIRELESS" ] || { echo "mesh-wifi-quality: $PROC_WIRELESS not readable" >&2; exit 2; }
read -r status link_q raw_level <<< "$(parse_proc_wireless "$IFACE")"
[ -n "$raw_level" ] || { echo "mesh-wifi-quality: no data for $IFACE in $PROC_WIRELESS" >&2; exit 2; }

# Strip trailing dot (kernel outputs "46." not "46")
link_q="${link_q%.}"
raw_level="${raw_level%.}"
signal="${raw_level}"  # already negative dBm

# --- Link quality percentage ---
# /proc/net/wireless link field is driver-specific (0-70 on iwlwifi, 0-100 on others).
# We compute a normalized % from the raw value — the denominator varies by driver.
# Heuristic: if link_q <= 70, denominator is 70; else denominator is 100.
if [ "$link_q" -le 70 ] 2>/dev/null; then
  link_pct="$(awk "BEGIN{printf \"%.0f\", ($link_q/70)*100}")"
else
  link_pct="$link_q"
fi

# --- Read iwconfig for ESSID/freq/bitrate/AP ---
read -r essid freq ap_mac bitrate <<< "$(parse_iwconfig "$IFACE")"

# --- Classify ---
signal_class="$(classify_signal "$signal")"

# --- Discard counters + delta-rate (the "sick-but-looks-fine" signal wifi-quality used to drop) ---
# Cumulative counters → the RATE (delta/dt against STATE_FILE) is the live signal, not the total.
# honest-fusion: first run (no baseline) or a counter reset (reboot/driver reload → now < last)
# emits "?" for that interval — never a faked 0 that would read as "healthy radio".
read -r d_retry d_misc d_beacon <<< "$(parse_proc_discards "$IFACE")"
now_epoch="$(date -u +%s)"
misc_rate="?"; retry_rate="?"
if [ -r "$STATE_FILE" ]; then
  read -r last_epoch last_misc last_retry < "$STATE_FILE" 2>/dev/null || true
  if [ -n "${last_epoch:-}" ] && [ "$now_epoch" -gt "${last_epoch:-0}" ] 2>/dev/null; then
    dt=$(( now_epoch - last_epoch ))
    [ "${d_misc:-0}"  -ge "${last_misc:-0}"  ] 2>/dev/null && misc_rate="$(awk "BEGIN{printf \"%.2f\", ($d_misc-$last_misc)/$dt}")"
    [ "${d_retry:-0}" -ge "${last_retry:-0}" ] 2>/dev/null && retry_rate="$(awk "BEGIN{printf \"%.2f\", ($d_retry-$last_retry)/$dt}")"
  fi
fi
# liveness-touch: STATE_FILE rewritten EVERY run (mtime = ran-live), content = the rate baseline
printf '%s %s %s\n' "$now_epoch" "${d_misc:-0}" "${d_retry:-0}" > "$STATE_FILE" 2>/dev/null || true

# --- Timestamp ---
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"signal_dbm":%s,"signal_class":"%s","link_quality":%s,"link_pct":%s,"bitrate_mbps":%s,"freq_ghz":"%s","essid":"%s","ap_mac":"%s","iface":"%s","discard_misc_total":%s,"discard_retry_total":%s,"discard_beacon_missed":%s,"discard_misc_rate":"%s","discard_retry_rate":"%s","ts":"%s"}\n' \
    "$signal" "$signal_class" "$link_q" "$link_pct" "${bitrate:-0}" "${freq:-0}" "$essid" "$ap_mac" "$IFACE" "${d_misc:-0}" "${d_retry:-0}" "${d_beacon:-0}" "$misc_rate" "$retry_rate" "$ts"
else
  printf '[wifi-quality] %s — signal=%s dBm (%s) link=%s/%s (%s%%) bitrate=%s Mb/s freq=%s GHz essid=%s ap=%s discard_misc=%s/s (total=%s) retry=%s/s beacon-missed=%s\n' \
    "$signal_class" "$signal" "$signal_class" "$link_q" "70" "$link_pct" "${bitrate:-?}" "${freq:-?}" "$essid" "$ap_mac" "$misc_rate" "${d_misc:-0}" "$retry_rate" "${d_beacon:-0}"
fi
