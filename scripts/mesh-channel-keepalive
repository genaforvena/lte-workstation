#!/usr/bin/env bash
# mesh-channel-keepalive — keep each CHANNEL's MIND (bottom pane) alive. mesh-mind-keepalive only tends
# the 'claude' window; channel minds (tg, and any 2-pane channel) died unwatched — the tg claude died
# once with nothing to relaunch it. This checks each channel's mind pane and relaunches its mind if no
# mind process is running under it (a robust process-tree check — pane_current_command can lie when the
# mind runs as node under a shell wrapper).
#   mesh-channel-keepalive          one pass: relaunch any dead channel mind (and any AUTH-DEAD one —
#                                   a logged-out mind is a LIVE process, so the process check below
#                                   calls it healthy forever; see the AUTH-DEAD ARM block)
#   mesh-channel-keepalive --test
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# PATH-robust mind toolchain: opencode lives in ~/.opencode/bin, codex via nvm — without these the
# `command -v codex` guard below skips the work channel and mind_alive misreads. Mirror the launch env.
for d in "$HOME/.opencode/bin" "$HOME/.bun/bin"; do [ -d "$d" ] && case ":$PATH:" in *":$d:"*) :;; *) PATH="$d:$PATH";; esac; done
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use node >/dev/null 2>&1 || true
# typed-into-the-pane prefix so a relaunched mind resolves regardless of the pane shell's login PATH
MIND_PATH_PREFIX='export PATH="$HOME/.opencode/bin:$HOME/.bun/bin:$HOME/.local/bin:$PATH"; [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1; '
S="$(hostname)"; LOG="$HOME/.mesh/channel-keepalive.log"; ts(){ date -u +%FT%TZ; }
# The CARD is the declared truth for whether this node runs minds (mirror mesh-mind-keepalive +
# mesh-restore, which both gate on it). A node whose card has a `minds:` line that does NOT list an
# engine is organ-only/decommissioned → do NOT relaunch that engine's channels here. This makes
# blanking the card a clean, fleet-reusable "minds off" switch (operator decommissioned ilya 2026-06-15).
# Fail-SAFE: no card / no `minds:` line → don't gate (preserve legacy behavior, never disable a healthy
# node's minds on a missing card — mesh-restore regenerates it).
CARD_MINDS_LINE="$(grep -E '^[[:space:]]*minds:' "$HOME/.mesh-card" 2>/dev/null || true)"
CARD_MINDS=" $(printf '%s' "$CARD_MINDS_LINE" | sed 's/^.*minds:[[:space:]]*//') "
mind_declared(){ # $1 = engine binary (claude/opencode/codex/gemini), possibly an ABSOLUTE path
  [ -n "${CARD_MINDS_LINE// }" ] || return 0     # no card/line → don't gate
  # compare by BASENAME — the card declares engine basenames ("claude opencode …"), but a launch cmd may
  # pin an absolute path (e.g. MESH_CLAUDE_CMD=~/.local/bin/claude to force the native binary); a literal
  # match would then fail and wrongly skip the channel as "not declared".
  local b; b="$(basename "$1")"
  case "$CARD_MINDS" in *" $b "*) return 0;; *) return 1;; esac
}
# Per-channel mind-cmd overrides (MESH_SENSE_CMD, MESH_NOVELTY_CMD, etc.) live in restore.env
# (node-local, gitignored) — source here so keepalive restarts use the same cmd as mesh-restore.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null
# NATIVE CLAUDE, ALWAYS (operator hard rule 2026-06-19) — MUST mirror mesh-restore's resolver so a
# keepalive RELAUNCH uses the same native ELF, never a bare-PATH npm shim. ELF magic = 0x7f 'E' 'L' 'F'.
CLAUDE_BIN=claude
for _c in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
  [ -x "$_c" ] || continue
  [ "$(od -An -tx1 -N4 "$_c" 2>/dev/null | tr -d ' ')" = 7f454c46 ] || continue
  CLAUDE_BIN="$_c"; break
done
# canonical wall regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14):
# source the shared MESH_RL_RE; inline fallback if not deployed. Replaces the private regex in
# ratelimited() that MISSED too many requests + overloaded (the shedder caught less than its siblings).
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
# --test runs further down, AFTER rl_cooldown_secs is defined, so it can dry-run the cooldown classifier.

# descendants — the FULL process subtree under $1. The mind is a GRANDCHILD: the launch wrapper is
# 'sh -c → bash -lc → claude', so direct-children-only checks miss it.
descendants(){ local p; for p in $(pgrep -P "$1" 2>/dev/null); do echo "$p"; descendants "$p"; done; }
# cmd_bin — the actual binary in a launch cmd, SKIPPING leading env assignments (VAR=val). Without this
# 'OPENCODE_MODEL=… opencode' → bin='OPENCODE_MODEL=…' → command -v fails → the channel is wrongly
# treated as "mind not on this node" and NEVER tended/relaunched (sense/novelty wake-up bug 2026-06-15).
cmd_bin(){ local tok; for tok in $1; do case "$tok" in *=*) continue;; *) printf '%s' "$tok"; return;; esac; done; }
# opencode auto-approve opt-in (DEFAULT OFF, mirrors mesh-agy's MESH_AGY_YOLO precedent). No launch
# path mesh-wide wired opencode's own auto-approve equivalent (`opencode --auto`, confirmed via
# `opencode --help`) — unlike claude (`--permission-mode auto`) and agy (`--dangerously-skip-
# permissions`), so ANY channel that resolves to opencode (declared, quota-fallback, or an
# operator-drifted sticky) freezes on a manual y/n gate for its FIRST tool call, unattended forever
# (chat-review/room-mind-opencode-engine-drift 2026-07-04 — room's pane drifted onto opencode via the
# quota-fallback/sticky path and froze exactly this way; tg misdiagnosed it as needing a bypass
# DECISION when the mesh already decided bypass mesh-wide, the launch path just never carried it for
# this engine). MESH_OPENCODE_YOLO=1 (node-local, restore.env, never the genome) appends --auto to
# any resolved cmd whose binary basename is opencode, applied once at the single relaunch choke point
# in keep() so every opencode-resolving path (declared default, RL_FALLBACK, operator sticky revival)
# gets it uniformly. OFF by default so the genome ships safe.
opencode_autoflag(){ # $1=launch cmd string -> cmd string, --auto appended iff basename=opencode and opted in
  local cmd="$1"
  [ "${MESH_OPENCODE_YOLO:-0}" = 1 ] || { printf '%s' "$cmd"; return; }
  case "$(basename "$(cmd_bin "$cmd")" 2>/dev/null)" in
    opencode) case " $cmd " in *" --auto "*) printf '%s' "$cmd" ;; *) printf '%s --auto' "$cmd" ;; esac ;;
    *) printf '%s' "$cmd" ;;
  esac
}
# quota_should_revert — pure decision: revert a MARKED quota-fallback back to claude?  $1=cooldown_active
# (0/1) $2=fallback_age_s $3=max_age_s. Revert (return 0) iff the wall's cooldown has EXPIRED (reset
# passed) OR the fallback aged past the cap (misparsed-reset guard that bounds worst-case downtime).
# FALSIFIABLE in --test. The bug it fixes: keepalive's OWN free-provider fallback got recorded as a
# sovereign sticky, so a paid window never returned to claude on reset (operator hand-restarted 2026-06-21).
quota_should_revert(){ [ "$1" = 0 ] && return 0; [ "$2" -ge "$3" ] && return 0; return 1; }
# resume_hm_fmt $1=epoch → "HH:MMZ" in UTC. The SHED resume time is stamped alongside board posts whose
# own timestamps are UTC(Z) (ts() = date -u +%FT%TZ); rendering it in LOCAL (+0300 here) made a real
# 1800s pause read as a ~3.5h down-window — the [mind-paused] "auto-resumes ~HH:MM" and the pane "SHED
# until HH:MM" marker sat 3h ahead of the board's own UTC clock. UTC+Z keeps all three on one clock.
# (chat-review/keepalive-resume-tz-mismatch — testable helper so --test can pin the TZ + Z-suffix.)
resume_hm_fmt(){ date -u -d "@${1}" '+%H:%MZ' 2>/dev/null; }
# a mind is ALIVE iff an ACTUAL mind PROCESS runs in the pane's subtree — matched by COMM (process
# name), NEVER by args. The wrapper 'sh -c bash -lc "…claude; exec bash -l"' keeps the literal string
# 'claude' in its args even AFTER claude exits, so an args-match reports a DEAD channel as alive forever
# → it is never relaunched (THE no-wake-up-after-reset bug, 2026-06-15). COMM of the wrapper is sh/bash
# (no match); COMM of a live mind is claude/opencode/codex/gemini (or node for a node-based engine).
mind_alive(){ # $1 = pane target (session:win.idx)
  local pp p; pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  [ -z "$pp" ] && return 1
  for p in "$pp" $(descendants "$pp"); do case "$(ps -o comm= -p "$p" 2>/dev/null)" in
    claude|codex|opencode|gemini|agy|node) return 0 ;; esac; done
  return 1
}
mind_process_matches_declared(){ # $1 = pane target, $2 = expected engine basename
  local pp p comm expected
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  [ -z "$pp" ] && return 1
  # Compare by BASENAME — a launch cmd may pin an absolute path (MESH_CLAUDE_CMD=~/.local/bin/claude
  # to force the native ELF), but a process COMM is always the basename ('claude'). A raw full-path
  # compare ('/home/.../claude' != 'claude') flags EVERY healthy claude-in-a-claude-window as a
  # mismatch → the auto-shed below then kills+relaunches a perfectly correct mind every cron cycle
  # (the "claude killed in random windows" bug, 2026-06-20). Same fix mind_declared() already carries.
  expected="$(basename "$2")"
  for p in "$pp" $(descendants "$pp"); do
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "$comm" in
      claude|codex|opencode|gemini|agy|node)
        if [ "$expected" = "claude" ] && [ "$comm" = "claude" ]; then return 0; fi
        if [ "$expected" = "opencode" ] && [ "$comm" = "opencode" ]; then return 0; fi
        if [ "$expected" = "gemini" ] && { [ "$comm" = "gemini" ] || [ "$comm" = "agy" ]; }; then return 0; fi
        if [ "$expected" = "codex" ] && { [ "$comm" = "codex" ] || [ "$comm" = "node" ]; }; then return 0; fi
        if [ "$comm" = "$expected" ]; then return 0; fi
        ;;
    esac
  done
  return 1
}
# drop_stale_model_flag — the ENGINE is the pane's to choose; the MODEL is the config's.
# $1 = declared cmd, $2 = captured live argv → prints $2 with any `--model <v>` / `--model=<v>` pair
# removed IFF the declared cmd carries no --model of its own. Why: a sticky capture is a SNAPSHOT of
# an argv, so a model flag recorded once outlives every later config change — the operator set the
# whole mesh to the ACCOUNT DEFAULT in restore.env on 2026-08-30 and the tg window still relaunched
# `--model opus` at 20:01:26Z, because the pin lived in the captured argv, not in any file he could
# edit. He had to type /model default by hand at every wake. If the declared cmd DOES name a model
# (the RL fallback's sonnet, or a deliberate per-window pin in restore.env), the capture keeps its
# model — a config that speaks about models is honoured, a config that is silent is not overruled by
# a fossil. [[keepalive-sticky-engine-pins-old-mind]] is the same shape one flag to the left.
drop_stale_model_flag(){ # $1 = declared cmd, $2 = captured argv
  case "$1" in *--model[\ =]*) printf '%s' "$2"; return ;; esac
  printf '%s' "$2" | sed -E 's/[[:space:]]+--model([[:space:]]+|=)[^[:space:]]+//g'
}
# A captured argv is reusable only while it still belongs to the configured engine.  Once a node
# switches engines (for example Claude → Codex Luna), preserving the old argv defeats the new
# restart policy and revives the old engine after the next pane death.
captured_engine_matches(){ # $1 = declared cmd, $2 = live process COMM
  local t b="$2"
  for t in $1; do
    case "$t" in *=*) continue;; *) b="$(basename "$t")"; break;; esac
  done
  case "$b:$2" in
    codex:codex|codex:node|claude:claude|opencode:opencode|gemini:gemini|gemini:agy) return 0;;
    *) return 1;;
  esac
}
# Resolve persisted engine/model state against the current declared launch command.
sticky_cmd_for_declared(){ # $1 = declared command, $2 = sticky file
  local declared="$1" stick="$2" stored sb
  stored="$(cat "$stick" 2>/dev/null)"
  [ -n "$stored" ] || { printf '%s' "$declared"; return; }
  # An explicit model is authoritative, including a same-engine Astra → Luna change.
  case "$declared" in *--model[\ =]*) printf '%s' "$declared"; return;; esac
  sb="$(cmd_bin "$stored")"
  captured_engine_matches "$declared" "$(basename "$sb")" \
    && drop_stale_model_flag "$declared" "$stored" \
    || printf '%s' "$declared"
}
# running_launch_cmd — the relaunch command for whatever mind is LIVE in a pane, so keepalive can
# revive the OPERATOR'S chosen engine (not a hardcoded default) when it dies (operator 2026-06-20:
# "the mind I switch to is the one kept in the window"). Captures the live mind's own args — but the
# MODEL flag is dropped when the declared cmd is silent about models (drop_stale_model_flag above);
# special-cases agy → mesh-agy (bare 'agy' geo-fails Antigravity's eligibility check;
# mesh-agy routes it through phaedra's Canada egress). $2 = declared fallback if nothing parseable.
running_launch_cmd(){ # $1 = pane target, $2 = declared fallback cmd
  local pp p comm args
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || { printf '%s' "$2"; return; }
  [ -z "$pp" ] && { printf '%s' "$2"; return; }
  for p in "$pp" $(descendants "$pp"); do
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "$comm" in
      agy)
        captured_engine_matches "$2" "$comm" || { printf '%s' "$2"; return; }
        printf '%s' "$HOME/.local/bin/mesh-agy"; return ;;
      node) printf '%s' "$2"; return ;;   # node-wrapped engine (codex) — args are the node path; use declared
      claude|codex|opencode|gemini)
        captured_engine_matches "$2" "$comm" || { printf '%s' "$2"; return; }
        args="$(ps -o args= -p "$p" 2>/dev/null)"
        printf '%s' "$(drop_stale_model_flag "$2" "${args:-$2}")"; return ;;
    esac
  done
  printf '%s' "$2"
}
relaunch(){ # $1=pane $2=launch-cmd — types into the pane, so the pane MUST be a bare shell: typing
  # a launch cmd into an ssh runs it on the PEER; into a TUI it lands as a junk prompt. Skip + flag.
  local pp bin sentinel p occ
  bin="$(cmd_bin "$2")"   # skip leading VAR=val env assignments (else 'OPENCODE_MODEL=…' looks like the bin)
  # Guard: if the binary isn't installed on this node, skip + alert once per hour per binary.
  if ! command -v "$bin" >/dev/null 2>&1; then
    sentinel="$HOME/.mesh/channel-keepalive-missing-${bin}.ts"
    echo "$(ts) SKIP $1: '$bin' not installed — channel mind unavailable" >> "$LOG"
    if [ ! -f "$sentinel" ] || [ "$(( $(date +%s) - $(cat "$sentinel" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
      date +%s > "$sentinel"
      command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[channel-missing-tool] $1: '$bin' not installed on $S — install to enable this channel mind" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null)
  # Safe to type ONLY into a pure-SHELL subtree. The launch wrapper is 'sh -c → bash -l' (TWO shell
  # procs — a bash -l child is NORMAL after the mind exits, NOT an occupant), so the old "pane_pid is a
  # shell AND has no children" guard always failed for wrapped channels → relaunch never fired (a wake-up
  # bug). Instead: scan the whole subtree — if EVERY process is a shell, it's relaunchable; a non-shell
  # (an ssh, a live TUI) means occupied → don't type into it. (mind death already ensured by keep().)
  occ=""
  for p in "$pp" $(descendants "$pp"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in sh|-sh|bash|-bash|zsh|-zsh|dash|-dash|"") : ;; *) occ="$(ps -o comm= -p "$p" 2>/dev/null)"; break ;; esac
  done
  if [ -n "$occ" ]; then
    echo "$(ts) SKIP $1: pane subtree has a live non-shell process ('$occ') — not typing '$2' into it" >> "$LOG"
    # If the "occupant" is a RECOGNIZED MIND ENGINE (same whitelist as mind_alive:74), the mind is
    # actually ALIVE — keep() only calls relaunch() when mind_alive() returned DEAD, so a mind COMM here
    # PROVES mind_alive raced (a transient failed/empty tmux/ps read on the prior scan; the node ran hot
    # with thermal-shed the day this recurred). It is NOT a "non-mind live process" and NOT a stuck pane.
    # Posting [channel-odd] for it is a FALSE POSITIVE — verified the dominant case: of 67 logged occupied
    # SKIPs, 64 were mind engines (agy×55, claude×8, opencode×1), only 'sleep'/'timeout' (transient mind
    # subprocesses) otherwise. Escalating these to a [task] (chat-review/channel-odd-escalate, 2026-06-21)
    # would dispatch workers to "look at" perfectly healthy panes. So: suppress the board post for a live
    # mind (log only), and leave [channel-odd] for a GENUINE non-mind occupant (ssh / stray TUI / reviver
    # loop) — the real "needs a look" case. (The deeper mind_alive read-failure-as-DEAD guard is the
    # separate redirect chat-review/keepalive-readfailure-unknown — [[fusion-tools-distinguish-empty-from-failed]].)
    case "$occ" in
      claude|codex|opencode|gemini|agy|node)
        echo "$(ts) NOTE $1: occupant '$occ' is a live mind engine — mind_alive raced (mind is alive); not a stuck pane, no board alert" >> "$LOG"
        return 0 ;;
    esac
    # Rate-limit the board alert (once/hour per pane) — same anti-cry-wolf sentinel as the missing-tool
    # path above. A persistently-occupied mind pane (e.g. a legacy reviver loop left in minds.1) was
    # re-posting [channel-odd] every cron pass (*/4) → board spam that drowns real signal.
    sentinel="$HOME/.mesh/channel-keepalive-odd-$(printf '%s' "$1" | tr ':/.' '___').ts"
    if [ ! -f "$sentinel" ] || [ "$(( $(date +%s) - $(cat "$sentinel" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
      date +%s > "$sentinel"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[channel-odd] $1 mind looks dead but pane is occupied (non-mind live process) — needs a look, not auto-relaunched" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  tmux send-keys -t "$1" C-u 2>/dev/null; sleep 0.2
  # MESH_WHO carries the WINDOW lane onto every board post the relaunched mind makes — mesh-chat falls
  # back to $USER@host when unset, so a keepalive-relaunched mind (the */4 path that runs minds most of
  # the time, NOT mesh-restore) was collapsing into one 'imozerov@host' identity, unattributable by lane
  # (chat-review/chat-self-attribution, 2026-06-25: mesh-restore's ensure_channel already set this; the
  # RELAUNCH path was the real gap). Mirror ensure_channel's mw exactly — derive the window from the pane
  # target "$S:<win>.<idx>"; $(hostname) is sent LITERAL so the pane shell expands it at relaunch time.
  local rwin="${1#*:}"; rwin="${rwin%.*}"
  # SPAWN-AUDIT (chat-review/mind-spawn-audit-log, 2026-07-01): mirror ensure_channel's audit line —
  # log win+resolved-MESH_WHO+engine right after MESH_WHO is set, before the mind launches.
  tmux send-keys -t "$1" "export MESH_WHO=\"${rwin}@\$(hostname)\"; { echo \"\$(date -u +%FT%TZ) win=${rwin} who=\$MESH_WHO engine=$2 site=keepalive\" >> \"\$HOME/.mesh/.mind-spawn-audit.log\"; } 2>/dev/null; [ -f \"\$HOME/.mesh/restore.env\" ] && . \"\$HOME/.mesh/restore.env\" 2>/dev/null; ${MIND_PATH_PREFIX}$2" C-m 2>/dev/null
  echo "$(ts) RELAUNCHED $1 ($2) as MESH_WHO=$rwin@$S" >> "$LOG"
  # Board post is DEFERRED to end-of-pass (chat-review/keepalive-relaunch-burst-coalesce, 2026-07-20):
  # posting per-mind here meant a post-outage/post-tiering pass with N dead minds flooded the board
  # with N near-identical [mind-relaunched] lines in seconds (~24 lines 2026-07-20 alone). Accumulate
  # "pane|cmd" per relaunch; the pass flushes ONE batched line when N≥2 (mirror of quota_wave's
  # consolidation for [mind-paused]); a single relaunch keeps its one full-detail line.
  RELAUNCH_ACC="${RELAUNCH_ACC:-}${1}|${2}
"
}
# render_relaunch_posts — stdin: one "pane|cmd" line per relaunch this pass → stdout: the board
# line(s) to post. 0 lines → nothing; 1 line → the classic full-detail single post (common case,
# signal preserved); ≥2 → ONE coalesced line naming the windows (burst case). Pure text→text so
# --test drives it with fixture lines and asserts output WITHOUT posting to the real board.
render_relaunch_posts(){
  local lines=() l n wins p
  while IFS= read -r l; do [ -n "$l" ] && lines+=("$l"); done
  n=${#lines[@]}
  [ "$n" -eq 0 ] && return 0
  if [ "$n" -eq 1 ]; then
    printf '[mind-relaunched] channel-keepalive: relaunched %s (%s)\n' "${lines[0]%%|*}" "${lines[0]#*|}"
  else
    wins=""
    for l in "${lines[@]}"; do p="${l%%|*}"; p="${p#*:}"; p="${p%.*}"; wins="${wins:+$wins }$p"; done
    printf '[mind-relaunched] channel-keepalive: batch of %d relaunched this pass: %s\n' "$n" "$wins"
  fi
}
flush_relaunch_posts(){ # end-of-pass: post whatever the pass accumulated (0/1/N → see render)
  [ -n "${RELAUNCH_ACC:-}" ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  printf '%s' "$RELAUNCH_ACC" | render_relaunch_posts | while IFS= read -r l; do
    MESH_WHO="channel-keepalive@$S" mesh-chat "$l" >/dev/null 2>&1 || true
  done
  RELAUNCH_ACC=""
}
# channel window -> mind launch cmd. The MIND is the BOTTOM-most pane (largest pane_top) — same
# selector as mesh-tell/mesh-feed/mesh-mind-state; hardcoded .1 broke when panes died and renumbered.
# is the mind binary actually PRESENT on this node? (uniform sessions 2026-06-13: a node without a
# given mind shows a REMOTE-NOTE pane, NOT a local mind — relaunching an absent binary into it storms.
# This bit phaedra: claude/opencode aren't installed there but it has the uniform dev/discover/sense
# channels → channel-keepalive relaunched claude every cycle. Check with the full mind-launch PATH.)
mind_present(){ local bin; bin="$(cmd_bin "$1")"
  bash -lc "export PATH=\"\$HOME/.opencode/bin:\$HOME/.bun/bin:\$HOME/.local/bin:\$PATH\"; [ -s \"\$HOME/.nvm/nvm.sh\" ] && . \"\$HOME/.nvm/nvm.sh\" >/dev/null 2>&1; command -v $bin" >/dev/null 2>&1
}
# A rate-limited mind isn't free: a walled codex/claude TUI BUSY-WAITS at ~18-24% CPU rendering its
# limit message, pegging a core for hours/days (the 2026-06-13 thermal root cause). SHED it: kill the
# spinning mind so its pane drops to a shell, mark a cooldown, and skip relaunch until cooldown — so a
# rate-limited mind spins ~one keepalive cycle per cooldown instead of continuously (~97% CPU cut).
RL_COOLDOWN="${MESH_RL_COOLDOWN:-1800}"   # re-check a paused mind every 30min (it may regain quota)
RL_FALLBACK="${MESH_RL_FALLBACK_CMD:-opencode -m opencode/deepseek-v4-flash-free}"  # free-provider fallback when quota-exhausted
RL_FALLBACK_AFTER="${MESH_RL_FALLBACK_AFTER:-2}" # consecutive quota sheds before switching to fallback
# SHED OFF-SWITCH (operator 2026-08-31, live: "lets not shed minds now"). The shed exists to stop a
# walled TUI busy-waiting at ~20% CPU; the operator may still want the minds STANDING through a wall
# — a shed mind is not merely quiet, it is DEAD, and on 2026-08-31 the shedder cycled tg-roz/job/
# witness/pub every ~30min for four hours against a WEEKLY cap (7d:91%), so every window was dark
# exactly while its work was wanted. Default stays `on`: the genome ships the CPU protection.
# `off` NEVER silences — the decline is logged and the pane still carries a marker, or a shed that
# did not happen becomes indistinguishable from a wall that did not occur.
SHED_MINDS="${MESH_SHED_MINDS:-on}"
# >>> SHED-GATE BEGIN  (extracted verbatim by --test; both the live path and the drive call THIS)
# shed_gate — the ONE predicate deciding whether a walled mind is killed. rc 0 = DECLINE (leave the
# mind running), rc 1 = shed as before. It is a function, not an inline `if`, so the drive exercises
# the same grammar the live path does; a --test that re-implemented the condition would be testing a
# different predicate than the caller. Side effect on the decline path is the NOTICE, throttled to
# one per $RL_COOLDOWN per window off its own mark file — never silent, or a shed that did not happen
# becomes indistinguishable from a wall that did not occur.
shed_gate(){ # $1 = window
  [ "${SHED_MINDS:-on}" = off ] || return 1
  local nmark="$HOME/.mesh/.shed-declined-$1" nnext=0
  [ -f "$nmark" ] && nnext="$(cut -d'|' -f1 "$nmark" 2>/dev/null || echo 0)"
  if [ "$(date +%s)" -ge "${nnext:-0}" ]; then
    echo "$(( $(date +%s) + ${RL_COOLDOWN:-1800} ))|off" > "$nmark"
    echo "$(ts) SHED-DECLINED $1: rate-limit wall + spinning mind, but MESH_SHED_MINDS=off — mind LEFT RUNNING (paying its busy-wait CPU by operator choice)" >> "$LOG"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@${S:-?}" mesh-chat "[mind-walled] ${S:-?}:$1 hit a rate-limit wall — NOT shed (MESH_SHED_MINDS=off), mind left running" >/dev/null 2>&1 || true
  fi
  return 0
}
# <<< SHED-GATE END
ratelimited(){ # $1=pane → 0 if a GENUINE rate-limit/usage wall BANNER is showing (banner-shape, not
  # prose). Uses the shared rl_is_walled (mesh-patterns.sh) so a mind writing ABOUT quotas in its own
  # summary/task text is never shed off that prose (operator FP 2026-06-15). Inline fallback if the
  # shared lib isn't deployed: terse-line guard only (drops the worst long-prose false positives).
  if command -v rl_is_walled >/dev/null 2>&1; then
    tmux capture-pane -t "$1" -p -S -10 2>/dev/null | rl_is_walled
  else
    tmux capture-pane -t "$1" -p -S -10 2>/dev/null | grep -vE '^[[:space:]]*[❯›]' \
      | awk 'length($0)<=100' | grep -qiE "$MESH_RL_RE"
  fi
}
# rl_cooldown_secs — read the REAL reset time the banner states ("resets 2:20pm", "try again at
# 6:03 PM", "try again in 2h", "resets at 15:00") and return seconds-to-reset, clamped [120, 6h].
# No reset parseable OR reset already PAST → no output (caller falls back to RL_COOLDOWN=30min).
# Past-time case: the banner can show a stale short-window reset time while a longer window (5h)
# is still depleted — emitting MIN=120 caused a 3h thrash loop (2026-06-15 chat-review finding).
# Future-time: emit exact seconds → resume precisely when quota resets.
rl_cooldown_secs(){
  command -v python3 >/dev/null 2>&1 || return 0
  python3 <(cat <<'PYEOF'
import sys,re,datetime
MIN,MAX_SHORT,MAX_LONG=120,6*3600,24*3600
txt=sys.stdin.read().lower()
# LONG-WINDOW walls = account-quota exhaustion lasting DAYS (weekly OR monthly), not a transient
# rate-limit. They get the 24h clamp + daily re-check; a 6h short clamp re-pokes a week-long wall
# every <=6h — the phaedra WEEKLY-quota thrash (2026-06-17). phaedra's claude shares the account
# WEEKLY quota, and the old regex matched only 'monthly', so weekly walls fell to the short clamp.
is_long=bool(re.search(r'(month|week)ly\s+(usage\s+)?limit|(month|week)ly\s+quota|build\s+monthly|reset[s]?\s+(next\s+)?(week|month)|\bin\s+\d+(?:[–-]\d+)?\s*days?\b',txt))
MAX=MAX_LONG if is_long else MAX_SHORT
def out(s): print(max(MIN,min(int(s),MAX))); sys.exit(0)
now=datetime.datetime.now()
# day range/relative: "resets in 3 days" / "in 2-3 days" (weekly-quota banner) — clamped to 24h
m=re.search(r'\bin\s+(\d+)(?:[–-]\d+)?\s*days?\b',txt)
if m:
    out(int(m.group(1))*86400+30)
# hour range: "it will reset in 18-20 hours" — take the LOWER bound so we resume as early as valid
m=re.search(r'\bin\s+(\d+)[–-]\d+\s*[\[]*\s*(h|hr|hrs|hour|hours|m|min|mins|minute|minutes)\b',txt)
if m:
    n=int(m.group(1)); out(n*3600+30 if m.group(2).startswith('h') else n*60+30)
# relative: "try again in 2h" / "in 45 min"
m=re.search(r'\bin\s+(\d+)\s*(h|hr|hrs|hour|hours|m|min|mins|minute|minutes)\b',txt)
if m:
    n=int(m.group(1)); out(n*3600+30 if m.group(2).startswith('h') else n*60+30)
# long-window fallback: no parseable reset time → 18h default (daily-ish re-check)
if is_long:
    out(18*3600+30)
# absolute clock: "resets 2:20pm" / "reset at 3:00 pm" / "try again at 6:03 pm" / "resets at 15:00"
m=re.search(r'(?:reset[s]?|try again)\s*(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)?',txt)
if m:
    hh=int(m.group(1)); mm=int(m.group(2) or 0); ap=m.group(3)
    if ap=='pm' and hh<12: hh+=12
    if ap=='am' and hh==12: hh=0
    if hh<=23 and mm<=59:
        tgt=now.replace(hour=hh,minute=mm,second=0,microsecond=0)
        if tgt > now:
            out(int((tgt-now).total_seconds())+30)
        # tgt <= now: stale/past banner → no output, caller uses RL_COOLDOWN (30min) conservatively
sys.exit(0)
PYEOF
)
}
WAVE_FILE="$HOME/.mesh/.keepalive-wave"
WAVE_WINDOW="${MESH_QUOTA_WAVE_WINDOW:-600}"      # 10min window for counting paused minds
WAVE_THRESHOLD="${MESH_QUOTA_WAVE_THRESHOLD:-3}"  # ≥N minds paused in window → wave
WAVE_COOLDOWN="${MESH_QUOTA_WAVE_COOLDOWN:-600}"  # suppress consolidated re-post for N seconds
WAVE_COOLDOWN_MARK="$HOME/.mesh/.keepalive-wave-cooldown"
quota_wave(){ # $1=window name → returns 1 (suppress post) if quota-wave active, 0 (post normally)
  local now; now=$(date +%s)
  # HOISTED cooldown check (chat-review/quota-wave-suppress-race): test the suppression mark BEFORE
  # appending/counting WAVE_FILE. Previously nested inside cnt>=threshold, so concurrent passes in a
  # rate-limit cascade could append+rewrite WAVE_FILE and race the check-then-set before the mark
  # landed → leaked [mind-paused] posts past the active suppression. Now an active cooldown
  # short-circuits here (NO file mutation at all), and the instance flock (see the pass) serializes
  # the remaining append→count→set so only one pass ever arms the mark.
  if [ -f "$WAVE_COOLDOWN_MARK" ] && [ "$(cat "$WAVE_COOLDOWN_MARK" 2>/dev/null || echo 0)" -gt "$now" ]; then
    return 1
  fi
  echo "$now|$1" >> "$WAVE_FILE"
  local cnt=0 tmp; tmp=$(mktemp) || return 0
  while IFS='|' read -r ts win 2>/dev/null; do
    [ -n "${ts:-}" ] || continue
    if [ "$(( now - ts ))" -le "$WAVE_WINDOW" ]; then
      echo "$ts|$win" >> "$tmp"
      cnt=$(( cnt + 1 ))
    fi
  done < "$WAVE_FILE"
  mv "$tmp" "$WAVE_FILE"
  if [ "$cnt" -ge "$WAVE_THRESHOLD" ]; then
    echo "$(( now + WAVE_COOLDOWN ))" > "$WAVE_COOLDOWN_MARK"
    MESH_WHO="channel-keepalive@$S" mesh-chat "[quota-wave] $S: ≥$cnt minds rate-limited in last $((WAVE_WINDOW/60))min — suppressing individual [mind-paused] posts for $((WAVE_COOLDOWN/60))min" >/dev/null 2>&1
    return 1
  fi
  return 0
}

# shed_recoverability — READ-ONLY classifier (instrument-first, non-ergodicity review 2026-06-21):
# a shed KILLS the mind TRUSTING the pane's shell wrapper to survive ('exec bash -l' → relaunchable
# shell). But a BARE-launched pane (the mind IS the pane root, no wrapping shell) CLOSES PERMANENTLY on
# kill — an ABSORBING BARRIER (lost scrollback + the channel pane itself; [[restart-mind-needs-exec-bash-fallback]],
# a real past harm = lost chat/health/work panes). The shed is judged per-fire, never by what the kill
# costs when the barrier is reachable. This classifies each shed target WITHOUT changing behavior, so the
# barrier's REAL exposure is visible on $LOG before any refuse/park enforcement is wired (vet, then enforce
# — same instrument-before-actuator discipline as the therm --csd land). Pure: no kill, no tmux mutation.
shed_recoverability(){ # $1=pane → echo RECOVERABLE|BARE|UNKNOWN <detail>
  local pp rootcomm mind="" p
  # tmux 'display -t <bad-target>' silently FALLS BACK to the active pane (returns its pid, rc 0) instead
  # of failing — so verify the pane REALLY exists first, or a bogus target misreads as the active mind.
  tmux list-panes -a -F '#{session_name}:#{window_name}.#{pane_index}' 2>/dev/null | grep -qxF "$1" \
    || { echo "UNKNOWN no-pane"; return; }
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || { echo "UNKNOWN no-pane"; return; }
  rootcomm="$(ps -o comm= -p "$pp" 2>/dev/null)"
  for p in "$pp" $(descendants "$pp"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in claude|codex|opencode|gemini|agy|node) mind="$(ps -o comm= -p "$p" 2>/dev/null)"; break ;; esac
  done
  [ -n "$mind" ] || { echo "UNKNOWN no-mind-in-subtree root=${rootcomm:-?}"; return; }
  # RECOVERABLE iff the pane ROOT (the process tmux keeps the pane alive for) is a SHELL — it outlives the
  # mind's death and drops to a relaunchable prompt. If the root IS a mind engine, the mind is the pane
  # root → killing it closes the pane (BARE, the absorbing barrier).
  case "$rootcomm" in
    sh|-sh|bash|-bash|zsh|-zsh|dash|-dash) echo "RECOVERABLE root=$rootcomm mind=$mind" ;;
    "")  echo "UNKNOWN no-root mind=$mind" ;;
    *)   echo "BARE root=$rootcomm mind=$mind" ;;
  esac
}
shed_mind(){ # $1=pane → kill the ACTUAL mind process in the pane's SUBTREE (claude is a grandchild of
  # the sh→bash wrapper; the old direct-children-only kill matched 'bash' not 'claude' → killed NOTHING,
  # so the walled mind kept spinning AND was never shed-then-relaunched). Kill by COMM; the wrapper
  # (sh/bash) is never matched, so it survives to 'exec bash -l' → pane drops to a relaunchable shell.
  local pp p; pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  # instrument-first SHED-AUDIT (zero behavior change): record the absorbing-barrier exposure of THIS
  # shed before the kill, so RECOVERABLE-vs-BARE can be vetted on real shed events before enforcement.
  echo "$(ts) SHED-AUDIT $1: $(shed_recoverability "$1")" >> "$LOG" 2>/dev/null || true
  for p in "$pp" $(descendants "$pp"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in claude|codex|opencode|gemini|agy|node) kill "$p" 2>/dev/null ;; esac
  done
}
# ── AUTH-DEAD ARM ────────────────────────────────────────────────────────────────────────────────
# A LOGGED-OUT mind is alive as a process and idle at an error prompt, so it falls between BOTH of
# this tool's recovery paths AT ONCE: the dead-branch below wants a DEAD process (mind_alive:74 is a
# deliberate process-tree check — a 403-wedged claude satisfies it forever), and SHED wants a SPINNING
# one (a mind sitting on 'Please run /login' burns no CPU and shows no quota banner). One wants dead,
# the other busy; this state is neither, so nothing ever touched it.
# Live 2026-08-18: genome/health/senses/sound sat at '● Please run /login · API Error: 403 Request not
# allowed' for ~7h — including BOTH code owners, so the outage could not even be FILED to a hand that
# could fix it — while keepalive shed+relaunched five other channels all afternoon. The mesh already
# DETECTED it everywhere and HEALED it nowhere: mesh-mind-state has a dedicated AUTH-DEAD verdict
# (exit 9), mesh-tell REFUSES on it by name, mesh-mind-control classifies it and HOLDs dispatch on rc9.
# That correctness is the trap — a HOLD is not a HEAL, so every strand owned by a logged-out window
# queued behind a mind no reflex would ever restart. Six days of AUTH-DEAD mesh-tell refusals in
# pane-consume.log (since 2026-08-12T14:36Z) and the string never once reached the board; the windows
# that recovered did so by ACCIDENT, when the unrelated rate-limit SHED path happened to pick them.
# THE CURE IS MEASURED, NOT PROPOSED: kill the wedged process and let the existing relaunch run — the
# four wedged processes were 27.5-28.9h old and a fresh one authenticates on the SAME credentials
# (per-process token staleness, not an account or node-wide block). sound went AUTH-DEAD → IDLE in 8s
# and then WORKING on a real turn; a 403 would have surfaced immediately.
# THE STORM IS THE HARD HALF, not the detection: against a GENUINELY revoked credential a naive arm
# respawns a 403 mind every pass forever. So the arm is gated three ways —
#   (1) DEBOUNCE: two consecutive sightings (AUTH_PERSIST) before any kill. The verdict is pane TEXT,
#       and a mind DISCUSSING a logged-out window can put the literal string in its own tail. This is
#       not hypothetical: minutes after this arm first ran, mesh-home:health — healthy, mid-turn work —
#       classified AUTH-DEAD off its own board post about the very outage above, and this arm would
#       have killed it. The root fix went where the lie was, mesh-mind-state's detector (now the
#       shared banner-SHAPE gate auth_is_dead: terse line AND the phrase LEADS it), because that
#       verdict also makes mesh-tell refuse and dispatch HOLD — a healthy mind was being silenced for
#       talking about an auth incident. The debounce stays anyway: a kill is irreversible for that
#       mind's context, so one sighting of a text-derived state is never enough to spend it.
#   (2) COOLDOWN: at most one auth-relaunch per window per AUTH_COOLDOWN.
#   (3) GIVEUP: after AUTH_GIVEUP consecutive relaunches that did NOT restore auth, stop and NAME a
#       human — a revoked credential needs a /login, and a reflex that keeps trying hides that.
#   (4) THE CLEAR IS EARNED, NOT ASSUMED. The streak used to be deleted on the FIRST not-AUTH-DEAD
#       reading, on the reasoning that it meant the relaunch had worked. It does not: this verdict is
#       derived from pane TEXT, and a just-relaunched engine has printed no 403 because it has not
#       attempted a turn yet — a good credential and a revoked one render IDENTICALLY there. So every
#       cycle laundered its own streak: a_cnt and the last-relaunch stamp were wiped one pass after
#       each relaunch, (2) COOLDOWN had no stamp to measure and (3) GIVEUP could never reach its
#       count, which made the "this needs a human /login" line unreachable BY CONSTRUCTION. Now the
#       clear must be earned, by an observed WORKING turn (a pane cannot be mid-turn on a revoked
#       credential — it 403s) or by not-AUTH-DEAD sustained across AUTH_PERSIST.
AUTH_COOLDOWN="${MESH_AUTH_COOLDOWN:-1800}"            # ≥30min between auth-relaunches of the SAME window
AUTH_GIVEUP="${MESH_AUTH_GIVEUP:-3}"                   # consecutive failed auth-relaunches → stop, call a human
AUTH_PERSIST="${MESH_AUTH_PERSIST:-240}"               # AUTH-DEAD must persist this long (≥1 extra */5 pass) before a kill
AUTH_GIVEUP_REPOST="${MESH_AUTH_GIVEUP_REPOST:-21600}" # re-say the stuck-logged-out line at most every 6h
# pane_authdead — ask the mesh's ONE classifier; deliberately NOT a private second '/login' grep. A
# local copy would drift from the verdict mesh-tell/dispatch/mind-control already route on, and the
# whole point of this arm is that it heals exactly what they refuse. rc 9 = AUTH-DEAD (mesh-mind-state's
# state_rc table, gated by its own --test). "Cannot tell" is a THIRD outcome, never folded into "fine":
# a missing/timing-out classifier silently disarms the arm, which is the shape that let this run 6 days.
AUTH_STATE_TIMEOUT="${MESH_AUTH_STATE_TIMEOUT:-25}"    # cap on one classifier read (also the --test hook for the 124 leg)
# PANE_STATE — the state WORD from pane_authdead's ONE read. It exists because the EXIT CODE cannot
# carry the fact the clear-gate below needs: mesh-mind-state's own state_rc table maps WORKING, IDLE
# and UNKNOWN all onto 0, so "the relaunch worked" and "a fresh pane has not tried yet" are the SAME
# number. Read from the same invocation, never a second one — a second ask samples a MOVING pane and
# the two answers would be about two different moments.
PANE_STATE=""
pane_authdead(){ # $1 = window name → 0 AUTH-DEAD · 1 not AUTH-DEAD · 2 cannot tell (classifier absent/failed)
  local cmd rc out; cmd="${MESH_MINDSTATE_CMD:-mesh-mind-state}"
  PANE_STATE=""
  command -v "$(cmd_bin "$cmd")" >/dev/null 2>&1 || return 2
  out="$(timeout "${AUTH_STATE_TIMEOUT}" $cmd "$1" 2>/dev/null)"; rc=$?
  # single-window CLI prints "<STATE>\t<detail>"; take the word, and leave it EMPTY when there is
  # none. An empty PANE_STATE must never read as WORKING — the gate below defaults to unproven.
  PANE_STATE="$(printf '%s\n' "$out" | head -1 | cut -f1 | awk '{print $1}')"
  case "$rc" in
    9) return 0 ;;
    124|125|126|127) return 2 ;;   # timeout / could-not-exec — a blind read, not a healthy mind
    *) return 1 ;;
  esac
}
# authdead_verdict — the whole storm guard as ONE pure decision, so --test can falsify every branch
# without a pane, a kill, or a board post. Precedence is load-bearing: GIVEUP outranks COOLDOWN
# outranks the debounce, so a revoked credential can never be re-tried by an expired cooldown.
authdead_verdict(){ # $1=now $2=first-seen-epoch(0=unseen) $3=last-relaunch-epoch $4=count $5=cooldown $6=giveup $7=persist
  local now="$1" seen="${2:-0}" last="${3:-0}" cnt="${4:-0}" cd="$5" gu="$6" persist="$7"
  [ "$cnt" -ge "$gu" ] && { echo GIVEUP; return; }
  # last<=0 = never auth-relaunched → no cooldown to serve. Guarding this explicitly matters: a bare
  # (now-last) arithmetic makes the cooldown depend on the ABSOLUTE clock, so the branch is unreachable
  # under a real epoch and permanently true under a small fixture one — a gate no test could pin.
  [ "$last" -gt 0 ] && [ "$(( now - last ))" -lt "$cd" ] && { echo COOLDOWN; return; }
  [ "$seen" -le 0 ] && { echo PENDING; return; }              # first sighting → arm the debounce, act next pass
  [ "$(( now - seen ))" -lt "$persist" ] && { echo WAIT; return; }
  echo RELAUNCH
}
# authdead_clear_verdict — may the AUTH-DEAD streak be DELETED? One pure decision, extracted for the
# same reason authdead_verdict is: the branch that matters is the one a pane fixture cannot reach.
# The trap it exists to close: the exit code of the classifier maps WORKING, IDLE and UNKNOWN all to
# 0, so "the relaunch restored auth" and "the fresh pane has not attempted a turn yet" are the SAME
# reading. Deleting the streak on that reading reset a_cnt and the last-relaunch stamp every cycle,
# which made COOLDOWN and GIVEUP unreachable and silenced the human-needed line permanently.
# Precedence is load-bearing: NOSTREAK first (nothing to hold, and no candidate may age on its own),
# then the positive proof, then the sustained window; everything else HOLDS.
authdead_clear_verdict(){ # $1=streak-present(1/0) $2=pane-state-word $3=now $4=ok-since(0=unarmed) $5=persist
  local have="${1:-0}" st="${2:-}" now="$3" since="${4:-0}" persist="$5"
  [ "$have" = 1 ] || { echo NOSTREAK; return; }
  [ "$st" = WORKING ] && { echo CLEAR-WORKING; return; }
  [ "$since" -le 0 ] && { echo ARM; return; }
  [ "$(( now - since ))" -ge "$persist" ] && { echo CLEAR-SUSTAINED; return; }
  echo HOLD
}
# authdead_heal — the measured cure, as ONE callable step so --test can drive it end-to-end against a
# real pane: kill the wedged engine, WAIT for it to actually go, then relaunch. The wait is not
# cosmetic — relaunch() refuses to type into a pane whose subtree still holds a non-shell, so firing
# it straight after the kill would silently no-op and cost a whole cadence. Bounded: if the engine
# outlives the wait, we leave it and the dead-branch takes the pane next pass.
# Returns 0 = relaunched · 1 = engine outlived the kill (deferred to next pass).
authdead_heal(){ # $1 = pane target  $2 = launch cmd
  local w=0
  shed_mind "$1"
  while [ "$w" -lt 10 ] && mind_alive "$1"; do sleep 0.5; w=$(( w + 1 )); done
  mind_alive "$1" && return 1
  relaunch "$1" "$2"
  return 0
}
# render_authdead_posts — same burst discipline as render_relaunch_posts (a whole-node auth outage is
# N windows at once, and N near-identical board lines is exactly the noise the 2026-07-20 coalesce
# landed to stop). stdin: one "win|count" per auth-relaunch this pass → 0 / 1 full-detail / 1 batched.
render_authdead_posts(){
  local lines=() l n wins
  while IFS= read -r l; do [ -n "$l" ] && lines+=("$l"); done
  n=${#lines[@]}
  [ "$n" -eq 0 ] && return 0
  if [ "$n" -eq 1 ]; then
    printf '[mind-authdead] channel-keepalive: %s was AUTH-DEAD (logged out, live process — invisible to both dead-branch and SHED) → killed + relaunched, auth-relaunch #%s\n' "${lines[0]%%|*}" "${lines[0]#*|}"
  else
    wins=""
    for l in "${lines[@]}"; do wins="${wins:+$wins }${l%%|*}"; done
    printf '[mind-authdead] channel-keepalive: %d minds were AUTH-DEAD (logged out, live processes) → killed + relaunched this pass: %s\n' "$n" "$wins"
  fi
}
flush_authdead_posts(){
  [ -n "${AUTHDEAD_ACC:-}" ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  printf '%s' "$AUTHDEAD_ACC" | render_authdead_posts | while IFS= read -r l; do
    MESH_WHO="channel-keepalive@$S" mesh-chat "$l" >/dev/null 2>&1 || true
  done
  AUTHDEAD_ACC=""
}


# ── STRANDED-COMPOSER SWEEP ─────────────────────────────────────────────────────────────────────────
# (chat-review/a-stranded-composer-outlives-every-ladder-that-would-clear-it, witness 2026-08-29)
#
# THE FAULT: mesh-tell's stall ladder lives entirely INSIDE the send path, guarded by
# composer_holds_text in the seconds right after the paste. A prompt that survives all three rungs
# OUTLIVES the sending process, and nothing on this mesh ever looks at a composer again. Measured:
# vpn held 'take the 13:57Z third-table-52-build-pathway finding' unsubmitted for ~55 minutes while
# mesh-mind-state answered IDLE, ready prompt — the SAME word a healthy resting mind wears — which is
# why the digest listed that task unclaimed for two consecutive rounds. The cause sat in a pane the
# whole time and no instrument could see it.
#
# WHY IT LIVES HERE: this tool already walks every channel on a */5 cadence, already holds the pane
# reference, and already owns the debounce/cooldown/giveup discipline the AUTH-DEAD arm needed for
# exactly the same reason (a detector with no re-applier leaves the operator's hands as the loop).
#
# THE PREDICATE IS NOT OURS. It is `mesh-tell --composer`, which runs mesh-tell's OWN
# composer_holds_text over its OWN cap_tail/paneref — the same bytes the send path decides on. A
# private second copy here would drift from the parser it is meant to guard
# ([[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]).
#
# THE WORD IS PUBLISHED HERE, NOT IN mesh-mind-state. A composer holding work is genuinely a state
# distinct from IDLE, but mesh-mind-state's vocabulary is read by mesh-tell, mesh-mind-control,
# dispatch and this file's own AUTH-DEAD arm, and a word none of them knows is a silent misroute
# ([[a-new-verdict-word-must-be-in-the-consumers-alphabet]]). So the state gets its own name in this
# arm's own ledger and board line, where it has no alphabet to break.
#
# THREE OUTCOMES, THREE REMEDIES — and only ONE of them touches a pane:
#   STRANDED       the held text MATCHES a mesh-tell delivery for this window → a prompt that never
#                  landed → re-drive it (a bare submit; we are re-submitting text mesh-tell put there).
#   HELD-OPERATOR  held text with NO matching delivery → this may be a HUMAN mid-sentence. Announce,
#                  never touch. Submitting someone's half-typed thought is a worse fault than the one
#                  being fixed, and there is no way to tell "walked away" from "still thinking".
#   UNATTRIBUTABLE the WAL cannot answer (thinned to redact/minimal/off, or aged out). NOT folded into
#                  HELD-OPERATOR: an instrument that is switched off is not evidence of a human
#                  ([[a-collapsed-reason-makes-blind-and-quiet-identical]]).
# BLIND (the pane could not be read) HOLDS the streak rather than clearing it — an unreadable pane is
# not proof a strand ended ([[a-blanket-exemption-that-cannot-place-its-subject-in-the-window]]).
STRAND_PERSIST="${MESH_STRAND_PERSIST:-600}"     # held, UNCHANGED, this long before anything fires (>=1 extra */5 pass)
STRAND_COOLDOWN="${MESH_STRAND_COOLDOWN:-900}"   # min gap between re-drives on one window
STRAND_GIVEUP="${MESH_STRAND_GIVEUP:-3}"         # re-drives before we stop and just say it
STRAND_WAL_WINDOW="${MESH_STRAND_WAL_WINDOW:-21600}"  # how far back a delivery may be and still explain this text
STRAND_LOG="$HOME/.mesh/composer-sweep.log"      # the arm's OWN ledger — deliberately not $LOG, which
                                                 # is the cron stdout tape; sharing them makes the
                                                 # re-drive RATE uncountable ([[a-tape-of-only-positives-is-a-numerator]])
# THE RUN ROW IS UNCONDITIONAL ([[a-tape-of-only-positives-is-a-numerator]]). A ledger that is written
# only when something is HELD makes "no window was stranded" and "the sweep never ran" the same
# silence — and this arm's whole justification is that a silence nobody could read cost 55 minutes.
# So every pass writes one RUN row carrying its own census: how many channels it actually asked, how
# many held, how many it could not read. `swept` is the denominator; without it `held=0` is a claim
# about an unknown number of windows.
STRAND_N_SWEPT=0; STRAND_N_HELD=0; STRAND_N_BLIND=0; STRAND_N_ACTED=0
strand_flush(){
  # A pass that reached no channel at all still says so: 0/0/0 is a real reading (a lean node, a card
  # with no minds, every pane dead) and must not be mistaken for the arm being absent.
  echo "$(ts) RUN swept=$STRAND_N_SWEPT held=$STRAND_N_HELD blind=$STRAND_N_BLIND acted=$STRAND_N_ACTED persist=${STRAND_PERSIST}s cooldown=${STRAND_COOLDOWN}s giveup=$STRAND_GIVEUP" >> "$STRAND_LOG"
}
# strand_verdict — the whole schedule as ONE pure decision, so --test falsifies every branch with no
# pane, no key and no board post. Precedence is load-bearing and mirrors the AUTH-DEAD arm: a CHANGED
# composer outranks everything (someone is typing), then GIVEUP, then COOLDOWN, then the debounce.
strand_verdict(){ # $1=now $2=firstseen(0=new) $3=prev-digest $4=now-digest $5=redrives $6=last-redrive $7=persist $8=cooldown $9=giveup
  local now="$1" seen="${2:-0}" pd="$3" nd="$4" cnt="${5:-0}" last="${6:-0}" persist="$7" cd="$8" gu="$9"
  [ "$seen" -le 0 ] && { echo ARMED; return; }
  # A CHANGED composer is a LIVE HAND, not a longer strand. This is the arm's most important branch:
  # it is what makes a human typing into a pane structurally un-sweepable, and it must be checked
  # BEFORE the giveup/cooldown ladder or a slow typist inherits an old window's streak.
  [ "$pd" != "$nd" ] && { echo CHANGED; return; }
  [ "$cnt" -ge "$gu" ] && { echo GIVEUP; return; }
  # last<=0 = never re-driven → no cooldown to serve. Guarded explicitly: bare (now-last) arithmetic
  # makes the branch depend on the ABSOLUTE clock — unreachable under a real epoch, permanently true
  # under a small fixture one, i.e. a gate no test could pin.
  [ "$last" -gt 0 ] && [ "$(( now - last ))" -lt "$cd" ] && { echo COOLDOWN; return; }
  [ "$(( now - seen ))" -lt "$persist" ] && { echo WAITING; return; }
  echo REDRIVE
}
# strand_attribution — did MESH-TELL put this text here? Reads mesh-tell's write-ahead log, which
# records the EXACT payload of every send before any key is pressed, and asks whether a recent intent
# for THIS window contains what the composer is showing. That is the sharp discriminator between a
# stranded delivery and a human mid-sentence; without it the only options are "never act" (the fault
# stands) or "submit anything" (we type for the operator).
strand_attribution(){ # $1=window $2=composer snapshot → echoes STRANDED|HELD-OPERATOR|UNATTRIBUTABLE
  local win="$1" snap="$2" wal body probe
  wal="${MESH_TELL_WAL:-$HOME/.mesh/tell-wal.log}"
  [ -s "$wal" ] || { echo UNATTRIBUTABLE; return; }
  # the composer body: drop the marker glyph compose_snapshot prints, the ellipsis its cut adds, and
  # squeeze runs of space (a pane wraps and pads; the WAL payload does not).
  body="$(printf '%s' "$snap" | sed 's/^[[:space:]]*[❯›▌][[:space:]]*//; s/…*$//' | tr -s '[:space:]' ' ')"
  body="${body# }"; body="${body% }"
  # A SHORT string is not an attribution. 'ok' or 'y' would match half the log by coincidence, and a
  # false STRANDED is the branch that presses keys — so the floor fails toward NOT acting.
  [ "${#body}" -ge "${MESH_STRAND_MIN_CHARS:-16}" ] || { echo UNATTRIBUTABLE; return; }
  probe="$(printf '%s' "$body" | cut -c1-48)"
  local now cutoff; now=$(date +%s); cutoff=$(( now - STRAND_WAL_WINDOW ))
  local seen_payload=0 line rowts rowep b64 txt
  # THE WINDOW FILTER COMES AFTER THE USABILITY CHECK, and the order is the whole distinction between
  # the two negative verdicts. `seen_payload` asks "can this WAL answer questions at all right now?" —
  # it must be judged over EVERY window, because a full, live WAL that simply has no row for THIS
  # window is an instrument that ANSWERED (nothing was delivered here → a hand put that text there).
  # Filtering by window first would make "we never sent to this window" indistinguishable from "the
  # WAL is switched off", and those have opposite remedies: ask the operator vs turn the log back on.
  while IFS=$'\t' read -r rowts _ phase _ _ rowwin b64; do
    [ "$phase" = intent ] || continue
    rowep="$(date -u -d "$rowts" +%s 2>/dev/null)" || continue
    [ -n "$rowep" ] && [ "$rowep" -lt "$cutoff" ] && continue
    # a thinned WAL carries no text to compare: 'r:<sha>:<len>' (redact) or '-' (minimal/off). Those
    # rows can neither confirm nor deny, and must not be counted as evidence either way.
    case "$b64" in r:*|-|"") continue ;; esac
    seen_payload=1
    [ "$rowwin" = "$win" ] || continue
    txt="$(printf '%s' "$b64" | base64 -d 2>/dev/null | tr -s '[:space:]' ' ')" || continue
    case "$txt" in *"$probe"*) echo STRANDED; return ;; esac
  done < <(tail -n "${MESH_STRAND_WAL_ROWS:-4000}" "$wal" 2>/dev/null)
  [ "$seen_payload" = 1 ] && { echo HELD-OPERATOR; return; }
  echo UNATTRIBUTABLE
}
# strand_sweep — the arm itself, run per channel from keep()'s alive branch.
# ORDERING NOTE: it runs AFTER the rate-limit and AUTH-DEAD arms on purpose. A walled or logged-out
# mind cannot submit anything, so a composer holding text there is a SYMPTOM of those faults and its
# own remedy would be motion against the wrong cause.
strand_sweep(){ # $1=window $2=pane target (session:win.idx)
  local win="$1" pane="$2"
  # SEPARATE STATEMENT, deliberately: bash expands EVERY right-hand side of a `local a=… b=…$a` line
  # before it assigns any of them, so `mark` computed on the same line as `win` would interpolate the
  # OLD (unset) win — every window's mark collapsing onto one shared `.strand-` file, i.e. one
  # window's streak discharging all of them. Caught by this arm's own --test, which found a single
  # empty-named mark on disk. [[a-redaction-placeholder-used-as-a-key-is-a-self-erasing-collision]]
  # is the same shape one ring out: a constant where a key belongs nets distinct subjects together.
  local mark="$HOME/.mesh/.strand-$win"
  local out verdict snap rc now seen pd cnt last v attr
  now=$(date +%s)
  # THE PREDICATE IS mesh-tell's OWN (see the header). Absent → the arm is DISARMED, and says so
  # rate-limited rather than reading as a clean sweep.
  if ! command -v "${MESH_TELL_CMD:-mesh-tell}" >/dev/null 2>&1; then
    local bs="$HOME/.mesh/.strand-blind.ts"
    if [ ! -f "$bs" ] || [ "$(( now - $(cat "$bs" 2>/dev/null || echo 0) ))" -gt 21600 ]; then
      date +%s > "$bs"
      echo "$(ts) STRAND-BLIND: '${MESH_TELL_CMD:-mesh-tell}' absent — the stranded-composer sweep is DISARMED (a prompt stranded in a composer here would sit unswept)" >> "$STRAND_LOG"
    fi
    return 0
  fi
  STRAND_N_SWEPT=$(( STRAND_N_SWEPT + 1 ))
  out="$(timeout "${MESH_STRAND_TIMEOUT:-25}" "${MESH_TELL_CMD:-mesh-tell}" --composer "$win" 2>/dev/null)"; rc=$?
  verdict="${out%%	*}"; snap="${out#*	}"
  case "$rc" in
    0) rm -f "$mark" 2>/dev/null; return 0 ;;                      # CLEAR — composer empty or engine working
    3) STRAND_N_HELD=$(( STRAND_N_HELD + 1 )) ;;                   # HOLDS — the case this arm exists for
    *) # BLIND / timeout / crash: HOLD the streak, never clear it. A read that failed is not a strand
       # that ended, and clearing here launders every strand through one bad capture.
       STRAND_N_BLIND=$(( STRAND_N_BLIND + 1 ))
       echo "$(ts) STRAND-BLIND $win: could not read the composer (rc=$rc verdict='${verdict:-none}') — streak HELD, not cleared" >> "$STRAND_LOG"
       return 0 ;;
  esac
  local nd; nd="$(printf '%s' "$snap" | sha256sum 2>/dev/null | cut -c1-16)"
  seen=0; pd=""; cnt=0; last=0
  if [ -s "$mark" ]; then
    IFS='|' read -r seen pd cnt last < "$mark" 2>/dev/null
    seen="${seen:-0}"; cnt="${cnt:-0}"; last="${last:-0}"
  fi
  v="$(strand_verdict "$now" "$seen" "$pd" "$nd" "$cnt" "$last" "$STRAND_PERSIST" "$STRAND_COOLDOWN" "$STRAND_GIVEUP")"
  case "$v" in
    ARMED)
      printf '%s|%s|0|0\n' "$now" "$nd" > "$mark"
      echo "$(ts) STRAND-ARMED $win: composer holds text — armed the ${STRAND_PERSIST}s debounce :: ${snap}" >> "$STRAND_LOG" ;;
    CHANGED)
      # A LIVE HAND. Re-arm from now with the new text; never carry the old streak forward.
      printf '%s|%s|0|0\n' "$now" "$nd" > "$mark"
      echo "$(ts) STRAND-CHANGED $win: composer text CHANGED since last pass — a hand is composing, re-armed (no key sent) :: ${snap}" >> "$STRAND_LOG" ;;
    WAITING)
      echo "$(ts) STRAND-WAITING $win: unchanged for $(( now - seen ))s of ${STRAND_PERSIST}s" >> "$STRAND_LOG" ;;
    COOLDOWN)
      echo "$(ts) STRAND-COOLDOWN $win: re-driven $cnt time(s), $(( now - last ))s of ${STRAND_COOLDOWN}s elapsed" >> "$STRAND_LOG" ;;
    GIVEUP)
      # Bounded and LOUD. Repeating a verb that has failed $STRAND_GIVEUP times is not persistence,
      # it is a storm; the remedy left is a hand, so name it once per repost window.
      local gs="$HOME/.mesh/.strand-giveup-$win"
      if [ ! -f "$gs" ] || [ "$(( now - $(stat -c %Y "$gs" 2>/dev/null || echo 0) ))" -gt "${MESH_STRAND_GIVEUP_REPOST:-21600}" ]; then
        : > "$gs"
        echo "$(ts) STRAND-GIVEUP $win: $cnt re-drives did not submit — STOPPING; a hand is the only remedy left :: ${snap}" >> "$STRAND_LOG"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-stranded] $S:$win: a prompt has been sitting UNSUBMITTED in the composer for $(( (now - seen) / 60 ))min and $cnt re-drives did not submit it — the mind reads IDLE but is holding work it cannot start. Composer: ${snap}" >/dev/null 2>&1 || true
      fi ;;
    REDRIVE)
      attr="$(strand_attribution "$win" "$snap")"
      if [ "$attr" != STRANDED ]; then
        # NOT OURS → announce, never touch. HELD-OPERATOR and UNATTRIBUTABLE are kept apart because
        # they have different remedies: the first is a person to ask, the second is an instrument to
        # turn back on (mesh-tell's WAL level).
        local hs="$HOME/.mesh/.strand-held-$win"
        if [ ! -f "$hs" ] || [ "$(( now - $(stat -c %Y "$hs" 2>/dev/null || echo 0) ))" -gt "${MESH_STRAND_HELD_REPOST:-21600}" ]; then
          : > "$hs"
          echo "$(ts) STRAND-$attr $win: composer has held UNCHANGED text for $(( now - seen ))s and mesh-tell's WAL does not attribute it to a delivery — NOT touching it :: ${snap}" >> "$STRAND_LOG"
          command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-holding] $S:$win: composer has held the same text for $(( (now - seen) / 60 ))min with no matching mesh-tell delivery ($attr) — left ALONE (it may be a hand mid-sentence), but this window is NOT idle in the way mesh-mind-state reports it. Composer: ${snap}" >/dev/null 2>&1 || true
        fi
        # keep the streak (still stranded), but do not let it march to GIVEUP on a verb never used
        printf '%s|%s|%s|%s\n' "$seen" "$nd" "$cnt" "$now" > "$mark"
        return 0
      fi
      # OURS. Re-drive with the ladder's own verbs, escalating by attempt — rung 1 (cancel any mode,
      # submit) then the unterminated-paste terminator mesh-tell's rung 3 uses. We NEVER re-paste: the
      # text is already in the composer and we do not hold the payload, so a paste could only duplicate
      # or truncate it. A bare submit cannot double-submit for the same reason mesh-tell's rungs cannot
      # — the composer reads HOLDS only when the engine is NOT working, which can only mean unsubmitted.
      local attempt=$(( cnt + 1 ))
      STRAND_N_ACTED=$(( STRAND_N_ACTED + 1 ))
      if [ "$attempt" -le 1 ]; then
        tmux send-keys -t "$pane" -X cancel 2>/dev/null || true
        tmux send-keys -t "$pane" C-m 2>/dev/null || true
      else
        tmux send-keys -t "$pane" -H 1b 5b 32 30 31 7e 2>/dev/null || true
        sleep 0.2
        tmux send-keys -t "$pane" C-m 2>/dev/null || true
      fi
      sleep 1
      # THE ALERT SITS BEHIND THE ACTUATOR'S OUTCOME, never on the fault: an episode this loop repairs
      # by itself must not wake anyone ([[an-alert-wired-to-the-fault-not-to-its-actuators-outcome]]).
      local after arc
      after="$(timeout "${MESH_STRAND_TIMEOUT:-25}" "${MESH_TELL_CMD:-mesh-tell}" --composer "$win" 2>/dev/null)"; arc=$?
      if [ "$arc" = 0 ]; then
        rm -f "$mark" "$HOME/.mesh/.strand-giveup-$win" "$HOME/.mesh/.strand-held-$win" 2>/dev/null
        echo "$(ts) STRAND-REDRIVEN $win: attempt #$attempt SUBMITTED a prompt stranded for $(( now - seen ))s — composer clear :: ${snap}" >> "$STRAND_LOG"
      else
        printf '%s|%s|%s|%s\n' "$seen" "$nd" "$attempt" "$now" > "$mark"
        echo "$(ts) STRAND-REDRIVE-FAILED $win: attempt #$attempt did not submit (re-read rc=$arc) — composer still holds it :: ${snap}" >> "$STRAND_LOG"
      fi ;;
  esac
  return 0
}
if [ "${1:-}" = --test ]; then
  # ── LEAK GUARD: A TEMPDIR HAS A CLEANUP PATH; THE SERVER STARTED AGAINST IT HAS NONE ──────────
  # Two fixtures below raise a private tmux server (`-L ka-test-$$`, `-L ka-auth-$$`) and each ends
  # it with a plain `kill-server` statement on the happy path. A statement is not a cleanup: it is
  # skipped by every abnormal exit, and mesh-doctor runs every --test under `timeout`, so the abort
  # path is the COMMON one on a loaded node. Measured 2026-08-21 on mesh-home: a clean run leaks
  # ZERO (91 servers before, 91 after — so "the harness never ends it" was the wrong diagnosis), an
  # aborted run leaks EXACTLY ONE (91 -> 92, ka-auth-3306554 outliving its TERMed parent), and 91
  # such orphans had accumulated at 367 MB resident, oldest 30h, youngest 235s — a live rate, not
  # the latched burst it first read as. Same shape as the mode-bit and pref traps: the line is
  # present, and being present is not being RUN.
  #
  # So: register each socket the instant it is created and let ONE trap end them on every exit path,
  # signal included. Scoped by construction — the trap kills only sockets THIS process registered,
  # never a name pattern, so it can never reach the node's own session or another run's fixture
  # (memories a-name-matching-stop-kills-your-other-selves, pkill-f-kills-its-own-wrapper-shell).
  _KA_SOCKS=""; _KA_TMPS=""
  # ONE place that knows where `-L <name>` puts its socket. Hoisted 2026-08-28 so the fixture below
  # can unlink its OWN socket without depending on the parent's registry — see _ka_fixture_teardown.
  _ka_sockfile(){ printf '%s\n' "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$1"; }
  _ka_reap() {                      # idempotent: re-running it kills nothing twice and errors never
    local _s _d                     # escape (an EXIT trap that fails is a new failure mode)
    for _s in $_KA_SOCKS; do
      command tmux -L "$_s" kill-server 2>/dev/null || :
      # kill-server ends the PROCESS; the socket INODE can outlive it (it is what the 294 stale
      # paths in /tmp/tmux-1000 were). 0 bytes each, so this is tidiness, not the 367MB — but a
      # cleanup that leaves half its subject behind is the half nobody comes back for.
      rm -f "$(_ka_sockfile "$_s")" 2>/dev/null || :
    done
    for _d in $_KA_TMPS;  do [ -n "$_d" ] && rm -rf "$_d" 2>/dev/null || :; done
    _KA_SOCKS=""; _KA_TMPS=""
  }
  # EXIT covers `exit N` and falling off the end; the signals cover `timeout`/mesh-doctor/^C, which
  # is where every one of the 91 came from. Re-raise nothing: the reap is all this trap owes.
  trap _ka_reap EXIT
  trap '_ka_reap; exit 143' TERM
  trap '_ka_reap; exit 130' INT
  trap '_ka_reap; exit 129' HUP

  # LEGACY SWEEP (2026-08-28). The registry+trap above stops the class GROWING; it can do nothing
  # about the files already on disk, and nothing else ever will — phaedra holds 838 `ka-test-*`
  # entries, mesh-home held three `ka-auth-*-s3`. Same asymmetry as mesh-mind-control's mc-rowgate
  # strands: a leak whose only reaper is the process that leaked it is unreapable once that process
  # is gone, so the sweep has to live in the tool that mints the name.
  # TWO independent spares, because a reap keyed on a NAME is only as safe as its spare:
  #   (a) the pid this tool minted into the name is still alive  → a concurrent run owns it;
  #   (b) a tmux server still answers on it                      → it is a live server, not litter.
  # Either one spares the file. Our own run satisfies (a) by construction, so the sweep can never
  # reach the sockets this very invocation is about to raise.
  _ka_sweep_legacy(){
    local _d _f _b _p _n=0
    _d="$(dirname "$(_ka_sockfile x)")"
    [ -d "$_d" ] || return 0
    for _f in "$_d"/ka-test-* "$_d"/ka-auth-*; do
      [ -S "$_f" ] || continue                                    # globs that matched nothing, and non-sockets
      _b="${_f##*/}"
      _p="${_b#ka-test-}"; _p="${_p#ka-auth-}"; _p="${_p%%-*}"    # ka-auth-<pid>[-sN] → <pid>
      case "$_p" in ''|*[!0-9]*) continue ;; esac                 # not this tool's grammar — never touch it
      [ -d "/proc/$_p" ] && continue                              # spare (a): a live minting run owns it
      command tmux -L "$_b" list-sessions >/dev/null 2>&1 && continue   # spare (b): a server still answers
      rm -f "$_f" 2>/dev/null && _n=$((_n+1))
    done
    [ "$_n" -gt 0 ] && echo "  note: unlinked $_n orphaned ka-* tmux socket file(s) an earlier --test left in $_d"
    return 0
  }
  _ka_sweep_legacy
  # SWEEP GATE — DRIVEN, not grepped for. A reap keyed on a NAME is only as safe as its spares, so the
  # spares are the thing driven: a live minting pid, a live server, and a name outside this tool's
  # grammar must ALL survive, and only the doubly-dead file may go. Run against a PRIVATE TMUX_TMPDIR
  # so this gate can never touch the node's real /tmp/tmux-<uid>. Falsify by dropping either spare from
  # _ka_sweep_legacy: the corresponding arm reds.
  _swg=0
  _swd="$(mktemp -d 2>/dev/null)"
  if [ -n "$_swd" ]; then
    _KA_TMPS="$_KA_TMPS $_swd"
    ( unset TMUX; export TMUX_TMPDIR="$_swd"
      # mode 700 or tmux refuses the whole dir with "unsafe permissions" and every fixture below
      # silently fails to exist — which reds the SPARE arms, i.e. a fixture fault wearing the
      # costume of the exact code defect this gate exists to catch (measured while writing it).
      mkdir -p "$_swd/tmux-$(id -u)" 2>/dev/null; chmod 700 "$_swd/tmux-$(id -u)" 2>/dev/null
      _sd="$_swd/tmux-$(id -u)"
      { sleep 60 & } 2>/dev/null; _swlive=$!; disown "$_swlive" 2>/dev/null || true
      # 4294967290 is above every Linux pid_max, so /proc can never hold it: a minting run that is
      # definitively gone, arranged without killing anything.
      command tmux -L "ka-auth-4294967290" new-session -d -s t 2>/dev/null   # live SERVER, dead pid → spare (b)
      : > "$_sd/ka-test-4294967289"                                          # doubly dead → the only reap
      : > "$_sd/ka-auth-${_swlive}-s3"                                       # live minting pid → spare (a)
      : > "$_sd/ka-auth-notapid"                                             # not our grammar → untouched
      # `: >` makes a regular FILE, and the sweep skips non-sockets before it ever reaches the grammar
      # guard — so a foreign-name fixture left as a plain file makes that arm VACUOUS: measured, the
      # grammar-guard mutant passed GREEN through it. Every fixture must be a real socket, so that the
      # only thing separating them is the predicate under test.
      for _n in ka-test-4294967289 "ka-auth-${_swlive}-s3" ka-auth-notapid; do
        rm -f "$_sd/$_n"; command tmux -L "$_n" new-session -d -s t 2>/dev/null
        command tmux -L "$_n" kill-server 2>/dev/null      # server gone, socket FILE stays — the litter
      done
      # A FIXTURE PRECONDITION IS NOT A CODE VERDICT — the same rule the AUTH-DEAD fixture below
      # carries, and this gate needs it for a concrete reason: the absence-is-n/a arm re-runs this
      # whole --test in a child with a STUB `tmux` on PATH that exits 0 without creating anything. Its
      # `new-session` therefore "succeeds" and raises no socket, so every spare arm below would read as
      # "the sweep unlinked it" and the child would exit 1 where the caller demands 2 — a stub tmux
      # wearing the costume of the defect. Assert the fixtures EXIST before believing any verdict.
      for _f in ka-test-4294967289 "ka-auth-${_swlive}-s3" ka-auth-4294967290 ka-auth-notapid; do
        [ -e "$_sd/$_f" ] && continue
        echo "  n/a: the ka-* sweep gate could not raise its fixture socket $_f — the spares were NOT driven this run (a node/tmux condition, never a code verdict)"
        command tmux -L "ka-auth-4294967290" kill-server 2>/dev/null; kill -KILL "$_swlive" 2>/dev/null; exit 2
      done
      _swout="$(_ka_sweep_legacy 2>&1)"; _swf=0
      [ -e "$_sd/ka-test-4294967289" ] && { echo "  FAIL: sweep left ka-test-4294967289 — dead minting pid AND no server, the exact litter class it exists to unlink"; _swf=1; }
      [ -e "$_sd/ka-auth-${_swlive}-s3" ] || { echo "  FAIL: sweep unlinked ka-auth-${_swlive}-s3 whose minting pid is STILL ALIVE — that is a concurrent run's fixture"; _swf=1; }
      [ -e "$_sd/ka-auth-4294967290" ] || { echo "  FAIL: sweep unlinked ka-auth-4294967290 while a tmux server was still answering on it — a live server is not litter"; _swf=1; }
      [ -e "$_sd/ka-auth-notapid" ] || { echo "  FAIL: sweep unlinked ka-auth-notapid, a name outside this tool's <pid> grammar — it may only ever reach names it minted"; _swf=1; }
      printf '%s' "$_swout" | grep -q 'unlinked 1 orphaned' || { echo "  FAIL: a sweep that unlinked a strand must SAY so (a silent reap is a census with no numerator); got: $_swout"; _swf=1; }
      command tmux -L "ka-auth-4294967290" kill-server 2>/dev/null
      kill -KILL "$_swlive" 2>/dev/null
      exit "$_swf" )
    _swg=$?
    rm -rf "$_swd" 2>/dev/null
    case "$_swg" in
      0) echo "smoke-test: ok (ka-* socket sweep: the doubly-dead orphan is unlinked and named; a live minting pid, a live server and a foreign name all survive)" ;;
      2) echo "smoke-test: n/a (ka-* socket sweep gate did not run on this node — it asserted nothing, and said so)" ;;
      *) echo "smoke-test: FAIL (ka-* socket sweep drifted — it either leaves the litter or reaps a live run's fixture)"; exit 1 ;;
    esac
  else
    echo "smoke-test: n/a (ka-* socket sweep gate did not run — mktemp -d failed; the spares were NOT driven this run)"
  fi

  # ── A --test ANSWERS "IS THE CODE SOUND", NEVER "IS THIS NODE HEALTHY" ────────────────────────
  # These two preconditions used to `exit 1` (FAIL). They are not code verdicts: no tmux binary, and
  # no hostname-named session, are facts about the NODE — the organ this tool drives is simply not
  # here to be exercised. Reporting them as FAIL is the same shape the genome already fixed for
  # absent hardware (mesh-fail2ban-watch / mesh-egress-tunnel exit 2 → mesh-autowire SKIPs, mesh-land
  # treats exit 2 as a pass); this file just never got it.
  #
  # MEASURED CONSEQUENCE, and why it is worth a commit (2026-08-17, genome, via the health baton):
  # phaedra has no tmux server at all, so THIS line returned FAIL there. phaedra's fitness reflex read
  # that FAIL as a regression introduced by the commit under test and REVERTED d6bf0e18 (the
  # restore.env-inheritance fix) to protect against it. That revert is what the board has been
  # reporting for days as `[genome-strand] phaedra: DIVERGED (ahead 1, behind 1) … deployed tools are
  # STALE, 'in sync' is HOLLOW` — one sick node's missing session vetoing a healthy commit and jamming
  # the strand for the whole mesh ([[autoland-divergence-jams-autopoiesis]]). d6bf0e18 is innocent:
  # its own relaunch-env gate passes here, and on phaedra the run never reaches it — it dies at this
  # precondition, six hundred lines earlier.
  #
  # The node-health alarm is NOT dropped, it is RETURNED TO ITS OWNER: a mind node without its session
  # is a real fault and mesh-health / mesh-supervise / mesh-restore already own it (doctrine: "if the
  # hostname-named session is missing on a node, restoring it is mandatory and comes first"). What must
  # not own it is a code-soundness gate that landings are keyed on. So: say it loudly on stderr, name
  # the remedy, and exit 2 — honest n/a, never a verdict about the code.
  command -v tmux >/dev/null 2>&1 || {
    echo "mesh-channel-keepalive --test: n/a (no tmux on this node — the organ this tool drives does not exist here; nothing to exercise)" >&2; exit 2; }
  tmux has-session -t "$S" 2>/dev/null || {
    echo "mesh-channel-keepalive --test: n/a (no tmux session '$S' — this is a NODE condition, not a code verdict: the code cannot be exercised without the session it tends. If this node declares minds on its card, that missing session IS a fault and the remedy is \`mesh-restore\`, owned by mesh-health/mesh-supervise — not by this gate, which landings are keyed on)" >&2; exit 2; }
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null >/dev/null || {
    echo "mesh-channel-keepalive --test: n/a (session '$S' exists but is unreadable — a node condition, same reasoning as above)" >&2; exit 2; }
  # Dry-run the cooldown CLASSIFIER (rl_cooldown_secs) — the load-bearing logic that decides how long a
  # walled mind is paused. It was UNTESTED (old --test only checked the tmux session); a regex drift here
  # silently re-poked a week-long wall every <=6h. FALSIFIABLE: revert is_long to monthly-only and the
  # weekly assert FAILs. (Test moved below the function def so it can call it; nothing above has side-fx.)
  if command -v python3 >/dev/null 2>&1; then
    f=0
    wk=$(printf 'You have reached your weekly usage limit. Your limit will reset in 3 days.\n' | rl_cooldown_secs)
    mo=$(printf 'Approaching your monthly usage limit.\n' | rl_cooldown_secs)
    tr=$(printf 'Please try again in 2h.\n' | rl_cooldown_secs)
    # a WEEKLY wall must exceed the 6h short clamp (treated as long-window → 24h clamp), not thrash
    [ "${wk:-0}" -gt 21600 ] || { echo "  FAIL: weekly wall cooldown=${wk:-none}s not >6h (weekly not treated as long-window)"; f=1; }
    # a MONTHLY wall with no parseable time must hit the long fallback (>6h)
    [ "${mo:-0}" -gt 21600 ] || { echo "  FAIL: monthly wall cooldown=${mo:-none}s not >6h"; f=1; }
    # a TRANSIENT 'try again in 2h' must stay the short reset (~7200s), NOT be escalated to long-window
    { [ "${tr:-0}" -ge 7000 ] && [ "${tr:-0}" -le 7400 ]; } || { echo "  FAIL: transient 'in 2h' cooldown=${tr:-none}s not ~7200 (short-window broke)"; f=1; }
    [ "$f" = 0 ] || { echo "smoke-test: FAIL (rl_cooldown_secs classifier drifted)"; exit 1; }
    echo "smoke-test: ok (cooldown classifier: weekly=${wk}s monthly=${mo}s transient=${tr}s — long-window vs short verified)"
  else
    echo "smoke-test: ok (no python3 — cooldown-classifier check skipped)"
  fi
  # STALE MODEL PIN in a sticky capture (drop_stale_model_flag). A sticky is a SNAPSHOT of an argv,
  # so a `--model` recorded once outlives every later config change: measured 2026-08-30, the tg
  # window relaunched `--model opus` hours after restore.env had put the whole mesh on the account
  # default, and the operator re-typed /model default at every wake. FALSIFIABLE both ways — the
  # strip must fire when the declared cmd is silent, and must NOT fire when it names a model.
  mf=0
  _D="$HOME/.local/bin/claude --permission-mode bypassPermissions"
  [ "$(drop_stale_model_flag "$_D" "$_D --model opus --settings /x/lean.json")" \
      = "$_D --settings /x/lean.json" ] || { echo "  FAIL: stale --model not stripped from capture"; mf=1; }
  [ "$(drop_stale_model_flag "$_D" "$_D --model=opus")" = "$_D" ] || { echo "  FAIL: --model=v form not stripped"; mf=1; }
  [ "$(drop_stale_model_flag "$_D --model sonnet" "$_D --model sonnet")" = "$_D --model sonnet" ] \
      || { echo "  FAIL: a DECLARED model (RL fallback) must survive the capture"; mf=1; }
  [ "$(drop_stale_model_flag "$_D" "opencode -m opencode/mimo-v2.5-free")" = "opencode -m opencode/mimo-v2.5-free" ] \
      || { echo "  FAIL: a non-claude engine's own -m flag must not be touched"; mf=1; }
  [ "$mf" = 0 ] || { echo "smoke-test: FAIL (drop_stale_model_flag drifted — a config model change cannot reach a sticky window)"; exit 1; }
  echo "smoke-test: ok (stale model pin: capture drops --model when config is silent, keeps it when config names one)"
  ef=0
  captured_engine_matches "$HOME/.local/bin/codex --model gpt-5.6-luna" codex \
      || { echo "  FAIL: matching Codex capture rejected"; ef=1; }
  captured_engine_matches "$HOME/.local/bin/codex --model gpt-5.6-luna" node \
      || { echo "  FAIL: node-wrapped Codex capture rejected"; ef=1; }
  captured_engine_matches "$HOME/.local/bin/codex --model gpt-5.6-luna" claude \
      && { echo "  FAIL: stale Claude capture accepted for Codex config"; ef=1; }
  captured_engine_matches "$HOME/.local/bin/claude --permission-mode bypassPermissions" codex \
      && { echo "  FAIL: stale Codex capture accepted for Claude config"; ef=1; }
  [ "$ef" = 0 ] || { echo "smoke-test: FAIL (captured engine policy drifted)"; exit 1; }
  echo "smoke-test: ok (captured engine must match configured engine; stale cross-engine argv rejected)"
  sf=0; _sf="$HOME/.mesh/.kw-test-sticky.$$"; _D="$HOME/.local/bin/codex --model gpt-5.6-luna"
  printf '%s\n' '/home/mesh-home/.local/bin/codex --model gpt-6-astra' > "$_sf"
  [ "$(sticky_cmd_for_declared "$_D" "$_sf")" = "$_D" ] \
    || { echo "  FAIL: same-engine old model sticky was not replaced by declared Luna"; sf=1; }
  printf '%s\n' '/home/mesh-home/.local/bin/claude --permission-mode bypassPermissions' > "$_sf"
  [ "$(sticky_cmd_for_declared "$_D" "$_sf")" = "$_D" ] \
    || { echo "  FAIL: cross-engine Claude sticky was not replaced by declared Codex"; sf=1; }
  rm -f "$_sf"
  [ "$sf" = 0 ] || { echo "smoke-test: FAIL (persisted sticky command policy drifted)"; exit 1; }
  echo "smoke-test: ok (persisted sticky rejects stale Claude and old Astra, selects declared Luna)"
  # AUTO-REVERT decision (quota_should_revert) — the load-bearing gate for returning a paid window to
  # claude on quota reset. FALSIFIABLE: flip any branch and an assert FAILs.
  rf=0
  quota_should_revert 0 10 7200    || { echo "  FAIL: cooldown EXPIRED should revert"; rf=1; }
  quota_should_revert 1 100 7200   && { echo "  FAIL: cooldown ACTIVE + young must NOT revert"; rf=1; }
  quota_should_revert 1 8000 7200  || { echo "  FAIL: aged-past-cap (misparse guard) should revert"; rf=1; }
  quota_should_revert 1 7200 7200  || { echo "  FAIL: age == cap should revert (boundary)"; rf=1; }
  [ "$rf" = 0 ] || { echo "smoke-test: FAIL (quota_should_revert decision drifted)"; exit 1; }
  echo "smoke-test: ok (auto-revert decision verified: expired→revert, active+young→hold, aged→revert)"
  # opencode auto-approve opt-in (chat-review/room-mind-opencode-engine-drift 2026-07-04): --auto must
  # be appended ONLY when (a) opted in via MESH_OPENCODE_YOLO=1 AND (b) the resolved binary basename is
  # opencode — never for claude/codex/gemini, never when unset (default OFF), and never double-appended
  # if already present. A regression here either silently re-freezes every opencode channel on the y/n
  # gate (opt-in ignored) or ships auto-approve mesh-wide unconditionally (opt-in bypassed) — both wrong.
  of=0
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag opencode)" = "opencode --auto" ]                    || { echo "  FAIL: bare opencode + opt-in should append --auto"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'opencode -m opencode/deepseek-v4-flash-free')" = "opencode -m opencode/deepseek-v4-flash-free --auto" ] || { echo "  FAIL: opencode w/ args + opt-in should append --auto"; of=1; }
  [ "$(opencode_autoflag opencode)" = "opencode" ]                                                || { echo "  FAIL: opt-out (default) must NOT append --auto"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'claude --permission-mode auto')" = "claude --permission-mode auto" ] || { echo "  FAIL: non-opencode engine must be untouched even when opted in"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'opencode --auto')" = "opencode --auto" ]            || { echo "  FAIL: already-present --auto must not double-append"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'OPENCODE_MODEL=x opencode')" = "OPENCODE_MODEL=x opencode --auto" ] || { echo "  FAIL: env-var-prefixed opencode cmd should still resolve+append"; of=1; }
  [ "$of" = 0 ] || { echo "smoke-test: FAIL (opencode_autoflag drifted)"; exit 1; }
  echo "smoke-test: ok (opencode auto-approve: opt-in gated, basename-scoped, no double-append)"
  # SHED-AUDIT instrument (instrument-first, non-ergodicity review): shed_mind must record the
  # absorbing-barrier exposure (RECOVERABLE vs BARE pane) before the kill — zero behavior change,
  # visibility only. The helper is defined BELOW this --test block (can't be called here), so verify
  # the wiring is present in the source. FALSIFIABLE: drop either line and an assert FAILs.
  src="${BASH_SOURCE[0]:-$0}"
  grep -q 'shed_recoverability()' "$src" || { echo "smoke-test: FAIL (shed-audit helper shed_recoverability missing)"; exit 1; }
  grep -q 'SHED-AUDIT .*shed_recoverability' "$src" || { echo "smoke-test: FAIL (shed_mind lost the SHED-AUDIT instrument before the kill)"; exit 1; }
  echo "smoke-test: ok (shed-audit instrument wired: shed_recoverability classifier + SHED-AUDIT log before kill)"
  # SPAWN-AUDIT (chat-review/mind-spawn-audit-log): relaunch() must log win+resolved-MESH_WHO+engine
  # to .mind-spawn-audit.log BEFORE the mind launches, mirroring mesh-restore's ensure_channel.
  grep -q 'mind-spawn-audit.log' "$src" || { echo "smoke-test: FAIL (relaunch() lost the spawn-audit log line)"; exit 1; }
  echo "smoke-test: ok (spawn-audit wired: relaunch() logs win/who/engine to .mind-spawn-audit.log)"
  # RELAUNCH-BURST coalesce (chat-review/keepalive-relaunch-burst-coalesce, 2026-07-20): FUNCTIONAL
  # test of render_relaunch_posts — the pure text→text renderer the pass flushes through, so this
  # asserts the batching CONTRACT without typing into panes or posting to the real board.
  # FALSIFIABLE: make render emit per-line posts unconditionally (the old behavior) and the batch
  # assert FAILs (3 lines instead of 1); drop the single-case format and the single assert FAILs.
  bf=0
  _r1=$(printf '%s\n' "$S:genome.1|claude" | render_relaunch_posts)
  [ "$_r1" = "[mind-relaunched] channel-keepalive: relaunched $S:genome.1 (claude)" ] || { echo "  FAIL: single relaunch must keep the classic full-detail line (got: $_r1)"; bf=1; }
  _r3=$(printf '%s\n' "$S:room.1|opencode" "$S:sound.1|opencode" "$S:tg-roz.1|claude --model x" | render_relaunch_posts)
  [ "$(printf '%s\n' "$_r3" | wc -l)" = 1 ] || { echo "  FAIL: 3 relaunches must coalesce to ONE line (got $(printf '%s\n' "$_r3" | wc -l))"; bf=1; }
  [ "$_r3" = "[mind-relaunched] channel-keepalive: batch of 3 relaunched this pass: room sound tg-roz" ] || { echo "  FAIL: batch line format drifted (got: $_r3)"; bf=1; }
  _r0=$(printf '' | render_relaunch_posts)
  [ -z "$_r0" ] || { echo "  FAIL: empty pass must post nothing (got: $_r0)"; bf=1; }
  [ "$bf" = 0 ] || { echo "smoke-test: FAIL (relaunch-burst coalesce drifted)"; exit 1; }
  echo "smoke-test: ok (relaunch-burst coalesce: single→full line, N≥2→one batched line, empty→silent)"
  # quota_wave hoist + cooldown (chat-review/quota-wave-suppress-race): FUNCTIONAL test. The cooldown
  # check must run BEFORE appending/counting WAVE_FILE (hoisted out of cnt>=threshold) so a concurrent
  # rate-limit cascade can't race the check-then-set and leak [mind-paused] posts past active
  # suppression. FALSIFIABLE: re-nest the check inside cnt>=threshold (after the append) and the
  # "active cooldown leaves WAVE_FILE empty" assert FAILs (the append would fire before the return).
  # mesh-chat is stubbed so --test never posts a [quota-wave] line to the real board.
  qf=0
  _tw="$HOME/.mesh/.kw-test-wave.$$"; _tm="$HOME/.mesh/.kw-test-mark.$$"
  mesh-chat(){ :; }   # stub (shell fn shadows the command for the duration of --test)
  WAVE_FILE="$_tw"; WAVE_COOLDOWN_MARK="$_tm"; WAVE_THRESHOLD=3; WAVE_WINDOW=600; WAVE_COOLDOWN=60
  # (1) ACTIVE cooldown (future mark) → return 1 AND WAVE_FILE stays empty (hoisted check short-
  #     circuits BEFORE the append). THIS is the race fix: nested-after-append would leave an entry.
  : > "$_tw"; echo "$(( $(date +%s) + 300 ))" > "$_tm"
  quota_wave testwin; rc=$?
  { [ "$rc" = 1 ] && [ ! -s "$_tw" ]; } || { echo "  FAIL: active cooldown rc=$rc (want 1) / WAVE_FILE non-empty — hoist regressed (check ran after append)"; qf=1; }
  # (2) threshold crossing (≥3 in-window entries) → arm the cooldown mark + return 1 (suppress)
  : > "$_tw"; rm -f "$_tm"; n=$(date +%s); printf '%s|a\n%s|b\n%s|c\n' "$n" "$n" "$n" >> "$_tw"
  quota_wave testwin; rc=$?
  { [ "$rc" = 1 ] && [ -f "$_tm" ]; } || { echo "  FAIL: threshold-crossing rc=$rc (want 1) / mark not armed"; qf=1; }
  # (3) below threshold → return 0 (caller posts [mind-paused] normally); mark NOT armed
  : > "$_tw"; rm -f "$_tm"; printf '%s|a\n' "$n" >> "$_tw"
  quota_wave testwin; rc=$?
  { [ "$rc" = 0 ] && [ ! -e "$_tm" ]; } || { echo "  FAIL: below-threshold rc=$rc (want 0) / mark wrongly armed"; qf=1; }
  rm -f "$_tw" "$_tm"
  # instance flock (chat-review/quota-wave-suppress-race): non-blocking lock so only one keepalive pass
  # mutates wave/cooldown state at a time. Search term built from a var so this assert doesn't match
  # its OWN grep text (FALSIFIABLE: drop the exec/flock from the pass and the count drops to 0 → FAIL).
  _flk="flock"; [ "$(grep -cF -- "$_flk -n 200" "$src")" -ge 1 ] || { echo "  FAIL: instance lock missing before the pass (no flock guard on the keepalive run)"; qf=1; }
  [ "$qf" = 0 ] || { echo "smoke-test: FAIL (quota_wave hoist/cooldown or instance-lock drifted)"; exit 1; }
  echo "smoke-test: ok (quota_wave: active-cooldown suppresses w/o file touch, threshold arms mark, below=0; instance flock present)"

  # chat-review/quota-wave-caller-inverted: the caller must post [mind-paused] when quota_wave
  # returns 0 (post normally) and stay silent when it returns 1 (suppress) — NOT inverted. The above
  # asserts quota_wave's OWN return contract; this asserts the call site respects it (FALSIFIABLE:
  # reintroduce the negated form and this FAILs). Pattern built from a var (like the flock check
  # above) so this test's own source text can't satisfy its own grep.
  _qwc="quota_wave \"\$1\"; then"
  grep -qF -- "if $_qwc" "$src" || { echo "  FAIL: quota_wave caller polarity missing/reverted (want 'if quota_wave', not negated)"; qf=1; }
  grep -qF -- "if ! $_qwc" "$src" && { echo "  FAIL: quota_wave caller still inverted ('if ! quota_wave' present)"; qf=1; }
  [ "$qf" = 0 ] || { echo "smoke-test: FAIL (quota_wave caller polarity regressed)"; exit 1; }
  echo "smoke-test: ok (quota_wave caller polarity: posts [mind-paused] only when quota_wave says post-normally)"

  # SHED-VISIBLE (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): the SHED branch must
  # write a visible marker INTO the pane (not just the log/board) so a human — or mesh-mind-state's
  # DEAD-SHELL classifier — can tell why a pane sits on a bare shell without cross-referencing the
  # log. Source guard (shed_mind/keep are defined BELOW this --test block, same reason the SHED-AUDIT
  # guard above is source-only) — FALSIFIABLE: drop the send-keys line and this FAILs.
  grep -q "SHED-VISIBLE" "$src" || { echo "smoke-test: FAIL (SHED-VISIBLE pane-write instrument missing entirely)"; exit 1; }
  grep -qF "tmux send-keys -t \"\$S:\$1.\$mp\" \"echo '--- SHED until" "$src" \
    || { echo "smoke-test: FAIL (SHED branch no longer writes a visible 'SHED until HH:MM' line into the pane)"; exit 1; }
  # ordering: the pane-write must come AFTER shed_mind (writing into a pane whose mind hasn't been
  # killed yet would race the kill, or worse type into the still-live mind's input instead of the
  # settled shell) — mirrors the ordering guards already used elsewhere in this file/mesh-dispatch.
  _shedline=$(grep -n '^      shed_mind "\$S:\$1\.\$mp"' "$src" | head -1 | cut -d: -f1)
  _visline=$(grep -nF "tmux send-keys -t \"\$S:\$1.\$mp\" \"echo '--- SHED until" "$src" | head -1 | cut -d: -f1)
  { [ -n "$_shedline" ] && [ -n "$_visline" ] && [ "$_shedline" -lt "$_visline" ]; } \
    || { echo "smoke-test: FAIL (SHED-VISIBLE pane-write must be positioned after shed_mind, not before)"; exit 1; }
  echo "smoke-test: ok (SHED-VISIBLE: a shed writes '--- SHED until HH:MM ---' into the pane, positioned after the kill)"

  # chat-review/keepalive-resume-tz-mismatch: the SHED resume time (pane "SHED until HH:MM" marker + the
  # [mind-paused] "auto-resumes ~HH:MM" board line) MUST be UTC+Z so it reads on the SAME clock as the
  # board's own UTC(Z) timestamps. Rendered in local (+0300) a real 1800s pause read as a ~3.5h
  # down-window. resume_hm_fmt is defined above this block (functionally testable). FALSIFIABLE: revert
  # it to bare `date -d ... +%H:%M` and, under a non-UTC TZ (forced here), the Z-suffix + equals-UTC
  # asserts FAIL. The fixture epoch is TZ-independent; TZ is pinned so local≠UTC is guaranteed.
  tf=0
  _ep=1000000000                                   # fixed epoch — same rendered value on any box
  _got="$(TZ=Asia/Nicosia resume_hm_fmt "$_ep")"   # the REAL helper, run under a non-UTC TZ
  _want_utc="$(date -u -d "@${_ep}" '+%H:%MZ')"
  _local_nic="$(TZ=Asia/Nicosia date -d "@${_ep}" '+%H:%M')"
  case "$_got" in *Z) ;; *) echo "  FAIL: resume '$_got' lacks the Z (UTC) suffix — formatted without -u/Z"; tf=1;; esac
  [ "$_got" = "$_want_utc" ] || { echo "  FAIL: resume '$_got' != UTC render '$_want_utc' (rendered in local TZ?)"; tf=1; }
  if [ "$_local_nic" != "${_want_utc%Z}" ]; then   # tzdata present → Nicosia genuinely differs from UTC
    [ "${_got%Z}" != "$_local_nic" ] || { echo "  FAIL: resume '${_got}' equals LOCAL Nicosia '$_local_nic' — not UTC"; tf=1; }
  fi
  # regression-guard: HH:MMZ derives from exactly pause-start + secs (the resume_epoch the mark stores)
  _start=1000000000; _secs=1800; _re=$(( _start + _secs ))
  [ "$(resume_hm_fmt "$_re")" = "$(date -u -d "@${_re}" '+%H:%MZ')" ] \
    || { echo "  FAIL: resume epoch mapping (start+secs) drifted"; tf=1; }
  [ "$tf" = 0 ] || { echo "smoke-test: FAIL (resume_hm_fmt TZ/format regressed — resume time not UTC+Z)"; exit 1; }
  echo "smoke-test: ok (resume time UTC+Z: TZ-independent under TZ=Asia/Nicosia, ==date -u render, ≠local, epoch=start+secs)"

  # RESTORE-ENV (2026-08-12, egress incident): a keepalive-relaunched mind must inherit the node's
  # ~/.mesh/restore.env — mesh-restore's ensure_channel sources it, the RELAUNCH path did NOT, so a
  # mind relaunched by the */4 reflex (the path that runs minds MOST of the time) came up WITHOUT
  # ALL_PROXY and 403'd on geo-blocked MTS egress, died, and was relaunched again ~every minute.
  # This gate is BEHAVIOURAL, not a source grep: it drives the real relaunch() into a throwaway tmux
  # server with a fake HOME and asserts the value reaches the PANE. FALSIFIABLE: delete the
  # `. "$HOME/.mesh/restore.env"` clause from relaunch() and PROBE comes back empty → FAIL.
  _rt=$(mktemp -d); _rsock="ka-test-$$"; tf=0
  _KA_SOCKS="$_KA_SOCKS $_rsock"; _KA_TMPS="$_KA_TMPS $_rt"   # leak guard: reaped by _ka_reap on ANY exit
  mkdir -p "$_rt/home/.mesh"
  printf 'export KEEPALIVE_ENV_PROBE=proxy-ok\n' > "$_rt/home/.mesh/restore.env"
  if tmux -L "$_rsock" new-session -d -s t -x 80 -y 24 2>/dev/null; then
    tmux -L "$_rsock" send-keys -t t:0.0 "export HOME='$_rt/home'; export PS1='> '" C-m 2>/dev/null; sleep 0.4
    ( LOG="$_rt/relaunch.log"; S="t"; MIND_PATH_PREFIX=""; RELAUNCH_ACC=""
      TMUX_SOCK_OVERRIDE=1
      tmux(){ command tmux -L "$_rsock" "$@"; }
      relaunch "t:0.0" 'echo "PROBE=[$KEEPALIVE_ENV_PROBE]"' ) 2>/dev/null
    # POLLED, not slept-for — the same node sensor the AUTH-DEAD cure fixture carried: a fixed sleep
    # here turns a slow node into `smoke-test: FAIL (relaunch() no longer sources ~/.mesh/restore.env)`,
    # which mesh-fitness and mesh-land read as a code verdict. A mutant that stops sourcing restore.env
    # prints PROBE=[] immediately, so it is still caught on the first poll, not by waiting it out.
    _rw=0; _pane=""
    while [ "$_rw" -lt 40 ]; do
      _pane="$(tmux -L "$_rsock" capture-pane -p -t t:0.0 2>/dev/null)"
      # Break on the RESOLVED marker only. send-keys ECHOES the command into the pane, so the pane
      # holds the literal `PROBE=[$KEEPALIVE_ENV_PROBE]` before the shell ever runs it — polling on a
      # bare `PROBE=[` matches the typed text and reads a healthy tree as a FAIL (measured here).
      case "$(printf '%s' "$_pane" | grep -o 'PROBE=\[[^]]*\]' | grep -cv 'KEEPALIVE_ENV_PROBE')" in 0) ;; *) break;; esac
      _rw=$((_rw+1)); sleep 0.25
    done
    case "$_pane" in
      *"PROBE=[proxy-ok]"*) ;;
      *"PROBE=["*) echo "  FAIL: relaunched pane did not inherit restore.env (got: $(printf '%s' "$_pane" | grep -o 'PROBE=\[[^]]*\]' | tail -1))"; tf=1;;
      *) echo "  n/a: relaunched pane printed no PROBE within 10s — restore.env inheritance was NOT verified this run (a node condition, never a code verdict)"; tf=2;;
    esac
    tmux -L "$_rsock" kill-server 2>/dev/null
  else
    echo "  skip: tmux unavailable for the relaunch-env fixture"; tf=2
  fi
  rm -rf "$_rt"
  [ "$tf" = 1 ] && { echo "smoke-test: FAIL (relaunch() no longer sources ~/.mesh/restore.env — relaunched minds lose proxy/egress env)"; exit 1; }
  [ "$tf" = 0 ] && echo "smoke-test: ok (relaunch-env: a relaunched pane inherits ~/.mesh/restore.env — real tmux pane, value asserted)"
  [ "$tf" = 2 ] && echo "smoke-test: n/a (relaunch-env fixture did not run on this node — asserted nothing, and said so)"

  # AUTH-DEAD ARM (auth-dead-minds-are-detected-everywhere-and-healed-nowhere, 2026-08-18). Three
  # FUNCTIONAL gates, no source greps: the pure storm-guard decision, the burst renderer, and the
  # classifier rc contract driven through a fixture binary + the real deployed tool.
  af=0
  # (1) the decision table. FALSIFIABLE: reorder GIVEUP/COOLDOWN, drop the debounce, or flip a
  #     comparison and one of these FAILs. now=1000 throughout; args: now seen last cnt cd giveup persist
  [ "$(authdead_verdict 1000    0    0 0 1800 3 240)" = PENDING  ] || { echo "  FAIL: first sighting must arm the debounce (PENDING)"; af=1; }
  [ "$(authdead_verdict 1000  900    0 0 1800 3 240)" = WAIT     ] || { echo "  FAIL: 100s < 240s persist must WAIT, not kill"; af=1; }
  [ "$(authdead_verdict 1000  700    0 0 1800 3 240)" = RELAUNCH ] || { echo "  FAIL: 300s ≥ 240s persist must RELAUNCH"; af=1; }
  [ "$(authdead_verdict 1000  760    0 0 1800 3 240)" = RELAUNCH ] || { echo "  FAIL: persist boundary (exactly 240s) must RELAUNCH"; af=1; }
  [ "$(authdead_verdict 1000  700  500 1 1800 3 240)" = COOLDOWN ] || { echo "  FAIL: a relaunch 500s ago must be held by the 1800s cooldown"; af=1; }
  [ "$(authdead_verdict 5000  700  500 1 1800 3 240)" = RELAUNCH ] || { echo "  FAIL: expired cooldown must allow the next auth-relaunch"; af=1; }
  [ "$(authdead_verdict 5000  700  500 3 1800 3 240)" = GIVEUP   ] || { echo "  FAIL: count == giveup must STOP (a revoked credential needs a human, not a loop)"; af=1; }
  [ "$(authdead_verdict 1000  700  999 3 1800 3 240)" = GIVEUP   ] || { echo "  FAIL: GIVEUP must outrank COOLDOWN (else an expired cooldown re-arms a revoked credential)"; af=1; }
  # (1b) THE CLEAR GATE. The streak's whole storm guard is only as good as what is allowed to DELETE
  #      it, and the old rule ("first not-AUTH-DEAD reading") was satisfied by the reading a fresh
  #      pane always gives — so a_cnt reset every cycle and (1)'s GIVEUP row above, though correct,
  #      was unreachable in production. FALSIFIABLE: make IDLE clear (mutant `[ "$st" != AUTH-DEAD ]
  #      && echo CLEAR-WORKING`) and the two HOLD/ARM rows FAIL; drop the WORKING row and the
  #      positive-proof row FAILs; drop the NOSTREAK row and a window with no streak starts aging a
  #      candidate file forever.  args: streak-present pane-state now ok-since persist
  [ "$(authdead_clear_verdict 0 IDLE    1000    0 240)" = NOSTREAK        ] || { echo "  FAIL: no streak → nothing to clear (and no candidate may age on its own)"; af=1; }
  [ "$(authdead_clear_verdict 1 WORKING 1000    0 240)" = CLEAR-WORKING   ] || { echo "  FAIL: an observed WORKING turn is positive proof the credential authenticates and must clear the streak"; af=1; }
  [ "$(authdead_clear_verdict 1 IDLE    1000    0 240)" = ARM             ] || { echo "  FAIL: a bare IDLE must ARM the sustained window, NOT clear — a fresh pane reads IDLE whether the credential is good or revoked"; af=1; }
  [ "$(authdead_clear_verdict 1 IDLE    1100 1000 240)" = HOLD            ] || { echo "  FAIL: 100s < 240s of sustained health must HOLD the streak"; af=1; }
  [ "$(authdead_clear_verdict 1 IDLE    1240 1000 240)" = CLEAR-SUSTAINED ] || { echo "  FAIL: the persist boundary (exactly 240s) must clear"; af=1; }
  [ "$(authdead_clear_verdict 1 IDLE    1300 1000 240)" = CLEAR-SUSTAINED ] || { echo "  FAIL: sustained not-AUTH-DEAD past the window must clear"; af=1; }
  #      the EMPTY state word is the classifier saying nothing (a stub, a truncated read). It must
  #      never wear WORKING's privilege — an unknown word is unproven, not proven.
  [ "$(authdead_clear_verdict 1 ""      1000    0 240)" = ARM             ] || { echo "  FAIL: an EMPTY pane-state must be unproven (ARM), never read as WORKING"; af=1; }
  [ "$(authdead_clear_verdict 1 UNKNOWN 1000    0 240)" = ARM             ] || { echo "  FAIL: UNKNOWN must be unproven (ARM) — it shares exit code 0 with WORKING, which is the whole defect"; af=1; }
  #      and the two ways to clear must be DISTINGUISHABLE, or one fixture could satisfy both rows
  #      while only one branch exists (the two-candidates-one-value fixture trap).
  [ "$(authdead_clear_verdict 1 WORKING 1000    0 240)" != "$(authdead_clear_verdict 1 IDLE 1300 1000 240)" ] \
    || { echo "  FAIL: the WORKING clear and the SUSTAINED clear render identically — one of the two branches is not really there"; af=1; }
  # (1c) PANE_STATE must come from the classifier's OWN stdout, on the same read as the rc. A
  #      classifier that prints "WORKING\t..." and exits 0 must set it; one that prints nothing must
  #      leave it EMPTY. FALSIFIABLE: drop the capture and the first row reads empty.
  _cs="$(mktemp -d)"
  printf '#!/bin/sh\nprintf "WORKING\\tesc to interrupt\\n"\nexit 0\n' > "$_cs/msw"; chmod +x "$_cs/msw"
  printf '#!/bin/sh\nexit 0\n' > "$_cs/msq"; chmod +x "$_cs/msq"
  MESH_MINDSTATE_CMD="$_cs/msw" pane_authdead zzwin
  [ "$PANE_STATE" = WORKING ] || { echo "  FAIL: pane_authdead did not carry the state WORD out of its own read (got '${PANE_STATE:-<empty>}') — the exit code cannot separate WORKING from IDLE"; af=1; }
  MESH_MINDSTATE_CMD="$_cs/msq" pane_authdead zzwin
  [ -z "$PANE_STATE" ] || { echo "  FAIL: a classifier that printed nothing left PANE_STATE='$PANE_STATE' — a silent read must be EMPTY, never a state word"; af=1; }
  rm -rf "$_cs"
  # (2) burst coalescing — a node-wide auth outage is N windows at once (4 on 2026-08-18).
  _a1="$(printf '%s\n' 'genome|1' | render_authdead_posts)"
  case "$_a1" in "[mind-authdead] channel-keepalive: genome was AUTH-DEAD"*"auth-relaunch #1") ;; *) echo "  FAIL: single auth-relaunch line drifted (got: $_a1)"; af=1;; esac
  _a4="$(printf '%s\n' 'genome|1' 'health|1' 'senses|2' 'sound|1' | render_authdead_posts)"
  [ "$(printf '%s\n' "$_a4" | wc -l)" = 1 ] || { echo "  FAIL: 4 auth-relaunches must coalesce to ONE board line"; af=1; }
  case "$_a4" in *"4 minds were AUTH-DEAD"*"genome health senses sound") ;; *) echo "  FAIL: batched auth line format drifted (got: $_a4)"; af=1;; esac
  [ -z "$(printf '' | render_authdead_posts)" ] || { echo "  FAIL: a pass with no auth-relaunch must post nothing"; af=1; }
  # (3) the rc-9 CONTRACT, driven — not read. A fixture 'classifier' on the real call path proves this
  #     tool converts rc 9 → act, anything else → leave alone, and a missing/failing tool → BLIND (2),
  #     which is the branch that must never masquerade as "healthy" (that shape is what let a 4-mind
  #     auth outage run 7h). FALSIFIABLE: fold 127 into the not-authdead case and the blind assert FAILs.
  _ad="$(mktemp -d)"
  printf '#!/bin/sh\nexit 9\n' > "$_ad/ms9";  chmod +x "$_ad/ms9"
  printf '#!/bin/sh\nexit 0\n' > "$_ad/ms0";  chmod +x "$_ad/ms0"
  MESH_MINDSTATE_CMD="$_ad/ms9" pane_authdead zzwin; [ "$?" = 0 ] || { echo "  FAIL: classifier rc 9 must read AUTH-DEAD"; af=1; }
  MESH_MINDSTATE_CMD="$_ad/ms0" pane_authdead zzwin; [ "$?" = 1 ] || { echo "  FAIL: classifier rc 0 (IDLE/WORKING) must NOT be treated as AUTH-DEAD"; af=1; }
  MESH_MINDSTATE_CMD="$_ad/nope-does-not-exist" pane_authdead zzwin; [ "$?" = 2 ] || { echo "  FAIL: an absent classifier must read BLIND (2), never 'not AUTH-DEAD'"; af=1; }
  # present-but-unrunnable (rc 127) and HUNG (rc 124) are the two blind reads a `command -v` guard
  # cannot see — the whisper 'executable and loadable are different claims' shape. Both must be BLIND.
  printf '#!/nonexistent/interp\nexit 0\n' > "$_ad/msbroken"; chmod +x "$_ad/msbroken"
  MESH_MINDSTATE_CMD="$_ad/msbroken" pane_authdead zzwin; [ "$?" = 2 ] || { echo "  FAIL: an installed-but-unrunnable classifier (rc 127) must read BLIND (2), never 'not AUTH-DEAD'"; af=1; }
  printf '#!/bin/sh\nsleep 30\n' > "$_ad/mshang"; chmod +x "$_ad/mshang"
  _aold="$AUTH_STATE_TIMEOUT"; AUTH_STATE_TIMEOUT=1   # env-prefixing a bash FUNCTION leaks the assignment past the call, so set+restore explicitly
  MESH_MINDSTATE_CMD="$_ad/mshang" pane_authdead zzwin; [ "$?" = 2 ] || { echo "  FAIL: a HUNG classifier (timeout, rc 124) must read BLIND (2), never 'not AUTH-DEAD'"; af=1; }
  AUTH_STATE_TIMEOUT="$_aold"
  rm -rf "$_ad"
  # (3b) the OTHER end of the same contract: the DEPLOYED mesh-mind-state must still speak these exit
  #      codes through the very call path pane_authdead uses. Asserted on ABSENT (rc 7) — a window that
  #      cannot exist — because it needs no pane and still proves the numeric contract is live, not
  #      merely documented. Skipped (not failed) where the classifier isn't deployed: honest n/a.
  if command -v mesh-mind-state >/dev/null 2>&1; then
    timeout 25 mesh-mind-state "zz-no-such-window-$$" >/dev/null 2>&1; _msrc=$?
    # rc 124 is the TIMEOUT — the deployed classifier HUNG, which is a node condition (load, a wedged
    # tmux), not a contract that drifted. Arm (3) directly above asserts a hung classifier must read
    # BLIND, so scoring the same hang as a code FAIL here contradicts this tool's own doctrine — and a
    # FAIL is what mesh-fitness and mesh-land revert an innocent commit on.
    case "$_msrc" in
      7)   ;;
      124) echo "  n/a: deployed mesh-mind-state timed out (rc 124) — its exit-code contract was NOT verified this run (a node condition, never a code verdict)";;
      *)   echo "  FAIL: deployed mesh-mind-state no longer exits 7 for an absent window (rc=$_msrc) — its exit-code contract (9=AUTH-DEAD) is what this arm routes on"; af=1;;
    esac
  fi
  # (4) THE CURE ITSELF, DRIVEN END-TO-END — not grepped for. A real throwaway tmux pane holds a fake
  #     "engine" (a binary named `node`, one of the COMMs shed_mind kills), standing in for the wedged
  #     403 process that mind_alive() calls healthy forever. authdead_heal must KILL it, WAIT for it to
  #     go, and then relaunch INTO the settled shell. FALSIFIABLE two ways: drop the kill and the wait
  #     times out → rc 1, no PROBE; drop the wait and relaunch() sees a live non-shell occupant and
  #     refuses to type → no PROBE. This is the whole measured fix (kill → existing relaunch), asserted
  #     as an artifact in a pane, not as the presence of a line of source.
  #     The fixture engine dies SLOWLY on purpose (a TERM trap that takes ~2s, like a real claude
  #     finishing its shutdown): an instantly-dying stand-in would let a wait-less mutant pass, which
  #     would make the wait an untested line — the "gate you have not seen FAIL" trap.
  # A FIXTURE PRECONDITION IS NOT A CODE VERDICT (route-orphan/mesh-channel-keepalive-374486).
  # This fixture used a FIXED `sleep 0.8` to wait for its OWN stand-in engine to start. That sleep is
  # a node sensor, not a test: on a loaded node the engine is not up yet, mind_alive() reads false,
  # and the arm below printed `smoke-test: FAIL (AUTH-DEAD arm drifted)` with exit 1 — which
  # mesh-fitness and mesh-land both read as a CODE verdict, so a healthy commit gets reverted. That is
  # the SAME failure the absence-is-n/a fix ~40 lines below was written to stop, arriving through the
  # fixture door instead of the no-session door. Reproduced 2026-08-21 by delaying ONLY the fixture's
  # own engine by 3s with the source under test untouched: rc=1, "AUTH-DEAD arm drifted".
  # The fix is not "sleep longer" (that is the same sensor with a bigger constant): the wait is now a
  # BOUNDED POLL, so the n/a is rare, and its exhaustion renders a LOUD n/a naming that the cure gate
  # did NOT run. Everything DOWNSTREAM of the precondition keeps FAIL — exit 4 (authdead_heal never
  # reached the relaunch) and a missing AUTHPROBE are the two mutants this whole fixture exists for,
  # and neither is reachable until the precondition has held.
  # rc contract: 0 = cure proven · 1 = cure BROKEN (a real code verdict) · 2 = n/a (node/fixture).
  _ka_authheal_verdict(){ case "$1" in 0) echo ok;; 3) echo na;; *) echo fail;; esac; }
  _ka_authheal_fixture(){   # $1 = seconds to stall the fixture's OWN engine (gate-test knob only)
    local _stall="${1:-0}" _poll="${_KA_AUTHHEAL_POLL:-40}" _ht _hsock _hrc _hpane _w _pre
    # Socket name: the PRIMARY drive must keep the exact `ka-auth-<pid>` form the LEAK GATE below
    # polls for ("-L ka-auth-$_lkpid " — with the trailing space), or that gate silently degrades to
    # "never caught the child's fixture socket". Only the gate-test drive takes a suffix.
    _ht=$(mktemp -d); _hsock="ka-auth-$$"; [ "$_stall" = 0 ] || _hsock="ka-auth-$$-s${_stall}"
    _KA_SOCKS="$_KA_SOCKS $_hsock"; _KA_TMPS="$_KA_TMPS $_ht"   # leak guard: reaped by _ka_reap on ANY exit
    # …EXCEPT that registration is INVISIBLE to the reaper on the gate-test drive, because that drive
    # runs this function inside a command substitution — a SUBSHELL — so the assignment above dies with
    # it and the parent's EXIT trap has never heard of `$_hsock`. Measured on mesh-home 2026-08-28:
    # three 0-byte `ka-auth-<pid>-s3` sockets (13:50, 16:23, 17:23), servers already gone, and ZERO
    # unsuffixed ones — i.e. the leak is exactly the subshell-driven arm and nothing else, which is
    # what makes the diagnosis a measurement rather than a reading of the code. So the fixture unlinks
    # its OWN socket on every path it can leave by; the parent registration stays as the outer net for
    # an abort that kills the subshell before it reaches any of them.
    _ka_fixture_teardown(){         # $1 = tmpdir  $2 = socket name. Idempotent; never fails loudly.
      [ -n "${1:-}" ] && pkill -f "$1/node" 2>/dev/null
      [ -n "${2:-}" ] && { command tmux -L "$2" kill-server 2>/dev/null; rm -f "$(_ka_sockfile "$2")" 2>/dev/null; }
      [ -n "${1:-}" ] && rm -rf "$1" 2>/dev/null
      return 0
    }
    cp /bin/bash "$_ht/node" 2>/dev/null || {
      echo "  n/a: no /bin/bash to stand in for a wedged engine — the kill→relaunch cure gate did NOT run"; _ka_fixture_teardown "$_ht" "$_hsock"; return 2; }
    printf 'trap %s TERM\nwhile :; do sleep 0.2; done\n' "'sleep 2; exit 0'" > "$_ht/eng.sh"
    tmux -L "$_hsock" new-session -d -s t -x 80 -y 24 2>/dev/null || {
      echo "  skip: tmux unavailable for the authdead-heal fixture"; _ka_fixture_teardown "$_ht" "$_hsock"; return 2; }
    tmux -L "$_hsock" send-keys -t t:0.0 "export PS1='> '" C-m 2>/dev/null; sleep 0.3
    _pre=""; [ "$_stall" = 0 ] || _pre="sleep $_stall; "
    tmux -L "$_hsock" send-keys -t t:0.0 "${_pre}$_ht/node $_ht/eng.sh" C-m 2>/dev/null
    ( LOG="$_ht/heal.log"; RELAUNCH_ACC=""
      tmux(){ command tmux -L "$_hsock" "$@"; }
      _w=0; until mind_alive "t:0.0"; do _w=$((_w+1)); [ "$_w" -ge "$_poll" ] && exit 3; sleep 0.25; done
      authdead_heal "t:0.0" 'echo "AUTHPROBE=[healed]"' || { echo "  FAIL: authdead_heal did not reach the relaunch (engine outlived the kill)"; exit 4; }
    ); _hrc=$?
    case "$(_ka_authheal_verdict "$_hrc")" in
      na)   echo "  n/a: the fixture's own stand-in engine never came up within ${_poll} polls x 0.25s — the kill→relaunch cure gate did NOT run (a node condition, never a code verdict)"
            _ka_fixture_teardown "$_ht" "$_hsock"; return 2;;
      fail) _ka_fixture_teardown "$_ht" "$_hsock"; return 1;;
    esac
    # The PROBE is POLLED, not slept-for — a fixed `sleep 1.2` here is the very same node sensor one
    # door along. A bounded poll costs nothing on a fast node and still never sees the marker for the
    # drop-the-kill / drop-the-wait mutants, which never print it at all.
    _hrc=1; _w=0
    while [ "$_w" -lt "$_poll" ]; do
      _hpane="$(tmux -L "$_hsock" capture-pane -p -t t:0.0 2>/dev/null)"
      case "$_hpane" in *"AUTHPROBE=[healed]"*) _hrc=0; break;; esac
      _w=$((_w+1)); sleep 0.25
    done
    [ "$_hrc" = 0 ] || echo "  FAIL: pane never ran the relaunch after the kill — the AUTH-DEAD cure does not actually heal"
    _ka_fixture_teardown "$_ht" "$_hsock"
    return "$_hrc"
  }
  # the routing decision itself, asserted (falsifiable: fold 3 into the default arm and the na leg reds)
  [ "$(_ka_authheal_verdict 0)" = ok   ] || { echo "  FAIL: fixture rc 0 must read the cure PROVEN"; af=1; }
  [ "$(_ka_authheal_verdict 3)" = na   ] || { echo "  FAIL: an unmet fixture PRECONDITION must read n/a — mesh-fitness and mesh-land read FAIL as a code verdict"; af=1; }
  [ "$(_ka_authheal_verdict 4)" = fail ] || { echo "  FAIL: a cure that never reached the relaunch must still read FAIL"; af=1; }
  _ka_authheal_fixture 0; hf=$?
  [ "$hf" = 1 ] && af=1
  # GATE-TEST, DRIVEN — not grepped for. Stall ONLY the fixture's own engine past the poll window and
  # assert the arm renders n/a and emits NO FAIL vocabulary. The poll ceiling is cut to 2 (0.5s) for
  # this drive so the gate costs ~3s instead of ~13. This is the exact shape reproduced above; before
  # the fix it printed "smoke-test: FAIL (AUTH-DEAD arm drifted)" against a healthy tree.
  # `$$` is the SHELL's pid and a subshell does not change it, so the parent can name the socket that
  # drive is about to mint. Registering it HERE is the outer net: if the substitution is killed before
  # the fixture reaches any teardown, the parent's EXIT trap still owns the name.
  _gtsock="ka-auth-$$-s3"; _KA_SOCKS="$_KA_SOCKS $_gtsock"
  _gto="$(_KA_AUTHHEAL_POLL=2 _ka_authheal_fixture 3 2>&1)"; _gtrc=$?
  [ "$_gtrc" = 2 ] || { echo "  FAIL: a stalled fixture engine must render n/a (rc 2), got rc=$_gtrc — a node condition would veto a healthy commit again"; af=1; }
  # LEAK ARM (2026-08-28). Asserted on the SUBSHELL-driven arm specifically, because that is the only
  # one whose `_KA_SOCKS` registration cannot reach the reaper — the unsuffixed drive above was always
  # covered and would pass this arm even with the fix removed. Falsify by deleting the `rm -f` from
  # _ka_fixture_teardown: the file survives the drive and this reds (the parent trap still tidies it at
  # exit, so the leak is closed either way — but a gate that only the trap satisfies proves nothing).
  [ -e "$(_ka_sockfile "$_gtsock")" ] && { echo "  FAIL: the gate-test fixture left its socket file $(_ka_sockfile "$_gtsock") behind — a fixture driven inside a command substitution cannot register with the parent's reaper, so it must unlink its own"; af=1; }
  case "$_gto" in
    *"cure gate did NOT run"*) ;;
    *) echo "  FAIL: the n/a path must SAY the cure gate did not run (silent skip = a hollow gate), got '$_gto'"; af=1;;
  esac
  case "$_gto" in
    *FAIL*) echo "  FAIL: the fixture-precondition path must not use the FAIL vocabulary — mesh-fitness and mesh-land both read it as a code verdict"; af=1;;
  esac
  [ "$af" = 0 ] || { echo "smoke-test: FAIL (AUTH-DEAD arm drifted — a logged-out mind would go unhealed again)"; exit 1; }
  # The summary must not claim a leg that rendered n/a — a rollup restating a leg that never ran is
  # how a hollow gate reads green (see the `hf=2` arm above, which says so out loud on its own line).
  _cure="the kill→relaunch cure driven end-to-end in a real pane"
  [ "$hf" = 2 ] && _cure="cure fixture n/a on this node — NOT driven"
  echo "smoke-test: ok (AUTH-DEAD arm: debounce→cooldown→giveup precedence driven, burst coalesced, rc9→act / rc0→leave / absent+broken+hung→BLIND, and $_cure)"

  # ── STRANDED-COMPOSER SWEEP (chat-review/a-stranded-composer-outlives-every-ladder-that-would-
  # clear-it) ────────────────────────────────────────────────────────────────────────────────────
  sf2=0
  # (a) the SCHEDULE, as a pure decision. Precedence is the whole safety story: CHANGED outranks
  # everything, because a composer whose text is MOVING is a hand, and a hand must be un-sweepable
  # even when the streak beside it says giveup or cooldown.
  [ "$(strand_verdict 1000 0    ""   d1 0 0    600 900 3)" = ARMED ]    || { echo "  FAIL: strand — a first sighting must ARM the debounce"; sf2=1; }
  [ "$(strand_verdict 1000 100  d1   d2 9 999  600 900 3)" = CHANGED ]  || { echo "  FAIL: strand — CHANGED text must outrank GIVEUP and COOLDOWN (a hand is composing)"; sf2=1; }
  [ "$(strand_verdict 1000 100  d1   d1 3 0    600 900 3)" = GIVEUP ]   || { echo "  FAIL: strand — GIVEUP must outrank the cooldown/debounce ladder"; sf2=1; }
  [ "$(strand_verdict 1000 100  d1   d1 1 950  600 900 3)" = COOLDOWN ] || { echo "  FAIL: strand — a recent re-drive must serve its cooldown"; sf2=1; }
  [ "$(strand_verdict 1000 900  d1   d1 0 0    600 900 3)" = WAITING ]  || { echo "  FAIL: strand — an unchanged composer inside the debounce must WAIT"; sf2=1; }
  [ "$(strand_verdict 1000 100  d1   d1 0 0    600 900 3)" = REDRIVE ]  || { echo "  FAIL: strand — unchanged past the debounce, never re-driven, must REDRIVE"; sf2=1; }
  # last<=0 must NOT serve a cooldown. Falsify by dropping the guard: bare (now-last) makes this
  # branch a function of the ABSOLUTE clock — permanently true under a fixture epoch, unreachable
  # under a real one, i.e. a gate no test could pin.
  [ "$(strand_verdict 1000 100  d1   d1 0 0    600 5000 3)" = REDRIVE ] || { echo "  FAIL: strand — a window never re-driven has no cooldown to serve"; sf2=1; }

  # (b) ATTRIBUTION — the gate that decides whether anything is allowed to press a key. Driven over a
  # REAL WAL file in mesh-tell's own format, because the whole point is that this reads the SENDER's
  # record rather than guessing from the pane.
  _swd="$(mktemp -d)"; _swal="$_swd/wal.log"
  printf '%s\t1\tintent\twho\tlocal\tvpn\t%s\n' "$(date -u +%FT%TZ)" "$(printf 'take the 13:57Z third-table-52-build-pathway finding' | base64 -w0)" > "$_swal"
  _sa(){ MESH_TELL_WAL="$_swal" strand_attribution "$1" "$2"; }
  [ "$(_sa vpn '❯ take the 13:57Z third-table-52-build-pathway finding')" = STRANDED ] \
    || { echo "  FAIL: strand — held text matching a mesh-tell delivery for THIS window must attribute STRANDED"; sf2=1; }
  # the window is part of the key: another channel's delivery must not license a keypress here
  [ "$(_sa health '❯ take the 13:57Z third-table-52-build-pathway finding')" = HELD-OPERATOR ] \
    || { echo "  FAIL: strand — a delivery to a DIFFERENT window must not attribute this one"; sf2=1; }
  [ "$(_sa vpn '❯ i was in the middle of typing something else entirely')" = HELD-OPERATOR ] \
    || { echo "  FAIL: strand — text with no matching delivery must be HELD-OPERATOR (never touched)"; sf2=1; }
  # a REDACTED/thinned WAL can neither confirm nor deny — it must NOT read as "a human typed it"
  printf '%s\t1\tintent\twho\tlocal\tvpn\tr:deadbeef:42\n' "$(date -u +%FT%TZ)" > "$_swal"
  [ "$(_sa vpn '❯ take the 13:57Z third-table-52-build-pathway finding')" = UNATTRIBUTABLE ] \
    || { echo "  FAIL: strand — a thinned WAL must be UNATTRIBUTABLE, never folded into HELD-OPERATOR"; sf2=1; }
  # a WAL aged past the window is also unattributable, not a miss
  printf '%s\t1\tintent\twho\tlocal\tvpn\t%s\n' "$(date -u -d '@1' +%FT%TZ)" "$(printf 'take the 13:57Z third-table-52-build-pathway finding' | base64 -w0)" > "$_swal"
  [ "$(_sa vpn '❯ take the 13:57Z third-table-52-build-pathway finding')" = UNATTRIBUTABLE ] \
    || { echo "  FAIL: strand — an intent older than the WAL window must not license a keypress"; sf2=1; }
  # SHORT text is not an attribution: 'ok' would collide with half the log, and a false STRANDED is
  # the ONLY branch that presses a key, so the floor must fail toward not acting.
  printf '%s\t1\tintent\twho\tlocal\tvpn\t%s\n' "$(date -u +%FT%TZ)" "$(printf 'ok' | base64 -w0)" > "$_swal"
  [ "$(_sa vpn '❯ ok')" = UNATTRIBUTABLE ] \
    || { echo "  FAIL: strand — a composer body below the min-chars floor must never attribute STRANDED"; sf2=1; }

  # (c) THE ARM END-TO-END, against a STUB predicate, asserting the LEDGER and the MARK — the two
  # durable artifacts. The stub stands in for mesh-tell --composer and reproduces its rc contract
  # (0 CLEAR · 3 HOLDS · 2 BLIND), so what is exercised is this arm's own reading of that contract.
  _sb="$_swd/bin"; mkdir -p "$_sb"
  printf '#!/bin/sh\nc="$(cat %s/rc 2>/dev/null || echo 3)"\nprintf "%%s\\t%%s\\n" "$(cat %s/word)" "$(cat %s/snap)"\nexit "$c"\n' "$_swd" "$_swd" "$_swd" > "$_sb/mesh-tell"
  chmod +x "$_sb/mesh-tell"
  echo 3 > "$_swd/rc"; echo HOLDS > "$_swd/word"; echo '❯ a prompt that never landed anywhere at all' > "$_swd/snap"
  STRAND_LOG="$_swd/sweep.log"; : > "$STRAND_LOG"
  _smark="$HOME/.mesh/.strand-strandtest$$"
  MESH_TELL_CMD="$_sb/mesh-tell" strand_sweep "strandtest$$" "nosuch:pane.0" >/dev/null 2>&1
  grep -q 'STRAND-ARMED' "$STRAND_LOG" || { echo "  FAIL: strand — a first HOLDS sighting must write STRAND-ARMED to the arm's OWN ledger"; sf2=1; }
  [ -s "$_smark" ] || { echo "  FAIL: strand — a first HOLDS sighting must persist a mark (without it every pass re-arms and nothing ever fires)"; sf2=1; }
  # a CLEAR read must drop the mark: a strand that ended leaves no streak behind
  echo 0 > "$_swd/rc"; echo CLEAR > "$_swd/word"
  MESH_TELL_CMD="$_sb/mesh-tell" strand_sweep "strandtest$$" "nosuch:pane.0" >/dev/null 2>&1
  [ -s "$_smark" ] && { echo "  FAIL: strand — a CLEAR composer must clear the streak"; sf2=1; }
  # BLIND must HOLD the streak, never clear it: an unreadable pane is not a strand that ended.
  echo 3 > "$_swd/rc"; echo HOLDS > "$_swd/word"
  MESH_TELL_CMD="$_sb/mesh-tell" strand_sweep "strandtest$$" "nosuch:pane.0" >/dev/null 2>&1
  echo 2 > "$_swd/rc"; echo BLIND > "$_swd/word"
  : > "$STRAND_LOG"
  MESH_TELL_CMD="$_sb/mesh-tell" strand_sweep "strandtest$$" "nosuch:pane.0" >/dev/null 2>&1
  [ -s "$_smark" ] || { echo "  FAIL: strand — a BLIND read must HOLD the streak, never clear it (one bad capture would launder every strand)"; sf2=1; }
  grep -q 'STRAND-BLIND' "$STRAND_LOG" || { echo "  FAIL: strand — a BLIND read must SAY so; a silent blind read is a clean sweep that never happened"; sf2=1; }
  # an ABSENT predicate DISARMS the arm and must announce it rather than read as a clean sweep.
  : > "$STRAND_LOG"; rm -f "$HOME/.mesh/.strand-blind.ts"
  MESH_TELL_CMD="mesh-tell-that-does-not-exist-$$" strand_sweep "strandtest$$" "nosuch:pane.0" >/dev/null 2>&1
  grep -q 'STRAND-BLIND: .*absent' "$STRAND_LOG" || { echo "  FAIL: strand — an absent mesh-tell must announce a DISARMED sweep, not pass quietly"; sf2=1; }
  # THE RUN ROW: a ledger of only positives is a numerator. Assert it is written even when the pass
  # held NOTHING — that is the row which separates "no window was stranded" from "the arm never ran",
  # and its `swept=` is the denominator every held= count is read against.
  : > "$STRAND_LOG"; STRAND_N_SWEPT=0; STRAND_N_HELD=0; STRAND_N_BLIND=0; STRAND_N_ACTED=0
  echo 0 > "$_swd/rc"; echo CLEAR > "$_swd/word"
  MESH_TELL_CMD="$_sb/mesh-tell" strand_sweep "strandtest$$" "nosuch:pane.0" >/dev/null 2>&1
  strand_flush
  grep -q 'RUN swept=1 held=0 blind=0 acted=0' "$STRAND_LOG" \
    || { echo "  FAIL: strand — a pass that held NOTHING must still write its RUN row with the swept DENOMINATOR (got: $(cat "$STRAND_LOG"))"; sf2=1; }
  : > "$STRAND_LOG"; STRAND_N_SWEPT=0; STRAND_N_HELD=0; STRAND_N_BLIND=0; STRAND_N_ACTED=0
  strand_flush
  grep -q 'RUN swept=0 ' "$STRAND_LOG" \
    || { echo "  FAIL: strand — a pass that reached NO channel must say swept=0, not stay silent (a lean node is a reading, not an absence)"; sf2=1; }
  rm -f "$HOME/.mesh/.strand-strandtest$$" 2>/dev/null
  rm -f "$_smark" "$HOME/.mesh/.strand-giveup-strandtest$$" "$HOME/.mesh/.strand-held-strandtest$$" "$HOME/.mesh/.strand-blind.ts" 2>/dev/null
  rm -rf "$_swd"
  unset STRAND_LOG
  [ "$sf2" = 0 ] || { echo "smoke-test: FAIL (stranded-composer sweep drifted — a prompt stranded in a composer would sit unswept again)"; exit 1; }
  echo "smoke-test: ok (stranded-composer sweep: CHANGED-outranks-giveup+cooldown/armed/waiting/cooldown/giveup/redrive + never-re-driven-has-no-cooldown + attribution STRANDED-only-for-THIS-window / HELD-OPERATOR-never-touched / thinned-WAL+aged-intent+short-body=UNATTRIBUTABLE + RUN row: written-when-nothing-held-with-its-swept-denominator/swept-0-is-a-reading-not-a-silence + ledger: armed-writes-a-mark / clear-drops-it / BLIND-holds-it-and-says-so / absent-predicate-announces-DISARMED)"

  # ABSENCE-IS-N/A (the fix at the top of this --test): a node with no session must render exit 2,
  # never FAIL — a FAIL here is read by the fitness reflex as a regression in whatever commit is under
  # test, and that is exactly how phaedra came to revert an innocent commit and jam the genome strand.
  # Driven behaviourally through a STUB tmux whose has-session always fails, so the assertion exercises
  # the real precondition in a real child process; a source grep would prove only that the text exists.
  _nad="$(mktemp -d)"
  printf '#!/bin/sh\ncase "$1" in has-session) exit 1;; *) exit 0;; esac\n' > "$_nad/tmux"
  chmod +x "$_nad/tmux"
  _nao="$(PATH="$_nad:$PATH" bash "$0" --test 2>&1 >/dev/null)"; _narc=$?
  rm -rf "$_nad"
  [ "$_narc" = 2 ] \
    || { echo "smoke-test: FAIL (absent session must exit 2 = honest n/a, got rc=$_narc — a FAIL here vetoes a healthy commit from a sick node)"; exit 1; }
  case "$_nao" in
    *"n/a (no tmux session"*) ;;
    *) echo "smoke-test: FAIL (absent session must SAY n/a and name the remedy on stderr, got '$_nao')"; exit 1;;
  esac
  case "$_nao" in
    *FAIL*) echo "smoke-test: FAIL (the n/a path must not use the FAIL vocabulary — mesh-fitness and mesh-land both read it as a code verdict)"; exit 1;;
  esac
  echo "smoke-test: ok (absence-is-n/a: no session ⇒ rc=2 + an n/a line naming mesh-restore, never FAIL — a node condition can no longer veto a commit)"

  # ── THE LEAK GATE: ASSERT THE FIXTURE SERVER DOES NOT OUTLIVE AN *ABORTED* RUN ─────────────────
  # A cleanup nobody asserts is the same class as a gate nobody saw fail. Asserting the HAPPY path
  # would assert nothing here: measured 2026-08-21, a clean run already leaked zero while 91 orphans
  # sat resident. The leak lives on the ABORT path, so that is the path this gate drives — a real
  # child --test, TERMed the moment its first fixture socket exists, then asked whether any server
  # carrying THAT CHILD'S pid survived it.
  # Attribution is by the child's own pid in the socket name ("ka-*-<pid>"), never by a name pattern:
  # a pattern would match this node's real session and concurrent runs of this very test.
  # Guarded against self-recursion: the child sees MESH_KA_LEAKTEST_CHILD=1 and skips this arm, so
  # the fan-out is one level, not unbounded.
  if [ "${MESH_KA_LEAKTEST_CHILD:-0}" != 1 ] && command -v tmux >/dev/null 2>&1; then
    _lk_alive() {   # is a live tmux server holding socket $1? argv is the oracle, as in the census.
      local _p _c
      for _p in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        [ -r "/proc/$_p/comm" ] || continue      # pid vanished mid-scan: a race, not a fault —
        _c="$(tr -d '\0' < "/proc/$_p/comm" 2>/dev/null)" || continue   # never let it reach stderr
        [ "$_c" = "tmux: server" ] || continue
        [ -r "/proc/$_p/cmdline" ] || continue
        tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null | grep -q -- "-L $1 " && return 0
      done
      return 1
    }
    MESH_KA_LEAKTEST_CHILD=1 bash "$0" --test >/dev/null 2>&1 &
    _lkpid=$!
    _lksock=""; _lkspin=0
    while [ "$_lkspin" -lt 400 ]; do          # ~60s ceiling; the ka-test fixture lands in the first few
      for _c in "ka-test-$_lkpid" "ka-auth-$_lkpid"; do
        _lk_alive "$_c" && { _lksock="$_c"; break; }
      done
      [ -n "$_lksock" ] && break
      kill -0 "$_lkpid" 2>/dev/null || break  # child finished before we ever caught a socket
      _lkspin=$((_lkspin+1)); sleep 0.15
    done
    if [ -n "$_lksock" ]; then
      kill -TERM "$_lkpid" 2>/dev/null        # exactly what `timeout`/mesh-doctor does to a slow --test
      wait "$_lkpid" 2>/dev/null
      sleep 0.6                               # the trap runs in the dying child, not in us
      if _lk_alive "$_lksock"; then
        # Do not strand what we proved leaked: reap this one socket by name, scoped to the child's pid.
        command tmux -L "$_lksock" kill-server 2>/dev/null
        echo "smoke-test: FAIL (a TERMed --test left its fixture tmux server $_lksock alive — the kill is a statement on the happy path, not a trap; this is the 367MB/91-orphan leak)"
        exit 1
      fi
      echo "smoke-test: ok (leak guard: a TERMed child --test left NO tmux server behind — socket $_lksock was raised, the parent was killed mid-fixture, and the trap reaped it)"
    else
      # Never green on an unrun gate: say which evidence is missing rather than wearing a pass.
      kill -TERM "$_lkpid" 2>/dev/null; wait "$_lkpid" 2>/dev/null
      echo "smoke-test: n/a (leak guard: never caught the child's fixture socket — gate NOT exercised this run)"
    fi
  fi

  # ── KEEP SET IS DERIVED, AND AN UNKEPT CHANNEL IS LOUD ────────────────────────────────────────
  # The failure this gate exists to catch has now happened TWICE (2026-07-20, 2026-08-29): the
  # keep-list is hand-written, the manifest grows, and the new channels get no reviver / no
  # auth-dead arm / no composer sweep while every ledger stays green because nothing names the
  # denominator. Driven BEHAVIOURALLY — the derive block is extracted from the live source between
  # its own markers and sourced with a stub keep(), so a mutation to the loop, the counters or the
  # loud branch goes red. A source grep would prove only that the text exists.
  kd=0
  _kdd="$(mktemp -d)"
  awk '/^# >>> KEEP-DERIVE BEGIN$/{f=1;next} /^# <<< KEEP-DERIVE END$/{f=0} f' "$src" > "$_kdd/derive.sh"
  [ -s "$_kdd/derive.sh" ] \
    || { echo "  FAIL: keep-derive — the derived keep block is GONE (or its markers are); a hand-written keep-list is exactly the drift that stranded job/adint/wake/hire"; kd=1; }
  # No top-level hand-written keep rows may survive: they are how the list drifts out of the manifest.
  _khand="$(grep -cE '^keep [a-z]' "$src" || true)"
  [ "${_khand:-0}" = 0 ] \
    || { echo "  FAIL: keep-derive — $_khand hand-written top-level keep row(s) are back; the set must come from MESH_MIND_CHANNELS, not from a list a human re-types"; kd=1; }
  if [ "$kd" = 0 ]; then
    cat > "$_kdd/drive.sh" <<'KDEOF'
set -uo pipefail
ts(){ echo TS; }
S=katest
KEPT=""
keep(){ KEPT="${KEPT:+$KEPT }$1:$2"; }
KDEOF
    mkdir -p "$_kdd/.mesh"   # the throttle mark's parent: without it the loud branch also emits a
                             # redirection error, and a stderr complaint that is not the arm's own
                             # would let a silenced branch look red for the wrong reason.
    printf 'LOG=%s\nHOME=%s\nCLAUDE_BIN=claudebin\n' "$_kdd/log" "$_kdd" >> "$_kdd/drive.sh"
    cat "$_kdd/derive.sh" >> "$_kdd/drive.sh"
    printf '\necho "KEPT=$KEPT"\necho "CENSUS declared=$KEEP_DECLARED tended=$KEEP_TENDED unmapped=$KEEP_UNMAPPED nothere=$KEEP_NOTHERE names=$KEEP_UNMAPPED_NAMES src=$KEEP_SRC"\n' >> "$_kdd/drive.sh"
    # ARM 1: a channel restore plants but this file has no class for must be TENDED=no, LOUD=yes,
    # and COUNTED — never silently absent, which is the whole defect.
    # env -i, not env -u: a mind pane exports the node's own MESH_*_CMD set from restore.env, so a
    # named-unset list leaves every OTHER channel pin live and the arm measures this node instead of
    # this code (it did, first run: witness came back as the live claude pin).
    _kenv="env -i PATH=/usr/bin:/bin"
    _ko="$($_kenv MESH_MIND_CHANNELS="genome witness tg-roz notachannel" MESH_CLAUDE_CMD=cc MESH_OPENCODE_CMD=oc bash "$_kdd/drive.sh" 2>&1)"
    case "$_ko" in
      *"KEPT=genome:cc witness:oc"*) ;;
      *) echo "  FAIL: keep-derive — the loop did not tend exactly the declared+mapped set (got: $_ko)"; kd=1;;
    esac
    case "$_ko" in
      *UNMAPPED*notachannel*) ;;
      *) echo "  FAIL: keep-derive — an unmapped declared channel passed SILENTLY; it must print a line naming itself (got: $_ko)"; kd=1;;
    esac
    case "$_ko" in
      *"declared=4 tended=2 unmapped=1"*) ;;
      *) echo "  FAIL: keep-derive — the pass census must carry declared/tended/unmapped so tended alone can never read as complete (got: $_ko)"; kd=1;;
    esac
    case "$_ko" in
      *"names=notachannel"*) ;;
      *) echo "  FAIL: keep-derive — the census must NAME the unmapped channel, not just count it (got: $_ko)"; kd=1;;
    esac
    grep -q 'KEEP-UNMAPPED notachannel' "$_kdd/log" 2>/dev/null \
      || { echo "  FAIL: keep-derive — the unmapped channel left no row in the durable log; a stdout-only complaint dies with the cron mail"; kd=1; }
    # ARM 2: same declaration, ROZ_CHAT_ID present -> tg-roz joins, via MESH_TGROZ_CMD (dash STRIPPED).
    # MESH_TG_ROZ_CMD is set to a poison value in the same run: if the name mapping ever grows an
    # underscore, keepalive relaunches a different command than restore planted and they fight.
    _ko2="$($_kenv ROZ_CHAT_ID=1 MESH_TG_ROZ_CMD=POISON MESH_TGROZ_CMD=rozcmd MESH_MIND_CHANNELS="genome tg-roz" MESH_CLAUDE_CMD=cc MESH_OPENCODE_CMD=oc bash "$_kdd/drive.sh" 2>&1)"
    case "$_ko2" in
      *"KEPT=genome:cc tg-roz:rozcmd"*) ;;
      *) echo "  FAIL: keep-derive — tg-roz chain wrong: it must read the dash-stripped per-channel pin, and be tended when its routing is configured (got: $_ko2)"; kd=1;;
    esac
    case "$_ko2" in
      *POISON*) echo "  FAIL: keep-derive — the underscored variant was read; restore strips the dash, so this launches a command restore never planted"; kd=1;;
      *) ;;
    esac
    # ARM 3: the chain FALLBACK order must reproduce restore's ${CHAN:-${CLASS:-default}} exactly —
    # per-channel pin wins, else the class default, else the discovered binary.
    _ko3="$($_kenv MESH_MIND_CHANNELS="genome health" MESH_CLAUDE_CMD=cc MESH_OPENCODE_CMD=oc bash "$_kdd/drive.sh" 2>&1)"
    case "$_ko3" in
      *"KEPT=genome:cc health:oc"*) ;;
      *) echo "  FAIL: keep-derive — class default chain broken (claude channels must fall to MESH_CLAUDE_CMD, opencode channels to MESH_OPENCODE_CMD) (got: $_ko3)"; kd=1;;
    esac
    _ko4="$($_kenv MESH_GENOME_CMD=pin MESH_MIND_CHANNELS="genome health" bash "$_kdd/drive.sh" 2>&1)"
    case "$_ko4" in
      *"KEPT=genome:pin health:opencode"*) ;;
      *) echo "  FAIL: keep-derive — with no class pin the chain must end at the discovered binary / bare opencode, and a per-channel pin must still win (got: $_ko4)"; kd=1;;
    esac
    # ARM 4: unset MESH_MIND_CHANNELS is the TEND-ALL default, not an empty set — a node that
    # declares no lean list must not silently stop being tended.
    _ko5="$($_kenv MESH_CLAUDE_CMD=cc MESH_OPENCODE_CMD=oc bash "$_kdd/drive.sh" 2>&1)"
    case "$_ko5" in
      *"src=manifest-default"*) ;;
      *) echo "  FAIL: keep-derive — an unset declaration must name its source as the manifest default (got: $_ko5)"; kd=1;;
    esac
    case "$_ko5" in
      *"tended=19"*) ;;
      *) echo "  FAIL: keep-derive — unset MESH_MIND_CHANNELS must tend the whole manifest (19 = 20 minus tg-roz, unconfigured here), not nothing (got: $_ko5)"; kd=1;;
    esac
  fi
  # ARM 4b: the PASS SUMMARY the cron log actually carries. Arms 1-4 drive the extracted block with
  # their own echo appended, so they can prove the counters are right and still say nothing about the
  # line a human or a watchdog reads — a mutant that blanked the real summary's miss column passed
  # them all. This arm reads that line in the source and requires it to interpolate every counter,
  # not merely to mention the words: a literal in place of a variable is exactly how a denominator
  # becomes decorative.
  # Anchored at line start so this arm cannot select ITSELF: unanchored, the first match in the file
  # is this very line, which carries no counters and fails the control — the self-source-grep trap,
  # here in its polarity-reversed form (a vacuous PASS one ring over, a standing FAIL here).
  _kpd="$(grep -n '^echo ' "$src" | grep 'pass done' | head -1)"
  [ -n "$_kpd" ] || { echo "  FAIL: keep-derive — the pass summary line is gone entirely; a pass that says nothing has no census at all"; kd=1; }
  for _kv in KEEP_SRC KEEP_DECLARED KEEP_TENDED KEEP_UNMAPPED KEEP_NOTHERE; do
    case "$_kpd" in
      *"\$$_kv"*) ;;
      *) echo "  FAIL: keep-derive — the pass summary no longer interpolates $_kv; the census a human reads must carry every column, or an unkept channel is invisible in the one place anyone looks"; kd=1;;
    esac
  done

  # ARM 5: the MIRROR itself — every channel mesh-restore plants must have an engine class here.
  # This is the cross-file check the 2026-07-20 comment promised and could not enforce. Driven
  # through the real loop (feed restore's own planted names in as the declaration and require zero
  # unmapped), never by grepping the case body: the first attempt did grep it, anchored at line
  # start, and silently missed every name that leads its own alternation. Absent sibling renders
  # n/a, never FAIL — a node fact must not veto a commit.
  _mrs=""
  for _c in "$(dirname "$src")/mesh-restore" "$HOME/.local/bin/mesh-restore"; do
    [ -r "$_c" ] && { _mrs="$_c"; break; }
  done
  if [ "$kd" = 0 ] && [ -n "$_mrs" ]; then
    _rnames="$(grep -oE '^[[:space:]]*ensure_uniform_channel[[:space:]]+[a-z0-9-]+' "$_mrs" | awk '{print $2}' | sort -u | tr '\n' ' ')"
    if [ -n "${_rnames// /}" ]; then
      _kom="$($_kenv MESH_MIND_CHANNELS="$_rnames" MESH_CLAUDE_CMD=cc MESH_OPENCODE_CMD=oc bash "$_kdd/drive.sh" 2>&1)"
      case "$_kom" in
        *"unmapped=0"*) ;;
        *) echo "  FAIL: keep-derive — mesh-restore plants channel(s) this keepalive has no engine class for (they would be planted, declared, and UNKEPT): $_kom"; kd=1;;
      esac
    else
      echo "  note: keep-derive — mesh-restore named no channels; the manifest-mirror arm is n/a"
    fi
  elif [ -z "$_mrs" ]; then
    echo "  note: keep-derive — no mesh-restore beside this file; the manifest-mirror arm is n/a on this node"
  fi
  rm -rf "$_kdd"
  [ "$kd" = 0 ] || { echo "smoke-test: FAIL (the keep set drifted back toward a hand-written list, or an unkept channel went quiet)"; exit 1; }
  echo "smoke-test: ok (keep set DERIVED from MESH_MIND_CHANNELS: no hand-written rows + unmapped channel is loud/counted/named/logged + tg-roz dash-stripped pin + chain fallback order + unset=tend-all + every restore-planted channel has a class)"
  exit 0
fi

keep(){ # $1=window $2=launch-cmd
  local n mp rlmark stick
  # LEAN-NODE allowlist (mirror mesh-restore): when MESH_MIND_CHANNELS (restore.env) is set, only the
  # listed channels are tended/relaunched here; the rest are left data-only. RAM-constrained nodes that
  # cannot host the full suite (phaedra 1.9Gi). Unset → tend all (default, unchanged).
  if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
    case " $MESH_MIND_CHANNELS " in *" $1 "*) :;; *) [ "${VERBOSE:-}" = 1 ] && echo "  $1: not in MESH_MIND_CHANNELS (lean node) — skip"; return 0;; esac
  fi
  local b2; b2="$(cmd_bin "$2")"   # real binary, skipping env-var prefix (OPENCODE_MODEL=… opencode)
  # LEAN-MCP mirror (restore parity, 2026-07-20): mesh-restore launches claude minds with
  # `--settings <lean file>` when MESH_MCP_LEAN=1 — a keepalive RELAUNCH that drops the flag
  # silently revives the mind with the FULL plugin-MCP set (the exact "relaunch silently drops
  # flags" failure the keep-list header warns about; the 2026-07-06 OOM's ~150-200MB
  # chrome-devtools chains ride back in on it). Same per-channel escape hatch as restore's
  # mcp_full_for_win: MESH_MCP_FULL_<CHAN>=1 (CHAN uppercased, '-'→'_').
  local lcmd="$2"
  if [ "${MESH_MCP_LEAN:-0}" = 1 ] && [ "$(basename "$b2")" = claude ] && [ -s "$HOME/.mesh/claude-lean-settings.json" ]; then
    local _fullvar _fullval
    _fullvar="MESH_MCP_FULL_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"
    eval "_fullval=\"\${$_fullvar:-0}\""
    if [ "$_fullval" != 1 ]; then
      case "$lcmd" in *--settings*) :;; *) lcmd="$lcmd --settings $HOME/.mesh/claude-lean-settings.json";; esac
    fi
  fi
  stick="$HOME/.mesh/.window-engine-$(printf '%s' "$1" | tr ':/.' '___')"  # operator's sticky engine for this window
  mind_present "$lcmd" || { [ "${VERBOSE:-}" = 1 ] && echo "  $1: mind '$b2' not on this node — remote-note channel, skip"; return 0; }
  mind_declared "$b2" || { [ "${VERBOSE:-}" = 1 ] && echo "  $1: '$b2' not declared in card (organ-only/decommissioned) — skip"; return 0; }
  n=$(tmux list-panes -t "$S:$1" 2>/dev/null | wc -l)
  [ "${n:-0}" -ge 2 ] || return 0   # not a 2-pane channel → skip (mesh-restore rebuilds structure)
  mp=$(tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
  rlmark="$HOME/.mesh/.rl-cooldown-$1"
  # PAUSED until the cooldown EXPIRY epoch stored in the mark (reset-aware, see rl_cooldown_secs).
  # Old marks stored shed-time (< now) → read as expiry they're already past → not paused → the mind
  # is re-evaluated and re-shed with a proper expiry. Self-healing on upgrade.
  if [ -f "$rlmark" ] && [ "$(date +%s)" -lt "$(cut -d'|' -f1 "$rlmark" 2>/dev/null || echo 0)" ]; then
    [ "${VERBOSE:-}" = 1 ] && echo "  $1: rate-limited — paused (cooldown active), skip"; return 0
  fi
  # AUTO-REVERT to claude when paid quota is back. A MARKED quota-fallback (.quota-fallback-$win, written
  # by the RL_FALLBACK branch below + by `mesh-quota --fallback`) on a window whose DECLARED engine is
  # claude must NOT pin forever — once the wall's cooldown expired (or it aged past the cap), drop the
  # quota state and shed the fallback so the dead branch relaunches the DECLARED claude. A genuine
  # operator engine switch carries NO marker and is never touched (sovereignty preserved).
  local qfmark="$HOME/.mesh/.quota-fallback-$1"
  if [ -f "$qfmark" ] && [ "$(basename "$b2")" = claude ]; then
    local cd_active=0
    [ -f "$rlmark" ] && [ "$(date +%s)" -lt "$(cut -d'|' -f1 "$rlmark" 2>/dev/null || echo 0)" ] && cd_active=1
    local qf_age=$(( $(date +%s) - $(stat -c %Y "$qfmark" 2>/dev/null || date +%s) ))
    if quota_should_revert "$cd_active" "$qf_age" "${MESH_QUOTA_REVERT_MAX:-7200}"; then
      rm -f "$qfmark" "$stick" "$rlmark" 2>/dev/null   # wall over → drop ALL quota state so we relaunch CLAUDE, not the fallback
      if mind_alive "$S:$1.$mp" && ! mind_process_matches_declared "$S:$1.$mp" "$b2"; then
        shed_mind "$S:$1.$mp"   # fallback engine live → kill it; pane drops to shell, next pass relaunches declared claude
        echo "$(ts) QUOTA-REVERT $1: paid quota back (cd_active=$cd_active age=${qf_age}s) → shed fallback, declared claude relaunches next pass" >> "$LOG"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[quota-resumed] $S:$1: paid quota back → reverting fallback → claude" >/dev/null 2>&1 || true
        return 0
      fi
      # else: claude already running, or pane already dead → fall through (dead branch relaunches declared claude)
    fi
  fi
  if mind_alive "$S:$1.$mp"; then
    # OPERATOR-SOVEREIGN ENGINE (operator 2026-06-20: "I want to switch the mind in a window to one I
    # want, and that's the mind kept there"). A LIVE, valid mind is NEVER force-reverted to the
    # window's declared default — whatever engine the operator launched stays. We just RECORD it as
    # this window's sticky engine so a future death revives THAT engine, not the hardcoded default.
    # This retires the auto-shed-on-mismatch, which twice killed a healthy operator-chosen mind
    # (claude: path-vs-basename bd06532; then agy in senses). Engine-drift correction is now manual:
    # to change a window's engine, the operator just launches the engine they want in its pane.
    if ! mind_process_matches_declared "$S:$1.$mp" "$b2"; then
      # Operator switched this window to a NON-declared engine → record it (sticky) so a future death
      # revives the operator's choice, and log it. Do NOT shed: the live mind is sovereign.
      local livecmd; livecmd="$(running_launch_cmd "$S:$1.$mp" "$lcmd")"
      # Do NOT record a quota-fallback as a sovereign sticky (it would pin the free engine forever and
      # defeat auto-revert). Only a genuine, unmarked operator switch becomes sticky.
      [ -n "$livecmd" ] && [ ! -f "$qfmark" ] && printf '%s\n' "$livecmd" > "$stick" 2>/dev/null
      local running_comm; running_comm="$(tmux display -p -t "$S:$1.$mp" '#{pane_pid}' 2>/dev/null | xargs -I{} ps -o comm= --ppid {} 2>/dev/null | grep -E 'claude|opencode|gemini|agy|codex|node' | head -1)"
      echo "$(ts) OPERATOR-ENGINE $1: running '${running_comm:-?}' != declared '$b2' — keeping operator's choice (sticky '$livecmd'), NOT shedding" >> "$LOG"
    else
      rm -f "$stick" 2>/dev/null   # running the declared engine → no operator override; dead-revive uses declared cmd (full flags: native-pin + --permission-mode auto)
    fi
    if ratelimited "$S:$1.$mp"; then
      # NOTHING is typed into the pane on the decline path: the mind is ALIVE there, and a send-keys
      # into a live claude submits an empty prompt — a spent turn against the very quota we stood
      # down for. The SHED path below writes its marker only because the mind is already dead.
      shed_gate "$1" && return 0
      local secs src
      secs="$(tmux capture-pane -t "$S:$1.$mp" -p -S -15 2>/dev/null | rl_cooldown_secs)"
      if [ -n "$secs" ]; then src="banner-reset"; else secs="$RL_COOLDOWN"; src="default"; fi
      shed_mind "$S:$1.$mp"
      local qc=0
      [ -f "$rlmark" ] && qc=$(cut -s -d'|' -f2 "$rlmark" 2>/dev/null)
      qc=$(( ${qc:-0} + 1 ))
      local resume_epoch=$(( $(date +%s) + secs ))
      echo "${resume_epoch}|$qc" > "$rlmark"
      local resume_hm; resume_hm="$(resume_hm_fmt "$resume_epoch")"   # UTC+Z — matches board's UTC(Z) clock
      local note=""
      [ "$qc" -ge "$RL_FALLBACK_AFTER" ] && note=" (will try free-provider fallback next: $RL_FALLBACK)"
      echo "$(ts) SHED $1: rate-limit wall + spinning mind → killed, paused ${secs}s ($src), shed #${qc}, resumes ${resume_hm:-?}$note" >> "$LOG"
      # SHED-VISIBLE (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): a shed pane sits on
      # its surviving shell wrapper looking DEAD — indistinguishable at a glance (or to a pane-text-only
      # reader) from a real hang. Write a plain marker INTO the pane so a human glancing at it, or
      # mesh-mind-state's DEAD-SHELL classifier, sees why without needing the board/log. Best-effort:
      # a BARE-rooted pane (shed_recoverability=BARE, no surviving shell) has nowhere to write this —
      # failures here are silent, never fatal to the shed itself. `sleep 1` lets the wrapper shell
      # actually regain the foreground after the kill before we type into it (same settle pattern
      # mesh-tell/mesh-mind-state's auto-recover already use around a send-keys).
      if [ -n "$resume_hm" ]; then
        sleep 1
        tmux send-keys -t "$S:$1.$mp" "echo '--- SHED until ${resume_hm} (rate-limit wall, shed #${qc}) ---'" C-m 2>/dev/null || true
      fi
      # chat-review/quota-wave-caller-inverted: quota_wave returns 1=suppress / 0=post-normally
      # (see its own contract comment above). A stray '!' here inverted the polarity — posted
      # [mind-paused] exactly when quota_wave said suppress, and suppressed it when quota_wave said
      # post normally. No '!': call quota_wave for its side-effect (arms the cooldown mark / posts
      # the consolidated [quota-wave] line on threshold-cross) and post [mind-paused] only when it
      # returns 0 (post normally, i.e. below threshold / no active cooldown).
      if quota_wave "$1"; then
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-paused] $S:$1 hit a rate-limit wall — shed + paused ${secs}s ($src), shed #${qc}, auto-resumes ~${resume_hm:-?}$note" >/dev/null 2>&1
      fi
      return 0
    fi
    # AUTH-DEAD arm (contract + why: the block above keep()). Reached only when the mind is ALIVE and
    # NOT walled — i.e. exactly the gap both other paths leave open. Checked here, after ratelimited(),
    # so a walled mind still sheds on the tested path and never takes this branch.
    local amark="$HOME/.mesh/.authdead-$1" aseen="$HOME/.mesh/.authdead-seen-$1" agive="$HOME/.mesh/.authdead-giveup-$1"
    pane_authdead "$1"; local par=$?
    if [ "$par" = 2 ]; then
      # BLIND, not fine (silent-fallback doctrine): say it, rate-limited, and leave the pane alone.
      local bs="$HOME/.mesh/.authdead-blind.ts"
      if [ ! -f "$bs" ] || [ "$(( $(date +%s) - $(cat "$bs" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
        date +%s > "$bs"
        echo "$(ts) AUTH-BLIND $1: '${MESH_MINDSTATE_CMD:-mesh-mind-state}' absent/failed — the AUTH-DEAD arm is DISARMED this pass (a logged-out mind here would sit unhealed)" >> "$LOG"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[channel-odd] $S: mesh-mind-state unavailable → channel-keepalive's AUTH-DEAD arm is disarmed (logged-out minds would go unhealed)" >/dev/null 2>&1 || true
      fi
    elif [ "$par" = 0 ]; then
      # a fresh AUTH-DEAD sighting breaks any pending clear-candidate: a window that flips back
      # before it has held health for AUTH_PERSIST has not proved anything, and must not be able to
      # launder its streak through the one quiet reading in between.
      rm -f "$HOME/.mesh/.authdead-ok-$1" 2>/dev/null
      local a_last a_cnt a_seen v
      a_last="$(cut -d'|' -f1 "$amark" 2>/dev/null)"; a_cnt="$(cut -s -d'|' -f2 "$amark" 2>/dev/null)"
      a_seen="$(cat "$aseen" 2>/dev/null)"
      v="$(authdead_verdict "$(date +%s)" "${a_seen:-0}" "${a_last:-0}" "${a_cnt:-0}" "$AUTH_COOLDOWN" "$AUTH_GIVEUP" "$AUTH_PERSIST")"
      case "$v" in
        PENDING)
          date +%s > "$aseen"
          echo "$(ts) AUTH-DEAD $1: logged out (live process) — armed the ${AUTH_PERSIST}s debounce, acting next pass if it persists" >> "$LOG" ;;
        WAIT)
          echo "$(ts) AUTH-DEAD $1: logged out, debounce not yet elapsed ($(( $(date +%s) - ${a_seen:-0} ))s of ${AUTH_PERSIST}s)" >> "$LOG" ;;
        COOLDOWN)
          echo "$(ts) AUTH-DEAD $1: still logged out, but the last auth-relaunch (#${a_cnt:-0}) was <${AUTH_COOLDOWN}s ago — holding (anti-storm)" >> "$LOG" ;;
        GIVEUP)
          echo "$(ts) AUTH-DEAD $1: ${a_cnt:-0} auth-relaunches did NOT restore auth — STOP relaunching, this needs a human /login" >> "$LOG"
          if [ ! -f "$agive" ] || [ "$(( $(date +%s) - $(cat "$agive" 2>/dev/null || echo 0) ))" -gt "$AUTH_GIVEUP_REPOST" ]; then
            date +%s > "$agive"
            command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-authdead] $S:$1 is AUTH-DEAD and ${a_cnt:-0} relaunches did NOT restore auth — the credential looks genuinely revoked, this needs a human \`/login\` in that pane (keepalive has stopped retrying)" >/dev/null 2>&1 || true
          fi ;;
        RELAUNCH)
          a_cnt=$(( ${a_cnt:-0} + 1 ))
          printf '%s|%s\n' "$(date +%s)" "$a_cnt" > "$amark"
          rm -f "$aseen" 2>/dev/null
          echo "$(ts) AUTH-DEAD $1: logged out with a LIVE process → kill + relaunch (auth-relaunch #${a_cnt})" >> "$LOG"
          local acmd; acmd="$(sticky_cmd_for_declared "$lcmd" "$stick")"
          authdead_heal "$S:$1.$mp" "$(opencode_autoflag "$acmd")" \
            || echo "$(ts) AUTH-DEAD $1: engine still alive 5s after the kill — leaving the relaunch to the next pass (dead branch)" >> "$LOG"
          AUTHDEAD_ACC="${AUTHDEAD_ACC:-}${1}|${a_cnt}
" ;;
      esac
      return 0
    else
      # NOT AUTH-DEAD — which is not yet proof the relaunch worked (see (4) in the arm's header).
      # Two ways to earn the clear, and a bare IDLE is neither:
      #   WORKING   — positive proof. A pane cannot be mid-turn on a revoked credential; it 403s.
      #   SUSTAINED — not-AUTH-DEAD held for AUTH_PERSIST, i.e. >=1 further pass at this cadence.
      # Everything else HOLDS the streak, and the hold says so in the log so a human reading it can
      # see the difference between "healed" and "has not been asked anything yet".
      local aok="$HOME/.mesh/.authdead-ok-$1" ok_since now_s have cv
      have=0; { [ -e "$amark" ] || [ -e "$aseen" ] || [ -e "$agive" ]; } && have=1
      now_s="$(date +%s)"
      ok_since="$(cat "$aok" 2>/dev/null)"; case "$ok_since" in ''|*[!0-9]*) ok_since=0 ;; esac
      cv="$(authdead_clear_verdict "$have" "${PANE_STATE:-}" "$now_s" "$ok_since" "$AUTH_PERSIST")"
      case "$cv" in
        NOSTREAK)
          rm -f "$aok" 2>/dev/null ;;   # nothing to clear — and never leave a candidate aging alone
        CLEAR-WORKING)
          echo "$(ts) AUTH-CLEARED $1: a WORKING turn was observed — the credential authenticates; clearing the AUTH-DEAD streak (auth-relaunch count was $(cut -s -d'|' -f2 "$amark" 2>/dev/null))" >> "$LOG"
          rm -f "$amark" "$aseen" "$agive" "$aok" 2>/dev/null ;;
        CLEAR-SUSTAINED)
          echo "$(ts) AUTH-CLEARED $1: not AUTH-DEAD for $(( now_s - ok_since ))s (>= ${AUTH_PERSIST}s sustained) — clearing the AUTH-DEAD streak (auth-relaunch count was $(cut -s -d'|' -f2 "$amark" 2>/dev/null))" >> "$LOG"
          rm -f "$amark" "$aseen" "$agive" "$aok" 2>/dev/null ;;
        ARM)
          printf '%s\n' "$now_s" > "$aok"
          echo "$(ts) AUTH-HOLD $1: not AUTH-DEAD (state=${PANE_STATE:-<none>}) but a just-relaunched pane reads the same as a healed one — holding the streak until ${AUTH_PERSIST}s of sustained proof or a WORKING turn" >> "$LOG" ;;
        HOLD)
          echo "$(ts) AUTH-HOLD $1: not AUTH-DEAD for only $(( now_s - ok_since ))s of ${AUTH_PERSIST}s — the streak stands" >> "$LOG" ;;
      esac
    fi
    # STRANDED-COMPOSER sweep (see the arm above keep()). Last of the alive-branch arms: a walled or
    # logged-out mind cannot submit anything, so those two must have had their say first.
    strand_sweep "$1" "$S:$1.$mp"
    rm -f "$rlmark" 2>/dev/null   # alive + working → clear any stale cooldown
    [ "${VERBOSE:-}" = 1 ] && echo "  $1: mind alive"
  else
    # quota-adaptive relaunch: if the last shed was due to quota exhaustion and has repeated >=
    # RL_FALLBACK_AFTER times, fall back to a free/cheap provider instead of relaunching the same
    # dying mind that will just hit the quota wall again.
    # revive the OPERATOR'S last-seen engine (sticky) if recorded, else the window's declared default.
    local cmd qc=0
    cmd="$(sticky_cmd_for_declared "$lcmd" "$stick")"
    if [ -f "$rlmark" ]; then
      qc=$(cut -s -d'|' -f2 "$rlmark" 2>/dev/null)
      qc=${qc:-0}
    fi
    if [ "$qc" -ge "$RL_FALLBACK_AFTER" ] && command -v "$(cmd_bin "$RL_FALLBACK")" >/dev/null 2>&1; then
      cmd="$RL_FALLBACK"
      touch "$HOME/.mesh/.quota-fallback-$1" 2>/dev/null   # MARK: auto quota-fallback → auto-revert to claude on reset (revert block above)
      echo "$(ts) FALLBACK $1: quota-exhausted ${qc}x → switching to free provider: $cmd" >> "$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-fallback] $S:$1 quota-exhausted ${qc}x → switched to free provider: $cmd" >/dev/null 2>&1
    fi
    cmd="$(opencode_autoflag "$cmd")"   # applies to declared default, sticky revival, AND $RL_FALLBACK uniformly
    relaunch "$S:$1.$mp" "$cmd"; echo "  $1: was DEAD → relaunch attempted ($cmd)"
  fi
}
# 2026-06-13: windows are data-channels (plan/health/verify/work), minds distributed to bottoms.
# MINIMAL 6-CHANNEL SET (operator 2026-06-17). Engine + launch-CMD MUST match mesh-restore's manifest
# EXACTLY (same ${VAR:-${VAR:-default}} chains), or restore launches one command and keepalive relaunches
# another → they fight, and a relaunch silently drops flags. In particular the claude channels fall
# through to MESH_CLAUDE_CMD so a keepalive RELAUNCH keeps both `--permission-mode auto` AND the native-
# binary pin (restore.env) — bare 'claude' here used to drop both. claude on minds/genome/tg; free
# opencode on senses/health/chat.
# INSTANCE LOCK (chat-review/quota-wave-suppress-race): the keepalive pass appends to WAVE_FILE,
# rewrites it, and arms/checks the cooldown mark — concurrent passes (a rate-limit cascade firing
# overlapping cron ticks) raced the check-then-set and leaked [mind-paused] posts past active
# suppression. Non-blocking flock: if another pass holds the lock, exit 0 (next cron tick tends it)
# rather than queueing/serializing long. --test is exempt (it exits above, before this point), so
# verify rotations never block on a live pass.
exec 200>"$HOME/.mesh/.channel-keepalive.lock"
flock -n 200 || { [ "${VERBOSE:-}" = 1 ] && echo "  another keepalive pass in progress — skip"; exit 0; }
# ---------------------------------------------------------------------------
# THE KEEP SET IS DERIVED, NOT HAND-WRITTEN (2026-08-29, task:mesh-channel-keepalive).
# History, because this is the SECOND time: on 2026-07-20 the hand-written keep-list had stopped at
# `pub` while mesh-restore's manifest had grown to 14 — discover/sound/models/vpn/bruno/tg-roz/
# witness/diary had NO reviver at all, and a dead mind there stayed dead until a human noticed. The
# remedy applied then was to add the missing lines BY HAND and write "Chains mirror mesh-restore's
# manifest EXACTLY" in a comment. A comment is not a mirror. By 2026-08-29 the manifest had grown by
# four more (job adint wake hire) and every one of them was again unkept — no reviver, no AUTH-DEAD
# arm, no stranded-composer sweep — while the list ALSO still named five windows this node does not
# plant (minds room models bruno diary), i.e. wrong in both directions at once. The composer-sweep
# ledger had been printing `swept=10` against 14 live mind windows the whole time: its own
# denominator recorded the gap and nobody read it as one.
# So ITERATION is now DERIVED from MESH_MIND_CHANNELS — the same string mesh-restore plants from —
# and the only thing left hand-written is the thing that cannot be derived from that string: which
# engine CLASS a channel runs (claude vs opencode). Adding a channel to restore.env can no longer
# leave it unkept. A declared channel with no class mapping is UNMAPPED and fails LOUD — stdout, the
# durable $LOG, a trace, a throttled board line, and its own counted column in the pass summary —
# because an unkept channel must never be indistinguishable from a channel that had nothing to do.
# The launch chain is REBUILT from the class rather than simplified away, so it still reproduces
# restore's ${MESH_<CHAN>_CMD:-${MESH_<CLASS>_CMD:-<default>}} order exactly: the header rule above
# (restore and keepalive must launch the SAME command, flags included, or they fight) is unchanged.
# ---------------------------------------------------------------------------
# mesh-restore's full manifest, in its own order. Used ONLY when MESH_MIND_CHANNELS is unset — a node
# that declares no lean set is tended across everything restore can plant (the old default, unchanged).
# >>> KEEP-DERIVE BEGIN
MIND_CHANNELS_ALL="minds genome tg senses health room pub discover sound models vpn bruno witness diary tg-roz job adint hire haunt wake"
mind_engine_class(){ # $1=window -> claude|opencode ; EMPTY means UNMAPPED (loud, never silent)
  case "$1" in
    minds|genome|tg|room|pub|discover|sound|diary|job|adint|hire|haunt|wake) echo claude ;;
    senses|health|models|vpn|bruno|witness|tg-roz)                     echo opencode ;;
    *) echo "" ;;
  esac
}
mind_launch_cmd(){ # $1=window $2=class -> the exact chain mesh-restore uses for this channel
  local v val
  # tg-roz -> MESH_TGROZ_CMD: restore STRIPS the dash, it does not translate it to an underscore.
  # Map it to MESH_TG_ROZ_CMD and the per-channel pin silently stops being read — the channel then
  # falls back to the class default and keepalive relaunches a different command than restore did.
  v="MESH_$(printf '%s' "$1" | tr -d '-' | tr 'a-z' 'A-Z')_CMD"
  eval "val=\"\${$v:-}\""
  [ -n "$val" ] && { printf '%s' "$val"; return 0; }
  case "$2" in
    claude)   printf '%s' "${MESH_CLAUDE_CMD:-$CLAUDE_BIN}" ;;
    opencode) printf '%s' "${MESH_OPENCODE_CMD:-opencode}" ;;
  esac
}
# tg-roz exists only where Rozalia's routing is configured — same ROZ_CHAT_ID gate as mesh-restore.
ROZ_CHAT_ID="${ROZ_CHAT_ID:-$(grep -oE '^[[:space:]]*ROZ_CHAT_ID=[0-9]+' "$HOME/.mesh/nodes" 2>/dev/null | grep -oE '[0-9]+' | head -1)}"
KEEP_SRC=MESH_MIND_CHANNELS; [ -n "${MESH_MIND_CHANNELS:-}" ] || KEEP_SRC=manifest-default
KEEP_DECLARED=0; KEEP_TENDED=0; KEEP_UNMAPPED=0; KEEP_NOTHERE=0; KEEP_UNMAPPED_NAMES=""
for _w in ${MESH_MIND_CHANNELS:-$MIND_CHANNELS_ALL}; do
  KEEP_DECLARED=$(( KEEP_DECLARED + 1 ))
  _cls="$(mind_engine_class "$_w")"
  if [ -z "$_cls" ]; then
    KEEP_UNMAPPED=$(( KEEP_UNMAPPED + 1 ))
    KEEP_UNMAPPED_NAMES="${KEEP_UNMAPPED_NAMES:+$KEEP_UNMAPPED_NAMES,}$_w"
    echo "  $_w: UNMAPPED — declared in MESH_MIND_CHANNELS but this keepalive knows no engine class for it → NO reviver, NO auth-dead arm, NO composer sweep"
    echo "$(ts) KEEP-UNMAPPED $_w: declared in MESH_MIND_CHANNELS, absent from mind_engine_class() — a dead mind in that window stays dead" >> "$LOG"
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "channel-keepalive: UNMAPPED channel '$_w' — declared in MESH_MIND_CHANNELS, no engine class here → unkept" >/dev/null 2>&1 || true
    continue
  fi
  if [ "$_w" = tg-roz ] && [ -z "${ROZ_CHAT_ID:-}" ]; then
    KEEP_NOTHERE=$(( KEEP_NOTHERE + 1 ))
    [ "${VERBOSE:-}" = 1 ] && echo "  tg-roz: no ROZ_CHAT_ID on this node — restore does not plant it here, skip"
    continue
  fi
  KEEP_TENDED=$(( KEEP_TENDED + 1 ))
  keep "$_w" "$(mind_launch_cmd "$_w" "$_cls")"
done
if [ "$KEEP_UNMAPPED" -gt 0 ]; then
  _umts="$HOME/.mesh/.keep-unmapped.ts"
  if [ ! -f "$_umts" ] || [ "$(( $(date +%s) - $(cat "$_umts" 2>/dev/null || echo 0) ))" -gt 21600 ]; then
    date +%s > "$_umts"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[fyi] channel-keepalive: $KEEP_UNMAPPED channel(s) declared in MESH_MIND_CHANNELS have no engine class here ($KEEP_UNMAPPED_NAMES) — planted but UNKEPT: no reviver, no auth-dead arm, no composer sweep. Add them to mind_engine_class() in mesh-channel-keepalive." >/dev/null 2>&1 || true
  fi
fi
# <<< KEEP-DERIVE END
strand_flush           # the stranded-composer sweep's UNCONDITIONAL run row (its denominator)
flush_relaunch_posts   # ONE board line for a relaunch burst (N≥2), full-detail line for a single
flush_authdead_posts   # same coalescing for the AUTH-DEAD arm (a node-wide auth outage is N windows)
# KEEP-CENSUS in the pass summary: declared is what MESH_MIND_CHANNELS (or the manifest default)
# asked for, tended is what actually got a keep row, unmapped is the LOUD column. Printing tended
# alone would repeat the exact failure this fix closes — the composer sweep printed swept=10 for
# weeks against 14 declared channels and the missing four were invisible because nothing named the
# numerator's own denominator beside it.
echo "$(ts) channel-keepalive pass done (keep-census: src=$KEEP_SRC declared=$KEEP_DECLARED tended=$KEEP_TENDED unmapped=$KEEP_UNMAPPED${KEEP_UNMAPPED_NAMES:+ [$KEEP_UNMAPPED_NAMES]} not-planted-here=$KEEP_NOTHERE)"
