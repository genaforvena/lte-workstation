#!/usr/bin/env bash
# mesh-channel-keepalive — keep each CHANNEL's MIND (bottom pane) alive. mesh-mind-keepalive only tends
# the 'claude' window; channel minds (tg, and any 2-pane channel) died unwatched — the tg claude died
# once with nothing to relaunch it. This checks each channel's mind pane and relaunches its mind if no
# mind process is running under it (a robust process-tree check — pane_current_command can lie when the
# mind runs as node under a shell wrapper).
#   mesh-channel-keepalive          one pass: relaunch any dead channel mind
#   mesh-channel-keepalive --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# PATH-robust mind toolchain: opencode lives in ~/.opencode/bin, codex via nvm — without these the
# `command -v codex` guard below skips the work channel and mind_alive misreads. Mirror the launch env.
for d in "$HOME/.opencode/bin" "$HOME/.bun/bin"; do [ -d "$d" ] && case ":$PATH:" in *":$d:"*) :;; *) PATH="$d:$PATH";; esac; done
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use node >/dev/null 2>&1 || true
# typed-into-the-pane prefix so a relaunched mind resolves regardless of the pane shell's login PATH
MIND_PATH_PREFIX='export PATH="$HOME/.opencode/bin:$HOME/.bun/bin:$HOME/.local/bin:$PATH"; [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1; '
S="$(hostname)"; LOG="$HOME/.mesh/channel-keepalive.log"; ts(){ date -u +%FT%TZ; }
# The CARD is the declared truth for whether this node runs minds (mirror mesh-mind-keepalive +
# mesh-restore, which both gate on it). A node whose card has a `minds:` line that does NOT list an
# engine is organ-only/decommissioned → do NOT relaunch that engine's channels here. This makes
# blanking the card a clean, fleet-reusable "minds off" switch (operator decommissioned ilya 2026-06-15).
# Fail-SAFE: no card / no `minds:` line → don't gate (preserve legacy behavior, never disable a healthy
# node's minds on a missing card — mesh-restore regenerates it).
CARD_MINDS_LINE="$(grep -E '^[[:space:]]*minds:' "$HOME/.mesh-card" 2>/dev/null || true)"
CARD_MINDS=" $(printf '%s' "$CARD_MINDS_LINE" | sed 's/^.*minds:[[:space:]]*//') "
mind_declared(){ # $1 = engine binary (claude/opencode/codex/gemini), possibly an ABSOLUTE path
  [ -n "${CARD_MINDS_LINE// }" ] || return 0     # no card/line → don't gate
  # compare by BASENAME — the card declares engine basenames ("claude opencode …"), but a launch cmd may
  # pin an absolute path (e.g. MESH_CLAUDE_CMD=~/.local/bin/claude to force the native binary); a literal
  # match would then fail and wrongly skip the channel as "not declared".
  local b; b="$(basename "$1")"
  case "$CARD_MINDS" in *" $b "*) return 0;; *) return 1;; esac
}
# Per-channel mind-cmd overrides (MESH_SENSE_CMD, MESH_NOVELTY_CMD, etc.) live in restore.env
# (node-local, gitignored) — source here so keepalive restarts use the same cmd as mesh-restore.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null
# NATIVE CLAUDE, ALWAYS (operator hard rule 2026-06-19) — MUST mirror mesh-restore's resolver so a
# keepalive RELAUNCH uses the same native ELF, never a bare-PATH npm shim. ELF magic = 0x7f 'E' 'L' 'F'.
CLAUDE_BIN=claude
for _c in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
  [ -x "$_c" ] || continue
  [ "$(od -An -tx1 -N4 "$_c" 2>/dev/null | tr -d ' ')" = 7f454c46 ] || continue
  CLAUDE_BIN="$_c"; break
done
# canonical wall regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14):
# source the shared MESH_RL_RE; inline fallback if not deployed. Replaces the private regex in
# ratelimited() that MISSED too many requests + overloaded (the shedder caught less than its siblings).
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
# --test runs further down, AFTER rl_cooldown_secs is defined, so it can dry-run the cooldown classifier.

# descendants — the FULL process subtree under $1. The mind is a GRANDCHILD: the launch wrapper is
# 'sh -c → bash -lc → claude', so direct-children-only checks miss it.
descendants(){ local p; for p in $(pgrep -P "$1" 2>/dev/null); do echo "$p"; descendants "$p"; done; }
# cmd_bin — the actual binary in a launch cmd, SKIPPING leading env assignments (VAR=val). Without this
# 'OPENCODE_MODEL=… opencode' → bin='OPENCODE_MODEL=…' → command -v fails → the channel is wrongly
# treated as "mind not on this node" and NEVER tended/relaunched (sense/novelty wake-up bug 2026-06-15).
cmd_bin(){ local tok; for tok in $1; do case "$tok" in *=*) continue;; *) printf '%s' "$tok"; return;; esac; done; }
# opencode auto-approve opt-in (DEFAULT OFF, mirrors mesh-agy's MESH_AGY_YOLO precedent). No launch
# path mesh-wide wired opencode's own auto-approve equivalent (`opencode --auto`, confirmed via
# `opencode --help`) — unlike claude (`--permission-mode auto`) and agy (`--dangerously-skip-
# permissions`), so ANY channel that resolves to opencode (declared, quota-fallback, or an
# operator-drifted sticky) freezes on a manual y/n gate for its FIRST tool call, unattended forever
# (chat-review/room-mind-opencode-engine-drift 2026-07-04 — room's pane drifted onto opencode via the
# quota-fallback/sticky path and froze exactly this way; tg misdiagnosed it as needing a bypass
# DECISION when the mesh already decided bypass mesh-wide, the launch path just never carried it for
# this engine). MESH_OPENCODE_YOLO=1 (node-local, restore.env, never the genome) appends --auto to
# any resolved cmd whose binary basename is opencode, applied once at the single relaunch choke point
# in keep() so every opencode-resolving path (declared default, RL_FALLBACK, operator sticky revival)
# gets it uniformly. OFF by default so the genome ships safe.
opencode_autoflag(){ # $1=launch cmd string -> cmd string, --auto appended iff basename=opencode and opted in
  local cmd="$1"
  [ "${MESH_OPENCODE_YOLO:-0}" = 1 ] || { printf '%s' "$cmd"; return; }
  case "$(basename "$(cmd_bin "$cmd")" 2>/dev/null)" in
    opencode) case " $cmd " in *" --auto "*) printf '%s' "$cmd" ;; *) printf '%s --auto' "$cmd" ;; esac ;;
    *) printf '%s' "$cmd" ;;
  esac
}
# quota_should_revert — pure decision: revert a MARKED quota-fallback back to claude?  $1=cooldown_active
# (0/1) $2=fallback_age_s $3=max_age_s. Revert (return 0) iff the wall's cooldown has EXPIRED (reset
# passed) OR the fallback aged past the cap (misparsed-reset guard that bounds worst-case downtime).
# FALSIFIABLE in --test. The bug it fixes: keepalive's OWN free-provider fallback got recorded as a
# sovereign sticky, so a paid window never returned to claude on reset (operator hand-restarted 2026-06-21).
quota_should_revert(){ [ "$1" = 0 ] && return 0; [ "$2" -ge "$3" ] && return 0; return 1; }
# a mind is ALIVE iff an ACTUAL mind PROCESS runs in the pane's subtree — matched by COMM (process
# name), NEVER by args. The wrapper 'sh -c bash -lc "…claude; exec bash -l"' keeps the literal string
# 'claude' in its args even AFTER claude exits, so an args-match reports a DEAD channel as alive forever
# → it is never relaunched (THE no-wake-up-after-reset bug, 2026-06-15). COMM of the wrapper is sh/bash
# (no match); COMM of a live mind is claude/opencode/codex/gemini (or node for a node-based engine).
mind_alive(){ # $1 = pane target (session:win.idx)
  local pp p; pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  [ -z "$pp" ] && return 1
  for p in "$pp" $(descendants "$pp"); do case "$(ps -o comm= -p "$p" 2>/dev/null)" in
    claude|codex|opencode|gemini|agy|node) return 0 ;; esac; done
  return 1
}
mind_process_matches_declared(){ # $1 = pane target, $2 = expected engine basename
  local pp p comm expected
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  [ -z "$pp" ] && return 1
  # Compare by BASENAME — a launch cmd may pin an absolute path (MESH_CLAUDE_CMD=~/.local/bin/claude
  # to force the native ELF), but a process COMM is always the basename ('claude'). A raw full-path
  # compare ('/home/.../claude' != 'claude') flags EVERY healthy claude-in-a-claude-window as a
  # mismatch → the auto-shed below then kills+relaunches a perfectly correct mind every cron cycle
  # (the "claude killed in random windows" bug, 2026-06-20). Same fix mind_declared() already carries.
  expected="$(basename "$2")"
  for p in "$pp" $(descendants "$pp"); do
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "$comm" in
      claude|codex|opencode|gemini|agy|node)
        if [ "$expected" = "claude" ] && [ "$comm" = "claude" ]; then return 0; fi
        if [ "$expected" = "opencode" ] && [ "$comm" = "opencode" ]; then return 0; fi
        if [ "$expected" = "gemini" ] && { [ "$comm" = "gemini" ] || [ "$comm" = "agy" ]; }; then return 0; fi
        if [ "$expected" = "codex" ] && { [ "$comm" = "codex" ] || [ "$comm" = "node" ]; }; then return 0; fi
        if [ "$comm" = "$expected" ]; then return 0; fi
        ;;
    esac
  done
  return 1
}
# running_launch_cmd — the relaunch command for whatever mind is LIVE in a pane, so keepalive can
# revive the OPERATOR'S chosen engine (not a hardcoded default) when it dies (operator 2026-06-20:
# "the mind I switch to is the one kept in the window"). Captures the live mind's own args so model
# flags survive; special-cases agy → mesh-agy (bare 'agy' geo-fails Antigravity's eligibility check;
# mesh-agy routes it through phaedra's Canada egress). $2 = declared fallback if nothing parseable.
running_launch_cmd(){ # $1 = pane target, $2 = declared fallback cmd
  local pp p comm args
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || { printf '%s' "$2"; return; }
  [ -z "$pp" ] && { printf '%s' "$2"; return; }
  for p in "$pp" $(descendants "$pp"); do
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "$comm" in
      agy) printf '%s' "$HOME/.local/bin/mesh-agy"; return ;;
      node) printf '%s' "$2"; return ;;   # node-wrapped engine (codex) — args are the node path; use declared
      claude|codex|opencode|gemini)
        args="$(ps -o args= -p "$p" 2>/dev/null)"
        printf '%s' "${args:-$2}"; return ;;
    esac
  done
  printf '%s' "$2"
}
relaunch(){ # $1=pane $2=launch-cmd — types into the pane, so the pane MUST be a bare shell: typing
  # a launch cmd into an ssh runs it on the PEER; into a TUI it lands as a junk prompt. Skip + flag.
  local pp bin sentinel p occ
  bin="$(cmd_bin "$2")"   # skip leading VAR=val env assignments (else 'OPENCODE_MODEL=…' looks like the bin)
  # Guard: if the binary isn't installed on this node, skip + alert once per hour per binary.
  if ! command -v "$bin" >/dev/null 2>&1; then
    sentinel="$HOME/.mesh/channel-keepalive-missing-${bin}.ts"
    echo "$(ts) SKIP $1: '$bin' not installed — channel mind unavailable" >> "$LOG"
    if [ ! -f "$sentinel" ] || [ "$(( $(date +%s) - $(cat "$sentinel" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
      date +%s > "$sentinel"
      command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[channel-missing-tool] $1: '$bin' not installed on $S — install to enable this channel mind" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null)
  # Safe to type ONLY into a pure-SHELL subtree. The launch wrapper is 'sh -c → bash -l' (TWO shell
  # procs — a bash -l child is NORMAL after the mind exits, NOT an occupant), so the old "pane_pid is a
  # shell AND has no children" guard always failed for wrapped channels → relaunch never fired (a wake-up
  # bug). Instead: scan the whole subtree — if EVERY process is a shell, it's relaunchable; a non-shell
  # (an ssh, a live TUI) means occupied → don't type into it. (mind death already ensured by keep().)
  occ=""
  for p in "$pp" $(descendants "$pp"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in sh|-sh|bash|-bash|zsh|-zsh|dash|-dash|"") : ;; *) occ="$(ps -o comm= -p "$p" 2>/dev/null)"; break ;; esac
  done
  if [ -n "$occ" ]; then
    echo "$(ts) SKIP $1: pane subtree has a live non-shell process ('$occ') — not typing '$2' into it" >> "$LOG"
    # If the "occupant" is a RECOGNIZED MIND ENGINE (same whitelist as mind_alive:74), the mind is
    # actually ALIVE — keep() only calls relaunch() when mind_alive() returned DEAD, so a mind COMM here
    # PROVES mind_alive raced (a transient failed/empty tmux/ps read on the prior scan; the node ran hot
    # with thermal-shed the day this recurred). It is NOT a "non-mind live process" and NOT a stuck pane.
    # Posting [channel-odd] for it is a FALSE POSITIVE — verified the dominant case: of 67 logged occupied
    # SKIPs, 64 were mind engines (agy×55, claude×8, opencode×1), only 'sleep'/'timeout' (transient mind
    # subprocesses) otherwise. Escalating these to a [task] (chat-review/channel-odd-escalate, 2026-06-21)
    # would dispatch workers to "look at" perfectly healthy panes. So: suppress the board post for a live
    # mind (log only), and leave [channel-odd] for a GENUINE non-mind occupant (ssh / stray TUI / reviver
    # loop) — the real "needs a look" case. (The deeper mind_alive read-failure-as-DEAD guard is the
    # separate redirect chat-review/keepalive-readfailure-unknown — [[fusion-tools-distinguish-empty-from-failed]].)
    case "$occ" in
      claude|codex|opencode|gemini|agy|node)
        echo "$(ts) NOTE $1: occupant '$occ' is a live mind engine — mind_alive raced (mind is alive); not a stuck pane, no board alert" >> "$LOG"
        return 0 ;;
    esac
    # Rate-limit the board alert (once/hour per pane) — same anti-cry-wolf sentinel as the missing-tool
    # path above. A persistently-occupied mind pane (e.g. a legacy reviver loop left in minds.1) was
    # re-posting [channel-odd] every cron pass (*/4) → board spam that drowns real signal.
    sentinel="$HOME/.mesh/channel-keepalive-odd-$(printf '%s' "$1" | tr ':/.' '___').ts"
    if [ ! -f "$sentinel" ] || [ "$(( $(date +%s) - $(cat "$sentinel" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
      date +%s > "$sentinel"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[channel-odd] $1 mind looks dead but pane is occupied (non-mind live process) — needs a look, not auto-relaunched" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  tmux send-keys -t "$1" C-u 2>/dev/null; sleep 0.2
  # MESH_WHO carries the WINDOW lane onto every board post the relaunched mind makes — mesh-chat falls
  # back to $USER@host when unset, so a keepalive-relaunched mind (the */4 path that runs minds most of
  # the time, NOT mesh-restore) was collapsing into one 'imozerov@host' identity, unattributable by lane
  # (chat-review/chat-self-attribution, 2026-06-25: mesh-restore's ensure_channel already set this; the
  # RELAUNCH path was the real gap). Mirror ensure_channel's mw exactly — derive the window from the pane
  # target "$S:<win>.<idx>"; $(hostname) is sent LITERAL so the pane shell expands it at relaunch time.
  local rwin="${1#*:}"; rwin="${rwin%.*}"
  # SPAWN-AUDIT (chat-review/mind-spawn-audit-log, 2026-07-01): mirror ensure_channel's audit line —
  # log win+resolved-MESH_WHO+engine right after MESH_WHO is set, before the mind launches.
  tmux send-keys -t "$1" "export MESH_WHO=\"${rwin}@\$(hostname)\"; { echo \"\$(date -u +%FT%TZ) win=${rwin} who=\$MESH_WHO engine=$2 site=keepalive\" >> \"\$HOME/.mesh/.mind-spawn-audit.log\"; } 2>/dev/null; ${MIND_PATH_PREFIX}$2" C-m 2>/dev/null
  echo "$(ts) RELAUNCHED $1 ($2) as MESH_WHO=$rwin@$S" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-relaunched] channel-keepalive: relaunched $1 ($2)" >/dev/null 2>&1 || true
}
# channel window -> mind launch cmd. The MIND is the BOTTOM-most pane (largest pane_top) — same
# selector as mesh-tell/mesh-feed/mesh-mind-state; hardcoded .1 broke when panes died and renumbered.
# is the mind binary actually PRESENT on this node? (uniform sessions 2026-06-13: a node without a
# given mind shows a REMOTE-NOTE pane, NOT a local mind — relaunching an absent binary into it storms.
# This bit phaedra: claude/opencode aren't installed there but it has the uniform dev/discover/sense
# channels → channel-keepalive relaunched claude every cycle. Check with the full mind-launch PATH.)
mind_present(){ local bin; bin="$(cmd_bin "$1")"
  bash -lc "export PATH=\"\$HOME/.opencode/bin:\$HOME/.bun/bin:\$HOME/.local/bin:\$PATH\"; [ -s \"\$HOME/.nvm/nvm.sh\" ] && . \"\$HOME/.nvm/nvm.sh\" >/dev/null 2>&1; command -v $bin" >/dev/null 2>&1
}
# A rate-limited mind isn't free: a walled codex/claude TUI BUSY-WAITS at ~18-24% CPU rendering its
# limit message, pegging a core for hours/days (the 2026-06-13 thermal root cause). SHED it: kill the
# spinning mind so its pane drops to a shell, mark a cooldown, and skip relaunch until cooldown — so a
# rate-limited mind spins ~one keepalive cycle per cooldown instead of continuously (~97% CPU cut).
RL_COOLDOWN="${MESH_RL_COOLDOWN:-1800}"   # re-check a paused mind every 30min (it may regain quota)
RL_FALLBACK="${MESH_RL_FALLBACK_CMD:-opencode -m opencode/deepseek-v4-flash-free}"  # free-provider fallback when quota-exhausted
RL_FALLBACK_AFTER="${MESH_RL_FALLBACK_AFTER:-2}" # consecutive quota sheds before switching to fallback
ratelimited(){ # $1=pane → 0 if a GENUINE rate-limit/usage wall BANNER is showing (banner-shape, not
  # prose). Uses the shared rl_is_walled (mesh-patterns.sh) so a mind writing ABOUT quotas in its own
  # summary/task text is never shed off that prose (operator FP 2026-06-15). Inline fallback if the
  # shared lib isn't deployed: terse-line guard only (drops the worst long-prose false positives).
  if command -v rl_is_walled >/dev/null 2>&1; then
    tmux capture-pane -t "$1" -p -S -10 2>/dev/null | rl_is_walled
  else
    tmux capture-pane -t "$1" -p -S -10 2>/dev/null | grep -vE '^[[:space:]]*[❯›]' \
      | awk 'length($0)<=100' | grep -qiE "$MESH_RL_RE"
  fi
}
# rl_cooldown_secs — read the REAL reset time the banner states ("resets 2:20pm", "try again at
# 6:03 PM", "try again in 2h", "resets at 15:00") and return seconds-to-reset, clamped [120, 6h].
# No reset parseable OR reset already PAST → no output (caller falls back to RL_COOLDOWN=30min).
# Past-time case: the banner can show a stale short-window reset time while a longer window (5h)
# is still depleted — emitting MIN=120 caused a 3h thrash loop (2026-06-15 chat-review finding).
# Future-time: emit exact seconds → resume precisely when quota resets.
rl_cooldown_secs(){
  command -v python3 >/dev/null 2>&1 || return 0
  python3 <(cat <<'PYEOF'
import sys,re,datetime
MIN,MAX_SHORT,MAX_LONG=120,6*3600,24*3600
txt=sys.stdin.read().lower()
# LONG-WINDOW walls = account-quota exhaustion lasting DAYS (weekly OR monthly), not a transient
# rate-limit. They get the 24h clamp + daily re-check; a 6h short clamp re-pokes a week-long wall
# every <=6h — the phaedra WEEKLY-quota thrash (2026-06-17). phaedra's claude shares the account
# WEEKLY quota, and the old regex matched only 'monthly', so weekly walls fell to the short clamp.
is_long=bool(re.search(r'(month|week)ly\s+(usage\s+)?limit|(month|week)ly\s+quota|build\s+monthly|reset[s]?\s+(next\s+)?(week|month)|\bin\s+\d+(?:[–-]\d+)?\s*days?\b',txt))
MAX=MAX_LONG if is_long else MAX_SHORT
def out(s): print(max(MIN,min(int(s),MAX))); sys.exit(0)
now=datetime.datetime.now()
# day range/relative: "resets in 3 days" / "in 2-3 days" (weekly-quota banner) — clamped to 24h
m=re.search(r'\bin\s+(\d+)(?:[–-]\d+)?\s*days?\b',txt)
if m:
    out(int(m.group(1))*86400+30)
# hour range: "it will reset in 18-20 hours" — take the LOWER bound so we resume as early as valid
m=re.search(r'\bin\s+(\d+)[–-]\d+\s*[\[]*\s*(h|hr|hrs|hour|hours|m|min|mins|minute|minutes)\b',txt)
if m:
    n=int(m.group(1)); out(n*3600+30 if m.group(2).startswith('h') else n*60+30)
# relative: "try again in 2h" / "in 45 min"
m=re.search(r'\bin\s+(\d+)\s*(h|hr|hrs|hour|hours|m|min|mins|minute|minutes)\b',txt)
if m:
    n=int(m.group(1)); out(n*3600+30 if m.group(2).startswith('h') else n*60+30)
# long-window fallback: no parseable reset time → 18h default (daily-ish re-check)
if is_long:
    out(18*3600+30)
# absolute clock: "resets 2:20pm" / "reset at 3:00 pm" / "try again at 6:03 pm" / "resets at 15:00"
m=re.search(r'(?:reset[s]?|try again)\s*(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)?',txt)
if m:
    hh=int(m.group(1)); mm=int(m.group(2) or 0); ap=m.group(3)
    if ap=='pm' and hh<12: hh+=12
    if ap=='am' and hh==12: hh=0
    if hh<=23 and mm<=59:
        tgt=now.replace(hour=hh,minute=mm,second=0,microsecond=0)
        if tgt > now:
            out(int((tgt-now).total_seconds())+30)
        # tgt <= now: stale/past banner → no output, caller uses RL_COOLDOWN (30min) conservatively
sys.exit(0)
PYEOF
)
}
WAVE_FILE="$HOME/.mesh/.keepalive-wave"
WAVE_WINDOW="${MESH_QUOTA_WAVE_WINDOW:-600}"      # 10min window for counting paused minds
WAVE_THRESHOLD="${MESH_QUOTA_WAVE_THRESHOLD:-3}"  # ≥N minds paused in window → wave
WAVE_COOLDOWN="${MESH_QUOTA_WAVE_COOLDOWN:-600}"  # suppress consolidated re-post for N seconds
WAVE_COOLDOWN_MARK="$HOME/.mesh/.keepalive-wave-cooldown"
quota_wave(){ # $1=window name → returns 1 (suppress post) if quota-wave active, 0 (post normally)
  local now; now=$(date +%s)
  # HOISTED cooldown check (chat-review/quota-wave-suppress-race): test the suppression mark BEFORE
  # appending/counting WAVE_FILE. Previously nested inside cnt>=threshold, so concurrent passes in a
  # rate-limit cascade could append+rewrite WAVE_FILE and race the check-then-set before the mark
  # landed → leaked [mind-paused] posts past the active suppression. Now an active cooldown
  # short-circuits here (NO file mutation at all), and the instance flock (see the pass) serializes
  # the remaining append→count→set so only one pass ever arms the mark.
  if [ -f "$WAVE_COOLDOWN_MARK" ] && [ "$(cat "$WAVE_COOLDOWN_MARK" 2>/dev/null || echo 0)" -gt "$now" ]; then
    return 1
  fi
  echo "$now|$1" >> "$WAVE_FILE"
  local cnt=0 tmp; tmp=$(mktemp) || return 0
  while IFS='|' read -r ts win 2>/dev/null; do
    [ -n "${ts:-}" ] || continue
    if [ "$(( now - ts ))" -le "$WAVE_WINDOW" ]; then
      echo "$ts|$win" >> "$tmp"
      cnt=$(( cnt + 1 ))
    fi
  done < "$WAVE_FILE"
  mv "$tmp" "$WAVE_FILE"
  if [ "$cnt" -ge "$WAVE_THRESHOLD" ]; then
    echo "$(( now + WAVE_COOLDOWN ))" > "$WAVE_COOLDOWN_MARK"
    MESH_WHO="channel-keepalive@$S" mesh-chat "[quota-wave] $S: ≥$cnt minds rate-limited in last $((WAVE_WINDOW/60))min — suppressing individual [mind-paused] posts for $((WAVE_COOLDOWN/60))min" >/dev/null 2>&1
    return 1
  fi
  return 0
}

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  tmux has-session -t "$S" 2>/dev/null || { echo "smoke-test: FAIL (no session $S)"; exit 1; }
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null >/dev/null || { echo "smoke-test: FAIL (tmux session unreadable)"; exit 1; }
  # Dry-run the cooldown CLASSIFIER (rl_cooldown_secs) — the load-bearing logic that decides how long a
  # walled mind is paused. It was UNTESTED (old --test only checked the tmux session); a regex drift here
  # silently re-poked a week-long wall every <=6h. FALSIFIABLE: revert is_long to monthly-only and the
  # weekly assert FAILs. (Test moved below the function def so it can call it; nothing above has side-fx.)
  if command -v python3 >/dev/null 2>&1; then
    f=0
    wk=$(printf 'You have reached your weekly usage limit. Your limit will reset in 3 days.\n' | rl_cooldown_secs)
    mo=$(printf 'Approaching your monthly usage limit.\n' | rl_cooldown_secs)
    tr=$(printf 'Please try again in 2h.\n' | rl_cooldown_secs)
    # a WEEKLY wall must exceed the 6h short clamp (treated as long-window → 24h clamp), not thrash
    [ "${wk:-0}" -gt 21600 ] || { echo "  FAIL: weekly wall cooldown=${wk:-none}s not >6h (weekly not treated as long-window)"; f=1; }
    # a MONTHLY wall with no parseable time must hit the long fallback (>6h)
    [ "${mo:-0}" -gt 21600 ] || { echo "  FAIL: monthly wall cooldown=${mo:-none}s not >6h"; f=1; }
    # a TRANSIENT 'try again in 2h' must stay the short reset (~7200s), NOT be escalated to long-window
    { [ "${tr:-0}" -ge 7000 ] && [ "${tr:-0}" -le 7400 ]; } || { echo "  FAIL: transient 'in 2h' cooldown=${tr:-none}s not ~7200 (short-window broke)"; f=1; }
    [ "$f" = 0 ] || { echo "smoke-test: FAIL (rl_cooldown_secs classifier drifted)"; exit 1; }
    echo "smoke-test: ok (cooldown classifier: weekly=${wk}s monthly=${mo}s transient=${tr}s — long-window vs short verified)"
  else
    echo "smoke-test: ok (no python3 — cooldown-classifier check skipped)"
  fi
  # AUTO-REVERT decision (quota_should_revert) — the load-bearing gate for returning a paid window to
  # claude on quota reset. FALSIFIABLE: flip any branch and an assert FAILs.
  rf=0
  quota_should_revert 0 10 7200    || { echo "  FAIL: cooldown EXPIRED should revert"; rf=1; }
  quota_should_revert 1 100 7200   && { echo "  FAIL: cooldown ACTIVE + young must NOT revert"; rf=1; }
  quota_should_revert 1 8000 7200  || { echo "  FAIL: aged-past-cap (misparse guard) should revert"; rf=1; }
  quota_should_revert 1 7200 7200  || { echo "  FAIL: age == cap should revert (boundary)"; rf=1; }
  [ "$rf" = 0 ] || { echo "smoke-test: FAIL (quota_should_revert decision drifted)"; exit 1; }
  echo "smoke-test: ok (auto-revert decision verified: expired→revert, active+young→hold, aged→revert)"
  # opencode auto-approve opt-in (chat-review/room-mind-opencode-engine-drift 2026-07-04): --auto must
  # be appended ONLY when (a) opted in via MESH_OPENCODE_YOLO=1 AND (b) the resolved binary basename is
  # opencode — never for claude/codex/gemini, never when unset (default OFF), and never double-appended
  # if already present. A regression here either silently re-freezes every opencode channel on the y/n
  # gate (opt-in ignored) or ships auto-approve mesh-wide unconditionally (opt-in bypassed) — both wrong.
  of=0
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag opencode)" = "opencode --auto" ]                    || { echo "  FAIL: bare opencode + opt-in should append --auto"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'opencode -m opencode/deepseek-v4-flash-free')" = "opencode -m opencode/deepseek-v4-flash-free --auto" ] || { echo "  FAIL: opencode w/ args + opt-in should append --auto"; of=1; }
  [ "$(opencode_autoflag opencode)" = "opencode" ]                                                || { echo "  FAIL: opt-out (default) must NOT append --auto"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'claude --permission-mode auto')" = "claude --permission-mode auto" ] || { echo "  FAIL: non-opencode engine must be untouched even when opted in"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'opencode --auto')" = "opencode --auto" ]            || { echo "  FAIL: already-present --auto must not double-append"; of=1; }
  [ "$(MESH_OPENCODE_YOLO=1 opencode_autoflag 'OPENCODE_MODEL=x opencode')" = "OPENCODE_MODEL=x opencode --auto" ] || { echo "  FAIL: env-var-prefixed opencode cmd should still resolve+append"; of=1; }
  [ "$of" = 0 ] || { echo "smoke-test: FAIL (opencode_autoflag drifted)"; exit 1; }
  echo "smoke-test: ok (opencode auto-approve: opt-in gated, basename-scoped, no double-append)"
  # SHED-AUDIT instrument (instrument-first, non-ergodicity review): shed_mind must record the
  # absorbing-barrier exposure (RECOVERABLE vs BARE pane) before the kill — zero behavior change,
  # visibility only. The helper is defined BELOW this --test block (can't be called here), so verify
  # the wiring is present in the source. FALSIFIABLE: drop either line and an assert FAILs.
  src="${BASH_SOURCE[0]:-$0}"
  grep -q 'shed_recoverability()' "$src" || { echo "smoke-test: FAIL (shed-audit helper shed_recoverability missing)"; exit 1; }
  grep -q 'SHED-AUDIT .*shed_recoverability' "$src" || { echo "smoke-test: FAIL (shed_mind lost the SHED-AUDIT instrument before the kill)"; exit 1; }
  echo "smoke-test: ok (shed-audit instrument wired: shed_recoverability classifier + SHED-AUDIT log before kill)"
  # SPAWN-AUDIT (chat-review/mind-spawn-audit-log): relaunch() must log win+resolved-MESH_WHO+engine
  # to .mind-spawn-audit.log BEFORE the mind launches, mirroring mesh-restore's ensure_channel.
  grep -q 'mind-spawn-audit.log' "$src" || { echo "smoke-test: FAIL (relaunch() lost the spawn-audit log line)"; exit 1; }
  echo "smoke-test: ok (spawn-audit wired: relaunch() logs win/who/engine to .mind-spawn-audit.log)"
  # quota_wave hoist + cooldown (chat-review/quota-wave-suppress-race): FUNCTIONAL test. The cooldown
  # check must run BEFORE appending/counting WAVE_FILE (hoisted out of cnt>=threshold) so a concurrent
  # rate-limit cascade can't race the check-then-set and leak [mind-paused] posts past active
  # suppression. FALSIFIABLE: re-nest the check inside cnt>=threshold (after the append) and the
  # "active cooldown leaves WAVE_FILE empty" assert FAILs (the append would fire before the return).
  # mesh-chat is stubbed so --test never posts a [quota-wave] line to the real board.
  qf=0
  _tw="$HOME/.mesh/.kw-test-wave.$$"; _tm="$HOME/.mesh/.kw-test-mark.$$"
  mesh-chat(){ :; }   # stub (shell fn shadows the command for the duration of --test)
  WAVE_FILE="$_tw"; WAVE_COOLDOWN_MARK="$_tm"; WAVE_THRESHOLD=3; WAVE_WINDOW=600; WAVE_COOLDOWN=60
  # (1) ACTIVE cooldown (future mark) → return 1 AND WAVE_FILE stays empty (hoisted check short-
  #     circuits BEFORE the append). THIS is the race fix: nested-after-append would leave an entry.
  : > "$_tw"; echo "$(( $(date +%s) + 300 ))" > "$_tm"
  quota_wave testwin; rc=$?
  { [ "$rc" = 1 ] && [ ! -s "$_tw" ]; } || { echo "  FAIL: active cooldown rc=$rc (want 1) / WAVE_FILE non-empty — hoist regressed (check ran after append)"; qf=1; }
  # (2) threshold crossing (≥3 in-window entries) → arm the cooldown mark + return 1 (suppress)
  : > "$_tw"; rm -f "$_tm"; n=$(date +%s); printf '%s|a\n%s|b\n%s|c\n' "$n" "$n" "$n" >> "$_tw"
  quota_wave testwin; rc=$?
  { [ "$rc" = 1 ] && [ -f "$_tm" ]; } || { echo "  FAIL: threshold-crossing rc=$rc (want 1) / mark not armed"; qf=1; }
  # (3) below threshold → return 0 (caller posts [mind-paused] normally); mark NOT armed
  : > "$_tw"; rm -f "$_tm"; printf '%s|a\n' "$n" >> "$_tw"
  quota_wave testwin; rc=$?
  { [ "$rc" = 0 ] && [ ! -e "$_tm" ]; } || { echo "  FAIL: below-threshold rc=$rc (want 0) / mark wrongly armed"; qf=1; }
  rm -f "$_tw" "$_tm"
  # instance flock (chat-review/quota-wave-suppress-race): non-blocking lock so only one keepalive pass
  # mutates wave/cooldown state at a time. Search term built from a var so this assert doesn't match
  # its OWN grep text (FALSIFIABLE: drop the exec/flock from the pass and the count drops to 0 → FAIL).
  _flk="flock"; [ "$(grep -cF -- "$_flk -n 200" "$src")" -ge 1 ] || { echo "  FAIL: instance lock missing before the pass (no flock guard on the keepalive run)"; qf=1; }
  [ "$qf" = 0 ] || { echo "smoke-test: FAIL (quota_wave hoist/cooldown or instance-lock drifted)"; exit 1; }
  echo "smoke-test: ok (quota_wave: active-cooldown suppresses w/o file touch, threshold arms mark, below=0; instance flock present)"

  # chat-review/quota-wave-caller-inverted: the caller must post [mind-paused] when quota_wave
  # returns 0 (post normally) and stay silent when it returns 1 (suppress) — NOT inverted. The above
  # asserts quota_wave's OWN return contract; this asserts the call site respects it (FALSIFIABLE:
  # reintroduce the negated form and this FAILs). Pattern built from a var (like the flock check
  # above) so this test's own source text can't satisfy its own grep.
  _qwc="quota_wave \"\$1\"; then"
  grep -qF -- "if $_qwc" "$src" || { echo "  FAIL: quota_wave caller polarity missing/reverted (want 'if quota_wave', not negated)"; qf=1; }
  grep -qF -- "if ! $_qwc" "$src" && { echo "  FAIL: quota_wave caller still inverted ('if ! quota_wave' present)"; qf=1; }
  [ "$qf" = 0 ] || { echo "smoke-test: FAIL (quota_wave caller polarity regressed)"; exit 1; }
  echo "smoke-test: ok (quota_wave caller polarity: posts [mind-paused] only when quota_wave says post-normally)"
  exit 0
fi

# shed_recoverability — READ-ONLY classifier (instrument-first, non-ergodicity review 2026-06-21):
# a shed KILLS the mind TRUSTING the pane's shell wrapper to survive ('exec bash -l' → relaunchable
# shell). But a BARE-launched pane (the mind IS the pane root, no wrapping shell) CLOSES PERMANENTLY on
# kill — an ABSORBING BARRIER (lost scrollback + the channel pane itself; [[restart-mind-needs-exec-bash-fallback]],
# a real past harm = lost chat/health/work panes). The shed is judged per-fire, never by what the kill
# costs when the barrier is reachable. This classifies each shed target WITHOUT changing behavior, so the
# barrier's REAL exposure is visible on $LOG before any refuse/park enforcement is wired (vet, then enforce
# — same instrument-before-actuator discipline as the therm --csd land). Pure: no kill, no tmux mutation.
shed_recoverability(){ # $1=pane → echo RECOVERABLE|BARE|UNKNOWN <detail>
  local pp rootcomm mind="" p
  # tmux 'display -t <bad-target>' silently FALLS BACK to the active pane (returns its pid, rc 0) instead
  # of failing — so verify the pane REALLY exists first, or a bogus target misreads as the active mind.
  tmux list-panes -a -F '#{session_name}:#{window_name}.#{pane_index}' 2>/dev/null | grep -qxF "$1" \
    || { echo "UNKNOWN no-pane"; return; }
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || { echo "UNKNOWN no-pane"; return; }
  rootcomm="$(ps -o comm= -p "$pp" 2>/dev/null)"
  for p in "$pp" $(descendants "$pp"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in claude|codex|opencode|gemini|agy|node) mind="$(ps -o comm= -p "$p" 2>/dev/null)"; break ;; esac
  done
  [ -n "$mind" ] || { echo "UNKNOWN no-mind-in-subtree root=${rootcomm:-?}"; return; }
  # RECOVERABLE iff the pane ROOT (the process tmux keeps the pane alive for) is a SHELL — it outlives the
  # mind's death and drops to a relaunchable prompt. If the root IS a mind engine, the mind is the pane
  # root → killing it closes the pane (BARE, the absorbing barrier).
  case "$rootcomm" in
    sh|-sh|bash|-bash|zsh|-zsh|dash|-dash) echo "RECOVERABLE root=$rootcomm mind=$mind" ;;
    "")  echo "UNKNOWN no-root mind=$mind" ;;
    *)   echo "BARE root=$rootcomm mind=$mind" ;;
  esac
}
shed_mind(){ # $1=pane → kill the ACTUAL mind process in the pane's SUBTREE (claude is a grandchild of
  # the sh→bash wrapper; the old direct-children-only kill matched 'bash' not 'claude' → killed NOTHING,
  # so the walled mind kept spinning AND was never shed-then-relaunched). Kill by COMM; the wrapper
  # (sh/bash) is never matched, so it survives to 'exec bash -l' → pane drops to a relaunchable shell.
  local pp p; pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  # instrument-first SHED-AUDIT (zero behavior change): record the absorbing-barrier exposure of THIS
  # shed before the kill, so RECOVERABLE-vs-BARE can be vetted on real shed events before enforcement.
  echo "$(ts) SHED-AUDIT $1: $(shed_recoverability "$1")" >> "$LOG" 2>/dev/null || true
  for p in "$pp" $(descendants "$pp"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in claude|codex|opencode|gemini|agy|node) kill "$p" 2>/dev/null ;; esac
  done
}
keep(){ # $1=window $2=launch-cmd
  local n mp rlmark stick
  # LEAN-NODE allowlist (mirror mesh-restore): when MESH_MIND_CHANNELS (restore.env) is set, only the
  # listed channels are tended/relaunched here; the rest are left data-only. RAM-constrained nodes that
  # cannot host the full suite (phaedra 1.9Gi). Unset → tend all (default, unchanged).
  if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
    case " $MESH_MIND_CHANNELS " in *" $1 "*) :;; *) [ "${VERBOSE:-}" = 1 ] && echo "  $1: not in MESH_MIND_CHANNELS (lean node) — skip"; return 0;; esac
  fi
  local b2; b2="$(cmd_bin "$2")"   # real binary, skipping env-var prefix (OPENCODE_MODEL=… opencode)
  stick="$HOME/.mesh/.window-engine-$(printf '%s' "$1" | tr ':/.' '___')"  # operator's sticky engine for this window
  mind_present "$2" || { [ "${VERBOSE:-}" = 1 ] && echo "  $1: mind '$b2' not on this node — remote-note channel, skip"; return 0; }
  mind_declared "$b2" || { [ "${VERBOSE:-}" = 1 ] && echo "  $1: '$b2' not declared in card (organ-only/decommissioned) — skip"; return 0; }
  n=$(tmux list-panes -t "$S:$1" 2>/dev/null | wc -l)
  [ "${n:-0}" -ge 2 ] || return 0   # not a 2-pane channel → skip (mesh-restore rebuilds structure)
  mp=$(tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
  rlmark="$HOME/.mesh/.rl-cooldown-$1"
  # PAUSED until the cooldown EXPIRY epoch stored in the mark (reset-aware, see rl_cooldown_secs).
  # Old marks stored shed-time (< now) → read as expiry they're already past → not paused → the mind
  # is re-evaluated and re-shed with a proper expiry. Self-healing on upgrade.
  if [ -f "$rlmark" ] && [ "$(date +%s)" -lt "$(cut -d'|' -f1 "$rlmark" 2>/dev/null || echo 0)" ]; then
    [ "${VERBOSE:-}" = 1 ] && echo "  $1: rate-limited — paused (cooldown active), skip"; return 0
  fi
  # AUTO-REVERT to claude when paid quota is back. A MARKED quota-fallback (.quota-fallback-$win, written
  # by the RL_FALLBACK branch below + by `mesh-quota --fallback`) on a window whose DECLARED engine is
  # claude must NOT pin forever — once the wall's cooldown expired (or it aged past the cap), drop the
  # quota state and shed the fallback so the dead branch relaunches the DECLARED claude. A genuine
  # operator engine switch carries NO marker and is never touched (sovereignty preserved).
  local qfmark="$HOME/.mesh/.quota-fallback-$1"
  if [ -f "$qfmark" ] && [ "$(basename "$(cmd_bin "$2")")" = claude ]; then
    local cd_active=0
    [ -f "$rlmark" ] && [ "$(date +%s)" -lt "$(cut -d'|' -f1 "$rlmark" 2>/dev/null || echo 0)" ] && cd_active=1
    local qf_age=$(( $(date +%s) - $(stat -c %Y "$qfmark" 2>/dev/null || date +%s) ))
    if quota_should_revert "$cd_active" "$qf_age" "${MESH_QUOTA_REVERT_MAX:-7200}"; then
      rm -f "$qfmark" "$stick" "$rlmark" 2>/dev/null   # wall over → drop ALL quota state so we relaunch CLAUDE, not the fallback
      if mind_alive "$S:$1.$mp" && ! mind_process_matches_declared "$S:$1.$mp" "$b2"; then
        shed_mind "$S:$1.$mp"   # fallback engine live → kill it; pane drops to shell, next pass relaunches declared claude
        echo "$(ts) QUOTA-REVERT $1: paid quota back (cd_active=$cd_active age=${qf_age}s) → shed fallback, declared claude relaunches next pass" >> "$LOG"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[quota-resumed] $S:$1: paid quota back → reverting fallback → claude" >/dev/null 2>&1 || true
        return 0
      fi
      # else: claude already running, or pane already dead → fall through (dead branch relaunches declared claude)
    fi
  fi
  if mind_alive "$S:$1.$mp"; then
    # OPERATOR-SOVEREIGN ENGINE (operator 2026-06-20: "I want to switch the mind in a window to one I
    # want, and that's the mind kept there"). A LIVE, valid mind is NEVER force-reverted to the
    # window's declared default — whatever engine the operator launched stays. We just RECORD it as
    # this window's sticky engine so a future death revives THAT engine, not the hardcoded default.
    # This retires the auto-shed-on-mismatch, which twice killed a healthy operator-chosen mind
    # (claude: path-vs-basename bd06532; then agy in senses). Engine-drift correction is now manual:
    # to change a window's engine, the operator just launches the engine they want in its pane.
    if ! mind_process_matches_declared "$S:$1.$mp" "$b2"; then
      # Operator switched this window to a NON-declared engine → record it (sticky) so a future death
      # revives the operator's choice, and log it. Do NOT shed: the live mind is sovereign.
      local livecmd; livecmd="$(running_launch_cmd "$S:$1.$mp" "$2")"
      # Do NOT record a quota-fallback as a sovereign sticky (it would pin the free engine forever and
      # defeat auto-revert). Only a genuine, unmarked operator switch becomes sticky.
      [ -n "$livecmd" ] && [ ! -f "$qfmark" ] && printf '%s\n' "$livecmd" > "$stick" 2>/dev/null
      local running_comm; running_comm="$(tmux display -p -t "$S:$1.$mp" '#{pane_pid}' 2>/dev/null | xargs -I{} ps -o comm= --ppid {} 2>/dev/null | grep -E 'claude|opencode|gemini|agy|codex|node' | head -1)"
      echo "$(ts) OPERATOR-ENGINE $1: running '${running_comm:-?}' != declared '$b2' — keeping operator's choice (sticky '$livecmd'), NOT shedding" >> "$LOG"
    else
      rm -f "$stick" 2>/dev/null   # running the declared engine → no operator override; dead-revive uses declared cmd (full flags: native-pin + --permission-mode auto)
    fi
    if ratelimited "$S:$1.$mp"; then
      local secs src
      secs="$(tmux capture-pane -t "$S:$1.$mp" -p -S -15 2>/dev/null | rl_cooldown_secs)"
      if [ -n "$secs" ]; then src="banner-reset"; else secs="$RL_COOLDOWN"; src="default"; fi
      shed_mind "$S:$1.$mp"
      local qc=0
      [ -f "$rlmark" ] && qc=$(cut -s -d'|' -f2 "$rlmark" 2>/dev/null)
      qc=$(( ${qc:-0} + 1 ))
      echo "$(( $(date +%s) + secs ))|$qc" > "$rlmark"
      local note=""
      [ "$qc" -ge "$RL_FALLBACK_AFTER" ] && note=" (will try free-provider fallback next: $RL_FALLBACK)"
      echo "$(ts) SHED $1: rate-limit wall + spinning mind → killed, paused ${secs}s ($src), shed #${qc}, resumes $(date -d "@$(( $(date +%s) + secs ))" '+%H:%M' 2>/dev/null)$note" >> "$LOG"
      # chat-review/quota-wave-caller-inverted: quota_wave returns 1=suppress / 0=post-normally
      # (see its own contract comment above). A stray '!' here inverted the polarity — posted
      # [mind-paused] exactly when quota_wave said suppress, and suppressed it when quota_wave said
      # post normally. No '!': call quota_wave for its side-effect (arms the cooldown mark / posts
      # the consolidated [quota-wave] line on threshold-cross) and post [mind-paused] only when it
      # returns 0 (post normally, i.e. below threshold / no active cooldown).
      if quota_wave "$1"; then
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-paused] $S:$1 hit a rate-limit wall — shed + paused ${secs}s ($src), shed #${qc}, auto-resumes ~$(date -d "@$(( $(date +%s) + secs ))" '+%H:%M' 2>/dev/null)$note" >/dev/null 2>&1
      fi
      return 0
    fi
    rm -f "$rlmark" 2>/dev/null   # alive + working → clear any stale cooldown
    [ "${VERBOSE:-}" = 1 ] && echo "  $1: mind alive"
  else
    # quota-adaptive relaunch: if the last shed was due to quota exhaustion and has repeated >=
    # RL_FALLBACK_AFTER times, fall back to a free/cheap provider instead of relaunching the same
    # dying mind that will just hit the quota wall again.
    # revive the OPERATOR'S last-seen engine (sticky) if recorded, else the window's declared default.
    local cmd="$2" qc=0
    if [ -s "$stick" ]; then local sc; sc="$(cat "$stick" 2>/dev/null)"; [ -n "$sc" ] && cmd="$sc"; fi
    if [ -f "$rlmark" ]; then
      qc=$(cut -s -d'|' -f2 "$rlmark" 2>/dev/null)
      qc=${qc:-0}
    fi
    if [ "$qc" -ge "$RL_FALLBACK_AFTER" ] && command -v "$(cmd_bin "$RL_FALLBACK")" >/dev/null 2>&1; then
      cmd="$RL_FALLBACK"
      touch "$HOME/.mesh/.quota-fallback-$1" 2>/dev/null   # MARK: auto quota-fallback → auto-revert to claude on reset (revert block above)
      echo "$(ts) FALLBACK $1: quota-exhausted ${qc}x → switching to free provider: $cmd" >> "$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-fallback] $S:$1 quota-exhausted ${qc}x → switched to free provider: $cmd" >/dev/null 2>&1
    fi
    cmd="$(opencode_autoflag "$cmd")"   # applies to declared default, sticky revival, AND $RL_FALLBACK uniformly
    relaunch "$S:$1.$mp" "$cmd"; echo "  $1: was DEAD → relaunch attempted ($cmd)"
  fi
}
# 2026-06-13: windows are data-channels (plan/health/verify/work), minds distributed to bottoms.
# MINIMAL 6-CHANNEL SET (operator 2026-06-17). Engine + launch-CMD MUST match mesh-restore's manifest
# EXACTLY (same ${VAR:-${VAR:-default}} chains), or restore launches one command and keepalive relaunches
# another → they fight, and a relaunch silently drops flags. In particular the claude channels fall
# through to MESH_CLAUDE_CMD so a keepalive RELAUNCH keeps both `--permission-mode auto` AND the native-
# binary pin (restore.env) — bare 'claude' here used to drop both. claude on minds/genome/tg; free
# opencode on senses/health/chat.
# INSTANCE LOCK (chat-review/quota-wave-suppress-race): the keepalive pass appends to WAVE_FILE,
# rewrites it, and arms/checks the cooldown mark — concurrent passes (a rate-limit cascade firing
# overlapping cron ticks) raced the check-then-set and leaked [mind-paused] posts past active
# suppression. Non-blocking flock: if another pass holds the lock, exit 0 (next cron tick tends it)
# rather than queueing/serializing long. --test is exempt (it exits above, before this point), so
# verify rotations never block on a live pass.
exec 200>"$HOME/.mesh/.channel-keepalive.lock"
flock -n 200 || { [ "${VERBOSE:-}" = 1 ] && echo "  another keepalive pass in progress — skip"; exit 0; }
keep minds   "${MESH_MINDS_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"  # orchestrator — allocation/dispatch
keep genome  "${MESH_GENOME_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}" # autonomous development of the codebase
keep tg      "${MESH_CLAUDE_CMD:-$CLAUDE_BIN}"                     # operator Telegram comms
keep senses  "${MESH_SENSES_CMD:-${MESH_OPENCODE_CMD:-opencode}}" # keep + develop the senses
keep health  "${MESH_HEALTH_CMD:-${MESH_OPENCODE_CMD:-opencode}}" # node/fleet health
keep chat    "${MESH_CHAT_CMD:-${MESH_OPENCODE_CMD:-opencode}}"   # board/room coordination
keep room    "${MESH_ROOM_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"  # the room third-party observer (gated on MESH_MIND_CHANNELS)
keep pub     "${MESH_PUB_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"   # publishing channel (gated on MESH_MIND_CHANNELS)
echo "$(ts) channel-keepalive pass done"
