#!/usr/bin/env bash
# mesh-channel-keepalive — keep each CHANNEL's MIND (bottom pane) alive. mesh-mind-keepalive only tends
# the 'claude' window; channel minds (tg, and any 2-pane channel) died unwatched — the tg claude died
# once with nothing to relaunch it. This checks each channel's mind pane and relaunches its mind if no
# mind process is running under it (a robust process-tree check — pane_current_command can lie when the
# mind runs as node under a shell wrapper).
#   mesh-channel-keepalive          one pass: relaunch any dead channel mind
#   mesh-channel-keepalive --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# PATH-robust mind toolchain: opencode lives in ~/.opencode/bin, codex via nvm — without these the
# `command -v codex` guard below skips the work channel and mind_alive misreads. Mirror the launch env.
for d in "$HOME/.opencode/bin" "$HOME/.bun/bin"; do [ -d "$d" ] && case ":$PATH:" in *":$d:"*) :;; *) PATH="$d:$PATH";; esac; done
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use node >/dev/null 2>&1 || true
# typed-into-the-pane prefix so a relaunched mind resolves regardless of the pane shell's login PATH
MIND_PATH_PREFIX='export PATH="$HOME/.opencode/bin:$HOME/.bun/bin:$HOME/.local/bin:$PATH"; [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1; '
S="$(hostname)"; LOG="$HOME/.mesh/channel-keepalive.log"; ts(){ date -u +%FT%TZ; }
# Per-channel mind-cmd overrides (MESH_SENSE_CMD, MESH_NOVELTY_CMD, etc.) live in restore.env
# (node-local, gitignored) — source here so keepalive restarts use the same cmd as mesh-restore.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null
# canonical wall regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14):
# source the shared MESH_RL_RE; inline fallback if not deployed. Replaces the private regex in
# ratelimited() that MISSED too many requests + overloaded (the shedder caught less than its siblings).
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  tmux has-session -t "$S" 2>/dev/null || { echo "smoke-test: FAIL (no session $S)"; exit 1; }
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null >/dev/null || { echo "smoke-test: FAIL (tmux session unreadable)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

# a mind is ALIVE if a node-based agent (claude/opencode/codex) runs under the pane's shell
mind_alive(){ # $1 = pane target (session:win.idx)
  local pp; pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  [ -z "$pp" ] && return 1
  # Check the pane process ITSELF and its children: a wrapped mind ('bash -lc ... claude ...') is a
  # child of the pane shell, but an UNWRAPPED mind (tg's bare 'claude') IS the pane process — checking
  # only children gave a false "DEAD" and churned the live mind every pass. (When a wrapper drops to
  # 'exec bash -l' after the mind exits, its args no longer contain the mind name → correctly DEAD.)
  for p in "$pp" $(pgrep -P "$pp" 2>/dev/null); do case "$(ps -o args= -p "$p" 2>/dev/null)" in
    *claude*|*codex*|*opencode*|*gemini*|*node*) return 0 ;; esac; done
  return 1
}
relaunch(){ # $1=pane $2=launch-cmd — types into the pane, so the pane MUST be a bare shell: typing
  # a launch cmd into an ssh runs it on the PEER; into a TUI it lands as a junk prompt. Skip + flag.
  local pp pcomm bin sentinel
  bin=$(printf '%s' "$2" | awk '{print $1}')
  # Guard: if the binary isn't installed on this node, skip + alert once per hour per binary.
  if ! command -v "$bin" >/dev/null 2>&1; then
    sentinel="$HOME/.mesh/channel-keepalive-missing-${bin}.ts"
    echo "$(ts) SKIP $1: '$bin' not installed — channel mind unavailable" >> "$LOG"
    if [ ! -f "$sentinel" ] || [ "$(( $(date +%s) - $(cat "$sentinel" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
      date +%s > "$sentinel"
      command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[channel-missing-tool] $1: '$bin' not installed on $S — install to enable this channel mind" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null)
  pcomm=$(ps -o comm= -p "${pp:-0}" 2>/dev/null)
  if ! printf '%s' "$pcomm" | grep -qE '^(ba|z|da)?sh$' || [ -n "$(pgrep -P "${pp:-0}" 2>/dev/null)" ]; then
    echo "$(ts) SKIP $1: pane occupied by a live non-mind process — not typing '$2' into it" >> "$LOG"
    # Rate-limit the board alert (once/hour per pane) — same anti-cry-wolf sentinel as the missing-tool
    # path above. A persistently-occupied mind pane (e.g. a legacy reviver loop left in minds.1) was
    # re-posting [channel-odd] every cron pass (*/4) → board spam that drowns real signal.
    sentinel="$HOME/.mesh/channel-keepalive-odd-$(printf '%s' "$1" | tr ':/.' '___').ts"
    if [ ! -f "$sentinel" ] || [ "$(( $(date +%s) - $(cat "$sentinel" 2>/dev/null || echo 0) ))" -gt 3600 ]; then
      date +%s > "$sentinel"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[channel-odd] $1 mind looks dead but pane is occupied (non-mind live process) — needs a look, not auto-relaunched" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  tmux send-keys -t "$1" C-u 2>/dev/null; sleep 0.2
  tmux send-keys -t "$1" "${MIND_PATH_PREFIX}$2" C-m 2>/dev/null
  echo "$(ts) RELAUNCHED $1 ($2)" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "🔄 channel-keepalive: relaunched $1 ($2)" >/dev/null 2>&1 || true
}
# channel window -> mind launch cmd. The MIND is the BOTTOM-most pane (largest pane_top) — same
# selector as mesh-tell/mesh-feed/mesh-mind-state; hardcoded .1 broke when panes died and renumbered.
# is the mind binary actually PRESENT on this node? (uniform sessions 2026-06-13: a node without a
# given mind shows a REMOTE-NOTE pane, NOT a local mind — relaunching an absent binary into it storms.
# This bit phaedra: claude/opencode aren't installed there but it has the uniform dev/discover/sense
# channels → channel-keepalive relaunched claude every cycle. Check with the full mind-launch PATH.)
mind_present(){ local bin="${1%% *}"
  bash -lc "export PATH=\"\$HOME/.opencode/bin:\$HOME/.bun/bin:\$HOME/.local/bin:\$PATH\"; [ -s \"\$HOME/.nvm/nvm.sh\" ] && . \"\$HOME/.nvm/nvm.sh\" >/dev/null 2>&1; command -v $bin" >/dev/null 2>&1
}
# A rate-limited mind isn't free: a walled codex/claude TUI BUSY-WAITS at ~18-24% CPU rendering its
# limit message, pegging a core for hours/days (the 2026-06-13 thermal root cause). SHED it: kill the
# spinning mind so its pane drops to a shell, mark a cooldown, and skip relaunch until cooldown — so a
# rate-limited mind spins ~one keepalive cycle per cooldown instead of continuously (~97% CPU cut).
RL_COOLDOWN="${MESH_RL_COOLDOWN:-1800}"   # re-check a paused mind every 30min (it may regain quota)
ratelimited(){ # $1=pane → 0 if a HARD rate-limit/usage wall is showing in the live pane
  tmux capture-pane -t "$1" -p -S -10 2>/dev/null | grep -qiE "$MESH_RL_RE"
}
shed_mind(){ # $1=pane → kill the mind process under the pane shell (wrapper then drops to bash); keep the pane
  local pp; pp=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  for c in $(pgrep -P "${pp:-0}" 2>/dev/null); do
    case "$(ps -o comm= -p "$c" 2>/dev/null)" in node|codex|claude|opencode) kill "$c" 2>/dev/null ;; esac
  done
}
keep(){ # $1=window $2=launch-cmd
  local n mp rlmark
  mind_present "$2" || { [ "${VERBOSE:-}" = 1 ] && echo "  $1: mind '${2%% *}' not on this node — remote-note channel, skip"; return 0; }
  n=$(tmux list-panes -t "$S:$1" 2>/dev/null | wc -l)
  [ "${n:-0}" -ge 2 ] || return 0   # not a 2-pane channel → skip (mesh-restore rebuilds structure)
  mp=$(tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
  rlmark="$HOME/.mesh/.rl-cooldown-$1"
  # PAUSED: a fresh rate-limit cooldown → leave the channel idle (don't relaunch into the same wall)
  if [ -f "$rlmark" ] && [ "$(( $(date +%s) - $(stat -c %Y "$rlmark" 2>/dev/null||echo 0) ))" -lt "$RL_COOLDOWN" ]; then
    [ "${VERBOSE:-}" = 1 ] && echo "  $1: rate-limited — paused (cooldown active), skip"; return 0
  fi
  if mind_alive "$S:$1.$mp"; then
    if ratelimited "$S:$1.$mp"; then
      shed_mind "$S:$1.$mp"; date +%s > "$rlmark"
      echo "$(ts) SHED $1: rate-limit wall + spinning mind → killed, paused ${RL_COOLDOWN}s (save heat/power)" >> "$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="channel-keepalive@$S" mesh-chat "[mind-paused] $S:$1 hit a rate-limit wall (was busy-waiting CPU) — shed + paused ${RL_COOLDOWN}s to save heat; auto-retries after cooldown" >/dev/null 2>&1
      return 0
    fi
    rm -f "$rlmark" 2>/dev/null   # alive + working → clear any stale cooldown
    [ "${VERBOSE:-}" = 1 ] && echo "  $1: mind alive"
  else
    relaunch "$S:$1.$mp" "$2"; echo "  $1: was DEAD → relaunch attempted"
  fi
}
# 2026-06-13: windows are data-channels (plan/health/verify/work), minds distributed to bottoms.
keep plan     'claude --continue'   # plan channel = steward mind (claude)
keep health   'opencode'            # health channel = check mind (opencode)
keep verify   'opencode'            # verify channel = opencode (gemini binary needs browser OAuth → not headless-survivable)
keep tg       'claude'              # tg channel = operator Telegram data, mind claude
keep chat     'claude'              # chat channel = board data, mind claude (filter-gated; opencode died on login-PATH gap, operator 2026-06-13)
keep dev      'claude'              # dev channel = autonomous-dev data, mind claude (operator 2026-06-13)
keep discover 'claude'              # discover channel = capability-research mind (operator 2026-06-13)
keep sense    "${MESH_SENSE_CMD:-claude}"       # sense: override in ~/.mesh/restore.env → MESH_SENSE_CMD
keep 'mon:novelty' "${MESH_NOVELTY_CMD:-claude}" # novelty: override → MESH_NOVELTY_CMD
keep minds    "${MESH_MINDS_CMD:-claude}"         # minds: override → MESH_MINDS_CMD
command -v codex >/dev/null 2>&1 && keep work 'codex --dangerously-bypass-approvals-and-sandbox'   # work channel = codex
echo "$(ts) channel-keepalive pass done"
