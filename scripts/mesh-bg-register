#!/usr/bin/env bash
# mesh-bg-register — register a detached background task's DELIVERY manifest, so its delivery
# survives the mind's /clear. The mind launches work with `... &`, then IMMEDIATELY registers a
# manifest here; the batch's OWN completion path (not the mind) calls mesh-bg-done to deliver.
# A /clear mid-batch therefore strands NOTHING: the manifest outlives the mind, and mesh-clear
# refuses to /clear while any manifest is running|done-undelivered (the layer-2 backstop).
#
# ── THE SHARED MANIFEST CONTRACT ─────────────────────────────────────────────────────────────
# Path:   ~/.mesh/bg/<window>/<batch>.manifest      (per-window dir; <batch> unique per run)
# Format: one `key=value` per line; value is the rest of the line (may contain `=`, NOT newlines).
# Fields (this is the whole schema — mesh-bg-register writes it, mesh-bg-done flips it,
#         mesh-clear reads it; all three parse these literal keys):
#   window=<mind window>                     e.g. sound
#   batch=<unique batch id>                  e.g. grind-1737051-a1
#   target=<human label of delivery sink>    e.g. operator-TG
#   on-done=<shell cmd run AT batch completion to DELIVER; runs with the mind ABSENT, via bash -c>
#   status=running | done-undelivered | done-nodeliver | delivered
#   pid=<launcher/batch pid, best-effort liveness hint>
#   registered=<epoch>    updated=<epoch>
# status semantics — FIVE states; the gate BLOCKS on `running` and `done-undelivered`,
# PASSES on `delivered`, `done-nodeliver` and `crashed`. ONLY done-undelivered is a "you must clear this" block:
#   running          → batch in flight (BLOCKS)
#   done-undelivered → batch produced output that SHOULD have shipped but delivery has not confirmed
#                      (mind absent + on-done failed/crashed) — retryable, must be resolved (BLOCKS)
#   done-nodeliver   → batch completed with NOTHING to ship: empty/near-empty grind, or killed
#                      (rc 124/75/137) — intentionally nothing to strand (PASSES). Set via
#                      `mesh-bg-done --no-deliver`. WITHOUT this state a routine ear grind or an
#                      OOM-kill would sit done-undelivered and wedge EVERY /clear forever (stale-lease).
#   delivered        → on-done succeeded; nothing to strand (PASSES)
#   crashed          → written by mesh-clear's crash-reap, never by register/done: a `running`
#                      manifest whose pid is DEAD past MESH_BG_CRASH_GRACE (default 300s) died
#                      BEFORE mesh-bg-done ran — no surviving process can deliver, so blocking
#                      /clears forever saves nothing (PASSES, reap is logged loudly)
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
#   mesh-bg-register <window> <batch> --target <t> --on-done <cmd>   write manifest (status=running), print its path
#   mesh-bg-register --path <window> <batch>                         just print the manifest path (no write)
#   mesh-bg-register --test
# orphan-ok: on-demand library tool — a launcher (mesh-sound-reflex &) calls it; not a cron reflex.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
BG_DIR="${MESH_BG_DIR:-$MESH_DIR/bg}"

_slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
_manifest_path() { printf '%s/%s/%s.manifest' "$BG_DIR" "$(_slug "$1")" "$(_slug "$2")"; }

# shared writer — the ONE place the manifest format is emitted. Atomic (temp + mv).
_write_manifest() { # $1=file window batch target ondone status pid registered updated
  local f="$1" window="$2" batch="$3" target="$4" ondone="$5" status="$6" pid="$7" reg="$8" upd="$9"
  mkdir -p "$(dirname "$f")"
  local tmp="$f.tmp.$$"
  {
    printf 'window=%s\n'     "$window"
    printf 'batch=%s\n'      "$batch"
    printf 'target=%s\n'     "$target"
    printf 'on-done=%s\n'    "$ondone"
    printf 'status=%s\n'     "$status"
    printf 'pid=%s\n'        "$pid"
    printf 'registered=%s\n' "$reg"
    printf 'updated=%s\n'    "$upd"
  } > "$tmp" && mv -f "$tmp" "$f"
}

_register() { # $1=window $2=batch $3=target $4=ondone
  local win="$1" batch="$2" target="$3" ondone="$4" f now
  f="$(_manifest_path "$win" "$batch")"
  now="$(date +%s)"
  _write_manifest "$f" "$win" "$batch" "$target" "$ondone" running "$PPID" "$now" "$now"
  printf '%s\n' "$f"
}

_test() {
  local rc=0 td; td="$(mktemp -d)"
  BG_DIR="$td/m/bg"; export MESH_DIR="$td/m" MESH_BG_DIR="$BG_DIR"
  # register writes a running manifest at the contracted path with every field
  local f; f="$(_register sound grind-test-1 operator-TG 'echo delivered >/dev/null')"
  [ "$f" = "$td/m/bg/sound/grind-test-1.manifest" ] || { echo "bg-register-test: FAIL (path not contract: $f)"; rc=1; }
  [ -r "$f" ] || { echo "bg-register-test: FAIL (manifest not written)"; rc=1; }
  grep -qx 'status=running'        "$f" || { echo "bg-register-test: FAIL (status not running)"; rc=1; }
  grep -qx 'window=sound'          "$f" || { echo "bg-register-test: FAIL (window field)"; rc=1; }
  grep -qx 'batch=grind-test-1'    "$f" || { echo "bg-register-test: FAIL (batch field)"; rc=1; }
  grep -qx 'target=operator-TG'    "$f" || { echo "bg-register-test: FAIL (target field)"; rc=1; }
  grep -q  '^on-done=echo delivered' "$f" || { echo "bg-register-test: FAIL (on-done field)"; rc=1; }
  # on-done values may contain '=' — cut -f2- must keep the whole tail
  local f2; f2="$(_register sound grind-eq 'op' 'x=1 mesh-send --k=v')"
  grep -q '^on-done=x=1 mesh-send --k=v' "$f2" || { echo "bg-register-test: FAIL (on-done with = truncated)"; rc=1; }
  # --path prints without writing
  rm -rf "$td/m/bg"
  local p; p="$(BG_DIR="$td/m/bg" _manifest_path room r9)"
  [ ! -e "$p" ] || { echo "bg-register-test: FAIL (--path wrote a file)"; rc=1; }
  rm -rf "$td"
  [ "$rc" = 0 ] && echo "bg-register-test: ok (writes contract path + all fields, status=running, on-done keeps '=', --path is read-only)"
  return "$rc"
}

# ---- arg parse ----
[ "${1:-}" = --test ] && { _test; exit $?; }
if [ "${1:-}" = --path ]; then
  [ $# -eq 3 ] || { echo "usage: mesh-bg-register --path <window> <batch>" >&2; exit 2; }
  _manifest_path "$2" "$3"; exit 0
fi

WIN=""; BATCH=""; TARGET=""; ONDONE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --target)  TARGET="${2:-}"; shift 2 ;;
    --on-done) ONDONE="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,45p' "$0"; exit 0 ;;
    -*) echo "mesh-bg-register: unknown flag $1" >&2; exit 2 ;;
    *) if [ -z "$WIN" ]; then WIN="$1"; elif [ -z "$BATCH" ]; then BATCH="$1"; fi; shift ;;
  esac
done
[ -n "$WIN" ] && [ -n "$BATCH" ] || { echo "usage: mesh-bg-register <window> <batch> --target <t> --on-done <cmd>" >&2; exit 2; }
[ -n "$TARGET" ]  || { echo "mesh-bg-register: --target required (where does delivery go?)" >&2; exit 2; }
[ -n "$ONDONE" ]  || { echo "mesh-bg-register: --on-done required (the delivery command)" >&2; exit 2; }
_register "$WIN" "$BATCH" "$TARGET" "$ONDONE"
