#!/usr/bin/env python3
"""mesh-whisper-filter — three-stage hallucination/silence gate for whisper output.

Sits between whisper.cpp and the mesh command dispatcher. Drop before acting.

Usage:
  mesh-whisper-filter --wav FILE              energy gate only
  mesh-whisper-filter --text TEXT             boilerplate + repetition gate only
  mesh-whisper-filter --wav FILE --text TEXT  all three stages in sequence

Exit:  0 = PASS (act on it)   1 = DROP (discard)   2 = usage error
Stdout: one line — PASS or DROP <reason>

Env overrides:
  MWF_ENERGY       RMS threshold for silence (default 300, 16-bit PCM)
  MWF_MIN_SAMPLES  minimum sample count before energy check (default 3200 = 0.2s@16kHz)
"""
import sys, os, wave, struct, re, math

# ── Stage 1: energy / silence gate ─────────────────────────────────────────
ENERGY_THRESHOLD = int(os.environ.get("MWF_ENERGY", "300"))
MIN_SPEECH_SAMPLES = int(os.environ.get("MWF_MIN_SAMPLES", "3200"))

def wav_rms(path):
    try:
        with wave.open(path, "rb") as wf:
            raw = wf.readframes(wf.getnframes())
        n = len(raw) // 2
        if n == 0:
            return 0, 0
        vals = struct.unpack(f"<{n}h", raw[: n * 2])
        return int(math.sqrt(sum(v * v for v in vals) / n)), n
    except Exception as e:
        return None, str(e)

def check_energy(wav_path):
    rms, meta = wav_rms(wav_path)
    if rms is None:
        return False, f"wav-read-error: {meta}"
    if not isinstance(meta, int):
        return False, f"wav-read-error"
    if meta < MIN_SPEECH_SAMPLES:
        return False, f"too-short ({meta} samples < {MIN_SPEECH_SAMPLES})"
    if rms < ENERGY_THRESHOLD:
        return False, f"silence (RMS {rms} < threshold {ENERGY_THRESHOLD})"
    return True, f"energy OK (RMS {rms})"

# ── Stage 2: boilerplate / known-hallucination drop ─────────────────────────
# Whisper reliably hallucinates these on silence, music, and near-silence inputs.
BOILERPLATE = (
    # subtitle / credits
    "thanks for watching", "thank you for watching",
    "please subscribe", "don't forget to subscribe", "like and subscribe",
    "hit the bell", "see you next time", "see you in the next video",
    "продолжение следует", "субтитры сделаны", "amara.org",
    "редактор субтитров", "переведено", "all rights reserved",
    "background music", "♪", "♫",
    # Japanese subtitle noise
    "ご視聴", "字幕",
    # whisper annotation tokens that slip through stripping
    "[blank_audio]", "[silence]", "[music]", "[applause]", "[laughter]",
    "[no audio]", "(no audio)", "(silence)",
)

def check_boilerplate(text):
    low = re.sub(r"\*[^*]*\*", "", text.lower()).strip()
    for phrase in BOILERPLATE:
        if phrase in low:
            return False, f"boilerplate match: '{phrase}'"
    return True, "boilerplate OK"

# ── Stage 3: repetition / low-entropy gate ──────────────────────────────────

def check_repetition(text):
    # strip annotation noise before analysis
    clean = re.sub(r"\*[^*]*\*|\[[^\]]*\]|\([^)]*\)", "", text).strip()

    # must contain at least one real word (≥2 consecutive alphanum chars)
    if not re.search(r"[0-9A-Za-zА-Яа-яЁё]{2,}", clean):
        return False, "no real word content"

    # single-word repetition: "JANU JANU JANU" or "you you you"
    words = clean.split()
    if len(words) >= 2 and len({w.lower() for w in words}) == 1:
        return False, f"single-word repetition ('{words[0]}')"

    # low character entropy: ≤4 unique chars in a 6+ char string → "JANUJANUJANU"
    collapsed = clean.lower().replace(" ", "")
    if len(collapsed) >= 6 and len(set(collapsed)) <= 4:
        return False, f"low-entropy ({len(set(collapsed))} unique chars in '{collapsed[:20]}')"

    # too short after stripping all noise markers
    if len(clean.replace(" ", "")) < 3:
        return False, f"too short after cleanup ('{clean}')"

    return True, "repetition OK"

# ── Dispatcher ──────────────────────────────────────────────────────────────

def run(wav_path, text):
    if wav_path:
        ok, reason = check_energy(wav_path)
        if not ok:
            print(f"DROP energy: {reason}")
            return 1
    if text is not None:
        ok, reason = check_boilerplate(text)
        if not ok:
            print(f"DROP {reason}")
            return 1
        ok, reason = check_repetition(text)
        if not ok:
            print(f"DROP {reason}")
            return 1
    print("PASS")
    return 0

def main():
    wav_path = text = None
    args = sys.argv[1:]
    if not args:
        print(__doc__); sys.exit(2)
    i = 0
    while i < len(args):
        if args[i] == "--wav" and i + 1 < len(args):
            wav_path = args[i + 1]; i += 2
        elif args[i] == "--text" and i + 1 < len(args):
            text = args[i + 1]; i += 2
        else:
            print(f"unknown arg: {args[i]}", file=sys.stderr); sys.exit(2)
    if wav_path is None and text is None:
        print(__doc__); sys.exit(2)
    sys.exit(run(wav_path, text))

if __name__ == "__main__":
    main()
