#!/usr/bin/env python3
"""mesh-whisper-filter — three-stage hallucination/silence gate for whisper output.

Sits between whisper.cpp and the mesh command dispatcher. Drop before acting.

Usage:
  mesh-whisper-filter --wav FILE              energy gate only
  mesh-whisper-filter --text TEXT             boilerplate + repetition gate only
  mesh-whisper-filter --wav FILE --text TEXT  all three stages in sequence
  mesh-whisper-filter --strip --text TEXT     PRINT cleaned text (strip hallucination tails) — not a gate
  mesh-whisper-filter --test                  smoke test (all three stages, golden inputs)

Exit:  0 = PASS (act on it)   1 = DROP (discard)   2 = usage error
Stdout: one line — PASS or DROP <reason>

Env overrides:
  MWF_ENERGY       RMS threshold for silence (default 300, 16-bit PCM)
  MWF_MIN_SAMPLES  minimum sample count before energy check (default 3200 = 0.2s@16kHz)
"""
import sys, os, wave, struct, re, math

# ── Stage 1: energy / silence gate ─────────────────────────────────────────
ENERGY_THRESHOLD = int(os.environ.get("MWF_ENERGY", "300"))
MIN_SPEECH_SAMPLES = int(os.environ.get("MWF_MIN_SAMPLES", "3200"))

def wav_rms(path):
    try:
        with wave.open(path, "rb") as wf:
            raw = wf.readframes(wf.getnframes())
        n = len(raw) // 2
        if n == 0:
            return 0, 0
        vals = struct.unpack(f"<{n}h", raw[: n * 2])
        return int(math.sqrt(sum(v * v for v in vals) / n)), n
    except Exception as e:
        return None, str(e)

def check_energy(wav_path):
    rms, meta = wav_rms(wav_path)
    if rms is None:
        return False, f"wav-read-error: {meta}"
    if not isinstance(meta, int):
        return False, f"wav-read-error"
    if meta < MIN_SPEECH_SAMPLES:
        return False, f"too-short ({meta} samples < {MIN_SPEECH_SAMPLES})"
    if rms < ENERGY_THRESHOLD:
        return False, f"silence (RMS {rms} < threshold {ENERGY_THRESHOLD})"
    return True, f"energy OK (RMS {rms})"

# ── Stage 2: boilerplate / known-hallucination drop ─────────────────────────
# Whisper reliably hallucinates these on silence, music, and near-silence inputs.
BOILERPLATE = (
    # subtitle / credits
    "thanks for watching", "thank you for watching",
    "please subscribe", "don't forget to subscribe", "like and subscribe",
    "hit the bell", "see you next time", "see you in the next video",
    "продолжение следует", "субтитры сделаны", "amara.org",
    "редактор субтитров", "переведено", "all rights reserved",
    "background music", "♪", "♫",
    # Japanese subtitle noise
    "ご視聴", "字幕",
    # whisper annotation tokens that slip through stripping
    "[blank_audio]", "[silence]", "[music]", "[applause]", "[laughter]",
    "[no audio]", "(no audio)", "(silence)",
)

# all-caps Cyrillic SDH audio-description tags whisper hallucinates on music/noise inputs.
# Confirmed in the live room transcript (operator 2026-07-04 "смотри что получает в транскриптах
# миша - МУЗЫКА МУЗЫКА"): "СПОКОЙНАЯ МУЗЫКА", "ТРЕВОЖНАЯ МУЗЫКА", "ДИНАМИЧНАЯ МУЗЫКА",
# "НАПРЯЖЕННАЯ МУЗЫКА", "ИНТРИГУЮЩАЯ МУЗЫКА", bare "МУЗЫКА", "ТЕЛЕФОННЫЙ ЗВОНОК РАДОСТНЫЙ ЗВОНОК".
# Case-SENSITIVE → never matches real speech (normal case); whisper emits these ALL-CAPS per the
# Russian SDH subtitle convention it was trained on.
_SDH_TAG = re.compile(
    r"(?:[А-ЯЁ]{2,}\s+)*МУЗЫКА"          # <ALL-CAPS ADJ> МУЗЫКА, or bare МУЗЫКА
    r"|(?:[А-ЯЁ]{2,}\s+)*ЗВОНОК"         # ТЕЛЕФОННЫЙ/РАДОСТНЫЙ ЗВОНОК
    r"|АПЛОДИСМЕНТЫ"                     # applause tag
)

def check_boilerplate(text):
    low = re.sub(r"\*[^*]*\*", "", text.lower()).strip()
    for phrase in BOILERPLATE:
        if phrase in low:
            return False, f"boilerplate match: '{phrase}'"
    # a line that is ONLY all-caps SDH audio-description tags (no real speech to act on) → drop.
    # Trailing/embedded SDH tags on REAL speech are handled by strip_hallucinations (--strip), not here.
    if _SDH_TAG.search(text):
        remainder = _SDH_TAG.sub(" ", _INLINE_NOISE.sub(" ", text))
        if not re.search(r"[0-9A-Za-zА-Яа-яЁё]{2,}", remainder):
            return False, "SDH music/audio tag only (no speech)"
    return True, "boilerplate OK"

# ── --strip: clean hallucination TAILS off otherwise-real speech ─────────────
# The gate (PASS/DROP) is all-or-nothing: it would DROP "привет Редактор субтитров А.Семкин"
# (losing real speech) because a credit substring matches. But whisper appends these credits as a
# TRAILING block onto valid speech (chat-review 2026-06-19: 'Редактор субтитров А.Семкин Корректор
# А.Егорова', '[музыка]' tacked onto the operator's words → fed to the tg mind as if he said them).
# strip_hallucinations() PRESERVES the real speech and removes only the known-noise tail/inline tokens.
CREDIT_TAIL = (
    # subtitle-credit markers — only ever TRAIL real speech; cut from first hit to end of string
    "редактор субтитров", "субтитры сделал", "субтитры сделаны", "субтитры подготовил",
    "корректор", "amara.org", "продолжение следует", "переведено", "all rights reserved",
    "thanks for watching", "thank you for watching", "please subscribe",
    "don't forget to subscribe", "like and subscribe", "see you next time", "subscribe",
    "ご視聴", "字幕",
)
_INLINE_NOISE = re.compile(r"\[[^\]]*\]|\([^)]*\)|\*[^*]*\*|[♪♫]")

def strip_hallucinations(text):
    t = _INLINE_NOISE.sub(" ", text)            # drop [музыка]/(silence)/*...*/♪ anywhere
    t = _SDH_TAG.sub(" ", t)                    # drop all-caps SDH tags: СПОКОЙНАЯ МУЗЫКА, ЗВОНОК
    low = t.lower()
    cut = len(t)
    for m in CREDIT_TAIL:                        # cut a trailing credit block from its first marker
        idx = low.find(m)
        if idx != -1:
            cut = min(cut, idx)
    return " ".join(t[:cut].split()).strip()

# ── Stage 3: repetition / low-entropy gate ──────────────────────────────────

def check_repetition(text):
    # strip annotation noise before analysis
    clean = re.sub(r"\*[^*]*\*|\[[^\]]*\]|\([^)]*\)", "", text).strip()

    # must contain at least one real word (≥2 consecutive alphanum chars)
    if not re.search(r"[0-9A-Za-zА-Яа-яЁё]{2,}", clean):
        return False, "no real word content"

    # single-word repetition: "JANU JANU JANU" or "you you you"
    words = clean.split()
    if len(words) >= 2 and len({w.lower() for w in words}) == 1:
        return False, f"single-word repetition ('{words[0]}')"

    # low character entropy: ≤4 unique chars in a 6+ char string → "JANUJANUJANU"
    collapsed = clean.lower().replace(" ", "")
    if len(collapsed) >= 6 and len(set(collapsed)) <= 4:
        return False, f"low-entropy ({len(set(collapsed))} unique chars in '{collapsed[:20]}')"

    # too short after stripping all noise markers
    if len(clean.replace(" ", "")) < 3:
        return False, f"too short after cleanup ('{clean}')"

    return True, "repetition OK"

# ── Dispatcher ──────────────────────────────────────────────────────────────

def run(wav_path, text):
    if wav_path:
        ok, reason = check_energy(wav_path)
        if not ok:
            print(f"DROP energy: {reason}")
            return 1
    if text is not None:
        ok, reason = check_boilerplate(text)
        if not ok:
            print(f"DROP {reason}")
            return 1
        ok, reason = check_repetition(text)
        if not ok:
            print(f"DROP {reason}")
            return 1
    print("PASS")
    return 0

# ── Smoke test ──────────────────────────────────────────────────────────────
# Drives the PRODUCTION run() dispatcher with golden inputs for every stage: a regression
# in any gate either lets hallucinated commands through (acted on!) or drops all real speech.

def smoke_test():
    import tempfile, io, contextlib
    fails = []
    def case(name, expect_rc, wav=None, text=None):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = run(wav, text)
        if rc != expect_rc:
            fails.append(f"{name}: rc={rc} want={expect_rc} out={buf.getvalue().strip()!r}")
    with tempfile.TemporaryDirectory() as td:
        def write_wav(path, amp, n=8000):  # 0.5s @ 16kHz, alternating ±amp
            with wave.open(path, "wb") as wf:
                wf.setnchannels(1); wf.setsampwidth(2); wf.setframerate(16000)
                wf.writeframes(struct.pack(f"<{n}h", *[(amp if i % 2 else -amp) for i in range(n)]))
        silent = os.path.join(td, "silent.wav"); write_wav(silent, 0)
        loud = os.path.join(td, "loud.wav"); write_wav(loud, 8000)
        case("silence-drops", 1, wav=silent)
        case("speech-energy-passes", 0, wav=loud)
        case("boilerplate-drops", 1, text="Thanks for watching!")
        case("sdh-music-only-drops", 1, text="СПОКОЙНАЯ МУЗЫКА")
        case("sdh-bare-music-drops", 1, text="МУЗЫКА")
        case("sdh-phone-ring-drops", 1, text="ТЕЛЕФОННЫЙ ЗВОНОК РАДОСТНЫЙ ЗВОНОК")
        case("sdh-prefixed-real-speech-passes", 0, text="СПОКОЙНАЯ МУЗЫКА включи свет")  # has real speech after
        case("single-word-repetition-drops", 1, text="you you you you")
        case("low-entropy-drops", 1, text="JANUJANUJANU")
        case("annotation-only-drops", 1, text="[BLANK_AUDIO]")
        case("real-text-passes", 0, text="turn on the hallway light")
        case("all-stages-pass", 0, wav=loud, text="status report please")
    # --strip: preserve real speech, remove only hallucination tails + inline noise
    def strip_eq(name, inp, want):
        got = strip_hallucinations(inp)
        if got != want:
            fails.append(f"strip:{name}: got={got!r} want={want!r}")
    strip_eq("credit-tail", "привет как дела Редактор субтитров А.Семкин Корректор А.Егорова",
             "привет как дела")
    strip_eq("inline-music", "включи свет [музыка]", "включи свет")
    strip_eq("clean-untouched", "поверни налево на втором повороте",
             "поверни налево на втором повороте")
    strip_eq("amara-tail", "ok thanks amara.org", "ok thanks")
    # SDH music tags: strip the all-caps tag, KEEP normal-case real speech (even if it says "музыка")
    strip_eq("sdh-trailing-music", "включи свет СПОКОЙНАЯ МУЗЫКА", "включи свет")
    strip_eq("sdh-bare-tail", "привет МУЗЫКА", "привет")
    strip_eq("sdh-normal-case-kept", "я люблю спокойную музыку", "я люблю спокойную музыку")
    if fails:
        print("smoke-test: FAIL (" + "; ".join(fails) + ")"); sys.exit(1)
    print("smoke-test: ok"); sys.exit(0)

def main():
    wav_path = text = None
    strip_mode = False
    args = sys.argv[1:]
    if not args:
        print(__doc__); sys.exit(2)
    if args[0] == "--test":
        smoke_test()
    i = 0
    while i < len(args):
        if args[i] == "--wav" and i + 1 < len(args):
            wav_path = args[i + 1]; i += 2
        elif args[i] == "--text" and i + 1 < len(args):
            text = args[i + 1]; i += 2
        elif args[i] == "--strip":
            strip_mode = True; i += 1
        else:
            print(f"unknown arg: {args[i]}", file=sys.stderr); sys.exit(2)
    if strip_mode:
        # emit the CLEANED text (hallucination tails + inline noise removed), exit 0
        print(strip_hallucinations(text or "")); sys.exit(0)
    if wav_path is None and text is None:
        print(__doc__); sys.exit(2)
    sys.exit(run(wav_path, text))

if __name__ == "__main__":
    main()
