#!/usr/bin/env bash
# mesh-phone-watch — restart Termux sshd via ADB when MIUI kills it.
# ADB is a SYSTEM daemon MIUI can't kill; sshd is a Termux app MIUI can and does kill.
# This reflex closes the gap: checks every run whether sshd is listening on PHONE_SSH_PORT;
# if not, fires the Termux RunCommandService broadcast to restart it without any operator tap.
# Exit 0 = ok (was already up or restarted); 2 = phone ADB not connected (can't assess).
#
# reflex-cadence: */10 * * * *
# Wired so the phone is "always online when home" (operator 2026-06-17): every 10 min, re-assert
# Termux sshd over the unkillable ADB daemon. SAFE off-LAN: when the phone is away, ADB isn't
# connected → exit 2 (n/a, no-op), never a false alarm. mesh-autowire picks this up after --test.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
HOST="$(hostname)"

# Termux RunCommandService broadcast that restarts sshd (no tap, no password). Defined ONCE so the
# --test self-check validates the SAME string the reflex actually fires (no test/code drift).
PHONE_SSHD_PATH="/data/data/com.termux/files/usr/bin/sshd"
TERMUX_BCAST="am broadcast -a com.termux.app.RUN_COMMAND --es com.termux.app.RUN_COMMAND_PATH '${PHONE_SSHD_PATH}' --ez com.termux.app.RUN_COMMAND_BACKGROUND true -n com.termux/.app.RunCommandService"

# --- BODY ANCHOR: don't waste a caught contact window on a flapping phone ---
# On EVERY successful ssh contact (LAN-direct, ADB-forward, or post-restart), spend the SAME
# session anchoring the body so the flap converts into longer uptime:
#   (1) termux-wake-lock — doze is one of the two sshd killers. Battery-gated: only when charging
#       or >40% (a wake-lock drains an unplugged battery); unknown battery = skip, honestly said.
#   (2) idempotent in-Termux respawn loop ('pgrep sshd || sshd' every 60s) — survives sshd DEATH.
#       Idempotence via pidfile + kill -0, NOT pgrep-by-name (the ssh payload's own cmdline
#       contains the anchor name → pgrep -f would self-match and never plant).
#   (3) Termux:Boot script presence check — report honest-missing, never fake-durable.
# HONEST LIMITS: MIUI app-kill still kills Termux wholesale (loop included); ADB re-pair +
# Termux:Boot remain the durable fix (operator hands). Anchor is BEST-EFFORT: it never changes
# the watch verdict/exit code. The battery gate is ONE string shared by the live payload and the
# --test fixtures (no test/code drift).
ANCHOR_GATE='if [ -n "${pct:-}" ] && { [ "${plug:-UNPLUGGED}" != "UNPLUGGED" ] || [ "$pct" -gt 40 ]; }; then echo ok; else echo skip; fi'

anchor_payload() {
  # Remote sh script (Termux side). <<'PAYLOAD' = zero local expansion; __GATE__ is substituted
  # from ANCHOR_GATE below. Inner single quotes keep $$/$HOME for the REMOTE write-time shell.
  local p
  p=$(cat <<'PAYLOAD'
batt=$(termux-battery-status 2>/dev/null)
pct=$(printf '%s' "$batt" | sed -n 's/.*"percentage": *\([0-9][0-9]*\).*/\1/p')
plug=$(printf '%s' "$batt" | sed -n 's/.*"plugged": *"\([A-Z_]*\)".*/\1/p')
gate=$(__GATE__)
if [ "$gate" = ok ]; then
  termux-wake-lock 2>/dev/null && echo "anchor:wake-lock=held (batt=${pct:-?}% plug=${plug:-?})" \
    || echo "anchor:wake-lock=FAILED (termux-api missing?)"
else
  echo "anchor:wake-lock=skipped (batt=${pct:-?}% plug=${plug:-?} — held only when charging or >40%)"
fi
apid=$(cat "$HOME/.mesh-sshd-anchor.pid" 2>/dev/null)
if [ -n "$apid" ] && kill -0 "$apid" 2>/dev/null; then
  echo "anchor:respawn-loop=already-running (pid $apid)"
else
  {
    echo '#!/data/data/com.termux/files/usr/bin/sh'
    echo '# mesh-sshd-anchor — respawn sshd if it DIES (survives sshd death, NOT MIUI app-kill)'
    echo 'echo $$ > "$HOME/.mesh-sshd-anchor.pid"'
    echo 'while :; do pgrep sshd >/dev/null 2>&1 || sshd; sleep 60; done'
  } > "$HOME/.mesh-sshd-anchor" && chmod +x "$HOME/.mesh-sshd-anchor" \
    && nohup "$HOME/.mesh-sshd-anchor" >/dev/null 2>&1 </dev/null &
  echo "anchor:respawn-loop=planted"
fi
if [ -n "$(ls -A "$HOME/.termux/boot" 2>/dev/null)" ]; then
  echo "anchor:termux-boot=present"
else
  echo "anchor:termux-boot=MISSING — durable fix needs operator (Termux:Boot app + boot script)"
fi
PAYLOAD
)
  # NB: replacement MUST stay quoted — bash 5.2 patsub_replacement expands a bare & in the
  # replacement to the matched pattern (the gate's && became __GATE____GATE__; --test caught it).
  printf '%s\n' "${p/__GATE__/"$ANCHOR_GATE"}"
}

anchor_body() { # <port> <host> — best-effort anchor over an already-proven ssh path
  local port="$1" host="$2" out
  local puser="${PUSER:-${PHONE_USER:-u0_a380}}"
  local ssho="${SSHO:--o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=6}"
  if [ -n "${MESH_TEST_SANDBOX:-}" ]; then
    echo "[phone-watch] anchor SANDBOX — would anchor ${puser}@${host}:${port} (wake-lock gate + respawn loop + boot check; NO ssh sent)"
    return 0
  fi
  out="$(timeout 25 ssh $ssho -p "$port" "${puser}@${host}" "$(anchor_payload)" 2>/dev/null)" || true
  [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/[phone-watch] /'
  return 0
}

# --test: dependency + dry-run self-check. Touches NO phone, sends NO broadcast. The load-bearing
# assertion is the adb dep: FAILs (exit 1) when adb is absent, PASSes when present — because the
# whole tool is an adb wrapper, a missing adb means the reflex is silently dead (the green-but-dead
# class mesh-reflex-health hunts). Prove both: `bash mesh-phone-watch --test` (PASS, adb on PATH);
# `env -i PATH=/usr/bin bash mesh-phone-watch --test` (FAIL, adb hidden).
if [ "${1:-}" = --test ]; then
  fail=0
  if command -v adb >/dev/null 2>&1; then
    echo "  ok: adb present ($(command -v adb))"
  else
    echo "  FAIL: adb not on PATH — mesh-phone-watch cannot probe/restart phone sshd (reflex is dead)"; fail=1
  fi
  command -v ssh >/dev/null 2>&1 && echo "  ok: ssh present (verifies sshd via the reliable ADB-forward channel)" \
    || { echo "  FAIL: ssh missing — sshd liveness check would break"; fail=1; }
  # dry-run: the REAL broadcast string must carry BOTH the service component and the sshd exec path
  # (order-independent — the path precedes the -n component in the actual command).
  if case "$TERMUX_BCAST" in *"-n com.termux/.app.RunCommandService"*) true;; *) false;; esac \
     && case "$TERMUX_BCAST" in *"${PHONE_SSHD_PATH}"*) true;; *) false;; esac; then
    echo "  ok: broadcast well-formed (service component + sshd path; dry, NOT sent)"
  else
    echo "  FAIL: broadcast string malformed — restart would no-op"; fail=1
  fi
  # ANCHOR asserts (all offline — no phone, no ssh):
  # battery gate fixtures — the SAME string the remote payload runs (falsify: flip -gt to -lt).
  [ "$(pct=35  plug=UNPLUGGED  sh -c "$ANCHOR_GATE")" = skip ] || { echo "  FAIL: gate 35%/unplugged → expected skip (wake-lock would drain)"; fail=1; }
  [ "$(pct=41  plug=UNPLUGGED  sh -c "$ANCHOR_GATE")" = ok   ] || { echo "  FAIL: gate 41%/unplugged → expected ok"; fail=1; }
  [ "$(pct=35  plug=PLUGGED_AC sh -c "$ANCHOR_GATE")" = ok   ] || { echo "  FAIL: gate 35%/charging → expected ok (charging overrides level)"; fail=1; }
  [ "$(pct=''  plug=''         sh -c "$ANCHOR_GATE")" = skip ] || { echo "  FAIL: gate unknown battery → expected skip (never hold blind)"; fail=1; }
  echo "  ok: battery gate fixtures (skip@35%unplugged / ok@41% / ok@charging / skip@unknown)"
  # payload well-formed: every anchor leg present, gate actually substituted in.
  ap="$(anchor_payload)"
  case "$ap" in *termux-wake-lock*) : ;; *) echo "  FAIL: payload lacks termux-wake-lock"; fail=1 ;; esac
  case "$ap" in *'.mesh-sshd-anchor.pid'*) : ;; *) echo "  FAIL: payload lacks pidfile idempotence guard"; fail=1 ;; esac
  case "$ap" in *'kill -0'*) : ;; *) echo "  FAIL: payload lacks kill -0 liveness check"; fail=1 ;; esac
  case "$ap" in *nohup*) : ;; *) echo "  FAIL: payload lacks nohup respawn plant"; fail=1 ;; esac
  case "$ap" in *'.termux/boot'*) : ;; *) echo "  FAIL: payload lacks Termux:Boot presence check"; fail=1 ;; esac
  case "$ap" in *__GATE__*) echo "  FAIL: payload still carries __GATE__ placeholder (gate NOT substituted)"; fail=1 ;; *) : ;; esac
  echo "  ok: anchor payload well-formed (wake-lock + pidfile guard + respawn + boot check, gate substituted)"
  # sandbox: anchor_body under MESH_TEST_SANDBOX must not ssh (returns before the ssh line).
  sb="$(MESH_TEST_SANDBOX=1 anchor_body 8022 192.0.2.1)"
  case "$sb" in *SANDBOX*) echo "  ok: anchor_body sandbox-gated (no ssh under MESH_TEST_SANDBOX)" ;; *) echo "  FAIL: anchor_body ignored MESH_TEST_SANDBOX"; fail=1 ;; esac
  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL (missing dep)"; exit 1; }
fi

# Transport check via `adb get-state` rc — NOT `adb devices` parsing. On this Redmi's Android-13
# Wireless-Debugging adb state, `adb devices` lists NOTHING (cosmetically empty) while `adb forward`
# + ssh work perfectly (verified 2026-06-18: the collector drains every 10 min via forward with zero
# failures). The old `adb devices | awk` parse therefore ALWAYS found no device → permanent false
# "ADB not connected" exit-2: the watchdog was dead-on-arrival (every log line "cannot check sshd").
# `adb get-state` returns rc=0 when a device is attached (empty string here, but the rc is what the
# working collector keys off) and rc!=0 when the phone is away → clean, real away-detection.
if ! adb get-state >/dev/null 2>&1; then
  # ADB transport down does NOT mean "phone away" — that conflates two distinct states (honest-fusion /
  # von Foerster: the observer reports what its ONE channel can't see as the world being empty). The
  # phone can be PRESENT on LAN (new DHCP lease, ADB unpaired/endpoint moved) while ADB is down. Probe
  # the LAN directly to tell them apart, and use the off-Tailscale LAN sshd path the mesh actually uses
  # when ADB is unavailable (memory: reach Redmi via LAN :8022 while Tailscale is offline).
  lan_ip=""
  for cand in ${PHONE_LAN_IPS:-}; do
    if ping -c1 -W2 "$cand" >/dev/null 2>&1; then lan_ip="$cand"; break; fi
  done
  if [ -z "$lan_ip" ]; then
    echo "[phone-watch] phone AWAY — ADB transport down AND not reachable on any PHONE_LAN_IPS (${PHONE_LAN_IPS:-none})"; exit 2
  fi
  # Phone IS present on LAN. Check sshd DIRECTLY on the live LAN IP (bypasses ADB entirely).
  # Fast TCP precheck first: a CLOSED port already proves sshd is down (no need to wait out ssh's
  # connect timeout); only when the port is OPEN do we ssh to confirm it's genuinely sshd answering.
  PUSER="${PHONE_USER:-u0_a380}"
  SSHO="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=6"
  if timeout 3 bash -c "exec 3<>/dev/tcp/${lan_ip}/${PHONE_PORT}" 2>/dev/null \
     && timeout 8 ssh $SSHO -p "$PHONE_PORT" "${PUSER}@${lan_ip}" 'echo ok' >/dev/null 2>&1; then
    echo "[phone-watch] sshd ok — reachable directly on LAN (${lan_ip}:${PHONE_PORT}); ADB transport down but phone USABLE via LAN"
    anchor_body "$PHONE_PORT" "$lan_ip"
    exit 0
  fi
  # Present on LAN, but BOTH ADB and sshd are down. This is OPERATOR-actionable (distinct from "away"):
  # auto-restart needs ADB (which is down), so the mesh cannot self-heal it — surface the precise state.
  echo "[phone-watch] phone PRESENT on LAN (${lan_ip}) but ADB transport AND sshd (:${PHONE_PORT}) both down — cannot auto-restart (ADB needed); operator: start Termux sshd or re-pair wireless-debugging"
  exit 3
fi

# sshd liveness via the RELIABLE forward+ssh channel. This device's `adb shell` swallows stdout and
# its in-shell `ss` doesn't show the listening :8022 socket even when sshd IS up — so the old
# in-shell port check was doubly broken. A successful ssh through the forward IS the proof sshd lives.
ADB_LP="${MESH_PHONE_ADB_LPORT:-8023}"
PUSER="${PHONE_USER:-u0_a380}"
SSHO="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8"
sshd_up(){ adb forward tcp:"$ADB_LP" tcp:"$PHONE_PORT" >/dev/null 2>&1
           timeout 10 ssh $SSHO -p "$ADB_LP" "${PUSER}@127.0.0.1" 'echo ok' >/dev/null 2>&1; }

if sshd_up; then
  echo "[phone-watch] sshd ok (:${PHONE_PORT} reachable via ADB forward)"
  anchor_body "$ADB_LP" "127.0.0.1"
  exit 0
fi

# sshd unreachable but ADB transport up → fire the Termux RunCommandService broadcast to restart it.
# `adb shell` swallows stdout on this device, but `am broadcast` is fire-and-forget and still
# EXECUTES (the missing output is cosmetic) — we verify the outcome via the reliable ssh channel,
# not the broken in-shell ss. (no -s: single attached device, plain `adb shell` targets it.)
echo "[phone-watch] sshd NOT reachable on :${PHONE_PORT} — restarting via ADB broadcast"
adb shell "$TERMUX_BCAST" >/dev/null 2>&1 || true
sleep 4
if sshd_up; then
  echo "[phone-watch] sshd restarted ok (verified via ssh)"
  anchor_body "$ADB_LP" "127.0.0.1"
  MESH_WHO="phone-watch@${HOST}" "${HOME}/.local/bin/mesh-chat" "[phone-watch] sshd auto-restarted via ADB (MIUI had killed it)" 2>/dev/null || true
else
  echo "[phone-watch] restart did not bring sshd back — may need reboot/operator (adb shell degraded on this device)"; exit 1
fi
