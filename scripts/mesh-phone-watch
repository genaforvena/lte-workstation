#!/usr/bin/env bash
# mesh-phone-watch — restart Termux sshd via ADB when MIUI kills it.
# ADB is a SYSTEM daemon MIUI can't kill; sshd is a Termux app MIUI can and does kill.
# This reflex closes the gap: checks every run whether sshd is listening on PHONE_SSH_PORT;
# if not, fires the Termux RunCommandService broadcast to restart it without any operator tap.
# Exit 0 = ok (was already up or restarted); 2 = phone ADB not connected (can't assess).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
HOST="$(hostname)"

# Find ADB device for the phone (prefer env override, else grep devices list for LAN IP pattern)
_adb=""
if [ -n "${MESH_PHONE_ADB:-}" ]; then
  _adb="$MESH_PHONE_ADB"
else
  _adb="$(adb devices 2>/dev/null | awk '/^192\.168\./{print $1; exit}')"
fi

if [ -z "$_adb" ]; then
  echo "[phone-watch] ADB not connected to phone — cannot check sshd"; exit 2
fi

# Check if sshd is already listening
if adb -s "$_adb" shell "ss -tlnp 2>/dev/null | grep -q ':${PHONE_PORT}'" 2>/dev/null; then
  echo "[phone-watch] sshd ok (:${PHONE_PORT} listening via $_adb)"; exit 0
fi

# Not listening — restart via Termux RunCommandService broadcast (no password, no tap needed)
echo "[phone-watch] sshd NOT on :${PHONE_PORT} — restarting via ADB broadcast"
adb -s "$_adb" shell "am broadcast -a com.termux.app.RUN_COMMAND \
  --es com.termux.app.RUN_COMMAND_PATH '/data/data/com.termux/files/usr/bin/sshd' \
  --ez com.termux.app.RUN_COMMAND_BACKGROUND true \
  -n com.termux/.app.RunCommandService" 2>/dev/null || true
sleep 3
if adb -s "$_adb" shell "ss -tlnp 2>/dev/null | grep -q ':${PHONE_PORT}'" 2>/dev/null; then
  echo "[phone-watch] sshd restarted ok"
  MESH_WHO="phone-watch@${HOST}" "${HOME}/.local/bin/mesh-chat" "[phone-watch] sshd auto-restarted via ADB (MIUI had killed it)" 2>/dev/null || true
else
  echo "[phone-watch] restart failed — ADB connected but Termux RunCommandService not responding"; exit 1
fi
