#!/usr/bin/env bash
# mesh-devto-comments — poll dev.to for NEW comments on my published articles, ping the operator
#   + wake the pub channel. READ-ONLY: the dev.to public API has NO write-comment endpoint
#   (POST /api/comments → 404, verified 2026-07-17), and a reply is the operator's identity
#   anyway — so this WATCHES; drafts go to the operator, he posts. Twin of mesh-reddit-watch.
#
# Why this exists: pub-dash's RIGHT pane shows only a per-article comment COUNT, and the reflex
# it claims "WAKES the pub mind" (notify-new-comments.sh) never existed on disk and was in no
# crontab — a declared-but-unarmed organ. So a real comment from @topstar_ai sat unanswered on
# "mtime is not a claim" for 2 days (2026-07-15 → 17) while pub wasn't looking. A count blip on a
# dash is not a wake. (operator 2026-07-17: "you have comments and are not even watching them.")
#
#   mesh-devto-comments          one poll pass (cron-wired)
#   mesh-devto-comments --test   smoke test (parses a fixture + REAL API read; sends NO Telegram)
#   mesh-devto-comments --list   show every article's comments now (no state change, no ping)
#
# Config:  ~/.mesh/devto.env  (DEVTO_API_KEY=... — never echoed). Watch target is DYNAMIC:
#   every article /articles/me/published returns. No conf file — the target is "my articles",
#   which exist as long as the key does. Comments authored by ME are never notified.
# State:   ~/.mesh/.devto-comments/seen    — comment id_codes already reported (one per line).
#          ~/.mesh/.devto-comments/.pulse  — mtime = ran-live (liveness-touch convention).
# reflex-cadence: */15 * * * *
# doctor-artifact: $HOME/.mesh/.devto-comments/.pulse 2700 net
# Exit: 0 = ok (polled ≥1 article); 2 = n/a (no key, or API unreachable — honest, never a faked
#   all-clear: a silent watch that can't reach dev.to says n/a, it does not report "no comments").
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

ENVF="${MESH_DEVTO_ENV:-$HOME/.mesh/devto.env}"
STATE="$HOME/.mesh/.devto-comments"
SEEN="$STATE/seen"
PULSE="$STATE/.pulse"
API="https://dev.to/api"

usage(){ sed -n '2,/^set -/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# --- parser: dev.to /comments JSON (nested children) on stdin -> one flat line per comment:
#     "id_code<TAB>username<TAB>name<TAB>created_at<TAB>text" (text collapsed, tags stripped) ---
# NB: python source in a -c VARIABLE (not a heredoc) so stdin stays the JSON, not the script.
read -r -d '' PARSE_PY <<'PY'
import sys, json, re, html
def strip(h):
    return re.sub(r'\s+', ' ', re.sub('<[^>]+>', ' ', html.unescape(h or ''))).strip()
def walk(c):
    u = c.get('user', {}) or {}
    print("\t".join([
        c.get('id_code', ''), u.get('username', '?'), u.get('name', '?'),
        c.get('created_at', '?'), strip(c.get('body_html', ''))]))
    for ch in c.get('children', []) or []:
        walk(ch)
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(3)
if not isinstance(data, list):
    sys.exit(3)
for c in data:
    walk(c)
PY
parse_comments() { python3 -c "$PARSE_PY"; }

read -r -d '' ARTS_PY <<'PY'
import sys, json
try:
    a = json.load(sys.stdin)
except Exception:
    sys.exit(3)
if not isinstance(a, list):
    sys.exit(3)
for x in a:
    print("\t".join([str(x.get('id', '')), str(x.get('comments_count', 0)), (x.get('title') or '')[:70]]))
PY

api_get() { curl -s -m 20 -H "api-key: $DEVTO_API_KEY" "$API/$1"; }
# my published articles -> "id<TAB>comments_count<TAB>title" per line
my_articles() { api_get "articles/me/published?per_page=100" | python3 -c "$ARTS_PY"; }

if [ "${1:-}" = "--test" ]; then
  # 1) parser: nested-children JSON -> flat, tags stripped, entities unescaped
  fx='[{"id_code":"aa1","created_at":"2026-07-15T18:39:47Z","body_html":"<p>top &amp; level</p>",
        "user":{"username":"luis","name":"Luis"},
        "children":[{"id_code":"bb2","created_at":"2026-07-15T19:00:00Z","body_html":"a <b>reply</b>",
                     "user":{"username":"me","name":"Me"},"children":[]}]}]'
  out="$(printf '%s' "$fx" | parse_comments)" || { echo "smoke-test: FAIL (parser rc)"; exit 1; }
  printf '%s' "$out" | grep -q $'aa1\tluis\tLuis\t2026-07-15T18:39:47Z\ttop & level' \
    || { echo "smoke-test: FAIL (top-level parse: $out)"; exit 1; }
  printf '%s' "$out" | grep -q $'bb2\tme\tMe\t.*\ta reply' \
    || { echo "smoke-test: FAIL (nested child not walked: $out)"; exit 1; }
  # 2) REAL-READ gate (doctrine: a --test that only exercises the pure parser is not a gate —
  #    it must assert the live organ produces). No key / unreachable API => honest n/a (exit 2),
  #    NOT a green pass. This is the axis that was missing everywhere pub thought it was watching.
  [ -f "$ENVF" ] || { echo "smoke-test: n/a — no $ENVF (no DEVTO_API_KEY on $(hostname)); parser sound, node has no key"; exit 2; }
  set -a; . "$ENVF"; set +a
  [ -n "${DEVTO_API_KEY:-}" ] || { echo "smoke-test: n/a — DEVTO_API_KEY empty in $ENVF"; exit 2; }
  arts="$(my_articles)" || { echo "smoke-test: n/a — dev.to API unreachable (my_articles rc)"; exit 2; }
  [ -n "$arts" ] || { echo "smoke-test: n/a — API reachable but returned no published articles"; exit 2; }
  n=$(printf '%s\n' "$arts" | grep -c .)
  echo "smoke-test: ok (nested-comment parse: id+user+unescaped text, children walked) + real-read gate ($n published articles readable via live API)"
  exit 0
fi

[ -f "$ENVF" ] || { echo "mesh-devto-comments: no $ENVF — need DEVTO_API_KEY (n/a)" >&2; exit 2; }
# shellcheck disable=SC1090
set -a; . "$ENVF"; set +a
[ -n "${DEVTO_API_KEY:-}" ] || { echo "mesh-devto-comments: DEVTO_API_KEY empty (n/a)" >&2; exit 2; }
ME="${DEVTO_USERNAME:-ilya_mozerov_867dbdd91feb}"

# --reply <article-id> <parent-cid> "text": post a reply through the shared BROWSER ORGAN.
#   dev.to has NO write-comment API (POST /api/comments → 404, verified 2026-07-17), so the ONLY
#   way to comment as us is a logged-in web session. mesh-browse --state ~/.mesh/browser/devto.json
#   carries that ONE-TIME operator login (any mind then acts as us). Resolve the comment permalink
#   from its author (the id_code alone doesn't give the URL), drive the reply form, then re-read the
#   page and VERIFY our text landed — never claim posted without the artifact.
#
#   ⚠ UNVERIFIED SCAFFOLD until (a) a real devto.json login exists AND (b) the reply selectors are
#   confirmed against the live logged-in DOM. The reply act-steps are a best reading of dev.to's
#   markup and are OVERRIDABLE via MESH_DEVTO_REPLY_STEPS ({TEXT} = the reply body) so they can be
#   corrected without a code change once seen live (%TEXT% = the reply body). --dry-run resolves+
#   prints without driving.
resolve_permalink(){ # $1=article_id $2=parent_cid -> the comment permalink URL (author-scoped)
  api_get "comments?a_id=$1" | TGT="$2" python3 -c '
import sys, json, os
tgt = os.environ["TGT"]
def walk(c):
    if c.get("id_code") == tgt:
        return (c.get("user", {}) or {}).get("username")
    for ch in c.get("children") or []:
        r = walk(ch)
        if r: return r
    return None
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(3)
for c in data if isinstance(data, list) else []:
    u = walk(c)
    if u:
        print(f"https://dev.to/{u}/comment/{tgt}"); break
'
}
if [ "${1:-}" = "--reply" ]; then
  shift
  dry=0; [ "${1:-}" = "--dry-run" ] && { dry=1; shift; }
  raid="${1:-}"; pcid="${2:-}"; rtext="${3:-}"
  { [ -n "$raid" ] && [ -n "$pcid" ] && [ -n "$rtext" ]; } \
    || { echo "usage: mesh-devto-comments --reply [--dry-run] <article-id> <parent-cid> \"text\"" >&2; exit 2; }
  command -v mesh-browse >/dev/null 2>&1 || { echo "mesh-devto-comments: mesh-browse organ absent (n/a)" >&2; exit 2; }
  STATEF="${MESH_DEVTO_BROWSER_STATE:-$HOME/.mesh/browser/devto.json}"
  url="$(resolve_permalink "$raid" "$pcid")"
  [ -n "$url" ] || { echo "mesh-devto-comments: cannot resolve comment $pcid on article $raid (not found / API n/a)" >&2; exit 2; }
  # the act DSL splits steps on ';' then shlex-splits each — so the reply body cannot carry a raw ';'
  # (would split into two steps); collapse it to ',' defensively and quote for spaces. Documented limit.
  safe="${rtext//;/,}"; safe="${safe//\"/\'}"
  steps_tpl="${MESH_DEVTO_REPLY_STEPS:-click button[id^=reply-to-]; waitfor textarea 8000; fill textarea \"%TEXT%\"; click button[type=submit]; wait 3000}"
  steps="${steps_tpl//%TEXT%/$safe}"
  if [ "$dry" = 1 ]; then
    echo "resolved permalink: $url"
    echo "session state:      $STATEF ($( [ -s "$STATEF" ] && echo present || echo MISSING-needs-login ))"
    echo "would run: mesh-browse --state $STATEF '$url' --act '$steps'"
    exit 0
  fi
  [ -s "$STATEF" ] || { echo "mesh-devto-comments: no logged-in session at $STATEF — a ONE-TIME operator dev.to login is required first (mesh-browse --state $STATEF https://dev.to/enter --act '...' or an interactive login)" >&2; exit 2; }
  out="$(mesh-browse --state "$STATEF" "$url" --act "$steps" 2>&1)"; brc=$?
  echo "$out"
  probe="$(printf '%s' "$rtext" | head -c 40)"
  if [ "$brc" = 0 ] && printf '%s' "$out" | grep -qF "$probe"; then
    echo "mesh-devto-comments: reply VERIFIED — posted text present on the resulting page"
    exit 0
  fi
  echo "mesh-devto-comments: reply UNVERIFIED — posted text NOT found on the resulting page (check login + reply selectors; override MESH_DEVTO_REPLY_STEPS)" >&2
  exit 1
fi

arts="$(my_articles)" || { echo "mesh-devto-comments: dev.to API unreachable (n/a)" >&2; exit 2; }
[ -n "$arts" ] || { echo "mesh-devto-comments: no published articles / API returned empty (n/a)" >&2; exit 2; }

# --pending: compact worklist of comments that OWE a reply — a top-level comment by someone
#   other than ME with NO descendant authored by ME. This is the reply-owed surface the pub
#   dash shows: not a count, but WHO said WHAT and whether we've answered. No state change, no
#   ping. Output: "@user · title · [cid] · created<NL>    text…" per owed comment; silent if none.
if [ "${1:-}" = "--pending" ]; then
  read -r -d '' PENDING_PY <<'PY'
import sys, json, re, html, os
ME = os.environ.get("ME", "")
def strip(h):
    return re.sub(r'\s+', ' ', re.sub('<[^>]+>', ' ', html.unescape(h or ''))).strip()
def me_in_subtree(c):
    if (c.get('user', {}) or {}).get('username') == ME:
        return True
    return any(me_in_subtree(ch) for ch in (c.get('children') or []))
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(3)
if not isinstance(data, list):
    sys.exit(3)
for c in data:
    u = c.get('user', {}) or {}
    if u.get('username') == ME:          # my own top-level comment — nothing owed
        continue
    if any(me_in_subtree(ch) for ch in (c.get('children') or [])):  # I already replied below
        continue
    print("\t".join([c.get('id_code', ''), u.get('username', '?'),
                     c.get('created_at', '?'), strip(c.get('body_html', ''))]))
PY
  owed=0
  while IFS=$'\t' read -r aid cc title; do
    [ "${cc:-0}" -gt 0 ] 2>/dev/null || continue
    pend="$(api_get "comments?a_id=$aid" | ME="$ME" python3 -c "$PENDING_PY")" || continue
    [ -n "$pend" ] || continue
    owed=1
    while IFS=$'\t' read -r cid user created text; do
      [ -n "$cid" ] || continue
      echo "@$user · ${title:0:44} · [$cid] · ${created%T*}"
      echo "    ${text:0:180}"
    done <<< "$pend"
  done <<< "$arts"
  [ "$owed" = 1 ] || echo "no comments owe a reply"
  exit 0
fi

# --list: dump every comment now, no state change, no ping (operator on-demand view)
if [ "${1:-}" = "--list" ]; then
  while IFS=$'\t' read -r aid cc title; do
    [ "${cc:-0}" -gt 0 ] 2>/dev/null || continue
    echo "── [$aid] $title  ($cc comments) ──"
    api_get "comments?a_id=$aid" | parse_comments | while IFS=$'\t' read -r cid user name created text; do
      [ -n "$cid" ] || continue
      echo "  @$user ($name) $created  [$cid]"
      echo "     ${text:0:400}"
    done
  done <<< "$arts"
  exit 0
fi

mkdir -p "$STATE"
baseline=0; [ -f "$SEEN" ] || baseline=1     # first-ever run: record existing, ping on NONE
touch "$SEEN"
any_ok=0
while IFS=$'\t' read -r aid cc title; do
  [ -n "$aid" ] || continue
  any_ok=1                                    # reached & parsed the article list = a live poll
  [ "${cc:-0}" -gt 0 ] 2>/dev/null || continue
  comments="$(api_get "comments?a_id=$aid")" || continue
  entries="$(printf '%s' "$comments" | parse_comments)" || continue
  [ -n "$entries" ] || continue
  while IFS=$'\t' read -r cid user name created text; do
    [ -n "$cid" ] || continue
    grep -qxF "$cid" "$SEEN" && continue       # already reported
    echo "$cid" >> "$SEEN"
    [ "$baseline" = 1 ] && continue            # baseline pass — record only, no ping
    [ "$user" = "$ME" ] && continue            # my own comment/reply — never notify on self
    url="https://dev.to/$user/comment/$cid"
    msg="[dev.to] new comment on \"$title\"
by @$user ($name) · $created
$url

${text:0:600}

(read-only watch — replies are your dev.to identity + the API has no write endpoint. reply here and I'll draft.)"
    if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
      echo "mesh-devto-comments: SANDBOX — would notify: $cid (@$user)" >&2
    else
      mesh-tg "$msg" >/dev/null 2>&1 || echo "$msg" >> "$HOME/.mesh/devto-comments-pending.log"
      # wake the pub channel too (chat is where pub looks): a finding gets its own marker
      mesh-chat "[fyi] dev.to comment on \"$title\" by @$user — $url — needs a reply (draft owed)" >/dev/null 2>&1 || true
    fi
  done <<< "$entries"
done <<< "$arts"

# liveness-touch: mtime = ran-live (always), so the mtime-aging watchdogs read a long-quiet
# comment section as ALIVE, not STALE. A dead cron never runs → never touches → honest-STALE.
touch "$PULSE" 2>/dev/null
[ "$any_ok" = 1 ] && exit 0 || exit 2
