#!/usr/bin/env bash
# mesh-net-drop — kernel softnet drop sense from /proc/net/softnet_stat
# Reads the kernel's per-CPU network processing stats — zero subprocesses, instant.
# reflex-cadence: */5 * * * *
# reflex-args: --edge
#
# Usage:
#   mesh-net-drop            one-shot verdict to stdout
#   mesh-net-drop --edge     only emit on state change (for cron wiring)
#   mesh-net-drop --json     machine-readable JSON
#   mesh-net-drop --test     smoke test
#
# Signals perceived (from /proc/net/softnet_stat):
#   processed    total packets processed by softnet
#   dropped      packets dropped (budget exhausted or backlog full)
#   time_squeeze times CPU ran out of budget (had to reschedule)
#
# Columns in /proc/net/softnet_stat (hex, per-CPU):
#   col1: processed   col2: dropped   col3: time_squeeze
#
# Classification (4 levels):
#   HEALTHY    = 0 drops
#   STRESSED   = drops > 0 but < 0.1% of processed (minor congestion)
#   DEGRADED   = drops ≥ 0.1% of processed (network stack falling behind)
#   CRITICAL   = drops ≥ 1% of processed (significant packet loss)
#   UNCERTAIN  = /proc unreadable
#
# Why this matters: mesh-net-io sees bytes flowing, mesh-socket-state sees connections.
# mesh-net-drop sees whether the kernel is DROPPING packets — the network stack's
# honest self-assessment. Drops mean the machine can't keep up with traffic.
#
# Exit codes:
#   0 = posture assessed
#   2 = cannot read /proc/net/softnet_stat

set -euo pipefail
{ "$HOME/.local/bin/mesh-pulse" beat net-drop; } >/dev/null 2>&1 || true  # liveness heartbeat (mesh-pulse): edge reflex is silent-on-no-news → needs an explicit per-run pulse

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.net-drop"
PENDING="$STATE_DIR/.net-drop.pending"
MODE="oneshot"
EDGE_WINDOW=2

for arg in "$@"; do
  case "$arg" in
    --edge) MODE=edge ;;
    --json) MODE=json ;;
    --test) MODE=test ;;
  esac
done

mkdir -p "$STATE_DIR"

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- Test mode ---
if [ "$MODE" = "test" ]; then
  (
    set +e
    # Test classification
    classify() {
      local proc="$1" drop="$2"
      if [ "$proc" -eq 0 ] 2>/dev/null; then echo "HEALTHY"; return; fi
      # Calculate drops as percentage (integer math, multiply by 10000 for basis points)
      local bps=$(( drop * 10000 / proc ))
      if [ "$drop" -eq 0 ]; then echo "HEALTHY"
      elif [ "$bps" -lt 10 ]; then echo "STRESSED"     # < 0.1%
      elif [ "$bps" -lt 100 ]; then echo "DEGRADED"    # < 1%
      else echo "CRITICAL"; fi                          # >= 1%
    }
    # Assert 1: 0 drops → HEALTHY
    r=$(classify 1000 0); [ "$r" = "HEALTHY" ] || { echo "  FAIL: 0 drops → HEALTHY (got $r)"; exit 1; }
    # Assert 2: 5 drops / 10000 processed → STRESSED (< 0.1%)
    r=$(classify 10000 5); [ "$r" = "STRESSED" ] || { echo "  FAIL: 5/10000 → STRESSED (got $r)"; exit 1; }
    # Assert 3: 15 drops / 10000 processed → DEGRADED (0.15%)
    r=$(classify 10000 15); [ "$r" = "DEGRADED" ] || { echo "  FAIL: 15/10000 → DEGRADED (got $r)"; exit 1; }
    # Assert 4: 200 drops / 10000 processed → CRITICAL (2%)
    r=$(classify 10000 200); [ "$r" = "CRITICAL" ] || { echo "  FAIL: 200/10000 → CRITICAL (got $r)"; exit 1; }
    # Assert 5: 0 processed → HEALTHY (no traffic = no problem)
    r=$(classify 0 0); [ "$r" = "HEALTHY" ] || { echo "  FAIL: 0/0 → HEALTHY (got $r)"; exit 1; }
    echo "smoke-test: ok (5 assertions: 0drops→HEALTHY, 5/10k→STRESSED, 15/10k→DEGRADED, 200/10k→CRITICAL, 0/0→HEALTHY)"
  )
  exit $?
fi

# --- Read /proc/net/softnet_stat ---
SOFTNET="/proc/net/softnet_stat"
if [ ! -r "$SOFTNET" ]; then
  verdict="UNCERTAIN"; reason="cannot read $SOFTNET (permission denied)"; ec=2
else
  total_processed=0
  total_dropped=0
  total_squeeze=0

  while read -r proc drop squeeze _rest; do
    # Each field is hex (little-endian on x86)
    p=$((16#${proc})) 2>/dev/null || continue
    d=$((16#${drop})) 2>/dev/null || d=0
    s=$((16#${squeeze})) 2>/dev/null || s=0
    total_processed=$((total_processed + p))
    total_dropped=$((total_dropped + d))
    total_squeeze=$((total_squeeze + s))
  done < "$SOFTNET"

  # --- Classification ---
  if [ "$total_processed" -eq 0 ] 2>/dev/null; then
    verdict="HEALTHY"; reason="no traffic processed"
  elif [ "$total_dropped" -eq 0 ]; then
    verdict="HEALTHY"; reason="0 drops (${total_processed} processed)"
  else
    # Calculate drop percentage as basis points (×10000)
    bps=$(( total_dropped * 10000 / total_processed ))
    if [ "$bps" -lt 10 ]; then
      verdict="STRESSED"; reason="${total_dropped} drops (${bps}bp) of ${total_processed} processed + ${total_squeeze} squeezes"
    elif [ "$bps" -lt 100 ]; then
      verdict="DEGRADED"; reason="${total_dropped} drops (${bps}bp) of ${total_processed} processed + ${total_squeeze} squeezes"
    else
      verdict="CRITICAL"; reason="${total_dropped} drops (${bps}bp) of ${total_processed} processed + ${total_squeeze} squeezes"
    fi
  fi
  ec=0
fi

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed=""
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""; pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    :
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[net-drop] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'net-drop: %s — %s [processed=%s dropped=%s squeezes=%s]\n' \
      "$verdict" "$reason" "$total_processed" "${total_dropped:-0}" "${total_squeeze:-0}"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","processed":%d,"dropped":%d,"squeezes":%d,"ts":"%s"}\n' \
      "$verdict" "$reason" "${total_processed:-0}" "${total_dropped:-0}" "${total_squeeze:-0}" "$TS"
    ;;
esac

exit ${ec:-0}
