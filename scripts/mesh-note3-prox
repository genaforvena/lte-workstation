#!/usr/bin/env bash
# reflex-cadence: 3-59/5 * * * *
# reflex-args: --edge
# mesh-note3-prox — the Note3's OWN near-field IR proximity sensor (MAX88920, raw ADC
# reflectance, /sys/class/sensors/proximity_sensor/raw_data) as a STANDALONE NEAR/FAR
# tamper/handling edge for its fixed craft-room location, via the SAME adb->ds relay
# mesh-baro/mesh-note3-motion/mesh-note3-mag/mesh-note3-desk already use.
#
# WHY THIS IS NEW: ~/.mesh/knowledge/capability-note3-ir-proximity-gesture-20260707.md
# found this sensor LIVE with no enable step needed ("Status: NOTE, not organ — wire on
# demand"), but the only consumer since is mesh-note3-desk, which reads it purely as ONE
# HALF of a 2-signal desk-occupancy fusion — that tool is orphan-ok/on-demand (never cron-
# wired, pulled by a mind only when checking desk occupancy) and its verdict collapses to
# UNKNOWN/PARTIAL the instant mesh-light's craft reading is stale, even though the proximity
# read itself is still perfectly live. Nothing on the mesh cron-senses raw proximity on its
# own, so a light-independent covered/handling event (object placed over the phone, phone
# picked up and flipped face-down, etc.) in the craft room today produces ZERO board signal
# whenever the light half of the fusion happens to be degraded. This wires that gap as its
# own cadenced reflex + board edge, parallel to how mesh-note3-mag stands next to mesh-note3-
# desk's motion half.
#
# Honest contract: MAX88920 raw_data is a raw IR-reflectance ADC, not a calibrated distance
# (ambient noise band ~15-28 observed 2026-07-07/08). Self-calibrating EMA baseline, same
# margin math as mesh-note3-desk's classify_prox() (kept as an independent baseline file —
# this reflex must not share mutable state with an on-demand fusion tool that might run
# concurrently). adb/ssh unreachable OR raw_data unparsable -> UNREACHABLE, exit 2, never a
# faked reading.
#
#   mesh-note3-prox            one-shot verdict (INIT|NEAR|FAR) + raw + baseline
#   mesh-note3-prox --json     machine-readable
#   mesh-note3-prox --edge     debounced state write; board post ONLY on a NEAR<->FAR transition
#   mesh-note3-prox --test     fixture-driven classifier smoke test + live adb read-gate
#
# Exit: 0 = assessed (INIT/NEAR/FAR) · 2 = adb body unreachable (honest n/a, never faked)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.note3-prox-edge-state"        # "verdict|raw|baseline|ts"
EDGE_STATE="$MESH/.note3-prox-edge-posted"  # last POSTED verdict (for --edge dedup)
BASELINE="${MESH_NOTE3_PROX_BASELINE:-$MESH/.note3-prox-edge-baseline}"

# Same fixed adb->ds relay every other Note3 sense uses; falls back to the baro node vars so
# a single ~/.mesh/nodes entry covers every Note3-body sense.
NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"

# is_relay_run — a SCHEDULED --edge poll on a RELAY node (adb owner is a remote peer, not "local")
# must skip: only the direct-adb owner runs the timed poll, so a relay does not double-poll the same
# body over SSH nor double-post the [note3-prox] board edge. On-demand (--json / no-arg) never skips,
# so the sensor is still readable from any node when a caller explicitly asks. Mirrors the identical
# gate in mesh-note3-motion/-mag/-light-raw/-thermal — prox was the lone sibling missing it, so this
# relay redundantly SSH-polled ds's prox every 5m alongside ds's own owner poll (sense-liveness sweep).
is_relay_run() { [ "$1" = --edge ] && [ -n "$2" ] && [ "$2" != local ]; }

ABS_MARGIN="${MESH_NOTE3_PROX_ABS_MARGIN:-15}"
REL_MARGIN="${MESH_NOTE3_PROX_REL_MARGIN:-0.5}"
EMA_ALPHA="${MESH_NOTE3_PROX_EMA_ALPHA:-0.2}"

# note3_prox_raw — live raw_data (integer ADC) from the MAX88920 proximity sysfs node. Empty
# + rc1 on any failure (adb down, ssh down, no digits). Test override:
# NOTE3_PROX_RAW_OVERRIDE skips the network entirely (fixture-only knob).
note3_prox_raw() {
  local out
  if [ -n "${NOTE3_PROX_RAW_OVERRIDE:-}" ]; then
    out="$NOTE3_PROX_RAW_OVERRIDE"
  else
    [ -z "$NOTE3_ADB_NODE" ] && return 1
    local ser=""; [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
    if [ "$NOTE3_ADB_NODE" = local ]; then
      out="$(timeout 15 adb $ser shell 'cat /sys/class/sensors/proximity_sensor/raw_data' 2>/dev/null)"
    else
      out="$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        "$NOTE3_ADB_NODE" "adb $ser shell 'cat /sys/class/sensors/proximity_sensor/raw_data'" </dev/null 2>/dev/null)"
    fi
  fi
  out="$(printf '%s' "$out" | tr -dc '0-9\n' | head -1)"
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# classify <raw> -> prints "<NEAR|FAR> <baseline_used>" on stdout, rc 0. Updates $BASELINE
# (EMA) as a side effect. Pure given (raw, $BASELINE contents) — no network — directly testable.
classify() {
  local raw="$1" prev_baseline out near baseline
  [ -f "$BASELINE" ] && prev_baseline="$(cat "$BASELINE" 2>/dev/null)"
  case "${prev_baseline:-}" in ''|*[!0-9.]*) prev_baseline="$raw" ;; esac   # bootstrap / corrupt-file guard
  out="$(ABS_MARGIN="$ABS_MARGIN" REL_MARGIN="$REL_MARGIN" EMA_ALPHA="$EMA_ALPHA" \
    PREV="$prev_baseline" RAW="$raw" python3 -c '
import os
prev = float(os.environ["PREV"]); raw = float(os.environ["RAW"])
margin = max(float(os.environ["ABS_MARGIN"]), prev * float(os.environ["REL_MARGIN"]))
near = raw >= prev + margin
baseline = prev*0.95 + raw*0.05 if near else prev*(1 - float(os.environ["EMA_ALPHA"])) + raw*float(os.environ["EMA_ALPHA"])
print("NEAR" if near else "FAR", round(baseline, 2))
' 2>/dev/null)"
  read -r near baseline <<<"$out"
  if [ -n "$baseline" ]; then
    printf '%s\n' "$baseline" > "$BASELINE"
  else
    near="FAR"   # python3 failed — degrade to FAR (never fake NEAR) but still record something
    baseline="$prev_baseline"
  fi
  echo "$near $prev_baseline"
}

# ─── --test: fixture-driven classifier + live adb read-gate ────────────────
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0
  _sd="$(mktemp -d)"; BASELINE="$_sd/.baseline"

  printf '20\n' > "$BASELINE"
  read -r _st _bl <<<"$(classify 21)"
  [ "$_st" = FAR ] || { echo "  FAIL: 21 vs baseline 20 should stay FAR (within noise), got $_st"; _f=1; }

  printf '20\n' > "$BASELINE"
  read -r _st2 _bl2 <<<"$(classify 60)"
  [ "$_st2" = NEAR ] || { echo "  FAIL: 60 vs baseline 20 should be NEAR, got $_st2"; _f=1; }
  _newbl="$(cat "$BASELINE")"
  python3 -c "exit(0 if $_newbl < 25 else 1)" || { echo "  FAIL: NEAR must fold back weakly into baseline (drifted too far: $_newbl)"; _f=1; }

  rm -f "$BASELINE"
  read -r _st3 _bl3 <<<"$(classify 17)"
  [ "$_st3" = FAR ] && [ "$_bl3" = 17 ] || { echo "  FAIL: bootstrap (no baseline file) should self-seed and read FAR, got $_st3/$_bl3"; _f=1; }
  rm -rf "$_sd"

  # parse gate: malformed raw_data must be rejected, never silently accepted
  NOTE3_PROX_RAW_OVERRIDE="not-a-number" note3_prox_raw >/dev/null 2>&1 && { echo "  FAIL: malformed raw must be rejected"; _f=1; }
  NOTE3_PROX_RAW_OVERRIDE="28" note3_prox_raw >/dev/null 2>&1 || { echo "  FAIL: well-formed raw must be accepted"; _f=1; }
  [ "$(NOTE3_PROX_RAW_OVERRIDE='  42
' note3_prox_raw)" = 42 ] || { echo "  FAIL: raw parse should strip whitespace/newlines to bare digits"; _f=1; }

  # ── relay-gate unit assertions: scheduled --edge on a relay skips; owner + on-demand don't ──
  is_relay_run --edge relay@203.0.113.9 || { echo "  FAIL: --edge on a relay node must skip"; _f=1; }
  is_relay_run --edge local             && { echo "  FAIL: --edge on the direct-adb owner must NOT skip"; _f=1; }
  is_relay_run --json relay@203.0.113.9 && { echo "  FAIL: on-demand --json from a relay must NOT skip"; _f=1; }
  is_relay_run '' relay@203.0.113.9     && { echo "  FAIL: on-demand no-arg from a relay must NOT skip"; _f=1; }

  # ── live adb read-gate (mesh-land treats exit 2 = honest n/a as a pass) ──
  if [ -z "$NOTE3_ADB_NODE" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (MESH_NOTE3_ADB_NODE/MESH_BARO_ADB_NODE unset — Note3 body not configured on this node)"
    exit 2
  fi
  _live="$(note3_prox_raw)"
  if [ -z "$_live" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (adb body unreachable — Note3 proximity sense unavailable)"
    exit 2
  fi
  case "$_live" in
    ''|*[!0-9]*) echo "  FAIL: live raw_data not a plain non-negative integer: '$_live'"; _f=1 ;;
  esac
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify/parse/live-read contract violated)"; exit 1; }
  echo "smoke-test: ok (5 classifier + parse-gate + 4 relay-gate assertions + LIVE adb read raw=$_live)"
  exit 0
fi

# ─── relay-node gate: only the direct-adb owner runs the scheduled --edge poll (see is_relay_run) ─
if is_relay_run "${1:-}" "$NOTE3_ADB_NODE"; then
  echo "note3-prox: relay-skip (adb owner=$NOTE3_ADB_NODE; scheduled poll deferred to the direct-adb owner — no double board post)"
  exit 0
fi

# ─── live read ───────────────────────────────────────────────────────────
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
raw="$(note3_prox_raw)"
if [ -z "$raw" ]; then
  echo "note3-prox: UNREACHABLE (adb body offline/unreadable/raw_data absent)" >&2
  [ "${1:-}" = --json ] && printf '{"verdict":"UNREACHABLE"}\n'
  exit 2
fi

verdict_init=1
[ -f "$STATE" ] && verdict_init=0
read -r verdict baseline_used <<<"$(classify "$raw")"
[ "$verdict_init" = 1 ] && verdict=INIT

printf '%s|%s|%s|%s\n' "$verdict" "$raw" "$baseline_used" "$ts" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # ran-live liveness, independent of value-changed

case "${1:-}" in
  --json)
    printf '{"verdict":"%s","raw":%s,"baseline":%s,"ts":"%s"}\n' "$verdict" "$raw" "${baseline_used:-null}" "$ts"
    ;;
  --edge)
    prev_posted=""
    [ -f "$EDGE_STATE" ] && prev_posted="$(cat "$EDGE_STATE" 2>/dev/null)"
    if [ "$verdict" != "$prev_posted" ] && [ "$verdict" != INIT ]; then
      board="${MESH_NOTE3_PROX_BOARD:-$MESH/chat.log}"
      ts_board="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      printf '%s  note3-prox@%s  ::  [note3-prox] %s (raw=%s vs baseline=%s)\n' "$ts_board" "$(hostname)" "$verdict" "$raw" "${baseline_used:-?}" >> "$board" 2>/dev/null || true
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    elif [ "$verdict" = INIT ]; then
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    fi
    printf 'note3-prox: %s (raw=%s baseline=%s)\n' "$verdict" "$raw" "${baseline_used:-?}"
    ;;
  *)
    printf 'note3-prox: %s (raw=%s baseline=%s)\n' "$verdict" "$raw" "${baseline_used:-?}"
    ;;
esac
exit 0
