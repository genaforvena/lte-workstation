#!/usr/bin/env bash
set -euo pipefail

# Fresh Note3 traffic accounting from a real ADB dumpsys read.
# doctor-artifact: the raw capture and parsed verdict are node-local evidence.

ROOT="${MESH_EVIDENCE_ROOT:-$HOME/.mesh/evidence}/note3-netstats-20260920"
SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"
RAW="$ROOT/netstats-detail.raw"
STATE="$ROOT/netstats-delta.state"
VERDICT="$ROOT/netstats-delta.state.txt"
mkdir -p "$ROOT"

unknown() {
  local reason=${1:-unknown}
  printf 'status=UNKNOWN reason=%s age_s=unknown iface=unknown rxBytes=unknown rxPackets=unknown txBytes=unknown txPackets=unknown delta_rxBytes=unknown delta_rxPackets=unknown delta_txBytes=unknown delta_txPackets=unknown\n' "$reason" | tee "$VERDICT"
  return 2
}

capture() {
  local tmp="$RAW.tmp.$$"
  if ! adb -s "$SERIAL" exec-out 'dumpsys netstats --detail' >"$tmp" 2>"$ROOT/adb.stderr"; then
    rm -f "$tmp"
    unknown adb_unreachable
  fi
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    unknown empty_capture
  fi
  mv "$tmp" "$RAW"
}

parse() {
  local now_ms iface line bucket rx rp tx tp age_s old delta_rx delta_rp delta_tx delta_tp
  iface="$(tr -d '\r' <"$RAW" | awk '/iface=[^ ]+/{sub(/^.*iface=/,""); sub(/ .*/,""); print; exit}')"
  line="$(tr -d '\r' <"$RAW" | awk '/bucketStart=.*rxBytes=.*rxPackets=.*txBytes=.*txPackets=/ {line=$0} END {print line}')"
  [ -n "$iface" ] || unknown no_active_interface
  [ -n "$line" ] || unknown no_history
  bucket="$(printf '%s\n' "$line" | sed -n 's/.*bucketStart=\([0-9][0-9]*\).*/\1/p')"
  rx="$(printf '%s\n' "$line" | sed -n 's/.*rxBytes=\([0-9][0-9]*\).*/\1/p')"
  rp="$(printf '%s\n' "$line" | sed -n 's/.*rxPackets=\([0-9][0-9]*\).*/\1/p')"
  tx="$(printf '%s\n' "$line" | sed -n 's/.*txBytes=\([0-9][0-9]*\).*/\1/p')"
  tp="$(printf '%s\n' "$line" | sed -n 's/.*txPackets=\([0-9][0-9]*\).*/\1/p')"
  case "$bucket:$rx:$rp:$tx:$tp" in *[!0-9:]*|""|*::*) unknown malformed_history;; esac
  now_ms="$(date +%s%3N)"
  age_s=$(( (now_ms - bucket) / 1000 ))
  [ "$age_s" -ge 0 ] || age_s=unknown
  old=""
  [ -s "$STATE" ] && old="$(sed -n '1p' "$STATE")"
  delta_rx=unknown; delta_rp=unknown; delta_tx=unknown; delta_tp=unknown
  if printf '%s\n' "$old" | awk -F: 'NF==5 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $5 ~ /^[0-9]+$/' | grep -q .; then
    IFS=: read -r old_bucket old_rx old_rp old_tx old_tp <<<"$old"
    if [ "$bucket" = "$old_bucket" ]; then
      delta_rx=$((rx-old_rx)); delta_rp=$((rp-old_rp)); delta_tx=$((tx-old_tx)); delta_tp=$((tp-old_tp))
    fi
  fi
  printf '%s:%s:%s:%s:%s\n' "$bucket" "$rx" "$rp" "$tx" "$tp" >"$STATE"
  printf 'status=OK age_s=%s iface=%s rxBytes=%s rxPackets=%s txBytes=%s txPackets=%s delta_rxBytes=%s delta_rxPackets=%s delta_txBytes=%s delta_txPackets=%s raw=%s\n' "$age_s" "$iface" "$rx" "$rp" "$tx" "$tp" "$delta_rx" "$delta_rp" "$delta_tx" "$delta_tp" "$RAW" | tee "$VERDICT"
}

case "${1:-}" in
  --test)
    capture
    parse
    grep -Eq 'status=OK .*iface=[^ ]+ .*rxBytes=[0-9]+ .*rxPackets=[0-9]+ .*txBytes=[0-9]+ .*txPackets=[0-9]+' "$VERDICT"
    test -s "$RAW"
    ;;
  --log|"") capture; parse ;;
  *) echo "usage: $0 [--test|--log]" >&2; exit 64 ;;
esac
