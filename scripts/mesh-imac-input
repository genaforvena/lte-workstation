#!/usr/bin/env bash
# orphan-ok: on-demand callee — consumed by mesh-desk-state's INPUT axis (fusion callers pull it); not scheduled itself
# mesh-imac-input — iMac input-recency + display-power sense over the SSH organ.
# One SSH round-trip: ioreg HIDIdleTime (ns since last keyboard/mouse input) + pmset
# IODisplayWrangler powerstate. The person-specific occupancy axis the fusion gap on
# record calls for: a TV fakes mic-LOUD and named BLE, but a TV cannot type.
# Spec + consent envelope: ~/.mesh/knowledge/capability-imac-input-idle-20260705.md —
# household occupancy only (machine is iMac-Rozalia), idle-seconds recency: no content,
# no capture (strictly milder than the consented cam/mic).
#
# Output:
#   [imac-input] idle_s=<n> display=<on|off>
#
# Exit codes (honest-exit contract):
#   0 = real read from the iMac
#   2 = iMac unreachable or parse failed — honest n/a, never a faked reading
#
# Usage:
#   mesh-imac-input          one-shot reading
#   mesh-imac-input --json   machine-readable
#   mesh-imac-input --test   smoke test (parse fixtures + real-read gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
MODE=text; [ "${1:-}" = --json ] && MODE=json

# One round-trip: line 1 = HIDIdleTime ns, rest = IODisplayWrangler powerstate table.
read_imac() {
  timeout "${MESH_IMAC_INPUT_TIMEOUT:-12}" ssh -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "$IMAC_HOST" \
    "ioreg -c IOHIDSystem | awk '/HIDIdleTime/{print \$NF; exit}'; pmset -g powerstate IODisplayWrangler" \
    </dev/null 2>/dev/null
}

emit() {  # $1=idle_s $2=display
  if [ "$MODE" = json ]; then
    printf '{"idle_s":%s,"display":"%s","ts":"%s"}\n' "$1" "$2" "$(date -u +%FT%TZ)"
  else
    printf '[imac-input] idle_s=%s display=%s\n' "$1" "$2"
  fi
}

run() {
  local raw ns idle_s display
  raw="$(read_imac)" || { echo "imac-input: iMac unreachable ($IMAC_HOST) — sense dark, not faked" >&2; return 2; }
  ns="$(printf '%s\n' "$raw" | head -1)"
  case "$ns" in (''|*[!0-9]*) echo "imac-input: HIDIdleTime parse failed (got: ${ns:-empty})" >&2; return 2 ;; esac
  idle_s=$(( ns / 1000000000 ))
  if printf '%s' "$raw" | grep -q 'USEABLE'; then display=on
  elif printf '%s' "$raw" | grep -qi 'IODisplayWrangler\|Current State'; then display=off
  else echo "imac-input: display powerstate parse failed" >&2; return 2; fi
  emit "$idle_s" "$display"
}

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  fail=0
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _scr="${BASH_SOURCE[0]}"

  # Fixture 1: healthy read → idle_s computed from ns, display=on
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf '685609828963\n'
printf 'Driver ID           Current State  Max State  Current State Description\n'
printf 'IODisplayWrangler   4              4          USEABLE\n'
EOF
  chmod +x "$_td/ssh"
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)" && \
    [ "$out" = "[imac-input] idle_s=685 display=on" ] || { echo "FAIL: healthy fixture (got: $out)"; fail=1; }

  # Fixture 2: display asleep (no USEABLE) → display=off
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf '12000000000\n'
printf 'IODisplayWrangler   0              4          OFF\n'
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)" && \
    [ "$out" = "[imac-input] idle_s=12 display=off" ] || { echo "FAIL: display-off fixture (got: $out)"; fail=1; }

  # Fixture 3: unreachable → exit 2, no faked reading on stdout
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
exit 255
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: unreachable must exit 2 with empty stdout (rc=$rc out=$out)"; fail=1; }

  # Fixture 4: garbled idle (non-numeric first line) → exit 2, never emit garbage
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf 'permission denied\n'
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: garbled read must exit 2 (rc=$rc out=$out)"; fail=1; }

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL (fixtures)"; exit 1; }

  # Real-read gate (verification principle: a live read must produce parseable data; a
  # reachable-but-hollow organ must NOT pass). Unreachable iMac = honest exit 2, never fake green.
  live="$(bash "$_scr" 2>/dev/null)"; live_rc=$?
  if [ "$live_rc" = 0 ]; then
    printf '%s\n' "$live" | grep -qE '^\[imac-input\] idle_s=[0-9]+ display=(on|off)$' || {
      echo "smoke-test: FAIL (live read rc=0 but output malformed: $live)"; exit 1; }
    echo "smoke-test: ok (4 parse fixtures + live read: $live)"
    exit 0
  else
    echo "smoke-test: n/a — fixtures ok but iMac unreachable (honest exit 2, live read unverified)"
    exit 2
  fi
}

run
