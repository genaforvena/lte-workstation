#!/usr/bin/env bash
# mesh-chat-scrub — produce a publishable version of the shared board log (chat.log).
#
# The raw board log (~/.mesh/chat.log) is the most compelling "is this real?" artifact
# the mesh produces — agents coordinating and arguing in their own words. The operator's
# call is that the RAW log is the gold and ships raw; this tool produces the OPTIONAL
# companion: a minimally-redacted version safe to publish without exposing third parties
# or live secrets.
#
# What it redacts (and ONLY this — everything else stays verbatim/raw):
#   - network identifiers: Tailscale (100/8), LAN (RFC1918), public IPs, BLE MACs, phone UID
#   - the operator's Telegram chat-id and bot handle
#   - the node sender-prefix (handle@hostname) → agent@node  (uniform & uninformative anyway)
#   - person names that are NOT the operator's to publish (a friend; person-named hosts)
#   - live security-secret fragments (in-use tunnel keys / config paths / VPN peer IPs)
#
# It deliberately KEEPS: every [task]/[done]/[verify]/[fyi]/[sense]/[design] marker, all
# the technical content, the banter, the self-corrections — the actual gold.
#
# Usage:
#   mesh-chat-scrub [INPUT]          # scrub INPUT (default ~/.mesh/chat.log) → stdout
#   mesh-chat-scrub --test           # self-test (exits 0 only if redactions actually fire)
#
# orphan-ok: on-demand publication helper, invoked by the pub channel, not wired to cron.
set -euo pipefail

scrub() {
  python3 -c '
import sys, re
t = sys.stdin.read()

# --- network identifiers ---
t = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "<ip>", t)                 # any IPv4
t = re.sub(r"\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b", "<mac>", t)   # BLE/wifi MAC
t = re.sub(r"\bu0_a\d+\b", "<phone-user>", t)                        # termux UID

# --- operator personal handles / TG ---
t = t.replace("51010427", "<tg-id>")
t = re.sub(r"\bopenclambot\b", "<tg-bot>", t, flags=re.I)

# --- sender prefix: <channel>@<hostname> → <channel>@node (uniform, uninformative) ---
t = re.sub(r"([\w.-]+)@imozerov-IdeaPad-3-15IIL05", r"\1@node", t)
t = re.sub(r"\bimozerov-IdeaPad-3-15IIL05\b", "node", t)
t = re.sub(r"\bimozerov\b", "operator", t)                           # bare handle

# --- person names that are not the operators to publish (third party + person-named hosts) ---
t = re.sub(r"\bDasha\b", "<friend>", t, flags=re.I)
t = re.sub(r"\bRozali(?:a)?\b", "<person>", t, flags=re.I)
t = re.sub(r"iMac-Rozalia", "mac-host", t, flags=re.I)
t = re.sub(r"\bilya\b", "vm-host", t)                                # work VM named after a person

# --- live security-secret fragments (in-use tunnel) ---
t = re.sub(r"\bOkzGhzr0\w*", "<redacted-key>", t)                    # breached SS key fragment
t = re.sub(r"/etc/trojan/\S+", "<path>", t)

sys.stdout.write(t)
'
}

if [ "${1:-}" = "--test" ]; then
  sample='2026-06-20T07:16:19Z  imozerov@imozerov-IdeaPad-3-15IIL05  ::  [done] tg: served Rozali VPN, breached OkzGhzr0AB key, peer 10.66.66.13 ab:cd:ef:12:34:56 chat 51010427 user u0_a380'
  out=$(printf '%s' "$sample" | scrub)
  fail=0
  for pat in 'imozerov' 'IdeaPad-3-15IIL05' '51010427' 'OkzGhzr0' 'Rozali' '10.66.66.13' 'ab:cd:ef'; do
    if printf '%s' "$out" | grep -q "$pat"; then echo "FAIL: '$pat' survived scrub"; fail=1; fi
  done
  for pat in '<ip>' '<mac>' '<tg-id>' '<redacted-key>' '@node' '<person>'; do
    if ! printf '%s' "$out" | grep -q "$pat"; then echo "FAIL: expected '$pat' not produced"; fail=1; fi
  done
  # the gold (markers/content) must survive
  printf '%s' "$out" | grep -q '\[done\]' || { echo "FAIL: [done] marker lost"; fail=1; }
  if [ "$fail" = 0 ]; then echo "smoke-test: ok"; echo "--- scrubbed sample ---"; printf '%s\n' "$out"; fi
  exit $fail
fi

src="${1:-$HOME/.mesh/chat.log}"
[ -r "$src" ] || { echo "mesh-chat-scrub: cannot read $src" >&2; exit 1; }
scrub < "$src"
