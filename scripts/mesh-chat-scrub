#!/usr/bin/env bash
# mesh-chat-scrub — produce a publishable version of the shared board log (chat.log).
#
# The raw board log (~/.mesh/chat.log) is the most compelling "is this real?" artifact
# the mesh produces — agents coordinating and arguing in their own words. The operator's
# call is that the RAW log is the gold and ships raw; this tool produces the OPTIONAL
# companion: a minimally-redacted version safe to publish without exposing third parties
# or live secrets.
#
# SECURITY (the load-bearing rule): node-specific secret LITERALS — the operator's Telegram
# chat-id, key fragments, third-party person names, person-named hosts, specific VPN IPs —
# are NEVER hardcoded in this committed genome file. A scrubber that hardcodes the values it
# scrubs would leak them into the PUBLIC repo (the exact incident this file was rewritten to
# fix, 2026-06-24). They live ONLY in a gitignored runtime file, outside the repo:
#   ~/.mesh/scrub-secrets   — one  <literal><TAB><replacement>  per line (blank/'#' lines
#                             ignored). Absent → only the generic SHAPE-based patterns below
#                             fire. The committed tool carries ZERO real values.
#
# What it redacts:
#   - generic SHAPES (safe to hardcode, no real value): IPv4, BLE/wifi MAC, termux UID,
#     and the sender prefix  <channel>@<hostname> → <channel>@node  (uniform & uninformative)
#   - node-specific LITERALS from ~/.mesh/scrub-secrets (chat-id, key frags, names, hosts)
#
# It deliberately KEEPS: every [task]/[done]/[verify]/[fyi]/[sense]/[design] marker, all
# the technical content, the banter, the self-corrections — the actual gold.
#
# Usage:
#   mesh-chat-scrub [INPUT]          # scrub INPUT (default ~/.mesh/chat.log) → stdout
#   mesh-chat-scrub --test           # self-test (temp fake secrets; exits 0 only if redactions fire)
#
# orphan-ok: on-demand publication helper, invoked by the pub channel, not wired to cron.
set -euo pipefail

SCRUB_SECRETS="${MESH_SCRUB_SECRETS:-$HOME/.mesh/scrub-secrets}"

scrub() {
  MESH_SCRUB_SECRETS="${MESH_SCRUB_SECRETS:-$SCRUB_SECRETS}" python3 -c '
import sys, re, os
t = sys.stdin.read()

# --- generic SHAPE-based identifiers (no real value — safe in the committed genome) ---
t = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "<ip>", t)                  # any IPv4
t = re.sub(r"\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b", "<mac>", t)    # BLE/wifi MAC
t = re.sub(r"\bu0_a\d+\b", "<phone-user>", t)                         # termux UID
# sender prefix: <channel>@<hostname> → <channel>@node (keeps the channel, drops the host)
t = re.sub(r"([A-Za-z0-9_.-]+)@[A-Za-z0-9][A-Za-z0-9.-]*", r"\1@node", t)

# --- node-specific secret LITERALS from the gitignored runtime file (never in the genome) ---
conf = os.environ.get("MESH_SCRUB_SECRETS", "")
if conf and os.path.exists(conf):
    with open(conf) as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line or line.startswith("#") or "\t" not in line:
                continue
            lit, repl = line.split("\t", 1)
            if lit:
                t = t.replace(lit, repl)

sys.stdout.write(t)
'
}

if [ "${1:-}" = "--test" ]; then
  # sandboxed: a TEMP secrets file with entirely FAKE literals (no real operator values here).
  tmp=$(mktemp -d)
  printf 'FAKECHATID9\t<tg-id>\nFakePersonX\t<person>\nFAKEKEYzz\t<redacted-key>\n' > "$tmp/secrets"
  sample='2026-06-20T07:16:19Z  chan@some-host  ::  [done] tg: served FakePersonX VPN, key FAKEKEYzz, peer 10.0.0.9 aa:bb:cc:11:22:33 chat FAKECHATID9 user u0_a999'
  out=$(printf '%s' "$sample" | MESH_SCRUB_SECRETS="$tmp/secrets" scrub)
  rm -rf "$tmp"
  fail=0
  for pat in 'FAKECHATID9' 'FakePersonX' 'FAKEKEYzz' '10.0.0.9' 'aa:bb:cc:11:22:33' 'u0_a999' 'some-host'; do
    if printf '%s' "$out" | grep -q "$pat"; then echo "FAIL: '$pat' survived scrub"; fail=1; fi
  done
  for pat in '<ip>' '<mac>' '<phone-user>' '<tg-id>' '<redacted-key>' '<person>' 'chan@node'; do
    if ! printf '%s' "$out" | grep -q "$pat"; then echo "FAIL: expected '$pat' not produced"; fail=1; fi
  done
  # the gold (markers/content) must survive
  printf '%s' "$out" | grep -q '\[done\]' || { echo "FAIL: [done] marker lost"; fail=1; }
  printf '%s' "$out" | grep -q 'served .* VPN' || { echo "FAIL: technical content lost"; fail=1; }
  if [ "$fail" = 0 ]; then echo "smoke-test: ok (shape patterns + gitignored-literal scrub fire; gold survives)"; echo "--- scrubbed sample ---"; printf '%s\n' "$out"; fi
  exit $fail
fi

src="${1:-$HOME/.mesh/chat.log}"
[ -r "$src" ] || { echo "mesh-chat-scrub: cannot read $src" >&2; exit 1; }
[ -f "$SCRUB_SECRETS" ] || echo "mesh-chat-scrub: note — no $SCRUB_SECRETS; only generic shape-patterns will fire (node-specific literals not redacted)" >&2
scrub < "$src"
