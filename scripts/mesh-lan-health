#!/usr/bin/env bash
# mesh-lan-health — hardware care for LAN-adjacent devices that are NOT mesh nodes.
# The mesh already watches its own nodes (mesh-hw-health, mesh-card, mesh-health).
# This fills the gap: devices the mesh CARES ABOUT but doesn't run on — iMac, TV,
# vacuum, MacBookPro — monitored by ping only (read-only, zero footprint, no consent
# needed for bare connectivity). Extends "hardware care" to the whole household.
#
# Config (all in ~/.mesh/nodes or env):
#   MESH_LAN_DEVICES  — space-sep entries: label:IP or just IP
#                       e.g. "imac:192.168.8.214 tv:192.168.8.130 vacuum:192.168.8.127"
#   MESH_LAN_PING_TIMEOUT — ping timeout in seconds (default 2)
#
#   mesh-lan-health           print per-device status
#   mesh-lan-health --json    machine-readable [{"name":"imac","ip":"..","up":true,"ms":1}]
#   mesh-lan-health --edge    REFLEX: post [lan-up]/[lan-down] per device on state change
#   mesh-lan-health --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

LAN_DEVICES="${MESH_LAN_DEVICES:-}"
PING_T="${MESH_LAN_PING_TIMEOUT:-2}"
STATE_DIR="$HOME/.mesh/.lan-health"
TS="$(date -u +%FT%TZ)"

probe_device() {
  local label="$1" ip="$2"
  local ms up=false
  local out; out="$(ping -c1 -W "$PING_T" "$ip" 2>/dev/null)" && up=true || true
  # iputils prints the RTT to 3 SIGNIFICANT digits — 0.028 / 4.26 / 71.2 / 117 — so the decimal point
  # DISAPPEARS at >=100 ms. Mandating '\.' here dropped exactly the SLOW tail (every reading >=100ms
  # read "?ms" / "ms":null) — the half of the range a latency axis exists to see. Measured on this node
  # 2026-07-25: vacuum 4.26 / 71.2 / 117 in one 3-packet run, only the 117 lost. Decimal is OPTIONAL.
  ms="$(printf '%s' "$out" | grep -oE 'time=[0-9]+(\.[0-9]+)?' | head -1 | sed 's/time=//' | cut -d. -f1)"
  [ -z "$ms" ] && ms="?"
  printf '%s\t%s\t%s\t%s\n' "$label" "$ip" "$up" "$ms"
}

# occupancy-gated [lan-down] severity — 3rd instance of the occupancy-severity pattern (after
# lan-newdevice, tamper-rhythm). A watched LAN device dropping means something DIFFERENT depending on
# whether anyone is home: the mobile computers (iMac/MacBookPro) legitimately leave the LAN when the
# operator DEPARTS, so a [lan-down] while household=AWAY is routine (expected), whereas while household=
# ACTIVE it is a real fault (a device that should be up went down while someone's home). Read household
# state at the DOWN edge and MODULATE severity ONLY — up/down detection is unchanged. Honest-fusion rule:
# no household sense on PATH → UNCERTAIN → current default, NEVER a faked all-clear that hides a real fault.
lan_occ_state(){
  [ -n "${MESH_LAN_OCC_STATE:-}" ] && { printf '%s' "$MESH_LAN_OCC_STATE"; return; }   # test/override hook
  command -v mesh-household-state >/dev/null 2>&1 || { printf 'UNCERTAIN'; return; }
  local s
  s="$(mesh-household-state --json 2>/dev/null | sed -n 's/.*"state": *"\([^"]*\)".*/\1/p')"
  case "$s" in ACTIVE|ASLEEP|AWAY) printf '%s' "$s" ;; *) printf 'UNCERTAIN' ;; esac
}
# lan_down_render OCC LABEL IP PREV → the full [lan-down] message, severity-worded by occupancy.
# Pure (no side effects) so --test can assert every branch deterministically. AWAY→routine departure,
# ACTIVE→real fault; ASLEEP/UNCERTAIN → the exact prior default format (no regression).
lan_down_render(){
  local occ="$1" label="$2" ip="$3" prev="$4" sev="" ctx=""
  case "$occ" in
    AWAY)   sev="(routine) "; ctx=" — home AWAY: mobile devices depart with the operator; a device down while nobody's home is low-urgency" ;;
    ACTIVE) sev="(FAULT) ";   ctx=" — home ACTIVE: a device that should be up went DOWN while someone's home — real fault, investigate" ;;
    *)      sev="";           ctx="" ;;   # ASLEEP / UNCERTAIN → current default (asleep-at-home isn't a departure, isn't active-use fault)
  esac
  printf '[lan-down] %s%s@%s (was %s)%s' "$sev" "$label" "$ip" "${prev:-new}" "$ctx"
}

[ "${1:-}" = --test ] && {
  command -v ping >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ping)"; exit 1; }
  # Dry-run: mock ping with synthetic responses, exercise probe_device + label:IP parsing + output formatting.
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/.mesh" "$_td/.mesh/.lan-health"
  # Mock ping: succeed for .1/.130 (fast ms) and .140 (SLOW, >=100ms → iputils drops the decimal:
  # "time=117 ms", 3 significant digits), fail for .99. The .140 case is the regression gate for the
  # decimal-mandatory regex that silently rendered every slow device as "?ms".
  printf '#!/bin/sh\ncase " $* " in *" 192.168.8.1 "*)  printf "1 received, time=1.23 ms"; exit 0;; *" 192.168.8.130 "*) printf "1 received, time=5.67 ms"; exit 0;; *" 192.168.8.140 "*) printf "1 received, time=117 ms"; exit 0;; *) printf "0 received"; exit 1;; esac\n' > "$_td/ping"
  chmod +x "$_td/ping"; PATH="$_td:$PATH"
  # Test probe_device directly
  r1="$(probe_device "router" "192.168.8.1")";   r1up="$(printf '%s' "$r1" | cut -f3)"; [ "$r1up" = true  ] || { echo "  FAIL: probe router .1 should be UP"; exit 1; }
  r1ms="$(printf '%s' "$r1" | cut -f4)";         [ "$r1ms" = 1    ] || { echo "  FAIL: probe router .1 ms=1 (got $r1ms)"; exit 1; }
  r2="$(probe_device "dead"  "192.168.8.99")";   r2up="$(printf '%s' "$r2" | cut -f3)"; [ "$r2up" = false ] || { echo "  FAIL: probe dead .99 should be DOWN"; exit 1; }
  r3="$(probe_device "tv"    "192.168.8.130")";  r3up="$(printf '%s' "$r3" | cut -f3)"; [ "$r3up" = true  ] || { echo "  FAIL: probe tv .130 should be UP"; exit 1; }
  r3ms="$(printf '%s' "$r3" | cut -f4)";         [ "$r3ms" = 5    ] || { echo "  FAIL: probe tv .130 ms=5 (got $r3ms)"; exit 1; }
  r4="$(probe_device "slow"  "192.168.8.140")";  r4up="$(printf '%s' "$r4" | cut -f3)"; [ "$r4up" = true  ] || { echo "  FAIL: probe slow .140 should be UP"; exit 1; }
  r4ms="$(printf '%s' "$r4" | cut -f4)";         [ "$r4ms" = 117  ] || { echo "  FAIL: probe slow .140 ms=117, decimal-less RTT dropped (got $r4ms)"; exit 1; }
  # Test full tool output with mock MESH_LAN_DEVICES — this re-execs the script, so it covers the
  # SECOND probe_device copy (below the --test block), not the one asserted directly above.
  out="$(HOME="$_td" MESH_LAN_DEVICES="router:192.168.8.1 dead:192.168.8.99 tv:192.168.8.130 slow:192.168.8.140" PATH="$_td:$PATH" bash "$0" 2>/dev/null)"
  printf '%s\n' "$out" | grep -q 'slow.*UP.*117ms'      || { echo "  FAIL: full output slow .140 not 117ms (second probe_device copy)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'router.*UP.*1ms'     || { echo "  FAIL: full output missing router UP"; exit 1; }
  printf '%s\n' "$out" | grep -q 'dead.*DOWN'           || { echo "  FAIL: full output missing dead DOWN"; exit 1; }
  printf '%s\n' "$out" | grep -q 'tv.*UP.*5ms'          || { echo "  FAIL: full output missing tv UP"; exit 1; }
  # Test --json output
  j="$(HOME="$_td" MESH_LAN_DEVICES="router:192.168.8.1 dead:192.168.8.99 slow:192.168.8.140" PATH="$_td:$PATH" bash "$0" --json 2>/dev/null)"
  printf '%s\n' "$j" | grep -q 'router.*true.*1'        || { echo "  FAIL: json missing router up true"; exit 1; }
  printf '%s\n' "$j" | grep -q 'dead.*false'             || { echo "  FAIL: json missing dead up false"; exit 1; }
  printf '%s\n' "$j" | grep -q '"ms":117'                || { echo "  FAIL: json slow .140 ms not 117 (decimal-less RTT dropped to null)"; exit 1; }
  # occupancy-gated [lan-down] severity (additive): AWAY→routine, ACTIVE→FAULT, ASLEEP/UNCERTAIN→prior default
  m="$(lan_down_render AWAY imac 192.168.8.214 up)"
  printf '%s' "$m" | grep -q '^\[lan-down\] (routine) '   || { echo "  FAIL: AWAY lan-down not routine: '$m'"; exit 1; }
  printf '%s' "$m" | grep -q 'departed\|home AWAY'        || { echo "  FAIL: AWAY missing departure context: '$m'"; exit 1; }
  m="$(lan_down_render ACTIVE imac 192.168.8.214 up)"
  printf '%s' "$m" | grep -q '^\[lan-down\] (FAULT) '     || { echo "  FAIL: ACTIVE lan-down not FAULT: '$m'"; exit 1; }
  m="$(lan_down_render UNCERTAIN imac 192.168.8.214 up)"
  [ "$m" = '[lan-down] imac@192.168.8.214 (was up)' ]     || { echo "  FAIL: UNCERTAIN not prior default: '$m'"; exit 1; }
  m="$(lan_down_render ASLEEP imac 192.168.8.214 up)"
  [ "$m" = '[lan-down] imac@192.168.8.214 (was up)' ]     || { echo "  FAIL: ASLEEP not prior default: '$m'"; exit 1; }
  s="$(PATH=/nonexistent lan_occ_state)"                  # fail-open: no household sense → UNCERTAIN, never faked
  [ "$s" = UNCERTAIN ]                                    || { echo "  FAIL: fail-open not UNCERTAIN: '$s'"; exit 1; }
  s="$(MESH_LAN_OCC_STATE=AWAY lan_occ_state)"            # override hook honored
  [ "$s" = AWAY ]                                         || { echo "  FAIL: override hook ignored: '$s'"; exit 1; }
  echo "smoke-test: ok (probe_device: 4 hosts incl. >=100ms decimal-less RTT + ms + text/json; occupancy-gate: 6 assertions)"; exit 0
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

if [ -z "$LAN_DEVICES" ]; then
  [ "$MODE" = json ] && echo "[]" || echo "mesh-lan-health: no devices configured (set MESH_LAN_DEVICES in ~/.mesh/nodes)"
  exit 0
fi

mkdir -p "$STATE_DIR"

probe_device() {
  local label="$1" ip="$2"
  local ms up=false
  # -c1 = one packet, -W = deadline seconds, -q = quiet
  local out; out="$(ping -c1 -W "$PING_T" "$ip" 2>/dev/null)" && up=true || true
  # iputils prints the RTT to 3 SIGNIFICANT digits — 0.028 / 4.26 / 71.2 / 117 — so the decimal point
  # DISAPPEARS at >=100 ms. Mandating '\.' here dropped exactly the SLOW tail (every reading >=100ms
  # read "?ms" / "ms":null) — the half of the range a latency axis exists to see. Measured on this node
  # 2026-07-25: vacuum 4.26 / 71.2 / 117 in one 3-packet run, only the 117 lost. Decimal is OPTIONAL.
  ms="$(printf '%s' "$out" | grep -oE 'time=[0-9]+(\.[0-9]+)?' | head -1 | sed 's/time=//' | cut -d. -f1)"
  [ -z "$ms" ] && ms="?"
  printf '%s\t%s\t%s\t%s\n' "$label" "$ip" "$up" "$ms"
}

results=()
while IFS= read -r entry; do
  [ -z "$entry" ] && continue
  label="${entry%%:*}"; ip="${entry#*:}"
  [ "$label" = "$ip" ] && label="$(printf '%s' "$ip" | tr . -)"
  row="$(probe_device "$label" "$ip")"
  results+=("$row")
done < <(tr ' ' '\n' <<< "$LAN_DEVICES")

if [ "$MODE" = json ]; then
  printf '['
  first=1
  for row in "${results[@]}"; do
    IFS=$'\t' read -r label ip up ms <<< "$row"
    [ "$first" = 1 ] && first=0 || printf ','
    printf '{"name":"%s","ip":"%s","up":%s,"ms":%s}' \
      "$label" "$ip" "$up" "$([ "$ms" = '?' ] && echo 'null' || echo "$ms")"
  done
  printf ']\n'
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  for row in "${results[@]}"; do
    IFS=$'\t' read -r label ip up ms <<< "$row"
    state_f="$STATE_DIR/$label.state"
    cur="$([ "$up" = true ] && echo up || echo down)"
    prev="$(cat "$state_f" 2>/dev/null || echo)"
    printf '%s' "$cur" > "$state_f"
    [ -n "$prev" ] && [ "$cur" = "$prev" ] && continue
    if [ "$cur" = up ]; then
      msg="[lan-up] $label@$ip (was ${prev:-new}), ${ms}ms"
    else
      # [lan-down]: gate severity on household occupancy (AWAY→routine departure, ACTIVE→real fault)
      msg="$(lan_down_render "$(lan_occ_state)" "$label" "$ip" "$prev")"
    fi
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-health@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
  done
  exit 0
fi

printf '=== mesh-lan-health @ %s ===\n' "$TS"
for row in "${results[@]}"; do
  IFS=$'\t' read -r label ip up ms <<< "$row"
  if [ "$up" = true ]; then
    printf '  %-16s %s  UP (%sms)\n' "$label" "$ip" "$ms"
  else
    printf '  %-16s %s  DOWN\n' "$label" "$ip"
  fi
done
exit 0
