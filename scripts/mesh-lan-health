#!/usr/bin/env bash
# mesh-lan-health — hardware care for LAN-adjacent devices that are NOT mesh nodes.
# The mesh already watches its own nodes (mesh-hw-health, mesh-card, mesh-health).
# This fills the gap: devices the mesh CARES ABOUT but doesn't run on — iMac, TV,
# vacuum, MacBookPro — monitored by ping only (read-only, zero footprint, no consent
# needed for bare connectivity). Extends "hardware care" to the whole household.
#
# Config (all in ~/.mesh/nodes or env):
#   MESH_LAN_DEVICES  — space-sep entries: label:IP or just IP
#                       e.g. "imac:192.168.8.214 tv:192.168.8.130 vacuum:192.168.8.127"
#   MESH_LAN_PING_TIMEOUT — ping timeout in seconds (default 2)
#
#   mesh-lan-health           print per-device status
#   mesh-lan-health --json    machine-readable [{"name":"imac","ip":"..","up":true,"ms":1}]
#   mesh-lan-health --edge    REFLEX: post [lan-up]/[lan-down] per device on state change
#   mesh-lan-health --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

LAN_DEVICES="${MESH_LAN_DEVICES:-}"
PING_T="${MESH_LAN_PING_TIMEOUT:-2}"
STATE_DIR="$HOME/.mesh/.lan-health"
TS="$(date -u +%FT%TZ)"

[ "${1:-}" = --test ] && {
  command -v ping >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ping)"; exit 1; }
  [ -n "$LAN_DEVICES" ] || { echo "smoke-test: ok (no MESH_LAN_DEVICES configured; add entries to ~/.mesh/nodes)"; exit 0; }
  echo "smoke-test: ok (${#LAN_DEVICES} chars of devices)"; exit 0
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

if [ -z "$LAN_DEVICES" ]; then
  [ "$MODE" = json ] && echo "[]" || echo "mesh-lan-health: no devices configured (set MESH_LAN_DEVICES in ~/.mesh/nodes)"
  exit 0
fi

mkdir -p "$STATE_DIR"

probe_device() {
  local label="$1" ip="$2"
  local ms up=false
  # -c1 = one packet, -W = deadline seconds, -q = quiet
  local out; out="$(ping -c1 -W "$PING_T" "$ip" 2>/dev/null)" && up=true || true
  ms="$(printf '%s' "$out" | grep -oE 'time=[0-9]+\.[0-9]+' | head -1 | sed 's/time=//' | cut -d. -f1)"
  [ -z "$ms" ] && ms="?"
  printf '%s\t%s\t%s\t%s\n' "$label" "$ip" "$up" "$ms"
}

results=()
while IFS= read -r entry; do
  [ -z "$entry" ] && continue
  label="${entry%%:*}"; ip="${entry#*:}"
  [ "$label" = "$ip" ] && label="$(printf '%s' "$ip" | tr . -)"
  row="$(probe_device "$label" "$ip")"
  results+=("$row")
done < <(tr ' ' '\n' <<< "$LAN_DEVICES")

if [ "$MODE" = json ]; then
  printf '['
  first=1
  for row in "${results[@]}"; do
    IFS=$'\t' read -r label ip up ms <<< "$row"
    [ "$first" = 1 ] && first=0 || printf ','
    printf '{"name":"%s","ip":"%s","up":%s,"ms":%s}' \
      "$label" "$ip" "$up" "$([ "$ms" = '?' ] && echo 'null' || echo "$ms")"
  done
  printf ']\n'
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  for row in "${results[@]}"; do
    IFS=$'\t' read -r label ip up ms <<< "$row"
    state_f="$STATE_DIR/$label.state"
    cur="$([ "$up" = true ] && echo up || echo down)"
    prev="$(cat "$state_f" 2>/dev/null || echo)"
    printf '%s' "$cur" > "$state_f"
    [ -n "$prev" ] && [ "$cur" = "$prev" ] && continue
    tag="lan-${cur}"
    detail="$label@$ip (was ${prev:-new})"
    [ "$cur" = up ] && detail="$detail, ${ms}ms"
    msg="[${tag}] $detail"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-health@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
  done
  exit 0
fi

printf '=== mesh-lan-health @ %s ===\n' "$TS"
for row in "${results[@]}"; do
  IFS=$'\t' read -r label ip up ms <<< "$row"
  if [ "$up" = true ]; then
    printf '  %-16s %s  UP (%sms)\n' "$label" "$ip" "$ms"
  else
    printf '  %-16s %s  DOWN\n' "$label" "$ip"
  fi
done
exit 0
