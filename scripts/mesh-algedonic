  # 3d) THE SECOND SUPPRESSION TIER. A TRACED SUPERCRITICAL is the producer saying "density-only, NOT a
  #     runaway" — 24 of 24 of this node's excursions take that route — and must contribute the same mild
  #     off-band pain as HELD, never 0.9. Driven on the AUTOWIRED tape name, i.e. the live path.
  printf '%s\n' "m̂=1.457 [SUPERCRITICAL] 145 bins, 337 events, meta=0.507 ALARM-TRACED(density-only, no slug concentration)" > "$_td/criticality.cron.log"; touch -d "@99000" "$_td/criticality.cron.log"
  read -r pain via bnd det kn tot < <(aggregate)
  case "$det" in *crit:0.15*) : ;; *) echo "  FAIL: a TRACED supercritical is a producer-suppressed tier and must yield crit:0.15, got $det"; fail=1 ;; esac
  chk "traced-supercrit band (not CRITICAL)" "$bnd" NOMINAL
  rm -f "$_td/criticality.cron.log"
  printf '%s\n' "m̂=1.554 [SUPERCRITICAL] 145 bins, 260 events, meta=0.40 ALARM" > "$_td/criticality.log"; touch -d "@99000" "$_td/criticality.log"
  # 4) HONEST-FUSION: a STALE axis is UNKNOWN, not stale-green
  touch -d "@1" "$_td/.therm-state"   # ancient → stale → excluded
  read -r pain via bnd det kn tot < <(aggregate)
  chk "stale axis excluded (known drops)" "$kn" 4
  case "$det" in *therm:\?*) : ;; *) echo "  FAIL: stale therm not marked '?': $det"; fail=1 ;; esac
