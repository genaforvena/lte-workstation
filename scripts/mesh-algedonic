import sys, datetime as dt
alog, clog = sys.argv[1], sys.argv[2]
base = dt.datetime.strptime("2026-01-01T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
def iso(k): return (base + dt.timedelta(seconds=k)).strftime("%Y-%m-%dT%H:%M:%SZ")
# integer cents for pain: 0.05-sized steps land on float boundaries (0.85-0.80 = 0.049999...) and would
# silently reclassify a `worse` interval as `flat` — a fixture whose buckets depend on float luck.
P, A, t, p = [], [], 0, 20
P.append((t, p))
# SOLO half (genome alone), 10 intervals: 1 improve + 9 worse; genome acts on the improve + 4 of the worse.
for b, act in [("improve",1)] + [("worse",1)]*4 + [("worse",0)]*5:
    t += 600; p += (-6 if b == "improve" else 6); P.append((t, p))
    if act: A.append((t-60, "genome"))
# INTERFERED half, 60 intervals: `land` acts on every one; genome on half, balanced across buckets (independent).
for i in range(60):
    t += 600; p += (-6 if i % 2 == 0 else 6); P.append((t, p))
    A.append((t-60, "land"))
    if (i % 4) in (0, 1): A.append((t-70, "genome"))
with open(alog, "w") as f:
    for tt, pp in P: f.write("%s algedonic: pain=%.2f viability=0.0 [WATCH]\n" % (iso(tt), pp/100.0))
with open(clog, "w") as f:
    for tt, w in sorted(A): f.write("%s %s@h  ::  [done] act\n" % (iso(tt), w))
PY
