import sys, datetime as dt
alog, clog = sys.argv[1], sys.argv[2]
base = dt.datetime.strptime("2026-01-01T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
def iso(k): return (base + dt.timedelta(seconds=k)).strftime("%Y-%m-%dT%H:%M:%SZ")
# 20 solo intervals (genome alone, always improves) then 20 interfered ones (genome + land, always worsens)
P, A = [], []
t = 0
for i in range(20):                      # SOLO half: 0.70 -> 0.40 -> 0.70 ... genome acts on each drop
    P.append((t, 0.70)); A.append((t + 540, "genome")); t += 600
    P.append((t, 0.40)); t += 600
for i in range(20):                      # INTERFERED half: genome AND land act, and pain RISES
    P.append((t, 0.40)); A.append((t + 540, "genome")); A.append((t + 550, "land")); t += 600
    P.append((t, 0.70)); t += 600
with open(alog, "w") as f:
    for tt, p in P: f.write("%s algedonic: pain=%.2f viability=0.0 [WATCH]\n" % (iso(tt), p))
with open(clog, "w") as f:
    for tt, w in sorted(A): f.write("%s %s@h  ::  [done] act\n" % (iso(tt), w))
PY
