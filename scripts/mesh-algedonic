import sys, datetime as dt
alog, clog = sys.argv[1], sys.argv[2]
need = {"improve": int(sys.argv[3]), "flat": int(sys.argv[4]), "worse": int(sys.argv[5])}
N = 600
base = dt.datetime.strptime("2026-01-01T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
def iso(k): return (base + dt.timedelta(seconds=k)).strftime("%Y-%m-%dT%H:%M:%SZ")
# Exactly-periodic 8-block (3 improve, 3 worse, 2 flat): a cumulative pain walk over a RANDOM bucket order
# drifts out of [0,1] at this length, this one returns to its start every block (pain stays in [0.44,0.50])
# and pins the bucket marginal at 0.375/0.25/0.375 for any N. Integer cents — 0.05 steps would land on float
# boundaries and silently reclassify a bucket.
blk = ["improve", "worse", "flat", "improve", "worse", "flat", "improve", "worse"]
bkts = [blk[i % 8] for i in range(N)]
idx = {}
for i, b in enumerate(bkts): idx.setdefault(b, []).append(i)
acting = set()
for b, k in need.items():                     # spread the acting intervals evenly, no RNG in a fixture
    L = idx[b]; step = max(1, len(L)//k)
    acting.update(L[i*step] for i in range(k))
P, A, t, p = [], [], 0, 50
P.append((t, p))
for i, b in enumerate(bkts):
    t += 600; p += (-6 if b == "improve" else (6 if b == "worse" else 0)); P.append((t, p))
    if i in acting: A.append(t - 60)
with open(alog, "w") as f:
    for tt, pp in P: f.write("%s algedonic: pain=%.2f viability=0.0 [WATCH]\n" % (iso(tt), pp/100.0))
with open(clog, "w") as f:
    for tt in A: f.write("%s genome@h  ::  [done] act\n" % iso(tt))
PY
  }
