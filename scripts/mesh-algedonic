  #    on a synthetic trace, and empty/no-action traces must degrade honestly.
  : > "$_td/algedonic.log"; : > "$_td/chat.log"; CHAT_LOG="$_td/chat.log"; AI_WIN_S=120; AI_MIN_N=6
