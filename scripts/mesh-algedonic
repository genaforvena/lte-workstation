#!/usr/bin/env bash
# mesh-algedonic — VSM ALGEDONIC AGGREGATION: one GLOBAL viability read fused from the many siloed
# per-subsystem alarms. READ-ONLY (this version): aggregate + LOG, never escalate. (Beer's algedonic
# channel / Pérez Ríos TOP "insufficient algedonic channels" pathology — design note:
# ~/.mesh/knowledge/algedonic-aggregation-gap.md, author cooscillate-robustness.)
#
# THE GAP IT FILLS: the mesh has many homeostats each SILOED to one variable, each firing its OWN
# alert on its OWN threshold (mesh-therm-watch, mesh-stress, mesh-hw-health, mesh-egress-health,
# mesh-criticality, …). Nothing sums them into one VIABILITY read — so DISTRIBUTED SUB-THRESHOLD
# distress (N subsystems each at 70% of their own alarm, none tripping) is INVISIBLE = the classic
# slow-creep / death-by-a-thousand-cuts that has no path to attention until one source happens to
# cross its line. This aggregates the alarms we ALREADY HAVE into the correlated-degradation read
# none of them catch alone.
#
# AGGREGATION = NOISY-OR over the known axes: P = 1 − Π(1 − pᵢ). This is the combiner the gap note
# asks for — "one critical OR many moderate both register": one pᵢ=0.85 → P≈0.85; five pᵢ=0.30 →
# P≈0.83 (the distributed-creep case lights up). Bounded [0,1], principled (independent-failure
# probability), and HONEST-FUSION: an unreachable/stale axis is EXCLUDED (UNKNOWN), never counted as
# a faked 0/all-clear ([[fusion-tools-distinguish-empty-from-failed]]). ALL axes unknown → UNKNOWN.
#
# READS ONLY CHEAP STATE FILES the subsystem reflexes already maintain (no SSH, no re-running heavy
# tools) → safe to schedule. A state file older than STALE_S (its producing reflex stopped) → that
# axis is UNKNOWN, not stale-green.
#
# DELIBERATELY NOT BUILT HERE (deferred, per the design note): the OUT-OF-BAND OPERATOR ESCALATION
# (mesh-tg when cumulative pain crosses a threshold even if no single source tripped) + the two-phase
# AUDIT. That is a new operator-TG channel — a mis-calibrated one FLOODS or is HOLLOW; its threshold
# must be calibrated against THIS mesh's real pain baseline (which this read-only logger now starts
# gathering) AND it's the operator's channel → deserves sign-off. Measurement before the actuator.
#
# reflex-cadence: */10 * * * *
# reflex-args: --quiet
# Read-only baseline logger (pure file reads + one log line) — wired so the pain-distribution baseline
# accrues for later escalation-threshold calibration. NOT an alarm (it never posts/escalates).
# --quiet (no stdout) because the tool appends to algedonic.log itself; the cron's >>log redirect then
# carries only stderr — without --quiet each run would log the line TWICE (internal append + stdout).
#
#   mesh-algedonic            alias for --status
#   mesh-algedonic --status   aggregate the subsystem pains → viability index, print + append the log
#   mesh-algedonic --quiet    --status but log only (no stdout) — the reflex path
#   mesh-algedonic --test     smoke test (synthetic state dir; noisy-OR + honest-fusion asserts)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
{ "$HOME/.local/bin/mesh-pulse" beat algedonic; } >/dev/null 2>&1 || true  # liveness heartbeat (mesh-pulse): read-only logger is silent-on-no-news → needs an explicit per-run pulse
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S="${MESH_ALGEDONIC_STALE:-3600}"   # an axis state file older than this → UNKNOWN (producer stopped)
LOG="$MESH/algedonic.log"

# pain band labels (read-only — NO escalation; these just annotate the logged index)
band(){ awk -v p="$1" 'BEGIN{ if(p<0.30)print"NOMINAL"; else if(p<0.60)print"WATCH"; else if(p<0.80)print"STRESSED"; else print"CRITICAL" }'; }

# read a state file → echo its content IF fresh (mtime within STALE_S), else echo nothing (UNKNOWN).
fresh(){ local f="$1" now age; [ -r "$f" ] || return 1; now="${MESH_ALGEDONIC_NOW:-$(date +%s)}"
         age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); [ "$age" -le "$STALE_S" ] || return 1
         cat "$f" 2>/dev/null; }

# each axis → echoes "pain" [0,1] on a known reading, or nothing (→ UNKNOWN, excluded from the fusion).
# Mappings use each subsystem's OWN documented state vocab (verified against the source tools).
pain_therm(){ local s; s="$(fresh "$MESH/.therm-state")" || return 0
  case "$s" in *HOT*) echo 0.85 ;; *OK*) echo 0.0 ;; esac; }
pain_hw(){ local s; s="$(fresh "$MESH/.hw-health.state")" || return 0
  case "$s" in *FAIL*) echo 0.9 ;; *WARN*) echo 0.5 ;; *OK*) echo 0.0 ;; esac; }
pain_egress(){ local s; s="$(fresh "$MESH/.egress-state")" || return 0
  case "$s" in *OK*) echo 0.0 ;; ?*) echo 0.7 ;; esac; }
pain_stress(){ local s; s="$(fresh "$MESH/.stress-state")" || return 0
  # mesh-stress's REAL vocab (verified against the source) is CALM/WARM/STRESSED/CRITICAL — WARM is the
  # p50 storm-baseline band (90°C, informational), NOT a no-op. The earlier *HOT* arm was spurious
  # (mesh-stress never emits HOT) and *WARM* was missing → a WARM read wrongly rendered UNKNOWN.
  case "$s" in *CRITICAL*) echo 0.9 ;; *STRESSED*) echo 0.5 ;; *WARM*) echo 0.3 ;; *CALM*) echo 0.0 ;; esac; }
# criticality m̂ regime: m≈1 CRITICAL = healthy (responsive, no runaway); m>1 SUPERCRITICAL = runaway
# cascade (THE alarm); m<1 SUBCRITICAL = dormant/under-reactive (mildly off-band). Parsed from the log
# tail (criticality has no bare state file); staleness via the log mtime.
pain_crit(){ local line; line="$(fresh "$MESH/criticality.log" | tail -1)" || return 0
  [ -n "$line" ] || return 0
  # HONEST FUSION (respect the producer's own gate): criticality tags a SUPERCRITICAL reading
  # "ALARM-HELD" when it is META-DOMINATED — i.e. m̂>1 is driven by observer/narration chatter, so
  # criticality SUPPRESSES its own alarm (it is NOT a real runaway cascade). Reading the raw
  # SUPERCRITICAL token while ignoring that HELD qualifier escalates a signal the producer already
  # decided is non-alarming → a FALSE global-viability CRITICAL while every concrete axis is healthy.
  # So a HELD excursion contributes only mild off-band pain (like a SUBCRITICAL drift), never 0.9.
  # Only an UN-held SUPERCRITICAL (a real ALARM the producer did NOT suppress) drives full crit pain.
  case "$line" in
    *SUPERCRITICAL*ALARM-HELD*|*ALARM-HELD*SUPERCRITICAL*) echo 0.15 ;;
    *SUPERCRITICAL*) echo 0.9 ;;
    *SUBCRITICAL*) echo 0.15 ;;
    *'[CRITICAL]'*) echo 0.0 ;;
  esac; }

aggregate(){ # prints: "pain viability band detail known total"
  local names=(therm hw egress stress crit) p detail="" prod=1.0 known=0 total=0 pmax=0
  for n in "${names[@]}"; do
    total=$((total+1))
    p="$(pain_$n)"
    if [ -z "$p" ]; then detail+="${detail:+,}$n:?"; continue; fi
    known=$((known+1)); detail+="${detail:+,}$n:$p"
    prod=$(awk -v a="$prod" -v b="$p" 'BEGIN{printf "%.6f", a*(1-b)}')
    pmax=$(awk -v m="$pmax" -v b="$p" 'BEGIN{print (b>m)?b:m}')
  done
  if [ "$known" -eq 0 ]; then echo "UNKNOWN UNKNOWN UNKNOWN $detail 0 $total"; return 2; fi
  local pain viability
  pain=$(awk -v pr="$prod" 'BEGIN{printf "%.3f", 1-pr}')          # noisy-OR
  viability=$(awk -v p="$pain" 'BEGIN{printf "%.3f", 1-p}')
  echo "$pain $viability $(band "$pain") $detail $known $total"
}

if [ "${1:-}" = --test ]; then
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  export MESH_DIR="$_td" MESH="$_td" MESH_ALGEDONIC_NOW=100000 STALE_S=3600
  fail=0; chk(){ [ "$2" = "$3" ] || { echo "  FAIL: $1 → expected '$3' got '$2'"; fail=1; }; }
  fresh_write(){ printf '%s' "$2" > "$_td/$1"; touch -d "@99000" "$_td/$1"; }   # within STALE_S of NOW
  # 1) all-OK → pain 0, NOMINAL, 5/5 known
  fresh_write .therm-state OK; fresh_write .hw-health.state "HW: OK"; fresh_write .egress-state OK
  fresh_write .stress-state CALM; printf '%s\n' "m̂=0.99 [CRITICAL]" > "$_td/criticality.log"; touch -d "@99000" "$_td/criticality.log"
  read -r pain via bnd det kn tot < <(aggregate)
  chk "all-OK pain"      "$pain" 0.000
  chk "all-OK band"      "$bnd"  NOMINAL
  chk "all-OK known"     "$kn"   5
  # 2) ONE critical (therm HOT) → pain ≈0.85, registers
  fresh_write .therm-state HOT
  read -r pain via bnd det kn tot < <(aggregate)
  chk "one-critical band" "$bnd" CRITICAL
  awk -v p="$pain" 'BEGIN{exit !(p>0.84 && p<0.86)}' || { echo "  FAIL: one-critical pain=$pain not ≈0.85"; fail=1; }
  # 3) DISTRIBUTED sub-threshold: reset therm OK, set 3 moderate axes (hw WARN .5, stress STRESSED .5, crit SUBCRIT .15)
  #    → noisy-OR must light up ABOVE any single source (the death-by-a-thousand-cuts case)
  fresh_write .therm-state OK; fresh_write .hw-health.state "HW: WARN"; fresh_write .stress-state STRESSED
  printf '%s\n' "m̂=0.6 [SUBCRITICAL]" > "$_td/criticality.log"; touch -d "@99000" "$_td/criticality.log"
  read -r pain via bnd det kn tot < <(aggregate)
  awk -v p="$pain" 'BEGIN{exit !(p>0.5)}' || { echo "  FAIL: distributed-creep pain=$pain did not aggregate above moderate sources"; fail=1; }
  chk "viability complements pain" "$via" "$(awk -v p="$pain" 'BEGIN{printf "%.3f",1-p}')"
  # 3b) HONEST-FUSION (respect producer's gate): a HELD SUPERCRITICAL (meta-dominated chatter that
  #     criticality SUPPRESSED) must NOT escalate to a global CRITICAL while concrete axes are healthy;
  #     an UN-held SUPERCRITICAL (a real ALARM) still must. Reset to all-OK + drive crit only.
  fresh_write .therm-state OK; fresh_write .hw-health.state "HW: OK"; fresh_write .stress-state CALM
  printf '%s\n' "m̂=1.110 [SUPERCRITICAL] 145 bins, 296 events, meta=0.797 ALARM-HELD" > "$_td/criticality.log"; touch -d "@99000" "$_td/criticality.log"
  read -r pain via bnd det kn tot < <(aggregate)
  chk "held-supercrit band (not CRITICAL)" "$bnd" NOMINAL
  case "$det" in *crit:0.15*) : ;; *) echo "  FAIL: held-supercrit should yield crit:0.15, got $det"; fail=1 ;; esac
  printf '%s\n' "m̂=1.554 [SUPERCRITICAL] 145 bins, 260 events, meta=0.40 ALARM" > "$_td/criticality.log"; touch -d "@99000" "$_td/criticality.log"
  read -r pain via bnd det kn tot < <(aggregate)
  chk "real (un-held) supercrit band" "$bnd" CRITICAL
  case "$det" in *crit:0.9*) : ;; *) echo "  FAIL: un-held supercrit should yield crit:0.9, got $det"; fail=1 ;; esac
  # 4) HONEST-FUSION: a STALE axis is UNKNOWN, not stale-green
  touch -d "@1" "$_td/.therm-state"   # ancient → stale → excluded
  read -r pain via bnd det kn tot < <(aggregate)
  chk "stale axis excluded (known drops)" "$kn" 4
  case "$det" in *therm:\?*) : ;; *) echo "  FAIL: stale therm not marked '?': $det"; fail=1 ;; esac
  # 5) ALL unknown → UNKNOWN verdict (never a faked all-clear)
  rm -f "$_td"/.therm-state "$_td"/.hw-health.state "$_td"/.egress-state "$_td"/.stress-state "$_td"/criticality.log
  out="$(aggregate)"; rc=$?
  chk "all-unknown verdict" "$(echo "$out" | awk '{print $1}')" UNKNOWN
  chk "all-unknown rc"      "$rc" 2
  [ "$fail" = 0 ] && { echo "smoke-test: ok (noisy-OR aggregates one-critical AND distributed-creep; honest-fusion: stale→UNKNOWN, all-unknown→UNKNOWN; read-only, no escalation)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

mode="${1:---status}"
read -r pain via bnd det kn tot < <(aggregate); rc=$?
ts="$(date -u +%FT%TZ)"
if [ "$rc" = 2 ]; then
  line="$ts algedonic: UNKNOWN — all $tot axes unreachable/stale (honest-degraded, no faked all-clear) | $det"
else
  line="$ts algedonic: pain=$pain viability=$via [$bnd] axes=$det known=$kn/$tot"
fi
mkdir -p "$MESH"
printf '%s\n' "$line" >> "$LOG"
[ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 5000 ] && { tail -2500 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }
[ "$mode" = --quiet ] || printf '%s\n' "$line"
# read-only: rc mirrors the band for any consumer, but NOTHING is escalated.
case "${bnd:-UNKNOWN}" in CRITICAL) exit 1 ;; UNKNOWN) exit 2 ;; *) exit 0 ;; esac
