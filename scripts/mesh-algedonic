  rm -f "$_td"/.therm-state "$_td"/.hw-health.state "$_td"/.egress-state "$_td"/.stress-state "$_td"/criticality.log
  out="$(aggregate)"; rc=$?
  chk "all-unknown verdict" "$(echo "$out" | awk '{print $1}')" UNKNOWN
  chk "all-unknown rc"      "$rc" 2
  # 6) ALLOSTATIC LOAD sidecar: sustained moderate/high pain accumulates into LOAD_OVERLOAD while a
  #    single clean sample after a clean history stays LOAD_NOMINAL. This guards the 2025-2026 live-review
  #    transfer: cumulative burden over time, not only instantaneous noisy-OR.
  : > "$_td/algedonic.log"
