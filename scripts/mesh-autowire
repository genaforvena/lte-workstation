#!/usr/bin/env bash
# mesh-autowire — CLOSES the autopoiesis loop at the integration step. A tool the genome mind builds
# gets committed, landed, deployed (sync-tools) — but it never becomes part of the operating
# metabolism unless a human wires it into cron (your doctrine even marks unwired tools decay-eligible).
# So produced components don't auto-integrate → the production loop is OPEN. This closes it: any
# deployed mesh tool that SELF-DECLARES a cadence (header tag `# reflex-cadence: <cron schedule>`)
# AND passes its own `--test` is auto-wired into ~/.mesh/reflexes.cron (the self-healing desired set;
# mesh-reflexes --apply then syncs it into the live crontab, add-only/never-drop).
#
# Conservative + reversible by design (it edits the node's own cron — power that needs guardrails):
#   - OPT-IN: only tools carrying the explicit `# reflex-cadence:` tag (a tool isn't wired unless its
#     author intended it as a reflex). Optional `# reflex-args: <args>` for arguments.
#   - GATED: the tool's `--test` must PASS, else skip + log (never wire a broken reflex).
#   - IDEMPOTENT: skip anything already present in reflexes.cron.
#   - VISIBLE + REVERSIBLE: every wire is logged, posted to the board, and tagged `# autowired <date>`
#     in reflexes.cron (delete the line to un-wire).
#   - CARD-GATED: HANDS-OFF a node that declares no minds.
#   mesh-autowire           wire every eligible-but-unwired tagged tool
#   mesh-autowire --check    list candidates + the gate's REAL verdict per candidate (no changes).
#                            Runs each candidate's --test, so it costs what the wire path costs.
#   mesh-autowire --test     smoke test
# reflex-cadence: */30 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; CRON="$M/reflexes.cron"; BIN="$HOME/.local/bin"; LOG="$M/autowire.log"
REPO="${MESH_REPO:-$HOME/lte-workstation}"   # genome source-of-truth dir (same resolution as mesh-sync-tools)
ts(){ date -u +%FT%TZ; }

# extract the cadence tag value from a file (empty if absent/malformed)
cadence_of(){ sed -nE 's/^# *reflex-cadence: *(.+)$/\1/p' "$1" 2>/dev/null | head -1; }
args_of(){    sed -nE 's/^# *reflex-args: *(.+)$/\1/p'    "$1" 2>/dev/null | head -1; }

# resolve_cadence <deployed_path> <source_path_or_empty> -> echoes a verdict (pure, offline-testable):
#   "NONE"            deployed declares NO cadence (nothing to wire — not a warning case)
#   "SKIP"            deployed declares a cadence BUT a PRESENT genome source declares none → the deployed
#                     copy is STALE DRIFT; do NOT resurrect a cadence genome removed (the bug this fixes:
#                     misha-eye-contact on ds, 2026-07-04). Source-of-truth wins for genome-tracked tools.
#   "WIRE <cad>"      use <cad>: source's when both present and agree (genome is truth); deployed's when
#                     the tool is NODE-LOCAL (no genome source to arbitrate — unchanged behavior).
#   "DRIFT <cad>"     both present but their cadences DIFFER → use SOURCE's <cad> (genome is truth); the
#                     loop logs a NOTE so the divergence is visible (self-heals on next deploy).
# copy_name_reason <name> <bindir> -> prints WHY <name> is a stale copy and returns 0; returns 1 if
# it is a real tool. A copy keeps its reflex-cadence header and would run as a second organ writing
# the SAME state artifact with STALE code (the 2026-06-28 mesh-body-motion.*-backup case).
#
# A COPY IS NAMED AFTER THE TOOL IT COPIES — that, not the substring "backup", is the tell. This was
# a bare `*backup*` glob, which made every tool whose SUBJECT is backing something up permanently
# un-wireable: mesh-body-backup (the Redmi identity puller, 2026-08-15) declared a cadence, passed
# its gate, and was dropped here without ever appearing in --check or --apply. A never-wired reflex
# produced by the guard rather than by the tool, and invisible in exactly the place you would look.
copy_name_reason(){
  local name="$1" bin="${2:-}" stem
  case "$name" in
    *.bak|*.old|*.tmp|*.orig|*~) printf 'backup/temp copy, not a tool\n'; return 0 ;;
    *backup*)
      stem="${name%%-backup*}"; stem="${stem%%.backup*}"
      if [ "$stem" != "$name" ] && [ -e "$bin/$stem" ]; then
        printf 'backup copy of %s, not a tool\n' "$stem"; return 0
      fi ;;
  esac
  return 1
}

resolve_cadence(){
  local dep="$1" src="${2:-}" depcad srccad
  depcad="$(cadence_of "$dep")"
  [ -n "$depcad" ] || { printf 'NONE\n'; return; }
  if [ -n "$src" ] && [ -f "$src" ]; then
    srccad="$(cadence_of "$src")"
    [ -n "$srccad" ] || { printf 'SKIP\n'; return; }
    # compare + emit CLEANED cadences (drop inline notes) so a benign note never false-triggers DRIFT
    # and the verdict always carries a canonical 5-field schedule.
    if [ "$(clean_cadence "$depcad")" = "$(clean_cadence "$srccad")" ]; then printf 'WIRE %s\n' "$(clean_cadence "$srccad")"
    else                                                                    printf 'DRIFT %s\n' "$(clean_cadence "$srccad")"; fi
  else
    printf 'WIRE %s\n' "$(clean_cadence "$depcad")"     # node-local: deployed is the only truth (unchanged)
  fi
}
# a cron schedule is exactly 5 fields (min hr dom mon dow); authors often append an inline note
# ("* */6 * * * (every 6 hours)") — keep only the first 5 tokens so the note doesn't fail the parser.
clean_cadence(){ printf '%s' "$1" | awk '{ if (NF>=5) print $1,$2,$3,$4,$5; else print $0 }'; }
# intentional-skip sentinels: the author declared a reflex that must NOT be host-wired (phone-only
# @reboot via Termux:Boot, on-demand, manually-run). Skip it SILENTLY — it is not a malformed cadence.
is_skip_sentinel(){ case "$1" in none|None|NONE|@reboot|on-demand|manual|off) return 0;; *) return 1;; esac; }
# a cron schedule = 5 fields (min hr dom mon dow), each from the cron charset. Reject anything else
# (don't inject a malformed/garbage line into crontab).
valid_cadence(){ printf '%s' "$1" | grep -qE '^[-0-9*,/ ]+$' && [ "$(printf '%s' "$1" | awk '{print NF}')" = 5 ]; }
# A STEPPED RANGE CAN COLLAPSE TO ONE FIRE AND STILL BE VALID CRON. `19-59/45` is charset-clean,
# 5-field, and accepted by cron — and it fires ONCE per hour (19, then 64 > 59), not every 45 min.
# valid_cadence cannot catch it: it is not malformed, it is MISLEADING, and the declaration is the
# only place the intended period is ever written down. mesh-phone-prox carried exactly this for its
# whole wired life: header said 45 min, phone proximity was sampled ~2s once an hour (0.06% coverage)
# and its 2-consecutive debounce needed a NEAR to persist TWO HOURS to publish — while the header's
# own use-cases (hand-over-screen, phone-against-ear) all last seconds. Warn, never skip: an unwired
# reflex is worse than a slow one. Echoes a diagnostic when field 1 is `A-B/N` firing < 2 times.
cadence_collapse(){
  _m="$(printf '%s' "$1" | awk '{print $1}')"
  case "$_m" in *-*/*) ;; *) return 1 ;; esac
  _a="${_m%%-*}"; _rest="${_m#*-}"; _b="${_rest%%/*}"; _n="${_rest##*/}"
  case "$_a$_b$_n" in *[!0-9]*|'') return 1 ;; esac
  [ "$_n" -gt 0 ] 2>/dev/null || return 1
  _c=0; _v="$_a"; while [ "$_v" -le "$_b" ]; do _c=$((_c+1)); _v=$((_v+_n)); done
  [ "$_c" -ge 2 ] && return 1
  printf 'minute field %s fires %d time(s) per hour, not every %s min (%s+%s=%d > %s) — real period is 60 min' \
    "$_m" "$_c" "$_n" "$_a" "$_n" "$((_a+_n))" "$_b"
}
# THE MESH HAS TWO SCHEDULERS, and this tool could only see one. reflexes.cron is ours; the OTHER is
# mesh-liveness-loop's TASKS table (user systemd, deliberately cron-free). A tool present in both runs
# TWICE per cadence, seconds apart — and the harm is correctness, not cost: mesh-node-care commits a
# state only after "2 consecutive identical raw reads", a guard whose whole meaning is 2 reads ONE
# CADENCE apart. Two runs in the same minute collapse that window, so one dropped SSH probe reads twice
# and commits — phaedra posted [node-down] at 10:35Z with its uptime monotonic straight through
# (47225→47245m). It never left. Same shape for any debounce/hysteresis reflex.
# The liveness path is a PARAMETER so --test drives this against fixtures, not the live scheduler.
LIVENESS_SRC="${MESH_LIVENESS_SRC-$(command -v mesh-liveness-loop 2>/dev/null || true)}"
liveness_tasks(){ # $1=liveness-loop script → basenames of every tool in its TASKS table (empty if unreadable)
  [ -n "${1:-}" ] && [ -r "$1" ] || return 0
  sed -n '/^TASKS=(/,/^)/p' "$1" 2>/dev/null \
    | sed -nE 's@^[[:space:]]*"[^"|]*\|[0-9]+\|([^ "]+).*@\1@p' | sed -E 's@.*/@@'
}
# FAIL-OPEN by design: an unreadable/absent liveness-loop yields no tasks → nothing is skipped. A
# broken read must never mute the whole autowire pass (that would be a silent fallback wearing a
# green face — the exact trap in doctrine); it may only fail to catch a duplicate.
liveness_scheduled(){ liveness_tasks "${2-$LIVENESS_SRC}" | grep -qxF "$1"; }
# stdout journal for a wired reflex: <name-sans-mesh>.log — UNLESS the tool itself references an
# artifact of that exact name (its own structured log/telemetry): appending cron stdout there
# mixes human status lines into the tool's data (the mesh-gpu-activity → gpu-activity.log
# collision, 2026-07-02: telemetry + human line interleaved every run). Collision → journal to
# <name-sans-mesh>.cron.log instead. Emits a LITERAL $HOME (cron expands it at run time).
journal_of(){ # $1=tool-path $2=tool-name
  local stem="${2#mesh-}"
  if grep -q "\.mesh/${stem}\.log" "$1" 2>/dev/null; then
    printf '$HOME/.mesh/%s.cron.log' "$stem"
  else
    printf '$HOME/.mesh/%s.log' "$stem"
  fi
}
# classify a --test exit code (pure). The mesh --test contract (doctrine + mesh-land:79) is THREE-valued:
#   0 = pass · 2 = honest n/a (the organ this tool reads is not present/reachable HERE) · other = broken.
# Autowire used to fold 2 into "FAILED (refuse to wire a broken reflex)" — a false accusation against a
# sound tool: mesh-wifi-temp exits 2 on the mind node (no iwlwifi hwmon, it reads rtl88XXau) and the
# claim then tails straight onto the genome dash as a defect to chase. Both verdicts still SKIP — a
# reflex whose organ is absent must not be cron-wired here (node-bound senses, doctrine) — but N/A is
# not-my-organ, not broken, and if the organ is merely offline the next */30 run wires it (self-healing).
# rc=124 IS NOT rc=1 (2026-08-19). A timeout is the budget running out with the tool's OWN verdict still
# unheard; folding it into FAIL made autowire log "refuse to wire a broken reflex" about a tool that is
# not broken, and — worse than the wording — a suite HEAVIER than the budget could then never be wired at
# all, which is the "reflex that was never wired" failure arriving through the front door. Third instance
# of one shape in one day: mesh-land held such a candidate forever (3bba9be) and mesh-fitness REVERTED on
# it (c8655ac). The budget moved with them: 30s did not cover this genome's real suites — scripts/mesh-dash
# --test is 40-52s GREEN, and mesh-land's and mesh-fitness's own suites now sit at 47s and 34s, i.e. the
# tools that fixed this were themselves unwirable under the old ceiling.
AW_TEST_TIMEOUT="${MESH_AUTOWIRE_TEST_TIMEOUT:-180}"
# ── IS THE GENOME SIDE ACTUALLY IN THE GENOME? ────────────────────────────────────────────────
# The loop below takes $REPO/scripts/$name as "the genome source" on the strength of `[ -f ]`, i.e.
# it accepts PRESENT IN THE WORKING TREE as COMMITTED. Those are different claims, and every genome
# edit spends time in the gap between them: mesh-land deliberately holds a file for 600s of settle
# before it commits anything, and an unlanded new tool can sit in scripts/ for hours. So a NEW tool
# dropped in scripts/ with a `# reflex-cadence:` header and deployed to $BIN becomes wireable by the
# next */30 autowire pass, before any mind has landed it — which is how the untracked
# mesh-exit-node-failover came within one pass of being wired at '* * * * *' as a SECOND WRITER on
# the exit-node pref mesh-revive already actuates. Committed is this mesh's only review boundary.
# [[a-dirty-checkout-cannot-testify-about-head]]
#
# THREE-VALUED ON PURPOSE, and the third value is the load-bearing one. A planted node may hold
# scripts/ as an rsync'd tree with no .git at all, and a fresh clone has no HEAD; if "cannot decide"
# collapsed into "untracked", this gate would silently un-wire every source-having reflex on every
# such node — a guard producing a mesh-wide dark edge, which is worse than the fault it prevents.
# Undecidable therefore means PROCEED, exactly as before this commit.
# A tool with NO source file is untouched too: node-local-deployed-is-truth is a deliberate, tested
# arm of resolve_cadence and this gate must not swallow it.
# THE PATH IS THE ARGUMENT'S OWN, never scripts/ + its basename (fixed 2026-08-29, {#62d615cf}).
# The caller already resolved which source dir carries the tool; re-deriving it here as
# "scripts/<basename>" made every job/ tool answer rc 1 — present but never committed — so a landed
# lane reflex was refused wiring with a message accusing the operator of not having landed it. The
# failure is loud in the log and silent in the crontab, which is the worst pair: someone reads the
# SKIP, lands the already-landed file, and nothing changes.
src_at_head(){ # rc 0 = tracked at HEAD · rc 1 = present but NEVER committed · rc 2 = UNDECIDABLE
  local abs="$1" rel
  case "$abs" in /*) : ;; *) abs="$REPO/$abs" ;; esac
  rel="${abs#"$REPO"/}"
  # a source that is not under the repo at all cannot be decided BY the repo — undecidable (proceed),
  # never "untracked", by the same three-valued rule the comment above states.
  [ "$rel" != "$abs" ] || return 2
  command -v git >/dev/null 2>&1 || return 2
  git -C "$REPO" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 2   # no repo / no commits yet
  # ls-tree prints NOTHING both for a path absent from HEAD and for an invocation git refused, so
  # the empty output alone cannot carry the verdict — the rc is what separates them.
  local out rc
  out="$(git -C "$REPO" ls-tree --name-only HEAD -- "$rel" 2>/dev/null)"; rc=$?
  [ "$rc" = 0 ] || return 2
  [ -n "$out" ] && return 0
  return 1
}
gate_verdict(){ case "$1" in 0) printf 'PASS\n';; 2) printf 'NA\n';; 124) printf 'UNKNOWN\n';; *) printf 'FAIL\n';; esac; }
# the SKIP reason a verdict earns — a function so the wording is assertable, and so "broken" can never
# quietly re-attach itself to a verdict that never heard the tool speak.
gate_skip_reason(){ case "$1" in
    FAIL)    printf -- '--test FAILED rc=%s (refuse to wire a broken reflex)' "$2" ;;
    NA)      printf -- '--test n/a rc=2 (organ absent on this node — tool is sound, not wiring here)' ;;
    TOMB)    printf -- 'already named by %s (commented-out — decommissioned on purpose; not a candidate, and the --test gate below is never reached)' "$2" ;;
    UNTRACKED) printf -- 'genome source %s exists but is NOT TRACKED AT HEAD — never committed, so it is a working-tree file and not the genome; land it (mesh-land) and the next pass wires it' "$2" ;;
    UNKNOWN) printf -- '--test verdict UNKNOWN: exceeded the %ss gate budget rc=124 — unverified, not an accusation; not wiring on a gate that never returned. Raise MESH_AUTOWIRE_TEST_TIMEOUT or speed the suite up' "$3" ;;
  esac; }

# THE SCHEDULE OF THE LINE THAT NAMES A TOOL — the declared-vs-actual gap one layer BELOW
# mesh-reflexes' desired-vs-live divergence (36aa9cf). `schedule_naming` decided "already wired" by
# NAME ALONE (`grep -nE "[/]$name( |$)"`), so a tool whose cron line runs at a schedule DIFFERENT
# from its own `# reflex-cadence:` header returned LIVE and was skipped by a bare `continue`: the
# header that DECLARES the cadence is not the cadence that RUNS, and no --check line ever said so.
# autowire stays ADD-ONLY — it must never re-pace a line someone paced on purpose (that is exactly
# the preserved-singleton policy mesh-reflexes defends) — so the fix is not a repair, it is that the
# LIVE verdict now CARRIES the comparison and the divergence gets NAMED.
# Only a SINGLETON active naming can diverge (the rule copied from DIVERGE_PY): with two active lines
# "what schedule runs it" has no single answer, and duplicate namings are a different fault.
line_sched(){ # $1 = a crontab line -> normalized schedule ('@keyword' or 5 single-spaced fields), empty if neither
  printf '%s\n' "$1" | awk '{ if ($1 ~ /^@/) { print $1; exit } if (NF < 6) exit 0; print $1,$2,$3,$4,$5 }'
}
# WHERE a tool is NAMED in the schedule, and whether that naming is LIVE or a TOMBSTONE.
# The already-wired test was one comment-blind grep (`grep -qE "[/]$name( |$)"`) followed by a bare
# `continue` — so a tool named ONLY by a commented-out line was not WOULD WIRE, not WOULD SKIP, but
# ABSENT from --check entirely, and an absence in a dry-run reads as "nothing to worry about".
# Measured on mesh-home 2026-08-19: reflexes.cron:220 is the 2026-08-11 decommission tombstone for
# mesh-egress-tunnel — the ONE reflex this node must never re-raise (CLAUDE.md's NESTING invariant,
# the tunnel the operator had to `wg-quick down` by hand). `mesh-autowire --check | grep egress-tunnel`
# printed NOTHING; strip that single comment from a copy and the same command prints
# "WOULD SKIP mesh-egress-tunnel: --test n/a rc=2". So the tool has TWO independent guards (this
# tombstone, reached first; the rc=2 gate, reached never) and CLAUDE.local.md cites --check as the
# evidence for the SECOND — evidence --check has never printed. Both guards are real; the dry-run
# showed neither, and if anyone tidies the comment away the guard silently changes identity from grep
# to gate with no line moving anywhere. The tombstone STAYS (a decommission must be visible in the
# file); what changes is that a deliberate absence now READS as deliberate. Sibling of 6ea1303 one
# loop-iteration earlier: same dry-run, same shape — the step that decides was the step not rendered.
live_crontab(){ # the user's live crontab — a FILE override keeps --test hermetic (a fake HOME does not fake crontab)
  if [ -n "${MESH_AUTOWIRE_CRONTAB_SRC-}" ]; then cat "$MESH_AUTOWIRE_CRONTAB_SRC" 2>/dev/null
  else crontab -l 2>/dev/null; fi
}
# echoes: nothing (not named) | "LIVE <src>:<lineno>|<schedule>" | "LIVE" (ambiguous: 2+ active
# namings, no single schedule to quote) | "TOMB <src>:<lineno>"   — LIVE wins wherever both appear.
schedule_naming(){ # $1=tool-name
  _sn_n="$1"; _sn_tomb=''
  for _sn_src in desired live; do
    case "$_sn_src" in
      desired) _sn_txt="$(cat "$CRON" 2>/dev/null)"; _sn_lbl="$(basename "$CRON")" ;;
      live)    _sn_txt="$(live_crontab)"; _sn_lbl="crontab" ;;
    esac
    [ -n "$_sn_txt" ] || continue
    _sn_hits="$(printf '%s\n' "$_sn_txt" | grep -nE "[/]$_sn_n( |$)")" || continue
    # an ACTIVE naming (a hit whose line is not commented out) means it really is scheduled → skip,
    # but quote WHERE and at WHAT schedule so the caller can compare it against the header's cadence.
    _sn_act="$(printf '%s\n' "$_sn_hits" | grep -vE '^[0-9]+:[[:space:]]*#')" || _sn_act=''
    if [ -n "$_sn_act" ]; then
      if [ "$(printf '%s\n' "$_sn_act" | grep -c .)" = 1 ]; then
        printf 'LIVE %s:%s|%s\n' "$_sn_lbl" "${_sn_act%%:*}" "$(line_sched "${_sn_act#*:}")"
      else
        printf 'LIVE\n'   # 2+ active namings: no singleton schedule to compare against
      fi
      return 0
    fi
    [ -n "$_sn_tomb" ] || _sn_tomb="$_sn_lbl:$(printf '%s\n' "$_sn_hits" | head -1 | cut -d: -f1)"
  done
  [ -n "$_sn_tomb" ] && printf 'TOMB %s\n' "$_sn_tomb"
  return 0
}

# --check's line for a candidate, AFTER the gate has spoken. A dry-run must report the DECISION, not
# the intent. For the life of this tool --check printed "WOULD WIRE:" for every candidate because it
# `continue`d one line BEFORE the --test gate — the single step that decides was the single step the
# dry-run skipped, so --check reported what the loop WANTED before asking the only question that could
# say no. Measured on mesh-home 2026-08-19: all 15 "WOULD WIRE" lines were tools the gate SKIPs (every
# one rc=2, organ absent — mesh-agy/battery*/cam-power/conservation/cpu-*/fail2ban-watch/gpu-activity/
# reddit-watch/screen-state/turbo-lid/wifi-*), i.e. the answer was 100% wrong on this node, in the
# direction that reads as "this WILL be wired". CLAUDE.md cites this very --check as the verification
# that mesh-fail2ban-watch is skipped where fail2ban-client is absent — a claim --check could not make,
# and did not make. Sibling of the doctrine shape "source text is never behaviour": here the dry-run
# text was never the run. COST: --check now pays the same --test budget the wire path pays; that
# symmetry IS the fix (a dry-run cheaper than the run because it omits the deciding step is the bug).
# The verdict word is the assertable surface, hence a function rather than an inline echo.
check_render(){ # $1=verdict $2=name $3=line $4=rc $5=timeout
  case "$1" in
    PASS) printf 'WOULD WIRE: %s\n' "$3" ;;
    *)    printf 'WOULD SKIP %s: %s\n' "$2" "$(gate_skip_reason "$1" "$4" "$5")" ;;
  esac
}

if [ "${1:-}" = --test ]; then
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  command -v mesh-reflexes >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-reflexes)"; exit 1; }
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  # ── THE SPOOL SENTINEL ────────────────────────────────────────────────────────────────────────
  # This suite drives the REAL (non---check) apply path under a fake HOME. A fake HOME fakes every
  # file this tool reads, and it fakes NOTHING about `crontab`, which addresses the calling UID's
  # spool and has never heard of $HOME. The read side was already parameterised
  # (MESH_AUTOWIRE_CRONTAB_SRC, "a fake HOME does not fake crontab" at line_sched's live_crontab);
  # the WRITE side was not, so on 2026-08-27 the tracked-gate fixtures below — mesh-awgit-nosrc and
  # mesh-awgit-tracked — were appended to this node's live crontab by mesh-autowire --test itself
  # and fired */10 at a tool that exists nowhere for 17h, 2 of the node's 4 mesh-doctor FAILs.
  # A --test that mutates the substrate is the dry-run-forges-its-own-evidence rule one ring out.
  # So: hash the spool now, assert it byte-identical before "smoke-test: ok", and shadow `crontab`
  # inside each fake HOME's .local/bin (which BOTH this tool and mesh-reflexes put first on PATH)
  # so the write is caught in the sandbox instead of merely being noticed after the fact.
  _spool_before=""; _spool_have=0
  if command -v crontab >/dev/null 2>&1; then _spool_before="$(crontab -l 2>/dev/null | cksum)"; _spool_have=1; fi
  printf '#!/bin/sh\n# reflex-cadence: */10 * * * *\n# reflex-args: --edge\n' > "$td/tool"
  [ "$(cadence_of "$td/tool")" = "*/10 * * * *" ] || { echo "smoke-test: FAIL (cadence parse: got '$(cadence_of "$td/tool")')"; exit 1; }
  [ "$(args_of "$td/tool")" = "--edge" ] || { echo "smoke-test: FAIL (args parse)"; exit 1; }
  valid_cadence "*/10 * * * *" || { echo "smoke-test: FAIL (valid cadence rejected)"; exit 1; }
  valid_cadence "rm -rf /; * * * *" && { echo "smoke-test: FAIL (injection accepted as cadence)"; exit 1; }
  valid_cadence "*/10 * * *" && { echo "smoke-test: FAIL (4-field accepted)"; exit 1; }
  # inline-note stripping: "0 */6 * * * (every 6h)" must reduce to a valid 5-field schedule
  [ "$(clean_cadence '0 */6 * * * (every 6h)')" = "0 */6 * * *" ] || { echo "smoke-test: FAIL (clean_cadence note-strip)"; exit 1; }
  valid_cadence "$(clean_cadence '* * * * * (every minute is fine)')" || { echo "smoke-test: FAIL (cleaned cadence rejected)"; exit 1; }
  # sentinels skipped, real schedules not
  is_skip_sentinel "@reboot" || { echo "smoke-test: FAIL (@reboot not recognized as skip)"; exit 1; }
  is_skip_sentinel "on-demand" || { echo "smoke-test: FAIL (on-demand not recognized as skip)"; exit 1; }
  is_skip_sentinel "*/10" && { echo "smoke-test: FAIL (real cadence misread as sentinel)"; exit 1; }

  # --- collapsed stepped-range gate (mesh-phone-prox declared 19-59/45, fired hourly) ---
  # The collapse must be DETECTED where cron accepts it, and must NOT fire on the ordinary forms —
  # a detector that flags 9-59/10 would warn on most of the mesh and be tuned out within a day.
  _cc="$(cadence_collapse '19-59/45 * * * *')" || { echo "smoke-test: FAIL (19-59/45 collapse not detected)"; exit 1; }
  case "$_cc" in *"fires 1 time(s) per hour"*) ;; *) echo "smoke-test: FAIL (collapse text does not name the real rate: '$_cc')"; exit 1;; esac
  case "$_cc" in *"19+45=64 > 59"*) ;; *) echo "smoke-test: FAIL (collapse text does not show the arithmetic: '$_cc')"; exit 1;; esac
  for _ok in '9-59/10 * * * *' '2-59/5 * * * *' '13-59/30 * * * *' '*/10 * * * *' '0 6 * * *' '7,37 * * * *' '19 * * * *'; do
    cadence_collapse "$_ok" >/dev/null && { echo "smoke-test: FAIL (false collapse on '$_ok')"; exit 1; }
  done
  cadence_collapse '30-59/40 * * * *' >/dev/null || { echo "smoke-test: FAIL (30-59/40 collapse not detected)"; exit 1; }
  # the boundary is A+N<=B, not a round number: 19-59/40 fires at 19 AND 59 (two), 20-59/40 fires once (60>59).
  cadence_collapse '19-59/40 * * * *' >/dev/null && { echo "smoke-test: FAIL (19-59/40 fires twice — not a collapse)"; exit 1; }
  cadence_collapse '20-59/40 * * * *' >/dev/null || { echo "smoke-test: FAIL (20-59/40 IS a collapse — 20+40=60 > 59)"; exit 1; }
  cadence_collapse 'a-b/c * * * *' >/dev/null && { echo "smoke-test: FAIL (non-numeric range accepted)"; exit 1; }
  cadence_collapse '5-59/0 * * * *' >/dev/null && { echo "smoke-test: FAIL (zero step must not loop/flag)"; exit 1; }
  # ARTIFACT gate: drive the REAL loop from a fixture HOME (never the live ~/.mesh — a --test that writes
  # the durable autowire.log forges the evidence it exists to check) and assert the WARN reaches BOTH the
  # log and --check stdout, and that the tool is STILL wired (warn, not skip). Fixture is named
  # mesh-zzfixture, NOT anything containing "collapse": a name that matches the pattern under test makes
  # the gate self-satisfying (a grep -c on the poisoned arm counted the tool's own NAME, seen).
  _fh="$td/fixthome"; mkdir -p "$_fh/.local/bin" "$_fh/.mesh" "$_fh/genome/scripts"
  cp "$HOME/.mesh-card" "$_fh/.mesh-card" 2>/dev/null || printf 'minds: claude\n' > "$_fh/.mesh-card"
  : > "$_fh/.mesh/reflexes.cron"
  _mk(){ printf '#!/bin/sh\n# reflex-cadence: %s * * * *\n[ "$1" = --test ] && { echo ok; exit 0; }\n' "$1" > "$_fh/.local/bin/mesh-zzfixture"
         chmod +x "$_fh/.local/bin/mesh-zzfixture"; cp "$_fh/.local/bin/mesh-zzfixture" "$_fh/genome/scripts/mesh-zzfixture"; : > "$_fh/.mesh/autowire.log"; }
  # MUST be $0 — the script under test. `command -v mesh-autowire` resolves to the DEPLOYED copy, so the
  # gate would run the PREVIOUS build and pass/fail on code that is not the candidate (seen: green-then-red).
  case "$0" in /*) _me="$0" ;; *) _me="$PWD/$0" ;; esac
  _mk '19-59/45'
  _out="$(HOME="$_fh" MESH_REPO="$_fh/genome" timeout 60 "$_me" --check 2>&1)" || true
  case "$_out" in *"COLLAPSED CADENCE mesh-zzfixture"*) ;; *) echo "smoke-test: FAIL (real loop did not report the collapse on --check stdout)"; exit 1;; esac
  case "$_out" in *"WOULD WIRE"*) ;; *) echo "smoke-test: FAIL (collapsed cadence was SKIPPED — must warn, not skip)"; exit 1;; esac
  grep -q 'WARN mesh-zzfixture: cadence COLLAPSES' "$_fh/.mesh/autowire.log" || { echo "smoke-test: FAIL (collapse WARN never reached autowire.log)"; exit 1; }
  _mk '2-59/10'
  _out="$(HOME="$_fh" MESH_REPO="$_fh/genome" timeout 60 "$_me" --check 2>&1)" || true
  case "$_out" in *"COLLAPSED CADENCE"*) echo "smoke-test: FAIL (control arm 2-59/10 flagged as collapsed)"; exit 1;; esac
  case "$_out" in *"WOULD WIRE"*) ;; *) echo "smoke-test: FAIL (control arm not wired)"; exit 1;; esac
  [ "$(grep -c WARN "$_fh/.mesh/autowire.log")" = 0 ] || { echo "smoke-test: FAIL (control arm wrote a WARN)"; exit 1; }

  # the whole mesh's OWN declarations must be clean after this fix — the sweep is the artifact, not the unit test
  if [ -d "$REPO/scripts" ]; then
    _bad=0
    for _f in "$REPO"/scripts/mesh-*; do
      _c="$(clean_cadence "$(cadence_of "$_f")")"; [ -n "$_c" ] || continue
      valid_cadence "$_c" || continue
      _d="$(cadence_collapse "$_c")" && { echo "smoke-test: FAIL (genome still declares a collapsed cadence: $(basename "$_f") — $_d)"; _bad=1; }
    done
    [ "$_bad" = 0 ] || exit 1
  fi

  # --- double-scheduling gate (chat-review/node-care-double-scheduled) ---
  # Fixture mirrors mesh-liveness-loop's REAL TASKS syntax: "name|cadence_sec|command [args]".
  cat > "$td/liveness" <<'EOF'
#!/usr/bin/env bash
TASKS=(
  "consume-ensure|60|mesh-consume-all"
  "node-care|300|mesh-node-care"
  "session-watchdog|600|mesh-session-watchdog --edge"
  "restore|300|/home/x/.local/bin/mesh-restore"
)
EOF
  # in the table → caught (the bug: this returned false, so cron wired a second copy)
  liveness_scheduled mesh-node-care "$td/liveness" || { echo "smoke-test: FAIL (mesh-node-care in TASKS not detected)"; exit 1; }
  # with args → the command's first token is what schedules
  liveness_scheduled mesh-session-watchdog "$td/liveness" || { echo "smoke-test: FAIL (task with args not detected)"; exit 1; }
  # full-path command form → basename must match
  liveness_scheduled mesh-restore "$td/liveness" || { echo "smoke-test: FAIL (absolute-path task not detected)"; exit 1; }
  # NOT in the table → must still wire (a blanket skip would strand every real reflex)
  liveness_scheduled mesh-tick "$td/liveness" && { echo "smoke-test: FAIL (mesh-tick absent from TASKS but reported scheduled)"; exit 1; }
  # substring must not match: node-care is in the table, node-care-extra is NOT
  liveness_scheduled mesh-node-care-extra "$td/liveness" && { echo "smoke-test: FAIL (substring false-positive)"; exit 1; }
  # a task name is not a tool name (field 1 must not be read as the command)
  liveness_scheduled node-care "$td/liveness" && { echo "smoke-test: FAIL (TASKS field-1 label matched as a tool)"; exit 1; }
  # lines outside the TASKS array must not be harvested
  printf 'OTHER=(\n  "x|60|mesh-decoy"\n)\n' >> "$td/liveness"
  liveness_scheduled mesh-decoy "$td/liveness" && { echo "smoke-test: FAIL (harvested a non-TASKS array)"; exit 1; }
  # FAIL-OPEN: no liveness-loop → no tasks → nothing skipped (never mute the whole pass)
  liveness_scheduled mesh-node-care "$td/nonexistent" && { echo "smoke-test: FAIL (absent liveness-loop must not report scheduled)"; exit 1; }
  [ -z "$(liveness_tasks "$td/nonexistent")" ] || { echo "smoke-test: FAIL (absent liveness-loop yielded tasks)"; exit 1; }
  # and it reads the LIVE scheduler when deployed — the table is non-empty on a mind node
  if [ -n "$LIVENESS_SRC" ] && [ -r "$LIVENESS_SRC" ]; then
    [ -n "$(liveness_tasks "$LIVENESS_SRC")" ] || { echo "smoke-test: FAIL (live mesh-liveness-loop present but its TASKS table parsed EMPTY — syntax drifted, gate is blind)"; exit 1; }
  fi
  # journal-collision guard: a tool writing its own <stem>.log must NOT get that as its journal
  printf '#!/bin/sh\nLOG="$HOME/.mesh/fixt.log"\n' > "$td/mesh-fixt"
  [ "$(journal_of "$td/mesh-fixt" mesh-fixt)" = '$HOME/.mesh/fixt.cron.log' ] \
    || { echo "smoke-test: FAIL (journal collision not deflected: got '$(journal_of "$td/mesh-fixt" mesh-fixt)')"; exit 1; }
  [ "$(journal_of "$td/tool" mesh-fixt2)" = '$HOME/.mesh/fixt2.log' ] \
    || { echo "smoke-test: FAIL (clean tool journal changed: got '$(journal_of "$td/tool" mesh-fixt2)')"; exit 1; }

  # resolve_cadence — the stale-deployed-resurrection guard (chat-review/autowire-stale-deployed-resurrects):
  mkstub(){ printf '#!/bin/sh\n# reflex-cadence: %s\n' "$2" > "$td/$1"; }   # $1=file $2=cadence
  # 1. deployed declares */10 but genome SOURCE has none  -> SKIP (the bug: don't resurrect)
  mkstub dep1 '*/10 * * * *'; printf '#!/bin/sh\n# (no reflex-cadence — genome removed it)\n' > "$td/src1"
  [ "$(resolve_cadence "$td/dep1" "$td/src1")" = SKIP ] || { echo "smoke-test: FAIL (deployed-has/source-none must SKIP: got '$(resolve_cadence "$td/dep1" "$td/src1")')"; exit 1; }

  # copy-name filter, BOTH directions — the guard has to keep excluding real copies while no longer
  # excluding real tools. Driven against a fake bindir so the verdict is code, not this node's PATH.
  cnb="$td/cn"; mkdir -p "$cnb"; : > "$cnb/mesh-body-motion"     # the tool a copy would copy
  copy_name_reason mesh-body-motion.bak        "$cnb" >/dev/null || { echo "smoke-test: FAIL (.bak must be a copy)"; exit 1; }
  copy_name_reason mesh-body-motion-backup     "$cnb" >/dev/null || { echo "smoke-test: FAIL (mesh-body-motion-backup next to mesh-body-motion must be a copy)"; exit 1; }
  copy_name_reason mesh-body-motion-backup-20260628 "$cnb" >/dev/null || { echo "smoke-test: FAIL (dated backup copy must be a copy)"; exit 1; }
  copy_name_reason mesh-body-backup            "$cnb" >/dev/null && { echo "smoke-test: FAIL (mesh-body-backup with no mesh-body present is a REAL TOOL — this is the bug that made it permanently un-wireable)"; exit 1; }
  copy_name_reason mesh-tick                   "$cnb" >/dev/null && { echo "smoke-test: FAIL (ordinary tool misread as a copy)"; exit 1; }
  # 2. both AGREE on the cadence -> WIRE <cad> (source is truth, same value)
  mkstub dep2 '*/10 * * * *'; mkstub src2 '*/10 * * * *'
  [ "$(resolve_cadence "$td/dep2" "$td/src2")" = "WIRE */10 * * * *" ] || { echo "smoke-test: FAIL (both-agree must WIRE: got '$(resolve_cadence "$td/dep2" "$td/src2")')"; exit 1; }
  # 3. node-local tool (no source path) -> deployed cadence honored as today (unchanged)
  mkstub dep3 '*/5 * * * *'
  [ "$(resolve_cadence "$td/dep3" "")" = "WIRE */5 * * * *" ] || { echo "smoke-test: FAIL (node-local must honor deployed: got '$(resolve_cadence "$td/dep3" "")')"; exit 1; }
  # 4. deployed declares nothing -> NONE (not a warning; nothing to wire)
  printf '#!/bin/sh\n# (no cadence)\n' > "$td/dep4"; [ "$(resolve_cadence "$td/dep4" "$td/src2")" = NONE ] || { echo "smoke-test: FAIL (no deployed cadence must be NONE: got '$(resolve_cadence "$td/dep4" "$td/src2")')"; exit 1; }
  # 5. both present but DIFFER -> DRIFT <source-cad> (genome wins; inline-note stripping keeps a noted
  #    cadence equal to its clean twin, so a benign note does NOT false-trigger DRIFT)
  mkstub dep6 '*/10 * * * *'; mkstub src6 '*/15 * * * *'
  [ "$(resolve_cadence "$td/dep6" "$td/src6")" = "DRIFT */15 * * * *" ] || { echo "smoke-test: FAIL (drift must yield source cadence: got '$(resolve_cadence "$td/dep6" "$td/src6")')"; exit 1; }
  mkstub dep7 '*/10 * * * *'; printf '#!/bin/sh\n# reflex-cadence: */10 * * * * (every 10 min)\n' > "$td/src7"
  [ "$(resolve_cadence "$td/dep7" "$td/src7")" = "WIRE */10 * * * *" ] || { echo "smoke-test: FAIL (inline-note must not false-trigger DRIFT: got '$(resolve_cadence "$td/dep7" "$td/src7")')"; exit 1; }

  # --test gate is THREE-valued: 0 pass · 2 honest n/a (organ absent — sound tool) · other broken.
  # Guards the false "FAILED (broken reflex)" accusation autowire used to make against every rc=2 tool.
  [ "$(gate_verdict 0)" = PASS ] || { echo "smoke-test: FAIL (rc=0 must be PASS)"; exit 1; }
  [ "$(gate_verdict 2)" = NA ]   || { echo "smoke-test: FAIL (rc=2 honest-n/a misclassified as $(gate_verdict 2) — the broken-reflex false accusation)"; exit 1; }
  for rc in 1 3 126 127; do
    [ "$(gate_verdict "$rc")" = FAIL ] || { echo "smoke-test: FAIL (rc=$rc must be FAIL, got $(gate_verdict "$rc"))"; exit 1; }
  done
  # rc=124 is a FOURTH value: the budget ran out with the tool's verdict unheard. Calling it FAIL both
  # slandered a sound tool and made any suite heavier than the gate permanently unwirable — the
  # never-wired-reflex failure arriving through the gate itself. RED-first: fold 124 back into the
  # loop above and this trips.
  [ "$(gate_verdict 124)" = UNKNOWN ] || { echo "smoke-test: FAIL (rc=124 must be UNKNOWN, got $(gate_verdict 124) — a timeout is a budget running out, not the tool failing)"; exit 1; }
  # and the wording must not carry the accusation: an unverified reflex is not a broken one, and the
  # line must name the budget so the reader can act on the real cause.
  _aw_u="$(gate_skip_reason UNKNOWN 124 180)"
  # a substring scan over a closed one-word vocabulary, not prose classification: the only thing being
  # asserted is that the accusing word this branch used to carry is gone from it.
  case "$_aw_u" in *broken*) echo "smoke-test: FAIL (the UNKNOWN skip reason calls the tool broken: '$_aw_u')"; exit 1 ;; esac
  case "$_aw_u" in *180s*) : ;; *) echo "smoke-test: FAIL (the UNKNOWN skip reason does not name the budget it exceeded: '$_aw_u')"; exit 1 ;; esac
  case "$(gate_skip_reason FAIL 1 180)" in *broken*) : ;; *) echo "smoke-test: FAIL (a genuine rc=1 stopped being named a broken reflex — the exemption leaked past 124)"; exit 1 ;; esac
  # the gate must actually SPEND the raised budget, not the retired 30s: a 40s-green suite is the live
  # shape (scripts/mesh-dash), and under a 30s ceiling it can never be wired.
  [ "$AW_TEST_TIMEOUT" -gt 30 ] || { echo "smoke-test: FAIL (the gate budget is back at or below 30s — this genome's real suites are 34-52s GREEN and would be unwirable)"; exit 1; }

  # ---- --check must report the DECISION, not the intent (see check_render) ----
  # UNIT: the verdict word each gate outcome earns.
  _cw="$(check_render PASS mesh-x 'CADENCE-LINE' 0 180)"
  case "$_cw" in "WOULD WIRE: CADENCE-LINE"*) : ;; *) echo "smoke-test: FAIL (a PASSing gate must render WOULD WIRE + the cron line: '$_cw')"; exit 1 ;; esac
  for _v in NA FAIL UNKNOWN; do
    case "$_v" in NA) _rc=2 ;; FAIL) _rc=1 ;; *) _rc=124 ;; esac
    _cs="$(check_render "$_v" mesh-x 'CADENCE-LINE' "$_rc" 180)"
    # the trap this guards is a READER grepping "WOULD WIRE": a skip line that contains that phrase
    # anywhere is counted as a wire by every consumer, so the assertion is on the substring, not the prefix.
    case "$_cs" in *"WOULD WIRE"*) echo "smoke-test: FAIL ($_v renders the WOULD WIRE phrase — a skipped tool reads as wired: '$_cs')"; exit 1 ;; esac
    case "$_cs" in "WOULD SKIP mesh-x: "*) : ;; *) echo "smoke-test: FAIL ($_v must render 'WOULD SKIP <name>: <reason>': '$_cs')"; exit 1 ;; esac
    # and it must carry the gate's own reason, not a bare verdict word
    case "$_cs" in *"$(gate_skip_reason "$_v" "$_rc" 180)"*) : ;; *) echo "smoke-test: FAIL ($_v skip line drops the gate reason: '$_cs')"; exit 1 ;; esac
  done

  # ---- a TOMBSTONE (commented-out naming) must RENDER, not vanish (see schedule_naming) ----
  # UNIT: the three namings, against fixtures — LIVE beats TOMB wherever both appear.
  _sncron="$td/sn-cron"; _snlive="$td/sn-live"; : > "$_snlive"
  cat > "$_sncron" <<'SNF'
*/10 * * * * $HOME/.local/bin/mesh-sn-live --edge >> /dev/null 2>&1
# REMOVED 2026-08-11 (decommissioned) -- 9-59/15 * * * * $HOME/.local/bin/mesh-sn-tomb --heal
   #  */5 * * * * $HOME/.local/bin/mesh-sn-indent
SNF
  _CRON_save="$CRON"; CRON="$_sncron"
  [ "$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-live)" = "LIVE sn-cron:1|*/10 * * * *" ] \
    || { echo "smoke-test: FAIL (schedule_naming: an active cron line must read 'LIVE <file>:<line>|<schedule>' — a bare LIVE cannot be compared against the header, got '$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-live)')"; exit 1; }
  case "$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-tomb)" in
    "TOMB sn-cron:2") : ;;
    *) echo "smoke-test: FAIL (schedule_naming: a commented-out naming must read 'TOMB <file>:<line>', got '$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-tomb)')"; exit 1 ;;
  esac
  # a comment is a comment however it is indented
  case "$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-indent)" in
    "TOMB sn-cron:3") : ;;
    *) echo "smoke-test: FAIL (schedule_naming: an INDENTED comment must still read TOMB, not LIVE)"; exit 1 ;;
  esac
  [ -z "$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-absent)" ] \
    || { echo "smoke-test: FAIL (schedule_naming: an unnamed tool must read as nothing)"; exit 1; }
  # LIVE anywhere beats TOMB anywhere: the same name commented in the desired set, ACTIVE in the crontab
  printf '%s\n' '*/10 * * * * $HOME/.local/bin/mesh-sn-tomb --heal' > "$_snlive"
  [ "$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-tomb)" = "LIVE crontab:1|*/10 * * * *" ] \
    || { echo "smoke-test: FAIL (schedule_naming: an ACTIVE crontab line must outrank a commented desired-set line — a wired reflex would be reported as decommissioned)"; exit 1; }
  # 2+ ACTIVE namings: no singleton schedule to quote, so the verdict falls back to a bare LIVE
  # (silent, as before) rather than picking one of two answers. Duplicates are mesh-reflexes' fault to fix.
  printf '%s\n' '*/10 * * * * $HOME/.local/bin/mesh-sn-tomb --heal' '7 * * * * $HOME/.local/bin/mesh-sn-tomb --heal' > "$_snlive"
  [ "$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-tomb)" = "LIVE" ] \
    || { echo "smoke-test: FAIL (schedule_naming: TWO active namings must read a bare LIVE, not one of the two schedules: got '$(MESH_AUTOWIRE_CRONTAB_SRC="$_snlive" schedule_naming mesh-sn-tomb)')"; exit 1; }
  # line_sched: the schedule of a naming line, normalized. An @keyword line is its keyword; a line
  # with no command (5 bare fields) has no schedule to quote rather than a fabricated one.
  [ "$(line_sched '*/10   *  * * *  $HOME/.local/bin/mesh-x --edge')" = "*/10 * * * *" ] \
    || { echo "smoke-test: FAIL (line_sched: irregular whitespace must normalize, got '$(line_sched '*/10   *  * * *  $HOME/.local/bin/mesh-x --edge')')"; exit 1; }
  [ "$(line_sched '@reboot $HOME/.local/bin/mesh-x')" = "@reboot" ] \
    || { echo "smoke-test: FAIL (line_sched: an @keyword line must read as that keyword)"; exit 1; }
  [ -z "$(line_sched '*/10 * * * *')" ] \
    || { echo "smoke-test: FAIL (line_sched: a line with no command must yield NO schedule, not a fabricated one)"; exit 1; }
  CRON="$_CRON_save"
  _ct="$(check_render TOMB mesh-x '' 'reflexes.cron:220' 180)"
  case "$_ct" in *"WOULD WIRE"*) echo "smoke-test: FAIL (a tombstoned tool renders the WOULD WIRE phrase: '$_ct')"; exit 1 ;; esac
  case "$_ct" in "WOULD SKIP mesh-x: already named by reflexes.cron:220 "*) : ;;
    *) echo "smoke-test: FAIL (TOMB must render 'WOULD SKIP <name>: already named by <file>:<line> …': '$_ct')"; exit 1 ;; esac

  # BEHAVIOURAL: the renderer above is only reached if the LOOP actually gates before printing. The bug
  # fixed here was precisely a `continue` sitting one line above the gate, and NO assertion on a pure
  # function can see that — source text is never behaviour. So drive the WHOLE script under a fake HOME
  # with two stub tools whose --test rc differs, and assert --check separates them. RED-first: move the
  # CHECK short-circuit back above the gate and both stubs come out as WOULD WIRE.
  _self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"   # never a bare $0: that runs the DEPLOYED copy, not the file under test
  if [ -r "$_self" ]; then
    _fh="$td/fakehome"; mkdir -p "$_fh/.local/bin" "$_fh/.mesh" "$_fh/repo/scripts"
    printf 'node: fake\n  minds: claude\n' > "$_fh/.mesh-card"
    for _spec in aw-e2e-pass:0 aw-e2e-na:2 aw-e2e-fail:1 aw-e2e-tomb:2 aw-e2e-div:0 aw-e2e-same:0; do
      _n="mesh-${_spec%%:*}"; _r="${_spec##*:}"
      printf '#!/bin/sh\n# reflex-cadence: */10 * * * *\ncase "$1" in --test) exit %s ;; esac\nexit 0\n' "$_r" > "$_fh/.local/bin/$_n"
      chmod +x "$_fh/.local/bin/$_n"
    done
    # the tombstone case: named ONLY by a commented-out line in the fake desired set. It is the shape
    # that produced NO line at all (mesh-egress-tunnel on this node) — a deliberate absence read as nothing.
    printf '%s\n' '# REMOVED 2026-08-11 (decommissioned) -- 9-59/15 * * * * $HOME/.local/bin/mesh-aw-e2e-tomb --heal' > "$_fh/.mesh/reflexes.cron"
    # the DIVERGENCE pair, both wired in the LIVE crontab, both declaring `*/10 * * * *` in their
    # header: -div runs at a DIFFERENT schedule (must be NAMED), -same runs at its own (control arm:
    # must stay SILENT, so the new line cannot be a blanket "everything already wired" noise source).
    # RED-first: restore `LIVE) continue ;;` as the only LIVE branch and -div goes silent → this FAILs.
    printf '%s\n' \
      '7 * * * * $HOME/.local/bin/mesh-aw-e2e-div >> /dev/null 2>&1' \
      '*/10 * * * * $HOME/.local/bin/mesh-aw-e2e-same >> /dev/null 2>&1' > "$td/e2e-live-crontab"
    # MESH_LIVENESS_SRC empty so the double-schedule guard can't reach the real node's table
    _out="$(HOME="$_fh" MESH_REPO="$_fh/repo" MESH_LIVENESS_SRC= MESH_AUTOWIRE_CRONTAB_SRC="$td/e2e-live-crontab" MESH_AUTOWIRE_TEST_TIMEOUT=20 bash "$_self" --check 2>/dev/null || true)"
    _lp=""; _ln=""; _lf=""; _lt=""; _ld=""; _lsame=""
    while IFS= read -r _l; do
      case "$_l" in *aw-e2e-pass*) _lp="$_l" ;; *aw-e2e-na*) _ln="$_l" ;; *aw-e2e-fail*) _lf="$_l" ;; *aw-e2e-tomb*) _lt="$_l" ;; *aw-e2e-div*) _ld="$_l" ;; *aw-e2e-same*) _lsame="$_l" ;; esac
    done <<E2E
$_out
E2E
    [ -n "$_lp" ] || { echo "smoke-test: FAIL (--check e2e: the PASSing stub produced no line at all — the drive never reached the loop)"; exit 1; }
    case "$_lp" in "WOULD WIRE: "*) : ;; *) echo "smoke-test: FAIL (--check e2e: a gate-PASSing tool must still say WOULD WIRE: '$_lp')"; exit 1 ;; esac
    for _bad in "$_ln" "$_lf"; do
      [ -n "$_bad" ] || { echo "smoke-test: FAIL (--check e2e: a gate-SKIPPED stub produced no line — it must be REPORTED as skipped, not silently dropped)"; exit 1; }
      case "$_bad" in *"WOULD WIRE"*) echo "smoke-test: FAIL (--check e2e: a tool the gate SKIPS is reported as WOULD WIRE — the dry-run is not running the gate: '$_bad')"; exit 1 ;; esac
    done
    [ -n "$_lt" ] || { echo "smoke-test: FAIL (--check e2e: a tool named only by a COMMENTED-OUT cron line produced no line at all — a deliberate absence is rendered as nothing, which reads as \"no such candidate\")"; exit 1; }
    case "$_lt" in *"WOULD WIRE"*) echo "smoke-test: FAIL (--check e2e: a tombstoned tool reads as WOULD WIRE: '$_lt')"; exit 1 ;; esac
    case "$_lt" in *"commented-out"*) : ;; *) echo "smoke-test: FAIL (--check e2e: the tombstone line must SAY it is a commented-out decommission: '$_lt')"; exit 1 ;; esac
    case "$_lt" in *"reflexes.cron:1"*) : ;; *) echo "smoke-test: FAIL (--check e2e: the tombstone line must CITE the file:line that hides it: '$_lt')"; exit 1 ;; esac
    # and the tombstone must still SKIP: --check changed nothing, and the desired set still holds only the comment
    [ "$(grep -c . "$_fh/.mesh/reflexes.cron")" = 1 ] || { echo "smoke-test: FAIL (--check wrote to reflexes.cron — a dry-run must change nothing)"; exit 1; }
    grep -qE '^[^#]*[/]mesh-aw-e2e-tomb' "$_fh/.mesh/reflexes.cron" && { echo "smoke-test: FAIL (a tombstoned tool got an ACTIVE cron line — the decommission guard is gone)"; exit 1; }
    # ---- the DECLARED cadence vs the cadence that RUNS (the LIVE verdict is no longer name-only) ----
    [ -n "$_ld" ] || { echo "smoke-test: FAIL (--check e2e: a tool wired at a schedule DIFFERENT from its own reflex-cadence header produced NO line — the header that declares the cadence is not the cadence that runs, and nothing says so)"; exit 1; }
    case "$_ld" in "DIVERGED mesh-aw-e2e-div: "*) : ;; *) echo "smoke-test: FAIL (--check e2e: the divergence must render 'DIVERGED <name>: …': '$_ld')"; exit 1 ;; esac
    case "$_ld" in *"header says */10 * * * *"*) : ;; *) echo "smoke-test: FAIL (--check e2e: the divergence line must quote the HEADER's cadence: '$_ld')"; exit 1 ;; esac
    case "$_ld" in *"crontab:1 runs 7 * * * *"*) : ;; *) echo "smoke-test: FAIL (--check e2e: the divergence line must cite WHERE and quote the schedule that actually RUNS: '$_ld')"; exit 1 ;; esac
    case "$_ld" in *"WOULD WIRE"*) echo "smoke-test: FAIL (--check e2e: a diverged tool reads as WOULD WIRE — autowire is add-only and must not offer to re-pace it: '$_ld')"; exit 1 ;; esac
    # CONTROL ARM: wired at exactly its header's cadence -> still SILENT. Without this, "name every
    # LIVE tool" would pass the assertion above while burying --check in a line per wired reflex.
    [ -z "$_lsame" ] || { echo "smoke-test: FAIL (--check e2e: a tool wired at EXACTLY its header's cadence must stay silent, got: '$_lsame')"; exit 1; }
  fi

  # ── TRACKED-AT-HEAD GATE (chat-review/autowire-wires-untracked-working-tree-scripts) ─────────
  # Four arms against ONE fixture drive, because the gate's danger is symmetric: too loose and an
  # unlanded tool gets wired (the mesh-exit-node-failover second-writer incident), too tight and it
  # silently un-wires every source-having reflex on a node whose scripts/ is an rsync'd tree.
  if command -v git >/dev/null 2>&1; then
    _gh="$td/githome"; mkdir -p "$_gh/.local/bin" "$_gh/.mesh" "$_gh/genome/scripts" "$_gh/genome/job"
    printf 'node: fake\n  minds: claude\n' > "$_gh/.mesh-card"; : > "$_gh/.mesh/reflexes.cron"
    # THE SHADOW. Deterministic, not a PATH race: the child is run with HOME="$_gh" and both this
    # tool and mesh-reflexes `export PATH="$HOME/.local/bin:$PATH"`, so the subject itself puts this
    # directory ahead of /usr/bin. `-l` answers with a plausible non-empty spool (an EMPTY read trips
    # mesh-reflexes' torn-read guard and the apply would skip, leaving the write path undriven and
    # this whole arm vacuous); `-` records the write instead of installing it.
    printf '#!/bin/sh\ncase "$1" in\n  -l) printf "%%s\\n" "*/30 * * * * $HOME/.local/bin/mesh-aw-shadow-seed >> /dev/null 2>&1" ;;\n  -)  cat >> "$HOME/crontab-writes" ;;\nesac\nexit 0\n' > "$_gh/.local/bin/crontab"
    chmod +x "$_gh/.local/bin/crontab"
    for _n in mesh-awgit-tracked mesh-awgit-untracked mesh-awgit-nosrc mesh-awgit-lane; do
      printf '#!/bin/sh\n# reflex-cadence: */10 * * * *\ncase "$1" in --test) exit 0 ;; esac\nexit 0\n' > "$_gh/.local/bin/$_n"
      chmod +x "$_gh/.local/bin/$_n"
    done
    # -tracked and -untracked BOTH exist in scripts/; only -tracked is committed. -nosrc has no
    # source file at all (the node-local arm resolve_cadence has always wired).
    cp "$_gh/.local/bin/mesh-awgit-tracked"   "$_gh/genome/scripts/mesh-awgit-tracked"
    cp "$_gh/.local/bin/mesh-awgit-untracked" "$_gh/genome/scripts/mesh-awgit-untracked"
    # -lane lives in a LANE dir and IS committed: the arm that catches "scripts/ + basename".
    cp "$_gh/.local/bin/mesh-awgit-lane"      "$_gh/genome/job/mesh-awgit-lane"
    ( cd "$_gh/genome" && git init -q . && git config user.email t@t && git config user.name t \
      && git add scripts/mesh-awgit-tracked job/mesh-awgit-lane && git commit -qm fixture ) >/dev/null 2>&1
    _gout="$(HOME="$_gh" MESH_REPO="$_gh/genome" MESH_LIVENESS_SRC= MESH_AUTOWIRE_CRONTAB_SRC=/dev/null \
             MESH_AUTOWIRE_TEST_TIMEOUT=20 bash "$_self" --check 2>/dev/null || true)"
    _gt=""; _gu=""; _gn=""; _gl=""
    while IFS= read -r _l; do case "$_l" in *awgit-tracked*) _gt="$_l";; *awgit-untracked*) _gu="$_l";; *awgit-nosrc*) _gn="$_l";; *awgit-lane*) _gl="$_l";; esac; done <<GITE
$_gout
GITE
    # (1) THE FIX: an untracked source must SKIP, and the line must SAY it is about HEAD — a bare
    # "skipped" would be indistinguishable from the --test/organ-absent skips beside it.
    [ -n "$_gu" ] || { echo "smoke-test: FAIL (tracked-gate: the UNTRACKED tool produced no --check line at all — a deliberate refusal read as nothing, the shape this file already paid for once)"; exit 1; }
    case "$_gu" in "WOULD SKIP mesh-awgit-untracked: "*) : ;; *) echo "smoke-test: FAIL (tracked-gate: an untracked genome source was not skipped — it would be wired within one */30 pass: '$_gu')"; exit 1 ;; esac
    case "$_gu" in *"NOT TRACKED AT HEAD"*) : ;; *) echo "smoke-test: FAIL (tracked-gate: the skip does not name HEAD, so a reader cannot tell it from a --test failure: '$_gu')"; exit 1 ;; esac
    # (2) CONTROL — a committed source still wires. Without this the gate is indistinguishable from
    # an off-switch on every tool that has a source at all.
    case "$_gt" in "WOULD WIRE: "*) : ;; *) echo "smoke-test: FAIL (tracked-gate: a COMMITTED source was not wired — the gate is refusing the whole genome: '$_gt')"; exit 1 ;; esac
    # (3) NODE-LOCAL — no source file at all is a tested arm of resolve_cadence and must survive.
    case "$_gn" in "WOULD WIRE: "*) : ;; *) echo "smoke-test: FAIL (tracked-gate: a node-local tool with NO genome source was swallowed — deployed-is-truth is a deliberate arm: '$_gn')"; exit 1 ;; esac
    # (3b) A LANE SOURCE IS DECIDED AT ITS OWN PATH. src_at_head used to rebuild the path as
    # "scripts/<basename>", so a job/ tool committed at HEAD answered "never committed" and was
    # refused wiring — with a message telling the operator to land what was already landed. The
    # control at (2) cannot catch it: it lives in scripts/, where the wrong path and the right one
    # are the same string.
    [ -n "$_gl" ] || { echo "smoke-test: FAIL (tracked-gate: the LANE tool produced no --check line at all)"; exit 1; }
    case "$_gl" in "WOULD WIRE: "*) : ;; *) echo "smoke-test: FAIL (tracked-gate: a lane-dir source COMMITTED at HEAD was not wired — src_at_head is rebuilding the path as scripts/<basename> again, so every job/ reflex is refused: '$_gl')"; exit 1 ;; esac
    # (4) UNDECIDABLE MUST PROCEED. Same tree, .git removed: no repo, no HEAD, nothing to decide
    # with. A planted node holds scripts/ as an rsync'd tree; if that read as "untracked" this gate
    # would dark every source-having reflex mesh-wide — a guard worse than its fault.
    rm -rf "$_gh/genome/.git"
    _gout2="$(HOME="$_gh" MESH_REPO="$_gh/genome" MESH_LIVENESS_SRC= MESH_AUTOWIRE_CRONTAB_SRC=/dev/null \
              MESH_AUTOWIRE_TEST_TIMEOUT=20 bash "$_self" --check 2>/dev/null || true)"
    case "$_gout2" in *"WOULD SKIP mesh-awgit-untracked"*) echo "smoke-test: FAIL (tracked-gate: a non-git scripts/ tree read as UNTRACKED — every source-having reflex on an rsync-planted node would silently stop wiring)"; exit 1 ;; esac
    case "$_gout2" in *"WOULD WIRE: "*"mesh-awgit-untracked"*) : ;; *) echo "smoke-test: FAIL (tracked-gate: with no git repo the tool must wire exactly as before the gate: '$_gout2')"; exit 1 ;; esac
    # (5) THE DURABLE RECORD — the real (non---check) pass must write the refusal to autowire.log,
    # or the skip exists only in a dry run nobody reads.
    ( cd "$_gh/genome" && git init -q . && git config user.email t@t && git config user.name t \
      && git add scripts/mesh-awgit-tracked && git commit -qm fixture ) >/dev/null 2>&1
    : > "$_gh/.mesh/autowire.log"
    HOME="$_gh" MESH_REPO="$_gh/genome" MESH_LIVENESS_SRC= MESH_AUTOWIRE_CRONTAB_SRC=/dev/null \
      MESH_AUTOWIRE_TEST_TIMEOUT=20 bash "$_self" >/dev/null 2>&1 || true
    grep -q 'SKIP mesh-awgit-untracked: genome source .* NOT TRACKED AT HEAD' "$_gh/.mesh/autowire.log" \
      || { echo "smoke-test: FAIL (tracked-gate: the refusal never reached autowire.log — it would be invisible outside a dry run)"; exit 1; }
    grep -qE '^[^#]*[/]mesh-awgit-untracked' "$_gh/.mesh/reflexes.cron" \
      && { echo "smoke-test: FAIL (tracked-gate: the untracked tool got an ACTIVE cron line — the gate did not hold on the real path)"; exit 1; } || true
    grep -qE '^[^#]*[/]mesh-awgit-tracked' "$_gh/.mesh/reflexes.cron" \
      || { echo "smoke-test: FAIL (tracked-gate: the COMMITTED tool was not wired on the real path — the gate is over-refusing)"; exit 1; }
    # (6) THE SHADOW WAS LOAD-BEARING. Without this the assertion below is vacuous in the one case
    # that matters: a shadow that lost the PATH race leaves the spool "unchanged" only because the
    # add-only reconcile found the leaked lines ALREADY there — which is exactly how this defect
    # hid for 17h. Require that the sandbox's crontab was actually the one that ran, AND that it
    # was handed a real write, so the escape path is proven CLOSED rather than merely unexercised.
    [ -s "$_gh/crontab-writes" ] \
      || { echo "smoke-test: FAIL (spool sentinel: the sandboxed crontab shadow was never handed a write — either the real /usr/bin/crontab won the PATH race, or the apply path went undriven; either way the 'real spool untouched' assertion proves nothing)"; exit 1; }
    grep -q 'mesh-awgit' "$_gh/crontab-writes" \
      || { echo "smoke-test: FAIL (spool sentinel: the swallowed write carries no fixture line — this arm is no longer driving the write that escaped on 2026-08-27)"; exit 1; }
  fi

  # ── THE SPOOL IS UNTOUCHED ────────────────────────────────────────────────────────────────────
  # The whole suite, not just the arm above: any future arm that drives the real apply path under a
  # fake HOME lands here. Compared against the hash taken before the first fixture existed.
  if [ "$_spool_have" = 1 ]; then
    [ "$(crontab -l 2>/dev/null | cksum)" = "$_spool_before" ] \
      || { echo "smoke-test: FAIL (spool sentinel: --test MUTATED THIS NODE'S LIVE CRONTAB — a dry run has written the substrate it exists to check; inspect 'crontab -l' for fixture names before doing anything else)"; exit 1; }
  fi

  echo "smoke-test: ok"; exit 0
fi

CHECK=0; [ "${1:-}" = --check ] && CHECK=1

# card gate
grep -qE '^  *minds:.*[a-z]' "$HOME/.mesh-card" 2>/dev/null || { echo "$(ts) card declares no minds — skip" >> "$LOG"; exit 0; }
touch "$CRON" 2>/dev/null

wired=0
for tool in "$BIN"/mesh-*; do
  [ -f "$tool" ] || continue
  name="$(basename "$tool")"
  # backup/temp copies keep their reflex-cadence header and would get wired as a second organ
  # writing the SAME state artifact with STALE code (the 2026-06-28 mesh-body-motion.*-backup case).
  # A COPY IS NAMED AFTER THE TOOL IT COPIES — that, not the substring "backup", is the tell. The
  # filter was a bare `*backup*`, which silently un-wireable every tool whose SUBJECT is backing
  # something up: mesh-body-backup (the Redmi identity puller, 2026-08-15) declared a cadence, passed
  # its gate, and was dropped here without ever appearing in --check. A permanent, invisible
  # never-wired reflex, produced by the guard rather than by the tool. So: unambiguous editor/copy
  # suffixes still go unconditionally, and a *backup* name is skipped only when the tool it would be
  # a copy OF actually exists next to it.
  if _why="$(copy_name_reason "$name" "$BIN")"; then
    echo "$(ts) SKIP $name: $_why" >> "$LOG"; continue
  fi
  # genome-source arbitration (chat-review/autowire-stale-deployed-resurrects, 2026-07-04): read cadence
  # from BOTH deployed and the genome source; a stale deployed copy must not resurrect a cadence genome
  # removed. Node-local tools (no source) keep deployed-as-truth. Sets cadraw for the checks below.
  # A LANE'S TOOLS ARE STILL GENOME SOURCES (2026-08-29, {#62d615cf}). The job lane's 17 tools live
  # in job/ beside their docs and funnel. With scripts/ hardcoded here, every one of them would read
  # as "node-local, no source" — and the deployed-as-truth branch that arbitration falls into is
  # exactly the stale-deployed-resurrects case the comment above exists to prevent. Silent, again:
  # the wiring would keep working while the source arbitration quietly stopped applying to 17 tools.
  src=""
  for _sd in "$REPO/scripts" "$REPO/job"; do
    [ -f "$_sd/$name" ] && { src="$_sd/$name"; break; }
  done
  [ -n "$src" ] || src="$REPO/scripts/$name"   # keep the historical path for the no-source branch
  # Reached BEFORE the already-wired check on purpose: a reflex that got wired while its source was
  # unlanded is precisely the one that must keep saying so every pass until somebody lands it. The
  # repetition is self-limiting — landing the file ends it — and its absence is what let this class
  # go unnoticed. A tool with no source at all falls straight through (node-local, unchanged).
  # `$?` is captured from the call ITSELF, never read after a `!` or an `&&` — a negation returns
  # its own 0/1 and would collapse UNDECIDABLE onto UNTRACKED, the exact conflation this gate is
  # three-valued to avoid.
  if [ -f "$src" ]; then
    src_at_head "$src"; _sh=$?
    if [ "$_sh" = 1 ]; then
      if [ "$CHECK" = 1 ]; then check_render UNTRACKED "$name" '' "$src" "$AW_TEST_TIMEOUT"
      else echo "$(ts) SKIP $name: $(gate_skip_reason UNTRACKED "$src")" >> "$LOG"
           printf 'mesh-autowire: SKIP %s: %s\n' "$name" "$(gate_skip_reason UNTRACKED "$src")" >&2; fi
      continue
    fi
    # _sh = 0 (tracked) or 2 (UNDECIDABLE: no git, no repo, no HEAD) — both proceed exactly as
    # before this gate existed.
  fi
  res="$(resolve_cadence "$tool" "$src")"
  case "$res" in
    NONE) continue ;;
    SKIP) echo "$(ts) SKIP $name: deployed declares reflex-cadence but genome source ($src) has none — deployed is DRIFT (stale), NOT resurrecting a cadence genome removed" >> "$LOG"; continue ;;
    DRIFT\ *) cadraw="${res#DRIFT }"; echo "$(ts) NOTE $name: deployed cadence differs from genome source — using SOURCE '$cadraw' (genome is truth)" >> "$LOG" ;;
    WIRE\ *)  cadraw="${res#WIRE }" ;;
  esac
  # intentional-skip sentinel (first token) → not a reflex for host cron; skip without crying malformed
  if is_skip_sentinel "${cadraw%% *}"; then echo "$(ts) SKIP $name: intentional-skip sentinel '$cadraw'" >> "$LOG"; continue; fi
  cad="$(clean_cadence "$cadraw")"   # drop any inline note so a valid 5-field schedule parses
  if ! valid_cadence "$cad"; then echo "$(ts) SKIP $name: malformed reflex-cadence '$cadraw'" >> "$LOG"; continue; fi
  # collapsed stepped range: valid cron, wrong period, silent. Warn on EVERY run (this is before the
  # already-LIVE continue on purpose — a reflex wired years ago is exactly the one nobody re-reads).
  if _cc="$(cadence_collapse "$cad")"; then
    echo "$(ts) WARN $name: cadence COLLAPSES — $_cc" >> "$LOG"
    echo "mesh-autowire: WARN $name: cadence COLLAPSES — $_cc" >&2
    [ "$CHECK" = 1 ] && printf 'COLLAPSED CADENCE %s: %s\n' "$name" "$_cc"
  fi
  # already wired? (present in the desired set OR the live crontab) — LIVE is silent, a TOMBSTONE is REPORTED
  _sn="$(schedule_naming "$name")"
  case "$_sn" in
    LIVE) continue ;;
    LIVE\ *)   # wired — but is it wired at the cadence its own header declares?
      _lloc="${_sn#LIVE }"; _lsched="${_lloc#*|}"; _lloc="${_lloc%%|*}"
      if [ -n "$_lsched" ] && [ "$_lsched" != "$cad" ]; then
        _dv="DIVERGED $name: header says $cad, $_lloc runs $_lsched — autowire is add-only and will not re-pace it; fix the header or the cron line, deliberately"
        # --check stays side-effect free (a dry run must not write the durable record); the real
        # pass logs it AND says it on stderr, so a cron-run divergence is not swallowed by the log.
        if [ "$CHECK" = 1 ]; then printf '%s\n' "$_dv"
        else echo "$(ts) $_dv" >> "$LOG"; printf 'mesh-autowire: %s\n' "$_dv" >&2; fi
      fi
      continue ;;
    TOMB\ *) _tl="${_sn#TOMB }"
      if [ "$CHECK" = 1 ]; then check_render TOMB "$name" '' "$_tl" "$AW_TEST_TIMEOUT"
      else echo "$(ts) SKIP $name: $(gate_skip_reason TOMB "$_tl")" >> "$LOG"; fi
      continue ;;
  esac
  # already scheduled by the OTHER scheduler? (chat-review/node-care-double-scheduled, 2026-07-15)
  if liveness_scheduled "$name"; then
    echo "$(ts) SKIP $name: mesh-liveness-loop's TASKS table already schedules it — wiring cron too would DOUBLE-SCHEDULE (collapses debounce windows into the same minute → false edges)" >> "$LOG"; continue
  fi
  args="$(args_of "$tool")"
  line="$cad \$HOME/.local/bin/$name${args:+ $args} >> $(journal_of "$tool" "$name") 2>&1   # autowired $(date -u +%F)"
  # gate on the tool's own smoke test (three-valued — see gate_verdict). --check RUNS THIS TOO and
  # reports the gate's verdict (see check_render); it used to `continue` above this line and so could
  # only ever say WOULD WIRE.
  timeout "$AW_TEST_TIMEOUT" "$tool" --test >/dev/null 2>&1; trc=$?
  _gv="$(gate_verdict "$trc")"
  if [ "$CHECK" = 1 ]; then check_render "$_gv" "$name" "$line" "$trc" "$AW_TEST_TIMEOUT"; continue; fi
  case "$_gv" in
    FAIL|NA|UNKNOWN) echo "$(ts) SKIP $name: $(gate_skip_reason "$_gv" "$trc" "$AW_TEST_TIMEOUT")" >> "$LOG"; continue ;;
  esac
  printf '%s\n' "$line" >> "$CRON"
  echo "$(ts) WIRED $name ($cad)" >> "$LOG"
  # An autowire is a substrate/metabolism change, not coordination — record it on the durable
  # trace tier (mesh-trace → traces.log), NOT the coordination board. Routing [autowired] off
  # mesh-chat de-noises the board (chat-review/autowired-noise) the same way [compact] was routed
  # to compact.log; no board consumer greps [autowired] (mesh-criticality only CLASSIFIES it as a
  # meta-marker, so off-board is the desired observer-fraction de-noise). WIRED is already in $LOG.
  command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="autowire@$(hostname)" \
    mesh-trace "[autowired] $name → reflexes.cron ($cad) — self-declared cadence + --test PASS. Produced component integrated into the operating metabolism (autopoiesis closure)." >/dev/null 2>&1
  wired=$((wired+1))
done

if [ "$CHECK" = 1 ]; then exit 0; fi
if [ "$wired" -gt 0 ]; then
  mesh-reflexes --apply >> "$M/reflexes.log" 2>&1 || true   # sync desired set → live crontab (add-only)
  echo "$(ts) applied $wired new reflex(es) to crontab" >> "$LOG"
fi
exit 0