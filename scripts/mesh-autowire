#!/usr/bin/env bash
# mesh-autowire — CLOSES the autopoiesis loop at the integration step. A tool the genome mind builds
# gets committed, landed, deployed (sync-tools) — but it never becomes part of the operating
# metabolism unless a human wires it into cron (your doctrine even marks unwired tools decay-eligible).
# So produced components don't auto-integrate → the production loop is OPEN. This closes it: any
# deployed mesh tool that SELF-DECLARES a cadence (header tag `# reflex-cadence: <cron schedule>`)
# AND passes its own `--test` is auto-wired into ~/.mesh/reflexes.cron (the self-healing desired set;
# mesh-reflexes --apply then syncs it into the live crontab, add-only/never-drop).
#
# Conservative + reversible by design (it edits the node's own cron — power that needs guardrails):
#   - OPT-IN: only tools carrying the explicit `# reflex-cadence:` tag (a tool isn't wired unless its
#     author intended it as a reflex). Optional `# reflex-args: <args>` for arguments.
#   - GATED: the tool's `--test` must PASS, else skip + log (never wire a broken reflex).
#   - IDEMPOTENT: skip anything already present in reflexes.cron.
#   - VISIBLE + REVERSIBLE: every wire is logged, posted to the board, and tagged `# autowired <date>`
#     in reflexes.cron (delete the line to un-wire).
#   - CARD-GATED: HANDS-OFF a node that declares no minds.
#   mesh-autowire           wire every eligible-but-unwired tagged tool
#   mesh-autowire --check    list candidates + what WOULD be wired (no changes)
#   mesh-autowire --test     smoke test
# reflex-cadence: */30 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; CRON="$M/reflexes.cron"; BIN="$HOME/.local/bin"; LOG="$M/autowire.log"
ts(){ date -u +%FT%TZ; }

# extract the cadence tag value from a file (empty if absent/malformed)
cadence_of(){ sed -nE 's/^# *reflex-cadence: *(.+)$/\1/p' "$1" 2>/dev/null | head -1; }
args_of(){    sed -nE 's/^# *reflex-args: *(.+)$/\1/p'    "$1" 2>/dev/null | head -1; }
# a cron schedule = 5 fields (min hr dom mon dow), each from the cron charset. Reject anything else
# (don't inject a malformed/garbage line into crontab).
valid_cadence(){ printf '%s' "$1" | grep -qE '^[-0-9*,/ ]+$' && [ "$(printf '%s' "$1" | awk '{print NF}')" = 5 ]; }

if [ "${1:-}" = --test ]; then
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  command -v mesh-reflexes >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-reflexes)"; exit 1; }
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  printf '#!/bin/sh\n# reflex-cadence: */10 * * * *\n# reflex-args: --edge\n' > "$td/tool"
  [ "$(cadence_of "$td/tool")" = "*/10 * * * *" ] || { echo "smoke-test: FAIL (cadence parse: got '$(cadence_of "$td/tool")')"; exit 1; }
  [ "$(args_of "$td/tool")" = "--edge" ] || { echo "smoke-test: FAIL (args parse)"; exit 1; }
  valid_cadence "*/10 * * * *" || { echo "smoke-test: FAIL (valid cadence rejected)"; exit 1; }
  valid_cadence "rm -rf /; * * * *" && { echo "smoke-test: FAIL (injection accepted as cadence)"; exit 1; }
  valid_cadence "*/10 * * *" && { echo "smoke-test: FAIL (4-field accepted)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

CHECK=0; [ "${1:-}" = --check ] && CHECK=1

# card gate
grep -qE '^  *minds:.*[a-z]' "$HOME/.mesh-card" 2>/dev/null || { echo "$(ts) card declares no minds — skip" >> "$LOG"; exit 0; }
touch "$CRON" 2>/dev/null

wired=0
for tool in "$BIN"/mesh-*; do
  [ -f "$tool" ] || continue
  name="$(basename "$tool")"
  cad="$(cadence_of "$tool")"; [ -n "$cad" ] || continue
  if ! valid_cadence "$cad"; then echo "$(ts) SKIP $name: malformed reflex-cadence '$cad'" >> "$LOG"; continue; fi
  # already wired? (present in the desired set OR the live crontab)
  if grep -qE "[/]$name( |$)" "$CRON" 2>/dev/null || crontab -l 2>/dev/null | grep -qE "[/]$name( |$)"; then continue; fi
  args="$(args_of "$tool")"
  line="$cad \$HOME/.local/bin/$name${args:+ $args} >> \$HOME/.mesh/${name#mesh-}.log 2>&1   # autowired $(date -u +%F)"
  if [ "$CHECK" = 1 ]; then echo "WOULD WIRE: $line"; continue; fi
  # gate on the tool's own smoke test
  if ! timeout 30 "$tool" --test >/dev/null 2>&1; then
    echo "$(ts) SKIP $name: --test FAILED (refuse to wire a broken reflex)" >> "$LOG"; continue
  fi
  printf '%s\n' "$line" >> "$CRON"
  echo "$(ts) WIRED $name ($cad)" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="autowire@$(hostname)" \
    mesh-chat "[autowired] $name → reflexes.cron ($cad) — self-declared cadence + --test PASS. Produced component integrated into the operating metabolism (autopoiesis closure)." >/dev/null 2>&1
  wired=$((wired+1))
done

if [ "$CHECK" = 1 ]; then exit 0; fi
if [ "$wired" -gt 0 ]; then
  mesh-reflexes --apply >> "$M/reflexes.log" 2>&1 || true   # sync desired set → live crontab (add-only)
  echo "$(ts) applied $wired new reflex(es) to crontab" >> "$LOG"
fi
exit 0