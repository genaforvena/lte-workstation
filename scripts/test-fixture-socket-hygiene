#!/usr/bin/env bash
# test-fixture-socket-hygiene — gate for chat-review/test-tmux-fixture-leaks-server-on-timeout (2026-07-17)
# orphan-ok: on-demand test harness (test-* canon) — spawns real tmux servers, ~20s, never cron-wired.
#
# Proves the two fixture-spawning --test suites (mesh-tell, mesh-mind-state) reap their PRIVATE tmux
# fixture sockets even when the run is SIGTERM'd mid-fixture (the mesh-doctor smoke-storm timeout that
# minted 22 immortal servers), and that reap-on-entry drains a pid-DEAD leak while sparing a pid-ALIVE
# socket (a concurrent doctor/hand run). RED-first: strip the tools' `trap _fx_reap_mine` and lane [A]
# leaks; strip the reap-on-entry loop and lane [C] fails to drain.
#
#   MESH_TELL_BIN / MESH_MST_BIN override the tools under test (point at a scratch mutant for RED-first).
set -u
D="/tmp/tmux-$(id -u)"
fail=0
live_server(){ tmux -L "$1" list-sessions >/dev/null 2>&1; }

# [A] cut a run mid-fixture with SIGTERM — no fixture socket/server for its pid may survive.
cut_test(){
  local tool="$1"; shift; local prefixes="$*"
  "$tool" --test >/dev/null 2>&1 &
  local tpid=$! caught="" i pfx
  for i in $(seq 1 400); do
    for pfx in $prefixes; do [ -S "$D/${pfx}${tpid}" ] && { caught="${pfx}${tpid}"; break 2; }; done
    kill -0 "$tpid" 2>/dev/null || break
    sleep 0.05
  done
  if [ -z "$caught" ]; then
    echo "  SKIP $(basename "$tool"): never observed a fixture socket mid-run (too fast / prefix drift)"
    kill -0 "$tpid" 2>/dev/null && { kill -TERM "$tpid" 2>/dev/null; wait "$tpid" 2>/dev/null; }
    return 0
  fi
  kill -TERM "$tpid" 2>/dev/null; wait "$tpid" 2>/dev/null; sleep 0.3
  local leaked=0
  for pfx in $prefixes; do
    if live_server "${pfx}${tpid}" || [ -S "$D/${pfx}${tpid}" ]; then
      echo "  FAIL $(basename "$tool"): ${pfx}${tpid} survived a mid-fixture SIGTERM (server=$(live_server "${pfx}${tpid}" && echo LIVE || echo -) file=$([ -S "$D/${pfx}${tpid}" ] && echo yes || echo no))"
      tmux -L "${pfx}${tpid}" kill-server 2>/dev/null; rm -f "$D/${pfx}${tpid}"; leaked=1
    fi
  done
  [ "$leaked" = 0 ] && echo "  ok   $(basename "$tool"): caught $caught mid-fixture — SIGTERM reaped it clean"
  return "$leaked"
}

# [B] reap-on-entry must leave a pid-ALIVE fixture socket untouched (concurrent run).
alive_untouched(){
  local tool="$1" pfx="$2" sock="${2}$$"   # $$ = harness pid, alive for this run's duration
  tmux -L "$sock" new-session -d -s t cat 2>/dev/null
  live_server "$sock" || { echo "  SKIP $(basename "$tool"): could not stand up a live-pid fixture"; return 0; }
  "$tool" --test >/dev/null 2>&1
  if live_server "$sock"; then
    echo "  ok   $(basename "$tool"): pid-ALIVE $sock survived reap-on-entry"
    tmux -L "$sock" kill-server 2>/dev/null; rm -f "$D/$sock"; return 0
  fi
  echo "  FAIL $(basename "$tool"): reap-on-entry killed a pid-ALIVE socket $sock (false-positive reap)"
  return 1
}

# [C] reap-on-entry must DRAIN a pid-DEAD leaked server (the retroactive corpus drain).
dead_drained(){
  local tool="$1" pfx="$2" dp=999001
  while kill -0 "$dp" 2>/dev/null; do dp=$((dp+1)); done
  local sock="${pfx}${dp}"
  tmux -L "$sock" new-session -d -s t cat 2>/dev/null
  live_server "$sock" || { echo "  SKIP $(basename "$tool"): could not stand up a dead-pid fixture"; return 0; }
  "$tool" --test >/dev/null 2>&1
  if live_server "$sock" || [ -S "$D/$sock" ]; then
    echo "  FAIL $(basename "$tool"): reap-on-entry did NOT drain dead-pid leak $sock"
    tmux -L "$sock" kill-server 2>/dev/null; rm -f "$D/$sock"; return 1
  fi
  echo "  ok   $(basename "$tool"): dead-pid leak $sock drained on entry"
  return 0
}

TELL="${MESH_TELL_BIN:-$(dirname "$0")/mesh-tell}"
MST="${MESH_MST_BIN:-$(dirname "$0")/mesh-mind-state}"

echo "[A] mid-fixture SIGTERM leaves no fixture socket/server:"
cut_test "$TELL" mtellack mtellrf || fail=1
cut_test "$MST"  mindstateshell   || fail=1
echo "[B] reap-on-entry spares a pid-ALIVE socket:"
alive_untouched "$TELL" mtellack       || fail=1
alive_untouched "$MST"  mindstateshell || fail=1
echo "[C] reap-on-entry drains a pid-DEAD leaked server:"
dead_drained "$TELL" mtellrf         || fail=1
dead_drained "$MST"  mindstateshell  || fail=1

[ "$fail" = 0 ] && { echo "gate: ok"; exit 0; } || { echo "gate: FAIL"; exit 1; }
