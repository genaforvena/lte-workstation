#!/usr/bin/env bash
# mesh-land-wake — wake the genome mind when the deployed landing actuator changes.
#
# mesh-land is deliberately the single writer for landing. This reflex only observes the live
# deployed copy and nudges the genome pane; it never commits, pushes, or deploys. The first run
# records a baseline, a changed deployed hash is retried until the wake succeeds, and one hash
# produces at most one wake.
# reflex-cadence: * * * * *

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

LIVE_BIN="${MESH_LAND_WAKE_BIN:-$HOME/.local/bin/mesh-land}"
STATE="${MESH_LAND_WAKE_STATE:-${MESH_DIR:-$HOME/.mesh}/mesh-land-wake.state}"
WINDOW="${MESH_LAND_WAKE_WINDOW:-genome}"
LOCK="${MESH_LAND_WAKE_LOCK:-${STATE}.lock}"

write_state() {
  local tmp="${STATE}.tmp.$$"
  printf '%s\n' "$1" >"$tmp" && mv -f "$tmp" "$STATE"
}

send_wake() {
  command -v mesh-tell >/dev/null 2>&1 || {
    echo "mesh-land-wake: mesh-tell unavailable — leaving hash unacknowledged" >&2
    return 2
  }
  mesh-tell "$WINDOW" "[mesh-land wake] deployed mesh-land changed to ${1:0:12}; inspect and land settled work now (mesh-land --check)."
}

run_once() {
  local current previous=""
  [ -r "$LIVE_BIN" ] || {
    echo "mesh-land-wake: deployed mesh-land is unavailable: $LIVE_BIN" >&2
    return 2
  }
  current="$(sha256sum "$LIVE_BIN" | awk '{print $1}')" || return 2
  [[ "$current" =~ ^[[:xdigit:]]{64}$ ]] || {
    echo "mesh-land-wake: could not derive a valid deployed hash" >&2
    return 2
  }
  mkdir -p "$(dirname "$STATE")" "$(dirname "$LOCK")" || return 2
  exec 9>"$LOCK"
  flock -n 9 || return 0
  if [ -r "$STATE" ]; then
    IFS= read -r previous <"$STATE" || previous=""
  fi
  if [ -z "$previous" ]; then
    write_state "$current" || return 2
    echo "mesh-land-wake: baseline recorded (${current:0:12})"
    return 0
  fi
  [ "$previous" = "$current" ] && return 0
  if ! send_wake "$current"; then
    echo "mesh-land-wake: wake refused for deployed hash ${current:0:12}; will retry" >&2
    return 1
  fi
  write_state "$current" || return 2
  echo "mesh-land-wake: genome wake sent for deployed hash ${current:0:12}"
}

run_test() {
  local td old_bin old_state old_window
  td="$(mktemp -d)" || return 1
  trap 'rm -rf "$td"' RETURN
  old_bin="$LIVE_BIN"; old_state="$STATE"; old_window="$WINDOW"
  LIVE_BIN="$td/mesh-land"
  STATE="$td/state"
  WINDOW=genome
  printf 'version one\n' >"$LIVE_BIN"
  send_wake() { printf '%s\n' "$1" >"$td/wake"; }
  run_once || return 1
  [ ! -e "$td/wake" ] || { echo "smoke-test: FAIL (baseline woke)"; return 1; }
  printf 'version two\n' >"$LIVE_BIN"
  run_once || return 1
  [ "$(wc -l <"$td/wake")" = 1 ] || { echo "smoke-test: FAIL (change did not wake once)"; return 1; }
  run_once || return 1
  [ "$(wc -l <"$td/wake")" = 1 ] || { echo "smoke-test: FAIL (same hash woke repeatedly)"; return 1; }
  LIVE_BIN="$old_bin"; STATE="$old_state"; WINDOW="$old_window"
  echo "smoke-test: ok (baseline, changed-hash wake, retry-safe deduplication)"
}

case "${1:---once}" in
  --once) run_once ;;
  --test) run_test ;;
  -h|--help) sed -n '2,/^set /p' "$0" | sed -n 's/^# //p';;
  *) echo "usage: mesh-land-wake [--once|--test]" >&2; exit 64 ;;
esac
