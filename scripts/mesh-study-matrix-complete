#!/usr/bin/env python3
"""Verify a frozen Tiny Fleet matrix before autowake declares it complete."""

import hashlib
import json
from pathlib import Path
import subprocess
import sys


EXECUTION = {
    "base": ["base"],
    "prompt_only": ["prompt-only"],
    "pooled_adapter": ["pooled-lora"],
    "simple_router": [f"specialist:{x}" for x in (
        "toy_passage_ppl", "executable_code", "rated_style", "adversarial_safety")],
    "routed_specialists": [f"specialist:{x}" for x in (
        "toy_passage_ppl", "executable_code", "rated_style", "adversarial_safety")],
}


def main() -> int:
    if sys.argv[1:] == ["--test"]:
        test = Path(__file__).resolve().parents[1] / "tests/test-mesh-study-matrix-complete.py"
        return subprocess.call([sys.executable, str(test)])
    if len(sys.argv) != 2:
        print("usage: mesh-study-matrix-complete <run-root>", file=sys.stderr)
        return 2
    root = Path(sys.argv[1]).resolve()
    summary_path = root / "smoke-summary.json"
    if not summary_path.exists():
        print("INCOMPLETE Tiny Fleet matrix: no summary")
        return 1
    try:
        registration = json.loads((root / "registration.json").read_text())
        summary = json.loads(summary_path.read_text())
        arms = [arm["id"] for arm in registration["arms"]]
        seeds = registration["statistics"]["seeds"]
        expected = {(arm, seed) for seed in seeds for arm in arms}
        if (not expected or len(expected) != len(arms) * len(seeds)
                or any(arm not in EXECUTION for arm in arms)):
            raise ValueError("registration matrix invalid")
        if (summary.get("schema") != "tiny-fleet.study-matrix-smoke/v1"
                or summary.get("study_id") != registration.get("study_id")
                or summary.get("verification_only") is not False
                or summary.get("training_executed") is not True
                or summary.get("max_cases") is not None
                or summary.get("arms") != arms or summary.get("seeds") != seeds
                or summary.get("rows") != len(expected)
                or summary.get("skipped") != []
                or len(summary["summaries"]) != len(expected)):
            raise ValueError("matrix summary incomplete or mismatched")
        corpus = root.parents[1] / "corpus/study-v1/heldout.jsonl"
        case_ids = [json.loads(line)["case_id"] for line in corpus.read_text().splitlines() if line]
        if not case_ids or len(set(case_ids)) != len(case_ids):
            raise ValueError("heldout case set invalid")
        observed = set()
        tapes = 0
        for row in summary["summaries"]:
            arm, seed = row["registered_arm"], row["seed"]
            key = (arm, seed)
            if (key not in expected or key in observed or row.get("verification_only") is not False):
                raise ValueError("matrix row identity invalid")
            observed.add(key)
            executions = row["execution"]
            if [item["arm"] for item in executions] != EXECUTION[arm]:
                raise ValueError("execution arms incomplete")
            for item in executions:
                tape = Path(item["predictions"]).resolve()
                if not tape.is_relative_to(root) or not tape.is_file():
                    raise ValueError("prediction tape outside run root or missing")
                raw = tape.read_bytes()
                if hashlib.sha256(raw).hexdigest() != item["records_sha256"]:
                    raise ValueError("prediction tape hash mismatch")
                records = [json.loads(line) for line in raw.splitlines() if line]
                if (item["records"] != len(case_ids) or len(records) != len(case_ids)
                        or [record["case_id"] for record in records] != case_ids
                        or any(record["arm"] != item["arm"] or record["seed"] != seed
                               for record in records)):
                    raise ValueError("prediction tape case set or row count mismatch")
                tapes += 1
        if observed != expected:
            raise ValueError("matrix row set incomplete")
    except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:
        print(f"UNKNOWN Tiny Fleet matrix completion: {exc}")
        return 2
    print(f"COMPLETE Tiny Fleet matrix: rows={len(expected)} tapes={tapes}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
