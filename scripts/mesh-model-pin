#!/usr/bin/env bash
# reflex-cadence: 11,41 * * * *
# reflex-state: $HOME/.mesh/.model-pin.state
# mesh-model-pin — compatibility entrypoint; implementation lives in operations/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in
  */*) ;;
  *) self="$(command -v "$self")" || exit 127 ;;
esac

# Resolve installed symlinks back to this repository before selecting the sibling source.
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in
    /*) self="$link_target" ;;
    *) self="$self_dir/$link_target" ;;
  esac
done

script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/operations/mesh-model-pin"
[ -x "$implementation" ] || {
  printf 'mesh-model-pin: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
