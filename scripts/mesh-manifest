#!/usr/bin/env python3
"""Enumerate the genome source roots using the manifest contract."""

from __future__ import annotations

import argparse
import os
import stat
import sys
from dataclasses import dataclass
from pathlib import Path


FIELDS = (
    "source_path",
    "installed_basename",
    "domain",
    "kind",
    "deploy_policy",
    "cadence_policy",
    "compatibility_owner",
)
DOMAINS = {"core", "communication", "integrations", "operations", "tests", "ux"}
KINDS = {"tool", "unit", "asset", "fixture", "library"}
DEPLOY_POLICIES = {"install", "systemd", "none"}
CADENCE_POLICIES = {"header", "unit", "none"}


@dataclass(frozen=True)
class Row:
    source_path: str
    installed_basename: str
    domain: str
    kind: str
    deploy_policy: str
    cadence_policy: str
    compatibility_owner: str

    def values(self) -> tuple[str, ...]:
        return (
            self.source_path,
            self.installed_basename,
            self.domain,
            self.kind,
            self.deploy_policy,
            self.cadence_policy,
            self.compatibility_owner,
        )


def _domain(relative: Path) -> str:
    parts = relative.parts
    if parts[0] == "job":
        return "operations"
    if "tests" in parts or "fixtures" in parts:
        return "tests"
    if parts[0] == "scripts" and len(parts) > 1 and parts[1] == "uxn":
        return "ux"
    name = relative.name
    if any(word in name for word in ("chat", "board", "room", "relay", "notify", "tg-", "telegram")):
        return "communication"
    if any(word in name for word in ("phone", "body", "cam", "camera", "network", "tailscale", "imac", "note3")):
        return "integrations"
    if any(name.startswith(prefix) for prefix in ("mesh-claim", "mesh-context", "mesh-handoff", "mesh-ledger", "mesh-task")):
        return "core"
    return "operations"


def _is_fixture(relative: Path) -> bool:
    parts = relative.parts
    name = relative.name
    return "tests" in parts or "fixtures" in parts or name.endswith((".fixture", ".expected"))


def _classify(repo: Path, relative: Path, top_level_tool_names: set[str]) -> Row:
    path = repo / relative
    name = relative.name
    is_generated_cache = "__pycache__" in relative.parts and name.endswith(".pyc")
    is_unit = name.endswith((".service", ".timer"))
    is_fixture = _is_fixture(relative)
    executable = bool(stat.S_IXUSR & path.stat().st_mode)
    is_tool = name.startswith("mesh-") and executable and not is_unit and not is_fixture

    if is_generated_cache:
        kind, deploy, cadence = "asset", "none", "none"
    elif is_unit:
        kind, deploy, cadence = "unit", "systemd", "unit"
    elif is_fixture:
        kind, deploy, cadence = "fixture", "none", "none"
    elif is_tool:
        kind, deploy = "tool", "install"
        compatibility_shim = relative.parts[0] == "scripts" and len(relative.parts) > 2 and name in top_level_tool_names
        if compatibility_shim:
            deploy = "none"
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError as exc:
            raise ValueError(f"cannot read tool {relative}: {exc}") from exc
        cadence = "header" if "reflex-cadence:" in text else "none"
    elif executable:
        kind, deploy, cadence = "library", "none", "none"
    elif name.endswith((".md", ".json", ".tsv", ".txt", ".rom", ".sym", ".bin")):
        kind, deploy, cadence = "asset", "none", "none"
    else:
        kind, deploy, cadence = "library", "none", "none"

    domain = _domain(relative)
    installed = name if deploy == "install" else ""
    owner_prefix = "job" if relative.parts[0] == "job" else "scripts"
    owner = f"{owner_prefix}:{name}"
    row = Row(str(relative), installed, domain, kind, deploy, cadence, owner)
    if row.domain not in DOMAINS or row.kind not in KINDS or row.deploy_policy not in DEPLOY_POLICIES:
        raise ValueError(f"unknown classification for {relative}: {row}")
    if row.cadence_policy not in CADENCE_POLICIES or not row.compatibility_owner:
        raise ValueError(f"invalid cadence/owner for {relative}: {row}")
    return row


def inventory(repo: Path) -> list[Row]:
    rows: list[Row] = []
    top_level_tool_names: set[str] = set()
    scripts_root = repo / "scripts"
    for candidate in scripts_root.iterdir():
        if candidate.is_file() and candidate.name.startswith("mesh-") and os.access(candidate, os.X_OK):
            top_level_tool_names.add(candidate.name)
    for root_name in ("scripts", "job"):
        root = repo / root_name
        if not root.is_dir():
            raise ValueError(f"missing manifest source root: {root_name}/")
        for current, dirs, files in os.walk(root):
            dirs.sort()
            for name in sorted(files):
                path = Path(current) / name
                if path.is_symlink() or not path.is_file():
                    continue
                rows.append(_classify(repo, path.relative_to(repo), top_level_tool_names))
    rows.sort(key=lambda row: row.source_path)
    owners: dict[str, str] = {}
    for row in rows:
        if row.installed_basename:
            previous = owners.get(row.installed_basename)
            if previous:
                raise ValueError(
                    "duplicate installed basename "
                    f"{row.installed_basename!r}: {previous} and {row.source_path}"
                )
            owners[row.installed_basename] = row.source_path
    return rows


def _print_rows(rows: list[Row], repo: Path, deployed: Path | None = None) -> None:
    if deployed is None:
        print("# mesh-manifest v1")
        print("\t".join(FIELDS))
        for row in rows:
            print("\t".join(row.values()))
        return
    print("# mesh-manifest v1 parity (report-only)")
    print("\t".join((*FIELDS, "deployed_status")))
    for row in rows:
        status = "na"
        if row.installed_basename:
            target = deployed / row.installed_basename
            status = "missing" if not target.exists() else "present"
            if status == "present":
                try:
                    status = "same" if target.read_bytes() == (repo / row.source_path).read_bytes() else "different"
                except OSError:
                    status = "different"
        print("\t".join((*row.values(), status)))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list", action="store_true", help="emit the typed inventory")
    parser.add_argument("--check", action="store_true", help="validate the complete inventory")
    parser.add_argument("--parity", action="store_true", help="report source/deployed status")
    args = parser.parse_args()
    if sum((args.list, args.check, args.parity)) != 1:
        parser.error("choose exactly one of --list, --check, or --parity")
    repo = Path(os.environ.get("MESH_REPO", os.getcwd())).resolve()
    try:
        rows = inventory(repo)
    except (OSError, ValueError) as exc:
        print(f"mesh-manifest: FAIL: {exc}", file=sys.stderr)
        return 1
    if args.check:
        print(f"mesh-manifest: PASS ({len(rows)} complete rows; no duplicate installed basenames)")
    else:
        try:
            if args.list:
                _print_rows(rows, repo)
            else:
                _print_rows(rows, repo, Path(os.environ.get("MESH_BIN", str(Path.home() / ".local/bin"))))
        except BrokenPipeError:
            return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
