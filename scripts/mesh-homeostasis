#!/usr/bin/env bash
# mesh-homeostasis — set-point self-regulator for the egress invariant.
# orphan-ok: instrument-first, steward/operator-run — deliberately NOT cron-wired. Its fast-loop fix
#   writes SUBSTRATE (sudo -n mesh-fix-egress, :174) and DUPLICATES already-wired egress healers
#   (mesh-egress-tunnel --heal /15m, mesh-vpn-health --edge /10m); a 3rd unattended egress-writer
#   would breach single-writer discipline. The novel part it adds — the I-controller integral +
#   Ashby ultrastability trials-to-stable + Hebbian associative memory — is MEASUREMENT the operator
#   reads (--status/--optimize --status); the reconfiguration ACTUATOR stays HELD (substrate, see
#   :68-72/:184). Wiring it as a reflex is a substrate decision for the operator, not a quiet cron add.
#
# I-controller: accumulates error-seconds when public IP drifts from NL set-point.
# Escalates through log → alert → fix-attempt as integral grows.
#
#   mesh-homeostasis                  one-shot check + correct
#   mesh-homeostasis --status         report current set-point + integral
#   mesh-homeostasis --reset          reset integral to zero
#   mesh-homeostasis --set-point IP   set expected public IP manually
#   mesh-homeostasis --loop [sec]     run every N seconds (default 120)
#   mesh-homeostasis --optimize       SO tier: sample state vector, Hebbian-reinforce, advise recovery (no substrate action)
#   mesh-homeostasis --optimize --status   show learned associative memory (W) + current vector
#   mesh-homeostasis --test           smoke test (incl. RED-first self-optimization gate)
#
# Set-point: learns current public IP on first run, or set with --set-point.
# Corrective action triggers when integral exceeds threshold.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
INTEGRAL_FILE="$MESH/homeostasis-integral"
SOMEM_FILE="$MESH/homeostasis-somem.tsv"   # self-optimization associative memory (Hebbian W over state-vector axes)
LOG="$MESH/homeostasis.log"
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { echo "$(ts) $*" >> "$LOG"; echo "$(ts) $*"; }

# --- set-point check ------------------------------------------------------
SETPOINT_FILE="$MESH/homeostasis-setpoint"
check_setpoint() {
  local ip setpoint
  ip=$(curl -s -m5 https://ifconfig.me 2>/dev/null) || return 1
  setpoint=$(cat "$SETPOINT_FILE" 2>/dev/null || echo "")
  [ -z "$setpoint" ] && { echo "$ip" > "$SETPOINT_FILE"; setpoint="$ip"; }
  if [ "$ip" = "$setpoint" ]; then
    echo "OK $ip"
  else
    echo "DRIFT $ip (expected $setpoint)"
  fi
}

# ── ULTRASTABILITY: THE SECOND (SLOW) LOOP + TRIALS-TO-STABLE-FIELD (Ashby) ──
# LITERATURE (homeostasis/allostasis/ultrastability — a concrete METRIC/experiment, 2026-06-21, genome mind).
# Concept: W. Ross Ashby's ULTRASTABILITY (Design for a Brain, 1952/1960; the four-unit HOMEOSTAT). An
# ultrastable system has DOUBLE feedback: a FAST loop that handles ordinary perturbations (this is an
# ordinary regulator) AND a SLOW loop — a STEP-MECHANISM (uniselector) that, when an ESSENTIAL VARIABLE
# leaves its viability bounds and the fast loop FAILS to bring it back, RANDOMLY RECONFIGURES the
# regulator's OWN parameters; it keeps step-changing until the coupled system settles into a stable field.
# The concrete EXPERIMENT/METRIC the field uses to measure it (verified live, WebSearch 2026-06-21): Ashby
# measured adaptation by TRIALS-TO-STABLE-FIELD — the COUNT of step-mechanism reconfigurations (and the
# time) the homeostat needed to re-equilibrate after a disturbance. Adaptation = how many distinct
# reconfigurations it took to regain viability, NOT how big or how long the error was.
# Where THIS tool stops short: mesh-homeostasis is a SINGLE-LOOP I-controller — check_setpoint → integrate
# error-SECONDS → escalate log/WARN/FIX, where the "fix" is ALWAYS the same `mesh-fix-egress` (:70-78). When
# that fix FAILS (:76 "may need sudo or operator hand") the essential variable (NL egress) stays breached and
# the controller simply RE-FIRES the identical correction next cycle — forever. There is NO slow loop that
# RECONFIGURES the regulator (tries a DIFFERENT egress strategy/parameter) on persistent breach, and NO
# trials-to-stable-field metric: the integral counts error-seconds, never reconfiguration-TRIALS. It is a
# homeostat WITHOUT Ashby's second loop — the fast loop only.
# DISTINCT (do not conflate — three different gaps now named on this file): NOT the allostatic-overload /
# correction-frequency gap ([[allostatic-overload-correction-frequency-gap]]) — that is a MEASUREMENT blind
# spot (detect Type-II wear: green-every-cycle while flapping); NOT the mallostasis / allostatic-drift gap
# ([[mallostasis-allostatic-drift-gap]]) — that measures drift DIRECTION (μ_age toward a worsening
# equilibrium). Those two name the missing SENSOR; ultrastability names the missing ACTUATOR — the second-
# order RESPONSE the allostatic-load signal should eventually TRIGGER (reconfigure, don't just re-fire). Also
# NOT settling-point-vs-set-point (mesh-therm-watch) nor adaptivity/graded-viability (mesh-body-power) nor
# self-tuning-to-criticality (which itself flagged "not ultrastability — that REORGANIZES a regulator's
# params when an essential variable leaves range"; this is exactly that, made concrete on the egress homeostat).
# HELD fix (instrument-first, steward/operator-gated — behavioral): an ultrastable outer loop — when egress
# stays DRIFT despite K repeated identical fixes, STEP-RECONFIGURE the regulator (try a distinct egress
# strategy from a small bounded set) and report TRIALS-TO-STABLE-FIELD as the adaptation metric beside the
# integral. WHY HELD (load-bearing caveat): randomly reconfiguring the EGRESS regulator is a SUBSTRATE change
# — routing/exit-node is the most contended, single-writer surface in the mesh (CLAUDE.md), and a blind step-
# change could sever the very control plane the node is reached through (the self-cut invariant). The bounded
# reconfiguration set + guardrails (mesh-dms dead-man's switch, exclude the self-cut, mesh-card invariant
# re-check) MUST be designed + validated before any auto-reconfiguration is wired.
# NOW SHIPPED — the MEASUREMENT HALF only (read-only, instrument-first; 2026-07-28 loop-baton, live review
# arXiv:2507.10443 "Associative Memory for Non-Stationary Environments", which restates Ashby's operational
# rule: the outer loop fires ONLY when an essential variable persistently exits bounds despite the inner
# loop — i.e. when the fast loop has FAILED, not merely engaged). The I-controller now counts its fix
# reconfiguration TRIALS per breach episode (3rd field of the integral state), logs TRIALS-TO-STABLE-FIELD
# on recovery (Ashby's adaptation metric — reconfiguration COUNT, not error-magnitude), and after
# ULTRA_TRIALS (default 3) identical fixes with egress STILL DRIFT emits a read-only ULTRASTABLE-EXHAUSTED
# trigger — the "fast loop exhausted" signal that was invisible before (the block above's "re-fires the
# identical correction forever" now has a name and a count). The ACTUATOR (random/directed reconfiguration
# of the egress regulator) stays HELD — substrate, per the caveat above. Measurement before the actuator.
# ── THE GOOD REGULATOR THEOREM: a model-free I-controller can ESCALATE but cannot SELECT ──
# LITERATURE inoculation (homeostasis/allostasis/ultrastability — cross-domain transfer to a sensor mesh,
# 2026-06-22, genome mind). Instrument-first: 0 behavior change. Concept: the CONANT–ASHBY GOOD REGULATOR
# THEOREM — "Every good regulator of a system must be a model of that system" (Conant & Ashby, Int. J.
# Systems Science 1(2):89, 1970): any regulator that is BOTH maximally successful AND maximally simple must
# be a homomorphic IMAGE (a model) of the system it regulates. Its control-theory descendant is the INTERNAL
# MODEL PRINCIPLE (Francis & Wonham, Automatica 12:457, 1976), and it is live again in 2025 (arXiv:2508.06326
# "A good regulator theorem for embodied agents"; arXiv:2506.23032 "A Good Regulator May Provide a World
# Model for Intelligent Systems"). Where THIS tool stops short: the I-controller models error MAGNITUDE
# (integral of error-SECONDS) but holds NO model of the disturbance SOURCE. Egress drifts for DISTINCT,
# separately-correctable reasons — router reboot (LAN-VPN down), Tailscale flap, the ip_forward sysctl
# reboot-gap (sudo-only), upstream NL-VPN handshake loss — each documented in CLAUDE.local.md as needing a
# DIFFERENT hand. A model-free regulator cannot tell them apart, so it re-fires the SAME `mesh-fix-egress`
# (:70-78) harder regardless of cause: it can ESCALATE but cannot SELECT. Per the theorem its regulation is
# bounded by the (absent) model.
# DISTINCT — this is the PRECONDITION the ultrastability block (:38-72) dodges, NOT a re-statement of it:
# ultrastability supplies the missing ACTUATOR (a second loop that RECONFIGURES on persistent breach), but
# Ashby's homeostat reconfigures RANDOMLY (the uniselector) — so its held "try a distinct egress strategy
# from a bounded set" (:66) is a BLIND draw. The Good Regulator Theorem names why a DIRECTED reconfiguration
# (pick the fix that MATCHES the cause) requires the regulator to MODEL the disturbance first: second loop =
# Ashby's "reconfigure"; good regulator = "you cannot reconfigure WELL without a model." Also NOT the
# allostatic-overload / mallostasis SENSORS (:56-60 — they measure wear/drift); this is the regulator
# CONTAINING a causal model. And NOT requisite-variety (mesh-vitality:33 — regulator-vs-disturbance variety
# COUNT); this is the regulator being an IMAGE of the system, a different Ashby result.
# HELD fix (instrument-first, steward/operator-gated — behavioral): give the regulator a small DISTURBANCE
# MODEL — classify the egress-drift CAUSE (probe router reachability, `tailscale status`, the ip_forward
# sysctl, the upstream VPN handshake) and SELECT the matching correction, instead of escalating one blind
# fix. This is ALSO what turns the ultrastability second loop from RANDOM into DIRECTED (model → choose).
# WHY HELD: same substrate caveat as :68-72 — egress is the contended single-writer surface (CLAUDE.md); any
# cause-routed corrective action is a substrate change (mesh-dms-gated, self-cut-excluded, mesh-card-rechecked)
# that must be designed + validated first. Not shipped — names the missing model so the held second loop can
# be DIRECTED, not random.
# ── VSM / management cybernetics: delegated autonomy must be exercised, not merely granted ──
# LITERATURE (recent VSM result, 2024-2025, genome mind).
# Recent result: Fattoum, Chari & Shaw (European Journal of Operational Research, 2024,
# DOI 10.1016/j.ejor.2024.03.034) and Espinosa & Martinez-Lozada (Systemic Practice and Action Research,
# 2025, DOI 10.1007/s11213-025-09724-3) push the Viable System Model past abstract recursion: viability in
# crisis depends on whether delegated autonomy is actually usable at the operational edge, and on the support
# structure that lets local units self-govern with access to knowledge and resources.
# Failure mode we do NOT already embody: this homeostasis loop can escalate, but it does not model
# "whether local autonomy is being exercised" as a first-class state. It treats autonomy as a fixed
# permission, not a calibrated capability with explicit role/boundary support.
# Concrete application: `scripts/mesh-homeostasis` should eventually use a delegated-autonomy broker:
# local correction when confidence is high and the disturbance is local; escalation with context when
# ambiguity is high or the acting unit lacks the needed boundary/authority. That is a better fit for a live
# sensor-mesh reflex than a blind retry loop.
# --- I-controller ---------------------------------------------------------
I_CONTROLLER() {
  local verdict="$1" dt="${2:-120}"
  local integral=0 prev_peak=0 trials=0 now
  now=$(date +%s)

  # read previous state ("integral peak trials"; a pre-ultrastability 2-field file → trials=0)
  if [ -f "$INTEGRAL_FILE" ]; then
    local saved
    saved=$(cat "$INTEGRAL_FILE" 2>/dev/null || echo "")
    integral=$(echo "$saved" | cut -d' ' -f1 2>/dev/null || echo 0)
    prev_peak=$(echo "$saved" | cut -d' ' -f2 2>/dev/null || echo 0)
    trials=$(echo "$saved" | cut -d' ' -f3 2>/dev/null); trials=${trials:-0}
  fi

  case "$verdict" in
    OK*)
      if [ "$integral" -gt 0 ]; then
        # recovery — announce peak + Ashby's adaptation metric (reconfiguration COUNT), reset
        if [ "${trials:-0}" -gt 0 ]; then
          log "RECOVERED (was drifting for ${integral}s, peak=${prev_peak}s) — TRIALS-TO-STABLE-FIELD=${trials}"
        else
          log "RECOVERED (was drifting for ${integral}s, peak=${prev_peak}s)"
        fi
      fi
      echo "0 0 0" > "$INTEGRAL_FILE"
      return 0
      ;;
    DRIFT*)
      integral=$((integral + dt))
      [ "$integral" -gt "$prev_peak" ] && prev_peak=$integral

      local ip_info
      ip_info=$(echo "$verdict" | sed 's/^DRIFT //')

      # escalation thresholds
      if [ "$integral" -ge 300 ]; then
        # ULTRASTABILITY (Ashby): each escalation re-fires the SAME fix with no reconfiguration, so
        # counting escalation cycles = counting fast-loop TRIALS the essential variable did NOT return on.
        trials=$((trials + 1))
        log "ESCALATE: egress drift ${integral}s (ip=$ip_info) trial=${trials} — attempting fix"
        if command -v mesh-fix-egress >/dev/null 2>&1; then
          if sudo -n mesh-fix-egress 2>/dev/null; then
            log "FIX-EGRESS succeeded"
          else
            log "FIX-EGRESS failed (may need sudo or operator hand)"
          fi
        fi
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="homeostasis@$(hostname)" \
          mesh-chat "[homeostasis] egress drift ${integral}s — ip=$ip_info, attempted fix (trial ${trials})" >/dev/null 2>&1
        # ULTRASTABLE-EXHAUSTED trigger: fast loop has fired ULTRA_TRIALS identical fixes and the essential
        # variable is STILL breached (Ashby's precondition for the slow loop). READ-ONLY signal — the
        # reconfiguration ACTUATOR stays HELD (substrate). Fire ONCE per episode (trials == threshold).
        if [ "$trials" -eq "${ULTRA_TRIALS:-3}" ]; then
          log "ULTRASTABLE: fast loop exhausted — ${trials} identical fixes, egress still DRIFT (ip=$ip_info); reorganization indicated [HELD: reconfigure is a substrate change]"
          command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="homeostasis@$(hostname)" \
            mesh-chat "[homeostasis] ULTRASTABLE — fast loop exhausted (${trials} fixes, egress still DRIFT); reorganization indicated (held: substrate)" >/dev/null 2>&1
        fi
      elif [ "$integral" -ge 120 ]; then
        log "WARN: egress drift ${integral}s (ip=$ip_info)"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="homeostasis@$(hostname)" \
          mesh-chat "[homeostasis] egress WARN: $ip_info (drift ${integral}s)" >/dev/null 2>&1
      else
        log "drift: egress ${integral}s (ip=$ip_info) — below threshold, logging only"
      fi
      echo "$integral $prev_peak $trials" > "$INTEGRAL_FILE"
      return 1
      ;;
  esac
}

# --- status ---------------------------------------------------------------
show_status() {
  local verdict setpoint
  setpoint=$(cat "$SETPOINT_FILE" 2>/dev/null || echo "(unset — will learn on first check)")
  verdict=$(check_setpoint)
  echo "  set-point: $setpoint"
  echo "  current:   $verdict"
  if [ -f "$INTEGRAL_FILE" ]; then
    local integral peak trials
    integral=$(cut -d' ' -f1 "$INTEGRAL_FILE" 2>/dev/null || echo 0)
    peak=$(cut -d' ' -f2 "$INTEGRAL_FILE" 2>/dev/null || echo 0)
    trials=$(cut -d' ' -f3 "$INTEGRAL_FILE" 2>/dev/null); trials=${trials:-0}
    echo "  integral:  ${integral}s (peak: ${peak}s, fix-trials this episode: ${trials})"
  else
    echo "  integral:  0s (clean)"
  fi
}

# ── SELF-OPTIMIZATION: an ASSOCIATIVE MEMORY of the mesh's coordinated-good states ──
# LITERATURE (autopoiesis → self-optimization, 2023 enactive bridge + Jan-2025 frontier; genome mind,
# 2026-07-24; docs/study-2026-07-24-autopoiesis-self-optimization.md). Classical autopoiesis explains how a
# system MAINTAINS its organization (operational closure, homeostasis toward set-points); it says nothing
# about getting BETTER at self-regulation without a designer. The recent result closing that gap is
# SELF-OPTIMIZATION (SO) — Froese/Weber/Shpurov/Ikegami, *From autopoiesis to self-optimization*, BioSystems
# 2023 (S030326472300134X); *Untapped Potential in Self-Optimization of Hopfield Networks*, arXiv:2501.04007
# (Jan 2025); substrate-general per Frontiers Robotics & AI (PMC7805835). The SO loop: (1) relax to whatever
# LOCAL attractor current constraints pull into, (2) Hebbian-REINFORCE the state just landed in, (3) reset &
# repeat — over many cycles the system reshapes its OWN constraint landscape so later relaxations reach a
# BETTER GLOBAL constraint-satisfying state than any single local relaxation. It is associative memory turned
# on the system's own dynamics: it learns the correlation structure of previously-visited good states and
# widens their basins.
# THE GAP this fills (distinct from the three behavioral HELDs above — ultrastability/good-regulator/VSM all
# name the missing egress ACTUATOR): the egress I-controller and every mesh homeostat is single-axis,
# fixed-set-point, blind to the other axes. Nothing recorded the GLOBAL state vector at moments of coordinated
# health, learned its correlation structure, nor biased recovery toward the nearest previously-visited
# coordinated-good BASIN instead of yanking each axis to its own set-point. Fixing egress while load is
# pathological can land the node in the locally-satisfying-but-globally-bad corner SO is designed to escape.
# WHAT IS SHIPPED (advisory tier — `--optimize`, zero substrate change): sample a small ±1 vector of cheaply-
# readable axes (egress-on-set-point, load1<0.8·cores, reflex-fresh, thermal-nominal — UNREADABLE axes are
# OMITTED, never faked +1; honest-fusion). Each pass = one reset→relax→reinforce cycle: Hebbian-update a
# persisted symmetric W over axis PAIRS (SOMEM_FILE), then rank recovery toward the lowest-energy learned
# configuration (−½sᵀWs) and REPORT it. NO substrate action — the substrate is the contended single-writer
# surface (CLAUDE.md); this tier only LEARNS and ADVISES, exactly like the HELD blocks. Fail-safe: an empty/
# degenerate W is INERT (falls back to today's per-axis I-controller — never worse than what it extends), and
# it never overrides the hard egress invariant fix, only orders the discretionary read.
# The Python core is stdlib-only (no numpy on this node); the tier is gated by a RED-first `--test` that feeds
# a synthetic history where two axes are always good TOGETHER and one adversarial axis is good ALONE, and
# asserts the learned W pulls recovery toward the coordinated pair (not the adversarial axis) while an empty W
# stays inert. Wiring a cadence (so the loop actually LEARNS over time) is a steward/operator call — it reads
# state + writes its own TSV only, but a learning loop deserves a deliberate arming, not an auto-wire.

# _somem <mode> <wfile>  — SO core (stdlib python; vector via $SOMEM_VEC "name:±1 ...", eta via $SOMEM_ETA).
#   reinforce: Hebbian W_ij += eta·s_i·s_j over the sampled vector, persist.  energy: print −½sᵀWs.
#   descend: for each BAD axis (sign<0) print "axis<TAB>ΔE" if flipping it to +1 lowers energy, most-negative
#            first; "INERT" when no flip helps (empty/degenerate W).  status: passes + top learned pairs.
_somem() {
  python3 - "$1" "$2" <<'PY'
import os, sys
mode, wfile = sys.argv[1], sys.argv[2]
vec = {}
for tok in os.environ.get('SOMEM_VEC', '').split():
    if ':' not in tok: continue
    name, sign = tok.rsplit(':', 1)
    try: s = int(sign)
    except ValueError: s = 1 if sign.strip().startswith('+') else -1
    vec[name] = 1 if s > 0 else -1
eta = float(os.environ.get('SOMEM_ETA', '1'))
W, passes = {}, 0
try:
    with open(wfile) as f:
        for line in f:
            line = line.rstrip('\n')
            if line.startswith('# passes'):
                try: passes = int(line.split()[-1])
                except Exception: pass
                continue
            if not line or line.startswith('#'): continue
            p = line.split('\t')
            if len(p) != 3: continue
            i, j = p[0], p[1]
            if i > j: i, j = j, i
            W[(i, j)] = float(p[2])
except FileNotFoundError:
    pass
def wget(a, b):
    if a == b: return 0.0
    if a > b: a, b = b, a
    return W.get((a, b), 0.0)
def energy(v):
    ns = sorted(v); e = 0.0
    for x in range(len(ns)):
        for y in range(x + 1, len(ns)):
            e -= wget(ns[x], ns[y]) * v[ns[x]] * v[ns[y]]
    return e
def save():
    lines = ['# passes %d' % passes]
    for k in sorted(W): lines.append('%s\t%s\t%.6g' % (k[0], k[1], W[k]))
    tmp = wfile + '.tmp'
    with open(tmp, 'w') as f: f.write('\n'.join(lines) + '\n')
    os.replace(tmp, wfile)
if mode == 'reinforce':
    ns = sorted(vec)
    for x in range(len(ns)):
        for y in range(x + 1, len(ns)):
            a, b = ns[x], ns[y]
            W[(a, b)] = W.get((a, b), 0.0) + eta * vec[a] * vec[b]
    passes += 1; save()
    print('reinforced pass=%d axes=%d pairs=%d' % (passes, len(ns), len(W)))
elif mode == 'energy':
    print('%.6g' % energy(vec))
elif mode == 'descend':
    recs = []
    for k in vec:
        if vec[k] >= 0: continue
        s = sum(wget(k, j) * vec[j] for j in vec if j != k)
        recs.append((-2.0 * s, k))
    recs.sort()
    strict = [r for r in recs if r[0] < -1e-9]
    if not strict: print('INERT')
    else:
        for dE, k in strict: print('%s\t%.6g' % (k, dE))
elif mode == 'status':
    print('passes\t%d' % passes)
    for (i, j), w in sorted(W.items(), key=lambda kv: -abs(kv[1]))[:8]:
        print('%s~%s\t%.6g' % (i, j, w))
    print('energy\t%.6g' % (energy(vec) if vec else 0.0))
PY
}

# sample_vector — emit "name:±1" tokens for cheaply-readable axes. UNREADABLE axes are OMITTED, never faked.
sample_vector() {
  local out=()
  # egress: integral 0 (or no integral file) = on set-point
  if [ -f "$INTEGRAL_FILE" ]; then
    local integ; integ=$(cut -d' ' -f1 "$INTEGRAL_FILE" 2>/dev/null || echo 0)
    if [ "${integ:-0}" -eq 0 ] 2>/dev/null; then out+=("egress:+1"); else out+=("egress:-1"); fi
  else
    out+=("egress:+1")
  fi
  # load1 < 0.8·cores
  if [ -r /proc/loadavg ]; then
    local l1 cores; l1=$(cut -d' ' -f1 /proc/loadavg); cores=$(nproc 2>/dev/null || echo 1)
    if awk -v l="$l1" -v c="$cores" 'BEGIN{exit !(l < c*0.8)}'; then out+=("load:+1"); else out+=("load:-1"); fi
  fi
  # reflex fleet fresh (best-effort — omit if the checker is absent/errors)
  if command -v mesh-reflex-health >/dev/null 2>&1; then
    if mesh-reflex-health --quiet >/dev/null 2>&1; then out+=("reflex:+1"); else out+=("reflex:-1"); fi
  fi
  # thermal nominal via k10temp (<80C) — omit if unreadable
  local tmax; tmax=$(sensors -u 2>/dev/null | awk -F': ' '/temp[0-9]+_input/{if($2+0>m)m=$2+0} END{if(m>0)print m}')
  if [ -n "$tmax" ]; then
    if awk -v t="$tmax" 'BEGIN{exit !(t < 80)}'; then out+=("thermal:+1"); else out+=("thermal:-1"); fi
  fi
  [ ${#out[@]} -gt 0 ] && printf '%s ' "${out[@]}"
}

# run_optimize — one SO cycle: relax (sample) → reinforce (Hebbian) → descend (advisory recovery ranking).
# ADVISORY ONLY: never touches substrate; the egress invariant fix stays in I_CONTROLLER's hands.
run_optimize() {
  command -v python3 >/dev/null 2>&1 || { log "[somem] python3 absent — self-optimizer tier disabled (advisory)"; return 0; }
  local vec; vec=$(sample_vector)
  [ -z "${vec// }" ] && { log "[somem] no readable axes — skipped (honest: no faked state)"; return 0; }
  SOMEM_VEC="$vec" SOMEM_ETA="${SOMEM_ETA:-1}" _somem reinforce "$SOMEM_FILE" >/dev/null 2>&1
  local rec; rec=$(SOMEM_VEC="$vec" _somem descend "$SOMEM_FILE" 2>/dev/null)
  if [ -z "$rec" ] || [ "$rec" = "INERT" ]; then
    log "[somem] vec=[${vec% }] — no learned pull (inert; per-axis I-controller unchanged)"
  else
    local top; top=$(printf '%s\n' "$rec" | head -1 | cut -f1)
    log "[somem] vec=[${vec% }] — advisory: recover '$top' first (nearest learned coordinated-good basin) [ADVISORY, no substrate action]"
  fi
  return 0
}

# so_selftest — RED-first gate for the SO tier. Empty W must be INERT; a learned W (two axes good TOGETHER,
# one adversarial axis good ALONE) must pull recovery toward the coordinated pair, not the adversarial axis.
so_selftest() {
  command -v python3 >/dev/null 2>&1 || { echo "so-test: FAIL (python3 absent — self-optimizer tier cannot run)"; return 1; }
  local td wf d top; td=$(mktemp -d) || { echo "so-test: FAIL (mktemp)"; return 1; }
  wf="$td/somem.tsv"
  # (1) empty W → descend must be INERT (fail-safe: never worse than per-axis I-controller)
  d=$(SOMEM_VEC="A:-1 B:+1 C:-1" _somem descend "$wf" 2>/dev/null)
  [ "$d" = "INERT" ] || { echo "so-test: FAIL (empty W not inert: '$d')"; rm -rf "$td"; return 1; }
  # (2) synthetic history: A,B always good TOGETHER; C good ALONE (uncorrelated with the pair)
  local h
  for h in "A:+1 B:+1 C:+1" "A:+1 B:+1 C:-1" "A:+1 B:+1 C:+1" "A:+1 B:+1 C:-1" "A:-1 B:-1 C:+1" "A:-1 B:-1 C:+1"; do
    SOMEM_VEC="$h" SOMEM_ETA=1 _somem reinforce "$wf" >/dev/null 2>&1 || { echo "so-test: FAIL (reinforce)"; rm -rf "$td"; return 1; }
  done
  # (3) descend from A-,B+,C-: top correction MUST be A (coordinated pair), and C MUST NOT be recommended
  d=$(SOMEM_VEC="A:-1 B:+1 C:-1" _somem descend "$wf" 2>/dev/null)
  top=$(printf '%s\n' "$d" | head -1 | cut -f1)
  [ "$top" = "A" ] || { echo "so-test: FAIL (descent picked '$top' not coordinated-pair A; out=[$d])"; rm -rf "$td"; return 1; }
  if printf '%s\n' "$d" | cut -f1 | grep -qx C; then
    echo "so-test: FAIL (adversarial good-alone axis C was recommended: out=[$d])"; rm -rf "$td"; return 1
  fi
  rm -rf "$td"
  echo "so-test: ok (empty W inert; learned W pulls recovery to coordinated pair A, not adversarial C)"
  return 0
}

# --- main -----------------------------------------------------------------
case "${1:-}" in
  --test)
    command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl — public-IP fetch impossible)"; exit 1; }
    command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat — drift alerts won't fire)"; exit 1; }
    # mesh-fix-egress is optional (corrective, may need sudo); warn not fail
    command -v mesh-fix-egress >/dev/null 2>&1 || echo "smoke-test: WARN (mesh-fix-egress absent — auto-correction disabled, alerts still work)"
    td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$td"' EXIT
    bin="$td/bin"; home="$td/home"
    empty="$td/empty"
    mkdir -p "$bin" "$home/.mesh" "$empty" 2>/dev/null || { echo "smoke-test: FAIL (temp harness setup)"; exit 1; }
    cat >"$bin/curl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${MESH_HOMEOSTASIS_TEST_IP:-198.51.100.23}"
EOF
    chmod +x "$bin/curl" || { echo "smoke-test: FAIL (curl stub chmod)"; exit 1; }
    cat >"$bin/mesh-chat" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
    chmod +x "$bin/mesh-chat" || { echo "smoke-test: FAIL (mesh-chat stub chmod)"; exit 1; }
    # sudo/mesh-fix-egress stubs: the ultrastability gate below DRIVES escalation, which would otherwise
    # run `sudo -n mesh-fix-egress` for REAL (this node has NOPASSWD sudo — a live substrate action in a
    # --test). Stub sudo to exit 1 (simulates "fix needs operator hand" — the realistic exhausted case);
    # no real egress is ever touched.
    cat >"$bin/sudo" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
    chmod +x "$bin/sudo" || { echo "smoke-test: FAIL (sudo stub chmod)"; exit 1; }
    cat >"$bin/mesh-fix-egress" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
    chmod +x "$bin/mesh-fix-egress" || { echo "smoke-test: FAIL (mesh-fix-egress stub chmod)"; exit 1; }
    # Negative control: without curl on PATH, the dependency gate must fail.
    if PATH="$empty" curl -s -m5 https://ifconfig.me >/dev/null 2>&1; then
      echo "smoke-test: FAIL (missing curl unexpectedly succeeded)"
      exit 1
    fi
    # Dry-run the real controller on a temp HOME using the stubbed curl/mesh-chat path.
    old_home="$HOME" old_mesh="$MESH" old_setpoint="$SETPOINT_FILE" old_integral="$INTEGRAL_FILE" old_log="$LOG"
    HOME="$home"
    MESH="$home/.mesh"
    SETPOINT_FILE="$MESH/homeostasis-setpoint"
    INTEGRAL_FILE="$MESH/homeostasis-integral"
    LOG="$MESH/homeostasis.log"
    PATH="$bin:$PATH"
    _ip=$(MESH_HOMEOSTASIS_TEST_IP=198.51.100.23 curl -s -m5 https://ifconfig.me 2>/dev/null)
    [ "$_ip" = "198.51.100.23" ] || { echo "smoke-test: FAIL (stub curl returned $_ip)"; exit 1; }
    verdict=$(check_setpoint)
    [ "$verdict" = "OK 198.51.100.23" ] || { echo "smoke-test: FAIL (learn-setpoint verdict: $verdict)"; exit 1; }
    [ "$(cat "$SETPOINT_FILE" 2>/dev/null || echo '')" = "198.51.100.23" ] || { echo "smoke-test: FAIL (set-point not learned)"; exit 1; }
    printf '%s\n' '203.0.113.42' > "$SETPOINT_FILE"
    verdict=$(check_setpoint)
    [ "$verdict" = "DRIFT 198.51.100.23 (expected 203.0.113.42)" ] || { echo "smoke-test: FAIL (drift verdict: $verdict)"; exit 1; }
    I_CONTROLLER "$verdict" 7 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "smoke-test: FAIL (controller dry-run exit not 1 on drift)"; exit 1; }
    [ "$(cat "$INTEGRAL_FILE" 2>/dev/null || echo '')" = "7 7 0" ] || { echo "smoke-test: FAIL (integral update drifted)"; exit 1; }
    # ── ULTRASTABILITY gate (RED-first): trials-to-stable-field + fast-loop-exhausted trigger ────────
    # Ashby: the outer-loop signal must fire ONLY when the essential variable stays breached DESPITE the
    # fast loop, i.e. after ULTRA_TRIALS identical fixes. RED half first (no ULTRASTABLE before threshold),
    # then the trigger at the threshold, then recovery reports the reconfiguration COUNT (not error-seconds).
    _drift="DRIFT 198.51.100.23 (expected 203.0.113.42)"
    : > "$LOG"; echo "0 0 0" > "$INTEGRAL_FILE"
    I_CONTROLLER "$_drift" 300 >/dev/null 2>&1                       # integral 300 → trial 1
    grep -q 'ULTRASTABLE' "$LOG" && { echo "smoke-test: FAIL (ultrastable fired at trial 1 — not yet exhausted)"; exit 1; }
    [ "$(cut -d' ' -f3 "$INTEGRAL_FILE" 2>/dev/null)" = "1" ] || { echo "smoke-test: FAIL (fix-trial not counted: [$(cat "$INTEGRAL_FILE")])"; exit 1; }
    I_CONTROLLER "$_drift" 300 >/dev/null 2>&1                       # integral 600 → trial 2
    grep -q 'ULTRASTABLE' "$LOG" && { echo "smoke-test: FAIL (ultrastable fired at trial 2 — not yet exhausted)"; exit 1; }
    I_CONTROLLER "$_drift" 300 >/dev/null 2>&1                       # integral 900 → trial 3 == ULTRA_TRIALS → EXHAUSTED
    grep -q 'ULTRASTABLE: fast loop exhausted' "$LOG" || { echo "smoke-test: FAIL (ultrastable-exhausted trigger did not fire at ULTRA_TRIALS=3)"; exit 1; }
    [ "$(grep -c 'ULTRASTABLE:' "$LOG")" = "1" ] || { echo "smoke-test: FAIL (ultrastable trigger fired more than once per episode)"; exit 1; }
    I_CONTROLLER "OK 198.51.100.23" 300 >/dev/null 2>&1             # recovery
    grep -q 'TRIALS-TO-STABLE-FIELD=3' "$LOG" || { echo "smoke-test: FAIL (recovery did not report TRIALS-TO-STABLE-FIELD=3)"; exit 1; }
    [ "$(cat "$INTEGRAL_FILE" 2>/dev/null)" = "0 0 0" ] || { echo "smoke-test: FAIL (episode not reset after recovery: [$(cat "$INTEGRAL_FILE")])"; exit 1; }
    HOME="$old_home"; MESH="$old_mesh"; SETPOINT_FILE="$old_setpoint"; INTEGRAL_FILE="$old_integral"; LOG="$old_log"
    # self-optimization tier gate (RED-first): must pass or the whole test fails.
    so_selftest || { echo "smoke-test: FAIL (self-optimization tier gate failed above)"; exit 1; }
    echo "smoke-test: ok (missing curl fails; stubbed curl learns set-point and drives controller dry-run; ultrastability trials-to-stable-field + fast-loop-exhausted trigger gated RED-first; SO tier gated)"
    exit 0 ;;
  --status)
    show_status; exit 0 ;;
  --set-point)
    sp="${2:?usage: mesh-homeostasis --set-point <ip>}"
    echo "$sp" > "$SETPOINT_FILE"
    echo "set-point = $sp"; exit 0 ;;
  --reset)
    echo "0 0 0" > "$INTEGRAL_FILE"
    echo "integral reset"; exit 0 ;;
  --optimize)
    if [ "${2:-}" = "--status" ]; then
      _vec=$(sample_vector)
      echo "  self-optimization associative memory ($SOMEM_FILE):"
      SOMEM_VEC="$_vec" _somem status "$SOMEM_FILE" 2>/dev/null | sed 's/^/    /'
      echo "    current vec: [${_vec% }]"
      exit 0
    fi
    run_optimize; exit 0 ;;
  ""|--check)
    verdict=$(check_setpoint)
    I_CONTROLLER "$verdict" "${CHECK_DT:-120}"
    exit $? ;;
  --loop)
    iv="${2:-120}"
    echo "[homeostasis] loop every ${iv}s, set-point=NL"
    while true; do
      verdict=$(check_setpoint)
      I_CONTROLLER "$verdict" "$iv"
      sleep "$iv"
    done ;;
  *) echo "usage: mesh-homeostasis [--check | --status | --reset | --loop [sec] | --optimize [--status] | --test]" >&2; exit 1 ;;
esac
