#!/usr/bin/env bash
# mesh-ear — always-on, consent-gated, ZERO-COST-IDLE ear with a wake-word reflex.
#
# Ethos: MORE REFLEX, LESS INTELLIGENCE (intelligence is expensive). Temporary bonds, for use:
# the always-on part is tiny; the heavy chain assembles on trigger and is released.
#
#   layer 1  energy reflex (RMS)        always on, ~free — gates everything below
#   layer 2  local whisper (tiny)       $0, runs ONLY on detected speech — spots the WAKE WORD
#   layer 3  cheapest mind (opencode)   fires ONLY on the wake word, on the recent overheard buffer
#   layer 4  voice (piper / mesh-tts)   speaks the opinion
# Idle cost = $0 (just CPU metering energy). A model is touched only when you say the word.
#
# CONSENT: always-on mic demands CONSCIOUS consent. --listen REFUSES unless ~/.mesh/consent has
# `mic_always = yes`. Only a short ROLLING TEXT buffer of recent speech is kept (not raw audio);
# old lines are overwritten. Revoke instantly: delete the line / set `= no`.
#
#   mesh-ear --listen     run the always-on reflex loop (put it in a tmux window)
#   mesh-ear --now        on-demand: transcribe recent buffer + opinion + speak (no wake word)
#   mesh-ear --buffer     print the recent overheard text buffer
#   mesh-ear --consent    show the consent grant
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
MESH="$HOME/.mesh"; CONSENT="$MESH/consent"; BUF="$MESH/ear-buffer.txt"
HOST="${HOSTNAME:-$(hostname 2>/dev/null || true)}"
PHONE="${EAR_PHONE:-}"  # user@ip for torch indicator, e.g. u0_a386@<ts-ip>
WHISP="$MESH/whispercpp/main"
SPOT_MODEL="${EAR_SPOT_MODEL:-$MESH/whispercpp/models/for-tests-ggml-tiny.bin}"   # fast wake-spotting
FULL_MODEL="${EAR_MODEL:-$MESH/whispercpp/models/ggml-base.bin}"                  # accurate reflex transcribe
WAKE="${EAR_WAKE:-меш}"            # the keyword to drill; change freely
CHUNK="${EAR_CHUNK:-4}"            # seconds per listen chunk
RMS_MIN="${EAR_RMS_MIN:-260}"     # energy gate: below this = silence, skip whisper (free)
KEEP="${EAR_KEEP:-10}"            # rolling buffer: keep last N speech lines
MIND="${EAR_MIND:-opencode}"
VOICE="${EAR_VOICE:-irina}"

smoke_test(){
  have(){ command -v "$1" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $1)"; exit 1; }; }
  for dep in python3 mktemp timeout grep sed tr tail date; do
    have "$dep"
  done
  command -v pw-record >/dev/null 2>&1 || command -v arecord >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (no recorder: pw-record/arecord)"; exit 1; }
  [ -d "$MESH" ] && [ -w "$MESH" ] || { echo "smoke-test: FAIL (no writable $MESH)"; exit 1; }
  [ -x "$WHISP" ] || { echo "smoke-test: FAIL (no whisper at $WHISP)"; exit 1; }
  [ -r "$SPOT_MODEL" ] || { echo "smoke-test: FAIL (no spot model at $SPOT_MODEL)"; exit 1; }
  [ -r "$FULL_MODEL" ] || { echo "smoke-test: FAIL (no full model at $FULL_MODEL)"; exit 1; }
  tmp="$(mktemp --suffix=.wav)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  tmpbuf="$(mktemp)" || { echo "smoke-test: FAIL (tmp buffer mktemp)"; exit 1; }
  trap 'rm -f "$tmp" "$tmpbuf"' EXIT
  python3 - "$tmp" <<'PY' >/dev/null 2>&1 || { echo "smoke-test: FAIL (wav fixture write failed)"; exit 1; }
import math, struct, sys, wave
path = sys.argv[1]
with wave.open(path, "wb") as w:
    w.setnchannels(1)
    w.setsampwidth(2)
    w.setframerate(16000)
    frames = bytearray()
    for i in range(1600):
        sample = int(12000 * math.sin(2 * math.pi * 440 * i / 16000))
        frames += struct.pack("<h", sample)
    w.writeframes(frames)
PY
  level="$(rms "$tmp")"
  [ "${level:-0}" -gt 0 ] || { echo "smoke-test: FAIL (rms helper unreadable)"; exit 1; }
  printf 'probe line\n' >> "$tmpbuf" 2>/dev/null || { echo "smoke-test: FAIL (tmp buffer not writable)"; exit 1; }
  tail -n 1 "$tmpbuf" | grep -q "probe line" || { echo "smoke-test: FAIL (tmp buffer readback failed)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
}

consent_mic(){ grep -qiE '^[[:space:]]*mic[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" 2>/dev/null; }
consent_always(){ grep -qiE '^[[:space:]]*mic_always[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" 2>/dev/null; }

announce(){ local say="$HOME/.local/bin/mesh-say"; [ -x "$say" ] && "$say" "mic is listening in this room" >/dev/null 2>&1 || true; }
torch_indicator(){ [ -z "$PHONE" ] && return; local i=0; while [ "$i" -lt 3 ]; do ssh -o BatchMode=yes -o ConnectTimeout=4 -p "${EAR_PHONE_PORT:-8022}" "$PHONE" "termux-torch on" >/dev/null 2>&1; sleep 0.5; ssh -o BatchMode=yes -o ConnectTimeout=4 -p "${EAR_PHONE_PORT:-8022}" "$PHONE" "termux-torch off" >/dev/null 2>&1; sleep 0.5; i=$((i+1)); done; }
trace(){ local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "$ts  mesh-ear@$HOST  ::  $*" >> "$MESH/traces.log"; echo "$ts  mesh-ear@$HOST  ::  $*"; }

rec(){ # record CHUNK seconds of 16k mono wav -> $1
  ( timeout $((CHUNK+2)) pw-record --rate 16000 --channels 1 "$1" 2>/dev/null ) \
    || ( timeout $((CHUNK+2)) arecord -q -f S16_LE -r 16000 -c1 -d "$CHUNK" "$1" 2>/dev/null ) || true
}
rms(){ python3 - "$1" <<'PY' 2>/dev/null || echo 0
import sys,wave,audioop
try:
    w=wave.open(sys.argv[1],'rb'); print(audioop.rms(w.readframes(w.getnframes()),2))
except Exception: print(0)
PY
}
transcribe(){ # $1 wav  $2 model -> stdout text
  "$WHISP" -m "$2" -f "$1" -nt -l auto -t 4 2>/dev/null | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}
buffer_push(){ printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$1" >> "$BUF"; tail -n "$KEEP" "$BUF" > "$BUF.t" && mv "$BUF.t" "$BUF"; }

reflex(){ # the temporary bond: recent buffer -> cheapest opinion -> voice. Assembled, fired, released.
  local recent prompt reply
  recent="$(tail -n "$KEEP" "$BUF" | sed 's/^[0-9:Z]*  //')"
  [ -z "$recent" ] && recent="(тихо, ничего разборчивого)"
  prompt="Ты тихо слушал комнату как ambient-присутствие. Вот недавно услышанное (транскрипт, может быть с ошибками): «$recent». Дай очень короткое живое мнение или реакцию по-русски, 1-2 фразы, без преамбул."
  if command -v "$MIND" >/dev/null 2>&1; then
    reply="$(timeout "${EAR_MIND_TIMEOUT:-40}" "$MIND" run "$prompt" 2>/dev/null | tail -n 20 | tr '\n' ' ' | sed 's/^[[:space:]]*//')"
  fi
  [ -z "${reply:-}" ] && reply="Я слушал, но мысль не собралась."
  echo ">> $reply"
  local hour; hour="$(date +%H)"
  if [ "${EAR_FORCE_VOICE:-0}" = 1 ] || [ "$hour" -ge 09 ] 2>/dev/null; then
    EAR_VOICE="$VOICE" MESH_TTS_VOICE="$VOICE" mesh-tts "$reply" 2>/dev/null || true
  else
    echo "[quiet hours <09:00 — not speaking; opinion logged above]"
  fi
}

case "${1:-}" in
  --test) smoke_test ;;
  --consent)
    mkdir -p "$MESH"; touch "$BUF"
    echo "mic=$(consent_mic && echo yes || echo no)  mic_always=$(consent_always && echo yes || echo no)"
    grep -iE '^[[:space:]]*scope' "$CONSENT" 2>/dev/null ;;
  --buffer) mkdir -p "$MESH"; touch "$BUF"; echo "=== recent overheard (text only) ==="; cat "$BUF" ;;
  --now)
    mkdir -p "$MESH"; touch "$BUF"
    consent_mic || { echo "mesh-ear: no mic consent (~/.mesh/consent: mic = yes)"; exit 3; }
    trace "[sense] START: one-shot mic capture"
    tmp="$(mktemp --suffix=.wav)"; rec "$tmp"
    r="$(rms "$tmp")"; echo "rms=$r"
    if [ "$r" -ge "$RMS_MIN" ]; then t="$(transcribe "$tmp" "$FULL_MODEL")"; [ -n "$t" ] && buffer_push "$t" && echo "heard: $t"; fi
    rm -f "$tmp"; reflex ;;
  --listen)
    mkdir -p "$MESH"; touch "$BUF"
    consent_always || { cat >&2 <<EOF
mesh-ear --listen REFUSED — always-on mic needs CONSCIOUS consent.
It will: continuously listen on this laptop's mic, keep only a short rolling TEXT buffer of
recent speech (older overwritten, no raw audio kept), and ONLY when it hears the wake word
'"'"$WAKE"'"' assemble a one-off reflex (cheapest model gives a short opinion, spoken aloud).
Idle cost is \$0. To consent, add to ~/.mesh/consent:   mic_always = yes
EOF
      exit 3; }
    # Dormant/focus mode: ear is a quota-leak (wake-word fires minds bypassing the pause).
    # Self-check: if mode file says dormant or focus, exit cleanly rather than burn quota.
    _mode="$(cat "$MESH/mode" 2>/dev/null | tr -d '[:space:]' || echo "normal")"
    if [ "$_mode" = "dormant" ] || [ "$_mode" = "focus" ]; then
      echo "mesh-ear: mode=$_mode — ear disabled (wake-word would bypass quota pause)" >&2
      exit 0
    fi
    [ -x "$WHISP" ] || { echo "mesh-ear: whisper not found at $WHISP" >&2; exit 1; }
    trace "[sense] START: always-on mic wake-word reflex (wake='$WAKE')"
    announce
    torch_indicator
    echo "[mesh-ear] always-on reflex; wake='$WAKE'; idle=\$0; consent OK. (more reflex, less mind)"
    while true; do
      tmp="$(mktemp --suffix=.wav)"; rec "$tmp"
      r="$(rms "$tmp")"
      if [ "$r" -ge "$RMS_MIN" ]; then                       # layer 1: energy reflex
        spot="$(transcribe "$tmp" "$SPOT_MODEL")"             # layer 2: tiny whisper, $0
        if [ -n "$spot" ]; then
          buffer_push "$spot"
          if echo "$spot" | grep -qiF "$WAKE"; then           # wake word -> temporary bond
            echo "[wake] '$WAKE' heard -> reflex"
            reflex                                            # layers 3+4, then released
          fi
        fi
      fi
      rm -f "$tmp"
    done ;;
  *) echo "usage: mesh-ear [--listen|--now|--buffer|--consent]" >&2; exit 1 ;;
esac
