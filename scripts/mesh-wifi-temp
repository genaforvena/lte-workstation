#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# reflex-args: --edge
# mesh-wifi-temp — the WiFi radio's OWN thermal sense, from /sys/class/hwmon/hwmon*/temp1_input
# where name matches iwlwifi* (this node's Intel wireless card exposes its own hwmon device).
#
# Why this is new:
#   The tree already senses chassis/CPU/NVMe/battery heat (mesh-therm, mesh-nvme-temp,
#   mesh-battery-voltage) but never the radio die itself. iwlwifi is a distinct heat source
#   under sustained load (this node is a Tailscale exit-node relaying other peers' traffic) —
#   a hot radio can throttle TX power or drop links before generic thermal zones move, and the
#   existing wifi senses (mesh-wifi-link/-quality/-rf/-contention) only touch link/signal
#   metrics, never the chip's own junction temperature.
#
# Honest contract:
#   no readable iwlwifi hwmon temperature -> exit 2, never fabricate a reading
#
#   mesh-wifi-temp            one read → one classified line
#   mesh-wifi-temp --json     machine-readable
#   mesh-wifi-temp --edge     emit only on band change (state still refreshed every success)
#   mesh-wifi-temp --test     fixture-backed classifier + real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.wifi-temp.state"
OFFLINEFILE="$MESH/.wifi-temp-offline"
ROOT="${MESH_WIFI_TEMP_ROOT:-/sys/class/hwmon}"
mkdir -p "$MESH" 2>/dev/null || true

discover_wifi_hwmon() {
  local d name f raw
  shopt -s nullglob
  for d in "$ROOT"/hwmon*; do
    [ -r "$d/name" ] || continue
    name="$(cat "$d/name" 2>/dev/null)"
    case "$name" in iwlwifi*) : ;; *) continue ;; esac
    f="$d/temp1_input"
    [ -r "$f" ] || continue
    raw="$(cat "$f" 2>/dev/null)"
    case "$raw" in ''|*[!0-9]*) continue ;; esac
    printf '%s\t%s\t%s\n' "$raw" "$name" "$f"
    shopt -u nullglob
    return 0
  done
  shopt -u nullglob
  return 1
}

format_c() {
  awk -v m="${1:-}" 'BEGIN{
    if (m == "" || m !~ /^[0-9]+$/) exit 1
    printf "%.1f", m / 1000
  }'
}

classify_temp() {
  local raw="${1:-}"
  case "$raw" in ''|*[!0-9]*) echo UNKNOWN; return ;; esac
  if [ "$raw" -ge 85000 ] 2>/dev/null; then
    echo HOT
  elif [ "$raw" -ge 60000 ] 2>/dev/null; then
    echo WARM
  else
    echo COOL
  fi
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/hwmon0" "$td/hwmon1"
  printf 'coretemp\n' > "$td/hwmon0/name"
  printf '50000\n' > "$td/hwmon0/temp1_input"
  printf 'iwlwifi_1\n' > "$td/hwmon1/name"
  printf '46500\n' > "$td/hwmon1/temp1_input"
  got="$(MESH_WIFI_TEMP_ROOT="$td" bash "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"COOL"' || { echo "smoke-test: FAIL (fixture label COOL: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"temp_c":46.5' || { echo "smoke-test: FAIL (fixture temp 46.5C: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"source":"iwlwifi_1"' || {
    echo "smoke-test: FAIL (fixture picked wrong hwmon, not iwlwifi: $got)"; exit 1;
  }

  td2="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp2)"; exit 1; }
  mkdir -p "$td2/hwmon0"
  printf 'coretemp\n' > "$td2/hwmon0/name"
  printf '50000\n' > "$td2/hwmon0/temp1_input"
  MESH_WIFI_TEMP_ROOT="$td2" bash "$0" --json >/dev/null 2>&1
  rc2=$?
  [ "$rc2" = 2 ] || { echo "smoke-test: FAIL (no-iwlwifi-hwmon fixture should exit 2, got rc=$rc2)"; rm -rf "$td2"; exit 1; }
  rm -rf "$td2"

  real="$(bash "$0" --json 2>/dev/null)" || { echo "smoke-test: n/a (no live iwlwifi hwmon source on this node)"; exit 2; }
  printf '%s\n' "$real" | grep -q '"source":"iwlwifi' || {
    echo "smoke-test: FAIL (live read missing iwlwifi source: $real)"; exit 1;
  }
  printf '%s\n' "$real" | grep -q '"temp_c":[0-9]' || {
    echo "smoke-test: FAIL (live read missing numeric temperature: $real)"; exit 1;
  }
  echo "smoke-test: ok (fixture classify + non-iwlwifi-hwmon-skip + honest exit-2 + live iwlwifi hwmon read)"
  exit 0
fi

JSON=0
EDGE=0
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --edge) EDGE=1 ;;
  esac
done

readout="$(discover_wifi_hwmon 2>/dev/null || true)"
[ -n "$readout" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "wifi-temp: UNREACHABLE — no readable iwlwifi hwmon temp1_input" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

IFS=$'\t' read -r RAW NAME SOURCE <<<"$readout"
TEMP_C="$(format_c "$RAW")" || { echo "wifi-temp: UNREACHABLE — invalid temperature '$RAW'" >&2; exit 2; }
LABEL="$(classify_temp "$RAW")"
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
PREV_LABEL=""
[ -f "$STATE" ] && PREV_LABEL="$(cut -d'|' -f1 "$STATE" 2>/dev/null || true)"

printf '%s|%s|%s|%s|%s|%s\n' "$LABEL" "$RAW" "$TEMP_C" "$NAME" "$SOURCE" "$TS" > "$STATE"
mesh-state-touch "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","temp_mC":%s,"temp_c":%s,"source":"%s","ts":"%s"}\n' \
    "$LABEL" "$RAW" "$TEMP_C" "$NAME" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ] && [ "$PREV_LABEL" = "$LABEL" ]; then
  exit 0
fi

printf '[wifi-temp] %s — %s°C (source=%s) @ %s %s\n' \
  "$LABEL" "$TEMP_C" "$NAME" "$(hostname)" "$TS"
