#!/usr/bin/env bash
# mesh-chaos-verify — chaos engineering for the SESSION'S resilience build: induce the exact failures
# each detector is meant to catch, assert it fires. Unlike mesh-chaos (live, opt-in, recovers a real
# reflex), this runs in an ISOLATED $HOME sandbox — no live-mesh disruption, no operator alerts — so
# it's a safe, repeatable proof that the detectors WORK under real induced failure, not just unit tests.
#
#   mesh-chaos-verify        run all drills, print PASS/FAIL table
#
# DRILL 4 is a SECOND-ORDER drill and it is expected to be RED on this mesh — see the DOSE-LADDER
# block below. That is the harness working: drills 1-3 each induce ONE dose and assert a boolean,
# which proves a detector fired AT THAT DOSE and licenses nothing about any other. `--test` stays
# green (it drives the ladder ANALYZER against synthetic fixtures, never the live detectors), so
# mesh-doctor's hourly sweep is unaffected by a detector being blind.
set -uo pipefail
BIN="$HOME/.local/bin"

# ── DOSE-LADDER: the second-order stress test ────────────────────────────────────────────────
# Taleb & Douady's fragility detection heuristic (arXiv:1208.1189; IMF WP/12/216, "A New Heuristic
# Measure of Fragility and Tail Risks: Application to Stress Testing") is explicitly a critique of
# the shape of test drills 1-3 have: a stress test reporting the outcome at ONE shock level is
# uninformative, because the load-bearing quantity is how the response BENDS across a ladder of
# shocks. Restated operationally for dose-response curves in "Working with Convex Responses:
# Antifragility from Finance to Oncology" (Entropy 25(2):343 / arXiv:2209.14631).
#
# Two failure modes are structurally invisible to a single-dose drill, and both are real here:
#   NONMONOTONE  — the detector fires at the drilled dose and goes SILENT at a larger one (a bounded
#                  numeric compare, a window with an upper edge, a wrapped counter). Nothing in a
#                  boolean-at-one-dose drill can see this.
#   VACUOUS-DOSE — the drilled dose sits ABOVE the point where the response saturates, so the drill
#                  proves the detector fires and proves nothing about the discrimination it claims.
#                  MEASURED 2026-08-26 against the live mesh-phi: phi pegs at 12.00 from ~1.8x
#                  cadence upward (p_later is clamped at 1e-12 under a NORMAL tail), so a beat 1.8x
#                  late and one 1024x late — 7 days — print the identical 12.00 to every consumer.
#                  The usable band between "first suspects" (phi>=8) and "pegged" is 1.09x of dose,
#                  and that ratio is invariant to the observed jitter (0.00/0.05/0.10/0.20/0.40 all
#                  give 1.09-1.13x). Drill 3 induces a 4x gap — deep inside the flat region — so its
#                  PASS has always been a PASS about firing, never about "adaptive suspicion".
# The analyzer below MEASURES floor and saturation off the detector itself (log-bisection, never a
# quoted constant) and publishes the range, so the band a detector can still discriminate in is a
# number the drill prints rather than a property nobody checked.
DOSE_LADDER="1 1.2 1.5 2 3 4 8 16 64 256 1024 4096"
DOSE_HI=4096                       # top of the ladder; a sat at/above DOSE_SAT_UNBOUNDED reads as
DOSE_SAT_UNBOUNDED=2048            # "does not saturate within the ladder", not as a saturation dose

_ge(){ awk -v r="$1" -v t="$2" 'BEGIN{exit !(r>=t)}'; }

# bisect_dose <probe-fn> <threshold> -> smallest dose in [1,DOSE_HI] with response >= threshold,
# or "none". Log-bisection: doses span 3.6 decades, so the midpoint is the GEOMETRIC one.
bisect_dose(){
  local fn=$1 thr=$2 lo=1 hi=$DOSE_HI i mid
  _ge "$($fn "$DOSE_HI")" "$thr" || { echo none; return; }
  _ge "$($fn 1)"          "$thr" && { echo 1.00; return; }
  for i in $(seq 1 22); do
    mid=$(awk -v a="$lo" -v b="$hi" 'BEGIN{printf "%.6f", sqrt(a*b)}')
    if _ge "$($fn "$mid")" "$thr"; then hi=$mid; else lo=$mid; fi
  done
  awk -v h="$hi" 'BEGIN{printf "%.2f", h}'
}

# curve_verdict <probe-fn> <suspect-threshold> <the dose the drill actually induces>
#   -> "<VERDICT> floor=..x sat=..x range=..x drilled=..x"
# VERDICT is one of OK | NONMONOTONE | NEVER-FIRES | VACUOUS-DOSE | FLAT. They are kept APART on
# purpose: "the detector never fired" and "the detector fired but cannot tell 2x from 1000x" are
# different repairs, and a single FAIL word would collapse them onto one row.
curve_verdict(){
  local fn=$1 thr=$2 drilled=$3
  local d r prev="" prevd="" r1 rmax eps floor sat rng satr
  # Monotonicity FIRST and it returns on the spot: a detector that un-fires at a bigger dose makes
  # every downstream number meaningless (the ladder endpoints would read as FLAT, and a non-monotone
  # detector reported as "flat" is the one word that hides it). Name the pair that inverted.
  for d in $DOSE_LADDER; do
    r=$($fn "$d")
    if [ -n "$prev" ] && awk -v a="$prev" -v b="$r" 'BEGIN{exit !(b < a - 1e-9)}'; then
      echo "NONMONOTONE floor=na sat=na range=na drilled=${drilled}x (response fell ${prev}->${r} between ${prevd}x and ${d}x)"; return
    fi
    prev=$r; prevd=$d
  done
  r1=$($fn 1); rmax=$($fn "$DOSE_HI")
  if awk -v a="$r1" -v b="$rmax" 'BEGIN{exit !(b-a <= 1e-9)}'; then
    echo "FLAT floor=na sat=na range=na drilled=${drilled}x (response never moves across the ladder)"; return
  fi
  eps=$(awk -v a="$r1" -v b="$rmax" 'BEGIN{e=0.001*(b-a); if(e<1e-6)e=1e-6; printf "%.9f", e}')
  floor=$(bisect_dose "$fn" "$thr")
  sat=$(bisect_dose "$fn" "$(awk -v m="$rmax" -v e="$eps" 'BEGIN{printf "%.9f", m-e}')")
  if [ "$sat" != none ] && awk -v s="$sat" -v u="$DOSE_SAT_UNBOUNDED" 'BEGIN{exit !(s>=u)}'; then sat=unsaturated; fi
  # render: only a real dose carries the "x" unit — "unsaturatedx"/"nonex" would be a unit worn by a
  # word, and a reader grepping for a number would take the prefix.
  satr=$sat; case "$sat" in unsaturated|none) ;; *) satr="${sat}x" ;; esac
  local floorr=$floor; case "$floor" in none) ;; *) floorr="${floor}x" ;; esac
  if [ "$floor" = none ] || [ "$sat" = unsaturated ] || [ "$sat" = none ]; then rng=na
  else rng=$(awk -v s="$sat" -v f="$floor" 'BEGIN{printf "%.2fx", s/f}'); fi
  local verdict=OK
  [ "$floor" = none ] && verdict=NEVER-FIRES
  [ "$verdict" = OK ] && [ "$sat" != unsaturated ] && [ "$sat" != none ] \
    && awk -v d="$drilled" -v s="$sat" 'BEGIN{exit !(d>=s)}' && verdict=VACUOUS-DOSE
  echo "$verdict floor=${floorr} sat=${satr} range=${rng} drilled=${drilled}x"
}

# --test: fast dependency self-check. Creates NO sandbox, runs NONE of the heavy drills (which
# spawn `sleep 86400` + 8 supervise passes — far too slow/disruptive for a smoke pass). The
# load-bearing assertion is the 3 SIBLING TOOLS this harness drills: each is symlinked into the
# sandbox at run (line below) — if one is missing, `ln -sf "$BIN/$t"` makes a DANGLING symlink and
# that drill silently false-FAILs (the harness reports a detector broken when really the detector
# is just absent). Assert they exist up front. Plus mktemp (the isolated $HOME) + awk (drill-3's
# phi comparison). Prove: `bash mesh-chaos-verify --test` (PASS) vs
#        `HOME=$(mktemp -d) bash mesh-chaos-verify --test` (FAIL — $BIN points at an empty home).
if [ "${1:-}" = --test ]; then
  fail=0
  for t in mesh-supervise mesh-phi mesh-mind-watch; do
    if [ -x "$BIN/$t" ]; then
      echo "  ok: $t present ($BIN/$t)"
    else
      echo "  FAIL: $t missing from $BIN — its drill would dangle and false-FAIL"; fail=1
    fi
  done
  command -v mktemp >/dev/null 2>&1 && echo "  ok: mktemp present (isolated sandbox HOME)" \
    || { echo "  FAIL: mktemp missing — cannot build the isolated sandbox"; fail=1; }
  command -v awk >/dev/null 2>&1 && echo "  ok: awk present (drill-3 phi-accrual compare)" \
    || { echo "  FAIL: awk missing — drill-3 phi discrimination would break"; fail=1; }
  # The dose-ladder ANALYZER, driven against synthetic responders — never against the live
  # detectors, so this stays green while drill 4 reports a real blindness in mesh-phi. Three
  # fixtures, three verdicts: the CONTROL is what makes the other two mean anything (an analyzer
  # that shouted VACUOUS-DOSE at everything would pass a two-fixture suite).
  __probe_lin(){     awk -v d="$1" 'BEGIN{printf "%.6f", d}'; }                      # unbounded
  __probe_sat(){     awk -v d="$1" 'BEGIN{r=d; if(r>3)r=3; printf "%.6f", r}'; }     # pegs at 3
  __probe_nonmono(){ awk -v d="$1" 'BEGIN{r=d; if(d>=10)r=0; printf "%.6f", r}'; }   # un-fires
  for spec in "lin OK" "sat VACUOUS-DOSE" "nonmono NONMONOTONE"; do
    set -- $spec
    got=$(curve_verdict "__probe_$1" 2 4)
    case "$got" in
      "$2"*) echo "  ok: dose-ladder analyzer says $2 for the $1 responder ($got)" ;;
      *)     echo "  FAIL: dose-ladder analyzer: $1 responder expected $2, got: $got"; fail=1 ;;
    esac
  done
  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL (missing dep — drills would false-FAIL)"; exit 1; }
fi

SBX=$(mktemp -d "${TMPDIR:-/tmp}"/chaos-verify.XXXXXX)
export HOME="$SBX"; mkdir -p "$SBX/.mesh" "$SBX/.local/bin"
# expose the real tools inside the sandbox HOME
for t in mesh-supervise mesh-phi mesh-mind-watch; do ln -sf "$BIN/$t" "$SBX/.local/bin/$t" 2>/dev/null; done
export PATH="$SBX/.local/bin:$PATH"
pass=0; fail=0
ok(){ echo "  PASS  $1"; pass=$((pass+1)); }
no(){ echo "  FAIL  $1"; fail=$((fail+1)); }
echo "=== mesh-chaos-verify @ $(date -u +%FT%TZ) (sandbox $SBX) ==="

# ── DRILL 1: OTP restart-intensity — a child that always dies should STORM (stop) after RMAX ──
echo "» drill 1: OTP restart-intensity (storm → stop)"
printf 'canary | __chaos_canary_neverruns__ | false\n' > "$SBX/.mesh/supervise.list"
for i in $(seq 1 8); do MESH_SUP_MAXR=5 MESH_SUP_WINSEC=600 mesh-supervise >/dev/null 2>&1; done
if [ -f "$SBX/.mesh/.sup-storm-canary" ] && grep -q "STORM canary" "$SBX/.mesh/supervise.log" 2>/dev/null; then
  ok "restart-storm detected → supervisor STOPPED restarting (OTP intensity)"
else no "restart-storm NOT caught (storm flag/log missing)"; fi

# ── DRILL 2: WEDGED beat — a live process with a stale beat should be flagged WEDGED ──
echo "» drill 2: WEDGED detection (live proc, stale beat)"
sleep 86400 & cpid=$!   # a 'loop' that's alive but not beating
printf 'wedger | sleep 86400 | sleep 86400\n' > "$SBX/.mesh/supervise.list"
touch -d '40 minutes ago' "$SBX/.mesh/wedger.beat"
out=$(MESH_SUP_MAXR=99 mesh-supervise --status 2>&1)
echo "$out" | grep -q "WEDGED wedger" && ok "stale-beat loop flagged WEDGED" || no "WEDGED not detected ($out)"
kill "$cpid" 2>/dev/null

# ── DRILL 3: phi-accrual — a beat gap far beyond the learned rhythm should suspect (phi high) ──
echo "» drill 3: phi-accrual adaptive suspicion"
H="$SBX/.mesh/phi-drill"; base=1000000; PHI_MU=600; PHI_DRILL_DOSE=4   # the ONE dose drill 3 induces
for i in 0 1 2 3 4; do mesh-phi "$H" $((base+i*PHI_MU)) $((base+i*PHI_MU)) >/dev/null; done
PHI_LAST=$((base+4*PHI_MU))
phi_ok=$(mesh-phi "$H" "$PHI_LAST" $((PHI_LAST+PHI_MU)))                       # on-time
phi_bad=$(mesh-phi "$H" "$PHI_LAST" $((PHI_LAST+PHI_DRILL_DOSE*PHI_MU)))       # 4x gap
awk -v a="$phi_ok" -v b="$phi_bad" 'BEGIN{exit !(a<2 && b>=8)}' \
  && ok "phi adaptive: on-time phi=$phi_ok (calm), ${PHI_DRILL_DOSE}x-gap phi=$phi_bad (suspect)" \
  || no "phi not discriminating (on-time=$phi_ok, gap=$phi_bad)"

# ── DRILL 4: dose-response CURVATURE of the phi detector (the second-order stress test) ──
# Drill 3 above is a single-dose boolean. This one sweeps the ladder and asks the question drill 3
# structurally cannot: over what BAND of dose does the detector still discriminate? Expected RED on
# this mesh — mesh-phi's normal-tail p is clamped at 1e-12, so phi pegs at 12.00 and drill 3's dose
# lives inside the flat region. The verdict names WHICH blindness; do not read it as drill 3 failing.
echo "» drill 4: dose-response curvature (second-order stress test of the phi detector)"
phi_probe(){ local el; el=$(awk -v m="$PHI_MU" -v d="$1" 'BEGIN{printf "%d", m*d}')
             mesh-phi "$H" "$PHI_LAST" $((PHI_LAST+el)); }
verdict=$(curve_verdict phi_probe 8 "$PHI_DRILL_DOSE")
case "$verdict" in
  OK*) ok "phi dose-response: $verdict" ;;
  *)   no "phi dose-response: $verdict — the drilled dose proves firing, not discrimination" ;;
esac

echo "=== chaos-verify: $pass passed, $fail failed ==="
rm -rf "$SBX"
[ "$fail" -eq 0 ]
