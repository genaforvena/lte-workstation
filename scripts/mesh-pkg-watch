#!/usr/bin/env bash
# mesh-pkg-watch — SENSE: system-package patch-drift. Surfaces the SILENT BLIND SPOT where a whole apt
# pocket is EXCLUDED from unattended-upgrades' Allowed-Origins, so packages that land only in that pocket
# sit un-applied forever while the reflex reports itself healthy (it IS running — just with a narrower
# blast radius than its name implies; the [[reflex-stale-can-be-honest-blindness]] shape one layer down).
#
# FIND (discover 2026-07-31, verified by health 13:04Z; knowledge/capability-apt-noble-updates-pocket-
# excluded-unattended-upgrades-mesh-home-20260731.md): on mesh-home, `apt-check` reports 34 upgradable /
# 2 security; `/etc/apt/apt.conf.d/50unattended-upgrades` Allowed-Origins lists `${distro_codename}` +
# `-security` (+ESM) but NOT `-updates` — Ubuntu's routine (non-security) SRU pocket. So nftables /
# libnftables1 (the firewall backend mesh-fix-egress/mesh-card reason about), iproute2, apport (the mesh's
# own newly-found sense), apparmor, coreutils sit upgradable-but-never-auto-applied. unattended-upgrades
# is NOT dead (weekly real installs, verified) — it is SCOPED, and nobody watched what accumulates in the
# unscoped pocket. `mesh-sync-tools` checks genome↔~/.local/bin drift; nothing checked installed↔available
# SYSTEM-package drift. This is that watcher — a THIRD orthogonal channel (policy-level patch coverage).
#
# DOCTRINE BOUNDARY: this SENSES and REPORTS. It does NOT widen Allowed-Origins — auto-applying
# noble-updates would unattended-upgrade nftables/iproute2/tailscale (substrate!), a security-posture
# change that is the OPERATOR's call (CLAUDE.md: confirm before outward/substrate-adjacent change).
# The tool's job is to make the blind spot VISIBLE and LOUD only for load-bearing packages.
#
# CORRECTNESS (avoid the hollow gate): "stuck" is NOT "upgradable" — it is "upgradable AND in a pocket the
# unattended-upgrades config does NOT cover". So the detector reads BOTH the config (which suites are
# covered) AND `apt list --upgradable` (which pocket each pending pkg is in); a pkg whose pocket ∈ covered
# is NOT stuck (it applies next run). If the config were FIXED to include -updates, every noble-updates pkg
# flips to covered and the count goes to 0 — the gate is NOT a constant (test asserts that transition).
# Fail-CLOSED to n/a: no apt / no config / an UNPARSEABLE Allowed-Origins (zero covered suites) → exit 2,
# never "flag all 34" (an empty covered-set would call everything stuck — the classic fusion false-alarm).
#
# reflex-cadence: 17 4 * * 1
# reflex-args: --once
#
# USAGE
#   mesh-pkg-watch [--once]   assess now: OK (exit 0) / STUCK (exit 1, [fyi] on load-bearing) / n/a (exit 2)
#   mesh-pkg-watch --test     RED-first synthetic fixtures + a live real-read gate
#
# ENV (mostly test injection): MESH_PKG_WATCH_CONFIG (50unattended-upgrades path) ·
#   MESH_PKG_WATCH_APTLIST (a file holding `apt list --upgradable` output) · MESH_PKG_WATCH_CODENAME
#   (override lsb codename) · MESH_PKG_WATCH_NO_POST (never post — for --test) · MESH_PKG_WATCH_LB
#   (override the load-bearing set)
set -uo pipefail

# Load-bearing = packages whose staleness touches the mesh's own substrate/senses (per the find).
DEFAULT_LB="nftables libnftables1 tailscale apport apport-core-dump-handler openssh-server openssh-client openssh-sftp-server iproute2 apparmor libssl3 libssl3t64 openssl systemd wireguard wireguard-tools"
# Read config/apt-list/LB from the env at CALL time — NOT captured into a load-time global, or a test
# (or reflex) that exports MESH_PKG_WATCH_* after this file is sourced could never rebind them
# ([[export-does-not-rebind-a-load-time-global]]).
cfg_path(){ printf '%s' "${MESH_PKG_WATCH_CONFIG:-/etc/apt/apt.conf.d/50unattended-upgrades}"; }
lb_set(){   printf '%s' "${MESH_PKG_WATCH_LB:-$DEFAULT_LB}"; }

have(){ command -v "$1" >/dev/null 2>&1; }

codename(){
  [ -n "${MESH_PKG_WATCH_CODENAME:-}" ] && { printf '%s' "$MESH_PKG_WATCH_CODENAME"; return; }
  lsb_release -cs 2>/dev/null && return
  ( . /etc/os-release 2>/dev/null; printf '%s' "${VERSION_CODENAME:-}" )
}

# covered suites = the SUITE segment (part after the last ':') of every Allowed-Origins entry, with
# ${distro_id}/${distro_codename} expanded. One per line.
covered_suites(){
  local conf; conf="$(cfg_path)"
  [ -f "$conf" ] || return 0
  local cn dist entry; cn="$(codename)"; dist="Ubuntu"
  awk '/Allowed-Origins/{f=1} f{print} /};/{if(f)exit}' "$conf" \
    | sed 's|//.*||' \
    | grep -oE '"[^"]+"' | tr -d '"' \
    | while IFS= read -r entry; do
        entry="${entry//\$\{distro_id\}/$dist}"
        entry="${entry//\$\{distro_codename\}/$cn}"
        printf '%s\n' "${entry##*:}"
      done
}

aptlist(){
  local src="${MESH_PKG_WATCH_APTLIST:-}"
  if [ -n "$src" ]; then cat "$src"
  else apt list --upgradable 2>/dev/null
  fi
}

# assess: emit one line "excluded=<0|1> total=<n> stuck=<n> stuck_lb=<csv|-> pockets=<csv|->"
assess(){
  local cov tmp; cov="$(covered_suites | sort -u | paste -sd, -)"
  tmp="$(mktemp)"; aptlist > "$tmp"
  MESH_COV="$cov" MESH_LB="$(lb_set)" python3 - "$tmp" <<'PY'
import os, sys, re
cov = set(x for x in os.environ.get('MESH_COV', '').split(',') if x)
lb  = set(os.environ.get('MESH_LB', '').split())
total = stuck = 0
stuck_lb = []
pockets = set()
for ln in open(sys.argv[1], errors='replace'):
    if '[upgradable' not in ln:      # skip the "Listing..." header and any non-upgradable line
        continue
    m = re.match(r'^(\S+?)/(\S+)\s', ln)
    if not m:
        continue
    pkg, pocket = m.group(1), m.group(2)
    psuites = set(pocket.split(','))  # apt joins multi-pocket as "noble-updates,noble-security"
    total += 1
    if psuites & cov:                 # available from a COVERED suite → will auto-apply, not stuck
        continue
    stuck += 1
    pockets |= psuites
    base = pkg.split(':')[0]          # strip :amd64 arch qualifier
    if base in lb:
        stuck_lb.append(base)
print("excluded=%d total=%d stuck=%d stuck_lb=%s pockets=%s" % (
    1 if stuck > 0 else 0, total, stuck,
    ",".join(sorted(set(stuck_lb))) or "-", ",".join(sorted(pockets)) or "-"))
PY
  rm -f "$tmp"
}

# post a single deduped [fyi] when a load-bearing package is stuck (never a raw count flood).
maybe_post(){  # $1=summary  $2=signature
  [ -n "${MESH_PKG_WATCH_NO_POST:-}" ] && return 0
  have mesh-chat || return 0
  local sf="$HOME/.mesh/pkg-watch.sig" prev=""
  [ -f "$sf" ] && prev="$(cat "$sf" 2>/dev/null)"
  [ "$prev" = "$2" ] && return 0     # already reported this exact stuck-set — stay quiet
  mkdir -p "$HOME/.mesh" 2>/dev/null
  mesh-chat "[fyi] pkg-watch: $1" >/dev/null 2>&1 && printf '%s' "$2" > "$sf"
}

do_once(){
  local conf; conf="$(cfg_path)"
  [ -n "${MESH_PKG_WATCH_APTLIST:-}" ] || have apt || { echo "mesh-pkg-watch: apt absent (n/a — not a Debian/Ubuntu node)"; exit 2; }
  [ -f "$conf" ] || { echo "mesh-pkg-watch: $conf absent (n/a — unattended-upgrades not configured)"; exit 2; }
  local cov; cov="$(covered_suites | sort -u | paste -sd, -)"
  [ -n "$cov" ] || { echo "mesh-pkg-watch: could not parse Allowed-Origins in $conf (n/a — refusing to flag everything on an empty covered-set)"; exit 2; }

  local excluded total stuck stuck_lb pockets
  eval "$(assess)"          # sets excluded/total/stuck/stuck_lb/pockets (machine-generated tokens)
  local now; now="$(date -u +%H:%MZ)"

  if [ "${stuck:-0}" -eq 0 ]; then
    echo "mesh-pkg-watch: OK — ${total:-0} upgradable, all in covered pocket(s) [$cov] (auto-apply). · $now"
    exit 0
  fi
  echo "mesh-pkg-watch: STUCK — $stuck/$total upgradable package(s) in pocket(s) [$pockets] NOT in unattended-upgrades Allowed-Origins [$cov] → will NEVER auto-apply. · $now"
  if [ "$stuck_lb" != "-" ]; then
    echo "  ⚠ load-bearing stuck: $stuck_lb — widening Allowed-Origins to a -updates pocket is an OPERATOR security-posture call (auto-applies nftables/tailscale/etc, substrate-adjacent); flag, don't apply."
    maybe_post "$stuck load-bearing package(s) STUCK in excluded pocket(s) [$pockets] (not in Allowed-Origins [$cov], never auto-applied): $stuck_lb. Operator call whether to widen unattended-upgrades scope." "lb=$stuck_lb|pk=$pockets"
  fi
  exit 1
}

do_test(){
  have python3 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  export MESH_PKG_WATCH_NO_POST=1 MESH_PKG_WATCH_CODENAME=noble
  local t; t="$(mktemp -d)"; trap 'rm -rf "$t"' RETURN

  # A synthetic upgradable list: two packages available ONLY from noble-updates (one load-bearing),
  # one from a covered pocket (noble-security), one from covered base (noble). Real `apt list` format.
  cat > "$t/aptlist" <<'EOF'
Listing...
nftables/noble-updates 1.0.9-1ubuntu0.1 amd64 [upgradable from: 1.0.9-1build1]
coreutils/noble-updates 9.4-3ubuntu6.2 amd64 [upgradable from: 9.4-3ubuntu6.1]
openssl/noble-security 3.0.13-0ubuntu3.5 amd64 [upgradable from: 3.0.13-0ubuntu3.4]
vim/noble 2:9.1.0016-1ubuntu7 amd64 [upgradable from: 2:9.1.0016-1ubuntu6]
EOF

  # config A — the BUG: Allowed-Origins WITHOUT a -updates pocket (mirrors the live mesh-home config).
  cat > "$t/confA" <<'EOF'
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}";
        "${distro_id}:${distro_codename}-security";
        "${distro_id}ESMApps:${distro_codename}-apps-security";
};
EOF
  export MESH_PKG_WATCH_APTLIST="$t/aptlist" MESH_PKG_WATCH_CONFIG="$t/confA"

  # 1) RED SEEN: the two noble-updates packages MUST be flagged STUCK; nftables (load-bearing) MUST be
  #    named; exit 1. If this does NOT fire, the detector detects nothing — a gate never seen fire.
  local rep rc; rep="$(do_once)"; rc=$?
  echo "$rep" | grep -q 'STUCK' || { echo "smoke-test: FAIL (excluded-pocket packages NOT flagged STUCK — vacuous)"; echo "$rep" | sed 's/^/    /'; exit 1; }
  echo "$rep" | grep -qE 'stuck: .*nftables' || { echo "smoke-test: FAIL (load-bearing nftables not named in the stuck set)"; echo "$rep" | sed 's/^/    /'; exit 1; }
  echo "$rep" | grep -qE 'STUCK — 2/4 ' || { echo "smoke-test: FAIL (want 2/4 stuck; a covered-pocket pkg leaked into the count or a keep missed)"; echo "$rep" | sed 's/^/    /'; exit 1; }
  [ "$rc" -eq 1 ] || { echo "smoke-test: FAIL (STUCK exit want 1, got $rc)"; exit 1; }

  # 2) covered pockets must NOT be flagged (openssl/noble-security, vim/noble are auto-applied)
  echo "$rep" | grep -qw 'openssl' && { echo "smoke-test: FAIL (a covered-pocket pkg flagged stuck — false positive)"; exit 1; }

  # 3) GREEN transition: config B ADDS the -updates pocket → the SAME list must go to 0 stuck, exit 0.
  #    Proves the gate is not a constant — it tracks the config, exactly the fix the operator would apply.
  cat > "$t/confB" <<'EOF'
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}";
        "${distro_id}:${distro_codename}-security";
        "${distro_id}:${distro_codename}-updates";
};
EOF
  ( export MESH_PKG_WATCH_CONFIG="$t/confB"; do_once ) >/dev/null 2>&1
  local rc2=$?
  [ "$rc2" -eq 0 ] || { echo "smoke-test: FAIL (adding -updates to Allowed-Origins did NOT clear the stuck set — gate is a constant, rc=$rc2)"; exit 1; }

  # 4) FAIL-CLOSED n/a: an unparseable/empty Allowed-Origins must NOT flag everything — exit 2.
  echo "// no allowed-origins block here" > "$t/confEmpty"
  ( export MESH_PKG_WATCH_CONFIG="$t/confEmpty"; do_once ) >/dev/null 2>&1
  [ $? -eq 2 ] || { echo "smoke-test: FAIL (empty covered-set did not fail-closed to n/a exit 2 — would flag all as stuck)"; exit 1; }

  # 5) honest n/a: absent config → exit 2 (not a fake all-clear)
  ( export MESH_PKG_WATCH_CONFIG="$t/nope"; do_once ) >/dev/null 2>&1
  [ $? -eq 2 ] || { echo "smoke-test: FAIL (absent config did not return n/a exit 2)"; exit 1; }

  # 6) REAL-READ gate: the live mechanism (apt-check) must return two semicolon-separated integers — the
  #    parseable substrate the whole detector rests on. Absent (non-Ubuntu / no update-notifier) is an
  #    honest skip, not a fail; PRESENT-but-unparseable is a real red (a reachable-but-hollow read).
  if [ -x /usr/lib/update-notifier/apt-check ]; then
    local ac; ac="$(/usr/lib/update-notifier/apt-check 2>&1)"
    echo "$ac" | grep -qE '^[0-9]+;[0-9]+$' || { echo "smoke-test: FAIL (live apt-check did not return N;M — hollow read: '$ac')"; exit 1; }
  else
    echo "  (note: /usr/lib/update-notifier/apt-check absent — real-read gate skipped, not a node with update-notifier)"
  fi

  echo "smoke-test: ok"; exit 0
}

case "${1:-}" in
  --once|"")   do_once;;
  --test)      do_test;;
  -h|--help)   sed -n '2,40p' "$0";;
  *) echo "usage: mesh-pkg-watch [--once|--test]" >&2; exit 2;;
esac
