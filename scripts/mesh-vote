#!/usr/bin/env bash
# mesh-vote <topic> — STUDY(byzantine-consensus, 2026-07-08): a simple probabilistic voting
# system for tmux status lines. Several workers/minds can independently report an "opinion"
# about the same question (e.g. is this node healthy, what's the presence state); a naive
# plurality count flickers the displayed status whenever one flaky/Byzantine reporter disagrees,
# and ties (2v2) resolve to nothing. This weights each worker's vote by a REPUTATION score — an
# EWMA of how often that worker's past vote matched the eventual consensus — so consistently
# agreeing workers get more say and a noisy/wrong one is gradually discounted, never permanently
# silenced (floor 0.05 — a probabilistic, recoverable penalty, not a ban).
#
# Classic BFT quorum: with weight-sum quorum > 2/3, the mesh tolerates any weighted minority
# < 1/3 lying/flaking without flipping the displayed consensus. Below quorum, the tool HOLDS the
# last confirmed consensus (marked "(held)") instead of blanking or flapping to a minority
# report — the actual noise-reduction this study set out for.
#
# STUDY(Raft / Paxos consensus, 2026-07-21) addendum: the cluster algorithm is now CONFIGURABLE.
#   --algo bft         (default) the reputation-weighted BFT plurality above (2/3 weight quorum).
#   --algo multipaxos  Multi-Paxos over the round stream: a stable LEADER (distinguished
#                      proposer) proposes its own opinion as the value for the NEXT LOG SLOT;
#                      the round's workers are the acceptors — an agreeing opinion is an accept,
#                      a dissent is a nack. Majority (> n/2 of the round's acceptors) accepts ->
#                      the value is CHOSEN for that slot and appended to a per-topic append-only
#                      log. Phase 1 (prepare: ballot+1 + leader election from the plurality
#                      partition) runs ONLY on leader change — steady-state slots are
#                      accept-only, which is the Multi-Paxos optimization over vanilla Paxos.
#                      A leader that loses its majority is DEPOSED: nothing is chosen (safety
#                      holds — held output, log untouched), and the next round runs phase 1 at
#                      a strictly higher ballot. Crash-fault model (simple majority) vs bft's
#                      2/3 Byzantine quorum — that tradeoff is why the algorithm is selectable.
#
# THE QUORUM DENOMINATOR IS THE ACCEPTOR SET, NEVER THE ROUND'S TURNOUT (fixed 2026-08-24).
# The first cut computed `majority = len(votes)//2 + 1` — a majority of whoever answered THIS
# round. Every turnout is a majority of itself, so a partition chose values on its own: measured
# on a 5-worker topic, a 2-of-5 round printed `chosen accepts=2/2` and a SINGLE voter printed
# `chosen accepts=1/1`, both appending to the log the other three knew nothing about. That is
# split-brain — precisely what a majority quorum exists to forbid — and it wore the word
# "chosen", which in Paxos means decided forever. The bar must be a majority of the ACCEPTORS,
# so a round is now measured against the set:
#   --acceptors <n> / MESH_VOTE_ACCEPTORS   the configured cluster size, authoritative.
#   otherwise                                the LEARNED set: every worker ever seen on this
#                                            topic, persisted in state and monotone — it only
#                                            grows, so a shrinking partition can never lower its
#                                            own bar. (Learning cannot help the FIRST round: a
#                                            cluster that is born partitioned learns the
#                                            partition as its membership. Configure --acceptors
#                                            when the size is known; that is the safe form.)
# A round whose turnout is below that majority HOLDS: no value chosen, log untouched, no leader
# elected — and NO BALLOT BUMP. A partitioned proposer that raised its ballot every attempt would
# come back holding the highest ballot and depose the live majority's leader (Paxos's disruptive
# proposer); it stays quiet instead. Monotone membership costs liveness when a node leaves for
# good — the bar never falls — so --reconfigure is the escape hatch: it sets the set to THIS
# round's voters. Membership change is an operator decision taken outside the protocol, which is
# why it is an explicit flag and never something a partition can do to itself.
#
# Usage:
#   printf 'worker|opinion\n...' | mesh-vote <topic> [--json] [--algo bft|multipaxos]
#                                   [--acceptors <n>] [--reconfigure]
#   mesh-vote --test
# Env: MESH_VOTE_ALGO=bft|multipaxos (default bft; the --algo flag wins).
#      MESH_VOTE_ACCEPTORS=<n>       (multipaxos; the --acceptors flag wins).
#
# State: ~/.mesh/vote-state/<topic>.json —
#   bft:        {reputation: {worker: 0..1}, last_consensus, last_confidence}
#   multipaxos: {paxos: {ballot, leader, slot, log: [{slot,ballot,value}...], last_chosen,
#                        acceptors: [worker...]}}
# Small in-tree STUDY prototype (idea-queue byzantine-consensus 2026-07-08 + raft-paxos
# 2026-07-18) — not wired into any dash/cron; a real integration is a separate step.
# orphan-ok: STUDY prototype, on-demand by design — consensus harness for future status-line
# integration; wiring it into a dash/cron is a deliberate separate step, not a missed one.
set -uo pipefail
QUORUM=0.66

_run() {
  local topic="$1" state_dir="$HOME/.mesh/vote-state" state_file json_mode="${2:-0}" algo="${3:-bft}" votes_file
  local acceptors="${4:-}" reconfigure="${5:-0}"
  mkdir -p "$state_dir" 2>/dev/null
  state_file="$state_dir/$topic.json"
  # heredoc (below) occupies python's stdin, so the caller's piped votes must be captured to a
  # file FIRST — otherwise the vote data is silently lost under the heredoc redirect.
  votes_file="$(mktemp)" || { echo "mesh-vote: FAIL (mktemp)" >&2; return 1; }
  # the python below unlinks it on its happy path; this makes the cleanup unconditional, so a
  # python that never starts (no interpreter) or dies mid-parse does not strand a file per call
  # (task:doctor-test-tmpdir-cleanup-traps).
  trap 'rm -f "$votes_file"' RETURN
  cat > "$votes_file"
  python3 - "$state_file" "$json_mode" "$QUORUM" "$votes_file" "$algo" "$acceptors" "$reconfigure" << 'PYEOF'
import sys, json, os

state_file, json_mode, quorum, votes_file, algo = \
    sys.argv[1], sys.argv[2] == "1", float(sys.argv[3]), sys.argv[4], sys.argv[5]
cfg_acceptors, reconfigure = sys.argv[6], sys.argv[7] == "1"

try:
    with open(state_file) as f:
        state = json.load(f)
except (FileNotFoundError, ValueError):
    state = {}

votes = {}  # worker -> opinion
with open(votes_file) as vf:
    vote_lines = vf.readlines()
os.unlink(votes_file)
for line in vote_lines:
    line = line.strip()
    if not line or "|" not in line:
        continue
    worker, opinion = line.split("|", 1)
    worker, opinion = worker.strip(), opinion.strip()
    if worker and opinion:
        votes[worker] = opinion

def save():
    with open(state_file, "w") as f:
        json.dump(state, f)

if algo == "multipaxos":
    px = state.get("paxos", {"ballot": 0, "leader": None, "slot": 0, "log": [], "last_chosen": None})
    if not votes:
        out = {"algo": "multipaxos", "consensus": px.get("last_chosen"), "chosen": False,
               "held": True, "n": 0, "error": "no votes"}
        text = f"NO VOTES (0) — holding: {px.get('last_chosen') or 'UNKNOWN'}"
    else:
        n = len(votes)
        # THE ACCEPTOR SET — the denominator. Learned membership is monotone (union with this
        # round's voters, including a below-quorum round's: raising the bar is always the safe
        # direction), unless --reconfigure explicitly redefines it or --acceptors configures it.
        learned = set(px.get("acceptors") or [])
        learned = set(votes) if reconfigure else (learned | set(votes))
        px["acceptors"] = sorted(learned)
        if cfg_acceptors:
            members, src = int(cfg_acceptors), "configured"
            if n > members:
                # Louder than a silent widen: more acceptors answered than the cluster is
                # declared to have, so the declaration is wrong and every quorum computed from
                # it would be too. [[a-silent-fallback-turns-a-failure-into-a-plausible-constant]]
                sys.stderr.write(
                    "mesh-vote: %d workers voted but the acceptor set is configured at %d — "
                    "refusing to compute a quorum against a set smaller than its own turnout\n"
                    % (n, members))
                sys.exit(1)
        else:
            members, src = len(learned), "learned"
        majority = members // 2 + 1
        if n < majority:
            # BELOW QUORUM: hold. No value chosen, log untouched, no leader elected — and the
            # ballot is NOT raised, so a partitioned proposer cannot return holding the highest
            # ballot and depose the leader the live majority is using.
            state["paxos"] = px
            save()
            out = {"algo": "multipaxos", "consensus": px.get("last_chosen"), "chosen": False,
                   "held": True, "reason": "below-quorum", "ballot": px["ballot"],
                   "leader": px["leader"], "turnout": n, "members": members,
                   "majority": majority, "acceptors_src": src, "n": n, "slot": px["slot"]}
            text = (f"{px['last_chosen'] or 'UNKNOWN'} — held (turnout {n}/{members} below "
                    f"majority {majority}, no leader elected) ballot={px['ballot']}")
            print(json.dumps(out) if json_mode else text)
            sys.exit(0)
        phase1 = False
        if not px["leader"] or px["leader"] not in votes:
            # PHASE 1 (prepare): new ballot; elect the proposer from the plurality partition
            # (deterministic: biggest partition, ties by opinion then worker name) so a lone
            # permanent dissenter can never re-elect itself into a livelock.
            tally = {}
            for o in votes.values():
                tally[o] = tally.get(o, 0) + 1
            best = sorted(tally.items(), key=lambda kv: (-kv[1], kv[0]))[0][0]
            px["leader"] = sorted(w for w, o in votes.items() if o == best)[0]
            px["ballot"] += 1
            phase1 = True
        leader = px["leader"]
        proposed = votes[leader]
        accepts = sum(1 for o in votes.values() if o == proposed)
        if accepts >= majority:
            # CHOSEN: append-only — a decided slot is never rewritten (Paxos safety)
            px["log"].append({"slot": px["slot"], "ballot": px["ballot"], "value": proposed})
            slot_decided = px["slot"]
            px["slot"] += 1
            px["last_chosen"] = proposed
            chosen = True
        else:
            # liveness lost under this leader — depose; next round runs phase 1 at ballot+1.
            # Nothing is chosen and the log is untouched: safety over availability.
            px["leader"] = None
            chosen = False
        state["paxos"] = px
        save()
        out = {"algo": "multipaxos", "consensus": proposed if chosen else px["last_chosen"],
               "chosen": chosen, "held": not chosen, "ballot": px["ballot"], "leader": leader,
               "phase1": phase1, "accepts": accepts, "n": n, "turnout": n, "members": members,
               "majority": majority, "acceptors_src": src,
               "slot": slot_decided if chosen else px["slot"]}
        if not chosen:
            out["reason"] = "deposed"
        if chosen:
            p1 = " (phase1)" if phase1 else ""
            text = f"{proposed} — chosen slot={slot_decided} ballot={px['ballot']} leader={leader} accepts={accepts}/{members}{p1}"
        else:
            text = (f"{px['last_chosen'] or 'UNKNOWN'} — held (no majority: accepts {accepts}/{members} "
                    f"acceptors, leader {leader} deposed) ballot={px['ballot']}")
else:
    reputation = state.get("reputation", {})
    last_consensus = state.get("last_consensus")
    last_confidence = state.get("last_confidence", 0.0)

    if not votes:
        out = {"topic": None, "consensus": last_consensus, "confidence": last_confidence,
               "quorum_reached": False, "held": True, "n": 0, "error": "no votes"}
        text = f"NO VOTES (0) — holding: {last_consensus or 'UNKNOWN'}"
    else:
        tally = {}
        for worker, opinion in votes.items():
            w = reputation.get(worker, 0.5)
            tally[opinion] = tally.get(opinion, 0.0) + w
        total_weight = sum(reputation.get(w, 0.5) for w in votes)
        winner, winner_weight = max(tally.items(), key=lambda kv: kv[1])
        confidence = (winner_weight / total_weight) if total_weight > 0 else 0.0
        quorum_reached = confidence >= quorum

        if quorum_reached:
            for worker in votes:
                agreed = 1.0 if votes[worker] == winner else 0.0
                prev = reputation.get(worker, 0.5)
                reputation[worker] = max(0.05, min(1.0, prev * 0.9 + agreed * 0.1))
            consensus, out_confidence, held = winner, confidence, False
        else:
            # split round: no clear truth signal, don't reward/penalize reputations —
            # hold the last confirmed consensus instead of flapping to a minority report
            consensus, out_confidence, held = last_consensus, last_confidence, True

        state["reputation"] = reputation
        state["last_consensus"] = consensus
        state["last_confidence"] = out_confidence
        save()

        out = {"consensus": consensus, "confidence": round(out_confidence, 3),
               "quorum_reached": quorum_reached, "held": held, "n": len(votes),
               "reputation": {k: round(v, 3) for k, v in reputation.items()}}
        tag = "(held, no quorum)" if held else "(quorum)"
        text = f"{consensus} — confidence {out['confidence']*100:.0f}% {tag} n={len(votes)}"

if json_mode:
    print(json.dumps(out))
else:
    print(text)
PYEOF
}

case "${1:-}" in
  --test)
    command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
    tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
    trap 'rm -rf "$tmp"' EXIT

    # Round 1: unanimous 3/3 "healthy" -> quorum, all reputations start equal at 0.5
    out1="$(printf 'a|healthy\nb|healthy\nc|healthy\n' | HOME="$tmp" "$0" topic1 2>&1)" || {
      echo "smoke-test: FAIL (round1 failed: $out1)"; exit 1; }
    printf '%s' "$out1" | grep -q '^healthy — confidence 100% (quorum)' || {
      echo "smoke-test: FAIL (round1 expected unanimous quorum: $out1)"; exit 1; }

    # Build up a & b's reputation via several rounds where they agree and c is the lone
    # dissenter (raw count 2v1 = 0.667 >= default quorum, so this establishes a & b as trusted)
    for i in $(seq 1 10); do
      HOME="$tmp" bash -c "printf 'a|ok\nb|ok\nc|bad\n' | \"$0\" reptopic >/dev/null"
    done
    # Now a genuine 2v2 TIE: a,b (built-up reputation) vs c,d (c never built rep, d is new ->
    # default 0.5). Raw plurality count is a TIE (no naive majority) but weighted vote should
    # resolve it because a&b's reputation now exceeds 0.5.
    out2="$(printf 'a|ok\nb|ok\nc|bad\nd|bad\n' | HOME="$tmp" "$0" reptopic 2>&1)" || {
      echo "smoke-test: FAIL (tie-break round failed: $out2)"; exit 1; }
    printf '%s' "$out2" | grep -q '^ok — confidence' || {
      echo "smoke-test: FAIL (reputation-weighted vote should break the 2v2 tie toward the consistent workers 'ok': $out2)"; exit 1; }
    printf '%s' "$out2" | grep -q '(quorum)' || {
      echo "smoke-test: FAIL (weighted tie-break should reach quorum, naive count could not: $out2)"; exit 1; }

    # Split round with NO prior history -> below quorum -> must HOLD the prior consensus
    # (topic1 was unanimous 'healthy'), never flip to a minority report or go blank
    out3="$(printf 'x|healthy\ny|degraded\n' | HOME="$tmp" "$0" topic1 2>&1)" || {
      echo "smoke-test: FAIL (split round failed: $out3)"; exit 1; }
    printf '%s' "$out3" | grep -q '^healthy — confidence.*held, no quorum' || {
      echo "smoke-test: FAIL (split vote must HOLD prior consensus 'healthy', not flip/blank: $out3)"; exit 1; }

    # --json mode sanity
    outj="$(printf 'a|up\nb|up\n' | HOME="$tmp" "$0" jsontopic --json 2>&1)" || {
      echo "smoke-test: FAIL (json mode failed: $outj)"; exit 1; }
    printf '%s' "$outj" | grep -q '"consensus": "up"' || {
      echo "smoke-test: FAIL (json mode missing consensus field: $outj)"; exit 1; }

    # ---- multipaxos algorithm option ----
    # Slot 0: fresh topic -> phase 1 (ballot 1) + leader elected from the plurality partition
    # (all agree -> lexicographically-first worker a), value chosen by 3/3 majority.
    mp1="$(printf 'a|blue\nb|blue\nc|blue\n' | HOME="$tmp" "$0" ptopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (paxos slot0 failed: $mp1)"; exit 1; }
    printf '%s' "$mp1" | grep -q '^blue — chosen slot=0 ballot=1 leader=a accepts=3/3 (phase1)' || {
      echo "smoke-test: FAIL (paxos slot0 expected phase1 + chosen at ballot 1: $mp1)"; exit 1; }

    # Slot 1, same leader alive: the Multi-Paxos optimization — NO phase 1, ballot UNCHANGED,
    # slot advances. (MESH_VOTE_ALGO env must route the algorithm too, so use it here.)
    mp2="$(printf 'a|green\nb|green\nc|green\n' | HOME="$tmp" MESH_VOTE_ALGO=multipaxos "$0" ptopic 2>&1)" || {
      echo "smoke-test: FAIL (paxos slot1 failed: $mp2)"; exit 1; }
    printf '%s' "$mp2" | grep -q '^green — chosen slot=1 ballot=1 leader=a accepts=3/3$' || {
      echo "smoke-test: FAIL (paxos steady-state slot must skip phase1 and keep ballot=1: $mp2)"; exit 1; }

    # Leader a crashes (absent from the round) -> phase 1 re-runs: ballot strictly higher,
    # new leader from the live plurality (b), slot 2 chosen.
    mp3="$(printf 'b|red\nc|red\n' | HOME="$tmp" "$0" ptopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (paxos failover failed: $mp3)"; exit 1; }
    # accepts=2/3, not 2/2: b and c are a majority OF THE THREE ACCEPTORS learned so far, which is
    # the quantity that decides. The old line printed the turnout as its own denominator.
    printf '%s' "$mp3" | grep -q '^red — chosen slot=2 ballot=2 leader=b accepts=2/3 (phase1)' || {
      echo "smoke-test: FAIL (leader crash must raise the ballot and elect a new leader: $mp3)"; exit 1; }

    # Leader b loses its majority (proposes red, 1/3 accepts) -> NOTHING chosen (safety: held
    # output, log untouched), leader deposed.
    mp4="$(printf 'b|red\nc|blue\nd|blue\n' | HOME="$tmp" "$0" ptopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (paxos minority round failed: $mp4)"; exit 1; }
    printf '%s' "$mp4" | grep -q '^red — held (no majority: accepts 1/4 acceptors, leader b deposed) ballot=2' || {
      echo "smoke-test: FAIL (minority proposal must hold + depose, never choose: $mp4)"; exit 1; }

    # Next round after depose: phase 1 at ballot 3, leader from the blue plurality — b, the
    # lexicographically first of the three blue voters, NOT c.
    mp5="$(printf 'b|blue\nc|blue\nd|blue\n' | HOME="$tmp" "$0" ptopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (paxos re-election failed: $mp5)"; exit 1; }
    printf '%s' "$mp5" | grep -q '^blue — chosen slot=3 ballot=3 leader=b accepts=3/4 (phase1)' || {
      echo "smoke-test: FAIL (post-depose round must re-elect at a higher ballot: $mp5)"; exit 1; }

    # Log invariants from the REAL state artifact (not the printed lines): append-only,
    # contiguous slots 0..3, non-decreasing ballots, and the held round wrote no entry.
    HOME="$tmp" python3 - << 'PYCHK' || { echo "smoke-test: FAIL (paxos log invariants violated)"; exit 1; }
import json, os, sys
with open(os.path.expanduser("~/.mesh/vote-state/ptopic.json")) as f:
    log = json.load(f)["paxos"]["log"]
assert [e["slot"] for e in log] == [0, 1, 2, 3], f"slots not contiguous: {log}"
ballots = [e["ballot"] for e in log]
assert ballots == sorted(ballots), f"ballot regressed: {ballots}"
assert [e["value"] for e in log] == ["blue", "green", "red", "blue"], f"log rewritten: {log}"
PYCHK

    # --json carries the algo + chosen fields
    mpj="$(printf 'a|up\nb|up\n' | HOME="$tmp" "$0" pjson --json --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (paxos json failed: $mpj)"; exit 1; }
    printf '%s' "$mpj" | grep -q '"algo": "multipaxos"' && printf '%s' "$mpj" | grep -q '"chosen": true' || {
      echo "smoke-test: FAIL (paxos json missing algo/chosen: $mpj)"; exit 1; }

    # ---- the quorum denominator is the ACCEPTOR SET, not the round's turnout ----
    # Driven against the measured split-brain: on a 5-worker topic the first cut printed
    # `chosen accepts=2/2` for a 2-of-5 partition and `chosen accepts=1/1` for a single voter,
    # because every turnout is a majority of itself.
    printf 'a|blue\nb|blue\nc|blue\nd|blue\ne|blue\n' | HOME="$tmp" "$0" qtopic --algo multipaxos >/dev/null 2>&1 || {
      echo "smoke-test: FAIL (quorum topic setup)"; exit 1; }
    q1="$(printf 'd|red\ne|red\n' | HOME="$tmp" "$0" qtopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (minority partition round failed: $q1)"; exit 1; }
    printf '%s' "$q1" | grep -q '^blue — held (turnout 2/5 below majority 3, no leader elected) ballot=1$' || {
      echo "smoke-test: FAIL (a 2-of-5 partition must HOLD against the acceptor set, never choose on its own: $q1)"; exit 1; }
    # …and the floor of that defect: one worker is a majority of one.
    q2="$(printf 'e|yellow\n' | HOME="$tmp" "$0" qtopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (lone-voter round failed: $q2)"; exit 1; }
    printf '%s' "$q2" | grep -q '^blue — held (turnout 1/5 below majority 3' || {
      echo "smoke-test: FAIL (a single voter must not constitute a majority: $q2)"; exit 1; }
    # NEGATIVE ARM — without it "held" is satisfied by a gate that holds unconditionally. A REAL
    # majority of the same acceptor set still chooses, and still skips phase 1 (leader a survived
    # the partition), so the Multi-Paxos steady-state optimization is not collateral damage.
    q3="$(printf 'a|blue\nb|blue\nc|blue\n' | HOME="$tmp" "$0" qtopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (majority round failed: $q3)"; exit 1; }
    printf '%s' "$q3" | grep -q '^blue — chosen slot=1 ballot=1 leader=a accepts=3/5$' || {
      echo "smoke-test: FAIL (3-of-5 IS a majority and must choose without a new phase 1: $q3)"; exit 1; }
    # The state artifact, not the printed lines: the two below-quorum rounds appended NOTHING and
    # left the ballot alone. A partitioned proposer that bumped its ballot each attempt would
    # return holding the highest one and depose the live majority's leader.
    HOME="$tmp" python3 - << 'PYQ' || { echo "smoke-test: FAIL (below-quorum rounds touched the log or the ballot)"; exit 1; }
import json, os
px = json.load(open(os.path.expanduser("~/.mesh/vote-state/qtopic.json")))["paxos"]
assert [e["value"] for e in px["log"]] == ["blue", "blue"], f"minority round reached the log: {px['log']}"
assert px["ballot"] == 1, f"a below-quorum round raised the ballot to {px['ballot']}"
assert px["acceptors"] == ["a", "b", "c", "d", "e"], f"acceptor set not learned: {px}"
PYQ
    # A cluster BORN partitioned cannot be saved by learning — it learns the partition as its
    # membership. The configured size is the only thing that covers a fresh topic, so it must be
    # authoritative with no history at all: 3 of a declared 5 chooses, 2 of 5 holds.
    c1="$(printf 'a|on\nb|on\nc|on\n' | HOME="$tmp" "$0" ctopic --algo multipaxos --acceptors 5 2>&1)" || {
      echo "smoke-test: FAIL (configured-set round failed: $c1)"; exit 1; }
    printf '%s' "$c1" | grep -q '^on — chosen slot=0 ballot=1 leader=a accepts=3/5 (phase1)' || {
      echo "smoke-test: FAIL (3 of a configured 5 is a majority and must choose: $c1)"; exit 1; }
    c2="$(printf 'a|off\nb|off\n' | HOME="$tmp" MESH_VOTE_ACCEPTORS=5 "$0" ctopic --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (configured-set minority round failed: $c2)"; exit 1; }
    printf '%s' "$c2" | grep -q '^on — held (turnout 2/5 below majority 3' || {
      echo "smoke-test: FAIL (the env form of the configured set must gate too: $c2)"; exit 1; }
    # More acceptors answered than the cluster is declared to have: the declaration is wrong, and
    # every quorum computed from it would be too. Refuse loudly rather than widen in silence.
    if printf 'a|x\nb|x\nc|x\n' | HOME="$tmp" "$0" ctopic --algo multipaxos --acceptors 2 >/dev/null 2>&1; then
      echo "smoke-test: FAIL (turnout above the configured acceptor set must be refused)"; exit 1
    fi
    # A size that is not a positive integer must die at the flag, never inside the quorum
    # arithmetic — and 0 must not slip through, since majority 0//2+1 = 1 restores the floor.
    for bad in 0 -1 abc 2x ''; do
      if printf 'a|x\n' | HOME="$tmp" "$0" ctopic --algo multipaxos --acceptors "$bad" >/dev/null 2>&1; then
        echo "smoke-test: FAIL (--acceptors '$bad' must be rejected)"; exit 1
      fi
    done
    # Monotone membership costs liveness when a node leaves for good, so --reconfigure is the
    # escape hatch — and the round it enables is a genuine majority of the NEW set.
    r1="$(printf 'a|blue\nb|blue\n' | HOME="$tmp" "$0" qtopic --algo multipaxos --reconfigure 2>&1)" || {
      echo "smoke-test: FAIL (reconfigure round failed: $r1)"; exit 1; }
    printf '%s' "$r1" | grep -q '^blue — chosen slot=2 ballot=1 leader=a accepts=2/2' || {
      echo "smoke-test: FAIL (--reconfigure must reset the acceptor set to this round's voters: $r1)"; exit 1; }
    # …and it must be the ONLY way the set shrinks: the very same round without the flag holds.
    HOME="$tmp" python3 -c "
import json, os
px = json.load(open(os.path.expanduser('~/.mesh/vote-state/qtopic.json')))['paxos']
assert px['acceptors'] == ['a', 'b'], px['acceptors']
" || { echo "smoke-test: FAIL (reconfigure did not narrow the persisted acceptor set)"; exit 1; }
    # --json must carry the denominator, or a machine reader cannot tell a real majority from a
    # partition's majority-of-itself — the whole defect, invisible again.
    qj="$(printf 'a|blue\n' | HOME="$tmp" "$0" qtopic --json --algo multipaxos 2>&1)" || {
      echo "smoke-test: FAIL (quorum json failed: $qj)"; exit 1; }
    for f in '"held": true' '"reason": "below-quorum"' '"turnout": 1' '"members": 2' '"majority": 2' '"acceptors_src": "learned"'; do
      printf '%s' "$qj" | grep -q "$f" || {
        echo "smoke-test: FAIL (below-quorum json missing $f: $qj)"; exit 1; }
    done

    # Unknown algo must refuse loudly, not silently fall back to bft
    if printf 'a|x\n' | HOME="$tmp" "$0" badalgo --algo raft >/dev/null 2>&1; then
      echo "smoke-test: FAIL (unknown --algo must be rejected)"; exit 1
    fi
    # The two new flags belong to multipaxos; against bft they must refuse, never be ignored.
    if printf 'a|x\n' | HOME="$tmp" "$0" badalgo --acceptors 3 >/dev/null 2>&1; then
      echo "smoke-test: FAIL (--acceptors under bft must be rejected, not silently ignored)"; exit 1
    fi
    if printf 'a|x\n' | HOME="$tmp" "$0" badalgo --reconfigure >/dev/null 2>&1; then
      echo "smoke-test: FAIL (--reconfigure under bft must be rejected, not silently ignored)"; exit 1
    fi

    echo "smoke-test: ok"
    exit 0
    ;;
  ""|--json|--algo|--acceptors|--reconfigure)
    echo "usage: mesh-vote <topic> [--json] [--algo bft|multipaxos] [--acceptors <n>] [--reconfigure]  (opinions on stdin as worker|opinion)" >&2
    exit 1
    ;;
  *)
    topic="$1"; shift
    json_mode=0
    reconfigure=0
    algo="${MESH_VOTE_ALGO:-bft}"
    acceptors="${MESH_VOTE_ACCEPTORS:-}"
    # "given" is tracked apart from the VALUE: `--acceptors ""` (or a trailing --acceptors with
    # nothing after it) must die at the flag, not silently mean "unset" and fall through to the
    # learned set — a flag that is accepted and then ignored is the quietest way to lose a quorum.
    acceptors_given=0
    [ -n "$acceptors" ] && acceptors_given=1
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) json_mode=1 ;;
        --algo) shift; algo="${1:-}" ;;
        --acceptors) shift; acceptors="${1:-}"; acceptors_given=1 ;;
        --reconfigure) reconfigure=1 ;;
        *) echo "mesh-vote: unknown arg '$1'" >&2; exit 1 ;;
      esac
      shift
    done
    case "$algo" in
      bft|multipaxos) ;;
      *) echo "mesh-vote: unknown algo '$algo' (bft|multipaxos)" >&2; exit 1 ;;
    esac
    if [ "$acceptors_given" = 1 ]; then
      # A malformed size must never reach the quorum arithmetic — an unparsable value would
      # otherwise become an exception under the heredoc and read as a broken tool, and a 0 would
      # make majority 1, restoring the very floor this fix removed.
      case "$acceptors" in
        ''|*[!0-9]*) echo "mesh-vote: --acceptors must be a positive integer, got '$acceptors'" >&2; exit 1 ;;
      esac
      [ "$acceptors" -ge 1 ] || { echo "mesh-vote: --acceptors must be >= 1" >&2; exit 1; }
      [ "$algo" = multipaxos ] || { echo "mesh-vote: --acceptors applies to --algo multipaxos only" >&2; exit 1; }
    fi
    [ "$reconfigure" = 0 ] || [ "$algo" = multipaxos ] || {
      echo "mesh-vote: --reconfigure applies to --algo multipaxos only" >&2; exit 1; }
    _run "$topic" "$json_mode" "$algo" "$acceptors" "$reconfigure"
    ;;
esac
