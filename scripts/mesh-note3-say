#!/usr/bin/env bash
# orphan-ok: on-demand VOICE ACTUATOR (mind/operator-invoked spoken line out the Note3 speaker).
#   Playback wakes the screen + emits sound into the room, so it is intentional-only — never cron-wire.
# mesh-note3-say — speak a line through the Note 3 (SM-N900, Android 5.0, ADB-only body attached to
#   mesh-home over USB). The Note3 has no termux, so `mesh-say --phone` (termux-tts) does NOT work;
#   the voice path is: local piper TTS (GPU) → wav → adb push → play via a media VIEW intent.
#
# HOW:
#   text → piper (~/.venv-ai) → 22.05k mono wav → adb push /sdcard/<name>.wav → media-scan →
#   `am start VIEW audio/*` (Samsung Music autoplays a single-file intent) → verify it launched.
#   The wav lands under /sdcard/ so the stock player can read it; we leave it (small) for replay.
#
# Read/relay path (same convention as mesh-note3-cam): the phone hangs off a node over USB adb;
# node-local config in ~/.mesh/nodes (never hardcode topology in genome):
#   MESH_NOTE3_ADB_NODE    local | user@ip of the adb-hosting node   (default: local)
#   MESH_NOTE3_ADB_SERIAL  adb serial                                (default: 4d00553d61ab90b7)
#   MESH_PIPER_BIN         piper binary                              (default: ~/.venv-ai/bin/piper)
#   MESH_PIPER_VOICE       piper .onnx voice model                   (default: ru ruslan/dmitri if present)
#
# Honest contract: adb node/phone unreachable → exit 2 (honest n/a, mesh-land passes it);
# phone reachable but TTS/push/play fails → exit 1 (a real defect).
#
#   mesh-note3-say "текст"        speak the line
#   mesh-note3-say --test         read-only asserts (piper bin + voice + adb device reachable);
#                                 MESH_NOTE3_SAY_TEST_PLAY=1 adds a real short spoken line
set -uo pipefail
# ── --help guard (pub/argv-is-payload-tools-fire-on-help, 2026-07-15) ──────────────────────────────
# argv IS this tool's payload, so the universal discovery gesture WAS the action: `--help` sent the
# literal string '--help' down the send path. Proven live on the operator at 03:18Z (mesh-tg-update
# --help mailed him a commit digest; mesh-tg --help texted him '--help'). The safe way to ask what a
# thing does must not BE the thing — so this comes FIRST, before any dispatch, sandbox gate or config
# read. usage() renders this file's own header block, so it can never drift from the docs above.
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

NODE="${MESH_NOTE3_ADB_NODE:-local}"
SER="${MESH_NOTE3_ADB_SERIAL:-4d00553d61ab90b7}"
PIPER="${MESH_PIPER_BIN:-$HOME/.venv-ai/bin/piper}"

# pick a voice: explicit env wins, else first ru voice under the piper-voices dir
pick_voice() {
  [ -n "${MESH_PIPER_VOICE:-}" ] && { echo "$MESH_PIPER_VOICE"; return; }
  local d="$HOME/.local/share/piper-voices"
  for v in "$d"/ru_RU-ruslan-*.onnx "$d"/ru_RU-dmitri-*.onnx "$d"/*.onnx; do
    [ -f "$v" ] && { echo "$v"; return; }
  done
}
VOICE="$(pick_voice)"

node_sh() {
  if [ "$NODE" = local ]; then bash -c "$1"
  else ssh -o BatchMode=yes -o ConnectTimeout=6 "$NODE" "$1"; fi
}
adb_sh() { node_sh "adb -s $SER shell \"$1\""; }
adb_push() { node_sh "adb -s $SER push '$1' '$2'"; }
phone_up() { node_sh "adb devices 2>/dev/null" | grep -q "^$SER[[:space:]]*device"; }

say() {
  local text="$1"
  [ -n "$text" ] || { echo "mesh-note3-say: empty text" >&2; return 1; }
  command -v ffmpeg >/dev/null || { echo "mesh-note3-say: ffmpeg required (synth wav → mp3)" >&2; return 1; }
  phone_up || { echo "mesh-note3-say: Note3 adb not 'device' (n/a)" >&2; return 2; }

  local wav mp3 voice=clone; wav="$(mktemp --suffix=.wav)"; mp3="$(mktemp --suffix=.mp3)"
  # THE MESH SPEAKS IN THE OPERATOR'S OWN VOICE. Synthesize via the warm clone daemon
  # (mesh-voice-say → xtts_v2 conditioned on the operator's reference wavs). Fall back to piper
  # (ruslan) ONLY when the clone is unavailable — and say so LOUDLY: a silent slide back to a
  # generic voice is exactly the silent-fallback trap (the mesh's voice must BE the operator's).
  if mesh-voice-say "$text" "$wav" 2>/dev/null; then :; else
    # branch on the daemon's ACTUAL rc (mesh-voice-say contract, gated in its --test): only rc=5
    # (unreachable) means the SERVICE needs fixing; rc=7 is a healthy daemon a long text outran —
    # the canned service hint here misdiagnosed that twice via voice-tx (chat-review 07-18/07-21).
    local vs_rc=$?
    voice=piper
    case "$vs_rc" in
      5) echo "mesh-note3-say: CLONE DAEMON UNREACHABLE → falling back to piper/ruslan (fix mesh-voice-clone.service)" >&2;;
      7) echo "mesh-note3-say: clone synth TIMEOUT on ${#text}-char text — daemon busy/slow, NOT down; chunk the text or raise MESH_CLONE_TIMEOUT → piper/ruslan fallback" >&2;;
      *) echo "mesh-note3-say: clone synth failed (rc=$vs_rc, not a daemon-down signal) → piper/ruslan fallback" >&2;;
    esac
    { [ -x "$PIPER" ] && [ -n "$VOICE" ] && [ -f "$VOICE" ]; } \
      || { echo "mesh-note3-say: no clone AND no piper voice model — cannot speak" >&2; rm -f "$wav" "$mp3"; return 1; }
    printf '%s\n' "$text" | "$PIPER" -m "$VOICE" -f "$wav" 2>/dev/null
  fi
  [ -s "$wav" ] || { echo "mesh-note3-say: synth produced no wav ($voice)" >&2; rm -f "$wav" "$mp3"; return 1; }
  # RE-ENCODE to mp3 44.1k stereo: Samsung's AudioPreview reads a raw piper wav as duration-0
  # (won't play); a normalized mp3 loads with correct duration and plays. (learned 2026-07-14)
  ffmpeg -y -i "$wav" -ar 44100 -ac 2 -b:a 128k "$mp3" >/dev/null 2>&1
  [ -s "$mp3" ] || { echo "mesh-note3-say: ffmpeg mp3 encode failed" >&2; rm -f "$wav" "$mp3"; return 1; }
  rm -f "$wav"

  # self-mute: mesh-overhear skips buffering while ~/.mesh/mesh-speaking exists, so the room mic
  # doesn't transcribe our OWN voice (which would loop the reflex). Hold it for the clip + tail.
  #
  # DEADLINE, not last-rm-wins (fixed 2026-07-14). This used to be `touch` + a per-call
  # `( sleep dur+4; rm -f flag ) &`. With ONE shared flag and no refcount, two overlapping speaks
  # race: the SHORTER clip's timer fires first and unmutes the mic while the LONGER one is still
  # playing. Measured: a 15s clip + a 1s clip 3s later → mic went live at t+7 and stayed live for
  # ~10s of our own voice, which the room then transcribed as if the operator had said it (observed
  # in room-transcript.txt at 23:41:22 and 23:41:40 — two of "his" lines were verbatim MY speech).
  # Now the flag CONTAINS the release epoch; concurrent speaks only ever EXTEND it, and the reaper
  # removes it solely once the latest deadline has passed. Consumers test existence only
  # (mesh-overhear os.path.exists, `[ -f ]`), so the added content is backward-compatible.
  local dur speakflag="$HOME/.mesh/mesh-speaking" until cur
  dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$mp3" 2>/dev/null | cut -d. -f1)
  [ -n "$dur" ] || dur=6
  # +4 tail, +4 for the adb chain (push + VIEW/126 ≈1s now) before audio actually starts. Over-holds
  # deliberately: extending the mute is harmless, shortening it lets the mic transcribe our own voice.
  until=$(( $(date +%s) + dur + 8 ))
  cur="$(cat "$speakflag" 2>/dev/null)"; case "$cur" in (''|*[!0-9]*) cur=0 ;; esac
  [ "$until" -gt "$cur" ] && echo "$until" > "$speakflag"
  ( while :; do
      d="$(cat "$speakflag" 2>/dev/null)"; case "$d" in (''|*[!0-9]*) break ;; esac
      [ "$(date +%s)" -ge "$d" ] && { rm -f "$speakflag"; break; }
      sleep 1
    done ) >/dev/null 2>&1 &

  local rname="mesh-voice-$$.mp3" rpath="/sdcard/mesh-voice-$$.mp3"
  adb_push "$mp3" "$rpath" >/dev/null 2>&1 || { echo "mesh-note3-say: adb push failed" >&2; rm -f "$mp3"; return 1; }
  rm -f "$mp3"
  # DELIVERY = the COUNT of am/input spawns, not adb transport. Each am/input on this Android-5 body
  # spins up a Dalvik VM ≈0.5-0.6s; the adb round trip is ~40ms. So we cut spawns, not round trips.
  # Dropped three that measured as pure overhead (bench 2026-07-17, ~0.9s off call→first-audio):
  #   • media-scan broadcast — AudioPreview reads the file:// VIEW directly and autoplays; it plays
  #     with no MediaStore entry (verified: audioflinger "1 are active" without the scan).
  #   • wake (keyevent 224) + keyguard swipe — these existed to make a COORDINATE TAP land. We start
  #     playback with KEYCODE_MEDIA_PLAY (126), a GLOBAL media key routed to the media session even
  #     behind the lockscreen, so focus/keyguard is irrelevant. Verified: plays from a locked,
  #     screen-OFF Note3 and the screen STAYS off — sound is the goal, not the screen (saves battery).
  #   • the pre-push `rm` — the per-PID rpath is unique and `adb push` overwrites; the rm was a no-op.
  # One adb shell now, two spawns (am VIEW → autoplay, then 126 to be sure; 126 is idempotent — plays,
  # never toggles off). 126 is silent, so grepping the combined output still asserts the VIEW launched.
  adb_sh "am start -a android.intent.action.VIEW -d file://$rpath -t audio/mpeg; input keyevent 126" 2>&1 \
    | tr -d '\r' | grep -qiE 'Starting|cmp=' \
    || { echo "mesh-note3-say: play intent did not launch" >&2; return 1; }
  echo "mesh-note3-say: spoke -> $rpath (voice=$voice)"
}

if [ "${1:-}" = --test ]; then
  f=0
  # SELF-MUTE DEADLINE (no hardware needed): concurrent speaks must only ever EXTEND the hold. The
  # old touch/`sleep dur+4; rm` form let a short clip's timer unmute the mic mid-way through a long
  # one — the room then transcribed our own voice as the operator's (2026-07-14).
  sf="$(mktemp)"; rm -f "$sf"
  _hold() {  # $1=dur → write max(existing, now+dur+8), mirroring the say() path
    local until cur; until=$(( $(date +%s) + $1 + 8 ))
    cur="$(cat "$sf" 2>/dev/null)"; case "$cur" in (''|*[!0-9]*) cur=0 ;; esac
    [ "$until" -gt "$cur" ] && echo "$until" > "$sf"; true
  }
  _hold 30; long_deadline="$(cat "$sf")"
  _hold 1                       # a SHORT clip arriving mid-playback must not shorten the hold
  [ "$(cat "$sf")" = "$long_deadline" ] || { echo "  FAIL: a short speak shortened the self-mute hold (race is back)"; f=1; }
  _hold 120                     # a LONGER clip must extend it
  [ "$(cat "$sf")" -gt "$long_deadline" ] || { echo "  FAIL: a longer speak failed to extend the hold"; f=1; }
  printf 'garbage\n' > "$sf"; _hold 5    # a corrupt flag must not wedge the mic muted forever
  [ "$(cat "$sf")" -gt 0 ] 2>/dev/null || { echo "  FAIL: corrupt flag not recovered"; f=1; }
  rm -f "$sf"
  # the poke/prompt contract: callers must NOT hand-manage the flag around say (that rm is the bug)
  # SYNTH PATH: the operator's voice-clone is primary, piper/ruslan the loud fallback. At least one
  # must be able to produce audio. A down clone daemon is n/a (not a defect) as long as piper covers.
  clone_ok=0; mesh-voice-say --test >/dev/null 2>&1 && clone_ok=1
  piper_ok=0; { [ -x "$PIPER" ] && [ -n "$VOICE" ] && [ -f "$VOICE" ]; } && piper_ok=1
  [ "$clone_ok" = 1 ] || echo "  note: operator voice-clone daemon not live → piper/ruslan fallback"
  [ "$clone_ok" = 1 ] || [ "$piper_ok" = 1 ] || { echo "  FAIL: no synth path (clone daemon down AND piper missing)"; f=1; }
  if ! phone_up; then echo "  n/a: Note3 adb not reachable (exit 2)"; exit 2; fi
  if [ "$f" = 0 ] && [ "${MESH_NOTE3_SAY_TEST_PLAY:-0}" = 1 ]; then
    say "проверка связи" || f=1
  fi
  [ "$f" = 0 ] && echo "  PASS: synth(clone=$clone_ok piper=$piper_ok)+adb ready" || exit 1
  exit 0
fi

say "$*"
