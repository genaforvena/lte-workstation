#!/usr/bin/env bash
set -euo pipefail

# mesh-model-swap — the HAND for the marked STT ladder.
# Only the line immediately following the model-ladder marker is mutable.

MARKER='model-ladder: stt/voice-rx — mesh-model-swap rewrites the NEXT line only'
CONSUMER="${MESH_MODEL_SWAP_CONSUMER:-$HOME/.local/bin/mesh-voice-rx}"
MODEL_DIR="${MESH_MODEL_SWAP_MODEL_DIR:-$HOME/.mesh/whispercpp/models}"
BACKUP_DIR="${MESH_MODEL_SWAP_BACKUP_DIR:-$HOME/.mesh/model-swap}"

die() { echo "mesh-model-swap: $*" >&2; return 2; }

swap_one() {
  local consumer="$1" candidate="$2" backup="$3"
  [[ -f "$consumer" ]] || die "consumer missing: $consumer"
  mkdir -p "$(dirname "$backup")"
  cp -- "$consumer" "$backup"
  python3 - "$consumer" "$candidate" "$MARKER" <<'PY'
import re, sys
from pathlib import Path

path, candidate, marker = sys.argv[1:]
lines = Path(path).read_text().splitlines(keepends=True)
hits = [i for i, line in enumerate(lines) if marker in line]
if len(hits) != 1:
    raise SystemExit(f"marker count={len(hits)} (expected exactly one)")
i = hits[0] + 1
if i >= len(lines) or not re.match(r"^\s*for name in \(", lines[i]):
    raise SystemExit("marked next line is not the STT model ladder")
names = []
j = i
while j < len(lines):
    names.extend(match[1] for match in re.findall(r"""(['"])(.*?)\1""", lines[j]))
    if "):" in lines[j]:
        break
    j += 1
if j >= len(lines):
    raise SystemExit("unterminated STT model ladder")
ordered = [candidate] + [name for name in names if name != candidate]
indent = re.match(r"^\s*", lines[i]).group(0)
newline = "\n" if lines[i].endswith("\n") else ""
lines[i:j+1] = [indent + "for name in (" + ", ".join(repr(name) for name in ordered) + "):" + newline]
Path(path).write_text("".join(lines))
PY
  if [[ ! -s "$MODEL_DIR/$candidate" ]]; then
    cp -- "$backup" "$consumer"
    die "refused nonexistent model: $MODEL_DIR/$candidate; restored=yes"
  fi
  if ! python3 -m py_compile "$consumer"; then
    cp -- "$backup" "$consumer"
    die "py_compile refused candidate; restored=yes"
  fi
  echo "swapped consumer=$consumer candidate=$candidate backup=$backup"
}

run_test() {
  local td bad before after rc
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' RETURN
  cp -- "$ROOT/scripts/mesh-voice-rx" "$td/mesh-voice-rx"
  before="$(sha256sum "$td/mesh-voice-rx" | awk '{print $1}')"
  bad="model-that-does-not-exist.bin"
  set +e
  MESH_MODEL_DIR="$td/models" MESH_MODEL_SWAP_BACKUP_DIR="$td/backup" \
    "$0" --apply "$bad" --consumer "$td/mesh-voice-rx" >"$td/red.out" 2>&1
  rc=$?
  set -e
  cat "$td/red.out"
  after="$(sha256sum "$td/mesh-voice-rx" | awk '{print $1}')"
  [[ "$rc" -eq 2 ]] || { echo "smoke-test: FAIL (red refusal rc=$rc, want 2)"; return 1; }
  [[ "$before" == "$after" ]] || { echo "smoke-test: FAIL (restored=no)"; return 1; }
  echo "red refusal rc=$rc restored=yes"
  echo "smoke-test: ok"
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in
  --test) run_test ;;
  --apply)
    [[ $# -eq 2 || $# -eq 4 ]] || { echo "usage: mesh-model-swap --apply MODEL [--consumer PATH]" >&2; exit 2; }
    candidate="$2"
    if [[ $# -eq 4 ]]; then
      [[ "$3" == "--consumer" ]] || { echo "usage: mesh-model-swap --apply MODEL [--consumer PATH]" >&2; exit 2; }
      CONSUMER="$4"
    fi
    backup="$BACKUP_DIR/$(basename "$CONSUMER").bak"
    swap_one "$CONSUMER" "$candidate" "$backup"
    ;;
  --restore)
    [[ $# -eq 2 ]] || { echo "usage: mesh-model-swap --restore BACKUP" >&2; exit 2; }
    cp -- "$2" "$CONSUMER"
    python3 -m py_compile "$CONSUMER"
    echo "restored consumer=$CONSUMER from=$2"
    ;;
  *) echo "usage: mesh-model-swap --test | --apply MODEL [--consumer PATH] | --restore BACKUP" >&2; exit 2 ;;
esac
