#!/usr/bin/env bash
# orphan-ok: on-demand live NIC-layer loss probe (sibling of mesh-tcp-retrans; mind pulls it, stateless, not scheduled)
# mesh-nic-drops — LINK-LAYER packet loss: interface drop/error counters, sampled live.
# Distinct axis from every existing net sense: mesh-tcp-retrans sees TCP-layer path loss
# (retransmits, anywhere on the path), mesh-wifi-link sees the RADIO (RSSI), mesh-netrate
# sees VOLUME — none sees the layer BELOW TCP on this box: the driver/ring-buffer dropping
# frames (rx_dropped: overrun, no buffer) or the hardware faulting (rx/tx_errors: CRC,
# carrier, fifo). A path can retransmit cleanly while the local NIC quietly sheds frames.
# Source: /sys/class/net/<if>/statistics/{rx,tx}_{packets,dropped,errors}, delta over a
# short window (cumulative counters — a single read is lifetime noise, e.g. wlp0s20f3
# carries 2282 lifetime tx drops that say nothing about NOW).
#
# Per-interface verdicts (deltas over the window; UP non-lo interfaces only):
#   QUIET     — < 10 packets moved: too little traffic to judge. Honest "can't tell".
#   CLEAN     — traffic flowed, zero drops, zero errors
#   DRIP      — drops > 0 but < 1% of packets (benign trickle, worth an eye)
#   DROPPING  — drops >= 1% of packets (or drops with NO traffic — pure shedding)
#   ERRORS    — any hard rx/tx error (CRC/carrier/fifo — hardware or driver fault)
# Overall = worst interface (ERRORS > DROPPING > DRIP > CLEAN > QUIET).
# Exit 2: /sys/class/net absent, or no UP non-lo interface — never fake a CLEAN.
# Stateless live probe (LIVE-ONLY class, like mesh-tcp-retrans/mesh-irq-rate): no cron, no state file.
#
#   mesh-nic-drops            one sampled reading (default 5s window)
#   mesh-nic-drops --window N sample over N seconds
#   mesh-nic-drops --test     smoke test (parser+classifier synthetic + real-read gate)
set -uo pipefail

SYSNET="${MESH_SYSNET:-/sys/class/net}"
WIN=5
[ "${1:-}" = --window ] && { WIN="${2:-5}"; shift 2; }

# snapshot: one line per UP non-lo interface: "<if> <pkts> <drops> <errs>" (rx+tx summed);
# interfaces with missing/garbage counters are skipped (never emit a made-up number)
snapshot() {
  local d i st rp tp rd td re te
  for d in "$SYSNET"/*/; do
    [ -d "$d" ] || continue
    i="$(basename "$d")"
    [ "$i" = lo ] && continue
    st="$(cat "$d/operstate" 2>/dev/null)"
    [ "$st" = up ] || continue
    rp="$(cat "$d/statistics/rx_packets" 2>/dev/null)"; tp="$(cat "$d/statistics/tx_packets" 2>/dev/null)"
    rd="$(cat "$d/statistics/rx_dropped" 2>/dev/null)"; td="$(cat "$d/statistics/tx_dropped" 2>/dev/null)"
    re="$(cat "$d/statistics/rx_errors"  2>/dev/null)"; te="$(cat "$d/statistics/tx_errors"   2>/dev/null)"
    case "${rp}${tp}${rd}${td}${re}${te}" in ''|*[!0-9]*) continue;; esac
    echo "$i $((rp+tp)) $((rd+td)) $((re+te))"
  done
}

# classify <dpkts> <ddrops> <derrs> -> verdict
classify() {
  local dpk=$1 dd=$2 de=$3
  if [ "$de" -gt 0 ]; then echo ERRORS; return; fi
  if [ "$dd" -gt 0 ]; then
    # drops with zero traffic = pure shedding (and guards the div-by-zero)
    if [ "$dpk" -eq 0 ] || awk -v d="$dd" -v p="$dpk" 'BEGIN{exit !(100*d/p>=1)}'; then
      echo DROPPING
    else
      echo DRIP
    fi
    return
  fi
  if [ "$dpk" -lt 10 ]; then echo QUIET; return; fi
  echo CLEAN
}

rank_of() { case "$1" in ERRORS) echo 4;; DROPPING) echo 3;; DRIP) echo 2;; CLEAN) echo 1;; *) echo 0;; esac; }

if [ "${1:-}" = --test ]; then
  e=0
  td_fix="$(mktemp -d)"; trap 'rm -rf "$td_fix"' EXIT
  # fixture: eth0 UP with counters; lo (must skip); dn0 DOWN (must skip); bad0 garbage (must skip)
  for f in eth0 lo dn0 bad0; do mkdir -p "$td_fix/$f/statistics"; done
  printf 'up\n'   > "$td_fix/eth0/operstate"
  printf 'up\n'   > "$td_fix/lo/operstate"
  printf 'down\n' > "$td_fix/dn0/operstate"
  printf 'up\n'   > "$td_fix/bad0/operstate"
  for k in rx_packets:100 tx_packets:200 rx_dropped:2 tx_dropped:3 rx_errors:0 tx_errors:0; do
    printf '%s\n' "${k#*:}" > "$td_fix/eth0/statistics/${k%%:*}"
  done
  for k in rx_packets tx_packets rx_dropped tx_dropped rx_errors tx_errors; do
    printf '9\n'   > "$td_fix/lo/statistics/$k"
    printf '9\n'   > "$td_fix/dn0/statistics/$k"
    printf 'abc\n' > "$td_fix/bad0/statistics/$k"
  done
  r="$(SYSNET="$td_fix"; snapshot)"
  [ "$r" = "eth0 300 5 0" ] || { echo "FAIL: fixture snapshot => '$r' (want 'eth0 300 5 0')"; e=$((e+1)); }
  # classifier boundaries
  [ "$(classify 5 0 0)"     = QUIET    ] || { echo "FAIL: quiet";            e=$((e+1)); }
  [ "$(classify 1000 0 0)"  = CLEAN    ] || { echo "FAIL: clean";            e=$((e+1)); }
  [ "$(classify 1000 5 0)"  = DRIP     ] || { echo "FAIL: drip (0.5%)";      e=$((e+1)); }
  [ "$(classify 1000 10 0)" = DROPPING ] || { echo "FAIL: 1pct boundary";    e=$((e+1)); }
  [ "$(classify 0 3 0)"     = DROPPING ] || { echo "FAIL: drops-no-traffic"; e=$((e+1)); }
  [ "$(classify 1000 0 1)"  = ERRORS   ] || { echo "FAIL: errors";           e=$((e+1)); }
  [ "$(classify 3 1 0)"     = DROPPING ] || { echo "FAIL: quiet+drops must not read QUIET"; e=$((e+1)); }
  # real-read gate: the live sysfs must yield >=1 parseable UP interface (verification
  # principle — classifier-only green is hollow). No UP interface = honest n/a, exit 2.
  r="$(snapshot)"
  if [ -z "$r" ]; then
    echo "smoke-test: n/a (no UP non-lo interface on this node — nothing to read)"; exit 2
  fi
  printf '%s\n' "$r" | head -1 | grep -qE '^[^ ]+ [0-9]+ [0-9]+ [0-9]+$' \
    || { echo "FAIL: real read unparseable => '$(printf '%s\n' "$r" | head -1)'"; e=$((e+1)); }
  [ "$e" -eq 0 ] && { echo "smoke-test: ok (9 assertions incl. real sysfs read: $(printf '%s\n' "$r" | head -1))"; exit 0; }
  echo "smoke-test: FAIL ($e fail(s))"; exit 1
fi

[ -d "$SYSNET" ] || { echo "nic-drops: UNREACHABLE (no $SYSNET)" >&2; exit 2; }
a="$(snapshot)"
[ -n "$a" ] || { echo "nic-drops: UNREACHABLE (no UP non-lo interface — nothing to measure)" >&2; exit 2; }
sleep "$WIN"
b="$(snapshot)"
[ -n "$b" ] || { echo "nic-drops: UNREACHABLE (interfaces vanished mid-window)" >&2; exit 2; }

overall=QUIET; orank=0; details=""
while read -r i pk dd de; do
  prev="$(printf '%s\n' "$a" | awk -v i="$i" '$1==i{print; exit}')"
  [ -n "$prev" ] || continue                       # came up mid-window: no baseline, skip
  read -r _ pk0 dd0 de0 <<<"$prev"
  dpk=$((pk-pk0)); ddr=$((dd-dd0)); der=$((de-de0))
  # counter reset (driver reload mid-window) → negative delta: name it, never fake a verdict
  if [ "$dpk" -lt 0 ] || [ "$ddr" -lt 0 ] || [ "$der" -lt 0 ]; then
    details="${details:+$details · }$i: counter reset mid-window (skipped)"; continue
  fi
  v="$(classify "$dpk" "$ddr" "$der")"
  r="$(rank_of "$v")"
  if [ "$r" -gt "$orank" ]; then orank=$r; overall=$v; fi
  details="${details:+$details · }$i: $v (${dpk} pkts, ${ddr} drop, ${der} err)"
done <<<"$b"

[ -n "$details" ] || { echo "nic-drops: UNREACHABLE (no interface survived the window)" >&2; exit 2; }
echo "nic-drops: $overall (${WIN}s window; $details)"
exit 0
