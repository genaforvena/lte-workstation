#!/usr/bin/env bash
# mesh-conversation — one spoken conversation TURN, fully local + reflexive (no minds).
# Ack on the speaker → record the mic → local whisper STT → mesh-relay (fast LLM) → piper TTS → speaker.
# Lives on a node with a mic + speaker (default-string: webcam mic + Bose). This is the organ a
# gesture/wake trigger fires (mesh-gesture-watch runs `mesh-conversation --turn` on a thumbs-up), but
# it's standalone — anything can trigger one turn (a button, a wake word, cron, a test).
#
# The whole pipeline is on-device: whisper.cpp transcribes locally, piper synthesizes locally; only the
# "thinking" step (mesh-relay) leaves the box (cheapest available text pool). No mind is involved.
#
#   mesh-conversation --session  CONTINUOUS dialog: ack → listen, on each PAUSE answer + keep listening
#                                (VAD turn-taking; silence never replies; ends after a long quiet gap)
#   mesh-conversation --turn     one fixed-window turn: ack → record → STT → relay → TTS → speak
#   mesh-conversation --say TXT  speak arbitrary text on the speaker (piper → pw-play)   (organ probe)
#   mesh-conversation --hear     record + transcribe only, print the text                (STT probe)
#   mesh-conversation --test     dry-run: render+play a fixed phrase, no mic/relay        (smoke)
#                                MESH_TEST_SANDBOX=1: render-only, no playback (mesh-doctor cron sweep)
#
# Tunables (env):
#   CONV_SECS=6           seconds of mic to record per turn
#   CONV_WHISPER=~/.mesh/whispercpp/main     CONV_MODEL=~/.mesh/whispercpp/models/ggml-base.bin
#   CONV_PIPER=~/.mesh/piper/piper/piper     CONV_VOICE=~/.mesh/piper/voices/ruslan.onnx
#   CONV_ACK=~/.mesh/mesh-slyshit.wav        pre-rendered "Меш слышит" acknowledgement
#   CONV_LANG=ru          CONV_LOG=~/.mesh/conversation.log
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"   # /usr/bin first: never a snap-confined pw-*/curl
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire (mic + Bose sink)
MESH="${MESH_DIR:-$HOME/.mesh}"

CONV_SECS="${CONV_SECS:-6}"
CONV_WHISPER="${CONV_WHISPER:-$MESH/whispercpp/main}"
CONV_MODEL="${CONV_MODEL:-$MESH/whispercpp/models/ggml-base.bin}"
CONV_PIPER="${CONV_PIPER:-$MESH/piper/piper/piper}"
CONV_PIPERLIB="${CONV_PIPERLIB:-$MESH/piper/piper}"
CONV_VOICE="${CONV_VOICE:-$MESH/piper/voices/ruslan.onnx}"
CONV_ACK="${CONV_ACK:-$MESH/mesh-slyshit.wav}"
CONV_LANG="${CONV_LANG:-ru}"
CONV_MIN_RMS="${CONV_MIN_RMS:-180}"   # below this the room is "silent" → skip (whisper would invent text)

# ── TURN-END IS AN INFERENCE, NOT AN OBSERVATION ────────────────────────────────────────────────
# (live-literature review, genome, 2026-08-25;
#  docs/reviews/fep-turn-end-is-an-inference-not-an-observation-conversation-2026-08-25.md)
#
# The session's VAD ends an utterance when silence reaches CONV_END_SIL (0.9s). That treats "the
# speaker has finished" as something you OBSERVE — a stopwatch on the gap. Active inference says it
# is a hidden state you INFER, and the evidence for it arrives in the speech BEFORE the gap, not
# during it. Two consequences, both live in this file:
#   1. a fixed END_SIL is a FLOOR ON LATENCY — every reply is at least 900ms late, where human
#      turn-taking latency is ~200ms, i.e. faster than detect-then-react can be. Humans must be
#      predicting the end, not waiting for it.
#   2. it CANNOT separate a hesitation from a completion, because it looks only at the gap's
#      DURATION. A 0.9s thinking-pause mid-sentence truncates the utterance and ships half a thought
#      to whisper; a speaker who pauses 0.5s between finished sentences waits the full 0.9s anyway.
#
# The state of the art is Voice Activity Projection — Ekstedt & Skantze, "Voice Activity Projection:
# Self-supervised learning of turn-taking events" (INTERSPEECH 2022): instead of detecting silence,
# continuously PREDICT both parties' future voice activity over 0-200/200-600/600-1200/1200-2000ms
# bins and act on the prediction. Live follow-on: Inoue, Elmers, Fu et al., "Prompt-Guided Turn-Taking
# Prediction" (SIGdial 2025, arXiv:2506.21191v2, 3 Jul 2025).
#
# WHAT IS LANDED HERE IS A PROXY, AND IT IS NAMED AS ONE. We have no trained VAP model, no stereo
# channels, and no way to get one on this node — so this is a single-channel ENERGY-ONLY projection:
# at the moment a pause begins, read the energy trajectory of the voiced tail that preceded it and
# choose END_SIL from it. Falling energy → a completed turn → commit sooner. Flat or rising → the
# speaker is mid-thought → hold longer. Same DIRECTION as VAP (the turn-end decision becomes
# conditioned on what preceded the gap) at a small fraction of its evidence. It is NOT VAP and must
# not be described as VAP anywhere downstream.
#
# It is REPORT-FIRST: every decision logs proj=/slope=/end_sil= so the conversation log becomes the
# corpus that can later say whether the split was real. The bands below are PROVISIONAL — no live
# corpus of turn-ends exists on this node yet, so they are stated as a hypothesis with a kill switch
# (CONV_TURNEND_PROJECT=0 restores the fixed 0.9s exactly), not as a calibrated constant.
CONV_TURNEND_PROJECT="${CONV_TURNEND_PROJECT:-1}"   # 0 = fixed END_SIL, the pre-review behaviour
CONV_END_SIL_FAST="${CONV_END_SIL_FAST:-0.45}"      # projected completion → commit sooner
CONV_END_SIL_SLOW="${CONV_END_SIL_SLOW:-1.60}"      # projected hesitation → hold
CONV_TAIL_FRAMES="${CONV_TAIL_FRAMES:-5}"           # voiced frames of tail read (5 x 200ms = 1.0s)
CONV_FALL_AT="${CONV_FALL_AT:--0.25}"               # relative tail slope <= this = falling = done
CONV_RISE_AT="${CONV_RISE_AT:-0.10}"                # relative tail slope >= this = rising = mid-thought

# ONE definition of the projector, called by BOTH the live session and --test. A gate that re-implements
# the predicate it is gating is not a gate on that predicate
# (a-lint-that-tests-a-different-predicate-than-the-parser-is-blind).
CONV_PROJECT_PY='
import sys
# argv: fall_at rise_at fast neutral slow  then the voiced-tail RMS values (oldest..newest)
fall,rise,fast,neutral,slow = (float(x) for x in sys.argv[1:6])
tail=[float(x) for x in sys.argv[6:]]
# TOO LITTLE TAIL IS NOT A PREDICTION. With fewer than 2 voiced frames there is no trajectory; fall
# back to the NEUTRAL default and say so, rather than reading a slope out of one number.
if len(tail)<2 or tail[0]<=0:
    print("neutral na %.2f"%neutral); raise SystemExit
slope=(tail[-1]-tail[0])/tail[0]
if   slope<=fall: print("fast %.3f %.2f"%(slope,fast))
elif slope>=rise: print("slow %.3f %.2f"%(slope,slow))
else:             print("neutral %.3f %.2f"%(slope,neutral))
'

CONV_LOG="${CONV_LOG:-$MESH/conversation.log}"

logln() { printf '%sZ  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S)" "$1" >> "$CONV_LOG" 2>/dev/null || true; }

# --- speak <text> : render with piper and play on the default sink (Bose) -----------------------------
# _play <wav> — the actual audio-out primitive (pw-play, aplay fallback). CONV_TEST_PLAY_LOG
# overrides with a log-append stub for --test's regression guard: PATH-prepend binary stubbing is
# defeated by this script's own "/usr/bin first" export at the top (same gotcha mesh-chat's
# test_sandboxed() comment notes — a tool's own PATH prepend wins over an injected stub dir).
_play() {
  if [ -n "${CONV_TEST_PLAY_LOG:-}" ]; then printf 'play %s\n' "$1" >> "$CONV_TEST_PLAY_LOG"; return 0; fi
  pw-play "$1" >/dev/null 2>&1 || aplay -q "$1" >/dev/null 2>&1
}

speak() {
  local txt="$1" wav; wav="$(mktemp "${TMPDIR:-/tmp}"/conv-tts-XXXX.wav)"
  if [ -x "$CONV_PIPER" ] && [ -f "$CONV_VOICE" ]; then
    printf '%s' "$txt" | LD_LIBRARY_PATH="$CONV_PIPERLIB" "$CONV_PIPER" -m "$CONV_VOICE" -f "$wav" 2>/dev/null
  fi
  [ -s "$wav" ] && _play "$wav"
  rm -f "$wav"
}

# --- play a pre-rendered wav (the ack) ----------------------------------------------------------------
play_wav() { [ -s "$1" ] && _play "$1"; }

# --- record CONV_SECS of mic to a 16k mono wav --------------------------------------------------------
record() {  # <out.wav> -> 0 if a non-empty wav was produced
  local out="$1"
  timeout "$((CONV_SECS+2))" pw-record --rate 16000 --channels 1 "$out" >/dev/null 2>&1 &
  local pid=$!
  sleep "$CONV_SECS"
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  [ -s "$out" ]
}

# --- mic energy: RMS of a wav (0-32767). A near-silent room reads low; whisper invents plausible
# filler from silence, so we gate on real energy BEFORE transcribing. Prints an integer RMS. ----------
wav_rms() {  # <in.wav> -> integer RMS on stdout (0 if unreadable)
  python3 - "$1" <<'PY'
import sys, wave, audioop
try:
    w=wave.open(sys.argv[1],'rb'); d=w.readframes(w.getnframes())
    print(audioop.rms(d, w.getsampwidth()) if d else 0)
except Exception: print(0)
PY
}

# --- transcribe a wav with whisper.cpp; echo trimmed text --------------------------------------------
transcribe() {  # <in.wav> -> text on stdout
  [ -x "$CONV_WHISPER" ] && [ -f "$CONV_MODEL" ] || { echo ""; return 1; }
  "$CONV_WHISPER" -m "$CONV_MODEL" -f "$1" -l "$CONV_LANG" -nt 2>/dev/null \
    | tr '\n' ' ' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

# --- whisper hallucinates filler on silence/noise; reject it so we don't "answer" a quiet room --------
# Returns 0 (real speech) or 1 (garbage to ignore). Matches the common ru silence hallucinations.
is_real_speech() {  # <text>
  local t; t="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  [ -n "$t" ] || return 1
  # too short to be a real utterance. NB: GNU tr is byte-oriented, so `tr -dc '[:alnum:]'` would
  # strip every multibyte Cyrillic char and make EVERY Russian utterance look empty (false "no speech").
  # Strip only spaces with bash expansion (multibyte-safe) and check the remaining length.
  local bare="${t//[[:space:]]/}"
  [ "${#bare}" -ge 4 ] || return 1
  case "$t" in
    *'спокойная музыка'*|*'продолжение следует'*|*субтитр*|*'[музыка]'*|*'[аплодисменты]'*|\
    *'спасибо за просмотр'*|*'редактор субтитров'*|*'корректор'*|'thank you'|'you'|*'♪'*) return 1;;
  esac
  return 0
}

turn() {
  logln "TURN start (record ${CONV_SECS}s)"
  play_wav "$CONV_ACK"                       # "Меш слышит"
  local wav; wav="$(mktemp "${TMPDIR:-/tmp}"/conv-rec-XXXX.wav)"
  if ! record "$wav"; then logln "record FAIL"; rm -f "$wav"; speak "Микрофон не отвечает."; return 1; fi
  local rms; rms="$(wav_rms "$wav")"
  if [ "${rms:-0}" -lt "$CONV_MIN_RMS" ]; then
    logln "silence rms=$rms < $CONV_MIN_RMS -> skip"; rm -f "$wav"; speak "Тихо, я ничего не услышал."; return 0
  fi
  local text; text="$(transcribe "$wav")"; rm -f "$wav"
  logln "rms=$rms"
  logln "HEARD: ${text:-<empty>}"
  if ! is_real_speech "$text"; then
    logln "no real speech -> skip"; speak "Я не расслышал, повтори, пожалуйста."; return 0
  fi
  local reply; reply="$(mesh-relay "Ты — голос умного дома 'Меш'. Ответь коротко (1-2 фразы), по-русски, разговорно. Вопрос: $text" 2>/dev/null)"
  reply="$(printf '%s' "$reply" | tr '\n' ' ' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  [ -n "$reply" ] || reply="Что-то я завис, попробуй ещё раз."
  logln "REPLY: $reply"
  speak "$reply"
  return 0
}

# --- continuous SESSION: listen until a pause, answer, keep listening (VAD turn-taking) --------------
# Streams raw PCM from pw-record and runs a tiny voice-activity state machine in python: wait for
# speech onset, capture until a pause, transcribe THAT utterance, think, speak (mic idle while we talk),
# then listen again. Silence/empty room never triggers a reply. The session ends after a long quiet gap.
session() {
  export CONV_WHISPER CONV_MODEL CONV_PIPER CONV_PIPERLIB CONV_VOICE CONV_ACK CONV_LANG CONV_LOG
  export CONV_TURNEND_PROJECT CONV_END_SIL_FAST CONV_END_SIL_SLOW CONV_TAIL_FRAMES \
         CONV_FALL_AT CONV_RISE_AT CONV_PROJECT_PY
  local PY; PY="$(mktemp "${TMPDIR:-/tmp}"/conv-sess-XXXXXX.py)"; trap 'rm -f "$PY"' RETURN
  cat > "$PY" <<'PYEOF'
import os, sys, time, wave, audioop, subprocess, struct

RATE=16000; FRAME_MS=int(os.environ.get("CONV_FRAME_MS","200"))
FRAME=int(RATE*FRAME_MS/1000); FBYTES=FRAME*2; FSEC=FRAME_MS/1000.0
START_RMS=int(os.environ.get("CONV_START_RMS","600"))   # speech onset
SIL_RMS  =int(os.environ.get("CONV_SIL_RMS","300"))     # below = silence
END_SIL  =float(os.environ.get("CONV_END_SIL","0.9"))   # silence that ends an utterance (NEUTRAL default)
PROJECT  =os.environ.get("CONV_TURNEND_PROJECT","1")!="0"
SIL_FAST =float(os.environ.get("CONV_END_SIL_FAST","0.45"))
SIL_SLOW =float(os.environ.get("CONV_END_SIL_SLOW","1.60"))
TAILN    =int(os.environ.get("CONV_TAIL_FRAMES","5"))
FALL_AT  =float(os.environ.get("CONV_FALL_AT","-0.25"))
RISE_AT  =float(os.environ.get("CONV_RISE_AT","0.10"))
PROJECT_PY=os.environ.get("CONV_PROJECT_PY","")

def project_end_sil(tail):
    """The SAME projector --test drives (CONV_PROJECT_PY), invoked as a child so there is exactly one
    definition. Returns (label, slope_str, end_sil). Any failure falls back to the NEUTRAL default —
    a broken projector must not be able to make the organ deaf or make it interrupt."""
    if not PROJECT or not PROJECT_PY:
        return ("off","na",END_SIL)
    try:
        args=["python3","-c",PROJECT_PY,str(FALL_AT),str(RISE_AT),str(SIL_FAST),str(END_SIL),str(SIL_SLOW)]
        args+= [str(int(x)) for x in tail]
        out=subprocess.run(args,capture_output=True,timeout=5).stdout.decode().split()
        if len(out)!=3: raise ValueError("projector output "+repr(out))
        return (out[0], out[1], float(out[2]))
    except Exception as e:
        logln("turnend-proj-err "+str(e))
        return ("neutral","err",END_SIL)
MAX_UTT  =float(os.environ.get("CONV_MAX_UTT","18"))    # hard cap per utterance
MIN_UTT  =float(os.environ.get("CONV_MIN_UTT","0.4"))   # minimum voiced length to bother
IDLE_END =float(os.environ.get("CONV_SESSION_IDLE","22"))  # quiet gap that ends the session
LANG=os.environ.get("CONV_LANG","ru")
WHISPER=os.environ["CONV_WHISPER"]; MODEL=os.environ["CONV_MODEL"]
PIPER=os.environ["CONV_PIPER"]; PIPERLIB=os.environ["CONV_PIPERLIB"]; VOICE=os.environ["CONV_VOICE"]
ACK=os.environ.get("CONV_ACK",""); LOG=os.environ["CONV_LOG"]

def logln(s):
    try:
        with open(LOG,"a") as f: f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ",time.gmtime())+s+"\n")
    except Exception: pass

def play(path):
    if path and os.path.exists(path):
        subprocess.run(["pw-play",path],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)

def speak(txt):
    wav="/tmp/conv-say-%d.wav"%os.getpid()
    p=subprocess.run([PIPER,"-m",VOICE,"-f",wav],input=txt.encode(),
        env=dict(os.environ,LD_LIBRARY_PATH=PIPERLIB),
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if os.path.exists(wav) and os.path.getsize(wav)>0:
        subprocess.run(["pw-play",wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        try: os.remove(wav)
        except OSError: pass

HALLU=("спокойная музыка","продолжение следует","субтитр","[музыка]","[аплодисменты]",
       "спасибо за просмотр","редактор субтитров","корректор","♪","thank you")
def is_real(text):
    t=text.strip().lower()
    if len("".join(t.split()))<4: return False
    for h in HALLU:
        if h in t: return False
    if t in ("you","thank you","ну","да","а"): return False
    return True

def transcribe(wavpath):
    try:
        out=subprocess.run([WHISPER,"-m",MODEL,"-f",wavpath,"-l",LANG,"-nt"],
            capture_output=True,timeout=60).stdout.decode("utf-8","ignore")
        return " ".join(out.split()).strip()
    except Exception as e:
        logln("whisper-err "+str(e)); return ""

def relay(text):
    prompt=("Ты — голос умного дома 'Меш'. Ответь коротко, 1-2 фразы, по-русски, разговорно. "
            "Вопрос: "+text)
    try:
        out=subprocess.run(["mesh-relay",prompt],capture_output=True,timeout=40).stdout.decode("utf-8","ignore")
        return " ".join(out.split()).strip()
    except Exception as e:
        logln("relay-err "+str(e)); return ""

def read_exact(f,n):
    buf=b""
    while len(buf)<n:
        chunk=f.read(n-len(buf))
        if not chunk: break
        buf+=chunk
    return buf

def record_until_pause():
    # returns: None (session idle-out) | "" (noise/too-short, keep going) | wavpath (an utterance)
    p=subprocess.Popen(["pw-record","--rate","16000","--channels","1","--format","s16","-"],
        stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
    frames=[]; capturing=False; silence=0.0; waited=0.0
    voiced_tail=[]; end_sil=END_SIL
    try:
        while True:
            buf=read_exact(p.stdout,FBYTES)
            if len(buf)<FBYTES: break
            r=audioop.rms(buf,2)
            if not capturing:
                waited+=FSEC
                if r>=START_RMS:
                    capturing=True; frames=[buf]; silence=0.0; voiced_tail=[r]; end_sil=END_SIL
                elif waited>=IDLE_END:
                    return None
            else:
                frames.append(buf)
                if r<SIL_RMS:
                    # PAUSE ONSET is the moment the prediction is made — from the voiced tail that
                    # came BEFORE it, never from the gap itself.
                    if silence==0.0:
                        lbl,sl,end_sil = project_end_sil(voiced_tail[-TAILN:])
                        logln("turnend proj=%s slope=%s end_sil=%.2f tail=%d"%(lbl,sl,end_sil,len(voiced_tail[-TAILN:])))
                    silence+=FSEC
                    if silence>=end_sil: break
                else:
                    silence=0.0
                    end_sil=END_SIL          # speech resumed: the previous projection is void
                    voiced_tail.append(r)
                if len(frames)*FSEC>=MAX_UTT: break
    finally:
        p.kill()
        try: p.stdout.close()
        except Exception: pass
    voiced=len(frames)*FSEC - silence
    if voiced<MIN_UTT: return ""
    wav="/tmp/conv-utt-%d.wav"%os.getpid()
    w=wave.open(wav,"wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
    w.writeframes(b"".join(frames)); w.close()
    return wav

def main():
    logln("SESSION start (start_rms=%d end_sil=%.1fs idle_end=%.0fs)"%(START_RMS,END_SIL,IDLE_END))
    play(ACK)                                   # "Меш слышит" — the audible "I'm listening now"
    time.sleep(0.3)
    exchanges=0
    while True:
        w=record_until_pause()
        if w is None:
            break                               # long quiet → end session
        if w=="":
            continue
        text=transcribe(w)
        try: os.remove(w)
        except OSError: pass
        logln("HEARD: "+(text or "<empty>"))
        if not is_real(text):
            continue                            # junk / hallucination → stay silent, keep listening
        reply=relay(text) or "Что-то я завис, повтори."
        logln("REPLY: "+reply)
        speak(reply)
        exchanges+=1
        time.sleep(0.3)                         # let Bose echo settle before listening again
    logln("SESSION end (exchanges=%d)"%exchanges)
    if exchanges>0:
        speak("Слушать перестал, покажи палец, если что.")

main()
PYEOF
  python3 "$PY"
}

case "${1:-}" in
  --session)
    # single-session lock: a second thumbs-up mid-session must NOT start a competing listener
    # (two pw-record/Bose at once = audio chaos). flock -n → the second invocation just exits.
    exec 9>"$MESH/conversation.lock"
    if ! flock -n 9; then logln "session already running — ignored"; exit 0; fi
    session ;;
  --turn)  turn ;;
  --say)   shift; speak "${*:-Меш на связи.}" ;;
  --hear)
    wav="$(mktemp "${TMPDIR:-/tmp}"/conv-rec-XXXX.wav)"
    record "$wav" && transcribe "$wav"; echo; rm -f "$wav" ;;
  --test)
    # smoke: no mic, no relay — just prove TTS renders + plays and the binaries are present
    miss=0
    for f in "$CONV_WHISPER" "$CONV_MODEL" "$CONV_PIPER" "$CONV_VOICE"; do
      [ -e "$f" ] || { echo "  MISSING: $f"; miss=1; }
    done
    [ "$miss" = 0 ] || { echo "smoke-test: FAIL (stack pieces missing above)"; exit 1; }
    # ── TURN-END PROJECTION (2026-08-25 review). Drives the SAME $CONV_PROJECT_PY the live session
    # calls, so this is a gate on the deciding predicate and not on a re-implementation of it.
    _proj() { python3 -c "$CONV_PROJECT_PY" "$CONV_FALL_AT" "$CONV_RISE_AT" "$CONV_END_SIL_FAST" "0.9" "$CONV_END_SIL_SLOW" "$@"; }
    # falling tail (a finished turn trailing off) → commit SOONER than the fixed 0.9s
    _lbl(){ printf '%s' "${1%% *}"; }
    _val(){ printf '%s' "${1##* }"; }
    _r="$(_proj 900 850 700 500 300)"
    [ "$(_lbl "$_r")" = fast ] && [ "$(_val "$_r")" = "$(printf '%.2f' "$CONV_END_SIL_FAST")" ] \
      || { echo "smoke-test: FAIL (falling tail must project fast at CONV_END_SIL_FAST=$CONV_END_SIL_FAST, got '$_r')"; exit 1; }
    # rising tail (mid-thought, the speaker is still building) → HOLD longer, never interrupt
    _r="$(_proj 300 400 550 700 900)"
    [ "$(_lbl "$_r")" = slow ] && [ "$(_val "$_r")" = "$(printf '%.2f' "$CONV_END_SIL_SLOW")" ] \
      || { echo "smoke-test: FAIL (rising tail must project slow at CONV_END_SIL_SLOW=$CONV_END_SIL_SLOW, got '$_r')"; exit 1; }
    # flat tail → NEUTRAL: the projector must decline to predict rather than guess a direction
    _r="$(_proj 600 605 598 601 600)"
    [ "$(_lbl "$_r")" = neutral ] && [ "$(_val "$_r")" = 0.90 ] \
      || { echo "smoke-test: FAIL (flat tail must fall back to the fixed 0.90s default, got '$_r')"; exit 1; }
    # TOO LITTLE TAIL IS NOT A PREDICTION — one voiced frame has no trajectory. It must render the
    # neutral default with slope 'na', never read a direction out of a single number: a slope of
    # 0.000 computed from one sample masquerades as a MEASURED flat.
    for _t in "600" ""; do
      _r="$(_proj $_t)"
      case "$_r" in neutral\ na\ 0.90) : ;; *) echo "smoke-test: FAIL (a <2-frame tail must be neutral/na/0.90, got '$_r' for tail '$_t')"; exit 1;; esac
    done
    # THE PROJECTION IS BOUNDED BY THE FIXED DEFAULT IN BOTH DIRECTIONS. fast must not be so short
    # that a breath ends a turn, slow must not exceed the session idle-out (the organ would hang up
    # mid-utterance). These are the two ways this change could make the organ WORSE than the constant
    # it replaces, so they are asserted rather than assumed.
    awk -v f="$CONV_END_SIL_FAST" 'BEGIN{exit !(f>=0.3)}'       || { echo "smoke-test: FAIL (CONV_END_SIL_FAST=$CONV_END_SIL_FAST is under 0.3s — a breath would end a turn)"; exit 1; }
    awk -v s="$CONV_END_SIL_SLOW" -v i="${CONV_SESSION_IDLE:-22}" 'BEGIN{exit !(s<i)}'       || { echo "smoke-test: FAIL (CONV_END_SIL_SLOW=$CONV_END_SIL_SLOW >= session idle ${CONV_SESSION_IDLE:-22}s — the session would hang up mid-utterance)"; exit 1; }
    # THE KILL SWITCH MUST BE REACHABLE. A projection this un-calibrated has to be revertible to the
    # exact pre-review behaviour by one env var, and that has to be gated, not asserted in a comment.
    grep -q 'CONV_TURNEND_PROJECT' <<<"$(declare -p CONV_TURNEND_PROJECT 2>/dev/null)"       || { echo "smoke-test: FAIL (CONV_TURNEND_PROJECT kill switch is not defined)"; exit 1; }
    echo "  turn-end projection: falling→0.45s  rising→1.60s  flat/short→0.90s (fixed default), bounds ok"
    # regression guard: log-stub _play (via CONV_TEST_PLAY_LOG) to prove the sandbox gate ACTUALLY
    # skips playback (not just reads right by inspection) — recurse once under each mode and assert
    # who got logged. _CONV_SELFTEST_NESTED breaks the recursion.
    if [ "${_CONV_SELFTEST_NESTED:-0}" != 1 ]; then
      _playlog="$(mktemp "${TMPDIR:-/tmp}"/conv-test-play-XXXX.log)"
      CONV_TEST_PLAY_LOG="$_playlog" MESH_TEST_SANDBOX=1 _CONV_SELFTEST_NESTED=1 "$0" --test >/dev/null 2>&1
      [ ! -s "$_playlog" ] || { echo "smoke-test: FAIL (MESH_TEST_SANDBOX=1 still invoked playback: $(cat "$_playlog"))"; rm -f "$_playlog"; exit 1; }
      CONV_TEST_PLAY_LOG="$_playlog" MESH_TEST_SANDBOX=0 _CONV_SELFTEST_NESTED=1 "$0" --test >/dev/null 2>&1
      [ -s "$_playlog" ] || { echo "smoke-test: FAIL (regression-guard baseline broke: unsandboxed --test didn't invoke playback)"; rm -f "$_playlog"; exit 1; }
      rm -f "$_playlog"
      echo "  regression-guard: sandboxed --test invokes zero playback, unsandboxed still does"
    fi
    if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
      # SANDBOX (chat-review/conversation-test-sandbox-tts 2026-07-08): every hourly mesh-doctor
      # --cron smoke-sweep called speak() unconditionally here, audibly playing "Меш на связи,
      # проверка голоса." through the room's real Bose — confirmed root cause of mesh-overhear's
      # recurring hourly false wake-poke (its loose wake_hit matches the STT garble of this TTS
      # bleeding back into the mic). Mirrors mesh-chat's test_sandboxed() gate: under a smoke-sweep,
      # still prove the render pipeline (piper end-to-end, to a throwaway wav) but never play it.
      echo "  all stack pieces present; rendering to a throwaway wav (sandboxed, no playback)…"
      _wav="$(mktemp "${TMPDIR:-/tmp}"/conv-tts-test-XXXX.wav)"
      printf '%s' "Меш на связи, проверка голоса." | LD_LIBRARY_PATH="$CONV_PIPERLIB" "$CONV_PIPER" -m "$CONV_VOICE" -f "$_wav" 2>/dev/null
      _ok=0; [ -s "$_wav" ] && _ok=1
      rm -f "$_wav"
      [ "$_ok" = 1 ] || { echo "smoke-test: FAIL (sandboxed render produced an empty/missing wav)"; exit 1; }
      echo "smoke-test: ok (whisper+model+piper+voice present, TTS rendered — sandboxed, no playback)"
    else
      echo "  all stack pieces present; rendering a test phrase…"
      speak "Меш на связи, проверка голоса."
      echo "smoke-test: ok (whisper+model+piper+voice present, TTS rendered)"
    fi
    ;;
  *) sed -n '2,24p' "$0" ;;
esac
