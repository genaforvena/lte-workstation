#!/usr/bin/env python3
"""mesh-witness-analyze — the mesh reading its OWN self-measurement and speaking findings.

mesh-witness WRITES the vital-signs ledger (~/.mesh/witness.log); nothing READ it. A human
skimming the pane mis-reads it: the alarming-looking fractions (nodes 5/9, senses 6/17 fresh)
are STRUCTURAL, not faults — 5/9 is the ceiling across the whole tape (router/phone/ds/ideapad
are expected-down as mesh nodes), and '6/17 fresh' with dist 6f/8r/3a/0s/0u is HEALTHY (recent
and aging are fine; the tool's own docstring warns the fresh-fraction alone lies). So this
analyzer's whole job is to gate on the RIGHT signal, not the scary-looking one:

  - senses  → gate on stale+unknown COUNT (from senses_dist), NEVER on the fresh fraction.
  - nodes   → gate on the reached count dropping BELOW its recent floor / a NAMED newly-offline
              node — NOT on the constant 5/9 ceiling.
  - board   → gate on sustained staleness (board_age_s beyond band), not on quiet oscillation.
  - minds   → gate on climbing ABOVE its recent band (a memory-pressure precursor / OOM leading
              indicator), not on the absolute number.
  - witness → if the newest ledger row is older than 2x the measure cadence, the WITNESS itself
              stalled; its all-clear is untrustworthy. Notice that too.

Edge-gated + deduped PER FINDING (state: ~/.mesh/.witness-analyze.state, one `key<TAB>first_seen
<TAB>last_posted` row per active finding). A run says ONLY the findings that are NEWLY active, plus
any that have stood past RENOTIFY_S (24h default) — re-said once with how long they have stood, so a
chronic finding is neither flooded nor silently swallowed. A finding that CLEARS is dropped from the
state, so its next appearance is an edge again. Steady state = SILENT.

This used to be a hash over the whole ACTIVE KEY SET, which made each finding's silence depend on
every OTHER finding's stability — one flapping member re-published all of them. Measured cost before
the fix: 'reflex-health = STALE' re-posted 154 times over 10.7 continuously-true days on phaedra,
because 'board silent Ns' toggled under it. See signature() for the full autopsy.

Honest-fusion: a missing/unreadable source renders that check UNKNOWN (skipped), never a faked
all-clear.

Usage:  mesh-witness-analyze            # analyze; post to board iff findings-signature changed
        mesh-witness-analyze --analyze  # same (explicit; the reflex mode)
        mesh-witness-analyze --dry-run  # print what WOULD post + the gate decision; post nothing
        mesh-witness-analyze --force    # post the current findings even if the signature is unchanged
        mesh-witness-analyze --test     # smoke test (parses the ledger; posts nothing; exit 0)

# reflex-cadence: */30 * * * *
# reflex-args: --analyze
"""
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes. The signal is routine here, not hypothetical: GNU
# `timeout` without --foreground puts its child in its OWN PROCESS GROUP and signals the GROUP, so
# every timeout-wrapped call site -- mesh-doctor's hourly --test sweep, mesh-autowire's `timeout 30`
# -- delivers TERM to this process. That is how 950MB of stranded snapshots filled phaedra's /tmp on
# 2026-08-16 with a `finally: rmtree` sitting right there in the source (first fixed in mesh-spend,
# d2fd7c9b). sys.exit() from a handler raises SystemExit in the MAIN THREAD, which is what makes
# try/finally unwind. SIGKILL stays uncatchable -- that half is mesh-tmp-guard's sweep, never this.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))


# cron runs with a stripped PATH that omits ~/.local/bin — mesh-chat lives there. Prepend it so the
# board post resolves under cron exactly as it does in an interactive shell (the mesh-witness scar).
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":" + os.environ.get("PATH", "/usr/bin:/bin")

MESHDIR = os.path.expanduser("~/.mesh")
LEDGER = os.path.join(MESHDIR, "witness.log")
SENSEMAP = os.path.join(MESHDIR, "sense-map.txt")
STATE = os.path.join(MESHDIR, ".witness-analyze.state")

MEASURE_CADENCE_S = 120          # mesh-witness --measure runs every 2 min
RECENT = 6                       # newest N rows = "now" (last ~12 min)
BASELINE = 720                   # trailing window for bands (~24h at 2-min cadence)

# thresholds (deliberately conservative — edge-gating + dedup already bound noise)
SENSES_BAD_MIN = 2               # >= this many (stale+unknown) senses is worth saying
BOARD_STALE_S = 900              # board silent > 15 min = sustained, not oscillation
NODE_TOTAL = 9


def read_rows(limit=BASELINE):
    """Parse the last `limit` ledger rows into dicts. Honest: unreadable ledger -> []. """
    try:
        with open(LEDGER) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    rows = []
    for line in lines[-limit:]:
        parts = line.split()
        if not parts:
            continue
        row = {"ts": parts[0]}
        for tok in parts[1:]:
            if "=" in tok:
                k, v = tok.split("=", 1)
                row[k] = v
        rows.append(row)
    return rows


def _int(v):
    """'12' -> 12 ; 'UNKNOWN'/None/'4/9' -> None (fraction handled by callers)."""
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _frac_num(v):
    """'5/9' -> 5 ; else None."""
    if not v or "/" not in v:
        return None
    return _int(v.split("/", 1)[0])


def parse_dist(v):
    """'6f/8r/3a/0s/0u' -> {'f':6,'r':8,'a':3,'s':0,'u':0}. Robust to missing/UNKNOWN."""
    out = {}
    if not v:
        return out
    for m in re.finditer(r"(\d+)([a-z])", v):
        out[m.group(2)] = int(m.group(1))
    return out


def offline_nodes():
    """Names of nodes sense-map marks offline (for naming a real nodes-drop).

    Unreadable map -> None (the caller then skips node-naming, honest-fusion). NOTE: we do NOT
    infer a 'phantom-live sense via a dead transport' from the map's '[...-via-<host>]' tags —
    verified 2026-07-17 that note3 reads FRESH via a working path while its map annotation still
    says 'adb-via-ds' (ds offline): the sense is live, only the human-readable transport label is
    stale. Alarming on that would wrongly invalidate a healthy sense. Transport-label staleness is
    a cosmetic provenance drift, not a data fault — left out of the gate deliberately.

    ANCHOR ON THE STATUS, NEVER ON THE COLUMN GAP. The status is a closed set appearing as a
    whole word; the gap before it is NOT uniform. The set GREW on 2026-08-26 (mesh-sense-map
    split `unreach` into `unreach`/`svc-down`/`svc-open`/`svc-mute`/`unprobed`), so the `svc-`
    family is matched by PREFIX, not by member — an allowlist of today's members is the shape a
    producer outruns. None of the new words is offline, which is what they were already doing
    here by falling through unmatched; spelling them is parity with the sibling parser
    mesh-witness._parse_node_states, not a behaviour change.
    _render pads the host field to 26 chars, so a 26-char hostname
    ('imozerov-IdeaPad-3-15IIL05') gets exactly ONE separator space and a \\s{2,} match drops
    the row silently — measured 2026-08-15 on the live cache: 7 offline devices, 6 returned,
    and the one made invisible was the node a nodes-drop finding would have had to NAME.
    The sibling parser mesh-witness._parse_node_states was hardened for exactly this in the
    same format and this one never got the fix (two parsers of one format, one hardened);
    the host may also carry an internal space ('Redmi 10'), which is why the host is taken as
    everything BEFORE the status rather than as \\S+.
    """
    try:
        with open(SENSEMAP) as f:
            txt = f.read()
    except OSError:
        return None
    status_re = re.compile(r"^\s+(\S.*?)\s+(online|unreach|offline|unprobed|svc-[a-z]+)(?=\s|$)")
    offline = set()
    for line in txt.splitlines():
        m = status_re.match(line)
        if m and m.group(2) == "offline":
            offline.add(m.group(1).strip())
    return offline


def household_state():
    """mesh-household-state's token (ACTIVE/ASLEEP/AWAY/UNCERTAIN/UNKNOWN).

    Honest-fusion: unreadable/error -> '' (NOT 'ASLEEP'). A board-stale alarm must be
    suppressed only when the household is genuinely ASLEEP (a quiet board is intended at
    night); an unreadable household sense must NOT silently swallow a real alarm, so it
    returns '' which the caller treats as 'do not suppress' (fail-safe toward alerting).
    """
    try:
        out = subprocess.run(["mesh-household-state"], capture_output=True,
                             text=True, timeout=15)
        m = re.search(r"household:\s*([A-Z_]+)", out.stdout)
        return m.group(1) if m else ""
    except (subprocess.SubprocessError, OSError):
        return ""


def board_stale_fires(board_age_s, household):
    """Stale board is worth alarming ONLY when the household isn't ASLEEP.

    A quiet board at night (house ASLEEP) is intended, not a fault — gate on
    household-state!=ASLEEP so the silence alarm stops firing ~hour after house-ASLEEP
    (false-alarm 2026-07-24 22:30, 46min post house-ASLEEP). household=='' (unreadable) does
    NOT suppress: an unreadable household sense must not silently swallow a real alarm.
    """
    if board_age_s is None or board_age_s <= BOARD_STALE_S:
        return False
    return household != "ASLEEP"


def analyze():
    """Return (findings, context). findings = list of (sig, text); context for --dry-run."""
    rows = read_rows()
    ctx = {"rows": len(rows)}
    if not rows:
        return [("no-ledger", "witness ledger unreadable/empty — self-measurement blind")], ctx

    findings = []
    latest = rows[-1]
    recent = rows[-RECENT:]

    # --- witness liveness: is the ledger itself still being written? ---
    try:
        last_dt = datetime.strptime(latest["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        age = (datetime.now(timezone.utc) - last_dt).total_seconds()
        ctx["row_age_s"] = int(age)
        if age > 2 * MEASURE_CADENCE_S:
            findings.append(("witness-stale",
                             f"witness ledger STALE — newest row {int(age)}s old (>2x cadence): "
                             f"mesh-witness --measure may be dead; its all-clear is untrustworthy"))
    except (KeyError, ValueError):
        pass

    # --- reflex verdict ---
    if latest.get("reflex") not in (None, "OK"):
        findings.append(("reflex", f"reflex-health = {latest.get('reflex')} (not OK)"))

    # --- senses: gate on stale+unknown, NOT the fresh fraction ---
    dist = parse_dist(latest.get("senses_dist"))
    if dist:
        bad = dist.get("s", 0) + dist.get("u", 0)
        ctx["senses_bad"] = bad
        if bad >= SENSES_BAD_MIN:
            findings.append(("senses-bad",
                             f"senses degraded: {bad} stale/unknown ({latest.get('senses_dist')}) "
                             f"— unlike the healthy recent/aging fill, these are genuinely blind"))

    # --- nodes: gate on dropping BELOW the recent floor, not the constant ceiling ---
    node_now = _frac_num(latest.get("nodes"))
    node_hist = [n for n in (_frac_num(r.get("nodes")) for r in rows[:-RECENT]) if n is not None]
    ctx["nodes_now"] = node_now
    if node_now is not None and node_hist:
        floor = min(node_hist)
        ctx["nodes_floor"] = floor
        if node_now < floor:
            offline = offline_nodes()
            who = ""
            if offline:
                who = " — offline: " + ", ".join(sorted(offline))
            findings.append(("nodes-drop",
                             f"nodes reached {node_now}/{NODE_TOTAL} — a NEW low "
                             f"(recent floor was {floor}/{NODE_TOTAL}){who}"))

    # --- board staleness (sustained) — suppressed when the household is ASLEEP ---
    ba = _int(latest.get("board_age_s"))
    ctx["board_age_s"] = ba
    hs = household_state() if (ba is not None and ba > BOARD_STALE_S) else ""
    if hs:
        ctx["household"] = hs
    if board_stale_fires(ba, hs):
        suffix = f" (household {hs})" if hs else ""
        findings.append(("board-stale",
                         f"board silent {ba}s (>{BOARD_STALE_S}s) — sustained posting/gossip gap{suffix}"))

    # --- minds climbing above band (memory-pressure precursor) ---
    minds_now = _int(latest.get("minds_live"))
    minds_hist = [m for m in (_int(r.get("minds_live")) for r in rows[:-RECENT]) if m is not None]
    ctx["minds_now"] = minds_now
    if minds_now is not None and minds_hist:
        band_max = max(minds_hist)
        ctx["minds_band_max"] = band_max
        if minds_now > band_max:
            findings.append(("minds-high",
                             f"minds_live {minds_now} above its recent band (max {band_max}) "
                             f"— load/OOM-pressure precursor on the sole mind-home"))

    return findings, ctx


def signature(findings):
    """Hash of the ACTIVE KEY SET. Kept for --dry-run/diagnostics only — it is NO LONGER the gate.

    Why it stopped being the gate (board task witness-analyze-signature-flap-republishes-chronic,
    measured on the shared log 2026-08-14): a set-hash makes every member's silence depend on every
    OTHER member's stability. On phaedra 'reflex-health = STALE' was continuously true for 10.7 days
    (2026-08-04T02:00Z → 2026-08-14T18:30Z) and was re-posted **154 times**, because the second
    finding 'board silent Ns (>900s)' toggles on and off (104 of those posts): the set flipped
    {reflex} ↔ {reflex,board-silent} and re-fired the gate in BOTH directions. 181 posts from one
    analyzer, the great majority carrying a verdict nobody had acted on for ten days — the board's
    largest single-source noise, and it teaches every reader to skip [witness] lines.

    Sibling of the edge-key trap (a rising counter inside the compare key fires every run) but the
    inverse: here each KEY is right and the SET is wrong. The gate is now PER FINDING (see gate()).
    """
    sigs = sorted(sig for sig, _ in findings)
    return hashlib.sha1("|".join(sigs).encode()).hexdigest()[:12] if sigs else "clear"


# Slow re-notify so a CHRONIC finding is not silently dropped either: a key that stays active is
# re-said at most once per this interval, carrying how long it has stood. Suppressing forever would
# trade a flood for a blind spot — the finding would exist only in the state file.
RENOTIFY_S = int(os.environ.get("MESH_WITNESS_RENOTIFY_S", 86400))


def load_state():
    """key -> (first_seen, last_posted). Tolerates the LEGACY single-line signature file (→ {}),
    which costs exactly one catch-up post on the first run after deploy and never crashes."""
    out = {}
    try:
        with open(STATE) as f:
            for line in f:
                parts = line.strip().split("\t")
                if len(parts) != 3:
                    continue            # legacy signature line / garbage: ignore, don't die
                try:
                    out[parts[0]] = (float(parts[1]), float(parts[2]))
                except ValueError:
                    continue
    except OSError:
        return {}
    return out


def save_state(state):
    try:
        with open(STATE, "w") as f:
            for key, (first, last) in sorted(state.items()):
                f.write(f"{key}\t{first:.0f}\t{last:.0f}\n")
    except OSError:
        pass


def gate(findings, state, now):
    """PER-FINDING edge gate. Returns (to_post, carried).

      to_post — [(key, text, age_s_or_None)] — keys that are NEWLY active (age None), plus keys
                that have persisted past RENOTIFY_S since their last post (age = seconds active).
      carried — the state to keep if nothing is posted: every ACTIVE key with its existing
                (first_seen, last_posted). A key that CLEARED is simply not carried, so its next
                appearance is an edge again — recovery stays an edge, exactly as the set-hash's
                'save clear' branch used to guarantee for the all-clear case.

    Pure (no clock, no I/O) so --test can drive the real decision instead of asserting source text.
    """
    to_post, carried = [], {}
    for key, text in findings:
        first, last = state.get(key, (None, None))
        if first is None:
            to_post.append((key, text, None))
            carried[key] = (now, last if last is not None else 0.0)
        elif now - last >= RENOTIFY_S:
            to_post.append((key, text, now - first))
            carried[key] = (first, last)
        else:
            carried[key] = (first, last)
    return to_post, carried


def post(text):
    env = dict(os.environ, MESH_WHO=f"witness-analyze@{os.uname().nodename}")
    try:
        subprocess.run(["mesh-chat", text], env=env, check=True,
                       timeout=30, stdout=subprocess.DEVNULL)
        return True
    except (subprocess.SubprocessError, OSError) as e:
        print(f"post failed: {e}", file=sys.stderr)
        return False


def compose(findings):
    body = " | ".join(text for _, text in findings)
    return f"[witness] self-reading: {body}"


def compose_posted(entries):
    """Render only the findings being SAID this run. A chronic re-notify says how long it has stood,
    so a reader can tell 'this is new' from 'this is the same thing, still true since <then>'."""
    parts = []
    for _key, text, age in entries:
        if age is None:
            parts.append(text)
        else:
            days = age / 86400.0
            span = f"{days:.1f}d" if days >= 1 else f"{age / 3600.0:.1f}h"
            parts.append(f"{text} [chronic {span}, re-notify]")
    return f"[witness] self-reading: {' | '.join(parts)}"


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--analyze"

    if arg == "--test":
        rows = read_rows(limit=10)
        if not rows:
            print("smoke-test: WARN (ledger empty/unreadable) — analyzer parses, nothing to gate")
        findings, _ = analyze()
        signature(findings)                       # exercise the gate path
        parse_dist("6f/8r/3a/0s/0u")              # exercise the dist parser

        # household-gate unit (hermetic — no subprocess, no live board state). A quiet board at
        # night is intended: ASLEEP suppresses; everything else (incl. unreadable '') must FIRE
        # (fail-safe toward alerting — an unreadable household sense never swallows a real alarm).
        gate_cases = [
            (2000, "ASLEEP", False),    # night quiet — intended, suppress
            (2000, "ACTIVE", True),     # alert hours — fires
            (2000, "AWAY", True),       # away but silence still notable
            (2000, "UNCERTAIN", True),  # don't suppress on uncertainty
            (2000, "", True),           # unreadable household — MUST fire (fail-safe)
            (500, "ACTIVE", False),     # not even stale
            (None, "ACTIVE", False),    # no board-age reading
        ]
        for age, hh, expect in gate_cases:
            got = board_stale_fires(age, hh)
            if got != expect:
                print(f"smoke-test: FAIL (board_stale_fires({age},{hh!r})={got}, expected {expect})")
                sys.exit(1)

        # ── offline_nodes() PARSER GATE (board task
        #    witness-analyze-offline-nodes-drops-the-single-space-row) ────────────────────────────
        # Drives the REAL function against a fixture map holding every awkward shape the live cache
        # actually contains. The load-bearing row is the 26-char host: _render pads the host field
        # to 26, so it gets exactly ONE separator space and the old \s{2,} regex dropped it — on the
        # live cache that was 6 of 7 offline devices, with the missing one being precisely the node
        # a nodes-drop finding has to NAME. Second row: a host with an internal space ('Redmi 10'),
        # which is why the host cannot be \S+. Third: 'unreach' must NOT count as offline.
        _sm_fixture = (
            "-- DEVICES: 8 --\n"
            "  mesh-home                  online   ble wifi\n"
            "  imozerov-IdeaPad-3-15IIL05 offline  ?\n"     # 26 chars -> ONE separator space
            "  Redmi 10                   offline  ?\n"     # internal space in the host
            "  note3                      unreach  ble\n"   # unreach is not offline
            "  phaedra                    offline  ?\n"
            # the 2026-08-26 vocabulary split: a device whose SERVICE is down is emphatically
            # not an offline node — naming it in a nodes-drop finding sends the reader to the
            # network, which is exactly the collapse the split removed one tool upstream.
            "  redmi                      svc-down ?\n"
            "  svc-gw                     unprobed ?\n"       # host named like the family, too
        )
        _sm_path = os.path.join(tempfile.mkdtemp(prefix="witness-analyze-test."), "sense-map.txt")
        with open(_sm_path, "w") as _f:
            _f.write(_sm_fixture)
        # globals(), NOT a bare `SENSEMAP = ...`: this block lives inside main(), so a plain
        # assignment would bind a LOCAL while offline_nodes() kept reading the module global — the
        # fixture would be silently ignored and the gate would quietly assert the LIVE map.
        _sm_saved = globals()["SENSEMAP"]
        globals()["SENSEMAP"] = _sm_path
        try:
            _got = offline_nodes()
        finally:
            globals()["SENSEMAP"] = _sm_saved
            shutil.rmtree(os.path.dirname(_sm_path), ignore_errors=True)
        _want = {"imozerov-IdeaPad-3-15IIL05", "Redmi 10", "phaedra"}   # NOT redmi/svc-gw
        if _got != _want:
            print(f"smoke-test: FAIL (offline_nodes()={sorted(_got or [])}, expected {sorted(_want)})")
            sys.exit(1)
        # RED-first: restore the old \s{2,} column-gap match and the 26-char host vanishes from the
        # set above (verified by hand — the assert goes red naming exactly that host).

        try:
            # ── PER-FINDING GATE (board task witness-analyze-signature-flap-republishes-chronic) ──
            # Driven through the REAL gate() the reflex calls, on the exact live shape: one CHRONIC key
            # (reflex-health, true for 10.7d) under one FLAPPING key (board-silent). Under the old
            # set-hash every one of these steps re-published the chronic finding.
            A, B = ("reflex", "reflex-health = STALE"), ("board-silent", "board silent 997s")
            t0 = 1_000_000.0
            st = {}
            tp, st = gate([A, B], st, t0)
            assert [k for k, _, _ in tp] == ["reflex", "board-silent"], f"first run must say both: {tp}"
            st = {k: (v[0], t0) for k, v in st.items()}          # simulate a successful post
            tp, st2 = gate([A, B], st, t0 + 60)
            assert tp == [], f"unchanged set must be silent: {tp}"
            # THE REGRESSION THIS FIXES: the flapping member leaves; the chronic one must stay SILENT.
            tp, st3 = gate([A], st, t0 + 120)
            assert tp == [], f"chronic finding re-published when the flapping member cleared: {tp}"
            assert "board-silent" not in st3, "a cleared key must be dropped so recovery is an edge"
            # ...and when the flapper returns, ONLY it is said.
            tp, st4 = gate([A, B], st3, t0 + 180)
            assert [k for k, _, _ in tp] == ["board-silent"], f"only the returning key should post: {tp}"
            # slow re-notify: the chronic key is re-said once past RENOTIFY_S, carrying its age
            tp, _ = gate([A], st, t0 + RENOTIFY_S + 1)
            assert [k for k, _, _ in tp] == ["reflex"] and tp[0][2] is not None, f"chronic re-notify: {tp}"
            assert "chronic" in compose_posted(tp), compose_posted(tp)
            # recovery stays an edge: cleared → re-appears → said as NEW (age None, no chronic marker)
            tp, st5 = gate([], st, t0 + 240)
            assert tp == [] and st5 == {}, f"all-clear must empty the state: {st5}"
            tp, _ = gate([A], st5, t0 + 300)
            assert [k for k, _, _ in tp] == ["reflex"] and tp[0][2] is None, f"recurrence must be NEW: {tp}"
            # legacy state file (a bare signature line) must load as empty, not crash
            _legacy = STATE + ".legacytest"
            try:
                with open(_legacy, "w") as f:
                    f.write("a1b2c3d4e5f6\n")
                _real, globals()["STATE"] = STATE, _legacy
                assert load_state() == {}, "legacy signature state must degrade to empty, not raise"
            finally:
                globals()["STATE"] = _real
                try:
                    os.unlink(_legacy)
                except OSError:
                    pass

        except AssertionError as e:
            print(f"smoke-test: FAIL (per-finding gate: {e})")
            sys.exit(1)

        print(f"smoke-test: OK ({len(rows)} rows readable, {len(findings)} finding(s) computed, "
              f"household-gate 7/7, offline-parser gate 3/3, per-finding gate 8/8 (flap-under-chronic silent, cleared key "
              f"dropped, chronic re-notify at {RENOTIFY_S}s, legacy state tolerated), no post)")
        sys.exit(0)

    findings, ctx = analyze()
    now = time.time()
    state = load_state()
    to_post, carried = gate(findings, state, now)

    if arg == "--dry-run":
        print(f"ctx: {ctx}")
        print(f"signature: {signature(findings)}  (diagnostic only — the gate is per-finding)")
        for key, _text in findings:
            first, last = state.get(key, (None, None))
            if first is None:
                why = "NEW → post"
            elif now - last >= RENOTIFY_S:
                why = f"chronic {(now - first) / 86400.0:.1f}d, last said {(now - last) / 3600.0:.1f}h ago → re-notify"
            else:
                why = f"active since {(now - first) / 3600.0:.1f}h, said {(now - last) / 3600.0:.1f}h ago → suppressed"
            print(f"  {key}: {why}")
        for key in sorted(set(state) - {k for k, _ in findings}):
            print(f"  {key}: CLEARED → dropped from state (next appearance is an edge)")
        print("WOULD SAY:\n  " + compose_posted(to_post) if to_post else "WOULD SAY: (nothing)")
        sys.exit(0)

    force = arg == "--force"
    if force and findings:
        if post(compose(findings)):
            save_state({k: (carried.get(k, (now, now))[0], now) for k, _ in findings})
        sys.exit(0)
    if not to_post:
        # Nothing NEW and nothing due for re-notify. Still save: a finding that CLEARED must leave
        # the state now, or its recovery→recurrence would not read as an edge later.
        save_state(carried)
        sys.exit(0)
    if post(compose_posted(to_post)):
        for key, _text, _age in to_post:
            first = carried.get(key, (now, now))[0]
            carried[key] = (first, now)
    # a post that FAILED leaves last_posted untouched (and a brand-new key unrecorded), so the next
    # run retries it instead of swallowing a finding that was never actually said.
    save_state({k: v for k, v in carried.items() if v[1] > 0})
    sys.exit(0)


if __name__ == "__main__":
    main()
