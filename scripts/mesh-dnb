#!/usr/bin/env bash
# mesh-dnb — DYNAMICAL NETWORK BIOMARKER foresight probe. A multivariate early-warning read of the
# subsystem pain-vector that mesh-algedonic already logs, catching a signature its noisy-OR
# aggregation is STRUCTURALLY BLIND to.
#
# THE GAP IT FILLS (literature, live-reviewed 2026-07-24, genome):
#   mesh-algedonic fuses the per-subsystem pains {therm,hw,egress,stress,crit} with NOISY-OR
#   (pain = 1 - Π(1-p_i)) — which treats the subsystems as INDEPENDENT. Two subsystems sitting at
#   0.3 pain each give the same viability whether they drift independently or move in LOCKSTEP. But
#   the tipping-point literature (Chen, Liu, Aihara, "Detecting early-warning signals … by dynamical
#   network biomarkers", Scientific Reports 2:342, 2012) shows the pre-transition signature is not the
#   LEVEL of distress but the CORRELATION STRUCTURE: as a complex system nears a critical transition, a
#   subset of variables (the DOMINANT GROUP, DG) simultaneously (1) destabilizes — its SD rises,
#   (2) TIGHTENS — |correlation| WITHIN the group rises, and (3) DECOUPLES — |correlation| between the
#   group and the rest falls. The composite DNB index is  I = SD_d · PCC_d / PCC_o  (rises before the
#   tip). This is orthogonal to the single-axis CSD (variance + lag-1 autocorr) we already compute for
#   THERMAL only in mesh-therm-regime → mesh-stress: DNB is the CROSS-SUBSYSTEM covariance read.
#   Live frontier this lands beside (not embodied): Causal Network Markers (Bian et al., "Utilizing
#   Causal Network Markers to Identify Tipping Points…", Advanced Science 2025 / PMC12622457) add
#   DIRECTIONALITY to DNB via Granger causality (CNM-GC) and transfer entropy (CNM-TE).
#
# HONEST SCOPE — this is a SIMPLIFIED DNB, and says so:
#   • DG selection is threshold-based (axes whose windowed SD ≥ the SD median AND > a floor), NOT the
#     iterative dominant-group search of the full method. With ~5 axes the search is overkill; the
#     threshold split captures the "a subset destabilizes together" core. Labeled DNB-lite in output.
#   • Correlation-based (Pearson), NOT the 2025 causal CNM — no directionality claim.
#   • It is a FORESIGHT PROBE, not a gate: it never escalates or acts. A consumer (mesh-stress, like
#     mesh-therm-regime) may later fuse the reading; until then it only reports + logs.
#
#   mesh-dnb                 compute the current DNB-lite index over the live algedonic axis history
#   mesh-dnb --window N      samples to read (default 24 = 4h at the 10-min algedonic cadence)
#   mesh-dnb --json          machine-readable reading
#   mesh-dnb --test          RED-first smoke: a co-moving subset must score STRICTLY above an
#                            independent one, and a flat/independent window must read benign
#
# Insufficient / flat data → HONEST "no dominant group forming" (I≈0), never a faked alarm and never a
# faked all-clear: a window that cannot be computed (too few samples) reads UNKNOWN, not 0.
# orphan-ok: on-demand foresight probe — deliberately NOT cron-wired (a scheduled liveness reflex it
# is not; wiring a foresight reading as a beat would fake liveness — the never-wired-reflex trap).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
ALG_LOG="${MESH_DNB_LOG:-$MESH/algedonic.log}"
WINDOW="${MESH_DNB_WINDOW:-24}"
SD_FLOOR="${MESH_DNB_SD_FLOOR:-0.02}"   # an axis below this windowed SD is treated as flat (not in DG)
OUT_JSON=0

# The core: read a matrix (one row per sample, columns = axes; "?" = missing) on stdin and print the
# DNB-lite reading. Pure awk so it is trivially fixture-testable and has no float-tool dependency.
# Input rows are comma-joined "axis:value" cells (value numeric or "?").
_dnb_compute() {
  awk -v sd_floor="$SD_FLOOR" '
    function absf(x){ return x<0?-x:x }
    {
      nrow++
      n=split($0, cells, ",")
      for(i=1;i<=n;i++){
        split(cells[i], kv, ":")
        ax=kv[1]; val=kv[2]
        if(!(ax in seen)){ seen[ax]=1; order[++naxes]=ax }
        if(val ~ /^-?[0-9.]+$/){ X[nrow,ax]=val; P[nrow,ax]=1 }
      }
    }
    END{
      if(nrow < 3){ print "UNKNOWN 0 0 0 0 - insufficient-samples("nrow")"; exit }
      # per-axis mean + SD over present samples
      for(a=1;a<=naxes;a++){ ax=order[a]; cnt=0; s=0; ss=0
        for(r=1;r<=nrow;r++) if((r,ax) in P){ v=X[r,ax]; cnt++; s+=v; ss+=v*v }
        if(cnt>=2){ m=s/cnt; var=ss/cnt-m*m; if(var<0)var=0; SD[ax]=sqrt(var); MEAN[ax]=m; NPR[ax]=cnt }
        else { SD[ax]=0; MEAN[ax]=0; NPR[ax]=cnt }
      }
      # dominant group = axes with SD above the median SD AND above the flat floor (>=2 needed)
      nv=0; for(a=1;a<=naxes;a++){ ax=order[a]; sv[a]=SD[ax] }
      # median of sv[1..naxes]
      for(a=1;a<=naxes;a++) srt[a]=sv[a]
      for(a=1;a<=naxes;a++) for(b=a+1;b<=naxes;b++) if(srt[b]<srt[a]){ t=srt[a]; srt[a]=srt[b]; srt[b]=t }
      med = (naxes%2)? srt[(naxes+1)/2] : (srt[naxes/2]+srt[naxes/2+1])/2
      dg_n=0
      for(a=1;a<=naxes;a++){ ax=order[a]
        if(SD[ax] >= med && SD[ax] > sd_floor){ DG[ax]=1; dg_n++ } else DG[ax]=0
      }
      if(dg_n < 2){ printf "BENIGN 0.000 %.4f 0 0 %d no-dominant-group\n", 0, dg_n; exit }
      # pairwise |Pearson| helper across present-in-both rows
      # PCC_d = mean over DG-DG pairs ; PCC_o = mean over DG-NDG pairs ; SD_d = mean SD over DG
      sd_sum=0; sd_c=0
      for(a=1;a<=naxes;a++){ ax=order[a]; if(DG[ax]){ sd_sum+=SD[ax]; sd_c++ } }
      SD_d = (sd_c? sd_sum/sd_c : 0)
      pin_s=0; pin_c=0; pout_s=0; pout_c=0
      for(a=1;a<=naxes;a++) for(b=a+1;b<=naxes;b++){
        axa=order[a]; axb=order[b]
        # pearson over rows present in both
        cc=0; sa=0; sb=0; saa=0; sbb=0; sab=0
        for(r=1;r<=nrow;r++) if((r,axa) in P && (r,axb) in P){ va=X[r,axa]; vb=X[r,axb]; cc++; sa+=va; sb+=vb; saa+=va*va; sbb+=vb*vb; sab+=va*vb }
        r_ab=0
        if(cc>=3){ cova=sab/cc-(sa/cc)*(sb/cc); da=saa/cc-(sa/cc)^2; db=sbb/cc-(sb/cc)^2; if(da>0&&db>0) r_ab=cova/sqrt(da*db) }
        r_ab=absf(r_ab)
        if(DG[axa] && DG[axb]){ pin_s+=r_ab; pin_c++ }
        else if(DG[axa] || DG[axb]){ pout_s+=r_ab; pout_c++ }
      }
      PCC_d = (pin_c? pin_s/pin_c : 0)
      PCC_o = (pout_c? pout_s/pout_c : 0.05)   # no NDG pairs → floor (everything co-moving is still a rise)
      if(PCC_o < 0.05) PCC_o = 0.05            # epsilon floor: PCC_o→0 must not blow the index to inf
      I = SD_d * PCC_d / PCC_o
      # membership string
      mem=""
      for(a=1;a<=naxes;a++){ ax=order[a]; if(DG[ax]) mem=mem (mem?"+":"") ax }
      band = (I>=0.30)?"TIGHTENING":((I>=0.10)?"WATCH":"BENIGN")
      printf "%s %.3f %.4f %.4f %.4f %d %s\n", band, I, SD_d, PCC_d, PCC_o, dg_n, mem
    }
  '
}

# Extract the last WINDOW axis-vectors from the algedonic log as the compute matrix.
_read_algedonic() {
  grep -oE 'axes=[^ ]+' "$ALG_LOG" 2>/dev/null | sed 's/axes=//' | tail -n "$WINDOW"
}

case "${1:-}" in
  --test)
    fail=0
    # RED-first: a subset that MOVES TOGETHER (a+b lockstep, rising) must score STRICTLY above the SAME
    # subset drifting INDEPENDENTLY. Falsify: drop PCC_d from the index (I=SD_d) → both score equal.
    comove="$(printf '%s\n' \
      'a:0.10,b:0.10,c:0.00' 'a:0.20,b:0.20,c:0.00' 'a:0.30,b:0.30,c:0.00' \
      'a:0.40,b:0.40,c:0.00' 'a:0.50,b:0.50,c:0.00' 'a:0.60,b:0.60,c:0.00' | _dnb_compute)"
    # independent = a PERMUTATION of a's values for b (SAME SD → same dominant group, same SD_d) but
    # near-zero correlation with a. NOT anti-correlated: |PCC| counts anti-correlation as tight
    # coupling too, so an anti-correlated pair correctly scores HIGH — the metric is right, so the
    # control must be genuinely UNcorrelated for an apples-to-apples PCC_d comparison.
    indep="$(printf '%s\n' \
      'a:0.10,b:0.40,c:0.00' 'a:0.20,b:0.10,c:0.00' 'a:0.30,b:0.50,c:0.00' \
      'a:0.40,b:0.20,c:0.00' 'a:0.50,b:0.60,c:0.00' 'a:0.60,b:0.30,c:0.00' | _dnb_compute)"
    i_co="$(printf '%s' "$comove" | awk '{print $2}')"
    i_in="$(printf '%s' "$indep"  | awk '{print $2}')"
    awk -v a="$i_co" -v b="$i_in" 'BEGIN{exit !(a>b)}' \
      && echo "  ok: co-moving subset scores above independent ($i_co > $i_in)" \
      || { echo "  FAIL: co-moving ($i_co) did not beat independent ($i_in) — DNB signal dead"; fail=1; }
    # a FLAT window (no axis clears the SD floor) must read BENIGN / no-dominant-group, never an alarm
    flat="$(printf '%s\n' 'a:0.30,b:0.00,c:0.00' 'a:0.30,b:0.00,c:0.00' 'a:0.30,b:0.00,c:0.00' \
      'a:0.30,b:0.00,c:0.00' 'a:0.30,b:0.00,c:0.00' | _dnb_compute)"
    printf '%s' "$flat" | grep -qE 'BENIGN|no-dominant-group' \
      && echo "  ok: flat window reads benign (no faked alarm)" \
      || { echo "  FAIL: flat window did not read benign: $flat"; fail=1; }
    # too few samples → HONEST UNKNOWN, never a faked 0/all-clear
    unk="$(printf '%s\n' 'a:0.1,b:0.1,c:0' | _dnb_compute)"
    printf '%s' "$unk" | grep -q UNKNOWN \
      && echo "  ok: <3 samples reads UNKNOWN (honest, not a faked all-clear)" \
      || { echo "  FAIL: sparse window did not read UNKNOWN: $unk"; fail=1; }
    # PCC_o epsilon floor: everything co-moving (no NDG) must NOT produce inf/nan
    allmove="$(printf '%s\n' 'a:0.1,b:0.1,c:0.1' 'a:0.2,b:0.2,c:0.2' 'a:0.3,b:0.3,c:0.3' \
      'a:0.4,b:0.4,c:0.4' 'a:0.5,b:0.5,c:0.5' | _dnb_compute | awk '{print $2}')"
    case "$allmove" in *inf*|*nan*|"") echo "  FAIL: all-co-moving produced non-finite index ($allmove)"; fail=1;; *) echo "  ok: all-co-moving index finite ($allmove)";; esac
    [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
    echo "smoke-test: ok (co-move>independent, flat→benign, sparse→UNKNOWN, PCC_o floor keeps index finite)"
    exit 0 ;;
  --json) OUT_JSON=1; shift ;;
  --window) WINDOW="${2:?}"; shift 2 ;;
  -h|--help) sed -n '2,40p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac
[ "${1:-}" = --window ] && { WINDOW="${2:?}"; shift 2; }

[ -r "$ALG_LOG" ] || { echo "mesh-dnb: no algedonic log at $ALG_LOG" >&2; exit 2; }
reading="$(_read_algedonic | _dnb_compute)"
read -r band idx sd_d pcc_d pcc_o dg_n mem <<<"$reading"
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "$OUT_JSON" = 1 ]; then
  printf '{"at":"%s","band":"%s","index":%s,"sd_d":%s,"pcc_d":%s,"pcc_o":%s,"dg_n":%s,"group":"%s","window":%s}\n' \
    "$now" "$band" "${idx:-0}" "${sd_d:-0}" "${pcc_d:-0}" "${pcc_o:-0}" "${dg_n:-0}" "${mem:--}" "$WINDOW"
else
  echo "mesh-dnb (DNB-lite foresight) · $now · window=$WINDOW samples"
  echo "  band=$band* index=$idx  [I = SD_d·PCC_d/PCC_o]"
  echo "  SD_d=$sd_d  PCC_d=$pcc_d  PCC_o=$pcc_o  dominant-group=${mem:--} (n=$dg_n)"
  echo "  reading: a RISING index = a subset of subsystems destabilizing AND tightening together —"
  echo "           the pre-transition signature mesh-algedonic's noisy-OR cannot see."
  echo "  *BANDS ARE PROVISIONAL — UNCALIBRATED: the 664-sample algedonic corpus contains NO logged"
  echo "   transition, so absolute thresholds can't be fit yet. What is test-proven is the SEPARATION"
  echo "   (a co-moving subset scores ~5x an independent one). Watch the TREND of index, not its band,"
  echo "   until a real collapse is in the log to calibrate against. PCC_o floors at 0.05 (div-guard),"
  echo "   so a low-PCC_d baseline over mostly-flat axes reads near the floor, not a genuine alarm."
fi
