#!/usr/bin/env python3
# mesh-fswriter — name the PROCESS that wrote an artifact (discover find
# fanotify-writer-attribution, 2026-08-16). mtime says a touch happened; this says WHICH pid, running
# WHICH cmdline, wrote WHICH path, WHEN. inotify structurally cannot: its event struct has no pid
# field. This is not mesh-fsnotify (inotify, wired, answers "did chat.log change" for a 4ms board
# wake, zero attribution) — it is the attribution the mtime-reading liveness apparatus lacks
# (writer-redundancy-blinds-mtime-liveness, mtime-proves-a-touch-not-a-sign-relation; and
# mesh-test-forgery infers a self-forging --test from WHICH log grew, where this names the writer).
#
#   mesh-fswriter [--window S] <path>...   watch those artifacts, print+log every write's writer
#   mesh-fswriter --last <path>            last recorded writer for <path> (exit 2 if never observed)
#   mesh-fswriter --readers [--window S] <path>...   the OTHER end of the relation: who READ it
#   mesh-fswriter --last-reader <path>     last recorded reader (exit 2 if never observed)
#   mesh-fswriter --test                   smoke test (exit 2 where fanotify cannot be armed)
#   MESH_FSWRITER_LOG=<path>               consumer sink (keeps a sweep out of the durable record)
#
# THE READ SIDE (--readers, 2026-08-17, literature review review-biosemiotics-extinction-as-symptom-
# maran-2026-08-17.md). Maran (Biosemiotics 19:155-169, 2026) reads extinction as a SYMPTOM SIGN: the
# terminal event sits at the END of a causal chain whose real content is a decline in the "depth of
# meaning" — the richness of ENACTED sign relations. The mesh already asks the triadic question
# (mesh-doctor's `interpretant check`: does this producer's state have a reader, an invoker, or a
# later self-read?) but answers it by GREPPING THE SOURCE CORPUS. That establishes a relation is
# DECLARED, never that it is EXERCISED — a consumer reading the path inside a branch that never runs,
# or a consumer that is itself dead, counts as a live interpretant. Source text is never behaviour
# (1969a5d). This mode closes that: fanotify FAN_ACCESS names the pid/comm/cmdline that actually READ
# the artifact, which atime cannot do (atime-records-the-investigation-not-the-use — our own grep
# moves it and leaves no name to subtract).
#  * FAN_ACCESS ONLY — bytes were actually read. Deliberately not FAN_OPEN/FAN_CLOSE_NOWRITE: an open
#    that reads nothing (a stat, a truncate probe, a failed lock) is not an interpretation, and
#    counting it would rebuild the same too-loose claim one layer down.
#  * WRITER AND READER ROWS ARE DIFFERENT SPECIES and never share a tag (`fswriter` / `fsreader`), so
#    --last-reader can never redeem itself with a write. The relation has two ends; one observed end
#    is not the relation.
#  * ABSENCE IS WINDOW-BOUNDED AND THE ARTIFACT SAYS SO. Coverage is window/cadence (fe35dd9): a 30s
#    watch on an hourly consumer observes nothing and that is not evidence of no consumer. The silent
#    line and the --last-reader miss both carry that sentence, because a comment is not a channel to
#    the reader of the output.
#
# FOR A CONSUMER ARMING THIS AROUND SOMEONE ELSE'S RUN: it announces `armed N artifact(s)` on STDERR
# once the marks are set — block on that line, never on a sleep. stdout carries the attribution rows.
#
# ARMING NEEDS ROOT, LISTENING DOES NOT (measured, brief §"the privilege is needed to ARM"): the
# process re-execs itself under `sudo -n`, calls fanotify_init + fanotify_mark, then setuid()s back to
# the invoking uid IMMEDIATELY. The hours-long listener holds no privilege — post-drop fanotify_mark
# is EPERM while events keep flowing with pid, comm and full path readable.
#
# THREE BOUNDARIES, each with a gate in --test:
#  * FAN_CLASS_NOTIF ONLY. The PERM classes (FAN_OPEN_PERM/FAN_ACCESS_PERM) BLOCK every matching
#    syscall node-wide until the listener answers — a wedged listener freezes the filesystem for every
#    process including the ssh/tmux path you would kill it from. Self-defeating in its sharpest form.
#    That is the boundary of the capability, not a knob: there is no flag here to ask for it.
#  * INODE MARKS ONLY, never FAN_MARK_MOUNT/FILESYSTEM. A mount mark marks the MOUNT, not the path:
#    on this node (no separate /home) a mark "on ~/.mesh" silently observes the whole root fs and
#    costs ~50 events/s. One mark per named artifact keeps the scope the scope you asked for.
#  * IDENTITY IS CAPTURED INSIDE THE EVENT LOOP. A pid read late is a recycled-number risk, not just
#    a missing name; an already-exited writer records comm=<exited> and is never attributed. An EMPTY
#    cmdline is three facts, not one — a departing writer (the kernel zeroes argv during exit while
#    comm still reads), a kernel thread, an argv-less process — so each gets a sentinel and cmd is
#    never blank. CLOSE_WRITE is the last event a writer emits, i.e. the newest row for a path is
#    systematically the exit row, so --last replays the RICHEST row for that pid, not the newest.
#    And because a SHORT-LIVED writer has no argv left by the time its event is dequeued — the whole
#    shape a test-forgery sweep hunts — every row also carries `sid=`, the writer's session id: it
#    survives the argv teardown and it is INHERITED, so a consumer that runs its subject under
#    `setsid` attributes by kernel-maintained membership (children included) instead of by substring.
# No fanotify (or no `sudo -n`) → honest exit 2. Never a silent fallback to mtime or inotify.
# orphan-ok: on-demand attribution probe — invoked by a mind or a consumer, deliberately not cronned
# (a standing node-wide writer census is a different, costlier tool; this one is scoped to named files)

import ctypes, errno, os, pwd, re, select, struct, subprocess, sys, tempfile, time

FAN_CLOEXEC        = 0x00000001
FAN_CLASS_NOTIF    = 0x00000000          # notify-only. The *_PERM classes are deliberately absent.
FAN_MARK_ADD       = 0x00000001
FAN_ACCESS         = 0x00000001          # an event mask, not the init flag above that shares its value
FAN_MODIFY         = 0x00000002
FAN_CLOSE_WRITE    = 0x00000008

# The two ends of a sign relation, each with its own event mask and its own row tag. A reader row and
# a writer row must never be mistaken for one another: "someone wrote it" is exactly the claim the
# read side exists NOT to accept as evidence of use.
KINDS = {
    "writer": {"mask": FAN_MODIFY | FAN_CLOSE_WRITE, "tag": "fswriter", "verb": "writes to"},
    "reader": {"mask": FAN_ACCESS,                   "tag": "fsreader", "verb": "reads of"},
}
METADATA_VERSION   = 3
EV_HDR             = struct.Struct("IBHQiI")   # event_len,vers,_,metadata_len,mask,fd,pid  (24 B)

HOME = os.path.expanduser("~")
# MESH_FSWRITER_LOG lets a CONSUMER (mesh-test-forgery) point attribution at its own sink instead of
# reaching for the internal --_log flag — and keeps a sweep's rows out of the durable record a human
# reads with --last. Read here, before the sudo re-exec, so it survives sudo's env scrub as --_log.
LOG_DEFAULT = os.environ.get("MESH_FSWRITER_LOG") or os.path.join(HOME, ".mesh", "fswriter.log")


def usage():
    for line in open(__file__).read().splitlines()[1:]:
        if not line.startswith("#"):
            break
        print(line[2:] if line.startswith("# ") else line[1:])


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


PF_KTHREAD = 0x00200000
# Every way a cmd field can be non-argv. cmd is NEVER rendered blank: "" is legacy rows only.
SENTINELS = ("<exiting>", "<kthread>", "<no-argv>", "<exited>", "")


def one_line(s):
    """A record is ONE LINE, so no field may carry a newline. argv and comm are writer-controlled:
    `python3 -c` / `sh -c` with an embedded program, an awk script, a comm set via prctl. A raw \n
    splits the record in two and NEITHER half matches row_re (the first has no closing quote, the
    second no ts+tag), so the row is not merely ugly — it is INVISIBLE to every query. Measured
    2026-08-18 verifying e494327: a `python3 -c` writer with a multi-line program wrote its named
    row, the regex could not see it, and --last silently fell back to the <exiting> row — the exact
    downgrade e494327 exists to prevent, re-entered through the field instead of the guard. Escape
    rather than strip: the record stays a faithful account of what /proc said."""
    return (s.replace("\\", "\\\\").replace("\n", "\\n")
             .replace("\r", "\\r").replace("\t", "\\t"))


def proc_state(pid):
    """(state_char, is_kthread, has_mm) — the only place the three empty-cmdline facts separate."""
    try:
        st = open("/proc/%d/stat" % pid).read()
    except OSError:
        return "", False, False
    tail = st[st.rfind(")") + 1:].split()          # comm may hold spaces/parens; split past it
    state = tail[0] if tail else ""                # tail[0]=state(3) … tail[6]=flags(9)
    flags = int(tail[6]) if len(tail) > 6 else 0
    try:
        has_mm = any(int(x) for x in open("/proc/%d/statm" % pid).read().split())
    except OSError:
        has_mm = False
    return state, bool(flags & PF_KTHREAD), has_mm


def identify(pid):
    """(comm, cmd, sid) read AT EVENT TIME. An exited writer is unknown, never attributed.

    ORDER IS THE MEASUREMENT HERE, and it is not a micro-optimisation — it is the difference between
    naming the writer and naming nobody. /proc/<pid>/stat is read FIRST, and yields comm AND the
    session from ONE open, because the writer this exists to name is typically a process that appends
    a line and exits: the whole identity window is about two syscalls wide. Measured on this node
    against 16 one-line-and-exit writers, each a cold wake for the listener: stat first → 16/16
    named; the same code reading comm+cmdline before stat → 0/16, every row sid=-1. (fanotify MERGES
    the MODIFY and CLOSE_WRITE of one such writer into a single queued event, so there is no second
    event to learn the identity from — a cache across events was tried and measured to add exactly
    nothing, 15/16 either way, and was removed.) A few percent are still lost under load; that is a
    -1, which attributes NOBODY. It is never the wrong one.
    THE SESSION ID IS THE ATTRIBUTION KEY (mesh-test-forgery): unlike argv it survives mm teardown,
    and unlike the pid it is INHERITED, so it also names a write done by a CHILD of a run — a
    `touch`/`date >>` whose own argv never mentions the tool. -1 means unreadable, never 0 — 0 is a
    real session (kernel threads). A lost race renders -1, which attributes NOBODY; it never
    attributes the wrong one.

    AN EMPTY /proc/<pid>/cmdline IS THREE DIFFERENT FACTS and blank renders them alike. The kernel
    zeroes argv during exit while /proc/<pid>/comm still reads (measured: a zombie reads state=Z,
    comm='bash', cmdline=b'' — the same bytes as kthreadd's), so the LAST event a writer produces,
    CLOSE_WRITE, is systematically the least-identified row. Each fact gets its own sentinel; the
    row stays an honest record of what /proc said at that instant, and the enrichment lives in the
    query (last()), never in a fabricated value here."""
    st, comm, sid = None, "", -1
    try:
        st = open("/proc/%d/stat" % pid).read()          # comm + session, one read, first
    except OSError:
        pass
    if st:
        i, j = st.find("("), st.rfind(")")
        comm = st[i + 1:j] if 0 <= i < j else ""
        tail = st[j + 1:].split()                        # tail[3] = session (field 6)
        try:
            sid = int(tail[3])
        except (IndexError, ValueError):
            sid = -1
    if not comm:
        try:
            comm = open("/proc/%d/comm" % pid).read().strip()
        except OSError:
            return "<exited>", "<exited>", sid
    try:
        cmd = open("/proc/%d/cmdline" % pid, "rb").read().replace(b"\0", b" ").decode(
            "utf-8", "replace").strip()
    except OSError:
        cmd = ""
    if not cmd:
        state, kthread, has_mm = proc_state(pid)
        cmd = ("<kthread>" if kthread else                        # never had an argv
               "<exiting>" if state in ("Z", "X") or not has_mm   # mm torn down: argv already gone
               else "<no-argv>")                                  # alive, holding an empty argv
    return comm or "<exited>", cmd, sid


def listen(paths, window, logpath, kind="writer"):
    """Runs as root only long enough to init+mark, then drops to the invoking uid."""
    spec = KINDS[kind]
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    fd = libc.fanotify_init(FAN_CLASS_NOTIF | FAN_CLOEXEC, os.O_RDONLY)
    if fd < 0:
        e = ctypes.get_errno()
        sys.stderr.write("mesh-fswriter: n/a — fanotify_init: %s\n" % errno.errorcode.get(e, e))
        return 2
    marked = []
    for p in paths:
        rc = libc.fanotify_mark(fd, FAN_MARK_ADD,
                                ctypes.c_uint64(spec["mask"]), -100, p.encode())
        if rc < 0:
            e = ctypes.get_errno()
            sys.stderr.write("mesh-fswriter: cannot mark %s: %s\n" % (p, errno.errorcode.get(e, e)))
        else:
            marked.append(p)
    if not marked:
        sys.stderr.write("mesh-fswriter: n/a — no artifact could be marked\n")
        return 2

    drop_to = os.environ.get("SUDO_UID")
    if os.geteuid() == 0 and drop_to:
        uid, gid = int(drop_to), int(os.environ.get("SUDO_GID", drop_to))
        os.setgroups([])
        os.setgid(gid)
        os.setuid(uid)                      # privilege gone; the fd keeps delivering
        os.environ["HOME"] = pwd.getpwuid(uid).pw_dir

    # READINESS, on stderr, once the marks are set: a consumer that must not miss the first write
    # (mesh-test-forgery arms this around a --test run) needs a handshake, not a sleep — a sleep
    # that is a hair too short drops the very event the consumer exists to catch, and drops it
    # SILENTLY, reading as "nobody wrote it". stderr, because stdout is the attribution stream and
    # its first line is a parseable row by contract. Kernel-queued from this instant, so announcing
    # before the stall/read loop is honest: armed is what the consumer needs, not reading.
    sys.stderr.write("mesh-fswriter: armed %d artifact(s)\n" % len(marked))
    sys.stderr.flush()

    stall = float(os.environ.get("MESH_FSWRITER_TEST_STALL", 0))   # --test only: prove NOTIF blocks
    if stall:                                                      # nothing while we are not reading
        time.sleep(stall)

    log = open(logpath, "a")
    deadline = time.time() + window
    cur, rows = None, 0

    def flush():
        nonlocal cur
        if cur:
            (path, pid, sid, comm, cmd), n, (ts, _mono) = cur
            line = '%s %s pid=%d sid=%d comm=%s n=%d path=%s cmd="%s"' % (
                ts, spec["tag"], pid, sid, one_line(comm), n, one_line(path), one_line(cmd))
            print(line, flush=True)
            log.write(line + "\n")
            log.flush()
            cur = None

    while time.time() < deadline:
        if not select.select([fd], [], [], min(1.0, max(0.05, deadline - time.time())))[0]:
            if cur and time.time() - cur[2][1] > 5:
                flush()
            continue
        buf = os.read(fd, 4096)
        off = 0
        while off + EV_HDR.size <= len(buf):
            ev_len, vers, _mlen, _mask, evfd, pid = EV_HDR.unpack_from(buf, off)
            off += ev_len
            if vers != METADATA_VERSION:
                sys.stderr.write("mesh-fswriter: kernel fanotify metadata v%d != %d — refusing to "
                                 "guess the struct\n" % (vers, METADATA_VERSION))
                return 2
            # IDENTITY FIRST, path second: the writer may be exiting, the event fd cannot. Every
            # syscall spent before reading /proc is a chance for the task to be reaped.
            comm, cmd, sid = identify(pid)  # inside the loop — late is a recycled-pid risk
            path = "<unresolved>"
            if evfd >= 0:
                try:
                    path = os.readlink("/proc/self/fd/%d" % evfd)
                except OSError:
                    pass
                os.close(evfd)
            key = (path, pid, sid, comm, cmd)
            if cur and cur[0] == key:
                cur = (key, cur[1] + 1, cur[2])
            else:
                flush()
                cur = (key, 1, (now(), time.time()))
            rows += 1
    flush()
    if rows == 0:
        # A silent window is a fact about the WINDOW. On the read side that distinction is the whole
        # point — coverage is window/cadence — so the honest qualifier ships IN the line, not in a
        # comment above the code that prints it.
        note = ("" if kind == "writer" else
                " — a window shorter than the consumer's cadence cannot show absence")
        print("%s %s: no %s %d marked artifact(s) in %gs%s"
              % (now(), spec["tag"], spec["verb"], len(marked), window, note), flush=True)
    return 0


def row_re(kind):
    return re.compile(r"^(?P<ts>\S+) " + KINDS[kind]["tag"] +
                      r" pid=(?P<pid>\d+) sid=(?P<sid>-?\d+) "
                      r"comm=(?P<comm>\S+) n=\d+ "
                      r"path=(?P<path>.*) cmd=\"(?P<cmd>.*)\"$")


ROW_RE = row_re("writer")


def last(path, logpath, kind="writer"):
    """Replay the RICHEST row for the last writer's pid, not merely the NEWEST row.

    CLOSE_WRITE is the last event a writer produces and it lands during exit, so the newest row for
    a path is systematically the one whose argv the kernel has already zeroed — while a fully named
    row for the same pid sits a line above. Preferring newest hands a consumer the least-identified
    record; the cmdline is exactly the field that separates `mesh-mag --test` from `mesh-mag`."""
    want = os.path.abspath(path)
    rx = row_re(kind)                      # a writer row can never redeem --last-reader, and vice versa
    rows = []
    try:
        for line in open(logpath):
            m = rx.match(line.rstrip())
            if m and m.group("path") == want:
                rows.append(m)
    except OSError:
        pass
    if not rows:
        if kind == "reader":
            print("mesh-fswriter: no reader ever observed for %s (an unobserved window is not an "
                  "unread artifact — a consumer whose cadence exceeds every observed window leaves "
                  "no row; widen --window or watch across one full cadence before concluding)" % path)
        else:
            print("mesh-fswriter: no writer ever observed for %s (absence of an observation is not a "
                  "claim about the writer)" % path)
        return 2
    newest = best = rows[-1]
    if newest.group("cmd") in SENTINELS:
        for m in rows:                     # same pid, real argv → the same writer, better named
            if m.group("pid") == newest.group("pid") and m.group("cmd") not in SENTINELS:
                best = m
    print(best.string)
    if best is not newest:
        print("# richest row for pid=%s; that writer was last seen %s cmd=\"%s\""
              % (newest.group("pid"), newest.group("ts"), newest.group("cmd")))
    return 0


def rearm(argv):
    """Re-exec under sudo -n so init+mark can succeed; the child drops back immediately."""
    if subprocess.call(["sudo", "-n", "true"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL) != 0:
        sys.stderr.write("mesh-fswriter: n/a — arming needs root and `sudo -n` is unavailable "
                         "(listening does not, but the mark does)\n")
        return 2
    os.execvp("sudo", ["sudo", "-n", "--preserve-env=MESH_FSWRITER_TEST_STALL",
                       sys.executable, os.path.abspath(__file__), "--_armed"] + argv)


def smoke():
    if subprocess.call(["sudo", "-n", "true"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL) != 0:
        print("smoke-test: n/a (arming fanotify needs root; `sudo -n` unavailable here)")
        return 2
    f = 0
    T = tempfile.mkdtemp(prefix="fswriter-test-")
    watched, decoy, logp = T + "/watched", T + "/decoy", T + "/log"
    open(watched, "w").close()
    open(decoy, "w").close()
    env = dict(os.environ, MESH_FSWRITER_TEST_STALL="0")

    def run(window, extra_env=None, writer=None, delay=0.8, mode=None):
        p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--_log", logp]
                             + (["--readers"] if mode == "reader" else [])
                             + ["--window", str(window), watched],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             env=dict(env, **(extra_env or {})), text=True)
        time.sleep(delay)
        w = subprocess.Popen(writer) if writer else None
        out = p.communicate()[0]
        if w:
            w.wait()
        return out, (w.pid if w else None)

    # leg 1 — REAL attribution: the recorded pid must be the writer child's pid, exactly.
    # Falsify: report os.getpid() instead of the event's pid → the pids differ, red.
    out, wpid = run(3, writer=["bash", "-c", "echo hi >> %s" % watched])
    if ("pid=%d " % wpid) not in out or "comm=bash" not in out:
        print("  FAIL: leg1 — event must name the writer pid=%s comm=bash; got:\n%s" % (wpid, out))
        f = 1
    # leg 1b — the row is a parseable record, not a repr. Falsify: print the (ts, mono) tuple the
    # coalescer carries instead of its ts field → the line opens with "('2026-…', 178…)", red.
    if not re.match(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ fswriter pid=\d+ sid=\d+ comm=\S+ n=\d+ "
                    r"path=/",
                    out.strip().splitlines()[0] if out.strip() else ""):
        print("  FAIL: leg1b — attribution row must start with an ISO ts and parseable fields; got:\n"
              "%s" % out)
        f = 1

    # leg 2 — SCOPE: an inode mark must NOT report a write to an unwatched file on the same mount.
    # Falsify: swap FAN_MARK_ADD for FAN_MARK_ADD|FAN_MARK_MOUNT → the decoy shows up, red.
    out, _ = run(3, writer=["bash", "-c", "echo x >> %s" % decoy])
    if "decoy" in out:
        print("  FAIL: leg2 — inode mark leaked a write to an unwatched path on the same mount:\n%s"
              % out)
        f = 1

    # leg 3 — NOTIF BLOCKS NOTHING: with the listener deliberately not reading for 3s, a write to the
    # watched file must still complete immediately. Falsify: a *_PERM class → the writer hangs, red.
    t0 = time.time()
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--_log", logp, "--window", "6",
                      watched], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     env=dict(env, MESH_FSWRITER_TEST_STALL="3"))
    time.sleep(1.2)
    subprocess.call(["bash", "-c", "echo blocked? >> %s" % watched])
    dt = time.time() - t0 - 1.2
    if dt > 1.0:
        print("  FAIL: leg3 — a write took %.1fs while the listener was not reading; "
              "FAN_CLASS_NOTIF must never gate a syscall" % dt)
        f = 1

    # leg 4 — silence: no write in the window → no attribution row, exit 0.
    out, _ = run(3)
    if "pid=" in out:
        print("  FAIL: leg4 — a silent window must record no writer; got:\n%s" % out)
        f = 1

    # leg 5 — --last reads back the attribution, and an unobserved path is exit 2, not a guess.
    p = subprocess.run([sys.executable, os.path.abspath(__file__), "--_log", logp, "--last", watched],
                       capture_output=True, text=True)
    if p.returncode != 0 or "comm=" not in p.stdout:
        print("  FAIL: leg5 — --last must replay the recorded writer (rc=%d out=%s)"
              % (p.returncode, p.stdout))
        f = 1
    p = subprocess.run([sys.executable, os.path.abspath(__file__), "--_log", logp, "--last", decoy],
                       capture_output=True, text=True)
    if p.returncode != 2:
        print("  FAIL: leg5 — --last on a never-observed path must exit 2, got %d" % p.returncode)
        f = 1

    # leg 6 — A DEPARTING WRITER IS NOT A BLANK FIELD. The writer holds the file open past its
    # write, so CLOSE_WRITE lands as it exits — where the kernel has already zeroed
    # /proc/<pid>/cmdline while /proc/<pid>/comm still reads. Two rows for one pid: the MODIFY row
    # fully named, the exit row sentinelled. Falsify: drop the sentinel branch in identify() → the
    # exit row renders cmd="" (an argv-less process and a kernel thread's own bytes), red.
    # (the trailing `true` stops bash tail-exec'ing into sleep — mid-execve the argv is momentarily
    #  empty on a LIVE process, which is a real third state but not the one this leg is aiming at)
    out, wpid = run(6, writer=["bash", "-c", "exec 3>>%s; echo hi >&3; sleep 2; true" % watched])
    mine = [l for l in out.splitlines() if ("pid=%d " % wpid) in l]
    if any('cmd=""' in l for l in out.splitlines()):
        print("  FAIL: leg6 — an empty cmdline was rendered blank; a departing writer, a kernel "
              "thread and an argv-less process must not read alike:\n%s" % out)
        f = 1
    if len(mine) < 2 or not any('cmd="<exit' in l for l in mine):
        print("  FAIL: leg6 — expected a named MODIFY row + a sentinelled exit row for pid=%s; "
              "got:\n%s" % (wpid, out))
        f = 1

    # leg 7 — --last returns the RICHEST row for that pid, not the newest. Falsify: return rows[-1]
    # → the replayed row carries the exit sentinel instead of the argv, red.
    p = subprocess.run([sys.executable, os.path.abspath(__file__), "--_log", logp, "--last", watched],
                       capture_output=True, text=True)
    head = p.stdout.splitlines()[0] if p.stdout.strip() else ""
    if p.returncode != 0 or ("pid=%d " % wpid) not in head or "exec 3>>" not in head:
        print("  FAIL: leg7 — --last must replay the named row for pid=%s, not the exit row "
              "(rc=%d out=%s)" % (wpid, p.returncode, p.stdout))
        f = 1

    # leg 8 — THE HANDSHAKE IS THE SYNCHRONIZATION. A consumer that arms this around someone else's
    # run must know the mark is set before starting them; a fixed sleep that is a hair short drops
    # the first write and reads as "nobody wrote it". Drive it the way mesh-test-forgery does: block
    # on the stderr readiness line, THEN write, and require the write to be attributed.
    # Falsify: delete the announce in listen() → readline() returns only at process exit (bounded by
    # the window), the write lands before the assert can order itself, and the leg goes red.
    p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--_log", logp,
                          "--window", "3", watched], stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, env=env, text=True)
    ready = p.stderr.readline()
    if "armed" not in ready:
        print("  FAIL: leg8 — no readiness line before the consumer's write (got %r); a consumer "
              "can only fall back to a blind sleep" % ready)
        f = 1
    subprocess.call(["bash", "-c", "echo handshook >> %s" % watched])
    out = p.communicate()[0]
    if "handshook" not in open(watched).read() or "pid=" not in out:
        print("  FAIL: leg8 — a write issued strictly after the readiness line was not "
              "attributed:\n%s" % out)
        f = 1

    # leg 9 — MESH_FSWRITER_LOG is the consumer's sink, and taking it must leave the durable record
    # alone. Falsify: read the env after the sudo re-exec (scrubbed) or ignore it → rows land in
    # ~/.mesh/fswriter.log, the size moves, red — and a sweep would be polluting the log --last reads.
    envlog, real = T + "/envlog", LOG_DEFAULT
    real_sz = os.path.getsize(real) if os.path.exists(real) else -1
    p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--window", "3", watched],
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         env=dict(env, MESH_FSWRITER_LOG=envlog))
    p.stderr.readline()
    subprocess.call(["bash", "-c", "echo viaenv >> %s" % watched])
    p.communicate()
    if not os.path.exists(envlog) or "pid=" not in open(envlog).read():
        print("  FAIL: leg9 — MESH_FSWRITER_LOG did not receive the attribution rows")
        f = 1
    now_sz = os.path.getsize(real) if os.path.exists(real) else -1
    if now_sz != real_sz:
        print("  FAIL: leg9 — the durable record %s grew while a consumer sink was set (%s → %s)"
              % (real, real_sz, now_sz))
        f = 1

    # leg 10 — SESSION ATTRIBUTION, AND WHAT IT COSTS TO READ /proc LATE. Eight short-lived writers,
    # each a shell that appends one line and exits at once, SPACED so every one is a COLD WAKE for
    # the listener — a back-to-back burst is drained inside one already-awake read loop and never
    # loses the race, i.e. an unspaced fixture silently stops testing the hard case (it was written
    # unspaced first, and the read-order mutant passed it). Two claims, and only the first is
    # absolute: a recorded sid is NEVER the wrong one, and most of them are recorded.
    # Falsify: read comm+cmdline before stat (the natural order) → 0 of 16 named in the same
    # harness, so this goes red on the majority assert every time.
    sidf = T + "/sid"
    out, _ = run(6, writer=["setsid", "bash", "-c",
                            "echo $$ > %s; for i in 1 2 3 4 5 6 7 8; do "
                            "bash -c 'echo quick >> %s'; sleep 0.3; done" % (sidf, watched)])
    time.sleep(0.3)
    leader = open(sidf).read().strip() if os.path.exists(sidf) else "?"
    sids = re.findall(r" sid=(-?\d+) ", out)
    wrong = [x for x in sids if x not in (leader, "-1")]
    named = [x for x in sids if x == leader]
    if wrong:
        print("  FAIL: leg10 — a row was attributed to session %s; every writer here belongs to %s "
              "and a lost race must render -1, never another session:\n%s" % (wrong[0], leader, out))
        f = 1
    if len(named) < 6:
        print("  FAIL: leg10 — only %d of %d writers were named (need the identity read to win the "
              "race for most of them; stat must be read FIRST):\n%s" % (len(named), len(sids), out))
        f = 1
    if not any(('cmd="<' in l) for l in out.splitlines()):
        print("  FAIL: leg10 — expected the argv to be GONE for this shape (that is why sid exists); "
              "if it is now present, the leg no longer covers the hard case:\n%s" % out)
        f = 1

    # ---- the READ side: the other end of the sign relation (--readers) ----------------------------
    # leg 11 — REAL read attribution. The reader lingers a beat so identify() is not racing an exit;
    # the claim under test is the mask and the tag, not the race leg 10 already covers.
    # Falsify: keep FAN_MODIFY|FAN_CLOSE_WRITE as the reader mask → a read raises nothing, red.
    open(watched, "a").write("payload\n")
    out, rpid = run(4, mode="reader",
                    writer=["bash", "-c", "exec 3<%s; read -r _ <&3; sleep 1" % watched])
    if ("pid=%d " % rpid) not in out or "fsreader " not in out:
        print("  FAIL: leg11 — a real read must be attributed to pid=%s under the fsreader tag; "
              "got:\n%s" % (rpid, out))
        f = 1
    if "fswriter " in out:
        print("  FAIL: leg11 — reader mode emitted a writer-tagged row; the two ends of the relation "
              "must never share a tag:\n%s" % out)
        f = 1

    # leg 12 — MODE SEPARATION, read side: a WRITE must raise nothing while watching for readers.
    # Without this, "a reader was observed" could be satisfied by the producer's own write — exactly
    # the conflation this mode exists to refuse. Falsify: OR FAN_MODIFY into the reader mask → red.
    out, _ = run(3, mode="reader", writer=["bash", "-c", "echo w >> %s" % watched])
    if "pid=" in out:
        print("  FAIL: leg12 — a write was reported while watching for READERS:\n%s" % out)
        f = 1

    # leg 13 — MODE SEPARATION, write side: a READ must raise nothing in the default writer mode.
    # Together with leg 12 this proves the masks genuinely differ; a flag that changes only the row
    # tag would pass one of these and fail the other. Falsify: OR FAN_ACCESS into the writer mask → red.
    out, _ = run(3, writer=["bash", "-c", "exec 3<%s; read -r _ <&3; sleep 0.5" % watched])
    if "pid=" in out:
        print("  FAIL: leg13 — a read was reported while watching for WRITERS:\n%s" % out)
        f = 1

    # leg 14 — A WRITER ROW CANNOT REDEEM --last-reader. Falsify: share one regex across both kinds
    # → the writer row satisfies the reader query, red.
    # THE FIXTURE IS THE LEG. This first read `decoy` straight after leg 2 — where the listener was
    # marked on `watched` and leg 2's whole point is that the decoy write was NOT recorded. So the
    # log held no decoy row of any kind, the query missed for the trivial reason, and the
    # shared-regex mutant sailed through green. A leg asserting "X cannot satisfy Y" is vacuous
    # until X is provably in the log: the row is created here, and asserted present, before the
    # query that must ignore it.
    wp = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--_log", logp,
                           "--window", "3", decoy], stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, env=env, text=True)
    wp.stderr.readline()                                        # armed handshake, never a sleep
    subprocess.call(["bash", "-c", "echo decoywrite >> %s" % decoy])
    wout = wp.communicate()[0]
    if " fswriter pid=" not in wout:
        print("  FAIL: leg14 — fixture: no writer row was recorded for the decoy, so the query below "
              "would miss for the trivial reason and could not detect a shared regex:\n%s" % wout)
        f = 1
    p = subprocess.run([sys.executable, os.path.abspath(__file__), "--_log", logp,
                        "--last-reader", decoy], capture_output=True, text=True)
    # (" fswriter pid=" — the ROW, not the "mesh-fswriter:" that prefixes the tool's own messages)
    if p.returncode != 2 or " fswriter pid=" in p.stdout:
        print("  FAIL: leg14 — --last-reader was satisfied by a WRITER row (rc=%d out=%s)"
              % (p.returncode, p.stdout))
        f = 1
    if "cadence" not in p.stdout:
        print("  FAIL: leg14 — the reader miss must state that an unobserved window is not an unread "
              "artifact; got: %s" % p.stdout)
        f = 1
    p = subprocess.run([sys.executable, os.path.abspath(__file__), "--_log", logp,
                        "--last-reader", watched], capture_output=True, text=True)
    if p.returncode != 0 or "fsreader" not in p.stdout:
        print("  FAIL: leg14 — --last-reader must replay the recorded reader for a read path "
              "(rc=%d out=%s)" % (p.returncode, p.stdout))
        f = 1

    # leg 15 — THE COVERAGE CAVEAT SHIPS IN THE OUTPUT, not in a comment. A silent reader window is a
    # fact about the window; a consumer that renders it as "no reader" rebuilds the too-loose claim.
    # Falsify: drop the note from the silent line → red.
    out, _ = run(3, mode="reader")
    if "cannot show absence" not in out:
        print("  FAIL: leg15 — a silent reader window must qualify itself; got:\n%s" % out)
        f = 1

    # leg 16 — A RECORD IS ONE LINE, and argv is writer-controlled. A `python3 -c` writer with an
    # embedded newline in its program used to split the row in two, and NEITHER half matches row_re
    # (no closing quote / no ts+tag), so the named row went INVISIBLE and --last silently fell back
    # to the <exiting> row — e494327's downgrade re-entered through the field instead of the guard.
    # Falsify: drop one_line() at emit → the log gains an orphan continuation line and --last hands
    # back the sentinel, red on both asserts.
    multi = os.path.join(T, "multi.txt")
    open(multi, "w").close()
    prog = ("import sys, os, time\n"
            "f = open(sys.argv[1], 'a'); f.write('named\\n'); f.close()\n"
            "time.sleep(2)\n"
            "g = open(sys.argv[1], 'a'); g.write('exit\\n'); g.flush(); os._exit(0)\n")
    wp = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--_log", logp,
                           "--window", "9", multi], stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, env=env, text=True)
    wp.stderr.readline()
    mw = subprocess.Popen([sys.executable, "-c", prog, multi])
    mpid = mw.pid
    mw.wait()
    wp.communicate(timeout=20)
    mrows = [l for l in open(logp).read().splitlines() if ("pid=%d " % mpid) in l]
    orphans = [l for l in open(logp).read().splitlines()
               if l and not ROW_RE.match(l) and not row_re("reader").match(l)]
    if len(mrows) < 2:
        print("  FAIL: leg16 — a multi-line argv must still yield BOTH rows for pid=%s intact; "
              "got %d:\n%s" % (mpid, len(mrows), "\n".join(mrows)))
        f = 1
    if orphans:
        print("  FAIL: leg16 — a newline in argv split a record; %d line(s) match no row regex:\n%s"
              % (len(orphans), "\n".join(orphans[:3])))
        f = 1
    p = subprocess.run([sys.executable, os.path.abspath(__file__), "--_log", logp, "--last", multi],
                       capture_output=True, text=True)
    head = p.stdout.splitlines()[0] if p.stdout.strip() else ""
    if p.returncode != 0 or 'cmd="<' in head or "\\n" not in head:
        print("  FAIL: leg16 — --last must replay the NAMED row (argv escaped, not a sentinel) "
              "for pid=%s (rc=%d out=%s)" % (mpid, p.returncode, p.stdout))
        f = 1

    subprocess.call(["rm", "-rf", T])
    if f:
        print("smoke-test: FAIL (see asserts above)")
        return 1
    print("smoke-test: ok (writer pid+comm exact + inode mark does not leak the mount + NOTIF blocks "
          "no write + silent window attributes nobody + --last replays / exits 2 unobserved + a "
          "departing writer is <exiting>, never blank, and --last prefers its named row + a consumer "
          "gets a readiness handshake, not a sleep, its own sink leaves the record alone, and a "
          "one-line-and-exit writer is still attributed by sid where its argv is already gone "
          "+ the READ side names a real reader, the two masks do not leak into each other in either "
          "direction, a writer row cannot redeem --last-reader, and a silent reader window says so)")
    return 0


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        usage()
        return 0
    if argv[0] == "--test":
        return smoke()

    armed = False
    if argv and argv[0] == "--_armed":
        armed, argv = True, argv[1:]
    logpath = LOG_DEFAULT
    window = 30.0
    paths, mode_last, kind = [], None, "writer"
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--window":
            window = float(argv[i + 1]); i += 2
        elif a == "--_log":
            logpath = argv[i + 1]; i += 2
        elif a == "--readers":
            kind = "reader"; i += 1
        elif a == "--last":
            mode_last = argv[i + 1]; i += 2
        elif a == "--last-reader":
            mode_last, kind = argv[i + 1], "reader"; i += 2
        else:
            paths.append(os.path.abspath(a)); i += 1

    if mode_last:
        return last(mode_last, logpath, kind)
    if not paths:
        usage()
        return 64
    missing = [p for p in paths if not os.path.exists(p)]
    if missing:
        sys.stderr.write("mesh-fswriter: n/a — artifact does not exist: %s\n" % ", ".join(missing))
        return 2

    if not armed and os.geteuid() != 0:
        rc = rearm(["--_log", logpath, "--window", str(window)]
                   + (["--readers"] if kind == "reader" else []) + paths)
        return rc if rc else 1          # rearm only returns on failure
    return listen(paths, window, logpath, kind)


if __name__ == "__main__":
    sys.exit(main())
