#!/usr/bin/env bash
# deploy-phone-capture — install the phone roaming-capture loop the moment the phone is reachable,
# then self-quiet. The phone roams (LTE away, WiFi home) and BOTH the WG full-tunnel (Android blocks
# inbound TCP) and direct LAN-TCP (the full-tunnel routes the phone's SYN-ACK out the tunnel → :8022
# times out) are unreachable for SSH. The reliable home channel is ADB-over-WiFi (adbd is a system
# daemon, not subject to the per-app VPN): adb forward a local port → phone:8022. This runs on a
# cadence from the mind node, deploys ONCE, ensures jq, proves a real captured row, wires Termux:Boot,
# and marks done — no operator action, no babysitting. (See memory phone-wg-channel-replace-tailscale.)
#
# Deploys: mesh-phone-capture → phone ~/.local/bin, + a Termux:Boot launch line (single-instance).
#
# reflex-cadence: */5 * * * *
set -u
export PATH="$HOME/.local/bin:$PATH"
LAN="${MESH_PHONE_LAN_IP:-192.168.8.203}"
PORT="${MESH_PHONE_SSH_PORT:-8022}"
ADB_LP="${MESH_PHONE_ADB_LPORT:-8023}"
USER_="${MESH_PHONE_USER:-u0_a380}"
SRC="$HOME/lte-workstation/scripts/mesh-phone-capture"
[ -f "$SRC" ] || SRC="$HOME/.local/bin/mesh-phone-capture"
MARK="$HOME/.mesh/.phone-capture-deployed"
LOG="$HOME/.mesh/phone-deploy.log"
SSHO="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8"
ts(){ date -u +%Y-%m-%dT%H:%MZ; }
mkdir -p "$HOME/.mesh"

# --test must answer regardless of phone reachability (smoke runs run off-LAN)
if [ "${1:-}" = --test ]; then
  [ -f "$SRC" ] && echo "smoke-test: ok (source present, would deploy when phone reachable)" \
                || echo "smoke-test: FAIL (no source mesh-phone-capture)"
  [ -f "$SRC" ]; exit
fi

[ -f "$MARK" ] && exit 0
[ -f "$SRC" ] || { echo "$(ts) no source mesh-phone-capture" >> "$LOG"; exit 0; }

# Pick a transport. ADB first (the home channel under the WG full-tunnel); LAN as a fallback
# (works only if WG is off). Sets TGT (host:port for scp) + an SSH runner.
TGT=""; RUN=""
if command -v adb >/dev/null 2>&1 && adb get-state >/dev/null 2>&1 \
   && adb forward tcp:"$ADB_LP" tcp:"$PORT" >/dev/null 2>&1 \
   && timeout 10 ssh $SSHO -p "$ADB_LP" "${USER_}@127.0.0.1" 'echo ok' >/dev/null 2>&1; then
  TGT="-P $ADB_LP ${USER_}@127.0.0.1"; SPORT="$ADB_LP"; SHOST="127.0.0.1"
elif timeout 12 ssh $SSHO -p "$PORT" "${USER_}@${LAN}" 'echo ok' >/dev/null 2>&1; then
  SPORT="$PORT"; SHOST="$LAN"
else
  exit 0   # phone unreachable (away) — retry next tick, silent
fi
run(){ timeout 90 ssh $SSHO -p "$SPORT" "${USER_}@${SHOST}" "$1"; }

# 1) push the capture tool
if ! scp -P "$SPORT" -o StrictHostKeyChecking=no -o ConnectTimeout=8 "$SRC" "${USER_}@${SHOST}:.local/bin/mesh-phone-capture" >/dev/null 2>&1; then
  echo "$(ts) scp failed (via $SHOST:$SPORT)" >> "$LOG"; exit 0
fi

# 2) ensure jq (the phone has no python3), chmod, wire Termux:Boot (idempotent), prove one real row
out=$(run '
  command -v jq >/dev/null 2>&1 || pkg install -y jq >/dev/null 2>&1
  mkdir -p ~/.local/bin ~/.mesh ~/.termux/boot
  chmod +x ~/.local/bin/mesh-phone-capture
  bf=~/.termux/boot/start.sh
  [ -f "$bf" ] || { printf "#!/data/data/com.termux/files/usr/bin/sh\ntermux-wake-lock\n" > "$bf"; chmod +x "$bf"; }
  if ! grep -q mesh-phone-capture "$bf"; then
    printf "\n# roaming capture loop (single-instance via its own flock)\n%s\n" \
      "(~/.local/bin/mesh-phone-capture >/dev/null 2>&1 &)" >> "$bf"
    echo "boot-wired"
  else echo "boot-already"; fi
  # prove a real captured row NOW (jq parses it — no python on the phone)
  ~/.local/bin/mesh-phone-capture --once >/dev/null 2>&1
  tail -1 ~/.mesh/away-track.log 2>/dev/null | jq -e . >/dev/null 2>&1 && echo "row-ok" || echo "row-FAIL"
  # launch the loop now if not already running (so it works without a reboot)
  pgrep -f "mesh-phone-capture$" >/dev/null 2>&1 || (~/.local/bin/mesh-phone-capture >/dev/null 2>&1 &)
  echo "running:$(pgrep -fc "mesh-phone-capture$" 2>/dev/null)"
' 2>&1)
rc=$?
echo "$(ts) rc=$rc via $SHOST:$SPORT :: $(echo "$out" | tr "\n" " ")" >> "$LOG"

if echo "$out" | grep -q row-ok; then
  touch "$MARK"
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[done] tg: phone roaming-capture DEPLOYED + proven (real row written, Termux:Boot wired, loop running). Always→motion(how-held)+light+battery; away→+GPS+wifi-env+cell. Collect via mesh-phone-collect. :: $(echo "$out" | tr "\n" " ")" >/dev/null 2>&1
else
  echo "$(ts) deploy incomplete (no row-ok) — will retry" >> "$LOG"
fi
