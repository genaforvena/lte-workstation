#!/usr/bin/env bash
# deploy-phone-capture — install the phone roaming-capture loop the moment the phone is reachable
# on the home LAN, then self-quiet. The phone roams (LTE away, WiFi home) and inbound SSH over WG
# is Android-blocked (see memory phone-wg-channel-replace-tailscale), so the ONLY reliable deploy
# window is when the phone is home on WiFi. This runs on a cadence from the mind node, deploys ONCE,
# proves a real captured row, wires Termux:Boot, and marks done — no operator action, no babysitting.
#
# Deploys: mesh-phone-capture → phone ~/.local/bin, + a Termux:Boot launch line (single-instance).
#
# reflex-cadence: */5 * * * *
set -u
export PATH="$HOME/.local/bin:$PATH"
LAN="${MESH_PHONE_LAN_IP:-192.168.8.203}"
PORT="${MESH_PHONE_SSH_PORT:-8022}"
USER_="${MESH_PHONE_USER:-u0_a380}"
SRC="$HOME/lte-workstation/scripts/mesh-phone-capture"
[ -f "$SRC" ] || SRC="$HOME/.local/bin/mesh-phone-capture"
MARK="$HOME/.mesh/.phone-capture-deployed"
LOG="$HOME/.mesh/phone-deploy.log"
SSHO="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8"
ts(){ date -u +%Y-%m-%dT%H:%MZ; }
mkdir -p "$HOME/.mesh"

[ -f "$MARK" ] && exit 0
[ -f "$SRC" ] || { echo "$(ts) no source mesh-phone-capture" >> "$LOG"; exit 0; }

# phone reachable on LAN?  (away on LTE → skip silently, retry next tick)
timeout 12 ssh $SSHO -p "$PORT" "${USER_}@${LAN}" 'echo ok' >/dev/null 2>&1 || exit 0

if [ "${1:-}" = --test ]; then echo "smoke-test: ok (phone on LAN, would deploy)"; exit 0; fi

# 1) push the capture tool
if ! scp -P "$PORT" -o StrictHostKeyChecking=no -o ConnectTimeout=8 "$SRC" "${USER_}@${LAN}:.local/bin/mesh-phone-capture" >/dev/null 2>&1; then
  echo "$(ts) scp failed" >> "$LOG"; exit 0
fi

# 2) chmod, wire Termux:Boot (idempotent), prove one real row
out=$(timeout 90 ssh $SSHO -p "$PORT" "${USER_}@${LAN}" '
  chmod +x ~/.local/bin/mesh-phone-capture
  bf=~/.termux/boot/start.sh
  if [ -f "$bf" ] && ! grep -q mesh-phone-capture "$bf"; then
    printf "\n# roaming capture loop (single-instance via its own flock)\n%s\n" \
      "(~/.local/bin/mesh-phone-capture >/dev/null 2>&1 &)" >> "$bf"
    echo "boot-wired"
  else echo "boot-already"; fi
  # prove a real captured row NOW
  ~/.local/bin/mesh-phone-capture --once >/dev/null 2>&1
  tail -1 ~/.mesh/away-track.log 2>/dev/null | python3 -m json.tool >/dev/null 2>&1 && echo "row-ok" || echo "row-FAIL"
  # launch the loop now if not already running (so it works without a reboot)
  pgrep -f "mesh-phone-capture$" >/dev/null 2>&1 || (~/.local/bin/mesh-phone-capture >/dev/null 2>&1 &)
  echo "running:$(pgrep -fc "mesh-phone-capture" 2>/dev/null)"
' 2>&1)
rc=$?
echo "$(ts) rc=$rc :: $(echo "$out" | tr "\n" " ")" >> "$LOG"

if echo "$out" | grep -q row-ok; then
  touch "$MARK"
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[done] tg: phone roaming-capture DEPLOYED + proven (real row written, Termux:Boot wired, loop running). Away→GPS+wifi-env+cell+light; home→idle. Collect via mesh-phone-collect (LAN pull). :: $(echo "$out" | tr "\n" " ")" >/dev/null 2>&1
else
  echo "$(ts) deploy incomplete (no row-ok) — will retry" >> "$LOG"
fi
