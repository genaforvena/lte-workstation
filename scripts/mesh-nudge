#!/usr/bin/env bash
# mesh-nudge — hardened keystroke injector (consolidated from 7 scattered tool instances).
# Ported from guy-fawxible's gf-nudge (2026-06-23 operator control-plane hardening item #1).
#
#   mesh-nudge [--help] [--raw] <window> <<< "message to inject"
#     <window>    tmux window name (e.g. "genome", "minds"); finds the bottom pane automatically.
#     --raw       inject WITHOUT C-u clear + guard + idle-defer (for reply consoles, plain bash)
#     --help      show usage
#
# Returns:
#   0 = injected (message sent, idle pane accepted it)
#   1 = FAIL (pane not found, tmux error, etc.)
#   2 = n/a (tool not configured, e.g. no tmux session)
#   3 = deferred (agent busy or needs input — message not sent, caller should retry)
#
# Pattern: C-u clear → paste message via base64 (handles embedded newlines) → C-m submit.
# Guard: refuse to inject into a BARE shell (bash|sh|zsh|fish) — can't tell idle from busy.
# Defer: if agent is WORKING or NEEDS-INPUT, skip (let it finish); caller re-tries next tick.
# Raw mode: no clear, no guard, no defer (for human-facing reply consoles).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

usage(){ cat >&2 <<'EOF'
mesh-nudge — hardened keystroke injector (consolidated, ported from guy-fawxible gf-nudge)

  mesh-nudge [--help] [--test] [--raw] <window> <<< "message"
    <window>    tmux window name (e.g. "genome", "minds")
    --raw       no guards (for reply consoles — inject as-is)
    --test      smoke test (no side effects)
    --help      show this

Returns: 0=injected, 1=FAIL, 2=n/a, 3=deferred (busy/needs-input)

Example:
  printf 'build mesh-nudge' | mesh-nudge genome
  mesh-nudge --raw tg-reply <<< "user typed this"
EOF
  exit 2
}

[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v base64 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no base64)"; exit 1; }
  # Test: base64 round-trip
  _rt="$(printf 'test-message' | base64 | base64 -d)"
  [ "$_rt" = "test-message" ] || { echo "smoke-test: FAIL (base64 broken)"; exit 1; }
  echo "smoke-test: ok (tmux+base64+round-trip)"
  exit 0
}

# Defaults
RAW=0; WINDOW=""
while [ $# -gt 0 ]; do
  case "$1" in
    --help) usage ;;
    --raw)  RAW=1; shift ;;
    --)     shift; break ;;
    -*)     echo "mesh-nudge: unknown flag '$1'" >&2; exit 1 ;;
    *)      WINDOW="$1"; shift ;;
  esac
done

[ -n "$WINDOW" ] || { echo "mesh-nudge: missing <window>" >&2; usage; }

# Read message from stdin
msg="$(cat)"
[ -n "$msg" ] || { echo "mesh-nudge: empty message" >&2; exit 1; }

# Get the session name (hostname)
sess="$(hostname 2>/dev/null)"
[ -n "$sess" ] || { echo "mesh-nudge: can't get hostname" >&2; exit 2; }

# Find the tmux session
tmux has-session -t "$sess" 2>/dev/null || { echo "mesh-nudge: no tmux session '$sess'" >&2; exit 2; }

# Find the mind pane (largest pane_top = bottom pane)
# Convention: top (.0) = data, bottom (.1+) = mind. Pick the largest pane_top.
pidx="$(tmux list-panes -t "$sess:$WINDOW" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
[ -n "$pidx" ] || { echo "mesh-nudge: no panes in $sess:$WINDOW" >&2; exit 1; }

pane="$sess:$WINDOW.$pidx"

# Guard (unless --raw): refuse to inject into a bare shell
if [ "$RAW" = 0 ]; then
  cmd="$(tmux list-panes -t "$pane" -F '#{pane_current_command}' 2>/dev/null)"
  case "$cmd" in
    bash|sh|zsh|fish)
      echo "mesh-nudge: $pane is a bare $cmd shell — can't distinguish idle from busy. Use --raw if intentional." >&2
      exit 1
      ;;
  esac

  # Busy-defer: if agent is WORKING or NEEDS-INPUT, skip (don't interrupt)
  if command -v mesh-mind-state >/dev/null 2>&1; then
    mstate="$(tmux send-keys -t "$pane" "" 2>/dev/null && echo "" || true)"  # ping to verify pane exists
    # Call mesh-mind-state if available
    mst="$(tmux send-keys -t "$pane" "" 2>/dev/null; mesh-mind-state --stats "$WINDOW" 2>/dev/null | awk -v w="$WINDOW" '$1==w{print $2; exit}')"
    case "$mst" in
      WORKING|RATE-LIMITED)
        echo "mesh-nudge: $WINDOW is WORKING — deferred" >&2
        exit 3
        ;;
      NEEDS-INPUT)
        echo "mesh-nudge: $WINDOW needs input (gate) — deferred" >&2
        exit 3
        ;;
    esac
  fi
fi

# Inject: C-u clear → base64 paste → C-m submit
# Use base64 to preserve embedded newlines (raw -l can split multi-line messages).
b64="$(printf '%s' "$msg" | base64 | tr -d '\n')"

if [ "$RAW" = 0 ]; then
  # Standard inject: clear + paste + submit
  if tmux send-keys -t "$pane" C-u \; \
       send-keys -t "$pane" "echo $b64 | base64 -d | tmux load-buffer -b mnudge\$\$ -; tmux paste-buffer -p -d -b mnudge\$\$ -t $pane" C-m; then
    sleep 0.2
    exit 0
  else
    echo "mesh-nudge: tmux send-keys failed" >&2
    exit 1
  fi
else
  # Raw inject (reply console): no clear, just paste + submit
  if tmux send-keys -t "$pane" "echo $b64 | base64 -d | tmux load-buffer -b mnudge\$\$ -; tmux paste-buffer -p -d -b mnudge\$\$ -t $pane" C-m; then
    sleep 0.2
    exit 0
  else
    echo "mesh-nudge: tmux send-keys failed" >&2
    exit 1
  fi
fi
