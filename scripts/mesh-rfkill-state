#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# mesh-rfkill-state — live hardware radio-block state from the kernel rfkill bus.
#
# This is a distinct signal from Wi-Fi association/RSSI: it says whether a radio is
# physically or policy blocked. No rfkill entries, unreadable state, or malformed state
# is collapsed into "unblocked"; those cases exit 2.
#
#   mesh-rfkill-state          one live reading
#   mesh-rfkill-state --json   machine-readable reading
#   mesh-rfkill-state --test   fixture parser + real-read gate
set -u

RFKILL_DIR="${MESH_RFKILL_DIR:-/sys/class/rfkill}"

read_states() {
  local d state type name count=0
  shopt -s nullglob
  for d in "$RFKILL_DIR"/rfkill*/; do
    [ -r "$d/state" ] || continue
    state="$(tr -d '[:space:]' <"$d/state" 2>/dev/null || true)"
    case "$state" in 0|1) ;; *) continue ;; esac
    type="unknown"
    name="${d%/}"
    [ -r "$d/type" ] && type="$(tr -d '\n' <"$d/type" 2>/dev/null || true)"
    [ -n "$type" ] || type=unknown
    printf '%s\t%s\t%s\n' "${name##*/}" "$type" "$state"
    count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ]
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)' >&2; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/rfkill0" "$td/rfkill1" "$td/rfkill2"
  printf 'bluetooth\n' >"$td/rfkill0/type"; printf '0\n' >"$td/rfkill0/state"
  printf 'wlan\n' >"$td/rfkill1/type"; printf '1\n' >"$td/rfkill1/state"
  printf 'bad\n' >"$td/rfkill2/type"; printf 'x\n' >"$td/rfkill2/state"
  out="$(MESH_RFKILL_DIR="$td" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $out)" >&2; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"entries":2' || {
    echo "smoke-test: FAIL (invalid fixture was not excluded: $out)" >&2; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"blocked":1' || {
    echo "smoke-test: FAIL (blocked count missing: $out)" >&2; exit 1;
  }
  if MESH_RFKILL_DIR="$td/absent" "$0" >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (absent rfkill bus must exit 2)' >&2; exit 1
  else
    rc=$?
    [ "$rc" = 2 ] || { echo "smoke-test: FAIL (absent bus rc=$rc, want 2)" >&2; exit 1; }
  fi
  live="$(MESH_RFKILL_DIR=/sys/class/rfkill read_states 2>/dev/null || true)"
  [ -n "$live" ] || { echo 'smoke-test: n/a (no readable live rfkill entries)'; exit 2; }
  printf 'smoke-test: ok (fixture invalid-rejection + REAL rfkill read: %s)\n' "$(printf '%s\n' "$live" | tr '\n' ';')"
  exit 0
fi

rows="$(read_states 2>/dev/null || true)"
[ -n "$rows" ] || {
  echo "mesh-rfkill-state: UNKNOWN — no readable rfkill state under $RFKILL_DIR" >&2
  exit 2
}

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
entries="$(printf '%s\n' "$rows" | awk 'END { print NR }')"
blocked="$(printf '%s\n' "$rows" | awk -F '\t' '$3 == 1 { n++ } END { print n+0 }')"
if [ "${1:-}" = --json ]; then
  detail="$(printf '%s\n' "$rows" | awk -F '\t' 'BEGIN { first=1; printf "[" } { if (!first) printf ","; first=0; printf "{\"name\":\"%s\",\"type\":\"%s\",\"blocked\":%s}", $1,$2,($3==1?"true":"false") } END { print "]" }')"
  printf '{"entries":%s,"blocked":%s,"radios":%s,"source":"%s","ts":"%s"}\n' \
    "$entries" "$blocked" "$detail" "$RFKILL_DIR" "$ts"
else
  printf '[rfkill] entries=%s blocked=%s source=%s observed_at=%s\n' "$entries" "$blocked" "$RFKILL_DIR" "$ts"
  printf '%s\n' "$rows" | awk -F '\t' '{ printf "  %s type=%s state=%s\n", $1,$2,($3==1?"blocked":"unblocked") }'
fi
