#!/usr/bin/env bash
# orphan-ok: on-demand live viewport check, pulled by hand/witness/doctor
# mesh-pane-check — a staffed channel's VISIBLE top data pane carries its role.
#
# Capture the current tmux viewport, not scrollback or a fresh `mesh-dash --once`
# re-probe. Missing/empty/fallback/no-lease panes are blind. A generated
# OVERFLOW marker means the role frame hides rows above the viewport even though
# the renderer is alive; that is a coverage HOLD, not a liveness PASS. One brief
# retry distinguishes a clear/paint snapshot from a persistently blank pane.
#
#   mesh-pane-check [--all | --channels "a b c"] [--summary] [--session NAME] | --test
#
# Channels default to MESH_MIND_CHANNELS (comma/colon/space-separated); no
# channels on a compute-only node is PASS. --all discovers live two-pane role
# windows plus witness's one data pane. --summary prints visible/total and the
# held roles from this same check. Session defaults to hostname; pane index 0.
#
# Exit: 0 all visible · 1 missing/empty/fallback/stale/overflow · 2 usage/skip.
set -uo pipefail
SESS="${MESH_TMUX_SESSION:-$(hostname)}"
ROLES="${MESH_MIND_CHANNELS:-}"

check_pane(){
  local role="$1" sess="$2" cap hidden
  cap="$(tmux capture-pane -t "$sess:$role.0" -p 2>&1)" || { echo "HOLD pane-missing: $role (no window $sess:$role.0 — staffed with nothing to see)"; return 1; }
  # A dash clears then paints its prepared frame; one capture can land inside that
  # short blank interval. Re-read before classifying empty/no-lease, never certify
  # the previous scrollback frame as live.
  if [ -z "$(printf '%s' "$cap" | grep -vE '^[[:space:]]*$')" ] || ! grep -qF 'pane live' <<<"$cap"; then
    sleep "${MESH_PANE_CHECK_RETRY_S:-0.3}"
    cap="$(tmux capture-pane -t "$sess:$role.0" -p 2>&1)" \
      || { echo "HOLD pane-missing: $role (no window $sess:$role.0 — staffed with nothing to see)"; return 1; }
  fi
  [ -n "$(printf '%s' "$cap" | grep -vE '^[[:space:]]*$')" ] || { echo "HOLD pane-empty: $role"; return 1; }
  # Fallback card: the generic node card with no role section. Role panes carry
  # '-- ' section headers; the card fallback carries neither those nor the role.
  if ! grep -q -- '-- ' <<<"$cap" && ! grep -qi -- "$role" <<<"$cap"; then
    echo "HOLD pane-fallback: $role renders generic card, not role content"
    return 1
  fi
  printf '%s\n' "$cap" | grep -qF 'pane live' || { echo "HOLD pane-stale: $role (top pane has no liveness lease)"; return 1; }
  hidden="$(printf '%s\n' "$cap" | sed -nE 's/^-- ⚠ OVERFLOW: [0-9]+ rows @[0-9]+c into [0-9]+ — ([1-9][0-9]*) hidden ABOVE .*$/\1/p')"
  if [ -n "$hidden" ]; then
    echo "HOLD pane-overflow: $role hides $hidden row(s) above its visible viewport"
    return 1
  fi
  echo "PASS: $role"
  return 0
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  mkdir -p "$d/bin"
  cat > "$d/bin/tmux" <<'EOF'
#!/usr/bin/env bash
# stub: capture-pane -t SESS:ROLE.0 ... ; windows: good (sections+lease), stale (sections only), empty, fallback, others missing
[[ "$*" == *"has-session"* ]] && exit 0
[[ "$*" == *"good.0"* ]] && { echo "-- ALLOCATION --"; echo "spend pace ok"; echo "-- pane live 2026-09-21T00:00:00Z · 30s · ticks every frame --"; exit 0; }
[[ "$*" == *"overflow.0"* ]] && { echo "-- ALLOCATION --"; echo "-- ⚠ OVERFLOW: 40 rows @100c into 20 — 22 hidden ABOVE (trim role / grow pane) --"; echo "-- pane live 2026-09-21T00:00:00Z · 30s · ticks every frame --"; exit 0; }
[[ "$*" == *"transient.0"* ]] && { if [ ! -e "$MESH_PANE_CHECK_TEST_STATE" ]; then : >"$MESH_PANE_CHECK_TEST_STATE"; exit 0; fi; echo "-- ALLOCATION --"; echo "-- pane live 2026-09-21T00:00:00Z · 30s · ticks every frame --"; exit 0; }
[[ "$*" == *"stale.0"* ]] && { echo "-- ALLOCATION --"; echo "spend pace ok"; exit 0; }
[[ "$*" == *"empty.0"* ]] && { exit 0; }
[[ "$*" == *"fallback.0"* ]] && { echo "mesh-home node card"; echo "uptime 3 days"; exit 0; }
echo "can't find pane" >&2; exit 1
EOF
  chmod +x "$d/bin/tmux"
  pass=0; fail=0
  out="$(PATH="$d/bin:$PATH" check_pane good testsess 2>&1)"; { [ $? = 0 ] && grep -q '^PASS' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: live pane must PASS: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane overflow testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-overflow <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: overflowing role pane must HOLD: $out"; fail=$((fail+1)); }
  out="$(MESH_PANE_CHECK_TEST_STATE="$d/transient" PATH="$d/bin:$PATH" check_pane transient testsess 2>&1)"; { [ $? = 0 ] && grep -q '^PASS' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: an in-progress repaint must be retried before declaring the pane blank: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane stale testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-stale <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: pane without liveness lease must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane empty testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-empty <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: empty must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane fallback testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-fallback <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: fallback must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane nosuch testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-missing <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: missing must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" "$0" --summary --channels 'good overflow' --session testsess 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'pane=1/2 visible · HOLD:overflow' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: coverage summary lost the healthy denominator or overflow role: $out"; fail=$((fail+1)); }
  echo "mesh-pane-check --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

ALL=0; SUMMARY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --channels) ROLES="$2"; shift 2;;
    --all) ALL=1; shift;;
    --summary) SUMMARY=1; shift;;
    --session) SESS="$2"; shift 2;;
    -h|--help) sed -n '2,/^[^#]/p' "$0" | sed 's/^# \?//p'; exit 0;;
    --*) echo "mesh-pane-check: unknown flag $1" >&2; exit 2;;
    *) echo "mesh-pane-check: usage: mesh-pane-check [--all | --channels ...] [--summary] [--session ...] | --test" >&2; exit 2;;
  esac
done
command -v tmux >/dev/null 2>&1 || { echo "SKIP no tmux — pane-blind, not pane-ok" >&2; exit 2; }
tmux has-session -t "$SESS" 2>/dev/null || { echo "HOLD pane-blind: no tmux session $SESS (restore first — a node without its session is blind)" ; exit 1; }
if [ "$ALL" = 1 ]; then
  windows="$(tmux list-windows -t "$SESS" -F '#{window_name} #{window_panes}' 2>/dev/null)" \
    || { echo "HOLD pane-blind: cannot enumerate $SESS windows"; exit 1; }
  ROLES=""
  while read -r win panes; do
    case "$panes" in ''|*[!0-9]*) continue;; esac
    [ "$panes" -ge 2 ] || [ "$win" = witness ] || continue
    ROLES="$ROLES $win"
  done <<<"$windows"
fi
ROLES="$(tr ',:' '  ' <<<"$ROLES")"
[ -n "$(printf '%s' "$ROLES" | tr -d ' ')" ] || { [ "$SUMMARY" = 1 ] && echo "pane=0/0 visible (no staffed channels)" || echo "pane-check: clean (no staffed channels on this node)"; exit 0; }
overall=0; total=0; visible=0; held=""
for r in $ROLES; do
  result="$(check_pane "$r" "$SESS")"; rc=$?
  total=$((total+1))
  if [ "$rc" = 0 ]; then
    visible=$((visible+1))
  else
    overall=1
    held="${held:+$held,}$r"
  fi
  [ "$SUMMARY" = 1 ] || printf '%s\n' "$result"
done
if [ "$SUMMARY" = 1 ]; then
  printf 'pane=%s/%s visible' "$visible" "$total"
  [ "$overall" = 0 ] || printf ' · HOLD:%s' "$held"
  printf '\n'
elif [ "$overall" = 0 ]; then
  echo "pane-check: clean (all staffed panes render role content)"
fi
exit "$overall"
