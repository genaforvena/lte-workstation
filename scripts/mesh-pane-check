#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-pane-check — every staffed channel's top data pane carries its role.
#
# Reads the LIVE tmux data panes (not a re-render: `mesh-dash <role> --once`
# re-probes and takes minutes; the pane is what the mind actually sees).
# A staffed window whose pane is missing, empty, or fallen back to the generic
# node card is BLIND — the wake failure mode — no matter what the probes say.
#
#   mesh-pane-check [--channels "a b c"] [--session NAME] | --test
#
# Channels default to MESH_MIND_CHANNELS (comma/colon/space-separated); no
# channels (compute-only node) is PASS, not a finding. Session defaults to
# `hostname` (the shared mesh session). Pane = window <role>, pane index 0.
#
# Exit: 0 all panes live · 1 a pane is missing/empty/fallback · 2 usage/skip.
set -uo pipefail
SESS="${MESH_TMUX_SESSION:-$(hostname)}"
ROLES="${MESH_MIND_CHANNELS:-}"

check_pane(){
  local role="$1" sess="$2" cap
  cap="$(tmux capture-pane -t "$sess:$role.0" -p -S -60 2>&1)" || { echo "HOLD pane-missing: $role (no window $sess:$role.0 — staffed with nothing to see)"; return 1; }
  [ -n "$(printf '%s' "$cap" | grep -vE '^[[:space:]]*$')" ] || { echo "HOLD pane-empty: $role"; return 1; }
  # Fallback card: the generic node card with no role section. Role panes carry
  # '-- ' section headers; the card fallback carries neither those nor the role.
  if ! grep -q -- '-- ' <<<"$cap" && ! grep -qi -- "$role" <<<"$cap"; then
    echo "HOLD pane-fallback: $role renders generic card, not role content"
    return 1
  fi
  printf '%s\n' "$cap" | grep -qF 'pane live' || { echo "HOLD pane-stale: $role (top pane has no liveness lease)"; return 1; }
  echo "PASS: $role"
  return 0
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  mkdir -p "$d/bin"
  cat > "$d/bin/tmux" <<'EOF'
#!/usr/bin/env bash
# stub: capture-pane -t SESS:ROLE.0 ... ; windows: good (sections+lease), stale (sections only), empty, fallback, others missing
[[ "$*" == *"good.0"* ]] && { echo "-- ALLOCATION --"; echo "spend pace ok"; echo "-- pane live 2026-09-21T00:00:00Z · 30s · ticks every frame --"; exit 0; }
[[ "$*" == *"stale.0"* ]] && { echo "-- ALLOCATION --"; echo "spend pace ok"; exit 0; }
[[ "$*" == *"empty.0"* ]] && { exit 0; }
[[ "$*" == *"fallback.0"* ]] && { echo "mesh-home node card"; echo "uptime 3 days"; exit 0; }
echo "can't find pane" >&2; exit 1
EOF
  chmod +x "$d/bin/tmux"
  pass=0; fail=0
  out="$(PATH="$d/bin:$PATH" check_pane good testsess 2>&1)"; { [ $? = 0 ] && grep -q '^PASS' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: live pane must PASS: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane stale testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-stale <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: pane without liveness lease must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane empty testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-empty <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: empty must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane fallback testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-fallback <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: fallback must HOLD: $out"; fail=$((fail+1)); }
  out="$(PATH="$d/bin:$PATH" check_pane nosuch testsess 2>&1)"; { [ $? = 1 ] && grep -q pane-missing <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: missing must HOLD: $out"; fail=$((fail+1)); }
  echo "mesh-pane-check --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --channels) ROLES="$2"; shift 2;;
    --session) SESS="$2"; shift 2;;
    -h|--help) sed -n '2,/^[^#]/p' "$0" | sed 's/^# \?//p'; exit 0;;
    --*) echo "mesh-pane-check: unknown flag $1" >&2; exit 2;;
    *) echo "mesh-pane-check: usage: mesh-pane-check [--channels ...] [--session ...] | --test" >&2; exit 2;;
  esac
done
command -v tmux >/dev/null 2>&1 || { echo "SKIP no tmux — pane-blind, not pane-ok" >&2; exit 2; }
tmux has-session -t "$SESS" 2>/dev/null || { echo "HOLD pane-blind: no tmux session $SESS (restore first — a node without its session is blind)" ; exit 1; }
ROLES="$(tr ',:' '  ' <<<"$ROLES")"
[ -n "$(printf '%s' "$ROLES" | tr -d ' ')" ] || { echo "pane-check: clean (no staffed channels on this node)"; exit 0; }
overall=0
for r in $ROLES; do check_pane "$r" "$SESS" || overall=1; done
[ "$overall" = 0 ] && echo "pane-check: clean (all staffed panes render role content)"
exit "$overall"
