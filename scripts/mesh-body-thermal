#!/usr/bin/env bash
# orphan-ok: on-demand thermal probe — the body phone's battery temperature is a genuinely-new
#   modality (thermal state) no existing sense interprets: mesh-body-power reads percentage/status
#   only and the raw °C flows into sensors.log uninterpreted (mesh-sensor-log). Operator wires a
#   scheduled thermal axis by replacing this stamp with `# reflex-cadence: <5-field cron>` and
#   running `mesh-autowire`; born on-demand so no unreviewed SSH-every-cycle reflex lands.
# mesh-body-thermal — the body phone's THERMAL sense.
# Reads the phone's battery temperature (termux-battery-status, °C) and classifies it into a
# thermal state with hysteresis, fused with charge state to separate charging-heat from use-heat.
#
# WHY THIS IS NEW: thermal is a modality none of motion/light/prox/mag/gyro give. A warm phone
# (unplugged) = in-pocket body heat / in-hand / recent heavy use; a cool phone = idle on a
# surface; a hot phone (esp. charging) = charging heat / heavy load / direct sun. No tool
# interprets temperature today (verified: mesh-body-power parses %/status only).
#
# Levels (hysteresis dead-bands prevent boundary flapping). The CALIBRATION lives in the uxn
# threshold-ledger row `body-thermal` (gates-as-data, deci-°C) — resolved below ledger > inline,
# printable via --consts; this header just names the shape (an earlier copy of these numbers here
# drifted from the code — the ledger row is now the one source of truth):
#   snap (no prev): COOL < s1 · NORMAL <= s2 · WARM <= s3 · HOT above   (defaults 28/33/37 °C)
#   Hysteresis: COOL→NORMAL @>u1 (back @<d1); NORMAL→WARM @>u2 (back @<d2); WARM→HOT @>u3 (back @<d3)
#   (defaults: u1=30 d1=26 · u2=34 d2=32 · u3=38 d3=36 °C)
# Charge context disambiguates WARM/HOT: charging warmth is expected hardware heat; unplugged
# warmth is the body/usage signal (the interesting one — pocket/hand/use).
#
#   mesh-body-thermal           one thermal line
#   mesh-body-thermal --edge    emit only on state change (for cron/stream wiring)
#   mesh-body-thermal --json    machine-readable {level, temp_c, charging, plugged, status, percentage, prev, ts}
#   mesh-body-thermal --test    classify fixtures (offline) + reachability gate (exit 2 = n/a)
#
# Read-only. Honest-organ: phone-unreachable OR a battery read with no temperature → exit 2,
# never a fabricated thermal state (an unread thermometer is NOT "NORMAL").
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
STATE="$HOME/.mesh/.body-thermal-state"
OFFLINEFILE="$HOME/.mesh/.body-thermal-offline"

# Calibrated edges resolve ledger (uxn threshold-ledger row body-thermal, deci-°C) > inline
# fallback — same values; a missing genome checkout degrades to the old behaviour, never a
# broken sense. Recalibrating an edge is a diff on scripts/uxn/threshold-ledger.
_ledger_const() { # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
BT_U1="$(_ledger_const body-thermal u1 300)"; BT_D1="$(_ledger_const body-thermal d1 260)"
BT_U2="$(_ledger_const body-thermal u2 340)"; BT_D2="$(_ledger_const body-thermal d2 320)"
BT_U3="$(_ledger_const body-thermal u3 380)"; BT_D3="$(_ledger_const body-thermal d3 360)"
BT_S1="$(_ledger_const body-thermal s1 280)"; BT_S2="$(_ledger_const body-thermal s2 330)"
BT_S3="$(_ledger_const body-thermal s3 370)"

# classify_thermal <temp_c> <prev_level> → echoes COOL|NORMAL|WARM|HOT (pure, offline-testable).
# Hysteresis dead-bands (bash can't compare floats → awk gate per branch; edges deci-°C, t*10).
_bt(){ awk -v t="$1" -v e="$3" "BEGIN{exit !(t*10 $2 e)}"; }
classify_thermal() {
  local t="$1" p="$2"
  case "$p" in
    COOL)   _bt "$t" '>' "$BT_U1" && { echo NORMAL; return; }; echo COOL;;
    NORMAL) _bt "$t" '<' "$BT_D1" && { echo COOL;   return; }
            _bt "$t" '>' "$BT_U2" && { echo WARM;   return; }; echo NORMAL;;
    WARM)   _bt "$t" '<' "$BT_D2" && { echo NORMAL; return; }
            _bt "$t" '>' "$BT_U3" && { echo HOT;    return; }; echo WARM;;
    HOT)    _bt "$t" '<' "$BT_D3" && { echo WARM;   return; }; echo HOT;;
    *)      if   _bt "$t" '<'  "$BT_S1"; then echo COOL
            elif _bt "$t" '<=' "$BT_S2"; then echo NORMAL
            elif _bt "$t" '<=' "$BT_S3"; then echo WARM
            else echo HOT; fi;;
  esac
}

# observable artifact of the resolution (ledger > inline), same path the classifier takes
if [ "${1:-}" = --consts ]; then
  echo "u1=$BT_U1 d1=$BT_D1 u2=$BT_U2 d2=$BT_D2 u3=$BT_U3 d3=$BT_D3 s1=$BT_S1 s2=$BT_S2 s3=$BT_S3"
  exit 0
fi

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  _f=0
  # --- classify_thermal() fixtures (OFFLINE, phone-independent — the hysteresis contract) ---
  # Snap (first-run, no hysteresis):
  [ "$(classify_thermal 20 UNKNOWN)" = COOL   ] || { echo "  FAIL: 20°C snap → COOL"; _f=1; }
  [ "$(classify_thermal 28 UNKNOWN)" = NORMAL ] || { echo "  FAIL: 28°C snap → NORMAL"; _f=1; }
  [ "$(classify_thermal 33 UNKNOWN)" = NORMAL ] || { echo "  FAIL: 33°C snap → NORMAL"; _f=1; }
  [ "$(classify_thermal 34 UNKNOWN)" = WARM   ] || { echo "  FAIL: 34°C snap → WARM"; _f=1; }
  [ "$(classify_thermal 37 UNKNOWN)" = WARM   ] || { echo "  FAIL: 37°C snap → WARM"; _f=1; }
  [ "$(classify_thermal 38 UNKNOWN)" = HOT    ] || { echo "  FAIL: 38°C snap → HOT"; _f=1; }
  # COOL hysteresis: must rise above 30 to leave
  [ "$(classify_thermal 30 COOL)" = COOL   ] || { echo "  FAIL: 30°C COOL → stays COOL (not >30)"; _f=1; }
  [ "$(classify_thermal 31 COOL)" = NORMAL ] || { echo "  FAIL: 31°C COOL → NORMAL (rose >30)"; _f=1; }
  # NORMAL hysteresis: fall <26 → COOL; rise >34 → WARM
  [ "$(classify_thermal 25 NORMAL)" = COOL ] || { echo "  FAIL: 25°C NORMAL → COOL"; _f=1; }
  [ "$(classify_thermal 33 NORMAL)" = NORMAL ] || { echo "  FAIL: 33°C NORMAL → stays NORMAL"; _f=1; }
  [ "$(classify_thermal 35 NORMAL)" = WARM ] || { echo "  FAIL: 35°C NORMAL → WARM"; _f=1; }
  # WARM hysteresis: fall <32 → NORMAL; rise >38 → HOT
  [ "$(classify_thermal 31 WARM)" = NORMAL ] || { echo "  FAIL: 31°C WARM → NORMAL"; _f=1; }
  [ "$(classify_thermal 37 WARM)" = WARM   ] || { echo "  FAIL: 37°C WARM → stays WARM"; _f=1; }
  [ "$(classify_thermal 39 WARM)" = HOT    ] || { echo "  FAIL: 39°C WARM → HOT"; _f=1; }
  # HOT hysteresis: must fall below 36 to leave
  [ "$(classify_thermal 36 HOT)" = HOT ] || { echo "  FAIL: 36°C HOT → stays HOT (not <36)"; _f=1; }
  [ "$(classify_thermal 35 HOT)" = WARM ] || { echo "  FAIL: 35°C HOT → WARM (fell <36)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_thermal hysteresis)"; exit 1; }
  # --- ledger resolution (ledger > inline): --consts is the observable artifact ---
  _led="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn/threshold-ledger"
  if [ -f "$_led" ]; then
    _tmp="$(mktemp -d)"; trap 'rm -rf "$_tmp"' EXIT
    sed 's/u1=300/u1=123/' "$_led" > "$_tmp/recal"
    _c="$(MESH_THRESHOLD_LEDGER="$_tmp/recal" bash "$0" --consts)"
    case "$_c" in u1=123\ *) :;; *) echo "  FAIL: recalibrated ledger (u1=123) must reach --consts, got '$_c'"; _f=1;; esac
    _c="$(MESH_THRESHOLD_LEDGER="$_tmp/absent" bash "$0" --consts)"
    case "$_c" in u1=300\ *) :;; *) echo "  FAIL: absent ledger must fall back inline (u1=300), got '$_c'"; _f=1;; esac
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (ledger resolution)"; exit 1; }
  fi
  # --- reachability gate (real SSH probe, not mesh-phone-ip's cached IP) ---
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  if command -v phone_reachable_ip >/dev/null 2>&1; then
    phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — thermal unavailable); classify-logic ok"; exit 2; }
  else
    _pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable); classify-logic ok"; exit 2; }
    timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_pip" 'command -v termux-battery-status' </dev/null >/dev/null 2>&1 \
      || { echo "smoke-test: n/a (phone unreachable or no termux-battery-status); classify-logic ok"; exit 2; }
  fi
  echo "smoke-test: ok (classify: 16 hysteresis assertions + reachability)"; exit 0
fi

EDGE=0; JSON=0
for a in "$@"; do case "$a" in --edge) EDGE=1;; --json) JSON=1;; esac; done

# ---- Resolve phone + read battery (termux-battery-status) ----
pip="$(mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read thermal (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

j="$(timeout 15 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" 'termux-battery-status' </dev/null 2>/dev/null)"
[ -n "$j" ] || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone thermal SSH failed (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}

# ---- Parse: temperature (°C) + plugged + status + percentage ----
parsed="$(printf '%s' "$j" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
temp = d.get("temperature")
plugged = d.get("plugged", "UNKNOWN")
status = d.get("status", "UNKNOWN")
pct = d.get("percentage")
print("\t".join(str(x) if x is not None else "" for x in (temp, plugged, status, pct)))
' 2>/dev/null)" || { echo "thermal parse failed — not a battery JSON (not an alarm)" >&2; exit 2; }
[ -n "$parsed" ] || { echo "thermal parse failed (not an alarm)" >&2; exit 2; }
temp="${parsed%%$'\t'*}"; rest="${parsed#*$'\t'}"
plugged="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
status="${rest%%$'\t'*}"; pct="${rest#*$'\t'}"
# HONEST: no temperature in the read → cannot assess, NEVER a faked NORMAL
[ -n "$temp" ] || { echo "battery read had no temperature — thermal n/a (not faked)" >&2; exit 2; }

prev="$(cat "$STATE" 2>/dev/null || echo UNKNOWN)"
level="$(classify_thermal "$temp" "$prev")"
charging=0
[ "$plugged" != "UNPLUGGED" ] && charging=1

# ---- Charge-aware gloss (charging warmth = expected hardware heat; unplugged = body/usage) ----
case "$level" in
  COOL)   gloss="cool — cold surface / cold environment";;
  NORMAL) gloss="ambient idle";;
  WARM)   if [ "$charging" = 1 ]; then gloss="charging warmth (expected hardware heat)";
          else gloss="in-pocket body heat / in-hand / recent use"; fi;;
  HOT)    if [ "$charging" = 1 ]; then gloss="charging hard / heavy load (thermal stress)";
          else gloss="heavy use / direct sun (unplugged hot — unusual)"; fi;;
  *)      gloss="unclassified thermal state";;
esac

# Write STATE on EVERY successful run (unconditional → mtime = ran-live, not change-gated).
printf '%s\n' "$level" > "$STATE"
TS="$(date -u +%Y-%m-%dT%H:%MZ)"
charge_s="$([ "$charging" = 1 ] && echo charging || echo unplugged)"

if [ "$JSON" = 1 ]; then
  printf '{"level":"%s","temp_c":%s,"charging":%s,"plugged":"%s","status":"%s","percentage":"%s","prev":"%s","ts":"%s"}\n' \
    "$level" "$temp" "$([ "$charging" = 1 ] && echo true || echo false)" "$plugged" "$status" "${pct:-}" "${prev:-UNKNOWN}" "$TS"
  exit 0
fi
if [ "$EDGE" = 1 ]; then
  [ "$level" = "$prev" ] && exit 0
fi
printf '[body-thermal-%s] %s — %s°C %s/%s (%s%%) — %s\n' \
  "${level,,}" "$level" "$temp" "$charge_s" "${status,,}" "${pct:-?}" "$gloss"
