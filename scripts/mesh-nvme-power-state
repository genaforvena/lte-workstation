#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# reflex-args: --edge
# mesh-nvme-power-state — physical NVMe runtime-power sense.
# Reads each controller's kernel runtime-PM status. This is a storage-activity/power-state
# signal, distinct from NVMe temperature and from aggregate I/O counters: ACTIVE means the
# controller is currently powered for work, SUSPENDED means runtime PM has put it to sleep.
#
# Honest contract: no NVMe controller with a valid readable runtime_status -> exit 2; no
# synthetic quiet/idle default is emitted. A mixed fleet remains MIXED rather than being
# collapsed to the worst member.
#
#   mesh-nvme-power-state          one live reading
#   mesh-nvme-power-state --json   machine-readable reading
#   mesh-nvme-power-state --edge   emit only when the verdict changes
#   mesh-nvme-power-state --test   fixtures plus a real sysfs read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_NVME_POWER_STATE:-$MESH/.nvme-power-state}"
ROOT="${MESH_NVME_POWER_ROOT:-/sys/class/nvme}"

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/nvme0/device/power" "$td/nvme1/device/power"
  printf 'active\n' > "$td/nvme0/device/power/runtime_status"
  printf 'suspended\n' > "$td/nvme1/device/power/runtime_status"
  fixture="$(MESH_NVME_POWER_ROOT="$td" MESH_DIR="$td/mesh" MESH_TEST_SANDBOX=1 "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"verdict":"MIXED"' || { echo "smoke-test: FAIL (fixture verdict: $fixture)"; exit 1; }
  printf '%s\n' "$fixture" | grep -q '"controllers":2' || { echo "smoke-test: FAIL (fixture count: $fixture)"; exit 1; }
  empty="$td/empty"; mkdir -p "$empty"
  MESH_NVME_POWER_ROOT="$empty" MESH_DIR="$td/empty-mesh" "$0" --json >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (empty root must exit 2, got $rc)"; exit 1; }

  live="$(MESH_TEST_SANDBOX=1 "$0" --json 2>/dev/null)"
  lrc=$?
  if [ "$lrc" -eq 2 ]; then
    echo "smoke-test: n/a (no live NVMe runtime_status source on this node)"
    exit 2
  fi
  [ "$lrc" -eq 0 ] || { echo "smoke-test: FAIL (live read exit $lrc)"; exit 1; }
  printf '%s\n' "$live" | grep -Eq '"verdict":"(ACTIVE|SUSPENDED|MIXED)"' || {
    echo "smoke-test: FAIL (live verdict missing: $live)"; exit 1;
  }
  printf '%s\n' "$live" | grep -Eq '"controllers":[1-9][0-9]*' || {
    echo "smoke-test: FAIL (live controller count missing: $live)"; exit 1;
  }
  echo "smoke-test: ok (fixture MIXED + empty-root exit-2 + real NVMe runtime-PM read)"
  exit 0
fi

json=0
edge=0
for arg in "$@"; do
  case "$arg" in --json) json=1;; --edge) edge=1;; esac
done

active=0
suspended=0
shopt -s nullglob
for d in "$ROOT"/nvme*/device/power; do
  [ -r "$d/runtime_status" ] || continue
  status="$(tr -d '[:space:]' < "$d/runtime_status" 2>/dev/null)"
  case "$status" in
    active) active=$((active + 1));;
    suspended) suspended=$((suspended + 1));;
  esac
done
shopt -u nullglob
controllers=$((active + suspended))
[ "$controllers" -gt 0 ] || {
  echo "nvme-power-state: UNREACHABLE — no NVMe runtime_status source" >&2
  exit 2
}

if [ "$active" -gt 0 ] && [ "$suspended" -gt 0 ]; then verdict=MIXED
elif [ "$active" -gt 0 ]; then verdict=ACTIVE
else verdict=SUSPENDED
fi
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then STATE="${TMPDIR:-/tmp}/.nvme-power-state.sandbox.$$"; fi
prev="$(cut -d'|' -f1 "$STATE" 2>/dev/null || true)"
printf '%s|%s|%s|%s|%s\n' "$verdict" "$controllers" "$active" "$suspended" "$ts" > "$STATE"
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true

if [ "$json" -eq 1 ]; then
  printf '{"verdict":"%s","controllers":%d,"active":%d,"suspended":%d,"ts":"%s"}\n' \
    "$verdict" "$controllers" "$active" "$suspended" "$ts"
elif [ "$edge" -eq 1 ] && [ "$prev" = "$verdict" ]; then
  exit 0
else
  printf '[nvme-power-state] %s — controllers=%d active=%d suspended=%d @ %s %s\n' \
    "$verdict" "$controllers" "$active" "$suspended" "$(hostname)" "$ts"
fi
