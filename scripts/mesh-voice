#!/usr/bin/env bash
# mesh-voice — a dedicated voice agent in its OWN tmux session. Talk to the mesh; the conversation
# is synced to the chat room (text) AND spoken (voice). The mind is HEADLESS opencode (free) with
# conversation memory — reliable, no TUI scraping.
#
# Session 'voice':
#   chat  — live tail of the conversation (text + voice, synced)
#   ear   — mesh-converse: your voice -> headless mind (with memory) -> spoken reply, mirrored to chat
#
#   mesh-voice          start it (or report if running)
#   mesh-voice --stop   stop the voice session
set -uo pipefail
SES=voice
MIND="${VOICE_MIND:-opencode}"          # free model w/ memory; VOICE_MIND=claude to use Claude (costs quota)

case "${1:-}" in
  --test)
    # SAFE smoke: must NOT pkill mesh-converse or start a session. Added after an audit found
    # --test fell through to the pkill+tmux-new-session path — a smoke-sweep would kill the live
    # voice agent / spawn one. Deps-only check + dry-run session variable validation.
    command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
    [ -x "$HOME/.local/bin/mesh-converse" ] || { echo "smoke-test: n/a (mesh-converse not installed)"; exit 2; }
    [ -x "$HOME/.local/bin/mesh-chat" ] || { echo "smoke-test: n/a (mesh-chat not installed)"; exit 2; }
    # dry-run: verify session name is a valid tmux session identifier (no spaces, no colons)
    case "$SES" in *[!a-zA-Z0-9_-]*) echo "smoke-test: FAIL (invalid session name '$SES')"; exit 1;; esac
    echo "smoke-test: ok"; exit 0;;
  --stop) tmux kill-session -t "$SES" 2>/dev/null && echo "voice session stopped" || echo "voice not running"; exit 0;;
esac
tmux has-session -t "$SES" 2>/dev/null && { echo "voice already up — attach: tmux attach -t $SES"; exit 0; }

pkill -f "local/bin/mesh-converse" 2>/dev/null || true; sleep 1   # one recorder per mic device (match the process, not mentions)
tmux new-session -d -s "$SES" -n chat "exec ~/.local/bin/mesh-chat --watch"
tmux new-window  -t "$SES" -n ear  "MC_CHAT=1 MC_MIND='$MIND' exec ~/.local/bin/mesh-converse"
echo "voice agent up (mind=$MIND, memory on, synced to chat). Speak after a pause."
echo "  attach: tmux attach -t $SES   |   read: mesh-chat   |   stop: mesh-voice --stop"
