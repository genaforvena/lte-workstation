#!/usr/bin/env bash
# mesh-voice — a dedicated voice agent in its OWN tmux session. You talk to a fresh agent;
# the conversation is synced to the chat room (text) AND spoken (voice). Clean context, so no
# collision with the working agents (the lesson from bridging into a busy one).
#
# Session 'voice':
#   agent  — a fresh agent (opencode, free, empty context): the mind
#   ear    — mesh-converse: your voice -> the agent's pane, mirrored into mesh-chat, reply spoken
#   chat   — live tail of the conversation (text+voice synced)
#
#   mesh-voice          start it (or report if already running)
#   mesh-voice --stop   stop the voice session
set -uo pipefail
SES=voice
AGENT="${VOICE_AGENT:-opencode}"          # the mind; VOICE_AGENT=claude to talk to a Claude (costs quota)

case "${1:-}" in
  --stop) tmux kill-session -t "$SES" 2>/dev/null && echo "voice session stopped" || echo "voice not running"; exit 0;;
esac
if tmux has-session -t "$SES" 2>/dev/null; then
  echo "voice session already up — attach: tmux attach -t $SES"; exit 0
fi
# free the mic from any other converse first (single recorder per device)
pkill -f "[m]esh-converse" 2>/dev/null || true; sleep 1

tmux new-session -d -s "$SES" -n agent "$AGENT"          # the mind, fresh/empty context
sleep 4
tmux new-window -t "$SES" -n chat "exec ~/.local/bin/mesh-chat --watch"
tmux new-window -t "$SES" -n ear  "MC_PANE='$SES:agent' MC_CHAT=1 exec ~/.local/bin/mesh-converse"
echo "voice agent up — talking to a fresh '$AGENT', synced to chat + spoken."
echo "  attach: tmux attach -t $SES   |   read: mesh-chat   |   stop: mesh-voice --stop"
echo "Speak after a pause."
