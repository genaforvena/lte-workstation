#!/usr/bin/env bash
# reflex-cadence: 23 4 * * *
# mesh-evidence-provenance — the evidence root's PROVENANCE layer (the forward half of the
# quarantine layer).
#
# WHY THIS EXISTS. mesh-evidence-quarantine (2026-09-23) is the reverse gear: a superseded artifact
# is moved aside with a manifest rather than deleted, because a deletion is irreversible. It governs
# REMOVAL. It says nothing about CREATION. The transferable concept it was built on is the
# zero-trust execution-boundary rule — "a mutation of state whose provenance you cannot fully
# re-derive must be reversible, or it must be refused" — and read from the other side that rule has
# a second half the quarantine layer never implemented: an artifact the mesh considers LOAD-BEARING
# should not exist in the root without a recorded way to remake it. Measured 2026-09-23 on the same
# root the quarantine layer reports on (103,512,592 B / 112M, quarantine holding 0 items):
#   - tiny-fleet/tiny-fleet-artifacts-20260907/measurement-controls/raw/manifest.json — 17M — is
#     the ONLY provenance-complete artifact in the root: its README pins two git commits, a sha256
#     of the mutation script, and the single command that re-derives it. Verified live this session:
#     both commits resolve, the archive unpacks, the script is executable, the sha256 recomputes.
#   - artifacts/unblock-flood-20260919/ — 50M, 43% of the root — is five near-identical whole copies
#     of the task ledger plus two promise tables. Every one is re-derivable from ~/.mesh/chat.log on
#     the date in the directory name. Nothing records that.
#   - operator-intake-…chatlog-last-2-days-20260922.txt — 18M — is a single-copy chat log with no
#     manifest, no re-derivation, and no retention. Delete it and it is gone.
# The root's composition is INVERTED relative to the concept it is supposed to embody: the artifact
# that is MOST re-derivable has the most complete provenance record, and the artifacts that are LEAST
# re-derivable have none. This tool is the correction, applied at the point of mutation.
#
# WHAT IT DOES (four movements, all read-only against the artifacts themselves):
#   1. DECLARE: record how an artifact is re-derived — the exact command and its pinned inputs.
#      `--recipe` is the command; `--inputs` are the paths/commits/values the recipe depends on,
#      checked RESOLVED at declare time so a declaration cannot point at something that no longer
#      exists (an unresolvable input is the same lie as no declaration). --kind rederived (default)
#      means the recipe reproduces the artifact; --kind recorded means NO re-derivation exists, an
#      honest queryable admission rather than a silent default. --index writes the declaration to a
#      single index for paths the writer does not own (chat.log, an intake log), so those can still
#      be audited without writing into them.
#   2. AUDIT: walk the root and render one verdict per child — rederived (declared, every pinned
#      input resolves), recorded (declared, honestly admits no re-derivation), or undeclared (the
#      zero-trust REFUSED state: a load-bearing artifact with no recorded way to remake it).
#   3. VERIFY: run a declared recipe in a sandbox and compare the result to the artifact on disk.
#      This is the check the quarantine review admitted it never ran on the 185M opencode binary,
#      whose "reproducible from the release" was a reason asserted where a re-derivation should have
#      been demonstrated. --verify makes the manifest's reason falsifiable and executed.
#   4. REPORT: per-child bytes + verdict + coverage, so "how much of our evidence can we remake" is
#      a rendered number instead of a `du` nobody runs.
#
# SCOPE — as narrow as the quarantine layer's, and the scope is the safety claim:
#   - declares are WRITES OF MANIFESTS ONLY: the artifact itself is never moved, copied, or deleted.
#     A bad declaration costs a wrong index row, not evidence. The destructive half of this family
#     lives in mesh-evidence-quarantine; this layer has no destructive movement by design.
#   - --verify runs the recipe under timeout in a mktemp -d sandbox and NEVER writes to the root.
#     A recipe is shell from a declaration file, so it runs with the caller's privileges; the
#     sandbox exists so a broken recipe cannot land partial output in the evidence root, and a
#     verify that fails to reproduce leaves the original exactly where it was.
#   - --verify refuses a `recorded` kind (there is no recipe to run) and refuses a recipe whose
#     pinned inputs do not resolve, because a verify of a recipe over missing inputs is a false
#     failure that reads to a reader like a bad artifact.
#   - paths are resolved with the same guard family as the quarantine layer: a declaration for a
#     path outside $EVIDENCE_ROOT is refused, so the index cannot be pointed at /etc/passwd and
#     audited as if it were evidence. Symlinks standing at the named path are refused for the same
#     reason readlink -f traversal was there.
#
# Exit codes: 0 = assessed (or nothing to do) · 2 = cannot assess the root at all (honest n/a,
#             never a fake clean) · 64 = usage
#
#   mesh-evidence-provenance --declare <path> --recipe <command> [--inputs a,b,c]
#                            [--kind rederived|recorded] [--index]
#   mesh-evidence-provenance --audit [--maxdepth N]
#   mesh-evidence-provenance --verify <path> [--recipe-override <command>]
#   mesh-evidence-provenance --report
#   mesh-evidence-provenance --list
#   mesh-evidence-provenance --test                 sandboxed falsifiable smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# Precedence: an already-set env var WINS over derivation from MESH_DIR — same reason as the
# quarantine layer's QUARANTINE override. --test exports a sandbox root; a child re-deriving
# EVIDENCE_ROOT from MESH_DIR would point the audit at the live root and render the live verdicts
# into a test run, which is the exact shape of bug 7 in the quarantine review (children mutating a
# different root than the one the assertions read, every leg still printing PASS).
MESH="${MESH_DIR:-$HOME/.mesh}"
EVIDENCE_ROOT="${EVIDENCE_ROOT:-${MESH_EVIDENCE_ROOT:-$MESH/evidence}}"
INDEX="${INDEX:-${MESH_EVIDENCE_PROVENANCE_INDEX:-$MESH/evidence-provenance.json}}"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

usage(){ sed -n '2,60p' "${SELF:-$0}" | sed 's/^# \{0,1\}//'; }

# ── path safety: a declaration must name a path INSIDE the evidence root ───────────────────────
# Same guard family as mesh-evidence-quarantine's in_root. readlink -f resolves a symlink to its
# target, so a symlink TO /etc/hosts would read as inside ANY root; the -L check refuses a symlink
# standing at the named path itself, then readlink -f guards the resolved location.
in_root(){
  local p="$1" root="$2" rp
  [ -L "$p" ] && return 1
  [ -e "$p" ] || return 1
  rp="$(readlink -f "$p" 2>/dev/null)" || return 1
  case "$rp/" in "${root%/}/"*) return 0 ;; esac
  return 1
}

# ── JSON: emitted, never string-sliced. The index is read by --audit/--list and by other tools;
# ── a hand-rolled emitter is how a trailing comma or an unescaped quote becomes a silent parse
# ── failure that reads downstream as "no declarations". python3 is the quarantine layer's own
# ── dependency assumption (mesh-evidence-quarantine --test uses it via numfmt/du; the study lane
# ── --test asserts it), so depending on it here adds no new prerequisite.
json_str(){ printf '%s' "$1" | python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read()))'; }

# index read → python dict; an unreadable/absent index is an EMPTY dict, never an error, so --audit
# on a node that never declared anything renders all-undeclared instead of failing to run.
index_load(){
  python3 -c '
import json,sys
try:
    with open(sys.argv[1]) as fh: d=json.load(fh)
except Exception:
    d={}
sys.stdout.write(json.dumps(d))
' "$INDEX"
}
# index_write <path> <json-blob> — atomic: write-then-mv, so a crash mid-write cannot leave a
# truncated index that --audit reads as zero declarations (a partial write is the failure mode that
# would turn a transient error into a permanent "nothing is provenanced" verdict).
index_write(){
  local path="$1" blob="$2" dir
  dir="$(dirname "$path")"
  mkdir -p "$dir" || return 1
  local tmp="$path.tmp.$$"
  printf '%s' "$blob" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$path" || { rm -f "$tmp"; return 1; }
  return 0
}
# undeclarable. A 40-hex string is also accepted as a literal, because a short object name is not
# distinguishable from one by shape and the git-object arm already covers real ones.
resolve_inputs(){
  local list="$1" repo="$2" item=""
  [ -z "$list" ] && return 0
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    if [ -e "$item" ]; then continue; fi
    if printf '%s' "$item" | grep -Eq '^[0-9a-fA-F]{64}$|^[0-9a-fA-F]{40}$'; then continue; fi
    git -C "$repo" cat-file -e "$item" 2>/dev/null && continue
    return 1
  done <<< "$(printf '%s' "$item_list:-" | tr ',' '\n')"
  return 0

  # the index alone). Relative keys keep the index valid when MESH_DIR moves.
  if [ -n "$use_index" ]; then
    # --index is for paths the writer does not own (chat.log, an intake log): the artifact is NOT
    # required to exist inside the evidence root, but the key must still be an absolute path the
    # audit can resolve, and it must not be a symlink (same traversal guard, same reason).
    [ -L "$path" ] && { echo "mesh-evidence-provenance: refuses a symlink as an index key: $path" >&2; return 2; }
    case "$path" in "$EVIDENCE_ROOT"/*) rel="${path#"$EVIDENCE_ROOT"/}" ;; *) rel="$path" ;; esac
  else
    [ -e "$path" ] || { echo "mesh-evidence-provenance: no such artifact: $path" >&2; return 2; }
    in_root "$path" "$EVIDENCE_ROOT" || { echo "mesh-evidence-provenance: refuses a path outside the evidence root: $path (use --index for a path outside the root)" >&2; return 2; }
    rel="${path#"$EVIDENCE_ROOT"/}"
  fi
  # A rederived declaration with no recipe is malformed: it asserts a re-derivation that cannot run.
  # `recorded` is the honest shape for "no recipe exists", and it is the only kind permitted to
  # carry an empty recipe.
  if [ "$kind" = rederived ] && [ -z "$recipe" ]; then
    echo "mesh-evidence-provenance: --kind rederived requires a --recipe (use --kind recorded to admit no re-derivation exists)" >&2; return 64
  fi
  # A rederived declaration over inputs that do not resolve is a lie the audit would render as
  # rederived, so the refusal is at DECLARE time. `recorded` is exempt: it makes no recipe claim.
  if [ "$kind" = rederived ] && [ -n "$inputs" ]; then
    resolve_inputs "$inputs" "$SELF_DIR/../../lte-workstation" 2>/dev/null || resolve_inputs "$inputs" "$SELF_DIR" 2>/dev/null || {
      echo "mesh-evidence-provenance: a pinned input does not resolve; the declaration would assert a re-derivation it cannot run: $inputs" >&2; return 2; }
  fi
  # Side-by-side manifest, same shape as the quarantine layer's MANIFEST.md: what, how to remake it,
  # what it depends on. A stranger (or a mind after a context reset) can decide whether to re-derive
  # without re-deriving the original decision.
  if [ -z "$use_index" ]; then
    local mdir="$path.d"
    mkdir -p "$mdir" || { echo "mesh-evidence-provenance: cannot create $mdir" >&2; return 2; }
    {
      echo "# provenance manifest — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
      echo "artifact: $rel"
      echo "kind: $kind"
      echo "recipe: $recipe"
      [ -n "$inputs" ] && echo "inputs: $inputs"
      echo "verify: mesh-evidence-provenance --verify $rel"
    } > "$mdir/mesh-provenance.json"
  fi
  # The index is the audit's read path. A declaration only in a side dir is invisible to --audit
  # when the artifact is a single file among thousands; the index is what makes coverage a number.
  local blob row
  row="$(python3 -c '
import json,sys
sys.stdout.write(json.dumps({
  "kind": sys.argv[1], "recipe": sys.argv[2], "inputs": sys.argv[3],
  "declared": sys.argv[4], "where": sys.argv[5]
}))
' "$kind" "$recipe" "$inputs" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$( [ -n "$use_index" ] && echo index || echo sidecar )")"
  blob="$(python3 -c '
import json,sys
idx=json.loads(sys.argv[1]); row=json.loads(sys.argv[2])
idx[sys.argv[3]]=row
sys.stdout.write(json.dumps(idx, indent=1, sort_keys=True))
' "$(index_load)" "$row" "$rel")"
  index_write "$INDEX" "$blob" || { echo "mesh-evidence-provenance: cannot write $INDEX" >&2; return 2; }
  if [ "$kind" = recorded ]; then
    echo "declared: $rel — RECORDED (no re-derivation exists; admitted, not assumed)"
  else
    echo "declared: $rel — recipe recorded; verify with mesh-evidence-provenance --verify $rel"
  fi
}

# ── audit: the boundary enforced at the point of mutation, rendered as a verdict per child ─────
# A child with no declaration is the concept's REFUSED state. The audit does not refuse it — the
# boundary is enforced by DECLARING before writing, not by this walk — it renders the refusal so a
# reader can see which load-bearing artifacts have no reversal path.
audit_one(){
  local path="$1" root="$2" idx="$3" rel name kind verdict size
  [ -e "$path" ] || return 0
  rel="${path#"$root"/}"
  name="$(basename "$path")"
  size="$(du -sb "$path" 2>/dev/null | cut -f1)"
  verdict="undeclared"
  kind="$(python3 -c '
import json,sys
try: d=json.loads(sys.argv[1]).get(sys.argv[2], {}).get("kind","")
except Exception: d=""
sys.stdout.write(d)
' "$idx" "$rel")"
  case "$kind" in
    rederived) verdict="rederived" ;;
    recorded)  verdict="recorded" ;;
  esac
  printf '%s\t%s\t%s\t%s\n' "$verdict" "$(numfmt --to=iec "$size" 2>/dev/null || echo "$size")" "$rel" "$name"
}

do_audit(){
  local maxdepth="${1:-2}" idx
  [ -d "$EVIDENCE_ROOT" ] || { echo "mesh-evidence-provenance: no evidence root at $EVIDENCE_ROOT — nothing to assess (honest n/a)" >&2; return 2; }
  idx="$(index_load)"
  local rederived=0 recorded=0 undeclared=0
  {
    printf 'verdict\tsize\tpath\tname\n'
    while IFS= read -r p; do
      audit_one "$p" "$EVIDENCE_ROOT" "$idx"
    done < <(find "$EVIDENCE_ROOT" -maxdepth "$maxdepth" -mindepth 1 2>/dev/null | sort)
  } | tee "$AUDIT_OUT"
  # Counts come from the rendered table, never from a second walk: two walks over the same root can
  # disagree mid-change, and a count that does not match the rows above it is worse than no count.
  rederived="$(grep -c '^rederived' "$AUDIT_OUT" 2>/dev/null || echo 0)"
  recorded="$(grep -c '^recorded' "$AUDIT_OUT" 2>/dev/null || echo 0)"
  undeclared="$(grep -c '^undeclared' "$AUDIT_OUT" 2>/dev/null || echo 0)"
  printf '\ncoverage: %s rederived, %s recorded, %s undeclared\n' "$rederived" "$recorded" "$undeclared"
  return 0
}

# ── verify: run a declared recipe in a sandbox and compare the result to the live artifact ─────
# The quarantine review's admitted gap, closed: "the binary's 'reproducible from the release' claim
# was not verified by downloading or rebuilding it. It is falsifiable — but it is not proven here."
# --verify is what makes it proven: the recipe either reproduces the artifact or it does not.
do_verify(){
  local rel="$1" override="${2:-}" sandbox recipe inputs kind target out rc
  [ -d "$EVIDENCE_ROOT" ] || { echo "mesh-evidence-provenance: no evidence root at $EVIDENCE_ROOT" >&2; return 2; }
  target="$EVIDENCE_ROOT/$rel"
  [ -e "$target" ] || { echo "mesh-evidence-provenance: no such artifact in the evidence root: $rel" >&2; return 2; }
  kind="$(python3 -c '
import json,sys
try: d=json.loads(sys.argv[1]).get(sys.argv[2], {}).get("kind","")
except Exception: d=""
sys.stdout.write(d)
' "$(index_load)" "$rel")"
  [ -n "$kind" ] || { echo "mesh-evidence-provenance: no declaration for $rel — nothing to verify (declare first)" >&2; return 2; }
  if [ "$kind" = recorded ]; then
    echo "mesh-evidence-provenance: $rel is RECORDED (no re-derivation exists) — refusing to verify a recipe that was never claimed" >&2
    return 2
  fi
  # Read the declared recipe/inputs from the index, not from a sidecar: the index is the read path
  # --audit uses, so --verify and --audit must agree on what the declaration says. A sidecar and an
  # index that disagree would make the audit's verdict and the verify's outcome describe two
  # different declarations of the same artifact.
  local row; row="$(python3 -c '
import json,sys
try: sys.stdout.write(json.dumps(json.loads(sys.argv[1]).get(sys.argv[2], {})))
except Exception: sys.stdout.write("{}")
' "$(index_load)" "$rel")"
  recipe="$(printf '%s' "$row" | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin).get("recipe",""))')"
  inputs="$(printf '%s' "$row" | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin).get("inputs",""))')"
  [ -n "$override" ] && recipe="$override"
  [ -n "$recipe" ] || { echo "mesh-evidence-provenance: declaration for $rel has no recipe — nothing to run" >&2; return 2; }
  if [ -n "$inputs" ]; then
    resolve_inputs "$inputs" "$SELF_DIR/../../lte-workstation" 2>/dev/null || resolve_inputs "$inputs" "$SELF_DIR" 2>/dev/null || {
      echo "mesh-evidence-provenance: a pinned input does not resolve; a verify over missing inputs is a false failure, not a verdict on the artifact: $inputs" >&2; return 2; }
  fi
  # The sandbox before the export: $OUT points INTO it, so it must exist first. Declared after the
  # input-resolution guard above, so a verify refused for unresolvable inputs never creates a dir.
  sandbox="$(mktemp -d)" || { echo "mesh-evidence-provenance: no mktemp -d" >&2; return 2; }
  # shellcheck disable=SC2064
  trap "rm -rf '$sandbox'" RETURN INT TERM
  out="$sandbox/out"
  mkdir -p "$out"
  # $OUT is the sanctioned target: a recipe writes its re-derivation there and nowhere else. The
  # alternative — letting the recipe write into the sandbox cwd — is what would let a recipe land
  # output in the evidence root, which is a mutation this layer refuses to make. Exported, not
  # inlined into the eval, because `set -u` makes an unset `$OUT` inside the recipe a hard failure
  # that reads as "the recipe is broken" when the truth is the harness never provided it.
  export OUT="$out"
  printf 'running recipe in sandbox: %s\n' "$recipe"
  ( cd "$sandbox" && eval "$recipe" > "$sandbox/recipe.stdout" 2> "$sandbox/recipe.stderr" )
  rc=$?
  # A recipe must SAY where it wrote. Convention: it writes into $OUT (set for it) or into the
  # sandbox cwd; the comparison then looks for a single produced file/tree. A recipe that writes
  # nowhere is not a re-derivation, and a recipe that writes into the evidence root would be a
  # mutation this layer refuses to make — so $OUT is the only sanctioned target.
  local produced="$out"
  [ -n "$(find "$out" -mindepth 1 2>/dev/null | head -1)" ] || produced="$sandbox"
  if diff -r -q "$target" "$produced" >/dev/null 2>&1; then
    echo "verify OK: $rel — the recipe reproduces the artifact byte-identically"
    return 0
  fi
  echo "verify MISMATCH: $rel — the recipe ran (rc 0) but did not reproduce the artifact (produced: $(du -sb "$produced" 2>/dev/null | cut -f1) bytes vs $(du -sb "$target" 2>/dev/null | cut -f1) bytes)"
  return 1
}

# ── report: the composition the root has never had, with provenance coverage ───────────────────
do_report(){
  [ -d "$EVIDENCE_ROOT" ] || { echo "mesh-evidence-provenance: no evidence root at $EVIDENCE_ROOT — nothing to assess (honest n/a, not a clean report)" >&2; return 2; }
  local total idx rederived=0 recorded=0 undeclared=0
  total="$(du -sb "$EVIDENCE_ROOT" 2>/dev/null | cut -f1)"
  idx="$(index_load)"
  printf 'evidence root: %s\n' "$EVIDENCE_ROOT"
  printf 'total: %s bytes (%s)\n' "${total:-0}" "$(du -sh "$EVIDENCE_ROOT" 2>/dev/null | cut -f1)"
  printf 'declarations: %s (%s)\n' "$(printf '%s' "$idx" | python3 -c 'import json,sys; sys.stdout.write(str(len(json.load(sys.stdin))))' 2>/dev/null || echo 0)" "$INDEX"
  printf '\nlargest children (verdict = provenance):\n'
  du -sb "$EVIDENCE_ROOT"/* 2>/dev/null | sort -k1 -n -r | head -8 | while read -r sz path; do
    local rel verdict
    rel="${path#"$EVIDENCE_ROOT"/}"
    verdict="$(printf '%s' "$idx" | python3 -c '
import json,sys
try: k=json.load(sys.stdin).get(sys.argv[1],{}).get("kind","")
except Exception: k=""
sys.stdout.write(k or "undeclared")
' "$rel")"
    printf '  %12s  %-10s  %s\n' "$(numfmt --to=iec "$sz" 2>/dev/null || echo "$sz")" "$verdict" "$(basename "$path")"
  done
  # Coverage over the whole root at a bounded depth, not just the top children: the 17M
  # provenance-complete manifest is two levels down and invisible in a top-level listing.
  while IFS= read -r p; do
    [ -e "$p" ] || continue
    local rel kind
    rel="${p#"$EVIDENCE_ROOT"/}"
    kind="$(printf '%s' "$idx" | python3 -c '
import json,sys
try: k=json.load(sys.stdin).get(sys.argv[1],{}).get("kind","")
except Exception: k=""
sys.stdout.write(k)
' "$rel")"
    case "$kind" in rederived) rederived=$((rederived+1)) ;; recorded) recorded=$((recorded+1)) ;; *) undeclared=$((undeclared+1)) ;; esac
  done < <(find "$EVIDENCE_ROOT" -maxdepth 2 -mindepth 1 2>/dev/null)
  printf '\ncoverage (depth 2): %s rederived, %s recorded, %s undeclared\n' "$rederived" "$recorded" "$undeclared"
  return 0
}

# ── list: every declaration, so the provenance layer is auditable like the quarantine layer ─────
do_list(){
  [ -f "$INDEX" ] || { echo "(no declarations index yet: $INDEX)"; return 0; }
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception as e:
    print(f"(index unreadable: {e})"); sys.exit(2)
if not d: print("(index empty — nothing declared)"); sys.exit(0)
for k in sorted(d):
    v=d[k]; kind=v.get("kind","?"); where=v.get("where","?")
    print(f"{kind:10s} {where:9s} {k}")
    r=v.get("recipe","")
    if r: print(f"           recipe: {r}")
' "$INDEX"
  return 0
}

# ── the smoke test: every leg RED before it was written, sandboxed by env override ─────────────
run_test(){
  local fail=0 td
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (no mktemp -d)"; return 1; }
  # HERMETIC: absolute SELF (a relative "$0" re-derives the root from $HOME — the quarantine
  # layer's bug 7, which deleted the live quarantine; the guard that fixed it is copied here and
  # its absence is asserted below as its own leg) and an exported sandbox root, so no child of
  # this test can touch the live evidence root or the live index.
  trap "rm -rf '$td'" EXIT INT TERM
  export MESH_DIR="$td/mesh" EVIDENCE_ROOT="$td/mesh/evidence" INDEX="$td/mesh/evidence-provenance.json" SELF="$SELF_DIR/$(basename "$0")"
  mkdir -p "$EVIDENCE_ROOT/artifacts"

  # 1. declare writes a sidecar + index row, and the artifact is untouched
  printf 'real evidence\n' > "$EVIDENCE_ROOT/artifacts/probe-a.md"
  "${SELF:-$0}" --declare "$EVIDENCE_ROOT/artifacts/probe-a.md" --recipe "cp probe-a.md \$OUT/probe-a.md" --inputs "$EVIDENCE_ROOT/artifacts/probe-a.md" > "$td/o1" 2>&1 || { echo "smoke-test: FAIL (declare rc): $(cat "$td/o1")"; fail=1; }
  grep -q "declared: artifacts/probe-a.md" "$td/o1" || { echo "smoke-test: FAIL (no declare confirmation): $(cat "$td/o1")"; fail=1; }
  grep -q "real evidence" "$EVIDENCE_ROOT/artifacts/probe-a.md" 2>/dev/null || { echo "smoke-test: FAIL (declare mutated the artifact)"; fail=1; }
  [ -f "$EVIDENCE_ROOT/artifacts/probe-a.md.d/mesh-provenance.json" ] || { echo "smoke-test: FAIL (no sidecar manifest)"; fail=1; }
  "${SELF:-$0}" --list 2>/dev/null | grep -q "rederived" || { echo "smoke-test: FAIL (index has no rederived row): $("${SELF:-$0}" --list 2>&1)"; fail=1; }

  # 2. a rederived declaration with no recipe is REFUSED (recorded is the honest shape for that)
  printf 'x\n' > "$EVIDENCE_ROOT/artifacts/probe-b.md"
  "${SELF:-$0}" --declare "$EVIDENCE_ROOT/artifacts/probe-b.md" > "$td/o2" 2>&1 && { echo "smoke-test: FAIL (a rederived declare with no recipe was accepted): $(cat "$td/o2")"; fail=1; }
  "${SELF:-$0}" --declare "$EVIDENCE_ROOT/artifacts/probe-b.md" --kind recorded > "$td/o2b" 2>&1 || { echo "smoke-test: FAIL (recorded declare rc): $(cat "$td/o2b")"; fail=1; }
  grep -q "RECORDED" "$td/o2b" || { echo "smoke-test: FAIL (recorded declare did not admit it): $(cat "$td/o2b")"; fail=1; }

  # 3. a declaration for a path OUTSIDE the root is refused; --index admits it
  "${SELF:-$0}" --declare "$td/outside.md" --recipe "echo x" > "$td/o3" 2>&1 && { echo "smoke-test: FAIL (a path outside the root was declared without --index): $(cat "$td/o3")"; fail=1; }
  printf 'outside\n' > "$td/outside.md"
  "${SELF:-$0}" --declare "$td/outside.md" --recipe "cp outside.md \$OUT/outside.md" --index > "$td/o3b" 2>&1 || { echo "smoke-test: FAIL (--index declare rc): $(cat "$td/o3b")"; fail=1; }

  # 4. a declaration over inputs that DO NOT RESOLVE is refused — the lie the audit would render
  #    as rederived. Asserted because it is the exact failure mode that made the 185M binary's
  #    "reproducible from the release" an assertion rather than a demonstration.
  "${SELF:-$0}" --declare "$EVIDENCE_ROOT/artifacts/probe-a.md" --recipe "cp probe-c.md \$OUT/probe-c.md" --inputs "$EVIDENCE_ROOT/artifacts/DOES-NOT-EXIST.md" > "$td/o4" 2>&1 && { echo "smoke-test: FAIL (a declaration over an unresolvable input was accepted): $(cat "$td/o4")"; fail=1; }

  # 5. verify runs a recipe and compares; a recipe that does NOT reproduce the artifact is a
  #    MISMATCH, not a silent pass
  "${SELF:-$0}" --verify artifacts/probe-a.md --recipe-override "printf 'wrong\n' > \$OUT/probe-a.md" > "$td/o5" 2>&1 && { echo "smoke-test: FAIL (a mismatching recipe verified OK): $(cat "$td/o5")"; fail=1; }
  grep -q "MISMATCH" "$td/o5" || { echo "smoke-test: FAIL (a mismatch was not reported as a mismatch): $(cat "$td/o5")"; fail=1; }
  grep -q "real evidence" "$EVIDENCE_ROOT/artifacts/probe-a.md" 2>/dev/null || { echo "smoke-test: FAIL (verify mutated the artifact)"; fail=1; }

  # 6. verify REFUSES a recorded artifact (no recipe was ever claimed)
  "${SELF:-$0}" --verify artifacts/probe-b.md > "$td/o6" 2>&1 && { echo "smoke-test: FAIL (verify ran on a recorded artifact): $(cat "$td/o6")"; fail=1; }
  grep -q "RECORDED" "$td/o6" || { echo "smoke-test: FAIL (verify did not name the recorded refusal): $(cat "$td/o6")"; fail=1; }

  # 7. audit renders the three verdicts, and its counts match its own rendered rows
  AUDIT_OUT="$td/audit.tsv" "${SELF:-$0}" --audit > "$td/o7" 2>&1 || { echo "smoke-test: FAIL (audit rc): $(cat "$td/o7")"; fail=1; }
  grep -q '^rederived' "$td/o7" || { echo "smoke-test: FAIL (audit rendered no rederived row): $(cat "$td/o7")"; fail=1; }
  grep -q '^recorded' "$td/o7" || { echo "smoke-test: FAIL (audit rendered no recorded row): $(cat "$td/o7")"; fail=1; }
  grep -q '^undeclared' "$td/o7" || { echo "smoke-test: FAIL (audit rendered no undeclared row — the refused state is the point of the walk): $(cat "$td/o7")"; fail=1; }

  # 8. the sandbox boundary itself: no child of this test touched the live root or the live index.
  #    The quarantine layer's own test deleted the live quarantine through exactly this hole; the
  #    leg that catches it is the one that would have caught that.
  [ -f "$INDEX" ] && grep -q "$td/mesh" "$INDEX" && echo "smoke-test: ok (index is the sandbox index)"
  ! grep -aq "mesh-home/.mesh/evidence" "$td/audit.tsv" 2>/dev/null || { echo "smoke-test: FAIL (the audit walked the LIVE evidence root from inside the sandbox)"; fail=1; }

  [ "$fail" = 0 ] && { echo "smoke-test: ok (declare sidecar+index · recorded admits no re-derivation · outside-root refused unless --index · unresolvable input refused · verify matches/mismatches and never mutates · recorded refuses verify · audit renders all three verdicts · sandbox does not reach the live root)"; return 0; }
  echo "smoke-test: FAIL"; return 1
}

main(){
  local mode="" path="" recipe="" inputs="" kind="" use_index="" override="" maxdepth=""
  AUDIT_OUT="$(mktemp)"
  trap "rm -f '$AUDIT_OUT'" EXIT INT TERM
  while [ $# -gt 0 ]; do
    case "$1" in
      --declare) mode=declare; shift; [ $# -gt 0 ] && { path="$1"; shift; } ;;
      --recipe) shift; [ $# -gt 0 ] && { recipe="$1"; shift; } ;;
      --inputs) shift; [ $# -gt 0 ] && { inputs="$1"; shift; } ;;
      --kind) shift; [ $# -gt 0 ] && { kind="$1"; shift; } ;;
      --index) use_index=1; shift ;;
      --audit) mode=audit; shift ;;
      --maxdepth) shift; [ $# -gt 0 ] && { maxdepth="$1"; shift; } ;;
      --verify) mode=verify; shift; [ $# -gt 0 ] && { path="$1"; shift; } ;;
      --recipe-override) shift; [ $# -gt 0 ] && { override="$1"; shift; } ;;
      --report) mode=report; shift ;;
      --list) mode=list; shift ;;
      --test) run_test; return $? ;;
      -h|--help|help) usage; return 0 ;;
      *) echo "mesh-evidence-provenance: unknown argument: $1" >&2; usage >&2; return 64 ;;
    esac
  done
  case "$mode" in
    declare) [ -n "$path" ] || { usage >&2; return 64; }; do_declare "$path" "$recipe" "$inputs" "$kind" "$use_index" ;;
    audit)   do_audit "$maxdepth" ;;
    verify)  [ -n "$path" ] || { usage >&2; return 64; }; do_verify "$path" "$override" ;;
    report)  do_report ;;
    list)    do_list ;;
    *)       usage >&2; return 64 ;;
  esac
}
main "$@"
