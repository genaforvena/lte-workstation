#!/usr/bin/env bash
# orphan-ok: on-demand Wi-Fi PHY transmit-power read; it is pulled by the senses mind when
# a live radio-power sample is needed and is intentionally not a scheduled reflex.
# mesh-wifi-txpower — honest local Wi-Fi radio transmit-power sense.
#
# The kernel's nl80211 `txpower` field is a physical radio setting. Existing Wi-Fi senses read
# association quality, traffic, and RF counters, but do not publish this power axis. A missing
# interface, missing iw, or malformed reply is UNKNOWN (exit 2), never a fabricated zero.
#
#   mesh-wifi-txpower          one live reading
#   mesh-wifi-txpower --json   machine-readable reading
#   mesh-wifi-txpower --test   fixture parser + real-read gate
set -uo pipefail

IW_BIN="${MESH_WIFI_TXPOWER_IW:-iw}"
IFACE="${MESH_WIFI_TXPOWER_IFACE:-}"

find_iface() {
  local n
  [ -n "$IFACE" ] && { printf '%s\n' "$IFACE"; return 0; }
  for n in /sys/class/net/*; do
    [ -d "$n/wireless" ] || continue
    printf '%s\n' "${n##*/}"
    return 0
  done
  return 2
}

read_txpower() {
  local iface="${1:-}" out power
  [ -n "$iface" ] || return 2
  command -v "$IW_BIN" >/dev/null 2>&1 || return 2
  out="$("$IW_BIN" dev "$iface" info 2>/dev/null)" || return 2
  power="$(printf '%s\n' "$out" | sed -nE 's/^[[:space:]]*txpower[[:space:]]+(-?[0-9]+([.][0-9]+)?)[[:space:]]+dBm[[:space:]]*$/\1/p' | head -1)"
  case "$power" in ''|*[!0-9.-]*) return 2 ;; esac
  printf '%s\n' "$power"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  cat >"$td/iw" <<'EOF'
#!/usr/bin/env bash
cat <<'OUT'
Interface test0
	txpower 17.50 dBm
OUT
EOF
  chmod +x "$td/iw"
  got="$(MESH_WIFI_TXPOWER_IW="$td/iw" MESH_WIFI_TXPOWER_IFACE=test0 "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $got)"; exit 1;
  }
  printf '%s\n' "$got" | grep -q '"txpower_dbm":17.5' || {
    echo "smoke-test: FAIL (fixture txpower: $got)"; exit 1;
  }
  cat >"$td/bad-iw" <<'EOF'
#!/usr/bin/env bash
printf 'Interface test0\n\ttxpower unavailable\n'
EOF
  chmod +x "$td/bad-iw"
  if MESH_WIFI_TXPOWER_IW="$td/bad-iw" MESH_WIFI_TXPOWER_IFACE=test0 "$0" --json >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (malformed txpower accepted)'; exit 1
  fi
  iface="$(find_iface 2>/dev/null || true)"
  [ -n "$iface" ] || { echo 'smoke-test: n/a (no local wireless interface)'; exit 2; }
  live="$(read_txpower "$iface" 2>/dev/null || true)"
  case "$live" in ''|*[!0-9.-]*) echo "smoke-test: n/a (txpower unavailable on $iface)"; exit 2;; esac
  echo "smoke-test: ok (fixture parser + malformed rejection + REAL txpower=${live} dBm on ${iface})"
  exit 0
fi

iface="$(find_iface 2>/dev/null || true)"
[ -n "$iface" ] || { echo 'mesh-wifi-txpower: UNKNOWN — no local wireless interface' >&2; exit 2; }
power="$(read_txpower "$iface" 2>/dev/null || true)"
case "$power" in ''|*[!0-9.-]*) echo "mesh-wifi-txpower: UNKNOWN — iw txpower unavailable on $iface" >&2; exit 2;; esac
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "${1:-}" = --json ]; then
  printf '{"iface":"%s","txpower_dbm":%s,"source":"iw dev %s info","ts":"%s"}\n' "$iface" "$power" "$iface" "$ts"
else
  printf '[wifi-txpower] iface=%s txpower=%s dBm observed_at=%s\n' "$iface" "$power" "$ts"
fi
