#!/usr/bin/env bash
# orphan-ok: on-demand physical NIC CRC probe; no cadence until its source is landed
# doctor-artifact: $HOME/.mesh/.nic-rx-crc.state 900 sys
# mesh-nic-rx-crc — physical NIC receive CRC-error sense.
#
# rx_crc_errors is a kernel NIC counter for frames rejected by the receive CRC
# check. It is a wire-level signal, distinct from carrier changes, aggregate
# rx_errors, missed delivery, and rx_nohandler. Zero is a real observed value;
# an absent or malformed physical-NIC counter is unreachable (exit 2).
set -u
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME

ROOT="${MESH_NIC_RX_CRC_ROOT:-/sys/class/net}"
STATE="${MESH_NIC_RX_CRC_STATE:-$HOME/.mesh/.nic-rx-crc.state}"

read_snapshot() {
  local root="$1" path iface value total=0 count=0
  [ -d "$root" ] || return 2
  shopt -s nullglob
  for path in "$root"/*/statistics/rx_crc_errors; do
    iface="${path#"$root"/}"; iface="${iface%%/*}"
    [ "$iface" != lo ] || continue
    [ -e "$root/$iface/device" ] || [ -d "$root/$iface/wireless" ] || continue
    value="$(tr -d '[:space:]' <"$path" 2>/dev/null)" || continue
    case "$value" in ''|*[!0-9]*) continue ;; esac
    total=$((total + value)); count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  printf '%s|%s\n' "$count" "$total"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/enp-test/statistics" "$td/device-target"
  ln -s "$td/device-target" "$td/net/enp-test/device"
  printf '7\n' >"$td/net/enp-test/statistics/rx_crc_errors"
  snap="$(read_snapshot "$td/net")" || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  [ "$snap" = '1|7' ] || { echo "smoke-test: FAIL (fixture snapshot=$snap)"; exit 1; }
  if read_snapshot "$td/missing" >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (missing root read succeeded)'; exit 1
  fi
  live="$(MESH_NIC_RX_CRC_ROOT="$ROOT" MESH_NIC_RX_CRC_STATE="$td/live.state" "$0" --json 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    printf '%s' "$live" | grep -q '"rx_crc_errors":[0-9]' || {
      echo "smoke-test: FAIL (live artifact=$live)"; exit 1;
    }
  elif [ "$rc" -eq 2 ]; then
    printf '%s' "$live" | grep -q 'UNKNOWN' || {
      echo "smoke-test: FAIL (rc=2 artifact=$live)"; exit 1;
    }
  else
    echo "smoke-test: FAIL (real read rc=$rc artifact=$live)"; exit 1
  fi
  echo "smoke-test: ok (fixture parser + REAL rx_crc_errors read: ${live:-UNKNOWN})"
  exit 0
fi

case "${1:-}" in ''|--json) ;; *) echo "usage: $0 [--json|--test]" >&2; exit 2 ;; esac
snapshot="$(read_snapshot "$ROOT")" || {
  echo "mesh-nic-rx-crc: UNKNOWN — no physical NIC rx_crc_errors under $ROOT" >&2
  exit 2
}
interfaces="${snapshot%%|*}"
errors="${snapshot#*|}"
verdict=CLEAN
[ "$errors" -gt 0 ] && verdict=CRC_SEEN
ts="$(date -u +%FT%TZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf '%s|interfaces=%s|rx_crc_errors=%s|ts=%s\n' "$verdict" "$interfaces" "$errors" "$ts" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-nic-rx-crc: UNKNOWN — could not stamp live state' >&2
  exit 1
}

if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","interfaces":%s,"rx_crc_errors":%s,"ts":"%s"}\n' \
    "$verdict" "$interfaces" "$errors" "$ts"
else
  printf '[nic-rx-crc] %s — interfaces=%s rx_crc_errors=%s @ %s\n' \
    "$verdict" "$interfaces" "$errors" "$ts"
fi
