#!/usr/bin/env bash
# mesh-looper — live LOOPER for the operator's cello: record a phrase, loop it gaplessly through the
# Bose while he plays over it. Operator GREENLIT 2026-06-20 02:01 ("лупер звучит круто, давай попробуем")
# and explicitly wants NO long debug — so this is built in small VERIFIABLE stages, each a real artifact:
#
#   STAGE 1  mesh-looper record [secs] [out.wav]   capture the mic to a WAV (default 8s). Prints the path
#                                                  + the measured duration (ffprobe). Mic-only, NO audio
#                                                  out → safe under the room silent-gate.
#   STAGE 2  mesh-looper play <wav> [--secs N]      build a GAPLESS loop of <wav> (click-free seams) and
#                                                  play it on the Bose, ~N seconds total (default 120).
#                                                  OPT-IN audio: refuses while MUTE_FLAG present (mirror
#                                                  mesh-drone) — never sounds the Bose unsolicited.
#   STAGE 0  mesh-looper --test                     plumbing self-test WITHOUT the operator or audio:
#                                                  synthesize a tone, "record" it to a WAV, verify the
#                                                  duration, build the loop and ASSERT the seam is
#                                                  click-free (the anti-debug-hell step). No mic, no Bose.
#         mesh-looper build <wav> [--secs N] [out]  just build the gapless-loop WAV (no playback) — lets
#                                                  the operator eyeball/keep the loop file before playing.
#
# v1 BOUNDARIES (operator's "avoid debug swamp"): MANUAL start/stop + fixed length. NO auto loop-length
# or square detection (deferred). Seam is made click-free by short raised-cosine edge-fades (~6ms) so the
# loop boundary crosses through ~0 on both sides — pragmatic + verifiable now; a true crossfade is a
# later upgrade. The on-screen RECORDING/LOOPING status + visual notes (operator 02:04) are a follow-up.
#
# Tunables (env): LOOP_DIR ($MESH/looper) · LOOP_SR (44100) · LOOP_SECS (play target, 120) ·
#   LOOP_FADE_MS (seam edge-fade, 6) · MUTE_FLAG ($MESH/mesh-speaking).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire mic + Bose sink
MESH="${MESH_DIR:-$HOME/.mesh}"
LOOP_DIR="${LOOP_DIR:-$MESH/looper}"
MUTE_FLAG="${MUTE_FLAG:-$MESH/mesh-speaking}"
SR="${LOOP_SR:-44100}"
PLAY_SECS="${LOOP_SECS:-120}"
FADE_MS="${LOOP_FADE_MS:-6}"

PY=$(cat <<'PYEOF'
import sys, os, math, wave
import numpy as np

SR      = int(os.environ.get("LOOP_SR", "44100"))
FADE_MS = float(os.environ.get("LOOP_FADE_MS", "6"))

def read_wav(path):
    with wave.open(path, "rb") as w:
        sr = w.getframerate(); ch = w.getnchannels()
        x = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).astype(np.float64)
        if ch > 1: x = x[::ch]
    return x, sr

def write_wav(path, samples, sr):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with wave.open(path, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(sr)
        w.writeframes(samples.astype(np.int16).tobytes())

# ---------- note-timeline (STAGE 1): YIN pitch per frame → timestamped note events ----------
# Reuses mesh-tuner's YIN. This is the data layer the visual timeline AND the arrow-key loop-cut
# (STAGE 2) both sit on: it maps the recording to a list of (onset, offset, note, freq) so a loop
# can be cut at exact note-onset timestamps. Pure analysis — no audio out, no mic.
NAMES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]
NOTE_FMIN = 55.0      # ~A1, safely below cello C2 (65.4Hz)
NOTE_FMAX = 1200.0    # well above cello's useful range

def yin(x, sr, fmin=NOTE_FMIN, fmax=NOTE_FMAX, gate=200.0):
    """YIN pitch (same algorithm as mesh-tuner). Returns midi float or None for quiet/aperiodic frames."""
    if x is None or len(x) < 2048: return None
    rms = float(np.sqrt(np.mean(x*x)))
    if rms < gate: return None
    x = x - np.mean(x); N = len(x)
    tau_max = min(int(sr/fmin), N//2); tau_min = max(2, int(sr/fmax))
    d = np.zeros(tau_max+1)
    for tau in range(1, tau_max+1):
        diff = x[:N-tau] - x[tau:N]; d[tau] = float(np.dot(diff, diff))
    cmnd = np.ones(tau_max+1); running = 0.0
    for tau in range(1, tau_max+1):
        running += d[tau]; cmnd[tau] = d[tau]*tau/running if running > 0 else 1.0
    thr = 0.12; tau = -1; t = tau_min
    while t <= tau_max:
        if cmnd[t] < thr:
            while t+1 <= tau_max and cmnd[t+1] < cmnd[t]: t += 1
            tau = t; break
        t += 1
    if tau == -1:
        seg = cmnd[tau_min:tau_max+1]; tau = tau_min + int(np.argmin(seg))
        if cmnd[tau] > 0.55: return None
    if 1 <= tau < tau_max:
        a,b,c = cmnd[tau-1], cmnd[tau], cmnd[tau+1]; denom = a + c - 2*b
        shift = 0.5*(a-c)/denom if denom != 0 else 0.0
    else:
        shift = 0.0
    period = tau + shift
    if period <= 0: return None
    freq = sr/period
    if freq < fmin or freq > fmax: return None
    return 69 + 12*math.log2(freq/440.0)

def midi_name(midi):
    n = int(round(midi)); return "%s%d" % (NAMES[n % 12], n//12 - 1)

def extract_notes(x, sr, win=None, hop=None, min_dur=0.08):
    """Slide YIN over the recording, segment consecutive same-pitch frames into note events.
    Returns [(onset_s, offset_s, name, freq_hz), ...]. min_dur drops sub-80ms blips."""
    win = win or min(4096, len(x)); hop = hop or max(1, win//4)
    frames = []   # (time, midi or None)
    for i in range(0, max(1, len(x)-win+1), hop):
        m = yin(x[i:i+win].astype(np.float64), sr)
        frames.append((i/sr, m))
    events = []
    cur_note = None; cur_start = None; cur_midis = []
    def flush(end_t):
        if cur_note is not None and cur_midis and (end_t - cur_start) >= min_dur:
            med = float(np.median(cur_midis)); freq = 440.0*2**((med-69)/12.0)
            events.append((round(cur_start,3), round(end_t,3), midi_name(med), round(freq,2)))
    for t, m in frames:
        nn = None if m is None else int(round(m))
        if nn != cur_note:
            flush(t)
            cur_note = nn; cur_start = t; cur_midis = []
        if m is not None: cur_midis.append(m)
    flush(frames[-1][0] + hop/sr if frames else 0.0)
    return [e for e in events if e[2] is not None]

def edge_fade(x, ms):
    """Raised-cosine fade-in at the head and fade-out at the tail so the loop seam crosses ~0 both sides."""
    n = len(x); f = min(int(SR*ms/1000.0), n//2)
    if f <= 0: return x
    y = x.copy()
    env = 0.5*(1-np.cos(np.linspace(0, np.pi, f)))
    y[:f]  *= env
    y[-f:] *= env[::-1]
    return y

def build_loop(x, total_secs):
    """Edge-fade the phrase, then tile it to ~total_secs. Click-free at every seam."""
    if len(x) == 0: return x
    phrase = edge_fade(x, FADE_MS)
    reps = max(1, int(math.ceil(total_secs*SR/len(phrase))))
    return np.tile(phrase, reps)

def seam_clickfree(x, phrase_len):
    """Verification: the per-sample step at each loop boundary must NOT be an outlier vs the body's steps.
    Returns (ok, seam_step, body_p99)."""
    d = np.abs(np.diff(x))
    if d.size == 0: return True, 0.0, 0.0
    body_p99 = float(np.percentile(d, 99)) + 1.0
    # boundaries sit at multiples of phrase_len
    seams = [i for i in range(phrase_len, len(x), phrase_len) if 0 < i < len(x)]
    seam_step = max((float(abs(x[i]-x[i-1])) for i in seams), default=0.0)
    # click-free if the worst seam step is within the body's loudest ordinary steps (small absolute floor too)
    return (seam_step <= max(body_p99, 200.0)), seam_step, body_p99

def cmd_build(inp, total_secs, out):
    x, sr = read_wav(inp)
    loop = build_loop(x, total_secs)
    write_wav(out, loop, sr)
    dur = len(loop)/sr
    ok, seam, body = seam_clickfree(loop, len(edge_fade(x, FADE_MS)))
    print("%.2f\t%s\t%s\t%.1f\t%.1f" % (dur, "ok" if ok else "CLICK", out, seam, body))
    return 0 if ok else 1

def cmd_notes(wavpath):
    x, sr = read_wav(wavpath)
    events = extract_notes(x, sr)
    if not events:
        print("(no notes detected — silence or aperiodic)"); return 2
    for on, off, name, freq in events:
        print("%.3f\t%.3f\t%s\t%.2f" % (on, off, name, freq))   # onset<TAB>offset<TAB>note<TAB>freq
    return 0

def cmd_cut(wavpath, start_s, end_s, out):
    """STAGE 2 cut: slice the recording between two timestamps (a note ONSET range from `notes`) into a
    loop-ready segment, edge-faded so it self-loops click-free. This is the pure half of the arrow-key
    loop-cut — the operator marks START/END notes on the timeline, those onset times come here."""
    x, sr = read_wav(wavpath)
    a = max(0, int(round(start_s*sr))); b = min(len(x), int(round(end_s*sr)))
    if b - a < int(sr*0.05):
        print("ERR\tselection too short (%.3f..%.3f = %.3fs)" % (start_s, end_s, max(0,end_s-start_s))); return 2
    seg = edge_fade(x[a:b], FADE_MS)        # fade edges so the cut self-loops without a seam click
    write_wav(out, seg, sr)
    # verify: tiling the segment twice must be click-free at the seam
    tiled = np.tile(seg, 2)
    ok, seam, body = seam_clickfree(tiled, len(seg))
    print("%.3f\t%s\t%s\t%.1f" % (len(seg)/sr, "ok" if ok else "CLICK", out, seam))   # dur<TAB>seam<TAB>path<TAB>step
    return 0 if ok else 1

class Selector:
    """STAGE 2 arrow-key in/out selection state machine (operator's finalized mechanism, 02:07): a cursor
    moves L/R across the note timeline; MARK once = START note, MARK again = END note (swap-safe), then the
    onset of START .. offset of END become the cut window. PURE — no curses, no I/O → headlessly testable."""
    def __init__(self, events):
        self.events = events; self.cur = 0; self.start = None; self.end = None; self.phase = "start"
    def left(self):  self.cur = max(0, self.cur-1)
    def right(self): self.cur = min(len(self.events)-1, self.cur+1)
    def mark(self):
        if self.phase == "start":
            self.start = self.cur; self.phase = "end"
        elif self.phase == "end":
            self.end = self.cur
            if self.end < self.start: self.start, self.end = self.end, self.start   # mark END-before-START → swap
            self.phase = "done"
    def selection_times(self):
        return (self.events[self.start][0], self.events[self.end][1])               # START onset .. END offset

def _render(scr, events, sel):
    import curses
    scr.erase()
    h, w = scr.getmaxyx()
    scr.addnstr(0, 0, "mesh-looper select — ←/→ move · Enter mark START then END · q cancel", w-1)
    phase = {"start":"mark the START note", "end":"mark the END note", "done":""}[sel.phase]
    scr.addnstr(1, 0, "step: %s" % phase, w-1)
    # one cell per note, wrapping across rows; highlight cursor, underline the marked START
    col, row = 0, 3
    for i, (on, off, nm, fr) in enumerate(events):
        cell = "%s " % nm
        if col + len(cell) >= w: col = 0; row += 1
        if row >= h-2: break
        attr = curses.A_REVERSE if i == sel.cur else curses.A_NORMAL
        if sel.start is not None and i == sel.start: attr |= curses.A_UNDERLINE
        scr.addnstr(row, col, cell, w-1-col, attr)
        col += len(cell)
    cur_on = events[sel.cur][0]
    foot = "cursor: [%d] %s @%.3fs" % (sel.cur, events[sel.cur][2], cur_on)
    if sel.start is not None:
        foot += "   START=%s @%.3fs" % (events[sel.start][2], events[sel.start][0])
    scr.addnstr(h-1, 0, foot, w-1)
    scr.refresh()

def cmd_select(wavpath, out):
    x, sr = read_wav(wavpath)
    events = extract_notes(x, sr)
    if len(events) < 2:
        print("select: need >=2 notes to mark a loop (got %d) — record a longer phrase" % len(events)); return 2
    if not sys.stdout.isatty():
        # headless (cron/SSH-no-tty): can't run curses — print the timeline + the non-interactive fallback.
        print("select: needs an interactive terminal (run it on the ds monitor). Notes detected:")
        for i, (on, off, nm, fr) in enumerate(events):
            print("  [%2d] %-4s %.3f..%.3fs" % (i, nm, on, off))
        print("non-interactive: mesh-looper cut %s <start_onset_s> <end_offset_s>" % wavpath)
        return 3
    import curses
    sel = Selector(events)
    def run(scr):
        curses.curs_set(0); scr.keypad(True)
        while sel.phase != "done":
            _render(scr, events, sel)
            k = scr.getch()
            if   k in (curses.KEY_LEFT, ord('h')):  sel.left()
            elif k in (curses.KEY_RIGHT, ord('l')): sel.right()
            elif k in (curses.KEY_ENTER, 10, 13, ord(' ')): sel.mark()
            elif k in (ord('q'), 27): return None
        return sel.selection_times()
    times = curses.wrapper(run)
    if not times:
        print("select: cancelled — no cut made"); return 1
    s, e = times
    print("select: START=%s END=%s → cut [%.3f, %.3f]s" % (events[sel.start][2], events[sel.end][2], s, e))
    return cmd_cut(wavpath, s, e, out)

def cmd_test():
    fails = 0
    tmp = os.environ.get("LOOP_TMP", "/tmp")
    os.makedirs(tmp, exist_ok=True)
    # STAGE 0: synthesize a 1.0s 220Hz "recorded phrase", write + read back, verify duration
    dur_in = 1.0
    t = np.arange(int(SR*dur_in))/SR
    tone = (np.sin(2*np.pi*220*t)*0.5*32767)
    pin = os.path.join(tmp, "loop_in.wav"); write_wav(pin, tone, SR)
    x, sr = read_wav(pin)
    if abs(len(x)/sr - dur_in) > 0.02:
        print("smoke-test: FAIL (record duration %.3fs != %.3fs)" % (len(x)/sr, dur_in)); fails += 1
    if int(np.max(np.abs(x))) == 0:
        print("smoke-test: FAIL (silent recording buffer)"); fails += 1
    # build a 10s gapless loop and assert the seams are click-free
    loop = build_loop(x, 10.0)
    ok, seam, body = seam_clickfree(loop, len(edge_fade(x, FADE_MS)))
    if not ok:
        print("smoke-test: FAIL (loop seam clicks: step %.1f > body-p99 %.1f)" % (seam, body)); fails += 1
    # and that tiling actually reached ~10s
    if abs(len(loop)/SR - 10.0) > len(x)/SR:
        print("smoke-test: FAIL (loop length %.2fs not ~10s)" % (len(loop)/SR)); fails += 1
    try: os.remove(pin)
    except OSError: pass
    # STAGE 1: note-timeline — synth C4→E4→G4 (0.5s each), assert the extractor recovers 3 notes in order
    seq = [("C4",261.63),("E4",329.63),("G4",392.00)]
    parts = []
    for _, f in seq:
        tt = np.arange(int(SR*0.5))/SR
        parts.append(np.sin(2*np.pi*f*tt)*0.5*32767)
    melody = np.concatenate(parts)
    ev = extract_notes(melody.astype(np.float64), SR)
    names = [e[2] for e in ev]
    if names != ["C4","E4","G4"]:
        print("smoke-test: FAIL (note-timeline got %s, want [C4,E4,G4])" % names); fails += 1
    else:
        onsets_ok = all(abs(ev[i][0] - i*0.5) < 0.12 for i in range(3))
        if not onsets_ok:
            print("smoke-test: FAIL (note onsets off: %s)" % [e[0] for e in ev]); fails += 1
    # STAGE 2: cut the MIDDLE note (E4, 0.5..1.0s) out of the melody → assert duration ~0.5s, click-free
    # loop, and that the cut segment is in fact the E4 note (the timestamp-accurate slice is correct).
    pcut = os.path.join(tmp, "melody.wav"); write_wav(pcut, melody.astype(np.int16), SR)
    pout = os.path.join(tmp, "cut.wav")
    import io, contextlib
    with contextlib.redirect_stdout(io.StringIO()):   # cmd_cut prints its own line; silence it under --test
        cut_rc = cmd_cut(pcut, 0.5, 1.0, pout)
    if cut_rc != 0:
        print("smoke-test: FAIL (cut returned click/err rc=%d)" % cut_rc); fails += 1
    else:
        cx, csr = read_wav(pout)
        if abs(len(cx)/csr - 0.5) > 0.03:
            print("smoke-test: FAIL (cut duration %.3fs != 0.5s)" % (len(cx)/csr)); fails += 1
        cev = extract_notes(cx.astype(np.float64), csr)
        if not cev or cev[0][2] != "E4":
            print("smoke-test: FAIL (cut segment is %s, want E4)" % ([e[2] for e in cev] or "none")); fails += 1
    try:
        os.remove(pcut); os.remove(pout)
    except OSError: pass
    # STAGE 2 SELECT: drive the arrow-key Selector headlessly over the C4-E4-G4 timeline and assert the
    # selection→cut path. Sequence: right→cursor E4, mark START, right→cursor G4, mark END → window
    # (E4.onset .. G4.offset). Cut it → must be ~1.0s and contain E4 then G4 (timestamp-accurate).
    if names == ["C4","E4","G4"]:
        sel = Selector(ev)
        sel.right(); sel.mark(); sel.right(); sel.mark()        # START=E4(idx1), END=G4(idx2)
        if sel.phase != "done" or (sel.start, sel.end) != (1, 2):
            print("smoke-test: FAIL (selector state %s start=%s end=%s)" % (sel.phase, sel.start, sel.end)); fails += 1
        else:
            ss, ee = sel.selection_times()
            psel = os.path.join(tmp, "sel.wav")
            pmel = os.path.join(tmp, "melody_sel.wav"); write_wav(pmel, melody.astype(np.int16), SR)
            with contextlib.redirect_stdout(io.StringIO()):
                sel_rc = cmd_cut(pmel, ss, ee, psel)
            if sel_rc != 0:
                print("smoke-test: FAIL (select-cut rc=%d)" % sel_rc); fails += 1
            else:
                sx, ssr = read_wav(psel)
                if abs(len(sx)/ssr - (ee-ss)) > 0.02:           # cut dur must equal END.offset - START.onset
                    print("smoke-test: FAIL (select-cut dur %.3fs != window %.3fs)" % (len(sx)/ssr, ee-ss)); fails += 1
                sev = [e[2] for e in extract_notes(sx.astype(np.float64), ssr)]
                if sev[:1] != ["E4"] or "G4" not in sev:
                    print("smoke-test: FAIL (select-cut notes %s, want E4..G4)" % sev); fails += 1
            try: os.remove(pmel); os.remove(psel)
            except OSError: pass
        # swap-safe: marking END (idx0) before START (idx2) must reorder to (0,2)
        sw = Selector(ev); sw.right(); sw.right(); sw.mark(); sw.left(); sw.left(); sw.mark()
        if (sw.start, sw.end) != (0, 2):
            print("smoke-test: FAIL (selector swap got start=%s end=%s, want 0,2)" % (sw.start, sw.end)); fails += 1
    if fails: print("smoke-test: FAIL (%d)" % fails); return 1
    print("smoke-test: ok (record→WAV exact, 10s loop seam %.1f<=p99 %.1f click-free, timeline C4→E4→G4, cut[0.5,1.0]→E4 0.5s click-free, select E4→G4 cut 1.0s + swap-safe)" % (seam, body))
    return 0

mode = sys.argv[1]
if   mode == "build": sys.exit(cmd_build(sys.argv[2], float(sys.argv[3]), sys.argv[4]))
elif mode == "notes": sys.exit(cmd_notes(sys.argv[2]))
elif mode == "cut":   sys.exit(cmd_cut(sys.argv[2], float(sys.argv[3]), float(sys.argv[4]), sys.argv[5]))
elif mode == "select":sys.exit(cmd_select(sys.argv[2], sys.argv[3]))
elif mode == "test":  sys.exit(cmd_test())
PYEOF
)

bose_target() {
  pw-cli ls Node 2>/dev/null | awk '
    /node.name/ { name=tolower($0) }
    /object.id/ && (name ~ /bose/ || name ~ /soundlink/) { gsub(/[^0-9]/,"",$0); print; exit }' 2>/dev/null
}

usage() { echo "usage: mesh-looper record [secs] [out.wav] | notes <wav> | select <wav> [out] | cut <wav> <start_s> <end_s> [out] | play <wav> [--secs N] | build <wav> [--secs N] [out] | --test" >&2; }

case "${1:-}" in
  ""|--help|-h) usage ;;
  --test) LOOP_TMP="$(mktemp -d)" python3 -c "$PY" test; rc=$?; exit $rc ;;

  notes)
    wav="${2:?usage: mesh-looper notes <wav>}"
    [ -s "$wav" ] || { echo "mesh-looper: no such WAV: $wav" >&2; exit 1; }
    out="$(LOOP_SR="$SR" python3 -c "$PY" notes "$wav")" || { echo "$out"; exit 2; }
    printf 'note-timeline (onset  offset  note  Hz):\n'
    printf '%s\n' "$out" | awk -F'\t' '{printf "  %6.3fs  %6.3fs  %-4s %s\n",$1,$2,$3,$4}'
    ;;

  select)
    wav="${2:?usage: mesh-looper select <wav> [out]}"
    [ -s "$wav" ] || { echo "mesh-looper: no such WAV: $wav" >&2; exit 1; }
    mkdir -p "$LOOP_DIR"; out="${3:-$LOOP_DIR/loop_sel_$(basename "$wav")}"
    LOOP_SR="$SR" LOOP_FADE_MS="$FADE_MS" python3 -c "$PY" select "$wav" "$out"; exit $?
    ;;

  cut)
    wav="${2:?usage: mesh-looper cut <wav> <start_s> <end_s> [out]}"
    [ -s "$wav" ] || { echo "mesh-looper: no such WAV: $wav" >&2; exit 1; }
    start="${3:?need start_s}"; end="${4:?need end_s}"
    mkdir -p "$LOOP_DIR"; out="${5:-$LOOP_DIR/loop_cut_$(basename "$wav")}"
    res="$(LOOP_SR="$SR" LOOP_FADE_MS="$FADE_MS" python3 -c "$PY" cut "$wav" "$start" "$end" "$out")" || { echo "mesh-looper: ${res:-cut failed}" >&2; exit 2; }
    dur="$(printf '%s' "$res" | cut -f1)"; seam="$(printf '%s' "$res" | cut -f2)"; path="$(printf '%s' "$res" | cut -f3)"
    printf 'cut: %ss loop (seam: %s) → %s   (play it: mesh-looper play %s)\n' "$dur" "$seam" "$path" "$path"
    ;;

  record)
    secs="${2:-8}"; out="${3:-$LOOP_DIR/loop_$(date +%H%M%S).wav}"
    case "$secs" in ''|*[!0-9.]*) echo "mesh-looper: secs must be a number" >&2; exit 1;; esac
    mkdir -p "$LOOP_DIR"
    echo "mesh-looper: RECORDING ${secs}s from the mic…" >&2
    pw-record --rate "$SR" --channels 1 --format s16 - 2>/dev/null | \
      timeout "$secs" ffmpeg -loglevel error -f s16le -ar "$SR" -ac 1 -i - -y "$out" 2>/dev/null || true
    [ -s "$out" ] || { echo "mesh-looper: no audio captured (mic unavailable?)" >&2; exit 1; }
    dur="$(ffprobe -v error -show_entries format=duration -of default=nk=1:nw=1 "$out" 2>/dev/null)"
    printf 'recorded: %.2fs → %s\n' "${dur:-0}" "$out"
    ;;

  build)
    wav="${2:?usage: mesh-looper build <wav> [--secs N] [out]}"
    [ -s "$wav" ] || { echo "mesh-looper: no such WAV: $wav" >&2; exit 1; }
    secs="$PLAY_SECS"; out="$LOOP_DIR/loop_built_$(basename "$wav")"
    shift 2
    while [ $# -gt 0 ]; do case "$1" in --secs) shift; secs="$1";; *) out="$1";; esac; shift; done
    mkdir -p "$LOOP_DIR"
    res="$(LOOP_SR="$SR" LOOP_FADE_MS="$FADE_MS" python3 -c "$PY" build "$wav" "$secs" "$out")" || { echo "mesh-looper: build had a seam click — $res" >&2; }
    dur="$(printf '%s' "$res" | cut -f1)"; seam="$(printf '%s' "$res" | cut -f2)"; path="$(printf '%s' "$res" | cut -f3)"
    printf 'built loop: %ss (seam: %s) → %s\n' "$dur" "$seam" "$path"
    ;;

  play)
    wav="${2:?usage: mesh-looper play <wav> [--secs N]}"
    [ -s "$wav" ] || { echo "mesh-looper: no such WAV: $wav" >&2; exit 1; }
    secs="$PLAY_SECS"; shift 2
    while [ $# -gt 0 ]; do case "$1" in --secs) shift; secs="$1";; esac; shift; done
    if [ -e "$MUTE_FLAG" ]; then
      echo "mesh-looper: MUTE_FLAG present ($MUTE_FLAG) — refusing to play (room muted). Remove it to enable." >&2; exit 3
    fi
    loop="$(mktemp --suffix=.wav)"
    res="$(LOOP_SR="$SR" LOOP_FADE_MS="$FADE_MS" python3 -c "$PY" build "$wav" "$secs" "$loop")" || true
    seam="$(printf '%s' "$res" | cut -f2)"; dur="$(printf '%s' "$res" | cut -f1)"
    bid="$(bose_target)"
    echo "mesh-looper: LOOPING ${dur}s (seam: $seam) on the Bose (Ctrl-C to stop)…" >&2
    if [ -n "$bid" ]; then pw-play --target "$bid" "$loop" 2>/dev/null || pw-play "$loop" 2>/dev/null
    else pw-play "$loop" 2>/dev/null || aplay -q "$loop" 2>/dev/null; fi
    rm -f "$loop"
    ;;

  *) usage; exit 1 ;;
esac
