#!/usr/bin/env bash
# orphan-ok: on-demand motion-attribution probe — fuses mesh-wifi-motion (device-free RF-multipath
#   motion) with mesh-presence (personal BLE) to answer a question NEITHER answers alone: is the
#   detected motion HUMAN? wifi-motion senses movement but can't tell human/pet/fan/phantom; a
#   co-located personal device (phone/watch/earbuds) attributes it. Operator wires a scheduled axis
#   by replacing this stamp with `# reflex-cadence: <5-field cron>` + mesh-autowire; born on-demand.
# mesh-motion-source — attribute device-free WiFi motion to a source via personal-BLE co-location.
#
# WHY THIS IS NEW (not another occupancy fusion): mesh-room-sense / mesh-room-activity decide IS
# SOMEONE PRESENT (OR of signals). This decides WHAT THE MOTION IS (AND of two independent
# modalities): wifi-MOTION + a personal device in-room => HUMAN; wifi-MOTION + NO personal device
# (BLE reachable) => UNATTRIBUTED (pet/appliance/settling/phone-less person); a still field =>
# NO-MOTION. Distinct precision signal — a lone wifi-MOTION that room-sense reads as PRESENT is here
# flagged UNATTRIBUTED when no phone/watch co-locates (the operator's phone IS often the offline body
# phone, so its absence from BLE is exactly the unattributed-motion case).
#
# Honest-degraded contract (the centerpiece — no silent all-clear):
#   * wifi-motion UNAVAILABLE/UNCERTAIN        => UNKNOWN (can't attribute motion you can't detect)
#   * wifi STILL (real, reachable)             => NO-MOTION (confident — nothing to attribute)
#   * wifi MOTION + BLE scan FAILED (unreach)  => UNKNOWN (motion detected but can't attribute —
#                                                 visibly NOT "unattributed"; a failed scan must
#                                                 never read as "motion is benign/phone-less")
#   * wifi MOTION + BLE reachable, no personal => UNATTRIBUTED (genuine reading)
#   * wifi MOTION + personal device in-room    => HUMAN
# UNREACHABLE (BLE scan failed) renders visibly distinct from a genuine no-personal-device empty.
#
#   mesh-motion-source           one attribution line
#   mesh-motion-source --json    machine-readable {source, wifi, ble, personal, reason, ts}
#   mesh-motion-source --edge    emit only on source change (for cron/stream wiring)
#   mesh-motion-source --test    classify fixtures (offline)
#
# Read-only. Exit 0 = attribution assessed (may be UNKNOWN); 2 = cannot assess at all.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PERSONAL_RSSI="${MESH_MOTION_SOURCE_RSSI:--82}"   # dBm threshold for "personal device is in-room"
# Canonical personal-device patterns (DRY via mesh-patterns.sh); sensible fallback.
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true; fi
PERSONAL_RE="${MESH_PERSON_RE:-JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi|Watch|Band}"
STATE="$HOME/.mesh/.motion-source.state"

# classify_source <wifi_verdict> <wifi_reach 0/1> <ble_reach 0/1> <personal "name|rssi" or ""> [signature scatter|bulk|""]
# → echoes "SOURCE|reason" (pure, offline-testable). The honest-degraded logic lives here.
# The 5th arg (signature, 2026-07-07) folds mesh-wifi-motion's drift-DIRECTION axis into the
# UNATTRIBUTED case only: BLE says "no known device", but the RF signature can still grade whether
# a real localized body is present. scatter (mixed-sign multipath) = a moving mass blocks some paths
# while strengthening others → phone-less person/pet, NOT a global RF shift. bulk (uniform-sign) is
# equally consistent with a shared-LOS body OR a global RF/gain shift / the node itself nudged →
# weaker body evidence. It ANNOTATES the reason; the SOURCE token stays UNATTRIBUTED (vocab-safe).
classify_source() {
  local wf="$1" wfr="$2" blr="$3" pers="${4:-}" sig="${5:-}"
  if [ "$wfr" != 1 ] || [ "$wf" = "UNCERTAIN" ] || [ -z "$wf" ]; then
    echo "UNKNOWN|wifi-motion unavailable/uncertain — can't attribute motion"; return; fi
  if [ "$wf" = "STILL" ]; then
    echo "NO-MOTION|device-free field still — no motion to attribute"; return; fi
  # wifi = MOTION from here
  if [ "$blr" != 1 ]; then
    echo "UNKNOWN|motion detected but BLE scan failed — can't attribute (NOT 'unattributed')"; return; fi
  if [ -n "$pers" ]; then
    echo "HUMAN|motion co-locates with in-room personal device ${pers}"; return; fi
  # UNATTRIBUTED — no personal device. Grade body-presence via the wifi-motion drift signature.
  case "$sig" in
    scatter) echo "UNATTRIBUTED|no personal device; signature=scatter (mixed-sign multipath — a localized moving body: phone-less person/pet, not a global RF shift)";;
    bulk)    echo "UNATTRIBUTED|no personal device; signature=bulk (uniform-sign drift — shared-LOS body OR global RF/gain shift / node nudged; weaker body evidence)";;
    *)       echo "UNATTRIBUTED|motion with no personal device in range (pet/appliance/phone-less-person/settling)";;
  esac
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0
  s(){ classify_source "$@" | cut -d'|' -f1; }
  # wifi STILL (reachable) → NO-MOTION (confident empty-field)
  [ "$(s STILL 1 1 '')" = NO-MOTION ] || { echo "  FAIL: wifi STILL → NO-MOTION"; _f=1; }
  # wifi MOTION + personal device in-room → HUMAN
  [ "$(s MOTION 1 1 'Pixel-7|-71')" = HUMAN ] || { echo "  FAIL: motion + personal → HUMAN"; _f=1; }
  # wifi MOTION + BLE reachable + NO personal → UNATTRIBUTED (genuine reading)
  [ "$(s MOTION 1 1 '')" = UNATTRIBUTED ] || { echo "  FAIL: motion + no-personal → UNATTRIBUTED"; _f=1; }
  # HONEST-DEGRADED #1: wifi MOTION + BLE scan FAILED → UNKNOWN (NOT 'unattributed' — no silent all-clear)
  [ "$(s MOTION 1 0 '')" = UNKNOWN ] || { echo "  FAIL: motion + BLE-unreachable → UNKNOWN (not UNATTRIBUTED)"; _f=1; }
  # HONEST-DEGRADED #2: wifi unavailable → UNKNOWN
  [ "$(s UNCERTAIN 1 1 '')" = UNKNOWN ] || { echo "  FAIL: wifi UNCERTAIN → UNKNOWN"; _f=1; }
  [ "$(s '' 0 1 '')" = UNKNOWN ] || { echo "  FAIL: wifi unreachable → UNKNOWN"; _f=1; }
  # wifi STILL must NOT be overridden by BLE state (still field = no motion regardless)
  [ "$(s STILL 1 0 '')" = NO-MOTION ] || { echo "  FAIL: wifi STILL + BLE-down must stay NO-MOTION"; _f=1; }
  # SIGNATURE fold (2026-07-07): UNATTRIBUTED motion carries wifi-motion's drift-direction signature —
  # scatter (localized body) vs bulk (RF/shared-LOS) — to grade body-presence when BLE can't attribute.
  # It ANNOTATES the reason; the SOURCE token stays UNATTRIBUTED (vocab-safe, not a new first token).
  [ "$(s MOTION 1 1 '' scatter)" = UNATTRIBUTED ] || { echo "  FAIL: motion+scatter must keep UNATTRIBUTED token"; _f=1; }
  classify_source MOTION 1 1 '' scatter | grep -q 'signature=scatter' || { echo "  FAIL: scatter reason-note absent"; _f=1; }
  classify_source MOTION 1 1 '' bulk    | grep -q 'signature=bulk'    || { echo "  FAIL: bulk reason-note absent"; _f=1; }
  # signature is MOOT once a personal device attributes the motion (HUMAN wins over any signature)
  [ "$(s MOTION 1 1 'Pixel-7|-71' scatter)" = HUMAN ] || { echo "  FAIL: personal device must stay HUMAN despite scatter"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_source logic)"; exit 1; }
  echo "smoke-test: ok (11 attribution assertions: HUMAN/UNATTRIBUTED/NO-MOTION/UNKNOWN + BLE-unreach≠UNATTRIBUTED + signature scatter/bulk fold: 4)"
  exit 0
fi

EDGE=0; JSON=0
for a in "$@"; do case "$a" in --edge) EDGE=1;; --json) JSON=1;; esac; done

# ---- Sample wifi-motion (node-local, no phone needed) ----
wf=""; wfr=0; sig=""
_wout="$(timeout 12 mesh-wifi-motion 2>/dev/null)"; _wrc=$?
if [ "$_wrc" -eq 0 ] && [ -n "$_wout" ]; then
  wfr=1
  case "$_wout" in *MOTION*) wf="MOTION";; *STILL*) wf="STILL";; *UNCERTAIN*) wf="UNCERTAIN";; esac
  # drift-direction signature (only present on a MOTION verdict); folds into the UNATTRIBUTED grade
  case "$_wout" in *signature=scatter*) sig="scatter";; *signature=bulk*) sig="bulk";; esac
fi

# ---- Sample BLE presence + detect a co-located personal device ----
blr=0; pers=""; ble_summary="no scan"
_pout="$(timeout 15 mesh-presence 4 2>/dev/null)"; _prc=$?
if [ "$_prc" -eq 0 ] && [ -n "$_pout" ]; then
  blr=1
  # presence output: header line + "rssi|mac|name" lines, closest first. Find the strongest
  # (closest) personal device within the in-room RSSI threshold.
  pers="$(printf '%s\n' "$_pout" \
    | grep -iE "^-?[0-9]+\|[0-9A-Fa-f:]{17}\|(${PERSONAL_RE})" \
    | awk -F'|' -v thr="$PERSONAL_RSSI" '$1+0 >= thr+0 {print $3"|"$1; exit}')"
  _ndev="$(printf '%s\n' "$_pout" | grep -cE '^-?[0-9]+\|[0-9A-Fa-f:]{17}\|')"
  ble_summary="${_ndev} dev$([ -n "$pers" ] && echo ", personal: ${pers}" || echo ", no personal")"
fi

# ---- Fuse ----
verdict="$(classify_source "$wf" "$wfr" "$blr" "$pers" "$sig")"
source="${verdict%%|*}"; reason="${verdict#*|}"
TS="$(date -u +%Y-%m-%dT%H:%MZ)"
# Write STATE every run (unconditional → mtime = ran-live, not change-gated; no false-STALE).
printf '%s\n' "$source" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"source":"%s","wifi":"%s","signature":"%s","ble_reach":%s,"personal":"%s","ble":"%s","reason":"%s","ts":"%s"}\n' \
    "$source" "${wf:-unavailable}$([ "$wfr" = 1 ] || echo '/unreach')" "${sig:-none}" "$blr" "${pers:-none}" "$ble_summary" "$reason" "$TS"
  exit 0
fi
if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE" 2>/dev/null || true)"   # STATE was just written; compare to prior via .prev
  _prevf="$HOME/.mesh/.motion-source.prev"
  [ -f "$_prevf" ] && prev="$(cat "$_prevf" 2>/dev/null)" || prev=""
  printf '%s\n' "$source" > "$_prevf"
  [ "$source" = "$prev" ] && exit 0
fi
printf '[motion-source-%s] %s — %s | wifi=%s ble=%s\n' \
  "${source,,}" "$source" "$reason" "${wf:-unavailable}$([ "$wfr" = 1 ] || echo '/unreach')" "$ble_summary"
