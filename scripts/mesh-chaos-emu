#!/usr/bin/env bash
# mesh-chaos-emu — LOCAL chaos emulator for retry logic (STUDY chaos engineering 2026-07-20).
# Where mesh-chaos injects CONSENTED failures into the LIVE mesh, this emulates a flaky dependency
# hermetically so a --test can prove its retry loop actually retries: a keyed attempt counter makes
# the wrapped command fail DETERMINISTICALLY for the first N invocations, then run for real. No
# randomness (a retry test must be reproducible), no live state touched, nothing scheduled.
#
#   mesh-chaos-emu --id <key> --fail-first N [--rc R] [--hang S] [-- <cmd...>]
#   mesh-chaos-emu --id <key> --fail-rcs R[,R...] [--hang S] [-- <cmd...>]
#       attempts 1..N: [sleep S] then exit R (default 1) WITHOUT running <cmd>;
#       --fail-rcs injects the listed exit codes once per attempt, then runs <cmd>;
#       attempt N+1 onward: exec <cmd> (its rc is yours) — or exit 0 if no <cmd> given.
#   mesh-chaos-emu --count <key>     print attempts so far (0 if never called)
#   mesh-chaos-emu --reset <key>     zero the counter (start a fresh scenario)
#
# State: one counter file per key under ${MESH_CHAOS_EMU_DIR:-~/.mesh/chaos-emu}/ — path read at
# CALL time so a test's env assignment binds (the export-vs-load-time-global trap). --hang emulates
# a stuck dependency for timeout-then-retry loops (the caller's `timeout` must reap it).
#
# orphan-ok: test harness — invoked on demand by --test suites exercising retry paths, never wired.
set -uo pipefail
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help|"") usage; exit 0 ;; esac

emu_dir(){ echo "${MESH_CHAOS_EMU_DIR:-$HOME/.mesh/chaos-emu}"; }
valid_id(){
  case "${1:-}" in ''|.|..|/*|*/*|*..*) return 1 ;; esac
  return 0
}
count_of(){ local f; f="$(emu_dir)/${1:?key}.n"; [ -f "$f" ] && cat "$f" || echo 0; }

if [ "${1:-}" = --test ]; then
  tf=0
  export MESH_CHAOS_EMU_DIR="$(mktemp -d)"   # sandbox — never the real state dir
  trap 'rm -rf "$MESH_CHAOS_EMU_DIR"' EXIT TERM INT
  # leg 1 — deterministic fail-then-succeed: first 2 attempts rc!=0 and the command MUST NOT run
  # (a sentinel file would prove it ran); attempt 3 runs it for real. Falsify: drop the counter
  # increment → every attempt is attempt 1 → the loop below never succeeds.
  _s="$MESH_CHAOS_EMU_DIR/ran"
  "$0" --id l1 --fail-first 2 -- touch "$_s"; _r1=$?
  "$0" --id l1 --fail-first 2 -- touch "$_s"; _r2=$?
  [ "$_r1" -ne 0 ] && [ "$_r2" -ne 0 ] || { echo "  FAIL: attempts 1-2 must fail (got $_r1,$_r2)"; tf=1; }
  [ ! -e "$_s" ] || { echo "  FAIL: wrapped command ran during a failing attempt"; tf=1; }
  "$0" --id l1 --fail-first 2 -- touch "$_s" || { echo "  FAIL: attempt 3 must succeed"; tf=1; }
  [ -e "$_s" ] || { echo "  FAIL: wrapped command did not run on the succeeding attempt"; tf=1; }
  # leg 2 — the canonical consumer: a bounded retry loop survives 2 failures, succeeds on try 3
  _ok=""; for _i in 1 2 3; do "$0" --id l2 --fail-first 2 -- true && { _ok="$_i"; break; }; done
  [ "$_ok" = 3 ] || { echo "  FAIL: retry loop must succeed on attempt 3 (got: ${_ok:-never})"; tf=1; }
  # leg 3 — --rc honored (a retry policy that branches on rc needs the exact code, not a generic 1)
  "$0" --id l3 --fail-first 1 --rc 75; [ $? -eq 75 ] || { echo "  FAIL: --rc 75 not propagated"; tf=1; }
  # leg 4 — --hang emulates a stuck dependency: caller's timeout reaps it (rc 124), then retry lands
  timeout 1 "$0" --id l4 --fail-first 1 --hang 30; [ $? -eq 124 ] || { echo "  FAIL: hung attempt must be reapable by timeout (rc!=124)"; tf=1; }
  "$0" --id l4 --fail-first 1 -- true || { echo "  FAIL: attempt after a reaped hang must succeed"; tf=1; }
  # leg 5 — --count/--reset: the scenario is inspectable and restartable
  [ "$("$0" --count l1)" = 3 ] || { echo "  FAIL: --count l1 must read 3"; tf=1; }
  "$0" --reset l1
  [ "$("$0" --count l1)" = 0 ] || { echo "  FAIL: --reset must zero the counter"; tf=1; }
  "$0" --id l1 --fail-first 2 -- true && { echo "  FAIL: after reset, attempt 1 must fail again"; tf=1; }
  # leg 6 — scripted codes model retryable failures followed by a terminal failure.
  "$0" --id l6 --fail-rcs 75,75,125 -- true; [ "$?" -eq 75 ] || { echo "  FAIL: scripted rc 75 not propagated"; tf=1; }
  "$0" --id l6 --fail-rcs 75,75,125 -- true; [ "$?" -eq 75 ] || { echo "  FAIL: second scripted rc 75 not propagated"; tf=1; }
  "$0" --id l6 --fail-rcs 75,75,125 -- true; [ "$?" -eq 125 ] || { echo "  FAIL: scripted terminal rc 125 not propagated"; tf=1; }
  # leg 6 — ids are data, not paths: a malformed key must be rejected before it can escape the
  # emulator state directory. Falsify: accepting ../escape creates state outside the sandbox.
  "$0" --id ../escape --fail-first 1 -- true >/dev/null 2>&1 && {
    echo "  FAIL: path-like scenario id was accepted"; tf=1;
  }
  [ ! -e "$MESH_CHAOS_EMU_DIR/../escape.n" ] || {
    echo "  FAIL: malformed scenario id wrote outside the state directory"; tf=1;
  }
  [ "$tf" = 0 ] || { echo "smoke-test: FAIL (chaos-emu regressed — see asserts above)"; exit 1; }
  echo "smoke-test: ok (fail-then-succeed w/ no-run-while-failing + retry-loop-succeeds-on-3 + --rc propagated + hang-reapable-then-recovers + count/reset round-trip + scripted rc sequence + safe scenario ids)"; exit 0
fi

case "${1:-}" in
  --count)
    shift; id="${1:?--count needs a key}"
    valid_id "$id" || { echo "mesh-chaos-emu: key must be a simple scenario key" >&2; exit 2; }
    count_of "$id"; exit 0 ;;
  --reset)
    shift; id="${1:?--reset needs a key}"
    valid_id "$id" || { echo "mesh-chaos-emu: key must be a simple scenario key" >&2; exit 2; }
    rm -f "$(emu_dir)/$id.n"; exit 0 ;;
esac

id="" fail_first="" fail_rcs="" rc=1 hang=0
while [ $# -gt 0 ]; do
  case "$1" in
    --id)         id="${2:?}"; shift 2 ;;
    --fail-first) fail_first="${2:?}"; shift 2 ;;
    --fail-rcs)   fail_rcs="${2:?}"; shift 2 ;;
    --rc)         rc="${2:?}"; shift 2 ;;
    --hang)       hang="${2:?}"; shift 2 ;;
    --)           shift; break ;;
    *) echo "mesh-chaos-emu: unknown arg '$1' (see --help)" >&2; exit 2 ;;
  esac
done
[ -n "$id" ] || { echo "mesh-chaos-emu: --id is required" >&2; exit 2; }
[ -n "$fail_first" ] || [ -n "$fail_rcs" ] || {
  echo "mesh-chaos-emu: --fail-first or --fail-rcs is required" >&2; exit 2;
}
[ -z "$fail_first" ] || [ -z "$fail_rcs" ] || {
  echo "mesh-chaos-emu: --fail-first and --fail-rcs are mutually exclusive" >&2; exit 2;
}
case "$fail_first$rc$hang" in *[!0-9]*) echo "mesh-chaos-emu: N/R/S must be numeric" >&2; exit 2 ;; esac
[ -z "$fail_first" ] || [ "$fail_first" -ge 0 ] 2>/dev/null || {
  echo "mesh-chaos-emu: --fail-first must be non-negative" >&2; exit 2;
}
[ "$rc" -ge 0 ] 2>/dev/null && [ "$rc" -le 255 ] 2>/dev/null || {
  echo "mesh-chaos-emu: --rc must be between 0 and 255" >&2; exit 2;
}
valid_id "$id" || { echo "mesh-chaos-emu: --id must be a simple scenario key" >&2; exit 2; }

fail_count="$fail_first"
if [ -n "$fail_rcs" ]; then
  IFS=',' read -r -a fail_codes <<< "$fail_rcs"
  [ "${#fail_codes[@]}" -gt 0 ] || {
    echo "mesh-chaos-emu: --fail-rcs must contain at least one exit code" >&2; exit 2;
  }
  for failure_rc in "${fail_codes[@]}"; do
    case "$failure_rc" in ''|*[!0-9]*)
      echo "mesh-chaos-emu: --fail-rcs must be comma-separated numeric exit codes" >&2; exit 2 ;;
    esac
    [ "$failure_rc" -ge 1 ] && [ "$failure_rc" -le 255 ] || {
      echo "mesh-chaos-emu: --fail-rcs codes must be between 1 and 255 (0 is success, not a failure)" >&2; exit 2;
    }
  done
  fail_count="${#fail_codes[@]}"
else
  [ "$rc" -ge 1 ] || {
    echo "mesh-chaos-emu: --rc must be between 1 and 255 (0 is success, not a failure)" >&2; exit 2;
  }
  fail_count="$fail_first"
fi

d="$(emu_dir)"; mkdir -p "$d"
f="$d/$id.n"
lock="$d/$id.lock"
exec 9>"$lock"
flock 9
n=$(( $(count_of "$id") + 1 ))
printf '%s\n' "$n" > "$f"
flock -u 9
if [ "$n" -le "$fail_count" ]; then
  failure_rc="$rc"
  [ -z "$fail_rcs" ] || failure_rc="${fail_codes[$((n - 1))]}"
  [ "$hang" -gt 0 ] && sleep "$hang"
  exit "$failure_rc"
fi
[ $# -gt 0 ] && exec "$@"
exit 0
