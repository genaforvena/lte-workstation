#!/usr/bin/env bash
# reflex-cadence: 12-59/15 * * * *
# reflex-args: --edge
# mesh-situation — the META-fusion: ONE answer to "what's the mesh's situation right now?", folding the
# three load-bearing axis-fusions plus an ambient context axis so the sensors CONNECT instead of going in a circle
# (operator 2026-06-13: "have we maxed the sensors? how do we connect them?"):
#   INTERNAL  (mesh-stress)    — node thermal/load/minds/egress: is the node itself OK to work?
#   EXTERNAL  (mesh-perimeter) — outside+network+physical surroundings: is anything unusual around?
#   PHYSICAL  (mesh-arrivals)  — who/what is here right now (named devices present).
#   AMBIENT   (mesh-ambient-clock) — social clock from fixed-appliance BLE cycling.
#   INTERRUPTIBILITY (mesh-interruptibility) — whether the mesh may surface work now.
# → NOMINAL / WATCH / ALERT, the worst of the load-bearing axes; PHYSICAL and AMBIENT are context axes.
#
# CHEAP BY DESIGN (it must be runnable often on a thermally-touchy node): it does NOT re-run the heavy
# external scan each time. INTERNAL is a light live mesh-stress --json; PHYSICAL reads arrivals.state
# (no BLE scan); EXTERNAL reads mesh-perimeter's CACHED verdict (.perimeter.state). `--refresh` runs
# mesh-perimeter live first to freshen that one heavy axis.
#
# Honest-fusion ([[fusion-tools-distinguish-empty-from-failed]]): a STALE or MISSING axis is rendered
# visibly (STALE/UNKNOWN) and flips the posture to "(partial)", never silently counted as NOMINAL.
#
#   mesh-situation            cheap fold (cached external) → posture + observed axis lines
#   mesh-situation --refresh   run mesh-perimeter live first (freshens the external axis), then fold
#   mesh-situation --json      machine-readable posture + axes
#   mesh-situation --edge      REFLEX: post ONLY on posture change. ALERT emits one
#                              [escalate:tg-window] line; non-alert transitions emit [situation-change].
#   mesh-situation --test
#
# ── CAUSAL EMERGENCE: this "meta-fusion" is a MAX-SELECTOR, which is the provably NON-EMERGENT case ──
# LIVE REVIEW (complex adaptive systems / edge-of-chaos, 2026-07-06 — a concept the mesh did NOT embody:
# `grep -rl 'causal.emergence' scripts/` → 0 hits before this). Rosas, Mediano, Jensen, Seth, Barrett,
# Carhart-Harris & Bor, "Reconciling emergences: An information-theoretic approach to identify causal
# emergence in multivariate data" (PLoS Comput. Biol. 2020, doi:10.1371/journal.pcbi.1008289; reference
# impl. github.com/pmediano/ReconcilingEmergences; still-live lineage: "Improved estimators of causal
# emergence for large systems" arXiv:2601.00013 (2026) + the ΦID / Causal-Emergence-2.0 extensions,
# Mediano et al. 2025). A macro feature V of a system {Xⱼ} is CAUSALLY EMERGENT iff it carries
# information about the system's OWN FUTURE that no micro part carries alone. Practical order-1 criterion:
#     Ψ(V) := I(Vₜ ; Vₜ′) − Σⱼ I(Xⱼₜ ; Vₜ′)          Ψ>0 ⇒ emergent (SUFFICIENT, not necessary).
# THE FINDING (code-grounded, the FOLD below: "worst=$(( iw > ew ? iw : ew ))"): our posture is
# V = max(rank INTERNAL, rank EXTERNAL). A max is a SELECTOR — at every instant V EQUALS one of its parts
# (the worse axis), so that axis alone carries ~all of I(Vₜ;Vₜ′) ⇒ Ψ ≤ 0. The max-fold is ARCHITECTURALLY
# INCAPABLE of causal emergence: it can never demonstrate Ψ>0, because the macro is definitionally one of
# its parts. So the header's own claim — "META-fusion … so the sensors CONNECT instead of going in a
# circle" (operator's "how do we connect them?") — outruns the mechanism: max() does not CONNECT the axes,
# it DISCARDS every joint pattern and reports the loudest one. A genuinely emergent fold needs at least one
# JOINT-PATTERN posture rule that fires on a combination NO single axis reaches (e.g. INTERNAL nominal +
# EXTERNAL nominal but an UNKNOWN device arriving AS egress latency ticks up → WATCH), which max() cannot
# express. [[fusion-tools-distinguish-empty-from-failed]] (honest-degrade) is orthogonal — the issue here
# is not stale inputs, it's that even with all axes fresh the fold is a selector, not a synthesis.
# PROPOSED, HELD (instrument-first, per the mesh-criticality review discipline): (1) a read-only
# `--emergence` mode computing Ψ over the posture tape vs its axis tapes to MEASURE synthesis (Ψ>0 is
# conservative under plug-in-MI positive bias — the parts-sum is inflated, so a positive Ψ is HARD to
# fake, unlike the rejected power-law GOF); (2) the design fix — add a synergy rule to the fold. Both
# change an operator-facing, cry-wolf-sensitive organ's SEMANTICS, so they need validation against real
# posture tapes + steward/operator sign-off, NOT an autonomous baton edit. Full review + citations:
# ~/.mesh/knowledge/review-causal-emergence-situation-max-fold-2026-07-06.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PERIM_STATE="$HOME/.mesh/.perimeter.state"
ARR_STATE="$HOME/.mesh/arrivals.state"
ROOM_STATE="$HOME/.mesh/.room-sense.state"
RHYTHM_ABS_STATE="$HOME/.mesh/.rhythm-absence.state"   # mesh-rhythm absence lane cache (no-show notices)
AMBIENT_STATE="$HOME/.mesh/.ambient-clock.state"
INTERRUPT_STATE="$HOME/.mesh/.interruptibility.state"
ABS_STALE_MIN="${MESH_SITUATION_ABS_STALE_MIN:-90}"    # hourly writer → 90min freshness threshold
STALE_MIN="${MESH_SITUATION_STALE_MIN:-20}"     # physical/occupancy older than this → STALE
EXT_STALE_MIN="${MESH_SITUATION_EXT_STALE_MIN:-90}"  # external: hourly cron → 90min threshold
HOST="$(hostname)"; TS="$(date -u +%FT%TZ)"; NOW="$(date +%s)"

# posture-transition DEBOUNCE (cry-wolf fix 2026-06-20): the INTERNAL axis reads mesh-stress --json
# LIVE, and mesh-stress tracks thermal which genuinely oscillates 80↔99°C under mind load — so the raw
# posture flapped (8 ALERT/WATCH/NOMINAL transitions in 3h, each posting [situation-change] /
# [escalate:tg-window] = operator-facing cry-wolf). Same class fixed in mesh-therm-watch + mesh-doctor.
# .situation.state stays the bare COMMITTED posture (consumer contract: mesh-overview/sensorium/context),
# while the transition is gated on a SEPARATE debounce file: require SIT_N consecutive reads in the new
# posture before committing, with a COOLDOWN on DE-escalation (a brief dip mid-storm never posts a false
# 'recovered'). A genuine sustained worsening still escalates (SIT_N reads), just not single-sample spikes.
SIT_STATE="${MESH_SITUATION_STATE:-$HOME/.mesh/.situation.state}"
SIT_ALERT_STATE="${MESH_SITUATION_ALERT_STATE:-$HOME/.mesh/.situation-alert-state}"
SIT_N="${MESH_SITUATION_N:-2}"               # consecutive reads in a new posture before the transition commits (*/15 cadence → ≥30min sustained)
COOLDOWN="${MESH_SITUATION_COOLDOWN:-1800}"  # min seconds between posts for a DE-ESCALATION (collapses an oscillation storm to one transition)

# ---- EIGENFORM (von Foerster; formalized Kauffman) — report-only, does NOT touch POSTURE/.situation.state ----
# LIVE REVIEW (second-order cybernetics, 2026-07-28 — a von Foerster concept the mesh did NOT embody;
# distinct from the observer-COVERAGE note below, which is "the observer is part of the observed":
# eigenform is about TEMPORAL convergence of the recursive commit operator, not axis blindness).
# Von Foerster: an "object" is not pre-given — it is a TOKEN for an eigenbehavior, the FIXED POINT a
# recursive operation converges to (Obj = F(Obj)). Kauffman formalized it: the object is what recursion
# STABILIZES into; if the recursion does not converge, a reported "object" is a reification of a transient.
# CODE-GROUNDED: situation_decide() IS the recursive operator F(prior_committed, raw_obs)→committed, and
# the committed posture `ann` in .situation.state IS its eigenform — the branch `[ "$posture" = "$ann" ]`
# (raw agrees → state unchanged) is literally F(x)=x. The SIT_N debounce SUPPRESSES oscillation so the
# committed object stays calm, but it never MEASURES whether an eigenform exists at all: a raw axis that
# flaps ALERT↔NOMINAL every read has NO fixed point, yet the debounce launders that churn into a serene
# committed NOMINAL — the exact von Foerster warning (an object reported before the recursion converged).
# eigen_classify measures the eigen-RESIDUAL: over a short ring of RAW postures, the fraction that DIFFER
# from the committed object. 0 = every recent read reconfirmed it (eigenform reached, the object is real);
# high with many flips = the object is contested every read (no stable eigenform — the calm label is a
# debounce artifact). Clock-pure & side-effect-free (ring passed in) so --test drives a synthetic tape.
#   states: settled (residual 0, at the fixed point) · converging (drifting toward a new object, one-sided)
#           · churning (flips ≥ half — no eigenform, debounce masking an unstable observation) · cold (no tape)
SIT_EIGEN_RING="${MESH_SITUATION_EIGEN_RING:-$HOME/.mesh/.situation-eigen.ring}"
SIT_EIGEN_K="${MESH_SITUATION_EIGEN_K:-8}"    # raw-posture ring depth (*/15 cadence → ~2h window)
eigen_classify(){ # $1=ring (ws-sep raw postures, oldest→newest) $2=committed object → echoes "state residual_pct"
  local ring="$1" committed="$2" n=0 diff=0 flips=0 prev="" tok
  for tok in $ring; do
    n=$((n+1))
    [ "$tok" != "$committed" ] && diff=$((diff+1))
    [ -n "$prev" ] && [ "$tok" != "$prev" ] && flips=$((flips+1))
    prev="$tok"
  done
  if [ "$n" -eq 0 ]; then echo "cold 0"; return; fi
  local resid=$(( diff * 100 / n ))
  local state
  if   [ "$diff" -eq 0 ];                       then state=settled
  elif [ $(( flips * 2 )) -ge $(( n - 1 )) ];   then state=churning     # ≥ half the adjacent pairs flipped → no fixed point
  else                                                state=converging  # residual>0 but one-sided drift toward a new object
  fi
  echo "$state $resid"
}

# ---- MEMORY HORIZON (report-only) — the trust window vs the ROOM's OWN timescale ----
# LIVE REVIEW (niche construction & the extended phenotype, 2026-08-20). Lee, E. D., Flack, J. C. &
# Krakauer, D. C. (2024) "Constructing stability: optimal learning in noisy ecological niches",
# Proc. R. Soc. B 291(2033):20241606, doi:10.1098/rspb.2024.1606 (preprint: "Outsourcing Memory Through
# Niche Construction", bioRxiv 2022.09.01.506204). They derive a SCALING LAW, not a level: the optimal
# memory duration tau_m* grows SUBLINEARLY in the environment's own timescale tau_E, because the cost of
# carrying a memory is linear in its length while the payoff of extra memory in a stable world is only
# logarithmic — an environment that gets 2x calmer buys ~sqrt(2) more memory, never 2x. The niche-
# construction half is the other side: an organism that STABILIZES its environment lengthens tau_E and can
# then outsource memory to the constructed structure (their "ratchet" for slower time scales).
#
# WHAT WE DID NOT EMBODY: every staleness window in this file is a constant justified in its own comment
# by the WRITER's cadence — ABS_STALE_MIN "hourly writer -> 90min", STALE_MIN "*/5 edge reflex keeps it
# fresh". That is a claim about the PRODUCER's clock, i.e. about liveness; and under the liveness-touch
# convention (mtime re-stamped on every successful eval, value or no value) a fresh mtime is not evidence
# the VALUE is still true. tau_E — how long a reading stays a valid claim about the room — is a different
# quantity, and .room-sense.state already publishes it ON THE LINE WE PARSE: fields 2+3, `dwell_s=` (the
# current run length) and `changes_24h=` (the flip rate). We cut field 1 and throw both away. So the one
# axis that measures its own timescale is gated by a window that cannot see it. Both errors are live:
# at changes_24h=14 (tau_E ~103min) the 20min window is ~5x SHORT and we count the room as unseen on a
# reading the room says is still good (that is the partial-coverage suffix, so it reaches
# POSTURE); at changes_24h=200 (tau_E ~7min) the SAME 20min window folds a value that has already turned
# twice, with no STALE marker at all. A fixed window is correct at exactly one volatility.
#
# REPORT-ONLY BY CONSTRUCTION: this does NOT move the gate — occ_seen/POSTURE still key on STALE_MIN.
# Changing a verdict is the steward's call, and the paper supplies an EXPONENT, not the constant that
# would set the level. So we report the SCALING and refuse to invent the level: w* is anchored on the
# axis's OWN median tau_E (the fixed window taken as calibrated at TYPICAL volatility) and says only how
# far today's volatility should push it, sublinearly. The anchor ring is a SLIDING window, so its median
# turns over and w* is re-derived every run, never frozen into a source constant
# ([[records-log-is-a-sliding-window]], and the mesh-sound-reflex n=29 rot it caused).
SIT_TAU_RING="${MESH_SITUATION_TAU_RING:-$HOME/.mesh/.situation-tau.ring}"
SIT_TAU_K="${MESH_SITUATION_TAU_K:-32}"        # tau_E sample ring depth (*/15 edge cadence -> ~8h of volatility history)
SIT_TAU_MIN_N="${MESH_SITUATION_TAU_MIN_N:-6}" # below this the anchor is THIN -> w* renders na, never a guess
tau_classify(){ # $1=window_min $2=tau_E min ("na" ok) $3=ring (ws-sep tau samples) -> "verdict ratio_pct wstar rung"
  local w="$1" tau="$2" ring="$3"
  case "$tau" in ''|na|0|*[!0-9]*) echo "censored na na none"; return;; esac
  local ratio=$(( w * 100 / tau )) verdict
  if   [ "$ratio" -ge 100 ]; then verdict=over-long   # window >= mean dwell: on average the value already turned inside it (the LINEARLY costly direction)
  elif [ "$ratio" -le 25 ];  then verdict=short       # the cheaper direction (log, not linear) — but it manufactures blindness
  else                            verdict=matched; fi
  local n=0 tok; for tok in $ring; do n=$((n+1)); done
  if [ "$n" -lt "${SIT_TAU_MIN_N:-6}" ]; then echo "$verdict $ratio na thin"; return; fi
  local med; med="$(printf '%s\n' $ring | sort -n | awk '{a[NR]=$1} END{print (NR%2)?a[(NR+1)/2]:int((a[int(NR/2)]+a[int(NR/2)+1])/2)}')"
  [ "${med:-0}" -gt 0 ] 2>/dev/null || { echo "$verdict $ratio na thin"; return; }
  local wstar; wstar="$(awk -v w="$w" -v t="$tau" -v m="$med" 'BEGIN{printf "%d", (w*sqrt(t/m))+0.5}')"
  echo "$verdict $ratio $wstar median:n=$n"
}
age_min(){ # ISO-ts -> minutes ago (or 99999 if unparseable/empty)
  local t="$1" e
  [ -n "$t" ] || { echo 99999; return; }
  e="$(date -d "$t" +%s 2>/dev/null)" || { echo 99999; return; }
  echo $(( (NOW - e) / 60 ))
}
rank(){ case "$1" in ALERT)echo 3;; WATCH)echo 2;; NOMINAL)echo 1;; *)echo 0;; esac; }  # 0 = UNKNOWN

# situation_decide $posture $now → echoes the action {post-alert|post-change|silent}; updates
# .situation.state (committed posture, consumer contract) + .situation-alert-state (debounce bookkeeping:
# "announced candidate consec lastpost"). Clock-pure (now passed in) so --test drives a synthetic flap.
situation_decide(){
  local posture="$1" now="$2" ann cand consec lastpost
  read -r ann cand consec lastpost < <(cat "$SIT_ALERT_STATE" 2>/dev/null) || true
  [ -n "$ann" ] || ann="$(cat "$SIT_STATE" 2>/dev/null || echo NOMINAL)"   # seed from the live posture file (back-compat) or NOMINAL
  [ -n "$ann" ] || ann=NOMINAL
  [ "$cand" = "-" ] && cand=""
  [[ "$consec"   =~ ^[0-9]+$ ]] || consec=0
  [[ "$lastpost" =~ ^[0-9]+$ ]] || lastpost=0
  local action=silent
  if [ "$posture" = "$ann" ]; then
    cand=""; consec=0                      # back at the announced posture → cancel any pending transition
  else
    if [ "$posture" = "$cand" ]; then consec=$((consec+1)); else cand="$posture"; consec=1; fi
    if [ "$consec" -ge "$SIT_N" ]; then
      local commit=0
      if [ "$(rank "$posture")" -gt "$(rank "$ann")" ]; then
        commit=1                            # escalation (worse posture): sustained → commit, no cooldown gate
      elif [ $(( now - lastpost )) -ge "$COOLDOWN" ]; then
        commit=1                            # de-escalation (recovery): sustained AND past the cooldown
      fi
      if [ "$commit" = 1 ]; then
        ann="$posture"; cand=""; consec=0; lastpost="$now"
        [ "$posture" = ALERT ] && action=post-alert || action=post-change
      fi
    fi
  fi
  mkdir -p "$(dirname "$SIT_STATE")"
  printf '%s' "$ann" > "$SIT_STATE"
  printf '%s %s %s %s\n' "$ann" "${cand:--}" "$consec" "$lastpost" > "$SIT_ALERT_STATE"
  echo "$action"
}

if [ "${1:-}" = --test ]; then
  command -v mesh-stress >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-stress)"; exit 1; }
  command -v mesh-perimeter >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-perimeter)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  mesh-perimeter --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-perimeter --test failed)"; exit 1; }
  # mesh-stress intentionally EXITS 1 when the node is STRESSED (CRITICAL) — that nonzero is a
  # verdict, not a failure. Capture into a var FIRST so we assert on the JSON content, never on a
  # pipeline exit poisoned by `set -o pipefail` + stress's nonzero ([[pipefail-grep-q-sigpipe-false-fail]]).
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the live mesh-stress real-read below beat the
  # LIVE stress pulse + wrote the live .stress-tempwatch every smoke (and perimeter's --test above
  # stamped watchtower.beat until its writer was gated). HOME=$td keeps the read REAL (/sys+loadavg
  # are HOME-independent; mesh-pulse resolves via $HOME → skipped) while its artifacts land in the
  # sandbox; %y sig gate at the end proves the whole test moved none of the three.
  export MESH_TEST_SANDBOX=1
  _st_files="$HOME/.mesh/pulse/stress.beat $HOME/.mesh/.stress-tempwatch $HOME/.mesh/pulse/watchtower.beat"
  _st_sig=""; for _f in $_st_files; do _st_sig="$_st_sig;$(stat -c '%y %s' "$_f" 2>/dev/null || echo A)"; done
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/.mesh"
  _sj="$(HOME="$td" mesh-stress --json 2>/dev/null || true)"
  [[ "$_sj" == *'"level"'* ]] || { echo "smoke-test: FAIL (mesh-stress --json no level)"; exit 1; }
  # Stamp the synthetic external state at NOW (not a hardcoded date) — otherwise it ages past
  # EXT_STALE_MIN and the fold reads it as STALE→UNKNOWN, failing the ALERT assertion hours later.
  printf '%s\tIN\tNET\tPHY\tALERT\n' "$(date -u +%Y-%m-%dT%H:%MZ)" > "$td/.mesh/.perimeter.state"
  printf 'PRESENT\n' > "$td/.mesh/.room-sense.state"
  printf 'ACTIVE|dwell_s=600|changes_24h=12|fixture=CYCLING\n' > "$td/.mesh/.ambient-clock.state"
  printf 'UNKNOWN|na=kbd,screen|degraded=\n' > "$td/.mesh/.interruptibility.state"
  # EXPECTED-ABSENCE cache: a fresh (mtime=now) no-show notice must fold into --json + the text context
  # line, and NOT touch POSTURE (this fixture's posture is fixed by the axes above). FALSIFIABLE: drop
  # the grep of RHYTHM_ABS_STATE → expected_absence stays 0; age past ABS_STALE_MIN → honest no-data.
  printf '# %s mesh-rhythm absence\n[rhythm-absence] Commuter: usually appears ~09:00 UTC (±0.5h over 5 prior days, sampling-corrected Rayleigh); the 09:00±20m window has passed today with no appearance.\n' "$(date -u +%FT%TZ)" > "$td/.mesh/.rhythm-absence.state"
  out="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$out" | grep -q '"posture":"ALERT"' || {
    echo "smoke-test: FAIL (dry-run fold didn't honor ALERT external axis)"; exit 1;
  }
  printf '%s' "$out" | grep -q '"expected_absence":1' || { echo "smoke-test: FAIL (fresh rhythm-absence cache not folded into --json): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"ambient_clock":"ACTIVE"' || { echo "smoke-test: FAIL (fresh ambient-clock artifact not folded into --json): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"interruptibility":"UNKNOWN"' || { echo "smoke-test: FAIL (fresh interruptibility artifact not folded into --json): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"axes_total":5' || { echo "smoke-test: FAIL (interruptibility axis missing from coverage denominator): $out"; exit 1; }
  aout="$(HOME="$td" "$0" 2>/dev/null | grep '^ EXPECTED-ABSENCE')"
  printf '%s' "$aout" | grep -q 'Commuter' || { echo "smoke-test: FAIL (EXPECTED-ABSENCE context line missing the no-show device): $aout"; exit 1; }
  rm -f "$td/.mesh/.ambient-clock.state"
  uout="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$uout" | grep -q '"ambient_clock":"UNKNOWN"' || { echo "smoke-test: FAIL (missing ambient-clock artifact was not UNKNOWN): $uout"; exit 1; }
  printf '%s' "$uout" | grep -q '"axes_unseen":2' || { echo "smoke-test: FAIL (missing ambient-clock artifact did not add one unseen axis alongside interruptibility UNKNOWN): $uout"; exit 1; }
  printf '%s' "$uout" | grep -q '"axes_total":5' || { echo "smoke-test: FAIL (coverage denominator changed on missing input): $uout"; exit 1; }
  # ---- inclusive disjunction (D&G disjunctive synthesis): this fixture is a SPLIT — INTERNAL reads
  # NOMINAL (mesh-stress CALM, rank 1) while EXTERNAL reads ALERT (rank 3). The max collapses both to
  # "ALERT"; the disjunction must preserve that the axes DIVERGE (split), name the loud one (external),
  # and report the distance (spread=2). FALSIFIABLE: hardcode concordance=concordant → split fails;
  # break the spread arithmetic → spread=2 fails; swap the loud_axis test → external fails. ----
  printf '%s' "$out" | grep -q '"concordance":"split"' || { echo "smoke-test: FAIL (disjunction: int NOMINAL vs ext ALERT collapsed — not reported as split): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"spread":2' || { echo "smoke-test: FAIL (disjunction: distance between int(1) and ext(3) must be spread=2): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"loud_axis":"external"' || { echo "smoke-test: FAIL (disjunction: ALERT external is the loud axis): $out"; exit 1; }
  # ---- PHYSICAL parse vs the post-] attribution tail (found live 2026-07-05: the dash rendered
  # '?] attribution=personal:2,...' as a device NAME, doubled per unioned scan — s/\]$// assumed the
  # bracket ends the line; since mesh-presence 2026-06-21 it does not). The fixture carries BOTH
  # traps: a bracket-bearing name ([TV] ...) that a cut at the FIRST ']' would truncate, and the
  # post-] tail that the old EOL-anchored strip leaked. FALSIFIABLE: revert to s/\]$// → tail-leak
  # assertion fails; switch to s/\].*$// (first-]) → name-truncation assertion fails. ----
  printf '%s test-host n=3 devices=[-58|4A:CE:75:BB:E2:8E|? -72|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink -82|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)] attribution=personal:1,appliance:2,ambiguous:0 unidentified=public:0,random:1,unknown:0\n' "$(date -u +%FT%TZ)" > "$td/.mesh/presence.log"
  pout="$(HOME="$td" "$0" 2>/dev/null | grep '^ PHYSICAL')"
  case "$pout" in *attribution=*) echo "smoke-test: FAIL (PHYSICAL leaked the post-] attribution tail: $pout)"; exit 1;; esac
  printf '%s' "$pout" | grep -qF '[TV] Samsung 5 Series (40)' || { echo "smoke-test: FAIL (bracket-bearing device name truncated: $pout)"; exit 1; }
  printf '%s' "$pout" | grep -q '2 named device' || { echo "smoke-test: FAIL (expected 2 named devices — '?' filtered, tail dropped: $pout)"; exit 1; }
  rm -f "$td/.mesh/presence.log"
  mkdir -p "$td/.local/bin"
  cat > "$td/.local/bin/mesh-stress" <<'EOF'
#!/usr/bin/env bash
printf '{"level":"CALM","temp_c":42,"minds":1}\n'
EOF
  cat > "$td/.local/bin/mesh-perimeter" <<'EOF'
#!/usr/bin/env bash
[ "${1:-}" = --test ] && { echo ok; exit 0; }
exit 0
EOF
  cat > "$td/.local/bin/mesh-chat" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$HOME/.mesh/chat-capture"
EOF
  chmod +x "$td/.local/bin/mesh-stress" "$td/.local/bin/mesh-perimeter" "$td/.local/bin/mesh-chat"
  HOME="$td" MESH_SITUATION_N=1 MESH_SITUATION_COOLDOWN=0 "$0" --edge >/dev/null 2>&1 || {
    echo "smoke-test: FAIL (--edge ALERT dry-run failed)"; exit 1;
  }
  if grep -q '\[situation-alert\]' "$td/.mesh/chat-capture"; then
    echo "smoke-test: FAIL (--edge ALERT double-posted situation-alert)"; exit 1
  fi
  grep -q '\[escalate:tg-window\]' "$td/.mesh/chat-capture" || {
    echo "smoke-test: FAIL (--edge ALERT did not escalate)"; exit 1;
  }
  printf '%s\tIN\tNET\tPHY\tCALM\n' "$(date -u +%Y-%m-%dT%H:%MZ)" > "$td/.mesh/.perimeter.state"
  : > "$td/.mesh/chat-capture"; printf 'ALERT' > "$td/.mesh/.situation.state"
  HOME="$td" MESH_SITUATION_N=1 MESH_SITUATION_COOLDOWN=0 "$0" --edge >/dev/null 2>&1 || {
    echo "smoke-test: FAIL (--edge NOMINAL dry-run failed)"; exit 1;
  }
  grep -q '\[situation-change\]' "$td/.mesh/chat-capture" || {
    echo "smoke-test: FAIL (--edge non-alert did not post situation-change)"; exit 1;
  }
  # the from-posture must survive into the message (PREV_ANN was set in situation_decide's $(...)
  # subshell and silently lost — every transition logged "(was new)"; now captured in the parent)
  grep -q '(was ALERT)' "$td/.mesh/chat-capture" || {
    echo "smoke-test: FAIL (situation-change lost the from-posture — expected '(was ALERT)': $(cat "$td/.mesh/chat-capture"))"; exit 1;
  }
  [ "$(age_min "")" = 99999 ] || { echo "smoke-test: FAIL (age_min empty)"; exit 1; }
  # ---- inclusive disjunction: a CONCORDANT case — both load-bearing axes at the SAME severity. Stub
  # mesh-stress=CALM (NOMINAL, rank 1) + a fresh NOMINAL external → the axes AGREE, so concordance must
  # be 'concordant', spread=0, loud=none. This proves 'concordance' is not hardcoded to 'split' above:
  # the same fold produces both values from the axis relation, not a constant. ----
  printf '%s\tIN\tNET\tPHY\tCALM\n' "$(date -u +%Y-%m-%dT%H:%MZ)" > "$td/.mesh/.perimeter.state"   # CALM* → ext NOMINAL (perimeter vocab: ALERT/NOTICE/CALM)
  cjson="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$cjson" | grep -q '"concordance":"concordant"' || { echo "smoke-test: FAIL (disjunction: two agreeing NOMINAL axes not reported concordant): $cjson"; exit 1; }
  printf '%s' "$cjson" | grep -q '"spread":0' || { echo "smoke-test: FAIL (disjunction: agreeing axes must have spread=0): $cjson"; exit 1; }
  printf '%s' "$cjson" | grep -q '"loud_axis":"none"' || { echo "smoke-test: FAIL (disjunction: no single loud axis when concordant): $cjson"; exit 1; }
  # ---- synthetic posture-DEBOUNCE sequence (the cry-wolf fix is the point; clock-pure situation_decide) ----
  SIT_STATE="$td/sit"; SIT_ALERT_STATE="$td/sitalert"; SIT_N=2; COOLDOWN=1800
  printf 'NOMINAL' > "$SIT_STATE"; rm -f "$SIT_ALERT_STATE"
  dchk(){ [ "$2" = "$3" ] || { echo "  FAIL: $1 → expected '$3', got '$2'"; exit 1; }; }
  dchk "single WATCH spike (debounced)"           "$(situation_decide WATCH 0)"      silent
  dchk "2nd WATCH (sustained→commit)"             "$(situation_decide WATCH 900)"    post-change
  dchk "ALERT 1st (debounced)"                    "$(situation_decide ALERT 1800)"   silent
  dchk "ALERT 2nd (sustained→escalate)"           "$(situation_decide ALERT 2700)"   post-alert
  dchk "NOMINAL dip mid-storm (1 read, held)"     "$(situation_decide NOMINAL 3600)" silent
  dchk "ALERT flaps back (candidate absorbed)"    "$(situation_decide ALERT 4500)"   silent
  dchk "NOMINAL recover 1"                        "$(situation_decide NOMINAL 9000)" silent
  dchk "NOMINAL recover 2 (sustained+past cooldown→commit)" "$(situation_decide NOMINAL 9900)" post-change
  # cooldown must BLOCK a sustained recovery that is still inside the cooldown window
  printf 'ALERT' > "$SIT_STATE"; printf 'ALERT - 0 10000\n' > "$SIT_ALERT_STATE"
  dchk "recovery sustained but IN cooldown 1"     "$(situation_decide NOMINAL 10100)" silent
  dchk "recovery sustained but IN cooldown 2"     "$(situation_decide NOMINAL 10200)" silent
  grep -qxE 'NOMINAL|WATCH|ALERT|UNKNOWN' "$SIT_STATE" || { echo "  FAIL: .situation.state not a bare posture token: $(cat "$SIT_STATE")"; exit 1; }
  # multi-field vocab-contract assert: room-sense enriches as LABEL|dwell_s=N|changes_24h=N; occ_verdict
  # takes the LABEL field, else it displays/matches the whole "PRESENT|dwell_s=.." string.
  _mf="$(mktemp)"; printf 'PRESENT|dwell_s=99|changes_24h=3\n' > "$_mf"
  _got="$(head -1 "$_mf" 2>/dev/null | cut -d'|' -f1)"; rm -f "$_mf"
  [ "$_got" = PRESENT ] || { echo "smoke-test: FAIL (occ_verdict extraction on LABEL|dwell_s= gave '$_got', expected PRESENT)"; exit 1; }
  # sandbox honesty gate. Falsify: drop the HOME=$td on the mesh-stress call (or the watchtower gate).
  _st_sig2=""; for _f in $_st_files; do _st_sig2="$_st_sig2;$(stat -c '%y %s' "$_f" 2>/dev/null || echo A)"; done
  if [ "$_st_sig2" != "$_st_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_st_sig' → '$_st_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a=""; for _f in $_st_files; do _hr_a="$_hr_a;$(stat -c '%y %s' "$_f" 2>/dev/null || echo A)"; done
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b=""; for _f in $_st_files; do _hr_b="$_hr_b;$(stat -c '%y %s' "$_f" 2>/dev/null || echo A)"; done
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_st_sig' → '$_st_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  # ---- EIGENFORM (von Foerster): does the committed situation object hold as a fixed point under
  # re-observation? eigen_classify is clock-pure (ring passed in), so a synthetic RAW-posture tape
  # proves each verdict. FALSIFIABLE per case below. ----
  echk(){ [ "$2" = "$3" ] || { echo "  FAIL: eigenform $1 → expected '$3', got '$2'"; exit 1; }; }
  # settled: every recent raw read reconfirms the committed object → residual 0, the object is REAL.
  # (Falsify: change the settled branch to fire on diff>0 → this NOMINAL-only tape stops reading settled.)
  echk "settled (8× NOMINAL vs committed NOMINAL)" "$(eigen_classify 'NOMINAL NOMINAL NOMINAL NOMINAL NOMINAL NOMINAL NOMINAL NOMINAL' NOMINAL)" "settled 0"
  # churning: the raw axis flaps every read — NO fixed point exists, yet the debounce holds the calm
  # committed NOMINAL. This is the von Foerster reification the sidecar exists to expose. residual 50%.
  # (Falsify: remove the flips≥half branch → an alternating tape misreads as 'converging', hiding the churn.)
  echk "churning (WATCH↔NOMINAL flap under committed NOMINAL)" "$(eigen_classify 'NOMINAL WATCH NOMINAL WATCH NOMINAL WATCH NOMINAL WATCH' NOMINAL)" "churning 50"
  # converging: the object is drifting one-sidedly toward a new value (recent reads all WATCH), not
  # yet committed — residual>0 but NOT churn. (Falsify: swap to full-WATCH → would be churning=0-flip? no,
  # 0 flips over one-sided drift stays converging; a half-flip tape here would trip churning instead.)
  echk "converging (NOMINAL→WATCH one-sided drift)" "$(eigen_classify 'NOMINAL NOMINAL NOMINAL NOMINAL WATCH WATCH WATCH WATCH' NOMINAL)" "converging 50"
  # cold: no tape yet (first run before the ring fills).
  echk "cold (empty ring)" "$(eigen_classify '' NOMINAL)" "cold 0"
  # end-to-end: the EDGE cadence GROWS the ring, and --json REPORTS eigen_state without growing it.
  rm -f "$td/.mesh/.situation-eigen.ring"
  printf '%s\tIN\tNET\tPHY\tCALM\n' "$(date -u +%Y-%m-%dT%H:%MZ)" > "$td/.mesh/.perimeter.state"
  HOME="$td" MESH_SITUATION_N=1 MESH_SITUATION_COOLDOWN=0 "$0" --edge >/dev/null 2>&1 || true
  [ -s "$td/.mesh/.situation-eigen.ring" ] || { echo "smoke-test: FAIL (eigen: --edge did not grow the raw-posture ring)"; exit 1; }
  _rw1="$(wc -w < "$td/.mesh/.situation-eigen.ring")"
  ejson="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$ejson" | grep -q '"eigen_state":"' || { echo "smoke-test: FAIL (eigen: --json missing eigen_state): $ejson"; exit 1; }
  _rw2="$(wc -w < "$td/.mesh/.situation-eigen.ring")"
  [ "$_rw1" = "$_rw2" ] || { echo "smoke-test: FAIL (eigen: --json GREW the ring $_rw1→$_rw2 — only --edge may append)"; exit 1; }
  # ---- MEMORY HORIZON (Lee/Flack/Krakauer 2024): the trust window vs the room's OWN timescale ----
  # The classifier is pure (window, tau_E and the anchor ring all passed in), so the law itself is
  # asserted on synthetic tapes, not on whatever the room happens to be doing during a smoke test.
  # FALSIFIABLE, in the order a regression would arrive:
  #  (a) verdicts — window 20min against tau_E 10/40/100min must read over-long/matched/short. Swap the
  #      ratio comparison and (a) goes red.
  #  (b) SUBLINEARITY, the actual find — with the anchor median at 100min, a room 4x calmer (tau_E=400)
  #      must buy w* = 20*sqrt(4) = 40min. The naive-linear rule the mesh implicitly uses everywhere
  #      would say 80min, so the test asserts 40 AND asserts it is not 80: replace sqrt(t/m) with t/m
  #      and this goes red on both halves. That is the one assertion that would catch the exponent
  #      silently reverting to 1.
  #  (c) THIN anchor — 5 samples (< SIT_TAU_MIN_N=6) must render w*=na, never a guess off a 1-sample
  #      "median". Drop the n floor and (c) goes red.
  #  (d) CENSORED vs BLIND — tau_E=na must never render as a number, and the two absences must not
  #      collapse to one word: changes_24h=0 is a bound (>=1440min), a missing field is blindness.
  #  (e) the fold really carries it (not just the function): a fixture .room-sense.state with the dwell
  #      fields must surface tau_e_min/mem_verdict in --json and a MEMORY-HORIZON line in the text.
  #  (f) ring discipline — --json must not grow the anchor ring (only --edge may), the same trap the
  #      eigenform ring assertion above guards.
  _ring6="100 100 100 100 100 100"
  read -r _tv _tr _tw _tk < <(tau_classify 20 10 "$_ring6")
  [ "$_tv" = over-long ] || { echo "smoke-test: FAIL (memory: window 20min vs tau_E 10min must be over-long, got $_tv)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 40 "$_ring6")
  [ "$_tv" = matched ] || { echo "smoke-test: FAIL (memory: window 20min vs tau_E 40min must be matched, got $_tv)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 100 "$_ring6")
  [ "$_tv" = short ] && [ "$_tr" = 20 ] || { echo "smoke-test: FAIL (memory: window 20min vs tau_E 100min must be short/ratio 20, got $_tv/$_tr)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 400 "$_ring6")
  [ "$_tw" = 40 ] || { echo "smoke-test: FAIL (memory: SUBLINEAR law broken — anchor median 100min, tau_E 400min (4x calmer) must give w*=20*sqrt(4)=40min, got $_tw)"; exit 1; }
  [ "$_tw" != 80 ] || { echo "smoke-test: FAIL (memory: w* is the NAIVE-LINEAR 80min — the sqrt exponent reverted to 1)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 400 "100 100 100 100 100")
  [ "$_tw" = na ] && [ "$_tk" = thin ] || { echo "smoke-test: FAIL (memory: 5 samples is under the n floor — w* must be na/thin, got $_tw/$_tk)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 na "$_ring6")
  [ "$_tv" = censored ] && [ "$_tr" = na ] || { echo "smoke-test: FAIL (memory: absent tau_E must render censored/na, never a number — got $_tv/$_tr)"; exit 1; }
  # (e) the fold carries it: changes_24h=48 -> tau_E = 1440/48 = 30min; window 20min -> ratio 66 -> matched.
  printf 'PRESENT|dwell_s=900|changes_24h=48\n' > "$td/.mesh/.room-sense.state"
  _mj="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$_mj" | grep -q '"tau_e_min":"30"' || { echo "smoke-test: FAIL (memory: fold did not derive tau_E=30min from changes_24h=48): $_mj"; exit 1; }
  printf '%s' "$_mj" | grep -q '"mem_verdict":"matched"' || { echo "smoke-test: FAIL (memory: 20min window vs tau_E 30min must fold as matched): $_mj"; exit 1; }
  _mt="$(HOME="$td" "$0" 2>/dev/null | grep '^ MEMORY-HORIZON')"
  printf '%s' "$_mt" | grep -q 'tau_E=30min' || { echo "smoke-test: FAIL (memory: text line missing tau_E): $_mt"; exit 1; }
  printf '%s' "$_mt" | grep -q 'dwell_s=900' || { echo "smoke-test: FAIL (memory: text line dropped the dwell field it exists to surface): $_mt"; exit 1; }
  # (d) censored (a bound) and blind (no field) must read differently, and neither may print a number.
  printf 'PRESENT|dwell_s=90000|changes_24h=0\n' > "$td/.mesh/.room-sense.state"
  _mc="$(HOME="$td" "$0" 2>/dev/null | grep '^ MEMORY-HORIZON')"
  printf '%s' "$_mc" | grep -q 'censored' || { echo "smoke-test: FAIL (memory: changes_24h=0 is a >=1440min BOUND, not a tau_E): $_mc"; exit 1; }
  printf 'PRESENT\n' > "$td/.mesh/.room-sense.state"
  _mb="$(HOME="$td" "$0" 2>/dev/null | grep '^ MEMORY-HORIZON')"
  printf '%s' "$_mb" | grep -q 'blind' || { echo "smoke-test: FAIL (memory: a state file with no changes_24h field is BLINDNESS, not a calm room): $_mb"; exit 1; }
  case "$_mb" in *'tau_E=0'*|*'ratio=0%'*) echo "smoke-test: FAIL (memory: a missing timescale rendered as a number: $_mb)"; exit 1;; esac
  # (f) ring discipline: only --edge may append.
  printf 'PRESENT|dwell_s=900|changes_24h=48\n' > "$td/.mesh/.room-sense.state"
  printf '%s\n' "$_ring6" > "$td/.mesh/.situation-tau.ring"
  _tw1="$(wc -w < "$td/.mesh/.situation-tau.ring")"
  HOME="$td" "$0" --json >/dev/null 2>&1
  _tw2="$(wc -w < "$td/.mesh/.situation-tau.ring")"
  [ "$_tw1" = "$_tw2" ] || { echo "smoke-test: FAIL (memory: --json GREW the tau ring $_tw1->$_tw2 — only --edge may append)"; exit 1; }
  echo "smoke-test: ok (fold + ALERT escalate + posture debounce: single-spike silent, sustained commits, flap absorbed, recovery cooldown-gated + multi-field label parse + eigenform settled/churning/converging/cold + edge-grows-ring/json-reads-only + memory-horizon: verdicts, SUBLINEAR w*, thin-anchor na, censored-vs-blind, fold+json carry, tau-ring edge-only)"; exit 0
fi

EDGE=0; [ "${1:-}" = --edge ] && { EDGE=1; shift; }
MODE=fold; case "${1:-}" in --refresh) MODE=refresh;; --json) MODE=json;; esac
[ "${1:-}" = --refresh ] && [ "${2:-}" = --json ] && MODE=refresh_json

# ---- EXTERNAL: optionally freshen, then read the cache ----
if [ "$MODE" = refresh ] || [ "$MODE" = refresh_json ]; then
  timeout 70 mesh-perimeter >/dev/null 2>&1 || true   # writes .perimeter.state
fi
ext_sev=UNKNOWN; ext_msg="perimeter never run (run: mesh-situation --refresh)"; ext_age=99999
if [ -s "$PERIM_STATE" ]; then
  IFS=$'\t' read -r p_ts p_out p_net p_phy p_verdict < "$PERIM_STATE"
  ext_age="$(age_min "$p_ts")"
  case "$p_verdict" in
    ALERT*)  ext_sev=ALERT;;
    NOTICE*) ext_sev=WATCH;;
    CALM*)   ext_sev=NOMINAL;;
    *)       ext_sev=UNKNOWN;;
  esac
  if [ "$ext_age" -gt "$EXT_STALE_MIN" ]; then
    ext_msg="STALE ${ext_age}min old (out=$p_out net=$p_net phy=$p_phy) — run --refresh"; ext_sev=UNKNOWN
  else
    ext_msg="$p_verdict (out=$p_out net=$p_net phy=$p_phy, ${ext_age}min ago)"
  fi
fi

# ---- INTERNAL: light live mesh-stress --json ----
sj="$(timeout 20 mesh-stress --json 2>/dev/null || true)"
int_sev=UNKNOWN; int_msg="mesh-stress unreadable"; s_level=""
if printf '%s' "$sj" | grep -q '"level"'; then
  s_level="$(printf '%s' "$sj" | sed -n 's/.*"level":"\([^"]*\)".*/\1/p')"
  s_temp="$(printf '%s' "$sj" | sed -n 's/.*"temp_c":\([0-9-]*\).*/\1/p')"
  s_minds="$(printf '%s' "$sj" | sed -n 's/.*"minds":\([0-9]*\).*/\1/p')"
  case "$s_level" in
    CRITICAL) int_sev=ALERT;;
    STRESSED) int_sev=WATCH;;
    WARM) int_sev=WATCH;;
    CALM) int_sev=NOMINAL;;
    *) int_sev=UNKNOWN;;
  esac
  int_msg="stress=$s_level (temp=${s_temp}C minds=${s_minds})"
fi

# ---- PHYSICAL: who's around (no scan). Prefer the WARM presence.log (the */10 presence cron keeps
#      it fresh) over the un-cron'd arrivals.state — else situation's cheap mode would show a stale
#      physical axis in steady state. Union the last 2 scans (smooths single-scan BLE flicker), filter
#      to NAMED devices (drop '?' + SC-<hex> randomized). Fall back to arrivals.state if no log. ----
PRESENCE_LOG="$HOME/.mesh/presence.log"
phy_around=""; phy_n=0; phy_msg="not yet sampled (no presence.log / mesh-arrivals)"; phy_age=99999; phy_src=""
if [ -s "$PRESENCE_LOG" ]; then
  # s/\][^]]*$// strips the LAST ']' + its bracket-free tail: presence.log lines carry a
  # ' attribution=... unidentified=...' summary AFTER the closing bracket (mesh-presence 2026-06-21),
  # which the old EOL-anchored s/\]$// left embedded — the dash rendered '?] attribution=...' as a
  # device NAME (doubled per unioned scan). Device names may themselves contain ']' ([TV] Samsung...),
  # so cut at the LAST bracket, never the first — same greedy semantics as the python consumers'
  # devices=\[(.*)\] regex. A legacy line ending at ']' loses just the bracket (unchanged behavior).
  names="$(tail -n 2 "$PRESENCE_LOG" | sed -E 's/.*devices=\[//; s/\][^]]*$//' | sed -E 's/ (-[0-9])/\n\1/g' \
    | awk -F'|' 'NF>=3{n=$3; for(i=4;i<=NF;i++) n=n"|"$i; print n}' | sed 's/[[:space:]]*$//' | grep -vxE '\?|SC-[0-9A-Fa-f]+|' | sort -u)"
  phy_n="$(printf '%s\n' "$names" | awk 'NF{c++} END{print c+0}')"
  phy_around="$(printf '%s\n' "$names" | paste -sd',' - | sed 's/,/, /g')"
  phy_age="$(age_min "$(date -u -r "$PRESENCE_LOG" +%FT%TZ 2>/dev/null || echo "")")"; phy_src="presence.log"
elif [ -s "$ARR_STATE" ]; then
  phy_around="$(awk -F'\t' '{print $1}' "$ARR_STATE" | paste -sd',' - | sed 's/,/, /g')"
  phy_n="$(awk 'NF{c++} END{print c+0}' "$ARR_STATE" 2>/dev/null || echo 0)"
  phy_age="$(age_min "$(date -u -r "$ARR_STATE" +%FT%TZ 2>/dev/null || echo "")")"; phy_src="arrivals.state"
fi
if [ -n "$phy_src" ]; then
  stale=""; [ "$phy_age" -gt "$STALE_MIN" ] && stale=" [STALE ${phy_age}min]"
  if [ "$phy_n" -gt 0 ]; then phy_msg="${phy_n} named device(s) around${stale}: $phy_around"
  else phy_msg="none named in range${stale} (only randomized/unknown BLE)"; fi
fi

# ---- AMBIENT: consume mesh-ambient-clock's real state artifact (no second BLE grab) ----
# The producer's label is useful context, but must not become a posture selector: stale or missing
# BLE evidence is UNKNOWN and contributes to coverage blindness. The producer stamps the artifact on
# every successful read, so age is checked independently of the label (a fresh DATA-STALE is still a
# reachable organ honestly reporting that its input is unavailable).
ambient_clock=UNKNOWN; ambient_age=99999; ambient_msg="no ambient-clock state (run: mesh-ambient-clock)"
if [ -s "$AMBIENT_STATE" ]; then
  ambient_clock="$(head -1 "$AMBIENT_STATE" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$ambient_clock" ] || ambient_clock=UNKNOWN
  ambient_age="$(age_min "$(date -u -r "$AMBIENT_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  case "$ambient_clock" in QUIET|MODERATE|ACTIVE|NIGHT-QUIET) ;; *) ambient_clock=UNKNOWN;; esac
  if [ "$ambient_age" -gt "$STALE_MIN" ]; then
    ambient_msg="UNKNOWN (ambient-clock state ${ambient_age}min old — run: mesh-ambient-clock)"
    ambient_clock=UNKNOWN
  else
    ambient_msg="${ambient_clock} (${ambient_age}min ago)"
  fi
fi

# ---- INTERRUPTIBILITY: consume mesh-interruptibility's real state artifact ----
# This is a context axis, not a posture selector: a fresh UNKNOWN is still a live, honest reading;
# a missing/stale artifact is UNKNOWN and contributes to coverage blindness.
interruptibility=UNKNOWN; interrupt_age=99999; interrupt_msg="no interruptibility state (run: mesh-interruptibility)"
if [ -s "$INTERRUPT_STATE" ]; then
  interruptibility="$(head -1 "$INTERRUPT_STATE" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$interruptibility" ] || interruptibility=UNKNOWN
  interrupt_age="$(age_min "$(date -u -r "$INTERRUPT_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  case "$interruptibility" in DO-NOT-DISTURB|FOCUSED|RESTING|AVAILABLE|AWAY|UNKNOWN) ;; *) interruptibility=UNKNOWN;; esac
  if [ "$interrupt_age" -gt "$STALE_MIN" ]; then
    interrupt_msg="UNKNOWN (interruptibility state ${interrupt_age}min old — run: mesh-interruptibility)"
    interruptibility=UNKNOWN
  else
    interrupt_msg="${interruptibility} (${interrupt_age}min ago)"
  fi
fi

# ---- OCCUPANCY: room-sense cached verdict (*/5 edge reflex keeps it fresh) ----
occ_verdict="UNKNOWN"; occ_age=99999; occ_msg="no room-sense state (run: mesh-room-sense)"
if [ -f "$ROOM_STATE" ]; then
  occ_verdict="$(head -1 "$ROOM_STATE" 2>/dev/null | cut -d'|' -f1)"; [ -n "$occ_verdict" ] || occ_verdict=UNKNOWN  # LABEL|dwell_s=N|.. → LABEL
  occ_age="$(age_min "$(date -u -r "$ROOM_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  stale=""; [ "$occ_age" -gt "$STALE_MIN" ] && stale=" [STALE ${occ_age}min]"
  occ_msg="${occ_verdict}${stale}"
fi

# ---- MEMORY HORIZON (report-only): the fixed trust window vs the room's OWN timescale (see header) ----
occ_dwell_s=""; occ_ch24=""; tau_e=na
if [ -f "$ROOM_STATE" ]; then
  _rs="$(head -1 "$ROOM_STATE" 2>/dev/null)"
  occ_dwell_s="$(printf '%s' "$_rs" | grep -oE 'dwell_s=[0-9]+' | cut -d= -f2)"
  occ_ch24="$(printf '%s' "$_rs" | grep -oE 'changes_24h=[0-9]+' | cut -d= -f2)"
  # tau_E = mean dwell over the last day = 1440min / changes. changes_24h=0 is CENSORED, not tau_E=inf:
  # it says only tau_E >= 24h, so it renders as an absent number, never as a fabricated one
  # ([[na-must-be-a-claim-about-the-node]]). A room-sense state written before the dwell fields existed
  # (bare "PRESENT") lands here too, and must render censored rather than 0.
  [ -n "$occ_ch24" ] && [ "$occ_ch24" -gt 0 ] 2>/dev/null && tau_e=$(( 1440 / occ_ch24 ))
fi
# Grow the tau ring on the EDGE cadence ONLY — a fold/json/dash refresh is not a new observation of the
# room, and letting it append would inflate n and let a hot dash pane rewrite the anchor (same discipline
# the eigenform ring already carries, and its --test asserts).
if [ "$EDGE" = 1 ] && [ "$tau_e" != na ]; then
  { cat "$SIT_TAU_RING" 2>/dev/null | tr '\n' ' '; printf '%s' "$tau_e"; } \
    | awk -v k="$SIT_TAU_K" '{for(i=1;i<=NF;i++)a[i]=$i; s=(NF>k)?NF-k+1:1; for(i=s;i<=NF;i++)printf "%s%s",(i>s?" ":""),a[i]; print ""}' \
    > "$SIT_TAU_RING.tmp" 2>/dev/null && mv "$SIT_TAU_RING.tmp" "$SIT_TAU_RING" 2>/dev/null || true
fi
read -r mem_verdict mem_ratio mem_wstar mem_rung < <(tau_classify "$STALE_MIN" "$tau_e" "$(cat "$SIT_TAU_RING" 2>/dev/null)")

# ---- EXPECTED-ABSENCE: cached no-show notices from mesh-rhythm's absence lane (the representation-hungry
#      non-event — a device on a learned schedule that did NOT appear today; enactivism/4E scaling-up
#      landing 2026-07-29). CONTEXT ONLY — never touches POSTURE/.situation.state (additive report, like
#      DISJUNCTION/EIGENFORM). Honest-fusion: a STALE or MISSING cache is rendered as no-data (line
#      suppressed), never counted as "nothing absent". ----
absent_msg=""; absent_n=0
if [ -s "$RHYTHM_ABS_STATE" ]; then
  abs_age="$(age_min "$(date -u -r "$RHYTHM_ABS_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  if [ "$abs_age" -le "$ABS_STALE_MIN" ]; then
    absent_n="$(grep -c '^\[rhythm-absence\]' "$RHYTHM_ABS_STATE" 2>/dev/null)"; absent_n="${absent_n:-0}"
    [ "$absent_n" -gt 0 ] && absent_msg="$(grep '^\[rhythm-absence\]' "$RHYTHM_ABS_STATE" | sed -E 's/^\[rhythm-absence\] //' | paste -sd' · ' -)"
  fi
fi

# ---- FOLD: posture = worst of the two load-bearing axes (INTERNAL, EXTERNAL); PHYSICAL = context ----
iw=$(rank "$int_sev"); ew=$(rank "$ext_sev"); worst=$(( iw > ew ? iw : ew ))
case "$worst" in 3) POSTURE=ALERT;; 2) POSTURE=WATCH;; 1) POSTURE=NOMINAL;; *) POSTURE=UNKNOWN;; esac
# ---- INCLUSIVE DISJUNCTION (Deleuze & Guattari, "disjunctive synthesis", Anti-Oedipus §2.4) ----
# The fold above is the EXCLUSIVE ("restrictive") use of the disjunction: max() DECIDES either-INTERNAL-
# or-EXTERNAL and reports the loudest, effacing whether the two axes AGREE or DIVERGE — it renders
# INTERNAL=WATCH·EXTERNAL=WATCH (a broad, concordant pressure) IDENTICALLY to INTERNAL=WATCH·EXTERNAL=
# NOMINAL (a single loud axis over a calm one). D&G's INCLUSIVE ("nonrestrictive") use — "either…or…or"
# — instead AFFIRMS both terms AND the DISTANCE between them. This preserves exactly the multiplicity the
# max discards; `spread` = |rank(INTERNAL) − rank(EXTERNAL)| IS that distance between the terms.
# ADDITIVE & VERDICT-PRESERVING: it does NOT touch POSTURE or the .situation.state consumer contract, so
# unlike the joint-pattern synergy rule the causal-emergence review holds for sign-off (that INVENTS a
# new verdict), this needs none — it only reports the disjunction the fold already computed. A concordant
# WATCH (both axes) and a split WATCH (one loud) are different situations a consumer can now tell apart.
spread=$(( iw > ew ? iw - ew : ew - iw ))
if [ "$iw" -eq 0 ] || [ "$ew" -eq 0 ]; then concordance=partial   # a term unreadable — cannot affirm agreement OR divergence
elif [ "$spread" -eq 0 ]; then concordance=concordant             # both axes same severity — posture is a JOINT condition
else concordance=split; fi                                        # posture rests on ONE loud axis; the other says otherwise
if   [ "$iw" -gt "$ew" ]; then loud_axis=internal
elif [ "$ew" -gt "$iw" ]; then loud_axis=external
else loud_axis=none; fi                                           # equal ranks: no single term carries the posture
# SECOND-ORDER COVERAGE (von Foerster: the observer is part of the observed; a verdict must carry a
# description of its OWN observing). "NOMINAL" has to mean "calm AND I could see", not "calm-looking
# while half-blind". An axis is UNSEEN when THIS node can't currently resolve it: int/ext UNKNOWN/stale,
# and occupancy UNKNOWN/UNCERTAIN/stale — the room-sense eye goes dark whenever the phone is
# offline, yet it was previously EXCLUDED from the count, so a blind-on-the-room verdict read as a clean
# all-clear. Counting them is the second-order fix: the observation now includes which of its eyes are open.
unseen=0; for s in "$int_sev" "$ext_sev" "$ambient_clock" "$interruptibility"; do [ "$s" = UNKNOWN ] && unseen=$((unseen+1)); done
occ_seen=1; case "$occ_verdict" in UNKNOWN|UNCERTAIN) occ_seen=0;; esac
[ "$occ_age" -gt "$STALE_MIN" ] && occ_seen=0   # PRESENT-but-stale = can't see the room NOW
[ "$occ_seen" -eq 0 ] && unseen=$((unseen+1))
[ "$unseen" -gt 0 ] && [ "$POSTURE" != ALERT ] && POSTURE="$POSTURE (partial — $unseen/4 axes unseen)"

# ---- EIGENFORM (report-only): is the committed situation object a fixed point, or is the debounce
#      laundering a non-convergent observation? Append the RAW posture to the ring ONLY on the EDGE
#      cadence (the canonical */15 tape — json/fold READ the tape, never grow it, so a dash refresh
#      can't double-count). Classify against the committed object (ann in .situation.state). ----
_raw_posture="${POSTURE%% *}"   # strip "(partial…)" suffix → the raw NOMINAL/WATCH/ALERT/UNKNOWN this read
if [ "$EDGE" = 1 ]; then
  { cat "$SIT_EIGEN_RING" 2>/dev/null | tr '\n' ' '; printf '%s' "$_raw_posture"; } \
    | awk -v k="$SIT_EIGEN_K" '{for(i=1;i<=NF;i++)a[i]=$i; s=(NF>k)?NF-k+1:1; for(i=s;i<=NF;i++)printf "%s%s",(i>s?" ":""),a[i]; print ""}' \
    > "$SIT_EIGEN_RING.tmp" 2>/dev/null && mv "$SIT_EIGEN_RING.tmp" "$SIT_EIGEN_RING" 2>/dev/null || true
fi
_committed_obj="$(cat "$SIT_STATE" 2>/dev/null || echo "$_raw_posture")"
read -r eigen_state eigen_resid < <(eigen_classify "$(cat "$SIT_EIGEN_RING" 2>/dev/null)" "$_committed_obj")

if [ "$MODE" = json ] || [ "$MODE" = refresh_json ]; then
  # axes_unseen = the observer's self-reported blindness (reported even for ALERT, where the suffix is
  # suppressed) so a machine consumer can refuse to trust a low-coverage NOMINAL.
  # eigen_state/eigen_residual = the reported situation object's OWN temporal stability (von Foerster
  # eigenform): "settled"=fixed point reached · "churning"=no eigenform, calm label is a debounce artifact.
  # tau_e_min/mem_* = the MEMORY-HORIZON clause: the room's own timescale beside the fixed trust window
  # that gates axes_unseen. Strings, because "na" (censored / no dwell fields) is a legal value and a
  # machine consumer must not read an absent timescale as 0.
  printf '{"posture":"%s","internal":"%s","external":"%s","occupancy":"%s","ambient_clock":"%s","interruptibility":"%s","physical_count":%s,"external_age_min":%s,"ambient_age_min":%s,"interruptibility_age_min":%s,"axes_unseen":%s,"axes_total":5,"spread":%s,"concordance":"%s","loud_axis":"%s","eigen_state":"%s","eigen_residual":%s,"expected_absence":%s,"stale_window_min":%s,"tau_e_min":"%s","mem_verdict":"%s","mem_ratio_pct":"%s","mem_wstar_min":"%s","mem_anchor":"%s"}\n' \
    "${POSTURE%% *}" "$int_sev" "$ext_sev" "$occ_verdict" "$ambient_clock" "$interruptibility" "${phy_n:-0}" "$ext_age" "$ambient_age" "$interrupt_age" "$unseen" "$spread" "$concordance" "$loud_axis" "$eigen_state" "$eigen_resid" "${absent_n:-0}" "$STALE_MIN" "$tau_e" "$mem_verdict" "$mem_ratio" "$mem_wstar" "$mem_rung"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  posture_key="${POSTURE%% *}"   # strip "(partial…)" suffix → NOMINAL/WATCH/ALERT/UNKNOWN
  detail="int=${int_sev},ext=${ext_sev},occ=${occ_verdict},phy=${phy_n}"
  # Capture the posture we're LEAVING here, in the parent shell: situation_decide runs in a $(...)
  # subshell, so a variable set inside it never reaches the [situation-change] message — every
  # transition since 2026-06 logged "(was new)", losing the from-posture forensics. Same seed order
  # as situation_decide's own: alert-state ann → committed posture file → empty ("new" = first run).
  PREV_ANN="$(awk '{print $1; exit}' "$SIT_ALERT_STATE" 2>/dev/null)"
  [ -n "$PREV_ANN" ] || PREV_ANN="$(cat "$SIT_STATE" 2>/dev/null || true)"
  action="$(situation_decide "$posture_key" "$NOW")"   # debounced: commits only on SIT_N sustained reads (+ cooldown on recovery)
  case "$action" in
    post-alert)
      esc="[escalate:tg-window] situation ALERT on $(hostname): ${detail} (int=$int_sev, ext=$ext_sev). Operator action may be needed."
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="situation@$(hostname)" mesh-chat "$esc" 2>/dev/null || true
      printf '%s\n' "$posture_key" ;;
    post-change)
      msg="[situation-change] $(hostname) posture=${POSTURE} — ${detail} (was ${PREV_ANN:-new})"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="situation@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
      printf '%s\n' "$posture_key" ;;
    *) exit 0 ;;   # silent — no committed transition (debounced single-sample spike, or unchanged)
  esac
  exit 0
fi

printf '=== mesh-situation %s @ %s — %s ===\n' "$HOST" "$TS" "$POSTURE"
printf ' INTERNAL [%-8s] %s\n' "$int_sev" "$int_msg"
printf ' EXTERNAL [%-8s] %s\n' "$ext_sev" "$ext_msg"
printf ' PHYSICAL [around ] %s\n' "$phy_msg"
printf ' OCCUPANCY[room   ] %s\n' "$occ_msg"
printf ' AMBIENT  [clock  ] %s\n' "$ambient_msg"
printf ' INTERRUPTIBILITY[%-7s] %s\n' "$interruptibility" "$interrupt_msg"
# EXPECTED-ABSENCE: the representation-hungry non-event — a device on a learned schedule absent today.
# Line shown only when the fresh cache carries notices (honest no-data → no line, never a false all-present).
[ "${absent_n:-0}" -gt 0 ] && printf ' EXPECTED-ABSENCE[%s] %s\n' "$absent_n" "$absent_msg"
# inclusive disjunction: the two load-bearing terms + the distance between them, which the max-posture
# above collapses. concordant=both axes agree (broad condition) · split=posture rests on one loud axis.
printf ' DISJUNCTION[%-6s] INTERNAL=%s · EXTERNAL=%s (spread=%s, loud=%s)\n' "$concordance" "$int_sev" "$ext_sev" "$spread" "$loud_axis"
# eigenform: does the committed situation object hold as a fixed point under re-observation, or is the
# */15 debounce laundering a raw axis that never settles? churning = the calm label is not a real object.
printf ' EIGENFORM[%-7s] committed=%s · residual=%s%% over last %s raw reads\n' "$eigen_state" "$_committed_obj" "$eigen_resid" "$(cat "$SIT_EIGEN_RING" 2>/dev/null | wc -w)"
# memory horizon: the fixed staleness window (a claim about the WRITER's cadence) beside tau_E, the room's
# OWN timescale, which .room-sense.state publishes and this file has always discarded. Report-only — the
# gate above still uses STALE_MIN. w* applies the sublinear law (Lee/Flack/Krakauer 2024) from the axis's
# median tau_E: it says how far TODAY's volatility should move the window, not what the window should be.
if [ "$tau_e" = na ]; then
  # Two different absences, and they must not collapse into one word: changes_24h=0 is CENSORED (the room
  # held one value all day -> tau_E >= 24h, a bound), while a missing field is BLIND (a pre-dwell-fields
  # state file, or room-sense never ran). [[a-collapsed-reason-makes-blind-and-quiet-identical]].
  if [ "${occ_ch24:-}" = 0 ]; then _mem_why="changes_24h=0 — censored: the room held one value all day, so tau_E >= 1440min (a bound, not a number)"
  else _mem_why="no changes_24h field in .room-sense.state — blind to the room's flip rate, not a calm room"; fi
  printf ' MEMORY-HORIZON[%-7s] occupancy window=%smin · tau_E=na — %s\n' "$mem_verdict" "$STALE_MIN" "$_mem_why"
else
  printf ' MEMORY-HORIZON[%-7s] occupancy window=%smin vs tau_E=%smin (changes_24h=%s, dwell_s=%s) ratio=%s%% · w*=%s (anchor=%s, sublinear sqrt)\n' \
    "$mem_verdict" "$STALE_MIN" "$tau_e" "$occ_ch24" "${occ_dwell_s:-na}" "$mem_ratio" \
    "$([ "$mem_wstar" = na ] && echo na || echo "${mem_wstar}min")" "$mem_rung"
fi
exit 0
