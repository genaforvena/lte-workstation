NIC_RX_LOSS_STATE="${MESH_SITUATION_NIC_RX_LOSS_STATE:-$HOME/.mesh/.nic-rx-loss.state}"
NIC_RX_LOSS_MAX_AGE_S="${MESH_SITUATION_NIC_RX_LOSS_MAX_AGE_S:-900}"
NIC_TX_HEARTBEAT_STATE="${MESH_SITUATION_NIC_TX_HEARTBEAT_STATE:-$HOME/.mesh/.nic-tx-heartbeat.state}"
NIC_TX_HEARTBEAT_MAX_AGE_S="${MESH_SITUATION_NIC_TX_HEARTBEAT_MAX_AGE_S:-900}"
LINK_SPEED_TOOL="mesh-link-speed"
WIFI_TXPOWER_TOOL="${MESH_SITUATION_WIFI_TXPOWER_TOOL:-mesh-wifi-txpower}"
NVME_POWER_TOOL="mesh-nvme-power-state"
PTY_TOOL="mesh-pty-count"
OPERATOR_STATE_TOOL="${MESH_SITUATION_OPERATOR_STATE_TOOL:-mesh-operator-state}"
NODE_HEALTH_STATE="$HOME/.mesh/.node-health-state"
SYSTEM_VITALITY_STATE="$HOME/.mesh/.system-vitality-state"
OPERATOR_FIELD_STATE="${MESH_SITUATION_OPERATOR_FIELD_STATE:-$HOME/.mesh/operator-field.jsonl}"
