ROOM_STATE="$HOME/.mesh/.room-sense.state"
RHYTHM_ABS_STATE="$HOME/.mesh/.rhythm-absence.state"   # mesh-rhythm absence lane cache (no-show notices)
AMBIENT_STATE="$HOME/.mesh/.ambient-clock.state"
INTERRUPT_STATE="$HOME/.mesh/.interruptibility.state"
BARO_STATE="$HOME/.mesh/.baro-state"
AIRTIME_STATE="${MESH_SITUATION_AIRTIME_STATE:-$HOME/.mesh/.airtime.state}"
AIRTIME_MAX_AGE_S="${MESH_SITUATION_AIRTIME_MAX_AGE_S:-1200}"
DISK_LATENCY_STATE="$HOME/.mesh/.disk-latency-state"
