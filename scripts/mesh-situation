  # 0 flips over one-sided drift stays converging; a half-flip tape here would trip churning instead.)
  echk "converging (NOMINAL→WATCH one-sided drift)" "$(eigen_classify 'NOMINAL NOMINAL NOMINAL NOMINAL WATCH WATCH WATCH WATCH' NOMINAL)" "converging 50"
  # cold: no tape yet (first run before the ring fills).
  echk "cold (empty ring)" "$(eigen_classify '' NOMINAL)" "cold 0"
  # end-to-end: the EDGE cadence GROWS the ring, and --json REPORTS eigen_state without growing it.
  rm -f "$td/.mesh/.situation-eigen.ring"
  printf '%s\tIN\tNET\tPHY\tCALM\n' "$(date -u +%Y-%m-%dT%H:%MZ)" > "$td/.mesh/.perimeter.state"
  HOME="$td" MESH_SITUATION_N=1 MESH_SITUATION_COOLDOWN=0 "$0" --edge >/dev/null 2>&1 || true
  [ -s "$td/.mesh/.situation-eigen.ring" ] || { echo "smoke-test: FAIL (eigen: --edge did not grow the raw-posture ring)"; exit 1; }
  _rw1="$(wc -w < "$td/.mesh/.situation-eigen.ring")"
  ejson="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$ejson" | grep -q '"eigen_state":"' || { echo "smoke-test: FAIL (eigen: --json missing eigen_state): $ejson"; exit 1; }
  _rw2="$(wc -w < "$td/.mesh/.situation-eigen.ring")"
  [ "$_rw1" = "$_rw2" ] || { echo "smoke-test: FAIL (eigen: --json GREW the ring $_rw1→$_rw2 — only --edge may append)"; exit 1; }
  # ---- MEMORY HORIZON (Lee/Flack/Krakauer 2024): the trust window vs the room's OWN timescale ----
  # The classifier is pure (window, tau_E and the anchor ring all passed in), so the law itself is
  # asserted on synthetic tapes, not on whatever the room happens to be doing during a smoke test.
  # FALSIFIABLE, in the order a regression would arrive:
  #  (a) verdicts — window 20min against tau_E 10/40/100min must read over-long/matched/short. Swap the
  #      ratio comparison and (a) goes red.
  #  (b) SUBLINEARITY, the actual find — with the anchor median at 100min, a room 4x calmer (tau_E=400)
  #      must buy w* = 20*sqrt(4) = 40min. The naive-linear rule the mesh implicitly uses everywhere
  #      would say 80min, so the test asserts 40 AND asserts it is not 80: replace sqrt(t/m) with t/m
  #      and this goes red on both halves. That is the one assertion that would catch the exponent
  #      silently reverting to 1.
  #  (c) THIN anchor — 5 samples (< SIT_TAU_MIN_N=6) must render w*=na, never a guess off a 1-sample
  #      "median". Drop the n floor and (c) goes red.
  #  (d) CENSORED vs BLIND — tau_E=na must never render as a number, and the two absences must not
  #      collapse to one word: changes_24h=0 is a bound (>=1440min), a missing field is blindness.
  #  (e) the fold really carries it (not just the function): a fixture .room-sense.state with the dwell
  #      fields must surface tau_e_min/mem_verdict in --json and a MEMORY-HORIZON line in the text.
  #  (f) ring discipline — --json must not grow the anchor ring (only --edge may), the same trap the
  #      eigenform ring assertion above guards.
  _ring6="100 100 100 100 100 100"
  read -r _tv _tr _tw _tk < <(tau_classify 20 10 "$_ring6")
  [ "$_tv" = over-long ] || { echo "smoke-test: FAIL (memory: window 20min vs tau_E 10min must be over-long, got $_tv)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 40 "$_ring6")
  [ "$_tv" = matched ] || { echo "smoke-test: FAIL (memory: window 20min vs tau_E 40min must be matched, got $_tv)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 100 "$_ring6")
  [ "$_tv" = short ] && [ "$_tr" = 20 ] || { echo "smoke-test: FAIL (memory: window 20min vs tau_E 100min must be short/ratio 20, got $_tv/$_tr)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 400 "$_ring6")
  [ "$_tw" = 40 ] || { echo "smoke-test: FAIL (memory: SUBLINEAR law broken — anchor median 100min, tau_E 400min (4x calmer) must give w*=20*sqrt(4)=40min, got $_tw)"; exit 1; }
  [ "$_tw" != 80 ] || { echo "smoke-test: FAIL (memory: w* is the NAIVE-LINEAR 80min — the sqrt exponent reverted to 1)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 400 "100 100 100 100 100")
  [ "$_tw" = na ] && [ "$_tk" = thin ] || { echo "smoke-test: FAIL (memory: 5 samples is under the n floor — w* must be na/thin, got $_tw/$_tk)"; exit 1; }
  read -r _tv _tr _tw _tk < <(tau_classify 20 na "$_ring6")
  [ "$_tv" = censored ] && [ "$_tr" = na ] || { echo "smoke-test: FAIL (memory: absent tau_E must render censored/na, never a number — got $_tv/$_tr)"; exit 1; }
  # (e) the fold carries it: changes_24h=48 -> tau_E = 1440/48 = 30min; window 20min -> ratio 66 -> matched.
  printf 'PRESENT|dwell_s=900|changes_24h=48\n' > "$td/.mesh/.room-sense.state"
  _mj="$(HOME="$td" "$0" --json 2>/dev/null)"
  printf '%s' "$_mj" | grep -q '"tau_e_min":"30"' || { echo "smoke-test: FAIL (memory: fold did not derive tau_E=30min from changes_24h=48): $_mj"; exit 1; }
  printf '%s' "$_mj" | grep -q '"mem_verdict":"matched"' || { echo "smoke-test: FAIL (memory: 20min window vs tau_E 30min must fold as matched): $_mj"; exit 1; }
  _mt="$(HOME="$td" "$0" 2>/dev/null | grep '^ MEMORY-HORIZON')"
  printf '%s' "$_mt" | grep -q 'tau_E=30min' || { echo "smoke-test: FAIL (memory: text line missing tau_E): $_mt"; exit 1; }
  printf '%s' "$_mt" | grep -q 'dwell_s=900' || { echo "smoke-test: FAIL (memory: text line dropped the dwell field it exists to surface): $_mt"; exit 1; }
  # (d) censored (a bound) and blind (no field) must read differently, and neither may print a number.
  printf 'PRESENT|dwell_s=90000|changes_24h=0\n' > "$td/.mesh/.room-sense.state"
  _mc="$(HOME="$td" "$0" 2>/dev/null | grep '^ MEMORY-HORIZON')"
  printf '%s' "$_mc" | grep -q 'censored' || { echo "smoke-test: FAIL (memory: changes_24h=0 is a >=1440min BOUND, not a tau_E): $_mc"; exit 1; }
  printf 'PRESENT\n' > "$td/.mesh/.room-sense.state"
  _mb="$(HOME="$td" "$0" 2>/dev/null | grep '^ MEMORY-HORIZON')"
  printf '%s' "$_mb" | grep -q 'blind' || { echo "smoke-test: FAIL (memory: a state file with no changes_24h field is BLINDNESS, not a calm room): $_mb"; exit 1; }
  case "$_mb" in *'tau_E=0'*|*'ratio=0%'*) echo "smoke-test: FAIL (memory: a missing timescale rendered as a number: $_mb)"; exit 1;; esac
  # (f) ring discipline: only --edge may append.
  printf 'PRESENT|dwell_s=900|changes_24h=48\n' > "$td/.mesh/.room-sense.state"
  printf '%s\n' "$_ring6" > "$td/.mesh/.situation-tau.ring"
  _tw1="$(wc -w < "$td/.mesh/.situation-tau.ring")"
  HOME="$td" "$0" --json >/dev/null 2>&1
  _tw2="$(wc -w < "$td/.mesh/.situation-tau.ring")"
  [ "$_tw1" = "$_tw2" ] || { echo "smoke-test: FAIL (memory: --json GREW the tau ring $_tw1->$_tw2 — only --edge may append)"; exit 1; }
  echo "smoke-test: ok (fold + ALERT escalate + posture debounce: single-spike silent, sustained commits, flap absorbed, recovery cooldown-gated + multi-field label parse + eigenform settled/churning/converging/cold + edge-grows-ring/json-reads-only + memory-horizon: verdicts, SUBLINEAR w*, thin-anchor na, censored-vs-blind, fold+json carry, tau-ring edge-only)"; exit 0
fi

EDGE=0; [ "${1:-}" = --edge ] && { EDGE=1; shift; }
MODE=fold; case "${1:-}" in --refresh) MODE=refresh;; --json) MODE=json;; esac
[ "${1:-}" = --refresh ] && [ "${2:-}" = --json ] && MODE=refresh_json

# ---- EXTERNAL: optionally freshen, then read the cache ----
if [ "$MODE" = refresh ] || [ "$MODE" = refresh_json ]; then
  timeout 70 mesh-perimeter >/dev/null 2>&1 || true   # writes .perimeter.state
fi
ext_sev=UNKNOWN; ext_msg="perimeter never run (run: mesh-situation --refresh)"; ext_age=99999
if [ -s "$PERIM_STATE" ]; then
  IFS=$'\t' read -r p_ts p_out p_net p_phy p_verdict < "$PERIM_STATE"
  ext_age="$(age_min "$p_ts")"
  case "$p_verdict" in
    ALERT*)  ext_sev=ALERT;;
    NOTICE*) ext_sev=WATCH;;
    CALM*)   ext_sev=NOMINAL;;
    *)       ext_sev=UNKNOWN;;
  esac
  if [ "$ext_age" -gt "$EXT_STALE_MIN" ]; then
    ext_msg="STALE ${ext_age}min old (out=$p_out net=$p_net phy=$p_phy) — run --refresh"; ext_sev=UNKNOWN
  else
    ext_msg="$p_verdict (out=$p_out net=$p_net phy=$p_phy, ${ext_age}min ago)"
  fi
fi

# ---- INTERNAL: light live mesh-stress --json ----
sj="$(timeout 20 mesh-stress --json 2>/dev/null || true)"
int_sev=UNKNOWN; int_msg="mesh-stress unreadable"; s_level=""
if printf '%s' "$sj" | grep -q '"level"'; then
  s_level="$(printf '%s' "$sj" | sed -n 's/.*"level":"\([^"]*\)".*/\1/p')"
  s_temp="$(printf '%s' "$sj" | sed -n 's/.*"temp_c":\([0-9-]*\).*/\1/p')"
  s_minds="$(printf '%s' "$sj" | sed -n 's/.*"minds":\([0-9]*\).*/\1/p')"
  case "$s_level" in
    CRITICAL) int_sev=ALERT;;
    STRESSED) int_sev=WATCH;;
    WARM) int_sev=WATCH;;
    CALM) int_sev=NOMINAL;;
    *) int_sev=UNKNOWN;;
  esac
  int_msg="stress=$s_level (temp=${s_temp}C minds=${s_minds})"
fi

# ---- BODY POWER × STRESS: consume mesh-body-power's real phone battery artifact ----
body_power=UNKNOWN; body_power_msg="no body-power state (run: mesh-body-power)"; body_power_unreachable=1
if [ -s "$BODY_POWER_STATE" ]; then
  _bp_line="$(head -1 "$BODY_POWER_STATE" 2>/dev/null)"
  _bp_mtime="$(stat -c %Y "$BODY_POWER_STATE" 2>/dev/null || echo 0)"
  _bp_age=$(( NOW - _bp_mtime ))
  _bp_label="${_bp_line%%|*}"
  _bp_level="$(printf '%s' "$_bp_line" | sed -n 's/.*|level=\([0-9][0-9]*\)|.*/\1/p')"
  _bp_status="$(printf '%s' "$_bp_line" | sed -n 's/.*|status=\([^|]*\)|.*/\1/p')"
  case "$_bp_label:$_bp_level:$_bp_status" in
    OK:[0-9]*:*) body_power=OK; body_power_unreachable=0; body_power_msg="OK level=${_bp_level}% status=${_bp_status} (${_bp_age}s ago)" ;;
    LOW:[0-9]*:*) body_power=LOW; body_power_unreachable=0; body_power_msg="LOW level=${_bp_level}% status=${_bp_status} (${_bp_age}s ago)" ;;
  esac
  if [ "$_bp_age" -gt 2400 ]; then body_power=UNKNOWN; body_power_unreachable=1; body_power_msg="STALE body-power state ${_bp_age}s old"; fi
fi
body_power_relation=UNKNOWN
if [ "$body_power" != UNKNOWN ] && [ "$int_sev" != UNKNOWN ]; then
  case "$body_power:$int_sev" in
    LOW:ALERT|LOW:WATCH) body_power_relation=BODY-LOW+NODE-STRESSED;;
    LOW:NOMINAL) body_power_relation=BODY-LOW+NODE-CALM;;
    OK:ALERT|OK:WATCH) body_power_relation=BODY-READY+NODE-STRESSED;;
    OK:NOMINAL) body_power_relation=BODY-READY+NODE-CALM;;
  esac
fi

# ---- OPERATOR STATE × NODE STRESS: close the live operator-attention producer into this fusion ----
# Operator attention alone says where the human is; stress alone says whether the node is pressured.
# Their tuple distinguishes a calm desk from a loaded desk and remains UNKNOWN when the producer is
# absent, malformed, or unreachable. The live producer is a required input for JSON/edge honesty.
operator_state=UNKNOWN; operator_state_msg="no live operator-state reading (run: mesh-operator-state)"; operator_state_unreachable=1
_osj="$(timeout 45 "$OPERATOR_STATE_TOOL" --json 2>/dev/null || true)"
_os_state="$(printf '%s' "$_osj" | sed -n 's/.*"state":"\([A-Z-]*\)".*/\1/p' | head -1)"
case "$_os_state" in
  AT-DESK|AT-PHONE|NEARBY|HOME-IDLE|AWAY|ASLEEP|COVERED|UNKNOWN)
    operator_state="$_os_state"; operator_state_unreachable=0
    operator_state_msg="${operator_state} (live mesh-operator-state)" ;;
  *) operator_state_msg="UNKNOWN (operator-state producer unreachable or malformed — run: mesh-operator-state)" ;;
esac
operator_stress_relation=UNKNOWN
if [ "$operator_state_unreachable" -eq 0 ] && [ "$int_sev" != UNKNOWN ] && [ "$operator_state" != UNKNOWN ]; then
  case "$operator_state:$int_sev" in
    AT-DESK:NOMINAL) operator_stress_relation=OPERATOR-AT-DESK+NODE-CALM ;;
    AT-DESK:WATCH|AT-DESK:ALERT) operator_stress_relation=OPERATOR-AT-DESK+NODE-STRESSED ;;
    AT-PHONE:NOMINAL|NEARBY:NOMINAL|HOME-IDLE:NOMINAL) operator_stress_relation=OPERATOR-PRESENT+NODE-CALM ;;
    AT-PHONE:WATCH|AT-PHONE:ALERT|NEARBY:WATCH|NEARBY:ALERT|HOME-IDLE:WATCH|HOME-IDLE:ALERT) operator_stress_relation=OPERATOR-PRESENT+NODE-STRESSED ;;
    AWAY:NOMINAL|ASLEEP:NOMINAL|COVERED:NOMINAL) operator_stress_relation=OPERATOR-ABSENT+NODE-CALM ;;
    AWAY:WATCH|AWAY:ALERT|ASLEEP:WATCH|ASLEEP:ALERT|COVERED:WATCH|COVERED:ALERT) operator_stress_relation=OPERATOR-ABSENT+NODE-STRESSED ;;
  esac
fi

# ---- OPERATOR FIELD MOOD × NODE STRESS: close the live operator-field producer into this fusion ----
# The JSONL producer carries a soft mood observation that is not present in mesh-operator-state.
# Read only its newest real record; missing, stale, malformed, or unknown mood stays UNKNOWN and
# makes machine/edge output exit 2. The tuple with node stress is the consumer-side closure.
operator_field_state=UNKNOWN; operator_field_mood=UNKNOWN; operator_field_stress_relation=UNKNOWN
operator_field_msg="no live operator-field artifact (run: mesh-operator-field)"; operator_field_unreachable=1
if [ -s "$OPERATOR_FIELD_STATE" ]; then
  operator_field_age_s=$(( NOW - $(stat -c %Y "$OPERATOR_FIELD_STATE" 2>/dev/null || echo 0) ))
  read -r _of_state _of_mood < <(tail -1 "$OPERATOR_FIELD_STATE" 2>/dev/null | python3 -c '
import json, sys
try:
    d=json.load(sys.stdin); f=d.get("f", {})
    state=f.get("state"); mood=f.get("mood")
    mood=mood.split(",", 1)[0].strip() if isinstance(mood, str) else ""
    print(state or "UNKNOWN", mood or "UNKNOWN")
except Exception:
    print("UNKNOWN UNKNOWN")
' 2>/dev/null)
  case "$_of_state" in AT-DESK|AT-PHONE|NEARBY|HOME-IDLE|AWAY|ASLEEP|COVERED|UNKNOWN) operator_field_state="$_of_state";; esac
  case "$_of_mood" in CALM|QUIET|UNKNOWN) operator_field_mood="$_of_mood";; esac
  if [ "$operator_field_age_s" -lt 0 ] || [ "$operator_field_age_s" -gt $((STALE_MIN * 60)) ]; then
    operator_field_msg="UNKNOWN (operator-field artifact stale — run: mesh-operator-field)"
    operator_field_state=UNKNOWN; operator_field_mood=UNKNOWN
  elif [ "$operator_field_state" = UNKNOWN ] || [ "$operator_field_mood" = UNKNOWN ]; then
    operator_field_msg="UNKNOWN (operator-field record malformed or mood unavailable — run: mesh-operator-field)"
  else
    operator_field_unreachable=0
    operator_field_msg="state=${operator_field_state}, mood=${operator_field_mood} (${operator_field_age_s}s ago)"
  fi
fi
if [ "$operator_field_unreachable" -eq 0 ] && [ "$int_sev" != UNKNOWN ]; then
  case "$operator_field_mood:$int_sev" in
    CALM:NOMINAL|QUIET:NOMINAL) operator_field_stress_relation=OPERATOR-FIELD-CALM+NODE-CALM;;
    CALM:WATCH|CALM:ALERT|QUIET:WATCH|QUIET:ALERT) operator_field_stress_relation=OPERATOR-FIELD-CALM+NODE-STRESSED;;
  esac
fi

# ---- NODE HEALTH: consume mesh-node-health's five-minute fused state artifact ----
# This adds a second view of internal health for readers, not a new posture selector. A fresh
# UNKNOWN is still a reachable producer report; missing, stale, or malformed evidence stays UNKNOWN
# and exits 2 in machine/edge modes. The ten-minute bound matches mesh-node-health's own input rail.
node_health=UNKNOWN; node_health_age=99999; node_health_msg="no node-health state (run: mesh-node-health)"; node_health_unreachable=1
if [ -s "$NODE_HEALTH_STATE" ]; then
  _nh_line="$(head -1 "$NODE_HEALTH_STATE" 2>/dev/null)"
  _nh_label="${_nh_line%%|*}"
  _nh_mtime="$(stat -c %Y "$NODE_HEALTH_STATE" 2>/dev/null || echo 0)"
  _nh_age_s=$(( NOW - _nh_mtime ))
  node_health_age=$(( _nh_age_s / 60 ))
  case "$_nh_label" in HEALTHY|DEGRADED|CRITICAL|UNKNOWN) ;; *) _nh_label=UNKNOWN; _nh_age_s=99999;; esac
  if [ "$_nh_age_s" -lt 0 ] || [ "$_nh_age_s" -gt 600 ]; then
    node_health_msg="UNKNOWN (node-health state ${node_health_age}min old — run: mesh-node-health)"
  else
    node_health="$_nh_label"; node_health_unreachable=0
    node_health_msg="${node_health} (${node_health_age}min ago)"
  fi
fi

# ---- SYSTEM VITALITY × NODE STRESS: consume the live hardware-health fusion ----
# mesh-system-vitality is a real, fresh cross-sense artifact (power, P-state, storage, and
# node-health). Pairing it with the independently live stress read closes that producer link without
# promoting either aggregate to a new posture selector. Missing, stale, or malformed state remains
# UNKNOWN and makes machine/edge modes exit 2.
system_vitality=UNKNOWN; system_vitality_age=99999
system_vitality_msg="no system-vitality state (run: mesh-system-vitality)"; system_vitality_unreachable=1
if [ -s "$SYSTEM_VITALITY_STATE" ]; then
  _sv_line="$(head -1 "$SYSTEM_VITALITY_STATE" 2>/dev/null)"
  _sv_label="${_sv_line%%|*}"
  _sv_age_s=$(( NOW - $(stat -c %Y "$SYSTEM_VITALITY_STATE" 2>/dev/null || echo 0) ))
  system_vitality_age=$(( _sv_age_s / 60 ))
  case "$_sv_label" in HEALTHY|DEGRADED|CRITICAL|UNKNOWN) ;; *) _sv_label=UNKNOWN ;; esac
  if [ "$_sv_age_s" -lt 0 ] || [ "$_sv_age_s" -gt 1800 ]; then
    system_vitality_msg="UNKNOWN (system-vitality state ${system_vitality_age}min old — run: mesh-system-vitality)"
  elif [ "$_sv_label" = UNKNOWN ]; then
    system_vitality_msg="UNKNOWN (malformed system-vitality artifact — run: mesh-system-vitality)"
  else
    system_vitality="$_sv_label"; system_vitality_unreachable=0
    system_vitality_msg="${system_vitality} (${system_vitality_age}min ago)"
  fi
fi
vitality_stress_relation=UNKNOWN
if [ "$system_vitality_unreachable" -eq 0 ] && [ "$int_sev" != UNKNOWN ]; then
  case "$system_vitality:$int_sev" in
    HEALTHY:NOMINAL) vitality_stress_relation=VITALITY-HEALTHY+NODE-CALM;;
    HEALTHY:WATCH|HEALTHY:ALERT) vitality_stress_relation=VITALITY-HEALTHY+NODE-STRESSED;;
    DEGRADED:NOMINAL|CRITICAL:NOMINAL) vitality_stress_relation=VITALITY-DEGRADED+NODE-CALM;;
    DEGRADED:WATCH|DEGRADED:ALERT|CRITICAL:WATCH|CRITICAL:ALERT) vitality_stress_relation=VITALITY-DEGRADED+NODE-STRESSED;;
  esac
fi

# ---- CHASSIS ACTIVITY: consume mesh-acpi-event and relate it to node stress ----
# ACPI activity alone is only firmware-visible wake/IRQ activity; stress alone is only node load.
# The joint labels below are the useful relation: a chassis event while the node is under pressure
# is different from either axis alone.  The producer stamps its state on every successful read, so
# age is checked independently of its label.  Missing/stale/malformed evidence stays UNKNOWN and
# makes JSON/edge exit 2; no cached quiet value can masquerade as a live all-clear.
acpi_label=UNKNOWN; acpi_age=99999; acpi_msg="no ACPI-event state (run: mesh-acpi-event)"; acpi_unreachable=1
if [ -s "$ACPI_STATE" ]; then
  acpi_label="$(awk -F= '$1=="label"{print $2; exit}' "$ACPI_STATE" 2>/dev/null)"
  acpi_age=$(( (NOW - $(stat -c %Y "$ACPI_STATE" 2>/dev/null || echo 0)) / 60 ))
  case "$acpi_label" in EVENT|QUIET|UNCOVERED) ;; *) acpi_label=UNKNOWN ;; esac
  if [ "$acpi_age" -gt "$STALE_MIN" ]; then
    acpi_msg="UNKNOWN (ACPI-event state ${acpi_age}min old — run: mesh-acpi-event)"
    acpi_label=UNKNOWN
  elif [ "$acpi_label" = UNKNOWN ]; then
    acpi_msg="UNKNOWN (malformed ACPI-event artifact — run: mesh-acpi-event)"
  else
    acpi_unreachable=0; acpi_msg="${acpi_label} (${acpi_age}min ago)"
  fi
fi
acpi_relation=UNKNOWN
if [ "$acpi_unreachable" -eq 0 ]; then
  if [ "$acpi_label" = EVENT ] && { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; }; then
    acpi_relation=WAKE-UNDER-PRESSURE
  elif [ "$acpi_label" = EVENT ] && [ "$int_sev" = NOMINAL ]; then
    acpi_relation=WAKE-CALM
  else
    acpi_relation=NO-JOINT-EVENT
  fi
fi

# ---- NOTE 3 MAGNETIC FIELD × ACPI: consume the live magnetic artifact and pair it with wake ----
# Magnetic disturbance alone is a field change; ACPI alone is firmware-visible chassis activity.
# Their joint labels distinguish a magnetic wake from a quiet-field wake. Missing, stale, malformed,
# or unreachable evidence stays UNKNOWN and makes JSON/edge exit 2.
magnetic_status=UNKNOWN; magnetic_acpi_relation=UNKNOWN; magnetic_coverage=0/1
magnetic_unreachable=1; magnetic_msg="no fresh Note 3 magnetic-field artifact"
if [ -s "$MAG_STATE" ]; then
  _mag_line="$(head -1 "$MAG_STATE" 2>/dev/null)"
  IFS='|' read -r _mag_label _mag_x _mag_y _mag_z _mag_tick _mag_ts <<<"$_mag_line"
  _mag_age=$(( NOW - $(stat -c %Y "$MAG_STATE" 2>/dev/null || echo 0) ))
  if [ "$_mag_age" -le $((STALE_MIN * 60)) ] && [[ "$_mag_label" =~ ^(INIT|STABLE|DISTURBED|FROZEN)$ ]] \
     && [[ "$_mag_x" =~ ^-?[0-9]+([.][0-9]+)?$ ]] && [[ "$_mag_y" =~ ^-?[0-9]+([.][0-9]+)?$ ]] \
     && [[ "$_mag_z" =~ ^-?[0-9]+([.][0-9]+)?$ ]] && [[ "$_mag_tick" =~ ^[0-9]+$ ]] && [ -n "$_mag_ts" ]; then
    magnetic_status="LIVE"; magnetic_coverage=1/1; magnetic_unreachable=0
    magnetic_msg="live Note 3 field=${_mag_label} (${_mag_age}s ago)"
    if [ "$acpi_unreachable" -eq 0 ]; then
      if [ "$acpi_label" = EVENT ] && [ "$_mag_label" = DISTURBED ]; then
        magnetic_acpi_relation=MAG-DISTURBANCE-WAKE
      elif [ "$acpi_label" = EVENT ]; then
        magnetic_acpi_relation=MAG-QUIET-WAKE
      else
        magnetic_acpi_relation=NO-JOINT-MAG-WAKE
      fi
    fi
  else
    magnetic_msg="UNKNOWN (Note 3 magnetic-field artifact stale, malformed, or unreachable — run: mesh-note3-mag)"
  fi
fi

# ---- PHYSICAL: who's around (no scan). Prefer the WARM presence.log (the */10 presence cron keeps
#      it fresh) over the un-cron'd arrivals.state — else situation's cheap mode would show a stale
#      physical axis in steady state. Union the last 2 scans (smooths single-scan BLE flicker), filter
#      to NAMED devices (drop '?' + SC-<hex> randomized). Fall back to arrivals.state if no log. ----
PRESENCE_LOG="$HOME/.mesh/presence.log"
phy_around=""; phy_n=0; phy_msg="not yet sampled (no presence.log / mesh-arrivals)"; phy_age=99999; phy_src=""
if [ -s "$PRESENCE_LOG" ]; then
  # s/\][^]]*$// strips the LAST ']' + its bracket-free tail: presence.log lines carry a
  # ' attribution=... unidentified=...' summary AFTER the closing bracket (mesh-presence 2026-06-21),
  # which the old EOL-anchored s/\]$// left embedded — the dash rendered '?] attribution=...' as a
  # device NAME (doubled per unioned scan). Device names may themselves contain ']' ([TV] Samsung...),
  # so cut at the LAST bracket, never the first — same greedy semantics as the python consumers'
  # devices=\[(.*)\] regex. A legacy line ending at ']' loses just the bracket (unchanged behavior).
  names="$(tail -n 2 "$PRESENCE_LOG" | sed -E 's/.*devices=\[//; s/\][^]]*$//' | sed -E 's/ (-[0-9])/\n\1/g' \
    | awk -F'|' 'NF>=3{n=$3; for(i=4;i<=NF;i++) n=n"|"$i; print n}' | sed 's/[[:space:]]*$//' | grep -vxE '\?|SC-[0-9A-Fa-f]+|' | sort -u)"
  phy_n="$(printf '%s\n' "$names" | awk 'NF{c++} END{print c+0}')"
  phy_around="$(printf '%s\n' "$names" | paste -sd',' - | sed 's/,/, /g')"
  phy_age="$(age_min "$(date -u -r "$PRESENCE_LOG" +%FT%TZ 2>/dev/null || echo "")")"; phy_src="presence.log"
elif [ -s "$ARR_STATE" ]; then
  phy_around="$(awk -F'\t' '{print $1}' "$ARR_STATE" | paste -sd',' - | sed 's/,/, /g')"
  phy_n="$(awk 'NF{c++} END{print c+0}' "$ARR_STATE" 2>/dev/null || echo 0)"
  phy_age="$(age_min "$(date -u -r "$ARR_STATE" +%FT%TZ 2>/dev/null || echo "")")"; phy_src="arrivals.state"
fi
if [ -n "$phy_src" ]; then
  stale=""; [ "$phy_age" -gt "$STALE_MIN" ] && stale=" [STALE ${phy_age}min]"
  if [ "$phy_n" -gt 0 ]; then phy_msg="${phy_n} named device(s) around${stale}: $phy_around"
  else phy_msg="none named in range${stale} (only randomized/unknown BLE)"; fi
fi

# ---- AMBIENT: consume mesh-ambient-clock's real state artifact (no second BLE grab) ----
# The producer's label is useful context, but must not become a posture selector: stale or missing
# BLE evidence is UNKNOWN and contributes to coverage blindness. The producer stamps the artifact on
# every successful read, so age is checked independently of the label (a fresh DATA-STALE is still a
# reachable organ honestly reporting that its input is unavailable).
ambient_clock=UNKNOWN; ambient_age=99999; ambient_msg="no ambient-clock state (run: mesh-ambient-clock)"
if [ -s "$AMBIENT_STATE" ]; then
  ambient_clock="$(head -1 "$AMBIENT_STATE" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$ambient_clock" ] || ambient_clock=UNKNOWN
  ambient_age="$(age_min "$(date -u -r "$AMBIENT_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  case "$ambient_clock" in QUIET|MODERATE|ACTIVE|NIGHT-QUIET) ;; *) ambient_clock=UNKNOWN;; esac
  if [ "$ambient_age" -gt "$STALE_MIN" ]; then
    ambient_msg="UNKNOWN (ambient-clock state ${ambient_age}min old — run: mesh-ambient-clock)"
    ambient_clock=UNKNOWN
  else
    ambient_msg="${ambient_clock} (${ambient_age}min ago)"
  fi
fi

# ---- BAROMETER: consume mesh-baro's live phone artifact and pair it with the BLE social clock ----
# This is deliberately a relation, not another scalar roll-call: pressure trend is only interpreted
# alongside the appliance-activity label.  A missing/stale barometer is an unreachable producer, so
# the closed link remains UNKNOWN and this consumer exits 2 after rendering the partial artifact.
baro_trend=UNKNOWN; baro_age=99999; baro_msg="no barometer state (run: mesh-baro)"; baro_unreachable=1
if [ -s "$BARO_STATE" ]; then
  read -r baro_hpa baro_trend _baro_base < "$BARO_STATE" || true
  case "$baro_hpa" in ''|*[!0-9.]* ) baro_trend=UNKNOWN;; esac
  case "$baro_trend" in RISING|FALLING|STABLE) ;; *) baro_trend=UNKNOWN;; esac
  baro_age=$(( (NOW - $(stat -c %Y "$BARO_STATE" 2>/dev/null || echo 0)) / 60 ))
  if [ "$baro_age" -gt "$STALE_MIN" ]; then
    baro_trend=UNKNOWN; baro_msg="UNKNOWN (barometer state ${baro_age}min old — run: mesh-baro)"
  elif [ "$baro_trend" = UNKNOWN ]; then
    baro_msg="UNKNOWN (malformed barometer artifact — run: mesh-baro)"
  else
    baro_unreachable=0; baro_msg="${baro_trend} ${baro_hpa}hPa (${baro_age}min ago)"
  fi
fi
ambient_relation=UNKNOWN
if [ "$baro_unreachable" -eq 0 ] && [ "$ambient_clock" != UNKNOWN ]; then
  case "${ambient_clock}:${baro_trend}" in
    ACTIVE:RISING|MODERATE:RISING) ambient_relation=ACTIVITY_PRESSURE_RISING;;
    QUIET:FALLING|NIGHT-QUIET:FALLING) ambient_relation=QUIET_PRESSURE_FALLING;;
    *) ambient_relation="MIXED_${ambient_clock}_${baro_trend}";;
  esac
fi

# ---- RF AIRTIME × NODE STRESS: consume mesh-airtime's measured QBSS artifact ----
# The airtime producer is on-demand because a fresh read may rescan the shared radio.  Its state is
# nevertheless written every run, so this consumer can require a bounded fresh artifact without
# launching a second scan.  RF utilization and node stress are distinct axes; only their tuple names
# the joint condition.  Missing/stale/malformed state stays UNKNOWN and closes the link with rc=2.
airtime=UNKNOWN; airtime_msg="no RF-airtime state (run: mesh-airtime)"; airtime_unreachable=1
airtime_age_s=999999
if [ -s "$AIRTIME_STATE" ]; then
  airtime_line="$(head -1 "$AIRTIME_STATE" 2>/dev/null || true)"
  airtime="${airtime_line%%|*}"
  case "$airtime" in
    QUIET|LIGHT|BUSY|SATURATED|NO-REPORTERS) ;;
    *) airtime=UNKNOWN ;;
  esac
  airtime_age_s=$(( NOW - $(stat -c %Y "$AIRTIME_STATE" 2>/dev/null || echo 0) ))
  if [ "$airtime_age_s" -lt 0 ] || [ "$airtime_age_s" -gt "$AIRTIME_MAX_AGE_S" ]; then
    airtime=UNKNOWN
    airtime_msg="UNKNOWN (RF-airtime state stale — run: mesh-airtime)"
  elif [ "$airtime" = UNKNOWN ]; then
    airtime_msg="UNKNOWN (malformed RF-airtime artifact — run: mesh-airtime)"
  else
    airtime_unreachable=0
    airtime_msg="${airtime} ($(printf '%s' "$airtime_line" | cut -d'|' -f2-), ${airtime_age_s}s ago)"
  fi
fi
airtime_stress_relation=UNKNOWN
if [ "$airtime_unreachable" -eq 0 ]; then
  if { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; } && { [ "$airtime" = BUSY ] || [ "$airtime" = SATURATED ]; }; then
    airtime_stress_relation=RF-AIRTIME+NODE-STRESS
  elif [ "$int_sev" = NOMINAL ] && { [ "$airtime" = QUIET ] || [ "$airtime" = LIGHT ]; }; then
    airtime_stress_relation=RF-AIR-CALM+NODE-CALM
  else
    airtime_stress_relation=NO-JOINT-EVENT
  fi
fi

# ---- LINK CAPACITY: consume the producer's real negotiated speed and relate it to node stress ----
# A low link alone is only a link fact; stress alone is only a node fact.  NODE-BOUND names the joint
# condition where both axes say the node is under pressure and the live link is limited to <=100 Mb/s.
# The producer is invoked live (no cached value can masquerade as current capacity); missing or
# malformed output stays UNKNOWN and closes this consumer link with rc=2 in machine/edge modes.
link_speed_mbps=UNKNOWN; link_speed_json='"UNKNOWN"'; link_speed_msg="no live link-speed reading (run: mesh-link-speed)"; link_unreachable=1
lsj="$(timeout 15 "$LINK_SPEED_TOOL" --json 2>/dev/null || true)"
if printf '%s' "$lsj" | grep -q '"status":"LIVE"'; then
  link_speed_mbps="$(printf '%s' "$lsj" | sed -n 's/.*"speed_mbps":\([0-9][0-9]*\).*/\1/p' | head -1)"
  if [ -n "$link_speed_mbps" ]; then
    link_unreachable=0
    link_speed_json="$link_speed_mbps"
    link_speed_msg="${link_speed_mbps}Mb/s (live negotiated capacity)"
  else
    link_speed_mbps=UNKNOWN; link_speed_json='"UNKNOWN"'
    link_speed_msg="UNKNOWN (malformed link-speed artifact — run: mesh-link-speed)"
  fi
fi
pressure_link_relation=UNKNOWN
if [ "$link_unreachable" -eq 0 ]; then
  if { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; } && [ "$link_speed_mbps" -le 100 ] 2>/dev/null; then
    pressure_link_relation=NODE-BOUND
  else
    pressure_link_relation=NO-JOINT-EVENT
  fi
fi

# ---- WI-FI TX POWER × NODE STRESS: close the live radio-power producer to this fusion ----
# Radio power alone is a setting; node stress alone is a pressure state.  Only their live tuple
# names the coupled context.  Missing or malformed iw output remains UNKNOWN and makes machine/
# edge modes exit 2; no cached radio value can masquerade as current evidence.
wifi_txpower_dbm=UNKNOWN; wifi_txpower_json='"UNKNOWN"'; wifi_txpower_msg="no live Wi-Fi txpower reading (run: mesh-wifi-txpower)"; wifi_txpower_unreachable=1
wtpj="$(timeout 8 "$WIFI_TXPOWER_TOOL" --json 2>/dev/null || true)"
_wtp="$(printf '%s' "$wtpj" | sed -n 's/.*"txpower_dbm":\(-\?[0-9][0-9]*\(\.[0-9][0-9]*\)\?\).*/\1/p' | head -1)"
case "$_wtp" in
  ''|*[!0-9.-]*) ;;
  *) wifi_txpower_dbm="$_wtp"; wifi_txpower_json="$_wtp"; wifi_txpower_unreachable=0
     wifi_txpower_msg="${_wtp}dBm (live iw txpower)" ;;
esac
wifi_txpower_stress_relation=UNKNOWN
if [ "$wifi_txpower_unreachable" -eq 0 ] && [ "$int_sev" != UNKNOWN ]; then
  wifi_txpower_stress_relation="WIFI-TXPOWER-${wifi_txpower_dbm}DBM+NODE-${int_sev}"
fi

# ---- GPU FAN DUTY × NODE STRESS: consume the live NVIDIA driver reading ----
# Stress and fan duty are independent observations; their tuple is context only and never changes
# posture. The relation is measurable only where both live axes resolve, so coverage is their overlap.
# No cached percentage can stand in for a current driver read. An absent/malformed fan reading stays
# UNKNOWN and makes machine/edge modes exit 2.
gpu_fan_percent=UNKNOWN; gpu_fan_msg="no live GPU fan reading (run: mesh-gpu-fan)"; gpu_fan_unreachable=1
gfnj="$(timeout 5 mesh-gpu-fan --json 2>/dev/null || true)"
_gfp="$(printf '%s' "$gfnj" | sed -n 's/.*"fan_speed_percent":\([0-9][0-9]*\).*/\1/p' | head -1)"
case "$_gfp" in
  ''|*[!0-9]*) ;;
  *) if [ "$_gfp" -le 100 ]; then
       gpu_fan_percent="$_gfp"; gpu_fan_msg="${_gfp}% (live NVIDIA driver duty)"; gpu_fan_unreachable=0
     else
       gpu_fan_msg="UNKNOWN (malformed GPU fan artifact — run: mesh-gpu-fan)"
     fi ;;
esac
if [ -n "$gfnj" ] && [ "$gpu_fan_unreachable" -eq 1 ]; then
  gpu_fan_msg="UNKNOWN (GPU fan producer unreachable or malformed — run: mesh-gpu-fan)"
fi
stress_fan_coverage=0/2
_sf_seen=0
[ "$int_sev" != UNKNOWN ] && _sf_seen=$((_sf_seen + 1))
[ "$gpu_fan_unreachable" -eq 0 ] && _sf_seen=$((_sf_seen + 1))
stress_fan_coverage="$_sf_seen/2"
stress_fan_relation=UNKNOWN
if [ "$_sf_seen" -eq 2 ]; then stress_fan_relation="${s_level}-GPU-FAN-${gpu_fan_percent}%"; fi

# ---- GPU CLOCK-REASON MASK × NODE STRESS: consume the producer's live driver artifact ----
# Keep the driver's active reason mask verbatim. Pair it with the live internal-stress axis as
# context only; missing driver output remains UNKNOWN and makes machine/edge modes exit 2.
gpu_throttle_active=UNKNOWN; gpu_throttle_active_json='"UNKNOWN"'; gpu_throttle_mask=UNKNOWN
gpu_throttle_msg="no live GPU clock-reason reading (run: mesh-gpu-throttle)"; gpu_throttle_unreachable=1
gtj="$(timeout 5 "$GPU_THROTTLE_TOOL" --json 2>/dev/null || true)"
_gt_mask="$(printf '%s' "$gtj" | sed -n 's/.*"active_mask":"\([^"]*\)".*/\1/p' | head -1)"
_gt_active="$(printf '%s' "$gtj" | sed -n 's/.*"active":\(true\|false\).*/\1/p' | head -1)"
if [[ "$_gt_mask" =~ ^0x[0-9a-fA-F]+$ ]] && { [ "$_gt_active" = true ] || [ "$_gt_active" = false ]; }; then
  gpu_throttle_mask="$_gt_mask"; gpu_throttle_active="$_gt_active"; gpu_throttle_active_json="$_gt_active"
  gpu_throttle_unreachable=0
  gpu_throttle_msg="active=${_gt_active} mask=${_gt_mask} (live NVIDIA clock-reason mask)"
elif [ -n "$gtj" ]; then
  gpu_throttle_msg="UNKNOWN (GPU clock-reason producer unreachable or malformed — run: mesh-gpu-throttle)"
fi
stress_throttle_coverage=0/2
_st_seen=0
[ "$int_sev" != UNKNOWN ] && _st_seen=$((_st_seen + 1))
[ "$gpu_throttle_unreachable" -eq 0 ] && _st_seen=$((_st_seen + 1))
stress_throttle_coverage="$_st_seen/2"
stress_throttle_relation=UNKNOWN
if [ "$_st_seen" -eq 2 ]; then
  if [ "$gpu_throttle_active" = true ] && { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; }; then
    stress_throttle_relation=GPU-CLOCK-REASON-ACTIVE-UNDER-STRESS
  elif [ "$gpu_throttle_active" = true ]; then
    stress_throttle_relation=GPU-CLOCK-REASON-ACTIVE-WITHOUT-STRESS
  elif { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; }; then
    stress_throttle_relation=STRESS-WITHOUT-ACTIVE-GPU-CLOCK-REASON
  else
    stress_throttle_relation=NO-JOINT-EVENT
  fi
fi

# ---- NVENC ENGINE × NODE STRESS: consume the live encoder-engine sense ----
# Encoder activity is orthogonal to general GPU load. The pair is UNKNOWN when the real driver
# read is absent or malformed; N/A is never turned into idle.
gpu_encoder_percent=UNKNOWN; gpu_encoder_msg="no live GPU encoder reading (run: mesh-gpu-encoder)"; gpu_encoder_unreachable=1
gej="$(timeout 5 "$GPU_ENCODER_TOOL" --json 2>/dev/null || true)"
_ge_max="$(printf '%s' "$gej" | grep -o '"encoder_utilization_percent":[0-9][0-9]*' | sed 's/.*://' | sort -n | tail -1)"
case "$_ge_max" in
  ''|*[!0-9]*) ;;
  *) if [ "$_ge_max" -le 100 ]; then
       gpu_encoder_percent="$_ge_max"; gpu_encoder_msg="${_ge_max}% (live NVIDIA NVENC engine)"; gpu_encoder_unreachable=0
     fi ;;
esac
[ "$gpu_encoder_unreachable" -eq 1 ] && gpu_encoder_msg="UNKNOWN (GPU encoder producer unreachable or malformed — run: mesh-gpu-encoder)"
stress_encoder_coverage=0/2
_se_seen=0
[ "$int_sev" != UNKNOWN ] && _se_seen=$((_se_seen + 1))
[ "$gpu_encoder_unreachable" -eq 0 ] && _se_seen=$((_se_seen + 1))
stress_encoder_coverage="$_se_seen/2"
stress_encoder_relation=UNKNOWN
if [ "$_se_seen" -eq 2 ]; then
  if [ "$gpu_encoder_percent" -gt 0 ] && { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; }; then
    stress_encoder_relation=STRESS-NVENC-ACTIVE
  elif [ "$gpu_encoder_percent" -gt 0 ]; then
    stress_encoder_relation=CALM-NVENC-ACTIVE
  else
    stress_encoder_relation=CALM-NVENC-IDLE-0%
  fi
fi

# ---- NVMe POWER × STRESS: consume the live physical storage-power sense ----
# NVMe power alone says only that a controller is awake; node stress alone says only that the
# machine is pressured.  The closed relation names the joint state, while preserving the producer's
# real verdict as context.  A missing/malformed live read remains UNKNOWN and makes machine/edge
# modes exit 2; no cached ACTIVE/SUSPENDED value can masquerade as current storage evidence.
nvme_power=UNKNOWN; nvme_msg="no live NVMe power reading (run: mesh-nvme-power-state)"; nvme_unreachable=1
nvj="$(timeout 15 "$NVME_POWER_TOOL" --json 2>/dev/null || true)"
if printf '%s' "$nvj" | grep -q '"verdict":"\(ACTIVE\|SUSPENDED\|MIXED\)"'; then
  nvme_power="$(printf '%s' "$nvj" | sed -n 's/.*"verdict":"\([A-Z]*\)".*/\1/p' | head -1)"
  nvme_controllers="$(printf '%s' "$nvj" | sed -n 's/.*"controllers":\([0-9][0-9]*\).*/\1/p' | head -1)"
  if [ "${nvme_controllers:-0}" -gt 0 ] 2>/dev/null; then
    nvme_unreachable=0; nvme_msg="${nvme_power} (${nvme_controllers} controller(s), live runtime-PM read)"
  else
    nvme_power=UNKNOWN; nvme_msg="UNKNOWN (malformed NVMe power artifact — run: mesh-nvme-power-state)"
  fi
fi
storage_relation=UNKNOWN
if [ "$nvme_unreachable" -eq 0 ]; then
  if { [ "$int_sev" = WATCH ] || [ "$int_sev" = ALERT ]; } && { [ "$nvme_power" = ACTIVE ] || [ "$nvme_power" = MIXED ]; }; then
    storage_relation=STORAGE-ACTIVE-UNDER-STRESS
  elif [ "$int_sev" = NOMINAL ] && [ "$nvme_power" = ACTIVE ]; then
    storage_relation=STORAGE-ACTIVE-CALM
  else
    storage_relation=NO-JOINT-EVENT
  fi
fi

# ---- DISK COMPLETION LATENCY × NODE STRESS: consume the fresh producer artifact -------------
# mesh-disk-latency's cached verdict is derived from a real /proc/diskstats read. Pairing it with
# the live internal-stress axis distinguishes slow storage during general node pressure from a
# storage delay that appears while the rest of the node is nominal. Missing, stale, or malformed
# producer evidence stays UNKNOWN; the machine/edge paths exit 2 instead of calling it FAST.
disk_latency=UNKNOWN; disk_latency_age_s=na
disk_latency_msg="no disk-latency artifact (run: mesh-disk-latency)"; disk_latency_unreachable=1
if [ -s "$DISK_LATENCY_STATE" ]; then
  disk_latency_age_s=$(( $(date +%s) - $(stat -c %Y "$DISK_LATENCY_STATE" 2>/dev/null || echo 0) ))
  _dl_line="$(head -n1 "$DISK_LATENCY_STATE" 2>/dev/null)"
  _dl_label="${_dl_line%%|*}"
  _dl_verdict="$(printf '%s\n' "$_dl_line" | sed -n 's/.*|verdict=\([^|]*\).*/\1/p')"
  _dl_read="$(printf '%s\n' "$_dl_line" | sed -n 's/.*|read_ms=\([^|]*\).*/\1/p')"
  _dl_write="$(printf '%s\n' "$_dl_line" | sed -n 's/.*|write_ms=\([^|]*\).*/\1/p')"
  _dl_window="$(printf '%s\n' "$_dl_line" | sed -n 's/.*|window=\([^|]*\).*/\1/p')"
  _dl_ndevs="$(printf '%s\n' "$_dl_line" | sed -n 's/.*|ndevs=\([0-9][0-9]*\).*/\1/p')"
  if [ "$disk_latency_age_s" -ge 0 ] 2>/dev/null \
      && [ "$disk_latency_age_s" -le "$DISK_LATENCY_MAX_AGE_S" ] 2>/dev/null \
      && [ "$_dl_label" = "$_dl_verdict" ] \
      && [[ "$_dl_label" =~ ^(FAST|NORMAL|SLOW|STALLED)$ ]] \
      && [[ "$_dl_read" =~ ^[0-9]+([.][0-9]+)?$ ]] \
      && [[ "$_dl_write" =~ ^[0-9]+([.][0-9]+)?$ ]] \
      && [[ "$_dl_window" =~ ^(cum|cum\+iv)$ ]] \
      && [ "${_dl_ndevs:-0}" -gt 0 ] 2>/dev/null; then
    disk_latency="$_dl_label"; disk_latency_unreachable=0
    disk_latency_msg="${disk_latency} (${_dl_read}ms read, ${_dl_write}ms write; ${_dl_window}; ${_dl_ndevs} device(s), ${disk_latency_age_s}s ago)"
  elif [ "$disk_latency_age_s" -gt "$DISK_LATENCY_MAX_AGE_S" ] 2>/dev/null; then
    disk_latency_msg="UNKNOWN (disk-latency artifact ${disk_latency_age_s}s old; limit ${DISK_LATENCY_MAX_AGE_S}s)"
  else
    disk_latency_msg="UNKNOWN (malformed or unreadable disk-latency artifact)"
  fi
fi

# ---- NIC RECEIVE LOSS × NODE STRESS: close the fresh under-consumed NIC artifact -------------
# mesh-nic-rx-loss reads real kernel receive counters over an interval and also records real TX
# activity. Pairing receive loss with live node stress names a joint condition neither axis reaches
# alone. Missing, stale, malformed, or reset-derived state stays UNKNOWN; it never becomes CLEAN.
nic_rx_loss=UNKNOWN; nic_tx_activity=UNKNOWN; nic_loss_age_s=na
nic_loss_msg="no NIC RX-loss artifact (run: mesh-nic-rx-loss)"; nic_loss_unreachable=1
if [ -s "$NIC_RX_LOSS_STATE" ]; then
  nic_loss_age_s=$(( NOW - $(stat -c %Y "$NIC_RX_LOSS_STATE" 2>/dev/null || echo 0) ))
  _nrl_line="$(head -n1 "$NIC_RX_LOSS_STATE" 2>/dev/null)"
  _nrl_label="${_nrl_line%%|*}"
  _nrl_tx="$(printf '%s\n' "$_nrl_line" | sed -n 's/.*|tx_verdict=\([^|]*\).*/\1/p')"
  if [ "$nic_loss_age_s" -ge 0 ] 2>/dev/null \
      && [ "$nic_loss_age_s" -le "$NIC_RX_LOSS_MAX_AGE_S" ] 2>/dev/null \
      && [[ "$_nrl_label" =~ ^(CLEAN|MISSED|DRIVER_ERRORS|BOTH)$ ]] \
      && [[ "$_nrl_tx" =~ ^(CLEAN|ACTIVE)$ ]]; then
    nic_rx_loss="$_nrl_label"; nic_tx_activity="$_nrl_tx"; nic_loss_unreachable=0
    nic_loss_msg="rx=${nic_rx_loss}, tx=${nic_tx_activity} (${nic_loss_age_s}s ago)"
  elif [ "$nic_loss_age_s" -gt "$NIC_RX_LOSS_MAX_AGE_S" ] 2>/dev/null; then
    nic_loss_msg="UNKNOWN (NIC RX-loss artifact ${nic_loss_age_s}s old; limit ${NIC_RX_LOSS_MAX_AGE_S}s)"
  else
    nic_loss_msg="UNKNOWN (malformed or unreadable NIC RX-loss artifact)"
  fi
fi
nic_loss_stress_relation=UNKNOWN
if [ "$nic_loss_unreachable" -eq 0 ]; then
  case "$nic_rx_loss:$int_sev" in
    MISSED:WATCH|MISSED:ALERT|DRIVER_ERRORS:WATCH|DRIVER_ERRORS:ALERT|BOTH:WATCH|BOTH:ALERT) nic_loss_stress_relation=NIC-LOSS-UNDER-STRESS;;
    MISSED:NOMINAL|DRIVER_ERRORS:NOMINAL|BOTH:NOMINAL) nic_loss_stress_relation=NIC-LOSS-WITHOUT-STRESS;;
    CLEAN:WATCH|CLEAN:ALERT) nic_loss_stress_relation=NODE-STRESS-WITH-NIC-CLEAN;;
    CLEAN:NOMINAL) nic_loss_stress_relation=NO-JOINT-EVENT;;
  esac
fi

# ---- NIC TX HEARTBEAT × NODE STRESS: consume the producer's hardware counter artifact ----
# This closes a distinct link from failed transmit-heartbeat detection to node stress.  A fresh
# CLEAR is evidence that the readable counter did not move; missing, stale, or malformed state is
# UNKNOWN and keeps the fused read honest with exit 2.
nic_tx_heartbeat=UNKNOWN; nic_tx_heartbeat_age_s=na
nic_tx_heartbeat_msg="no NIC TX-heartbeat artifact (run: mesh-nic-tx-heartbeat)"; nic_tx_heartbeat_unreachable=1
if [ -s "$NIC_TX_HEARTBEAT_STATE" ]; then
  nic_tx_heartbeat_age_s=$(( NOW - $(stat -c %Y "$NIC_TX_HEARTBEAT_STATE" 2>/dev/null || echo 0) ))
  _nth_line="$(head -n1 "$NIC_TX_HEARTBEAT_STATE" 2>/dev/null)"
  _nth_label="${_nth_line%%|*}"
  if [ "$nic_tx_heartbeat_age_s" -ge 0 ] 2>/dev/null \
      && [ "$nic_tx_heartbeat_age_s" -le "$NIC_TX_HEARTBEAT_MAX_AGE_S" ] 2>/dev/null \
      && [[ "$_nth_label" =~ ^(CLEAR|FAULT)$ ]]; then
    nic_tx_heartbeat="$_nth_label"; nic_tx_heartbeat_unreachable=0
    nic_tx_heartbeat_msg="${nic_tx_heartbeat} (${nic_tx_heartbeat_age_s}s ago)"
  elif [ "$nic_tx_heartbeat_age_s" -gt "$NIC_TX_HEARTBEAT_MAX_AGE_S" ] 2>/dev/null; then
    nic_tx_heartbeat_msg="UNKNOWN (NIC TX-heartbeat artifact ${nic_tx_heartbeat_age_s}s old; limit ${NIC_TX_HEARTBEAT_MAX_AGE_S}s)"
  else
    nic_tx_heartbeat_msg="UNKNOWN (malformed or unreadable NIC TX-heartbeat artifact)"
  fi
fi
tx_heartbeat_stress_relation=UNKNOWN
if [ "$nic_tx_heartbeat_unreachable" -eq 0 ]; then
  case "$nic_tx_heartbeat:$int_sev" in
    FAULT:WATCH|FAULT:ALERT) tx_heartbeat_stress_relation=TX-HEARTBEAT-FAULT-UNDER-STRESS;;
    FAULT:NOMINAL) tx_heartbeat_stress_relation=TX-HEARTBEAT-FAULT-WITHOUT-STRESS;;
    CLEAR:WATCH|CLEAR:ALERT) tx_heartbeat_stress_relation=NODE-STRESS-WITH-CLEAR-TX-HEARTBEAT;;
    CLEAR:NOMINAL) tx_heartbeat_stress_relation=NO-JOINT-EVENT;;
  esac
fi
latency_stress_coverage=0/2
_ls_seen=0
[ "$int_sev" != UNKNOWN ] && _ls_seen=$((_ls_seen + 1))
[ "$disk_latency_unreachable" -eq 0 ] && _ls_seen=$((_ls_seen + 1))
latency_stress_coverage="$_ls_seen/2"
latency_stress_relation=UNKNOWN
if [ "$_ls_seen" -eq 2 ]; then
  case "$disk_latency:$int_sev" in
    SLOW:WATCH|SLOW:ALERT|STALLED:WATCH|STALLED:ALERT) latency_stress_relation=DISK-LATENCY-UNDER-STRESS;;
    SLOW:NOMINAL|STALLED:NOMINAL) latency_stress_relation=DISK-LATENCY-WITHOUT-STRESS;;
    FAST:WATCH|FAST:ALERT) latency_stress_relation=NODE-STRESS-WITH-FAST-DISK;;
    *) latency_stress_relation=NO-JOINT-EVENT;;
  esac
fi

# ---- PTY ALLOCATION: consume the live kernel PTY counter ----
# PTY allocation is a local workload/interaction signal.  It is intentionally additive context:
# it does not alter POSTURE, but the producer↔consumer link is closed only when a numeric live
# reading is present.  Missing, malformed, or producer-reported-unreachable output stays UNKNOWN
# and makes machine/edge modes exit 2; no cached count can masquerade as current.
pty_count=UNKNOWN; pty_count_json='"UNKNOWN"'; pty_status=UNKNOWN; pty_msg="no live PTY count (run: mesh-pty-count)"; pty_unreachable=1
ptyj="$(timeout 10 "$PTY_TOOL" --json 2>/dev/null || true)"
if printf '%s' "$ptyj" | grep -q '"status":"LIVE"'; then
  pty_count="$(printf '%s' "$ptyj" | sed -n 's/.*"pty_count":\([0-9][0-9]*\).*/\1/p' | head -1)"
  if [ -n "$pty_count" ]; then
    pty_count_json="$pty_count"; pty_status=LIVE; pty_unreachable=0; pty_msg="${pty_count} allocated PTY(s) (live kernel read)"
  else
    pty_count=UNKNOWN; pty_msg="UNKNOWN (malformed PTY-count artifact — run: mesh-pty-count)"
  fi
elif [ -n "$ptyj" ]; then
  pty_msg="UNKNOWN (PTY-count producer unreachable — run: mesh-pty-count)"
fi

# ---- ORIENTATION × ACPI: consume a live under-consumed body orientation and pair it with wake ----
# Orientation alone is posture; ACPI alone is firmware activity.  Their joint labels distinguish an
# upright wake from a covered wake.  Both producers are invoked live, and overlap is the denominator.
orientation_class=UNKNOWN; orientation_relation=UNKNOWN; orientation_coverage="0/2"; orientation_unreachable=1
oj="$(timeout 12 "$ORIENT_TOOL" --json 2>/dev/null || true)"
if printf '%s' "$oj" | grep -q '"class":"[A-Z_-]*"'; then
  orientation_class="$(printf '%s' "$oj" | sed -n 's/.*"class":"\([^"]*\)".*/\1/p')"
fi
if [ "$orientation_class" != UNKNOWN ] && [ "$acpi_unreachable" -eq 0 ]; then
  orientation_unreachable=0; orientation_coverage="2/2"
  case "$orientation_class:$acpi_label" in
    UPRIGHT:EVENT) orientation_relation=UPRIGHT-WAKE;;
    FACE_DOWN:EVENT) orientation_relation=COVERED-WAKE;;
    *:EVENT) orientation_relation=OTHER-ORIENTED-WAKE;;
    *) orientation_relation=NO-JOINT-EVENT;;
  esac
fi

# ---- NOTE 3 GYROSCOPE: consume its live angular-rate artifact as fused context ---------------
# Rotation rate has no calibrated motion threshold here, so preserve the producer's raw three-axis
# reading without inventing a motion verdict. The sensor is invoked live; malformed, missing, or
# unreachable output remains UNKNOWN and keeps the fusion's machine/edge result at exit 2.
gyro_status=UNKNOWN; gyro_x_json=null; gyro_y_json=null; gyro_z_json=null
gyro_coverage=0/1; gyro_unreachable=1; gyro_msg="no live Note 3 gyroscope reading"
_gyro_path="$(command -v "$GYRO_TOOL" 2>/dev/null || true)"
[ -x "$_gyro_path" ] || _gyro_path="$SITUATION_DIR/mesh-note3-gyro"
if [ -x "$_gyro_path" ]; then
  gj="$(timeout 20 "$_gyro_path" --json 2>/dev/null || true)"
  if printf '%s' "$gj" | grep -q '"status":"OK"'; then
    _gx="$(printf '%s' "$gj" | sed -n 's/.*"gx_rad_s":\(-\?[0-9][0-9.]*\).*/\1/p')"
    _gy="$(printf '%s' "$gj" | sed -n 's/.*"gy_rad_s":\(-\?[0-9][0-9.]*\).*/\1/p')"
    _gz="$(printf '%s' "$gj" | sed -n 's/.*"gz_rad_s":\(-\?[0-9][0-9.]*\).*/\1/p')"
    if [[ "$_gx" =~ ^-?([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] \
       && [[ "$_gy" =~ ^-?([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] \
       && [[ "$_gz" =~ ^-?([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]; then
      gyro_status=LIVE; gyro_x_json="$_gx"; gyro_y_json="$_gy"; gyro_z_json="$_gz"
      gyro_coverage=1/1; gyro_unreachable=0
      gyro_msg="live angular velocity (${_gx},${_gy},${_gz}) rad/s"
    else
      gyro_msg="UNKNOWN (malformed Note 3 gyroscope artifact)"
    fi
  else
    gyro_msg="UNKNOWN (Note 3 gyroscope unreachable — run: mesh-note3-gyro)"
  fi
else
  gyro_msg="UNKNOWN (Note 3 gyroscope tool absent — run: mesh-note3-gyro)"
fi

# ---- PAIRED NOTE 3 POSTURE × ROTATION: consume fresh aligned two-axis evidence ---------------
# This producer joins orientation and angular velocity from one HAL listener and rejects missing,
# stale, or misaligned events. Preserve its paired artifact verbatim: without a calibrated corpus,
# the fusion records the joint observation and coverage but does not invent a motion class.
note3_posture_rotation_status=UNKNOWN; note3_posture_rotation_json=null
note3_posture_rotation_coverage=0/1; note3_posture_rotation_unreachable=1
note3_posture_rotation_msg="no fresh aligned Note 3 posture/rotation artifact"
_pair_path="$(command -v "$POSTURE_ROTATION_TOOL" 2>/dev/null || true)"
[ -x "$_pair_path" ] || _pair_path="$SITUATION_DIR/$POSTURE_ROTATION_TOOL"
if [ -x "$_pair_path" ]; then
  _pair_raw="$(timeout 45 "$_pair_path" --json 2>/dev/null || true)"
  _pair_json="$(printf '%s' "$_pair_raw" | python3 -c '
import json, math, sys
try:
    d = json.load(sys.stdin)
    o = d["orientation_deg"]
    g = d["angular_velocity_rad_s"]
    ticks = d["hal_ticks_ns"]
    nums = [o[k] for k in ("azimuth", "pitch", "roll")] + [g[k] for k in ("x", "y", "z", "magnitude")] + [d["pair_skew_ms"], d["pair_age_ms"]]
    assert all(isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x) for x in nums)
    assert all(isinstance(ticks[k], int) and ticks[k] > 0 for k in ("orientation", "gyroscope"))
    assert d["coverage"] == "1/1 paired sample" and isinstance(d["source"], str) and d["source"]
    print(json.dumps(d, separators=(",", ":"), allow_nan=False))
except Exception:
    sys.exit(1)
' 2>/dev/null)" || _pair_json=""
  if [ -n "$_pair_json" ]; then
    note3_posture_rotation_status=LIVE; note3_posture_rotation_json="$_pair_json"
    note3_posture_rotation_coverage=1/1; note3_posture_rotation_unreachable=0
    note3_posture_rotation_msg="fresh aligned orientation × angular-velocity pair"
  else
    note3_posture_rotation_msg="UNKNOWN (Note 3 posture/rotation pair absent, stale, malformed, or unreachable)"
  fi
else
  note3_posture_rotation_msg="UNKNOWN (paired Note 3 producer absent)"
fi

# ---- NOTE 3 FIELD × MOTION: consume the live paired magnetic-field/rotation artifact ------------
# The producer emits a fresh, aligned AK09911C × gyroscope sample. Preserve that real evidence in
# this fusion without assigning a field-disturbance score or inventing a label. Missing, malformed,
# or unreachable output stays UNKNOWN and makes the fused read exit 2.
field_motion_status=UNKNOWN; field_motion_json=null; field_motion_coverage=0/1
field_motion_unreachable=1; field_motion_msg="no fresh paired Note 3 field-motion artifact"
_field_path="$(command -v "$FIELD_MOTION_TOOL" 2>/dev/null || true)"
[ -x "$_field_path" ] || _field_path="$SITUATION_DIR/$FIELD_MOTION_TOOL"
if [ -x "$_field_path" ]; then
  _field_raw="$(timeout 45 "$_field_path" --json 2>/dev/null || true)"
  _field_json="$(printf '%s' "$_field_raw" | python3 -c '
import json, math, sys
try:
    d = json.load(sys.stdin)
    m = d["magnetic_field_uT"]
    w = d["angular_velocity_rad_s"]
    ticks = d["hal_ticks_ns"]
    nums = [m[k] for k in ("x", "y", "z", "magnitude")] + [w[k] for k in ("x", "y", "z", "magnitude")] + [d["pair_skew_ms"], d["pair_age_ms"]]
    assert all(isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x) for x in nums)
    assert all(isinstance(ticks[k], int) and ticks[k] > 0 for k in ("magnetometer", "gyroscope"))
    assert d["coverage"] == "1/1 paired sample" and isinstance(d["source"], str) and d["source"]
    print(json.dumps(d, separators=(",", ":"), allow_nan=False))
except Exception:
    sys.exit(1)
' 2>/dev/null)" || _field_json=""
  if [ -n "$_field_json" ]; then
    field_motion_status=LIVE; field_motion_json="$_field_json"
    field_motion_coverage=1/1; field_motion_unreachable=0
    field_motion_msg="fresh aligned magnetic-field × angular-velocity pair"
  else
    field_motion_msg="UNKNOWN (Note 3 field-motion pair absent, malformed, or unreachable — run: mesh-note3-field-motion)"
  fi
else
  field_motion_msg="UNKNOWN (paired Note 3 field-motion producer absent — run: mesh-note3-field-motion)"
fi

# ---- INTERRUPTIBILITY: consume mesh-interruptibility's real state artifact ----
# This is a context axis, not a posture selector: a fresh UNKNOWN is still a live, honest reading;
# a missing/stale artifact is UNKNOWN and contributes to coverage blindness.
interruptibility=UNKNOWN; interrupt_age=99999; interrupt_msg="no interruptibility state (run: mesh-interruptibility)"
if [ -s "$INTERRUPT_STATE" ]; then
  interruptibility="$(head -1 "$INTERRUPT_STATE" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$interruptibility" ] || interruptibility=UNKNOWN
  interrupt_age="$(age_min "$(date -u -r "$INTERRUPT_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  case "$interruptibility" in DO-NOT-DISTURB|FOCUSED|RESTING|AVAILABLE|AWAY|UNKNOWN) ;; *) interruptibility=UNKNOWN;; esac
  if [ "$interrupt_age" -gt "$STALE_MIN" ]; then
    interrupt_msg="UNKNOWN (interruptibility state ${interrupt_age}min old — run: mesh-interruptibility)"
    interruptibility=UNKNOWN
  else
    interrupt_msg="${interruptibility} (${interrupt_age}min ago)"
  fi
fi

# ---- OCCUPANCY: room-sense cached verdict (*/5 edge reflex keeps it fresh) ----
occ_verdict="UNKNOWN"; occ_age=99999; occ_msg="no room-sense state (run: mesh-room-sense)"
if [ -f "$ROOM_STATE" ]; then
  occ_verdict="$(head -1 "$ROOM_STATE" 2>/dev/null | cut -d'|' -f1)"; [ -n "$occ_verdict" ] || occ_verdict=UNKNOWN  # LABEL|dwell_s=N|.. → LABEL
  occ_age="$(age_min "$(date -u -r "$ROOM_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  stale=""; [ "$occ_age" -gt "$STALE_MIN" ] && stale=" [STALE ${occ_age}min]"
  occ_msg="${occ_verdict}${stale}"
fi

# ---- MEMORY HORIZON (report-only): the fixed trust window vs the room's OWN timescale (see header) ----
occ_dwell_s=""; occ_ch24=""; tau_e=na
if [ -f "$ROOM_STATE" ]; then
  _rs="$(head -1 "$ROOM_STATE" 2>/dev/null)"
  occ_dwell_s="$(printf '%s' "$_rs" | grep -oE 'dwell_s=[0-9]+' | cut -d= -f2)"
  occ_ch24="$(printf '%s' "$_rs" | grep -oE 'changes_24h=[0-9]+' | cut -d= -f2)"
  # tau_E = mean dwell over the last day = 1440min / changes. changes_24h=0 is CENSORED, not tau_E=inf:
  # it says only tau_E >= 24h, so it renders as an absent number, never as a fabricated one
  # ([[na-must-be-a-claim-about-the-node]]). A room-sense state written before the dwell fields existed
  # (bare "PRESENT") lands here too, and must render censored rather than 0.
  [ -n "$occ_ch24" ] && [ "$occ_ch24" -gt 0 ] 2>/dev/null && tau_e=$(( 1440 / occ_ch24 ))
fi
# Grow the tau ring on the EDGE cadence ONLY — a fold/json/dash refresh is not a new observation of the
# room, and letting it append would inflate n and let a hot dash pane rewrite the anchor (same discipline
# the eigenform ring already carries, and its --test asserts).
if [ "$EDGE" = 1 ] && [ "$tau_e" != na ]; then
  { cat "$SIT_TAU_RING" 2>/dev/null | tr '\n' ' '; printf '%s' "$tau_e"; } \
    | awk -v k="$SIT_TAU_K" '{for(i=1;i<=NF;i++)a[i]=$i; s=(NF>k)?NF-k+1:1; for(i=s;i<=NF;i++)printf "%s%s",(i>s?" ":""),a[i]; print ""}' \
    > "$SIT_TAU_RING.tmp" 2>/dev/null && mv "$SIT_TAU_RING.tmp" "$SIT_TAU_RING" 2>/dev/null || true
fi
read -r mem_verdict mem_ratio mem_wstar mem_rung < <(tau_classify "$STALE_MIN" "$tau_e" "$(cat "$SIT_TAU_RING" 2>/dev/null)")

# ---- EXPECTED-ABSENCE: cached no-show notices from mesh-rhythm's absence lane (the representation-hungry
#      non-event — a device on a learned schedule that did NOT appear today; enactivism/4E scaling-up
#      landing 2026-07-29). CONTEXT ONLY — never touches POSTURE/.situation.state (additive report, like
#      DISJUNCTION/EIGENFORM). Honest-fusion: a STALE or MISSING cache is rendered as no-data (line
#      suppressed), never counted as "nothing absent". ----
absent_msg=""; absent_n=0
if [ -s "$RHYTHM_ABS_STATE" ]; then
  abs_age="$(age_min "$(date -u -r "$RHYTHM_ABS_STATE" +%FT%TZ 2>/dev/null || echo "")")"
  if [ "$abs_age" -le "$ABS_STALE_MIN" ]; then
    absent_n="$(grep -c '^\[rhythm-absence\]' "$RHYTHM_ABS_STATE" 2>/dev/null)"; absent_n="${absent_n:-0}"
    [ "$absent_n" -gt 0 ] && absent_msg="$(grep '^\[rhythm-absence\]' "$RHYTHM_ABS_STATE" | sed -E 's/^\[rhythm-absence\] //' | paste -sd' · ' -)"
  fi
fi

# ---- FOLD: posture = worst of the two load-bearing axes (INTERNAL, EXTERNAL); PHYSICAL = context ----
iw=$(rank "$int_sev"); ew=$(rank "$ext_sev"); worst=$(( iw > ew ? iw : ew ))
case "$worst" in 3) POSTURE=ALERT;; 2) POSTURE=WATCH;; 1) POSTURE=NOMINAL;; *) POSTURE=UNKNOWN;; esac
# ---- INCLUSIVE DISJUNCTION (Deleuze & Guattari, "disjunctive synthesis", Anti-Oedipus §2.4) ----
# The fold above is the EXCLUSIVE ("restrictive") use of the disjunction: max() DECIDES either-INTERNAL-
# or-EXTERNAL and reports the loudest, effacing whether the two axes AGREE or DIVERGE — it renders
# INTERNAL=WATCH·EXTERNAL=WATCH (a broad, concordant pressure) IDENTICALLY to INTERNAL=WATCH·EXTERNAL=
# NOMINAL (a single loud axis over a calm one). D&G's INCLUSIVE ("nonrestrictive") use — "either…or…or"
# — instead AFFIRMS both terms AND the DISTANCE between them. This preserves exactly the multiplicity the
# max discards; `spread` = |rank(INTERNAL) − rank(EXTERNAL)| IS that distance between the terms.
# ADDITIVE & VERDICT-PRESERVING: it does NOT touch POSTURE or the .situation.state consumer contract, so
# unlike the joint-pattern synergy rule the causal-emergence review holds for sign-off (that INVENTS a
# new verdict), this needs none — it only reports the disjunction the fold already computed. A concordant
# WATCH (both axes) and a split WATCH (one loud) are different situations a consumer can now tell apart.
spread=$(( iw > ew ? iw - ew : ew - iw ))
if [ "$iw" -eq 0 ] || [ "$ew" -eq 0 ]; then concordance=partial   # a term unreadable — cannot affirm agreement OR divergence
elif [ "$spread" -eq 0 ]; then concordance=concordant             # both axes same severity — posture is a JOINT condition
else concordance=split; fi                                        # posture rests on ONE loud axis; the other says otherwise
if   [ "$iw" -gt "$ew" ]; then loud_axis=internal
elif [ "$ew" -gt "$iw" ]; then loud_axis=external
else loud_axis=none; fi                                           # equal ranks: no single term carries the posture
# SECOND-ORDER COVERAGE (von Foerster: the observer is part of the observed; a verdict must carry a
# description of its OWN observing). "NOMINAL" has to mean "calm AND I could see", not "calm-looking
# while half-blind". An axis is UNSEEN when THIS node can't currently resolve it: int/ext UNKNOWN/stale,
# and occupancy UNKNOWN/UNCERTAIN/stale — the room-sense eye goes dark whenever the phone is
# offline, yet it was previously EXCLUDED from the count, so a blind-on-the-room verdict read as a clean
# all-clear. Counting them is the second-order fix: the observation now includes which of its eyes are open.
unseen=0; for s in "$int_sev" "$ext_sev" "$node_health" "$system_vitality" "$body_power" "$operator_state" "$operator_field_stress_relation" "$ambient_clock" "$interruptibility" "$baro_trend" "$airtime" "$link_speed_mbps" "$wifi_txpower_dbm" "$gpu_fan_percent" "$gpu_throttle_active" "$gpu_encoder_percent" "$acpi_label" "$orientation_relation" "$nvme_power" "$disk_latency" "$nic_rx_loss" "$nic_tx_heartbeat" "$gyro_status" "$note3_posture_rotation_status" "$field_motion_status" "$magnetic_status"; do [ "$s" = UNKNOWN ] && unseen=$((unseen+1)); done
occ_seen=1; case "$occ_verdict" in UNKNOWN|UNCERTAIN) occ_seen=0;; esac
[ "$occ_age" -gt "$STALE_MIN" ] && occ_seen=0   # PRESENT-but-stale = can't see the room NOW
[ "$occ_seen" -eq 0 ] && unseen=$((unseen+1))
[ "$unseen" -gt 0 ] && [ "$POSTURE" != ALERT ] && POSTURE="$POSTURE (partial — $unseen/4 axes unseen)"

# ---- EIGENFORM (report-only): is the committed situation object a fixed point, or is the debounce
#      laundering a non-convergent observation? Append the RAW posture to the ring ONLY on the EDGE
#      cadence (the canonical */15 tape — json/fold READ the tape, never grow it, so a dash refresh
#      can't double-count). Classify against the committed object (ann in .situation.state). ----
_raw_posture="${POSTURE%% *}"   # strip "(partial…)" suffix → the raw NOMINAL/WATCH/ALERT/UNKNOWN this read
if [ "$EDGE" = 1 ]; then
  { cat "$SIT_EIGEN_RING" 2>/dev/null | tr '\n' ' '; printf '%s' "$_raw_posture"; } \
    | awk -v k="$SIT_EIGEN_K" '{for(i=1;i<=NF;i++)a[i]=$i; s=(NF>k)?NF-k+1:1; for(i=s;i<=NF;i++)printf "%s%s",(i>s?" ":""),a[i]; print ""}' \
    > "$SIT_EIGEN_RING.tmp" 2>/dev/null && mv "$SIT_EIGEN_RING.tmp" "$SIT_EIGEN_RING" 2>/dev/null || true
fi
_committed_obj="$(cat "$SIT_STATE" 2>/dev/null || echo "$_raw_posture")"
read -r eigen_state eigen_resid < <(eigen_classify "$(cat "$SIT_EIGEN_RING" 2>/dev/null)" "$_committed_obj")

if [ "$MODE" = json ] || [ "$MODE" = refresh_json ]; then
  # axes_unseen = the observer's self-reported blindness (reported even for ALERT, where the suffix is
  # suppressed) so a machine consumer can refuse to trust a low-coverage NOMINAL.
  # eigen_state/eigen_residual = the reported situation object's OWN temporal stability (von Foerster
  # eigenform): "settled"=fixed point reached · "churning"=no eigenform, calm label is a debounce artifact.
  # tau_e_min/mem_* = the MEMORY-HORIZON clause: the room's own timescale beside the fixed trust window
  # that gates axes_unseen. Strings, because "na" (censored / no dwell fields) is a legal value and a
  # machine consumer must not read an absent timescale as 0.
  printf '{"posture":"%s","internal":"%s","external":"%s","node_health":"%s","system_vitality":"%s","vitality_stress_relation":"%s","body_power":"%s","body_power_relation":"%s","operator_state":"%s","operator_stress_relation":"%s","operator_field_state":"%s","operator_field_mood":"%s","operator_field_stress_relation":"%s","occupancy":"%s","ambient_clock":"%s","barometer_trend":"%s","ambient_relation":"%s","interruptibility":"%s","airtime":"%s","airtime_stress_relation":"%s","link_speed_mbps":%s,"pressure_link_relation":"%s","wifi_txpower_dbm":%s,"txpower_stress_relation":"%s","gpu_fan_percent":"%s","stress_fan_relation":"%s","stress_fan_coverage":"%s","gpu_throttle_active":%s,"gpu_throttle_mask":"%s","stress_throttle_relation":"%s","stress_throttle_coverage":"%s","gpu_encoder_percent":"%s","stress_encoder_relation":"%s","stress_encoder_coverage":"%s","nvme_power":"%s","storage_relation":"%s","disk_latency":"%s","latency_stress_relation":"%s","latency_stress_coverage":"%s","nic_rx_loss":"%s","nic_tx_activity":"%s","nic_loss_stress_relation":"%s","nic_tx_heartbeat":"%s","tx_heartbeat_stress_relation":"%s","pty_count":%s,"pty_status":"%s","acpi_event":"%s","acpi_relation":"%s","magnetic_status":"%s","magnetic_acpi_relation":"%s","magnetic_coverage":"%s","orientation_relation":"%s","orientation_coverage":"%s","gyro_status":"%s","gyro_x_rad_s":%s,"gyro_y_rad_s":%s,"gyro_z_rad_s":%s,"gyro_coverage":"%s","note3_posture_rotation_status":"%s","note3_posture_rotation":%s,"note3_posture_rotation_coverage":"%s","field_motion_status":"%s","field_motion":%s,"field_motion_coverage":"%s","physical_count":%s,"external_age_min":%s,"node_health_age_min":%s,"system_vitality_age_min":%s,"ambient_age_min":%s,"barometer_age_min":%s,"interruptibility_age_min":%s,"acpi_age_min":%s,"axes_unseen":%s,"axes_total":27,"spread":%s,"concordance":"%s","loud_axis":"%s","eigen_state":"%s","eigen_residual":%s,"expected_absence":%s,"stale_window_min":%s,"tau_e_min":"%s","mem_verdict":"%s","mem_ratio_pct":"%s","mem_wstar_min":"%s","mem_anchor":"%s"}\n' \
    "${POSTURE%% *}" "$int_sev" "$ext_sev" "$node_health" "$system_vitality" "$vitality_stress_relation" "$body_power" "$body_power_relation" "$operator_state" "$operator_stress_relation" "$operator_field_state" "$operator_field_mood" "$operator_field_stress_relation" "$occ_verdict" "$ambient_clock" "$baro_trend" "$ambient_relation" "$interruptibility" "$airtime" "$airtime_stress_relation" "$link_speed_json" "$pressure_link_relation" "$wifi_txpower_json" "$wifi_txpower_stress_relation" "$gpu_fan_percent" "$stress_fan_relation" "$stress_fan_coverage" "$gpu_throttle_active_json" "$gpu_throttle_mask" "$stress_throttle_relation" "$stress_throttle_coverage" "$gpu_encoder_percent" "$stress_encoder_relation" "$stress_encoder_coverage" "$nvme_power" "$storage_relation" "$disk_latency" "$latency_stress_relation" "$latency_stress_coverage" "$nic_rx_loss" "$nic_tx_activity" "$nic_loss_stress_relation" "$nic_tx_heartbeat" "$tx_heartbeat_stress_relation" "$pty_count_json" "$pty_status" "$acpi_label" "$acpi_relation" "$magnetic_status" "$magnetic_acpi_relation" "$magnetic_coverage" "$orientation_relation" "$orientation_coverage" "$gyro_status" "$gyro_x_json" "$gyro_y_json" "$gyro_z_json" "$gyro_coverage" "$note3_posture_rotation_status" "$note3_posture_rotation_json" "$note3_posture_rotation_coverage" "$field_motion_status" "$field_motion_json" "$field_motion_coverage" "${phy_n:-0}" "$ext_age" "$node_health_age" "$system_vitality_age" "$ambient_age" "$baro_age" "$interrupt_age" "$acpi_age" "$unseen" "$spread" "$concordance" "$loud_axis" "$eigen_state" "$eigen_resid" "${absent_n:-0}" "$STALE_MIN" "$tau_e" "$mem_verdict" "$mem_ratio" "$mem_wstar" "$mem_rung"
  [ "$baro_unreachable" -eq 0 ] && [ "$airtime_unreachable" -eq 0 ] && [ "$link_unreachable" -eq 0 ] && [ "$wifi_txpower_unreachable" -eq 0 ] && [ "$nvme_unreachable" -eq 0 ] && [ "$disk_latency_unreachable" -eq 0 ] && [ "$nic_loss_unreachable" -eq 0 ] && [ "$nic_tx_heartbeat_unreachable" -eq 0 ] && [ "$pty_unreachable" -eq 0 ] && [ "$acpi_unreachable" -eq 0 ] && [ "$magnetic_unreachable" -eq 0 ] && [ "$orientation_unreachable" -eq 0 ] && [ "$gyro_unreachable" -eq 0 ] && [ "$note3_posture_rotation_unreachable" -eq 0 ] && [ "$field_motion_unreachable" -eq 0 ] && [ "$node_health_unreachable" -eq 0 ] && [ "$system_vitality_unreachable" -eq 0 ] && [ "$gpu_fan_unreachable" -eq 0 ] && [ "$gpu_throttle_unreachable" -eq 0 ] && [ "$gpu_encoder_unreachable" -eq 0 ] && [ "$body_power_unreachable" -eq 0 ] && [ "$operator_state_unreachable" -eq 0 ] && [ "$operator_field_unreachable" -eq 0 ] || exit 2
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  # BLIND is a verdict, not silence: name the unreachable producers on TRANSITION ONLY (state file
  # holds the last blind set, so a chronic blind stretch prints once, not 96 lines/day into the log).
  _blind=""
  for _p in baro link wifi_txpower nvme disk_latency nic_loss nic_tx_heartbeat pty acpi magnetic orientation gyro note3_posture_rotation field_motion node_health gpu_fan gpu_throttle gpu_encoder operator_state; do
    eval "[ \"\${${_p}_unreachable}\" -eq 0 ]" 2>/dev/null || _blind="$_blind $_p"
  done
  if [ -n "$_blind" ]; then
    # Print on set-change, else at most once per cooldown (bounds a chronically-blind stretch to
    # 24 lines/day while keeping the era visible; the blind set itself flaps run-to-run on wifi/nic
    # producers, so change-only would still print nearly every run).
    _prev="$(cat "$SIT_EDGE_BLIND" 2>/dev/null || true)"
    _sage=$(( $(date +%s) - $(stat -c %Y "$SIT_EDGE_BLIND" 2>/dev/null || echo 0) ))
    if [ "$_blind" != "$_prev" ] || [ "$_sage" -ge "${MESH_SITUATION_EDGE_BLIND_COOLDOWN:-3600}" ]; then
      printf '%s\n' "$_blind" > "$SIT_EDGE_BLIND"
      echo "mesh-situation --edge: BLIND (no edge evaluation) — unreachable producers:$_blind" >&2
    fi
    exit 2
  fi
  rm -f "$SIT_EDGE_BLIND" 2>/dev/null || true   # gate passed: clear a stale blind verdict
  posture_key="${POSTURE%% *}"   # strip "(partial…)" suffix → NOMINAL/WATCH/ALERT/UNKNOWN
  detail="int=${int_sev},ext=${ext_sev},occ=${occ_verdict},phy=${phy_n}"
  # Capture the posture we're LEAVING here, in the parent shell: situation_decide runs in a $(...)
  # subshell, so a variable set inside it never reaches the [situation-change] message — every
  # transition since 2026-06 logged "(was new)", losing the from-posture forensics. Same seed order
  # as situation_decide's own: alert-state ann → committed posture file → empty ("new" = first run).
  PREV_ANN="$(awk '{print $1; exit}' "$SIT_ALERT_STATE" 2>/dev/null)"
  [ -n "$PREV_ANN" ] || PREV_ANN="$(cat "$SIT_STATE" 2>/dev/null || true)"
  action="$(situation_decide "$posture_key" "$NOW")"   # debounced: commits only on SIT_N sustained reads (+ cooldown on recovery)
  case "$action" in
    post-alert)
      esc="[escalate:tg-window] situation ALERT on $(hostname): ${detail} (int=$int_sev, ext=$ext_sev). Operator action may be needed."
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="situation@$(hostname)" mesh-chat "$esc" 2>/dev/null || true
      printf '%s\n' "$posture_key" ;;
    post-change)
      msg="[situation-change] $(hostname) posture=${POSTURE} — ${detail} (was ${PREV_ANN:-new})"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="situation@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
      printf '%s\n' "$posture_key" ;;
    *) exit 0 ;;   # silent — no committed transition (debounced single-sample spike, or unchanged)
  esac
  exit 0
fi

printf '=== mesh-situation %s @ %s — %s ===\n' "$HOST" "$TS" "$POSTURE"
printf ' INTERNAL [%-8s] %s\n' "$int_sev" "$int_msg"
printf ' NODE HEALTH[%-8s] %s\n' "$node_health" "$node_health_msg"
printf ' VITALITY  [%-8s] %s · stress-relation=%s\n' "$system_vitality" "$system_vitality_msg" "$vitality_stress_relation"
printf ' BODY     [power  ] %s · stress-relation=%s\n' "$body_power_msg" "$body_power_relation"
printf ' OPERATOR [state  ] %s · stress-relation=%s\n' "$operator_state_msg" "$operator_stress_relation"
printf ' OPERATOR [field  ] %s · stress-relation=%s\n' "$operator_field_msg" "$operator_field_stress_relation"
printf ' EXTERNAL [%-8s] %s\n' "$ext_sev" "$ext_msg"
printf ' PHYSICAL [around ] %s\n' "$phy_msg"
printf ' OCCUPANCY[room   ] %s\n' "$occ_msg"
printf ' AMBIENT  [clock  ] %s\n' "$ambient_msg"
printf ' AMBIENT  [baro   ] %s · relation=%s\n' "$baro_msg" "$ambient_relation"
printf ' RF       [airtime] %s · stress-relation=%s\n' "$airtime_msg" "$airtime_stress_relation"
printf ' LINK     [speed  ] %s · pressure-relation=%s\n' "$link_speed_msg" "$pressure_link_relation"
printf ' GPU      [fan    ] %s · stress-relation=%s · coverage=%s\n' "$gpu_fan_msg" "$stress_fan_relation" "$stress_fan_coverage"
printf ' GPU      [clock  ] %s · stress-relation=%s · coverage=%s\n' "$gpu_throttle_msg" "$stress_throttle_relation" "$stress_throttle_coverage"
printf ' GPU      [NVENC  ] %s · stress-relation=%s · coverage=%s\n' "$gpu_encoder_msg" "$stress_encoder_relation" "$stress_encoder_coverage"
printf ' STORAGE  [NVMe   ] %s · relation=%s\n' "$nvme_msg" "$storage_relation"
printf ' STORAGE  [latency] %s · stress-relation=%s · coverage=%s\n' "$disk_latency_msg" "$latency_stress_relation" "$latency_stress_coverage"
printf ' NETWORK  [rx-loss] %s · stress-relation=%s\n' "$nic_loss_msg" "$nic_loss_stress_relation"
printf ' NETWORK  [tx-heartbeat] %s · stress-relation=%s\n' "$nic_tx_heartbeat_msg" "$tx_heartbeat_stress_relation"
printf ' NETWORK  [txpower] %s · stress-relation=%s\n' "$wifi_txpower_msg" "$wifi_txpower_stress_relation"
printf ' WORKLOAD [PTY    ] %s · status=%s\n' "$pty_msg" "$pty_status"
printf ' CHASSIS  [ACPI   ] %s · relation=%s\n' "$acpi_msg" "$acpi_relation"
printf ' CHASSIS  [mag    ] %s · relation=%s · coverage=%s\n' "$magnetic_msg" "$magnetic_acpi_relation" "$magnetic_coverage"
printf ' BODY     [orient ] %s · coverage=%s\n' "$orientation_relation" "$orientation_coverage"
printf ' BODY     [gyro   ] %s · coverage=%s\n' "$gyro_msg" "$gyro_coverage"
printf ' BODY     [paired ] %s · coverage=%s\n' "$note3_posture_rotation_msg" "$note3_posture_rotation_coverage"
printf ' BODY     [field  ] %s · coverage=%s\n' "$field_motion_msg" "$field_motion_coverage"
printf ' INTERRUPTIBILITY[%-7s] %s\n' "$interruptibility" "$interrupt_msg"
# EXPECTED-ABSENCE: the representation-hungry non-event — a device on a learned schedule absent today.
# Line shown only when the fresh cache carries notices (honest no-data → no line, never a false all-present).
[ "${absent_n:-0}" -gt 0 ] && printf ' EXPECTED-ABSENCE[%s] %s\n' "$absent_n" "$absent_msg"
# inclusive disjunction: the two load-bearing terms + the distance between them, which the max-posture
# above collapses. concordant=both axes agree (broad condition) · split=posture rests on one loud axis.
printf ' DISJUNCTION[%-6s] INTERNAL=%s · EXTERNAL=%s (spread=%s, loud=%s)\n' "$concordance" "$int_sev" "$ext_sev" "$spread" "$loud_axis"
# eigenform: does the committed situation object hold as a fixed point under re-observation, or is the
# */15 debounce laundering a raw axis that never settles? churning = the calm label is not a real object.
printf ' EIGENFORM[%-7s] committed=%s · residual=%s%% over last %s raw reads\n' "$eigen_state" "$_committed_obj" "$eigen_resid" "$(cat "$SIT_EIGEN_RING" 2>/dev/null | wc -w)"
# memory horizon: the fixed staleness window (a claim about the WRITER's cadence) beside tau_E, the room's
# OWN timescale, which .room-sense.state publishes and this file has always discarded. Report-only — the
# gate above still uses STALE_MIN. w* applies the sublinear law (Lee/Flack/Krakauer 2024) from the axis's
# median tau_E: it says how far TODAY's volatility should move the window, not what the window should be.
if [ "$tau_e" = na ]; then
  # Two different absences, and they must not collapse into one word: changes_24h=0 is CENSORED (the room
  # held one value all day -> tau_E >= 24h, a bound), while a missing field is BLIND (a pre-dwell-fields
  # state file, or room-sense never ran). [[a-collapsed-reason-makes-blind-and-quiet-identical]].
  if [ "${occ_ch24:-}" = 0 ]; then _mem_why="changes_24h=0 — censored: the room held one value all day, so tau_E >= 1440min (a bound, not a number)"
  else _mem_why="no changes_24h field in .room-sense.state — blind to the room's flip rate, not a calm room"; fi
  printf ' MEMORY-HORIZON[%-7s] occupancy window=%smin · tau_E=na — %s\n' "$mem_verdict" "$STALE_MIN" "$_mem_why"
else
  printf ' MEMORY-HORIZON[%-7s] occupancy window=%smin vs tau_E=%smin (changes_24h=%s, dwell_s=%s) ratio=%s%% · w*=%s (anchor=%s, sublinear sqrt)\n' \
    "$mem_verdict" "$STALE_MIN" "$tau_e" "$occ_ch24" "${occ_dwell_s:-na}" "$mem_ratio" \
    "$([ "$mem_wstar" = na ] && echo na || echo "${mem_wstar}min")" "$mem_rung"
fi
[ "$baro_unreachable" -eq 0 ] && [ "$airtime_unreachable" -eq 0 ] && [ "$nvme_unreachable" -eq 0 ] && [ "$disk_latency_unreachable" -eq 0 ] && [ "$nic_loss_unreachable" -eq 0 ] && [ "$nic_tx_heartbeat_unreachable" -eq 0 ] && [ "$pty_unreachable" -eq 0 ] && [ "$acpi_unreachable" -eq 0 ] && [ "$magnetic_unreachable" -eq 0 ] && [ "$gyro_unreachable" -eq 0 ] && [ "$note3_posture_rotation_unreachable" -eq 0 ] && [ "$field_motion_unreachable" -eq 0 ] && [ "$node_health_unreachable" -eq 0 ] && [ "$system_vitality_unreachable" -eq 0 ] && [ "$gpu_fan_unreachable" -eq 0 ] && [ "$gpu_throttle_unreachable" -eq 0 ] && [ "$gpu_encoder_unreachable" -eq 0 ] && [ "$operator_field_unreachable" -eq 0 ] || exit 2
exit 0
