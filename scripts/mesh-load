#!/usr/bin/env bash
# observer-probe: mesh-load --no-post
#   mesh-observer-effect: a pure READ, safe to run K+3 times. --no-post formats the
#   load line to stdout WITHOUT posting to mesh-chat; the bare form posts.
# mesh-load — report current agent load and quota consumption to mesh-chat.
#
# Usage:
#   mesh-load [idle|busy] [note]
#   mesh-load --no-post [idle|busy] [note]   read-only: print the load line, post nothing
#
# Example:
#   mesh-load busy "syncing with steward"
#   mesh-load idle
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v mesh-usage >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-usage)"; exit 1; }
  command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$td"' EXIT

  # Real dry-run: prove we format and hand off the load line, not just that helpers exist.
  cat > "$td/mesh-usage" <<'EOF'
#!/bin/sh
printf 'total=123 i=1 o=2 c=3\n'
EOF
  chmod +x "$td/mesh-usage"
  cat > "$td/mesh-chat" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" > "$MESH_CHAT_OUT"
EOF
  chmod +x "$td/mesh-chat"
  MESH_CHAT_OUT="$td/chat.out" PATH="$td:$PATH" MESH_AGENT=tester bash "$0" busy "dry-run" >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (dry-run execution failed)"; exit 1; }
  grep -qxF '[load] tester: busy | total=123 i=1 o=2 c=3 (dry-run)' "$td/chat.out" \
    || { out="$(cat "$td/chat.out" 2>/dev/null || true)"; echo "smoke-test: FAIL (bad chat line: $out)"; exit 1; }

  # --no-post must format the same line to stdout and post NOTHING.
  rm -f "$td/chat.out"
  out="$(MESH_CHAT_OUT="$td/chat.out" PATH="$td:$PATH" MESH_AGENT=tester bash "$0" --no-post busy "dry-run" 2>/dev/null)" \
    || { echo "smoke-test: FAIL (--no-post execution failed)"; exit 1; }
  [ "$out" = '[load] tester: busy | total=123 i=1 o=2 c=3 (dry-run)' ] \
    || { echo "smoke-test: FAIL (bad --no-post line: $out)"; exit 1; }
  [ ! -e "$td/chat.out" ] \
    || { echo "smoke-test: FAIL (--no-post posted to mesh-chat)"; exit 1; }

  # Missing helper must fail cleanly.
  if env -i PATH="/usr/bin:/bin" HOME="$HOME" bash "$0" --test >/dev/null 2>&1; then
    echo "smoke-test: FAIL (passed without mesh-usage/mesh-chat)"; exit 1
  fi
  echo "smoke-test: ok"; exit 0
fi

STATUS="${1:-busy}"
NOTE="${2:-}"
NO_POST=0
if [ "$STATUS" = --no-post ]; then
  NO_POST=1
  STATUS="${2:-busy}"
  NOTE="${3:-}"
fi
# Caller self-identifies via MESH_AGENT; the old hardcoded "gemini" misattributed
# every other caller's load line on the board.
AGENT="${MESH_AGENT:-unattributed}"
USAGE=$(mesh-usage)

LINE="[load] $AGENT: $STATUS | $USAGE"
if [ -n "$NOTE" ]; then
    LINE="$LINE ($NOTE)"
fi

if [ "$NO_POST" = 1 ]; then
  printf '%s\n' "$LINE"
else
  mesh-chat "$LINE"
fi
