#!/usr/bin/env bash
# mesh-load — report current agent load and quota consumption to mesh-chat.
#
# Usage:
#   mesh-load [idle|busy] [note]
#
# Example:
#   mesh-load busy "syncing with steward"
#   mesh-load idle
set -uo pipefail
[ "${1:-}" = --test ] && { command -v mesh-usage >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-usage)"; exit 1; }; echo "smoke-test: ok"; exit 0; }

STATUS="${1:-busy}"
NOTE="${2:-}"
AGENT="gemini"
USAGE=$(/home/imozerov/.local/bin/mesh-usage)

LINE="[load] $AGENT: $STATUS | $USAGE"
if [ -n "$NOTE" ]; then
    LINE="$LINE ($NOTE)"
fi

/home/imozerov/.local/bin/mesh-chat "$LINE"
