[Unit]
Description=mesh voice-rx (the mesh HEARS the operator over Telegram — getUpdates poll loop → voice-in.log)
After=default.target

[Service]
Type=simple
# systemd's minimal PATH excludes ~/.local/bin, so mesh-voice-rx's bare `mesh-log-scrub`
# call misses and the secret-scrub safety-belt silently disables — put the mesh bin on PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Token + CHAT_ID come from ~/.config/remote-access/env (read by mesh-voice-rx directly).
# ONE poller per bot token mesh-wide: the loop 409-backoffs gracefully if a competitor exists.
ExecStart=%h/.local/bin/mesh-voice-rx
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
