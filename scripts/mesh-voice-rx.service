[Unit]
Description=mesh voice-rx (the mesh HEARS the operator over Telegram — getUpdates poll loop → voice-in.log)
After=default.target

[Service]
Type=simple
# systemd's minimal PATH excludes ~/.local/bin, so mesh-voice-rx's bare `mesh-log-scrub`
# call misses and the secret-scrub safety-belt silently disables — put the mesh bin on PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Token + CHAT_ID come from ~/.config/remote-access/env (read by mesh-voice-rx directly).
# ONE poller per bot token mesh-wide: the loop 409-backoffs gracefully if a competitor exists.
ExecStart=%h/.local/bin/mesh-voice-rx
Restart=always
RestartSec=5
# THE HANG GUARD (2026-08-21). Restart=always only fires on a process that DIES; on 2026-08-20 this
# poller went deaf for 2h13m without dying — hung in a getUpdates recv, socket ESTABLISHED, unit
# `active (running)` the whole time. A stall is unreachable from inside the stalled loop, so the
# guard lives here: mesh-voice-rx pings WATCHDOG=1 once per loop ITERATION (and after each handled
# update), systemd kills+restarts the unit when the pings stop. NotifyAccess is required for the
# ping to be accepted at all — without it systemd ignores the datagram and the guard is decorative.
# 900s is set above ONE worst-case gap between pings: an update whose handling runs download (60s)
# + whisper transcribe (240s) + pitch axes (120s). A DNS outage keeps pinging (the loop is live and
# honest) and is deliberately NOT restarted.
WatchdogSec=900
NotifyAccess=main

[Install]
WantedBy=default.target
