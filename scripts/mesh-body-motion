#!/usr/bin/env bash
# reflex-cadence: 7-59/10 * * * *
# mesh-body-motion — the mesh's BODY-ACTIVITY sense: is the phone STILL, being WALKED (active
# locomotion), CARRIED (passive transport), HANDLED (being manipulated), or COVERED (face-down/pocket)?
# Fuses the phone's accelerometer (bma420) + ORIENTATION + STEP_COUNTER + ambient light
# (tmd2755_l) + proximity (tmd2755_p) in ONE SSH read and CLASSIFIES the body's physical state.
# When optional sensors are absent, the line says so instead of pretending confidence.
#
# Complements the mesh's other body senses, none of which know if the body is MOVING/HELD:
#   mesh-location  → WHERE the body is        mesh-presence → WHO is near it
#   mesh-body-power→ its battery              mesh-body-motion → WHAT it's doing (this)
# A parked body that suddenly reads CARRIED/HANDLED = tamper / human-interaction / it left its spot.
#
#   mesh-body-motion           one read → one classified text line (the mesh's text substrate)
#   mesh-body-motion --raw     the raw fused sensor JSON (the artifact behind the classification)
#   mesh-body-motion --edge    emit ONLY on a state change vs last read (edge-trigger for streams)
#   mesh-body-motion --test    deps + phone-reachability gate (exit 2 = n/a, phone unreachable)
#
# Read-only (no actuators). Registry-resolved phone (~/.mesh/nodes / mesh-peer-addr).
# Honest-organ: the classification is backed by a REAL multi-sensor read; phone-unreachable
# exits n/a (2), never a fabricated "STILL".
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
STATE="$HOME/.mesh/.body-motion-state"   # holds: <step_counter>|<state-tag>|<hyst>|<pending-tag>
OFFLINEFILE="$HOME/.mesh/.mesh-body-motion-offline"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — all IPs tried)"; exit 2; }
  if ! timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
       -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" 'command -v termux-sensor' </dev/null >/dev/null 2>&1; then
    echo "smoke-test: n/a (phone unreachable or no termux-sensor)"; exit 2; fi
  echo "smoke-test: ok"; exit 0
fi

raw=0; edge=0
for a in "$@"; do case "$a" in --raw) raw=1;; --edge) edge=1;; esac; done

pip="$(mesh-phone-ip 2>/dev/null)" || {
    if [ ! -f "$OFFLINEFILE" ]; then
        echo "[mesh-body-motion] phone offline (all IPs tried) — no body-motion sense" >&2
        mkdir -p "$(dirname "$OFFLINEFILE")" 2>/dev/null && touch "$OFFLINEFILE"
    fi
    exit 2
}
rm -f "$OFFLINEFILE"

# ONE fused read: accel + orientation + step-counter + linear-accel + ambient light + proximity.
# Termux sometimes returns a partial JSON object while sensors are cleaning up; retry once for
# the required accelerometer before declaring the body-motion sense unavailable.
read_sensors() {
  timeout 18 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
    'timeout 12 termux-sensor -s bma420,ORIENTATION,STEP_COUNTER,LINEARACCEL,tmd2755_l,tmd2755_p -n 1' \
    </dev/null 2>/dev/null
}
json="$(read_sensors)"
if [ -n "$json" ] && ! printf '%s' "$json" | grep -q '"bma420"'; then
  sleep 1
  json="$(read_sensors)"
fi
[ -n "$json" ] || { echo "phone unreachable — no body-motion read (not a state, n/a)" >&2; exit 2; }
printf '%s' "$json" | grep -q '"bma420"' || { echo "incomplete sensor read — missing accelerometer, no body-motion classification: $(printf '%s' "$json" | head -c 80)" >&2; exit 2; }

if [ "$raw" = 1 ]; then printf '%s\n' "$json"; exit 0; fi

prev_steps=""; prev_tag=""; prev_hyst=0; prev_pending=""
if [ -f "$STATE" ]; then IFS='|' read -r prev_steps prev_tag prev_hyst prev_pending < "$STATE" 2>/dev/null || true; fi
prev_hyst=${prev_hyst:-0}
HYST_THRESH=2

line="$(printf '%s' "$json" | PREV_STEPS="${prev_steps:-}" PREV_TAG="${prev_tag:-}" HYST="${prev_hyst:-0}" PENDING="${prev_pending:-}" THRESH="${HYST_THRESH:-2}" python3 -c '
import json, sys, os, math
d = json.load(sys.stdin)
def v(k):
    x = d.get(k, {})
    return (x.get("values") if isinstance(x, dict) else None) or []
ac  = v("bma420"); ori = v("ORIENTATION"); lin = v("LINEARACCEL")
stp = v("STEP_COUNTER"); lux = v("tmd2755_l"); prox = v("tmd2755_p")
az    = ori[0] if len(ori) > 0 else 0.0
accel_z = ac[2]  if len(ac)  > 2 else 0.0
lin_mag = math.sqrt(sum(c*c for c in lin)) if lin else 0.0
steps = int(stp[0]) if stp else None
lx    = lux[0] if lux else None
px    = prox[0] if prox else None
prox_near = (px is not None and px == 0)

prev = os.environ.get("PREV_STEPS","")
step_delta = None
if prev.strip() and steps is not None:
    try: step_delta = steps - int(float(prev))
    except Exception: step_delta = None

face_down = accel_z < -5      # screen facing the ground
face_up   = accel_z >  5      # lying flat, screen up
upright   = abs(accel_z) <= 5 # vertical-ish (held / in pocket / standing)
dark      = (lx is not None and lx < 3)
covered   = prox_near or (dark and (face_down or upright))
degraded = []
if steps is None:
    degraded.append("step-counter-missing")
if lx is None:
    degraded.append("lux-missing")
if px is None:
    degraded.append("prox-missing")

# classify — most specific signal wins
if step_delta is not None and step_delta > 0:
    if lin_mag > 1.0:
        if covered:
            raw_tag, raw_st, raw_why = "[body-walking]", "WALKING", "covered locomotion (+%d steps, linaccel=%.2f, prox=%s, lux=%s)" % (step_delta, lin_mag, px, lx)
        else:
            raw_tag, raw_st, raw_why = "[body-walking]", "WALKING", "active locomotion (+%d steps, linaccel=%.2f)" % (step_delta, lin_mag)
    else:
        if covered:
            raw_tag, raw_st, raw_why = "[body-carried]", "CARRIED", "covered transport (+%d steps, linaccel=%.2f, prox=%s, lux=%s)" % (step_delta, lin_mag, px, lx)
        else:
            raw_tag, raw_st, raw_why = "[body-carried]", "CARRIED", "passive transport (+%d steps, linaccel=%.2f)" % (step_delta, lin_mag)
elif lin_mag > 0.5:
    if covered:
        raw_tag, raw_st, raw_why = "[body-handled]", "HANDLED", "covered motion linaccel=%.2f m/s2 (prox=%s, lux=%s)" % (lin_mag, px, lx)
    else:
        raw_tag, raw_st, raw_why = "[body-handled]", "HANDLED", "motion linaccel=%.2f m/s2" % lin_mag
elif prox_near:
    raw_tag, raw_st, raw_why = "[body-covered]", "COVERED", "proximity=near (face-down/pocket)"
elif dark and face_down:
    raw_tag, raw_st, raw_why = "[body-covered]", "COVERED", "face-down + dark (lux=%s)" % lx
elif dark and upright:
    raw_tag, raw_st, raw_why = "[body-covered]", "COVERED", "upright + dark (lux=%s) — pocket?" % lx
else:
    pose = "flat face-up" if face_up else ("face-down" if face_down else "upright")
    raw_tag, raw_st, raw_why = "[body-still]", "STILL", "%s, at rest" % pose

# HYSTERESIS: require N consecutive identical raw candidates before flipping.
# Keep the pending candidate separate from the held state so a stable new state can graduate.
prev_tag = os.environ.get("PREV_TAG", "")
pending = os.environ.get("PENDING", "")
hyst = int(os.environ.get("HYST", "0"))
thresh = int(os.environ.get("THRESH", "2"))
state_name = {
    "[body-walking]": "WALKING",
    "[body-carried]": "CARRIED",
    "[body-handled]": "HANDLED",
    "[body-covered]": "COVERED",
    "[body-still]": "STILL",
}
if raw_tag == prev_tag:
    tag, st, why = raw_tag, raw_st, raw_why
    pending = ""
    hyst = thresh
else:
    if raw_tag == pending:
        hyst = min(hyst + 1, thresh)
    else:
        pending = raw_tag
        hyst = 1
    if hyst < thresh and prev_tag:
        tag = prev_tag
        st = state_name.get(prev_tag, "HELD")
        why = "hyst=%d/%d holding previous state; raw candidate %s %s: %s" % (hyst, thresh, raw_tag, raw_st, raw_why)
    else:
        tag, st, why = raw_tag, raw_st, raw_why
        pending = ""

dtxt = ("Δ%+d" % step_delta) if step_delta is not None else "Δ?"
quality = (" degraded=%s" % ",".join(degraded)) if degraded else ""
print("%s %s — %s | lux=%s prox=%s steps=%s(%s) linaccel=%.2f az=%.0f%s" % (
    tag, st, why, lx, px, steps, dtxt, lin_mag, az, quality ))
print("STATEKEY\t%s\t%s\t%d\t%s" % (steps if steps is not None else "", tag, hyst, pending))  # for the state file
' 2>/dev/null)"

[ -n "$line" ] || { echo "classification failed (sensor parse)"; exit 1; }

# split the human line from the state-key line
out="$(printf '%s\n' "$line" | grep -v '^STATEKEY')"
key="$(printf '%s\n' "$line" | grep '^STATEKEY' | head -1)"
new_steps="$(printf '%s' "$key" | cut -f2)"; new_tag="$(printf '%s' "$key" | cut -f3)"; new_hyst="$(printf '%s' "$key" | cut -f4)"; new_pending="$(printf '%s' "$key" | cut -f5)"
[ -n "${new_steps}${new_tag}" ] && printf '%s|%s|%s|%s\n' "$new_steps" "$new_tag" "$new_hyst" "$new_pending" > "$STATE"

if [ "$edge" = 1 ]; then
  # edge-trigger: only emit (and only feed a stream) when the classified state changes
  [ "$new_tag" = "$prev_tag" ] && exit 0
fi
printf '%s\n' "$out"
