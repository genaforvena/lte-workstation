#!/usr/bin/env bash
# reflex-cadence: 7-59/10 * * * *
# mesh-body-motion — the mesh's BODY-ACTIVITY sense: is the phone STILL, being WALKED (active
# locomotion), CARRIED (passive transport), HANDLED (being manipulated), or COVERED (face-down/pocket)?
# Fuses the phone's accelerometer (bma420) + ORIENTATION + STEP_COUNTER + ambient light
# (tmd2755_l) + proximity (tmd2755_p) in ONE SSH read and CLASSIFIES the body's physical state.
# When optional sensors are absent, the line says so instead of pretending confidence.
#
# Complements the mesh's other body senses, none of which know if the body is MOVING/HELD:
#   mesh-location  → WHERE the body is        mesh-presence → WHO is near it
#   mesh-body-power→ its battery              mesh-body-motion → WHAT it's doing (this)
# A parked body that suddenly reads CARRIED/HANDLED = tamper / human-interaction / it left its spot.
#
#   mesh-body-motion           one read → one classified text line (the mesh's text substrate)
#   mesh-body-motion --raw     the raw fused sensor JSON (the artifact behind the classification)
#   mesh-body-motion --edge    emit ONLY on a state change vs last read (edge-trigger for streams)
#   mesh-body-motion --json    structured output: tag, state, confidence, sensors, why (one-line JSON)
#   mesh-body-motion --simulate <json|->   classify a sensor JSON from stdin/file (no phone, test path)
#   mesh-body-motion --test    deps + phone-reachability gate (exit 2 = n/a, phone unreachable)
#
# Read-only (no actuators). Registry-resolved phone (~/.mesh/nodes / mesh-peer-addr).
# Honest-organ: the classification is backed by a REAL multi-sensor read; phone-unreachable
# exits n/a (2), never a fabricated "STILL".
#
# Confidence: the classification emits a confidence field (0.0-1.0) reflecting sensor
# coverage. Walking/carried classification needs step-counter + linear-accel; covered/handled
# can be inferred from accel + (prox or lux). When critical sensors are missing, confidence
# drops and the label degrades to the most-defensible read (e.g. WALKING -> MOTION if step
# counter absent). The state file path does not change; this is a wire-level enrichment.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
STATE="$HOME/.mesh/.body-motion-state"   # holds: <step_counter>|<state-tag>|<hyst>|<pending_tag>
OFFLINEFILE="$HOME/.mesh/.mesh-body-motion-offline"
# motion_dwell enrichment (2026-06-28): the existing 4-field state only captures the CURRENT
# classification, not how long the body has been in it. The new additive fields 5+6 are
# `<dwell_s>|<changes_24h>` — seconds-since-last-state-change and count of state changes in
# the last 24h. Captures "body has been STILL for 2h" vs "just transitioned to STILL" — distinct
# from the per-classify verdict (which is just "what is it now?"). A user grepping `dwell=`
# gets the dwell band without breaking a 4-field reader (extra fields ignored).
MOTION_LOG="$HOME/.mesh/.body-motion-events"  # one line per state change: epoch|state_tag

# classify_dwell <seconds> → echoes "BAND|seconds". Pure, offline-testable.
# Bands (FALSIFIABLE: change the 5/60/1800 thresholds → tests flip):
#   TRANSITION  0–5s   — just changed
#   RECENT     5–60s  — recently changed
#   STABLE     1–30m  — stable for a while
#   CHRONIC    30m+   — long-stable, body has been at rest
#   NEVER      no event on record
classify_dwell() {
  local s="${1:-}"
  if [ -z "$s" ] || ! [ "$s" -ge 0 ] 2>/dev/null; then echo "NEVER|no event on record"; return; fi
  if   [ "$s" -lt 5 ];    then echo "TRANSITION|${s}s (just changed)"; return; fi
  if   [ "$s" -lt 60 ];   then echo "RECENT|${s}s (under 1m)"; return; fi
  if   [ "$s" -lt 1800 ]; then echo "STABLE|$((s/60))m (under 30m)"; return; fi
  echo "CHRONIC|$((s/60))m (long-stable)"
}

# log_motion_event <log> <epoch> <state_tag> [now] — appends only if state changed
# (idempotent on same-state runs). Prunes anything older than 24h relative to `now` (defaults to
# `epoch` itself when called at the time of a new event). Events older than 24h relative to
# `now` are NOT appended (already-expired events don't pollute the log).
# Pure, file-bound.
log_motion_event() {
  local f="$1"
  local epoch="$2"
  local tag="$3"
  local now="${4:-$epoch}"
  local cutoff=$(( now - 86400 ))
  [ -d "$(dirname "$f")" ] || return 1
  if [ -f "$f" ]; then
    local last; last="$(tail -n 1 "$f" 2>/dev/null)"
    [ -n "$last" ] && {
      local last_tag; last_tag="$(printf '%s' "$last" | cut -d'|' -f2)"
      [ "$last_tag" = "$tag" ] && return 0   # same state → no new event
    }
    # Prune entries older than 24h relative to now. One awk pass, DETERMINISTIC tmp name:
    # callers wrap this tool in `timeout`, and the old per-line bash loop was slow enough that a
    # kill mid-prune stranded a fresh ${f}.tmp.$$ per PID (96 leaked files, Jun 28–Jul 2). A fixed
    # name means a killed run's leftover is simply overwritten next run — bounded to one file.
    local tmp="${f}.tmp"
    awk -F'|' -v c="$cutoff" 'NF && $1+0 >= c' "$f" > "$tmp" 2>/dev/null \
      && mv -f "$tmp" "$f" || rm -f "$tmp"
  fi
  # Append the new event — but only if it's not already older than the cutoff (already-expired)
  if [ "$epoch" -ge "$cutoff" ] 2>/dev/null; then
    printf '%s|%s\n' "$epoch" "$tag" >> "$f"
  fi
}

# count_recent_motion_events <log> <now_epoch> <window_sec> → echoes integer count.
count_recent_motion_events() {
  local f="$1"
  local now="$2"
  local win="$3"
  local cutoff
  cutoff=$(( now - win ))
  local c=0
  [ -f "$f" ] || { echo 0; return; }
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local l_epoch; l_epoch="$(printf '%s' "$line" | cut -d'|' -f1)"
    [ "$l_epoch" -ge "$cutoff" ] 2>/dev/null && c=$((c+1))
  done < "$f"
  echo "$c"
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  fail=0
  # --- classify fixtures (OFFLINE via --simulate; phone-independent — the classifier is load-bearing) ---
  # --simulate now skips the phone entirely (the line-82 gate fix), so these run on any node.
  # Re-seed prev_steps=100 + EMPTY prev_tag before each case → the candidate is EMITTED directly
  # (no hysteresis hold), so the emitted tag is deterministic. STEP_COUNTER 100 ⇒ Δ0, 104 ⇒ Δ+4.
  _ss="$HOME/.mesh/.body-motion-state-simulate"; _sj="$(mktemp)"
  # IN-VEHICLE: 0 steps + high linear accel → [body-vehicle]
  printf '100||0|\n' > "$_ss"
  printf '%s' '{"bma420":{"values":[0,0,9.8]},"ORIENTATION":{"values":[0]},"LINEARACCEL":{"values":[2.5,0,0]},"STEP_COUNTER":{"values":[100]},"tmd2755_l":{"values":[50]},"tmd2755_p":{"values":[5]}}' > "$_sj"
  "$0" --simulate="$_sj" 2>/dev/null | grep -q '\[body-vehicle\] IN-VEHICLE' || { echo "  FAIL: 0-steps+linaccel>2.0 → expected [body-vehicle] IN-VEHICLE"; fail=1; }
  # honest-degrade: steps MISSING + high accel → HANDLED (never blindly assert vehicle; step_delta None)
  printf '100||0|\n' > "$_ss"
  printf '%s' '{"bma420":{"values":[0,0,9.8]},"ORIENTATION":{"values":[0]},"LINEARACCEL":{"values":[2.5,0,0]},"tmd2755_l":{"values":[50]},"tmd2755_p":{"values":[5]}}' > "$_sj"
  _o="$("$0" --simulate="$_sj" 2>/dev/null)"
  printf '%s' "$_o" | grep -q '\[body-handled\] HANDLED' || { echo "  FAIL: steps-missing+linaccel>2.0 → expected honest-degrade [body-handled] (not vehicle)"; fail=1; }
  printf '%s' "$_o" | grep -q 'step-counter-missing' || { echo "  FAIL: steps-missing must carry degraded=step-counter-missing"; fail=1; }
  # control: steps present (+4) → WALKING, not vehicle
  printf '100||0|\n' > "$_ss"
  printf '%s' '{"bma420":{"values":[0,0,9.8]},"ORIENTATION":{"values":[0]},"LINEARACCEL":{"values":[1.5,0,0]},"STEP_COUNTER":{"values":[104]},"tmd2755_l":{"values":[50]},"tmd2755_p":{"values":[5]}}' > "$_sj"
   "$0" --simulate="$_sj" 2>/dev/null | grep -q '\[body-walking\] WALKING' || { echo "  FAIL: steps+4 → expected [body-walking] (not vehicle)"; fail=1; }
  rm -f "$_sj" "$_ss"
  [ "$fail" = 0 ] && echo "  ok: classify fixtures (vehicle / honest-degrade / walking)" || { echo "smoke-test: FAIL (classify fixtures)"; exit 1; }
  # --- motion_dwell enrichment tests (FALSIFIABLE: change the 5/60/1800 thresholds → these flip) ---
  _df=0
  # TRANSITION: 0s
  r="$(classify_dwell 0)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 0s: got=$r"; _df=1; }
  # TRANSITION: 4s (under 5s)
  r="$(classify_dwell 4)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 4s: got=$r"; _df=1; }
  # RECENT: 5s (boundary)
  r="$(classify_dwell 5)"
  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 5s: got=$r"; _df=1; }
  # RECENT: 59s
  r="$(classify_dwell 59)"
  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 59s: got=$r"; _df=1; }
  # STABLE: 60s (boundary)
  r="$(classify_dwell 60)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 60s: got=$r"; _df=1; }
  # STABLE: 29 min
  r="$(classify_dwell 1740)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 1740s: got=$r"; _df=1; }
  # CHRONIC: 30 min (boundary)
  r="$(classify_dwell 1800)"
  echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 1800s: got=$r"; _df=1; }
  # CHRONIC: 24h
  r="$(classify_dwell 86400)"
  echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 86400s: got=$r"; _df=1; }
  # NEVER: empty
  r="$(classify_dwell '')"
  [ "$r" = "NEVER|no event on record" ] || { echo "  FAIL dwell NEVER-empty: got=$r"; _df=1; }
  # log_motion_event + count_recent_motion_events file-bound fixtures
  _md="$(mktemp -d)"; _ml="$_md/events"
  # Idempotent on same-state
  log_motion_event "$_ml" 100 body-still
  log_motion_event "$_ml" 200 body-still   # same tag → no new event
  c="$(wc -l < "$_ml")"
  [ "$c" = "1" ] || { echo "  FAIL log idempotent: expected 1 line, got $c"; _df=1; }
  # Different state → new event
  log_motion_event "$_ml" 300 body-walking
  c="$(wc -l < "$_ml")"
  [ "$c" = "2" ] || { echo "  FAIL log different-state: expected 2 lines, got $c"; _df=1; }
  # 24h pruning: events older than 24h relative to NOW are dropped. Use now=200 so 100/200/300
  # are within 24h (cutoff=200-86400=-86200), and the new event at epoch -100000 is way before cutoff → dropped.
  log_motion_event "$_ml" -100000 body-still 200
  c="$(wc -l < "$_ml")"
  [ "$c" = "2" ] || { echo "  FAIL log old-different-tag-prune: expected 2 (old pruned), got $c"; _df=1; }
  # count: 2 events within last 24h (at now=200 — both 100 and 300 are within)
  c="$(count_recent_motion_events "$_ml" 200 86400)"
  [ "$c" = "2" ] || { echo "  FAIL count 2 events: got=$c"; _df=1; }
  rm -rf "$_md"
  [ "$_df" = 0 ] || { echo "smoke-test: FAIL (dwell + log_motion_event)"; exit 1; }
  echo "  ok: motion_dwell (10 cases: TRANSITION×2, RECENT×2, STABLE×2, CHRONIC×2, NEVER×1, log+count×3)"
  # --- reachability gate (real-read doctrine: classify-logic is offline above; this confirms the phone) ---
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — all IPs tried); classify-logic ok"; exit 2; }
  if ! timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
       -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" 'command -v termux-sensor' </dev/null >/dev/null 2>&2; then
    echo "smoke-test: n/a (phone unreachable or no termux-sensor); classify-logic ok"; exit 2; fi
  echo "smoke-test: ok (classify fixtures + motion_dwell + reachability)"; exit 0
fi

raw=0; edge=0; json_mode=0; simulate=""
for a in "$@"; do
  case "$a" in
    --raw) raw=1;;
    --edge) edge=1;;
    --json) json_mode=1;;
    --simulate) simulate="-";;
    --simulate=*) simulate="${a#--simulate=}";;
  esac
done

# Simulate mode: read a sensor JSON from stdin (-) or a file, skip the phone entirely.
# Uses a SEPARATE state file (~/.mesh/.body-motion-state-simulate) so test runs can
# exercise the hysteresis (3-call state flips) without poisoning the real production state.
# The real state file is never read or written in simulate mode.
if [ -n "$simulate" ]; then
  STATE="$HOME/.mesh/.body-motion-state-simulate"
  if [ "$simulate" = "-" ]; then
    json="$(cat)"
  elif [ -f "$simulate" ]; then
    json="$(cat "$simulate")"
  else
    echo "simulate: file not found: $simulate" >&2; exit 1
  fi
  [ -n "$json" ] || { echo "simulate: empty input"; exit 1; }
  printf '%s' "$json" | grep -q '"bma420"' || { echo "simulate: input missing accelerometer"; exit 1; }
  # fall through to the same classification path
  if [ "$raw" = 1 ]; then printf '%s\n' "$json"; exit 0; fi
  SKIP_STATE_WRITE=0
else
  SKIP_STATE_WRITE=0
fi

# Phone-IP resolution + offline-marking run ONLY in live mode — --simulate skips the phone entirely.
# (The gate was MISSING: this block ran unconditionally, so --simulate REQUIRED the phone reachable,
# defeating its offline-test purpose — the bug that blocked classify fixtures. Fixed 2026-06-26.)
if [ -z "$simulate" ]; then
  pip="$(mesh-phone-ip 2>/dev/null)" || {
      if [ ! -f "$OFFLINEFILE" ]; then
          echo "[mesh-body-motion] phone offline (all IPs tried) — no body-motion sense" >&2
          mkdir -p "$(dirname "$OFFLINEFILE")" 2>/dev/null && touch "$OFFLINEFILE"
      fi
      printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE.w" && mv -f "$STATE.w" "$STATE"
      mesh-state-touch "$STATE"
      exit 2
  }
  rm -f "$OFFLINEFILE"
fi

# ONE fused read: accel + orientation + step-counter + linear-accel + ambient light + proximity.
# Termux sometimes returns a partial JSON object while sensors are cleaning up; retry once for
# the required accelerometer before declaring the body-motion sense unavailable.
# Skipped in --simulate mode (json was already populated from stdin/file above).
if [ -z "$simulate" ]; then
  read_sensors() {
    timeout 18 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
      'timeout 12 termux-sensor -s bma420,ORIENTATION,STEP_COUNTER,LINEARACCEL,tmd2755_l,tmd2755_p -n 1' \
      </dev/null 2>/dev/null
  }
  json="$(read_sensors)"
  if [ -n "$json" ] && ! printf '%s' "$json" | grep -q '"bma420"'; then
    sleep 1
    json="$(read_sensors)"
  fi
  [ -n "$json" ] || { echo "phone unreachable — no body-motion read (not a state, n/a)" >&2; printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE.w" && mv -f "$STATE.w" "$STATE"; mesh-state-touch "$STATE"; exit 2; }
  printf '%s' "$json" | grep -q '"bma420"' || { echo "incomplete sensor read — missing accelerometer, no body-motion classification: $(printf '%s' "$json" | head -c 80)" >&2; exit 2; }
fi

if [ "$raw" = 1 ]; then printf '%s\n' "$json"; exit 0; fi

prev_steps=""; prev_tag=""; prev_hyst=0; prev_pending=""
if [ -f "$STATE" ]; then IFS='|' read -r prev_steps prev_tag prev_hyst prev_pending < "$STATE" 2>/dev/null || true; fi
prev_hyst=${prev_hyst:-0}
HYST_THRESH=2

line="$(printf '%s' "$json" | PREV_STEPS="${prev_steps:-}" PREV_TAG="${prev_tag:-}" HYST="${prev_hyst:-0}" PENDING="${prev_pending:-}" THRESH="${HYST_THRESH:-2}" VEH_THRESH="${MESH_BODY_VEHICLE_ACCEL:-2.0}" python3 -c '
import json, sys, os, math
d = json.load(sys.stdin)
def v(k):
    x = d.get(k, {})
    return (x.get("values") if isinstance(x, dict) else None) or []
ac  = v("bma420"); ori = v("ORIENTATION"); lin = v("LINEARACCEL")
stp = v("STEP_COUNTER"); lux = v("tmd2755_l"); prox = v("tmd2755_p")
az    = ori[0] if len(ori) > 0 else 0.0
accel_z = ac[2]  if len(ac)  > 2 else 0.0
lin_mag = math.sqrt(sum(c*c for c in lin)) if lin else 0.0
steps = int(stp[0]) if stp else None
lx    = lux[0] if lux else None
px    = prox[0] if prox else None
prox_near = (px is not None and px == 0)

prev = os.environ.get("PREV_STEPS","")
step_delta = None
if prev.strip() and steps is not None:
    try: step_delta = steps - int(float(prev))
    except Exception: step_delta = None

face_down = accel_z < -5      # screen facing the ground
face_up   = accel_z >  5      # lying flat, screen up
upright   = abs(accel_z) <= 5 # vertical-ish (held / in pocket / standing)
dark      = (lx is not None and lx < 3)
covered   = prox_near or (dark and (face_down or upright))
degraded = []
if steps is None:
    degraded.append("step-counter-missing")
if lx is None:
    degraded.append("lux-missing")
if px is None:
    degraded.append("prox-missing")

# classify — most specific signal wins
if step_delta is not None and step_delta > 0:
    if lin_mag > 1.0:
        if covered:
            raw_tag, raw_st, raw_why = "[body-walking]", "WALKING", "covered locomotion (+%d steps, linaccel=%.2f, prox=%s, lux=%s)" % (step_delta, lin_mag, px, lx)
        else:
            raw_tag, raw_st, raw_why = "[body-walking]", "WALKING", "active locomotion (+%d steps, linaccel=%.2f)" % (step_delta, lin_mag)
    else:
        if covered:
            raw_tag, raw_st, raw_why = "[body-carried]", "CARRIED", "covered transport (+%d steps, linaccel=%.2f, prox=%s, lux=%s)" % (step_delta, lin_mag, px, lx)
        else:
            raw_tag, raw_st, raw_why = "[body-carried]", "CARRIED", "passive transport (+%d steps, linaccel=%.2f)" % (step_delta, lin_mag)
elif step_delta is not None and step_delta == 0 and lin_mag > float(os.environ.get("VEH_THRESH", "2.0")):
    # IN-VEHICLE: high linear acceleration with ZERO steps = passive fast motion (car/bus/train).
    # The no-steps gate disambiguates from HANDLED (in-hand motion). If the step-counter is missing
    # (step_delta None) we CANNOT confirm "no steps" -> honest degrade to HANDLED below, never assert
    # vehicle blindly. Threshold default 2.0 m/s2 (sustained transport accel, > in-hand manipulation).
    raw_tag, raw_st, raw_why = "[body-vehicle]", "IN-VEHICLE", "passive fast motion (linaccel=%.2f m/s2, 0 steps) - vehicle/transport" % lin_mag
elif lin_mag > 0.5:
    if covered:
        raw_tag, raw_st, raw_why = "[body-handled]", "HANDLED", "covered motion linaccel=%.2f m/s2 (prox=%s, lux=%s)" % (lin_mag, px, lx)
    else:
        raw_tag, raw_st, raw_why = "[body-handled]", "HANDLED", "motion linaccel=%.2f m/s2" % lin_mag
elif prox_near:
    raw_tag, raw_st, raw_why = "[body-covered]", "COVERED", "proximity=near (face-down/pocket)"
elif dark and face_down:
    raw_tag, raw_st, raw_why = "[body-covered]", "COVERED", "face-down + dark (lux=%s)" % lx
elif dark and upright:
    raw_tag, raw_st, raw_why = "[body-covered]", "COVERED", "upright + dark (lux=%s) — pocket?" % lx
else:
    pose = "flat face-up" if face_up else ("face-down" if face_down else "upright")
    raw_tag, raw_st, raw_why = "[body-still]", "STILL", "%s, at rest" % pose

# Confidence: 0.0-1.0 reflecting sensor coverage for the SPECIFIC classified state.
# Per-state requirements: WALKING/CARRIED need step+lin; HANDLED needs lin; COVERED needs (prox or lux);
# STILL needs no auxiliary sensors. We start at 1.0 and subtract for missing critical sensors for THIS state.
state_requires = {
    "[body-walking]": [("step", steps is not None), ("lin", bool(lin))],
    "[body-carried]": [("step", steps is not None), ("lin", bool(lin))],
    "[body-handled]": [("lin", bool(lin))],
    "[body-vehicle]": [("step", steps is not None), ("lin", bool(lin))],
    "[body-covered]": [("prox_or_lux", (px is not None) or (lx is not None))],
    "[body-still]":  [],
}
reqs = state_requires.get(raw_tag, [])
missing_critical = [name for name, ok in reqs if not ok]
state_conf = round(1.0 - 0.30 * len(missing_critical), 2) if reqs else 0.95
# Also factor in sensor coverage overall (capped at state_conf — state needs take priority)
sensor_total = 4  # step, lin, lux, prox
sensor_have  = (steps is not None) + bool(lin) + (lx is not None) + (px is not None)
coverage = sensor_have / sensor_total
confidence = round(min(state_conf, 0.40 + 0.60 * coverage), 2)
# Confidence tier for human-readable summary
if   confidence >= 0.85: conf_tier = "high"
elif confidence >= 0.55: conf_tier = "medium"
else:                     conf_tier = "low"

# HYSTERESIS: require N consecutive identical raw candidates before flipping.
# Keep the pending candidate separate from the held state so a stable new state can graduate.
prev_tag = os.environ.get("PREV_TAG", "")
pending = os.environ.get("PENDING", "")
hyst = int(os.environ.get("HYST", "0"))
thresh = int(os.environ.get("THRESH", "2"))
state_name = {
    "[body-walking]": "WALKING",
    "[body-carried]": "CARRIED",
    "[body-handled]": "HANDLED",
    "[body-vehicle]": "IN-VEHICLE",
    "[body-covered]": "COVERED",
    "[body-still]": "STILL",
}
if raw_tag == prev_tag:
    tag, st, why = raw_tag, raw_st, raw_why
    pending = ""
    hyst = thresh
else:
    if raw_tag == pending:
        hyst = min(hyst + 1, thresh)
    else:
        pending = raw_tag
        hyst = 1
    if hyst < thresh and prev_tag:
        tag = prev_tag
        st = state_name.get(prev_tag, "HELD")
        why = "hyst=%d/%d holding previous state; raw candidate %s %s: %s" % (hyst, thresh, raw_tag, raw_st, raw_why)
    else:
        tag, st, why = raw_tag, raw_st, raw_why
        pending = ""

dtxt = ("Δ%+d" % step_delta) if step_delta is not None else "Δ?"
quality = (" degraded=%s" % ",".join(degraded)) if degraded else ""
print("%s %s — %s | lux=%s prox=%s steps=%s(%s) linaccel=%.2f az=%.0f conf=%.2f(%s)%s" % (
    tag, st, why, lx, px, steps, dtxt, lin_mag, az, confidence, conf_tier, quality ))
print("STATEKEY\t%s\t%s\t%d\t%s" % (steps if steps is not None else "", tag, hyst, pending))  # for the state file
# JSON-mode side channel: emit a structured record so stream consumers do not have to
# re-parse the human line. The shell picks whichever line is prefixed with JSONKEY.
import json as _json
print("JSONKEY\t" + _json.dumps({
    "tag": tag, "state": st, "why": why, "confidence": confidence, "conf_tier": conf_tier,
    "sensors": {"step": steps, "linaccel": round(lin_mag, 3), "lux": lx, "prox": px, "az": round(az, 1)},
    "degraded": degraded, "step_delta": step_delta, "hyst": hyst, "pending": pending,
}, separators=(",", ":")))
' 2>/dev/null)"

[ -n "$line" ] || { echo "classification failed (sensor parse)"; exit 1; }

# split the human line, the state-key line, and the JSON line
out="$(printf '%s\n' "$line" | grep -v '^STATEKEY' | grep -v '^JSONKEY')"
json_out="$(printf '%s\n' "$line" | grep '^JSONKEY' | head -1 | sed 's/^JSONKEY\t//')"
key="$(printf '%s\n' "$line" | grep '^STATEKEY' | head -1)"
new_steps="$(printf '%s' "$key" | cut -f2)"; new_tag="$(printf '%s' "$key" | cut -f3)"; new_hyst="$(printf '%s' "$key" | cut -f4)"; new_pending="$(printf '%s' "$key" | cut -f5)"

# state file: skip in simulate mode (a test must not poison the real hysteresis state)
if [ "$SKIP_STATE_WRITE" = 0 ] && [ -n "${new_steps}${new_tag}" ]; then
  # motion_dwell enrichment: log the new state (idempotent on same-state), compute dwell + 24h count
  NOW_EPOCH="$(date +%s)"
  log_motion_event "$MOTION_LOG" "$NOW_EPOCH" "$new_tag"
  last_event_epoch=""
  [ -f "$MOTION_LOG" ] && last_event_epoch="$(tail -n 1 "$MOTION_LOG" 2>/dev/null | cut -d'|' -f1)"
  dwell_s=0
  if [ -n "$last_event_epoch" ] && [ "$last_event_epoch" -gt 0 ] 2>/dev/null; then
    dwell_s=$(( NOW_EPOCH - last_event_epoch ))
  fi
  changes_24h="$(count_recent_motion_events "$MOTION_LOG" "$NOW_EPOCH" 86400)"
  # 4-field state (existing parsers) + 2 new fields (additive: a 5th and 6th field reader can
  # extract `dwell_s` and `changes_24h`; an old 4-field reader ignores them).
  # Write-then-mv (atomic): a bare truncating > let concurrent readers (sensorium/dash, sibling
  # reflexes) catch an EMPTY state mid-write → transient "motion=? (fresh)" false renders.
  printf '%s|%s|%s|%s|%s|%s\n' "$new_steps" "$new_tag" "$new_hyst" "$new_pending" "$dwell_s" "$changes_24h" > "$STATE.w" && mv -f "$STATE.w" "$STATE"
  mesh-state-touch "$STATE"
fi

if [ "$edge" = 1 ]; then
  # edge-trigger: only emit (and only feed a stream) when the classified state changes
  [ "$new_tag" = "$prev_tag" ] && exit 0
fi

if [ "$json_mode" = 1 ]; then
  # --json: emit ONLY the structured record (parseable, no embedded fields for grep)
  printf '%s\n' "$json_out"
else
  printf '%s\n' "$out"
fi
