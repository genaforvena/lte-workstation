#!/usr/bin/env bash
# reflex-cadence: 7-59/10 * * * *
# doctor-artifact: $HOME/.mesh/.body-motion-state 1800 phone
# mesh-body-motion — compatibility entrypoint; phone sensor implementation lives in integrations/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in
  */*) ;;
  *) self="$(command -v "$self")" || exit 127 ;;
esac

# Resolve installed symlinks back to this repository before selecting the sibling source.
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in
    /*) self="$link_target" ;;
    *) self="$self_dir/$link_target" ;;
  esac
done

script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/integrations/mesh-body-motion"
if [ ! -x "$implementation" ]; then
  repo_root="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
  implementation="$repo_root/scripts/integrations/mesh-body-motion"
fi
[ -x "$implementation" ] || {
  printf 'mesh-body-motion: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
