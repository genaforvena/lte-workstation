#!/usr/bin/env bash
# orphan-ok: on-demand derived sense, consumed by fusers (home-state/operator-home/operator-mood) — not scheduled
# mesh-operator-awake — DIGITAL-PRESENCE sense: is the operator demonstrably AWAKE & REACHABLE *right now*,
# inferred from their own Telegram message activity (voice-in.log) — a signal ORTHOGONAL to every
# physical sensor the mesh has.
#
# WHY THIS EXISTS — the gap it fills (audited 2026-06-28, gen-pair mesh-voice-rx × mesh-home-state):
#   Every operator/home fusion — mesh-home-state, mesh-operator-state/-home/-context/-engagement,
#   mesh-operator-mood — infers from PHYSICAL sensors: phone BLE/LAN/motion/light, room mic, Tailscale.
#   NONE reads the operator's words *arriving*. Two failure modes that costs them:
#     1. ASLEEP vs AWAY are sensor-identical (both quiet + dark + still). A message in the last N min
#        PROVES the operator is awake → vetoes ASLEEP (asymmetric, like mesh-home-state's existing
#        ambient-clock ACTIVE veto).
#     2. When the phone is OFFLINE (the Redmi is "OFTEN OFFLINE"), every physical operator-tool
#        collapses to AWAY/UNKNOWN — yet a TG message (sent from ANY device) still proves the operator
#        is awake. Digital liveness is the fallback exactly when physical sensing is dark.
#
# ASYMMETRY (honest-fusion): a FRESH message is STRONG evidence of awake. Its ABSENCE is WEAK — the
# operator can be awake for hours without messaging. So a consumer may use this to VETO ASLEEP or refine
# AWAY ("out but awake"), but MUST NEVER use it to ASSERT ASLEEP. IDLE = "no digital-presence signal",
# NOT "asleep".
#
# Labels (by age of the last OPERATOR message; voice-in.log holds operator-only lines — strangers are
# split off to tg-strangers.log by mesh-voice-rx, so tail -1 IS the last operator message):
#   AWAKE   ≤ FRESH_S  (default 30m) — operator demonstrably awake & reachable NOW
#   RECENT  ≤ RECENT_S (default 2h)  — operator active recently (weaker)
#   IDLE    older / none in window   — no digital-presence signal (NOT asleep)
#   UNKNOWN no/empty/unparseable log — sense unavailable (honest, never a fake AWAKE)
#
#   mesh-operator-awake          one-line label + age + last-message kind
#   mesh-operator-awake --json   machine-readable {label,age_s,last_ts,kind}
#   mesh-operator-awake --test   smoke test (synthetic voice-in fixtures)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

LOG="${MESH_VOICE_IN_LOG:-$HOME/.mesh/voice-in.log}"
FRESH_S="${MESH_AWAKE_FRESH_S:-1800}"     # 30 min — "awake & reachable now"
RECENT_S="${MESH_AWAKE_RECENT_S:-7200}"   # 2 h   — "active recently"

# classify_awake <age_s> → LABEL  (pure, offline-testable; empty age → UNKNOWN)
classify_awake() {
  local age="$1"
  [ -z "$age" ] && { echo UNKNOWN; return; }
  if   [ "$age" -le "$FRESH_S"  ]; then echo AWAKE
  elif [ "$age" -le "$RECENT_S" ]; then echo RECENT
  else echo IDLE; fi
}

if [ "${1:-}" = --test ]; then
  f=0
  FRESH_S=1800; RECENT_S=7200
  # --- pure classifier bands (incl. exact boundaries) ---
  [ "$(classify_awake 0)"    = AWAKE ]   || { echo "  FAIL classify 0→AWAKE"; f=1; }
  [ "$(classify_awake 1800)" = AWAKE ]   || { echo "  FAIL classify 1800→AWAKE (boundary)"; f=1; }
  [ "$(classify_awake 1801)" = RECENT ]  || { echo "  FAIL classify 1801→RECENT"; f=1; }
  [ "$(classify_awake 7200)" = RECENT ]  || { echo "  FAIL classify 7200→RECENT (boundary)"; f=1; }
  [ "$(classify_awake 7201)" = IDLE ]    || { echo "  FAIL classify 7201→IDLE"; f=1; }
  [ "$(classify_awake '')"   = UNKNOWN ] || { echo "  FAIL classify empty→UNKNOWN"; f=1; }
  # --- end-to-end on synthetic voice-in.log fixtures (real read, not just the classifier) ---
  wd="$(mktemp -d)"; mkdir -p "$wd/.mesh"
  printf '%s  TEXT  hi\n' "$(date -u +%FT%TZ)" > "$wd/.mesh/voice-in.log"
  out="$(HOME="$wd" "$0" --json 2>/dev/null)"
  echo "$out" | grep -q '"label":"AWAKE"' || { echo "  FAIL e2e fresh→AWAKE: $out"; f=1; }
  printf '%s  TEXT  old\n' "$(date -u -d '5 hours ago' +%FT%TZ)" > "$wd/.mesh/voice-in.log"
  out="$(HOME="$wd" "$0" --json 2>/dev/null)"
  echo "$out" | grep -q '"label":"IDLE"' || { echo "  FAIL e2e stale→IDLE: $out"; f=1; }
  rm -f "$wd/.mesh/voice-in.log"
  out="$(HOME="$wd" "$0" --json 2>/dev/null)"
  echo "$out" | grep -q '"label":"UNKNOWN"' || { echo "  FAIL e2e nolog→UNKNOWN: $out"; f=1; }
  rm -rf "$wd"
  [ "$f" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (6 classifier bands + 3 e2e: AWAKE/IDLE/UNKNOWN)"
  exit 0
fi

# --- live read: last operator message age ---
last_ts=""; kind=""
if [ -f "$LOG" ]; then
  line="$(tail -1 "$LOG" 2>/dev/null)"
  last_ts="$(printf '%s' "$line" | awk '{print $1}')"
  kind="$(printf '%s' "$line" | awk '{print $2}')"
fi
age=""; label=UNKNOWN
if [ -n "$last_ts" ]; then
  then_s="$(date -d "$last_ts" +%s 2>/dev/null || true)"
  if [ -n "$then_s" ]; then age=$(( $(date +%s) - then_s )); label="$(classify_awake "$age")"; fi
fi

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","age_s":%s,"last_ts":"%s","kind":"%s"}\n' \
    "$label" "${age:-null}" "$last_ts" "$kind"
  exit 0
fi
if [ "$label" = UNKNOWN ]; then
  echo "operator-awake: UNKNOWN (no operator TG activity log)"
else
  printf 'operator-awake: %s (last msg %ss ago, kind=%s)\n' "$label" "$age" "${kind:-?}"
fi
