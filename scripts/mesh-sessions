#!/usr/bin/env bash
# mesh-sessions — LOGIN-SESSION sense: who holds a live session on THIS node right now, and from
# WHERE. A signal the mesh did not perceive before: the existing senses cover the environment + the
# node's metabolism (load/psi/net/power/thermal), but nothing senses *attended-ness* — that a human
# or peer is actively logged in, and whether the source is an internal mesh peer or an unexpected
# EXTERNAL login. An SSH session from a public IP we don't recognise is a real, actionable signal.
#
# Source: utmp via `w -h -i`, falling back to `utmpdump` when `w` reports zero rows (it does that
# on a tmux-only node even as root — see utmp_to_w). Numeric source IPs — no DNS, fast, always
# local. For every session
# whose FROM field is a dotted IP (a REMOTE login; local console/tty/seat show `-`), classify the
# source:
#   MESH    — Tailscale CGNAT (100.64.0.0/10) or RFC1918 LAN (10/8, 172.16/12, 192.168/16): a peer
#   FOREIGN — any public source IP: an external login (escalate)
#
# Verdict vocab (stable — text consumers grep these):
#   QUIET    — no remote sessions (local console / tmux only)
#   MESH     — >=1 remote session, ALL from internal peers
#   FOREIGN  — >=1 remote session from a PUBLIC source IP (security-relevant)
#
# HONEST-degraded contract: exit 2 if `w` is missing, if utmp is genuinely unreadable, or if a
# source is present but UNCLASSIFIABLE (non-IPv4 ut_addr). An empty `w` alone is NOT blindness. NEVER
# fake QUIET on a tool failure — a silent all-clear would hide a foreign login. "No remote sessions"
# (a real QUIET) and "cannot read sessions" (exit 2) are distinct.
#
#   mesh-sessions          one-line verdict + sources
#   mesh-sessions --json   machine-readable
#   mesh-sessions --test   pure parse/classify smoke (no utmp dependency)
#
# orphan-ok: on-demand login/security probe — NOT auto-wired (a foreign-login alarm reflex is an
#   operator-reviewed decision, not something to self-wire silently).
#
# Exit: 0 ok (QUIET/MESH/FOREIGN) · 2 `w` missing / utmp unreadable / source unclassifiable
#       (honest-degraded, never faked).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Classify a dotted source IP → MESH | FOREIGN. Pure function (testable, no I/O).
classify_src() {  # <ip>
  case "$1" in
    # Tailscale CGNAT 100.64.0.0/10 → second octet 64..127
    100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) echo MESH ;;
    # RFC1918 private
    10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)         echo MESH ;;
    *)                                                            echo FOREIGN ;;
  esac
}

# Derive the verdict from `w -h -i`-style lines on stdin. Prints "VERDICT|detail". Pure (testable).
derive() {
  local raw ips ip cls nmesh=0 nforeign=0 mesh_list="" foreign_list=""
  raw="$(cat)"
  # FROM is field 3; keep only dotted-quad IPs (remote sessions). Local tty/seat show '-'.
  ips="$(printf '%s\n' "$raw" | awk '{print $3}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)"
  while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    cls="$(classify_src "$ip")"
    if [ "$cls" = FOREIGN ]; then nforeign=$((nforeign+1)); foreign_list="$foreign_list $ip"
    else                          nmesh=$((nmesh+1));      mesh_list="$mesh_list $ip"; fi
  done <<EOF
$ips
EOF
  if   [ "$nforeign" -gt 0 ]; then echo "FOREIGN|${nforeign} external src(${foreign_list# }) + ${nmesh} mesh peer(s)"
  elif [ "$nmesh"    -gt 0 ]; then echo "MESH|${nmesh} remote mesh session(s):${mesh_list}"
  else                             echo "QUIET|no remote sessions (local console/tmux only)"
  fi
}

# FALLBACK SOURCE. `w -h -i` returning EMPTY is NOT proof that utmp is unreadable, and this tool
# asserted exactly that for its whole life ("utmp always lists at least the running session").
# Measured 2026-08-21T17:49Z on mesh-home: `w -h` printed `0 user` and zero rows AS uid 1000 AND AS
# ROOT, while /run/utmp (mode 664, 54.8K) held 36 USER_PROCESS records that `who` and `utmpdump`
# both enumerated in the same instant. procps-ng 4.0.4 `w` drops entries it cannot tie to a login
# process, and on this node EVERY pty is a tmux pane (there is no keyboard at all) — so `w` is empty
# by construction here while the session table is perfectly readable. The old branch turned that
# into exit 2 with the reason "utmp unreadable", which names a file-permission cause that is FALSE
# and sends a repairer at a healthy file, while mesh-attendance's REMOTE axis went UNKNOWN.
#
# Read the records directly instead. Emits `w -h -i`-shaped lines (user tty FROM) from utmpdump text
# on stdin, USER_PROCESS (type 7) only; 0.0.0.0 (local/tmux) becomes `-`, exactly as `w` renders a
# local seat. Pure (testable, no I/O).
utmp_to_w() {
  awk -F'\\] \\[' '
    { t=$1; sub(/^\[/,"",t)
      if (t+0 != 7) next
      u=$4; l=$5; a=$7
      gsub(/^ +| +$/,"",u); gsub(/^ +| +$/,"",l); gsub(/^ +| +$/,"",a)
      if (u == "") next
      if (a == "0.0.0.0" || a == "") a="-"
      print u, l, a }'
}

# An addr we cannot CLASSIFY must not be silently dropped to `-` — that is a faked all-clear, the
# one thing this tool exists to refuse. IPv6 sources land here. Prints the unclassifiable addrs.
utmp_unclassifiable() {
  awk -F'\\] \\[' '
    { t=$1; sub(/^\[/,"",t)
      if (t+0 != 7) next
      a=$7; gsub(/^ +| +$/,"",a)
      if (a == "0.0.0.0" || a == "" || a ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) next
      print a }' | sort -u
}

if [ "${1:-}" = --test ]; then
  f=0
  # classify_src boundaries
  [ "$(classify_src 100.107.198.111)" = MESH ]   || { echo "  FAIL: 100.107.x (tailscale) → MESH"; f=1; }
  [ "$(classify_src 100.64.0.1)"      = MESH ]   || { echo "  FAIL: 100.64 low-CGNAT → MESH"; f=1; }
  [ "$(classify_src 100.127.255.1)"   = MESH ]   || { echo "  FAIL: 100.127 high-CGNAT → MESH"; f=1; }
  [ "$(classify_src 192.168.8.9)"     = MESH ]   || { echo "  FAIL: 192.168 RFC1918 → MESH"; f=1; }
  [ "$(classify_src 10.0.0.5)"        = MESH ]   || { echo "  FAIL: 10/8 RFC1918 → MESH"; f=1; }
  [ "$(classify_src 172.16.0.1)"      = MESH ]   || { echo "  FAIL: 172.16 RFC1918 → MESH"; f=1; }
  # FALSIFIABLE: public + just-outside-CGNAT must be FOREIGN (else a real external login reads safe)
  [ "$(classify_src 8.8.8.8)"         = FOREIGN ]|| { echo "  FAIL: 8.8.8.8 public → FOREIGN"; f=1; }
  [ "$(classify_src 100.63.0.1)"      = FOREIGN ]|| { echo "  FAIL: 100.63 (below CGNAT) → FOREIGN"; f=1; }
  [ "$(classify_src 100.128.0.1)"     = FOREIGN ]|| { echo "  FAIL: 100.128 (above CGNAT) → FOREIGN"; f=1; }
  [ "$(classify_src 172.32.0.1)"      = FOREIGN ]|| { echo "  FAIL: 172.32 (above RFC1918) → FOREIGN"; f=1; }
  # derive: a foreign source dominates the verdict
  printf 'u pts/0 8.8.8.8 x\nu pts/1 100.107.198.111 y\n' | derive | grep -q '^FOREIGN|' || { echo "  FAIL: foreign src → FOREIGN verdict"; f=1; }
  # derive: only internal peers → MESH
  printf 'u pts/0 100.107.198.111 x\nu pts/1 192.168.8.9 y\n' | derive | grep -q '^MESH|2 ' || { echo "  FAIL: 2 mesh peers → MESH(2)"; f=1; }
  # derive: local-only (no IP in FROM) → QUIET
  printf 'u tty2 - x\nu seat0 - y\n' | derive | grep -q '^QUIET|' || { echo "  FAIL: local-only → QUIET"; f=1; }
  # derive: dedup same source IP (2 pts from one peer = 1 peer)
  printf 'u pts/0 100.107.198.111 a\nu pts/1 100.107.198.111 b\n' | derive | grep -q '^MESH|1 ' || { echo "  FAIL: dup src not deduped to 1"; f=1; }
  # utmp_to_w: a REAL utmpdump line (captured from /run/utmp on this node) with a tmux 0.0.0.0
  # source renders local (`-`) -> QUIET, and a foreign ut_addr renders FOREIGN. This is the gate on
  # the `w`-empty fallback: revert utmp_to_w to nothing and the foreign row below reads QUIET.
  UD_LOCAL='[7] [2877149] [ts/0] [mesh-home] [pts/0       ] [tmux(2877149).%3    ] [0.0.0.0        ] [2026-08-21T13:55:01,320260+00:00]'
  UD_FOREIGN='[7] [3001] [ts/9] [mesh-home] [pts/9       ] [8.8.8.8             ] [8.8.8.8        ] [2026-08-21T17:00:00,000000+00:00]'
  UD_MESH='[7] [3002] [ts/8] [mesh-home] [pts/8       ] [ideapad             ] [100.73.170.56  ] [2026-08-21T17:00:00,000000+00:00]'
  UD_DEAD='[8] [2844649] [/140] [mesh-home] [pts/140     ] [                    ] [0.0.0.0        ] [2026-08-21T16:34:20,926855+00:00]'
  [ "$(printf '%s\n' "$UD_LOCAL" | utmp_to_w)" = "mesh-home pts/0 -" ] \
    || { echo "  FAIL: utmp_to_w local(0.0.0.0) → 'user tty -'"; f=1; }
  printf '%s\n' "$UD_FOREIGN" | utmp_to_w | derive | grep -q '^FOREIGN|' \
    || { echo "  FAIL: utmp_to_w foreign ut_addr → FOREIGN (a dropped addr would fake QUIET)"; f=1; }
  printf '%s\n' "$UD_MESH" | utmp_to_w | derive | grep -q '^MESH|1 ' \
    || { echo "  FAIL: utmp_to_w mesh ut_addr → MESH(1)"; f=1; }
  # DEAD_PROCESS (type 8) records are the MAJORITY of this node's utmp (107 of 145 when measured);
  # counting them would invent sessions that ended.
  [ -z "$(printf '%s\n' "$UD_DEAD" | utmp_to_w)" ] \
    || { echo "  FAIL: utmp_to_w must ignore DEAD_PROCESS (type 8)"; f=1; }
  # the local+dead pair is a REAL empty-remote table → QUIET is honest here, not a fake
  printf '%s\n%s\n' "$UD_LOCAL" "$UD_DEAD" | utmp_to_w | derive | grep -q '^QUIET|' \
    || { echo "  FAIL: tmux-only utmp → QUIET"; f=1; }
  # unclassifiable (IPv6) must be SURFACED, never silently dropped to `-`
  UD_V6='[7] [3003] [ts/7] [mesh-home] [pts/7       ] [v6peer              ] [2001:db8::1    ] [2026-08-21T17:00:00,000000+00:00]'
  [ "$(printf '%s\n' "$UD_V6" | utmp_unclassifiable)" = "2001:db8::1" ] \
    || { echo "  FAIL: utmp_unclassifiable must surface a non-v4 ut_addr"; f=1; }
  [ -z "$(printf '%s\n%s\n' "$UD_LOCAL" "$UD_FOREIGN" | utmp_unclassifiable)" ] \
    || { echo "  FAIL: utmp_unclassifiable must stay silent on v4/local rows"; f=1; }
  [ "$f" = 0 ] && echo "smoke-test: ok (classify:10 + derive verdicts:4 [FOREIGN/MESH/QUIET/dedup] + utmp_to_w:7 [local/foreign/mesh/dead-ignored/tmux-QUIET/v6-surfaced/v4-silent] assertions)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi

JSON=0; [ "${1:-}" = --json ] && JSON=1

command -v w >/dev/null 2>&1 || {
  [ "$JSON" = 1 ] && printf '{"ts":"%s","status":"UNREACHABLE","reason":"w not available"}\n' "$TS"
  echo "mesh-sessions: \`w\` not available — login-session sense unavailable (not faked)" >&2
  exit 2
}

raw="$(w -h -i 2>/dev/null)"; SRC=w
# `w` empty does NOT mean utmp is unreadable (see utmp_to_w above) — read the records directly
# before claiming blindness, and name the SOURCE in the reading so the two paths never look alike.
if [ -z "$raw" ]; then
  UTMP=/run/utmp; [ -r "$UTMP" ] || UTMP=/var/run/utmp
  ud=""; command -v utmpdump >/dev/null 2>&1 && ud="$(utmpdump "$UTMP" 2>/dev/null)"
  if [ -n "$ud" ]; then
    bad="$(printf '%s\n' "$ud" | utmp_unclassifiable)"
    if [ -n "$bad" ]; then
      # a source we cannot classify is a BLIND spot, not a QUIET — refuse rather than under-report
      bad_one="$(printf '%s' "$bad" | head -1)"
      [ "$JSON" = 1 ] && printf '{"ts":"%s","status":"UNREACHABLE","reason":"utmp holds a non-IPv4 source (%s) this tool cannot classify"}\n' "$TS" "$bad_one"
      echo "mesh-sessions: utmp holds a non-IPv4 source ($bad_one) — cannot classify, not faking QUIET" >&2
      exit 2
    fi
    raw="$(printf '%s\n' "$ud" | utmp_to_w)"; SRC=utmpdump
  elif [ -n "$(who 2>/dev/null)" ]; then
    # utmp IS readable (who enumerates it) but we have no numeric sources — blind, never QUIET
    [ "$JSON" = 1 ] && printf '{"ts":"%s","status":"UNREACHABLE","reason":"w empty and utmpdump absent, but who() enumerates utmp — sources unknown"}\n' "$TS"
    echo "mesh-sessions: \`w\` empty and utmpdump absent, but utmp IS readable (who lists sessions) — sources unknown, not faking QUIET" >&2
    exit 2
  else
    [ "$JSON" = 1 ] && printf '{"ts":"%s","status":"UNREACHABLE","reason":"utmp unreadable (w, utmpdump and who all empty)"}\n' "$TS"
    echo "mesh-sessions: utmp unreadable (w, utmpdump and who all empty) — not faking QUIET" >&2
    exit 2
  fi
fi

res="$(printf '%s' "$raw" | derive)"
verdict="${res%%|*}"; detail="${res#*|}"

if [ "$JSON" = 1 ]; then
  # re-extract the source lists for structured output
  ips="$(printf '%s' "$raw" | awk '{print $3}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)"
  mesh_j=""; foreign_j=""
  while IFS= read -r ip; do [ -n "$ip" ] || continue
    if [ "$(classify_src "$ip")" = FOREIGN ]; then foreign_j="$foreign_j\"$ip\","; else mesh_j="$mesh_j\"$ip\","; fi
  done <<EOF
$ips
EOF
  printf '{"ts":"%s","status":"OK","verdict":"%s","source":"%s","mesh":[%s],"foreign":[%s]}\n' \
    "$TS" "$verdict" "$SRC" "${mesh_j%,}" "${foreign_j%,}"
else
  printf 'sessions=%s — %s [src=%s]\n' "$verdict" "$detail" "$SRC"
fi
