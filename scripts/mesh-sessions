#!/usr/bin/env bash
# mesh-sessions — LOGIN-SESSION sense: who holds a live session on THIS node right now, and from
# WHERE. A signal the mesh did not perceive before: the existing senses cover the environment + the
# node's metabolism (load/psi/net/power/thermal), but nothing senses *attended-ness* — that a human
# or peer is actively logged in, and whether the source is an internal mesh peer or an unexpected
# EXTERNAL login. An SSH session from a public IP we don't recognise is a real, actionable signal.
#
# Source: utmp via `w -h -i` (numeric source IPs — no DNS, fast, always local). For every session
# whose FROM field is a dotted IP (a REMOTE login; local console/tty/seat show `-`), classify the
# source:
#   MESH    — Tailscale CGNAT (100.64.0.0/10) or RFC1918 LAN (10/8, 172.16/12, 192.168/16): a peer
#   FOREIGN — any public source IP: an external login (escalate)
#
# Verdict vocab (stable — text consumers grep these):
#   QUIET    — no remote sessions (local console / tmux only)
#   MESH     — >=1 remote session, ALL from internal peers
#   FOREIGN  — >=1 remote session from a PUBLIC source IP (security-relevant)
#
# HONEST-degraded contract: exit 2 if `w` is missing or utmp is unreadable (empty output). NEVER
# fake QUIET on a tool failure — a silent all-clear would hide a foreign login. "No remote sessions"
# (a real QUIET) and "cannot read sessions" (exit 2) are distinct.
#
#   mesh-sessions          one-line verdict + sources
#   mesh-sessions --json   machine-readable
#   mesh-sessions --test   pure parse/classify smoke (no utmp dependency)
#
# orphan-ok: on-demand login/security probe — NOT auto-wired (a foreign-login alarm reflex is an
#   operator-reviewed decision, not something to self-wire silently).
#
# Exit: 0 ok (QUIET/MESH/FOREIGN) · 2 `w` missing or utmp unreadable (honest-degraded, never faked).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Classify a dotted source IP → MESH | FOREIGN. Pure function (testable, no I/O).
classify_src() {  # <ip>
  case "$1" in
    # Tailscale CGNAT 100.64.0.0/10 → second octet 64..127
    100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) echo MESH ;;
    # RFC1918 private
    10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)         echo MESH ;;
    *)                                                            echo FOREIGN ;;
  esac
}

# Derive the verdict from `w -h -i`-style lines on stdin. Prints "VERDICT|detail". Pure (testable).
derive() {
  local raw ips ip cls nmesh=0 nforeign=0 mesh_list="" foreign_list=""
  raw="$(cat)"
  # FROM is field 3; keep only dotted-quad IPs (remote sessions). Local tty/seat show '-'.
  ips="$(printf '%s\n' "$raw" | awk '{print $3}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)"
  while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    cls="$(classify_src "$ip")"
    if [ "$cls" = FOREIGN ]; then nforeign=$((nforeign+1)); foreign_list="$foreign_list $ip"
    else                          nmesh=$((nmesh+1));      mesh_list="$mesh_list $ip"; fi
  done <<EOF
$ips
EOF
  if   [ "$nforeign" -gt 0 ]; then echo "FOREIGN|${nforeign} external src(${foreign_list# }) + ${nmesh} mesh peer(s)"
  elif [ "$nmesh"    -gt 0 ]; then echo "MESH|${nmesh} remote mesh session(s):${mesh_list}"
  else                             echo "QUIET|no remote sessions (local console/tmux only)"
  fi
}

if [ "${1:-}" = --test ]; then
  f=0
  # classify_src boundaries
  [ "$(classify_src 100.107.198.111)" = MESH ]   || { echo "  FAIL: 100.107.x (tailscale) → MESH"; f=1; }
  [ "$(classify_src 100.64.0.1)"      = MESH ]   || { echo "  FAIL: 100.64 low-CGNAT → MESH"; f=1; }
  [ "$(classify_src 100.127.255.1)"   = MESH ]   || { echo "  FAIL: 100.127 high-CGNAT → MESH"; f=1; }
  [ "$(classify_src 192.168.8.9)"     = MESH ]   || { echo "  FAIL: 192.168 RFC1918 → MESH"; f=1; }
  [ "$(classify_src 10.0.0.5)"        = MESH ]   || { echo "  FAIL: 10/8 RFC1918 → MESH"; f=1; }
  [ "$(classify_src 172.16.0.1)"      = MESH ]   || { echo "  FAIL: 172.16 RFC1918 → MESH"; f=1; }
  # FALSIFIABLE: public + just-outside-CGNAT must be FOREIGN (else a real external login reads safe)
  [ "$(classify_src 8.8.8.8)"         = FOREIGN ]|| { echo "  FAIL: 8.8.8.8 public → FOREIGN"; f=1; }
  [ "$(classify_src 100.63.0.1)"      = FOREIGN ]|| { echo "  FAIL: 100.63 (below CGNAT) → FOREIGN"; f=1; }
  [ "$(classify_src 100.128.0.1)"     = FOREIGN ]|| { echo "  FAIL: 100.128 (above CGNAT) → FOREIGN"; f=1; }
  [ "$(classify_src 172.32.0.1)"      = FOREIGN ]|| { echo "  FAIL: 172.32 (above RFC1918) → FOREIGN"; f=1; }
  # derive: a foreign source dominates the verdict
  printf 'u pts/0 8.8.8.8 x\nu pts/1 100.107.198.111 y\n' | derive | grep -q '^FOREIGN|' || { echo "  FAIL: foreign src → FOREIGN verdict"; f=1; }
  # derive: only internal peers → MESH
  printf 'u pts/0 100.107.198.111 x\nu pts/1 192.168.8.9 y\n' | derive | grep -q '^MESH|2 ' || { echo "  FAIL: 2 mesh peers → MESH(2)"; f=1; }
  # derive: local-only (no IP in FROM) → QUIET
  printf 'u tty2 - x\nu seat0 - y\n' | derive | grep -q '^QUIET|' || { echo "  FAIL: local-only → QUIET"; f=1; }
  # derive: dedup same source IP (2 pts from one peer = 1 peer)
  printf 'u pts/0 100.107.198.111 a\nu pts/1 100.107.198.111 b\n' | derive | grep -q '^MESH|1 ' || { echo "  FAIL: dup src not deduped to 1"; f=1; }
  [ "$f" = 0 ] && echo "smoke-test: ok (classify:10 + derive verdicts:4 [FOREIGN/MESH/QUIET/dedup] assertions)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi

JSON=0; [ "${1:-}" = --json ] && JSON=1

command -v w >/dev/null 2>&1 || {
  [ "$JSON" = 1 ] && printf '{"ts":"%s","status":"UNREACHABLE","reason":"w not available"}\n' "$TS"
  echo "mesh-sessions: \`w\` not available — login-session sense unavailable (not faked)" >&2
  exit 2
}

raw="$(w -h -i 2>/dev/null)"
# utmp always lists at least the running session; truly empty output = utmp unreadable → honest exit 2.
[ -n "$raw" ] || {
  [ "$JSON" = 1 ] && printf '{"ts":"%s","status":"UNREACHABLE","reason":"utmp unreadable (w -h -i empty)"}\n' "$TS"
  echo "mesh-sessions: utmp unreadable (w -h -i empty) — not faking QUIET" >&2
  exit 2
}

res="$(printf '%s' "$raw" | derive)"
verdict="${res%%|*}"; detail="${res#*|}"

if [ "$JSON" = 1 ]; then
  # re-extract the source lists for structured output
  ips="$(printf '%s' "$raw" | awk '{print $3}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)"
  mesh_j=""; foreign_j=""
  while IFS= read -r ip; do [ -n "$ip" ] || continue
    if [ "$(classify_src "$ip")" = FOREIGN ]; then foreign_j="$foreign_j\"$ip\","; else mesh_j="$mesh_j\"$ip\","; fi
  done <<EOF
$ips
EOF
  printf '{"ts":"%s","status":"OK","verdict":"%s","mesh":[%s],"foreign":[%s]}\n' \
    "$TS" "$verdict" "${mesh_j%,}" "${foreign_j%,}"
else
  printf 'sessions=%s — %s\n' "$verdict" "$detail"
fi
