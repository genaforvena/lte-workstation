#!/usr/bin/env bash
# mesh-voice-say — synthesize TEXT in the OPERATOR'S cloned voice to a 24kHz wav.
#
# The one canonical clone-synth primitive: every speech organ (mesh-note3-say room voice,
# mesh-voice-tx Telegram voice) delegates here so the mesh always speaks in the operator's own
# voice. Talks to the warm mesh-voice-clone-daemon over a Unix socket (~0.7-1.7s/line, GPU).
#
#   mesh-voice-say "текст" /tmp/out.wav      synth to out.wav (24kHz mono), rc=0 on success
#   mesh-voice-say "текст"                   synth to a fresh /tmp wav, print its path on stdout
#   mesh-voice-say --test                    LIVE gate: real synth via the daemon yields a valid wav
#
# rc!=0 (+ a LOUD stderr warning) means the clone is unavailable — callers MUST fall back to piper
# rather than go silent, but the fallback is a fault to fix, never the quiet normal (the mesh's
# voice is the operator's voice; a silent slide back to ruslan is exactly the silent-fallback trap).
set -uo pipefail

SOCK="${MESH_CLONE_SOCK:-$HOME/.mesh/voice-clone/xtts.sock}"

usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }

# talk to the daemon: $1=out_path $2=text ; prints daemon reply line ; rc from OK/ERR
# rc CONTRACT (callers branch their fallback hint on it — gated by --test):
#   0 ok · 3 empty text · 4 daemon replied ERR · 5 daemon UNREACHABLE (socket absent/refused)
#   6 other exception · 7 synth TIMEOUT (daemon reachable but no reply within MESH_CLONE_TIMEOUT,
#     default 180s — the cap a long text can legitimately outrun; NOT a daemon-down signal)
_call(){
  local out="$1" text="$2"
  OUT="$out" TEXT="$text" SOCK="$SOCK" TMO="${MESH_CLONE_TIMEOUT:-180}" python3 - <<'PY'
import os, socket, sys
sock = os.environ["SOCK"]; out = os.environ["OUT"]; text = os.environ["TEXT"]
tmo = float(os.environ["TMO"])
text = " ".join(text.split())  # collapse newlines/tabs — they frame the protocol
if not text:
    print("ERR\tempty text"); sys.exit(3)
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(tmo)
    s.connect(sock)
    s.sendall((out + "\t" + text + "\n").encode())
    buf = b""
    while b"\n" not in buf:
        c = s.recv(65536)
        if not c:
            break
        buf += c
    line = buf.split(b"\n", 1)[0].decode("utf-8", "replace")
    print(line)
    sys.exit(0 if line.startswith("OK\t") else 4)
except socket.timeout:
    print("ERR\tsynth timeout after %.0fs on %d chars — daemon busy/slow, NOT down; chunk the text or raise MESH_CLONE_TIMEOUT" % (tmo, len(text))); sys.exit(7)
except (FileNotFoundError, ConnectionRefusedError):
    print("ERR\tdaemon unreachable (socket " + sock + ")"); sys.exit(5)
except Exception as e:
    print("ERR\t" + str(e)); sys.exit(6)
PY
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then usage; exit 0; fi

if [ "${1:-}" = "--test" ]; then
  # rc-CONTRACT fixtures (node-independent — run BEFORE the daemon-absent n/a gate, or they are
  # dead code on daemonless nodes, the prereq-guard-above-the-test trap): callers branch their
  # fallback HINT on our rc (5=unreachable→"fix the service", 7=timeout→"chunk/raise cap"), so the
  # contract itself must be gated or the hints rot back into one canned misdiagnosis (the 07-18
  # voice-tx-canned-clone-down bug: healthy-but-slow daemon reported as a dead service, twice).
  _td="$(mktemp -d "${TMPDIR:-/tmp}"/mvs-test-XXXXXX)"
  ( SOCK="$_td/absent.sock"; _call "$_td/o.wav" "тест" ) >/dev/null 2>&1; _rc=$?
  [ "$_rc" = 5 ] || { rm -rf "$_td"; echo "smoke-test: FAIL (rc-contract: unreachable socket gave rc=$_rc, want 5)"; exit 1; }
  # a daemon that ACCEPTS but never replies (busy/slow on long text) → rc=7 TIMEOUT, distinct
  # from 5: a healthy-but-slow daemon must never be reportable as "service down".
  python3 - "$_td/slow.sock" <<'PY' &
import socket, sys, time
s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(1); time.sleep(8)
PY
  _srvpid=$!
  for _i in $(seq 30); do [ -S "$_td/slow.sock" ] && break; sleep 0.1; done
  _rep="$(SOCK="$_td/slow.sock" MESH_CLONE_TIMEOUT=1; _call "$_td/o.wav" "тест" 2>/dev/null)"; _rc=$?
  kill "$_srvpid" 2>/dev/null; wait "$_srvpid" 2>/dev/null
  rm -rf "$_td"
  [ "$_rc" = 7 ] || { echo "smoke-test: FAIL (rc-contract: no-reply daemon gave rc=$_rc, want 7=timeout)"; exit 1; }
  case "$_rep" in *timeout*) : ;; *) echo "smoke-test: FAIL (rc-contract: timeout reply lacks 'timeout': $_rep)"; exit 1;; esac
  echo "rc-contract: ok (unreachable=5, no-reply=7 timeout)"
  # LIVE gate: the daemon must actually synthesize the operator's voice into a valid wav. A daemon
  # that is down is n/a here (exit 2 — honest "organ absent", not a defect), so --test can run under
  # mesh-doctor without demanding the service be up; a daemon that is UP but produces junk FAILs.
  if [ ! -S "$SOCK" ]; then echo "smoke-test: n/a (clone daemon not running — socket $SOCK absent)"; exit 2; fi
  tw="$(mktemp "${TMPDIR:-/tmp}"/mesh-voice-say-test-XXXXXX.wav)"
  rep="$(_call "$tw" "Проверка голоса." )"; rc=$?
  if [ "$rc" != 0 ]; then rm -f "$tw"; echo "smoke-test: FAIL (daemon up but synth failed: $rep)"; exit 1; fi
  sz=$(stat -c%s "$tw" 2>/dev/null || echo 0)
  rm -f "$tw"
  if [ "$sz" -gt 20000 ]; then echo "smoke-test: ok (live clone synth -> ${sz}B wav)"; exit 0; fi
  echo "smoke-test: FAIL (synth produced ${sz}B wav, expected a real clip)"; exit 1
fi

TEXT="${1:?usage: mesh-voice-say <text> [out.wav]}"
OUT="${2:-}"
[ -n "$OUT" ] || OUT="$(mktemp "${TMPDIR:-/tmp}"/mesh-voice-XXXXXX.wav)"

rep="$(_call "$OUT" "$TEXT")"; rc=$?
if [ "$rc" = 0 ]; then
  [ -n "${2:-}" ] || printf '%s\n' "$OUT"   # no explicit out → emit the path we synthesized to
  exit 0
fi
case "$rc" in
  7) echo "mesh-voice-say: SYNTH TIMEOUT — daemon reachable, text outran the cap; chunk it or raise MESH_CLONE_TIMEOUT (rc=$rc: ${rep#ERR	})" >&2;;
  *) echo "mesh-voice-say: CLONE UNAVAILABLE — falling back to piper is the caller's job (rc=$rc: ${rep#ERR	})" >&2;;
esac
exit "$rc"
