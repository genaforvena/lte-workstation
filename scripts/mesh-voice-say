#!/usr/bin/env bash
# mesh-voice-say — synthesize TEXT in the OPERATOR'S cloned voice to a 24kHz wav.
#
# The one canonical clone-synth primitive: every speech organ (mesh-note3-say room voice,
# mesh-voice-tx Telegram voice) delegates here so the mesh always speaks in the operator's own
# voice. Talks to the warm mesh-voice-clone-daemon over a Unix socket (~0.7-1.7s/line, GPU).
#
#   mesh-voice-say "текст" /tmp/out.wav      synth to out.wav (24kHz mono), rc=0 on success
#   mesh-voice-say "текст"                   synth to a fresh /tmp wav, print its path on stdout
#   mesh-voice-say --test                    LIVE gate: real synth via the daemon yields a valid wav
#
# rc!=0 (+ a LOUD stderr warning) means the clone is unavailable — callers MUST fall back to piper
# rather than go silent, but the fallback is a fault to fix, never the quiet normal (the mesh's
# voice is the operator's voice; a silent slide back to ruslan is exactly the silent-fallback trap).
set -uo pipefail

SOCK="${MESH_CLONE_SOCK:-$HOME/.mesh/voice-clone/xtts.sock}"

usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }

# talk to the daemon: $1=out_path $2=text ; prints daemon reply line ; rc from OK/ERR
_call(){
  local out="$1" text="$2"
  OUT="$out" TEXT="$text" SOCK="$SOCK" python3 - <<'PY'
import os, socket, sys
sock = os.environ["SOCK"]; out = os.environ["OUT"]; text = os.environ["TEXT"]
text = " ".join(text.split())  # collapse newlines/tabs — they frame the protocol
if not text:
    print("ERR\tempty text"); sys.exit(3)
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(180)
    s.connect(sock)
    s.sendall((out + "\t" + text + "\n").encode())
    buf = b""
    while b"\n" not in buf:
        c = s.recv(65536)
        if not c:
            break
        buf += c
    line = buf.split(b"\n", 1)[0].decode("utf-8", "replace")
    print(line)
    sys.exit(0 if line.startswith("OK\t") else 4)
except (FileNotFoundError, ConnectionRefusedError):
    print("ERR\tdaemon unreachable (socket " + sock + ")"); sys.exit(5)
except Exception as e:
    print("ERR\t" + str(e)); sys.exit(6)
PY
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then usage; exit 0; fi

if [ "${1:-}" = "--test" ]; then
  # LIVE gate: the daemon must actually synthesize the operator's voice into a valid wav. A daemon
  # that is down is n/a here (exit 2 — honest "organ absent", not a defect), so --test can run under
  # mesh-doctor without demanding the service be up; a daemon that is UP but produces junk FAILs.
  if [ ! -S "$SOCK" ]; then echo "smoke-test: n/a (clone daemon not running — socket $SOCK absent)"; exit 2; fi
  tw="$(mktemp /tmp/mesh-voice-say-test-XXXXXX.wav)"
  rep="$(_call "$tw" "Проверка голоса." )"; rc=$?
  if [ "$rc" != 0 ]; then rm -f "$tw"; echo "smoke-test: FAIL (daemon up but synth failed: $rep)"; exit 1; fi
  sz=$(stat -c%s "$tw" 2>/dev/null || echo 0)
  rm -f "$tw"
  if [ "$sz" -gt 20000 ]; then echo "smoke-test: ok (live clone synth -> ${sz}B wav)"; exit 0; fi
  echo "smoke-test: FAIL (synth produced ${sz}B wav, expected a real clip)"; exit 1
fi

TEXT="${1:?usage: mesh-voice-say <text> [out.wav]}"
OUT="${2:-}"
[ -n "$OUT" ] || OUT="$(mktemp /tmp/mesh-voice-XXXXXX.wav)"

rep="$(_call "$OUT" "$TEXT")"; rc=$?
if [ "$rc" = 0 ]; then
  [ -n "${2:-}" ] || printf '%s\n' "$OUT"   # no explicit out → emit the path we synthesized to
  exit 0
fi
echo "mesh-voice-say: CLONE UNAVAILABLE — falling back to piper is the caller's job (rc=$rc: ${rep#ERR	})" >&2
exit "$rc"
