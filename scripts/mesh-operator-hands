#!/usr/bin/env bash
# orphan-ok: on-demand metric + dash reader — deliberately unscheduled (posting a daily
#            trend line would be board noise; the number is pulled, not pushed)
# mesh-operator-hands — HOW OFTEN THE MESH REACHES THE PHYSICAL WORLD THROUGH THE OPERATOR.
#
# Operator ask (2026-08-16, TG): "было бы круто актуаторы Илья использовать поменьше, а
# остальные побольше" — i.e. he wants the mesh to stop using HIM as an actuator. You cannot
# reduce what you do not measure, so this is the meter for that axis.
#
# TWO CLASSES, AND THEY ARE NOT THE SAME DEBT (the operator drew this line himself):
#   HANDS  the lane needs a PHYSICAL act only he can perform — plug a cable, press a key in
#          BIOS, tap a phone, drive to the machine, read a mailbox only he can open.
#          THIS is the axis to reduce: every HANDS event is the mesh borrowing a body.
#   WORD   the lane needs a DECISION the agent is not entitled to make — a ruling, consent,
#          a spend approval. He has PARTLY LIFTED this one ("вы просто сообщите, что вы
#          решили и сделали"), so a falling WORD count is expected and is NOT the same win.
#   ?      a dependency IS asserted but the class is not determinable from the line. Kept as
#          its own bucket and never folded into either — a fusion that guesses is a fabricated
#          reading (CLAUDE.md honest-fusion rule).
#
# NO NEW JOURNAL (explicit in the ask: "НЕ строить ещё один ручной журнал"). The board
# (~/.mesh/chat.log) already carries every one of these statements — "ждём оператора",
# "упёрся в руки оператора", "awaiting operator ruling". This tool is a pure DERIVATION over
# it; it writes nothing and it asks no mind to log anything new.
#
#   mesh-operator-hands              report: counts, rate/day, open strands, trend
#   mesh-operator-hands --list       every hit: ts · window · class · the matched phrase (auditable)
#   mesh-operator-hands --json       machine-readable
#   mesh-operator-hands --dash       one compact block for a data pane
#   mesh-operator-hands --days N     window (default 14)
#   mesh-operator-hands --test       gate (exit 2 = no board on this node)
#
# WHAT THE NUMBER IS, EXACTLY — read this before quoting it:
#   UNIT is a STRAND, not a line. One block restated six times is ONE event; counting lines
#   would measure the board's chattiness, not the operator's load. Strand key = the `task:<slug>`
#   tag, else the `[kind] <slug>:` lead, else <window>+the matched phrase.
#   DERIVATIVE POSTERS ARE EXCLUDED — roll-call/digest/dispatch lines MIRROR another window's
#   state (they restate one standing block every 5h; vpn's single kz-front block appears in 6+
#   roll-call lines). Only the ORIGINATING window's statement is counted.
#   IT IS A LOWER BOUND. Detection is anchored on an explicit operator REFERENT (операт*/
#   operator/Илья) next to a dependency predicate. A block phrased without naming him ("нужен
#   физический доступ") is invisible here — attributable is the price of not fabricating.
#   THE CLASS IS DERIVED FROM PROSE and prose is not a verdict. Every classification is
#   auditable via --list, the error is MEASURED against docs/fixtures/operator-hands-labels.tsv,
#   and the report prints that agreement rate beside the counts. A mind may override the
#   heuristic on its own line with an explicit `op-dep: hands` / `op-dep: word` tag — that is a
#   field on a line the mind was posting anyway, not a second journal.
#
# ENV: MESH_CHAT_LOG (default ~/.mesh/chat.log) · MESH_OPHANDS_FIXTURE (default the docs path)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
CHAT_LOG="${MESH_CHAT_LOG:-$MESH/chat.log}"
GENOME="${MESH_GENOME:-$HOME/lte-workstation}"
FIXTURE="${MESH_OPHANDS_FIXTURE:-$GENOME/docs/fixtures/operator-hands-labels.tsv}"
[ -f "$FIXTURE" ] || FIXTURE="$HOME/.mesh/fixtures/operator-hands-labels.tsv"

DAYS=14
MODE=report
while [ $# -gt 0 ]; do
  case "$1" in
    --list) MODE=list;; --json) MODE=json;; --dash) MODE=dash;; --report) MODE=report;;
    --test) MODE=test;;
    --days) DAYS="${2:-14}"; shift;;
    -h|--help) sed -n '2,60p' "$0"; exit 0;;
    *) echo "usage: mesh-operator-hands [--list|--json|--dash|--days N|--test]" >&2; exit 2;;
  esac; shift
done

engine() {
python3 - "$1" "$2" "$3" "$4" <<'PY'
import sys, re, json, os
from datetime import datetime, timezone, timedelta
from collections import Counter, OrderedDict

mode, log, days, fixture = sys.argv[1], sys.argv[2], float(sys.argv[3]), sys.argv[4]

LINE = re.compile(r'^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\s+(\S+)\s+::\s+(.*)$')

# ---- factor 1+2 fused: an ANCHORED dependency phrase whose object IS the operator.
# A bare proximity window does not work here and was measured not working: over this board it
# admitted "commits unpushed pending" and "оператор задал пол компенсации 400k на руки" (a
# salary idiom) because a lexicon over a 400-char body scores collisions, not grammar.
# Each pattern carries the class it DETERMINES ('H'/'W'), or '?' when only the dependency is
# established and the class must be read from the surrounding clause.
W = r'(?:[\w\-]+\s+){0,3}'
PATS = [
 ('?', r'жд[уёе]\w*\s+'+W+r'операт\w+'),
 ('?', r'ожида\w*\s+'+W+r'операт\w+'),
 ('H', r'уп[её]р\w*\s+в\s+'+W+r'(?:руки\s+)?операт\w+'),
 ('H', r'упира\w*\s+в\s+'+W+r'(?:руки\s+)?операт\w+'),
 ('?', r'(?:нужен|нужна|нужны|нужно)\s+'+W+r'операт\w+'),
 ('?', r'операт\w+\s+'+W+r'(?:нужен|нужна|нужны|нужно)'),
 ('H', r'(?:руки|рук|руках|руками)\s+операт\w+'),
 ('H', r'операт\w+\s+'+W+r'физическ\w+'),
 ('W', r'(?:решени\w*|решению|слов[оа]|разрешени\w*|согласи\w*|согласован\w*|добро|'
       r'подтвержден\w*|подтверждени\w*|санкци\w*|отмашк\w*)\s+'+W+r'операт\w+'),
 ('W', r'операт\w+\s+(?:долж\w+|реша\w+|решит|скажет|подтвердит|разрешит|одобрит)'),
 ('?', r'только\s+операт\w+'),
 ('?', r'(?:waiting|awaiting)\s+(?:on\s+|for\s+)?(?:the\s+)?'+W+r'operator\b'),
 ('?', r'block\w*\s+(?:on|by)\s+(?:the\s+)?'+W+r'operator\b'),
 # \b(?!ed|ing) — "operator handed this to the mesh" and "operator called the lane repetitive"
 # are the operator ACTING, not the mesh waiting on him. Without the guard both scored.
 ('H', r"operator'?s?\s+(?:tap|hands|hand|finger|presence)\b(?!ed|ing)"),
 ('W', r"operator'?s?\s+(?:go|call|ruling|approval|reply|answer|decision|word|permission|"
       r"consent|sign-?off|verdict|say-?so)\b(?!ed|ing)"),
 ('?', r"operator'?s?\s+(?:resend|input|action)\b"),
 ('?', r'needs?\s+(?:the\s+)?'+W+r'operator\b'),
 ('?', r'requires?\s+(?:the\s+)?'+W+r'operator\b'),
 ('?', r'only\s+(?:the\s+)?operator\b'),
 ('?', r'operator[- ]only\b'),
 ('?', r'operator\s+(?:must|has\s+to|needs\s+to)\b'),
]
PATS = [(c, re.compile(p, re.I)) for c, p in PATS]

HANDS_LEX = re.compile(
    r'\bруки\b|\bруках\b|\bруками\b|физическ\w*|воткн\w*|перевоткн\w*|переткн\w*|нажа\w*|нажм\w*|'
    r'тапн\w*|\bтап\w*|съезд\w*|приед\w*|рядом\b|вручную\b|кабел\w*|розетк\w*|BIOS\b|CMOS\b|UEFI\b|'
    r'SMS|смс|продикт\w*|снималк\w*|сфотограф\w*|скрин\w*|'
    r'\bhands?\b|physical\w*|\bplug\b|unplug|\breseat\b|\bpress\b|\btap\b|by\s+hand|power[- ]?cycle',
    re.I)
WORD_LEX = re.compile(
    r'разреш\w*|согласова\w*|одобр\w*|решени\w*|решит\b|\bдобро\b|санкци\w*|подтверд\w*|отмашк\w*|'
    r'ruling\b|approv\w*|consent\w*|sign-?off|decision\b|permission\b|verdict\b|go-?ahead|say-?so',
    re.I)

# explicit override a mind may put on its own line — authoritative over the heuristic
TAG = re.compile(r'\bop-dep:\s*(hands|word)\b', re.I)

# DERIVATIVE POSTERS — mirrors, not originators (see header). Excluding them is what makes the
# unit an EVENT: without it vpn's one standing kz-front block counts 6+ times off roll-call alone.
DERIV_WHO  = re.compile(r'^(roll-call|mind-control|watchdog|situation|dispatch|reflex)@')
DERIV_BODY = re.compile(r'^\[(dispatch|escalate[^\]]*|digest)\]|^\[\w+\]\s+roll-call\b')
# this tool's OWN strand: the task that commissioned it quotes every trigger phrase verbatim,
# so counting it would be the grep-matches-its-own-source trap wearing a board hat.
SELF = 'operator-hands-counter'

# the lead terminator must NOT include a bare hyphen: the slug alphabet contains hyphens, so a
# non-greedy match stops at the FIRST one and 'revive-has-no-link-layer-actuator' keys as
# 'revive-has' — two lines of one strand then land in two episodes. Terminator is ':' or a
# SPACED dash, which is how the board actually writes a lead.
LEAD_END  = r'(?:\s*:|\s+[—–-]\s)'
SLUG_LEAD = re.compile(r'^\[[\w:-]+\]\s+([a-z0-9][a-z0-9-]{6,})' + LEAD_END)
TASK_TAG  = re.compile(r'\btask:([a-z0-9][a-z0-9-]{4,})')
DONE_LEAD = re.compile(r'^\[done\]\s+([a-z0-9][a-z0-9-]{6,})' + LEAD_END)

def parse_ts(s):
    return datetime.strptime(s, '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)

def read(path):
    try:
        raw = open(path, 'rb').read().decode('utf-8', 'replace')
    except FileNotFoundError:
        return None
    out = []
    for ln in raw.splitlines():
        m = LINE.match(ln)
        if m:
            out.append(m.groups())
    return out

def classify(body):
    """-> (class, [matched phrases]) or (None, []) if no dependency asserted."""
    t = TAG.search(body)
    ms = []
    for c, p in PATS:
        for mm in p.finditer(body):
            ms.append((c, mm.start(), mm.end(), mm.group(0)))
    if not ms:
        return (None, [], None)
    if t:
        return ('H' if t.group(1).lower() == 'hands' else 'W', [x[3] for x in ms], 'tag')
    cls = None
    for c, s, e, g in ms:
        if c in ('H', 'W'):
            cls = c if cls in (None, c) else 'B'
    if cls is None:
        s = min(x[1] for x in ms); e = max(x[2] for x in ms)
        ctx = body[max(0, s-90):min(len(body), e+90)]
        h = bool(HANDS_LEX.search(ctx)); w = bool(WORD_LEX.search(ctx))
        cls = 'H' if h and not w else 'W' if w and not h else 'B' if h and w else 'U'
    return (cls, [x[3] for x in ms], 'derived')

NOT_A_STRAND = {'mesh-home', 'phaedra', 'operator', 'roll-call', 'mesh-tools'}

def strand_of(who, body, phrases):
    # LEAD FIRST, task: tag second. `task:` is scanned over the whole body, so any incidental
    # mention deep in prose hijacks the key — measured: a `[done] operator-action: …` line keyed
    # as 'mesh-home' off a mid-body `task:mesh-home`. The lead is anchored at ^ and cannot be
    # poisoned that way (same trap the board's own close-key discipline carries).
    m = SLUG_LEAD.match(body)
    # '[fyi] witness: …' leads with the WINDOW, not a strand — keying on it merges every
    # unrelated post that window ever made into one 100h phantom episode.
    if m and m.group(1) != who and m.group(1) not in NOT_A_STRAND:
        return m.group(1)
    m = TASK_TAG.search(body)
    if m and m.group(1) != who and m.group(1) not in NOT_A_STRAND:
        return m.group(1)
    ph = re.sub(r'\s+', ' ', (phrases[0] if phrases else '')).lower()[:40]
    return f'{who}/{ph}'

def scan(rows, since=None):
    hits, dones = [], {}
    for ts, who, body in rows:
        w = who.split('@')[0]
        d = DONE_LEAD.match(body)
        if d:
            dones.setdefault(d.group(1), ts)
        if DERIV_WHO.match(who) or DERIV_BODY.match(body):
            continue
        if SELF in body:
            continue
        cls, phrases, prov = classify(body)
        if cls is None:
            continue
        t = parse_ts(ts)
        if since and t < since:
            continue
        hits.append(dict(ts=ts, t=t, who=w, cls=cls, phrases=phrases, prov=prov,
                         strand=strand_of(w, body, phrases), body=body))
    return hits, dones

RANK = {'H': 3, 'B': 3, 'W': 2, 'U': 1}

def episodes(hits, dones, now):
    # key on the STRAND ALONE, never (strand, class): one block that two windows describe
    # differently ("решении оператора" / "Ждём ответа оператора") is ONE debt, and keying by
    # class split it into two. Class precedence H > W > ? — if ANY line on the strand says it
    # needs his hands, the strand needs his hands, and HANDS is the axis being reduced, so the
    # tie goes to the UNFLATTERING reading.
    eps = OrderedDict()
    for h in hits:
        k = h['strand']
        e = eps.get(k)
        if e is None:
            eps[k] = e = dict(strand=k, cls=h['cls'], who=h['who'], first=h['ts'], last=h['ts'],
                              n=0, phrase=h['phrases'][0] if h['phrases'] else '',
                              prov=h['prov'], classes=set())
        e['classes'].add(h['cls'])
        if RANK.get(h['cls'], 0) > RANK.get(e['cls'], 0):
            e['cls'] = h['cls']
            e['phrase'] = h['phrases'][0] if h['phrases'] else e['phrase']
        e['n'] += 1
        e['last'] = h['ts']
        if h['prov'] == 'tag':
            e['prov'] = 'tag'
    for e in eps.values():
        d = dones.get(e['strand'])
        if '/' in e['strand']:
            e['status'] = 'n/a'          # no slug -> closure is not resolvable; never claim open
        elif d and d >= e['last']:
            # >= not >: the closing [done] is USUALLY the very line that mentions the dependency
            # in the past tense ("[done] alc897-…: … the operator's hand did the reseat"). With
            # a strict > that strand read as STILL STANDING ON HIM forever.
            e['status'] = 'closed'
        else:
            e['status'] = 'open'
        e['age_h'] = round((now - parse_ts(e['last'])).total_seconds() / 3600.0, 1)
        e['classes'] = sorted(e['classes'])
    return list(eps.values())

def fixture_agreement(path):
    """Run the SAME classifier over hand-labelled lines. Returns (agree, total, [misses])."""
    try:
        raw = open(path, 'rb').read().decode('utf-8', 'replace')
    except FileNotFoundError:
        return (None, None, [])
    agree = total = 0
    misses = []
    for ln in raw.splitlines():
        if not ln.strip() or ln.lstrip().startswith('#'):
            continue
        parts = ln.split('\t')
        if len(parts) < 3:
            continue
        label, kind, body = parts[0].strip(), parts[1].strip(), '\t'.join(parts[2:])
        total += 1
        if kind == 'deriv':
            got = 'SKIP' if (DERIV_BODY.match(body) or SELF in body) else (classify(body)[0] or 'NONE')
        else:
            cls, _, _ = classify(body)
            got = cls or 'NONE'
        if got == label:
            agree += 1
        else:
            misses.append((label, got, body[:110]))
    return (agree, total, misses)

NAME = {'H': 'HANDS', 'W': 'WORD', 'U': '?', 'B': 'both'}

rows = read(log)
if rows is None:
    print(f'mesh-operator-hands: no board at {log} (exit 2 = n/a on this node)', file=sys.stderr)
    sys.exit(2)
now = datetime.now(timezone.utc)
since = now - timedelta(days=days)
hits, dones = scan(rows, since)
eps = episodes(hits, dones, now)
agree, ftotal, misses = fixture_agreement(fixture)

cnt = Counter(e['cls'] for e in eps)
lines_cnt = Counter(h['cls'] for h in hits)
span = max(0.01, min(days, (now - parse_ts(rows[0][0])).total_seconds()/86400.0))

if mode == 'json':
    print(json.dumps(dict(
        now=now.strftime('%Y-%m-%dT%H:%M:%SZ'), days=days, board=log, board_lines=len(rows),
        span_days=round(span, 2),
        episodes={NAME[k]: v for k, v in cnt.items()},
        lines={NAME[k]: v for k, v in lines_cnt.items()},
        per_day={NAME[k]: round(v/span, 2) for k, v in cnt.items()},
        open=[dict(cls=NAME[e['cls']], strand=e['strand'], who=e['who'], age_h=e['age_h'],
                   phrase=e['phrase']) for e in eps if e['status'] == 'open'],
        provenance=dict(tagged=sum(1 for e in eps if e['prov'] == 'tag'),
                        derived=sum(1 for e in eps if e['prov'] != 'tag')),
        fixture=dict(path=fixture, agree=agree, total=ftotal)), ensure_ascii=False))
    sys.exit(0)

if mode == 'list':
    for h in sorted(hits, key=lambda x: x['ts']):
        print(f"{h['ts']}  {h['who']:<9} {NAME[h['cls']]:<6} {h['prov']:<7} "
              f"{h['strand'][:38]:<38} « {h['phrases'][0][:52]} »")
    print(f"-- {len(hits)} hit lines -> {len(eps)} strand-episodes over {span:.1f}d")
    sys.exit(0)

if mode == 'dash':
    h, w, u = cnt.get('H', 0), cnt.get('W', 0), cnt.get('U', 0) + cnt.get('B', 0)
    openh = sum(1 for e in eps if e['status'] == 'open' and e['cls'] == 'H')
    print(f"op-actuator {span:.0f}d: HANDS {h} ({h/span:.1f}/d, {openh} open) · "
          f"WORD {w} ({w/span:.1f}/d) · ? {u}")
    for e in sorted([e for e in eps if e['status'] == 'open'], key=lambda x: -x['age_h'])[:4]:
        print(f"  {NAME[e['cls']]:<5} {e['age_h']:>5.1f}h {e['who']:<8} {e['strand'][:34]}")
    sys.exit(0)

if mode == 'test':
    fails = []
    # LEG 1 — fixture: the classifier must reproduce hand labels (incl. NEGATIVES that must
    # score NONE, and derivative lines that must be SKIPped). Fixture lines are redacted
    # re-phrasings of real board lines: the board is gitignored and carries the operator's
    # personal data, so it can never itself be committed as a fixture.
    if agree is None:
        # No fixture and no genome on this node -> the gate can assert nothing about the
        # classifier. That is honest n/a (exit 2), not a pass and not a red; mesh-doctor runs
        # every --test hourly and a planted sensor node must not go red for lacking the repo.
        # If the genome IS here the fixture was deleted, and that is a real failure.
        if not os.path.isdir(os.path.join(os.environ.get('HOME', ''), 'lte-workstation', 'docs')):
            print(f'  fixture absent and no genome on this node -> n/a ({fixture})')
            sys.exit(2)
        fails.append(f'fixture missing though the genome is here: {fixture}')
    else:
        lab = Counter()
        for ln in open(fixture, 'rb').read().decode('utf-8', 'replace').splitlines():
            if ln.strip() and not ln.lstrip().startswith('#') and '\t' in ln:
                lab[ln.split('\t')[0].strip()] += 1
        # a fixture with no negatives cannot fail on over-matching; assert it has teeth
        for need in ('H', 'W', 'NONE', 'SKIP'):
            if lab.get(need, 0) < 2:
                fails.append(f'fixture too weak: only {lab.get(need,0)} {need} rows (need >=2)')
        if misses:
            for l, g, b in misses[:6]:
                fails.append(f'fixture miss: want {l} got {g} :: {b}')
    # LEG 2 — live path: the same pipeline must run over the REAL board and produce a
    # well-formed result. A fixture-only gate cannot cover the live read (docs: a
    # fixture-driven gate cannot cover the live path).
    if len(rows) < 10:
        fails.append(f'live board unusable: {len(rows)} parsed lines in {log}')
    else:
        print(f'  live board: {len(rows)} lines -> {len(hits)} hits -> {len(eps)} episodes')
    # LEG 3 — the derivative exclusion must actually bite on the live board: if roll-call
    # lines were counted, ONE standing block would inflate into an event per digest.
    dcount = sum(1 for ts, who, body in rows if DERIV_WHO.match(who) or DERIV_BODY.match(body))
    if dcount == 0:
        fails.append('derivative exclusion never fired on the live board (dead filter?)')
    else:
        print(f'  derivative lines excluded: {dcount}')
    # LEG 4 — self-exclusion: the commissioning task quotes every trigger phrase.
    selfl = [b for ts, who, b in rows if SELF in b]
    if selfl and any(h for h in hits if SELF in h['body']):
        fails.append('self-strand leaked into the count')
    print(f'  fixture: {agree}/{ftotal} agree')
    if fails:
        for f in fails:
            print(f'FAIL {f}')
        sys.exit(1)
    print('mesh-operator-hands --test: ok')
    sys.exit(0)

# ---------------- report ----------------
h, w, u, b = cnt.get('H', 0), cnt.get('W', 0), cnt.get('U', 0), cnt.get('B', 0)
tot = h + w + u + b
print(f'mesh-operator-hands — the mesh reaching the world through the operator')
print(f'  window {span:.1f}d (asked {days:.0f}d) · board {os.path.basename(log)} {len(rows)} lines '
      f'· {len(hits)} hit lines -> {tot} strand-episodes')
print()
print(f'  HANDS  {h:>3} episodes  {h/span:>4.1f}/day   <- the axis to REDUCE (a body borrowed)')
print(f'  WORD   {w:>3} episodes  {w/span:>4.1f}/day      (partly lifted by the operator himself)')
if b: print(f'  both   {b:>3} episodes  {b/span:>4.1f}/day      (line asserts both)')
print(f'  ?      {u:>3} episodes  {u/span:>4.1f}/day      (dependency asserted, class undeterminable)')
print(f'  ----------------------------------')
print(f'  total  {tot:>3} episodes  {tot/span:>4.1f}/day')
print()
op = sorted([e for e in eps if e['status'] == 'open'], key=lambda x: -x['age_h'])
# NOT "still blocked on him" — that is not derivable here and this tool does not own it.
# A strand routinely closes with `[done] X: asked the operator on TG` while HIS answer is
# still outstanding; the board records the ask being sent, not the reply arriving.
# mesh-promises is the ledger for what is still owed — this is a pointer, not a verdict.
if op:
    print(f'  NO CLOSING [done] YET ({len(op)} strand(s)) — strand-open, not proof he is still '
          f'blocking; mesh-promises --balance owns that:')
    for e in op[:12]:
        print(f'    {NAME[e["cls"]]:<5} {e["age_h"]:>6.1f}h  {e["who"]:<9} {e["strand"][:34]:<34} '
              f'« {e["phrase"][:38]} »')
else:
    print('  NO CLOSING [done] YET: none')
print()
byday = {}
for e in eps:
    byday.setdefault(e['first'][:10], Counter())[e['cls']] += 1
print('  per-day episodes (HANDS/WORD/?):')
for d in sorted(byday):
    c = byday[d]
    print(f'    {d}  {c.get("H",0)}/{c.get("W",0)}/{c.get("U",0)+c.get("B",0)}')
print()
tg = sum(1 for e in eps if e['prov'] == 'tag')
print(f'  provenance: {tg} tagged (op-dep:) · {tot-tg} derived from prose')
if agree is not None:
    print(f'  classifier agreement on the hand-labelled fixture: {agree}/{ftotal} '
          f'({100.0*agree/max(1,ftotal):.0f}%) — {os.path.basename(fixture)}')
else:
    print(f'  fixture MISSING ({fixture}) — the derived class carries no measured error here')
print('  the count is a LOWER BOUND: only blocks that NAME the operator are attributable.')
print('  audit every classification with --list.')
PY
}

case "$MODE" in
  test)
    echo "mesh-operator-hands --test"
    engine test "$CHAT_LOG" "$DAYS" "$FIXTURE"; exit $?;;
  *)
    engine "$MODE" "$CHAT_LOG" "$DAYS" "$FIXTURE"; exit $?;;
esac
