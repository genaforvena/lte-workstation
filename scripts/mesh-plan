#!/usr/bin/env bash
# mesh-plan — the PLANNER's autonomous pass. Two tiers, deliberately:
#   • MECHANICAL (cheap, often): run mesh-verify, stamp ~/.mesh/PLAN.md, alert on any ⚠. $0.
#   • INTELLIGENT (occasional): if we've been on reflexes alone too long, have a MIND audit the
#     reflexes — don't trust them blindly, but don't over-think either ("с умом буквально").
# The intelligent pass uses a FREE engine (gemini/opencode) when available; else it FLAGS that an
# intel audit is due (a claude runs it deliberately). Reflexes are cheap and fallible; intelligence
# checks them on a cadence, not constantly.
#
#   mesh-plan            mechanical pass (+ trigger intel audit if due)
#   mesh-plan --intel    force an intelligent audit now
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; PLAN="$MESH/PLAN.md"; STAMP="$MESH/.last-intel-audit"
[ "${1:-}" = --test ] && {
  for x in date grep sed tail cut cat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  command -v mesh-verify >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-verify)"; exit 1; }
  [ -f "$PLAN" ] && [ -r "$PLAN" ] && [ -w "$PLAN" ] || { echo "smoke-test: FAIL (PLAN.md unreadable/unwritable)"; exit 1; }
  [ -d "$MESH" ] && [ -w "$MESH" ] || { echo "smoke-test: FAIL (no writable ~/.mesh)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
}
[ "${1:-}" = --help ] || [ "${1:-}" = -h ] && { echo "usage: mesh-plan [--intel]"; exit 0; }
INTEL_EVERY="${MESH_INTEL_EVERY:-86400}"   # seconds on reflexes before a mind should re-audit (24h)
now=$(date -u +%s); ts(){ date -u +%Y-%m-%dT%H:%MZ; }

# --- the free mind, best-effort (real work on free pools; never blocks the mechanical floor) ---
# gemini is "ready" only if it can run headless — else `gemini -p` HANGS on a browser-OAuth flow
# for the full timeout (verified 2026-06-10). Skip it instantly when unauthed.
gemini_ready(){ [ -n "${GEMINI_API_KEY:-}" ] || [ -s "$HOME/.gemini/oauth_creds.json" ]; }
ask_mind(){ # stdin=context prompt -> stdout=answer (or empty). timeout-guarded.
  local p; p="$(cat)"
  if command -v gemini >/dev/null 2>&1 && gemini_ready; then timeout 150 gemini -p "$p" 2>/dev/null && return 0; fi
  if command -v opencode >/dev/null 2>&1; then timeout 120 opencode run "$p" 2>/dev/null && return 0; fi
  return 1
}

intel_audit(){
  local ctx ans
  ctx="$(
    echo "You audit a self-running node-mesh that mostly runs on \$0 reflexes. Do NOT trust the"
    echo "green checks blindly — reflexes can look fine while silently failing (e.g. a poller with"
    echo "no offset, a voice loop hallucinating, a stale beacon). Be terse and concrete (<=8 lines,"
    echo "с умом, не растекайся). Answer: are the reflexes actually doing their job, or just green?"
    echo "What is silently broken or unverified? What single thing should change next?"
    echo; echo "=== mesh-verify ==="; mesh-verify 2>/dev/null
    echo; echo "=== recent revive.log ==="; tail -8 "$MESH/revive.log" 2>/dev/null
    echo "=== recent restore.log ==="; tail -8 "$MESH/restore.log" 2>/dev/null
    echo "=== recent chat ==="; tail -15 "$MESH/chat.log" 2>/dev/null | cut -c1-120
    echo "=== PLAN blocked/in-progress ==="; sed -n '/BLOCKED/,/Global directions/p' "$PLAN" 2>/dev/null
  )"
  echo "[mesh-plan] running intelligent reflex audit (free mind)…" >&2
  if ans="$(printf '%s' "$ctx" | ask_mind)" && [ -n "$ans" ]; then
    { echo; echo "## 🧠 intel audit — $(ts) (free mind, reflexes checked by intelligence)"; echo "$ans" | sed 's/^/> /'; } >> "$PLAN"
    echo "$now" > "$STAMP"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="planner@$(hostname)" mesh-chat "[plan] intel audit done → PLAN.md updated" >/dev/null 2>&1
    echo "intel audit appended to PLAN.md"
  else
    { echo; echo "## ⏳ intel audit DUE — $(ts) (no free mind reachable; a claude should run \`mesh-plan --intel\`)"; } >> "$PLAN"
    echo "intel audit DUE but no free mind answered — flagged in PLAN.md"
  fi
}

[ "${1:-}" = "--intel" ] && { intel_audit; exit 0; }

# --- mechanical pass ---
verdict="$(mesh-verify 2>/dev/null)"
ok=$(grep -q '✅' <<<"$verdict" && echo yes || echo no)
# refresh the timestamp line in PLAN.md
if grep -q '^Last pass:' "$PLAN" 2>/dev/null; then
  sed -i "s|^Last pass:.*|Last pass: $(ts) (mesh-plan mechanical; reboot-survival $([ "$ok" = yes ] && echo ✅ || echo ⚠)).|" "$PLAN"
fi
echo "$verdict" | tail -2
# alert the operator only on a real regression
if [ "$ok" != yes ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="planner@$(hostname)" mesh-chat "[gap] reboot-survival NOT green — see mesh-verify" >/dev/null 2>&1
  command -v mesh-tg   >/dev/null 2>&1 && mesh-tg "⚠ planner: нода(ы) не reboot-safe — $(grep VERDICT <<<"$verdict")" >/dev/null 2>&1
fi
# intel cadence: if we've been on reflexes longer than INTEL_EVERY, let a mind check them
last=$(cat "$STAMP" 2>/dev/null || echo 0)
if [ $(( now - last )) -ge "$INTEL_EVERY" ]; then intel_audit; else
  echo "intel audit not due (last $(( (now-last)/3600 ))h ago, every $(( INTEL_EVERY/3600 ))h)"
fi
