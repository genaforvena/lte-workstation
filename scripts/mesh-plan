#!/usr/bin/env bash
# mesh-plan — the PLANNER's autonomous pass. Two tiers, deliberately:
#   • MECHANICAL (cheap, often): run mesh-verify, stamp ~/.mesh/PLAN.md, alert on any ⚠. $0.
#   • INTELLIGENT (occasional): if we've been on reflexes alone too long, have a MIND audit the
#     reflexes — don't trust them blindly, but don't over-think either ("с умом буквально").
# The intelligent pass uses a FREE engine (gemini/opencode) when available; else it FLAGS that an
# intel audit is due (a claude runs it deliberately). Reflexes are cheap and fallible; intelligence
# checks them on a cadence, not constantly.
#
#   mesh-plan            mechanical pass (+ trigger intel audit if due)
#   mesh-plan --intel    force an intelligent audit now
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; PLAN="$MESH/PLAN.md"; STAMP="$MESH/.last-intel-audit"

# NOVELTY-VS-CITATION GATE (LITERATURE, live review 2026-07-09: enactivism & 4E cognition — angle
# a known CRITIQUE of this area; concept the mesh did NOT embody: `grep -rl 'representation.hungry\|
# Grayot' scripts/` -> 0 hits before this). Grayot, "Representation hunger: Reformulating the
# 'problem-domain' of truly complex cognition" (Mind & Language 2025, doi:10.1111/mila.12553)
# revisits the classic representation-hungry-cognition debate: planning and reasoning about ABSENT,
# not-currently-perceived states (Clark & Toribio 1994's paradigm case) is exactly what pure
# sensorimotor/enactive coupling struggles to explain on its own — this codebase's own doctrine
# (docs/distributed-embodied-agent.md: "the agent doesn't need understanding... it needs to couple
# inputs to outputs") is a real instance of that stance. Grayot's reformulation doesn't require
# INTERNAL symbols; it grounds representation-hungry cognition in EXTERNAL VEHICLES made load-
# bearing by ENCULTURATION (a stable shared notation multiple readers interpret the same way) — and
# poses a sharp diagnostic: does a vehicle's content carry genuinely NOVEL production, or is it mere
# RETRIEVAL/CITATION of content already produced? intel_audit() below is exactly such a vehicle —
# PLAN.md is the mesh's own enculturated notation for reasoning about its ABSENT future state ("what
# should change next") — yet until now it appended every cadence-triggered audit unconditionally,
# with no signal distinguishing a fresh diagnosis from the free mind re-noticing the same standing
# issue from a near-identical prompt (mesh-verify + a chat tail rarely shifts much tick to tick).
# That's the identical citation-vs-production conflation mesh-novelty already fixed for the BOARD's
# marginal-vs-conditional surprisal (--conditional, 2026-06-20) — never applied to this tool's own
# append stream. Fix below: diff the new audit block against the PRIOR intel-audit block already in
# PLAN.md; a near-repeat is tagged [REPEAT] in its own header (still appended, for the audit trail —
# discarding it would lose a possible confirmation) and skips the chat ping, so the vehicle's growth
# tracks genuine production, not restatement.
intel_prev_block(){ # -> the last '## <emoji> intel audit ...' block already in PLAN.md (may be empty)
  awk '
    /^## (🧠|⏳) intel audit/ { blk=""; capturing=1 }
    capturing && /^## / && !/^## (🧠|⏳) intel audit/ { capturing=0 }
    capturing { blk = blk $0 "\n" }
    END { printf "%s", blk }
  ' "$PLAN" 2>/dev/null
}
intel_word_overlap(){ # $1 $2 (free text) -> 0.00-1.00 Jaccard-ish overlap of lowercased word sets
  local wa wb na nb common
  wa="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '\n' | sort -u)"
  wb="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '\n' | sort -u)"
  na=$(printf '%s\n' "$wa" | grep -c .); nb=$(printf '%s\n' "$wb" | grep -c .)
  if [ "$na" -eq 0 ] || [ "$nb" -eq 0 ]; then echo 0.00; return; fi
  common=$(comm -12 <(printf '%s\n' "$wa") <(printf '%s\n' "$wb") | grep -c .)
  awk -v c="$common" -v na="$na" -v nb="$nb" 'BEGIN{ m=(na<nb)?na:nb; printf "%.2f", (m>0)?c/m:0 }'
}

[ "${1:-}" = --test ] && {
  for x in date grep sed tail cut cat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  command -v mesh-verify >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-verify)"; exit 1; }
  [ -f "$PLAN" ] && [ -r "$PLAN" ] && [ -w "$PLAN" ] || { echo "smoke-test: FAIL (PLAN.md unreadable/unwritable)"; exit 1; }
  [ -d "$MESH" ] && [ -w "$MESH" ] || { echo "smoke-test: FAIL (no writable ~/.mesh)"; exit 1; }
  # NOVELTY-VS-CITATION GATE: a near-identical answer must score high overlap, a genuinely
  # different one must score low — else [REPEAT] tagging would mis-fire either direction.
  r="$(intel_word_overlap 'wire a TS-state check into mesh-verify so mesh=DOWN alerts' \
                           'wire a TS-state check into mesh-verify so mesh down alerts')"
  awk -v r="$r" 'BEGIN{exit !(r>=0.6)}' || { echo "smoke-test: FAIL (overlap under-scored a near-repeat: $r)"; exit 1; }
  r="$(intel_word_overlap 'wire a TS-state check into mesh-verify' \
                           'camera FAIL needs a two-run debounce before it pages the operator')"
  awk -v r="$r" 'BEGIN{exit !(r<0.3)}' || { echo "smoke-test: FAIL (overlap over-scored an unrelated pair: $r)"; exit 1; }
  # intel_prev_block: must isolate the LAST audit block only, not the whole file, and stop at the
  # next '## ' section header (never bleed into unrelated PLAN.md prose below it).
  _pt="$(mktemp)"; cat > "$_pt" <<'EOF'
## some other section
noise
## 🧠 intel audit — 2026-01-01T00:00Z (free mind)
> first finding
## 🧠 intel audit — 2026-01-02T00:00Z (free mind)
> second finding: wire a TS-state check
## STANDING WATCH
unrelated trailer text
EOF
  _prev="$(PLAN="$_pt" intel_prev_block)"; rm -f "$_pt"
  case "$_prev" in
    *"second finding: wire a TS-state check"*) ;;
    *) echo "smoke-test: FAIL (intel_prev_block missed the last audit block, got: $_prev)"; exit 1 ;;
  esac
  case "$_prev" in *"first finding"*) echo "smoke-test: FAIL (intel_prev_block bled into an earlier audit block)"; exit 1 ;; esac
  case "$_prev" in *"unrelated trailer"*) echo "smoke-test: FAIL (intel_prev_block bled past the next '## ' header)"; exit 1 ;; esac
  echo "smoke-test: ok"
  exit 0
}
[ "${1:-}" = --help ] || [ "${1:-}" = -h ] && { echo "usage: mesh-plan [--intel]"; exit 0; }
INTEL_EVERY="${MESH_INTEL_EVERY:-86400}"   # seconds on reflexes before a mind should re-audit (24h)
now=$(date -u +%s); ts(){ date -u +%Y-%m-%dT%H:%MZ; }

# --- the free mind, best-effort (real work on free pools; never blocks the mechanical floor) ---
# gemini is "ready" only if it can run headless — else `gemini -p` HANGS on a browser-OAuth flow
# for the full timeout (verified 2026-06-10). Skip it instantly when unauthed.
gemini_ready(){ [ -n "${GEMINI_API_KEY:-}" ] || [ -s "$HOME/.gemini/oauth_creds.json" ]; }
ask_mind(){ # stdin=context prompt -> stdout=answer (or empty). timeout-guarded.
  local p; p="$(cat)"
  if command -v gemini >/dev/null 2>&1 && gemini_ready; then timeout 150 gemini -p "$p" 2>/dev/null && return 0; fi
  if command -v opencode >/dev/null 2>&1; then timeout 120 opencode run "$p" 2>/dev/null && return 0; fi
  # mesh-relay: Groq-backed brainless router — available on any node with ~/.mesh/groq.env.
  # Fallback so intel audits run on ds/phaedra which have neither gemini nor opencode.
  if command -v mesh-relay >/dev/null 2>&1; then printf '%s' "$p" | timeout 60 mesh-relay 2>/dev/null && return 0; fi
  return 1
}

intel_audit(){
  local ctx ans
  ctx="$(
    echo "You audit a self-running node-mesh that mostly runs on \$0 reflexes. Do NOT trust the"
    echo "green checks blindly — reflexes can look fine while silently failing (e.g. a poller with"
    echo "no offset, a voice loop hallucinating, a stale beacon). Be terse and concrete (<=8 lines,"
    echo "с умом, не растекайся). Answer: are the reflexes actually doing their job, or just green?"
    echo "What is silently broken or unverified? What single thing should change next?"
    echo; echo "=== mesh-verify ==="; mesh-verify 2>/dev/null
    echo; echo "=== recent revive.log ==="; tail -8 "$MESH/revive.log" 2>/dev/null
    echo "=== recent restore.log ==="; tail -8 "$MESH/restore.log" 2>/dev/null
    echo "=== recent chat ==="; tail -15 "$MESH/chat.log" 2>/dev/null | cut -c1-120
    echo "=== PLAN blocked/in-progress ==="; sed -n '/BLOCKED/,/Global directions/p' "$PLAN" 2>/dev/null
  )"
  echo "[mesh-plan] running intelligent reflex audit (free mind)…" >&2
  if ans="$(printf '%s' "$ctx" | ask_mind)" && [ -n "$ans" ]; then
    local prev overlap hdr
    prev="$(intel_prev_block)"
    hdr="## 🧠 intel audit — $(ts) (free mind, reflexes checked by intelligence)"
    if [ -n "$prev" ]; then
      overlap="$(intel_word_overlap "$ans" "$prev")"
      if awk -v r="$overlap" 'BEGIN{exit !(r>=0.6)}'; then
        hdr="## 🧠 intel audit — $(ts) (free mind) [REPEAT — ${overlap} overlap with the prior audit, likely re-noticing a standing issue]"
      fi
    fi
    { echo; echo "$hdr"; echo "$ans" | sed 's/^/> /'; } >> "$PLAN"
    echo "$now" > "$STAMP"
    case "$hdr" in
      *REPEAT*) echo "intel audit appended to PLAN.md (tagged REPEAT, chat ping skipped)" ;;
      *)
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="planner@$(hostname)" mesh-chat "[plan] intel audit done → PLAN.md updated" >/dev/null 2>&1
        echo "intel audit appended to PLAN.md"
        ;;
    esac
  else
    { echo; echo "## ⏳ intel audit DUE — $(ts) (no free mind reachable; a claude should run \`mesh-plan --intel\`)"; } >> "$PLAN"
    echo "intel audit DUE but no free mind answered — flagged in PLAN.md"
  fi
}

[ "${1:-}" = "--intel" ] && { intel_audit; exit 0; }

# --- mechanical pass ---
verdict="$(mesh-verify 2>/dev/null)"
ok=$(grep -q '✅' <<<"$verdict" && echo yes || echo no)
# refresh the timestamp line in PLAN.md
if grep -q '^Last pass:' "$PLAN" 2>/dev/null; then
  sed -i "s|^Last pass:.*|Last pass: $(ts) (mesh-plan mechanical; reboot-survival $([ "$ok" = yes ] && echo ✅ || echo ⚠)).|" "$PLAN"
fi
echo "$verdict" | tail -2
# alert the operator only on a real regression
if [ "$ok" != yes ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="planner@$(hostname)" mesh-chat "[gap] reboot-survival NOT green — see mesh-verify" >/dev/null 2>&1
  command -v mesh-tg   >/dev/null 2>&1 && mesh-tg "⚠ planner: нода(ы) не reboot-safe — $(grep VERDICT <<<"$verdict")" >/dev/null 2>&1
fi
# intel cadence: if we've been on reflexes longer than INTEL_EVERY, let a mind check them
last=$(cat "$STAMP" 2>/dev/null || echo 0)
if [ $(( now - last )) -ge "$INTEL_EVERY" ]; then intel_audit; else
  echo "intel audit not due (last $(( (now-last)/3600 ))h ago, every $(( INTEL_EVERY/3600 ))h)"
fi
