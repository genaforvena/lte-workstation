#!/usr/bin/env bash
# mesh-unstick — push through interactive prompts in any tmux pane.
# Scans all panes in a session and auto-answers common blocking prompts.
#
#   mesh-unstick [session]   default: hostname-named session
set -uo pipefail

# suppress mesh-chat when in test/quiet contexts
_chat(){ [ -z "${MESH_UNSTICK_QUIET:-}" ] && mesh-chat "UNSTICK $*" 2>/dev/null || true; }

[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  # ISOLATION (live incident 2026-07-14 on mesh-home): fixtures must NOT live on the node's default
  # tmux server. On a server holding nothing but fixtures, an inline kill-session ends the last
  # session and tmux exits — the append-only sensorium and every mind pane go with it. A per-invocation
  # TMUX_TMPDIR relocates the default socket for the fixture AND the recursive `"$0" "$_ts"` run below
  # (which does its own tmux calls). `unset TMUX` is LOAD-BEARING: from INSIDE a pane ($TMUX set —
  # doctor's smoke-sweep, or a mind running --test) tmux reads the socket path from $TMUX and ignores
  # TMUX_TMPDIR, so without it the fixture lands on the node's DEFAULT server and the teardown
  # kill-server takes the sensorium down (live incident 2026-07-14 23:00Z, 14-window session killed).
  # Hard-fail rather than run on the shared server.
  _us_td="$(mktemp -d 2>/dev/null)" || _us_td=""
  [ -n "$_us_td" ] || { echo "smoke-test: FAIL (mktemp -d failed — refusing to run tmux fixtures on the node's shared server)"; exit 1; }
  export TMUX_TMPDIR="$_us_td"
  unset TMUX
  _us_sock="$_us_td/tmux-$(id -u)/default"
  # Teardown on ANY exit incl. FAIL/SIGTERM. Guarded on OUR PRIVATE SOCKET FILE — never on
  # $TMUX_TMPDIR, which stays set even when tmux is talking to the default socket (that false guard
  # is what let kill-server reach the node's server). Socket path = observable; env var = claim.
  trap '[ -S "${_us_sock:-}" ] && tmux kill-server 2>/dev/null; rm -rf "$_us_td"' EXIT TERM INT
  # dry-run: create temp session with a stuck [y/n] prompt, verify unstick sends y
  # MESH_UNSTICK_QUIET suppresses board posts (test should not flood chat.log)
  _ts="test-unstick-$$"
  tmux new-session -d -s "$_ts" 'printf "Continue? [y/n]: "; read -r ans; echo "answer=$ans"; sleep 3' 2>/dev/null
  sleep 0.5
  # ISOLATION assert (two real observables): our private server exists (what the teardown is guarded
  # on), and the fixture is invisible on the node's default server. Falsify: drop the `unset TMUX`
  # and run from inside a pane → the fixture appears on the default socket → FAIL.
  [ -S "$_us_sock" ] || {
    echo "smoke-test: FAIL (no private tmux socket at $_us_sock — fixtures are NOT isolated)"; exit 1; }
  env -u TMUX_TMPDIR tmux has-session -t "$_ts" 2>/dev/null && {
    echo "smoke-test: FAIL (fixture session '$_ts' is visible on the node's DEFAULT tmux server — not isolated)"; exit 1; }
  MESH_UNSTICK_QUIET=1 "${BASH_SOURCE[0]}" "$_ts" 2>/dev/null
  sleep 0.5
  _out="$(tmux capture-pane -t "$_ts:0.0" -p 2>/dev/null)"
  tmux kill-session -t "$_ts" 2>/dev/null
  echo "$_out" | grep -q 'answer=y' || { echo "smoke-test: FAIL (did not send y to [y/n], got: $(echo "$_out" | grep answer))"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

SESSION="${1:-$(hostname)}"

unstick_pane() {
    local target="$1"
    local content last
    # Use only the visible pane area (no scrollback) — we want the CURRENT blocking state
    content=$(tmux capture-pane -t "$target" -p 2>/dev/null || true)
    # last non-empty line — what the pane is currently waiting on
    last=$(printf '%s' "$content" | grep -v '^\s*$' | tail -1)

    if echo "$last" | grep -qiE "Allow execution of|\[y/n\]|Continue\?|Do you want to continue"; then
        _chat "[$target]: auto-y for confirmation."
        tmux send-keys -t "$target" "y" Enter; return
    fi
    if echo "$last" | grep -q "Are you sure you want to continue connecting"; then
        _chat "[$target]: accepted SSH host key."
        tmux send-keys -t "$target" "yes" Enter; return
    fi
    if echo "$last" | grep -qiE "Press \[?Enter\]? to continue|Hit Enter to"; then
        _chat "[$target]: pressed Enter to continue."
        tmux send-keys -t "$target" Enter; return
    fi
    if echo "$last" | grep -qE "\[sudo\] password for"; then
        _chat "[$target]: sudo prompt — pressing Enter."
        tmux send-keys -t "$target" Enter
    fi
}

# -s = all panes in THIS session only. (Bare -a overrides -t and scans EVERY
# session on the server — which made `mesh-unstick <session>` and the --test
# harness auto-answer prompts in unrelated panes, incl. real mind windows, and
# spam the board with test-unstick auto-y lines.)
tmux list-panes -s -t "$SESSION" -F "#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null \
    | while read -r p; do unstick_pane "$p"; done
