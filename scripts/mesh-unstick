#!/usr/bin/env bash
# mesh-unstick — push through interactive prompts in any tmux pane.
# Scans all panes in a session and auto-answers common blocking prompts.
#
#   mesh-unstick [session]   default: hostname-named session
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  # dry-run: create temp session with a stuck [y/n] prompt, verify unstick sends y
  # MESH_UNSTICK_QUIET suppresses board posts (test should not flood chat.log)
  _ts="test-unstick-$$"
  tmux new-session -d -s "$_ts" 'printf "Continue? [y/n]: "; read -r ans; echo "answer=$ans"; sleep 3' 2>/dev/null
  sleep 0.5
  MESH_UNSTICK_QUIET=1 "${BASH_SOURCE[0]}" "$_ts" 2>/dev/null
  sleep 0.5
  _out="$(tmux capture-pane -t "$_ts:0.0" -p 2>/dev/null)"
  tmux kill-session -t "$_ts" 2>/dev/null
  echo "$_out" | grep -q 'answer=y' || { echo "smoke-test: FAIL (did not send y to [y/n], got: $(echo "$_out" | grep answer))"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

SESSION="${1:-$(hostname)}"

unstick_pane() {
    local target="$1"
    local content last
    # Use only the visible pane area (no scrollback) — we want the CURRENT blocking state
    content=$(tmux capture-pane -t "$target" -p 2>/dev/null || true)
    # last non-empty line — what the pane is currently waiting on
    last=$(printf '%s' "$content" | grep -v '^\s*$' | tail -1)

    if echo "$last" | grep -q 'Allow execution of'; then
        [ "${MESH_UNSTICK_QUIET:-0}" = 1 ] || mesh-chat "UNSTICK [$target]: Gemini permission accepted (Enter)." 2>/dev/null || true
        tmux send-keys -t "$target" Enter; return
    fi
    if echo "$last" | grep -qiE "\[y/n\]|Continue\?|Do you want to continue"; then
        [ "${MESH_UNSTICK_QUIET:-0}" = 1 ] || mesh-chat "UNSTICK [$target]: auto-y for confirmation." 2>/dev/null || true
        tmux send-keys -t "$target" "y" Enter; return
    fi
    if echo "$last" | grep -q 'Allow execution of'; then
        [ -z "${MESH_UNSTICK_QUIET:-}" ] && mesh-chat "UNSTICK [$target]: Gemini permission accepted (Enter)." 2>/dev/null || true
        tmux send-keys -t "$target" Enter; return
    fi
    if echo "$last" | grep -qiE "\[y/n\]|Continue\?|Do you want to continue"; then
        [ -z "${MESH_UNSTICK_QUIET:-}" ] && mesh-chat "UNSTICK [$target]: auto-y for confirmation." 2>/dev/null || true
        tmux send-keys -t "$target" "y" Enter; return
    fi
    if echo "$last" | grep -q "Are you sure you want to continue connecting"; then
        [ -z "${MESH_UNSTICK_QUIET:-}" ] && mesh-chat "UNSTICK [$target]: accepted SSH host key." 2>/dev/null || true
        tmux send-keys -t "$target" "yes" Enter; return
    fi
    if echo "$last" | grep -qiE "Press \[?Enter\]? to continue|Hit Enter to"; then
        [ -z "${MESH_UNSTICK_QUIET:-}" ] && mesh-chat "UNSTICK [$target]: pressed Enter to continue." 2>/dev/null || true
        tmux send-keys -t "$target" Enter; return
    fi
    if echo "$last" | grep -qE "\[sudo\] password for"; then
        [ -z "${MESH_UNSTICK_QUIET:-}" ] && mesh-chat "UNSTICK [$target]: sudo prompt — pressing Enter." 2>/dev/null || true
        tmux send-keys -t "$target" Enter
    fi
}

# -s = all panes in THIS session only. (Bare -a overrides -t and scans EVERY
# session on the server — which made `mesh-unstick <session>` and the --test
# harness auto-answer prompts in unrelated panes, incl. real mind windows, and
# spam the board with test-unstick auto-y lines.)
tmux list-panes -s -t "$SESSION" -F "#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null \
    | while read -r p; do unstick_pane "$p"; done
