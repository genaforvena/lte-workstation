#!/usr/bin/env bash
# mesh-hh-drive — control the persistent logged-in hh.ru browser page.
#
# The engine is mesh-hh-drive.py (playwright); this wrapper finds the venv that has playwright,
# because the mesh's system python does not and never will (numpy-only-in-venvs rule, same shape).
#
#   mesh-hh-drive --start            launch the daemon if it is not already up (idempotent)
#   mesh-hh-drive --send '<verb ...>'  queue one command
#   mesh-hh-drive --run  '<multi-line>'  queue many (one verb per line, via stdin or arg)
#   mesh-hh-drive --peek [N]         tail the driver log
#   mesh-hh-drive --wait <marker> [S]  block until <marker> appears in the log (default 180s)
#   mesh-hh-drive --shot <name>       screenshot -> ~/.mesh/job/shots/<name>.png, echo the path
#   mesh-hh-drive --alive            exit 0 if the daemon is up
#   mesh-hh-drive --stop             ask the daemon to quit (saves the login state first)
#   mesh-hh-drive --test
#
# The login lives in ~/.mesh/browser/hh-state.json (0600). The daemon exits after HH_IDLE_LIMIT
# seconds of no commands (45 min default) and is safe to relaunch — the state file survives.
set -uo pipefail
export LC_ALL=C.UTF-8

MESH="$HOME/.mesh"
CMD="$MESH/job/hh-cmd.txt"
LOG="$MESH/job/hh-drive.log"
PIDF="$MESH/job/hh-drive.pid"
ENGINE=""
for c in "$(dirname "$(readlink -f "$0")")/mesh-hh-drive.py" "$HOME/.local/bin/mesh-hh-drive.py"; do
  [ -f "$c" ] && { ENGINE="$c"; break; }
done
mkdir -p "$MESH/job" "$MESH/browser"

# The interpreter must be the one that can `import playwright`; asking is the only honest test,
# a venv path that exists is not a venv that has it.
find_py() {
  local p
  for p in "$HOME/.venv-browser/bin/python3" "$HOME/.venv-ai/bin/python3" \
           "$HOME/.venv-tg/bin/python3" /usr/bin/python3; do
    [ -x "$p" ] || continue
    "$p" -c 'import playwright' 2>/dev/null && { echo "$p"; return 0; }
  done
  return 1
}

alive() { [ -s "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; }

start() {
  alive && { echo "already up (pid $(cat "$PIDF"))"; return 0; }
  local py; py=$(find_py) || { echo "no python with playwright" >&2; return 2; }
  [ -n "$ENGINE" ] || { echo "engine mesh-hh-drive.py not found" >&2; return 2; }
  local mark; mark=$(( $(stat -c%s "$LOG" 2>/dev/null || echo 0) + 1 ))
  # The engine writes the log itself; sending its stdout there too duplicated every line, which
  # made --peek read like the driver was running each command twice.
  nohup "$py" "$ENGINE" >/dev/null 2>>"$LOG" &
  echo $! > "$PIDF"
  # The daemon prints [ready] and then dumps ~80 lines of controls, so a narrow tail window slides
  # past the marker before the loop looks — the first version of this check reported failure on a
  # driver that was already serving. Watch the byte offset the log had at launch instead.
  local i
  for i in $(seq 1 40); do
    tail -c +"$mark" "$LOG" 2>/dev/null | grep -q '^\[ready\]' && {
      echo "up (pid $(cat "$PIDF"))"; return 0; }
    sleep 2
  done
  echo "started (pid $(cat "$PIDF")) but no [ready] within 80s" >&2; return 1
}

send() { printf '%s\n' "$1" >> "$CMD"; }

wait_for() {
  local marker="$1" secs="${2:-180}" i
  for i in $(seq 1 "$secs"); do
    grep -qF -- "$marker" "$LOG" 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

# hh answers some automated navigations with "Проверка браузера перед переходом на hh.ru" — an
# interstitial that renders an EMPTY document to every selector. A caller that reads through it
# sees zero applications, zero search results, and no error: the most dangerous shape there is,
# because "nothing found" and "we were blocked" are the same bytes. Every navigation goes through
# here, so a blocked read is exit 2 (honest n/a) and never an empty answer.
nav() {
  local url="$1" tries="${2:-4}" i mark
  for i in $(seq 1 "$tries"); do
    mark=$(stat -c%s "$LOG" 2>/dev/null || echo 0)
    send "goto $url"
    sleep 8
    send "js document.body.innerText.slice(0,60).replace(/\n/g,' ')"
    sleep 4
    if tail -c +"$((mark+1))" "$LOG" | grep -q 'Проверка браузера'; then
      sleep $(( i * 10 ))
      continue
    fi
    return 0
  done
  echo "blocked: hh browser-check interstitial after $tries attempts" >&2
  return 2
}

case "${1:---peek}" in
  --start) start ;;
  --goto)  nav "$2" "${3:-4}" ;;
  --alive) alive && { echo up; exit 0; } || { echo down; exit 1; } ;;
  --send)  send "$2" ;;
  --run)   if [ $# -ge 2 ]; then printf '%s\n' "$2" >> "$CMD"; else cat >> "$CMD"; fi ;;
  --peek)  tail -n "${2:-40}" "$LOG" ;;
  --wait)  wait_for "$2" "${3:-180}" ;;
  --shot)
    send "shot $2"
    wait_for "$MESH/job/shots/$2.png" 90 && echo "$MESH/job/shots/$2.png" ;;
  --stop)  send quit; sleep 3; rm -f "$PIDF" ;;
  --test)
    rc=0
    [ -n "$ENGINE" ] || { echo "FAIL: engine missing"; exit 1; }
    "$(command -v python3)" -c "import ast,sys; ast.parse(open('$ENGINE').read())" \
      || { echo "FAIL: engine does not parse"; exit 1; }
    if ! find_py >/dev/null; then
      echo "n/a: no python with playwright on this node"; exit 2
    fi
    if ! alive; then
      echo "n/a: driver not running (start it with --start; nothing to assert against)"; exit 2
    fi
    # The real claim: the live page answers. A pidfile is not a page — assert a fresh readback,
    # never the previous run's line (a marker unique to THIS run is the only honest gate).
    m="selftest-$$-$(date +%s)"
    send "shot $m"
    if wait_for "$MESH/job/shots/$m.png" 60 && [ -s "$MESH/job/shots/$m.png" ]; then
      echo "ok: live page answered, $(stat -c%s "$MESH/job/shots/$m.png") byte screenshot"
      rm -f "$MESH/job/shots/$m.png"
    else
      echo "FAIL: driver up but the page did not answer a fresh screenshot"; rc=1
    fi
    exit $rc ;;
  *) sed -n '2,20p' "$0"; exit 1 ;;
esac
