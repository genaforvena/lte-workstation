#!/usr/bin/env bash
# mesh-hh-drive — control the persistent logged-in hh.ru browser page.
#
# The engine is mesh-hh-drive.py (playwright); this wrapper finds the venv that has playwright,
# because the mesh's system python does not and never will (numpy-only-in-venvs rule, same shape).
#
#   mesh-hh-drive --start            launch the daemon if it is not already up (idempotent)
#   mesh-hh-drive --send '<verb ...>'  queue one command
#   mesh-hh-drive --run  '<multi-line>'  queue many (one verb per line, via stdin or arg)
#   mesh-hh-drive --peek [N]         tail the driver log
#   mesh-hh-drive --wait <marker> [S]  block until <marker> appears in the log (default 180s)
#   mesh-hh-drive --shot <name>       screenshot -> ~/.mesh/job/shots/<name>.png, echo the path
#   mesh-hh-drive --alive            exit 0 if the daemon is up
#   mesh-hh-drive --stop             ask the daemon to quit (saves the login state first)
#   mesh-hh-drive --test
#
#   HH_PROFILE=<name> picks the instance (own cookies/log/pidfile); default `hh`.
#   HH_HOME=<url> is the page the daemon opens on start (default https://hh.ru/).
#
# The login lives in ~/.mesh/browser/hh-state.json (0600). The daemon exits after HH_IDLE_LIMIT
# seconds of no commands (45 min default) and is safe to relaunch — the state file survives.
set -uo pipefail
export LC_ALL=C.UTF-8

MESH="$HOME/.mesh"
# HH_PROFILE names the instance — a second driver (webmail, an ATS) gets its own cookies, command
# file, log and pidfile, so one login can never leak into another site's session. Default `hh`
# reproduces the original paths byte-for-byte.
PROFILE="${HH_PROFILE:-hh}"
export HH_PROFILE
CMD="$MESH/job/$PROFILE-cmd.txt"
LOG="$MESH/job/$PROFILE-drive.log"
PIDF="$MESH/job/$PROFILE-drive.pid"
ENGINE=""
for c in "$(dirname "$(readlink -f "$0")")/mesh-hh-drive.py" "$HOME/.local/bin/mesh-hh-drive.py"; do
  [ -f "$c" ] && { ENGINE="$c"; break; }
done
mkdir -p "$MESH/job" "$MESH/browser"

# The interpreter must be the one that can `import playwright`; asking is the only honest test,
# a venv path that exists is not a venv that has it.
find_py() {
  local p
  for p in "$HOME/.venv-browser/bin/python3" "$HOME/.venv-ai/bin/python3" \
           "$HOME/.venv-tg/bin/python3" /usr/bin/python3; do
    [ -x "$p" ] || continue
    "$p" -c 'import playwright' 2>/dev/null && { echo "$p"; return 0; }
  done
  return 1
}

alive() { [ -s "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; }

# THE PIDFILE IS NOT THE PROCESS CENSUS. Every --start overwrites $PIDF, so a daemon whose pid is
# no longer written there is invisible to alive() and lives forever — and it keeps READING THE SAME
# $CMD FILE. Measured 2026-08-20: three engines ran at once against one hh login; each consumed the
# same queued verbs from its own page, so `click response` fired in one browser while `type letter`
# went to another that was still on the previous vacancy — four applications filed with NO cover
# letter, and every failure named the wrong cause ("модалка hh?"). Two writers on the operator's own
# account is the thing this must never do. So the census asks the process table, per profile: the
# engine path is shared by every profile, so the profile is read from the process's own environ.
census() {
  local pid
  for pid in $(pgrep -u "$(id -u)" -f "$ENGINE" 2>/dev/null); do
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
      | grep -qx "HH_PROFILE=$PROFILE" && echo "$pid"
  done
}

start() {
  alive && { echo "already up (pid $(cat "$PIDF"))"; return 0; }
  # An engine the pidfile lost is still a live writer — adopt it instead of launching a rival.
  local orphan; orphan=$(census | head -1)
  if [ -n "$orphan" ]; then
    echo "$orphan" > "$PIDF"
    echo "already up (pid $orphan, adopted — pidfile had lost it)"
    return 0
  fi
  local py; py=$(find_py) || { echo "no python with playwright" >&2; return 2; }
  [ -n "$ENGINE" ] || { echo "engine mesh-hh-drive.py not found" >&2; return 2; }
  local mark; mark=$(( $(stat -c%s "$LOG" 2>/dev/null || echo 0) + 1 ))
  # The engine writes the log itself; sending its stdout there too duplicated every line, which
  # made --peek read like the driver was running each command twice.
  # HH_HEADLESS=0 asks the engine for the FULL chromium, which will not start without a display, so
  # the wrapper supplies a virtual one. `command -v` decides, not the presence of the variable: a
  # node without xvfb-run must fail LOUDLY here rather than launch a headless browser the caller
  # explicitly asked not to have — the whole point of the flag is that an ATS scores the fingerprint.
  if [ "${HH_HEADLESS:-1}" = "0" ] && [ -z "${DISPLAY:-}" ]; then
    command -v xvfb-run >/dev/null 2>&1 || {
      echo "HH_HEADLESS=0 needs xvfb-run (or a DISPLAY) and this node has neither" >&2; return 2; }
    nohup xvfb-run -a "$py" "$ENGINE" >/dev/null 2>>"$LOG" &
  else
    nohup "$py" "$ENGINE" >/dev/null 2>>"$LOG" &
  fi
  echo $! > "$PIDF"
  # The daemon prints [ready] and then dumps ~80 lines of controls, so a narrow tail window slides
  # past the marker before the loop looks — the first version of this check reported failure on a
  # driver that was already serving. Watch the byte offset the log had at launch instead.
  local i
  for i in $(seq 1 40); do
    tail -c +"$mark" "$LOG" 2>/dev/null | grep -q '^\[ready\]' && {
      echo "up (pid $(cat "$PIDF"))"; return 0; }
    sleep 2
  done
  echo "started (pid $(cat "$PIDF")) but no [ready] within 80s" >&2; return 1
}

send() { printf '%s\n' "$1" >> "$CMD"; }

wait_for() {
  local marker="$1" secs="${2:-180}" i
  for i in $(seq 1 "$secs"); do
    grep -qF -- "$marker" "$LOG" 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

# hh answers some automated navigations with "Проверка браузера перед переходом на hh.ru" — an
# interstitial that renders an EMPTY document to every selector. A caller that reads through it
# sees zero applications, zero search results, and no error: the most dangerous shape there is,
# because "nothing found" and "we were blocked" are the same bytes. Every navigation goes through
# here, so a blocked read is exit 2 (honest n/a) and never an empty answer.
#
# There is MORE THAN ONE such wall, and the guard above knew exactly one of them, by one RU string,
# on an account hh serves in ENGLISH. Measured 2026-08-16: this node egresses through the router's
# NL VPN, and hh answers every navigation with its own /vpncheeck page — "VPN detected — it may
# affect site performance" — which passed the 'Проверка браузера' test, so nav returned 0 and the
# callers read an interstitial as an empty account: mesh-job-track wrote {} over four tracked
# applications, and the SERP read n=0 vacancies. Classify the landed page, don't pattern-match one
# sentence: the URL hh redirects to is the reliable tell (the wall's body is localised, its path is
# not), and the two walls need OPPOSITE handling — a browser check clears if you wait, a VPN wall
# never does while the tunnel is up, so retrying it just burns a minute to reach the same verdict.
# Dismissing it is NOT ours to do: its button asserts "I'm not using a VPN", which is false here.
wall_of() {   # reads a log chunk on stdin -> prints: ok | check | vpn
  local chunk; chunk=$(cat)
  case "$chunk" in
    *hh.ru/vpncheeck*|*"VPN detected"*|*"VPN обнаружен"*) echo vpn ;;
    *"Проверка браузера"*|*"Just a moment"*|*"Checking your browser"*) echo check ;;
    *) echo ok ;;
  esac
}

nav() {
  local url="$1" tries="${2:-4}" i mark w
  for i in $(seq 1 "$tries"); do
    mark=$(stat -c%s "$LOG" 2>/dev/null || echo 0)
    send "goto $url"
    sleep 8
    send "js document.body.innerText.slice(0,60).replace(/\n/g,' ')"
    sleep 4
    w=$(tail -c +"$((mark+1))" "$LOG" | wall_of)
    case "$w" in
      check) sleep $(( i * 10 )); continue ;;
      vpn)   echo "blocked: hh VPN wall (/vpncheeck) — this node egresses through a VPN; hh serves no page behind it, and waiting does not clear it" >&2
             return 2 ;;
      *)     return 0 ;;
    esac
  done
  echo "blocked: hh browser-check interstitial after $tries attempts" >&2
  return 2
}

case "${1:---peek}" in
  --start) start ;;
  --goto)  nav "$2" "${3:-4}" ;;
  # "up" must mean an engine is RUNNING, not that a file holds a number. A census hit with a
  # dead pidfile is still a live driver holding the login and reading $CMD.
  --alive) { alive || [ -n "$(census)" ]; } && { echo up; exit 0; } || { echo down; exit 1; } ;;
  --send)  send "$2" ;;
  --run)   if [ $# -ge 2 ]; then printf '%s\n' "$2" >> "$CMD"; else cat >> "$CMD"; fi ;;
  --peek)  tail -n "${2:-40}" "$LOG" ;;
  --wait)  wait_for "$2" "${3:-180}" ;;
  --shot)
    send "shot $2"
    wait_for "$MESH/job/shots/$2.png" 90 && echo "$MESH/job/shots/$2.png" ;;
  # `quit` is a QUEUED verb: the daemon reads it only after everything ahead of it, and a stuck
  # batch can hold 20s-per-verb timeouts for minutes. The old three-second sleep + rm therefore
  # reported a stop it had not made and DELETED the only handle on the survivor — which is how one
  # login ended up driven by three engines. Wait for the census to empty, then kill what is left,
  # and say which of the two happened.
  --stop)
    send quit
    for _i in $(seq 1 15); do [ -z "$(census)" ] && break; sleep 2; done
    left="$(census)"
    if [ -n "$left" ]; then
      echo "$left" | xargs -r kill 2>/dev/null
      sleep 2
      left="$(census)"
      [ -n "$left" ] && { echo "$left" | xargs -r kill -9 2>/dev/null; sleep 1; }
      echo "stopped (had to kill: $(echo $left))"
    else
      echo "stopped"
    fi
    rm -f "$PIDF" ;;
  --test)
    rc=0
    [ -n "$ENGINE" ] || { echo "FAIL: engine missing"; exit 1; }
    "$(command -v python3)" -c "import ast,sys; ast.parse(open('$ENGINE').read())" \
      || { echo "FAIL: engine does not parse"; exit 1; }
    # The wall classifier runs on text, so it is assertable without a browser — and it must be,
    # because the live page shows ONE of the three cases at a time and the other two would never
    # be exercised. Fixtures are hh's own bytes: the /vpncheeck redirect and the EN body string
    # both come from ~/.mesh/job/hh-drive.log, 2026-08-16.
    for f in \
      "vpn|[url] https://hh.ru/vpncheeck?backUrl=%2Fapplicant%2Fnegotiations" \
      "vpn|[js] I am looking for a job VPN detected — it may affect site performance" \
      "check|[js] Проверка браузера перед переходом на hh.ru" \
      "check|[js] Just a moment... Checking your browser" \
      "ok|[url] https://hh.ru/applicant/negotiations"
    do
      want=${f%%|*}; got=$(printf '%s' "${f#*|}" | wall_of)
      if [ "$got" = "$want" ]; then echo "ok:   wall_of -> $want (${f#*|})" | cut -c1-104
      else echo "FAIL: wall_of said '$got', wanted '$want' for: ${f#*|}"; rc=1; fi
    done
    if ! find_py >/dev/null; then
      echo "n/a: no python with playwright on this node"; exit 2
    fi
    if ! alive; then
      echo "n/a: driver not running (start it with --start; nothing to assert against)"; exit 2
    fi
    # The real claim: the live page answers. A pidfile is not a page — assert a fresh readback,
    # never the previous run's line (a marker unique to THIS run is the only honest gate).
    m="selftest-$$-$(date +%s)"
    send "shot $m"
    if wait_for "$MESH/job/shots/$m.png" 60 && [ -s "$MESH/job/shots/$m.png" ]; then
      echo "ok: live page answered, $(stat -c%s "$MESH/job/shots/$m.png") byte screenshot"
      rm -f "$MESH/job/shots/$m.png"
    else
      echo "FAIL: driver up but the page did not answer a fresh screenshot"; rc=1
    fi
    # Fixtures prove the classifier reads text; only a real navigation proves nav's EXIT CODE
    # follows it. Asserted as an agreement, not as an expected verdict, so this leg keeps asserting
    # once the wall lifts instead of turning red on good news.
    mark=$(stat -c%s "$LOG" 2>/dev/null || echo 0)
    nav "https://hh.ru/applicant/negotiations" 1 >/dev/null 2>&1; nrc=$?
    seen=$(tail -c +"$((mark+1))" "$LOG" | wall_of)
    case "$seen:$nrc" in
      ok:0|check:2|vpn:2) echo "ok: live nav agrees with the landed page (page=$seen rc=$nrc)" ;;
      *) echo "FAIL: live page is '$seen' but nav returned $nrc"; rc=1 ;;
    esac
    exit $rc ;;
  *) sed -n '2,20p' "$0"; exit 1 ;;
esac
