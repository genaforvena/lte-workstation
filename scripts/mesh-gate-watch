#!/usr/bin/env bash
# mesh-gate-watch — DETECT a live permission gate on a mind pane and LOG it (observability only).
#
# Operator 2026-06-25 "FULL AUTONOMY — no blockers, agents must NOT strand at gates, and I must NOT be
# pinged": this watcher NO LONGER Telegram-pings the operator (its old job was to surface a gate to a
# HUMAN for approval; the operator now wants zero gate-pings). It detects + appends to a quiet local
# detect-log (~/.mesh/gate-detect.log) for observability, and emits nothing on stdout so the cron-
# redirected gate-watch.log stops growing. The real autonomy fix lives UPSTREAM — gate-free minds via
# restore.env (--permission-mode bypass, operator-gated) + a curated settings.json allowlist; when minds
# stop gating, detection naturally falls to zero. No mesh-tg, no operator interrupt. $0, no bypass.
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
export PATH="$HOME/.local/bin:$PATH"
# Canonical gate regex — source mesh-patterns.sh; inline fallback keeps the tool self-contained.
_MP="$HOME/.local/bin/mesh-patterns.sh"
if [ -f "$_MP" ]; then . "$_MP"; else
  MESH_GATE_RE='Do you want to (proceed|make this edit|create|delete|allow|run)|❯ 1\. Yes|Allow (once|this|always)|Always allow|Permission required'
fi
if [ "${1:-}" = "--test" ]; then
  for x in tmux ssh grep head tr cut mv mkdir hostname; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -d "$HOME/.mesh" ] && [ -w "$HOME/.mesh" ] || { echo "smoke-test: FAIL (no writable ~/.mesh)"; exit 1; }
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "smoke-test: FAIL (no local tmux session)"; exit 1; }
  test_win=$(tmux list-windows -t "$(hostname)" -F '#{window_name} #{window_panes}' | awk '$2 > 1 {print $1; exit}')
  [ -n "$test_win" ] || { echo "smoke-test: FAIL (no mind channel)"; exit 1; }
  test_pidx=$(tmux list-panes -t "$(hostname):$test_win" -F '#{pane_top} #{pane_index}' | sort -n | tail -1 | awk '{print $2}')
  tmux capture-pane -t "$(hostname):$test_win.$test_pidx" -p >/dev/null 2>&1 || { echo "smoke-test: FAIL (mind pane unreadable)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi
STATE="$HOME/.mesh/.gate-state"; mkdir -p "$HOME/.mesh"; : > "${STATE}.new"
# Every multi-pane local window is a channel: top=DATA, bottom=MIND.
mapfile -t AGENTS < <(tmux list-windows -t "$(hostname)" -F '#{window_name} #{window_panes}' 2>/dev/null | awk '$2 > 1 {print $1 " local " $1}')
pane(){ local node="$1" win="$2"
  local pidx
  if [ "$node" = local ]; then
    pidx=$(tmux list-panes -t "$(hostname):$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
    tmux capture-pane -t "$(hostname):$win${pidx:+.$pidx}" -p 2>/dev/null
  else
    timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=6 "$node" "pidx=\$(tmux list-panes -t \$(hostname):$win -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); tmux capture-pane -t \$(hostname):$win\${pidx:+.\$pidx} -p 2>/dev/null"
  fi
}
for a in "${AGENTS[@]}"; do
  set -- $a; label="$1"; node="$2"; win="$3"
  p="$(pane "$node" "$win")"
  # Detect REAL Claude Code gates. The dominant one is the numbered-choice approval dialog
  # ('Do you want to make this edit to X? / ❯ 1. Yes / 2. No') — the original pattern caught only the
  # older 'Permission required/Allow once' phrasings and went DARK on it (verify 2026-06-14: ds:plan
  # stranded on exactly this, operator never pinged). Aligned with mesh-mind-state's proven gate
  # detection, but kept GATE-SPECIFIC (this ALERTS the operator → a false positive = Telegram spam, so
  # NOT mind-state's broader NEEDS-INPUT set like 'press Enter'/'Tab to amend' that occur mid-edit).
  # Only a LIVE gate counts: the numbered-choice dialog sits at the pane's ACTIVE BOTTOM and REPLACES
  # the "auto mode on"/"bypass permissions on" footer. The old whole-pane match false-fired on gate
  # VOCABULARY anywhere in scrollback (a mind reasoning about permissions, a captured dialog/log, even
  # this watcher's own source) → spurious alerts. Restrict to the bottom region + require the choice
  # cursor + absence of the normal footer.
  ptail="$(printf '%s' "$p" | tail -8)"
  if printf '%s' "$ptail" | grep -qE '❯ 1\. Yes|Do you want to (proceed|make this edit|create|delete|allow|run)' \
     && ! printf '%s' "$ptail" | grep -qiE 'auto mode on|bypass permissions on|accept edits on'; then
    gate="$(printf '%s' "$ptail" | grep -iE 'Do you want to|Allow|command|directory' | head -1 | tr -s ' ' | cut -c1-130)"
    echo "$label" >> "${STATE}.new"
    # DETECT + LOG only (no operator ping — see header). Quiet detect-log, NOT stdout, so the cron-
    # redirected gate-watch.log stops growing once minds are gate-free.
    if ! grep -qx "$label" "$STATE" 2>/dev/null; then
      printf '%s gate %s@%s :: %s\n' "$(date -u +%FT%TZ)" "$label" "$node" "$gate" >> "$HOME/.mesh/gate-detect.log"
    fi
  fi
done
mv "${STATE}.new" "$STATE"
