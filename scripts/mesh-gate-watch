#!/usr/bin/env bash
# mesh-gate-watch — when a free agent pauses at a permission gate, NOTIFY the operator (Telegram) so
# a HUMAN can approve. Keeps the approval boundary (the steward never auto-approves another agent's
# gate); it only surfaces the gate + relays the operator's explicit decision. $0, no bypass.
#
# Flow: agent hits gate -> this alerts operator -> operator replies "одобряю <window>" -> steward
# relays Allow-once via: mesh-tell --node <n> <window> (Right/Enter)  (executed on the human's word).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
STATE="$HOME/.mesh/.gate-state"; mkdir -p "$HOME/.mesh"; : > "${STATE}.new"
# agents to watch: "label  node(local|user@ip)  window"
AGENTS=(
  "opencode-ds imozerov@100.125.157.75 opencode"
  "gemini-ds   imozerov@100.125.157.75 gemini"
)
pane(){ local node="$1" win="$2"
  if [ "$node" = local ]; then tmux capture-pane -t "$(hostname):$win" -p 2>/dev/null
  else timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=6 "$node" "tmux capture-pane -t \$(hostname):$win -p 2>/dev/null"; fi
}
for a in "${AGENTS[@]}"; do
  set -- $a; label="$1"; node="$2"; win="$3"
  p="$(pane "$node" "$win")"
  if printf '%s' "$p" | grep -qiE 'Permission required|Allow once|Allow always|approval'; then
    gate="$(printf '%s' "$p" | grep -iE 'Access|Permission|Allow|directory|command' | head -2 | tr '\n' ' ' | tr -s ' ' | cut -c1-130)"
    echo "$label" >> "${STATE}.new"
    if ! grep -qx "$label" "$STATE" 2>/dev/null && command -v mesh-tg >/dev/null 2>&1; then
      mesh-tg "🔐 Агент $label на $node ждёт одобрения гейта:
$gate
Ответь 'одобряю $win' (разрешу один раз) или 'отклони $win'. Не форсю — твоё решение."
    fi
  fi
done
mv "${STATE}.new" "$STATE"
