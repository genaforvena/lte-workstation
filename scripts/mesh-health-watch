#!/usr/bin/env bash
# mesh-health-watch — edge-triggered alert when any mesh node goes FAIL in mesh-health.
# Roadmap item #3: "Health folded into watchdog + alert→phone on FAIL".
# Runs mesh-health, compares to previous result, alerts operator only on state change.
# $0, no mind, safe to cron.
#
#   mesh-health-watch          check all nodes, alert on FAIL state changes
#   mesh-health-watch --status show last known state of each node
#
# Cron suggestion: */15 * * * * mesh-health-watch >> ~/.mesh/health-watch.log 2>&1
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; STATEDIR="$MESH/.health-watch-state"; LOG="$MESH/health-watch.log"
mkdir -p "$STATEDIR"
STATUS=0; [ "${1:-}" = --status ] && STATUS=1
ts(){ date -u +%FT%TZ; }
alert(){ command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$1" >/dev/null 2>&1 || true; }

if [ "$STATUS" = 1 ]; then
  for f in "$STATEDIR"/*.state; do
    [ -f "$f" ] || continue
    node=$(basename "$f" .state)
    printf '  %-36s %s\n' "$node" "$(cat "$f")"
  done
  exit 0
fi

command -v mesh-health >/dev/null 2>&1 || { echo "$(ts) mesh-health not found" >> "$LOG"; exit 1; }

# Run mesh-health, parse each line
mesh-health 2>/dev/null | while IFS= read -r line; do
  # Lines look like: PASS  hostname  ip  or  FAIL  hostname  ip — reason
  result=$(printf '%s' "$line" | awk '{print $1}')
  node=$(printf '%s' "$line"  | awk '{print $2}')
  [ -z "$node" ] || [ -z "$result" ] && continue
  case "$result" in PASS|FAIL|SKIP) ;; *) continue;; esac

  statefile="$STATEDIR/${node}.state"
  prev=$(cat "$statefile" 2>/dev/null || echo "")

  printf '%s' "$result" > "$statefile"

  if [ "$result" = FAIL ] && [ "$prev" != FAIL ]; then
    msg="🚨 mesh-health: $node FAIL (was ${prev:-unknown}) — node unreachable or no internet. $(date -u +%H:%MZ)"
    echo "$(ts) ALERT $node: FAIL (was $prev)" >> "$LOG"
    alert "$msg"
  elif [ "$result" = PASS ] && [ "$prev" = FAIL ]; then
    msg="✅ mesh-health: $node RECOVERED (was FAIL). $(date -u +%H:%MZ)"
    echo "$(ts) RECOVER $node: PASS (was FAIL)" >> "$LOG"
    alert "$msg"
  fi
done
