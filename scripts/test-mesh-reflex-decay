#!/usr/bin/env bash
# test-mesh-reflex-decay — regression proof for mesh-reflex-decay (isolated-HOME verification artifact).
# Regression proof for mesh-reflex-decay. Uses an isolated HOME only.
set -euo pipefail

TARGET="${MESH_REFLEX_DECAY_BIN:-$(dirname "$0")/mesh-reflex-decay}"
SBX=$(mktemp -d /tmp/mesh-reflex-decay-test.XXXXXX)
trap 'rm -rf "$SBX"' EXIT
mkdir -p "$SBX/.local/bin" "$SBX/.mesh"
: > "$SBX/.mesh/supervise.list"

cat > "$SBX/.local/bin/mesh-decay-canary" <<'CANARY'
#!/usr/bin/env bash
# smoke-test: deliberately fails every invocation
exit 1
CANARY

cat > "$SBX/.local/bin/mesh-genome-canary" <<'GENOMECANARY'
#!/usr/bin/env bash
# smoke-test: deliberately fails every invocation
exit 1
GENOMECANARY

cat > "$SBX/.local/bin/mesh-chat" <<'CHAT'
#!/usr/bin/env bash
if [ "${1:-}" = --test ]; then
  echo "smoke-test: ok"
  exit 0
fi
printf '%s\n' "$*" >> "$HOME/.mesh/chat-capture.log"
CHAT
chmod +x "$SBX/.local/bin/mesh-decay-canary" "$SBX/.local/bin/mesh-genome-canary" "$SBX/.local/bin/mesh-chat"

# genome fixture: mesh-genome-canary is still "tracked" (present under $REPO/scripts/) — sync-tools
# would redeploy it right back, so it must NEVER be atticked, report-only or --apply alike.
REPO="$SBX/repo"; mkdir -p "$REPO/scripts"
touch "$REPO/scripts/mesh-genome-canary"

# BARE RUN (chat-review/reflex-decay-attic-churn-needs-dryrun): report-only — file untouched, no
# [decay] post. This is exactly what mesh-needs:165 calls expecting dry-run.
HOME="$SBX" MESH_DECAY_DAYS=14 MESH_REPO="$REPO" "$TARGET" > "$SBX/report.out" 2> "$SBX/report.err"
test ! -s "$SBX/report.err"
test -x "$SBX/.local/bin/mesh-decay-canary"
test ! -e "$SBX/.mesh/attic/mesh-decay-canary"
test ! -e "$SBX/.mesh/chat-capture.log"
grep -q 'mesh-decay-canary — UNUSED + FAILS smoke → DECAY CANDIDATE' "$SBX/report.out"
grep -q 'mesh-genome-canary — UNUSED + FAILS smoke but GENOME-PRESENT' "$SBX/report.out"
echo "PASS bare-run: candidate file UNTOUCHED + no [decay] post (report-only default)"

# --apply: the true candidate moves + is announced; the genome-present fixture never moves even here.
HOME="$SBX" MESH_DECAY_DAYS=14 MESH_REPO="$REPO" "$TARGET" --apply > "$SBX/decay.out" 2> "$SBX/decay.err"
test ! -s "$SBX/decay.err"
test ! -e "$SBX/.local/bin/mesh-decay-canary"
test -x "$SBX/.mesh/attic/mesh-decay-canary"
test -x "$SBX/.local/bin/mesh-genome-canary"
test ! -e "$SBX/.mesh/attic/mesh-genome-canary"
grep -q '^supervised: 0$' "$SBX/decay.out"
grep -q 'mesh-decay-canary — UNUSED + FAILS smoke → DECAYING to attic' "$SBX/decay.out"
grep -q 'mesh-genome-canary — UNUSED + FAILS smoke but GENOME-PRESENT' "$SBX/decay.out"
grep -q '\[decay\] mesh-decay-canary:' "$SBX/.mesh/chat-capture.log"
grep -qv 'mesh-genome-canary' "$SBX/.mesh/chat-capture.log" || { echo "FAIL: genome-present canary was announced as decayed"; exit 1; }
echo "PASS --apply: unused+failing canary moved to attic and announced; genome-present canary never moved"

HOME="$SBX" MESH_DECAY_DAYS=14 MESH_REPO="$REPO" "$TARGET" --undo mesh-decay-canary > "$SBX/undo.out" 2> "$SBX/undo.err"
test ! -s "$SBX/undo.err"
test -x "$SBX/.local/bin/mesh-decay-canary"
test ! -e "$SBX/.mesh/attic/mesh-decay-canary"
grep -q 'restored: mesh-decay-canary' "$SBX/undo.out"
grep -q '\[restore\] mesh-decay-canary restored from attic' "$SBX/.mesh/chat-capture.log"

echo "PASS undo: canary restored and announced"
