#!/usr/bin/env bash
# reflex-cadence: 11-59/10 * * * *
# reflex-args: --edge
# mesh-psi-memory — the kernel's MEMORY PRESSURE sense from /proc/pressure/memory.
#
# /proc/pressure/memory is a real kernel signal the mesh did not yet expose as a standalone sense.
# PSI memory tells us when tasks are stalled by reclaim / thrashing, a local signal distinct from
# loadavg and distinct from the existing mesh-psi fusion surface. This tool makes that signal first-
# class without inventing anything when PSI is absent.
#
# Honest contract:
#   - /proc/pressure/memory unreadable -> exit 2
#   - never fabricates a reading
#
# Usage:
#   mesh-psi-memory           one-shot: QUIET / BUSY / PRESSURED / SATURATED
#   mesh-psi-memory --edge    emit only on state change
#   mesh-psi-memory --json    machine-readable JSON
#   mesh-psi-memory --test    smoke test (fixture parse + live read gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
# MESH_TEST_SANDBOX=1 diverts the state write — pre-fix, --test's 4 self-invokes stamped the LIVE
# .psi-memory-state with fixture verdicts (task test-live-writes 2026-07-20).
STATE="$MESH/.psi-memory-state"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${TMPDIR:-/tmp}/.psi-memory-state.sandbox.$$"
OFFLINEFILE="$MESH/.psi-memory-offline"
PRESSURE_FILE="${MESH_PRESSURE_MEMORY_FILE:-/proc/pressure/memory}"
SWAPRATE_STATE="${MESH_SWAPRATE_STATE:-$MESH/.swap-rate.state}"
mkdir -p "$MESH" 2>/dev/null || true

# thrash_qualifier <state-file> -> echoes "label pps" (both empty if unreadable/unparsable).
# Reads mesh-swap-rate's own STATE artifact (cron-wired */5, wire-swap-thrash-rate 2026-07-04) — never
# re-samples /proc/vmstat itself (that tool's own 3s two-sample window is its job, not ours to duplicate).
# Distinguishes swap FULL-but-stable from swap actively thrashing, the qualifier mesh-psi-memory's
# level-only PSI verdict can't express on its own.
thrash_qualifier() {
  local f="$1" line label pps
  [ -r "$f" ] || { printf ' \n'; return; }
  line="$(head -1 "$f" 2>/dev/null)"
  label="${line%%|*}"
  pps="$(printf '%s' "$line" | grep -oE 'swap_pps=[0-9]+' | cut -d= -f2)"
  [ -n "$label" ] && [ -n "$pps" ] || { printf ' \n'; return; }
  printf '%s %s\n' "$label" "$pps"
}

classify() {
  awk -v some="${1:-}" -v full="${2:-}" 'BEGIN{
    if (some == "" || full == "" || some !~ /^[0-9]+([.][0-9]+)?$/ || full !~ /^[0-9]+([.][0-9]+)?$/) {
      print "UNKNOWN"; exit
    }
    if (full >= 5.0) { print "SATURATED"; exit }
    if (some >= 10.0) { print "PRESSURED"; exit }
    if (some > 0.5) { print "BUSY"; exit }
    print "QUIET"
  }'
}

read_pressure() {
  awk '
    $1 == "some" {
      for (i = 2; i <= NF; i++) {
        split($i, kv, "=")
        if (kv[1] == "avg10") some10 = kv[2]
        else if (kv[1] == "avg60") some60 = kv[2]
        else if (kv[1] == "avg300") some300 = kv[2]
        else if (kv[1] == "total") some_total = kv[2]
      }
    }
    $1 == "full" {
      for (i = 2; i <= NF; i++) {
        split($i, kv, "=")
        if (kv[1] == "avg10") full10 = kv[2]
        else if (kv[1] == "avg60") full60 = kv[2]
        else if (kv[1] == "avg300") full300 = kv[2]
        else if (kv[1] == "total") full_total = kv[2]
      }
    }
    END {
      if (some10 == "" || full10 == "") exit 1
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", some10, some60, some300, some_total, full10, full60, full300, full_total
    }
  ' "$1"
}

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  # TEST-SANDBOX (task test-live-writes 2026-07-20): self-invokes divert; %y sig gate before exits.
  export MESH_TEST_SANDBOX=1
  _pm_live="$HOME/.mesh/.psi-memory-state"
  _pm_sig="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT

  cat >"$td/mem" <<'EOF'
some avg10=0.00 avg60=0.10 avg300=0.20 total=12
full avg10=0.00 avg60=0.00 avg300=0.00 total=0
EOF
  got="$(MESH_PRESSURE_MEMORY_FILE="$td/mem" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (quiet fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"QUIET"' || { echo "smoke-test: FAIL (quiet fixture -> QUIET: $got)"; exit 1; }

  cat >"$td/mem" <<'EOF'
some avg10=12.34 avg60=8.00 avg300=3.00 total=99
full avg10=0.01 avg60=0.00 avg300=0.00 total=1
EOF
  got="$(MESH_PRESSURE_MEMORY_FILE="$td/mem" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (pressured fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"PRESSURED"' || { echo "smoke-test: FAIL (pressured fixture -> PRESSURED: $got)"; exit 1; }

  cat >"$td/mem" <<'EOF'
some avg10=77.00 avg60=70.00 avg300=65.00 total=1234
full avg10=7.00 avg60=5.00 avg300=4.00 total=567
EOF
  got="$(MESH_PRESSURE_MEMORY_FILE="$td/mem" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (saturated fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"SATURATED"' || { echo "smoke-test: FAIL (saturated fixture -> SATURATED: $got)"; exit 1; }

  # sandbox honesty gate — before BOTH exits (the fixture invokes already ran above). Falsify: drop
  # the MESH_TEST_SANDBOX diversion at the STATE assignment.
  _pm_sig2="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
  if [ "$_pm_sig2" != "$_pm_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped the LIVE state $_pm_live: '$_pm_sig' → '$_pm_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_pm_live: '$_pm_sig' → '$_pm_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  [ -r "$PRESSURE_FILE" ] || { echo "smoke-test: n/a (no readable PSI memory source on this node)"; exit 2; }
  real="$(MESH_PRESSURE_MEMORY_FILE="$PRESSURE_FILE" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (real read failed)"; exit 1; }
  printf '%s\n' "$real" | grep -q '"source":"/proc/pressure/memory"' || {
    printf '%s\n' "$real" | grep -q '"source":"'"$PRESSURE_FILE"'"' || {
      echo "smoke-test: FAIL (real read missing source tag: $real)"; exit 1;
    }
  }
  # thrash qualifier: missing/unreadable state file -> empty (never fabricated), well-formed state -> parsed
  read -r tlabel tpps <<<"$(thrash_qualifier "$td/no-such-file")"
  [ -z "$tlabel" ] && [ -z "$tpps" ] || { echo "smoke-test: FAIL (thrash: missing file should be empty, got label=$tlabel pps=$tpps)"; exit 1; }
  printf 'THRASHING|swap_pps=733|in_pps=200|out_pps=533|majflt_pps=10|window=3s\n' > "$td/swap-rate"
  read -r tlabel tpps <<<"$(thrash_qualifier "$td/swap-rate")"
  [ "$tlabel" = THRASHING ] && [ "$tpps" = 733 ] || { echo "smoke-test: FAIL (thrash: expected THRASHING/733, got $tlabel/$tpps)"; exit 1; }

  # second sig read covers the real-read invoke between the first gate and here
  _pm_sig3="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
  if [ "$_pm_sig3" != "$_pm_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test's live-read leg stamped the LIVE state $_pm_live — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%y %s' "$_pm_live" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test's live-read leg stamped the LIVE state $_pm_live — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  echo "smoke-test: ok (fixture classifier + thrash qualifier parse + live /proc/pressure/memory read)"
  exit 0
fi

JSON=0
for a in "$@"; do
  [ "$a" = --json ] && JSON=1
done

[ -r "$PRESSURE_FILE" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "psi-memory: UNREACHABLE — no readable $PRESSURE_FILE" >&2; : > "$OFFLINEFILE"; }
  exit 2
}

readout="$(read_pressure "$PRESSURE_FILE" 2>/dev/null)" || {
  [ -f "$OFFLINEFILE" ] || { echo "psi-memory: UNREACHABLE — unreadable $PRESSURE_FILE" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

IFS=$'\t' read -r some10 some60 some300 some_total full10 full60 full300 full_total <<EOF
$readout
EOF

label="$(classify "$some10" "$full10")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
  "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$ts" > "$STATE"
mesh-state-touch "$STATE"

read -r thrash_label thrash_pps <<<"$(thrash_qualifier "$SWAPRATE_STATE")"

if [ "$JSON" = 1 ]; then
  if [ -n "$thrash_pps" ]; then
    printf '{"label":"%s","some_avg10":%s,"some_avg60":%s,"some_avg300":%s,"some_total":%s,"full_avg10":%s,"full_avg60":%s,"full_avg300":%s,"full_total":%s,"source":"%s","thrash_label":"%s","thrash_pps":%s,"ts":"%s"}\n' \
      "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$PRESSURE_FILE" "$thrash_label" "$thrash_pps" "$ts"
  else
    printf '{"label":"%s","some_avg10":%s,"some_avg60":%s,"some_avg300":%s,"some_total":%s,"full_avg10":%s,"full_avg60":%s,"full_avg300":%s,"full_total":%s,"source":"%s","ts":"%s"}\n' \
      "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$PRESSURE_FILE" "$ts"
  fi
else
  if [ -n "$thrash_pps" ]; then
    printf '[psi-memory] %s — some avg10=%s avg60=%s avg300=%s total=%s | full avg10=%s avg60=%s avg300=%s total=%s | thrash=%spg/s(%s) @ %s\n' \
      "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$thrash_pps" "$thrash_label" "$ts"
  else
    printf '[psi-memory] %s — some avg10=%s avg60=%s avg300=%s total=%s | full avg10=%s avg60=%s avg300=%s total=%s @ %s\n' \
      "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$ts"
  fi
fi
