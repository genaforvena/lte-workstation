#!/usr/bin/env bash
# orphan-ok: the room-mind's LISTEN/WATCH reflex daemon (mesh-room-reflex.service on mesh-home).
# mesh-room-reflex — make listening a REFLEX (operator 2026-07-15: "it must be a reflex to listen and
# overhear us, to watch after us ... and comment if you please"). Mechanical trigger only: it watches
# the live room transcript and POKES the room mind (me) so I wake, read, and comment AT MY DISCRETION.
# The judgement (what's worth a word) stays with the mind; this daemon just guarantees I'm never deaf.
#
# Two triggers, both cooldown-gated so it never floods the mind with paid turns:
#   NAME  — a NEW transcript line contains the wake stem (миш/миша/misha) → poke SOON (short cooldown).
#   AMBIENT — substantive new speech accumulated + a longer cooldown elapsed → a proactive "look in".
#
# TRACKING IS PER-LINE, NOT PER-BYTE (fixed 2026-07-14 — the false-wake storm).
#   The transcript is a ROLLING buffer: mesh-room-transcribe-loop prunes it with `tail -n 40 > tmp
#   && mv`, so the file SHRINKS and every byte offset shifts. The old byte-offset tracker hit
#   `[ "$size" -lt "$pos" ] && pos=0` on each prune, resynced to zero, and replayed the ENTIRE
#   40-line buffer as "fresh" — re-matching a «Миша» from ten minutes ago and poking `name` with a
#   `tail -n 3` window that didn't even contain the name. Observed live: `[room-reflex: name]` on
#   «Время» / «Поехали» / «КОНЕЦ». We now anchor on the CONTENT of the last consumed line.
#
# ANCHOR-LOST REPLAYS ONLY WHAT IS PROVABLY NEW (fixed 2026-07-16 — the eaten first wake).
#   The first cut of the per-line fix resynced to the END whenever the anchor line was gone. But the
#   gigaam ear TIME-prunes the transcript (OH_KEEP_MIN=10), so any silence longer than the prune
#   window drains the buffer to zero — taking the anchor line with it. The next utterance is then the
#   FIRST line of a buffer whose anchor is lost, and resync-without-replay consumed it silently. That
#   first utterance after a long silence is precisely the operator's «Миша…» wake: observed live
#   2026-07-16 15:48, the operator asked Misha out loud if his hearing was back and the reflex ate
#   the poke while the ear transcribed him perfectly. The anchor now records the CONSUME EPOCH next
#   to the sha; on anchor-lost we replay only lines whose [HH:MM:SS] stamp is AFTER that epoch. A
#   consumed line is always older than its consume (write precedes consume), so the storm-class
#   replay of history stays impossible; with no epoch on record (first run, legacy anchor) we keep
#   the old resync-only behaviour. A missed poke is cheap, but a missed WAKE is the one failure the
#   whole reflex exists to prevent — deafness is never the safe default.
#
# The poke hands the mind the NEW lines that actually fired the trigger, plus a little preceding
# context — never a window decoupled from the match.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"; export LC_ALL=C.UTF-8   # grep -i folds Cyrillic under C.UTF-8
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR

TRANS="${ROOM_TRANSCRIPT:-$HOME/.mesh/room-transcript.txt}"
ANCHOR="${ROOM_REFLEX_ANCHOR:-$HOME/.mesh/.room-reflex-anchor}"   # sha1 of the last consumed line
LASTPOKE="${ROOM_REFLEX_LASTPOKE:-$HOME/.mesh/.room-reflex-lastpoke}"
ACK_LOG="${ROOM_REFLEX_ACK_LOG:-$HOME/.mesh/room-reflex-ack.log}"   # listening-reflex ack outcomes (loud, not silent)
NAME_RE='миш|меш|misha|миша'   # +меш: the operator calls the mesh «меш» (е) out loud, not «Миша» (и) — that
                              # miss (2026-07-17) went unacked because the vowel differs. High-recall on
                              # purpose; mesh-room-address is the precision half and fails OPEN.
NAME_COOLDOWN="${ROOM_NAME_COOLDOWN:-25}"           # s between name-pokes
AMBIENT_COOLDOWN="${ROOM_AMBIENT_COOLDOWN:-240}"    # s between proactive look-ins
AMBIENT_MIN_CHARS="${ROOM_AMBIENT_MIN_CHARS:-140}"  # only look in once enough new speech piled up
ROOM_AMBIENT_GATE="${ROOM_AMBIENT_GATE:-1}"         # gate proactive look-ins through gemma4 before poking
LEAD="${ROOM_REFLEX_LEAD:-2}"                       # lines of preceding context to include
# ROOM_LISTEN_ACK (default 1) — read LIVE in ack_listening, not cached here, so the --test env override
# actually takes effect (a top-level `${ROOM_LISTEN_ACK:-1}` is fixed at parse time; the daemon's env is
# fixed at launch anyway, so reading it fresh each tick is identical in production and honest under test).
# THE LISTENING REFLEX (operator 2026-07-17, out loud in the room: "нужен рефлекс который НЕ ОТВЛЕКАЯ
# МИН бы говорил ... что вот эти вот мои обращения к тебе срабатывают или нет ... нужно говорить что я
# слушаю"). He can't tell from silence whether his «Миш…» landed or the mic missed him. So on a by-name
# address that SURVIVED the precision gate — the one point we KNOW the call registered — the DAEMON
# itself says a short confirmation, before it pokes the mind. It is deliberately the reflex's job, not
# the mind's: the mind still gets poked and decides whether to actually reply (or stay silent), while
# the operator gets a guaranteed, paid-turn-free "я слушаю" the instant his address is heard. Naturally
# rate-limited by NAME_COOLDOWN (the ack rides the same post-cooldown/post-gate path as the poke), and
# varied so it doesn't read as a robotic beep — the operator measures the room's voice by «натурально».
ACK_PHRASES=("Слушаю" "Да, слышу" "Тут, слушаю тебя" "Ага, слушаю")

now() { date +%s; }
# `cat || echo 0` was not enough: an EXISTING but empty/garbage file (crash mid-write, full disk)
# makes cat succeed with no output, and `$(now) - ` is a fatal arithmetic syntax error that kills
# the loop — the reflex would go silently deaf. Anything non-numeric reads as "never poked".
last_poke() {
  local v; v="$(cat "$LASTPOKE" 2>/dev/null)"
  case "$v" in (''|*[!0-9]*) echo 0 ;; (*) echo "$v" ;; esac
}
line_sha() { printf '%s' "$1" | sha1sum | cut -d' ' -f1; }

# [HH:MM:SS] prefix → epoch (today; rolled back a day if that lands in the future — the same
# midnight rule the gigaam prune applies when it drops old lines). rc=1 when the line has no stamp.
line_epoch() {
  local t
  [[ "$1" =~ ^\[([0-9]{2}:[0-9]{2}:[0-9]{2})\] ]] || return 1
  t="$(date -d "today ${BASH_REMATCH[1]}" +%s 2>/dev/null)" || return 1
  [ "$t" -gt $(( $(now) + 60 )) ] && t=$(( t - 86400 ))
  printf '%s\n' "$t"
}

# Emit the lines appended since the anchor, one per line. When the anchor line has been pruned away,
# replay only lines stamped AFTER the last consume; with nothing provably new (or no epoch on
# record), resync to the end without replaying — see the two header paragraphs for both directions.
fresh_lines() {
  local anchor aepoch i idx=-1 n
  local -a L
  [ -f "$TRANS" ] || return 0
  mapfile -t L < "$TRANS" 2>/dev/null || return 0
  n=${#L[@]}; [ "$n" -eq 0 ] && return 0
  anchor="$(sed -n 1p "$ANCHOR" 2>/dev/null)"
  aepoch="$(sed -n 2p "$ANCHOR" 2>/dev/null)"
  case "$aepoch" in (''|*[!0-9]*) aepoch='' ;; esac
  if [ -n "$anchor" ]; then
    for ((i=n-1; i>=0; i--)); do
      [ "$(line_sha "${L[i]}")" = "$anchor" ] && { idx=$i; break; }
    done
  fi
  if [ "$idx" -lt 0 ]; then
    if [ -n "$aepoch" ]; then
      local start=-1 t
      for ((i=0; i<n; i++)); do
        t="$(line_epoch "${L[i]}")" || continue
        [ "$t" -gt "$aepoch" ] && { start=$i; break; }
      done
      if [ "$start" -ge 0 ]; then
        for ((i=start; i<n; i++)); do printf '%s\n' "${L[i]}"; done
        return 0
      fi
    fi
    consume "${L[n-1]}"   # first run, legacy anchor, or nothing stamped after it → resync only
    return 0
  fi
  for ((i=idx+1; i<n; i++)); do printf '%s\n' "${L[i]}"; done
}

# Preceding context for a poke: the LEAD lines that sit just before the fresh block.
lead_lines() {
  local nfresh="$1" total
  total=$(wc -l < "$TRANS" 2>/dev/null || echo 0)
  local start=$(( total - nfresh - LEAD ))
  [ "$start" -lt 0 ] && start=0
  local count=$(( total - nfresh - start ))
  [ "$count" -le 0 ] && return 0
  tail -n +"$((start+1))" "$TRANS" 2>/dev/null | head -n "$count"
}

consume() { { line_sha "$1"; now; } > "$ANCHOR"; }   # line 1 = sha, line 2 = consume epoch

# The listening reflex's voice: a short, varied "слушаю" spoken by the DAEMON on a confirmed by-name
# address. Call mesh-note3-say BARE — it self-mutes the room mic for the clip's duration, so the ack
# is never transcribed back into a self-hearing loop (same rule the poke prompt carries). Best-effort:
# a missing organ or a play failure must never cost the mind its poke, so this can only ever ADD a word.
ack_listening() {
  [ "${ROOM_LISTEN_ACK:-1}" = 1 ] || return 0
  command -v mesh-note3-say >/dev/null 2>&1 || { printf '%s ack SKIP no-note3-say\n' "$(date -Is)" >> "$ACK_LOG"; return 0; }
  local i=$(( $(now) % ${#ACK_PHRASES[@]} )) rc
  # LOUD, not silent: a best-effort `|| true` would hide a broken voice organ (a default
  # indistinguishable from success is one). Record the phrase and note3-say's real exit so a dead
  # ack is visible in ~/.mesh/room-reflex-ack.log instead of vanishing. Still non-fatal to the poke.
  mesh-note3-say "${ACK_PHRASES[i]}" >/dev/null 2>&1; rc=$?
  printf '%s ack rc=%s "%s"\n' "$(date -Is)" "$rc" "${ACK_PHRASES[i]}" >> "$ACK_LOG"
}

poke() {
  local why="$1" ctx="$2"
  now > "$LASTPOKE"
  # The nudge is a POINTER, not a script (operator 2026-07-17 "the nudge is wrong — instead of text
  # there, it should point you to read the transcript and understand how much context you need").
  #   name    — a CONFIRMED by-name address: the operator is talking TO us and the daemon has already
  #             said «слышу», so he's owed a real reply, not another ack (the "acked but never
  #             answered" gap, 2026-07-17). The name nudge carries NO transcript text AT ALL — not even
  #             the trigger lines (operator 2026-07-17: "should NOT send any transcript text ... strip
  #             the transcript lines out of the nudge payload"). A by-name line lands mid-conversation
  #             and the right reply depends on context a 2-3 line keyhole window can't carry, so the
  #             mind READS ~/.mesh/room-transcript.txt itself, tailing back as far as it needs, THEN
  #             answers by voice. MUST-ANSWER stands — read first, then speak. (The by-name detection
  #             + must-answer gate are unchanged; only the payload lost its injected snippet.)
  #   ambient — a proactive look-in on unaddressed chatter; a nicety, so it KEEPS its discretion, and
  #             it DOES still carry the fresh block ($ctx): there's no confirmed address to send it
  #             reading, and the operator's strip-the-text ask was about the by-name nudge specifically.
  # NOTE: do NOT tell the mind to touch/rm ~/.mesh/mesh-speaking around mesh-note3-say. note3-say
  # already holds that flag for the clip's full duration in a background subshell; a wrapper's
  # `rm -f` fires the instant the play intent launches, unmuting the mic mid-sentence so the room
  # transcribes the mesh's OWN voice — a self-hearing loop. Call mesh-note3-say bare. (2026-07-14)
  if [ "$why" = name ]; then
    # No $ctx — a pure WAKE. The mind reads the live transcript itself for context, then MUST answer.
    mesh-tell room "[room-reflex: name] You were addressed BY NAME in the room and you've already said «слышу», so the operator is waiting on a real reply. This nudge carries NO transcript — go READ the room transcript yourself: \`mesh-room read\` (or \`~/.mesh/room-transcript.txt\`), tailing back as far as you need to understand what he's saying and how much context this turn needs (he may be testing the ear, mid-thought, or asking something real). THEN answer him BY VOICE: \`mesh-note3-say \"...\"\` bare (it self-mutes the room mic for you). Say your actual reply, not another ack; don't narrate. If you genuinely can't answer yet, say THAT out loud — but read first." >/dev/null 2>&1
  else
    mesh-tell room "[room-reflex: ambient] new in the room:
$ctx
--
Unaddressed room chatter tripped a proactive look-in. The lines above are only the TRIGGER — before reacting, READ the room transcript (\`~/.mesh/room-transcript.txt\`) and pull back as much context as you need to understand what's going on. THEN react AT YOUR DISCRETION: if it's genuinely worth a word, answer BY VOICE (\`mesh-note3-say \"...\"\` bare; it self-mutes the room mic for you). Otherwise stay silent and keep watching. Don't narrate; either speak to the room or do nothing." >/dev/null 2>&1
  fi
}

tick() {
  local fresh nfresh last age ctx freshchars trigger
  fresh="$(fresh_lines)"
  [ -n "$fresh" ] || return 0
  nfresh=$(printf '%s\n' "$fresh" | wc -l)
  last="$(printf '%s\n' "$fresh" | tail -n 1)"
  age=$(( $(now) - $(last_poke) ))

  if trigger="$(printf '%s\n' "$fresh" | grep -iE "$NAME_RE" | head -n 1)" && [ -n "$trigger" ]; then
    if [ "$age" -ge "$NAME_COOLDOWN" ]; then
      # The regex is high-recall/low-precision by design; mesh-room-address is the precision half —
      # a local qwen2.5 judging "is this talking TO Misha?". It fails OPEN (missing tool, dead
      # ollama, timeout → wake), so this can only ever remove false wakes, never cause deafness.
      # Pass the RECENT DIALOG, not just the matched line: a third-person mention ("спроси у Миши",
      # "как думаешь, Миша прав") carries the name but owes its answer to a human. The gate reads the
      # window on stdin and judges only the last (candidate) line. Still fails OPEN (any error → wake).
      # here-string (a temp-file redirect), NOT a pipe: a pipe to a gate that exits before draining
      # stdin gives printf a SIGPIPE, and pipefail would turn that 141 into a false IGNORE verdict —
      # the exact SIGPIPE/pipefail trap. `<<<` cannot SIGPIPE. Gate still fails OPEN (any error → wake).
      if [ "${ROOM_ADDRESS_GATE:-1}" = 1 ] && command -v mesh-room-address >/dev/null 2>&1 \
         && ! mesh-room-address --window <<<"$(printf '%s\n%s' "$(lead_lines "$nfresh")" "$trigger")"; then
        consume "$last"; return 0    # confidently not addressed — stay asleep
      fi
      # WAKE-CONFIRMED MINT (2026-07-15, board/room-ear-watcher-up-is-a-pgrep-self-match): a by-name
      # call that survived the address gate is the STRONGEST presence evidence the room has — the
      # operator said the name, out loud, and a judge agreed it was addressed to us. mesh-room reads
      # ~/.mesh/.room-wake-confirmed to let THIS reply skip mesh-misha-gate's ambient occupancy bar.
      # Its only minter used to be `mesh-overhear --watch-wake`, which ran nowhere and was wired
      # nowhere, so the marker had never existed and mesh-room's read of it was a permanently-false
      # predicate. Mint it HERE, on the live path, and delegate the decision to mesh-overhear's
      # _wake_should_mint (strict stem + "not our own Bose playing a broadcast Миша") so the arming
      # rule keeps exactly one definition. Best-effort: a refusal or a missing tool must never cost
      # the poke — the mint only ever ADDS the option to answer ungated.
      mesh-overhear --mint-wake-confirmed "$trigger" >/dev/null 2>&1 || true
      ack_listening   # the listening reflex: a brief spoken "слушаю" so the operator KNOWS his address landed
      ctx="$(lead_lines "$nfresh")
$fresh"
      poke "name" "$ctx"; consume "$last"
    fi
    return 0   # hold the fresh block until the cooldown lets the name through — never drop a real wake
  fi

  freshchars=$(printf '%s' "$fresh" | tr -d '[:space:]' | wc -c)
  if [ "$freshchars" -ge "$AMBIENT_MIN_CHARS" ] && [ "$age" -ge "$AMBIENT_COOLDOWN" ]; then
    ctx="$(lead_lines "$nfresh")
$fresh"
    # Gate the PROACTIVE look-in through a cheap local model (gemma4) — the ambient block carries no
    # name (the name path above owns vocatives), so ask "is any of this unaddressed chatter worth a
    # word?" and only spend a paid mind turn on a yes. Unlike the name gate this FAILS CLOSED (a
    # broken/absent model → stay silent), because a proactive comment is a nicety and appliance/robot
    # chatter is exactly the noise we're cutting — the name path stays fail-open so a real address is
    # never gated. `<<<` (temp-file redirect), never a pipe: a gate that exits before draining stdin
    # SIGPIPEs printf and pipefail would flip 141 into a false verdict. mesh-room-address --ambient
    # logs its own react/silent/error to ~/.mesh/room-ambient-gate.log (loud, so a dead gate ≠ quiet
    # room). Gate DISABLED or tool ABSENT → keep the old always-look-in behaviour (don't regress into
    # silence just because the gate isn't deployed; a missing model mid-run is the fail-closed case).
    if [ "$ROOM_AMBIENT_GATE" = 1 ] && command -v mesh-room-address >/dev/null 2>&1; then
      if mesh-room-address --ambient <<<"$ctx"; then poke "ambient" "$ctx"; fi
    else
      poke "ambient" "$ctx"
    fi
  fi
  consume "$last"   # seen; not worth a poke
}

if [ "${1:-}" = --test ]; then
  f=0; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  TRANS="$tmp/t.txt"; ANCHOR="$tmp/anchor"; LASTPOKE="$tmp/lastpoke"; ACK_LOG="$tmp/ack.log"
  # A TEST MUST NOT WRITE THE LIVE ARTIFACT (2026-07-15 — caught by doing exactly that). tick() now
  # mints ~/.mesh/.room-wake-confirmed, the marker mesh-room reads to SKIP mesh-misha-gate. The first
  # version of this harness only stubbed mesh-overhear inside the mint test, so the earlier tick()
  # drivers below resolved the REAL binary and armed a live 180s speak-bypass on this node — a test
  # forging the very evidence it exists to check (the mesh-guardian trap, 09f7914). Two guards, both
  # cheap: stub mesh-overhear for EVERY tick driver, and point HOME at the sandbox so even a PATH miss
  # writes into $tmp and never into the room.
  HOME="$tmp"; mkdir -p "$tmp/.mesh"
  printf '#!/usr/bin/env bash\n[ "$1" = --mint-wake-confirmed ] && printf "%%s" "$2" > "%s/minted"\nexit 0\n' "$tmp" > "$tmp/mesh-overhear"
  chmod +x "$tmp/mesh-overhear"
  # THE ACK MUST NEVER SPEAK DURING --test (a test must not write the live artifact — here the artifact
  # is the operator's room hearing a "слушаю"). Every tick() driver below runs with $tmp on PATH, so a
  # note3-say stub here captures the spoken phrase into $tmp/ackspoke instead of playing it on the Note3.
  printf '#!/usr/bin/env bash\nprintf "%%s" "$1" > "%s/ackspoke"\nexit 0\n' "$tmp" > "$tmp/mesh-note3-say"
  chmod +x "$tmp/mesh-note3-say"

  # 1. first sight of a transcript resyncs to the end WITHOUT replaying history
  printf '[10:00:00] Миша, привет\n[10:00:10] Поехали\n' > "$TRANS"
  out="$(fresh_lines)"
  [ -z "$out" ] || { echo "  FAIL: first run replayed history (should resync silently): $out"; f=1; }

  # 2. a genuinely new line is fresh exactly once
  printf '[10:00:20] новая строка\n' >> "$TRANS"
  out="$(fresh_lines)"
  [ "$out" = '[10:00:20] новая строка' ] || { echo "  FAIL: new line not fresh (got: $out)"; f=1; }
  consume "$out"
  [ -z "$(fresh_lines)" ] || { echo "  FAIL: consumed line came back as fresh"; f=1; }

  # 3. THE REGRESSION: a prune (rewrite that drops old lines) must NOT replay the buffer.
  #    The old byte-offset tracker resynced to 0 here and re-matched the stale «Миша» → false wake.
  printf '[10:00:10] Поехали\n[10:00:20] новая строка\n[10:00:30] Время\n' > "$TRANS"
  out="$(fresh_lines)"
  [ "$out" = '[10:00:30] Время' ] || { echo "  FAIL: prune mis-tracked (want only the new line, got: $out)"; f=1; }
  printf '%s' "$out" | grep -qiE "$NAME_RE" && { echo "  FAIL: prune replayed a stale name → false wake"; f=1; }
  consume "$out"

  # 4. anchor pruned away + only lines OLDER than the last consume → resync to end, no replay
  #    (the false-wake-storm direction: history must never re-poke)
  ts() { date -d "@$(( $(now) + $1 ))" +%H:%M:%S; }   # now+offset as the transcript's [HH:MM:SS]
  printf '[%s] Миша, ты тут?\n[%s] конец\n' "$(ts -7200)" "$(ts -7100)" > "$TRANS"
  out="$(fresh_lines)"
  [ -z "$out" ] || { echo "  FAIL: lost anchor replayed history (should resync silently): $out"; f=1; }

  # 4b. THE EATEN WAKE (2026-07-16 15:48): the time-prune drains the buffer during a long silence,
  #     the anchor line goes with it, then the operator speaks. The new line is stamped AFTER the
  #     last consume and MUST come back fresh — resync-without-replay here is deafness.
  consume "$(tail -n 1 "$TRANS")"                       # last consume = now
  sleep 1                                               # the next line lands strictly after it
  printf '[%s] миша слышал у тебя слух появился\n' "$(ts 0)" > "$TRANS"   # buffer drained → 1 new line
  out="$(fresh_lines)"
  printf '%s' "$out" | grep -q 'слух появился' || { echo "  FAIL: first wake after a drained buffer was eaten (got: '$out')"; f=1; }
  consume "$(tail -n 1 "$TRANS")"

  # 5. the name regex does not match tonight's hallucination lines
  for junk in 'Время' 'Поехали.' 'КОНЕЦ' 'Аплодисменты.'; do
    printf '%s' "$junk" | grep -qiE "$NAME_RE" && { echo "  FAIL: name matched junk '$junk'"; f=1; }
  done
  # ...and still matches a real address, including the truncated stem and uppercase
  for real in 'Ага, Миша, вот задача' 'Ну вот, Миш, плохо слушать' 'МИША слышишь' \
              'меш ты меня слышишь' 'что то меш меня опять игнорирует' 'Меш, глянь'; do
    printf '%s' "$real" | grep -qiE "$NAME_RE" || { echo "  FAIL: name missed '$real'"; f=1; }
  done

  # 6. The poke prompt must never instruct the mind to hand-manage the self-mute flag: note3-say
  #    holds it for the clip duration itself, and a wrapper's `rm` unmutes the mic mid-sentence so
  #    the room hears the mesh's own voice. Assert on the EMITTED prompt, not on this file's text.
  printf '#!/usr/bin/env bash\nprintf "%%s" "$2" > "%s/poked"\n' "$tmp" > "$tmp/mesh-tell"
  chmod +x "$tmp/mesh-tell"
  PATH="$tmp:$PATH" poke "name" '[10:02:00] Миша, тест'
  sent="$(cat "$tmp/poked" 2>/dev/null || echo '')"
  [ -n "$sent" ] || { echo "  FAIL: poke emitted nothing"; f=1; }
  printf '%s' "$sent" | grep -q 'mesh-speaking' && { echo "  FAIL: poke prompt still tells the mind to touch/rm the self-mute flag"; f=1; }
  printf '%s' "$sent" | grep -q 'mesh-note3-say' || { echo "  FAIL: poke prompt lost the voice verb"; f=1; }
  # The by-name poke carries NO transcript text at all (operator 2026-07-17 "should NOT send any
  # transcript text ... strip the transcript lines out of the nudge payload") — even the trigger line
  # is gone; the mind reads the live transcript itself. Assert the injected ctx line is ABSENT.
  printf '%s' "$sent" | grep -q '\[10:02:00\] Миша, тест' && { echo "  FAIL: name poke still injects a transcript line (operator wants NONE — read-the-transcript instead)"; f=1; }

  # 6b. a CONFIRMED by-name poke is MUST-ANSWER — no "discretion"/"stay silent" opt-out (that opt-out
  #     is exactly how the operator got «слышу» then silence, 2026-07-17). The ambient poke, being a
  #     proactive nicety, MUST keep its discretion. Assert on the two EMITTED prompts.
  printf '%s' "$sent" | grep -qiE 'discretion|stay silent' && { echo "  FAIL: name poke still offers a stay-silent opt-out"; f=1; }
  printf '%s' "$sent" | grep -qi 'waiting on a real reply' || { echo "  FAIL: name poke lost its must-answer framing"; f=1; }
  # 6c. the nudge must be a POINTER to the transcript, not a canned reply against the keyhole window
  #     (operator 2026-07-17 "point you to read the transcript and understand how much context you need").
  printf '%s' "$sent" | grep -q 'room-transcript.txt' || { echo "  FAIL: name poke no longer points the mind at the transcript"; f=1; }
  rm -f "$tmp/poked"; PATH="$tmp:$PATH" poke "ambient" '[10:03:00] погода и дела'
  asent="$(cat "$tmp/poked" 2>/dev/null || echo '')"
  printf '%s' "$asent" | grep -qi 'discretion' || { echo "  FAIL: ambient poke lost its discretion (proactive look-in must stay optional)"; f=1; }
  printf '%s' "$asent" | grep -q 'room-transcript.txt' || { echo "  FAIL: ambient poke no longer points the mind at the transcript"; f=1; }

  # 7. a truncated/garbage lastpoke must not kill the loop with an arithmetic error (it would go
  #    silently deaf — found by this very test harness, 2026-07-14)
  : > "$LASTPOKE"; [ "$(last_poke)" = 0 ] || { echo "  FAIL: empty lastpoke not treated as 'never'"; f=1; }
  printf 'garbage\n' > "$LASTPOKE"; [ "$(last_poke)" = 0 ] || { echo "  FAIL: garbage lastpoke not treated as 'never'"; f=1; }

  # 8. the address gate is wired into tick(): IGNORE stays asleep, WAKE pokes, and a MISSING gate
  #    must still poke (fail open — deafness is never the safe default).
  gate_tick() {  # $1 = gate exit code, or "absent"; echoes "POKED" if tick() woke the mind
    rm -f "$tmp/poked" "$tmp/mesh-room-address"; echo 0 > "$LASTPOKE"
    printf '[11:00:00] предыдущая\n' > "$TRANS"; fresh_lines >/dev/null   # seed anchor
    if [ "$1" != absent ]; then
      printf '#!/usr/bin/env bash\nexit %s\n' "$1" > "$tmp/mesh-room-address"
      chmod +x "$tmp/mesh-room-address"
    fi
    printf '[11:00:30] Миша, глянь\n' >> "$TRANS"
    PATH="$tmp:$PATH" tick
    [ -f "$tmp/poked" ] && echo POKED || echo SILENT
  }
  [ "$(gate_tick 1)" = SILENT ] || { echo "  FAIL: gate said IGNORE but tick() woke the mind anyway"; f=1; }
  [ "$(gate_tick 0)" = POKED ]  || { echo "  FAIL: gate said WAKE but tick() stayed silent"; f=1; }
  [ "$(gate_tick absent)" = POKED ] || { echo "  FAIL: missing gate caused DEAFNESS (must fail open)"; f=1; }

  # 8b. the AMBIENT gate is wired into tick(): a name-free block over the char floor pokes ONLY when
  #     mesh-room-address --ambient exits 0 (REACT); exit 1 (SILENT — the same code a broken/absent
  #     model maps to, fail-closed) stays quiet; ROOM_AMBIENT_GATE=0 keeps the old always-look-in.
  #     Stubbed for hermeticity — the real gemma4 call is exercised by `mesh-room-address --test`,
  #     never here: a reflex --test must not drive an LLM hourly under mesh-doctor.
  amb_block="$(printf 'разговор о погоде и делах %.0s' 1 2 3 4 5 6 7 8)"   # name-free, >140 non-space chars
  amb_tick() {  # $1 = ambient-gate exit code / "off"; echoes POKED | SILENT (stub gate, $tmp on PATH)
    rm -f "$tmp/poked" "$tmp/mesh-room-address"; echo 0 > "$LASTPOKE"
    printf '[14:00:00] предыдущая\n' > "$TRANS"; fresh_lines >/dev/null
    local gate=1
    if [ "$1" = off ]; then gate=0
    else printf '#!/usr/bin/env bash\nexit %s\n' "$1" > "$tmp/mesh-room-address"; chmod +x "$tmp/mesh-room-address"; fi
    printf '[14:00:30] %s\n' "$amb_block" >> "$TRANS"
    PATH="$tmp:$PATH" ROOM_AMBIENT_COOLDOWN=0 ROOM_AMBIENT_GATE="$gate" tick
    [ -f "$tmp/poked" ] && echo POKED || echo SILENT
  }
  [ "$(amb_tick 0)" = POKED ]   || { echo "  FAIL: ambient gate said REACT but tick() did not look in"; f=1; }
  [ "$(amb_tick 1)" = SILENT ]  || { echo "  FAIL: ambient gate said SILENT but tick() poked anyway"; f=1; }
  [ "$(amb_tick off)" = POKED ] || { echo "  FAIL: disabled ambient gate did not keep the old always-look-in behaviour"; f=1; }
  # ABSENT tool → fall back to always-look-in (never regress into silence for a missing deploy). The
  # real mesh-room-address lives in ~/.local/bin (on PATH), so test true absence with a PATH that
  # excludes it — otherwise we'd drive the live gemma4 gate here (which would answer SILENT on chatter).
  rm -f "$tmp/poked"; echo 0 > "$LASTPOKE"
  printf '[14:01:00] предыдущая\n' > "$TRANS"; PATH="$tmp:/usr/bin:/bin" fresh_lines >/dev/null
  printf '[14:01:30] %s\n' "$amb_block" >> "$TRANS"
  PATH="$tmp:/usr/bin:/bin" ROOM_AMBIENT_COOLDOWN=0 ROOM_AMBIENT_GATE=1 tick
  [ -f "$tmp/poked" ] || { echo "  FAIL: absent ambient gate tool did not fall back to always-look-in"; f=1; }

  # 9. THE WAKE-CONFIRMED MINT (2026-07-15, board/room-ear-watcher-up-is-a-pgrep-self-match). This
  #    reflex is now the ONLY minter of ~/.mesh/.room-wake-confirmed — mesh-room reads it to let a
  #    by-name reply skip mesh-misha-gate. Its previous minter (mesh-overhear --watch-wake) ran
  #    nowhere, so that read had never once been true; if this call is dropped, the room silently
  #    goes back to a presence axis that reads never. Assert the REAL invocation via a stubbed
  #    mesh-overhear on PATH, and — because the mint ARMS A SPEAK BYPASS — assert the two ways it
  #    must NOT fire: an ambient look-in, and a line the address gate judged not addressed to us.
  mint_tick() {  # $1 = address-gate exit code / "absent"; echoes what the mint stub recorded
    rm -f "$tmp/poked" "$tmp/minted" "$tmp/mesh-room-address"; echo 0 > "$LASTPOKE"
    printf '[12:00:00] предыдущая\n' > "$TRANS"; fresh_lines >/dev/null
    if [ "$1" != absent ]; then
      printf '#!/usr/bin/env bash\nexit %s\n' "$1" > "$tmp/mesh-room-address"; chmod +x "$tmp/mesh-room-address"
    fi
    printf '[12:00:30] Миша, глянь\n' >> "$TRANS"
    PATH="$tmp:$PATH" tick
    cat "$tmp/minted" 2>/dev/null || echo NOMINT
  }
  case "$(mint_tick 0)" in
    *Миша*) ;;
    *) echo "  FAIL: an addressed by-name call did not mint the wake-confirmed marker (mesh-room's presence read goes back to reading never)"; f=1 ;;
  esac
  [ "$(mint_tick 1)" = NOMINT ] || { echo "  FAIL: the address gate said NOT addressed, yet the mint armed the misha-gate bypass"; f=1; }
  # ambient look-in: enough new speech, no name anywhere → poke is fine, minting is not
  rm -f "$tmp/poked" "$tmp/minted" "$tmp/mesh-room-address"; echo 0 > "$LASTPOKE"
  printf '[12:10:00] предыдущая\n' > "$TRANS"; fresh_lines >/dev/null
  printf '[12:10:30] %s\n' "$(printf 'разговор о погоде и делах %.0s' 1 2 3 4 5 6 7 8)" >> "$TRANS"
  PATH="$tmp:$PATH" ROOM_AMBIENT_COOLDOWN=0 ROOM_AMBIENT_GATE=0 tick   # gate off: these assert mint/ack, not the gate (hermetic — no live gemma4)
  [ ! -f "$tmp/minted" ] || { echo "  FAIL: an AMBIENT look-in minted the wake-confirmed marker — only a by-name call may arm the bypass"; f=1; }

  # 10. THE LISTENING REFLEX (operator 2026-07-17): a by-name address that SURVIVED the gate speaks a
  #     brief "слушаю" from the daemon, so the operator knows his call landed. It rides the exact same
  #     confirmed-wake path as the mint, so the same three negatives must hold: an IGNORE'd line stays
  #     silent, an AMBIENT look-in stays silent, and ROOM_LISTEN_ACK=0 disables it. The ack going out
  #     when the gate said "not addressed" would be the room talking back to a conversation not aimed
  #     at it — the over-speaking the operator measures against.
  ack_tick() {  # $1 = address-gate exit / "absent", $2 = ROOM_LISTEN_ACK; echoes ACKED | SILENT
    rm -f "$tmp/poked" "$tmp/ackspoke" "$tmp/mesh-room-address"; echo 0 > "$LASTPOKE"
    printf '[13:00:00] предыдущая\n' > "$TRANS"; fresh_lines >/dev/null
    if [ "$1" != absent ]; then
      printf '#!/usr/bin/env bash\nexit %s\n' "$1" > "$tmp/mesh-room-address"; chmod +x "$tmp/mesh-room-address"
    fi
    printf '[13:00:30] Миша, слышишь?\n' >> "$TRANS"
    PATH="$tmp:$PATH" ROOM_LISTEN_ACK="$2" tick
    [ -f "$tmp/ackspoke" ] && echo ACKED || echo SILENT
  }
  [ "$(ack_tick 0 1)" = ACKED ]  || { echo "  FAIL: a confirmed by-name address did not speak the listening ack"; f=1; }
  # ...and what it spoke must be one of the configured phrases, not empty
  { rm -f "$tmp/ackspoke"; ack_tick 0 1 >/dev/null; sp="$(cat "$tmp/ackspoke" 2>/dev/null)"; }
  { [ -n "$sp" ] && printf '%s\n' "${ACK_PHRASES[@]}" | grep -qxF "$sp"; } \
    || { echo "  FAIL: listening ack spoke an empty or unexpected phrase: '$sp'"; f=1; }
  # the configured phrase set itself must carry no empty entry — an empty ack is a silent no-op that
  # reads as "spoke" (a default indistinguishable from success is one)
  for p in "${ACK_PHRASES[@]}"; do [ -n "$p" ] || { echo "  FAIL: ACK_PHRASES contains an empty phrase"; f=1; }; done
  [ "$(ack_tick 1 1)" = SILENT ] || { echo "  FAIL: the gate said NOT addressed, yet the listening ack spoke into the room"; f=1; }
  [ "$(ack_tick 0 0)" = SILENT ] || { echo "  FAIL: ROOM_LISTEN_ACK=0 did not disable the listening ack"; f=1; }
  # ambient look-in must never ack (no name → nothing addressed to confirm)
  rm -f "$tmp/poked" "$tmp/ackspoke" "$tmp/mesh-room-address"; echo 0 > "$LASTPOKE"
  printf '[13:10:00] предыдущая\n' > "$TRANS"; fresh_lines >/dev/null
  printf '[13:10:30] %s\n' "$(printf 'разговор о погоде и делах %.0s' 1 2 3 4 5 6 7 8)" >> "$TRANS"
  PATH="$tmp:$PATH" ROOM_AMBIENT_COOLDOWN=0 ROOM_AMBIENT_GATE=0 tick   # gate off: these assert mint/ack, not the gate (hermetic — no live gemma4)
  [ ! -f "$tmp/ackspoke" ] || { echo "  FAIL: an AMBIENT look-in spoke the listening ack — only a by-name address may"; f=1; }

  [ "$f" = 0 ] && echo "  PASS: per-line tracking, prune-safe, no replay, name precise, name-gate fails open, ambient-gate fails closed, mint + listening-ack only on an addressed by-name call" || exit 1
  exit 0
fi

while :; do
  tick
  sleep "${ROOM_REFLEX_EVERY:-2}"   # 2s (was 5): the listening-ack must feel prompt — a 5s poll alone
                                     # added up to 5s on top of note3-say before the operator heard «слушаю»
done
