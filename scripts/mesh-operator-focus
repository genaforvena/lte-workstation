#!/usr/bin/env bash
# mesh-operator-focus — 4-INPUT NODE-STATE FUSION: keyboard + screen + PSI + thermal →
# a single verdict about what the node (and its operator) is doing right now.
#
# Inputs (all node-side, read from existing state files — no re-sensing):
#   kbd   — keyboard activity (mesh-kbd-activity → .kbd-activity.state: IDLE|LIGHT|TYPING)
#   scr   — screen state      (mesh-screen-state → .screen-state.state: OFF|DIM|NORMAL|BRIGHT)
#   psi   — resource pressure  (mesh-psi         → .psi.state: CALM|BUSY|STALLED|<dom>)
#   therm — thermal state      (mesh-therm-watch → .therm-state: OK|HOT)
#   gpu   — iGPU busy (AUXILIARY lift input, 2026-07-02: mesh-gpu-activity →
#           .gpu-activity-state: IDLE|LIGHT|BUSY). Passive-presence evidence keypresence
#           can't see: video/media wakes the GPU with ZERO keypresses. A fresh BUSY lifts a
#           clean IDLE to WORKING (gpu_lift); it never masks DEGRADED, never counts toward
#           the reachable gate (find: capability-igpu-activity-20260702.md).
#   usb   — wired plug/unplug event (AUXILIARY lift input, 2026-07-02: mesh-usb-events →
#           .usb-events-state: ATTACH|DETACH|QUIET|BLIND). A plug/unplug is a DELIBERATE
#           physical act at the machine — discrete presence evidence; a fresh ATTACH/DETACH
#           lifts a clean IDLE to WORKING (usb_lift), decaying naturally when the reflex's
#           next pass rewrites QUIET. Same discipline as gpu: never masks DEGRADED, never in
#           the reachable gate (find: capability-usb-attach-events-20260702.md).
#
# Fused verdicts:
#   FOCUSED   — keyboard TYPING + screen ON → operator actively working
#   WORKING   — screen ON but keyboard IDLE → reading / watching / passive use
#   STRESSED  — PSI STALLED or thermal HOT → node under resource or thermal pressure
#   IDLE      — all inputs calm → node is quiet
#   DEGRADED  — 1+ inputs unreachable when the quiet path would otherwise look like a clean IDLE
#               or 2+ inputs unreachable → can't assess honestly
#
# Workspace fusion:
#   room occupancy from mesh-room-sense adds a second axis to the attention read:
#   ON-DESK-FOCUSED / REMOTE-DESK-FOCUSED / IN-ROOM-IDLE / DEGRADED:room-unreachable.
#
# UNREACHABLE inputs render as "UNREACHABLE" in the breakdown — never silently cleared.
# A single unreachable input downgrades confidence but does NOT force DEGRADED.
#
# Usage:
#   mesh-operator-focus              one-line verdict
#   mesh-operator-focus --json       machine-readable {verdict, inputs:{...}, ts}
#   mesh-operator-focus --dry        print row that WOULD be written, don't touch state
#   mesh-operator-focus --test       smoke test (synthetic fixtures, no live sensors)
#   mesh-operator-focus --edge       emit only on verdict change (2-consecutive debounce)
#
# Exit codes:
#   0 = assessment produced (IDLE is a real assessment, not an error)
#   2 = fewer than 2 inputs reachable — can't fuse honestly
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
STATE_FILE="$MESH/.operator-focus.state"
PENDING="${STATE_FILE%.state}.pending"
ROOM_STATE="$MESH/.room-sense.state"
ROOM_LOG="$MESH/room-sense.log"

# --- Read one sense's verdict from its state file ---
# Returns the verdict string or "UNREACHABLE" if the file is missing/empty/stale.
# Staleness: if the state file's mtime is older than MAX_STALE_S, check the log file
# as a fallback (the sense cron may run but only write state on verdict change via --edge).
# If the log file is fresh, the sense is alive — use the state file value.
# Args: state_file [log_file] [max_stale_s]
MAX_STALE_S="${MESH_FOCUS_STALE_S:-600}"   # 10 min

read_sense() {
  local file="$1" logfile="${2:-}" max_age="${3:-$MAX_STALE_S}"
  [ -f "$file" ] || { echo "UNREACHABLE"; return; }
  local mt age
  mt="$(stat -c %Y "$file" 2>/dev/null || echo 0)"
  age=$(( $(date +%s) - mt ))
  if [ "$age" -gt "$max_age" ]; then
    # State file stale — check if the sense's log file is fresh (sense is alive, just edge-suppressed)
    if [ -n "$logfile" ] && [ -f "$logfile" ]; then
      local lmt lage
      lmt="$(stat -c %Y "$logfile" 2>/dev/null || echo 0)"
      lage=$(( $(date +%s) - lmt ))
      [ "$lage" -le "$max_age" ] || { echo "UNREACHABLE"; return; }
    else
      echo "UNREACHABLE"; return
    fi
  fi
  local val
  val="$(head -1 "$file" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$val" ] && echo "$val" || echo "UNREACHABLE"
}

# --- Fusion classifier (pure logic, exercised by --test) ---
# Args: kbd_verdict scr_verdict psi_verdict therm_verdict
# Echoes: VERDICT|confidence|reason
classify() {
  local kbd="$1" scr="$2" psi="$3" therm="$4"
  local unreachable=0
  local missing=""
  case "$kbd" in  UNREACHABLE) unreachable=$((unreachable+1));; esac
  case "$scr" in  UNREACHABLE) unreachable=$((unreachable+1));; esac
  case "$psi" in  UNREACHABLE) unreachable=$((unreachable+1));; esac
  case "$therm" in UNREACHABLE) unreachable=$((unreachable+1));; esac
  [ "$kbd" = "UNREACHABLE" ] && missing="${missing:+$missing,}kbd"
  [ "$scr" = "UNREACHABLE" ] && missing="${missing:+$missing,}screen"
  [ "$psi" = "UNREACHABLE" ] && missing="${missing:+$missing,}psi"
  [ "$therm" = "UNREACHABLE" ] && missing="${missing:+$missing,}therm"

  # DEGRADED: 2+ inputs unreachable → can't assess honestly
  if [ "$unreachable" -ge 2 ]; then
    echo "DEGRADED|low|${unreachable}/4 inputs unreachable: missing=$missing"; return
  fi

  # STRESSED: thermal HOT or PSI STALLED (override focus/idle)
  if [ "$therm" = "HOT" ]; then
    echo "STRESSED|medium|thermal=HOT"; return
  fi
  # STRESSED: PSI STALLED (override focus/idle)
  case "$psi" in STALLED*) echo "STRESSED|medium|psi=$psi"; return;; esac

  # FOCUSED: keyboard TYPING + screen ON
  if [ "$kbd" = "TYPING" ] && [[ "$scr" =~ ^(DIM|NORMAL|BRIGHT)$ ]]; then
    echo "FOCUSED|high|kbd=TYPING scr=$scr"; return
  fi

  # WORKING: screen ON but keyboard not TYPING (reading / watching / passive use)
  if [[ "$scr" =~ ^(DIM|NORMAL|BRIGHT)$ ]]; then
    echo "WORKING|medium|scr=$scr kbd=$kbd"; return
  fi

  # IDLE: everything quiet — but a missing input must not collapse to a clean all-clear.
  if [ "$unreachable" -ge 1 ]; then
    echo "DEGRADED|low|quiet-but-blind: missing=$missing"; return
  fi
  echo "IDLE|high|kbd=$kbd scr=$scr psi=$psi therm=$therm"
}

gpu_lift() { # $1=verdict $2=gpu — a fresh BUSY iGPU read lifts a clean IDLE to WORKING (passive
  # screen-use/video with zero keypresses — the keypresence blind spot). ONLY IDLE lifts, ONLY on
  # BUSY: LIGHT never changes a verdict (a mind-driven browser can wake the GPU lightly with no
  # operator); STRESSED/FOCUSED/WORKING/DEGRADED are never touched (DEGRADED stays honest — GPU
  # evidence does not restore missing inputs).
  if [ "$1" = IDLE ] && [ "$2" = BUSY ]; then echo WORKING; else echo "$1"; fi
}

usb_lift() { # $1=verdict $2=usb — a fresh plug/unplug EVENT lifts a clean IDLE to WORKING: someone
  # physically attached/removed a device at this machine (deliberate act, not passive residue).
  # ONLY IDLE lifts, ONLY on ATTACH/DETACH: QUIET/BLIND/UNREACHABLE are not presence; STRESSED/
  # FOCUSED/WORKING/DEGRADED are never touched (same never-mask discipline as gpu_lift).
  case "$1:$2" in IDLE:ATTACH|IDLE:DETACH) echo WORKING;; *) echo "$1";; esac
}

derive_workspace_mode() {
  local verdict="$1" room="$2"
  case "$room" in
    UNREACHABLE) printf 'DEGRADED:room-unreachable'; return ;;
    UNAVAILABLE)  printf 'DEGRADED:room-unavailable'; return ;;
  esac
  case "$verdict:$room" in
    FOCUSED:PRESENT)
      printf 'ON-DESK-FOCUSED';;
    FOCUSED:EMPTY)
      printf 'REMOTE-DESK-FOCUSED';;
    WORKING:PRESENT)
      printf 'IN-ROOM-WORKING';;
    WORKING:EMPTY)
      printf 'REMOTE-WORKING';;
    IDLE:PRESENT)
      printf 'IN-ROOM-IDLE';;
    IDLE:EMPTY)
      printf 'AWAY';;
    STRESSED:PRESENT)
      printf 'IN-ROOM-STRESSED';;
    STRESSED:EMPTY)
      printf 'REMOTE-STRESSED';;
    DEGRADED:*)
      printf 'DEGRADED:%s' "$room";;
    UNKNOWN:PRESENT)
      printf 'IN-ROOM-NEARBY';;
    UNKNOWN:EMPTY)
      printf 'AWAY';;
    *)
      printf '%s_%s' "$verdict" "$room";;
  esac
}

# --- Smoke test ---
if [ "${1:-}" = --test ]; then
  for dep in python3 date stat head; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; exit 1; }
  done
  _f=0

  # FOCUSED: typing + screen on
  r="$(classify TYPING NORMAL CALM OK)"; v="${r%%|*}"
  [ "$v" = "FOCUSED" ] || { echo "  FAIL: TYPING+NORMAL → $v (expected FOCUSED)"; _f=1; }

  # FOCUSED: typing + bright screen
  r="$(classify TYPING BRIGHT CALM OK)"; v="${r%%|*}"
  [ "$v" = "FOCUSED" ] || { echo "  FAIL: TYPING+BRIGHT → $v (expected FOCUSED)"; _f=1; }

  # WORKING: screen on, keyboard idle
  r="$(classify IDLE NORMAL CALM OK)"; v="${r%%|*}"
  [ "$v" = "WORKING" ] || { echo "  FAIL: IDLE+NORMAL → $v (expected WORKING)"; _f=1; }

  # WORKING: screen dim, keyboard light
  r="$(classify LIGHT DIM CALM OK)"; v="${r%%|*}"
  [ "$v" = "WORKING" ] || { echo "  FAIL: LIGHT+DIM → $v (expected WORKING)"; _f=1; }

  # IDLE: everything quiet
  r="$(classify IDLE OFF CALM OK)"; v="${r%%|*}"
  [ "$v" = "IDLE" ] || { echo "  FAIL: IDLE+OFF+CALM+OK → $v (expected IDLE)"; _f=1; }

  # DEGRADED: a missing input must not look like a clean IDLE
  r="$(classify UNREACHABLE OFF CALM OK)"; v="${r%%|*}"
  [ "$v" = "DEGRADED" ] || { echo "  FAIL: UNREACHABLE+OFF+CALM+OK → $v (expected DEGRADED)"; _f=1; }
  echo "$r" | grep -q 'quiet-but-blind' || { echo "  FAIL: DEGRADED should explain quiet-but-blind got=$r"; _f=1; }

  # STRESSED: thermal HOT overrides focus
  r="$(classify TYPING NORMAL CALM HOT)"; v="${r%%|*}"
  [ "$v" = "STRESSED" ] || { echo "  FAIL: TYPING+NORMAL+HOT → $v (expected STRESSED)"; _f=1; }

  # STRESSED: PSI STALLED overrides idle
  r="$(classify IDLE OFF "STALLED|cpu" OK)"; v="${r%%|*}"
  [ "$v" = "STRESSED" ] || { echo "  FAIL: IDLE+OFF+STALLED|cpu → $v (expected STRESSED)"; _f=1; }

  # DEGRADED: 2+ unreachable
  r="$(classify UNREACHABLE UNREACHABLE CALM OK)"; v="${r%%|*}"
  [ "$v" = "DEGRADED" ] || { echo "  FAIL: 2xUNREACHABLE → $v (expected DEGRADED)"; _f=1; }

  # DEGRADED: 3 unreachable
  r="$(classify UNREACHABLE UNREACHABLE UNREACHABLE OK)"; v="${r%%|*}"
  [ "$v" = "DEGRADED" ] || { echo "  FAIL: 3xUNREACHABLE → $v (expected DEGRADED)"; _f=1; }

  # 1 unreachable + valid = still assessable (not degraded)
  r="$(classify TYPING NORMAL UNREACHABLE OK)"; v="${r%%|*}"
  [ "$v" = "FOCUSED" ] || { echo "  FAIL: TYPING+NORMAL+UNREACHABLE+OK → $v (expected FOCUSED)"; _f=1; }

  # IDLE: screen OFF + keyboard IDLE + PSI CALM
  r="$(classify IDLE OFF BUSY OK)"; v="${r%%|*}"
  [ "$v" = "IDLE" ] || { echo "  FAIL: IDLE+OFF+BUSY+OK → $v (expected IDLE, screen off)"; _f=1; }

  # IDLE with screen off
  r="$(classify IDLE OFF CALM HOT)"; v="${r%%|*}"
  [ "$v" = "STRESSED" ] || { echo "  FAIL: IDLE+OFF+CALM+HOT → $v (expected STRESSED)"; _f=1; }

  # Workspace fusion: room occupancy makes a richer label than attention alone.
  r="$(derive_workspace_mode FOCUSED PRESENT)"
  [ "$r" = "ON-DESK-FOCUSED" ] || { echo "  FAIL: AT-DESK+PRESENT+HEADPHONES → $r (expected ON-DESK-FOCUSED)"; _f=1; }
  r="$(derive_workspace_mode FOCUSED EMPTY)"
  [ "$r" = "REMOTE-DESK-FOCUSED" ] || { echo "  FAIL: AT-DESK+EMPTY+HEADPHONES → $r (expected REMOTE-DESK-FOCUSED)"; _f=1; }
  r="$(derive_workspace_mode FOCUSED UNREACHABLE)"
  [ "$r" = "DEGRADED:room-unreachable" ] || { echo "  FAIL: AT-DESK+UNREACHABLE+HEADPHONES → $r (expected DEGRADED:room-unreachable)"; _f=1; }

  # gpu_lift: only a clean IDLE + fresh BUSY lifts; everything else is untouched
  r="$(gpu_lift IDLE BUSY)"
  [ "$r" = "WORKING" ] || { echo "  FAIL: gpu_lift IDLE+BUSY → $r (expected WORKING)"; _f=1; }
  r="$(gpu_lift IDLE LIGHT)"
  [ "$r" = "IDLE" ] || { echo "  FAIL: gpu_lift IDLE+LIGHT → $r (LIGHT must never lift)"; _f=1; }
  r="$(gpu_lift IDLE UNREACHABLE)"
  [ "$r" = "IDLE" ] || { echo "  FAIL: gpu_lift IDLE+UNREACHABLE → $r (unknown is not presence)"; _f=1; }
  r="$(gpu_lift DEGRADED BUSY)"
  [ "$r" = "DEGRADED" ] || { echo "  FAIL: gpu_lift DEGRADED+BUSY → $r (must not mask blindness)"; _f=1; }
  r="$(gpu_lift STRESSED BUSY)"
  [ "$r" = "STRESSED" ] || { echo "  FAIL: gpu_lift STRESSED+BUSY → $r (pressure wins)"; _f=1; }
  r="$(gpu_lift WORKING BUSY)"
  [ "$r" = "WORKING" ] || { echo "  FAIL: gpu_lift WORKING+BUSY → $r (no-op expected)"; _f=1; }

  # usb_lift: a fresh plug/unplug event lifts a clean IDLE only; nothing else moves
  r="$(usb_lift IDLE ATTACH)"
  [ "$r" = "WORKING" ] || { echo "  FAIL: usb_lift IDLE+ATTACH → $r (expected WORKING)"; _f=1; }
  r="$(usb_lift IDLE DETACH)"
  [ "$r" = "WORKING" ] || { echo "  FAIL: usb_lift IDLE+DETACH → $r (unplug is equally deliberate)"; _f=1; }
  r="$(usb_lift IDLE QUIET)"
  [ "$r" = "IDLE" ] || { echo "  FAIL: usb_lift IDLE+QUIET → $r (no event, no lift)"; _f=1; }
  r="$(usb_lift IDLE BLIND)"
  [ "$r" = "IDLE" ] || { echo "  FAIL: usb_lift IDLE+BLIND → $r (blind bus is not presence)"; _f=1; }
  r="$(usb_lift IDLE UNREACHABLE)"
  [ "$r" = "IDLE" ] || { echo "  FAIL: usb_lift IDLE+UNREACHABLE → $r (unknown is not presence)"; _f=1; }
  r="$(usb_lift DEGRADED ATTACH)"
  [ "$r" = "DEGRADED" ] || { echo "  FAIL: usb_lift DEGRADED+ATTACH → $r (must not mask blindness)"; _f=1; }
  r="$(usb_lift STRESSED DETACH)"
  [ "$r" = "STRESSED" ] || { echo "  FAIL: usb_lift STRESSED+DETACH → $r (pressure wins)"; _f=1; }

  # Live path: verify state files exist (at least 2 of 4 plus optional room state)
  _live=0
  [ -f "$MESH/.kbd-activity.state" ] && _live=$((_live+1))
  [ -f "$MESH/.screen-state.state" ] && _live=$((_live+1))
  [ -f "$MESH/.psi.state" ] && _live=$((_live+1))
  [ -f "$MESH/.therm-state" ] && _live=$((_live+1))
  [ "$_live" -ge 2 ] || { echo "smoke-test: FAIL (only $_live/4 state files present)"; exit 1; }

  [ "$_f" = 0 ] || { echo "smoke-test: FAIL ($_f assertion(s))"; exit 1; }
  echo "smoke-test: ok (classify: 13 fusion paths + room fusion + 6 gpu-lift + 7 usb-lift cases + live:$_live/4 state files present)"
  exit 0
fi

# --- Read inputs ---
kbd="$(read_sense "$MESH/.kbd-activity.state" "$MESH/kbd-activity.log")"
scr="$(read_sense "$MESH/.screen-state.state" "$MESH/screen-state.log")"
psi="$(read_sense "$MESH/.psi.state" "$MESH/psi.log")"
therm="$(read_sense "$MESH/.therm-state" "$MESH/therm-watch.log")"
room_raw="$(read_sense "$ROOM_STATE" "$ROOM_LOG")"
room="$(printf '%s' "$room_raw" | cut -d'|' -f1)"
# gpu (auxiliary): state row is "LEVEL busy% freqMHz"; read_sense squashes whitespace, so the
# level is the leading caps run (IDLE/LIGHT/BUSY — or UNREACHABLE from read_sense itself).
gpu_raw="$(read_sense "$MESH/.gpu-activity-state" "$MESH/gpu.log")"
gpu="$(printf '%s' "$gpu_raw" | grep -oE '^[A-Z]+' || echo UNREACHABLE)"
# usb (auxiliary): state row is "TOKEN a/d total ..."; leading caps run = ATTACH|DETACH|QUIET|BLIND.
usb_raw="$(read_sense "$MESH/.usb-events-state" "$MESH/usb-attach.log")"
usb="$(printf '%s' "$usb_raw" | grep -oE '^[A-Z]+' || echo UNREACHABLE)"

# Count reachable inputs
reachable=0
for v in "$kbd" "$scr" "$psi" "$therm" "$room"; do
  [ "$v" != "UNREACHABLE" ] && reachable=$((reachable+1))
done

# Less than 2 reachable → can't fuse honestly
[ "$reachable" -ge 2 ] || {
  echo "mesh-operator-focus: DEGRADED — only $reachable/5 inputs reachable" >&2
  exit 2
}

# --- Classify ---
fused="$(classify "$kbd" "$scr" "$psi" "$therm")"
verdict="${fused%%|*}"
rest="${fused#*|}"
confidence="${rest%%|*}"
reason="${rest#*|}"
# auxiliary gpu lift AFTER the core 4-input fusion: a fresh BUSY iGPU turns a clean IDLE into
# WORKING (passive use). gpu is NOT counted in the reachable gate — verdict vocab unchanged.
lifted="$(gpu_lift "$verdict" "$gpu")"
if [ "$lifted" != "$verdict" ]; then
  verdict="$lifted"; confidence=medium; reason="gpu=BUSY(passive↑) $reason"
fi
# auxiliary usb lift, same contract: a fresh plug/unplug event turns a clean IDLE into WORKING.
ulifted="$(usb_lift "$verdict" "$usb")"
if [ "$ulifted" != "$verdict" ]; then
  verdict="$ulifted"; confidence=medium; reason="usb=$usb(plug↑) $reason"
fi
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
workspace_mode="$(derive_workspace_mode "$verdict" "$room")"

# --- Output ---
MODE=text; [ "${1:-}" = --json ] && MODE=json
DRY=0;     [ "${1:-}" = --dry ] && DRY=1
EDGE=0;    [ "${1:-}" = --edge ] && EDGE=1

row="$(printf 'kbd=%s scr=%s psi=%s therm=%s room=%s gpu=%s usb=%s → %s (%s) [%s] workspace=%s' \
  "$kbd" "$scr" "$psi" "$therm" "$room" "$gpu" "$usb" "$verdict" "$confidence" "$reason" "$workspace_mode")"

if [ "$MODE" = json ]; then
  printf '{"verdict":"%s","confidence":"%s","reason":"%s","workspace_mode":"%s","inputs":{"kbd":"%s","scr":"%s","psi":"%s","therm":"%s","room":"%s","gpu":"%s","usb":"%s"},"reachable":%d,"ts":"%s"}\n' \
    "$verdict" "$confidence" "$reason" "$workspace_mode" "$kbd" "$scr" "$psi" "$therm" "$room" "$gpu" "$usb" "$reachable" "$ts"
  exit 0
fi

if [ "$DRY" = 1 ]; then
  printf '%s\n' "$row"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  confirmed="$(cat "$STATE_FILE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$verdict" > "$STATE_FILE"; rm -f "$PENDING"
  elif [ "$verdict" = "$confirmed" ]; then
    rm -f "$PENDING"
    # value unchanged — the liveness mtime refresh happens in the unconditional touch below (so it
    # covers the pending/debounce branches too, not only this one — see comment at the touch).
  elif [ "$verdict" = "$pending" ]; then
    pcount=$(( pcount + 1 ))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$verdict" > "$STATE_FILE"; rm -f "$PENDING"
      printf '[operator-focus] %s — %s\n' "$verdict" "$row"
    else
      printf '%s:%d\n' "$verdict" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$verdict" > "$PENDING"
  fi
  # LIVENESS (2026-06-24): touch .operator-focus.state on EVERY --edge run, in every branch — the
  # mtime must track last-RUN, not last-COMMIT. The value-debounce above (pending needs 2 confirms)
  # is correct for the CONTENT, but it meant a CHANGING/flapping verdict (common here: kbd/psi inputs
  # intermittently UNREACHABLE → verdict oscillates DEGRADED↔STRESSED, never 2-in-a-row) left STATE
  # untouched indefinitely → artifact froze → reflex-health false-DEAD (the half-applied touch-every-run
  # gap; before, only the unchanged branch refreshed mtime). Value still debounced; only liveness ticks.
  [ -e "$STATE_FILE" ] && touch "$STATE_FILE" 2>/dev/null || true
  exit 0
fi

printf '[operator-focus] %s — %s\n' "$verdict" "$row"
