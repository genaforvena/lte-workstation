#!/usr/bin/env bash
# reflex-cadence: 1-59/5 * * * *
# reflex-args: --edge
# mesh-operator-focus — OPERATOR FOCUS STATE: fuses keyboard activity + session complexity
# + network traffic into what kind of work is happening right now.
# All 3 inputs are IdeaPad-local — no phone, no SSH.  Each unreachable input renders
# UNKNOWN (never silently OK); ≥2 signals UNKNOWN → exit 2 (cannot assess, not all-clear).
#
#   mesh-operator-focus           one-shot
#   mesh-operator-focus --json    machine-readable
#   mesh-operator-focus --edge    emit only on state change (2-consecutive debounce)
#   mesh-operator-focus --test    smoke test
#
# Inputs (all local, no phone dependency):
#   kbd      ~/.mesh/.kbd-activity.state    IDLE / LIGHT / TYPING
#   session  ~/.mesh/.ambient-clock.state   QUIET / ACTIVE / BUSY  (tmux-window proxy)
#   net      ~/.mesh/.net-io.state          LOW / MED / HIGH       (primary iface rx+tx/s)
#
# Derived states (no single sense gives these):
#   FOCUSED      TYPING kbd (non-HIGH net)          → deep work / coding / writing
#   VIDEO_CALL   TYPING or LIGHT kbd + HIGH net     → video conference
#   BROWSING     LIGHT kbd (non-HIGH net)           → web / light reading
#   STREAMING    IDLE kbd + HIGH net                → music/video (operator passive)
#   BACKGROUND   IDLE kbd + MED net + QUIET session → sync/download, no operator
#   ACTIVE_IDLE  IDLE kbd + ACTIVE/BUSY session     → windows open but not working
#   MACHINE_IDLE IDLE kbd + QUIET session + LOW net → node at rest
#   DEGRADED     kbd UNKNOWN (primary signal missing but others known)
#
# Exit codes (honest-exit contract):
#   0  = state assessed (MACHINE_IDLE and DEGRADED are valid real findings)
#   2  = kbd UNKNOWN AND (net or session also UNKNOWN) — too degraded to assess
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_FOCUS_MESH:-$HOME/.mesh}"
STATE="${MESH_FOCUS_STATE:-$MESH/.operator-focus.state}"

# --- Pure classification function (extracted for testability) ---
# Usage: classify_focus KBD SESSION NET
# Echoes the derived state; return 2 = too degraded to assess
classify_focus() {
  local k="$1" s="$2" n="$3"

  # kbd is the primary discriminator.  Without it and at least one other signal, exit 2.
  if [ "$k" = "UNKNOWN" ]; then
    if [ "$n" = "UNKNOWN" ] || [ "$s" = "UNKNOWN" ]; then
      return 2  # both primary axes unknown → caller should exit 2
    fi
    echo "DEGRADED"; return 0
  fi

  # Conservative fallback for missing secondary signals
  local ne="$n"; [ "$ne" = "UNKNOWN" ] && ne="LOW"
  local se="$s"; [ "$se" = "UNKNOWN" ] && se="QUIET"

  if   [ "$k" = "TYPING" ] && [ "$ne" = "HIGH" ]; then                                  echo "VIDEO_CALL"
  elif [ "$k" = "TYPING" ];                        then                                  echo "FOCUSED"
  elif [ "$k" = "LIGHT"  ] && [ "$ne" = "HIGH" ]; then                                  echo "VIDEO_CALL"
  elif [ "$k" = "LIGHT"  ];                        then                                  echo "BROWSING"
  elif [ "$k" = "IDLE"   ] && [ "$ne" = "HIGH" ]; then                                  echo "STREAMING"
  elif [ "$k" = "IDLE"   ] && [ "$ne" = "MED"  ] && [ "$se" = "QUIET" ]; then          echo "BACKGROUND"
  elif [ "$k" = "IDLE"   ] && { [ "$se" = "ACTIVE" ] || [ "$se" = "BUSY" ]; }; then    echo "ACTIVE_IDLE"
  else                                                                                    echo "MACHINE_IDLE"
  fi
  return 0
}

# --- Smoke test ---
if [ "${1:-}" = --test ]; then
  fail=0
  # Classification assertions (FALSIFIABLE: change any branch → assertion fails)
  [ "$(classify_focus TYPING ACTIVE  LOW )" = "FOCUSED"      ] || { echo "  FAIL: TYPING+ACTIVE+LOW → FOCUSED";     fail=1; }
  [ "$(classify_focus TYPING BUSY    MED )" = "FOCUSED"      ] || { echo "  FAIL: TYPING+BUSY+MED → FOCUSED";       fail=1; }
  [ "$(classify_focus TYPING QUIET   HIGH)" = "VIDEO_CALL"   ] || { echo "  FAIL: TYPING+QUIET+HIGH → VIDEO_CALL";  fail=1; }
  [ "$(classify_focus LIGHT  ACTIVE  HIGH)" = "VIDEO_CALL"   ] || { echo "  FAIL: LIGHT+ACTIVE+HIGH → VIDEO_CALL";  fail=1; }
  [ "$(classify_focus LIGHT  QUIET   MED )" = "BROWSING"     ] || { echo "  FAIL: LIGHT+QUIET+MED → BROWSING";      fail=1; }
  [ "$(classify_focus LIGHT  BUSY    LOW )" = "BROWSING"     ] || { echo "  FAIL: LIGHT+BUSY+LOW → BROWSING";       fail=1; }
  [ "$(classify_focus IDLE   QUIET   HIGH)" = "STREAMING"    ] || { echo "  FAIL: IDLE+QUIET+HIGH → STREAMING";     fail=1; }
  [ "$(classify_focus IDLE   QUIET   MED )" = "BACKGROUND"   ] || { echo "  FAIL: IDLE+QUIET+MED → BACKGROUND";     fail=1; }
  [ "$(classify_focus IDLE   ACTIVE  LOW )" = "ACTIVE_IDLE"  ] || { echo "  FAIL: IDLE+ACTIVE+LOW → ACTIVE_IDLE";  fail=1; }
  [ "$(classify_focus IDLE   QUIET   LOW )" = "MACHINE_IDLE" ] || { echo "  FAIL: IDLE+QUIET+LOW → MACHINE_IDLE";  fail=1; }
  # DEGRADED: kbd UNKNOWN alone → state=DEGRADED exit 0
  [ "$(classify_focus UNKNOWN ACTIVE MED)" = "DEGRADED"      ] || { echo "  FAIL: UNKNOWN+ACTIVE+MED → DEGRADED";  fail=1; }
  # exit 2: kbd UNKNOWN + net UNKNOWN (both primary axes missing)
  classify_focus UNKNOWN ACTIVE UNKNOWN; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: UNKNOWN+ACTIVE+UNKNOWN should return 2 (got $rc)"; fail=1; }
  # exit 2: kbd UNKNOWN + session UNKNOWN
  classify_focus UNKNOWN UNKNOWN LOW; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: UNKNOWN+UNKNOWN+LOW should return 2 (got $rc)";   fail=1; }
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # Live state-file availability
  missing=0
  [ -f "$MESH/.kbd-activity.state"   ] || { echo "  warn: .kbd-activity.state missing";   missing=$(( missing + 1 )); }
  [ -f "$MESH/.ambient-clock.state"  ] || { echo "  warn: .ambient-clock.state missing";  missing=$(( missing + 1 )); }
  [ -f "$MESH/.net-io.state"         ] || { echo "  warn: .net-io.state missing";         missing=$(( missing + 1 )); }
  if [ "$missing" -ge 2 ]; then
    echo "smoke-test: n/a ($missing/3 state files missing — fusion not viable)"; exit 2
  fi
  echo "smoke-test: ok (13 classify assertions; $missing/3 state files absent)"; exit 0
fi

# --- Read signals from state files ---
kbd="UNKNOWN"
[ -f "$MESH/.kbd-activity.state" ] && kbd="$(cat "$MESH/.kbd-activity.state" 2>/dev/null || echo UNKNOWN)"

session="UNKNOWN"
[ -f "$MESH/.ambient-clock.state" ] && session="$(cat "$MESH/.ambient-clock.state" 2>/dev/null || echo UNKNOWN)"

net="UNKNOWN"
if [ -f "$MESH/.net-io.state" ]; then
  # Match primary interface: any wlp/wlan/eth/ens/enp/eno line with rx= and tx= fields
  iface_line="$(grep -E 'rx=[0-9]+ tx=[0-9]+' "$MESH/.net-io.state" 2>/dev/null \
    | grep -vE '^(tailscale|lo|docker|veth|br-)' | head -1)"
  if [ -n "$iface_line" ]; then
    rx="$(printf '%s' "$iface_line" | grep -oE 'rx=[0-9]+' | cut -d= -f2)"
    tx="$(printf '%s' "$iface_line" | grep -oE 'tx=[0-9]+' | cut -d= -f2)"
    total=$(( ${rx:-0} + ${tx:-0} ))
    if   [ "$total" -ge 1000000 ]; then net="HIGH"   # ≥1MB/s  — streaming-class
    elif [ "$total" -ge   50000 ]; then net="MED"    # ≥50KB/s — active browsing/sync
    else                                net="LOW"     # <50KB/s — idle/background
    fi
  fi
fi

# --- Classify ---
state="$(classify_focus "$kbd" "$session" "$net")"; cf_rc=$?
if [ "$cf_rc" = 2 ]; then
  echo "operator-focus: kbd+secondary both unknown — too degraded to assess" >&2
  exit 2
fi

TS=$(date -u +%H:%M:%SZ)
signals="kbd=${kbd} session=${session} net=${net}"
degraded=""
[ "$kbd"     = "UNKNOWN" ] && degraded="${degraded:+$degraded,}kbd-unknown"
[ "$session" = "UNKNOWN" ] && degraded="${degraded:+$degraded,}session-unknown"
[ "$net"     = "UNKNOWN" ] && degraded="${degraded:+$degraded,}net-unknown"
[ -z "$degraded" ] && degraded="none"

mkdir -p "$MESH" 2>/dev/null || true

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0;    [ "${1:-}" = --edge ] && EDGE=1

if [ "$MODE" = json ]; then
  printf '{"state":"%s","signals":"%s","degraded":"%s","ts":"%s"}\n' \
    "$state" "$signals" "$degraded" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$state" > "$STATE"; rm -f "$PENDING"
  elif [ "$state" = "$confirmed" ]; then
    rm -f "$PENDING"
    touch "$STATE" 2>/dev/null || true   # mtime = last-run, not last-change
  elif [ "$state" = "$pending" ]; then
    pcount=$(( pcount + 1 ))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$state" > "$STATE"; rm -f "$PENDING"
      printf '[operator-focus] %s — %s | %s\n' "$state" "$degraded" "$signals"
    else
      printf '%s:%d\n' "$state" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$state" > "$PENDING"
  fi
  exit 0
fi

printf '[operator-focus] %s — degraded=%s | %s\n' "$state" "$degraded" "$signals"
