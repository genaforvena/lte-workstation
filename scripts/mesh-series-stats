#!/usr/bin/env bash
# mesh-series-stats — order statistics over a live series, decided by a ROM.
#
# The ROM (series-stats.tal) owns the reduction and its domain: given a threshold, n, and
# n non-decreasing integers it answers "min max med2 cnt sum mean1000", or "NA" rc=2
# outside its range. SORTING is the HOST's job and stays here, the same split as
# mesh-spearman, where the host owns ranking and the ROM owns the formula.
#
# WHY IT EXISTS: the doctrine's standing quantitative claims are order statistics over
# ~/.mesh/records.log, and every one of them was QUOTED rather than re-derived — which is
# how "act never exceeds .544" survived long enough to be refuted by a single recompute.
# `--claims` re-derives each one from the live corpus and TESTS it against a predicate, so a
# claim that rots reads as DRIFT/REFUTED instead of reading as doctrine. Until 2026-08-24 it
# only PRINTED the doctrine number beside the live one and let the ROM-vs-twin arithmetic
# verdict stand as the whole line's verdict — so claim 2, the very claim quoted above, read
# [AGREE] while the live corpus refuted it. See "THE CLAIM GATE" below.
#
# usage:
#   mesh-series-stats --field <name> [--where <f><op><v>] [--threshold <v>]
#   mesh-series-stats --values <file> [--threshold <v>] [--scale <n>]
#   mesh-series-stats --claims          re-derive every STANDING claim in the sweep
#   mesh-series-stats --twin <file> <scale> <thr>   the 64-bit side alone
#   mesh-series-stats --test
#
# THE TWIN IS N-VERSION, NOT A RE-READ. It sorts with its own selection sort over the
# UNSORTED input and accumulates in 64-bit awk floats — it does not reuse the host's
# `sort` or the ROM's integer scaling. So an AGREE is evidence about the arithmetic AND
# the ordering, rather than two readings of one mistake.
set -eu
# Repo-resolved (same pattern as mesh-rom-gate): a tool deployed to ~/.local/bin must still find
# its sibling ROM + uxncli in the genome checkout — `dirname "$0"` would point at ~/.local/bin and
# lose them (the deploy-broke-sibling-resolution trap, caught wiring --claims into the sound dash).
REPO="${MESH_REPO:-$HOME/lte-workstation}"
UXN_DIR="${MESH_UXN_DIR:-$REPO/scripts/uxn}"
ROM="${MESH_SERIES_ROM:-$UXN_DIR/series-stats.rom}"
UXNCLI="${MESH_UXNCLI:-$UXN_DIR/bin/uxncli}"
RECORDS="${MESH_RECORDS_LOG:-$HOME/.mesh/records.log}"
NMAX=2343                    # the ROM's domain ceiling
VMAX=9999                    # the ROM's per-token ceiling

[ "${1:-}" = --test ] && exec "$UXN_DIR/test-series-stats"
[ -f "$ROM" ]    || { echo "mesh-series-stats: n/a — no ROM at $ROM (run ./build.sh --rom)" >&2; exit 2; }
[ -x "$UXNCLI" ] || { echo "mesh-series-stats: n/a — no uxncli at $UXNCLI (run ./build.sh)" >&2; exit 2; }

# pick_scale <file> → the largest power of ten in {1000,100,10,1} that keeps every scaled
# value inside the ROM's per-token ceiling. Printed with every result: a reader who cannot
# see the scale cannot tell a quantized median from an exact one.
pick_scale(){
  awk -v vmax="$VMAX" '
    /^[[:space:]]*(#|$)/ { next }
    { if ($1+0 > m) m = $1+0; if ($1+0 < 0) neg=1 }
    END {
      if (neg) { print "NEG"; exit }
      for (s = 1000; s >= 1; s /= 10) if (int(m*s + 0.5) <= vmax) { print s; exit }
      print "OVER"
    }' "$1"
}

# rom_stats <file> <scale> <threshold-scaled> → the ROM's six numbers, rc 2 + NA on refusal.
# The refusal is passed through UNCHANGED — a host that turned NA into a number would be
# re-introducing exactly the silent wrap the ROM exists to refuse.
rom_stats(){
  local f="$1" scale="$2" thr="$3"
  awk -v s="$scale" '/^[[:space:]]*(#|$)/ { next } { printf "%d\n", int($1*s + 0.5) }' "$f" \
    | sort -n > "$f.scaled"
  { echo "$thr"; wc -l < "$f.scaled"; cat "$f.scaled"; } | "$UXNCLI" "$ROM"
}

# twin_stats <file> <scale> <threshold-scaled> → the same six numbers, independently.
twin_stats(){
  awk -v s="$2" -v thr="$3" '
    /^[[:space:]]*(#|$)/ { next }
    { v[++n] = int($1*s + 0.5) }
    END {
      if (n < 1) { print "NA"; exit }
      # selection sort — the ROM was fed `sort -n` output, so sorting here independently
      # is what makes an ordering bug visible instead of shared.
      for (i = 1; i <= n; i++) {
        k = i
        for (j = i+1; j <= n; j++) if (v[j] < v[k]) k = j
        t = v[i]; v[i] = v[k]; v[k] = t
      }
      sum = 0; cnt = 0
      for (i = 1; i <= n; i++) { sum += v[i]; if (v[i] >= thr) cnt++ }
      loi = int((n-1)/2) + 1; hii = int(n/2) + 1
      med2 = v[loi] + v[hii]
      mean = sum / n
      printf "%d %d %d %d %d %d\n", v[1], v[n], med2, cnt, sum, int(mean*1000 + 0.5)
    }' "$1"
}

# report <label> <values-file> <threshold-raw> — the ROM, the twin, the verdict, and the
# derived quantities back in the series' own units.
report(){
  local label="$1" f="$2" thr_raw="$3" scale rom twin verdict
  local n; n=$(grep -cvE '^[[:space:]]*(#|$)' "$f" || true)
  if [ "$n" -lt 1 ]; then echo "$label: n/a — no values"; return 2; fi
  if [ "$n" -gt "$NMAX" ]; then
    echo "$label: n/a — n=$n exceeds the ROM's domain ($NMAX); NOT silently windowed"; return 2
  fi
  scale="$(pick_scale "$f")"
  case "$scale" in
    NEG)  echo "$label: n/a — negative values are outside the ROM's domain"; return 2 ;;
    OVER) echo "$label: n/a — a value exceeds the ROM's per-token ceiling ($VMAX)"; return 2 ;;
  esac
  local thr_s; thr_s=$(awk -v t="$thr_raw" -v s="$scale" 'BEGIN{ printf "%d", int(t*s + 0.5) }')
  rom="$(rom_stats "$f" "$scale" "$thr_s" || true)"
  twin="$(twin_stats "$f" "$scale" "$thr_s")"
  [ "$rom" = "$twin" ] && verdict=AGREE || verdict=DIVERGE
  # STATS_OUT: the derived quantities in the series' OWN units, for a caller that has to
  # TEST a claim rather than print one. Written before the render so a claim predicate reads
  # exactly the numbers the reader sees — never a second, separately-derived copy.
  [ -n "${STATS_OUT:-}" ] && echo "$rom" | awk -v s="$scale" -v n="$n" '
      $1 == "NA" { print "NA"; exit }
      { printf "%d %.6f %.6f %.6f %d %.6f\n", n, $1/s, $2/s, $3/(2*s), $4, $6/(1000*s) }' > "$STATS_OUT"
  # `arith:` is not decoration. This verdict is ROM-vs-twin ARITHMETIC ONLY and says nothing
  # about whether the doctrine claim above it still holds — an unqualified [AGREE] beside a
  # refuted claim reads as the claim agreeing, which is how "act never exceeds .544" printed
  # AGREE while 133 live records exceeded it (2026-08-24). The claim verdict is a SEPARATE line.
  echo "$rom" | awk -v l="$label" -v s="$scale" -v n="$n" -v t="$thr_raw" -v v="$verdict" '
    $1 == "NA" { printf "%s: NA (ROM refused) n=%d scale=%d\n", l, n, s; exit }
    {
      printf "%s: n=%d scale=%d  min=%.4g max=%.4g median=%.4g  cnt(>=%.4g)=%d  mean=%.4g  [arith:%s]\n",
        l, n, s, $1/s, $2/s, $3/(2*s), t, $4, $6/(1000*s), v
    }'
  [ "$verdict" = AGREE ] || return 1
}

# ── THE CLAIM GATE ────────────────────────────────────────────────────────────────────
# Until 2026-08-24 the doctrine number lived ONLY inside an echo string: `--claims` printed
# "act never exceeds .544" and then, from the ROM-vs-twin check alone, [AGREE] — while the
# live corpus held max=1 and cnt(>=0.55)=133. The word DRIFT appeared in this file's header
# and in the dash legend and existed in NO code path, so the gate could not fail in the one
# direction it was built for. A gate you have not seen FAIL is not a gate.
#
# Each standing claim now carries a PREDICATE, and every predicate is parameter-free — the
# claim's own operative consequence, never an invented tolerance:
#   * a BOUND claim ("X never exceeds v, so X>=t can never fire") tests cnt(>=t)==0. Exact.
#   * a MEDIAN claim tests the doctrine median against the LIVE corpus by the only thing a
#     median asserts: that it splits the population in half. cnt(>=m)/n must sit inside the
#     binomial null 0.5 +/- 3*(0.5/sqrt(n)) — a band derived from n, not chosen. This is the
#     calibrate-against-the-live-corpus rule applied to the gate itself.
#   * a COMPARISON claim tests DIRECTION, which is what it founded. Its MAGNITUDE is reported
#     and explicitly NOT gated: the ROM yields no dispersion term, so no honest band exists
#     here — say so in the line rather than let a silent pass read as agreement.
# stats <file> holds: n min max median cnt mean.
CLAIM_RC=0
_s(){ awk -v i="$2" '{print $i}' "$1"; }   # field i of the stats line

# claim_bound <stats> <asserted-max> <threshold> — "never exceeds v, so >=t can never fire"
claim_bound(){
  local st="$1" v="$2" t="$3" n mx cnt
  [ -s "$st" ] && [ "$(cat "$st")" != NA ] || { echo "  => UNKNOWN: no stats (the ROM refused or the series was empty) — never read as HOLDS"; CLAIM_RC=2; return; }
  n=$(_s "$st" 1); mx=$(_s "$st" 3); cnt=$(_s "$st" 5)
  if [ "$cnt" -eq 0 ]; then
    echo "  => HOLDS: cnt(>=$t)=0 over n=$n live rows · doctrine max $v, live max $mx"
  else
    echo "  => REFUTED: cnt(>=$t)=$cnt of n=$n live rows exceed the bound (live max $mx vs doctrine $v) — the 'can never fire' consequence is FALSE"
    CLAIM_RC=1
  fi
}

# ── THE MIXTURE GUARD ─────────────────────────────────────────────────────────────────
# A median claim asserts that m splits the population in half. Over a MIXTURE that predicate is
# satisfiable with no row anywhere near m: on 2026-08-24 the live ledger read act pooled
# p=0.508 (z=+0.6) => HOLDS, while its arms sat at drop p=0.972 (z=+23.0) and ear p=0.073
# (z=-20.9) — 597 and 600 rows. The doctrine median 0.319 lands in the empty valley BETWEEN two
# populations and the pooled 0.508 is the corpus's organ MIX, which mesh-records sets by pruning
# per organ. Prune one organ harder and the verdict flips with the world unchanged. That is the
# inverse polarity of the failure this gate was built for: claim 2 was a false REFUTED-that-read-
# AGREE from arithmetic; this is a false HOLDS from composition, and the pooled band cannot see it
# because the band is derived from n, and n is exactly what the mixture moves.
#
# The test is the claim's own predicate applied PER ORGAN, with each arm's own binomial band from
# its own n_o — no new constant, and an arm too small to be polarized (|z| cannot reach 3) is
# self-excluded rather than thresholded out. Arms on BOTH sides mean m splits no organ in half,
# so the remedy is not a new number (DRIFT) but a claim stated per organ: verdict MIXTURE.
# Each arm also publishes its tie-at-max fraction, because these axes are clip01(x/K) and a
# median of a CLIPPED quantity is not a median of the quantity (drop runs 36.3% railed on move).
claim_mixture(){
  local kf="$1" m="$2"
  [ -s "$kf" ] || return 0
  awk -v m="$m" '
    { o=$1; v=$2+0; n[o]++; if (v>=m) c[o]++; if (v>mx[o] || n[o]==1) mx[o]=v; vals[o]=vals[o] " " v }
    END{
      hi=0; lo=0; line=""
      for (o in n) {
        p = (c[o]+0)/n[o]; sd = 0.5/sqrt(n[o]); z = (p-0.5)/sd
        # median + tie-at-max, from this arm alone
        k=split(vals[o], a, " "); for(i=1;i<=k;i++) for(j=i+1;j<=k;j++) if(a[j]+0<a[i]+0){t=a[i];a[i]=a[j];a[j]=t}
        med = a[int(k/2)+1]+0
        rail=0; for(i=1;i<=k;i++) if (a[i]+0 == mx[o]+0) rail++
        if (z > 3) hi++; else if (z < -3) lo++
        line = line sprintf("%s n=%d p=%.3f z=%+.1f med=%.3g tie@max %.0f%%@%.3g | ", o, n[o], p, z, med, 100*rail/k, mx[o])
      }
      if (hi > 0 && lo > 0) {
        printf "  => MIXTURE: the doctrine median %.4g splits NO organ in half — it lands between %d high-side and %d low-side population(s), so the pooled split is the corpus ORGAN MIX (which mesh-records sets by pruning per organ), not the material\n", m, hi, lo
        printf "     arms: %s\n", substr(line, 1, length(line)-3)
        printf "     a pooled median over a bimodal corpus calibrates to neither mode: state this claim PER ORGAN or on one organ, never re-fit a single number to the mix\n"
        exit 1
      }
    }' "$kf"
}

# claim_median <stats> <doctrine-median> [keyed-values] — the threshold passed to report() MUST
# be the doctrine median, so cnt(>=t) IS the test statistic and not a second derivation. When a
# keyed file is supplied, the MIXTURE guard above runs FIRST and its verdict REPLACES the pooled
# one: a pooled HOLDS/DRIFT printed beside polarized arms would be the composition artifact
# wearing the material's name.
claim_median(){
  local st="$1" m="$2" kf="${3:-}"
  [ -s "$st" ] && [ "$(cat "$st")" != NA ] || { echo "  => UNKNOWN: no stats — never read as HOLDS"; CLAIM_RC=2; return; }
  if [ -n "$kf" ] && ! claim_mixture "$kf" "$m"; then CLAIM_RC=1; return; fi
  awk -v n="$(_s "$st" 1)" -v cnt="$(_s "$st" 5)" -v med="$(_s "$st" 4)" -v m="$m" '
    BEGIN{
      p = cnt/n; sd = 0.5/sqrt(n); band = 3*sd; lo = 0.5-band; hi = 0.5+band
      # z is the SAME quantity the band is built from, in sd units of the binomial null. Printed
      # because the verdict alone FLAPS at the edge: on the live ledger dyn sat at 3.0 sigma and
      # crossed HOLDS->DRIFT between two dash frames two minutes apart, on a corpus that gains a
      # few rows a minute. Without z a reader cannot tell that jitter from a real move, and would
      # reach for a wider band, an invented constant, to quiet it. Rank the deviation instead.
      z = (p - 0.5)/sd
      if (p >= lo && p <= hi)
        printf "  => HOLDS: the doctrine median %.4g still splits the live corpus %.3f/%.3f (z=%+.1f sd, |z|<=3 over n=%d) · live median %.4g%s\n", m, p, 1-p, z, n, med, (z<-2||z>2) ? " · MARGINAL: within 1 sd of the edge, expect this verdict to flap frame to frame" : ""
      else {
        printf "  => DRIFT: the doctrine median %.4g now splits the live corpus %.3f/%.3f (z=%+.1f sd, |z|>3 over n=%d) · live median %.4g%s\n", m, p, 1-p, z, n, med, (z>-4&&z<4) ? " · MARGINAL: within 1 sd of the edge, expect this verdict to flap frame to frame" : ""
        exit 1
      }
    }' || CLAIM_RC=1
}

# claim_compare <stats-a> <stats-b> <doctrine-mean-a> <doctrine-mean-b> <what>
claim_compare(){
  local a="$1" b="$2" da="$3" db="$4" what="$5"
  { [ -s "$a" ] && [ "$(cat "$a")" != NA ] && [ -s "$b" ] && [ "$(cat "$b")" != NA ]; } \
    || { echo "  => UNKNOWN: one arm has no stats — never read as HOLDS"; CLAIM_RC=2; return; }
  awk -v ma="$(_s "$a" 6)" -v mb="$(_s "$b" 6)" -v da="$da" -v db="$db" -v w="$what" '
    BEGIN{
      dr = (da>0)? db/da : 0; lr = (ma>0)? mb/ma : 0
      if (ma < mb)
        printf "  => HOLDS (direction): %s · live %.4g vs %.4g\n", w, ma, mb
      else {
        printf "  => REFUTED (direction): %s is INVERTED on the live corpus · live %.4g vs %.4g\n", w, ma, mb
        bad = 1
      }
      printf "     separation NOT GATED (the ROM yields no dispersion term, so no honest band exists here): doctrine %.3gx -> live %.3gx\n", dr, lr
      exit bad
    }' || CLAIM_RC=1
}

# values <field> [where-expr] — pull one key=value column out of the records ledger.
values(){
  local field="$1" where="${2:-}" wf="" wop="" wv=""
  if [ -n "$where" ]; then
    wf="${where%%[<>=]*}"
    wop="$(printf '%s' "$where" | sed "s/^$wf//; s/[0-9.]*$//")"
    wv="${where##*[<>=]}"
  fi
  awk -v f="$field" -v wf="$wf" -v wop="$wop" -v wv="$wv" '
    {
      delete kv
      for (i = 1; i <= NF; i++) if (split($i, p, "=") == 2) kv[p[1]] = p[2]
      # DENSITY IS A DERIVED AXIS, and it is the one the rhythm floor actually gates on. Raw `beats`
      # is duration-BLIND: a record measured over an 18s window and one measured over 3s are counted
      # on the same scale, so a shift in the corpus WINDOW MIX moves every beats-based statistic with
      # no change in the material. Expose beats/win here so a claim can be stated on the quantity the
      # code decides with, instead of on a proxy that a night of long takes can invert.
      # PRESENCE here, VALUE after the where-clause. Computing and printing density in this spot
      # skipped the filter block below entirely, so `values density score>=55` and `... score<55`
      # both returned the WHOLE corpus (n=1614 twice) and the ratio was 1.00x by construction — a
      # perfect null that looked exactly like the finding it was supposed to test. Caught only
      # because both sides printed the same n.
      if (f == "density") { if (!("beats" in kv) || !("win" in kv) || kv["win"] + 0 <= 0) next }
      else if (!(f in kv)) next
      if (wf != "") {
        if (!(wf in kv)) next
        x = kv[wf] + 0; y = wv + 0
        if (wop == ">=" && !(x >= y)) next
        if (wop == "<"  && !(x <  y)) next
        if (wop == ">"  && !(x >  y)) next
        if (wop == "<=" && !(x <= y)) next
        if (wop == "==" && !(x == y)) next
      }
      if (f == "density") { print (kv["beats"] + 0) / (kv["win"] + 0); next }
      print kv[f] + 0
    }' "$RECORDS"
}

# values_keyed <field> — the same column, carrying the ORGAN ($2) it was measured on. A pooled
# order statistic over this ledger is an order statistic over a MIXTURE: the organs are different
# physical sources with different physics, and the ledger prunes PER ORGAN, so the mixture weights
# are machinery. claim_median reads this to tell "the doctrine number moved" from "no single
# number can split this corpus" — see THE MIXTURE GUARD.
values_keyed(){
  awk -v f="$1" '
    {
      delete kv
      for (i = 1; i <= NF; i++) if (split($i, p, "=") == 2) kv[p[1]] = p[2]
      if (!(f in kv)) next
      if ($2 == "") next
      print $2, kv[f] + 0
    }' "$RECORDS"
}

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

mode="${1:---claims}"
case "$mode" in
  --field)
    field="${2:?--field needs a name}"; shift 2
    where=""; thr=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --where) where="${2:?}"; shift 2 ;;
        --threshold) thr="${2:?}"; shift 2 ;;
        *) echo "mesh-series-stats: unknown option $1" >&2; exit 2 ;;
      esac
    done
    values "$field" "$where" > "$tmp/v"
    report "$field${where:+ [$where]}" "$tmp/v" "$thr"
    ;;
  --values)
    f="${2:?--values needs a file}"; shift 2
    thr=0; scale=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --threshold) thr="${2:?}"; shift 2 ;;
        --scale) scale="${2:?}"; shift 2 ;;
        *) echo "mesh-series-stats: unknown option $1" >&2; exit 2 ;;
      esac
    done
    grep -vE '^[[:space:]]*(#|$)' "$f" > "$tmp/v" || true
    if [ -n "$scale" ]; then
      thr_s=$(awk -v t="$thr" -v s="$scale" 'BEGIN{ printf "%d", int(t*s + 0.5) }')
      rom_stats "$tmp/v" "$scale" "$thr_s" || true
    else
      report "$(basename "$f")" "$tmp/v" "$thr"
    fi
    ;;
  --twin)
    f="${2:?--twin needs a file}"
    twin_stats "$f" "${3:-1}" "${4:-0}"
    ;;
  --claims)
    # Every STANDING claim in docs/uxn-doctrine-claims.md that is an order statistic, each
    # re-derived from the live ledger with the doctrine's own number printed beside it.
    [ -f "$RECORDS" ] || { echo "mesh-series-stats: n/a — no records ledger at $RECORDS" >&2; exit 2; }
    echo "source: $RECORDS ($(wc -l < "$RECORDS") rows, mtime $(date -u -r "$RECORDS" +%FT%TZ))  ROM: $(basename "$ROM")"
    # The ledger is a PER-ORGAN SLIDING WINDOW — mesh-records prunes to LOG_KEEP rows per
    # organ on every sweep, so the row count moves DOWN as well as up and the population
    # itself turns over. No n= quoted from it is reproducible later, including this one.
    # That is why the gate is the claim and the number is only its current answer.
    echo "note: records.log is pruned per organ each sweep — n moves both ways; re-derive, never quote"
    echo
    echo "claim 2 — CLAUDE.md: \"act never exceeds .544 on real material\" (so act>0.55 can never fire)"
    values act > "$tmp/act"; STATS_OUT="$tmp/act.st" report "  act" "$tmp/act" 0.55 || true
    claim_bound "$tmp/act.st" 0.544 0.55
    echo
    # The threshold is the DOCTRINE MEDIAN, never a round 0.5: it makes the printed cnt(>=t)
    # the claim's own test statistic instead of an unrelated number sitting beside it.
    echo "claim 3 — CLAUDE.md: \"real medians are dyn .265 / act .319 / move .141\" (n=29)"
    set -- dyn 0.265 act 0.319 move 0.141
    while [ $# -gt 0 ]; do
      ax="$1"; dm="$2"; shift 2
      values "$ax" > "$tmp/$ax"; STATS_OUT="$tmp/$ax.st" report "  $ax" "$tmp/$ax" "$dm" || true
      values_keyed "$ax" > "$tmp/$ax.keyed"
      claim_median "$tmp/$ax.st" "$dm" "$tmp/$ax.keyed"
    done
    echo
    echo "claim 1 — CLAUDE.md: \"score>=55 averages 3.6 beats vs 12.2 for everything else\" (n=215)"
    values beats 'score>=55' > "$tmp/b_hi"; STATS_OUT="$tmp/hi.st" report "  beats [score>=55]" "$tmp/b_hi" 1 || true
    values beats 'score<55'  > "$tmp/b_lo"; STATS_OUT="$tmp/lo.st" report "  beats [score<55]"  "$tmp/b_lo" 1 || true
    claim_compare "$tmp/hi.st" "$tmp/lo.st" 3.6 12.2 "high-score records are beat-POORER than the rest (the rhythm-density floor's founding case)"
    # THE SAME SPLIT ON THE AXIS THE FLOOR ACTUALLY GATES ON. The claim above is stated in RAW BEATS,
    # which is duration-blind, so its verdict tracks the corpus WINDOW MIX rather than the material:
    # measured on this node it read HOLDS at 2026-08-25T21:59Z and REFUTED at 23:59Z, two hours apart,
    # with nothing between them but eleven long operator guitar takes arriving. Print the density arm
    # beside it — same records, same split, beats/win instead of beats — plus each side mean window,
    # which is the term that moved. No new doctrine number is minted here: this leg REPORTS, it does
    # not vote, because the standing claim carries no density figure to be checked against.
    values density 'score>=55' > "$tmp/d_hi"; values density 'score<55' > "$tmp/d_lo"
    values win     'score>=55' > "$tmp/w_hi"; values win     'score<55' > "$tmp/w_lo"
    awk -v L="$tmp/d_lo" -v WH="$tmp/w_hi" -v WL="$tmp/w_lo" '
      { hs+=$1; hn++ }
      END{
        while ((getline x < L)  > 0) { ls+=x;  ln++  }
        while ((getline x < WH) > 0) { whs+=x; whn++ }
        while ((getline x < WL) > 0) { wls+=x; wln++ }
        if (hn==0 || ln==0) { print "     density: n/a (one side of the split is empty)"; exit }
        hm=hs/hn; lm=ls/ln; r=(hm>0)? lm/hm : 0
        printf "     density [beats/win]: score>=55 n=%d mean=%.3f (mean win %.1fs) . score<55 n=%d mean=%.3f (mean win %.1fs) . lo/hi %.2fx\n", hn, hm, (whn?whs/whn:0), ln, lm, (wln?wls/wln:0), r
        if (r < 1.15 && r > 0.87)
          printf "     => WINDOW-LENGTH ARTIFACT: on the axis the floor gates with, high- and low-score records are indistinguishable (%.2fx) — read the raw-beats verdict above as a statement about the corpus window mix, not about rhythm\n", r
        else
          printf "     => the separation SURVIVES on density (%.2fx), so the raw-beats verdict above is about the material and not the window mix\n", r
      }' "$tmp/d_hi"
    echo
    echo "claim-gate: $([ "$CLAIM_RC" -eq 0 ] && echo "all standing claims HOLD" || echo "rc=$CLAIM_RC — at least one standing claim is REFUTED/DRIFTed/UNKNOWN above")"
    exit "$CLAIM_RC"
    ;;
  *)
    echo "usage: mesh-series-stats [--claims | --field <n> [--where <e>] [--threshold <v>] | --values <f> | --twin <f> <scale> <thr> | --test]" >&2
    exit 2 ;;
esac
