#!/usr/bin/env bash
# orphan-ok: on-demand ambient COLOR-TEMPERATURE (CCT) query from the webcam frame — a lighting-type /
#   time-of-day proxy, not a scheduled sense. Reads the mesh-cam-watch feeder frame (cam-prev.jpg) with
#   NO device contention (never grabs the busy /dev/videoN itself unless the feeder is already dead), and
#   computes ONLY the warm/cool channel balance — no image is kept or sent. Run when the mood/lighting of
#   the room matters (evening warm-incandescent vs cool daylight vs bluish screen-glow).
#
# mesh-color-temp — the mesh's ambient COLOR sense. A real-world signal nothing else captures:
#   mesh-light / mesh-screen-state / mesh-backlight all read BRIGHTNESS (lux / luma / panel state); NONE
#   read the COLOR of the ambient light. Warm low-Kelvin incandescent evening light, neutral daylight,
#   and cool/bluish screen-lit or overcast light are distinct real conditions — a mood + time-of-day +
#   artificial-vs-daylight proxy. This is the missing chroma leg beside mesh-light's luma leg.
#
# SOURCE: the freshest webcam frame (mesh-cam-watch keeps ~/.mesh/cam-prev.jpg fresh every few seconds).
#   We compute the mean R,G,B over a downscaled frame and the warm-index = R/B ratio. We do NOT contend
#   for the (usually feeder-held) camera device; only if the feeder frame is missing/stale do we try ONE
#   direct grab (no contention then — feeder is dead). PRIVACY: only 3 channel means + a label leave this
#   tool; the frame itself is node-local and never transmitted (same class as mesh-light's webcam lens).
#
# HONEST-DEGRADED (never fake a reading):
#   * no frame + no direct grab  -> UNKNOWN (degraded=cam-unreach)  exit 2
#   * frame older than TTL       -> UNKNOWN (degraded=stale)        exit 2
#   * PIL missing                -> UNKNOWN (degraded=no-pil)       exit 2
#   * flat field (covered lens)  -> UNKNOWN (degraded=covered)      exit 2  (R/B of a blank frame is a lie)
#   * too dark to judge color    -> UNKNOWN (degraded=too-dark)     exit 2  (near-black has no real chroma)
#   exit 2 = cannot-assess (mesh-land treats exit 2 as a pass — an unreachable/covered lens is honest n/a,
#   NOT a faked NEUTRAL). Only a real, bright-enough, textured frame yields WARM|NEUTRAL|COOL (exit 0).
#
# UNCALIBRATED caveat: a consumer webcam's auto-white-balance partially neutralises color, so the warm-
#   index reads the RESIDUAL cast (directional but attenuated) and the approx-Kelvin (McCamy) is a rough
#   band, flagged ~approx — never claim a calibrated Kelvin off an AWB webcam.
#
#   mesh-color-temp            [color-temp] VERDICT :: desc (rgb=.. warm-index=.. approxK~.. degraded=..)
#   mesh-color-temp --json     {verdict,warm_index,r,g,b,luma,approx_k,degraded,reason,ts}
#   mesh-color-temp --test     sandboxed classifier + honest-degrade battery (no camera needed)
#
# Vocab contract: the FIRST token after [color-temp] is the verdict (WARM|NEUTRAL|COOL|UNKNOWN) and
#   appears nowhere else in the line — consumers grep -q the verdict token.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

CAM_FRAME="${MESH_CAM_FRAME:-$HOME/.mesh/cam-prev.jpg}"
TTL="${MESH_CCT_TTL:-180}"                 # frame older than this (s) is not a current reading
FLAT_STDDEV="${MESH_CCT_FLAT:-3}"          # luma stddev below this => flat field (covered/blank)
DARK_LUMA="${MESH_CCT_DARK:-12}"           # mean luma below this => too dark to judge color
WARM_HI="${MESH_CCT_WARM_HI:-1.12}"        # R/B >= this => WARM
COOL_LO="${MESH_CCT_COOL_LO:-0.89}"        # R/B <= this => COOL
DIRECT="${MESH_CCT_DIRECT:-1}"             # allow ONE direct grab when feeder frame missing/stale
DIRECT_FRAME="$HOME/.mesh/.cct-direct.jpg" # node-local, same privacy class as cam-prev.jpg
TS="$(date -u +%FT%TZ)"

# assess R G B LUMA STDDEV AGE  ->  echoes "VERDICT|DEGRADED|WARMINDEX|APPROXK|REASON" (never exits)
# Shared by the live path and --test so the test can never pass a path the live run can't take.
assess() {
python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$TTL" "$FLAT_STDDEV" "$DARK_LUMA" "$WARM_HI" "$COOL_LO" <<'PY'
import sys
r,g,b,luma,stddev,age,ttl,flat,dark,warm_hi,cool_lo=(float(x) for x in sys.argv[1:12])
def cct(r,g,b):
    R,G,B=r/255.0,g/255.0,b/255.0
    X=0.4124*R+0.3576*G+0.1805*B; Y=0.2126*R+0.7152*G+0.0722*B; Z=0.0193*R+0.1192*G+0.9505*B
    d=X+Y+Z
    if d<=0: return 0
    x=X/d; y=Y/d
    den=(0.1858-y)
    if den==0: return 0
    n=(x-0.3320)/den
    return int(449*n**3+3525*n**2+6823.3*n+5520.33)
wi=(r/b) if b>0 else 0.0
if age>ttl:
    print(f"UNKNOWN|stale|{wi:.3f}|0|feeder frame {int(age)}s old (>{int(ttl)}s TTL) — not a current reading"); sys.exit()
if stddev<flat:
    print(f"UNKNOWN|covered|{wi:.3f}|0|flat field (luma stddev {stddev:.1f}<{flat:.0f}) — lens covered/blank, R/B of a blank frame is meaningless"); sys.exit()
if luma<dark:
    print(f"UNKNOWN|too-dark|{wi:.3f}|0|mean luma {luma:.0f}<{dark:.0f} — too dark to judge color honestly"); sys.exit()
k=cct(r,g,b)
if wi>=warm_hi:
    v,desc="WARM",f"warm cast (R/B {wi:.2f}) — incandescent/evening-like light"
elif wi<=cool_lo:
    v,desc="COOL",f"cool cast (R/B {wi:.2f}) — daylight/screen-lit/overcast-like light"
else:
    v,desc="NEUTRAL",f"balanced (R/B {wi:.2f}) — neutral/white light"
print(f"{v}|none|{wi:.3f}|{k}|{desc}")
PY
}

# stats_of FRAME -> echoes "R G B LUMA STDDEV" or "" on failure (no PIL / unreadable)
stats_of() {
python3 - "$1" <<'PY' 2>/dev/null
import sys
try:
    from PIL import Image, ImageStat
except Exception:
    sys.exit(3)
try:
    im=Image.open(sys.argv[1]).convert('RGB').resize((160,120))
    m=ImageStat.Stat(im).mean; s=ImageStat.Stat(im).stddev
    r,g,b=m; luma=0.2126*r+0.7152*g+0.0722*b; stddev=sum(s)/3.0
    print(f"{r:.2f} {g:.2f} {b:.2f} {luma:.2f} {stddev:.2f}")
except Exception:
    sys.exit(4)
PY
}

emit() { # VERDICT DEGRADED WARMINDEX APPROXK R G B LUMA REASON  -> print + exit
  local v="$1" deg="$2" wi="$3" k="$4" r="$5" g="$6" b="$7" luma="$8"; shift 8; local reason="$*"
  local kf=""; [ "$k" != "0" ] && [ -n "$k" ] && kf=" approxK~${k}"
  if [ "${JSON:-0}" = 1 ]; then
    printf '{"verdict":"%s","warm_index":%s,"r":%s,"g":%s,"b":%s,"luma":%s,"approx_k":%s,"degraded":"%s","reason":"%s","ts":"%s"}\n' \
      "$v" "${wi:-0}" "${r:-0}" "${g:-0}" "${b:-0}" "${luma:-0}" "${k:-0}" "$deg" "$(printf '%s' "$reason" | sed 's/"/\\"/g')" "$TS"
  else
    echo "[color-temp] $v :: $reason (rgb=${r:-?}/${g:-?}/${b:-?} warm-index=${wi:-?}${kf} degraded=${deg})"
  fi
  [ "$v" = UNKNOWN ] && exit 2 || exit 0
}

# ---- run one reading (frame-or-injected) -> emits + exits ----
run_reading() {
  local r g b luma stddev age src="$CAM_FRAME"
  # test/sandbox injection: MESH_CCT_STATS="r,g,b,luma,stddev[,age]" bypasses frame acquisition
  if [ -n "${MESH_CCT_STATS:-}" ]; then
    IFS=',' read -r r g b luma stddev age <<<"$MESH_CCT_STATS"
    age="${age:-0}"
  else
    # acquire the freshest frame without contending for the (feeder-held) device
    if [ -f "$src" ]; then
      age=$(( $(date +%s) - $(stat -c %Y "$src" 2>/dev/null || echo 0) ))
    elif [ "$DIRECT" = 1 ] && command -v fswebcam >/dev/null 2>&1; then
      # feeder frame absent => feeder likely dead => no device contention, try ONE direct grab
      fswebcam -d "${MESH_CAM:-/dev/video0}" -r 640x480 -S "${MESH_CCT_WARMUP:-6}" --no-banner \
        "$DIRECT_FRAME.tmp" >/dev/null 2>&1 && [ -s "$DIRECT_FRAME.tmp" ] \
        && mv "$DIRECT_FRAME.tmp" "$DIRECT_FRAME" || rm -f "$DIRECT_FRAME.tmp"
      if [ -s "$DIRECT_FRAME" ]; then src="$DIRECT_FRAME"; age=0
      else emit UNKNOWN cam-unreach 0 0 "" "" "" "" "no feeder frame ($CAM_FRAME) and direct grab failed — camera unreachable"; fi
    else
      emit UNKNOWN cam-unreach 0 0 "" "" "" "" "no feeder frame ($CAM_FRAME) and no direct-grab path — camera unreachable"
    fi
    local st; st=$(stats_of "$src"); local rc=$?
    if [ $rc -eq 3 ]; then emit UNKNOWN no-pil 0 0 "" "" "" "" "python PIL not available — cannot read frame color"; fi
    if [ -z "$st" ]; then emit UNKNOWN cam-unreach 0 0 "" "" "" "" "frame $src unreadable/corrupt — camera unreachable"; fi
    read -r r g b luma stddev <<<"$st"
  fi
  local res; res=$(assess "$r" "$g" "$b" "$luma" "$stddev" "$age")
  local v deg wi k reason
  IFS='|' read -r v deg wi k reason <<<"$res"
  emit "$v" "$deg" "$wi" "$k" "$r" "$g" "$b" "$luma" "$reason"
}

# ---------- --test ----------
if [ "${1:-}" = --test ]; then
  fail=0
  chk() { # LABEL EXPECT_VERDICT EXPECT_DEG EXPECT_RC  <<STATS via env
    local label="$1" ev="$2" ed="$3" erc="$4"
    local out rc
    out=$(MESH_CCT_STATS="$STATS" MESH_CAM_FRAME=/nonexistent-cct "$0" 2>/dev/null); rc=$?
    local gv; gv=$(printf '%s' "$out" | sed -n 's/^\[color-temp\] \([A-Z-]*\) .*/\1/p')
    local gd; gd=$(printf '%s' "$out" | sed -n 's/.*degraded=\([a-z-]*\).*/\1/p')
    if [ "$gv" = "$ev" ] && [ "$gd" = "$ed" ] && [ "$rc" = "$erc" ]; then
      echo "  ok   $label -> $gv/$gd rc=$rc"
    else
      echo "  FAIL $label -> got $gv/$gd rc=$rc, want $ev/$ed rc=$erc"; fail=1
    fi
  }
  # classification (bright, textured frames) — warm and cool must NOT collapse to the same verdict
  STATS="180,150,110,150,40,0"  chk "warm cast (R>>B)"        WARM    none     0
  STATS="150,150,150,150,40,0"  chk "neutral (R==B)"          NEUTRAL none     0
  STATS="110,150,190,150,40,0"  chk "cool cast (B>>R)"        COOL    none     0
  STATS="132,140,150,140,40,0"  chk "mild cool near edge"     COOL    none     0
  STATS="150,145,133,142,40,0"  chk "mild warm near edge"     WARM    none     0
  # honest-degrade — never a faked reading
  STATS="17,17,17,17,0.4,0"     chk "flat/covered lens"       UNKNOWN covered  2
  STATS="9,9,10,9,40,0"         chk "too dark for color"      UNKNOWN too-dark 2
  STATS="150,150,150,150,40,999" chk "stale frame"            UNKNOWN stale    2
  # frame-acquisition failure (no injection, nonexistent frame, direct disabled)
  out=$(MESH_CAM_FRAME=/nonexistent-cct MESH_CCT_DIRECT=0 "$0" 2>/dev/null); rc=$?
  gd=$(printf '%s' "$out" | sed -n 's/.*degraded=\([a-z-]*\).*/\1/p')
  if printf '%s' "$out" | grep -q '^\[color-temp\] UNKNOWN ' && [ "$gd" = cam-unreach ] && [ "$rc" = 2 ]; then
    echo "  ok   missing frame -> UNKNOWN/cam-unreach rc=2"
  else echo "  FAIL missing frame -> got $gd rc=$rc, want cam-unreach rc=2"; fail=1; fi
  # verdict token uniqueness (vocab contract): verdict appears exactly once on the line
  line=$(MESH_CCT_STATS="180,150,110,150,40,0" MESH_CAM_FRAME=/nonexistent-cct "$0" 2>/dev/null)
  n=$(printf '%s' "$line" | grep -o 'WARM' | wc -l)
  if [ "$n" = 1 ]; then echo "  ok   verdict token appears once"; else echo "  FAIL verdict token x$n (vocab-contract)"; fail=1; fi
  # json shape
  MESH_CCT_STATS="110,150,190,150,40,0" MESH_CAM_FRAME=/nonexistent-cct "$0" --json 2>/dev/null \
    | grep -q '"verdict":"COOL"' && echo "  ok   --json emits verdict" || { echo "  FAIL --json"; fail=1; }
  [ $fail = 0 ] && echo "smoke-test: PASS" || echo "smoke-test: FAIL"
  exit $fail
fi

JSON=0
[ "${1:-}" = --json ] && JSON=1
run_reading
