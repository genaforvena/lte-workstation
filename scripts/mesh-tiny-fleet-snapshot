#!/usr/bin/env bash
# mesh-tiny-fleet-snapshot — lightweight weekly drift measurement.
#
# Captures structural/vocabulary/pattern metrics and appends to a time-series log.
# Does NOT run ollama inference (that's the expensive part, done by mesh-tiny-fleet compare).
#
# reflex-cadence: 0 3 * * 0
# reflex-args:
#
# Usage:
#   mesh-tiny-fleet-snapshot          # take a snapshot, append to drift series
#   mesh-tiny-fleet-snapshot --test   # smoke test
#
# Env:
#   TINY_FLEET_DIR  working directory (default: ~/.mesh/tiny-fleet)

set -euo pipefail

DIR="${TINY_FLEET_DIR:-$HOME/.mesh/tiny-fleet}"
SERIES="$DIR/drift-series.jsonl"
HEAD=$(git rev-parse --short HEAD)
DATE=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

mkdir -p "$DIR"

ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

cmd_snapshot() {
    local repo
    repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    # Quick structural metrics (no inference needed)
    python3 - "$repo" "$DATE" "$HEAD" "$SERIES" << 'PYEOF'
import os, re, json, sys
from collections import Counter

root = sys.argv[1]
date = sys.argv[2]
commit = sys.argv[3]
series = sys.argv[4]

# File metrics — use git ls-tree for committed files only (no node_modules, .pyc, .map)
import subprocess
git_files = subprocess.check_output(['git', 'ls-tree', '-r', '--name-only', 'HEAD'], cwd=root, text=True).strip().split('\n')
exts = Counter()
sizes = []
for relpath in git_files:
    exts[os.path.splitext(relpath)[1]] += 1
    full = os.path.join(root, relpath)
    try: sizes.append(os.path.getsize(full))
    except: pass

total_files = len(git_files)
total_kb = sum(sizes) / 1024
avg_kb = total_kb / max(total_files, 1)

# Vocabulary — walk committed files only
words = Counter()
for relpath in git_files:
    full = os.path.join(root, relpath)
    try:
        text = open(full, 'r', errors='ignore').read()
        words.update(re.findall(r'[a-zA-Z_][a-zA-Z0-9_]{2,}', text))
        words.update(re.findall(r'mesh-[a-z-]+', text))
    except: pass

# Key concepts
concepts = {}
for w in ['gate','verdict','board','reflex','organ','cadence','coverage','drift',
          'probe','census','fleet','autopoiesis','homeostasis','staleness','arm',
          'ledger','fixture','tape','slug','DEGRADED','RECOVERY','UNKNOWN']:
    concepts[w] = words.get(w, 0)

# Pattern counts
mesh_refs = sum(words.get(f'mesh-{w}', 0) for w in ['chat','health','card','doctor',
    'fleet','tell','trace','handoff','clear','selfcare','heartbeat','tick',
    'supervise','verify','mind','restore','model','embed','say','act'])

snapshot = {
    "date": date,
    "commit": commit,
    "files": total_files,
    "total_kb": round(total_kb, 1),
    "avg_file_kb": round(avg_kb, 1),
    "vocabulary": len(words),
    "mesh_refs": mesh_refs,
    "concepts": concepts,
    "extensions": {k: v for k, v in exts.most_common(10)},
}

print(json.dumps(snapshot))

# Append to series
with open(series, "a") as f:
    f.write(json.dumps(snapshot) + "\n")

print(f"tiny-fleet-snapshot: {commit} — {total_files} files, {len(words)} vocab, {mesh_refs} mesh-refs")
PYEOF
}

cmd_test() {
    echo "tiny-fleet-snapshot: smoke test"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "FAIL: not in git repo"; exit 1; }
    python3 -c "import json, os, re; print('ok')"
    echo "tiny-fleet-snapshot: OK"
}

case "${1:-}" in
    "")           cmd_snapshot ;;
    snapshot)      cmd_snapshot ;;
    --test)        cmd_test ;;
    *)
        echo "mesh-tiny-fleet-snapshot — weekly drift metric capture"
        echo "Usage: mesh-tiny-fleet-snapshot [--test]"
        ;;
esac
