#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-note3-light-raw — the Note3 MAX88922's RAW (uncalibrated) broadband-light ADC channel,
# via the SAME `dumpsys sensorservice` adb->ds relay mesh-light/mesh-note3-mag already use.
#
# WHY THIS IS NEW: `android.sensor.light`'s dumpsys line reports THREE values —
#   last=<lux, raw, 0, ts>
# mesh-light's note3_light_lux() parses ONLY values[0] (the calibrated lux) for the craft-room
# light sense; values[1] (the raw ADC/broadband-IR count feeding that calibration, observed live
# 2026-07-09 as 4651.8 while lux read 11.0 — see capability-note3-ir-proximity-gesture-
# 20260707.md) is read off the wire and silently discarded. It is a genuinely different quantity:
# un-quantized (lux prints as a rounded integer; raw carries sub-lux resolution) and un-clamped
# by whatever calibration curve produces lux, so it can register a real intensity swing (e.g. a
# dimming trend, a partial obstruction) that the coarse lux value hides. No other mesh sense
# reads this field — a real, live, previously-thrown-away signal, not a new probe.
#
# Honest contract: on-change sensor (same caveat as mesh-light's craft light) — moves only when
# the Note3's own listener fires, not a guaranteed poll-rate stream. adb/ssh unreachable OR the
# light line unparsable -> UNREACHABLE, exit 2, never fake a reading.
#
# SAMPLE-AGE GATE (chat-review/dumpsys-sample-age-gate, 2026-07-15): `last=<...>` is a LATCH that
# serves its last-ever sample forever, so "parses fine + exit 0 + fresh state mtime" was NEVER
# evidence of a live sensor — this tool published a 2.5-hour-old fossil as STABLE for hours. The
# sample's own ts (values[3], on the wire all along, read by nobody) against the phone's boot clock
# is the ONLY axis that separates a steady reading from a dead one; value cannot, as a probe proved
# by re-latching the fossil at a fresh-looking number. A sample older than 2x cadence is now STALE
# (exit 2, honest n/a) and ts=0 is NEVER-REPORTED — see freshness() for the full case.
#
#   mesh-note3-light-raw            one-shot verdict (INIT|STABLE|CHANGED) + raw/lux/delta%/age
#   mesh-note3-light-raw --json     machine-readable
#   mesh-note3-light-raw --edge     debounced state write; board post ONLY on a STABLE<->CHANGED transition
#   mesh-note3-light-raw --test     fixture-driven classifier + sample-age gate + live adb read-gate
#
# Exit: 0 = assessed (INIT/STABLE/CHANGED, from a sample younger than the age gate) · 2 = no current
#       reading (adb body unreachable, OR the sensor is latched/never-reported — honest n/a, never faked)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.note3-light-raw-state"      # "verdict|raw|lux|ts"
LEVEL_STATE="$MESH/.note3-light-raw-level" # "confirmed|candidate|count" for the sustained-change board gate

# Same fixed adb->ds relay mesh-baro/mesh-note3-mag/mesh-light's craft light use.
NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"
# Relative-change band: raw runs in the thousands (observed live ~4651.8) with sensor-internal
# jitter at rest; a >=15% swing is well above that jitter but well below a real light-on/off or
# hand-over-sensor event (which swings raw by multiples).
RAW_THRESH_PCT="${MESH_NOTE3_LIGHT_RAW_THRESH_PCT:-15}"
# Sustained-change board gate (chat-review/note3-light-raw-floor-jitter, 2026-07-11): at the DARK
# ADC floor (lux~0) the raw does NOT rest near one value — it bounces between discrete quantized
# levels (observed live 2300/3467/4003/4337/4685, deltas 30-88%) while lux stays 0.0-7.7. A per-poll
# %-gate on the immediately-prior raw therefore fires CHANGED on every quantization bounce (~9
# content-free board lines/window, each asserting a light event lux contradicts). Fix: board only
# when a NEW raw level PERSISTS N consecutive polls (compared vs the last CONFIRMED level, so a
# single-poll bounce A->B->A never accumulates a streak) — mirrors the note3-mag macro-gate (80966a4).
# The fine single-step STABLE/CHANGED verdict still flows to STATE/--json unchanged.
LIGHT_SUSTAIN_N="${MESH_NOTE3_LIGHT_SUSTAIN_N:-2}"
# Sample-age gate (chat-review/dumpsys-sample-age-gate, 2026-07-15) — 2x the 5-minute cadence.
# See freshness() for why this axis is the only one that can tell a live sensor from a latch.
LIGHT_MAX_AGE_S="${MESH_NOTE3_LIGHT_MAX_AGE_S:-600}"

adb_dumpsys() {   # echo the phone's `/proc/uptime` line + raw `dumpsys sensorservice` (empty on failure)
  # The uptime cat rides the SAME adb round-trip as the dumpsys (one extra `cat`, no extra
  # latency) because the sample AGE is only computable against the phone's own boot clock —
  # see freshness() for why that axis is load-bearing rather than decorative.
  local ser=""; [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
  # The Note3's toolbox shell has no `cut`/`awk` (it answers "cut: not found"), so the phone side
  # stays a bare `cat` and dump_uptime takes the first field on OUR side — the uptime axis must not
  # depend on a binary this body does not have.
  # MIGRATED 2026-07-17: the sensor read was `dumpsys sensorservice` whose android.sensor.light
  # last=<lux,raw,0,ts> is a LATCH that freezes at active-count=0 — the very fossil this tool's
  # freshness() gate exists to CATCH. sensorcat (native ASensorManager listener, ~/.mesh/note3/,
  # [[note3-native-hal-clients]]) registers a real listener so the MAX88922 actually samples → the ts
  # is genuinely fresh, so freshness() now reads LIVE on a live sensor (not STALE on a dead latch).
  # Reformatted to the android.sensor.light last=<lux, raw, 0, ts> line note3_light_raw_line consumes;
  # the MESH_UPTIME line still rides the same round-trip for the age axis. Parse/freshness/--test unchanged.
  local cmd='echo "MESH_UPTIME=$(cat /proc/uptime)"; /data/local/tmp/sensorcat --secs 4 5'
  local raw
  if [ "$NOTE3_ADB_NODE" = local ]; then
    mesh-note3-tool-install sensorcat >/dev/null 2>&1
    raw="$(timeout 20 adb $ser shell "$cmd" 2>/dev/null)"
  else
    [ -z "$NOTE3_ADB_NODE" ] && return 1
    raw="$(timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$NOTE3_ADB_NODE" "adb $ser shell '$cmd' 2>/dev/null" </dev/null 2>/dev/null)"
  fi
  [ -n "$raw" ] || return 1
  printf '%s\n' "$raw" | awk -F'|' '
    /^MESH_UPTIME=/ { print; next }
    $1=="SENSOR" && $3=="5" { printf "MAX88922 RGB Sensor| MAXIM| android.sensor.light| last=<%s, %s, 0, %s>\n", $4,$5,$7 }'
}

# note3_light_raw_line <line> -> "raw,lux,ts" from an android.sensor.light dumpsys line, or empty
# + rc1 if unparseable. ts is values[-1] — the HAL event's OWN ns-since-boot timestamp, which was
# on the wire all along and read by nobody. Pure/offline-testable.
note3_light_raw_line() {
  printf '%s\n' "$1" | awk -F'last=<' '
    /android\.sensor\.light\|/ {
      n = split($2, a, ",")
      if (n >= 4) {
        gsub(/ /,"",a[1]); gsub(/ /,"",a[2]); gsub(/[ >\r]/,"",a[4])
        printf "%s,%s,%s", a[2], a[1], a[4]; exit
      }
    }'
}

# dump_uptime <dump> -> the phone's uptime seconds (first field of the MESH_UPTIME= line
# adb_dumpsys prepends — /proc/uptime's second field is idle time, ignored), or empty + rc1 when
# absent/malformed. rc1 matters: an uncomputable age must fail the read, never default to "fresh".
# Pure/offline-testable.
dump_uptime() {
  printf '%s\n' "$1" | awk '/^MESH_UPTIME=/ { sub(/^MESH_UPTIME=/,""); gsub(/\r/,""); print $1; exit }' | grep -E '^[0-9]+(\.[0-9]+)?$'
}

# freshness <ts_ns> <uptime_s> <max_age_s> -> "LIVE|STALE|NEVER <age_s>"
#
# THE POINT OF THIS TOOL'S EXISTENCE, as of 2026-07-15. `dumpsys sensorservice`'s `last=<...>` is a
# LATCH, not a stream: it holds the last-ever sample FOREVER. With `active-count=0` (no subscriber
# registered — the Note3's steady state, since the only listener that ever attaches is the system's
# auto-brightness, which detaches the moment the screen sleeps at 30s) the MAX88922 reports nothing
# and this latch keeps serving a value that is hours old. Every poll parses it fine, classifies it,
# writes a fresh-mtime state file and exits 0 — a hollow sense that is cron-green, plausible, and
# DEAD. Measured on this node: the light latch sat at raw=2300.0 for 43 consecutive identical reads
# while the reflex reported STABLE and the check dash showed "note3-light-raw STABLE age 3m".
#
# VALUE CANNOT SEPARATE THE TWO — that is not a hypothesis, it was proved by accident: a probe
# (screen_brightness_mode=1) briefly attached a listener, the sensor woke, took real samples, and
# on detach RE-LATCHED at raw=5496.9. A latched-at-5496.9 sensor and a live one reading 5496.9 are
# byte-identical. Only the sample's own ts, against the phone's boot clock, separates "steady" from
# "dead" — and it cannot be faked: mag/baro sat at 4.9h and aged 1:1 with wall clock across two
# independent readers 10 minutes apart.
#
# ts==0 => NEVER, a distinct verdict from STALE: the sensor has not reported ONCE since boot, so
# there is no reading to be stale — the absence of a sample must never render as a reading-shaped
# value (dumpsys prox does exactly this today: ts=0 with values all-zero, which reads as a
# confident "FAR").
#
# max_age is 2x the poll cadence: when a listener IS attached this HAL batches at 200ms, so a
# window 3000x that with no sample means nobody is listening, not that the room went quiet. A
# negative age (clock skew / a sample stamped mid-read) is fresh, never stale. Pure — testable.
freshness() {
  python3 -c "
ts, up, maxa = int('$1'), float('$2'), float('$3')
if ts == 0:
    print('NEVER -'); raise SystemExit
age = up - ts / 1e9
print(('STALE' if age > maxa else 'LIVE'), '%.1f' % age)
"
}

# note3_light_raw — live "raw,lux,ts,uptime" from the MAX88922 dumpsys line. Empty + rc1 on any
# failure (adb down, ssh down, sensor line absent/malformed, uptime unreadable). Test override:
# NOTE3_LIGHT_RAW_DUMP injects a whole dump fixture (uptime line + sensor lines), skipping the
# network — the seam is the DUMP, not the parsed pair, so a fixture exercises the real parse +
# freshness path end to end rather than bypassing the axis under test.
note3_light_raw() {
  local dump out up
  if [ -n "${NOTE3_LIGHT_RAW_DUMP:-}" ]; then
    dump="$NOTE3_LIGHT_RAW_DUMP"
  else
    dump="$(adb_dumpsys)" || return 1
  fi
  [ -n "$dump" ] || return 1
  up="$(dump_uptime "$dump")" || return 1
  [ -n "$up" ] || return 1
  out="$(printf '%s\n' "$dump" | grep 'android\.sensor\.light|' | head -1 | { IFS= read -r l; note3_light_raw_line "$l"; })"
  printf '%s' "$out" | grep -qE '^-?[0-9]+(\.[0-9]+)?,-?[0-9]+(\.[0-9]+)?,[0-9]+$' || return 1
  printf '%s,%s' "$out" "$up"
}

# classify <raw> <prev_raw|""> <thresh_pct> -> "VERDICT DELTA_PCT"
# DELTA_PCT is "-" for INIT (no prior to compare against). Pure function — directly testable.
classify() {
  local raw="$1" praw="$2" thresh="$3"
  if [ -z "$praw" ]; then printf 'INIT -\n'; return; fi
  python3 -c "
raw, praw, thresh = $raw, $praw, $thresh
base = praw if praw != 0 else 1
pct = abs(raw - praw) / abs(base) * 100
print(('CHANGED' if pct >= thresh else 'STABLE'), '%.1f' % pct)
"
}

# board_gate <raw> <confirmed|""> <candidate|""> <count> <thresh_pct> <N> -> "DECISION|conf|cand|count|delta"
# The sustained-change debounce for the BOARD write. Unlike classify() (single-step vs the immediately-
# prior poll), this compares vs the last CONFIRMED level, so a floor-quantization bounce A->B->A stays
# STABLE-vs-confirmed on the return and never accumulates a streak. A raw that CHANGES vs confirmed
# opens a candidate; the candidate must hold (STABLE vs itself) for N consecutive polls before it is
# confirmed and BOARDed — a single-poll spike resets. delta is "-" unless BOARD, then it is the real
# shift magnitude (raw vs the OLD confirmed level, not the ~0% single-step delta at the moment of
# confirmation). Pure — directly testable.
board_gate() {
  python3 -c "
raw=float('$1'); thresh=float('$5'); N=int('$6')
conf='''$2'''.strip(); cand='''$3'''.strip(); cnt='$4'
cnt=int(cnt) if cnt.strip().lstrip('-').isdigit() else 0
def out(d,c,cd,n,dl='-'):
    print('%s|%s|%s|%d|%s' % (d, c, cd, n, dl))
if conf=='':                                   # first read — adopt raw as the baseline, nothing to post
    out('HOLD', '%g'%raw, '', 0); raise SystemExit
cf=float(conf); base=cf if cf!=0 else 1
pct=abs(raw-cf)/abs(base)*100
if pct < thresh:                               # steady at the confirmed level — drop any pending candidate
    out('HOLD', '%g'%cf, '', 0); raise SystemExit
if cand=='':                                   # first poll of a possible new level — open a candidate
    out('HOLD', '%g'%cf, '%g'%raw, 1); raise SystemExit
cd=float(cand); cbase=cd if cd!=0 else 1
cpct=abs(raw-cd)/abs(cbase)*100
if cpct < thresh:                              # candidate held — is the streak long enough to confirm?
    n2=cnt+1
    if n2 >= N:
        out('BOARD', '%g'%raw, '', 0, '%.1f'%pct); raise SystemExit
    out('HOLD', '%g'%cf, '%g'%raw, n2); raise SystemExit
out('HOLD', '%g'%cf, '%g'%raw, 1)              # a different, fresh candidate — restart the streak
"
}

# is_relay_run <arg1> <adb_node> -> rc0 when this is a SCHEDULED --edge poll on a RELAY node
# (adb_node is a non-empty remote host, i.e. NOT "local"). A relay reaches the SAME physical Note3
# by SSH-ing to the direct-adb owner, so its cron poll is pure redundancy — a double board post +
# divergence from racing the same on-change HAL cache — with zero added resilience (the relay read
# already fails whenever the owner is down). The direct-adb owner (adb_node="local") is the sole
# scheduled poster; on-demand reads (no-arg/--json) stay available from any node. Pure — testable.
is_relay_run() { [ "$1" = --edge ] && [ -n "$2" ] && [ "$2" != local ]; }

# ─── --test: fixture-driven classifier + live adb read-gate ────────────────
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0

  r="$(classify 4651.8 "" "$RAW_THRESH_PCT")"
  [ "$(echo "$r" | awk '{print $1}')" = INIT ] || { echo "  FAIL: no prior raw must be INIT, got '$r'"; _f=1; }

  r="$(classify 4700.0 4651.8 15)"
  [ "$(echo "$r" | awk '{print $1}')" = STABLE ] || { echo "  FAIL: tiny jitter (~1%) should be STABLE, got '$r'"; _f=1; }

  r="$(classify 2000.0 4651.8 15)"
  [ "$(echo "$r" | awk '{print $1}')" = CHANGED ] || { echo "  FAIL: large raw swing should be CHANGED, got '$r'"; _f=1; }

  r="$(classify 4651.8 4651.8 15)"
  [ "$(echo "$r" | awk '{print $1}')" = STABLE ] || { echo "  FAIL: identical raw (delta=0) should be STABLE, got '$r'"; _f=1; }
  [ "$(echo "$r" | awk '{print $2}')" = "0.0" ]  || { echo "  FAIL: identical raw delta should print 0.0, got '$r'"; _f=1; }

  # ── dump fixtures: _dump <raw> <age_s> builds a real-shaped adb dump (uptime line + the MAX88922
  # line) whose light sample is exactly <age_s> old. The test seam is the DUMP, so every fixture
  # below drives the true parse + freshness path — the old NOTE3_LIGHT_RAW_OVERRIDE seam handed the
  # tool a pre-parsed "raw,lux" pair and would have sailed straight past the gate under test.
  _UP=800000
  _dump() {
    local _ts; _ts="$(python3 -c "print(int(($_UP - $2) * 1e9))")"
    printf 'MESH_UPTIME=%s\nAK09911C Magnetic field Sensor| AKM| version=1 |android.sensor.magnetic_field| 0x1 | type=2 | last=<-685.8,-90.8,-67.0, 799000000000000>\nMAX88922 RGB Sensor| MAXIM, Inc.| version=1 |android.sensor.light| 0x00000006 | "" | type=5 | on-change | maxDelay=0us |maxRate=5.00Hz | no batching | non-wakeUp | last=< 11.0,%s,  0.0, %s>\n' "$_UP" "$1" "$_ts"
  }

  # parse gate: malformed / absent light line must be rejected, never silently accepted
  NOTE3_LIGHT_RAW_DUMP="MESH_UPTIME=$_UP
MAX88922 RGB Sensor|android.sensor.light| last=<not,a,pair,x>" note3_light_raw >/dev/null 2>&1 && { echo "  FAIL: malformed raw must be rejected"; _f=1; }
  NOTE3_LIGHT_RAW_DUMP="$(_dump 4651.8 5)" note3_light_raw >/dev/null 2>&1 || { echo "  FAIL: well-formed fresh dump must be accepted"; _f=1; }
  # a dump with NO uptime line must be rejected — the age is not computable, and an uncomputable
  # age must never silently degrade to "fresh" (that is the whole bug, one layer down)
  NOTE3_LIGHT_RAW_DUMP='MAX88922 RGB Sensor|android.sensor.light| last=< 11.0,4651.8, 0.0, 799999000000000>' \
    note3_light_raw >/dev/null 2>&1 && { echo "  FAIL: dump with no MESH_UPTIME line must be rejected, not assumed fresh"; _f=1; }

  _fix='MAX88922 RGB Sensor| MAXIM, Inc.| version=1 |android.sensor.light| 0x00000006 | "" | type=5 | on-change | maxDelay=0us |maxRate=5.00Hz | no batching | non-wakeUp | last=< 11.0,4651.8,  0.0, 175726812743590>'
  _parsed="$(note3_light_raw_line "$_fix")"
  [ "$_parsed" = "4651.8,11.0,175726812743590" ] || { echo "  FAIL: dumpsys parse should pick values[1]=raw, values[0]=lux, values[3]=ts (got '$_parsed')"; _f=1; }
  [ "$(dump_uptime "MESH_UPTIME=812019.58
junk")" = "812019.58" ] || { echo "  FAIL: dump_uptime should read the MESH_UPTIME line"; _f=1; }
  dump_uptime "no uptime here" >/dev/null 2>&1 && { echo "  FAIL: dump_uptime must reject a dump with no uptime line"; _f=1; }

  # ── freshness unit (the sample-age axis — chat-review/dumpsys-sample-age-gate) ──
  [ "$(freshness 799999000000000 800000 600 | awk '{print $1}')" = LIVE ]  || { echo "  FAIL: a 1s-old sample must be LIVE"; _f=1; }
  [ "$(freshness 782372000000000 800000 600 | awk '{print $1}')" = STALE ] || { echo "  FAIL: a 4.9h-old sample (the measured mag/baro fossil) must be STALE"; _f=1; }
  [ "$(freshness 0 800000 600 | awk '{print $1}')" = NEVER ]               || { echo "  FAIL: ts=0 must be NEVER, distinctly — not STALE, not a reading"; _f=1; }
  # boundary: the gate is at max_age, and it must be a real edge (not vacuous in either direction)
  [ "$(freshness 799400000000000 800000 600 | awk '{print $1}')" = LIVE ]  || { echo "  FAIL: exactly max_age old must still be LIVE (gate is >, not >=)"; _f=1; }
  [ "$(freshness 799399000000000 800000 600 | awk '{print $1}')" = STALE ] || { echo "  FAIL: one second past max_age must be STALE"; _f=1; }
  [ "$(freshness 800001000000000 800000 600 | awk '{print $1}')" = LIVE ]  || { echo "  FAIL: a negative age (clock skew) must be LIVE, never STALE"; _f=1; }
  [ "$(freshness 782372000000000 800000 600 | awk '{print $2}')" = "17628.0" ] || { echo "  FAIL: freshness must report the real age in seconds"; _f=1; }

  # ── relay-node gate (is_relay_run): scheduled --edge on a RELAY skips; owner + on-demand don't ──
  is_relay_run --edge imozerov@100.125.157.75 || { echo "  FAIL: --edge on a relay node must skip"; _f=1; }
  is_relay_run --edge local                    && { echo "  FAIL: --edge on the direct-adb owner must NOT skip"; _f=1; }
  is_relay_run --edge ''                        && { echo "  FAIL: --edge with no adb node must NOT skip (n/a path handles it)"; _f=1; }
  is_relay_run --json imozerov@100.125.157.75  && { echo "  FAIL: on-demand --json from a relay must NOT skip"; _f=1; }
  is_relay_run '' imozerov@100.125.157.75      && { echo "  FAIL: on-demand no-arg from a relay must NOT skip"; _f=1; }
  # integration: a real relay --edge run must write NOTHING to the board (falsify by reverting the gate)
  _rsd="$(mktemp -d)"; _rboard="$_rsd/chat.log"; : > "$_rboard"
  MESH_DIR="$_rsd" MESH_SKIP_NODES_SOURCE=1 MESH_NOTE3_LIGHT_RAW_BOARD="$_rboard" \
    MESH_NOTE3_ADB_NODE='relay@203.0.113.9' MESH_BARO_ADB_NODE='' "$0" --edge >/dev/null 2>&1
  [ -s "$_rboard" ] && { echo "  FAIL: relay --edge wrote to the board (should skip): $(cat "$_rboard")"; _f=1; }
  rm -rf "$_rsd" 2>/dev/null || true

  # ── board_gate unit (sustained-level debounce, chat-review/note3-light-raw-floor-jitter) ──
  _g() { board_gate "$@" | cut -d'|' -f1; }                       # decision only
  [ "$(_g 2300 '' '' 0 15 2)" = HOLD ]      || { echo "  FAIL: first read (no confirmed) must HOLD + adopt baseline"; _f=1; }
  [ "$(_g 2350 2300 '' 0 15 2)" = HOLD ]    || { echo "  FAIL: steady near confirmed (2%) must HOLD"; _f=1; }
  [ "$(_g 4337 2300 '' 0 15 2)" = HOLD ]    || { echo "  FAIL: 1st poll of a new level must open a candidate (HOLD), not board"; _f=1; }
  [ "$(_g 4337 2300 4337 1 15 2)" = BOARD ] || { echo "  FAIL: candidate held to N=2 must BOARD"; _f=1; }
  [ "$(_g 2300 2300 4337 1 15 2)" = HOLD ]  || { echo "  FAIL: bounce back to confirmed must HOLD (drop candidate), never board"; _f=1; }
  # BOARD delta must be the vs-confirmed magnitude (~88.6%), not the ~0% single-step at confirmation
  _bd="$(board_gate 4337 2300 4337 1 15 2 | cut -d'|' -f5)"
  [ "$_bd" = "88.6" ] || { echo "  FAIL: BOARD delta should be vs-confirmed magnitude 88.6, got '$_bd'"; _f=1; }

  # ── integration: a floor bounce posts 0 lines; a sustained shift posts exactly 1 (task spec) ──
  _esd="$(mktemp -d)"; _eboard="$_esd/chat.log"; : > "$_eboard"
  _poll() {  # <raw> [age_s=5] -> one --edge poll, carrying LEVEL_STATE forward across the sequence
    MESH_DIR="$_esd" MESH_SKIP_NODES_SOURCE=1 MESH_NOTE3_LIGHT_RAW_BOARD="$_eboard" \
      NOTE3_LIGHT_RAW_DUMP="$(_dump "$1" "${2:-5}")" MESH_NOTE3_ADB_NODE='' MESH_BARO_ADB_NODE='' \
      "$0" --edge >/dev/null 2>&1
  }
  # (a) 2300 -> 4337 -> 2300 single-poll quantization bounce -> 0 board lines
  _poll 2300; _poll 4337; _poll 2300
  [ -s "$_eboard" ] && { echo "  FAIL: single-poll floor bounce must post 0 lines (falsify: revert to per-poll %-gate): $(cat "$_eboard")"; _f=1; }
  # (b) sustained shift held 2 polls -> exactly 1 CHANGED line
  rm -f "$_esd/.note3-light-raw-level" "$_esd/.note3-light-raw-state"; : > "$_eboard"
  _poll 2300; _poll 4337; _poll 4337
  _n="$(grep -c '\[note3-light-raw\] CHANGED' "$_eboard" 2>/dev/null || echo 0)"
  [ "$_n" = 1 ] || { echo "  FAIL: sustained 2-poll shift must post exactly 1 CHANGED line, got $_n"; _f=1; }
  grep -q 'delta=88.6%' "$_eboard" 2>/dev/null || { echo "  FAIL: boarded line should carry the vs-confirmed delta 88.6%, got: $(cat "$_eboard")"; _f=1; }
  # (c) INIT (a single first poll) -> NO board line
  rm -f "$_esd/.note3-light-raw-level" "$_esd/.note3-light-raw-state"; : > "$_eboard"
  _poll 4651.8
  [ -s "$_eboard" ] && { echo "  FAIL: INIT (first poll) must NOT post: $(cat "$_eboard")"; _f=1; }

  # ── integration: THE SAMPLE-AGE GATE, end to end (chat-review/dumpsys-sample-age-gate) ──
  # These are the assertions the whole find turns on: a FOSSIL — a dumpsys line that parses
  # perfectly and carries a plausible value — must not be able to produce a reading-shaped
  # verdict, a board post, or a fresh state artifact. To falsify: drop the `!= LIVE` branch in
  # the live-read path and watch every one of these go red.
  _run() {  # <raw> <age_s> -> rc + stdout+stderr of a one-shot (non-edge) poll
    MESH_DIR="$_esd" MESH_SKIP_NODES_SOURCE=1 \
      NOTE3_LIGHT_RAW_DUMP="$(_dump "$1" "$2")" MESH_NOTE3_ADB_NODE='' MESH_BARO_ADB_NODE='' \
      "$0" 2>&1
  }
  rm -f "$_esd/.note3-light-raw-level" "$_esd/.note3-light-raw-state"; : > "$_eboard"
  # (d) the measured fossil: raw=2300.0 latched 4.9h ago -> exit 2, STALE, never a verdict
  _sout="$(_run 2300.0 17628)"; _src=$?
  [ "$_src" = 2 ] || { echo "  FAIL: a 4.9h-old latched sample must exit 2 (honest n/a), got rc=$_src"; _f=1; }
  printf '%s' "$_sout" | grep -q 'STALE' || { echo "  FAIL: a stale sample must say STALE (got: $_sout)"; _f=1; }
  printf '%s' "$_sout" | grep -qE '(INIT|STABLE|CHANGED)' && { echo "  FAIL: a fossil must NOT render a reading-shaped verdict (got: $_sout)"; _f=1; }
  [ -f "$_esd/.note3-light-raw-state" ] && { echo "  FAIL: a fossil must NOT write/refresh the state artifact — it must be left to age so the mtime watchdogs can see it"; _f=1; }
  # (e) ts=0 (the prox case: never reported since boot) -> exit 2, NEVER-REPORTED, never "a reading"
  _nout="$(_run 0.0 800000)"; _nrc=$?
  [ "$_nrc" = 2 ] || { echo "  FAIL: ts=0 (never reported) must exit 2, got rc=$_nrc"; _f=1; }
  printf '%s' "$_nout" | grep -q 'NEVER-REPORTED' || { echo "  FAIL: ts=0 must read as NEVER-REPORTED, distinct from STALE (got: $_nout)"; _f=1; }
  printf '%s' "$_nout" | grep -qE '(INIT|STABLE|CHANGED)' && { echo "  FAIL: ts=0 must NOT render a reading-shaped verdict — the absence of a sample is not an all-clear (got: $_nout)"; _f=1; }
  # (f) the control: the SAME raw value, fresh, DOES assess -> proves the gate keys on age alone
  #     and is not just rejecting everything (a gate that never passes is not a gate).
  _lout="$(_run 2300.0 5)"; _lrc=$?
  [ "$_lrc" = 0 ] || { echo "  FAIL: an identical raw with a FRESH sample must assess (rc=0), got rc=$_lrc — the gate must key on age, not value"; _f=1; }
  printf '%s' "$_lout" | grep -q 'INIT' || { echo "  FAIL: a fresh first read should be INIT (got: $_lout)"; _f=1; }
  printf '%s' "$_lout" | grep -q 'age=5.0s' || { echo "  FAIL: a live read should carry its sample age (got: $_lout)"; _f=1; }
  # (g) a stale sample must post NOTHING to the board, whatever its value shift would imply
  rm -f "$_esd/.note3-light-raw-level" "$_esd/.note3-light-raw-state"; : > "$_eboard"
  _poll 2300 5; _poll 4337 17628; _poll 4337 17628
  [ -s "$_eboard" ] && { echo "  FAIL: a stale sample must never reach the board: $(cat "$_eboard")"; _f=1; }
  rm -rf "$_esd" 2>/dev/null || true

  # ── live adb read-gate (mesh-land treats exit 2 = honest n/a as a pass) ──
  if [ -z "$NOTE3_ADB_NODE" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (MESH_NOTE3_ADB_NODE/MESH_BARO_ADB_NODE unset — Note3 body not configured on this node)"
    exit 2
  fi
  _live="$(note3_light_raw)"
  if [ -z "$_live" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (adb body unreachable — Note3 light-raw sense unavailable)"
    exit 2
  fi
  _raw="$(echo "$_live" | cut -d, -f1)"
  _ok="$(python3 -c "print(1 if 0 <= ($_raw) < 200000 else 0)" 2>/dev/null)"
  [ "$_ok" = 1 ] || { echo "  FAIL: live raw implausible for this ADC: $_live"; _f=1; }
  # The sample-age axis must be REAL on this hardware, not just in the fixtures: assert the live
  # dump yields a ts and a phone uptime that produce an age inside [0, uptime]. This is what goes
  # red if the HAL's last=<> ever stops carrying values[3], or if the uptime/elapsedRealtimeNanos
  # clock bases diverge — i.e. if the one axis that can tell a live sensor from a latch stops working.
  _lts="$(echo "$_live" | cut -d, -f3)"; _lup="$(echo "$_live" | cut -d, -f4)"
  _age_ok="$(python3 -c "
ts, up = int('$_lts'), float('$_lup')
age = up - ts / 1e9
print(1 if (ts == 0 or -5 <= age <= up) else 0)" 2>/dev/null)"
  [ "$_age_ok" = 1 ] || { echo "  FAIL: live sample age not computable/implausible against the phone's boot clock (ts=$_lts uptime=$_lup) — the freshness axis is broken on this hardware"; _f=1; }
  _lfresh="$(freshness "$_lts" "$_lup" "$LIGHT_MAX_AGE_S")"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify/parse/freshness/live-read contract violated)"; exit 1; }
  echo "smoke-test: ok (5 classifier + 3 parse-gate + 2 uptime-parse + 7 freshness unit + 5 relay-gate unit + 1 board-skip + 6 board_gate unit + 3 sustained-gate integration + 11 sample-age-gate integration + LIVE adb read $_live -> $_lfresh)"
  exit 0
fi

# ─── relay-node gate: only the direct-adb owner runs the scheduled --edge poll (see is_relay_run) ─
if is_relay_run "${1:-}" "$NOTE3_ADB_NODE"; then
  echo "note3-light-raw: relay-skip (adb owner=$NOTE3_ADB_NODE; scheduled poll deferred to the direct-adb owner — no double board post)"
  exit 0
fi

# ─── live read ───────────────────────────────────────────────────────────
pair="$(note3_light_raw)"
if [ -z "$pair" ]; then
  echo "note3-light-raw: UNREACHABLE (adb body offline/unreadable/sensor line absent)" >&2
  [ "${1:-}" = --json ] && printf '{"verdict":"UNREACHABLE"}\n'
  exit 2
fi
raw="$(echo "$pair" | cut -d, -f1)"; lux="$(echo "$pair" | cut -d, -f2)"
hal_ts="$(echo "$pair" | cut -d, -f3)"; up="$(echo "$pair" | cut -d, -f4)"

# ─── sample-age gate: a latched fossil is an ABSENT sense, not a STABLE one ───────
# Exit 2 (honest n/a) rather than 0 — the phone is reachable and the line parses, but the MAX88922
# has produced nothing, so there is no current reading to report. STATE is deliberately NOT written
# or touched on this path: the state file must be allowed to AGE, so the mtime watchdogs
# (mesh-reflex-health/mesh-pulse) can finally see what a fresh-mtime-carrying-a-4-hour-old-sample
# hid from them. A dead sense should look dead.
fresh="$(freshness "$hal_ts" "$up" "$LIGHT_MAX_AGE_S")"
fverdict="$(echo "$fresh" | awk '{print $1}')"; age="$(echo "$fresh" | awk '{print $2}')"
if [ "$fverdict" != LIVE ]; then
  if [ "$fverdict" = NEVER ]; then
    reason="NEVER-REPORTED (ts=0 — the MAX88922 has not produced a single sample since boot; raw=$raw/lux=$lux are the HAL's zero-init, not a reading)"
  else
    reason="STALE (last sample ${age}s old > ${LIGHT_MAX_AGE_S}s — dumpsys last=<> is a latch and nothing is listening; raw=$raw/lux=$lux is a fossil, not a current reading)"
  fi
  echo "note3-light-raw: $reason" >&2
  [ "${1:-}" = --json ] && printf '{"verdict":"%s","age_s":"%s","latched_raw":%s,"latched_lux":%s}\n' "$fverdict" "$age" "$raw" "$lux"
  exit 2
fi

praw=""
if [ -f "$STATE" ]; then
  IFS='|' read -r _pv praw _plux _pts < "$STATE" 2>/dev/null || true
fi

result="$(classify "$raw" "${praw:-}" "$RAW_THRESH_PCT")"
verdict="$(echo "$result" | awk '{print $1}')"
delta="$(echo "$result" | awk '{print $2}')"
wts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# age= is appended so the artifact carries the sample's OWN freshness, not just the poll's mtime —
# the exact pair whose divergence (4-min-young file, 2.5-hour-old sample) hid the fossil.
printf '%s|%s|%s|%s|age=%s\n' "$verdict" "$raw" "$lux" "$wts" "$age" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # ran-live liveness, independent of value-changed

case "${1:-}" in
  --json)
    printf '{"verdict":"%s","raw":%s,"lux":%s,"delta_pct":"%s","age_s":"%s","ts":"%s"}\n' "$verdict" "$raw" "$lux" "$delta" "$age" "$wts"
    ;;
  --edge)
    # Board ONLY when a NEW raw level has PERSISTED N consecutive polls (board_gate). A discrete
    # dark-floor quantization bounce (A->B->A) stays STABLE-vs-confirmed on the return, never
    # accumulates a streak, and posts nothing — the single-step classify verdict above already
    # went to STATE/--json for fine-grained consumers. board_gate carries confirmed|candidate|count
    # forward in LEVEL_STATE; only a confirmed shift writes the board (with the real vs-confirmed delta).
    lconf=""; lcand=""; lcnt=0
    [ -f "$LEVEL_STATE" ] && IFS='|' read -r lconf lcand lcnt < "$LEVEL_STATE" 2>/dev/null || true
    gate="$(board_gate "$raw" "${lconf:-}" "${lcand:-}" "${lcnt:-0}" "$RAW_THRESH_PCT" "$LIGHT_SUSTAIN_N")"
    IFS='|' read -r decision nconf ncand ncnt bdelta <<EOF
$gate
EOF
    printf '%s|%s|%s\n' "$nconf" "$ncand" "$ncnt" > "$LEVEL_STATE"
    if [ "$decision" = BOARD ]; then
      board="${MESH_NOTE3_LIGHT_RAW_BOARD:-$MESH/chat.log}"
      ts_board="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      printf '%s  note3-light-raw@%s  ::  [note3-light-raw] CHANGED (raw=%s lux=%s delta=%s%%)\n' "$ts_board" "$(hostname)" "$raw" "$lux" "$bdelta" >> "$board" 2>/dev/null || true
    fi
    printf 'note3-light-raw: %s (raw=%s lux=%s delta=%s%% age=%ss gate=%s)\n' "$verdict" "$raw" "$lux" "$delta" "$age" "$decision"
    ;;
  *)
    printf 'note3-light-raw: %s (raw=%s lux=%s delta=%s%% age=%ss)\n' "$verdict" "$raw" "$lux" "$delta" "$age"
    ;;
esac
exit 0
