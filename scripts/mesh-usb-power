#!/usr/bin/env bash
# mesh-usb-power — USB RUNTIME-POWER sense: is this host's USB hardware actually
#   DRAWING POWER right now, or has the kernel autosuspended it?
#   mesh-usb/mesh-usb-events see IDENTITY (what's plugged in / attach-detach); this
#   reads a different layer entirely — /sys/bus/usb/devices/*/power/{control,
#   runtime_status,active_duration}, the kernel USB runtime-PM state machine. A
#   device can be PRESENT (mesh-usb sees it) yet SUSPENDED (idle, drawing near-zero
#   power) or ACTIVE (currently powered — recently used or exempt from autosuspend).
#   For the builtin webcam this is a real activity signal distinct from
#   mesh-capture-inuse's v4l2-handle check: it's the hardware's own power state, not
#   a software open-file count — catches activity even if a capture tool bypasses
#   v4l2 bookkeeping, and conversely a v4l2 handle can be held open with the device
#   still autosuspended between frames.
# HONEST: exit 2 (BLIND) when /sys/bus/usb is absent (VM/container, no USB
#   passthrough) — never a faked "all suspended" from an unreadable bus.
# orphan-ok: on-demand query, same shape as mesh-usb (pulled when asked or by a
#   fusion consumer, not scheduled). Stateless snapshot — no persisted STATE file,
#   so no mesh-state-touch needed.
# Modes: (none) human read · --list (STABLE TSV: <product>\t<vid:pid>\t<control>\t
#   <runtime_status>\t<active_duration_ms>) · --status (one-line ACTIVE/IDLE/BLIND
#   verdict) · --test
set -u

ROOT_HUB_VID="1d6b"   # Linux Foundation — the controllers' own root hubs, not peripherals

usb_dir() { echo "${MESH_USB_DIR:-/sys/bus/usb/devices}"; }

# scan_power — emit one TSV line per real (non-root-hub) USB device with a power/ node:
#   <name>\t<vid:pid>\t<control>\t<runtime_status>\t<active_duration_ms>
scan_power() {
  local dir d vid prod pid ctrl rs adur
  dir="$(usb_dir)"
  for d in "$dir"/*/; do
    [ -e "$d/power/runtime_status" ] || continue   # only nodes with a runtime-PM state
    vid=$(cat "$d/idVendor" 2>/dev/null)
    [ "$vid" = "$ROOT_HUB_VID" ] && continue        # skip the controllers' own root hubs
    prod=$(cat "$d/product" 2>/dev/null)
    [ -n "$prod" ] || continue                      # skip bare interface dirs (no product)
    pid=$(cat "$d/idProduct" 2>/dev/null)
    ctrl=$(cat "$d/power/control" 2>/dev/null); ctrl="${ctrl:-?}"
    rs=$(cat "$d/power/runtime_status" 2>/dev/null); rs="${rs:-?}"
    adur=$(cat "$d/power/active_duration" 2>/dev/null); adur="${adur:-?}"
    printf '%s\t%s:%s\t%s\t%s\t%s\n' "${prod:-?}" "$vid" "$pid" "$ctrl" "$rs" "$adur"
  done
}

# --- portable logic self-test (fixture) + a live real-read gate -------------------
if [ "${1:-}" = "--test" ]; then
  tmp=$(mktemp -d)
  # an actively-powered peripheral
  mkdir -p "$tmp/2-1/power"; printf 'Kingston DataTraveler' >"$tmp/2-1/product"
  echo 0951 >"$tmp/2-1/idVendor"; echo 1666 >"$tmp/2-1/idProduct"
  echo on >"$tmp/2-1/power/control"; echo active >"$tmp/2-1/power/runtime_status"
  echo 12345 >"$tmp/2-1/power/active_duration"
  # an autosuspended internal device (e.g. idle webcam)
  mkdir -p "$tmp/1-5/power"; printf 'Integrated Camera' >"$tmp/1-5/product"
  echo 174f >"$tmp/1-5/idVendor"; echo 118d >"$tmp/1-5/idProduct"
  echo auto >"$tmp/1-5/power/control"; echo suspended >"$tmp/1-5/power/runtime_status"
  echo 99 >"$tmp/1-5/power/active_duration"
  # a root hub (MUST be excluded)
  mkdir -p "$tmp/usb1/power"; printf 'xHCI Host Controller' >"$tmp/usb1/product"
  echo 1d6b >"$tmp/usb1/idVendor"; echo 0002 >"$tmp/usb1/idProduct"
  echo auto >"$tmp/usb1/power/control"; echo active >"$tmp/usb1/power/runtime_status"
  # an interface dir (no product, but has a power node → MUST be ignored)
  mkdir -p "$tmp/1-5:1.0/power"; echo auto >"$tmp/1-5:1.0/power/control"
  echo active >"$tmp/1-5:1.0/power/runtime_status"

  fail=""
  out=$(MESH_USB_DIR="$tmp" scan_power)
  n=$(printf '%s\n' "$out" | grep -c .)
  [ "$n" = 2 ] || fail="$fail expected-2-devices-got-$n"
  printf '%s\n' "$out" | grep -q 'Kingston DataTraveler.*active' || fail="$fail missing-active-peripheral"
  printf '%s\n' "$out" | grep -q 'Integrated Camera.*suspended' || fail="$fail missing-suspended-internal"
  printf '%s\n' "$out" | grep -q 'xHCI' && fail="$fail root-hub-not-excluded"
  # --list: stable TSV interface — same lines, 5 tab-separated columns
  lout=$(MESH_USB_DIR="$tmp" bash "$0" --list)
  [ "$lout" = "$out" ] || fail="$fail list-differs-from-scan"
  lcols=$(printf '%s\n' "$lout" | awk -F'\t' 'NF!=5{bad=1} END{print bad+0}')
  [ "$lcols" = 0 ] || fail="$fail list-not-5-columns"
  # --status verdict: one suspended + one active → ACTIVE (at least one device powered)
  st=$(MESH_USB_DIR="$tmp" bash "$0" --status)
  echo "$st" | grep -q '^ACTIVE ' || fail="$fail status-not-active-$st"
  # all-suspended fixture → IDLE verdict
  tmp2=$(mktemp -d)
  mkdir -p "$tmp2/1-5/power"; printf 'Integrated Camera' >"$tmp2/1-5/product"
  echo 174f >"$tmp2/1-5/idVendor"; echo 118d >"$tmp2/1-5/idProduct"
  echo auto >"$tmp2/1-5/power/control"; echo suspended >"$tmp2/1-5/power/runtime_status"
  echo 99 >"$tmp2/1-5/power/active_duration"
  st2=$(MESH_USB_DIR="$tmp2" bash "$0" --status)
  echo "$st2" | grep -q '^IDLE ' || fail="$fail status-not-idle-$st2"
  rm -rf "$tmp2"
  # absent bus → BLIND exit 2 (the honest-exit contract; every mode inherits it)
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail absent-bus-not-exit2"
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" --list >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail list-absent-bus-not-exit2"
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" --status >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail status-absent-bus-not-exit2"
  rm -rf "$tmp"

  # real-read gate: the live bus must yield at least one device with a genuine
  # runtime_status value (active|suspended) — proves this isn't just exercising the
  # fixture path (the mesh-mag/-n1-race lesson: a hollow read looks green forever).
  real=$(scan_power)
  realn=$(printf '%s\n' "$real" | awk -F'\t' '$5 ~ /^[0-9]+$/ || $4 ~ /^(active|suspended)$/' | grep -c .)
  if [ -d "$(usb_dir)" ] && [ "$realn" -lt 1 ]; then
    fail="$fail live-read-yielded-no-real-power-state"
  fi

  if [ -n "$fail" ]; then echo "smoke-test: FAIL ($fail )"; exit 1; fi
  echo "smoke-test: ok (2 fixture devices parsed, root-hub+interface excluded, --list stable TSV, ACTIVE/IDLE verdicts, absent-bus->exit2 all 3 modes, live real-read gate: $realn device(s))"
  exit 0
fi

# --- availability: the honest exit-2 gate -----------------------------------------
DIR="$(usb_dir)"
if [ ! -d "$DIR" ]; then
  echo "mesh-usb-power: BLIND — no USB bus at $DIR (VM/container without USB passthrough) — NOT 'all idle'"
  exit 2
fi

devs="$(scan_power)"

# --- stable machine interface ------------------------------------------------------
if [ "${1:-}" = "--list" ]; then
  printf '%s\n' "$devs"
  exit 0
fi

total=$(printf '%s\n' "$devs" | grep -c .)
active=$(printf '%s\n' "$devs" | awk -F'\t' '$4=="active"' | grep -c .)
suspended=$(printf '%s\n' "$devs" | awk -F'\t' '$4=="suspended"' | grep -c .)

# --- one-line fusion verdict --------------------------------------------------------
if [ "${1:-}" = "--status" ]; then
  if [ "$active" -gt 0 ]; then
    echo "ACTIVE ${active}/${total} device(s) powered (${suspended} suspended)"
  else
    echo "IDLE ${total} device(s), all suspended"
  fi
  exit 0
fi

# --- one-shot human read ------------------------------------------------------------
echo "usb-power: ${total} device(s) — ${active} active(powered) · ${suspended} suspended(idle)"
printf '%s\n' "$devs" | while IFS=$'\t' read -r name vidpid ctrl rs adur; do
  [ -n "$name" ] || continue
  echo "  • $name [$vidpid] control=${ctrl} state=${rs} active_ms=${adur}"
done
exit 0
