#!/usr/bin/env bash
# reflex-cadence: 1-59/5 * * * *
# reflex-args: --edge
# mesh-wifi-rf — this NODE's own WiFi RF-layer sense: reads the kernel's live
# /proc/net/wireless counters for the local wireless NIC (link quality, signal
# level dBm, noise floor, retry/misc discard counts, missed-beacon count).
#
# Gap this closes: mesh-wifi-link already senses the PHONE body's WiFi link via
# termux-wifi-connectioninfo — but the mind node's OWN radio (the box actually
# running the agent) had no RF-layer sense at all. A degrading signal level or a
# climbing retry/misc discard count on THIS node's NIC explains flaky egress /
# SSH drops the way mesh-therm-watch explains flaky compute — a distinct failure
# mode from thermal throttle or CPU load that mesh-stress already fuses.
#
# Data source: /proc/net/wireless (kernel wireless-extensions counters, zero
# extra deps — no `iw`/`iwconfig` required). Values are CUMULATIVE since the
# interface was brought up (discard/misc/beacon counts), so a rising slope
# between polls (not the absolute number) is the interference signal; the
# level/quality fields are instantaneous.
#
# Usage:
#   mesh-wifi-rf            one-shot quality verdict to stdout
#   mesh-wifi-rf --edge     emit only on quality-class change (2-consecutive debounce)
#   mesh-wifi-rf --json     machine-readable JSON
#   mesh-wifi-rf --test     smoke test (parser fixture + live real-read gate)
#
# Signals:
#   link:    driver-reported link quality (raw units, driver-dependent max — informational)
#   level:   RSSI in dBm (absolute scale, used for classification)
#   noise:   noise floor in dBm (-256 = driver does not report noise; honest "n/a", not zero)
#   retry/misc/discarded_nwid/discarded_crypt/discarded_frag: cumulative discard counters
#   missed_beacon: cumulative missed-beacon count (AP unreachable ticks)
#
# Classification (by RSSI level dBm — mirrors mesh-wifi-link's phone thresholds):
#   EXCELLENT = level >= -50
#   GOOD      = level >= -60
#   FAIR      = level >= -70
#   POOR      = level <  -70
#   DISCONNECTED = no associated wireless interface found in /proc/net/wireless
#
# Exit codes (honest-exit contract):
#   0 = quality assessed
#   2 = no wireless interface present/associated on this node — never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PROC_WIRELESS="${MESH_WIFI_RF_PROC:-/proc/net/wireless}"
STATE="$HOME/.mesh/.wifi-rf.state"

# parse_wireless <file> <iface|""> -> "iface link level noise retry misc nwid crypt frag beacon"
# or empty on no associated interface. Pure (no side effects) — testable on a fixture file.
PARSE_PY='
import sys, re
path, want_iface = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        lines = f.readlines()
except OSError:
    sys.exit(0)
best = None
for ln in lines[2:]:
    ln = ln.strip()
    if not ln or ":" not in ln:
        continue
    iface, rest = ln.split(":", 1)
    iface = iface.strip()
    if want_iface and iface != want_iface:
        continue
    nums = re.findall(r"-?\d+", rest)
    if len(nums) < 9:
        continue
    # status link level noise nwid crypt frag retry misc missed_beacon
    status, link, level, noise, nwid, crypt, frag, retry, misc = nums[:9]
    beacon = nums[9] if len(nums) > 9 else "0"
    row = (iface, link, level, noise, retry, misc, nwid, crypt, frag, beacon)
    # prefer an interface that is actually reporting a non-zero link (associated)
    if best is None or (int(link) > int(best[1])):
        best = row
if best:
    print(" ".join(best))
'

read_wireless() {   # echoes parsed row or empty; rc 0 = row found, rc 2 = no wireless iface
  local row
  row="$(python3 -c "$PARSE_PY" "$PROC_WIRELESS" "${MESH_WIFI_RF_IFACE:-}" 2>/dev/null)"
  [ -n "$row" ] && { printf '%s' "$row"; return 0; }
  return 2
}

classify() {   # $1=level -> quality string
  local level="$1"
  if [ -z "$level" ]; then echo "UNKNOWN"; return; fi
  if   [ "$level" -ge -50 ]; then echo "EXCELLENT"
  elif [ "$level" -ge -60 ]; then echo "GOOD"
  elif [ "$level" -ge -70 ]; then echo "FAIR"
  else echo "POOR"; fi
}

if [ "${1:-}" = --test ]; then
  f=0
  # (1) PURE parser fixture — deterministic, no hardware needed
  td="$(mktemp -d /tmp/mesh-wifi-rf-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat > "$td/fixture" <<'EOF'
Inter-| sta-|   Quality        |   Discarded packets               | Missed | WE
 face | tus | link level noise |  nwid  crypt   frag  retry   misc | beacon | 22
wlp0s20f3: 0000   43.  -67.  -256        0      0      0      0  48820        0
EOF
  row="$(python3 -c "$PARSE_PY" "$td/fixture" "" 2>/dev/null)"
  case "$row" in
    "wlp0s20f3 43 -67 -256 0 48820 0 0 0 0") : ;;
    *) echo "  FAIL: fixture parse mismatch (got: '$row')"; f=1 ;;
  esac
  [ "$(classify -67)" = "FAIR" ] || { echo "  FAIL: classify(-67) expected FAIR"; f=1; }
  [ "$(classify -45)" = "EXCELLENT" ] || { echo "  FAIL: classify(-45) expected EXCELLENT"; f=1; }
  [ "$(classify -80)" = "POOR" ] || { echo "  FAIL: classify(-80) expected POOR"; f=1; }
  [ "$(classify "")" = "UNKNOWN" ] || { echo "  FAIL: classify(empty) expected UNKNOWN"; f=1; }
  # no-interface fixture -> honest empty/absent
  printf 'Inter-| sta-|   Quality\n face | tus | link\n' > "$td/empty"
  row_empty="$(python3 -c "$PARSE_PY" "$td/empty" "" 2>/dev/null)"
  [ -z "$row_empty" ] || { echo "  FAIL: header-only file must parse to empty (got: '$row_empty')"; f=1; }
  [ "$f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }

  # (2) REAL-READ GATE: on THIS node, assert a live /proc/net/wireless read produces numeric fields.
  # A node with no wireless NIC (ethernet-only) honestly has nothing to read — n/a, not FAIL.
  if [ ! -r "$PROC_WIRELESS" ]; then
    echo "smoke-test: n/a (no $PROC_WIRELESS on this node — no wireless subsystem)"; exit 2
  fi
  live_row="$(read_wireless)" || { echo "smoke-test: n/a (no associated wireless interface — no WiFi RF sense here)"; exit 2; }
  live_level="$(printf '%s' "$live_row" | awk '{print $3}')"
  case "$live_level" in
    -[0-9]*|[0-9]*) echo "smoke-test: ok (fixture parse + classify unit + LIVE read: $live_row)"; exit 0 ;;
    *) echo "  FAIL: live read did not yield a numeric level (got: '$live_row')"; exit 1 ;;
  esac
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0
if [ "${1:-}" = --edge ]; then EDGE=1; MODE=edge; fi
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

row="$(read_wireless)" || {
  echo "mesh-wifi-rf: no associated wireless interface on this node — no WiFi RF sense" >&2
  exit 2
}
read -r iface link level noise retry misc nwid crypt frag beacon <<<"$row"

quality="$(classify "$level")"
noise_h="n/a"; [ "$noise" != "-256" ] && noise_h="${noise}dBm"
reason="link=${link} level=${level}dBm noise=${noise_h} retry=${retry} misc=${misc} beacon_missed=${beacon}"
signals="iface=${iface} link=${link} level=${level}dBm noise=${noise_h}"

case "$MODE" in
  json)
    printf '{"quality":"%s","iface":"%s","link":%s,"level":%s,"noise":%s,"retry":%s,"misc":%s,"discarded_nwid":%s,"discarded_crypt":%s,"discarded_frag":%s,"missed_beacon":%s,"reason":"%s","ts":"%s"}\n' \
      "$quality" "$iface" "$link" "$level" "$noise" "$retry" "$misc" "$nwid" "$crypt" "$frag" "$beacon" "$reason" "$TS"
    ;;
  edge)
    PENDING="${STATE%.state}.pending"
    confirmed="$(cat "$STATE" 2>/dev/null || true)"
    pending_line="$(cat "$PENDING" 2>/dev/null || true)"
    pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

    if [ -z "$confirmed" ]; then
      printf '%s\n' "$quality" > "$STATE"; rm -f "$PENDING"
    elif [ "$quality" = "$confirmed" ]; then
      rm -f "$PENDING"
    elif [ "$quality" = "$pending" ]; then
      pcount=$((pcount + 1))
      if [ "$pcount" -ge 2 ]; then
        printf '%s\n' "$quality" > "$STATE"; rm -f "$PENDING"
        printf '[wifi-rf] %s — %s [%s]\n' "$quality" "$reason" "$signals"
      else
        printf '%s:%d\n' "$quality" "$pcount" > "$PENDING"
      fi
    else
      printf '%s:1\n' "$quality" > "$PENDING"
    fi
    # liveness-touch: this run evaluated successfully even when the class HELD (no rewrite above) —
    # refresh mtime so mesh-reflex-health never mis-reads "value stable" as "reflex dead".
    mesh-state-touch --create "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null
    ;;
  *)
    printf '[wifi-rf] %s — %s [%s]\n' "$quality" "$reason" "$signals"
    ;;
esac
