#!/usr/bin/env bash
# mesh-hub-criticality — SOC-inspired per-node "blast radius" index for the mesh's own topology.
#
# LITERATURE (live review, genome, 2026-07-06): "A Self-Organized Criticality Model of Extreme Events
# and Cascading Disasters of Hub-and-Spoke Air Traffic Networks" (arXiv:2506.16727, Jun 2025). The
# paper's operational mechanism: hub-and-spoke networks are SOC-fragile because a small number of
# high-throughput/high-betweenness hubs concentrate failure-propagation risk, and it proposes a per-node
# composite "Criticality Index" C_i = w1*(degree/max degree) + w2*(betweenness/max betweenness) +
# w3*(failure_frequency/max failure_frequency) to RANK which hub is the biggest cascading-disaster risk
# — not just monitor one aggregate signal.
#
# CROSS-DOMAIN TRANSFER: `~/lte-workstation`'s existing SOC tooling (mesh-criticality, 9 prior literature
# reviews under ~/.mesh/knowledge/*criticality*) is entirely about the mesh's AGGREGATE BOARD-EVENT
# time series (one branching-ratio m̂ signal). It has never asked the paper's actual question at the
# NODE level: of the mesh's own nodes, which one's failure would cascade the widest? Today that
# question is answered only by operator PROSE (CLAUDE.local.md: "was a SPOF, retired 2026-06-10") —
# manually noticed, manually fixed, never a live instrument. This tool is a first, deliberately-honest
# approximation of the paper's C_i for THIS mesh:
#   - degree/betweenness proxy: this mesh keeps no live dependency graph, so we substitute the node's
#     DECLARED role (MESH_ROLES) as a coarse centrality proxy — a "router" is the sole LAN gateway
#     (everything LAN-side loses reachability if it dies); an (unset-role) "mind" node tends to be an
#     orchestration/dispatch/VPN-egress hub other nodes route through; "compute"/"sense" are leaves.
#     This is NOT a computed graph metric — it is honestly a role-declared proxy, named as such below.
#   - failure_frequency: real, not proxied — counts recent hardware/thermal/network alert board lines
#     mentioning the node, exactly the paper's empirical failure-history term.
#   C_i = W_ROLE*role_weight + W_FAIL*(failure_count / max failure_count across nodes)
#
#   mesh-hub-criticality [--window-hours N] [--json]   rank known nodes, highest C_i first (default 24h)
#   mesh-hub-criticality --test                        smoke test
#
# Honest: exit 2 (UNAVAILABLE) if ~/.mesh/nodes is missing — never fakes a topology.
# orphan-ok: on-demand hub-criticality analysis (informational; topology/roles change slowly — pull on
#   demand or fold into mesh-digest; no cadence needed).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
NODES_FILE="${MESH_NODES_FILE:-$HOME/.mesh/nodes}"
CHAT="${MESH_HC_CHATLOG:-$HOME/.mesh/chat.log}"
# Backslashes are DOUBLED because these are consumed as awk DYNAMIC regexes via -v: awk processes
# escape sequences in a -v value, so '\[' arrives as a plain '[' and the intended group degrades into
# a bracket EXPRESSION. That is not a style nit — it is how this tool was born broken (2026-07-07):
# ALERT_RE became /[(node-hot|hw-fault|...)]/, whose 'w-f' is an invalid range, so awk died FATAL on
# every call and failure_count printed nothing for 9 days; PRESSURE_RE became /[node-pressure]/, a
# character class matching any ONE of those letters, so it matched nearly every board line instead.
# Keep the doubling, or re-test with: awk -v are="$ALERT_RE" 'BEGIN{print are}' — it must print '\['.
ALERT_RE='\\[(node-hot|hw-fault|cpu-throttling|node-accelerating|reflex-stale)\\]'
# PRESSURE_RE (chat-review/node-hot-marker-axis-collision, 2026-07-07): kept SEPARATE from
# ALERT_RE/failure_count on purpose. Before this fix, mesh-resource-guard's memory/swap-pressure
# edge ALSO posted bare '[node-hot]' — the same token mesh-node-care uses for its THERMAL
# Schmitt-trigger — so this tool's C_i failure_frequency term (and mesh-stress's allostatic-load
# count) silently absorbed memory pressure as if it were thermal stress, and a combined-pressure
# episode double-counted one real event across two emitters. resource-guard now emits its own
# '[node-pressure]' marker (fix landed in mesh-resource-guard); C_i's failure_frequency axis stays
# THERMAL-ONLY (unchanged formula/weights — this is a reporting fix, not a re-weighting), and
# pressure_count() below is a SEPARATE, parallel, non-C_i-contributing count — visible for anyone
# who wants the memory axis, never conflated with the thermal one.
PRESSURE_RE='\\[node-pressure\\]'   # doubled — see the -v dynamic-regex note on ALERT_RE above

# role_weight — the honest proxy for degree/betweenness centrality (see header). Pure: no I/O.
role_weight() { # $1=role
  case "${1:-}" in
    router)  printf '1.00' ;;
    compute) printf '0.35' ;;
    sense)   printf '0.20' ;;
    *)       printf '0.60' ;;   # unset/"mind": orchestration/dispatch/egress hub, moderate-high default
  esac
}

# node_aliases — board lines use inconsistent forms for the same node (bare mesh-nodes label like
# "default-string", OR the full tailscale hostname like "imozerov-Default-string", OR "GL-MT3000" for
# the router) — mirrors mesh-fleet-health's peer_name() normalization, inverted for grep-matching.
node_aliases() { # $1=label -> newline-separated aliases to grep for
  local l="$1"
  printf '%s\n' "$l"
  case "$l" in
    ideapad)         printf '%s\n' "IdeaPad" "imozerov-IdeaPad" ;;
    default-string|server) printf '%s\n' "default-string" "imozerov-Default-string" ;;
    router|GL-MT3000) printf '%s\n' "router" "GL-MT3000" ;;
    Redmi|phone)     printf '%s\n' "Redmi" ;;
  esac
}

# failure_count — real signal (not proxied): count of recent alert-shaped board lines mentioning any
# alias of this node, within the lookback window. Pure function of (aliases, cutoff, board text).
# BODY-ANCHORED (board-marker-grep-must-anchor-to-body): match only the text AFTER the ' :: ' separator
# — the WHO/poster field (e.g. 'node-care@imozerov-IdeaPad...') otherwise false-matches every alert any
# OTHER node posted about a third node, since the poster's own hostname sits earlier on the same line
# (live bug caught testing this tool: ideapad's count included 98 hits, ~90 of them alerts ABOUT
# default-string that ideapad's own node-care reflex merely reported).
failure_count() { # $1=label $2=cutoff-iso  (reads $CHAT) — THERMAL/hardware axis only (ALERT_RE)
  local label="$1" cutoff="$2" pat
  pat="$(node_aliases "$label" | paste -sd'|' -)"
  [ -r "$CHAT" ] || { echo 0; return; }
  awk -v cut="$cutoff" -v pat="$pat" -v are="$ALERT_RE" '
    { sep = index($0, " :: "); if (sep == 0) next; body = substr($0, sep + 4) }
    $1 >= cut && body ~ are && body ~ pat { n++ } END { print n+0 }
  ' "$CHAT"
}

# pressure_count — the MEMORY/swap axis, separately (never blended into failure_count/C_i — see
# PRESSURE_RE above). Same body-anchored window+alias filter, different marker regex.
pressure_count() { # $1=label $2=cutoff-iso  (reads $CHAT)
  local label="$1" cutoff="$2" pat
  pat="$(node_aliases "$label" | paste -sd'|' -)"
  [ -r "$CHAT" ] || { echo 0; return; }
  awk -v cut="$cutoff" -v pat="$pat" -v are="$PRESSURE_RE" '
    { sep = index($0, " :: "); if (sep == 0) next; body = substr($0, sep + 4) }
    $1 >= cut && body ~ are && body ~ pat { n++ } END { print n+0 }
  ' "$CHAT"
}

if [ "${1:-}" = --test ]; then
  fail=""
  [ "$(role_weight router)"  = "1.00" ] || fail="$fail role-router"
  [ "$(role_weight sense)"   = "0.20" ] || fail="$fail role-sense"
  [ "$(role_weight compute)" = "0.35" ] || fail="$fail role-compute"
  [ "$(role_weight)"         = "0.60" ] || fail="$fail role-default"

  # failure_count: fixture board, alert-shaped lines within/outside window, non-alert lines excluded
  et="$(mktemp -d)"; board="$et/board.log"
  now_cut="$(date -u -d '24 hours ago' +%FT%TZ 2>/dev/null)"
  recent_ts="$(date -u -d '1 hour ago' +%FT%TZ 2>/dev/null)"
  old_ts="$(date -u -d '48 hours ago' +%FT%TZ 2>/dev/null)"
  cat > "$board" <<EOF
${recent_ts}  node-care@x  ::  [node-hot] default-string HOT :: temp=90C
${recent_ts}  node-care@x  ::  [node-hot] default-string HOT :: temp=91C
${recent_ts}  node-care@x  ::  [node-ok] default-string hardware healthy again
${old_ts}  node-care@x  ::  [node-hot] default-string HOT :: temp=95C
${recent_ts}  senses@x  ::  [fyi] default-string looked at, nothing alert-shaped here
EOF
  # direct call in a clean subshell (functions redeclared there so ALERT_RE/CHAT overrides are local
  # to the fixture, never touching the real board)
  n_ds=$(bash -c "
    CHAT='$board'; ALERT_RE='$ALERT_RE'
    $(declare -f node_aliases)
    $(declare -f failure_count)
    failure_count default-string '$now_cut'
  ")
  [ "$n_ds" = 2 ] || fail="$fail count-window-and-marker-filter:[$n_ds]"   # 2 in-window alert lines; the old one + the node-ok + the fyi must NOT count
  n_router=$(bash -c "
    CHAT='$board'; ALERT_RE='$ALERT_RE'
    $(declare -f node_aliases)
    $(declare -f failure_count)
    failure_count router '$now_cut'
  ")
  [ "$n_router" = 0 ] || fail="$fail count-no-false-match:[$n_router]"

  # node-hot-marker-axis-collision: a resource-guard [node-pressure] (memory axis) must NOT be
  # counted by failure_count (thermal axis, ALERT_RE) — and must be counted, separately, by
  # pressure_count (PRESSURE_RE). A co-occurring node-care [node-ok] (thermal recovery, same
  # window) must not itself register as a failure on either axis. Falsify: revert
  # mesh-resource-guard to emit bare '[node-hot]' for pressure and this fixture's thermal count
  # goes from 0 to 1 (conflated again).
  axboard="$et/axis.log"; mkdir -p "$et"
  cat > "$axboard" <<EOF
${recent_ts}  resource-guard@x  ::  [node-pressure] default-string NODE-PRESSURE: SwapFree 3MB
${recent_ts}  node-care@x  ::  [node-ok] default-string hardware healthy again
EOF
  ax_thermal=$(bash -c "
    CHAT='$axboard'; ALERT_RE='$ALERT_RE'
    $(declare -f node_aliases)
    $(declare -f failure_count)
    failure_count default-string '$now_cut'
  ")
  ax_pressure=$(bash -c "
    CHAT='$axboard'; PRESSURE_RE='$PRESSURE_RE'
    $(declare -f node_aliases)
    $(declare -f pressure_count)
    pressure_count default-string '$now_cut'
  ")
  [ "$ax_thermal" = 0 ]  || fail="$fail axis-collision-thermal-conflated:[$ax_thermal]"
  [ "$ax_pressure" = 1 ] || fail="$fail axis-collision-pressure-not-counted:[$ax_pressure]"
  rm -rf "$et"

  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3 for C_i normalization)"; exit 1; }
  # C_i ordering sanity (pure arithmetic, mirrors the composite below): equal failure counts -> role
  # ordering holds; equal role -> higher failure count strictly wins. Falsify: swap W_ROLE/W_FAIL and
  # a 0-failure router would lose to a leaf 'sense' node with any recent alerts under the OLD weights
  # too (0.6 vs 0.2*w) — this specific assertion instead checks the documented, non-swapped ordering.
  ci() { python3 -c "print(${1}*0.6 + ${2}*0.4)"; }
  c_router_0=$(ci "$(role_weight router)" 0)
  c_sense_0=$(ci "$(role_weight sense)" 0)
  python3 -c "exit(0 if $c_router_0 > $c_sense_0 else 1)" || fail="$fail ci-role-ordering"
  c_sense_1=$(ci "$(role_weight sense)" 1)
  python3 -c "exit(0 if $c_sense_1 > $c_sense_0 else 1)" || fail="$fail ci-failure-monotonic"

  [ -z "$fail" ] || { echo "smoke-test: FAIL ($fail )"; exit 1; }
  echo "smoke-test: ok (role_weight table, failure_count window+marker filter, C_i ordering monotonic in both terms, node-hot/node-pressure axis separation)"
  exit 0
fi

[ -r "$NODES_FILE" ] || { echo "mesh-hub-criticality: UNAVAILABLE — no readable $NODES_FILE (no known topology)"; exit 2; }
. "$NODES_FILE" 2>/dev/null

WIN_H=24; as_json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --window-hours) WIN_H="${2:-24}"; shift 2 ;;
    --json) as_json=1; shift ;;
    *) shift ;;
  esac
done
cutoff="$(date -u -d "${WIN_H} hours ago" +%FT%TZ 2>/dev/null)" || cutoff=""

role_for() { # $1=label -> role from MESH_ROLES (default: mind, i.e. unset)
  local tok lbl r want; want="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  for tok in ${MESH_ROLES:-}; do
    lbl="${tok%%:*}"; r="${tok#*:}"
    [ "$(printf '%s' "$lbl" | tr 'A-Z' 'a-z')" = "$want" ] && { printf '%s' "$r"; return 0; }
  done
  printf 'mind'
}

# pass 1: gather per-node role_weight + raw failure_count (thermal) + pressure_count (memory,
# separate axis — never folded into C_i, see PRESSURE_RE header note)
labels=""; declare -A RW=() FC=() PC=()
for n in ${MESH_NODES:-}; do
  lbl="${n%%:*}"; [ -n "$lbl" ] || continue
  case " $labels " in *" $lbl "*) continue ;; esac   # de-dupe repeated labels in the registry
  labels="$labels $lbl"
  role="$(role_for "$lbl")"
  RW["$lbl"]="$(role_weight "$role")"
  FC["$lbl"]="$(failure_count "$lbl" "$cutoff")"
  PC["$lbl"]="$(pressure_count "$lbl" "$cutoff")"
  # A count that is not a number is a BROKEN READ, never a zero — see the C_i note below. Guard HERE
  # (not inside the count functions): those run inside $( ), so an exit there kills only the subshell
  # and this script sets no -e, which is exactly how an empty count used to sail through.
  for _v in "${FC[$lbl]}" "${PC[$lbl]}"; do
    case "$_v" in ''|*[!0-9]*)
      echo "mesh-hub-criticality: BROKEN READ — counting '$lbl' against $CHAT produced '$_v', not a count. Refusing to report an unparseable board as zero risk." >&2
      exit 1 ;;
    esac
  done
done
[ -n "${labels// /}" ] || { echo "mesh-hub-criticality: UNAVAILABLE — MESH_NODES empty in $NODES_FILE"; exit 2; }

maxfc=0
for lbl in $labels; do [ "${FC[$lbl]}" -gt "$maxfc" ] 2>/dev/null && maxfc="${FC[$lbl]}"; done

rows="$(for lbl in $labels; do
  fn="${FC[$lbl]}"; rw="${RW[$lbl]}"; pn="${PC[$lbl]}"
  # No '2>/dev/null || echo 0' here: that idiom is what hid this tool's first 9 days. With a broken
  # failure_count, $fn was EMPTY, this python was a SyntaxError, the redirect ate it and the fallback
  # printed a plausible 0 — so every node ranked C_i=0 "no risk" and the tool's own output contradicted
  # itself (role_weight=1.00 beside C_i=0) unread. A fallback must be rare and LOUD; let the error out.
  ci="$(python3 -c "mf=$maxfc; print(round($rw*0.6 + (($fn/mf) if mf else 0)*0.4, 3))")" || {
    echo "mesh-hub-criticality: BROKEN C_i — arithmetic failed for '$lbl' (rw=$rw fn=$fn mf=$maxfc)" >&2; exit 1; }
  printf '%s\t%s\t%s\t%s\t%s\n' "$ci" "$lbl" "$rw" "$fn" "$pn"
done | sort -t$'\t' -k1,1 -rn)"

if [ "$as_json" = 1 ]; then
  python3 - "$rows" <<'PY'
import sys, json
rows = [l.split("\t") for l in sys.argv[1].splitlines() if l.strip()]
print(json.dumps([{"node": r[1], "c_i": float(r[0]), "role_weight": float(r[2]),
                    "failures_in_window": int(r[3]),
                    "pressure_in_window": int(r[4])} for r in rows], indent=2))
PY
else
  echo "== mesh-hub-criticality — SOC hub-and-spoke C_i proxy (window ${WIN_H}h; role_weight is a DECLARED-role proxy, not a computed graph metric — see header) =="
  printf '%s\n' "$rows" | awk -F'\t' '{printf "  %-16s C_i=%-6s role_weight=%-5s failures/%dh=%-3s pressure/%dh=%s\n", $2, $1, $3, '"$WIN_H"', $4, '"$WIN_H"', $5}'
  top="$(printf '%s\n' "$rows" | head -1 | cut -f2)"
  echo "  highest structural+failure risk right now: $top"
  echo "  (pressure/${WIN_H}h is the memory/swap axis — SEPARATE from C_i and the thermal failures count, never conflated: chat-review/node-hot-marker-axis-collision)"
fi
exit 0
