#!/usr/bin/env bash
# orphan-ok: on-demand callee — media-mode axis for desk/household fusion consumers (pulled, not scheduled)
# mesh-imac-media — iMac MEDIA-PLAYBACK sense over the SSH organ: is sound/video actively
# playing at the iMac? One SSH call reading `pmset -g assertions` — macOS apps take named
# power assertions while playing ("video-playing", "audio-playing"), so playback is visible
# with ZERO content capture (no titles, no audio — just the assertion name + process).
# Complements mesh-imac-input: watching a video is a distinct activity mode that input
# recency MISSES (proven live 2026-07-05: firefox video-playing while idle_s=1587).
# Consent envelope: same household-occupancy scope as mesh-imac-input (machine is
# iMac-Rozalia) — strictly milder than the consented cam/mic; classify as "someone".
#
# Output:
#   [imac-media] media=VIDEO|AUDIO|NONE user_active=0|1 by=<proc|->
#
# Exit codes (honest-exit contract):
#   0 = real read from the iMac
#   2 = iMac unreachable or parse failed — honest n/a, never a faked NONE
#
# Usage:
#   mesh-imac-media          one-shot reading
#   mesh-imac-media --json   machine-readable
#   mesh-imac-media --test   smoke test (parse fixtures + live-read gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
MODE=text; [ "${1:-}" = --json ] && MODE=json

read_imac() {
  timeout "${MESH_IMAC_MEDIA_TIMEOUT:-12}" ssh -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "$IMAC_HOST" "pmset -g assertions" </dev/null 2>/dev/null
}

emit() {  # $1=media $2=user_active $3=by
  if [ "$MODE" = json ]; then
    printf '{"media":"%s","user_active":%s,"by":"%s","ts":"%s"}\n' "$1" "$2" "$3" "$(date -u +%FT%TZ)"
  else
    printf '[imac-media] media=%s user_active=%s by=%s\n' "$1" "$2" "$3"
  fi
}

# classify <assertions-text> → "media user_active by" (parse-fail → rc 1)
classify() {
  local raw="$1" media=NONE ua=0 by="-" line
  printf '%s' "$raw" | grep -q 'Assertion status' || return 1
  # UserIsActive from the system-wide table (hidd tickles it on any HID input)
  ua="$(printf '%s\n' "$raw" | awk '/^[[:space:]]*UserIsActive[[:space:]]/{print $2; exit}')"
  case "$ua" in (''|*[!0-9]*) ua=0 ;; esac
  [ "$ua" -gt 0 ] && ua=1 || ua=0
  # Named playback assertions in the per-process section: VIDEO outranks AUDIO
  line="$(printf '%s\n' "$raw" | grep -m1 -i 'named: *"[^"]*video-playing')"
  if [ -n "$line" ]; then
    media=VIDEO
  else
    line="$(printf '%s\n' "$raw" | grep -m1 -iE 'named: *"[^"]*audio-playing|pid [0-9]+\(coreaudiod\).*PreventUserIdleSystemSleep')"
    [ -n "$line" ] && media=AUDIO
  fi
  [ -n "$line" ] && by="$(printf '%s' "$line" | sed -n 's/.*pid [0-9]*(\([^)]*\)).*/\1/p')"
  [ -n "$by" ] || by="-"
  printf '%s %s %s\n' "$media" "$ua" "$by"
}

run() {
  local raw parsed
  raw="$(read_imac)" || { echo "imac-media: iMac unreachable ($IMAC_HOST) — sense dark, not faked" >&2; return 2; }
  parsed="$(classify "$raw")" || { echo "imac-media: assertions parse failed (no 'Assertion status' header)" >&2; return 2; }
  # shellcheck disable=SC2086
  emit $parsed
}

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  fail=0
  _hdr='Assertion status system-wide:
   UserIsActive                   1
   PreventUserIdleDisplaySleep    1
Listed by owning process:'
  # Fixture 1: firefox video-playing (the live-proven case) → VIDEO by=firefox
  out="$(classify "$_hdr"'
   pid 878(firefox): [0x0] 01:35:16 NoDisplaySleepAssertion named: "video-playing"')" && \
    [ "$out" = "VIDEO 1 firefox" ] || { echo "FAIL: video fixture (got: $out)"; fail=1; }
  # Fixture 2: coreaudiod audio assertion, user idle → AUDIO 0
  out="$(classify 'Assertion status system-wide:
   UserIsActive                   0
Listed by owning process:
   pid 155(coreaudiod): [0x0] 00:02:01 PreventUserIdleSystemSleep named: "com.apple.audio.context"')" && \
    [ "$out" = "AUDIO 0 coreaudiod" ] || { echo "FAIL: audio fixture (got: $out)"; fail=1; }
  # Fixture 3: quiet machine → NONE 0 -
  out="$(classify 'Assertion status system-wide:
   UserIsActive                   0
Listed by owning process:')" && \
    [ "$out" = "NONE 0 -" ] || { echo "FAIL: quiet fixture (got: $out)"; fail=1; }
  # Fixture 4: garbage (no assertions header) → parse-fail rc 1, never a faked NONE
  classify 'permission denied' >/dev/null 2>&1 && { echo "FAIL: garbage must parse-fail, not fake NONE"; fail=1; }
  # Fixture 5: unreachable host → exit 2, empty stdout
  out="$(MESH_IMAC_HOST=nobody@203.0.113.1 MESH_IMAC_MEDIA_TIMEOUT=3 bash "${BASH_SOURCE[0]}" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: unreachable must exit 2 w/ empty stdout (rc=$rc out=$out)"; fail=1; }
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL (fixtures)"; exit 1; }
  # Real-read gate: a live read must produce a well-formed reading; unreachable = honest exit 2
  live="$(bash "${BASH_SOURCE[0]}" 2>/dev/null)"; live_rc=$?
  if [ "$live_rc" = 0 ]; then
    printf '%s\n' "$live" | grep -qE '^\[imac-media\] media=(VIDEO|AUDIO|NONE) user_active=[01] by=' || {
      echo "smoke-test: FAIL (live read rc=0 but malformed: $live)"; exit 1; }
    echo "smoke-test: ok (5 fixtures + live read: $live)"
    exit 0
  else
    echo "smoke-test: n/a — fixtures ok but iMac unreachable (honest exit 2, live read unverified)"
    exit 2
  fi
}

run
