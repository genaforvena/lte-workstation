#!/usr/bin/env bash
# observer-probe: mesh-net-io
#   mesh-observer-effect: a pure READ, safe to run K+3 times. byte counters — the accumulator case, which must get its own word and never a contamination verdict
# mesh-net-io — network I/O sense: reads /proc/net/dev → rx/tx bytes delta over interval
#
# Zero dependencies — reads /proc/net/dev directly. Produces rx/tx per-second rate
# for each tracked interface (default: wlp0s20f3 + tailscale0).
#
#   mesh-net-io              one-shot: read + delta + state file
#   mesh-net-io --json       machine-readable
#   mesh-net-io --edge       emit only on state change (spike detection)
#   mesh-net-io --test       smoke test
#
# Spike detection: rx or tx delta > MESH_NET_SPIKE (default 50MB/s) → [net-spike]
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
# MESH_TEST_SANDBOX=1 diverts BOTH artifacts — pre-fix, --test's "$0" --json truncated the LIVE
# state AND the .prev counters cache, corrupting the real cron's next rate delta (its baseline
# timestamp/counters got replaced by the test's) — worse than mtime forgery (task test-live-writes
# 2026-07-20).
STATE="$MESH/.net-io.state"
PREV="$MESH/.net-io.prev"
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  STATE="${TMPDIR:-/tmp}/.net-io.state.sandbox.$$"
  PREV="${TMPDIR:-/tmp}/.net-io.prev.sandbox.$$"
fi
SPIKE=${MESH_NET_SPIKE:-52428800}  # 50MB/s default
INTERFACES="${MESH_NET_IFACES:-wlp0s20f3 tailscale0}"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Test ---
if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  [ -f /proc/net/dev ] || { echo "smoke-test: FAIL (no /proc/net/dev)"; exit 1; }
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the "$0" --json below traverses the state+prev
  # writes — export so they divert; %y ns sig gate proves it.
  export MESH_TEST_SANDBOX=1
  _ni_s="$HOME/.mesh/.net-io.state"; _ni_p="$HOME/.mesh/.net-io.prev"
  _ni_sig="$(stat -c '%y %s' "$_ni_s" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ni_p" 2>/dev/null || echo absent)"
  out="$("$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (tool errored)"; exit 1; }
  printf '%s' "$out" | grep -q '"interfaces"' || { echo "smoke-test: FAIL (missing interfaces)"; exit 1; }
  # sandbox honesty gate. Falsify: drop the STATE/PREV diversion above.
  _ni_sig2="$(stat -c '%y %s' "$_ni_s" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ni_p" 2>/dev/null || echo absent)"
  if [ "$_ni_sig2" != "$_ni_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_ni_sig' → '$_ni_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%y %s' "$_ni_s" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ni_p" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%y %s' "$_ni_s" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ni_p" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_ni_sig' → '$_ni_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  echo "smoke-test: ok (json read + sandboxed state/prev untouched)"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0; [ "${1:-}" = --edge ] && EDGE=1

# --- Read current counters ---
now_ts=$(date +%s%N)
declare -A cur_rx cur_tx
while IFS= read -r line; do
  iface="${line%%:*}"
  iface="$(printf '%s' "$iface" | xargs)"
  printf '%s\n' "$INTERFACES" | grep -qw "$iface" || continue
  rest="${line#*:}"
  # awk split: $1=rx_bytes, $9=tx_bytes
  rx_bytes=$(printf '%s' "$rest" | awk '{print $1}')
  tx_bytes=$(printf '%s' "$rest" | awk '{print $9}')
  cur_rx[$iface]="$rx_bytes"
  cur_tx[$iface]="$tx_bytes"
done < /proc/net/dev

# --- Compute deltas ---
declare -A rx_rate tx_rate rx_total tx_total
if [ -f "$PREV" ]; then
  prev_ts=$(head -1 "$PREV")
  elapsed=$(( now_ts - prev_ts ))
  [ "$elapsed" -le 0 ] && elapsed=1
  while IFS='=' read -r iface val; do
    [ -z "$iface" ] && continue
    [[ "$iface" == ts_* ]] && continue
    iface="${iface#rx_}"
    # shellcheck disable=SC2086
    if [ -n "${cur_rx[$iface]+x}" ]; then
      rx_delta=$(( ${cur_rx[$iface]} - ${val} ))
      rx_rate[$iface]=$(( rx_delta * 1000000000 / elapsed ))
      rx_total[$iface]="${cur_rx[$iface]}"
    fi
  done < <(grep "^rx_" "$PREV" 2>/dev/null || true)
  while IFS='=' read -r iface val; do
    [ -z "$iface" ] && continue
    [[ "$iface" == ts_* ]] && continue
    iface="${iface#tx_}"
    # shellcheck disable=SC2086
    if [ -n "${cur_tx[$iface]+x}" ]; then
      tx_delta=$(( ${cur_tx[$iface]} - ${val} ))
      tx_rate[$iface]=$(( tx_delta * 1000000000 / elapsed ))
      tx_total[$iface]="${cur_tx[$iface]}"
    fi
  done < <(grep "^tx_" "$PREV" 2>/dev/null || true)
fi

# --- Save current as previous ---
{
  echo "$now_ts"
  for iface in $INTERFACES; do
    printf 'rx_%s=%s\n' "$iface" "${cur_rx[$iface]:-0}"
    printf 'tx_%s=%s\n' "$iface" "${cur_tx[$iface]:-0}"
  done
} > "$PREV"

# --- Spike detection ---
spike=0; spike_detail=""
for iface in $INTERFACES; do
  rr="${rx_rate[$iface]:-0}"
  tr="${tx_rate[$iface]:-0}"
  if [ "$rr" -gt "$SPIKE" ] 2>/dev/null || [ "$tr" -gt "$SPIKE" ] 2>/dev/null; then
    spike=1
    spike_detail="$spike_detail $iface:rx=${rr}B/s,tx=${tr}B/s"
  fi
done

# --- State file ---
if [ -f "$PREV" ]; then
  {
    for iface in $INTERFACES; do
      printf '%s rx=%s tx=%s\n' "$iface" "${rx_rate[$iface]:-0}" "${tx_rate[$iface]:-0}"
    done
    printf 'spike=%s\n' "$spike"
  } > "$STATE"
fi

# --- Output ---
if [ "$MODE" = json ]; then
  printf '{"interfaces":['
  first=1
  for iface in $INTERFACES; do
    [ "$first" = 0 ] && printf ','
    first=0
    printf '{"name":"%s","rx_rate":%s,"tx_rate":%s,"rx_total":%s,"tx_total":%s}' \
      "$iface" "${rx_rate[$iface]:-0}" "${tx_rate[$iface]:-0}" \
      "${rx_total[$iface]:-0}" "${tx_total[$iface]:-0}"
  done
  printf '],"spike":%d,"ts":"%s"}\n' "$spike" "$TS"
else
  for iface in $INTERFACES; do
    rr="${rx_rate[$iface]:-0}"
    tr="${tx_rate[$iface]:-0}"
    rt="${rx_total[$iface]:-0}"
    tt="${tx_total[$iface]:-0}"
    # Human-readable rates
    if [ "$rr" -gt 1048576 ]; then rrx="$(echo "scale=1; $rr/1048576" | bc 2>/dev/null || echo "$rr")MB/s"
    elif [ "$rr" -gt 1024 ]; then rrx="$(echo "scale=1; $rr/1024" | bc 2>/dev/null || echo "$rr")KB/s"
    else rrx="${rr}B/s"; fi
    if [ "$tr" -gt 1048576 ]; then rtx="$(echo "scale=1; $tr/1048576" | bc 2>/dev/null || echo "$tr")MB/s"
    elif [ "$tr" -gt 1024 ]; then rtx="$(echo "scale=1; $tr/1024" | bc 2>/dev/null || echo "$tr")KB/s"
    else rtx="${tr}B/s"; fi
    printf '  %-12s rx=%-10s tx=%-10s (total: rx=%s tx=%s)\n' "$iface" "$rrx" "$rtx" "$rt" "$tt"
  done
  if [ "$spike" = 1 ]; then
    printf '[net-spike] %s\n' "$spike_detail"
  fi
fi
