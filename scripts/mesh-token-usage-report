#!/usr/bin/env python3
"""Read-only grouped coverage report for normalized token rows."""
import argparse, json
from pathlib import Path

FIELDS = ("total", "input", "cached_input", "output", "reasoning")

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--records", required=True)
    args = ap.parse_args()
    groups = {}
    for line in Path(args.records).read_text(encoding="utf-8").splitlines():
        if not line.strip(): continue
        row = json.loads(line)
        key = (row.get("window"), row.get("model"))
        usage = row.get("usage") if isinstance(row.get("usage"), dict) else {}
        missing = sum(usage.get(field) is None for field in FIELDS)
        item = groups.setdefault(key, {"window": key[0], "model": key[1], "rows": 0, "missing_fields": 0})
        item["rows"] += 1
        item["missing_fields"] += missing
    result = {"schema_version": 1, "groups": [groups[k] for k in sorted(groups, key=lambda x: (x[0] or "", x[1] or ""))]}
    print(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=False))

if __name__ == "__main__": main()
