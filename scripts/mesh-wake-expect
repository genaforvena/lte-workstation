#!/usr/bin/env bash
# mesh-wake-expect — the PREDICTIVE wake gate's mind-side verb (operator 2026-07-23: "every mind
# should be improving its reflexes to predict next top pane state … wake only if prediction does
# not match reality"). The MIND runs this at the end of a handled wake to record what it PREDICTS
# its data pane will do before the next wake-worthy event: one grep -E pattern per line, matched
# against the reactor's NORMALIZED lines (post strip_volatile/smart_normalize — timestamps/chrome
# are already gone, don't predict those). mesh-pane-consume then HOLDS a wake whose changed lines
# are all covered by the prediction, and wakes on anything unpredicted (plus a TTL and deaf-guard
# so an over-broad prediction can never silence a mind for long — see the PREDICTIVE block there).
#
#   mesh-wake-expect <channel> [--ttl SECS] <pattern> [<pattern>...]   write a prediction ('-' = stdin)
#   mesh-wake-expect <channel> --show                                  print the current prediction
#   mesh-wake-expect <channel> --clear                                 drop the prediction
#
# The file carries a hard `# expires: <epoch>` header (default TTL 24h, MESH_WAKE_EXPECT_TTL);
# the reactor treats a missing/expired header as NO prediction — an unbounded prediction is never
# trusted. An EMPTY prediction is refused loudly: writing "I predict nothing" is a mind error, the
# honest form of that is --clear.
# orphan-ok: mind-invoked on-demand (the predictive-wake reflex verb; consumed by mesh-pane-consume)
set -uo pipefail
DIR="${MESH_WAKE_EXPECT_DIR:-$HOME/.mesh/wake-expect}"
TTL_DEFAULT="${MESH_WAKE_EXPECT_TTL:-86400}"

usage(){ echo "usage: mesh-wake-expect <channel> [--ttl SECS] <pattern>... | <channel> --show | <channel> --clear" >&2; exit 2; }

if [ "${1:-}" = --test ]; then
  self="$0"
  tmp="$(mktemp -d)"; export MESH_WAKE_EXPECT_DIR="$tmp"
  # write: patterns land, expires header is present and in the future
  "$self" tstch --ttl 120 '^queue depth [0-9]+$' 'lease .*' >/dev/null \
    || { echo "smoke-test: FAIL (plain write rejected)"; rm -rf "$tmp"; exit 1; }
  f="$tmp/tstch"
  [ -f "$f" ] || { echo "smoke-test: FAIL (no expectation file written)"; rm -rf "$tmp"; exit 1; }
  grep -q '^\^queue depth \[0-9\]+\$$' "$f" || { echo "smoke-test: FAIL (pattern not stored verbatim)"; rm -rf "$tmp"; exit 1; }
  exp="$(sed -nE 's/^# expires: ([0-9]+)$/\1/p' "$f" | head -1)"
  now="$(date +%s)"
  [ -n "$exp" ] && [ "$exp" -gt "$now" ] && [ "$exp" -le "$((now + 121))" ] \
    || { echo "smoke-test: FAIL (expires header wrong: '$exp' vs now $now ttl 120)"; rm -rf "$tmp"; exit 1; }
  # CROSS-TOOL CONTRACT: the READER of this file is mesh-pane-consume's expect_fresh — drive the real
  # reader against the real written artifact (format drift between writer and reader = a silent
  # never-holds or never-wakes; a comment is not a channel, the probe is).
  if command -v mesh-pane-consume >/dev/null 2>&1; then
    MESH_WAKE_EXPECT_DIR="$tmp" mesh-pane-consume --expect-check tstch >/dev/null \
      || { echo "smoke-test: FAIL (cross-tool: mesh-pane-consume --expect-check rejects a file this tool just wrote — writer/reader format drift)"; rm -rf "$tmp"; exit 1; }
  else
    echo "note: mesh-pane-consume absent — cross-tool contract probe skipped"
  fi
  # --show round-trips the patterns; --clear removes; a cleared channel reads stale downstream
  "$self" tstch --show | grep -q 'lease .\*' || { echo "smoke-test: FAIL (--show lost a pattern)"; rm -rf "$tmp"; exit 1; }
  "$self" tstch --clear >/dev/null
  [ ! -f "$f" ] || { echo "smoke-test: FAIL (--clear left the file)"; rm -rf "$tmp"; exit 1; }
  # an EMPTY prediction is refused (rc!=0, nothing written) — "predict nothing" must be said as --clear
  "$self" tstch </dev/null - >/dev/null 2>&1 && { echo "smoke-test: FAIL (empty stdin prediction must be refused)"; rm -rf "$tmp"; exit 1; }
  [ ! -f "$f" ] || { echo "smoke-test: FAIL (refused empty prediction still wrote a file)"; rm -rf "$tmp"; exit 1; }
  # no channel → usage
  "$self" >/dev/null 2>&1 && { echo "smoke-test: FAIL (missing channel must be a usage error)"; rm -rf "$tmp"; exit 1; }
  rm -rf "$tmp"
  echo "smoke-test: ok (prediction written with bounded expiry; verbatim patterns; show/clear round-trip; empty refused; reader contract driven live)"
  exit 0
fi

ch="${1:-}"; [ -n "$ch" ] || usage
case "$ch" in -*|--*) usage ;; esac
shift

TTL="$TTL_DEFAULT"; MODE=write; PATS=()
while [ $# -gt 0 ]; do case "$1" in
  --ttl)   TTL="$2"; shift 2 ;;
  --show)  MODE=show; shift ;;
  --clear) MODE=clear; shift ;;
  -)       while IFS= read -r l; do [ -n "$l" ] && PATS+=("$l"); done; shift ;;
  *)       PATS+=("$1"); shift ;;
esac; done

f="$DIR/$ch"
case "$MODE" in
  show)  [ -f "$f" ] && cat "$f" || { echo "mesh-wake-expect: no prediction for '$ch'" >&2; exit 1; } ;;
  clear) rm -f "$f"; echo "cleared: $ch" ;;
  write)
    [ "${#PATS[@]}" -gt 0 ] || { echo "mesh-wake-expect: refusing an EMPTY prediction for '$ch' — to drop the prediction say --clear" >&2; exit 1; }
    printf '%s\n' "${PATS[@]}" | grep -E -f /dev/stdin /dev/null 2>/dev/null
    rc=$?
    [ "$rc" -le 1 ] || { echo "mesh-wake-expect: a pattern does not compile as grep -E — nothing written (the reactor would fail it toward waking anyway)" >&2; exit 1; }
    mkdir -p "$DIR"
    { echo "# expires: $(( $(date +%s) + TTL ))"
      echo "# written: $(date -u +%FT%TZ) by mesh-wake-expect (patterns match NORMALIZED pane lines)"
      printf '%s\n' "${PATS[@]}"
    } > "$f"
    echo "predicted: $ch (${#PATS[@]} pattern(s), ttl ${TTL}s)" ;;
esac
