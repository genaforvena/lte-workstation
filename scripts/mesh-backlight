#!/usr/bin/env bash
# orphan-ok: on-demand sense (operator review pending — built 2026-06-24, NOT yet wired/committed).
# mesh-backlight — SCREEN BACKLIGHT sense: how bright is THIS node's display right now?
#
# WHY: the kernel exposes the panel backlight at /sys/class/backlight/<dev>/actual_brightness, a real
# signal the mesh never read. Unlike mesh-cam-light (AMBIENT light the webcam sees) this is the EMITTED
# display level — a phone-free proxy for "is the screen actively ON / in use". brightness 0 = blanked
# (DPMS-off or dimmed to minimum → display idle); high = actively lit. A strong corroborator for
# workstation activity/presence (screen-on + recent keypress = working) that needs no phone and no camera.
# Complements mesh-node-power (that = battery/AC of the same node; this = the panel's light output).
#
# HONEST: reads ONLY the kernel file. No backlight device, or an unreadable/garbage value, renders
# UNREACHABLE + exit 2 — never a fabricated 0 or level. A real 0 (device present, value 0) is a genuine
# OFF reading and is reported distinctly from "device absent".
#
#   mesh-backlight          print level + percent
#   mesh-backlight --pct    print just the integer percent (0-100), or nothing+exit2 if unreachable
#   mesh-backlight --test   smoke test (synthetic actual/max pairs — no hardware)
#
# Levels: OFF (0%) · DIM (<25%) · MEDIUM (<70%) · BRIGHT (>=70%)
# Exit: 0 = real reading · 2 = unreachable (no backlight device / unreadable) — never faked.
# smoke-test: --test drives classify() incl. the divide-by-zero / non-numeric guards.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# Calibrated cutoffs resolve ledger (uxn threshold-ledger row backlight-level) > inline fallback.
# (Same axis as mesh-screen-state's screen-bright row with DIFFERENT edges — the ledger keeps
# that split visible; unifying is an operator calibration call, now a one-line diff.)
_ledger_const() { # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
BL_LO="$(_ledger_const backlight-level lo 25)"
BL_HI="$(_ledger_const backlight-level hi 70)"

# classify <actual> <max> → "<PCT> <LEVEL>" on stdout, or empty (caller → UNREACHABLE) if inputs are
# non-numeric or max<=0. Pure (no I/O) so --test can falsify it.
classify() {
  local a="${1:-}" m="${2:-}"
  case "$a" in ''|*[!0-9]*) return 1;; esac
  case "$m" in ''|*[!0-9]*) return 1;; esac
  [ "$m" -gt 0 ] 2>/dev/null || return 1
  local pct=$(( a * 100 / m ))
  local lvl
  if   [ "$pct" -le 0 ];        then lvl=OFF
  elif [ "$pct" -lt "$BL_LO" ]; then lvl=DIM
  elif [ "$pct" -lt "$BL_HI" ]; then lvl=MEDIUM
  else                               lvl=BRIGHT; fi
  echo "$pct $lvl"
}

if [ "${1:-}" = --consts ]; then
  # observable artifact of the resolution (ledger > inline), same path classify takes
  echo "lo=$BL_LO hi=$BL_HI"
  exit 0
fi

if [ "${1:-}" = --test ]; then
  e=0; ck(){ [ "$1" = "$2" ] || { echo "  FAIL: [$3] expected '$2' got '$1'"; e=1; }; }
  ck "$(classify 0 96000)"     "0 OFF"      "zero brightness → OFF"
  ck "$(classify 96000 96000)" "100 BRIGHT" "full → BRIGHT"
  ck "$(classify 9600 96000)"  "10 DIM"     "10% → DIM"
  ck "$(classify 48000 96000)" "50 MEDIUM"  "50% → MEDIUM"
  # honest guards: garbage / zero-max must yield EMPTY (caller renders UNREACHABLE), never a faked level
  ck "$(classify abc 96000)"   ""           "non-numeric actual → empty (unreachable, not 0)"
  ck "$(classify 100 0)"       ""           "max=0 → empty (no divide-by-zero faked reading)"
  ck "$(classify 100 '')"      ""           "missing max → empty"
  # ledger resolution (ledger > inline): --consts is the observable artifact
  _led="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn/threshold-ledger"
  if [ -f "$_led" ]; then
    _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
    sed 's/hi=70/hi=71/' "$_led" > "$_td/recal"
    ck "$(MESH_THRESHOLD_LEDGER="$_td/recal" bash "$0" --consts)" "lo=25 hi=71" "recal ledger reaches --consts"
    ck "$(MESH_THRESHOLD_LEDGER="$_td/absent" bash "$0" --consts)" "lo=25 hi=70" "absent ledger falls back inline"
  fi
  [ "$e" = 0 ] && echo "smoke-test: ok (4 classify + 3 honest-guard + ledger-resolution assertions)" || echo "smoke-test: FAIL"
  exit "$e"
fi

# --- read the kernel backlight (first device found); honest UNREACHABLE if none/unreadable ---
host="$(hostname)"; ts="$(date -u +%FT%TZ)"
dev=""
for d in /sys/class/backlight/*/; do [ -r "${d}actual_brightness" ] && [ -r "${d}max_brightness" ] && { dev="$d"; break; }; done

if [ -z "$dev" ]; then
  echo "[backlight] UNREACHABLE — no readable /sys/class/backlight device (no panel backlight here)" >&2
  exit 2
fi
actual="$(cat "${dev}actual_brightness" 2>/dev/null || true)"
max="$(cat "${dev}max_brightness" 2>/dev/null || true)"
res="$(classify "$actual" "$max")" || {
  echo "[backlight] UNREACHABLE — unreadable backlight value (actual='$actual' max='$max') @ ${dev}" >&2
  exit 2
}
pct="${res%% *}"; lvl="${res#* }"
if [ "${1:-}" = --pct ]; then echo "$pct"; exit 0; fi
echo "[backlight] $lvl — screen at ${pct}% ($(basename "$dev"); actual=$actual/$max) [emitted display light, phone-free] @ $host $ts"
exit 0
