#!/usr/bin/env bash
# mesh-room-music — "music from the home": capture short chunks of whatever sound is playing in the
# room (mic on the room node), then re-grind them into NEW music with the revived granular sampler
# (grainneukeln). Operator's idea 2026-06-21: not synth-from-zero but generative-from-ambient — the
# room's own sound, beat-windowed and recombined. Slow is fine (operator: "можно ночью") so the heavy
# remix runs as a nightly batch on the mind node (8c), never on the freeze-prone room node.
#
#   mesh-room-music --capture [secs]   record ~secs (default 20) of the room mic into today's buffer;
#                                      discards near-silent grabs (don't remix silence). DAYTIME reflex.
#   mesh-room-music --remix [src.wav]  re-grind today's captures (or one file) -> a granular remix mp3;
#                                      prints the output path. Bounded: concats only the last few grabs
#                                      and caps length so the O(n^2) automix stays cheap-ish.
#   mesh-room-music --nightly          --remix the day + send the track to the operator (TG) + tell Миша.
#   mesh-room-music --play <file>      play a finished track on the room Bose (mind/Миша choice, not auto).
#   mesh-room-music --diversity        mind watchdog: distinct param combos over the last 7 remixes.
#   mesh-room-music --test             smoke: deps + grainneukeln venv + preset rotation (no capture/Bose).
#
# Heavy compute stays OFF the room node. Capture is the only thing that touches it (cheap pw-record).
# reflex-cadence: none
# orphan-ok: capture/nightly cadences are wired explicitly below per-node (daytime capture + 03:0x remix);
#            left unwired in the genome so a node opts in via mesh-autowire only where a room mic exists.
set -uo pipefail
# cron's PATH is /usr/bin:/bin — it does NOT include ~/.local/bin, where every mesh-* tool (and the
# mesh-heavy-run OOM-admission shim) lives. Without this, `command -v mesh-heavy-run` FAILS under the
# nightly cron → the grind falls through to the raw 2GB python with NO memory guard → OOM-Killed on a
# pressured node (observed 2026-07-07: `line: Killed … main.py` then a stale-send). Put ~/.local/bin
# on PATH first so the shim (and mesh-tell/mesh-voice-gate) resolve identically under cron and a shell.
case ":$PATH:" in *":$HOME/.local/bin:"*) : ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

GRAIN_DIR="${MESH_GRAIN_DIR:-$HOME/grainneukeln}"
PY="$GRAIN_DIR/.venv/bin/python"
CAPROOT="$GRAIN_DIR/captures"
OUTROOT="$GRAIN_DIR/output"
ROOM_NODE="${ROOM_NODE:-imozerov@100.125.157.75}"
KEEP_DAYS="${MESH_RMC_KEEP_DAYS:-3}"          # prune capture day-folders older than this
SILENCE_DB="${MESH_RMC_SILENCE_DB:--55}"      # mean_volume below this (dB) = silence, skip
# ── THE BOUND ON A FEED IS MEMORY, NOT LENGTH (measured 2026-08-21, this node) ────────────────
# CAP_SECS used to default to 90 and trim EVERY source to its first 90 seconds before the engine
# saw it. That is the operator's "обрывки": his 296s drop was ground from its first 90s, and a
# 1160s track at ss 0.25 reached the engine as 22s and rendered 7.5s (22/3, exact).
#
# The cap's stated reasons were remix TIME and an OOM at the 2500MB cgroup ceiling. Both were
# measured against the real engine, same source, same node:
#   feed   75s -> peak  541MB          feed  300s -> peak 1320MB,  70s wall
#   feed 1160s -> peak 5008MB, 178s wall (m lib) / 344s wall (m q, 90ms grains, ss 0.25)
# Peak RSS is LINEAR in feed length — ~4.12 MB per second plus a ~230MB base — and is essentially
# INDEPENDENT of the recipe: the gentlest and the most pathological recipe at feed 1160s peaked at
# 5131788 KiB and 5131680 KiB, 108 KiB apart out of 5 GB. The recipe drives WALL TIME (178s vs
# 344s), which nothing was ever OOM-killed for.
#
# So the length cap was solving a MEMORY problem by throwing away AUDIO, while the memory budget
# sat at a flat 2500MB on a 31GB node. The bound is now derived: a grind may claim up to
# MEM_CEIL_PCT of MemTotal, and the longest feed that fits follows from the measured model. A
# source longer than that is still trimmed — there is no honest alternative — but it SAYS SO, with
# the number, instead of silently amputating everything past 90 seconds.
# A trim is now a REPORTED event, not a silent one. The old flat cap amputated four fifths of a
# 296s drop and said nothing at all, so "the grind sounds like fragments" had no evidence anywhere
# on disk to point at. When the bound bites, it names the source length, what survived, and the
# memory ceiling that decided it.
trim_say(){  # <src_secs> <kept_secs> <ceil_mb>
  echo "remix: source ${1}s exceeds the memory-derived feed bound ${2}s (grind ceiling ${3}MB at ${MEM_PER_SEC_MB}MB/s + ${MEM_BASE_MB}MB base) — grinding the first ${2}s. Raise MESH_RMC_MEM_CEIL_PCT to feed more." >&2
}
CAP_SECS="${MESH_RMC_CAP_SECS:-0}"            # 0 = no explicit length cap; the bound is memory (below)
MEM_BASE_MB="${MESH_RMC_MEM_BASE_MB:-400}"    # measured ~230MB base + headroom
MEM_PER_SEC_MB="${MESH_RMC_MEM_PER_SEC_MB:-7}"  # measured 4.12 MB per feed-second + ~70% headroom
MEM_CEIL_PCT="${MESH_RMC_MEM_CEIL_PCT:-50}"   # share of MemTotal one grind may claim
# UXN_FEEDBACK: opt-in closed-loop Uxn control (grainneukeln #13). OFF by default — the default grind
# path stays byte-identical (empty ⇒ the amc pick_args generator drives, exactly as before). When set,
# the vendored paramgen ROM sequences ALL six amc params AND a per-tick rhythm-density feedback byte
# whose low bits XOR-perturb the c-band, so the recipe reacts to THIS feed's own rhythm instead of a
# fixed pick. main.py's --uxn-ctrl path sys.exits after the ROM sequence, so it REPLACES the amc token
# list (an alternative render driver, not an addition) and emits UXN_TICKS renders per grind.
UXN_FEEDBACK="${MESH_RMC_UXN_FEEDBACK:-}"     # set (e.g. =1) to drive the grind from the closed-loop ROM
UXN_TICKS="${MESH_RMC_UXN_TICKS:-8}"          # renders the paramgen ROM sequences per grind (uxn mode)
# AUTOMIX params — BEAT-SYNCED grains (operator 2026-07-06: "весь трюк интересных ритмов — пусть
# алгоритм определит окно что есть [период бита, условно 600мс], его умножив или поделив на 2 или 3,
# потом ещё крутить s и ss в разные стороны; 100 кажется оч мелким"). The generator:
#   1. detect_beat_ms() finds the source's own beat period T (onset-envelope autocorrelation, numpy;
#      falls back to 500ms on flat/short input),
#   2. grain length l = T × factor, factor ∈ {1/3, 1/2, 1, 2, 3}, clamped 120–2000ms,
#   3. factor AND track speed s AND grain speed ss rotate: drawn only from values ABSENT in the
#      last $ROTATE_EXCLUDE remixes — texture and rhythm are forced to move every run.
# Each pick is logged to $PARAMS_LOG (with "~ beat T f F" metadata after the args) and lands in the
# TG caption; `--diversity` is the mind-side watchdog (a pinned MESH_RMC_AUTOMIX bypasses the
# generator, and --diversity is what catches the resulting monotony).
PARAMS_LOG="${MESH_RMC_PARAMS_LOG:-$HOME/.mesh/room-music-params.log}"   # overridable so --test sandboxes
# ATTEMPTS_LOG: every grind ATTEMPT appended BEFORE the python launches (crash-tolerance 2026-07-19).
# Decoupled from PARAMS_LOG (the success-only shipped-renders log the diversity watchdog reads) so a
# pathological recipe that crashes the python leaves a record without polluting the diversity signal.
# Read this to answer 'what was being ground when the OOM hit?'.
ATTEMPTS_LOG="${MESH_RMC_ATTEMPTS_LOG:-$HOME/.mesh/grainneukeln-attempts.log}"
ROTATE_EXCLUDE="${MESH_RMC_ROTATE_EXCLUDE:-3}"
F_VALS=(0.2 0.33 0.5 1 2 3)                               # beat-period multiplier for grain length
                                                          # (0.2 keeps the approved micro-grain regime in the pool:
                                                          # operator 2026-07-06 "но и твои тоже интересные")
W_VALS=(4 5 6 8)                                          # window divider (grain density)
SS_VALS=(0.25 0.5 0.75 1.0 1.25 1.5 2.0)                  # grain playback speed (pitch/texture; 0.25/2.0 =
                                                          # super-slow smear / chipmunk edges, operator 2026-07-06)
S_VALS=(0.25 0.5 0.75 1.0 1.25 1.5 2.0 3.0)               # TRACK speed — the rhythm axis ("суперзамедления
                                                          # и потом ускорения": 0.25 crawl, 3.0 sprint)
C_VALS=("" "" "c 1,250;500,15000" "c 100,8000" "c 1,300;2000,16000" "c 40,400" "c 300,12000")
                                                          # band filters; "" twice = unfiltered is common
detect_beat_ms() { # $1 wav -> beat period in ms (250-1200), 500 on any failure.
  # RUNS UNDER THE VENV PYTHON ($PY), NOT system python3 (fixed 2026-07-15 — the flat-beat bug).
  # This used to call bare `python3`, whose stdlib has NO numpy on this node: the import raised
  # ModuleNotFoundError, `|| echo 500` silently swallowed it, and the detector returned its
  # flat-input FALLBACK on EVERY grind since the minds migrated here (2026-07-14). So `l = beat × f`
  # was `500 × f` for every render regardless of the source's actual rhythm — the beat-synced window
  # the operator asked for ("пусть алгоритм определит окно что есть [период бита]") was never
  # detected, only assumed. A hollow sense of exactly the kind the doctrine names: the header says
  # beat-driven, the artifact is a constant. The params log agrees — every auto-generated line reads
  # `beat 500`. --test asserts a 400ms click track reads as 400/800 and was FAILING against this.
  # $PY is not a new dependency: --remix already requires it (and --test gates on it) for the grind
  # itself. Fall back to system python3 for a node that somehow has numpy there but no venv.
  local py="$PY"
  [ -x "$py" ] && "$py" -c 'import numpy' >/dev/null 2>&1 || py="python3"
  "$py" - "$1" 2>/dev/null <<'PYEOF' || echo 500
import sys, subprocess
import numpy as np
raw = subprocess.run(["ffmpeg","-v","quiet","-i",sys.argv[1],"-ac","1","-ar","22050","-f","s16le","-"],
                     capture_output=True).stdout
x = np.frombuffer(raw, np.int16).astype(np.float32)
if x.size < 22050*4: print(500); sys.exit()
hop = 512
n = x.size // hop
env = np.abs(x[:n*hop]).reshape(n, hop).mean(1)
onset = np.diff(env); onset[onset < 0] = 0
onset = onset - onset.mean()
sr = 22050.0/hop
lo, hi = int(0.25*sr), int(1.2*sr)
ac = np.correlate(onset, onset, 'full')[onset.size-1:]
if hi >= ac.size or ac[lo:hi].max() <= 0: print(500); sys.exit()
lag = lo + int(np.argmax(ac[lo:hi]))
ms = int(round(lag/sr*1000/10.0)*10)
print(ms if 250 <= ms <= 1200 else 500)
PYEOF
}
band_of_s() { # $1 = track-speed value -> slow|mid|fast (the three tempo LEVELS)
  # Operator 2026-07-17: successive renders must BREATHE across tempo levels (slow layer / mid /
  # разгон), not spin near grooves. Value-dedup ("s absent from last 3") is too weak — it lets s
  # sit in one band (e.g. 1.5→2.0→3.0, all FAST) while reading as "rotated". So s rotates by BAND
  # first, value second. slow ≤0.5 · mid 0.5<v≤1.25 · fast >1.25.
  awk -v v="$1" 'BEGIN{ if(v+0<=0.5) print "slow"; else if(v+0<=1.25) print "mid"; else print "fast" }'
}
pick_args() { # $1 = beat period ms; f AND ss drawn from values ABSENT in the last $ROTATE_EXCLUDE remixes;
              # s (tempo) rotates by BAND — a level NOT used in the last 2 renders — then value-deduped within it.
              # Prints ONE line: '<automix args> ~ beat <ms> f <factor>' — caller splits at " ~ "
              # (command substitution is a subshell, so a global var could not carry the factor out).
  local beat="${1:-500}" recent v l s ss w c f fa=() sa=() ssa=() sv b exbands=" " sband=()
  recent="$(tail -n "$ROTATE_EXCLUDE" "$PARAMS_LOG" 2>/dev/null | sed 's/^[^ ]* //')"
  for v in "${F_VALS[@]}";  do grep -qE "(^| )f $v( |\$)" <<<"$recent" || fa+=("$v"); done
  for v in "${SS_VALS[@]}"; do grep -qE "(^| )ss $v( |\$)" <<<"$recent" || ssa+=("$v"); done
  # tempo BAND rotation: exclude the band(s) of the last 2 renders' s so 3 consecutive renders
  # necessarily sweep slow→mid→fast (breathe), not orbit one groove.
  for sv in $(tail -n 2 "$PARAMS_LOG" 2>/dev/null | grep -oE '(^| )s [0-9.]+' | grep -oE '[0-9.]+$'); do
    exbands="$exbands$(band_of_s "$sv") "
  done
  for v in "${S_VALS[@]}"; do case "$exbands" in *" $(band_of_s "$v") "*) : ;; *) sband+=("$v");; esac; done
  [ "${#sband[@]}" -gt 0 ] || sband=("${S_VALS[@]}")   # both other bands used up → allow all levels
  for v in "${sband[@]}"; do grep -qE "(^| )s $v( |\$)" <<<"$recent" || sa+=("$v"); done   # value-dedup WITHIN band
  [ "${#fa[@]}" -gt 0 ]  || fa=("${F_VALS[@]}")
  [ "${#sa[@]}" -gt 0 ]  || sa=("${sband[@]}")
  [ "${#ssa[@]}" -gt 0 ] || ssa=("${SS_VALS[@]}")
  f="${fa[$((RANDOM % ${#fa[@]}))]}"
  s="${sa[$((RANDOM % ${#sa[@]}))]}"
  ss="${ssa[$((RANDOM % ${#ssa[@]}))]}"
  w="${W_VALS[$((RANDOM % ${#W_VALS[@]}))]}"
  c="${C_VALS[$((RANDOM % ${#C_VALS[@]}))]}"
  l="$(awk "BEGIN{v=int($beat*$f/10+0.5)*10; if(v<120)v=120; if(v>2000)v=2000; print v}")"
  printf 'amc l %s w %s ss %s s %s%s ~ beat %s f %s\n' "$l" "$w" "$ss" "$s" "${c:+ $c}" "$beat" "$f"
}
AUTOMIX_ARGS="${MESH_RMC_AUTOMIX:-}"
SSH=(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$ROOM_NODE")
day="$(date +%F)"; capdir="$CAPROOT/$day"

mean_db() { # $1 wav -> mean volume in dB (empty if undetectable)
  ffmpeg -hide_banner -nostats -i "$1" -af volumedetect -f null - 2>&1 \
    | grep -oE 'mean_volume: [-0-9.]+ dB' | grep -oE '[-0-9.]+' | head -1
}

valid_track() { # $1 mp3 -> true only if it is GENUINE playable audio, not a hollow/truncated stub.
  # A failed grind can write a non-empty-but-undecodable mp3 (observed 2026-07-10T10:18Z: a 261-byte
  # file) that passes a bare `-s` test, gets logged as a success, and --nightly ships to the operator
  # as broken TG audio. Gate on real decodable duration (>=1s) via ffprobe; size-floor fallback where
  # ffprobe is absent (a real granular grind is >1MB, a broken one a few hundred bytes).
  [ -s "$1" ] || return 1
  if command -v ffprobe >/dev/null 2>&1; then
    local dur; dur="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$1" 2>/dev/null)"
    awk "BEGIN{exit !(${dur:-0}+0 >= 1.0)}" 2>/dev/null
  else
    [ "$(wc -c <"$1" 2>/dev/null || echo 0)" -ge 20000 ]
  fi
}

# _deliver_tg <file> <caption> [title] — the ONE place a finished track is shipped to the operator's
# Telegram. --nightly and the durable-delivery on-done (mesh-sound-reflex drop grinds → mesh-bg-done)
# both call this, so the sendAudio curl lives once. Fails LOUD: a missing/hollow file or a failed send
# returns non-zero, so a durable-delivery on-done that fails leaves its manifest done-undelivered
# (retryable, gate keeps blocking) instead of silently marking delivered. No creds = a real failure too
# (rc 3) — a delivery that could not have gone out must not read as sent.
_deliver_tg() { # $1=file $2=caption $3=title(optional)
  local f="$1" caption="${2:-}" title="${3:-Room track}"
  valid_track "$f" || { echo "deliver: no valid audio at $f" >&2; return 2; }
  local ENVF="$HOME/.config/remote-access/env"
  [ -f "$ENVF" ] && { set -a; . "$ENVF" 2>/dev/null; set +a; }
  [ -n "${BOT_TOKEN:-}" ] && [ -n "${CHAT_ID:-}" ] || { echo "deliver: no TG creds (BOT_TOKEN/CHAT_ID)" >&2; return 3; }
  local resp crc
  # The @path is double-quoted INSIDE the -F value on purpose: curl reads a bare COMMA as its
  # multi-file separator, and every grinder render name carries one (st[{'ratio': 3}, {'ratio': 3}]).
  # Unquoted, curl splits the path, opens neither half and exits 26 without a network call — see
  # mesh-grind-deliver 6634737, where that stalled 46 renders for 12h.
  # --max-time SCALES WITH THE FILE. A fixed 120s is a latency budget masquerading as a hang backstop:
  # it is a throughput assumption, and on this node's uplink an 8.0M render times out at curl rc=28
  # EVERY attempt while a 230K one ships in 3s — so a big render can never ship, and a retrier just
  # burns attempts on a wall. Base + per-MB, capped so a genuinely dead link still fails in bounded
  # time. Measured 2026-08-20: grind-41a237e8 (8.0M) rc=28 at 120s; 4 of 71 stranded renders are >=4M.
  local _mb _mt
  _mb=$(( ( $(wc -c <"$f" 2>/dev/null || echo 0) + 1048575 ) / 1048576 ))
  _mt=$(( 120 + 90 * _mb )); [ "$_mt" -gt 900 ] && _mt=900
  resp="$(curl -s --max-time "$_mt" "${RM_API_BASE:-https://api.telegram.org}/bot${BOT_TOKEN}/sendAudio" \
            -F "chat_id=${CHAT_ID}" -F "audio=@\"${f}\";type=audio/mpeg" \
            -F "title=${title}" -F "caption=${caption}")"
  crc=$?
  case "$resp" in *'"ok":true'*) echo "deliver: sent → operator TG ($f)"; return 0 ;; esac
  # NAME curl's own exit code. Reading only $resp reported every transport failure as an empty API
  # response, so a file-open failure (26) and a dead network (7) printed the identical line — the
  # message named a cause, not the cause.
  echo "deliver: TG sendAudio FAILED (curl rc=$crc): $(printf '%s' "$resp" | head -c 200)" >&2
  return 4
}

case "${1:-}" in
  --deliver)
    # Ship a single finished track to the operator TG. Used by the grind-durable-delivery on-done so
    # a drop's mix delivers even after the mind /cleared. Args: <file> [caption] [title].
    [ -n "${2:-}" ] || { echo "usage: mesh-room-music --deliver <file> [caption] [title]" >&2; exit 2; }
    _deliver_tg "$2" "${3:-Твой дроп, перемолотый грануляром.}" "${4:-Room drop}"
    exit $? ;;
  # --feed-bound [<feed_secs>] — print "eff_cap <secs> budget <MB> ceil <MB>" for this node, so the
  # memory-derived bound is assertable instead of being a comment. Same reasoning as
  # mesh-soundscape --cut-clip: a claim about how much audio survives has to be drivable.
  --feed-bound)
    shift
    _fs="${1:-0}"
    mem_total_mb="$(awk '/^MemTotal:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)"
    [ -n "$mem_total_mb" ] && [ "$mem_total_mb" -gt 0 ] 2>/dev/null || mem_total_mb=4096
    mem_ceil_mb=$(( mem_total_mb * MEM_CEIL_PCT / 100 ))
    max_feed="$(awk -v c="$mem_ceil_mb" -v b="$MEM_BASE_MB" -v p="$MEM_PER_SEC_MB" \
                  'BEGIN{ if(p<=0)p=1; f=(c-b)/p; if(f<20)f=20; printf "%d", f }')"
    if [ "$CAP_SECS" -gt 0 ] 2>/dev/null; then _ec="$CAP_SECS"; else _ec="$max_feed"; fi
    _bud="${MESH_RMC_BUDGET_MB:-$(( MEM_BASE_MB + MEM_PER_SEC_MB * _fs ))}"
    [ "$_bud" -ge 2500 ] 2>/dev/null || _bud=2500
    echo "eff_cap $_ec budget $_bud ceil $mem_ceil_mb"
    exit 0 ;;

  --test)
    command -v ffmpeg >/dev/null 2>&1 || { echo "smoke-test: n/a (no ffmpeg on this node)"; exit 2; }
    command -v ssh    >/dev/null 2>&1 || { echo "smoke-test: n/a (no ssh on this node)"; exit 2; }
    [ -x "$PY" ] || { echo "smoke-test: n/a (grainneukeln venv python missing at $PY — organ not installed on this node)"; exit 2; }
    [ -f "$GRAIN_DIR/main.py" ] || { echo "smoke-test: n/a (grainneukeln main.py missing in $GRAIN_DIR — organ not installed on this node)"; exit 2; }
    # 1) beat detector: REAL numpy read on a synthetic 120bpm click track (500ms period) — must land
    # on the period or its double (autocorr harmonic), never the flat-input 500 fallback disguising
    # a broken pipeline (that's why the clicks are 120bpm=500ms AND we also check a 400ms track).
    tclick="$(mktemp --suffix=.wav)"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.9*lt(mod(t,0.4),0.03)':d=10" -ar 22050 "$tclick"
    b="$(detect_beat_ms "$tclick")"; rm -f "$tclick"
    { [ "$b" -ge 360 ] && [ "$b" -le 440 ]; } || { [ "$b" -ge 760 ] && [ "$b" -le 840 ]; } \
      || { echo "smoke-test: FAIL (beat detector: 400ms click track read as ${b}ms)"; exit 1; }
    # 2) generator: well-formed combo, l derived from the given beat, and the rotation heuristic —
    # factor, s AND ss drawn away from a seeded SANDBOX params log (never the real one).
    # last 2 renders sit in FAST (s 1.5) then SLOW (s 0.25) so the band-rotation gate below has a
    # unique remaining level (MID). f values {1,0.5,2} and ss {1.0,0.5,1.5} exercise f/ss dedup.
    tlog="$(mktemp)"; printf '%s\n' \
      "t amc l 500 w 4 ss 1.0 s 1.0 ~ beat 500 f 1" \
      "t amc l 250 w 6 ss 0.5 s 1.5 ~ beat 500 f 0.5" \
      "t amc l 1000 w 8 ss 1.5 s 0.25 ~ beat 500 f 2" > "$tlog"
    p="$(PARAMS_LOG="$tlog" ; pick_args 600)"
    grep -qE '^amc l [0-9]+ w [0-9]+ ss [0-9.]+ s [0-9.]+( c [0-9,;]+)? ~ beat 600 f [0-9.]+$' <<<"$p" \
      || { rm -f "$tlog"; echo "smoke-test: FAIL (pick_args returned junk: '$p')"; exit 1; }
    grep -qE ' f (1|0\.5|2)$' <<<"$p" \
      && { rm -f "$tlog"; echo "smoke-test: FAIL (beat factor repeated a recent remix: '$p')"; exit 1; }
    grep -qE '(^| )ss (1\.0|0\.5|1\.5)( |~)' <<<"$p" \
      && { rm -f "$tlog"; echo "smoke-test: FAIL (grain speed repeated a recent remix: '$p')"; exit 1; }
    # tempo-BAND rotation (operator 2026-07-17 "итерации должны дышать по уровням, не крутить близкие
    # грувы"): last 2 renders were FAST (1.5) then SLOW (0.25), so every pick MUST land in the one
    # remaining level — MID (0.75/1.0/1.25) — never fast/slow. Value-dedup ALONE would let s repeat a
    # same-band groove (return 2.0/3.0, still FAST). This is an INVARIANT, not a lucky draw, so drive
    # pick_args 12× and require EVERY draw mid — the assertion FAILS against the old value-only rotation.
    for _i in $(seq 12); do
      sp="$(PARAMS_LOG="$tlog"; pick_args 600 | grep -oE '(^| )s [0-9.]+' | grep -oE '[0-9.]+$')"
      spb="$(band_of_s "$sp")"
      [ "$spb" = "mid" ] || { rm -f "$tlog"; echo "smoke-test: FAIL (tempo band not rotated: s=$sp band=$spb; last 2 renders fast+slow → must be mid)"; exit 1; }
    done
    rm -f "$tlog"
    # 3) l must equal 600×factor (clamped 120-2000, rounded to 10ms)
    fpick="${p##* f }"; lpick="$(grep -oE '(^| )l [0-9]+' <<<"$p" | grep -oE '[0-9]+')"
    lwant="$(awk "BEGIN{v=int(600*$fpick/10+0.5)*10; if(v<120)v=120; if(v>2000)v=2000; print v}")"
    [ "$lpick" = "$lwant" ] || { echo "smoke-test: FAIL (l=$lpick but beat 600 × f $fpick should give $lwant)"; exit 1; }
    # 4) hollow-track gate: valid_track must REJECT a truncated/undecodable mp3 (the real 261-byte
    # 2026-07-10T10:18Z failure that -s let through) and ACCEPT genuine short audio — else a failed
    # grind logs as success and --nightly ships broken audio to the operator.
    thollow="$(mktemp --suffix=.mp3)"; printf 'ID3\003\0\0\0\0\0\0\0' > "$thollow"   # 11-byte stub, non-empty
    if valid_track "$thollow"; then rm -f "$thollow"; echo "smoke-test: FAIL (valid_track accepted an 11-byte hollow mp3)"; exit 1; fi
    rm -f "$thollow"
    tgood="$(mktemp --suffix=.mp3)"; ffmpeg -v quiet -y -f lavfi -i "sine=frequency=440:duration=2" -q:a 9 "$tgood" 2>/dev/null
    valid_track "$tgood" || { rm -f "$tgood"; echo "smoke-test: FAIL (valid_track rejected a real 2s tone mp3)"; exit 1; }
    rm -f "$tgood"
    # 5) SOURCE-STARVE gate — must fire on a one-organ LANE window (real starve) but NOT on hand-driven
    # foreign/direct grinds (an experiment, not the reflex lane). 2026-07-18: 8 direct youtube grinds
    # of the operator's TV video read as "SOURCE-STARVED: youtube 7/7" while the ear lane was idle.
    # NB: capture --diversity output into a var, NEVER pipe it to grep — SOURCE-STARVED exits 1 and
    # `set -o pipefail` (line 22) would turn that meaningful non-zero into a pipeline "failure",
    # masking grep's match (the pipefail-false-verdict trap). case-match the captured string instead.
    tdiv="$(mktemp)"
    # 5a) 7 ear renders = the LANE itself eating one organ → MUST read SOURCE-STARVED.
    : > "$tdiv"; for _i in 1 2 3 4 5 6 7; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=ear/h%d beat 500 f 1\n' "$_i" "$_i"; done > "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in *SOURCE-STARVED*) : ;; *) rm -f "$tdiv"; echo "smoke-test: FAIL (diversity: 7 ear lane renders must read SOURCE-STARVED — got: $_dv)"; exit 1 ;; esac
    # 5b) 7 hand-driven foreign youtube grinds = NOT the lane → must NOT trip the starve alarm.
    : > "$tdiv"; for _i in 1 2 3 4 5 6 7; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=youtube/vid%d v0%d-x\n' "$_i" "$_i" "$_i"; done > "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in *SOURCE-STARVED*) rm -f "$tdiv"; echo "smoke-test: FAIL (diversity: hand-driven foreign youtube grinds must NOT trip SOURCE-STARVED — they are not the reflex lane — got: $_dv)"; exit 1 ;; esac
    # 5b2) TWO WINDOWS ON ONE DEVICE (2026-08-19). `ear` and `scape` are distinct organ labels but
    # the same USB camera mic on this node, so a mixed ear/scape window is NOT source diversity — it
    # is one microphone counted twice. Measured live at 06:40 today: a real "ear 3, scape 1" window
    # fired the *unstarved* poke ("a second source is reaching the grinder again"), which was false.
    # This leg is the FALSE-GREEN direction, and a false green is the worse one — it closes the very
    # question the gate exists to hold open. Seen RED against the organ-share-only verdict.
    : > "$tdiv"
    for _i in 1 2 3 4; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=ear/h%d beat 500 f 1\n' "$_i" "$_i"; done > "$tdiv"
    for _i in 5 6 7; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=scape/h%d beat 500 f 1\n' "$_i" "$_i"; done >> "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in *SOURCE-STARVED*) : ;; *) rm -f "$tdiv"; echo "smoke-test: FAIL (diversity: ear+scape is ONE microphone twice, not a recovered organ mix — must read SOURCE-STARVED — got: $_dv)"; exit 1 ;; esac
    # …and the message must still name a real ORGAN in its first slot: mesh-sound-reflex parses that
    # name out and filters records.log's organ field with it, so a source name there would match
    # nothing and hand the starving organ back as its own alternative.
    _dom="$(printf '%s' "$_dv" | sed -n 's/.*SOURCE-STARVED[^a-z]*\([a-z0-9_-]\{1,\}\) is [0-9]\{1,\}\/.*/\1/p')"
    case "$_dom" in ear|scape) : ;; *) rm -f "$tdiv"; echo "smoke-test: FAIL (the starve message must keep an ORGAN name in its first slot for mesh-sound-reflex to parse — got '$_dom' from: $_dv)"; exit 1 ;; esac
    case "$_dv" in *"same-source: "*) : ;; *) rm -f "$tdiv"; echo "smoke-test: FAIL (the starve message must name the same-source organs so the reflex cannot offer them as alternatives — got: $_dv)"; exit 1 ;; esac
    # 5b3) GENUINELY DIFFERENT DEVICES still read healthy — this gate must not collapse into "always
    # starved". drop (operator files) + ear (the room mic) are two real sources.
    : > "$tdiv"
    for _i in 1 2 3 4; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=ear/h%d beat 500 f 1\n' "$_i" "$_i"; done > "$tdiv"
    for _i in 5 6 7; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=drop/h%d beat 500 f 1\n' "$_i" "$_i"; done >> "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in *SOURCE-STARVED*) rm -f "$tdiv"; echo "smoke-test: FAIL (ear+drop are two REAL sources — must not read SOURCE-STARVED — got: $_dv)"; exit 1 ;; esac
    case "$_dv" in *"sources: "*) : ;; *) rm -f "$tdiv"; echo "smoke-test: FAIL (a healthy verdict must publish the SOURCE mix, not only the organ mix — got: $_dv)"; exit 1 ;; esac
    # 5b4) NON-LANE RENDERS MUST NOT CROWD THE LANE OUT OF THE WINDOW (2026-08-19). PARAMS_LOG is
    #      shared by every grind caller. Selecting the sample with a raw `tail -n 7` meant somebody
    #      else's renders evicted the lane's before the organ filter ran: measured live, 26 of the
    #      last 40 lines carried no src=, leaving 3 lane renders in the last 7 — one under the floor
    #      — so this gate abstained tick after tick on a lane that was rendering steadily. Fixture:
    #      7 ear renders, each separated by two foreign direct grinds. Seen RED against tail -n 7
    #      (it read "too few lane render(s) to judge", i.e. it could not see a pure monoculture).
    : > "$tdiv"
    for _i in 1 2 3 4 5 6 7; do
      printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=ear/h%d beat 500 f 1\n' "$_i" "$_i"
      printf 't amc l 99%d w 5 ss 1.0 s 1.0 ~ beat 1040 f 2\n' "$_i"
      printf 't amc l 98%d w 4 ss 0.5 s 2.0 ~ beat 1040 f 3\n' "$_i"
    done > "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in
      *SOURCE-STARVED*) : ;;
      *) rm -f "$tdiv"; echo "smoke-test: FAIL (7 ear lane renders interleaved with foreign grinds must still read SOURCE-STARVED — a shared params log must not evict the lane from its own gate's window — got: $_dv)"; exit 1 ;;
    esac
    # …and an lane that is GENUINELY idle must still abstain — the wider scan must not invent a
    # sample out of ancient renders that are not there.
    : > "$tdiv"
    for _i in 1 2 3 4 5 6 7; do printf 't amc l 99%d w 5 ss 1.0 s 1.0 ~ beat 1040 f 2\n' "$_i"; done > "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in
      *SOURCE-STARVED*) rm -f "$tdiv"; echo "smoke-test: FAIL (a window with NO lane renders at all must not read SOURCE-STARVED — got: $_dv)"; exit 1 ;;
    esac
    # 5c) n=1 lane-render VACUOUS monoculture must NOT fire SOURCE-STARVED (2026-07-21 false poke:
    # "drop is 1/1 of last 1 lane render(s)" — a SINGLE lane render is 100% of itself by construction,
    # not evidence of monoculture). 1 lane render (drop) + 6 non-lane (youtube) renders in the window.
    : > "$tdiv"
    printf 't amc l 10 w 5 ss 1.0 s 1.0 ~ src=drop/h1 beat 500 f 1\n' > "$tdiv"
    for _i in 2 3 4 5 6 7; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=youtube/vid%d v0%d-x\n' "$_i" "$_i" "$_i"; done >> "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in *SOURCE-STARVED*) rm -f "$tdiv"; echo "smoke-test: FAIL (diversity: a single (n=1) lane render is a VACUOUS 1/1 verdict, not monoculture evidence — must not read SOURCE-STARVED — got: $_dv)"; exit 1 ;; esac
    # 5d) note3 (this node's PRIMARY room ear) must count as a LANE organ — mirrors 5a with note3
    # instead of ear. Was missing from the default MESH_RMC_LANE_ORGANS list, misclassing its renders
    # as direct/experiment and shrinking the lane window that source-starve judges.
    : > "$tdiv"; for _i in 1 2 3 4 5 6 7; do printf 't amc l %d0 w 5 ss 1.0 s 1.0 ~ src=note3/h%d beat 500 f 1\n' "$_i" "$_i"; done > "$tdiv"
    _dv="$(MESH_RMC_PARAMS_LOG="$tdiv" "$0" --diversity 2>/dev/null)"
    case "$_dv" in *SOURCE-STARVED*) : ;; *) rm -f "$tdiv"; echo "smoke-test: FAIL (diversity: 7 note3 lane renders must read SOURCE-STARVED — note3 must count as a lane organ — got: $_dv)"; exit 1 ;; esac
    rm -f "$tdiv"
    # 6) _deliver_tg must OPEN a render whose name carries a comma. Every grinder name does
    # (st[{'ratio': 3}, {'ratio': 3}]) and curl reads a bare comma in an -F @path as its multi-file
    # separator: unquoted it splits the path, opens neither half, and exits 26 before any network
    # call. mesh-grind-deliver lost 46 renders to exactly that (6634737); this is its sibling and
    # ships the SAME files, so it gets the same real-curl gate rather than a source grep.
    _tgd="$(mktemp -d)"
    _plain="$_tgd/plain_render.mp3"
    _comma="$_tgd/l220_w4_ss0.5_s1.5_st[{'ratio': 3}, {'ratio': 3}]_2026_08_17.mp3"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.5*sin(440*2*PI*t)':d=3" -ar 22050 -b:a 96k "$_plain"
    cp "$_plain" "$_comma"
    valid_track "$_comma" || { rm -rf "$_tgd"; echo "smoke-test: FAIL (harness: the comma fixture is not a valid track, so gate 6 asserts nothing)"; exit 1; }
    # drive the REAL sender at a dead local port with real creds-shaped env: it must fail at CONNECT,
    # never at file-open, and identically to a comma-free control (so a red gate can't be the harness)
    _e6="$(BOT_TOKEN=x CHAT_ID=y RM_API_BASE='http://127.0.0.1:1' _deliver_tg "$_plain" c t 2>&1 >/dev/null)"
    _e6c="$(BOT_TOKEN=x CHAT_ID=y RM_API_BASE='http://127.0.0.1:1' _deliver_tg "$_comma" c t 2>&1 >/dev/null)"
    rm -rf "$_tgd"
    case "$_e6" in *'curl rc=26'*) echo "smoke-test: FAIL (harness: even a comma-FREE name fails to open — $_e6)"; exit 1 ;; esac
    case "$_e6c" in *'curl rc=26'*) echo "smoke-test: FAIL (deliver: a comma in the render name broke the -F file open — quote @\"\$f\" — got: $_e6c)"; exit 1 ;; esac
    case "$_e6c" in *'curl rc='*) : ;; *) echo "smoke-test: FAIL (deliver: the failure must NAME curl's exit code, not just an empty API body — got: $_e6c)"; exit 1 ;; esac
    [ "${_e6c#*curl rc=}" = "${_e6#*curl rc=}" ] || { echo "smoke-test: FAIL (deliver: a comma'd name must fail identically to a plain one — comma='$_e6c' plain='$_e6')"; exit 1; }
    # 7. A NON-NATIVE CONTAINER MUST BE NORMALISED REGARDLESS OF LENGTH (2026-08-21). The grind
    #    engine decodes only wav/mp3/webm/m4a (cutter/sample_cut_tool.py _decode_audio_file, else
    #    `raise Exception("File is not wav or mp3 or webm or m4a")`); mesh-records declares
    #    .oga/.ogg/.aac as drop formats too, and nothing converted them — the cap-trim re-encodes as
    #    a SIDE EFFECT, only for sources longer than eff_cap. So a SHORT .oga went to the engine raw
    #    and died while a LONG one worked: format support was a function of DURATION (and of the
    #    derived ss that scales eff_cap). Measured in the corpus: .ogg 55.6s@ss0.25 and .aac
    #    241s@ss0.25 both ground (trimmed); .oga 11.0s@ss1.0 passed raw and rendered nothing.
    #    It ate the operator's voice-note lane — Telegram ships voice as .oga and a short voice note
    #    is exactly the raw case (a10b4867, 11.01s, score 64.4), surfacing as skip:no-render.
    #    Drive the REAL --remix path with GRAIN_DIR pointed at a fixture whose .venv/bin/python is a
    #    stub that records the feed it was handed. Seen RED: the stub received the .oga itself.
    _fn="$(mktemp -d)"; mkdir -p "$_fn/.venv/bin" "$_fn/output"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.5*sin(330*2*PI*t)':d=4" -c:a libopus "$_fn/short.oga" 2>/dev/null
    if [ ! -s "$_fn/short.oga" ]; then
      echo "  format-normalise: n/a (ffmpeg cannot encode opus/.oga here — fixture unbuildable)"
    else
      printf '#!/bin/sh\nfor a; do case "$a" in *.wav|*.mp3|*.webm|*.m4a|*.oga|*.ogg|*.aac) printf "%%s" "$a" > "%s/seen" ;; esac; done\nprintf x > "%s/output/r.mp3"\nexit 0\n' "$_fn" "$_fn" > "$_fn/.venv/bin/python"
      chmod +x "$_fn/.venv/bin/python"; : > "$_fn/main.py"
      MESH_GRAIN_DIR="$_fn" MESH_RMC_AUTOMIX="amc l 120 w 4 ss 1.0 s 1.0" \
        MESH_RMC_PARAMS_LOG="$_fn/params.log" "$0" --remix "$_fn/short.oga" >/dev/null 2>&1
      _seen="$(cat "$_fn/seen" 2>/dev/null)"
      case "$_seen" in
        *.wav) : ;;
        "") rm -rf "$_fn"; echo "smoke-test: FAIL (format-normalise: the remix path handed the grind engine nothing at all — this gate asserts nothing)"; exit 1 ;;
        *) rm -rf "$_fn"; echo "smoke-test: FAIL (format-normalise: a short .oga reached the grind engine as '$_seen'; the engine decodes only wav/mp3/webm/m4a and raises 'File is not wav or mp3 or webm or m4a', so EVERY short .oga drop renders nothing and verdicts skip:no-render — and .oga is the operator's Telegram voice-note format)"; exit 1 ;;
      esac
    fi
    rm -rf "$_fn"

    # ── leg: THE FEED BOUND IS MEMORY, NOT A FLAT 90s. The old constant trimmed every source to
    # its first 90 seconds and said nothing; the operator heard that as "обрывки" for weeks. The
    # bound is derived from this node's own MemTotal, so the leg asserts against THIS node.
    # 1200s on purpose: at 300s the formula lands EXACTLY on the 2500MB floor, so the budget
    # assertion would pass on the floor rather than on the derivation (seen — it read 2500).
    fb="$("$0" --feed-bound 1200)"
    fb_cap="$(awk '{print $2}' <<<"$fb")"; fb_bud="$(awk '{print $4}' <<<"$fb")"
    [ "$fb_cap" -gt 600 ] 2>/dev/null \
      || { echo "smoke-test: FAIL (feed bound is ${fb_cap}s — a bound this tight is the flat cap coming back; a 296s operator drop would be ground from its first ${fb_cap}s)"; exit 1; }
    [ "$fb_bud" -gt 2500 ] 2>/dev/null \
      || { echo "smoke-test: FAIL (budget for a 1200s feed is ${fb_bud}MB, the old CONSTANT — the budget is not tracking the feed, so long sources OOM and the length cap looks necessary again)"; exit 1; }
    fb90="$(MESH_RMC_CAP_SECS=90 "$0" --feed-bound 1200 | awk '{print $2}')"
    [ "$fb90" = "90" ] \
      || { echo "smoke-test: FAIL (an explicit MESH_RMC_CAP_SECS=90 yielded eff_cap ${fb90} — the override is dead, so the derived bound cannot be turned off)"; exit 1; }
    echo "smoke-test: ok (beat detector reads clicks as ${b}ms; pick='$p' honors f/s/ss rotation + l=beat×f; hollow-track gate rejects a 261-byte stub + accepts real audio; source-starve fires on lane-organ monoculture, ignores foreign direct grinds; _deliver_tg opens a comma'd render and names curl's rc; ROOM_NODE=$ROOM_NODE; no capture/Bose side-effect; the feed bound is memory-derived and an explicit cap still overrides it)"
    exit 0 ;;

  --capture)
    secs="${2:-20}"; mkdir -p "$capdir"
    # Retention prune runs UNCONDITIONALLY, FIRST — it is pure housekeeping, independent of whether
    # THIS capture succeeds. It used to sit at the tail of the block, reachable only after a fully-
    # successful non-silent capture, so all five early-exit paths (room node unreachable / speaking-skip
    # / pull-fail / empty / silent) bypassed it. With the room node frequently unreachable, retention
    # rarely fired → day-folders accumulated far past KEEP_DAYS (observed 2026-07-08: 5 days / 427M with
    # KEEP_DAYS=3). Pruning here means old grabs are reclaimed every invocation regardless of outcome.
    if [ -d "$CAPROOT" ]; then
      find "$CAPROOT" -mindepth 1 -maxdepth 1 -type d -mtime +"$KEEP_DAYS" -exec rm -rf {} + 2>/dev/null || true
    fi
    ts="$(date +%Y%m%d-%H%M%S)"; remote="/tmp/rmc-$ts.wav"; local="$capdir/$ts.wav"
    # FEEDBACK GATE (operator 2026-06-21): never record while the mesh itself is making sound — the mic
    # hears the Bose and we'd remix our OWN voice/output (and mis-count it as room "music"/presence). Skip
    # when mesh-overhear's mesh-speaking flag is set (TTS in progress) OR pw-play is running (we're playing
    # something on the Bose). The operator's OWN music (Bluetooth → Bose) has neither, so it still captures.
    # Record on the room node. PipeWire needs XDG_RUNTIME_DIR, absent in a bare ssh shell. timeout ends
    # the record (pw-record runs until killed); `true` swallows the timeout's 124 so the hop succeeds.
    rout="$("${SSH[@]}" "bash -lc 'export XDG_RUNTIME_DIR=/run/user/\$(id -u); if [ -f \$HOME/.mesh/mesh-speaking ] || pgrep -x pw-play >/dev/null 2>&1; then echo RMC_SKIP_SPEAKING; exit 0; fi; timeout $secs pw-record --rate 44100 --channels 2 --format s16 $remote 2>/dev/null; true'" 2>/dev/null)" \
      || { echo "capture: room node unreachable ($ROOM_NODE)"; exit 1; }
    case "$rout" in *RMC_SKIP_SPEAKING*) echo "capture: skipped — mesh is speaking/playing on the Bose (no self-record)"; exit 0;; esac
    scp -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$ROOM_NODE:$remote" "$local" >/dev/null 2>&1 \
      || { echo "capture: pull failed (no audio produced — PipeWire/mic down on room node?)"; "${SSH[@]}" "rm -f $remote" 2>/dev/null; exit 1; }
    "${SSH[@]}" "rm -f $remote" 2>/dev/null || true
    [ -s "$local" ] || { echo "capture: empty wav, discarded"; rm -f "$local"; exit 1; }
    db="$(mean_db "$local")"
    if [ -n "$db" ] && awk "BEGIN{exit !($db < $SILENCE_DB)}"; then
      rm -f "$local"; echo "capture: silent (${db}dB < ${SILENCE_DB}dB) — discarded, nothing playing"; exit 0
    fi
    echo "capture: kept $local (${db:-?}dB, ${secs}s)"
    exit 0 ;;

  --remix)
    mkdir -p "$OUTROOT"
    src="${2:-}"
    feed_tmp=""   # set when WE create a trimmed temp feed (must be cleaned up; the `${2:-}` guards below only protect an UNTRIMMED explicit src)
    if [ -n "$src" ]; then
      [ -f "$src" ] || { echo "remix: no such file $src"; exit 1; }
      # Cap an over-long explicit source the SAME way the capture-concat path does (see line ~12):
      # the automix is O(n^2) and a small-grain + superslow recipe over a multi-minute source
      # explodes the grain array past the 2500MB cgroup cap → rc=137 → skip:oom(budget). This path
      # was UNCAPPED, so the longest sources — exactly the high-value operator drops — bypassed the
      # very cap that exists to prevent this OOM (a477de54, 309.4s, score 72.1 outlier: OOM-killed,
      # never rendered, 2026-07-24). Trim only when the src actually exceeds the cap so short srcs
      # pay no re-encode and are still grinded whole.
      #
      # SUPERSLOW-AWARE CAP: a grain-speed ss<1 stretches each grain ∝ 1/ss, so grind RSS scales with
      # feed/ss — the flat 90s CAP_SECS still OOMs a superslow recipe even after trimming from a
      # multi-minute source (a477de54 at ss=0.25: 90s → rc=137; renders clean at ≤30s, measured
      # 2026-07-24). Scale the effective cap DOWN by ss when superslow so the STRETCHED load
      # (feed/ss) matches what a normal ss>=1 recipe puts on the grind at the full CAP_SECS — i.e.
      # the known-good default. ss>=1 keeps the full cap; floored at 20s so a render stays musical.
      # The superslow multiplier is GONE, and this is the measurement that removed it. The theory it
      # rested on — "a grain-speed ss<1 stretches each grain, so grind RSS scales with feed/ss" — does
      # not hold on the engine as it runs today: at an IDENTICAL feed of 300s the peak was 1351364 KiB
      # at ss 0.25 and 1351052 KiB at ss 1.0, and at a feed of 1160s the most pathological recipe
      # available (90ms grains, w 8, ss 0.25, s 3.0, mode q) peaked 108 KiB BELOW a calm m lib run.
      # Memory does not know what the recipe is; it knows how many seconds it was handed.
      # The observation the theory was built on (a477de54, ss 0.25, 90s -> rc=137, clean at <=30s,
      # 2026-07-24) predates the --low-memory flag below, which removed the rw mixer's 2x accumulate
      # peak. The multiplier was a correct reading of a memory profile that no longer exists, and it
      # was charging exactly the recipes the operator finds most interesting: at ss 0.25 it cut the
      # material to a QUARTER, so the slower the grind, the less of the source it had ever heard.
      # rec_ss is still read — the log line below quotes it, so a future divergence is visible.
      rec_ss="$(awk '{for(i=1;i<NF;i++) if($i=="ss"){print $(i+1); exit}}' <<<"$AUTOMIX_ARGS")"
      # MemTotal is in kB. The ceiling is a SHARE of the node, not a constant: this box has 31GB and
      # was handing a grind 2.5GB of it.
      mem_total_mb="$(awk '/^MemTotal:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)"
      [ -n "$mem_total_mb" ] && [ "$mem_total_mb" -gt 0 ] 2>/dev/null || mem_total_mb=4096
      mem_ceil_mb=$(( mem_total_mb * MEM_CEIL_PCT / 100 ))
      # The longest feed whose PREDICTED peak still fits under that ceiling.
      max_feed="$(awk -v c="$mem_ceil_mb" -v b="$MEM_BASE_MB" -v p="$MEM_PER_SEC_MB" \
                    'BEGIN{ if(p<=0)p=1; f=(c-b)/p; if(f<20)f=20; printf "%d", f }')"
      # An explicit MESH_RMC_CAP_SECS still wins — a node that wants a hard length bound sets one.
      if [ "$CAP_SECS" -gt 0 ] 2>/dev/null; then eff_cap="$CAP_SECS"; else eff_cap="$max_feed"; fi
      sdur="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$src" 2>/dev/null | cut -d. -f1)"
      # FORMAT NORMALISATION, and why it cannot be left to the cap-trim (found live 2026-08-21).
      # The grind engine decodes exactly four containers — cutter/sample_cut_tool.py
      # _decode_audio_file: wav, mp3, webm, m4a, else `raise Exception("File is not wav or mp3 or
      # webm or m4a")`. mesh-records DECLARES five drop formats it cannot read: .oga, .ogg, .aac
      # (plus the two it can). Nothing converted them — the ffmpeg call below is an OOM cap-trim, and
      # it re-encodes to wav only as a SIDE EFFECT, only when the source is longer than eff_cap.
      # So format support was a function of DURATION, and of the derived `ss` that scales eff_cap:
      #   .ogg 55.6s @ ss 0.25 -> eff_cap 22 -> trimmed -> wav -> ground
      #   .aac 241s  @ ss 0.25 -> trimmed -> ground
      #   .oga 11.0s @ ss 1.0  -> eff_cap 90 -> passed RAW -> decoder exception -> no output
      # Every non-native drop in the corpus that ground had been trimmed; the one passed raw died.
      # It surfaced as skip:no-render ("the render crashed or its environment broke"), which was
      # sticky-permanent until the same day, so the record was lost silently and forever.
      # THIS IS THE OPERATOR'S VOICE-NOTE LANE. Telegram ships voice as .oga, he had just asked for
      # MORE mixes of his own voice recordings, and a short voice note is precisely the case that
      # takes the raw path: his most personal material was the one class that could never grind,
      # while long .oga files worked, so the lane looked healthy. (a10b4867, 11.01s, score 64.4.)
      # Convert on FORMAT, independently of length — a decode the engine cannot do is not a
      # size problem and must not be fixed only when the file happens to be big.
      case "${src,,}" in
        *.wav|*.mp3|*.webm|*.m4a) src_native=1 ;;
        *) src_native=0 ;;
      esac
      if [ "$src_native" = 0 ]; then
        feed="/tmp/rmc-feed-$$.wav"; feed_tmp="$feed"
        # Still honour eff_cap here: a long non-native source needs BOTH the conversion and the trim,
        # and -t with no bound would hand the grind an unbounded feed (the very OOM this block guards).
        if [ -n "$sdur" ] && [ "$sdur" -gt "$eff_cap" ] 2>/dev/null; then
          trim_say "$sdur" "$eff_cap" "$mem_ceil_mb"
          ffmpeg -hide_banner -nostats -y -i "$src" -t "$eff_cap" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
        else
          ffmpeg -hide_banner -nostats -y -i "$src" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
        fi
        [ -s "$feed" ] || { echo "remix: format-normalise of $src produced no audio (the grind engine decodes only wav/mp3/webm/m4a)"; rm -f "$feed"; exit 1; }
      elif [ -n "$sdur" ] && [ "$sdur" -gt "$eff_cap" ] 2>/dev/null; then
        feed="/tmp/rmc-feed-$$.wav"; feed_tmp="$feed"
        trim_say "$sdur" "$eff_cap" "$mem_ceil_mb"
        ffmpeg -hide_banner -nostats -y -i "$src" -t "$eff_cap" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
        [ -s "$feed" ] || { echo "remix: cap-trim of $src produced no audio"; rm -f "$feed"; exit 1; }
      else
        feed="$src"
      fi
    else
      # today's captures, newest few, concat + cap length so the automix stays bounded
      mapfile -t files < <(ls -t "$capdir"/*.wav 2>/dev/null | head -6)
      [ "${#files[@]}" -gt 0 ] || { echo "remix: no captures today ($capdir) — nothing to grind"; exit 1; }
      feed="/tmp/rmc-feed-$$.wav"
      if [ "${#files[@]}" -eq 1 ]; then
        ffmpeg -hide_banner -nostats -y -i "${files[0]}" -t "$CAP_SECS" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
      else
        list="/tmp/rmc-list-$$.txt"; : > "$list"
        for f in "${files[@]}"; do printf "file '%s'\n" "$f" >> "$list"; done
        ffmpeg -hide_banner -nostats -y -f concat -safe 0 -i "$list" -t "$CAP_SECS" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
        rm -f "$list"
      fi
      [ -s "$feed" ] || { echo "remix: concat produced no audio"; exit 1; }
    fi
    # grind it (grainneukeln CLI: short clips remix fast; nightly run can afford slow anyway).
    # Args: pinned MESH_RMC_AUTOMIX wins; otherwise rotate the macro-granular pool (see PRESETS).
    # Word-splitting is intentional — the args are a flat token list (amc l 180 w 6 …), never a path.
    # MESH_RMC_META: a caller that pins MESH_RMC_AUTOMIX bypasses pick_args, and with it the "~ beat
    # T f F" provenance — the params-log line loses all trace of WHERE the recipe came from. Callers
    # that derive their own recipe (mesh-sound-reflex, whose params come from the source record's
    # measured character) pass their provenance here, so this stays the single writer of PARAMS_LOG.
    META="${MESH_RMC_META:+ ~ ${MESH_RMC_META}}"
    if [ -z "$AUTOMIX_ARGS" ]; then
      BEAT_MS="$(detect_beat_ms "$feed")"
      pick="$(pick_args "$BEAT_MS")"
      AUTOMIX_ARGS="${pick%% ~ *}"
      META=" ~ ${pick#* ~ }"
    fi
    # Closed-loop Uxn override (opt-in, see UXN_FEEDBACK above). The paramgen ROM measures a rhythm-
    # density feedback byte from THIS feed each tick and XOR-perturbs the c-band, so the recipe tracks
    # the source instead of a fixed pick. --uxn-ctrl bypasses the amc token list entirely (main.py
    # sys.exits after the sequence), so we OVERWRITE AUTOMIX_ARGS rather than append — a pinned
    # MESH_RMC_AUTOMIX is deliberately superseded here (feedback owns the whole recipe). Provenance in
    # the logs records the mode + tick count so PARAMS_LOG stays honest about where the render came from.
    if [ -n "$UXN_FEEDBACK" ]; then
      AUTOMIX_ARGS="--uxn-ctrl --uxn-feedback --uxn-ticks ${UXN_TICKS}"
      # PRESERVE any provenance already in META (a caller's MESH_RMC_META, e.g. the source track
      # name, or the pick_args "~ beat T f F") and APPEND the uxn marker — do NOT clobber it, or the
      # PARAMS_LOG line (and thus grind-deliver's TG caption) loses all trace of WHAT was ground.
      uxn_mark="uxn-feedback ticks=${UXN_TICKS}${BEAT_MS:+ beat ${BEAT_MS}}"
      if [ -n "$META" ]; then META="$META $uxn_mark"; else META=" ~ $uxn_mark"; fi
    fi
    # GAIN lives in grainneukeln now, not here. We used to append `g auto` claiming a -14 dBFS boost —
    # but the automixer has NO `g` command (verified 2026-07-17: a 20-mix batch shipped at mean
    # -33…-47 dBFS, the append was a SILENT NO-OP, and the operator flagged "очень тихо"). The real fix
    # is upstream: grainneukeln's export loudness-normalizes the mix to a target (RMS -16 dBFS, peak
    # capped -1 dBFS) so EVERY consumer — this wrapper, the GUI — gets a sane, level-matched level.
    # Nothing to append; the grind comes out at target on its own. (Beat detection is gain-invariant, so
    # normalizing the OUTPUT never touches the detected rhythm.)
    # Snapshot the newest existing mp3 BEFORE grinding: the fresh-output check below must distinguish
    # "this grind produced a NEW file" from "the grind produced nothing and `ls -t | head` grabbed a
    # STALE pre-existing file". Without it, a failed grind (timeout / empty / a pathological param combo)
    # silently returns yesterday's mp3 as success — and --nightly then re-sends the SAME track to the
    # operator two nights running (observed 2026-07-07: room-music.log logged the identical
    # 07-06_2349 file as the output of two distinct nightly events). Each grind writes a uniquely
    # timestamped filename, so a strictly-newer newest = genuine fresh output.
    pre_out="$(ls -t "$OUTROOT"/*.mp3 2>/dev/null | head -1)"
    # Crash-tolerance (operator 2026-07-19: 'let it crash, but record what caused it'): log the recipe
    # to ATTEMPTS_LOG BEFORE the grind starts, so an OOM/SIGKILL (rc=137) or segfault that takes the
    # process with it still leaves a 'what setting was being tried' record. PARAMS_LOG (below, after
    # success) is the shipped-renders log the diversity watchdog reads; ATTEMPTS_LOG is the
    # investigative log every grind — success or crash — appends to. Decoupled so a noisy crash run
    # does not pollute the diversity signal.
    echo "$(date -u +%FT%TZ) $AUTOMIX_ARGS$META" >> "${ATTEMPTS_LOG}"
    # Route the grainneukeln synth (a 2GB+-RSS python — the 02:04Z OOM victim) through the heavy-job
    # admission shim: nice + serialize + defer under memory pressure (chat-review/heavy-job-admission).
    # Graceful fallback if the shim isn't deployed on this node; a REFUSE (EX_TEMPFAIL 75) means the
    # node is too tight to grind now — skip this round cleanly rather than error on empty output.
    if command -v mesh-heavy-run >/dev/null 2>&1; then
      # --low-memory: the rw mixer's default path accumulates a list of AudioSegments then does a
      # final b"".join — a 2x peak that pushed long feeds (90s+) past the 2500MB cgroup cap and got
      # every cron grind SIGKILLed for 2 days (rc=137, 2026-07-17..19). The low-memory path streams
      # raw bytes into a single bytearray (bit-identical, half the peak) so a grind that fit at 1.3GB
      # peak RSS uncapped now fits comfortably under its budget. The flag is a no-op for poly/q/lib
      # mixers (they don't accumulate); only rw (the default mode) reads it.
            # The budget is DERIVED from what is actually being fed, not a constant. A flat 2500MB is
      # simultaneously too much for a 10s voice note and too little for anything past ~9 minutes,
      # and it was the latter that made the length cap look necessary.
      feed_secs="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$feed" 2>/dev/null | cut -d. -f1)"
      [ -n "$feed_secs" ] || feed_secs=0
      grind_budget="${MESH_RMC_BUDGET_MB:-$(( MEM_BASE_MB + MEM_PER_SEC_MB * feed_secs ))}"
      [ "$grind_budget" -ge 2500 ] 2>/dev/null || grind_budget=2500   # never BELOW the old constant
      ( cd "$GRAIN_DIR" && mesh-heavy-run "$grind_budget" -- "$PY" main.py --low-memory "$feed" "$OUTROOT/" $AUTOMIX_ARGS ) >/dev/null 2>&1
      hr_rc=$?
      if [ "$hr_rc" = 75 ]; then
        echo "remix: deferred — node under memory pressure (mesh-heavy-run refused)"
        # EX_TEMPFAIL (75), NOT 0: a defer is NOT a success. Exiting 0 made --nightly treat the
        # "deferred" string as the track path → a false "track ready" announce to the room mind (and a
        # doomed curl on a non-file). Non-zero lets nightly's `|| exit 1` and the soundscape wrapper
        # both handle it honestly as "no track this round" rather than shipping a phantom.
        [ -n "${2:-}" ] || rm -f "$feed"; [ -n "$feed_tmp" ] && rm -f "$feed_tmp"; exit 75
      elif [ "$hr_rc" = 137 ]; then
        # rc=137 = the grind's python was cgroup-OOM-KILLED at its ${MESH_RMC_BUDGET_MB:-2500}MB
        # MemoryMax ceiling (SIGKILL 9 → 128+9). NOT a defer and NOT degenerate material: admission
        # SEATED the job (its budget fit headroom) but the recipe's RSS ballooned past the per-job cap
        # and the cgroup killed it ALONE. Without this branch the OOM fell through to the FRESH gate
        # below, which exits 1 with a generic "no output" — and mesh-sound-reflex then stamped
        # skip:degenerate on ~10 note3 records in a row (2026-07-18 01:42→02:32) whose material grinds
        # fine at a modest recipe. Same "one message for two causes" lie the 75 branch fixed; own exit
        # code so the reflex labels it skip:oom instead of slandering the material. (mesh-heavy-run's
        # own rc=137 stderr note is swallowed by the >/dev/null 2>&1 above, so say it here.)
        echo "remix: OOM — grind hit its ${MESH_RMC_BUDGET_MB:-2500}MB cgroup memory ceiling and was killed (rc=137); the budget is too small for this recipe (or the recipe is memory-pathological), NOT degenerate material. Recipe: $AUTOMIX_ARGS$META (also in $ATTEMPTS_LOG)"
        [ -n "${2:-}" ] || rm -f "$feed"; [ -n "$feed_tmp" ] && rm -f "$feed_tmp"; exit 137
      fi
    else
      ( cd "$GRAIN_DIR" && "$PY" main.py --low-memory "$feed" "$OUTROOT/" $AUTOMIX_ARGS ) >/dev/null 2>&1
    fi
    [ -n "${2:-}" ] || rm -f "$feed"
    out="$(ls -t "$OUTROOT"/*.mp3 2>/dev/null | head -1)"
    [ -n "$out" ] || { echo "remix: automix produced no output"; exit 1; }
    # HOLLOW gate: -s (non-empty) is NOT audio — a failed grind wrote a 261-byte undecodable mp3
    # (2026-07-10T10:18Z) that passed -s + the FRESH check, logged as success, and --nightly would
    # ship it to the operator as a broken track. Require genuine playable audio, else drop it.
    valid_track "$out" || { echo "remix: automix produced a hollow/undecodable track ($(basename "$out")) — refusing to log/ship a broken grind"; rm -f "$out"; exit 1; }
    # FRESH gate: the grind must have created a strictly-newer file than the pre-grind snapshot.
    # Same newest ⇒ the grind produced nothing and we're looking at a stale file — fail honestly
    # (exit 1) so --nightly reports failure instead of re-sending yesterday's track as fresh, and the
    # soundscape wrapper logs "mix failed" instead of a phantom "mix ready".
    [ "$out" != "$pre_out" ] || { echo "remix: automix produced no FRESH output (grind failed — refusing to resend stale $(basename "$out"))"; exit 1; }
    echo "$(date -u +%FT%TZ) $AUTOMIX_ARGS$META" >> "$PARAMS_LOG"
    echo "$out"
    exit 0 ;;

  --diversity)
    # mind-side watchdog (operator 2026-07-06: "миндом проверять, что разнообразие есть"): distinct
    # param combos across the last 7 remixes. <3 distinct = MONOTONE (usually a pinned MESH_RMC_AUTOMIX
    # or a params-log wipe) — the mind unpins / investigates, the rotation itself never repeats 4-in-a-row.
    # NB: a pinned MESH_RMC_AUTOMIX is no longer sufficient evidence of monotony on its own.
    # mesh-sound-reflex pins a DIFFERENT recipe per invocation — derived from each record's measured
    # character, then repelled from the last N renders by its novelty gate — so it raises diversity
    # rather than flattening it. Diagnose MONOTONE by the combos in the log, not by the presence of a pin.
    # strip the "~ beat/f" metadata: beat varies per SOURCE, so identical automix args must still
    # count as ONE combo (else beat jitter fakes diversity and MONOTONE never fires)
    # THE WINDOW MUST BE 7 LANE RENDERS, NOT 7 LINES (2026-08-19). PARAMS_LOG is written by EVERY
    # caller of the grind — the reflex lane, the scanner's mix, and any hand-driven or experimental
    # render alike. This gate filters lane organs when it COUNTS, but it was selecting its sample by
    # raw `tail -n 7`, so anything else grinding concurrently pushed lane renders out of the window
    # before the filter ever ran. Measured today: 26 of the last 40 lines carry no `src=`, arriving
    # in bursts of 3, leaving 3 lane renders in the last 7 — one under the floor of 4 — so the gate
    # abstained ("too few lane render(s) to judge") on tick after tick while the lane was in fact
    # rendering steadily. A gate starved of samples is not conservative, it is absent: it reports
    # the same "ok" as a healthy lane, which is the false-green shape this very gate was fixed for
    # this morning.
    # Scan a wider raw tail and keep the last 7 LANE lines out of it. A genuinely idle lane still
    # abstains honestly — there is nothing to find in the wider tail either — but a busy lane can no
    # longer be crowded out by somebody else's renders.
    _scan="${MESH_RMC_LANE_SCAN:-60}"
    _lanewin="$(tail -n "$_scan" "$PARAMS_LOG" 2>/dev/null | grep -E ' ~ .*src=[a-z0-9_-]+/' | tail -n 7)"
    _rawtail="$(tail -n 7 "$PARAMS_LOG" 2>/dev/null)"
    # combo diversity is about what WE do to the material, so it too reads the lane window; with no
    # lane render in the whole scan it falls back to the raw tail rather than rendering a blank verdict.
    if [ -n "$_lanewin" ]; then _win="$_lanewin"; else _win="$_rawtail"; fi
    n="$(printf '%s\n' "$_win" | sed 's/^[^ ]* //; s/ ~ .*//' | sort -u | wc -l)"
    total="$(printf '%s\n' "$_win" | grep -c . )"
    if [ "$total" -eq 0 ]; then echo "diversity: no remixes logged yet ($PARAMS_LOG)"; exit 0; fi
    if [ "$n" -lt 3 ] && [ "$total" -ge 4 ]; then
      echo "diversity: MONOTONE — $n distinct combo(s) in last $total remixes (pinned MESH_RMC_AUTOMIX?)"; exit 1
    fi
    # SOURCE axis (2026-07-15). Param-combo rotation is NOT musical diversity: the combos above are
    # what we DO to the material, this is what the material IS. Measured when the operator asked for
    # "diverse music production": the last 7 renders carried 7 distinct combos (green on the old
    # check) while 7/7 came from `ear` and no non-ear record had EVER been ground (459 ear vs voice 5
    # /scape 4/drop 0, voice+scape silent >2h). A perfect rotation applied to one organ's room tone
    # is seven variations of the same material — the axis the operator actually cares about had no
    # guard at all. NB the material's measured spread is the WRONG proxy here: the reflex's ranker
    # deliberately picks standouts, so the selected records' cent/dyn spread (230/0.86) runs WIDER
    # than the corpus IQR (90/0.140) — a spread check reads green while the lane eats one organ.
    # Organ share is the honest axis: it cannot be faked by a ranker that is doing its job.
    _sh="${MESH_RMC_ORGAN_SHARE:-0.85}"
    # LANE-RENDER FLOOR (2026-07-21): SOURCE-STARVED divides top-organ-count/_known — with _known=1
    # that ratio is ALWAYS 1.0 (a single lane render is trivially "100% of itself"), so a lone drop or
    # ear render in an otherwise-direct window read as a vacuous "SOURCE-STARVED — drop is 1/1 of last
    # 1 lane render(s)" false poke, even though 1 sample proves nothing about monoculture. Require a
    # minimum sample of lane renders before the ratio is allowed to mean anything.
    _kf="${MESH_RMC_LANE_FLOOR:-4}"
    # LANE organs only — the mesh's OWN sources (operator 2026-07-17 "own ambient, not foreign"). A
    # hand-driven DIRECT grind of a foreign source (youtube …) or a bare-file --remix is an EXPERIMENT,
    # not the reflex lane, and must not be read as the lane's source diversity: on 2026-07-18, 8 direct
    # youtube grinds of the operator's TV video tripped a false "SOURCE-STARVED: youtube 7/7" while the
    # ear lane was simply idle. Count only organs the reflex actually feeds (src=$organ/$hash form).
    _lane=" ${MESH_RMC_LANE_ORGANS:-ear drop scape voice note3} "
    _org="$(printf '%s\n' "$_win" | sed -n 's/.* ~ .*src=\([^ ]*\).*/\1/p' \
            | awk -F/ '{print (NF>1)? $1 : "manual"}')"
    _mix="$(printf '%s\n' "$_org" | awk -v L="$_lane" 'NF && index(L," "$0" "){print}' | sort | uniq -c | sort -rn)"
    # PHYSICAL SOURCE axis (2026-08-19). Organ share is not source share: two organs can be two
    # WINDOWS ON ONE DEVICE. On mesh-home `ear` and `scape` both read the single USB camera mic —
    # measured: mesh-overhear holds its ALSA PCM exclusively, and since 8605e5a the scanner consumes
    # the ear's own buffer rather than contending for it. So an "ear 3, scape 1" window is one
    # microphone twice, and it fired a FALSE RECOVERY poke at 06:40 ("a second source is reaching the
    # grinder again" — there was no second source). A false green is worse than a false red: it
    # closes the very question the gate exists to keep open.
    # Map organ -> source; anything unmapped is its OWN source, so this only ever merges what has
    # been measured to share a device. Node-local override via MESH_RMC_ORGAN_SOURCE.
    _srcmap="${MESH_RMC_ORGAN_SOURCE:-ear:mic scape:mic}"
    _srcof(){ case " $_srcmap " in *" $1:"*) printf '%s' "$_srcmap" | tr ' ' '\n' | awk -F: -v o="$1" '$1==o{print $2; exit}' ;; *) printf '%s\n' "$1" ;; esac; }
    _srcs="$(printf '%s\n' "$_org" | awk -v L="$_lane" 'NF && index(L," "$0" "){print}' \
             | while read -r _o; do _srcof "$_o"; done | sort | uniq -c | sort -rn)"
    _direct="$(printf '%s\n' "$_org" | awk -v L="$_lane" 'NF && !index(L," "$0" "){c++} END{print c+0}')"
    if [ -n "$_mix" ] && [ "$total" -ge 4 ]; then
      _top="$(awk 'NR==1{print $2}' <<<"$_mix")"; _tn="$(awk 'NR==1{print $1}' <<<"$_mix")"
      _known="$(awk '{s+=$1} END{print s+0}' <<<"$_mix")"
      _pretty="$(awk '{printf "%s%s %s", (NR>1?", ":""), $2, $1} END{print ""}' <<<"$_mix")"
      if [ "$_known" -lt "$_kf" ]; then
        echo "diversity: ok — too few lane render(s) to judge ($_known lane render(s) in last $total, need >= $_kf) · organs: ${_pretty}"
        exit 0
      fi
      # The verdict is decided on the SOURCE axis; the message keeps the top ORGAN in its first slot
      # because mesh-sound-reflex parses that name out and filters records.log's organ field with it
      # (a source name there would match nothing and list the starving organ back as an alternative).
      _stop="$(awk 'NR==1{print $2}' <<<"$_srcs")"; _stn="$(awk 'NR==1{print $1}' <<<"$_srcs")"
      _spretty="$(awk '{printf "%s%s %s", (NR>1?", ":""), $2, $1} END{print ""}' <<<"$_srcs")"
      # organs that share the dominant source — the reflex must not offer these as alternatives
      _sibs="$(printf '%s\n' "$_org" | awk -v L="$_lane" 'NF && index(L," "$0" "){print}' | sort -u \
               | while read -r _o; do [ "$(_srcof "$_o")" = "$_stop" ] && printf '%s,' "$_o"; done | sed 's/,$//')"
      if awk -v t="$_stn" -v k="$_known" -v s="$_sh" 'BEGIN{exit !(k>0 && t/k >= s)}'; then
        echo "diversity: SOURCE-STARVED — ${_top} is ${_tn}/${_known} of last ${_known} lane render(s) (params fine: $n distinct combo(s)) · organs: ${_pretty} · source: ${_stop} ${_stn}/${_known} · same-source: ${_sibs}"
        exit 1
      fi
      echo "diversity: ok — $n distinct combo(s) in last $total remixes · lane organs: ${_pretty} · sources: ${_spretty}"
      exit 0
    elif [ "$total" -ge 4 ]; then
      # window has renders but NONE are lane organs — all direct/experiment grinds. Not startable.
      echo "diversity: ok — no lane renders in last $total (${_direct} direct/experiment grind(s), not the reflex lane)"
      exit 0
    fi
    echo "diversity: ok — $n distinct combo(s) in last $total remixes"
    exit 0 ;;

  --nightly)
    out="$("$0" --remix)" || { echo "nightly: $out"; exit 1; }
    echo "nightly: remix -> $out"
    used="$(tail -n 1 "$PARAMS_LOG" 2>/dev/null | sed 's/^[^ ]* //')"
    # deliver to the operator (TG audio) — best-effort; caption carries the combo (operator wants
    # to see which params made which track). Shared _deliver_tg is the single sendAudio path.
    _deliver_tg "$out" \
      "Ночная склейка: звук твоей комнаты за сегодня, перемолотый грануляром. Параметры: ${used:-?}" \
      "Room remix ($day)" >/dev/null 2>&1 && echo "nightly: sent to operator TG"
    # let Миша know his expressive material is ready (he decides whether to play it on the Bose)
    command -v mesh-tell >/dev/null 2>&1 && \
      mesh-tell room "[room-music] Ночной трек-склейка из звука комнаты готов: $out (параметры: ${used:-?}). Если оператор в комнате и уместно — можешь поставить его на Bose (mesh-room-music --play \"$out\") как свой музыкальный ход к контакту. Изредка проверяй mesh-room-music --diversity — если MONOTONE, разбери почему (обычно запиненный MESH_RMC_AUTOMIX). Не блокируйся на этом." >/dev/null 2>&1
    exit 0 ;;

  --play)
    f="${2:-}"; [ -f "$f" ] || { echo "play: no such file $f"; exit 1; }
    # voice gate (operator 2026-06-24): honor the ROOM NODE's silence / thermal auto-mute.
    if command -v mesh-voice-gate >/dev/null 2>&1 && ! mesh-voice-gate --node "$ROOM_NODE" 2>/dev/null; then
      echo "play: suppressed (voice gate on $ROOM_NODE)"; exit 0
    fi
    # convert to wav (pw-play wants pcm) and push to the room node
    wav="/tmp/rmc-play-$$.wav"; rf="/tmp/rmc-play-$$.wav"
    ffmpeg -hide_banner -nostats -y -i "$f" -ac 2 -ar 44100 "$wav" >/dev/null 2>&1
    scp -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$wav" "$ROOM_NODE:$rf" >/dev/null 2>&1 \
      || { echo "play: push to room node failed"; rm -f "$wav"; exit 1; }
    rm -f "$wav"
    # play on the room node, aimed at the Bose sink (fall back to default if it dropped). Single-quoted
    # remote payload keeps the awk clean; only $rf is templated in by the outer shell.
    remote_play="
export XDG_RUNTIME_DIR=/run/user/\$(id -u)
bid=\$(wpctl status 2>/dev/null | awk '/Sinks:/{s=1;next} /Sources:/{s=0} s && tolower(\$0) ~ /bose|soundlink/ {for(i=1;i<=NF;i++) if(\$i ~ /^[0-9]+\.$/){gsub(/\./,\"\",\$i); print \$i; exit}}')
[ -n \"\$bid\" ] && wpctl set-default \$bid 2>/dev/null
if [ -n \"\$bid\" ]; then pw-play --target \$bid $rf 2>/dev/null; else pw-play $rf 2>/dev/null; fi
rm -f $rf
"
    "${SSH[@]}" "bash -lc '$remote_play'" && echo "play: sent to room Bose ($f)"
    exit 0 ;;

  *)
    echo "usage: mesh-room-music --capture [secs] | --remix [src.wav] | --nightly | --play <file> | --diversity | --test"; exit 1 ;;
esac
