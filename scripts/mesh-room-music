#!/usr/bin/env bash
# mesh-room-music — "music from the home": capture short chunks of whatever sound is playing in the
# room (mic on the room node), then re-grind them into NEW music with the revived granular sampler
# (grainneukeln). Operator's idea 2026-06-21: not synth-from-zero but generative-from-ambient — the
# room's own sound, beat-windowed and recombined. Slow is fine (operator: "можно ночью") so the heavy
# remix runs as a nightly batch on the mind node (8c), never on the freeze-prone room node.
#
#   mesh-room-music --capture [secs]   record ~secs (default 20) of the room mic into today's buffer;
#                                      discards near-silent grabs (don't remix silence). DAYTIME reflex.
#   mesh-room-music --remix [src.wav]  re-grind today's captures (or one file) -> a granular remix mp3;
#                                      prints the output path. Bounded: concats only the last few grabs
#                                      and caps length so the O(n^2) automix stays cheap-ish.
#   mesh-room-music --nightly          --remix the day + send the track to the operator (TG) + tell Миша.
#   mesh-room-music --play <file>      play a finished track on the room Bose (mind/Миша choice, not auto).
#   mesh-room-music --diversity        mind watchdog: distinct param combos over the last 7 remixes.
#   mesh-room-music --test             smoke: deps + grainneukeln venv + preset rotation (no capture/Bose).
#
# Heavy compute stays OFF the room node. Capture is the only thing that touches it (cheap pw-record).
# reflex-cadence: none
# orphan-ok: capture/nightly cadences are wired explicitly below per-node (daytime capture + 03:0x remix);
#            left unwired in the genome so a node opts in via mesh-autowire only where a room mic exists.
set -uo pipefail
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

GRAIN_DIR="${MESH_GRAIN_DIR:-$HOME/grainneukeln}"
PY="$GRAIN_DIR/.venv/bin/python"
CAPROOT="$GRAIN_DIR/captures"
OUTROOT="$GRAIN_DIR/output"
ROOM_NODE="${ROOM_NODE:-imozerov@100.125.157.75}"
KEEP_DAYS="${MESH_RMC_KEEP_DAYS:-3}"          # prune capture day-folders older than this
SILENCE_DB="${MESH_RMC_SILENCE_DB:--55}"      # mean_volume below this (dB) = silence, skip
CAP_SECS="${MESH_RMC_CAP_SECS:-90}"           # max audio fed to the automix (bounds remix time)
# AUTOMIX params — BEAT-SYNCED grains (operator 2026-07-06: "весь трюк интересных ритмов — пусть
# алгоритм определит окно что есть [период бита, условно 600мс], его умножив или поделив на 2 или 3,
# потом ещё крутить s и ss в разные стороны; 100 кажется оч мелким"). The generator:
#   1. detect_beat_ms() finds the source's own beat period T (onset-envelope autocorrelation, numpy;
#      falls back to 500ms on flat/short input),
#   2. grain length l = T × factor, factor ∈ {1/3, 1/2, 1, 2, 3}, clamped 120–2000ms,
#   3. factor AND track speed s AND grain speed ss rotate: drawn only from values ABSENT in the
#      last $ROTATE_EXCLUDE remixes — texture and rhythm are forced to move every run.
# Each pick is logged to $PARAMS_LOG (with "~ beat T f F" metadata after the args) and lands in the
# TG caption; `--diversity` is the mind-side watchdog (a pinned MESH_RMC_AUTOMIX bypasses the
# generator, and --diversity is what catches the resulting monotony).
PARAMS_LOG="${MESH_RMC_PARAMS_LOG:-$HOME/.mesh/room-music-params.log}"   # overridable so --test sandboxes
ROTATE_EXCLUDE="${MESH_RMC_ROTATE_EXCLUDE:-3}"
F_VALS=(0.2 0.33 0.5 1 2 3)                               # beat-period multiplier for grain length
                                                          # (0.2 keeps the approved micro-grain regime in the pool:
                                                          # operator 2026-07-06 "но и твои тоже интересные")
W_VALS=(4 5 6 8)                                          # window divider (grain density)
SS_VALS=(0.25 0.5 0.75 1.0 1.25 1.5 2.0)                  # grain playback speed (pitch/texture; 0.25/2.0 =
                                                          # super-slow smear / chipmunk edges, operator 2026-07-06)
S_VALS=(0.25 0.5 0.75 1.0 1.25 1.5 2.0 3.0)               # TRACK speed — the rhythm axis ("суперзамедления
                                                          # и потом ускорения": 0.25 crawl, 3.0 sprint)
C_VALS=("" "" "c 1,250;500,15000" "c 100,8000" "c 1,300;2000,16000" "c 40,400" "c 300,12000")
                                                          # band filters; "" twice = unfiltered is common
detect_beat_ms() { # $1 wav -> beat period in ms (250-1200), 500 on any failure. System python3 (numpy), not $PY.
  python3 - "$1" 2>/dev/null <<'PYEOF' || echo 500
import sys, subprocess
import numpy as np
raw = subprocess.run(["ffmpeg","-v","quiet","-i",sys.argv[1],"-ac","1","-ar","22050","-f","s16le","-"],
                     capture_output=True).stdout
x = np.frombuffer(raw, np.int16).astype(np.float32)
if x.size < 22050*4: print(500); sys.exit()
hop = 512
n = x.size // hop
env = np.abs(x[:n*hop]).reshape(n, hop).mean(1)
onset = np.diff(env); onset[onset < 0] = 0
onset = onset - onset.mean()
sr = 22050.0/hop
lo, hi = int(0.25*sr), int(1.2*sr)
ac = np.correlate(onset, onset, 'full')[onset.size-1:]
if hi >= ac.size or ac[lo:hi].max() <= 0: print(500); sys.exit()
lag = lo + int(np.argmax(ac[lo:hi]))
ms = int(round(lag/sr*1000/10.0)*10)
print(ms if 250 <= ms <= 1200 else 500)
PYEOF
}
pick_args() { # $1 = beat period ms; factor, s AND ss drawn only from values ABSENT in the last $ROTATE_EXCLUDE remixes.
              # Prints ONE line: '<automix args> ~ beat <ms> f <factor>' — caller splits at " ~ "
              # (command substitution is a subshell, so a global var could not carry the factor out).
  local beat="${1:-500}" recent v l s ss w c f fa=() sa=() ssa=()
  recent="$(tail -n "$ROTATE_EXCLUDE" "$PARAMS_LOG" 2>/dev/null | sed 's/^[^ ]* //')"
  for v in "${F_VALS[@]}";  do grep -qE "(^| )f $v( |\$)" <<<"$recent" || fa+=("$v"); done
  for v in "${S_VALS[@]}";  do grep -qE "(^| )s $v( |\$)" <<<"$recent" || sa+=("$v"); done
  for v in "${SS_VALS[@]}"; do grep -qE "(^| )ss $v( |\$)" <<<"$recent" || ssa+=("$v"); done
  [ "${#fa[@]}" -gt 0 ]  || fa=("${F_VALS[@]}")
  [ "${#sa[@]}" -gt 0 ]  || sa=("${S_VALS[@]}")
  [ "${#ssa[@]}" -gt 0 ] || ssa=("${SS_VALS[@]}")
  f="${fa[$((RANDOM % ${#fa[@]}))]}"
  s="${sa[$((RANDOM % ${#sa[@]}))]}"
  ss="${ssa[$((RANDOM % ${#ssa[@]}))]}"
  w="${W_VALS[$((RANDOM % ${#W_VALS[@]}))]}"
  c="${C_VALS[$((RANDOM % ${#C_VALS[@]}))]}"
  l="$(awk "BEGIN{v=int($beat*$f/10+0.5)*10; if(v<120)v=120; if(v>2000)v=2000; print v}")"
  printf 'amc l %s w %s ss %s s %s%s ~ beat %s f %s\n' "$l" "$w" "$ss" "$s" "${c:+ $c}" "$beat" "$f"
}
AUTOMIX_ARGS="${MESH_RMC_AUTOMIX:-}"
SSH=(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$ROOM_NODE")
day="$(date +%F)"; capdir="$CAPROOT/$day"

mean_db() { # $1 wav -> mean volume in dB (empty if undetectable)
  ffmpeg -hide_banner -nostats -i "$1" -af volumedetect -f null - 2>&1 \
    | grep -oE 'mean_volume: [-0-9.]+ dB' | grep -oE '[-0-9.]+' | head -1
}

case "${1:-}" in
  --test)
    command -v ffmpeg >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ffmpeg)"; exit 1; }
    command -v ssh    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
    [ -x "$PY" ] || { echo "smoke-test: FAIL (grainneukeln venv python missing at $PY — run uv venv in $GRAIN_DIR)"; exit 1; }
    [ -f "$GRAIN_DIR/main.py" ] || { echo "smoke-test: FAIL (grainneukeln main.py missing in $GRAIN_DIR)"; exit 1; }
    # 1) beat detector: REAL numpy read on a synthetic 120bpm click track (500ms period) — must land
    # on the period or its double (autocorr harmonic), never the flat-input 500 fallback disguising
    # a broken pipeline (that's why the clicks are 120bpm=500ms AND we also check a 400ms track).
    tclick="$(mktemp --suffix=.wav)"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.9*lt(mod(t,0.4),0.03)':d=10" -ar 22050 "$tclick"
    b="$(detect_beat_ms "$tclick")"; rm -f "$tclick"
    { [ "$b" -ge 360 ] && [ "$b" -le 440 ]; } || { [ "$b" -ge 760 ] && [ "$b" -le 840 ]; } \
      || { echo "smoke-test: FAIL (beat detector: 400ms click track read as ${b}ms)"; exit 1; }
    # 2) generator: well-formed combo, l derived from the given beat, and the rotation heuristic —
    # factor, s AND ss drawn away from a seeded SANDBOX params log (never the real one).
    tlog="$(mktemp)"; printf '%s\n' \
      "t amc l 500 w 4 ss 1.0 s 1.0 ~ beat 500 f 1" \
      "t amc l 250 w 6 ss 0.5 s 1.25 ~ beat 500 f 0.5" \
      "t amc l 1000 w 8 ss 1.5 s 0.75 ~ beat 500 f 2" > "$tlog"
    p="$(PARAMS_LOG="$tlog" ; pick_args 600)"
    rm -f "$tlog"
    grep -qE '^amc l [0-9]+ w [0-9]+ ss [0-9.]+ s [0-9.]+( c [0-9,;]+)? ~ beat 600 f [0-9.]+$' <<<"$p" \
      || { echo "smoke-test: FAIL (pick_args returned junk: '$p')"; exit 1; }
    grep -qE ' f (1|0\.5|2)$' <<<"$p" \
      && { echo "smoke-test: FAIL (beat factor repeated a recent remix: '$p')"; exit 1; }
    grep -qE '(^| )s (1\.0|1\.25|0\.75)( |~)' <<<"$p" \
      && { echo "smoke-test: FAIL (track speed repeated a recent remix — rhythm axis stuck: '$p')"; exit 1; }
    grep -qE '(^| )ss (1\.0|0\.5|1\.5)( |~)' <<<"$p" \
      && { echo "smoke-test: FAIL (grain speed repeated a recent remix: '$p')"; exit 1; }
    # 3) l must equal 600×factor (clamped 120-2000, rounded to 10ms)
    fpick="${p##* f }"; lpick="$(grep -oE '(^| )l [0-9]+' <<<"$p" | grep -oE '[0-9]+')"
    lwant="$(awk "BEGIN{v=int(600*$fpick/10+0.5)*10; if(v<120)v=120; if(v>2000)v=2000; print v}")"
    [ "$lpick" = "$lwant" ] || { echo "smoke-test: FAIL (l=$lpick but beat 600 × f $fpick should give $lwant)"; exit 1; }
    echo "smoke-test: ok (beat detector reads clicks as ${b}ms; pick='$p' honors f/s/ss rotation + l=beat×f; ROOM_NODE=$ROOM_NODE; no capture/Bose side-effect)"
    exit 0 ;;

  --capture)
    secs="${2:-20}"; mkdir -p "$capdir"
    ts="$(date +%Y%m%d-%H%M%S)"; remote="/tmp/rmc-$ts.wav"; local="$capdir/$ts.wav"
    # FEEDBACK GATE (operator 2026-06-21): never record while the mesh itself is making sound — the mic
    # hears the Bose and we'd remix our OWN voice/output (and mis-count it as room "music"/presence). Skip
    # when mesh-overhear's mesh-speaking flag is set (TTS in progress) OR pw-play is running (we're playing
    # something on the Bose). The operator's OWN music (Bluetooth → Bose) has neither, so it still captures.
    # Record on the room node. PipeWire needs XDG_RUNTIME_DIR, absent in a bare ssh shell. timeout ends
    # the record (pw-record runs until killed); `true` swallows the timeout's 124 so the hop succeeds.
    rout="$("${SSH[@]}" "bash -lc 'export XDG_RUNTIME_DIR=/run/user/\$(id -u); if [ -f \$HOME/.mesh/mesh-speaking ] || pgrep -x pw-play >/dev/null 2>&1; then echo RMC_SKIP_SPEAKING; exit 0; fi; timeout $secs pw-record --rate 44100 --channels 2 --format s16 $remote 2>/dev/null; true'" 2>/dev/null)" \
      || { echo "capture: room node unreachable ($ROOM_NODE)"; exit 1; }
    case "$rout" in *RMC_SKIP_SPEAKING*) echo "capture: skipped — mesh is speaking/playing on the Bose (no self-record)"; exit 0;; esac
    scp -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$ROOM_NODE:$remote" "$local" >/dev/null 2>&1 \
      || { echo "capture: pull failed (no audio produced — PipeWire/mic down on room node?)"; "${SSH[@]}" "rm -f $remote" 2>/dev/null; exit 1; }
    "${SSH[@]}" "rm -f $remote" 2>/dev/null || true
    [ -s "$local" ] || { echo "capture: empty wav, discarded"; rm -f "$local"; exit 1; }
    db="$(mean_db "$local")"
    if [ -n "$db" ] && awk "BEGIN{exit !($db < $SILENCE_DB)}"; then
      rm -f "$local"; echo "capture: silent (${db}dB < ${SILENCE_DB}dB) — discarded, nothing playing"; exit 0
    fi
    # prune old day-folders
    if [ -d "$CAPROOT" ]; then
      find "$CAPROOT" -mindepth 1 -maxdepth 1 -type d -mtime +"$KEEP_DAYS" -exec rm -rf {} + 2>/dev/null || true
    fi
    echo "capture: kept $local (${db:-?}dB, ${secs}s)"
    exit 0 ;;

  --remix)
    mkdir -p "$OUTROOT"
    src="${2:-}"
    if [ -n "$src" ]; then
      [ -f "$src" ] || { echo "remix: no such file $src"; exit 1; }
      feed="$src"
    else
      # today's captures, newest few, concat + cap length so the automix stays bounded
      mapfile -t files < <(ls -t "$capdir"/*.wav 2>/dev/null | head -6)
      [ "${#files[@]}" -gt 0 ] || { echo "remix: no captures today ($capdir) — nothing to grind"; exit 1; }
      feed="/tmp/rmc-feed-$$.wav"
      if [ "${#files[@]}" -eq 1 ]; then
        ffmpeg -hide_banner -nostats -y -i "${files[0]}" -t "$CAP_SECS" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
      else
        list="/tmp/rmc-list-$$.txt"; : > "$list"
        for f in "${files[@]}"; do printf "file '%s'\n" "$f" >> "$list"; done
        ffmpeg -hide_banner -nostats -y -f concat -safe 0 -i "$list" -t "$CAP_SECS" -ac 2 -ar 44100 "$feed" >/dev/null 2>&1
        rm -f "$list"
      fi
      [ -s "$feed" ] || { echo "remix: concat produced no audio"; exit 1; }
    fi
    # grind it (grainneukeln CLI: short clips remix fast; nightly run can afford slow anyway).
    # Args: pinned MESH_RMC_AUTOMIX wins; otherwise rotate the macro-granular pool (see PRESETS).
    # Word-splitting is intentional — the args are a flat token list (amc l 180 w 6 …), never a path.
    META=""
    if [ -z "$AUTOMIX_ARGS" ]; then
      BEAT_MS="$(detect_beat_ms "$feed")"
      pick="$(pick_args "$BEAT_MS")"
      AUTOMIX_ARGS="${pick%% ~ *}"
      META=" ~ ${pick#* ~ }"
    fi
    # Lift quiet feeds to audibility before grinding (operator 2026-07-06: "если тишина реально
    # тихая — можно увеличить громкость через гейн, чтобы звук из тишины вытащить"). `g auto` is
    # BOOST-ONLY (targets mean -14 dBFS, peak capped -1 dBFS) so it no-ops on already-loud sources
    # and only rescues quiet night captures — the 2026-07-06 nightly went out at -36 dB (inaudible)
    # because a full day of captures was -28…-33 dB. Self-gating, so append unconditionally unless a
    # pinned MESH_RMC_AUTOMIX already carries its own `g`. (Beat detection is gain-invariant — verified
    # in the gain-order A/B — so this changes audibility+grind texture, not the detected rhythm.)
    case " $AUTOMIX_ARGS " in *" g "*) : ;; *) AUTOMIX_ARGS="$AUTOMIX_ARGS g auto" ;; esac
    # Snapshot the newest existing mp3 BEFORE grinding: the fresh-output check below must distinguish
    # "this grind produced a NEW file" from "the grind produced nothing and `ls -t | head` grabbed a
    # STALE pre-existing file". Without it, a failed grind (timeout / empty / a pathological param combo)
    # silently returns yesterday's mp3 as success — and --nightly then re-sends the SAME track to the
    # operator two nights running (observed 2026-07-07: room-music.log logged the identical
    # 07-06_2349 file as the output of two distinct nightly events). Each grind writes a uniquely
    # timestamped filename, so a strictly-newer newest = genuine fresh output.
    pre_out="$(ls -t "$OUTROOT"/*.mp3 2>/dev/null | head -1)"
    # Route the grainneukeln synth (a 2GB+-RSS python — the 02:04Z OOM victim) through the heavy-job
    # admission shim: nice + serialize + defer under memory pressure (chat-review/heavy-job-admission).
    # Graceful fallback if the shim isn't deployed on this node; a REFUSE (EX_TEMPFAIL 75) means the
    # node is too tight to grind now — skip this round cleanly rather than error on empty output.
    if command -v mesh-heavy-run >/dev/null 2>&1; then
      ( cd "$GRAIN_DIR" && mesh-heavy-run "${MESH_RMC_BUDGET_MB:-2500}" -- "$PY" main.py "$feed" "$OUTROOT/" $AUTOMIX_ARGS ) >/dev/null 2>&1
      if [ "$?" = 75 ]; then
        echo "remix: deferred — node under memory pressure (mesh-heavy-run refused)"
        # EX_TEMPFAIL (75), NOT 0: a defer is NOT a success. Exiting 0 made --nightly treat the
        # "deferred" string as the track path → a false "track ready" announce to the room mind (and a
        # doomed curl on a non-file). Non-zero lets nightly's `|| exit 1` and the soundscape wrapper
        # both handle it honestly as "no track this round" rather than shipping a phantom.
        [ -n "${2:-}" ] || rm -f "$feed"; exit 75
      fi
    else
      ( cd "$GRAIN_DIR" && "$PY" main.py "$feed" "$OUTROOT/" $AUTOMIX_ARGS ) >/dev/null 2>&1
    fi
    [ -n "${2:-}" ] || rm -f "$feed"
    out="$(ls -t "$OUTROOT"/*.mp3 2>/dev/null | head -1)"
    [ -n "$out" ] && [ -s "$out" ] || { echo "remix: automix produced no output"; exit 1; }
    # FRESH gate: the grind must have created a strictly-newer file than the pre-grind snapshot.
    # Same newest ⇒ the grind produced nothing and we're looking at a stale file — fail honestly
    # (exit 1) so --nightly reports failure instead of re-sending yesterday's track as fresh, and the
    # soundscape wrapper logs "mix failed" instead of a phantom "mix ready".
    [ "$out" != "$pre_out" ] || { echo "remix: automix produced no FRESH output (grind failed — refusing to resend stale $(basename "$out"))"; exit 1; }
    echo "$(date -u +%FT%TZ) $AUTOMIX_ARGS$META" >> "$PARAMS_LOG"
    echo "$out"
    exit 0 ;;

  --diversity)
    # mind-side watchdog (operator 2026-07-06: "миндом проверять, что разнообразие есть"): distinct
    # param combos across the last 7 remixes. <3 distinct = MONOTONE (usually a pinned MESH_RMC_AUTOMIX
    # or a params-log wipe) — the mind unpins / investigates, the rotation itself never repeats 4-in-a-row.
    # strip the "~ beat/f" metadata: beat varies per SOURCE, so identical automix args must still
    # count as ONE combo (else beat jitter fakes diversity and MONOTONE never fires)
    n="$(tail -n 7 "$PARAMS_LOG" 2>/dev/null | sed 's/^[^ ]* //; s/ ~ .*//' | sort -u | wc -l)"
    total="$(tail -n 7 "$PARAMS_LOG" 2>/dev/null | wc -l)"
    if [ "$total" -eq 0 ]; then echo "diversity: no remixes logged yet ($PARAMS_LOG)"; exit 0; fi
    if [ "$n" -lt 3 ] && [ "$total" -ge 4 ]; then
      echo "diversity: MONOTONE — $n distinct combo(s) in last $total remixes (pinned MESH_RMC_AUTOMIX?)"; exit 1
    fi
    echo "diversity: ok — $n distinct combo(s) in last $total remixes"
    exit 0 ;;

  --nightly)
    out="$("$0" --remix)" || { echo "nightly: $out"; exit 1; }
    echo "nightly: remix -> $out"
    used="$(tail -n 1 "$PARAMS_LOG" 2>/dev/null | sed 's/^[^ ]* //')"
    # deliver to the operator (TG audio) — best-effort; caption carries the combo (operator wants
    # to see which params made which track)
    ENVF="$HOME/.config/remote-access/env"; [ -f "$ENVF" ] && { set -a; . "$ENVF" 2>/dev/null; set +a; }
    if [ -n "${BOT_TOKEN:-}" ] && [ -n "${CHAT_ID:-}" ]; then
      curl -s --max-time 90 "https://api.telegram.org/bot${BOT_TOKEN}/sendAudio" \
        -F "chat_id=${CHAT_ID}" -F "audio=@${out};type=audio/mpeg" \
        -F "title=Room remix ($day)" \
        -F "caption=Ночная склейка: звук твоей комнаты за сегодня, перемолотый грануляром. Параметры: ${used:-?}" \
        >/dev/null 2>&1 && echo "nightly: sent to operator TG"
    fi
    # let Миша know his expressive material is ready (he decides whether to play it on the Bose)
    command -v mesh-tell >/dev/null 2>&1 && \
      mesh-tell room "[room-music] Ночной трек-склейка из звука комнаты готов: $out (параметры: ${used:-?}). Если оператор в комнате и уместно — можешь поставить его на Bose (mesh-room-music --play \"$out\") как свой музыкальный ход к контакту. Изредка проверяй mesh-room-music --diversity — если MONOTONE, разбери почему (обычно запиненный MESH_RMC_AUTOMIX). Не блокируйся на этом." >/dev/null 2>&1
    exit 0 ;;

  --play)
    f="${2:-}"; [ -f "$f" ] || { echo "play: no such file $f"; exit 1; }
    # voice gate (operator 2026-06-24): honor the ROOM NODE's silence / thermal auto-mute.
    if command -v mesh-voice-gate >/dev/null 2>&1 && ! mesh-voice-gate --node "$ROOM_NODE" 2>/dev/null; then
      echo "play: suppressed (voice gate on $ROOM_NODE)"; exit 0
    fi
    # convert to wav (pw-play wants pcm) and push to the room node
    wav="/tmp/rmc-play-$$.wav"; rf="/tmp/rmc-play-$$.wav"
    ffmpeg -hide_banner -nostats -y -i "$f" -ac 2 -ar 44100 "$wav" >/dev/null 2>&1
    scp -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$wav" "$ROOM_NODE:$rf" >/dev/null 2>&1 \
      || { echo "play: push to room node failed"; rm -f "$wav"; exit 1; }
    rm -f "$wav"
    # play on the room node, aimed at the Bose sink (fall back to default if it dropped). Single-quoted
    # remote payload keeps the awk clean; only $rf is templated in by the outer shell.
    remote_play="
export XDG_RUNTIME_DIR=/run/user/\$(id -u)
bid=\$(wpctl status 2>/dev/null | awk '/Sinks:/{s=1;next} /Sources:/{s=0} s && tolower(\$0) ~ /bose|soundlink/ {for(i=1;i<=NF;i++) if(\$i ~ /^[0-9]+\.$/){gsub(/\./,\"\",\$i); print \$i; exit}}')
[ -n \"\$bid\" ] && wpctl set-default \$bid 2>/dev/null
if [ -n \"\$bid\" ]; then pw-play --target \$bid $rf 2>/dev/null; else pw-play $rf 2>/dev/null; fi
rm -f $rf
"
    "${SSH[@]}" "bash -lc '$remote_play'" && echo "play: sent to room Bose ($f)"
    exit 0 ;;

  *)
    echo "usage: mesh-room-music --capture [secs] | --remix [src.wav] | --nightly | --play <file> | --diversity | --test"; exit 1 ;;
esac
