#!/usr/bin/env bash
# mesh-agy — launch the Antigravity CLI (agy) with its network scoped through phaedra's CANADA
# egress, so its Gemini models work.
#
# WHY: Google geo-blocks Antigravity's Gemini models from this node's normal egress — the model
# fails with "User location is not supported for the API use" (FAILED_PRECONDITION 400). The node
# egresses NL (194.147.115.17, router VPN), which Google still refuses for Antigravity-Gemini; the
# non-Gemini models (Claude Sonnet/Opus, GPT-OSS) work direct. phaedra (38.49.216.141, Montréal) IS
# geo-clean for it (verified 2026-06-19: agy "Gemini 3.5 Flash (Medium)" -> "OK" via phaedra, empty
# direct). agy is a Go binary that honors ALL_PROXY/HTTPS_PROXY, so we route JUST agy's traffic
# through a SOCKS tunnel to phaedra. The node's OWN routes/control-plane are untouched — substrate-
# safe, no host-wide double-VPN (which could sever the path to the node). LAN/mesh/CGNAT stay direct
# via NO_PROXY. If phaedra is unreachable we fall back to DIRECT agy so the non-Gemini models still
# work — honest degradation, never a hard break.
#
#   mesh-agy [agy args...]     interactive:  mesh-agy        headless:  mesh-agy -p "..."
#   mesh-agy --test            smoke: agy present + Canada path reachable (spawns nothing durable)
set -uo pipefail
# Source node-local opt-ins so MESH_AGY_YOLO (+ MESH_AGY_*) take effect even when launched from a tmux
# pane that did NOT inherit them (tmux panes inherit the server env, not the restore-time env — that gap
# is why agy was prompting despite restore.env's `export MESH_AGY_YOLO=1`). restore.env is node-local,
# never the genome, so sourcing it here is safe + generic.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

AGY="${MESH_AGY_BIN:-$HOME/.local/bin/agy}"
PHAEDRA="${MESH_AGY_EGRESS:-root@100.94.116.17}"   # Canada-egress jump host (phaedra)
PORT="${MESH_AGY_SOCKS_PORT:-18099}"
# Auto-approve opt-in (DEFAULT OFF). An autonomous mesh mind can't run from a finite allow-list —
# it stalls on the first un-allowed tool call. MESH_AGY_YOLO=1 (set node-local in restore.env, never
# the genome) passes agy's --dangerously-skip-permissions, matching the rest of this node's fleet
# posture (claude --permission-mode auto, codex --dangerously-bypass). OFF by default so the genome
# ships safe; a node opts in deliberately (operator-authorized 2026-06-19 for this node).
YOLO=""; [ "${MESH_AGY_YOLO:-0}" = 1 ] && YOLO="--dangerously-skip-permissions"
# Keep mesh/LAN/CGNAT off the proxy — only public traffic (Google) needs Canada.
NOPROX="localhost,127.0.0.1,::1,100.64.0.0/10,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12"

_port_up() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null && { exec 3>&- 3<&-; return 0; }; return 1; }

ensure_tunnel() {
  _port_up && return 0
  # spawn a self-keepalive SOCKS tunnel to phaedra (Canada). ExitOnForwardFailure so a bound-port
  # clash fails loud rather than silently egressing NL.
  ssh -fN -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
      -o ExitOnForwardFailure=yes -D "$PORT" "$PHAEDRA" 2>/dev/null
  for _ in $(seq 1 12); do _port_up && return 0; sleep 0.5; done
  return 1
}

if [ "${1:-}" = --test ]; then
  [ -x "$AGY" ] || { echo "smoke-test: FAIL (agy not found at $AGY)"; exit 1; }
  # NEVER spawn a durable tunnel from a smoke test (it would litter ssh procs on every reflex run).
  if _port_up; then echo "smoke-test: ok (agy present; Canada tunnel already up on :$PORT)"; exit 0; fi
  if ssh -o BatchMode=yes -o ConnectTimeout=6 "$PHAEDRA" true 2>/dev/null; then
    echo "smoke-test: ok (agy present; phaedra reachable — Canada tunnel spawns on launch)"; exit 0
  fi
  echo "smoke-test: WARN (agy present; phaedra unreachable — agy would run DIRECT, Gemini geo-blocked)"; exit 0
fi

[ -x "$AGY" ] || { echo "mesh-agy: agy not found at $AGY" >&2; exit 1; }

if ensure_tunnel; then
  exec env ALL_PROXY="socks5h://127.0.0.1:$PORT" \
           HTTPS_PROXY="socks5h://127.0.0.1:$PORT" \
           HTTP_PROXY="socks5h://127.0.0.1:$PORT" \
           NO_PROXY="$NOPROX" no_proxy="$NOPROX" \
           "$AGY" $YOLO "$@"
else
  echo "mesh-agy: phaedra Canada egress unreachable — running agy DIRECT (Gemini geo-blocks; Claude/GPT-OSS still work)" >&2
  exec "$AGY" $YOLO "$@"
fi
