#!/usr/bin/env bash
# mesh-clear-log — the LEDGER + WINDOW for every /clear (operator 2026-07-18: "нужно делать окно, где
# всё это считать — когда поклирили, какой был контекст и тп, чтобы потом не вслепую это чинить").
#
# /compact is retired mesh-wide; /clear is the sole context lever. A /clear is IRREVERSIBLE (it drops
# the mind's live context and relies on the handoff to carry the thread). Until now the mesh cleared
# BLIND — no record of WHEN a mind cleared, WHAT its context was at that moment, or whether a handoff
# actually covered it. This tool is that record: one durable JSONL row per clear, and the surfaces to
# read it (--tail / --stats / --watch, plus the `clear` dash role). It is the EVENT ledger (when/ctx/
# handoff); mesh-clear-loss is the separate COST meter (recycled-vs-control failrate).
#
# Recorded by the issuers, at the moment the clear is CONFIRMED sent:
#   • mesh-mind-compact  (the */10 proactive-clear reflex + manual targets) → source=compact-reflex
#   • mesh-clear         (the gated on-demand /clear, only on a PASS)       → source=mesh-clear
#
# Usage:
#   mesh-clear-log --record <win> <reason> <pct> <tok> [source] [engine]   append one clear event
#   mesh-clear-log --tail [n]        recent clears, human-readable (default 12)
#   mesh-clear-log --stats           aggregates: 24h count, per-window, reason histogram, handoff-cover rate
#   mesh-clear-log --watch [secs]    live pane surface (stats + tail), refresh every secs (default 30)
#   mesh-clear-log --test            RED-first smoke test (record → parseable row → stats counts it)
#
# reflex-cadence: (none — passive ledger; written by the issuers, read on demand / by the dash)
# orphan-ok: on-demand ledger + dash surface; recorded by mesh-mind-compact & mesh-clear, not itself cron.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
LEDGER="${MESH_CLEAR_LOG:-$MESH_DIR/clear-log.jsonl}"
HANDOFF_DIR="${MESH_HANDOFF_DIR:-$MESH_DIR/handoff}"
FRESH_SECS="${MESH_CLEAR_FRESH_SECS:-900}"   # a handoff younger than this is FRESH (matches mesh-clear's gate)

# ── handoff coverage read: does <win> have a handoff, how old, which tier ────────────────────────────
# Emits three tokens: present(0|1) age_s(int, -1 if absent) source(manual|auto-snapshot|none)
_handoff_state() { # $1=win
  local win="$1" f age src
  f="$HANDOFF_DIR/${win}.md"
  if [ ! -r "$f" ]; then printf '0 -1 none'; return 0; fi
  age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  src="$(sed -n 's/^# source: //p' "$f" | head -1)"; [ -n "$src" ] || src=unknown
  printf '1 %s %s' "$age" "$src"
}

# ── RECORD: append one clear event (called by the issuers) ───────────────────────────────────────────
_record() { # $1=win $2=reason $3=pct $4=tok $5=source $6=engine
  local win="${1:-?}" reason="${2:-?}" pct="${3:-?}" tok="${4:-?}" source="${5:-?}" engine="${6:-?}"
  [ "$win" = "?" ] && { echo "mesh-clear-log --record: window required" >&2; return 2; }
  local hs present age src
  hs="$(_handoff_state "$win")"; present="${hs%% *}"; age="$(printf '%s' "$hs" | cut -d' ' -f2)"; src="${hs##* }"
  local fresh=0; [ "$present" = 1 ] && [ "$age" -ge 0 ] && [ "$age" -le "$FRESH_SECS" ] && fresh=1
  mkdir -p "$(dirname "$LEDGER")"
  # JSON via python3 (stdlib only — no numpy) so reason/engine strings can never break the row.
  MCL_WIN="$win" MCL_REASON="$reason" MCL_PCT="$pct" MCL_TOK="$tok" MCL_SOURCE="$source" \
  MCL_ENGINE="$engine" MCL_PRESENT="$present" MCL_AGE="$age" MCL_SRC="$src" MCL_FRESH="$fresh" \
  python3 - "$LEDGER" <<'PY'
import json, os, sys, time
row = {
    "ts": int(time.time()),
    "iso": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "win": os.environ["MCL_WIN"],
    "reason": os.environ["MCL_REASON"],
    "pct": os.environ["MCL_PCT"],
    "tok": os.environ["MCL_TOK"],
    "source": os.environ["MCL_SOURCE"],
    "engine": os.environ["MCL_ENGINE"],
    "handoff_present": os.environ["MCL_PRESENT"] == "1",
    "handoff_age_s": int(os.environ["MCL_AGE"]),
    "handoff_source": os.environ["MCL_SRC"],
    "handoff_fresh": os.environ["MCL_FRESH"] == "1",
}
with open(sys.argv[1], "a") as f:
    f.write(json.dumps(row, ensure_ascii=False) + "\n")
PY
}

# ── TAIL: recent clears, human-readable ──────────────────────────────────────────────────────────────
_tail() { # $1=n
  local n="${1:-12}"
  [ -s "$LEDGER" ] || { echo "(no clears recorded yet — $LEDGER empty)"; return 0; }
  tail -n "$n" "$LEDGER" | python3 -c '
import json,sys
for line in sys.stdin:
    line=line.strip()
    if not line: continue
    try: r=json.loads(line)
    except Exception: continue
    ho = "no-handoff"
    if r.get("handoff_present"):
        fr = "fresh" if r.get("handoff_fresh") else "STALE"
        ho = "%s/%s %ds" % (r.get("handoff_source","?"), fr, r.get("handoff_age_s",-1))
    print("%s  %-10s ctx=%-4s tok=%-6s  %-14s  [%s]  %s" % (
        r.get("iso","?"), r.get("win","?"), r.get("pct","?"), r.get("tok","?"),
        r.get("source","?"), ho, r.get("reason","?")))
'
}

# ── STATS: aggregates over the ledger ────────────────────────────────────────────────────────────────
_stats() {
  [ -s "$LEDGER" ] || { echo "clear-log: (no clears recorded yet)"; return 0; }
  python3 -c '
import json,sys,time
now=int(time.time())
rows=[]
for line in open(sys.argv[1], encoding="utf-8"):
    line=line.strip()
    if not line: continue
    try: rows.append(json.loads(line))
    except Exception: pass
if not rows:
    print("clear-log: (ledger present but no parseable rows)"); sys.exit(0)
d1=[r for r in rows if now-r.get("ts",0)<=86400]
def rate(rs, pred):
    rs=[r for r in rs if r.get("handoff_present") is not None]
    return (sum(1 for r in rs if pred(r))/len(rs)*100) if rs else 0.0
# per-window counts (24h)
from collections import Counter
win24=Counter(r.get("win","?") for r in d1)
reasons=Counter((r.get("reason","?").split()[0] if r.get("reason") else "?") for r in d1)
srcs=Counter(r.get("source","?") for r in d1)
# avg ctx% where readable (opencode minds report a number; claude reports ?)
pcts=[]
for r in d1:
    p=str(r.get("pct","?")).rstrip("%")
    if p.isdigit(): pcts.append(int(p))
covered=rate(d1, lambda r: r.get("handoff_present") and r.get("handoff_fresh"))
present=rate(d1, lambda r: r.get("handoff_present"))
print("clear-log: %d clears total · %d in last 24h" % (len(rows), len(d1)))
print("  handoff at clear (24h):  present %.0f%% · fresh-covered %.0f%%%s" % (
    present, covered, ("  ⚠ blind clears (no fresh handoff)" if covered<100 and d1 else "")))
if pcts:
    print("  ctx%% at clear (readable/opencode, 24h):  avg %d%% · max %d%% · n=%d" % (sum(pcts)//len(pcts), max(pcts), len(pcts)))
else:
    print("  ctx%% at clear: none readable in 24h (claude minds report no %; opencode minds do)")
print("  by window (24h):  " + (", ".join("%s=%d"%(w,c) for w,c in win24.most_common()) or "—"))
print("  by reason (24h):  " + (", ".join("%s=%d"%(r,c) for r,c in reasons.most_common()) or "—"))
print("  by source (24h):  " + (", ".join("%s=%d"%(s,c) for s,c in srcs.most_common()) or "—"))
' "$LEDGER"
}

# ── WATCH: live pane surface ─────────────────────────────────────────────────────────────────────────
_watch() {
  local secs="${1:-30}"
  while :; do
    clear 2>/dev/null || true
    echo "═══ clear-log ($(date -u +%H:%M:%SZ)) — every /clear, so we fix by numbers not blind ═══"
    _stats
    # 10-clear audit rollup (the clear mind's reflex, mesh-clear-audit). One line, same surface —
    # no second pane. Absent until the first completed 10-clear batch (then refreshed each batch).
    if [ -r "$MESH_DIR/.clear-audit-last" ]; then
      echo
      echo "── last 10-clear audit (loss-first) ──"
      sed -n '1p' "$MESH_DIR/.clear-audit-last"
    fi
    echo
    echo "── recent clears ──"
    _tail 12
    sleep "$secs" || break
  done
}

# ── TEST: RED-first gate ─────────────────────────────────────────────────────────────────────────────
_test() {
  local td rc=0
  td="$(mktemp -d)" || { echo "clear-log-test: FAIL (mktemp)"; exit 1; }
  LEDGER="$td/clear-log.jsonl"; HANDOFF_DIR="$td/handoff"; mkdir -p "$HANDOFF_DIR"
  # 1) a fresh manual handoff present → record must mark present+fresh, and the row must be valid JSON
  printf '# source: manual\nsome state\n' > "$HANDOFF_DIR/genome.md"
  _record genome "interval 45m" "?" "12345" compact-reflex claude || { echo "clear-log-test: FAIL (record rc)"; rc=1; }
  [ -s "$LEDGER" ] || { echo "clear-log-test: FAIL (ledger empty after record)"; rc=1; }
  python3 -c 'import json,sys; json.loads(open(sys.argv[1]).read().splitlines()[-1])' "$LEDGER" 2>/dev/null \
    || { echo "clear-log-test: FAIL (last row is not valid JSON)"; rc=1; }
  python3 -c 'import json,sys; r=json.loads(open(sys.argv[1]).read().splitlines()[-1]); sys.exit(0 if (r["handoff_present"] and r["handoff_fresh"] and r["win"]=="genome") else 1)' "$LEDGER" \
    || { echo "clear-log-test: FAIL (fresh manual handoff not recorded as present+fresh)"; rc=1; }
  # 2) a STALE handoff (backdate the file) → recorded as present but NOT fresh (the blind-clear signal)
  printf '# source: auto-snapshot\nold\n' > "$HANDOFF_DIR/senses.md"
  touch -d "@$(( $(date +%s) - (FRESH_SECS_T=1000) ))" "$HANDOFF_DIR/senses.md" 2>/dev/null || touch -d '2020-01-01' "$HANDOFF_DIR/senses.md"
  MESH_CLEAR_FRESH_SECS=900 _record senses "ctx 65%≥60%" "65%" "?" compact-reflex opencode
  python3 -c 'import json,sys; r=[json.loads(l) for l in open(sys.argv[1]) if l.strip()][-1]; sys.exit(0 if (r["handoff_present"] and not r["handoff_fresh"]) else 1)' "$LEDGER" \
    || { echo "clear-log-test: FAIL (stale handoff recorded as fresh — the blind-clear detector is broken)"; rc=1; }
  # 3) NO handoff at all → present=false (a truly blind clear)
  _record discover "manual" "?" "?" mesh-clear opencode
  python3 -c 'import json,sys; r=[json.loads(l) for l in open(sys.argv[1]) if l.strip()][-1]; sys.exit(0 if (r["handoff_present"] is False) else 1)' "$LEDGER" \
    || { echo "clear-log-test: FAIL (a clear with no handoff not recorded as present=false)"; rc=1; }
  # 4) stats counts every recorded clear and reports a coverage rate (drives the reader end to end)
  local st; st="$(_stats)"
  printf '%s' "$st" | grep -q '3 clears total' || { echo "clear-log-test: FAIL (stats miscounted; got: $(printf '%s' "$st" | head -1))"; rc=1; }
  printf '%s' "$st" | grep -q 'fresh-covered' || { echo "clear-log-test: FAIL (stats missing the coverage rate)"; rc=1; }
  # 5) tail renders the reason + the blind-clear marker verbatim (the surface a human reads)
  _tail 3 | grep -q 'ctx 65%≥60%' || { echo "clear-log-test: FAIL (tail dropped the reason)"; rc=1; }
  _tail 3 | grep -q 'no-handoff' || { echo "clear-log-test: FAIL (tail did not flag the no-handoff clear)"; rc=1; }
  rm -rf "$td"
  [ "$rc" = 0 ] && echo "clear-log-test: ok (record writes valid JSON; fresh/stale/absent handoff all classified; stats counts + coverage; tail renders reason + blind-clear flag)"
  return "$rc"
}

case "${1:-}" in
  --record) shift; _record "$@" ;;
  --tail)   _tail "${2:-12}" ;;
  --stats)  _stats ;;
  --watch)  _watch "${2:-30}" ;;
  --test)   _test ;;
  ""|--help|-h)
    echo "mesh-clear-log — the ledger + window for every /clear (when · ctx · handoff coverage)"
    echo "  --record <win> <reason> <pct> <tok> [source] [engine]   append a clear event"
    echo "  --tail [n] · --stats · --watch [secs] · --test"
    echo; echo "── current stats ──"; _stats ;;
  *) echo "mesh-clear-log: unknown option '$1' (see --help)" >&2; exit 2 ;;
esac
