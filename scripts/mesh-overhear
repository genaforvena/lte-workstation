    # so --test never touches the real PipeWire graph — no real Bose/Firefox involved.
    _wt="$(mktemp -d)"; mkdir -p "$_wt/bin"
    printf '#!/bin/sh\necho "quiet, nothing active"\n' > "$_wt/bin/wpctl-quiet"; chmod +x "$_wt/bin/wpctl-quiet"
    printf '#!/bin/sh\necho "       92. Firefox\\n             79. output_FR       > Bose Revolve SoundLink:playback_FR\\t[active]\\n"\n' > "$_wt/bin/wpctl-playing"; chmod +x "$_wt/bin/wpctl-playing"
