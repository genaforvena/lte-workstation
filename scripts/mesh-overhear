    _cd="$(mktemp -d "${TMPDIR:-/tmp}"/oh-claim-XXXXXX)"
    # (a) the note lands on the diag tape and NOT in the transcript window.
    OH_LOG="$_cd/overheard.log" OH_DIAG_LOG="$_cd/diag.log" OH_CLAIM_WAIT_S=0 runpy claim_probe plughw:99,0 >/dev/null 2>&1
