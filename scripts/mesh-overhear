    [ "$(MESH_OVERHEAR_WPCTL_CMD="$_wt/bin/wpctl-playing" runpy bose_foreign)" = "YES" ] || { echo "smoke-test: FAIL (bose_foreign: active Bose playback must read YES)"; exit 1; }
    rm -rf "$_wt"
    echo "  bose foreign-playback detector ok (quiet graph→NO, active Bose stream→YES)"
    # say-verify (operator 2026-07-04, "он думает что говорит, но нет — надо проверять по записи"):
    # assert the said/heard scoring verdict without any real mic/Bose (synthetic strings; a scratch log
    # so the real ~/.mesh/misha-say-verify.log is never touched by --test).
    _svlog="$(mktemp "${TMPDIR:-/tmp}"/oh-sv-test-XXXXXX.log)"
    [ "$(OH_SAY_VERIFY_LOG="$_svlog" runpy say_verify "привет как дела" "" 1)" = MUTED ] \
      || { echo "smoke-test: FAIL (say_verify: muted must report MUTED)"; exit 1; }
