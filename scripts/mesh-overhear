      [ -s "$_sttlog" ] && { echo "smoke-test: FAIL (a diagnostic note leaked into OH_LOG — the transcript window's reader deletes it)"; rm -f "$_sttlog" "$_sttlog.diag" "$_sttwav"; exit 1; }
      rm -f "$_sttlog.diag"
      rm -f "$_sttlog" "$_sttwav"
