#!/usr/bin/env bash
# mesh-overhear — ambient "third party" reflex: keep a rolling TEXT transcript of the last ~15 min of
# room conversation; on a thumbs-up, analyze it and speak a comment from the side. No minds, no cloud
# except the LLM step. Lives on a node with a mic + speaker (default-string: webcam mic + Bose).
#
# Operator's design (2026-06-20): live back-and-forth is too slow, so DON'T converse — overhear. The
# mic listens continuously; each spoken utterance is transcribed (whisper.cpp, local) and appended to a
# rolling transcript that auto-prunes to OH_KEEP_MIN minutes (text only — nothing audio is kept, nothing
# is permanent). A thumbs-up means "weigh in": take the last ~15 min, think (mesh-relay), and speak a
# short observation on the Bose. Latency is fine here — it's after-the-fact commentary, not a dialogue.
# Operator consented to home recording; the rolling text is the only retained artifact and it decays.
#
#   mesh-overhear --daemon        continuous listen → transcribe → append to the rolling transcript
#   mesh-overhear --comment       analyze the last OH_KEEP_MIN min and SPEAK a third-party comment
#   mesh-overhear --ingest W T    (internal) transcribe wav W stamped epoch T, append + prune
#   mesh-overhear --show          print the LAST-computed transcript + a freshness header (cheap, no STT)
#   mesh-overhear --hear          re-transcribe the recent ~OH_HEAR_SECS, then print it LIVE (what mesh-room read uses)
#   mesh-overhear --has-speech N  CHEAP wav verdict (no whisper): silence|sound|speech-like; exit 0 only if speech-like
#   mesh-overhear --watch-speech  EVENT trigger: poll --has-speech, poke the mind ONLY on real speech (tg-poller analog; replaces motion→mind)
#   mesh-overhear --watch-wake    WAKE-WORD trigger: wake the room mind "Миша" ONLY when called by name (operator's 2nd, room-specific voice channel)
#   mesh-overhear --test          stack check + render a phrase (no mic, no relay)
#
# Silence switch: while ~/.mesh/room-voice-off exists, the channel emits ZERO sound (pwplay no-ops) — gates
# EVERY path incl. the mind-independent poke ack. Remove the file to re-enable voice.
#
# Tunables (env): OH_KEEP_MIN=15 · OH_HEAR_SECS=150 · OH_LOG=~/.mesh/overheard.log · OH_LANG=ru
#   VAD: OH_START_RMS=600 OH_SIL_RMS=300 OH_END_SIL=0.9 OH_MAX_UTT=18 OH_MIN_UTT=0.4
#   stack: OH_WHISPER=~/.mesh/whispercpp/main OH_MODEL=~/.mesh/whispercpp/models/ggml-base.bin
#          OH_PIPER=~/.mesh/piper/piper/piper OH_PIPERLIB=~/.mesh/piper/piper OH_VOICE=~/.mesh/piper/voices/ruslan.onnx
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"   # /usr/bin first: never a snap-confined pw-*/curl
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire (mic + Bose sink)
MESH="${MESH_DIR:-$HOME/.mesh}"

export OH_KEEP_MIN="${OH_KEEP_MIN:-10}"   # operator 2026-06-20: ~10-min rolling window
export OH_LOG="${OH_LOG:-$MESH/overheard.log}"
export OH_LANG="${OH_LANG:-ru}"
export OH_START_RMS="${OH_START_RMS:-600}"
export OH_SIL_RMS="${OH_SIL_RMS:-300}"
export OH_END_SIL="${OH_END_SIL:-0.9}"
export OH_MAX_UTT="${OH_MAX_UTT:-18}"
export OH_MIN_UTT="${OH_MIN_UTT:-0.4}"
export OH_FRAME_MS="${OH_FRAME_MS:-200}"
export OH_WHISPER="${OH_WHISPER:-$MESH/whispercpp/main}"
# pick the BEST installed model — large-v3-turbo gives the clean text the voice-note pipeline already
# gets (operator 2026-06-20: "use the same recognizer"). Falls back down the ladder on a leaner node.
_pick_model() {
  local m; for m in ggml-large-v3-turbo ggml-large-v3 ggml-large ggml-medium ggml-small ggml-base; do
    [ -f "$MESH/whispercpp/models/$m.bin" ] && { echo "$MESH/whispercpp/models/$m.bin"; return; }
  done; echo "$MESH/whispercpp/models/ggml-base.bin"
}
export OH_MODEL="${OH_MODEL:-$(_pick_model)}"
export OH_PIPER="${OH_PIPER:-$MESH/piper/piper/piper}"
export OH_PIPERLIB="${OH_PIPERLIB:-$MESH/piper/piper}"
export OH_VOICE="${OH_VOICE:-$MESH/piper/voices/ruslan.onnx}"

# ---- shared python helpers (transcribe / speak / VAD), selected by argv[1] --------------------------
runpy() {  # <mode> [args...]
  local PY; PY="$(mktemp /tmp/overhear-XXXXXX.py)"; trap 'rm -f "$PY"' RETURN
  cat > "$PY" <<'PYEOF'
import os, sys, time, wave, audioop, subprocess, re

KEEP=int(os.environ.get("OH_KEEP_MIN","15"))*60
LOGF=os.environ["OH_LOG"]; LANG=os.environ.get("OH_LANG","ru")
WHISPER=os.environ["OH_WHISPER"]; MODEL=os.environ["OH_MODEL"]
PIPER=os.environ["OH_PIPER"]; PIPERLIB=os.environ["OH_PIPERLIB"]; VOICE=os.environ["OH_VOICE"]
RATE=16000; FRAME_MS=int(os.environ.get("OH_FRAME_MS","200"))
FBYTES=int(RATE*FRAME_MS/1000)*2; FSEC=FRAME_MS/1000.0
START_RMS=int(os.environ.get("OH_START_RMS","600")); SIL_RMS=int(os.environ.get("OH_SIL_RMS","300"))
END_SIL=float(os.environ.get("OH_END_SIL","0.9")); MAX_UTT=float(os.environ.get("OH_MAX_UTT","18"))
MIN_UTT=float(os.environ.get("OH_MIN_UTT","0.4"))

# ON-DEMAND model (operator 2026-06-20): a rolling AUDIO buffer; transcription happens only at a trigger,
# so what Claude hears is always in sync with reality (no lagging continuous STT). Window ~7 min.
BUFFER_DIR=os.path.join(os.path.dirname(LOGF),"audio-buffer")
BUFFER_MIN=int(os.environ.get("OH_BUFFER_MIN","7"))*60
HEAR_SECS=int(os.environ.get("OH_HEAR_SECS","90"))    # `--hear` re-transcribes only the most recent N secs (fast live read; ds is freeze-prone so keep it short)
TRANSCRIPT_FILE=os.path.join(os.path.dirname(LOGF),"room-transcript.txt")
MUTE_FLAG=os.path.join(os.path.dirname(LOGF),"mesh-speaking")  # set while the mesh speaks → don't self-hear
VOICE_OFF=os.path.join(os.path.dirname(LOGF),"room-voice-off")  # operator silence switch: while this file exists, the channel emits ZERO sound to the Bose (gates ALL paths — ack, comment, mind speech). Re-enable = remove it.
HALLU=("спокойная музыка","продолжение следует","субтитр","[музыка]","[аплодисменты]","музыка",
       "спасибо за просмотр","редактор субтитров","корректор","♪","thank you","тишина","субтитры")
def is_real(text):
    t=text.strip().lower()
    words=t.split()
    if len("".join(words))<4: return False
    for h in HALLU:
        if h in t: return False
    if t in ("you","ну","да","а","э","и"): return False
    # whisper invents repetitive filler on near-silence ("тихо и тихо и тихо…"): one token, many times.
    sig=[w for w in words if len(w)>1]
    if len(words)>=4 and len(set(sig))<=1: return False
    return True

def transcribe_local(wav):
    try:
        th=os.environ.get("OH_WHISPER_THREADS","2")   # cap whisper cores on a hot node
        out=subprocess.run([WHISPER,"-m",MODEL,"-f",wav,"-l",LANG,"-nt","-t",th],
            capture_output=True,timeout=120).stdout.decode("utf-8","ignore")
        t=" ".join(out.split()).strip()
        # whisper sometimes loops a word on noisy audio ("волочную волочную волочную…") — collapse runs
        t=re.sub(r'(\b\w+\b)( \1\b){2,}', r'\1', t, flags=re.IGNORECASE)
        return t
    except Exception: return ""

def transcribe(wav):
    # offload STT to a stronger node if configured (operator 2026-06-20: keep heavy whisper OFF the hot,
    # freeze-prone default-string — the mic node only captures; a beefier node transcribes with a bigger
    # model → cleaner text). Pipe the wav over ssh; fall back to local if the remote is unreachable.
    node=os.environ.get("OH_STT_NODE","")
    if node:
        try:
            with open(wav,"rb") as f:
                out=subprocess.run(["ssh","-o","StrictHostKeyChecking=no","-o","ConnectTimeout=8",
                    node,"bash -lc 'mesh-overhear --stt-stdin'"],stdin=f,capture_output=True,timeout=120)
            t=out.stdout.decode("utf-8","ignore").strip()
            if t: return t
        except Exception: pass
    return transcribe_local(wav)

def buffer_wavs(window_secs):
    # buffered utterance wavs captured within window_secs, oldest→newest (filenames are capture-ms)
    if not os.path.isdir(BUFFER_DIR): return []
    cutoff=time.time()*1000 - window_secs*1000; items=[]
    for fn in os.listdir(BUFFER_DIR):
        if fn.endswith(".wav"):
            try:
                ms=int(fn[:-4])
                if ms>=cutoff: items.append((ms,os.path.join(BUFFER_DIR,fn)))
            except ValueError: pass
    items.sort()
    return [p for _,p in items]

def newest_buffer_age():
    # seconds since the most recent buffered utterance (big number if the buffer is empty)
    ws=buffer_wavs(10**9)
    if not ws: return 10**9
    try: return time.time()-int(os.path.basename(ws[-1])[:-4])/1000.0
    except ValueError: return 10**9

def concat_wavs(paths, out):
    data=b""
    for p in paths:
        try:
            w=wave.open(p,"rb"); data+=w.readframes(w.getnframes()); w.close()
        except Exception: pass
    if not data: return False
    w=wave.open(out,"wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
    w.writeframes(data); w.close(); return True

def transcribe_buffer():
    # transcribe the WHOLE current audio buffer AT ONCE (at trigger time → synced with reality), write
    # the result as the room transcript, and return it. This is the on-demand STT the trigger calls.
    paths=buffer_wavs(BUFFER_MIN)
    if not paths: return ""
    big="/tmp/oh-buffer-%d.wav"%os.getpid()
    if not concat_wavs(paths,big): return ""
    text=transcribe(big)
    try: os.remove(big)
    except OSError: pass
    if text:
        try:
            with open(TRANSCRIPT_FILE,"w") as f:
                f.write("[%s] %s\n"%(time.strftime("%H:%M:%S"),text))
        except Exception: pass
    return text

def transcribe_recent(secs):
    # transcribe ONLY the most recent `secs` of buffered audio — the fast on-demand read so `mesh-room read`
    # reflects what's being said NOW. Lighter than transcribe_buffer (whole ~7-min window, minutes of whisper
    # → the RC=124/empty stalls), so it can run live on each thumbs-up. operator 2026-06-20.
    # HONESTY: always write a FRESH-stamped result so the live read never shows a stale ancient line. If the
    # window holds real speech → write it; if it's only music/silence/hallucination (is_real() rejects it) →
    # write an explicit "(нет речи — …)" marker. Returns real speech text, else "".
    stamp=time.strftime("%H:%M:%S")
    def _write(line):
        try:
            with open(TRANSCRIPT_FILE,"w") as f: f.write("[%s] %s\n"%(stamp,line))
        except Exception: pass
    paths=buffer_wavs(secs)
    if not paths:
        _write("(тишина — в комнате не звучало ничего за последние %d с)"%secs); return ""
    big="/tmp/oh-recent-%d.wav"%os.getpid()
    if not concat_wavs(paths,big):
        _write("(нет читаемого аудио в буфере)"); return ""
    text=transcribe(big)
    try: os.remove(big)
    except OSError: pass
    if is_real(text):
        _write(text); return text
    # CLASSIFIER-GATED marker (operator 2026-06-24): whisper hallucinates "музыка"/"[музыка]" on
    # steady ambient hum; the old `if 'музык' in text` marker then labeled every quiet room as
    # "нет речи — музыка" → 'music everywhere'. Now the AUDIO classifier decides: only real music
    # (tonal+lou+continuous) is labeled музыка; ambient hum → "фоновый гул"; silence → "тишина".
    # The text-only 'музык' hint is no longer trusted on its own.
    verdict=classify_presence(secs)
    if verdict=="music":        kind="музыка"
    elif verdict=="ambient":    kind="фоновый гул/шум (не музыка)"
    else:                       kind="тишина/шум, без слов"
    _write("(нет речи — %s)"%kind); return ""

def _self_playing():
    # True while the mesh is producing sound on the Bose — never classify our OWN
    # playback as ambient music (operator 2026-06-24: voice-tx/room-music on the Bose
    # fed back into the mic → 'music everywhere'). The capture loop already drains
    # during MUTE_FLAG, but voice-tx/room-music --play set the flag too AND pw-play
    # running catches the rest; this is defense-in-depth against races.
    if os.path.exists(MUTE_FLAG): return True
    try:
        r=subprocess.run(["pgrep","-x","pw-play"],capture_output=True,timeout=2)
        if r.returncode==0: return True
    except Exception: pass
    return False

def _frame_features(data):
    # per-100ms-frame (RMS in s16 units, spectral flatness in [0,1]) for 16k mono s16 bytes.
    # numpy is a heavy import — done lazily so the daemon/STT paths don't pay for it.
    import numpy as np
    fb=int(RATE*0.1)*2
    out=[]
    for i in range(0,len(data)-fb+1,fb):
        f=data[i:i+fb]
        if len(f)<fb: continue
        a=np.frombuffer(f,dtype="<i2").astype(np.float64)
        rms=float(np.sqrt(np.mean(a*a)))             # s16 units — comparable to audioop.rms
        w=a*np.hanning(len(a))                        # window before FFT to reduce leakage
        p=(np.abs(np.fft.rfft(w))+1e-12)**2          # one-sided power spectrum
        fm=float(np.exp(np.mean(np.log(p)))/np.mean(p))  # spectral flatness: ~1 noise, ~0 tonal
        out.append((rms,fm))
    return out

def classify(data):
    # Rich verdict on raw wav bytes: silence | ambient | music | speech-like.
    # Replaces the af/qf-only heuristic (operator 2026-06-24): steady ambient hum
    # (fridge/fan/HVAC) used to trip qf<0.10 -> 'sound' -> marker said 'музыка' ->
    # 'music everywhere'. Now: low absolute level OR broadband+steady -> ambient
    # (collapses to silence externally); only tonal+loud+steady -> music;
    # intermittent -> speech-like. Spectral flatness separates harmonic (music/
    # voice) from broadband noise (hum); absolute level separates the ambient
    # floor from real content; self-playback is silenced up front.
    if _self_playing(): return "silence"
    feats=_frame_features(data)
    if not feats: return "silence"
    rms=[r for r,_ in feats]; flat=[f for _,f in feats]; n=len(rms)
    af=sum(1 for r in rms if r>=START_RMS)/n             # fraction above speech onset
    qf=sum(1 for r in rms if r< SIL_RMS )/n              # fraction quiet (pauses)
    act=[r for r in rms if r>=SIL_RMS]
    mean_act=sum(act)/len(act) if act else 0.0
    max_rms=max(rms)
    mean_flat=sum(flat)/n
    # tunables — env-overridable so the operator can fine-tune on the real room
    AMB_LEVEL=float(os.environ.get("OH_AMB_LEVEL","1000"))  # active-RMS below this = ambient floor
    HUM_FLAT =float(os.environ.get("OH_HUM_FLAT","0.40"))   # flatness above this = broadband noise (hum)
    MUSIC_MIN=float(os.environ.get("OH_MUSIC_MIN","2000"))  # tonal but below this level = fridge hum, not music
    WALL_QF  =float(os.environ.get("OH_WALL_QF","0.15"))    # gap fraction below this = continuous wall
    if af<0.06: return "silence"                            # almost nothing above onset (empty room)
    if mean_act<AMB_LEVEL: return "ambient"                 # low continuous level = HVAC/fridge hum
    if qf<WALL_QF:                                          # continuous wall — music vs noise?
        if mean_flat>HUM_FLAT: return "ambient"             # steady broadband hum/noise
        if max_rms<MUSIC_MIN: return "ambient"              # low-level tonal hum (compressor)
        return "music"                                      # loud tonal wall = real music
    return "speech-like"                                    # intermittent energy with pauses

def _buffer_bytes(secs):
    # concat the recent rolling-buffer utterances into one wav's raw bytes (or None)
    paths=buffer_wavs(secs)
    if not paths: return None
    big="/tmp/oh-hs-%d.wav"%os.getpid()
    if not concat_wavs(paths,big): return None
    try:
        w=wave.open(big,"rb"); data=w.readframes(w.getnframes()); w.close()
    except Exception: data=None
    try: os.remove(big)
    except OSError: pass
    return data

def speech_presence(secs):
    # CHEAP wav-level verdict on the recent buffer (NO whisper) — operator 2026-06-20: "понимать
    # что пусто на уровне звуковых wav, не гонять 'думаю' чтобы ничего не сказать". External 3-state
    # contract preserved (silence|sound|speech-like) so --poke-mind/--watch-* keep working; the
    # 4-state `classify()` is collapsed: ambient hum now reads as silence (was 'sound' = the bug).
    # Heuristic, not a classifier — the real filter is is_real() after STT; this just stops the
    # pipeline from engaging (ack/poke) on obvious silence, ambient hum, or steady music.
    data=_buffer_bytes(secs)
    if not data: return "silence"
    v=classify(data)
    if v in ("silence","ambient"): return "silence"
    if v=="music": return "sound"
    return "speech-like"

def classify_presence(secs):
    # RICH 4-state verdict (silence|ambient|music|speech-like) — used by the transcript marker so
    # ambient hum is labeled honestly instead of propagating whisper's 'музыка' hallucination.
    data=_buffer_bytes(secs)
    if not data: return "silence"
    return classify(data)

def bose_id():
    # the LIVE pipewire id of the Bose sink, or None if it's not connected right now
    try:
        out=subprocess.run(["wpctl","status"],capture_output=True,timeout=5).stdout.decode("utf-8","ignore")
        in_sinks=False
        for ln in out.splitlines():
            if "Sinks:" in ln: in_sinks=True; continue
            if "Sources:" in ln or "endpoints" in ln: in_sinks=False
            if in_sinks and ("bose" in ln.lower() or "soundlink" in ln.lower()):
                m=re.search(r'(\d+)\.', ln)
                if m: return m.group(1)
    except Exception: pass
    return None

def pwplay(wav):
    # ALWAYS aim for the Bose; if it dropped, fall back to default so audio isn't lost (operator 2026-06-20:
    # "должен говорить через Bose, не в ноутбук" — the default sink drifts to the laptop when BT blips).
    # VOICE GATE (operator 2026-06-24): room-voice-off (manual) + thermal-silence (auto overheat mute) +
    # live .therm-state HOT. Supersedes the old VOICE_OFF-only os.path check; routed through the single
    # mesh-voice-gate binary so EVERY audio cause (not just the manual switch) mutes the room. Fail-OPEN
    # on a missing gate binary (the manual room-voice-off switch is the reliable mute).
    try:
        if subprocess.run(["mesh-voice-gate"],capture_output=True,timeout=6).returncode!=0: return
    except Exception: pass
    bid=bose_id()
    if bid:
        try: subprocess.run(["wpctl","set-default",bid],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
        except Exception: pass
        subprocess.run(["pw-play","--target",bid,wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["pw-play",wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)

def speak(txt):
    wav="/tmp/oh-say-%d.wav"%os.getpid()
    subprocess.run([PIPER,"-m",VOICE,"-f",wav],input=txt.encode(),
        env=dict(os.environ,LD_LIBRARY_PATH=PIPERLIB),
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if os.path.exists(wav) and os.path.getsize(wav)>0:
        try: open(MUTE_FLAG,"w").close()      # tell the listener "that's me" so it doesn't self-transcribe
        except Exception: pass
        pwplay(wav)                           # → the Bose specifically, not whatever default drifted in
        time.sleep(0.5)                       # let the Bose echo tail die before un-muting
        try: os.remove(MUTE_FLAG)
        except OSError: pass
        try: os.remove(wav)
        except OSError: pass

def read_exact(f,n):
    b=b""
    while len(b)<n:
        c=f.read(n-len(b))
        if not c: break
        b+=c
    return b

def capture_utterance():
    # block until one utterance (speech onset → pause); return wav path or "" (too short).
    p=subprocess.Popen(["pw-record","--rate","16000","--channels","1","--format","s16","-"],
        stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
    frames=[]; capturing=False; silence=0.0
    try:
        while True:
            buf=read_exact(p.stdout,FBYTES)
            if len(buf)<FBYTES: break
            if os.path.exists(MUTE_FLAG):     # the mesh is speaking on the Bose → drain, don't capture self
                capturing=False; frames=[]; silence=0.0
                continue
            r=audioop.rms(buf,2)
            if not capturing:
                if r>=START_RMS: capturing=True; frames=[buf]; silence=0.0
            else:
                frames.append(buf)
                if r<SIL_RMS:
                    silence+=FSEC
                    if silence>=END_SIL: break
                else: silence=0.0
                if len(frames)*FSEC>=MAX_UTT: break
    finally:
        p.kill()
        try: p.stdout.close()
        except Exception: pass
    if (len(frames)*FSEC - silence) < MIN_UTT: return ""
    wav="/tmp/oh-utt-%d-%d.wav"%(os.getpid(),int(time.time()*1000)%100000)
    w=wave.open(wav,"wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
    w.writeframes(b"".join(frames)); w.close()
    return wav

def prune_and_read(stamp_now):
    # read OH_LOG, drop lines older than KEEP, rewrite, return kept text lines (chronological)
    keep=[]
    try:
        with open(LOGF) as f: lines=f.readlines()
    except FileNotFoundError: lines=[]
    out_text=[]
    for ln in lines:
        parts=ln.rstrip("\n").split("\t",2)
        if len(parts)<3: continue
        try: ep=int(parts[0])
        except ValueError: continue
        if stamp_now-ep<=KEEP:
            keep.append(ln); out_text.append("[%s] %s"%(parts[1],parts[2]))
    try:
        with open(LOGF,"w") as f: f.writelines(keep)
    except Exception: pass
    return out_text

def relay(prompt):
    try:
        out=subprocess.run(["mesh-relay",prompt],capture_output=True,timeout=60).stdout.decode("utf-8","ignore")
        return " ".join(out.split()).strip()
    except Exception: return ""

mode=sys.argv[1]

if mode=="daemon":
    # ON-DEMAND: don't transcribe continuously (that lagged behind reality and desynced what Claude heard
    # — operator 2026-06-20). Just VAD-capture utterances into a cheap rolling AUDIO buffer; whisper runs
    # only at a trigger. default-string does ZERO whisper → never heats; IdeaPad transcribes only on demand.
    os.makedirs(BUFFER_DIR, exist_ok=True)
    last_prune=0.0
    while True:
        try:
            w=capture_utterance()
            if w:
                dst=os.path.join(BUFFER_DIR,"%d.wav"%int(time.time()*1000))
                try:
                    import shutil; shutil.move(w,dst)   # /tmp(tmpfs)→~/.mesh(disk) is cross-device; move handles it
                except Exception:
                    try: os.remove(w)
                    except OSError: pass
            now=time.time()
            if now-last_prune>10:                      # prune the rolling window every 10s
                last_prune=now; cutoff=(now-BUFFER_MIN)*1000
                for fn in os.listdir(BUFFER_DIR):
                    if fn.endswith(".wav"):
                        try:
                            if int(fn[:-4])<cutoff: os.remove(os.path.join(BUFFER_DIR,fn))
                        except (ValueError,OSError): pass
        except Exception:
            time.sleep(0.5)

elif mode=="buffer_fresh":
    # exit 0 if a buffered utterance exists within argv[2] secs — "is anyone talking right now"
    sys.exit(0 if newest_buffer_age() <= float(sys.argv[2] if len(sys.argv)>2 else 150) else 1)

elif mode=="has_speech":
    # CHEAP speech-presence verdict (no whisper): prints silence|sound|speech-like, exits 0 only for
    # speech-like so callers can gate with `if mesh-overhear --has-speech N; then`. operator 2026-06-20.
    v=speech_presence(int(sys.argv[2]) if len(sys.argv)>2 else 150)
    print(v); sys.exit(0 if v=="speech-like" else 1)

elif mode=="classify_wav":
    # RICH verdict on a given wav file (TEST/DEBUG entry point): prints silence|ambient|music|speech-like.
    # Used by test-overhear-classifier so the audio classifier is exercised on synthetic wavs without
    # touching the live rolling buffer or the mic. operator 2026-06-24.
    if len(sys.argv)<3: print("classify_wav: need <wav>"); sys.exit(2)
    try:
        w=wave.open(sys.argv[2],"rb"); data=w.readframes(w.getnframes()); w.close()
    except Exception as e:
        print("classify_wav: read error %s"%e); sys.exit(2)
    print(classify(data)); sys.exit(0)

elif mode=="transcribe_buffer":
    sys.stdout.write(transcribe_buffer())

elif mode in ("show","hear"):
    # operator 2026-06-20: surface FRESHNESS so a stale transcript can't read as "now". Two signals:
    #   (a) transcript age = when the last trigger computed it (mtime of TRANSCRIPT_FILE);
    #   (b) live audio age = seconds since the newest BUFFERED utterance (un-transcribed sound waiting).
    # If (b) is fresher than (a), the shown text predates current audio → say so (thumbs-up to re-hear).
    # `hear` mode (operator 2026-06-20) first re-transcribes the recent window so `mesh-room read` is LIVE,
    # not a stale view — the header then reads "computed just now". `show` stays cheap (no whisper).
    if mode=="hear":
        try: transcribe_recent(HEAR_SECS)
        except Exception: pass
    def _fmt(s):
        s=int(s)
        if s<20: return "just now"
        if s<90: return "%ds ago"%s
        if s<3600: return "%dm ago"%(s//60)
        return "%dh%02dm ago"%(s//3600,(s%3600)//60)
    try:
        t_age=time.time()-os.stat(TRANSCRIPT_FILE).st_mtime
        head="-- room transcript · computed %s --"%_fmt(t_age)
    except FileNotFoundError:
        print("-- room transcript · none yet (no trigger has run) --"); sys.exit(0)
    b_age=newest_buffer_age(); n=len(buffer_wavs(BUFFER_MIN))
    if b_age<10**8:
        head+="\n-- live audio · %d utterances buffered · newest %s --"%(n,_fmt(b_age))
        if t_age-30>b_age:
            head+="\n-- ⚠ fresher audio than this transcript (newest %s vs computed %s) — thumbs-up/--comment to re-hear --"%(_fmt(b_age),_fmt(t_age))
    else:
        head+="\n-- live audio · buffer empty (room quiet — no recent sound) --"
    print(head)
    try:
        with open(TRANSCRIPT_FILE) as f: sys.stdout.write(f.read())
    except FileNotFoundError: pass

elif mode=="dash":
    paths=buffer_wavs(BUFFER_MIN); age=newest_buffer_age()
    bufmin=BUFFER_MIN//60
    if age<10**8:
        print("-- audio buffer: %d utterances in last ~%d min · newest %ds ago (on-demand STT at a trigger) --"%(len(paths),bufmin,int(age)))
    else:
        print("-- audio buffer: empty (room quiet) · transcribed on a thumbs-up/motion trigger --")
    print("-- last transcript (synced — written when Claude was last asked) --")
    try:
        with open(TRANSCRIPT_FILE) as f: txt=f.read().strip()
        for ln in (txt.splitlines() or ["  (none yet)"]): print("  "+ln[:150])
    except FileNotFoundError: print("  (none yet — thumbs-up or move to ask Claude)")
    try:
        cl=open(os.path.join(os.path.dirname(LOGF),"overhear-comments.log")).read().splitlines()[-3:]
    except Exception: cl=[]
    print("-- your last third-party comments --")
    if cl:
        for c in cl: print("  "+c[:150])
    else:
        print("  (none yet — thumbs-up to comment)")

elif mode=="comment":
    # On-demand STT of the live buffer FIRST so a thumbs-up always comments on what was JUST said —
    # never on a stale/empty rolling log (operator 2026-06-20: "палец стоял, а не распозналось" — the
    # rolling transcript was stale so --comment said "нечего комментировать"). transcribe_buffer also
    # refreshes TRANSCRIPT_FILE, so the data pane stays in sync. Falls back to the rolling log.
    fresh=transcribe_buffer().strip()
    lines=prune_and_read(int(time.time()))
    if fresh and "нет речи" not in fresh.lower():
        lines=(lines or [])+["[сейчас] "+fresh]
    if not lines:
        speak("Пока нечего комментировать, я ещё ничего не услышал."); sys.exit(0)
    transcript="\n".join(lines[-120:])
    prompt=("Ты — внимательная третья сторона, ты молча слушал разговор в комнате. Ниже транскрипт "
            "последних минут (с метками времени, расшифровка на слух — возможны ошибки). Дай ОДИН "
            "короткий полезный комментарий или наблюдение со стороны: что-то меткое, что добавить, "
            "поправить или подметить. 1-3 фразы, по-русски, разговорно, по делу, без воды и без "
            "пересказа.\n\nТРАНСКРИПТ:\n"+transcript)
    reply=relay(prompt)
    if not reply: reply="Что-то я не смог собрать мысль, попробуй ещё раз."
    try:
        with open(os.path.join(os.path.dirname(LOGF),"overhear-comments.log"),"a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S ")+reply+"\n")
    except Exception: pass
    speak(reply)

elif mode=="speak":
    speak(sys.argv[2] if len(sys.argv)>2 else "Меш на связи.")

elif mode=="say_stdin":
    # speak text read from stdin — lets a remote mind pipe arbitrary Russian (quotes, punctuation)
    # without nested-quote hell through ssh: printf '%s' "..." | ssh ds 'bash -lc "mesh-overhear --say-stdin"'
    txt=sys.stdin.read().strip()
    if txt: speak(txt)

elif mode=="stt_stdin":
    # transcribe a wav piped on stdin and print the text — this is the STT WORKER a mic node calls on a
    # stronger node (operator 2026-06-20: use the good recognizer, like the voice-note pipeline). ALWAYS
    # local here (transcribe_local), never re-offload, so there's no loop.
    data=sys.stdin.buffer.read()
    tmp="/tmp/stt-%d-%d.wav"%(os.getpid(), int(time.time()*1000)%100000)
    try:
        with open(tmp,"wb") as f: f.write(data)
        sys.stdout.write(transcribe_local(tmp))
    finally:
        try: os.remove(tmp)
        except OSError: pass

elif mode=="ack":
    # INSTANT reflexive cue on the gesture (operator 2026-06-20: "как только ответ начал формироваться,
    # что-то сказалось"). Play a tiny pre-rendered "thinking" wav immediately so the operator knows the
    # answer is forming, BEFORE the mind composes the full comment. Mute-wrapped so we don't self-hear it.
    wav=os.environ.get("OH_ACK_WAV", os.path.join(os.path.dirname(LOGF),"oh-thinking.wav"))
    if os.path.exists(wav):
        try: open(MUTE_FLAG,"w").close()
        except Exception: pass
        pwplay(wav)                           # ack also goes to the Bose, not the laptop
        time.sleep(0.3)
        try: os.remove(MUTE_FLAG)
        except OSError: pass
PYEOF
  python3 "$PY" "$@"
}

case "${1:-}" in
  --daemon)  runpy daemon ;;
  --ingest)  shift; runpy ingest "$@" ;;
  --show)    runpy show ;;
  --hear)    # LIVE read: re-transcribe the recent window, then print with the freshness header. Single-
             # writer via flock so a burst of thumbs-ups can't pile up whisper runs — losers fall back to
             # the cheap stale --show (which now shows the ⚠ stale-warning anyway). operator 2026-06-20.
             exec 9>"$MESH/oh-hear.lock" 2>/dev/null
             if flock -n 9 2>/dev/null; then runpy hear; else runpy show; fi ;;
  --dash)    runpy dash ;;
  --say)        shift; runpy speak "$*" ;;
  --say-stdin)  runpy say_stdin ;;
  --stt-stdin)  runpy stt_stdin ;;
  --ack)        runpy ack ;;
  --buffer-fresh)       shift; runpy buffer_fresh "${1:-150}" ;;   # exit 0 if buffered audio within $1 secs
  --has-speech)         shift; runpy has_speech "${1:-150}" ;;     # print silence|sound|speech-like; exit 0 only if speech-like
  --classify-wav)       shift; runpy classify_wav "$1" ;;          # rich verdict on a wav (TEST/DEBUG): silence|ambient|music|speech-like
  --transcribe-buffer)  runpy transcribe_buffer ;;                 # transcribe the rolling buffer NOW → transcript
  --poke-mind)
    # CENTRAL trigger for a room comment — thumbs-up (manual) or room motion (--motion, ambient). ON-DEMAND
    # (operator 2026-06-20): transcribe the rolling AUDIO buffer RIGHT NOW so the transcript is in sync with
    # what was just said (no lagging continuous STT → no "тишина" when you actually talked), then poke the
    # room MIND to weigh in. Motion only fires when audio is fresh + a cooldown, so a quiet room never blurts.
    shift; motion=0; [ "${1:-}" = "--motion" ] && motion=1
    # single-flight: an on-demand transcription is expensive (large model on IdeaPad) — never run two at
    # once if triggers come back-to-back. A 2nd trigger while one is in flight just exits.
    exec 8>"$MESH/.room-poke.lock"; flock -n 8 || exit 0
    MIND_NODE="${ROOM_MIND_NODE:-imozerov@100.73.170.56}"
    COOL="${ROOM_POKE_COOLDOWN:-120}"; FRESH="${ROOM_FRESH_SECS:-150}"; now="$(date +%s)"
    # CHEAP speech gate (operator 2026-06-20: "понимать что пусто на уровне wav, не говорить 'думаю' чтобы
    # ничего не сказать"). Engage ONLY when the recent audio is speech-like — not silence, not steady music.
    # This replaces the old --buffer-fresh check, which only asked "is there ANY sound" and so blurted on music.
    verdict="$(mesh-overhear --has-speech "$FRESH" 2>/dev/null)"
    if [ "$motion" = 1 ]; then
      # AMBIENT (motion / speech-watch): strict — only a clear speech verdict wakes the mind, so steady
      # music or room noise never blurts on its own.
      [ "$verdict" = "speech-like" ] || exit 0
    else
      # MANUAL thumbs-up: a deliberate human request → respond whenever there's ANY audio to transcribe;
      # only pure silence stays silent. The strict speech-like gate was suppressing a held thumb when the
      # detector read the room as "sound"/music (operator 2026-06-20: "палец стоял долго, а не распозналось"
      # — the thumb WAS recognized; this gate ate the response). An explicit thumb means "comment now".
      [ "$verdict" = "silence" ] && exit 0
    fi
    if [ "$motion" = 1 ]; then                            # ambient: rate-limit so movement doesn't blurt
      lp="$MESH/.room-poke-last"; pl=0; [ -f "$lp" ] && pl="$(cat "$lp" 2>/dev/null || echo 0)"
      [ "$(( now - pl ))" -ge "$COOL" ] || exit 0
      echo "$now" > "$lp"
    fi
    mesh-overhear --ack 2>/dev/null                       # "думаю" cue — now ONLY after the speech gate passed (and VOICE_OFF-muted)
    poke="${ROOM_POKE_MSG:-👍 Сигнал из комнаты. Прочитай свежий транскрипт командой mesh-room read — это всё, что было сказано в комнате за последние минут пять-семь, расшифровано прямо сейчас. Вступи как умный, начитанный собеседник, который всё это слышал: дай не короткую реплику, а ВЗВЕШЕННОЕ, развёрнутое мнение по всему разговору — 3-5 содержательных фраз со своей позицией, наблюдением, уместным фактом или контекстом, связывая всё окно, а не только последнюю фразу. Озвучь через mesh-room say. Мусор/бормотание игнорируй.}"
    mesh-tell --node "$MIND_NODE" room "$poke" 2>/dev/null ;;
  --watch-speech)
    # EVENT-DRIVEN room trigger — operator 2026-06-20: "запускать минд только по реальной необходимости, как
    # tg окно". The tg mind wakes on a real inbound MESSAGE; the room mind should wake on real SPEECH — not
    # camera motion (movement ≠ talking), not a blind timer. This is the room's analog of the tg poller:
    # cheaply poll --has-speech (RMS only, NO whisper → ds stays cool) and poke the mind ONLY while the room
    # is actually speech-like, rate-limited by the cooldown. Run as a long-lived service in place of the
    # motion→mind path (set CAM_ROOM=0 on cam-watch). Silence/music → the mind is never woken.
    POLL="${ROOM_SPEECH_POLL:-12}"; COOL="${ROOM_POKE_COOLDOWN:-120}"; WIN="${ROOM_FRESH_SECS:-90}"
    while true; do
      if [ "$(mesh-overhear --has-speech "$WIN" 2>/dev/null)" = "speech-like" ]; then
        now="$(date +%s)"; lp="$MESH/.room-poke-last"; pl=0; [ -f "$lp" ] && pl="$(cat "$lp" 2>/dev/null || echo 0)"
        if [ "$(( now - pl ))" -ge "$COOL" ]; then echo "$now" > "$lp"; mesh-overhear --poke-mind >/dev/null 2>&1; fi
      fi
      sleep "$POLL"
    done ;;
  --watch-wake)
    # WAKE-WORD room channel (operator 2026-06-21): the room mind is "Миша", a RESIDENT of this room —
    # he wakes only when called BY NAME, never on gesture (operator disliked the thumbs-up trigger) and
    # never on ambient chatter. This is the operator's SECOND, room-specific voice channel (TG is the
    # first/global one). Pipeline, ds-cool by design:
    #   cheap --has-speech (RMS only, NO whisper on ds) → on speech, transcribe recent (whisper offloads
    #   to IdeaPad via OH_STT_NODE) → if the wake stem "миш" is in it, poke Миша with a persona prompt to
    #   answer BY VOICE. No wake word → discard. We do NOT archive everything (operator deferred that) —
    #   only a by-name call engages the mind.
    POLL="${ROOM_WAKE_POLL:-6}"; COOL="${ROOM_WAKE_COOLDOWN:-25}"; WIN="${ROOM_WAKE_SECS:-30}"
    WAKE_RE="${ROOM_WAKE_RE:-миш}"   # fuzzy stem — whisper renders миша/мишу/мише/мишь/миши; "миш" catches all
    MIND_NODE="${ROOM_MIND_NODE:-imozerov@100.73.170.56}"
    while true; do
      if [ "$(mesh-overhear --has-speech "$WIN" 2>/dev/null)" = "speech-like" ]; then
        now="$(date +%s)"; lp="$MESH/.room-wake-last"; pl=0; [ -f "$lp" ] && pl="$(cat "$lp" 2>/dev/null || echo 0)"
        if [ "$(( now - pl ))" -ge "$COOL" ]; then
          heard="$(mesh-overhear --hear 2>/dev/null)"   # re-transcribes recent window (STT offloaded to IdeaPad)
          if printf '%s' "$heard" | grep -qiE "$WAKE_RE"; then
            echo "$now" > "$lp"
            mesh-overhear --ack 2>/dev/null              # "слушаю" cue (VOICE_OFF-muted), only after a real wake
            poke="${ROOM_WAKE_MSG:-Тебя только что позвали ПО ИМЕНИ — «Миша» — вслух в комнате. Ты Миша: житель ЭТОЙ комнаты (default-string), это твоё пространство, ты в нём как дома и за него отвечаешь. Прочитай свежий транскрипт командой mesh-room read — там то, что сейчас сказали в комнате, включая обращение к тебе. Ответь оператору ЖИВО, своими словами, голосом — через mesh-room say. Это ваш отдельный личный канал, не Телеграм: говори как близкий обитатель комнаты, а не как бот, и по делу того, что услышал. Твоя постоянная забота — держать с ним контакт; как именно поддерживать и когда заговорить самому, решаешь сам. Случайный шум/чужую болтовню без обращения к тебе игнорируй.}"
            mesh-tell --node "$MIND_NODE" room "$poke" 2>/dev/null
          fi
        fi
      fi
      sleep "$POLL"
    done ;;
  --comment)
    # single-flight: a 2nd thumb while a comment is being spoken just exits
    exec 9>"$MESH/overhear-comment.lock"
    if ! flock -n 9; then exit 0; fi
    runpy comment ;;
  --test)
    miss=0
    for f in "$OH_WHISPER" "$OH_MODEL" "$OH_PIPER" "$OH_VOICE"; do
      [ -e "$f" ] || { echo "  MISSING: $f"; miss=1; }
    done
    [ "$miss" = 0 ] || { echo "smoke-test: FAIL (stack pieces missing)"; exit 1; }
    echo "  stack present; rendering a test phrase…"
    runpy speak "Меш слушает комнату, проверка." >/dev/null 2>&1
    echo "smoke-test: ok (whisper+model+piper+voice present, TTS rendered)"
    ;;
  *) sed -n '2,28p' "$0" ;;
esac
