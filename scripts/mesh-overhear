elif mode=="transcribe_buffer":
    sys.stdout.write(transcribe_buffer())

elif mode in ("show","hear"):
    # operator 2026-06-20: surface FRESHNESS so a stale transcript can't read as "now". Two signals:
    #   (a) transcript age = when the last trigger computed it (mtime of TRANSCRIPT_FILE);
    #   (b) live audio age = seconds since the newest BUFFERED utterance (un-transcribed sound waiting).
    # If (b) is fresher than (a), the shown text predates current audio → say so (thumbs-up to re-hear).
    # `hear` mode (operator 2026-06-20) first re-transcribes the recent window so `mesh-room read` is LIVE,
    # not a stale view — the header then reads "computed just now". `show` stays cheap (no whisper).
    if mode=="hear":
        if os.environ.get("OH_HEAR_TEST_HANG"): time.sleep(999)  # test-only: simulate a wedged re-transcribe so --test can prove the OH_HEAR_CEIL bound + honest-degrade
        try: transcribe_recent(HEAR_SECS)
        except Exception: pass
    try:
        t_age=time.time()-os.stat(TRANSCRIPT_FILE).st_mtime
        head="-- room transcript · computed %s --"%fmt_age(t_age)
    except FileNotFoundError:
        print("-- room transcript · none yet (no trigger has run) --"); sys.exit(0)
    b_age=newest_buffer_age(); n=len(buffer_wavs(BUFFER_MIN))
    if b_age<10**8:
        head+="\n-- live audio · %d utterances buffered · newest %s --"%(n,fmt_age(b_age))
        if t_age-30>b_age:
            head+="\n-- ⚠ fresher audio than this transcript (newest %s vs computed %s) — thumbs-up/--comment to re-hear --"%(fmt_age(b_age),fmt_age(t_age))
    else:
        head+="\n-- live audio · buffer empty (room quiet — no recent sound) --"
    print(head)
    try:
        with open(TRANSCRIPT_FILE) as f: sys.stdout.write(f.read())
    except FileNotFoundError: pass

elif mode=="dash":
    paths=buffer_wavs(BUFFER_MIN); age=newest_buffer_age()
    bufmin=BUFFER_MIN//60
    if age<10**8:
        print("-- audio buffer: %d utterances in last ~%d min · newest %ds ago (on-demand STT at a trigger) --"%(len(paths),bufmin,int(age)))
    else:
        print("-- audio buffer: empty (room quiet) · transcribed on a thumbs-up/motion trigger --")
    # mirror show/hear's staleness check (operator "why is last transcript like this" 2026-07-04):
    # the dash used to label this "(synced)" with no age, so a transcript hours old read as current
    # while the buffer line above showed fresh sound seconds ago — same mismatch show/hear already flags.
    try:
        t_age=time.time()-os.stat(TRANSCRIPT_FILE).st_mtime
        stale=" — ⚠ STALE, fresher audio waiting (mesh-room read to re-hear)" if age<10**8 and t_age-30>age else ""
        print("-- last transcript (computed %s%s) --"%(fmt_age(t_age),stale))
    except FileNotFoundError:
        print("-- last transcript: none yet (no trigger has run) --")
    try:
        with open(TRANSCRIPT_FILE) as f: txt=f.read().strip()
        for ln in (txt.splitlines() or ["  (none yet)"]): print("  "+ln[:150])
    except FileNotFoundError: print("  (none yet — thumbs-up or move to ask Claude)")
    try:
        cl=open(os.path.join(os.path.dirname(LOGF),"overhear-comments.log")).read().splitlines()[-3:]
    except Exception: cl=[]
    print("-- your last third-party comments --")
    if cl:
        for c in cl: print("  "+c[:150])
    else:
        print("  (none yet — thumbs-up to comment)")

elif mode=="comment":
    # On-demand STT of the live buffer FIRST so a thumbs-up always comments on what was JUST said —
    # never on a stale/empty rolling log (operator 2026-06-20: "палец стоял, а не распозналось" — the
    # rolling transcript was stale so --comment said "нечего комментировать"). transcribe_buffer also
    # refreshes TRANSCRIPT_FILE, so the data pane stays in sync. Falls back to the rolling log.
    fresh=transcribe_buffer().strip()
    lines=prune_and_read(int(time.time()))
    if fresh and "нет речи" not in fresh.lower():
        lines=(lines or [])+["[сейчас] "+fresh]
    if not lines:
        speak("Пока нечего комментировать, я ещё ничего не услышал."); sys.exit(0)
    transcript="\n".join(lines[-120:])
    prompt=("Ты — внимательная третья сторона, ты молча слушал разговор в комнате. Ниже транскрипт "
            "последних минут (с метками времени, расшифровка на слух — возможны ошибки). Дай ОДИН "
            "короткий полезный комментарий или наблюдение со стороны: что-то меткое, что добавить, "
            "поправить или подметить. 1-3 фразы, по-русски, разговорно, по делу, без воды и без "
            "пересказа. Не начинай с «так», «секунду», «думаю» или любого другого заполнителя-раздумья "
            "— сразу говори суть первым словом.\n\nТРАНСКРИПТ:\n"+transcript)
    reply=relay(prompt)
    if not reply: reply="Что-то я не смог собрать мысль, попробуй ещё раз."
    try:
        with open(os.path.join(os.path.dirname(LOGF),"overhear-comments.log"),"a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S ")+reply+"\n")
    except Exception: pass
    speak(reply)

elif mode=="speak":
    speak(sys.argv[2] if len(sys.argv)>2 else "Меш на связи.")

elif mode=="say_stdin":
    # speak text read from stdin — lets a remote mind pipe arbitrary Russian (quotes, punctuation)
    # without nested-quote hell through ssh: printf '%s' "..." | ssh ds 'bash -lc "mesh-overhear --say-stdin"'
    txt=sys.stdin.read().strip()
    # FILLER-STRIP (operator 2026-07-05): claude-room-mind kept TTS-ing «Секунду, думаю…» every ~10min
    # poke regardless of prompt rules forbidding it. Strip leading filler/thinking-fillers DETERMINISTICALLY
    # before synthesis so they NEVER reach the Bose. If nothing but filler remains → don't speak at all
    # (a filler-only response = "I have nothing to say", silence is the honest reply).
    import re as _re
    _FILLER = _re.compile(r'^\s*(так[,\s]*|секунд[ауоуочкеек]*[,\s]*|секу(нд)?[ау]?[,\s]*|подумаю[,\s]*|думаю[,\s]*|щас[,\s]*|сейчас[,\s]*|момент[,\s]*|мгновенье[,\s]*|окей[,\s]*|ну[,\s]*|blip\b[,\s]*)+', _re.IGNORECASE)
    _stripped = _FILLER.sub('', txt).lstrip(' ,.—:—…').strip()
    txt = _stripped if _stripped else ''
    if txt: speak(txt)

elif mode=="stt_file":
    # transcribe ONE buffered wav (offload-aware via OH_STT_NODE, local fallback) and print the text.
    # The per-chunk wake scanner's unit of work — an 18s utterance STTs far cleaner than a 30-90s
    # music-dominated concat (2026-07-04: per-chunk rendered «миш» twice where the concat lost it).
    sys.stdout.write(transcribe(sys.argv[2]) if len(sys.argv)>2 and os.path.exists(sys.argv[2]) else "")

elif mode=="stt_stdin":
    # transcribe a wav piped on stdin and print the text — this is the STT WORKER a mic node calls on a
    # stronger node (operator 2026-06-20: use the good recognizer, like the voice-note pipeline). ALWAYS
    # local here (transcribe_local), never re-offload, so there's no loop.
    data=sys.stdin.buffer.read()
    tmp="/tmp/stt-%d-%d.wav"%(os.getpid(), int(time.time()*1000)%100000)
    try:
        with open(tmp,"wb") as f: f.write(data)
        sys.stdout.write(transcribe_local(tmp))
    finally:
        try: os.remove(tmp)
        except OSError: pass

elif mode=="ack":
    # REMOVED (operator 2026-07-05, live, repeatedly: "убери вообще" — the pre-rendered "so, one
    # sec, thinking" wav was a hardcoded audio cue, immune to every prompt-level fix against narrated
    # preambles because it isn't LLM text at all. No replacement cue — silence until the real reply.
    pass
PYEOF
  # RUNPY_TIMEOUT (senses→genome 2026-07-13): a caller that must not hang (--hear feeds mesh-room
  # read / any consumer) sets a hard wall-clock ceiling. A wedged record / ssh-offload / whisper is
  # SIGTERM'd at the ceiling, SIGKILL'd 10s later — timeout exits 124/137, the caller honest-degrades.
  # Unset (daemon/comment/etc.) → unbounded as before.
  # $OH_PY, not bare `python3`: the interpreter is bound explicitly at the top of this file, because
  # :40's deliberate /usr/bin-first PATH pin makes a bare `python3` unreachable by any venv.
  if [ -n "${RUNPY_TIMEOUT:-}" ] && command -v timeout >/dev/null 2>&1; then
    timeout -k 10 "$RUNPY_TIMEOUT" "$OH_PY" "$PY" "$@"
  else
    "$OH_PY" "$PY" "$@"
  fi
}

case "${1:-}" in
  --daemon)  runpy daemon ;;
  --ingest)  shift; runpy ingest "$@" ;;
  --show)    runpy show ;;
  --hear)    # LIVE read: re-transcribe the recent window, then print with the freshness header. Single-
             # writer via flock so a burst of thumbs-ups can't pile up whisper runs — losers fall back to
             # the cheap stale --show (which now shows the ⚠ stale-warning anyway). operator 2026-06-20.
             # HARD wall-clock bound (senses→genome 2026-07-13: a suspend-frozen ssh-offload held a
             # room-mind turn 8.5h; runpy hear can wedge in record/ssh-offload/whisper with no internal
             # cap). Bound the WHOLE re-transcribe at OH_HEAR_CEIL (default 150s = one OH_HEAR_SECS window)
             # and honest-degrade to the cheap stale --show on timeout — a consumer never hangs, it gets
             # the last transcript with its ⚠ stale header. rc 124=SIGTERM'd, 137=SIGKILL'd by timeout -k.
             # fd8 preserves the caller's real stderr BEFORE the exec's `2>/dev/null` (argument-less
             # exec makes that redirect PERMANENT for the rest of this case) — else the honest-degrade
             # notice below would be swallowed by /dev/null and the consumer/--test never sees it.
             exec 8>&2 9>"$MESH/oh-hear.lock" 2>/dev/null
             if flock -n 9 2>/dev/null; then
               _hrc=0; RUNPY_TIMEOUT="${OH_HEAR_CEIL:-150}" runpy hear || _hrc=$?
               if [ "$_hrc" = 124 ] || [ "$_hrc" = 137 ]; then
                 echo "[overhear: --hear exceeded ${OH_HEAR_CEIL:-150}s (wedged record/offload/whisper) — honest-degrade to last transcript]" >&8
                 runpy show
               fi
             else runpy show; fi ;;
  --dash)    runpy dash ;;
  --say)        shift; runpy speak "$*" ;;
  --say-stdin)  runpy say_stdin ;;
  --stt-stdin)  runpy stt_stdin ;;
  --stt-file)   shift; runpy stt_file "$1" ;;
  --ack)        runpy ack ;;
  --mint-wake-confirmed)
    # Arm the wake-confirmed marker from the LIVE name-detector (mesh-room-reflex). Exit 0 = minted,
    # 1 = guards refused (not a strict stem, or our own Bose is the source). See _mint_wake_confirmed.
    shift; _mint_wake_confirmed "${1:-}" ;;
  --buffer-fresh)       shift; runpy buffer_fresh "${1:-150}" ;;   # exit 0 if buffered audio within $1 secs
  --has-speech)         shift; runpy has_speech "${1:-150}" ;;     # print silence|sound|speech-like; exit 0 only if speech-like
  --has-known-voice)    shift; runpy has_known_voice "${1:-150}" ;; # print name+score if a known voice is in the buffer; exit 0 only if match
  --classify-wav)       shift; runpy classify_wav "$1" ;;          # rich verdict on a wav (TEST/DEBUG): silence|ambient|music|speech-like
  --transcribe-buffer)  runpy transcribe_buffer ;;                 # transcribe the rolling buffer NOW → transcript
  --poke-mind)
    # CENTRAL trigger for a room comment — thumbs-up (manual) or room motion (--motion, ambient). ON-DEMAND
    # (operator 2026-06-20): transcribe the rolling AUDIO buffer RIGHT NOW so the transcript is in sync with
    # what was just said (no lagging continuous STT → no "тишина" when you actually talked), then poke the
    # room MIND to weigh in. Motion only fires when audio is fresh + a cooldown, so a quiet room never blurts.
    shift; motion=0; voice=0
    [ "${1:-}" = "--motion" ] && motion=1
    [ "${1:-}" = "--voice" ] && voice=1
    # single-flight: an on-demand transcription is expensive (large model on IdeaPad) — never run two at
    # once if triggers come back-to-back. A 2nd trigger while one is in flight just exits.
    exec 8>"$MESH/.room-poke.lock"; flock -n 8 || exit 0
    MIND_NODE="${ROOM_MIND_NODE:-imozerov@100.73.170.56}"
    # Voice-triggered pokes use a SHORTER cooldown (active conversation = frequent engagement)
    if [ "$voice" = 1 ]; then COOL="${ROOM_VOICE_COOLDOWN:-60}"; else COOL="${ROOM_POKE_COOLDOWN:-120}"; fi
    FRESH="${ROOM_FRESH_SECS:-150}"; now="$(date +%s)"
    # MOTION-TRIGGERED (operator 2026-07-04): camera motion → voice-print gate → transcribe known voice →
    # comment. The voice-print check is the REAL "is a person talking" gate: only fire when a known voice
    # (operator/Rozalia) is detected in the recent buffer. TV/music never matches → no wasted transcription,
    # no hallucinated subtitle text. Fail-open: no voice prints enrolled → motion always pokes (old behavior).
    if [ "$motion" = 1 ]; then
      voice_result="$(mesh-overhear --has-known-voice "$FRESH" 2>/dev/null)"
      if [ $? -ne 0 ]; then
        exit 0   # no known voice in the buffer — TV/music only, nothing to comment on
      fi
    elif [ "$voice" = 1 ]; then
      : # voice-triggered by the watcher — the watcher already verified a known voice, no extra gate
    else
      # MANUAL thumbs-up: a deliberate human request → respond whenever there's ANY audio to transcribe;
      # only pure silence stays silent.
      verdict="$(mesh-overhear --has-speech "$FRESH" 2>/dev/null)"
      [ "$verdict" = "silence" ] && exit 0
    fi
    if [ "$motion" = 1 ] || [ "$voice" = 1 ]; then           # ambient: rate-limit so movement doesn't blurt
      lp="$MESH/.room-poke-last"; pl=0; [ -f "$lp" ] && pl="$(cat "$lp" 2>/dev/null || echo 0)"
      [ "$(( now - pl ))" -ge "$COOL" ] || exit 0
      echo "$now" > "$lp"
    fi
    mesh-overhear --ack 2>/dev/null
    # operator 2026-07-05: for --voice, transcribe RIGHT NOW on ds (in sync with the audio) and pass the
    # text directly to the mind. This eliminates the timing gap where the mind SSHs back to ds to read,
    # by which point the audio buffer has rotated. The mind gets the text inline and can respond at once.
    if [ "$voice" = 1 ]; then
      # BODY, not tail -1 (2026-07-05): --hear now writes PER-CHUNK lines (concat-drowned rescue) —
      # tail -1 grabbed only the newest chunk, so the mind got poked with a song refrain («Время.»)
      # while the real conversation sat in the lines above. Take the transcript body (headers
      # stripped), newest ~6 lines, flattened.
      # keep only real transcript lines ("[HH:MM:SS] …") — headers start with '--' and the
      # resemblyzer lib prints "Loaded the voice encoder model…" to STDOUT on import, which
      # leaked verbatim into a mind poke (2026-07-05 10:38).
      raw="$(mesh-overhear --hear 2>/dev/null | grep '^\[' | tail -6 | tr '\n' ' ')"
      # skip if no real speech (markers: нет речи, нет знакомого, тишина/нет читаемого, empty)
      if printf '%s' "$raw" | grep -qiE 'нет речи|нет знакомого|тишина|нет читаемого|^[[:space:]]*$'; then
        exit 0
      fi
      # SUBSTANCE gate (2026-07-05): music vocals can pass the voice-print match — a lone refrain
      # chunk poked the mind THREE times on the word «Время». Waking a mind costs a full turn;
      # require a few real words (timestamps stripped) before it's worth one.
      _nw="$(printf '%s' "$raw" | sed 's/\[[^]]*\]//g' | wc -w)"
      [ "$_nw" -ge "${ROOM_VOICE_MIN_WORDS:-4}" ] || exit 0
      # DISTINCT-words gate (2026-07-05, same hour): a chorus repeats — «Воспоминание Воспоминание
      # Воспоминание Воскресенье ПЕСНЯ Воскресенье» is 6 words but only 3 distinct, and it slid
      # through the raw count. Real conversation trivially clears 4 distinct words; lyrics loops don't.
      # (python, not tr: tr is byte-oriented — UTF-8 Cyrillic never matches [:alpha:], count came out 0)
      _dw="$(printf '%s' "$raw" | python3 -c "import sys,re; print(len(set(re.findall(r'[^\W\d_]+', re.sub(r'\[[^]]*\]','',sys.stdin.read()).lower()))))" 2>/dev/null || echo 99)"
      [ "$_dw" -ge "${ROOM_VOICE_MIN_DISTINCT:-4}" ] || exit 0
      poke="${ROOM_VOICE_POKE_MSG:-📋 Слышу разговор в комнате. Вот что сказали: $raw Отреагируй естественно и коротко — 1-3 фразы, как собеседник за столом. НЕ начинай с «так, секунду, думаю» или любого другого заполнителя-раздумья — сразу суть. Озвучь через mesh-room say.}"
    else
      poke="${ROOM_POKE_MSG:-📋 Слышу голос в комнате. Прочитай mesh-room read — свежий транскрипт последних минут через Groq. Отреагируй естественно на то, что говорят — короткий живой ответ, как собеседник за столом (1-3 фразы). НЕ начинай с «так, секунду, думаю» или любого другого заполнителя-раздумья — сразу суть. Озвучь через mesh-room say. Если в транскрипте только шум/музыка — промолчи.}"
    fi
    mesh-tell --node "$MIND_NODE" room "$poke" 2>/dev/null ;;
  --watch-speech)
    # RETIRED-BY-DEFAULT (chat-review/room-ambient-poke-churn, 2026-07-10): this path polls --has-speech,
    # which is RMS-ONLY (no whisper, no voice-print) — so TV/music reads "speech-like" and pokes the room
    # mind (ROOM_POKE_MSG) ~every 2min, each poke a full LLM turn that resolves silent on music. It burned
    # quota + heat on a 90C+ box. The resemblyzer --watch-voice below is the PRIMARY trigger now (operator
    # 2026-07-05, "TV/music never matches"); a stale mesh-room-speech.service running THIS path was the live
    # churn source (service since removed). Gate it behind an explicit opt-in so it can never be the default
    # poker again; a bare `--watch-speech` exits at once instead of launching the RMS churn loop.
    if [ "${ROOM_WATCH_SPEECH_ENABLE:-0}" != 1 ]; then
      echo "mesh-overhear --watch-speech: RETIRED (RMS-only → music false-pokes). Use --watch-voice (resemblyzer PRIMARY); set ROOM_WATCH_SPEECH_ENABLE=1 to force." >&2
      exit 0
    fi
    # SINGLETON (2026-07-10, mirror --watch-wake @ the flock below): a relaunch that forgets to kill the old
    # loop must not stack a 2nd RMS poker (the exact 2026-07-07 --watch-wake "two ran for hours" failure).
    exec 6>"$MESH/.room-watch-speech.lock"; flock -n 6 || exit 0
    POLL="${ROOM_SPEECH_POLL:-12}"; COOL="${ROOM_POKE_COOLDOWN:-120}"; WIN="${ROOM_FRESH_SECS:-90}"
    while true; do
      if [ "$(mesh-overhear --has-speech "$WIN" 2>/dev/null)" = "speech-like" ]; then
        now="$(date +%s)"; lp="$MESH/.room-poke-last"; pl=0; [ -f "$lp" ] && pl="$(cat "$lp" 2>/dev/null || echo 0)"
        if [ "$(( now - pl ))" -ge "$COOL" ]; then echo "$now" > "$lp"; mesh-overhear --poke-mind >/dev/null 2>&1; fi
      fi
      sleep "$POLL"
    done ;;
  --watch-voice)
    # VOICE-TRIGGERED watcher (operator 2026-07-05: "больше слушай"): the PRIMARY room trigger now —
    # continuously polls the audio buffer for KNOWN VOICES (resemblyzer speaker verification). When Ilya
    # or Rozalia speaks, poke the mind to listen and respond. This replaces camera motion as the main
    # trigger (sitting and talking = no camera motion, but voice is live). TV/music never matches.
    # The watcher is the "ear" of the room: it doesn't need camera motion to know someone is talking.
    # SINGLETON (2026-07-10, mirror --watch-wake @1406): the PRIMARY trigger must not stack duplicates on a
    # relaunch that forgets to kill the old loop (the 2026-07-07 --watch-wake "two ran for hours" failure);
    # a 2nd instance would double the resemblyzer load on ds and double-poke the mind. 2nd instance exits.
    exec 5>"$MESH/.room-watch-voice.lock"; flock -n 5 || exit 0
    POLL="${ROOM_VOICE_POLL:-15}"; WIN="$((POLL*2))"
    while true; do
      if mesh-overhear --has-known-voice "$WIN" >/dev/null 2>&1; then
        mesh-overhear --poke-mind --voice >/dev/null 2>&1
      fi
      sleep "$POLL"
    done ;;
  --watch-wake)
    # RETIRED 2026-07-15 (board/room-ear-watcher-up-is-a-pgrep-self-match) — SUPERSEDED, and it had been
    # running NOWHERE and wired NOWHERE (no crontab, no reflexes.cron, no unit) since at least Jul 14
    # 22:08, the freeze mtime of its own .room-wake-scanned cursor. Nobody noticed because the pane LIED:
    # mesh-dash gated it on `pgrep -f "watch-wake"`, which matches the cmdline of the very shell running
    # the pgrep → a CONSTANT UP (the process-level twin of the grep-$0 vacuous gates, 1969a5d).
    #
    # WHY NOT JUST WIRE IT: this loop STTs every buffer chunk itself, which is now duplicate work —
    # mesh-room-gigaam.service already transcribes the SAME buffer into room-transcript.txt with a
    # better organ (GigaAM v2 on GPU: ~25x faster, and non-autoregressive so it cannot hallucinate a
    # name into silence/music the way this path's whisper could), and mesh-room-reflex greps that
    # transcript for the name stem and pokes the mind — with a precision half this loop never had
    # (mesh-room-address, a local qwen judging "is this addressed TO Misha?"). Its node defaults below
    # (MIND_NODE=imozerov@..., the retired IdeaPad) are also pre-migration: wiring it as-written would
    # poke a node that no longer runs the minds.
    #
    # WHAT WAS SALVAGED, NOT DELETED: the one thing this loop uniquely did was MINT .room-wake-confirmed
    # (mesh-room's misha-gate bypass — "the operator said your name out loud, answer without re-rolling
    # the ambient occupancy gate"). That capability was dead end-to-end, so the mint moved to the live
    # detector: mesh-room-reflex now calls `mesh-overhear --mint-wake-confirmed`, which reuses THIS
    # file's tested guards (_wake_should_mint = strict stem + Bose-foreign) rather than a second copy.
    # Kept (not attic'd) behind an opt-in, mirroring --watch-speech above: the loop still documents the
    # per-chunk scan design, and a forced run must never be the silent default again.
    if [ "${ROOM_WATCH_WAKE_ENABLE:-0}" != 1 ]; then
      echo "mesh-overhear --watch-wake: RETIRED (superseded by mesh-room-gigaam + mesh-room-reflex on the transcript; this loop duplicates STT and its MIND_NODE default is the pre-migration IdeaPad). The wake-confirmed mint now lives on the live path (--mint-wake-confirmed). Set ROOM_WATCH_WAKE_ENABLE=1 to force." >&2
      exit 0
    fi
    # WAKE-WORD room channel (operator 2026-06-21): the room mind is "Миша", a RESIDENT of this room —
    # he wakes only when called BY NAME, never on gesture (operator disliked the thumbs-up trigger) and
    # never on ambient chatter. This is the operator's SECOND, room-specific voice channel (TG is the
    # first/global one). Pipeline, ds-cool by design:
    #   cheap --has-speech (RMS only, NO whisper on ds) → on speech, transcribe recent (whisper offloads
    #   to IdeaPad via OH_STT_NODE) → if the wake stem "миш" is in it, poke Миша with a persona prompt to
    #   answer BY VOICE. No wake word → discard. We do NOT archive everything (operator deferred that) —
    #   only a by-name call engages the mind.
    # PER-CHUNK INCREMENTAL SCAN (2026-07-04 v2 — operator: "reflex of hearing misha should be
    # bullet-proof"). The old loop STT'd a 30s concat window on a 75s duty cycle: >half the timeline
    # was NEVER scanned (deterministic blind gaps — a by-name call at 02:00:45 fell in one), and a
    # music-dominated concat loses embedded speech that per-utterance STT renders cleanly. Now every
    # buffered utterance wav is transcribed EXACTLY ONCE (state = ms-stamp of newest scanned chunk):
    # gapless by construction, cheaper per unit, offload-aware (OH_STT_NODE). Classifier gates are
    # GONE from this path — the classifier cannot separate voice-over-music and has no veto here.
    POLL="${ROOM_WAKE_POLL:-4}"; COOL="${ROOM_WAKE_COOLDOWN:-45}"
    # LOOSE NET, SMART CONFIRM (2026-07-04 02:23): music can drown the name enough that even the
    # accurate model garbles it («Бежно»/«Вмеж» ← «Миша, на связи» — measured on the operator's
    # real test call). So the stem net is deliberately WIDE (observed garble family included); the
    # woken MIND reads the heard-tape and answers only if genuinely addressed — a false poke costs
    # seconds (COOL-limited), a missed call costs the whole channel.
    # TWO-TIER SPLIT (chat-review/wake-confirm-mint-too-loose, 2026-07-05): the loose net above is a
    # POKE trigger only. Plain words like "между"/"бежит" contain the garble-family substrings
    # ("меж"/"беж") and would silently mint the wake-confirmed marker + speak an --ack for a TV/ambient
    # word — arming mesh-room's misha-gate bypass on a non-wake. wake_confirm_hit() (strict "миш"/
    # "misha" stem only) now gates the marker + --ack; wake_hit() (loose) still gates the poke below.
    MIND_NODE="${ROOM_MIND_NODE:-imozerov@100.73.170.56}"
    CATCHUP="${ROOM_WAKE_CATCHUP:-6}"          # backlog cap: scan at most N newest unscanned chunks per pass
    # wake-confirmed TTL (chat-review/wake-confirmed-room-reply): a genuine by-name call is STRONGER
    # presence evidence than ambient sound/motion (mesh-misha-gate's bar). A short-lived marker lets
    # `mesh-room say --wake-confirmed` answer THIS wake without re-rolling the ambient occupancy gate,
    # while --poke-mind/--comment (ambient triggers) stay fully gated — see mesh-room's _wake_confirmed_active.
    # (WAKE_CONFIRM_TTL is defined once at the top now — it is shared with --mint-wake-confirmed.)
    SCANNED="$MESH/.room-wake-scanned"         # ms-stamp of newest chunk already STT'd (liveness = ear alive)
    BUF="$MESH/audio-buffer"
    # SINGLETON (2026-07-07, found live: two --watch-wake had been running for hours — no lock ever
    # guarded this loop, unlike --poke-mind/--comment above). Both raced the SAME $SCANNED cursor with
    # no coordination: double STT load on ds (explains recurring ear-watcher "lagging" under otherwise
    # normal load) and a genuine risk of one writer's $SCANNED write undoing the other's progress,
    # which would either replay already-heard chunks or skip pending ones. A relaunch/restart that
    # forgets to kill the old process now silently exits instead of stacking a second hearer.
    exec 7>"$MESH/.room-watch-wake.lock"; flock -n 7 || exit 0
    while true; do
      last=0; [ -f "$SCANNED" ] && last="$(cat "$SCANNED" 2>/dev/null || echo 0)"
      # oldest→newest unscanned, capped to the newest CATCHUP so a long backlog can't wedge the ear
      pend="$(ls "$BUF" 2>/dev/null | grep '\.wav$' | sed 's/\.wav$//' | awk -v l="$last" '$1>l' | sort -n | tail -"$CATCHUP")"
      for ms in $pend; do
        w="$BUF/$ms.wav"; [ -f "$w" ] || continue
        txt="$(OH_STT_FAST=1 OH_LANG=ru mesh-overhear --stt-file "$w" 2>/dev/null)"
        echo "$ms" > "$SCANNED"
        printf '%s [%s] %s\n' "$(date +%H:%M:%S)" "$ms" "$txt" >> "$MESH/.room-wake-heard" 2>/dev/null || true
        # 2ND PASS (2026-07-04 02:23): base sometimes garbles the NAME under music («Бежно» ←
        # «Миша, на связи» — the test call that proved it). If the fast text has no wake stem BUT
        # carries real words (not just music markers), re-transcribe with the accurate model
        # (OH_STT_QUAL: ladder model, 4 threads) and wake-grep that too. Music chunks (the vast
        # majority) never pay the quality cost.
        if ! wake_hit "$txt"; then
          nw="$(_room_wake_plain_wordcount "$txt")"
          if [ "$nw" -ge 2 ]; then
            txt2="$(OH_STT_QUAL=1 mesh-overhear --stt-file "$w" 2>/dev/null)"
            printf '%s [%s][q] %s\n' "$(date +%H:%M:%S)" "$ms" "$txt2" >> "$MESH/.room-wake-heard" 2>/dev/null || true
            txt="$txt $txt2"
          fi
        fi
        tail -50 "$MESH/.room-wake-heard" > "$MESH/.room-wake-heard.t" 2>/dev/null && mv "$MESH/.room-wake-heard.t" "$MESH/.room-wake-heard"
        if wake_hit "$txt"; then
          now="$(date +%s)"; lp="$MESH/.room-wake-last"; pl=0; [ -f "$lp" ] && pl="$(cat "$lp" 2>/dev/null || echo 0)"
          if [ "$(( now - pl ))" -ge "$COOL" ]; then
            echo "$now" > "$lp"
            # STRICT gate (chat-review/wake-confirm-mint-too-loose): only a strict name-stem hit mints
            # the wake-confirmed marker + speaks the --ack cue. A loose-only hit (garble family word
            # like "между"/"бежит") still pokes the mind below, but must NOT arm the misha-gate bypass
            # or make an audible sound — that's the whole point of the split.
            # via the shared minter (not an inline copy of its write): if this retired loop is ever
            # forced back on with ROOM_WATCH_WAKE_ENABLE=1, it must arm the bypass by the SAME rule
            # the live path uses, not a second one that drifted.
            if _mint_wake_confirmed "$txt"; then
              mesh-overhear --ack 2>/dev/null            # "слушаю" cue, only after a STRICT real wake
            fi
            # LIVE-COST gate (chat-review/roomwake-loose-poke-realcost): the mesh-tell below is a
            # full paid LLM turn, unlike the cooldown arm above (a genuinely "few seconds" cost).
            # A loose-only hit (garble family word like "между"/"бежит") still cools down and, per
            # the STRICT gate above, never mints/acks — but it must ALSO not fire this real turn
            # unless corroborated (_room_wake_should_tell: strict name-stem, or a short utterance).
            if _room_wake_should_tell "$txt"; then
              poke="${ROOM_WAKE_MSG:-Тебя только что позвали ПО ИМЕНИ — «Миша» — вслух в комнате. Ты Миша: житель ЭТОЙ комнаты (default-string), это твоё пространство, ты в нём как дома и за него отвечаешь. Прочитай свежий транскрипт командой mesh-room read — там то, что сейчас сказали в комнате, включая обращение к тебе. Ответь оператору ЖИВО, своими словами, голосом — через mesh-room say --wake-confirmed (ты вызван ПО ИМЕНИ, это сильнее обычного присутствия). Это ваш отдельный личный канал, не Телеграм: говори как близкий обитатель комнаты, а не как бот, и по делу того, что услышал. Твоя постоянная забота — держать с ним контакт; как именно поддерживать и когда заговорить самому, решаешь сам. Случайный шум/чужую болтовню без обращения к тебе игнорируй. Что именно было сказано: смотри хвост ~/.mesh/.room-wake-heard на узле комнаты (ssh imozerov@100.125.157.75 tail -20 .mesh/.room-wake-heard).}"
              mesh-tell --node "$MIND_NODE" room "$poke" 2>/dev/null
            fi
          fi
        fi
      done
      sleep "$POLL"
    done ;;
  --comment)
    # single-flight: a 2nd thumb while a comment is being spoken just exits
    exec 9>"$MESH/overhear-comment.lock"
    if ! flock -n 9; then exit 0; fi
    runpy comment ;;
  --test)
    # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
    # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
    # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
    # guard var and skips its own fence (it is already inside one).
    if [ -z "${MESH_TEST_TMPD:-}" ]; then
      MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
      trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
      export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
      _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
    fi
    # THE TEST MUST NOT WRITE THE ARTIFACT IT CHECKS. mesh-doctor runs this --test hourly; if a leg's
    # diagnostic landed in the real ~/.mesh/overhear-diag.log, the tape a human reads for "did the
    # claim-order gate fire at boot" would fill with notes minted by the test itself. Redirect the
    # whole run to a scratch tape here — before ANY leg — and assert the real one is untouched at the
    # end (the _ohreal_before/_after pair below).
    # (cleanup below removes $_ohtest_tape, NEVER $OH_DIAG_LOG — a leg is free to repoint the variable,
    # and `rm -f "$OH_DIAG_LOG"` would then delete whatever it happens to name, up to the real tape.)
    _ohtest_tape="$(mktemp "${TMPDIR:-/tmp}"/oh-diag-test-XXXXXX.log)"
    export OH_DIAG_LOG="$_ohtest_tape"
    _ohreal="$MESH/overhear-diag.log"
    _ohreal_before="$( { [ -e "$_ohreal" ] && wc -c < "$_ohreal"; } 2>/dev/null || echo absent )"
    miss=0
    for f in "$OH_WHISPER" "$OH_MODEL" "$OH_PIPER" "$OH_VOICE"; do
      [ -e "$f" ] || { echo "  MISSING: $f"; miss=1; }
    done
    [ "$miss" = 0 ] || { echo "smoke-test: FAIL (stack pieces missing)"; exit 1; }
    # pre-STT VAD gate: the room contact path must skip whisper on non-speech (silence/ambient/music) and
    # write an honest marker. Assert the verdict→marker mapping the gate uses (no mic/buffer needed).
    case "$(runpy gate_kind silence)" in *тишина*) : ;; *) echo "smoke-test: FAIL (gate silence marker)"; exit 1;; esac
    case "$(runpy gate_kind ambient)" in *гул*)    : ;; *) echo "smoke-test: FAIL (gate ambient marker)"; exit 1;; esac
    case "$(runpy gate_kind music)"   in *музыка*) : ;; *) echo "smoke-test: FAIL (gate music marker)"; exit 1;; esac
    echo "  pre-STT VAD gate mapping ok (silence/ambient/music → skip-whisper marker)"
    # no-backoff respawn gate (discover/overhear-recorder-respawn-loop-no-backoff, 2026-07-27): a recorder
    # that dies instantly with no stdout is a CLEAN short-read, not an exception, so the daemon's
    # except-branch sleep never fired and arecord respawned ~861/s for 4.7h (10% of a core). Assert BOTH
    # halves of the fix, driving a real failing recorder via OH_RECORDER_CMD:
    #   (a) capture_utterance surfaces a NON-None err (reason carried off stderr — was DEVNULL-swallowed);
    #   (b) the daemon BACKS OFF — bounded recorder spawns over a fixed window, not a fork storm.
    _td="$(mktemp -d)"; _cnt="$_td/spawns"; : > "$_cnt"
    _recstub="sh -c 'echo x >> $_cnt; echo \"test: forced recorder failure (device busy)\" >&2; exit 1'"
    # (a) the fault must be reported, not swallowed — RED on the old DEVNULL/"" path.
    _cp="$( export OH_RECORDER_CMD="$_recstub"; runpy capture_probe )"
    case "$_cp" in
      *"wav=no|err="*"forced recorder failure"*) : ;;
      *) echo "smoke-test: FAIL (capture_utterance must surface the recorder failure reason, got: $_cp)"; rm -rf "$_td"; exit 1;;
    esac
    # (b) run the daemon ~2s against the failing recorder; spawns must stay bounded (backoff) not storm.
    : > "$_cnt"
    OH_RECORDER_CMD="$_recstub" OH_LOG="$_td/overheard.log" timeout 2 "$0" --daemon >/dev/null 2>&1 || true
    _spawns="$(wc -l < "$_cnt" 2>/dev/null || echo 0)"; _spawns="$(printf '%s' "$_spawns" | tr -d ' ')"
    rm -rf "$_td"
    if [ "${_spawns:-0}" -gt 12 ]; then
      echo "smoke-test: FAIL (no-backoff respawn: $_spawns recorder spawns in ~2s — daemon backoff not firing)"; exit 1
    fi
    echo "  recorder no-backoff gate ok (fault reason surfaced; $_spawns spawns in ~2s, backoff bounds the storm)"
    # wake-word tiering (chat-review/wake-confirm-mint-too-loose): a strict-stem hit must pass BOTH
    # wake_hit (poke) and wake_confirm_hit (marker+ack); a loose-only garble-family word must pass
    # wake_hit but NOT wake_confirm_hit, so it can never mint the marker or fire --ack.
    wake_hit "Миша, на связи"        || { echo "smoke-test: FAIL (strict text should hit loose wake_hit)"; exit 1; }
    wake_confirm_hit "Миша, на связи" || { echo "smoke-test: FAIL (strict text should hit wake_confirm_hit)"; exit 1; }
    wake_hit "Misha are you there"        || { echo "smoke-test: FAIL (strict EN text should hit loose wake_hit)"; exit 1; }
    wake_confirm_hit "Misha are you there" || { echo "smoke-test: FAIL (strict EN text should hit wake_confirm_hit)"; exit 1; }
    for loose_only in "сядь между стульями" "собака бежит по двору"; do
      wake_hit "$loose_only" || { echo "smoke-test: FAIL (loose-only text '$loose_only' should still hit wake_hit — poke path)"; exit 1; }
      if wake_confirm_hit "$loose_only"; then
        echo "smoke-test: FAIL (loose-only text '$loose_only' must NOT hit wake_confirm_hit — marker/ack must stay off)"; exit 1
      fi
    done
    wake_hit "совершенно не по теме разговор" && { echo "smoke-test: FAIL (unrelated text should not hit wake_hit)"; exit 1; }
    echo "  wake-word tiering ok (strict hit -> poke+confirm; loose-only garble word -> poke yes, marker/ack no)"
    # THE MINT ITSELF, driven for its ARTIFACT (2026-07-15, board/room-ear-watcher-up-is-a-pgrep-self-match).
    # The tiering asserts above check the PREDICATES; they would all still pass if the marker were never
    # written — which is exactly the state this whole fix came out of (mesh-room read .room-wake-confirmed
    # for weeks; its only minter ran nowhere, so the file had never existed and the read was permanently
    # false). So assert the real verb writes the real file, with a real future expiry, and refuses when a
    # guard says no. MESH is redirected at a sandbox: a test must never write the live marker (it would
    # forge an armed bypass the room mind then acts on).
    _mt="$(mktemp -d)"; ( MESH="$_mt"
      _bose_foreign_now() { return 1; }                       # our Bose is quiet: a real call may mint
      _mint_wake_confirmed "Миша, ты тут?" || { echo "smoke-test: FAIL (a real by-name call must mint the wake-confirmed marker)"; exit 1; }
      [ -f "$_mt/.room-wake-confirmed" ] || { echo "smoke-test: FAIL (mint reported success but wrote NO marker — the artifact is the claim)"; exit 1; }
      _exp="$(cat "$_mt/.room-wake-confirmed")"
      [ "$_exp" -gt "$(date +%s)" ] || { echo "smoke-test: FAIL (minted marker is already expired — mesh-room would read it as no wake)"; exit 1; }
      rm -f "$_mt/.room-wake-confirmed"
      _mint_wake_confirmed "он бежит между домами" && { echo "smoke-test: FAIL (loose-only garble text must NOT mint — it would arm the misha-gate bypass on a TV word)"; exit 1; }
      [ ! -f "$_mt/.room-wake-confirmed" ] || { echo "smoke-test: FAIL (loose-only text wrote a marker)"; exit 1; }
      _bose_foreign_now() { return 0; }                       # our own Bose is playing: a broadcast "Миша" must not arm
      _mint_wake_confirmed "Миша, ты тут?" && { echo "smoke-test: FAIL (Bose-foreign playback must veto the mint — a broadcast name is not the operator)"; exit 1; }
      [ ! -f "$_mt/.room-wake-confirmed" ] || { echo "smoke-test: FAIL (mint wrote a marker while our own Bose was the source)"; exit 1; }
      # Effector-agnostic emission veto (lit-4e 2026-07-23): the mesh also speaks OFF the Bose sink
      # (mesh-note3-say via adb, clone voice) — all such organs hold $MESH/mesh-speaking. A fresh mark
      # must veto the mint exactly like Bose playback; an EXPIRED/stale one must fail OPEN (a leaked
      # flag must never make the mint permanently deaf — deafness is never the safe default).
      _bose_foreign_now() { return 1; }                       # Bose quiet again — isolate the emission-mark veto
      echo "$(( $(date +%s) + 30 ))" > "$_mt/mesh-speaking"   # note3-say-style deadline flag, still live
      _mint_wake_confirmed "Миша, ты тут?" && { echo "smoke-test: FAIL (a live self-emission mark (note3/clone speaking) must veto the mint — our own voice is not the operator)"; exit 1; }
      [ ! -f "$_mt/.room-wake-confirmed" ] || { echo "smoke-test: FAIL (mint wrote a marker while the mesh itself was speaking)"; exit 1; }
      echo "$(( $(date +%s) - 5 ))" > "$_mt/mesh-speaking"    # deadline passed, reaper just hasn't fired yet
      _mint_wake_confirmed "Миша, ты тут?" || { echo "smoke-test: FAIL (an expired-deadline emission mark must fail OPEN, not veto)"; exit 1; }
      rm -f "$_mt/.room-wake-confirmed"
      : > "$_mt/mesh-speaking"                                 # voice-tx-style empty flag, FRESH — the mesh is speaking now
      _mint_wake_confirmed "Миша, ты тут?" && { echo "smoke-test: FAIL (a fresh empty (touch-style) mesh-speaking flag must veto the mint)"; exit 1; }
      touch -d '10 minutes ago' "$_mt/mesh-speaking"           # voice-tx killed between touch and rm — leaked stale
      _mint_wake_confirmed "Миша, ты тут?" || { echo "smoke-test: FAIL (a STALE empty mesh-speaking flag must fail OPEN — a leaked flag would otherwise veto forever)"; exit 1; }
      rm -f "$_mt/.room-wake-confirmed" "$_mt/mesh-speaking"
      exit 0
    ) || { rm -rf "$_mt"; exit 1; }
    rm -rf "$_mt"
    echo "  wake-confirmed mint ok (real call -> marker; loose word / Bose-foreign / live emission mark -> refused; stale mark fails open)"
    # THE RETIRED WATCHER MUST STAY RETIRED: --watch-wake ran nowhere and was wired nowhere while the
    # pane claimed it was up; it is superseded by gigaam+reflex and must never silently become the
    # default poker again. It must RETURN (not enter its scan loop) unless explicitly forced.
    _wwout="$(timeout 10 "$0" --watch-wake 2>&1)"; _wwrc=$?
    [ "$_wwrc" = 124 ] && { echo "smoke-test: FAIL (--watch-wake entered its loop instead of returning — the retirement is not enforced)"; exit 1; }
    printf '%s' "$_wwout" | grep -q RETIRED || { echo "smoke-test: FAIL (--watch-wake must say it is RETIRED and why, not exit silently)"; exit 1; }
    echo "  --watch-wake retirement ok (returns with a RETIRED notice; the mint moved to the live path)"
    # roomwake-loose-poke-realcost (chat-review 2026-07-10): _room_wake_should_tell is the ONLY thing
    # gating the live --watch-wake mesh-tell call (see the call site above), so testing it directly IS
    # testing the real decision — same "shared function, not a duplicate" discipline as
    # _wake_should_mint above. A stubbed mesh-tell on PATH, driven by the REAL (exported, not faked)
    # gate function, proves the exact "if _room_wake_should_tell; then mesh-tell; fi" shape never
    # invokes mesh-tell for a loose-only hit, without needing the live STT/tmux pipeline.
    export -f _room_wake_should_tell _room_wake_plain_wordcount wake_hit wake_confirm_hit
    export ROOM_WAKE_RE ROOM_WAKE_STRICT_RE ROOM_WAKE_TELL_NW_MAX
    _rwt="$(mktemp -d)"; mkdir -p "$_rwt/bin"
    printf '#!/bin/sh\necho "MESH-TELL CALLED: $*" >> "%s/called.log"\n' "$_rwt" > "$_rwt/bin/mesh-tell"; chmod +x "$_rwt/bin/mesh-tell"
    for tv_line in "он идёт между домами и потом бежит дальше" "собака бежит по двору"; do
      if _room_wake_should_tell "$tv_line"; then
        echo "smoke-test: FAIL (loose-only TV-ish text '$tv_line' should NOT pass the mesh-tell gate)"; rm -rf "$_rwt"; exit 1
      fi
      PATH="$_rwt/bin:$PATH" bash -c 'if _room_wake_should_tell "$1"; then mesh-tell --node x room "should not run"; fi' _ "$tv_line"
    done
    [ -f "$_rwt/called.log" ] && { echo "smoke-test: FAIL (stubbed mesh-tell was invoked for a loose-only TV-ish hit)"; rm -rf "$_rwt"; exit 1; }
    _room_wake_should_tell "Миша, на связи" \
      || { echo "smoke-test: FAIL (real by-name call 'Миша, на связи' must still pass the mesh-tell gate — regression)"; rm -rf "$_rwt"; exit 1; }
    _room_wake_should_tell "Misha are you there" \
      || { echo "smoke-test: FAIL (real by-name call 'Misha are you there' must still pass the mesh-tell gate — regression)"; rm -rf "$_rwt"; exit 1; }
    PATH="$_rwt/bin:$PATH" bash -c 'if _room_wake_should_tell "$1"; then mesh-tell --node x room "should run"; fi' _ "Миша, на связи"
    grep -q 'should run' "$_rwt/called.log" 2>/dev/null \
      || { echo "smoke-test: FAIL (real by-name call must still reach mesh-tell — regression)"; rm -rf "$_rwt"; exit 1; }
    rm -rf "$_rwt"
    echo "  roomwake-loose-poke-realcost gate ok (loose TV-ish garble-word hit -> no mesh-tell; real by-name call -> mesh-tell unchanged)"
    # Bose-foreign gate on the confirm MINT (chat-review 2026-07-07: a news broadcast's mangled name
    # ("Миша Квыан-Кэвс...") minted a wake-confirmed marker while Firefox was proven live-streaming to
    # Bose). Stub wpctl so --test never touches the real PipeWire graph.
    _wt2="$(mktemp -d)"; mkdir -p "$_wt2/bin"
    printf '#!/bin/sh\necho "quiet, nothing active"\n' > "$_wt2/bin/wpctl-quiet"; chmod +x "$_wt2/bin/wpctl-quiet"
    printf '#!/bin/sh\necho "       92. Firefox\\n             79. output_FR       > Bose Revolve SoundLink:playback_FR\\t[active]\\n"\n' > "$_wt2/bin/wpctl-playing"; chmod +x "$_wt2/bin/wpctl-playing"
    # MESH is sandboxed at $_wt2 for these two calls: _wake_should_mint now also reads
    # $MESH/mesh-speaking, and this leg must assert the BOSE axis regardless of whether the live
    # mesh happens to be speaking when the hourly doctor --test fires.
    MESH="$_wt2" MESH_OVERHEAR_WPCTL_CMD="$_wt2/bin/wpctl-quiet"   _wake_should_mint "Миша, на связи" \
      || { echo "smoke-test: FAIL (wake_should_mint: strict hit + quiet Bose must mint)"; exit 1; }
    if MESH="$_wt2" MESH_OVERHEAR_WPCTL_CMD="$_wt2/bin/wpctl-playing" _wake_should_mint "Миша Квыан-Кэвс"; then
      echo "smoke-test: FAIL (wake_should_mint: strict hit while Bose plays foreign audio must NOT mint)"; exit 1
    fi
    rm -rf "$_wt2"
    echo "  wake-confirm bose gate ok (quiet Bose -> mint; foreign Bose playback -> withhold mint)"
    # occupancy tag (discover/overhear-occupancy-tag): speech transcript gets a HUMAN-vs-MEDIA hint
    # from mesh-room-trace's verdict. Assert the verdict→[speech:*] mapping (no live room-trace needed).
    [ "$(runpy occ_tag OCCUPIED)" = "[speech:HUMAN]" ]     || { echo "smoke-test: FAIL (occ_tag OCCUPIED → $(runpy occ_tag OCCUPIED), want [speech:HUMAN])"; exit 1; }
    [ "$(runpy occ_tag VACANT)"   = "[speech:MEDIA?]" ]    || { echo "smoke-test: FAIL (occ_tag VACANT → $(runpy occ_tag VACANT), want [speech:MEDIA?])"; exit 1; }
    [ "$(runpy occ_tag RECENT)"   = "[speech:UNCERTAIN]" ] || { echo "smoke-test: FAIL (occ_tag RECENT → $(runpy occ_tag RECENT), want [speech:UNCERTAIN])"; exit 1; }
    [ "$(runpy occ_tag UNKNOWN)"  = "[speech:UNCERTAIN]" ] || { echo "smoke-test: FAIL (occ_tag UNKNOWN → $(runpy occ_tag UNKNOWN), want [speech:UNCERTAIN])"; exit 1; }
    echo "  occupancy tag mapping ok (OCCUPIED→HUMAN, VACANT→MEDIA?, RECENT/UNKNOWN→UNCERTAIN)"
    # Bose foreign-playback detector (chat-review 2026-07-07: a YouTube video playing in Firefox on the
