elif mode=="has_known_voice":
    # VOICE-PRINT gate (operator 2026-07-04): check the recent buffer for a KNOWN voice (speaker
    # verification via resemblyzer). Prints "name score" + exits 0 if matched; "NO_MATCH score" + exit 1
    # if not. Fail-open: no prints enrolled → exit 0 (let the caller proceed with the old classifier path).
    secs=int(sys.argv[2]) if len(sys.argv)>2 else 150
    paths=buffer_wavs(secs)
    if not paths:
        print("NO_MATCH 0.00 (empty buffer)"); sys.exit(1)
    prints=voice_prints()
    if not prints:
        print("NO_MATCH 0.00 (no voice prints — fail-open)"); sys.exit(0)  # fail-open: no enrollment
    best_name,best_score=None,0.0
    for p in paths:
        name,score=voice_match(p)
        if name and score>best_score:
            best_name,best_score=name,score
    if best_name:
        print("%s %.2f"%(best_name,best_score)); sys.exit(0)
    print("NO_MATCH %.2f"%best_score); sys.exit(1)

