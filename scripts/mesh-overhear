      || { echo "smoke-test: FAIL (say_verify: empty heard must report SILENT)"; exit 1; }
    [ "$(OH_SAY_VERIFY_LOG="$_svlog" runpy say_verify "привет как дела" "музыка" 0)" = SILENT ] \
      || { echo "smoke-test: FAIL (say_verify: a HALLU-keyword heard must report SILENT, not a false OK)"; exit 1; }
