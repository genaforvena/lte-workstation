    { [ "$_prc" -ne 124 ] && [ -s "$_tts" ]; } || { echo "smoke-test: FAIL (piper render timed out/empty wav, rc=$_prc)"; rm -f "$_tts"; exit 1; }
    rm -f "$_tts"
    # offload-fail fallback (operator 2026-07-04, "main запускается периодически, 50% CPU"): a stuck/
