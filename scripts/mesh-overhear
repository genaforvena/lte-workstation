#!/usr/bin/env bash
# mesh-overhear — ambient "third party" reflex: keep a rolling TEXT transcript of the last ~15 min of
# room conversation; on a thumbs-up, analyze it and speak a comment from the side. No minds, no cloud
# except the LLM step. Lives on a node with a mic + speaker (default-string: webcam mic + Bose).
#
# Operator's design (2026-06-20): live back-and-forth is too slow, so DON'T converse — overhear. The
# mic listens continuously; each spoken utterance is transcribed (whisper.cpp, local) and appended to a
# rolling transcript that auto-prunes to OH_KEEP_MIN minutes (text only — nothing audio is kept, nothing
# is permanent). A thumbs-up means "weigh in": take the last ~15 min, think (mesh-relay), and speak a
# short observation on the Bose. Latency is fine here — it's after-the-fact commentary, not a dialogue.
# Operator consented to home recording; the rolling text is the only retained artifact and it decays.
#
#   mesh-overhear --daemon        continuous listen → transcribe → append to the rolling transcript
#   mesh-overhear --comment       analyze the last OH_KEEP_MIN min and SPEAK a third-party comment
#   mesh-overhear --ingest W T    (internal) transcribe wav W stamped epoch T, append + prune
#   mesh-overhear --show          print the LAST-computed transcript + a freshness header (cheap, no STT)
#   mesh-overhear --hear          re-transcribe the recent ~OH_HEAR_SECS, then print it LIVE (what mesh-room read uses)
#   mesh-overhear --has-speech N  CHEAP wav verdict (no whisper): silence|sound|speech-like; exit 0 only if speech-like
#   mesh-overhear --watch-speech  RETIRED-by-default (RMS-only → music false-pokes the mind ~every 2min). Superseded by
#                                 --watch-voice (resemblyzer PRIMARY). Bare call exits; ROOM_WATCH_SPEECH_ENABLE=1 to force.
#   mesh-overhear --watch-wake    WAKE-WORD trigger: wake the room mind "Миша" ONLY when called by name (operator's 2nd, room-specific voice channel)
#                                 two-tier: loose ROOM_WAKE_RE pokes the mind; strict ROOM_WAKE_STRICT_RE (name stem only)
#                                 gates the wake-confirmed marker + --ack, so a TV/garble false-loose-hit can't arm the bypass
#   mesh-overhear --test          stack check + render a phrase (no mic, no relay)
#
# Occupancy tag (discover/overhear-occupancy-tag, 2026-07-02): a real-speech transcript line is prefixed
# with a HUMAN-vs-MEDIA hint read from mesh-room-trace — [speech:HUMAN] (OCCUPIED), [speech:MEDIA?]
# (VACANT+speech = likely TV/radio to an empty room), [speech:UNCERTAIN] (RECENT/UNKNOWN/unreachable). It is
# ADDITIVE and fail-open (no verdict → line unchanged) and NEVER a hard override — someone the room sensors
# missed could still be present. Override the organ via MESH_OVERHEAR_ROOMTRACE_CMD (default mesh-room-trace).
#
# Silence switch: while ~/.mesh/room-voice-off exists, the channel emits ZERO sound (pwplay no-ops) — gates
# EVERY path incl. the mind-independent poke ack. Remove the file to re-enable voice.
#
# Tunables (env): OH_KEEP_MIN=15 · OH_HEAR_SECS=150 · OH_LOG=~/.mesh/overheard.log · OH_LANG=auto
#   OH_DIAG_LOG=~/.mesh/overhear-diag.log — the DURABLE diagnostic tape ([claim-order], STT
#   fallbacks/cooldowns). Deliberately NOT OH_LOG: OH_LOG is the rolling transcript window, and its
#   reader (prune_and_read) rewrites the file keeping only lines that parse as `epoch<TAB>tag<TAB>text`
#   — so every untabbed diagnostic note written there was DELETED by the next `--comment`, i.e. the
#   witness for a once-per-boot event could not survive to be read. Capped at OH_DIAG_KEEP lines.
#   VAD: OH_START_RMS=600 OH_SIL_RMS=300 OH_END_SIL=0.9 OH_MAX_UTT=18 OH_MIN_UTT=0.4
#   stack: OH_WHISPER=~/.mesh/whispercpp/main OH_MODEL=~/.mesh/whispercpp/models/ggml-base.bin
#          OH_PIPER=~/.mesh/piper/piper/piper OH_PIPERLIB=~/.mesh/piper/piper OH_VOICE=~/.mesh/piper/voices/ruslan.onnx
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"   # /usr/bin first: never a snap-confined pw-*/curl
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire (mic + Bose sink)
MESH="${MESH_DIR:-$HOME/.mesh}"

# Source node-local config (operator 2026-07-04: OH_STT_GROQ=1 lives in ~/.mesh/nodes but bash -lc from
# mesh-room's ssh hop is a non-interactive login shell that never sources it → Groq silently never engaged,
# fell back to SSH-offload+local whisper. nodes is the canonical per-node env, so source it HERE.)
[ -f "$MESH/nodes" ] && . "$MESH/nodes"

# --- INTERPRETER BINDING (chat-review/overhear-classifier-numpy-dead-under-forced-system-python) -----
# The local audio classifier (_frame_features → `import numpy`) died ModuleNotFoundError on EVERY call
# since the room moved to mesh-home 2026-07-14T23:40 — so mesh-voice-count wrote 'count=0
# verdict=unknown' 99/99 cron runs, the ONLY verdict its log has ever held. A missing module and a
# genuinely quiet room rendered IDENTICALLY, and the innocent rendering won.
#
# PATH CANNOT FIX IT, and that is the part worth remembering: :40 pins /usr/bin FIRST for a real reason
# (never a snap-confined pw-*/curl) — that pin is correct and stays. But `python3` rode the same PATH,
# so it was pinned to the system interpreter too, and NO PATH-based venv could ever reach it (health
# proved it: prepending the grain venv changed nothing, same traceback). The interpreter must be bound
# EXPLICITLY, exactly as the two siblings that already work do (mesh-soundscape:37, mesh-room-music:32 —
# the latter fixed TODAY, f51e36d, for this same dep). numpy is NOT missing from this node; it is
# installed three times over. This was never a missing capability — it is a resolution bug.
#
# NOTE the name: $PY is already taken here for the GENERATED script path (`python3 "$PY"` at the runpy
# tail), so the interpreter is $OH_PY. Operator-overridable; verified 2026-07-15 that the grain venv is
# python 3.12 with numpy 2.4.6 AND audioop — the latter matters, since the generated script imports
# audioop, which is REMOVED in 3.13: a venv on 3.13+ would trade this bug for a fresh one.
GRAIN_DIR="${MESH_GRAIN_DIR:-${GRAIN_DIR:-$HOME/grainneukeln}}"
OH_PY="${OH_PY:-$GRAIN_DIR/.venv/bin/python}"
OH_PY_DEGRADED=0
if [ ! -x "$OH_PY" ]; then
  # RARE AND LOUD (the '|| echo 500' doctrine): falling back to a numpy-less interpreter is exactly how
  # this lane died silently for a day. If a default is indistinguishable from success, it will be one —
  # so this one announces itself on stderr and marks the degrade for the classifier to refuse on.
  OH_PY_DEGRADED=1
  OH_PY="$(command -v python3 2>/dev/null || echo python3)"
  echo "mesh-overhear: WARNING — grainneukeln venv python not found at ${GRAIN_DIR}/.venv/bin/python; falling back to system '$OH_PY'. The LOCAL audio classifier needs numpy and will refuse rather than render a false 'unknown' verdict. Set OH_PY=<python-with-numpy> or create the venv." >&2
fi

# STT-offload default (operator 2026-07-04: "он и так греется" — heavy whisper must never run ON the
# mic/Bose room box). A bare `export OH_STT_NODE=...` in ~/.bashrc never reaches this script — bash -lc
# from mesh-room's ssh hop is a non-interactive login shell, and stock .bashrc `case $- in *i*) return`
# skips everything below it before an appended export is ever read (verified empty live, 2026-07-04).
# So default it HERE, gated on actually being the room node — never on the strong node itself (which
# would just ssh to itself for nothing). Mirrors the hardcoded-IP-default convention ROOM_NODE already
# uses throughout this genome; override with OH_STT_NODE= to force local (e.g. IdeaPad under load).
# Key on HOSTNAME, not a hardcoded tailnet IP (2026-07-08): IPs drift (DHCP/tailnet re-key)
# and a literal 100.x here is a topology leak flagged by mesh-doctor. The room node's hostname
# (default-string) is its stable identity. Offload target is overridable via OH_STT_OFFLOAD_TO
# for a node whose mind node isn't the IdeaPad.
_stt_offload_default() {
  case "$(hostname)" in
    *[Dd]efault-string*) echo "${OH_STT_OFFLOAD_TO:-imozerov@100.73.170.56}" ;;  # room node -> offload to the mind node
  esac
}
export OH_STT_NODE="${OH_STT_NODE-$(_stt_offload_default)}"
# Groq Cloud STT (operator 2026-07-04: offload to Groq Whisper API instead of local/SSH — zero CPU on ds)
export OH_STT_GROQ="${OH_STT_GROQ:-0}"
export VOICE_PRINT_THRESH="${VOICE_PRINT_THRESH:-0.75}"

export OH_KEEP_MIN="${OH_KEEP_MIN:-10}"   # operator 2026-06-20: ~10-min rolling window
export OH_LOG="${OH_LOG:-$MESH/overheard.log}"
# Durable diagnostic tape — separate from the rolling transcript on purpose (see the header note).
export OH_DIAG_LOG="${OH_DIAG_LOG:-$MESH/overhear-diag.log}"
export OH_DIAG_KEEP="${OH_DIAG_KEEP:-2000}"
# operator 2026-07-04: default ru, not auto. Auto-detect hallucinated Spanish/Polish off TV audio
# ("Gracias. Gracias. Pusa. Pugula."). The room is ru+en only; ru-first is the right default. Override
# OH_LANG=en for English; the Groq API gets language=ru/en passed explicitly (see transcribe_groq).
export OH_LANG="${OH_LANG:-ru}"
# operator 2026-07-05: lowered thresholds (600→400, 300→200) — softer speech (Rozalia across the room)
# was being missed by the VAD. With Groq there's no CPU cost to processing more audio.
export OH_START_RMS="${OH_START_RMS:-400}"
export OH_SIL_RMS="${OH_SIL_RMS:-200}"
export OH_END_SIL="${OH_END_SIL:-0.9}"
export OH_MAX_UTT="${OH_MAX_UTT:-18}"
export OH_MIN_UTT="${OH_MIN_UTT:-0.4}"
export OH_FRAME_MS="${OH_FRAME_MS:-200}"
# Default through mesh-whisper-run (nice+ionice+flock shim — serializes whisper runs so two
# utterance bursts can't stack 2×1.9GB RSS; the 2026-07-05 20:45-20:54Z swap pressure was overhear's
# large-v3-turbo racing a second overhear base-model run). Raw binary where the shim isn't deployed.
_wshim="$HOME/.local/bin/mesh-whisper-run"
[ -x "$_wshim" ] || _wshim="$MESH/whispercpp/main"
export OH_WHISPER="${OH_WHISPER:-$_wshim}"
# pick the BEST installed model — large-v3-turbo gives the clean text the voice-note pipeline already
# gets (operator 2026-06-20: "use the same recognizer"). Falls back down the ladder on a leaner node.
_pick_model() {
  local m; for m in ggml-large-v3-turbo ggml-large-v3 ggml-large ggml-medium ggml-small ggml-base; do
    [ -f "$MESH/whispercpp/models/$m.bin" ] && { echo "$MESH/whispercpp/models/$m.bin"; return; }
  done; echo "$MESH/whispercpp/models/ggml-base.bin"
}
export OH_MODEL="${OH_MODEL:-$(_pick_model)}"
export OH_PIPER="${OH_PIPER:-$MESH/piper/piper/piper}"
export OH_PIPERLIB="${OH_PIPERLIB:-$MESH/piper/piper}"
export OH_VOICE="${OH_VOICE:-$MESH/piper/voices/ruslan.onnx}"

# WAKE-WORD tiering (chat-review/wake-confirm-mint-too-loose, 2026-07-05): the loose garble-tolerant
# net (ROOM_WAKE_RE, matched by wake_hit) is right for the POKE — a false poke just costs a few seconds
# of cooldown. It is too loose to arm the misha-gate bypass: plain Russian words like "между"/"бежит"
# contain the "меж"/"беж" garble-family substrings and would silently mint a wake-confirmed marker +
# speak an --ack for a TV/ambient word, not a real by-name call. wake_confirm_hit() is a SEPARATE,
# strict name-stem-only check that gates ONLY the marker mint + --ack; the poke path is untouched.
# Both live as shared functions (not inlined per-callsite) so --watch-wake and --test can never drift
# apart — the exact "test checks a duplicate, not the real code" failure mode found/fixed in
# mesh-dispatch's slugof() this session.
ROOM_WAKE_RE="${ROOM_WAKE_RE:-миш|меша|мыш|миж|меж|беж|misha|mish}"
ROOM_WAKE_STRICT_RE="${ROOM_WAKE_STRICT_RE:-миш|misha}"
wake_hit()         { printf '%s' "$1" | grep -qiE "$ROOM_WAKE_RE"; }
wake_confirm_hit() { printf '%s' "$1" | grep -qiE "$ROOM_WAKE_STRICT_RE"; }

# Bose foreign-playback gate on the wake-confirm MINT (chat-review 2026-07-07, live: a Russian news
# broadcast introducing an economist ("Миша Квыан-Кэвс...") minted a wake-confirmed marker off a garbled
# name inside the broadcast — wake_confirm_hit alone can't tell "Миша" spoken BY the operator from "Миша"
# spoken IN a video/radio segment playing on our own Bose. Bose IS the source in that case (Firefox
# streaming, confirmed live via wpctl) — gate the marker+ack on it, not the poke (a genuine call during
# noisy media should still surface for a human/mind check, just not auto-arm the strong bypass).
_bose_foreign_now() { local cmd="${MESH_OVERHEAR_WPCTL_CMD:-wpctl status}"; $cmd 2>/dev/null | grep -qE 'Bose Revolve SoundLink:playback_F[LR][[:space:]]*\[active\]'; }
# Effector-agnostic self-emission veto (lit-4e 2026-07-23): _bose_foreign_now sees only the Bose
# pipewire sink, but the mesh also speaks in-room OFF that sink — mesh-note3-say (adb speaker) and
# clone voice — and every speech organ already holds $MESH/mesh-speaking (the same mark
# capture_utterance drains on). A race-leaked chunk of our OWN voice reaching the transcript could
# otherwise mint a wake off the mesh saying its own name. Reads the mark's TWO live formats:
# a deadline epoch (mesh-note3-say — veto only until the epoch) or an empty touch-style flag
# (mesh-voice-tx — veto only while mtime-fresh). Staleness fails OPEN: a flag leaked by a killed
# writer must never leave the mint permanently deaf (deafness is never the safe default).
_self_emitting_now() {
  local f="$MESH/mesh-speaking" d now m
  [ -f "$f" ] || return 1
  now=$(date +%s)
  d="$(cat "$f" 2>/dev/null)"
  case "$d" in
    (''|*[!0-9]*)
      m=$(stat -c %Y "$f" 2>/dev/null) || return 1
      [ $(( now - m )) -le "${MESH_SELF_EMIT_STALE:-300}" ] ;;
    (*) [ "$now" -lt "$d" ] ;;
  esac
}
_wake_should_mint() { wake_confirm_hit "$1" && ! _bose_foreign_now && ! _self_emitting_now; }

# wake-confirmed TTL — SHARED (was local to --watch-wake before that loop was retired; the mint now
# happens on the live transcript path, so the TTL must live where both the minter and --test see it).
WAKE_CONFIRM_TTL="${ROOM_WAKE_CONFIRM_TTL:-180}"
# _mint_wake_confirmed <heard-text> — arm mesh-room's misha-gate bypass IFF this is a real by-name call.
# THE MINT LIVES HERE, THE DETECTION LIVES IN THE CALLER (mesh-room-reflex, the only live name-detector
# since --watch-wake was retired): the caller supplies the heard line, this applies the two guards that
# were built + tested for the old watcher (strict name stem, and NOT our own Bose playing a "Миша" from
# a broadcast) so there is exactly ONE definition of "may arm the bypass" — never a second copy that
# drifts. Silent no-op when the guards refuse; a refusal is the normal case, not an error.
_mint_wake_confirmed() {
  _wake_should_mint "$1" || return 1
  echo "$(( $(date +%s) + WAKE_CONFIRM_TTL ))" > "$MESH/.room-wake-confirmed"
}

# _room_wake_plain_wordcount <text> -> count of "real" (non-filler) word tokens. Same filter
# --watch-wake already used inline to decide whether a fast-STT miss is worth a quality
# re-transcribe; factored out here so the mesh-tell corroboration gate below (and --test) can
# never drift from the real per-chunk decision.
#
# PYTHON, NOT tr/case (found during roomwake-loose-poke-realcost, 2026-07-10): the original inline
# version used `tr "[:upper:]" "[:lower:]"` and `tr -cs "[:alpha:]" " "` to lowercase/split words —
# both are byte-wise in this glibc/coreutils tr and silently produce EMPTY output on Cyrillic text
# even under a UTF-8 locale (verified live: `echo между | tr -cs "[:alpha:]" " "` -> nothing). nw
# was therefore ALWAYS 0 for real Russian speech — the quality-retranscribe trigger below has
# apparently never fired for genuine Cyrillic content since it was written, and a corroboration
# gate built on it would be a silent no-op for exactly the TV-dialogue case it exists to catch.
# python3's `re` module is Unicode-aware by default (already a hard dependency elsewhere in this
# file, e.g. classify()), so it is used here instead of shelling out to tr/sed for casing/splitting.
_room_wake_plain_wordcount() {
  python3 -c "
import re, sys
txt = sys.argv[1]
txt = re.sub(r'\[[^\]]*\]', '', txt)
txt = re.sub(r'\([^)]*\)', '', txt)
txt = txt.lower()
filler = {'музыка','аплодисменты','смех','тишина','шум','субтитры','интригующая','тревожная',
          'спокойная','весёлая','грустная','динамичная','напряжённая','редактор','корректор'}
words = re.findall(r'[^\W\d_]+', txt, re.UNICODE)
print(sum(1 for w in words if len(w) >= 2 and w not in filler))
" "$1"
}

# _room_wake_should_tell <text> -> rc0 fires the live mesh-tell poke (a real LLM turn), rc1 means
# cooldown-only (chat-review/roomwake-loose-poke-realcost, 2026-07-10). Root cause: ROOM_WAKE_RE
# is a deliberately loose garble-family net (line above) so a plain word like "между"/"бежит"
# matches it as readily as a real "Миша" call — that's fine for the POKE cooldown (a few seconds,
# per the comment above) but NOT fine for a live mesh-tell, which is a full paid LLM turn. A
# STRICT name-stem hit always fires (a real by-name call must never be silently dropped). A
# LOOSE-only hit only fires when the utterance is SHORT (few real words) — consistent with someone
# actually saying a name/short call, not a TV/ambient sentence that happens to contain the
# substring. ROOM_WAKE_TELL_NW_MAX is that threshold; default 3 (an address is a few words, TV
# dialogue lines run longer).
ROOM_WAKE_TELL_NW_MAX="${ROOM_WAKE_TELL_NW_MAX:-3}"
_room_wake_should_tell() {
  local txt="$1"
  wake_confirm_hit "$txt" && return 0
  local nw; nw="$(_room_wake_plain_wordcount "$txt")"
  [ "$nw" -le "$ROOM_WAKE_TELL_NW_MAX" ]
}

# ---- shared python helpers (transcribe / speak / VAD), selected by argv[1] --------------------------
runpy() {  # <mode> [args...]
  local PY; PY="$(mktemp "${TMPDIR:-/tmp}"/overhear-XXXXXX.py)"; trap 'rm -f "$PY"' RETURN
  cat > "$PY" <<'PYEOF'
import os, sys, time, wave, audioop, subprocess, re

KEEP=int(os.environ.get("OH_KEEP_MIN","15"))*60
LOGF=os.environ["OH_LOG"]; LANG=os.environ.get("OH_LANG","ru")  # ru-first (operator 2026-07-04)
WHISPER=os.environ["OH_WHISPER"]; MODEL=os.environ["OH_MODEL"]
PIPER=os.environ["OH_PIPER"]; PIPERLIB=os.environ["OH_PIPERLIB"]; VOICE=os.environ["OH_VOICE"]
RATE=16000; FRAME_MS=int(os.environ.get("OH_FRAME_MS","200"))
FBYTES=int(RATE*FRAME_MS/1000)*2; FSEC=FRAME_MS/1000.0
START_RMS=int(os.environ.get("OH_START_RMS","600")); SIL_RMS=int(os.environ.get("OH_SIL_RMS","300"))
END_SIL=float(os.environ.get("OH_END_SIL","0.9")); MAX_UTT=float(os.environ.get("OH_MAX_UTT","18"))
MIN_UTT=float(os.environ.get("OH_MIN_UTT","0.4"))

# ON-DEMAND model (operator 2026-06-20): a rolling AUDIO buffer; transcription happens only at a trigger,
# so what Claude hears is always in sync with reality (no lagging continuous STT). Window ~7 min.
BUFFER_DIR=os.path.join(os.path.dirname(LOGF),"audio-buffer")
BUFFER_MIN=int(os.environ.get("OH_BUFFER_MIN","10"))*60  # 10-min rolling audio window (operator 2026-07-05)
HEAR_SECS=int(os.environ.get("OH_HEAR_SECS","300"))   # 5-min live window — Groq handles it with zero ds CPU (operator 2026-07-04)
TRANSCRIPT_FILE=os.path.join(os.path.dirname(LOGF),"room-transcript.txt")
MUTE_FLAG=os.path.join(os.path.dirname(LOGF),"mesh-speaking")  # set while the mesh speaks → don't self-hear
VOICE_OFF=os.path.join(os.path.dirname(LOGF),"room-voice-off")  # operator silence switch: while this file exists, the channel emits ZERO sound to the Bose (gates ALL paths — ack, comment, mind speech). Re-enable = remove it.

# DIAGNOSTIC TAPE — durable, and NOT the transcript window. Every note below ([claim-order], the STT
# fallbacks, the Groq cooldown) used to append to LOGF in an untabbed `HH:MM:SS  [tag] msg` form while
# LOGF's only reader (prune_and_read) rewrites the file keeping ONLY `epoch<TAB>tag<TAB>text` lines —
# so the first `--comment` after a note DELETED it. The claim-order note is the sharp case: it fires
# once, at boot, to say whether the session manager took the card before the ear did; the fix it
# witnesses (_await_sm_claim) has never yet run under the race it exists for, and its evidence was
# being erased before anyone could read it. Timestamps are ISO-8601 with a DATE — a bare HH:MM:SS
# renders every age modulo 24h, so a week-old note reads as minutes old.
DIAGF=os.environ.get("OH_DIAG_LOG") or os.path.join(os.path.dirname(LOGF),"overhear-diag.log")
DIAG_KEEP=int(os.environ.get("OH_DIAG_KEEP","2000"))
def _diag(tag,msg):
    try:
        with open(DIAGF,"a") as f:
            f.write("%s\t[%s]\t%s\n"%(time.strftime("%Y-%m-%dT%H:%M:%S"),tag," ".join(str(msg).split())))
    except Exception: return
    try:                                    # cap by lines, oldest first; never by wiping the file
        with open(DIAGF) as f: lines=f.readlines()
        if len(lines)>DIAG_KEEP*2:
            with open(DIAGF,"w") as f: f.writelines(lines[-DIAG_KEEP:])
    except Exception: pass

# ---- RESEMBLANCE LEDGER (literature 2026-08-19: BIOMETRIC APPROXIMATION) ----------------------------
# Eneman et al. 2025 (Surveillance & Society 23(4): 498-504), revisiting Haggerty & Ericson's
# Deleuzian "surveillant assemblage" at 25: "A match does not confirm who someone is, but rather how
# closely their facial data resembles a reference image"; systems "operate through probabilistic
# thresholds, treating resemblance as actionable risk. Identity, suspicion, and intervention thus
# become collapsed into automated inference." Their question is ours: "Who determines what degrees of
# resemblance warrant intervention?"
#
# The room ear was exactly that collapse. --watch-voice, the PRIMARY room trigger, called
# `--has-known-voice ... >/dev/null 2>&1` and kept ONLY the exit code: the cosine score, WHICH enrolled
# name it resembled, and the threshold in force were destroyed at the instant they authorised an act
# (poke the mind -> a paid turn -> a spoken reply into the room). A known false match is already on the
# record -- music vocals passed the voice print and poked the mind three times on the word "Vremya"
# (see --poke-mind) -- and to this day there is NO score for it, so the threshold cannot be calibrated
# against the thing it actually faces. That is the mesh's own rule about calibrating a derived axis
# against the REAL corpus, unmet on the one axis that spends turns.
#
# This tape keeps the approximation BESIDE the act: one row per evaluation, score + threshold + name +
# decision, so a verdict can be re-adjudicated later and the 0.75 constant can be answered with a
# number. FAIL_OPEN is a DECISION OF ITS OWN: it exits 0 and lets the poke through exactly like MATCH,
# but carries zero evidence -- collapsed into one bit, an evidence-free intervention is unreadable
# from an evidenced one. Own file, env-overridable: --test must never write the tape a human reads
# (mesh-test-forgery), and this is NOT a liveness artifact -- mtime here means evaluations happened.
VMLOG=os.environ.get("OH_VOICE_MATCH_LOG") or os.path.join(os.path.dirname(LOGF),"voice-match.log")
VM_KEEP=int(os.environ.get("OH_VOICE_MATCH_KEEP","4000"))
VM_BAND=float(os.environ.get("OH_VOICE_MATCH_BAND","0.05"))
def voice_thresh():
    return float(os.environ.get("VOICE_PRINT_THRESH","0.75"))
def _voice_match_log(decision,name,score,thresh,secs,nchunks):
    if os.environ.get("OH_VOICE_MATCH_OFF")=="1": return
    caller=(os.environ.get("OH_VOICE_CALLER") or "-").strip() or "-"
    try:
        with open(VMLOG,"a") as f:
            f.write("%s\t%s\t%s\t%.4f\t%.4f\t%d\t%d\t%s\n"%(
                time.strftime("%Y-%m-%dT%H:%M:%S"),decision,(name or "-"),
                float(score),float(thresh),int(secs),int(nchunks),caller))
    except Exception: return
    try:                                    # cap by lines, oldest first; never by wiping the file
        with open(VMLOG) as f: lines=f.readlines()
        if len(lines)>VM_KEEP*2:
            with open(VMLOG,"w") as f: f.writelines(lines[-VM_KEEP:])
    except Exception: pass

def voice_match_stats(rows,band=None):
    """THE METRIC. Pure (takes parsed rows) so --test drives it without a live mic.

    The naive number -- "separation between the matched and unmatched populations" -- is VACUOUS
    here: the ledger only ever holds decision-truncated populations (every MATCH is >= thresh and
    every NO_MATCH is < thresh by construction), so their separation is positive no matter how bad
    the threshold is. The honest quantities are the HEADROOMS -- how close the passing population
    comes to being refused, and the refused population to passing -- plus the BOUNDARY FRACTION of
    evaluations landing inside +/-band of the threshold. Both headrooms near zero and a fat boundary
    fraction means the threshold is cutting through ONE continuous blob, i.e. the verdict at the edge
    is a coin flip wearing the vocabulary of recognition.

    Also reported: fail_open (interventions authorised with no evidence at all) and thresholds (>1
    distinct value means the criterion MOVED, so old rows cannot be re-adjudicated against today's)."""
    if band is None: band=VM_BAND
    st={"n":len(rows),"by_decision":{},"matched":[],"refused":[],"thresholds":set(),"by_name":{},"band":band}
    for r in rows:
        d=r["decision"]; st["by_decision"][d]=st["by_decision"].get(d,0)+1
        if d in ("MATCH","NO_MATCH"):
            st["thresholds"].add(round(r["thresh"],4))
            (st["matched"] if d=="MATCH" else st["refused"]).append(r["score"])
            if d=="MATCH": st["by_name"][r["name"]]=st["by_name"].get(r["name"],0)+1
    m,u=sorted(st["matched"]),sorted(st["refused"])
    st["measured"]=len(m)+len(u)
    st["thresholds"]=sorted(st["thresholds"])
    th=st["thresholds"][-1] if st["thresholds"] else voice_thresh()
    st["thresh"]=th
    st["thresh_drifted"]=len(st["thresholds"])>1
    st["fail_open"]=st["by_decision"].get("FAIL_OPEN",0)
    # headroom: min passing score above the line / max refused score below it. None when the
    # population is empty -- an absent population is not a comfortable margin.
    st["headroom_pass"]=(m[0]-th) if m else None
    st["headroom_refuse"]=(th-u[-1]) if u else None
    st["boundary"]=sum(1 for x in m+u if abs(x-th)<=band)
    st["boundary_frac"]=(st["boundary"]/float(st["measured"])) if st["measured"] else None
    st["never_refused"]=(st["measured"]>0 and not u)   # a gate never seen to fail is not a gate
    st["never_passed"]=(st["measured"]>0 and not m)    # the ear fired for nobody -- deaf, not quiet
    return st

def voice_match_rows(path=None,limit=None):
    rows=[]
    try:
        with open(path or VMLOG) as f: lines=f.readlines()
    except Exception: return rows
    if limit: lines=lines[-limit:]
    for ln in lines:
        p=ln.rstrip("\n").split("\t")
        if len(p)<8: continue
        try: rows.append({"ts":p[0],"decision":p[1],"name":p[2],"score":float(p[3]),
                          "thresh":float(p[4]),"secs":int(p[5]),"chunks":int(p[6]),"caller":p[7]})
        except ValueError: continue
    return rows

_CLAIM_WAITED=[False]
def _card_of(dev):
    # "plughw:1,0" / "hw:1" → 1 ; a CARD=<name> form is not a number → no gate (None)
    try: return int(dev.split(":",1)[1].split(",")[0])
    except Exception: return None
def _control_held(card):
    """True when SOME process holds /dev/snd/controlC<card> — that is the session manager's claim.
    Dependency-free (no fuser/lsof): scan our own uid's /proc/*/fd links."""
    want="/dev/snd/controlC%d"%card
    for pid in os.listdir("/proc"):
        if not pid.isdigit(): continue
        d="/proc/%s/fd"%pid
        try: fds=os.listdir(d)
        except OSError: continue
        for fd in fds:
            try:
                if os.readlink(os.path.join(d,fd))==want: return True
            except OSError: continue
    return False
def _await_sm_claim(dev):
    """CLAIM ORDER (2026-08-14, task alc897-sink-claim-gap). A raw `arecord -D plughw:1,0` and
    wireplumber RACE at boot. On 2026-08-14 arecord won by 3s (12:40:13 vs 12:40:16) and wireplumber
    then skipped card 1 ENTIRELY — not just its capture: no sink, no source, no Device row at all, so
    `Default Sink: auto_null` and every local playback path (mesh-say / mesh-voice-say /
    mesh-room-music) wrote into a null sink and returned rc=0. rc=0 into /dev/null is
    indistinguishable from a speaker — the silent-fallback shape at the OUTPUT end.

    MEASURED, and it is what picks the claim order: exclusion is NOT required. Stop the ear, restart
    wireplumber, start the ear again → wireplumber holds controlC1 AND arecord holds pcmC1D0c, both
    happily. The control node and the capture PCM are different claims. So the session manager takes
    the card FIRST and the ear takes its PCM after; overhear keeps raw ALSA (option B's capture
    path) while the node still gets a managed output (option A's win). Neither tool has to yield.

    systemd `After=wireplumber.service` does NOT express this — it is satisfied the moment the unit
    starts, while the ALSA monitor probes cards asynchronously seconds later. Ordering by unit start
    is not ordering by card claim.

    BOUNDED and NON-FATAL. An unclaimed card must never cost the room its ear: we wait, we say why,
    and we capture anyway. Waiting forever would trade a silent mouth for a deaf node."""
    def _note(msg): _diag("claim-order",msg)
    # EVERY exit path leaves a note, including the zero-wait and the skipped ones. A gate that records
    # only its interesting branch is indistinguishable from a gate that never ran — and this one runs
    # once per boot, so a missing line is the only thing a reader would ever have to go on.
    if _CLAIM_WAITED[0]: return
    _CLAIM_WAITED[0]=True
    card=_card_of(dev)
    if card is None:
        _note("dev %r names no numeric card — no claim gate (this is not a wait of 0s)"%(dev,)); return
    try: budget=float(os.environ.get("OH_CLAIM_WAIT_S","20"))
    except ValueError: budget=20.0
    if budget<=0:
        _note("card %d: gate DISABLED (OH_CLAIM_WAIT_S=%g) — taking the pcm with no wait"%(card,budget)); return
    waited=0.0
    while waited<budget:
        if _control_held(card):
            _note("card %d claimed by the session manager after %.1fs — taking pcm now"%(card,waited))
            return
        time.sleep(0.5); waited+=0.5
    _note("card %d control node UNCLAIMED after %.0fs — taking the pcm anyway (the ear wins over the "
          "mouth), but this node may come up with Default Sink=auto_null; check mesh-audible --why"%(card,budget))

def recorder_argv(dest):
    # Node-configurable capture backend. dest="-" → raw s16le mono 16k on stdout (streamed to the
    # VAD loop); dest=<path> → write a WAV file. The default pw-record goes through the PipeWire
    # graph, which is FRAGILE on a headless node: if wireplumber has no seat it enumerates ZERO alsa
    # cards, pw-record silently falls through to the Dummy Output monitor = DIGITAL SILENCE, and the
    # ear goes deaf while every service stays green (mesh-home 2026-07-17: onboard mic loud -19.9dB
    # via direct arecord, but the graph delivered the null source; overhear buffer 0 chunks / transcript
    # 0B). Set OH_CAPTURE_BACKEND=alsa (+ OH_CAPTURE_DEV, default plughw:1,0) to capture the mic
    # DIRECTLY via arecord, bypassing the graph entirely. arecord raw stdout feeds the same FBYTES loop.
    # OH_RECORDER_CMD (test hook): override the whole argv with a shell-split command — lets --test
    # inject a recorder that fails instantly (no stdout, known stderr) to prove the no-backoff respawn
    # gate WITHOUT a real mic. Never set in production.
    _rc=os.environ.get("OH_RECORDER_CMD")
    if _rc:
        import shlex; return shlex.split(_rc)
    be=os.environ.get("OH_CAPTURE_BACKEND","pw").lower()
    if be=="alsa":
        dev=os.environ.get("OH_CAPTURE_DEV","plughw:1,0")
        _await_sm_claim(dev)   # claim order: the session manager takes the card before we take its PCM
        base=["arecord","-D",dev,"-f","S16_LE","-r","16000","-c","1","-q"]
        return base+["-t","raw"] if dest=="-" else base+[dest]
    base=["pw-record","--rate","16000","--channels","1","--format","s16"]
    return base+["-"] if dest=="-" else base+[dest]
HALLU=("спокойная музыка","продолжение следует","субтитр","[музыка]","[аплодисменты]","музыка",
       "спасибо за просмотр","редактор субтитров","корректор","♪","thank you","тишина","субтитры")
def is_real(text):
    t=text.strip().lower()
    words=t.split()
    if len("".join(words))<4: return False
    for h in HALLU:
        if h in t: return False
    if t in ("you","ну","да","а","э","и"): return False
    # whisper invents repetitive filler on near-silence ("тихо и тихо и тихо…"): one token, many times.
    sig=[w for w in words if len(w)>1]
    if len(words)>=4 and len(set(sig))<=1: return False
    return True

def transcribe_local(wav):
    try:
        th=os.environ.get("OH_WHISPER_THREADS","2")   # cap whisper cores on a hot node
        model=MODEL
        # OH_STT_FAST (wake path, 2026-07-04): the default model ladder picks large-v3-turbo, which on
        # 2 threads takes MINUTES per 18s chunk — the per-chunk wake scanner wedged into a perpetual
        # backlog ("said Misha several times, still no reply"). Wake-stem detection only needs base
        # (verified: base renders «миш» cleanly from voice-over-music). base + 4 threads ≈ real-time.
        if os.environ.get("OH_STT_FAST"):
            fb=os.path.join(os.path.dirname(MODEL),"ggml-base.bin")
            if os.path.exists(fb): model=fb
            th=os.environ.get("OH_WHISPER_THREADS","4")
        # nice 19 (health 2026-07-05 18:33Z): this is the -t6 large-v3-turbo offload target — bursts hit
        # 441-544% CPU and were the real driver of node-health CRITICAL/DEGRADED flaps + the 88-97°C
        # throttle chain. Niceness (not fewer threads) keeps the deliberate 6-core throughput on an idle
        # box while letting minds preempt the burst under contention. NOT SCHED_IDLE (chrt -i): that
        # starves transcription for minutes under sustained mind load — the wake-scanner wedge again.
        out=subprocess.run(["nice","-n",os.environ.get("OH_WHISPER_NICE","19"),WHISPER,"-m",model,"-f",wav,"-l",LANG,"-nt","-t",th],
            capture_output=True,timeout=120).stdout.decode("utf-8","ignore")
        t=" ".join(out.split()).strip()
        # whisper sometimes loops a word on noisy audio ("волочную волочную волочную…") — collapse runs
        t=re.sub(r'(\b\w+\b)( \1\b){2,}', r'\1', t, flags=re.IGNORECASE)
        # strip hallucination tails/inline tags via the canonical filter (single source of truth with
        # mesh-voice-rx): subtitle credits, [музыка]/(silence)/*…*/, and all-caps SDH music tags whisper
        # emits on music/noise ("СПОКОЙНАЯ МУЗЫКА", "ТРЕВОЖНАЯ МУЗЫКА", "ТЕЛЕФОННЫЙ ЗВОНОК") — preserves
        # real speech, drops only the noise. FAIL-OPEN: any error/timeout → return raw text unchanged.
        try:
            _fb=os.environ.get("MESH_WHISPER_FILTER","mesh-whisper-filter")
            _r=subprocess.run([_fb,"--strip","--text",t],capture_output=True,text=True,timeout=5)
            if _r.returncode==0:
                t=_r.stdout.strip()
        except Exception: pass
        return t
    except Exception: return ""

def load_groq_key():
    key_path=os.path.expanduser("~/.mesh/groq.env")
    try:
        with open(key_path) as f:
            for line in f:
                if line.startswith("GROQ_API_KEY="):
                    return line.split("=",1)[1].strip().strip('"').strip("'")
    except Exception: pass
    return None

# Groq STT outcome sentinel (chat-review/groq-stt-blind-error+no-backoff, 2026-07-06): transcribe_groq
# used to read only .get("text") and DISCARD the error body, so a 429 rate-limit (HTTP-200-shaped JSON
# with an 'error' field, NO 'text') was indistinguishable from a genuine empty transcription — logged as
# 'empty' and RE-HIT every single utterance, falling to the SSH→IdeaPad whisper offload each time (the
# 1.9GB main-relaunch swap/[node-hot]/100C storm). _GROQ_ERR carries WHY the last call yielded no text so
# the caller logs the real code (part 1) and stays silent while the rate-limit cooldown holds (part 2).
_GROQ_ERR=None

def _groq_cooldown_file():
    return os.path.join(os.path.dirname(LOGF),"groq-stt-cooldown")

def _groq_cooldown_active():
    # Fresh flag → still cooling (skip Groq). Expired → clear it so the NEXT call probes Groq afresh (a
    # new 429 then opens a NEW episode = exactly one [groq-cooldown] line per rate-limit spell).
    try:
        secs=int(os.environ.get("OH_GROQ_COOLDOWN","300"))
        if time.time()-os.path.getmtime(_groq_cooldown_file()) < secs:
            return True
        os.remove(_groq_cooldown_file())
    except OSError: pass
    return False

def _groq_enter_cooldown(code):
    # Arm the skip-Groq flag AND write the single episode line. Called only on an actual 429 (during the
    # active window _groq_cooldown_active short-circuits BEFORE the curl, so we never re-hit → one line).
    p=_groq_cooldown_file()
    try:
        with open(p,"w") as f: f.write(str(code))
    except OSError: pass
    secs=os.environ.get("OH_GROQ_COOLDOWN","300")
    _diag("groq-cooldown","rate_limit (%s) -> skip Groq %ss, local fallback"%(code,secs))

def _groq_classify(body_str):
    # Single source of truth (live + --test) for reading a Groq STT response. Returns (text, code, is_rate):
    #   success   -> ("<text>", None, False)   text may be "" for a genuine empty transcription
    #   error     -> ("",       "<code>", <bool rate_limit>)   429/rate → is_rate True
    #   unparsable-> ("",       "parse-error", False)
    import json
    try:
        body=json.loads(body_str)
    except Exception:
        return ("","parse-error",False)
    if not isinstance(body,dict):
        return ("","parse-error",False)
    if "text" in body:
        return (str(body.get("text") or "").strip(),None,False)
    err=body.get("error")
    if isinstance(err,dict):
        code=err.get("code") or err.get("type") or "unknown"
    elif err:
        code=str(err)
    else:
        code="unknown"
    code=str(code)
    is_rate=("rate" in code.lower()) or ("429" in code) or (str(body.get("code"))=="429")
    return ("",code,is_rate)

def transcribe_groq(wav):
    import tempfile, json
    global _GROQ_ERR
    _GROQ_ERR=None
    # BACKOFF FIRST (before key/curl): while a rate-limit cooldown is fresh, skip Groq entirely and go
    # straight to the local/offload fallback — no curl, no per-utterance log spam.
    if _groq_cooldown_active():
        _GROQ_ERR="cooldown"; return ""
    key=load_groq_key()
    if not key:
        _GROQ_ERR="no-key"; return ""
    try:
        model=os.environ.get("OH_GROQ_MODEL","whisper-large-v3-turbo")
        # Pass language explicitly (operator 2026-07-04: without it Groq auto-detects and hallucinates
        # Spanish/Polish off TV audio; the room is ru+en only, OH_LANG defaults to ru).
        lang=os.environ.get("OH_LANG","ru")
        with open(wav,"rb") as f:
            audio_data=f.read()
        _, tmp_path=tempfile.mkstemp(suffix=".wav",prefix="groq-stt-")
        try:
            with open(tmp_path,"wb") as f: f.write(audio_data)
            curl_args=[
                "curl","-s","-m","120",
                "https://api.groq.com/openai/v1/audio/transcriptions",
                "-H","Authorization: Bearer "+key,
                "-F","model="+model,
                "-F","file=@"+tmp_path,
                "-F","response_format=json"
            ]
            if lang and lang != "auto":
                curl_args+=["-F","language="+lang]
            proc=subprocess.run(curl_args,capture_output=True,timeout=120,check=True)
            text,code,is_rate=_groq_classify(proc.stdout.decode("utf-8","ignore"))
            if code is None:
                return text            # success (text may be a genuine empty "")
            if is_rate:
                _groq_enter_cooldown(code)     # logs the ONE [groq-cooldown] line + arms the skip flag
                _GROQ_ERR="rate_limit:"+code   # caller stays silent (already logged here)
            else:
                _GROQ_ERR=code                 # caller logs [groq-stt-fail] <code>
            return ""
        finally:
            try: os.remove(tmp_path)
            except OSError: pass
    except Exception as e:
        sys.stderr.write("groq-stt failed: %s\n"%(e,))
        _GROQ_ERR="exception:%s"%e
        return ""

def transcribe(wav):
    # Groq Cloud STT (operator 2026-07-04): zero CPU on ds, all processing on Groq's servers using
    # whisper-large-v3-turbo (the same model we offload to IdeaPad for). Enabled via OH_STT_GROQ=1; bypasses
    # local whisper.cpp AND SSH offload entirely. Falls back to local on failure (same pattern as offload).
    if os.environ.get("OH_STT_GROQ") == "1":
        try:
            t=transcribe_groq(wav)
            if t: return t
            # Distinguish the no-text cases (chat-review/groq-stt-blind-error+no-backoff): a rate-limit
            # ('rate_limit:*') and its cooldown-skip ('cooldown') already logged/handled inside
            # transcribe_groq — stay silent. A missing key ('no-key') is a config state, not a transient —
            # silent too. A real Groq error code → log it verbatim (part 1). A genuine empty transcription
            # (_GROQ_ERR is None) → the old 'empty response' line.
            err=_GROQ_ERR
            if err in (None,):
                _diag("groq-stt-fail","empty response -> local fallback")
            elif not (err=="cooldown" or err=="no-key" or err.startswith("rate_limit")):
                _diag("groq-stt-fail","%s -> local fallback"%(err,))
        except Exception as e:
            _diag("groq-stt-fail","exception: %s -> local fallback"%(e,))
    # offload STT to a stronger node if configured (operator 2026-06-20: keep heavy whisper OFF the hot,
    # freeze-prone default-string — the mic node only captures; a beefier node transcribes with a bigger
    # model → cleaner text). Pipe the wav over ssh; fall back to local if the remote is unreachable.
    node=os.environ.get("OH_STT_NODE","")
    if node:
        # OH_STT_FAST rides the offload too: pin the REMOTE worker to base + 4 threads (the remote's
        # own default ladder picks large-v3-turbo — minutes per chunk, the wake-scanner wedge). The
        # $HOME expands on the remote (bash -lc single-quoted body is still expanded by that bash).
        rcmd="mesh-overhear --stt-stdin"
        if os.environ.get("OH_STT_FAST"):
            rcmd="OH_MODEL=$HOME/.mesh/whispercpp/models/ggml-base.bin OH_WHISPER_THREADS=4 OH_LANG=ru "+rcmd
        elif os.environ.get("OH_STT_QUAL"):
            # quality re-pass (wake 2nd pass): the remote's own ladder model (large-v3-turbo) but on
            # 4 threads — base sometimes garbles the NAME itself under music («Бежно» ← «Миша, на
            # связи», 2026-07-04 02:23) and only the accurate model recovers it. Speech chunks only.
            rcmd="OH_WHISPER_THREADS=4 "+rcmd
        else:
            # PLAIN offload path (--hear/--comment land here): the remote is a multi-core mind node, not
            # the 2-thread-capped hot room box, so give large-v3-turbo real headroom (2026-07-04, measured
            # 96s for a 4s clip at 2 threads under normal mind load — the un-overridden default was
            # silently starving this path). Timeout widened to match: transcribe_buffer feeds up to
            # OH_KEEP_MIN minutes of audio, not the few seconds this was tuned against.
            rcmd="OH_WHISPER_THREADS=6 "+rcmd
        _fail="ok"
        try:
            with open(wav,"rb") as f:
                out=subprocess.run(["ssh","-o","BatchMode=yes","-o","StrictHostKeyChecking=no","-o","ConnectTimeout=8",
                    node,"bash -lc '"+rcmd+"'"],stdin=f,capture_output=True,timeout=240)
            t=out.stdout.decode("utf-8","ignore").strip()
            # comment-shaped lines are never speech: a remote whose deployed copy mismatches the verb
            # dumps the script HEADER to stdout (it contains the wake name «Миша») — trusted as-is it
            # became a false by-name wake (2026-07-05 07:51). Belt to the usage->stderr suspender.
            t="\n".join(l for l in t.splitlines() if not l.lstrip().startswith("#")).strip()
            if t: return t
            _fail="empty stdout (rc=%s, stderr=%s)"%(out.returncode,out.stderr.decode("utf-8","ignore")[:200])
        except Exception as e: _fail="exception: %s"%e
        # OFFLOAD FAILED (operator 2026-07-04: "main запускается периодически, 50% CPU, что это?" — root
        # cause: this fallback used to run transcribe_local()'s full ladder model, i.e. the SAME heavy
        # large-v3-turbo whisper offload exists to AVOID, on every transient ssh hiccup/remote-busy timeout,
        # completely silently. A degraded-but-cheap local pass beats a heavy one on the hot node — force
        # the fast (base-model, few-thread) path instead of the default ladder, and log it so a recurring
        # fallback is visible instead of invisible.
        _diag("stt-offload-fail","%s -> local fast fallback"%(_fail,))
        _prev_fast=os.environ.get("OH_STT_FAST")
        os.environ["OH_STT_FAST"]="1"
        try: return transcribe_local(wav)
        finally:
            if _prev_fast is None: os.environ.pop("OH_STT_FAST",None)
            else: os.environ["OH_STT_FAST"]=_prev_fast
    return transcribe_local(wav)

def buffer_wavs(window_secs):
    # buffered utterance wavs captured within window_secs, oldest→newest (filenames are capture-ms)
    if not os.path.isdir(BUFFER_DIR): return []
    cutoff=time.time()*1000 - window_secs*1000; items=[]
    for fn in os.listdir(BUFFER_DIR):
        if fn.endswith(".wav"):
            try:
                ms=int(fn[:-4])
                if ms>=cutoff: items.append((ms,os.path.join(BUFFER_DIR,fn)))
            except ValueError: pass
    items.sort()
    return [p for _,p in items]

# ---- voice-print filter (operator 2026-07-04: "вычленить фингерпринт моего голоса") ----------------
# Speaker verification via resemblyzer: only transcribe chunks containing a KNOWN voice (operator/
# Rozalia), not TV/music. The audio classifier (RMS + spectral flatness) cannot tell speech from TV —
# it labeled the operator's speech-over-music as "music" and the reflex stayed silent for 2 weeks.
# Voice prints (256-dim embeddings from mesh-voice-print --enroll) live in ~/.mesh/voice-prints/.
VOICE_PRINTS_DIR=os.path.join(os.path.dirname(LOGF),"voice-prints")
_voice_enc=None
def _voice_encoder():
    global _voice_enc
    if _voice_enc is None:
        from resemblyzer import VoiceEncoder
        _voice_enc=VoiceEncoder()
    return _voice_enc

def voice_prints():
    # {name: embedding} from enrolled prints; {} if none or resemblyzer unavailable
    if not os.path.isdir(VOICE_PRINTS_DIR): return {}
    out={}
    for f in os.listdir(VOICE_PRINTS_DIR):
        if f.endswith(".npy"):
            try:
                import numpy as np
                out[f[:-4]]=np.load(os.path.join(VOICE_PRINTS_DIR,f))
            except Exception: pass
    return out

def voice_match(wav_path):
    # Match a wav against enrolled voice prints. Returns (name, score) or (None, 0.0).
    # Fail-OPEN: no prints / no resemblyzer → (None, 0) → caller falls back to transcribe-all.
    prints=voice_prints()
    if not prints: return None, 0.0
    try:
        import numpy as np
        enc=_voice_encoder()
        w=wave.open(wav_path,"rb"); raw=w.readframes(w.getnframes()); w.close()
        arr=np.frombuffer(raw,dtype=np.int16).astype(np.float32)/32768.0
        if len(arr)<16000: return None, 0.0   # <1s → not enough for a stable embedding
        embed=enc.embed_utterance(arr)
        best_name,best=None,0.0
        for name,ref in prints.items():
            sim=float(np.dot(embed,ref))   # both L2-normalized → dot=cosine
            if sim>best: best,best_name=sim,name
        thresh=float(os.environ.get("VOICE_PRINT_THRESH","0.75"))
        if best>=thresh: return best_name,best
        return None,best
    except Exception:
        return None,0.0

def voice_filtered_paths(secs):
    # Buffer wavs within `secs` that match a KNOWN voice print. If no prints enrolled → return ALL
    # (fail-open: the system works without voice prints, just less precisely).
    paths=buffer_wavs(secs)
    prints=voice_prints()
    if not prints: return paths
    matched=[p for p in paths if voice_match(p)[0] is not None]
    return matched

def newest_buffer_age():
    # seconds since the most recent buffered utterance (big number if the buffer is empty)
    ws=buffer_wavs(10**9)
    if not ws: return 10**9
    try: return time.time()-int(os.path.basename(ws[-1])[:-4])/1000.0
    except ValueError: return 10**9

def fmt_age(s):
    # shared by show/hear and dash — one staleness vocabulary so both surfaces read the same way.
    s=int(s)
    if s<20: return "just now"
    if s<90: return "%ds ago"%s
    if s<3600: return "%dm ago"%(s//60)
    return "%dh%02dm ago"%(s//3600,(s%3600)//60)

def concat_wavs(paths, out, gap_secs=0.0):
    # Concatenate wav paths into one file. If gap_secs>0, insert silence between chunks so the STT
    # sees clean utterance boundaries instead of abrupt concatenation artifacts (operator 2026-07-05:
    # "транскрипция очень странные куски" — glued chunks produced garbled interleaved text).
    data=b""
    gap=b"\x00\x00"*int(RATE*gap_secs) if gap_secs>0 else b""
    for i,p in enumerate(paths):
        try:
            w=wave.open(p,"rb"); data+=w.readframes(w.getnframes()); w.close()
            if gap and i<len(paths)-1: data+=gap
        except Exception: pass
    if not data: return False
    w=wave.open(out,"wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
    w.writeframes(data); w.close(); return True

def transcribe_buffer():
    # transcribe the WHOLE current audio buffer AT ONCE (at trigger time → synced with reality), write
    # the result as the room transcript, and return it. This is the on-demand STT the trigger calls.
    paths=buffer_wavs(BUFFER_MIN)
    if not paths: return ""
    big="/tmp/oh-buffer-%d.wav"%os.getpid()
    if not concat_wavs(paths,big): return ""
    text=transcribe(big)
    try: os.remove(big)
    except OSError: pass
    if text:
        try:
            with open(TRANSCRIPT_FILE,"w") as f:
                f.write("[%s] %s\n"%(time.strftime("%H:%M:%S"),text))
        except Exception: pass
    return text

def no_speech_kind(verdict):
    # marker text for a non-speech VAD verdict (silence|ambient|music) — used both when the pre-STT
    # gate skips whisper and when is_real() rejects a hallucinated transcript. Module-level so the
    # mapping is unit-testable (runpy gate_kind) instead of buried in a closure.
    if verdict=="music":   return "музыка"
    if verdict=="ambient": return "фоновый гул/шум (не музыка)"
    return "тишина/шум, без слов"

def occupancy_tag(verdict):
    # HUMAN-vs-MEDIA hint for a speech transcript line, from mesh-room-trace's occupancy verdict.
    # ADDITIVE by contract (discover/overhear-occupancy-tag, 2026-07-02): overhear classifies
    # speech-PRESENCE but has zero occupancy awareness, so its "speech-like" can't tell a PERSON
    # from the TV/radio playing to an EMPTY room. The tag NEVER suppresses or overrides the speech —
    # someone the room sensors missed could still be present, so VACANT+speech is a QUESTION
    # ([speech:MEDIA?] = device-audio HINT), not a claim the room is empty. Module-level so the
    # verdict→tag mapping is unit-testable (runpy occ_tag) without a live room-trace run.
    if verdict=="OCCUPIED": return "[speech:HUMAN]"       # room present → a person is here
    if verdict=="VACANT":   return "[speech:MEDIA?]"      # empty room + speech → likely device audio
    # RECENT (occupancy residue, someone just here — can't tell person-lingering from device) or
    # UNKNOWN/unreachable (honest-fusion: never fake HUMAN/MEDIA on missing signals) → UNCERTAIN.
    return "[speech:UNCERTAIN]"

def bose_foreign_playback():
    # A THIRD-PARTY app (Firefox, mpv, …) actively streaming audio to the room's Bose speaker RIGHT NOW
    # is a harder "not human speech" signal than voiceprint match or room-occupancy: our OWN TTS path is
    # already excluded upstream (capture_utterance() drains the mic while MUTE_FLAG is set; _self_playing()
    # guards the ambient classifier by pw-play pid), so ANY active Bose-sink stream visible here belongs to
    # someone else's app. Chat-review 2026-07-07: a football-analysis YouTube video playing in Firefox on
    # the room node got resemblyzer-matched to the operator's enrolled voiceprint (false positive) and
    # transcribed as [speech:HUMAN]/[speech:UNCERTAIN] — this check is independent of that match and can't
    # be fooled by it (operator: "compare bose output with mic rec — only bose is making sounds").
    # Fail-open: wpctl unreachable/parse error → False (never claims foreign playback it can't prove).
    cmd=os.environ.get("MESH_OVERHEAR_WPCTL_CMD","wpctl status")
    try:
        r=subprocess.run(cmd.split(),capture_output=True,text=True,timeout=5)
        out=r.stdout or ""
    except Exception:
        return False
    return bool(re.search(r'Bose Revolve SoundLink:playback_F[LR]\s*\[active\]', out))

def occupancy_verdict():
    # Live occupancy verdict from mesh-room-trace (OCCUPIED|RECENT|VACANT|UNKNOWN), or "" if the
    # organ is absent/unreachable/garbled. FAIL-OPEN: any error → "" → the transcript is written
    # exactly as before this feature (never degrade the existing read when room-trace is missing).
    cmd=os.environ.get("MESH_OVERHEAR_ROOMTRACE_CMD","mesh-room-trace")
    try:
        r=subprocess.run(cmd.split()+["--json"],capture_output=True,text=True,timeout=8)
        out=(r.stdout or "")+(r.stderr or "")
    except Exception:
        return ""
    m=re.search(r'"verdict"\s*:\s*"(OCCUPIED|RECENT|VACANT|UNKNOWN)"', out)
    if m: return m.group(1)
    # fallback: plain one-shot shape ("room-trace: VERDICT — …") if --json ever changes
    m=re.search(r'\b(OCCUPIED|RECENT|VACANT|UNKNOWN)\b', out)
    return m.group(1) if m else ""

def transcribe_recent(secs):
    # transcribe ONLY the most recent `secs` of buffered audio — the fast on-demand read so `mesh-room read`
    # reflects what's being said NOW. Lighter than transcribe_buffer (whole ~7-min window, minutes of whisper
    # → the RC=124/empty stalls), so it can run live on each thumbs-up. operator 2026-06-20.
    # HONESTY: always write a FRESH-stamped result so the live read never shows a stale ancient line. If the
    # window holds real speech → write it; if it's only music/silence/hallucination → "(нет речи — …)" marker.
    # Returns real speech text, else "".
    stamp=time.strftime("%H:%M:%S")
    def _write(line):
        try:
            with open(TRANSCRIPT_FILE,"w") as f: f.write("[%s] %s\n"%(stamp,line))
        except Exception: pass
    paths=buffer_wavs(secs)
    if not paths:
        _write("(тишина — в комнате не звучало ничего за последние %d с)"%secs); return ""
    # VOICE-PRINT FILTER (operator 2026-07-04: "вычленить фингерпринт моего голоса тембра"): when voice
    # prints are enrolled, transcribe ONLY chunks matching a known voice — this is the real "is a person
    # talking" gate, replacing the crude RMS+flatness classifier that labeled speech-over-music as "music"
    # and blocked the reflex for 2 weeks. TV/music chunks never match → never sent to Groq → no more
    # "Субтитры создавал DimaTorzok" hallucinations. Fail-open: no prints enrolled → transcribe all.
    prints=voice_prints()
    if prints:
        paths=voice_filtered_paths(secs)
        if not paths:
            _write("(нет знакомого голоса за последние %d с — только TV/музыка/тишина)"%secs); return ""
    else:
        # FALLBACK (no voice prints): the old energy classifier gate — skip whisper on silence/ambient.
        verdict=classify_presence(secs)
        if verdict in ("silence","ambient") and not os.environ.get("OH_STT_FORCE"):
            _write("(нет речи — %s)"%no_speech_kind(verdict)); return ""
    big="/tmp/oh-recent-%d.wav"%os.getpid()
    # Insert 0.3s silence between voice chunks (operator 2026-07-05: glued chunks → garbled STT)
    gap=0.3 if prints else 0.0
    if not concat_wavs(paths,big,gap_secs=gap):
        _write("(нет читаемого аудио в буфере)"); return ""
    text=transcribe(big)
    try: os.remove(big)
    except OSError: pass
    if is_real(text):
        # ADDITIVE occupancy tag (discover/overhear-occupancy-tag): prefix real speech with a
        # HUMAN-vs-MEDIA hint from mesh-room-trace so any consumer stops mis-reading TV/radio
        # dialogue in an empty room as a person talking. Fail-open: no verdict → no tag → line
        # unchanged. Return value stays the RAW text (consumers of the speech content, not the
        # transcript-file annotation) — only the transcript FILE carries the tag.
        v=occupancy_verdict()
        tag=occupancy_tag(v) if v else ""
        if bose_foreign_playback(): tag="[speech:MEDIA-bose]"
        _write(("%s %s"%(tag,text)) if tag else text); return text
    # CONCAT DROWNED → PER-CHUNK RESCUE (2026-07-05): a music-dominated concat window loses embedded
    # speech that per-utterance STT renders cleanly — the wake scanner's v2 lesson, hit again HERE:
    # the scanner tape held real family talk (10:19–10:21) while this concat pass wrote
    # "(нет речи — музыка)". Before declaring no-speech, transcribe the newest chunks INDIVIDUALLY
    # (bounded by OH_HEAR_CHUNK_CAP) and keep the real lines, each under its own chunk timestamp.
    lines=[]; raw=[]
    v=occupancy_verdict(); tag=(occupancy_tag(v)+" ") if v else ""
    if bose_foreign_playback(): tag="[speech:MEDIA-bose] "
    for w in paths[-int(os.environ.get("OH_HEAR_CHUNK_CAP","12")):]:
        t=transcribe(w)
        if not is_real(t): continue
        try:
            ms=int(os.path.basename(w).split(".")[0]); st=time.strftime("%H:%M:%S",time.localtime(ms/1000))
        except Exception: st=stamp
        lines.append("[%s] %s%s"%(st,tag,t)); raw.append(t)
    if lines:
        try:
            with open(TRANSCRIPT_FILE,"w") as f: f.write("\n".join(lines)+"\n")
        except Exception: pass
        return "\n".join(raw)
    # speech-like by energy but whisper produced hallucination/loop — re-classify for an honest marker.
    _write("(нет речи — %s)"%no_speech_kind(classify_presence(secs))); return ""

def _self_playing():
    # True while the mesh is producing sound on the Bose — never classify our OWN
    # playback as ambient music (operator 2026-06-24: voice-tx/room-music on the Bose
    # fed back into the mic → 'music everywhere'). The capture loop already drains
    # during MUTE_FLAG, but voice-tx/room-music --play set the flag too AND pw-play
    # running catches the rest; this is defense-in-depth against races.
    if os.path.exists(MUTE_FLAG): return True
    try:
        r=subprocess.run(["pgrep","-x","pw-play"],capture_output=True,timeout=2)
        if r.returncode==0: return True
    except Exception: pass
    return False

def _frame_features(data):
    # per-100ms-frame (RMS in s16 units, spectral flatness in [0,1]) for 16k mono s16 bytes.
    # numpy is a heavy import — done lazily so the daemon/STT paths don't pay for it.
    import numpy as np
    fb=int(RATE*0.1)*2
    out=[]
    for i in range(0,len(data)-fb+1,fb):
        f=data[i:i+fb]
        if len(f)<fb: continue
        a=np.frombuffer(f,dtype="<i2").astype(np.float64)
        rms=float(np.sqrt(np.mean(a*a)))             # s16 units — comparable to audioop.rms
        w=a*np.hanning(len(a))                        # window before FFT to reduce leakage
        p=(np.abs(np.fft.rfft(w))+1e-12)**2          # one-sided power spectrum
        fm=float(np.exp(np.mean(np.log(p)))/np.mean(p))  # spectral flatness: ~1 noise, ~0 tonal
        out.append((rms,fm))
    return out

def classify(data):
    # Rich verdict on raw wav bytes: silence | ambient | music | speech-like.
    # Replaces the af/qf-only heuristic (operator 2026-06-24): steady ambient hum
    # (fridge/fan/HVAC) used to trip qf<0.10 -> 'sound' -> marker said 'музыка' ->
    # 'music everywhere'. Now: low absolute level OR broadband+steady -> ambient
    # (collapses to silence externally); only tonal+loud+steady -> music;
    # intermittent -> speech-like. Spectral flatness separates harmonic (music/
    # voice) from broadband noise (hum); absolute level separates the ambient
    # floor from real content; self-playback is silenced up front.
    if _self_playing(): return "silence"
    feats=_frame_features(data)
    if not feats: return "silence"
    rms=[r for r,_ in feats]; flat=[f for _,f in feats]; n=len(rms)
    af=sum(1 for r in rms if r>=START_RMS)/n             # fraction above speech onset
    qf=sum(1 for r in rms if r< SIL_RMS )/n              # fraction quiet (pauses)
    act=[r for r in rms if r>=SIL_RMS]
    mean_act=sum(act)/len(act) if act else 0.0
    max_rms=max(rms)
    mean_flat=sum(flat)/n
    # tunables — env-overridable so the operator can fine-tune on the real room
    AMB_LEVEL=float(os.environ.get("OH_AMB_LEVEL","1000"))  # active-RMS below this = ambient floor
    HUM_FLAT =float(os.environ.get("OH_HUM_FLAT","0.40"))   # flatness above this = broadband noise (hum)
    MUSIC_MIN=float(os.environ.get("OH_MUSIC_MIN","2000"))  # tonal but below this level = fridge hum, not music
    WALL_QF  =float(os.environ.get("OH_WALL_QF","0.15"))    # gap fraction below this = continuous wall
    if af<0.06: return "silence"                            # almost nothing above onset (empty room)
    if mean_act<AMB_LEVEL: return "ambient"                 # low continuous level = HVAC/fridge hum
    if qf<WALL_QF:                                          # continuous wall — music vs noise?
        if mean_flat>HUM_FLAT: return "ambient"             # steady broadband hum/noise
        if max_rms<MUSIC_MIN: return "ambient"              # low-level tonal hum (compressor)
        return "music"                                      # loud tonal wall = real music
    return "speech-like"                                    # intermittent energy with pauses

def _buffer_bytes(secs):
    # concat the recent rolling-buffer utterances into one wav's raw bytes (or None)
    paths=buffer_wavs(secs)
    if not paths: return None
    big="/tmp/oh-hs-%d.wav"%os.getpid()
    if not concat_wavs(paths,big): return None
    try:
        w=wave.open(big,"rb"); data=w.readframes(w.getnframes()); w.close()
    except Exception: data=None
    try: os.remove(big)
    except OSError: pass
    return data

def speech_presence(secs):
    # CHEAP wav-level verdict on the recent buffer (NO whisper) — operator 2026-06-20: "понимать
    # что пусто на уровне звуковых wav, не гонять 'думаю' чтобы ничего не сказать". External 3-state
    # contract preserved (silence|sound|speech-like) so --poke-mind/--watch-* keep working; the
    # 4-state `classify()` is collapsed: ambient hum now reads as silence (was 'sound' = the bug).
    # Heuristic, not a classifier — the real filter is is_real() after STT; this just stops the
    # pipeline from engaging (ack/poke) on obvious silence, ambient hum, or steady music.
    data=_buffer_bytes(secs)
    if not data: return "silence"
    v=classify(data)
    if v in ("silence","ambient"): return "silence"
    if v=="music": return "sound"
    return "speech-like"

def classify_presence(secs):
    # RICH 4-state verdict (silence|ambient|music|speech-like) — used by the transcript marker so
    # ambient hum is labeled honestly instead of propagating whisper's 'музыка' hallucination.
    data=_buffer_bytes(secs)
    if not data: return "silence"
    return classify(data)

def bose_id():
    # the LIVE pipewire id of the Bose sink, or None if it's not connected right now
    try:
        out=subprocess.run(["wpctl","status"],capture_output=True,timeout=5).stdout.decode("utf-8","ignore")
        in_sinks=False
        for ln in out.splitlines():
            if "Sinks:" in ln: in_sinks=True; continue
            if "Sources:" in ln or "endpoints" in ln: in_sinks=False
            if in_sinks and ("bose" in ln.lower() or "soundlink" in ln.lower()):
                m=re.search(r'(\d+)\.', ln)
                if m: return m.group(1)
    except Exception: pass
    return None

def pwplay(wav):
    # ALWAYS aim for the Bose; if it dropped, fall back to default so audio isn't lost (operator 2026-06-20:
    # "должен говорить через Bose, не в ноутбук" — the default sink drifts to the laptop when BT blips).
    # VOICE GATE (operator 2026-06-24): room-voice-off (manual) + thermal-silence (auto overheat mute) +
    # live .therm-state HOT. Supersedes the old VOICE_OFF-only os.path check; routed through the single
    # mesh-voice-gate binary so EVERY audio cause (not just the manual switch) mutes the room. Fail-OPEN
    # on a missing gate binary (the manual room-voice-off switch is the reliable mute).
    # HONEST MUTE (2026-07-04): a gate-refusal used to silently return — the say path still reported
    # rc=0 and every consumer believed the speech was DELIVERED (two days of "delivered" speaks with
    # room-voice-off set went into the void, operator: "i did not hear it"). Now: mute → stderr reason
    # + return False; speakers exit non-zero so a muted voice can never masquerade as a delivery.
    try:
        g=subprocess.run(["mesh-voice-gate"],capture_output=True,text=True,timeout=6)
        if g.returncode!=0:
            reason=(g.stdout or g.stderr or "voice-gate refused").strip()
            sys.stderr.write("pwplay: MUTED — %s (no audio emitted)\n"%reason)
            return False
    except Exception: pass
    bid=bose_id()
    # cap = wav duration + slack, floored at OH_PWPLAY_TIMEOUT — a hung/missing sink must never wedge
    # `say`, but a FIXED 30s cap also beheaded every phrase longer than 30s and misreported it as
    # "sink hung" (2026-07-06: three long room replies cut mid-sentence; the real wedged-sink case that
    # night was an ALSA Broken-pipe loop, fixed by a pipewire restart — the cap must only catch THAT).
    cap=float(os.environ.get("OH_PWPLAY_TIMEOUT","30"))
    try:
        with wave.open(wav) as _w: cap=max(cap,_w.getnframes()/float(_w.getframerate())+8.0)
    except Exception: pass
    try:
        if bid:
            try: subprocess.run(["wpctl","set-default",bid],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
            except Exception: pass
            subprocess.run(["pw-play","--target",bid,wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=cap)
        else:
            subprocess.run(["pw-play",wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=cap)
    except subprocess.TimeoutExpired:
        sys.stderr.write("pwplay: pw-play timed out after %ss (sink hung/disconnected — Bose dropped?)\n"%cap)
        return False
    except Exception: pass
    return True

def notify_screen(txt):
    # TEXT FALLBACK (operator 2026-07-04: "если недоступен голос - пусть шлет на монитор, канал сам
    # выберет как лучше"): when the voice gate mutes Misha (thermal-silence / manual off), he still has
    # a real desktop session on this box (gnome-shell, seat0) — so a muted utterance shows as a desktop
    # notification instead of vanishing into the void. Best-effort only: never raise, never block speak().
    try:
        subprocess.run(["notify-send","-t","20000","Миша (голос заглушён)",txt[:200]],
            stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
    except Exception: pass

SAY_VERIFY_LOG=os.environ.get("OH_SAY_VERIFY_LOG", os.path.join(os.path.dirname(LOGF),"misha-say-verify.log"))
def _norm_words(s):
    return set(re.findall(r"[a-zа-яё0-9]+", s.lower()))

def _say_verify(said, heard, muted, amb_rms=None):
    # SELF-VERIFY (operator 2026-07-04: "он думает, что говорит, но нет — надо б записывать когда миша
    # сам говорит, транскрибировать и проверять что сказал ок"). A caller trusting pwplay's rc/exception-
    # free return already got burned once (the HONEST MUTE fix above, for the "muted but rc=0" case) —
    # this catches the OTHER way "said" can be a lie: gate/Bose both report success but no audio actually
    # reached the mic (Bose dropped mid-utterance, wrong sink, volume 0, room echo too dead to pick up).
    # Best-effort AUDIT, not a retry gate — the utterance is already out, can't be unsent — but every
    # speak() now leaves a verifiable trace instead of an unconditional "it happened" everyone just trusts.
    ts=time.strftime("%Y-%m-%dT%H:%M:%S")
    if muted:
        verdict,score="MUTED",0.0
    elif not heard or not is_real(heard):
        # SILENT vs DROWNED (2026-07-05): during room music the audit recording is FULL of sound —
        # whisper hallucinates a music marker, is_real() rejects it, and a perfectly working Bose
        # scored "SILENT -> path suspect" 5 runs straight (log 05:24 OK, then music till 07:54). A
        # loud recording can't prove the path but it can't indict it either — that's DROWNED
        # (unverifiable), reserved SILENT for a genuinely quiet mic during our own playback.
        if amb_rms is not None and amb_rms>=int(os.environ.get("OH_DROWN_RMS","500")):
            verdict,score="DROWNED",0.0
        else:
            verdict,score="SILENT",0.0   # mic heard nothing real during our own playback — mic/Bose path suspect
    else:
        a=_norm_words(said); b=_norm_words(heard)
        score=(len(a & b)/len(a)) if a else 0.0
        verdict="OK" if score>=0.3 else "MISMATCH"
    try:
        with open(SAY_VERIFY_LOG,"a") as f:
            f.write("%s\t%s\t%.2f\t%s\t%s\n"%(ts,verdict,score,
                said[:80].replace("\t"," "),(heard or "")[:80].replace("\t"," ")))
    except Exception: pass
    return verdict

def speak(txt):
    # FILLER-STRIP (operator 2026-07-05): «Секунду, думаю» filler kept leaking to the Bose
    # despite prompt rules. Strip leading thinking-fillers HERE (lowest synth level) so EVERY
    # caller (say_stdin, ack, daemon comment, poke) is caught. Filler-only → silence (honest).
    import re as _re
    _F = _re.compile(r'^\s*(так[,\s]*|секунд[ауоуочеек]*[,\s]*|секу(нд)?[ау]?[,\s]*|подумаю[,\s]*|думаю[,\s]*|щас[,\s]*|сейчас[,\s]*|момент[,\s]*|мгновенье[,\s]*|окей[,\s]*|ну[,\s]*|blip\b[,\s]*)+', _re.IGNORECASE)
    txt = _F.sub('', txt).lstrip(' ,.—:—…').strip()
    if not txt: return
    wav="/tmp/oh-say-%d.wav"%os.getpid()
    subprocess.run([PIPER,"-m",VOICE,"-f",wav],input=txt.encode(),
        env=dict(os.environ,LD_LIBRARY_PATH=PIPERLIB),
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if os.path.exists(wav) and os.path.getsize(wav)>0:
        try: open(MUTE_FLAG,"w").close()      # tell the listener "that's me" so it doesn't self-transcribe
        except Exception: pass
        # record the mic DURING our own playback (raw pw-record, independent of the daemon's ambient
        # capture loop, which is itself muted right now) — this is the actual audit artifact.
        rec="/tmp/oh-say-verify-%d.wav"%os.getpid()
        recorder=None
        try:
            recorder=subprocess.Popen(recorder_argv(rec),
                stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        except Exception: recorder=None
        delivered=pwplay(wav)                 # → the Bose specifically, not whatever default drifted in; blocks until playback ends
        time.sleep(0.6)                       # let the Bose echo tail land in the recording before un-muting
        if recorder is not None:
            recorder.terminate()
            try: recorder.wait(timeout=3)
            except Exception:
                try: recorder.kill()
                except Exception: pass
        try: os.remove(MUTE_FLAG)
        except OSError: pass
        try: os.remove(wav)
        except OSError: pass
        if delivered is False:
            _say_verify(txt, None, muted=True)
            notify_screen(txt)                # voice unavailable -> fall back to the room monitor
            try: os.remove(rec)
            except OSError: pass
            sys.exit(3)                       # muted — caller must see a non-delivery, not a fake rc=0
        heard=""; amb_rms=None
        if recorder is not None and os.path.exists(rec) and os.path.getsize(rec)>44:
            # energy of the audit recording: the SILENT-vs-DROWNED discriminator for _say_verify
            try:
                with wave.open(rec,"rb") as _wf:
                    _fr=_wf.readframes(_wf.getnframes())
                    if _fr: amb_rms=audioop.rms(_fr,2)
            except Exception: amb_rms=None
            # say-verify only needs a fuzzy word-overlap match (_say_verify's 0.3 Jaccard threshold),
            # not the accurate-but-slow default ladder — force the OH_STT_FAST base-model path (the
            # same fix that unwedged the wake scanner, 2026-07-04) so every speak() doesn't silently
            # block its caller for a minute+ transcribing its own audit recording with large-v3-turbo.
            _prev_fast=os.environ.get("OH_STT_FAST")
            os.environ["OH_STT_FAST"]="1"
            try: heard=transcribe(rec)
            finally:
                if _prev_fast is None: os.environ.pop("OH_STT_FAST",None)
                else: os.environ["OH_STT_FAST"]=_prev_fast
        _say_verify(txt, heard, muted=False, amb_rms=amb_rms)
        try: os.remove(rec)
        except OSError: pass

def read_exact(f,n):
    b=b""
    while len(b)<n:
        c=f.read(n-len(b))
        if not c: break
        b+=c
    return b

def capture_utterance():
    # block until one utterance (speech onset → pause). Returns (wav_path_or_"", err):
    #   err is None on a HEALTHY read (including a real-but-too-short capture — the recorder DID stream
    #       audio, the speaker just didn't say enough);
    #   err is a short reason string when the recorder produced ZERO full frames — arecord/pw-record
    #       died or the device is unavailable. The caller MUST back off on a non-None err: retrying a
    #       dead recorder costs this code nothing and the node everything (a clean short-read is not an
    #       exception, so the daemon's except-branch sleep never fired → arecord respawned 861×/s for
    #       4.7h undetected, 10% of a core; discover/overhear-recorder-respawn-loop-no-backoff 2026-07-27).
    # stderr is PIPEd (was DEVNULL) so the reason is CARRIED OUT, not swallowed — an oracle that cannot
    # report the fault (the second defect in that same Popen) is as bad as the storm it hides.
    p=subprocess.Popen(recorder_argv("-"),
        stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    frames=[]; capturing=False; silence=0.0; got_frame=False
    try:
        while True:
            buf=read_exact(p.stdout,FBYTES)
            if len(buf)<FBYTES: break
            got_frame=True
            if os.path.exists(MUTE_FLAG):     # the mesh is speaking on the Bose → drain, don't capture self
                capturing=False; frames=[]; silence=0.0
                continue
            r=audioop.rms(buf,2)
            if not capturing:
                if r>=START_RMS: capturing=True; frames=[buf]; silence=0.0
            else:
                frames.append(buf)
                if r<SIL_RMS:
                    silence+=FSEC
                    if silence>=END_SIL: break
                else: silence=0.0
                if len(frames)*FSEC>=MAX_UTT: break
    finally:
        p.kill()
        try: p.stdout.close()
        except Exception: pass
    if not got_frame:
        # recorder never delivered a single full frame → it failed to start/produce, NOT a short
        # utterance. Read WHY off stderr and surface it so the caller backs off + can log the cause.
        err=""
        try: err=(p.stderr.read() or b"").decode("utf-8","ignore").strip().replace("\n"," ")[:200]
        except Exception: pass
        try: p.stderr.close()
        except Exception: pass
        return ("", err or "recorder produced no audio (rc=%s)"%p.poll())
    try: p.stderr.close()
    except Exception: pass
    if (len(frames)*FSEC - silence) < MIN_UTT: return ("", None)
    wav="/tmp/oh-utt-%d-%d.wav"%(os.getpid(),int(time.time()*1000)%100000)
    w=wave.open(wav,"wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
    w.writeframes(b"".join(frames)); w.close()
    return (wav, None)

def prune_and_read(stamp_now):
    # read OH_LOG, drop lines older than KEEP, rewrite, return kept text lines (chronological)
    keep=[]
    try:
        with open(LOGF) as f: lines=f.readlines()
    except FileNotFoundError: lines=[]
    out_text=[]
    for ln in lines:
        parts=ln.rstrip("\n").split("\t",2)
        if len(parts)<3 or not parts[0].isdigit():
            # NEVER delete what this reader cannot parse. The rewrite below is the whole file, so a
            # `continue` here is a silent erase of somebody else's record — that is exactly how the
            # [claim-order] witness (now in DIAGF) was destroyed by the first --comment after a boot.
            # Unparsable → not a transcript line → not ours to age out. Keep it, don't render it.
            keep.append(ln); continue
        try: ep=int(parts[0])
        except ValueError:
            keep.append(ln); continue
        if stamp_now-ep<=KEEP:
            keep.append(ln); out_text.append("[%s] %s"%(parts[1],parts[2]))
    try:
        with open(LOGF,"w") as f: f.writelines(keep)
    except Exception: pass
    return out_text

def relay(prompt):
    try:
        out=subprocess.run(["mesh-relay",prompt],capture_output=True,timeout=60).stdout.decode("utf-8","ignore")
        return " ".join(out.split()).strip()
    except Exception: return ""

mode=sys.argv[1] if len(sys.argv)>1 else ""

if mode=="daemon":
    # ON-DEMAND: don't transcribe continuously (that lagged behind reality and desynced what Claude heard
    # — operator 2026-06-20). Just VAD-capture utterances into a cheap rolling AUDIO buffer; whisper runs
    # only at a trigger. default-string does ZERO whisper → never heats; IdeaPad transcribes only on demand.
    os.makedirs(BUFFER_DIR, exist_ok=True)
    last_prune=0.0
    fail_streak=0
    while True:
        try:
            w,err=capture_utterance()
            if err is not None:
                # recorder failed to produce audio → BACK OFF. A clean short-read is not an exception,
                # so the except-branch sleep below never fired on this path and arecord respawned as
                # fast as fork allows (~861/s). Escalate the sleep (cap 5s) so a persistently-dead mic
                # can't storm the node, and break single-subdevice contention that a hot respawn loop
                # only reinforces. Say WHY — once at onset, then every 50th — instead of silent spin.
                fail_streak+=1
                if fail_streak==1 or fail_streak%50==0:
                    sys.stderr.write("overhear: recorder produced no audio (x%d) — %s\n"%(fail_streak, err or "no stderr"))
                    sys.stderr.flush()
                time.sleep(min(5.0, 0.5*fail_streak))
                continue
            fail_streak=0
            if w:
                dst=os.path.join(BUFFER_DIR,"%d.wav"%int(time.time()*1000))
                try:
                    import shutil; shutil.move(w,dst)   # /tmp(tmpfs)→~/.mesh(disk) is cross-device; move handles it
                except Exception:
                    try: os.remove(w)
                    except OSError: pass
            now=time.time()
            if now-last_prune>10:                      # prune the rolling window every 10s
                last_prune=now; cutoff=(now-BUFFER_MIN)*1000
                for fn in os.listdir(BUFFER_DIR):
                    if fn.endswith(".wav"):
                        try:
                            if int(fn[:-4])<cutoff: os.remove(os.path.join(BUFFER_DIR,fn))
                        except (ValueError,OSError): pass
        except Exception:
            time.sleep(0.5)

elif mode=="capture_probe":
    # TEST hook: call capture_utterance() once and report the (wav?, err) contract so --test can assert
    # that a failed recorder surfaces a NON-None err (the reason, carried off stderr) instead of an
    # indistinguishable "" — the no-backoff/mute-oracle pair. Drive with OH_RECORDER_CMD.
    _w,_e=capture_utterance()
    print("wav=%s|err=%s"%("yes" if _w else "no", ("None" if _e is None else _e)))

elif mode=="buffer_fresh":
