    # and must log it, so a recurring silent fallback (the actual root cause) is visible next time.
    # SKIP this test when OH_STT_GROQ is enabled (Groq bypasses SSH offload entirely).
    if [ -z "${OH_STT_GROQ:-}" ] || [ "$OH_STT_GROQ" != "1" ]; then
      _sttlog="$(mktemp "${TMPDIR:-/tmp}"/oh-stt-test-XXXXXX.log)"; _sttwav="$(mktemp "${TMPDIR:-/tmp}"/oh-stt-test-XXXXXX.wav)"
