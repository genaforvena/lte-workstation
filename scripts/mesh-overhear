      || { echo "smoke-test: FAIL (a prune pass destroyed the claim-order witness)"; rm -rf "$_cd"; exit 1; }
    # (c) prune_and_read never deletes a line it cannot parse, and still ages/renders the ones it can.
    _now="$(date +%s)"; _old="$((_now-999999))"
    { printf 'a foreign line with no tabs at all\n'; printf '%s\tру\tсвежая строка\n' "$_now"; printf '%s\tру\tдревняя строка\n' "$_old"; } > "$_cd/mixed.log"
    _pr="$(OH_LOG="$_cd/mixed.log" OH_DIAG_LOG="$_cd/unused.log" OH_KEEP_MIN=10 runpy prune_probe 2>/dev/null)"
    case "$_pr" in *"свежая строка"*) : ;; *) echo "smoke-test: FAIL (prune_and_read must render a fresh transcript line, got: $_pr)"; rm -rf "$_cd"; exit 1;; esac
    case "$_pr" in *"древняя строка"*) echo "smoke-test: FAIL (prune_and_read must age out a line older than the window)"; rm -rf "$_cd"; exit 1;; *) : ;; esac
    grep -q 'a foreign line with no tabs at all' "$_cd/mixed.log" \
      || { echo "smoke-test: FAIL (prune_and_read deleted an unparsable line — a silent erase of somebody else's record)"; rm -rf "$_cd"; exit 1; }
    grep -q 'древняя строка' "$_cd/mixed.log" \
      && { echo "smoke-test: FAIL (the aged transcript line must be dropped from the file, not kept)"; rm -rf "$_cd"; exit 1; }
    # (d) EVERY exit path leaves a note, incl. the ones that do no waiting — a gate that records only
    #     its interesting branch is indistinguishable from a gate that never ran. And the stamp carries a
    #     DATE: a bare HH:MM:SS renders every age modulo 24h, so a week-old note reads as minutes old.
    : > "$_cd/diag2.log"
    OH_LOG="$_cd/overheard.log" OH_DIAG_LOG="$_cd/diag2.log" runpy claim_probe "CARD=Generic" >/dev/null 2>&1
    grep -q 'no claim gate' "$_cd/diag2.log" 2>/dev/null \
      || { echo "smoke-test: FAIL (the card-less exit path must still leave a note — silence there reads as 'never ran')"; rm -rf "$_cd"; exit 1; }
    grep -qE "^$(date +%Y)-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"$'\t' "$_cd/diag2.log" \
      || { echo "smoke-test: FAIL (diag stamps must carry a DATE — a dateless clock renders every age modulo 24h)"; rm -rf "$_cd"; exit 1; }
    # (e) the INHERITED tape: one leg deliberately writes with NO per-leg override, so the diag lands
    #     wherever the environment points. That is what makes the --test-footprint gate at the end
    #     load-bearing — without this leg, no leg would touch the default tape and "the test didn't
    #     write to the real one" would be true no matter what (measured: the footprint gate passed
    #     GREEN against a mutant that deleted its own redirect, until this leg existed).
    OH_LOG="$_cd/overheard.log" runpy claim_probe "CARD=Generic" >/dev/null 2>&1
    grep -q 'no claim gate' "$OH_DIAG_LOG" 2>/dev/null \
      || { echo "smoke-test: FAIL (a diag written with no per-leg override did not land on the inherited tape $OH_DIAG_LOG)"; rm -rf "$_cd"; exit 1; }
    rm -rf "$_cd"
    echo "  claim-order witness ok (durable diag tape; survives a prune; unparsable lines preserved; every exit path notes, dated; inherited tape honoured)"
    # burst-niceness source guard (health 2026-07-05 18:33Z, falsifiable: strip the nice wrapper from
    # transcribe_local → this FAILs): the local whisper call — the -t6 large-v3-turbo offload target
    # whose bursts drove node-health CRITICAL flaps — must stay nice-wrapped so minds preempt it.
    # (pattern built via concatenation so this guard line never contains the literal substring it
    # searches for — else it self-matches and the guard is meaningless; mesh-dispatch CLAIMS-guard idiom)
    _ng_a='"nice","-n",os.environ.get('; _ng_b='"OH_WHISPER_NICE","19"),WHISPER'
    grep -qF "${_ng_a}${_ng_b}" "$0" \
      || { echo "smoke-test: FAIL (transcribe_local whisper invocation lost its nice wrapper)"; exit 1; }
    echo "  burst-niceness ok (local whisper runs at nice 19 — minds preempt transcription bursts)"
    # groq STT error-classification + backoff (chat-review/groq-stt-blind-error+no-backoff, 2026-07-06):
    # a 429 rate-limit is HTTP-200-shaped JSON with an 'error' field and NO 'text'. The old code read only
    # .get('text') → logged as generic 'empty' → re-hit Groq every utterance → SSH→IdeaPad whisper storm.
    # Assert the four branches transcribe_groq now distinguishes, each falsifiable.
    case "$(runpy groq_classify '{"text":" Белый."}')" in *'text=Белый.|code=None|rate=0'*) : ;; *) echo "smoke-test: FAIL (groq_classify: text body must passthrough, got: $(runpy groq_classify '{"text":" Белый."}'))"; exit 1;; esac
    _grl='{"error":{"message":"rate limit reached","type":"rate_limit_exceeded","code":"rate_limit_exceeded"}}'
    case "$(runpy groq_classify "$_grl")" in *'code=rate_limit_exceeded|rate=1'*) : ;; *) echo "smoke-test: FAIL (groq_classify: 429 body must parse code + is_rate, got: $(runpy groq_classify "$_grl"))"; exit 1;; esac
    _goe='{"error":{"message":"bad request","type":"invalid_request_error","code":"model_not_found"}}'
    case "$(runpy groq_classify "$_goe")" in *'code=model_not_found|rate=0'*) : ;; *) echo "smoke-test: FAIL (groq_classify: non-rate error must parse code, rate=0, got: $(runpy groq_classify "$_goe"))"; exit 1;; esac
    case "$(runpy groq_classify '{"text":""}')" in *'text=|code=None|rate=0'*) : ;; *) echo "smoke-test: FAIL (groq_classify: genuine empty text is code=None, not an error)"; exit 1;; esac
    # backoff short-circuits the curl: a FRESH cooldown flag → transcribe_groq returns 'cooldown' before
    # any network; an EXPIRED flag → inactive + auto-removed (so the next 429 opens a fresh episode).
    _gcd="$(mktemp -d "${TMPDIR:-/tmp}"/oh-groq-XXXXXX)"; : > "$_gcd/groq-stt-cooldown"
    [ "$(OH_LOG="$_gcd/overhear.log" OH_GROQ_COOLDOWN=300 runpy groq_stt_err /nonexistent.wav)" = cooldown ] \
      || { echo "smoke-test: FAIL (fresh cooldown flag must skip Groq with 'cooldown' sentinel — no curl)"; rm -rf "$_gcd"; exit 1; }
    touch -d '10 minutes ago' "$_gcd/groq-stt-cooldown"
    [ "$(OH_LOG="$_gcd/overhear.log" OH_GROQ_COOLDOWN=60 runpy groq_cooldown_active)" = 0 ] \
      || { echo "smoke-test: FAIL (expired cooldown flag must read inactive)"; rm -rf "$_gcd"; exit 1; }
    [ -e "$_gcd/groq-stt-cooldown" ] && { echo "smoke-test: FAIL (expired cooldown flag must be auto-removed)"; rm -rf "$_gcd"; exit 1; }
    rm -rf "$_gcd"
    echo "  groq STT error-classification + backoff ok (text passthrough; 429→cooldown skips curl; non-rate→code logged; empty distinct)"
    # --watch-speech retired-by-default + singleton (chat-review/room-ambient-poke-churn 2026-07-10):
    # (a) a bare --watch-speech must exit at once with the RETIRED notice — never launch the RMS
    #     --has-speech→--poke-mind music-poker loop; only ROOM_WATCH_SPEECH_ENABLE=1 re-arms it.
    # (b) force-enabled it must PASS the gate (no RETIRED) AND honour the singleton flock: with the
    #     lock pre-held it exits at flock (rc≠124) instead of looping — proving the flock guard is real.
    # (No PATH-stub of mesh-overhear: the script prepends ~/.local/bin to PATH, which would shadow the
    #  stub — so we drive the gate/flock decisions directly with a temp MESH_DIR + a held lock.)
    _wsd="$(mktemp -d)"
    _wsoff="$(ROOM_WATCH_SPEECH_ENABLE= MESH_DIR="$_wsd" timeout 5 bash "$0" --watch-speech 2>&1)"
    printf '%s' "$_wsoff" | grep -q RETIRED || { echo "smoke-test: FAIL (--watch-speech gated-off must print RETIRED notice, got: $_wsoff)"; rm -rf "$_wsd"; exit 1; }
    exec 6>"$_wsd/.room-watch-speech.lock"; flock -n 6 || { echo "smoke-test: FAIL (test harness could not take the watch-speech lock)"; rm -rf "$_wsd"; exit 1; }
    _wson="$(ROOM_WATCH_SPEECH_ENABLE=1 MESH_DIR="$_wsd" timeout 5 bash "$0" --watch-speech 2>&1)"; _wsrc=$?
    flock -u 6 2>/dev/null; exec 6>&-
    printf '%s' "$_wson" | grep -q RETIRED && { echo "smoke-test: FAIL (--watch-speech force-enabled must PASS the gate, not print RETIRED)"; rm -rf "$_wsd"; exit 1; }
    [ "$_wsrc" = 124 ] && { echo "smoke-test: FAIL (--watch-speech force-enabled hit an already-held singleton lock but LOOPED (timeout) instead of exiting — flock guard missing)"; rm -rf "$_wsd"; exit 1; }
    rm -rf "$_wsd"
    echo "  watch-speech retired-by-default + singleton ok (bare → RETIRED; forced+lock-held → passes gate, exits at flock not loop)"
    # --hear HARD wall-clock bound (senses→genome 2026-07-13: a wedged ssh-offload held a room-mind turn
    # 8.5h). Force a hung re-transcribe (OH_HEAR_TEST_HANG=1 → sleep 999 inside hear) with a 2s ceiling;
    # the whole --hear MUST return in a few seconds (bounded, not 999s) AND emit the honest-degrade notice
    # (never hang the consumer). Uses the real code path — the same "test the real decision" discipline.
    _hd="$(mktemp -d)"
    _t0=$(date +%s)
    _hout="$(OH_HEAR_TEST_HANG=1 OH_HEAR_CEIL=2 MESH_DIR="$_hd" timeout 20 bash "$0" --hear 2>&1)"; _hrc=$?
    _t1=$(date +%s); _elapsed=$((_t1 - _t0))
    rm -rf "$_hd"
    [ "$_hrc" = 124 ] && { echo "smoke-test: FAIL (--hear did NOT self-bound: wrapper timeout let it run to the outer 20s guard — OH_HEAR_CEIL not enforced)"; exit 1; }
    [ "$_elapsed" -le 15 ] || { echo "smoke-test: FAIL (--hear took ${_elapsed}s despite OH_HEAR_CEIL=2 — hard bound missing)"; exit 1; }
    printf '%s' "$_hout" | grep -q 'honest-degrade to last transcript' || { echo "smoke-test: FAIL (--hear timed out but emitted no honest-degrade notice, got: $_hout)"; exit 1; }
    echo "  --hear hard bound ok (wedged re-transcribe SIGTERM'd at OH_HEAR_CEIL=2s in ${_elapsed}s → honest-degrade to --show, consumer never hangs)"

    # --- REAL-READ GATE for the LOCAL audio classifier -----------------------------------------------
    # (chat-review/overhear-classifier-numpy-dead-under-forced-system-python — health, 2026-07-15.)
    # WHY THIS EXISTS: this suite was rc=0 GREEN while the local classifier was 100% DEAD (every
    # --classify-wav → ModuleNotFoundError: numpy, rc=1, empty stdout) — and mesh-voice-count wrote
    # 'count=0 verdict=unknown' 99/99 cron runs on the strength of that green. The 'classify' asserts
    # above drive groq_classify: parsing a Groq JSON body, pure string work, never numpy. Producer-gate
    # bypass, textbook — they proved the classifier-of-the-API-RESPONSE while the AUDIO classifier rotted.
    # A test must exercise the thing it wraps.
    #
    # THE CONSTANT TRAP, and why 'verdict is one of the four' is NOT sufficient on its own: a classifier
    # hardcoded to return 'music' would satisfy a set-membership assert on a single sample and read green
    # forever — the same shape as the '|| echo 500' beat that was a constant nobody could see. So the gate
    # drives TWO acoustically opposite inputs and asserts the classifier DISCRIMINATES: pure digital
    # silence must read 'silence', and a known-speech wav must read something OTHER than silence. That
    # pair cannot be satisfied by any constant.
    _cw_na() { echo "smoke-test: n/a ($1)"; exit 2; }   # honest n/a (mesh-land/doctor treat exit 2 as a pass), never a fake green
    # AN n/a MUST BE A CLAIM ABOUT THE NODE, NOT ABOUT WHICHEVER INTERPRETER ANSWERED. Caught by this
    # gate's OWN first red run (2026-07-15): unbinding the interpreter — i.e. REGRESSING the exact bug
    # this gate exists to hold — made the probe below conclude "audio stack absent on this node" and
    # exit 2, which mesh-doctor/mesh-land count as a PASS. The gate rendered its own regression as a
    # capability gap. That is precisely the class health named the same day ([fyi] the numpy-resolution
    # family): exit-2 becoming the '|| echo 500' of the test layer, a silent fallback wearing our own
    # honesty convention (live instances: mesh-tuner:606, mesh-acoustic-range:114, both claiming "numpy
    # not installed on this node" on a node carrying it THREE times).
    # So ask the NODE first. numpy absent from every candidate interpreter → genuinely n/a. numpy present
    # SOMEWHERE but not to $OH_PY → that is a RESOLUTION bug, the very defect here, and it must be RED.
    _cw_node_numpy=""
    for _c in "$OH_PY" "$GRAIN_DIR/.venv/bin/python" "$HOME/.venv-ai/bin/python" "$HOME/.venv-xtts/bin/python" /usr/bin/python3; do
      [ -x "$_c" ] || continue
      if "$_c" -c 'import numpy' >/dev/null 2>&1; then _cw_node_numpy="$_c"; break; fi
    done
    [ -n "$_cw_node_numpy" ] || _cw_na "no interpreter on this NODE has numpy (checked $OH_PY, the grain/ai/xtts venvs, /usr/bin/python3) — audio-analysis stack genuinely absent here"
    [ -x "$OH_PY" ] || { echo "smoke-test: FAIL (no interpreter at OH_PY='$OH_PY', yet numpy IS on this node at $_cw_node_numpy — a resolution bug, not an absent stack)"; exit 1; }
    "$OH_PY" -c 'import numpy' >/dev/null 2>&1 || { echo "smoke-test: FAIL (the bound interpreter OH_PY='$OH_PY' has no numpy, but this NODE does at '$_cw_node_numpy' — the local audio classifier is dead and every --classify-wav returns rc=1+empty, which voice-count renders as a quiet room. This is the interpreter-resolution bug, NOT an absent capability: bind OH_PY to an interpreter with numpy)"; exit 1; }
    _cwd="$(mktemp -d)"
    # digital silence — synthesized here, no fixture, no hardware
    "$OH_PY" - "$_cwd/silence.wav" <<'CWPY' 2>/dev/null
import sys, wave
w = wave.open(sys.argv[1], "wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(16000)
w.writeframes(b"\x00\x00" * 16000 * 3); w.close()
CWPY
    _cwsil="$(bash "$0" --classify-wav "$_cwd/silence.wav" 2>/dev/null | tail -1)"; _cwsil_rc=$?
    [ "$_cwsil_rc" = 0 ] || { echo "smoke-test: FAIL (local classifier did not RUN on synthesized silence: rc=$_cwsil_rc — this is the numpy/interpreter regression; run: mesh-overhear --classify-wav <wav> to see the traceback the callers' 2>/dev/null eats)"; rm -rf "$_cwd"; exit 1; }
    case "$_cwsil" in
      silence|ambient|music|speech-like) : ;;
      *) echo "smoke-test: FAIL (local classifier returned '${_cwsil:-<empty>}' on silence — not one of silence|ambient|music|speech-like; empty/unknown means the producer is dead and voice-count will render it as a quiet room)"; rm -rf "$_cwd"; exit 1 ;;
    esac
    [ "$_cwsil" = silence ] || { echo "smoke-test: FAIL (synthesized digital silence classified '$_cwsil', expected 'silence' — the classifier is not reading its input)"; rm -rf "$_cwd"; exit 1; }
    # known speech: the whisper sample shipped with this node's STT stack. Absent → n/a, not a fake pass.
    _cwjfk="$MESH/whispercpp/sample-jfk.wav"
    if [ -f "$_cwjfk" ]; then
      _cwspe="$(bash "$0" --classify-wav "$_cwjfk" 2>/dev/null | tail -1)"; _cwspe_rc=$?
      [ "$_cwspe_rc" = 0 ] || { echo "smoke-test: FAIL (local classifier did not RUN on known speech: rc=$_cwspe_rc)"; rm -rf "$_cwd"; exit 1; }
      case "$_cwspe" in
        silence|ambient|music|speech-like) : ;;
        *) echo "smoke-test: FAIL (local classifier returned '${_cwspe:-<empty>}' on known speech — not a valid verdict)"; rm -rf "$_cwd"; exit 1 ;;
      esac
      # THE DISCRIMINATION ASSERT: a constant classifier dies here. NOTE we assert 'not silence' rather
      # than '== speech-like': measured 2026-07-15, this classifier calls sample-jfk.wav 'music' (and a
      # pure 440Hz tone 'music' too), so its speech-vs-music axis does NOT separate them. That is a REAL
      # open question — posted as a [verify], NOT quietly blessed here — but it is a SEPARATE defect from
      # the dead lane this gate exists to hold. Asserting '== speech-like' today would encode a failing
      # claim; asserting 'ran, valid, and discriminates loud-from-silent' is what is actually true.
      [ "$_cwspe" != silence ] || { echo "smoke-test: FAIL (known-speech wav classified 'silence' — the classifier is returning a constant or misreading its input)"; rm -rf "$_cwd"; exit 1; }
      echo "  local-classifier real-read ok (silence→'$_cwsil', known-speech→'$_cwspe' — ran under $OH_PY, valid verdicts, discriminates)"
    else
      echo "  local-classifier real-read ok (silence→'$_cwsil'; known-speech sample absent, discrimination half skipped)"
    fi
    rm -rf "$_cwd"
    # THE TEST'S OWN FOOTPRINT: mesh-doctor runs this hourly. If any leg above minted a note into the
    # real diag tape, the tape a human reads for "did the boot-race gate fire" would be forged by the
    # test. Falsifiable: drop the OH_DIAG_LOG redirect at the top of --test and this goes red.
    _ohreal_after="$( { [ -e "$_ohreal" ] && wc -c < "$_ohreal"; } 2>/dev/null || echo absent )"
    [ "$_ohreal_before" = "$_ohreal_after" ] \
      || { echo "smoke-test: FAIL (--test wrote to the real diag tape $_ohreal: $_ohreal_before -> $_ohreal_after bytes — the test is forging the artifact it checks)"; rm -f "$_ohtest_tape"; exit 1; }
    rm -f "$_ohtest_tape"
    echo "smoke-test: ok (whisper+model+piper+voice present, TTS rendered, local audio classifier real-read + discriminates, diag tape durable + untouched by --test)"
    ;;
  # usage goes to STDERR: callers capture stdout as TRANSCRIPT TEXT (ssh offload rcmd → $txt), and the
  # header contains the wake name «Миша» — a verb-mismatch usage dump on stdout became a false by-name
  # wake + minted the wake-confirmed marker (observed live 2026-07-05 07:51).
  *) sed -n '2,28p' "$0" >&2 ;;
esac
