      || { echo "smoke-test: FAIL (claim-order note not written to the diag tape)"; rm -rf "$_cd"; exit 1; }
    [ -s "$_cd/overheard.log" ] && { echo "smoke-test: FAIL (claim-order note leaked into OH_LOG, where prune_and_read deletes it)"; rm -rf "$_cd"; exit 1; }
