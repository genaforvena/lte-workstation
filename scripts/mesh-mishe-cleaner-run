#!/usr/bin/env python3
"""Install and run the real report-only cleaner on a dedicated mishe home."""
import fcntl
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
CORE = Path(os.environ.get("MESH_MISHE_CORE", Path.home() / "mishe-tauftauf"))
HOME = Path(os.environ.get("MESH_CLEANER_MISHE_HOME", Path.home() / ".mesh/mishe-cleaner"))
ADAPTER = ROOT / "scripts/cleaner/mesh-cleaner-mishe"


def core(*args):
    env = dict(os.environ, PYTHONPATH=str(CORE / "src"), MESH_CLEANER_MISHE_HOME=str(HOME))
    return subprocess.run([sys.executable, "-m", "mishe_tauftauf", "--home", str(HOME), *args],
                          env=env, check=False).returncode
def tmux(*args):
    result = subprocess.run(["tmux", *args], capture_output=True, text=True)
    if result.returncode:
        raise ValueError(f"tmux {' '.join(args[:2])} failed: {result.stderr.strip()[:180]}")
    return result.stdout


def pane(session, index):
    target = f"{session}:cleaner.{index}"
    return (tmux("display-message", "-p", "-t", target, "#{pane_start_command}").strip(),
            tmux("display-message", "-p", "-t", target, "#{pane_dead}").strip())


def ensure():
    install()
    lock_path = HOME / ".cleaner-ensure.lock"
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        session = os.uname().nodename
        if not subprocess.run(["tmux", "has-session", "-t", session],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            raise ValueError(f"mesh tmux session {session} unavailable; retry next tick")
        windows = tmux("list-windows", "-t", session, "-F", "#{window_name}").splitlines()
        runner = shlex.quote(str(Path(__file__).resolve()))
        if "cleaner" not in windows:
            tmux("new-window", "-d", "-t", session, "-n", "cleaner", runner + " watch")
        else:
            count = len(tmux("list-panes", "-t", f"{session}:cleaner",
                             "-F", "#{pane_index}").splitlines())
            if count not in (1, 2):
                raise ValueError("cleaner window has unexpected pane count")
            top_start, top_dead = pane(session, 0)
            if "mesh-mishe-cleaner-run watch" in top_start:
                if top_dead == "1":
                    tmux("respawn-pane", "-k", "-t", f"{session}:cleaner.0", runner + " watch")
            elif "mesh-dash cleaner" in top_start:
                if count == 2:
                    bottom_start, _ = pane(session, 1)
                    if ("mind type __lean_skip__ is REMOTE" not in bottom_start
                            and "mesh-mishe-cleaner-run follow" not in bottom_start):
                        raise ValueError("legacy cleaner Mind ownership ambiguous")
                tmux("respawn-pane", "-k", "-t", f"{session}:cleaner.0", runner + " watch")
            else:
                raise ValueError("cleaner top pane is not an owned pilot or legacy renderer")
        count = len(tmux("list-panes", "-t", f"{session}:cleaner",
                         "-F", "#{pane_index}").splitlines())
        if count == 1:
            tmux("split-window", "-v", "-t", f"{session}:cleaner.0", runner + " follow")
            return
        bottom_start, bottom_dead = pane(session, 1)
        if "mesh-mishe-cleaner-run follow" in bottom_start:
            if bottom_dead == "1":
                tmux("respawn-pane", "-k", "-t", f"{session}:cleaner.1", runner + " follow")
        elif "mind type __lean_skip__ is REMOTE" in bottom_start:
            tmux("respawn-pane", "-k", "-t", f"{session}:cleaner.1", runner + " follow")
        else:
            raise ValueError("cleaner bottom pane is not an owned pilot or stopped placeholder")


def install():
    if not ADAPTER.is_file() or not os.access(ADAPTER, os.X_OK):
        raise ValueError("report-only cleaner adapter absent")
    if core("init"):
        raise ValueError("core initialization failed")
    for folder in ("top-pains", "minds", "projectors", "filters"):
        target = HOME / folder / "cleaner"
        if target.is_symlink() and target.resolve() == ADAPTER:
            continue
        if target.exists() or target.is_symlink():
            raise ValueError(f"refusing to replace existing cleaner hook: {target}")
        target.symlink_to(ADAPTER)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("init", "ensure", "once", "follow", "watch", "verify"):
        raise ValueError("usage: mesh-mishe-cleaner-run init|ensure|once|follow|watch|verify")
    mode = sys.argv[1]
    if mode == "init":
        install()
        return 0
    if mode == "ensure":
        ensure()
        return 0
    if mode == "verify":
        return subprocess.run([str(ADAPTER), "verify"], check=False).returncode
    if mode == "watch":
        return core("pain", "watch", "cleaner", "--interval", "5")
    if mode == "once":
        return main_once()
    while True:
        result = main_once()
        if result:
            return result
        time.sleep(15)


def main_once():
    core("check", "cleaner", "--", str(ADAPTER), "verify")
    return core("run", "--once", "--slug", "cleaner", "--launcher", "headless")


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as exc:
        print(f"UNKNOWN cleaner mishe runner: {exc}", file=sys.stderr)
        raise SystemExit(2)
