#!/usr/bin/env bash
# mesh-load-gate — a SHED gate for heavy reflexes: proceed only when the box has headroom.
#
# WHY: mesh-home runs ~180 cron reflexes; the heavy ones (LLM relays, audio grind, vision,
# librosa measure) each spawn a python/ffmpeg/CUDA child. When several fire in the same minute
# on an already-busy box (13 opencode minds during the z.ai burn), load1 climbs past nproc and
# the operator's own ssh gets starved/killed (operator 2026-07-22: "it keeps killing my ssh").
# The cheap sensor edges are fine; the HEAVY reflexes are the ones to shed under pressure.
#
# This is the missing GATE: prepend it to a heavy reflex's cron line so the reflex SKIPS its tick
# when load1 is over threshold — INTENDED, LOGGED skip, not a silent failure. It is the load half
# of the operator's "make heavy reflexes time/load gated" ask (--quiet-hours is the time half).
#
#   mesh-load-gate <name> [threshold]   exit 0 = proceed, 1 = skip (load too high, or free disk
#                                       under the disk-free-floor ledger row). threshold
#                                       defaults to MESH_LOAD_GATE_MAX or nproc*0.9; disk floor
#                                       to MESH_DISK_FLOOR_MB or ledger floor (2048MB).
#   mesh-load-gate --quiet-hours <name> [threshold]
#                                       ALSO skip during MESH_QUIET_HOURS (default 01-06 local) so
#                                       cosmetic reflexes (diary, grind) go quiet overnight.
#   mesh-load-gate --effectivity <name> [threshold]
#                                       ACTION-SCALE the threshold by the CPU's current effectivity
#                                       (mesh-cpufreq ratio) instead of static core geometry. Opt-in;
#                                       also MESH_LOAD_GATE_EFFECTIVITY=1. See ACTION-SCALING below.
#   mesh-load-gate --coupling [hours]   READ-ONLY diagnostic: is this gate's shed behaviour coupled to
#                                       PEER distress, or merely co-located with it? See HOMEOSTATIC
#                                       COUPLING below. Never changes a verdict; always exits 0.
#   mesh-load-gate --test               offline decide() fixtures + real /proc/loadavg read.
#
# ACTION-SCALING (enactivism/4E, "affordance ratio"; landed 2026-07-31):
#   The default threshold `nproc*0.9` — and the literal `11` every wired cron line passes — is a
#   BODY-SCALED affordance: the shed boundary expressed as a dimensionless ratio of the body's
#   STATIC geometry (core count), exactly Warren's pi-number. The ecological-psychology literature
#   is clear that this is the WRONG scaler when capability itself moves: affordance boundaries track
#   CURRENT effectivities, not fixed body dimensions. Flach, Schotborgh, Withagen & Smith 2021
#   (Atten Percept Psychophys, doi:10.3758/s13414-021-02315-z) exhaust participants' legs and find
#   perceived max-jumpable tracks the FATIGUED capability (~-32cm) and recovers with it; Wang,
#   Mazalek, Sabiston & Welsh 2026 (Virtual Reality, doi:10.1007/s10055-026-01368-5) make the
#   invariant explicit as the AFFORDANCE RATIO = perceptual threshold / action threshold, and show
#   it is preserved once the perturbation on the action threshold is accounted for.
#
#   16 cores at half clock are not 16 cores of work-per-second. A run queue of 10 on a THROTTLED box
#   drains at half rate — the ACTION threshold has moved, the shed threshold (11) has not, so this
#   gate's affordance ratio silently doubles and it admits a heavy grind onto a box that cannot do
#   the work: precisely the ssh-starvation it exists to prevent. mesh-cpufreq ALREADY measures the
#   effectivity (percent of cpuinfo_max, cron 2-59/5, cached at ~/.mesh/.cpufreq-state) — the gate simply
#   never read it. --effectivity scales thr by that ratio, re-scaling the boundary to the fatigued
#   body the way the perceptual system does.
#
#   Deliberate ASYMMETRY, inherited from the FAIL-OPEN note below: the ratio is CAPPED at 100, so
#   BOOST grants no bonus. Shedding more under throttle costs one skipped cosmetic tick; admitting
#   more under boost raises the ceiling the operator tuned by hand against ssh starvation. Likewise
#   the ratio is FLOORED (MESH_LOAD_GATE_EFF_FLOOR, default 50) so no absurd/garbage reading can
#   drive the threshold toward zero and permanently disable every heavy reflex. Unknown, stale
#   (> MESH_LOAD_GATE_EFF_TTL, default 1800s) or unparseable effectivity -> UNSCALED, never faked.
#
# Cron usage:  */2 * * * * mesh-load-gate diary && mesh-diary >> ... 2>&1
#   -> on a busy box the gate exits 1, the && short-circuits, mesh-diary never runs, and the SKIP
#      is logged to ~/.mesh/load-gate.log with who/why. A dead cron never runs -> never logs ->
#      honestly absent (no faked "proceeded").
#
# HOMEOSTATIC COUPLING vs MERE PARTNER-STATE ACCESS (--coupling; landed 2026-08-04, read-only):
#   Sanyal 2026, *Prosociality by Coupling, Not Mere Observation: Homeostatic Sharing in an Inspectable
#   Recurrent Artificial Life Agent* (arXiv:2604.10760v2, 2026-04-12). The result, isolated by lesion:
#   in a self-directed planner that scores ONLY the actor's own predicted internal state, giving the
#   agent ACCESS to its partner's state changes nothing at all — "partner-state access is behaviorally
#   inert unless partner distress is routed into self-regulation". Behaviour appears only when the
#   partner's distress is wired INTO the actor's own homeostat (coupling channel, switch at λ*≈0.91);
#   coupling-off and shuffled-partner lesions abolish it, sham lesions preserve it. Its second result
#   is a coupling/load sweep: coupling creates a LOW-LOAD helping regime and does NOT guarantee rescue
#   under higher metabolic load — a saturated actor cannot help however well coupled.
#
#   THE MESH IS THE INERT-ACCESS CASE, and this gate is where it bites. decide() above takes exactly
#   three local inputs — this box's load1, this box's free disk, the wall clock. Its essential
#   variables are strictly LOCAL. Yet the heavy reflexes it gates are NOT local-only: mesh-node-care
#   SSHes EVERY declared node every 5 min, mesh-fleet-health/-states walk the fleet, mesh-tell drives
#   peer windows. Peer distress is not merely accessible — this node already MEASURED it and wrote it
#   to its own disk (~/.mesh/node-care.log carries per-node load/temp/disk/mem every sweep). The gate
#   has never read that file. So mesh-home reads its own load1, PROCEEDs, and lands another sweep on a
#   peer that is itself drowning. Access without coupling, exactly.
#
#   --coupling is the MEASUREMENT half (the actuator — a peer term in decide() — is HELD: shedding a
#   local reflex on a REMOTE reading is a behaviour change on the operator's hand-tuned ceiling, and a
#   peer sense that goes hollow would silently disable heavy reflexes forever, against this file's own
#   false-skip asymmetry). It asks the question the paper's lesions ask, on real artifacts:
#     output  = this gate's REAL shed events (~/.mesh/load-gate.log) — actual behaviour, not a replay
#     partner = each peer's load in ~/.mesh/node-care.log, aligned into 5-min buckets
#     effect  = P(shed | peer distressed) - P(shed | peer calm), peer-high self-calibrated at the
#               CS_Q-th percentile of THAT peer's OWN loads (a 2-core peer at load 5 is not a 16-core
#               peer at load 5 — never a shared absolute number)
#     null    = max |effect| over K CIRCULAR SHIFTS of the peer series. Shift, not shuffle: the loads
#               are strongly autocorrelated, and an i.i.d. permutation null is anticonservative on an
#               autocorrelated series (our own cooscillate finding). A shift destroys the alignment
#               while preserving each series' own structure — the paper's shuffled-partner lesion,
#               done correctly for time series.
#   Verdicts: INERT-ACCESS (|effect| within the null band, or under the practical floor CS_MIN_EFF —
#   the gate's behaviour is independent of peer distress) · ASSOCIATED-UNROUTED (effect survives the
#   null: the two DO covary — but no code path routes peer state into decide(), so this is COMMON
#   CAUSE, e.g. one operator burst loading both boxes, NOT coupling. A statistic cannot tell routed
#   from co-located; only the lesion can, and here the lesion is trivial — grep decide()) ·
#   NO-OUTPUT-VARIANCE (the gate never shed, or always shed, in the window: its behaviour did not move,
#   so its dependence on anything is untestable — honest, not a pass) · NO-DISTURBANCE (the peer's load
#   never varied enough for "distress" to mean anything) · INSUFFICIENT / NO-ACCESS.
#   And the paper's load sweep as `rescue=`: among the peer's distressed buckets, how often did THIS
#   box have headroom under its own threshold? HEADROOM = a coupled gate could in principle have helped;
#   NO-RESCUE = the box was itself saturated whenever the peer was distressed, so coupling would buy
#   nothing (the paper's high-metabolic-load failure) and wiring it would be theatre.
#
# FAIL-OPEN: if /proc/loadavg is unreadable we PROCEED (exit 0) — a heavy reflex that can never
# read load must not be permanently disabled by a bad read; the gate only ever SHEDS on a
# CONFIRMED-high load, never on uncertainty. (The opposite of the mesh-clear fail-safe: there a
# false all-clear is the irreversible error; here a false "proceed" just spends one tick of load,
# a false "skip" silently disables a reflex forever — so uncertainty proceeds.)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# MESH_LOAD_GATE_LOG exists so a --test child can be driven end-to-end WITHOUT writing the real shed
# log — a test that writes the artifact a human/watchdog reads for liveness forges the evidence it
# exists to check (mesh-guardian's dry-run, 09f7914). Production never sets it.
LOG="${MESH_LOAD_GATE_LOG:-$HOME/.mesh/load-gate.log}"

# decide <load1> <threshold> <hour> <quiet_hours_spec|""> [free_mb] [floor_mb]
#   -> echoes "PROCEED|reason" or "SKIP|reason"
# Pure, offline-testable. quiet_hours_spec = "START-END" (e.g. "1-6"); "" disables the time gate.
# free_mb/floor_mb: the disk floor (ledger row disk-free-floor — a heavy grind on a nearly-full
# disk corrupts its own render); unreadable free_mb -> fail-open like the load axis.
decide() {
  local l1="$1" thr="$2" hour="$3" qh="$4" free="${5:-}" floor="${6:-}"
  # Disk floor first among the resource axes: cheapest read, and a full disk hurts regardless of load.
  if [ -n "$floor" ] && [ -n "$free" ] && [ "$free" -ge 0 ] 2>/dev/null; then
    if [ "$free" -lt "$floor" ]; then
      echo "SKIP|disk-floor free=${free}MB < floor=${floor}MB"
      return
    fi
  fi
  # Time gate first (cheapest, and an explicit operator preference to go quiet overnight).
  if [ -n "$qh" ]; then
    local qs="${qh%-*}" qe="${qh#*-}"
    if [ -n "$qs" ] && [ -n "$qe" ] && [ "$hour" -ge "$qs" ] 2>/dev/null && [ "$hour" -lt "$qe" ] 2>/dev/null; then
      echo "SKIP|quiet-hours (hour=$hour in $qh)"
      return
    fi
  fi
  # Load gate. Non-numeric load -> PROCEED (fail-open; never disable a reflex on a bad read).
  if ! printf '%f' "$l1" >/dev/null 2>&1 || ! printf '%f' "$thr" >/dev/null 2>&1; then
    echo "PROCEED|load unreadable (l1=$l1 thr=$thr) - fail-open"
    return
  fi
  if [ "$(awk "BEGIN{print ($l1 > $thr) ? 1 : 0}")" = "1" ]; then
    echo "SKIP|load1=$l1 > threshold=$thr"
  else
    echo "PROCEED|load1=$l1 <= threshold=$thr"
  fi
}

# _cpufreq_ratio -> integer percent of cpuinfo_max, or "" when unknown/stale/unreadable.
# WHAT THAT PERCENT IS MADE OF CHANGED 2026-08-29 and the contract did not: mesh-cpufreq used to put
# an INSTANTANEOUS avg(scaling_cur_freq)/cpuinfo_max in this field, which the driver derives from
# APERF/MPERF during the read itself and so reports the busy clock of a core that may have idled the
# rest of the interval (measured on mesh-home the same minute: 98.6% sample vs 64.4% residency). The
# field now carries the P-STATE RESIDENCY mean over the interval against the same cpuinfo_max — the
# quantity this gate always meant by "effectivity", finally measured over the window it scales.
# Data-frugal: reads mesh-cpufreq's CACHED state artifact (cron 2-59/5), never re-probes /sys.
# mesh-cpufreq calls mesh-state-touch on EVERY successful eval, so mtime is a true liveness signal
# and the TTL check cannot be fooled by a change-gated write (the liveness-touch convention).
# PARSE TRAP: the line is `LABEL|governor=..|pos=NN|ratio=NN|mean_khz=..|sample_khz=..|...|<reason>`
# and the free-text reason ALSO contains `ratio=NN%`. A greedy `sed 's/.*ratio=//'` reads the REASON,
# not the field. Split on '|' and take the field that is EXACTLY `ratio=<digits>`.
_cpufreq_ratio() {
  local f="${MESH_CPUFREQ_STATE:-$HOME/.mesh/.cpufreq-state}" ttl="${MESH_LOAD_GATE_EFF_TTL:-1800}" age now mt v
  case "$ttl" in ''|*[!0-9]*) ttl=1800 ;; esac
  [ -r "$f" ] || return 0
  mt="$(stat -c %Y "$f" 2>/dev/null)" || return 0
  case "$mt" in ''|*[!0-9]*) return 0 ;; esac
  now="$(date +%s 2>/dev/null)"; case "$now" in ''|*[!0-9]*) return 0 ;; esac
  age=$(( now - mt )); [ "$age" -gt "$ttl" ] && return 0   # stale -> unknown, never a fossil reading
  v="$(head -1 "$f" 2>/dev/null | tr '|' '\n' | awk -F= '$1=="ratio" && $2 ~ /^[0-9]+$/ {print $2; exit}')"
  case "$v" in ''|*[!0-9]*) return 0 ;; esac
  printf '%s\n' "$v"
}

# effective_threshold <thr> <ratio_pct|""> <floor_pct> -> "<thr_eff>|<reason>"
# Pure, offline-testable. The action-scaling step: thr_eff = thr * clamp(ratio, floor, 100) / 100.
effective_threshold() {
  local thr="$1" ratio="${2:-}" floor="${3:-50}" e note="" out
  # Non-numeric threshold -> leave alone; scaling garbage to 0.0 would SKIP everything forever.
  printf '%f' "$thr" >/dev/null 2>&1 || { echo "$thr|effectivity n/a (threshold non-numeric)"; return; }
  case "$ratio" in ''|*[!0-9]*) echo "$thr|effectivity unknown — unscaled"; return ;; esac
  case "$floor" in ''|*[!0-9]*) floor=50 ;; esac
  e="$ratio"
  if [ "$e" -gt 100 ]; then e=100; note=" (boost capped)"; fi
  if [ "$e" -lt "$floor" ]; then e="$floor"; note=" (floored at ${floor})"; fi
  out="$(awk -v t="$thr" -v e="$e" 'BEGIN{printf "%.1f", t*e/100}')"
  echo "$out|effectivity=${ratio}%${note} — thr ${thr} -> ${out}"
}

# --- HOMEOSTATIC COUPLING (read-only diagnostic; see the header note) -------------------------
# Tunables (env; every one has a live default — none is a hidden constant).
CS_Q="${MESH_COUPLING_Q:-80}"                  # peer-distress percentile, on the peer's OWN loads
CS_SHIFTS="${MESH_COUPLING_SHIFTS:-8}"         # circular shifts forming the null band
CS_MIN_N="${MESH_COUPLING_MIN_N:-60}"          # aligned buckets below which we refuse to answer
CS_MIN_HIGH="${MESH_COUPLING_MIN_HIGH:-10}"    # distressed buckets below which we refuse to answer
CS_MIN_SPREAD_M="${MESH_COUPLING_MIN_SPREAD:-200}"  # peer max-min, milli-load; below = NO-DISTURBANCE
CS_MIN_EFF_M="${MESH_COUPLING_MIN_EFF:-100}"   # practical floor on |effect| (0.100) — beating a
                                               # near-zero null by a hair is not an effect

# cs_classify <n> <nhigh> <nskip> <eff_m> <null_m> <spread_m> [min_n] [min_high] [min_spread_m] [min_eff_m]
#   milli-integer units throughout (eff_m = effect x1000, signed) so fixtures are exact.
#   -> "VERDICT|note".  Pure, offline-testable.
cs_classify() {
  local n="$1" nhigh="$2" nskip="$3" eff="$4" null="$5" spread="$6"
  local mn="${7:-$CS_MIN_N}" mh="${8:-$CS_MIN_HIGH}" ms="${9:-$CS_MIN_SPREAD_M}" me="${10:-$CS_MIN_EFF_M}"
  local aeff
  case "$n$nhigh$nskip$spread" in ''|*[!0-9]*) echo "UNKNOWN|non-numeric counts"; return ;; esac
  [ "$n" -lt "$mn" ] && { echo "INSUFFICIENT|n=$n < min_n=$mn"; return; }
  [ "$spread" -lt "$ms" ] && { echo "NO-DISTURBANCE|peer load spread ${spread}m < ${ms}m — 'distress' has no referent"; return; }
  [ "$nhigh" -lt "$mh" ] && { echo "INSUFFICIENT|high=$nhigh < min_high=$mh"; return; }
  # The regulator's OWN output must have moved, else nothing can explain it (honest, not a pass).
  [ "$nskip" -eq 0 ] && { echo "NO-OUTPUT-VARIANCE|gate never shed in window — dependence untestable"; return; }
  [ "$nskip" -ge "$n" ] && { echo "NO-OUTPUT-VARIANCE|gate shed in every bucket — dependence untestable"; return; }
  aeff="${eff#-}"
  case "$aeff" in ''|*[!0-9]*) echo "UNKNOWN|non-numeric effect '$eff'"; return ;; esac
  if [ "$aeff" -le "$null" ]; then
    echo "INERT-ACCESS|effect ${eff}m within circular-shift null ±${null}m"
  elif [ "$aeff" -lt "$me" ]; then
    echo "INERT-ACCESS|effect ${eff}m beats null ±${null}m but is under the practical floor ${me}m"
  else
    echo "ASSOCIATED-UNROUTED|effect ${eff}m > null ±${null}m and floor ${me}m — covaries, but no code path routes peer state into decide(): common cause, not coupling"
  fi
}

# cs_rescue <nhigh> <nhigh_with_local_headroom> -> "STATE|note"   (the paper's coupling/load sweep)
# Pure. HEADROOM = a coupled gate could have helped; NO-RESCUE = this box was saturated too.
cs_rescue() {
  local nh="$1" hr="$2" pct
  case "$nh$hr" in ''|*[!0-9]*) echo "UNKNOWN|non-numeric"; return ;; esac
  [ "$nh" -eq 0 ] && { echo "UNKNOWN|no distressed buckets"; return; }
  pct=$(( hr * 100 / nh ))
  if   [ "$pct" -ge "${MESH_COUPLING_HEADROOM_PCT:-70}" ]; then echo "HEADROOM|${pct}% of the peer's distressed buckets had local headroom"
  elif [ "$pct" -le "${MESH_COUPLING_NORESCUE_PCT:-30}" ]; then echo "NO-RESCUE|only ${pct}% had local headroom — saturated actor cannot help however coupled"
  else echo "MIXED|${pct}% had local headroom"
  fi
}

# cs_report <span_hours> <node-care.log> <shed.log> <selfname> [threshold]
# Emits the report on stdout. Read-only; never touches a state artifact.
cs_report() {
  local span="$1" care="$2" shed="$3" self="$4" thr="${5:-}"
  local cut tmp rows thr_src="resolved" overall="" any=0 best_rank=0
  [ -r "$care" ] || { echo "COUPLING: NO-ACCESS (no $care — peer distress is not even measured here)"; return 0; }
  cut="$(date -u -d "-${span} hours" +%Y-%m-%dT%H:%MZ 2>/dev/null)" || cut=""
  [ -n "$cut" ] || { echo "COUPLING: UNKNOWN (cutoff unresolvable)"; return 0; }
  tmp="$(mktemp -d -t loadgate-coupling.XXXXXX)" || { echo "COUPLING: UNKNOWN (no tmpdir)"; return 0; }
  # Stage 1: align both logs into 5-min buckets. Bucket index is %02d — a bare int sorts "10" before
  # "9" and silently scrambles the time order the circular-shift null depends on.
  # FILENAME, never the NR==FNR idiom: an EMPTY shed log (a gate that never shed — one of the states
  # this diagnostic exists to report) makes NR==FNR true for the SECOND file, and the care log is then
  # parsed as the shed log. The honest "no output variance" case is exactly where that trap fires.
  awk -v self="$self" -v cut="$cut" -v shedf="$shed" '
    # The bucket key is a REAL 5-min-floored timestamp ("2026-06-10T07:35"), not a bucket ORDINAL:
    # an ordinal needs zero-padding to sort right ("10" < "9" lexically) and silently scrambles the
    # time order the circular-shift null depends on. A timestamp sorts chronologically by
    # construction and is legible in --coupling output.
    function bk(ts){ return substr(ts,1,14) sprintf("%02d", int(substr(ts,15,2)/5)*5) }
    FILENAME==shedf {                            # shed log: 2026-08-04T07:42:01Z [load-gate] SKIP name — why
      if ($1 < cut) next
      if ($0 !~ /SKIP/) next
      skip[bk($1)]=1
      if (match($0, /threshold=[0-9.]+/)) thrc[substr($0, RSTART+10, RLENGTH-10)]++
      next
    }
    {                                            # care log: 2026-08-04T07:52Z node raw=.. :: .. load=X ..
      if (NF < 3 || $1 < cut) next
      ld=""
      for (i=3; i<=NF; i++) if ($i ~ /^load=/) ld = substr($i, 6)
      if (ld !~ /^[0-9]+(\.[0-9]+)?$/) next
      b = bk($1)
      if ($2 == self) selfl[b] = ld; else { pl[$2, b] = ld }
    }
    END {
      for (k in pl) {
        split(k, kk, SUBSEP)
        if (!(kk[2] in selfl)) continue          # need BOTH sides at the same bucket
        printf "%s|%s|%s|%s|%d\n", kk[1], kk[2], pl[k], selfl[kk[2]], ((kk[2] in skip) ? 1 : 0)
      }
      best=""; bc=0; for (t in thrc) if (thrc[t] > bc) { bc = thrc[t]; best = t }
      if (best != "") printf "#THR|%s\n", best
    }' "$shed" "$care" 2>/dev/null | sort -t'|' -k1,1 -k2,2 > "$tmp/all" || true
  # Modal threshold from the shed log itself — the number the WIRED cron lines actually pass, which is
  # not necessarily this script's resolved default.
  local modal; modal="$(awk -F'|' '$1=="#THR"{print $2}' "$tmp/all" | head -1)"
  if [ -n "$modal" ]; then thr="$modal"; thr_src="modal, from shed log"; fi
  # No shed line carried a threshold (e.g. every skip was disk/quiet-hours) -> the caller's resolved
  # default. Never a fabricated number: an unresolvable threshold makes the rescue axis UNKNOWN.
  [ -n "$thr" ] || { thr="unknown"; thr_src="unresolved — rescue axis degraded"; }
  grep -v '^#THR|' "$tmp/all" > "$tmp/rows" 2>/dev/null || true
  # Observable artifact of stage 1 (alignment + bucket keys), so a test can assert the pipeline's
  # own output rather than re-deriving it. Never written in production.
  [ -n "${MESH_COUPLING_DUMP:-}" ] && cp "$tmp/rows" "$MESH_COUPLING_DUMP" 2>/dev/null
  local nb ns
  nb="$(wc -l < "$tmp/rows" 2>/dev/null | tr -d ' ')"; [ -n "$nb" ] || nb=0
  ns="$(awk -F'|' '$5==1{print $2}' "$tmp/rows" 2>/dev/null | sort -u | wc -l | tr -d ' ')"
  printf 'COUPLING span=%sh self=%s thr=%s (%s) buckets=%s shed-buckets=%s\n' \
         "$span" "$self" "$thr" "$thr_src" "$nb" "$ns"
  if [ ! -s "$tmp/rows" ]; then
    echo "  (no peer rows aligned with this node's own rows in the window)"
    echo "COUPLING-STATE: NO-ACCESS"
    rm -rf "$tmp"; return 0
  fi
  local peer
  for peer in $(awk -F'|' '{print $1}' "$tmp/rows" | sort -u); do
    any=1
    awk -F'|' -v p="$peer" '$1==p' "$tmp/rows" > "$tmp/p"
    local n hi lo mx qi spread_m stats verdict rescue
    n="$(wc -l < "$tmp/p" | tr -d ' ')"
    qi=$(( n * CS_Q / 100 )); [ "$qi" -lt 1 ] && qi=1; [ "$qi" -gt "$n" ] && qi="$n"
    hi="$(awk -F'|' '{print $3}' "$tmp/p" | sort -n | awk -v i="$qi" 'NR==i{print; exit}')"
    lo="$(awk -F'|' '{print $3}' "$tmp/p" | sort -n | head -1)"
    mx="$(awk -F'|' '{print $3}' "$tmp/p" | sort -n | tail -1)"
    spread_m="$(awk -v a="$mx" -v b="$lo" 'BEGIN{printf "%d", (a-b)*1000}')"
    # Stage 2: effect + circular-shift null + the load sweep, in bucket order.
    local throk=1; printf '%f' "$thr" >/dev/null 2>&1 || throk=0
    stats="$(awk -F'|' -v hi="$hi" -v thr="$thr" -v throk="$throk" -v K="$CS_SHIFTS" '
      { pk[NR-1]=$3+0; sk[NR-1]=$4+0; kk[NR-1]=$5+0; n=NR }
      function eff(sh,   i,j,ah,nh,ac,nc) {
        ah=nh=ac=nc=0
        for (i=0; i<n; i++) { j=(i+sh)%n
          if (pk[j] > hi) { nh++; ah += kk[i] } else { nc++; ac += kk[i] } }
        if (nh==0 || nc==0) return 0
        return (ah/nh) - (ac/nc)
      }
      END {
        if (n==0) { print "0|0|0|0|0|0"; exit }
        nhigh=0; nskip=0; headroom=0
        for (i=0; i<n; i++) {
          nskip += kk[i]
          if (pk[i] > hi) { nhigh++; if (throk && sk[i] < thr+0) headroom++ }
        }
        if (!throk) headroom = -1          # unresolvable threshold -> UNKNOWN rescue, never a faked NO-RESCUE
        e = eff(0)
        step = int(n/(K+1)); if (step < 12) step = 12
        nullm = 0
        for (m=1; m<=K; m++) { sh = m*step; if (sh >= n) break
          v = eff(sh); if (v < 0) v = -v; if (v > nullm) nullm = v }
        printf "%d|%d|%d|%d|%d|%d\n", n, nhigh, nskip, int(e*1000), int(nullm*1000+0.5), headroom
      }' "$tmp/p")"
    local sn shigh sskip seff snull shr
    IFS='|' read -r sn shigh sskip seff snull shr <<EOF
$stats
EOF
    verdict="$(cs_classify "$sn" "$shigh" "$sskip" "$seff" "$snull" "$spread_m")"
    rescue="$(cs_rescue "$shigh" "$shr")"
    printf '  %-14s %-20s eff=%+d/1000 null=±%d/1000 n=%s high=%s (load>%s, spread %s..%s) rescue=%s\n' \
           "$peer" "${verdict%%|*}" "$seff" "$snull" "$sn" "$shigh" "$hi" "$lo" "$mx" "${rescue%%|*}"
    printf '      %s\n      rescue: %s\n' "${verdict#*|}" "${rescue#*|}"
    # Precedence by INFORMATIVENESS, not by peer order: a decided verdict outranks an honest refusal.
    # First-wins masked the whole answer behind one noise peer — live, a single-sample `EDGE` row
    # (n=1, INSUFFICIENT) sorted ahead of phaedra and turned a 763-sample INERT-ACCESS read into
    # COUPLING-STATE: INSUFFICIENT.
    local rank=1
    case "${verdict%%|*}" in ASSOCIATED-UNROUTED) rank=3 ;; INERT-ACCESS) rank=2 ;; esac
    if [ "$rank" -gt "$best_rank" ]; then best_rank="$rank"; overall="${verdict%%|*}"; fi
  done
  [ "$any" = 1 ] || overall="NO-ACCESS"
  echo "COUPLING-STATE: ${overall:-UNKNOWN}"
  rm -rf "$tmp"
  return 0
}

if [ "${1:-}" = --test ]; then
  fail=0
  # High load -> SKIP
  r="$(decide 20 12 12 "")";  echo "$r" | grep -q '^SKIP'    || { echo "  FAIL high-load: $r"; fail=1; }
  # Low load -> PROCEED
  r="$(decide 5 12 12 "")";   echo "$r" | grep -q '^PROCEED' || { echo "  FAIL low-load: $r"; fail=1; }
  # Boundary l1==thr -> PROCEED (strict >)
  r="$(decide 12 12 12 "")";  echo "$r" | grep -q '^PROCEED' || { echo "  FAIL boundary: $r"; fail=1; }
  # Unreadable load -> PROCEED (fail-open)
  r="$(decide abc 12 12 "")"; echo "$r" | grep -q '^PROCEED' || { echo "  FAIL fail-open: $r"; fail=1; }
  # Quiet hours: hour=3 in 1-6 -> SKIP even at low load
  r="$(decide 1 12 3 "1-6")"; echo "$r" | grep -q '^SKIP'    || { echo "  FAIL quiet-in: $r"; fail=1; }
  # Quiet hours: hour=12 not in 1-6 -> load gate applies (low -> PROCEED)
  r="$(decide 1 12 12 "1-6")";echo "$r" | grep -q '^PROCEED' || { echo "  FAIL quiet-out: $r"; fail=1; }
  # Quiet hours boundary: hour=6 NOT in 1-6 (end exclusive) -> PROCEED
  r="$(decide 1 12 6 "1-6")"; echo "$r" | grep -q '^PROCEED' || { echo "  FAIL quiet-end-excl: $r"; fail=1; }
  # Quiet hours + high load outside window -> SKIP by load
  r="$(decide 20 12 12 "1-6")"; echo "$r" | grep -q '^SKIP'  || { echo "  FAIL quiet-out-highload: $r"; fail=1; }
  # Disk floor (ledger row disk-free-floor: >= floor OK — boundary matches the admitted fixture
  # 2048/2047): below floor -> SKIP even at low load; at floor -> PROCEED; unreadable -> fail-open.
  r="$(decide 1 12 12 "" 2047 2048)"; echo "$r" | grep -q '^SKIP'    || { echo "  FAIL disk-low: $r"; fail=1; }
  r="$(decide 1 12 12 "" 2048 2048)"; echo "$r" | grep -q '^PROCEED' || { echo "  FAIL disk-at-floor: $r"; fail=1; }
  r="$(decide 1 12 12 "" ""   2048)"; echo "$r" | grep -q '^PROCEED' || { echo "  FAIL disk-fail-open: $r"; fail=1; }
  r="$(decide 20 12 12 "" 9999 2048)"; echo "$r" | grep -q '^SKIP'   || { echo "  FAIL disk-ok-highload: $r"; fail=1; }

  # --- ACTION-SCALING (affordance ratio) -------------------------------------------------------
  # E1 half-clock: the box is at 50% effectivity, so the shed boundary halves with it.
  r="$(effective_threshold 11 50 50)";  [ "${r%%|*}" = "5.5" ]  || { echo "  FAIL eff-half: $r"; fail=1; }
  # E2 near-rated: 96% barely moves it (the ordinary case — no gratuitous behaviour change).
  r="$(effective_threshold 11 96 50)";  [ "${r%%|*}" = "10.6" ] || { echo "  FAIL eff-nominal: $r"; fail=1; }
  # E3 BOOST grants NO bonus (deliberate asymmetry: never raise the operator's hand-tuned ceiling).
  r="$(effective_threshold 11 130 50)"; [ "${r%%|*}" = "11.0" ] || { echo "  FAIL eff-boost-cap: $r"; fail=1; }
  # E4 absurd reading is FLOORED — a bad sense must never drive the threshold toward zero and
  #    permanently disable every heavy reflex (the file's own false-skip asymmetry).
  r="$(effective_threshold 11 3 50)";   [ "${r%%|*}" = "5.5" ]  || { echo "  FAIL eff-floor: $r"; fail=1; }
  # E5 unknown effectivity -> UNSCALED (honest-fusion: never fake a capability reading).
  r="$(effective_threshold 11 "" 50)";  [ "${r%%|*}" = "11" ]   || { echo "  FAIL eff-unknown: $r"; fail=1; }
  r="$(effective_threshold 11 abc 50)"; [ "${r%%|*}" = "11" ]   || { echo "  FAIL eff-nonnum: $r"; fail=1; }
  # E6 non-numeric threshold survives untouched (scaling it would yield 0.0 = skip forever).
  r="$(effective_threshold abc 50 50)"; [ "${r%%|*}" = "abc" ]  || { echo "  FAIL eff-badthr: $r"; fail=1; }
  # E7 THE AXIS MUST CHANGE A VERDICT, not just arithmetic: same load1=8, throttled box SKIPs,
  #    unknown-effectivity box PROCEEDs. Without this leg the scaling could be inert and still green.
  te="$(effective_threshold 11 50 50)";  te="${te%%|*}"
  r="$(decide 8 "$te" 12 "")"; echo "$r" | grep -q '^SKIP'      || { echo "  FAIL eff-verdict-skip: $r"; fail=1; }
  tu="$(effective_threshold 11 "" 50)";  tu="${tu%%|*}"
  r="$(decide 8 "$tu" 12 "")"; echo "$r" | grep -q '^PROCEED'   || { echo "  FAIL eff-verdict-proceed: $r"; fail=1; }
  # E8 PARSE TRAP: the state line's free-text reason also carries `ratio=NN%`. A greedy
  #    `sed 's/.*ratio=//'` reads the REASON (77) instead of the FIELD (42). Field-exact parse only.
  _sf="$(mktemp -t loadgate-cpufreq.XXXXXX)" || _sf=""
  if [ -n "$_sf" ]; then
    printf 'REDUCED|governor=powersave|avg_khz=1900000|max_khz=4663089|ratio=42|n_cpus=16|n_offline=0|ratio=77%% (bogus decoy in reason)\n' > "$_sf"
    r="$(MESH_CPUFREQ_STATE="$_sf" _cpufreq_ratio)"
    [ "$r" = "42" ] || { echo "  FAIL eff-parse-field (got '$r', want 42 — greedy parse read the reason): $r"; fail=1; }
    # Stale artifact -> unknown (a fossil effectivity must not gate a live box).
    touch -d '3 hours ago' "$_sf" 2>/dev/null && {
      r="$(MESH_CPUFREQ_STATE="$_sf" MESH_LOAD_GATE_EFF_TTL=1800 _cpufreq_ratio)"
      [ -z "$r" ] || { echo "  FAIL eff-stale (got '$r', want empty): $r"; fail=1; }
    }
    # OFFLINE line has no numeric ratio field -> unknown, not a faked band.
    printf 'OFFLINE|governor=NA|avg_khz=|max_khz=|ratio=|n_cpus=0|n_offline=0|no cpufreq sysfs\n' > "$_sf"
    r="$(MESH_CPUFREQ_STATE="$_sf" _cpufreq_ratio)"
    [ -z "$r" ] || { echo "  FAIL eff-offline (got '$r', want empty): $r"; fail=1; }
    rm -f "$_sf"
  fi
  # Missing artifact -> unknown (never a fabricated 100).
  r="$(MESH_CPUFREQ_STATE=/nonexistent/cpufreq-state _cpufreq_ratio)"
  [ -z "$r" ] || { echo "  FAIL eff-absent (got '$r', want empty): $r"; fail=1; }

  # E9 END-TO-END: the flag must MOVE THE THRESHOLD in a REAL invocation. E1-E8 assert the pure
  # functions and E7 asserts they compose — but a mutation that computes the scaled value and then
  # DISCARDS it (never reassigns THR) passes every one of them. Source text is never behaviour: drive
  # the script itself, same load, two flag states, and demand the exit code FLIPS.
  # thr = load1*1.5 straddles the band: plain (thr) proceeds, effectivity-scaled (thr*0.5) sheds.
  # Children get MESH_DISK_FLOOR_MB=0 (isolate the load axis from a low-disk SKIP), a scratch LOG
  # (never forge the real shed log), and an explicitly UNSET effectivity env (a test child inherits
  # exported node-local tuning, which would make the plain leg secretly the scaled one).
  _l1e="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
  if [ -n "$_l1e" ] && [ "$(awk -v l="$_l1e" 'BEGIN{print (l>0.05)?1:0}' 2>/dev/null)" = 1 ]; then
    _sfe="$(mktemp -t loadgate-e2e.XXXXXX)"; _lge="$(mktemp -t loadgate-e2elog.XXXXXX)"
    printf 'THROTTLED|governor=powersave|avg_khz=200000|max_khz=4663089|ratio=1|n_cpus=16|n_offline=0|ratio=1%% (heavy underclock)\n' > "$_sfe"
    _te="$(awk -v l="$_l1e" 'BEGIN{printf "%.2f", l*1.5}')"
    env -u MESH_LOAD_GATE_EFFECTIVITY MESH_CPUFREQ_STATE="$_sfe" MESH_LOAD_GATE_LOG="$_lge" \
        MESH_DISK_FLOOR_MB=0 bash "$0" e2e-plain "$_te" >/dev/null 2>&1; _rc_plain=$?
    env -u MESH_LOAD_GATE_EFFECTIVITY MESH_CPUFREQ_STATE="$_sfe" MESH_LOAD_GATE_LOG="$_lge" \
        MESH_DISK_FLOOR_MB=0 bash "$0" --effectivity e2e-eff "$_te" >/dev/null 2>&1; _rc_eff=$?
    [ "$_rc_plain" = 0 ] || { echo "  FAIL e2e-plain (want PROCEED rc=0 at load1=$_l1e thr=$_te, got $_rc_plain)"; fail=1; }
    [ "$_rc_eff" = 1 ]   || { echo "  FAIL e2e-eff (want SKIP rc=1 at half-scaled thr, got $_rc_eff — the flag never moved THR)"; fail=1; }
    grep -q 'e2e-eff.*effectivity=1%' "$_lge" 2>/dev/null \
      || { echo "  FAIL e2e-note (shed log carries no effectivity attribution): $(tail -1 "$_lge" 2>/dev/null)"; fail=1; }
    grep -q 'e2e-plain' "$_lge" 2>/dev/null && { echo "  FAIL e2e-plain-logged (plain leg shed — band did not straddle)"; fail=1; }
    _e2e="e2e flip @load1=$_l1e"
    rm -f "$_sfe" "$_lge"
  else
    # No silent caps: an idle box cannot straddle the band, and that ABSENCE must be visible.
    _e2e="e2e SKIPPED (load1='$_l1e' too low to straddle — end-to-end leg did not run)"
  fi

  # --- HOMEOSTATIC COUPLING (Sanyal 2026 — access vs coupling) ---------------------------------
  # C1-C6 the pure classifier. Note C2/C3: the null band and the practical floor must EACH be able to
  # veto an ASSOCIATED verdict on their own — a null-only test passes a build with the floor deleted.
  r="$(cs_classify 500 100 200  820  40 5000)"; [ "${r%%|*}" = ASSOCIATED-UNROUTED ] || { echo "  FAIL cs-assoc: $r"; fail=1; }
  # null-veto leg: effect is ABOVE the practical floor, so ONLY the null band can veto it (an
  # effect under the floor is vetoed by the floor whether the null works or not — that fixture
  # tests nothing and let a deleted null-band survive).
  r="$(cs_classify 500 100 200  150 200 5000)"; [ "${r%%|*}" = INERT-ACCESS ]        || { echo "  FAIL cs-null-veto: $r"; fail=1; }
  # floor-veto leg: effect BEATS the null, so only the floor can veto it.
  r="$(cs_classify 500 100 200   60  40 5000)"; [ "${r%%|*}" = INERT-ACCESS ]        || { echo "  FAIL cs-floor-veto: $r"; fail=1; }
  r="$(cs_classify 500 100 200 -820  40 5000)"; [ "${r%%|*}" = ASSOCIATED-UNROUTED ] || { echo "  FAIL cs-neg-effect: $r"; fail=1; }
  # C5 the regulator's own output must have MOVED — a gate that never shed explains nothing.
  r="$(cs_classify 500 100   0  820  40 5000)"; [ "${r%%|*}" = NO-OUTPUT-VARIANCE ]  || { echo "  FAIL cs-novar-0: $r"; fail=1; }
  r="$(cs_classify 500 100 500  820  40 5000)"; [ "${r%%|*}" = NO-OUTPUT-VARIANCE ]  || { echo "  FAIL cs-novar-all: $r"; fail=1; }
  # C6 honest refusals: too little data, and a peer whose load never moved (distress has no referent).
  r="$(cs_classify  20 100 200  820  40 5000)"; [ "${r%%|*}" = INSUFFICIENT ]        || { echo "  FAIL cs-insuff-n: $r"; fail=1; }
  r="$(cs_classify 500   2 200  820  40 5000)"; [ "${r%%|*}" = INSUFFICIENT ]        || { echo "  FAIL cs-insuff-high: $r"; fail=1; }
  r="$(cs_classify 500 100 200  820  40   50)"; [ "${r%%|*}" = NO-DISTURBANCE ]      || { echo "  FAIL cs-nodist: $r"; fail=1; }
  # C7 the load sweep (paper's second result), incl. the unresolvable-threshold -> UNKNOWN guard that
  #    keeps a missing threshold from reading as a confident NO-RESCUE.
  r="$(cs_rescue 100 95)"; [ "${r%%|*}" = HEADROOM ]  || { echo "  FAIL cs-resc-head: $r"; fail=1; }
  r="$(cs_rescue 100 10)"; [ "${r%%|*}" = NO-RESCUE ] || { echo "  FAIL cs-resc-none: $r"; fail=1; }
  r="$(cs_rescue 100 50)"; [ "${r%%|*}" = MIXED ]     || { echo "  FAIL cs-resc-mixed: $r"; fail=1; }
  r="$(cs_rescue 100 -1)"; [ "${r%%|*}" = UNKNOWN ]   || { echo "  FAIL cs-resc-unknown: $r"; fail=1; }
  r="$(cs_rescue   0  0)"; [ "${r%%|*}" = UNKNOWN ]   || { echo "  FAIL cs-resc-nohigh: $r"; fail=1; }

  # C8 END-TO-END on synthetic logs. The classifier can be perfect while the PIPELINE that feeds it
  # (bucket alignment, per-peer quantile, circular-shift null) is wrong — so drive cs_report itself and
  # demand it separate a coupled fleet from an inert one using ONLY the two real artifact formats.
  _cd="$(mktemp -d -t loadgate-cstest.XXXXXX)"
  if [ -n "$_cd" ]; then
    # 300 five-minute buckets. Peer is distressed (load 9) in the LAST 60 — one contiguous block, so a
    # circular shift genuinely breaks the alignment (a periodic block could survive one).
    # rule: coupled (peer high == shed, one contiguous block) · every3 (shed on a fixed cadence,
    # independent of the peer) · never (no shed at all) · periodic (peer high AND shed share the same
    # 2h period — a real effect of +1.0 that ANY circular shift by a whole period reproduces, so the
    # null must veto it) · noithr (shed lines that carry no `threshold=`, e.g. disk-floor skips).
    _mk() {  # _mk <outdir> <rule> <n_buckets>
      local d="$1" rule="$2" nb="${3:-300}" i m day ts pl hi
      : > "$d/care"; : > "$d/shed"
      i=0
      while [ "$i" -lt "$nb" ]; do
        day=$(( 10 + i / 288 )); m=$(( (i % 288) * 5 ))
        ts="$(printf '2026-06-%02dT%02d:%02dZ' "$day" $(( m / 60 )) $(( m % 60 )))"
        # periodic: 4 of every 24 buckets (16.7% < the 20% tail the q80 cut takes), so the quantile
        # lands BELOW the plateau. A high band wider than (100-CS_Q)% puts the cut INSIDE it and
        # `> hi` yields zero distressed buckets — an honest INSUFFICIENT, but a useless fixture.
        case "$rule" in periodic) [ $(( i % 24 )) -lt 4 ] && hi=1 || hi=0 ;;
                        *)        [ "$i" -ge 240 ] && hi=1 || hi=0 ;; esac
        [ "$hi" = 1 ] && pl=9.00 || pl=1.00
        if [ "$rule" = twoscale ]; then
          # Two peers, ten-fold apart in absolute load — a 2-core box and a 16-core box.
          [ "$hi" = 1 ] && printf '%s small raw=OK committed=OK :: temp=n/a load=1.80 disk=10%% mem=10%% up=1m\n' "$ts" >> "$d/care" \
                        || printf '%s small raw=OK committed=OK :: temp=n/a load=0.20 disk=10%% mem=10%% up=1m\n' "$ts" >> "$d/care"
          [ "$hi" = 1 ] && printf '%s big raw=OK committed=OK :: temp=n/a load=18.00 disk=10%% mem=10%% up=1m\n' "$ts" >> "$d/care" \
                        || printf '%s big raw=OK committed=OK :: temp=n/a load=2.00 disk=10%% mem=10%% up=1m\n' "$ts" >> "$d/care"
        else
        printf '%s peer raw=OK committed=OK :: temp=n/a load=%s disk=10%% mem=10%% up=1m\n' "$ts" "$pl" >> "$d/care"
        fi
        printf '%s selfnode raw=OK committed=OK :: temp=n/a load=2.00 disk=10%% mem=10%% up=1m\n' "$ts" >> "$d/care"
        case "$rule" in
          coupled|periodic|twoscale) [ "$hi" = 1 ] && printf '%s [load-gate] SKIP x — load1=20 > threshold=11\n' "${ts%Z}:00Z" >> "$d/shed" ;;
          every3)  [ $(( i % 3 )) -eq 0 ] && printf '%s [load-gate] SKIP x — load1=20 > threshold=11\n' "${ts%Z}:00Z" >> "$d/shed" ;;
          noithr)  [ "$hi" = 1 ] && printf '%s [load-gate] SKIP x — disk-floor free=1MB < floor=2048MB\n' "${ts%Z}:00Z" >> "$d/shed" ;;
        esac
        i=$(( i + 1 ))
      done
    }
    mkdir -p "$_cd/c" "$_cd/i" "$_cd/n" "$_cd/p" "$_cd/u" "$_cd/s"
    _mk "$_cd/c" coupled; _mk "$_cd/i" every3; _mk "$_cd/n" never
    _mk "$_cd/p" periodic 288; _mk "$_cd/u" noithr; _mk "$_cd/s" twoscale
    # Span must reach a 2026-06 fixture from today; 1e6 hours is ~114y and costs nothing.
    _csrun() { cs_report 1000000 "$1/care" "$1/shed" selfnode 11 2>/dev/null; }
    r="$(_csrun "$_cd/c" | tail -1)"; [ "$r" = "COUPLING-STATE: ASSOCIATED-UNROUTED" ] \
      || { echo "  FAIL cs-e2e-coupled (want ASSOCIATED-UNROUTED): $r"; fail=1; }
    r="$(_csrun "$_cd/i" | tail -1)"; [ "$r" = "COUPLING-STATE: INERT-ACCESS" ] \
      || { echo "  FAIL cs-e2e-inert (want INERT-ACCESS): $r"; fail=1; }
    r="$(_csrun "$_cd/n" | tail -1)"; [ "$r" = "COUPLING-STATE: NO-OUTPUT-VARIANCE" ] \
      || { echo "  FAIL cs-e2e-novar (want NO-OUTPUT-VARIANCE): $r"; fail=1; }
    # C9 the rescue axis must read the REAL loads: self=2.00 < thr=11 in every bucket -> HEADROOM;
    #    the same fixture read against a threshold of 1 (box saturated) must flip to NO-RESCUE.
    r="$(_csrun "$_cd/c" | grep -c 'rescue=HEADROOM')"; [ "$r" -ge 1 ] \
      || { echo "  FAIL cs-e2e-rescue-headroom"; fail=1; }
    r="$(cs_report 1000000 "$_cd/c/care" "$_cd/c/shed" selfnode 11 2>/dev/null | grep -c 'rescue=NO-RESCUE')"
    [ "$r" = 0 ] || { echo "  FAIL cs-e2e-rescue-contamination"; fail=1; }
    # C10 NO-ACCESS is a real state, not a crash: a node with no peer-distress artifact at all.
    r="$(cs_report 1000000 /nonexistent/node-care.log "$_cd/c/shed" selfnode 11 2>/dev/null | tail -1)"
    case "$r" in *NO-ACCESS*) ;; *) echo "  FAIL cs-e2e-noaccess: $r"; fail=1 ;; esac
    # C11 THE SHIFT NULL MUST VETO A REAL EFFECT END-TO-END. In the periodic fixture the raw effect is
    #     +1.000 — shed happens in exactly the peer's distressed buckets — yet peer-high and shed share
    #     one 2h period, so a shift by a whole period reproduces it: a coincidence of cadence, not
    #     coupling. K=11 over 288 buckets puts every shift on a period multiple. Without this leg the
    #     entire circular-shift machinery can be deleted (null=0) and every other case still passes.
    _cs_k="$CS_SHIFTS"; CS_SHIFTS=11
    r="$(_csrun "$_cd/p" | tail -1)"; [ "$r" = "COUPLING-STATE: INERT-ACCESS" ] \
      || { echo "  FAIL cs-e2e-shift-null (periodic coincidence must NOT read as coupling): $r"; fail=1; }
    CS_SHIFTS="$_cs_k"
    # C12 an unresolvable threshold must degrade the load sweep to UNKNOWN, never to a confident
    #     NO-RESCUE (headroom would otherwise compare every load against a threshold of 0).
    r="$(cs_report 1000000 "$_cd/u/care" "$_cd/u/shed" selfnode "" 2>/dev/null)"
    case "$r" in *rescue=UNKNOWN*) ;; *) echo "  FAIL cs-e2e-thr-unknown: $(echo "$r" | sed -n 2p)"; fail=1 ;; esac
    # C13 stage 1's bucket keys must be real 5-min-floored TIMESTAMPS — a bucket ordinal sorts
    #     "10" before "9" and hands the shift null a scrambled series. Assert the pipeline's own
    #     dumped artifact, not the source text.
    MESH_COUPLING_DUMP="$_cd/dump" _csrun "$_cd/c" >/dev/null 2>&1
    r="$(awk -F'|' '$2 !~ /^2026-06-[0-9][0-9]T[0-2][0-9]:[0-5][05]$/' "$_cd/dump" 2>/dev/null | head -1)"
    [ -z "$r" ] && [ -s "$_cd/dump" ] \
      || { echo "  FAIL cs-e2e-bucketkey (bad/absent bucket key): '$r'"; fail=1; }
    r="$(awk -F'|' '{print $2}' "$_cd/dump" 2>/dev/null)"
    [ "$r" = "$(printf '%s\n' "$r" | sort)" ] \
      || { echo "  FAIL cs-e2e-bucketorder (rows not chronological)"; fail=1; }
    # C14 DISTRESS IS PER-PEER, NEVER A SHARED ABSOLUTE NUMBER. Two peers ten-fold apart in load
    #     (a 2-core box and a 16-core box), both perfectly coupled: the self-calibrated quantile must
    #     find BOTH. Any fixed absolute cut reads one of them as never-distressed (INSUFFICIENT) —
    #     without this leg the whole per-peer calibration can be replaced by a constant and stay green.
    r="$(_csrun "$_cd/s" | grep -cE '^  (small|big) +ASSOCIATED-UNROUTED')"
    [ "$r" = 2 ] || { echo "  FAIL cs-e2e-per-peer-scale (want both peers ASSOCIATED, got $r):"; _csrun "$_cd/s" | sed -n '2,5p'; fail=1; }
    _cse2e="coupling e2e 6 fixtures"
    rm -rf "$_cd"
  else
    _cse2e="coupling e2e SKIPPED (no tmpdir)"
  fi

  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # REAL-READ gate: the /proc file must be readable and parse to a float, else the gate is hollow.
  _p="/proc/loadavg"
  [ -r "$_p" ] || { echo "smoke-test: n/a (/proc/loadavg unreadable); decide-logic ok (8 cases)"; exit 2; }
  _l1="$(awk '{print $1}' "$_p" 2>/dev/null)"
  printf '%f' "$_l1" >/dev/null 2>&1 || { echo "smoke-test: n/a (loadavg unparseable: '$_l1'); decide-logic ok"; exit 2; }
  # REAL disk read: df on $HOME must parse to MB, else the disk axis fail-opens on every run —
  # a hollow sense that never skips (real-read gate, same doctrine as the loadavg read above).
  _fm="$(df -Pm "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"
  case "$_fm" in ''|*[!0-9]*) echo "smoke-test: FAIL (df -Pm \$HOME unparseable: '$_fm' — disk-floor axis is hollow)"; exit 1;; esac
  # REAL effectivity read: where mesh-cpufreq's artifact exists and is fresh, the parse MUST yield an
  # integer — otherwise --effectivity is a hollow axis that silently never scales. Absent/stale is
  # honest (the artifact is optional, the axis is opt-in), so it reports rather than fails.
  _er="$(_cpufreq_ratio)"
  if [ -n "$_er" ]; then
    case "$_er" in *[!0-9]*) echo "smoke-test: FAIL (cpufreq ratio unparseable: '$_er' — effectivity axis is hollow)"; exit 1;; esac
    _et="$(effective_threshold 11 "$_er" "${MESH_LOAD_GATE_EFF_FLOOR:-50}")"
    _ev="REAL cpufreq read: eff=${_er}% -> ${_et%%|*}"
  else
    _ev="eff=unknown (no fresh ~/.mesh/.cpufreq-state — --effectivity degrades to unscaled)"
  fi
  echo "smoke-test: ok (decide 12 + effectivity 18 cases + coupling 25 cases + REAL loadavg read: load1=$_l1 + REAL df read: free=${_fm}MB + $_ev + $_e2e + $_cse2e)"
  exit 0
fi

# Calibrated constants resolve env > uxn threshold-ledger (gates-as-data, row load-gate
# k=… q0=… q1=…) > inline fallback. The ledger read is pure data (mesh-sexpr-gate --const,
# naturals-only); no genome checkout / corrupt value degrades to the old inline numbers —
# fail-open doctrine unchanged. Recalibrating the load factor or quiet window is a diff on
# scripts/uxn/threshold-ledger, not on this script.
_ledger_const() { # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
_quiet_default(){ printf '%s-%s\n' "$(_ledger_const load-gate q0 1)" "$(_ledger_const load-gate q1 6)"; }
_thr_default(){ # nproc * k/100, k in centi (ledger k=90 ⇒ the old 0.9 factor)
  awk -v n="$1" -v k="$(_ledger_const load-gate k 90)" 'BEGIN{printf "%.1f", n*k/100}'
}

if [ "${1:-}" = --thresholds ]; then
  # observable artifact of the resolution (env > ledger > inline), same paths the run takes
  NPROC="$(nproc 2>/dev/null)"; [ -n "$NPROC" ] && [ "$NPROC" -gt 0 ] 2>/dev/null || NPROC=1
  _t="${MESH_LOAD_GATE_MAX:-$(_thr_default "$NPROC")}"
  echo "thr=$_t quiet=${MESH_QUIET_HOURS:-$(_quiet_default)} floor=${MESH_DISK_FLOOR_MB:-$(_ledger_const disk-free-floor floor 2048)}"
  # the action-scaled boundary is ALWAYS shown (observable), even when the axis is not enabled —
  # so the difference between the geometric and the effectivity-scaled gate is legible at a glance.
  _e="$(_cpufreq_ratio)"
  _es="$(effective_threshold "$_t" "$_e" "${MESH_LOAD_GATE_EFF_FLOOR:-50}")"
  echo "eff_enabled=$([ -n "${MESH_LOAD_GATE_EFFECTIVITY:-}" ] && echo 1 || echo 0) eff_thr=${_es%%|*} — ${_es#*|}"
  exit 0
fi

if [ "${1:-}" = --coupling ]; then
  # Default span 168h: the whole question is whether the gate's behaviour tracks a peer's, and a 24h
  # read on a fleet whose stress episodes are days apart answers about a window, not about the mesh
  # (mesh-pace's control-mode read was ISOLATED at 24h and METASTABLE at 480h — span is a parameter).
  _sp="${2:-168}"; case "$_sp" in ''|*[!0-9]*) _sp=168 ;; esac
  _np="$(nproc 2>/dev/null)"; [ -n "$_np" ] && [ "$_np" -gt 0 ] 2>/dev/null || _np=1
  cs_report "$_sp" "${MESH_NODECARE_LOG:-$HOME/.mesh/node-care.log}" "$LOG" \
            "${MESH_COUPLING_SELF:-$(hostname)}" "${MESH_LOAD_GATE_MAX:-$(_thr_default "$_np")}"
  exit 0
fi

QUIET=""; EFF=""
[ -n "${MESH_LOAD_GATE_EFFECTIVITY:-}" ] && EFF=1
while :; do
  case "${1:-}" in
    --quiet-hours) QUIET="${MESH_QUIET_HOURS:-$(_quiet_default)}"; shift ;;
    --effectivity) EFF=1; shift ;;
    *) break ;;
  esac
done

NAME="${1:-reflex}"
NPROC="$(nproc 2>/dev/null)"; [ -n "$NPROC" ] && [ "$NPROC" -gt 0 ] 2>/dev/null || NPROC=1
DEFAULT_THR="$(_thr_default "$NPROC")"
THR="${2:-${MESH_LOAD_GATE_MAX:-$DEFAULT_THR}}"

# ACTION-SCALING: re-scale the shed boundary to the body's CURRENT effectivity, not its static core
# geometry (see the ACTION-SCALING note in the header). Opt-in; unknown/stale effectivity -> unscaled.
EFF_NOTE=""
if [ -n "$EFF" ]; then
  _scaled="$(effective_threshold "$THR" "$(_cpufreq_ratio)" "${MESH_LOAD_GATE_EFF_FLOOR:-50}")"
  THR="${_scaled%%|*}"; EFF_NOTE=" [${_scaled#*|}]"
fi

L1="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
[ -n "$L1" ] || L1="unreadable"
HOUR="$(date +%-H 2>/dev/null || date +%H | sed 's/^0//')"
# Disk floor (ledger row disk-free-floor, the stage-3 admitted gate — now consumed): free MB on
# the partition holding $HOME, where the heavy reflexes' renders/records land. Unreadable df ->
# empty -> decide fail-opens, same doctrine as the load axis.
FLOOR="${MESH_DISK_FLOOR_MB:-$(_ledger_const disk-free-floor floor 2048)}"
FREE="$(df -Pm "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"

VERDICT="$(decide "$L1" "$THR" "$HOUR" "$QUIET" "$FREE" "$FLOOR")"
ACTION="${VERDICT%%|*}"; REASON="${VERDICT#*|}"

if [ "$ACTION" = SKIP ]; then
  printf '%s [load-gate] SKIP %s — %s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NAME" "$REASON" "$EFF_NOTE" >> "$LOG" 2>/dev/null || true
  exit 1
fi
exit 0
