#!/usr/bin/env bash
# mesh-ss-test — verify Shadowsocks tunnel end-to-end
# Installs local SS client, connects through phaedra, reports egress IP/location.
# Exit 0 = tunnel OK, 1 = config error, 2 = unreachable, 3 = tunnel relay failed.
# reflex-cadence: */10
# reflex-args: --edge

set -euo pipefail

PHAEDRA="phaedra"
LOCAL_PORT=11080
TIMEOUT=20
V2RAY_PLUGIN="${HOME}/.local/bin/v2ray-plugin"

do_test() {
  local TESTS_FAILED=0
  test_ok() { echo "  ok: $1"; }
  test_fail() { TESTS_FAILED=$((TESTS_FAILED + 1)); echo "  FAIL: $1"; }

  command -v ss-local >/dev/null 2>&1 && test_ok "ss-local found" || test_fail "ss-local not installed"
  command -v nc >/dev/null 2>&1 && test_ok "nc found" || test_fail "nc not installed"
  ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" >/dev/null 2>&1 && test_ok "phaedra SS config readable" || test_fail "phaedra SS config not readable"
  if [ -x "$V2RAY_PLUGIN" ]; then
    test_ok "v2ray-plugin found $($V2RAY_PLUGIN --version 2>&1 | head -1)"
  else
    test_fail "v2ray-plugin not installed at $V2RAY_PLUGIN"
  fi
  if [ $TESTS_FAILED -gt 0 ]; then echo "smoke-test: FAIL"; exit 1; fi
  echo "smoke-test: ok"
  exit 0
}

TEST_ALL=0; PORT=""; EDGE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --test) do_test;;
    --watch) WATCH=1; shift;;
    --edge) EDGE=1; shift;;
    --json) JSON=1; shift;;
    --port) PORT="$2"; shift 2;;
    --all) TEST_ALL=1; shift;;
    *) echo "usage: $0 [--test] [--watch] [--edge] [--json] [--port <n>] [--all]"; exit 1;;
  esac
done

# State tracking for --edge (fire only on status transitions)
STATE_FILE="$HOME/.mesh/.ss-test.state"
PREV=$(cat "$STATE_FILE" 2>/dev/null || echo "UNKNOWN")

# Read config from phaedra (same as mesh-ss-config)
CONF=$(timeout 15 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" 2>/dev/null) || {
  echo "mesh-ss-test: FAIL — cannot read SS config from phaedra" >&2
  exit 2
}
SS_HOST=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('server',''))") || exit 2
SS_PORT=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('server_port',''))") || exit 2
PASSWORD=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('password',''))") || exit 2
METHOD=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('method',''))") || exit 2

# Resolve phaedra's public IP (config has 127.0.0.1 — internal v2ray chain)
if [ "$SS_HOST" = "0.0.0.0" ] || [ "$SS_HOST" = "127.0.0.1" ]; then
  SS_HOST=$(ssh -o StrictHostKeyChecking=no "$PHAEDRA" "curl -s ifconfig.me 2>/dev/null || dig +short myip.opendns.com @resolver1.opendns.com 2>/dev/null" 2>/dev/null) || {
    SS_HOST="38.49.216.141"
  }
fi

# Install ss-local if missing
if ! command -v ss-local >/dev/null 2>&1; then
  echo "mesh-ss-test: installing shadowsocks-libev client..." >&2
  sudo apt-get install -y shadowsocks-libev >/dev/null 2>&1 || {
    echo "mesh-ss-test: FAIL — could not install ss-local" >&2
    exit 2
  }
fi

# Ensure v2ray-plugin is installed (required for TLS front on phaedra)
if ! [ -x "$V2RAY_PLUGIN" ]; then
  echo "mesh-ss-test: installing v2ray-plugin..." >&2
  mkdir -p "$HOME/.local/bin"
  scp "$PHAEDRA:/usr/local/bin/v2ray-plugin" "$V2RAY_PLUGIN" >/dev/null 2>&1 || {
    timeout 30 curl -sL "https://github.com/shadowsocks/v2ray-plugin/releases/download/v1.3.2/v2ray-plugin-linux-amd64-v1.3.2.tar.gz" 2>/dev/null | tar xz -C "$HOME/.local/bin/" 2>/dev/null || {
      echo "mesh-ss-test: FAIL — could not install v2ray-plugin" >&2; exit 2
    }
  }
  chmod +x "$V2RAY_PLUGIN"
fi

# Get v2ray-plugin TLS hostname from phaedra
V2RAY_HOST=$(ssh -o StrictHostKeyChecking=no "$PHAEDRA" "grep -oP '(?<=-host )\S+' /etc/systemd/system/v2ray-plugin.service 2>/dev/null | head -1") || V2RAY_HOST=""
if [ -z "$V2RAY_HOST" ]; then
  V2RAY_HOST="38-49-216-141.sslip.io"
fi

TMPDIR=$(mktemp -d)
CLIENT_CONF="$TMPDIR/ss-test.json"

cleanup() { kill $SSPID 2>/dev/null || true; wait $SSPID 2>/dev/null || true; rm -rf "$TMPDIR" 2>/dev/null || true; }
trap cleanup EXIT

# Determine which ports to test
if [ "$TEST_ALL" = 1 ]; then
  PORTS="$SS_PORT"
  # Check for active alt ports on phaedra
  for u in $(ssh -o StrictHostKeyChecking=no "$PHAEDRA" "systemctl list-units --all 'ss-alt-*' 2>/dev/null | grep -oP 'ss-alt-\K[0-9]+'" 2>/dev/null); do
    PORTS="$PORTS $u"
  done
elif [ -n "$PORT" ]; then
  PORTS="$PORT"
else
  PORTS="$SS_PORT"
fi

OVERALL_EXIT=0
FIRST=1
NEW_STATE=""

for TEST_PORT in $PORTS; do
  [ "$FIRST" = 1 ] && FIRST=0 || echo ""

  # Build config with v2ray-plugin for ports that go through TLS front (443, 80)
  if [ "$TEST_PORT" = 443 ] || [ "$TEST_PORT" = 80 ]; then
    PLUGIN_CONF='"plugin": "'"$V2RAY_PLUGIN"'", "plugin_opts": "tls;host='"$V2RAY_HOST"'",'
  else
    PLUGIN_CONF=""
  fi

  cat > "$CLIENT_CONF" << JSON
{
  "server": "$SS_HOST",
  "server_port": $TEST_PORT,
  "password": "$PASSWORD",
  "method": "$METHOD",
  $PLUGIN_CONF
  "local_address": "127.0.0.1",
  "local_port": $LOCAL_PORT,
  "timeout": 5
}
JSON

  # Start local SS client (v2ray-plugin needs extra init time)
  ss-local -c "$CLIENT_CONF" > /dev/null 2>&1 &
  SSPID=$!
  sleep 4
  if ! kill -0 $SSPID 2>/dev/null; then
    if [ "${JSON:-0}" = 1 ]; then
      echo "{\"port\":$TEST_PORT,\"status\":\"FAIL\",\"error\":\"ss-local failed\"}"
    else
      echo "mesh-ss-test: port $TEST_PORT — FAIL (ss-local failed to start)" >&2
    fi
    OVERALL_EXIT=3
    continue
  fi

  # Test TCP relay through the tunnel
  RESULT=$(timeout $TIMEOUT bash -c '
  echo -e "GET / HTTP/1.0\r\nHost: ipinfo.io\r\n\r\n" | nc -w 8 -x 127.0.0.1:'$LOCAL_PORT' ipinfo.io 80 2>/dev/null
  ' 2>&1) || true

  kill $SSPID 2>/dev/null || true; wait $SSPID 2>/dev/null || true; SSPID=""

  EGRESS_IP=$(echo "$RESULT" | grep -oP '"ip":\s*"\K[^"]+') || true
  COUNTRY=$(echo "$RESULT" | grep -oP '"country":\s*"\K[^"]+') || true
  CITY=$(echo "$RESULT" | grep -oP '"city":\s*"\K[^"]+') || true

  if [ -z "$EGRESS_IP" ]; then
    if [ "${JSON:-0}" = 1 ]; then
      echo "{\"port\":$TEST_PORT,\"status\":\"FAIL\",\"error\":\"TCP relay timeout\"}"
    else
      echo "mesh-ss-test: port $TEST_PORT — FAIL (TCP relay timeout)"
    fi
    OVERALL_EXIT=3
    continue
  fi

  if [ "$EGRESS_IP" = "$SS_HOST" ]; then
    PORT_STATUS="PASS"
  else
    PORT_STATUS="UNEXPECTED"
    OVERALL_EXIT=1
  fi

  PORT_KEY="port_${TEST_PORT}"
  PORT_LABEL="${PORT_STATUS}:${EGRESS_IP}"

  if [ "${JSON:-0}" = 1 ]; then
    echo "{\"port\":$TEST_PORT,\"status\":\"$PORT_STATUS\",\"egress_ip\":\"$EGRESS_IP\",\"city\":\"${CITY:-unknown}\",\"country\":\"${COUNTRY:-unknown}\"}"
  elif [ "$EDGE" = 1 ]; then
    PREV_PORT=$(echo "$PREV" | grep "^${PORT_KEY}=" | cut -d= -f2) || true
    if [ "$PORT_LABEL" != "$PREV_PORT" ]; then
      echo "[ss-test] port $TEST_PORT — $PORT_STATUS (egress $EGRESS_IP)"
    fi
  else
    echo "mesh-ss-test: port $TEST_PORT — $PORT_STATUS (egress $EGRESS_IP, ${CITY:-unknown}, ${COUNTRY:-unknown})"
  fi
  NEW_STATE="${NEW_STATE}${PORT_KEY}=${PORT_LABEL}"$'\n'
done

# Save state for next --edge run
printf '%s' "$NEW_STATE" > "$STATE_FILE" 2>/dev/null || true

exit $OVERALL_EXIT
