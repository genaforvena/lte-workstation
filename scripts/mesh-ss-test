#!/usr/bin/env bash
# mesh-ss-test — verify Shadowsocks tunnel end-to-end
# Installs local SS client, connects through phaedra, reports egress IP/location.
# Exit 0 = tunnel OK, 1 = config error, 2 = unreachable, 3 = tunnel relay failed.
# reflex-cadence: */10

set -euo pipefail

PHAEDRA="phaedra"
LOCAL_PORT=11080
TIMEOUT=10

do_test() {
  local TESTS_FAILED=0
  test_ok() { echo "  ok: $1"; }
  test_fail() { TESTS_FAILED=$((TESTS_FAILED + 1)); echo "  FAIL: $1"; }

  command -v ss-local >/dev/null 2>&1 && test_ok "ss-local found" || test_fail "ss-local not installed"
  command -v nc >/dev/null 2>&1 && test_ok "nc found" || test_fail "nc not installed"
  ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" >/dev/null 2>&1 && test_ok "phaedra SS config readable" || test_fail "phaedra SS config not readable"
  if [ $TESTS_FAILED -gt 0 ]; then echo "smoke-test: FAIL"; exit 1; fi
  echo "smoke-test: ok"
  exit 0
}

while [ $# -gt 0 ]; do
  case "$1" in
    --test) do_test;;
    --watch) WATCH=1; shift;;
    --json) JSON=1; shift;;
    *) echo "usage: $0 [--test] [--watch] [--json]"; exit 1;;
  esac
done

# Read config from phaedra (same as mesh-ss-config)
CONF=$(timeout 15 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" 2>/dev/null) || {
  echo "mesh-ss-test: FAIL — cannot read SS config from phaedra" >&2
  exit 2
}
SS_HOST=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('server',''))") || exit 2
SS_PORT=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('server_port',''))") || exit 2
PASSWORD=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('password',''))") || exit 2
METHOD=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('method',''))") || exit 2

# Resolve phaedra's public IP if server is 0.0.0.0
if [ "$SS_HOST" = "0.0.0.0" ]; then
  SS_HOST=$(ssh -o StrictHostKeyChecking=no "$PHAEDRA" "curl -s ifconfig.me 2>/dev/null || dig +short myip.opendns.com @resolver1.opendns.com 2>/dev/null" 2>/dev/null) || {
    SS_HOST="38.49.216.141"
  }
fi

# Install ss-local if missing
if ! command -v ss-local >/dev/null 2>&1; then
  echo "mesh-ss-test: installing shadowsocks-libev client..." >&2
  sudo apt-get install -y shadowsocks-libev >/dev/null 2>&1 || {
    echo "mesh-ss-test: FAIL — could not install ss-local" >&2
    exit 2
  }
fi

TMPDIR=$(mktemp -d)
CLIENT_CONF="$TMPDIR/ss-test.json"
cat > "$CLIENT_CONF" << JSON
{
  "server": "$SS_HOST",
  "server_port": $SS_PORT,
  "password": "$PASSWORD",
  "method": "$METHOD",
  "local_address": "127.0.0.1",
  "local_port": $LOCAL_PORT,
  "timeout": 5
}
JSON

cleanup() { kill $SSPID 2>/dev/null; wait $SSPID 2>/dev/null; rm -rf "$TMPDIR"; }
trap cleanup EXIT

# Start local SS client
ss-local -c "$CLIENT_CONF" > /dev/null 2>&1 &
SSPID=$!
sleep 1
if ! kill -0 $SSPID 2>/dev/null; then
  echo "mesh-ss-test: FAIL — ss-local failed to start" >&2
  exit 3
fi

# Test TCP relay through the tunnel
RESULT=$(timeout $TIMEOUT bash -c '
echo -e "GET / HTTP/1.0\r\nHost: ipinfo.io\r\n\r\n" | nc -w 4 -x 127.0.0.1:'$LOCAL_PORT' ipinfo.io 80 2>/dev/null
' 2>&1) || {
  echo "mesh-ss-test: FAIL — TCP relay failed (timeout)" >&2
  exit 3
}

EGRESS_IP=$(echo "$RESULT" | grep -oP '"ip":\s*"\K[^"]+') || true
COUNTRY=$(echo "$RESULT" | grep -oP '"country":\s*"\K[^"]+') || true
CITY=$(echo "$RESULT" | grep -oP '"city":\s*"\K[^"]+') || true

if [ -z "$EGRESS_IP" ]; then
  echo "mesh-ss-test: FAIL — tunnel responded but no valid IP in response" >&2
  echo "$RESULT" | head -5 >&2
  exit 3
fi

if [ "$EGRESS_IP" = "$SS_HOST" ]; then
  STATUS="PASS"
  EXIT=0
else
  STATUS="UNEXPECTED"
  EXIT=1
fi

if [ "${JSON:-0}" = 1 ]; then
  echo "{\"status\":\"$STATUS\",\"egress_ip\":\"$EGRESS_IP\",\"city\":\"${CITY:-unknown}\",\"country\":\"${COUNTRY:-unknown}\",\"exit\":$EXIT}"
else
  echo "mesh-ss-test :: SS tunnel end-to-end test"
  echo "  Status: ${STATUS} (egress ${EGRESS_IP})"
  echo "  Location: ${CITY:-unknown}, ${COUNTRY:-unknown}"
  echo "  Method: ${METHOD}, server ${SS_HOST}:${SS_PORT}"
  if [ "$EXIT" != 0 ]; then
    echo "  WARNING: egress IP differs from expected ${SS_HOST}"
  fi
fi

exit $EXIT
