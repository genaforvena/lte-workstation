#!/usr/bin/env bash
# mesh-ss-test — verify Shadowsocks tunnel end-to-end
# Installs local SS client, connects through phaedra, reports egress IP/location.
# Exit 0 = tunnel OK, 1 = config error, 2 = unreachable, 3 = tunnel relay failed.
# reflex-cadence: 9-59/10 * * * *
# reflex-args: --edge

set -euo pipefail

PHAEDRA="${MESH_SS_TEST_PHAEDRA:-phaedra}"  # env override: test isolation only
LOCAL_PORT=11080
TIMEOUT=20

# THE ARTIFACT (2026-07-15): this tool wrote NOTHING to disk for its whole life — every result went
# to stdout, and cron's `>> ss-test.cron.log` redirect was the only thing catching it. mesh-dash's
# vpn pane reads "$HOME/.mesh/ss-test.log" — a path that existed ONLY in that reader and in the
# comment below. No writer, ever. So the vpn window's one END-TO-END signal (the Fedya-catch: see
# the tunnel break before a USER tells us) rendered "(no ss-test artifact)" forever, which reads as
# "reflex not wired yet" while the reflex was in fact wired, firing every 10min, and passing.
# A tool OWNS its artifact; a cron redirect is not an artifact.
#
# LIVENESS vs VALUE (CLAUDE.md liveness-touch convention): --edge deliberately prints NOTHING when
# the status is unchanged — correct for the board (post only transitions), fatal for a dash. Writing
# the log only on transitions would leave `tail -1` showing an hours-old PASS as if it were current:
# exactly the "frozen 8+ hours behind the wedge" trap the ConnectTimeout comment below describes.
# So the log is written EVERY run regardless of --edge (mtime = ran-live, content = current status),
# and the dash renders its age so a dead reflex reads as stale instead of green.
#
# NEVER SILENT: the early failure exits log too. A tool that goes quiet when phaedra is unreachable
# leaves its last PASS standing as the freshest word — a faked all-clear. Unreachable renders
# UNREACHABLE (honest-fusion rule).
#
# TEST ISOLATION: --test drives a REAL run to prove the write happens, so all three mutable paths are
# env-overridable and the gate points them at temp files. A --test that appended to the real log would
# forge the very liveness it checks — mesh-doctor runs every tool's --test hourly at :23, so the dash
# would look alive because the TEST was talking, even with the reflex dead (the mesh-guardian trap,
# 09f7914). The STATE override matters just as much: a test clobbering .ss-test.state would suppress
# the next REAL transition post.
LOG="${MESH_SS_TEST_LOG:-$HOME/.mesh/ss-test.log}"
STATE_FILE="${MESH_SS_TEST_STATE:-$HOME/.mesh/.ss-test.state}"
LOCK="${MESH_SS_TEST_LOCK:-$HOME/.mesh/.ss-test.lock}"
LOG_KEEP=500

log_line() { # append one timestamped status line to the artifact, then prune
  local msg="$1"
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" >> "$LOG" 2>/dev/null || true
  if [ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt "$((LOG_KEEP * 2))" ]; then
    tail -n "$LOG_KEEP" "$LOG" > "$LOG.tmp.$$" 2>/dev/null && mv -f "$LOG.tmp.$$" "$LOG" 2>/dev/null || rm -f "$LOG.tmp.$$" 2>/dev/null || true
  fi
}

do_test() {
  local TESTS_FAILED=0
  test_ok() { echo "  ok: $1"; }
  test_fail() { TESTS_FAILED=$((TESTS_FAILED + 1)); echo "  FAIL: $1"; }

  command -v ss-local >/dev/null 2>&1 && test_ok "ss-local found" || test_fail "ss-local not installed"
  command -v nc >/dev/null 2>&1 && test_ok "nc found" || test_fail "nc not installed"
  command -v curl >/dev/null 2>&1 && test_ok "curl found" || test_fail "curl not installed"
  ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" >/dev/null 2>&1 && test_ok "phaedra SS config readable" || test_fail "phaedra SS config not readable"

  # ConnectTimeout regression (chat-review/ss-test-ssh-connecttimeout 2026-07-07): a black-holed
  # phaedra (network stall, not a clean refusal) previously hung several unguarded ssh calls
  # (SS_HOST fallback, trojan config reads, alt-port enum) indefinitely — cron fired --edge every
  # 10min all day, ~/.mesh/ss-test.log stayed frozen 8+ hours behind the wedge, no ss-test/ssh
  # process even left running (something eventually reaped it, but never in time to log).
  # (1) structural: every ssh call to "$PHAEDRA" in THIS file must carry ConnectTimeout — falsify
  #     by reverting any one of the 5 fixed call sites and this must fail.
  _unguarded="$(grep -n 'ssh .*"\$PHAEDRA"' "${BASH_SOURCE[0]}" | grep -v ConnectTimeout || true)"
  [ -z "$_unguarded" ] && test_ok "every ssh call to \$PHAEDRA carries ConnectTimeout" \
    || test_fail "ssh call(s) to \$PHAEDRA missing ConnectTimeout: $_unguarded"
  # (2) live: ConnectTimeout=5 actually bounds a black-holed target (RFC5737 TEST-NET-1,
  #     non-routable by definition) — proves the guard technique itself works, not just its presence.
  _t0=$(date +%s)
  if timeout 10 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 -o BatchMode=yes 192.0.2.1 true >/dev/null 2>&1
  then _rc=0; else _rc=$?; fi
  _t1=$(date +%s)
  if [ $((_t1 - _t0)) -le 9 ] && [ "$_rc" -ne 124 ]; then
    test_ok "ConnectTimeout=5 bounds a black-holed ssh (took $((_t1 - _t0))s)"
  else
    test_fail "ConnectTimeout=5 did not bound a black-holed ssh (took $((_t1 - _t0))s, rc=$_rc)"
  fi

  # (3) THE ARTIFACT (2026-07-15): a real run must WRITE its status line — the defect this gate
  #     exists for was that it never wrote one, so mesh-dash's vpn TUNNEL lane read a file with no
  #     writer and said "(no ss-test artifact)" forever while the reflex passed every 10min.
  #     Drives an ACTUAL run (not a stub, not a self-grep: source text is never behaviour) into a
  #     FRESH temp log, so the line cannot be a previous run's — it did not exist a second ago.
  #     This doubles as the isolation gate: the line can only land there if the run honours
  #     MESH_SS_TEST_LOG, i.e. --test cannot append to the log the dash trusts for liveness.
  #     Falsify: delete any log_line call, or hardcode the default path — this must go red.
  #     Passes whether phaedra is up or down: an unreachable phaedra must log UNREACHABLE, never
  #     go silent and leave the last PASS standing as the freshest word.
  _tdir="$(mktemp -d)"
  MESH_SS_TEST_LOG="$_tdir/ss-test.log" \
  MESH_SS_TEST_STATE="$_tdir/.ss-test.state" \
  MESH_SS_TEST_LOCK="$_tdir/.ss-test.lock" \
    timeout 90 "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
  _line="$(tail -1 "$_tdir/ss-test.log" 2>/dev/null || true)"
  if [ -z "$_line" ]; then
    test_fail "a real run wrote NO status line to its artifact (the dash lane's whole input)"
  elif printf '%s' "$_line" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z	.*(PASS|FAIL|UNREACHABLE|UNKNOWN)'; then
    test_ok "a real run writes a timestamped status line: ${_line#*$'\t'}"
  else
    test_fail "artifact line is not a timestamped status: $_line"
  fi
  rm -rf "$_tdir" 2>/dev/null || true

  if [ $TESTS_FAILED -gt 0 ]; then echo "smoke-test: FAIL"; exit 1; fi
  echo "smoke-test: ok"
  exit 0
}

TEST_ALL=0; PORT=""; EDGE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --test)
      # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a
      # private TMPDIR and remove it from the PARENT. TERM is trapped alongside EXIT because the
      # sweep runs children under `timeout` and this test outruns the first window: an EXIT-only
      # trap never fires on the SIGTERM that kills it, which is precisely when it has half-built
      # fixtures to leave behind (measured: rc=124, two dirs stranded).
      if [ -z "${MESH_TEST_TMPD:-}" ]; then
        MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
        trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
        export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
        _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
      fi
      do_test;;
    --watch) WATCH=1; shift;;
    --edge) EDGE=1; shift;;
    --json) JSON=1; shift;;
    --port) PORT="$2"; shift 2;;
    --all) TEST_ALL=1; shift;;
    *) echo "usage: $0 [--test] [--watch] [--edge] [--json] [--port <n>] [--all]"; exit 1;;
  esac
done

# flock: a still-wedged instance (pre-timeout-fix hangs, or a slow phaedra) must not stack with
# the next cron firing (9-59/10 * * * *) — non-blocking, benign skip on contention (exit 0, not
# an alarm; the next cycle 10min later catches up).
mkdir -p "$HOME/.mesh"
exec 9>"$LOCK"
flock -n 9 || { echo "mesh-ss-test: another instance still running — skipping this cycle" >&2; exit 0; }

# State tracking for --edge (fire only on status transitions)
PREV=$(cat "$STATE_FILE" 2>/dev/null || echo "UNKNOWN")

# Read config from phaedra (same as mesh-ss-config) — retried once: mesh-home's sole
# uplink deauths every ~14min and a single-attempt fetch painted UNREACHABLE on the pane
# for a whole cycle per flap (same family as 744773d / e12b9f2)
CONF=""
for _conf_try in 1 2; do
  CONF=$(timeout 15 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" 2>/dev/null) && break
  CONF=""
  [ "$_conf_try" = 1 ] && sleep 5
done
[ -n "$CONF" ] || {
  echo "mesh-ss-test: FAIL — cannot read SS config from phaedra (2 attempts)" >&2
  log_line "UNREACHABLE — cannot read SS config from $PHAEDRA after retry (tunnel status unknown)"
  exit 2
}
SS_HOST=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('server',''))") || exit 2
SS_PORT=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('server_port',''))") || exit 2
PASSWORD=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('password',''))") || exit 2
METHOD=$(echo "$CONF" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('method',''))") || exit 2

# Resolve phaedra's public IP (config has 127.0.0.1 — internal v2ray chain)
if [ "$SS_HOST" = "0.0.0.0" ] || [ "$SS_HOST" = "127.0.0.1" ]; then
  SS_HOST=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "curl -s ifconfig.me 2>/dev/null || dig +short myip.opendns.com @resolver1.opendns.com 2>/dev/null" 2>/dev/null) || {
    SS_HOST="38.49.216.141"
  }
fi

# Install ss-local if missing
if ! command -v ss-local >/dev/null 2>&1; then
  echo "mesh-ss-test: installing shadowsocks-libev client..." >&2
  sudo apt-get install -y shadowsocks-libev >/dev/null 2>&1 || {
    echo "mesh-ss-test: FAIL — could not install ss-local" >&2
    log_line "UNKNOWN — no ss-local client and could not install one (cannot probe tunnel)"
    exit 2
  }
fi

TMPDIR=$(mktemp -d)
CLIENT_CONF="$TMPDIR/ss-test.json"

cleanup() { kill $CLIENT_PID 2>/dev/null || true; wait $CLIENT_PID 2>/dev/null || true; rm -rf "$TMPDIR" 2>/dev/null || true; }
trap cleanup EXIT

# Detect Trojan tunnel (operator LTE bypass on port 8443)
TROJAN_PORT=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "if systemctl is-active trojan >/dev/null 2>&1; then grep -oP '(?<=\"local_port\": )\d+' /etc/trojan/config.json 2>/dev/null | head -1; fi" 2>/dev/null) || TROJAN_PORT=""
TROJAN_PASSWORD=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "grep -oP '(?<=\"password\": \[\")\K[^\"]+' /etc/trojan/config.json 2>/dev/null | head -1" 2>/dev/null) || TROJAN_PASSWORD=""
TROJAN_REMOTE=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "grep -oP '(?<=\"remote_addr\": \")\K[^\"]+' /etc/trojan/config.json 2>/dev/null | head -1" 2>/dev/null) || TROJAN_REMOTE=""
if [ -n "$TROJAN_PASSWORD" ] && [ -z "$TROJAN_PORT" ]; then TROJAN_PORT=8443; fi

# Determine which ports to test
if [ "$TEST_ALL" = 1 ]; then
  PORTS="$SS_PORT"
  # Check for active alt ports on phaedra
  for u in $(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "systemctl list-units --all 'ss-alt-*' 2>/dev/null | grep -oP 'ss-alt-\K[0-9]+'" 2>/dev/null); do
    PORTS="$PORTS $u"
  done
  [ -n "$TROJAN_PORT" ] && PORTS="$PORTS $TROJAN_PORT"
elif [ -n "$PORT" ]; then
  PORTS="$PORT"
else
  PORTS="$SS_PORT"
fi

# Ensure trojan client is installed if we need it
NEED_TROJAN=0
for p in $PORTS; do
  [ -n "$TROJAN_PORT" ] && [ "$p" = "$TROJAN_PORT" ] && NEED_TROJAN=1
done
if [ "$NEED_TROJAN" = 1 ] && ! command -v trojan >/dev/null 2>&1; then
  echo "mesh-ss-test: installing trojan client..." >&2
  sudo apt-get install -y trojan >/dev/null 2>&1 || {
    echo "mesh-ss-test: FAIL — could not install trojan client" >&2
    log_line "UNKNOWN — no trojan client and could not install one (cannot probe tunnel)"
    exit 2
  }
fi

OVERALL_EXIT=0
FIRST=1
NEW_STATE=""

for TEST_PORT in $PORTS; do
  [ "$FIRST" = 1 ] && FIRST=0 || echo ""

  CLIENT_PID=""

  if [ -n "$TROJAN_PORT" ] && [ "$TEST_PORT" = "$TROJAN_PORT" ]; then
    # Trojan tunnel (operator LTE bypass)
    cat > "$TMPDIR/trojan-client.json" << TROJAN_CONF
{
    "run_type": "client",
    "local_addr": "127.0.0.1",
    "local_port": $LOCAL_PORT,
    "remote_addr": "$SS_HOST",
    "remote_port": $TROJAN_PORT,
    "password": ["$TROJAN_PASSWORD"],
    "ssl": {
        "verify": true,
        "verify_hostname": true,
        "sni": "38-49-216-141.sslip.io"
    }
}
TROJAN_CONF
    trojan "$TMPDIR/trojan-client.json" > /dev/null 2>&1 &
    CLIENT_PID=$!
    sleep 2
    if ! kill -0 $CLIENT_PID 2>/dev/null; then
      echo "mesh-ss-test: port $TEST_PORT (trojan) — FAIL (trojan client failed to start)" >&2
      log_line "port $TEST_PORT (trojan) — FAIL (trojan client failed to start)"
      OVERALL_EXIT=3
      continue
    fi
  else
    # Shadowsocks tunnel (plain SS or plugin)
    PLUGIN_CONF=""
    TPASSWORD="$PASSWORD"
    TMETHOD="$METHOD"
    cat > "$CLIENT_CONF" << JSON
{
  "server": "$SS_HOST",
  "server_port": $TEST_PORT,
  "password": "$TPASSWORD",
  "method": "$TMETHOD",
  $PLUGIN_CONF
  "local_address": "127.0.0.1",
  "local_port": $LOCAL_PORT,
  "timeout": 5
}
JSON
    ss-local -c "$CLIENT_CONF" > /dev/null 2>&1 &
    CLIENT_PID=$!
    sleep 2
    if ! kill -0 $CLIENT_PID 2>/dev/null; then
      echo "mesh-ss-test: port $TEST_PORT — FAIL (ss-local failed to start)" >&2
      log_line "port $TEST_PORT — FAIL (ss-local failed to start)"
      OVERALL_EXIT=3
      continue
    fi
  fi

  # Test TCP relay through the tunnel
  if command -v curl >/dev/null 2>&1; then
    RESULT=$(timeout $TIMEOUT curl -s --max-time 12 -x "socks5://127.0.0.1:$LOCAL_PORT" "http://ipinfo.io/" 2>&1) || true
  else
    RESULT=$(timeout $TIMEOUT bash -c '
    echo -e "GET / HTTP/1.0\r\nHost: ipinfo.io\r\n\r\n" | nc -w 8 -x 127.0.0.1:'$LOCAL_PORT' ipinfo.io 80 2>/dev/null
    ' 2>&1) || true
  fi

  kill $CLIENT_PID 2>/dev/null || true; wait $CLIENT_PID 2>/dev/null || true; CLIENT_PID=""

  EGRESS_IP=$(echo "$RESULT" | grep -oP '"ip":\s*"\K[^"]+') || true
  COUNTRY=$(echo "$RESULT" | grep -oP '"country":\s*"\K[^"]+') || true
  CITY=$(echo "$RESULT" | grep -oP '"city":\s*"\K[^"]+') || true

  PORT_KEY="port_${TEST_PORT}"
  if [ -z "$EGRESS_IP" ]; then
    PORT_STATUS="FAIL"
    PORT_LABEL="FAIL:"
    OVERALL_EXIT=3
  else
    PORT_STATUS="PASS"
    PORT_LABEL="PASS:${EGRESS_IP}"
  fi
  PREV_PORT=$(echo "$PREV" | grep "^${PORT_KEY}=" | cut -d= -f2) || true

  # the ARTIFACT — every run, every port, whatever the output mode. STDOUT is change-gated by
  # --edge (the board wants transitions); the log is not (the dash wants current + fresh).
  if [ "$PORT_STATUS" = "PASS" ]; then
    log_line "port $TEST_PORT — PASS (egress $EGRESS_IP, ${CITY:-unknown}, ${COUNTRY:-unknown})"
  else
    log_line "port $TEST_PORT — FAIL (TCP relay timeout — tunnel not carrying traffic)"
  fi

  if [ "${JSON:-0}" = 1 ]; then
    echo "{\"port\":$TEST_PORT,\"status\":\"$PORT_STATUS\",\"egress_ip\":\"${EGRESS_IP:-}\",\"city\":\"${CITY:-unknown}\",\"country\":\"${COUNTRY:-unknown}\"}"
  elif [ "$EDGE" = 1 ]; then
    if [ "$PORT_LABEL" != "$PREV_PORT" ]; then
      if [ "$PORT_STATUS" = "FAIL" ]; then
        echo "mesh-ss-test: port $TEST_PORT — FAIL (TCP relay timeout)"
      else
        echo "[ss-test] port $TEST_PORT — $PORT_STATUS (egress $EGRESS_IP)"
      fi
    fi
  else
    if [ "$PORT_STATUS" = "FAIL" ]; then
      echo "mesh-ss-test: port $TEST_PORT — FAIL (TCP relay timeout)"
    else
      echo "mesh-ss-test: port $TEST_PORT — $PORT_STATUS (egress $EGRESS_IP, ${CITY:-unknown}, ${COUNTRY:-unknown})"
    fi
  fi
  NEW_STATE="${NEW_STATE}${PORT_KEY}=${PORT_LABEL}"$'\n'
done

# Save state for next --edge run
printf '%s' "$NEW_STATE" > "$STATE_FILE" 2>/dev/null || true

exit $OVERALL_EXIT
