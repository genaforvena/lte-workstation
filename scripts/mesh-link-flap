#!/usr/bin/env bash
# orphan-ok: on-demand link-stability spot-check (run when a node feels network-flaky; unwired by design)
# mesh-link-flap — physical link-layer connectivity-stability sense.
#
# Reads /sys/class/net/<iface>/carrier_changes — the kernel's count of physical link
# up<->down transitions (wifi association drops, AP reboots, cable unplug/replug). This is a
# real-world signal NO other sense perceives: the LOCAL link itself flapping. It is distinct from
#   mesh-isp-health — end-to-end internet reachability/latency (a brief LOCAL flap can recover
#                     between its probes and never register), mesh-net-drop — packet drops,
#                     mesh-netrate — throughput. A flapping link degrades everything BEFORE
#                     isp-health blinks; this names that.
#
# Only PHYSICAL interfaces are perceived (has a /device link OR a /wireless dir) — virtual
# tunnels (tailscale0, wg*, docker0, br-*, veth*, lo) are excluded: their "carrier" is not a
# real-world physical link.
#
# ── REAFFERENCE vs EXAFFERENCE: our own healer's repairs are counted as link faults ──────────
#
# LITERATURE (live review, 2026-08-25): Kilteni, Cullen, Schneider & Schwarz, "Suppressing
# Sensation during Action across Species and Sensory Modalities: Predictive and Nonpredictive
# Mechanisms of Sensory Modulation", J Neurosci 45(46) e1351252025, 12 Nov 2025
# (jneurosci.org/content/45/46/e1351252025). The review's spine is a SEPARATION the mesh did not
# have: REAFFERENCE ATTENUATION is predictive and stimulus-specific — a forward model cancels the
# particular consequence THIS action was expected to produce — while SENSORY GATING is "a broader
# and often less selective mechanism that inhibits BOTH self- and externally generated inputs".
# The two are dissociable and must be measured apart; gating buys quiet by going partly blind.
# (We already had a corollary discharge, but only in the AUDIO domain — mesh-audio-active's
# reafference/exafference split, review 2026-08-14. The link domain had NEITHER.)
#
# THE GAP THIS FILLS, measured on this node 2026-08-25: mesh-link-heal (`* * * * *`) repairs a
# wedged station with `wpa_cli reassociate` -> `ip link down/up` -> driver reload -> USB
# re-enumerate. **A bounce is +2 carrier_changes** — measured on a real kernel in a private netns
# (`unshare -n -m`, veth: cc 2 -> 4 across one admin down/up), i.e. exactly the counter this sense
# reads. Since 2026-08-16 the healer took 14 bounces, 10 driver reloads and 3 re-enumerations, and
# every one of them landed in this tool's fault count with no way to tell it from the world. The
# sense was reading its own hand and calling it weather.
#
# WHAT WE REFUSE, and it is the paper's own distinction: NOT gating. A blanket "suppress the
# reading while the healer is working" would blind the sense during exactly the window when the
# link is most likely to be genuinely flapping. Instead the expected self-caused transitions are
# SUBTRACTED per rung from the observed delta and the RESIDUAL is the world's — so a real flap
# inside a heal window still reads. And the subtraction is ASSERTED, never assumed: if we predicted
# more self-transitions than actually occurred the forward model is wrong, and the reading says
# `attribution: na` instead of silently flooring to a clean zero.
#
# THE RESET CHANNEL, same bug wearing a second face. `carrier_changes` is PER-NETDEV: a driver
# reload or a re-enumeration destroys the netdev and the counter restarts at 1 (measured: a freshly
# created veth reads carrier_changes=1). So does a reboot. The old code clamped a backwards delta to
# 0 and rendered STABLE — a self-caused discontinuity routed into the world channel's QUIET bucket.
# Live artifact that provoked this review: `[link-flap] STABLE +0 flaps / 3497488s (0.00/min)
# total=108` on a link that had taken 108 carrier changes in the 7.9h since boot (13.7/h, the
# worst-flapping link in the mesh) — a 40.5-day window most of which the machine was POWERED OFF.
# A reset is now RESET, never STABLE, and the window is clamped to the counter's own start.
#
#   mesh-link-flap          one stability line: STABLE / FLAPPING / RESET / BASELINE + per-iface carrier
#   mesh-link-flap --json   {verdict,flaps_total,flaps_delta,flaps_self,flaps_world,attribution,
#                            self_provenance,overpredicted,window_s,rate_per_min,counter_age_s,
#                            rate_since_start_per_min,rate_floor,ifaces,ts}
#   mesh-link-flap --test   fixture-backed parser/classifier + reafference/reset/missing-source arms
#
# Corollary-discharge source: $MESH_LINK_HEAL_LOG (default ~/.mesh/link-heal.log) — the actuator's
# OWN action ledger, an artifact the mesh already produces (no re-probing). Absent tool AND absent
# log -> this node has no link actuator, self=0 honestly. Tool present but log unreadable, or the
# window opening BEFORE the log's first line -> self=na and attribution=unknown: never a faked
# clean residual.
#
# State: $MESH_LINK_FLAP_STATE (default ~/.mesh/.link-flap.state) — last aggregate counter + epoch,
# rewritten on EVERY successful run (the delta needs the prior counter anyway), so its mtime is
# always ran-live and a long-STABLE-but-LIVE link can never decay to a false STALE. Not change-gated
# (state written unconditionally), so the mesh-state-touch decoupling primitive is N/A here.
#
# Exit codes:
#   0 = real link-flap artifact produced
#   2 = no physical network interface with carrier_changes on this node; never fakes a reading
set -uo pipefail

NET="${MESH_NET_DIR:-/sys/class/net}"
STATE="${MESH_LINK_FLAP_STATE:-$HOME/.mesh/.link-flap.state}"
HEAL_LOG="${MESH_LINK_HEAL_LOG:-$HOME/.mesh/link-heal.log}"
UPTIME_SRC="${MESH_UPTIME_SRC:-/proc/uptime}"

# THE FORWARD MODEL — CALIBRATED AGAINST THE ACTUATOR'S OWN TAPE, WITH A CONTROL ARM. Per healer
# rung: how many carrier transitions does OUR OWN action produce? A forward model you have not
# calibrated is a guess, and a guess subtracted from a measurement manufactures a clean residual.
#
# Derived from ~/.mesh/link-heal.log's RECOVERED rows (each carries `carrier_drops=N`, the kernel's
# own carrier_down_count delta over the episode; 1 drop = 2 carrier_changes), grouped by the rung
# the episode actually reached. Re-derive with:
#   awk '/RECOVERED/{r="?";if(match($0,/last rung attempted: [a-z]+/))r=substr($0,RSTART+21,RLENGTH-21);
#        if(match($0,/carrier_drops=[0-9]+/)){c=substr($0,RSTART+14,RLENGTH-14)+0;n[r]++;s[r]+=c}}
#        END{for(k in n)printf "%s n=%d mean=%.2f\n",k,n[k],s[k]/n[k]}' ~/.mesh/link-heal.log
#
#   rung          n     mean drops   -> carrier_changes    charged
#   none        169       0.00              0.0             --    <- THE CONTROL ARM
#   reassociate  28       0.75              1.5             1.5
#   bounce        3       2.00              4.0             2.0   <- see "which way to be wrong"
#   reload/usb    0        na               RESET           RESET (netdev destroyed + re-created)
#
# WHICH WAY TO BE WRONG. The bounce arm is n=3 and its two independent estimates DISAGREE: the tape
# says 4.0 changes/episode, while the netns measurement says the `ip link down/up` itself is exactly
# +2 (composing that with the n=28 reassociate arm gives 3.5). With n=3 there is no basis to pick,
# so the charge is the SMALLEST defensible one, 2.0 — the part that is exactly measured. The
# direction matters and is not symmetric: over-charging our own hand hides real flaps (a fault sense
# going silent, the dangerous failure), under-charging leaks a little of our hand into the world
# channel (a false alarm, which is loud and gets looked at). A guard fails LOUD or it is not a guard.
#
# THE CONTROL ARM IS THE WHOLE ARGUMENT. `none` is an episode the healer OBSERVED and did not act
# in — a spontaneous deauth that recovered by itself — and across 169 of them the carrier counter
# moved ZERO times. So the drops seen in the acting arms are not "episodes that were worse"; they
# are OUR HAND. Without that arm the same table would be a correlation between severity and rung.
# Corroborated independently for the bounce: `unshare -n -m` on a veth, 2026-08-25, one `ip link
# down/up` = carrier_changes 2 -> 4, and the bounce rung is down/up PLUS a reassociate (1 + 0.75
# drops ~= the 2.00 measured, n=3 — the thinnest arm here, and it is flagged as such in the render).
#
# SIZE OF THE CORRECTION, stated so nobody mistakes this for the big fish: since this boot the
# counter took 54 down-edges and the healer's 27 episodes account for 3. **94% of this link's
# carrier activity happens where the healer never opened an episode** — the world really does flap
# here. Reafference is a real but ~6% contamination; the RESET/window bug below was the one
# rendering the whole thing STABLE.
reaff_cost() {                      # <rung> -> "<carrier_changes>|RESET <provenance>"
  case "$1" in
    bounce)      printf '2.0 measured-netns' ;;
    reassociate) printf '1.5 measured-n28' ;;
    driver|usb)  printf 'RESET measured' ;;
    *)           printf '0 unknown'  ;;
  esac
}

# boot epoch from the kernel's own uptime accumulator (never a log, never a wtmp scrape)
boot_epoch() {
  local up
  up="$(cut -d' ' -f1 "$UPTIME_SRC" 2>/dev/null | cut -d. -f1)" || return 1
  [[ "$up" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$(( $(date +%s) - up ))"
}

# reafference_scan <since_epoch> <until_epoch> -> "<self> <prov> <reset_ts> <detail>"
#   self     = expected self-caused carrier transitions inside the window (or 'na')
#   prov     = measured | assumed | mixed | na | none   (na = CD channel unreadable, never a clean 0)
#   reset_ts = epoch of the LAST reset-class action in the window, or 0
#   detail   = "bounce x1, reassociate x3" (or a reason word when self=na)
# ISO8601-Z timestamps sort lexicographically, so the window filter is a string compare — no mktime,
# no per-line `date` fork.
reafference_scan() {
  local since="$1" until="$2" siso uiso
  if [ ! -r "$HEAL_LOG" ]; then
    # no actuator on this node at all -> nothing of ours could have moved the counter.
    if command -v mesh-link-heal >/dev/null 2>&1; then
      printf 'na na 0 heal-log-unreadable'; return 0
    fi
    printf '0 none 0 no-link-actuator-on-this-node'; return 0
  fi
  # a window that opens before the ledger's first line is UNCOVERED — the ledger cannot testify
  # about a time it does not span, and absence from it is unknown, never "we did nothing".
  local first
  first="$(awk 'NF{print $1; exit}' "$HEAL_LOG" 2>/dev/null)"
  siso="$(date -u -d "@$since" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || { printf 'na na 0 date-failed'; return 0; }
  uiso="$(date -u -d "@$until" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || { printf 'na na 0 date-failed'; return 0; }
  if [ -n "$first" ] && [[ "$first" > "$siso" ]]; then
    printf 'na na 0 window-predates-heal-log'; return 0
  fi
  # THE UNIT OF ANALYSIS IS THE EPISODE, NOT THE ACTION. The cost table is keyed on the rung an
  # EPISODE reached, and the ladder climbs THROUGH the lower rungs — a bounce episode's measured
  # 2.00 drops already contain the reassociate that preceded it. Summing per ACTION double-counts
  # the climb: the live 16:45-16:50Z episode logged reassociate THEN bounce and moved the counter
  # by 2, while a per-action sum predicts 5.5. So actions are grouped into episodes (a run of
  # ACTION lines with no RECOVERED between them) and each episode is charged its HIGHEST rung once.
  awk -v siso="$siso" -v uiso="$uiso" '
    function flush(  c) {
      if (ep_rung == "") return
      if (ep_rung == "driver" || ep_rung == "usb") { reset_iso = ep_reset; n[ep_rung]++ }
      else if (ep_rung == "bounce")      { self += 2.0; thin = 1; n[ep_rung]++ }
      else if (ep_rung == "reassociate") { self += 1.5; meas = 1; n[ep_rung]++ }
      else { unk = 1; n["unknown-rung"]++ }
      ep_rung = ""; ep_reset = ""
    }
    BEGIN { rank["reassociate"]=1; rank["bounce"]=2; rank["driver"]=3; rank["usb"]=4 }
    $1 >= siso && $1 <= uiso && $2 == "ACTION" {
      rung = $3
      if (ep_rung == "" || rank[rung] > rank[ep_rung]) ep_rung = rung
      if (rung == "driver" || rung == "usb") ep_reset = $1
      next
    }
    $1 >= siso && $1 <= uiso && /RECOVERED/ { flush(); next }
    END {
      flush()
      prov = "none"
      if (meas || thin) prov = "measured"
      if (thin) prov = prov "+bounce-floor"      # bounce charged at its measured LOWER bound; say so
      if (unk) prov = (prov == "none") ? "unknown" : prov "+unknown-rung"
      d = ""
      for (k in n) d = d (d ? "," : "") k "x" n[k]
      if (d == "") d = "no-action-in-window"
      printf "%.1f %s %s %s", self+0, prov, (reset_iso ? reset_iso : "0"), d
    }' "$HEAL_LOG"
}

# Select physical interfaces: readable carrier_changes, not loopback, and backed by real hardware
# (a /device symlink) or wireless (a /wireless dir). Prints "<iface> <carrier_changes> <carrier>".
select_links() {
  local found=0 i n cc car
  for i in "$NET"/*; do
    [ -d "$i" ] || continue
    n="$(basename "$i")"
    [ "$n" = lo ] && continue
    [ -r "$i/carrier_changes" ] || continue
    [ -e "$i/device" ] || [ -d "$i/wireless" ] || continue
    cc="$(cat "$i/carrier_changes" 2>/dev/null)"
    [[ "$cc" =~ ^[0-9]+$ ]] || continue
    car="$(cat "$i/carrier" 2>/dev/null)"; [[ "$car" =~ ^[01]$ ]] || car="?"
    printf '%s %s %s\n' "$n" "$cc" "$car"
    found=1
  done
  [ "$found" = 1 ] || return 2
}

# classify_flap <world_delta> <window_s> <have_prior(1|0)> [reset(1|0)] [attributable(1|0)]
#   -> "VERDICT rate_per_min"
# The verdict keys on the WORLD residual, never on the raw delta: transitions our own healer was
# expected to cause are not the link failing. A counter RESET is its own verdict — never STABLE,
# which is what a backwards delta silently became before (self-caused discontinuity -> quiet bucket).
# Unattributable (the CD channel could not testify) still reports the raw rate but says UNKNOWN.
classify_flap() {
  awk -v d="$1" -v w="$2" -v hp="$3" -v rst="${4:-0}" -v att="${5:-1}" 'BEGIN{
    if (hp != "1") { print "BASELINE 0.00"; exit }      # no prior run -> rate is honestly unknown
    if (rst == "1") { print "RESET 0.00"; exit }         # counter restarted: this delta is fiction
    rate = (w > 0) ? (d / w) * 60 : 0
    if (att != "1") { printf "UNKNOWN %.2f\n", rate; exit }
    v = (d >= 1.0) ? "FLAPPING" : "STABLE"   # a fraction of a predicted transition is not a flap
    printf "%s %.2f\n", v, rate
  }'
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  # fixture: one physical iface (eth0, backed by a /device dir) flapping; lo + a virtual tun must be ignored
  mkdir -p "$td/net/eth0/device" "$td/net/lo" "$td/net/tun0"
  printf '5\n' > "$td/net/eth0/carrier_changes"; printf '1\n' > "$td/net/eth0/carrier"
  printf '0\n' > "$td/net/lo/carrier_changes";   printf '1\n' > "$td/net/lo/carrier"
  printf '9\n' > "$td/net/tun0/carrier_changes"; printf '1\n' > "$td/net/tun0/carrier"   # no /device, no /wireless
  st="$td/state"
  # selection: only eth0 (5), not lo (no device), not tun0 (no device/wireless) -> total 5
  sel="$(NET="$td/net" select_links)"
  [ "$(printf '%s\n' "$sel" | awk '{s+=$2} END{print s}')" = 5 ] || { echo "smoke-test: FAIL (selection must be eth0 only, total 5; got: $sel)"; exit 1; }
  # run 1: cold -> BASELINE, real total, writes state
  g1="$(MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$st" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$g1" | grep -q '"verdict":"BASELINE"' || { echo "smoke-test: FAIL (cold run must be BASELINE: $g1)"; exit 1; }
  printf '%s\n' "$g1" | grep -q '"flaps_total":5' || { echo "smoke-test: FAIL (cold run real total=5: $g1)"; exit 1; }
  [ -s "$st" ] || { echo "smoke-test: FAIL (state must be written on first run)"; exit 1; }
  # run 2: counter jumped 5->8 -> FLAPPING with delta 3
  printf '8\n' > "$td/net/eth0/carrier_changes"
  g2="$(MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$st" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$g2" | grep -q '"verdict":"FLAPPING"' || { echo "smoke-test: FAIL (counter rise must be FLAPPING: $g2)"; exit 1; }
  printf '%s\n' "$g2" | grep -q '"flaps_delta":3' || { echo "smoke-test: FAIL (delta must be 3: $g2)"; exit 1; }
  # run 3: counter held -> STABLE, delta 0
  g3="$(MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$st" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$g3" | grep -q '"verdict":"STABLE"' || { echo "smoke-test: FAIL (held counter must be STABLE: $g3)"; exit 1; }
  printf '%s\n' "$g3" | grep -q '"flaps_delta":0' || { echo "smoke-test: FAIL (held delta must be 0: $g3)"; exit 1; }
  # classifier unit checks
  [ "$(classify_flap 3 60 1)" = "FLAPPING 3.00" ] || { echo "smoke-test: FAIL (classify FLAPPING rate)"; exit 1; }
  [ "$(classify_flap 0 60 1)" = "STABLE 0.00" ]   || { echo "smoke-test: FAIL (classify STABLE)"; exit 1; }
  [ "$(classify_flap 9 0 0)" = "BASELINE 0.00" ]  || { echo "smoke-test: FAIL (classify cold BASELINE)"; exit 1; }
  # missing-source -> exit 2 (a net dir with only virtual/lo ifaces fakes nothing)
  mkdir -p "$td/empty/lo" "$td/empty/tun9"
  printf '0\n' > "$td/empty/lo/carrier_changes"; printf '0\n' > "$td/empty/tun9/carrier_changes"
  if MESH_NET_DIR="$td/empty" MESH_LINK_FLAP_STATE="$td/state2" bash "$0" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (no physical iface must exit 2, never fake STABLE)"; exit 1
  fi

  # ── REAFFERENCE / RESET ARMS (2026-08-25) ──────────────────────────────────────────────────────
  # Fixtures own their own clock and their own corollary-discharge channel, so every arm below is
  # deterministic on any node.
  up="$td/uptime"; printf '999999999.00 1.00\n' > "$up"        # "booted long ago" — never a reset
  hl="$td/heal.log"
  ago() { date -u -d "@$(( $(date +%s) - $1 ))" +%Y-%m-%dT%H:%M:%SZ; }
  run() {   # run <state_total> <state_age_s> <counter> [heal_log] [uptime_src] [extra_env...]
    local st_total="$1" age="$2" cc="$3" log="${4:-$hl}" ups="${5:-$up}"
    [ $# -gt 5 ] && shift 5 || shift $#
    printf '%s\n' "$cc" > "$td/net/eth0/carrier_changes"
    printf '%s %s SEED\n' "$st_total" "$(( $(date +%s) - age ))" > "$td/state3"
    env "$@" MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$td/state3" \
        MESH_LINK_HEAL_LOG="$log" MESH_UPTIME_SRC="$ups" bash "$0" --json 2>/dev/null
  }
  need() { printf '%s\n' "$2" | grep -q -- "$1" || { echo "smoke-test: FAIL ($3: want $1, got: $2)"; exit 1; }; }
  no()   { printf '%s\n' "$2" | grep -q -- "$1" && { echo "smoke-test: FAIL ($3: must NOT contain $1: $2)"; exit 1; }; return 0; }

  # 1. THE RED ARM — the live fault this rewrite came from. A prior counter ABOVE the current one is
  #    a netdev restart, not a quiet link. Before the fix this rendered "STABLE +0 flaps (0.00/min)"
  #    on the mesh's worst-flapping link (measured 2026-08-25: 108 changes in 7.9h read as STABLE).
  printf '' > "$hl"
  g="$(run 148 300 5)"
  need '"verdict":"RESET"' "$g" "backwards counter must be RESET"
  no   '"verdict":"STABLE"' "$g" "backwards counter must never read STABLE"
  need '"reset_why":"counter-went-backwards' "$g" "reset must name its cause"
  # ...and it must still publish an HONEST rate off the counter's own start, which is the reading
  # that was missing entirely while the delta was fiction.
  need '"rate_since_start_per_min"' "$g" "reset reading must still carry a since-start rate"

  # 2. a window that OPENS BEFORE THIS BOOT is not a window (this node power-cycles; most of such a
  #    span is machine-OFF, not link-quiet). Fixture: uptime 100s, state 5000s old.
  printf '100.00 1.00\n' > "$td/uptime-fresh"
  g="$(run 1 5000 9 "$hl" "$td/uptime-fresh")"
  need '"verdict":"RESET"' "$g" "window predating boot must be RESET"
  need 'window-predates-boot' "$g" "boot-spanning window must name itself"

  # 3. REAFFERENCE SUBTRACTION: the only carrier movement in the window is our own healer's bounce.
  { echo "$(ago 600)  RECOVERED iface=eth0 after 1 down-check(s); last rung attempted: none"
    echo "$(ago 200)  ACTION bounce (link down/up + reassociate) iface=eth0 state=DEAUTHED down_checks=4"
    echo "$(ago 150)  RECOVERED iface=eth0 after 4 down-check(s); last rung attempted: bounce"; } > "$hl"
  g="$(run 10 300 12)"     # delta = 2, exactly the bounce's measured cost
  need '"verdict":"STABLE"' "$g" "a delta fully explained by our own bounce is not a flapping link"
  need '"flaps_world":0.0' "$g" "world residual must be zero"
  need '"flaps_self":"2.0"' "$g" "self must be charged the bounce"
  need '"attribution":"self"' "$g" "attribution must name the self channel"

  # 4. WE REFUSE GATING — the paper's own distinction, made executable. A blanket suppression during
  #    a heal window would blind the sense exactly when the link is most likely to be flapping. Same
  #    heal log, a LARGER delta: the world's share must still be reported.
  g="$(run 10 300 16)"     # delta = 6, of which 2 are ours
  need '"verdict":"FLAPPING"' "$g" "a real flap inside a heal window must still read FLAPPING"
  need '"flaps_world":4.0' "$g" "the world residual must survive the subtraction"
  need '"attribution":"mixed"' "$g" "both channels active must read mixed"

  # 5. THE UNIT OF ANALYSIS IS THE EPISODE. The ladder climbs THROUGH its lower rungs, so a
  #    reassociate followed by a bounce inside ONE episode is charged ONCE at the highest rung.
  #    Summing per ACTION would charge 3.5 and turn a quiet window into an OVERPREDICTED one.
  { echo "$(ago 600)  RECOVERED iface=eth0 after 1 down-check(s); last rung attempted: none"
    echo "$(ago 250)  ACTION reassociate iface=eth0 state=DEAUTHED down_checks=2"
    echo "$(ago 200)  ACTION bounce (link down/up + reassociate) iface=eth0 state=DEAUTHED down_checks=4"
    echo "$(ago 150)  RECOVERED iface=eth0 after 4 down-check(s); last rung attempted: bounce"; } > "$hl"
  g="$(run 10 300 12)"
  need '"flaps_self":"2.0"' "$g" "one episode is charged once at its highest rung, not per action"
  need '"verdict":"STABLE"' "$g" "episode-grouped subtraction must leave a clean STABLE"

  # 6. AN OVER-PREDICTION IS NOT FLOORED INTO A CLEAN ZERO. If we charged our own hand for
  #    transitions that never happened, the forward model is wrong and the reading says so — a
  #    silently floored residual would render a broken prediction as a perfectly quiet link.
  { echo "$(ago 600)  RECOVERED iface=eth0 after 1 down-check(s); last rung attempted: none"
    echo "$(ago 200)  ACTION bounce (link down/up + reassociate) iface=eth0 state=DEAUTHED down_checks=4"
    echo "$(ago 150)  RECOVERED iface=eth0 after 4 down-check(s); last rung attempted: bounce"; } > "$hl"
  g="$(run 10 300 10)"     # delta = 0 but we charged 2.0
  need '"overpredicted":2.0' "$g" "over-prediction must be published"
  need '"attribution":"unknown"' "$g" "a wrong forward model cannot claim an attribution"
  no   '"verdict":"STABLE"' "$g" "a broken prediction must not render as a quiet link"

  # 7. THE CD CHANNEL'S OWN HONESTY. An actuator on this node whose ledger we cannot read is
  #    UNKNOWN, never a clean zero; no actuator at all is an honest zero.
  mkdir -p "$td/stub"; printf '#!/bin/sh\nexit 0\n' > "$td/stub/mesh-link-heal"; chmod +x "$td/stub/mesh-link-heal"
  g="$(run 10 300 12 "$td/nonexistent.log" "$up" PATH="$td/stub:/usr/bin:/bin")"
  need '"flaps_self":"na"' "$g" "healer present + ledger unreadable must be na"
  need '"attribution":"unknown"' "$g" "unreadable CD channel cannot claim world-attribution"
  g="$(run 10 300 12 "$td/nonexistent.log" "$up" PATH="/usr/bin:/bin")"
  need '"flaps_self":"0"' "$g" "no actuator on this node is an honest zero"
  need 'no-link-actuator' "$g" "the honest zero must say WHY it is zero"

  # 8. a window that opens BEFORE the ledger's first line is uncovered — absence from a ledger that
  #    does not span the time is unknown, never "we did nothing".
  { echo "$(ago 100)  RECOVERED iface=eth0 after 1 down-check(s); last rung attempted: none"; } > "$hl"
  g="$(run 10 3000 12)"
  need 'window-predates-heal-log' "$g" "an uncovered window must say so"
  need '"flaps_self":"na"' "$g" "an uncovered window cannot be charged a clean zero"

  echo "smoke-test: ok (carrier-flap fixtures: BASELINE->FLAPPING->STABLE, selection, classifier:3, missing-source exit-2"
  echo "            + reafference: reset/boot-window, self-subtraction, NO-gating, episode-grouping, over-prediction, CD honesty x3)"
  exit 0
fi

# --- live read ---
sel="$(select_links)" || { echo "link-flap: UNREACHABLE - no physical interface with carrier_changes" >&2; exit 2; }
total=0; ifdetail=""; ifjson=""
while read -r n cc car; do
  [ -n "$n" ] || continue
  total=$((total + cc))
  cs="UP"; [ "$car" = 0 ] && cs="DOWN"; [ "$car" = "?" ] && cs="?"
  ifdetail="$ifdetail ${n}:${cs}(${cc})"
  ifjson="${ifjson:+$ifjson,}{\"iface\":\"$n\",\"carrier\":\"$cs\",\"changes\":$cc}"
done <<<"$sel"
ifdetail="${ifdetail# }"

now="$(date +%s)"
boot="$(boot_epoch || printf 0)"
have_prior=0; delta=0; window=0; reset=0; reset_why=""
if [ -r "$STATE" ]; then
  read -r p_total p_ts _ < "$STATE" 2>/dev/null || true
  if [[ "${p_total:-}" =~ ^[0-9]+$ ]] && [[ "${p_ts:-}" =~ ^[0-9]+$ ]]; then
    have_prior=1
    delta=$((total - p_total))
    window=$((now - p_ts)); [ "$window" -lt 0 ] && window=0
    # A BACKWARDS COUNTER IS A RESTART, NOT A QUIET LINK. The old clamp turned every netdev
    # re-creation into "+0 flaps, STABLE" — a self-caused discontinuity filed as world-quiet.
    if [ "$delta" -lt 0 ]; then delta=0; reset=1; reset_why="counter-went-backwards"; fi
    # ...and a window that OPENS BEFORE THIS BOOT is not a window: the counter it would be
    # differenced against belongs to a netdev that no longer exists, and on a power-cycling node
    # most of that span is machine-OFF, not link-quiet.
    if [ "$boot" -gt 0 ] && [ "$p_ts" -lt "$boot" ]; then
      reset=1; reset_why="${reset_why:+$reset_why,}window-predates-boot"
    fi
  fi
fi

# ---- corollary discharge: subtract what OUR OWN actuator was expected to cause in this window ----
scan_since="${p_ts:-$now}"; [ "$have_prior" = 1 ] || scan_since="$now"
read -r self prov reset_iso rdetail <<<"$(reafference_scan "$scan_since" "$now")"
if [ "$reset_iso" != "0" ]; then
  reset=1; reset_why="${reset_why:+$reset_why,}our-own-${rdetail}"
fi
attributable=1; overpred=0; world="$delta"
case "$self" in
  na) attributable=0; world="$delta" ;;
  *)
    # self is an EXPECTATION (a decimal), so the residual is computed in awk, and the verdict below
    # only calls it a world flap at >= 1 whole carrier transition — half a predicted transition is
    # not evidence that the link moved.
    read -r world overpred <<<"$(awk -v d="$delta" -v sf="$self" 'BEGIN{
      r = d - sf
      if (r <= -1.0) { printf "0 %.1f", -r; exit }   # over-predicted by a WHOLE transition
      if (r < 0) r = 0
      printf "%.1f 0", r }')"
    awk -v o="$overpred" 'BEGIN{exit !(o+0 > 0)}' && attributable=0
    ;;
esac

read -r verdict rate <<<"$(classify_flap "$world" "$window" "$have_prior" "$reset" "$attributable")"

# The counter's OWN start: boot, or the last time our own reset-class rung re-created the netdev.
# Gives an honest rate even when the delta is fiction — the reading that was missing when this tool
# rendered "0.00/min STABLE" on a link doing 13.7 carrier changes an hour.
cstart="$boot"; rate_floor=1
if [ "$reset_iso" != "0" ]; then
  ct="$(date -u -d "$reset_iso" +%s 2>/dev/null || printf 0)"
  if [ "$ct" -gt "$cstart" ] 2>/dev/null; then cstart="$ct"; rate_floor=0; fi
fi
cage=0; srate="0.00"
if [ "$cstart" -gt 0 ] && [ "$now" -gt "$cstart" ]; then
  cage=$((now - cstart))
  srate="$(awk -v t="$total" -v a="$cage" 'BEGIN{printf "%.2f", (a>0)?(t/a)*60:0}')"
fi

case "$self" in
  na)  attr="unknown" ;;
  0|0.0) attr="world" ;;
  *)   attr="$(awk -v w="$world" 'BEGIN{print (w+0 >= 1.0) ? "mixed" : "self"}')" ;;
esac
[ "$attributable" = 1 ] || attr="unknown"
[ "$reset" = 1 ] && attr="unknown"

# state written EVERY successful run -> mtime = ran-live (not change-gated)
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
printf '%s %s %s\n' "$total" "$now" "$verdict" > "$STATE" 2>/dev/null || true

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
case "${1:-}" in
  --json)
    printf '{"verdict":"%s","flaps_total":%s,"flaps_delta":%s,"flaps_self":"%s","flaps_world":%s,' \
      "$verdict" "$total" "$delta" "$self" "$world"
    printf '"attribution":"%s","self_provenance":"%s","self_detail":"%s","overpredicted":%s,' \
      "$attr" "$prov" "$rdetail" "$overpred"
    printf '"reset":%s,"reset_why":"%s","window_s":%s,"rate_per_min":%s,' \
      "$reset" "${reset_why:-}" "$window" "$rate"
    printf '"counter_age_s":%s,"rate_since_start_per_min":%s,"rate_floor":%s,"ifaces":[%s],"ts":"%s"}\n' \
      "$cage" "$srate" "$rate_floor" "$ifjson" "$ts"
    ;;
  *)
    # the self/world split is ALWAYS shown — a reading that hides which channel the transitions came
    # from is the reading this rewrite exists to stop emitting.
    case "$self" in
      na) split=" · self=na (${rdetail})" ;;
      *)  split=" · world=${world} self=${self} (${rdetail}, ${prov})" ;;
    esac
    awk -v o="$overpred" 'BEGIN{exit !(o+0 > 0)}' && \
      split="$split · OVERPREDICTED by ${overpred} — forward model wrong, residual NOT floored to a clean zero"
    if [ "$reset" = 1 ]; then
      printf '[link-flap] %s  counter restarted (%s) — this delta is fiction · %s in %ss (%s/min%s) · total=%s · %s\n' \
        "$verdict" "$reset_why" "$total" "$cage" "$srate" "$([ "$rate_floor" = 1 ] && printf ', floor')" \
        "$total" "$ifdetail"
    elif [ "$have_prior" = 1 ]; then
      printf '[link-flap] %s  +%s flaps / %ss (%s/min)%s · total=%s · %s\n' \
        "$verdict" "$delta" "$window" "$rate" "$split" "$total" "$ifdetail"
    else
      printf '[link-flap] %s  total=%s flaps since counter start (%ss, %s/min%s) · %s  (no prior run — delta baselines next call)\n' \
        "$verdict" "$total" "$cage" "$srate" "$([ "$rate_floor" = 1 ] && printf ', floor')" "$ifdetail"
    fi
    ;;
esac
