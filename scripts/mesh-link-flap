#!/usr/bin/env bash
# orphan-ok: on-demand link-stability spot-check (run when a node feels network-flaky; unwired by design)
# mesh-link-flap — physical link-layer connectivity-stability sense.
#
# Reads /sys/class/net/<iface>/carrier_changes — the kernel's count of physical link
# up<->down transitions (wifi association drops, AP reboots, cable unplug/replug). This is a
# real-world signal NO other sense perceives: the LOCAL link itself flapping. It is distinct from
#   mesh-isp-health — end-to-end internet reachability/latency (a brief LOCAL flap can recover
#                     between its probes and never register), mesh-net-drop — packet drops,
#                     mesh-netrate — throughput. A flapping link degrades everything BEFORE
#                     isp-health blinks; this names that.
#
# Only PHYSICAL interfaces are perceived (has a /device link OR a /wireless dir) — virtual
# tunnels (tailscale0, wg*, docker0, br-*, veth*, lo) are excluded: their "carrier" is not a
# real-world physical link.
#
#   mesh-link-flap          one stability line: STABLE / FLAPPING / BASELINE + per-iface carrier
#   mesh-link-flap --json   {verdict,flaps_total,flaps_delta,window_s,rate_per_min,ifaces,ts}
#   mesh-link-flap --test   fixture-backed parser/classifier + missing-source smoke test
#
# State: $MESH_LINK_FLAP_STATE (default ~/.mesh/.link-flap.state) — last aggregate counter + epoch,
# rewritten on EVERY successful run (the delta needs the prior counter anyway), so its mtime is
# always ran-live and a long-STABLE-but-LIVE link can never decay to a false STALE. Not change-gated
# (state written unconditionally), so the mesh-state-touch decoupling primitive is N/A here.
#
# Exit codes:
#   0 = real link-flap artifact produced
#   2 = no physical network interface with carrier_changes on this node; never fakes a reading
set -uo pipefail

NET="${MESH_NET_DIR:-/sys/class/net}"
STATE="${MESH_LINK_FLAP_STATE:-$HOME/.mesh/.link-flap.state}"

# Select physical interfaces: readable carrier_changes, not loopback, and backed by real hardware
# (a /device symlink) or wireless (a /wireless dir). Prints "<iface> <carrier_changes> <carrier>".
select_links() {
  local found=0 i n cc car
  for i in "$NET"/*; do
    [ -d "$i" ] || continue
    n="$(basename "$i")"
    [ "$n" = lo ] && continue
    [ -r "$i/carrier_changes" ] || continue
    [ -e "$i/device" ] || [ -d "$i/wireless" ] || continue
    cc="$(cat "$i/carrier_changes" 2>/dev/null)"
    [[ "$cc" =~ ^[0-9]+$ ]] || continue
    car="$(cat "$i/carrier" 2>/dev/null)"; [[ "$car" =~ ^[01]$ ]] || car="?"
    printf '%s %s %s\n' "$n" "$cc" "$car"
    found=1
  done
  [ "$found" = 1 ] || return 2
}

# classify_flap <delta> <window_s> <have_prior(1|0)> -> "VERDICT rate_per_min"
classify_flap() {
  awk -v d="$1" -v w="$2" -v hp="$3" 'BEGIN{
    if (hp != "1") { print "BASELINE 0.00"; exit }      # no prior run -> rate is honestly unknown
    rate = (w > 0) ? (d / w) * 60 : 0
    v = (d > 0) ? "FLAPPING" : "STABLE"
    printf "%s %.2f\n", v, rate
  }'
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  # fixture: one physical iface (eth0, backed by a /device dir) flapping; lo + a virtual tun must be ignored
  mkdir -p "$td/net/eth0/device" "$td/net/lo" "$td/net/tun0"
  printf '5\n' > "$td/net/eth0/carrier_changes"; printf '1\n' > "$td/net/eth0/carrier"
  printf '0\n' > "$td/net/lo/carrier_changes";   printf '1\n' > "$td/net/lo/carrier"
  printf '9\n' > "$td/net/tun0/carrier_changes"; printf '1\n' > "$td/net/tun0/carrier"   # no /device, no /wireless
  st="$td/state"
  # selection: only eth0 (5), not lo (no device), not tun0 (no device/wireless) -> total 5
  sel="$(NET="$td/net" select_links)"
  [ "$(printf '%s\n' "$sel" | awk '{s+=$2} END{print s}')" = 5 ] || { echo "smoke-test: FAIL (selection must be eth0 only, total 5; got: $sel)"; exit 1; }
  # run 1: cold -> BASELINE, real total, writes state
  g1="$(MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$st" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$g1" | grep -q '"verdict":"BASELINE"' || { echo "smoke-test: FAIL (cold run must be BASELINE: $g1)"; exit 1; }
  printf '%s\n' "$g1" | grep -q '"flaps_total":5' || { echo "smoke-test: FAIL (cold run real total=5: $g1)"; exit 1; }
  [ -s "$st" ] || { echo "smoke-test: FAIL (state must be written on first run)"; exit 1; }
  # run 2: counter jumped 5->8 -> FLAPPING with delta 3
  printf '8\n' > "$td/net/eth0/carrier_changes"
  g2="$(MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$st" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$g2" | grep -q '"verdict":"FLAPPING"' || { echo "smoke-test: FAIL (counter rise must be FLAPPING: $g2)"; exit 1; }
  printf '%s\n' "$g2" | grep -q '"flaps_delta":3' || { echo "smoke-test: FAIL (delta must be 3: $g2)"; exit 1; }
  # run 3: counter held -> STABLE, delta 0
  g3="$(MESH_NET_DIR="$td/net" MESH_LINK_FLAP_STATE="$st" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$g3" | grep -q '"verdict":"STABLE"' || { echo "smoke-test: FAIL (held counter must be STABLE: $g3)"; exit 1; }
  printf '%s\n' "$g3" | grep -q '"flaps_delta":0' || { echo "smoke-test: FAIL (held delta must be 0: $g3)"; exit 1; }
  # classifier unit checks
  [ "$(classify_flap 3 60 1)" = "FLAPPING 3.00" ] || { echo "smoke-test: FAIL (classify FLAPPING rate)"; exit 1; }
  [ "$(classify_flap 0 60 1)" = "STABLE 0.00" ]   || { echo "smoke-test: FAIL (classify STABLE)"; exit 1; }
  [ "$(classify_flap 9 0 0)" = "BASELINE 0.00" ]  || { echo "smoke-test: FAIL (classify cold BASELINE)"; exit 1; }
  # missing-source -> exit 2 (a net dir with only virtual/lo ifaces fakes nothing)
  mkdir -p "$td/empty/lo" "$td/empty/tun9"
  printf '0\n' > "$td/empty/lo/carrier_changes"; printf '0\n' > "$td/empty/tun9/carrier_changes"
  if MESH_NET_DIR="$td/empty" MESH_LINK_FLAP_STATE="$td/state2" bash "$0" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (no physical iface must exit 2, never fake STABLE)"; exit 1
  fi
  echo "smoke-test: ok (carrier-flap fixtures: BASELINE->FLAPPING->STABLE, selection, classifier:3, missing-source exit-2)"
  exit 0
fi

# --- live read ---
sel="$(select_links)" || { echo "link-flap: UNREACHABLE - no physical interface with carrier_changes" >&2; exit 2; }
total=0; ifdetail=""; ifjson=""
while read -r n cc car; do
  [ -n "$n" ] || continue
  total=$((total + cc))
  cs="UP"; [ "$car" = 0 ] && cs="DOWN"; [ "$car" = "?" ] && cs="?"
  ifdetail="$ifdetail ${n}:${cs}(${cc})"
  ifjson="${ifjson:+$ifjson,}{\"iface\":\"$n\",\"carrier\":\"$cs\",\"changes\":$cc}"
done <<<"$sel"
ifdetail="${ifdetail# }"

now="$(date +%s)"
have_prior=0; delta=0; window=0
if [ -r "$STATE" ]; then
  read -r p_total p_ts _ < "$STATE" 2>/dev/null || true
  if [[ "${p_total:-}" =~ ^[0-9]+$ ]] && [[ "${p_ts:-}" =~ ^[0-9]+$ ]]; then
    have_prior=1
    delta=$((total - p_total)); [ "$delta" -lt 0 ] && delta=0   # counter reset (reboot/iface churn) -> no spurious flap
    window=$((now - p_ts)); [ "$window" -lt 0 ] && window=0
  fi
fi

read -r verdict rate <<<"$(classify_flap "$delta" "$window" "$have_prior")"

# state written EVERY successful run -> mtime = ran-live (not change-gated)
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
printf '%s %s %s\n' "$total" "$now" "$verdict" > "$STATE" 2>/dev/null || true

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
case "${1:-}" in
  --json)
    printf '{"verdict":"%s","flaps_total":%s,"flaps_delta":%s,"window_s":%s,"rate_per_min":%s,"ifaces":[%s],"ts":"%s"}\n' \
      "$verdict" "$total" "$delta" "$window" "$rate" "$ifjson" "$ts"
    ;;
  *)
    if [ "$have_prior" = 1 ]; then
      printf '[link-flap] %s  +%s flaps / %ss (%s/min) · total=%s · %s\n' \
        "$verdict" "$delta" "$window" "$rate" "$total" "$ifdetail"
    else
      printf '[link-flap] %s  total=%s flaps since boot · %s  (no prior run — rate baselines next call)\n' \
        "$verdict" "$total" "$ifdetail"
    fi
    ;;
esac
