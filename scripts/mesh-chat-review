#!/usr/bin/env bash
# reflex-cadence: 37 * * * *
# mesh-chat-review — make the CHAT mind proactively ANALYSE the chat (not just reply when asked),
# on a cadence, and post improvement findings back to the board. Operator 2026-06-15: "the chat mind
# is very important; it should be analyzing chat itself once in some time and posting these results
# back into chat with a goal of improving mesh internals and chat communication."
#
# This is a TRIGGER, not the analyst: it injects an analysis prompt into the chat window's mind (the
# mind does the reasoning + posts [chat-review] lines via mesh-chat). Reflex, cron-wired (~hourly).
#
#   mesh-chat-review            inject one analysis cycle if due + chat mind idle
#   mesh-chat-review --force    ignore the throttle (still respects idle-gate + card-gate)
#   mesh-chat-review --test     smoke (deps, gates, dry — no injection)
#
# Gates (mind-touching tool → same card rule as mesh-restore/keepalive): SKIP unless this node's card
# declares minds; SKIP if the chat mind is not IDLE (never interrupt a working/blocked/walled mind);
# THROTTLE to MESH_CHAT_REVIEW_MIN minutes between cycles. Exit 0 always (reflex-friendly).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# ── TRAVERSAL, not wiring (D&G rhizome principle 6: make a MAP, not a TRACING) ────────────────
# "The tracing has already translated the map into an image... it has organized, stabilized,
#  neutralized the multiplicities... it reproduces only itself when it thinks it is reproducing
#  something else." — Deleuze & Guattari, A Thousand Plateaus, "Introduction: Rhizome", principle 6
#  (cartography & decalcomania). Their corrective is not "never trace" but "PLUG THE TRACINGS BACK
#  INTO THE MAP" — a declared line means nothing until something has crossed it.
#
# This tool declared its edge in FOUR places and none of them was the map: the cron line, its own
# green --test (which printed win=chat while never asking whether that window exists),
# docs/mesh-tooling.md:102, and charter/witness.md ("files [task] from chat-review"). MEASURED
# 2026-08-26 off ~/.mesh/chat-review.log: the last actual injection was 2026-07-23T10:37:03Z and
# every one of the 324 runs since 2026-07-30T10:37:01Z printed "skip: no 'chat' window" — the
# `chat` window was merged into `witness` on 2026-07-24 and the tool was bound to the NAME. 34 days
# dark, hourly, exit 0, --test green. So:
#   * the target is RESOLVED against the live world, never asserted by a name that can age out
#     (CLAUDE.md: "bind a guard to the thing itself, never to a name that ages out");
#   * every line this tool prints carries its TRAVERSAL AGE, so a dead edge says so in its own log;
#   * an unconditional RUN ROW is written per run (a mark file that records only successes is a
#     numerator with no denominator), and the dead-edge branch is LOUD on the board, not exit-0 quiet.
# Candidates in preference order; an explicit MESH_CHAT_REVIEW_WIN pins ONE and disables fallback.
if [ -n "${MESH_CHAT_REVIEW_WIN:-}" ]; then WIN_CANDIDATES="$MESH_CHAT_REVIEW_WIN"
else WIN_CANDIDATES="${MESH_CHAT_REVIEW_WINS:-chat witness}"; fi
CHATLOG="${CA_LOG:-$HOME/.mesh/chat.log}"
MARK="$HOME/.mesh/.chat-review-last"
RUNLOG="${MESH_CHAT_REVIEW_RUNLOG:-$HOME/.mesh/chat-review-runs.log}"   # every run, injected or not
DEAD_MARK="${MESH_CHAT_REVIEW_DEAD_MARK:-$HOME/.mesh/.chat-review-dead-alert}"
DEAD_DAYS="${MESH_CHAT_REVIEW_DEAD_DAYS:-3}"          # traversal age past which the edge reads DEAD
DEAD_ALERT_MIN="${MESH_CHAT_REVIEW_DEAD_ALERT_MIN:-1440}"   # board [fyi] at most this often

resolve_win(){ # first candidate that is a LIVE window in this node's session; rc 1 + nothing if none
  local w live; live="$(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null)"
  for w in $WIN_CANDIDATES; do
    printf '%s\n' "$live" | grep -qx "$w" && { printf '%s' "$w"; return 0; }
  done
  return 1
}

traversal_days(){ # whole days since the last ACTUAL injection; -1 = never traversed
  [ -f "$MARK" ] || { echo -1; return; }
  local t; t="$(cat "$MARK" 2>/dev/null)"; case "$t" in ''|*[!0-9]*) echo -1; return;; esac
  echo $(( ( $(date +%s) - t ) / 86400 ))
}
traversal_render(){
  local d; d="$(traversal_days)"
  [ "$d" -lt 0 ] && { echo "last-traversed=never"; return; }
  echo "last-traversed=$(date -u -d "@$(cat "$MARK")" +%FT%TZ) (${d}d ago)"
}
run_row(){ printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$1" "win=${2:-unresolved}" "$(traversal_render)" >> "$RUNLOG" 2>/dev/null || true; }
consec_skips(){ # runs since the last injected row, from this tool's OWN ledger (not the cron redirect)
  [ -r "$RUNLOG" ] || { echo 0; return; }
  tac "$RUNLOG" 2>/dev/null | awk -F'\t' '$2=="injected"{exit} {n++} END{print n+0}'
}
runlog_start(){ # epoch of the ledger's FIRST ROW, or "" when the tape can speak to nothing
  # The FIRST ROW, never the file mtime: mtime is the last WRITE, i.e. the writer's heartbeat, and
  # it would date the tape's END while claiming to date its start.
  [ -r "$RUNLOG" ] || { echo ""; return; }
  local first; first="$(head -n1 "$RUNLOG" 2>/dev/null | cut -f1)"
  # GATE ON THE SHAPE BEFORE HANDING IT TO date. `date -u -d x +%s` EXITS 0 on this system — GNU
  # date reads a bare letter as a military timezone designator and answers with today's midnight in
  # it. So a corrupt or half-written first field does not fail the parse, it mints a plausible
  # recent epoch, and the qualifier this function exists to raise would silently not raise.
  # [[a-widened-selector-mis-cuts-instead-of-failing]]
  case "$first" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
    *) echo ""; return;;
  esac
  date -u -d "$first" +%s 2>/dev/null || echo ""
}
# A COUNT MUST NOT BE PRINTED BESIDE AN AGE IT CANNOT SPAN. consec_skips counts rows in $RUNLOG,
# a ledger this tool only started keeping on 2026-08-26 (5230a736, 22:03:09Z). On phaedra that tape
# held ONE row, written 22:37:03Z, while the traversal mark read 2026-07-10T09:37:04Z — so the dead
# edge announced "1 consecutive skipped runs" beside "47d since the last injection", in one
# sentence. Both numbers were correct and their juxtaposition was a lie: the reader takes "1" for
# the size of the outage and it is the age of the INSTRUMENT. A young counter must never undersell
# an age it does not span, so the count is published WITH the span it can speak to, and a count
# that cannot reach back to the traversal is rendered as a FLOOR (>=N) with its ledger start named.
# [[a-ledger-derived-census-is-short-by-the-sliding-window]]
consec_skips_render(){ # the ONE deciding renderer; every site that prints this count calls it
  local n start mark
  n="$(consec_skips)"
  start="$(runlog_start)"
  # No tape at all is UNKNOWN, never 0 — a zero here reads as "no runs were skipped", which is the
  # single most misleading thing an absent instrument can say.
  [ -n "$start" ] || { echo "consecutive skipped runs: UNKNOWN (no run ledger yet at $RUNLOG)"; return; }
  mark=""; [ -f "$MARK" ] && mark="$(cat "$MARK" 2>/dev/null)"
  case "$mark" in ''|*[!0-9]*) mark="";; esac
  # Compare the ledger start to the MARK EPOCH, not to the floored day count beside it: a floor
  # would call a ledger that starts hours after the mark "spanning".
  if [ -z "$mark" ] || [ "$start" -gt "$mark" ]; then
    echo ">=$n consecutive skipped runs since $(date -u -d "@$start" +%FT%TZ) (this ledger's first row; it starts after the age quoted here and cannot count the runs before it)"
  else
    echo "$n consecutive skipped runs (ledger since $(date -u -d "@$start" +%FT%TZ), which spans the age quoted here)"
  fi
}
dead_due(){ # 0 when the edge is DEAD (traversal age past DEAD_DAYS, or never) AND the alert is untimely
  local d; d="$(traversal_days)"
  [ "$d" -lt 0 ] || [ "$d" -ge "$DEAD_DAYS" ] || return 1
  [ -f "$DEAD_MARK" ] || return 0
  local age=$(( ( $(date +%s) - $(stat -c %Y "$DEAD_MARK" 2>/dev/null || echo 0) ) / 60 ))
  [ "$age" -ge "$DEAD_ALERT_MIN" ]
}
announce_dead(){ # $1 = why. RARE (once per DEAD_ALERT_MIN) and LOUD (board + trace), never silent.
  dead_due || return 0
  local d n; d="$(traversal_days)"; n="$(consec_skips_render)"
  local age_txt; [ "$d" -lt 0 ] && age_txt="never traversed" || age_txt="${d}d since the last injection"
  mesh-trace "mesh-chat-review DEAD EDGE: $1 ($age_txt, $n)" >/dev/null 2>&1 || true
  mesh-chat "[fyi] mesh-chat-review: DEAD EDGE — $1. The reflex is cron-wired and green, and it has injected nothing: $age_txt, $n. Candidates tried: $WIN_CANDIDATES. This is the wiring, not the traversal — set MESH_CHAT_REVIEW_WIN to a live window or fix the channel." >/dev/null 2>&1 || true
  date +%s > "$DEAD_MARK" 2>/dev/null || true
}
THROTTLE_MIN="${MESH_CHAT_REVIEW_MIN:-55}"   # min minutes between proactive reviews
LOOKBACK="${MESH_CHAT_REVIEW_LINES:-220}"     # ~ how many recent board lines the mind should weigh
EVAP_LEDGER="${MESH_CHAT_REVIEW_EVAP:-$HOME/.mesh/.dispatch-evaporated}"  # mesh-dispatch's EVAP_STATE (read-only here)
EVAP_SHOW="${MESH_CHAT_REVIEW_EVAP_SHOW:-60}"  # cap the evap render; the drop is ANNOUNCED, never silent

card_declares_minds(){ # 0 if this node's card declares >=1 mind engine (else hands-off: skip)
  local l; l="$(grep -E '^[[:space:]]*minds:' "$HOME/.mesh-card" 2>/dev/null || true)"
  l="$(printf '%s' "$l" | sed 's/^.*minds:[[:space:]]*//')"
  case "$l" in *claude*|*opencode*|*codex*|*gemini*) return 0;; *) return 1;; esac
}

# Bare slug names (mesh-dispatch's id: the namespace is DROPPED, matching a [done] that omits it) carried by
# a given board marker. Reads board lines on stdin, emits one sorted-unique name per line. A slug must hold a
# hyphen and be >=6 chars — mirrors mesh-dispatch's slugof, so prose after a marker ("[task] fix the thing")
# yields nothing rather than a scraped English word.
slug_names(){ # $1 = marker alternation, e.g. 'done|taking'
  grep -oE "\[($1)\] ([a-z]+: )?([a-z][a-z0-9-]*/)?[a-z0-9]+(-[a-z0-9]+)+" 2>/dev/null \
    | sed -E "s/^\[($1)\] ([a-z]+: )?//; s#^[a-z][a-z0-9-]*/##" \
    | awk 'length($0) >= 6' | sort -u
}

digest(){ # cheap structural read so the mind starts from facts, not a cold scan (from retired mesh-chat-reflect)
  local tb tot ch idl su resolved closed_f open_s open_n evap_s evap_n evap_cap
  tb="$(tail -n "$LOOKBACK" "$CHATLOG" 2>/dev/null)"
  tot="$(printf '%s\n' "$tb" | grep -c . || true)"
  ch="$(printf '%s\n' "$tb" | grep -cE '\[mind-(paused|limited|blocked|unblocked)\]' || true)"
  idl="$(printf '%s\n' "$tb" | grep -cE '\[idle\]|\[room-moved\]' || true)"
  su=$(( tot - ch - idl )); [ "$su" -lt 0 ] && su=0
  echo "structural digest: of the last $tot board lines ~${ch} are mind-churn (paused/limited/blocked), ~${idl} idle/room-moved, ~${su} substantive — weigh whether low-value churn is drowning signal."
  # ANTI-PHANTOM-RE-RAISE (data-backed STALE-CHECK): the board is APPEND-ONLY, so the ORIGINAL noise of an
  # already-fixed issue stays visible in the lookback long after a [done] resolved it — which is exactly how a
  # re-raise happens (2026-06-21: context-heartbeat-gate/compact-failure-only/genome-strand-dedup were all
  # [done] 01:46-01:55, then re-flagged as NEW [task]s at 02:39 off the stale scrollback). Surface every slug
  # that ALREADY has a [done]/[taking] in THIS window so the STALE-CHECK is explicit DATA, not just discipline
  # the mind can overlook. Slug = the ns/name token right after the marker (tolerates a "stale: " prefix).
  resolved="$(printf '%s\n' "$tb" | grep -oE '\[(done|taking)\] ([a-z]+: )?[a-z][a-z0-9-]*/[a-z0-9-]+' \
              | sed -E 's/\[(done|taking)\] ([a-z]+: )?//' | sort -u | tr '\n' ' ')"
  [ -n "$resolved" ] && echo "already-resolved/claimed in this window (a [done] or [taking] EXISTS for these — do NOT re-raise any as a new [task] unless something genuinely REOPENED it; re-raising is a phantom that wastes a worker cycle): $resolved"

  # ANTI-RE-FILE, THE OTHER TWO TIERS (chat-review/review-guard-blind-to-open-and-evaporated-tasks): the scan
  # above sees only CLOSED work — the one case that needs no suppression. An OPEN [task] has neither marker BY
  # DEFINITION, and an evaporated one was never taken, so both were invisible to this guard and the lane
  # re-found its own unfixed work under fresh slugs (2026-07-15: selfcare-blips-have-no-duration 13:45 and
  # selfcare-full-state-flap-has-no-cooldown 18:41 — same mesh-selfcare:81-88, same day, two slugs, both
  # dispatchable; mesh-dispatch:50 had already documented the harm, the reviewer was just never told).
  # Both tiers read the FULL log, not the window: an old-but-open task is exactly the one a 220-line
  # lookback cannot see and is therefore most likely to be re-filed.
  closed_f="$(mktemp)"; slug_names 'done|taking' < "$CHATLOG" > "$closed_f" 2>/dev/null

  # (b) still-OPEN [task]s — filed, unclaimed, unfixed. Minus anything later [done]/[taking]: rendering
  # finished work as "open" would suppress nothing and mislead the mind about what is still live.
  # Deliberately UNCAPPED: this list IS the guard, and truncating it would re-open the exact blind spot
  # being closed here. It is self-limiting in practice — dispatch evaporates open tasks, so the set tracks
  # genuinely-live work (~120), not the board's unbounded history.
  open_s="$(slug_names 'task' < "$CHATLOG" | grep -vxF -f "$closed_f" | tr '\n' ' ')"
  open_n="$(printf '%s\n' $open_s | grep -c . || true)"
  [ -n "${open_s// /}" ] && echo "ALREADY FILED + OPEN ($open_n) — a [task] for these is on the board RIGHT NOW (full log; most are older than the ${LOOKBACK}-line window above, so you will NOT see them by scrolling): do NOT re-file any of them under a new name. If you have genuinely NEW evidence for one, post it as a [chat-review] citing the EXISTING slug — a second slug for the same defect double-dispatches two workers onto one fix: $open_s"

  # (c) EVAPORATED — filed, never taken, dropped by mesh-dispatch after STALE_TICKS of idle exposure. These
  # ids are dispatch's own key: re-filing under a DIFFERENT slug mints a fresh exposure counter and defeats
  # its id dedup, which is precisely how one defect gets re-reviewed 2-3x.
  if [ -r "$EVAP_LEDGER" ]; then
    # Dedup in LEDGER ORDER (append-only = chronological), never `sort -u`: the cap below is a tail, and a
    # tail of an alphabetised list drops an ARBITRARY subset. Kept chronological, `tail` means "the N most
    # RECENTLY evaporated" — the ones a reviewer scanning today's defects is most likely to re-find.
    evap_s="$(sed -E 's/^evap://; s/@[0-9]+$//' "$EVAP_LEDGER" 2>/dev/null | awk 'length($0) >= 6 && !seen[$0]++' \
              | grep -vxF -f "$closed_f" || true)"
    evap_n="$(printf '%s\n' "$evap_s" | grep -c . || true)"
    if [ "$evap_n" -gt 0 ]; then
      evap_cap="$(printf '%s\n' "$evap_s" | tail -n "$EVAP_SHOW" | tr '\n' ' ')"
      echo "FILED + EVAPORATED unclaimed ($evap_n still-open ids$([ "$evap_n" -gt "$EVAP_SHOW" ] && echo ", showing $EVAP_SHOW — the rest are in $EVAP_LEDGER, not dropped silently")) — dispatch gave up on these after nobody took them; they are NOT fixed and NOT invalid. Re-file one ONLY with new evidence, and REUSE THE ORIGINAL SLUG verbatim (a new slug is a new dispatch id and re-files the same work as if new): $evap_cap"
    fi
  fi
  rm -f "$closed_f"
}

prompt_text(){ cat <<EOF
[proactive chat-review — you are the chat mind, this is a scheduled self-analysis, NOT an operator request]
$(digest)
Read the last ~${LOOKBACK} lines of the board ($CHATLOG) and study the mesh's own communication. Find up
to THREE concrete, NON-OBVIOUS improvements to (a) mesh INTERNALS and (b) chat/board COMMUNICATION —
e.g. a reflex that flaps or spams, low-signal noise drowning real signal, recurring miscommunication,
coordination gaps, dead/duplicated/stranded work, a marker misused, an alert that cries wolf. For each
concrete finding post TWO board lines (in order):
  1. mesh-chat "[chat-review] <specific finding> → <concrete fix + owner/window>"
  2. mesh-chat "[task] chat-review/<short-name>: <one-sentence fix description> (owner: <tool/window>)"
The [task] line is mandatory for real findings — it queues the fix for worker minds via dispatch.
Rules: be specific and actionable (name the tool/window/pattern); skip anything already raised in a recent
[chat-review]. CODE-CHECK before posting a [chat-review] about mesh INTERNALS (a reflex's behaviour, a
flap, a spam, a marker misuse, a dead tool, a duplicated reflex, a stranded cron) — OPEN the named
file under scripts/ (or ~/.local/bin/ if deployed) and VERIFY the issue exists in the CURRENT code
(a function literally missing, a threshold literally wrong, a comment that contradicts the next
line, an unguarded regex, a cron that's no-op). Board scrollback + git log + a SLUG match are
NOT enough — each is a "sounds plausible" trap that produced phantom [task]s against long-fixed
issues (2026-06-22 review-of-reviews: 3 of the last 5 [chat-review]-driven [task]s were stale; the
chat mind cited a slug that already had a [done] and a code-line that was no longer in the
source). The bar is: "I READ the code, here is the LINE NUMBER, here is WHAT IT DOES, and here is
WHY it's wrong" — without all three, do NOT post the [task] (the [chat-review] note alone is fine
if the finding is real but unverifiable, framed as "unverified, needs code-confirm"). STALE-CHECK
before flagging ANY "still broken / still flapping / still on the board" defect —
the board is APPEND-ONLY, so a fixed issue's old lines stay visible forever and a line's age is NOT proof
it is live: (a) is there a later [done]/[taking] already resolving this exact issue? search the slug; (b)
did a fix route the signal to the TRACE tier — grep ~/.mesh/traces.log, not just the board (routine thermal
STRESSED-flap, recoveries, low-value churn live in trace BY DESIGN now); (c) does the flagged line's
TIMESTAMP predate that [done]/fix-commit? complaints lag reality. If it is already resolved, do NOT re-raise
it (a re-raised [task] double-dispatches a worker onto already-done work). If nothing genuinely new, post a
single "[chat-review] nothing new — board healthy" (no [task]).
Do NOT just summarize the chatter. Goal: improve how the mesh works and talks, one real fix at a time.
EOF
}

case "${1:-}" in
  --test)
    command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
    command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
    command -v mesh-mind-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
    [ -n "$(prompt_text)" ] || { echo "smoke-test: FAIL (empty prompt)"; exit 1; }
    prompt_text | grep -q 'STALE-CHECK' || { echo "smoke-test: FAIL (prompt lost the STALE-CHECK guard — re-raises resolved items)"; exit 1; }
    prompt_text | grep -q 'traces.log' || { echo "smoke-test: FAIL (STALE-CHECK must point at the trace tier)"; exit 1; }
    # CODE-CHECK (chat-review/chat-review-source-validation): a [chat-review] about mesh INTERNALS must be
    # validated against the CURRENT source (line-number + what-it-does + why-it's-wrong) before posting
    # the [task]. The bar is structural, not narrative — assert the three required elements appear.
    prompt_text | grep -q 'CODE-CHECK' || { echo "smoke-test: FAIL (CODE-CHECK rule missing from prompt)"; exit 1; }
    prompt_text | grep -qiE 'LINE NUMBER|WHAT IT DOES|WHY.{0,5}WRONG' || { echo "smoke-test: FAIL (CODE-CHECK must require line-number + what-it-does + why-it's-wrong — three pillars)"; exit 1; }
    # digest must surface a slug that already has a [done] in the window (data-backed anti-phantom-re-raise),
    # and tolerate the "stale: " prefix form — both real shapes seen on the board 2026-06-21.
    tmp_cl="$(mktemp)"; printf '%s\n' \
      "2026-06-21T01:46:05Z u@h  ::  [done] chat-review/context-heartbeat-gate: fixed" \
      "2026-06-21T01:55:51Z u@h  ::  [done] stale: chat-review/genome-strand-dedup: already done" \
      "2026-06-21T02:39:49Z u@h  ::  [task] chat-review/context-heartbeat-gate: re-raise off stale scrollback" > "$tmp_cl"
    dg="$(CHATLOG="$tmp_cl" digest)"; rm -f "$tmp_cl"
    printf '%s' "$dg" | grep -q 'already-resolved' || { echo "smoke-test: FAIL (digest must surface already-resolved slugs)"; exit 1; }
    printf '%s' "$dg" | grep -q 'chat-review/context-heartbeat-gate' || { echo "smoke-test: FAIL (digest missed a [done] slug)"; exit 1; }
    printf '%s' "$dg" | grep -q 'chat-review/genome-strand-dedup' || { echo "smoke-test: FAIL (digest missed a 'stale:'-prefixed [done] slug)"; exit 1; }
    # UNION GUARD (chat-review/review-guard-blind-to-open-and-evaporated-tasks): the [done]/[taking] window
    # scan above can only ever see CLOSED work — the one case needing no suppression. An OPEN [task] carries
    # NEITHER marker by definition, and an evaporated one was never taken, so both are structurally invisible
    # and this lane re-files its own unfixed findings under fresh slugs (live: selfcare-blips-have-no-duration
    # 13:45 vs selfcare-full-state-flap-has-no-cooldown 18:41 — same mesh-selfcare:81-88, 5h apart, two slugs,
    # both dispatchable). Fixture drives all three legs at once: an open [task] OUTSIDE the window (LOOKBACK=2),
    # an evap ledger, and a task that was later [done] (must appear in NEITHER new list — it is closed, and
    # naming it "open" would re-mint work that is finished).
    tmp_cl2="$(mktemp)"; tmp_ev="$(mktemp)"
    printf '%s\n' \
      "2026-07-15T12:00:00Z u@h  ::  [task] chat-review/already-fixed-thing: do the thing" \
      "2026-07-15T13:45:01Z u@h  ::  [task] chat-review/selfcare-blips-have-no-duration: mesh-selfcare:81-89 boards every flip" \
      "2026-07-15T18:00:00Z u@h  ::  [done] chat-review/already-fixed-thing: shipped" \
      "2026-07-15T19:00:00Z u@h  ::  [idle] nothing new" > "$tmp_cl2"
    printf 'evap:some-evaporated-slug@1784091790\nevap:legacy-bare-slug\nevap:already-fixed-thing\n' > "$tmp_ev"
    dg2="$(CHATLOG="$tmp_cl2" EVAP_LEDGER="$tmp_ev" LOOKBACK=2 digest)"
    rm -f "$tmp_cl2" "$tmp_ev"
    op="$(printf '%s\n' "$dg2" | grep -F 'ALREADY FILED + OPEN' || true)"
    ev="$(printf '%s\n' "$dg2" | grep -F 'EVAPORATED unclaimed' || true)"
    [ -n "$op" ] || { echo "smoke-test: FAIL (digest surfaces no OPEN [task] line — the re-file guard is blind to open work)"; exit 1; }
    printf '%s' "$op" | grep -q 'selfcare-blips-have-no-duration' \
      || { echo "smoke-test: FAIL (digest missed an OPEN [task] filed outside the ${LOOKBACK}-line window — the exact re-file harm)"; exit 1; }
    printf '%s' "$op" | grep -q 'already-fixed-thing' \
      && { echo "smoke-test: FAIL (a [done] task rendered as still-OPEN — the guard would suppress re-raising finished work as if pending)"; exit 1; } || true
    [ -n "$ev" ] || { echo "smoke-test: FAIL (digest surfaces no EVAPORATED line — never-taken work is invisible and gets re-filed under a new slug)"; exit 1; }
    printf '%s' "$ev" | grep -q 'some-evaporated-slug' || { echo "smoke-test: FAIL (digest missed a mint-keyed evap id)"; exit 1; }
    printf '%s' "$ev" | grep -q 'legacy-bare-slug'     || { echo "smoke-test: FAIL (digest missed a legacy bare-slug evap id)"; exit 1; }
    printf '%s' "$ev" | grep -q 'already-fixed-thing' \
      && { echo "smoke-test: FAIL (an evap id with a later [done] rendered as re-filable — it is closed)"; exit 1; } || true
    printf '%s' "$ev" | grep -qi 'REUSE THE ORIGINAL SLUG' \
      || { echo "smoke-test: FAIL (evap line must instruct slug reuse — slug drift is what defeats dispatch's id dedup)"; exit 1; }
    # ── THE MAP, NOT THE TRACING ──────────────────────────────────────────────────────────────
    # Everything above this line asserts the tool's own TEXT — that the prompt still carries its
    # guard strings, that digest() still renders its lists. That is a tracing checking a tracing:
    # it reproduces only itself, and it printed "smoke-test: ok (win=chat ...)" for 34 days while
    # the `chat` window did not exist and the reflex injected nothing. The arms below ask the live
    # world instead.
    # Fixture arms first, on TEMP state — a --test must never write the mark/ledger a human or a
    # watchdog reads for liveness, or the dry run forges the evidence it exists to check.
    _oM="$MARK" _oR="$RUNLOG" _oD="$DEAD_MARK"
    MARK="$(mktemp)"; RUNLOG="$(mktemp)"; DEAD_MARK="$(mktemp -u)"
    rm -f "$MARK"; [ "$(traversal_days)" = "-1" ] || { echo "smoke-test: FAIL (a missing mark must read as never-traversed, not as age 0 — a fresh node would look freshly-crossed)"; exit 1; }
    traversal_render | grep -q 'last-traversed=never' || { echo "smoke-test: FAIL (never-traversed must render as a WORD, not a date)"; exit 1; }
    dead_due || { echo "smoke-test: FAIL (a never-traversed edge must read DEAD)"; exit 1; }
    date +%s > "$MARK"
    [ "$(traversal_days)" = "0" ] || { echo "smoke-test: FAIL (a just-crossed edge must read 0d)"; exit 1; }
    dead_due && { echo "smoke-test: FAIL (a just-crossed edge read DEAD — the alarm would fire on a healthy lane)"; exit 1; } || true
    echo $(( $(date +%s) - 40*86400 )) > "$MARK"
    [ "$(traversal_days)" -ge "$DEAD_DAYS" ] || { echo "smoke-test: FAIL (a 40d-old traversal must exceed DEAD_DAYS=$DEAD_DAYS)"; exit 1; }
    dead_due || { echo "smoke-test: FAIL (a 40d-dark edge did not read DEAD — the exact 2026-07/08 blind spot)"; exit 1; }
    printf '%s\n' $'x\tinjected\tw\ta' $'x\tskip-unresolved\tw\ta' $'x\tskip-unresolved\tw\ta' > "$RUNLOG"
    [ "$(consec_skips)" = "2" ] || { echo "smoke-test: FAIL (consec_skips counted $(consec_skips), expected 2 — the run ledger is the denominator the mark file cannot be)"; exit 1; }
    # THE COUNT MUST CARRY THE SPAN IT CAN SPEAK TO. The rows above are stamped "x", which no date
    # can parse, so the tape's start is unreadable and the render must say UNKNOWN rather than pass
    # the bare count through. Then the phaedra shape verbatim: a 47d-old mark with a ledger whose
    # first row is minutes old must render a FLOOR naming that row, never "1 consecutive skipped".
    consec_skips_render | grep -q 'UNKNOWN' || { echo "smoke-test: FAIL (an undateable ledger rendered a bare count instead of UNKNOWN — a young instrument would undersell the outage)"; exit 1; }
    _now=$(date +%s)
    printf '%s\n' "$(date -u -d "@$(( _now - 600 ))" +%FT%TZ)"$'\tskip-unresolved\tw\ta' > "$RUNLOG"
    echo $(( _now - 47*86400 )) > "$MARK"
    consec_skips_render | grep -q '^>=1 consecutive skipped runs since ' || { echo "smoke-test: FAIL (a ledger younger than the age beside it printed an EXACT count: $(consec_skips_render))"; exit 1; }
    consec_skips_render | grep -q 'cannot count the runs before it' || { echo "smoke-test: FAIL (the floor render does not SAY why it is a floor)"; exit 1; }
    # ...and the announcement a human actually reads must carry it, not just the helper.
    announce_dead "fixture" >/dev/null 2>&1 || true
    # The complement: a ledger that DOES span the mark keeps the exact count, or the qualifier would
    # be a permanent hedge that never resolves and readers would learn to ignore it.
    echo $(( _now - 300 )) > "$MARK"
    consec_skips_render | grep -q '^1 consecutive skipped runs (ledger since ' || { echo "smoke-test: FAIL (a ledger that DOES span the age was hedged anyway: $(consec_skips_render))"; exit 1; }
    # A never-traversed edge cannot be spanned by anything, so it is a floor too.
    rm -f "$MARK"
    consec_skips_render | grep -q '^>=' || { echo "smoke-test: FAIL (a never-traversed edge got an exact count)"; exit 1; }
    # An absent tape is UNKNOWN, never 0.
    rm -f "$RUNLOG"
    consec_skips_render | grep -q 'UNKNOWN (no run ledger yet' || { echo "smoke-test: FAIL (an absent ledger rendered a number instead of UNKNOWN)"; exit 1; }
    rm -f "$MARK" "$RUNLOG"; MARK="$_oM"; RUNLOG="$_oR"; DEAD_MARK="$_oD"
    # Live arm: does this node actually have a window to inject into? A hands-off node legitimately
    # has none (exit 2 = organ absent here, so autowire/doctor SKIP rather than go red). A node that
    # DECLARES minds and cannot resolve a target is the dead-edge fault itself — that is a FAIL.
    if ! card_declares_minds; then
      echo "smoke-test: n/a (card declares no minds — hands-off node, this reflex cannot fire here)"; exit 2
    fi
    rw="$(resolve_win)" || { echo "smoke-test: FAIL (no live window among [$WIN_CANDIDATES] in session $(hostname) — the reflex is wired and can never fire; $(traversal_render))"; exit 1; }
    echo "smoke-test: ok (win=$rw resolved from [$WIN_CANDIDATES] throttle=${THROTTLE_MIN}m card=declares-minds chatlog=$([ -r "$CHATLOG" ] && echo readable || echo MISSING) $(traversal_render))"
    exit 0;;
  --force) FORCE=1;;
  "") FORCE=0;;
  *) echo "usage: mesh-chat-review [--force|--test]"; exit 0;;
esac

# card gate — a node whose card declares no minds is HANDS-OFF (operator rule 2026-06-15). This is
# a legitimate PERMANENT absence, so it writes a run row and never raises the dead-edge alarm.
card_declares_minds || { echo "$(date -u +%FT%TZ) skip: card declares no minds (hands-off) — $(traversal_render)"; run_row skip-handsoff; exit 0; }

# TARGET — resolved against the live world, never asserted by name. The old gate grepped for a
# literal 'chat' window and exited 0; when that channel merged into witness the reflex went dark for
# 34 days while staying cron-wired and --test green. Unresolvable is LOUD, not quiet.
WIN="$(resolve_win)" || {
  run_row skip-unresolved
  echo "$(date -u +%FT%TZ) skip: NO TARGET WINDOW — none of [$WIN_CANDIDATES] is live in session $(hostname) — $(traversal_render), $(consec_skips_render)"
  announce_dead "no target window (tried: $WIN_CANDIDATES)"; exit 0; }

# throttle — reads the TRAVERSAL mark, so it can only ever fire on a recently-crossed edge
if [ "${FORCE:-0}" != 1 ] && [ -f "$MARK" ]; then
  age=$(( ( $(date +%s) - $(stat -c %Y "$MARK" 2>/dev/null || echo 0) ) / 60 ))
  [ "$age" -lt "$THROTTLE_MIN" ] && { echo "$(date -u +%FT%TZ) skip: reviewed ${age}m ago (<${THROTTLE_MIN}m)"; run_row skip-throttled "$WIN"; exit 0; }
fi
# idle gate — never interrupt a working / blocked / rate-limited mind. A mind that is NEVER idle is
# an edge that is never crossed, so this branch is dead-edge-eligible too (28 DEAD-SHELL skips ran
# here before the window vanished, and nothing said the lane had stopped producing).
st="$(mesh-mind-state "$WIN" 2>/dev/null | cut -f1)"
[ "$st" = IDLE ] || { run_row "skip-$st" "$WIN"
  echo "$(date -u +%FT%TZ) skip: $WIN is $st (only inject when IDLE) — $(traversal_render), $(consec_skips_render)"
  announce_dead "$WIN has not been IDLE (state: $st)"; exit 0; }

if mesh-tell "$WIN" "$(prompt_text)" >/dev/null 2>&1; then
  date +%s > "$MARK"; rm -f "$DEAD_MARK" 2>/dev/null
  run_row injected "$WIN"
  echo "$(date -u +%FT%TZ) injected chat-review into $WIN"
else
  run_row skip-tellfailed "$WIN"
  echo "$(date -u +%FT%TZ) skip: mesh-tell to $WIN FAILED — $(traversal_render), $(consec_skips_render)"
  announce_dead "mesh-tell to $WIN failed"
fi
exit 0
