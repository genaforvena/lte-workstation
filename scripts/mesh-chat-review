#!/usr/bin/env bash
# reflex-cadence: 37 * * * *
# mesh-chat-review — make the CHAT mind proactively ANALYSE the chat (not just reply when asked),
# on a cadence, and post improvement findings back to the board. Operator 2026-06-15: "the chat mind
# is very important; it should be analyzing chat itself once in some time and posting these results
# back into chat with a goal of improving mesh internals and chat communication."
#
# This is a TRIGGER, not the analyst: it injects an analysis prompt into the chat window's mind (the
# mind does the reasoning + posts [chat-review] lines via mesh-chat). Reflex, cron-wired (~hourly).
#
#   mesh-chat-review            inject one analysis cycle if due + chat mind idle
#   mesh-chat-review --force    ignore the throttle (still respects idle-gate + card-gate)
#   mesh-chat-review --test     smoke (deps, gates, dry — no injection)
#
# Gates (mind-touching tool → same card rule as mesh-restore/keepalive): SKIP unless this node's card
# declares minds; SKIP if the chat mind is not IDLE (never interrupt a working/blocked/walled mind);
# THROTTLE to MESH_CHAT_REVIEW_MIN minutes between cycles. Exit 0 always (reflex-friendly).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

WIN="${MESH_CHAT_REVIEW_WIN:-chat}"
CHATLOG="${CA_LOG:-$HOME/.mesh/chat.log}"
MARK="$HOME/.mesh/.chat-review-last"
THROTTLE_MIN="${MESH_CHAT_REVIEW_MIN:-55}"   # min minutes between proactive reviews
LOOKBACK="${MESH_CHAT_REVIEW_LINES:-220}"     # ~ how many recent board lines the mind should weigh

card_declares_minds(){ # 0 if this node's card declares >=1 mind engine (else hands-off: skip)
  local l; l="$(grep -E '^[[:space:]]*minds:' "$HOME/.mesh-card" 2>/dev/null || true)"
  l="$(printf '%s' "$l" | sed 's/^.*minds:[[:space:]]*//')"
  case "$l" in *claude*|*opencode*|*codex*|*gemini*) return 0;; *) return 1;; esac
}

digest(){ # cheap structural read so the mind starts from facts, not a cold scan (from retired mesh-chat-reflect)
  local tb tot ch idl su
  tb="$(tail -n "$LOOKBACK" "$CHATLOG" 2>/dev/null)"
  tot="$(printf '%s\n' "$tb" | grep -c . || true)"
  ch="$(printf '%s\n' "$tb" | grep -cE '\[mind-(paused|limited|blocked|unblocked)\]' || true)"
  idl="$(printf '%s\n' "$tb" | grep -cE '\[idle\]|\[room-moved\]' || true)"
  su=$(( tot - ch - idl )); [ "$su" -lt 0 ] && su=0
  echo "structural digest: of the last $tot board lines ~${ch} are mind-churn (paused/limited/blocked), ~${idl} idle/room-moved, ~${su} substantive — weigh whether low-value churn is drowning signal."
}

prompt_text(){ cat <<EOF
[proactive chat-review — you are the chat mind, this is a scheduled self-analysis, NOT an operator request]
$(digest)
Read the last ~${LOOKBACK} lines of the board ($CHATLOG) and study the mesh's own communication. Find up
to THREE concrete, NON-OBVIOUS improvements to (a) mesh INTERNALS and (b) chat/board COMMUNICATION —
e.g. a reflex that flaps or spams, low-signal noise drowning real signal, recurring miscommunication,
coordination gaps, dead/duplicated/stranded work, a marker misused, an alert that cries wolf. For each
concrete finding post TWO board lines (in order):
  1. mesh-chat "[chat-review] <specific finding> → <concrete fix + owner/window>"
  2. mesh-chat "[task] chat-review/<short-name>: <one-sentence fix description> (owner: <tool/window>)"
The [task] line is mandatory for real findings — it queues the fix for worker minds via dispatch.
Rules: be specific and actionable (name the tool/window/pattern); skip anything already raised in a recent
[chat-review]. STALE-CHECK before flagging ANY "still broken / still flapping / still on the board" defect —
the board is APPEND-ONLY, so a fixed issue's old lines stay visible forever and a line's age is NOT proof
it is live: (a) is there a later [done]/[taking] already resolving this exact issue? search the slug; (b)
did a fix route the signal to the TRACE tier — grep ~/.mesh/traces.log, not just the board (routine thermal
STRESSED-flap, recoveries, low-value churn live in trace BY DESIGN now); (c) does the flagged line's
TIMESTAMP predate that [done]/fix-commit? complaints lag reality. If it is already resolved, do NOT re-raise
it (a re-raised [task] double-dispatches a worker onto already-done work). If nothing genuinely new, post a
single "[chat-review] nothing new — board healthy" (no [task]).
Do NOT just summarize the chatter. Goal: improve how the mesh works and talks, one real fix at a time.
EOF
}

case "${1:-}" in
  --test)
    command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
    command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
    command -v mesh-mind-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
    [ -n "$(prompt_text)" ] || { echo "smoke-test: FAIL (empty prompt)"; exit 1; }
    prompt_text | grep -q 'STALE-CHECK' || { echo "smoke-test: FAIL (prompt lost the STALE-CHECK guard — re-raises resolved items)"; exit 1; }
    prompt_text | grep -q 'traces.log' || { echo "smoke-test: FAIL (STALE-CHECK must point at the trace tier)"; exit 1; }
    if card_declares_minds; then cg="declares-minds"; else cg="hands-off"; fi
    echo "smoke-test: ok (win=$WIN throttle=${THROTTLE_MIN}m card=$cg chatlog=$([ -r "$CHATLOG" ] && echo readable || echo MISSING))"
    exit 0;;
  --force) FORCE=1;;
  "") FORCE=0;;
  *) echo "usage: mesh-chat-review [--force|--test]"; exit 0;;
esac

# card gate — a node whose card declares no minds is HANDS-OFF (operator rule 2026-06-15)
card_declares_minds || { echo "$(date -u +%FT%TZ) skip: card declares no minds (hands-off)"; exit 0; }
# window must exist as a 2-pane channel
tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN" \
  || { echo "$(date -u +%FT%TZ) skip: no '$WIN' window"; exit 0; }
# throttle
if [ "${FORCE:-0}" != 1 ] && [ -f "$MARK" ]; then
  age=$(( ( $(date +%s) - $(stat -c %Y "$MARK" 2>/dev/null || echo 0) ) / 60 ))
  [ "$age" -lt "$THROTTLE_MIN" ] && { echo "$(date -u +%FT%TZ) skip: reviewed ${age}m ago (<${THROTTLE_MIN}m)"; exit 0; }
fi
# idle gate — never interrupt a working / blocked / rate-limited mind
st="$(mesh-mind-state "$WIN" 2>/dev/null | cut -f1)"
[ "$st" = IDLE ] || { echo "$(date -u +%FT%TZ) skip: $WIN is $st (only inject when IDLE)"; exit 0; }

mesh-tell "$WIN" "$(prompt_text)" >/dev/null 2>&1 && { date +%s > "$MARK"; echo "$(date -u +%FT%TZ) injected chat-review into $WIN"; }
exit 0
