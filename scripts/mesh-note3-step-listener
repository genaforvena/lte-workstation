#!/usr/bin/env bash
# mesh-note3-step-listener — one native Note3 HAL listener for step/motion + magnetic events.
# Reads Android sensor types 17 (significant motion), 18 (step detector), 19 (step counter),
# and 2 (magnetic field) through the existing sensorcat client. Exit 2 means no live event.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

SERIAL="${MESH_NOTE3_ADB_SERIAL:-4d00553d61ab90b7}"
NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-local}}"
SECS="${MESH_NOTE3_STEP_SECS:-4}"
ARTIFACT=""
JSON=0

usage() { echo "usage: $0 [--json] [--artifact PATH] [--test]"; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --artifact) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; ARTIFACT="$2"; shift 2 ;;
    --test)
      fixture=$'SENSOR|Significant Motion|17|1|0|0|1001\nSENSOR|Step Detector|18|1|0|0|1002\nSENSOR|Step Counter|19|42|0|0|1003\nSENSOR|Magnetic Field|2|10.5|-2.0|40.0|1004'
      MESH_NOTE3_STEP_RAW_OVERRIDE="$fixture" exec "$0" --json
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

raw="${MESH_NOTE3_STEP_RAW_OVERRIDE:-}"
if [ -z "$raw" ]; then
  command -v mesh-note3-tool-install >/dev/null 2>&1 || { echo "step-listener: sensor installer absent" >&2; exit 1; }
  mesh-note3-tool-install sensorcat >/dev/null 2>&1 || { echo "step-listener: sensorcat unavailable" >&2; exit 2; }
  if [ "$NODE" = local ]; then
    raw="$(timeout "$((SECS + 15))" adb -s "$SERIAL" shell "/data/local/tmp/sensorcat --secs $SECS 17 18 19 2" 2>/dev/null || true)"
  else
    raw="$(timeout "$((SECS + 20))" ssh -o BatchMode=yes -o ConnectTimeout=8 \
      -o StrictHostKeyChecking=accept-new "$NODE" \
      "adb -s $SERIAL shell '/data/local/tmp/sensorcat --secs $SECS 17 18 19 2'" \
      </dev/null 2>/dev/null || true)"
  fi
fi

json="$(printf '%s\n' "$raw" | python3 -c '
import json, sys
wanted={2,17,18,19}; rows=[]
for line in sys.stdin:
    p=line.rstrip("\r\n").split("|")
    if len(p) < 7 or p[0] != "SENSOR":
        continue
    try:
        typ=int(p[2]); values=[float(x) for x in p[3:6]]; tick=int(p[6])
    except (ValueError, TypeError):
        continue
    if typ in wanted:
        rows.append({"name":p[1],"type":typ,"values":values,"timestamp_ns":tick})
print(json.dumps(rows, separators=(",",":")))
')"

count="$(printf '%s' "$json" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')"
[ "$count" -gt 0 ] || { echo "step-listener: no live events" >&2; exit 2; }

if [ -n "$ARTIFACT" ]; then
  mkdir -p "$(dirname -- "$ARTIFACT")"
  printf '%s\n' "$json" > "$ARTIFACT"
fi
if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$json"
else
  types="$(printf '%s' "$json" | python3 -c 'import json,sys; print(",".join(str(x["type"]) for x in json.load(sys.stdin)))')"
  echo "step-listener: events=$count types=$types artifact=${ARTIFACT:-none}"
fi
