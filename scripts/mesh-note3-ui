#!/usr/bin/env bash
# orphan-ok: MANUAL organ — the operator's/mind's hands on the Note3 panel. Every verb is an
#   ACTUATOR (a tap wakes the screen, types into whatever is focused, installs software), so this
#   is invoked on request and NEVER cron-wired. Its --test is the only self-driven path and it
#   restores the screen state it found.
# mesh-note3-ui — ONE tool instead of five adb incantations: SEE the Note3 screen, TAP it,
# TYPE into it, INSTALL an APK onto it. (SM-N900, Android 5.0 / API 21, ADB-only body.)
#
#   mesh-note3-ui --read [--all]      the UI TREE with tap-ready coordinates (text, not a picture —
#                                     ~1KB instead of a 1.7MB PNG; --all drops the label filter)
#   mesh-note3-ui --tap 540,1776      tap absolute coordinates
#   mesh-note3-ui --tap 'Phone'       tap the node whose text/content-desc matches (resolved from
#                                     the live ui.xml; ambiguous match lists candidates, exit 1)
#   mesh-note3-ui --type 'hello'      type into the focused field
#   mesh-note3-ui --key BACK          send a keyevent (BACK/HOME/APP_SWITCH/POWER/224=WAKEUP/…)
#   mesh-note3-ui --swipe unlock      dismiss the swipe keyguard (keyevent 82 does NOT, on API 21);
#                                     or --swipe 540,1500 540,500 [ms] for an arbitrary gesture
#   mesh-note3-ui --install app.apk   sideload an APK (file only — see BOUNDARIES)
#   mesh-note3-ui --shot [out.png]    full-resolution PNG screenshot (1080x1920)
#   mesh-note3-ui --test              real closed loop: shot → keyevent → shot, the two PNGs MUST
#                                     differ (a gate that cannot see the phone react is vacuous)
#
# WHY --read AND NOT --shot BY DEFAULT: a screenshot costs a window ~1.7MB and still needs a model
# to guess where a button is; uiautomator's tree already carries the label AND the bounds, so the
# tap coordinate is READ, never estimated. --shot is for when the pixels themselves are the answer.
#
# BOUNDARIES (fixed by the hardware, not by this tool):
#   · Android 5.0 / API 21. Most current APKs refuse to install (INSTALL_FAILED_OLDER_SDK — their
#     minSdk is above 21). Play Store on this body is dead; software arrives as FILES, via --install.
#   · `input text` on API 21 goes through the keyboard layer: ASCII only. Cyrillic/emoji silently
#     produce nothing — --type refuses non-ASCII loudly rather than typing a blank.
#   · THE TREE ITSELF IS ASCII. This body's `uiautomator dump` writes non-ASCII labels as literal
#     '?' bytes (0x3f) ON THE PHONE — verified 2026-08-15: `adb pull` and `exec-out cat` return
#     byte-identical files, so nothing is lost in transport, the label is simply gone at the source.
#     A Russian menu therefore reads as "??? ?????", and --tap 'Телефон' can never match. Tap what
#     --read actually PRINTS (the '?' form matches fine), or use coordinates.
#   · Every verb is logged to ~/.mesh/note3-ui.log — a tap can wake the panel, and an actuator that
#     acts without a record is indistinguishable from one that never ran.
#   · The CAMERA rule (operator, July: on request only, never on cron) is about mesh-note3-cam.
#     A SCREEN capture is not the room, so --shot is unrestricted — but it is still not scheduled.
#
# Node-relay convention (~/.mesh/nodes, never hardcode topology in the genome):
#   MESH_NOTE3_ADB_NODE    local | user@ip of the adb-hosting node   (default: local)
#   MESH_NOTE3_ADB_SERIAL  adb serial                                (default: 4d00553d61ab90b7)
#
# Exit codes: 0 = done · 2 = phone/adb node unreachable (honest n/a) · 1 = reachable but the
# action failed (a real defect — never collapsed into the n/a).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

NODE="${MESH_NOTE3_ADB_NODE:-local}"
SER="${MESH_NOTE3_ADB_SERIAL:-4d00553d61ab90b7}"
OUTDIR="$HOME/.mesh/note3"; mkdir -p "$OUTDIR" 2>/dev/null
LOG="${MESH_NOTE3_UI_LOG:-$HOME/.mesh/note3-ui.log}"
REMOTE_XML="/sdcard/mesh-ui.xml"

log() { printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG" 2>/dev/null || true; }

# node_sh / node_bin — run on the adb-hosting node. node_bin keeps stdout byte-clean (screencap).
node_sh()  { if [ "$NODE" = local ]; then bash -c "$1"; else ssh -o BatchMode=yes -o ConnectTimeout=6 "$NODE" "$1"; fi; }
node_bin() { if [ "$NODE" = local ]; then bash -c "$1"; else ssh -o BatchMode=yes -o ConnectTimeout=6 "$NODE" "$1"; fi; }
adb_sh()   { local cmd="$1" t="${2:-20}"; node_sh "timeout $t adb -s $SER shell \"$cmd\"" 2>/dev/null | tr -d '\r'; }

phone_up() { node_sh "timeout 8 adb -s $SER get-state 2>/dev/null" 2>/dev/null | tr -d '\r' | grep -q '^device$'; }

screen_on() { adb_sh "dumpsys power" 12 | grep -qE 'Display Power: state=ON|mScreenOn=true'; }

# ---- the ui.xml parser (stdlib only; reads a FILE, never stdin — a heredoc program would eat the payload)
PY='
import sys, re, xml.etree.ElementTree as ET
path, mode = sys.argv[1], sys.argv[2]
want = sys.argv[3] if len(sys.argv) > 3 else ""
try:
    root = ET.parse(path).getroot()
except Exception as e:
    print("parse-error: %s" % e, file=sys.stderr); sys.exit(3)
B = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")
rows = []
for n in root.iter("node"):
    m = B.match(n.get("bounds", "") or "")
    if not m: continue
    x1, y1, x2, y2 = (int(v) for v in m.groups())
    if x2 <= x1 or y2 <= y1: continue          # zero-area node: no tappable centre
    label = (n.get("text") or "").strip() or (n.get("content-desc") or "").strip()
    rows.append(dict(cx=(x1+x2)//2, cy=(y1+y2)//2, label=label,
                     cls=(n.get("class") or "").split(".")[-1],
                     click=n.get("clickable") == "true",
                     edit=n.get("class", "").endswith("EditText"),
                     scroll=n.get("scrollable") == "true",
                     pkg=n.get("package") or "", box="%d,%d-%d,%d" % (x1, y1, x2, y2)))
if mode == "read":
    all_ = want == "all"
    sel = rows if all_ else [r for r in rows if r["label"] and (r["click"] or r["edit"] or r["scroll"])]
    pkgs = {}
    for r in rows: pkgs[r["pkg"]] = pkgs.get(r["pkg"], 0) + 1
    top = max(pkgs, key=pkgs.get) if pkgs else "?"
    print("pkg=%s rotation=%s nodes=%d shown=%d%s"
          % (top, root.get("rotation", "?"), len(rows), len(sel), "" if all_ else " (labelled+actionable; --all for every node)"))
    for r in sel:
        flags = "".join(c for c, on in (("c", r["click"]), ("e", r["edit"]), ("s", r["scroll"])) if on) or "-"
        print("  %4d,%-5d [%-3s] %-18s %s" % (r["cx"], r["cy"], flags, r["cls"], r["label"] or "(no label)"))
    sys.exit(0)
if mode == "resolve":
    w = want.lower()
    exact = [r for r in rows if r["label"].lower() == w]
    part  = [r for r in rows if w in r["label"].lower()]
    for pool in (exact, part):
        c = [r for r in pool if r["click"]] or pool
        if len(c) == 1:
            print("%d %d %s" % (c[0]["cx"], c[0]["cy"], c[0]["label"])); sys.exit(0)
        if len(c) > 1:
            print("ambiguous: %d nodes match %r" % (len(c), want), file=sys.stderr)
            for r in c: print("  %d,%d  %s  [%s]" % (r["cx"], r["cy"], r["label"], r["cls"]), file=sys.stderr)
            sys.exit(4)
    print("no node matches %r" % want, file=sys.stderr); sys.exit(5)
'

dump_ui() {  # $1 = local path for ui.xml; 0 = ok
  local out="$1"
  adb_sh "uiautomator dump $REMOTE_XML" 30 | grep -q 'dumped to' || return 1
  node_bin "timeout 20 adb -s $SER exec-out cat $REMOTE_XML" > "$out" 2>/dev/null
  [ -s "$out" ] && grep -q '<hierarchy' "$out"
}

shot() {  # $1 = local png path; 0 = ok
  node_bin "timeout 30 adb -s $SER exec-out screencap -p" > "$1" 2>/dev/null
  [ -s "$1" ] && [ "$(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' ')" = "89504e47" ]
}

send_key() { adb_sh "input keyevent $1" 15 >/dev/null; log "key $1"; }

die_unreachable() { echo "note3-ui: n/a (Note3/adb node unreachable)"; log "n/a unreachable ($*)"; exit 2; }

# ------------------------------------------------------------------ verbs
VERB="${1:---read}"; shift 2>/dev/null || true

case "$VERB" in
--read)
  phone_up || die_unreachable read
  XML="$OUTDIR/ui.xml"
  dump_ui "$XML" || { echo "note3-ui: reachable but uiautomator dump failed"; log "read FAIL dump"; exit 1; }
  python3 -c "$PY" "$XML" read "$([ "${1:-}" = --all ] && echo all)" || exit 1
  log "read ($(wc -c < "$XML") B xml)"
  ;;

--shot)
  phone_up || die_unreachable shot
  PNG="${1:-$OUTDIR/screen-$(date +%s).png}"
  shot "$PNG" || { echo "note3-ui: reachable but screencap produced no valid PNG"; log "shot FAIL"; exit 1; }
  echo "png=$PNG bytes=$(stat -c%s "$PNG")"
  log "shot $PNG ($(stat -c%s "$PNG") B)"
  ;;

--tap)
  TARGET="${1:-}"
  [ -n "$TARGET" ] || { echo "usage: mesh-note3-ui --tap <x,y> | --tap '<label>'"; exit 1; }
  phone_up || die_unreachable tap
  if [[ "$TARGET" =~ ^[0-9]+[,\ ]+[0-9]+$ ]]; then
    X="${TARGET%%[, ]*}"; Y="${TARGET##*[, ]}"; WHAT="coords"
  else
    if LC_ALL=C grep -qP '[^\x20-\x7e]' <<< "$TARGET" 2>/dev/null; then
      echo "note3-ui: '$TARGET' is non-ASCII — this body's uiautomator writes such labels as literal '?',"
      echo "          so no tree node can ever carry it. Run --read and tap the '?' form it prints, or use x,y."
      log "tap REFUSED (non-ascii target)"; exit 1
    fi
    XML="$OUTDIR/ui.xml"
    dump_ui "$XML" || { echo "note3-ui: reachable but uiautomator dump failed"; log "tap FAIL dump"; exit 1; }
    RES="$(python3 -c "$PY" "$XML" resolve "$TARGET")" || { log "tap FAIL resolve '$TARGET'"; exit 1; }
    X="${RES%% *}"; REST="${RES#* }"; Y="${REST%% *}"; WHAT="'${REST#* }'"
  fi
  adb_sh "input tap $X $Y" 15 >/dev/null
  echo "tapped $X,$Y ($WHAT)"
  log "tap $X,$Y $WHAT"
  ;;

--type)
  TEXT="${1:-}"
  [ -n "$TEXT" ] || { echo "usage: mesh-note3-ui --type '<ascii text>'"; exit 1; }
  # API 21 `input text` is ASCII-only: non-ASCII types NOTHING and reports success. Refuse loudly.
  if LC_ALL=C grep -qP '[^\x20-\x7e]' <<< "$TEXT" 2>/dev/null; then
    echo "note3-ui: refusing — 'input text' on API 21 is ASCII-only; non-ASCII would type nothing silently"
    log "type REFUSED (non-ascii)"; exit 1
  fi
  phone_up || die_unreachable type
  # spaces → %s (the API-21 convention); shell-hostile chars are escaped for the remote sh
  ESC="$(printf '%s' "$TEXT" | sed -e 's/[\\"`$]/\\&/g' -e "s/'/\\\\'/g" -e 's/ /%s/g')"
  adb_sh "input text \\\"$ESC\\\"" 20 >/dev/null
  echo "typed ${#TEXT} chars"
  log "type ${#TEXT} chars"
  ;;

--swipe)
  # The swipe-up keyguard is the FIRST thing between a mind and this panel: on Android 5 `keyevent 82`
  # does NOT dismiss it (proven in mesh-note3-cam), a swipe does. Without this verb every other verb
  # aims at a lock screen.  --swipe unlock  = the canonical dismiss gesture.
  A="${1:-}"; B2="${2:-}"; MS="${3:-300}"
  if [ "$A" = unlock ] || [ -z "$A" ]; then A="540,1500"; B2="540,500"; fi
  [[ "$A" =~ ^[0-9]+,[0-9]+$ && "$B2" =~ ^[0-9]+,[0-9]+$ ]] || { echo "usage: mesh-note3-ui --swipe <x1,y1> <x2,y2> [ms] | --swipe unlock"; exit 1; }
  phone_up || die_unreachable swipe
  adb_sh "input swipe ${A%,*} ${A#*,} ${B2%,*} ${B2#*,} $MS" 15 >/dev/null
  echo "swiped $A → $B2 (${MS}ms)"; log "swipe $A→$B2 ${MS}ms"
  ;;

--key)
  K="${1:-}"; [ -n "$K" ] || { echo "usage: mesh-note3-ui --key <KEYCODE|number>"; exit 1; }
  phone_up || die_unreachable key
  send_key "$K"; echo "key $K sent"
  ;;

--install)
  APK="${1:-}"
  [ -n "$APK" ] && [ -f "$APK" ] || { echo "usage: mesh-note3-ui --install <file.apk>   (Play Store is dead on this body — files only)"; exit 1; }
  phone_up || die_unreachable install
  OUT="$(node_sh "timeout 180 adb -s $SER install -r $(printf '%q' "$APK")" 2>&1 | tr -d '\r')"
  echo "$OUT" | grep -q 'Success' && { echo "installed: $(basename "$APK")"; log "install OK $APK"; exit 0; }
  echo "$OUT" | grep -q 'INSTALL_FAILED_OLDER_SDK' && \
    echo "note3-ui: APK minSdk > 21 — this body is Android 5.0 and CANNOT run it (not a bug, a boundary)"
  echo "$OUT" | tail -3
  log "install FAIL $APK"
  exit 1
  ;;

--test)
  f=0
  # ---- offline: the parser must read a KNOWN tree, and must be able to FAIL to resolve.
  FX="$(mktemp)"; trap 'rm -f "$FX" "$FX.png1" "$FX.png2"' EXIT
  cat > "$FX" <<'XML'
<?xml version='1.0' encoding='UTF-8' standalone='yes' ?><hierarchy rotation="0">
<node index="0" text="" resource-id="" class="android.widget.FrameLayout" package="p" content-desc="" clickable="false" bounds="[0,0][1080,1920]" />
<node index="1" text="Phone" resource-id="" class="android.widget.TextView" package="p" content-desc="" clickable="true" bounds="[100,200][300,400]" />
<node index="2" text="" resource-id="" class="android.widget.EditText" package="p" content-desc="Search" clickable="true" bounds="[0,10][100,30]" />
<node index="3" text="Zero" resource-id="" class="android.widget.View" package="p" content-desc="" clickable="true" bounds="[5,5][5,5]" />
</hierarchy>
XML
  R="$(python3 -c "$PY" "$FX" resolve Phone)"
  [ "$R" = "200 300 Phone" ] || { echo "  FAIL: bounds→centre wrong (got '$R', want '200 300 Phone')"; f=1; }
  R2="$(python3 -c "$PY" "$FX" resolve search)"
  [ "$R2" = "50 20 Search" ] || { echo "  FAIL: content-desc/case-insensitive resolve wrong (got '$R2')"; f=1; }
  if python3 -c "$PY" "$FX" resolve nosuchbutton >/dev/null 2>&1; then
    echo "  FAIL: resolver must NOT invent a coordinate for an absent label"; f=1; fi
  python3 -c "$PY" "$FX" read | grep -q 'Zero' && { echo "  FAIL: zero-area node has no tappable centre and must be dropped"; f=1; }
  python3 -c "$PY" "$FX" read | grep -q 'shown=2' || { echo "  FAIL: read filter should show 2 labelled+actionable nodes"; f=1; }

  # ---- live: the phone must actually REACT. Without this the gate asserts nothing about the body.
  if ! phone_up; then
    [ "$f" = 0 ] && { echo "smoke-test: n/a (Note3 unreachable; offline parser asserts passed)"; exit 2; }
    echo "smoke-test: FAIL (offline asserts, phone unreachable)"; exit 1
  fi
  WAS_ON=1; screen_on || WAS_ON=0
  [ "$WAS_ON" = 0 ] && { send_key 224; sleep 2; }          # WAKEUP — logged, and restored below
  log "test: begin (screen_was_on=$WAS_ON)"
  if ! shot "$FX.png1"; then echo "  FAIL: no valid PNG from screencap"; f=1; fi
  send_key APP_SWITCH; sleep 3
  if ! shot "$FX.png2"; then echo "  FAIL: no valid PNG after keyevent"; f=1; fi
  M1="$(md5sum "$FX.png1" 2>/dev/null | cut -c1-8)"; M2="$(md5sum "$FX.png2" 2>/dev/null | cut -c1-8)"
  if [ -z "$M1" ] || [ "$M1" = "$M2" ]; then
    echo "  FAIL: screen did not change across APP_SWITCH ($M1 == $M2) — the loop is not closed"; f=1
  fi
  send_key BACK; sleep 2
  XMLT="$OUTDIR/.ui-test.xml"
  if dump_ui "$XMLT"; then
    python3 -c "$PY" "$XMLT" read | grep -qE '^ +[0-9]+,[0-9]+' || { echo "  FAIL: live --read produced no tappable coordinate"; f=1; }
  else
    echo "  FAIL: live uiautomator dump failed"; f=1
  fi
  [ "$WAS_ON" = 0 ] && send_key 26                          # restore the screen state we found
  log "test: end (fail=$f)"
  [ "$f" = 0 ] && { echo "smoke-test: ok (parser fixtures + live shot→keyevent→shot differed $M1→$M2 + live tree)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
  ;;

-h|--help)
  # print the whole header block by ANCHOR, not by line number — a line range rots on the next edit
  sed -n '/^# mesh-note3-ui —/,/^set -uo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
  ;;
*)
  echo "note3-ui: unknown verb '$VERB' — see --help"; exit 1;;
esac
