#!/usr/bin/env bash
# orphan-ok: on-demand privacy/contention sense — a mind/operator PULLS it to answer "is the camera or mic
#   being RECORDED right now, and by a mesh organ or a foreign process?" (e.g. before mesh-eye grabs a
#   frame, to avoid racing another capturer; or as a privacy spot-check). Not scheduled — it reads live
#   kernel FD state each call, keeps NO persistent state of its own; its artifact is the stdout/--json read.
#
# mesh-capture-inuse — the node's CAPTURE-CONTENTION / recording-awareness sense.
# Detects which processes currently hold the CAPTURE devices OPEN:
#   * cameras   — /dev/video*        (a UVC/webcam node held open = a frame stream is being pulled)
#   * mic       — /dev/snd/pcmC*Dc*  (an ALSA capture PCM held open = the mic is being recorded)
# via `fuser` (fallback `lsof`), mapping each holder PID → its comm + cmdline, and classifying it as a
# known MESH organ (fswebcam/ffmpeg/arecord/pipewire/wireplumber/pw-record/parecord or any `mesh-*` /
# `~/.mesh/` process) vs a FOREIGN process (something else recording).
#
# Why this is NOT an existing sense:
#   * mesh-audio-active reads PLAYBACK (/proc/asound streams the SPEAKERS emit) — the opposite direction.
#   * mesh-eye / mesh-overhear / mesh-tuner are CAPTURE *users*; none reports whether capture is BUSY or
#     by whom. Knowing that is a genuine signal: a privacy read ("is anything recording?") AND a
#     contention read (our own organs shouldn't race each other on one /dev/video0).
#
# Verdict (FIRST token — each unique, a consumer greps one):
#   FREE             capture devices present + a read tool present, but NO process holds any → nothing recording
#   MESH-CAPTURE     held ONLY by known mesh organs (expected self-use — our own eye/ear at work)
#   FOREIGN-CAPTURE  at least one holder is NOT a recognised mesh capturer → something else is recording (noteworthy)
#   UNKNOWN          cannot honestly assess (no fuser AND no lsof, OR no capture devices exist) → exit 2, never a faked FREE
#
# Honest-exit contract:
#   0 = assessed (FREE / MESH-CAPTURE / FOREIGN-CAPTURE — all real reads of live FD state)
#   2 = UNKNOWN — the read is impossible (missing tool, or no camera + no capture PCM on this node). A
#       genuine FREE (tools + devices present, nobody holding) is a DIFFERENT token from this — a blind
#       read never renders as "nothing recording".
#
#   mesh-capture-inuse            one-shot verdict + per-device holders
#   mesh-capture-inuse --edge     emit only when the verdict token changes (for anyone who wires it)
#   mesh-capture-inuse --json     {verdict, cam_inuse, mic_inuse, foreign, holders, devices_seen, tool, ts}
#   mesh-capture-inuse --test     offline fixtures: classifier + verdict fusion + honest UNKNOWN paths
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

EDGE_CACHE="${MESH_CI_EDGE:-$HOME/.mesh/.capture-inuse.edge}"   # non-.state name → declares NO unread state producer
TS="$(date -u +%FT%TZ)"

# Known mesh/media capture binaries + the mesh-script signature. FALSIFIABLE via --test.
MESH_CAP_RE="${MESH_CI_MESH_RE:-fswebcam|ffmpeg|arecord|parecord|pw-record|pipewire|wireplumber|mesh-|/\.mesh/|\.local/bin/mesh-|mesh-eye|mesh-camera|mesh-overhear|mesh-tuner|mesh-face|mesh-transcribe}"

# classify_holder <comm> <cmdline> → MESH | FOREIGN  (pure, offline-testable; the SOLE classifier both
# the live path and --test call — no drift between a tested duplicate and reality).
classify_holder() {
  local comm="$1" cmd="$2"
  if printf '%s\n%s' "$comm" "$cmd" | grep -Eq "$MESH_CAP_RE"; then echo MESH; else echo FOREIGN; fi
}

# capture_verdict <tools_ok:0|1> <n_devices> <n_mesh> <n_foreign> → verdict token (pure, whole matrix testable)
capture_verdict() {
  local tools_ok="$1" ndev="$2" nmesh="$3" nforeign="$4"
  if [ "$tools_ok" != 1 ]; then echo UNKNOWN; return; fi     # no fuser/lsof → cannot read → never fake FREE
  if [ "$ndev" -le 0 ]; then echo UNKNOWN; return; fi        # no capture hardware to assess → honest n/a
  if [ "$nforeign" -gt 0 ]; then echo FOREIGN-CAPTURE; return; fi
  if [ "$nmesh" -gt 0 ]; then echo MESH-CAPTURE; return; fi
  echo FREE
}

# ---------------------------------------------------------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
  f=0
  # (1) classifier — mesh capturers vs a foreign one. FALSIFIABLE: flip the regex → these flip.
  [ "$(classify_holder fswebcam '/usr/bin/fswebcam -d /dev/video0')" = MESH ] || { echo "  FAIL: fswebcam must classify MESH"; f=1; }
  [ "$(classify_holder ffmpeg   'ffmpeg -f v4l2 -i /dev/video0')"    = MESH ] || { echo "  FAIL: ffmpeg (media capture) must classify MESH"; f=1; }
  [ "$(classify_holder python3  'python3 /home/x/.local/bin/mesh-eye')" = MESH ] || { echo "  FAIL: a mesh-* script (cmdline) must classify MESH even with a python3 comm"; f=1; }
  [ "$(classify_holder arecord  'arecord -D plughw:0,0 x.wav')"      = MESH ] || { echo "  FAIL: arecord must classify MESH"; f=1; }
  [ "$(classify_holder zoom     '/opt/zoom/zoom')"                   = FOREIGN ] || { echo "  FAIL: a non-mesh app (zoom) must classify FOREIGN"; f=1; }
  [ "$(classify_holder cheese   'cheese')"                          = FOREIGN ] || { echo "  FAIL: a foreign camera app must classify FOREIGN"; f=1; }
  echo "  classifier ok (mesh organs/media tools -> MESH, foreign app -> FOREIGN)"
  # (2) verdict fusion — the whole matrix, incl the honest UNKNOWN paths.
  [ "$(capture_verdict 1 2 0 0)" = FREE            ] || { echo "  FAIL: tools+devices, no holders -> FREE"; f=1; }
  [ "$(capture_verdict 1 2 1 0)" = MESH-CAPTURE    ] || { echo "  FAIL: only mesh holders -> MESH-CAPTURE"; f=1; }
  [ "$(capture_verdict 1 2 1 1)" = FOREIGN-CAPTURE ] || { echo "  FAIL: any foreign holder -> FOREIGN-CAPTURE"; f=1; }
  [ "$(capture_verdict 1 2 0 1)" = FOREIGN-CAPTURE ] || { echo "  FAIL: a lone foreign holder -> FOREIGN-CAPTURE"; f=1; }
  # honest-unreachable: FREE (a real read) MUST differ from UNKNOWN (a blind read) — no faked all-clear.
  [ "$(capture_verdict 0 2 0 0)" = UNKNOWN         ] || { echo "  FAIL: no read tool -> UNKNOWN (never a faked FREE)"; f=1; }
  [ "$(capture_verdict 1 0 0 0)" = UNKNOWN         ] || { echo "  FAIL: no capture devices -> UNKNOWN (honest n/a)"; f=1; }
  [ "$(capture_verdict 1 2 0 0)" != "$(capture_verdict 0 2 0 0)" ] || { echo "  FAIL: FREE must never equal UNKNOWN — a blind read is not 'nothing recording'"; f=1; }
  echo "  verdict fusion ok (FREE/MESH/FOREIGN + honest UNKNOWN; FREE != UNKNOWN)"
  [ "$f" = 0 ] && echo "smoke-test: ok (capture classifier + verdict + honest UNKNOWN)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi

# ---- LIVE read -----------------------------------------------------------------------------------------
# read tool: prefer fuser, else lsof. (test-injectable so --test never touches real FDs.)
TOOL="${MESH_CI_TOOL:-}"
if [ -z "$TOOL" ]; then
  if command -v fuser >/dev/null 2>&1; then TOOL=fuser
  elif command -v lsof >/dev/null 2>&1; then TOOL=lsof
  else TOOL=none; fi
fi
TOOLS_OK=1; [ "$TOOL" = none ] && TOOLS_OK=0

# enumerate capture devices actually present on this node
DEVS=""
for d in /dev/video* ; do [ -e "$d" ] && DEVS="$DEVS $d"; done
for d in /dev/snd/pcmC*c ; do [ -e "$d" ] && DEVS="$DEVS $d"; done
NDEV=0; for d in $DEVS; do NDEV=$((NDEV+1)); done

holders_of() {  # <device> -> newline PIDs holding it open
  local d="$1"
  case "$TOOL" in
    fuser) fuser "$d" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' ;;
    lsof)  lsof -t "$d" 2>/dev/null | grep -E '^[0-9]+$' ;;
    *)     : ;;
  esac
}

NMESH=0; NFOREIGN=0; CAM_INUSE=0; MIC_INUSE=0; HOLDERS=""
if [ "$TOOLS_OK" = 1 ]; then
  for d in $DEVS; do
    for pid in $(holders_of "$d"); do
      comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
      cmd="$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null)"
      cls="$(classify_holder "$comm" "$cmd")"
      [ "$cls" = MESH ] && NMESH=$((NMESH+1)) || NFOREIGN=$((NFOREIGN+1))
      case "$d" in */video*) CAM_INUSE=1 ;; */pcmC*c) MIC_INUSE=1 ;; esac
      HOLDERS="$HOLDERS ${d##*/}:${comm:-?}($cls)"
    done
  done
fi

VERDICT="$(capture_verdict "$TOOLS_OK" "$NDEV" "$NMESH" "$NFOREIGN")"
HOLDERS="${HOLDERS# }"

emit_json() {
  printf '{"verdict":"%s","cam_inuse":%s,"mic_inuse":%s,"foreign":%s,"holders":"%s","devices_seen":%s,"tool":"%s","ts":"%s"}\n' \
    "$VERDICT" "$CAM_INUSE" "$MIC_INUSE" "$NFOREIGN" "${HOLDERS//\"/}" "$NDEV" "$TOOL" "$TS"
}

case "${1:-}" in
  --json) emit_json ;;
  --edge)
    PREV=""; [ -f "$EDGE_CACHE" ] && PREV="$(cat "$EDGE_CACHE" 2>/dev/null)"
    if [ "$VERDICT" != "$PREV" ]; then
      printf '%s\n' "$VERDICT" > "$EDGE_CACHE" 2>/dev/null || true
      echo "[capture-inuse] $VERDICT${HOLDERS:+ — $HOLDERS}"
    fi
    ;;
  *)
    if [ "$VERDICT" = UNKNOWN ]; then
      REASON="$([ "$TOOLS_OK" = 1 ] && echo "no capture devices on this node" || echo "no fuser/lsof — cannot read FD holders")"
      echo "[capture-inuse] UNKNOWN — cannot assess ($REASON); NOT a faked FREE"
    else
      echo "[capture-inuse] $VERDICT — cam_inuse=$CAM_INUSE mic_inuse=$MIC_INUSE foreign=$NFOREIGN${HOLDERS:+ · holders: $HOLDERS} · tool=$TOOL"
    fi
    ;;
esac

[ "$VERDICT" = UNKNOWN ] && exit 2 || exit 0
