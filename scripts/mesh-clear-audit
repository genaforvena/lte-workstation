#!/usr/bin/env bash
# mesh-clear-audit — the clear mind's reflex: after every 10 clears, CHECK THEM.
# (clear mind, 2026-07-18, per operator direction; LOSS-FIRST per chat-mind consult Opus 4.8 2026-07-18)
#
# A /clear is irreversible; it relies on the handoff carrying the thread. mesh-clear-log records
# every clear; mesh-clear-loss measures the serialization COST (recycled-vs-control fail-rate). Neither
# answers "are our clears healthy in batches?" — that's this reflex. It fires ONCE per completed 10-clear
# batch (event-counted on a cheap cron tick, NOT a fixed clock sweep: the audit is DUE only when the
# ledger CROSSES a 10-boundary — so a dry week audits nothing and a burst audits every crossed batch,
# no hollow green), then announces a one-line digest to mesh-chat and leaves the rollup where the clear
# dash already reads it (~/.mesh/.clear-audit-last, surfaced by mesh-clear-log --watch — NO second surface).
#
# LOSS-FIRST (the "meter-first" doctrine). The headline signal is mesh-clear-loss's measured cost: a
# /clear that DROPS a mid-turn discovery is the real failure mode, and coverage (already gated per-clear
# by mesh-clear's tiny-model gate) is only a proxy re-check, folded in SECONDARY for free. Anomaly flags
# — no-handoff / stale-handoff / blocked / forced / degenerate rows the ledger already carries — surface
# alongside at no extra cost. Verdict is CLEAN only when loss is tolerable AND coverage intact AND zero
# anomalies; everything else is FLAG. Finding a problem is a SUCCESS for an auditor (exit 0 regardless of
# verdict); exit non-zero means the AUDITOR ITSELF broke.
#
# EVENT-COUNTED DESIGN. State in ~/.mesh/.clear-audit.state SNAPS to completed 10-boundaries: leftover
# (<10) clears DEFER to the next boundary (faithful to "after each 10", not "after ~10"). A burst that
# crosses 2 boundaries at once → one digest covering both batches (BATCHES=N in the line). Idempotent:
# re-running with no newly-completed batch is a no-op ("not due" — no double post, no duplicate rollup).
#
#   mesh-clear-audit              audit the due batch(es) if a 10-boundary crossed since last run
#   mesh-clear-audit --force      audit the last ≤BATCH clears regardless of due-ness (state untouched)
#   mesh-clear-audit --status     print due-state + last audit summary (no work, no chat post)
#   mesh-clear-audit --test       RED-first: boundary math, batch aggregation, anomaly detection, loss
#                                 threshold, idempotency, --force-skips-state, --status-is-silent
# reflex-cadence: */5 * * * *
# orphan-ok: cron reflex; cheap (ledger line-count + state compare), real work only on a boundary cross.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
LEDGER="${MESH_CLEAR_LOG:-$MESH_DIR/clear-log.jsonl}"
STATE="$MESH_DIR/.clear-audit.state"
ROLLUP="$MESH_DIR/clear-audit.jsonl"
LAST="$MESH_DIR/.clear-audit-last"
LOG="$MESH_DIR/clear-audit.log"
POSTSIG="$MESH_DIR/.clear-audit-postsig"   # last verdict-signature posted to the board — the board-post gate reads it
BATCH="${MESH_CLEAR_AUDIT_BATCH:-10}"
LOSS_THRESHOLD="${MESH_CLEAR_AUDIT_LOSS_THRESH:-0.15}"   # measured cost (fail-rate Δ) at/above which → FLAG
MIN_N="${MESH_CLEAR_AUDIT_MIN_N:-8}"                      # min canary samples (N_ALL) for the cost to count as MEASURED
LOSS_FRESH="${MESH_CLEAR_AUDIT_LOSS_FRESH_SECS:-172800}"  # loss ledger LAST_TS older than this → stale/unauthoritative (0=off; 2d default = 1 missed daily canary of slack)
# reason/source substrings (lowercase) that mark an anomalous clear row.
ANOM_TOKENS="${MESH_CLEAR_AUDIT_ANOM:-no-handoff blocked forced degenerate stale uncovered unsure error fail}"
# override the loss meter for hermetic tests: MESH_CLEAR_AUDIT_LOSS_CMD='echo ...'
LOSS_CMD="${MESH_CLEAR_AUDIT_LOSS_CMD:-}"

_now(){ date -u +%FT%TZ; }

# ── total valid JSONL rows in the ledger (blank/garbage lines skipped, never over-counted) ──────────
_total(){
  [ -s "$LEDGER" ] || { printf 0; return; }
  python3 -c 'import json,sys
n=0
for l in open(sys.argv[1],encoding="utf-8"):
    l=l.strip()
    if not l: continue
    try: json.loads(l); n+=1
    except Exception: pass
print(n)' "$LEDGER"
}
_state(){ [ -r "$STATE" ] && cat "$STATE" 2>/dev/null || printf 0; }

# ── the loss meter: one-line cost report (the PRIMARY signal). Hermetic via MESH_CLEAR_AUDIT_LOSS_CMD ─
_loss_report(){
  if [ -n "$LOSS_CMD" ]; then eval "$LOSS_CMD" 2>/dev/null; return; fi
  command -v mesh-clear-loss >/dev/null 2>&1 || { echo "n/a (mesh-clear-loss absent)"; return; }
  local r; r="$(mesh-clear-loss --report 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g')"
  [ -n "$r" ] && printf '%s' "$r" || echo "n/a (no loss data yet)"
}

# ── the audit itself: rows [from,to) of the ledger → one-line digest on stdout + structured rollup ──
# Env consumed: MESH_LOSS, MESH_BATCH, MESH_THRESH, MESH_ANOM, MESH_REASON, MESH_ROLLUP, MESH_ISO.
_audit_span(){ # $1=from  $2=to
  MESH_LOSS="$(_loss_report)" MESH_BATCH="$BATCH" MESH_THRESH="$LOSS_THRESHOLD" MESH_MINN="$MIN_N" MESH_LOSS_FRESH="$LOSS_FRESH" \
  MESH_ANOM="$ANOM_TOKENS" MESH_REASON="${MESH_REASON:-due}" MESH_ROLLUP="$ROLLUP" MESH_ISO="$(_now)" \
  python3 -c '
import json,sys,os,re,time
from datetime import datetime,timezone
ledger=sys.argv[1]; frm=int(sys.argv[2]); to=int(sys.argv[3])
batch=int(os.environ["MESH_BATCH"]); thresh=float(os.environ["MESH_THRESH"])
minn=int(os.environ.get("MESH_MINN","8"))
loss_fresh=int(os.environ.get("MESH_LOSS_FRESH","172800"))   # loss ledger older than this (s) → stale (0=off)
tokens=[t for t in os.environ["MESH_ANOM"].split() if t]
loss=os.environ["MESH_LOSS"]; reason=os.environ["MESH_REASON"]; iso=os.environ["MESH_ISO"]
def _isosecs(t):
    return datetime.strptime(t,"%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
def loss_read(s):
    # Read of the loss meter, keyed on the MACHINE fields from mesh-clear-loss --report
    # (COST_ALL/N_ALL/LAST_TS), NOT the "first number in the flattened table" (that grabs a SAMPLE COUNT).
    #   'ok'     — measured, |cost| < thresh, enough samples, FRESH    → the ONLY state that permits CLEAN
    #   'high'   — measured, |cost| >= thresh                          → FLAG (real excess loss)
    #   'lown'   — measured but N_ALL < minn                           → FLAG (not authoritative yet)
    #   'stale'  — measured but LAST_TS older than loss_fresh          → FLAG (frozen ledger — dead canary cron;
    #              the twin of 'absent': an AGING snapshot must not read as live authoritative CLEAN forever.
    #              Fail-safe: LAST_TS missing/unparseable while a budget is set → stale, not a silent pass)
    #   'absent' — no COST_ALL field (meter never ran / no ledger)     → FLAG (UNMEASURED, never a hollow pass)
    s=s or ""
    m=re.search(r"COST_ALL=([-+]?\d*\.?\d+)", s)
    if not m: return ("absent",None,0)
    try: cost=float(m.group(1))
    except Exception: return ("absent",None,0)
    nm=re.search(r"N_ALL=(\d+)", s); nn=int(nm.group(1)) if nm else 0
    if nn<minn: return ("lown",cost,nn)
    if loss_fresh>0:
        tm=re.search(r"LAST_TS=(\S+)", s)
        try:
            if (not tm) or (_isosecs(iso)-_isosecs(tm.group(1)))>loss_fresh: return ("stale",cost,nn)
        except Exception: return ("stale",cost,nn)
    return (("high" if abs(cost)>=thresh else "ok"),cost,nn)
rows=[]
for l in open(ledger,encoding="utf-8"):
    l=l.strip()
    if not l: continue
    try: rows.append(json.loads(l))
    except Exception: pass
span=rows[frm:to]
n=len(span)
if n==0:
    line="clear-audit [%s] (%s, 0 batch·0 clears): loss=<%s> coverage=n/a anomalies=0 detail=- → CLEAN" % (iso,reason,loss)
    print(line); sys.exit(0)
cov=sum(1 for r in span if r.get("handoff_present") and r.get("handoff_fresh"))
anom=0; detail=[]
for r in span:
    blob=" ".join(str(r.get(k,"")) for k in ("reason","source","win")).lower()
    if not r.get("handoff_present"): anom+=1; detail.append("no-handoff"); continue
    if not r.get("handoff_fresh"): anom+=1; detail.append("stale-handoff"); continue
    for t in tokens:
        if t in blob: anom+=1; detail.append(t); break
covp=round(cov*100/n)
lstate,lcost,lnn=loss_read(loss)
lossgood=(lstate=="ok")                        # CLEAN requires a MEASURED, tolerable, adequately-sampled cost
loss_ok_json = True if lstate=="ok" else (False if lstate=="high" else None)  # None = unmeasured/low-n, not a pass
if lstate!="ok": detail.append("loss:"+lstate) # surface WHY the loss axis blocked CLEAN (absent/lown/high)
verdict="CLEAN" if (anom==0 and covp==100 and lossgood) else "FLAG"
batches=max(1,(n+batch-1)//batch)
detail_s=",".join(sorted(set(detail))) or "-"
line="clear-audit [%s] (%s, %d batch·%d clears): loss=<%s> coverage=%d%% anomalies=%d detail=%s → %s" % (
    iso,reason,batches,n,loss,covp,anom,detail_s,verdict)
# structured rollup row (the dash reads the one-liner via .clear-audit-last; this is the durable history).
try:
    with open(os.environ["MESH_ROLLUP"],"a") as f:
        f.write(json.dumps({"ts":int(time.time()),"iso":iso,"reason":reason,"batches":batches,
                            "clears":n,"coverage_pct":covp,"anomalies":anom,"detail":detail_s,
                            "loss":loss,"loss_ok":loss_ok_json,"loss_state":lstate,
                            "loss_cost":lcost,"loss_n":lnn,"verdict":verdict},ensure_ascii=False)+"\n")
except Exception: pass
print(line)
' "$LEDGER" "$1" "$2"
}

# ── run an audit over [from,to) and perform side effects (LOG, LAST, chat, state) ───────────────────
_emit(){ # $1=from  $2=to  $3=reason(due|forced)
  local from="$1" to="$2" reason="$3" line
  line="$(MESH_REASON="$reason" _audit_span "$from" "$to")"
  printf '%s\n' "$line" | tee -a "$LOG" >/dev/null
  printf '%s\n' "$line" > "$LAST"
  # announce — GATED so the board is not spammed once per due batch (clear-audit-board-every-batch).
  # The rollup ALWAYS lands in .clear-audit-last + the mesh-clear-log dash (header:11 "NO second surface");
  # the BOARD post is a rarer signal, fired only on a FLAG whose verdict-signature (verdict + anomaly
  # detail) CHANGED since the last posted digest — i.e. a NEW anomaly. A CLEAN batch posts nothing; two
  # consecutive identical-FLAG batches post once. A manual --force ALWAYS posts (an explicit ask) and
  # never persists the signature, so clear@'s fix-verification double-posts stay intact. A dead cron
  # never runs → never posts → still honest (the dash carries the rollup regardless).
  local verdict detail_s rest sig last_sig do_post=0
  verdict="${line##* }"                     # trailing token = CLEAN|FLAG
  rest="${line#*detail=}"; detail_s="${rest%% *}"   # detail_s is space-free (comma-joined set or '-')
  if [ "$verdict" = CLEAN ]; then sig=CLEAN; else
    # clear-audit-stale-handoff-flap-reposts (2026-07-22): the `stale-handoff` anomaly flaps on/off
    # cycle-to-cycle atop a persistent base (idle timer-clears age handoffs past 900s intermittently —
    # 2026-07-22 triage classified these BENIGN), so folding it into the board-post signature re-posted the
    # SAME non-actionable loss:lown FLAG every other due batch (~7-line block). Strip it from the SIGNATURE
    # only — it STAYS in the printed detail ($line/$detail_s, untouched). A real change (loss:lown→loss:high,
    # or a NEW no-handoff/blocked/degenerate row) still moves the sig and re-posts.
    local sig_detail; sig_detail="$(printf '%s' "$detail_s" | tr ',' '\n' | grep -vx 'stale-handoff' | paste -sd, -)"
    [ -z "$sig_detail" ] && sig_detail='-'
    sig="FLAG:$sig_detail"
  fi
  if [ "$reason" = forced ]; then
    do_post=1                               # manual --force: always announce, never touch the signature
  else
    last_sig="$(cat "$POSTSIG" 2>/dev/null || true)"
    [ "$verdict" = FLAG ] && [ "$sig" != "$last_sig" ] && do_post=1
    printf '%s' "$sig" > "$POSTSIG"         # due runs record the signature (CLEAN resets it → next FLAG re-posts)
  fi
  if [ "$do_post" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
    mesh-chat "[clear-audit] $line" >/dev/null 2>&1 || true
  fi
  # state snaps to the audited boundary ONLY on a due run; --force leaves state untouched.
  [ "$reason" = due ] && printf '%s' "$to" > "$STATE"
  printf '%s\n' "$line"
}

# ── main dispatch ──────────────────────────────────────────────────────────────────────────────────
_run(){
  local total last completed
  total="$(_total)"; last="$(_state)"
  completed=$(( (total / BATCH) * BATCH ))           # highest completed 10-boundary
  if [ "$completed" -le "$last" ]; then
    echo "mesh-clear-audit: not due ($total clears, last boundary audited at $last; need ${BATCH}-boundary cross)."
    return 0
  fi
  _emit "$last" "$completed" due
}

_force(){
  local total from
  total="$(_total)"
  [ "$total" -gt 0 ] || { echo "mesh-clear-audit --force: ledger empty — nothing to audit."; return 0; }
  from=$(( total > BATCH ? total - BATCH : 0 ))
  _emit "$from" "$total" forced
}

_status(){
  local total last completed
  total="$(_total)"; last="$(_state)"; completed=$(( (total / BATCH) * BATCH ))
  echo "mesh-clear-audit status:"
  echo "  ledger:    $total clears ($LEDGER)"
  echo "  batch:     every $BATCH clears"
  echo "  audited:   up to boundary $last"
  echo "  completed: boundary $completed → $([ "$completed" -gt "$last" ] && echo "DUE (${completed}-${last}=${total-$last} new, audited next run)" || echo "not due")"
  if [ -r "$LAST" ]; then echo "  last:      $(cat "$LAST")"; else echo "  last:      (none yet)"; fi
}

# ── TEST: RED-first. Hermetic — fixture ledger, stubbed loss meter, fake mesh-chat counter ──────────
_test(){
  local td rc=0
  td="$(mktemp -d)" || { echo "clear-audit-test: FAIL (mktemp)"; exit 1; }
  MESH_DIR="$td/m" LEDGER="$td/m/clear-log.jsonl" STATE="$td/m/.clear-audit.state" \
  ROLLUP="$td/m/clear-audit.jsonl" LAST="$td/m/.clear-audit-last" LOG="$td/m/clear-audit.log" \
  POSTSIG="$td/m/.clear-audit-postsig" \
  BATCH=10 LOSS_THRESHOLD=0.15
  mkdir -p "$td/m" "$td/bin"
  export MESH_DIR LEDGER STATE ROLLUP LAST LOG POSTSIG BATCH LOSS_THRESHOLD
  # fake mesh-chat: count posts (proves idempotency — no double-post) instead of touching the real board
  printf '#!/usr/bin/env bash\necho "$@" >> "%s/chat-calls"\n' "$td" > "$td/bin/mesh-chat"; chmod +x "$td/bin/mesh-chat"
  export PATH="$td/bin:$PATH"
  # stub the loss meter in the REAL --report shape: a flattened table PLUS the machine fields the audit
  # actually parses (COST_ALL=/N_ALL=). The leading numbers are sample counts — a correct reader ignores them.
  # a fresh LAST_TS ($(date) runs at eval-time → always current) so the stub reads as a LIVE meter, not stale.
  LOSS_CMD='echo "task n rec_fail ctl_fail COST budget 3 0.10 0.03 +0.07 ALL 12 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'
  export LOSS_CMD

  # fixture builder: N clean (present+fresh) clears
  _clean(){ python3 -c '
import json,sys
n=int(sys.argv[1]); rows=[]
for i in range(n):
    rows.append({"ts":1700000000+i,"iso":"2026-07-18T10:40:0%dZ"%i,"win":"w%d"%i,"reason":"interval 20m",
                 "pct":"?","tok":"?","source":"compact-reflex","engine":"opencode",
                 "handoff_present":True,"handoff_age_s":3,"handoff_source":"auto-snapshot","handoff_fresh":True})
open(sys.argv[2],"w").write("\n".join(json.dumps(r) for r in rows)+"\n")
' "$1" "$LEDGER"; }
  # N-row batch with exactly ONE no-handoff anomaly (detail=no-handoff) — a STABLE FLAG signature for the gate test
  _anom1(){ python3 -c '
import json,sys
n=int(sys.argv[1]); rows=[]
for i in range(n):
    ph = (i!=0)  # row 0 has no handoff → one no-handoff anomaly, verdict FLAG detail=no-handoff
    rows.append({"ts":1700000000+i,"iso":"2026-07-18T10:40:0%dZ"%i,"win":"w%d"%i,"reason":"interval 20m",
                 "pct":"?","tok":"?","source":"compact-reflex","engine":"opencode",
                 "handoff_present":ph,"handoff_age_s":(3 if ph else -1),
                 "handoff_source":("auto-snapshot" if ph else "none"),"handoff_fresh":ph})
open(sys.argv[2],"w").write("\n".join(json.dumps(r) for r in rows)+"\n")
' "$1" "$LEDGER"; }

  echo "-- 1) boundary math: 9 clears → NOT due (no boundary crossed), state stays 0, no rollup, no chat"
  _clean 9
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q 'not due' || { echo "clear-audit-test: FAIL (9 clears should be not-due)"; rc=1; }
  [ "$(cat "$STATE" 2>/dev/null || echo 0)" = "0" ] || { echo "clear-audit-test: FAIL (state moved on a not-due run)"; rc=1; }
  [ ! -s "$ROLLUP" ] || { echo "clear-audit-test: FAIL (rollup written on a not-due run)"; rc=1; }
  [ ! -f "$td/chat-calls" ] || { echo "clear-audit-test: FAIL (chat posted on a not-due run)"; rc=1; }

  echo "-- 2) 10 clears → DUE: audits rows[0:10], state snaps to 10, verdict CLEAN (loss 0.07 < 0.15),"
  echo "       rollup+LAST written, but NO board post (CLEAN is silent on the board — gate)"
  _clean 10
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ CLEAN' || { echo "clear-audit-test: FAIL (10 clean clears + tolerable loss should be CLEAN)"; rc=1; }
  echo "$out" | grep -q '1 batch·10 clears' || { echo "clear-audit-test: FAIL (batch/clears count wrong)"; rc=1; }
  [ "$(cat "$STATE")" = "10" ] || { echo "clear-audit-test: FAIL (state did not snap to 10: got $(cat "$STATE"))"; rc=1; }
  [ "$(wc -l < "$ROLLUP")" = "1" ] || { echo "clear-audit-test: FAIL (rollup row count: $(wc -l < "$ROLLUP"))"; rc=1; }
  [ ! -f "$td/chat-calls" ] || { echo "clear-audit-test: FAIL (CLEAN batch must NOT post to the board — gate)"; rc=1; }
  [ -s "$LAST" ] || { echo "clear-audit-test: FAIL (.clear-audit-last not written)"; rc=1; }

  echo "-- 3) idempotency: re-run with no new boundary → not due, NO new rollup row, NO chat post"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q 'not due' || { echo "clear-audit-test: FAIL (re-run should be not-due)"; rc=1; }
  [ "$(wc -l < "$ROLLUP")" = "1" ] || { echo "clear-audit-test: FAIL (idempotency broken: rollup grew)"; rc=1; }
  [ ! -f "$td/chat-calls" ] || { echo "clear-audit-test: FAIL (idempotency broken: chat posted)"; rc=1; }

  echo "-- 4) 20 clears → DUE again: audits rows[10:20], state → 20"
  _clean 20
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '1 batch·10 clears' || { echo "clear-audit-test: FAIL (2nd batch should be 10)"; rc=1; }
  [ "$(cat "$STATE")" = "20" ] || { echo "clear-audit-test: FAIL (state did not advance to 20)"; rc=1; }

  echo "-- 5) ANOMALY detection: a batch with no-handoff + stale + blocked → FLAG, anomalies=3, details listed"
  python3 - "$LEDGER" <<'PY'
import json,sys
rows=[
 {"ts":1,"iso":"t1","win":"a","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":False,"handoff_age_s":-1,"handoff_source":"none","handoff_fresh":False},
 {"ts":2,"iso":"t2","win":"b","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":9999,"handoff_source":"auto-snapshot","handoff_fresh":False},
 {"ts":3,"iso":"t3","win":"c","reason":"BLOCKED by gate","source":"mesh-clear","engine":"opencode","handoff_present":True,"handoff_age_s":2,"handoff_source":"manual","handoff_fresh":True},
 {"ts":4,"iso":"t4","win":"d","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
 {"ts":5,"iso":"t5","win":"e","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
 {"ts":6,"iso":"t6","win":"f","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
 {"ts":7,"iso":"t7","win":"g","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
 {"ts":8,"iso":"t8","win":"h","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
 {"ts":9,"iso":"t9","win":"i","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
 {"ts":10,"iso":"t10","win":"j","reason":"interval","source":"compact-reflex","engine":"opencode","handoff_present":True,"handoff_age_s":1,"handoff_source":"auto-snapshot","handoff_fresh":True},
]
open(sys.argv[1],"w").write("\n".join(json.dumps(r) for r in rows)+"\n")
PY
  # reset state to 0 so the 10-row ledger is a fresh due batch
  printf 0 > "$STATE"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (anomalous batch should FLAG)"; rc=1; }
  echo "$out" | grep -q 'anomalies=3' || { echo "clear-audit-test: FAIL (expected 3 anomalies, got: $out)"; rc=1; }
  echo "$out" | grep -q 'no-handoff' || { echo "clear-audit-test: FAIL (no-handoff not in detail)"; rc=1; }
  echo "$out" | grep -q 'stale-handoff' || { echo "clear-audit-test: FAIL (stale-handoff not in detail)"; rc=1; }
  echo "$out" | grep -q 'blocked' || { echo "clear-audit-test: FAIL (blocked token not flagged)"; rc=1; }

  echo "-- 6) LOSS threshold drives verdict: COST_ALL=+0.40 (≥0.15) → FLAG even with clean coverage"
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.45 0.05 +0.40 COST_ALL=+0.40 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (excessive loss should FLAG)"; rc=1; }
  echo "$out" | grep -q 'COST_ALL=+0.40' || { echo "clear-audit-test: FAIL (loss line not surfaced)"; rc=1; }
  echo "$out" | grep -q 'loss:high' || { echo "clear-audit-test: FAIL (excessive-loss state not marked in detail)"; rc=1; }

  echo "-- 6a) [BUG-A GUARD] REAL --report table format: a 'first number' parser reads the sample count (3) → false FLAG;"
  echo "       the correct reader takes COST_ALL=+0.08 (<0.15) → CLEAN with clean coverage/anomalies."
  LOSS_CMD='echo "task n rec_fail ctl_fail COST budget 3 0.33 0.33 +0.00 naming 3 0.33 0.00 +0.33 ALL 12 0.17 0.08 +0.08 COST_ALL=+0.08 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ CLEAN' || { echo "clear-audit-test: FAIL (BUG-A: audit misread the flattened table's leading count instead of COST_ALL — should be CLEAN)"; rc=1; }

  echo "-- 6b) [BUG-B GUARD] METER ABSENT (no COST_ALL field): clean coverage/anomalies must NOT be CLEAN (hollow green);"
  echo "       verdict FLAG with detail loss:absent, and rollup loss_ok=null."
  LOSS_CMD='echo "mesh-clear-loss: no ledger yet (/tmp/nope/clear-loss.log)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"; : > "$ROLLUP"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (BUG-B: unmeasured loss must NOT pass as CLEAN)"; rc=1; }
  echo "$out" | grep -q 'loss:absent' || { echo "clear-audit-test: FAIL (BUG-B: meter-absent not marked in detail)"; rc=1; }
  grep -q '"loss_ok": null' "$ROLLUP" || { echo "clear-audit-test: FAIL (BUG-B: rollup loss_ok should be null when unmeasured)"; rc=1; }

  echo "-- 6c) [BUG-D GUARD] LOW-N: measured & tolerable cost but N_ALL<MIN_N is NOT authoritative → FLAG (loss:lown)"
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 1 0.00 0.00 +0.02 COST_ALL=+0.02 N_ALL=1 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (BUG-D: n=1 cost must not count as authoritative CLEAN)"; rc=1; }
  echo "$out" | grep -q 'loss:lown' || { echo "clear-audit-test: FAIL (BUG-D: low-n not marked in detail)"; rc=1; }
  echo "-- 6d) [STALE GUARD] FROZEN LEDGER: measured & tolerable & well-sampled, but LAST_TS aged past the"
  echo "       freshness budget (dead canary cron) → NOT authoritative → FLAG (loss:stale). Twin of meter-absent."
  # a clearly-old LAST_TS (fixed, always stale) with an otherwise-CLEAN report → must FLAG, not read as live.
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=12 LAST_TS=2000-01-01T00:00:00Z"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"; : > "$ROLLUP"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (STALE: a frozen loss ledger must NOT pass as authoritative CLEAN)"; rc=1; }
  echo "$out" | grep -q 'loss:stale' || { echo "clear-audit-test: FAIL (STALE: frozen ledger not marked loss:stale in detail)"; rc=1; }
  grep -q '"loss_ok": null' "$ROLLUP" || { echo "clear-audit-test: FAIL (STALE: rollup loss_ok should be null when stale/unauthoritative)"; rc=1; }
  # 6d-b: a FRESH LAST_TS with the same numbers → back to CLEAN (staleness gate is not always-on).
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"
  out="$(_run)"; echo "$out"
  echo "$out" | grep -q '→ CLEAN' || { echo "clear-audit-test: FAIL (STALE: a FRESH ledger with tolerable cost must read CLEAN — gate over-blocks)"; rc=1; }
  # restore the tolerable, FRESH measured stub for any later tests
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD

  echo "-- 7) --force audits last ≤BATCH regardless of due-ness AND leaves state untouched"
  _clean 25; printf 20 > "$STATE"     # state at 20; completed boundary = 20 → NOT due
  out="$(_force)"; echo "$out"
  echo "$out" | grep -q 'forced' || { echo "clear-audit-test: FAIL (--force line should say forced)"; rc=1; }
  echo "$out" | grep -q '10 clears' || { echo "clear-audit-test: FAIL (--force should audit last 10)"; rc=1; }
  [ "$(cat "$STATE")" = "20" ] || { echo "clear-audit-test: FAIL (--force must not move state: got $(cat "$STATE"))"; rc=1; }

  echo "-- 8) --status is silent on the board (no chat post) and reports due-state"
  calls_before="$(wc -l < "$td/chat-calls")"
  out="$(_status)"; echo "$out"
  echo "$out" | grep -q 'mesh-clear-audit status' || { echo "clear-audit-test: FAIL (--status output)"; rc=1; }
  [ "$(wc -l < "$td/chat-calls")" = "$calls_before" ] || { echo "clear-audit-test: FAIL (--status posted to chat)"; rc=1; }

  echo "-- 9) BOARD-POST GATE (clear-audit-board-every-batch): CLEAN silent · first-FLAG posts · identical"
  echo "      repeat-FLAG dedups · NEW-anomaly FLAG re-posts · --force always posts + never touches the sig."
  echo "      RED-first: the ungated tool posted on EVERY due batch (the ~7-posts/hr board spam)."
  rm -f "$td/chat-calls" "$POSTSIG"
  _cc(){ [ -f "$td/chat-calls" ] && wc -l < "$td/chat-calls" || echo 0; }
  # 9a) CLEAN batch → no board post (rollup/LAST still land; dash carries it — "NO second surface")
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q '→ CLEAN' || { echo "clear-audit-test: FAIL (9a: expected CLEAN)"; rc=1; }
  [ "$(_cc)" = 0 ] || { echo "clear-audit-test: FAIL (9a: CLEAN must be silent on the board, posted $(_cc))"; rc=1; }
  # 9b) first FLAG (detail=no-handoff) → posts exactly once
  _anom1 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (9b: expected FLAG)"; rc=1; }
  echo "$out" | grep -q 'no-handoff' || { echo "clear-audit-test: FAIL (9b: expected no-handoff detail)"; rc=1; }
  [ "$(_cc)" = 1 ] || { echo "clear-audit-test: FAIL (9b: first FLAG must post once, got $(_cc))"; rc=1; }
  # 9c) IDENTICAL FLAG (same detail=no-handoff) next batch → NO new post (the anti-spam dedup)
  _anom1 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (9c: expected FLAG)"; rc=1; }
  [ "$(_cc)" = 1 ] || { echo "clear-audit-test: FAIL (9c: identical repeat-FLAG must NOT re-post, got $(_cc))"; rc=1; }
  # 9d) NEW anomaly signature (loss:high, clean coverage) → re-posts (a genuinely different problem)
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.45 0.05 +0.40 COST_ALL=+0.40 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (9d: expected FLAG)"; rc=1; }
  [ "$(_cc)" = 2 ] || { echo "clear-audit-test: FAIL (9d: a NEW anomaly signature must re-post, got $(_cc))"; rc=1; }
  # 9e) --force ALWAYS posts (even a CLEAN batch — an explicit ask) and leaves the signature untouched,
  #     so clear@'s manual fix-verification double-posts are never suppressed by the gate.
  sig_before="$(cat "$POSTSIG" 2>/dev/null || true)"
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 12 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=12 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  _clean 10; out="$(_force)"
  echo "$out" | grep -q '→ CLEAN' || { echo "clear-audit-test: FAIL (9e: forced CLEAN expected)"; rc=1; }
  [ "$(_cc)" = 3 ] || { echo "clear-audit-test: FAIL (9e: --force must always post, even CLEAN, got $(_cc))"; rc=1; }
  [ "$(cat "$POSTSIG" 2>/dev/null || true)" = "$sig_before" ] || { echo "clear-audit-test: FAIL (9e: --force must not touch the signature)"; rc=1; }
  # 9f) STALE-HANDOFF FLAP (clear-audit-stale-handoff-flap-reposts): the benign `stale-handoff` anomaly
  #     flaps on/off cycle-to-cycle atop a PERSISTENT loss:lown base; folding it into the post signature
  #     re-posted the same non-actionable FLAG every other due batch. It must be stripped from the SIGNATURE
  #     (but kept in the printed detail): loss:lown,stale-handoff and loss:lown dedupe to ONE post, while a
  #     genuinely NEW anomaly (no-handoff) still re-posts. RED-first: pre-fix the two sigs differed → 2 posts.
  rm -f "$td/chat-calls" "$POSTSIG"
  # persistent base: loss meter at low-n (N_ALL=3 < MIN_N 8) → loss:lown across all three batches
  LOSS_CMD='echo "task n rec_fail ctl_fail COST ALL 3 0.10 0.03 +0.07 COST_ALL=+0.07 N_ALL=3 LAST_TS=$(date -u +%FT%TZ)"'; export LOSS_CMD
  # builder: N rows, row 0 handoff PRESENT but NOT fresh → exactly one stale-handoff anomaly
  _stale1(){ python3 -c '
import json,sys
n=int(sys.argv[1]); rows=[]
for i in range(n):
    st=(i!=0)  # row 0: handoff present but stale (fresh=False) → stale-handoff anomaly
    rows.append({"ts":1700000000+i,"iso":"2026-07-18T10:40:0%dZ"%i,"win":"w%d"%i,"reason":"interval 20m",
                 "pct":"?","tok":"?","source":"compact-reflex","engine":"opencode",
                 "handoff_present":True,"handoff_age_s":(3 if st else 999),
                 "handoff_source":"auto-snapshot","handoff_fresh":st})
open(sys.argv[2],"w").write("\n".join(json.dumps(r) for r in rows)+"\n")
' "$1" "$LEDGER"; }
  # batch A: loss:lown + stale-handoff → FLAG detail "loss:lown,stale-handoff" → first post
  _stale1 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q 'stale-handoff' || { echo "clear-audit-test: FAIL (9f: batch A expected stale-handoff in detail)"; rc=1; }
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (9f: batch A expected FLAG)"; rc=1; }
  [ "$(_cc)" = 1 ] || { echo "clear-audit-test: FAIL (9f: batch A first FLAG must post once, got $(_cc))"; rc=1; }
  # batch B: loss:lown, NO stale-handoff (all fresh) → detail "loss:lown" → SAME sig after strip → NO re-post
  _clean 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q '→ FLAG' || { echo "clear-audit-test: FAIL (9f: batch B expected FLAG (loss:lown base))"; rc=1; }
  [ "$(_cc)" = 1 ] || { echo "clear-audit-test: FAIL (9f: stale-handoff flap must NOT re-post — signature must exclude it, got $(_cc))"; rc=1; }
  # batch C: a genuinely NEW anomaly (no-handoff) atop loss:lown → sig changes → DOES re-post
  _anom1 10; printf 0 > "$STATE"; out="$(_run)"
  echo "$out" | grep -q 'no-handoff' || { echo "clear-audit-test: FAIL (9f: batch C expected no-handoff)"; rc=1; }
  [ "$(_cc)" = 2 ] || { echo "clear-audit-test: FAIL (9f: a NEW no-handoff anomaly must re-post despite the stale-handoff strip, got $(_cc))"; rc=1; }

  rm -rf "$td"
  [ "$rc" = 0 ] && echo "clear-audit-test: ok (boundary math 9-not-due/10-due/20-due; idempotent no double-post; anomaly detect no-handoff+stale+blocked→FLAG; loss threshold 0.40→FLAG; BUG-A COST_ALL-not-leading-count→CLEAN; BUG-B meter-absent→FLAG+loss_ok:null; BUG-D low-n→FLAG; STALE frozen-ledger→FLAG+loss_ok:null / fresh→CLEAN; --force audits last 10 w/o state move; --status silent; GATE CLEAN-silent/first-FLAG-posts/repeat-FLAG-dedup/new-anomaly-reposts/--force-always+sig-untouched)"
  return "$rc"
}

# ── arg parse ──────────────────────────────────────────────────────────────────────────────────────
case "${1:-}" in
  --force)  _force ;;
  --status) _status ;;
  --test)   _test ;;
  -h|--help) sed -n '2,30p' "$0" | sed -n 's/^# \?//p' ;;
  "")       _run ;;
  *) echo "mesh-clear-audit: unknown arg '$1' (try --status / --force / --test)" >&2; exit 2 ;;
esac
