#!/usr/bin/env bash
# mesh-heavy-run — the ONE admission-controlled entry point for a MEMORY-HEAVY job.
#
#   mesh-heavy-run <budget-mb> -- <cmd> [args...]     # run <cmd> niced + serialized + admission-gated
#   mesh-heavy-run --test
#
# WHY (chat-review/heavy-job-admission, 2026-07-05): mesh-whisper-run solved ONE heavy binary
# (whisper.cpp) but the CLASS stayed unguarded — mesh-room-music's grainneukeln venv python runs
# UNNICED with no admission check, and a 02:04Z run OOM-killed a 2.5GB-RSS python while the 20:05Z
# batch-kill took ~8 procs. The fix belongs at the heavy-CALL-SITE class, not per-tool: this shim
#   (a) renices to 19 + ionice idle (same as whisper-run),
#   (b) holds a SHARED flock so heavy jobs serialize instead of stacking RAM, and
#   (c) PRE-FLIGHT gates admission: the declared budget must fit in MemAvailable+SwapFree AND the node
#       must not already be under resource-guard NODE-PRESSURE. If it can't be admitted it DEFERS
#       (polls) then REFUSES with EX_TEMPFAIL (75) — the caller decides to skip or retry — rather than
#       launching into a swap-exhaustion OOM.
# The NODE-PRESSURE verdict is REUSED from mesh-resource-guard (its --status prints "NODE-PRESSURE:"
# when hot) — the classifier/thresholds are NOT forked here, only consulted.
#
# reflex-cadence: none  # a call-site shim, invoked by heavy jobs — never scheduled
# orphan-ok: wrapper invoked by heavy consumers (room-music/grainneukeln/whisper), not a cron reflex.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
LOCK="${MESH_HEAVY_LOCK:-$MESH/.heavy.lock}"
NICE="${MESH_HEAVY_NICE:-19}"
LOCK_WAIT="${MESH_HEAVY_LOCK_WAIT:-300}"     # sec to wait for the serialization slot, then degrade (still niced)
ADMIT_WAIT="${MESH_HEAVY_ADMIT_WAIT:-120}"   # sec to poll for admission (mem/pressure) before refusing
ADMIT_STEP="${MESH_HEAVY_ADMIT_STEP:-5}"     # poll interval while deferring
FORCE="${MESH_HEAVY_FORCE:-0}"               # 1 = bypass the admission gate (still niced + serialized)
MEMINFO="${MESH_HEAVY_MEMINFO:-/proc/meminfo}"
# read-only node-pressure probe; overridable so --test can inject a hot/clear verdict without real load
NODEPRESSURE_CMD="${MESH_HEAVY_NODEPRESSURE_CMD:-mesh-resource-guard --status}"

EX_USAGE=64; EX_TEMPFAIL=75

# CRON IS BLIND TO THE USER MANAGER (2026-07-20): a cron/systemd-timer environment carries no
# XDG_RUNTIME_DIR / DBUS_SESSION_BUS_ADDRESS, so every `systemd-run --user` below fails to LAUNCH
# there — capcheck reads that as "no binding ceiling" and the run path silently takes the
# `ulimit -v` fallback. That fallback caps ADDRESS SPACE, not RSS: the grainneukeln grind python
# maps >2.5GB virtual at ~1.3GB RSS and died at IMPORT ("failed to map segment from shared
# object", rc=1) on every cron tick since heavy-run was wired (07-19), while the identical manual
# invocation (env present) ground fine — mesh-sound-reflex then verdicted ~40 healthy note3
# records skip:hollow. Same-command-two-environments, the `ssh command -v manufactures ABSENT`
# family. Linger keeps /run/user/<uid> alive on mind nodes, so the manager IS reachable from cron
# — it just needs the address. Default both vars to the standard per-UID paths when unset and the
# artifact actually exists (dir / bus socket); a node genuinely without a user manager still falls
# back exactly as before.
[ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ] \
  && export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

# MemAvailable + SwapFree in MB from MEMINFO (the total headroom a heavy job can draw on).
read_headroom_mb() {
  awk '/^MemAvailable:/{a=$2} /^SwapFree:/{s=$2} END{printf "%d", int((a+s)/1024)}' "$MEMINFO" 2>/dev/null
}
# true (0) when the node is NOT under resource-guard NODE-PRESSURE *and not on a dragon-king precursor
# ramp* (NODE-ACCELERATING). A probe that errors/empties is treated as CLEAR (fail-open on the pressure
# axis) — the budget gate below is the hard floor, and a missing resource-guard must not wedge every
# heavy job forever. Deferring on the ACCELERATING precursor is the dragon-king prediction→suppression:
# hold the heavy job back on the super-exponential ramp, not only once the level cliff is reached.
node_clear() {
  local out
  out="$($NODEPRESSURE_CMD 2>/dev/null)" || out=""
  printf '%s\n' "$out" | grep -qE '^NODE-(PRESSURE|ACCELERATING):' && return 1
  return 0
}
# admitted when the declared budget fits headroom AND the node is not already pressured
admit_ok() { # $1 = budget MB
  local head; head="$(read_headroom_mb)"; head="${head:-0}"
  [ "$head" -ge "$1" ] 2>/dev/null || return 1
  node_clear || return 1
  return 0
}
# defer-poll admission then refuse; returns 0 admitted / EX_TEMPFAIL refused. Shared by the exec path
# AND the `--admit` pre-flight mode, so the memory/pressure decision has ONE source of truth. A heavy
# caller that keeps its OWN serialization lock (e.g. mesh-whisper-run's whisper-vs-whisper flock)
# delegates ONLY this gate — the two flocks never compound, only the mem/pressure verdict is shared.
admit_gate() { # $1 = budget MB
  [ "$FORCE" = 1 ] && return 0
  local waited=0
  until admit_ok "$1"; do
    if [ "$waited" -ge "$ADMIT_WAIT" ]; then
      echo "mesh-heavy-run: REFUSED — node cannot admit ${1}MB (headroom $(read_headroom_mb)MB / pressure) after ${ADMIT_WAIT}s; caller should skip or retry" >&2
      return "$EX_TEMPFAIL"
    fi
    sleep "$ADMIT_STEP"; waited=$((waited + ADMIT_STEP))
  done
  return 0
}

nice_prefix() {
  PRE=()
  command -v nice   >/dev/null 2>&1 && PRE+=(nice -n "$NICE")
  command -v ionice >/dev/null 2>&1 && PRE+=(ionice -c3)
}

# true when a real per-job memory CEILING actually BINDS here — not merely that a scope launches.
# The trap this fixes (a1274ab reverted 648ceb0): the old probe ran `true` under MemoryMax=64M and
# read a clean launch as "cgroup available". But `true` allocates nothing, so a launch proves only
# that systemd-run reached the --user manager — NOT that the memory controller is delegated and the
# ceiling constrains RSS. Where the controller is undelegated (fitness's runner) the scope launches,
# the ceiling is a no-op, and `--capcheck` said "available" → --test drove the cgroup assertion → the
# over-budget alloc FINISHED uncapped → rc=1 → fitness auto-reverted the whole fix. Launch ≠ bind (the
# 'cap that does not cap' trap, same family as whisper's [ -x ] ≠ loadable). So PROBE THE BIND: run a
# real over-alloc PAST a tiny ceiling in a throwaway --collect scope and require the ceiling to KILL
# it. Survives → the ceiling is not binding here → report unavailable so the run path falls back to
# ulimit + a LOUD why, rather than running a job it only BELIEVES is capped. Prefer python3 (one
# process = one unambiguous OOM victim); absent it, require the memory controller delegated to our
# user slice AND the scope to launch (structural bind evidence, still stronger than a bare launch).
# ---- the probe SIGNS its own kills, and runs at most once per boot --------------------------
# A binding-ceiling probe is a DESTRUCTIVE measurement: proving the cap binds means getting killed
# by it, so every capcheck mints a real kernel OOM line. mem_cap_available is called on EVERY heavy
# run (line ~313) by seven tools, which measured out at 115 `Memory cgroup out of memory: Killed
# process N (python3)` lines in one boot, ~50/hour (health 2026-08-22). That poisons the channel its
# own readers use: a health probe MINTING the exact kernel line a real OOM emits.
#
# Two independent narrowings, because either alone leaves the fault:
#
#  (1) IDENTITY, not shape. Downstream had been guessing which OOM lines were ours by the VICTIM'S
#      RSS BAND (mesh-hw-fault-watch's BENIGN_RE — three bands, widened three times: 32M, 64M,
#      2.5G), which is a proxy: a real python OOM landing in a band renders silent, and a real
#      python cgroup OOM was being dropped outright by mesh-journal-watch's `(python*` clause. The
#      kernel already prints an identity we CONTROL — comm, in `Killed process N (<comm>)`, and
#      task=/oom_memcg= on the companion `oom-kill:` line. So the allocator runs through a symlink
#      named `mesh-capcheck` and the scope is named after it too. comm truncates at 15 bytes
#      (journal-comm-field-is-truncated-to-15-bytes); this is 13. Now the minter signs its own
#      kills and no reader has to guess. If the symlink cannot be made, the probe still runs
#      (unsigned, python3) — a probe that refuses to answer is worse than a noisy one.
#
#  (2) RATE. The property probed — is the memory controller delegated to this user manager and does
#      MemoryMax actually bind — is structural, not per-call: it changes at boot or when delegation
#      changes, never between two heavy jobs a minute apart. So a POSITIVE verdict is cached against
#      a fingerprint of exactly those two things (boot_id + the user slice's cgroup.controllers) and
#      re-probed when either moves. 115 kills/boot -> 1.
#      ONLY the positive is cached, and that is not a convenience: the survived / launch-failure
#      paths mint NO kernel line at all (nothing was killed), so caching them would buy no quiet
#      while risking a transient bus failure freezing every later heavy job onto the ulimit
#      fallback for a whole boot. Cache what is expensive to observe, never what is cheap.
CAPCACHE="${MESH_HEAVY_CAPCACHE:-$MESH/.heavy-run-capcheck}"
CAPPROBE_COMM=mesh-capcheck   # <=15 bytes — the kernel's comm field truncates there

# what the cached verdict is ABOUT. Not a clock: a TTL would serve a refuted verdict for its window
# and re-probe for nothing when nothing moved.
cap_fingerprint() {
  local _bid _ctl
  _bid="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"; _bid="${_bid:-unknown}"
  _ctl="$(cat "/sys/fs/cgroup/user.slice/user-$(id -u 2>/dev/null).slice/cgroup.controllers" 2>/dev/null)"
  printf '%s|%s' "$_bid" "${_ctl:-none}"
}

mem_cap_available() {
  command -v systemd-run >/dev/null 2>&1 || return 1
  local _fp; _fp="$(cap_fingerprint)"
  if [ "${MESH_HEAVY_CAPCACHE_OFF:-0}" != 1 ] && [ -r "$CAPCACHE" ]; then
    # a hit is only ever "binds": see (2) above
    [ "$(cat "$CAPCACHE" 2>/dev/null)" = "binds $_fp" ] && return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    local _o _rc _pd _bin
    _bin="$(command -v python3)"
    # sign the kill: a symlink whose NAME becomes the victim's comm in the kernel's own line
    _pd="$(mktemp -d 2>/dev/null)" &&
      ln -s "$_bin" "$_pd/$CAPPROBE_COMM" 2>/dev/null &&
      _bin="$_pd/$CAPPROBE_COMM"
    _o="$(systemd-run --user --scope -q --collect --unit="$CAPPROBE_COMM-$$" \
          -p MemoryMax=32M -p MemorySwapMax=0M -- \
          "$_bin" -c 'a=bytearray(128*1024*1024); print("ALIVE",len(a))' 2>/dev/null)"; _rc=$?
    [ -n "${_pd:-}" ] && rm -rf "$_pd"
    # Three outcomes, and empty stdout is AMBIGUOUS between two of them: (a) the alloc printed ALIVE →
    # survived → ceiling did NOT bind; (b) the alloc was OOM-killed → scope exits 128+SIGKILL(9)=137 →
    # ceiling BINDS; (c) systemd-run failed to LAUNCH (no user bus / broken) → empty stdout too, but a
    # non-signal rc (<128) → NOT a working ceiling. So require a real signal-kill rc, never bare-empty.
    case "$_o" in *ALIVE*) return 1 ;; esac      # survived → not capping (mints no kernel line)
    if [ "${_rc:-0}" -ge 128 ]; then             # killed by a signal (cgroup-OOM = 137) → ceiling binds
      mkdir -p "$(dirname "$CAPCACHE")" 2>/dev/null
      printf 'binds %s\n' "$_fp" > "$CAPCACHE.tmp$$" 2>/dev/null &&
        mv -f "$CAPCACHE.tmp$$" "$CAPCACHE" 2>/dev/null
      return 0
    fi
    return 1                                      # launch failure / non-kill exit → no binding ceiling
  fi
  local _cg="/sys/fs/cgroup/user.slice/user-$(id -u 2>/dev/null).slice/cgroup.controllers"
  grep -qw memory "$_cg" 2>/dev/null && \
    systemd-run --user --scope -q --collect -p MemoryMax=32M -- true >/dev/null 2>&1
}

# --capcheck: exit 0 iff a real cgroup memory ceiling actually binds here. --test uses it to choose the
# cgroup vs ulimit-fallback assertions; a caller may use it to decide whether to trust the cap.
[ "${1:-}" = --capcheck ] && { mem_cap_available; exit $?; }

# --admit <budget-mb>: run ONLY the admission gate (defer-poll then refuse), no serialization/exec.
# For heavy callers that keep their OWN serialization lock but delegate the memory/pressure decision
# to this single source of truth (mesh-whisper-run's whisper-gate fold, chat-review/whisper-run-fold-heavy-gate).
if [ "${1:-}" = --admit ]; then
  b="${2:-}"
  case "$b" in ''|*[!0-9]*) echo "usage: mesh-heavy-run --admit <budget-mb>" >&2; exit "$EX_USAGE";; esac
  admit_gate "$b"; exit $?
fi

if [ "${1:-}" = --test ]; then
  command -v flock >/dev/null 2>&1 || { echo "smoke-test: FAIL (flock missing — serialization impossible)"; exit 1; }
  command -v nice  >/dev/null 2>&1 || { echo "smoke-test: FAIL (nice missing — cannot renice)"; exit 1; }
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _lk="$_td/lock"
  _ample="$_td/mem-ample"; _tight="$_td/mem-tight"
  printf 'MemTotal: 8388608 kB\nMemAvailable: 6000000 kB\nSwapTotal: 4194304 kB\nSwapFree: 4000000 kB\n' > "$_ample"  # ~9.7GB headroom
  printf 'MemTotal: 8388608 kB\nMemAvailable: 200000 kB\nSwapTotal: 4194304 kB\nSwapFree: 100000 kB\n'  > "$_tight"   # ~293MB headroom
  _clear='printf node:\040avail\040OK\n'      # node_clear → CLEAR
  _hot='printf NODE-PRESSURE:\040swap\040low\n' # node_clear → HOT
  _accel='printf NODE-ACCELERATING:\040ramp\n'  # node_clear → HOT (dragon-king precursor)
  _base="MESH_HEAVY_LOCK=$_lk MESH_HEAVY_ADMIT_WAIT=1 MESH_HEAVY_ADMIT_STEP=1"

  # 1) ARG VALIDATION: a missing '--' separator or a non-integer budget is EX_USAGE (64), never a silent run.
  env $_base MESH_HEAVY_FORCE=1 "$0" 2000 echo hi >/dev/null 2>&1; [ "$?" = "$EX_USAGE" ] \
    || { echo "smoke-test: FAIL (missing -- separator must be EX_USAGE 64)"; exit 1; }
  env $_base MESH_HEAVY_FORCE=1 "$0" notanumber -- echo hi >/dev/null 2>&1; [ "$?" = "$EX_USAGE" ] \
    || { echo "smoke-test: FAIL (non-integer budget must be EX_USAGE 64)"; exit 1; }

  # 2) PASSTHROUGH: forwards args + returns the command's own exit code (gate forced open, mem ample).
  _out="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 500 -- printf 'tok-%s' 42 2>/dev/null)"
  [ "$_out" = "tok-42" ] || { echo "smoke-test: FAIL (arg passthrough — expected 'tok-42', got '$_out')"; exit 1; }
  env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 500 -- sh -c 'exit 7' >/dev/null 2>&1
  [ "$?" = 7 ] || { echo "smoke-test: FAIL (command exit code not propagated — expected 7)"; exit 1; }

  # 2b) STDERR PASSTHROUGH: the command's stderr must not be swallowed by the lock/gate plumbing.
  # Containment, not equality: where no cgroup ceiling binds the run site legitimately PREPENDS a loud
  # one-line fallback WHY to stderr (a silent weak cap is worse), so assert the command's own stderr is
  # PRESENT, not that it is the sole line.
  _err="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 500 -- sh -c 'printf on-stderr >&2' 2>&1 >/dev/null)"
  case "$_err" in *on-stderr*) : ;; *) echo "smoke-test: FAIL (command STDERR swallowed — expected to contain 'on-stderr', got '$_err')"; exit 1;; esac

  # 3) BUDGET GATE — REFUSE: budget 2000MB > 293MB tight headroom, node clear → EX_TEMPFAIL (75), no run.
  _marker="$_td/ran"; rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_tight" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" 2000 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = "$EX_TEMPFAIL" ] && [ ! -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (over-budget must refuse EX_TEMPFAIL 75 and NOT run the command)"; exit 1; }

  # 3b) BUDGET GATE — ADMIT: budget 2000MB <= 9.7GB ample headroom, node clear → runs.
  rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" 2000 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = 0 ] && [ -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (within-budget + clear node must admit and run)"; exit 1; }

  # 4) NODE-PRESSURE GATE (reused resource-guard verdict): ample mem BUT node hot → refuse, don't run.
  rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_hot" "$0" 500 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = "$EX_TEMPFAIL" ] && [ ! -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (NODE-PRESSURE hot must refuse even with ample budget headroom)"; exit 1; }

  # 4a) NODE-ACCELERATING GATE (dragon-king precursor): ample mem, NOT level-pressured, but on a
  # super-exponential ramp → defer the heavy job on the ramp, not at the cliff. Refuse, don't run.
  rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_accel" "$0" 500 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = "$EX_TEMPFAIL" ] && [ ! -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (NODE-ACCELERATING precursor must defer the heavy job even with ample headroom)"; exit 1; }

  # 4b) FORCE bypasses BOTH gates: tight mem + hot node, but FORCE=1 → runs anyway (still niced).
  rm -f "$_marker"
  env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_tight" MESH_HEAVY_NODEPRESSURE_CMD="$_hot" "$0" 9999 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = 0 ] && [ -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (MESH_HEAVY_FORCE=1 must bypass the admission gate)"; exit 1; }

  # 5) SERIALIZATION: two concurrent 1s runs must NOT overlap → elapsed >= ~1.8s (falsify: drop the flock
  #    → ~1s). Gate forced open + ample mem so only the flock governs timing. Budget 256MB (NOT a token
  #    1MB): this leg tests the FLOCK, but the run path now caps memory too — under the ulimit -v
  #    fallback a 1MB address-space cap would kill `sleep` outright (vaddr ≫ RSS), failing this test on
  #    every no-binding-cgroup node. 256MB clears sleep's vaddr under BOTH the cgroup and ulimit caps.
  _sleep="$(command -v sleep)"; _start="$(date +%s.%N)"
  ( env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_LOCK_WAIT=15 "$0" 256 -- "$_sleep" 1 >/dev/null 2>&1 ) &
  ( env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_LOCK_WAIT=15 "$0" 256 -- "$_sleep" 1 >/dev/null 2>&1 ) &
  wait
  _el="$(awk -v a="$_start" -v b="$(date +%s.%N)" 'BEGIN{printf "%.2f", b-a}')"
  awk -v e="$_el" 'BEGIN{exit !(e >= 1.8)}' \
    || { echo "smoke-test: FAIL (serialization broken — two 1s runs took ${_el}s, expected >=1.8s: flock not holding)"; exit 1; }

  # 6) --admit PRE-FLIGHT (no serialization, no exec) — the delegated gate whisper-run calls.
  #    ADMIT: ample mem + clear node → 0. REFUSE: tight mem + clear node → EX_TEMPFAIL 75.
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" --admit 500 >/dev/null 2>&1
  [ "$?" = 0 ] || { echo "smoke-test: FAIL (--admit must return 0 when the node can admit)"; exit 1; }
  env $_base MESH_HEAVY_MEMINFO="$_tight" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" --admit 2000 >/dev/null 2>&1
  [ "$?" = "$EX_TEMPFAIL" ] || { echo "smoke-test: FAIL (--admit must EX_TEMPFAIL 75 when the node cannot admit)"; exit 1; }
  # 6a) --admit non-integer budget → EX_USAGE 64 (never a silent admit).
  env $_base "$0" --admit notanumber >/dev/null 2>&1; [ "$?" = "$EX_USAGE" ] \
    || { echo "smoke-test: FAIL (--admit non-integer budget must be EX_USAGE 64)"; exit 1; }

  # 7) MEMORY CEILING — the budget is a CAP, not just an admission precondition (chat-review/
  #    heavy-run-budget-is-admission-not-cap). A job allocating PAST its budget must die ALONE
  #    (cgroup-OOM), not balloon node-wide; a within-budget job completes. RED-first: without the
  #    per-job cap at the run site the over-alloc below FINISHES rc=0. Branch on --capcheck, which now
  #    probes the BIND (not just the launch) — so on a runner where the ceiling does NOT bind (the
  #    exact env that reverted a1274ab) we take the ulimit-fallback assertion instead of demanding an
  #    OOM the kernel was never going to deliver. (Needs python3 to allocate.)
  if env $_base "$0" --capcheck >/dev/null 2>&1; then
    # the ceiling BINDS here — assert an over-budget job dies alone and a within-budget one completes.
    if command -v python3 >/dev/null 2>&1; then
      _hog='a=bytearray(256*1024*1024); print("FINISHED", len(a))'   # 256MB under a 64MB ceiling → OOM
      _out="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_SWAPMAX_MB=0 "$0" 64 -- python3 -c "$_hog" 2>/dev/null)"; _rc=$?
      case "$_out" in *FINISHED*) echo "smoke-test: FAIL (over-budget job COMPLETED — 64MB ceiling not enforced at the run site; out='$_out')"; exit 1;; esac
      # rc MUST be 137 (128+SIGKILL) — the SPECIFIC artifact of a cgroup-OOM. A bare `!= 0` also passes
      # for a ulimit MemoryError (rc=1) or a systemd-run launch failure, so on a node that CLAIMS
      # [cgroup] (capcheck true) but silently killed via a weaker path the label would be a lie. Pin the
      # signal so the [cgroup] tag means what it says. (Mutant1 in the RED proof exposed this: strip the
      # cgroup wrap → ulimit -v also kills python3 → `!= 0` stayed green under a false [cgroup] label.)
      [ "$_rc" = 137 ] || { echo "smoke-test: FAIL (over-budget job rc=$_rc, expected 137 — not a cgroup-OOM SIGKILL; the [cgroup] path did not enforce via MemoryMax)"; exit 1; }
      _lite='a=bytearray(48*1024*1024); print("OK", len(a))'         # 48MB under a 512MB ceiling → runs
      _out="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_SWAPMAX_MB=0 "$0" 512 -- python3 -c "$_lite" 2>/dev/null)"
      case "$_out" in OK*) : ;; *) echo "smoke-test: FAIL (within-budget job wrongly killed — expected 'OK…', got '$_out')"; exit 1;; esac
      _capmode="cgroup"
    else
      _capmode="skip(cgroup binds, no python3 to drive the alloc)"
    fi
  else
    # the ceiling does NOT bind here (the env that reverted a1274ab) → the run path must WARN loudly and
    # still run, never a silent weak cap. Uses `true`, so this leg needs no python3.
    _err="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 128 -- true 2>&1 >/dev/null)"
    case "$_err" in *"no cgroup memory ceiling"*) : ;; *) echo "smoke-test: FAIL (cgroup absent but fallback WHY not emitted; got '$_err')"; exit 1;; esac
    _capmode="ulimit-fallback"
  fi

  # 7b) THE CAP-PROBE MUST SIGN ITS KILLS AND RUN ONCE PER FINGERPRINT ------------------------
  # Real kernel reads, never a fixture: the claim is about a line the KERNEL writes. Uses a private
  # cache file, so nothing here touches the durable one. Skipped honestly where the ceiling does not
  # bind (there is no kill to sign) — reachability is not producing.
  _cc="$_td/capcache"; _ccenv="$_base MESH_HEAVY_CAPCACHE=$_cc"
  _klines() { journalctl -k -o cat --since "-5min" --no-pager 2>/dev/null |
                grep -c "Killed process [0-9]* ($CAPPROBE_COMM)" ; }
  # The BEFORE count is taken first and the assertion is on the INCREASE: a bare ">=1" would be
  # satisfied by any signed kill still inside the journal window, including one this run did not mint
  # (measured — mutant "strip the signing symlink" passed on a >=1 gate).
  _npre=0; command -v journalctl >/dev/null 2>&1 && _npre="$(_klines)"
  if command -v systemd-run >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1 &&
     command -v journalctl >/dev/null 2>&1 &&
     env $_ccenv MESH_HEAVY_CAPCACHE_OFF=1 "$0" --capcheck >/dev/null 2>&1; then
    # (a) the COLD probe recorded a positive against the LIVE fingerprint — not a clock, not a bare flag
    grep -q "^binds .*|" "$_cc" 2>/dev/null \
      || { echo "smoke-test: FAIL (a binding cap-probe did not cache its verdict: '$(cat "$_cc" 2>/dev/null)')"; exit 1; }
    # (b) the kill THIS run just minted names the PROBE. This is the whole identity claim: downstream
    #     had been guessing by the victim's rss band, and a band is a proxy for "a cap was enforced".
    _seen=0; _w=0
    while [ "$_w" -lt 8 ]; do [ "$(_klines)" -gt "$_npre" ] && { _seen=1; break; }; sleep 1; _w=$((_w+1)); done
    [ "$_seen" = 1 ] \
      || { echo "smoke-test: FAIL (the cap-probe's OOM does not name itself — no NEW 'Killed process N ($CAPPROBE_COMM)' line was minted by this probe)"; exit 1; }
    # (c) RATE: a WARM cache answers without minting another kill. Three calls, zero new lines.
    _n0="$(_klines)"
    env $_ccenv "$0" --capcheck >/dev/null 2>&1 || { echo "smoke-test: FAIL (warm cache did not answer 'binds')"; exit 1; }
    env $_ccenv "$0" --capcheck >/dev/null 2>&1
    env $_ccenv "$0" --capcheck >/dev/null 2>&1
    _n1="$(_klines)"
    [ "$_n1" = "$_n0" ] \
      || { echo "smoke-test: FAIL (3 cached capchecks minted $((_n1-_n0)) new OOM kill(s) — the cache is not suppressing the probe)"; exit 1; }
    # (d) a cache whose fingerprint does NOT match is not a hit — it re-probes and re-stamps. A cache
    #     keyed on nothing (or on a clock) would serve this forever.
    printf 'binds not-this-boot|not-these-controllers\n' > "$_cc"
    env $_ccenv "$0" --capcheck >/dev/null 2>&1
    grep -q 'not-this-boot' "$_cc" 2>/dev/null \
      && { echo "smoke-test: FAIL (a STALE fingerprint was served as a cache hit)"; exit 1; }
    grep -q "^binds .*|" "$_cc" 2>/dev/null \
      || { echo "smoke-test: FAIL (a stale cache was not replaced by a fresh live-fingerprint verdict)"; exit 1; }
    _capsign="signed+cached"
  else
    _capsign="skip(no binding ceiling / no journalctl here — nothing to sign)"
  fi
  unset -f _klines

  # 8) CRON-ENV PARITY: wherever the ceiling binds in THIS env, it must also bind in a cron-shaped
  #    env (XDG_RUNTIME_DIR / DBUS_SESSION_BUS_ADDRESS stripped) — the self-supplied defaults at the
  #    top are what close the gap. RED-first: without them, env-stripped capcheck fails wherever
  #    interactive capcheck passes (the exact split that hollow-slandered 40 note3 grinds). On a node
  #    where capcheck fails even interactively there is no parity to assert — skip honestly.
  if env $_base "$0" --capcheck >/dev/null 2>&1; then
    env -u XDG_RUNTIME_DIR -u DBUS_SESSION_BUS_ADDRESS $_base "$0" --capcheck >/dev/null 2>&1 \
      || { echo "smoke-test: FAIL (cgroup ceiling binds interactively but NOT in a cron-shaped env — systemd-run --user cannot find the user manager without XDG_RUNTIME_DIR; cron grinds will silently take the ulimit -v fallback and die at import)"; exit 1; }
    _cronpar="parity"
  else
    _cronpar="skip(no binding ceiling in any env)"
  fi

  echo "smoke-test: ok (arg-validate + passthrough/exit + stderr + budget-gate both ways + node-pressure-gate + accel-precursor-gate + FORCE-bypass + admit-preflight + mem-ceiling[$_capmode] + cap-probe[$_capsign] + cron-env[$_cronpar] + 2×1s-serialize=${_el}s)"
  exit 0
fi

# ---- parse: <budget-mb> -- <cmd...> ----
budget="${1:-}"; sep="${2:-}"
case "$budget" in ''|*[!0-9]*) echo "usage: mesh-heavy-run <budget-mb> -- <cmd> [args...]" >&2; exit "$EX_USAGE";; esac
[ "$sep" = "--" ] || { echo "usage: mesh-heavy-run <budget-mb> -- <cmd> [args...]" >&2; exit "$EX_USAGE"; }
shift 2
[ "$#" -ge 1 ] || { echo "usage: mesh-heavy-run <budget-mb> -- <cmd> [args...]" >&2; exit "$EX_USAGE"; }

# ---- admission: defer-poll then refuse (unless forced) — single source of truth ----
admit_gate "$budget" || exit "$?"

# ---- serialize + renice, then run under a per-job memory ceiling ----
nice_prefix
# Shared advisory lock on fd 9 (no O_CLOEXEC → survives into the command, released on its exit).
# Degrade to unserialized-but-niced if the lock can't open or isn't acquired within LOCK_WAIT. The
# fd-9 open's 2>/dev/null is SCOPED to the group so it never leaks onto the final run (which would
# swallow the command's own stderr).
if command -v flock >/dev/null 2>&1 && { exec 9>"$LOCK"; } 2>/dev/null; then
  flock -w "$LOCK_WAIT" 9 2>/dev/null || true
fi

# ENFORCE the budget as a CEILING, not just an admission precondition (chat-review/heavy-run-budget-
# is-admission-not-cap, 2026-07-17). admit_gate above only checks the budget FITS the node's headroom;
# with no per-job cap an admitted job that under-declared balloons past it and OOMs the WHOLE node —
# live receipt: a 2500MB-budget grind reached 18.9GB anon-RSS (7.6×) at 14:39:55, node-wide OOM + a
# swap treadmill. Run the job in a transient cgroup scope capped at its declared budget so a runaway is
# cgroup-OOM-killed ALONE at its budget while every sibling process survives. Default swap ceiling 0 →
# the budget is a strict TOTAL ceiling (no treadmill); MESH_HEAVY_SWAPMAX_MB grants a swap cushion for
# a job that genuinely needs one. We RUN (not exec) so we can name the OOM on the way out; fd 9 stays
# held by this shell for the job's lifetime, so serialization is preserved. --collect reaps the scope
# unit on exit (no accumulating failed run-rN.scope). mem_cap_available PROBES the real BIND, so where
# the ceiling would NOT actually constrain (undelegated controller / no user bus) we fall through to
# the loud ulimit fallback instead of running a job we only BELIEVE is capped.
swapmax="${MESH_HEAVY_SWAPMAX_MB:-0}"
if mem_cap_available; then
  systemd-run --user --scope -q --collect -p MemoryMax="${budget}M" -p MemorySwapMax="${swapmax}M" \
    -- ${PRE[@]+"${PRE[@]}"} "$@"
  rc=$?
  [ "$rc" = 137 ] && echo "mesh-heavy-run: job hit its ${budget}MB memory ceiling and was cgroup-OOM-killed (rc=137) — the declared budget is too small for this job; raise it (or set MESH_HEAVY_SWAPMAX_MB for a swap cushion)" >&2
  exit "$rc"
fi
# FALLBACK where no cgroup memory ceiling can BIND (systemd-run / user-manager / delegated controller
# absent — e.g. bare cron with no user bus): approximate the ceiling with ulimit -v (address space,
# KB). Weaker than a cgroup RSS cap, so say so LOUDLY — a silent weak cap is worse than a loud one.
echo "mesh-heavy-run: no cgroup memory ceiling available — falling back to ulimit -v ${budget}MB (address-space cap, not RSS)" >&2
ulimit -v $((budget * 1024)) 2>/dev/null || echo "mesh-heavy-run: ulimit -v unavailable too — running nice+serialized but UNCAPPED" >&2
exec ${PRE[@]+"${PRE[@]}"} "$@"
