#!/usr/bin/env bash
# mesh-heavy-run — the ONE admission-controlled entry point for a MEMORY-HEAVY job.
#
#   mesh-heavy-run <budget-mb> -- <cmd> [args...]     # run <cmd> niced + serialized + admission-gated
#   mesh-heavy-run --test
#
# WHY (chat-review/heavy-job-admission, 2026-07-05): mesh-whisper-run solved ONE heavy binary
# (whisper.cpp) but the CLASS stayed unguarded — mesh-room-music's grainneukeln venv python runs
# UNNICED with no admission check, and a 02:04Z run OOM-killed a 2.5GB-RSS python while the 20:05Z
# batch-kill took ~8 procs. The fix belongs at the heavy-CALL-SITE class, not per-tool: this shim
#   (a) renices to 19 + ionice idle (same as whisper-run),
#   (b) holds a SHARED flock so heavy jobs serialize instead of stacking RAM, and
#   (c) PRE-FLIGHT gates admission: the declared budget must fit in MemAvailable+SwapFree AND the node
#       must not already be under resource-guard NODE-PRESSURE. If it can't be admitted it DEFERS
#       (polls) then REFUSES with EX_TEMPFAIL (75) — the caller decides to skip or retry — rather than
#       launching into a swap-exhaustion OOM.
# The NODE-PRESSURE verdict is REUSED from mesh-resource-guard (its --status prints "NODE-PRESSURE:"
# when hot) — the classifier/thresholds are NOT forked here, only consulted.
#
# reflex-cadence: none  # a call-site shim, invoked by heavy jobs — never scheduled
# orphan-ok: wrapper invoked by heavy consumers (room-music/grainneukeln/whisper), not a cron reflex.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
LOCK="${MESH_HEAVY_LOCK:-$MESH/.heavy.lock}"
NICE="${MESH_HEAVY_NICE:-19}"
LOCK_WAIT="${MESH_HEAVY_LOCK_WAIT:-300}"     # sec to wait for the serialization slot, then degrade (still niced)
ADMIT_WAIT="${MESH_HEAVY_ADMIT_WAIT:-120}"   # sec to poll for admission (mem/pressure) before refusing
ADMIT_STEP="${MESH_HEAVY_ADMIT_STEP:-5}"     # poll interval while deferring
FORCE="${MESH_HEAVY_FORCE:-0}"               # 1 = bypass the admission gate (still niced + serialized)
MEMINFO="${MESH_HEAVY_MEMINFO:-/proc/meminfo}"
# read-only node-pressure probe; overridable so --test can inject a hot/clear verdict without real load
NODEPRESSURE_CMD="${MESH_HEAVY_NODEPRESSURE_CMD:-mesh-resource-guard --status}"

EX_USAGE=64; EX_TEMPFAIL=75

# MemAvailable + SwapFree in MB from MEMINFO (the total headroom a heavy job can draw on).
read_headroom_mb() {
  awk '/^MemAvailable:/{a=$2} /^SwapFree:/{s=$2} END{printf "%d", int((a+s)/1024)}' "$MEMINFO" 2>/dev/null
}
# true (0) when the node is NOT under resource-guard NODE-PRESSURE *and not on a dragon-king precursor
# ramp* (NODE-ACCELERATING). A probe that errors/empties is treated as CLEAR (fail-open on the pressure
# axis) — the budget gate below is the hard floor, and a missing resource-guard must not wedge every
# heavy job forever. Deferring on the ACCELERATING precursor is the dragon-king prediction→suppression:
# hold the heavy job back on the super-exponential ramp, not only once the level cliff is reached.
node_clear() {
  local out
  out="$($NODEPRESSURE_CMD 2>/dev/null)" || out=""
  printf '%s\n' "$out" | grep -qE '^NODE-(PRESSURE|ACCELERATING):' && return 1
  return 0
}
# admitted when the declared budget fits headroom AND the node is not already pressured
admit_ok() { # $1 = budget MB
  local head; head="$(read_headroom_mb)"; head="${head:-0}"
  [ "$head" -ge "$1" ] 2>/dev/null || return 1
  node_clear || return 1
  return 0
}
# defer-poll admission then refuse; returns 0 admitted / EX_TEMPFAIL refused. Shared by the exec path
# AND the `--admit` pre-flight mode, so the memory/pressure decision has ONE source of truth. A heavy
# caller that keeps its OWN serialization lock (e.g. mesh-whisper-run's whisper-vs-whisper flock)
# delegates ONLY this gate — the two flocks never compound, only the mem/pressure verdict is shared.
admit_gate() { # $1 = budget MB
  [ "$FORCE" = 1 ] && return 0
  local waited=0
  until admit_ok "$1"; do
    if [ "$waited" -ge "$ADMIT_WAIT" ]; then
      echo "mesh-heavy-run: REFUSED — node cannot admit ${1}MB (headroom $(read_headroom_mb)MB / pressure) after ${ADMIT_WAIT}s; caller should skip or retry" >&2
      return "$EX_TEMPFAIL"
    fi
    sleep "$ADMIT_STEP"; waited=$((waited + ADMIT_STEP))
  done
  return 0
}

nice_prefix() {
  PRE=()
  command -v nice   >/dev/null 2>&1 && PRE+=(nice -n "$NICE")
  command -v ionice >/dev/null 2>&1 && PRE+=(ionice -c3)
}

# true when a real per-job memory CEILING is enforceable here: systemd-run present AND the --user
# manager is reachable AND the memory controller is delegated into the user slice. We PROBE it for
# real (run `true` in a throwaway capped scope) rather than infer from a controllers file, because
# under bare cron XDG_RUNTIME_DIR / the user bus may be absent and `systemd-run --user` would then
# fail at launch — an inferred "available" would silently DROP the heavy job. A MemoryMax that cannot
# bind is the 'cap that does not cap' trap; this asserts the WHOLE path once before we commit to it.
mem_cap_available() {
  command -v systemd-run >/dev/null 2>&1 || return 1
  systemd-run --user --scope -q -p MemoryMax=64M -- true >/dev/null 2>&1
}

# --admit <budget-mb>: run ONLY the admission gate (defer-poll then refuse), no serialization/exec.
# For heavy callers that keep their OWN serialization lock but delegate the memory/pressure decision
# to this single source of truth (mesh-whisper-run's whisper-gate fold, chat-review/whisper-run-fold-heavy-gate).
# --capcheck: exit 0 iff a real cgroup memory ceiling is enforceable here. Used by --test to pick the
# cgroup vs ulimit-fallback assertions; also lets a caller decide whether to trust the cap.
[ "${1:-}" = --capcheck ] && { mem_cap_available; exit $?; }

if [ "${1:-}" = --admit ]; then
  b="${2:-}"
  case "$b" in ''|*[!0-9]*) echo "usage: mesh-heavy-run --admit <budget-mb>" >&2; exit "$EX_USAGE";; esac
  admit_gate "$b"; exit $?
fi

if [ "${1:-}" = --test ]; then
  command -v flock >/dev/null 2>&1 || { echo "smoke-test: FAIL (flock missing — serialization impossible)"; exit 1; }
  command -v nice  >/dev/null 2>&1 || { echo "smoke-test: FAIL (nice missing — cannot renice)"; exit 1; }
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _lk="$_td/lock"
  _ample="$_td/mem-ample"; _tight="$_td/mem-tight"
  printf 'MemTotal: 8388608 kB\nMemAvailable: 6000000 kB\nSwapTotal: 4194304 kB\nSwapFree: 4000000 kB\n' > "$_ample"  # ~9.7GB headroom
  printf 'MemTotal: 8388608 kB\nMemAvailable: 200000 kB\nSwapTotal: 4194304 kB\nSwapFree: 100000 kB\n'  > "$_tight"   # ~293MB headroom
  _clear='printf node:\040avail\040OK\n'      # node_clear → CLEAR
  _hot='printf NODE-PRESSURE:\040swap\040low\n' # node_clear → HOT
  _accel='printf NODE-ACCELERATING:\040ramp\n'  # node_clear → HOT (dragon-king precursor)
  _base="MESH_HEAVY_LOCK=$_lk MESH_HEAVY_ADMIT_WAIT=1 MESH_HEAVY_ADMIT_STEP=1"

  # 1) ARG VALIDATION: a missing '--' separator or a non-integer budget is EX_USAGE (64), never a silent run.
  env $_base MESH_HEAVY_FORCE=1 "$0" 2000 echo hi >/dev/null 2>&1; [ "$?" = "$EX_USAGE" ] \
    || { echo "smoke-test: FAIL (missing -- separator must be EX_USAGE 64)"; exit 1; }
  env $_base MESH_HEAVY_FORCE=1 "$0" notanumber -- echo hi >/dev/null 2>&1; [ "$?" = "$EX_USAGE" ] \
    || { echo "smoke-test: FAIL (non-integer budget must be EX_USAGE 64)"; exit 1; }

  # 2) PASSTHROUGH: forwards args + returns the command's own exit code (gate forced open, mem ample).
  _out="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 500 -- printf 'tok-%s' 42 2>/dev/null)"
  [ "$_out" = "tok-42" ] || { echo "smoke-test: FAIL (arg passthrough — expected 'tok-42', got '$_out')"; exit 1; }
  env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 500 -- sh -c 'exit 7' >/dev/null 2>&1
  [ "$?" = 7 ] || { echo "smoke-test: FAIL (command exit code not propagated — expected 7)"; exit 1; }

  # 2b) STDERR PASSTHROUGH: the command's stderr must not be swallowed by the lock/gate plumbing.
  # Containment, not equality: on a node with no cgroup ceiling the run site legitimately PREPENDS a
  # loud one-line fallback warning to stderr (by design — a silent weak cap is worse), so we assert
  # the command's own stderr is PRESENT, not that it is the sole line.
  _err="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 500 -- sh -c 'printf on-stderr >&2' 2>&1 >/dev/null)"
  case "$_err" in *on-stderr*) : ;; *) echo "smoke-test: FAIL (command STDERR swallowed — expected to contain 'on-stderr', got '$_err')"; exit 1;; esac

  # 3) BUDGET GATE — REFUSE: budget 2000MB > 293MB tight headroom, node clear → EX_TEMPFAIL (75), no run.
  _marker="$_td/ran"; rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_tight" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" 2000 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = "$EX_TEMPFAIL" ] && [ ! -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (over-budget must refuse EX_TEMPFAIL 75 and NOT run the command)"; exit 1; }

  # 3b) BUDGET GATE — ADMIT: budget 2000MB <= 9.7GB ample headroom, node clear → runs.
  rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" 2000 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = 0 ] && [ -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (within-budget + clear node must admit and run)"; exit 1; }

  # 4) NODE-PRESSURE GATE (reused resource-guard verdict): ample mem BUT node hot → refuse, don't run.
  rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_hot" "$0" 500 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = "$EX_TEMPFAIL" ] && [ ! -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (NODE-PRESSURE hot must refuse even with ample budget headroom)"; exit 1; }

  # 4a) NODE-ACCELERATING GATE (dragon-king precursor): ample mem, NOT level-pressured, but on a
  # super-exponential ramp → defer the heavy job on the ramp, not at the cliff. Refuse, don't run.
  rm -f "$_marker"
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_accel" "$0" 500 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = "$EX_TEMPFAIL" ] && [ ! -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (NODE-ACCELERATING precursor must defer the heavy job even with ample headroom)"; exit 1; }

  # 4b) FORCE bypasses BOTH gates: tight mem + hot node, but FORCE=1 → runs anyway (still niced).
  rm -f "$_marker"
  env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_tight" MESH_HEAVY_NODEPRESSURE_CMD="$_hot" "$0" 9999 -- touch "$_marker" >/dev/null 2>&1
  { [ "$?" = 0 ] && [ -e "$_marker" ]; } \
    || { echo "smoke-test: FAIL (MESH_HEAVY_FORCE=1 must bypass the admission gate)"; exit 1; }

  # 5) SERIALIZATION: two concurrent 1s runs must NOT overlap → elapsed >= ~1.8s (falsify: drop the flock
  #    → ~1s). Gate forced open + ample mem so only the flock governs timing.
  _sleep="$(command -v sleep)"; _start="$(date +%s.%N)"
  ( env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_LOCK_WAIT=15 "$0" 1 -- "$_sleep" 1 >/dev/null 2>&1 ) &
  ( env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_LOCK_WAIT=15 "$0" 1 -- "$_sleep" 1 >/dev/null 2>&1 ) &
  wait
  _el="$(awk -v a="$_start" -v b="$(date +%s.%N)" 'BEGIN{printf "%.2f", b-a}')"
  awk -v e="$_el" 'BEGIN{exit !(e >= 1.8)}' \
    || { echo "smoke-test: FAIL (serialization broken — two 1s runs took ${_el}s, expected >=1.8s: flock not holding)"; exit 1; }

  # 6) --admit PRE-FLIGHT (no serialization, no exec) — the delegated gate whisper-run calls.
  #    ADMIT: ample mem + clear node → 0. REFUSE: tight mem + clear node → EX_TEMPFAIL 75.
  env $_base MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" --admit 500 >/dev/null 2>&1
  [ "$?" = 0 ] || { echo "smoke-test: FAIL (--admit must return 0 when the node can admit)"; exit 1; }
  env $_base MESH_HEAVY_MEMINFO="$_tight" MESH_HEAVY_NODEPRESSURE_CMD="$_clear" "$0" --admit 2000 >/dev/null 2>&1
  [ "$?" = "$EX_TEMPFAIL" ] || { echo "smoke-test: FAIL (--admit must EX_TEMPFAIL 75 when the node cannot admit)"; exit 1; }
  # 6a) --admit non-integer budget → EX_USAGE 64 (never a silent admit).
  env $_base "$0" --admit notanumber >/dev/null 2>&1; [ "$?" = "$EX_USAGE" ] \
    || { echo "smoke-test: FAIL (--admit non-integer budget must be EX_USAGE 64)"; exit 1; }

  # 7) MEMORY CEILING — the budget is a CAP, not just an admission precondition (chat-review/
  #    heavy-run-budget-is-admission-not-cap). A job that allocates PAST its budget must die ALONE
  #    (cgroup-OOM), not balloon node-wide; a job within budget completes. RED-first: without the
  #    per-job cap at the run site, the over-alloc below FINISHES rc=0. (Needs python3 to allocate;
  #    cgroup assertions gate on --capcheck, else the ulimit fallback must warn loudly + still run.)
  if command -v python3 >/dev/null 2>&1 && env $_base "$0" --capcheck >/dev/null 2>&1; then
    _hog='a=bytearray(256*1024*1024); print("FINISHED", len(a))'   # 256MB under a 64MB ceiling → OOM
    _out="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_SWAPMAX_MB=0 "$0" 64 -- python3 -c "$_hog" 2>/dev/null)"; _rc=$?
    case "$_out" in *FINISHED*) echo "smoke-test: FAIL (over-budget job COMPLETED — 64MB ceiling not enforced at the run site; out='$_out')"; exit 1;; esac
    [ "$_rc" != 0 ] || { echo "smoke-test: FAIL (over-budget job rc=0 — MemoryMax did not OOM-kill it)"; exit 1; }
    _lite='a=bytearray(48*1024*1024); print("OK", len(a))'         # 48MB under a 512MB ceiling → runs
    _out="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" MESH_HEAVY_SWAPMAX_MB=0 "$0" 512 -- python3 -c "$_lite" 2>/dev/null)"
    case "$_out" in OK*) : ;; *) echo "smoke-test: FAIL (within-budget job wrongly killed — expected 'OK…', got '$_out')"; exit 1;; esac
    _capmode="cgroup"
  elif command -v python3 >/dev/null 2>&1; then
    # no cgroup ceiling bindable here → the fallback must WARN loudly and still run (never a silent weak cap).
    _err="$(env $_base MESH_HEAVY_FORCE=1 MESH_HEAVY_MEMINFO="$_ample" "$0" 128 -- true 2>&1 >/dev/null)"
    case "$_err" in *"no cgroup memory ceiling"*) : ;; *) echo "smoke-test: FAIL (cgroup absent but fallback WHY not emitted; got '$_err')"; exit 1;; esac
    _capmode="ulimit-fallback"
  else
    _capmode="skip(no python3)"
  fi

  echo "smoke-test: ok (arg-validate + passthrough/exit + stderr + budget-gate both ways + node-pressure-gate + accel-precursor-gate + FORCE-bypass + admit-preflight + mem-ceiling[$_capmode] + 2×1s-serialize=${_el}s)"
  exit 0
fi

# ---- parse: <budget-mb> -- <cmd...> ----
budget="${1:-}"; sep="${2:-}"
case "$budget" in ''|*[!0-9]*) echo "usage: mesh-heavy-run <budget-mb> -- <cmd> [args...]" >&2; exit "$EX_USAGE";; esac
[ "$sep" = "--" ] || { echo "usage: mesh-heavy-run <budget-mb> -- <cmd> [args...]" >&2; exit "$EX_USAGE"; }
shift 2
[ "$#" -ge 1 ] || { echo "usage: mesh-heavy-run <budget-mb> -- <cmd> [args...]" >&2; exit "$EX_USAGE"; }

# ---- admission: defer-poll then refuse (unless forced) — single source of truth ----
admit_gate "$budget" || exit "$?"

# ---- serialize + renice, then run under a per-job memory ceiling ----
nice_prefix
# Shared advisory lock on fd 9 (no O_CLOEXEC → survives into the command, released on its exit).
# Degrade to unserialized-but-niced if the lock can't open or isn't acquired within LOCK_WAIT. The
# fd-9 open's 2>/dev/null is SCOPED to the group so it never leaks onto the final run (which would
# swallow the command's own stderr).
if command -v flock >/dev/null 2>&1 && { exec 9>"$LOCK"; } 2>/dev/null; then
  flock -w "$LOCK_WAIT" 9 2>/dev/null || true
fi

# ENFORCE the budget as a CEILING, not just an admission precondition (chat-review/heavy-run-budget-
# is-admission-not-cap, 2026-07-17). admit_gate above only checks the budget FITS the node's headroom;
# with no per-job cap an admitted job that under-declared balloons past it and OOMs the WHOLE node —
# live receipt: a 2500MB-budget grind reached 18.9GB anon-RSS (7.6×) at 14:39:55, node-wide OOM + a
# swap treadmill. Run the job in a transient cgroup scope capped at its declared budget so a runaway is
# cgroup-OOM-killed ALONE at its budget while every sibling process survives. Default swap ceiling 0 →
# the budget is a strict TOTAL ceiling (no treadmill); MESH_HEAVY_SWAPMAX_MB grants a swap cushion for
# a job that genuinely needs one. We RUN (not exec) so we can name the OOM on the way out; fd 9 stays
# held by this shell for the job's lifetime, so serialization is preserved.
swapmax="${MESH_HEAVY_SWAPMAX_MB:-0}"
if mem_cap_available; then
  systemd-run --user --scope -q -p MemoryMax="${budget}M" -p MemorySwapMax="${swapmax}M" \
    -- ${PRE[@]+"${PRE[@]}"} "$@"
  rc=$?
  [ "$rc" = 137 ] && echo "mesh-heavy-run: job hit its ${budget}MB memory ceiling and was cgroup-OOM-killed (rc=137) — the declared budget is too small for this job; raise it (or set MESH_HEAVY_SWAPMAX_MB for a swap cushion)" >&2
  exit "$rc"
fi
# FALLBACK where no cgroup memory ceiling can bind (systemd-run / user-manager / delegated controller
# absent — e.g. bare cron with no user bus): approximate the ceiling with ulimit -v (address space,
# KB). Weaker than a cgroup RSS cap, so say so LOUDLY — a silent weak cap is worse than a loud one.
echo "mesh-heavy-run: no cgroup memory ceiling available — falling back to ulimit -v ${budget}MB (address-space cap, not RSS)" >&2
ulimit -v $((budget * 1024)) 2>/dev/null || echo "mesh-heavy-run: ulimit -v unavailable too — running nice+serialized but UNCAPPED" >&2
exec ${PRE[@]+"${PRE[@]}"} "$@"
