#!/usr/bin/env bash
# mesh-wip-commit — the ONLY reboot-durable substrate for the crash-proof-recovery chain (spec
# docs/superpowers/specs/2026-07-18-crash-proof-recovery.md §P1). A mind's uncommitted work lives
# in the shared genome working tree; a /clear keeps it (working tree survives), but a REBOOT / OOM /
# kill-9 mid-edit would lose anything not committed. This reflex snapshots each active mind window's
# DIRTY worktree into git — as a NON-INVASIVE ref (refs/wip/<window>) that never touches HEAD, the
# current branch, the index, or the stash — so a reboot cannot lose more than one cadence of work.
#
#   mesh-wip-commit                 (reflex) per active mind window with a DIRTY worktree → snapshot to refs/wip/<window>
#   mesh-wip-commit --show <win>    print the wip snapshot's stat + diff vs its parent (what would be recovered)
#   mesh-wip-commit --restore <win> reconstruct the change: apply the wip delta into a CLEAN worktree, else emit a patch
#   mesh-wip-commit --list          list every refs/wip/* ref with its age + one-line subject
#   mesh-wip-commit --test          RED-first smoke test (capture incl. untracked · HEAD/index/branch untouched · clean=no ref · no churn · restore)
#
# reflex-cadence: */5 * * * *
#
# ── NON-INVASIVE by construction ─────────────────────────────────────────────────────────────
# The snapshot is built in a SEPARATE index file (GIT_INDEX_FILE=<tmp>): read-tree HEAD into it,
# `git add -A` into it (captures tracked edits AND untracked-non-ignored files — a brand-new file
# a reboot would otherwise lose), write-tree, commit-tree with HEAD as parent, update-ref
# refs/wip/<window>. The real index, HEAD, the branch, and the stash are never read-written. A
# mind's normal `git add`/`commit`/`mesh-land` flow sees an UNCHANGED working tree and index.
# The wake-context (P2, mesh-handoff --snapshot) names refs/wip/<window> so a reincarnated mind
# knows where its uncommitted work is parked.
#
# CADENCE gate: a CLEAN worktree produces NO ref update (no empty churn); an unchanged dirty state
# (same tree as the last snapshot) produces NO new commit (dedup on tree oid — commit-tree with a
# fresh timestamp would otherwise mint a new oid every run). Windows sharing one worktree dedup to
# ONE commit object (every sharing ref points at it); the refs are per-window, the objects are not.
# orphan-ok: reflex-cadence header self-wires via mesh-autowire; --show/--restore are on-demand verbs.
set -uo pipefail

SESSION="${MESH_WIP_SESSION:-$(hostname)}"
WIP_DIR="${MESH_WIP_DIR:-$HOME/.mesh/wip}"          # where --restore parks a patch when it can't apply
LOG_PREFIX="wip-commit"

# ── window enumeration (thin tmux glue; the snapshot core below is tmux-free & directly tested) ──
# Mind windows are the 2-pane data/mind channels (window 0 "bash" is 1-pane). Override the set with
# MESH_WIP_WINDOWS="a b c". Skip anything in MESH_WIP_SKIP (default: none beyond the 1-pane filter).
_mind_windows() {
  if [ -n "${MESH_WIP_WINDOWS:-}" ]; then printf '%s\n' $MESH_WIP_WINDOWS; return; fi
  tmux list-windows -t "$SESSION" -F '#{window_name} #{window_panes}' 2>/dev/null \
    | awk '$2>=2 {print $1}'
}

# Resolve a window's worktree: the first of its panes whose cwd is inside a git worktree.
_window_worktree() { # $1=window → prints toplevel path (empty if none)
  local win="$1" p top
  while read -r p; do
    [ -n "$p" ] || continue
    top="$(git -C "$p" rev-parse --show-toplevel 2>/dev/null)" || continue
    [ -n "$top" ] && { printf '%s' "$top"; return 0; }
  done < <(tmux list-panes -t "$SESSION:$win" -F '#{pane_current_path}' 2>/dev/null)
  return 1
}

_safe_ref() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

# ── the snapshot core (tmux-free; the --test drives THIS directly on a throwaway repo) ───────────
# Snapshot ONE window's worktree into refs/wip/<win>, non-invasively. Thin composition of the two
# primitives below so there is exactly ONE snapshot code path. Exit codes:
#   0 = ref updated (new snapshot)   1 = clean, no ref written   3 = unchanged since last (no churn)   2 = error
_snapshot_worktree() { # $1=toplevel  $2=window-label
  local top="$1" win="$2" out rc
  out="$(_snapshot_commit "$top" "$win")"; rc=$?
  [ "$rc" = 0 ] || return "$rc"                          # 1=clean, 2=err propagate
  _apply_ref "$top" "$win" "${out% *}" "${out#* }"
}

# Compute ONE snapshot commit for a worktree's current dirty state (tmux-free). Prints "<commit> <tree>"
# on stdout for a dirty tree; exit 1 = clean (no effective change vs HEAD); exit 2 = error. Mints exactly
# one commit object per call — the caller reuses it across every window sharing this worktree (dedup).
_snapshot_commit() { # $1=toplevel  $2=message-label
  local top="$1" label="$2" tmpidx head headtree tree commit
  [ -n "$(git -C "$top" status --porcelain 2>/dev/null)" ] || return 1
  head="$(git -C "$top" rev-parse --verify HEAD 2>/dev/null)" || return 2
  headtree="$(git -C "$top" rev-parse --verify 'HEAD^{tree}' 2>/dev/null)" || return 2
  tmpidx="$(mktemp)" || return 2
  if ! GIT_INDEX_FILE="$tmpidx" git -C "$top" read-tree HEAD 2>/dev/null \
     || ! GIT_INDEX_FILE="$tmpidx" git -C "$top" add -A 2>/dev/null; then rm -f "$tmpidx"; return 2; fi
  tree="$(GIT_INDEX_FILE="$tmpidx" git -C "$top" write-tree 2>/dev/null)"; rm -f "$tmpidx"
  [ -n "$tree" ] || return 2
  [ "$tree" = "$headtree" ] && return 1                 # no effective change → clean
  commit="$(git -C "$top" commit-tree "$tree" -p "$head" \
             -m "wip($label): uncommitted snapshot $(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>/dev/null)" || return 2
  [ -n "$commit" ] && printf '%s %s' "$commit" "$tree" || return 2
}

# Point refs/wip/<win> at $commit unless it already carries $tree (no churn). rc 0=updated 3=unchanged 2=err.
_apply_ref() { # $1=toplevel $2=window $3=commit $4=tree
  local top="$1" win="$2" commit="$3" tree="$4" ref curtree
  ref="refs/wip/$(_safe_ref "$win")"
  curtree="$(git -C "$top" rev-parse -q --verify "$ref^{tree}" 2>/dev/null || true)"
  [ -n "$curtree" ] && [ "$tree" = "$curtree" ] && return 3
  git -C "$top" update-ref "$ref" "$commit" 2>/dev/null || return 2
  return 0
}

# ── the reflex: iterate mind windows, snapshot dirty worktrees, dedup commits across shared trees ─
_run() {
  local win top rc n_new=0 n_clean=0 n_same=0 out commit tree
  declare -A wt_commit wt_tree wt_clean   # per-toplevel: the single commit/tree minted this pass
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "$LOG_PREFIX: no session '$SESSION' — nothing to snapshot"; return 0; }
  while read -r win; do
    [ -n "$win" ] || continue
    top="$(_window_worktree "$win")" || continue        # window not in a repo → skip
    if [ -z "${wt_commit[$top]:-}" ] && [ -z "${wt_clean[$top]:-}" ]; then
      out="$(_snapshot_commit "$top" "$top")"; rc=$?    # ONE commit per worktree per pass
      case "$rc" in
        0) wt_commit[$top]="${out% *}"; wt_tree[$top]="${out#* }" ;;
        1) wt_clean[$top]=1 ;;
        *) echo "$LOG_PREFIX: ERROR snapshotting worktree $top" >&2; wt_clean[$top]=1 ;;
      esac
    fi
    if [ -n "${wt_clean[$top]:-}" ]; then n_clean=$((n_clean+1)); continue; fi
    _apply_ref "$top" "$win" "${wt_commit[$top]}" "${wt_tree[$top]}"; rc=$?
    case "$rc" in
      0) n_new=$((n_new+1)); printf '%s: snapshot %s -> %s (%s)\n' "$LOG_PREFIX" "$win" "$(git -C "$top" rev-parse --short refs/wip/$(_safe_ref "$win"))" "$top" ;;
      3) n_same=$((n_same+1)) ;;
      *) echo "$LOG_PREFIX: ERROR update-ref refs/wip/$win" >&2 ;;
    esac
  done < <(_mind_windows)
  echo "$LOG_PREFIX: $n_new new · $n_same unchanged · $n_clean clean ($(date -u +%H:%M:%SZ))"
  return 0
}

_repo_for_ref() { # find a worktree that has refs/wip/<win>; default the genome tree via THIS process cwd or SESSION
  # snapshots live in the repo they were taken from; on this node that's the single shared genome tree.
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

_show() { # $1=window
  local win="$1" ref top
  ref="refs/wip/$(_safe_ref "$win")"
  top="$(_repo_for_ref)"
  git -C "$top" rev-parse -q --verify "$ref" >/dev/null 2>&1 || { echo "mesh-wip-commit --show: no snapshot at $ref" >&2; exit 1; }
  echo "== $ref @ $top =="
  git -C "$top" show --stat --oneline "$ref" | sed -n '1,40p'
  echo "-- delta vs parent (what --restore reconstructs) --"
  git -C "$top" diff "$ref^..$ref" --stat
}

_restore() { # $1=window — reconstruct the uncommitted work. Non-invasive: only auto-applies onto a CLEAN tree.
  local win="$1" ref top patch
  ref="refs/wip/$(_safe_ref "$win")"
  top="$(_repo_for_ref)"
  git -C "$top" rev-parse -q --verify "$ref" >/dev/null 2>&1 || { echo "mesh-wip-commit --restore: no snapshot at $ref" >&2; exit 1; }
  mkdir -p "$WIP_DIR"
  patch="$WIP_DIR/$(_safe_ref "$win").patch"
  git -C "$top" diff "$ref^..$ref" > "$patch"
  if [ -n "$(git -C "$top" status --porcelain 2>/dev/null)" ]; then
    echo "mesh-wip-commit --restore: worktree is DIRTY — not clobbering. Patch written:"
    echo "  $patch"
    echo "  apply with:  git -C $top apply $patch"
    exit 2
  fi
  if git -C "$top" apply "$patch" 2>/dev/null; then
    echo "mesh-wip-commit --restore: reconstructed $win's uncommitted work into $top (from $ref)"
  else
    echo "mesh-wip-commit --restore: git apply failed; patch preserved at $patch (apply/inspect manually)" >&2
    exit 3
  fi
}

_list() {
  local top; top="$(_repo_for_ref)"
  git -C "$top" for-each-ref refs/wip \
    --format='%(refname:short)  %(committerdate:relative)  %(contents:subject)' 2>/dev/null \
    | sed 's#^refs/wip/##' || true
  git -C "$top" for-each-ref refs/wip 2>/dev/null | grep -q . || echo "(no wip snapshots)"
}

_test() {
  local td rc=0 repo
  td="$(mktemp -d)" || { echo "wip-test: FAIL (mktemp)"; exit 1; }
  repo="$td/repo"
  # a throwaway repo — the snapshot core is tmux-free, so we drive it directly.
  git init -q "$repo"
  git -C "$repo" config user.email t@t; git -C "$repo" config user.name t
  ( cd "$repo" && printf 'orig\n' > tracked.txt && git add -A && git commit -qm base )
  local head0 branch0 idx0 porcelain0
  head0="$(git -C "$repo" rev-parse HEAD)"
  branch0="$(git -C "$repo" rev-parse "$(git -C "$repo" symbolic-ref HEAD)")"

  # ── clean worktree → NO ref (the empty-churn gate) ──
  _snapshot_worktree "$repo" "cleanwin"; [ "$?" = 1 ] || { echo "wip-test: FAIL (clean worktree did not report clean/no-op)"; rc=1; }
  git -C "$repo" rev-parse -q --verify refs/wip/cleanwin >/dev/null 2>&1 && { echo "wip-test: FAIL (clean worktree WROTE a ref — empty churn)"; rc=1; }

  # ── dirty: a tracked edit + a brand-new UNTRACKED file → snapshot must carry BOTH ──
  printf 'orig\nEDIT-%s\n' "$$" > "$repo/tracked.txt"
  printf 'NEWFILE-%s\n' "$$" > "$repo/untracked.txt"
  idx0="$(git -C "$repo" write-tree)"          # real-index tree BEFORE snapshot (invasiveness probe)
  porcelain0="$(git -C "$repo" status --porcelain)"
  _snapshot_worktree "$repo" "testwin"; [ "$?" = 0 ] || { echo "wip-test: FAIL (dirty snapshot did not report new ref)"; rc=1; }
  local ref=refs/wip/testwin
  git -C "$repo" rev-parse -q --verify "$ref" >/dev/null 2>&1 || { echo "wip-test: FAIL (no $ref created for dirty worktree)"; rc=1; }
  # the snapshot TREE carries the tracked edit AND the untracked file
  git -C "$repo" show "$ref:tracked.txt" 2>/dev/null | grep -q "EDIT-$$" || { echo "wip-test: FAIL (snapshot dropped the tracked edit)"; rc=1; }
  git -C "$repo" show "$ref:untracked.txt" 2>/dev/null | grep -q "NEWFILE-$$" || { echo "wip-test: FAIL (snapshot dropped the UNTRACKED file — a reboot would lose it)"; rc=1; }
  # parent is HEAD (a proper child, so the delta is exactly the wip)
  [ "$(git -C "$repo" rev-parse "$ref^")" = "$head0" ] || { echo "wip-test: FAIL (snapshot parent is not HEAD)"; rc=1; }

  # ── NON-INVASIVE: HEAD, branch, real index, working tree all untouched ──
  [ "$(git -C "$repo" rev-parse HEAD)" = "$head0" ] || { echo "wip-test: FAIL (HEAD moved)"; rc=1; }
  [ "$(git -C "$repo" rev-parse "$(git -C "$repo" symbolic-ref HEAD)")" = "$branch0" ] || { echo "wip-test: FAIL (branch ref moved)"; rc=1; }
  [ "$(git -C "$repo" write-tree)" = "$idx0" ] || { echo "wip-test: FAIL (real index changed — snapshot was invasive)"; rc=1; }
  [ "$(git -C "$repo" status --porcelain)" = "$porcelain0" ] || { echo "wip-test: FAIL (working-tree/index status changed — invasive)"; rc=1; }

  # ── no churn: an identical re-run leaves the ref oid UNCHANGED (dedup on tree) ──
  local oid1 oid2
  oid1="$(git -C "$repo" rev-parse "$ref")"
  _snapshot_worktree "$repo" "testwin"; [ "$?" = 3 ] || { echo "wip-test: FAIL (unchanged re-run did not report no-churn rc=3)"; rc=1; }
  oid2="$(git -C "$repo" rev-parse "$ref")"
  [ "$oid1" = "$oid2" ] || { echo "wip-test: FAIL (unchanged re-run minted a new commit — churn)"; rc=1; }

  # ── dedup: two windows sharing ONE worktree → both refs point at the SAME commit object (via _run's core) ──
  local c cA cB
  c="$(_snapshot_commit "$repo" "$repo")"; c="${c% *}"   # one commit for the shared tree
  _apply_ref "$repo" "winA" "$c" "$(git -C "$repo" rev-parse "$c^{tree}")" >/dev/null
  _apply_ref "$repo" "winB" "$c" "$(git -C "$repo" rev-parse "$c^{tree}")" >/dev/null
  cA="$(git -C "$repo" rev-parse refs/wip/winA 2>/dev/null)"; cB="$(git -C "$repo" rev-parse refs/wip/winB 2>/dev/null)"
  [ -n "$cA" ] && [ "$cA" = "$cB" ] || { echo "wip-test: FAIL (windows sharing a worktree did not dedup to one commit: $cA vs $cB)"; rc=1; }

  # ── restore: reconstruct the wip delta into a CLEAN clone, assert both changes reappear ──
  # (clone does not copy refs/wip; reconstruct via the patch the --restore verb emits, to prove
  #  the delta is self-contained and applies onto a clean tree — the reboot-recovery scenario.)
  git -C "$repo" diff "$ref^..$ref" > "$td/wip.patch"
  local scratch="$td/scratch"; git clone -q "$repo" "$scratch"
  if git -C "$scratch" apply "$td/wip.patch" 2>/dev/null; then
    grep -q "EDIT-$$" "$scratch/tracked.txt" || { echo "wip-test: FAIL (restore lost the tracked edit)"; rc=1; }
    grep -q "NEWFILE-$$" "$scratch/untracked.txt" 2>/dev/null || { echo "wip-test: FAIL (restore did not recreate the untracked file)"; rc=1; }
  else
    echo "wip-test: FAIL (wip delta does not apply to a clean tree)"; rc=1
  fi

  rm -rf "$td"
  [ "$rc" = 0 ] && echo "wip-test: ok (untracked+tracked captured · HEAD/branch/index/worktree untouched · clean=no-ref · no-churn on re-run · delta restores)"
  exit "$rc"
}

case "${1:-}" in
  --test)     _test ;;
  --show)     [ -n "${2:-}" ] || { echo "usage: mesh-wip-commit --show <window>" >&2; exit 2; }; _show "$2" ;;
  --restore)  [ -n "${2:-}" ] || { echo "usage: mesh-wip-commit --restore <window>" >&2; exit 2; }; _restore "$2" ;;
  --list)     _list ;;
  ""|--run)   _run ;;
  -h|--help)  sed -n '2,20p' "$0"; exit 0 ;;
  *)          echo "mesh-wip-commit: unknown arg '$1' (see --help)" >&2; exit 2 ;;
esac
