#!/usr/bin/env bash
# reflex-cadence: 7-59/10 * * * *
# doctor-artifact: $HOME/.mesh/.note3-ambient-state 2400 phone
#   ^ .note3-ambient-state is rewritten on EVERY successful read; phone-reachable + >2400s stale ⟹
#     the sense is silently not producing despite a green --test. Phone offline → gate skips.
# mesh-note3-ambient — the mesh's ONLY live environmental sense: barometric pressure + ambient
# temperature + relative humidity, from the Note3 (SM-N900) LPS25H + SHTC1 chips.
#
# THE UNLOCK (2026-07-17): these three sit behind the Samsung SSP hub with active-count=0, so the
# `dumpsys sensorservice last=<...>` scrape that mesh-baro used reads a FOSSIL frozen at ~17-min
# uptime (proven: identical across 3 reads 9s apart while the phone had been up 11.8 days), and
# temp/humidity read `last=<0.0>` = na. A real HAL listener makes the SSP actually sample. This
# organ runs `sensorcat` — a native ASensorManager client (NDK-built, ~/.mesh/note3/) — over adb,
# which registers a real listener → live pressure/temp/humidity. Derives dew point + a comfort tag.
#
#   mesh-note3-ambient           one line: pressure temp humidity dewpoint comfort
#   mesh-note3-ambient --json    {hpa, temp_c, humidity_pct, dewpoint_c, comfort}
#   mesh-note3-ambient --test    real-read gate (exit 2 = phone unreachable — honest n/a)
#
# Exit codes (honest-exit contract):
#   0 = live reading produced   2 = phone unreachable (never faked)   1 = reachable but no live axes
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
# The live read + state write (liveness-touch) run BEFORE the verb dispatch, so a --test invocation
# stamps the live artifact at load — divert when this IS a test ($1) or a test's child (exported
# flag), task test-live-writes 2026-07-20. The --test case asserts the diversion is ACTIVE.
STATE="$HOME/.mesh/.note3-ambient-state"
if [ "${1:-}" = --test ] || [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then STATE="${TMPDIR:-/tmp}/.note3-ambient-state.sandbox.$$"; fi
ADB="adb -s $SERIAL"
SECS="${MESH_NOTE3_AMBIENT_SECS:-4}"

# read_raw → raw sensorcat SENSOR| lines for pressure(6) temp(13) humidity(12); empty on failure
read_raw() {
  mesh-note3-tool-install sensorcat >/dev/null 2>&1 || return 1
  timeout $((SECS + 15)) $ADB shell "/data/local/tmp/sensorcat --secs $SECS 6 13 12" 2>/dev/null
}

# parse "<hpa|na> <temp|na> <humidity|na>" from sensorcat lines (SENSOR|name|type|v0|v1|v2|ts)
parse() {
  python3 -c "
import sys
hpa=t=h='na'
for ln in sys.stdin:
    p=ln.strip().split('|')
    if len(p)<7 or p[0]!='SENSOR': continue
    typ, v0 = p[2], p[3]
    if typ=='6':  hpa=v0
    elif typ=='13': t=v0
    elif typ=='12': h=v0
print(hpa, t, h)
"
}

# dew point (Magnus) + comfort tag from temp,humidity
derive() {
  python3 -c "
import sys, math
t,h=sys.argv[1],sys.argv[2]
try:
    t=float(t); h=float(h)
    a,b=17.62,243.12
    g=math.log(h/100.0)+a*t/(b+t)
    dp=b*g/(a-g)
    if   h<30: c='dry'
    elif h>65: c='humid'
    elif t<18: c='cool'
    elif t>26: c='warm'
    else: c='comfortable'
    print(f'{dp:.1f} {c}')
except Exception:
    print('na na')
" "$1" "$2"
}

RAW="$(read_raw)"
if [ -z "$RAW" ]; then
  echo "note3-ambient: n/a (Note3 unreachable — env sense unavailable)"
  exit 2
fi
read HPA TEMP HUM <<<"$(printf '%s\n' "$RAW" | parse)"
if [ "$HPA" = na ] && [ "$TEMP" = na ] && [ "$HUM" = na ]; then
  echo "note3-ambient: reachable but no live axes (sensorcat produced nothing)"
  exit 1
fi
read DEW COMFORT <<<"$(derive "$TEMP" "$HUM")"

printf '%s %s %s %s %s\n' "$HPA" "$TEMP" "$HUM" "$DEW" "$COMFORT" > "$STATE"   # liveness-touch every read

case "${1:-}" in
  --json) printf '{"hpa":%s,"temp_c":%s,"humidity_pct":%s,"dewpoint_c":%s,"comfort":"%s"}\n' \
            "${HPA/na/null}" "${TEMP/na/null}" "${HUM/na/null}" "${DEW/na/null}" "$COMFORT" ;;
  --test)
    # real-read gate: a live pressure must be atmospheric; temp/humidity plausible when present.
    ok=1
    # sandbox honesty: THIS run's pre-dispatch write must have gone to the diverted path, not the
    # live artifact. Mechanism-assert (zero extra reads): the diversion rebinds $STATE — if it is
    # dropped, $STATE is the live path and this reds. Falsify: delete the diversion line.
    [ "$STATE" != "$HOME/.mesh/.note3-ambient-state" ] && [ -e "$STATE" ] \
      || { echo "  FAIL: state diversion inactive — this --test stamped the LIVE artifact ($STATE)"; ok=0; }
    rm -f "$STATE" 2>/dev/null
    if [ "$HPA" != na ]; then
      python3 -c "exit(0 if 800<float('$HPA')<1100 else 1)" || { echo "  FAIL: hPa out of range: $HPA"; ok=0; }
    else echo "  note: no live pressure axis this read"; fi
    [ "$ok" = 1 ] && echo "smoke-test: ok (LIVE Note3 env: ${HPA}hPa ${TEMP}C ${HUM}% dew${DEW} $COMFORT)" \
                  || { echo "smoke-test: FAIL"; exit 1; } ;;
  *) echo "pressure=${HPA}hPa temp=${TEMP}C humidity=${HUM}% dewpoint=${DEW}C $COMFORT" ;;
esac
