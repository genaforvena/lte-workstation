#!/usr/bin/env bash
# reflex-cadence: 7-59/10 * * * *
# doctor-artifact: $HOME/.mesh/.note3-ambient-state 2400 phone
#   ^ .note3-ambient-state is rewritten on EVERY successful read; phone-reachable + >2400s stale ⟹
#     the sense is silently not producing despite a green --test. Phone offline → gate skips.
# mesh-note3-ambient — compatibility entrypoint; Note 3 ADB sensor adapter lives in integrations/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in */*) ;; *) self="$(command -v "$self")" || exit 127 ;; esac
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in /*) self="$link_target" ;; *) self="$self_dir/$link_target" ;; esac
done
script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/integrations/mesh-note3-ambient"
if [ ! -x "$implementation" ]; then
  repo_root="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
  implementation="$repo_root/scripts/integrations/mesh-note3-ambient"
fi
[ -x "$implementation" ] || {
  printf 'mesh-note3-ambient: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
