#!/usr/bin/env bash
# THE ESCALATION CHANNEL WAS STRUCTURALLY DEAD UNDER CRON UNTIL 2026-08-22. Every board post below
# is gated on `command -v mesh-chat`, and cron runs with PATH=/usr/bin:/bin (there is no PATH= line
# in the crontab) while every mesh tool lives in ~/.local/bin — so the gate was FALSE on every
# reflex fire. Measured: 589 non-OK verdicts in ~/.mesh/vpn-health.log against exactly ZERO
# [vpn-down]/[vpn-degraded]/[vpn-blind]/[vpn-ok] posts on the board, ever. The artifact was honest
# the whole time; the ALARM never rang, which is the half a mind actually watches. This one line is
# the convention the tools that DO reach the board already use (mesh-access-probe:46,
# mesh-egress-health:407) — it must stay ABOVE every sibling call.
export PATH="$HOME/.local/bin:$PATH"
# mesh-vpn-health — READ-ONLY liveness of the mesh's client-facing VPN server (default: phaedra).
#
# Verifies every client path is UP + serving, WITHOUT ever touching/restarting/rotating them.
# Operator hard rule 2026-06-19: a VPN that works is FROZEN — never edit/rotate/restart it (see
# memory never-touch-working-vpn; the 6/18 Dasha cut-off). This tool ONLY observes.
#
# Client paths checked:
#   - Shadowsocks  :443  (TCP+UDP) — friend Dasha's shared VPN + operator anti-DPI path
#   - trojan       :8443 (TCP/TLS) — operator's LTE bypass (LE cert via sslip.io)
#   - WireGuard    :51820 (UDP)    — friend/phone peers
#
# Probes (all non-invasive):
#   * process alive + listener bound        (SSH read-only: ss/pgrep/wg show)
#   * trojan TLS cert valid + days-to-expiry (external TLS handshake, like any client)
#   * SS :443 reachable from the outside     (external TCP connect)
#   * egress IP == expected                  (clients MASQUERADE through this; wrong IP = broken path)
#   * WG per-peer handshake freshness        (info: which client paths are live now)
#   * per-CLIENT roster (.json clients[] + summary "N active/idle/stale/never (M provisioned)")
#     — operator 10:38 "VPN works for everyone": surfaces WHO is on. INFO ONLY: a stale/never
#       peer is a slot a friend hasn't used yet, NOT a failure → it NEVER drives the verdict
#       (server-path drives it; per-client freshness would cry-wolf, see never-touch-working-vpn).
#
# Honest-degraded: VPN node unreachable -> exit 2 (NEVER fakes an all-clear).
# Verdict: OK (0) / DEGRADED (0, soft) / DOWN (1) / UNREACHABLE (2).
#
# Config (node-local, genome stays IP-free — set in ~/.mesh/nodes):
#   MESH_VPN_NODE      label in MESH_NODES of the VPN server   (default: phaedra)
#   MESH_VPN_PUBIP     public IP for external probes + expected egress (REQUIRED for full check)
#   MESH_VPN_SS_PORT   shadowsocks port   (default 443)
#   MESH_VPN_TROJAN_PORT trojan port      (default 8443)
#   MESH_VPN_WG_PORT   wireguard port     (default 51820)
#   MESH_VPN_CERT_WARN_DAYS  warn if cert expires within N days (default 14)
#
# Usage: mesh-vpn-health [--edge] [--json] [--test]
# reflex-cadence: */10 * * * *
# reflex-args: --edge

set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

VPN_NODE="${MESH_VPN_NODE:-phaedra}"
SS_PORT="${MESH_VPN_SS_PORT:-443}"
TROJAN_PORT="${MESH_VPN_TROJAN_PORT:-8443}"
WG_PORT="${MESH_VPN_WG_PORT:-51820}"
CERT_WARN_DAYS="${MESH_VPN_CERT_WARN_DAYS:-14}"

# Peer-freshness bands resolve env > uxn threshold-ledger (row vpn-peer-fresh) > inline 300/3600 —
# recalibrating active/idle is a ledger diff, not a script edit; unresolvable ledger degrades inline.
_ledger_const(){ # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
    local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
    led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
    [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
        && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
    case "$v" in ''|*[!0-9]*) v="$3" ;; esac
    printf '%s\n' "$v"
}
PEER_ACT="${MESH_VPN_PEER_ACTIVE_S:-$(_ledger_const vpn-peer-fresh act 300)}"
PEER_IDLE="${MESH_VPN_PEER_IDLE_S:-$(_ledger_const vpn-peer-fresh idle 3600)}"
# The REAL roster classifier (pure; --test drives THIS function, not a copy — a copied `_cl`
# rots apart from the code cron runs). never (-1) stays shell-side: ages are naturals in the ledger.
classify_peer(){ # age_s -> active|idle|stale|never
    local a="$1"
    if   [ "$a" -lt 0 ];            then echo never
    elif [ "$a" -lt "$PEER_ACT" ];  then echo active   # WG rekeys ~2min when live
    elif [ "$a" -lt "$PEER_IDLE" ]; then echo idle
    else                                 echo stale; fi
}
# observable artifact of the resolution (env > ledger > inline), same path the run takes
if [ "${1:-}" = --consts ]; then echo "peer_act=$PEER_ACT peer_idle=$PEER_IDLE"; exit 0; fi
# Both derive from $HOME, which is what --test overrides to isolate its real run: a test that
# appended to the log/state the vpn pane reads for liveness would forge the very evidence it
# checks (the mesh-guardian trap, 09f7914).
STATE="$HOME/.mesh/.vpn-health.state"
# LOG is overridable so a fault-path DRIVE can never write the tape a human and the pane read for
# liveness -- a dry run that writes the liveness log forges the evidence it exists to check.
# [[a-dry-run-that-writes-the-liveness-log-forges-its-own-evidence]] Cron passes nothing, so the
# real path is unchanged and a missing override cannot silently redirect a real run.
LOG="${MESH_VPN_LOG:-$HOME/.mesh/vpn-health.log}"
ROSTER="$HOME/.mesh/vpn-roster.json"
SSH_OPTS=(-o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes -o LogLevel=ERROR)

# resolve user@ip for the VPN node from MESH_NODES ("label:user@ip ...")
resolve_node(){
    local want="$1" entry
    for entry in ${MESH_NODES:-}; do
        [ "${entry%%:*}" = "$want" ] && { printf '%s\n' "${entry#*:}"; return 0; }
    done
    return 1
}

# local_egress → "<verdict>|<detail>", verdict = up|down|degraded.
#
# WHY A SSH FAILURE IS NOT A PEER VERDICT (2026-08-19). This node's SOLE uplink is a wedging USB
# dongle; the blind branch below fired at 05:10, 05:20 and 05:50Z while phaedra was in fact fine —
# a hand `ssh phaedra uptime` at 05:53 answered from a box with 67 days of uptime, and access-probe
# had already posted ts=DOWN anthropic=DOWN groq=DOWN at 05:44Z. The log line said the same words in
# both worlds, so a reader could not tell "phaedra is unreachable" from "we are off the air". Same
# ssh, two layers: name the one we can actually claim. (mesh-ss-clients already carried this idiom
# and its source comment names THIS tool as the one that did not — that gap is now closed.)
#
# Two independent legs so one flaky probe cannot mint a peer verdict: net = ICMP to a third party,
# ts = tailscaled's own view. Both are claims about US; neither reaches the peer — the leg that
# does is peer_ts_leg() below, and the blind branch requires it before anyone may be named.
# THREE verdicts, not two —
# one leg failing is neither "we are off the air" nor "the peer is down"; it is our own path in
# doubt, which still forbids naming the peer but must not overclaim total blindness.
local_egress() {
    local loss net ts_state ts_online tsleg
    loss="$(ping -c 2 -W 2 -q "${MESH_VPN_PROBE_HOST:-1.1.1.1}" 2>/dev/null | sed -n 's/.*[, ]\([0-9]\{1,3\}\)% packet loss.*/\1/p' | head -1 || true)"
    # LOSS IS NOT A BOOLEAN. `net=up*` used to swallow every loss short of 100, so one lost packet
    # out of two read as a healthy path and promoted the verdict to a PEER accusation (09:50:12Z
    # 2026-08-20, phaedra fine). Only a CLEAN probe is up; anything lossy is its own word, and the
    # arms below route it to `degraded` — our path in doubt, which may never name the peer.
    case "$loss" in
        ''|*[!0-9]*) net="net=unknown" ;;
        0)           net="net=up(loss=0%)" ;;
        100)         net="net=down" ;;
        *)           net="net=lossy(loss=${loss}%)" ;;
    esac
    tsleg="ts=unknown"
    if command -v tailscale >/dev/null 2>&1; then
        ts_state="$(tailscale status --json --peers=false 2>/dev/null | jq -r '.BackendState // "?"' 2>/dev/null || true)"
        ts_online="$(tailscale status --json --peers=false 2>/dev/null | jq -r '.Self.Online // "?"' 2>/dev/null || true)"
        [ -n "$ts_state" ] || ts_state="?"; [ -n "$ts_online" ] || ts_online="?"
        tsleg="ts=${ts_state}/online=${ts_online}"
    fi
    case "$net:$tsleg" in
        net=up*:ts=Running/online=true)                          printf 'up|%s %s\n'       "$net" "$tsleg" ;;
        net=up*:*|net=lossy*:*|*:ts=Running/online=true)         printf 'degraded|%s %s\n' "$net" "$tsleg" ;;
        *)                                                       printf 'down|%s %s\n'     "$net" "$tsleg" ;;
    esac
}


# _le_run — local_egress() is two live network probes and BOTH external legs may need it in one
# run. Reads it at most once per run into $_LE_RUN, so a single verdict can never contain two
# disagreeing readings of our own path (they are separate probes seconds apart on a flapping link)
# and a doubly-failing run does not pay for four.
#
# IT SETS A VARIABLE AND PRINTS NOTHING, DELIBERATELY. The obvious shape -- a function that echoes
# the cached value, called as `$(local_egress_cached)` -- CANNOT memoize anything: command
# substitution forks a subshell, the assignment dies with it, and every call re-probes while the
# code reads as cached. Callers must invoke `_le_run` as a plain command, then use "$_LE_RUN".
_LE_RUN=""
_le_run() { [ -n "$_LE_RUN" ] || _LE_RUN="$(local_egress)"; }

# ss_tcp_connect <ip> <port> — the one connect primitive. Overridable ONLY so --test can drive
# the retry BEHAVIOURALLY: asserting the retry by grepping this file for "for _try in 1 2" would
# be a source-text gate, satisfied by its own explanatory prose and deletable green.
# [[a-source-text-gate-is-satisfied-by-its-own-explanatory-prose]]
ss_tcp_connect() { timeout 6 bash -c "echo >/dev/tcp/$1/$2" 2>/dev/null; }

# ss_reach_probe <ip> <port> — true if the port answered within SS_REACH_TRIES attempts.
# ONE attempt is the defect this replaced: this node's sole uplink deauths every ~14 min and a
# lost coin flip here minted the hardest verdict the tool can raise.
SS_REACH_TRIES="${MESH_VPN_SS_REACH_TRIES:-2}"
ss_reach_probe() {
    local ip="$1" port="$2" i=1
    while [ "$i" -le "$SS_REACH_TRIES" ]; do
        ss_tcp_connect "$ip" "$port" && return 0
        i=$(( i + 1 ))
    done
    return 1
}

# cert_fail_attrib <node> <trojan-port> <local_egress-output> -> the DEGRADED message
#
# THE HALF-SWEPT FIX (2026-08-27, vpn@). 8e3405f5 gave the SS reach leg a local-path attribution
# gate and its commit message said the cert leg "already learned this in 2026-07-17". It had learned
# only HALF: it retries and it renders DEGRADED, but it still could not say WHOSE LAYER failed, and
# shipped the ambiguity in the line itself -- "server TLS broken or probe egress flaky". Two worlds,
# one sentence, unresolved, while local_egress() sat eight lines above it unused.
#
# Caught live 6h after that commit. 2026-08-27T01:00:28Z: DEGRADED on this leg with NO SS issue
# named -- so the reach probe got through on the same run this one failed twice, the exact mirror of
# the four false alarms 8e3405f5 was built from. Then 01:20:23Z and 01:30:22Z both logged
# "BLIND LOCALLY: this node cannot reach anything (local egress DOWN: net=down)". Our uplink was
# dark across that window, so 01:00:28 was almost certainly ours too -- and the log line let a reader
# believe phaedra's TLS was breaking. [[a-format-fix-must-sweep-every-reader]]
#
# Verdict stays DEGRADED either way: this leg has never raised DOWN and must not start. The whole
# value here is the ATTRIBUTION, which is what a reader of the line actually needs.
cert_fail_attrib() {
    local node="$1" port="$2" le="$3"
    case "${le%%|*}" in
        up) printf 'trojan :%s TLS probe failed 2x (local path CLEAN: %s) -- the SERVER TLS is the suspect\n' "$port" "${le#*|}" ;;
        *)  printf 'trojan :%s TLS probe failed 2x but OUR OWN PATH is in doubt (%s: %s) -- NOT a verdict about %s\n' \
                   "$port" "${le%%|*}" "${le#*|}" "$node" ;;
    esac
}

# ss_reach_attrib <ss-port> <node> <local_egress-output> -> "down|<msg>" or "degr|<msg>"
#
# THE DECIDING GRAMMAR, exposed as ONE entry point so the live path and --test drive the SAME
# predicate. A test that re-implements this case statement would be a guard on a copy, and the
# copy is exactly what rots. [[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]
# Only a CLEAN local path (local_egress verdict `up`) earns the right to name the peer; every
# other verdict -- degraded, down, or anything unrecognised -- is OUR doubt and renders DEGRADED.
# Note the failure direction: an unknown word from local_egress falls to the SAFE arm (doubt),
# never to the accusing one.
ss_reach_attrib() {
    local port="$1" node="$2" le="$3"
    case "${le%%|*}" in
        up) printf 'down|SS :%s unreachable externally 2x (local path CLEAN: %s)\n' "$port" "${le#*|}" ;;
        *)  printf 'degr|SS :%s unreachable 2x but OUR OWN PATH is in doubt (%s: %s) -- NOT a verdict about %s\n' \
                   "$port" "${le%%|*}" "${le#*|}" "$node" ;;
    esac
}

# peer_ts_leg <ssh-target-host> → "tsp=up|tsp=down(control=<peer>)|tsp=unknown|<detail>"
#
# THE ARM THAT NAMES THE PEER NEVER TESTED THE PATH THE SSH RIDES (propose
# peer-leg-tests-no-path-to-the-peer, 2026-08-20T15:01Z; filed as this fix). local_egress' ts leg
# reads `.Self.Online` — a LOCAL self-report by our own tailscaled. It says our node believes it is
# connected; it says NOTHING about whether packets reach phaedra, and `ssh phaedra` rides exactly
# that tailscale path. On 2026-08-20T10:00:08Z the blind branch accused phaedra on a clean
# loss=0% ICMP probe with Self.Online=true while OUR OWN tailscale identity was mid-recreation:
# both legs green, the transport dead, and the peer wrongly named.
#
# So probe the transport itself — `tailscale ping` reaches the peer's tailscaled through WireGuard
# (direct or DERP), which is the layer under the ssh. But a bare "the peer did not answer" is NOT
# grounds to demote the peer verdict either: a genuinely down phaedra fails this leg too, and
# collapsing that into "layer unattributed" would REGRESS today's most common true positive. Hence
# the CONTROL: if the peer is silent but another online tailscale peer answers, our own data path
# is PROVEN and the peer is named with more evidence than before, not less. Only when nothing on
# the tailnet answers (or tailscale cannot be asked) is the path unproven → the caller must not name
# the peer. Three outcomes, because two cannot express "we could not tell".
# _ts_pong <ip> — true only if the pong CAME FROM <ip> itself.
#
# rc=0 IS NOT "THAT HOST ANSWERED" (measured on this node 2026-08-20). This node runs phaedra as
# its tailscale EXIT NODE, so phaedra advertises 0.0.0.0/0 and answers on behalf of any address the
# tailnet has not assigned: `tailscale ping 100.99.99.99` → `pong from phaedra (100.94.116.17)`,
# rc=0, for an IP nobody owns. Gate on rc alone and the leg would read `up` for a peer that never
# spoke — a fallback indistinguishable from a success, which is the one thing a probe may never be.
# (rc itself is honest for an assigned-but-offline peer: 100.107.198.111 → rc=1 "timed out".)
_ts_pong() {
    local ip="$1" out
    # </dev/null: this is called from a `while read` loop fed by a here-doc, and a child that
    # inherits that stdin can swallow the roster lines the loop has not read yet — the control arm
    # then reports "no control" while a live control peer was sitting one line down.
    out="$(timeout 12 tailscale ping --c 1 --timeout 3s "$ip" </dev/null 2>/dev/null)" || return 1
    printf '%s' "$out" | grep -q "pong from .*($ip)"
}

peer_ts_leg() {
    local host="$1" ip ctl ctl_ip
    command -v tailscale >/dev/null 2>&1 || { echo "tsp=unknown|no tailscale binary"; return 0; }
    ip="${host##*@}"
    if _ts_pong "$ip"; then
        echo "tsp=up|tailscale ping $ip answered — the transport under the ssh is proven"
        return 0
    fi
    # control arm: any OTHER peer the control plane calls online. Two attempts, not the whole
    # tailnet — this runs inside a */10 reflex and a silent tailnet must not cost 8 x 3s.
    # IP FIRST, name last: a HostName can contain spaces ("Redmi 10" is on this tailnet), so a
    # `read -r name ip` splits the name and hands the ping the string "10".
    while read -r ctl_ip ctl; do
        [ -n "$ctl_ip" ] || continue
        [ "$ctl_ip" = "$ip" ] && continue
        if _ts_pong "$ctl_ip"; then
            # THE CONTROL ARM PROVES A DIFFERENT INSTANT THAN THE ONE THAT FAILED (2026-08-29).
            # These two pings are SEQUENTIAL, seconds apart — the peer is probed, and only after it
            # is silent do we walk the control peers. On a node whose sole uplink is a dongle that
            # flaps several times an up-hour, a transient that swallows the FIRST ping and clears
            # before the SECOND yields "peer silent, our path proven" — a confident accusation
            # assembled from two different windows, neither of which is the one that went dark.
            # Observed live at 2026-08-29T08:18Z: tsp=down naming phaedra while a direct
            # `tailscale ping` pongs in 135ms and `ssh phaedra` returns 0. (A 25-sample run minutes
            # later read 23 up / 2 unknown / 0 down, so this is the RARE half of the flap — which
            # half you get depends only on where the two pings land in it. n=1, not a rate.)
            #
            # So RE-PROBE the peer before the only arm that may name it. Cost is one extra ping on
            # the accusation path alone; the true positive is untouched (a genuinely down peer is
            # silent both times) and comes out with strictly more evidence than before.
            if _ts_pong "$ip"; then
                # Deliberately `unknown`, not a fifth verdict word: `unknown` already means "we
                # could not tell, name nobody", which is exactly right here, and every consumer's
                # alphabet is tsp=up|down|unknown|absent — a new word would land in their
                # default arm wearing a message about a prover that was never absent.
                # NOT `up` either: a flapping path is not a proven one, and calling it up would
                # hand the caller "the transport is fine, blame the ssh layer" for a fault that
                # was very likely the flap itself.
                echo "tsp=unknown|$ip was silent, then ANSWERED on re-probe after $ctl — the path is FLAPPING, so the control leg proved an instant that was never the failing one; not attributable"
                return 0
            fi
            echo "tsp=down(control=$ctl)|$ip silent TWICE, bracketing a proven $ctl — our tailscale path is proven"
            return 0
        fi
    done <<EOF
$(timeout 15 tailscale status --json 2>/dev/null \
    | jq -r '.Peer[]? | select(.Online == true and (.TailscaleIPs[0] // "") != "") | "\(.TailscaleIPs[0]) \(.HostName)"' 2>/dev/null \
    | grep -v "^$" | head -2)
EOF
    echo "tsp=unknown|no tailscale peer answered (peer $ip silent, no control) — our own path is unproven"
}

# peer_label — octet -> who. Hoisted above --test with classify_peer (it used to be defined down
# in the roster loop, where no gate could reach it: the first drive of it returned empty).
# PEER_NAME is filled from the SERVER's own wg0.conf (WGNAME= rows in the gather). The static
# case below is only the blind fallback for a run that could not read the roster -- and it is
# NOT silent: roster coverage (named/provisioned) is rendered in the summary, so "16 friends"
# can never wear the same face as "16 named peers". (A fallback must be rare and loud.)
declare -A PEER_NAME=()
peer_label(){
  [ -n "${PEER_NAME[$1]:-}" ] && { printf '%s\n' "${PEER_NAME[$1]}"; return 0; }
  case "$1" in 3) echo operator;; 10) echo phone;; *) echo friend;; esac
}
if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
    fail=0
    for c in ssh ss openssl timeout; do command -v "$c" >/dev/null 2>&1 || { echo "  FAIL: no $c"; fail=1; }; done
    # resolve_node parse
    MESH_NODES="phaedra:root@100.0.0.9 ilya:x@1.2.3.4" t="$(resolve_node phaedra)"
    [ "$t" = "root@100.0.0.9" ] && echo "  ok: resolve_node parse" || { echo "  FAIL: resolve_node ($t)"; fail=1; }
    # cert-expiry day-math (no real network): notAfter in the past -> negative days
    _na="Jan 1 00:00:00 2020 GMT"
    _d=$(( ( $(date -d "$_na" +%s 2>/dev/null || echo 0) - $(date +%s) ) / 86400 ))
    [ "$_d" -lt 0 ] && echo "  ok: cert day-math (expired -> $_d)" || { echo "  FAIL: cert day-math ($_d)"; fail=1; }
    # SS-reach attribution gate (2026-08-26) — the ONE probe that mints every DOWN this tool has
    # ever raised. Drives the REAL ss_reach_attrib, not a copy of its case statement.
    _pf=0
    _a="$(ss_reach_attrib 443 phaedra "up|net=up(loss=0%) ts=Running/online=true")"
    case "$_a" in down\|*"local path CLEAN"*) ;; *) echo "  FAIL: clean local path must EARN the peer accusation: $_a"; _pf=1 ;; esac
    # a lossy link is doubt, never a peer verdict — the same rule the SSH lane already obeys
    for _le in "degraded|net=lossy(loss=50%) ts=Running/online=true" "down|net=down ts=unknown"; do
        _a="$(ss_reach_attrib 443 phaedra "$_le")"
        case "$_a" in degr\|*"NOT a verdict about phaedra"*) ;; *) echo "  FAIL: doubtful local path must NOT name the peer ($_le -> $_a)"; _pf=1 ;; esac
    done
    # cert-leg attribution — the half of 8e3405f5 that had not been swept. Same rule, same
    # failure direction: only a clean local path may name the server; anything else is our doubt.
    _a="$(cert_fail_attrib phaedra 8443 "up|net=up(loss=0%) ts=Running/online=true")"
    case "$_a" in *"local path CLEAN"*"SERVER TLS is the suspect"*) ;; *) echo "  FAIL: clean local path must name the SERVER: $_a"; _pf=1 ;; esac
    for _le in "degraded|net=lossy(loss=50%) ts=Running/online=true" "down|net=down ts=Running/online=?" "wat|net=?"; do
        _a="$(cert_fail_attrib phaedra 8443 "$_le")"
        case "$_a" in *"NOT a verdict about phaedra"*) ;; *) echo "  FAIL: doubtful/unknown local path must NOT name the server ($_le -> $_a)"; _pf=1 ;; esac
    done
    # the ambiguity this replaced must be GONE from both arms — "broken or flaky" is the defect
    for _le in "up|x" "down|x"; do
        case "$(cert_fail_attrib phaedra 8443 "$_le")" in *" or "*) echo "  FAIL: cert leg still ships an unresolved either/or ($_le)"; _pf=1 ;; esac
    done
    # memoization: one reading of our own path per run, so two legs cannot disagree inside one verdict
    # Driven in the CURRENT shell, never through $( ) -- a subshell would discard the very
    # assignment under test and the arm would pass on a function that memoizes nothing.
    # The counter lives in a FILE: _LE_RUN assigns from $( ), so a shell-variable counter would be
    # incremented inside that subshell and read back as 0 -- the arm would then accuse a working
    # memo. Count where the subshell can still be seen.
    _lecf="$(mktemp)"; : > "$_lecf"
    _LE_RUN=""; local_egress() { echo x >> "$_lecf"; echo "up|call-$(wc -l < "$_lecf" | tr -d ' ')"; }
    _le_run; _le_run; _le_run
    _lec="$(wc -l < "$_lecf" | tr -d ' ')"
    { [ "$_lec" = 1 ] && [ "$_LE_RUN" = "up|call-1" ]; } \
      || { echo "  FAIL: _le_run re-probed ($_lec probes, _LE_RUN=$_LE_RUN) — two legs could disagree in one verdict"; _pf=1; }
    unset -f local_egress; _LE_RUN=""; rm -f "$_lecf"
    # THE RETRY, driven behaviourally: a stub that refuses once then answers. A single-shot
    # probe returns failure here; two tries succeed. This is the arm that makes the retry
    # undeletable, and it drives ss_reach_probe itself, never a grep of its source.
    _sc="$(mktemp)"; echo 0 > "$_sc"
    ss_tcp_connect() { local n; n=$(cat "$_sc"); n=$((n+1)); echo "$n" > "$_sc"; [ "$n" -ge 2 ]; }
    if ss_reach_probe 203.0.113.1 443; then :; else echo "  FAIL: reach probe gave up before the flaky link answered (retry lost)"; _pf=1; fi
    echo 0 > "$_sc"
    if SS_REACH_TRIES=1 ss_reach_probe 203.0.113.1 443; then echo "  FAIL: single-try control PASSED — the arm above cannot detect a dropped retry"; _pf=1; fi
    unset -f ss_tcp_connect; rm -f "$_sc"
    # failure DIRECTION: an unrecognised local_egress word falls to doubt, never to accusation
    _a="$(ss_reach_attrib 443 phaedra "wat|net=?")"
    case "$_a" in degr\|*) ;; *) echo "  FAIL: unknown local verdict must fall to doubt, got: $_a"; _pf=1 ;; esac
    [ "$_pf" = 0 ] && echo "  ok: BOTH external legs attribute the layer (clean path names peer/server; lossy/down/unknown never do; retry behavioural; local_egress memoized)" || fail=1
    # verdict precedence: DOWN beats DEGRADED beats OK
    v=OK; v=DEGRADED; [ "$v" = DEGRADED ] && v=DOWN; [ "$v" = DOWN ] && echo "  ok: verdict precedence" || { echo "  FAIL: precedence"; fail=1; }
    # per-client roster classify thresholds (active<300<=idle<3600<=stale; never=-1) — drives the
    # REAL classify_peer (the old inline `_cl` copy could rot apart from the cron path unseen)
    if [ "$(classify_peer -1)" = never ] && [ "$(classify_peer 100)" = active ] && [ "$(classify_peer 900)" = idle ] && [ "$(classify_peer 90000)" = stale ] \
       && [ "$(classify_peer 299)" = active ] && [ "$(classify_peer 300)" = idle ] && [ "$(classify_peer 3599)" = idle ] && [ "$(classify_peer 3600)" = stale ]; then
        echo "  ok: roster classify (never/active/idle/stale + exact boundaries)"
    else echo "  FAIL: roster classify"; fail=1; fi
    # band ledger resolution (env > ledger > inline): --consts is the observable artifact
    _led="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn/threshold-ledger"
    if [ -f "$_led" ]; then
        _lt="$(mktemp -d)"
        sed '/^vpn-peer-fresh /s/act=300/act=301/' "$_led" > "$_lt/recal"
        _c="$(env -u MESH_VPN_PEER_ACTIVE_S -u MESH_VPN_PEER_IDLE_S MESH_THRESHOLD_LEDGER="$_lt/recal" bash "$0" --consts)"
        [ "$_c" = "peer_act=301 peer_idle=3600" ] || { echo "  FAIL: recal ledger act=301 must reach --consts (got '$_c')"; fail=1; }
        _c="$(env -u MESH_VPN_PEER_ACTIVE_S -u MESH_VPN_PEER_IDLE_S MESH_THRESHOLD_LEDGER="$_lt/absent" bash "$0" --consts)"
        [ "$_c" = "peer_act=300 peer_idle=3600" ] || { echo "  FAIL: absent ledger must fall back inline 300/3600 (got '$_c')"; fail=1; }
        _c="$(env -u MESH_VPN_PEER_IDLE_S MESH_VPN_PEER_ACTIVE_S=120 MESH_THRESHOLD_LEDGER="$_lt/recal" bash "$0" --consts)"
        [ "$_c" = "peer_act=120 peer_idle=3600" ] || { echo "  FAIL: env override must beat ledger (got '$_c')"; fail=1; }
        rm -rf "$_lt"
    fi
    # roster is INFO only — must NOT change a server-path verdict (no down/degr from peer state)
    # the roster's two classifiers, DRIVEN — the old gate grepped this file for their NAMES, matched
    # its own line, and could never fail. Boundaries are asserted on both sides (act-1 is still
    # active, act itself is already idle), which a name-grep could never say anything about.
    # (classify_peer's own bands are already driven above; what had NO drive at all was peer_label,
    # because it was defined below this block — the name-grep was the only thing "covering" it.)
    ( _pf=0
      [ "$(peer_label 3)"  = operator ] || { echo "  FAIL: peer_label(3) must be operator"; _pf=1; }
      [ "$(peer_label 10)" = phone    ] || { echo "  FAIL: peer_label(10) must be phone"; _pf=1; }
      [ "$(peer_label 42)" = friend   ] || { echo "  FAIL: peer_label(<unknown octet>) must fall back to friend"; _pf=1; }
      exit $_pf ) && echo "  ok: roster classifiers live (info-only, server-path verdict unchanged)" || fail=1
    # ROSTER NAMES -- two halves, because either alone is vacuous. (1) the PARSER: run the real
    # wg0.conf-reading block from RSCRIPT against a fixture holding every shape phaedra's file
    # actually carries (bare name, name + prose, name + a COLON in the prose, a [Peer] with no
    # comment). (2) the CONSUMER: peer_label must PREFER the map over its static case -- octet 10
    # is 'phone' in the fallback and 'redmi-body' on the real server, so a map that is built and
    # never read looks identical to no map at all. Falsify: drop the PEER_NAME lookup from
    # peer_label -> half 2 goes red; drop the WGNAME echo from RSCRIPT -> half 1 goes red.
    ( _rf=0
      _wgc="$MESH_TEST_TMPD/wg0.conf"
      { echo "[Peer]"; echo "# friend1"; echo "PublicKey = AAA="; echo "AllowedIPs = 10.66.66.2/32"
        echo "[Peer]"; echo "# redmi-body-lte (2026-06-18: Endpoint:4500 + MTU1280 for LTE)"
        echo "PublicKey = BBB="; echo "AllowedIPs = 10.66.66.11/32"
        echo "[Peer]"; echo "PublicKey = CCC="; echo "AllowedIPs = 10.66.66.99/32"; } > "$_wgc"
      _got="$(sed -n "/^  pend=\"\"$/,/^  done < \/etc\/wireguard\/wg0.conf/p" "$0" \
              | sed "s#< /etc/wireguard/wg0.conf#< $_wgc#" | bash 2>/dev/null | tr "\n" " ")"
      case "$_got" in
        *"WGNAME=2:friend1"*)  ;; *) echo "  FAIL: roster parser lost the plain name ($_got)"; _rf=1 ;;
      esac
      case "$_got" in
        *"WGNAME=11:redmi-body-lte"*) ;; *) echo "  FAIL: roster parser mangled a name with prose+colon ($_got)"; _rf=1 ;;
      esac
      case "$_got" in
        *"WGNAME=99:"*) echo "  FAIL: a commentless [Peer] must emit NO name, never inherit the previous one ($_got)"; _rf=1 ;;
      esac
      PEER_NAME=([11]=redmi-body-lte)
      [ "$(peer_label 11)" = redmi-body-lte ] || { echo "  FAIL: peer_label ignored the server roster (static case won)"; _rf=1; }
      PEER_NAME=()
      [ "$(peer_label 10)" = phone ] || { echo "  FAIL: peer_label must fall back when the roster is empty"; _rf=1; }
      exit $_rf ) && echo "  ok: WG peer names parsed from wg0.conf and preferred by peer_label" || fail=1
    command -v tailscale >/dev/null 2>&1 && echo "  ok: tailscale present" || echo "  note: no tailscale (ok, not required)"
    # UNREACHABLE MUST WRITE THE ARTIFACT (2026-07-15). Everything above this line is offline
    # arithmetic and self-greps — none of it drives the code that runs in cron, which is exactly
    # how "exit 2 without writing $LOG" survived: the pane rendered a stale 'VPN OK' for the whole
    # 21:20-21:30 phaedra flap. Drive a REAL run against RFC5737 TEST-NET-1 (192.0.2.1, non-
    # routable by definition, so the gather cannot succeed) under a throwaway $HOME — which
    # relocates .mesh/nodes, $LOG and $STATE together, so this cannot touch the artifacts the pane
    # trusts. No --edge: EDGE=0 means no mesh-chat, so the gate never posts to the board.
    # Falsify: delete the printf that appends $ubl to $LOG -> this goes red.
    _td="$(mktemp -d)"; mkdir -p "$_td/.mesh" "$_td/bin"
    printf 'MESH_NODES="blackhole:root@192.0.2.1"\n' > "$_td/.mesh/nodes"
    # Shim mesh-chat so the [vpn-blind] post is CAPTURED and asserted, never sent. Two independent
    # guards keep this off the real board: the shim wins on PATH, and $HOME is throwaway (the real
    # mesh-chat appends to $HOME/.mesh/chat.log, so even a shim miss could not reach the board).
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s/posts.txt"\n' "$_td" > "$_td/bin/mesh-chat"
    chmod +x "$_td/bin/mesh-chat"; : > "$_td/posts.txt"
    # Stub the egress legs so the blind runs below are DETERMINISTIC. Without this the assertions
    # would silently depend on whether this node's dongle happened to be wedged during the test —
    # a gate whose verdict rides the very fault it is about to describe.
    cat >"$_td/bin/ping" <<'PSTUB'
#!/bin/sh
echo "--- stub ping statistics ---"
echo "2 packets transmitted, 2 received, ${STUB_LOSS:-0}% packet loss, time 1000ms"
[ "${STUB_LOSS:-0}" = 100 ] && exit 1 || exit 0
PSTUB
    # The tailscale stub is ARG-AWARE: local_egress asks `status --json --peers=false` (Self only)
    # while peer_ts_leg asks `ping` and `status --json` (the peer roster). One stub answering every
    # invocation identically could not tell those apart, and the peer-leg assertions below would be
    # asserting the stub, not the tool. STUB_TSP: up = the peer answers · control = the peer is
    # silent but the control peer answers · none = nothing on the tailnet answers.
    cat >"$_td/bin/tailscale" <<'TSTUB'
#!/bin/sh
case "${1:-}" in
  ping)
    for _a in "$@"; do _t="$_a"; done
    case "${STUB_TSP:-up}" in
      up)      [ "$_t" = "${STUB_TSP_PEERIP:-192.0.2.1}" ] && { echo "pong from peer ($_t) in 1ms"; exit 0; }; echo "no reply"; exit 1 ;;
      control) [ "$_t" = "${STUB_TSP_CTLIP:-100.64.0.9}" ] && { echo "pong from ctl ($_t) in 1ms"; exit 0; }; echo "no reply"; exit 1 ;;
      # flap: the peer is silent on its FIRST ping and answers on the second, with the control peer
      # up throughout. Needs STATE across invocations (a stateless stub cannot express a transient),
      # so it counts peer pings in a file beside itself — fresh per leg, since _layer_leg copies the
      # stubs into a new temp dir every call.
      flap)
        if [ "$_t" = "${STUB_TSP_PEERIP:-192.0.2.1}" ]; then
          _n=$(cat "$0.flapcount" 2>/dev/null || echo 0); _n=$((_n+1)); echo "$_n" > "$0.flapcount"
          [ "$_n" -ge 2 ] && { echo "pong from peer ($_t) in 1ms"; exit 0; }
          echo "no reply"; exit 1
        fi
        [ "$_t" = "${STUB_TSP_CTLIP:-100.64.0.9}" ] && { echo "pong from ctl ($_t) in 1ms"; exit 0; }
        echo "no reply"; exit 1 ;;
      # forged: the EXIT NODE answers for everything (rc=0) but never AS the address asked for —
      # measured live on this node, `tailscale ping 100.99.99.99` -> `pong from phaedra (100.94.116.17)`.
      forged)  echo "pong from exitnode (203.0.113.7) via 1.2.3.4:41641 in 1ms"; exit 0 ;;
      *)       echo "no reply"; exit 1 ;;
    esac ;;
  *)
    printf '{"BackendState":"%s","Self":{"Online":%s},"Peer":{"k":{"HostName":"ctl","Online":true,"TailscaleIPs":["%s"]}}}\n' \
        "${STUB_TS_STATE:-Running}" "${STUB_TS_ONLINE:-true}" "${STUB_TSP_CTLIP:-100.64.0.9}" ;;
esac
TSTUB
    # ...and stub SSH. Every blind leg below is a full --edge run whose gather ssh's to a blackhole
    # address, so each leg paid the real ConnectTimeout TWICE (the retry) — ~22s a leg. With the
    # peer-leg directions added, the suite crossed mesh-land's 180s per-candidate budget and would
    # have been killed mid-run, i.e. the gate stops being a gate (task:test-render-exceeds-autoland
    # -timeout, same shape). The legs assert what the tool SAYS when the ssh fails; how slowly the
    # kernel gives up saying so is not part of any claim here.
    # rc is drivable: 255 = OUR transport failed (the default, what every existing leg drives),
    # 0 = the read RAN and printed nothing. Those two are the pair the live path used to render
    # with one identical sentence.
    cat >"$_td/bin/ssh" <<'SSTUB'
#!/bin/sh
exit ${STUB_SSH_RC:-255}
SSTUB
    chmod +x "$_td/bin/ping" "$_td/bin/tailscale" "$_td/bin/ssh"
    _run_blind() { HOME="$_td" PATH="$_td/bin:$PATH" MESH_VPN_NODE=blackhole timeout 90 bash "$0" --edge >/dev/null 2>&1; }
    _run_blind
    _ul="$(tail -1 "$_td/.mesh/vpn-health.log" 2>/dev/null || true)"
    case "$_ul" in
        *UNREACHABLE*BLIND*) echo "  ok: unreachable node writes a BLIND line to the log (pane cannot read stale OK)" ;;
        "") echo "  FAIL: unreachable node wrote NO log line — the pane keeps rendering the last OK"; fail=1 ;;
        *)  echo "  FAIL: unreachable wrote an unexpected line: $_ul"; fail=1 ;;
    esac
    # the post path: --edge must surface BLIND to the board, or nothing wakes a mind while we
    # cannot see phaedra. Asserted with a real run because a shipped-but-never-executed branch is
    # the failure mode this whole pane keeps hitting.
    case "$(cat "$_td/posts.txt" 2>/dev/null)" in
        *'[vpn-blind]'*) echo "  ok: blind --edge posts [vpn-blind]" ;;
        *) echo "  FAIL: blind --edge posted nothing — nobody is told while the server lane is UNKNOWN"; fail=1 ;;
    esac
    # ...but ONCE. A 10-min flap must not re-cry every run (the recry mesh-ss-escalate exists to
    # kill). Second blind run: no new post, yet the artifact MUST still be written (mtime =
    # ran-live, content = value-changed — liveness and value are separate claims).
    _run_blind
    [ "$(grep -c 'vpn-blind' "$_td/posts.txt" 2>/dev/null || echo 0)" = 1 ] \
        && echo "  ok: second blind run does not re-post (edge-gated)" \
        || { echo "  FAIL: blind re-cries every run: $(grep -c 'vpn-blind' "$_td/posts.txt") posts"; fail=1; }
    [ "$(wc -l < "$_td/.mesh/vpn-health.log" 2>/dev/null || echo 0)" = 2 ] \
        && echo "  ok: every blind run writes the artifact (silence != stale OK)" \
        || { echo "  FAIL: a blind run skipped its artifact write"; fail=1; }
    # THE LAYER LEGS (2026-08-19). The SAME unreachable peer, driven three times, differing ONLY
    # in this node's own egress probe, must produce three DIFFERENT claims — because on 08-19 the
    # blind branch fired at 05:10/05:20/05:50Z while phaedra had 67d uptime and access-probe had
    # us at ts=DOWN anthropic=DOWN. Falsify: delete the `eg=$(local_egress)` case and all three
    # collapse back to one sentence -> red. Each leg gets a FRESH $HOME so it reads its own
    # artifact, never the previous direction's line.
    _layer_leg() { # <name> <env...> — echoes the log line + board post written by one blind run
        local _lt; shift   # the name is a label for the reader; only the env assignments go to env
        _lt="$(mktemp -d)"; mkdir -p "$_lt/.mesh" "$_lt/bin"
        printf 'MESH_NODES="blackhole:root@192.0.2.1"\n' > "$_lt/.mesh/nodes"
        cp "$_td/bin/mesh-chat" "$_lt/bin/mesh-chat"; sed -i "s#$_td#$_lt#" "$_lt/bin/mesh-chat"
        cp "$_td/bin/ping" "$_td/bin/tailscale" "$_td/bin/ssh" "$_lt/bin/"; : > "$_lt/posts.txt"
        env "$@" HOME="$_lt" PATH="$_lt/bin:$PATH" MESH_VPN_NODE=blackhole \
            timeout 90 bash "$0" --edge >/dev/null 2>&1
        tail -1 "$_lt/.mesh/vpn-health.log" 2>/dev/null; cat "$_lt/posts.txt" 2>/dev/null
        rm -rf "$_lt" 2>/dev/null || true
    }
    _lp="$(_layer_leg peer)"                                             # both legs up
    _ll="$(_layer_leg local STUB_LOSS=100 STUB_TS_ONLINE=false)"         # both legs down
    _ld="$(_layer_leg doubt STUB_TS_ONLINE=false)"                       # net up, ts offline
    # A LOSSY link is not an UP link. 2026-08-20T09:50:12Z this branch accused the peer on
    # net=up(loss=50%) — with -c 2, that is ONE lost packet on a node whose sole uplink is a
    # wedging dongle, and phaedra was fine (it logged VPN OK again at 10:10Z). The old glob
    # `net=up*` swallowed every loss short of 100%, so a half-dead path minted a peer verdict.
    _lx="$(_layer_leg lossy STUB_LOSS=50)"                               # net lossy, ts online
    # rc=0 with EMPTY output: ssh reached phaedra and the remote script printed nothing. Both
    # network legs are UP here, which is precisely the state in which the old code was most
    # confidently wrong — it discarded the rc and rendered "UNREACHABLE (read-only SSH failed)
    # … the PEER is the honest suspect" about a peer that had just answered.
    _lre="$(_layer_leg remote-empty STUB_SSH_RC=0)"
    case "$_lp" in
        *"the PEER is the honest suspect"*) echo "  ok: egress-up blind names the PEER as the suspect" ;;
        *) echo "  FAIL: egress-up blind did not name the peer as suspect: $_lp"; fail=1 ;;
    esac
    printf '%s' "$_lp" | grep -q 'local egress OK: net=up' \
        || { echo "  FAIL: egress-up blind did not quote its probe: $_lp"; fail=1; }
    case "$_ll" in
        *"cannot reach anything (local egress DOWN: net=down"*) echo "  ok: egress-down blind blames OUR uplink, not the peer" ;;
        *) echo "  FAIL: egress-down blind missing/unquoted local claim: $_ll"; fail=1 ;;
    esac
    case "$_ll" in
        *"the PEER is the honest suspect"*) echo "  FAIL: egress-down blind still accused the peer: $_ll"; fail=1 ;;
    esac
    case "$_ld" in
        *"local egress NOT confirmed up (net=up"*) echo "  ok: one-leg-down blind is its own third claim" ;;
        *) echo "  FAIL: partial-probe blind missing/unquoted: $_ld"; fail=1 ;;
    esac
    case "$_ld" in
        *"cannot reach anything"*|*"the PEER is the honest suspect"*)
            echo "  FAIL: partial probe overclaimed a layer: $_ld"; fail=1 ;;
    esac
    case "$_lx" in
        *"the PEER is the honest suspect"*)
            echo "  FAIL: a 50%-loss link was read as egress OK and accused the peer: $_lx"; fail=1 ;;
        *"cannot reach anything"*)
            echo "  FAIL: a 50%-loss link overclaimed total blindness: $_lx"; fail=1 ;;
        *"local egress NOT confirmed up"*) echo "  ok: a lossy link is doubt, never a peer verdict" ;;
        *) echo "  FAIL: lossy leg produced no recognised claim: $_lx"; fail=1 ;;
    esac
    printf '%s' "$_lx" | grep -q 'loss=50%' \
        || { echo "  FAIL: lossy leg did not quote the loss it measured: $_lx"; fail=1; }
    # THE PEER LEG (2026-08-20, propose peer-leg-tests-no-path-to-the-peer). Egress-up is the ONLY
    # arm allowed to name the peer, and until now it reached that verdict having tested the peer's
    # path exactly zero times: `.Self.Online` is our own tailscaled talking about itself. Three
    # drives with IDENTICAL egress (both legs up, net=up loss=0%) and differing ONLY in what the
    # TAILNET answers must split into two verdicts — named twice, refused once.
    _tp="$(_layer_leg tsp-up      STUB_TSP=up)"        # peer's tailscaled answers
    _tc="$(_layer_leg tsp-control STUB_TSP=control)"   # peer silent, a control peer answers
    _tn="$(_layer_leg tsp-none    STUB_TSP=none)"      # nothing on the tailnet answers
    case "$_tp" in
        *"the PEER is the honest suspect"*"tailscaled answers"*) echo "  ok: peer-leg up names the peer AND says the transport was confirmed" ;;
        *) echo "  FAIL: peer answering its tailscale ping did not produce a transport-confirmed peer verdict: $_tp"; fail=1 ;;
    esac
    printf '%s' "$_tp" | grep -q 'transport CONFIRMED' \
        || { echo "  FAIL: peer-leg up did not quote its own probe: $_tp"; fail=1; }
    # A silent peer with a LIVE control is still the peer's fault — this is the regression the
    # naive form of this fix would have caused, demoting today's commonest true positive to doubt.
    if printf '%s' "$_tc" | grep -q 'the PEER is the honest suspect' \
       && printf '%s' "$_tc" | grep -q 'bracketing a proven ctl'; then
        echo "  ok: peer silent + control answering still names the peer (no true-positive regression)"
    else echo "  FAIL: a proven tailscale path with a silent peer failed to name the peer: $_tc"; fail=1; fi
    # ...and a silent TAILNET may not name anyone. This is the 10:00:08Z fault: clean ICMP,
    # Self.Online=true, our identity mid-recreation, phaedra wrongly accused.
    case "$_tn" in
        *"the PEER is the honest suspect"*)
            echo "  FAIL: an UNPROVEN tailscale path still accused the peer — the 10:00:08Z fault is back: $_tn"; fail=1 ;;
        *"TAILSCALE path the ssh rides is UNPROVEN"*) echo "  ok: unproven transport is doubt, never a peer verdict" ;;
        *) echo "  FAIL: silent-tailnet leg produced no recognised claim: $_tn"; fail=1 ;;
    esac
    # A FLAPPING PATH IS NOT A PEER VERDICT (2026-08-29). Peer silent on the first ping, control up,
    # peer answering on the re-probe: the control leg proved an instant that was never the failing
    # one, so this must fall to doubt. It is the SAME stub roster and the SAME clean egress as the
    # control arm above — the two differ ONLY in whether the peer answers a second time, which is
    # what makes this a test of the re-probe and not of the fixture.
    _tfl="$(_layer_leg tsp-flap STUB_TSP=flap)"
    case "$_tfl" in
        *"the PEER is the honest suspect"*)
            echo "  FAIL: a peer that answered on re-probe was still accused — the control arm is certifying the wrong instant: $_tfl"; fail=1 ;;
        *"TAILSCALE path the ssh rides is UNPROVEN"*) echo "  ok: a peer that answers on re-probe is a flap, never a peer verdict" ;;
        *) echo "  FAIL: flap leg produced no recognised claim: $_tfl"; fail=1 ;;
    esac
    # ...and the control arm must still name the peer when it is silent BOTH times, or the re-probe
    # has simply deleted today's commonest true positive.
    printf '%s' "$_tc" | grep -q 'silent TWICE' \
        || { echo "  FAIL: the accusing arm no longer reports the second silence, so its evidence is unimproved: $_tc"; fail=1; }

    # AND a pong that is not FROM the peer proves nothing about the peer. With an exit node set,
    # `tailscale ping <unassigned-ip>` returns rc=0 answered by the exit node; a leg gated on rc
    # alone would read `up` for a host that never spoke.
    _tf="$(_layer_leg tsp-forged STUB_TSP=forged)"
    case "$_tf" in
        *"the PEER is the honest suspect"*)
            echo "  FAIL: an exit-node pong from a THIRD address was accepted as the peer answering: $_tf"; fail=1 ;;
        *"TAILSCALE path the ssh rides is UNPROVEN"*) echo "  ok: a pong from another address is not the peer answering" ;;
        *) echo "  FAIL: forged-pong leg produced no recognised claim: $_tf"; fail=1 ;;
    esac
    printf '%s' "$_tn" | grep -q 'net=up(loss=0%)' \
        || { echo "  FAIL: the doubt line must still quote the CLEAN egress it had, or the reader thinks our uplink failed: $_tn"; fail=1; }
    # the peer leg must not fire where it cannot change the verdict (cost + honesty: an egress-down
    # run has no business quoting a transport probe it never ran)
    printf '%s' "$_ll" | grep -q 'transport' \
        && { echo "  FAIL: egress-down leg probed/quoted the transport it must not: $_ll"; fail=1; }
    # The three must be genuinely DIFFERENT sentences, not three labels on one string. Compare the
    # CLAIM, never the raw line: the leading timestamp differs between legs by construction, so a
    # naive $_lp != $_ll passed the collapsed mutant that every other leg caught — a distinctness
    # gate on a clock-stamped string asserts the clock moved, nothing more.
    _lps="$(printf '%s' "$_lp" | sed 's/^[^\t]*\t//')"
    _lls="$(printf '%s' "$_ll" | sed 's/^[^\t]*\t//')"
    _lds="$(printf '%s' "$_ld" | sed 's/^[^\t]*\t//')"
    [ "$_lps" != "$_lls" ] && [ "$_lls" != "$_lds" ] && [ "$_lps" != "$_lds" ] \
        && echo "  ok: three egress states yield three distinct blind claims" \
        || { echo "  FAIL: layer legs collapsed to the same sentence"; fail=1; }
    # ...and the BOARD post carries the layer too — a mind reads the post, not the log
    printf '%s' "$_ll" | grep -q 'Fix OUR uplink first' \
        || { echo "  FAIL: [vpn-blind] post does not carry the local layer: $_ll"; fail=1; }
    # every layer still writes a line the pane can render as UNKNOWN (never a stale OK)
    for _l in "$_lp" "$_ll" "$_ld"; do
        case "$_l" in *UNREACHABLE*BLIND*) : ;; *) echo "  FAIL: a layer line lost UNREACHABLE/BLIND: $_l"; fail=1 ;; esac
    done
    # ---- rc=0 + empty output is not unreachability ----------------------------------------------
    case "$_lre" in
        *"read-only SSH failed"*)
            echo "  FAIL: rc=0 with empty output still says the SSH FAILED — the rc is discarded again: $_lre"; fail=1 ;;
        *"the PEER is the honest suspect"*)
            echo "  FAIL: a peer that ANSWERED (rc=0) was named the suspect for being unreachable: $_lre"; fail=1 ;;
        *"SUCCEEDED (rc=0) and printed NO OUTPUT"*)
            echo "  ok: rc=0 + empty output reads as a REMOTE-STATE problem, not unreachability" ;;
        *) echo "  FAIL: remote-empty leg produced no recognised claim: $_lre"; fail=1 ;;
    esac
    # ...and it must still ALARM in the pane. mesh-dash classifies this line with a word-boundary
    # regex; a sentence carrying none of its words renders a not-OK state as quiet.
    printf '%s' "$_lre" | grep -qE '\b(CRIT|CRITICAL|FAIL|FAILED|FAULT|DOWN|DEAD|DEGRADED|OFFLINE|UNREACHABLE|DARK|STALE|ERROR|BLOCKED|WARN|ALERT|LOST|BAD)\b' \
        || { echo "  FAIL: the remote-empty line carries no word mesh-dash's alarm regex matches — a not-OK state renders quiet: $_lre"; fail=1; }
    # ...but NOT as sev1: this is not a claim that phaedra is down.
    printf '%s' "$_lre" | grep -qE '\b(CRIT|CRITICAL|FAILED|DOWN|DEAD|OFFLINE|UNREACHABLE|LOST)\b' \
        && { echo "  FAIL: the remote-empty line reads as SEVERITY-1 — the peer answered, nothing here says it is down: $_lre"; fail=1; }
    # the board post must send the reader to the REMOTE file, not to the uplink
    printf '%s' "$_lre" | grep -q 'do not chase the uplink' \
        || { echo "  FAIL: [vpn-blind] post for remote-empty does not carry the remote-state tail: $_lre"; fail=1; }
    # and the transport-failure case must be UNCHANGED — the fix must not swallow real blindness
    case "$_lp" in
        *"SUCCEEDED (rc=0)"*) echo "  FAIL: an rc=255 transport failure now claims the ssh succeeded: $_lp"; fail=1 ;;
    esac
    rm -rf "$_td" 2>/dev/null || true
    [ "$fail" = 0 ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL"; exit 1; }
fi

EDGE=0; JSON=0
for a in "$@"; do
    case "$a" in
        --edge) EDGE=1 ;;
        --json) JSON=1 ;;
    esac
done

# --peer-transport <host|ip> — expose peer_ts_leg as the ONE transport prover for other vpn-lane
# tools. mesh-ss-connections used to collapse every ssh miss into "cannot reach phaedra or
# ss-server", which NAMES THE PEER for a fault that is usually this node's own wedging uplink
# dongle (29% of its artifact, 183/622 lines, 2026-08-22) — the same blind-branch bug fixed here
# on 2026-08-20, one tool over. Copying the prover would have made a second analyzer; this makes
# it callable instead.
#
# NAME -> IP IS LOAD-BEARING, NOT A CONVENIENCE. _ts_pong greps `pong from .*($ip)` to defeat the
# exit-node pong (phaedra advertises 0.0.0.0/0 for this node and answers for addresses nobody
# owns). Handed the bare alias "phaedra" it would grep for "(phaedra)" against the real output
# "pong from phaedra (100.94.116.17)" and NEVER match -- the gate would read `unknown` forever,
# a fallback wearing a verdict. So resolve to the IP the pong actually prints, and if we cannot,
# SAY so rather than probing a string.
if [ "${1:-}" = "--peer-transport" ]; then
    _pt="${2:-}"
    [ -n "$_pt" ] || { echo "tsp=unknown|--peer-transport needs a host or IP"; exit 0; }
    _pt="${_pt##*@}"
    case "$_pt" in
        *[0-9].[0-9]*) : ;;   # already an address
        *) _pt_ip="$(timeout 15 tailscale status --json 2>/dev/null \
              | jq -r --arg h "$_pt" '.Peer[]? | select((.HostName // "") == $h) | .TailscaleIPs[0] // empty' 2>/dev/null \
              | head -1)"
           [ -n "$_pt_ip" ] || { echo "tsp=unknown|cannot resolve '$_pt' to a tailscale IP — transport unproven"; exit 0; }
           _pt="$_pt_ip" ;;
    esac
    peer_ts_leg "$_pt"
    exit 0
fi

target="$(resolve_node "$VPN_NODE" || true)"
[ -n "$target" ] || { echo "vpn-health: cannot resolve '$VPN_NODE' in MESH_NODES" >&2; exit 2; }

# --- read-only SSH gather; retry once to absorb a transient SSH miss before
#     declaring BLIND (a single drop must not paint a 30-min false-UNREACHABLE) ---
RSCRIPT='
  echo "SS=$(pgrep -x ss-server >/dev/null && echo up || echo down)"
  echo "TROJAN=$(pgrep -x trojan >/dev/null && echo up || echo down)"
  echo "WG=$(ip link show wg0 >/dev/null 2>&1 && echo up || echo down)"
  echo "L443T=$(ss -tlnp 2>/dev/null | grep -cE ":443\b")"
  echo "L443U=$(ss -ulnp 2>/dev/null | grep -cE ":443\b")"
  echo "L8443=$(ss -tlnp 2>/dev/null | grep -cE ":8443\b")"
  echo "L51820=$(ss -ulnp 2>/dev/null | grep -cE ":51820\b")"
  echo "EGRESS=$(curl -s -m 8 https://api.ipify.org 2>/dev/null || echo unknown)"
  echo "WGPEERS=$(wg show wg0 peers 2>/dev/null | wc -l)"
  # newest handshake age (-1 if none) + per-peer roster row (WGROW=<10.66.66.octet>:<age|-1>)
  now=$(date +%s); best=-1
  while read -r _pk _psk _ep aips hs _rx _tx _ka; do
    oct=$(printf "%s" "$aips" | grep -oE "10\.66\.66\.[0-9]+" | head -1 | sed "s/.*\.//")
    [ -n "$oct" ] || continue
    if [ "${hs:-0}" -gt 0 ] 2>/dev/null; then age=$((now-hs)); else age=-1; fi
    echo "WGROW=$oct:$age"
    [ "$age" -ge 0 ] && { [ "$best" -lt 0 ] || [ "$age" -lt "$best" ]; } && best=$age
  done < <(wg show wg0 dump 2>/dev/null | tail -n +2)
  echo "WGFRESH=$best"
  # per-peer NAME from the server config: wg0.conf writes each peer as [Peer] / # <name> /
  # PublicKey / AllowedIPs, so the `# name` comment IMMEDIATELY precedes the octet that WGROW
  # keys on. Emit WGNAME=<oct>:<name> so the roster can say WHO instead of "friend" x16.
  # First whitespace token only, [A-Za-z0-9._-] only: the comments carry trailing prose and
  # even colons ("# redmi-body-lte (2026-06-18: Endpoint:4500 ...)"), which would split the
  # oct:name record. A peer with no comment simply emits nothing -> falls back, never guesses.
  pend=""
  while IFS= read -r ln; do
    case "$ln" in
      \[Peer\]*) pend="" ;;
      \#*) pend="$(printf "%s" "${ln#\#}" | awk "{print \$1}" | tr -cd "A-Za-z0-9._-")" ;;
      *AllowedIPs*)
        o=$(printf "%s" "$ln" | grep -oE "10\.66\.66\.[0-9]+" | head -1 | sed "s/.*\.//")
        [ -n "$o" ] && [ -n "$pend" ] && echo "WGNAME=$o:$pend"
        pend="" ;;
    esac
  done < /etc/wireguard/wg0.conf 2>/dev/null
'
# KEEP THE RC. `remote=$(ssh ...)` and a branch keyed on `[ -n "$remote" ]` alone throw away the
# one authoritative signal already in hand: ssh exits 255 for ITS OWN transport/auth failures and
# otherwise passes the remote command's status through. Without it two opposite conditions render
# the identical sentence "read-only SSH failed":
#   rc=255  our transport did not get there  -> genuinely blind, the layer arms below apply
#   rc=0    the remote script RAN and printed NOTHING -> ssh did not fail at all; phaedra is
#           reachable and its wg0.conf is unreadable/empty. Calling that "$VPN_NODE UNREACHABLE
#           (read-only SSH failed …)" is not a hedge, it is a false statement about both legs, and
#           the layer arms then confidently name the PEER as unreachable while it is answering.
# Same discarded-rc shape as mesh-fleet-health's NO-CARD (4dede914), one file over.
remote=""; ssh_rc=0
for _try in 1 2; do
  remote="$(ssh "${SSH_OPTS[@]}" "$target" "$RSCRIPT" 2>/dev/null)"; ssh_rc=$?
  # A retry buys something only when the transport failed. rc=0 with empty output is a stable
  # REMOTE fact (a file we cannot read does not become readable in 2 s), so do not spend the sleep.
  { [ -n "$remote" ] || [ "$ssh_rc" = 0 ]; } && break
  [ "$_try" = 1 ] && sleep 2
done

[ -n "$remote" ] || {
    # UNREACHABLE: honest, never an all-clear.
    #
    # THE ARTIFACT (2026-07-15): this branch used to `exit 2` right here — printing the honest
    # BLIND verdict to STDOUT and nowhere else. The only $LOG write lives on the success path at
    # the bottom of the file, and the --edge board-post block is below that, so an unreachable
    # phaedra wrote NO artifact, posted NOTHING, and touched no state. Every CONSUMER therefore
    # saw a faked all-clear: mesh-dash renders `tail -1 vpn-health.log`, so the pane kept showing
    # the last "phaedra VPN OK" while we were blind, and the board's verdict lane read "steady OK".
    # The tool was honest; its readers were lied to. Caught live: phaedra's SSH flapped 21:20-21:30,
    # both runs logged BLIND to the cron log, and the pane still said VPN OK — the ONLY tell was
    # the age (23m on a */10 reflex). Had phaedra stayed unreachable, the pane would have shown
    # "VPN OK" indefinitely: the exact Fedya scenario (a USER learns before we do) that this
    # window exists to prevent. Honest-fusion rule: an unreachable input renders UNKNOWN, never a
    # faked all-clear — and that applies to what the READERS see, not just stdout.
    #
    # BLIND is NOT a service verdict. We cannot see phaedra; clients may be perfectly fine (during
    # the 21:20 flap mesh-ss-test still PASSed end-to-end through the tunnel). So this posts
    # [vpn-blind], never [vpn-down] — claiming "CLIENTS CUT OFF" here would be a false alarm.
    #
    # ...and BLIND ABOUT WHOM? The same failed ssh has two causes on this node — phaedra down, or
    # OUR sole USB-dongle uplink wedged — and until 2026-08-19 both wrote the identical sentence.
    # Probe our own egress first and let the line make only the claim we can support (local_egress
    # above carries the evidence). The STATE key stays the bare word UNREACHABLE on purpose: the
    # layer is informative, but keying the edge on it would re-post every time a flapping link
    # walked local->doubt->peer, which is the re-cry mesh-ss-escalate exists to kill.
    # rc=0 + empty output is NOT blindness and must never wear a blind layer: the read reached
    # phaedra and came back with nothing. Handled before the egress/transport arms because those
    # arms exist to attribute a FAILED transport, and this transport succeeded — running them here
    # would spend a tailscale ping only to produce a confident claim about the wrong thing.
    if [ "$ssh_rc" = 0 ]; then
        blayer=remote-empty
        # The wording is bounded by the CONSUMERS, not by what reads best. mesh-dash classifies this
        # log line with a word-boundary regex over CRIT|FAIL|DOWN|DEGRADED|UNREACHABLE|STALE|...; a
        # sentence carrying only "unreachability" and "UNKNOWN" matches NONE of them, so a not-OK
        # state would have rendered with no alarm at all. DEGRADED is in that alphabet, is NOT in
        # the sev1 subset (this is not a DOWN claim), and is already one of the four words
        # mesh-mesh-state documents for this sense — so the reading narrows to what every existing
        # reader supports instead of minting a fifth word only this branch knows.
        ubl="$VPN_NODE VPN read DEGRADED — SERVER lane UNKNOWN. The read-only SSH SUCCEEDED (rc=0) and printed NO OUTPUT, so this is NOT unreachability and NOT a blind verdict: the peer answered us. Its wg0.conf read produced nothing (unreadable, empty, or no [Peer] section) — a REMOTE-STATE problem on $VPN_NODE. Read /etc/wireguard/wg0.conf there; do not chase the network"
    else
    eg="$(local_egress)"
    # The peer leg runs ONLY where the peer could be named — the other two arms already refuse to
    # name it, so spending 3-12s of tailscale ping there would buy nothing (and a wedged-uplink run
    # is exactly when the reflex should be cheap).
    tsp="tsp=n/a|not probed (this arm may not name $VPN_NODE)"
    case "$eg" in up\|*) tsp="$(peer_ts_leg "$target")" ;; esac
    case "$eg:$tsp" in
        up\|*:tsp=up\|*)
                 blayer=peer
                 ubl="$VPN_NODE UNREACHABLE (read-only SSH failed; local egress OK: ${eg#up|}; transport CONFIRMED: ${tsp#*|}) — the PEER is the honest suspect: its tailscaled answers but the ssh read does not. BLIND, not a service verdict" ;;
        up\|*:tsp=down*)
                 blayer=peer
                 ubl="$VPN_NODE UNREACHABLE (read-only SSH failed; local egress OK: ${eg#up|}; transport: ${tsp#*|}) — the PEER is the honest suspect. BLIND, not a service verdict" ;;
        up\|*:*)
                 blayer=doubt
                 ubl="$VPN_NODE UNREACHABLE — BLIND, layer unattributed: local egress looks OK (${eg#up|}) but the TAILSCALE path the ssh rides is UNPROVEN (${tsp#*|}); Self.Online is our own tailscaled's self-report, so this is NOT a verdict about $VPN_NODE" ;;
        down\|*) blayer=local
                 ubl="$VPN_NODE UNREACHABLE — but BLIND LOCALLY: this node cannot reach anything (local egress DOWN: ${eg#down|}); the ssh read failed at OUR end, so this is NOT a verdict about $VPN_NODE" ;;
        *)       blayer=doubt
                 ubl="$VPN_NODE UNREACHABLE — BLIND, layer unattributed: local egress NOT confirmed up (${eg#degraded|}); one probe leg failed, so our own path is in doubt and this is NOT a verdict about $VPN_NODE" ;;
    esac
    fi
    # The rc travels in the reading: a consumer that sees blind_layer=remote-empty must not read it
    # as "we could not reach phaedra". verdict stays UNREACHABLE-as-in-"no usable read", and the
    # STATE key is untouched on purpose (see the edge note below) — the distinction is carried by
    # the layer and the line, so edge semantics are byte-identical and nothing re-cries.
    [ "$JSON" = 1 ] && printf '{"verdict":"UNREACHABLE","node":"%s","blind_layer":"%s","ssh_rc":%s,"local_egress":"%s","peer_leg":"%s"}\n' "$VPN_NODE" "$blayer" "${ssh_rc:-0}" "${eg#*|}" "${tsp%%|*}" || echo "vpn-health: $ubl"
    printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ubl" >> "$LOG" 2>/dev/null || true
    if [ "$EDGE" = 1 ]; then
        # edge-gated: a flap posts once on OK->BLIND and once on the way back (the OK branch
        # below fires because prev is now UNREACHABLE), not once per */10 run. Recovery is
        # therefore self-announcing and no reflex re-cries while we stay blind.
        prev="$(cat "$STATE" 2>/dev/null || echo '')"
        if [ "$prev" != "UNREACHABLE" ]; then
            echo "UNREACHABLE" > "$STATE" 2>/dev/null || true
            case "$blayer" in
                local) _btail="Fix OUR uplink first — the SERVER lane is UNKNOWN because we are off the air, and nothing here says $VPN_NODE is down." ;;
                doubt) _btail="Our own path is in doubt, so the SERVER lane is UNKNOWN for a reason we cannot yet attribute — the line above names WHICH leg is unproven (the ICMP/ts probe, or the tailscale transport the ssh actually rides); clear that leg before suspecting $VPN_NODE." ;;
                remote-empty) _btail="Nothing here says the network is at fault — the ssh RAN and returned rc=0 with no output, so this is a REMOTE-STATE problem on $VPN_NODE (read /etc/wireguard/wg0.conf there); do not chase the uplink." ;;
                *)     _btail="Our egress checks out, so $VPN_NODE itself is the honest suspect and the SERVER lane is now UNKNOWN, not OK." ;;
            esac
            command -v mesh-chat >/dev/null && mesh-chat "[vpn-blind] $ubl — $_btail This is NOT a claim that clients are cut off: check the TUNNEL lane (mesh-ss-test) for the end-to-end truth. Diagnose READ-ONLY; never restart a working VPN." >/dev/null 2>&1
        fi
        # mtime = ran-live even while blind, so the liveness watchdogs read "reflex alive,
        # verdict unknown" instead of "reflex dead" (liveness-touch convention).
        [ -x "$HOME/.local/bin/mesh-state-touch" ] && "$HOME/.local/bin/mesh-state-touch" "$STATE" >/dev/null 2>&1 || true
    fi
    exit 2
}
eval "$(printf '%s\n' "$remote" | grep -E '^[A-Z0-9]+=' | sed -E 's/^([A-Z0-9]+)=(.*)$/R_\1="\2"/')"

# --- per-client WG roster (INFO only — never drives the verdict; friends connect intermittently,
#     a stale/never peer is a slot not a failure, see knowledge/vpn-for-everyone-roster) ---
# classify_peer is defined up top (with the ledger-resolved PEER_ACT/PEER_IDLE bands).
# name map first -- peer_label reads it, so it MUST be populated before the roster loop below.
while IFS=: read -r _o _n; do
    [ -n "$_o" ] && [ -n "$_n" ] && PEER_NAME["$_o"]="$_n"
done < <(printf '%s\n' "$remote" | sed -n 's/^WGNAME=//p')

roster_json=""; c_active=0; c_idle=0; c_stale=0; c_never=0; c_prov=0; c_named=0
while IFS=: read -r oct age; do
    [ -n "$oct" ] || continue
    c_prov=$((c_prov+1)); st="$(classify_peer "$age")"
    [ -n "${PEER_NAME[$oct]:-}" ] && c_named=$((c_named+1))
    case "$st" in active) c_active=$((c_active+1));; idle) c_idle=$((c_idle+1));; stale) c_stale=$((c_stale+1));; never) c_never=$((c_never+1));; esac
    roster_json="${roster_json}{\"ip\":\"10.66.66.$oct\",\"who\":\"$(peer_label "$oct")\",\"state\":\"$st\",\"age_s\":$age},"
done < <(printf '%s\n' "$remote" | sed -n 's/^WGROW=//p' | sort -t: -k1 -n)
roster_json="[${roster_json%,}]"
clients_summary="$c_active active / $c_idle idle / $c_stale stale / $c_never never ($c_prov provisioned)"
[ "$c_prov" -gt 0 ] && [ "$c_named" -lt "$c_prov" ] && clients_summary="$clients_summary [roster NAMES $c_named/$c_prov -- rest fell back to generic labels]"

issues=(); notes=(); verdict=OK
down(){ verdict=DOWN; issues+=("$1"); }
degr(){ [ "$verdict" = DOWN ] || verdict=DEGRADED; issues+=("$1"); }

# process + listener checks
[ "${R_SS:-down}" = up ]   || down "shadowsocks process DOWN"
[ "${R_TROJAN:-down}" = up ] || down "trojan process DOWN"
[ "${R_WG:-down}" = up ]   || down "wireguard wg0 DOWN"
[ "${R_L443T:-0}" -ge 1 ] || down "SS :$SS_PORT TCP not bound"
[ "${R_L8443:-0}" -ge 1 ] || down "trojan :$TROJAN_PORT not bound"
[ "${R_L51820:-0}" -ge 1 ] || down "WG :$WG_PORT not bound"

# external reachability + cert (needs MESH_VPN_PUBIP)
PUBIP="${MESH_VPN_PUBIP:-}"
if [ -n "$PUBIP" ]; then
    # egress correctness — clients present as this; wrong = broken egress path
    if [ "${R_EGRESS:-unknown}" != unknown ] && [ "${R_EGRESS}" != "$PUBIP" ]; then
        degr "egress IP drifted: ${R_EGRESS} != expected $PUBIP"
    fi
    # SS :443 reachable from outside.
    #
    # THIS ONE PROBE IS THE ENTIRE `DOWN` CHANNEL OF THIS TOOL (measured 2026-08-26, vpn@, over
    # 3591 runs / 43 days): 59 DOWN verdicts, and ALL 59 name "SS :$SS_PORT unreachable
    # externally". Every other down() call above -- SS/trojan/wg process, three "not bound" checks,
    # cert EXPIRED -- has fired ZERO times, ever. So whatever discipline this leg has IS the
    # discipline of the hardest verdict the tool can raise, and until now it had none: ONE
    # un-retried 6s TCP connect, from a node whose sole uplink is a wedging USB dongle that
    # deauths every ~14 min.
    #
    # Its own SIBLING eight lines below already learned this in 2026-07-17 -- retried once,
    # DEGRADED not DOWN, with a comment that names this exact hazard ("a single hung handshake on
    # the probe's own flaky egress is a probe fault") -- and the fix never travelled up here, to
    # the strictly more severe leg. Nor did the local_egress() apparatus above, which exists
    # precisely so a probe riding our own dongle may never accuse the peer, and which guarded the
    # SSH lane only. [[a-sentinel-guard-does-not-travel-to-the-drivers-other-rendering]]
    #
    # THE IN-RUN CONTROL ARM IS WHAT PROVES IT, no cross-tool correlation needed. Split those 59:
    # 54 failed BOTH external legs together (a real path outage, either end), but 4 failed :443
    # ALONE while the trojan TLS handshake to the SAME IP, seconds later in the SAME run,
    # SUCCEEDED and read the cert. The far end was demonstrably reachable; only the single-shot
    # leg lost a coin flip. 4/59 = 6.8% of every DOWN this tool has ever raised.
    # Worked example, 2026-08-26T18:00:21Z: DOWN with "trojan cert ok (80d left)" in the same
    # line; mesh-mlme-tap put association loss at episodes=0 dark=0 coverage=full across the
    # verdict instant, and mesh-egress-health had hop1 (192.168.8.1) at 227->403ms and then ICMP
    # total-loss at 18:00:08 -- a WEDGED-but-associated radio, which the MLME plane structurally
    # cannot see either. Our path, wearing phaedra's name on the board.
    #
    # So: retry (the sibling's discipline), and if it still fails, ASK WHOSE LAYER IT IS before
    # naming anyone. local_egress() returns up|degraded|down about US, never about the peer; only
    # a CLEAN local path earns the right to say "externally unreachable". Anything else is doubt,
    # and doubt is DEGRADED -- the word every consumer of this tool already knows. Minting a new
    # verdict here would be invisible to them. [[a-new-verdict-word-must-be-in-the-consumers-alphabet]]
    if ! ss_reach_probe "$PUBIP" "$SS_PORT"; then
        # The attribution is EARNED here or it is not made. Carry the evidence either way, so a
        # reader of the log line can tell the two worlds apart -- the failure this whole block is
        # built around is that they used to render in the same words.
        _le_run
        _ssv="$(ss_reach_attrib "$SS_PORT" "$VPN_NODE" "$_LE_RUN")"
        case "${_ssv%%|*}" in
            down) down "${_ssv#*|}" ;;
            *)    degr "${_ssv#*|}" ;;
        esac
    fi
    # trojan TLS cert validity + expiry — retried once: a single hung handshake on the
    # probe's own flaky egress is a probe fault, not a cert fault (2026-07-17: one 10s
    # hang read as "cert unreadable" and flipped the verdict DEGRADED while the cert
    # had 61d left and the server was serving)
    cert_end=""
    for _try in 1 2; do
        cert_end="$(echo | timeout 10 openssl s_client -connect "$PUBIP:$TROJAN_PORT" -servername "$(echo "$PUBIP"|tr . -).sslip.io" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
        [ -n "$cert_end" ] && break
    done
    if [ -z "$cert_end" ]; then
        _le_run
        degr "$(cert_fail_attrib "$VPN_NODE" "$TROJAN_PORT" "$_LE_RUN")"
    else
        days=$(( ( $(date -d "$cert_end" +%s 2>/dev/null || echo 0) - $(date +%s) ) / 86400 ))
        if [ "$days" -lt 0 ]; then down "trojan cert EXPIRED ($cert_end)"
        elif [ "$days" -lt "$CERT_WARN_DAYS" ]; then degr "trojan cert expires in ${days}d ($cert_end)"
        else notes+=("trojan cert ok (${days}d left)"); fi
    fi
else
    notes+=("set MESH_VPN_PUBIP for external cert/reach/egress checks")
fi

# WG client freshness (info, not a failure — clients connect intermittently)
wgfresh="${R_WGFRESH:--1}"
if [ "$wgfresh" -ge 0 ]; then
    notes+=("WG ${R_WGPEERS:-?} peers, newest handshake ${wgfresh}s ago")
    [ "$wgfresh" -gt 86400 ] && degr "no WG client handshake in >24h (all peers idle?)"
else
    notes+=("WG ${R_WGPEERS:-?} peers, no handshakes yet")
fi
# per-client roster (operator 10:38 "VPN works for everyone") — INFO line, never an alarm
[ "$c_prov" -gt 0 ] && notes+=("clients: $clients_summary")

summary="$VPN_NODE VPN $verdict — SS:$([ "${R_SS:-}" = up ]&&echo up||echo DOWN) trojan:$([ "${R_TROJAN:-}" = up ]&&echo up||echo DOWN) wg:$([ "${R_WG:-}" = up ]&&echo up||echo DOWN)"
[ ${#issues[@]} -gt 0 ] && summary="$summary | $(IFS='; '; echo "${issues[*]}")"
[ ${#notes[@]}  -gt 0 ] && summary="$summary | $(IFS='; '; echo "${notes[*]}")"

if [ "$JSON" = 1 ]; then
    printf '{"verdict":"%s","node":"%s","ss":"%s","trojan":"%s","wg":"%s","egress":"%s","wg_fresh_s":%s,"issues":%d,"clients_summary":"%s","clients":%s}\n' \
        "$verdict" "$VPN_NODE" "${R_SS:-?}" "${R_TROJAN:-?}" "${R_WG:-?}" "${R_EGRESS:-?}" "${wgfresh}" "${#issues[@]}" "$clients_summary" "$roster_json"
else
    echo "=== mesh-vpn-health $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
    echo "$summary"
fi

printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$summary" >> "$LOG" 2>/dev/null || true

# Durable roster artifact. The log line carries only the four COUNTS, so every reader that wanted
# to know WHICH friend is on had to re-ssh phaedra; the pane simply printed a TODO instead. Written
# only on a reached run (the UNREACHABLE branch exits far above), so a stale file is honest history
# and its own `at` stamps the age -- a reader must age it, never read it as current.
if [ "$c_prov" -gt 0 ]; then
    printf '{"at":"%s","node":"%s","named":%d,"provisioned":%d,"clients":%s}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$VPN_NODE" "$c_named" "$c_prov" "$roster_json" \
        > "$ROSTER.tmp" 2>/dev/null && mv -f "$ROSTER.tmp" "$ROSTER" 2>/dev/null || true
fi

# --edge: post to board only on verdict change
if [ "$EDGE" = 1 ]; then
    prev="$(cat "$STATE" 2>/dev/null || echo '')"
    if [ "$verdict" != "$prev" ]; then
        echo "$verdict" > "$STATE" 2>/dev/null || true
        case "$verdict" in
            DOWN)     command -v mesh-chat >/dev/null && mesh-chat "[vpn-down] $summary — CLIENTS CUT OFF. DIAGNOSE READ-ONLY; do NOT restart/rotate a working VPN without operator (memory never-touch-working-vpn)." >/dev/null 2>&1 ;;
            DEGRADED) command -v mesh-chat >/dev/null && mesh-chat "[vpn-degraded] $summary" >/dev/null 2>&1 ;;
            OK)       [ -n "$prev" ] && command -v mesh-chat >/dev/null && mesh-chat "[vpn-ok] $summary — all client paths serving again" >/dev/null 2>&1 ;;
        esac
    fi
    # mtime = ran-live (always), content = value-changed (only on flip). The .vpn-health.state
    # file holds the COMMITTED verdict and is the primary liveness artifact for consumers
    # (mesh-dash / dashboard / reflex-health read it for liveness). A stably-OK VPN would
    # otherwise freeze the state mtime at the last commit (10+ days observed: cron firing
    # every 30min, log perfectly fresh, state still 2026-06-19) — the liveness watchdog
    # would mark a CRON-firing + smoke-passing + fresh-log reflex as DEAD, just because
    # the verdict held. Mirrors the chat-review/state-touch-adoption fix applied to
    # mesh-net-drop, mesh-psi, mesh-wifi-crossval. ABSOLUTE path is cron-PATH-safe.
    [ -x "$HOME/.local/bin/mesh-state-touch" ] && "$HOME/.local/bin/mesh-state-touch" "$STATE" >/dev/null 2>&1 || true
fi

case "$verdict" in DOWN) exit 1 ;; *) exit 0 ;; esac
