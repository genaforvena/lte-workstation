#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-test-quality-gate — deterministic anti-vacuous --test gate.
#
# Assesses ONE tool file (--tool <path>) and verdicts whether its --test arm
# exercises the tool's own function or only asserts dependency presence.
#
#   mesh-test-quality-gate --tool <path>   assess one file
#   mesh-test-quality-gate --test          self-test (fixtures)
#
# Verdicts (printed as first word, exit codes):
#   PASS <file>          — --test block drives the tool's own function (rc 0)
#   HOLD vacuous: <file> — --test block is dep-presence checks only (rc 1)
#   SKIP <reason>: <file>— no --test arm, or # test-quality-ok: <why> (rc 2)
#
# Heuristic (deterministic, grep-based — documented here, not ML):
#   1. Extract the --test block: text between the --test dispatch line and
#      its terminating exit/terminator (see extract_test_block).
#   2. A block DRIVES the tool if it matches >=1 of:
#      (a) the tool's own short name (basename minus mesh- prefix) as a token;
#      (b) invocation of a function defined in the file (name from ^fn() {/^fn / lines);
#      (c) fixture driving: tmpdir|fixture|mktemp|HOME=|MESH_..._FIXTURE|unshare|stub;
#      (d) assertion on tool OUTPUT: grep -q on captured output ($out/$(...)/pipe),
#          or [ ... ] / test on a result var ($rc/$out/$r/$result).
#   3. Pure `command -v X` / `[ -x ...]`-only blocks match none of the above → HOLD vacuous.
#
# KNOWN HARD CASES (documented, not solved):
#   - Shim tools delegating via exec (mesh-bt-link etc.): the --test block
#     drives a delegate, not a locally-defined function, so this gate may read
#     HOLD vacuous on a tool whose real work is one exec hop away. Fix = resolve
#     one exec level before judging (read the exec target's function set too).
#   - Honest-exit offline fixtures (mesh-motion-corroborate): fixtures that
#     render UNKNOWN-never-quiet by design look fixture-driven but prove little
#     about the live sense. SKIP via # test-quality-ok naming the honest-exit
#     behavior; do not FAIL them.
set -uo pipefail

gate_one(){
  local f="$1"
  [ -f "$1" ] || { echo "SKIP missing-file: $f"; return 2; }
  # SKIP via self-declared exemption — justification must name honest-exit behavior.
  local okline
  okline="$(grep -m1 -E '^[[:space:]]*#[[:space:]]*test-quality-ok:' "$f" 2>/dev/null || true)"
  if [ -n "$okline" ]; then
    if grep -qiE 'exit|UNKNOWN|honest|fixture|offline|never-quiet|never quiet|rc[ =:]*2|stand-?down' <<<"$okline"; then
      echo "SKIP test-quality-ok: $f — ${okline#*: }"
      return 2
    fi
    echo "HOLD vacuous: $f — test-quality-ok justification names no honest-exit behavior"
    return 1
  fi
  # No --test arm → SKIP rc 2.
  grep -q -- '--test' "$f" 2>/dev/null || { echo "SKIP no-test-arm: $f"; return 2; }
  local block
  block="$(extract_test_block "$f")"
  [ -n "$block" ] || { echo "SKIP no-test-arm: $f"; return 2; }
  # Strip dep-presence-only lines is NOT needed: instead require a driving signal.
  local base short
  base="$(basename "$f")"
  short="${base#mesh-}"; short="${short//[^a-zA-Z0-9_]/}"
  # (a) own short name as token in block
  if [ -n "$short" ] && grep -qw -- "$short" <<<"$block"; then
    echo "PASS: $f (own-name token '$short')"
    return 0
  fi
  # also full base name
  if grep -qF -- "$base" <<<"$block"; then
    echo "PASS: $f (own-name token '$base')"
    return 0
  fi
  # (b) invocation of a locally-defined function
  local fn
  while IFS= read -r fn; do
    [ -n "$fn" ] || continue
    case "$fn" in gate_one|extract_test_block|usage|main) continue;; esac
    if grep -qw -- "$fn" <<<"$block"; then
      echo "PASS: $f (invokes own function '$fn')"
      return 0
    fi
  done <<<"$(grep -oE '^[a-zA-Z_][a-zA-Z0-9_]*\(\)' "$f" 2>/dev/null | tr -d '()' | sort -u; grep -oE '^(function[[:space:]]+)[a-zA-Z_][a-zA-Z0-9_]*' "$f" 2>/dev/null | awk '{print $2}' | sort -u)"
  # (c) fixture driving
  if grep -qiE 'tmpdir|fixture|mktemp|HOME=|MESH_[A-Z_]+_FIXTURE|unshare|stub|unshare|fake|hermetic' <<<"$block"; then
    echo "PASS: $f (fixture-driven)"
    return 0
  fi
  # (d) assertion on tool output: grep -q on captured output, or [ ] on result var
  if grep -qE 'grep[[:space:]].*-q' <<<"$block" && grep -qE '\$[a-zA-Z_][a-zA-Z0-9_]*|\$\(|<<<\s*\$' <<<"$block"; then
    echo "PASS: $f (asserts on captured output)"
    return 0
  fi
  if grep -qE '\[[[:space:]]+\$|\btest[[:space:]]+\$' <<<"$block" && grep -qE '\$(_rt|out|rc|r|result|got|have|actual|val|res)\b|\brc\b|\bresult\b' <<<"$block"; then
    echo "PASS: $f (asserts on result var)"
    return 0
  fi
  echo "HOLD vacuous: $f — --test asserts dependency presence only (command -v / [ -x ]), never drives the tool"
  return 1
}

extract_test_block(){
  # Print text between the --test dispatch line and its terminating exit/fi-terminator.
  # Heuristic: start at first line matching --test; end at first subsequent line
  # matching ^\s*(exit|fi\b) — bounded to 60 lines to stay deterministic.
  awk '
    !started && ((/= --test/ || /= "--test/) && (/&&/ || /then/)) { started=1; next }
    !started && /^[[:space:]]*--test\)/ { started=1; next }
    started {
      print
      if (++n >= 60) exit
      if ($0 ~ /^[[:space:]]*(exit|fi\b)/) exit
    }
  ' "$1"
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  pass=0; fail=0
  # Vacuous sample (mirrors mesh-nudge lines 41-49 shape: command -v + base64 round-trip on deps only).
  # NOTE: base64 round-trip tests the *dependency*, not the tool — no own-name,
  # no own-function, no fixture, no output assertion on tool output → vacuous.
  cat > "$d/vacuous.sh" <<'EOF'
#!/usr/bin/env bash
[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v base64 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no base64)"; exit 1; }
  echo "smoke-test: ok (tmux+base64 present)"
  exit 0
}
EOF
  # Driving sample: defines + invokes own function with fixture.
  cat > "$d/mesh-demo-driving" <<'EOF'
#!/usr/bin/env bash
demo_classify(){ [ "$1" = good ] && echo OK || echo BAD; }
[ "${1:-}" = --test ] && {
  d="$(mktemp -d)"; echo good > "$d/fixture"
  out="$(demo_classify "$(cat "$d/fixture")")"
  [ "$out" = OK ] || { echo "FAIL: got=$out"; exit 1; }
  echo "mesh-demo-driving --test: PASS"
  exit 0
}
EOF
  # No-test file.
  printf '#!/usr/bin/env bash\necho hi\n' > "$d/plain.sh"
  # test-quality-ok file (honest-exit offline fixtures).
  cat > "$d/mesh-offline-fx" <<'EOF'
#!/usr/bin/env bash
# test-quality-ok: offline fixtures render UNKNOWN-never-quiet, exit 2 when sensor absent (honest-exit)
[ "${1:-}" = --test ] && { echo "fixture: UNKNOWN (sensor absent)"; exit 2; }
EOF
  out="$(gate_one "$d/vacuous.sh" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'HOLD vacuous' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: vacuous must HOLD (rc=$rc: $out)"; fail=$((fail+1)); }
  out="$(gate_one "$d/mesh-demo-driving" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && grep -q '^PASS' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: driving must PASS (rc=$rc: $out)"; fail=$((fail+1)); }
  gate_one "$d/plain.sh" >/dev/null 2>&1; [ $? = 2 ] && pass=$((pass+1)) || { echo "FAIL: no-test must SKIP rc=2"; fail=$((fail+1)); }
  out="$(gate_one "$d/mesh-offline-fx" 2>&1)"; rc=$?
  { [ "$rc" = 2 ] && grep -q '^SKIP test-quality-ok' <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: test-quality-ok must SKIP (rc=$rc: $out)"; fail=$((fail+1)); }
  echo "mesh-test-quality-gate --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

[ "${1:-}" = --tool ] || { echo "usage: mesh-test-quality-gate --tool <path> | --test" >&2; exit 2; }
[ -n "${2:-}" ] || { echo "usage: mesh-test-quality-gate --tool <path> | --test" >&2; exit 2; }
gate_one "$2"; exit $?
