#!/usr/bin/env bash
# mesh-activity — local 3-sense fusion: ambient sound + room occupancy + BLE bodies in range
# Answers: is this space actively being used right now?
#
# Usage:
#   mesh-activity              one-shot verdict to stdout (LIVE: mic read + BLE scan)
#   mesh-activity --edge       only emit when the verdict changes; reads CACHED artifacts, NEVER scans
#   mesh-activity --json       machine-readable JSON
#   mesh-activity --from-cache force the reuse path (cached artifacts, no device driven)
#   mesh-activity --live       force the live path (mic + radio)
#   mesh-activity --test       smoke test (hermetic: temp state dir, no device, no real log)
#
# TWO SOURCES, and which one a mode takes is deliberate.
#   --edge is the CRON-facing mode and it must drive NOTHING. On this node the BLE half is the
#   btusb side of the same 0bda:b82c combo device that carries the SOLE uplink, and it wedges;
#   the mic is contended by the room ear (mesh-overhear holds the capture device). Both signals
#   ALREADY have producers on their own cadence:
#       ambient  ← ~/.mesh/.ambient-level     (mesh-ambient-level, refreshed by mesh-ambient-tape */2)
#       room     ← ~/.mesh/.room-sense.state  (mesh-room-sense --edge, 2-59/5, liveness-touched)
#       devices  ← ~/.mesh/presence.log       (mesh-presence --log, */10)
#   so a cadence here that read the hardware would be a second scan on wedged silicon and a
#   second mic grab, for readings that already exist on disk ("a real hardware test leg is an
#   attack when the device is wedged"). The operator's on-demand read still goes live.
#
# THE LEASES — each must EXCEED its producer's cadence, never fall under it.
#   A reused artifact is only a measurement while it is fresh, so every axis refuses a stale one
#   (UNKNOWN, naming the age and the lease) instead of reporting an hours-old word as now. A
#   sub-cadence lease is unsatisfiable by construction — it expires at the end of every healthy
#   cycle and renders a live feeder as a dead one (the mesh-bruno LEASE_WIFI=600 trap). Hence
#   ambient 600s > 120s, room 900s > 300s, devices 900s > 600s (the last is not a new number:
#   mesh-sensorium already defines "presence.log is fresh" as <900s).
#
# RE-READING THE SAME SNAPSHOT IS NOT A SECOND SAMPLE.
#   --edge confirms a change over EDGE_WINDOW consecutive samples. Reading a cached artifact
#   faster than its producer rewrites it would let one snapshot satisfy the whole debounce by
#   itself — a fabricated confirmation. The pending record therefore carries the presence line's
#   epoch and the count advances only when that epoch MOVES.
#
# UNREACHABLE ≠ QUIET — the fault this file used to carry.
#   The old fusion listed UNKNOWN alongside SILENCE/QUIET in both the IDLE and the AMBIENT
#   branch, so a dead mic rendered `AMBIENT — quiet + room present`: a loudness nobody measured,
#   spelled in the vocabulary of a real reading, on the one axis this tool exists to report.
#   The sound axis IS the activity gradient; without it the verdict is UNCERTAIN with the
#   missing axis NAMED, never a quiet-shaped all-clear.
#
# THE DEVICE COUNT IS ROWS, NOT LINES.
#   The old BLE leg counted `grep -cE '[a-zA-Z]{2,}'` over mesh-presence's whole stdout — which
#   is a human report: a `=== mesh-presence <host> @ <ts> ===` banner, the rows, a `---`, and an
#   `inventory: N devices` summary. Two of those match, so the count was ≥2 with zero devices
#   present: `devices=0` was unreachable, IDLE with it, and every "N devices" in a reason string
#   was counting report lines. Both paths now parse the SAME `rssi|mac|name` row mesh-presence
#   renders (its stdout rows and its log's devices=[...] field are the same shape), and a row
#   that is present but unparseable renders UNKNOWN — loud — never a zero.
#
# Signals:
#   ambient (mic):        SILENCE / QUIET / MODERATE / LOUD    (UNKNOWN = unreachable)
#   room (room-sense):    PRESENT / EMPTY / UNCERTAIN          (UNKNOWN = unreachable/OFFLINE)
#   devices (BLE):        count of bodies at rssi >= -70       (UNKNOWN = unreachable/drift)
#
# Fusion — 5-level activity gradient:
#   IDLE      = quiet + room empty + no devices in range
#   AMBIENT   = quiet + (room present OR devices in range)   (TV/AC on, nobody active)
#   MODERATE  = ambient MODERATE + (room present OR devices in range)
#   ACTIVE    = ambient LOUD + (room present OR devices in range)
#   UNCERTAIN = signals conflict, or an axis needed for the verdict is unreachable
#
# WHAT THE DEVICE AXIS IS WORTH HERE, measured — not assumed.
#   -70 is mesh-presence's own NEAR band edge ("same room, reachable"). Over the last 300
#   presence snapshots on this node the NEAR count ran 0–4 (0 in 6 of 300, median 2), so as a
#   BOOLEAN the axis is near-constant and IDLE is correspondingly rare — the information in the
#   verdict comes from ambient and room. Do not read a missing IDLE as a broken fusion, and do
#   not quote these figures as constants: presence.log is a pruned sliding window, so re-derive
#   them from it rather than trusting this line.
#
# Exit codes:
#   0 = verdict assessed (may be UNCERTAIN — a partial read is still a reading)
#   2 = cannot assess at all (every signal unreachable)
#
# reflex-cadence: 6-59/10 * * * *
# reflex-state: $HOME/.mesh/.activity.state
# reflex-args: --edge
# Paced to mesh-presence's own */10 (the slowest producer) and offset +6min so each run reads a
# line that landed this cycle, clear of mesh-proximity's +4. This is the ONLY writer of
# ~/.mesh/.activity.state, which mesh-room-trace and mesh-social-fusion both read; with no
# writer that axis was permanently absent and both fusions rendered it UNKNOWN forever.
# It costs no radio and no mic time: see the two-sources note above.

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.activity.state"
PENDING="$STATE_DIR/.activity.pending"
PRESENCE_LOG="${MESH_PRESENCE_LOG:-$STATE_DIR/presence.log}"
AMBIENT_STATE="$STATE_DIR/.ambient-level"
ROOM_STATE="$STATE_DIR/.room-sense.state"

# Leases — see the header. Each must exceed its producer's cadence.
PRESENCE_LEASE_S="${MESH_ACTIVITY_PRESENCE_LEASE_S:-900}"   # mesh-presence   */10 = 600s
AMBIENT_LEASE_S="${MESH_ACTIVITY_AMBIENT_LEASE_S:-600}"     # mesh-ambient-tape */2 = 120s
ROOM_LEASE_S="${MESH_ACTIVITY_ROOM_LEASE_S:-900}"           # mesh-room-sense  */5 = 300s

# mesh-presence's NEAR band edge — "same room, reachable".
BODY_RSSI_MIN="${MESH_ACTIVITY_BODY_RSSI_MIN:--70}"

MODE="oneshot"
SOURCE=""          # "" = pick from MODE; else "cache" | "live"
SRC_EPOCH=""       # epoch of the reused presence line (empty on the live path)
EDGE_WINDOW=2

for arg in "$@"; do
  case "$arg" in
    --edge) MODE=edge ;;
    --json) MODE=json ;;
    --test) MODE=test ;;
    --from-cache) SOURCE=cache ;;
    --live|--scan) SOURCE=live ;;
  esac
done

# Mode default, applied only where the operator did not say: --edge is the cron mode and must
# not touch a device; every other mode is an operator asking for a reading NOW.
if [ -z "$SOURCE" ]; then
  case "$MODE" in
    edge) SOURCE=cache ;;
    *)    SOURCE=live ;;
  esac
fi

[ "$MODE" = test ] || mkdir -p "$STATE_DIR"

# --- Fusion engine ---
# am ∈ SILENCE|QUIET|MODERATE|LOUD|UNKNOWN · rm ∈ PRESENT|EMPTY|UNCERTAIN|UNKNOWN
# dv ∈ <integer>|UNKNOWN   (0 is a real reading: the radio looked and saw nobody in range)
_fuse() {
  local am="$1" rm="$2" dv="$3" unreach="" quiet=0 level=""

  [ "$am" = UNKNOWN ] && unreach="ambient"
  [ "$rm" = UNKNOWN ] && unreach="${unreach:+$unreach,}room"
  [ "$dv" = UNKNOWN ] && unreach="${unreach:+$unreach,}devices"

  if [ "$am" = UNKNOWN ] && [ "$rm" = UNKNOWN ] && [ "$dv" = UNKNOWN ]; then
    verdict="UNCERTAIN"; reason="all signals unreachable [unreachable:$unreach]"; return 2
  fi

  # The sound axis IS the gradient. Without it every verdict below asserts a loudness nobody
  # measured, so it is UNCERTAIN with the gap named — never the quiet-shaped all-clear the old
  # code emitted by listing UNKNOWN beside SILENCE/QUIET.
  if [ "$am" = UNKNOWN ]; then
    verdict="UNCERTAIN"
    reason="sound axis unreachable — activity level unassessable [unreachable:$unreach] room=$rm devices=$dv"
    return 0
  fi

  case "$am" in SILENCE|QUIET) quiet=1 ;; MODERATE) level=MODERATE ;; LOUD) level=ACTIVE ;; esac

  if [ "$quiet" = 1 ]; then
    if [ "$rm" = PRESENT ]; then
      verdict="AMBIENT"; reason="ambient $am + room present"; return 0
    fi
    if [ "$dv" != UNKNOWN ] && [ "$dv" -gt 0 ] 2>/dev/null; then
      verdict="AMBIENT"; reason="ambient $am + $dv device(s) in range"; return 0
    fi
    if [ "$rm" = EMPTY ] && [ "$dv" = 0 ]; then
      verdict="IDLE"; reason="ambient $am + room empty + no devices in range"; return 0
    fi
    verdict="UNCERTAIN"
    reason="ambient $am but occupancy unresolved [unreachable:${unreach:-none}] room=$rm devices=$dv"
    return 0
  fi

  if [ "$rm" = PRESENT ]; then
    verdict="$level"; reason="ambient $am + room present"; return 0
  fi
  if [ "$dv" != UNKNOWN ] && [ "$dv" -gt 0 ] 2>/dev/null; then
    verdict="$level"; reason="ambient $am + $dv device(s) in range"; return 0
  fi

  verdict="UNCERTAIN"; reason="mixed: ambient=$am room=$rm devices=$dv"; return 0
}

# --- Presence row parsing (shared by BOTH paths) ---
# mesh-presence renders one device per line as  rssi|mac|name  (name is '?' when unnamed) — the
# same shape in its stdout rows and inside its log's devices=[...] field.
parse_presence_row() {
  local line="$1" f1 f2 f3 rest
  case "$line" in *'|'*) : ;; *) return 1 ;; esac
  f1="${line%%|*}"; rest="${line#*|}"
  f2="${rest%%|*}"; f3="${rest#*|}"
  [[ "$f1" =~ ^-[0-9]+$ ]] || return 1
  [[ "$f2" =~ ^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$ ]] || return 1
  p_rssi="$f1"; p_mac="$f2"; p_name="$f3"
  return 0
}

# A line carrying a MAC is a device row in ANY plausible format — that is what makes it the
# drift detector: it counts rows the parser OUGHT to have consumed, independent of field order.
row_looks_like_device() {
  [[ "$1" =~ [0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5} ]]
}

# The devices=[...] field is SPACE-joined and names contain spaces ("LE-Bose Revolve SoundLink"),
# so the only safe row boundary is the START of the next row: ` -<rssi>|<MAC>|`.
expand_devices_field() {
  printf '%s' "$1" | sed -E 's/ (-[0-9]+\|[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}\|)/\n\1/g'
}

# Reads $ble_out; sets devices (int|UNKNOWN), dev_seen, dev_parsed, dev_why.
count_bodies() {
  local line rows=0 parsed=0 near=0
  dev_why=""
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    row_looks_like_device "$line" || continue
    rows=$((rows + 1))
    p_rssi=""; p_mac=""; p_name=""
    parse_presence_row "$line" || continue
    parsed=$((parsed + 1))
    [ "$p_rssi" -ge "$BODY_RSSI_MIN" ] 2>/dev/null && near=$((near + 1))
  done <<< "$ble_out"
  dev_seen="$rows"; dev_parsed="$parsed"
  if [ "$rows" -gt 0 ] && [ "$parsed" = 0 ]; then
    devices="UNKNOWN"
    dev_why="$rows device row(s) present, none parsed — mesh-presence format drift"
    return 1
  fi
  devices="$near"
  return 0
}

# --- Cached reads (the cron path drives NO device) ---
_state_age() {
  local f="$1" m
  [ -f "$f" ] || return 1
  m="$(stat -c %Y "$f" 2>/dev/null)" || return 1
  case "$m" in ''|*[!0-9]*) return 1 ;; esac
  echo $(( $(date +%s) - m ))
}

read_ambient_cache() {
  local age line
  ambient="UNKNOWN"; ambient_src="cache"; ambient_why=""
  if ! age="$(_state_age "$AMBIENT_STATE")"; then
    ambient_why="no $AMBIENT_STATE — mesh-ambient-level has never landed one"; return
  fi
  if [ "$age" -gt "$AMBIENT_LEASE_S" ]; then
    ambient_why="ambient state ${age}s old (lease ${AMBIENT_LEASE_S}s) — mic cadence not landing"; return
  fi
  line="$(head -1 "$AMBIENT_STATE" 2>/dev/null | cut -d'|' -f1 | tr -d '[:space:]')"
  case "$line" in
    SILENCE|QUIET|MODERATE|LOUD) ambient="$line" ;;
    *) ambient_why="unparseable ambient token '$line'" ;;
  esac
}

read_ambient_live() {
  local out=""
  ambient="UNKNOWN"; ambient_src="live"; ambient_why=""
  if ! command -v mesh-ambient-level >/dev/null 2>&1; then
    ambient_why="mesh-ambient-level not found"; return
  fi
  out="$(timeout 10 mesh-ambient-level 2>/dev/null)" || true
  # Order matters: SILENCE/QUIET/MODERATE/LOUD are checked loudest-first because the reading
  # line carries only one of them; an empty read leaves UNKNOWN, never a level.
  if   printf '%s' "$out" | grep -q 'LOUD';     then ambient="LOUD"
  elif printf '%s' "$out" | grep -q 'MODERATE'; then ambient="MODERATE"
  elif printf '%s' "$out" | grep -q 'QUIET';    then ambient="QUIET"
  elif printf '%s' "$out" | grep -q 'SILENCE';  then ambient="SILENCE"
  else ambient_why="mic read produced no level token"
  fi
}

read_room() {
  local age line
  room="UNKNOWN"; room_why=""
  if ! age="$(_state_age "$ROOM_STATE")"; then
    room_why="no $ROOM_STATE — mesh-room-sense has never landed one"; return
  fi
  if [ "$age" -gt "$ROOM_LEASE_S" ]; then
    room_why="room state ${age}s old (lease ${ROOM_LEASE_S}s) — room-sense cadence not landing"; return
  fi
  # room-sense enriches as LABEL|dwell_s=N|changes_24h=N — without the cut the whole string
  # fails the vocabulary match below and the axis silently reads UNKNOWN.
  line="$(head -1 "$ROOM_STATE" 2>/dev/null | cut -d'|' -f1 | tr -d '[:space:]')"
  case "$line" in
    PRESENT|EMPTY|UNCERTAIN) room="$line" ;;
    OFFLINE) room_why="room-sense reports OFFLINE — its own inputs are down" ;;
    *) room_why="unparseable room token '$line'" ;;
  esac
}

# Sets ble_out + SRC_EPOCH, or devices=UNKNOWN with dev_why. Never scans.
read_presence_log() {
  local line ts_field epoch now age rest devs
  ble_out=""; SRC_EPOCH=""; devices="UNKNOWN"; dev_why=""; dev_seen=0; dev_parsed=0

  if [ ! -s "$PRESENCE_LOG" ]; then
    dev_why="no presence snapshot at $PRESENCE_LOG — the presence cadence has never landed one"; return 1
  fi
  # tr -d '\000': one NUL byte blinds plain grep for a whole log, and a crash-truncated append
  # can leave one. sed '/^$/d': a trailing blank line would make `tail -1` a death certificate.
  line="$(tail -40 "$PRESENCE_LOG" 2>/dev/null | tr -d '\000' | sed '/^[[:space:]]*$/d' | tail -1)"
  if [ -z "$line" ]; then
    dev_why="presence.log holds no non-blank line"; return 1
  fi

  ts_field="${line%% *}"
  epoch="$(date -u -d "$ts_field" +%s 2>/dev/null || true)"
  case "$epoch" in
    ''|*[!0-9]*) dev_why="newest presence line carries no parseable timestamp ('$ts_field') — format drift"; return 1 ;;
  esac
  now="$(date -u +%s)"
  age=$(( now - epoch ))
  if [ "$age" -gt "$PRESENCE_LEASE_S" ]; then
    dev_why="newest presence snapshot is ${age}s old (lease ${PRESENCE_LEASE_S}s) — presence cadence not landing"; return 1
  fi

  case "$line" in
    *'devices=['*) : ;;
    *)
      rest="${line#* }"; rest="${rest#* }"   # drop the ts and host fields
      dev_why="presence graded its own read degraded, no device rows: $rest"; return 1 ;;
  esac

  devs="${line#*devices=[}"
  devs="${devs%]*}"        # to the LAST ']' — a device NAME may contain one ("[TV] Samsung ...")
  SRC_EPOCH="$epoch"
  [ -n "$devs" ] && ble_out="$(expand_devices_field "$devs")"
  count_bodies || true
  return 0
}

# Live scan: mesh-presence's own stdout. An output with neither a device row nor the
# `inventory:` anchor is drift, not an empty room — UNKNOWN, never 0.
read_presence_live() {
  local rc=0
  ble_out=""; SRC_EPOCH=""; devices="UNKNOWN"; dev_why=""; dev_seen=0; dev_parsed=0
  if ! command -v mesh-presence >/dev/null 2>&1; then
    dev_why="mesh-presence not found"; return 1
  fi
  ble_out="$(timeout 25 mesh-presence 2>/dev/null)" || rc=$?
  if [ -z "$ble_out" ]; then
    dev_why="mesh-presence produced no output (rc=$rc) — BLE scan failed"; return 1
  fi
  if ! printf '%s' "$ble_out" | grep -q 'inventory:' && ! printf '%s\n' "$ble_out" | grep -qE '[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}'; then
    dev_why="mesh-presence output carries neither a device row nor an inventory line — format drift"
    return 1
  fi
  count_bodies || true
  return 0
}

# --- Edge step: 2-consecutive-sample debounce, guarded against re-reading one snapshot ---
# Pending record is `verdict:count:src_epoch`. The count advances ONLY when src_epoch moves, so
# one presence snapshot read twice cannot confirm a change by itself.
#
# THE STATE FILE IS THE BARE VERDICT WORD, and that is a contract, not a style choice:
# mesh-social-fusion matches the WHOLE line against IDLE|AMBIENT|MODERATE|ACTIVE|UNCERTAIN, so
# any `|`-enrichment (the room-sense dialect) would make every consumer read it as UNKNOWN.
edge_step() {
  local confirmed pending pcount pts
  confirmed="UNKNOWN"
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE" | awk '{print $1}')"
  pending=""; pcount=0; pts=""
  if [ -f "$PENDING" ]; then
    pending="$(head -1 "$PENDING" | cut -d: -f1)"
    pcount="$(head -1 "$PENDING" | cut -d: -f2)"
    pts="$(head -1 "$PENDING" | cut -d: -f3)"
    case "$pcount" in ''|*[!0-9]*) pcount=0 ;; esac
  fi

  if [ "$verdict" = "$confirmed" ]; then
    rm -f "$PENDING"          # a bounce back to the confirmed verdict is not a pending change
  elif [ "$verdict" = "$pending" ]; then
    if [ -n "$SRC_EPOCH" ] && [ "$SRC_EPOCH" = "$pts" ]; then
      : # same presence snapshot re-read — carries no new information, cannot confirm
    else
      pcount=$((pcount + 1))
      printf '%s:%s:%s\n' "$pending" "$pcount" "$SRC_EPOCH" > "$PENDING"
      if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
        printf '%s\n' "$verdict" > "$STATE"
        rm -f "$PENDING"
        echo "[activity] $verdict — $reason"
      fi
    fi
  else
    printf '%s:1:%s\n' "$verdict" "$SRC_EPOCH" > "$PENDING"
  fi

  # Liveness-touch: mtime means "this reflex RAN", content means "the verdict changed". Without
  # it a verdict that legitimately holds for hours freezes the mtime and reads as a dead reflex.
  # Only on a successful eval — an all-unreachable read must still go honestly stale.
  if [ "${ec:-0}" = "0" ] && [ -f "$STATE" ]; then
    command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE"
  fi
}

# --- Test mode: hermetic — temp state dir, no device driven, no real log written ---
if [ "$MODE" = "test" ]; then
  fails=0
  _t() { # _t <label> <expected-verdict> <expected-rc> <am> <rm> <dv>
    local label="$1" xv="$2" xrc="$3" rc=0
    verdict=""; reason=""
    _fuse "$4" "$5" "$6" || rc=$?
    [ "$verdict" = "$xv" ] || { echo "  FAIL: $label — verdict '$verdict', expected '$xv'"; fails=$((fails+1)); }
    [ "$rc" = "$xrc" ]     || { echo "  FAIL: $label — rc $rc, expected $xrc"; fails=$((fails+1)); }
  }

  # --- fusion table (the eight original assertions, unchanged semantics) ---
  _t 'silence+empty+0'      IDLE      0 SILENCE  EMPTY   0
  _t 'quiet+present'        AMBIENT   0 QUIET    PRESENT 0
  _t 'quiet+devices'        AMBIENT   0 QUIET    EMPTY   2
  _t 'moderate+present'     MODERATE  0 MODERATE PRESENT 0
  _t 'loud+present'         ACTIVE    0 LOUD     PRESENT 0
  _t 'moderate+devices'     MODERATE  0 MODERATE EMPTY   3
  _t 'loud+devices'         ACTIVE    0 LOUD     EMPTY   2
  _t 'sound+empty+0'        UNCERTAIN 0 LOUD     EMPTY   0

  # --- UNREACHABLE ≠ QUIET (this is the fault the file used to carry) ---
  _t 'dead-mic+present'     UNCERTAIN 0 UNKNOWN  PRESENT 0
  _t 'dead-mic+empty+0'     UNCERTAIN 0 UNKNOWN  EMPTY   0
  verdict=""; reason=""; _fuse UNKNOWN PRESENT 0 || true
  case "$reason" in
    *'unreachable:ambient'*) : ;;
    *) echo "  FAIL: a dead mic must NAME the missing axis (reason: $reason)"; fails=$((fails+1)) ;;
  esac
  case "$reason" in
    *quiet*|*QUIET*|*SILENCE*) echo "  FAIL: a dead mic must not report a loudness (reason: $reason)"; fails=$((fails+1)) ;;
  esac

  # --- 0 devices is a READING; UNKNOWN devices is not. They must not share a branch. ---
  _t 'all-unreachable'      UNCERTAIN 2 UNKNOWN  UNKNOWN UNKNOWN
  _t 'mic+room-out,dev=0'   UNCERTAIN 0 UNKNOWN  UNKNOWN 0
  _t 'quiet, dev unknown'   UNCERTAIN 0 QUIET    UNKNOWN UNKNOWN
  _t 'quiet+empty+devunk'   UNCERTAIN 0 QUIET    EMPTY   UNKNOWN

  # --- leases must exceed their producers' cadences ---
  [ "$PRESENCE_LEASE_S" -gt 600 ] || { echo "  FAIL: presence lease ${PRESENCE_LEASE_S}s must exceed mesh-presence's 600s cadence"; fails=$((fails+1)); }
  [ "$AMBIENT_LEASE_S"  -gt 120 ] || { echo "  FAIL: ambient lease ${AMBIENT_LEASE_S}s must exceed mesh-ambient-tape's 120s cadence"; fails=$((fails+1)); }
  [ "$ROOM_LEASE_S"     -gt 300 ] || { echo "  FAIL: room lease ${ROOM_LEASE_S}s must exceed mesh-room-sense's 300s cadence"; fails=$((fails+1)); }

  # --- row parsing: the REAL mesh-presence stdout shape, verbatim from a live scan ---
  ble_out=$'=== mesh-presence mesh-home @ 2026-08-17T18:47:09Z — 2 device(s) in range ===\n-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink\n-84|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)\n---\ninventory: 2 devices | strongest: LE-Bose Revolve SoundLink (-58 dBm)'
  count_bodies || true
  [ "$devices" = 1 ] || { echo "  FAIL: report lines must not count as devices (rssi>=$BODY_RSSI_MIN of 2 rows) — got devices=$devices"; fails=$((fails+1)); }
  [ "$dev_seen" = 2 ] || { echo "  FAIL: dev_seen should be 2 rows, got $dev_seen"; fails=$((fails+1)); }

  # a scan that saw nobody: banner + summary only → 0, a real reading
  ble_out=$'=== mesh-presence mesh-home ===\n---\ninventory: 0 devices'
  count_bodies || true
  [ "$devices" = 0 ] || { echo "  FAIL: an empty scan must read 0 devices, got $devices"; fails=$((fails+1)); }

  # rows present but the field order drifted → UNKNOWN and loud, never a zero
  ble_out=$'28:11:A5:B8:9E:A2|LE-Bose|-58\n5C:49:7D:92:1E:58|Samsung|-84'
  count_bodies || true
  [ "$devices" = UNKNOWN ] || { echo "  FAIL: unparseable device rows must render UNKNOWN, got $devices"; fails=$((fails+1)); }
  case "$dev_why" in *drift*) : ;; *) echo "  FAIL: row drift must say so (dev_why: $dev_why)"; fails=$((fails+1)) ;; esac

  # --- reuse path + edge debounce, driven against fixture files ---
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  STATE_DIR="$_td"; STATE="$_td/.activity.state"; PENDING="$_td/.activity.pending"
  PRESENCE_LOG="$_td/presence.log"; AMBIENT_STATE="$_td/.ambient-level"; ROOM_STATE="$_td/.room-sense.state"
  _now="$(date -u +%s)"
  _iso() { date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ'; }
  _devs='-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink -84|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)'

  printf '%s mesh-home n=2 devices=[%s] attribution=personal:1,appliance:1,ambiguous:0\n' "$(_iso $((_now - 120)))" "$_devs" > "$PRESENCE_LOG"
  read_presence_log || true
  [ "$devices" = 1 ] || { echo "  FAIL: reuse path devices=1 expected, got $devices"; fails=$((fails+1)); }
  [ "$SRC_EPOCH" = "$((_now - 120))" ] || { echo "  FAIL: SRC_EPOCH must be the reused line's epoch, got '$SRC_EPOCH'"; fails=$((fails+1)); }

  printf '%s mesh-home n=2 devices=[%s] attribution=personal:1,appliance:1,ambiguous:0\n' "$(_iso $((_now - PRESENCE_LEASE_S - 60)))" "$_devs" > "$PRESENCE_LOG"
  read_presence_log || true
  [ "$devices" = UNKNOWN ] || { echo "  FAIL: a stale presence line must render UNKNOWN, got $devices"; fails=$((fails+1)); }
  [ -z "$SRC_EPOCH" ] || { echo "  FAIL: a refused line must leave SRC_EPOCH empty, got '$SRC_EPOCH'"; fails=$((fails+1)); }

  # ambient/room leases: a stale artifact is not a reading
  printf 'LOUD\n' > "$AMBIENT_STATE"; touch -d "@$((_now - AMBIENT_LEASE_S - 60))" "$AMBIENT_STATE"
  read_ambient_cache
  [ "$ambient" = UNKNOWN ] || { echo "  FAIL: a stale ambient state must render UNKNOWN, got $ambient"; fails=$((fails+1)); }
  printf 'QUIET\n' > "$AMBIENT_STATE"; touch "$AMBIENT_STATE"
  read_ambient_cache
  [ "$ambient" = QUIET ] || { echo "  FAIL: a fresh ambient state must be read, got $ambient"; fails=$((fails+1)); }
  printf 'PRESENT|dwell_s=298|changes_24h=28\n' > "$ROOM_STATE"; touch "$ROOM_STATE"
  read_room
  [ "$room" = PRESENT ] || { echo "  FAIL: enriched room state must parse to PRESENT, got $room"; fails=$((fails+1)); }
  touch -d "@$((_now - ROOM_LEASE_S - 60))" "$ROOM_STATE"; read_room
  [ "$room" = UNKNOWN ] || { echo "  FAIL: a stale room state must render UNKNOWN, got $room"; fails=$((fails+1)); }

  # debounce: one snapshot read twice cannot confirm a change
  rm -f "$STATE" "$PENDING"
  ec=0; verdict="AMBIENT"; reason="fixture"; SRC_EPOCH="$_now"
  edge_step >/dev/null; edge_step >/dev/null
  [ ! -f "$STATE" ] || { echo "  FAIL: re-reading ONE snapshot confirmed a change (state written)"; fails=$((fails+1)); }
  SRC_EPOCH="$((_now + 600))"; _emit="$(edge_step)"
  [ -f "$STATE" ] || { echo "  FAIL: a moved snapshot epoch must confirm the change"; fails=$((fails+1)); }
  case "$_emit" in *'[activity] AMBIENT'*) : ;; *) echo "  FAIL: a confirmed change must emit the board line, got '$_emit'"; fails=$((fails+1)) ;; esac
  _rec="$(head -1 "$STATE")"
  [ "$_rec" = "AMBIENT" ] || { echo "  FAIL: state must be the BARE verdict (mesh-social-fusion matches the whole line), got '$_rec'"; fails=$((fails+1)); }

  # liveness-touch: a held verdict still moves the mtime
  touch -d '@100000' "$STATE"
  SRC_EPOCH="$((_now + 1200))"; edge_step >/dev/null
  [ "$(stat -c %Y "$STATE")" -gt 100000 ] || { echo "  FAIL: a held verdict must still liveness-touch its state"; fails=$((fails+1)); }

  # an all-unreachable eval must NOT touch (it has to be allowed to go honestly stale)
  touch -d '@100000' "$STATE"
  ec=2; verdict="UNCERTAIN"; SRC_EPOCH=""; edge_step >/dev/null
  [ "$(stat -c %Y "$STATE")" = 100000 ] || { echo "  FAIL: an ec=2 eval must not liveness-touch"; fails=$((fails+1)); }

  [ "$fails" = 0 ] || { echo "smoke-test: FAIL ($fails assertion(s))"; exit 1; }
  echo "smoke-test: ok (fusion table incl. dead-mic≠quiet and 0≠UNKNOWN devices · leases > producer cadences · row parse vs report lines · drift→UNKNOWN · reuse-path lease + SRC_EPOCH · ambient/room leases · one-snapshot debounce guard · bare-verdict state contract · liveness-touch on/off)"
  exit 0
fi

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- Signals ---
ambient="UNKNOWN"; ambient_why=""; ambient_src=""
room="UNKNOWN"; room_why=""
devices="UNKNOWN"; dev_why=""; dev_seen=0; dev_parsed=0; ble_out=""

if [ "$SOURCE" = cache ]; then
  read_ambient_cache
  read_presence_log || true
else
  read_ambient_live
  read_presence_live || true
fi
read_room     # always cached: mesh-room-sense is the only producer, there is no live mode to run

_fuse "$ambient" "$room" "$devices" && ec=$? || ec=$?

# Why an axis is missing belongs in the reading, not only in a log nobody greps.
gaps=""
[ "$ambient" = UNKNOWN ] && [ -n "$ambient_why" ] && gaps="${gaps} ambient:$ambient_why;"
[ "$room"    = UNKNOWN ] && [ -n "$room_why" ]    && gaps="${gaps} room:$room_why;"
[ "$devices" = UNKNOWN ] && [ -n "$dev_why" ]     && gaps="${gaps} devices:$dev_why;"

[ "$MODE" = "edge" ] && edge_step

case "$MODE" in
  oneshot|edge)
    printf 'activity: %s — %s [ambient=%s room=%s devices=%s src=%s]%s\n' \
      "$verdict" "$reason" "$ambient" "$room" "$devices" \
      "${SOURCE}${SRC_EPOCH:+@$SRC_EPOCH}" "${gaps:+ ·$gaps}"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","ambient":"%s","room":"%s","devices":"%s","rows_seen":%d,"source":"%s","src_epoch":"%s","ts":"%s"}\n' \
      "$verdict" "$reason" "$ambient" "$room" "$devices" "$dev_seen" "$SOURCE" "$SRC_EPOCH" "$TS"
    ;;
esac

exit ${ec:-0}
