#!/usr/bin/env bash
# reflex-cadence: 11,41 * * * *
# reflex-state: $HOME/.mesh/.model-pin.state
# mesh-model-pin — the per-window LAUNCH-MODEL census: what model each mind was actually STARTED on,
# against what the config says, so the two can disagree out loud.
#
# WHY THIS EXISTS, and it is an ALARM that did not exist rather than a fix that was missing.
# On 2026-08-30 the operator put every window on the ACCOUNT DEFAULT (restore.env, 18:42Z, after a
# hard pin killed a pane with "issue with the selected model (claude-opus-5)"). The tg window still
# relaunched `--model opus` at 20:01:26Z and he re-typed /model default by hand at every wake. The
# cause was mesh-channel-keepalive's sticky capture snapshotting the live argv, `--model` included
# (fixed df1dcc10) — but the operator's own words about it are the reason for THIS tool: "also
# important that NO alarms went off". Nothing on this mesh compared a mind's LIVE argv to the
# config. The fix stops new pins; only a sense can say a pin is standing.
#
# WHY NOTHING SAW IT, in writing, in our own source. mesh-mind-state's claude_default_model() reads
# ONE model for the whole fleet from the newest session JSONL, and its comment says why: "Every mesh
# claude mind launches via the SAME MESH_CLAUDE_CMD with no --model, so they share the account
# default → one global read is accurate for the fleet (a per-window /model override would NOT be
# reflected — acceptable: none use it)." That premise went false the day a sticky capture minted a
# per-window pin, and the instrument could not represent the disagreement: a fleet-wide scalar has no
# way to say "these two windows differ". "acceptable: none use it" was never measured, and it was
# measurable from argv the whole time — `--model` IS on the command line.
#
# WHAT IT READS. The live engine process in each mind pane, by argv. That is the LAUNCH pin only: an
# in-session `/model` typed by a human is invisible here and is NOT claimed. The launch pin is the
# one that survives a relaunch, so it is the one that recurs — and it is the one the operator kept
# fixing by hand.
#
# EXIT CODE IS ABOUT THE RUN, NEVER THE FINDING (mesh-observer-effect paid for this one: rc=1-means-
# finding made mesh-cron-catchup log a perfect pass as `outcome=failed`). 0 = the census ran ·
# 2 = it could not run (no tmux, no session) and says so. A PINNED window is reported on the board,
# in the ledger and in stdout — never in the exit code.
#
#   mesh-model-pin              census + board alert on a standing pin (the reflex form)
#   mesh-model-pin --check      census only, never posts (safe to run by hand)
#   mesh-model-pin --test       smoke test
set -u
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"
# The VERDICT tape — deliberately NOT the cron stdout log ($MESH/model-pin.log); sharing them
# double-counts the rate. Overridable because a MUTANT of this file still carries the absolute path:
# driving the "dry run writes the ledger" mutant wrote a TEST-WROTE-THIS row into the real tape on
# 2026-08-30 and it had to be deleted by hand — running a mutant from a scratch COPY does not move a
# path baked into it. Point MESH_MODEL_PIN_LEDGER at a scratch file when driving mutants.
LEDGER="${MESH_MODEL_PIN_LEDGER:-$MESH/model-pin-verdicts.log}"
STATE="$MESH/.model-pin.state"
POSTMARK="$MESH/.model-pin-posted.ts"
POST_THROTTLE="${MESH_MODEL_PIN_THROTTLE:-900}"
ts(){ date -u +%FT%TZ; }

# model_of — the model token a command line names, or empty. Handles both `--model v` and `--model=v`.
model_of(){ printf '%s' "${1:-}" | grep -oE -- '--model([= ])[^ ]+' | head -1 | sed -E 's/^--model[= ]//'; }

# pin_verdict — the WHOLE decision as one pure function, so --test can falsify every branch without a
# tmux session. $1 declared cmd · $2 live argv · $3 the RL fallback's model · $4 quota-fallback mark (1|0).
# Words, and each one has a different remedy:
#   ok                — argv and config name the same model (or neither names one)
#   PINNED            — argv names a model the config does not: the config is unwritable for this window
#   UNPINNED          — config names a model and argv does not: the window missed a deliberate pin
#   fallback          — argv is the RL fallback's model AND the quota mark is present: expected, not an alarm
#   fallback-unmarked — the RL fallback's model with NO mark: reported, because an unmarked fallback
#                       pins forever (keepalive's auto-revert keys on that mark)
#   na                — nothing to compare: no engine live, or the window is undeclared
pin_verdict(){ # $1=declared $2=live $3=rl_model $4=mark
  local d l r m dm lm
  d="${1:-}"; l="${2:-}"; r="${3:-}"; m="${4:-0}"
  [ -z "$d" ] && { printf 'na'; return; }
  [ -z "$l" ] && { printf 'na'; return; }
  dm="$(model_of "$d")"; lm="$(model_of "$l")"
  [ "$dm" = "$lm" ] && { printf 'ok'; return; }
  if [ -z "$dm" ] && [ -n "$lm" ]; then
    if [ -n "$r" ] && [ "$lm" = "$r" ]; then
      [ "$m" = 1 ] && { printf 'fallback'; return; }
      printf 'fallback-unmarked'; return
    fi
    printf 'PINNED'; return
  fi
  [ -n "$dm" ] && [ -z "$lm" ] && { printf 'UNPINNED'; return; }
  printf 'PINNED'
}

# descendants — every pid under $1 (the mind engine is a grandchild of the pane, not its child).
descendants(){ local p k; for k in $(pgrep -P "${1:-0}" 2>/dev/null); do printf '%s\n' "$k"; descendants "$k"; done; }

# live_engine_argv — the argv of the engine running in a pane, or empty if the pane is a bare shell.
live_engine_argv(){ # $1 = pane target
  local pp p a
  pp="$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null)" || return 0
  [ -z "$pp" ] && return 0
  for p in "$pp" $(descendants "$pp"); do
    a="$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)"
    case "$a" in
      *bin/claude*|*bin/opencode*|*bin/codex*|*bin/gemini*) printf '%s' "$a"; return 0 ;;
    esac
  done
  return 0
}

# declared_cmd_for — the config's own word for this window, and NOTHING else. Deliberately no copy of
# keepalive's engine table: a second copy of a declaration drifts the day a member is added, and an
# undeclared window renders `na` with its name printed rather than being folded into the clean count.
declared_cmd_for(){ # $1 = window
  local v; v="MESH_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')_CMD"
  eval "printf '%s' \"\${$v:-}\""
}

# census — sets ROWS (the printable table) and the COV_/*_WINS globals. It must NOT be called in a
# command substitution: `$(census)` runs it in a subshell and every global it sets dies there, which
# is exactly how the first draft reported coverage 0/0 beside a correct table. Call it, then read ROWS.
# ── SECOND LEG: THE REFUSED TURN ──────────────────────────────────────────────────────────────────
# The argv census above catches a LAUNCH pin. It is blind to the fault the operator hit next and it
# says so: a session whose model is refused mid-life carries NOTHING on its command line. Measured
# 2026-08-30, 73 turns across 17 sessions in four hours, still firing at 22:30:35Z, every one of them
# "There's an issue with the selected model (claude-opus-5[1m]). It may not exist or you may not have
# access to it." A refused turn LOOKS like a completed turn from outside: the pane returns to its
# prompt, the process is alive, mesh-mind-state reads IDLE, keepalive reads a healthy mind. The wake
# is spent and nothing is produced — a hollow organ running cron-green, and no reflex on this mesh
# could see it, which is the operator's whole complaint ("NO alarms went off").
#
# IT IS NOT THE EGRESS, and that mattered enough to measure rather than assume: mesh-revive's exit-node
# flips stopped at 21:22Z while refusals continued through 22:30Z, so the drop-to-RU-egress theory (405
# through phaedra vs 403 direct) is REFUTED for this fault. The bursts are simultaneous across windows
# (5 in one minute at 21:38Z, 5 at 22:14Z), which points upstream at the model alias, never at a
# per-window pin.
#
# WHY THE SESSION JSONL AND NOT THE PANE. A pane read is bounded by scrollback and cannot date an
# event; the transcript carries a timestamp per turn. The count MUST exclude `toolUseResult` entries
# or it counts its own reader: a mind that greps a pane containing the banner writes the banner into
# its own transcript, and the first draft of this counted 91 where the truth was 68.
refusals_since(){ # $1 = minutes back; prints "<count> <sessions> <last-ts|->"
  local mins="${1:-60}"
  python3 - "${MESH_MODEL_PIN_TRANSCRIPTS:-$HOME/.claude/projects}" "$mins" <<'PY_EOF' 2>/dev/null || echo "na na -"
import json,glob,os,sys,datetime
root,mins=sys.argv[1],int(sys.argv[2])
cut=datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(minutes=mins)
n=0; sess=set(); last=None
for f in glob.glob(os.path.join(root,'*','*.jsonl')):
    if os.path.getmtime(f) < cut.timestamp()-3600: continue
    for line in open(f,errors='ignore'):
        if 'issue with the selected model' not in line: continue
        try: d=json.loads(line)
        except Exception: continue
        if d.get('toolUseResult') is not None: continue          # never count our own reader
        if 'issue with the selected model' not in json.dumps(d.get('message','')): continue
        t=d.get('timestamp')
        if not t: continue
        try: ts=datetime.datetime.fromisoformat(t.replace('Z','+00:00'))
        except Exception: continue
        if ts<cut: continue
        n+=1; sess.add(os.path.basename(f)[:8]); last=t if (last is None or t>last) else last
print(n, len(sess), last or '-')
PY_EOF
}

census(){ # sets ROWS + COV_TOTAL/COV_READ/PINNED_WINS/UNPINNED_WINS/UNMARKED_WINS/NA_WINS
  local S w mp tgt live decl rl mark v dm lm
  S="$(hostname)"
  rl="$(model_of "${MESH_RL_FALLBACK_CMD:-}")"
  COV_TOTAL=0; COV_READ=0; PINNED_WINS=""; UNPINNED_WINS=""; UNMARKED_WINS=""; NA_WINS=""; ROWS=""
  for w in $(tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null); do
    mp="$(tmux list-panes -t "$S:$w" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
    [ -z "$mp" ] && continue
    tgt="$S:$w.$mp"
    COV_TOTAL=$(( COV_TOTAL + 1 ))
    decl="$(declared_cmd_for "$w")"
    live="$(live_engine_argv "$tgt")"
    [ -n "$live" ] && COV_READ=$(( COV_READ + 1 ))
    mark=0; [ -f "$MESH/.quota-fallback-$w" ] && mark=1
    v="$(pin_verdict "$decl" "$live" "$rl" "$mark")"
    dm="$(model_of "$decl")"; lm="$(model_of "$live")"
    case "$v" in
      PINNED)            PINNED_WINS="$PINNED_WINS $w" ;;
      UNPINNED)          UNPINNED_WINS="$UNPINNED_WINS $w" ;;
      fallback-unmarked) UNMARKED_WINS="$UNMARKED_WINS $w" ;;
      na)                NA_WINS="$NA_WINS $w" ;;
    esac
    ROWS="$ROWS$(printf '%-14s %-18s declared=%-10s live=%s' "$w" "$v" "${dm:--}" "${lm:--}")
"
  done
}

run(){ # $1 = post|check
  local S post="$1"
  S="$(hostname)"
  command -v tmux >/dev/null 2>&1 || { echo "mesh-model-pin: n/a (no tmux on this node — a mind census has no subject here)"; exit 2; }
  tmux has-session -t "$S" 2>/dev/null || { echo "mesh-model-pin: n/a (no tmux session '$S' — mesh-restore has not planted it; UNKNOWN, never a clean census)"; exit 2; }
  [ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null
  census
  printf '%s' "$ROWS"
  # Coverage travels WITH the verdict: a pane we could not read is not a pane running the default.
  echo "coverage: ${COV_READ}/${COV_TOTAL} panes carried a readable engine argv$( [ -n "$NA_WINS" ] && printf ' · na:%s' "$NA_WINS" )"
  mesh-state-touch "$STATE" >/dev/null 2>&1 || : > "$STATE"
  # The refused-turn leg is INDEPENDENT of the argv census and must be able to fire when every
  # window reads ok — that is exactly the state the fault was found in.
  local rf rn rs rlast
  rf="$(refusals_since "${MESH_MODEL_PIN_REFUSAL_WINDOW:-35}")"
  rn="$(printf '%s' "$rf" | awk '{print $1}')"; rs="$(printf '%s' "$rf" | awk '{print $2}')"; rlast="$(printf '%s' "$rf" | awk '{print $3}')"
  case "$rn" in
    na) echo "refusals: na (no readable transcripts — UNKNOWN, never zero)" ;;
    0)  echo "refusals: 0 in the last ${MESH_MODEL_PIN_REFUSAL_WINDOW:-35}m" ;;
    *)  echo "refusals: $rn refused turn(s) across $rs session(s) in the last ${MESH_MODEL_PIN_REFUSAL_WINDOW:-35}m, last $rlast" ;;
  esac
  local finding=""
  case "$rn" in na|0) : ;; *) finding="REFUSED:${rn}turns/${rs}sessions/last=${rlast}" ;; esac
  [ -n "$PINNED_WINS" ]   && finding="$finding PINNED:${PINNED_WINS}"
  [ -n "$UNPINNED_WINS" ] && finding="$finding UNPINNED:${UNPINNED_WINS}"
  [ -n "$UNMARKED_WINS" ] && finding="$finding fallback-unmarked:${UNMARKED_WINS}"
  if [ -z "$finding" ]; then
    echo "$(ts) CLEAN cov=${COV_READ}/${COV_TOTAL} — every readable mind's launch model agrees with the config" >> "$LEDGER"
    echo "verdict: CLEAN"
    return 0
  fi
  echo "$(ts) FINDING $finding cov=${COV_READ}/${COV_TOTAL}" >> "$LEDGER"
  echo "verdict: $finding"
  [ "$post" = check ] && return 0
  local now last=0
  now="$(date +%s)"; [ -f "$POSTMARK" ] && last="$(cat "$POSTMARK" 2>/dev/null || echo 0)"
  if [ $(( now - last )) -ge "$POST_THROTTLE" ]; then
    date +%s > "$POSTMARK"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="model-pin@$S" mesh-chat \
      "[fyi] model-pin: $finding (coverage ${COV_READ}/${COV_TOTAL} panes). The pin lives in argv, not in any file: read it with \`tr '\\0' ' ' </proc/<pid>/cmdline\`, never from the pane's env, which restore.env refreshes AFTER the launch string is fixed. A PINNED window means restore.env is unwritable for it until the engine is relaunched. A REFUSED count is a DIFFERENT fault with a different remedy: the model alias a live session already holds is being refused mid-life, argv is silent about it, and every refused turn LOOKS like a completed one from outside — the pane returns to its prompt and mesh-mind-state reads IDLE, so the wake is spent and nothing is produced. Measured 2026-08-30: NOT the egress (revive's exit-node flips stopped 21:22Z while refusals ran past 22:30Z) and NOT a per-window pin (bursts are simultaneous across windows)." >/dev/null 2>&1
  fi
  return 0
}

case "${1:-}" in
  --check) run check ;;
  --test)
    f=0
    D="/home/x/.local/bin/claude --permission-mode bypassPermissions"
    # THE LIVE FAULT, as it actually stood at 20:01:26Z on 2026-08-30.
    [ "$(pin_verdict "$D" "$D --model opus --settings /x/lean.json" sonnet 0)" = PINNED ] \
      || { echo "  FAIL: the measured fault (argv --model opus, config silent) must read PINNED"; f=1; }
    [ "$(pin_verdict "$D" "$D --model=opus" sonnet 0)" = PINNED ] \
      || { echo "  FAIL: the --model=v form must read PINNED too"; f=1; }
    [ "$(pin_verdict "$D" "$D --settings /x/lean.json" sonnet 0)" = ok ] \
      || { echo "  FAIL: both silent must read ok"; f=1; }
    [ "$(pin_verdict "$D --model sonnet" "$D --model sonnet" sonnet 0)" = ok ] \
      || { echo "  FAIL: a DECLARED pin honoured by argv must read ok"; f=1; }
    [ "$(pin_verdict "$D --model sonnet" "$D" sonnet 0)" = UNPINNED \
     ] || { echo "  FAIL: config names a model, argv does not → UNPINNED (a deliberate pin was missed)"; f=1; }
    # The RL fallback is NOT an alarm when its own mark is present, and IS reported when it is not:
    # keepalive's auto-revert keys on that mark, so an unmarked fallback pins the window forever.
    [ "$(pin_verdict "$D" "$D --model sonnet" sonnet 1)" = fallback ] \
      || { echo "  FAIL: RL fallback WITH its quota mark must read fallback, not an alarm"; f=1; }
    [ "$(pin_verdict "$D" "$D --model sonnet" sonnet 0)" = fallback-unmarked ] \
      || { echo "  FAIL: RL fallback with NO mark must be its own word, never folded into ok"; f=1; }
    # Blindness is never a clean reading: a bare-shell pane and an undeclared window are `na`, and
    # `na` is counted apart from ok in census() so the coverage line can carry them.
    [ "$(pin_verdict "$D" "" sonnet 0)" = na ] \
      || { echo "  FAIL: a pane with no live engine must be na, never ok"; f=1; }
    [ "$(pin_verdict "" "$D --model opus" sonnet 0)" = na ] \
      || { echo "  FAIL: an UNDECLARED window must be na, never PINNED against a config that says nothing"; f=1; }
    # model_of is the whole comparison; a substring reader would call `--modelfoo` a pin.
    [ "$(model_of "$D --model opus --settings x")" = opus ] || { echo "  FAIL: model_of missed the space form"; f=1; }
    [ "$(model_of "$D --model=opus")" = opus ]              || { echo "  FAIL: model_of missed the = form"; f=1; }
    [ -z "$(model_of "$D")" ]                               || { echo "  FAIL: model_of invented a model from a bare cmd"; f=1; }
    [ "$f" = 0 ] || { echo "mesh-model-pin --test: FAIL (pin_verdict drifted)"; exit 1; }
    # THE REFUSED-TURN LEG. Its one load-bearing subtlety is the toolUseResult exclusion: a mind that
    # greps a pane carrying the banner writes the banner into its OWN transcript, so a naive count
    # counts its own reader — the first draft read 91 where the truth was 68. The fixture holds one
    # REAL refusal, one tool-result echo of the identical string, and one refusal outside the window.
    _td="$(mktemp -d)" || { echo "mesh-model-pin --test: n/a (mktemp -d failed)"; exit 2; }
    mkdir -p "$_td/proj"
    _now="$(python3 -c 'import datetime;print(datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00","Z"))')"
    _old="$(python3 -c 'import datetime;print((datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(hours=6)).isoformat().replace("+00:00","Z"))')"
    python3 - "$_td/proj/s1.jsonl" "$_now" "$_old" <<'PY_FIX'
import json,sys
f,now,old=sys.argv[1],sys.argv[2],sys.argv[3]
BAN="There's an issue with the selected model (claude-opus-5[1m])."
rows=[
 {"type":"assistant","timestamp":now,"isApiErrorMessage":True,"message":{"content":[{"type":"text","text":BAN}]}},
 {"type":"user","timestamp":now,"toolUseResult":{"stdout":BAN},"message":{"content":[{"type":"text","text":BAN}]}},
 {"type":"assistant","timestamp":old,"isApiErrorMessage":True,"message":{"content":[{"type":"text","text":BAN}]}},
]
open(f,'w').write("\n".join(json.dumps(r) for r in rows)+"\n")
PY_FIX
    _r="$(MESH_MODEL_PIN_TRANSCRIPTS="$_td" refusals_since 35)"
    [ "$(printf '%s' "$_r" | awk '{print $1}')" = 1 ] \
      || { echo "  FAIL: refusals_since counted '$(printf '%s' "$_r" | awk '{print $1}')' — it must count the REAL refusal only: not the tool-result echo (that is its own reader), not the 6h-old one (outside the window)"; f=1; }
    _r0="$(MESH_MODEL_PIN_TRANSCRIPTS="$_td/empty-does-not-exist" refusals_since 35)"
    [ "$(printf '%s' "$_r0" | awk '{print $1}')" = 0 ] \
      || { echo "  FAIL: an absent transcript root must read 0 rows found, not na — the python ran fine and found nothing"; f=1; }
    rm -rf "$_td"
    [ "$f" = 0 ] || { echo "mesh-model-pin --test: FAIL (refusals_since drifted)"; exit 1; }
    echo "smoke-test: ok (refused-turn leg: the tool-result echo of the identical banner is excluded, the out-of-window turn is excluded)"

    echo "smoke-test: ok (pin_verdict: 9 arms — the measured opus fault, both flag forms, declared-pin honoured and missed, RL fallback marked vs unmarked, and two blindnesses that render na)"
    # A --test ANSWERS "IS THE CODE SOUND", never "IS THIS NODE HEALTHY": no session here is n/a, and
    # the live leg must NEVER write $LEDGER — a dry run that writes the tape a human reads for
    # liveness forges the evidence it exists to check.
    S="$(hostname)"
    if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$S" 2>/dev/null; then
      [ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null
      _lsize(){ [ -f "$LEDGER" ] && wc -c < "$LEDGER" 2>/dev/null || echo 0; }
      _before=$(_lsize)
      census
      _after=$(_lsize)
      [ "$_before" = "$_after" ] || { echo "mesh-model-pin --test: FAIL (the dry run grew the verdict ledger — it would forge its own liveness)"; exit 1; }
      [ "${COV_TOTAL:-0}" -gt 0 ] || { echo "mesh-model-pin --test: FAIL (a live session enumerated zero panes)"; exit 1; }
      echo "smoke-test: ok (live read: ${COV_READ}/${COV_TOTAL} panes carried a readable engine argv, ledger byte-count unchanged)"
    else
      echo "mesh-model-pin --test: n/a (no tmux session '$S' — the live leg has no subject; the classifier arms above still ran)"
      exit 2
    fi
    ;;
  ""|--run) run post ;;
  *) echo "usage: mesh-model-pin [--check|--test]"; exit 64 ;;
esac
