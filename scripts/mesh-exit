#!/usr/bin/env bash
# mesh-exit — reversible per-node egress flip. Roadmap item #6.
#
# A node can opt in/out of an exit-node WITHOUT touching default-string's VPN or routing.
# Always reversible: saves prior state, auto-reverts via mesh-dms unless confirmed.
# INVARIANT: NEVER run on the node that OFFERS the exit-node — that node's control plane must stay
# clean. This script operates on CONSUMER nodes. The offering node is discovered at runtime by the
# guard below ("offers exit node" in tailscale's own status), never by name: this header used to say
# "(default-string)", which was decommissioned, so the one example a reader had was of a node that no
# longer exists while the actual offerer here is phaedra. A guard bound to a name ages out; the guard
# is bound to the claim, and only this comment was stale.
#
#   mesh-exit --status                      show current exit-node and saved state
#   mesh-exit --off [--timeout 300]         drop exit-node → direct; auto-revert after timeout
#   mesh-exit --on [node-ip|hostname]       restore saved exit-node (or set explicit one)
#   mesh-exit --cancel                      cancel a pending auto-revert (confirm the flip)
#
# Safety: guards against running on the node that offers the exit-node.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; SAVE="$MESH/.exit-node-save"; DMS_PID="$MESH/.exit-dms.pid"
# THE AUTO-REVERT TIMER IS A DEAD-MAN'S SWITCH, so "is it armed" must not be a pid lottery. This node
# wraps the 4194304 pid space every 26-60 min, so `kill -0 "$(cat $DMS_PID)"` an hour after the flip
# is answered by an unrelated stranger and --status reports ARMED with nothing guarding the change.
# mesh-pidfile.sh pairs the pid with /proc field 22 (starttime) — one predicate, one site.
# THE LOCATOR MUST NOT ASSUME $HOME OR $PWD. mesh-dms runs under sudo (where $HOME is /root) and a
# tool found via PATH has $0 == the bare name (so `dirname "$0"` is "."). Resolve $0 through
# `command -v` + readlink before falling back to it.
for _mp in "${MESH_PIDFILE_LIB:-}" "$HOME/.local/bin/mesh-pidfile.sh" \
           "$(dirname "$(readlink -f "$(command -v "$0" 2>/dev/null || echo "$0")" 2>/dev/null)")/mesh-pidfile.sh"; do
  [ -n "$_mp" ] && [ -r "$_mp" ] && { . "$_mp"; break; }
done; unset _mp
command -v mesh_pidfile_alive >/dev/null 2>&1 || {
  echo "mesh-exit: mesh-pidfile.sh not found — refusing to decide 'auto-revert armed' on a recyclable pid" >&2
  exit 2; }
ts(){ date -u +%FT%TZ; }

# THE `tailscale set` ACTUATOR IS SHARED, NOT COPIED ({#80589d28}, 2026-08-30): the stderr discard was
# repaired at one call site and survived at its sibling for three days. Hard-fail rather than fall
# back to a raw call — a local copy is the drift this lib exists to delete.
for _mts in "${MESH_TS_SET_LIB:-}" "$HOME/.local/bin/mesh-ts-set.sh" \
            "$(dirname "$(readlink -f "$(command -v "$0" 2>/dev/null || echo "$0")" 2>/dev/null)")/mesh-ts-set.sh"; do
  [ -n "$_mts" ] && [ -r "$_mts" ] && { . "$_mts"; break; }
done; unset _mts
command -v ts_set >/dev/null 2>&1 || {
  echo "$(basename "$0"): mesh-ts-set.sh not found — refusing to call 'tailscale set' with a local copy that could discard the refusal" >&2
  exit 2; }
# A FOURTH DEFECT OF THE SAME FAMILY, found while fixing the other three (measured live 2026-08-30):
# `mesh-exit --status` on this node printed "100.94.116.17/32" — tailscale's TailscaleIPs entries carry
# a PREFIX LENGTH, and that CIDR string is what --off writes to $SAVE and what --on would hand back to
# `tailscale set --exit-node=`. The sibling this tool keeps failing to learn from already strips it:
# mesh-revive's exit_node_now() does `i.split("/")[0]`, and its 2026-08-27T19:00Z live drill restored
# the exit node successfully with the BARE address. So the stripped form is proven and the /32 form is
# unproven — I did not drive it, because doctrine forbids live-driving an exit-node flip from a claude
# pane on this node (the rollback rides the channel the change severs). Match the proven sibling.
current_exit_from_json(){
  python3 -c 'import json,sys
d=json.load(sys.stdin)
n=d.get("ExitNodeStatus",{})
ips=[i.split("/")[0] for i in ((n.get("TailscaleIPs") or []) if n else [])]
print(ips[0] if ips else "")'
}

if [ "${1:-}" = --test ]; then
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat > "$td/tailscale" <<'EOF'
#!/bin/sh
case "$*" in
  "status --json") cat <<'JSON'
{"ExitNodeStatus":{"TailscaleIPs":["100.64.0.2"],"Online":true}}
JSON
  ;;
  *) exit 1 ;;
esac
EOF
  chmod +x "$td/tailscale"
  parsed="$(PATH="$td:$PATH" tailscale status --json 2>/dev/null | current_exit_from_json)" \
    || { echo "smoke-test: FAIL (fixture parse failed)"; exit 1; }
  [ "$parsed" = "100.64.0.2" ] || { echo "smoke-test: FAIL (fixture parse got '$parsed')"; exit 1; }
  # tailscale's real status carries a PREFIX LENGTH on TailscaleIPs; a CIDR is not an --exit-node value.
  cidr="$(printf '%s\n' '{"ExitNodeStatus":{"TailscaleIPs":["100.94.116.17/32"],"Online":true}}' | current_exit_from_json)" \
    || { echo "smoke-test: FAIL (CIDR fixture parse failed)"; exit 1; }
  [ "$cidr" = "100.94.116.17" ] \
    || { echo "smoke-test: FAIL (a TailscaleIPs entry kept its prefix length: '$cidr' — that string lands in the save file and is handed back to the exit-node flag)"; exit 1; }
  empty="$(printf '%s\n' '{"ExitNodeStatus":{}}' | current_exit_from_json)" \
    || { echo "smoke-test: FAIL (empty-status parse failed)"; exit 1; }
  [ -z "$empty" ] || { echo "smoke-test: FAIL (empty status should parse blank, got '$empty')"; exit 1; }
  mkdir -p "$MESH" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  # ── THE ACTUATOR MUST BE ALLOWED TO SPEAK, AND A REFUSED FLIP MUST LEAVE NOTHING BEHIND ─────────
  # {#80589d28} (discover 2026-08-30, verified by health the same hour): all three `tailscale set`
  # calls here were `2>/dev/null`, so on a node where uid 1000 is denied — this one — the tool was a
  # DEAD ACTUATOR that printed "mesh-exit: tailscale set failed" with the reason in the bin. These arms
  # drive the REAL --off/--on paths through a DENYING tailscale, in a private HOME, and assert the
  # refusal text reaches the user AND that the save file does not survive an act that never happened.
  # `sudo` is stubbed too, deliberately: ts_set() falls back to `sudo -n tailscale set`, sudo resets
  # PATH to secure_path, and on a NOPASSWD node that fallback would reach the REAL tailscale and flip
  # this node's live egress from inside a smoke test.
  _xd="$td/exitfix"; mkdir -p "$_xd/bin" "$_xd/home"
  cat > "$_xd/bin/tailscale" <<'EOF'
#!/bin/sh
case "$1 $2" in
  "status --peers=false") exit 0 ;;                       # this node offers nothing
esac
case "$*" in
  "status --json") echo '{"ExitNodeStatus":{"TailscaleIPs":["100.64.0.9"],"Online":true}}'; exit 0 ;;
esac
case "$1" in
  set) if [ -f "$MESH_EXIT_TEST_DENY" ]; then
         echo "Access denied: checkprefs access denied" >&2
         echo "Use 'sudo tailscale set ...'. To not require root, use 'sudo tailscale set --operator=\$USER' once." >&2
         exit 1
       fi
       exit 0 ;;
esac
exit 0
EOF
  printf '#!/bin/sh\necho "sudo: a password is required" >&2\nexit 1\n' > "$_xd/bin/sudo"
  chmod +x "$_xd/bin/tailscale" "$_xd/bin/sudo"
  : > "$_xd/deny"
  _xd_env(){ env PATH="$_xd/bin:$PATH" HOME="$_xd/home" MESH_EXIT_TEST_DENY="$1" \
                 MESH_TS_SET_LIB="${MESH_TS_SET_LIB:-$(dirname "$(readlink -f "$0")")/mesh-ts-set.sh}" \
                 MESH_PIDFILE_LIB="${MESH_PIDFILE_LIB:-$(dirname "$(readlink -f "$0")")/mesh-pidfile.sh}" \
                 bash "$(readlink -f "$0")" "${@:2}"; }
  # ARM 1 — --off against a DENYING tailscale: the refusal text must reach the user…
  # NOT `$( )`: --off forks the auto-revert child, which INHERITS stdout, and a command substitution
  # blocks until every writer closes that fd — so capturing this would sleep for the whole timeout and
  # then read the state AFTER the revert had already cleaned it up (measured here: a 60s hang and a
  # save file the child had removed). Capture through a file; the child holding it costs nothing.
  _xd_env "$_xd/deny" --off --timeout 2 > "$_xd/out1" 2>&1; _xrc=$?; _xo="$(cat "$_xd/out1")"
  [ "$_xrc" = 1 ] || { echo "smoke-test: FAIL (--off returned $_xrc against a denying tailscale, want 1)"; exit 1; }
  printf '%s' "$_xo" | grep -qF 'checkprefs access denied' \
    || { echo "smoke-test: FAIL (--off swallowed tailscale's refusal — got '$_xo'; the reason is the whole finding)"; exit 1; }
  # …and the save must NOT survive the act that never happened, or a later bare --on reads it.
  [ ! -f "$_xd/home/.mesh/.exit-node-save" ] \
    || { echo "smoke-test: FAIL (a REFUSED --off left a populated save behind — the next --on 'restores' an exit node this node never left)"; exit 1; }
  [ ! -f "$_xd/home/.mesh/.exit-dms.pid" ] \
    || { echo "smoke-test: FAIL (a REFUSED --off armed an auto-revert for a flip that did not happen)"; exit 1; }
  # ARM 2 — CONTROL: the same path with tailscale PERMITTING must still flip, save and arm. Without
  # this arm ARM 1 passes on a tool that simply refuses everything.
  _xd_env "$_xd/absent" --off --timeout 60 > "$_xd/out2" 2>&1; _xrc2=$?; _xo2="$(cat "$_xd/out2")"
  [ "$_xrc2" = 0 ] || { echo "smoke-test: FAIL (--off returned $_xrc2 with tailscale PERMITTING — the cure broke the working path: '$_xo2')"; exit 1; }
  [ -f "$_xd/home/.mesh/.exit-node-save" ] \
    || { echo "smoke-test: FAIL (a SUCCESSFUL --off saved nothing — --on has nothing to restore)"; exit 1; }
  [ -f "$_xd/home/.mesh/.exit-dms.pid" ] \
    || { echo "smoke-test: FAIL (a SUCCESSFUL --off armed no auto-revert — the dead-man's switch is missing)"; exit 1; }
  _xd_env "$_xd/absent" --cancel >/dev/null 2>&1   # reap the 60s revert child
  # ARM 3 — --on against a DENYING tailscale names the refusal and says so in the durable log.
  echo 100.64.0.9 > "$_xd/home/.mesh/.exit-node-save"
  _xd_env "$_xd/deny" --on > "$_xd/out3" 2>&1; _xrc3=$?; _xo3="$(cat "$_xd/out3")"
  [ "$_xrc3" = 1 ] && printf '%s' "$_xo3" | grep -qF 'checkprefs access denied' \
    || { echo "smoke-test: FAIL (--on swallowed tailscale's refusal: rc=$_xrc3 '$_xo3')"; exit 1; }
  grep -qF 'ON-REFUSED' "$_xd/home/.mesh/exit.log" 2>/dev/null \
    || { echo "smoke-test: FAIL (a refused --on wrote no durable row — exit.log cannot say the actuator was denied)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

mkdir -p "$MESH"

# Guard: don't run on the offering node
if tailscale status --peers=false 2>/dev/null | grep -q 'offers exit node'; then
  echo "mesh-exit: this node OFFERS an exit-node — never flip your own egress here." >&2
  echo "  Run mesh-exit on a CONSUMER node (IdeaPad, ilya, etc.)." >&2
  exit 2
fi

current_exit(){
  tailscale status --json 2>/dev/null \
    | current_exit_from_json 2>/dev/null || echo ""
}

show_status(){
  cur=$(current_exit)
  saved=$(cat "$SAVE" 2>/dev/null || echo "(none)")
  dms_running=no
  mesh_pidfile_alive "$DMS_PID" && dms_running=yes
  echo "current exit-node : ${cur:-(direct, none)}"
  echo "saved exit-node   : $saved"
  echo "auto-revert armed : $dms_running"
}

cancel_dms(){
  if mesh_pidfile_alive "$DMS_PID"; then
    # Signal by the pid the predicate just VOUCHED for — never by a raw `cat` of the file, or a
    # cancel could TERM whatever stranger inherited the number.
    kill "$(mesh_pidfile_pid "$DMS_PID")" 2>/dev/null
    rm -f "$DMS_PID"
    echo "$(ts) auto-revert cancelled (flip confirmed)" | tee -a "$MESH/exit.log"
  fi
}

case "${1:-}" in
  --status) show_status; exit 0;;

  --off)
    timeout_sec=300
    [ "${2:-}" = "--timeout" ] && timeout_sec="${3:-300}"
    cur=$(current_exit)
    if [ -z "$cur" ]; then echo "mesh-exit: no exit-node active — already direct"; exit 0; fi
    # SAVE BEFORE THE ACT, then UNDO IT if the act was refused. Both halves matter and the second one
    # is what was missing: the write landed, `tailscale set` was DENIED, and `exit 1` fired before
    # cancel_dms and before the revert subshell ever forked — so a flip that never happened left a
    # populated save with no auto-revert armed, and a later bare `mesh-exit --on` read that stale save
    # and "restored" an exit node this node had never left. State pollution from a no-op.
    echo "$cur" > "$SAVE"
    if ! _err="$(ts_set --exit-node=)"; then
      rm -f "$SAVE"
      echo "mesh-exit: tailscale REFUSED the drop: ${_err:-(it said nothing)}" >&2
      echo "  saved state rolled back — nothing was changed, nothing is armed" >&2
      echo "$(ts) OFF-REFUSED: $cur kept; tailscale said: ${_err:-(nothing)}" >> "$MESH/exit.log"
      exit 1
    fi
    echo "$(ts) OFF: dropped exit-node $cur → direct (saved; auto-revert in ${timeout_sec}s)" \
      | tee -a "$MESH/exit.log"
    MESH_WHO="mesh-exit@$(hostname)" mesh-trace "exit-node dropped to direct (was $cur); auto-revert in ${timeout_sec}s — cancel with mesh-exit --cancel" 2>/dev/null || true
    # arm auto-revert in background
    cancel_dms
    ( sleep "$timeout_sec"
      if [ -f "$SAVE" ]; then
        saved=$(cat "$SAVE")
        # This is the DEAD-MAN'S SWITCH firing with nobody watching, so its log line is the only
        # record that will ever exist — "could not restore" with the reason discarded is the exact
        # shape that made the whole rung unreadable. Name what tailscaled said.
        if _rerr="$(ts_set --exit-node="$saved")"; then
          echo "$(ts) AUTO-REVERT: restored exit-node $saved" >> "$MESH/exit.log"
        else
          echo "$(ts) AUTO-REVERT FAILED: could not restore $saved — tailscale said: ${_rerr:-(nothing)}" >> "$MESH/exit.log"
        fi
        command -v mesh-tg >/dev/null 2>&1 && mesh-tg "⏱️ mesh-exit: auto-reverted exit-node → $saved on $(hostname)" >/dev/null 2>&1 || true
        rm -f "$SAVE"
      fi
      rm -f "$DMS_PID"
    ) &
    mesh_pidfile_write "$DMS_PID" "$!"
    echo "  To confirm (cancel revert): mesh-exit --cancel"
    echo "  To restore now:             mesh-exit --on"
    ;;

  --on)
    target="${2:-}"
    if [ -z "$target" ]; then
      target=$(cat "$SAVE" 2>/dev/null || echo "")
      [ -z "$target" ] && { echo "mesh-exit: no saved exit-node and no target given" >&2; exit 1; }
    fi
    cancel_dms
    if ! _err="$(ts_set --exit-node="$target")"; then
      echo "mesh-exit: tailscale REFUSED setting exit-node $target: ${_err:-(it said nothing)}" >&2
      echo "$(ts) ON-REFUSED: $target — tailscale said: ${_err:-(nothing)}" >> "$MESH/exit.log"
      exit 1
    fi
    echo "$(ts) ON: set exit-node → $target" | tee -a "$MESH/exit.log"
    MESH_WHO="mesh-exit@$(hostname)" mesh-trace "exit-node set → $target" 2>/dev/null || true
    rm -f "$SAVE"
    ;;

  --cancel) cancel_dms; show_status;;

  *) echo "usage: mesh-exit --status | --off [--timeout N] | --on [node] | --cancel" >&2; exit 1;;
esac
