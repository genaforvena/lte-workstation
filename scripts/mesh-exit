#!/usr/bin/env bash
# mesh-exit — reversible per-node egress flip. Roadmap item #6.
#
# A node can opt in/out of an exit-node WITHOUT touching default-string's VPN or routing.
# Always reversible: saves prior state, auto-reverts via mesh-dms unless confirmed.
# INVARIANT: NEVER run on the node that OFFERS the exit-node (default-string) — that node's
# control plane must stay clean. This script operates on CONSUMER nodes (IdeaPad, ilya, etc.).
#
#   mesh-exit --status                      show current exit-node and saved state
#   mesh-exit --off [--timeout 300]         drop exit-node → direct; auto-revert after timeout
#   mesh-exit --on [node-ip|hostname]       restore saved exit-node (or set explicit one)
#   mesh-exit --cancel                      cancel a pending auto-revert (confirm the flip)
#
# Safety: guards against running on the node that offers the exit-node.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; SAVE="$MESH/.exit-node-save"; DMS_PID="$MESH/.exit-dms.pid"
ts(){ date -u +%FT%TZ; }
current_exit_from_json(){
  python3 -c 'import json,sys
d=json.load(sys.stdin)
n=d.get("ExitNodeStatus",{})
print((n.get("TailscaleIPs") or [""])[0] if n else "")'
}

if [ "${1:-}" = --test ]; then
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat > "$td/tailscale" <<'EOF'
#!/bin/sh
case "$*" in
  "status --json") cat <<'JSON'
{"ExitNodeStatus":{"TailscaleIPs":["100.64.0.2"],"Online":true}}
JSON
  ;;
  *) exit 1 ;;
esac
EOF
  chmod +x "$td/tailscale"
  parsed="$(PATH="$td:$PATH" tailscale status --json 2>/dev/null | current_exit_from_json)" \
    || { echo "smoke-test: FAIL (fixture parse failed)"; exit 1; }
  [ "$parsed" = "100.64.0.2" ] || { echo "smoke-test: FAIL (fixture parse got '$parsed')"; exit 1; }
  empty="$(printf '%s\n' '{"ExitNodeStatus":{}}' | current_exit_from_json)" \
    || { echo "smoke-test: FAIL (empty-status parse failed)"; exit 1; }
  [ -z "$empty" ] || { echo "smoke-test: FAIL (empty status should parse blank, got '$empty')"; exit 1; }
  mkdir -p "$MESH" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

mkdir -p "$MESH"

# Guard: don't run on the offering node
if tailscale status --peers=false 2>/dev/null | grep -q 'offers exit node'; then
  echo "mesh-exit: this node OFFERS an exit-node — never flip your own egress here." >&2
  echo "  Run mesh-exit on a CONSUMER node (IdeaPad, ilya, etc.)." >&2
  exit 2
fi

current_exit(){
  tailscale status --json 2>/dev/null \
    | current_exit_from_json 2>/dev/null || echo ""
}

show_status(){
  cur=$(current_exit)
  saved=$(cat "$SAVE" 2>/dev/null || echo "(none)")
  dms_running=no
  [ -f "$DMS_PID" ] && kill -0 "$(cat "$DMS_PID")" 2>/dev/null && dms_running=yes
  echo "current exit-node : ${cur:-(direct, none)}"
  echo "saved exit-node   : $saved"
  echo "auto-revert armed : $dms_running"
}

cancel_dms(){
  if [ -f "$DMS_PID" ] && kill -0 "$(cat "$DMS_PID")" 2>/dev/null; then
    kill "$(cat "$DMS_PID")" 2>/dev/null
    rm -f "$DMS_PID"
    echo "$(ts) auto-revert cancelled (flip confirmed)" | tee -a "$MESH/exit.log"
  fi
}

case "${1:-}" in
  --status) show_status; exit 0;;

  --off)
    timeout_sec=300
    [ "${2:-}" = "--timeout" ] && timeout_sec="${3:-300}"
    cur=$(current_exit)
    if [ -z "$cur" ]; then echo "mesh-exit: no exit-node active — already direct"; exit 0; fi
    echo "$cur" > "$SAVE"
    tailscale set --exit-node= 2>/dev/null || { echo "mesh-exit: tailscale set failed" >&2; exit 1; }
    echo "$(ts) OFF: dropped exit-node $cur → direct (saved; auto-revert in ${timeout_sec}s)" \
      | tee -a "$MESH/exit.log"
    MESH_WHO="mesh-exit@$(hostname)" mesh-trace "exit-node dropped to direct (was $cur); auto-revert in ${timeout_sec}s — cancel with mesh-exit --cancel" 2>/dev/null || true
    # arm auto-revert in background
    cancel_dms
    ( sleep "$timeout_sec"
      if [ -f "$SAVE" ]; then
        saved=$(cat "$SAVE")
        tailscale set --exit-node="$saved" 2>/dev/null \
          && echo "$(ts) AUTO-REVERT: restored exit-node $saved" >> "$MESH/exit.log" \
          || echo "$(ts) AUTO-REVERT FAILED: could not restore $saved" >> "$MESH/exit.log"
        command -v mesh-tg >/dev/null 2>&1 && mesh-tg "⏱️ mesh-exit: auto-reverted exit-node → $saved on $(hostname)" >/dev/null 2>&1 || true
        rm -f "$SAVE"
      fi
      rm -f "$DMS_PID"
    ) &
    echo $! > "$DMS_PID"
    echo "  To confirm (cancel revert): mesh-exit --cancel"
    echo "  To restore now:             mesh-exit --on"
    ;;

  --on)
    target="${2:-}"
    if [ -z "$target" ]; then
      target=$(cat "$SAVE" 2>/dev/null || echo "")
      [ -z "$target" ] && { echo "mesh-exit: no saved exit-node and no target given" >&2; exit 1; }
    fi
    cancel_dms
    tailscale set --exit-node="$target" 2>/dev/null || { echo "mesh-exit: tailscale set failed" >&2; exit 1; }
    echo "$(ts) ON: set exit-node → $target" | tee -a "$MESH/exit.log"
    MESH_WHO="mesh-exit@$(hostname)" mesh-trace "exit-node set → $target" 2>/dev/null || true
    rm -f "$SAVE"
    ;;

  --cancel) cancel_dms; show_status;;

  *) echo "usage: mesh-exit --status | --off [--timeout N] | --on [node] | --cancel" >&2; exit 1;;
esac
