#!/usr/bin/env bash
# mesh-therm-watch — node-LOCAL thermal edge-trigger ([therm-hot]/[therm-cool]) + per-run log artifact.
# mesh-router-watch covers the fanless router over SSH; this covers the node it runs ON (gap found
# 2026-06-12: ds, a production box with 11 containers, hit a 91°C transient with zero thermal watch).
# Cron-wired; ~/.mesh/therm.log is the per-run artifact mesh-reflex-health can watch for staleness.
#
#   mesh-therm-watch          one check; edge-trigger above MESH_THERM_HOT (default 88°C, recover below HOT-5)
#   mesh-therm-watch --status print current mesh-therm snapshot, no alarm, no log append
#   mesh-therm-watch --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# 88°C: a WARNING band below mesh-therm's 90°C CRIT, tuned against real telemetry —
# both nodes idle-busy at 84-86°C (5 concurrent minds on the IdeaPad), so 85 fired on
# normal load; genuine thermal pressure shows as 90-96°C excursions. 88 catches those
# (and ds's earlier real 91°C) while ignoring the busy-but-fine band. With the 5°C
# hysteresis (recover <83) this kept edges to ~3/3h even before the tune.
HOT="${MESH_THERM_HOT:-88}"
STATE="$HOME/.mesh/.therm-state"
LOG="$HOME/.mesh/therm.log"

read_snapshot() {
  line="$(mesh-therm 2>/dev/null)"
  max="$(printf '%s' "$line" | grep -oE 'max=[0-9]+' | head -1 | cut -d= -f2)"
}

if [ "${1:-}" = --test ]; then
  command -v mesh-therm >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-therm)"; exit 1; }
  mesh-therm --test >/dev/null 2>&1 || { echo "smoke-test: n/a (no thermal zones on this node)"; exit 2; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  read_snapshot
  [ -n "$max" ] && [ "$max" -ge 0 ] 2>/dev/null || { echo "smoke-test: FAIL (cannot parse max= from mesh-therm: $line)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

read_snapshot
[ -n "$line" ] || { echo "mesh-therm produced nothing (not an alarm)"; exit 0; }
[ -n "$max" ] || { echo "max-temp parse failed (not an alarm): $line"; exit 0; }

if [ "${1:-}" = --status ]; then echo "$line"; exit 0; fi

mkdir -p "$HOME/.mesh"
printf '%s\n' "$line" >> "$LOG"
# cheap rotation — the artifact is recency, not history
[ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 2000 ] && { tail -1000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }

prev="$(cat "$STATE" 2>/dev/null || echo OK)"
alert(){ # MESH_ALERT_DRYRUN=1 → print, don't send (safe testing of the alarm path; learned the hard way)
         if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] would alert: $2" >&2; return; fi
         command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$1" >/dev/null 2>&1
         command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="therm@$(hostname)" mesh-chat "$2" >/dev/null 2>&1; }

if [ "$max" -gt "$HOT" ]; then
  echo HOT > "$STATE"
  [ "$prev" != HOT ] && alert "🌡 $(hostname) thermal HOT: ${max}°C (threshold ${HOT}°C) — $line" \
                              "[therm-hot] $(hostname) ${max}°C (>${HOT}°C) — $line"
  echo "therm: HOT ${max}°C"; exit 1
elif [ "$prev" = HOT ] && [ "$max" -gt $((HOT - 5)) ]; then
  # hysteresis band: still hot-ish — no re-alert, no premature recovery
  echo HOT > "$STATE"
  echo "therm: cooling ${max}°C (hysteresis, recover below $((HOT - 5))°C)"; exit 1
else
  echo OK > "$STATE"
  [ "$prev" = HOT ] && alert "✅ $(hostname) thermal recovered: ${max}°C" \
                             "[therm-cool] $(hostname) ${max}°C — recovered"
  echo "therm: ok ${max}°C"; exit 0
fi
