#!/usr/bin/env bash
# mesh-therm-watch — node-LOCAL thermal edge-trigger ([therm-hot]/[therm-cool]) + per-run log artifact.
# mesh-router-watch covers the fanless router over SSH; this covers the node it runs ON (gap found
# 2026-06-12: ds, a production box with 11 containers, hit a 91°C transient with zero thermal watch).
# Cron-wired; ~/.mesh/therm.log is the per-run artifact mesh-reflex-health can watch for staleness.
#
# reflex-cadence: */5 * * * *
# Self-wires via mesh-autowire (after --test PASS). Was documented "Cron-wired" but carried NO
# cadence header, so it never auto-wired and its .therm-state went stale (4h+, malformed "HOT 2")
# — starving mesh-stress's thermal axis on a node whose #1 failure mode IS thermal throttle
# (verify-rotation finding 2026-06-17). */5 matches the sibling edge reflexes + router-watch.
#
# ALERT DEBOUNCE (2026-06-20, chat-review cry-wolf): the IdeaPad genuinely OSCILLATES wide under mind
# load (observed 95→80→96→83→90°C in 70min = 5 hot/cool cycles); the bare 5°C hysteresis can't damp a
# swing that crosses BOTH thresholds, so every crossing fired a board/TG alert = cry-wolf. Fix: the
# real-time .therm-state stays bare HOT/OK (mesh-stress / mesh-health-state read it as the live thermal
# axis — DO NOT change that contract), but the human-facing ALERT is now gated on a SEPARATE debounce
# file (.therm-alert-state): require N consecutive reads (sustained, not a single-sample spike), a
# COOLDOWN between alert episodes (collapses an oscillation storm to one alert), with an ESCALATION
# override so a genuine climb (e.g. 96→100°C) still alarms inside the cooldown.
#
#   mesh-therm-watch          one check; edge-trigger above MESH_THERM_HOT (default 88°C, recover below HOT-5)
#   mesh-therm-watch --status print current mesh-therm snapshot, no alarm, no log append
#   mesh-therm-watch --csd    READ-ONLY critical-slowing-down assessment over therm.log (advisory; see below)
#   mesh-therm-watch --dfa    READ-ONLY DFA loss-of-complexity assessment over therm.log (advisory; see below)
#   mesh-therm-watch --test   smoke test (mesh-therm parse + synthetic debounce/cooldown + CSD + DFA instruments)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true   # weather_field (weather-consumers-phase2)
command -v weather_field >/dev/null 2>&1 || weather_field() { echo UNKNOWN; }   # lib absent → honest UNKNOWN, never a fabricated flag
# 88°C: a WARNING band below mesh-therm's 90°C CRIT, tuned against real telemetry —
# both nodes idle-busy at 84-86°C (5 concurrent minds on the IdeaPad), so 85 fired on
# normal load; genuine thermal pressure shows as 90-96°C excursions. 88 catches those
# (and ds's earlier real 91°C) while ignoring the busy-but-fine band. With the 5°C
# hysteresis (recover <83) this kept edges to ~3/3h even before the tune.
# ── SETTLING POINT vs SET POINT (Sterling, "Allostasis: a model of predictive regulation", Physiol &
# Behav 106:5, 2012; Wirtshafter & Davis, the "settling point" of body-weight regulation; homeostasis /
# allostasis / ultrastability, read-only). FOUNDATIONAL idea applied TOO LOOSELY by these thresholds.
# A SET POINT is a value a dedicated controller actively DEFENDS by error-correction (mesh-homeostasis'
# egress IP is a TRUE set-point — the VPN controller drives the public IP back to the NL target). A
# SETTLING POINT is different: an EMERGENT equilibrium where two opposing FLOWS balance, with NO
# controller and NO defended target — the value simply settles wherever production meets dissipation.
# This node's TEMPERATURE is a textbook settling point: heat PRODUCTION (concurrent minds × CPU load)
# vs heat DISSIPATION (cooling, ambient) — nothing "regulates" it to 88 or 98; it settles where the two
# flows meet (hence the chronic 84-96°C flap, ~31/24h, that no amount of hysteresis-tuning damps —
# you cannot tune the wobble out of an equilibrium that has no controller). Treating these thresholds as
# a defended boundary is set-point thinking applied to a settling-point variable, and it has two
# consequences the tuning history already shows: (1) reaction is LATE BY CONSTRUCTION — a threshold
# crossing is observed AFTER production already won (the --csd instrument below is the timing-side
# half-fix: earlier warning); (2) reacting to the TEMPERATURE re-settles right back — shedding one mind
# drops production a notch, the settling point dips, and if load returns it climbs back to the SAME band
# (the flap). The settling-point reframe is the CONTROL-side complement to --csd: you cannot hold a temp
# set-point that has no controller — you can only MOVE the settling point by changing a FLOW (cap
# concurrent-mind PRODUCTION proactively from the production⇄dissipation balance, or raise dissipation),
# not by error-correcting a boundary. DISTINCT from prior allostasis reviews: NOT mallostasis
# (set-point DRIFT over time — here there is no set-point to drift), NOT allostatic-overload-frequency
# (rising correction-rate hidden by reset — that ASSUMES a corrected set-point), NOT the ultrastability
# second-loop (regulator reorganization), NOT graded-viability. It is the prior question: is this a set
# point at all? HELD (instrument-first, behavioral): a production-flow governor that caps new-mind
# admission from the temp TREND × current mind-count (so the settling point lands below HOT), validated
# against therm.log + the autonomous-dev-thermal-shed history before gating dispatch — over-capping
# starves workers (the documented shed-starvation harm). Same instrument-before-actuator discipline as
# the --csd land. Source: ~/.mesh/knowledge/review-settling-point-vs-set-point-mesh-therm-watch-2026-06-21.md
HOT="${MESH_THERM_HOT:-88}"
HOT_N="${MESH_THERM_HOT_N:-2}"          # consecutive >HOT reads before [therm-hot] (debounce single spikes; */5 → ≥10min sustained)
COOL_N="${MESH_THERM_COOL_N:-2}"        # consecutive recovered reads before [therm-cool] (no premature "recovered")
COOLDOWN="${MESH_THERM_COOLDOWN:-1800}" # min seconds between hot alert EPISODES (collapses an oscillation storm)
ESCALATE="${MESH_THERM_ESCALATE:-4}"    # re-alert inside cooldown only if max climbs ≥ this above the last alert (genuine worsening)
CRIT="${MESH_THERM_CRIT:-98}"           # ≥ this = near the 100-102°C shutdown ceiling → operator-worthy (TG+board)
# TIER an episode: only a near-shutdown (≥CRIT) is worth the operator's TG + the coordination board.
# Routine HOT episodes (88-97°C) are this node's chronic throttle-flap (~31/24h) — they go to mesh-trace
# (durable history) ONLY, so they stop spamming the operator's Telegram and drowning the board. The
# .therm-state HOT/OK consumer contract (mesh-stress/health) is UNCHANGED — only the human-facing
# notification is re-tiered; mesh-tick reads sysfs temp directly + mesh-criticality classes the markers
# meta, so neither consumer regresses.
therm_tier(){ [ "${1:-0}" -ge "$CRIT" ] 2>/dev/null && echo board || echo trace; }

# MORNING PREEMPTIVE TIER (weather-consumers-phase2, 2026-07-07, capability-weather-thermal-forecast-
# 20260705.md): every defense above is REACTIVE — it fires only once the CURRENT read crosses HOT.
# mesh-weather forecasts a thermal_day (today_max_c ≥ its own threshold) hours before the actual 15:00-
# ish peak. On a forecast thermal day, LOWER the effective HOT threshold in the MORNING (before
# peak_hour) so the sustained-N debounce + edge-alert have a head start — shed/offload decisions land
# BEFORE the peak, not during it, when they're too late to prevent the excursion they're reacting to.
# Deliberately NOT active once the peak hour has started (task spec: "before the peak, not during") —
# by then the ordinary reactive tiers are already the right tool, and holding the tightened threshold
# past the peak would just add spurious extra HOT edges to an already-hot afternoon.
# Honest-fusion: weather_field renders UNKNOWN on an absent/stale sense — that means NO shift (the
# unmodified, always-been-there HOT threshold), never a fabricated "it's a thermal day" assumption.
MORNING_SHIFT_C="${MESH_THERM_MORNING_SHIFT:-5}"   # °C the HOT threshold drops during a forecast morning
# morning_preempt_shift [state-file] [hour-override] → the two optional args exist so --test can
# drive this deterministically (real wall-clock hour + real state file when called with no args).
morning_preempt_shift() {
  local wf="${1:-}" hr="${2:-$(date +%-H)}"
  [ "$(weather_field thermal_day "$wf")" = 1 ] || { echo 0; return; }
  local ph; ph="$(weather_field peak_hour "$wf")"
  case "$ph" in ''|*[!0-9]*) ph=15;; esac        # UNKNOWN/malformed peak_hour → default to the doc's 15:00 peak
  [ "$hr" -lt "$ph" ] && echo "$MORNING_SHIFT_C" || echo 0
}
STATE="${MESH_THERM_STATE:-$HOME/.mesh/.therm-state}"             # bare HOT/OK — CONSUMER CONTRACT (mesh-stress/health-state)
ALERT_STATE="${MESH_THERM_ALERT_STATE:-$HOME/.mesh/.therm-alert-state}" # debounce/cooldown bookkeeping (this tool only)
LOG="$HOME/.mesh/therm.log"
line=""; max=""

read_snapshot() {
  line="$(mesh-therm 2>/dev/null)"
  max="$(printf '%s' "$line" | grep -oE 'max=[0-9]+' | head -1 | cut -d= -f2)"
}

# THROTTLE GROUND-TRUTH (LITERATURE-adjacent capability find, discover 2026-07-04:
# knowledge/capability-cpu-throttle-counter-20260704.md). Everything above infers throttling from
# TEMPERATURE crossing a tuned threshold (88°C WARN / 90°C CRIT + debounce) — an inference: a chip can
# throttle below 88°C under sustained VRM/power-limit pressure, or sit at 89°C without ever actually
# throttling. The kernel/microcode PROCHOT counters at
# /sys/devices/system/cpu/cpu*/thermal_throttle/package_throttle_{count,total_time_ms} are HARDWARE-
# REPORTED, monotonic since boot, zero-cost (sysfs, no probe) — ground truth: the counter only moves
# when the CPU itself clamped frequency. Each logical CPU exposes its OWN read of the shared PACKAGE-
# level counter (verified live: 8 CPUs report package_throttle_total_time_ms within ~250ms of each
# other, read-time skew only, same underlying event) — MAX across CPUs is the correct aggregate; SUMMING
# would multiply-count one shared event by the CPU count. A second, ORTHOGONAL signal (spec's own
# framing): appended to the existing $line/log/alert artifact for a consumer (mesh-stress thermal axis)
# to cross-check against — does NOT touch therm_decide()'s temp-threshold verdict or the .therm-state
# HOT/OK consumer contract (unchanged, per the ALERT DEBOUNCE header above). Glob is env-overridable so
# --test can point it at a fixture directory instead of the real sysfs tree.
THROTTLE_GLOB="${MESH_THERM_THROTTLE_GLOB:-/sys/devices/system/cpu/cpu*/thermal_throttle/package_throttle_total_time_ms}"
THROTTLE_STATE="${MESH_THERM_THROTTLE_STATE:-$HOME/.mesh/.therm-throttle-state}"
throttle_ms=""; throttle_count=""; throttle_ms_delta=""; throttle_events_delta=""

read_throttle() { # sets throttle_ms/throttle_count (current absolute, MAX across CPUs); "" if unreadable
  local f v cf vc max_ms="" max_ct=""
  for f in $THROTTLE_GLOB; do
    [ -r "$f" ] || continue
    v="$(cat "$f" 2>/dev/null)"; case "$v" in ''|*[!0-9]*) continue ;; esac
    if [ -z "$max_ms" ] || [ "$v" -gt "$max_ms" ]; then max_ms="$v"; fi
    cf="${f%_total_time_ms}_count"
    vc="$(cat "$cf" 2>/dev/null)"; case "$vc" in ''|*[!0-9]*) continue ;; esac
    if [ -z "$max_ct" ] || [ "$vc" -gt "$max_ct" ]; then max_ct="$vc"; fi
  done
  throttle_ms="$max_ms"; throttle_count="$max_ct"
}

# compute_throttle_delta: diffs the current absolute counters (read_throttle) against the prior sample
# in THROTTLE_STATE, sets throttle_ms_delta/throttle_events_delta, persists the new absolute baseline.
# A prior sample HIGHER than the current one means the counter reset (reboot) — treat as a fresh
# baseline (delta=0) rather than a bogus negative delta. Unreadable sysfs (no throttle_ms) leaves both
# deltas empty, never a fake 0 (distinct from "read fine, zero events this interval").
compute_throttle_delta() {
  [ -n "$throttle_ms" ] || return 0
  local prev_ms="" prev_ct=""
  [ -r "$THROTTLE_STATE" ] && read -r prev_ms prev_ct < "$THROTTLE_STATE" 2>/dev/null
  if [ -n "$prev_ms" ] && [ "$throttle_ms" -ge "$prev_ms" ] 2>/dev/null; then
    throttle_ms_delta=$((throttle_ms - prev_ms))
  else
    throttle_ms_delta=0
  fi
  if [ -n "$prev_ct" ] && [ "$throttle_count" -ge "$prev_ct" ] 2>/dev/null; then
    throttle_events_delta=$((throttle_count - prev_ct))
  else
    throttle_events_delta=0
  fi
  printf '%s %s\n' "$throttle_ms" "$throttle_count" > "$THROTTLE_STATE" 2>/dev/null
}

# FIRMWARE THERMAL-TRIP HEADROOM (discover 2026-07-11, health-CONFIRMED; knowledge/
# capability-thermal-trip-headroom-20260711.md). Every thermal_zone that declares a REAL firmware
# trip table (trip_point_N_type=critical|hot + a plausible _temp) publishes the machine's OWN
# emergency ceiling + active-cooling ladder — a HARDWARE-GROUNDED danger scale that self-calibrates
# per node, unlike the hand-guessed MESH_THERM_CRIT=98. Read as an ORTHOGONAL, correctly-PAIRED axis:
# headroom = (this zone's critical trip) − (this SAME zone's temp), plus the highest active-cooling
# tier currently breached. Appended to $line for consumers, exactly like the throttle axis.
#
# WHY CRIT=98 is deliberately NOT auto-replaced by the firmware trip (the note's core caveat): the
# HOT/CRIT path keys off mesh-therm's `max` = the hottest SENSOR (coretemp package, 96–99°C here), but
# the only zone carrying a real critical trip on IdeaPad is B0D4 (110°C) — a DIFFERENT sensor reading
# ~57°C. Feeding B0D4's 110 ceiling into the coretemp-max compare is the exact sensor-mismatch the note
# forbids (you'd never alarm a 99°C package because a cool board is 53°C from ITS ceiling). The pkg
# sensor's OWN zone (x86_pkg_temp / zone9) has UNSET trips (-274000) → no firmware ceiling for that
# sensor → the guessed 98 stays its fallback. So trip-headroom SHIPS THE SCALE (visible, self-
# calibrating, correctly paired) without regressing the alarm; a node whose pkg sensor DOES carry a
# real trip is preferred automatically below, self-calibrating only where the pairing is honest.
THERMAL_BASE="${MESH_THERM_ZONE_BASE:-/sys/class/thermal}"
TRIP_STATE="${MESH_THERM_TRIP_STATE:-$HOME/.mesh/.trip-headroom-state}"
trip_zone=""; trip_crit=""; trip_zone_temp=""; trip_headroom=""; trip_active=""

read_trip_headroom() { # sets trip_zone/crit/zone_temp/headroom/active (°C); all "" (honest n/a) if no zone declares a real trip
  trip_zone=""; trip_crit=""; trip_zone_temp=""; trip_headroom=""; trip_active=""
  local z type temp_mc tz_c crit_mc crit_c tt t ttemp a_c head active
  local pkg_zone="" pkg_crit="" pkg_ztemp="" pkg_head="" pkg_active=""
  local best_zone="" best_crit="" best_ztemp="" best_head="" best_active=""
  for z in "$THERMAL_BASE"/thermal_zone*; do
    [ -r "$z/temp" ] && [ -r "$z/type" ] || continue
    temp_mc="$(cat "$z/temp" 2>/dev/null)"; case "$temp_mc" in ''|*[!0-9-]*) continue ;; esac
    type="$(cat "$z/type" 2>/dev/null)"; [ -n "$type" ] || continue
    # this zone's critical (fallback hot) trip — a REAL one (a '-274000'/0K sentinel has a '-' → skipped by
    # the [!0-9] class; the 40–130°C band drops any other implausible value)
    crit_mc=""
    for tt in "$z"/trip_point_*_type; do
      [ -r "$tt" ] || continue
      t="$(cat "$tt" 2>/dev/null)"
      case "$t" in critical|hot) : ;; *) continue ;; esac
      ttemp="$(cat "${tt%_type}_temp" 2>/dev/null)"; case "$ttemp" in ''|*[!0-9]*) continue ;; esac
      [ "$ttemp" -ge 40000 ] && [ "$ttemp" -le 130000 ] || continue
      if [ -z "$crit_mc" ] || [ "$ttemp" -lt "$crit_mc" ]; then crit_mc="$ttemp"; fi  # lowest real ceiling = most conservative
    done
    [ -n "$crit_mc" ] || continue   # zone declares no real critical/hot trip → not a danger-scale zone
    crit_c=$((crit_mc/1000)); tz_c=$((temp_mc/1000)); head=$((crit_c - tz_c))
    # highest ACTIVE tier this zone currently breaches (firmware's staged-cooling ladder)
    active="none"
    for tt in "$z"/trip_point_*_type; do
      [ -r "$tt" ] || continue
      [ "$(cat "$tt" 2>/dev/null)" = active ] || continue
      ttemp="$(cat "${tt%_type}_temp" 2>/dev/null)"; case "$ttemp" in ''|*[!0-9]*) continue ;; esac
      a_c=$((ttemp/1000))
      if [ "$tz_c" -ge "$a_c" ]; then
        if [ "$active" = none ] || [ "$a_c" -gt "$active" ]; then active="$a_c"; fi
      fi
    done
    case "$type" in
      x86_pkg_temp|x86_pkg*) pkg_zone="$type"; pkg_crit="$crit_c"; pkg_ztemp="$tz_c"; pkg_head="$head"; pkg_active="$active" ;;
    esac
    if [ -z "$best_head" ] || [ "$head" -lt "$best_head" ]; then  # most-urgent (min-headroom) fallback
      best_zone="$type"; best_crit="$crit_c"; best_ztemp="$tz_c"; best_head="$head"; best_active="$active"
    fi
  done
  if [ -n "$pkg_zone" ]; then      # prefer the pkg sensor's OWN zone when it carries a real trip (honest pairing)
    trip_zone="$pkg_zone"; trip_crit="$pkg_crit"; trip_zone_temp="$pkg_ztemp"; trip_headroom="$pkg_head"; trip_active="$pkg_active"
  elif [ -n "$best_zone" ]; then
    trip_zone="$best_zone"; trip_crit="$best_crit"; trip_zone_temp="$best_ztemp"; trip_headroom="$best_head"; trip_active="$best_active"
  fi
}

alert(){ # $1 tier(board|trace)  $2 tg-msg  $3 marker-msg.  MESH_ALERT_DRYRUN=1 → print, don't send.
         if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] $1: $3" >&2; return; fi
         if [ "$1" = board ]; then
           # near-shutdown alarm: operator TG + coordination board
           command -v mesh-tg   >/dev/null 2>&1 && mesh-tg "$2" >/dev/null 2>&1
           command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="therm@$(hostname)" mesh-chat "$3" >/dev/null 2>&1
         else
           # routine throttle-flap: durable history tier only (no TG, no board)
           command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="therm@$(hostname)" mesh-trace "$3" >/dev/null 2>&1
         fi; }

# therm_decide $max $now → echoes one of: hot | hot-silent | cooling | cool | ok ; updates STATE +
# ALERT_STATE and fires alert() (dryrun-aware). Pure of clock/sensor reads (now passed in) so --test
# can drive a synthetic sequence. .therm-state stays the bare real-time HOT/OK the consumers expect.
therm_decide() {
  local max="$1" now="$2" eff_hot="${3:-$HOT}" recover
  recover=$((eff_hot-5))
  local prev; prev="$(cat "$STATE" 2>/dev/null || echo OK)"
  local hs cs lhe lhm lk
  read -r hs cs lhe lhm lk < <(cat "$ALERT_STATE" 2>/dev/null) || true
  [[ "$hs"  =~ ^[0-9]+$ ]] || hs=0
  [[ "$cs"  =~ ^[0-9]+$ ]] || cs=0
  [[ "$lhe" =~ ^[0-9]+$ ]] || lhe=0
  [[ "$lhm" =~ ^[0-9]+$ ]] || lhm=0
  [ -n "$lk" ] || lk=none
  local out
  if [ "$max" -gt "$eff_hot" ]; then
    hs=$((hs+1)); cs=0
    echo HOT > "$STATE"
    local fire=0
    if [ "$hs" -ge "$HOT_N" ]; then
      if [ "$lk" = hot ]; then
        # already in an announced hot episode → re-alert only on genuine escalation (and ≥5min apart)
        [ "$max" -ge $((lhm + ESCALATE)) ] && [ $((now - lhe)) -ge 300 ] && fire=1
      else
        # entering a hot episode → fire unless still inside the cooldown of the previous episode
        { [ "$lk" = none ] || [ $((now - lhe)) -ge "$COOLDOWN" ]; } && fire=1
      fi
    fi
    if [ "$fire" = 1 ]; then
      lhe="$now"; lhm="$max"; lk=hot
      # note the morning-preempt shift explicitly in the human-facing text when active, so a hot
      # alert at, say, 83°C isn't misread against the "normal" 88°C threshold (chat-review class:
      # a threshold that silently differs from its own documented default is a confusion trap).
      local shift_note=""; [ "$eff_hot" != "$HOT" ] && shift_note=" [morning-preempt: forecast thermal day, threshold lowered from ${HOT}°C]"
      alert "$(therm_tier "$max")" \
            "🌡 $(hostname) thermal HOT: ${max}°C (threshold ${eff_hot}°C)${shift_note} — $line" \
            "[therm-hot] $(hostname) ${max}°C (>${eff_hot}°C, ${HOT_N}+ consecutive)${shift_note} — $line"
      out=hot
    else
      out=hot-silent
    fi
  elif [ "$prev" = HOT ] && [ "$max" -gt "$recover" ]; then
    # hysteresis band: still hot-ish (recover<max≤HOT) — neither a hot read nor recovered. The
    # sustained-hot RUN is broken (reset hs so a re-hot needs fresh consecutive reads), not yet cooling.
    hs=0
    echo HOT > "$STATE"
    out=cooling
  else
    cs=$((cs+1)); hs=0
    echo OK > "$STATE"
    if [ "$lk" = hot ] && [ "$cs" -ge "$COOL_N" ]; then
      lk=cool
      # recovery rides the tier of the episode it closes (peak lhm): a near-shutdown alarm gets its
      # TG+board "all clear"; a routine flap's recovery stays in trace.
      alert "$(therm_tier "$lhm")" \
            "✅ $(hostname) thermal recovered: ${max}°C (peak ${lhm}°C)" \
            "[therm-cool] $(hostname) ${max}°C — recovered (${COOL_N}+ consecutive)"
      out=cool
    else
      out=ok
    fi
  fi
  printf '%s %s %s %s %s\n' "$hs" "$cs" "$lhe" "$lhm" "$lk" > "$ALERT_STATE"
  echo "$out"
}

# --- CSD: critical-slowing-down leading indicator (READ-ONLY instrument, off by default) ---
# Cross-domain transfer (SOC/power-law early-warning → this node's #1 failure mode, thermal throttle):
# near a critical transition a system recovers from perturbations SLOWER, so its own series shows
# rising VARIANCE + rising lag-1 AUTOCORRELATION BEFORE it crosses (Scheffer et al., Nature 2009;
# Dakos PMC3261433). This reads therm.log's max= series and reports whether that signature is present.
# DELIBERATELY ADVISORY: it prints an assessment and NOTHING ELSE — no board/TG/trace post, no shed
# gate, no .therm-state write. The threshold path above is untouched. Purpose: let the lead-time be
# VETTED against real throttle-collapse episodes before any alarm is wired (the false-positive bound —
# variance+AR1 also rise on a noise-regime shift, Dakos PMC4247400 — is why this is an instrument first).
# See ~/.mesh/knowledge/review-critical-slowing-down-thermal-resilience-2026-06-21.md.
CSD_WIN="${MESH_THERM_CSD_WIN:-24}"    # samples in the window (24 × 5min ≈ 2h)
CSD_MIN="${MESH_THERM_CSD_MIN:-8}"     # minimum samples before assessing
CSD_BAND="${MESH_THERM_CSD_BAND:-78}"  # 'elevated band' floor: a PRECURSOR needs recent mean ≥ this AND < HOT

csd_assess() {  # reads whitespace-separated temps (oldest→newest) on stdin → one verdict line on stdout
  python3 -c '
import sys
xs=[float(t) for t in sys.stdin.read().split() if t.strip()]
band=float(sys.argv[1]); hot=float(sys.argv[2]); mn=int(sys.argv[3]); n=len(xs)
if n < mn:
    print("INSUFFICIENT samples=%d need=%d" % (n, mn)); sys.exit(0)
def var(a):
    m=sum(a)/len(a); return sum((v-m)**2 for v in a)/len(a)
def ar1(a):
    m=sum(a)/len(a); d=sum((v-m)**2 for v in a)
    return 0.0 if d==0 else sum((a[i]-m)*(a[i+1]-m) for i in range(len(a)-1))/d
h=n//2; old=xs[:h]; rec=xs[h:]
vo,vr=var(old),var(rec); ao,ar=ar1(old),ar1(rec); rm=sum(rec)/len(rec)
rising=(vr>vo) and (ar>ao); elevated=(rm>=band) and (rm<hot)
verdict="PRECURSOR" if (rising and elevated) else ("RISING-LOW" if rising else "STABLE")
print("%s var:%.2f->%.2f ar1:%.3f->%.3f recent_mean:%.1f band:[%.0f,%.0f) n:%d"
      % (verdict, vo, vr, ao, ar, rm, band, hot, n))
' "$CSD_BAND" "$HOT" "$CSD_MIN"
}

# --- DFA: loss-of-complexity leading indicator (READ-ONLY instrument, off by default) ---
# LITERATURE (live WebSearch, 2026-07-11, genome mind; homeostasis/allostasis/ultrastability → this
# node's thermal regulation). The area's allostatic-load / CSD / ultrastability metrics are already
# embodied (mesh-stress/mesh-algedonic/mesh-reliability allostatic load; this file's --csd + mesh-
# criticality's csd_classify variance/AC1; mesh-homeostasis I-controller). The genuinely-not-embodied
# concept: Lipsitz & Goldberger's LOSS-OF-COMPLEXITY hypothesis — a HEALTHY physiologically-regulated
# signal carries rich, self-similar (1/f, "fractal") fluctuation across many timescales, produced by the
# nonlinear interplay of the regulators; as regulatory capacity degrades the output LOSES that multiscale
# complexity, collapsing toward either uncorrelated white noise (α→0.5, structure gone) or an unchecked
# Brownian drift (α→1.5, integration not pulled back). The concrete metric that area uses to measure
# itself is the DETRENDED FLUCTUATION ANALYSIS scaling exponent α (Peng et al.; still the live cross-
# domain early-warning/predictive-maintenance tool — Early Warning Signals Toolbox, DFA on degradation
# series arXiv:1904.04636; physiological-complexity aging reviews). α is ORTHOGONAL to --csd: CSD tracks
# variance+AC1 RISING toward a tipping point, but a signal can OVER-REGULARIZE (variance FALLING) and CSD
# structurally misreads that as "healthy/receding" — exactly the "critical speeding up" ambiguity mesh-
# criticality flagged as open. DFA α catches the complexity collapse in EITHER tail, resolving part of it.
# DELIBERATELY ADVISORY (same posture as --csd): prints an assessment and NOTHING ELSE — no board/TG/
# trace, no shed gate, no state write. DFA on a short thermal window is coarse and the α-band→health
# mapping must be VETTED against real thermal-degradation logs before any alarm is wired.
DFA_WIN="${MESH_THERM_DFA_WIN:-64}"    # samples analysed (64 × 5min ≈ 5h — DFA needs a longer window than CSD)
DFA_MIN="${MESH_THERM_DFA_MIN:-16}"    # minimum samples before assessing (multi-scale room; else INSUFFICIENT)

dfa_assess() {  # reads whitespace temps (oldest→newest) on stdin; $1=min_n → one verdict line on stdout
  python3 -c '
import sys, math
xs=[float(t) for t in sys.stdin.read().split() if t.strip()]
mn=int(sys.argv[1]); n=len(xs)
if n < mn:
    print("INSUFFICIENT alpha:n/a n:%d need:%d" % (n, mn)); sys.exit(0)
m=sum(xs)/n
y=[0.0]*n; acc=0.0
for i in range(n): acc+=xs[i]-m; y[i]=acc     # integrated profile (DFA step 1)
scales=[s for s in (4,6,8,12,16) if s>=4 and n//s>=2]
if len(scales) < 2:
    print("INSUFFICIENT alpha:n/a n:%d (too short for >=2 scales)" % n); sys.exit(0)
def fluct(s):                                  # RMS of locally linear-detrended profile over non-overlapping windows
    nb=n//s; tot=0.0; cnt=0
    sx=sum(range(s)); sxx=sum(i*i for i in range(s)); den=s*sxx-sx*sx
    for b in range(nb):
        seg=y[b*s:(b+1)*s]; sy=sum(seg); sxy=sum(i*seg[i] for i in range(s))
        if den==0: slope=0.0; inter=sy/s
        else: slope=(s*sxy-sx*sy)/den; inter=(sy-slope*sx)/s
        for i in range(s):
            r=seg[i]-(slope*i+inter); tot+=r*r; cnt+=1
    return math.sqrt(tot/cnt) if cnt else 0.0
pts=[(math.log(s), math.log(f)) for s in scales for f in (fluct(s),) if f>0]
if len(pts) < 2:
    print("INSUFFICIENT alpha:n/a n:%d (zero-fluctuation/flat series)" % n); sys.exit(0)
k=len(pts); sx=sum(a for a,_ in pts); sy=sum(b for _,b in pts)
sxx=sum(a*a for a,_ in pts); sxy=sum(a*b for a,b in pts); den=k*sxx-sx*sx
alpha=(k*sxy-sx*sy)/den if den else 0.0
verd=("DE-REGULATED" if alpha < 0.75 else ("OVER-DRIFT" if alpha > 1.25 else "HEALTHY"))
print("%s alpha:%.2f scales:%s n:%d" % (verd, alpha, ",".join(str(s) for s in scales), n))
' "${1:-$DFA_MIN}"
}

if [ "${1:-}" = --test ]; then
  command -v mesh-therm >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-therm)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # ---- synthetic debounce/cooldown sequence (hardware-independent; the cry-wolf fix is the point) ----
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  export MESH_ALERT_DRYRUN=1 STATE="$_td/state" ALERT_STATE="$_td/astate"
  HOT=88 HOT_N=2 COOL_N=2 COOLDOWN=1800 ESCALATE=4 CRIT=98; line="(test)"
  fail=0; chk(){ [ "$2" = "$3" ] || { echo "  FAIL: $1 → expected '$3', got '$2'"; fail=1; }; }
  # tiering: only a near-shutdown (≥CRIT) reaches the operator TG + board; routine flap → trace only.
  chk "tier 89°C routine"  "$(therm_tier 89)"  trace
  chk "tier 97°C routine"  "$(therm_tier 97)"  trace
  chk "tier 98°C critical" "$(therm_tier 98)"  board
  chk "tier 100°C critical" "$(therm_tier 100)" board
  chk "single 96°C spike"        "$(therm_decide 96 0)"    hot-silent   # debounce: one read never alerts
  chk "2nd 96°C (sustained)"     "$(therm_decide 96 300)"  hot          # fires after HOT_N consecutive
  chk "80°C dip (1st cool)"      "$(therm_decide 80 600)"  ok           # COOL_N not met → no recovery yet
  chk "80°C (2nd cool)"          "$(therm_decide 80 900)"  cool         # recovered after COOL_N consecutive
  chk "96°C re-heat #1"          "$(therm_decide 96 1200)" hot-silent
  chk "96°C re-heat #2 (cooldown)" "$(therm_decide 96 1500)" hot-silent # inside COOLDOWN of the 300s episode → suppressed
  chk "96°C past cooldown"       "$(therm_decide 96 2200)" hot          # now-300 ≥ 1800 → new episode alerts
  chk "100°C escalation"         "$(therm_decide 100 2520)" hot         # +4°C climb inside cooldown → escalation fires
  chk "85°C hysteresis band"     "$(therm_decide 85 2820)" cooling      # recover<max≤HOT → no recovery, no alert
  # .therm-state must remain the bare consumer token
  grep -qxE 'HOT|OK' "$STATE" || { echo "  FAIL: .therm-state not bare HOT/OK: $(cat "$STATE")"; fail=1; }

  # ---- MORNING PREEMPTIVE TIER (weather-consumers-phase2) ----
  _wtd="$(mktemp -d)"
  printf 'OK 2026-07-07T06:00:00Z now_c=20.0 today_max_c=32.0 peak_hour=15 thermal_day=1 thresh_c=28\n' > "$_wtd/thermal-day"
  printf 'OK 2026-07-07T06:00:00Z now_c=18.0 today_max_c=22.0 peak_hour=15 thermal_day=0 thresh_c=28\n' > "$_wtd/mild-day"
  chk "morning, thermal_day=1, before peak → shifted" "$(morning_preempt_shift "$_wtd/thermal-day" 9)"  5
  chk "afternoon, thermal_day=1, AT peak → NOT shifted (spec: before, not during)" "$(morning_preempt_shift "$_wtd/thermal-day" 15)" 0
  chk "evening, thermal_day=1, past peak → NOT shifted"  "$(morning_preempt_shift "$_wtd/thermal-day" 20)" 0
  chk "morning, mild day (thermal_day=0) → NOT shifted"  "$(morning_preempt_shift "$_wtd/mild-day" 9)"     0
  chk "morning, weather sense absent → NOT shifted (honest-fusion: UNKNOWN never assumed a thermal day)" \
      "$(morning_preempt_shift "$_wtd/no-such-file" 9)" 0
  rm -rf "$_wtd"
  # therm_decide's optional 3rd arg (effective threshold) — a lowered morning threshold must fire
  # earlier than the plain HOT=88 default would, and the alert text must say so (never a silent
  # threshold change — a HOT alert at 83 read against an undocumented 88 default is a confusion trap).
  MESH_ALERT_DRYRUN=1
  : > "$STATE"; : > "$ALERT_STATE"
  chk "83°C vs plain HOT=88 → not hot at all"       "$(therm_decide 83 5000)"        ok
  : > "$STATE"; : > "$ALERT_STATE"
  chk "83°C vs morning-lowered eff_hot=83 → still ok (needs >83)" "$(therm_decide 83 5000 83)" ok
  chk "84°C vs morning-lowered eff_hot=83, 1st read"  "$(therm_decide 84 5000 83)"    hot-silent
  _errf="$(mktemp)"; _res="$(therm_decide 84 5300 83 2>"$_errf")"
  chk "84°C vs eff_hot=83, 2nd read fires + notes the shift" "$_res" hot
  case "$(cat "$_errf")" in *"morning-preempt"*"88"*) : ;; *) echo "  FAIL: morning-preempt alert must name the shift + original 88°C default (got: $(cat "$_errf"))"; fail=1;; esac
  rm -f "$_errf"
  : > "$STATE"; : > "$ALERT_STATE"
  # ---- CSD instrument (read-only leading-indicator; synthetic series of KNOWN behaviour) ----
  if command -v python3 >/dev/null 2>&1; then
    CSD_BAND=78 CSD_MIN=8
    # flat/stationary: low variance, no rising AR1 → STABLE (no false precursor)
    chk "csd flat→STABLE" "$(printf '84 85 84 85 84 85 84 85 84 85 84 85' | csd_assess | cut -d' ' -f1)" STABLE
    # 1st half = tight alternation (low var, negative AR1); 2nd half = wide smooth excursion (high var,
    # positive AR1) with recent mean in [78,88) → the textbook CSD signature → PRECURSOR
    chk "csd rising-in-band→PRECURSOR" "$(printf '85 83 85 83 85 83 78 81 84 87 84 81 78 81' | csd_assess | cut -d' ' -f1)" PRECURSOR
    # rising var+ar1 but recent mean BELOW the band → RISING-LOW (signature without thermal relevance)
    chk "csd rising-cold→RISING-LOW" "$(printf '70 68 70 68 70 68 62 65 68 71 68 65 62 65' | csd_assess | cut -d' ' -f1)" RISING-LOW
    # too few samples → INSUFFICIENT (never a false verdict on a short series)
    chk "csd short→INSUFFICIENT" "$(printf '84 85 84' | csd_assess | cut -d' ' -f1)" INSUFFICIENT
  fi
  # ---- DFA loss-of-complexity instrument (read-only; validate the exponent math on ANALYTICALLY-known series) ----
  # White noise has DFA α≈0.5; integrating it (a random walk / Brownian) has α≈1.5 — DFA's defining
  # property is that integration RAISES α by ~1. We generate a deterministic (seeded LCG) white series and
  # its cumulative sum, then assert the classifier reads the two known regimes AND that the ~+1 gap holds.
  if command -v python3 >/dev/null 2>&1; then
    DFA_MIN=16
    _white="$(python3 -c 's=1234567;o=[]
for _ in range(96):
 s=(1103515245*s+12345)%2147483648;o.append((s/2147483648.0)-0.5)
print(" ".join("%.5f"%v for v in o))')"
    _brown="$(python3 -c 's=1234567;o=[];a=0.0
for _ in range(96):
 s=(1103515245*s+12345)%2147483648;a+=(s/2147483648.0)-0.5;o.append(a)
print(" ".join("%.5f"%v for v in o))')"
    _wv="$(printf '%s' "$_white" | dfa_assess)"; _wa="${_wv#* alpha:}"; _wa="${_wa%% *}"
    _bv="$(printf '%s' "$_brown" | dfa_assess)"; _ba="${_bv#* alpha:}"; _ba="${_ba%% *}"
    chk "dfa white-noise → DE-REGULATED (α→0.5)" "${_wv%% *}" DE-REGULATED
    chk "dfa brownian → OVER-DRIFT (α→1.5)"      "${_bv%% *}" OVER-DRIFT
    awk "BEGIN{exit !($_ba - $_wa > 0.5)}" || { echo "  FAIL: dfa integration must raise α by ~1 (white α=$_wa brown α=$_ba, gap≤0.5 → DFA math wrong)"; fail=1; }
    chk "dfa short→INSUFFICIENT"  "$(printf '84 85 84 85' | dfa_assess | cut -d' ' -f1)" INSUFFICIENT
    chk "dfa flat→INSUFFICIENT"   "$(printf '84 84 84 84 84 84 84 84 84 84 84 84 84 84 84 84 84 84 84 84' | dfa_assess | cut -d' ' -f1)" INSUFFICIENT
  fi
  # ---- throttle ground-truth counters (capability-cpu-throttle-counter-20260704) ----
  _tt="$(mktemp -d)"
  mkdir -p "$_tt/cpu0/thermal_throttle" "$_tt/cpu1/thermal_throttle" "$_tt/cpu2/thermal_throttle"
  echo 1000 > "$_tt/cpu0/thermal_throttle/package_throttle_total_time_ms"; echo 50 > "$_tt/cpu0/thermal_throttle/package_throttle_count"
  echo 1200 > "$_tt/cpu1/thermal_throttle/package_throttle_total_time_ms"; echo 60 > "$_tt/cpu1/thermal_throttle/package_throttle_count"
  echo 900  > "$_tt/cpu2/thermal_throttle/package_throttle_total_time_ms"; echo 40 > "$_tt/cpu2/thermal_throttle/package_throttle_count"
  THROTTLE_GLOB="$_tt/cpu*/thermal_throttle/package_throttle_total_time_ms"
  # MAX across CPUs, not SUM (they're read-skewed views of the SAME package-level event)
  read_throttle
  chk "throttle MAX-not-sum (ms)"    "$throttle_ms"    1200
  chk "throttle MAX-not-sum (count)" "$throttle_count" 60
  THROTTLE_STATE="$_tt/throttle-state"
  compute_throttle_delta
  chk "throttle 1st-run baseline (no fake delta)" "$throttle_ms_delta" 0
  [ "$(cat "$THROTTLE_STATE" 2>/dev/null)" = "1200 60" ] || { echo "  FAIL: throttle baseline not persisted (got '$(cat "$THROTTLE_STATE" 2>/dev/null)')"; fail=1; }
  echo 1500 > "$_tt/cpu1/thermal_throttle/package_throttle_total_time_ms"; echo 75 > "$_tt/cpu1/thermal_throttle/package_throttle_count"
  read_throttle; compute_throttle_delta
  chk "throttle real delta (ms)"     "$throttle_ms_delta"     300
  chk "throttle real delta (count)"  "$throttle_events_delta" 15
  echo 200 > "$_tt/cpu1/thermal_throttle/package_throttle_total_time_ms"; echo 5 > "$_tt/cpu1/thermal_throttle/package_throttle_count"
  echo 100 > "$_tt/cpu0/thermal_throttle/package_throttle_total_time_ms"; echo 2 > "$_tt/cpu0/thermal_throttle/package_throttle_count"
  echo 150 > "$_tt/cpu2/thermal_throttle/package_throttle_total_time_ms"; echo 3 > "$_tt/cpu2/thermal_throttle/package_throttle_count"
  read_throttle; compute_throttle_delta
  chk "throttle counter-reset (reboot) → 0, not negative" "$throttle_ms_delta" 0
  THROTTLE_GLOB="$_tt/nonexistent-cpu*/thermal_throttle/package_throttle_total_time_ms"
  read_throttle
  [ -z "$throttle_ms" ] || { echo "  FAIL: unreadable sysfs should leave throttle_ms empty (not a fake 0), got '$throttle_ms'"; fail=1; }
  rm -rf "$_tt"

  # ---- FIRMWARE THERMAL-TRIP HEADROOM (self-calibrating danger scale) ----
  _tz="$(mktemp -d)"
  mk_zone(){ # $1=base $2=zoneN $3=type $4=temp_mC ; then trip triples: <idx> <trip_type> <trip_temp_mC> ...
    local b="$1/thermal_zone$2"; mkdir -p "$b"
    printf '%s\n' "$3" > "$b/type"; printf '%s\n' "$4" > "$b/temp"; shift 4
    while [ "$#" -ge 3 ]; do printf '%s\n' "$2" > "$b/trip_point_$1_type"; printf '%s\n' "$3" > "$b/trip_point_$1_temp"; shift 3; done
  }
  # (1) B0D4-style real-trip zone: crit 110°C, active ladder 90/85/80/75/70, temp 57°C → headroom 53, no active breach
  _b1="$_tz/c1"; mk_zone "$_b1" 7 B0D4 57000  0 critical 110000  1 active 90000  2 active 85000  3 active 80000  4 active 75000  5 active 70000
  THERMAL_BASE="$_b1" read_trip_headroom
  chk "trip zone (real-trip B0D4)"           "$trip_zone"       B0D4
  chk "trip crit °C (firmware ceiling)"      "$trip_crit"       110
  chk "trip zone-temp °C (its OWN sensor)"   "$trip_zone_temp"  57
  chk "trip headroom °C (crit−own-temp)"     "$trip_headroom"   53
  chk "trip active tier (none breached @57)" "$trip_active"     none
  # (2) same ladder but zone at 82°C → breaches active tier 80, headroom 28
  _b2="$_tz/c2"; mk_zone "$_b2" 7 B0D4 82000  0 critical 110000  1 active 90000  2 active 85000  3 active 80000  4 active 75000  5 active 70000
  THERMAL_BASE="$_b2" read_trip_headroom
  chk "trip headroom °C @82"                 "$trip_headroom"   28
  chk "trip highest active tier breached @82" "$trip_active"    80
  # (3a) unset trips (-274000 / 0K sentinel) → honest n/a, never a faked ceiling
  _b3="$_tz/c3"; mk_zone "$_b3" 9 x86_pkg_temp 60000  0 critical -274000  1 passive -274000
  THERMAL_BASE="$_b3" read_trip_headroom
  [ -z "$trip_crit" ] || { echo "  FAIL: unset(-274000) trips must yield honest n/a, got crit='$trip_crit'"; fail=1; }
  # (3b) no thermal zones at all (VM — phaedra/ilya) → honest n/a
  _b3b="$_tz/c3b"; mkdir -p "$_b3b"
  THERMAL_BASE="$_b3b" read_trip_headroom
  [ -z "$trip_crit" ] || { echo "  FAIL: no thermal zones (VM) must yield honest n/a, got crit='$trip_crit'"; fail=1; }
  # (4) pkg sensor's OWN zone is PREFERRED for honest pairing even when B0D4 has a smaller headroom
  _b4="$_tz/c4"; mk_zone "$_b4" 7 B0D4 105000 0 critical 110000; mk_zone "$_b4" 9 x86_pkg_temp 60000 0 critical 100000
  THERMAL_BASE="$_b4" read_trip_headroom
  chk "prefer pkg zone (honest pairing over min-headroom B0D4)" "$trip_zone"     x86_pkg_temp
  chk "pkg headroom (own crit−own temp)"                        "$trip_headroom" 40
  rm -rf "$_tz"

  # REAL READ — the PRODUCER gate (2026-07-15, same class as mesh-motion-attrib 562938a). Everything
  # above proves the CLASSIFIER against synthetic temperatures: it simulates 96°C/100°C spikes, debounce,
  # escalation, CSD/DFA precursors — an elaborate suite that passed green every run while this node's
  # actual thermal read was a structurally blind "max=0" and the log said "therm: ok 0°C" 69 times. Not
  # one assertion asked whether mesh-therm could see a temperature at all; meanwhile mesh-therm's OWN
  # --test was correctly red ("no readable thermal zone") and nothing consumed that verdict, because
  # mesh-therm is a probe and only this tool is cron-wired. A watcher must gate on its PRODUCER: proving
  # you can classify a 100°C emergency is worthless if your sensor cannot report one. rc=2 = no thermal
  # organ here ⇒ propagate the honest n/a (autowire SKIPs, mesh-land passes); rc=1 = producer broken ⇒
  # never certify this watcher as wireable on top of it.
  mesh-therm --test >/dev/null 2>&1; _prc=$?
  case "$_prc" in
    2) echo "smoke-test: n/a — producer mesh-therm reports no thermal organ on $(hostname) (rc=2); classifier fixtures all passed, but there is nothing here to watch"; exit 2 ;;
    0) : ;;
    *) echo "smoke-test: FAIL (producer mesh-therm --test rc=$_prc — refusing to certify a thermal watcher whose sensor cannot produce a real read; run: mesh-therm --test)"; exit 1 ;;
  esac
  _lm="$(mesh-therm 2>/dev/null | grep -oE 'max=[0-9]+' | head -1 | cut -d= -f2)"
  { [ -n "$_lm" ] && [ "$_lm" -gt 0 ] && [ "$_lm" -lt 150 ]; } \
    || { echo "smoke-test: FAIL (live producer max='${_lm:-unparseable}' — not a plausible temperature; this watcher would render blindness as 'therm: ok ${_lm}°C')"; exit 1; }

  [ "$fail" = 0 ] && { echo "smoke-test: ok (live producer max=${_lm}°C; debounce kills single spike; cooldown collapses oscillation storm; escalation still fires; .therm-state contract intact; throttle-counter MAX-aggregation + delta + reset-safety + unreadable-fail-open; morning-preempt: shift only before peak_hour on a forecast thermal day, honest-UNKNOWN-never-shifts on absent weather, lowered-threshold alert names its own shift; CSD var/ar1 precursor + DFA loss-of-complexity α: white→DE-REGULATED, brown→OVER-DRIFT, integration-raises-α invariant, short/flat→INSUFFICIENT)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

# --csd: read-only critical-slowing-down assessment over therm.log (no live snapshot needed; advisory only)
if [ "${1:-}" = --csd ]; then
  command -v python3 >/dev/null 2>&1 || { echo "csd: unavailable (no python3) — threshold path unaffected"; exit 0; }
  [ -f "$LOG" ] || { echo "csd: no therm.log yet (nothing to assess)"; exit 0; }
  series="$(grep -oE 'max=[0-9]+' "$LOG" 2>/dev/null | cut -d= -f2 | tail -n "$CSD_WIN" | tr '\n' ' ')"
  v="$(printf '%s' "$series" | csd_assess)"
  echo "mesh-therm-watch CSD (read-only, advisory — not wired to any alarm/shed): $v"
  case "$v" in
    PRECURSOR*) echo "  → losing thermal resilience: variance AND lag-1 autocorrelation both rising while in the elevated band [<${HOT}°C] — an approaching-transition precursor. Lead-time must be vetted vs real throttle-collapse logs before this gates anything." ;;
    RISING-LOW*) echo "  → CSD signature present (var+ar1 rising) but recent mean is outside the elevated band — not (yet) a thermal-approach precursor." ;;
  esac
  exit 0
fi

# --dfa: read-only DFA loss-of-complexity assessment over therm.log (advisory only; orthogonal to --csd)
if [ "${1:-}" = --dfa ]; then
  command -v python3 >/dev/null 2>&1 || { echo "dfa: unavailable (no python3) — threshold path unaffected"; exit 0; }
  [ -f "$LOG" ] || { echo "dfa: no therm.log yet (nothing to assess)"; exit 0; }
  series="$(grep -oE 'max=[0-9]+' "$LOG" 2>/dev/null | cut -d= -f2 | tail -n "$DFA_WIN" | tr '\n' ' ')"
  v="$(printf '%s' "$series" | dfa_assess "$DFA_MIN")"
  echo "mesh-therm-watch DFA (read-only, advisory — not wired to any alarm/shed): $v"
  case "$v" in
    HEALTHY*)      echo "  → ~1/f long-range (fractal) fluctuation: multi-scale regulatory complexity intact (Lipsitz-Goldberger healthy range)." ;;
    DE-REGULATED*) echo "  → complexity LOSS toward uncorrelated noise (α→0.5): long-range regulatory structure eroded. ORTHOGONAL to --csd (variance/AC1); α-band→degradation mapping must be vetted before this gates anything." ;;
    OVER-DRIFT*)   echo "  → complexity LOSS toward Brownian drift (α→1.5): temperature integrating unchecked (regulation not pulling it back). Vet lead-time vs real throttle-collapse logs before gating." ;;
  esac
  exit 0
fi

read_snapshot
[ -n "$line" ] || { echo "mesh-therm produced nothing (not an alarm)"; exit 0; }
[ -n "$max" ] || { echo "max-temp parse failed (not an alarm): $line"; exit 0; }

# --status stays read-only per its own contract above ("no alarm, no log append"): compute_throttle_delta
# PERSISTS a new baseline every call, so running it here would let a manual --status between cron ticks
# silently swallow real throttle events from the next real run's delta. Deferred past the --status
# early-return; only the actual */5 cron pass (and its log/alert artifact) advances the baseline.
if [ "${1:-}" = --status ]; then echo "$line"; exit 0; fi

read_throttle; compute_throttle_delta
[ -n "$throttle_ms" ] && line="$line throttle_ms_delta=${throttle_ms_delta} throttle_events_delta=${throttle_events_delta}"

# firmware trip-headroom axis (correctly paired; does NOT touch therm_decide/CRIT — see header)
read_trip_headroom
if [ -n "$trip_crit" ]; then
  line="$line trip_zone=${trip_zone} trip_crit=${trip_crit}C trip_headroom=${trip_headroom}C trip_active=${trip_active}"
  # delta-gate: trace ONLY when the breached active-cooling tier CHANGES (a genuinely new staged-cooling
  # event); mesh-state-touch every run so mtime==liveness even while the value legitimately holds.
  _prev_active=""
  [ -r "$TRIP_STATE" ] && read -r _ _ _prev_active < "$TRIP_STATE" 2>/dev/null || true
  mkdir -p "$HOME/.mesh" 2>/dev/null
  printf '%s %s %s\n' "$trip_zone" "$trip_crit" "$trip_active" > "$TRIP_STATE" 2>/dev/null
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$TRIP_STATE" >/dev/null 2>&1 || true
  if [ -n "$_prev_active" ] && [ "$trip_active" != "$_prev_active" ]; then
    alert trace "" "[trip-headroom] $(hostname): ${trip_zone} active-cooling tier ${_prev_active}→${trip_active} (crit ${trip_crit}°C, headroom ${trip_headroom}°C) — firmware staged-cooling ladder moved."
  fi
fi

mkdir -p "$HOME/.mesh"
printf '%s\n' "$line" >> "$LOG"
# cheap rotation — the artifact is recency, not history
[ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 2000 ] && { tail -1000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }

eff_hot=$((HOT - $(morning_preempt_shift)))
kind="$(therm_decide "$max" "$(date +%s)" "$eff_hot")"

# GRACEFUL HARDWARE thermal step (opt-in per node: MESH_TURBO_LID=1, default OFF). The ladder is
# observe(here) → nice(whisper) → **lid** → shed/kill; the lid drops pkg ~26°C in 25s without
# disturbing a single process (mesh-turbo-lid, proven 2026-07-05). Engage on sustained hot (it
# self-releases on its own TTL dead-man, and re-asserting each hot read keeps the deadline fresh);
# proactively release on the recovery edge. Default OFF so landing never silently halves a node
# until health replicates the ds-under-load toggle — instrument-before-actuator, per this file's header.
# Cron strips env, so the per-node opt-in lives in ~/.mesh/restore.env (the MESH_* override file);
# read ONLY the two lid vars from it — never source it wholesale mid-run (it carries unrelated MESH_* that
# could shadow this script's knobs). Explicit env still wins (test harnesses set MESH_TURBO_LID directly).
if [ -z "${MESH_TURBO_LID:-}" ] && [ -f "$HOME/.mesh/restore.env" ]; then
  MESH_TURBO_LID="$(sed -n 's/^ *\(export \)\{0,1\}MESH_TURBO_LID=\([01]\).*/\2/p' "$HOME/.mesh/restore.env" | tail -1)"
  MESH_TURBO_LID_TTL="${MESH_TURBO_LID_TTL:-$(sed -n 's/^ *\(export \)\{0,1\}MESH_TURBO_LID_TTL=\([0-9]\+\).*/\2/p' "$HOME/.mesh/restore.env" | tail -1)}"
fi
if [ "${MESH_TURBO_LID:-0}" = 1 ] && command -v mesh-turbo-lid >/dev/null 2>&1; then
  case "$kind" in
    hot|hot-silent) mesh-turbo-lid --on --ttl "${MESH_TURBO_LID_TTL:-600}" --reason therm-hot >/dev/null 2>&1 || true ;;
    cool)           mesh-turbo-lid --off >/dev/null 2>&1 || true ;;
  esac
fi

# THERMAL SILENCE lifecycle (operator 2026-06-24): a sustained HOT episode auto-sets ~/.mesh/thermal-silence
# so mesh-voice-gate mutes the room's Bose WITHOUT the operator flipping room-voice-off each overheat (ds
# reboots ~4×/day and a sound fired on each recovery — "оч мешает"). Cleared once genuinely recovered.
# cooling (hysteresis band, still hot-ish) leaves the flag AS-IS — don't un-mute mid-episode.
case "$kind" in
  hot|hot-silent) : > "${MESH_DIR:-$HOME}/.mesh/thermal-silence" 2>/dev/null || : > "$HOME/.mesh/thermal-silence" 2>/dev/null || true ;;
  cool|ok)        rm -f "${MESH_DIR:-$HOME}/.mesh/thermal-silence" "$HOME/.mesh/thermal-silence" 2>/dev/null || true ;;
esac

case "$kind" in
  hot)        echo "therm: HOT ${max}°C (alerted)"; exit 1 ;;
  hot-silent) echo "therm: HOT ${max}°C (debounced/cooldown — no alert)"; exit 1 ;;
  cooling)    echo "therm: cooling ${max}°C (hysteresis, recover below $((HOT - 5))°C)"; exit 1 ;;
  cool)       echo "therm: recovered ${max}°C (alerted)"; exit 0 ;;
  *)          echo "therm: ok ${max}°C"; exit 0 ;;
esac
