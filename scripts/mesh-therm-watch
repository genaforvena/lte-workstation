#!/usr/bin/env bash
# mesh-therm-watch — node-LOCAL thermal edge-trigger ([therm-hot]/[therm-cool]) + per-run log artifact.
# mesh-router-watch covers the fanless router over SSH; this covers the node it runs ON (gap found
# 2026-06-12: ds, a production box with 11 containers, hit a 91°C transient with zero thermal watch).
# Cron-wired; ~/.mesh/therm.log is the per-run artifact mesh-reflex-health can watch for staleness.
#
# reflex-cadence: */5 * * * *
# Self-wires via mesh-autowire (after --test PASS). Was documented "Cron-wired" but carried NO
# cadence header, so it never auto-wired and its .therm-state went stale (4h+, malformed "HOT 2")
# — starving mesh-stress's thermal axis on a node whose #1 failure mode IS thermal throttle
# (verify-rotation finding 2026-06-17). */5 matches the sibling edge reflexes + router-watch.
#
# ALERT DEBOUNCE (2026-06-20, chat-review cry-wolf): the IdeaPad genuinely OSCILLATES wide under mind
# load (observed 95→80→96→83→90°C in 70min = 5 hot/cool cycles); the bare 5°C hysteresis can't damp a
# swing that crosses BOTH thresholds, so every crossing fired a board/TG alert = cry-wolf. Fix: the
# real-time .therm-state stays bare HOT/OK (mesh-stress / mesh-health-state read it as the live thermal
# axis — DO NOT change that contract), but the human-facing ALERT is now gated on a SEPARATE debounce
# file (.therm-alert-state): require N consecutive reads (sustained, not a single-sample spike), a
# COOLDOWN between alert episodes (collapses an oscillation storm to one alert), with an ESCALATION
# override so a genuine climb (e.g. 96→100°C) still alarms inside the cooldown.
#
#   mesh-therm-watch          one check; edge-trigger above MESH_THERM_HOT (default 88°C, recover below HOT-5)
#   mesh-therm-watch --status print current mesh-therm snapshot, no alarm, no log append
#   mesh-therm-watch --csd    READ-ONLY critical-slowing-down assessment over therm.log (advisory; see below)
#   mesh-therm-watch --test   smoke test (mesh-therm parse + synthetic debounce/cooldown + CSD instrument)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# 88°C: a WARNING band below mesh-therm's 90°C CRIT, tuned against real telemetry —
# both nodes idle-busy at 84-86°C (5 concurrent minds on the IdeaPad), so 85 fired on
# normal load; genuine thermal pressure shows as 90-96°C excursions. 88 catches those
# (and ds's earlier real 91°C) while ignoring the busy-but-fine band. With the 5°C
# hysteresis (recover <83) this kept edges to ~3/3h even before the tune.
HOT="${MESH_THERM_HOT:-88}"
HOT_N="${MESH_THERM_HOT_N:-2}"          # consecutive >HOT reads before [therm-hot] (debounce single spikes; */5 → ≥10min sustained)
COOL_N="${MESH_THERM_COOL_N:-2}"        # consecutive recovered reads before [therm-cool] (no premature "recovered")
COOLDOWN="${MESH_THERM_COOLDOWN:-1800}" # min seconds between hot alert EPISODES (collapses an oscillation storm)
ESCALATE="${MESH_THERM_ESCALATE:-4}"    # re-alert inside cooldown only if max climbs ≥ this above the last alert (genuine worsening)
CRIT="${MESH_THERM_CRIT:-98}"           # ≥ this = near the 100-102°C shutdown ceiling → operator-worthy (TG+board)
# TIER an episode: only a near-shutdown (≥CRIT) is worth the operator's TG + the coordination board.
# Routine HOT episodes (88-97°C) are this node's chronic throttle-flap (~31/24h) — they go to mesh-trace
# (durable history) ONLY, so they stop spamming the operator's Telegram and drowning the board. The
# .therm-state HOT/OK consumer contract (mesh-stress/health) is UNCHANGED — only the human-facing
# notification is re-tiered; mesh-tick reads sysfs temp directly + mesh-criticality classes the markers
# meta, so neither consumer regresses.
therm_tier(){ [ "${1:-0}" -ge "$CRIT" ] 2>/dev/null && echo board || echo trace; }
STATE="${MESH_THERM_STATE:-$HOME/.mesh/.therm-state}"             # bare HOT/OK — CONSUMER CONTRACT (mesh-stress/health-state)
ALERT_STATE="${MESH_THERM_ALERT_STATE:-$HOME/.mesh/.therm-alert-state}" # debounce/cooldown bookkeeping (this tool only)
LOG="$HOME/.mesh/therm.log"
line=""; max=""

read_snapshot() {
  line="$(mesh-therm 2>/dev/null)"
  max="$(printf '%s' "$line" | grep -oE 'max=[0-9]+' | head -1 | cut -d= -f2)"
}

alert(){ # $1 tier(board|trace)  $2 tg-msg  $3 marker-msg.  MESH_ALERT_DRYRUN=1 → print, don't send.
         if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] $1: $3" >&2; return; fi
         if [ "$1" = board ]; then
           # near-shutdown alarm: operator TG + coordination board
           command -v mesh-tg   >/dev/null 2>&1 && mesh-tg "$2" >/dev/null 2>&1
           command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="therm@$(hostname)" mesh-chat "$3" >/dev/null 2>&1
         else
           # routine throttle-flap: durable history tier only (no TG, no board)
           command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="therm@$(hostname)" mesh-trace "$3" >/dev/null 2>&1
         fi; }

# therm_decide $max $now → echoes one of: hot | hot-silent | cooling | cool | ok ; updates STATE +
# ALERT_STATE and fires alert() (dryrun-aware). Pure of clock/sensor reads (now passed in) so --test
# can drive a synthetic sequence. .therm-state stays the bare real-time HOT/OK the consumers expect.
therm_decide() {
  local max="$1" now="$2" recover=$((HOT-5))
  local prev; prev="$(cat "$STATE" 2>/dev/null || echo OK)"
  local hs cs lhe lhm lk
  read -r hs cs lhe lhm lk < <(cat "$ALERT_STATE" 2>/dev/null) || true
  [[ "$hs"  =~ ^[0-9]+$ ]] || hs=0
  [[ "$cs"  =~ ^[0-9]+$ ]] || cs=0
  [[ "$lhe" =~ ^[0-9]+$ ]] || lhe=0
  [[ "$lhm" =~ ^[0-9]+$ ]] || lhm=0
  [ -n "$lk" ] || lk=none
  local out
  if [ "$max" -gt "$HOT" ]; then
    hs=$((hs+1)); cs=0
    echo HOT > "$STATE"
    local fire=0
    if [ "$hs" -ge "$HOT_N" ]; then
      if [ "$lk" = hot ]; then
        # already in an announced hot episode → re-alert only on genuine escalation (and ≥5min apart)
        [ "$max" -ge $((lhm + ESCALATE)) ] && [ $((now - lhe)) -ge 300 ] && fire=1
      else
        # entering a hot episode → fire unless still inside the cooldown of the previous episode
        { [ "$lk" = none ] || [ $((now - lhe)) -ge "$COOLDOWN" ]; } && fire=1
      fi
    fi
    if [ "$fire" = 1 ]; then
      lhe="$now"; lhm="$max"; lk=hot
      alert "$(therm_tier "$max")" \
            "🌡 $(hostname) thermal HOT: ${max}°C (threshold ${HOT}°C) — $line" \
            "[therm-hot] $(hostname) ${max}°C (>${HOT}°C, ${HOT_N}+ consecutive) — $line"
      out=hot
    else
      out=hot-silent
    fi
  elif [ "$prev" = HOT ] && [ "$max" -gt "$recover" ]; then
    # hysteresis band: still hot-ish (recover<max≤HOT) — neither a hot read nor recovered. The
    # sustained-hot RUN is broken (reset hs so a re-hot needs fresh consecutive reads), not yet cooling.
    hs=0
    echo HOT > "$STATE"
    out=cooling
  else
    cs=$((cs+1)); hs=0
    echo OK > "$STATE"
    if [ "$lk" = hot ] && [ "$cs" -ge "$COOL_N" ]; then
      lk=cool
      # recovery rides the tier of the episode it closes (peak lhm): a near-shutdown alarm gets its
      # TG+board "all clear"; a routine flap's recovery stays in trace.
      alert "$(therm_tier "$lhm")" \
            "✅ $(hostname) thermal recovered: ${max}°C (peak ${lhm}°C)" \
            "[therm-cool] $(hostname) ${max}°C — recovered (${COOL_N}+ consecutive)"
      out=cool
    else
      out=ok
    fi
  fi
  printf '%s %s %s %s %s\n' "$hs" "$cs" "$lhe" "$lhm" "$lk" > "$ALERT_STATE"
  echo "$out"
}

# --- CSD: critical-slowing-down leading indicator (READ-ONLY instrument, off by default) ---
# Cross-domain transfer (SOC/power-law early-warning → this node's #1 failure mode, thermal throttle):
# near a critical transition a system recovers from perturbations SLOWER, so its own series shows
# rising VARIANCE + rising lag-1 AUTOCORRELATION BEFORE it crosses (Scheffer et al., Nature 2009;
# Dakos PMC3261433). This reads therm.log's max= series and reports whether that signature is present.
# DELIBERATELY ADVISORY: it prints an assessment and NOTHING ELSE — no board/TG/trace post, no shed
# gate, no .therm-state write. The threshold path above is untouched. Purpose: let the lead-time be
# VETTED against real throttle-collapse episodes before any alarm is wired (the false-positive bound —
# variance+AR1 also rise on a noise-regime shift, Dakos PMC4247400 — is why this is an instrument first).
# See ~/.mesh/knowledge/review-critical-slowing-down-thermal-resilience-2026-06-21.md.
CSD_WIN="${MESH_THERM_CSD_WIN:-24}"    # samples in the window (24 × 5min ≈ 2h)
CSD_MIN="${MESH_THERM_CSD_MIN:-8}"     # minimum samples before assessing
CSD_BAND="${MESH_THERM_CSD_BAND:-78}"  # 'elevated band' floor: a PRECURSOR needs recent mean ≥ this AND < HOT

csd_assess() {  # reads whitespace-separated temps (oldest→newest) on stdin → one verdict line on stdout
  python3 -c '
import sys
xs=[float(t) for t in sys.stdin.read().split() if t.strip()]
band=float(sys.argv[1]); hot=float(sys.argv[2]); mn=int(sys.argv[3]); n=len(xs)
if n < mn:
    print("INSUFFICIENT samples=%d need=%d" % (n, mn)); sys.exit(0)
def var(a):
    m=sum(a)/len(a); return sum((v-m)**2 for v in a)/len(a)
def ar1(a):
    m=sum(a)/len(a); d=sum((v-m)**2 for v in a)
    return 0.0 if d==0 else sum((a[i]-m)*(a[i+1]-m) for i in range(len(a)-1))/d
h=n//2; old=xs[:h]; rec=xs[h:]
vo,vr=var(old),var(rec); ao,ar=ar1(old),ar1(rec); rm=sum(rec)/len(rec)
rising=(vr>vo) and (ar>ao); elevated=(rm>=band) and (rm<hot)
verdict="PRECURSOR" if (rising and elevated) else ("RISING-LOW" if rising else "STABLE")
print("%s var:%.2f->%.2f ar1:%.3f->%.3f recent_mean:%.1f band:[%.0f,%.0f) n:%d"
      % (verdict, vo, vr, ao, ar, rm, band, hot, n))
' "$CSD_BAND" "$HOT" "$CSD_MIN"
}

if [ "${1:-}" = --test ]; then
  command -v mesh-therm >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-therm)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # ---- synthetic debounce/cooldown sequence (hardware-independent; the cry-wolf fix is the point) ----
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  export MESH_ALERT_DRYRUN=1 STATE="$_td/state" ALERT_STATE="$_td/astate"
  HOT=88 HOT_N=2 COOL_N=2 COOLDOWN=1800 ESCALATE=4 CRIT=98; line="(test)"
  fail=0; chk(){ [ "$2" = "$3" ] || { echo "  FAIL: $1 → expected '$3', got '$2'"; fail=1; }; }
  # tiering: only a near-shutdown (≥CRIT) reaches the operator TG + board; routine flap → trace only.
  chk "tier 89°C routine"  "$(therm_tier 89)"  trace
  chk "tier 97°C routine"  "$(therm_tier 97)"  trace
  chk "tier 98°C critical" "$(therm_tier 98)"  board
  chk "tier 100°C critical" "$(therm_tier 100)" board
  chk "single 96°C spike"        "$(therm_decide 96 0)"    hot-silent   # debounce: one read never alerts
  chk "2nd 96°C (sustained)"     "$(therm_decide 96 300)"  hot          # fires after HOT_N consecutive
  chk "80°C dip (1st cool)"      "$(therm_decide 80 600)"  ok           # COOL_N not met → no recovery yet
  chk "80°C (2nd cool)"          "$(therm_decide 80 900)"  cool         # recovered after COOL_N consecutive
  chk "96°C re-heat #1"          "$(therm_decide 96 1200)" hot-silent
  chk "96°C re-heat #2 (cooldown)" "$(therm_decide 96 1500)" hot-silent # inside COOLDOWN of the 300s episode → suppressed
  chk "96°C past cooldown"       "$(therm_decide 96 2200)" hot          # now-300 ≥ 1800 → new episode alerts
  chk "100°C escalation"         "$(therm_decide 100 2520)" hot         # +4°C climb inside cooldown → escalation fires
  chk "85°C hysteresis band"     "$(therm_decide 85 2820)" cooling      # recover<max≤HOT → no recovery, no alert
  # .therm-state must remain the bare consumer token
  grep -qxE 'HOT|OK' "$STATE" || { echo "  FAIL: .therm-state not bare HOT/OK: $(cat "$STATE")"; fail=1; }
  # ---- CSD instrument (read-only leading-indicator; synthetic series of KNOWN behaviour) ----
  if command -v python3 >/dev/null 2>&1; then
    CSD_BAND=78 CSD_MIN=8
    # flat/stationary: low variance, no rising AR1 → STABLE (no false precursor)
    chk "csd flat→STABLE" "$(printf '84 85 84 85 84 85 84 85 84 85 84 85' | csd_assess | cut -d' ' -f1)" STABLE
    # 1st half = tight alternation (low var, negative AR1); 2nd half = wide smooth excursion (high var,
    # positive AR1) with recent mean in [78,88) → the textbook CSD signature → PRECURSOR
    chk "csd rising-in-band→PRECURSOR" "$(printf '85 83 85 83 85 83 78 81 84 87 84 81 78 81' | csd_assess | cut -d' ' -f1)" PRECURSOR
    # rising var+ar1 but recent mean BELOW the band → RISING-LOW (signature without thermal relevance)
    chk "csd rising-cold→RISING-LOW" "$(printf '70 68 70 68 70 68 62 65 68 71 68 65 62 65' | csd_assess | cut -d' ' -f1)" RISING-LOW
    # too few samples → INSUFFICIENT (never a false verdict on a short series)
    chk "csd short→INSUFFICIENT" "$(printf '84 85 84' | csd_assess | cut -d' ' -f1)" INSUFFICIENT
  fi
  [ "$fail" = 0 ] && { echo "smoke-test: ok (debounce kills single spike; cooldown collapses oscillation storm; escalation still fires; .therm-state contract intact)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

# --csd: read-only critical-slowing-down assessment over therm.log (no live snapshot needed; advisory only)
if [ "${1:-}" = --csd ]; then
  command -v python3 >/dev/null 2>&1 || { echo "csd: unavailable (no python3) — threshold path unaffected"; exit 0; }
  [ -f "$LOG" ] || { echo "csd: no therm.log yet (nothing to assess)"; exit 0; }
  series="$(grep -oE 'max=[0-9]+' "$LOG" 2>/dev/null | cut -d= -f2 | tail -n "$CSD_WIN" | tr '\n' ' ')"
  v="$(printf '%s' "$series" | csd_assess)"
  echo "mesh-therm-watch CSD (read-only, advisory — not wired to any alarm/shed): $v"
  case "$v" in
    PRECURSOR*) echo "  → losing thermal resilience: variance AND lag-1 autocorrelation both rising while in the elevated band [<${HOT}°C] — an approaching-transition precursor. Lead-time must be vetted vs real throttle-collapse logs before this gates anything." ;;
    RISING-LOW*) echo "  → CSD signature present (var+ar1 rising) but recent mean is outside the elevated band — not (yet) a thermal-approach precursor." ;;
  esac
  exit 0
fi

read_snapshot
[ -n "$line" ] || { echo "mesh-therm produced nothing (not an alarm)"; exit 0; }
[ -n "$max" ] || { echo "max-temp parse failed (not an alarm): $line"; exit 0; }

if [ "${1:-}" = --status ]; then echo "$line"; exit 0; fi

mkdir -p "$HOME/.mesh"
printf '%s\n' "$line" >> "$LOG"
# cheap rotation — the artifact is recency, not history
[ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 2000 ] && { tail -1000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }

kind="$(therm_decide "$max" "$(date +%s)")"
case "$kind" in
  hot)        echo "therm: HOT ${max}°C (alerted)"; exit 1 ;;
  hot-silent) echo "therm: HOT ${max}°C (debounced/cooldown — no alert)"; exit 1 ;;
  cooling)    echo "therm: cooling ${max}°C (hysteresis, recover below $((HOT - 5))°C)"; exit 1 ;;
  cool)       echo "therm: recovered ${max}°C (alerted)"; exit 0 ;;
  *)          echo "therm: ok ${max}°C"; exit 0 ;;
esac
