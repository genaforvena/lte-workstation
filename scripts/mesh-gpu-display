#!/usr/bin/env bash
# mesh-gpu-display — live NVIDIA physical-display attachment/initialization sense.
#
# Source: nvidia-smi display_attached and display_active fields.  A failed or malformed
# driver read is UNKNOWN (exit 2), never a guessed headless/idle state.
#
#   mesh-gpu-display          human reading
#   mesh-gpu-display --json   machine reading
#   mesh-gpu-display --test   fixture parser + live-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SMI="${MESH_GPU_DISPLAY_SMI:-nvidia-smi}"
MODE=text
[ "${1:-}" = --json ] && MODE=json

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

read_display() {
  local raw gpu pci attached active
  raw="$("$SMI" --query-gpu=uuid,pci.bus_id,display_attached,display_active --format=csv,noheader,nounits 2>/dev/null)" || return 2
  raw="$(printf '%s\n' "$raw" | sed '/^[[:space:]]*$/d' | head -n1)"
  [ -n "$raw" ] || return 2
  IFS=',' read -r gpu pci attached active _rest <<<"$raw"
  gpu="$(trim "${gpu:-}")"; pci="$(trim "${pci:-}")"
  attached="$(trim "${attached:-}")"; active="$(trim "${active:-}")"
  case "$gpu" in GPU-*) ;; *) return 2 ;; esac
  case "$pci" in *:*) ;; *) return 2 ;; esac
  case "$attached" in Yes|No) ;; *) return 2 ;; esac
  case "$active" in Enabled|Disabled) ;; *) return 2 ;; esac
  if [ "$MODE" = json ]; then
    printf '{"display_attached":"%s","display_active":"%s","gpu":"%s","pci":"%s","ts":"%s"}\n' \
      "$attached" "$active" "$gpu" "$pci" "$(date -u +%FT%TZ)"
  else
    printf '[gpu-display] display_attached=%s display_active=%s gpu=%s pci=%s\n' \
      "$attached" "$active" "$gpu" "$pci"
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  cat >"$td/smi" <<'EOF'
#!/usr/bin/env bash
printf 'GPU-test, 00000000:2B:00.0, Yes, Enabled\n'
EOF
  chmod +x "$td/smi"
  out="$(MESH_GPU_DISPLAY_SMI="$td/smi" "$0")"; rc=$?
  [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -q 'display_attached=Yes display_active=Enabled' || {
    echo "smoke-test: FAIL (fixture read rc=$rc output=$out)"; exit 1;
  }
  live="$(read_display)"; live_rc=$?
  if [ "$live_rc" -eq 0 ]; then
    printf 'smoke-test: ok (fixture + live read: %s)\n' "$live"
    exit 0
  fi
  echo "smoke-test: n/a — fixture passed but nvidia-smi unavailable or unreadable (honest exit 2)"
  exit 2
fi

read_display
exit $?
