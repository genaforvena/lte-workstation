#!/usr/bin/env bash
# orphan-ok: prototype fusion, on-demand only — wire a cron cadence once a real consumer needs it
#   (mesh-situation/mesh-perimeter), per "wire on demand, don't pre-build" (discover mission doctrine)
# mesh-occupancy-anomaly — CONNECTION fusion: mesh-household-state (whole-household mode:
# ACTIVE/ASLEEP/AWAY/UNCERTAIN) x mesh-room-trace (this room's recent-occupancy trace:
# OCCUPIED/RECENT/VACANT/UNKNOWN). Neither alone answers "should THIS room be occupied right
# now?" — household-state is house-wide granularity, room-trace has no notion of household mode.
# Crossed: a household mode that says nobody-should-be-here (ASLEEP/AWAY) alongside a room trace
# that says someone-is-here (OCCUPIED/RECENT) is a discrepancy neither sensor can raise alone —
# the same "cross senses, alarm on the mismatch" idiom mesh-perimeter/mesh-tamper already use,
# applied to household-mode x room-occupancy specifically (unfused before this, mesh-prior-art
# clean 2026-07-29).
#
#   mesh-occupancy-anomaly           one line: verdict + gloss
#   mesh-occupancy-anomaly --json    machine-readable
#   mesh-occupancy-anomaly --test    classify_occupancy fixtures (offline) + live reachability gate
#
# Read-only. Honest-organ: either input n/a (UNCERTAIN household / UNKNOWN room-trace) → verdict
# UNKNOWN, never a fabricated CONSISTENT/ANOMALY out of a source that couldn't actually see.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# classify_occupancy <household ACTIVE|ASLEEP|AWAY|UNCERTAIN> <room OCCUPIED|RECENT|VACANT|UNKNOWN>
#   → echoes "VERDICT|gloss" (pure, offline-testable)
classify_occupancy() {
  local hh="$1" rm="$2"
  # Honest-n/a: household-state's blind sentinels are BOTH UNCERTAIN (sensors ambiguous)
  # and UNKNOWN (sensed:false / exit-2 — it explicitly couldn't see); room-trace's is UNKNOWN.
  # Any of them must render UNKNOWN, never fold into a fabricated CONSISTENT/ANOMALY.
  if [ "$hh" = "UNCERTAIN" ] || [ "$hh" = "UNKNOWN" ] || [ "$rm" = "UNKNOWN" ]; then
    echo "UNKNOWN|household=${hh} room=${rm} — one input can't see, no verdict"
    return
  fi
  case "$hh" in
    ASLEEP|AWAY)
      case "$rm" in
        OCCUPIED|RECENT)
          echo "ANOMALY|household=${hh} but room-trace=${rm} — unexpected occupancy"
          return;;
      esac;;
  esac
  echo "CONSISTENT|household=${hh} room-trace=${rm} — no discrepancy"
}

if [ "${1:-}" = --test ]; then
  command -v mesh-household-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-household-state)"; exit 1; }
  command -v mesh-room-trace >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-room-trace)"; exit 1; }
  _f=0
  # THE FUSION — discrepancy cases (the signal neither sensor gives alone):
  [ "$(classify_occupancy ASLEEP OCCUPIED)" = "ANOMALY|household=ASLEEP but room-trace=OCCUPIED — unexpected occupancy" ] \
    || { echo "  FAIL: ASLEEP+OCCUPIED -> ANOMALY"; _f=1; }
  [ "$(classify_occupancy AWAY RECENT)" = "ANOMALY|household=AWAY but room-trace=RECENT — unexpected occupancy" ] \
    || { echo "  FAIL: AWAY+RECENT -> ANOMALY"; _f=1; }
  # Consistent cases:
  [ "$(classify_occupancy ACTIVE OCCUPIED)" = "CONSISTENT|household=ACTIVE room-trace=OCCUPIED — no discrepancy" ] \
    || { echo "  FAIL: ACTIVE+OCCUPIED -> CONSISTENT"; _f=1; }
  [ "$(classify_occupancy ASLEEP VACANT)" = "CONSISTENT|household=ASLEEP room-trace=VACANT — no discrepancy" ] \
    || { echo "  FAIL: ASLEEP+VACANT -> CONSISTENT"; _f=1; }
  [ "$(classify_occupancy ACTIVE VACANT)" = "CONSISTENT|household=ACTIVE room-trace=VACANT — no discrepancy" ] \
    || { echo "  FAIL: ACTIVE+VACANT (active elsewhere in house) -> CONSISTENT"; _f=1; }
  # Honest-degraded — either source n/a must NOT be silently folded into CONSISTENT/ANOMALY:
  [ "$(classify_occupancy UNCERTAIN OCCUPIED)" = "UNKNOWN|household=UNCERTAIN room=OCCUPIED — one input can't see, no verdict" ] \
    || { echo "  FAIL: UNCERTAIN household -> UNKNOWN (not silently CONSISTENT)"; _f=1; }
  [ "$(classify_occupancy AWAY UNKNOWN)" = "UNKNOWN|household=AWAY room=UNKNOWN — one input can't see, no verdict" ] \
    || { echo "  FAIL: UNKNOWN room-trace -> UNKNOWN (not silently CONSISTENT)"; _f=1; }
  # household-state's fully-blind sentinel is {"state":"UNKNOWN","sensed":false} (its exit-2/na path),
  # NOT UNCERTAIN — it must also render UNKNOWN, never a fabricated CONSISTENT from a source that couldn't see:
  [ "$(classify_occupancy UNKNOWN OCCUPIED)" = "UNKNOWN|household=UNKNOWN room=OCCUPIED — one input can't see, no verdict" ] \
    || { echo "  FAIL: UNKNOWN household (sensed:false) -> UNKNOWN (not silently CONSISTENT)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_occupancy logic)"; exit 1; }
  # --- live reachability gate (both sources run locally, no phone dependency) ---
  mesh-household-state --json >/dev/null 2>&1; hrc=$?
  mesh-room-trace --json >/dev/null 2>&1; rrc=$?
  if [ "$hrc" != 0 ] || [ "$rrc" != 0 ]; then
    echo "smoke-test: n/a (household-state rc=$hrc / room-trace rc=$rrc — a live source unreachable); classify-logic ok"; exit 2
  fi
  echo "smoke-test: ok (classify_occupancy: 2 discrepancy + 3 consistent + 3 honest-n/a cases; both live sources reachable)"; exit 0
fi

want_json=0
for a in "$@"; do case "$a" in --json) want_json=1;; esac; done

hh_json="$(mesh-household-state --json 2>/dev/null)"; hrc=$?
rm_json="$(mesh-room-trace --json 2>/dev/null)"; rrc=$?
[ "$hrc" = 0 ] && [ -n "$hh_json" ] || { echo "occupancy-anomaly n/a — household-state unreachable" >&2; exit 2; }
[ "$rrc" = 0 ] || [ "$rrc" = 2 ] || { echo "occupancy-anomaly n/a — room-trace failed (rc=$rrc)" >&2; exit 2; }
[ -n "$rm_json" ] || { echo "occupancy-anomaly n/a — room-trace gave no output" >&2; exit 2; }

hh="$(printf '%s' "$hh_json" | grep -oE '"state":"[A-Z]+"' | head -1 | cut -d'"' -f4)"
rm="$(printf '%s' "$rm_json" | grep -oE '"verdict":"[A-Z]+"' | head -1 | cut -d'"' -f4)"
[ -n "$hh" ] && [ -n "$rm" ] || { echo "occupancy-anomaly n/a — could not parse a source" >&2; exit 2; }

vg="$(classify_occupancy "$hh" "$rm")"
verdict="${vg%%|*}"; gloss="${vg#*|}"

if [ "$want_json" = 1 ]; then
  printf '{"verdict":"%s","household":"%s","room":"%s","gloss":"%s"}\n' "$verdict" "$hh" "$rm" "$gloss"
else
  echo "[occupancy-anomaly] ${verdict} — ${gloss}"
fi
