#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.hw-ingress-state 900 sys
# mesh-hw-ingress — relation between host hardware interrupts and physical NIC ingress.
#
# The mesh already reads NIC loss/quality and IRQ distribution, but not whether packets arriving
# on a real interface are accompanied by kernel interrupt work.  This is a joint observation:
#   /proc/stat intr                  total hardware interrupts
#   /sys/class/net/*/statistics/rx_packets on interfaces with a physical /device
# INGRESS_ACTIVE, IRQ_WITHOUT_RX, RX_WITHOUT_IRQ, and QUIET are distinct relations; no axis is
# selected as a worst-of verdict.  Counters are monotonic only within one boot.
#
# mesh-hw-ingress                 one live interval reading
# mesh-hw-ingress --json          machine-readable reading
# mesh-hw-ingress --edge          emit only when the relation changes
# mesh-hw-ingress --test          fixture arithmetic + REAL proc/sys counter read
# Exit 2 means the live counter organ is unreachable or has no same-boot baseline.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="${MESH_HW_INGRESS_STATE:-$HOME/.mesh/.hw-ingress-state}"
PROC_STAT="${MESH_HW_INGRESS_PROC_STAT:-/proc/stat}"
NET_ROOT="${MESH_HW_INGRESS_NET_ROOT:-/sys/class/net}"
BOOT_FILE="${MESH_HW_INGRESS_BOOT_FILE:-/proc/sys/kernel/random/boot_id}"

read_snapshot() {
  local stat="$1" root="$2" bootfile="$3" intr rx n=0 d v
  intr="$(awk '$1 == "intr" {print $2; exit}' "$stat" 2>/dev/null)" || return 2
  case "$intr" in ''|*[!0-9]*) return 2;; esac
  [ -r "$bootfile" ] || return 2
  boot="$(tr -d '[:space:]' <"$bootfile" 2>/dev/null)" || return 2
  [ -n "$boot" ] || return 2
  [ -d "$root" ] || return 2
  rx=0
  shopt -s nullglob
  for d in "$root"/*; do
    [ -d "$d/device" ] || continue
    v="$(cat "$d/statistics/rx_packets" 2>/dev/null)" || continue
    case "$v" in ''|*[!0-9]*) continue;; esac
    rx=$((rx + v)); n=$((n + 1))
  done
  shopt -u nullglob
  [ "$n" -gt 0 ] || return 2
  printf '%s|%s|%s|%s\n' "$boot" "$intr" "$rx" "$n"
}

classify() {
  local intr_delta="$1" rx_delta="$2"
  if [ "$intr_delta" -gt 0 ] && [ "$rx_delta" -gt 0 ]; then echo INGRESS_ACTIVE
  elif [ "$intr_delta" -gt 0 ]; then echo IRQ_WITHOUT_RX
  elif [ "$rx_delta" -gt 0 ]; then echo RX_WITHOUT_IRQ
  else echo QUIET
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d "${TMPDIR:-/tmp}/mesh-hw-ingress.XXXXXX")" || exit 1
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/enp0/device" "$td/net/enp0/statistics"
  printf 'intr 100 0 0\n' >"$td/stat"
  printf 'boot-fixture\n' >"$td/boot"
  printf '40\n' >"$td/net/enp0/statistics/rx_packets"
  before="$(read_snapshot "$td/stat" "$td/net" "$td/boot")" || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  printf 'intr 130 0 0\n' >"$td/stat"
  printf '90\n' >"$td/net/enp0/statistics/rx_packets"
  after="$(read_snapshot "$td/stat" "$td/net" "$td/boot")" || { echo 'smoke-test: FAIL (fixture second read)'; exit 1; }
  IFS='|' read -r _bi bi br _bn <<<"$before"
  IFS='|' read -r _ai ai ar _an <<<"$after"
  [ "$(classify "$((ai-bi))" "$((ar-br))")" = INGRESS_ACTIVE ] || { echo 'smoke-test: FAIL (joint classifier)'; exit 1; }
  [ "$(classify 4 0)" = IRQ_WITHOUT_RX ] || { echo 'smoke-test: FAIL (IRQ-only classifier)'; exit 1; }
  [ "$(classify 0 4)" = RX_WITHOUT_IRQ ] || { echo 'smoke-test: FAIL (RX-only classifier)'; exit 1; }
  [ "$(classify 0 0)" = QUIET ] || { echo 'smoke-test: FAIL (quiet classifier)'; exit 1; }
  MESH_HW_INGRESS_NET_ROOT="$td/missing" read_snapshot "$td/stat" "$td/missing" "$td/boot" >/dev/null 2>&1 && { echo 'smoke-test: FAIL (missing net root succeeded)'; exit 1; }
  live="$(read_snapshot "$PROC_STAT" "$NET_ROOT" "$BOOT_FILE")" || { echo 'smoke-test: n/a (physical NIC counters unavailable)'; exit 2; }
  echo "smoke-test: ok (fixture relation + REAL interrupt/NIC read: ${live#*|})"
  exit 0
fi

snap="$(read_snapshot "$PROC_STAT" "$NET_ROOT" "$BOOT_FILE")" || {
  echo "mesh-hw-ingress: UNKNOWN — no readable interrupt + physical-NIC counters" >&2; exit 2;
}
IFS='|' read -r boot intr rx n <<<"$snap"
prev_boot=""; prev_intr=""; prev_rx=""; prev_n=""
if [ -r "$STATE" ]; then IFS='|' read -r prev_boot prev_intr prev_rx prev_n <"$STATE"; fi

mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
if [ "$prev_boot" != "$boot" ] || ! [[ "$prev_intr" =~ ^[0-9]+$ ]] || ! [[ "$prev_rx" =~ ^[0-9]+$ ]] ||
   [ "$intr" -lt "$prev_intr" ] || [ "$rx" -lt "$prev_rx" ]; then
  printf '%s|%s|%s|%s\n' "$boot" "$intr" "$rx" "$n" >"$STATE" || exit 1
  mesh-state-touch "$STATE" >/dev/null 2>&1 || exit 1
  echo "mesh-hw-ingress: UNKNOWN — baseline seeded; awaiting a same-boot interval" >&2
  exit 2
fi

di=$((intr - prev_intr)); dr=$((rx - prev_rx)); verdict="$(classify "$di" "$dr")"
old=""
[ -r "$STATE.prev" ] && old="$(sed -n '1s/|.*//p' "$STATE.prev" 2>/dev/null || true)"
printf '%s|%s|%s|%s\n' "$boot" "$intr" "$rx" "$n" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || exit 1
if [ "${1:-}" = --edge ]; then
  [ "$old" = "$verdict" ] && exit 0
  printf '%s\n' "$verdict" >"$STATE.prev" || exit 1
else
  printf '%s\n' "$verdict" >"$STATE.prev" || exit 1
fi
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","interrupt_delta":%s,"rx_packets_delta":%s,"physical_interfaces":%s}\n' "$verdict" "$di" "$dr" "$n"
else
  printf '[hw-ingress] %s — interrupts=%s rx-packets=%s physical-interfaces=%s\n' "$verdict" "$di" "$dr" "$n"
fi
