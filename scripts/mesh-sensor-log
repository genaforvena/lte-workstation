#!/usr/bin/env bash
# mesh-sensor-log — append timestamped sensor rows to ~/.mesh/sensors.log + query tools.
# Row format: ISO8601 node sensor_type values...  (no schema, append-only text)
#
#   mesh-sensor-log              collect one round of sensor readings (cron mode)
#   mesh-sensor-log --tail [N]   last N rows (default 20), formatted
#   mesh-sensor-log --grep TYPE  filter rows by sensor type prefix
#   mesh-sensor-log --diff       compare last 2 snapshots; emits SAME_ROOM/MOVED verdict
#   mesh-sensor-log --edge       cron reflex: post [room-moved] once when dominant AP changes
#   mesh-sensor-log --test       smoke test (exit 2 = no log dir, not a FAIL)
set -u
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "${MESH_NODES_FILE:-$HOME/.mesh/nodes}" ] && . "${MESH_NODES_FILE:-$HOME/.mesh/nodes}"

LOG="${MESH_SENSOR_LOG:-$HOME/.mesh/sensors.log}"

case "${1:-}" in
  --test)
    [ -d "$HOME/.mesh" ] || { echo "smoke-test: n/a (no ~/.mesh dir)"; exit 2; }
    command -v nmcli >/dev/null 2>&1 || command -v iwlist >/dev/null 2>&1 \
      || echo "smoke-test: WARN (no wifi scanner — wifi_rssi rows will be empty)"
    echo "smoke-test: ok"; exit 0
    ;;

  --tail)
    [ -f "$LOG" ] || { echo "(no sensors.log yet)"; exit 0; }
    N="${2:-20}"
    tail -"$N" "$LOG" | awk '{
      ts=$1; node=$2; type=$3;
      # shorten node to hostname short form
      n=node; sub(/imozerov-/,"",n); sub(/-3-15IIL05/,"",n)
      vals=""; for(i=4;i<=NF;i++) vals=vals (i>4?" ":"") $i
      printf "%-24s %-12s %-18s %s\n", ts, n, type, vals
    }'
    exit 0
    ;;

  --grep)
    [ -f "$LOG" ] || { echo "(no sensors.log yet)"; exit 0; }
    TYPE="${2:?usage: mesh-sensor-log --grep <sensor_type>}"
    grep " ${TYPE}" "$LOG" | tail -50 | awk '{
      ts=$1; node=$2; type=$3;
      n=node; sub(/imozerov-/,"",n); sub(/-3-15IIL05/,"",n)
      vals=""; for(i=4;i<=NF;i++) vals=vals (i>4?" ":"") $i
      printf "%-24s %-12s %-18s %s\n", ts, n, type, vals
    }'
    exit 0
    ;;

  --edge)
    # Edge reflex for cron (*/5): post [room-moved] once when dominant WiFi AP changes.
    # Silent on no-change. No false "same room" on missing log or no wifi data.
    [ -f "$LOG" ] || exit 0
    STATE="${MESH_ROOM_STATE:-$HOME/.mesh/.room-fp-state}"
    dom=$(python3 - "$LOG" <<'PYEOF'
import sys, re
from collections import defaultdict
snaps = defaultdict(lambda: defaultdict(list))
for line in open(sys.argv[1]):
    p = line.strip().split()
    if len(p) >= 5 and p[2] == "wifi_rssi":
        try:
            snaps[p[0]][p[1]].append((p[3], int(p[4])))
        except (ValueError, IndexError):
            pass
if not snaps:
    sys.exit(0)
ts_last = sorted(snaps)[-1]
for node, rows in sorted(snaps[ts_last].items()):
    if rows:
        best = max(rows, key=lambda x: x[1])
        short = re.sub(r'imozerov-', '', re.sub(r'-3-15IIL05', '', node))
        print(f"{short}:{best[0]}")
PYEOF
) || exit 0
    [ -n "$dom" ] || exit 0
    last="$(cat "$STATE" 2>/dev/null || true)"
    printf '%s\n' "$dom" > "$STATE"
    [ "$dom" = "$last" ] && exit 0
    [ -z "$last" ] && exit 0   # first run: seed state, no event
    command -v mesh-chat >/dev/null 2>&1 && \
      mesh-chat "[room-moved] dominant AP changed: ${last} → ${dom}" >/dev/null 2>&1 || true
    exit 0
    ;;

  --diff)
    [ -f "$LOG" ] || { echo "mesh-sensor-log --diff: no sensors.log yet"; exit 0; }
    python3 - "$LOG" <<'PYEOF'
import sys, re
from collections import defaultdict

log_path = sys.argv[1]
# Parse: TS NODE TYPE rest...
# Build snapshots: dict[ts][node][type] = list of value-strings
snaps = defaultdict(lambda: defaultdict(lambda: defaultdict(list)))
with open(log_path) as f:
    for line in f:
        parts = line.strip().split()
        if len(parts) < 3:
            continue
        ts, node, stype = parts[0], parts[1], parts[2]
        vals = " ".join(parts[3:])
        snaps[ts][node][stype].append(vals)

ts_sorted = sorted(snaps.keys())
if len(ts_sorted) < 2:
    print("mesh-sensor-log --diff: need at least 2 snapshots")
    sys.exit(0)

# Use last 2 unique timestamps that have data
ts_old, ts_new = ts_sorted[-2], ts_sorted[-1]
old, new_ = snaps[ts_old], snaps[ts_new]

# Union of nodes
nodes = sorted(set(old) | set(new_))
print(f"diff {ts_old} → {ts_new}")

moved_signals = []
for node in nodes:
    short = re.sub(r'imozerov-', '', re.sub(r'-3-15IIL05', '', node))
    o, n = old.get(node, {}), new_.get(node, {})
    all_types = sorted(set(o) | set(n))
    for stype in all_types:
        ov, nv = o.get(stype, []), n.get(stype, [])
        if stype == "wifi_rssi":
            # parse as SSID:rssi pairs, compare top AP
            def parse_wifi(rows):
                d = {}
                for r in rows:
                    parts = r.split()
                    if len(parts) >= 2:
                        try:
                            d[parts[0]] = int(parts[1])
                        except ValueError:
                            pass
                return d
            od, nd = parse_wifi(ov), parse_wifi(nv)
            appeared = [s for s in nd if s not in od]
            disappeared = [s for s in od if s not in nd]
            changed = {s: (od[s], nd[s]) for s in od if s in nd and abs(od[s]-nd[s]) >= 5}
            # dominant AP (highest RSSI)
            dom_old = max(od, key=od.get) if od else None
            dom_new = max(nd, key=nd.get) if nd else None
            if dom_old != dom_new:
                print(f"  {short} wifi_rssi: dominant AP {dom_old}→{dom_new}  *** ROOM CHANGE SIGNAL ***")
                moved_signals.append(f"{short}: dominant AP changed")
            elif changed:
                cstr = " ".join(f"{s}:{a}→{b}" for s, (a, b) in list(changed.items())[:3])
                print(f"  {short} wifi_rssi: {cstr}")
            if appeared:
                print(f"  {short} wifi_rssi: appeared {' '.join(appeared[:3])}")
                if len(appeared) >= 2:
                    moved_signals.append(f"{short}: {len(appeared)} new APs")
            if disappeared:
                print(f"  {short} wifi_rssi: gone {' '.join(disappeared[:3])}")
        elif stype in ("cpu_temp",):
            try:
                ov_f = float(ov[-1]) if ov else None
                nv_f = float(nv[-1]) if nv else None
                if ov_f is not None and nv_f is not None and abs(ov_f - nv_f) >= 1:
                    print(f"  {short} {stype}: {ov_f}→{nv_f}")
            except ValueError:
                pass
        elif stype == "room_sense":
            if ov != nv:
                print(f"  {short} {stype}: {ov[-1] if ov else '?'}→{nv[-1] if nv else '?'}")
        elif stype in ("phone_battery", "phone_light"):
            if ov and nv and ov[-1] != nv[-1]:
                print(f"  {short} {stype}: {ov[-1]}→{nv[-1]}")

print()
if moved_signals:
    print(f"verdict: MOVED — {'; '.join(moved_signals)}")
else:
    print("verdict: SAME_ROOM (no significant WiFi change)")
PYEOF
    exit 0
    ;;
esac

LOG="${MESH_SENSOR_LOG:-$HOME/.mesh/sensors.log}"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NODE="${HOSTNAME:-$(hostname)}"
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
# probe-based resolver: TS→LAN→ADB tunnel; pass port+user env so mesh-phone-ip uses the right probe
PHONE_IP="$(PHONE_SSH_PORT="$PHONE_PORT" PHONE_USER="$PHONE_USER" mesh-phone-ip 2>/dev/null)" || PHONE_IP=""

log() { printf '%s %s %s\n' "$TS" "$NODE" "$*" >> "$LOG"; }

# ── Hardware: all thermal zones + x86 package temp ──────────────────────────
for tz in /sys/class/thermal/thermal_zone*/; do
  _t=$(cat "${tz}temp" 2>/dev/null); _type=$(cat "${tz}type" 2>/dev/null | tr ' ' '_')
  [ -n "$_t" ] && [ -n "$_type" ] && log "therm_${_type} $(echo "scale=1; $_t/1000" | bc 2>/dev/null || echo "$_t")"
done 2>/dev/null || true

# ── Hardware: fan speeds (via sensors if lm-sensors present) ─────────────────
if command -v sensors >/dev/null 2>&1; then
  sensors 2>/dev/null | grep -iE "fan|rpm" | while read -r line; do
    _fan=$(printf '%s' "$line" | grep -o '[0-9]* RPM' | grep -o '[0-9]*' | head -1)
    _fname=$(printf '%s' "$line" | cut -d: -f1 | tr ' ' '_' | tr -cd 'A-Za-z0-9_-')
    [ -n "$_fan" ] && log "fan_${_fname} $_fan"
  done 2>/dev/null || true
fi

# ── Hardware: disk health (S.M.A.R.T. temperature, no sudo needed for NVMe) ──
for dev in /dev/nvme0 /dev/sda /dev/sdb; do
  [ -b "$dev" ] || continue
  _dtemp=$(smartctl -A "$dev" 2>/dev/null | grep -iE 'Temper|194' | grep -o '[0-9]*$' | head -1)
  [ -n "$_dtemp" ] && log "disk_temp_$(basename "$dev") $_dtemp"
done 2>/dev/null || true

# ── Hardware: memory pressure ─────────────────────────────────────────────────
_memtotal=$(grep '^MemTotal' /proc/meminfo 2>/dev/null | awk '{print $2}')
_memavail=$(grep '^MemAvailable' /proc/meminfo 2>/dev/null | awk '{print $2}')
if [ -n "$_memtotal" ] && [ -n "$_memavail" ] && [ "$_memtotal" -gt 0 ]; then
  _mempct=$(echo "scale=1; (($_memtotal - $_memavail) * 100) / $_memtotal" | bc 2>/dev/null || true)
  [ -n "$_mempct" ] && log "mem_used_pct $_mempct"
fi

# ── Hardware: CPU load (1-min average) ───────────────────────────────────────
_load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
[ -n "$_load" ] && log "cpu_load1 $_load"

# ── WiFi RSSI (local node) ───────────────────────────────────────────────────
(nmcli -t -f SSID,SIGNAL dev wifi list 2>/dev/null || true) | while IFS=: read -r ssid sig; do
  [ -n "$ssid" ] && [ -n "$sig" ] && log "wifi_rssi $(printf '%s' "$ssid" | tr ' ' '_') $sig"
done || true

# ── CPU temperature ──────────────────────────────────────────────────────────
_temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
[ -n "$_temp" ] && log "cpu_temp $(echo "scale=1; $_temp/1000" | bc 2>/dev/null || echo "$_temp")"

# ── Phone sensors (best-effort, skip if unreachable) ─────────────────────────
# No python3/jq on Termux — use grep/sed for JSON parsing
# Re-probe IP here (not cached from top): TS may go dark in the ~14s the prior reads take
_phone_data=""
PHONE_IP_NOW="$(PHONE_SSH_PORT="$PHONE_PORT" PHONE_USER="$PHONE_USER" mesh-phone-ip 2>/dev/null)" || PHONE_IP_NOW=""
[ -n "$PHONE_IP_NOW" ] && _phone_data=$(timeout 12 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP_NOW}" '
  b=$(termux-battery-status 2>/dev/null)
  if [ -n "$b" ]; then
    pct=$(printf "%s" "$b" | grep "\"percentage\"" | grep -o "[0-9]*")
    sts=$(printf "%s" "$b" | grep "\"status\"" | sed '"'"'s/.*"\([A-Z]*\)".*/\1/'"'"' | tr "[:upper:]" "[:lower:]")
    # battery temperature = best ambient-air proxy in the mesh (phone idle, not charging)
    tmp=$(printf "%s" "$b" | grep "\"temperature\"" | grep -o "[0-9.]*")
    printf "battery %s %s\n" "$pct" "$sts"
    [ -n "$tmp" ] && printf "battery_temp %s\n" "$tmp"
  fi
  lux=$(termux-sensor -s tmd2755_l -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -o "[0-9.-]*" | head -1)
  [ -n "$lux" ] && printf "light %s\n" "$lux"
  step=$(termux-sensor -s bma420 -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -o "[0-9.-]*" | head -1)
  [ -n "$step" ] && printf "steps %s\n" "$step"
  # magnetometer: EM trace sensor — elevators, motors, appliances, doors
  mag=$(termux-sensor -s akm09918 -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -oE "[0-9.-]+" | paste -s -d,)
  [ -n "$mag" ] && printf "mag %s\n" "$mag"
  # barometer: altitude/floor proxy
  baro=$(termux-sensor -s bmp280 -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -o "[0-9.-]*" | head -1)
  [ -z "$baro" ] && baro=$(termux-sensor -s lps22hb -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -o "[0-9.-]*" | head -1)
  [ -n "$baro" ] && printf "baro_hpa %s\n" "$baro"
  # WiFi BSSID fingerprint: top 3 BSSIDs by signal strength = room fingerprint
  wifiscan=$(termux-wifi-scaninfo 2>/dev/null | python3 -c "
import sys,json
try:
  aps=json.load(sys.stdin)
  top=sorted(aps,key=lambda x:-x.get('rssi',-100))[:3]
  for a in top: print(a.get('bssid','?')+':'+str(a.get('rssi',0)))
except:pass" 2>/dev/null)
  [ -n "$wifiscan" ] && printf "wifi_fp %s\n" "$(printf '%s' "$wifiscan" | tr '\n' '|' | sed 's/|$//')"
  true
' 2>/dev/null) || _phone_data=""

[ -n "$_phone_data" ] && printf '%s\n' "$_phone_data" | while read -r line; do
  log "phone_$line"
done || true

# ── BLE population ecology: count, named-device count, top-RSSI device ──────
_ble_raw=$(mesh-presence 2>/dev/null | grep -v "^===" | grep -v "^$" | grep "|") || _ble_raw=""
if [ -n "$_ble_raw" ]; then
  _ble_total=$(printf '%s\n' "$_ble_raw" | wc -l | tr -d ' ')
  _ble_named=$(printf '%s\n' "$_ble_raw" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/,"",$3); if($3!="" && $3!="?") count++} END{print count+0}')
  _ble_top=$(printf '%s\n' "$_ble_raw" | head -1 | awk -F'|' '{gsub(/[[:space:]]/,"",$1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",$3); print $1"|"$3}')
  log "ble_count $_ble_total"
  log "ble_named $_ble_named"
  [ -n "$_ble_top" ] && log "ble_top $_ble_top"
fi 2>/dev/null || true

# ── room-sense verdict (read cached state — the */5 edge reflex keeps it fresh) ──
_room=$(cat "$HOME/.mesh/.room-sense.state" 2>/dev/null | tr -d '[:space:]')
[ -n "$_room" ] && log "room_sense $_room"

echo "logged $(grep "^$TS $NODE" "$LOG" 2>/dev/null | wc -l) readings → $LOG"
