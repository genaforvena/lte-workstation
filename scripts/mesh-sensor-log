#!/usr/bin/env bash
# mesh-sensor-log — append one timestamped row per sensor to ~/.mesh/sensors.log
# Designed to run every minute via cron. Each line: ISO8601 sensor_type node value...
# No schema, no DB — just append-only text for pattern discovery.
#
#   mesh-sensor-log        collect one round of sensor readings
#   mesh-sensor-log --test smoke test (exit 2 = no log dir, not a FAIL)
set -u
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "${MESH_NODES_FILE:-$HOME/.mesh/nodes}" ] && . "${MESH_NODES_FILE:-$HOME/.mesh/nodes}"

if [ "${1:-}" = "--test" ]; then
  [ -d "$HOME/.mesh" ] || { echo "smoke-test: n/a (no ~/.mesh dir)"; exit 2; }
  command -v nmcli >/dev/null 2>&1 || command -v iwlist >/dev/null 2>&1 \
    || { echo "smoke-test: WARN (no wifi scanner — wifi_rssi rows will be empty)"; }
  echo "smoke-test: ok"; exit 0
fi

LOG="$HOME/.mesh/sensors.log"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NODE="${HOSTNAME:-$(hostname)}"
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
# probe-based resolver: TS→LAN→ADB tunnel; pass port+user env so mesh-phone-ip uses the right probe
PHONE_IP="$(PHONE_SSH_PORT="$PHONE_PORT" PHONE_USER="$PHONE_USER" mesh-phone-ip 2>/dev/null)" || PHONE_IP=""

log() { printf '%s %s %s\n' "$TS" "$NODE" "$*" >> "$LOG"; }

# ── Hardware: all thermal zones + x86 package temp ──────────────────────────
for tz in /sys/class/thermal/thermal_zone*/; do
  _t=$(cat "${tz}temp" 2>/dev/null); _type=$(cat "${tz}type" 2>/dev/null | tr ' ' '_')
  [ -n "$_t" ] && [ -n "$_type" ] && log "therm_${_type} $(echo "scale=1; $_t/1000" | bc 2>/dev/null || echo "$_t")"
done 2>/dev/null || true

# ── Hardware: fan speeds (via sensors if lm-sensors present) ─────────────────
if command -v sensors >/dev/null 2>&1; then
  sensors 2>/dev/null | grep -iE "fan|rpm" | while read -r line; do
    _fan=$(printf '%s' "$line" | grep -o '[0-9]* RPM' | grep -o '[0-9]*' | head -1)
    _fname=$(printf '%s' "$line" | cut -d: -f1 | tr ' ' '_' | tr -cd 'A-Za-z0-9_-')
    [ -n "$_fan" ] && log "fan_${_fname} $_fan"
  done 2>/dev/null || true
fi

# ── Hardware: disk health (S.M.A.R.T. temperature, no sudo needed for NVMe) ──
for dev in /dev/nvme0 /dev/sda /dev/sdb; do
  [ -b "$dev" ] || continue
  _dtemp=$(smartctl -A "$dev" 2>/dev/null | grep -iE 'Temper|194' | grep -o '[0-9]*$' | head -1)
  [ -n "$_dtemp" ] && log "disk_temp_$(basename "$dev") $_dtemp"
done 2>/dev/null || true

# ── Hardware: memory pressure ─────────────────────────────────────────────────
_memtotal=$(grep '^MemTotal' /proc/meminfo 2>/dev/null | awk '{print $2}')
_memavail=$(grep '^MemAvailable' /proc/meminfo 2>/dev/null | awk '{print $2}')
if [ -n "$_memtotal" ] && [ -n "$_memavail" ] && [ "$_memtotal" -gt 0 ]; then
  _mempct=$(echo "scale=1; (($_memtotal - $_memavail) * 100) / $_memtotal" | bc 2>/dev/null || true)
  [ -n "$_mempct" ] && log "mem_used_pct $_mempct"
fi

# ── Hardware: CPU load (1-min average) ───────────────────────────────────────
_load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
[ -n "$_load" ] && log "cpu_load1 $_load"

# ── WiFi RSSI (local node) ───────────────────────────────────────────────────
(nmcli -t -f SSID,SIGNAL dev wifi list 2>/dev/null || true) | while IFS=: read -r ssid sig; do
  [ -n "$ssid" ] && [ -n "$sig" ] && log "wifi_rssi $(printf '%s' "$ssid" | tr ' ' '_') $sig"
done || true

# ── CPU temperature ──────────────────────────────────────────────────────────
_temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
[ -n "$_temp" ] && log "cpu_temp $(echo "scale=1; $_temp/1000" | bc 2>/dev/null || echo "$_temp")"

# ── Phone sensors (best-effort, skip if unreachable) ─────────────────────────
# No python3/jq on Termux — use grep/sed for JSON parsing
_phone_data=""
[ -n "$PHONE_IP" ] && _phone_data=$(timeout 12 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}" '
  b=$(termux-battery-status 2>/dev/null)
  if [ -n "$b" ]; then
    pct=$(printf "%s" "$b" | grep "\"percentage\"" | grep -o "[0-9]*")
    sts=$(printf "%s" "$b" | grep "\"status\"" | sed '"'"'s/.*"\([A-Z]*\)".*/\1/'"'"' | tr "[:upper:]" "[:lower:]")
    printf "battery %s %s\n" "$pct" "$sts"
  fi
  lux=$(termux-sensor -s tmd2755_l -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -o "[0-9.-]*" | head -1)
  [ -n "$lux" ] && printf "light %s\n" "$lux"
  step=$(termux-sensor -s bma420 -n 1 2>/dev/null | sed -n "/values/{n;p}" | grep -o "[0-9.-]*" | head -1)
  [ -n "$step" ] && printf "steps %s\n" "$step"
' 2>/dev/null) || _phone_data=""

[ -n "$_phone_data" ] && printf '%s\n' "$_phone_data" | while read -r line; do
  log "phone_$line"
done || true

# ── room-sense verdict (read cached state — the */5 edge reflex keeps it fresh) ──
_room=$(cat "$HOME/.mesh/.room-sense.state" 2>/dev/null | tr -d '[:space:]')
[ -n "$_room" ] && log "room_sense $_room"

echo "logged $(grep "^$TS $NODE" "$LOG" 2>/dev/null | wc -l) readings → $LOG"
