#!/usr/bin/env bash
# orphan-ok: on-demand file check invoked by tests/CI with a path argument, never scheduled.
# mesh-tmux-lint — deterministic lint for destructive tmux commands.
#
#   mesh-tmux-lint <file> [...]   check one or more files
#   mesh-tmux-lint --test         self-test (fixtures)
#
# Verdicts per file:
#   SKIP (rc 2): no tmux destructive command present.
#   HOLD/FAIL (rc 1): kill-session|kill-window|kill-pane|clear-history
#     (also `tmux kill`) OUTSIDE a --test/fixture block AND without a
#     `# live-session-ok: <why>` justification line.
#   PASS (rc 0): otherwise.
#
# Fixture = isolated socket (`tmux -L`/`-S` with tmpdir on the same line,
# or inside the --test function block).
set -uo pipefail

DESTRUCT_RE='kill-session|kill-window|kill-pane|clear-history|tmux[[:space:]]+kill'
LIVE_OK_RE='#[[:space:]]*live-session-ok:[[:space:]]*[^[:space:]#]+'
ISOLATED_RE='tmux[[:space:]]+(-L[[:space:]]+[^[:space:]]+|-S[[:space:]]+[^[:space:]]+)'

test_section(){
  awk '/--test/{found=1} found{print} found && /^fi/{exit}' "$1" 2>/dev/null
}

non_test_body(){
  awk 'BEGIN{found=0} /--test/{found=1} found && /^fi/{print; found=2; next} !found{print} found==2{print}' "$1" 2>/dev/null
}

lint_one(){
  local f="$1" body
  [ -f "$f" ] || { echo "HOLD missing-file: $f"; return 1; }
  body="$(cat "$f")"
  grep -qE "$DESTRUCT_RE" <<<"$body" || { echo "SKIP no-tmux-destructive: $f"; return 2; }
  # Residual: destructive lines outside the --test block and not on an
  # isolated-socket (`tmux -L/-S`) line.
  local residual live=1
  residual="$(non_test_body "$f" | grep -E "$DESTRUCT_RE" | grep -vE "$ISOLATED_RE" || true)"
  [ -z "$residual" ] && { echo "PASS: $f"; return 0; }
  grep -qE "$LIVE_OK_RE" <<<"$body" && live=0
  if [ "$live" = 0 ]; then
    echo "PASS: $f"
    return 0
  fi
  echo "HOLD tmux-destructive-without-justification: $f — destructive tmux outside --test/fixture without # live-session-ok: <why>"
  echo "$residual" | head -5 | sed 's/^/  | /'
  return 1
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  cat > "$d/clean.sh" <<'EOF'
#!/usr/bin/env bash
tmux new-session -A -s foo
EOF
  cat > "$d/raw.sh" <<'EOF'
#!/usr/bin/env bash
tmux kill-window -t foo
EOF
  cat > "$d/justified.sh" <<'EOF'
#!/usr/bin/env bash
# live-session-ok: session teardown is the tool's own job
tmux kill-session -t "$sess"
EOF
  cat > "$d/fixture.sh" <<'EOF'
#!/usr/bin/env bash
tmux kill-pane -t foo
if [ "${1:-}" = --test ]; then
  tmux kill-session -t testsess
  tmux clear-history -t pane
fi
EOF
  cat > "$d/isolated.sh" <<'EOF'
#!/usr/bin/env bash
d=$(mktemp -d)
tmux -L testsock kill-session -t foo
tmux -S "$d/sock" kill-window -t bar
EOF
  cat > "$d/tmuxkill.sh" <<'EOF'
#!/usr/bin/env bash
tmux kill-server
EOF
  pass=0; fail=0
  lint_one "$d/clean.sh" >/dev/null 2>&1; [ $? = 2 ] && pass=$((pass+1)) || { echo "FAIL: clean must SKIP rc=2"; fail=$((fail+1)); }
  lint_one "$d/raw.sh" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: raw kill must HOLD"; fail=$((fail+1)); }
  lint_one "$d/justified.sh" >/dev/null 2>&1; [ $? = 0 ] && pass=$((pass+1)) || { echo "FAIL: justified must PASS"; fail=$((fail+1)); }
  lint_one "$d/fixture.sh" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: live kill + test-only kill must HOLD"; fail=$((fail+1)); }
  out="$(lint_one "$d/fixture.sh" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q live-session-ok <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: HOLD must name live-session-ok (rc=$rc: $out)"; fail=$((fail+1)); }
  # fixture-only file: destructive only inside --test -> PASS
  cat > "$d/onlytest.sh" <<'EOF'
#!/usr/bin/env bash
echo hello
if [ "${1:-}" = --test ]; then
  tmux kill-session -t testsess
fi
EOF
  lint_one "$d/onlytest.sh" >/dev/null 2>&1; [ $? = 0 ] && pass=$((pass+1)) || { echo "FAIL: test-only kill must PASS"; fail=$((fail+1)); }
  lint_one "$d/isolated.sh" >/dev/null 2>&1; [ $? = 0 ] && pass=$((pass+1)) || { echo "FAIL: isolated socket must PASS"; fail=$((fail+1)); }
  lint_one "$d/tmuxkill.sh" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: tmux kill must HOLD"; fail=$((fail+1)); }
  echo "mesh-tmux-lint --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]
  exit $?
fi

[ $# -ge 1 ] || { echo "usage: mesh-tmux-lint <file> [...] | --test" >&2; exit 2; }
overall=0
for f in "$@"; do
  lint_one "$f" || { rc=$?; [ "$rc" = 1 ] && overall=1; [ "$rc" = 2 ] && [ "$overall" = 0 ] && overall=2; }
done
exit "$overall"
