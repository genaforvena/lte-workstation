#!/usr/bin/env bash
# Materialize the task-only witness view from chat.log.
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
if ! command -v mesh-task >/dev/null 2>&1; then
  export PATH="$HOME/.local/bin:$SCRIPT_DIR:$PATH"
fi

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
CHAT="${MESH_CHAT_LOG:-$MESH_DIR/chat.log}"
SUMMARY="${MESH_TASK_JOURNAL:-${MESH_WITNESS_COORDINATION_SUMMARY:-$MESH_DIR/tasks.journal}}"
LOCK="${MESH_WITNESS_PROMISE_LOCK:-${MESH_WITNESS_TASK_LOCK:-$MESH_DIR/.witness-tasks.lock}}"
TASK_TIMEOUT_ENV="${MESH_WITNESS_TASK_TIMEOUT:-}"
if [[ -n "$TASK_TIMEOUT_ENV" ]]; then
  TASK_TIMEOUT="$TASK_TIMEOUT_ENV"
else
  # SCALE-WITH-LOG (2026-09-18, fix-journal-rebuild-audit-timeout): a fixed 20s
  # cap fails closed on a growing chat.log under load (audit is ~0.4s at
  # 103k lines idle, but loadavg 41 episodes pushed it past 20s). Base 20s +
  # 1s per 5000 lines, so the cap tracks the replay cost instead of the date
  # the constant was written. An explicit MESH_WITNESS_TASK_TIMEOUT still wins
  # (the single-writer gate depends on it).
  _chat_lines="$(wc -l <"$CHAT" 2>/dev/null || echo 0)"
  case "$_chat_lines" in ''|*[!0-9]*) _chat_lines=0 ;; esac
  TASK_TIMEOUT="$((20 + _chat_lines / 5000))s"
fi

if [[ "${1:-}" == --test ]]; then
  # LIVE REBUILD ARM (2026-09-18, fix-journal-rebuild-audit-timeout): a ledger
  # append must produce a fresh published view — prints alone prove nothing.
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/bin" "$_td/mesh"
  cat >"$_td/bin/mesh-task" <<'EOF'
#!/bin/sh
test "${1:-}" = audit || exit 92
printf 'DONE\talpha\tchain/done\tartifact=/proof\n'
EOF
  chmod +x "$_td/bin/mesh-task"
  printf '2026-09-08T07:00:00Z  raw@test  ::  [fyi] source line\n' >"$_td/mesh/chat.log"
  PATH="$_td/bin:$PATH" MESH_DIR="$_td/mesh" MESH_CHAT_LOG="$_td/mesh/chat.log" \
    MESH_TASK_JOURNAL="$_td/mesh/tasks.journal" MESH_TASK_JOURNAL_MIN_AGE=0 \
    bash "$0" >/dev/null || { echo 'mesh-task-journal --test: FAIL initial rebuild' >&2; exit 1; }
  grep -q '^task_source=PASS$' "$_td/mesh/tasks.journal" || { echo 'mesh-task-journal --test: FAIL no task_source' >&2; exit 1; }
  _before="$(stat -c %Y "$_td/mesh/tasks.journal")"
  sleep 1
  printf '2026-09-08T07:01:00Z  raw@test  ::  [fyi] ledger append\n' >>"$_td/mesh/chat.log"
  PATH="$_td/bin:$PATH" MESH_DIR="$_td/mesh" MESH_CHAT_LOG="$_td/mesh/chat.log" \
    MESH_TASK_JOURNAL="$_td/mesh/tasks.journal" MESH_TASK_JOURNAL_MIN_AGE=0 \
    bash "$0" >/dev/null || { echo 'mesh-task-journal --test: FAIL rebuild after append' >&2; exit 1; }
  _after="$(stat -c %Y "$_td/mesh/tasks.journal")"
  # shellcheck disable=SC1009
  [ "$_after" -gt "$_before" ] || { echo 'mesh-task-journal --test: FAIL view not fresh after append' >&2; exit 1; }
  printf '#!/bin/sh\nexit 3\n' >"$_td/bin/mesh-task"; chmod +x "$_td/bin/mesh-task"
  if PATH="$_td/bin:$PATH" MESH_DIR="$_td/mesh" MESH_CHAT_LOG="$_td/mesh/chat.log" \
    MESH_TASK_JOURNAL="$_td/mesh/tasks.journal" MESH_TASK_JOURNAL_MIN_AGE=0 \
    bash "$0" >/dev/null 2>"$_td/err"; then
    echo 'mesh-task-journal --test: FAIL broken audit accepted' >&2; exit 1
  fi
  grep -q 'failed rc=3' "$_td/err" || { echo 'mesh-task-journal --test: FAIL failure not named' >&2; exit 1; }
  printf '%s\n' 'task-only' 'line-by-line-source-replay' 'reasoned-rejection' \
    'fresh-view-after-append' 'named-audit-failure' \
    'mesh-task-journal --test: PASS'
  exit 0
fi

command -v mesh-task >/dev/null 2>&1 || {
  echo 'mesh-task-journal: mesh-task unavailable' >&2
  exit 2
}
[[ -r "$CHAT" ]] || {
  echo "mesh-task-journal: chat.log unavailable: $CHAT" >&2
  exit 2
}

# chat.log can trigger this through both fsnotify and cron. One writer publishes
# the atomic view; overlapping invocations skip instead of queueing stale work.
mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if ! flock -n 9; then
  echo 'mesh-task-journal: skip — another task replay owns the summary rebuild' >&2
  exit 0
fi

mkdir -p "$(dirname "$SUMMARY")"
# MIN-INTERVAL GUARD (2026-09-15): a full chat.log replay costs ~19s and this
# runs on EVERY chat.log change (several/min) plus a */5 backstop — back-to-back
# replays pinned a core and kept the journal ~20s stale anyway. Skip when the
# published view is fresher than MESH_TASK_JOURNAL_MIN_AGE (default 120s); the
# cron backstop bounds staleness, and dispatch/--status tolerate a 2min-old
# view (pace gap alone is 180s). MESH_TASK_JOURNAL_FORCE=1 bypasses (e.g. the
# witness mind after settling a task it needs visible now).
_min_age="${MESH_TASK_JOURNAL_MIN_AGE:-120}"
_force="${MESH_TASK_JOURNAL_FORCE:-0}"
if [ "$_force" != 1 ] && [ -f "$SUMMARY" ]; then
  _mtime="$(stat -c %Y "$SUMMARY" 2>/dev/null || echo 0)"
  _now="$(date +%s)"
  case "$_min_age" in ''|*[!0-9]*) _min_age=120 ;; esac
  if [ "$((_now - _mtime))" -lt "$_min_age" ]; then
    echo "mesh-task-journal: skip — view $((_now - _mtime))s old (< ${_min_age}s)" >&2
    exit 0
  fi
fi
summary_tmp="${SUMMARY}.tmp.$$"
audit_tmp="${SUMMARY}.audit.$$"
audit_err="${SUMMARY}.audit-err.$$"
cleanup() { rm -f -- "$summary_tmp" "$audit_tmp" "$audit_err"; }
trap cleanup EXIT HUP INT TERM

source_coverage="$(PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$CHAT" <<'PY'
import sys
from pathlib import Path
from mesh_task_log import replay_source

coverage = replay_source(Path(sys.argv[1]))
if not coverage["complete"]:
    raise SystemExit("incomplete chat.log event")
print("source_events={events} replayed_events={replayed_events} source_errors={errors} source_bytes={bytes} source_sha256={sha256}".format(**coverage))
PY
)" || {
  echo 'mesh-task-journal: chat.log replay failed; preserving last valid task view' >&2
  exit 1
}

_audit_rc=0
timeout -k 3s "$TASK_TIMEOUT" mesh-task audit >"$audit_tmp" 2>"$audit_err" || _audit_rc=$?
if [ "$_audit_rc" -ne 0 ]; then
  # NAME THE FAILURE (2026-09-18, fix-journal-rebuild-audit-timeout): rc 124
  # is a timeout, anything else is audit's own failure — the old fused message
  # rendered lock contention, cache poison and genuine slowness identically.
  _audit_tail="$(tail -n 3 "$audit_err" 2>/dev/null | tr '\n' ';')"
  if [ "$_audit_rc" -eq 124 ]; then
    echo "mesh-task-journal: mesh-task audit timed out after $TASK_TIMEOUT (rc=124); preserving last valid task view" >&2
  else
    echo "mesh-task-journal: mesh-task audit failed rc=${_audit_rc}${_audit_tail:+: ${_audit_tail}}; preserving last valid task view" >&2
  fi
  exit 1
fi

printf 'timestamp=%s\n' "$(date -u +%FT%TZ)" >"$summary_tmp"
printf 'task_source=PASS\n%s\n' "$source_coverage" >>"$summary_tmp"
if ! python3 - "$audit_tmp" "$summary_tmp" <<'PY'
import sys
from pathlib import Path

audit = Path(sys.argv[1])
summary = Path(sys.argv[2])
rows = []
counts = {"done": 0, "rejected": 0, "unfinished": 0, "findings": 0}

for number, raw in enumerate(audit.read_text(encoding="utf-8").splitlines(), 1):
    if not raw:
        continue
    fields = raw.split("\t")
    if len(fields) < 3:
        raise SystemExit(f"mesh-task audit row {number} has fewer than three fields")
    state, owner, task, *detail = fields
    if state == "IGNORED":
        state = "REJECTED"
    elif state == "HELD_REJECTED":
        # Keep terminal-predecessor holds explicit in the pane; collapsing
        # this into ordinary QUEUED hides why dispatch is intentionally held.
        pass
    elif state == "BLOCKED":
        blocker_type = detail[0].strip() if detail and detail[0].strip() else "unknown"
        retry = detail[1].strip() if len(detail) > 1 and detail[1].strip() else "unspecified"
        detail = [f"blocker_type={blocker_type}", f"retry={retry}"]
    elif state == "OVERDUE":
        evidence = "; ".join(value.strip() for value in detail if value.strip())
        state = "OPEN_UNOWNED"
        owner = "-"
        detail = [f"owner_receipt=overdue{'; ' + evidence if evidence else ''}"]
    elif state == "HELD_EXPIRED":
        # An expired sent health-warning dispatch is held for a fresh source
        # warning; it is not a genuine unowned task and must not fail the pane.
        pass
    elif state in ("EXPIRED", "ABANDONED"):
        raise SystemExit(f"legacy task state is forbidden: {state} {task}")
    elif state not in ("DONE", "REJECTED", "HELD_REJECTED", "HELD_EXPIRED",
                       "OPEN_UNOWNED", "QUEUED", "RUNNING"):
        raise SystemExit(f"unknown task state: {state} {task}")

    if state == "REJECTED":
        reason = next((value.partition("=")[2].strip() for value in detail
                       if value.startswith("reason=")), "")
        if not reason or reason == "missing":
            raise SystemExit(f"REJECTED requires reason=: {task}")
        counts["rejected"] += 1
    elif state == "DONE":
        counts["done"] += 1
    else:
        counts["unfinished"] += 1
        if state == "OPEN_UNOWNED":
            # Deterministic un-ownership: an unowned finding carries no owner
            # over chat.log, whatever the audit row claimed.
            owner = "-"
            counts["findings"] += 1
    rows.append("\t".join((state, owner, task, *detail)))

with summary.open("a", encoding="utf-8") as output:
    output.write(f"task_rows={len(rows)} unfinished_tasks={counts['unfinished']} "
                 f"rejected_tasks={counts['rejected']} done_tasks={counts['done']}\n")
    for row in rows:
        output.write(row + "\n")
    verdict = "PASS" if counts["findings"] == 0 else "FAIL"
    output.write(f"chain_steps={len(rows)} findings={counts['findings']} status={verdict}\n")
PY
then
  echo 'mesh-task-journal: invalid task audit; preserving last valid task view' >&2
  exit 1
fi

mv -f -- "$summary_tmp" "$SUMMARY"
trap - EXIT HUP INT TERM
rm -f -- "$audit_tmp" "$audit_err"
printf 'mesh-task-journal: task replay published %s\n' "$SUMMARY"
