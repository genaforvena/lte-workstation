#!/usr/bin/env bash
# mesh-study-autowake — autonomously start the frozen Tiny Fleet study when runnable.
#
# Missing study artifacts are a readiness state, not an operator request. Resource admission and
# retry remain owned by mesh-study-launch/mesh-heavy-run after this gate opens.
# reflex-cadence: */5 * * * *
# reflex-args: --run
# orphan-ok: autonomous study readiness reflex; the launcher owns durable execution/retry.
set -u -o pipefail
export PATH="$HOME/.local/bin:$PATH"

STUDY_ROOT="${MESH_STUDY_ROOT:-$HOME/tiny-fleet}"
LAUNCH="${MESH_STUDY_LAUNCH:-$HOME/lte-workstation/scripts/mesh-study-launch}"
RUN_ROOT="${MESH_STUDY_RUN_ROOT:-$STUDY_ROOT/runs/fleet-study-v1}"
STATE="${MESH_STUDY_AUTOWAKE_STATE:-$RUN_ROOT/autonomy-readiness.json}"
LOCK="${MESH_STUDY_AUTOWAKE_LOCK:-${RUN_ROOT%/*}/.${RUN_ROOT##*/}.autowake.lock}"
COMPLETE="${MESH_STUDY_COMPLETE_CMD:-$(dirname "$0")/mesh-study-matrix-complete}"

if [ "${1:-}" = --test ]; then
  [ -x "$LAUNCH" ] || { echo "mesh-study-autowake: launcher is not executable: $LAUNCH" >&2; exit 2; }
  echo 'mesh-study-autowake: ok (readiness-gated autonomous launch)'
  exit 0
fi
[ "${1:---run}" = --run ] || { echo "usage: $0 [--run|--test]" >&2; exit 2; }

# The five-minute reflex may fire while an admitted matrix is still running.
# Keep one launch in flight across the exec boundary; mesh-heavy-run's general
# serialization may deliberately lapse after its wait and is not a study lock.
mkdir -p "$(dirname "$LOCK")" || exit 1
exec 9>"$LOCK" || exit 1
if ! flock -n 9; then
  echo 'mesh-study-autowake: study launch already in flight'
  exit 0
fi

REGISTRATION="$STUDY_ROOT/runs/fleet-study-v1/registration.json"
MANIFEST="$STUDY_ROOT/corpus/study-v1/manifest.json"
missing=()
[ -f "$REGISTRATION" ] || missing+=("registration.json")
[ -f "$MANIFEST" ] || missing+=("manifest.json")
for adapter in study-pooled study-toy_passage_ppl study-executable_code study-rated_style study-adversarial_safety; do
  [ -d "$STUDY_ROOT/adapters/$adapter" ] || missing+=("adapters/$adapter")
done

mkdir -p "$(dirname "$STATE")"
tmp="$STATE.tmp.$$"
if [ "${#missing[@]}" -gt 0 ]; then
  {
    echo '{'
    echo '  "schema": "mesh.autonomous-study-readiness/v1",'
    echo '  "status": "waiting",'
    echo '  "operator_required": false,'
    printf '  "missing": ['
    sep=''
    for item in "${missing[@]}"; do printf '%s"%s"' "$sep" "$item"; sep=,; done
    echo ']'
    echo '}'
  } > "$tmp"
  mv "$tmp" "$STATE"
  exit 0
fi

completion="$("$COMPLETE" "$RUN_ROOT" 2>&1)"
completion_rc=$?
if [ "$completion_rc" = 0 ] || [ "$completion_rc" = 2 ]; then
  status=complete
  [ "$completion_rc" = 2 ] && status=held
  printf '{"schema":"mesh.autonomous-study-readiness/v1","status":"%s","operator_required":false}\n' \
    "$status" > "$tmp"
  mv "$tmp" "$STATE"
  echo "mesh-study-autowake: $completion"
  exit 0
fi
if [ "$completion_rc" != 1 ]; then
  echo "mesh-study-autowake: completion check failed rc=$completion_rc; launch held" >&2
  exit 1
fi

{
  echo '{'
  echo '  "schema": "mesh.autonomous-study-readiness/v1",'
  echo '  "status": "ready",'
  echo '  "operator_required": false'
  echo '}'
} > "$tmp"
mv "$tmp" "$STATE"
exec "$LAUNCH"
