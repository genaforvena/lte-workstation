#!/usr/bin/env bash
# mesh-audit-reflex — jittered S3* audit reflex.
#
# The audit itself is deliberately independent of the reporting reflex.  This wrapper only gives
# it an unpredictable due time inside the always-on liveness supervisor, then turns a divergence or
# auditor error into the same explicit health signal consumed by mesh-health-warning-task.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_AUDIT_REFLEX_STATE:-$MESH/.audit-reflex-state}"
MIN="${MESH_AUDIT_MIN_S:-300}"
MAX="${MESH_AUDIT_MAX_S:-900}"
AUDIT="${MESH_AUDIT_CMD:-mesh-audit}"
CHAT="${MESH_AUDIT_CHAT_CMD:-mesh-chat}"
HEALTH="${MESH_AUDIT_HEALTH_CMD:-mesh-health-warning-task}"
ts(){ date -u +%FT%TZ; }
now(){ date +%s; }

random_delay() {
  local span="$(( MAX - MIN + 1 ))" n
  (( span > 0 )) || span=1
  n="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')"
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  echo "$(( MIN + n % span ))"
}

valid_epoch() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

run_once() {
  local out rc next
  out="$($AUDIT 2>&1)"; rc=$?
  next="$(( $(now) + $(random_delay) ))"
  mkdir -p "$(dirname "$STATE")"
  printf '%s\n' "$next" >"$STATE"
  case "$rc" in
    0|2) return 0 ;; # OK or honest n/a: neither is a health fault.
    1) printf '%s\n' "[audit-diverge] S3* mesh-audit found a correctness divergence: ${out}" \
         | ${MESH_AUDIT_NOPOST:+true} ${MESH_AUDIT_NOPOST:-$CHAT} >/dev/null 2>&1 || true ;;
    *) printf '%s\n' "[error] S3* mesh-audit failed (rc=${rc}): ${out}" \
         | ${MESH_AUDIT_NOPOST:+true} ${MESH_AUDIT_NOPOST:-$CHAT} >/dev/null 2>&1 || true ;;
  esac
  # Convert the just-posted signal immediately. The minute cron remains a retry/reflex safety net.
  [ -n "${MESH_AUDIT_NOPOST:-}" ] || timeout 50 "$HEALTH" >/dev/null 2>&1 || true
  return 0
}

case "${1:-}" in
  --test)
    td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
    fake_audit="$td/audit"; fake_chat="$td/chat"; fake_health="$td/health"
    printf '#!/usr/bin/env bash\necho "audit:therm  DIVERGE  hidden heat"\nexit 1\n' >"$fake_audit"
    printf '#!/usr/bin/env bash\ncat >>"%s/chat.log"\n' "$td" >"$fake_chat"
    printf '#!/usr/bin/env bash\nprintf health-ran >>"%s/health.log"\n' "$td" >"$fake_health"
    chmod +x "$fake_audit" "$fake_chat" "$fake_health"
    MESH_AUDIT_REFLEX_STATE="$td/state" MESH_AUDIT_CMD="$fake_audit" MESH_AUDIT_CHAT_CMD="$fake_chat" \
      MESH_AUDIT_HEALTH_CMD="$fake_health" MESH_AUDIT_MIN_S=1 MESH_AUDIT_MAX_S=1 \
      MESH_AUDIT_NOPOST=1 "$0" >/dev/null
    [ -s "$td/state" ] || { echo "mesh-audit-reflex --test: FAIL (no jittered due state)"; exit 1; }
    # Test the real post/convert path separately; a divergence must reach both sinks.
    MESH_AUDIT_REFLEX_STATE="$td/state2" MESH_AUDIT_CMD="$fake_audit" MESH_AUDIT_CHAT_CMD="$fake_chat" \
      MESH_AUDIT_HEALTH_CMD="$fake_health" MESH_AUDIT_MIN_S=1 MESH_AUDIT_MAX_S=1 "$0" >/dev/null
    grep -q '\[audit-diverge\]' "$td/chat.log" || { echo "mesh-audit-reflex --test: FAIL (no audit signal)"; exit 1; }
    [ -s "$td/health.log" ] || { echo "mesh-audit-reflex --test: FAIL (no immediate health conversion)"; exit 1; }
    echo "mesh-audit-reflex --test: PASS (jittered due state, divergence signal, immediate health conversion)"; exit 0 ;;
  *)
    due="$(cat "$STATE" 2>/dev/null || true)"
    if ! valid_epoch "$due" || [ "$(now)" -ge "$due" ]; then run_once; fi
    exit 0 ;;
esac
