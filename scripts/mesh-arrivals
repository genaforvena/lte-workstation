#!/usr/bin/env bash
# mesh-arrivals — the "who's around" life-event sense: emit [arrived]/[left] ONLY for a KNOWN/NAMED
# device (a person's phone, Bose, Quest, the TV), suppressing the randomized-MAC BLE churn that makes
# raw presence useless as a life-signal. The MEANINGFUL edge that mesh-presence-delta isn't.
#
# Two refinements over mesh-presence-delta (which fires on ANY mac|name change):
#   1. NAME identity, not MAC — a named device's MAC rotates (privacy randomization) but its NAME is
#      stable, so tracking by name means "Bose rotated its address" does NOT read as leave+arrive.
#   2. DEBOUNCE (hysteresis) — BLE RSSI flickers: a present device drops out of a single scan then
#      returns (seen live: Bose present 17:31, gone 17:33, back 17:34). A device is only declared
#      LEFT after MESH_ARRIVAL_MISSES consecutive absent scans (default 3) — killing the flap that
#      would otherwise spam "left/arrived" every other cycle.
#
# Honest-fusion (memory fusion-tools-distinguish-empty-from-failed): a FAILED/empty/unreachable scan
# never increments misses — an absent vantage is NOT "everyone left". First run seeds silently (the
# whole room is not "arrivals"). Multi-vantage: a device seen at ANY reachable vantage counts present
# (union); an unreachable peer is skipped + noted, never an absence.
#
#   mesh-arrivals                    scan local BLE → emit named arrive/leave edges (debounced)
#   mesh-arrivals --vantages "local default-string"   union across BLE vantages (best-effort)
#   mesh-arrivals --status           current known-present named devices + miss counts
#   mesh-arrivals --forget           reset state (re-seed next run)
#   mesh-arrivals --test             smoke test
#   (also reads a presence scan on STDIN — composes as a mesh-stream filter)
#
# Read-only sense. Edge is in the TEXT (feed a mind); exit 0 normally, 2 = could not sample any vantage.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

# Shared BLE classifier (DRY: the SAME patterns power mesh-ambient-clock — one classifier, two
# consumers; see mesh-patterns.sh). Source with an inline fallback so a stale/missing lib never
# SILENTLY disables the fixed-appliance exclusion (fail-safe = keep filtering neighbor TVs/ACs out
# of the who's-around person-sense). MESH_FIXED_RE = appliance BLE cycling that is an ambient
# social-clock/weather signal harvested by mesh-ambient-clock, NOT a person-movement signal.
for _p in "$HOME/.local/bin/mesh-patterns.sh" "$(command -v mesh-patterns.sh 2>/dev/null)"; do
  [ -n "$_p" ] && [ -f "$_p" ] && { . "$_p"; break; }
done
: "${MESH_FIXED_RE:=\[TV\]|MiTV-|Mi Box|Bluedroid TV|GR-AC_|MI SCALE|LYWSD|Vega BLE|GEELY_BT|CAR-BT}"
: "${MESH_NOISE_RE:=^(WSH86|C04-|C05-)[0-9A-Za-z]|^[A-Z][A-Z0-9]{11,}$}"  # rotating serial-name churn (see mesh-patterns.sh)

STATE="$HOME/.mesh/arrivals.state"        # lines: <name>\t<miss_count>   (present known devices)
MISSES="${MESH_ARRIVAL_MISSES:-3}"        # consecutive absent scans before a device is "left"
WIN="${MESH_ARRIVAL_WIN:-8}"              # BLE scan window seconds
# Per-device flap cooldown: suppress re-EMITTING a device's edge within N sec of its last edge.
# WHY: a sleep-prone person-device (Quest headset set down, earbuds in case) genuinely power-cycles
# its BLE radio, so absences are REAL and the miss-debounce can't dampen them — it oscillates
# arrived/left/arrived (seen 2026-06-15: Quest 3 flapped 5x in one session). This collapses that
# oscillation into ≤1 edge per COOLDOWN. Tracking is untouched (STATE still updates every scan) —
# only the ANNOUNCEMENT is throttled, so no desync. Honest cost: a genuine sub-COOLDOWN out-and-back
# is masked, acceptable for who's-around life-event granularity.
COOLDOWN="${MESH_ARRIVAL_COOLDOWN:-900}"
CDDIR="$HOME/.mesh/.arrival-cd"
mkdir -p "$HOME/.mesh" "$CDDIR"
_cdfile(){ printf '%s/%s' "$CDDIR" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_')"; }
cd_fresh(){ local f; f="$(_cdfile "$1")"; [ -f "$f" ] || return 1   # true = within cooldown → suppress
  [ "$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))" -lt "$COOLDOWN" ]; }
cd_mark(){ touch "$(_cdfile "$1")" 2>/dev/null || true; }            # stamp last-emit time for a device

# A real, trackable name: not empty, not the unknown '?', not a randomized device-name token
# (SC-<hex> = Samsung-accessory rotating names), not a bare MAC used as the name, and not a
# generic BLE default name ("Bluetooth", "BLE Device", "Unknown") — these are non-unique: many
# different physical devices can share the same generic name, so they churn like randomized MACs
# (2026-06-13 observed: [arrived] Bluetooth fired on an unknown transient device, not a resident).
# Person identities (what THIS sense tracks): Bose / Quest 3 / phone model names. A FIXED appliance
# (neighbor TV/AC/scale/temp-sensor) has a real stable name too, but it can't physically move — its
# BLE cycling is an ambient social-clock/weather signal, so it is EXCLUDED here (matched by
# MESH_FIXED_RE) and harvested by mesh-ambient-clock instead. One classifier, two consumers.
is_named(){ local n="$1"
  case "$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]')" in
    ""|"?"|"bluetooth"|"ble device"|"unknown"|"null") return 1;;
  esac
  # fixed appliance → not a who's-around person-event (routed to mesh-ambient-clock)
  printf '%s' "$n" | grep -qE "$MESH_FIXED_RE" && return 1
  # rotating serial-name churn (WSH86-/C04-/C05-): embeds serial in BLE name, rotates with MAC
  printf '%s' "$n" | grep -qE "$MESH_NOISE_RE" && return 1
  # garbage/corrupted advert: a real identity is alphanumerics + spaces + light punctuation; a name
  # carrying 2+ "junk" chars (* ; / \ | < > = etc.) is a malformed/binary BLE advert, not a device —
  # it churns like noise (2026-06-15: '[arrived] I*7I;(7(H7///*-)' leaked through). Allowed set spans
  # every legit name seen (junk=0); garbage scores high (the leak scored 6), so ≥2 is a safe cutoff.
  local _junk; _junk="$(printf '%s' "$n" | tr -d 'A-Za-z0-9 ._:()[]+-')"
  [ "${#_junk}" -ge 2 ] && return 1
  case "$n" in
    SC-[0-9A-Fa-f]*) return 1;;
    [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) return 1;;  # bare MAC = no real name
    *) return 0;;
  esac; }

# extract the set of NAMED device names from a presence scan (rssi|mac|name lines; name may contain
# spaces and ()[]; rejoin fields >=3 in case a name held a literal '|'). One name per line, unique.
named_from_scan(){
  grep -E '^[+-]?[0-9]+\|' 2>/dev/null | awk -F'|' 'NF>=3{n=$3; for(i=4;i<=NF;i++) n=n"|"$i; if(n!="" && n!="?") print n}' \
    | while IFS= read -r n; do is_named "$n" && printf '%s\n' "$n"; done | sort -u
}

if [ "${1:-}" = --test ]; then
  for c in mesh-presence awk grep sort comm; do command -v "$c" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $c)"; exit 1; }; done
  # person filter: keep person-carried names, drop ?/SC-noise/bare-MAC/generic-BLE AND fixed appliances
  scan=$'=== mesh-presence x ===\n-66|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink\n-74|66:FA:CC:99:91:BE|?\n-93|E8:5C:5F:7C:D0:90|SC-3115020001FC5A\n-70|2C:CF:3E:D2:BC:4C|2C:CF:3E:D2:BC:4C\n-85|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)\n-72|AA:BB:CC:DD:EE:FF|Bluetooth\n-68|11:22:33:44:55:66|Unknown\n-71|AA:BB:CC:DD:EE:01|WSH866897059279853AM5886\n-69|AA:BB:CC:DD:EE:02|C05-49459425088235\n-67|AA:BB:CC:DD:EE:03|C04-12345678ABCD\n-65|AA:BB:CC:DD:EE:04|I*7I;(7(H7///*-)'
  got="$(printf '%s\n' "$scan" | named_from_scan)"
  printf '%s\n' "$got" | grep -qx 'LE-Bose Revolve SoundLink' || { echo "smoke-test: FAIL (dropped a real person name: [$got])"; exit 1; }
  printf '%s\n' "$got" | grep -q '\[TV\]' && { echo "smoke-test: FAIL (kept a fixed-appliance TV — must be excluded, harvested by mesh-ambient-clock)"; exit 1; }
  printf '%s\n' "$got" | grep -q 'SC-' && { echo "smoke-test: FAIL (kept SC- randomized name)"; exit 1; }
  printf '%s\n' "$got" | grep -q '2C:CF:3E:D2:BC:4C' && { echo "smoke-test: FAIL (kept a bare MAC as a name)"; exit 1; }
  printf '%s\n' "$got" | grep -qi 'bluetooth\|unknown' && { echo "smoke-test: FAIL (kept generic BLE default name)"; exit 1; }
  printf '%s\n' "$got" | grep -q 'WSH86' && { echo "smoke-test: FAIL (kept WSH86- serial-rotating name)"; exit 1; }
  printf '%s\n' "$got" | grep -q 'C05-' && { echo "smoke-test: FAIL (kept C05- serial-rotating name)"; exit 1; }
  printf '%s\n' "$got" | grep -q 'C04-' && { echo "smoke-test: FAIL (kept C04- serial-rotating name)"; exit 1; }
  printf '%s\n' "$got" | grep -qE '[*;]' && { echo "smoke-test: FAIL (kept a garbage/corrupted BLE name)"; exit 1; }
  [ "$(printf '%s\n' "$got" | grep -c .)" = 1 ] || { echo "smoke-test: FAIL (expected 1 person-named, got [$got])"; exit 1; }
  # flap cooldown: a freshly-marked device reads as IN-cooldown (suppress); a stale marker reads as OUT
  CDDIR="$(mktemp -d)"; COOLDOWN=900
  cd_mark "FlapTest"; cd_fresh "FlapTest" || { echo "smoke-test: FAIL (cooldown not fresh right after mark)"; rm -rf "$CDDIR"; exit 1; }
  touch -d '1 hour ago' "$(_cdfile "FlapTest")" 2>/dev/null
  cd_fresh "FlapTest" && { echo "smoke-test: FAIL (cooldown still fresh after backdating past COOLDOWN)"; rm -rf "$CDDIR"; exit 1; }
  rm -rf "$CDDIR"
  echo "smoke-test: ok"; exit 0
fi

ARG="${1:-}"; vantages="local"
case "$ARG" in
  --forget) rm -f "$STATE"; echo "arrivals state forgotten — next run re-seeds"; exit 0;;
  --status)
    echo "known-present named devices (name | misses):"
    [ -s "$STATE" ] && awk -F'\t' '{printf "  %-32s %s\n", $1, $2}' "$STATE" || echo "  (none tracked yet)"
    exit 0;;
  --vantages) vantages="${2:-local}";;
esac

# ---- gather current named set across vantages (union; unreachable vantage skipped, not an absence) -
tmp_seen="$(mktemp)"; trap 'rm -f "$tmp_seen"' EXIT
any_vantage=0; skipped=""
# STDIN scan (stream mode) feeds the LOCAL vantage if present
stdin_scan=""
if [ ! -t 0 ]; then stdin_scan="$(cat)"; fi

for v in $vantages; do
  scan=""; ok=0
  if [ "$v" = "local" ] || [ "$v" = "$(hostname)" ]; then
    if [ -n "$stdin_scan" ]; then scan="$stdin_scan"; ok=1
    else scan="$(timeout $((WIN+40)) mesh-presence "$WIN" 2>/dev/null)" && [ -n "$scan" ] && ok=1; fi
  else
    addr="$(mesh-peer-addr "$v" 2>/dev/null || true)"
    if [ -n "$addr" ]; then
      # resolve ssh user from the MESH_NODES registry (label:user@ip), else a sane default
      vuser="$(for n in ${MESH_NODES:-}; do [ "${n%%:*}" = "$v" ] && { e="${n#*:}"; echo "${e%%@*}"; break; }; done)"
      [ -n "$vuser" ] || vuser="${MESH_ARRIVAL_USER:-$(whoami)}"
      scan="$(timeout $((WIN+45)) ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "$vuser@$addr" "\$HOME/.local/bin/mesh-presence $WIN" </dev/null 2>/dev/null)" \
        && [ -n "$scan" ] && ok=1
    fi
  fi
  if [ "$ok" = 1 ]; then any_vantage=1; printf '%s\n' "$scan" | named_from_scan >> "$tmp_seen"
  else skipped="$skipped $v"; fi
done

if [ "$any_vantage" = 0 ]; then
  echo "mesh-arrivals: no BLE vantage reachable (${vantages// /, }) — cannot sample, NOT declaring anyone left" >&2
  exit 2
fi
cur="$(sort -u "$tmp_seen")"

# ---- first run: seed silently (whole room ≠ arrivals) --------------------------------------------
if [ ! -f "$STATE" ]; then
  while IFS= read -r n; do [ -n "$n" ] && printf '%s\t0\n' "$n"; done <<<"$cur" > "$STATE"
  echo "mesh-arrivals: seeded $(grep -c . "$STATE" 2>/dev/null || echo 0) known device(s) (silent first run)" >&2
  exit 0
fi

# ---- diff with debounce --------------------------------------------------------------------------
declare -A PREVMISS=()
while IFS=$'\t' read -r name miss; do [ -n "$name" ] && PREVMISS["$name"]="${miss:-0}"; done < "$STATE"
declare -A CURSET=()
while IFS= read -r n; do [ -n "$n" ] && CURSET["$n"]=1; done <<<"$cur"

arrived=""; left=""
: > "$STATE.new"
# devices seen now: present (miss=0); ARRIVED if they weren't tracked before
for n in "${!CURSET[@]}"; do
  if [ -z "${PREVMISS[$n]+x}" ]; then arrived="$arrived$n"$'\n'; fi
  printf '%s\t0\n' "$n" >> "$STATE.new"
done
# tracked devices NOT seen now: bump miss; LEFT at threshold, else keep (debounce)
for n in "${!PREVMISS[@]}"; do
  [ -n "${CURSET[$n]+x}" ] && continue
  m=$(( ${PREVMISS[$n]} + 1 ))
  if [ "$m" -ge "$MISSES" ]; then left="$left$n"$'\n'; else printf '%s\t%s\n' "$n" "$m" >> "$STATE.new"; fi
done
mv -f "$STATE.new" "$STATE"

[ -n "$skipped" ] && echo "(vantages skipped — unreachable, not counted as absence:$skipped)" >&2
if [ -z "${arrived}${left}" ]; then exit 0; fi   # no meaningful edge → say nothing

# ---- flap cooldown: drop edges for a device that already emitted within COOLDOWN (collapse the
#      sleep-prone-device oscillation); mark each device we DO announce so its next flap is damped --
arrived_out=""; left_out=""
while IFS= read -r n; do [ -z "$n" ] && continue
  cd_fresh "$n" || { arrived_out="$arrived_out$n"$'\n'; cd_mark "$n"; }; done <<<"$arrived"
while IFS= read -r n; do [ -z "$n" ] && continue
  cd_fresh "$n" || { left_out="$left_out$n"$'\n'; cd_mark "$n"; }; done <<<"$left"
if [ -z "${arrived_out}${left_out}" ]; then exit 0; fi   # all edges damped as flaps → say nothing

# ---- emit the life-event (the text a mind reacts to) ---------------------------------------------
echo "who's-around change near $(hostname) — a KNOWN device arrived/left (react if it matters, else acknowledge):"
[ -n "$arrived_out" ] && printf '%s' "$arrived_out" | sed '/^$/d; s/^/  [arrived] /'
[ -n "$left_out"    ] && printf '%s' "$left_out"    | sed '/^$/d; s/^/  [left]    /'
exit 0
