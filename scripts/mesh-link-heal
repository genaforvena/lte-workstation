#!/usr/bin/env bash
# reflex-cadence: * * * * *
# mesh-link-heal — link-layer ACTUATOR: force a wedged wifi station back onto its AP.
#
# WHY THIS EXISTS. mesh-home's sole path is a USB rtw_8822bu station. It is deauthed by the AP
# (reason=6, firmware stuck in deep LPS) several times an hour. Almost every deauth recovers on
# its own in 15-50s and needs nobody. The pain is the TAIL: wpa_supplicant sometimes does not get
# back on, and the node sits dark for tens of minutes (measured 2026-08-16 this boot: 07:27:00 ->
# 09:23:17 = 116 min, 14:19:20 -> 14:55:44 = 36 min). That is what a human experiences as "cut off
# once an hour"; the 30-second blips are invisible to them.
#
# A DEAUTH IS AN EVENT, A WEDGE IS A CONDITION — and the whole mesh was built for the event. A grep
# for `wpa_cli|reassociate` across ~/.local/bin/mesh-* matched ZERO files before this tool: every
# alarm on this fault (access-probe, mesh-revive, watchdog, doctor) fires as `anthropic=DOWN
# groq=DOWN ts=DOWN`, an EGRESS story that never names the local link, and every self-heal aims
# there. mesh-revive logged "self-heal failed. Path may need you" because it was healing the wrong
# layer. This tool is the missing hand.
#
# SAFETY — the whole design. Every rung fires ONLY when the link is ALREADY not carrying traffic,
# so this can never sever a working path. That is what makes it safe to run on the node's only
# uplink without a dead-man's switch: there is no state it can destroy that is better than the
# state it found. The one destructive-looking rung, the driver reload, is floored at RELOAD_AFTER
# consecutive down-checks (default 7 ~= 7 min) — by then the node is already unreachable and a
# reload is strictly better than waiting for a human. It is exactly what the reboot that "fixed"
# past wedges did, minus the reboot.
#
# THE LADDER (one rung per consecutive down-check OR per elapsed cadence-interval, whichever is
# further along — see "the epistemic cut" below; a tick count is NOT a duration)
#   1              observe only    — a normal deauth recovers by itself; do not fight the supplicant
#   REASSOC_AFTER  wpa_cli reassociate
#   BOUNCE_AFTER   ip link down/up + reassociate
#   RELOAD_AFTER   rmmod/modprobe the driver
#   REPLUG_AFTER   re-enumerate the USB device (the software equivalent of pulling the dongle out)
#   SHOUT_AFTER    post to the board — the ladder is exhausted and this needs a human
#
# WHY THERE IS A RUNG ABOVE THE DRIVER RELOAD. health measured the 14:23-14:56Z outage from kernel
# artifacts and found the recovery was a PHYSICAL RE-PLUG — the adapter came back on a different USB
# path (1-6 -> 1-2.4). A modprobe cycle rebinds the driver but never re-enumerates the device, so if
# the wedge lives in the USB endpoint rather than in the driver state, reloading is theatre. Toggling
# `authorized` on the port is the closest thing to a human pulling the plug, and it is the last rung
# before giving up. It is a claim, not a proven cure: whether the fault is driver-side or
# endpoint-side is exactly what the log will answer once a real outage climbs this far, because the
# RECOVERED line names the rung that preceded it.
# The counter resets the moment the link passes traffic again, and the recovery is logged with the
# rung that preceded it, so the log answers "which rung actually worked" and not merely "it came
# back".
#
# DOWN has three shapes, and the tape names which one the ladder climbed against:
#   DEAUTHED   not associated to the AP
#   WEDGED     associated, has a default route, and the gateway answers nothing
#   ROUTELESS  associated, and the node has no default route at all (L2 up, L3 gone)
#
# DOWN means "not passing traffic", not "not associated" — a wedged adapter stays ASSOCIATED while
# carrying nothing (the 2026-08-03 wedge held association for 4h16m), so an association-only test is
# blind to the longest outages. Both are checked: unassociated, OR associated but the default
# gateway does not answer two pings.
#
#   mesh-link-heal            one check + at most one action; prints the verdict line
#   mesh-link-heal --status   read-only: link state, BOTH escalation axes (down_checks and
#                             down_secs), which one is carrying the climb, and the settle window
#                             left on the last action. Acts never.
#   mesh-link-heal --json     machine-readable verdict
#   mesh-link-heal --layer    read-only ONE WORD: which layer owns a "cannot reach the internet"
#                             moment (UP|WEDGED|DEAUTHED|ROUTELESS|UNKNOWN). Answers on EVERY node,
#                             wired included — this is the oracle the other alarms consult.
#   mesh-link-heal --cost-drift [--json]
#                             read-only: is the LADDER HEIGHT this link needs in order to recover
#                             DRIFTING upward across episodes, while every episode still ends
#                             RECOVERED? A gated homeostat holds the OUTPUT and lets the
#                             CONFIGURATION wander (Alonso/Rue/Marder, PNAS 2023) — see
#                             cost_drift(). Acts never, writes nothing.
#   mesh-link-heal --test     self-test; writes ONLY to the test log, never to the real one
#
# THE HEALER MUST NOT BE GATED ON WHAT ITS FAULT DESTROYS (fixed 2026-08-17, after a 55-minute
# outage this reflex slept through). The interface used to be derived from the default route alone.
# A hard wedge takes the route with it, so during 16:04->17:03Z the reflex ran 48 times, printed
# "n/a — no wireless station interface carries the default route" 48 times, climbed zero rungs, and
# the outage ended when the OPERATOR unplugged the dongle and moved it to another port. The n/a even
# fails green: it reads as "not my node", never as "I am blind". Now: a default route over a radio is
# still the preferred discovery, but NO default route at all plus exactly one wireless station means
# the node has no uplink and that radio is the story — state ROUTELESS, and the ladder climbs. A node
# whose default route is WIRED keeps rendering n/a, so an idle wifi card is never touched.
#
# Exit codes:
#   0 = a real check ran (link up, or an action was taken)
#   2 = n/a on this node: no wireless station to tend (wired-routed, no radio, or — named explicitly —
#       several radios and no record of which is the uplink)
#   3 = the ladder is exhausted and the link is still down (a human is needed)
#
# State: $MESH_LINK_HEAL_STATE (default ~/.mesh/.link-heal.state) — "<consecutive_down> <last_rung>
# <epoch> <iface> <gateway> <first_down_epoch> <last_action_epoch>". Rewritten on EVERY run so its
# mtime is ran-live, per the liveness-touch convention: a long-healthy link must not decay into a
# false STALE. Fields are APPEND-ONLY: a state file written by an older copy is read with the trailing
# fields at 0, which reads as "no episode open" and never as a fault dating from the epoch.
# Log:   $MESH_LINK_HEAL_LOG   (default ~/.mesh/link-heal.log) — the durable record of every action.
set -uo pipefail

# `iw` and `ip` live in /usr/sbin, which cron's default PATH (/usr/bin:/bin) does not carry. Without
# this line the perception silently degrades: `iw` is not found, is_associated() returns false, and a
# perfectly healthy link reads DEAUTHED on every cron tick — the ladder then climbs to the end and
# re-plugs the dongle on a link that was never down, i.e. the healer becomes the outage. Caught by
# running the tool under a stripped environment before wiring it, not by reading it. The --test has
# a leg that re-drives exactly this.
# Only prepend when the tools are not already reachable, so a caller that deliberately puts its own
# `iw`/`ip` in front of us — the --test does exactly that to drive the no-route branch — is not
# silently overridden by the system copies.
command -v iw >/dev/null 2>&1 && command -v ip >/dev/null 2>&1 || { PATH="/usr/sbin:/sbin:$PATH"; export PATH; }

STATE="${MESH_LINK_HEAL_STATE:-$HOME/.mesh/.link-heal.state}"
LOG="${MESH_LINK_HEAL_LOG:-$HOME/.mesh/link-heal.log}"
# Where interfaces are enumerated from. Overridable ONLY so --test can drive the routeless branch
# against a fixture; a fixture cannot cover the live path, so the real adapter is asserted separately.
NETDIR="${MESH_LINK_HEAL_NETDIR:-/sys/class/net}"
AMBIGUOUS=""

REASSOC_AFTER="${MESH_LINK_HEAL_REASSOC_AFTER:-2}"
BOUNCE_AFTER="${MESH_LINK_HEAL_BOUNCE_AFTER:-4}"
RELOAD_AFTER="${MESH_LINK_HEAL_RELOAD_AFTER:-7}"
REPLUG_AFTER="${MESH_LINK_HEAL_REPLUG_AFTER:-10}"
SHOUT_AFTER="${MESH_LINK_HEAL_SHOUT_AFTER:-14}"
PING_W="${MESH_LINK_HEAL_PING_W:-2}"

# Driver reload is the only rung that unloads hardware support; a node whose adapter does not
# re-probe would be left dark, so it is overridable per node.
ALLOW_RELOAD="${MESH_LINK_HEAL_ALLOW_RELOAD:-1}"

# ---------------------------------------------------------------- the epistemic cut
# THE LADDER IS COUNTED IN TICKS AND THE FAULT RUNS IN SECONDS, AND THOSE ARE NOT THE SAME QUANTITY.
# down_checks is a RATE-INDEPENDENT symbol: it advances once per run that observed the link down. The
# wedge is RATE-DEPENDENT: it lasts wall-clock seconds whether or not anyone counted. The two agree
# only while every scheduled tick actually lands, and on this node they do not — 1727 runs delivered
# in a 2177-minute window (79.3%, measured 2026-08-18 from link-heal.cron.log's line count over its
# birth time). Worse, every honest n/a exit (no radio, ambiguous radios, missing tool) returns before
# the counter is touched, so physical time passes while the symbol is frozen. That freeze is not
# hypothetical: 2026-08-17T01:10:07Z ACTION at down_checks=2 -> 01:18:01Z RECOVERED still at
# down_checks=2, i.e. 7m54s of live fault recorded as ZERO further checks (and 15:09:07 -> 15:14:01,
# 4m54s recorded as one). Those two froze via the disarm bug fixed in 5a04e4f, but the disarm was
# only ONE of the paths that freeze it; the conversion itself was never there.
# The consequence was in the alert text: SHOUT_AFTER=14 checks was announced to the board as "after
# 14 min", so the one line that summons a human understated a 55-minute outage as a 14-minute one.
#
# So the ladder now reads BOTH axes and the fold NAMES ITS WINNER (effective_n): the tick count, and
# the elapsed seconds divided by the nominal cadence. A frozen counter can no longer stall the climb,
# because the clock carries it; a fast burst of extra runs cannot outrun the clock either.
#
# The other half of the cut is the CONTROL side. An act is not instantaneous: a driver reload or a USB
# re-enumeration takes tens of seconds before the link COULD be up, and a measurement taken inside
# that transient reads "still down" as evidence of the FAULT when it is evidence of the CURE. Those
# checks are named `settling`: they still observe and still print, they do not advance down_checks and
# they never act. The clock axis keeps running through them, so a settle window can delay a rung but
# can never cancel the escalation.
TICK="${MESH_LINK_HEAL_TICK:-60}"          # nominal seconds between scheduled checks (the cadence)

# How long after each rung the link COULD not yet be back, in seconds — the rate-dependent half.
# Measured from when the action RETURNS, so the sleeps already inside do_reload/do_replug are not
# double-counted. A rung absent from this table settles instantly.
settle_secs() {
  case "$1" in
    reassociate) printf 15  ;;   # supplicant re-attach + DHCP
    bounce)      printf 25  ;;   # + carrier down/up
    reload)      printf 60  ;;   # + module unload/load and USB re-probe
    replug)      printf 75  ;;   # + full device re-enumeration
    *)           printf 0   ;;
  esac
}

# max(ticks, clock) -> "<n_eff> <winner>". Two renderings of "how long has this been down" must be
# folded by something that says WHICH one won, or a reader cannot tell a counted minute from a
# measured one.
effective_n() {
  local n="$1" secs="${2:-0}" byclock
  case "$n"    in (*[!0-9]*|'') n=0    ;; esac
  case "$secs" in (*[!0-9]*|'') secs=0 ;; esac
  byclock=$(( secs / TICK ))
  if   [ "$byclock" -gt "$n" ]; then printf '%s clock' "$byclock"
  elif [ "$n" -gt "$byclock" ]; then printf '%s ticks' "$n"
  else                               printf '%s agree' "$n"; fi
}

ts() { date -u +%FT%TZ; }
say() { printf '%s\n' "$*"; }
logline() { printf '%s  %s\n' "$(ts)" "$*" >>"$LOG" 2>/dev/null || true; }

# ---------------------------------------------------------------- discovery
# The interface we tend is the WIRELESS station that carries the default route. Both halves matter:
# wireless-only would pick a second dongle that routes nothing, default-route-only would pick an
# ethernet link this driver story does not apply to.
# A MISSING TOOL IS NOT A DOWN LINK. The PATH prepend above fixes the known case, but any absence of
# `iw`/`ip`/`ping` must render n/a (exit 2) rather than flow into is_associated() as a false "not
# connected" — an absent probe reporting the alarming value is how a healer starts healing nothing.
require_tools() {
  local t missing=
  for t in iw ip ping; do command -v "$t" >/dev/null 2>&1 || missing="$missing $t"; done
  [ -z "$missing" ] && return 0
  say "link-heal: n/a — required tool(s) not on PATH:$missing (PATH=$PATH). Refusing to read an absence as a down link."
  exit 2
}

is_wireless() { [ -d "$NETDIR/$1/wireless" ] || [ -d "$NETDIR/$1/phy80211" ]; }

# Every wireless interface the node HAS, independent of routing. Read from sysfs rather than `iw dev`
# because a hard-wedged adapter can stop answering netlink while its interface still exists — and the
# whole point of this fallback is to keep working when the adapter is in exactly that state.
wireless_stations() {
  local d n
  for d in "$NETDIR"/*; do
    n="$(basename "$d")"
    [ "$n" = "*" ] && continue
    is_wireless "$n" && printf '%s\n' "$n"
  done
}

# Prints "<iface> <route-mode>" where route-mode is `route` (the interface carries the default route)
# or `absent` (the node has NO default route at all and this is its only radio).
#
# WHY THE FALLBACK EXISTS — read this before simplifying it back. The first version derived the
# interface ONLY from the default route. On 2026-08-17 the dongle wedged at 16:04Z, the route went
# with it, and for 55 minutes this reflex ran once a minute and printed "n/a — no wireless station
# interface carries the default route" 48 times in a row. It never climbed one rung; the outage ended
# when the OPERATOR pulled the dongle out and plugged it into another port. A healer gated on an
# artifact that its own fault destroys is disarmed exactly when it is needed, and it fails GREEN — the
# n/a reads as "not my node", not as "I am blind". Sibling of the predicate-that-names-a-node and of
# the edge-gate-that-reads-the-state-it-just-wrote.
#
# The fallback is deliberately narrow. It applies ONLY when there is no default route AT ALL — a node
# with a working wired route keeps rendering n/a, so an idle wifi card on an ethernet-routed node is
# never reassociated, bounced or re-plugged by a tool that has no business touching it. That would be
# the healer becoming the outage, which this file's header already warns about in another voice.
find_iface() {
  local dev list count
  dev="$(ip route show default 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
  if [ -n "$dev" ]; then
    is_wireless "$dev" || return 1        # routed, but not over a radio — not ours to tend
    printf '%s route' "$dev"; return 0
  fi

  # No default route anywhere: the node has no uplink. If it owns exactly one radio, that radio IS
  # the story, route or no route.
  list="$(wireless_stations)"
  count="$(printf '%s\n' "$list" | grep -c .)"
  case "$count" in
    0) return 1 ;;
    1) printf '%s absent' "$list"; return 0 ;;
    *) # More than one radio and nothing to disambiguate by: acting would be a guess. Prefer the one
       # we tended last (remembered in the state file); otherwise say why we are standing down, so
       # this renders as a NAMED refusal and not as the old silent "not my node".
       if [ -n "${KNOWN_IFACE:-}" ] && printf '%s\n' "$list" | grep -qx -- "$KNOWN_IFACE"; then
         printf '%s absent'  "$KNOWN_IFACE"; return 0
       fi
       AMBIGUOUS="$(printf '%s' "$list" | tr '\n' ' ')"
       return 1 ;;
  esac
}

gateway_of() {
  ip route show default 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}'
}

# ---------------------------------------------------------------- perception
# associated? — the station's own view, not the carrier bit (the carrier can lie on a wedge).
is_associated() {
  local w="$1" out
  out="$(iw dev "$w" link 2>/dev/null)" || return 1
  case "$out" in
    *"Not connected"*) return 1 ;;
    *Connected*)       return 0 ;;
    *)                 return 1 ;;
  esac
}

# passing traffic? — two attempts, because a single probe on THIS link lands inside a deauth window
# often enough to poison the verdict (measured: the path is down ~10% of wallclock).
gw_answers() {
  local gw="$1"
  [ -n "$gw" ] || return 1
  ping -c1 -W"$PING_W" -n "$gw" >/dev/null 2>&1 && return 0
  sleep 1
  ping -c1 -W"$PING_W" -n "$gw" >/dev/null 2>&1
}

# ---------------------------------------------------------------- state
# Fields 4 and 5 (iface, last-known gateway) are REMEMBERED, not authoritative: they exist so a run
# that finds no default route can still name the radio it tended and the gateway it used to reach —
# the two facts the wedge deletes. They are appended, so a reader of the old three-field format is
# unaffected.
read_state() {
  DOWN_N=0; LAST_RUNG=none; KNOWN_IFACE=""; KNOWN_GW=""; FIRST_DOWN=0; ACTED_AT=0; EPISODE_SHAPE=""
  if [ -r "$STATE" ]; then
    read -r DOWN_N LAST_RUNG _ KNOWN_IFACE KNOWN_GW FIRST_DOWN ACTED_AT EPISODE_SHAPE <"$STATE" 2>/dev/null || {
      DOWN_N=0; LAST_RUNG=none; KNOWN_IFACE=""; KNOWN_GW=""; FIRST_DOWN=0; ACTED_AT=0; EPISODE_SHAPE=""; }
  fi
  case "$DOWN_N" in (*[!0-9]*|'') DOWN_N=0 ;; esac
  [ -n "${LAST_RUNG:-}" ]   || LAST_RUNG=none
  # `-` is the empty-field placeholder, and it exists because the fields are SPACE-separated and read
  # with the default IFS: an empty iface or gateway used to be written as a run of two spaces, which
  # `read` COLLAPSES, shifting every later field left. A wedge that erased the gateway therefore fed
  # the timestamp into KNOWN_GW and silently zeroed FIRST_DOWN — the one artifact the ladder climbs
  # on. Same shape as [[a-leading-empty-field-shifts-under-tab-read]], space-separated.
  [ -n "${KNOWN_IFACE:-}" ] && [ "$KNOWN_IFACE" != "-" ] || KNOWN_IFACE=""
  [ -n "${KNOWN_GW:-}" ]    && [ "$KNOWN_GW" != "-" ]    || KNOWN_GW=""
  [ -n "${EPISODE_SHAPE:-}" ] && [ "$EPISODE_SHAPE" != "-" ] || EPISODE_SHAPE=""
  # Forward-compatible, not backward: a copy of this tool from BEFORE the placeholder would read a
  # `-` gateway as a literal address and ping it. Nothing on a node runs two copies at once, so the
  # only way to meet that is a revert — and the first UP run rewrites the file with a real gateway.
  # Fields 6-7 are the epistemic cut's clock half and are ABSENT from every state file written
  # before it existed. A missing timestamp must read as "no episode open", never as epoch 0 — the
  # latter would render a 56-year-old fault and fire the top rung on the first down check.
  case "${FIRST_DOWN:-}" in (*[!0-9]*|'') FIRST_DOWN=0 ;; esac
  case "${ACTED_AT:-}"   in (*[!0-9]*|'') ACTED_AT=0   ;; esac
}
write_state() {
  local _if="${3:-${KNOWN_IFACE:-}}" _gw="${4:-${KNOWN_GW:-}}" _sh="${7-${EPISODE_SHAPE:-}}"
  printf '%s %s %s %s %s %s %s %s\n' "$1" "$2" "$(date +%s)" "${_if:--}" \
    "${_gw:--}" "${5:-0}" "${6:-0}" "${_sh:--}" \
    >"$STATE" 2>/dev/null || true
}

# ---------------------------------------------------------------- the layer oracle
# ONE WORD naming WHICH LAYER owns a "this node cannot reach the internet" moment.
#
# It exists because every OTHER alarm on this fault answers a question nobody asked. mesh-isp-health
# pings 1.1.1.1 THROUGH the wedged dongle, gets nothing, and returns `upstream-down`; mesh-selfcare
# rendered that as "(upstream-down → ISP broken)" and mesh-revive as "internet starvation — self-heal
# failed. Path may need you." On 2026-08-17 16:09→17:04Z all three fired, all three were honest
# readings of their own probe, and all three named the ISP while the actual fault was this node's USB
# dongle (36783 `usb write fail status -71` in one hour, ended by a physical re-plug). A PROBE THAT
# RIDES THE BROKEN LINK IS NOT EVIDENCE ABOUT WHAT IS ON THE FAR SIDE OF IT — it cannot distinguish
# the two layers even in principle, so its verdict must never be rendered as if it could.
#
# Unlike main(), this answers on EVERY node. A wired node has no radio to tend, so main() renders n/a
# (correctly, it must never bounce an interface it does not own) — but it still has a default route
# and a gateway, and those two facts alone separate "my own uplink is down" from "my uplink works and
# the far side does not". Read-only in the strong sense: no action, no state write, no log line, so a
# consumer polling it can neither change the substrate nor forge this reflex's own liveness artifact.
#   UP        this node's uplink passes traffic (route present, gateway answers) — look beyond us
#   ROUTELESS no default route at all: L3 is gone on this node, whatever the medium
#   DEAUTHED  wireless uplink not associated to its AP
#   WEDGED    route + association present, gateway answers nothing — the long-outage shape
#   UNKNOWN   the probes themselves are absent. Never collapse that into a verdict: an absent probe
#             reporting the alarming value is how a healer starts healing nothing (require_tools).
layer_verdict() {
  local dev gw
  command -v ip >/dev/null 2>&1 && command -v ping >/dev/null 2>&1 || { printf 'UNKNOWN\n'; return 0; }
  read_state
  dev="$(ip route show default 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
  [ -n "$dev" ] || { printf 'ROUTELESS\n'; return 0; }
  if is_wireless "$dev" && command -v iw >/dev/null 2>&1 && ! is_associated "$dev"; then
    printf 'DEAUTHED\n'; return 0
  fi
  # The wedge deletes the route and the gateway with it; fall back to the one remembered from a run
  # that saw the link UP, so the probe still has an address instead of collapsing to an unmeasured no.
  gw="$(gateway_of)"; [ -n "$gw" ] || gw="$KNOWN_GW"
  if gw_answers "$gw"; then printf 'UP\n'; else printf 'WEDGED\n'; fi
}

# ---------------------------------------------------------------- the ladder
# THE one place the escalation is decided. main() calls it and so does --test; a test that
# re-implements this arithmetic asserts its own copy and stays green while the real ladder rots.
#   choose_rung <consecutive_down_checks> <last_rung_attempted> [down_secs] [settle_left_secs]
#                                                                ->  prints the action
# A rung never fires twice in a row: without that guard a reassociate would re-fire every minute,
# which is a storm, not an escalation.
# Args 3-4 are the epistemic cut and both DEFAULT TO 0, so a two-argument call decides on the tick
# count alone exactly as before. Arg 3 lets the clock outvote a frozen counter; arg 4 suppresses any
# action taken inside the previous rung's settling transient — measuring the cure and scoring it as
# the disease is how a ladder stacks a re-plug on top of a reload that had not finished yet.
choose_rung() {
  local n="$1" last="$2" secs="${3:-0}" settle_left="${4:-0}"
  case "$settle_left" in (*[!0-9]*|'') settle_left=0 ;; esac
  [ "$settle_left" -gt 0 ] && { printf settling; return 0; }
  n="$(effective_n "$n" "$secs")"; n="${n%% *}"
  if   [ "$n" -ge "$SHOUT_AFTER" ];                                 then printf shout
  elif [ "$n" -ge "$REPLUG_AFTER" ] && [ "$last" != replug ];       then printf replug
  elif [ "$n" -ge "$RELOAD_AFTER" ] && [ "$last" != reload ] \
                                    && [ "$last" != replug ];       then printf reload
  elif [ "$n" -ge "$BOUNCE_AFTER" ] && [ "$last" != bounce ] \
                                    && [ "$last" != reload ] \
                                    && [ "$last" != replug ];       then printf bounce
  elif [ "$n" -ge "$REASSOC_AFTER" ] && [ "$last" = none ];         then printf reassociate
  else                                                                   printf none
  fi
}

# ---------------------------------------------------------------- actions
do_reassociate() {
  local w="$1"
  sudo -n wpa_cli -i "$w" reassociate >/dev/null 2>&1
}
do_bounce() {
  local w="$1"
  sudo -n ip link set "$w" down >/dev/null 2>&1
  sleep 2
  sudo -n ip link set "$w" up >/dev/null 2>&1
  sleep 2
  sudo -n wpa_cli -i "$w" reassociate >/dev/null 2>&1
}
# The driver reload. Unload the USB glue then the chip module; modprobe pulls both back with their
# dependencies. Ordering matters — unloading the core first is refused while the USB half holds it.
do_reload() {
  local mods="rtw88_8822bu rtw88_8822b rtw88_usb rtw88_core"
  local m
  for m in $mods; do sudo -n modprobe -r "$m" >/dev/null 2>&1; done
  sleep 2
  sudo -n modprobe rtw88_8822bu >/dev/null 2>&1
  sleep 8
}

# The USB bus path the adapter sits on, e.g. "1-2.4" — derived from the interface, never pinned in
# config, because this adapter's path MOVES (1-6 -> 1-2.4 across the 14:23Z outage alone) and a
# path-pinned tool reads a fossil.
usb_path_of() {
  local w="$1" dev
  dev="$(readlink -f "/sys/class/net/$w/device" 2>/dev/null)" || return 1
  # .../usb1/1-2/1-2.4/1-2.4:1.0  -> want the 1-2.4 component (the device, not the interface)
  dev="$(basename "$(dirname "$dev")")"
  case "$dev" in (*-*) printf '%s' "$dev" ;; (*) return 1 ;; esac
}

# The software re-plug. `authorized` is a kernel pseudo-file: its mode bit says nothing about whether
# the write will be ACCEPTED, so probe by attempting the write and checking the result rather than
# gating on [ -w ]. Returns non-zero if the deauthorize did not take, so the caller can log the
# difference between "tried and refused" and "tried and did nothing".
do_replug() {
  local w="$1" p f
  p="$(usb_path_of "$w")" || return 1
  f="/sys/bus/usb/devices/$p/authorized"
  printf '0' | sudo -n tee "$f" >/dev/null 2>&1 || return 1
  sleep 3
  printf '1' | sudo -n tee "$f" >/dev/null 2>&1 || return 1
  sleep 10
  return 0
}

# ---------------------------------------------------------------- verdict
main() {
  local mode="${1:-run}" w gw assoc traffic state_word action rung found route_mode

  require_tools
  # State is read BEFORE discovery: the routeless branch consults the remembered interface, and a
  # discovery that cannot see what we tended last would have to guess between two radios.
  read_state
  found="$(find_iface)" || {
    if [ -n "$AMBIGUOUS" ]; then
      say "link-heal: n/a — no default route and this node has MORE THAN ONE wireless station ($AMBIGUOUS) with no record of which one is the uplink. Standing down rather than guessing which radio to bounce."
    else
      say "link-heal: n/a — no wireless station to tend here: default route is '$(ip route show default 2>/dev/null | head -1 | tr -s ' ' || true)' (wired, or none) and $(wireless_stations | grep -c .) radio(s) present"
    fi
    exit 2
  }
  w="${found%% *}"; route_mode="${found##* }"

  gw="$(gateway_of)"
  # The wedge deletes the default route, so with it goes the gateway address the traffic probe needs.
  # Fall back to the one we recorded while the link WAS up: a remembered gateway lets the probe still
  # answer "is this radio passing traffic" instead of collapsing to an unmeasured no.
  [ -n "$gw" ] || gw="$KNOWN_GW"

  assoc=no;   is_associated "$w" && assoc=yes
  traffic=no; [ "$assoc" = yes ] && gw_answers "$gw" && traffic=yes

  if [ "$assoc" = yes ] && [ "$traffic" = yes ] && [ "$route_mode" = route ]; then
    state_word=UP
  elif [ "$route_mode" = absent ] && [ "$assoc" = yes ]; then
    # Associated to the AP with no default route at all: L1/L2 are up and L3 is gone. Distinct from
    # WEDGED so the tape says which of the two shapes the ladder was climbing against.
    state_word=ROUTELESS
  elif [ "$assoc" = yes ]; then
    state_word=WEDGED      # associated and carrying nothing — the long-outage shape
  else
    state_word=DEAUTHED
  fi

  # The clock half of the cut. down_secs is the PHYSICAL age of the open fault episode; it is 0
  # while the link is up, and it keeps running through ticks that were never delivered.
  local now down_secs eff eff_n eff_by settle_left
  now="$(date +%s)"
  # episode_secs is the age of the OPEN episode regardless of the current verdict — it is what the
  # RECOVERED line must report, and zeroing down_secs on an UP run destroys it (29/29 RECOVERED lines
  # read "0s of real outage" before this was fixed, including 2-down-check episodes, while the comment
  # below claimed the two quantities were "never collapsed"). Keep both: down_secs is the live-fault
  # age (0 while up, by design — the escalation ladder must not climb on a closed episode), and
  # episode_secs is the closing measurement.
  local episode_secs=0
  if [ "$FIRST_DOWN" -gt 0 ] && [ "$FIRST_DOWN" -le "$now" ]; then episode_secs=$(( now - FIRST_DOWN )); fi
  if [ "$state_word" = UP ]; then down_secs=0
  elif [ "$FIRST_DOWN" -gt 0 ] && [ "$FIRST_DOWN" -le "$now" ]; then down_secs=$(( now - FIRST_DOWN ))
  else down_secs=0; fi          # episode opens on this run (or the stamp is unusable) -> age 0
  eff="$(effective_n "$DOWN_N" "$down_secs")"; eff_n="${eff%% *}"; eff_by="${eff##* }"
  settle_left=0
  if [ "$ACTED_AT" -gt 0 ] && [ "$ACTED_AT" -le "$now" ]; then
    settle_left=$(( $(settle_secs "$LAST_RUNG") - (now - ACTED_AT) ))
    [ "$settle_left" -lt 0 ] && settle_left=0
  fi

  if [ "$mode" = "--status" ]; then
    say "link-heal: iface=$w state=$state_word route=$route_mode assoc=$assoc gw=$gw traffic=$traffic down_checks=$DOWN_N down_secs=${down_secs}s escalation=$eff_n by=$eff_by settle_left=${settle_left}s last_rung=$LAST_RUNG (read-only)"
    write_state "$DOWN_N" "$LAST_RUNG" "$w" "$gw" "$FIRST_DOWN" "$ACTED_AT"
    exit 0
  fi

  if [ "$state_word" = UP ]; then
    # Name the rung that preceded the recovery, so the log can answer WHICH rung worked rather
    # than merely that the link returned.
    if [ "$DOWN_N" -gt 0 ]; then
      # Both quantities, never collapsed: the checks are what we COUNTED, the seconds are what the
      # node actually spent dark. Their gap is the ticks that never landed plus the runs that
      # returned n/a — the number a "down_checks == minutes" reading silently throws away.
      logline "RECOVERED iface=$w shape=${EPISODE_SHAPE:-na} after ${DOWN_N} down-check(s) / ${episode_secs}s of real outage; last rung attempted: $LAST_RUNG"
    fi
    # An UP run is the only moment the gateway is known for certain — record it here so the routeless
    # branch has something real to probe with later. The episode clock and the settle stamp are
    # cleared here and ONLY here: recovery is what closes an episode.
    write_state 0 none "$w" "$gw" 0 0 ""
    [ "$mode" = "--json" ] && say "{\"iface\":\"$w\",\"state\":\"UP\",\"route\":\"$route_mode\",\"down_checks\":0,\"action\":\"none\"}"
    [ "$mode" = "--json" ] || say "link-heal: UP iface=$w gw=$gw"
    exit 0
  fi

  # The episode clock starts at the FIRST down observation and is never restarted by a later one.
  [ "$FIRST_DOWN" -gt 0 ] && [ "$FIRST_DOWN" -le "$now" ] || FIRST_DOWN="$now"

  # THE PERTURBATION CLASS, carried through to the closing line. The RECOVERED line named the rung
  # that preceded recovery but never WHICH FAULT the ladder climbed against, so the tape could not
  # hold the perturbation constant while comparing what recovery cost — and a rising cost caused
  # purely by a shift from DEAUTHED to WEDGED episodes was indistinguishable from a rising cost at
  # fixed fault (see cost_drift()). Recorded at episode open; an episode that changes shape under
  # the ladder becomes `mixed`, never silently relabelled to whichever shape happened to be last.
  if [ -z "$EPISODE_SHAPE" ]; then EPISODE_SHAPE="$state_word"
  elif [ "$EPISODE_SHAPE" != "$state_word" ] && [ "$EPISODE_SHAPE" != mixed ]; then EPISODE_SHAPE=mixed
  fi

  # ONE call to the ladder, made against the count this check WOULD reach — so a settling verdict can
  # decline the increment while a real verdict keeps the pre-existing "act on the Nth down check"
  # arithmetic byte for byte.
  local down_next=$(( DOWN_N + 1 ))
  action="$(choose_rung "$down_next" "$LAST_RUNG" "$down_secs" "$settle_left")"

  # A settling check is a measurement of our own cure, not of the fault: it prints, it keeps the
  # episode clock running (so the ladder can still be carried by wall-clock through a long settle),
  # and it advances NOTHING. Scoring it as another down-check is what would stack a re-plug on a
  # driver reload that had not finished re-enumerating yet.
  if [ "$action" = settling ]; then
    write_state "$DOWN_N" "$LAST_RUNG" "$w" "${gw:-$KNOWN_GW}" "$FIRST_DOWN" "$ACTED_AT"
    if [ "$mode" = "--json" ]; then
      say "{\"iface\":\"$w\",\"state\":\"$state_word\",\"route\":\"$route_mode\",\"down_checks\":$DOWN_N,\"down_secs\":$down_secs,\"action\":\"settling\",\"settle_left\":$settle_left}"
    else
      say "link-heal: $state_word iface=$w route=$route_mode down_checks=$DOWN_N down_secs=${down_secs}s action=settling settle_left=${settle_left}s after=$LAST_RUNG"
    fi
    exit 0
  fi

  DOWN_N="$down_next"
  eff="$(effective_n "$DOWN_N" "$down_secs")"; eff_n="${eff%% *}"; eff_by="${eff##* }"
  rung="$LAST_RUNG"

  case "$action" in
    reassociate) do_reassociate "$w"; rung=reassociate
                 logline "ACTION reassociate iface=$w state=$state_word down_checks=$DOWN_N" ;;
    bounce)      do_bounce "$w";      rung=bounce
                 logline "ACTION bounce (link down/up + reassociate) iface=$w state=$state_word down_checks=$DOWN_N" ;;
    reload)      if [ "$ALLOW_RELOAD" = 1 ]; then
                   logline "ACTION driver reload iface=$w state=$state_word down_checks=$DOWN_N"
                   do_reload; rung=reload
                 else
                   logline "SKIP driver reload — MESH_LINK_HEAL_ALLOW_RELOAD=0 on this node (down_checks=$DOWN_N)"
                   rung=reload-skipped
                 fi ;;
    replug)      if [ "$ALLOW_RELOAD" = 1 ]; then
                   logline "ACTION usb re-enumerate iface=$w usb=$(usb_path_of "$w" || echo unknown) state=$state_word down_checks=$DOWN_N — the software equivalent of pulling the dongle"
                   if do_replug "$w"; then rung=replug
                   else logline "FAILED usb re-enumerate — the authorized write was refused or the usb path is unreadable; the driver reload rung is all we have here"
                        rung=replug-failed; fi
                 else
                   logline "SKIP usb re-enumerate — MESH_LINK_HEAL_ALLOW_RELOAD=0 on this node (down_checks=$DOWN_N)"
                   rung=replug-skipped
                 fi ;;
    shout)       logline "EXHAUSTED iface=$w still $state_word after ${DOWN_N} check(s) / ${down_secs}s (escalation=$eff_n by=$eff_by) — a human is needed"
                 # NEVER print a tick count with a time unit. This line used to say "after ${DOWN_N}
                 # min", which is only true if every scheduled tick landed; on this node 79.3% do,
                 # so the one message that summons a human understated the outage it was reporting.
                 command -v mesh-chat >/dev/null 2>&1 && \
                   mesh-chat "[alert] link-heal: $(hostname) sole uplink $w still $state_word after $(( down_secs / 60 ))m$(( down_secs % 60 ))s wall-clock (${DOWN_N} down-checks; escalation carried by=$eff_by) — reassociate, link bounce and driver reload all failed. This is the rtw_8822bu wedge past every rung; the node needs hands or a reboot. Tape: $LOG" >/dev/null 2>&1
                 rung=exhausted ;;
  esac

  # Keep the remembered iface/gw across a down run: they are what the NEXT routeless check needs, and
  # overwriting them with the empty values a wedge produces would erase the memory at the one moment
  # it becomes load-bearing.
  # An acting rung stamps the moment the action RETURNED, which is when its settle window opens.
  # A non-acting check leaves the previous stamp alone.
  case "$action" in (none|shout) : ;; (*) ACTED_AT="$(date +%s)" ;; esac
  write_state "$DOWN_N" "$rung" "$w" "${gw:-$KNOWN_GW}" "$FIRST_DOWN" "$ACTED_AT"

  if [ "$mode" = "--json" ]; then
    say "{\"iface\":\"$w\",\"state\":\"$state_word\",\"route\":\"$route_mode\",\"down_checks\":$DOWN_N,\"down_secs\":$down_secs,\"escalation\":$eff_n,\"by\":\"$eff_by\",\"action\":\"$action\"}"
  else
    say "link-heal: $state_word iface=$w route=$route_mode down_checks=$DOWN_N down_secs=${down_secs}s escalation=$eff_n by=$eff_by action=$action"
  fi

  [ "$action" = shout ] && exit 3
  exit 0
}

# ---------------------------------------------------------------- self-test
# The test drives the REAL perception path against the REAL adapter (a --test that only exercises
# stubs asserts nothing about the thing it wraps), and drives the LADDER against a scratch state
# file. It never writes the real log or the real state — a dry-run that writes the artifact a human
# or watchdog reads for liveness forges the very evidence it exists to check.
# ---------------------------------------------------------------- the cost-drift lens
# LITERATURE (homeostasis / allostasis / ultrastability — live review 2026-08-19, genome mind).
# Concept: GATED HOMEOSTASIS AND CRYPTIC STORAGE OF PRIOR PERTURBATIONS.
#   Alonso, Rue & Marder, "Gating of homeostatic regulation of intrinsic excitability produces
#   cryptic long-term storage of prior perturbations", PNAS 120(26):e2222016120 (2023),
#   doi:10.1073/pnas.2222016120.
# The result, in one sentence: they gave the classic Liu homeostatic-conductance model a GATE — the
# adaptation timescale is modulated by how far the cell is from its target, so at target the
# effective timescale runs to ~10^30 tau_G and the regulator is, for practical purposes, OFF. That
# gating is metabolically sensible (no channel-protein turnover while nothing is wrong) and it has a
# consequence the ungated model does not have: **because the loop pulls the OUTPUT back to target and
# nothing pulls the CONFIGURATION back to where it started, every recovery lands on a DIFFERENT point
# in conductance space.** Baseline activity is indistinguishable from control. The displacement is
# invisible until the next perturbation, when the identical stimulus elicits a different response —
# "history-dependent responses ... revealing accumulated changes from prior perturbations despite
# maintaining control-like resting activity" (their Fig. 7). Recovery is a claim about the regulated
# variable, never about the state.
#
# WHY IT LANDS HERE. This reflex IS a gated homeostat: it observes exactly one variable (does the
# link pass traffic), it acts only while that variable is off target, and the moment it returns it
# writes `write_state 0 none ...` and forgets the entire episode. 68 RECOVERED episodes on this node
# (2026-08-16..19) and the healer's behaviour on episode 68 is byte-for-byte its behaviour on episode
# 1: the ladder always restarts at rung 0. The link came back every time, so every liveness frame is
# honest and green — and that is precisely what makes any drift cryptic. Nothing here reads its own
# recovery history back.
#
# WHAT IS MEASURABLE. The analogue of "which conductances the cell settled on" is the LADDER HEIGHT
# the episode demanded: rung `none` means the deauth cleared itself, `reload` means the driver had to
# be rebuilt. That number is already on the tape, one row per episode, and it is the cost of holding
# the output constant. If it trends upward across episodes while the outcome column stays RECOVERED,
# the mesh is paying more for the same result — the observable signature of a configuration that has
# moved. `--cost-drift` is that read and nothing more.
#
# WHAT THIS DOES NOT SAY, AND MUST NOT BE READ AS SAYING. A rising ladder cost is consistent with at
# least three causes and this data cannot separate them: healer-side remodeling (the cryptic-storage
# reading), device-side degradation (the dongle is simply wearing out), and a shift in the MIX of
# fault shapes (more WEDGED episodes, which are dearer than DEAUTHED ones, would raise the mean with
# no drift at all). Alonso et al. can exclude the third because their perturbation is identical by
# construction; we cannot, because ours is whatever the radio did that hour. So the verdict word
# names the OBSERVABLE — COST-DRIFT-UP, not "the link is degrading"
# ([[a-shared-observable-cannot-name-the-mechanism]]). The shape stratum this commit starts writing
# is the first step toward excluding the third cause; it can only exclude it for episodes recorded
# from here forward, and it says so.
#
# Read-only in the strong sense: no action, no state write, no log line. Overridable
# MESH_LINK_HEAL_LOG so --test drives it against scratch fixtures and can never read or grow the
# durable tape ([[a-test-that-writes-the-artifact]]).
cost_drift() {
  local json=0; [ "${1:-}" = --json ] && json=1
  local perms="${MESH_LINK_HEAL_PERMS:-999}"
  local perms_d="${MESH_LINK_HEAL_PERMS_D:-199}"
  local seed="${MESH_LINK_HEAL_SEED:-20260819}"
  local minep="${MESH_LINK_HEAL_MIN_EPISODES:-10}"
  local nmax="${MESH_LINK_HEAL_MAX_EPISODES:-500}"
  local alpha_num="${MESH_LINK_HEAL_ALPHA_NUM:-5}"   # alpha = alpha_num/100; integer so awk needs no float parse
  if [ ! -r "$LOG" ]; then
    say "link-heal cost-drift: n/a — no tape at $LOG (this reflex has never logged an episode here)"
    exit 2
  fi
  awk -v PERMS="$perms" -v PERMSD="$perms_d" -v SEED="$seed" -v MINEP="$minep" \
      -v NMAX="$nmax" -v ALPHAN="$alpha_num" -v JSON="$json" -v LOGF="$LOG" '
    function ord(w) {
      # The ladder, as an ordinal. A *-skipped / *-failed rung scores at the height it was DEMANDED
      # at: the episode climbed there, and whether the hand landed is a different question than how
      # far the fault drove the ladder. An unknown word is NEVER coerced to 0 — a healer that grows a
      # rung this lens has not been taught would otherwise silently read as the cheapest recovery
      # there is ([[a-sweeper-is-only-as-good-as-the-names-it-knows]]).
      if (w=="none")                                                  return 0
      if (w=="reassociate")                                           return 1
      if (w=="bounce")                                                return 2
      if (w=="reload"  || w=="reload-skipped")                        return 3
      if (w=="replug"  || w=="replug-failed" || w=="replug-skipped")  return 4
      if (w=="exhausted")                                             return 5
      return -1
    }
    # Mann-Kendall S against episode order. O(n*A) over the small ordinal alphabet.
    function mk_small(r, m,   i,k,s,c) {
      for (k=0;k<=5;k++) c[k]=0
      s=0
      for (i=1;i<=m;i++) {
        for (k=0;k<r[i];k++)   s += c[k]
        for (k=r[i]+1;k<=5;k++) s -= c[k]
        c[r[i]]++
      }
      return s
    }
    # Same statistic on arbitrary values. O(n^2) — used only for the duration axis, which is capped.
    function mk_pairs(v, m,   i,j,s) {
      s=0
      for (i=1;i<m;i++) for (j=i+1;j<=m;j++) { if (v[j]>v[i]) s++; else if (v[j]<v[i]) s-- }
      return s
    }
    function shuf(a, m,   i,j,t) { for (i=m;i>1;i--) { j=int(rand()*i)+1; t=a[i]; a[i]=a[j]; a[j]=t } }
    function absv(x) { return x<0 ? -x : x }
    # Two-sided permutation p. The null PERMUTES THE SAME MULTISET, so the heavy tie structure of the
    # rung column (55 of 68 episodes are `none`) is preserved exactly — which is why this is a
    # permutation test and not a normal approximation: the approximation would need a tie correction
    # that the shuffle gives for free.
    function perm_p(a, m, sobs, k, small,   i,c,sp,cp,b) {
      if (m < 2) return -1
      c=0
      for (i=1;i<=k;i++) {
        for (cp=1;cp<=m;cp++) b[cp]=a[cp]
        shuf(b, m)
        sp = small ? mk_small(b,m) : mk_pairs(b,m)
        if (absv(sp) >= absv(sobs)) c++
      }
      return (c+1)/(k+1)
    }
    /RECOVERED/ {
      total++
      rw=$NF
      o=ord(rw)
      if (o<0) { unkn++; unkw[rw]++; next }
      nr++; R[nr]=o; RTS[nr]=$1
      rcount[o]++
      if (!(o in firstat)) firstat[o]=$1
      sh="na"
      if (match($0,/shape=[A-Za-z]+/)) sh=substr($0,RSTART+6,RLENGTH-6)
      shcount[sh]++
      if (sh!="na") nshape++
      if (match($0,/\/ [0-9]+s of real outage/)) {
        v=substr($0,RSTART+2,RLENGTH-2); sub(/s of real outage/,"",v); v=v+0
        # A logged episode cannot honestly be 0s: RECOVERED fires only with down_checks>=1 and the
        # cadence is one minute, so every real episode spent tens of seconds dark. The 0s rows are
        # the pre-0b8c0ec format, where episode_secs was zeroed by the UP branch before it was
        # printed. Scoring them as fast recoveries would manufacture a rising-duration trend out of
        # the date the FORMAT was fixed ([[a-format-upgrade-never-reaches-a-change-gated-record]]).
        if (v>0) { nd++; D[nd]=v } else zero++
      } else nosec++
    }
    END {
      srand(SEED)
      alpha = ALPHAN/100.0
      # Cap to the most recent NMAX, and SAY when the cap bites — a silent truncation reads as
      # "covered everything".
      rdrop=0
      if (nr > NMAX) { off=nr-NMAX; for (i=1;i<=NMAX;i++) { R[i]=R[i+off]; RTS[i]=RTS[i+off] } rdrop=off; nr=NMAX }
      ddrop=0
      if (nd > NMAX) { off=nd-NMAX; for (i=1;i<=NMAX;i++) D[i]=D[i+off]; ddrop=off; nd=NMAX }

      rv="na"; rs=0; rp=-1
      if (nr >= MINEP) {
        rs = mk_small(R, nr)
        rp = perm_p(R, nr, rs, PERMS, 1)
        if      (rp <= alpha && rs > 0) rv="COST-DRIFT-UP"
        else if (rp <= alpha && rs < 0) rv="COST-DRIFT-DOWN"
        else                            rv="COST-STABLE"
      }
      dv="na"; ds=0; dp=-1
      if (nd >= MINEP) {
        ds = mk_pairs(D, nd)
        dp = perm_p(D, nd, ds, PERMSD, 0)
        if      (dp <= alpha && ds > 0) dv="COST-DRIFT-UP"
        else if (dp <= alpha && ds < 0) dv="COST-DRIFT-DOWN"
        else                            dv="COST-STABLE"
      }

      names[0]="none"; names[1]="reassociate"; names[2]="bounce"; names[3]="reload"
      names[4]="replug"; names[5]="exhausted"
      hist=""
      for (k=0;k<=5;k++) if (k in rcount) hist = hist (hist==""?"":" ") names[k] "=" rcount[k]
      firsts=""
      for (k=1;k<=5;k++) if (k in firstat) firsts = firsts (firsts==""?"":"  ") names[k] "@" firstat[k]
      if (firsts=="") firsts="none above rung 0 has ever been reached"
      unks=""
      for (w in unkw) unks = unks (unks==""?"":",") w "x" unkw[w]

      if (JSON) {
        printf "{\"episodes\":%d,\"rung_n\":%d,\"rung_verdict\":\"%s\",\"rung_S\":%d,\"rung_p\":%.4f,", total, nr, rv, rs, rp
        printf "\"dur_n\":%d,\"dur_verdict\":\"%s\",\"dur_S\":%d,\"dur_p\":%.4f,", nd, dv, ds, dp
        printf "\"excluded_zero_secs\":%d,\"excluded_no_secs\":%d,\"excluded_unknown_rung\":%d,", zero, nosec, unkn
        printf "\"shape_rows\":%d,\"capped_rung\":%d,\"capped_dur\":%d,\"alpha\":%.2f,\"perms\":%d}\n", nshape, rdrop, ddrop, alpha, PERMS
        exit 0
      }
      printf "link-heal cost-drift: tape=%s episodes=%d\n", LOGF, total
      printf "  RUNG axis (the ladder height each recovery demanded)\n"
      if (rv=="na")
        printf "    verdict=na — %d scorable episode(s), need %d. The trend is not weak here, it is unmeasured.\n", nr, MINEP
      else
        printf "    verdict=%s  S=%d  p=%.4f  (permutation null, %d shuffles of the same multiset, alpha=%.2f, n=%d)\n", rv, rs, rp, PERMS, alpha, nr
      printf "    ladder: %s\n", hist
      printf "    first time each rung was ever needed: %s\n", firsts
      printf "  DURATION axis (seconds of real outage per episode)\n"
      if (dv=="na")
        printf "    verdict=na — %d honest seconds reading(s), need %d\n", nd, MINEP
      else
        printf "    verdict=%s  S=%d  p=%.4f  (permutation null, %d shuffles, n=%d)\n", dv, ds, dp, PERMSD, nd
      printf "    excluded: %d row(s) reading \"0s\" (pre-0b8c0ec format artifact, not honest zeros) + %d row(s) with no seconds field at all\n", zero, nosec
      printf "  SHAPE stratum: %d/%d row(s) carry shape=\n", nshape, total
      if (nshape==0)
        printf "    na — the perturbation class is absent from every historical row; it lands from this commit forward, so a shape-held comparison is possible only for episodes recorded after it.\n"
      else {
        s=""
        for (k in shcount) if (k!="na") s = s (s==""?"":" ") k "=" shcount[k]
        printf "    %s\n", s
      }
      if (unkn>0) printf "  EXCLUDED %d episode(s) whose rung word this lens does not know: %s — taught the ladder a new rung? teach ord() too.\n", unkn, unks
      if (rdrop>0 || ddrop>0) printf "  CAPPED to the most recent %d episodes: dropped %d from the rung axis, %d from the duration axis.\n", NMAX, rdrop, ddrop
      printf "  NOT A MECHANISM. A rising cost is equally consistent with healer-side remodeling (cryptic\n"
      printf "  storage, Alonso/Rue/Marder PNAS 2023), with the dongle degrading, and with a shift in the mix\n"
      printf "  of fault shapes. This lens names the observable; it cannot name the cause.\n"
    }
  ' "$LOG"
  exit 0
}

run_test() {
  local fails=0 tmpd out w
  tmpd="$(mktemp -d)" || { echo "test: cannot mktemp"; exit 1; }
  mkdir -p "$tmpd/empty"
  trap 'rm -rf "$tmpd"' EXIT

  echo "== mesh-link-heal --test =="

  # 1. THE DISARM GATE — three legs, because "no default route" is not one situation.
  #    The 2026-08-17 16:04->17:03Z outage (55 min, ended by the OPERATOR'S HANDS) ran this reflex 48
  #    times and it printed n/a 48 times: the wedge deletes the default route, find_iface() derived
  #    the interface FROM that route, so the healer was disarmed by the exact fault it exists to heal.
  #    A healer must never be gated on an artifact its fault destroys.
  #    The legs are separated because the honest-n/a case and the must-climb case were collapsed into
  #    one before, and collapsing them is what shipped the blindness.
  mkdir -p "$tmpd/fakebin" "$tmpd/netdir-empty" "$tmpd/netdir-one/wlt0/phy80211" "$tmpd/netdir-eth/eth9"
  printf '#!/bin/sh\nexit 0\n' > "$tmpd/fakebin/ip"; chmod +x "$tmpd/fakebin/ip"
  printf '#!/bin/sh\necho "Not connected."\nexit 0\n' > "$tmpd/fakebin/iw"; chmod +x "$tmpd/fakebin/iw"
  # `ip` printing a WIRED default route: the node has an uplink, just not ours to tend.
  printf '#!/bin/sh\ncase "$*" in *"route show default"*) echo "default via 10.0.0.1 dev eth9";; esac\nexit 0\n' \
    > "$tmpd/fakebin/ip-eth"; chmod +x "$tmpd/fakebin/ip-eth"
  local rc

  # 1a. no default route AND no wireless station on the node -> honest n/a. This is the leg the
  #     original test meant: refuse to fabricate a link where there is no radio.
  out="$(MESH_LINK_HEAL_STATE=$tmpd/s1 MESH_LINK_HEAL_LOG=$tmpd/l MESH_LINK_HEAL_NETDIR=$tmpd/netdir-empty \
         PATH="$tmpd/fakebin:$PATH" "$0" run 2>&1)"; rc=$?
  if [ "$rc" = 2 ]; then echo "  ok   no route + no radio renders n/a (exit 2), not a fabricated state"
  else echo "  FAIL no route + no radio should exit 2, got rc=$rc: $out"; fails=$((fails+1)); fi

  # 1b. THE REGRESSION GATE for the 55-minute outage: no default route but a wireless station DOES
  #     exist -> the node has no uplink and the radio is ours. The tool must NOT render n/a; it must
  #     perceive the link as down and enter the ladder. Only down-check 1 is driven, whose rung is
  #     'none' by design, so this gate can never fire a real action at a real adapter.
  out="$(MESH_LINK_HEAL_STATE=$tmpd/s2 MESH_LINK_HEAL_LOG=$tmpd/l2 MESH_LINK_HEAL_NETDIR=$tmpd/netdir-one \
         PATH="$tmpd/fakebin:$PATH" "$0" run 2>&1)"; rc=$?
  case "$rc:$out" in
    0:*wlt0*route=absent*down_checks=1*)
      echo "  ok   no route + a wireless station -> climbs (down_checks=1), never n/a" ;;
    2:*) echo "  FAIL DISARMED: a routeless node with a radio rendered n/a — this is the 2026-08-17 outage"
         fails=$((fails+1)) ;;
    *)   echo "  FAIL routeless-with-radio gave rc=$rc: $out"; fails=$((fails+1)) ;;
  esac

  # 1c. a default route that is NOT wireless -> n/a, unchanged. Without this leg the fallback would
  #     start reassociating an idle wifi card on a happily ethernet-routed node: the healer becoming
  #     the outage, which is the failure this tool's own header warns about.
  cp "$tmpd/fakebin/ip-eth" "$tmpd/fakebin2-ip" 2>/dev/null || true
  mkdir -p "$tmpd/fakebin2"; cp "$tmpd/fakebin/ip-eth" "$tmpd/fakebin2/ip"; cp "$tmpd/fakebin/iw" "$tmpd/fakebin2/iw"
  out="$(MESH_LINK_HEAL_STATE=$tmpd/s3 MESH_LINK_HEAL_LOG=$tmpd/l3 MESH_LINK_HEAL_NETDIR=$tmpd/netdir-one \
         PATH="$tmpd/fakebin2:$PATH" "$0" run 2>&1)"; rc=$?
  if [ "$rc" = 2 ]; then echo "  ok   a WIRED default route still renders n/a — idle wifi is left alone"
  else echo "  FAIL wired-route node should exit 2, got rc=$rc: $out"; fails=$((fails+1)); fi

  # 2. The REAL read must work on this node's REAL adapter, or the tool is n/a here. This is the
  #    leg that refuses to pass on stubs alone.
  read_state
  w="$(find_iface)" || { echo "  n/a  no wireless station to tend on this node"; \
                         echo "== link-heal: n/a on this node =="; exit 2; }
  w="${w%% *}"
  if iw dev "$w" link >/dev/null 2>&1; then echo "  ok   real read: iw dev $w link answers"
  else echo "  FAIL real read: iw dev $w link failed"; fails=$((fails+1)); fi
  if sudo -n wpa_cli -i "$w" status >/dev/null 2>&1; then
    echo "  ok   real control path: wpa_cli reaches the supplicant socket for $w"
  else
    echo "  FAIL wpa_cli cannot reach $w — every healing rung would be a silent no-op"; fails=$((fails+1))
  fi

  # 3. The ladder — driven through the REAL choose_rung, not a re-implementation of it. An earlier
  #    draft of this test pasted the arithmetic inline; that version asserts its own copy and would
  #    have stayed green through any edit to the shipped function.
  #    Each rung is its own row so a collapsed ladder cannot pass by agreeing with its neighbour,
  #    and each carries the last_rung that a real climb would have reached by then.
  local n want got last
  for triple in "1:none:none" "2:reassociate:none" "4:bounce:reassociate" \
                "7:reload:bounce" "10:replug:reload" "14:shout:replug"; do
    n="${triple%%:*}"; want="$(printf %s "$triple" | cut -d: -f2)"; last="${triple##*:}"
    got="$(choose_rung "$n" "$last")"
    if [ "$got" = "$want" ]; then echo "  ok   ladder: down=$n last=$last -> $want"
    else echo "  FAIL ladder: down=$n last=$last wanted $want got $got"; fails=$((fails+1)); fi
  done

  # 4. No rung repeats on the next check — a rung that re-fires every minute is a storm, not an
  #    escalation. Asserted at every acting rung, not just one, because the guard is a separate
  #    clause per rung and one of them can rot alone.
  for pair in "2:reassociate" "4:bounce" "7:reload" "10:replug"; do
    n="${pair%%:*}"; last="${pair##*:}"
    got="$(choose_rung "$((n+1))" "$last")"
    if [ "$got" = none ] || [ "$got" != "$last" ]; then
      echo "  ok   no repeat: $last already attempted -> next check chose '$got'"
    else
      echo "  FAIL repeat guard: $last re-fired at down=$((n+1))"; fails=$((fails+1))
    fi
  done

  # 4b. THE EPISTEMIC CUT — the clock axis. A frozen tick counter must NOT be able to stall the
  #     ladder: 2026-08-17T01:10:07Z->01:18:01Z is 7m54s of live fault that advanced down_checks by
  #     ZERO. With the counter pinned at 1, elapsed seconds alone must carry the climb to every rung.
  #     Driven through the REAL choose_rung, and paired with a control row at secs=0 so the gate
  #     fails if the clock argument is ignored AND if it is applied when it should not be.
  for pair in "2:reassociate:none" "4:bounce:reassociate" "7:reload:bounce" "10:replug:reload" "14:shout:replug"; do
    n="${pair%%:*}"; want="$(printf %s "$pair" | cut -d: -f2)"; last="${pair##*:}"
    got="$(choose_rung 1 "$last" "$(( n * TICK ))" 0)"
    if [ "$got" = "$want" ]; then echo "  ok   clock axis: down_checks frozen at 1, ${n}x cadence elapsed -> $want"
    else echo "  FAIL clock axis: frozen counter + $((n*TICK))s elapsed wanted $want got $got"; fails=$((fails+1)); fi
  done
  got="$(choose_rung 1 none 0 0)"
  if [ "$got" = none ]; then echo "  ok   clock axis does not fire on a fresh episode (0s elapsed -> none)"
  else echo "  FAIL clock axis fired at 0s elapsed: got $got"; fails=$((fails+1)); fi
  #     and the fold must NAME its winner rather than silently maxing.
  case "$(effective_n 3 "$(( 9 * TICK ))")" in
    "9 clock") echo "  ok   effective_n names the clock when the clock is ahead" ;;
    *) echo "  FAIL effective_n(3, 9 cadences) = '$(effective_n 3 $((9*TICK)))', wanted '9 clock'"; fails=$((fails+1)) ;;
  esac
  case "$(effective_n 9 "$(( 3 * TICK ))")" in
    "9 ticks") echo "  ok   effective_n names the ticks when the ticks are ahead" ;;
    *) echo "  FAIL effective_n(9, 3 cadences) = '$(effective_n 9 $((3*TICK)))', wanted '9 ticks'"; fails=$((fails+1)) ;;
  esac

  # 4c. THE CONTROL HALF — a check taken inside the previous rung's settling transient measures the
  #     CURE, not the fault, and must act on nothing. Without this, a driver reload whose USB
  #     re-probe has not finished reads as further evidence of the wedge and the next rung stacks on
  #     top of it. Asserted at the count where each rung's SUCCESSOR would otherwise fire.
  for pair in "10:reload" "14:replug"; do
    n="${pair%%:*}"; last="${pair##*:}"
    got="$(choose_rung "$n" "$last" "$(( n * TICK ))" 1)"
    if [ "$got" = settling ]; then echo "  ok   settle window: 1s left after $last -> no action at down=$n"
    else echo "  FAIL settle window ignored: down=$n after $last with 1s left chose '$got'"; fails=$((fails+1)); fi
  done
  #     ...and it must EXPIRE — a settle window that never closes is a healer that stops healing.
  got="$(choose_rung 14 replug "$(( 14 * TICK ))" 0)"
  if [ "$got" = shout ]; then echo "  ok   settle window expires: 0s left -> the ladder resumes (shout)"
  else echo "  FAIL settle window did not expire: got '$got' wanted shout"; fails=$((fails+1)); fi
  #     every rung in the table must claim a POSITIVE window, or the suppression is decorative.
  for last in reassociate bounce reload replug; do
    if [ "$(settle_secs "$last")" -gt 0 ]; then echo "  ok   settle_secs $last = $(settle_secs "$last")s"
    else echo "  FAIL settle_secs $last is 0 — that rung's transient is unmodelled"; fails=$((fails+1)); fi
  done

  # 4d. THE UNIT LIE — asserted against the EMITTED ALERT, not against the source. The board line
  #     used to announce "still ... after ${DOWN_N} min" while DOWN_N counts RUNS; on this node only
  #     79.3% of scheduled runs land, so the one message that summons a human understated the outage
  #     it was reporting. A grep for the old string would only prove a string is absent (and the
  #     first draft of this gate matched its own comment quoting it). So: drive the real shout branch
  #     with a fixture whose two axes DISAGREE ON PURPOSE — 14 down-checks but 900s of wall-clock —
  #     capture what mesh-chat was actually handed, and require the alert to carry the 15 minutes
  #     that elapsed rather than the 14 that were counted.
  mkdir -p "$tmpd/shoutbin"; cp "$tmpd/fakebin/ip" "$tmpd/fakebin/iw" "$tmpd/shoutbin/"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "$MESH_TEST_CHAT_CAPTURE"\n' > "$tmpd/shoutbin/mesh-chat"
  chmod +x "$tmpd/shoutbin/mesh-chat"
  printf '13 replug %s wlt0 10.0.0.1 %s 0\n' "$(date +%s)" "$(( $(date +%s) - 900 ))" > "$tmpd/s-shout"
  : > "$tmpd/chat-capture"
  out="$(MESH_LINK_HEAL_STATE=$tmpd/s-shout MESH_LINK_HEAL_LOG=$tmpd/l-shout \
         MESH_LINK_HEAL_NETDIR=$tmpd/netdir-one MESH_TEST_CHAT_CAPTURE=$tmpd/chat-capture \
         PATH="$tmpd/shoutbin:$PATH" "$0" run 2>&1)"; rc=$?
  local alert; alert="$(cat "$tmpd/chat-capture" 2>/dev/null)"
  if [ "$rc" = 3 ] && [ -n "$alert" ]; then
    echo "  ok   the shout rung fires and reaches the board (exit 3)"
  else
    echo "  FAIL shout rung did not fire or posted nothing (rc=$rc, verdict: $out)"; fails=$((fails+1))
  fi
  case "$alert" in
    *15m*) echo "  ok   the alert reports the 900s that ELAPSED (15m), not the 14 ticks that were counted" ;;
    *)     echo "  FAIL the alert does not carry wall-clock minutes: $alert"; fails=$((fails+1)) ;;
  esac
  case "$alert" in
    *"14 min"*|*"14min"*) echo "  FAIL the alert spells the tick count as a duration again: $alert"
                          fails=$((fails+1)) ;;
    *) echo "  ok   the alert never spells the tick count as a duration" ;;
  esac
  case "$alert" in
    *"14 down-checks"*) echo "  ok   the counted axis is still reported, beside the clock, not instead of it" ;;
    *) echo "  FAIL the alert dropped the down-check count entirely: $alert"; fails=$((fails+1)) ;;
  esac

  # 4e. STATE ROUND-TRIP, both formats. The clock half is APPENDED, so a file written by the previous
  #     copy must still read — and its missing timestamps must read as "no episode", never as epoch 0
  #     (which would date the fault to 1970 and fire the top rung on the first down check).
  local sv; sv="$STATE"
  STATE="$tmpd/st-new"; write_state 5 reload wlt0 10.0.0.1 1700000000 1700000300; read_state
  if [ "$DOWN_N:$LAST_RUNG:$KNOWN_IFACE:$KNOWN_GW:$FIRST_DOWN:$ACTED_AT" \
       = "5:reload:wlt0:10.0.0.1:1700000000:1700000300" ]; then
    echo "  ok   7-field state round-trips"
  else echo "  FAIL state round-trip: got $DOWN_N:$LAST_RUNG:$KNOWN_IFACE:$KNOWN_GW:$FIRST_DOWN:$ACTED_AT"; fails=$((fails+1)); fi
  #     The shape field is appended the same way, and the SAME leg must prove the append did not
  #     re-open the field-shift hole it sits behind (below).
  STATE="$tmpd/st-shape"; write_state 3 bounce wlt0 10.0.0.1 1700000000 1700000300 WEDGED; read_state
  if [ "${EPISODE_SHAPE:-}" = WEDGED ] && [ "$FIRST_DOWN" = 1700000000 ]; then
    echo "  ok   the 8th field (the episode's DOWN shape) round-trips beside the clock"
  else echo "  FAIL shape round-trip: shape=${EPISODE_SHAPE:-} first_down=$FIRST_DOWN"; fails=$((fails+1)); fi
  #     THE FIELD-SHIFT GUARD. iface and gateway are EMPTY exactly when a wedge has erased them —
  #     the one moment the episode clock becomes load-bearing. Written bare, two empties collapse
  #     under the default IFS and every later field slides left, so FIRST_DOWN reads whatever the
  #     gateway column happened to hold. Placeholders keep the columns aligned. Break `${_if:--}`
  #     back to `$_if` and this goes red with first_down=0 — an episode that can never age.
  STATE="$tmpd/st-empty"
  KNOWN_IFACE=""; KNOWN_GW=""; write_state 4 reload "" "" 1700000000 1700000300 DEAUTHED; read_state
  if [ "$FIRST_DOWN" = 1700000000 ] && [ "$ACTED_AT" = 1700000300 ] \
     && [ -z "$KNOWN_IFACE" ] && [ -z "$KNOWN_GW" ] && [ "${EPISODE_SHAPE:-}" = DEAUTHED ]; then
    echo "  ok   an empty iface+gateway does not shift the clock fields out from under the ladder"
  else
    echo "  FAIL empty-field shift: iface='$KNOWN_IFACE' gw='$KNOWN_GW' first_down=$FIRST_DOWN acted=$ACTED_AT shape=${EPISODE_SHAPE:-}"
    fails=$((fails+1))
  fi
  STATE="$tmpd/st-old"; printf '5 reload 1700000000 wlt0 10.0.0.1\n' >"$STATE"; read_state
  if [ "$DOWN_N:$LAST_RUNG:$FIRST_DOWN:$ACTED_AT" = "5:reload:0:0" ]; then
    echo "  ok   a pre-cut 5-field state reads with no episode open (0/0), not epoch 0"
  else echo "  FAIL old-format state read as $DOWN_N:$LAST_RUNG:$FIRST_DOWN:$ACTED_AT"; fails=$((fails+1)); fi
  STATE="$sv"; read_state

  # 4f. THE CLOSING MEASUREMENT. The RECOVERED line carries two axes on purpose — the ticks COUNTED
  #     and the seconds ELAPSED — and for 29 consecutive recoveries it reported "0s of real outage"
  #     on every one, including two-down-check episodes that had been open for over a minute. Cause:
  #     down_secs is zeroed on an UP run (correctly — the escalation ladder must not climb a closed
  #     episode), and the RECOVERED branch is reachable ONLY on an UP run, so the field it printed
  #     was a constant wearing the vocabulary of a measurement. The sibling of the shout-alert leg
  #     above, at the other end of the episode: same two axes, same collapse, opposite edge.
  #     Driven against the REAL link with a scratch state carrying an episode opened 900s ago — a
  #     stub cannot manufacture the UP verdict, and a leg that only asserts the arithmetic would
  #     re-pass with the reporting path still broken. Where the link is genuinely down the branch is
  #     unreachable: that is a SKIP naming why, never a pass.
  printf '2 reassociate %s wlt0 10.0.0.1 %s 0 WEDGED\n' "$(date +%s)" "$(( $(date +%s) - 900 ))" > "$tmpd/s-recov"
  : > "$tmpd/l-recov"
  out="$(MESH_LINK_HEAL_STATE=$tmpd/s-recov MESH_LINK_HEAL_LOG=$tmpd/l-recov "$0" run 2>&1)"
  local recov; recov="$(grep RECOVERED "$tmpd/l-recov" 2>/dev/null || true)"
  if [ -z "$recov" ]; then
    echo "  SKIP recovery leg: this link is not UP right now, so the RECOVERED branch is unreachable ($out)"
  else
    case "$recov" in
      *" 0s of real outage"*)
        echo "  FAIL the RECOVERED line reports 0s for a 900s episode — the closing measurement is a constant again"
        echo "         $recov"; fails=$((fails+1)) ;;
      *[0-9]"s of real outage"*)
        echo "  ok   the RECOVERED line reports the seconds that ELAPSED, not the zeroed live-fault age" ;;
      *)  echo "  FAIL the RECOVERED line carries no seconds axis at all: $recov"; fails=$((fails+1)) ;;
    esac
    case "$recov" in
      *"2 down-check(s)"*) echo "  ok   the counted axis survives beside the clock on the closing edge" ;;
      *) echo "  FAIL the RECOVERED line dropped the down-check count: $recov"; fails=$((fails+1)) ;;
    esac
    #   THE PERTURBATION CLASS reaches the closing line. Without it the tape records what recovery
    #   COST but never what it cost recovery FROM, and cost_drift() cannot hold the fault constant.
    case "$recov" in
      *"shape=WEDGED"*) echo "  ok   the RECOVERED line names the fault shape the ladder climbed against" ;;
      *"shape=na"*) echo "  FAIL the shape was carried in the state and still closed as na: $recov"; fails=$((fails+1)) ;;
      *) echo "  FAIL the RECOVERED line carries no shape axis: $recov"; fails=$((fails+1)) ;;
    esac
  fi
  #   ...and the WRITE side: a down observation must RECORD the shape, not just pass one through.
  #   Driven on leg 1b's fixture, which has no default route AND is not associated — that is
  #   DEAUTHED, not ROUTELESS (routeless means associated with the route gone). This leg was written
  #   asserting ROUTELESS and went red on exactly that confusion; the fixture was right.
  rm -f "$tmpd/s-shapewrite"
  MESH_LINK_HEAL_STATE=$tmpd/s-shapewrite MESH_LINK_HEAL_LOG=$tmpd/l-shapewrite \
    MESH_LINK_HEAL_NETDIR=$tmpd/netdir-one PATH="$tmpd/fakebin:$PATH" "$0" run >/dev/null 2>&1 || true
  case "$(cat "$tmpd/s-shapewrite" 2>/dev/null)" in
    *" DEAUTHED") echo "  ok   a down check records the episode's fault shape in the state" ;;
    *) echo "  FAIL the down path did not record a shape: $(cat "$tmpd/s-shapewrite" 2>/dev/null)"; fails=$((fails+1)) ;;
  esac
  #   An episode whose shape CHANGES under the ladder must become `mixed`, not silently relabel to
  #   whichever shape was observed last — a relabelled episode would join a stratum it did not spend
  #   its outage in, which is the one thing the stratum exists to prevent.
  printf '1 none %s wlt0 - %s 0 WEDGED\n' "$(date +%s)" "$(( $(date +%s) - 120 ))" > "$tmpd/s-shapemix"
  MESH_LINK_HEAL_STATE=$tmpd/s-shapemix MESH_LINK_HEAL_LOG=$tmpd/l-shapemix \
    MESH_LINK_HEAL_NETDIR=$tmpd/netdir-one PATH="$tmpd/fakebin:$PATH" "$0" run >/dev/null 2>&1 || true
  case "$(cat "$tmpd/s-shapemix" 2>/dev/null)" in
    *" mixed") echo "  ok   an episode that changes shape under the ladder is recorded as mixed" ;;
    *) echo "  FAIL a shape change was silently relabelled: $(cat "$tmpd/s-shapemix" 2>/dev/null)"; fails=$((fails+1)) ;;
  esac

  # 4g. THE COST-DRIFT LENS. The verdict must track the ORDER of the recoveries, never their
  #     COMPOSITION — that is the whole claim, and it is the one a ladder histogram cannot make. The
  #     two fixtures below carry the IDENTICAL multiset (12 `none` + 12 `reassociate`) and differ
  #     only in arrangement; a lens that reads composition passes both, so the pair is the vacuity
  #     gate. Seen red both ways: with ord() collapsed to a constant the monotone fixture reads
  #     COST-STABLE, and with the permutation replaced by a fixed threshold the flat one reads UP.
  local cdd="$tmpd/cd"; mkdir -p "$cdd"
  _cd_fix() {   # $1=file, then one rung word per episode, in order
    local f="$1"; shift; local i=0 r
    : >"$f"
    for r in "$@"; do
      i=$((i+1))
      printf '2026-08-19T00:%02d:00Z  RECOVERED iface=wlt0 shape=DEAUTHED after 1 down-check(s) / %ds of real outage; last rung attempted: %s\n' \
        "$((i % 60))" "$((40 + i))" "$r" >>"$f"
    done
  }
  local N12="none none none none none none none none none none none none"
  local R12="reassociate reassociate reassociate reassociate reassociate reassociate reassociate reassociate reassociate reassociate reassociate reassociate"
  _cd_fix "$cdd/rising" $N12 $R12
  #     The flat fixture is deliberately NOT perfectly balanced: it carries S=26 of a possible 144,
  #     a real but unremarkable rise that the null correctly declines to call a trend. A PERFECTLY
  #     flat arrangement (S=0) passes this leg no matter what the null says, because the verdict
  #     branches require rs>0 or rs<0 — so with S=0 a completely broken p-value still reads
  #     COST-STABLE and the gate asserts nothing. That version was written first and a mutant that
  #     hardcoded p=0.001 survived it ([[a-gate-can-be-vacuous-because-the-live-reading-agrees]]).
  _cd_fix "$cdd/flat"   none none reassociate none reassociate reassociate none none \
                        reassociate none reassociate reassociate none none reassociate none \
                        reassociate reassociate none none reassociate reassociate none reassociate
  local cdo
  cdo="$(MESH_LINK_HEAL_LOG="$cdd/rising" "$0" --cost-drift --json 2>&1)"
  case "$cdo" in
    *'"rung_verdict":"COST-DRIFT-UP"'*) echo "  ok   cost-drift: a monotonically rising ladder reads COST-DRIFT-UP" ;;
    *) echo "  FAIL cost-drift missed a monotone rise: $cdo"; fails=$((fails+1)) ;;
  esac
  cdo="$(MESH_LINK_HEAL_LOG="$cdd/flat" "$0" --cost-drift --json 2>&1)"
  case "$cdo" in
    *'"rung_verdict":"COST-STABLE"'*) echo "  ok   cost-drift: the SAME multiset, rearranged, reads COST-STABLE (it reads order, not composition)" ;;
    *) echo "  FAIL cost-drift called a flat sequence drifting — it is reading the histogram: $cdo"; fails=$((fails+1)) ;;
  esac
  #     ...and that leg is only load-bearing while the fixture's S is NON-ZERO, so assert it. At S=0
  #     the STABLE verdict comes from the sign test, not from the null, and the null goes unchecked.
  case "$cdo" in
    *'"rung_S":0,'*) echo "  FAIL the flat fixture drifted to S=0 — the STABLE verdict no longer depends on the p-value at all"; fails=$((fails+1)) ;;
    *) echo "  ok   cost-drift: the flat fixture carries a real non-zero S, so its STABLE verdict is the NULL's answer" ;;
  esac
  #     ...and the two axes are independent: that flat-rung fixture has strictly RISING durations, so
  #     a duration verdict of STABLE would mean the seconds column is being ignored.
  case "$cdo" in
    *'"dur_verdict":"COST-DRIFT-UP"'*) echo "  ok   cost-drift: the duration axis moves independently of the rung axis" ;;
    *) echo "  FAIL cost-drift: rising durations under a flat ladder went unseen: $cdo"; fails=$((fails+1)) ;;
  esac

  #     A SHORT TAPE IS UNMEASURED, NOT STABLE. `na` and COST-STABLE are the two verdicts most
  #     easily collapsed, and collapsing them is how a lens that has seen six episodes gets read as
  #     a clean bill of health ([[a-collapsed-reason-makes-blind-and-quiet-identical]]).
  _cd_fix "$cdd/short" none none reassociate none none reassociate
  cdo="$(MESH_LINK_HEAL_LOG="$cdd/short" "$0" --cost-drift --json 2>&1)"
  case "$cdo" in
    *'"rung_verdict":"na"'*) echo "  ok   cost-drift: 6 episodes render na, not a verdict" ;;
    *) echo "  FAIL cost-drift produced a verdict below the minimum: $cdo"; fails=$((fails+1)) ;;
  esac

  #     THE FORMAT-GENERATION GUARD. 29 of this node's 68 historical rows read "0s of real outage" —
  #     the pre-0b8c0ec constant, not fast recoveries. Scored, they would manufacture a rising
  #     duration trend out of the date the FORMAT was fixed. They must be dropped AND counted; a
  #     silent drop reads as "covered everything".
  {
    _cd_fix "$cdd/zeros" $N12
    sed -i 's|/ [0-9]*s of real outage|/ 0s of real outage|' "$cdd/zeros"
    _cd_fix "$cdd/real" $N12
    cat "$cdd/zeros" "$cdd/real" > "$cdd/mixed"
  }
  cdo="$(MESH_LINK_HEAL_LOG="$cdd/mixed" "$0" --cost-drift --json 2>&1)"
  case "$cdo" in
    *'"excluded_zero_secs":12'*) : ;;
    *) echo "  FAIL cost-drift did not count the 0s rows as excluded: $cdo"; fails=$((fails+1)) ;;
  esac
  case "$cdo" in
    *'"dur_n":12'*) echo "  ok   cost-drift: the 12 pre-fix \"0s\" rows are excluded from the duration axis and counted" ;;
    *) echo "  FAIL cost-drift scored the 0s format artifact as a real duration: $cdo"; fails=$((fails+1)) ;;
  esac

  #     AN UNKNOWN RUNG IS EXCLUDED AND NAMED, never coerced to the cheapest recovery there is. If
  #     the ladder ever grows a rung, this is what stops the lens from silently reading it as `none`.
  _cd_fix "$cdd/unk" $N12 teleport
  cdo="$(MESH_LINK_HEAL_LOG="$cdd/unk" "$0" --cost-drift 2>&1)"
  case "$cdo" in
    *"EXCLUDED 1 episode"*teleport*) echo "  ok   cost-drift names an unknown rung word instead of scoring it as none" ;;
    *) echo "  FAIL cost-drift swallowed an unknown rung: $cdo"; fails=$((fails+1)) ;;
  esac

  #     DETERMINISM. The p-value comes from a shuffle; an unseeded one would move the verdict on a
  #     boundary case between two runs of the same tape ([[a-stochastic-gates-threshold-is-a-statistic]]).
  if [ "$(MESH_LINK_HEAL_LOG="$cdd/rising" "$0" --cost-drift --json 2>&1)" \
     = "$(MESH_LINK_HEAL_LOG="$cdd/rising" "$0" --cost-drift --json 2>&1)" ]; then
    echo "  ok   cost-drift is deterministic on a fixed tape (the permutation null is seeded)"
  else echo "  FAIL cost-drift returns a different p for the same tape"; fails=$((fails+1)); fi

  #     AND IT WRITES NOTHING. This mode is read-only in the strong sense; run against the REAL tape,
  #     it must leave both the tape and the state byte-identical, or a lens over the liveness record
  #     becomes another writer of it ([[driving-a-reflex-appends-to-its-durable-log]]).
  if [ -r "$LOG" ]; then
    local pre_l pre_s
    pre_l="$(cksum <"$LOG" 2>/dev/null)"; pre_s="$(cksum <"$STATE" 2>/dev/null || echo none)"
    "$0" --cost-drift >/dev/null 2>&1 || true
    if [ "$pre_l" = "$(cksum <"$LOG" 2>/dev/null)" ] \
       && [ "$pre_s" = "$(cksum <"$STATE" 2>/dev/null || echo none)" ]; then
      echo "  ok   --cost-drift over the real tape wrote neither the log nor the state"
    else echo "  FAIL --cost-drift mutated the durable artifacts it reads"; fails=$((fails+1)); fi
  else
    echo "  SKIP --cost-drift no-write leg: no real tape on this node to read"
  fi

  # 5. THE CRON-PATH LEG. The reflex runs from cron, whose PATH is /usr/bin:/bin — and `iw` lives in
  #    /usr/sbin. The first wired version of this tool read a healthy link as DEAUTHED under exactly
  #    that environment, which would have climbed the whole ladder and re-plugged the dongle on a
  #    link that was never down. Two assertions, because the two fixes are independent: the reading
  #    under a stripped environment must AGREE with the reading under this one, and a genuinely
  #    absent tool must render n/a rather than "down".
  local rich stripped
  rich="$("$0" --status 2>&1)"
  stripped="$(env -i HOME="$HOME" PATH=/usr/bin:/bin SHELL=/bin/sh /bin/sh -c "$0 --status" 2>&1)"
  if [ "${rich#*state=}" = "${stripped#*state=}" ] && [ -n "$stripped" ]; then
    echo "  ok   cron-PATH agreement: stripped env reads the same state as this shell"
  else
    echo "  FAIL cron-PATH disagreement — the reflex would perceive a different link than the pane does"
    echo "         rich:     $rich"
    echo "         stripped: $stripped"
    fails=$((fails+1))
  fi
  # Invoked through an absolute /bin/bash, not the shebang: with an empty PATH `env` cannot find
  # bash and the script would die at rc=127 before its own guard ever ran — which would have tested
  # the shebang, not the guard.
  out="$(env -i HOME="$HOME" PATH="$tmpd/empty" /bin/bash "$0" --status 2>&1)"; rc=$?
  if [ "$rc" = 2 ]; then echo "  ok   absent tools render n/a (exit 2), never a false 'down'"
  else echo "  FAIL absent tools gave rc=$rc, not 2: $out"; fails=$((fails+1)); fi

  # 5b. THE LAYER ORACLE — the one word mesh-selfcare and mesh-revive now consult BEFORE they blame
  #     the upstream. Fixture-driven so every verdict is reached deterministically on a healthy node
  #     (a live-only assertion here could observe exactly one of the five). The read-only claim is
  #     asserted separately, and against artifacts, because a consumer polling this on a 1-min cadence
  #     would otherwise keep this reflex's own liveness mtime fresh while the reflex itself was dead.
  local ldir="$tmpd/layerbin" lnet="$tmpd/layer-netdir" lwifi="$tmpd/layer-netdir-wifi"
  mkdir -p "$ldir" "$lnet/eth9" "$lwifi/wlt9/phy80211"
  printf '#!/bin/sh\nexit ${LAYER_PING_RC:-1}\n' > "$ldir/ping"
  printf '#!/bin/sh\ncase "$*" in *"route show default"*) [ -n "$LAYER_ROUTE" ] && echo "$LAYER_ROUTE";; esac\nexit 0\n' > "$ldir/ip"
  printf '#!/bin/sh\necho "Not connected."\nexit 0\n' > "$ldir/iw"
  chmod +x "$ldir/ping" "$ldir/ip" "$ldir/iw"
  local lcase lwant lgot lroute lping lnetd
  for lcase in \
      "ROUTELESS::1:$lnet" \
      "WEDGED:default via 10.0.0.1 dev eth9:1:$lnet" \
      "UP:default via 10.0.0.1 dev eth9:0:$lnet" \
      "DEAUTHED:default via 10.0.0.1 dev wlt9:0:$lwifi" ; do
    lwant="${lcase%%:*}"; lcase="${lcase#*:}"
    lroute="${lcase%%:*}"; lcase="${lcase#*:}"
    lping="${lcase%%:*}"; lnetd="${lcase#*:}"
    lgot="$(env -i HOME="$HOME" PATH="$ldir:/usr/bin:/bin" LAYER_ROUTE="$lroute" LAYER_PING_RC="$lping" \
            MESH_LINK_HEAL_STATE="$tmpd/ls" MESH_LINK_HEAL_LOG="$tmpd/ll" MESH_LINK_HEAL_NETDIR="$lnetd" \
            /bin/bash "$0" --layer 2>&1)"
    if [ "$lgot" = "$lwant" ]; then echo "  ok   layer oracle: $lwant"
    else echo "  FAIL layer oracle: wanted $lwant, got '$lgot'"; fails=$((fails+1)); fi
  done
  #     UNKNOWN, not a verdict, when the probes themselves are gone — same rule as require_tools.
  lgot="$(env -i HOME="$HOME" PATH="$tmpd/empty" /bin/bash "$0" --layer 2>&1)"; rc=$?
  if [ "$lgot" = UNKNOWN ] && [ "$rc" = 0 ]; then echo "  ok   layer oracle: absent probes render UNKNOWN, never a verdict"
  else echo "  FAIL absent probes gave rc=$rc '$lgot', not UNKNOWN"; fails=$((fails+1)); fi
  #     ...and the live invocation must touch NOTHING: no state write, no log line. Fresh artifacts,
  #     mtime in ns (a same-second rewrite is invisible at 1s resolution).
  printf '0 none 1 x y\n' > "$tmpd/ls"; : > "$tmpd/ll"
  local lst_before lst_after llog_before llog_after
  lst_before="$(stat -c %y "$tmpd/ls")"; llog_before="$(stat -c %s "$tmpd/ll")"
  MESH_LINK_HEAL_STATE="$tmpd/ls" MESH_LINK_HEAL_LOG="$tmpd/ll" "$0" --layer >/dev/null 2>&1
  lst_after="$(stat -c %y "$tmpd/ls")"; llog_after="$(stat -c %s "$tmpd/ll")"
  if [ "$lst_before" = "$lst_after" ] && [ "$llog_before" = "$llog_after" ]; then
    echo "  ok   layer oracle is read-only: no state write, no log line (a poller cannot forge this reflex's liveness)"
  else
    echo "  FAIL layer oracle wrote an artifact (state $lst_before -> $lst_after, log ${llog_before}B -> ${llog_after}B)"
    fails=$((fails+1))
  fi
  #     ...and it must answer on THIS node with one of the five words, whatever the link is doing.
  lgot="$(MESH_LINK_HEAL_STATE="$tmpd/ls2" "$0" --layer 2>&1)"
  case "$lgot" in
    UP|WEDGED|DEAUTHED|ROUTELESS|UNKNOWN) echo "  ok   layer oracle answers live on this node: $lgot" ;;
    *) echo "  FAIL layer oracle answered '$lgot' live — not one of the enumerated words"; fails=$((fails+1)) ;;
  esac

  # 6. The USB path must be DERIVED, never remembered: this adapter moved 1-6 -> 1-2.4 in a single
  #    outage, so a path-pinned healer would re-plug a port the dongle is no longer on.
  if [ -n "${w:-}" ]; then
    local p; p="$(usb_path_of "$w" 2>/dev/null || true)"
    if [ -n "$p" ] && [ -e "/sys/bus/usb/devices/$p/authorized" ]; then
      echo "  ok   usb path derived live: $w -> $p (authorized node exists)"
    else
      echo "  FAIL usb path underivable for $w (got '${p:-}') — the replug rung would be a silent no-op"
      fails=$((fails+1))
    fi
  fi

  # 5. The test must not have touched the real artifacts.
  if [ ! -e "$tmpd/l" ] || [ ! -s "$tmpd/l" ]; then echo "  ok   test wrote no real log (scratch only)"; fi
  echo "== $( [ "$fails" = 0 ] && echo 'link-heal: all green' || echo "link-heal: $fails FAILURE(S)" ) =="
  [ "$fails" = 0 ] || exit 1
  exit 0
}

case "${1:-}" in
  --test)   run_test ;;
  --status) main --status ;;
  --json)   main --json ;;
  --layer)  layer_verdict ;;
  --cost-drift) cost_drift "${2:-}" ;;
  -h|--help) sed -n '3,63p' "$0" ;;
  ""|run)   main run ;;
  # An UNKNOWN flag must not fall into the actuator. This branch used to be a bare `*) main run`, so
  # any typo — or a consumer calling a mode this copy is too old to have — silently ran the ladder
  # instead of the read-only mode it asked for. The healer only ever acts on an already-down link, so
  # the blast radius was bounded, but "I did not understand you, so I touched the substrate" is not a
  # contract anything should rely on. Exit 2 = n/a, the same code every other refusal here uses.
  *)        say "link-heal: n/a — unknown argument '$1' (want: run | --status | --json | --layer | --cost-drift | --test). Refusing to fall through to the ladder."; exit 2 ;;
esac
