#!/usr/bin/env bash
# reflex-cadence: 11-59/5 * * * *
# doctor-artifact: $HOME/.mesh/.note3-activitymanager.state 1200 phone
# mesh-note3-activitymanager — Note 3 resumed ActivityManager context for mobile-link.
# Missing output or disagreement between mResumedActivity and realActivity is UNKNOWN.
set -uo pipefail

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"
MESH_DIR="${MESH_DIR:-${HOME:-/tmp}/.mesh}"
EVIDENCE_ROOT="${MESH_EVIDENCE_ROOT:-${HOME:-/tmp}/.mesh/evidence}/note3-activitymanager-20260920"
RAW="${EVIDENCE_ROOT}/activity.raw"
STATE="${MESH_NOTE3_ACTIVITYMANAGER_STATE:-$MESH_DIR/.note3-activitymanager.state}"
RUNLOG="${MESH_NOTE3_ACTIVITYMANAGER_RUNLOG:-$MESH_DIR/note3-activitymanager.log}"

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

parse_dump() {
  awk '
    /realActivity=/ {
      if (real == "" && match($0, /realActivity=[A-Za-z0-9._$-]+\/[A-Za-z0-9._$-]+/)) {
        real=substr($0, RSTART+13, RLENGTH-13)
      }
    }
    /mResumedActivity:/ {
      if (match($0, /mResumedActivity:.* [A-Za-z0-9._$-]+\/[A-Za-z0-9._$-]+/)) {
        line=substr($0, RSTART, RLENGTH); sub(/^.* /, "", line); resumed=line
      }
    }
    END {
      realpkg=real; sub(/\/.*$/, "", realpkg)
      respkg=resumed; sub(/\/.*$/, "", respkg)
      if (real != "" && resumed != "" && realpkg == respkg) printf "component=%s|package=%s|real_activity=%s|resumed_activity=%s\n", resumed, respkg, real, resumed
    }
  '
}

unknown() {
  local reason=${1:-unknown} ts=${2:-$(now_utc)}
  printf 'status=UNKNOWN reason=%s observed_at=%s component=unknown package=unknown\n' "$reason" "$ts"
  return 2
}

read_dump() {
  if [ -n "${MESH_NOTE3_ACTIVITYMANAGER_RAW_OVERRIDE:-}" ]; then
    printf '%s\n' "$MESH_NOTE3_ACTIVITYMANAGER_RAW_OVERRIDE"
  else
    timeout 20 adb -s "$SERIAL" shell dumpsys activity activities 2>/dev/null | tr -d '\r'
  fi
}

probe() {
  local ts dump parsed
  ts="$(now_utc)"
  dump="$(read_dump)" || { unknown adb_unreachable "$ts"; return 2; }
  [ -n "$dump" ] || { unknown empty_capture "$ts"; return 2; }
  parsed="$(printf '%s\n' "$dump" | parse_dump)"
  [ -n "$parsed" ] || { unknown missing_or_mismatched_activity "$ts"; return 2; }
  printf 'status=OK observed_at=%s %s\n' "$ts" "$parsed"
}

write_reading() {
  local reading="$1" tmp
  mkdir -p "$(dirname "$STATE")" "$(dirname "$RUNLOG")" "$EVIDENCE_ROOT" || return 1
  tmp="$(mktemp "${STATE}.XXXXXX")" || return 1
  printf '%s\n' "$reading" >"$tmp" && mv -f "$tmp" "$STATE" || { rm -f "$tmp"; return 1; }
  printf '%s %s\n' "$(now_utc)" "$reading" >>"$RUNLOG" || return 1
}

if [ "${1:-}" = --test ]; then
  fixture=$'realActivity=com.sec.android.mmapp/.AudioPreview\n  mResumedActivity: ActivityRecord{abc u0 com.sec.android.mmapp/.AudioPreview t249}'
  expected="$(printf '%s\n' "$fixture" | parse_dump)"
  printf '%s\n' "$expected" | grep -q 'component=com.sec.android.mmapp/.AudioPreview' || { echo 'smoke-test: FAIL (fixture component parse)'; exit 1; }
  printf '%s\n' "$expected" | grep -q 'package=com.sec.android.mmapp' || { echo 'smoke-test: FAIL (fixture package parse)'; exit 1; }
  mismatch=$'realActivity=com.sec.android.mmapp/.AudioPreview\n  mResumedActivity: ActivityRecord{abc u0 com.android.launcher/.Launcher t247}'
  [ -z "$(printf '%s\n' "$mismatch" | parse_dump)" ] || { echo 'smoke-test: FAIL (mismatched package accepted)'; exit 1; }
  out="$(probe)"; rc=$?
  case "$rc" in
    0) echo "smoke-test: ok (fixture + LIVE ADB read: $out)"; exit 0 ;;
    2) echo "smoke-test: n/a (fixture parse passed; LIVE ADB unavailable: $out)"; exit 2 ;;
    *) echo "smoke-test: FAIL (live read rc=$rc: $out)"; exit 1 ;;
  esac
fi

reading="$(probe)"; rc=$?
if [ -n "${MESH_NOTE3_ACTIVITYMANAGER_RAW_OVERRIDE:-}" ]; then
  mkdir -p "$EVIDENCE_ROOT" && printf '%s\n' "$MESH_NOTE3_ACTIVITYMANAGER_RAW_OVERRIDE" >"$RAW"
elif [ "$rc" -eq 0 ]; then
  mkdir -p "$EVIDENCE_ROOT"
  read_dump >"$RAW" || true
fi
write_reading "$reading" || { echo 'mesh-note3-activitymanager: failed to write state/log' >&2; exit 1; }
printf '%s\n' "$reading"
exit "$rc"
