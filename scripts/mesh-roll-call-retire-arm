#!/usr/bin/env bash
# mesh-roll-call-retire-arm — arm the roll-call PREFIX-EXCLUSION retirement once adoption is
# MEASURED on the live board, not once a date has passed.
# reflex-cadence: 48 * * * *
#
# WHY THIS EXISTS: the board has no defer primitive.
# task:retire-the-roll-call-prefix-exclusion-once-the-live-tally-proves-adoption was posted
# 2026-08-25T13:22:14Z — 45 seconds after the commit (ed2b8819) that is its own precondition — and
# dispatched straight back to its author, because mesh-mind-control's board scan carries no
# not-before / snooze / after: token anywhere in it (grepped: zero hits). Its STEP 2 gate reads "after
# at least one full 24h board window has passed", so left on the board that task is not deferred, it
# is re-dispatched every cycle for ~26h, each turn able only to re-derive "too early" and post
# nothing. An obligation whose trigger is a CLOCK belongs to a scheduler; this tool is that scheduler,
# and the board task is closed until it fires.
#
# AND THE TRIGGER IS THE CORPUS, NOT THE CALENDAR. "24h from now" is an assumed band standing in for
# the thing actually being waited on: that every roll-call line still inside the scanner's OWN window
# declares its polarity, so deleting the exclusion mints nothing. The calendar can arrive with the
# window still full of undeclared lines (roll-call runs `0 */5 * * *` — ~4.8 rounds per 24h, and a
# power-cycling node can miss several), or it can arrive late, after adoption was already total. This
# tool measures the corpus instead:
#
#   THE PROBE IS A DRY-RUN OF STEP 3 ITSELF, EXECUTED BY THE REAL PARSER, OVER THE FULL BOARD.
#   The whole live board is copied to a sandbox with every ANCHORED roll-call prefix rewritten to a
#   shape the surviving exclusion CANNOT match, and the real deployed mesh-mind-control
#   --scan-orphans is run over it under a fake HOME whose .local/bin holds stub mesh-chat/mesh-tell.
#   What that run MINTS is exactly what step 3 would re-mint on the live board; what its END-block
#   prints on stderr is exactly the tally step 2 asks to read. Nothing is posted.
#
# NO PRIVATE COPY OF THE DECLARATION PREDICATE LIVES HERE. This file never asks "does this line say
# route:no" — a lint whose predicate is not the parser's own predicate is not a guard on that parser
# (see memory a-lint-that-tests-a-different-predicate-than-the-parser-is-blind, and
# n-private-copies-of-one-predicate-are-all-green-and-none-is-complete). Adoption is read ONLY as the
# scanner's own tally, and safety ONLY as the scanner's own mint count. The two shapes are separated
# by running the probe TWICE over disjoint line sets, so even the per-shape breakdown is the parser
# speaking, not a regex here.
#
# NOTHING IS RE-STAMPED, AND THE UNKNOWN IS PUBLISHED INSTEAD. The scanner will not mint a finding
# younger than its own 30min orphan floor, so a line posted 10 minutes ago contributes zero to the
# mint count while being exactly the line that mints once it crosses — read as clean, it arms the gate
# one round EARLY. An earlier cut faked the clock by re-stamping every line to 35min old; that also
# re-orders the resolved-AFTER logic the scanner uses to close findings, so it traded one distortion
# for another. The probe instead COUNTS those lines as `pending` and holds the gate while any exist.
#
# BOTH SHAPES ARE REQUIRED, and this is what stops gate `clean` being vacuous: "zero lines would mint"
# is trivially true of an EMPTY window. A capability at zero adoption reads exactly like an absent one
# (memory a-capability-at-zero-adoption-reads-as-absent), so a window with no declaring per-mind ping
# AND no declaring digest can never arm, however clean it looks.
#
# States (published in every reading, and in rc):
#   no-rounds   0 roll-call lines in the window — UNKNOWN, never "clean". roll-call itself is dark.
#   undeclared  rounds present, neither shape tallied by the scanner — the minds are dropping the
#               token from the prompt. That is a PROMPT bug to fix, not a reason to retire.
#   partial     one shape declaring, not both (typically pings adopted, digest not yet, or vice versa)
#   dirty       both shapes declaring, but the dry-run still MINTS (undeclared roll-call lines remain
#               inside the window, so the exclusion is still load-bearing) OR `pending` lines are
#               still inside the 30min orphan floor, where a zero mint count is not yet a claim about
#               them. Expected for the whole first window; not a fault.
#   armed       gate met, [task] posted this run
#   posted      gate met, already posted (marker present) — idempotent, never a second obligation
#
# THIS TOOL IS SELF-RETIRING. The [task] it posts instructs its own deletion in the same commit that
# removes the exclusion: after that there is no exclusion to retire, the probe's prefix rewrite is
# meaningless, and the marker would make it read 'posted' forever — a reflex tending a target that no
# longer exists, cron-green and useless. It is deliberately left OUT of CLAUDE.md's tooling catalog
# for the same reason: a name added there would outlive the tool.
set -uo pipefail

CHATLOG="${MESH_MC_CHATLOG:-$HOME/.mesh/chat.log}"
CRONLOG="${MESH_RCRA_CRONLOG:-$HOME/.mesh/mind-control.log}"
MARK="${MESH_RCRA_MARK:-$HOME/.mesh/.roll-call-retire-armed}"
MC="${MESH_RCRA_MC:-$(command -v mesh-mind-control 2>/dev/null)}"
# The prefix the probe rewrites to. It must NOT begin "[fyi] roll-call " (the exclusion would match
# and the probe would measure the exclusion instead of the token) and must keep the [fyi] marker (the
# scanner only considers [fyi]/[verify]/[chat-review]/[design]).
PROBE_PREFIX='[fyi] rollcall-armprobe '
# The digest shape's own head, as mesh-roll-call spells it. Matched with index(), never as a regex.
DIGEST_LITERAL='[fyi] roll-call DIGEST:'

# NO BACKTICKS IN THIS STRING: mesh-chat command-substitutes them (memory
# mesh-chat-executes-backticks-in-the-message), so a backticked identifier here would be RUN, not
# posted, and the board would carry its output instead of the obligation.
task_text() {
  printf '%s' "[task] retire-the-roll-call-prefix-exclusion-once-the-live-tally-proves-adoption owner: mesh-mind-control/genome — ADOPTION IS NOW MEASURED ON THE LIVE BOARD, this is the arm firing, not a guess. Evidence from a dry-run of the change itself: $1 STEP 3: delete the per-shape prefix exclusion in mesh-mind-control scan_orphans (the '\''\$0 !~ /:: +\\[fyi\\] roll-call /'\'' clause and its WHY block) and the (a4b) fixture in its --test that pins it, then confirm mesh-roll-call --test stays green — its polarity arm (b) already proves the declaration alone suppresses the mint with the prefix out of the way. Do NOT widen the exclusion instead: a per-shape exclusion list fails toward SILENCE and this is the whole reason the polarity was inverted. AND RETIRE THIS ARM IN THE SAME COMMIT: once the exclusion is gone mesh-roll-call-retire-arm is a reflex tending a target that no longer exists — delete the script, its line in reflexes.cron (mesh-reflexes --apply), its log and its marker file. A workaround that outlives the fault it worked around runs cron-green forever and its own marker makes it read 'posted' whatever the board does."
}

# THE SAFETY PROBE FACES THE **FULL** BOARD, because that is what step 3 faces.
# An earlier cut fed the scanner a board subset containing ONLY roll-call lines. That changes the
# verdict in both directions and is not the question being asked: the scanner closes a finding that a
# LATER board line resolves, so stripping every non-roll-call line removes real resolutions (mints
# that would not happen), while keeping only roll-call lines can let one roll-call line resolve
# another in a way the full board would not. Measured: the single live owner-tagged roll-call line in
# the window minted in isolation and did NOT mint on a roll-call-only board. Only the full board
# answers "what would deleting the exclusion actually mint".
#
# NOTHING IS RE-STAMPED. The scanner will not mint a finding younger than its 30min orphan floor, so a
# line posted 10 minutes ago reads as safe and would mint the moment it crosses. Re-stamping to
# simulate that also re-orders the resolved-AFTER logic, so instead of faking the clock the probe
# COUNTS those lines and publishes them as `pending` — and a window with any pending line cannot arm.
# An unknown is named, not simulated.
#
# rewrite_board <src> <dst> — copies the board, rewriting ONLY bodies that START with the roll-call
# head. A line merely MENTIONING the phrase in prose (the polarity [task]/[done] lines in the live
# window do) is not a roll-call line and passes through untouched.
rewrite_board() {
  awk -v pre="$PROBE_PREFIX" -v head="$ROLLCALL_HEAD" '
    {
      p = index($0, "::")
      if (p > 0) {
        who = substr($0, 1, p - 1); rest = substr($0, p + 2)
        lead = ""
        while (substr(rest, 1, 1) == " " || substr(rest, 1, 1) == "\t") {
          lead = lead substr(rest, 1, 1); rest = substr(rest, 2)
        }
        if (index(rest, head) == 1) {          # ANCHORED: the body BEGINS with the roll-call head
          print who "::" lead pre substr(rest, length(head) + 1)
          next
        }
      }
      print
    }' "$1" > "$2" 2>/dev/null
}

# is_rollcall_line — the anchored test, used for counting and for shape splitting. Kept as ONE
# definition so the count, the split and the rewrite cannot drift apart.
ROLLCALL_HEAD='[fyi] roll-call '

# run_scan <board> — runs the REAL deployed scanner over <board> under a fake HOME with stub outbound
# verbs. Sets SCAN_MINTS / SCAN_TALLY. Returns 1 if it could not be run at all (UNKNOWN, never 0).
run_scan() {
  local board="$1" sb cap
  SCAN_MINTS=0 SCAN_TALLY=0
  [ -n "$MC" ] && [ -x "$MC" ] || return 1
  [ -r "$board" ] || return 1
  sb="$(mktemp -d "${TMPDIR:-/tmp}/rcra.XXXXXX")" || return 1
  mkdir -p "$sb/home/.local/bin" "$sb/w" || { rm -rf "$sb"; return 1; }
  # The fake card carries the child's own dispatch gate on ANY node: a blank minds: line is HANDS-OFF
  # and the scanner early-returns, which would make every arm below falsely quiet.
  printf '  minds: claude opencode\n' > "$sb/home/.mesh-card"
  local st
  for st in mesh-chat mesh-tell; do
    printf '#!/bin/sh\nprintf %%s\\n "$*" >> "$MESH_RCRA_CAP"\n' > "$sb/home/.local/bin/$st"
    chmod +x "$sb/home/.local/bin/$st"
  done
  cap="$sb/w/cap"; : > "$cap"
  HOME="$sb/home" MESH_RCRA_CAP="$cap" MESH_ROLES='' MESH_MC_HOSTNAME="${MESH_MC_HOSTNAME:-$(hostname)}" \
    MESH_MC_CHATLOG="$board" MESH_MC_ORPHAN_STATE="$sb/w/st" \
    "$MC" --scan-orphans > "$sb/w/out" 2> "$sb/w/err"
  SCAN_TALLY="$(sed -n 's/^scan_orphans: \([0-9][0-9]*\) board line(s) declared route:no.*/\1/p' "$sb/w/err" 2>/dev/null | head -1)"
  SCAN_TALLY="${SCAN_TALLY:-0}"
  SCAN_MINTS="$(grep -c '^\[task\] route-orphan/' "$sb/w/out" 2>/dev/null | tr -d ' ')"
  SCAN_MINTS="${SCAN_MINTS:-0}"
  rm -rf "$sb"
  return 0
}

# probe_safety — the dry-run of the deletion itself, over the full live board.
# Sets SAFE_MINTS / SAFE_PENDING / SAFE_LINES. Returns 1 for UNKNOWN.
probe_safety() {
  local wd board cut floor
  SAFE_MINTS=0 SAFE_PENDING=0 SAFE_LINES=0
  [ -r "$CHATLOG" ] || return 1
  wd="$(mktemp -d "${TMPDIR:-/tmp}/rcra-safe.XXXXXX")" || return 1
  board="$wd/board"
  rewrite_board "$CHATLOG" "$board"
  # SELF-DISTRUST: the probe's whole claim is that it looks PAST the exclusion. If any ANCHORED
  # roll-call head survived the rewrite, a zero mint count means "the exclusion suppressed it" —
  # exactly the false green this tool exists to avoid. Measured: the first cut split the board on the
  # literal ":: " while the real separator carries TWO spaces, so every prefix survived and the probe
  # reported a confident would-mint=0 over a board of purely undeclared lines.
  if grep -qE '::[[:space:]]+\[fyi\] roll-call ' "$board" 2>/dev/null; then
    rm -rf "$wd"; return 1
  fi
  cut="$(date -u -d '24 hours ago' +%FT%TZ 2>/dev/null)" || { rm -rf "$wd"; return 1; }
  floor="$(date -u -d "@$(( $(date +%s) - 1800 ))" +%FT%TZ 2>/dev/null)" || { rm -rf "$wd"; return 1; }
  SAFE_LINES="$(awk -v cut="$cut" -v pre="$PROBE_PREFIX" \
      '$1 >= cut && index($0, "::") > 0 && index($0, pre) > 0 {n++} END{print n+0}' "$board")"
  SAFE_PENDING="$(awk -v floor="$floor" -v pre="$PROBE_PREFIX" \
      '$1 >= floor && index($0, "::") > 0 && index($0, pre) > 0 {n++} END{print n+0}' "$board")"
  if ! run_scan "$board"; then rm -rf "$wd"; return 1; fi
  SAFE_MINTS="$SCAN_MINTS"
  rm -rf "$wd"
  return 0
}

# probe_tally <ping|digest> — the ADOPTION reading for one shape. The subset exists only so the
# scanner's END-block tally is attributable to a shape; it is never used for the mint verdict, which
# probe_safety takes from the full board. Sets PROBE_TALLY / PROBE_LINES. Returns 1 for UNKNOWN.
probe_tally() {
  local want="$1" wd board cut
  PROBE_TALLY=0 PROBE_LINES=0
  [ -r "$CHATLOG" ] || return 1
  wd="$(mktemp -d "${TMPDIR:-/tmp}/rcra-tally.XXXXXX")" || return 1
  board="$wd/board"
  cut="$(date -u -d '24 hours ago' +%FT%TZ 2>/dev/null)" || { rm -rf "$wd"; return 1; }
  # SHAPE IS SPLIT BY index() ON FIXED LITERALS, NEVER BY A REGEX PASSED THROUGH awk -v: `-v
  # filt='\[fyi\]…'` arrives with its backslashes eaten (memory awk-v-eats-the-regex-backslashes), so
  # the intended literal silently became a CHARACTER CLASS, matched nothing, and the arm rendered a
  # confident 'no-rounds' over a board full of lines.
  awk -v cut="$cut" -v head="$ROLLCALL_HEAD" -v dig="$DIGEST_LITERAL" -v want="$want" '
    {
      p = index($0, "::"); if (p == 0) next
      rest = substr($0, p + 2)
      while (substr(rest, 1, 1) == " " || substr(rest, 1, 1) == "\t") rest = substr(rest, 2)
      if (index(rest, head) != 1) next                       # ANCHORED — a prose mention is not a line
      if ($1 < cut) next
      if ((want == "digest") != (index(rest, dig) == 1)) next
      print
    }' "$CHATLOG" > "$board" 2>/dev/null
  PROBE_LINES="$(wc -l < "$board" 2>/dev/null | tr -d ' ')"; PROBE_LINES="${PROBE_LINES:-0}"
  # The tally is printed for lines the scanner sees in ITS window; the exclusion does not suppress the
  # tally (a declared line is counted BEFORE the shape filter), so this subset needs no rewrite.
  if ! run_scan "$board"; then rm -rf "$wd"; return 1; fi
  PROBE_TALLY="$SCAN_TALLY"
  rm -rf "$wd"
  return 0
}

# cronlog_tally — how many times the LIVE production scanner has printed its declaration tally into
# the cron log. STEP 2 asks for exactly this reading. It is CORROBORATION, never the gate: the log is
# untimestamped and tail-bounded, so it cannot date a window, and a rotation reads identically to a
# scanner that never counted. The probe above is the dateable measurement; this says whether
# production agrees. Reported as a count of tally lines and the newest one's number.
cronlog_tally() {
  CRON_TALLY_N=0 CRON_TALLY_LAST=na
  [ -r "$CRONLOG" ] || { CRON_TALLY_LAST=unreadable; return 1; }
  CRON_TALLY_N="$(grep -c 'declared route:no' "$CRONLOG" 2>/dev/null | tr -d ' ')"
  CRON_TALLY_N="${CRON_TALLY_N:-0}"
  if [ "$CRON_TALLY_N" -gt 0 ]; then
    CRON_TALLY_LAST="$(sed -n 's/^scan_orphans: \([0-9][0-9]*\) board line(s) declared route:no.*/\1/p' "$CRONLOG" 2>/dev/null | tail -1)"
    CRON_TALLY_LAST="${CRON_TALLY_LAST:-na}"
  fi
  return 0
}

render() {
  local state="$1" why="$2"
  printf '[roll-call-retire-arm] state: %s | ping: lines=%s declared=%s | digest: lines=%s declared=%s | full-board dry-run: would-mint=%s pending=%s | cronlog-tally: n=%s last=%s | %s\n' \
    "$state" "$PING_LINES" "$PING_TALLY" "$DIG_LINES" "$DIG_TALLY" \
    "$SAFE_MINTS" "$SAFE_PENDING" "$CRON_TALLY_N" "$CRON_TALLY_LAST" "$why"
}

run_arm() {
  cronlog_tally
  PING_LINES=na PING_TALLY=na DIG_LINES=na DIG_TALLY=na SAFE_MINTS=na SAFE_PENDING=na
  if ! probe_tally digest; then
    render UNKNOWN "the real scanner could not be run over the digest subset (mesh-mind-control=[${MC:-absent}], board=[$CHATLOG]) — never read as clean"
    return 2
  fi
  DIG_LINES="$PROBE_LINES" DIG_TALLY="$PROBE_TALLY"
  if ! probe_tally ping; then render UNKNOWN "the ping subset probe could not run"; return 2; fi
  PING_LINES="$PROBE_LINES" PING_TALLY="$PROBE_TALLY"
  if ! probe_safety; then
    render UNKNOWN "the full-board dry-run could not run, or an ANCHORED roll-call head survived its rewrite — a zero mint count would then mean 'the exclusion suppressed it', which is the false green this gate exists to avoid"
    return 2
  fi

  local rounds=$(( PING_LINES + DIG_LINES ))
  if [ -f "$MARK" ]; then
    render posted "already armed $(date -u -r "$MARK" +%FT%TZ 2>/dev/null) — the step-3 [task] is on the board; this arm never files a second obligation"
    return 0
  fi
  if [ "$rounds" -eq 0 ]; then
    render no-rounds "no roll-call lines in the live 24h window at all — roll-call is dark, so 'nothing would mint' is vacuous, not safe"
    return 1
  fi
  if [ "$PING_TALLY" -eq 0 ] && [ "$DIG_TALLY" -eq 0 ]; then
    render undeclared "the scanner tallies NO declaration in $rounds roll-call line(s) — the minds are dropping the token from the prompt. That is a PROMPT bug to fix, not a reason to retire the exclusion"
    return 1
  fi
  if [ "$PING_TALLY" -eq 0 ] || [ "$DIG_TALLY" -eq 0 ]; then
    render partial "only one shape is declaring (ping=$PING_TALLY digest=$DIG_TALLY) — both quote owner clauses wholesale and both must declare before the exclusion can go"
    return 1
  fi
  if [ "$SAFE_MINTS" -gt 0 ]; then
    render dirty "both shapes declare, but a full-board dry-run of the deletion still MINTS $SAFE_MINTS phantom(s) off roll-call lines inside the window — the exclusion is load-bearing until those age out"
    return 1
  fi
  if [ "$SAFE_PENDING" -gt 0 ]; then
    render dirty "both shapes declare and nothing minted, but $SAFE_PENDING roll-call line(s) are still inside the scanner's own 30min orphan floor — too young to have minted yet, so a clean read here is not yet a claim about them"
    return 1
  fi

  local ev
  ev="over the live 24h window the real scanner tallied $PING_TALLY declared per-mind ping(s) and $DIG_TALLY declared digest(s) across $rounds roll-call line(s), and a dry-run of the deletion itself — the FULL live board with every anchored roll-call prefix rewritten so the exclusion cannot match, fed to the real mesh-mind-control --scan-orphans — minted ZERO route-orphans with ZERO lines left inside the 30min orphan floor (production cron log agrees: $CRON_TALLY_N tally line(s), newest $CRON_TALLY_LAST)."
  if [ -n "${MESH_RCRA_DRYRUN:-}" ]; then
    render armed-DRYRUN "gate MET — would post the step-3 [task] now (dry-run, nothing posted): $ev"
    return 0
  fi
  # Claim the irreversible act BEFORE performing it: a crash between the post and the marker would
  # re-file the obligation next run (memory
  # a-cursor-saved-at-the-end-of-a-pass-repeats-every-fire-a-crash-interrupts).
  printf 'armed %s\nevidence: %s\n' "$(date -u +%FT%TZ)" "$ev" > "$MARK" 2>/dev/null
  if MESH_WHO="roll-call-retire-arm@$(hostname)" mesh-chat "$(task_text "$ev")" >/dev/null 2>&1; then
    mesh-trace "roll-call-retire-arm: gate met, step-3 [task] posted — $ev" >/dev/null 2>&1
    render armed "gate MET — step-3 [task] posted to the board. $ev"
    return 0
  fi
  # The post FAILED: clear the marker so the next run retries, rather than going permanently quiet on
  # an obligation that was never actually filed.
  rm -f "$MARK"
  render UNKNOWN "gate MET but the board post FAILED — marker cleared so the next run retries. $ev"
  return 2
}

# ── --test ────────────────────────────────────────────────────────────────────────────────────────
# Every arm drives the REAL deployed mesh-mind-control over a fixture board. The control arm comes
# FIRST and must go RED-if-broken: without it, a sandbox slip or a card-gated child would make every
# "would-mint=0" arm below pass for the wrong reason, and the gate would arm on a dead probe.
self_test() {
  local fail=0; RCRA_TD="$(mktemp -d "${TMPDIR:-/tmp}/rcra-test.XXXXXX")" || return 1
  local td="$RCRA_TD"
  # The trap must reference a GLOBAL: a function-local is gone by the time the EXIT trap runs, and
  # under `set -u` that turns a clean exit into 'td: unbound variable' after the verdict has printed.
  trap 'rm -rf "${RCRA_TD:-}"' EXIT
  mkdir -p "$td/bin" "$td/w"
  # Stub the outbound verbs on PATH so a gate-met arm cannot post to the real board.
  local s
  for s in mesh-chat mesh-tell mesh-trace; do
    printf '#!/bin/sh\nprintf %%s\\n "$*" >> "%s/w/outbound"\n' "$td" > "$td/bin/$s"
    chmod +x "$td/bin/$s"
  done
  : > "$td/w/outbound"
  export PATH="$td/bin:$PATH"

  # THE DECLARATION TOKEN IS READ FROM THE POSTER, NEVER TYPED HERE. A hand-written fixture asserts
  # the fixture author's assumptions, not the contract; if mesh-roll-call re-spells its token this
  # test must break, not keep passing against a stale literal.
  local rc_src tok
  rc_src="$(command -v mesh-roll-call 2>/dev/null || echo "$(dirname "$0")/mesh-roll-call")"
  tok="$(grep -m1 -oE '\brout[e]:[a-z]+' "$rc_src" 2>/dev/null | head -1)"
  if [ -z "$tok" ]; then
    echo "  FAIL: could not read the declaration token out of the poster ($rc_src) — the fixture would assert a literal typed here"
    fail=1; tok="route:no"
  else
    echo "  ok: declaration token read from the poster itself ($rc_src): $tok"
  fi

  local old fresh
  old="$(date -u -d "@$(( $(date +%s) - 7200 ))" +%FT%TZ)"     # 2h — in window, past the orphan floor
  fresh="$(date -u -d "@$(( $(date +%s) - 300 ))" +%FT%TZ)"    # 5min — in window, INSIDE the floor
  # EVERY FIXTURE LINE QUOTES A DISTINCT SUBJECT. Two roll-call lines quoting the SAME task+owner are
  # not two findings: the scanner reads the later one as RESOLVING the earlier, so an undeclared
  # straggler beside an identical declared sibling mints nothing and the straggler arms below pass for
  # the wrong reason. Measured — the first cut of this test used one shared quote and read
  # would-mint=0 with a real straggler present. Real roll-call rounds quote different work per window,
  # so the shared-quote board was the artefact, not the behaviour.
  local n=0
  mk() { # mk <file> <ts> <declared:0|1> <shape:ping|digest>
    local f="$1" ts="$2" dec="$3" shape="$4" head
    n=$(( n + 1 ))
    if [ "$shape" = digest ]; then head="[fyi] roll-call DIGEST:"; else head="[fyi] roll-call w$n:"; fi
    if [ "$dec" = 1 ]; then head="$head $tok |"; fi
    printf '%s  genome@node  ::  %s CHANGED landed [task] rc-arm-selftest-%s (owner: mesh-sub%s/genome)\n' \
      "$ts" "$head" "$n" "$n" >> "$f"
  }
  ARM() { # ARM <boardfile> → prints the reading, sets ARM_RC
    MESH_MC_CHATLOG="$1" MESH_RCRA_MARK="$td/w/mark" MESH_RCRA_CRONLOG="$td/w/cron" \
    MESH_RCRA_DRYRUN=1 MESH_MC_HOSTNAME=node "$0" 2>&1; ARM_RC=$?
  }

  # (control) A BOARD OF UNDECLARED ROLL-CALL LINES MUST MINT. This is the arm that proves the probe
  # is alive at all — it is the exact case the surviving exclusion suppresses on the LIVE board, and
  # the probe only sees it because it re-prefixes past that exclusion.
  local b="$td/w/b-undecl"; : > "$b"; mk "$b" "$old" 0 ping; mk "$b" "$old" 0 digest
  local o; o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'would-mint=0' \
    && { echo "  FAIL (control): undeclared roll-call lines minted NOTHING — the probe is vacuous and every clean verdict below is green for the wrong reason: $o"; fail=1; } \
    || echo "  ok (control): undeclared roll-call lines DO mint through the real scanner — the probe is live"
  printf '%s\n' "$o" | grep -q 'state: undeclared' \
    && echo "  ok: an all-undeclared window reads 'undeclared' — named as a PROMPT bug, never armed" \
    || { echo "  FAIL: an all-undeclared window did not read 'undeclared': $o"; fail=1; }

  # (a) BOTH SHAPES DECLARED AND NOTHING ELSE IN THE WINDOW → the gate is MET.
  b="$td/w/b-clean"; : > "$b"; mk "$b" "$old" 1 ping; mk "$b" "$old" 1 digest
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'state: armed-DRYRUN' \
    && echo "  ok: both shapes declaring + a zero-mint dry-run of the deletion arms the gate" \
    || { echo "  FAIL: a fully-declared window did not arm: $o"; fail=1; }
  printf '%s\n' "$o" | grep -qE 'ping: lines=1 declared=1' \
    && printf '%s\n' "$o" | grep -qE 'digest: lines=1 declared=1' \
    && echo "  ok: the scanner's OWN tally counts each shape separately (1 ping, 1 digest) — adoption is measured, not assumed" \
    || { echo "  FAIL: the per-shape tally is not the scanner's count: $o"; fail=1; }

  # (b) ONE SHAPE ONLY → partial, never armed. Both shapes quote owner clauses wholesale.
  b="$td/w/b-ping"; : > "$b"; mk "$b" "$old" 1 ping
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'state: partial' \
    && echo "  ok: a declaring ping with no declaring digest reads 'partial', not armed" \
    || { echo "  FAIL: a single-shape window armed or mis-stated: $o"; fail=1; }

  # (c) A SINGLE UNDECLARED STRAGGLER HOLDS THE GATE. This is the failure the task warns about — the
  # exclusion is load-bearing for as long as ONE such line sits inside the scanner's window.
  b="$td/w/b-dirty"; : > "$b"; mk "$b" "$old" 1 ping; mk "$b" "$old" 1 digest; mk "$b" "$old" 0 ping
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'state: dirty' \
    && echo "  ok: one undeclared straggler inside the window holds the gate at 'dirty' — the exclusion stays" \
    || { echo "  FAIL: an undeclared straggler did not hold the gate: $o"; fail=1; }

  # (d) A LINE TOO YOUNG TO HAVE MINTED IS NAMED, NOT ASSUMED SAFE. The scanner will not mint a
  # finding inside its own 30min orphan floor, so a straggler posted 5 minutes ago contributes ZERO to
  # the mint count while being exactly the line that mints once it crosses. Reading that as clean arms
  # the gate one round early; the probe therefore counts those lines as `pending` and holds. This is
  # the honest form of the trap — the unknown is published, not simulated away with a faked clock.
  b="$td/w/b-fresh"; : > "$b"; mk "$b" "$old" 1 ping; mk "$b" "$old" 1 digest; mk "$b" "$fresh" 0 ping
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'state: dirty' \
    && printf '%s\n' "$o" | grep -q 'pending=1' \
    && echo "  ok: a straggler still inside the 30min orphan floor is counted as pending and holds the gate — a clean mint count over it is not yet a claim" \
    || { echo "  FAIL: a sub-floor undeclared straggler read as safe — pending is not being counted: $o"; fail=1; }

  # (e) A PROSE MENTION IS NOT A ROLL-CALL LINE. The live window carries [task]/[done] lines quoting
  # the phrase "[fyi] roll-call " inside their text; counting those as rounds inflates adoption, and
  # rewriting their prefix would corrupt a line the deletion never touches. The head must be ANCHORED.
  b="$td/w/b-prose"; : > "$b"; mk "$b" "$old" 1 ping; mk "$b" "$old" 1 digest
  # [fyi], not [task]: the scanner only considers [fyi]/[verify]/[chat-review]/[design], so a [task]
  # fixture here would mint nothing for a reason that has nothing to do with anchoring.
  printf '%s  senses@node  ::  [fyi] the scanner excludes the "[fyi] roll-call " prefix and should not. owner: mesh-prose/senses\n' "$old" >> "$b"
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -qE 'ping: lines=1 declared=1' \
    && printf '%s\n' "$o" | grep -q 'state: dirty' \
    && echo "  ok: a prose line QUOTING the roll-call head is not counted as a round, and still mints — the head is matched anchored, not by substring" \
    || { echo "  FAIL: a prose mention of the roll-call head was mis-handled: $o"; fail=1; }

  # (f) AN EMPTY WINDOW IS UNKNOWN, NEVER CLEAN. 'nothing would mint' is vacuously true of no lines.
  b="$td/w/b-empty"; : > "$b"
  printf '%s  genome@node  ::  [fyi] something unrelated. owner: mesh-x/genome\n' "$old" > "$b"
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'state: no-rounds' \
    && echo "  ok: a window with no roll-call lines reads 'no-rounds' — a dark poster is never mistaken for adoption" \
    || { echo "  FAIL: an empty window did not read 'no-rounds': $o"; fail=1; }

  # (g) IDEMPOTENCE: the marker means the obligation is already on the board, and a second one is a
  # duplicate claim nobody closes.
  b="$td/w/b-clean"; printf 'armed test\n' > "$td/w/mark"
  o="$(ARM "$b")"
  printf '%s\n' "$o" | grep -q 'state: posted' \
    && echo "  ok: a present marker reads 'posted' — the arm never files a second obligation" \
    || { echo "  FAIL: the marker did not suppress a re-post: $o"; fail=1; }
  rm -f "$td/w/mark"

  # (h) NO OUTBOUND LEAKED. Every arm above ran under MESH_RCRA_DRYRUN with stubbed verbs; a real
  # mesh-chat reaching the board would mean the test itself posted the obligation it is testing.
  if [ -s "$td/w/outbound" ]; then
    echo "  FAIL: the test leaked $(wc -l < "$td/w/outbound") outbound call(s): $(head -2 "$td/w/outbound")"; fail=1
  else
    echo "  ok: no outbound call reached the board from any arm"
  fi

  # (i) THE LIVE READING RUNS. Not an assertion about its VALUE (the live board is the world and this
  # is a gate whose whole point is that it is not yet met) — an assertion that the tool can read the
  # real corpus at all, so a permanently-broken probe cannot hide behind fixtures.
  o="$(MESH_RCRA_DRYRUN=1 MESH_RCRA_MARK="$td/w/nomark" "$0" 2>&1)"
  printf '%s\n' "$o" | grep -q '^\[roll-call-retire-arm\] state: ' \
    && echo "  ok: the live board reading renders — $(printf '%s' "$o" | sed 's/ | .*//')" \
    || { echo "  FAIL: the live reading did not render: $o"; fail=1; }

  [ "$fail" = 0 ] && echo "self-test: ok" || echo "self-test: FAILED"
  return "$fail"
}

case "${1:-}" in
  --test) self_test; exit $? ;;
  --help|-h) sed -n '2,60p' "$0"; exit 0 ;;
  "") run_arm; exit $? ;;
  *) echo "usage: $(basename "$0") [--test|--help]" >&2; exit 64 ;;
esac
