#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# mesh-irq-balance — hardware interrupt-affinity concentration sense.
#
# Reads the numbered hardware IRQ rows in /proc/interrupts and relates their per-CPU
# counts: CONCENTRATED means one CPU handled >=60% of the observed hardware IRQs,
# BALANCED means it did not. This is a live scheduler/IRQ-routing signal, distinct
# from mesh-irq-rate's total device rate and from its softirq concentration axis.
#
# Honest contract: an unreadable/malformed source or a zero-count sample exits 2;
# no zero/default reading is emitted. Successful edge runs touch state every time so
# a stable value remains live rather than becoming falsely stale.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_IRQ_BALANCE_STATE:-$MESH/.irq-balance-state}"
SOURCE="${MESH_IRQ_BALANCE_PATH:-/proc/interrupts}"

read_balance() {
  awk '
    # Only numbered rows are device IRQs. NMI/LOC/RES/etc. are kernel bookkeeping.
    /^[[:space:]]*[0-9]+:/ {
      c=index($0, ":"); rest=substr($0, c+1); sub(/^[[:space:]]+/, "", rest)
      n=split(rest, a, /[[:space:]]+/)
      cpu=0
      for (i=1; i<=n; i++) {
        if (a[i] !~ /^[0-9]+$/) break
        v=a[i]+0; sum[cpu]+=v; total+=v; if (sum[cpu]>max) max=sum[cpu]; cpu++
      }
      if (cpu>cpus) cpus=cpu
      rows++
    }
    END {
      if (rows==0 || cpus==0 || total==0) exit 2
      share=(max*100)/total
      printf "%d\t%d\t%.2f\t%d\n", total, max, share, cpus
    }' "$SOURCE" 2>/dev/null
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat >"$td/interrupts" <<'EOF'
           CPU0       CPU1       CPU2
  16:        90          5          5  xhci_hcd
  17:         0          0          0  nvme0q
 NMI:         9          9          9  Non-maskable interrupts
 LOC:       100        100        100  Local timer interrupts
EOF
  got="$(MESH_IRQ_BALANCE_PATH="$td/interrupts" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read)"; exit 1;
  }
  printf '%s\n' "$got" | grep -q '"verdict":"CONCENTRATED"' || {
    echo "smoke-test: FAIL (fixture verdict: $got)"; exit 1;
  }
  printf '%s\n' "$got" | grep -q '"total":100' || {
    echo "smoke-test: FAIL (fixture total: $got)"; exit 1;
  }
  printf '%s\n' "$got" | grep -q '"max":90' || {
    echo "smoke-test: FAIL (fixture max: $got)"; exit 1;
  }
  cat >"$td/interrupts-balanced" <<'EOF'
           CPU0       CPU1
  16:        50         50  xhci_hcd
EOF
  balanced="$(MESH_IRQ_BALANCE_PATH="$td/interrupts-balanced" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (balanced fixture read)"; exit 1;
  }
  printf '%s\n' "$balanced" | grep -q '"verdict":"BALANCED"' || {
    echo "smoke-test: FAIL (balanced fixture: $balanced)"; exit 1;
  }
  : >"$td/empty"
  MESH_IRQ_BALANCE_PATH="$td/empty" "$0" --json >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (empty source must exit 2, got $rc)"; exit 1; }
  live="$("$0" --json 2>/dev/null)"; lrc=$?
  [ "$lrc" -eq 0 ] || {
    [ "$lrc" -eq 2 ] && { echo "smoke-test: n/a (no readable numbered hardware IRQ source)"; exit 2; }
    echo "smoke-test: FAIL (live read exit $lrc)"; exit 1;
  }
  printf '%s\n' "$live" | grep -Eq '"verdict":"(BALANCED|CONCENTRATED)"' || {
    echo "smoke-test: FAIL (live verdict missing: $live)"; exit 1;
  }
  echo "smoke-test: ok (fixture concentration/balance + unreachable exit-2 + real /proc/interrupts read)"
  exit 0
fi

mode=json
[ "${1:-}" = --edge ] && mode=edge
sample="$(read_balance)" || {
  echo "irq-balance: UNREACHABLE — cannot read a non-empty numbered hardware IRQ sample from $SOURCE" >&2
  exit 2
}
IFS=$'\t' read -r total max share cpus <<<"$sample"
case "$total:$max:$share:$cpus" in
  ''|*[!0-9:.]*) echo "irq-balance: UNREACHABLE — malformed sample from $SOURCE" >&2; exit 2 ;;
esac
awk -v t="$total" -v m="$max" 'BEGIN { exit !((m*100) >= (t*60)) }'
if [ "$?" -eq 0 ]; then verdict=CONCENTRATED; else verdict=BALANCED; fi
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
prev="$(awk -F= '$1=="verdict"{print $2}' "$STATE" 2>/dev/null || true)"
printf 'verdict=%s\ntotal=%s\nmax=%s\nmax_share_pct=%s\ncpus=%s\nts=%s\n' \
  "$verdict" "$total" "$max" "$share" "$cpus" "$ts" >"$STATE"
mesh-state-touch "$STATE" 2>/dev/null || true

if [ "$mode" = edge ] && [ "$prev" = "$verdict" ]; then exit 0; fi
if [ "$mode" = json ]; then
  printf '{"verdict":"%s","total":%s,"max":%s,"max_share_pct":%s,"cpus":%s,"source":"%s","ts":"%s"}\n' \
    "$verdict" "$total" "$max" "$share" "$cpus" "$SOURCE" "$ts"
else
  printf '[irq-balance] %s — max=%s/%s (%s%%) cpus=%s source=%s @ %s\n' \
    "$verdict" "$max" "$total" "$share" "$cpus" "$SOURCE" "$ts"
fi
