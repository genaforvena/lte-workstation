#!/usr/bin/env bash
# mesh-generate — task-flow GENERATOR (the queue flavor of the stream pattern). The monitor flavor
# (mesh-stream) has an idempotent pull; task-flow CONSUMES: it pops the next OPEN idea from
# ~/.mesh/ideas-queue, frames it as a worker task in ~/.mesh/backlog, and marks the idea in-flight.
# mesh-feed then keystroke-feeds backlog tasks to idle minds. Together:
#   ideas-queue --(mesh-generate)--> backlog --(mesh-feed)--> idle mind --> [done] --> repeat.
# Keeps the backlog topped up so minds never starve. "Ideas come to you" — minds RESPOND to fed work.
#   mesh-generate          top up the backlog from the idea queue if below MIN
#   mesh-generate --test
set -uo pipefail
MESH="$HOME/.mesh"; Q="$MESH/ideas-queue"; BL="$MESH/backlog"; LOG="$MESH/generate.log"; touch "$Q" "$BL"

# Don't strand work on a dead mind: peek the worker's tmux window; if it shows a usage-limit/quota
# banner it's unavailable (2026-06-12: all 3 worker minds were usage-limited and the blind rotation
# stranded 477 [~] zombie tasks). 30-min cooldown after a hit avoids a recovery deadlock (skip → no
# new banner → never retried). Fail-OPEN: no window / peek fails → treat available, never starve.
HOST_SESSION="$(hostname)"
mind_available(){
  [ -n "${MESH_GEN_ASSUME_AVAIL:-}" ] && return 0   # hermetic --test: don't peek real mind windows
  local m="${1##*:}"
  local cd="$MESH/.mind-cooldown-$m" now; now=$(date +%s)
  if [ -f "$cd" ]; then
    [ "$now" -lt "$(cat "$cd" 2>/dev/null || echo 0)" ] && return 1
    rm -f "$cd"
  fi
  local pane; pane="$(tmux capture-pane -t "$HOST_SESSION:$m" -p -S -6 2>/dev/null)" || return 0
  [ -n "$pane" ] || return 0
  if printf '%s' "$pane" | grep -qiE 'usage limit|hit your.*limit|quota exceeded|rate.?limit'; then
    echo "$(( now + 1800 ))" > "$cd"; return 1
  fi
  return 0
}
pick_mind(){ case $(( $1 % 3 )) in 0) echo local:opencode;; 1) echo local:gemini;; *) echo local:codex;; esac; }

run_generator() {
  MIN="${MESH_BACKLOG_MIN:-3}"; ts(){ date -u +%FT%TZ; }
  # NOT `|| echo 0`: grep -c PRINTS the 0 and exits 1 when nothing matches, so the fallback
  # appended a second 0 ("0\n0") and every integer test below failed -> the pump stalled the
  # moment the backlog became genuinely empty (2026-06-11, exposed by the mesh-feed removal fix).
  have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
  # Prune backlog lines whose idea-text matches a completed ([x]) idea in the queue
  if [ -s "$Q" ] && [ -s "$BL" ]; then
    donef=$(mktemp)
    grep '^\[x\] ' "$Q" | sed 's/^\[x\] //' > "$donef"
    if [ -s "$donef" ]; then
      tmp=$(mktemp)
      pruned=0
      while IFS= read -r line; do
        case "$line" in ''|\#*) echo "$line" >> "$tmp"; continue;; esac
        idea=$(printf '%s' "$line" | sed -n 's/^[^|]*|TASK (auto from idea-queue): \(.*\) — do it, leave changes in the tree.*/\1/p')
        if [ -n "$idea" ] && grep -qF "$idea" "$donef"; then
          echo "$(ts) prune: $(echo "$idea" | head -c 60) (idea [x])" >> "$LOG"
          pruned=$((pruned+1))
        else
          echo "$line" >> "$tmp"
        fi
      done < "$BL"
      mv "$tmp" "$BL"
      [ "$pruned" -gt 0 ] && echo "$(ts) pruned $pruned stale backlog line(s)" >> "$LOG"
    fi
    rm -f "$donef"
    have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
  fi
  [ "$have" -ge "$MIN" ] && { echo "backlog has $have (>= $MIN) — no generation"; exit 0; }
  rr=$(cat "$MESH/.gen-rr" 2>/dev/null || echo 0); added=0
  while [ "$have" -lt "$MIN" ]; do
    l=$(grep -m1 -nE '^\[ \]' "$Q" 2>/dev/null || true)
    if [ -z "$l" ]; then
      # EVERGREEN FALLBACK: queue empty but a worker is free — never leave it idle ("idle = discover",
      # operator). Append one rotating always-valuable discovery/maintenance task as a fresh [ ] idea,
      # then loop to pump it. They genuinely re-run with value (different node/tool/doc each time). This
      # is what stops the pump starving unattended (gemini+codex sat idle ~30min, 2026-06-11).
      EV="$MESH/evergreen-tasks"
      if [ -s "$EV" ]; then
        ec=$(grep -cvE '^[[:space:]]*(#|$)' "$EV"); ei=$(( ${rr:-0} % ec + 1 ))
        etask=$(grep -vE '^[[:space:]]*(#|$)' "$EV" | sed -n "${ei}p")
        [ -n "$etask" ] && { printf '[ ] %s\n' "$etask" >> "$Q"; echo "$(ts) evergreen refill -> ${etask:0:50}" >> "$LOG"; continue; }
      fi
      echo "$(ts) ideas-queue out of [ ] items + no evergreen — idle ok" >> "$LOG"; break
    fi
    n="${l%%:*}"; text=$(printf '%s' "$l" | sed 's/^[0-9]*:\[ \] *//')
    # pick an AVAILABLE worker mind; if none, leave the task [ ] open + stop (don't strand on a corpse)
    rr=$((rr+1)); w=$(pick_mind "$rr"); tries=1
    while ! mind_available "$w" && [ "$tries" -lt 3 ]; do rr=$((rr+1)); w=$(pick_mind "$rr"); tries=$((tries+1)); done
    if ! mind_available "$w"; then
      echo "$(ts) all worker minds unavailable (usage-limited?) — leaving task [ ] open, not stranding it" >> "$LOG"
      break
    fi
    printf '%s|TASK (auto from idea-queue): %s — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands).\n' "$w" "$text" >> "$BL"
    sed -i "${n}s/^\[ \]/[~]/" "$Q"
    echo "$(ts) generated -> $w: ${text:0:60}" >> "$LOG"
    have=$((have+1)); added=$((added+1))
  done
  echo "$rr" > "$MESH/.gen-rr"
  open=$(grep -cE '^\[ \]' "$Q" 2>/dev/null || true)
  echo "mesh-generate: +$added task(s); backlog now $have; queue open=${open:-0}"
}

if [ "${1:-}" = --test ]; then
  for dep in bash date grep mktemp sed mv cat wc; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; exit 1; }
  done
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh"
  cat > "$tmp/.mesh/ideas-queue" <<'EOF'
[ ] smoke gap: mesh-generate should exercise a real queue/backlog update
EOF
  : > "$tmp/.mesh/backlog"
  HOME="$tmp" MESH_BACKLOG_MIN=3 MESH_GEN_ASSUME_AVAIL=1 bash "$0" --run-with-test-files >/dev/null 2>&1 || { echo "smoke-test: FAIL (dry-run generation failed)"; exit 1; }
  grep -qx '\[~\] smoke gap: mesh-generate should exercise a real queue/backlog update' "$tmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (queue did not flip to [~])"; exit 1; }
  grep -q '^local:' "$tmp/.mesh/backlog" || { echo "smoke-test: FAIL (backlog not populated)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

if [ "${1:-}" = --run-with-test-files ]; then
  shift
fi
# MIN = number of worker minds (opencode/gemini/codex); lower starves the last in rotation
MIN="${MESH_BACKLOG_MIN:-3}"
ts(){ date -u +%FT%TZ; }
have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
run_generator
