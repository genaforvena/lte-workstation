#!/usr/bin/env bash
# mesh-generate — task-flow GENERATOR (the queue flavor of the stream pattern). The monitor flavor
# (mesh-stream) has an idempotent pull; task-flow CONSUMES: it pops the next OPEN idea from
# ~/.mesh/ideas-queue, frames it as a worker task in ~/.mesh/backlog, and marks the idea in-flight.
# mesh-feed then keystroke-feeds backlog tasks to idle minds. Together:
#   ideas-queue --(mesh-generate)--> backlog --(mesh-feed)--> idle mind --> [done] --> repeat.
# Keeps the backlog topped up so minds never starve. "Ideas come to you" — minds RESPOND to fed work.
#   mesh-generate          top up the backlog from the idea queue if below MIN
#   mesh-generate --test
#
# reflex-cadence: 2-59/7 * * * *
# (the DRAIN half of the autopoiesis CODEBASE lane: ideas-queue -> backlog. Fell out of cron in the
#  2026-06-17 channel reorg with NO cadence tag — same orphaning as mesh-dispatch — so mesh-autowire
#  could not re-pick it and the queue went WRITE-ONLY: mesh-ideate back-pressured to idle at its floor
#  (14 open ideas held, "not piling on") while nothing drained. This header makes it reorg-survivable.
#  Bare invocation tops the backlog up to MESH_BACKLOG_MIN; no reflex-args. Cadence bumped 2-59/10 -> 2-59/7
#  (6 -> 9 fires/hr, +50%, operator 2026-07-22 "make the loop faster") to pace new ideas into the backlog
#  50% faster; feed (1-59/5, 12/hr) still outpaces this drain so nothing starves. This DRAIN is not a
#  hand-feeder (it only writes backlog), so the benign minute-overlaps 2-59/7 now shares with feed/dispatch
#  do NOT violate the substantive invariant — that is feed vs dispatch never racing one IDLE HAND in a
#  minute, and those two are left untouched on their disjoint /5 lattice.)
set -uo pipefail
# source node-local overrides (MESH_WORKER_WIN, MESH_BACKLOG_MIN, …) — WITHOUT this a cron run has
# none of them and pick_mind falls back to a dead default window (2026-06-17 autopoiesis-targeting fix).
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
MESH="$HOME/.mesh"; Q="$MESH/ideas-queue"; BL="$MESH/backlog"; LOG="$MESH/generate.log"; touch "$Q" "$BL"
# canonical wall regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14):
# source the shared MESH_RL_RE, inline fallback if not deployed. The private regex here MISSED
# 429/resets/overloaded/out-of-credits → a worker walled by those wasn't seen as walled (task fed
# into a dead mind). Same migration as mesh-mind-state.
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"

# Don't strand work on a dead mind: peek the worker's tmux window; if it shows a usage-limit/quota
# banner it's unavailable (2026-06-12: all 3 worker minds were usage-limited and the blind rotation
# stranded 477 [~] zombie tasks). 30-min cooldown after a hit avoids a recovery deadlock (skip → no
# new banner → never retried). Fail-OPEN: no window / peek fails → treat available, never starve.
HOST_SESSION="$(hostname)"
mind_available(){
  [ -n "${MESH_GEN_ASSUME_AVAIL:-}" ] && return 0   # hermetic --test: don't peek real mind windows
  local m="${1##*:}"
  local cd="$MESH/.mind-cooldown-$m" now; now=$(date +%s)
  if [ -f "$cd" ]; then
    [ "$now" -lt "$(cat "$cd" 2>/dev/null || echo 0)" ] && return 1
    rm -f "$cd"
  fi
  # bottom-most pane = the MIND on a 2-pane channel (top=data); a window-target reads the UNSTABLE
  # active pane → could miss a rate-limit wall in the mind pane + feed an idea into a walled mind.
  # Same pane_top idiom as mesh-tell/mesh-watch/mesh-gate-watch (data-channel refactor 2026-06-13).
  local pidx; pidx=$(tmux list-panes -t "$HOST_SESSION:$m" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
  local pane; pane="$(tmux capture-pane -t "$HOST_SESSION:$m${pidx:+.$pidx}" -p -S -6 2>/dev/null)" || return 0
  [ -n "$pane" ] || return 0
  if printf '%s' "$pane" | grep -qiE "$MESH_RL_RE"; then
    echo "$(( now + 1800 ))" > "$cd"; return 1
  fi
  return 0
}
# ── MAP-ELITES ILLUMINATION / QUALITY-DIVERSITY ARCHIVE (Mouret & Clune 2015; QD lineage 2024-25) ──
# LITERATURE (artificial life & open-ended evolution, OPERATIONAL mechanism, 2026-06-21, genome mind).
# Concept: MAP-Elites (Mouret & Clune, "Illuminating search spaces by mapping elites", arXiv:1504.04909,
# 2015; Quality-Diversity lineage — Pugh/Lehman/Stanley) is the canonical OEE *illumination* mechanism:
# instead of optimizing for ONE best solution, discretize a multi-dimensional BEHAVIORAL-DESCRIPTOR space
# into a grid of niches and retain the single best-performing exemplar PER CELL — yielding an "illuminated"
# map of the best achievable quality at every point of the behavior space, and surfacing EMPTY cells
# (un-filled niches) as the highest-value targets. Operational core (verified live, WebSearch 2026-06-21):
# offspring is placed in its descriptor-cell iff the cell is empty OR it beats the cell's current champion.
# Recent: descriptor-conditioned QD-RL (arXiv:2401.08632, 2024), Vector-Quantized Elites (arXiv:2504.08057,
# 2025, learns the descriptors), BO-QD with coupled descriptors (IEEE TEVC 2024).
# Where the mesh STOPS short (this file = the CODEBASE generation lane): mesh-generate tops up the backlog
# and gates refill on cap_rotation_saturated() — a PER-NODE capability-gaps-sweep RECENCY gate (one axis:
# node × sweep-freshness). That is a 1-D coverage check, NOT a behavioral-descriptor ARCHIVE: nothing maps
# the produced capability space into niches (e.g. sense|actuate|fuse|liveness × node-class × organ-kind),
# retains the BEST exemplar per niche, or targets the EMPTY/weak cells as the highest-value generation.
# Generation is queue-pop + evergreen rotation; it cannot SEE which capability-niches are filled-with-a-
# strong-tool vs empty, so it can neither deliberately fill a hole nor cull a redundant duplicate against a
# per-niche champion. DISTINCT (do not conflate): NOT the novelty-search-sparseness review (mesh-ideate,
# 2026-06-21) — that adds a sparseness REWARD on the generation side with NO grid and NO quality/champion-
# per-niche retention (the exact thing MAP-Elites adds beyond novelty search); NOT the error-threshold /
# quasispecies review (mesh-fitness — variation-rate vs complexity, cited POET/QD in sources only); NOT the
# evolutionary-activity-vs-raw-activity review (mesh-vitality — counts produced/persisting structure, no
# niche structure, no per-cell champion); NOT this file's cap_rotation_saturated (a 1-D recency gate, not a
# multi-D illuminated archive with quality retention). HELD fix (instrument-first, steward/operator-gated):
# a MAP-Elites illumination archive of the capability space — choose behavioral-descriptor dimensions,
# retain the best exemplar per cell, and have generation target empty/weak cells while culling against the
# per-niche champion. WHY HELD: descriptor CHOICE is MAP-Elites' own documented weakness ("relies heavily
# on pre-defined behavioral descriptors" — a bad descriptor set illuminates the wrong space); the dimensions
# must be designed + validated against the real ~/.local/bin tool catalog (and the VQ-Elites learned-
# descriptor route considered) before any cell-targeting is wired. Not shipped — zero behavior change.
#
# LIVE-LITERATURE ADDENDUM — the mechanism that DISSOLVES the "WHY HELD" blocker above (genome
# literature review 2026-07-05, WebSearch): Dominated Novelty Search (Bahlous-Boldi, Faldor, Grillotti,
# Janmohamed, Coiffard, Spector, Cully — arXiv:2502.00593, GECCO 2025; code: github.com/adaptive-
# intelligent-robotics/Dominated-Novelty-Search). DNS is a Quality-Diversity algorithm that gets
# MAP-Elites' per-niche-champion illumination WITHOUT a predefined descriptor grid — it "implements
# local competition through dynamic fitness transformations, eliminating the need for predefined bounds
# or parameters," and is reported strongest exactly in "high-dimensional and unsupervised spaces." That
# is a direct answer to this block's whole reason-for-holding: descriptor CHOICE is unsolved here, so a
# fixed grid can illuminate the WRONG capability space. DNS needs no grid: score each candidate idea by
# its novelty-distance to the k-nearest ALREADY-GENERATED ideas (an embedding/behavior distance we can
# compute — the mesh-ideate sparseness axis is exactly this signal), then apply DNS's dominated-novelty
# transform — a candidate is culled iff a HIGHER-QUALITY idea already sits inside its local novelty
# neighborhood (it is "dominated" there). This is the parameter-free per-niche champion retention the
# HELD MAP-Elites fix wanted, minus its fragile hand-designed dimensions — and it targets our OWN
# documented failure mode: re-promoted evergreen/answered ideas are dominated by their prior stronger
# instance in the same novelty neighborhood and drop out, ending the idea-churn that MAP-Elites' fixed
# grid can't (it has no notion of "a better version of this already exists nearby"). STILL HELD, not
# shipped — this only records the unblocking mechanism + cite; wiring is instrument-first + operator-gated
# (the local-competition radius and quality axis need calibration against the real produced-idea log).
# CAPABILITY ROTATION saturation gate (chat-review 2026-06-15): that one evergreen no-ops when the
# fleet is already swept — every reachable node honestly reports "nothing new" → churny [done]s + a
# re-firing queue slot (the other 5 evergreens always have fresh tool/doc/organ work, so they don't).
# Return 0 (=saturated, skip refill) only when EVERY reachable tag:lte-node has a capability-gaps sweep
# newer than MESH_CAP_SWEEP_AGE_D days. PER-NODE coverage, not a raw file count — duplicate per-node
# sweep files would otherwise inflate the count and pin the gate shut forever. Self-correcting: when an
# offline node (e.g. default-string) rejoins, it has no fresh sweep → a node is uncovered → gate OPENS →
# CAPABILITY ROTATION fires for it. Fail-OPEN (no tailscale / parse error / no fresh files → not
# saturated → behave as before). Hostname↔filename matched on a normalized token (lowercase, separators
# stripped) so "Redmi 10" ↔ capability-gaps-Redmi-10-… ↔ …redmi10… all reconcile.
# RECENCY COMES FROM THE CLAIM, NOT THE mtime (chat-review 2026-07-15, discover+health-verified): this
# gate used `find -mtime`, and mtime is metadata ANY copy rewrites. The 07-14 mind migration cp'd
# knowledge/ without -p, so all 54 sweep files — content dated 06-11..06-26 — wear ONE mtime of 07-14
# 17:26 and every one of them read FRESH. It sat open only by accident (mesh-home had no
# capability-gaps-* file, so one node was uncovered); the first discover mind to follow its own
# instruction and write one would have pinned the gate shut on 54 June files and stopped CAPABILITY
# ROTATION fleet-wide. The sweep date is stated in the filename — read THAT. A file whose name carries
# no parseable date proves no recency and is not coverage (fail-OPEN: the gate fires, worst case a
# redundant sweep — never a silently stalled discovery lane). Same family as fa62ab2 ("an EDIT is not a
# landing — closed on mtime"): a migrated dir's mtime is the migration's age, never the fact's.
# Extract the sweep date CLAIMED by the filename (…-YYYY-MM-DD[x].md | …-YYYYMMDD[x].md) → YYYYMMDD.
# Anchored to the END and required to follow a '-' so a hostname's OWN digits cannot be misread as a
# date: an unanchored [0-9]{8} over the separator-stripped name reads capability-gaps-Redmi-10-20260612
# as '10202606' and GL-MT3000-2026-06-12b as '30002026'. rc=1 = undatable (incl. the literal
# capability-gaps-ilya-$(date +%Y-%m-%d).md a mind's quoting error left in knowledge/).
cap_sweep_date(){
  local d
  d=$(printf '%s' "${1%.md}" | grep -oiE -- '-([0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{8})[a-z]?$' | tr -cd '0-9') || return 1
  [ ${#d} -eq 8 ] || return 1
  date -d "$d" +%Y%m%d 2>/dev/null || return 1           # reject a well-shaped non-date (e.g. 20261399)
}
cap_rotation_saturated(){
  local age_d="${MESH_CAP_SWEEP_AGE_D:-2}" kdir="$MESH/knowledge" fresh_norm hosts h tok cutoff f b d
  [ -d "$kdir" ] || return 1
  cutoff=$(date -d "-${age_d} days" +%Y%m%d 2>/dev/null) || return 1
  fresh_norm=$(for f in "$kdir"/capability-gaps-*.md; do
                 [ -e "$f" ] || continue; b=${f##*/}
                 d=$(cap_sweep_date "$b") || continue    # no date claimed → proves no recency → not coverage
                 [ "$d" -ge "$cutoff" ] || continue      # the sweep's OWN date is stale → not coverage
                 printf '%s\n' "$b"
               done | tr 'A-Z' 'a-z' | tr -d ' _-')
  [ -n "$fresh_norm" ] || return 1                       # no fresh sweeps at all → not saturated
  if [ -n "${MESH_CAP_HOSTS_TEST:-}" ]; then
    hosts="$MESH_CAP_HOSTS_TEST"                          # test seam: inject reachable-node list (skip live tailscale)
  else
  hosts=$(tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(3)
hs=[d.get('Self',{}).get('HostName','')]
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []) and p.get('Online'): hs.append(p.get('HostName',''))
print('\n'.join(h for h in hs if h))" 2>/dev/null) || return 1
  fi
  [ -n "$hosts" ] || return 1                            # fail-open: couldn't enumerate reachable nodes
  while IFS= read -r h; do
    tok=$(printf '%s' "$h" | tr 'A-Z' 'a-z' | tr -d ' _-'); [ -n "$tok" ] || continue
    printf '%s\n' "$fresh_norm" | grep -qF "$tok" || return 1   # this node has no fresh sweep → NOT saturated
  done <<EOF
$hosts
EOF
  return 0                                                # every reachable node covered → saturated
}
# Target the worker window. The 4569b75 window-rename moved from agent-named windows
# (opencode/gemini/codex) to DATA/ROLE names — those old targets NO LONGER EXIST, so the pump
# was emitting tasks aimed at dead windows → mesh-feed 'assigned 0' → backlog never delivered
# (the whole ideas→generate→backlog→feed→mind autonomy loop dead at the targeting step). In the
# role model 'work' is the general discovery worker (dev/discover/sense are channel-fed specific
# data; plan/verify/tg/health/chat are role minds). Target the window that EXISTS + hosts the worker.
# CONNECTION ideas (organ/sense-fusion novelty — "what capability emerges when A meets B") are
# capability-DISCOVERY work, not codebase-implementation work, but every idea landed on the single
# MESH_WORKER_WIN target regardless of kind — so discover's own SECONDARY frontier (capability/organ
# fusion) never got a single one of mesh-ideate's live novelty prompts; they all went to genome
# (chat-review 2026-07-01, discover-creative-ideation). MESH_CONNECT_WIN lets a node route CONNECTION
# ideas to a different window (e.g. discover); unset = identical to prior behavior (falls through to
# MESH_WORKER_WIN, same as every other idea kind).
pick_mind(){
  case "${2:-}" in
    CONNECTION\ *) echo "${MESH_CONNECT_WIN:-${MESH_WORKER_WIN:-local:work}}" ;;
    *) echo "${MESH_WORKER_WIN:-local:work}" ;;
  esac
}

# ── STUDY-YIELD LEDGER + BACKLOG PRIORITY (discover→genome [task] 2026-07-20T18:45:31Z) ─────────
# The STUDY lane (study.log brief → study-bridge QUEUED idea → worker attempt → [x]) had no memory
# of which fields ever PRODUCE: 12 [~] entries pinned since 07-15 while a briefing wave went 0/25
# briefs→reviews, and the FIFO pop below kept handing slots to fields with zero demonstrated
# function. This couples idea 'reproduction' to demonstrated function (arxiv 2607.09211 mechanism):
# a field earns future slots by past completed attempts.
#   ~/.mesh/study-yield — DERIVED state (next to generate.log), rewritten unconditionally every run
#   (rewrite = liveness, per the liveness-touch convention; content is recomputed, never cached):
#     <field>|briefed|queued|done|score
#   briefed = "=== study: <field> (ts) ===" blocks in study.log (informational)
#   queued  = QUEUED lines in study-bridge.log (ideas actually handed to the loop)
#   done    = [x] STUDY(<field>) lines in ideas-queue (a completed, reconciled attempt — the honest
#             "function" signal; knowledge/study-*.md reviews are NOT counted: their filenames slug
#             the field lossily and a fuzzy match would forge yield)
#   score   = (done+1)/(queued+2) — Laplace-smoothed so a NEVER-TRIED field reads 0.500 (neutral:
#             beats a proven-dead field, loses to a proven-productive one — exploration survives).
study_yield_refresh(){
  python3 - "$MESH" <<'PYEOF' 2>/dev/null || true
import re,sys
mesh=sys.argv[1]
briefed={}; queued={}; done={}
def bump(d,f): d[f]=d.get(f,0)+1
try:
    for line in open(mesh+"/study.log"):
        m=re.match(r"=== study: (.*) \([^)]*\) ===$",line.strip())
        if m: bump(briefed,m.group(1).strip())
except Exception: pass
try:
    for line in open(mesh+"/study-bridge.log"):
        m=re.search(r" QUEUED field=(.*) ts=\S+ ::",line)
        if m: bump(queued,m.group(1).strip())
except Exception: pass
try:
    for line in open(mesh+"/ideas-queue"):
        m=re.match(r"\[x\] STUDY\(([^)]+)\)",line)
        if m: bump(done,m.group(1).strip())
except Exception: pass
rows=["# study-yield — per-STUDY-field briefed|queued|done|score; score=(done+1)/(queued+2), 0.500=no history; derived, rewritten each mesh-generate run"]
for f in sorted(set(briefed)|set(queued)|set(done)):
    b=briefed.get(f,0); q=queued.get(f,0); d=done.get(f,0)
    rows.append("%s|%d|%d|%d|%.3f"%(f,b,q,d,(d+1)/(q+2)))
open(mesh+"/study-yield","w").write("\n".join(rows)+"\n")
PYEOF
}
# Exact-field ledger read; ENVIRON (not -v) so a field name is never re-interpreted (awk -v eats
# backslashes). Missing file / unknown field → 0.500 neutral, never an error.
yield_score(){
  local s
  s=$(YF="$1" awk -F'|' 'NR>1 && $1==ENVIRON["YF"] {print $5; f=1; exit} END{if(!f)print ""}' "$MESH/study-yield" 2>/dev/null) || true
  echo "${s:-0.500}"
}
# The pop: FIFO everywhere EXCEPT when the FIFO head is itself a STUDY idea — then re-rank the open
# STUDY ideas by their field's demonstrated yield and take the best (strict-greater → ties stay
# FIFO). A non-STUDY head keeps its slot untouched: this never starves codebase/CONNECTION work,
# it only reorders which RESEARCH field gets the research slot.
pick_open_idea(){
  local head best bestscore l2 f s
  head=$(grep -m1 -nE '^\[ \]' "$Q" 2>/dev/null) || return 1
  [ -n "$head" ] || return 1
  case "$head" in
    *:"[ ] STUDY("*) ;;
    *) printf '%s\n' "$head"; return 0 ;;
  esac
  best="$head"; bestscore=-1
  while IFS= read -r l2; do
    [ -n "$l2" ] || continue
    f=$(printf '%s' "$l2" | sed -nE 's/^[0-9]+:\[ \] STUDY\(([^)]+)\):.*/\1/p'); [ -n "$f" ] || continue
    s=$(yield_score "$f")
    if awk -v a="$s" -v b="$bestscore" 'BEGIN{exit !(a+0>b+0)}'; then best="$l2"; bestscore="$s"; fi
  done <<EOF
$(grep -nE '^\[ \] STUDY\(' "$Q" 2>/dev/null)
EOF
  [ "$best" != "$head" ] && echo "$(ts) study-yield pick: score $bestscore beat FIFO head — ${best:0:80}" >> "$LOG"
  printf '%s\n' "$best"
}

run_generator() {
  # Serialize ALL ideas-queue mutations (append / [ ]->[~] flip / awk-rewrite) against a concurrent
  # mesh-queue-tend rewrite: both tools flock the SAME lockfile so a read->rewrite->mv on one side
  # can't lose-update the other's change (a lost flip re-opens a done idea → duplicate dispatch; this
  # is part of how the queue ran away to 351 lines while queue-tend was unwired). Best-effort: proceed
  # unlocked if flock is unavailable rather than hang. Held until process exit (FD 9 closes).
  exec 9>"$MESH/.ideas-queue.lock" 2>/dev/null || true
  flock -w 30 9 2>/dev/null || true
  MIN="${MESH_BACKLOG_MIN:-3}"; ts(){ date -u +%FT%TZ; }
  study_yield_refresh
  # NOT `|| echo 0`: grep -c PRINTS the 0 and exits 1 when nothing matches, so the fallback
  # appended a second 0 ("0\n0") and every integer test below failed -> the pump stalled the
  # moment the backlog became genuinely empty (2026-06-11, exposed by the mesh-feed removal fix).
  have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
  # Prune backlog lines whose idea-text matches a completed ([x]) idea in the queue
  if [ -s "$Q" ] && [ -s "$BL" ]; then
    donef=$(mktemp)
    grep '^\[x\] ' "$Q" | sed 's/^\[x\] //' > "$donef"
    if [ -s "$donef" ]; then
      tmp=$(mktemp)
      pruned=0
      while IFS= read -r line; do
        case "$line" in ''|\#*) echo "$line" >> "$tmp"; continue;; esac
        # FORMAT CONTRACT with the framer (:217 below): backlog line = "<who>|TASK (auto from idea-queue):
        # <idea> — do it. <boilerplate>". Match the literal " — do it" separator and DROP everything after
        # it, so this never re-breaks when the post-"do it" boilerplate changes. (It DID break: the framer
        # moved from "— do it, leave changes in the tree" to "— do it. If you edit a mesh tool…", the old
        # regex stopped matching → idea="" → [x] orphans NEVER pruned → endless STIMULUS-STALL re-fires on
        # already-discarded ideas. 2026-06-24. Greedy \(.*\) is safe: idea text never contains " — do it".)
        idea=$(printf '%s' "$line" | sed -n 's/^[^|]*|TASK (auto from idea-queue): \(.*\) — do it.*/\1/p')
        if [ -n "$idea" ] && grep -qF "$idea" "$donef"; then
          echo "$(ts) prune: $(echo "$idea" | head -c 60) (idea [x])" >> "$LOG"
          pruned=$((pruned+1))
        else
          echo "$line" >> "$tmp"
        fi
      done < "$BL"
      mv "$tmp" "$BL"
      [ "$pruned" -gt 0 ] && echo "$(ts) pruned $pruned stale backlog line(s)" >> "$LOG"
    fi
    rm -f "$donef"
    have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
  fi
  [ "$have" -ge "$MIN" ] && { echo "backlog has $have (>= $MIN) — no generation"; exit 0; }
  rr=$(cat "$MESH/.gen-rr" 2>/dev/null || echo 0); added=0
  while [ "$have" -lt "$MIN" ]; do
    l=$(pick_open_idea || true)
    if [ -z "$l" ]; then
      # EVERGREEN FALLBACK: queue empty but a worker is free — never leave it idle ("idle = discover",
      # operator). Append one rotating always-valuable discovery/maintenance task as a fresh [ ] idea,
      # then loop to pump it. They genuinely re-run with value (different node/tool/doc each time). This
      # is what stops the pump starving unattended (gemini+codex sat idle ~30min, 2026-06-11).
      EV="$MESH/evergreen-tasks"
      # EVERGREEN now DEFAULT-OFF (operator 2026-06-20 "никто ничего не производит"): manufacturing
      # synthetic discovery tasks to fill an empty queue == fabricating fake text-changes for a mind
      # to react to == a blind tick in disguise. A mind is a text-stream OBSERVER: it wakes on a REAL
      # diff, else it rests. Opt back in per-node with MESH_EVERGREEN=1 in ~/.mesh/restore.env.
      if [ "${MESH_EVERGREEN:-0}" = 1 ] && [ -s "$EV" ]; then
        ec=$(grep -cvE '^[[:space:]]*(#|$)' "$EV")
        # Refill-guard: append the first evergreen that is NOT already in-flight as a [~] line.
        # Re-appending a dispatched-but-unreconciled task is exactly how the queue ran away to
        # 351 lines (same 6 evergreens 33-61× each) while mesh-queue-tend was unwired. ([x]/done
        # copies stay refillable — evergreens are meant to re-run.) Rotate through all evergreens;
        # if every one is in-flight, leave the worker idle this cycle rather than duplicate.
        refilled=0
        for k in $(seq 0 $((ec-1))); do
          ei=$(( (${rr:-0} + k) % ec + 1 ))
          etask=$(grep -vE '^[[:space:]]*(#|$)' "$EV" | sed -n "${ei}p")
          [ -n "$etask" ] || continue
          grep -qxF "[~] $etask" "$Q" 2>/dev/null && continue
          # Skip CAPABILITY ROTATION while the fleet is fully swept (no value, just churn) — rotate
          # to the next valuable evergreen instead. Re-opens when a stale/offline node returns.
          case "$etask" in CAPABILITY\ ROTATION:*) cap_rotation_saturated && {
            echo "$(ts) evergreen skip CAPABILITY ROTATION — fleet swept (saturation gate)" >> "$LOG"; continue; };; esac
          printf '[ ] %s\n' "$etask" >> "$Q"; echo "$(ts) evergreen refill -> ${etask:0:50}" >> "$LOG"; refilled=1; break
        done
        [ "$refilled" = 1 ] && continue
        # DEADLOCK-BREAK: every evergreen is [~] in-flight yet the backlog is empty + a worker needs work
        # → those markers are STALE. Evergreens are generic ("pick ONE node/tool") so their board [done]s
        # rarely match strongly enough for mesh-queue-tend to reconcile → they pin [~] forever and the pump
        # STARVES (idle minds, empty backlog — the operator-flagged symptom). Evergreens are re-runnable by
        # design: flip the stale in-flight ones back to [x] (refillable) and retry. BOUNDED (only exact
        # evergreen lines, only at this dead-end → reset-then-readd, so no 351-line runaway).
        if awk -v evf="$EV" 'BEGIN{while((getline l<evf)>0){if(l!~/^[[:space:]]*(#|$)/)ev["[~] " l]=1}}
               {if($0 in ev){sub(/^\[~\]/,"[x]"); f=1} print} END{exit !f}' "$Q" > "$Q.tmp"; then
          mv "$Q.tmp" "$Q"
          echo "$(ts) deadlock-break: reset stale in-flight evergreens [~]->[x] (refillable), retrying" >> "$LOG"
          continue
        fi
        rm -f "$Q.tmp"
        echo "$(ts) all evergreens already in-flight [~] — no refill (in-flight work exists)" >> "$LOG"; break
      fi
      echo "$(ts) ideas-queue empty + evergreen off (MESH_EVERGREEN!=1) — idle ok, minds rest until a real diff" >> "$LOG"; break
    fi
    n="${l%%:*}"; text=$(printf '%s' "$l" | sed 's/^[0-9]*:\[ \] *//')
    # pick an AVAILABLE worker mind; if none, leave the task [ ] open + stop (don't strand on a corpse)
    rr=$((rr+1)); w=$(pick_mind "$rr" "$text"); tries=1
    while ! mind_available "$w" && [ "$tries" -lt 3 ]; do rr=$((rr+1)); w=$(pick_mind "$rr" "$text"); tries=$((tries+1)); done
    if ! mind_available "$w"; then
      echo "$(ts) all worker minds unavailable (usage-limited?) — leaving task [ ] open, not stranding it" >> "$LOG"
      break
    fi
    # gen-pair/CONNECTION ideas are divergent-generate exploration where MOST pairings are dead ends.
    # Route those NEGATIVE results to the durable trace ONCE, not the coordination board: a board
    # [idle] is marker-misuse (a result, not a status yield) and — worse — the worker tends to post a
    # long line that overflow-trims, then re-words a second one (byte-dedupe misses the pair) → doubled
    # board noise that nothing acts on AND that decays, so a future explorer can't see "A×B already
    # tried" (chat-review 2026-06-25, genpair-deadend-to-trace). `mesh-queue-tend` reads these
    # `gen-pair-deadend` trace lines to resolve the idea [~]→[x], so naming BOTH tools is required.
    deadend_clause=""
    case "$text" in
      CONNECTION\ *|*gen-pair*) deadend_clause=" DEAD-END PROTOCOL: most pairings ARE dead ends — if this one is, record it ONCE with mesh-trace \"gen-pair-deadend <toolA>×<toolB>: <one-line why>\" (name BOTH tools — durable history a future explorer greps, and what auto-resolves the queue), and do NOT post a board [idle] for it (that is board noise the trace replaces). Post [taking]+a prototype to the board ONLY if the pairing is genuinely valuable." ;;
    esac
    printf '%s|TASK (auto from idea-queue): %s — do it. If you edit a mesh tool, edit the GENOME SOURCE (scripts/<tool> in the repo at %s), NOT the deployed ~/.local/bin/ copy: a deployed-only edit never lands and sync-tools reverts it (the drift-clobber leak). Leave changes uncommitted in the tree, post [done]+artifact to chat. Do NOT commit (steward lands from the tree).%s\n' "$w" "$text" "${MESH_GENOME_DIR:-$HOME/lte-workstation}" "$deadend_clause" >> "$BL"
    sed -i "${n}s/^\[ \]/[~]/" "$Q"
    echo "$(ts) generated -> $w: ${text:0:60}" >> "$LOG"
    have=$((have+1)); added=$((added+1))
  done
  echo "$rr" > "$MESH/.gen-rr"
  open=$(grep -cE '^\[ \]' "$Q" 2>/dev/null || true)
  echo "mesh-generate: +$added task(s); backlog now $have; queue open=${open:-0}"
}

if [ "${1:-}" = --test ]; then
  for dep in bash date grep mktemp sed mv cat wc; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; exit 1; }
  done
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh"
  cat > "$tmp/.mesh/ideas-queue" <<'EOF'
[ ] smoke gap: mesh-generate should exercise a real queue/backlog update
EOF
  : > "$tmp/.mesh/backlog"
  HOME="$tmp" MESH_BACKLOG_MIN=3 MESH_GEN_ASSUME_AVAIL=1 bash "$0" --run-with-test-files >/dev/null 2>&1 || { echo "smoke-test: FAIL (dry-run generation failed)"; exit 1; }
  grep -qx '\[~\] smoke gap: mesh-generate should exercise a real queue/backlog update' "$tmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (queue did not flip to [~])"; exit 1; }
  grep -q '^local:' "$tmp/.mesh/backlog" || { echo "smoke-test: FAIL (backlog not populated)"; exit 1; }
  # genpair-deadend-to-trace: a NON-novelty task must NOT carry the DEAD-END PROTOCOL clause (clause
  # is scoped to CONNECTION/gen-pair exploration only). FALSIFIABLE: widen the case glob and this FAILs.
  grep -q 'DEAD-END PROTOCOL' "$tmp/.mesh/backlog" && { echo "smoke-test: FAIL (non-novelty task wrongly framed with the DEAD-END PROTOCOL clause)"; exit 1; }
  # …and a CONNECTION/gen-pair idea MUST be framed to route its dead-end to mesh-trace ONCE (not a
  # board [idle]). FALSIFIABLE: drop the CONNECTION case clause at the framer (:223) and this FAILs.
  ctmp=$(mktemp -d); mkdir -p "$ctmp/.mesh"
  printf '[ ] CONNECTION (auto novelty): fuse mesh-aaa (x) × mesh-bbb (y). What NEW sense emerges?\n' > "$ctmp/.mesh/ideas-queue"
  : > "$ctmp/.mesh/backlog"
  HOME="$ctmp" MESH_BACKLOG_MIN=3 MESH_GEN_ASSUME_AVAIL=1 bash "$0" --run-with-test-files >/dev/null 2>&1
  grep -q 'DEAD-END PROTOCOL.*mesh-trace "gen-pair-deadend' "$ctmp/.mesh/backlog" || { echo "smoke-test: FAIL (CONNECTION task NOT framed to route dead-ends to mesh-trace)"; rm -rf "$ctmp"; exit 1; }
  rm -rf "$ctmp"
  # PRUNE format-contract (guards the 2026-06-24 framer/prune drift): a backlog line in the framer's
  # EXACT format (:217) whose idea is [x] in the queue MUST be pruned. Exercises the REAL prune at :144
  # end-to-end. FALSIFIABLE: revert the regex to "— do it, leave changes in the tree" and this FAILs.
  ptmp=$(mktemp -d); mkdir -p "$ptmp/.mesh"
  printf '[x] CONNECTION (auto novelty): fuse FOO x BAR. What emerges?\n[ ] real idea to pump the loop\n' > "$ptmp/.mesh/ideas-queue"
  printf 'local:genome|TASK (auto from idea-queue): CONNECTION (auto novelty): fuse FOO x BAR. What emerges? — do it. If you edit a mesh tool, edit the GENOME SOURCE (scripts/<tool>). Do NOT commit (steward lands from the tree).\n' > "$ptmp/.mesh/backlog"
  HOME="$ptmp" MESH_BACKLOG_MIN=3 MESH_GEN_ASSUME_AVAIL=1 bash "$0" --run-with-test-files >/dev/null 2>&1
  grep -q 'fuse FOO x BAR' "$ptmp/.mesh/backlog" && { echo "smoke-test: FAIL ([x] backlog orphan NOT pruned — framer/prune format drift at :144 vs :217)"; rm -rf "$ptmp"; exit 1; }
  rm -rf "$ptmp"
  # Dry-run cap_rotation_saturated — the capability-sweep saturation GATE (used at the call site to
  # suppress redundant CAPABILITY ROTATION tasks). The generation dry-run above never feeds a
  # CAPABILITY ROTATION task, so this gate was untested: a regression silently suppresses ALL
  # capability sweeps (always-saturated → discovery lane stalls) or floods them (never-saturated).
  # FALSIFIABLE — break the per-node coverage loop / freshness / normalization and an assert FAILs.
  # MESH_CAP_HOSTS_TEST injects the reachable-node list so the check is deterministic (no live tailscale).
  ktmp=$(mktemp -d); MESH="$ktmp"; mkdir -p "$ktmp/knowledge"
  fresh_d=$(date -d '-1 day' +%Y-%m-%d); old_d=$(date -d '-40 days' +%Y%m%d)
  : > "$ktmp/knowledge/capability-gaps-nodeA-$fresh_d.md"; : > "$ktmp/knowledge/capability-gaps-nodeB-$fresh_d.md"
  MESH_CAP_HOSTS_TEST="$(printf 'nodeA\nnodeB\n')" cap_rotation_saturated \
    || { echo "smoke-test: FAIL (all reachable nodes have a fresh sweep → must be SATURATED rc0)"; rm -rf "$ktmp"; exit 1; }
  MESH_CAP_HOSTS_TEST="$(printf 'nodeA\nnodeB\nnodeC\n')" cap_rotation_saturated \
    && { echo "smoke-test: FAIL (an uncovered node (nodeC) → must be NOT saturated rc1)"; rm -rf "$ktmp"; exit 1; }
  # THE REGRESSION ITSELF (2026-07-15): a sweep whose CONTENT/name is old but whose mtime is NOW — what a
  # migration cp without -p produces. The mtime gate read these as fresh; the claim gate must not. Both
  # files are touched to this instant, so ONLY the filename date can tell them apart.
  rm -f "$ktmp/knowledge"/*.md
  : > "$ktmp/knowledge/capability-gaps-nodeA-$old_d.md"; : > "$ktmp/knowledge/capability-gaps-nodeB-$old_d.md"
  MESH_CAP_HOSTS_TEST="$(printf 'nodeA\nnodeB\n')" cap_rotation_saturated \
    && { echo "smoke-test: FAIL (June-dated sweeps with a migration-fresh mtime → must be NOT saturated rc1; the gate is reading mtime, not the claim)"; rm -rf "$ktmp"; exit 1; }
  # A hostname carrying its own digits must not have them misread as the sweep date (Redmi-10-YYYYMMDD:
  # an unanchored [0-9]{8} over the stripped name reads '10202606' → a bogus 1020-26-06 → never fresh).
  rm -f "$ktmp/knowledge"/*.md
  : > "$ktmp/knowledge/capability-gaps-Redmi-10-$(date +%Y%m%d).md"
  MESH_CAP_HOSTS_TEST="$(printf 'Redmi 10\n')" cap_rotation_saturated \
    || { echo "smoke-test: FAIL (today's sweep for a digit-bearing hostname → must be SATURATED rc0; date extraction fused the hostname's digits)"; rm -rf "$ktmp"; exit 1; }
  # An undated sweep name claims no recency → not coverage (fail-OPEN).
  rm -f "$ktmp/knowledge"/*.md
  : > "$ktmp/knowledge/capability-gaps-nodeA.md"
  MESH_CAP_HOSTS_TEST="$(printf 'nodeA\n')" cap_rotation_saturated \
    && { echo "smoke-test: FAIL (an undated sweep filename proves no recency → must be NOT saturated rc1)"; rm -rf "$ktmp"; exit 1; }
  rm -f "$ktmp/knowledge"/*.md
  MESH_CAP_HOSTS_TEST="$(printf 'nodeA\n')" cap_rotation_saturated \
    && { echo "smoke-test: FAIL (no fresh sweeps at all → must be NOT saturated rc1)"; rm -rf "$ktmp"; exit 1; }
  rm -rf "$ktmp"
  # STUDY-YIELD ledger + backlog priority (discover→genome [task] 2026-07-20T18:45:31Z).
  # FALSIFIABLE both ways: delete study_yield_refresh → ledger asserts FAIL; revert the pop to bare
  # `grep -m1` → the priority assert FAILs (badfield, the FIFO head, pops instead of goodfield).
  # Both mutations SEEN RED 2026-07-21 (FIFO revert: "yield priority did not beat FIFO").
  ytmp=$(mktemp -d); mkdir -p "$ytmp/.mesh"
  cat > "$ytmp/.mesh/study.log" <<'EOF'
=== study: goodfield (2026-07-18T00:00:00Z) ===
- item  [1pts]  http://x
=== study: badfield (2026-07-18T01:00:00Z) ===
- item  [1pts]  http://x
EOF
  cat > "$ytmp/.mesh/study-bridge.log" <<'EOF'
2026-07-18T00:30:00Z QUEUED field=goodfield ts=2026-07-18T00:00:00Z :: t
2026-07-18T01:30:00Z QUEUED field=badfield ts=2026-07-18T01:00:00Z :: t
2026-07-18T02:30:00Z QUEUED field=badfield ts=2026-07-18T02:00:00Z :: t
2026-07-18T03:30:00Z QUEUED field=badfield ts=2026-07-18T03:00:00Z :: t
EOF
  cat > "$ytmp/.mesh/ideas-queue" <<'EOF'
[x] STUDY(goodfield): prior attempt — done. (source: study 'goodfield' brief 2026-07-18T00:00:00Z)
[ ] STUDY(badfield): new attempt — try it. (source: study 'badfield' brief 2026-07-18T01:00:00Z)
[ ] STUDY(goodfield): new attempt — try it. (source: study 'goodfield' brief 2026-07-18T02:00:00Z)
EOF
  : > "$ytmp/.mesh/backlog"
  HOME="$ytmp" MESH_BACKLOG_MIN=1 MESH_GEN_ASSUME_AVAIL=1 bash "$0" --run-with-test-files >/dev/null 2>&1
  # ledger written with honest per-field counts (goodfield q=1 d=1 → .667; badfield q=3 d=0 → .200)
  grep -q '^goodfield|1|1|1|0\.667$' "$ytmp/.mesh/study-yield" || { echo "smoke-test: FAIL (study-yield ledger missing/wrong goodfield row: $(grep goodfield "$ytmp/.mesh/study-yield" 2>/dev/null || echo none))"; exit 1; }
  grep -q '^badfield|1|3|0|0\.200$' "$ytmp/.mesh/study-yield" || { echo "smoke-test: FAIL (study-yield ledger missing/wrong badfield row)"; exit 1; }
  # MIN=1 → exactly ONE idea popped; demonstrated yield must beat FIFO (badfield is the head)
  grep -q 'STUDY(goodfield): new attempt' "$ytmp/.mesh/backlog" || { echo "smoke-test: FAIL (yield priority did not beat FIFO — proven-productive field lost the research slot)"; exit 1; }
  grep -q 'STUDY(badfield)' "$ytmp/.mesh/backlog" && { echo "smoke-test: FAIL (zero-yield FIFO head popped despite a productive field waiting)"; exit 1; }
  # the [~] flip must hit the PICKED line, not the FIFO head's line number
  grep -q '^\[~\] STUDY(goodfield): new attempt' "$ytmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (queue flip missed the yield-picked line)"; exit 1; }
  grep -q '^\[ \] STUDY(badfield): new attempt' "$ytmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (FIFO-head STUDY line was flipped though the yield pick went elsewhere)"; exit 1; }
  # a non-STUDY FIFO head keeps its slot — the re-rank scopes to the research lane only
  ntmp=$(mktemp -d); mkdir -p "$ntmp/.mesh"
  cp "$ytmp/.mesh/study.log" "$ytmp/.mesh/study-bridge.log" "$ntmp/.mesh/"
  printf '[ ] plain codebase idea first in line\n[ ] STUDY(goodfield): new attempt — try it. (source: study %s brief 2026-07-18T02:00:00Z)\n' "'goodfield'" > "$ntmp/.mesh/ideas-queue"
  : > "$ntmp/.mesh/backlog"
  HOME="$ntmp" MESH_BACKLOG_MIN=1 MESH_GEN_ASSUME_AVAIL=1 bash "$0" --run-with-test-files >/dev/null 2>&1
  grep -q 'plain codebase idea first in line' "$ntmp/.mesh/backlog" || { echo "smoke-test: FAIL (non-STUDY FIFO head lost its slot to a STUDY idea — priority over-reached)"; exit 1; }
  rm -rf "$ntmp"; rm -rf "$ytmp"
  echo "smoke-test: ok (generation dry-run + cap_rotation_saturated gate + study-yield ledger/priority verified: ledger honest counts, yield beats FIFO among STUDY, non-STUDY head untouched)"
  exit 0
fi

if [ "${1:-}" = --run-with-test-files ]; then
  shift
fi
# MIN = number of worker minds (opencode/gemini/codex); lower starves the last in rotation
MIN="${MESH_BACKLOG_MIN:-3}"
ts(){ date -u +%FT%TZ; }
have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
run_generator
