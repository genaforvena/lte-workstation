#!/usr/bin/env bash
# mesh-generate — task-flow GENERATOR (the queue flavor of the stream pattern). The monitor flavor
# (mesh-stream) has an idempotent pull; task-flow CONSUMES: it pops the next OPEN idea from
# ~/.mesh/ideas-queue, frames it as a worker task in ~/.mesh/backlog, and marks the idea in-flight.
# mesh-feed then keystroke-feeds backlog tasks to idle minds. Together:
#   ideas-queue --(mesh-generate)--> backlog --(mesh-feed)--> idle mind --> [done] --> repeat.
# Keeps the backlog topped up so minds never starve. "Ideas come to you" — minds RESPOND to fed work.
#   mesh-generate          top up the backlog from the idea queue if below MIN
#   mesh-generate --test
set -uo pipefail
MESH="$HOME/.mesh"; Q="$MESH/ideas-queue"; BL="$MESH/backlog"; LOG="$MESH/generate.log"; touch "$Q" "$BL"
[ "${1:-}" = --test ] && { echo "smoke-test: ok"; exit 0; }
MIN="${MESH_BACKLOG_MIN:-2}"; ts(){ date -u +%FT%TZ; }
have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || echo 0)
[ "$have" -ge "$MIN" ] && { echo "backlog has $have (>= $MIN) — no generation"; exit 0; }
rr=$(cat "$MESH/.gen-rr" 2>/dev/null || echo 0); added=0
while [ "$have" -lt "$MIN" ]; do
  l=$(grep -m1 -nE '^\[ \]' "$Q" 2>/dev/null || true); [ -z "$l" ] && { echo "$(ts) ideas-queue out of [ ] items — refill from fields-to-mine/PLAN" >> "$LOG"; break; }
  n="${l%%:*}"; text=$(printf '%s' "$l" | sed 's/^[0-9]*:\[ \] *//')
  rr=$((rr+1)); w=$(case $((rr % 3)) in 0) echo local:opencode;; 1) echo local:gemini;; *) echo local:codex;; esac)
  printf '%s|TASK (auto from idea-queue): %s — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands).\n' "$w" "$text" >> "$BL"
  sed -i "${n}s/^\[ \]/[~]/" "$Q"
  echo "$(ts) generated -> $w: ${text:0:60}" >> "$LOG"
  have=$((have+1)); added=$((added+1))
done
echo "$rr" > "$MESH/.gen-rr"
echo "mesh-generate: +$added task(s); backlog now $have; queue open=$(grep -cE '^\[ \]' "$Q")"
