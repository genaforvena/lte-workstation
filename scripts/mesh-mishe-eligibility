#!/usr/bin/env python3
"""Read only, fail closed wake eligibility from Mesh's live authorities."""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


class Unknown(ValueError):
    pass


ROOT = Path(__file__).resolve().parent
NAME = re.compile(r"[a-z][a-z0-9-]{0,63}\Z")
TASK = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}\Z")


def run(name: str, *args: str) -> subprocess.CompletedProcess:
    override = os.environ.get(f"MESH_MISHE_{name.upper()}_BIN")
    defaults = {"staffing": "mesh-staffing", "mind_state": "mesh-mind-state",
                "task": "mesh-task", "pace": "mesh-pace"}
    command = override or str(ROOT / defaults[name])
    try:
        return subprocess.run([command, *args], text=True, capture_output=True, timeout=35)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Unknown(f"{name}-unreadable") from exc


def verdict(status: str, reason: str, channel: str) -> dict:
    return {"channel": channel, "status": status, "reason": reason}


def check(channel: str, kind: str, task_id: str | None = None) -> dict:
    if not NAME.fullmatch(channel) or kind not in {"task", "telemetry", "self-pick"}:
        raise Unknown("invalid-admission-request")
    if (kind == "task") != (task_id is not None) or task_id is not None and not TASK.fullmatch(task_id):
        raise Unknown("missing-or-invalid-exact-task")
    census = run("staffing", "--json")
    if census.returncode != 0:
        raise Unknown("staffing-unreadable")
    try:
        data = json.loads(census.stdout)
        stamp = datetime.fromisoformat(data["observed_at"].replace("Z", "+00:00"))
        if stamp.tzinfo is None or abs((datetime.now(timezone.utc) - stamp).total_seconds()) > 60:
            raise ValueError("stale census")
        rows = [row for row in data["windows"] if row.get("window") == channel]
        if len(rows) != 1:
            raise ValueError("owner absent or duplicated")
        row = rows[0]
        if (type(row.get("live")) is not bool or type(row.get("protected")) is not bool
                or type(row.get("active_holds")) is not int or row["active_holds"] < 0
                or not isinstance(row.get("reason"), str)):
            raise ValueError("invalid census row")
    except (ValueError, TypeError, KeyError, AttributeError) as exc:
        raise Unknown("staffing-invalid") from exc
    if row["protected"] or row["reason"] in {"communication-window", "human-owned", "protected-role-or-substrate"}:
        return verdict("refused", "private-or-protected-domain", channel)
    if not row["live"] or row["active_holds"]:
        return verdict("held", "owner-not-idle", channel)
    if row["reason"] not in {"eligible", "eligible-with-leaks", "already-owned-work", "open-hold"}:
        raise Unknown("staffing-reason-unknown")
    mind = run("mind_state", channel)
    state = mind.stdout.split("\t", 1)[0].strip().split("\n", 1)[0]
    if state == "IDLE" and mind.returncode == 0:
        pass
    elif state in {"WORKING", "NEEDS-INPUT", "WEDGED-INPUT", "RATE-LIMITED"}:
        return verdict("held", "mind-busy", channel)
    else:
        raise Unknown("mind-state-unknown")
    if kind == "task":
        task = run("task", "check", "dispatch", task_id, channel)
        if task.returncode == 2:
            return verdict("held", "exact-task-ineligible", channel)
        if task.returncode != 0:
            raise Unknown("exact-task-unreadable")
    else:
        stamp_path = Path(os.environ.get("MESH_WAKE_STAMP_DIR", str(Path.home() / ".mesh"))) / f".wake-stamp-{channel}"
        gap = os.environ.get("MESH_WAKE_REFRACTORY", "1800")
        if not gap.isdecimal() or int(gap) > 86400:
            raise Unknown("invalid-refractory")
        try:
            last = stamp_path.stat().st_mtime
        except FileNotFoundError:
            last = 0
        except OSError as exc:
            raise Unknown("refractory-unreadable") from exc
        age = time.time() - last
        if age < -5:
            raise Unknown("refractory-clock-inconsistent")
        if age < int(gap):
            return verdict("held", "refractory", channel)
    if kind == "self-pick":
        gap = os.environ.get("MESH_SELF_PICK_INTERVAL", "3600")
        if not gap.isdecimal() or int(gap) < 1 or int(gap) > 86400:
            raise Unknown("invalid-pace-gap")
        pace = run("pace", "--check", f"self-pick-{channel}", gap)
        if pace.returncode == 1:
            return verdict("held", "pace", channel)
        if pace.returncode != 0:
            raise Unknown("pace-unreadable")
    return verdict("eligible", "live-evidence-admitted", channel)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("channel")
    parser.add_argument("kind", choices=("task", "telemetry", "self-pick"))
    parser.add_argument("task_id", nargs="?")
    args = parser.parse_args()
    try:
        result = check(args.channel, args.kind, args.task_id)
    except Unknown as exc:
        result = verdict("unknown", str(exc), args.channel)
    print(json.dumps(result, sort_keys=True))
    return {"eligible": 0, "held": 1, "refused": 1, "unknown": 2}[result["status"]]


if __name__ == "__main__":
    raise SystemExit(main())
