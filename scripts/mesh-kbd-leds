#!/usr/bin/env bash
# orphan-ok: on-demand local sense — keyboard lock LEDs are a real /sys signal this node can read
# when present, but there is no cron consumer for it yet.
# mesh-kbd-leds — keyboard lock-indicator sense (capslock / numlock / scrolllock).
#
# Reads /sys/class/leds/*{capslock,numlock,scrolllock}/brightness and reports whether any lock LED
# is lit. Honest contract: if no readable lock LED exists, exit 2 and never fake a reading.
#
#   mesh-kbd-leds          one-line lock LED state
#   mesh-kbd-leds --json   machine-readable JSON
#   mesh-kbd-leds --test   fixture-backed smoke test + live-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

ROOT="${MESH_LED_ROOT:-/sys/class/leds}"

discover_leds() {
  local kind d
  shopt -s nullglob
  for kind in capslock numlock scrolllock; do
    for d in "$ROOT"/*"$kind"*/brightness "$ROOT"/*::"$kind"/brightness "$ROOT"/*"$kind"/brightness; do
      [ -r "$d" ] || continue
      printf '%s\n' "$d"
    done
  done
  shopt -u nullglob
}

read_int() {
  local f="$1" v
  v="$(cat "$f" 2>/dev/null | tr -d '[:space:]')"
  case "$v" in ''|*[!0-9]*) return 1;; esac
  printf '%s' "$v"
}

classify() {
  local cap="${1:-}" num="${2:-}" scr="${3:-}"
  case "$cap$num$scr" in ''|*[!0-9]*) return 1;; esac
  if [ "$cap" -gt 0 ] || [ "$num" -gt 0 ] || [ "$scr" -gt 0 ]; then
    echo ACTIVE
  else
    echo IDLE
  fi
}

if [ "${1:-}" = --test ]; then
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/input3::capslock" "$td/input3::numlock" "$td/input3::scrolllock"
  printf '0\n' > "$td/input3::capslock/brightness"
  printf '1\n' > "$td/input3::numlock/brightness"
  printf '0\n' > "$td/input3::scrolllock/brightness"
  out="$(MESH_LED_ROOT="$td" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture json read failed)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"state":"ACTIVE"' || {
    echo "smoke-test: FAIL (fixture should be ACTIVE: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"capslock":0' || {
    echo "smoke-test: FAIL (fixture capslock mismatch: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"numlock":1' || {
    echo "smoke-test: FAIL (fixture numlock mismatch: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"scrolllock":0' || {
    echo "smoke-test: FAIL (fixture scrolllock mismatch: $out)"; exit 1;
  }
  printf '0\n' > "$td/input3::numlock/brightness"
  out2="$(MESH_LED_ROOT="$td" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture idle read failed)"; exit 1;
  }
  printf '%s\n' "$out2" | grep -q '"state":"IDLE"' || {
    echo "smoke-test: FAIL (fixture should be IDLE: $out2)"; exit 1;
  }
  live_leds="$(discover_leds)"
  [ -n "$live_leds" ] || { echo "smoke-test: n/a (no readable keyboard lock LEDs on this node)"; exit 2; }
  live="$("$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (live read failed)"; exit 1; }
  printf '%s\n' "$live" | grep -q '"state":"' || { echo "smoke-test: FAIL (live json malformed: $live)"; exit 1; }
  echo "smoke-test: ok (fixture ACTIVE/IDLE + live lock-LED read)"
  exit 0
fi

JSON=0
[ "${1:-}" = --json ] && JSON=1

caps="" num="" scr=""
cap_src="" num_src="" scr_src=""
for f in $(discover_leds); do
  base="$(basename "$(dirname "$f")")"
  val="$(read_int "$f" 2>/dev/null || true)" || continue
  case "$base" in
    *capslock*)  [ -z "$caps" ] && { caps="$val"; cap_src="$f"; } ;;
    *numlock*)   [ -z "$num" ]  && { num="$val";  num_src="$f"; } ;;
    *scrolllock*) [ -z "$scr" ] && { scr="$val";  scr_src="$f"; } ;;
  esac
done

[ -n "$caps$num$scr" ] || { echo "kbd-leds: UNREACHABLE — no readable keyboard lock LEDs" >&2; exit 2; }
state="$(classify "${caps:-0}" "${num:-0}" "${scr:-0}")" || {
  echo "kbd-leds: UNREACHABLE — unreadable lock LED value" >&2
  exit 2
}
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
host="$(hostname)"

if [ "$JSON" = 1 ]; then
  printf '{"state":"%s","capslock":%s,"numlock":%s,"scrolllock":%s,"sources":{"capslock":"%s","numlock":"%s","scrolllock":"%s"},"ts":"%s"}\n' \
    "$state" "${caps:-null}" "${num:-null}" "${scr:-null}" "$cap_src" "$num_src" "$scr_src" "$ts"
else
  printf '[kbd-leds] %s — capslock=%s numlock=%s scrolllock=%s @ %s %s\n' \
    "$state" "${caps:-?}" "${num:-?}" "${scr:-?}" "$host" "$ts"
fi
