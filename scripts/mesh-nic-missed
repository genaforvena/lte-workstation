#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# mesh-nic-missed — hardware NIC receive-miss sense.
# Reads the driver's rx_missed counter through ethtool -S on a physical interface.
# This is below the generic packet/drop counters: it exposes frames the NIC could not
# deliver because its receive ring/buffer missed them. No readable driver counter means
# the organ is unreachable; the tool exits 2 and never calls that CLEAN.
#
#   mesh-nic-missed          one live one-second delta
#   mesh-nic-missed --test   fixture parser + REAL ethtool read gate
#
# Exit 0 = a live delta was assessed; exit 2 = no physical interface exposes rx_missed.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

STATE="${MESH_NIC_MISSED_STATE:-$HOME/.mesh/.nic-missed.state}"
SYSNET="${MESH_NIC_MISSED_SYSNET:-/sys/class/net}"

parse_stats() {
  awk -F: '
    $1 ~ /^[[:space:]]*rx_missed(_errors)?[[:space:]]*$/ {
      v=$2; gsub(/[[:space:]]/, "", v)
      if (v ~ /^[0-9]+$/) { print v; exit }
    }
  '
}

physical_iface() {
  local d ifn raw v
  for d in "$SYSNET"/*/; do
    [ -e "$d/device" ] || continue
    ifn="${d%/}"; ifn="${ifn##*/}"
    raw="$(timeout 5 ethtool -S "$ifn" 2>/dev/null || true)"
    v="$(printf '%s\n' "$raw" | parse_stats)"
    case "$v" in ''|*[!0-9]*) continue ;; esac
    printf '%s\t%s\n' "$ifn" "$v"
    return 0
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  fixture=$'     rx_missed: 17\n     tx_packets: 42\n'
  [ "$(printf '%s' "$fixture" | parse_stats)" = 17 ] || {
    echo "smoke-test: FAIL (rx_missed parser)"; exit 1;
  }
  live="$(physical_iface 2>/dev/null || true)"
  if [ -z "$live" ]; then
    echo "smoke-test: n/a (no physical ethtool rx_missed counter)"; exit 2
  fi
  iface="${live%%$'\t'*}"; value="${live#*$'\t'}"
  case "$value" in ''|*[!0-9]*) echo "smoke-test: FAIL (live counter malformed: $live)"; exit 1 ;; esac
  echo "smoke-test: ok (fixture parser + REAL ethtool read: $iface rx_missed=$value)"
  exit 0
fi

first="$(physical_iface 2>/dev/null || true)"
[ -n "$first" ] || { echo "nic-missed: UNREACHABLE (no physical ethtool rx_missed counter)" >&2; exit 2; }
iface="${first%%$'\t'*}"; before="${first#*$'\t'}"
sleep "${MESH_NIC_MISSED_WINDOW:-1}"
second="$(physical_iface 2>/dev/null || true)"
[ -n "$second" ] || { echo "nic-missed: UNREACHABLE (counter disappeared during sample)" >&2; exit 2; }
iface2="${second%%$'\t'*}"; after="${second#*$'\t'}"
[ "$iface" = "$iface2" ] || { echo "nic-missed: UNREACHABLE (physical interface changed during sample)" >&2; exit 2; }
[ "$after" -ge "$before" ] 2>/dev/null || { echo "nic-missed: UNREACHABLE (counter reset during sample)" >&2; exit 2; }
delta=$((after - before))
label=CLEAN; [ "$delta" -gt 0 ] && label=MISSED
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || { echo "nic-missed: cannot create state directory" >&2; exit 1; }
printf '%s|interface=%s|rx_missed_delta=%s|counter=%s|ts=%s\n' "$label" "$iface" "$delta" "$after" "$ts" > "$STATE" || exit 1
printf '[nic-missed] %s — interface=%s rx_missed_delta=%s counter=%s window=%ss @ %s\n' "$label" "$iface" "$delta" "$after" "${MESH_NIC_MISSED_WINDOW:-1}" "$ts"
