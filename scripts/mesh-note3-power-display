#!/usr/bin/env bash
# orphan-ok: on-demand sense — no scheduled consumer yet; read-only ADB probe.
# mesh-note3-power-display — Note 3 PowerManager/display-state sense.
#
# Reads one live `dumpsys power` snapshot and publishes ON, OFF, or UNKNOWN.  A snapshot is
# evidence only while its capture age is within MESH_NOTE3_POWER_DISPLAY_MAX_AGE (default 300s).
# Transport failure, missing/contradictory fields, and stale fixture data are UNKNOWN; no cached
# value is promoted to a current state and this tool never writes a state file or actuates.
#
#   mesh-note3-power-display          human-readable read
#   mesh-note3-power-display --json   machine-readable read
#   mesh-note3-power-display --test   fixture/parser checks + live ADB read gate
#
# Exit: 0 = ON/OFF assessed · 2 = UNKNOWN/unreachable (honest n/a) · 1 = test/usage failure.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-local}}"
SER="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
MAX_AGE="${MESH_NOTE3_POWER_DISPLAY_MAX_AGE:-300}"

node_dump() {
  if [ "$NODE" = local ]; then
    timeout 15 adb -s "$SER" shell 'dumpsys power' 2>/dev/null | tr -d '\r'
  else
    timeout 25 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$NODE" "timeout 15 adb -s '$SER' shell 'dumpsys power'" </dev/null 2>/dev/null | tr -d '\r'
  fi
}

# parse_dump <dumpsys text> -> wakefulness|interactive|display_ready.  Required fields are
# deliberately exact: a partial PowerManager dump must not become a plausible OFF.
parse_dump() {
  awk '
    /^[[:space:]]*mWakefulness=/ {sub(/^[[:space:]]*mWakefulness=/,"",$0); w=$0}
    /^[[:space:]]*mInteractive=/ {sub(/^[[:space:]]*mInteractive=/,"",$0); i=$0}
    /^[[:space:]]*mDisplayReady=/ {sub(/^[[:space:]]*mDisplayReady=/,"",$0); d=$0}
    END { if (w!="" && i!="" && d!="") print w "|" i "|" d }
  '
}

classify() {
  local w="$1" i="$2" d="$3"
  if [ "$i" = true ] && [ "$d" = true ] && [ "$w" = Awake ]; then echo ON
  elif [ "$i" = false ] && [ "$d" = true ] && [[ "$w" =~ ^(Asleep|Dozing)$ ]]; then echo OFF
  else echo UNKNOWN
  fi
}

age_seconds() {
  local stamp="$1" now
  now=$(date -u +%s)
  [ -n "$stamp" ] || { echo 0; return; }
  local then
  then=$(date -u -d "$stamp" +%s 2>/dev/null) || { echo invalid; return; }
  [ "$then" -le "$now" ] || { echo invalid; return; }
  echo $((now - then))
}

if [ "${1:-}" = --test ]; then
  _f=0
  _fixture=$'mWakefulness=Awake\nmInteractive=true\nmDisplayReady=true'
  _p="$(printf '%s\n' "$_fixture" | parse_dump)"
  [ "$_p" = 'Awake|true|true' ] || { echo "FAIL parse valid dump: $_p"; _f=1; }
  [ "$(classify Awake true true)" = ON ] || { echo 'FAIL Awake/interactive/ready -> ON'; _f=1; }
  [ "$(classify Asleep false true)" = OFF ] || { echo 'FAIL Asleep/noninteractive/ready -> OFF'; _f=1; }
  [ "$(classify Awake false true)" = UNKNOWN ] || { echo 'FAIL contradictory fields -> UNKNOWN'; _f=1; }
  [ -z "$(printf 'mWakefulness=Awake\nmInteractive=true' | parse_dump)" ] || { echo 'FAIL partial dump accepted'; _f=1; }
  [ "$(age_seconds '2026-09-09T13:55:01Z')" != invalid ] || { echo 'FAIL valid timestamp rejected'; _f=1; }
  [ "$(age_seconds 'not-a-time')" = invalid ] || { echo 'FAIL malformed timestamp accepted'; _f=1; }
  [ "$_f" = 0 ] || { echo 'smoke-test: FAIL (fixture/parser contract)'; exit 1; }

  if [ -n "${MESH_NOTE3_POWER_DISPLAY_DUMP_OVERRIDE:-}" ]; then
    _live="$MESH_NOTE3_POWER_DISPLAY_DUMP_OVERRIDE"
  else
    _live="$(node_dump)"
  fi
  _p="$(printf '%s\n' "$_live" | parse_dump)"
  if [ -z "$_p" ]; then
    echo 'smoke-test: n/a (Note3/ADB unreachable or PowerManager fields absent)'; exit 2
  fi
  IFS='|' read -r _w _i _d <<<"$_p"
  _v="$(classify "$_w" "$_i" "$_d")"
  [ "$_v" != UNKNOWN ] || { echo "smoke-test: FAIL (live fields contradictory: $_p)"; exit 1; }
  echo "smoke-test: ok (parse/classify/freshness fixtures + LIVE adb read $_v $_p)"
  exit 0
fi

_capture_utc="${MESH_NOTE3_POWER_DISPLAY_CAPTURE_UTC:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
if [ -n "${MESH_NOTE3_POWER_DISPLAY_DUMP_OVERRIDE:-}" ]; then
  _dump="$MESH_NOTE3_POWER_DISPLAY_DUMP_OVERRIDE"
else
  _dump="$(node_dump)"
fi
_p="$(printf '%s\n' "$_dump" | parse_dump)"
_age="$(age_seconds "$_capture_utc")"
_reason="fresh"
if [ -z "$_p" ]; then _v=UNKNOWN; _reason=unreachable-or-malformed
elif [ "$_age" = invalid ]; then _v=UNKNOWN; _reason=stale
elif [ "$_age" -gt "$MAX_AGE" ]; then _v=UNKNOWN; _reason=stale
else
  IFS='|' read -r _w _i _d <<<"$_p"
  _v="$(classify "$_w" "$_i" "$_d")"
  [ "$_v" = UNKNOWN ] && _reason=contradictory-fields
fi

if [ "${1:-}" = --json ]; then
  if [ -n "$_p" ]; then
    IFS='|' read -r _w _i _d <<<"$_p"
    printf '{"verdict":"%s","wakefulness":"%s","interactive":%s,"display_ready":%s,"age_seconds":%s,"capture_utc":"%s","reason":"%s"}\n' \
      "$_v" "$_w" "$_i" "$_d" "${_age:-null}" "$_capture_utc" "$_reason"
  else
    printf '{"verdict":"UNKNOWN","age_seconds":%s,"capture_utc":"%s","reason":"%s"}\n' "${_age:-null}" "$_capture_utc" "$_reason"
  fi
else
  printf 'note3-power-display: %s (age=%ss capture=%s reason=%s)\n' "$_v" "${_age:-?}" "$_capture_utc" "$_reason"
fi
if [ "$_v" = ON ] || [ "$_v" = OFF ]; then
  exit 0
fi
exit 2
