#!/usr/bin/env bash
# mesh-node-power — local power supply state: AC vs battery, charge %, power draw.
# Source: /sys/class/power_supply/* (kernel power supply class — always local, no SSH).
# Exit 2: node has no battery (VM, desktop — no battery sense here).
# Exit 0: real reading from sysfs.
#
# Labels:
#   AC-FULL      — on AC, battery 100 %
#   AC-CONSERVE  — on AC, "Not charging" below full BECAUSE the EC conservation cap holds it
#                  (fresh mesh-conservation .conservation-state = on; stale/off/unknown → AC-FULL,
#                  the pre-existing collapse — honest-degrade, never guesses the policy)
#   AC-CHARGING  — on AC, battery charging (< 100 %)
#   AC-POWER     — on AC, battery state unknown (driver limitation)
#   DISCHARGING  — on battery power (normal laptop unplugged)
#   LOW-BATTERY  — on battery, < 20 %
#   CRITICAL     — on battery, < 5 %
#
#   mesh-node-power           one-line state
#   mesh-node-power --json    machine-readable JSON
#   mesh-node-power --test    smoke test
set -uo pipefail

_r() { cat "$1" 2>/dev/null || true; }

# Conservation-policy disambiguator (consumes mesh-conservation's .conservation-state): the EC's
# charge-policy cap holds a plugged battery at ~55-60% with kernel status "Not charging" — that is
# NOT full and NOT a charger fault, it is the battery-longevity policy working. Without this input
# the Full|"Not charging" collapse below would render "AC-FULL 58%" (label contradicts capacity).
CONS_STATE="${MESH_CONSERVATION_STATE:-$HOME/.mesh/.conservation-state}"
CONS_FRESH="${MESH_CONSERVATION_FRESH:-1800}"   # producer cadence */10 — 3x = stale, stop trusting it

# Calibrated cutoffs resolve ledger (uxn threshold-ledger row power-charge) > inline fallback.
# (Same charge-% axis as mesh-battery's battery-charge row with DIFFERENT edges 5/20 vs 15/25
# — the ledger keeps the split visible; unifying is an operator calibration call.)
_ledger_const() { # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
NP_CRIT="$(_ledger_const power-charge crit 5)"
NP_LOW="$(_ledger_const power-charge low 20)"

conservation_policy() {  # -> on|off|unknown (missing/stale/raw artifact = unknown — honest-degrade)
  [ -f "$CONS_STATE" ] || { echo unknown; return; }
  [ $(( $(date +%s) - $(stat -c %Y "$CONS_STATE" 2>/dev/null || echo 0) )) -le "$CONS_FRESH" ] \
    || { echo unknown; return; }
  case "$(head -1 "$CONS_STATE" 2>/dev/null | tr -d '[:space:]')" in
    on) echo on;; off) echo off;; *) echo unknown;;
  esac
}

conserve_held() {  # <status> <cap> -> 0 iff the conservation cap explains "Not charging" below full
  [ "$1" = "Not charging" ] || return 1
  [ "$2" -lt 95 ] 2>/dev/null || return 1   # a ~full battery is FULL whatever the policy says
  [ "$(conservation_policy)" = on ]
}

# Sysfs root is parameterised so --test can drive a FIXTURE battery: this node has no battery at
# all (/sys/class/power_supply is empty), so without it every wear assertion below would be
# unreachable here and the gate would assert nothing on the machine that runs it.
PS_ROOT="${MESH_POWER_SYSFS:-/sys/class/power_supply}"

# Discover entries by kernel type — name (BAT0, ADP0, etc.) varies by driver
BAT=""; AC=""
for d in "$PS_ROOT"/*/; do
  [ -d "$d" ] || continue
  t="$(_r "${d}type")"
  case "$t" in
    Battery) [ -z "$BAT" ] && BAT="${d%/}";;
    Mains)   [ -z "$AC"  ] && AC="${d%/}";;
  esac
done

[ "${1:-}" = --consts ] && {
  # observable artifact of the resolution (ledger > inline), same path the label derivation takes
  echo "crit=$NP_CRIT low=$NP_LOW"
  exit 0
}

[ "${1:-}" = --test ] && {
  [ -d "$PS_ROOT" ] || { echo "smoke-test: FAIL (no $PS_ROOT)"; exit 1; }
  # ledger resolution (ledger > inline) — sits ABOVE the no-battery early return so it runs everywhere
  _led="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn/threshold-ledger"
  if [ -f "$_led" ]; then
    _lt="$(mktemp -d)"
    sed 's/crit=5 /crit=6 /' "$_led" > "$_lt/recal"
    _c="$(MESH_THRESHOLD_LEDGER="$_lt/recal" bash "$0" --consts)"
    [ "$_c" = "crit=6 low=20" ] || { echo "smoke-test: FAIL (recal ledger crit=6 must reach --consts, got '$_c')"; rm -rf "$_lt"; exit 1; }
    _c="$(MESH_THRESHOLD_LEDGER="$_lt/absent" bash "$0" --consts)"
    [ "$_c" = "crit=5 low=20" ] || { echo "smoke-test: FAIL (absent ledger must fall back inline, got '$_c')"; rm -rf "$_lt"; exit 1; }
    rm -rf "$_lt"
  fi
  # --- THE WEAR AXIS, driven on a FIXTURE battery ------------------------------------------------
  # This node has no battery, so without MESH_POWER_SYSFS every assertion here would be unreachable
  # on the machine that runs the gate — a test that only ever runs on someone else's hardware is a
  # test nobody has seen go red.
  _mkbat() { # <dir> <flavour: charge|energy> <now> <full> <design|-> ; design '-' = omit the file
    mkdir -p "$1/BAT0" "$1/AC0"
    printf 'Battery\n' > "$1/BAT0/type"; printf 'Mains\n' > "$1/AC0/type"; printf '1\n' > "$1/AC0/online"
    printf 'Full\n' > "$1/BAT0/status"
    # capacity is what the OLD code read, and it is a percentage of the LEARNED full — so the
    # fixture writes the number a real EC would write on a worn battery: 100.
    printf '100\n' > "$1/BAT0/capacity"
    printf '%s\n' "$3" > "$1/BAT0/${2}_now"; printf '%s\n' "$4" > "$1/BAT0/${2}_full"
    [ "$5" = "-" ] || printf '%s\n' "$5" > "$1/BAT0/${2}_full_design"
  }
  _fx="$(mktemp -d)"
  # (w1) THE BOILING FROG ITSELF: a battery at HALF its design capacity, reporting 100%.
  _mkbat "$_fx/worn" charge 2000000 2000000 4000000
  _j="$(MESH_POWER_SYSFS="$_fx/worn" bash "$0" --json 2>/dev/null)"
  case "$_j" in *'"capacity":100'*) : ;; *) echo "smoke-test: FAIL (wear fixture: the legacy axis should still read 100 — if it does not, this arm is not measuring the blindness: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  case "$_j" in *'"battery_health_pct":50'*) : ;; *) echo "smoke-test: FAIL (wear: a battery at half its design capacity did not report health 50: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  case "$_j" in *'"capacity_design_pct":50'*) : ;; *) echo "smoke-test: FAIL (wear: design-referenced charge should be 50 while capacity says 100: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  _t="$(MESH_POWER_SYSFS="$_fx/worn" bash "$0" 2>/dev/null)"
  case "$_t" in *"health 50% of design"*) : ;; *) echo "smoke-test: FAIL (wear: the text line hides the wear term: $_t)"; rm -rf "$_fx"; exit 1 ;; esac
  # (w2) control arm — an UNWORN battery must read 100, or 'health 50' above proves nothing.
  _mkbat "$_fx/new" charge 4000000 4000000 4000000
  _j="$(MESH_POWER_SYSFS="$_fx/new" bash "$0" --json 2>/dev/null)"
  case "$_j" in *'"battery_health_pct":100'*) : ;; *) echo "smoke-test: FAIL (wear control: an unworn battery must read health 100: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  # (w3) THE SILENT-FALLBACK GUARD: a driver exposing NO design capacity must render null, never
  #      100. An absence rendered as perfect health is the same failure this whole axis exists for.
  _mkbat "$_fx/nodesign" charge 2000000 2000000 -
  _j="$(MESH_POWER_SYSFS="$_fx/nodesign" bash "$0" --json 2>/dev/null)"
  case "$_j" in *'"battery_health_pct":null'*) : ;; *) echo "smoke-test: FAIL (wear: absent design capacity must render null — a missing measurement must not read as a healthy battery: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  _t="$(MESH_POWER_SYSFS="$_fx/nodesign" bash "$0" 2>/dev/null)"
  case "$_t" in *"wear: na"*) : ;; *) echo "smoke-test: FAIL (wear: the text line must SAY the wear is unmeasured, not omit it silently: $_t)"; rm -rf "$_fx"; exit 1 ;; esac
  # (w4) the µWh flavour — plenty of drivers expose energy_* and no charge_* at all.
  _mkbat "$_fx/wh" energy 15000000 20000000 50000000
  _j="$(MESH_POWER_SYSFS="$_fx/wh" bash "$0" --json 2>/dev/null)"
  case "$_j" in *'"battery_health_pct":40'*) : ;; *) echo "smoke-test: FAIL (wear: energy_* drivers must compute health too: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  case "$_j" in *'"capacity_design_pct":30'*) : ;; *) echo "smoke-test: FAIL (wear: energy_* design-referenced charge wrong: $_j)"; rm -rf "$_fx"; exit 1 ;; esac
  rm -rf "$_fx"

  out="$("$0" 2>/dev/null)"; rc=$?
  [ "$rc" = 2 ] && { echo "smoke-test: ok (no battery on this node — exit 2 correct; the WEAR fixtures above still ran and are the real assertions here: a half-worn battery reads capacity 100 while health/design-referenced charge read 50, an unworn control reads 100, an absent design capacity renders null not 100, and energy_* drivers compute it too)"; exit 0; }
  printf '%s' "$out" | grep -qE 'AC-FULL|AC-CONSERVE|AC-CHARGING|AC-POWER|DISCHARGING|LOW-BATTERY|CRITICAL' \
    || { echo "smoke-test: FAIL (unexpected: ${out:0:100})"; exit 1; }
  # conservation disambiguator (hermetic — sandbox the .conservation-state input): "Not charging"
  # below full flips to AC-CONSERVE ONLY on a FRESH 'on'; off / stale / near-full all falsify it.
  _cd="$(mktemp -d)"; CONS_STATE="$_cd/cons"
  printf 'on\n' > "$CONS_STATE"
  conserve_held "Not charging" 58 || { echo "smoke-test: FAIL (fresh on + 58% must claim AC-CONSERVE)"; rm -rf "$_cd"; exit 1; }
  conserve_held "Not charging" 100 && { echo "smoke-test: FAIL (a full battery is FULL whatever the policy)"; rm -rf "$_cd"; exit 1; }
  conserve_held "Full" 58 && { echo "smoke-test: FAIL (only 'Not charging' can be policy-held)"; rm -rf "$_cd"; exit 1; }
  printf 'off\n' > "$CONS_STATE"
  conserve_held "Not charging" 58 && { echo "smoke-test: FAIL (policy off must not claim AC-CONSERVE)"; rm -rf "$_cd"; exit 1; }
  printf 'on\n' > "$CONS_STATE"; touch -d '2 hours ago' "$CONS_STATE"
  conserve_held "Not charging" 58 && { echo "smoke-test: FAIL (STALE 'on' must not claim the policy — honest-degrade)"; rm -rf "$_cd"; exit 1; }
  rm -rf "$_cd"
  echo "smoke-test: ok ($out; conservation gate on/off/stale/full falsified; WEAR axis driven on fixtures — a half-worn battery still reads capacity 100 while health/design-referenced charge read 50, an unworn control reads 100, an absent design capacity renders null not 100, and energy_* drivers compute it too)"
  exit 0
}

[ -n "$BAT" ] || { printf 'no battery\n' >&2; exit 2; }

status="$(_r "$BAT/status")"    # Charging / Discharging / Full / Unknown / Not charging
capacity="$(_r "$BAT/capacity")" # 0-100

[ -n "$capacity" ] || { printf 'battery: capacity file missing\n' >&2; exit 2; }

# Power draw: energy_now/power_now (µWh/µW); fallback charge_now × voltage_now
voltage_now="$(_r "$BAT/voltage_now")"
energy_now="$(_r  "$BAT/energy_now")"
power_now="$(_r   "$BAT/power_now")"

if [ -z "$energy_now" ] || [ "${energy_now:-0}" = 0 ]; then
  charge_now="$(_r "$BAT/charge_now")"
  if [ -n "$charge_now" ] && [ -n "$voltage_now" ] && [ "${voltage_now:-0}" -gt 0 ]; then
    energy_now="$(awk -v c="$charge_now" -v v="$voltage_now" 'BEGIN{printf "%d", c*v/1000000}')"
  fi
fi
if [ -z "$power_now" ] || [ "${power_now:-0}" = 0 ]; then
  current_now="$(_r "$BAT/current_now")"
  current_now="${current_now#-}"  # abs value (sign varies by driver)
  if [ -n "$current_now" ] && [ "${current_now:-0}" -gt 0 ] && \
     [ -n "$voltage_now" ] && [ "${voltage_now:-0}" -gt 0 ]; then
    power_now="$(awk -v i="$current_now" -v v="$voltage_now" 'BEGIN{printf "%d", i*v/1000000}')"
  fi
fi

# --- THE UN-ADAPTED REFERENCE (battery wear) ----------------------------------------------------
# `capacity` is a percentage of charge_full / energy_full, and the kernel defines those as the "last
# remembered value of charge when battery became full ... at given conditions (temperature, age)" —
# "real thresholds, not design values" (Documentation/power/power_supply_class.rst). The reference
# MOVES WITH THE WEAR. So a battery at half its design capacity still reads 100%, and this organ —
# which read `capacity` and nothing else — was not slow to notice degradation, it was structurally
# incapable of noticing it. Both thresholds ride that same self-normalising axis: CRITICAL <5% and
# LOW-BATTERY <20% are 5% and 20% of a POOL THAT SHRINKS, so on a half-worn battery the LOW edge
# fires at half the runtime it was calibrated for. The tool already carried the honest absolute axis
# next door — time_remaining is energy_now/power_now — which is what made the contradiction visible.
#
# Hong, "The Boiling Frog Threshold: Criticality and Blindness in World Model-Based Anomaly
# Detection Under Gradual Drift", arXiv:2603.08455 (2026-03-09), measures this failure in
# prediction-error detectors: gradual drift is absorbed into the noise floor the world model itself
# learns, and below a critical rate ε* nothing is ever detected. Here the absorption is not
# statistical but EXACT — the normaliser IS the wear — so there is no ε* to be under: NO drift rate
# is detectable, however fast. The remedy the paper's framing implies is to keep an UN-ADAPTED
# channel beside the adapted one and publish the DIVERGENCE, because the divergence is the drift.
#
# Absent design capacity renders `na` and NEVER 100: a driver that exposes no design value would
# otherwise report a worn battery as perfectly healthy, which is the same failure one ring in.
# NOTE: no `set --` here. An earlier cut iterated field-name triples with `set -- $_pair`, which
# reassigns the SCRIPT'S OWN argv — by the time the render below tested "${1:-}" = --json, $1 was
# a sysfs field name and --json rendered as plain text. A loop variable is not the only thing
# `set --` touches.
full=""; full_design=""; now_abs=""
for _pfx in charge energy; do
  _f="$(_r "$BAT/${_pfx}_full")"; _fd="$(_r "$BAT/${_pfx}_full_design")"; _n="$(_r "$BAT/${_pfx}_now")"
  case "${_f:-}${_fd:-}" in ''|*[!0-9]*) continue ;; esac
  [ "${_f:-0}" -gt 0 ] 2>/dev/null && [ "${_fd:-0}" -gt 0 ] 2>/dev/null || continue
  full="$_f"; full_design="$_fd"; now_abs="$_n"; break
done
health_pct=""; cap_design=""
if [ -n "$full" ] && [ -n "$full_design" ]; then
  health_pct="$(awk -v f="$full" -v d="$full_design" 'BEGIN{printf "%d", (f*100)/d}')"
  [ -n "${now_abs:-}" ] && [ "${now_abs:-0}" -gt 0 ] 2>/dev/null \
    && cap_design="$(awk -v n="$now_abs" -v d="$full_design" 'BEGIN{printf "%d", (n*100)/d}')"
fi

ac_online=""
[ -n "$AC" ] && ac_online="$(_r "$AC/online")"

# Derive label (kernel "Not charging" = plugged in at 100% on some drivers → treat as Full)
cap="${capacity:-0}"
label="DISCHARGING"
time_h=""
case "${status:-}" in
  Full|"Not charging")
    label="AC-FULL"
    conserve_held "${status:-}" "$cap" && label="AC-CONSERVE";;
  Charging)
    label="AC-CHARGING";;
  Discharging)
    if   [ "$cap" -lt "$NP_CRIT" ] 2>/dev/null; then label="CRITICAL"
    elif [ "$cap" -lt "$NP_LOW"  ] 2>/dev/null; then label="LOW-BATTERY"
    else                                              label="DISCHARGING"; fi
    # Time remaining = energy_now (µWh) / power_now (µW) = hours
    if [ -n "${energy_now:-}" ] && [ "${energy_now:-0}" -gt 0 ] && \
       [ -n "${power_now:-}"  ] && [ "${power_now:-0}"  -gt 0 ]; then
      time_h="$(awk -v e="$energy_now" -v p="$power_now" 'BEGIN{
        h=e/p; printf "%dh%02dm", int(h), int((h-int(h))*60)
      }')"
    fi
    ;;
  *) label="AC-POWER";;
esac

power_w=""
if [ -n "${power_now:-}" ] && [ "${power_now:-0}" -gt 0 ]; then
  power_w="$(awk -v p="$power_now" 'BEGIN{printf "%.1f", p/1000000}')W"
fi

energy_wh=""
if [ -n "${energy_now:-}" ] && [ "${energy_now:-0}" -gt 0 ]; then
  energy_wh="$(awk -v e="$energy_now" 'BEGIN{printf "%.1f", e/1000000}')Wh"
fi

TS="$(date -u +%FT%TZ)"

if [ "${1:-}" = --json ]; then
  ac_val="null"
  [ "${ac_online:-}" = 1 ] && ac_val="true"
  [ "${ac_online:-}" = 0 ] && ac_val="false"
  pw_json="null"; [ -n "${power_w:-}" ]  && pw_json="\"$power_w\""
  tr_json="null"; [ -n "${time_h:-}" ]   && tr_json="\"$time_h\""
  ew_json="null"; [ -n "${energy_wh:-}" ] && ew_json="\"$energy_wh\""
  cycle="$(_r "$BAT/cycle_count")"
  cycle_json="null"; [ -n "${cycle:-}" ] && cycle_json="$cycle"
  hp_json="null"; [ -n "${health_pct:-}" ] && hp_json="$health_pct"
  cd_json="null"; [ -n "${cap_design:-}" ] && cd_json="$cap_design"
  printf '{"label":"%s","status":"%s","capacity":%s,"battery_health_pct":%s,"capacity_design_pct":%s,"power_w":%s,"energy_remaining":%s,"time_remaining":%s,"ac_online":%s,"cycle_count":%s,"conservation":"%s","ts":"%s"}\n' \
    "$label" "${status:-unknown}" "$cap" "$hp_json" "$cd_json" "$pw_json" "$ew_json" "$tr_json" "$ac_val" "$cycle_json" "$(conservation_policy)" "$TS"
else
  line="${label} ${cap}%"
  # The wear term is printed ALWAYS, including its absence: `capacity` alone is the reading that
  # cannot see degradation, so a line that silently omits the design-referenced axis reads exactly
  # like a healthy battery.
  if [ -n "${health_pct:-}" ]; then
    line="$line [wear: health ${health_pct}% of design${cap_design:+ · ${cap_design}% design-referenced charge}]"
  else
    line="$line [wear: na — this driver exposes no design capacity, so degradation is UNMEASURED here, not absent]"
  fi
  [ -n "${power_w:-}" ]  && line="$line @ ${power_w}"
  [ -n "${energy_wh:-}" ] && line="$line (${energy_wh} remaining)"
  [ -n "${time_h:-}" ]   && line="$line → ${time_h} left"
  printf 'power: %s\n' "$line"
fi
