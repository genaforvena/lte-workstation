#!/usr/bin/env bash
# mesh-ble-proximity — multi-vantage BLE space map: scan the SAME BLE devices from two nodes' adapters
# and, for each device seen by BOTH, decide which node it is NEAREST (higher RSSI = closer). One node
# alone only knows "a device is in range somewhere"; two vantages know "the watch is in the ds room, not
# the IdeaPad room" — a real spatial upgrade for occupancy / operator-location fusion.
#
# Inputs are two `mesh-presence` scans (this node local + a peer over SSH), each emitting `rssi|mac|name`
# rows. For every SHARED mac: nearest = max-RSSI node, delta-dB = |local-remote| → confidence.
#
# HONEST-FUSION (mandatory, the whole point): if EITHER vantage is unreachable / BUSY / SUSPECT, the map
# is rendered PARTIAL with nearest=UNKNOWN for every device — a single working vantage is NEVER dressed
# up as a space map (that would falsely report "everything nearest the one node that answered"). An
# unreachable peer looks visibly different from "all devices are near me". (cf. honest-fusion rule,
# knowledge fusion-tools-distinguish-empty-from-failed + ble-multivantage-proximity-feasible.)
#
#   mesh-ble-proximity                 scan both vantages, print the space map
#   mesh-ble-proximity --json          machine-readable
#   mesh-ble-proximity --test          synthetic smoke (no adapters, no SSH)
#
# Tunables (env): BLE_PROX_PEER (user@ip of the 2nd vantage) · BLE_PROX_PEER_NAME (label) ·
#   BLE_PROX_WIN (scan seconds, default 6) · BLE_PROX_STRONG (dB delta for a confident call, default 8).
#
# orphan-ok: on-demand fusion sense — the senses mind invokes it live (it costs one SSH round-trip to the
# peer vantage); intentionally NOT cron-wired. Wire at a modest cadence later if a consumer needs it.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

PEER="${BLE_PROX_PEER:-imozerov@100.125.157.75}"          # default 2nd vantage: default-string
PEER_NAME="${BLE_PROX_PEER_NAME:-default-string}"
SELF_NAME="$(hostname)"
WIN="${BLE_PROX_WIN:-6}"
STRONG="${BLE_PROX_STRONG:-8}"                            # |Δ dBm| ≥ this → confident nearest; below → BETWEEN

# Parse `rssi|mac|name` rows from a mesh-presence blob; echo `mac rssi name...` lines. Header/footer
# lines (which don't start with an optional-minus integer + pipe) are dropped.
_rows() { grep -E '^-?[0-9]+\|' 2>/dev/null <<<"$1" | awk -F'|' '{name=$3; for(i=4;i<=NF;i++) name=name"|"$i; print $2, $1, name}'; }

# A scan blob is USABLE only if it actually carries device rows OR is a clean empty. A BUSY/SUSPECT
# header (adapter scan-locked / race-cleared cache — mesh-presence's honest-degraded) is NOT a usable
# vantage: we cannot trust its RSSI, so the whole map degrades rather than fake a half-blind localization.
_blob_bad() { case "$1" in *BUSY*|*SUSPECT*) return 0;; esac; return 1; }

if [ "${1:-}" = --test ]; then
  fails=0
  # nearest() core: given local & remote RSSI, decide nearest + confidence.
  nearest() { # <rssi_self> <rssi_peer> -> "<who> <delta>"
    local s="$1" p="$2" d who
    d=$(( s - p )); [ "$d" -lt 0 ] && d=$(( -d ))
    if [ "$d" -lt "$STRONG" ]; then who=BETWEEN
    elif [ "$s" -gt "$p" ]; then who=SELF
    else who=PEER; fi
    echo "$who $d"
  }
  # Case 1: device much stronger at self → nearest SELF, confident.
  r="$(nearest -52 -91)"; [ "$r" = "SELF 39" ] || { echo "  FAIL c1 ($r)"; fails=$((fails+1)); }
  # Case 2: much stronger at peer → PEER.
  r="$(nearest -90 -55)"; [ "$r" = "PEER 35" ] || { echo "  FAIL c2 ($r)"; fails=$((fails+1)); }
  # Case 3: within STRONG dB → BETWEEN (ambiguous, not falsely localized).
  r="$(nearest -70 -66)"; [ "$r" = "BETWEEN 4" ] || { echo "  FAIL c3 ($r)"; fails=$((fails+1)); }
  # Case 4 (FALSIFIABLE honest-degraded): a BUSY/SUSPECT blob must be rejected as a vantage.
  _blob_bad "=== mesh-presence ... BUSY (adapter scan-locked) ===" || { echo "  FAIL c4: BUSY not rejected"; fails=$((fails+1)); }
  _blob_bad "5 device(s) in range"                                  && { echo "  FAIL c4b: clean scan wrongly rejected"; fails=$((fails+1)); }
  # Case 5: _rows parses rssi|mac|name and drops header/footer.
  blob=$'=== header @ x ===\n-52|59:9F:D2:A5:10:28|?\n-66|5C:49:7D:92:1E:58|[TV] Samsung\n---\ninventory: ...'
  n="$(_rows "$blob" | wc -l)"; [ "$n" = 2 ] || { echo "  FAIL c5: parsed $n rows, want 2"; fails=$((fails+1)); }
  m="$(_rows "$blob" | awk 'NR==2{print $1, $2}')"; [ "$m" = "5C:49:7D:92:1E:58 -66" ] || { echo "  FAIL c5b ($m)"; fails=$((fails+1)); }
  [ "$fails" = 0 ] && echo "smoke-test: ok (nearest:3 + honest-degraded-blob:2 + row-parse:2 assertions)" || { echo "smoke-test: FAIL ($fails)"; exit 1; }
  exit 0
fi

JSON=0; [ "${1:-}" = --json ] && JSON=1
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- vantage 1: this node (local) ---
self_blob="$(mesh-presence "$WIN" 2>/dev/null)"; self_rc=$?
# --- vantage 2: peer over SSH ---
peer_blob="$(timeout $(( WIN + 14 )) ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$PEER" \
  "PATH=\$HOME/.local/bin:\$PATH mesh-presence $WIN" 2>/dev/null)"; peer_rc=$?

self_ok=1; peer_ok=1
{ [ "$self_rc" -ne 0 ] || _blob_bad "$self_blob"; } && self_ok=0
{ [ "$peer_rc" -ne 0 ] || _blob_bad "$peer_blob"; } && peer_ok=0

# HONEST-DEGRADED: a space map needs BOTH vantages. Missing either → PARTIAL, nearest UNKNOWN, never faked.
if [ "$self_ok" = 0 ] || [ "$peer_ok" = 0 ]; then
  reason="PARTIAL — need both vantages; $SELF_NAME:$([ "$self_ok" = 1 ] && echo ok || echo UNREACHABLE) $PEER_NAME:$([ "$peer_ok" = 1 ] && echo ok || echo UNREACHABLE)"
  if [ "$JSON" = 1 ]; then
    printf '{"ts":"%s","status":"PARTIAL","self":"%s","peer":"%s","self_ok":%d,"peer_ok":%d,"devices":[]}\n' \
      "$TS" "$SELF_NAME" "$PEER_NAME" "$self_ok" "$peer_ok"
  else
    echo "mesh-ble-proximity: $reason — space map UNAVAILABLE (no single-vantage map faked)"
  fi
  exit 2
fi

# Build per-mac RSSI from both vantages, decide nearest, render.
# (the two scan blobs are passed via env to avoid shell-quoting hell with device names)
out="$(SELF_BLOB="$self_blob" PEER_BLOB="$peer_blob" python3 - "$SELF_NAME" "$PEER_NAME" "$STRONG" "$JSON" "$TS" <<'PY'
import os, sys, json
self_name, peer_name, strong, as_json, ts = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]=="1", sys.argv[5]
def parse(blob):
    d={}
    for ln in blob.splitlines():
        ln=ln.strip()
        if not ln or ln[0] not in "-0123456789": continue
        p=ln.split("|")
        if len(p)<2: continue
        try: rssi=int(p[0])
        except ValueError: continue
        d[p[1]]=(rssi, "|".join(p[2:]) if len(p)>2 else "?")
    return d
S=parse(os.environ.get("SELF_BLOB","")); P=parse(os.environ.get("PEER_BLOB",""))
shared=sorted(set(S)&set(P), key=lambda m: -max(S[m][0],P[m][0]))
only_self=sorted(set(S)-set(P), key=lambda m: -S[m][0])
only_peer=sorted(set(P)-set(S), key=lambda m: -P[m][0])
devs=[]
for m in shared:
    rs,ns=S[m]; rp,nm=P[m]; name=ns if ns!="?" else nm
    d=abs(rs-rp)
    if d<strong: near="BETWEEN"
    elif rs>rp:  near=self_name
    else:        near=peer_name
    devs.append(dict(mac=m,name=name,rssi_self=rs,rssi_peer=rp,delta=d,nearest=near))
if as_json:
    print(json.dumps(dict(ts=ts,status="OK",self=self_name,peer=peer_name,
        shared=len(shared),devices=devs,
        only_self=[dict(mac=m,rssi=S[m][0],name=S[m][1]) for m in only_self],
        only_peer=[dict(mac=m,rssi=P[m][0],name=P[m][1]) for m in only_peer])))
else:
    print(f"=== mesh-ble-proximity @ {ts} — {len(shared)} shared anchor(s) [{self_name} ↔ {peer_name}] ===")
    if not shared:
        print("  (no devices seen by BOTH vantages — no shared anchors to localize this scan)")
    for x in devs:
        print(f"  {x['nearest']:<26} Δ{x['delta']:>2}dB  {x['name'][:24]:<24} ({self_name.split('-')[0]}={x['rssi_self']} {peer_name.split('-')[0]}={x['rssi_peer']})  {x['mac']}")
    if only_self: print(f"  -- {len(only_self)} only @ {self_name} (in {self_name} range, out of {peer_name} range): " + ", ".join(f"{S[m][1][:14]}({S[m][0]})" for m in only_self[:6]))
    if only_peer: print(f"  -- {len(only_peer)} only @ {peer_name} (in {peer_name} range, out of {self_name} range): " + ", ".join(f"{P[m][1][:14]}({P[m][0]})" for m in only_peer[:6]))
PY
)"
echo "$out"
