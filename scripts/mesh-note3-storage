#!/usr/bin/env bash
# orphan-ok: on-demand Note3 storage read (credential-lane disk guard); pulled by a mind or
#            fused on request, not scheduled — stateless stdout fold, no artifact of its own.
# mesh-note3-storage — NOTE3 /data STORAGE sense (previously unsensed anywhere).
#
# The gap: the Note3 is the mesh's physical-credential lane (Gmail sync, camera, screenrecord),
# and every one of those organs dies when /data fills — silently, as "sync stopped" or "capture
# failed", never as "disk full". df over the existing adb lane reports Size/Used/Free; bands:
#   OK        use% < 70    comfortable headroom
#   TIGHT     70–84        watch: mail + media accumulate here
#   LOW       85–94        act soon: sync/capture at risk
#   CRITICAL  >= 95        act now: the credential lane is about to wedge
# Bands on use% (FALSIFIABLE via --test — move the cuts and the fixtures flip).
#
#   mesh-note3-storage          one read → `status=OK fs=/data size=... used=... free=... use_pct=.. level=..`
#   mesh-note3-storage --test   parser fixtures + one live adb read asserting a numeric artifact
#
# Honest-exit contract: anything that is not a numeric df read off live adb renders
# status=UNKNOWN with a NAMED reason (adb_unreachable|empty_capture|no_data_line|
# malformed_df) and exits 2 — never a fabricated level. Percentages are floored integers
# off the device's own K blocks (never a second df run that could race it).
set -uo pipefail

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"

# parse_df <df output> → "size_k used_k free_k use_pct" (rc 0) or "UNKNOWN <reason>" (rc 2).
# Pure, offline-testable. Reads the /data line; toolbox df prints K blocks in some fixed unit
# with optional suffix — normalize with awk so "26.0G"/"3.4G"/"22.6G" and bare numbers both work.
parse_df() {
  local text="$1" line size used free pct
  line="$(printf '%s' "$text" | awk '$1=="/data"{$1=$1; print}' | head -1)"
  [ -n "$line" ] || { echo "UNKNOWN no_data_line"; return 2; }
  read -r _ size used free _rest <<<"$line"
  # All three K figures come from the device's own row (never recomputed across runs);
  # round-half-up keeps 22.6G honest (truncation would shave a kilobyte off the free figure).
  pct="$(printf '%s %s %s' "$size" "$used" "$free" | awk '
function tok(x){ m=1; if(x~/G$/){m=1024*1024; sub(/G$/,"",x)} else if(x~/M$/){m=1024; sub(/M$/,"",x)} else if(x~/K$/){m=1; sub(/K$/,"",x)}; return x*m }
{ s=int(tok($1)+0.5); u=int(tok($2)+0.5); f=int(tok($3)+0.5)
    if (s<=0 || u<0 || u>s) exit 1
    printf "%d %d %d %d", s, u, f, int(100*u/s) }')"
  [ -n "$pct" ] || { echo "UNKNOWN malformed_df"; return 2; }
  printf '%s\n' "$pct"
}

# classify_storage <use_pct> → OK|TIGHT|LOW|CRITICAL. Pure, offline-testable.
classify_storage() {
  local p="$1"
  printf '%s' "$p" | grep -qE '^[0-9]+$' || { echo "UNKNOWN"; return 2; }
  if [ "$p" -lt 70 ]; then echo OK
  elif [ "$p" -lt 85 ]; then echo TIGHT
  elif [ "$p" -lt 95 ]; then echo LOW
  else echo CRITICAL; fi
}

unknown() {
  printf 'status=UNKNOWN reason=%s fs=/data size_k=unknown used_k=unknown free_k=unknown use_pct=unknown level=unknown\n' "${1:-unknown}"
  return 2
}

live_read() {
  local raw parsed size used free pct level
  raw="$(adb -s "$SERIAL" shell 'df /data' 2>/dev/null | tr -d '\r')"
  [ -n "$raw" ] || unknown adb_unreachable
  [ -n "$raw" ] || return 2
  parsed="$(parse_df "$raw")" || unknown no_data_line
  [ -n "${parsed:-}" ] || return 2
  read -r size used free pct <<<"$parsed"
  level="$(classify_storage "$pct")" || unknown malformed_df
  [ -n "${level:-}" ] && [ "$level" != UNKNOWN ] || return 2
  printf 'status=OK fs=/data size_k=%s used_k=%s free_k=%s use_pct=%s level=%s\n' "$size" "$used" "$free" "$pct" "$level"
}

if [ "${1:-}" = --test ]; then
  fail=0
  chk() { [ "$2" = "$3" ] || { echo "  FAIL: $1 got=[$2] want=[$3]"; fail=1; }; }
  _live_df=$'Filesystem    Size   Used    Free   Blksize\n/data        26.0G   3.4G   22.6G      4.0K'
  # 26.0G=27262976K used 3.4G=3565158K free=23697818K → 13%
  chk live-shape "$(parse_df "$_live_df")" "27262976 3565158 23697818 13"
  chk level-ok "$(classify_storage 13)" OK
  chk tight-lo "$(classify_storage 70)" TIGHT
  chk tight-hi "$(classify_storage 84)" TIGHT
  chk low-lo "$(classify_storage 85)" LOW
  chk low-hi "$(classify_storage 94)" LOW
  chk critical "$(classify_storage 95)" CRITICAL
  chk critical-full "$(classify_storage 100)" CRITICAL
  parse_df 'Filesystem Size Used Free' >/dev/null 2>&1 \
    && { echo "  FAIL: header-only df must exit 2"; fail=1; }
  parse_df '' >/dev/null 2>&1 \
    && { echo "  FAIL: empty df must exit 2"; fail=1; }
  classify_storage 'xx' >/dev/null 2>&1 \
    && { echo "  FAIL: non-numeric pct must exit 2"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  out="$(live_read 2>/dev/null)"; rc=$?
  if [ "$rc" = 0 ]; then
    echo "$out" | grep -qE '^status=OK fs=/data size_k=[0-9]+ used_k=[0-9]+ free_k=[0-9]+ use_pct=[0-9]+ level=(OK|TIGHT|LOW|CRITICAL)$' \
      || { echo "  FAIL: live rc=0 without numeric artifact: $out"; exit 1; }
    echo "smoke-test: ok (parser fixtures + live read: $out)"
  elif [ "$rc" = 2 ]; then
    echo "$out" | grep -qE '^status=UNKNOWN reason=[a-z_]+ ' \
      || { echo "  FAIL: rc=2 without named reason: $out"; exit 1; }
    echo "smoke-test: n/a (parser fixtures ok; live adb dark: $out)"
  else
    echo "  FAIL: live read exited $rc (expected 0 or 2)"; exit 1
  fi
  exit 0
fi

live_read
