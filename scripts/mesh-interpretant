#!/usr/bin/env bash
# mesh-interpretant — SEMANTIC-YIELD of the mesh's own board signs: does a sign have
#   an INTERPRETANT (a receiver whose behavior depends on it), or is it syntactic noise?
#
# LITERATURE (live review 2026-07-12: biosemiotics — sign and meaning in living systems,
#   angle = a concrete METRIC the field uses to measure itself). Kolchinsky & Wolpert 2018
#   ("Semantic information, autonomous agency and non-equilibrium statistical physics",
#   Interface Focus, Royal Society) — generalized in Sowinski et al. 2024, "Causal Leverage
#   Density: A General Approach to Semantic Information" (arXiv:2407.07335) — give the field's
#   sharpest OPERATIONAL metric of MEANING: a signal's SEMANTIC information is the subset of
#   its syntactic (Shannon) information that is CAUSALLY NECESSARY for a receiver's viability,
#   measured by INTERVENTION — scramble the signal and see how much downstream function drops.
#   Information whose removal changes NO receiver carries ZERO semantic information: it is a
#   sign with no interpretant (Peirce's third term — the effect a sign has on an interpreter),
#   i.e. syntactic noise dressed as meaning. This is the biosemiotic core: "signs are events
#   which can change the state of a receiver" — no state-change, no sign.
#
# WHY IT'S A GAP WE DIDN'T EMBODY: mesh-novelty already scores a board event's SURPRISE
#   (I(x)=-log2 P(x), the SYNTACTIC self-information) and even its repertoire SHAPE (--diversity,
#   Zipf). But surprise is orthogonal to meaning: a rare cry-wolf (a +3-event [cpu-throttling]
#   blip, chat-review/cputhrottle-magnitude-floor 2026-07-12) is HIGH-surprise yet has NO
#   interpretant — no downstream consumer acts on it — so mesh-novelty would WAKE A MIND for a
#   semantically-empty sign. Nothing in the mesh measured the K&W axis: does this sign have a
#   receiver? This instrument does — a STATIC lower-bound on the intervention metric.
#
# THE METRIC (honest, machine-interpretant lower bound): for each distinct sense/reflex marker
#   [T] actually emitted to the board, count the deployed tools whose code REFERENCES the literal
#   token [T] (grep -F). The emitter references it (to post it); a real machine-INTERPRETANT is a
#   DIFFERENT tool that reads/cases/greps on [T] — i.e. reference-count >= 2.
#     refs>=2  INTERPRETED    — some other tool's behavior depends on the sign (semantic yield >0)
#     refs==1  EMIT-ONLY      — only the emitter mentions it; NO machine receiver. Cross with a
#                               HIGH emit-frequency = maximal syntactic waste = a demote-to-trace /
#                               gate-harder candidate (the systematic version of the chat-review
#                               cry-wolf hunt done by hand today).
#     refs==0  DYNAMIC/UNKNOWN — emitted live but no static literal (hostname/var-composed token);
#                               honest can't-resolve, NOT scored as waste.
# HONEST SCOPE: this is a MACHINE-interpretant lower bound. A marker can still have a HUMAN/mind
#   interpretant (the operator or a mind reads the board and acts). So EMIT-ONLY markers are REVIEW
#   CANDIDATES for the chat-review lane, never an automatic verdict — exactly how a live cry-wolf
#   gets flagged, now measured instead of spotted by luck. Pure COORDINATION markers (done/task/
#   taking/idle/fyi/verify/design/chat-review/heartbeat/dispatch) are human-interpreted BY DESIGN
#   and excluded.
# HONEST-N/A: exit 2 when the board log or the tool corpus is absent (a VM/fresh node), never a
#   faked "all signs meaningful".
# orphan-ok: on-demand audit instrument for the chat-review lane (like mesh-novelty/mesh-review) — not scheduled.
set -u

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
BIN="${MESH_INTERPRETANT_BIN:-$HOME/.local/bin}"
WINDOW="${MESH_INTERPRETANT_WINDOW:-2000}"   # board lines to scan (recent tail)
TOPN="${MESH_INTERPRETANT_TOPN:-15}"

# coordination vocab — human/mind-interpreted by design, not sense/reflex signs
EXCLUDE=" done task taking idle fyi verify design chat-review heartbeat dispatch operator-fyi "

# refs_for <token>  -> number of deployed tools whose code contains the literal [token]
refs_for() {
  local tok="$1" n
  n=$(grep -lF -e "$tok" "$BIN"/mesh-* 2>/dev/null | wc -l)
  echo "${n:-0}"
}

if [ "${1:-}" = "--test" ]; then
  fail=""
  # hermetic fixture: a board with two sense markers — one referenced only by its emitter
  # (EMIT-ONLY, must flag), one referenced by a SECOND tool (INTERPRETED, must NOT flag) —
  # plus a coordination marker (must be excluded) and a dynamic marker (no static literal).
  t=$(mktemp -d); fbin="$t/bin"; mkdir -p "$fbin"
  {
    for i in 1 2 3 4 5; do echo "2026-07-12T00:0${i}:00Z  emitterA@n  ::  [cry-wolf] blip $i"; done
    echo "2026-07-12T00:06:00Z  emitterB@n  ::  [real-sign] event"
    echo "2026-07-12T00:07:00Z  emitterB@n  ::  [real-sign] event2"
    echo "2026-07-12T00:08:00Z  chat@n  ::  [done] a coordination line"
    echo "2026-07-12T00:09:00Z  dyn@n  ::  [only-dynamic] composed at runtime"
  } > "$t/board"
  # emitterA posts [cry-wolf] and nobody else reads it -> refs==1 -> EMIT-ONLY
  printf '#!/bin/sh\nmesh-chat "[cry-wolf] blip"\n' > "$fbin/mesh-emitterA"
  # emitterB posts [real-sign]; a SECOND tool cases on it -> refs==2 -> INTERPRETED
  printf '#!/bin/sh\nmesh-chat "[real-sign] event"\n' > "$fbin/mesh-emitterB"
  printf '#!/bin/sh\ncase "$x" in *"[real-sign]"*) act ;; esac\n' > "$fbin/mesh-consumerC"
  # NOTE: no tool contains the literal [only-dynamic] -> refs==0 -> DYNAMIC/UNKNOWN (not waste)
  out=$(MESH_CHAT_LOG="$t/board" MESH_INTERPRETANT_BIN="$fbin" "$0" 2>&1)
  # A: the EMIT-ONLY high-freq marker is flagged as a waste candidate
  case "$out" in *'[cry-wolf]'*EMIT-ONLY*|*EMIT-ONLY*'[cry-wolf]'*) : ;; *) fail="$fail cry-wolf-not-flagged";; esac
  # B: the INTERPRETED marker is NOT listed as a waste candidate
  case "$out" in *'[real-sign]'*EMIT-ONLY*|*EMIT-ONLY*'[real-sign]'*) fail="$fail interpreted-mislabeled-waste";; esac
  # C: coordination marker excluded entirely
  case "$out" in *'[done]'*) fail="$fail coordination-not-excluded";; esac
  # D: dynamic (refs==0) marker not scored as waste (honest can't-resolve)
  case "$out" in *'[only-dynamic]'*EMIT-ONLY*) fail="$fail dynamic-scored-as-waste";; esac
  # E: honest-n/a — absent board exits 2, never a faked clean report
  MESH_CHAT_LOG="$t/nope" MESH_INTERPRETANT_BIN="$fbin" "$0" >/dev/null 2>&1
  [ "$?" = 2 ] || fail="$fail absent-board-not-na"
  rm -rf "$t"
  if [ -n "$fail" ]; then echo "test: FAIL ($fail )"; exit 1; fi
  echo "test: ok (interpretant classifier: EMIT-ONLY flagged, INTERPRETED spared, coordination excluded, dynamic honest, absent=n/a)"
  exit 0
fi

# --- live run --------------------------------------------------------------------
[ -r "$BOARD" ] || { echo "mesh-interpretant: board log $BOARD unreadable — honest n/a" >&2; exit 2; }
[ -d "$BIN" ]   || { echo "mesh-interpretant: tool corpus $BIN absent — honest n/a" >&2; exit 2; }

# distinct sense/reflex markers in the recent window + their emit counts (first [token] per line)
counts=$(tail -n "$WINDOW" "$BOARD" 2>/dev/null \
  | sed -n 's/.*::  *\(\[[a-z][a-z0-9-]*\]\).*/\1/p' \
  | sort | uniq -c | sort -rn)
[ -n "$counts" ] || { echo "mesh-interpretant: no markers in the last $WINDOW board lines — honest n/a" >&2; exit 2; }

echo "== mesh-interpretant — semantic yield of board signs (K&W 2018 / arXiv:2407.07335) =="
echo "   window=$WINDOW lines · corpus=$BIN · a sign with no machine-interpretant (refs<2) + high emit = cry-wolf candidate"
echo "   EMIT-ONLY = review for demote-to-trace (machine lower bound; a human interpretant may still exist)"
echo

emit_only=""; interpreted=0; dynamic=0; nreview=0
while read -r cnt tok; do
  [ -n "$tok" ] || continue
  bare="${tok#[}"; bare="${bare%]}"
  case "$EXCLUDE" in *" $bare "*) continue ;; esac   # skip coordination vocab
  refs=$(refs_for "$tok")
  if [ "$refs" -ge 2 ] 2>/dev/null; then
    interpreted=$((interpreted + 1))
  elif [ "$refs" = 0 ]; then
    dynamic=$((dynamic + 1))
  else
    emit_only="$emit_only$cnt $tok\n"
  fi
done <<EOF
$counts
EOF

if [ -n "$emit_only" ]; then
  echo "  SYNTACTIC-WASTE CANDIDATES (EMIT-ONLY, ranked by emit frequency):"
  # already frequency-sorted (counts came sorted); print top-N
  printf "$emit_only" | head -n "$TOPN" | while read -r cnt tok; do
    [ -n "$tok" ] || continue
    nreview=$((nreview + 1))
    printf "    %6s  %-26s EMIT-ONLY (no machine interpretant — review)\n" "$cnt" "$tok"
  done
else
  echo "  (no EMIT-ONLY sense markers in window — every emitted sign has a machine interpretant)"
fi
echo
echo "  summary: $(printf "$emit_only" | grep -c . ) EMIT-ONLY · $interpreted INTERPRETED · $dynamic DYNAMIC/UNKNOWN (excluded coordination vocab)"
exit 0
