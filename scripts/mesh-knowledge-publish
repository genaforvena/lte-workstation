#!/usr/bin/env bash
# mesh-knowledge-publish — the knowledge tier's PUBLISH lane, made real and made HONEST.
#
# NOT `mesh-knowledge-sync`, which already exists and answers a different question: that one is
# rsync ANTI-ENTROPY, spreading the tier ACROSS peers so no node drifts culturally behind. This one
# is the DURABILITY/off-node lane: commit -> local bare anchor -> best-effort git remote. Two verbs
# because "every node holds the union" and "the tier survives this node" are separate claims; a peer
# mesh that all burns down together is converged and gone.
#
# The tier (~/.mesh/knowledge, ~870 files of node-local research) is a git repo whose only
# remote is imozerov@100.125.157.75:knowledge.git on default-string. Until 2026-08-21 NOTHING
# drove it: origin/main sat at the founding commit 60ff685 (130 files) while the working tree
# carried two unpushed commits and 26 uncommitted files, and default-string had been OFFLINE
# since 2026-07-14. A real remote plus a real commit is exactly what a dead publish lane looks
# like — the fiction this tool exists to end.
#
# Three legs, in the order of how much they can be trusted:
#   commit  — uncommitted research is in NO durable tier at all. Unlike the genome, the knowledge
#             tier has no `mesh-land`; nothing else will ever commit it. So this verb commits.
#   anchor  ($MESH_KNOWLEDGE_MIRROR, default $HOME/knowledge-mirror.git) — bare mirror on the
#             local fs of the node that RUNS this. Air-gap-proof; the leg that cannot fail by
#             design, and therefore the only leg whose failure alarms.
#   origin  — best-effort peer push. rc 2 = unreachable is honest n/a, never a failure: an
#             offline peer is not our fault. But a lane unreachable for WEEKS is a fault of the
#             lane, so the log carries the remote's own age and the alarm fires past the horizon.
#
# The `mirror_land`/`peer_land` contract is mesh-genome-sync's, deliberately: a push that exits 0
# without moving the ref is the fiction both tools exist to prevent, so the artifact (the ref, at
# the far end, AFTER the push) is asserted — never the exit code — and an EMPTY ref is refused
# before it can degrade to `:refs/heads/main`, a delete that exits 0 and reports as a landing.
#
# reflex-cadence: 43 * * * *
set -uo pipefail

TREE="${MESH_KNOWLEDGE_TREE:-$HOME/.mesh/knowledge}"
ANCHOR="${MESH_KNOWLEDGE_MIRROR:-$HOME/knowledge-mirror.git}"
LOG="${MESH_KNOWLEDGE_PUBLISH_LOG:-$HOME/.mesh/knowledge-publish.log}"
BACKOFF="$HOME/.mesh/.knowledge-publish-alert"
STALE_BACKOFF="$HOME/.mesh/.knowledge-publish-remote-alert"
# Past this many days with no landing at origin, the publish lane is not "waiting", it is DEAD
# and pretending. 14d is well past any weekend the peer is merely off.
REMOTE_HORIZON_D="${MESH_KNOWLEDGE_REMOTE_HORIZON_D:-14}"
# The corpse this tool was written over: a second clone of the SAME repo, wedged at the founding
# commit with all 130 tracked files deleted from its working tree and two stale untracked drafts
# dropped in — gitignored by the genome, so invisible to every genome-side check. Decommissioned
# 2026-08-21 (tombstone under ~/.mesh/attic/). Detection is what keeps it gone: nothing PREVENTS
# a second clone, so the lane reports one the moment it reappears.
SHADOW="${MESH_KNOWLEDGE_SHADOW:-$HOME/lte-workstation/knowledge}"

ts(){ date -u +%FT%TZ; }

mirror_land(){
  local mirror="$1" ref="$2" landed
  [ -n "$ref" ] || return 1
  [ -d "$mirror" ] || git init --quiet --bare "$mirror" 2>/dev/null || return 1
  git push --quiet --force "$mirror" "${ref}:refs/heads/main" 2>/dev/null || return 1
  landed=$(git --git-dir="$mirror" rev-parse --verify --quiet refs/heads/main 2>/dev/null) || return 1
  [ "$landed" = "$ref" ]
}

# rc 0 = landed · 1 = failed · 2 = unreachable (honest n/a)
peer_land(){
  local peer="$1" ref="$2" landed
  [ -n "$ref" ] || return 1
  timeout 5 git ls-remote --quiet "$peer" HEAD >/dev/null 2>&1 || return 2
  timeout 30 git push --quiet "$peer" "${ref}:refs/heads/main" 2>/dev/null || return 1
  landed=$(timeout 10 git ls-remote "$peer" refs/heads/main 2>/dev/null | awk '{print $1}')
  [ "$landed" = "$ref" ]
}

# Commit everything in $1 that is not committed. Echoes the resulting HEAD. rc 1 only if the tree
# is unusable — "nothing to commit" is a normal, quiet pass, not a failure.
tree_commit(){
  local tree="$1" n
  git -C "$tree" rev-parse --git-dir >/dev/null 2>&1 || return 1
  n=$(git -C "$tree" status --porcelain 2>/dev/null | wc -l)
  if [ "$n" -gt 0 ]; then
    git -C "$tree" add -A >/dev/null 2>&1 || return 1
    # --allow-empty-message would be a silent nothing; a real subject carries the count so the
    # log of the tier reads as a history of what arrived, not a wall of "sync".
    git -C "$tree" -c user.email=noreply@mesh -c user.name="$(hostname 2>/dev/null || echo mesh)" \
        commit --quiet -m "knowledge: $n file(s) from $(hostname 2>/dev/null || echo node) $(ts)" >/dev/null 2>&1 || return 1
  fi
  git -C "$tree" rev-parse HEAD 2>/dev/null
}

# Echoes a note iff a SECOND git repo sits at the shadow path; silent otherwise.
shadow_check(){
  local s="${MESH_KNOWLEDGE_SHADOW:-$SHADOW}"
  [ -e "$s/.git" ] || return 0
  echo "shadow-repo=$s"
}

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  t=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$t"' EXIT
  git init --quiet "$t/tree" || { echo "smoke-test: FAIL (fixture init)"; exit 1; }
  # mirror_land/peer_land push from the CURRENT repo — the fixture must BE the cwd, or the
  # test silently exercises whatever repo the tool happens to be run from.
  cd "$t/tree" || { echo "smoke-test: FAIL (cannot cd fixture)"; exit 1; }

  # 1. the REAL path: an UNCOMMITTED file is committed and reaches an ABSENT anchor. This is the
  #    whole point — the live tier had 26 files in no durable tier at all.
  echo one > "$t/tree/a.md"
  sha=$(tree_commit "$t/tree") || { echo "smoke-test: FAIL (commit leg)"; exit 1; }
  [ -n "$sha" ] || { echo "smoke-test: FAIL (commit leg returned no sha)"; exit 1; }
  git -C "$t/tree" ls-files --error-unmatch a.md >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (a.md not tracked after commit — the dirty tree was NOT captured)"; exit 1; }
  mirror_land "$t/anchor.git" "$sha" || { echo "smoke-test: FAIL (anchor push did not land)"; exit 1; }
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha" ] || { echo "smoke-test: FAIL (mirror ref ${got:-none} != $sha)"; exit 1; }

  # 2. it MOVES on new content. A mirror that lands once and sticks IS the staleness this tool
  #    exists to prevent, and a create-only assertion cannot tell the two apart.
  echo two > "$t/tree/b.md"
  sha2=$(tree_commit "$t/tree")
  [ "$sha2" != "$sha" ] || { echo "smoke-test: FAIL (second dirty file produced no new commit)"; exit 1; }
  mirror_land "$t/anchor.git" "$sha2" || { echo "smoke-test: FAIL (second push did not land)"; exit 1; }
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha2" ] || { echo "smoke-test: FAIL (mirror stuck at ${got:-none}, expected $sha2)"; exit 1; }

  # 3. a CLEAN tree is a quiet pass at the same sha, not a failure and not an empty commit.
  sha3=$(tree_commit "$t/tree") || { echo "smoke-test: FAIL (clean tree reported failure)"; exit 1; }
  [ "$sha3" = "$sha2" ] || { echo "smoke-test: FAIL (clean tree minted a commit: $sha3 != $sha2)"; exit 1; }

  # 4. the NEGATIVE: an anchor that cannot be written must FAIL, never report a landing.
  if mirror_land "/proc/nonexistent/anchor.git" "$sha2" 2>/dev/null; then
    echo "smoke-test: FAIL (unwritable anchor reported OK — the success predicate is fiction)"; exit 1
  fi

  # 5. an EMPTY ref must not touch the mirror: unguarded the push degrades to `:refs/heads/main`,
  #    a delete that exits 0, and landed==ref passes on ""=="" — OK while the backup is GONE.
  if mirror_land "$t/anchor.git" "" 2>/dev/null; then
    echo "smoke-test: FAIL (empty ref reported as landed)"; exit 1
  fi
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha2" ] || { echo "smoke-test: FAIL (empty ref DESTROYED the mirror: main is now '${got:-deleted}')"; exit 1; }

  # 6. an UNREACHABLE peer renders 2 (n/a), never 1 (fail) — the distinction that keeps an offline
  #    default-string from reading as a broken lane, and keeps a broken lane from hiding in it.
  peer_land "$t/no-such-remote.git" "$sha2" >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (unreachable peer returned rc=$rc, expected 2)"; exit 1; }

  # 7. the SHADOW detector fires on a second clone and is quiet without one. A detector nobody has
  #    seen fire is not a detector.
  MESH_KNOWLEDGE_SHADOW="$t/tree" shadow_note=$(shadow_check); [ -n "$shadow_note" ] \
    || { echo "smoke-test: FAIL (shadow detector blind to a real second repo)"; exit 1; }
  MESH_KNOWLEDGE_SHADOW="$t/definitely-absent" shadow_note=$(shadow_check); [ -z "$shadow_note" ] \
    || { echo "smoke-test: FAIL (shadow detector fires on an absent path: $shadow_note)"; exit 1; }

  echo "smoke-test: ok (dirty tree commits, anchor creates+lands+moves, clean tree quiet, unwritable fails, empty ref cannot wipe, unreachable peer = n/a, shadow detector fires and is quiet)"
  exit 0
fi

export PATH="$HOME/.local/bin:$PATH"
mkdir -p "$HOME/.mesh"

if [ "${1:-}" = --check ] || [ "${1:-}" = --status ]; then
  echo "tree:    $TREE"
  if git -C "$TREE" rev-parse --git-dir >/dev/null 2>&1; then
    echo "head:    $(git -C "$TREE" rev-parse --short HEAD 2>/dev/null || echo none)"
    echo "dirty:   $(git -C "$TREE" status --porcelain 2>/dev/null | wc -l) path(s)"
    echo "tracked: $(git -C "$TREE" ls-files 2>/dev/null | wc -l) file(s)"
    echo "origin:  $(git -C "$TREE" rev-parse --short --verify --quiet origin/main 2>/dev/null || echo none) (last-known; unpushed=$(git -C "$TREE" rev-list --count origin/main..HEAD 2>/dev/null || echo '?'))"
  else
    echo "head:    n/a (not a git repo)"
  fi
  echo "anchor:  $ANCHOR -> $(git --git-dir="$ANCHOR" rev-parse --short --verify --quiet refs/heads/main 2>/dev/null || echo none)"
  sc=$(shadow_check); echo "shadow:  ${sc:-none}"
  tail -n 3 "$LOG" 2>/dev/null
  exit 0
fi

git -C "$TREE" rev-parse --git-dir >/dev/null 2>&1 || {
  # No tier on this node is honest n/a, not a fault: knowledge is node-local by design and most
  # nodes hold none. rc 2 so `mesh-land` and `mesh-autowire` read it as absent, not broken.
  echo "$(ts) n/a no knowledge tier at $TREE" >> "$LOG"; exit 2; }

# mirror_land pushes from the CURRENT repo, so the tier must be the cwd — outside it the
# anchor would receive whatever repo cron landed us in.
cd "$TREE" || { echo "$(ts) FAIL cannot cd $TREE" >> "$LOG"; exit 1; }

ref=$(tree_commit "$TREE") || { echo "$(ts) FAIL cannot commit $TREE" >> "$LOG"; exit 1; }
[ -n "$ref" ] || { echo "$(ts) FAIL no HEAD in $TREE (empty repo)" >> "$LOG"; exit 1; }

mirror_land "$ANCHOR" "$ref" && anchor="ok" || anchor="FAIL"

remote="none"
if git -C "$TREE" remote get-url origin >/dev/null 2>&1; then
  ( cd "$TREE" && peer_land origin "$ref" ); rc=$?
  case $rc in
    0) remote="ok";           git -C "$TREE" update-ref refs/remotes/origin/main "$ref" 2>/dev/null
                              date +%s > "$HOME/.mesh/.knowledge-publish-remote-ok" ;;
    2) remote="unreachable" ;;
    *) remote="fail" ;;
  esac
fi

# The remote's own AGE, published beside its state: "unreachable" once is weather, unreachable for
# weeks is the dead publish lane this tool was written over, and only the age separates them.
okf="$HOME/.mesh/.knowledge-publish-remote-ok"
if [ -f "$okf" ]; then
  age_d=$(( ( $(date +%s) - $(cat "$okf" 2>/dev/null || echo 0) ) / 86400 ))
else
  age_d="never"
fi
# "for neverd" — a unit glued to a sentinel. The sentinel is a WORD, not a number, so it carries
# no unit; only the numeric branch does.
[ "$age_d" = never ] && age_d_unit="" || age_d_unit="d"

sc=$(shadow_check)
echo "$(ts) ${anchor}=anchor ${ref:0:7} tracked=$(git -C "$TREE" ls-files | wc -l) remote=$remote remote-landed-age=${age_d}${sc:+ WARN $sc}" >> "$LOG"

if [ "$anchor" != "ok" ]; then
  now=$(date +%s); last=$(cat "$BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 21600 ]; then
    echo "$now" > "$BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "⚠️ knowledge-publish: anchor mirror $ANCHOR FAILED — check disk + fs (${ref:0:7})" >/dev/null 2>&1 || true
  fi
  exit 1
fi
rm -f "$BACKOFF"

# A publish lane that has landed NOTHING past the horizon is not waiting, it is dead — say so once
# a day, not every hour.
if [ "$remote" != "ok" ] && { [ "$age_d" = never ] || [ "$age_d" -ge "$REMOTE_HORIZON_D" ] 2>/dev/null; }; then
  now=$(date +%s); last=$(cat "$STALE_BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 86400 ]; then
    echo "$now" > "$STALE_BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[fyi] knowledge-publish: remote ${remote} — nothing landed at origin for ${age_d}${age_d_unit} (anchor ok, ${ref:0:7}). The tier is backed up locally; the PUBLISH leg is dead." >/dev/null 2>&1 || true
  fi
else
  rm -f "$STALE_BACKOFF"
fi
exit 0
