#!/usr/bin/env bash
# mesh-consume-all — durable supervisor for the CONSUMER-side ephemeral-stream model (operator 2026-06-21).
# Ensures ONE `mesh-pane-consume <channel>` driver runs per thinking channel, each on its OWN rhythm. This
# is the rollout of the "maximally ephemeral stream" model (the source never gates; the mind owns the
# filter + rhythm; the driver only re-invites the mind to read its full top pane). See mesh-pane-consume
# and memory channel-stream-architecture (EVOLUTION 2026-06-21).
#
# Operator 2026-06-21 (CRITICAL, verbatim sense): "в момент подключения … пейн должен получить сигнал
# считать свой пейн" — at the MOMENT a mind connects/spawns, its pane must IMMEDIATELY get the read-signal,
# NOT wait for the first interval. Two mechanisms guarantee that:
#   1) starting a driver fires an immediate wake (mesh-pane-consume's loop calls consume_once BEFORE its
#      first sleep), so `ensure` of a fresh channel reads-now.
#   2) `--kick [ch...]` fires an immediate one-shot read-wake to a channel (or all) RIGHT NOW — this is
#      what mesh-restore / mesh-channel-keepalive call the instant they (re)launch a mind, so every spawn
#      (not just the first) triggers the read.
#
# tg is EXCLUDED on purpose: it is the operator-I/O channel (woken by real operator input via the voice-rx
# chain), not a self-reading producer — a generic "read your stream + act/idle" driver there would make the
# tg mind chatter instead of just serving the operator.
#
#   mesh-consume-all              ensure a driver per channel is running (idempotent — durable via cron)
#   mesh-consume-all --kick [ch]  fire an immediate read-wake to <ch> (or ALL if omitted) — the spawn hook
#   mesh-consume-all --status     show running drivers
#   mesh-consume-all --stop       stop all drivers (by pid; never a -f self-match pkill)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
S="$(hostname)"
LOG="$HOME/.mesh/consume-all.log"
ts(){ date -u +%FT%TZ; }

# channel:interval map — each channel's OWN rhythm (slow senses/room state, faster chat/health coordination).
# Override node-locally via MESH_CONSUME_CHANNELS in restore.env. tg deliberately absent (operator I/O).
CHANS="${MESH_CONSUME_CHANNELS:-minds:90 genome:120 senses:60 health:90 chat:60 room:120}"

# pid of the LOOP driver for channel $1 (anchored on "--interval" so a transient `--once` kick is NOT
# mistaken for the persistent driver, and so this tool's own argv never self-matches).
driver_pid(){ pgrep -f "mesh-pane-consume $1 --interval" 2>/dev/null | head -1; }

# driver_state <desired-int> <desired-dst> <running-argv-or-empty> -> ABSENT|OK|STALE. Pure/testable.
# driver_pid anchors only on "<ch> --interval", so it is BLIND to BOTH the interval VALUE and --deliver:
# a driver started with now-stale args satisfies the liveness check forever and never respawns with the
# new flags (chat-review/consume-driver-pgrep-blind-to-deliver-arg — vpn>health reverted to plain vpn,
# but the old `--deliver health` driver kept misrouting vpn's wakes into health's pane all day; the live
# vpn driver's interval ALSO drifted 7200→14400 and only healed on an incidental full respawn, never by
# drift-detection). So compare the DESIRED (interval, dst) — dst empty = self-delivery, no --deliver —
# against what is actually on the running argv; any mismatch is STALE and forces kill+respawn in ensure_one.
driver_state(){
  local wint="${1:-}" wdst="${2:-}" argv="${3:-}" hint="" hdst=""
  [ -n "$argv" ] || { echo ABSENT; return; }
  case " $argv " in *" --interval "*) hint="${argv##*--interval }"; hint="${hint%% *}" ;; esac
  case " $argv " in *" --deliver "*)  hdst="${argv##*--deliver }";  hdst="${hdst%% *}" ;; esac
  { [ "$hint" = "$wint" ] && [ "$hdst" = "$wdst" ]; } && echo OK || echo STALE
}

# split_entry — parse one CHANS entry into E_SRC/E_DST/E_INT. Two forms (window-set-consolidation
# 2026-07-20): "ch:int" (self-delivery, unchanged) and "src>dst:int" — diff SRC's dash, deliver the
# wake into DST's mind pane (a merged-away channel's dash waking its ABSORBING mind: vpn>health).
split_entry(){ # $1=entry -> sets E_SRC E_DST E_INT
  local spec="${1%%:*}"; E_INT="${1##*:}"
  case "$spec" in
    *">"*) E_SRC="${spec%%>*}"; E_DST="${spec##*>}" ;;
    *)     E_SRC="$spec";       E_DST="" ;;
  esac
}

ensure_one(){ # $1=channel $2=interval [$3=deliver-to] -> start the driver if absent
  local ch="$1" int="$2" dst="${3:-}" pid
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$ch" || {
    echo "$(ts) $ch: window absent — skip (will retry next pass)" >> "$LOG"; return 0; }
  pid="$(driver_pid "$ch")"
  if [ -n "$pid" ]; then
    case "$(driver_state "$int" "$dst" "$(ps -o args= -p "$pid" 2>/dev/null)")" in
      OK)    return 0 ;;                                      # already running with the RIGHT destination
      STALE) kill "$pid" 2>/dev/null                          # destination drifted (restore.env changed) —
             echo "$(ts) $ch: RESPAWN driver (deliver drift → '${dst:-<self>}', killed stale pid $pid)" >> "$LOG" ;;
    esac                                                      # fall through to respawn with the new flags
  fi
  setsid bash -c "exec mesh-pane-consume '$ch' --interval '$int'${dst:+ --deliver '$dst'}" >/dev/null 2>&1 &
  echo "$(ts) $ch: STARTED driver (interval ${int}s${dst:+, delivers to $dst})" >> "$LOG"
}

kick_one(){ # $1=channel [$2=deliver-to] -> immediate one-shot read-wake (the spawn-moment signal)
  local ch="$1" dst="${2:-}"
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$ch" || return 0
  mesh-pane-consume "$ch" --once ${dst:+--deliver "$dst"} >/dev/null 2>&1
  echo "$(ts) $ch: KICK (spawn-moment read-wake${dst:+ → $dst})" >> "$LOG"
}

# ---- test ----
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-pane-consume >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-pane-consume missing)"; exit 1; }
  case " $CHANS " in *" tg:"*) echo "smoke-test: FAIL (tg must NOT be a consume channel — it is operator I/O)"; exit 1;; esac
  # every entry must be ch:int or src>dst:int
  for e in $CHANS; do case "$e" in *:[0-9]*) :;; *) echo "smoke-test: FAIL (bad channel:interval '$e')"; exit 1;; esac; done
  # split_entry must parse BOTH forms (deliver override, window-set-consolidation 2026-07-20)
  split_entry "vpn>health:7200"
  [ "$E_SRC" = vpn ] && [ "$E_DST" = health ] && [ "$E_INT" = 7200 ] || { echo "smoke-test: FAIL (split_entry src>dst:int → '$E_SRC'/'$E_DST'/'$E_INT')"; exit 1; }
  split_entry "minds:11520"
  [ "$E_SRC" = minds ] && [ -z "$E_DST" ] && [ "$E_INT" = 11520 ] || { echo "smoke-test: FAIL (split_entry ch:int → '$E_SRC'/'$E_DST'/'$E_INT')"; exit 1; }
  # the spawn-moment kick must exist (operator-critical)
  src="${BASH_SOURCE[0]:-$0}"; grep -q 'kick_one' "$src" || { echo "smoke-test: FAIL (no spawn-moment kick)"; exit 1; }
  # driver_state <desired-int> <desired-dst> <argv>: any args drift must read STALE so ensure_one
  # kills+respawns, not satisfy liveness forever (chat-review/consume-driver-pgrep-blind-to-deliver-arg).
  [ "$(driver_state 7200 health 'mesh-pane-consume vpn --interval 7200 --deliver health')" = OK ]    || { echo "smoke-test: FAIL (driver_state: matching int+deliver not OK)"; exit 1; }
  # THE LIVE VPN REPRO — desired vpn:14400 self, but the running driver still carries the old 7200 + --deliver health:
  [ "$(driver_state 14400 '' 'mesh-pane-consume vpn --interval 7200 --deliver health')" = STALE ]    || { echo "smoke-test: FAIL (driver_state: drifted int+deliver not STALE — the vpn bug)"; exit 1; }
  [ "$(driver_state 7200 health 'mesh-pane-consume vpn --interval 7200')" = STALE ]                   || { echo "smoke-test: FAIL (driver_state: deliver-desired vs running-self not STALE)"; exit 1; }
  [ "$(driver_state 7200 '' 'mesh-pane-consume vpn --interval 7200')" = OK ]                          || { echo "smoke-test: FAIL (driver_state: self vs self not OK)"; exit 1; }
  # interval drift ALONE is STALE too (the sibling blindness this closes):
  [ "$(driver_state 14400 '' 'mesh-pane-consume vpn --interval 7200')" = STALE ]                      || { echo "smoke-test: FAIL (driver_state: interval drift not STALE)"; exit 1; }
  [ "$(driver_state 7200 health '')" = ABSENT ]                                                       || { echo "smoke-test: FAIL (driver_state: no driver not ABSENT)"; exit 1; }
  echo "smoke-test: ok (per-channel drivers; tg excluded; spawn-moment --kick present; driver_state deliver-drift → STALE→respawn)"; exit 0
fi

tmux has-session -t "$S" 2>/dev/null || { echo "mesh-consume-all: no tmux session '$S'" >&2; exit 1; }

case "${1:-}" in
  --kick)
    shift
    if [ $# -gt 0 ]; then for ch in "$@"; do kick_one "$ch"; done
    else for e in $CHANS; do split_entry "$e"; kick_one "$E_SRC" "$E_DST"; done; fi
    ;;
  --status)
    echo "=== consume drivers ($S) ==="
    for e in $CHANS; do split_entry "$e"; pid="$(driver_pid "$E_SRC")"
      if [ -n "$pid" ]; then printf '  %-16s pid %s (int %ss)\n' "$E_SRC${E_DST:+>$E_DST}" "$pid" "$E_INT"
      else printf '  %-16s DOWN\n' "$E_SRC${E_DST:+>$E_DST}"; fi
    done
    ;;
  --stop)
    for e in $CHANS; do split_entry "$e"; pid="$(driver_pid "$E_SRC")"; [ -n "$pid" ] && { kill "$pid" 2>/dev/null && echo "stopped $E_SRC (pid $pid)"; }; done
    ;;
  "")
    echo "$(ts) ensure pass over: $CHANS" >> "$LOG"
    for e in $CHANS; do split_entry "$e"; ensure_one "$E_SRC" "$E_INT" "$E_DST"; done
    ;;
  *) echo "mesh-consume-all: unknown arg '$1'" >&2; exit 1 ;;
esac
