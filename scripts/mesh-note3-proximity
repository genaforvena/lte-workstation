#!/usr/bin/env bash
# mesh-note3-proximity — the Note3's MAX88922 proximity sensor (type 8), via the SAME
# sensorcat NDK client mesh-note3-ambient/-mag/-gyro use to dodge the `dumpsys sensorservice`
# LATCH problem (a real ASensorManager listener forces a live sample; the dumpsys scrape would
# read a fossil frozen at whatever the last subscriber saw — see [[note3-native-hal-clients]]).
#
# WHY THIS IS NEW: full h/w census (knowledge/capability-note3-sensorcat-argless-oneshot-
# full-suite-snapshot-20260718.md) lists MAX88922 Proximity (type 8) as present and even shows
# its raw values in an example dump, but the doc's own "Wired:" roster never includes it — no
# mesh-note3-* organ reads it. Genuine gap, not a re-discovery: cite that doc, don't re-file it.
# A binary near/far read (something covering the sensor vs. clear) is the cheapest "is a hand/
# object right at the Note3" signal the mesh has — distinct from mesh-note3-input's idle-time
# (which needs a KEY/TOUCH event) and mesh-body-motion's accelerometer (needs the phone to MOVE).
#
#   mesh-note3-proximity          one-shot: near|far + raw cm
#   mesh-note3-proximity --json   {"state":"near|far","raw_cm":N}
#   mesh-note3-proximity --test   fixture parse + live sensorcat read-gate
#
# Exit codes (honest-exit contract):
#   0 = live reading produced (near or far)
#   2 = adb unreachable / sensorcat produced nothing for type 8 — honest n/a, never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
ADB="adb -s $SERIAL"
SECS="${MESH_NOTE3_PROX_SECS:-3}"
# MAX88922's declared maxRange is 8 (its own LIST line: type=8, range=8) — a binary sensor that
# reports either the max range (nothing in front) or a value near 0 (covered). Half the range is
# a safe near/far split regardless of the exact covered-value the HAL emits (observed live: 0).
NEAR_THRESH_CM="${MESH_NOTE3_PROX_NEAR_CM:-4}"

# read_raw -> raw sensorcat SENSOR| line(s) for type 8, or empty on failure
read_raw() {
  mesh-note3-tool-install sensorcat >/dev/null 2>&1 || return 1
  timeout $((SECS + 15)) $ADB shell "/data/local/tmp/sensorcat --secs $SECS 8" 2>/dev/null
}

# parse_cm <sensorcat output> -> raw cm value (v0 of the type=8 SENSOR line), or empty
parse_cm() {
  awk -F'|' '$1=="SENSOR" && $3=="8" { print $4; exit }'
}

# classify <raw_cm> <near_thresh> -> "near|far"
classify() {
  python3 -c "print('near' if float('$1') < float('$2') else 'far')"
}

emit() {  # $1=state $2=raw_cm
  if [ "${MODE:-}" = json ]; then
    printf '{"state":"%s","raw_cm":%s}\n' "$1" "$2"
  else
    printf 'note3-proximity: %s (raw=%scm)\n' "$1" "$2"
  fi
}

# ---- Smoke test ----
if [ "${1:-}" = --test ]; then
  fail=0

  # unit: classify()
  [ "$(classify 0 4)" = near ] || { echo "  FAIL: raw=0 must be near"; fail=1; }
  [ "$(classify 3.9 4)" = near ] || { echo "  FAIL: raw=3.9 (just under thresh) must be near"; fail=1; }
  [ "$(classify 4 4)" = far ] || { echo "  FAIL: raw=4 (at thresh) must be far (gate is <, not <=)"; fail=1; }
  [ "$(classify 8 4)" = far ] || { echo "  FAIL: raw=8 (max range) must be far"; fail=1; }

  # unit: parse_cm() against a real-shaped sensorcat line (from the live full-suite dump)
  _fix='SENSOR|MAX88922 Proximity Sensor|8|8|0|0|175726812743590'
  [ "$(printf '%s\n' "$_fix" | parse_cm)" = "8" ] || { echo "  FAIL: parse_cm should read v0=8 from the fixture"; fail=1; }
  _fix2='SENSOR|MAX88922 Proximity Sensor|8|0|0|0|175726812800000'
  [ "$(printf '%s\n' "$_fix2" | parse_cm)" = "0" ] || { echo "  FAIL: parse_cm should read v0=0 (covered) from the fixture"; fail=1; }
  # a dump with no type=8 line (sensor produced nothing) must parse empty, never a stale guess
  [ -z "$(printf 'SENSOR|Other Sensor|1|1.0|2.0|3.0|1\n' | parse_cm)" ] || { echo "  FAIL: absent type=8 line must parse empty"; fail=1; }

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL (fixtures)"; exit 1; }

  # Real-read gate: a live sensorcat call must produce a plausible cm value (0..maxRange), not
  # just execute without error. Unreachable/absent -> honest exit 2, never fake green.
  _raw="$(read_raw)"
  if [ -z "$_raw" ]; then
    echo "smoke-test: n/a — fixtures ok but Note3/adb unreachable (honest exit 2, live read unverified)"
    exit 2
  fi
  _cm="$(printf '%s\n' "$_raw" | parse_cm)"
  if [ -z "$_cm" ]; then
    echo "smoke-test: n/a — fixtures ok but sensorcat produced no type=8 sample this window (honest exit 2)"
    exit 2
  fi
  python3 -c "exit(0 if 0 <= float('$_cm') <= 20 else 1)" || { echo "  FAIL: live raw_cm implausible for an 8cm-range sensor: $_cm"; exit 1; }
  _state="$(classify "$_cm" "$NEAR_THRESH_CM")"
  echo "smoke-test: ok (fixtures + LIVE sensorcat read: raw=${_cm}cm -> $_state)"
  exit 0
fi

# ---- live read ----
MODE=text; [ "${1:-}" = --json ] && MODE=json

RAW="$(read_raw)"
if [ -z "$RAW" ]; then
  echo "note3-proximity: n/a (Note3/adb unreachable — sense dark, not faked)" >&2
  [ "$MODE" = json ] && printf '{"state":"unreachable"}\n'
  exit 2
fi
CM="$(printf '%s\n' "$RAW" | parse_cm)"
if [ -z "$CM" ]; then
  echo "note3-proximity: n/a (reachable but sensorcat produced no type=8 sample — sense dark, not faked)" >&2
  [ "$MODE" = json ] && printf '{"state":"unreachable"}\n'
  exit 2
fi
STATE="$(classify "$CM" "$NEAR_THRESH_CM")"
emit "$STATE" "$CM"
exit 0
