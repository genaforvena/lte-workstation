#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.audio-irq-state 900 sys
# mesh-audio-irq — short-window activity of the host's HDA audio hardware.
#
# Reads the kernel's snd_hda_intel interrupt counter twice. ACTIVE means the audio
# controller handled at least one interrupt during the sample; QUIET means no
# interrupt arrived in that window. This is hardware-interface activity, not a
# loudness or microphone claim. Missing audio IRQ lines are UNKNOWN (exit 2).
set -u
export PATH="${HOME:-/root}/.local/bin:$PATH"

STATE="${MESH_AUDIO_IRQ_STATE:-${HOME:-/root}/.mesh/.audio-irq-state}"
IRQ_FILE="${MESH_AUDIO_IRQ_FILE:-/proc/interrupts}"
WINDOW_MS="${MESH_AUDIO_IRQ_WINDOW_MS:-250}"

read_count() {
  local file="${1:-${MESH_AUDIO_IRQ_FILE:-$IRQ_FILE}}"
  [ -r "$file" ] || return 2
  awk '
    /snd_hda_intel/ {
      sum=0
      for (i=2; i<NF; i++) {
        if ($i ~ /^[0-9]+$/) sum += $i
        if ($i ~ /^IR-/) break
      }
      found=1; total += sum
    }
    END { if (found) printf "%d\n", total; else exit 2 }
  ' "$file"
}

classify_delta() {
  case "${1:-}" in
    ''|*[!0-9]*) printf 'UNKNOWN';;
    0) printf 'QUIET';;
    *) printf 'ACTIVE';;
  esac
}

sample_delta() {
  local file="${1:-$IRQ_FILE}" before after delay
  before="$(read_count "$file")" || return 2
  delay="$(awk -v ms="$WINDOW_MS" 'BEGIN { printf "%.3f", ms / 1000 }')"
  sleep "$delay"
  after="$(read_count "$file")" || return 2
  [ "$after" -ge "$before" ] 2>/dev/null || return 2
  printf '%s\t%s\t%s\n' "$before" "$after" "$((after - before))"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  cat >"$td/interrupts" <<'EOF'
           CPU0       CPU1
  7:          10          20 IR-PCI-MSI snd_hda_intel:card0
  8:           3           4 IR-PCI-MSI nvme0q0
EOF
  [ "$(read_count "$td/interrupts")" = 30 ] || { echo 'smoke-test: FAIL (fixture parser)'; exit 1; }
  [ "$(classify_delta 0)" = QUIET ] || { echo 'smoke-test: FAIL (quiet classifier)'; exit 1; }
  [ "$(classify_delta 2)" = ACTIVE ] || { echo 'smoke-test: FAIL (active classifier)'; exit 1; }
  MESH_AUDIO_IRQ_FILE="$td/missing" read_count >/dev/null 2>&1 && {
    echo 'smoke-test: FAIL (missing IRQ file was accepted)'; exit 1;
  }
  live="$(read_count "$IRQ_FILE")" || {
    echo "smoke-test: n/a (no readable snd_hda_intel IRQ line in $IRQ_FILE)"; exit 2;
  }
  _sched_state="$td/live-state"
  _sched_out="$td/live.out"
  _sched_rc=0
  env -i HOME="$HOME" PATH=/usr/bin:/bin \
    MESH_AUDIO_IRQ_STATE="$_sched_state" MESH_AUDIO_IRQ_FILE="$IRQ_FILE" \
    "$0" --edge >"$_sched_out" 2>&1 || _sched_rc=$?
  [ "$_sched_rc" = 0 ] && [ -s "$_sched_state" ] \
    || { echo "smoke-test: FAIL (scheduler-like PATH must stamp a fresh real state; rc=$_sched_rc: $(cat "$_sched_out" 2>/dev/null))"; exit 1; }
  echo "smoke-test: ok (fixture parser + REAL audio IRQ read: snd_hda_intel=$live)"
  exit 0
fi

sample="$(sample_delta "$IRQ_FILE")" || {
  echo "mesh-audio-irq: UNKNOWN — no readable snd_hda_intel IRQ sample" >&2
  exit 2
}
before="${sample%%$'\t'*}"
rest="${sample#*$'\t'}"
after="${rest%%$'\t'*}"
delta="${rest##*$'\t'}"
verdict="$(classify_delta "$delta")"
mkdir -p "$(dirname "$STATE")" || exit 1
printf '%s|delta=%s|before=%s|after=%s|window_ms=%s|ts=%s\n' \
  "$verdict" "$delta" "$before" "$after" "$WINDOW_MS" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-audio-irq: UNKNOWN — could not stamp live state' >&2; exit 1;
}

if [ "${1:-}" = --edge ]; then
  previous="$(sed -n '1s/|.*//p' "$STATE.prev" 2>/dev/null || true)"
  cp "$STATE" "$STATE.prev" 2>/dev/null || true
  [ "$previous" = "$verdict" ] && exit 0
fi
printf '[audio-irq] %s — snd_hda_intel delta=%s window_ms=%s\n' "$verdict" "$delta" "$WINDOW_MS"
