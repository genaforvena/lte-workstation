#!/usr/bin/env bash
# mesh-lid — read the laptop lid switch exposed by ACPI.
# smoke-test: --test verifies a readable state with a recognized value.
set -euo pipefail

STATE_FILE="${MESH_LID_STATE_FILE:-/proc/acpi/button/lid/LID0/state}"

read_state() {
  awk '{print tolower($NF)}' "$STATE_FILE" 2>/dev/null
}

case "${1:-}" in
  --test)
    # A node without a lid switch (desktop / VM / router / phone) is NOT broken — the sense is just
    # N/A there. Distinguish the DEPENDENCY being ABSENT (→ exit 2 n/a, the honest-exit contract shared
    # with mesh-sms / mesh-mag / mesh-phone-ear) from the lid being PRESENT but unreadable/garbage
    # (→ exit 1 FAIL). Was: ANY unreadable state → exit 1, which cry-wolfed a FALSE doctor FAIL on every
    # non-laptop node. Verify: present+open→ok(0); MESH_LID_STATE_FILE=/nonexistent→n/a(2); garbage→FAIL(1).
    [ -e "$STATE_FILE" ] || { echo "smoke-test: n/a (no lid switch on this node: $STATE_FILE absent)"; exit 2; }
    state=$(read_state) || { echo "smoke-test: FAIL (lid present but state unreadable)"; exit 1; }
    case "$state" in
      open|closed) echo "smoke-test: ok ($state)" ;;
      *) echo "smoke-test: FAIL (lid present but unknown state: ${state:-empty})"; exit 1 ;;
    esac
    ;;
  --watch)
    interval="${2:-2}"
    previous=""
    while true; do
      state=$(read_state) || state=unknown
      if [ "$state" != "$previous" ]; then
        printf '%s lid=%s\n' "$(date -u +%FT%TZ)" "$state"
        previous="$state"
      fi
      sleep "$interval"
    done
    ;;
  "")
    state=$(read_state) || { echo "mesh-lid: lid state unavailable" >&2; exit 1; }
    printf 'lid=%s\n' "$state"
    ;;
  *)
    echo "usage: mesh-lid [--test|--watch [seconds]]" >&2
    exit 2
    ;;
esac
