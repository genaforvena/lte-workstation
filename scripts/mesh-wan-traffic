#!/usr/bin/env bash
# mesh-wan-traffic — WAN traffic delta monitor for GL-MT3000 (edge-triggered [wan-spike] on anomaly)
# Polls /proc/net/dev eth0 via SSH, computes 5-min byte delta, fires on threshold breach.
#
#   mesh-wan-traffic                  one-shot check (prints delta)
#   mesh-wan-traffic --edge           reflex mode: posts [wan-spike] only on threshold cross
#   mesh-wan-traffic --test           smoke test
# Config (env): WAN_IF=eth0  WAN_SPIKE_RX=10000000  WAN_SPIKE_TX=5000000  WAN_HOST=router
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
WAN_IF="${WAN_IF:-eth0}"
WAN_SPIKE_RX="${WAN_SPIKE_RX:-10000000}"   # 10MB/5min RX threshold
WAN_SPIKE_TX="${WAN_SPIKE_TX:-5000000}"    # 5MB/5min TX threshold
WAN_HOST_NAME="${WAN_HOST:-router}"        # MESH_NODES lookup name (router or GL-MT3000)
STATE="$HOME/.mesh/.wan-traffic.state"     # "rx_bytes tx_bytes epoch"
WAN_HOST=""  # resolved IP/user below
LOG="$HOME/.mesh/wan-traffic.log"
mkdir -p "$HOME/.mesh"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  # Test local /proc/net/dev parse (no SSH in smoke)
  if [ -r /proc/net/dev ]; then
    awk -v iface="eth0" '$1 ~ "^"iface":" {print $2,$10; exit}' /proc/net/dev >/dev/null 2>&1 \
      || { echo "smoke-test: FAIL (local /proc/net/dev parse)"; exit 1; }
  fi
  echo "smoke-test: ok"; exit 0
fi

# Resolve WAN_HOST from MESH_NODES (router / GL-MT3000 entries include user@ prefix)
for pair in $MESH_NODES; do
  case "$pair" in "$WAN_HOST_NAME":*) WAN_HOST="${pair#*:}"; break;; esac
done
[ -n "$WAN_HOST" ] || { echo "ERROR: cannot resolve $WAN_HOST_NAME from MESH_NODES"; exit 2; }

read_proc_net_dev() {
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$WAN_HOST" "cat /proc/net/dev" 2>/dev/null || return 1
}

parse_rx_tx() {
  awk -v iface="$WAN_IF" '$1 ~ "^"iface":" {print $2,$10; exit}'
}

now=$(date +%s)
data=$(read_proc_net_dev) || { echo "ERROR: cannot read /proc/net/dev from $WAN_HOST"; exit 1; }
rx=$(echo "$data" | parse_rx_tx | awk '{print $1}')
tx=$(echo "$data" | parse_rx_tx | awk '{print $2}')
[ -n "$rx" ] && [ -n "$tx" ] || { echo "ERROR: parse failed for $WAN_IF"; exit 1; }

# load previous state
if [ -f "$STATE" ]; then
  read -r prev_rx prev_tx prev_ts < "$STATE"
else
  prev_rx=$rx; prev_tx=$tx; prev_ts=$now
fi

dt=$(( now - prev_ts ))
drx=$(( rx - prev_rx ))
dtx=$(( tx - prev_tx ))
# clamp negative (counter wrap / iface reset)
[ "$drx" -lt 0 ] && drx=0
[ "$dtx" -lt 0 ] && dtx=0

# save current state
printf '%s %s %s\n' "$rx" "$tx" "$now" > "$STATE"

# log
printf '%s %s %s %s %s %s\n' "$(date -u +%FT%TZ)" "$WAN_HOST" "$WAN_IF" "$drx" "$dtx" "$dt" >> "$LOG"

if [ "${1:-}" = --edge ]; then
  spike=0; reason=""
  [ "$drx" -gt "$WAN_SPIKE_RX" ] && { spike=1; reason="RX ${drx}B/5m > ${WAN_SPIKE_RX}B"; }
  [ "$dtx" -gt "$WAN_SPIKE_TX" ] && { spike=1; reason="${reason:+$reason; }TX ${dtx}B/5m > ${WAN_SPIKE_TX}B"; }
  if [ "$spike" -eq 1 ]; then
    prev_state=$(cat "$HOME/.mesh/.wan-traffic-edge" 2>/dev/null || echo OK)
    if [ "$prev_state" != SPIKE ]; then
      echo SPIKE > "$HOME/.mesh/.wan-traffic-edge"
      command -v mesh-chat >/dev/null 2>&1 && \
        MESH_WHO="wan-traffic@$(hostname)" mesh-chat "[wan-spike] $WAN_HOST $WAN_IF: $reason (dt=${dt}s)" >/dev/null 2>&1 || true
    fi
  else
    echo OK > "$HOME/.mesh/.wan-traffic-edge"
  fi
  exit 0
fi

# one-shot output
printf 'RX delta: %s bytes (%s MB/5m)\n' "$drx" "$(echo "scale=2; $drx/1024/1024" | bc 2>/dev/null || echo "N/A")"
printf 'TX delta: %s bytes (%s MB/5m)\n' "$dtx" "$(echo "scale=2; $dtx/1024/1024" | bc 2>/dev/null || echo "N/A")"
printf 'Thresholds: RX=%s TX=%s\n' "$WAN_SPIKE_RX" "$WAN_SPIKE_TX"
[ "$drx" -gt "$WAN_SPIKE_RX" ] && printf '⚠ RX SPIKE\n'
[ "$dtx" -gt "$WAN_SPIKE_TX" ] && printf '⚠ TX SPIKE\n'