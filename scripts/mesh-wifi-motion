#!/usr/bin/env bash
# mesh-wifi-motion — DECAYED on this device (2026-06-17).
#
# WiFi passive radar: detect room motion from RSSI delta vs last scan.
# Research basis: WiDet (IEEE 2014), "Device-free Passive Localization via WiFi".
#
# DECAYED: Android's scan cache never refreshes between cron runs because:
#   1. `termux-wifi-scan` (the command that forces a fresh scan) does not exist
#      on this device (termux-api 0.59.1 only has scaninfo/connectioninfo/enable).
#   2. `termux-wifi-enable false/true` (WiFi radio toggle) does NOT clear the
#      cache — timestamps persist across toggles on this Android build.
#   3. Android auto-scans every 15-30 min, but cron runs every 5 min → most
#      runs return identical cached data → always UNCERTAIN.
#
# Impact: mesh-room-sense and mesh-activity-tempo call this tool and degrade
# to UNCERTAIN when it returns stale data. Both tools still function via their
# other signals (BLE, body-motion, light, audio). The wifi axis is the one
# that is dead — not the whole fusion.
#
# If termux-wifi-scan becomes available (pkg upgrade termux-api), remove this
# comment and the tool will self-heal via the stale-breaking path.
#
#   mesh-wifi-motion           one scan → compare vs last → STILL / MOTION / UNCERTAIN / FIRST-RUN
#   mesh-wifi-motion --edge    emit ONLY on state change vs last classification
#   mesh-wifi-motion --test    smoke-test (exit 2 = phone unreachable = n/a)
#
# Thresholds (max RSSI delta across stable BSSIDs):
#   ≤ 2 dBm  → STILL    (quiet room, no one moved)
#   ≥ 5 dBm  → MOTION   (someone moved between last and current scan)
#   else      → UNCERTAIN
#
# "Stable BSSID" = present in both current and previous scan.
# On first run (no previous scan): stores current, exits FIRST-RUN.
#
# Honest-organ: phone unreachable → exit 2; stale (same timestamps) → UNCERTAIN (cached data).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
STATEFILE="$HOME/.mesh/.wifi-motion-prev"   # stores: prev scan JSON
CLASSFILE="$HOME/.mesh/.wifi-motion-state"  # stores: STILL/MOTION/UNCERTAIN
STALECOUNT="$HOME/.mesh/.wifi-motion-stale" # "consecutive_stale_count last_suppress_epoch"
OFFLINEFILE="$HOME/.mesh/.mesh-wifi-motion-offline"
STALE_SUPPRESS="${MESH_WIFI_MOTION_STALE_SUPPRESS:-3}"  # suppress after N consecutive stale reads
STALE_GAP="${MESH_WIFI_MOTION_STALE_GAP:-300}"          # attempt fresh scan after this many seconds suppressed

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — all IPs tried)"; exit 2; }
  _out="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
    "termux-wifi-scaninfo 2>/dev/null; true" </dev/null 2>/dev/null)"
  printf '%s' "$_out" | python3 -c "import json,sys; aps=json.load(sys.stdin); assert len(aps)>0" \
    2>/dev/null || { echo "smoke-test: FAIL (phone unreachable, no WiFi scan, or WiFi permission not granted)"; exit 2; }
  echo "smoke-test: ok"
  exit 0
fi

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1

pip="$(mesh-phone-ip 2>/dev/null)" || {
    if [ ! -f "$OFFLINEFILE" ]; then
        echo "[wifi-motion] phone offline (all IPs tried) — no WiFi motion sense" >&2
        touch "$OFFLINEFILE"
    fi
    exit 2
}
rm -f "$OFFLINEFILE"

# Stale-suppression: if we've been getting consecutive cached-UNCERTAIN, check whether to
# fire a fresh scan request to break the Android scan cache, or just suppress entirely.
stale_count=0; stale_since=0
if [ -f "$STALECOUNT" ]; then
  read -r stale_count stale_since < "$STALECOUNT" 2>/dev/null || true
  case "$stale_count" in ''|*[!0-9]*) stale_count=0;; esac
  case "$stale_since" in ''|*[!0-9]*) stale_since=0;; esac
fi
suppressed=0
now_epoch=$(date +%s)
if [ "$stale_count" -ge "$STALE_SUPPRESS" ]; then
  # We've been suppressing. If enough time has passed, attempt a fresh scan.
  # termux-wifi-scan may not exist on older Termux:API — best-effort.
  if [ $(( now_epoch - stale_since )) -ge "$STALE_GAP" ]; then
    # Try termux-wifi-scan first (may not exist on older termux-api).
    # Fallback: toggle WiFi radio off/on to force Android to re-scan.
    timeout 6 ssh -p "${PHONE_SSH_PORT:-8022}" \
      -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new \
      "${PHONE_USER:-u0_a380}@$pip" "
        if command -v termux-wifi-scan >/dev/null 2>&1; then
          termux-wifi-scan 2>/dev/null; true
        elif command -v termux-wifi-enable >/dev/null 2>&1; then
          termux-wifi-enable false 2>/dev/null; sleep 2
          termux-wifi-enable true 2>/dev/null; sleep 3; true
        fi
      " </dev/null 2>/dev/null || true
  fi
fi

# Fetch current scan
curr="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" \
  -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new \
  "${PHONE_USER:-u0_a380}@$pip" "termux-wifi-scaninfo 2>/dev/null; true" \
  </dev/null 2>/dev/null)" || true

[ -n "$curr" ] && printf '%s' "$curr" | python3 -c "import json,sys; json.load(sys.stdin)" >/dev/null 2>&1 \
  || { echo "[wifi-motion] phone unreachable or no WiFi scan" >&2; exit 2; }

# First run: just store and exit
if [ ! -f "$STATEFILE" ]; then
  printf '%s' "$curr" > "$STATEFILE"
  echo "[wifi-motion] FIRST-RUN (baseline stored)"
  exit 0
fi
prev="$(cat "$STATEFILE")"

# Compare current vs previous — write both to temp files for clean parse
_TMPDIR="$(mktemp -d /tmp/.wifi-motion.XXXXXX)"
trap 'rm -rf "$_TMPDIR"' EXIT
printf '%s' "$curr" > "$_TMPDIR/curr.json"
printf '%s' "$prev" > "$_TMPDIR/prev.json"

verdict="$(python3 - "$_TMPDIR/curr.json" "$_TMPDIR/prev.json" <<'PYEOF'
import sys, json

try:
    curr_aps = {a['bssid']: a for a in json.load(open(sys.argv[1])) if 'bssid' in a}
    prev_aps = {a['bssid']: a for a in json.load(open(sys.argv[2])) if 'bssid' in a}
except Exception as e:
    print(f'UNCERTAIN (JSON parse error: {e})')
    sys.exit(0)

# Check for stale data (same timestamps on key APs)
stable_bssids = set(curr_aps.keys()) & set(prev_aps.keys())
if not stable_bssids:
    print('UNCERTAIN (no stable BSSIDs in both scans)')
    sys.exit(0)

stale = all(
    curr_aps[b].get('timestamp') == prev_aps[b].get('timestamp')
    for b in stable_bssids
)
if stale:
    print(f'UNCERTAIN (cached — all {len(stable_bssids)} timestamps identical, Android scan not refreshed)')
    sys.exit(0)

# Compute max RSSI delta per stable BSSID
max_delta = 0
worst = ''
for bssid in stable_bssids:
    delta = abs(curr_aps[bssid].get('rssi', 0) - prev_aps[bssid].get('rssi', 0))
    if delta > max_delta:
        max_delta = delta
        worst = bssid

if max_delta <= 2:
    print(f'STILL (max_delta={max_delta}dBm, n_stable={len(stable_bssids)})')
elif max_delta >= 5:
    print(f'MOTION (max_delta={max_delta}dBm, bssid={worst})')
else:
    print(f'UNCERTAIN (max_delta={max_delta}dBm, borderline)')
PYEOF
)"
rm -rf "$_TMPDIR"; trap - EXIT

label="${verdict%% *}"  # STILL / MOTION / UNCERTAIN
output="[wifi-motion] $verdict"

# Update stored scan (always refresh for next comparison)
printf '%s' "$curr" > "$STATEFILE"

# Stale-suppression: track consecutive UNCERTAIN(cached) reads. After STALE_SUPPRESS
# consecutive, suppress output. Reset counter on any non-stale verdict.
case "$output" in
  *"cached"*|*"identical"*)
    stale_count=$((stale_count + 1))
    if [ "$stale_since" -eq 0 ]; then stale_since="$now_epoch"; fi
    printf '%d %d\n' "$stale_count" "$stale_since" > "$STALECOUNT"
    if [ "$stale_count" -ge "$STALE_SUPPRESS" ]; then
      suppressed=1
      [ "$stale_count" -eq "$STALE_SUPPRESS" ] && \
        echo "[wifi-motion] suppressing stale reads (${stale_count} consecutive, Android scan not refreshing — will re-trigger scan after ${STALE_GAP}s)" >&2
    fi
    ;;
  *)
    # Non-stale verdict — reset the staleness counter
    rm -f "$STALECOUNT"
    stale_count=0; stale_since=0
    ;;
esac

if [ "$suppressed" = 1 ]; then
  # Still update CLASSFILE for edge tracking even when suppressed
  if [ "$EDGE" = 1 ]; then
    printf '%s' "$label" > "$CLASSFILE"
  fi
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev_class="$(cat "$CLASSFILE" 2>/dev/null || true)"
  printf '%s' "$label" > "$CLASSFILE"
  [ "$label" = "$prev_class" ] && exit 0
fi

echo "$output"
