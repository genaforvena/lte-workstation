#!/usr/bin/env bash
# mesh-hire-idle — edge-trigger the hire lane's idle status.
#
# Every check is appended to a durable receipt log.  The board is only a change stream:
# an unchanged (blocker, receipt-hash) pair is retained locally but emits no second [idle].
# This is intentionally on-demand; the hire mind calls it after each gate check.
set -euo pipefail

STATE="${MESH_HIRE_IDLE_STATE:-$HOME/.mesh/hire/idle-edge.state}"
LOG="${MESH_HIRE_IDLE_LOG:-$HOME/.mesh/handoff/hire-idle-receipts.log}"
WHO="${MESH_WHO:-hire@$(hostname)}"

usage() {
  printf '%s\n' \
    'usage: mesh-hire-idle --blocker TEXT --receipt FILE' \
    '       mesh-hire-idle --recovered --receipt FILE'
}

hash_text() { printf '%s' "$1" | sha256sum | awk '{print $1}'; }
hash_file() { sha256sum "$1" | awk '{print $1}'; }

mkdir -p "$(dirname "$STATE")" "$(dirname "$LOG")"

status=blocked
blocker=
receipt=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --blocker) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; blocker=$2; shift 2 ;;
    --recovered) status=recovered; shift ;;
    --receipt) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; receipt=$2; shift 2 ;;
    --test)
      command -v sha256sum >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no sha256sum)' >&2; exit 1; }
      command -v mesh-chat >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no mesh-chat)' >&2; exit 1; }
      echo 'smoke-test: OK (receipt-hash edge trigger wired)'; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[ -n "$receipt" ] && [ -f "$receipt" ] || { echo "FAIL: receipt is missing: $receipt" >&2; exit 2; }
if [ "$status" = blocked ] && [ -z "$blocker" ]; then
  echo 'FAIL: --blocker is required unless --recovered is used' >&2
  exit 2
fi

receipt_hash="$(hash_file "$receipt")"
blocker_hash="$(hash_text "$blocker")"
previous_status=
previous_blocker_hash=
previous_receipt_hash=
if [ -r "$STATE" ]; then
  IFS=$'\t' read -r previous_status previous_blocker_hash previous_receipt_hash <"$STATE" || true
fi

emit=0
reason=unchanged
if [ "$status" = recovered ]; then
  if [ "$previous_status" != recovered ]; then
    emit=1; reason=recovery
  fi
else
  if [ "$previous_status" != blocked ] || \
     [ "$previous_blocker_hash" != "$blocker_hash" ] || \
     [ "$previous_receipt_hash" != "$receipt_hash" ]; then
    emit=1; reason=blocker-change
  fi
fi

timestamp="$(date -u +%FT%TZ)"
printf '%s\t%s\t%s\t%s\t%s\n' \
  "$timestamp" "$status" "$blocker_hash" "$receipt_hash" "$reason" >>"$LOG"

if [ "$emit" -eq 1 ]; then
  if [ "$status" = recovered ]; then
    message="[idle] hire: recovered; receipt=$receipt_hash"
  else
    message="[idle] hire: blocker=$blocker receipt=$receipt_hash"
  fi
  MESH_WHO="$WHO" mesh-chat "$message"
fi

tmp="${STATE}.tmp.$$"
if [ "$status" = recovered ]; then
  printf '%s\t%s\t%s\n' recovered "$previous_blocker_hash" "$receipt_hash" >"$tmp"
else
  printf '%s\t%s\t%s\n' blocked "$blocker_hash" "$receipt_hash" >"$tmp"
fi
mv -f "$tmp" "$STATE"
printf '%s\n' "status=$status emitted=$emit reason=$reason receipt=$receipt_hash"
