#!/usr/bin/env bash
# reflex-cadence: */20 * * * *
# reflex-args: --edge
# mesh-cpu-avgfreq — CPU AVERAGE-FREQUENCY sense.
#
# WHY: mesh-cpufreq reads the live scaling frequency right now; this sense reads the kernel's
# cpuinfo_avg_freq signal, which reports the average observed frequency for each cpufreq policy.
# That is a distinct hardware-local signal, useful as a steadier "what clock has this CPU been
# running at" view than the instantaneous governor/scaling snapshot.
#
# HONEST: if no readable cpuinfo_avg_freq/cpuinfo_max_freq pair exists under cpufreq policies, the
# sense is UNREACHABLE and exits 2. It never fabricates a reading.
#
#   mesh-cpu-avgfreq          one-shot reading
#   mesh-cpu-avgfreq --json   machine-readable JSON
#   mesh-cpu-avgfreq --edge   emit only on band change (liveness touches STATE every success)
#   mesh-cpu-avgfreq --test   fixture-backed smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_CPU_AVGFREQ_STATE:-$MESH/.cpu-avgfreq.state}"
ROOT="${MESH_CPU_AVGFREQ_ROOT:-/sys/devices/system/cpu/cpufreq}"
mkdir -p "$MESH" 2>/dev/null || true

is_int() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

read_int() {
  local f="$1" v=""
  [ -r "$f" ] || return 1
  v="$(cat "$f" 2>/dev/null || true)"
  is_int "$v" || return 1
  printf '%s' "$v"
}

discover_policies() {
  local d avg max
  for d in "$ROOT"/policy*/; do
    [ -d "$d" ] || continue
    avg="$(read_int "${d}cpuinfo_avg_freq" 2>/dev/null || true)"
    max="$(read_int "${d}cpuinfo_max_freq" 2>/dev/null || true)"
    [ -n "$avg" ] && [ -n "$max" ] || continue
    [ "$max" -gt 0 ] 2>/dev/null || continue
    printf '%s|%s|%s\n' "${d%/}" "$avg" "$max"
  done
}

classify_ratio() {
  local ratio="${1:-}" policies="${2:-0}"
  if [ "$policies" -le 0 ] 2>/dev/null; then
    echo "OFFLINE|no readable cpuinfo_avg_freq sources under $ROOT"
    return 2
  fi
  is_int "$ratio" || { echo "OFFLINE|ratio unreadable"; return 2; }
  if   [ "$ratio" -lt 30 ] 2>/dev/null; then echo "IDLE|avg clock deep-idle"; return 0
  elif [ "$ratio" -lt 50 ] 2>/dev/null; then echo "THROTTLED|avg clock heavily under max"; return 0
  elif [ "$ratio" -lt 85 ] 2>/dev/null; then echo "REDUCED|avg clock below nominal"; return 0
  elif [ "$ratio" -le 100 ] 2>/dev/null; then echo "NOMINAL|avg clock near max"; return 0
  else echo "BOOST|avg clock above max"; return 0
  fi
}

if [ "${1:-}" = --test ]; then
  fail=0
  ck() { [ "$1" = "$2" ] || { echo "  FAIL: $3 (got '$1', want '$2')"; fail=1; }; }
  ck "$(classify_ratio 20 4)" "IDLE|avg clock deep-idle" "idle band"
  ck "$(classify_ratio 35 4)" "THROTTLED|avg clock heavily under max" "throttled band"
  ck "$(classify_ratio 60 4)" "REDUCED|avg clock below nominal" "reduced band"
  ck "$(classify_ratio 95 4)" "NOMINAL|avg clock near max" "nominal band"
  ck "$(classify_ratio 115 4)" "BOOST|avg clock above max" "boost band"
  out="$(classify_ratio OFFLINE 0)"
  printf '%s\n' "$out" | grep -q '^OFFLINE|' || { echo "  FAIL: offline guard (got '$out')"; fail=1; }
  td="$(mktemp -d)" || { echo "  FAIL: mktemp"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/cpufreq/policy0" "$td/cpufreq/policy1"
  printf '3000000\n' > "$td/cpufreq/policy0/cpuinfo_avg_freq"
  printf '3500000\n' > "$td/cpufreq/policy0/cpuinfo_max_freq"
  printf '2000000\n' > "$td/cpufreq/policy1/cpuinfo_avg_freq"
  printf '3500000\n' > "$td/cpufreq/policy1/cpuinfo_max_freq"
  got="$(MESH_CPU_AVGFREQ_ROOT="$td/cpufreq" "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"policies":2' || { echo "  FAIL: fixture policies missing ($got)"; fail=1; }
  printf '%s\n' "$got" | grep -q '"ratio":71' || { echo "  FAIL: fixture ratio wrong ($got)"; fail=1; }
  rm -rf "$td"
  trap - EXIT
  MESH_CPU_AVGFREQ_ROOT='/nonexistent/cpufreq' "$0" >/dev/null 2>&1
  [ "$?" -eq 2 ] || { echo "  FAIL: missing source must exit 2"; fail=1; }
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # REAL-READ gate (2026-07-15) — everything above proves the CLASSIFIER. classify_ratio is pure, the
  # fixture drives synthetic policies through MESH_CPU_AVGFREQ_ROOT in a tmpdir, and the assertion
  # directly above is the bypass in its purest form: it points the tool at '/nonexistent/cpufreq' to
  # prove it exits 2 for a MISSING source — then exits 0 itself, while the REAL $ROOT on this node is
  # that very missing-source case. Proving you handle an absent organ is not the same as having one.
  # So --test returned 0 on mesh-home, autowire read PASS instead of n/a, and cron-wired a reflex that
  # has emitted the identical "UNREACHABLE — no readable cpuinfo_avg_freq sources" 20/20 times since
  # 2026-07-14. Same bypass as mesh-motion-attrib (562938a), mesh-therm-watch (dacf6f1), mesh-battery.
  #
  # WHY IT IS ABSENT, and why that is honest and NOT the mesh-therm bug (dacf6f1 read only
  # thermal_zone* and so went blind on an AMD box that exposes temp via hwmon): cpuinfo_avg_freq is an
  # amd-pstate attribute. mesh-home runs the acpi-cpufreq driver, which never exports it — the sysfs
  # dir has cpuinfo_cur_freq/scaling_cur_freq but no avg. This sense reads a DISTINCT signal by design
  # (see WHY at the top), and the frequency axis here is NOT blind: its sibling mesh-cpufreq reads the
  # live scaling clock and reports NOMINAL ratio=96% across 16 CPUs right now. So this is a genuinely
  # absent organ, not a wrong-path read. Switch this node to amd-pstate and autowire */30 re-wires it.
  live_rc=0; live="$("$0" 2>&1)" || live_rc=$?
  if [ "$live_rc" = 2 ]; then
    echo "smoke-test: n/a — no cpuinfo_avg_freq organ on $(hostname): $ROOT exposes none under the $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || echo unknown) driver ($live). Band + fixture assertions all passed; this tool is sound, this node's cpufreq driver simply does not export the signal (mesh-cpufreq covers the live clock axis)."
    exit 2
  fi
  echo "smoke-test: ok (bands + fixture JSON + unreachable exit2 + real-read gate: live cpuinfo_avg_freq present)"
  exit 0
fi

edge=0
[ "${1:-}" = --edge ] && edge=1
json=0
[ "${1:-}" = --json ] && json=1

ts="$(date -u +%FT%TZ)"
declare -a policies=()
sum_avg=0
sum_max=0
count=0

while IFS='|' read -r pol avg max; do
  [ -n "${pol:-}" ] || continue
  policies+=("$pol")
  sum_avg=$((sum_avg + avg))
  sum_max=$((sum_max + max))
  count=$((count + 1))
done < <(discover_policies)

[ "$count" -gt 0 ] || { echo "cpu-avgfreq: UNREACHABLE — no readable cpuinfo_avg_freq sources under $ROOT" >&2; exit 2; }
[ "$sum_max" -gt 0 ] || { echo "cpu-avgfreq: UNREACHABLE — invalid cpuinfo_max_freq values under $ROOT" >&2; exit 2; }

ratio=$(( sum_avg * 100 / sum_max ))
avg_mhz=$(( sum_avg / 1000 / count ))
max_mhz=$(( sum_max / 1000 / count ))
class_out="$(classify_ratio "$ratio" "$count")" || exit 2
label="${class_out%%|*}"
short_reason="${class_out#*|}"

state_line="$label"

if [ "$edge" = 1 ]; then
  prev="$(cat "$STATE" 2>/dev/null || true)"
  if [ "$prev" = "$state_line" ]; then
    mesh-state-touch "$STATE"
    exit 0
  fi
  printf '%s\n' "$state_line" > "$STATE"
  mesh-state-touch "$STATE"
fi

if [ "$json" = 1 ]; then
  pols=""
  for p in "${policies[@]}"; do pols="${pols:+$pols,}\"$p\""; done
  printf '{"label":"%s","reason":"%s","avg_mhz":%s,"max_mhz":%s,"ratio":%s,"policies":%s,"sources":[%s],"ts":"%s"}\n' \
    "$label" "$short_reason" "$avg_mhz" "$max_mhz" "$ratio" "$count" "$pols" "$ts"
  exit 0
fi

printf '[cpu-avgfreq] %s — avg=%sMHz max=%sMHz ratio=%s%% policies=%s (%s)\n' \
  "$label" "$avg_mhz" "$max_mhz" "$ratio" "$count" "$short_reason"
