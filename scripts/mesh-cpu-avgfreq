#!/usr/bin/env bash
# reflex-cadence: */20 * * * *
# reflex-args: --edge
# mesh-cpu-avgfreq — CPU AVERAGE-FREQUENCY sense.
#
# WHY: mesh-cpufreq reads the live scaling frequency right now; this sense reads the AVERAGE
# DELIVERED frequency — a steadier "what clock has this CPU actually been running at" view than the
# instantaneous governor/scaling snapshot.
#
# TWO PROVIDERS OF THE SAME QUANTITY (2026-08-18 — this sense used to have only the first, and
# declared the signal a "genuinely absent organ" on any node lacking it. That verdict was FALSE):
#   1. cpufreq policy*/cpuinfo_avg_freq — the amd-pstate driver's own published average.
#   2. acpi_cppc feedback_ctrs via mesh-cppc --json — del/ref summed across cpus and scaled by
#      nominal_freq. This is not an approximation of a different signal: amd-pstate computes
#      cpuinfo_avg_freq from the very same APERF/MPERF-class counters that CPPC exposes here, so
#      provider 2 answers the identical question through the other door.
# mesh-home runs the acpi-cpufreq driver, which never exports cpuinfo_avg_freq — but it DOES expose
# /sys/devices/system/cpu/cpu*/acpi_cppc/, so the organ was present the whole time and this sense
# spent 20/20 cron runs reporting UNREACHABLE beside a readable source. "The driver does not export
# it" was true and was not the same claim as "the node cannot produce it".
#
# RESIDENCY IS PUBLISHED WITH THE CPPC READING, always. del/ref is a ratio over the time a core was
# AWAKE; on a mostly-idle package it is computed from a thin slice of C0 and is a sample, not a
# state. mesh-cppc aggregates by summing deltas BEFORE dividing, so each core is weighted by its own
# awake time — but the reader still needs to see how much awake time the whole figure rests on.
#
# HONEST: UNREACHABLE (exit 2) only when BOTH providers are absent. It never fabricates a reading.
#
#   mesh-cpu-avgfreq          one-shot reading (source= names which provider answered)
#   mesh-cpu-avgfreq --json   machine-readable JSON
#   mesh-cpu-avgfreq --edge   emit only on band change (liveness touches STATE every success)
#   mesh-cpu-avgfreq --test   fixture-backed smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_CPU_AVGFREQ_STATE:-$MESH/.cpu-avgfreq.state}"
ROOT="${MESH_CPU_AVGFREQ_ROOT:-/sys/devices/system/cpu/cpufreq}"
CPUMAX="${MESH_CPU_AVGFREQ_CPUMAX:-/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq}"
mkdir -p "$MESH" 2>/dev/null || true

is_int() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

read_int() {
  local f="$1" v=""
  [ -r "$f" ] || return 1
  v="$(cat "$f" 2>/dev/null || true)"
  is_int "$v" || return 1
  printf '%s' "$v"
}

discover_policies() {
  local d avg max
  for d in "$ROOT"/policy*/; do
    [ -d "$d" ] || continue
    avg="$(read_int "${d}cpuinfo_avg_freq" 2>/dev/null || true)"
    max="$(read_int "${d}cpuinfo_max_freq" 2>/dev/null || true)"
    [ -n "$avg" ] && [ -n "$max" ] || continue
    [ "$max" -gt 0 ] 2>/dev/null || continue
    printf '%s|%s|%s\n' "${d%/}" "$avg" "$max"
  done
}

# provider 2: the CPPC delivered-average, read through mesh-cppc (the single CPPC measure tract —
# never re-implement the del/ref math here). Its snapshot path is overridden so consuming it cannot
# shorten mesh-cppc's own interval window.
cppc_bin() {
  local b; b="$(command -v mesh-cppc 2>/dev/null || true)"
  [ -n "$b" ] && { printf '%s' "$b"; return 0; }
  b="$(dirname "$0")/mesh-cppc"
  [ -x "$b" ] && { printf '%s' "$b"; return 0; }
  return 1
}

discover_cppc() { # -> "<avg_khz>|<max_khz>|<residency_pct>|<window>" or nothing
  local bin j avg res win maxk
  [ "${MESH_CPU_AVGFREQ_NO_CPPC:-0}" = 1 ] && return 1
  bin="$(cppc_bin)" || return 1
  j="$(MESH_CPPC_SNAP="${MESH_CPU_AVGFREQ_CPPC_SNAP:-$MESH/.cpu-avgfreq.cppc.snap}" \
       MESH_CPPC_STATE="${MESH_CPU_AVGFREQ_CPPC_STATE:-$MESH/.cpu-avgfreq.cppc.state}" \
       "$bin" --json 2>/dev/null)" || return 1
  avg="$(printf '%s' "$j" | grep -o '"agg_delivered_mhz":"[0-9.]*"' | cut -d'"' -f4)"
  res="$(printf '%s' "$j" | grep -o '"agg_residency_pct":"[0-9.]*"' | cut -d'"' -f4)"
  win="$(printf '%s' "$j" | grep -o '"agg_window":"[a-z]*"' | cut -d'"' -f4)"
  [ -n "$avg" ] && [ -n "$res" ] || return 1
  avg="${avg%%.*}"
  is_int "$avg" && [ "$avg" -gt 0 ] || return 1
  maxk="$(read_int "$CPUMAX" 2>/dev/null || true)"
  is_int "${maxk:-}" && [ "$maxk" -gt 0 ] || return 1
  printf '%s|%s|%s|%s\n' "$(( avg * 1000 ))" "$maxk" "$res" "${win:-na}"
}

classify_ratio() {
  local ratio="${1:-}" policies="${2:-0}"
  if [ "$policies" -le 0 ] 2>/dev/null; then
    echo "OFFLINE|no readable cpuinfo_avg_freq sources under $ROOT"
    return 2
  fi
  is_int "$ratio" || { echo "OFFLINE|ratio unreadable"; return 2; }
  if   [ "$ratio" -lt 30 ] 2>/dev/null; then echo "IDLE|avg clock deep-idle"; return 0
  elif [ "$ratio" -lt 50 ] 2>/dev/null; then echo "THROTTLED|avg clock heavily under max"; return 0
  elif [ "$ratio" -lt 85 ] 2>/dev/null; then echo "REDUCED|avg clock below nominal"; return 0
  elif [ "$ratio" -le 100 ] 2>/dev/null; then echo "NOMINAL|avg clock near max"; return 0
  else echo "BOOST|avg clock above max"; return 0
  fi
}

if [ "${1:-}" = --test ]; then
  fail=0
  ck() { [ "$1" = "$2" ] || { echo "  FAIL: $3 (got '$1', want '$2')"; fail=1; }; }
  ck "$(classify_ratio 20 4)" "IDLE|avg clock deep-idle" "idle band"
  ck "$(classify_ratio 35 4)" "THROTTLED|avg clock heavily under max" "throttled band"
  ck "$(classify_ratio 60 4)" "REDUCED|avg clock below nominal" "reduced band"
  ck "$(classify_ratio 95 4)" "NOMINAL|avg clock near max" "nominal band"
  ck "$(classify_ratio 115 4)" "BOOST|avg clock above max" "boost band"
  out="$(classify_ratio OFFLINE 0)"
  printf '%s\n' "$out" | grep -q '^OFFLINE|' || { echo "  FAIL: offline guard (got '$out')"; fail=1; }
  td="$(mktemp -d)" || { echo "  FAIL: mktemp"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/cpufreq/policy0" "$td/cpufreq/policy1"
  printf '3000000\n' > "$td/cpufreq/policy0/cpuinfo_avg_freq"
  printf '3500000\n' > "$td/cpufreq/policy0/cpuinfo_max_freq"
  printf '2000000\n' > "$td/cpufreq/policy1/cpuinfo_avg_freq"
  printf '3500000\n' > "$td/cpufreq/policy1/cpuinfo_max_freq"
  got="$(MESH_CPU_AVGFREQ_ROOT="$td/cpufreq" "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"policies":2' || { echo "  FAIL: fixture policies missing ($got)"; fail=1; }
  printf '%s\n' "$got" | grep -q '"ratio":71' || { echo "  FAIL: fixture ratio wrong ($got)"; fail=1; }
  rm -rf "$td"
  trap - EXIT
  # BOTH providers absent => exit 2. MESH_CPU_AVGFREQ_NO_CPPC disables provider 2 so this asserts
  # the real UNREACHABLE path; without it the CPPC fallback would (correctly) rescue the run here
  # and the assertion would be testing nothing.
  MESH_CPU_AVGFREQ_ROOT='/nonexistent/cpufreq' MESH_CPU_AVGFREQ_NO_CPPC=1 "$0" >/dev/null 2>&1
  [ "$?" -eq 2 ] || { echo "  FAIL: both providers missing must exit 2"; fail=1; }

  # PROVIDER 2 ENGAGES when provider 1 is absent: same missing $ROOT, CPPC left enabled.
  ctd="$(mktemp -d)" || { echo "  FAIL: mktemp"; exit 1; }
  cppc_rc=0
  cppc_out="$(MESH_CPU_AVGFREQ_ROOT='/nonexistent/cpufreq' \
              MESH_CPU_AVGFREQ_CPPC_SNAP="$ctd/n" MESH_CPU_AVGFREQ_CPPC_STATE="$ctd/s" \
              "$0" --json 2>/dev/null)" || cppc_rc=$?
  have_cppc=0
  cppc_bin >/dev/null 2>&1 && [ -d /sys/devices/system/cpu/cpu0/acpi_cppc ] && have_cppc=1
  if [ "$have_cppc" = 1 ]; then
    [ "$cppc_rc" = 0 ] || { echo "  FAIL: CPPC provider present but fallback did not engage (rc=$cppc_rc)"; fail=1; }
    printf '%s\n' "$cppc_out" | grep -q '"provider":"acpi_cppc"' \
      || { echo "  FAIL: fallback did not name itself acpi_cppc ($cppc_out)"; fail=1; }
    # RESIDENCY MUST BE PUBLISHED BESIDE THE READING — an unweighted avg with no awake-time context
    # is exactly the sample-read-as-a-state failure this provider was added under.
    printf '%s\n' "$cppc_out" | grep -q '"residency_pct":"[0-9][0-9.]*"' \
      || { echo "  FAIL: CPPC reading published without a residency ($cppc_out)"; fail=1; }
    cavg="$(printf '%s\n' "$cppc_out" | grep -o '"avg_mhz":[0-9]*' | cut -d: -f2)"
    cmax="$(printf '%s\n' "$cppc_out" | grep -o '"max_mhz":[0-9]*' | cut -d: -f2)"
    [ "${cavg:-0}" -gt 0 ] 2>/dev/null && [ "${cavg:-0}" -le "${cmax:-0}" ] 2>/dev/null \
      || { echo "  FAIL: CPPC avg ${cavg}MHz not in (0, max ${cmax}MHz] — the perf scale leaked"; fail=1; }
  fi
  rm -rf "$ctd"
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }

  # REAL-READ gate (rewritten 2026-08-18). It used to end here with an exit 2 and this verdict:
  #   "this is a genuinely absent organ, not a wrong-path read. Switch this node to amd-pstate and
  #    autowire */30 re-wires it."
  # That was WRONG, and wrong in the most expensive way — it read as a closed investigation. It is
  # true that acpi-cpufreq never exports cpuinfo_avg_freq; it does not follow that the node cannot
  # produce the quantity. /sys/devices/system/cpu/cpu*/acpi_cppc/feedback_ctrs was readable on this
  # very node the entire time, carrying the same APERF/MPERF-class ratio amd-pstate would have
  # published, and the sense reported UNREACHABLE beside it for 20 consecutive cron runs. The bug
  # was in the SOURCE LIST, not in the hardware: a sense with one provider had concluded a fact
  # about the node from a fact about a driver. So the gate now demands a live reading from EITHER
  # provider and exits 2 only where both are genuinely gone (a node with neither amd-pstate nor
  # CPPC), which is the only remaining honest n/a.
  rtd="$(mktemp -d)" || { echo "  FAIL: mktemp"; exit 1; }
  live_rc=0
  live="$(MESH_CPU_AVGFREQ_STATE="$rtd/st" MESH_CPU_AVGFREQ_CPPC_SNAP="$rtd/n" \
          MESH_CPU_AVGFREQ_CPPC_STATE="$rtd/s" "$0" --json 2>&1)" || live_rc=$?
  rm -rf "$rtd"
  if [ "$live_rc" = 2 ]; then
    echo "smoke-test: n/a — no average-frequency provider on $(hostname): $ROOT exports no cpuinfo_avg_freq under the $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || echo unknown) driver AND no readable acpi_cppc/feedback_ctrs. Band, fixture, both-absent-exit2 and provider assertions all passed."
    exit 2
  fi
  [ "$live_rc" = 0 ] || { echo "smoke-test: FAIL — live read rc=$live_rc ($live)"; exit 1; }
  lprov="$(printf '%s\n' "$live" | grep -o '"provider":"[a-z_]*"' | cut -d'"' -f4)"
  lratio="$(printf '%s\n' "$live" | grep -o '"ratio":[0-9]*' | cut -d: -f2)"
  is_int "${lratio:-}" || { echo "smoke-test: FAIL — live read produced no ratio ($live)"; exit 1; }
  [ "$lratio" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL — live ratio ${lratio} is not a real reading ($live)"; exit 1; }
  if [ "$lprov" = acpi_cppc ]; then
    printf '%s\n' "$live" | grep -q '"residency_pct":"[0-9][0-9.]*"' \
      || { echo "smoke-test: FAIL — live CPPC reading carries no residency ($live)"; exit 1; }
  fi
  echo "smoke-test: ok (bands + fixture JSON + both-absent exit2 + provider-2 engages + real-read gate: live reading ratio=${lratio}% via ${lprov})"
  exit 0
fi

edge=0
[ "${1:-}" = --edge ] && edge=1
json=0
[ "${1:-}" = --json ] && json=1

ts="$(date -u +%FT%TZ)"
declare -a policies=()
sum_avg=0
sum_max=0
count=0

while IFS='|' read -r pol avg max; do
  [ -n "${pol:-}" ] || continue
  policies+=("$pol")
  sum_avg=$((sum_avg + avg))
  sum_max=$((sum_max + max))
  count=$((count + 1))
done < <(discover_policies)

source=cpuinfo_avg_freq
residency=na
cppc_win=na
if [ "$count" -le 0 ] || [ "$sum_max" -le 0 ]; then
  # provider 1 absent (or unusable). Fall through to CPPC before declaring the organ missing.
  if c="$(discover_cppc)"; then
    IFS='|' read -r sum_avg sum_max residency cppc_win <<< "$c"
    count=1; source=acpi_cppc
  else
    echo "cpu-avgfreq: UNREACHABLE — no cpuinfo_avg_freq under $ROOT and no acpi_cppc provider either" >&2
    exit 2
  fi
fi

ratio=$(( sum_avg * 100 / sum_max ))
avg_mhz=$(( sum_avg / 1000 / count ))
max_mhz=$(( sum_max / 1000 / count ))
class_out="$(classify_ratio "$ratio" "$count")" || exit 2
label="${class_out%%|*}"
short_reason="${class_out#*|}"

state_line="$label"

if [ "$edge" = 1 ]; then
  prev="$(cat "$STATE" 2>/dev/null || true)"
  if [ "$prev" = "$state_line" ]; then
    mesh-state-touch "$STATE"
    exit 0
  fi
  printf '%s\n' "$state_line" > "$STATE"
  mesh-state-touch "$STATE"
fi

if [ "$json" = 1 ]; then
  pols=""
  for p in "${policies[@]}"; do pols="${pols:+$pols,}\"$p\""; done
  printf '{"label":"%s","reason":"%s","provider":"%s","residency_pct":"%s","window":"%s","avg_mhz":%s,"max_mhz":%s,"ratio":%s,"policies":%s,"sources":[%s],"ts":"%s"}\n' \
    "$label" "$short_reason" "$source" "$residency" "$cppc_win" "$avg_mhz" "$max_mhz" "$ratio" "$count" "$pols" "$ts"
  exit 0
fi

if [ "$source" = acpi_cppc ]; then
  printf '[cpu-avgfreq] %s — avg=%sMHz max=%sMHz ratio=%s%% source=acpi_cppc residency=%s%% window=%s (%s)\n' \
    "$label" "$avg_mhz" "$max_mhz" "$ratio" "$residency" "$cppc_win" "$short_reason"
else
  printf '[cpu-avgfreq] %s — avg=%sMHz max=%sMHz ratio=%s%% source=cpuinfo_avg_freq policies=%s (%s)\n' \
    "$label" "$avg_mhz" "$max_mhz" "$ratio" "$count" "$short_reason"
fi
