#!/usr/bin/env bash
# mesh-hear — consent-gated, one-shot microphone capture from a mesh node.
#
#   mesh-hear <IdeaPad|default-string|phone|mac> [-d SECONDS] [-o FILE]
#
# The resulting artifact is always a local 16 kHz mono WAV. Capture is refused
# unless mic_always=yes because an operator explicitly requested this stronger
# gate for the distributed audio organ. See docs/consent.md.
set -euo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
CONSENT_FILE="${MESH_CONSENT:-$MESH_DIR/consent}"
TRACE_BIN="${MESH_TRACE_BIN:-$(command -v mesh-trace 2>/dev/null || true)}"
SAY_BIN="${MESH_SAY_BIN:-$(command -v mesh-say 2>/dev/null || true)}"
PEER_ADDR_BIN="${MESH_PEER_ADDR_BIN:-$(command -v mesh-peer-addr 2>/dev/null || true)}"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8)

usage() {
   echo "usage: mesh-hear <IdeaPad|default-string|phone|mac> [-d seconds] [-o file.wav]" >&2
}

consent_ok() {
  grep -qiE '^[[:space:]]*mic_always[[:space:]]*=[[:space:]]*(yes|true|1)([[:space:]#]|$)' "$CONSENT_FILE" 2>/dev/null
}

trace() {
  local message="$1"
  if [[ -n "$TRACE_BIN" && -x "$TRACE_BIN" ]]; then
    "$TRACE_BIN" "$message" >/dev/null 2>&1 || true
  else
    mkdir -p "$MESH_DIR"
    printf '%s  mesh-hear@%s  ::  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$message" >> "$MESH_DIR/traces.log"
  fi
}

announce() {
  local node="$1"
  printf '[%s] mesh-hear: microphone capture starting on %s\n' "$(date +%H:%M:%S)" "$node" >&2
  if [[ -n "$SAY_BIN" && -x "$SAY_BIN" ]]; then
    "$SAY_BIN" "microphone capture is starting on $node" >/dev/null 2>&1 || true
  fi
}

resolve_peer() {
  local peer="$1"
  [[ -n "$PEER_ADDR_BIN" && -x "$PEER_ADDR_BIN" ]] || {
    echo "mesh-hear: mesh-peer-addr not found" >&2
    return 1
  }
  local addr; addr="$("$PEER_ADDR_BIN" "$peer")"
  # Guard the empty result: an unresolvable label otherwise yields "" → callers ssh user@'' (the
  # empty-host hollow flaw, 2026-06-13 audit). Fail loudly instead of capturing from nowhere.
  [ -n "$addr" ] || { echo "mesh-hear: peer '$peer' did not resolve to an address" >&2; return 1; }
  printf '%s' "$addr"
}

validate_wav() {
  python3 - "$1" <<'PY'
import sys, wave
with wave.open(sys.argv[1], "rb") as wav:
    assert wav.getnchannels() == 1, "not mono"
    assert wav.getframerate() == 16000, "not 16 kHz"
    assert wav.getnframes() > 0, "empty WAV"
PY
}

capture_local() {
  local duration="$1" output="$2"
  command -v arecord >/dev/null 2>&1 || { echo "mesh-hear: arecord not found" >&2; return 1; }
  flock -w 15 /tmp/.mesh-mic.lock \
    timeout "$((duration + 5))" arecord -q -D "${MESH_HEAR_LOCAL_DEVICE:-plughw:0,0}" \
      -f S16_LE -r 16000 -c 1 -d "$duration" -t wav "$output"
}

capture_default_string() {
  local duration="$1" output="$2" addr
  addr="$(resolve_peer default-string)" || { echo "mesh-hear: cannot capture — default-string peer unresolved" >&2; return 1; }
  timeout "$((duration + 15))" ssh "${SSH_OPTS[@]}" "imozerov@$addr" \
    "timeout $((duration + 5)) arecord -q -D '${MESH_HEAR_DS_DEVICE:-plughw:CARD=HID,DEV=0}' -f S16_LE -r 16000 -c 1 -d '$duration' -t wav -" \
    > "$output"
}

capture_phone() {
  local duration="$1" output="$2" addr encoded
  local _pport="${MESH_HEAR_PHONE_PORT:-8022}" _puser="${MESH_HEAR_PHONE_USER:-u0_a380}"
  addr="$(PHONE_IP="${MESH_HEAR_PHONE_ADDR:-}" PHONE_SSH_PORT="$_pport" PHONE_USER="$_puser" mesh-phone-ip 2>/dev/null)"
  [ -n "$addr" ] || { echo "mesh-hear: cannot capture — phone unreachable" >&2; return 1; }
  # Record as Ogg Opus via termux-microphone-record.
  # Path: /sdcard/ (external storage) — MediaRecorder lacks permission to Termux's TMPDIR/HOME.
  # Timing: termux-microphone-record is ASYNC (returns immediately); -l sets max duration,
  # then recording auto-stops. We sleep (duration+2) before catting to let it finish.
  # Decode: IdeaPad has opusdec+oggdemux (gst-plugins-good) but NOT avdec_aac — so Opus only.
  local remote="/sdcard/mesh-hear-$$.ogg"
  encoded="$(mktemp --suffix=.ogg)"

  command -v gst-launch-1.0 >/dev/null 2>&1 || {
    echo "mesh-hear: GStreamer required (gst-launch-1.0 not found)" >&2
    return 1
  }

  # The torch remains on while the phone microphone is active, per docs/consent.md.
  if ! ssh -p "$_pport" "${SSH_OPTS[@]}" "${_puser}@$addr" \
    "termux-wake-lock; termux-torch on >/dev/null 2>&1 || true; trap 'termux-torch off >/dev/null 2>&1 || true; rm -f \"${remote}\"' EXIT; termux-microphone-record -f '${remote}' -l '${duration}' -e opus; sleep $((duration + 2)); cat '${remote}'" \
    > "$encoded"; then
    rm -f "$encoded"
    return 1
  fi

  [ -s "$encoded" ] || { echo "mesh-hear: phone returned empty recording" >&2; rm -f "$encoded"; return 1; }
  local convert_rc=0
  gst-launch-1.0 -q filesrc location="$encoded" ! oggdemux ! opusdec \
    ! audioconvert ! audioresample \
    ! audio/x-raw,format=S16LE,rate=16000,channels=1 ! wavenc \
    ! filesink location="$output" || convert_rc=$?
  rm -f "$encoded"
  return "$convert_rc"
}

capture_mac() {
  # iMac (macOS, no arecord/ffmpeg/brew): record via the system Python 2.7 + PyObjC AVAudioRecorder.
  # The recorder is written to the Mac each call (idempotent, ~700B) so mesh-hear stays self-contained
  # and self-heals. macOS 10.13 High Sierra has no per-app microphone TCC gate (that arrived in 10.14
  # Mojave), so an SSH-launched capture works without a GUI permission grant. Output is a real 16 kHz
  # mono S16 WAV (validate_wav-clean). Proven 2026-06-18 on iMac-Rozalia.
  local duration="$1" output="$2"
  local host="${MESH_HEAR_MAC_HOST:-ilya@192.168.8.214}"
  local remote="/tmp/.mesh-imac-$$.wav"
  ssh "${SSH_OPTS[@]}" "$host" 'mkdir -p ~/.mesh && cat > ~/.mesh/imac-rec.py' <<'PY'
import sys, time
import AVFoundation as AV
from Foundation import NSURL
dur = float(sys.argv[1]); out = sys.argv[2]
s = {"AVFormatIDKey": 1819304813, "AVSampleRateKey": 16000.0, "AVNumberOfChannelsKey": 1,
     "AVLinearPCMBitDepthKey": 16, "AVLinearPCMIsBigEndianKey": False, "AVLinearPCMIsFloatKey": False}
r = AV.AVAudioRecorder.alloc().initWithURL_settings_error_(NSURL.fileURLWithPath_(out), s, None)
if r is None: sys.exit(1)
r.prepareToRecord(); r.record(); time.sleep(dur + 0.3); r.stop()
PY
  timeout "$((duration + 20))" ssh "${SSH_OPTS[@]}" "$host" \
    "/usr/bin/python ~/.mesh/imac-rec.py '$duration' '$remote' 2>/dev/null; cat '$remote'; rm -f '$remote'" \
    > "$output"
}

if [[ "${1:-}" == "--test" ]]; then
  failures=0
  for dep in python3 timeout arecord ssh; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; failures=1; }
  done
  if ! command -v gst-launch-1.0 >/dev/null 2>&1; then
    echo "smoke-test: WARN (gst-launch-1.0 missing — phone backend will fail)"
  fi
  ((failures)) && exit 1
  echo "smoke-test: ok"
  exit 0
fi

node="${1:-}"
[[ -n "$node" ]] || { usage; exit 2; }
shift
duration=5
output=""
while (($#)); do
  case "$1" in
    -d|--duration) duration="${2:-}"; shift 2 ;;
    -o|--output) output="${2:-}"; shift 2 ;;
    *) usage; exit 2 ;;
  esac
done
[[ "$duration" =~ ^[1-9][0-9]*$ ]] && ((duration <= 300)) || {
  echo "mesh-hear: duration must be an integer from 1 to 300 seconds" >&2
  exit 2
}

consent_ok || {
  echo "mesh-hear: REFUSED — mic_always = yes is required in $CONSENT_FILE" >&2
  exit 3
}

case "${node,,}" in
  local|ideapad|imozerov-ideapad-3-15iil05) canonical=IdeaPad; backend=local ;;
  ds|server|default-string|imozerov-default-string) canonical=default-string; backend=default-string ;;
  phone|redmi|redmi-10|"redmi 10") canonical=phone; backend=phone ;;
  mac|imac|imac-rozalia|mac-rozalia) canonical=mac; backend=mac ;;
  *) echo "mesh-hear: unknown node '$node'" >&2; usage; exit 2 ;;
esac

output="${output:-$(mktemp --tmpdir "mesh-hear-${canonical}-XXXXXX.wav")}"
mkdir -p "$(dirname "$output")"
tmp="${output}.part.$$"
trap 'rm -f "$tmp"' EXIT

announce "$canonical"
trace "[start] mesh-hear began capturing microphone on $canonical for ${duration}s"
rc=0
case "$backend" in
  local) capture_local "$duration" "$tmp" || rc=$? ;;
  default-string) capture_default_string "$duration" "$tmp" || rc=$? ;;
  phone) capture_phone "$duration" "$tmp" || rc=$? ;;
  mac) capture_mac "$duration" "$tmp" || rc=$? ;;
esac

if ((rc != 0)) || [[ ! -s "$tmp" ]]; then
  trace "[stop] mesh-hear capture failed on $canonical (rc=$rc)"
  echo "mesh-hear: capture failed on $canonical" >&2
  ((rc != 0)) || rc=1
  exit "$rc"
fi
validate_wav "$tmp" || {
  trace "[stop] mesh-hear produced invalid WAV on $canonical"
  echo "mesh-hear: invalid WAV returned by $canonical" >&2
  exit 1
}
mv "$tmp" "$output"
trap - EXIT
trace "[stop] mesh-hear stopped capturing microphone on $canonical; artifact=$output"
printf '%s\n' "$output"
