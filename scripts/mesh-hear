#!/usr/bin/env bash
# mesh-hear — consent-gated, one-shot microphone capture from a mesh node.
#
#   mesh-hear <IdeaPad|default-string|phone> [-d SECONDS] [-o FILE]
#
# The resulting artifact is always a local 16 kHz mono WAV. Capture is refused
# unless mic_always=yes because an operator explicitly requested this stronger
# gate for the distributed audio organ. See docs/consent.md.
set -euo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
CONSENT_FILE="${MESH_CONSENT:-$MESH_DIR/consent}"
TRACE_BIN="${MESH_TRACE_BIN:-$(command -v mesh-trace 2>/dev/null || true)}"
SAY_BIN="${MESH_SAY_BIN:-$(command -v mesh-say 2>/dev/null || true)}"
PEER_ADDR_BIN="${MESH_PEER_ADDR_BIN:-$(command -v mesh-peer-addr 2>/dev/null || true)}"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8)

usage() {
  echo "usage: mesh-hear <IdeaPad|default-string|phone> [-d seconds] [-o file.wav]" >&2
}

consent_ok() {
  grep -qiE '^[[:space:]]*mic_always[[:space:]]*=[[:space:]]*(yes|true|1)([[:space:]#]|$)' "$CONSENT_FILE" 2>/dev/null
}

trace() {
  local message="$1"
  if [[ -n "$TRACE_BIN" && -x "$TRACE_BIN" ]]; then
    "$TRACE_BIN" "$message" >/dev/null 2>&1 || true
  else
    mkdir -p "$MESH_DIR"
    printf '%s  mesh-hear@%s  ::  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$message" >> "$MESH_DIR/traces.log"
  fi
}

announce() {
  local node="$1"
  printf '[%s] mesh-hear: microphone capture starting on %s\n' "$(date +%H:%M:%S)" "$node" >&2
  if [[ -n "$SAY_BIN" && -x "$SAY_BIN" ]]; then
    "$SAY_BIN" "microphone capture is starting on $node" >/dev/null 2>&1 || true
  fi
}

resolve_peer() {
  local peer="$1"
  [[ -n "$PEER_ADDR_BIN" && -x "$PEER_ADDR_BIN" ]] || {
    echo "mesh-hear: mesh-peer-addr not found" >&2
    return 1
  }
  "$PEER_ADDR_BIN" "$peer"
}

validate_wav() {
  python3 - "$1" <<'PY'
import sys, wave
with wave.open(sys.argv[1], "rb") as wav:
    assert wav.getnchannels() == 1, "not mono"
    assert wav.getframerate() == 16000, "not 16 kHz"
    assert wav.getnframes() > 0, "empty WAV"
PY
}

capture_local() {
  local duration="$1" output="$2"
  command -v arecord >/dev/null 2>&1 || { echo "mesh-hear: arecord not found" >&2; return 1; }
  flock -w 15 /tmp/.mesh-mic.lock \
    timeout "$((duration + 5))" arecord -q -D "${MESH_HEAR_LOCAL_DEVICE:-plughw:0,0}" \
      -f S16_LE -r 16000 -c 1 -d "$duration" -t wav "$output"
}

capture_default_string() {
  local duration="$1" output="$2" addr
  addr="$(resolve_peer default-string)"
  timeout "$((duration + 15))" ssh "${SSH_OPTS[@]}" "imozerov@$addr" \
    "timeout $((duration + 5)) arecord -q -D '${MESH_HEAR_DS_DEVICE:-plughw:0,0}' -f S16_LE -r 16000 -c 1 -d '$duration' -t wav -" \
    > "$output"
}

capture_phone() {
  local duration="$1" output="$2" addr remote encoded
  addr="${MESH_HEAR_PHONE_ADDR:-$(resolve_peer Redmi)}"
  remote="\${TMPDIR:-\$HOME}/mesh-hear-\$\$.m4a"
  encoded="$(mktemp --suffix=.m4a)"

  command -v ffmpeg >/dev/null 2>&1 || command -v gst-launch-1.0 >/dev/null 2>&1 || {
    echo "mesh-hear: ffmpeg or GStreamer is required to convert the phone recording to WAV" >&2
    return 1
  }

  # The torch remains on while the phone microphone is active, per docs/consent.md.
  if ! ssh -p "${MESH_HEAR_PHONE_PORT:-8022}" "${SSH_OPTS[@]}" "${MESH_HEAR_PHONE_USER:-u0_a386}@$addr" \
    "termux-wake-lock; termux-torch on >/dev/null 2>&1 || true; trap 'termux-torch off >/dev/null 2>&1 || true; rm -f \"$remote\"' EXIT; termux-microphone-record -f \"$remote\" -l '$duration' >/dev/null; cat \"$remote\"" \
    > "$encoded"; then
    rm -f "$encoded"
    return 1
  fi

  local convert_rc=0
  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -hide_banner -loglevel error -i "$encoded" -ar 16000 -ac 1 -f wav "$output" || convert_rc=$?
  else
    gst-launch-1.0 -q filesrc location="$encoded" ! decodebin ! audioconvert ! audioresample \
      ! audio/x-raw,format=S16LE,rate=16000,channels=1 ! wavenc ! filesink location="$output" || convert_rc=$?
  fi
  rm -f "$encoded"
  return "$convert_rc"
}

if [[ "${1:-}" == "--test" ]]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (python3 missing)"; exit 1; }
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (timeout missing)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

node="${1:-}"
[[ -n "$node" ]] || { usage; exit 2; }
shift
duration=5
output=""
while (($#)); do
  case "$1" in
    -d|--duration) duration="${2:-}"; shift 2 ;;
    -o|--output) output="${2:-}"; shift 2 ;;
    *) usage; exit 2 ;;
  esac
done
[[ "$duration" =~ ^[1-9][0-9]*$ ]] && ((duration <= 300)) || {
  echo "mesh-hear: duration must be an integer from 1 to 300 seconds" >&2
  exit 2
}

consent_ok || {
  echo "mesh-hear: REFUSED — mic_always = yes is required in $CONSENT_FILE" >&2
  exit 3
}

case "${node,,}" in
  local|ideapad|imozerov-ideapad-3-15iil05) canonical=IdeaPad; backend=local ;;
  ds|server|default-string|imozerov-default-string) canonical=default-string; backend=default-string ;;
  phone|redmi|redmi-10|"redmi 10") canonical=phone; backend=phone ;;
  *) echo "mesh-hear: unknown node '$node'" >&2; usage; exit 2 ;;
esac

output="${output:-$(mktemp --tmpdir "mesh-hear-${canonical}-XXXXXX.wav")}"
mkdir -p "$(dirname "$output")"
tmp="${output}.part.$$"
trap 'rm -f "$tmp"' EXIT

announce "$canonical"
trace "[start] mesh-hear began capturing microphone on $canonical for ${duration}s"
rc=0
case "$backend" in
  local) capture_local "$duration" "$tmp" || rc=$? ;;
  default-string) capture_default_string "$duration" "$tmp" || rc=$? ;;
  phone) capture_phone "$duration" "$tmp" || rc=$? ;;
esac

if ((rc != 0)) || [[ ! -s "$tmp" ]]; then
  trace "[stop] mesh-hear capture failed on $canonical (rc=$rc)"
  echo "mesh-hear: capture failed on $canonical" >&2
  ((rc != 0)) || rc=1
  exit "$rc"
fi
validate_wav "$tmp" || {
  trace "[stop] mesh-hear produced invalid WAV on $canonical"
  echo "mesh-hear: invalid WAV returned by $canonical" >&2
  exit 1
}
mv "$tmp" "$output"
trap - EXIT
trace "[stop] mesh-hear stopped capturing microphone on $canonical; artifact=$output"
printf '%s\n' "$output"
