#!/usr/bin/env bash
# orphan-ok: on-demand live RTX clock-reason mask; no periodic sampling is declared.
# mesh-gpu-throttle — NVIDIA's active GPU clock-throttle reason bitmask.
# This reports the driver's raw mask; it does not infer a cause from temperature or clock rate.
# Missing GPU/driver telemetry is UNKNOWN (exit 2).
#
#   mesh-gpu-throttle          one live reading
#   mesh-gpu-throttle --json   machine-readable reading
#   mesh-gpu-throttle --test   fixture parser + real NVIDIA driver read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SMI="${MESH_GPU_THROTTLE_SMI:-nvidia-smi}"

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

read_mask() {
  local raw first index mask
  raw="$("$SMI" --query-gpu=index,clocks_throttle_reasons.active --format=csv,noheader,nounits 2>/dev/null)" || return 2
  first="$(printf '%s\n' "$raw" | sed '/^[[:space:]]*$/d' | head -n1)"
  [ -n "$first" ] || return 2
  IFS=',' read -r index mask _rest <<<"$first"
  index="$(trim "${index:-}")"
  mask="$(trim "${mask:-}")"
  [[ "$index" =~ ^[0-9]+$ ]] || return 2
  [[ "$mask" =~ ^0x[0-9a-fA-F]+$ ]] || return 2
  printf '%s %s\n' "$index" "$mask"
}

render() {
  local mode="$1" reading index mask active ts
  reading="$(read_mask)" || return 2
  read -r index mask <<<"$reading"
  if [[ "$mask" =~ ^0x0+$ ]]; then active=false; else active=true; fi
  ts="$(date -u +%FT%TZ)"
  if [ "$mode" = json ]; then
    printf '{"gpu_index":%s,"active_mask":"%s","active":%s,"source":"nvidia-smi","ts":"%s"}\n' \
      "$index" "$mask" "$active" "$ts"
  else
    printf '[gpu-throttle] gpu_index=%s active_mask=%s active=%s source=nvidia-smi ts=%s\n' \
      "$index" "$mask" "$active" "$ts"
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)' >&2; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat >"$td/smi" <<'EOF'
#!/usr/bin/env bash
printf '0, 0x0000000000000004\n'
EOF
  chmod +x "$td/smi"
  fixture="$(MESH_GPU_THROTTLE_SMI="$td/smi" "$0" --json)" || {
    echo 'smoke-test: FAIL (fixture read)' >&2; exit 1;
  }
  [[ "$fixture" == *'"gpu_index":0,"active_mask":"0x0000000000000004","active":true'* ]] || {
    echo "smoke-test: FAIL (fixture mask not preserved: $fixture)" >&2; exit 1;
  }
  cat >"$td/smi" <<'EOF'
#!/usr/bin/env bash
printf '0, N/A\n'
EOF
  chmod +x "$td/smi"
  MESH_GPU_THROTTLE_SMI="$td/smi" "$0" --json >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (unavailable mask must exit 2, got $rc)" >&2; exit 1; }

  live="$(render json 2>/dev/null)"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo 'smoke-test: n/a — fixture passed; live NVIDIA clock-reason mask unavailable (exit 2)' >&2
    exit 2
  fi
  [[ "$live" =~ \"active_mask\":\"0x[0-9a-fA-F]+\" ]] || {
    echo "smoke-test: FAIL (live reading malformed: $live)" >&2; exit 1;
  }
  echo "smoke-test: ok (fixture + real NVIDIA clock-reason read: $live)"
  exit 0
fi

mode=text
case "${1:-}" in
  '') ;;
  --json) mode=json ;;
  *) echo 'usage: mesh-gpu-throttle [--json|--test]' >&2; exit 2 ;;
esac

render "$mode" || {
  echo 'gpu-throttle: UNREACHABLE — nvidia-smi did not provide a numeric clock-reason mask' >&2
  exit 2
}
