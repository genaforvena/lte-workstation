#!/usr/bin/env bash
# mesh-eye — a CONSENT-GATED ambient sense for a node with a camera and/or mic.
#
# HARD RULE (operator, 2026-06-08, "ад критично — только если сам разрешают; тут только я"):
# capture ONLY where everyone present has explicitly consented. The gate is STRUCTURAL,
# not a promise — this tool REFUSES unless ~/.mesh/consent grants it, and it prints the
# scope it was granted for. Capturing anyone who has not personally allowed it is forbidden.
#
# Privacy by construction: NO raw frame or audio is kept. Captures go to a temp file,
# are reduced to abstract, non-identifying SIGNALS (light / sound / motion), then deleted.
# The log holds numbers and a coarse state — never an image, never a recording.
#
#   mesh-eye --now        one consent-checked capture -> signals -> ~/.mesh/eye.log
#   mesh-eye --loop [s]    sparse periodic sense (default 900s), quiet, consent-gated
#   mesh-eye --state       print the latest derived state line
#   mesh-eye --rhythm      summarise the room's learned daily rhythm from the log
#   mesh-eye --consent     show the current consent grant (or how to make one)
#   mesh-eye --describe    ONE richer read via the mind (the only path that spends a call)
#
# Signals are computed LOCALLY (no LLM, no cost): brightness from the frame, loudness from
# the audio. Cheap enough to run forever; the mesh consumes the STATE to time itself
# (speak when there is light+life, stay quiet in a dark silent room, leave an empty room be).
set -uo pipefail
MESH="$HOME/.mesh"; LOG="$MESH/eye.log"; CONSENT="$MESH/consent"
CAM="${EYE_CAM:-/dev/video0}"; SEC="${EYE_AUDIO_SEC:-4}"
mkdir -p "$MESH"
now(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

consent_ok(){
  [ -f "$CONSENT" ] || return 1
  grep -qiE '^[[:space:]]*camera[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" \
    || grep -qiE '^[[:space:]]*mic[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT"
}
cam_ok(){ grep -qiE '^[[:space:]]*camera[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" 2>/dev/null; }
mic_ok(){ grep -qiE '^[[:space:]]*mic[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" 2>/dev/null; }
scope(){ grep -iE '^[[:space:]]*scope[[:space:]]*=' "$CONSENT" 2>/dev/null | head -1 | sed 's/^[^=]*=[[:space:]]*//'; }

refuse(){
  echo "mesh-eye: REFUSED — capture is consent-gated and no grant was found." >&2
  echo "  This node will not look or listen without explicit, scoped consent." >&2
  echo "  To grant (only where everyone present has personally allowed it), write $CONSENT:" >&2
  echo "    camera = yes" >&2
  echo "    mic    = yes" >&2
  echo "    scope  = the operator's own room; only the operator is present" >&2
  exit 3
}

# --- local, free signal extraction ----------------------------------------
brightness(){ # mean luminance 0..255 of a jpeg, via whatever is installed
  local f="$1"
  if command -v convert >/dev/null 2>&1; then
    convert "$f" -colorspace Gray -format "%[fx:mean*255]" info: 2>/dev/null && return
  fi
  python3 - "$f" <<'PY' 2>/dev/null && return
import sys
try:
    from PIL import Image
    im=Image.open(sys.argv[1]).convert("L"); px=list(im.getdata())
    print(round(sum(px)/len(px),1))
except Exception: sys.exit(1)
PY
  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -nostdin -i "$f" -vf signalstats -f null - 2>&1 | grep -oE 'YAVG:[0-9.]+' | head -1 | cut -d: -f2 && return
  fi
  echo "NA"
}
loudness(){ # "rms peak" of a wav
  python3 - "$1" <<'PY' 2>/dev/null || echo "NA NA"
import sys,wave,audioop
try:
    w=wave.open(sys.argv[1],'rb'); d=w.readframes(w.getnframes())
    print(audioop.rms(d,2), audioop.max(d,2))
except Exception: print("NA NA")
PY
}

classify(){ # brightness rms  ->  light  sound  state
  python3 - "$1" "$2" <<'PY'
import sys
b=sys.argv[1]; r=sys.argv[2]
def f(x):
    try: return float(x)
    except: return None
B,R=f(b),f(r)
light = "unknown" if B is None else ("dark" if B<25 else "dim" if B<70 else "lit" if B<150 else "bright")
sound = "unknown" if R is None else ("silent" if R<40 else "quiet" if R<400 else "voices" if R<3000 else "loud")
# coarse state the mesh can act on
if B is None or R is None: state="unknown"
elif light=="dark" and sound in ("silent","quiet"): state="dark-quiet"      # asleep / empty-night -> stay silent
elif sound in ("voices","loud"): state="active"                              # someone is here & audible
elif light in ("lit","bright") and sound in ("silent","quiet"): state="present-calm"  # working quietly
else: state="ambient"
print(f"{light} {sound} {state}")
PY
}

capture_once(){
  consent_ok || refuse
  local tmpdir frame wav b r cls
  tmpdir="$(mktemp -d /tmp/mesh-eye.XXXXXX)"; frame="$tmpdir/f.jpg"; wav="$tmpdir/a.wav"
  b="NA"; r="NA NA"
  if cam_ok; then
    timeout 20 gst-launch-1.0 -e v4l2src device="$CAM" num-buffers=8 ! videoconvert ! jpegenc \
      ! multifilesink location="$tmpdir/f-%02d.jpg" >/dev/null 2>&1 || true
    local best; best="$(ls -S "$tmpdir"/f-*.jpg 2>/dev/null | head -1)"
    [ -n "$best" ] && cp "$best" "$frame" && b="$(brightness "$frame")"
  fi
  if mic_ok; then
    ( timeout $((SEC+2)) pw-record --rate 16000 --channels 1 "$wav" 2>/dev/null ) \
      || ( timeout $((SEC+2)) arecord -q -f S16_LE -r 16000 -c1 "$wav" 2>/dev/null ) || true
    [ -s "$wav" ] && r="$(loudness "$wav")"
  fi
  rm -rf "$tmpdir"                       # <-- raw sight & sound destroyed; only signals survive
  cls="$(classify "$b" "$(echo "$r" | awk '{print $1}')")"
  local line; line="$(now)  bright=$b  rms=$(echo "$r" | awk '{print $1}')  peak=$(echo "$r" | awk '{print $2}')  | $cls"
  echo "$line" >> "$LOG"
  echo "$line"
}

case "${1:-}" in
  --consent)
    if consent_ok; then echo "consent: GRANTED"; echo "  camera=$(cam_ok && echo yes || echo no)  mic=$(mic_ok && echo yes || echo no)"; echo "  scope: $(scope)";
    else refuse; fi ;;
  --state)  tail -1 "$LOG" 2>/dev/null || echo "no readings yet"; ;;
  --rhythm)
    [ -f "$LOG" ] || { echo "no log yet"; exit 0; }
    echo "room rhythm (state count by UTC hour):"
    awk '{ h=substr($1,12,2); st=$NF; c[h" "st]++ } END { for (k in c) print "  "k": "c[k] }' "$LOG" | sort ;;
  --describe)
    consent_ok || refuse
    f="$(mktemp /tmp/mesh-eye-d.XXXXXX.jpg)"
    timeout 20 gst-launch-1.0 -e v4l2src device="$CAM" num-buffers=8 ! videoconvert ! jpegenc \
      ! multifilesink location="${f%.jpg}-%02d.jpg" >/dev/null 2>&1 || true
    best="$(ls -S "${f%.jpg}"-*.jpg 2>/dev/null | head -1)"; [ -n "$best" ] && mv "$best" "$f"; rm -f "${f%.jpg}"-*.jpg
    if command -v opencode >/dev/null 2>&1; then
      opencode run "Describe this room image in one neutral sentence — light, occupancy, mood. Do NOT identify or describe any person's appearance. Image: $f" 2>/dev/null
    else
      claude -p "Describe this room image in one neutral sentence (light, occupancy, mood); do NOT identify or describe any person. $f" 2>/dev/null
    fi
    rm -f "$f" ;;
  --loop)
    consent_ok || refuse
    iv="${2:-900}"; echo "[mesh-eye] consent OK ($(scope)); sensing every ${iv}s (signals only, no media kept)"
    HOST="$(hostname)"; touch "$MESH/traces.log"; echo "$(now)  mesh-eye@$HOST  ::  [sense] START: periodic signal capture (every ${iv}s)" >> "$MESH/traces.log"
    while true; do capture_once >/dev/null 2>&1 || true; sleep "$iv"; done ;;
  ""|--now)  capture_once ;;
  *) echo "usage: mesh-eye [--now|--loop [s]|--state|--rhythm|--consent|--describe]" >&2; exit 1 ;;
esac
