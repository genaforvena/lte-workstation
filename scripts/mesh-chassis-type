#!/usr/bin/env bash
# orphan-ok: on-demand firmware identity probe; no recurring consumer owns chassis form-factor
#   sampling yet, so scheduling this uncommitted sense would create a false landed reflex.
# mesh-chassis-type — live firmware chassis-class sense from DMI sysfs.
#
# A chassis type is a physical form-factor signal exposed by the machine firmware. This is
# deliberately a small raw sense: it reports the kernel's value and does not infer portability,
# battery presence, or mobility from it. Missing/unreadable DMI is UNKNOWN and exits 2.
#
#   mesh-chassis-type          one-shot reading
#   mesh-chassis-type --json   machine-readable reading
#   mesh-chassis-type --test   fixture parser + real DMI read gate
set -u
export PATH="$HOME/.local/bin:$PATH"

SOURCE="${MESH_CHASSIS_TYPE_FILE:-/sys/class/dmi/id/chassis_type}"
STATE="${MESH_CHASSIS_TYPE_STATE:-$HOME/.mesh/.chassis-type-state}"

label_for() {
  case "$1" in
    1) echo Other;; 2) echo Unknown;; 3) echo Desktop;; 4) echo Low-profile-Desktop;;
    5) echo Pizza-Box;; 6) echo Mini-Tower;; 7) echo Tower;; 8) echo Portable;;
    9) echo Laptop;; 10) echo Notebook;; 11) echo Hand-Held;; 12) echo Docking-Station;;
    13) echo All-In-One;; 14) echo Sub-Notebook;; 15) echo Space-Saving;;
    16) echo Lunch-Box;; 17) echo Main-Server-Chassis;; 18) echo Expansion-Chassis;;
    19) echo Sub-Chassis;; 20) echo Bus-Expansion-Chassis;; 21) echo Peripheral-Chassis;;
    22) echo RAID-Chassis;; 23) echo Rack-Mount-Chassis;; 24) echo Sealed-Case-PC;;
    25) echo Multi-System;; 26) echo CompactPCI;; 27) echo AdvancedTCA;; 28) echo Blade;;
    29) echo Blade-Enclosing;; 30) echo Tablet;; 31) echo Convertible;; 32) echo Detachable;;
    *) echo Reserved-or-Unknown;;
  esac
}

read_value() {
  local value
  [ -r "$SOURCE" ] || return 1
  value="$(tr -d '[:space:]' < "$SOURCE" 2>/dev/null)" || return 1
  case "$value" in ''|*[!0-9]*) return 1;; esac
  printf '%s\n' "$value"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  printf '9\n' > "$td/chassis_type"
  got="$(MESH_CHASSIS_TYPE_FILE="$td/chassis_type" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read)"; exit 1;
  }
  printf '%s\n' "$got" | grep -q '"type":9' || { echo "smoke-test: FAIL (fixture type: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"Laptop"' || { echo "smoke-test: FAIL (fixture label: $got)"; exit 1; }
  MESH_CHASSIS_TYPE_FILE="$td/missing" "$0" >/dev/null 2>&1
  [ "$?" -eq 2 ] || { echo "smoke-test: FAIL (missing DMI must exit 2)"; exit 1; }
  [ -r /sys/class/dmi/id/chassis_type ] || { echo "smoke-test: n/a (DMI chassis type unavailable)"; exit 2; }
  live="$($0 --json 2>/dev/null)" || { echo "smoke-test: FAIL (live DMI read)"; exit 1; }
  printf '%s\n' "$live" | grep -q '"type":[0-9]' || { echo "smoke-test: FAIL (live JSON: $live)"; exit 1; }
  echo "smoke-test: ok (fixture + unreachable exit-2 + real DMI read)"
  exit 0
fi

value="$(read_value)" || {
  echo "mesh-chassis-type: UNREACHABLE — cannot read $SOURCE" >&2
  exit 2
}
label="$(label_for "$value")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" || { echo "mesh-chassis-type: cannot create state directory" >&2; exit 1; }
printf 'type=%s|label=%s|source=%s|ts=%s\n' "$value" "$label" "$SOURCE" "$ts" > "$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo "mesh-chassis-type: cannot stamp live state" >&2; exit 1; }

if [ "${1:-}" = --json ]; then
  printf '{"type":%s,"label":"%s","source":"%s","ts":"%s"}\n' "$value" "$label" "$SOURCE" "$ts"
else
  printf '[chassis-type] %s — type=%s source=%s @ %s\n' "$label" "$value" "$SOURCE" "$ts"
fi
