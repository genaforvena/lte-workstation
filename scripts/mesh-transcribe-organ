#!/usr/bin/env bash
# mesh-transcribe-organ — source-agnostic WAV -> filtered text.
# Uses the strongest installed whisper.cpp model by default.
set -euo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
# Real whisper binary (overridable). Heavy — route through the niced+serialized shim (mesh-whisper-run)
# so an ad-hoc transcribe can't OOM the box (chat-review/transcribe-path-nice: the tg-mind's unniced
# 4-file loop through here was half the 20:05-20:12Z OOM storm). The shim is a drop-in; the real binary
# rides MESH_WHISPER_BIN into it. Fall back to the raw binary if the shim isn't deployed.
WHISPER_REAL="${MESH_WHISPER_BIN:-$MESH_DIR/whispercpp/main}"
_WRUN="$HOME/.local/bin/mesh-whisper-run"
if [[ -x "$_WRUN" ]]; then WHISPER_BIN="$_WRUN"; export MESH_WHISPER_BIN="$WHISPER_REAL"; else WHISPER_BIN="$WHISPER_REAL"; fi
# "strongest installed" is probed, not assumed: a node with only ggml-base.bin (ds) must
# transcribe degraded rather than be dead-by-default on a model it never had.
strongest_model() {
  local m
  for m in ggml-large-v3-turbo.bin ggml-base.bin ggml-base.en.bin for-tests-ggml-tiny.bin; do
    [[ -s "$MESH_DIR/whispercpp/models/$m" ]] && { echo "$MESH_DIR/whispercpp/models/$m"; return; }
  done
  echo "$MESH_DIR/whispercpp/models/ggml-large-v3-turbo.bin"   # nothing installed: report the canonical ask
}
MODEL="${MESH_TRANSCRIBE_MODEL:-$(strongest_model)}"
FILTER_BIN="${MESH_WHISPER_FILTER:-$(command -v mesh-whisper-filter 2>/dev/null || true)}"

if [[ "${1:-}" == "--test" ]]; then
  [[ -x "$WHISPER_REAL" ]] || { echo "smoke-test: FAIL (whisper missing: $WHISPER_REAL)"; exit 1; }
  # run through whatever $WHISPER_BIN resolves to (the shim when deployed) → exercises the real path end-to-end
  "$WHISPER_BIN" --help 2>&1 | grep -qi 'whisper' \
    || { echo "smoke-test: FAIL (whisper binary at $WHISPER_BIN does NOT run — broken/permission/arch)"; exit 1; }
  [[ -s "$MODEL" ]] || { echo "smoke-test: FAIL (model missing: $MODEL)"; exit 1; }
  python3 -c 'import wave; import re; import sys; assert "wave" in sys.modules; assert "re" in sys.modules' \
    || { echo "smoke-test: FAIL (python3 missing wave or re — required for WAV validation + text filter)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

wav="${1:-}"
[[ -n "$wav" && $# -eq 1 ]] || { echo "usage: mesh-transcribe-organ <audio.wav>" >&2; exit 2; }
[[ -r "$wav" ]] || { echo "mesh-transcribe-organ: unreadable WAV: $wav" >&2; exit 2; }
python3 - "$wav" <<'PY' >/dev/null
import sys, wave
with wave.open(sys.argv[1], "rb") as wav:
    assert wav.getnframes() > 0
PY

text="$({ "$WHISPER_BIN" -m "$MODEL" -f "$wav" -nt -l auto -t "${MESH_TRANSCRIBE_THREADS:-4}" 2>/dev/null || true; } \
  | python3 -c 'import re,sys; s=sys.stdin.read(); s=re.sub(r"\[[^]]*\]|\([^)]*\)|\*[^*]*\*", "", s); print(" ".join(s.split()))')"

[[ -n "$text" ]] || exit 0
if [[ -n "$FILTER_BIN" && -x "$FILTER_BIN" ]]; then
  "$FILTER_BIN" --wav "$wav" --text "$text" >/dev/null || exit 0
fi
printf '%s\n' "$text"
