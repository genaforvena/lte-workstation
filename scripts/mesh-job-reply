#!/usr/bin/env python3
"""mesh-job-reply — when an employer invites him, answer with real times, once, and prove it landed.

  mesh-job-reply [--dry] [--tg] [--json] [--max N]
  mesh-job-reply --test

# reflex-cadence: 41 */2 * * *
# reflex-args: --tg

An приглашение that sits unanswered for three days is worth less than one answered in an hour,
and the operator asked for the lane to run itself (2026-08-20, «на рефлексах целиком»). This is
the only tool in the lane that SPEAKS to an employer without him in the loop, so every guard is
load-bearing:

* **Armed, not merely installed.** Refuses unless `MESH_JOB_AUTOREPLY=on` (`~/.mesh/nodes`).
* **One trigger, narrowly defined.** An hh negotiation whose status is `interview` — hh's own
  word for приглашение — and whose chat does not already end with a message from us. Nothing
  else fires it; a chatty employer asking about salary is escalated, never answered.
* **The words are assembled, never generated.** Availability comes from `mesh-job-cal --free`,
  which is the single source of a proposable hour, and the sentence around it is fixed text.
  Nothing about compensation, notice, relocation or experience is ever composed here — those
  are `applying-on-his-behalf.md`'s "never invented" list, and a message containing one of
  those questions stops the tool.
* **The artifact is the thread, not the click.** hh renders a send button that can be clicked
  on a page that has navigated out from under it — the browser is shared with `mesh-job-track`,
  `mesh-doctor`'s hourly `--test`, and any mind in a pane. So after sending, the thread is
  RE-READ and must contain our own sentence, or the row stays unanswered and says so.
* **He is told immediately, with the exact text.** A message sent under his name that he learns
  about later is worse than no message.

State: `~/.mesh/job/reply-state.json` (vacancy_id -> what was sent, when, and whether the thread
confirmed it). Sent copies: `~/.mesh/job/sent/`.
"""
import argparse, json, os, pathlib, re, subprocess, sys, time

os.environ["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin")

HOME = pathlib.Path.home()
MESH = HOME / ".mesh"
STATE = MESH / "job" / "reply-state.json"
LOG = MESH / "job" / "hh-drive.log"
LETTERS = MESH / "job" / "letters"
SENT = MESH / "job" / "sent"
HH, CAL, TG = "mesh-hh-drive", "mesh-job-cal", "mesh-tg"

# Questions the lane must not answer on his behalf. Presence of ANY of these in the employer's
# last message turns a reply into an escalation — see applying-on-his-behalf.md's refusal list.
BLOCKERS = [
    r"ожидани[яй] по (зарплат|доход|компенсац)", r"зарплатн\w* ожидани", r"сколько (вы )?хотите",
    r"желаем\w* (уровень )?дохода", r"вилк[ауи]", r"salary expectation", r"compensation",
    r"тестово[ег] задани", r"take[- ]home", r"test task",
    r"гражданств", r"citizenship", r"work authorisation", r"work authorization",
    r"релокац", r"relocat", r"готовы ли вы переехать",
    r"когда (вы )?(готовы|сможете) выйти", r"notice period",
    r"анкет[уы]", r"заполните форму", r"опросник",
]



def node_env(key, default="off"):
    """Read a node-local switch from ~/.mesh/nodes WITHOUT sourcing it.

    cron gives a reflex an environment with nothing in it — no BASH_ENV, no login shell — so a
    gate that reads `os.environ` alone is armed only in a mind's pane. `mesh-job-apply` refused
    on every scheduled run for exactly that reason (4 of 4 in ~/.mesh/job-apply.log) while it
    worked by hand, which reads as "the node is not armed" rather than "the reflex cannot see
    the arming". Process env still wins, so a caller can override for one run."""
    v = os.environ.get(key)
    if v is not None:
        return v
    try:
        txt = (pathlib.Path.home() / ".mesh" / "nodes").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return default
    hit = None
    for line in txt.splitlines():
        m = re.match(r"\s*(?:export\s+)?%s=[\"']?([^\"'#\s]*)" % re.escape(key), line)
        if m:
            hit = m.group(1)
    return hit if hit is not None else default

CAP = int(node_env("MESH_JOB_REPLY_CAP", "3"))


def drive(args, timeout=120):
    return subprocess.run([HH] + args, capture_output=True, text=True, timeout=timeout)


def js(expr, wait=24):
    """Run one JS expression in the shared browser and return its printed result.

    Reads the log from the byte offset the log had BEFORE the send: the driver is shared, and a
    tail window slides past the answer whenever another writer is busy."""
    mark = LOG.stat().st_size if LOG.exists() else 0
    drive(["--send", "js " + expr])
    for _ in range(wait):
        time.sleep(2)
        with LOG.open("r", encoding="utf-8", errors="replace") as f:
            f.seek(mark)
            for line in f:
                if line.startswith("[js] "):
                    return line[len("[js] "):].rstrip("\n")
    return None


NEG_JS = ('JSON.stringify(Array.from(document.querySelectorAll("[data-qa=negotiations-item], '
          '[data-qa^=negotiations-item]")).map(e=>({t:e.innerText.split("\\n").map(s=>s.trim())'
          '.filter(Boolean),h:(e.querySelector("a[href*=vacancy]")||{}).getAttribute'
          '&&e.querySelector("a[href*=vacancy]").getAttribute("href")})))')

CHATS_JS = ('Array.from(document.querySelectorAll("[data-qa^=chatik-open-chat-]")).map('
            'e=>e.getAttribute("data-qa").replace("chatik-open-chat-","")+"|"+'
            'e.innerText.replace(/\\s+/g," ").slice(0,150)).join(" ;; ")')


def ensure_driver():
    """Bring the browser daemon UP; a cron reflex may not assume someone else left it running.

    The daemon exits after 45 min of idle BY DESIGN and this reflex fires every two hours, so on
    nearly every tick it wakes into a dead browser. Measured 2026-08-26: 10 of 10 runs in
    ~/.mesh/job-reply.log read «драйвер hh не отвечает» and answered nobody, while mesh-job-track
    and mesh-job-apply — which do start it — worked all along against the same login. The lane's
    ONE tool that speaks to an employer was the one tool that never woke its own transport, and
    the failure was silent because it looked exactly like hh being unreachable."""
    if drive(["--alive"]).returncode != 0:
        drive(["--start"], timeout=180)


# Why a read failed, for the caller to print. THREE different failures — a daemon that would not
# start, a navigation that never arrived, a page that answered something other than the list — used
# to share one sentence, and six days of a never-started daemon were indistinguishable from hh being
# down. A collapsed reason makes blind and quiet identical.
LAST_FAIL = ""


NEG_URL = "https://hh.ru/applicant/negotiations"
# hh paginates отклики at 20 per page, and page 1 is the ONLY thing this lane ever read. An
# приглашение on an older отклик was therefore invisible FOREVER, and every batch of new откликов
# pushes more history off the one page we look at — the blindness grows with the lane's own
# throughput. Bounded so a page parameter hh decides to ignore cannot spin here.
MAX_PAGES = int(node_env("MESH_JOB_REPLY_PAGES", "8"))


def read_page(n):
    """One page of hh's negotiations -> (rows, err). rows may be []; err non-empty means UNREAD."""
    url = NEG_URL if n == 0 else (NEG_URL + "?page=%d" % n)
    if drive(["--goto", url], timeout=180).returncode != 0:
        return None, "драйвер не дошёл до страницы откликов (стр. %d)" % n
    payload = js(NEG_JS)
    if not payload or not payload.startswith("["):
        return None, ("страница %d ответила не списком откликов (браузер занят другим писателем?): %s"
                      % (n, (payload or "пусто")[:80]))
    out = []
    for it in json.loads(payload):
        t = [x for x in (it.get("t") or []) if x]
        if len(t) < 3 or not it.get("h"):
            continue
        m = re.search(r"/vacancy/(\d+)", it["h"])
        if not m:
            continue
        out.append({"vacancy_id": m.group(1), "status": t[0].strip().lower(),
                    "title": t[1], "employer": t[2]})
    return out, ""


def invited():
    """-> [{vacancy_id, title, employer}] for negotiations hh marks as приглашение, ALL pages.

    None is "could not read" and is NOT "no invitations"; the why lands in LAST_FAIL."""
    global LAST_FAIL
    ensure_driver()
    if drive(["--alive"]).returncode != 0:
        LAST_FAIL = "браузерный драйвер не поднялся (mesh-hh-drive --start)"
        return None
    rows, seen_ids, prev_first = [], set(), None
    for n in range(MAX_PAGES):
        page, err = read_page(n)
        if page is None:
            if n == 0:
                LAST_FAIL = err
                return None
            # A later page that will not read is a COVERAGE hole, not an empty result: answer what
            # we did read and say how far we got, never silently render the rest as "no invitations".
            LAST_FAIL = err
            break
        if not page:
            break
        # A `?page=` hh chooses to IGNORE hands back page 1 again, and a loop that trusts the
        # parameter would then read the same twenty rows MAX_PAGES times and call it full coverage —
        # the pagination equivalent of a silent fallback. Stop on a repeated head.
        first = page[0]["vacancy_id"]
        if n and first == prev_first:
            break
        prev_first = first
        fresh = 0
        for r in page:
            if r["vacancy_id"] in seen_ids:
                continue
            seen_ids.add(r["vacancy_id"])
            fresh += 1
            if r["status"] in ("interview", "приглашение"):
                rows.append({k: r[k] for k in ("vacancy_id", "title", "employer")})
        if not fresh:
            break
    return rows


SCROLL_JS = ('(function(){var l=document.querySelectorAll("[data-qa^=chatik-open-chat-]");'
             'if(!l.length)return "0";var c=l[0].parentElement;'
             'while(c&&c.scrollHeight<=c.clientHeight)c=c.parentElement;'
             'if(c)c.scrollTop=c.scrollHeight;return ""+l.length;})()')

CHAT_SCROLLS = int(node_env("MESH_JOB_REPLY_CHAT_SCROLLS", "12"))


def chat_id_for(employer, title):
    """The chat list is VIRTUALISED — it renders about eleven rows whatever its true length, and
    the rest do not exist in the DOM until something scrolls them into view. A single read of
    `[data-qa^=chatik-open-chat-]` therefore answers about the newest eleven conversations and
    returns None for every older one, which the caller records as «чат не найден в списке» — a
    sentence that reads like hh having no such chat. Seen live 2026-08-26 in
    job-apply-widened-2026-08-26.log ("отклик подан по ссылке, но письмо в чат НЕ ушло: чат по
    этой вакансии не найден в списке") and again by hand: the Future Focus chat needed one scroll
    pass to appear at all.

    Scrolling must be its OWN driver command per pass — the list re-renders asynchronously, so a
    JS loop that scrolls and re-queries inside one expression sees the same eleven rows every
    iteration (measured: such a loop returned "notfound" while a stepped one found it on pass 1)."""
    # And it must be ON the chat page: invited() leaves the browser on the negotiations list, where
    # no [data-qa^=chatik-open-chat-] node exists at all, so a lookup made from there answers None
    # for EVERY chat — indistinguishable from the chat being absent.
    if drive(["--goto", "https://hh.ru/chat"], timeout=180).returncode != 0:
        return None
    time.sleep(5)
    seen_len = -1
    for _ in range(CHAT_SCROLLS):
        payload = js(CHATS_JS)
        if payload:
            for cell in payload.split(" ;; "):
                cid, _, txt = cell.partition("|")
                if employer[:18].lower() in txt.lower() and title[:22].lower() in txt.lower():
                    return cid.strip()
        grew = js(SCROLL_JS)
        try:
            n = int((grew or "0").strip())
        except ValueError:
            n = -1
        # The window stays ~11 rows wide, so its LENGTH cannot say whether more loaded; a list that
        # has hit its end simply stops handing back new ids, which the loop above notices by not
        # matching. Only a hard failure to render anything ends the walk early.
        if n == 0 and seen_len == 0:
            break
        seen_len = n
    return None


def thread_text():
    return js('document.body.innerText.replace(/\\s+/g," ").slice(-2500)') or ""


def blocked_by(text):
    for p in BLOCKERS:
        m = re.search(p, text, re.I)
        if m:
            return m.group(0)
    return ""


def blockers_in(text):
    """ВСЕ сработавшие стоп-темы, а не первая. -> [фрагмент текста работодателя]

    `blocked_by` возвращает ПЕРВОЕ совпадение, и этого хватало, пока совпадение только
    ОСТАНАВЛИВАЛО лану. С того момента, как оно стало ещё и ВЫБИРАТЬ, на что отвечать из банка,
    первого мало: письмо, где спрашивают и про деньги, и про переезд, отвечало бы на одно и
    молчало про другое — под его именем и с видом, что ответ полный."""
    out, seen = [], set()
    for p in BLOCKERS:
        for m in re.finditer(p, text, re.I):
            frag = m.group(0).lower()
            if frag not in seen:
                seen.add(frag)
                out.append(m.group(0))
    return out


ANSWERS = "mesh-job-answers"


def bank_answer(text):
    """Ответ из анкеты (`mesh-job-answers`) на вопрос, который иначе останавливал лану.

    -> строка ответа | "" если банк не знает. НЕЗНАНИЕ ОСТАЁТСЯ ОСТАНОВКОЙ: пустая строка здесь
    возвращает прежнее поведение (строка уходит человеку), и вопрос при этом уже поставлен в
    очередь самим `--match`, то есть попадёт в следующую анкету в TG. Банк снимает вопрос только
    тогда, когда ответ на него дал ОН САМ или он выведен из артефакта — не когда ответ похож."""
    try:
        r = subprocess.run([ANSWERS, "--match", text, "--origin", "hh-chat"],
                           capture_output=True, text=True, timeout=30)
    except Exception:
        return ""
    return (r.stdout or "").strip() if r.returncode == 0 else ""


def compose(slots, extra=""):
    body = ("Спасибо за приглашение!\n\n"
            "Готов обсудить. Удобное время — будни, 12:00–19:00 МСК. "
            "Ближайшие свободные окна: %s.\n\n"
            "Скажите, какое подходит, или предложите своё в этом интервале — подстроюсь." % slots)
    return (extra.strip() + "\n\n" + body) if extra.strip() else body


def free_slots_text():
    r = subprocess.run([CAL, "--free", "--text", "--max", "4", "--days", "8"],
                       capture_output=True, text=True, timeout=60)
    s = (r.stdout or "").strip()
    return "" if (not s or "нет" in s) else s


def load():
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def save(st):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=1))
    tmp.replace(STATE)


def selftest():
    ok = True

    def check(label, cond, detail=""):
        nonlocal ok
        print(("  ok   " if cond else "  FAIL ") + label + ((" — " + detail) if detail else ""))
        ok = ok and bool(cond)

    # EVERY node knob must survive a CRON environment, not just the ones a pane exercises. cron
    # never sources ~/.mesh/nodes, so a knob read from os.environ carries its DEFAULT on every
    # scheduled run while the pane shows the operator's value — a config edit that reads as
    # applied and is not (measured on mesh-job-apply, 04f98795: cap 20 in the file, "5 из 5" on
    # the run). Driven END TO END, as a subprocess under a fabricated HOME with `env -i`, because
    # the binding happens at IMPORT: an in-process check cannot see a constant that was already
    # bound wrong. Two arms with DIFFERENT values, so a tool that ignores the file entirely fails
    # one of them whatever its own default is. (Mutant seen red: node_env -> os.environ.get.)
    import tempfile as _tf
    _KEY, _ARMS = "MESH_JOB_REPLY_CAP", ("7", "19")
    _seen = []
    for _want in _ARMS:
        _h = _tf.mkdtemp(prefix="node-env-arm-")
        os.makedirs(os.path.join(_h, ".mesh", "job"), exist_ok=True)
        with open(os.path.join(_h, ".mesh", "nodes"), "w") as _f:
            _f.write("export %s=%s\n" % (_KEY, _want))
        _p = subprocess.run(["/usr/bin/env", "-i", "HOME=" + _h, "PATH=/usr/bin:/bin",
                             "SHELL=/bin/sh", sys.executable, os.path.abspath(__file__),
                             "--print-knobs"], capture_output=True, text=True, timeout=60)
        _seen.append(("%s=%s" % (_KEY, _want)) in _p.stdout)
    check("%s is read from ~/.mesh/nodes under a CRON environment (arm 1: %s)" % (_KEY, _ARMS[0]),
          _seen[0])
    check("...and tracks the file, not a constant (arm 2: %s)" % _ARMS[1], _seen[1])

    for tool in (HH, CAL, TG):
        check("резолвится %s" % tool, __import__("shutil").which(tool) is not None)

    # Not `if not armed: pass` — that asserts nothing. Run the real tool with the switch OFF and
    # demand rc=2: the arming gate is the only thing between a cron tick and a stranger's inbox.
    env = dict(os.environ); env["MESH_JOB_AUTOREPLY"] = "off"
    r = subprocess.run([sys.executable, os.path.abspath(__file__)], env=env,
                       capture_output=True, text=True, timeout=60)
    check("без MESH_JOB_AUTOREPLY=on инструмент отказывается работать (rc=2)",
          r.returncode == 2 and "не вооружён" in (r.stderr or ""), "rc=%s %s" % (r.returncode, (r.stderr or "").strip()[:60]))

    # THE REFLEX MUST WAKE ITS OWN TRANSPORT. The browser daemon idles out after 45 min and this
    # tool fires every two hours, so "someone else left it running" is false on nearly every tick —
    # and when it is false this tool answers NOBODY while printing a sentence that reads like hh
    # being down. Driven end to end under a fabricated HOME with `env -i`, because the tool prepends
    # ~/.local/bin to PATH at import and a stub anywhere else loses that race: the fake home's own
    # .local/bin IS the stub dir. Two arms with OPPOSITE --alive verdicts, so "always start" fails
    # one and "never start" fails the other; a single arm would pass for a tool that ignores the
    # aliveness check entirely. (Mutant seen red: ensure_driver -> pass.)
    import tempfile as _tf
    _starts = []
    for _alive_rc, _want_start in ((1, True), (0, False)):
        _h = _tf.mkdtemp(prefix="reply-driver-arm-")
        os.makedirs(os.path.join(_h, ".local", "bin"), exist_ok=True)
        os.makedirs(os.path.join(_h, ".mesh", "job"), exist_ok=True)
        _stub = os.path.join(_h, ".local", "bin", "mesh-hh-drive")
        _lines = [
            "#!/bin/sh",
            'printf "%s\\n" "$*" >> "$HOME/.mesh/job/stub-argv.log"',
            'case "$1" in',
            "  --alive) exit " + str(_alive_rc) + " ;;",
            '  --send) printf "[js] []\\n" >> "$HOME/.mesh/job/hh-drive.log" ;;',
            "esac",
            "exit 0",
        ]
        with open(_stub, "w") as _f:
            _f.write("\n".join(_lines) + "\n")
        os.chmod(_stub, 0o755)
        _p = subprocess.run(["/usr/bin/env", "-i", "HOME=" + _h, "PATH=/usr/bin:/bin",
                             "SHELL=/bin/sh", sys.executable, os.path.abspath(__file__), "--dry"],
                            capture_output=True, text=True, timeout=180)
        try:
            _argv = open(os.path.join(_h, ".mesh", "job", "stub-argv.log")).read()
        except Exception:
            _argv = ""
        _starts.append(("--start" in _argv, _p))
    check("мёртвый драйвер рефлекс ПОДНИМАЕТ САМ, а не сдаётся (arm --alive=fail)",
          _starts[0][0], (_starts[0][1].stderr or "").strip()[:90] or "--start не вызывался")
    check("...и не дёргает --start, когда драйвер уже жив (arm --alive=ok)",
          not _starts[1][0])
    # И причина отказа обязана НАЗЫВАТЬ себя: три разных провала под одной фразой — это шесть дней,
    # в которые «не запускали браузер» читалось как «hh недоступен».
    check("отказ по мёртвому драйверу называет ИМЕННО эту причину",
          "не поднялся" in (_starts[0][1].stderr or ""),
          (_starts[0][1].stderr or "").strip()[:90])

    # The refusal list is the whole safety story: a question we cannot answer must stop the send.
    for txt, want in (
            ("Илья, какие у вас ожидания по зарплате?", True),
            ("Пришлём тестовое задание, ок?", True),
            ("What are your salary expectations?", True),
            ("Готовы ли вы переехать в Москву?", True),
            ("Здравствуйте! Приглашаем вас на техническое интервью, когда удобно?", False),
            ("Добрый день! Спасибо за отклик, давайте познакомимся.", False)):
        got = bool(blocked_by(txt))
        check("вопрос-стоп: %r" % txt[:44], got == want, "blocked=%s want=%s" % (got, want))

    # ВСЕ стоп-темы, а не первая: письмо, спрашивающее и про деньги, и про переезд, обязано
    # предъявить ОБА вопроса, иначе на один ответят, а про другой промолчат — с видом полного
    # ответа и под его именем.
    two = ("Здравствуйте! Какие у вас зарплатные ожидания и готовы ли вы переехать в Москву?")
    bl = blockers_in(two)
    check("две стоп-темы в одном сообщении дают ДВА совпадения, а не одно",
          len(bl) >= 2, repr(bl))
    check("...и одна тема по-прежнему даёт одну",
          len(blockers_in("Какие у вас зарплатные ожидания?")) == 1,
          repr(blockers_in("Какие у вас зарплатные ожидания?")))
    check("сообщение без стоп-тем не даёт ни одной",
          blockers_in("Приглашаем на техническое интервью, когда удобно?") == [])

    slots = free_slots_text()
    check("mesh-job-cal отдаёт конкретные слоты", bool(re.search(r"\d\d[.:]\d\d", slots)), slots or "пусто")
    msg = compose(slots or "пт 21.08 12:00")
    check("письмо несёт часы оператора и предложенные окна",
          "12:00–19:00 МСК" in msg and (slots.split(",")[0].strip() if slots else "") in msg,
          msg.replace("\n", " ")[:110])
    check("письмо ничего не обещает про деньги и сроки выхода",
          not blocked_by(msg), blocked_by(msg))

    # Банк ответов — ОБА направления. Только "known" проверял бы, что вызов не падает; молчание
    # банка на незнакомом вопросе и есть то, что удерживает лану от ответа за него.
    # Очередь уводится в /tmp: --match на неизвестном вопросе ПИШЕТ, а тест не имеет права
    # трогать артефакт, который анкета потом покажет оператору.
    _qenv = os.environ.get("MESH_JOB_QUESTIONS")
    os.environ["MESH_JOB_QUESTIONS"] = "/tmp/mesh-job-reply-test-questions.tsv"
    known = bank_answer("Илья, какие у вас ожидания по зарплате?")
    unknown = bank_answer("Каким шрифтом вы набираете свои коммиты по вторникам?")
    if _qenv is None:
        os.environ.pop("MESH_JOB_QUESTIONS", None)
    else:
        os.environ["MESH_JOB_QUESTIONS"] = _qenv
    check("банк отвечает на вопрос, который он уже закрыл", bool(known), known or "пусто")
    check("вопрос вне анкеты банк НЕ отвечает", unknown == "", unknown)
    check("ответ банка доезжает до письма", bool(known) and known in compose("пт 21.08 12:00", known))

    st = load()
    check("состояние читается", isinstance(st, dict), "%d записей" % len(st))

    if drive(["--alive"]).returncode != 0:
        print("  n/a  живой драйвер hh не запущен — нечего утверждать против")
        print("mesh-job-reply --test: " + ("n/a" if ok else "FAILED"))
        return 2 if ok else 1
    rows = invited()
    # СООБЩЕНИЕ обязано различать то же, что различает ПРЕДИКАТ. Предикат тут правильный
    # (`is not None` — не читается против пусто), а формат «%d приглашений» рендерил НЕУДАВШЕЕСЯ
    # чтение как «0 приглашений»: читатель видит FAIL и цифру 0 и уносит «приглашений нет», хотя
    # верно «прочитать не смогли». Чаще всего причина — занятый браузер: драйвер single-writer,
    # и параллельный mesh-job-apply отдаёт сюда пустой ответ.
    check("список откликов hh читается", rows is not None,
          "ЧТЕНИЕ НЕ УДАЛОСЬ (браузер занят другим писателем?) — это НЕ «0 приглашений»"
          if rows is None else "%d приглашений" % len(rows))
    print("mesh-job-reply --test: " + ("ok" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry", action="store_true")
    ap.add_argument("--tg", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max", type=int, default=CAP)
    ap.add_argument("--test", action="store_true")
    ap.add_argument("--print-knobs", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    # Internal leg of --test: prints the node knobs AS BOUND AT IMPORT. Binding happens at import,
    # so only a real subprocess under `env -i` can show which value a cron environment actually got.
    if a.print_knobs:
        print("MESH_JOB_REPLY_CAP=%s" % (CAP,))
        print("MESH_JOB_AUTOREPLY=%s" % (node_env("MESH_JOB_AUTOREPLY"),))
        return 0
    if a.test:
        sys.exit(selftest())

    if node_env("MESH_JOB_AUTOREPLY") != "on" and not a.dry:
        print("mesh-job-reply: n/a — не вооружён (MESH_JOB_AUTOREPLY=on в ~/.mesh/nodes)", file=sys.stderr)
        sys.exit(2)

    rows = invited()
    if rows is None:
        print("mesh-job-reply: n/a — %s" % (LAST_FAIL or "чтение откликов не удалось"), file=sys.stderr)
        sys.exit(2)

    st = load()
    did, skipped = [], []
    for r in rows[:a.max]:
        vid = r["vacancy_id"]
        if st.get(vid, {}).get("confirmed"):
            continue
        cid = chat_id_for(r["employer"], r["title"])
        if not cid:
            skipped.append((r, "чат не найден в списке"))
            continue
        drive(["--send", "goto https://hh.ru/chat/%s" % cid])
        time.sleep(8)
        thread = thread_text()
        tail = thread[-1200:]
        stops = blockers_in(tail)
        extra = ""
        if stops:
            # Банк спрашивается ПО КАЖДОЙ сработавшей теме отдельно, а не одним куском хвоста.
            # Передавая весь хвост, мы отдавали банку строку, в которой его паттерны матчатся
            # по чему угодно, и получали ответ на ПЕРВУЮ подошедшую тему — то есть, возможно,
            # не на ту, из-за которой лана остановилась. Ответ не на заданный вопрос хуже
            # молчания: он выглядит как ответ.
            parts, missing = [], []
            for s in stops:
                a = bank_answer(s)
                (parts.append(a) if a else missing.append(s))
            if missing:
                skipped.append((r, "вопрос(ы) требуют его самого: %s"
                                % ", ".join("«%s»" % m for m in missing)))
                st[vid] = {**st.get(vid, {}), "needs_human": "; ".join(missing),
                           "seen": time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime())}
                continue
            extra = "\n\n".join(parts)
        slots = free_slots_text()
        if not slots:
            skipped.append((r, "свободных слотов нет"))
            continue
        body = compose(slots, extra)
        if a.dry:
            did.append((r, body, "dry"))
            continue
        LETTERS.mkdir(parents=True, exist_ok=True)
        path = LETTERS / ("reply-%s.txt" % vid)
        path.write_text(body, encoding="utf-8")
        drive(["--send", "settext textarea[data-qa=chatik-new-message-text] %s" % path])
        time.sleep(4)
        drive(["--send", "click [data-qa=chatik-do-send-message]"])
        time.sleep(7)
        # The artifact: our own sentence, read back off the thread. A click is not a message.
        drive(["--send", "goto https://hh.ru/chat/%s" % cid])
        time.sleep(8)
        probe = "Ближайшие свободные окна"
        landed = probe in thread_text()
        st[vid] = {"employer": r["employer"], "title": r["title"], "chat": cid,
                   "sent": time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime()),
                   "slots": slots, "confirmed": landed}
        if landed:
            SENT.mkdir(parents=True, exist_ok=True)
            (SENT / (time.strftime("%Y-%m-%d") + "-hh-chat-%s-slots.txt" % vid)).write_text(body, encoding="utf-8")
            subprocess.run([CAL, "--add", "%s | %s | %s | приглашение, ждём подтверждения | hh-чат %s | | предложено: %s"
                            % (slots.split(",")[0].replace("(МСК)", "").strip().split(" ", 1)[1],
                               r["employer"], r["title"], cid, slots), "--state", "proposed"],
                           capture_output=True, text=True)
            did.append((r, body, "sent"))
        else:
            skipped.append((r, "клик прошёл, но тред не подтвердил отправку"))
        save(st)
    save(st)

    if a.json:
        print(json.dumps({"answered": [{"vacancy": r["vacancy_id"], "employer": r["employer"],
                                        "how": how} for r, _, how in did],
                          "skipped": [{"vacancy": r["vacancy_id"], "employer": r["employer"],
                                       "why": why} for r, why in skipped]}, ensure_ascii=False, indent=1))
    else:
        for r, body, how in did:
            print("%-8s %s — %s" % (how, r["employer"], r["title"]))
        for r, why in skipped:
            print("skip     %s — %s (%s)" % (r["employer"], r["title"], why))

    if a.tg and (did or skipped):
        parts = []
        for r, body, how in did:
            parts.append("✅ ответил %s (%s):\n%s" % (r["employer"], r["title"], body))
        for r, why in skipped:
            parts.append("⚠️ НЕ ответил %s (%s) — %s" % (r["employer"], r["title"], why))
        subprocess.run([TG, "[job] приглашения:\n\n" + "\n\n".join(parts)], check=False)
    sys.exit(0)


if __name__ == "__main__":
    main()
