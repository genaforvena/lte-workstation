#!/usr/bin/env bash
# orphan-ok: on-demand tape builder — a mind runs it to ask a question of the raw record; it
#            schedules nothing and writes only where it is told to.
# mesh-raw-tape — an aligned tape of QUANTITIES, for asking whether a fused sense is earned
#
# WHY THIS EXISTS. ~/.mesh/sensor-tape.tsv is the mesh's only aligned cross-sense tape and every
# column on it is a VERDICT TOKEN — `situation` has two levels, `psi` three — produced by that
# sense's own single-axis classifier BEFORE the row was written. mesh-synergy's first census over it
# came back at or below its own null at every threshold. That is a statement about the tape: if a
# relation lived in the QUANTITY, the coarsening upstream destroyed it before any fold could see it.
# So this builds the other tape — the raw numbers, aligned, with their coverage attached.
#
# HETEROGENEITY IS THE POINT, so the sources are deliberately different physics: the scheduler's run
# queue, memory occupancy, the DRAM bus, a radio's received power, a network round trip and its
# jitter, kernel fault events, die temperature. Two senses that share a driver are one sense read
# twice; these do not.
#
# WHAT A CELL MEANS, AND WHAT AN EMPTY ONE MEANS. A bin holding no sample is NOLOG — never 0. The
# distinction is load-bearing for the EVENT-RATE columns (kernel faults, link recoveries): a tape of
# events is a NUMERATOR, and "no fault this bin" and "the node was powered off this bin" are the
# same silence in it. So an event column reads 0 only in a bin where a CONTINUOUSLY-written tape also
# has a sample — i.e. where the machine is known to have been up — and NOLOG everywhere else. This
# node power-cycles several times a day; without that rule every outage would enter the census as a
# quiet, healthy stretch.
#
#   mesh-raw-tape --out FILE [--bin 600] [--since ISO] [--until ISO]
#   mesh-raw-tape --dense --out FILE          3 days at 60s: DRAM bus + thermal + the always-on axes
#   mesh-raw-tape --test                      self-test: coverage, NOLOG-not-zero, event-liveness rule
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$PATH:$HOME/.local/bin"
MESH="${MESH:-$HOME/.mesh}"
OUT=""; BIN=600; BIN_SET=0; SINCE=""; UNTIL=""; DENSE=0; MODE=build
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="${2:-}"; shift 2;;
    --bin) BIN="${2:-600}"; BIN_SET=1; shift 2;;
    --since) SINCE="${2:-}"; shift 2;;
    --until) UNTIL="${2:-}"; shift 2;;
    --dense) DENSE=1; shift;;
    --test) MODE=test; shift;;
    -h|--help) sed -n '3,30p' "$0"; exit 0;;
    *) echo "mesh-raw-tape: unknown arg $1" >&2; exit 2;;
  esac
done
command -v python3 >/dev/null 2>&1 || { echo "mesh-raw-tape: python3 absent"; exit 2; }
# --dense adds the high-rate sources (the DRAM bus, the die thermals) and, unless a bin was named
# explicitly, picks the cadence and window they can actually fill. An explicit --bin always wins:
# the always-on tapes are written every 5 minutes, so a 60s grid leaves them ~13% covered and the
# common support a joint census needs collapses.
[ "$DENSE" = 1 ] && { [ "$BIN_SET" = 0 ] && BIN=300; [ -z "$SINCE" ] && SINCE="$(date -u -d '3 days ago' +%FT%TZ)"; }

PY='
import sys, os, re, math, datetime, collections
MESH=os.environ["MESH"]; OUT=sys.argv[1]; BIN=int(sys.argv[2]); DENSE=sys.argv[3]=="1"
SINCE=sys.argv[4] or None; UNTIL=sys.argv[5] or None
def iso(s):
    try: return datetime.datetime.strptime(s[:19],"%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    except Exception: return None
lo=iso(SINCE) if SINCE else None; hi=iso(UNTIL) if UNTIL else None
def keep(t): return (lo is None or t>=lo) and (hi is None or t<=hi)
def binof(t): return int(t.timestamp())//BIN*BIN

# samples[col][bin] -> list of floats ; events[col][bin] -> count
samples=collections.defaultdict(lambda: collections.defaultdict(list))
events=collections.defaultdict(lambda: collections.defaultdict(int))
live=set()          # bins in which a continuously-written tape had a sample -> the node was UP

def add(col,t,v):
    if keep(t): samples[col][binof(t)].append(v)
def addev(col,t):
    if keep(t): events[col][binof(t)]+=1

# ── SCHEDULER / MEMORY / RADIO — mesh-sensor-log long-format tape: "<ts> <host> <key> <value>"
KEYS={"cpu_load1":"cpu_load1","mem_used_pct":"mem_used_pct","ble_count":"ble_count"}
try:
    for ln in open(MESH+"/sensors.log"):
        f=ln.split()
        if len(f)<4: continue
        t=iso(f[0])
        if not t: continue
        k=f[2]
        if k in KEYS:
            try: add(KEYS[k],t,float(f[3]))
            except ValueError: pass
            live.add(binof(t))
        elif k=="ble_top":
            m=re.match(r"^(-?\d+)\|",f[3])
            if m: add("ble_top_rssi",t,float(m.group(1)))
except OSError: pass

# ── NETWORK — the QUALITY line of mesh-egress-health: round trip, its jitter, and loss
try:
    for ln in open(MESH+"/egress-health.log"):
        if " QUALITY " not in ln: continue
        t=iso(ln.split()[0])
        if not t: continue
        for col,pat in (("egress_rtt_ms",r"avg=([\d.]+)ms"),("egress_mdev_ms",r"mdev=([\d.]+)ms"),
                        ("egress_loss_pct",r"loss=([\d.]+)%")):
            m=re.search(pat,ln)
            if m: add(col,t,float(m.group(1)))
except OSError: pass

# ── KERNEL FAULT EVENTS — a NUMERATOR: counted per bin, and zero only where the node was up
try:
    for ln in open(MESH+"/hw-fault.log"):
        t=iso(ln[:19].replace(",","."))
        if t: addev("hw_fault_events",t)
except OSError: pass
# ── LINK RECOVERIES — the actuator tape; same numerator rule
try:
    for ln in open(MESH+"/link-heal.log"):
        if " RECOVERED " not in ln: continue
        t=iso(ln.split()[0])
        if t: addev("link_recoveries",t)
except OSError: pass

if DENSE:
    # ── DRAM BUS — 1 Hz, "<epoch>\t<GB/s>". Different physics from every other column here.
    try:
        for ln in open(MESH+"/dram-bw-samples.log"):
            f=ln.split()
            if len(f)<2: continue
            try: t=datetime.datetime.fromtimestamp(int(f[0]),datetime.timezone.utc); v=float(f[1])
            except ValueError: continue
            add("dram_bw_gbs",t,v)
    except OSError: pass
    # ── DIE TEMPERATURE — mesh-therm zone list; the hottest zone in the reading
    try:
        for ln in open(MESH+"/therm.log"):
            t=iso(ln.split()[0]) if ln[:4].isdigit() else None
            if not t: continue
            vals=[float(x) for x in re.findall(r":(\d+\.\d+)",ln)]
            if vals: add("therm_max_c",t,max(vals))
    except OSError: pass

cols=sorted(set(list(samples)+list(events)))
if not cols: print("no source tape carried a usable row in this window",file=sys.stderr); sys.exit(2)
allbins=set()
for c in samples: allbins|=set(samples[c])
for c in events: allbins|=set(events[c])
allbins|=live
# THE GRID IS CONTIGUOUS, not "the bins that happen to have data". A sparse grid silently deletes
# every powered-off stretch, and a consumer walking row-to-row would then step across an outage as if
# it were the next tick. Every bin between the first and the last exists; a dark one is all-NOLOG and
# says so, which is what makes the gap visible instead of absent.
_b=[b for b in allbins if (lo is None or b>=binof(lo)) and (hi is None or b<=binof(hi))]
bins=list(range(min(_b),max(_b)+BIN,BIN)) if _b else []
if len(bins)<50: print("only %d bins in this window — too thin to align"%len(bins),file=sys.stderr); sys.exit(2)

def median(xs):
    xs=sorted(xs); n=len(xs)
    return xs[n//2] if n%2 else 0.5*(xs[n//2-1]+xs[n//2])

rows=[]; cover=collections.Counter()
for b in bins:
    r=[datetime.datetime.fromtimestamp(b,datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")]
    for c in cols:
        if c in events:
            # a numerator: 0 is a real reading ONLY where the node is known to have been up
            v=("%d"%events[c][b]) if (b in live or events[c][b]>0) else "NOLOG"
        else:
            xs=samples[c].get(b)
            v=("%.4f"%median(xs)) if xs else "NOLOG"
        if v!="NOLOG": cover[c]+=1
        r.append(v)
    rows.append(r)

with open(OUT,"w") as fh:
    fh.write("# mesh-raw-tape — aligned QUANTITIES, bin=%ds. A cell is the bin median; NOLOG = no sample\n"%BIN)
    fh.write("# in that bin (never 0). Event columns count occurrences and read 0 only where a\n")
    fh.write("# continuously-written tape shows the node was up — elsewhere NOLOG, because a tape of\n")
    fh.write("# events cannot tell a quiet bin from a powered-off one.\n")
    fh.write("\t".join(["ts"]+cols)+"\n")
    for r in rows: fh.write("\t".join(r)+"\n")
n=len(rows)
print("wrote %s"%OUT)
print("bins        : %d at %ds  (%s .. %s)"%(n,BIN,rows[0][0],rows[-1][0]))
print("up-bins     : %d/%d (%.1f%%) — bins a continuously-written tape shows the node was up for"%(len(live&set(bins)),n,100.0*len(live&set(bins))/n))
print("coverage    : "+"  ".join("%s %.0f%%"%(c,100.0*cover[c]/n) for c in cols))
'

if [ "$MODE" = test ]; then
  td=$(mktemp -d); trap 'rm -rf "$td"' EXIT; rc=0
  mkdir -p "$td/mesh"
  # a node that is UP for the first half and POWERED OFF for the second, with one fault in each half
  python3 - "$td/mesh" <<'FIX'
import sys, datetime
m=sys.argv[1]; t0=datetime.datetime(2026,1,1,tzinfo=datetime.timezone.utc)
s=[];h=[]
for i in range(120):                      # 120 bins of 10 min = 20h of "up"
    t=(t0+datetime.timedelta(minutes=10*i)).strftime("%Y-%m-%dT%H:%M:%SZ")
    s.append("%s host cpu_load1 %.2f"%(t,1.0+i%3))
    s.append("%s host mem_used_pct %.1f"%(t,40.0+i%7))
h.append((t0+datetime.timedelta(minutes=55)).strftime("%Y-%m-%dT%H:%M:%S,000000+00:00")+" a kernel fault")
# a fault recorded while the node was NOT writing sensors.log (the tape is silent there)
h.append((t0+datetime.timedelta(hours=40)).strftime("%Y-%m-%dT%H:%M:%S,000000+00:00")+" a kernel fault")
open(m+"/sensors.log","w").write("\n".join(s)+"\n")
open(m+"/hw-fault.log","w").write("\n".join(h)+"\n")
FIX
  out="$td/tape.tsv"
  o=$(MESH="$td/mesh" python3 -c "$PY" "$out" 600 0 "" "" 2>&1); r=$?
  if [ "$r" -ne 0 ]; then echo "FAIL arm1: builder exited $r: $o"; rc=1
  else echo "PASS arm1: a tape was built from the fixture"; fi
  # ARM 2 — a bin with no sample must be NOLOG, never 0. This is the whole reason the tape exists.
  # asserted on a MEASUREMENT column specifically — an event column carries NOLOG for its own
  # reason (arm 3), so a whole-row grep would pass while every gap in a measured quantity read 0.
  sn=$(awk -F'\t' 'NR==5{for(i=1;i<=NF;i++) if($i=="cpu_load1") c=i} NR>5 && c && $c=="NOLOG"{n++} END{print n+0}' "$out")
  sz=$(awk -F'\t' 'NR==5{for(i=1;i<=NF;i++) if($i=="cpu_load1") c=i} NR>5 && c && $c=="0"{n++} END{print n+0}' "$out")
  if [ "$sn" -gt 50 ] && [ "$sz" -eq 0 ]; then
    echo "PASS arm2: a MEASURED column reads NOLOG in $sn unsampled bins and never 0"
  else echo "FAIL arm2: measured column nolog=$sn zeros=$sz — an unsampled bin is being written as a value"; rc=1; fi
  # ARM 3 — the event column must read 0 while the node was UP and NOLOG once it went dark. A tape of
  # events is a numerator; without this rule a power-off enters the census as a quiet, healthy stretch.
  ev=$(awk -F'\t' 'NR==5{for(i=1;i<=NF;i++) if($i=="hw_fault_events") c=i} NR>5 && c{print $c}' "$out")
  z=$(printf '%s\n' "$ev" | awk '$1=="0"{n++} END{print n+0}')
  nl=$(printf '%s\n' "$ev" | awk '$1=="NOLOG"{n++} END{print n+0}')
  if [ "$z" -gt 50 ] && [ "$nl" -gt 0 ]; then
    echo "PASS arm3: event column reads 0 in $z up-bins and NOLOG in $nl dark ones — a numerator with a denominator"
  else echo "FAIL arm3: event column zeros=$z nolog=$nl — a powered-off bin is being recorded as 'no faults'"; rc=1; fi
  # ARM 4 — a window with nothing in it must exit 2, not emit a confident empty tape.
  o4=$(MESH="$td/mesh" python3 -c "$PY" "$td/e.tsv" 600 0 "2030-01-01T00:00:00Z" "2030-01-02T00:00:00Z" 2>&1); r4=$?
  if [ "$r4" -eq 2 ]; then echo "PASS arm4: an empty window exits 2, never a confident empty tape"
  else echo "FAIL arm4: empty window exited $r4"; rc=1; fi
  [ "$rc" -eq 0 ] && echo "mesh-raw-tape --test: PASS" || echo "mesh-raw-tape --test: FAIL"
  exit "$rc"
fi

[ -n "$OUT" ] || { echo "mesh-raw-tape: --out FILE is required" >&2; exit 2; }
MESH="$MESH" python3 -c "$PY" "$OUT" "$BIN" "$DENSE" "$SINCE" "$UNTIL"
