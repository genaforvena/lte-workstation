#!/usr/bin/env bash
# mesh-turbo-lid — graceful thermal ACTUATOR: cap CPU via intel_pstate to shed heat WITHOUT
# killing work. The missing HARDWARE step in the thermal ladder (observe → nice → **lid** →
# shed/kill): today the mesh jumps from renice straight to killing a mind mid-flight. A lid
# drops package temp ~26°C in 25s (proven live 2026-07-05 19:15Z: no_turbo=1 under load 10.5
# took pkg 80→54°C, 2300→1000MHz, instant restore) — work continues slower, zero processes
# disturbed. See ~/.mesh/knowledge/capability-turbo-lid-actuator-20260705.md.
#
#   mesh-turbo-lid --on  [--pct N] [--ttl S] [--reason R]  close the lid.
#                        bare  → no_turbo=1 (binary lid, hardest graceful step)
#                        --pct N → max_perf_pct=N (graded governor, e.g. 70 = a proportional cap)
#   mesh-turbo-lid --off                                   restore: no_turbo=0, max_perf_pct=100
#   mesh-turbo-lid --status                                live sysfs read + state metadata
#   mesh-turbo-lid --release-if-expired                    dead-man: --off IFF the lid's TTL passed
#   mesh-turbo-lid --sweep                                 cron backstop == --release-if-expired
#   mesh-turbo-lid --test                                  real-read gate + pure logic; exit 2 on non-intel_pstate
#
# SAFETY (the design IS the safety — an actuator that halves the node must never wedge it):
#   1. AUTO-RELEASE dead-man. Every --on writes a deadline (now+TTL, default MESH_LID_TTL=600s)
#      into the state file AND spawns a detached (setsid) one-shot releaser that fires
#      --release-if-expired after TTL. A dead caller therefore NEVER leaves the lid closed:
#      the releaser survives the caller, and a */1 --sweep cron is the belt-and-suspenders
#      backstop for the case the releaser itself died (OOM). Re-asserting (--on again) pushes
#      the deadline forward and re-spawns; stale releasers no-op because they re-read the deadline.
#   2. SINGLE-WRITER. One lid writer per node — two CONCURRENT writers racing no_turbo oscillate
#      the clock. A node-LOCAL flock (fd 200, NEVER the board): contention is per-node (no_turbo/
#      max_perf_pct are per-node knobs; only this node's therm-watch/resource-guard/manual call
#      ever contend, never cross-node), so a 2nd concurrent --on exits 2 while the 1st holds the
#      lock. Local ⇒ ZERO board churn and no cross-node false-refuse of a peer lidding its OWN cpu
#      (the retired board claim key `turbo-lid` wasn't node-qualified). The lock covers only the
#      invocation (released on exit), so re-asserts still push the deadline.
#   3. HONEST SENSE LINE. ~/.mesh/.turbo-lid.state (LID=on|off pct=N since=<ts> deadline=<ts>
#      reason=<tier> pid=<releaser> announced=<0|1> ttl=<hold> flap=<0|1>); mesh-state-touch on EVERY
#      eval (mtime=ran-live, decoupled from the change-gated content) so the staleness watchdogs never
#      false-STALE it. Board [lid-on]/[lid-off] on EDGES only, POST-TIERED (mesh-stress:post_tier): an
#      intra-flap on/off PAIR (adaptive↑ close → flap=1) goes to mesh-trace, not the board — the board
#      keeps only the episode-opening close + a sustained/manual release.
#   4. FAIL-OPEN. Reboot resets no_turbo→0 and kills the releaser — acceptable, the lid defaults
#      open. sysfs is the truth for the ACTUAL lid; the state file is metadata only.
#
# reflex-cadence: * * * * *
# reflex-args: --sweep
set -uo pipefail
# cron's minimal PATH lacks ~/.local/bin — the */1 --sweep release then can't find mesh-chat, so the
# [lid-off] edge post silently drops while sysfs+state release fine: the board shows a lid-on with no
# lid-off (false "still lidded"). Seen live 22:15→22:25Z 2026-07-05. (flock needs no PATH — util-linux.)
export PATH="$HOME/.local/bin:$PATH"

PSTATE="${MESH_PSTATE_DIR:-/sys/devices/system/cpu/intel_pstate}"
NO_TURBO="$PSTATE/no_turbo"
MAX_PCT="$PSTATE/max_perf_pct"
MESH="${MESH_HOME:-$HOME/.mesh}"
STATE="${MESH_TURBO_LID_STATE:-$MESH/.turbo-lid.state}"
TTL_DEFAULT="${MESH_LID_TTL:-600}"
LID_TTL_MAX="${MESH_LID_TTL_MAX:-3600}"                       # adaptive-hold ceiling (flap dampener)
DROPLOG="${MESH_TURBO_LID_DROPLOG:-$MESH/.turbo-lid-drops.log}"     # swallowed board edges land here (detectable)
LASTREL="${MESH_TURBO_LID_LASTREL:-$MESH/.turbo-lid-lastrelease}"   # last auto-release "<epoch> <hold>" (flap detect)
LOCKFILE="${MESH_TURBO_LID_LOCK:-$MESH/.turbo-lid.lock}"           # node-local single-writer flock (fd 200)
# A --test must not contend the PRODUCTION lock: the live reflex uses flock -n, so a doctor-storm
# smoke holding the real lock makes the real run silently skip its cycle (worse than an mtime forge —
# a stolen turn). Divert when this IS a test or a test's child (task test-live-writes 2026-07-20).
if [ "${1:-}" = --test ] || [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then LOCKFILE="${MESH_TURBO_LID_LOCK:-${TMPDIR:-/tmp}/.turbo-lid.lock.sandbox.$$}"; fi

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
now(){ date +%s; }

have_pstate(){ [ -r "$NO_TURBO" ] && [ -r "$MAX_PCT" ]; }

# --- knob writer (DRYRUN-gated so --test never fires a real write / needs sudo) ------------
write_knob(){ # $1 path  $2 value
  local path="$1" val="$2"
  if [ "${MESH_TURBO_LID_DRYRUN:-0}" = 1 ]; then echo "DRYRUN write $path=$val"; return 0; fi
  # sysfs pstate knobs are root-owned; passwordless sudo confirmed on the lid nodes.
  if [ -w "$path" ]; then printf '%s\n' "$val" > "$path" 2>/dev/null && return 0; fi
  printf '%s\n' "$val" | sudo -n tee "$path" >/dev/null 2>&1
}

# --- state file (metadata; sysfs is truth for the actual lid) -----------------------------
state_get(){ # $1 field → value ('' if absent)
  [ -f "$STATE" ] || { echo ""; return; }
  awk -v k="$1" '{for(i=1;i<=NF;i++){n=index($i,"="); if(n>0 && substr($i,1,n-1)==k){print substr($i,n+1); exit}}}' "$STATE"
}
state_write(){ # LID pct since deadline reason pid [announced] [ttl] [flap]
  # announced = did the [lid-on] board post SUCCEED (0 → owes a catch-up on release); ttl = the hold in
  # effect (armed into LASTREL on auto-release so a fast re-lid can escalate); flap = was this on-edge an
  # adaptive↑ (escalated) close routed to TRACE not the board (post-tiering — so the matching off-edge
  # tiers identically, keeping the on/off PAIR on the same tier). Keyed state_get keeps old (fewer-field)
  # state files readable (missing keys → "").
  printf 'LID=%s pct=%s since=%s deadline=%s reason=%s pid=%s announced=%s ttl=%s flap=%s\n' \
    "$1" "$2" "$3" "$4" "$5" "$6" "${7:-0}" "${8:-0}" "${9:-0}" > "$STATE"
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE"
}

board(){ # $1 marker-line — edge posts only. Returns 0 IFF the board actually took it; a SWALLOWED post
         # (mesh-chat absent OR the post fails) is appended to a durable drops-log so a silent drop is
         # DETECTABLE + self-healable — health 2026-07-06: a dropped [lid-on] reads as "still lidded" with
         # ZERO trace (the misdirected "cron PATH hole" was a red herring; PATH is already exported :41).
  if command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="turbo-lid@$(hostname)" mesh-chat "$1" >/dev/null 2>&1; then
    return 0
  fi
  { printf '%s DROPPED %s\n' "$(ts)" "$1" >> "$DROPLOG"; } 2>/dev/null || true
  return 1
}

trace(){ # $1 line — the LOW (history) tier for intra-flap on/off edges (post-tiering, mirrors
         # mesh-stress:post_tier). Routine flap churn goes here so the board keeps only the coordination
         # signal: the episode-opening close + a sustained/manual release. Fail-soft (no drops-log — trace
         # is already the low tier; a lost history line doesn't misread as "still lidded").
  command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="turbo-lid@$(hostname)" mesh-trace "$1" >/dev/null 2>&1 || true
}

cur_mhz(){ # best-effort all-core avg scaling freq in MHz (advisory, for --status)
  local sum=0 n=0 f
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    [ -r "$f" ] || continue; read -r v < "$f" 2>/dev/null || continue
    sum=$((sum + v)); n=$((n+1))
  done
  [ "$n" -gt 0 ] && echo $(( sum / n / 1000 )) || echo "?"
}

# --- decide whether an on-lid has expired (PURE: passed now + deadline; --test drives it) --
lid_expired(){ # $1 lid_state  $2 deadline  $3 now  → 0 = release, 1 = hold/na
  [ "$1" = on ] || return 1
  [[ "$2" =~ ^[0-9]+$ ]] || return 0   # on but no valid deadline = release (never strand closed)
  [ "$3" -ge "$2" ]
}

# --- adaptive hold (flap dampener): a re-lid within 2× the last auto-release's hold DOUBLES the ttl
#     (cap LID_TTL_MAX), so a node that reheats ~20min after each release stops thrashing the clock; a
#     quiet gap (> 2× the last hold) decays straight back to base. node-care's Schmitt precedent applied
#     to hold-TIME. PURE except reading the LASTREL sidecar; --test drives it via MESH_TURBO_LID_LASTREL.
adaptive_ttl(){ # $1 base_ttl → escalated-or-base ttl
  local base="$1" lr_ts lr_ttl gap ne bigger esc
  [ -r "$LASTREL" ] || { echo "$base"; return; }
  read -r lr_ts lr_ttl _ < "$LASTREL" 2>/dev/null || true
  { [[ "${lr_ts:-}" =~ ^[0-9]+$ ]] && [[ "${lr_ttl:-}" =~ ^[0-9]+$ ]]; } || { echo "$base"; return; }
  ne="$(now)"; gap=$(( ne - lr_ts ))
  if [ "$gap" -ge 0 ] && [ "$gap" -le $(( 2 * lr_ttl )) ]; then    # re-lid inside 2× the last hold = flap
    bigger="$base"; [ "$lr_ttl" -gt "$bigger" ] && bigger="$lr_ttl"
    esc=$(( bigger * 2 )); [ "$esc" -gt "$LID_TTL_MAX" ] && esc="$LID_TTL_MAX"
    echo "$esc"
  else
    echo "$base"
  fi
}

do_off(){ # $1 reason
  local prev pid ann on_reason on_ttl on_flap; prev="$(state_get LID)"; pid="$(state_get pid)"
  ann="$(state_get announced)"; on_reason="$(state_get reason)"; on_ttl="$(state_get ttl)"
  on_flap="$(state_get flap)"
  write_knob "$NO_TURBO" 0
  write_knob "$MAX_PCT" 100
  # persist OFF *before* cancelling the releaser: when the releaser ITSELF calls do_off (dead-man
  # path), killing its own pid is a suicide — state must already be written or it strands at LID=on.
  state_write off 100 "$(state_get since)" "" "${1:-off}" "" 0 0
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" != "$$" ] && kill "$pid" 2>/dev/null || true
  if [ "$prev" = on ]; then
    # (the node-local writer flock auto-releases when the --on process exits — nothing to release on --off)
    # POST-TIERING (chat-review/turbolid-flap-board-noise, mirrors mesh-stress:post_tier): an intra-flap
    # ttl bounce (the on-edge was adaptive↑ → flap=1) routes its release to TRACE too, so the on/off PAIR
    # stays on the same tier and the board keeps only the coordination signal. The board still gets: a
    # sustained/manual release (operator or non-flap episode), and any fresh-episode natural release.
    local offmsg="[lid-off] $(hostname) turbo restored (no_turbo=0, max_perf_pct=100) — reason=${1:-off}"
    if [ "$on_flap" = 1 ] && [ "${1:-off}" = auto-release-ttl ]; then
      trace "$offmsg"
    else
      # SELF-HEAL (board tier only): if this episode's [lid-on] board post was DROPPED (announced!=1 AND it
      # was a boarded, non-flap edge), reconstruct a catch-up [lid-on] before the [lid-off] so the board's
      # on/off pairing is restored — else a silent on reads as "still lidded" forever (health 2026-07-06).
      # A flap on-edge (flap=1) went to TRACE by design, so it owes NO board catch-up. Catch-up is itself
      # drop-logged by board() if it fails.
      [ "$on_flap" != 1 ] && [ "$ann" != 1 ] && board "[lid-on] $(hostname) (CATCH-UP: on-edge post was dropped — reconstructing pairing) reason=${on_reason:-?}"
      board "$offmsg"
    fi
  fi
  # FLAP DAMPENER: record the auto-release instant + the hold that just expired so a fast re-lid escalates
  # (adaptive_ttl). ONLY the dead-man auto path arms it — a manual --off must not make the node flap-escalate.
  if [ "${1:-off}" = auto-release-ttl ]; then
    [[ "${on_ttl:-}" =~ ^[0-9]+$ ]] && [ "$on_ttl" -gt 0 ] || on_ttl="$TTL_DEFAULT"
    { printf '%s %s\n' "$(now)" "$on_ttl" > "$LASTREL"; } 2>/dev/null || true
  fi
  echo "turbo-lid: OFF (restored)"
}

do_on(){
  local pct="" ttl="$TTL_DEFAULT" reason="manual"
  while [ $# -gt 0 ]; do
    case "$1" in
      --pct)    pct="$2"; shift 2 ;;
      --ttl)    ttl="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ "$ttl" =~ ^[0-9]+$ ]] || ttl="$TTL_DEFAULT"
  local base_ttl="$ttl"; ttl="$(adaptive_ttl "$ttl")"   # flap dampener: fast re-lid → doubled hold (capped)
  # single-writer: node-LOCAL flock (replaces the retired board mesh-claim, which posted a [claim]/
  # [claim-done] pair every thermal cycle yet — since therm-watch & resource-guard both call the tool
  # as WHO=turbo-lid@host — never actually refused a same-node peer: it only churned the board and
  # could cross-node false-refuse a peer lidding its OWN cpu). Contention is per-node, so a local lock
  # is the right primitive: a 2nd CONCURRENT --on exits 2; fd 200 is held only for THIS invocation
  # (released on exit ⇒ re-asserts still push the deadline). FAIL-OPEN — if flock is absent or the
  # lockfile can't open, proceed: thermal safety outranks single-writer (see SAFETY #4).
  if command -v flock >/dev/null 2>&1; then
    if exec 200>"$LOCKFILE" 2>/dev/null && ! flock -n 200; then
      echo "turbo-lid: REFUSED — another turbo-lid invocation holds the lock (concurrent)"; exit 2
    fi
  fi
  local prev; prev="$(state_get LID)"
  if [ -n "$pct" ]; then
    [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -ge 10 ] && [ "$pct" -le 100 ] || { echo "turbo-lid: bad --pct '$pct' (10-100)"; exit 1; }
    write_knob "$MAX_PCT" "$pct"
  else
    pct="turbo-off"
    write_knob "$NO_TURBO" 1
  fi
  # (re)spawn the detached dead-man releaser; kill any prior one first (re-assert pushes deadline)
  local oldpid; oldpid="$(state_get pid)"
  [[ "$oldpid" =~ ^[0-9]+$ ]] && kill "$oldpid" 2>/dev/null || true
  local deadline=$(( $(now) + ttl )) rpid=""
  if [ "${MESH_TURBO_LID_DRYRUN:-0}" != 1 ]; then
    # 200>&- : do NOT let the detached releaser inherit the writer lock (fd 200) — else it would hold
    # the lock for the whole TTL and refuse every re-assert. The lock covers only THIS invocation.
    setsid bash -c "sleep $ttl; exec '$0' --release-if-expired" </dev/null >/dev/null 2>&1 200>&- &
    rpid=$!
  fi
  # announced tracks whether the [lid-on] edge post actually landed; on a re-assert (prev==on, no new
  # edge) carry the prior value forward so an earlier drop still owes its catch-up on release.
  local ann; ann="$(state_get announced)"; [[ "$ann" =~ ^[01]$ ]] || ann=0
  # flap = this on-edge is an adaptive↑ (escalated) close → route to TRACE, not the board (post-tiering).
  # ONLY a genuine new edge (prev!=on) decides it; a re-assert (prev==on, no new edge) carries the prior
  # flap bit forward so the eventual off-edge tiers to match the edge that was actually posted.
  local flap
  if [ "$prev" != on ]; then flap=$( [ "$ttl" != "$base_ttl" ] && echo 1 || echo 0 )
  else flap="$(state_get flap)"; [[ "$flap" =~ ^[01]$ ]] || flap=0; fi
  if [ "$prev" != on ]; then
    local onmsg="[lid-on] $(hostname) CPU lid CLOSED (pct=$pct, ttl=${ttl}s$( [ "$ttl" != "$base_ttl" ] && printf ' [adaptive↑ from %ss — flap]' "$base_ttl" )) — reason=$reason"
    if [ "$flap" = 1 ]; then
      trace "$onmsg"   # intra-flap re-close → history tier only (board keeps just the episode-opening close)
    else
      if board "$onmsg"; then ann=1; else ann=0; fi
    fi
  fi
  state_write on "$pct" "$(ts)" "$deadline" "$reason" "$rpid" "$ann" "$ttl" "$flap"
  echo "turbo-lid: ON (pct=$pct ttl=${ttl}s deadline=$deadline reason=$reason releaser=$rpid announced=$ann)"
}

do_status(){
  local nt mp
  if have_pstate; then read -r nt < "$NO_TURBO"; read -r mp < "$MAX_PCT"; else nt="n/a"; mp="n/a"; fi
  echo "turbo-lid status @ $(hostname) $(ts)"
  echo "  sysfs:  no_turbo=$nt  max_perf_pct=$mp  cur_avg=$(cur_mhz)MHz"
  if [ -f "$STATE" ]; then echo "  state:  $(cat "$STATE")"; else echo "  state:  (none)"; fi
  have_pstate || { echo "  (no intel_pstate on this host — actuator n/a)"; return 2; }
}

case "${1:---status}" in
  --on)  shift; have_pstate || { echo "turbo-lid: no intel_pstate — n/a"; exit 2; }; do_on "$@" ;;
  --off) have_pstate || { echo "turbo-lid: no intel_pstate — n/a"; exit 2; }; do_off manual ;;
  --release-if-expired|--sweep)
    have_pstate || exit 2
    command -v mesh-state-touch >/dev/null 2>&1 && [ -f "$STATE" ] && mesh-state-touch "$STATE" >/dev/null 2>&1
    if lid_expired "$(state_get LID)" "$(state_get deadline)" "$(now)"; then do_off auto-release-ttl; else exit 0; fi ;;
  --status) do_status ;;

  --test)
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    export MESH_TEST_SANDBOX=1   # children divert their lock too
    # sandbox honesty (mechanism-assert): the lock this test run holds must be the diverted one —
    # holding the PRODUCTION lock steals the real reflex's flock -n turn. Falsify: drop the diversion.
    [ "$LOCKFILE" != "$MESH/.turbo-lid.lock" ] || fail "lock diversion inactive — this --test contends the PRODUCTION lock ($LOCKFILE)"
    # ---- pure logic: dead-man expiry classification (falsifiable both ways) ----
    lid_expired on 1000 1000 || fail "expired: now==deadline must release"
    lid_expired on 1000 1001 || fail "expired: now>deadline must release"
    lid_expired on 1000 999  && fail "expired: now<deadline must HOLD (not release)"
    lid_expired off 0 9999   && fail "expired: an OFF lid must never 'release'"
    lid_expired on '' 9999   || fail "expired: on with no deadline must release (never strand closed)"
    # ---- state round-trip parse ----
    STATE="$(mktemp)"; trap 'rm -f "$STATE"' EXIT
    state_write on 70 T1 12345 therm-hot 4242 1 900 1
    [ "$(state_get LID)" = on ]        || fail "state LID parse"
    [ "$(state_get pct)" = 70 ]        || fail "state pct parse"
    [ "$(state_get deadline)" = 12345 ]|| fail "state deadline parse"
    [ "$(state_get pid)" = 4242 ]      || fail "state pid parse"
    [ "$(state_get announced)" = 1 ]   || fail "state announced parse"
    [ "$(state_get ttl)" = 900 ]       || fail "state ttl parse"
    [ "$(state_get flap)" = 1 ]        || fail "state flap parse"
    [ -z "$(state_get nope)" ]         || fail "absent field must be empty"
    # ---- knob writes are DRYRUN in test (no real fire / no sudo) ----
    MESH_TURBO_LID_DRYRUN=1
    case "$(write_knob "$NO_TURBO" 1)" in *"DRYRUN write"*) : ;; *) fail "dryrun did not intercept the real write";; esac
    # ---- FALSIFIABILITY: reverting lid_expired's boundary to a strict '>' would let now==deadline HOLD ----
    _fx(){ [ "$1" = on ] || return 1; [ "$3" -gt "$2" ]; }   # the WRONG (strict) variant
    _fx on 1000 1000 && fail "falsify: strict-> variant should NOT release at now==deadline (guards the >= boundary)"

    # ==== turbo-lid-silent-actuation+flap (health-corrected fixes: drops-log + catch-up + adaptive hold) ====
    # (1) board() drops-log: a SWALLOWED post lands in the durable drops-log + board() returns non-zero.
    DROPLOG="$(mktemp)"; mesh-chat(){ return 1; }   # stub: force the post-fails branch deterministically
    board "[lid-on] test drop" && fail "board must return non-zero when the post is swallowed"
    grep -q 'DROPPED .*\[lid-on\] test drop' "$DROPLOG" || fail "board must append a swallowed post to the drops-log (detectable)"
    mesh-chat(){ return 0; }; : > "$DROPLOG"
    board "[lid-off] test ok" || fail "board must return 0 on a successful post"
    [ -s "$DROPLOG" ] && fail "a successful post must NOT write to the drops-log"
    unset -f mesh-chat; rm -f "$DROPLOG"
    # (2) adaptive hold (flap dampener): re-lid within 2× the last hold DOUBLES ttl (capped); quiet gap decays.
    LASTREL="$(mktemp)"; LID_TTL_MAX=3600
    printf '%s %s\n' "$(now)" 600 > "$LASTREL"                    # released now, held 600 → flap → 1200
    [ "$(adaptive_ttl 600)" = 1200 ] || fail "adaptive: re-lid within 2× last hold must double the ttl (600→1200)"
    printf '%s %s\n' "$(( $(now) - 800 ))" 600 > "$LASTREL"       # gap 800 ≤ 2×600=1200 → still a flap
    [ "$(adaptive_ttl 600)" = 1200 ] || fail "adaptive: gap 800 ≤ 2×600 must flap (guards the 2× window, not 1×)"
    printf '%s %s\n' "$(( $(now) - 5000 ))" 600 > "$LASTREL"      # gap 5000 > 1200 → decay to base
    [ "$(adaptive_ttl 600)" = 600 ]  || fail "adaptive: a quiet gap (> 2× last hold) must decay to base ttl"
    printf '%s %s\n' "$(now)" 2000 > "$LASTREL"                   # held 2000 → 4000 capped at 3600
    [ "$(adaptive_ttl 600)" = 3600 ] || fail "adaptive: escalation must cap at LID_TTL_MAX (3600)"
    rm -f "$LASTREL"; LASTREL="$(mktemp -u)"                      # absent sidecar → never escalate blind
    [ "$(adaptive_ttl 600)" = 600 ]  || fail "adaptive: absent LASTREL must return base ttl"
    # (3) SELF-HEAL catch-up (via the REAL do_off path, DRYRUN + stubbed board/claim): a dropped on-edge
    #     (announced!=1) reconstructs a catch-up [lid-on] on release; an announced=1 lid must NOT double-post.
    MESH_TURBO_LID_DRYRUN=1
    cap="$(mktemp)"; mesh-chat(){ printf '%s\n' "$*" >> "$cap"; return 0; }
    STATE="$(mktemp)"; LASTREL="$(mktemp)"
    state_write on turbo-off T1 12345 therm-hot '' 0 600         # announced=0 → on-edge was dropped
    do_off auto-release-ttl >/dev/null 2>&1
    grep -q 'CATCH-UP.*\[lid-on\]\|\[lid-on\].*CATCH-UP' "$cap" || fail "self-heal: a dropped on-edge (announced=0) must reconstruct a catch-up [lid-on] on release"
    grep -q '\[lid-off\]' "$cap" || fail "self-heal: [lid-off] must still post after the catch-up"
    read -r _lrt _lrh _ < "$LASTREL" 2>/dev/null; [ "${_lrh:-}" = 600 ] || fail "auto-release must ARM the flap dampener (LASTREL holds the expired hold=600)"
    : > "$cap"
    state_write on turbo-off T1 12345 therm-hot '' 1 600         # announced=1 → NO catch-up
    do_off auto-release-ttl >/dev/null 2>&1
    grep -q 'CATCH-UP' "$cap" && fail "self-heal: an announced=1 lid must NOT emit a catch-up (no double post)"
    grep -q '\[lid-off\]' "$cap" || fail "self-heal: [lid-off] must post for announced=1 too"
    # a MANUAL --off must NOT arm the dampener (only the dead-man auto path flaps)
    rm -f "$LASTREL"
    state_write on turbo-off T1 12345 manual '' 1 600
    do_off manual >/dev/null 2>&1
    [ -e "$LASTREL" ] && fail "manual --off must NOT arm the flap dampener (LASTREL must stay absent)"
    # (4) PHANTOM POST (chat-review/turbolid-phantom-claimdone): an --off on an ALREADY-OFF lid
    #     (therm-watch cool branch, every cool cycle) must emit ZERO board posts — live 2026-07-06
    #     14:30:03Z: an unpaired release-edge with no [lid-*] context (was an unpaired [claim-done]
    #     under the retired board claim; the same prev=off gate now guards the [lid-*] edges).
    : > "$cap"
    state_write off 100 T1 '' off '' 0 0                          # prev=off → nothing was held
    do_off manual >/dev/null 2>&1
    grep -q '\[lid-' "$cap" && fail "phantom: --off on an already-off lid must NOT board-post"
    unset -f mesh-chat; rm -f "$cap" "$STATE" "$LASTREL"
    MESH_TURBO_LID_DRYRUN=1   # (re-affirm for the real-read gate below; unchanged)

    # (4b) POST-TIERING (chat-review/turbolid-flap-board-noise, mirrors mesh-stress:post_tier): intra-flap
    #      on/off edges go to TRACE; the board keeps only the episode-opening close + a sustained/manual
    #      release. Drives the REAL do_on/do_off (DRYRUN: no knob write, no releaser spawn) with board() and
    #      trace() stubbed to separate capture files.
    MESH_TURBO_LID_DRYRUN=1
    bcap="$(mktemp)"; tcap="$(mktemp)"
    mesh-chat(){ printf '%s\n' "$*" >> "$bcap"; return 0; }
    mesh-trace(){ printf '%s\n' "$*" >> "$tcap"; return 0; }
    STATE="$(mktemp)"; LASTREL="$(mktemp -u)"; LID_TTL_MAX=3600; TTL_DEFAULT=600
    # (a) fresh close after cool (prev off, no LASTREL → ttl==base, no flap) → BOARD [lid-on]
    state_write off 100 T0 '' off '' 0 0 0
    do_on --reason therm-hot >/dev/null 2>&1
    grep -q '\[lid-on\]' "$bcap" || fail "post-tier(a): a fresh close (prev cool, no flap) must BOARD [lid-on]"
    grep -q '\[lid-on\]' "$tcap" && fail "post-tier(a): a fresh close must NOT go to trace"
    [ "$(state_get flap)" = 0 ]  || fail "post-tier(a): a fresh close must record flap=0"
    # (b) re-lid within 2× the last hold (adaptive↑ flap) → TRACE [lid-on], NOT board
    : > "$bcap"; : > "$tcap"; LASTREL="$(mktemp)"
    printf '%s %s\n' "$(now)" 600 > "$LASTREL"                    # released now, held 600 → re-lid = flap → 1200
    state_write off 100 T0 '' off '' 0 0 0                        # prev cool again → genuine new edge, escalated
    do_on --reason therm-hot >/dev/null 2>&1
    grep -q '\[lid-on\].*adaptive↑' "$tcap" || fail "post-tier(b): a flap re-lid (adaptive↑) must go to TRACE"
    grep -q '\[lid-on\]' "$bcap" && fail "post-tier(b): a flap re-lid must NOT board [lid-on]"
    [ "$(state_get flap)" = 1 ]  || fail "post-tier(b): a flap re-lid must record flap=1"
    # (c) intra-flap release (flap=1 lid, auto-release-ttl bounce) → TRACE [lid-off], NOT board
    : > "$bcap"; : > "$tcap"
    state_write on turbo-off T0 12345 therm-hot '' 1 1200 1
    do_off auto-release-ttl >/dev/null 2>&1
    grep -q '\[lid-off\]' "$tcap" || fail "post-tier(c): an intra-flap auto-release must TRACE [lid-off]"
    grep -q '\[lid-off\]' "$bcap" && fail "post-tier(c): an intra-flap auto-release must NOT board [lid-off]"
    # (c') sustained release: a MANUAL --off even of a flap lid → BOARD (operator coordination signal)
    : > "$bcap"; : > "$tcap"
    state_write on turbo-off T0 12345 therm-hot '' 1 1200 1
    do_off manual >/dev/null 2>&1
    grep -q '\[lid-off\]' "$bcap" || fail "post-tier(c'): a manual/sustained release must BOARD [lid-off] even for a flap lid"
    grep -q '\[lid-off\]' "$tcap" && fail "post-tier(c'): a manual release must NOT go to trace"
    # (c'') fresh-episode natural release (flap=0) via auto-release-ttl → BOARD [lid-off] (pairs the boarded on)
    : > "$bcap"; : > "$tcap"
    state_write on turbo-off T0 12345 therm-hot '' 1 600 0
    do_off auto-release-ttl >/dev/null 2>&1
    grep -q '\[lid-off\]' "$bcap" || fail "post-tier(c''): a fresh-episode natural release (flap=0) must BOARD [lid-off]"
    grep -q '\[lid-off\]' "$tcap" && fail "post-tier(c''): a fresh-episode release must NOT go to trace"
    unset -f mesh-chat mesh-trace; rm -f "$bcap" "$tcap" "$STATE" "$LASTREL"
    MESH_TURBO_LID_DRYRUN=1

    # (5) SINGLE-WRITER via node-local flock (replaces the board mesh-claim churn): a 2nd CONCURRENT
    #     acquisition is refused while the 1st holds the fd; after release the lock is free again.
    #     Hermetic + falsifiable, no board/no intel_pstate needed — two OFDs on one file conflict even
    #     in-process (flock(2)). Reverting the guard to no-lock would let the 2nd acquisition succeed.
    if command -v flock >/dev/null 2>&1; then
      _lk="$(mktemp -u)"
      exec 200>"$_lk"; flock -n 200 || fail "flock: first acquisition on a free lock must succeed"
      if ( exec 201>"$_lk"; flock -n 201 ); then fail "flock: a 2nd CONCURRENT acquisition must be refused (the exit-2 path) while the lock is held"; fi
      exec 200>&-                                                 # release the writer lock
      ( exec 202>"$_lk"; flock -n 202 ) || fail "flock: after release the lock must be re-acquirable"
      rm -f "$_lk"
    fi
    # ==== end silent-actuation+flap cells ====

    # ---- REAL-READ GATE: intel_pstate knobs present+readable → assert; else honest n/a exit 2 ----
    if have_pstate; then
      read -r _nt < "$NO_TURBO"; read -r _mp < "$MAX_PCT"
      [[ "$_nt" =~ ^[01]$ ]]        || fail "real-read: no_turbo not 0/1 (got '$_nt')"
      [[ "$_mp" =~ ^[0-9]+$ ]] && [ "$_mp" -ge 1 ] && [ "$_mp" -le 100 ] || fail "real-read: max_perf_pct out of range (got '$_mp')"
      echo "smoke-test: ok (intel_pstate live: no_turbo=$_nt max_perf_pct=$_mp)"
      exit 0
    else
      echo "smoke-test: n/a (no intel_pstate on this host — actuator not applicable)"
      exit 2
    fi ;;

  *) echo "usage: mesh-turbo-lid --on [--pct N] [--ttl S] [--reason R] | --off | --status | --sweep | --test"; exit 1 ;;
esac
