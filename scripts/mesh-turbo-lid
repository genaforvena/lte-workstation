#!/usr/bin/env bash
# mesh-turbo-lid — graceful thermal ACTUATOR: cap CPU via intel_pstate to shed heat WITHOUT
# killing work. The missing HARDWARE step in the thermal ladder (observe → nice → **lid** →
# shed/kill): today the mesh jumps from renice straight to killing a mind mid-flight. A lid
# drops package temp ~26°C in 25s (proven live 2026-07-05 19:15Z: no_turbo=1 under load 10.5
# took pkg 80→54°C, 2300→1000MHz, instant restore) — work continues slower, zero processes
# disturbed. See ~/.mesh/knowledge/capability-turbo-lid-actuator-20260705.md.
#
#   mesh-turbo-lid --on  [--pct N] [--ttl S] [--reason R]  close the lid.
#                        bare  → no_turbo=1 (binary lid, hardest graceful step)
#                        --pct N → max_perf_pct=N (graded governor, e.g. 70 = a proportional cap)
#   mesh-turbo-lid --off                                   restore: no_turbo=0, max_perf_pct=100
#   mesh-turbo-lid --status                                live sysfs read + state metadata
#   mesh-turbo-lid --release-if-expired                    dead-man: --off IFF the lid's TTL passed
#   mesh-turbo-lid --sweep                                 cron backstop == --release-if-expired
#   mesh-turbo-lid --test                                  real-read gate + pure logic; exit 2 on non-intel_pstate
#
# SAFETY (the design IS the safety — an actuator that halves the node must never wedge it):
#   1. AUTO-RELEASE dead-man. Every --on writes a deadline (now+TTL, default MESH_LID_TTL=600s)
#      into the state file AND spawns a detached (setsid) one-shot releaser that fires
#      --release-if-expired after TTL. A dead caller therefore NEVER leaves the lid closed:
#      the releaser survives the caller, and a */1 --sweep cron is the belt-and-suspenders
#      backstop for the case the releaser itself died (OOM). Re-asserting (--on again) pushes
#      the deadline forward and re-spawns; stale releasers no-op because they re-read the deadline.
#   2. SINGLE-WRITER. One lid owner per node — two writers fighting no_turbo oscillate the clock.
#      Claimed on the mesh-chat board via mesh-claim (key `turbo-lid`); refuses if another mind
#      holds a LIVE claim.
#   3. HONEST SENSE LINE. ~/.mesh/.turbo-lid.state (LID=on|off pct=N since=<ts> deadline=<ts>
#      reason=<tier> pid=<releaser>); mesh-state-touch on EVERY eval (mtime=ran-live, decoupled
#      from the change-gated content) so the staleness watchdogs never false-STALE it. Board
#      [lid-on]/[lid-off] on EDGES only.
#   4. FAIL-OPEN. Reboot resets no_turbo→0 and kills the releaser — acceptable, the lid defaults
#      open. sysfs is the truth for the ACTUAL lid; the state file is metadata only.
#
# reflex-cadence: * * * * *
# reflex-args: --sweep
set -uo pipefail
# cron's minimal PATH lacks ~/.local/bin — the */1 --sweep release then can't find mesh-chat/mesh-claim,
# so the [lid-off] edge post (and claim --done) silently drop while sysfs+state release fine: the board
# shows a lid-on with no lid-off (false "still lidded"). Seen live 22:15→22:25Z 2026-07-05.
export PATH="$HOME/.local/bin:$PATH"

PSTATE="${MESH_PSTATE_DIR:-/sys/devices/system/cpu/intel_pstate}"
NO_TURBO="$PSTATE/no_turbo"
MAX_PCT="$PSTATE/max_perf_pct"
MESH="${MESH_HOME:-$HOME/.mesh}"
STATE="${MESH_TURBO_LID_STATE:-$MESH/.turbo-lid.state}"
TTL_DEFAULT="${MESH_LID_TTL:-600}"
CLAIM_KEY="turbo-lid"

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
now(){ date +%s; }

have_pstate(){ [ -r "$NO_TURBO" ] && [ -r "$MAX_PCT" ]; }

# --- knob writer (DRYRUN-gated so --test never fires a real write / needs sudo) ------------
write_knob(){ # $1 path  $2 value
  local path="$1" val="$2"
  if [ "${MESH_TURBO_LID_DRYRUN:-0}" = 1 ]; then echo "DRYRUN write $path=$val"; return 0; fi
  # sysfs pstate knobs are root-owned; passwordless sudo confirmed on the lid nodes.
  if [ -w "$path" ]; then printf '%s\n' "$val" > "$path" 2>/dev/null && return 0; fi
  printf '%s\n' "$val" | sudo -n tee "$path" >/dev/null 2>&1
}

# --- state file (metadata; sysfs is truth for the actual lid) -----------------------------
state_get(){ # $1 field → value ('' if absent)
  [ -f "$STATE" ] || { echo ""; return; }
  awk -v k="$1" '{for(i=1;i<=NF;i++){n=index($i,"="); if(n>0 && substr($i,1,n-1)==k){print substr($i,n+1); exit}}}' "$STATE"
}
state_write(){ # LID pct since deadline reason pid
  printf 'LID=%s pct=%s since=%s deadline=%s reason=%s pid=%s\n' "$1" "$2" "$3" "$4" "$5" "$6" > "$STATE"
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE"
}

board(){ # $1 marker-line — edge posts only
  command -v mesh-chat >/dev/null 2>&1 || return 0
  MESH_WHO="turbo-lid@$(hostname)" mesh-chat "$1" >/dev/null 2>&1 || true
}

cur_mhz(){ # best-effort all-core avg scaling freq in MHz (advisory, for --status)
  local sum=0 n=0 f
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    [ -r "$f" ] || continue; read -r v < "$f" 2>/dev/null || continue
    sum=$((sum + v)); n=$((n+1))
  done
  [ "$n" -gt 0 ] && echo $(( sum / n / 1000 )) || echo "?"
}

# --- decide whether an on-lid has expired (PURE: passed now + deadline; --test drives it) --
lid_expired(){ # $1 lid_state  $2 deadline  $3 now  → 0 = release, 1 = hold/na
  [ "$1" = on ] || return 1
  [[ "$2" =~ ^[0-9]+$ ]] || return 0   # on but no valid deadline = release (never strand closed)
  [ "$3" -ge "$2" ]
}

do_off(){ # $1 reason
  local prev pid; prev="$(state_get LID)"; pid="$(state_get pid)"
  write_knob "$NO_TURBO" 0
  write_knob "$MAX_PCT" 100
  # persist OFF *before* cancelling the releaser: when the releaser ITSELF calls do_off (dead-man
  # path), killing its own pid is a suicide — state must already be written or it strands at LID=on.
  state_write off 100 "$(state_get since)" "" "${1:-off}" ""
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" != "$$" ] && kill "$pid" 2>/dev/null || true
  command -v mesh-claim >/dev/null 2>&1 && mesh-claim --done "$CLAIM_KEY" >/dev/null 2>&1 || true
  [ "$prev" = on ] && board "[lid-off] $(hostname) turbo restored (no_turbo=0, max_perf_pct=100) — reason=${1:-off}"
  echo "turbo-lid: OFF (restored)"
}

do_on(){
  local pct="" ttl="$TTL_DEFAULT" reason="manual"
  while [ $# -gt 0 ]; do
    case "$1" in
      --pct)    pct="$2"; shift 2 ;;
      --ttl)    ttl="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ "$ttl" =~ ^[0-9]+$ ]] || ttl="$TTL_DEFAULT"
  # single-writer: refuse if another mind holds a LIVE claim (exit 2 == theirs-live)
  if command -v mesh-claim >/dev/null 2>&1 && [ "${MESH_TURBO_LID_DRYRUN:-0}" != 1 ]; then
    mesh-claim --check "$CLAIM_KEY" >/dev/null 2>&1
    [ "$?" = 2 ] && { echo "turbo-lid: REFUSED — another mind holds the lid claim"; exit 2; }
    mesh-claim "$CLAIM_KEY" --ttl $((ttl + 120)) >/dev/null 2>&1 || true
  fi
  local prev; prev="$(state_get LID)"
  if [ -n "$pct" ]; then
    [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -ge 10 ] && [ "$pct" -le 100 ] || { echo "turbo-lid: bad --pct '$pct' (10-100)"; exit 1; }
    write_knob "$MAX_PCT" "$pct"
  else
    pct="turbo-off"
    write_knob "$NO_TURBO" 1
  fi
  # (re)spawn the detached dead-man releaser; kill any prior one first (re-assert pushes deadline)
  local oldpid; oldpid="$(state_get pid)"
  [[ "$oldpid" =~ ^[0-9]+$ ]] && kill "$oldpid" 2>/dev/null || true
  local deadline=$(( $(now) + ttl )) rpid=""
  if [ "${MESH_TURBO_LID_DRYRUN:-0}" != 1 ]; then
    setsid bash -c "sleep $ttl; exec '$0' --release-if-expired" </dev/null >/dev/null 2>&1 &
    rpid=$!
  fi
  state_write on "$pct" "$(ts)" "$deadline" "$reason" "$rpid"
  [ "$prev" != on ] && board "[lid-on] $(hostname) CPU lid CLOSED (pct=$pct, ttl=${ttl}s) — reason=$reason"
  echo "turbo-lid: ON (pct=$pct ttl=${ttl}s deadline=$deadline reason=$reason releaser=$rpid)"
}

do_status(){
  local nt mp
  if have_pstate; then read -r nt < "$NO_TURBO"; read -r mp < "$MAX_PCT"; else nt="n/a"; mp="n/a"; fi
  echo "turbo-lid status @ $(hostname) $(ts)"
  echo "  sysfs:  no_turbo=$nt  max_perf_pct=$mp  cur_avg=$(cur_mhz)MHz"
  if [ -f "$STATE" ]; then echo "  state:  $(cat "$STATE")"; else echo "  state:  (none)"; fi
  have_pstate || { echo "  (no intel_pstate on this host — actuator n/a)"; return 2; }
}

case "${1:---status}" in
  --on)  shift; have_pstate || { echo "turbo-lid: no intel_pstate — n/a"; exit 2; }; do_on "$@" ;;
  --off) have_pstate || { echo "turbo-lid: no intel_pstate — n/a"; exit 2; }; do_off manual ;;
  --release-if-expired|--sweep)
    have_pstate || exit 2
    command -v mesh-state-touch >/dev/null 2>&1 && [ -f "$STATE" ] && mesh-state-touch "$STATE" >/dev/null 2>&1
    if lid_expired "$(state_get LID)" "$(state_get deadline)" "$(now)"; then do_off auto-release-ttl; else exit 0; fi ;;
  --status) do_status ;;

  --test)
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    # ---- pure logic: dead-man expiry classification (falsifiable both ways) ----
    lid_expired on 1000 1000 || fail "expired: now==deadline must release"
    lid_expired on 1000 1001 || fail "expired: now>deadline must release"
    lid_expired on 1000 999  && fail "expired: now<deadline must HOLD (not release)"
    lid_expired off 0 9999   && fail "expired: an OFF lid must never 'release'"
    lid_expired on '' 9999   || fail "expired: on with no deadline must release (never strand closed)"
    # ---- state round-trip parse ----
    STATE="$(mktemp)"; trap 'rm -f "$STATE"' EXIT
    state_write on 70 T1 12345 therm-hot 4242
    [ "$(state_get LID)" = on ]        || fail "state LID parse"
    [ "$(state_get pct)" = 70 ]        || fail "state pct parse"
    [ "$(state_get deadline)" = 12345 ]|| fail "state deadline parse"
    [ "$(state_get pid)" = 4242 ]      || fail "state pid parse"
    [ -z "$(state_get nope)" ]         || fail "absent field must be empty"
    # ---- knob writes are DRYRUN in test (no real fire / no sudo) ----
    MESH_TURBO_LID_DRYRUN=1
    case "$(write_knob "$NO_TURBO" 1)" in *"DRYRUN write"*) : ;; *) fail "dryrun did not intercept the real write";; esac
    # ---- FALSIFIABILITY: reverting lid_expired's boundary to a strict '>' would let now==deadline HOLD ----
    _fx(){ [ "$1" = on ] || return 1; [ "$3" -gt "$2" ]; }   # the WRONG (strict) variant
    _fx on 1000 1000 && fail "falsify: strict-> variant should NOT release at now==deadline (guards the >= boundary)"
    # ---- REAL-READ GATE: intel_pstate knobs present+readable → assert; else honest n/a exit 2 ----
    if have_pstate; then
      read -r _nt < "$NO_TURBO"; read -r _mp < "$MAX_PCT"
      [[ "$_nt" =~ ^[01]$ ]]        || fail "real-read: no_turbo not 0/1 (got '$_nt')"
      [[ "$_mp" =~ ^[0-9]+$ ]] && [ "$_mp" -ge 1 ] && [ "$_mp" -le 100 ] || fail "real-read: max_perf_pct out of range (got '$_mp')"
      echo "smoke-test: ok (intel_pstate live: no_turbo=$_nt max_perf_pct=$_mp)"
      exit 0
    else
      echo "smoke-test: n/a (no intel_pstate on this host — actuator not applicable)"
      exit 2
    fi ;;

  *) echo "usage: mesh-turbo-lid --on [--pct N] [--ttl S] [--reason R] | --off | --status | --sweep | --test"; exit 1 ;;
esac
