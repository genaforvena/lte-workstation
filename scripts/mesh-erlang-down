#!/usr/bin/env bash
# mesh-erlang-down — fan out an Erlang/OTP supervisor DOWN event to the mesh.
#
# This is the small mesh-side seam for Erlang supervision: an Erlang bridge can pipe
# `DOWN process=<name> reason=<reason>` here.  tmux status messages make the event
# visible in every local channel, while mesh-chat + mesh-chat-sync carry the same
# immutable notice across nodes.  It does not restart anything; OTP supervision
# remains the owner of recovery.
#
#   mesh-erlang-down --event <process> <reason>
#   printf 'DOWN process=worker reason=noproc\n' | mesh-erlang-down
#   mesh-erlang-down --test
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

usage() { sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }

die() { echo "mesh-erlang-down: $*" >&2; exit 2; }

send_local_notice() {
  local notice="$1" target
  command -v tmux >/dev/null 2>&1 || return 0
  # display-message is deliberately non-invasive: it paints the session status line
  # and cannot strand text in an agent's composer (unlike send-keys).
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    tmux display-message -d "${MESH_ERLANG_DOWN_DISPLAY_S:-12000}" -t "$target" -- "$notice" >/dev/null 2>&1 || true
  done < <(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)
}

announce() {
  local process="$1" reason="$2" host ts notice
  host="$(hostname)"
  ts="$(date -u +%FT%TZ)"
  notice="[erlang-down] $host process=$process reason=$reason"
  send_local_notice "$notice"
  if command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO="erlang-down@$host" mesh-chat "$notice" >/dev/null 2>&1 || true
  fi
  # Sync is best-effort transport: the local chat write above is the artifact even
  # when a peer is temporarily unreachable.  The next scheduled sync retries it.
  if command -v mesh-chat-sync >/dev/null 2>&1; then
    mesh-chat-sync >/dev/null 2>&1 || true
  fi
  printf '%s %s\n' "$ts" "$notice"
}

parse_event() {
  local line="$1" process reason token
  [ "${line%% *}" = DOWN ] || die "expected DOWN event"
  process=""; reason=""
  for token in $line; do
    case "$token" in
      DOWN) ;;
      process=*) process="${token#process=}" ;;
      reason=*) reason="${token#reason=}" ;;
      *) die "unexpected field '$token' (expected process= and reason=)" ;;
    esac
  done
  [ -n "$process" ] || die "DOWN event has no process= field"
  [ -n "$reason" ] || die "DOWN event has no reason= field"
  # Keep tmux status and the board one-line and shell-safe. Erlang reasons commonly
  # contain punctuation; whitespace belongs in a quoted bridge payload, not here.
  printf '%s\n%s\n' "$process" "$reason"
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then usage; exit 0; fi

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/bin"
  cat >"$td/bin/tmux" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list-panes) printf 'mesh:0.0\nmesh:1.0\npeer:0.1\n' ;;
  display-message) printf '%s\n' "$*" >>"$MESH_ERLANG_TEST_LOG" ;;
esac
EOF
  cat >"$td/bin/mesh-chat" <<'EOF'
#!/usr/bin/env bash
printf 'chat %s\n' "$*" >>"$MESH_ERLANG_TEST_LOG"
EOF
  cat >"$td/bin/mesh-chat-sync" <<'EOF'
#!/usr/bin/env bash
printf 'sync\n' >>"$MESH_ERLANG_TEST_LOG"
EOF
  chmod +x "$td/bin"/*
  log="$td/log"
  out="$(PATH="$td/bin:$PATH" MESH_ERLANG_TEST_LOG="$log" HOME="$td" "$0" --event worker noproc)"
  grep -qF '[erlang-down] ' <<<"$out" || { echo 'smoke-test: FAIL (event output)' >&2; exit 1; }
  [ "$(grep -c '^display-message ' "$log")" = 3 ] || { echo 'smoke-test: FAIL (not every pane notified)' >&2; exit 1; }
  grep -qF 'chat [erlang-down]' "$log" || { echo 'smoke-test: FAIL (chat)' >&2; exit 1; }
  grep -q '^sync$' "$log" || { echo 'smoke-test: FAIL (cross-node sync)' >&2; exit 1; }
  if PATH="$td/bin:$PATH" MESH_ERLANG_TEST_LOG="$log" HOME="$td" "$0" --event worker >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (missing reason accepted)' >&2; exit 1
  fi
  echo 'smoke-test: ok (DOWN parse + all-pane tmux notice + chat + sync + malformed rejection)'
  exit 0
fi

if [ "${1:-}" = --event ]; then
  [ "$#" -ge 3 ] || die "usage: $0 --event <process> <reason>"
  process="$2"; reason="$3"
  [ "$#" = 3 ] || die "process and reason must each be one token"
  announce "$process" "$reason"
  exit 0
fi

if [ "$#" -gt 0 ]; then die "usage: $0 --event <process> <reason> or stdin DOWN event"; fi
IFS= read -r event || die "no DOWN event on stdin"
mapfile -t fields < <(parse_event "$event")
announce "${fields[0]}" "${fields[1]}"
