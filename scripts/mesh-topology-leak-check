#!/usr/bin/env bash
# mesh-topology-leak-check — regression guard: scan mesh-* tools for hardcoded
# topology values (phone username, SSH port, LAN IPs) that should be resolved
# from env / ~/.mesh/nodes. Exercise fallback paths to confirm they work.
#
#   mesh-topology-leak-check         full scan + exit 0 if clean, 1 if leaks found
#   mesh-topology-leak-check --json  machine-readable leak list (stdout)
#   mesh-topology-leak-check --test  smoke — self-test on known leak patterns
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
BINDIR="$HOME/.local/bin"

ts(){ date -u +%FT%TZ; }

# Checks if a line uses the canonical env-var fallback pattern.
# A line is "guarded" if it references the config variable on the same line.
guarded(){ printf '%s' "$1" | grep -qE '(PHONE_USER|MESH_PHONE_USER|PHONE_VAR|PHONE_SSH_PORT|MESH_HEAR_PHONE_PORT)'; }

scan_username_leaks() {
  local tool="$1"
  # Find lines with hardcoded phone username u0_a38X@ used in SSH context.
  # Skip lines where the username appears inside env-var fallback syntax,
  # or in a comment (after #).
  grep -nE '(u0_a38[0-9]@)' "$BINDIR/$tool" 2>/dev/null | while IFS=: read -r lineno body; do
    [ -z "$body" ] && continue
    # Strip comment part (everything after first bare # that isn't ${#...})
    # to avoid flagging docstring examples.
    local code="${body%%#*}"
    # If after stripping comments there's no u0_a38 match, it was comment-only
    printf '%s' "$code" | grep -qE '(u0_a38[0-9]@)' || continue
    # Skip if the username is inside a ${...} or $var:- construct (env guard)
    if ! guarded "$body" && ! printf '%s' "$body" | grep -qE '\$\{?PHONE_USER|PHONE_USER:-'; then
      echo "$tool:$lineno: $body"
    fi
  done
}

scan_port_leaks() {
  local tool="$1"
  # Find lines with hardcoded port 8022 used in SSH, not guarded by env var.
  grep -nE '\-p *8022' "$BINDIR/$tool" 2>/dev/null | while IFS=: read -r lineno body; do
    [ -z "$body" ] && continue
    # Skip env-var fallback pattern
    if ! guarded "$body" && ! printf '%s' "$body" | grep -qE '\$\{?PHONE_SSH_PORT|PHONE_SSH_PORT:-'; then
      printf '%s\n' "$tool:$lineno: $body"
    fi
  done
}

scan_all() {
  local tool name results=()
  for tool in "$BINDIR"/mesh-*; do
    name="$(basename "$tool")"
    [[ "$name" == mesh-topology-leak-check ]] && continue
    [[ "$name" == mesh-patterns.sh ]] && continue
    [[ "$name" == *".service" ]] && continue
    [[ "$name" == *".timer" ]] && continue
    while IFS='' read -r line; do
      [ -n "$line" ] && results+=("$line")
    done < <(scan_username_leaks "$name"; scan_port_leaks "$name")
  done
  for r in "${results[@]:-}"; do
    [ -n "$r" ] && printf '%s\n' "$r"
  done
}

check_fallbacks() {
  local fails=0

  local default_user="${PHONE_USER:-u0_a380}"
  [ -z "$default_user" ] && { echo "FAIL: PHONE_USER fallback empty"; fails=$((fails+1)); }

  local default_port="${PHONE_SSH_PORT:-8022}"
  [ -z "$default_port" ] && { echo "FAIL: PHONE_SSH_PORT fallback empty"; fails=$((fails+1)); }

  # Exercise mesh-phone-ip fallback path (probe candidates)
  local test_ip; test_ip="$(mesh-phone-ip 2>/dev/null || true)"
  if [ -z "$test_ip" ]; then
    echo "INFO: mesh-phone-ip: phone unreachable (fallback path exercised, exit 2)"
  fi

  [ "$fails" -gt 0 ] && { echo "FALLBACK CHECK: $fails failure(s)"; return 1; }
  echo "FALLBACK CHECK: all paths ok"
  return 0
}

if [ "${1:-}" = "--test" ]; then
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

mapfile -t leaks < <(scan_all)

if [ "${1:-}" = "--json" ]; then
  printf '{\n  "ts": "%s",\n  "leaks": [\n' "$(ts)"
  first=1
  for l in "${leaks[@]:-}"; do
    [ -z "$l" ] && continue
    [ "$first" -eq 1 ] || printf ',\n'
    first=0; printf '    "%s"' "$(printf '%s' "$l" | sed 's/"/\\"/g')"
  done
  printf '\n  ],\n  "count": %d\n}\n' "${#leaks[@]}"
  exit 0
fi

echo "=== mesh-topology-leak-check · $(ts) ==="
if [ "${#leaks[@]}" -eq 0 ]; then
  echo "NO LEAKS FOUND — all mesh-* tools use env-var topology resolution."
else
  echo "TOPOLOGY LEAKS (${#leaks[@]}):"
  for l in "${leaks[@]}"; do
    [ -z "$l" ] && continue
    echo "  - $l"
  done
  echo ""
  echo "Fix: replace hardcoded username with \${PHONE_USER:-u0_a380} and"
  echo "hardcoded port with \${PHONE_SSH_PORT:-8022}."
fi
echo ""
check_fallbacks || true
echo ""

[ "${#leaks[@]}" -eq 0 ] && exit 0 || exit 1
