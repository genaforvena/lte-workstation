#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.nic-tx-heartbeat.state 900 sys
# mesh-nic-tx-heartbeat — physical NIC transmit-heartbeat fault sense.
#
# Reads the kernel/driver's cumulative tx_heartbeat_errors counter.  This is a
# distinct hardware-backed signal from carrier state, packet loss, and FIFO
# errors: it records failed NIC transmit heartbeats.  A readable zero is a real
# CLEAR observation; a missing or malformed source is UNKNOWN (exit 2), never a
# fabricated zero.
#
# Usage: mesh-nic-tx-heartbeat [--json|--edge|--test]
set -uo pipefail
export PATH="${HOME:-/root}/.local/bin:$PATH"

ROOT="${MESH_NIC_TX_HEARTBEAT_ROOT:-/sys/class/net}"
STATE="${MESH_NIC_TX_HEARTBEAT_STATE:-${HOME:-/root}/.mesh/.nic-tx-heartbeat.state}"

read_snapshot() {
  local root="$1" d iface value total=0 interfaces=0
  shopt -s nullglob
  for d in "$root"/*; do
    [ -d "$d" ] || continue
    iface="${d##*/}"
    [ "$iface" != lo ] || continue
    [ -e "$d/device" ] || [ -d "$d/wireless" ] || continue
    [ -r "$d/statistics/tx_heartbeat_errors" ] || continue
    value="$(tr -d '[:space:]' <"$d/statistics/tx_heartbeat_errors" 2>/dev/null || true)"
    case "$value" in
      ''|*[!0-9]*) continue ;;
    esac
    total=$((total + value))
    interfaces=$((interfaces + 1))
  done
  shopt -u nullglob
  [ "$interfaces" -gt 0 ] || return 2
  printf '%s\t%s\n' "$total" "$interfaces"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/enp-test/device" "$td/enp-test/statistics" "$td/wlan-test/wireless" "$td/wlan-test/statistics"
  printf '3\n' >"$td/enp-test/statistics/tx_heartbeat_errors"
  printf '4\n' >"$td/wlan-test/statistics/tx_heartbeat_errors"
  fixture="$(MESH_NIC_TX_HEARTBEAT_ROOT="$td" MESH_NIC_TX_HEARTBEAT_STATE="$td/state" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"verdict":"FAULT"' || { echo "smoke-test: FAIL (fixture verdict: $fixture)"; exit 1; }
  printf '%s\n' "$fixture" | grep -q '"tx_heartbeat_errors":7' || { echo "smoke-test: FAIL (fixture total: $fixture)"; exit 1; }
  empty="$td/empty"; mkdir -p "$empty"
  set +e
  MESH_NIC_TX_HEARTBEAT_ROOT="$empty" MESH_NIC_TX_HEARTBEAT_STATE="$td/empty-state" "$0" --json >/dev/null 2>&1
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    echo 'smoke-test: FAIL (missing source accepted)'; exit 1
  fi
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (missing source did not exit 2, got $rc)"; exit 1; }
  live="$(read_snapshot "$ROOT" 2>/dev/null)" || {
    echo "smoke-test: n/a (no readable physical tx_heartbeat_errors under $ROOT)"; exit 2;
  }
  total="${live%%$'\t'*}"; interfaces="${live##*$'\t'}"
  case "$total:$interfaces" in
    ''|*[!0-9:]*) echo "smoke-test: FAIL (malformed live read: $live)"; exit 1 ;;
  esac
  echo "smoke-test: ok (fixture FAULT + missing-source exit-2 + REAL tx_heartbeat_errors read: total=$total interfaces=$interfaces)"
  exit 0
fi

mode="${1:-}"
case "$mode" in ''|--json|--edge) ;; *) echo 'usage: mesh-nic-tx-heartbeat [--json|--edge|--test]' >&2; exit 2 ;; esac

raw="$(read_snapshot "$ROOT" 2>/dev/null)" || {
  echo "mesh-nic-tx-heartbeat: UNKNOWN — no readable physical tx_heartbeat_errors under $ROOT" >&2
  exit 2
}
total="${raw%%$'\t'*}"; interfaces="${raw##*$'\t'}"
if [ "$total" -gt 0 ]; then verdict=FAULT; else verdict=CLEAR; fi
previous="$(sed -n '1s/|.*//p' "$STATE" 2>/dev/null || true)"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf '%s|tx_heartbeat_errors=%s|interfaces=%s|ts=%s\n' "$verdict" "$total" "$interfaces" "$ts" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-nic-tx-heartbeat: UNKNOWN — could not stamp live state' >&2; exit 1;
}

[ "$mode" = --edge ] && [ "$previous" = "$verdict" ] && exit 0
if [ "$mode" = --json ]; then
  printf '{"verdict":"%s","tx_heartbeat_errors":%s,"interfaces":%s,"source":"%s","ts":"%s"}\n' "$verdict" "$total" "$interfaces" "$ROOT" "$ts"
else
  printf '[nic-tx-heartbeat] %s — tx_heartbeat_errors=%s interfaces=%s\n' "$verdict" "$total" "$interfaces"
fi
