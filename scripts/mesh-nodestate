#!/usr/bin/env bash
# mesh-nodestate — STATE-FN: one line per tag:lte-node node → 'hostname: online|stale|offline'.
# A clean state source for a node-liveness STREAM (the channel primitive): pull this, pipe through
# mesh-delta → a node going dark/online becomes a DELTA on the board (pull-detects-death — the thing
# push can't see). ONLINE WINS across duplicate tailnet entries (a re-registered node leaves a stale
# offline ghost with an old nodekey; without online-wins, a live node flaps online↔offline forever).
#
# LIVENESS IS A LEASE, NOT A CACHED FLAG (operator 2026-06-21, ds false-all-clear root cause): the
# Tailscale `Online` flag is a CACHED control-plane status that stayed True while default-string was
# frozen/off → the mesh treated a dead node as alive. So `online` is no longer reported from the flag
# ALONE — a node Tailscale calls Online is CORROBORATED with a fresh ping; if it does not answer it is
# reported `stale` (claimed-online-but-UNCONFIRMED), never a false `online`. Three honest states:
#   online  = Tailscale-Online AND a fresh ping answered (corroborated live), or self (we're running)
#   stale   = Tailscale-Online but NO fresh corroboration (the false-all-clear — presume not alive)
#   offline = Tailscale not Online
# MESH_NODESTATE_CORROBORATE=0 restores pure-parse (flag-only) behavior; MESH_NODESTATE_PING_CMD=<cmd>
# overrides the corroboration probe (<cmd> <ip>, exit 0=alive) — used by --test and for ssh-corroborate.
#   mesh-nodestate          print the roster (state)
#   mesh-nodestate --ghosts list duplicate (ghost) tailnet registrations — a hygiene check
#   mesh-nodestate --test   smoke
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # dry-run: mock tailscale with synthetic JSON, exercise the parser + online-wins
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  printf '{"Self":{"HostName":"my-node","Online":true,"TailscaleIPs":["100.1.1.1"]},"Peer":{"peer1":{"HostName":"alice","Online":true,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.2"]},"peer2":{"HostName":"alice","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.3"]},"peer3":{"HostName":"bob","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.4"]},"peer4":{"HostName":"carol","Online":true,"Tags":[],"TailscaleIPs":["100.1.1.5"]}}}' > "$_td/mock.json"
  printf '#!/bin/sh\ncat "$(dirname "$0")/mock.json"\n' > "$_td/tailscale"; chmod +x "$_td/tailscale"
  PATH="$_td:$PATH"
  # (a) pure-parse (corroboration off): online-wins dedup + tag filter + self
  out="$(MESH_NODESTATE_CORROBORATE=0 bash "$0" 2>/dev/null)" || { echo "smoke-test: FAIL (exec errored: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^alice: online$'     || { echo "smoke-test: FAIL (alice online-wins — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^bob: offline$'       || { echo "smoke-test: FAIL (bob offline — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^my-node: online$'    || { echo "smoke-test: FAIL (self missing — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE 'carol'                && { echo "smoke-test: FAIL (untagged carol leaked — got: $out)"; exit 1; }
  # (b) LEASE corroboration: a Tailscale-Online node that fails the fresh ping is STALE, not a false online
  printf '#!/bin/sh\nexit 1\n' > "$_td/pingfail"; chmod +x "$_td/pingfail"
  printf '#!/bin/sh\nexit 0\n' > "$_td/pingok";   chmod +x "$_td/pingok"
  cf="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingfail" bash "$0" 2>/dev/null)"
  printf '%s\n' "$cf" | grep -qE '^alice: stale$'   || { echo "smoke-test: FAIL (online-but-unreachable must be STALE not online — got: $cf)"; exit 1; }
  printf '%s\n' "$cf" | grep -qE '^my-node: online$' || { echo "smoke-test: FAIL (self must stay online without ping — got: $cf)"; exit 1; }
  printf '%s\n' "$cf" | grep -qE '^bob: offline$'    || { echo "smoke-test: FAIL (bob offline regardless of corroboration — got: $cf)"; exit 1; }
  co="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingok" bash "$0" 2>/dev/null)"
  printf '%s\n' "$co" | grep -qE '^alice: online$'  || { echo "smoke-test: FAIL (online+ping-ok must be online — got: $co)"; exit 1; }
  ghosts="$("$_td/tailscale" 2>/dev/null | bash "$0" --ghosts 2>/dev/null)"
  printf '%s\n' "$ghosts" | grep -qE 'alice.*2 registrations' || { echo "smoke-test: FAIL (ghosts missed double alice — got: $ghosts)"; exit 1; }
  rm -rf "$_td"
  trap '' EXIT
  echo "smoke-test: ok (online-wins dedup + ghost detection + lease-corroboration verified)"; exit 0
}
MODE="${1:-state}"
CORROB="${MESH_NODESTATE_CORROBORATE:-1}"; PINGCMD="${MESH_NODESTATE_PING_CMD:-}"

# Fresh corroboration probe — a LIVE check, never a cached flag. Default = one quick ICMP ping
# (overridable to an ssh/announce-lease probe via MESH_NODESTATE_PING_CMD).
corrob(){ local ip="$1"; [ -z "$ip" ] && return 1
  if [ -n "$PINGCMD" ]; then "$PINGCMD" "$ip" >/dev/null 2>&1; else ping -c1 -W2 "$ip" >/dev/null 2>&1; fi; }

if [ "$MODE" = --ghosts ]; then
  tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
seen={}
def add(h,on): seen.setdefault(h,[]).append(bool(on))
s=d.get('Self',{})
if s: add(s.get('HostName','self'), s.get('Online'))
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []): add(p.get('HostName','?'), p.get('Online'))
for h,flags in sorted(seen.items()):
    if len(flags)>1: print('%s: %d registrations %s' % (h, len(flags), flags))
"
  exit 0
fi

# state mode: python emits 'host\tip\ttsonline\tisself' (online-wins; ip from an online entry);
# bash then CORROBORATES each Tailscale-online peer with a fresh probe before calling it online.
tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
seen={}   # host -> [(online, ip, isself)]
def add(h,on,ips,me=False):
    ip=(ips or [None])
    seen.setdefault(h,[]).append((bool(on), ip[0] if ip else None, me))
s=d.get('Self',{})
if s: add(s.get('HostName','self'), s.get('Online'), s.get('TailscaleIPs'), True)
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []): add(p.get('HostName','?'), p.get('Online'), p.get('TailscaleIPs'))
for h in sorted(seen):
    es=seen[h]; online=any(e[0] for e in es); isself=any(e[2] for e in es)
    ip=next((e[1] for e in es if e[0] and e[1]), None) or next((e[1] for e in es if e[1]), '')
    print('%s\t%s\t%d\t%d' % (h, ip or '', 1 if online else 0, 1 if isself else 0))
" | while IFS=$'\t' read -r host ip tson isself; do
  [ -z "$host" ] && continue
  if [ "$tson" != 1 ]; then echo "$host: offline"; continue; fi
  if [ "$isself" = 1 ]; then echo "$host: online"; continue; fi          # we're executing here = alive
  if [ "$CORROB" != 1 ]; then echo "$host: online"; continue; fi          # pure-parse escape hatch
  if corrob "$ip"; then echo "$host: online"; else echo "$host: stale"; fi  # corroborate the cached flag
done
