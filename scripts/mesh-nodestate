#!/usr/bin/env bash
# mesh-nodestate — STATE-FN: one line per tag:lte-node node → 'hostname: online|offline'.
# A clean state source for a node-liveness STREAM (the channel primitive): pull this, pipe through
# mesh-delta → a node going dark/online becomes a DELTA on the board (pull-detects-death — the thing
# push can't see). ONLINE WINS across duplicate tailnet entries (a re-registered node leaves a stale
# offline ghost with an old nodekey; without online-wins, a live node flaps online↔offline forever).
#   mesh-nodestate          print the roster (state)
#   mesh-nodestate --ghosts list duplicate (ghost) tailnet registrations — a hygiene check
#   mesh-nodestate --test   smoke
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # dry-run: mock tailscale with synthetic JSON, exercise the parser + online-wins
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  printf '{"Self":{"HostName":"my-node","Online":true,"TailscaleIPs":["100.1.1.1"]},"Peer":{"peer1":{"HostName":"alice","Online":true,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.2"]},"peer2":{"HostName":"alice","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.3"]},"peer3":{"HostName":"bob","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.4"]},"peer4":{"HostName":"carol","Online":true,"Tags":[],"TailscaleIPs":["100.1.1.5"]}}}' > "$_td/mock.json"
  printf '#!/bin/sh\ncat "$(dirname "$0")/mock.json"\n' > "$_td/tailscale"; chmod +x "$_td/tailscale"
  PATH="$_td:$PATH"
  out="$(bash "$0" 2>/dev/null)" || { echo "smoke-test: FAIL (exec errored: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^alice: online$'     || { echo "smoke-test: FAIL (alice online-wins — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^bob: offline$'       || { echo "smoke-test: FAIL (bob offline — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^my-node: online$'    || { echo "smoke-test: FAIL (self missing — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE 'carol'                && { echo "smoke-test: FAIL (untagged carol leaked — got: $out)"; exit 1; }
  ghosts="$("$_td/tailscale" 2>/dev/null | bash "$0" --ghosts 2>/dev/null)"
  printf '%s\n' "$ghosts" | grep -qE 'alice.*2 registrations' || { echo "smoke-test: FAIL (ghosts missed double alice — got: $ghosts)"; exit 1; }
  rm -rf "$_td"
  trap '' EXIT
  echo "smoke-test: ok (online-wins dedup + ghost detection verified)"; exit 0
}
MODE="${1:-state}"
tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
mode='$MODE'
seen={}   # host -> [online flags]
def add(h,on): seen.setdefault(h,[]).append(bool(on))
s=d.get('Self',{})
if s: add(s.get('HostName','self'), s.get('Online'))
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []): add(p.get('HostName','?'), p.get('Online'))
if mode=='--ghosts':
    for h,flags in sorted(seen.items()):
        if len(flags)>1: print('%s: %d registrations %s' % (h, len(flags), flags))
else:
    for h in sorted(seen): print('%s: %s' % (h, 'online' if any(seen[h]) else 'offline'))
"
