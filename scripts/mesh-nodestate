#!/usr/bin/env bash
# mesh-nodestate — STATE-FN: one line per tag:lte-node node → 'hostname: online|stale|offline'.
# A clean state source for a node-liveness STREAM (the channel primitive): pull this, pipe through
# mesh-delta → a node going dark/online becomes a DELTA on the board (pull-detects-death — the thing
# push can't see). ONLINE WINS across duplicate tailnet entries (a re-registered node leaves a stale
# offline ghost with an old nodekey; without online-wins, a live node flaps online↔offline forever).
#
# LIVENESS IS A LEASE, NOT A CACHED FLAG (operator 2026-06-21, ds false-all-clear root cause): the
# Tailscale `Online` flag is a CACHED control-plane status that stayed True while default-string was
# frozen/off → the mesh treated a dead node as alive. So `online` is no longer reported from the flag
# ALONE — a node Tailscale calls Online is CORROBORATED with a fresh ping; if it does not answer it is
# reported `stale` (claimed-online-but-UNCONFIRMED), never a false `online`. Three honest states:
#   online  = Tailscale-Online AND a fresh ping answered (corroborated live), or self (we're running)
#   stale   = Tailscale-Online but NO fresh corroboration (the false-all-clear — presume not alive)
#   offline = Tailscale not Online (EXCEPT the phone/body — see below)
# BODY LAN-FALLBACK: the phone drops off the tailnet often but stays reachable on the home LAN. Before
# reporting the PHONE offline, a real LAN SSH probe (phone_reachable_ip, 8022/u0_a380) is tried; if it
# answers, the phone reads `online` — closing the false-negative that read 'body dark' over live sensors.
# MESH_NODESTATE_CORROBORATE=0 restores pure-parse (flag-only) behavior; MESH_NODESTATE_PING_CMD=<cmd>
# overrides the corroboration probe (<cmd> <ip>, exit 0=alive) — used by --test and for ssh-corroborate.
# OTP fault-tolerance study hook (2026-06-29): Erlang-style neighbours need a periodic ping that
# updates a local status table, not just a transient printed roster. `--ping` performs the same
# corroborated liveness read as state mode and appends one JSONL row per node to
# ~/.mesh/node-status.jsonl (override MESH_NODESTATUS_TABLE). This gives other reflexes a durable
# neighbour table while keeping the existing `mesh-nodestate` stream output unchanged.
# Second-order cybernetics live-review hook (2026-06-30): recent SoS work argues that constituent
# systems observe the system-of-systems from inside it, so observations must carry the observer
# explicitly, not masquerade as global truth. Source: Axelsson, "Implications of Second-Order
# Cybernetics and Autopoiesis on Systems-of-Systems Engineering", Systems 13(2):119, 2025,
# https://doi.org/10.3390/systems13020119. `--ping` rows therefore include observer metadata.
#   mesh-nodestate          print the roster (state)
#   mesh-nodestate --ping   ping all neighbours and update the local JSONL status table
#   mesh-nodestate --ghosts list duplicate (ghost) tailnet registrations — a hygiene check
#   mesh-nodestate --test   smoke
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# TAB SPLITTING — the shared library, never a private copy. `IFS=$'\t' read -r host ip tson isself`
# is NOT a tab splitter: tab is IFS *whitespace*, so bash collapses a run of tabs into one delimiter
# and an empty NON-TERMINAL field shifts every later field LEFT. emit_rows() emits `ip or ''` — a
# peer with no TailscaleIPs is legitimately IP-less — so that row landed as host|1|0|<empty>: tson
# read "0", classify_row took the not-Tailscale-online branch and a LIVE peer reported `offline`,
# while the --ping status row carried a fabricated `"ip":"1"` with `"ts_online":false`.
# The explicit EMPTY ARG is a CALLER-SIDE guard, and it is not decoration: `source` with no args
# leaves the caller's positional parameters in place, so `mesh-nodestate --test` hands "--test" to
# the library, which then ran ITS suite and `exit 0`-ed on ITS green line — our whole suite skipped,
# rc=0, nothing asserted (measured 2026-08-25 on the three tools already rewired). The library has
# since grown its own `${BASH_SOURCE[0]} = $0` guard, but a peer node's deployed copy may predate it
# and this tool runs fleet-wide; "" scopes $1 for the source and bash restores our own "$@" after.
source "$HOME/.local/bin/mesh-split-tabs.sh" "" 2>/dev/null || source "$(dirname "$0")/mesh-split-tabs.sh" "" 2>/dev/null || true
declare -F split_tabs >/dev/null \
  || { echo "mesh-nodestate: mesh-split-tabs.sh not found — refusing to run with a tab reader that drops empty fields" >&2; exit 1; }
MESH="${MESH_DIR:-$HOME/.mesh}"
STATUS_TABLE="${MESH_NODESTATUS_TABLE:-$MESH/node-status.jsonl}"
OBSERVER_ID="${MESH_NODESTATE_OBSERVER:-$(hostname 2>/dev/null || printf unknown)}"
[ "${1:-}" = --test ] && {
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # dry-run: mock tailscale with synthetic JSON, exercise the parser + online-wins
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  printf '{"Self":{"HostName":"my-node","Online":true,"TailscaleIPs":["100.1.1.1"]},"Peer":{"peer1":{"HostName":"alice","Online":true,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.2"]},"peer2":{"HostName":"alice","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.3"]},"peer3":{"HostName":"bob","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.4"]},"peer4":{"HostName":"carol","Online":true,"Tags":[],"TailscaleIPs":["100.1.1.5"]},"peer5":{"HostName":"dave","Online":true,"Tags":["tag:lte-node"],"TailscaleIPs":[]}}}' > "$_td/mock.json"
  printf '#!/bin/sh\ncat "$(dirname "$0")/mock.json"\n' > "$_td/tailscale"; chmod +x "$_td/tailscale"
  PATH="$_td:$PATH"
  # (a) pure-parse (corroboration off): online-wins dedup + tag filter + self
  out="$(MESH_NODESTATE_CORROBORATE=0 bash "$0" 2>/dev/null)" || { echo "smoke-test: FAIL (exec errored: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^alice: online$'     || { echo "smoke-test: FAIL (alice online-wins — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^bob: offline$'       || { echo "smoke-test: FAIL (bob offline — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^my-node: online$'    || { echo "smoke-test: FAIL (self missing — got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE 'carol'                && { echo "smoke-test: FAIL (untagged carol leaked — got: $out)"; exit 1; }
  # (b) LEASE corroboration: a Tailscale-Online node that fails the fresh ping is STALE, not a false online
  printf '#!/bin/sh\nexit 1\n' > "$_td/pingfail"; chmod +x "$_td/pingfail"
  printf '#!/bin/sh\nexit 0\n' > "$_td/pingok";   chmod +x "$_td/pingok"
  cf="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingfail" bash "$0" 2>/dev/null)"
  printf '%s\n' "$cf" | grep -qE '^alice: stale$'   || { echo "smoke-test: FAIL (online-but-unreachable must be STALE not online — got: $cf)"; exit 1; }
  printf '%s\n' "$cf" | grep -qE '^my-node: online$' || { echo "smoke-test: FAIL (self must stay online without ping — got: $cf)"; exit 1; }
  printf '%s\n' "$cf" | grep -qE '^bob: offline$'    || { echo "smoke-test: FAIL (bob offline regardless of corroboration — got: $cf)"; exit 1; }
  co="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingok" bash "$0" 2>/dev/null)"
  printf '%s\n' "$co" | grep -qE '^alice: online$'  || { echo "smoke-test: FAIL (online+ping-ok must be online — got: $co)"; exit 1; }
  # (c) --state <host>: per-host corroborated verdict + exit code
  s1="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingfail" bash "$0" --state alice 2>/dev/null)"; r1=$?
  [ "$s1" = stale ] && [ "$r1" = 2 ] || { echo "smoke-test: FAIL (--state alice w/ ping-fail must be 'stale' exit 2 — got '$s1' rc=$r1)"; exit 1; }
  s2="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingok" bash "$0" --state alice 2>/dev/null)"; r2=$?
  [ "$s2" = online ] && [ "$r2" = 0 ] || { echo "smoke-test: FAIL (--state alice w/ ping-ok must be 'online' exit 0 — got '$s2' rc=$r2)"; exit 1; }
  s3="$(bash "$0" --state bob 2>/dev/null)"; r3=$?
  [ "$s3" = offline ] && [ "$r3" = 1 ] || { echo "smoke-test: FAIL (--state bob must be 'offline' exit 1 — got '$s3' rc=$r3)"; exit 1; }
  s4="$(bash "$0" --state my-node 2>/dev/null)"; r4=$?
  [ "$s4" = online ] && [ "$r4" = 0 ] || { echo "smoke-test: FAIL (--state self must be 'online' exit 0 w/o ping — got '$s4' rc=$r4)"; exit 1; }
  s5="$(bash "$0" --state nobody 2>/dev/null)"; r5=$?
  [ "$s5" = absent ] && [ "$r5" = 3 ] || { echo "smoke-test: FAIL (--state nobody must be 'absent' exit 3 — got '$s5' rc=$r5)"; exit 1; }
  ghosts="$("$_td/tailscale" 2>/dev/null | bash "$0" --ghosts 2>/dev/null)"
  printf '%s\n' "$ghosts" | grep -qE 'alice.*2 registrations' || { echo "smoke-test: FAIL (ghosts missed double alice — got: $ghosts)"; exit 1; }
  # (c2) IP-LESS ROW / EMPTY NON-TERMINAL FIELD — the tab-splitting regression leg. 'dave' is
  #      Tailscale-Online with NO TailscaleIPs, so emit_rows prints an EMPTY field 2. Under
  #      `IFS=$'\t' read -r host ip tson isself` bash collapses the tab run: ip="1", tson="0",
  #      isself="" — a LIVE peer classified `offline` off a field that was never its own.
  #      Drives the REAL state-mode read path (emit_rows | while ...), not a private fixture.
  dv="$(MESH_NODESTATE_CORROBORATE=0 bash "$0" 2>/dev/null)"
  printf '%s\n' "$dv" | grep -qE '^dave: offline$' && { echo "smoke-test: FAIL (IP-less Tailscale-ONLINE peer reported offline — the empty ip field shifted tson left — got: $dv)"; exit 1; }
  printf '%s\n' "$dv" | grep -qE '^dave: online$'  || { echo "smoke-test: FAIL (IP-less peer w/ corroboration off must be online — got: $dv)"; exit 1; }
  # and with the lease on, an unprobeable (IP-less) peer is honest-UNCONFIRMED, never a false online
  dc="$(MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingok" bash "$0" 2>/dev/null)"
  printf '%s\n' "$dc" | grep -qE '^dave: stale$'   || { echo "smoke-test: FAIL (IP-less peer under corroboration must be stale — got: $dc)"; exit 1; }
  # the splitter itself, on this producer's exact row shape: every field in its own variable
  split_tabs "$(printf 'mesh-x\t\t1\t0')" _t_h _t_ip _t_on _t_self
  [ "$_t_h" = mesh-x ] && [ -z "$_t_ip" ] && [ "$_t_on" = 1 ] && [ "$_t_self" = 0 ] \
    || { echo "smoke-test: FAIL (split_tabs mis-bound an IP-less row: host='$_t_h' ip='$_t_ip' tson='$_t_on' isself='$_t_self')"; exit 1; }
  # (d) PHONE LAN-FALLBACK: a Tailscale-OFFLINE phone that answers a real LAN probe reads 'online'
  #     (closes the body false-negative); a non-phone offline node is unaffected; a dark phone stays offline.
  printf '{"Self":{"HostName":"my-node","Online":true,"TailscaleIPs":["100.1.1.1"]},"Peer":{"ph":{"HostName":"Redmi 10","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.9"]},"b":{"HostName":"bob","Online":false,"Tags":["tag:lte-node"],"TailscaleIPs":["100.1.1.4"]},"nip":{"HostName":"nipper","Online":true,"Tags":["tag:lte-node"],"TailscaleIPs":[]}}}' > "$_td/phone.json"
  printf '#!/bin/sh\ncat "%s"\n' "$_td/phone.json" > "$_td/tailscale"; chmod +x "$_td/tailscale"
  printf '#!/bin/sh\necho 192.168.8.203\nexit 0\n' > "$_td/phlive"; chmod +x "$_td/phlive"
  printf '#!/bin/sh\nexit 1\n'                      > "$_td/phdark"; chmod +x "$_td/phdark"
  pl="$(MESH_PHONE_LAN_PROBE="$_td/phlive" bash "$0" 2>/dev/null)"
  printf '%s\n' "$pl" | grep -qE '^Redmi 10: online$' || { echo "smoke-test: FAIL (TS-offline phone + LAN-live must read online — got: $pl)"; exit 1; }
  printf '%s\n' "$pl" | grep -qE '^bob: offline$'      || { echo "smoke-test: FAIL (non-phone offline must stay offline despite phone probe — got: $pl)"; exit 1; }
  pd="$(MESH_PHONE_LAN_PROBE="$_td/phdark" bash "$0" 2>/dev/null)"
  printf '%s\n' "$pd" | grep -qE '^Redmi 10: offline$' || { echo "smoke-test: FAIL (TS-offline phone that fails LAN probe must read offline — got: $pd)"; exit 1; }
  ps1="$(MESH_PHONE_LAN_PROBE="$_td/phlive" bash "$0" --state 'Redmi 10' 2>/dev/null)"; pr1=$?
  { [ "$ps1" = online ] && [ "$pr1" = 0 ]; } || { echo "smoke-test: FAIL (--state phone LAN-live must be online exit 0 — got '$ps1' rc=$pr1)"; exit 1; }
  ps2="$(MESH_PHONE_LAN_PROBE="$_td/phdark" bash "$0" --state 'Redmi 10' 2>/dev/null)"; pr2=$?
  { [ "$ps2" = offline ] && [ "$pr2" = 1 ]; } || { echo "smoke-test: FAIL (--state phone dark must be offline exit 1 — got '$ps2' rc=$pr2)"; exit 1; }
  # (e) --ping: periodic neighbour-ping operation writes a durable status table row per node.
  MESH_NODESTATUS_TABLE="$_td/node-status.jsonl" MESH_NODESTATE_CORROBORATE=1 MESH_NODESTATE_PING_CMD="$_td/pingfail" MESH_PHONE_LAN_PROBE="$_td/phdark" bash "$0" --ping >/tmp/.mesh-nodestate-ping.out 2>/dev/null \
    || { echo "smoke-test: FAIL (--ping errored)"; exit 1; }
  STATUS_TABLE="$_td/node-status.jsonl"
  [ -s "$STATUS_TABLE" ] || { echo "smoke-test: FAIL (--ping did not write status table)"; exit 1; }
  python3 - "$STATUS_TABLE" <<'PYEOF' || exit 1
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
states={r["node"]:r["state"] for r in rows}
assert states.get("my-node")=="online", states
assert states.get("Redmi 10")=="offline", states
assert states.get("bob")=="offline", states
# IP-LESS ROW through the --ping read path: 'nipper' is Tailscale-Online with no TailscaleIPs, so
# field 2 is EMPTY. `IFS=$'\t' read` shifted it to ip="1"/ts_online=False/self="" and the row was
# written as a LIVE peer reported offline wearing a FABRICATED address. All four must land right.
nip=[r for r in rows if r["node"]=="nipper"]
assert len(nip)==1, rows
nip=nip[0]
assert nip["ip"]=="", "fabricated ip on an IP-less peer: %r" % (nip,)
assert nip["ts_online"] is True, "empty ip field shifted ts_online left: %r" % (nip,)
assert nip["self"] is False, "empty ip field shifted self left: %r" % (nip,)
assert nip["state"]!="offline", "IP-less but Tailscale-online peer reported offline: %r" % (nip,)
assert nip["state"]=="stale", "unprobeable peer must read stale (honest-unconfirmed): %r" % (nip,)
for r in rows:
    assert "ts" in r and "ip" in r and "ts_online" in r and "self" in r
    assert r["observer"], r
    assert r["observer_role"] == "constituent-system", r
    assert r["observation_model"] == "second-order-neighbour-liveness", r
PYEOF
  rm -rf "$_td"
  trap '' EXIT
  echo "smoke-test: ok (online-wins dedup + ghost detection + lease-corroboration + --state query + --ping status table + IP-LESS row through both tab-read paths verified)"; exit 0
}
MODE="${1:-state}"
CORROB="${MESH_NODESTATE_CORROBORATE:-1}"; PINGCMD="${MESH_NODESTATE_PING_CMD:-}"

ts_now(){ date -u +%FT%TZ; }

# Fresh corroboration probe — a LIVE check, never a cached flag. Default = one quick ICMP ping
# (overridable to an ssh/announce-lease probe via MESH_NODESTATE_PING_CMD).
corrob(){ local ip="$1"; [ -z "$ip" ] && return 1
  if [ -n "$PINGCMD" ]; then "$PINGCMD" "$ip" >/dev/null 2>&1; else ping -c1 -W2 "$ip" >/dev/null 2>&1; fi; }

# LAN-FALLBACK FOR THE BODY (phone): Tailscale's Online flag goes False the moment the phone drops off
# the tailnet, but the phone is frequently STILL reachable on the home LAN (PHONE_LAN_IPS, SSH 8022 as
# u0_a380). Reporting 'offline' from the raw TS flag alone is then a FALSE NEGATIVE — windows read
# 'body dark / ~80-organ frontier blocked' while the phone's sensors produce live data. So before
# calling the PHONE offline, do a REAL LAN reachability probe (reuse phone_reachable_ip). Only fires
# for the phone host and only when TS already says not-Online, so it adds zero cost on the common path.
# MESH_PHONE_LAN_PROBE=<cmd> overrides the probe (<cmd> <host>, exit 0 = reachable) — used by --test.
phone_lan_live() {  # 0 = phone answers a real SSH probe on TS or LAN (8022/u0_a380); else 1
  case "$1" in *[Rr]edmi*|phone|Redmi) ;; *) return 1 ;; esac
  [ -n "${MESH_PHONE_LAN_PROBE:-}" ] && { "$MESH_PHONE_LAN_PROBE" "$1" >/dev/null 2>&1; return; }
  ( export PATH="$HOME/.local/bin:$PATH"
    [ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
    command -v phone_reachable_ip >/dev/null 2>&1 || . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || exit 1
    phone_reachable_ip >/dev/null 2>&1 )
}

emit_rows() {
  tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
seen={}   # host -> [(online, ip, isself)]
def add(h,on,ips,me=False):
    ip=(ips or [None])
    seen.setdefault(h,[]).append((bool(on), ip[0] if ip else None, me))
s=d.get('Self',{})
if s: add(s.get('HostName','self'), s.get('Online'), s.get('TailscaleIPs'), True)
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []): add(p.get('HostName','?'), p.get('Online'), p.get('TailscaleIPs'))
for h in sorted(seen):
    es=seen[h]; online=any(e[0] for e in es); isself=any(e[2] for e in es)
    ip=next((e[1] for e in es if e[0] and e[1]), None) or next((e[1] for e in es if e[1]), '')
    print('%s\t%s\t%d\t%d' % (h, ip or '', 1 if online else 0, 1 if isself else 0))
"
}

classify_row() {  # host ip tson isself -> echo state
  local host="$1" ip="$2" tson="$3" isself="$4"
  if [ "$tson" != 1 ]; then
    if phone_lan_live "$host"; then echo online; else echo offline; fi
  elif [ "$isself" = 1 ]; then
    echo online
  elif [ "$CORROB" != 1 ]; then
    echo online
  elif corrob "$ip"; then
    echo online
  else
    echo stale
  fi
}

if [ "$MODE" = --ghosts ]; then
  tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
seen={}
def add(h,on): seen.setdefault(h,[]).append(bool(on))
s=d.get('Self',{})
if s: add(s.get('HostName','self'), s.get('Online'))
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []): add(p.get('HostName','?'), p.get('Online'))
for h,flags in sorted(seen.items()):
    if len(flags)>1: print('%s: %d registrations %s' % (h, len(flags), flags))
"
  exit 0
fi

if [ "$MODE" = --ping ]; then
  mkdir -p "$(dirname "$STATUS_TABLE")"
  tmp="$(mktemp "${STATUS_TABLE}.XXXXXX")" || exit 1
  now="$(ts_now)"
  found=0
  while IFS= read -r _row; do
    split_tabs "$_row" host ip tson isself
    [ -z "$host" ] && continue
    state="$(classify_row "$host" "$ip" "$tson" "$isself")"
    python3 - "$now" "$OBSERVER_ID" "$host" "$ip" "$tson" "$isself" "$state" >> "$tmp" <<'PYEOF'
import json,sys
ts,observer,node,ip,tson,isself,state=sys.argv[1:8]
print(json.dumps({
  "ts": ts,
  "observer": observer,
  "observer_role": "constituent-system",
  "observation_model": "second-order-neighbour-liveness",
  "node": node,
  "ip": ip,
  "ts_online": tson == "1",
  "self": isself == "1",
  "state": state,
}, sort_keys=True))
PYEOF
    printf '%s: %s\n' "$host" "$state"
    found=1
  done < <(emit_rows)
  if [ "$found" = 1 ]; then
    cat "$tmp" >> "$STATUS_TABLE"
    rm -f "$tmp"
  else
    rm -f "$tmp"
    echo "mesh-nodestate: no nodes to ping" >&2
    exit 2
  fi
  exit 0
fi

# --state <host>: per-host CORROBORATED liveness verdict, exit-coded for scripting (the clean query
# API the consumer audit asked for — a consumer reads THIS, not raw .Online). Pings only that host.
#   stdout: online|stale|offline|absent   exit: 0 online · 2 stale · 1 offline · 3 absent/usage
if [ "$MODE" = --state ]; then
  want="${2:-}"; [ -z "$want" ] && { echo "usage: mesh-nodestate --state <host>" >&2; exit 3; }
  res=$(tailscale status --json 2>/dev/null | python3 -c "
import json,sys
want='$want'
try: d=json.load(sys.stdin)
except Exception: print('ABSENT'); sys.exit(0)
es=[]
s=d.get('Self',{})
if s and s.get('HostName')==want: es.append((bool(s.get('Online')),(s.get('TailscaleIPs') or [''])[0],True))
for p in (d.get('Peer') or {}).values():
    if p.get('HostName')==want and 'tag:lte-node' in (p.get('Tags') or []):
        es.append((bool(p.get('Online')),(p.get('TailscaleIPs') or [''])[0],False))
if not es: print('ABSENT'); sys.exit(0)
online=any(e[0] for e in es); isself=any(e[2] for e in es)
ip=next((e[1] for e in es if e[0] and e[1]),None) or next((e[1] for e in es if e[1]),'')
print('%s %d %d' % (ip or '-', 1 if online else 0, 1 if isself else 0))
")
  { [ -z "$res" ] || [ "$res" = ABSENT ]; } && { echo absent; exit 3; }
  read -r sip son sself <<<"$res"
  if [ "${son:-0}" != 1 ]; then                                   # Tailscale not Online ...
    if phone_lan_live "$want"; then echo online; exit 0; fi       # ... but the phone may be LAN-reachable
    echo offline; exit 1
  fi
  if [ "$sself" = 1 ]; then echo online; exit 0; fi               # self = we're running here
  if [ "$CORROB" != 1 ]; then echo online; exit 0; fi             # pure-parse escape hatch
  if corrob "$sip"; then echo online; exit 0; else echo stale; exit 2; fi  # corroborate the cached flag
fi

# state mode: python emits 'host\tip\ttsonline\tisself' (online-wins; ip from an online entry);
# bash then CORROBORATES each Tailscale-online peer with a fresh probe before calling it online.
emit_rows | while IFS= read -r _row; do
  split_tabs "$_row" host ip tson isself
  [ -z "$host" ] && continue
  echo "$host: $(classify_row "$host" "$ip" "$tson" "$isself")"
done
