#!/usr/bin/env bash
# mesh-reflex-census — catch a reflex that DISAPPEARED from the schedule entirely (was wired
# yesterday, gone today). The structural blind spot named by the operator 2026-06-21:
#   - mesh-reflex-health  catches scheduled-but-DEAD (cron-present, artifact went stale)
#   - mesh-pulse          catches a detector that STOPPED BEATING (heartbeat went stale)
#   - mesh-reflexes       RE-HEALS a cadence-declared drop — but silently, and only if the header survives
# NONE of them catch the EVENT of a reflex simply leaving the schedule: a vanished cron line leaves
# nothing to check and nothing to expect, so "what detects when the detector died" still resolved to
# "the mind notices by hand". This closes it by CENSUS-DIFF — catch the fact-of-orphaning, not hunt
# orphans one by one.
#
# Two complementary lenses:
#   (1) TEMPORAL  — diff the live schedule against a persisted baseline ("yesterday"): anything that
#                   was scheduled and is now GONE = a disappearance event. Baseline rolls forward, so
#                   each removal is reported exactly once.
#   (2) DECLARED  — a deployed tool that DECLARES `# reflex-cadence:` (so the genome INTENDS it to run)
#                   but is NOT in the schedule = orphaned-by-construction (the reorg / dropped-header
#                   death mode, [[reflex-cadence-or-reorg-orphans-it]]). Needs no history.
#
#   mesh-reflex-census          diff vs baseline + declared; edge-trigger [reflex-vanished]/[reflex-census-ok]
#   mesh-reflex-census --check  read-only report (no board post, no baseline write)
#   mesh-reflex-census --test   smoke test
#
# SELF-GROUNDING: declares its OWN cadence so a reorg can't silently drop the disappearance-detector
# itself (the very failure it exists to catch, applied reflexively); the terminating observer must
# stay alive. autowire is idempotent so this never double-schedules.
# reflex-cadence: 23 */2 * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; BASE="$M/.reflex-census"; STATE="$M/.reflex-census-state"
mkdir -p "$M"

# The SCHEDULED reflex set = every mesh-* tool invoked by the self-healing desired set (reflexes.cron)
# AND the live crontab, union+deduped. We track tool NAMES, not full lines — a cadence CHANGE is not a
# disappearance; only the tool leaving the schedule is. Comment lines are skipped.
current_set(){
  { cat "$M/reflexes.cron" 2>/dev/null; crontab -l 2>/dev/null; } \
    | grep -vE '^[[:space:]]*#' \
    | grep -oE 'mesh-[a-z0-9-]+' \
    | sort -u
}
# Tools that DECLARE a REAL recurring cadence (genome intends them scheduled by cron). A deployed
# mesh-* whose header carries a valid 5-field cron `# reflex-cadence:` but which is absent from
# current_set is orphaned-by-construction. CRITICAL: only a genuine 5-field cron counts — headers that
# say "none/off/on-demand/@reboot/<prose>" are deliberately-unscheduled (data-pane renderers, phone
# Termux:Boot units, on-demand instruments) and must NOT be flagged, or the alarm cries wolf. This
# mirrors what mesh-autowire actually wires (a 5-field cron, never @reboot/prose).
declared_set(){
  for f in "$HOME/.local/bin/"mesh-*; do
    [ -f "$f" ] || continue
    cad="$(grep -hoE '^#[[:space:]]*reflex-cadence:[[:space:]]*.*' "$f" 2>/dev/null | head -1 | sed -E 's/^#[[:space:]]*reflex-cadence:[[:space:]]*//')"
    [ -n "$cad" ] || continue
    # exactly 5 fields, each a cron token ([0-9*,/-]) — rejects "none …", "off", "@reboot …", prose.
    # NB: count fields with awk, NOT `set -- $cad` — the unquoted `*` in "*/5 * * * *" would glob
    # against the cwd and corrupt the count.
    [ "$(printf '%s' "$cad" | awk '{print NF}')" -eq 5 ] || continue
    printf '%s\n' "$cad" | grep -qE '^[0-9*,/ -]+$' || continue
    basename "$f"
  done | sort -u
}

if [ "${1:-}" = --test ]; then
  failures=0
  for dep in grep sort comm basename crontab cat printf; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; failures=1; }
  done
  command -v mesh-chat >/dev/null 2>&1 || echo "smoke-test: WARN (mesh-chat missing — edge alerts silent)"
  # synthetic fixture: a vanished member must be detected; an unchanged set must be clean.
  tmp=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; failures=1; }
  printf 'mesh-a\nmesh-b\nmesh-c\n' | sort -u > "$tmp/base"
  printf 'mesh-a\nmesh-c\n'         | sort -u > "$tmp/cur"    # mesh-b vanished
  van="$(comm -23 "$tmp/base" "$tmp/cur" | grep . | tr '\n' ' ')"
  [ "$(printf '%s' "$van" | tr -d ' ')" = "mesh-b" ] || { echo "smoke-test: FAIL (vanished detect: got '$van', want mesh-b)"; failures=1; }
  none="$(comm -23 "$tmp/cur" "$tmp/cur" | grep . | tr '\n' ' ')"
  [ -z "$(printf '%s' "$none" | tr -d ' ')" ] || { echo "smoke-test: FAIL (no-change produced a vanish: '$none')"; failures=1; }
  # current_set must be parseable + return only mesh-* tokens (no crash, no junk)
  bad="$(current_set | grep -vE '^mesh-[a-z0-9-]+$' | head -1)"
  [ -z "$bad" ] || { echo "smoke-test: FAIL (current_set emitted non-tool token: $bad)"; failures=1; }
  rm -rf "$tmp"
  ((failures)) && exit 1
  echo "smoke-test: ok (deps + vanished-diff fixture + current_set shape)"
  exit 0
fi

cur="$(current_set)"
declared="$(declared_set)"

# read-only report
if [ "${1:-}" = --check ]; then
  n=$(printf '%s\n' "$cur" | grep -c . || true)
  echo "reflex-census: $n reflex(es) scheduled"
  if [ -f "$BASE" ]; then
    van="$(comm -23 "$BASE" <(printf '%s\n' "$cur") | grep . | tr '\n' ' ')"
    [ -n "$van" ] && echo "  VANISHED vs baseline: $van" || echo "  vanished vs baseline: none"
  else
    echo "  (no baseline yet — first run will establish it)"
  fi
  undecl="$(comm -23 <(printf '%s\n' "$declared") <(printf '%s\n' "$cur") | grep . | tr '\n' ' ')"
  [ -n "$undecl" ] && echo "  DECLARED-but-UNSCHEDULED: $undecl" || echo "  declared-but-unscheduled: none"
  exit 0
fi

# first run: establish the baseline, no alarm (nothing to diff against yet)
if [ ! -f "$BASE" ]; then
  printf '%s\n' "$cur" > "$BASE"
  echo OK > "$STATE"
  n=$(printf '%s\n' "$cur" | grep -c . || true)
  echo "reflex-census: baseline established ($n reflex(es)) — disappearance detection armed"
  exit 0
fi

van="$(comm -23 "$BASE" <(printf '%s\n' "$cur") | grep . | tr '\n' ' ')"
undecl="$(comm -23 <(printf '%s\n' "$declared") <(printf '%s\n' "$cur") | grep . | tr '\n' ' ')"
van="${van% }"; undecl="${undecl% }"

alarm=""
[ -n "$van" ]    && alarm="vanished-from-schedule: $van"
[ -n "$undecl" ] && alarm="${alarm:+$alarm | }declared-but-unscheduled: $undecl"

prev="$(cat "$STATE" 2>/dev/null || echo OK)"
if [ -n "$alarm" ]; then
  if [ "$prev" != ALARM ] && command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO="reflex-census@$(hostname)" mesh-chat "[reflex-vanished] a reflex DISAPPEARED from the schedule (census-diff, not a stale-artifact): $alarm — was wired and is now gone, or genome declares a cadence the schedule doesn't honor. Intended removal? else re-wire (mesh-autowire / check the tool's reflex-cadence header)." >/dev/null 2>&1
  fi
  echo ALARM > "$STATE"
  printf '%s\n' "$cur" > "$BASE"   # roll baseline forward so each disappearance is reported once
  exit 1
else
  if [ "$prev" = ALARM ] && command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO="reflex-census@$(hostname)" mesh-chat "[reflex-census-ok] schedule census clean again — no vanished or declared-but-unscheduled reflexes." >/dev/null 2>&1
  fi
  echo OK > "$STATE"
  printf '%s\n' "$cur" > "$BASE"
  exit 0
fi
