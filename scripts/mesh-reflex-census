#!/usr/bin/env bash
# mesh-reflex-census — catch a reflex that DISAPPEARED from the schedule entirely (was wired
# yesterday, gone today). The structural blind spot named by the operator 2026-06-21:
#   - mesh-reflex-health  catches scheduled-but-DEAD (cron-present, artifact went stale)
#   - mesh-pulse          catches a detector that STOPPED BEATING (heartbeat went stale)
#   - mesh-reflexes       RE-HEALS a cadence-declared drop — but silently, and only if the header survives
# NONE of them catch the EVENT of a reflex simply leaving the schedule: a vanished cron line leaves
# nothing to check and nothing to expect, so "what detects when the detector died" still resolved to
# "the mind notices by hand". This closes it by CENSUS-DIFF — catch the fact-of-orphaning, not hunt
# orphans one by one.
#
# Three complementary lenses (the third is DESYNC phase-crowding, see COLLISION below):
#   (1) TEMPORAL  — diff the live schedule against a persisted baseline ("yesterday"): anything that
#                   was scheduled and is now GONE = a disappearance event. Baseline rolls forward, so
#                   each removal is reported exactly once.
#   (2) DECLARED  — a deployed tool that DECLARES `# reflex-cadence:` (so the genome INTENDS it to run)
#                   but is NOT in the schedule = orphaned-by-construction (the reorg / dropped-header
#                   death mode, [[reflex-cadence-or-reorg-orphans-it]]). Needs no history.
#   (3) COLLISION — DESYNC phase-crowding (Degesys, Rose & Nagpal, "DESYNC: Self-Organizing
#                   Desynchronization and TDMA on Wireless Sensor Networks", IPSN 2007). Cross-domain
#                   transfer from wireless-sensor-network desynchronization: periodic events sharing a
#                   phase COLLIDE, a thundering herd that spikes load. DESYNC's prescription is to
#                   spread periodic firings EVENLY around the period so peak is near mean. Reflexes
#                   wired onto identical cron phases (the */N family + plain-0 hourlies ALL landing on
#                   minute :00) pile up; on this thermally-throttled node a ~100-wide minute-0 herd is
#                   a real CPU/heat transient the two disappearance lenses are structurally blind to
#                   (they watch WHICH reflexes run, never WHEN they collide). This lens histograms
#                   co-firing over minute-of-hour and reports the peak minute + peak/mean concentration;
#                   the remedy is the hand-desync idiom already in reflexes.cron (*/30 -> 7-59/30 etc.).
#                   READ-ONLY / --check only (advisory: crowding drifts slowly, not an emergency, so
#                   deliberately NOT a board alarm, no new flood class). APPROXIMATION (honest):
#                   worst-case minute-of-hour peak, the hour field is not deduped, so an hour-gated
#                   reflex still counts at its minute (a conservative upper bound on simultaneity).
#
#   mesh-reflex-census          diff vs baseline + declared; edge-trigger [reflex-vanished]/[reflex-census-ok]
#   mesh-reflex-census --check  read-only report (no board post, no baseline write; + DESYNC crowding lens)
#   mesh-reflex-census --test   smoke test
#
# SELF-GROUNDING: declares its OWN cadence so a reorg can't silently drop the disappearance-detector
# itself (the very failure it exists to catch, applied reflexively); the terminating observer must
# stay alive. autowire is idempotent so this never double-schedules.
# reflex-cadence: 23 */2 * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# CRON-ENV BRIDGE: `systemctl --user` needs the user session bus, but cron runs WITHOUT
# XDG_RUNTIME_DIR / DBUS_SESSION_BUS_ADDRESS set — so liveness_set()/timer_set() would silently
# return empty under cron, making the loop+timer substrates invisible and the DECLARED/TEMPORAL
# lenses cry [reflex-vanished] every run on loop-driven reflexes (node-care/pane-watch). Re-establish
# the bus from the well-known path so the substrate is actually queryable in the scheduled context
# (the env that matters — interactive runs already have it). [[deployed-daemon-inert-until-restart]]-class
# gap: the fix worked interactively but was inert in cron until this bridge.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
[ -S "$XDG_RUNTIME_DIR/bus" ] && : "${DBUS_SESSION_BUS_ADDRESS:=unix:path=$XDG_RUNTIME_DIR/bus}" && export DBUS_SESSION_BUS_ADDRESS
M="$HOME/.mesh"; BASE="$M/.reflex-census"; STATE="$M/.reflex-census-state"
BIN="${MESH_REFLEX_CENSUS_BIN:-$HOME/.local/bin}"  # env override: test isolation only
mkdir -p "$M"

# The SCHEDULED reflex set = every mesh-* tool put on a recurring substrate, union+deduped. We track
# tool NAMES, not full lines — a cadence CHANGE is not a disappearance; only the tool leaving every
# substrate is. THREE substrates, not one (cron is no longer the only scheduler since 2026-06-21):
#   (a) cron        — reflexes.cron desired-set + the live crontab (comment lines skipped)
#   (b) liveness    — tools driven by the mesh-liveness-loop service (the closed-loop consume model
#                     that replaced direct cron mind-poking); only counts while the loop is ACTIVE
#   (c) timers      — tools run by an ACTIVE systemd user .timer→.service pair
# Gating (b)/(c) on is-active is deliberate: if a substrate is DEAD its tools genuinely aren't running
# and SHOULD surface — this is honest, not a blanket suppress. Omitting them (the pre-2026-06-21 bug)
# cried [reflex-vanished] every run on loop/timer-driven reflexes (node-care/pane-watch) that the cron
# lens couldn't see.
cron_set(){
  { cat "$M/reflexes.cron" 2>/dev/null; crontab -l 2>/dev/null; } \
    | grep -vE '^[[:space:]]*#' \
    | grep -oE 'mesh-[a-z0-9-]+'
}
liveness_set(){
  systemctl --user is-active --quiet mesh-liveness-loop 2>/dev/null || return 0
  grep -oE 'mesh-[a-z0-9-]+' "$HOME/.local/bin/mesh-liveness-loop" 2>/dev/null
}
timer_set(){
  local t svc
  systemctl --user list-timers --all --no-legend 2>/dev/null \
    | grep -oE '[A-Za-z0-9@._-]+\.timer' | sort -u | while read -r t; do
      [ -n "$t" ] || continue
      svc="$(systemctl --user show -p Unit --value "$t" 2>/dev/null)"
      [ -n "$svc" ] || svc="${t%.timer}.service"
      systemctl --user cat "$svc" 2>/dev/null | grep -E '^[[:space:]]*ExecStart' | grep -oE 'mesh-[a-z0-9-]+'
    done
}
current_set(){
  { cron_set; liveness_set; timer_set; } | LC_ALL=C sort -u
}
# _undecl_filter — stdin: newline-separated tool names (declared-minus-current diff). An RC-GATE,
# not a text match: run each tool's --test and keep it ONLY when it exits 0. rc=2 (honest n/a —
# hardware/vantage not present on this node) and rc=1 (hardware FAIL, e.g. phaedra's missing
# BAT0/pw-record/nmcli, verified live 04:38Z) both mean "not really orphaned" regardless of what
# the output TEXT says — the prior `*"n/a"*` string match missed rc=1 failures whose message
# doesn't literally say n/a. Falsify: reverting to the text match lets those slip back through.
_undecl_filter(){
  local _t _tb
  while IFS= read -r _t; do
    [ -n "$_t" ] || continue
    _tb="$BIN/$_t"
    [ -x "$_tb" ] || continue
    "$_tb" --test >/dev/null 2>&1 && printf '%s\n' "$_t"
  done
}
# _undecl_grace_filter — stdin: tool names (declared-minus-current diff). Drops any tool whose
# DEPLOYED file mtime is younger than MESH_CENSUS_AUTOWIRE_GRACE_S (default 1800, matching
# mesh-autowire's own */30 cadence; overridable, mirroring sync-tools' SYNC_WIP_WINDOW pattern).
# chat-review/census-declared-autowire-grace: a tool just deployed+autowired on ONE node hasn't
# necessarily reached every OTHER node's own next autowire tick yet — declared-but-not-yet-wired-HERE
# within that window is cross-node propagation lag, not a genuine orphan (live: mesh-powerbtn
# deployed+autowired on IdeaPad 11:47:35Z, phaedra's census cried [reflex-vanished] on it at
# 12:24:50Z purely from lag, self-cleared once phaedra's own autowire tick ran). Only a tool that's
# been sitting deployed-but-unwired PAST the grace window still flags. Falsify: revert this filter,
# the cross-node false alarm reappears on a freshly-deployed tool.
_undecl_grace_filter(){
  local grace="${MESH_CENSUS_AUTOWIRE_GRACE_S:-1800}" _t _tb _mtime _now _age
  _now=$(date +%s)
  while IFS= read -r _t; do
    [ -n "$_t" ] || continue
    _tb="$BIN/$_t"
    [ -f "$_tb" ] || { printf '%s\n' "$_t"; continue; }   # no file to age-check — pass through as-is
    _mtime=$(stat -c %Y "$_tb" 2>/dev/null || echo 0)
    _age=$(( _now - _mtime ))
    [ "$_age" -ge "$grace" ] && printf '%s\n' "$_t"
  done
}
# Tools that DECLARE a REAL recurring cadence (genome intends them scheduled by cron). A deployed
# mesh-* whose header carries a valid 5-field cron `# reflex-cadence:` but which is absent from
# current_set is orphaned-by-construction. CRITICAL: only a genuine 5-field cron counts — headers that
# say "none/off/on-demand/@reboot/<prose>" are deliberately-unscheduled (data-pane renderers, phone
# Termux:Boot units, on-demand instruments) and must NOT be flagged, or the alarm cries wolf. This
# mirrors what mesh-autowire actually wires (a 5-field cron, never @reboot/prose).
declared_set(){
  for f in "$HOME/.local/bin/"mesh-*; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    printf '%s\n' "$name" | grep -qE '^mesh-[a-z0-9-]+$' || continue
    cad="$(grep -hoE '^#[[:space:]]*reflex-cadence:[[:space:]]*.*' "$f" 2>/dev/null | head -1 | sed -E 's/^#[[:space:]]*reflex-cadence:[[:space:]]*//')"
    [ -n "$cad" ] || continue
    # exactly 5 fields, each a cron token ([0-9*,/-]) — rejects "none …", "off", "@reboot …", prose.
    # NB: count fields with awk, NOT `set -- $cad` — the unquoted `*` in "*/5 * * * *" would glob
    # against the cwd and corrupt the count.
    [ "$(printf '%s' "$cad" | awk '{print NF}')" -eq 5 ] || continue
    printf '%s\n' "$cad" | grep -qE '^[0-9*,/ -]+$' || continue
    printf '%s\n' "$name"
  done | LC_ALL=C sort -u
}
# DELIBERATELY-DISABLED opt-out set (chat-review/census-disabled-reflex-false-vanish): a reflex whose
# reflexes.cron line is COMMENTED OUT as a `# DISABLED-<reason>-<date> ... $HOME/.local/bin/mesh-X ...`
# opt-out is intentionally-off ON THIS NODE — not vanished, not orphaned. The tool FILE still declares
# `# reflex-cadence`, so declared_set keeps it and the DECLARED-but-UNSCHEDULED lens re-flags it EVERY
# run (live: phaedra mesh-home-state, disabled 2026-07-10 as senseless on a headless DC VPS — no home
# senses — yet [reflex-vanished] every census tick, exactly the board-noise the disable was meant to end;
# the 2cdd842 latch-fix stopped the SWALLOW but not this SOURCE). We match ONLY a commented line that
# still carries a full `bin/mesh-<tool>` invocation — a genuine disabled cron entry — never header prose
# (which names tools bare, without the bin/ path). Falsify: drop this filter, the disabled reflex re-noises.
# CRITICAL: match ONLY a commented line carrying an explicit `DISABLED` opt-out marker — NOT every
# commented cron line. Legacy migration comments (`# LIVENESS-LOOP-2026-06-21 ... bin/mesh-supervise`,
# `# REORG-2026-06-17 ... bin/mesh-mind-keepalive`) moved a reflex to the liveness-loop/timer substrate;
# those tools still RUN there (they're in current_set via liveness_set/timer_set) so subtracting them is
# a no-op WHILE the loop lives — but if the loop DIES the census is DESIGNED to surface them as vanished
# (the honest dead-substrate signal, above). Suppressing all commented lines would mask that regression;
# gating on the deliberate `DISABLED` marker keeps the mask scoped to genuine per-node opt-outs.
disabled_set(){
  grep -hiE '^[[:space:]]*#.*\bDISABLED\b' "$M/reflexes.cron" 2>/dev/null \
    | grep -oE 'bin/mesh-[a-z0-9-]+' \
    | sed -E 's#^bin/##' \
    | LC_ALL=C sort -u
}
# sub_disabled — stdin: newline tool names (sorted); $1: newline disabled set. Drops disabled members.
# comm needs sorted inputs; both are sorted (van/undecl come from comm output, disabled_set sorts).
sub_disabled(){ LC_ALL=C comm -23 <(LC_ALL=C sort -u) <(printf '%s\n' "$1" | grep . | LC_ALL=C sort -u); }
# COLLISION lens: histogram co-firing over minute-of-hour across the WHOLE schedule (reflexes.cron
# desired-set + live crontab), expanding each line's minute field. Emits "PEAK PEAKMIN RATIO" where
# RATIO=peak/mean (concentration; 1.0 = perfectly even DESYNC spread, higher = a thundering herd).
# Every-minute (`*`) reflexes contribute to all 60 minutes (they genuinely always fire). Non-cron
# first fields (@reboot etc.) expand to nothing and are ignored. No board post — advisory only.
crowding_stats(){
  { cat "$M/reflexes.cron" 2>/dev/null; crontab -l 2>/dev/null; } \
    | grep -vE '^[[:space:]]*#|^[[:space:]]*$' \
    | awk '
      function expand(mf,   i,step,rng){ delete arr
        if(mf=="*"){for(i=0;i<60;i++)arr[i]=1;return}
        if(mf ~ /^\*\/[0-9]+$/){step=substr(mf,3)+0;if(step<1)return;for(i=0;i<60;i+=step)arr[i]=1;return}
        if(mf ~ /^[0-9]+-[0-9]+\/[0-9]+$/){split(mf,rng,"[-/]");step=rng[3]+0;if(step<1)return;for(i=rng[1]+0;i<=rng[2]+0&&i<60;i+=step)arr[i]=1;return}
        if(mf ~ /^[0-9]+-[0-9]+$/){split(mf,rng,"-");for(i=rng[1]+0;i<=rng[2]+0&&i<60;i++)arr[i]=1;return}
        if(mf ~ /^[0-9]+$/){if(mf+0<60)arr[mf+0]=1;return} }
      { mf=$1; n=split(mf,cl,","); delete seen
        for(c=1;c<=n;c++){ expand(cl[c]); for(k in arr) seen[k]=1 }
        for(k in seen) hist[k]++ }
      END{ peak=0; peakmin=-1; sum=0
        for(i=0;i<60;i++){ sum+=hist[i]; if(hist[i]>peak){peak=hist[i];peakmin=i} }
        # DESYNC concentration = peak / ideal-flat-peak. Ideal-flat = total load spread over 60 min,
        # but discrete firings cant pack below 1/minute, so the floor is 1 (else a sparse-but-even
        # schedule reads as falsely crowded). >1.5 = a real thundering herd.
        mean=sum/60.0; denom=(mean>1)?mean:1; ratio=peak/denom
        printf "%d %d %.2f", peak, peakmin, ratio }'
}
# LOCALE-COLLATION BUG (health chat-review, 2026-07-01): comm -23 requires BOTH inputs sorted in the
# SAME collation it uses internally. Interactive shells here run en_US.UTF-8 → sort/comm agree; under
# CRON (LANG unset → C) comm re-collates byte-wise while a locale-default `sort -u` had already ordered
# the set differently, so comm sees "input is not in sorted order" and the vanished-diff goes garbage →
# spurious [reflex-vanished] alarms that don't reproduce interactively. Fix: force C collation on every
# sort -u feeding a comm AND on comm itself (below), so producer and consumer always agree regardless
# of invocation environment.

if [ "${1:-}" = --test ]; then
  failures=0
  for dep in grep sort comm basename crontab cat printf; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; failures=1; }
  done
  command -v mesh-chat >/dev/null 2>&1 || echo "smoke-test: WARN (mesh-chat missing — edge alerts silent)"
  # synthetic fixture: a vanished member must be detected; an unchanged set must be clean.
  tmp=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; failures=1; }
  printf 'mesh-a\nmesh-b\nmesh-c\n' | LC_ALL=C sort -u > "$tmp/base"
  printf 'mesh-a\nmesh-c\n'         | LC_ALL=C sort -u > "$tmp/cur"    # mesh-b vanished
  van="$(LC_ALL=C comm -23 "$tmp/base" "$tmp/cur" | grep . | tr '\n' ' ')"
  [ "$(printf '%s' "$van" | tr -d ' ')" = "mesh-b" ] || { echo "smoke-test: FAIL (vanished detect: got '$van', want mesh-b)"; failures=1; }
  none="$(LC_ALL=C comm -23 "$tmp/cur" "$tmp/cur" | grep . | tr '\n' ' ')"
  [ -z "$(printf '%s' "$none" | tr -d ' ')" ] || { echo "smoke-test: FAIL (no-change produced a vanish: '$none')"; failures=1; }
  # LOCALE-COLLATION regression guard: under C-locale cron (comm's mismatched-collation crash mode),
  # comm must not choke — feed it the exact disorder that triggered the real bug (byte-wise C order
  # differs from a locale-default sort for mixed-case/hyphenated tokens) and assert it still diffs clean.
  printf 'mesh-b\nmesh-a\nmesh-c\n' | LC_ALL=C sort -u > "$tmp/base2"
  printf 'mesh-a\nmesh-c\n'         | LC_ALL=C sort -u > "$tmp/cur2"
  van2="$(LC_ALL=C comm -23 "$tmp/base2" "$tmp/cur2" 2>&1 | grep . | tr '\n' ' ')"
  [ "$(printf '%s' "$van2" | tr -d ' ')" = "mesh-b" ] || { echo "smoke-test: FAIL (C-locale comm regression: got '$van2', want mesh-b)"; failures=1; }
  # every substrate source + the union must be parseable + emit only mesh-* tokens (no crash, no junk)
  for src in cron_set liveness_set timer_set current_set; do
    bad="$("$src" | grep -vE '^mesh-[a-z0-9-]+$' | head -1)"
    [ -z "$bad" ] || { echo "smoke-test: FAIL ($src emitted non-tool token: $bad)"; failures=1; }
  done
  # (3) COLLISION lens — DESYNC phase-crowding: a schedule where every line shares minute :00 must
  # register a peak = line-count concentrated on :00 (high ratio); an evenly-spread schedule ~1.0.
  crowd_probe(){ awk '
    function expand(mf,   i,step,rng){ delete arr
      if(mf=="*"){for(i=0;i<60;i++)arr[i]=1;return}
      if(mf ~ /^\*\/[0-9]+$/){step=substr(mf,3)+0;if(step<1)return;for(i=0;i<60;i+=step)arr[i]=1;return}
      if(mf ~ /^[0-9]+-[0-9]+\/[0-9]+$/){split(mf,rng,"[-/]");step=rng[3]+0;if(step<1)return;for(i=rng[1]+0;i<=rng[2]+0&&i<60;i+=step)arr[i]=1;return}
      if(mf ~ /^[0-9]+-[0-9]+$/){split(mf,rng,"-");for(i=rng[1]+0;i<=rng[2]+0&&i<60;i++)arr[i]=1;return}
      if(mf ~ /^[0-9]+$/){if(mf+0<60)arr[mf+0]=1;return} }
    { mf=$1; n=split(mf,cl,","); delete seen
      for(c=1;c<=n;c++){ expand(cl[c]); for(k in arr) seen[k]=1 }
      for(k in seen) hist[k]++ }
    END{ peak=0;peakmin=-1;sum=0; for(i=0;i<60;i++){sum+=hist[i];if(hist[i]>peak){peak=hist[i];peakmin=i}}
      mean=sum/60.0; denom=(mean>1)?mean:1; printf "%d %d %.2f", peak, peakmin, peak/denom }' "$1"; }
  printf '0 * * * * a\n0 * * * * b\n0 * * * * c\n0 * * * * d\n' > "$tmp/crowd"
  read -r cp cm cr <<< "$(crowd_probe "$tmp/crowd")"
  [ "$cp" = 4 ] && [ "$cm" = 0 ] || { echo "smoke-test: FAIL (crowd peak: got $cp@:$cm, want 4@:0)"; failures=1; }
  awk "BEGIN{exit !($cr>=1.5)}" || { echo "smoke-test: FAIL (crowd ratio $cr not >=1.5)"; failures=1; }
  # even spread: 4 reflexes each on a distinct minute -> peak 1, ratio ~1.0 (DESYNC-healthy)
  printf '0 * * * * a\n15 * * * * b\n30 * * * * c\n45 * * * * d\n' > "$tmp/even"
  read -r ep em er <<< "$(crowd_probe "$tmp/even")"
  [ "$ep" = 1 ] || { echo "smoke-test: FAIL (even peak: got $ep, want 1)"; failures=1; }
  awk "BEGIN{exit !($er<1.5)}" || { echo "smoke-test: FAIL (even ratio $er should be <1.5)"; failures=1; }
  # */30 expands to :00 and :30 (step family) — regression guard on the step expander
  printf '*/30 * * * * a\n' > "$tmp/step"
  read -r sp sm sr <<< "$(crowd_probe "$tmp/step")"
  [ "$sp" = 1 ] || { echo "smoke-test: FAIL (*/30 peak: got $sp, want 1 at :00 and :30)"; failures=1; }
  # DECLARED-but-UNSCHEDULED rc-gate: skip on ANY non-zero exit (honest n/a=2, hardware FAIL=1
  # with no "n/a" in the text), flag only a genuine rc=0 orphan. Falsify: reverting to the old
  # `*"n/a"*` text match would let mesh-hwfail1 (rc=1, no n/a text) slip through as a false orphan.
  mkdir -p "$tmp/bin"
  printf '#!/bin/sh\necho "hardware missing: no BAT0"\nexit 1\n' > "$tmp/bin/mesh-hwfail1"
  printf '#!/bin/sh\necho "n/a on this node"\nexit 2\n'          > "$tmp/bin/mesh-na2"
  printf '#!/bin/sh\necho "smoke-test: ok"\nexit 0\n'            > "$tmp/bin/mesh-ok3"
  chmod +x "$tmp/bin/mesh-hwfail1" "$tmp/bin/mesh-na2" "$tmp/bin/mesh-ok3"
  gate_out="$(printf 'mesh-hwfail1\nmesh-na2\nmesh-ok3\nmesh-missing\n' | BIN="$tmp/bin" _undecl_filter | tr '\n' ' ')"
  gate_out="${gate_out% }"
  [ "$gate_out" = "mesh-ok3" ] || { echo "smoke-test: FAIL (rc-gate: got '$gate_out', want 'mesh-ok3' only)"; failures=1; }
  # AUTOWIRE-GRACE (chat-review/census-declared-autowire-grace): a declared-but-not-yet-scheduled
  # tool deployed JUST NOW (mtime=now) must NOT flag — propagation lag before this node's own next
  # autowire tick, not a genuine orphan. The SAME tool backdated past the grace window must still
  # flag (regression guard: real orphans still caught). Falsify: revert _undecl_grace_filter, the
  # fresh-deploy case starts flagging again.
  printf '#!/bin/sh\necho ok\nexit 0\n' > "$tmp/bin/mesh-freshdecl"; chmod +x "$tmp/bin/mesh-freshdecl"
  fresh_out="$(printf 'mesh-freshdecl\n' | BIN="$tmp/bin" MESH_CENSUS_AUTOWIRE_GRACE_S=1800 _undecl_grace_filter | tr '\n' ' ')"
  fresh_out="${fresh_out% }"
  [ -z "$fresh_out" ] || { echo "smoke-test: FAIL (fresh-deploy grace: got '$fresh_out', want empty — should be held as propagation lag)"; failures=1; }
  touch -d "@$(( $(date +%s) - 3600 ))" "$tmp/bin/mesh-freshdecl" 2>/dev/null
  old_out="$(printf 'mesh-freshdecl\n' | BIN="$tmp/bin" MESH_CENSUS_AUTOWIRE_GRACE_S=1800 _undecl_grace_filter | tr '\n' ' ')"
  old_out="${old_out% }"
  [ "$old_out" = "mesh-freshdecl" ] || { echo "smoke-test: FAIL (backdated-past-grace: got '$old_out', want 'mesh-freshdecl' — real orphan must still flag)"; failures=1; }
  # census-alarm-latch-masks-vanish: the alarmed-member SET must edge-trigger on a NEW member even
  # while an OLD member stays latched — the binary prev!=ALARM gate used to swallow it. Reproduce the
  # exact three-run sequence the fix targets (this is the diff the production block runs each tick).
  set_new(){ LC_ALL=C comm -23 <(printf '%s\n' "$2"|grep .|LC_ALL=C sort -u) <(printf '%s\n' "$1"|grep .|LC_ALL=C sort -u) | grep . | tr '\n' ' ' | sed 's/ $//'; }
  # (a) A vanishes: prev empty, cur={A} -> new must be A (posts).
  a_new="$(set_new "" "mesh-A")"
  [ "$a_new" = "mesh-A" ] || { echo "smoke-test: FAIL (latch (a): got '$a_new', want mesh-A)"; failures=1; }
  # (b) A still-latched (undecl), B newly-vanishes: prev={A}, cur={A,B} -> new must be EXACTLY B.
  #     This reproduces the mask; reverting to the binary prev!=ALARM gate would swallow B entirely.
  b_new="$(set_new "mesh-A" "$(printf 'mesh-A\nmesh-B\n')")"
  [ "$b_new" = "mesh-B" ] || { echo "smoke-test: FAIL (latch (b) mask: got '$b_new', want mesh-B only — B swallowed?)"; failures=1; }
  # (c) set unchanged: prev={A,B}, cur={A,B} -> no new member (silent, no re-spam).
  c_new="$(set_new "$(printf 'mesh-A\nmesh-B\n')" "$(printf 'mesh-A\nmesh-B\n')")"
  [ -z "$c_new" ] || { echo "smoke-test: FAIL (latch (c) re-spam: got '$c_new', want empty)"; failures=1; }
  # DISABLED-reflex opt-out (chat-review/census-disabled-reflex-false-vanish): a commented-out cron line
  # carrying a full bin/mesh-<tool> invocation is a deliberate per-node opt-out — disabled_set must
  # extract it (so van/undecl subtract it), while a LIVE (uncommented) line and header PROSE (bare tool
  # name, no bin/ path) must NOT match. Falsify: drop disabled_set, phaedra's disabled mesh-home-state
  # re-flags [reflex-vanished] every tick.
  mkdir -p "$tmp/mesh"
  printf '# DISABLED-senseless-node-2026-07-10 (no home senses) 4-59/5 * * * * $HOME/.local/bin/mesh-home-state >> x 2>&1\n' > "$tmp/mesh/reflexes.cron"
  printf '*/5 * * * * $HOME/.local/bin/mesh-live-one >> x 2>&1\n'                                                          >> "$tmp/mesh/reflexes.cron"
  printf '# LIVENESS-LOOP-2026-06-21 */2 * * * * $HOME/.local/bin/mesh-migrated-loop >> x 2>&1\n'                          >> "$tmp/mesh/reflexes.cron"
  printf '# see mesh-prose-ref for context (bare name in prose, no bin/ path)\n'                                          >> "$tmp/mesh/reflexes.cron"
  dis_out="$(M="$tmp/mesh" disabled_set | tr '\n' ' ')"; dis_out="${dis_out% }"
  # ONLY the DISABLED-marked line matches: live line (uncommented), LIVENESS-LOOP legacy migration
  # (still runs via liveness substrate — must stay surfaceable if that substrate dies), and prose
  # bare-name all excluded. Falsify: matching every commented line would return mesh-migrated-loop too,
  # masking a genuine dead-liveness-loop vanish.
  [ "$dis_out" = "mesh-home-state" ] || { echo "smoke-test: FAIL (disabled_set: got '$dis_out', want 'mesh-home-state' only — live/legacy-migration/prose must not match)"; failures=1; }
  sub_out="$(printf 'mesh-home-state\nmesh-keep\n' | sub_disabled "mesh-home-state" | tr '\n' ' ')"; sub_out="${sub_out% }"
  [ "$sub_out" = "mesh-keep" ] || { echo "smoke-test: FAIL (sub_disabled: got '$sub_out', want 'mesh-keep' — disabled member not dropped)"; failures=1; }
  rm -rf "$tmp"
  ((failures)) && exit 1
  echo "smoke-test: ok (deps + vanished-diff fixture + current_set shape + DESYNC crowding: crowded/even/step)"
  exit 0
fi

cur="$(current_set)"
declared="$(declared_set)"
disabled="$(disabled_set)"

# read-only report
if [ "${1:-}" = --check ]; then
  n=$(printf '%s\n' "$cur" | grep -c . || true)
  echo "reflex-census: $n reflex(es) scheduled"
  if [ -f "$BASE" ]; then
    # re-sort BASE under C collation at read-time (self-healing: a pre-fix BASE file may still be on
    # disk in locale-default order — this makes every run canonical without a separate migration step)
    van="$(LC_ALL=C comm -23 <(LC_ALL=C sort -u "$BASE") <(printf '%s\n' "$cur") | grep . | sub_disabled "$disabled" | grep . | tr '\n' ' ')"
    [ -n "$van" ] && echo "  VANISHED vs baseline: $van" || echo "  vanished vs baseline: none"
  else
    echo "  (no baseline yet — first run will establish it)"
  fi
  undecl_raw="$(LC_ALL=C comm -23 <(printf '%s\n' "$declared") <(printf '%s\n' "$cur") | grep . | sub_disabled "$disabled" | grep .)"
  undecl="$(printf '%s\n' "$undecl_raw" | _undecl_grace_filter | _undecl_filter | tr '\n' ' ')"
  undecl="${undecl% }"
  [ -n "$undecl" ] && echo "  DECLARED-but-UNSCHEDULED: $undecl" || echo "  declared-but-unscheduled: none"
  # (3) COLLISION lens — DESYNC phase-crowding (read-only advisory)
  read -r cw_peak cw_min cw_ratio <<< "$(crowding_stats)"
  if [ -n "${cw_peak:-}" ] && [ "${cw_peak:-0}" -gt 0 ]; then
    # CROWDED when the peak is both concentrated (peak/mean >= 1.5) AND non-trivial (peak >= 8) —
    # so a small evenly-spread schedule never cries wolf.
    if awk "BEGIN{exit !(${cw_ratio:-0}>=1.5)}" && [ "$cw_peak" -ge 8 ]; then
      verdict="CROWDED — re-offset the */N & plain-:00 cadences (DESYNC: */30 -> 7-59/30 idiom)"
    else
      verdict="even spread (DESYNC-healthy)"
    fi
    printf '  phase-crowding (DESYNC): busiest minute :%02d has %d reflexes co-firing (peak/mean %sx) — %s\n' \
      "$cw_min" "$cw_peak" "$cw_ratio" "$verdict"
  fi
  exit 0
fi

# first run: establish the baseline, no alarm (nothing to diff against yet)
if [ ! -f "$BASE" ]; then
  printf '%s\n' "$cur" > "$BASE"
  echo OK > "$STATE"
  n=$(printf '%s\n' "$cur" | grep -c . || true)
  echo "reflex-census: baseline established ($n reflex(es)) — disappearance detection armed"
  exit 0
fi

van="$(LC_ALL=C comm -23 <(LC_ALL=C sort -u "$BASE") <(printf '%s\n' "$cur") | grep . | sub_disabled "$disabled" | grep . | tr '\n' ' ')"
undecl_raw="$(LC_ALL=C comm -23 <(printf '%s\n' "$declared") <(printf '%s\n' "$cur") | grep . | sub_disabled "$disabled" | grep .)"
# rc-gate (see _undecl_filter): skips honest n/a (exit 2) AND hardware-FAIL (exit 1) alike —
# these are legitimately unwired (phone sensors on desktop, missing sysfs/BAT0/nmcli, etc.),
# not orphaned.
undecl="$(printf '%s\n' "$undecl_raw" | _undecl_grace_filter | _undecl_filter | tr '\n' ' ')"
van="${van% }"; undecl="${undecl% }"

# EDGE-TRIGGER ON THE ALARMED-MEMBER SET, not a binary OK/ALARM flag (chat-review/census-alarm-latch-masks-vanish):
# STATE persists the SET of currently-alarming tool names (vanished ∪ declared-but-unscheduled), one
# per line. The old binary gate (`prev != ALARM`) let a long-lived member (e.g. an exit-0 `undecl`
# tool that never gets wired — phaedra home-state/household) latch STATE=ALARM indefinitely and
# SWALLOW every later fresh disappearance: the new member was added to the alarm but NOT posted
# (prev already ALARM) while BASE rolled forward (below) absorbed it unannounced. Now we post whenever
# the set GAINS a member (naming only the NEW ones), even while an old member stays latched, and post
# [reflex-census-ok] only when the set empties. Falsify: revert to the binary prev!=ALARM gate → a B
# that vanishes while A stays latched is swallowed (guarded by --test case (b)).
cur_set="$( { printf '%s\n' "$van"; printf '%s\n' "$undecl"; } | tr ' ' '\n' | grep . | LC_ALL=C sort -u )"
prev_raw="$(cat "$STATE" 2>/dev/null || true)"
case "$prev_raw" in
  OK|ALARM|"") prev_set="" ;;                                   # migrate the legacy binary flag → empty set
  *)           prev_set="$(printf '%s\n' "$prev_raw" | grep . | LC_ALL=C sort -u)" ;;
esac
new_members="$(LC_ALL=C comm -23 <(printf '%s\n' "$cur_set") <(printf '%s\n' "$prev_set") | grep . | tr '\n' ' ')"
new_members="${new_members% }"
still="$(LC_ALL=C comm -12 <(printf '%s\n' "$cur_set") <(printf '%s\n' "$prev_set") | grep . | tr '\n' ' ')"
still="${still% }"

if [ -n "$new_members" ] && command -v mesh-chat >/dev/null 2>&1; then
  # classify each NEW member as vanished vs declared-but-unscheduled for the post
  detail=""
  for m in $new_members; do
    case " $van " in *" $m "*) kind="vanished-from-schedule" ;; *) kind="declared-but-unscheduled" ;; esac
    detail="${detail:+$detail, }$m ($kind)"
  done
  MESH_WHO="reflex-census@$(hostname)" mesh-chat "[reflex-vanished] NEW reflex(es) left the schedule (census-diff, not a stale-artifact): $detail${still:+ — still latched from before: $still}. Was wired and is now gone, or genome declares a cadence the schedule doesn't honor. Intended removal? else re-wire (mesh-autowire / check the tool's reflex-cadence header)." >/dev/null 2>&1
elif [ -z "$cur_set" ] && [ -n "$prev_set" ] && command -v mesh-chat >/dev/null 2>&1; then
  MESH_WHO="reflex-census@$(hostname)" mesh-chat "[reflex-census-ok] schedule census clean again — no vanished or declared-but-unscheduled reflexes." >/dev/null 2>&1
fi

printf '%s\n' "$cur_set" > "$STATE"   # persist the alarmed-member set (edge-trigger key), not a binary flag
printf '%s\n' "$cur" > "$BASE"        # roll baseline forward so each disappearance is reported once
[ -n "$cur_set" ] && exit 1 || exit 0
