#!/usr/bin/env bash
# mesh-board-timerepair — one-shot repair for the 2026-06-11 board date-fabrication.
#
# The broken chat-sync backfill stamped TODAY's date onto undated legacy lines. Most of the
# damage is ambiguous (yesterday's 15:xx vs today's real 15:xx — left as a documented scar),
# but one subset is PROVABLY wrong: a line stamped <today>T<time> where <time> is in the
# FUTURE cannot have been posted today — it is yesterday's line. Rewriting those to
# <yesterday>T<time> is a correction, not fabrication (timestamps cannot precede their writes).
#
# Idempotent; run on every node that synced during the fabrication window (local + ilya).
#   mesh-board-timerepair            repair ~/.mesh/chat.log in place (backs up first)
#   mesh-board-timerepair --dry-run  show what would change
#   mesh-board-timerepair --test     fixture self-test
set -uo pipefail
LOG="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"

repair(){ # stdin -> stdout; $1=today (YYYY-MM-DD) $2=yesterday $3=now (HH:MM:SS)
  awk -v today="$1" -v yday="$2" -v now="$3" '{
    if ($0 ~ "^" today "T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z") {
      t = substr($0, length(today) + 2, 8)
      if (t > now) { print yday "T" substr($0, length(today) + 2); next }
    }
    print
  }'
}

if [ "${1:-}" = --test ]; then
  out=$(printf '2026-06-11T23:50:00Z ghost\n2026-06-11T10:00:00Z real\nplain line\n' \
        | repair 2026-06-11 2026-06-10 "12:00:00")
  echo "$out" | grep -q '^2026-06-10T23:50:00Z ghost$' || { echo "smoke-test: FAIL (future not repaired)"; exit 1; }
  echo "$out" | grep -q '^2026-06-11T10:00:00Z real$'  || { echo "smoke-test: FAIL (past line touched)"; exit 1; }
  echo "$out" | grep -q '^plain line$'                  || { echo "smoke-test: FAIL (plain line touched)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

today=$(date -u +%F); yday=$(date -u -d yesterday +%F); now=$(date -u +%H:%M:%S)
n=$(grep -cE "^${today}T" "$LOG" 2>/dev/null || true); n="${n:-0}"
fixable=$(repair "$today" "$yday" "$now" < "$LOG" | grep -cE "^${yday}T" || true)
already=$(grep -cE "^${yday}T" "$LOG" 2>/dev/null || true)
fixable=$(( ${fixable:-0} - ${already:-0} ))

if [ "${1:-}" = --dry-run ]; then
  echo "would repair $fixable provably-future line(s) (dated ${today}, time > ${now})"
  exit 0
fi

cp "$LOG" "$LOG.pre-timerepair.bak"
repair "$today" "$yday" "$now" < "$LOG.pre-timerepair.bak" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
echo "repaired $fixable provably-future line(s); backup: $LOG.pre-timerepair.bak"
