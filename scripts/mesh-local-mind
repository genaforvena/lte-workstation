#!/usr/bin/env bash
# mesh-local-mind — geo-block-immune local inference via ollama.
# Calls the ollama API (localhost:11434) for on-node LLM inference that works
# even when Anthropic/Gemini are blocked or unreachable.
#
#   mesh-local-mind '<prompt>'           infer with default/auto-detected model
#   mesh-local-mind --model <m> '<p>'   use specific model
#   mesh-local-mind --no-think '<p>'    suppress thinking (payload "think": false — makes
#                                       qwen3.5-family viable: its reasoning otherwise overflows
#                                       num_ctx → done=length → EMPTY .response on heavy prompts)
#   mesh-local-mind --list              list available models
#   echo '<p>' | mesh-local-mind        read prompt from stdin
#
# MESH_LOCAL_MIND_THINK=false          env equivalent of --no-think (for callers that can't
#                                      change argv plumbing, e.g. a relay pool hop)
#
# Server lifecycle: if ollama isn't running, attempts auto-start (background).
# Called by other mesh tools as the local-inference primitive.
set -uo pipefail
export PATH="$HOME/.local/ollama/bin:$HOME/.local/bin:$PATH"

OLLAMA_URL_EXPLICIT="${OLLAMA_URL:+yes}"   # was OLLAMA_URL set by the caller? (don't override it)
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"
# Prefer whatever `ollama` is on PATH (a SYSTEM install at /usr/local/bin on a GPU node) over the
# user-space install path. The mesh-home GPU node has ollama at /usr/local/bin, but this hard-defaulted
# to the ~/.local path → ensure_server saw "no local binary" and SSH-hopped to a CPU peer instead of
# starting the local GPU serve (GPU-idle find, discover 2026-07-14). command -v resolves the real
# binary generically — no hardcoded node-specific path. PATH (set above) puts ~/.local/ollama/bin first,
# so a user-space install still wins where it exists.
OLLAMA_BIN="${OLLAMA_BIN:-$(command -v ollama 2>/dev/null || echo "$HOME/.local/ollama/bin/ollama")}"
DEFAULT_MODEL="${MESH_LOCAL_MIND_MODEL:-}"   # blank = auto-detect first available
START_TIMEOUT=12   # seconds to wait for server to come up after auto-start

die()  { echo "mesh-local-mind: $*" >&2; exit 1; }
info() { echo "mesh-local-mind: $*" >&2; }

# --- server liveness ---
server_up() { curl -sf "$OLLAMA_URL/api/tags" >/dev/null 2>&1; }

# Mesh failover: if this node can't serve locally, use the SHARED mesh local-mind node (the one
# host that holds the model) over the tailnet — that's the point of a shared geo-block-immune mind.
# Only when the caller didn't pin OLLAMA_URL. Registry-resolved (no hardcoded tailnet IP).
try_mesh_endpoint() {
    [ -n "$OLLAMA_URL_EXPLICIT" ] && return 1
    local a; a="$(mesh-peer-addr default-string 2>/dev/null || mesh-peer-addr ds 2>/dev/null || true)"
    [ -n "$a" ] || return 1
    local url="http://$a:11434"
    curl -sf -m 6 "$url/api/tags" >/dev/null 2>&1 || return 1
    OLLAMA_URL="$url"; info "local serve down — using the shared mesh local-mind at $a"; return 0
}

# Failover transport needing NO API exposure: reach the shared mind over authenticated SSH
# (Tailscale path → still works when internet egress is geo-blocked). Sets SSH_MIND_PEER so the
# infer step runs `ollama run` on the remote via SSH instead of the HTTP API. This is why the
# local-mind failover works WITHOUT the operator-gated ollama-API exposure.
SSH_MIND_PEER=""
try_mesh_ssh() {
    [ -n "$OLLAMA_URL_EXPLICIT" ] && return 1
    local a; a="$(mesh-peer-addr default-string 2>/dev/null || mesh-peer-addr ds 2>/dev/null || true)"
    [ -n "$a" ] || return 1
    local peer="${MESH_PEER_USER:-imozerov}@$a"
    # only claim it if the remote ollama can actually answer (don't offer a mind that can't think)
    ssh -o BatchMode=yes -o ConnectTimeout=6 "$peer" 'command -v ollama >/dev/null 2>&1 && ollama list 2>/dev/null | grep -q .' </dev/null >/dev/null 2>&1 || return 1
    SSH_MIND_PEER="$peer"; info "local serve down + API not exposed — using shared mind via SSH at $a"; return 0
}

ensure_server() {
    if server_up; then return 0; fi
    # PREFER A LOCAL SERVE when this node has its own ollama binary — a local (esp. GPU) serve beats
    # SSH-hopping to a remote CPU peer (mesh-home GPU-idle find, discover 2026-07-14; the old order
    # tried the shared mind FIRST and left the local GPU idle). Only fall back to the shared mesh
    # local-mind when there is NO local binary to start (a lean/RAM-constrained node simply doesn't
    # install ollama → has no binary → failovers, exactly as before). This keeps "a node declares what
    # it offers": no local ollama = borrow the shared mind; local ollama present = serve it yourself.
    if [ -x "$OLLAMA_BIN" ]; then
        info "ollama not running — starting 'ollama serve' in background ($OLLAMA_BIN)…"
        nohup "$OLLAMA_BIN" serve >/tmp/ollama-serve.log 2>&1 &
        local waited=0
        while [ "$waited" -lt "$START_TIMEOUT" ]; do
            sleep 1; waited=$((waited + 1))
            server_up && { info "server up (${waited}s)"; return 0; }
        done
        info "local ollama serve did not come up within ${START_TIMEOUT}s — trying the shared mesh mind"
    fi
    # no local binary (or local start failed): use the shared mesh local-mind node —
    # HTTP API (if exposed), then SSH transport (no exposure needed).
    try_mesh_endpoint && return 0
    try_mesh_ssh && return 0
    [ -x "$OLLAMA_BIN" ] && die "local ollama serve did not start within ${START_TIMEOUT}s and the shared mesh mind is unreachable — check /tmp/ollama-serve.log"
    die "no local ollama AND the shared mesh local-mind is unreachable (HTTP + SSH) — run: mesh-local-mind --install"
}

# --- model selection ---
list_models() {
    ensure_server
    curl -sf "$OLLAMA_URL/api/tags" \
      | python3 -c "
import sys, json
d = json.load(sys.stdin)
models = d.get('models', [])
if not models:
    print('(no models pulled yet — run: ollama pull qwen2.5:3b)')
else:
    for m in models:
        print(m['name'])
"
}

pick_model() {
    local preferred="$1"
    # explicit choice wins
    [ -n "$preferred" ] && { echo "$preferred"; return; }
    # env override
    [ -n "$DEFAULT_MODEL" ] && { echo "$DEFAULT_MODEL"; return; }
    # auto: first available, prefer qwen2.5 variants
    curl -sf "$OLLAMA_URL/api/tags" \
      | python3 -c "
import sys, json
models = json.load(sys.stdin).get('models', [])
names = [m['name'] for m in models]
if not names:
    print('')
else:
    # prefer qwen2.5 or smallest/fastest
    for pref in ('qwen2.5:3b','qwen2.5','qwen','llama'):
        for n in names:
            if pref in n:
                print(n); sys.exit(0)
    print(names[0])
" 2>/dev/null || echo ""
}

# --- install (user-space, no sudo): the DECLARED, reviewable, plantable way to stand up the
# local mind. Converts the ad-hoc "curl a binary | tar" (which a sandbox rightly distrusts) into
# one named command an operator can authorize/allow-rule. Default model is small enough for a
# RAM-constrained node (override: mesh-local-mind --install <model>, or MESH_LOCAL_MIND_MODEL). ---
DEFAULT_INSTALL_MODEL="${MESH_LOCAL_MIND_MODEL:-qwen2.5:1.5b}"
OLLAMA_TGZ_URL="${OLLAMA_TGZ_URL:-https://github.com/ollama/ollama/releases/latest/download/ollama-linux-amd64.tar.zst}"

install_ollama() {
    local model="${1:-$DEFAULT_INSTALL_MODEL}"
    command -v curl >/dev/null 2>&1 || die "need curl to install"
    command -v tar  >/dev/null 2>&1 || die "need tar to install"
    if [ -x "$OLLAMA_BIN" ]; then
        info "ollama already present: $("$OLLAMA_BIN" --version 2>&1 | head -1)"
    else
        info "installing ollama (user-space, no sudo) -> $HOME/.local/ollama …"
        mkdir -p "$HOME/.local/ollama"
        curl -fL --retry 3 -o "/tmp/ollama-$$.tgz" "$OLLAMA_TGZ_URL" || die "download failed: $OLLAMA_TGZ_URL"
        tar -xf "/tmp/ollama-$$.tgz" -I zstd -C "$HOME/.local/ollama" || { rm -f "/tmp/ollama-$$.tgz"; die "extract failed"; }
        rm -f "/tmp/ollama-$$.tgz"
        [ -x "$OLLAMA_BIN" ] || die "install finished but no binary at $OLLAMA_BIN"
        info "installed: $("$OLLAMA_BIN" --version 2>&1 | head -1)"
    fi
    ensure_server
    info "pulling model '$model' (first pull can take a few minutes)…"
    "$OLLAMA_BIN" pull "$model" || die "model pull failed: $model"
    info "verifying inference…"
    local out; out="$(printf 'Reply with exactly the two letters: OK' | "$0" --model "$model" 2>/dev/null)"
    [ -n "$out" ] || die "model pulled but inference returned nothing — check /tmp/ollama-serve.log"
    info "model replied: ${out:0:60}"
    info "LOCAL MIND READY on $(hostname) — model '$model'. Geo-block-immune inference is live."
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[done] mesh-local-mind: ollama + $model installed on $(hostname) — geo-block-immune local inference LIVE" >/dev/null 2>&1 || true
}

# doctor-friendly smoke: PASSES if the tool's own prerequisites exist (so an un-installed node is
# not a false FAIL); reports ollama state informationally.
smoke_test() {
    for x in curl python3 tar; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; return 1; }; done
    # THREE honest states: absent / installed-but-no-usable-model / ready. "installed" alone misleads —
    # inference fails with no model. AUTHORITATIVE check is api/tags (a partial/interrupted pull leaves
    # a manifest + blobs but NO usable model — the ds case, 2026-06-12: qwen2.5:3b manifest + 1.8G blobs
    # yet api/tags=NONE). Querying a running server is read-only (no binary exec); only fall back to the
    # manifest dir when the server is down (best-effort, explicitly unverified).
    local mdir="${OLLAMA_MODELS:-$HOME/.ollama/models/manifests}" n
    if [ ! -x "$OLLAMA_BIN" ]; then
        echo "smoke-test: ok (tool ready; ollama not installed — run: mesh-local-mind --install)"
    elif server_up; then
        n=$(curl -sf "$OLLAMA_URL/api/tags" 2>/dev/null | python3 -c "import json,sys;print(len(json.load(sys.stdin).get('models',[])))" 2>/dev/null || echo 0)
        if [ "${n:-0}" -gt 0 ]; then echo "smoke-test: ok (ollama serving, ${n} model(s) ready)"
        else echo "smoke-test: ok (ollama serving but NO usable model — run: $OLLAMA_BIN pull qwen2.5:3b)"; fi
    elif [ -d "$mdir" ] && [ -n "$(ls -A "$mdir" 2>/dev/null)" ]; then
        echo "smoke-test: ok (ollama installed, a model manifest exists but server is DOWN — verify: $OLLAMA_BIN list)"
    else
        echo "smoke-test: ok (ollama installed but NO model — run: $OLLAMA_BIN pull qwen2.5:3b)"
    fi
    nothink_gate || return 1
    return 0
}

# no-think contract gate: drive the REAL tool end-to-end at a recording stub server (no ollama
# needed — runs on every node) and assert the payload the tool actually sends. Three legs:
# --no-think → "think": false present · unflagged → NO think key (legacy payload untouched) ·
# MESH_LOCAL_MIND_THINK=false env → same as the flag. Payloads parsed as JSON, never grepped.
nothink_gate() {
    local td rec port pid out leg
    td="$(mktemp -d)" || { echo "smoke-test: FAIL (no-think: mktemp)"; return 1; }
    rec="$td/payloads"
    python3 - "$rec" >"$td/port" 2>/dev/null <<'PYEOF' &
import json, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
rec = sys.argv[1]
class H(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200); self.send_header('Content-Type','application/json'); self.end_headers()
        self.wfile.write(json.dumps({'models':[{'name':'stub:1b'}]}).encode())
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get('Content-Length', 0)))
        with open(rec, 'ab') as f: f.write(body + b'\n')
        self.send_response(200); self.send_header('Content-Type','application/json'); self.end_headers()
        self.wfile.write(json.dumps({'response':'stub-ok'}).encode())
    def log_message(self, *a): pass
srv = HTTPServer(('127.0.0.1', 0), H)
print(srv.server_address[1], flush=True)
srv.serve_forever()
PYEOF
    pid=$!
    local waited=0
    while [ ! -s "$td/port" ] && [ "$waited" -lt 50 ]; do sleep 0.1; waited=$((waited+1)); done
    port="$(cat "$td/port" 2>/dev/null)"
    [ -n "$port" ] || { kill "$pid" 2>/dev/null; rm -rf "$td"; echo "smoke-test: FAIL (no-think: stub server did not start)"; return 1; }

    _leg() { # $1=leg-name $2=expected-think(json: false|absent) then argv... ; env prepared by caller
        local name="$1" want="$2"; shift 2
        : >"$rec"
        out="$(env -u MESH_LOCAL_MIND_MODEL -u MESH_LOCAL_MIND_THINK OLLAMA_URL="http://127.0.0.1:$port" "$@" 2>/dev/null)"
        [ "$out" = "stub-ok" ] || { echo "smoke-test: FAIL (no-think/$name: expected stub-ok, got '$out')"; return 1; }
        python3 - "$rec" "$want" <<'PYEOF2' 2>"$td/assert-err" || { echo "smoke-test: FAIL (no-think/$name: $(tail -1 "$td/assert-err"))"; return 1; }
import json, sys
lines = [l for l in open(sys.argv[1], 'rb').read().split(b'\n') if l.strip()]
assert len(lines) == 1, f"expected 1 payload, got {len(lines)}"
d = json.loads(lines[0])
assert d.get('model') == 'stub:1b', f"model: {d.get('model')!r}"
assert d.get('prompt') == 'ping', f"prompt: {d.get('prompt')!r}"
want = sys.argv[2]
if want == 'false':
    assert d.get('think') is False and 'think' in d, f"think: {d.get('think')!r}"
else:
    assert 'think' not in d, f"think key present: {d.get('think')!r}"
PYEOF2
    }
    local rc=0
    _leg flag   false  "$0" --no-think --model stub:1b 'ping'            || rc=1
    [ "$rc" -eq 0 ] && { _leg legacy absent "$0" --model stub:1b 'ping'  || rc=1; }
    [ "$rc" -eq 0 ] && { _leg env    false  env MESH_LOCAL_MIND_THINK=false "$0" --model stub:1b 'ping' || rc=1; }
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    rm -rf "$td"
    [ "$rc" -eq 0 ] && echo "smoke-test: ok (no-think contract: flag/env set think:false, legacy payload untouched)"
    return "$rc"
}

# --- argument parsing ---
MODEL_ARG=""
# think suppression: "false" → payload carries "think": false (a thinking-family model answers
# directly instead of overflowing num_ctx with reasoning — the qwen3.5 empty-.response trap);
# unset/anything-else → the key is ABSENT and the payload is byte-identical to the legacy one.
# ollama 0.32 accepts think:false on non-thinking models too (probed live 2026-07-21), so the
# flag is safe regardless of which model pick_model lands on.
THINK_MODE="${MESH_LOCAL_MIND_THINK:-}"
case "${1:-}" in
    --list)    list_models; exit 0 ;;
    --install) install_ollama "${2:-}"; exit $? ;;
    --test)    smoke_test; exit $? ;;
esac
while [ $# -gt 0 ]; do
    case "$1" in
        --model)    [ $# -ge 2 ] || die "--model needs a value"; MODEL_ARG="$2"; shift 2 ;;
        --no-think) THINK_MODE="false"; shift ;;
        *) break ;;
    esac
done

# prompt: positional arg or stdin
if [ $# -gt 0 ]; then
    PROMPT="$*"
elif [ ! -t 0 ]; then
    PROMPT="$(cat)"
else
    die "usage: mesh-local-mind '<prompt>'  (or pipe prompt via stdin)"
fi

[ -z "${PROMPT// /}" ] && die "empty prompt"

# --- infer ---
# ONE payload builder for BOTH transports (HTTP + SSH) — the think rule asserted here is asserted
# everywhere (a rule asserted at one call site is not asserted).
build_payload() { # $1=model $2=prompt → request JSON on stdout, honoring THINK_MODE
    python3 -c "
import json, sys
d = {'model': sys.argv[1], 'prompt': sys.argv[2], 'stream': False}
if sys.argv[3] == 'false':
    d['think'] = False
print(json.dumps(d))
" "$1" "$2" "${THINK_MODE:-}"
}

ensure_server

# SSH transport: reach the remote mind's LOCALHOST ollama API over authenticated SSH (the API is
# bound to the remote's 127.0.0.1 — no external exposure, no gate). Clean JSON, no terminal codes.
# pick_model can't query the down-local here, so use the explicit/env/default model.
if [ -n "$SSH_MIND_PEER" ]; then
    MODEL="${MODEL_ARG:-${DEFAULT_MODEL:-qwen2.5:3b}}"
    req="$(build_payload "$MODEL" "$PROMPT")"
    resp="$(printf '%s' "$req" | ssh -o BatchMode=yes -o ConnectTimeout=8 "$SSH_MIND_PEER" 'curl -sf -m 120 http://localhost:11434/api/generate -d @-' 2>/dev/null)" \
        || die "SSH inference to the shared mind ($SSH_MIND_PEER) failed"
    printf '%s' "$resp" | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin).get('response', ''), end='')
except Exception as e:
    print('mesh-local-mind: bad response via SSH:', e, file=sys.stderr); sys.exit(1)"
    exit 0
fi

MODEL="$(pick_model "$MODEL_ARG")"
if [ -z "$MODEL" ]; then
    die "no models available — pull one first: $OLLAMA_BIN pull qwen2.5:3b"
fi

RESPONSE="$(curl -sf -X POST "$OLLAMA_URL/api/generate" \
    -H 'Content-Type: application/json' \
    -d "$(build_payload "$MODEL" "$PROMPT")" 2>/dev/null)" || die "API call failed — is ollama running?"

python3 -c "
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except json.JSONDecodeError:
    print(raw, end=''); sys.exit(0)
resp = d.get('response', '')
if not resp and 'error' in d:
    print('mesh-local-mind error:', d['error'], file=sys.stderr); sys.exit(1)
print(resp, end='')
" <<< "$RESPONSE"
