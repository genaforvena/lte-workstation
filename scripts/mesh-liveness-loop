#!/usr/bin/env bash
# mesh-liveness-loop — the LIVENESS supervisor as ONE always-on LOOP (operator 2026-06-21, plan A:
# "хочу избавиться от кронов вообще … нужен реально замкнутый круг"). Folds the ~9 liveness CRONS into a
# single persistent process: nothing schedules them from crontab; the loop keeps the node alive, and the
# loop itself is kept alive by a systemd user service (Restart=always + linger → reboot-survivable). A
# supervised loop, not a schedule.
#
# Honest tradeoff (stated to the operator): collapsing 9 INDEPENDENT crons into one loop is a SPOF — a
# crashed cron entry used to fail in isolation. Mitigation: systemd Restart=always revives a dead loop, and
# a heartbeat file (.liveness-loop.heartbeat, touched every tick) makes a STALLED loop detectable.
#
# It does NOT reimplement the liveness tools — it ORCHESTRATES the existing ones on their own cadence, and
# additionally keeps the consume drivers (the mind-side closed loop) alive + kicks freshly-(re)spawned minds
# to read their pane immediately (operator's CRITICAL spawn-moment rule).
#
#   mesh-liveness-loop           run the supervisor loop (foreground; systemd owns it)
#   mesh-liveness-loop --once    run ONE due-pass then exit (test / manual tick)
#   mesh-liveness-loop --test    smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
MESH="$HOME/.mesh"
LOG="$MESH/liveness-loop.log"
HB="$MESH/.liveness-loop.heartbeat"
STATE="$MESH/.liveness-loop.state"   # "name=lastepoch" lines
BASE="${MESH_LIVENESS_TICK:-30}"     # loop tick seconds
ts(){ date -u +%FT%TZ; }
now(){ date +%s; }

# task table: "name|cadence_sec|command". The cadences mirror the retired cron periods; the load-bearing
# ones are session-revival (restore) + mind-relaunch (channel-keepalive) + consume-driver supervision.
# consume-ensure makes the mind-side closed loop durable WITHOUT cron (the drivers were bare bg processes).
TASKS=(
  "consume-ensure|60|mesh-consume-all"
  "loop-baton-ensure|60|mesh-loop-baton --ensure"
  "channel-keepalive|240|mesh-channel-keepalive"
  "restore|300|mesh-restore"
  "supervise|120|mesh-supervise"
  "session-watchdog|600|mesh-session-watchdog --edge"
  "organ-keepalive|600|mesh-organ-keepalive"
  "failover-scan|120|mesh-failover --scan"
  "failover-dead|300|mesh-failover --scan-dead"
  "node-care|300|mesh-node-care"
  "mind-state|600|mesh-mind-state --watch"
  "pane-watch|300|mesh-pane-watch"
  "scheduler-audit|600|mesh-liveness-loop --audit-cron"
  "watchdog-ground|600|mesh-liveness-loop --audit-watchdog"
)

# relaunch_signal — stdin = a keepalive/restore pass's output → 0 iff a mind was GENUINELY (re)launched.
# Matches only the producers' STRUCTURED positive markers, never loose prose: the old case-insensitive
# substring scan (relaunch|launch|respawn|started|reincarnat) matched mesh-restore's routine
# "mesh-pull: resume: 0 relaunched" — a ZERO-count nothing-happened line — on EVERY 300s pass, so the
# spawn-moment kick fired ~190×/day and mesh-consume-all --kick woke every idle mind unconditionally
# (~1848 kicks/24h, the single largest wake source on the node; found 2026-07-23 investigating
# "minds spammed with reflexive wakes"). Substring-scan-turns-prose-into-a-verdict, the log-grep twin.
# Positive markers (each seen in its producer's source):
#   [mind-relaunched]                keepalive's relaunch line (single + burst-coalesced forms)
#   was DEAD → relaunch attempted    keepalive's per-channel relaunch narration
#   resume: <N≥1> relaunched         mesh-pull's resume line with a NON-ZERO count
relaunch_signal(){ grep -qE '\[mind-relaunched\]|was DEAD → relaunch|resume: [1-9][0-9]* relaunched'; }

last_run(){ grep -E "^$1=" "$STATE" 2>/dev/null | tail -1 | cut -d= -f2; }
set_run(){ # name epoch
  local tmp="$STATE.tmp"; { grep -vE "^$1=" "$STATE" 2>/dev/null; echo "$1=$2"; } > "$tmp" && mv "$tmp" "$STATE"; }

run_due(){ # run every task whose cadence elapsed; track mind-relaunch to fire the spawn-moment kick
  local n="$(now)" relaunched=0
  for t in "${TASKS[@]}"; do
    # NB: separate statements — `local a=.. b=$a` expands $a BEFORE the local takes effect (set -u → unbound)
    local name rest cad cmd lr
    name="${t%%|*}"; rest="${t#*|}"; cad="${rest%%|*}"; cmd="${rest#*|}"
    lr="$(last_run "$name")"; lr="${lr:-0}"
    [ $((n - lr)) -ge "$cad" ] || continue
    # 110s hard cap so one hung tool can't freeze the whole liveness loop.
    # Capture via a temp FILE, never $(...): a task that launches a persistent background child (mesh-restore
    # → mesh-snapshot/selfcare --loop) leaks the command-substitution PIPE's write end to that child, so $(...)
    # blocks on pipe-EOF FOREVER even after timeout kills the foreground — wedging the ENTIRE liveness loop
    # (root-caused 2026-06-25: PID stuck in anon_pipe_read 5h, supervise/consume/keepalive all silently dead).
    # A file has no reader waiting on EOF; surviving children write harmlessly. timeout -k makes the kill land
    # on a task that ignores SIGTERM (the wedged mesh-restore was wait-blocked, never reaped by plain timeout).
    local out rc tf; tf="$(mktemp "${TMPDIR:-/tmp}/liveloop-$name.XXXXXX" 2>/dev/null || echo "/tmp/liveloop-$name.$$")"
    timeout -k 10 110 bash -lc "$cmd" >"$tf" 2>&1 </dev/null; rc=$?
    out="$(cat "$tf" 2>/dev/null)"; rm -f "$tf"
    set_run "$name" "$n"
    [ "$rc" = 0 ] || echo "$(ts) $name rc=$rc: ${out##*$'\n'}" >> "$LOG"
    # channel-keepalive / restore (re)launch minds → a fresh mind must IMMEDIATELY read its pane
    case "$name" in channel-keepalive|restore) printf '%s' "$out" | relaunch_signal && relaunched=1 ;; esac
  done
  [ "$relaunched" = 1 ] && { mesh-consume-all --kick >/dev/null 2>&1; echo "$(ts) spawn-moment KICK (mind (re)launched)" >> "$LOG"; }
}

# ── SYSTEM 3* — THE INDEPENDENT AUDIT OF THE OTHER SCHEDULER (Beer VSM) ──────────────────────────
# LITERATURE (live review 2026-07-30, second-order cybernetics — angle: cross-domain transfer to a
# distributed sensor mesh). Stafford Beer's Viable System Model gives System 3 TWO paths to System 1's
# health: the routine vertical reporting line, AND System 3* — a SPORADIC, out-of-band AUDIT that
# samples ground truth by a channel INDEPENDENT of the report, "to ensure that System 1 management is
# not, either by accident or by design, pulling the wool over their eyes" (businessballs.com VSM
# primer; the IEEE ETHW VSM note, ethw.org). Its defining properties are independence-from-the-
# reporting-line and APERIODIC timing — a live 2026 sharpening proves a PREDICTABLE audit is
# gameable/blind: "Gaming the Metric, Not the Harm: Certifying Safety Audits against Strategic Platform
# Manipulation" (arXiv:2605.06324) and "A Benchmark for Strategic Auditee Gaming Under Continuous
# Compliance Monitoring" (arXiv:2605.06340).
#
# WHERE IT BITES — the mesh runs TWO schedulers: cron (reflexes.cron, ~200 reflexes) and THIS loop
# (systemd, Restart=always, cron-INDEPENDENT). The reflex watchdog that would notice cron dying —
# mesh-reflex-health — is ITSELF a cron reflex (*/10), so when cron dies the watchdog dies WITH it:
# the single common-mode failure that stales EVERY cron reflex at once produces SILENCE, not an alarm.
# (mesh-reflex-health's own SELF-GROUNDING block names this open gap: "an INDEPENDENT tool grounding
# our freshness from OUTSIDE this loop is the proposed next step.") This loop IS that outside — it
# keeps running when cron is dead — so Beer's 3* audit belongs HERE: auditing the OTHER scheduler is
# the one liveness fact the cron side structurally cannot establish for itself.
#
# The independent signal is the journal's PAM cron-session lines — authored by cron/PAM, NOT by any
# reflex's self-report. Healthy: a node with ~200 crontab entries (many */2–*/15) logs THOUSANDS of
# cron:session lines per window (2013 in 30m, measured on mesh-home). Cron dead: ZERO — a crisp,
# calibration-free threshold (a live cron with that crontab cannot log zero sessions in 15m; no
# per-node rate model needed, so nothing to rot). HONEST n/a: if `journalctl -t CRON` is not readable
# at all (no journal access, or a node whose cron logs only to syslog), we CANNOT audit → stay silent
# (never a faked all-clear). A readability PROBE separates "channel unavailable" (unauditable) from
# "channel says zero" (scheduler dead) — the discarded-exit-code-renders-n/a-as-a-blank-row trap.
# Edge-triggered (alarm the death AND its resolution; no re-log every pass). Report-only: it posts a
# root-cause board line, it does not restart cron (substrate = single-writer, the mind's own hands).
CRON_AUDIT_WINDOW_S="${MESH_CRON_AUDIT_WINDOW_S:-900}"
CRON_AUDIT_STATE="$MESH/.cron-audit.state"
cron_sessions_in_window(){ # <now-epoch> → count of cron:session lines in the window, or "n/a" if the channel is unreadable
  local n="$1" since probe
  if [ -n "${MESH_CRON_JOURNAL:-}" ]; then            # test-only: a fixture stands in for the journal channel
    [ -r "$MESH_CRON_JOURNAL" ] || { echo "n/a"; return; }   # missing fixture = channel unavailable (mirrors the real readability probe)
    grep -c 'cron:session' "$MESH_CRON_JOURNAL" 2>/dev/null; return   # grep -c prints 0 on no-match (exit 1 ignored — no `|| echo 0`, which would double it)
  fi
  # readability probe: is the CRON journal facility populated AT ALL? empty ⇒ unauditable here (n/a),
  # NOT proof of silence — a node whose cron logs to syslog-only would else false-alarm every pass.
  probe="$(journalctl -t CRON -n1 -o cat --no-pager 2>/dev/null)"
  [ -n "$probe" ] || { echo "n/a"; return; }
  since="$(date -d "@$(( n - CRON_AUDIT_WINDOW_S ))" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" || { echo "n/a"; return; }
  journalctl -t CRON --since "$since" -o cat --no-pager 2>/dev/null | grep -c 'cron:session'
}
cron_audit(){ # edge-triggered: [scheduler-dead] when the INDEPENDENT audit shows cron silent, [scheduler-ok] on recovery
  local n s prev
  n="$(now)"; s="$(cron_sessions_in_window "$n")"
  [ "$s" = "n/a" ] && return 0                        # unauditable on this node → silent (honest n/a, no faked all-clear)
  [ "$s" -eq "$s" ] 2>/dev/null || return 0           # torn read → skip this pass
  prev="$(cat "$CRON_AUDIT_STATE" 2>/dev/null || echo OK)"
  if [ "$s" -eq 0 ]; then
    echo DEAD > "$CRON_AUDIT_STATE"
    [ "$prev" != DEAD ] && [ -z "${MESH_AUDIT_NOPOST:-}" ] && command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="liveness-loop@$(hostname)" mesh-chat "[scheduler-dead] the INDEPENDENT cron-session audit (journal, cron/PAM-authored — not any reflex's self-report) shows ZERO cron sessions in ${CRON_AUDIT_WINDOW_S}s, while cron should be firing ~200 reflexes. The cron scheduler is DOWN — and mesh-reflex-health cannot report it (it is itself a cron reflex, dead with cron). Beer's VSM System 3* independent audit: check cron / reflexes.cron / systemd-cron, NOT the reflexes. (arXiv:2605.06324)" >/dev/null 2>&1
  else
    echo OK > "$CRON_AUDIT_STATE"
    [ "$prev" = DEAD ] && [ -z "${MESH_AUDIT_NOPOST:-}" ] && command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="liveness-loop@$(hostname)" mesh-chat "[scheduler-ok] cron recovered — the independent audit sees $s cron session(s) again in ${CRON_AUDIT_WINDOW_S}s." >/dev/null 2>&1
  fi
  return 0
}

# ── WELL-FOUNDEDNESS OF THE META-OBSERVATION LATTICE: GROUND THE TOP WATCHDOG ──
# LITERATURE (second-order cybernetics — von Foerster/Pask/Beer — from the angle of a KNOWN CRITIQUE of
# the area, 2026-08-04, genome mind). LIVE source: Elshatlawy H, Rickles D, Arsiwalla XD, "Towards a
# Generalized Theory of Observers", arXiv:2504.16225 (submitted 2025-04-22, v3 revised 2026-01-07;
# appears as a chapter in *Quantum Gravity and Computation*). Retrieved from arXiv and read directly.
#
# THE CRITIQUE it addresses head-on is the oldest one aimed at second-order cybernetics: §4.10.5.2
# "Infinite regress in self-reference" — "Second-order or multi-layer observers can appear to regress
# infinitely: who observes the observer's observer, etc.?" Its proposed remedy is HIERARCHICAL
# ENCAPSULATION, and it is stated as a testable structural CONDITION, not a slogan: "each observer only
# references or modifies a finite subset of its own states. Formally, we FORBID CYCLES OF OBSERVATION
# THAT DO NOT CONVERGE OR YIELD STABLE REFERENCES. This ensures a WELL-FOUNDED PARTIAL ORDER in the
# lattice of meta-observation relations." So: a self-observing system is only coherent if every
# observation chain TERMINATES at a ground outside the chain. That is a property you can check.
#
# WHERE THE MESH IS NOT WELL-FOUNDED. The reflex-liveness lattice runs
#   ~200 cron reflexes  ←observed by←  mesh-reflex-health (itself a */10 CRON reflex)
#   cron (the scheduler) ←observed by←  THIS loop's --audit-cron (systemd = external ground)
# The 2026-07-30 System 3* landing closed the CRON edge. It did NOT close the one above it: nothing
# observes mesh-reflex-health's OWN per-run artifact. The chain "reflex-health ← cron ← liveness-loop ←
# systemd" LOOKS grounded, but its first edge is FALSE AS A LIVENESS ASSERTION — cron being alive does
# not assert that reflex-health RAN. Concretely: if cron is healthy but reflex-health itself dies (crash,
# PATH break, a dependency raising every pass), the cron-session audit still sees thousands of sessions
# and posts [scheduler-ok], while the TOP watchdog of ~200 reflexes goes silent and every reflex under it
# becomes unobserved. That is exactly the non-convergent chain the paper forbids — a top observer whose
# own state is referenced by nothing outside its own loop. mesh-reflex-health's own SELF-GROUNDING block
# (:15-23) names this as its open next step: "an INDEPENDENT tool grounding our own .reflex-health-state
# freshness from OUTSIDE this loop — a dead reflex-health can't check itself". This closes it.
# DISTINCT from --audit-cron above (that grounds the SCHEDULER; this grounds the WATCHDOG — a live cron
# with a dead watchdog is precisely the case --audit-cron reads as green), and from reflex-health's own
# scan (which cannot include itself: a dead reflex files no complaint — Elshatlawy's cycle of length 1).
#
# HONESTY PROPERTIES (each has a --test leg):
#  · MAX-AGE IS DERIVED from the LIVE cron stride of mesh-reflex-health × WATCHDOG_MULT — never a literal
#    (a constant outlives its reader; reflex-health derives its own thresholds the same way). Not
#    schedulable / unparseable stride → honest n/a, silent: an unwired watchdog is not a stale one.
#  · CRON-DEATH DEFERRAL: if the independent cron audit sees ZERO sessions, a stale reflex-health is a
#    DOWNSTREAM SYMPTOM — [scheduler-dead] owns that fault, so we neither post nor flip state. Only "cron
#    alive AND the watchdog's artifact stale" is this signal's own case.
#  · A MISSING artifact is only a fault once THIS loop has been up longer than the max-age (own heartbeat
#    mtime) — otherwise a freshly planted node would alarm before reflex-health's first run.
#  · Edge-triggered, report-only: it posts [watchdog-dead]/[watchdog-ok]; it does not restart anything.
WATCHDOG_GROUND_STATE="$MESH/.watchdog-ground.state"
WATCHDOG_ARTIFACT="${MESH_WATCHDOG_ARTIFACT:-$MESH/.reflex-health-state}"
WATCHDOG_MULT="${MESH_WATCHDOG_MULT:-3}"          # max-age = live cron stride × this
watchdog_stride_s(){ # → seconds between scheduled mesh-reflex-health runs, or "n/a" if not derivable
  local src line f
  if [ -n "${MESH_WATCHDOG_STRIDE_S:-}" ]; then echo "$MESH_WATCHDOG_STRIDE_S"; return; fi
  if [ -n "${MESH_WATCHDOG_CRON:-}" ]; then
    [ -r "$MESH_WATCHDOG_CRON" ] || { echo "n/a"; return; }
    src="$(cat "$MESH_WATCHDOG_CRON" 2>/dev/null)"
  else
    src="$(crontab -l 2>/dev/null)"
    [ -n "$src" ] || src="$(cat "$MESH/reflexes.cron" 2>/dev/null)"
  fi
  # the LIVE cron line is the single source of truth for the cadence (same rule reflex-health uses on
  # its own watch table) — never a duplicated literal here.
  line="$(printf '%s\n' "$src" | grep -v '^[[:space:]]*#' | grep 'mesh-reflex-health' | head -1)"
  [ -n "$line" ] || { echo "n/a"; return; }        # not scheduled → nothing to ground (honest n/a)
  f="$(printf '%s\n' "$line" | awk '{print $1}')"
  case "$f" in
    '*')     echo 60 ;;                             # every minute
    '*/'[0-9]*) echo $(( ${f#*/} * 60 )) ;;
    *)       echo "n/a" ;;                          # a cadence we cannot parse → n/a, never a guess
  esac
}
watchdog_ground(){ # edge-triggered: [watchdog-dead] when the TOP reflex watchdog's own artifact goes stale
  local n stride maxage age prev sessions hbage
  n="$(now)"
  stride="$(watchdog_stride_s)"
  [ "$stride" = "n/a" ] && return 0                                  # unschedulable/underivable → silent
  [ "$stride" -eq "$stride" ] 2>/dev/null || return 0                # torn read → skip this pass
  maxage=$(( stride * WATCHDOG_MULT ))
  # CRON-DEATH DEFERRAL: a dead scheduler stales EVERY reflex incl. this one; [scheduler-dead] owns it.
  sessions="$(cron_sessions_in_window "$n")"
  if [ "$sessions" != "n/a" ] && [ "$sessions" -eq 0 ] 2>/dev/null; then return 0; fi
  if [ -e "$WATCHDOG_ARTIFACT" ]; then
    age=$(( n - $(stat -c %Y "$WATCHDOG_ARTIFACT" 2>/dev/null || echo "$n") ))
  else
    # absent artifact: only a fault once THIS loop has been up longer than the max-age, else a freshly
    # planted node would alarm before reflex-health's first scheduled run.
    hbage=$(( n - $(stat -c %Y "$HB" 2>/dev/null || echo "$n") ))
    [ "$hbage" -ge "$maxage" ] 2>/dev/null || return 0
    age=$(( maxage + 1 ))
  fi
  prev="$(cat "$WATCHDOG_GROUND_STATE" 2>/dev/null || echo OK)"
  if [ "$age" -gt "$maxage" ]; then
    echo DEAD > "$WATCHDOG_GROUND_STATE"
    [ "$prev" != DEAD ] && [ -z "${MESH_AUDIT_NOPOST:-}" ] && command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="liveness-loop@$(hostname)" mesh-chat "[watchdog-dead] the TOP reflex watchdog is silent: mesh-reflex-health's own per-run artifact ($(basename "$WATCHDOG_ARTIFACT")) is ${age}s old vs max-age ${maxage}s (live cron stride ${stride}s ×${WATCHDOG_MULT}) — while cron is ALIVE (${sessions} session(s) in the audit window), so this is NOT [scheduler-dead]. The watchdog of ~200 reflexes died on its own; every reflex under it is now unobserved and nothing inside the cron lattice can say so. Grounded from OUTSIDE by this systemd loop — the well-founded-partial-order condition on the meta-observation lattice (Elshatlawy/Rickles/Arsiwalla, arXiv:2504.16225 §4.10.5.2). Check mesh-reflex-health by hand." >/dev/null 2>&1
  else
    echo OK > "$WATCHDOG_GROUND_STATE"
    [ "$prev" = DEAD ] && [ -z "${MESH_AUDIT_NOPOST:-}" ] && command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="liveness-loop@$(hostname)" mesh-chat "[watchdog-ok] mesh-reflex-health recovered — the top reflex watchdog's own artifact is fresh again (${age}s < ${maxage}s)." >/dev/null 2>&1
  fi
  return 0
}

if [ "${1:-}" = --test ]; then
  command -v mesh-consume-all >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-consume-all missing)"; exit 1; }
  command -v mesh-channel-keepalive >/dev/null 2>&1 || { echo "smoke-test: FAIL (channel-keepalive missing)"; exit 1; }
  # every task command's tool must exist on PATH
  for t in "${TASKS[@]}"; do c="${t##*|}"; b="${c%% *}"; command -v "$b" >/dev/null 2>&1 || { echo "smoke-test: FAIL (task tool '$b' missing)"; exit 1; }; done
  # state read/write round-trips
  set_run __selftest 123 && [ "$(last_run __selftest)" = 123 ] || { echo "smoke-test: FAIL (state rw)"; exit 1; }
  { grep -vE '^__selftest=' "$STATE" 2>/dev/null || true; } > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
  # relaunch_signal: the ROUTINE nothing-happened passes must NOT read as a relaunch (the 190-kicks/day
  # bug: "resume: 0 relaunched" on every restore pass), while every genuine marker still must.
  printf 'mesh-pull: resume: 0 relaunched\nUNIFORM session ensured (15-channel set)\n' | relaunch_signal \
    && { echo "smoke-test: FAIL (relaunch_signal: a ZERO-count 'resume: 0 relaunched' routine pass must not fire the spawn kick)"; exit 1; }
  printf '%s\n' "channel-keepalive pass done" | relaunch_signal \
    && { echo "smoke-test: FAIL (relaunch_signal: a clean keepalive pass must not fire the spawn kick)"; exit 1; }
  printf '%s\n' "[mind-relaunched] channel-keepalive: relaunched mesh-home:genome.1 (claude)" | relaunch_signal \
    || { echo "smoke-test: FAIL (relaunch_signal: keepalive's [mind-relaunched] marker must fire the kick)"; exit 1; }
  printf '%s\n' "  genome: was DEAD → relaunch attempted (claude)" | relaunch_signal \
    || { echo "smoke-test: FAIL (relaunch_signal: keepalive's was-DEAD relaunch line must fire the kick)"; exit 1; }
  printf '%s\n' "mesh-pull: resume: 2 relaunched" | relaunch_signal \
    || { echo "smoke-test: FAIL (relaunch_signal: a NON-ZERO resume count must fire the kick)"; exit 1; }
  # SYSTEM 3* CRON-AUDIT asserts (LITERATURE 2026-07-30, VSM System 3* independent audit — see the block
  # above). The audit must COUNT cron-session lines from the INDEPENDENT journal channel (fixture) and
  # read ZERO as scheduler-dead; a populated channel recovers to OK. Posting is suppressed (MESH_AUDIT_
  # NOPOST) so the --test never writes the real board (a test that forges the artifact a reader reads).
  _cj="$(mktemp)"
  printf 'pam_unix(cron:session): session opened for user mesh-home\npam_unix(cron:session): session closed for user mesh-home\n' > "$_cj"
  [ "$(MESH_CRON_JOURNAL="$_cj" cron_sessions_in_window "$(now)")" = 2 ] \
    || { echo "smoke-test: FAIL (cron_sessions_in_window: must count 2 cron:session lines in the fixture, got $(MESH_CRON_JOURNAL="$_cj" cron_sessions_in_window "$(now)"))"; exit 1; }
  : > "$_cj"
  [ "$(MESH_CRON_JOURNAL="$_cj" cron_sessions_in_window "$(now)")" = 0 ] \
    || { echo "smoke-test: FAIL (cron_sessions_in_window: an empty INDEPENDENT channel must count 0 = scheduler silent)"; exit 1; }
  # edge: a zero count must flip the audit state to DEAD (RED-first — delete the `s -eq 0` branch and this fails)
  _cas="$(mktemp)"
  CRON_AUDIT_STATE="$_cas" MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 cron_audit
  [ "$(cat "$_cas" 2>/dev/null)" = DEAD ] || { echo "smoke-test: FAIL (cron_audit: zero INDEPENDENT sessions must set state DEAD, got '$(cat "$_cas" 2>/dev/null)')"; exit 1; }
  printf 'pam_unix(cron:session): session opened for user mesh-home\n' > "$_cj"
  CRON_AUDIT_STATE="$_cas" MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 cron_audit
  [ "$(cat "$_cas" 2>/dev/null)" = OK ] || { echo "smoke-test: FAIL (cron_audit: sessions present must recover state to OK, got '$(cat "$_cas" 2>/dev/null)')"; exit 1; }
  # honest n/a: an unreadable channel (n/a) must NEVER flip a healthy state to DEAD (no faked all-clear
  # AND no false alarm) — seed OK, force n/a, assert OK held.
  echo OK > "$_cas"
  CRON_AUDIT_STATE="$_cas" MESH_CRON_JOURNAL="/nonexistent/no-such-journal-$$" MESH_AUDIT_NOPOST=1 cron_audit
  [ "$(cat "$_cas" 2>/dev/null)" = OK ] || { echo "smoke-test: FAIL (cron_audit: an unreadable channel must NOT change state — honest n/a, got '$(cat "$_cas" 2>/dev/null)')"; exit 1; }
  # WELL-FOUNDED META-OBSERVATION / WATCHDOG GROUNDING (LITERATURE 2026-08-04, Elshatlawy/Rickles/
  # Arsiwalla arXiv:2504.16225 §4.10.5.2 — see the block above). Every leg drives the REAL
  # watchdog_ground; only the artifact, the cron source and the state file are injected. Posting is
  # suppressed so the test never writes the real board.
  _wa="$(mktemp)"; _ws="$(mktemp)"; _wc="$(mktemp)"
  printf '*/10 * * * * . $HOME/.mesh/restore.env; mesh-reflex-health\n' > "$_wc"
  # (1) the max-age is DERIVED from the live cron stride, never a literal
  [ "$(MESH_WATCHDOG_CRON="$_wc" watchdog_stride_s)" = 600 ] \
    || { echo "smoke-test: FAIL (watchdog_stride_s: a */10 live cron line must derive 600s, got '$(MESH_WATCHDOG_CRON="$_wc" watchdog_stride_s)')"; rm -f "$_wa" "$_ws" "$_wc"; exit 1; }
  # (2) NOT SCHEDULED → honest n/a (an unwired watchdog is not a stale one) — and the audit stays silent
  : > "$_wc.empty"
  [ "$(MESH_WATCHDOG_CRON="$_wc.empty" watchdog_stride_s)" = "n/a" ] \
    || { echo "smoke-test: FAIL (watchdog_stride_s: no mesh-reflex-health cron line must be n/a, not a guessed default)"; rm -f "$_wa" "$_ws" "$_wc" "$_wc.empty"; exit 1; }
  echo OK > "$_ws"
  WATCHDOG_GROUND_STATE="$_ws" MESH_WATCHDOG_CRON="$_wc.empty" WATCHDOG_ARTIFACT="$_wa" \
    MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 watchdog_ground
  [ "$(cat "$_ws")" = OK ] || { echo "smoke-test: FAIL (watchdog_ground: an UNSCHEDULED watchdog must not flip state — honest n/a)"; rm -f "$_wa" "$_ws" "$_wc" "$_wc.empty"; exit 1; }
  # (3) STALE artifact while CRON IS ALIVE = this signal's own case → DEAD (RED-first: drop the age>maxage
  #     comparison and this leg fails; that is the whole point of the axis).
  printf 'pam_unix(cron:session): session opened for user mesh-home\n' > "$_cj"
  touch -d "@$(( $(now) - 5000 ))" "$_wa"
  echo OK > "$_ws"
  WATCHDOG_GROUND_STATE="$_ws" MESH_WATCHDOG_CRON="$_wc" WATCHDOG_ARTIFACT="$_wa" \
    MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 watchdog_ground
  [ "$(cat "$_ws")" = DEAD ] || { echo "smoke-test: FAIL (watchdog_ground: artifact 5000s old vs max-age 1800s with cron ALIVE must read DEAD, got '$(cat "$_ws")')"; rm -f "$_wa" "$_ws" "$_wc" "$_wc.empty"; exit 1; }
  # (4) recovery edge: a fresh artifact returns the state to OK
  touch "$_wa"
  WATCHDOG_GROUND_STATE="$_ws" MESH_WATCHDOG_CRON="$_wc" WATCHDOG_ARTIFACT="$_wa" \
    MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 watchdog_ground
  [ "$(cat "$_ws")" = OK ] || { echo "smoke-test: FAIL (watchdog_ground: a fresh artifact must recover state to OK, got '$(cat "$_ws")')"; rm -f "$_wa" "$_ws" "$_wc" "$_wc.empty"; exit 1; }
  # (5) CRON-DEATH DEFERRAL: same stale artifact, but the INDEPENDENT audit sees ZERO cron sessions →
  #     this is a downstream symptom of [scheduler-dead], so we must NOT claim the watchdog itself died.
  #     RED-first: remove the deferral and this leg fails (the two alarms would double-report one fault).
  : > "$_cj"
  touch -d "@$(( $(now) - 5000 ))" "$_wa"
  echo OK > "$_ws"
  WATCHDOG_GROUND_STATE="$_ws" MESH_WATCHDOG_CRON="$_wc" WATCHDOG_ARTIFACT="$_wa" \
    MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 watchdog_ground
  [ "$(cat "$_ws")" = OK ] || { echo "smoke-test: FAIL (watchdog_ground: with cron DEAD a stale watchdog is a downstream symptom — [scheduler-dead] owns it; state must not flip, got '$(cat "$_ws")')"; rm -f "$_wa" "$_ws" "$_wc" "$_wc.empty"; exit 1; }
  # (6) ABSENT artifact on a freshly-started loop must NOT alarm (heartbeat younger than the max-age),
  #     but MUST alarm once the loop has been up longer than it. RED-first: drop the heartbeat guard and
  #     the first half fails — a just-planted node would alarm before reflex-health's first run.
  printf 'pam_unix(cron:session): session opened for user mesh-home\n' > "$_cj"
  rm -f "$_wa"; _whb="$(mktemp)"; echo OK > "$_ws"
  touch "$_whb"
  WATCHDOG_GROUND_STATE="$_ws" MESH_WATCHDOG_CRON="$_wc" WATCHDOG_ARTIFACT="$_wa" HB="$_whb" \
    MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 watchdog_ground
  [ "$(cat "$_ws")" = OK ] || { echo "smoke-test: FAIL (watchdog_ground: an absent artifact on a just-started loop must NOT alarm, got '$(cat "$_ws")')"; rm -f "$_ws" "$_wc" "$_wc.empty" "$_whb"; exit 1; }
  touch -d "@$(( $(now) - 5000 ))" "$_whb"
  WATCHDOG_GROUND_STATE="$_ws" MESH_WATCHDOG_CRON="$_wc" WATCHDOG_ARTIFACT="$_wa" HB="$_whb" \
    MESH_CRON_JOURNAL="$_cj" MESH_AUDIT_NOPOST=1 watchdog_ground
  [ "$(cat "$_ws")" = DEAD ] || { echo "smoke-test: FAIL (watchdog_ground: an absent artifact after the loop has been up past the max-age IS the fault, got '$(cat "$_ws")')"; rm -f "$_ws" "$_wc" "$_wc.empty" "$_whb"; exit 1; }
  rm -f "$_wa" "$_ws" "$_wc" "$_wc.empty" "$_whb"
  rm -f "$_cj" "$_cas"
  echo "smoke-test: ok (${#TASKS[@]} liveness tasks orchestrated; spawn-kick on GENUINE relaunch markers only — zero-count/routine prose never kicks; heartbeat+state wired; System-3* cron-audit: counts INDEPENDENT cron sessions, 0=scheduler-dead edge, recovery=ok, unreadable=honest-n/a; watchdog-ground: max-age DERIVED from the live reflex-health cron stride, unscheduled=n/a, stale-with-cron-alive=dead edge, cron-dead=deferred to [scheduler-dead], absent-artifact gated on loop uptime)"; exit 0
fi

case "${1:-}" in
  --audit-cron) cron_audit; exit 0 ;;   # System 3* independent audit of the cron scheduler (see block above)
  --audit-watchdog) watchdog_ground; exit 0 ;;   # ground the TOP reflex watchdog from outside its own loop
  --once) touch "$HB"; run_due; exit 0 ;;
  "")
    echo "$(ts) liveness-loop START tick=${BASE}s tasks=${#TASKS[@]}" >> "$LOG"
    while :; do touch "$HB"; run_due || true; sleep "$BASE"; done ;;
  *) echo "mesh-liveness-loop: unknown arg '$1'" >&2; exit 1 ;;
esac
