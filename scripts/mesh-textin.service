[Unit]
Description=mesh textin (channel-agnostic TEXT→ACT router — watches voice-in.log, routes /roz /meshtv @win to panes)
After=default.target mesh-voice-rx.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/mesh-textin
Restart=always
RestartSec=5
# THE HANG GUARD (2026-08-21) — b92cee2's lesson applied to the router half of the operator path.
# Restart= only fires on a process that DIES; a router hung in read()/mesh-tell stays `active
# (running)` forever and pgrep keeps saying UP. A stall is unreachable from inside the stalled
# loop, so the guard lives out here: mesh-textin marks a cycle (and pings WATCHDOG=1) on EVERY
# iteration — routed AND idle — and systemd kills+restarts the unit when the pings stop.
#
# NotifyAccess=all, NOT main, and this is measured not assumed (systemd 255, this node, 2026-08-21):
# mesh-textin is bash, so the ping comes from a systemd-notify CHILD. Under NotifyAccess=main
# systemd logs "reception only permitted for main PID" and DROPS it — a 30s-ping unit under a 10s
# watchdog took 2 restarts in 30s, i.e. the guard would not merely be decorative, it would kill a
# perfectly healthy router on a schedule. The same unit under NotifyAccess=all: 0 restarts.
# `systemd-notify --pid=$$` does not rescue main either — the kernel refuses an unprivileged
# SCM_CREDENTIALS pid override.
#
# 300s is well above one worst-case cycle: a 30s idle tick, or one routed line whose mesh-tell +
# extract work runs far shorter than that.
WatchdogSec=300
NotifyAccess=all

[Install]
WantedBy=default.target
