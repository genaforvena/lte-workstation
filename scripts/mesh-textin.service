[Unit]
Description=mesh textin (channel-agnostic TEXT→ACT router — watches voice-in.log, routes /roz /meshtv @win to panes)
After=default.target mesh-voice-rx.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/mesh-textin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
