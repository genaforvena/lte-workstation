#!/usr/bin/env bash
# mesh-pane-consume — CONSUMER-side stream driver (operator 2026-06-21: the "maximally ephemeral
# stream" model). This INVERTS the retired mesh-pane-pump. The design the operator settled:
#
#   "поток сверху должен быть максимально эфемерным … источник толкает всё целиком и НЕ фильтрует;
#    если что-то не нужно — это задача ПОТРЕБИТЕЛЯ (нижнего пейна, ума). Источник просто обновляет
#    верхний пейн, а ум сам решает, когда туда смотреть, на своём ритме."
#
# So: the TOP (data) pane is a live, FULL, unfiltered ephemeral stream (mesh-dash <role> already
# refreshes it). NOTHING is cached, NO log of stream content is kept — the only memory of the stream
# is the tmux scrollback itself (decays on reboot, by design). The SOURCE never pokes the mind.
#
# DIFF-GATED WAKE (operator 2026-06-25, "капельки с крыши" / droplets-from-the-roof — SUPERSEDES the
# 2026-06-21 pure-poll above): "данные сверху всегда свежие и обновляются, но ВНИЗ к уму падает только
# если есть DIFF — одинаковое не копится, капает только изменение." This driver re-invites a TUI mind to
# look at its top pane ONLY when that pane's MEANINGFUL content actually CHANGED. The old pure-poll
# re-invited every interval regardless of change, so every mind burned a full turn deciding "nothing
# changed -> idle" on every tick — the direct cause of the weekly-limit overruns. A quiet pane now costs
# ZERO mind tokens; idle-when-nothing-happens is structural, not a tuned interval.
#
# The diff is a WAKE-GATE, not a source filter: the driver still passes NO stream content to the mind —
# it only decides WHETHER to re-invite. The mind still pulls its own FULL pane and owns the filter. To
# make panes actually quiet, strip_volatile() removes per-frame chrome (clocks / "as of" / ages) before
# hashing — without that, a naive whole-pane hash is always-different (the delta-flood scar) and never
# quiets. Meaningful values (counts, scores, board lines) survive the strip and DO wake the mind. Jobs:
#   1) cheap diff-check the data pane (.0) at --interval, and
#   2) on a real change, idle-gate the MIND pane and re-invite (never type mid-turn), carrying no content.
#
#   mesh-pane-consume <channel> [--interval N] [--once] [--dry]
#     <channel>   tmux window name on this node's session (top=.0 data stream, bottom=.1 mind)
#     --interval  diff-RECHECK cadence seconds (cheap; no mind tokens). Default 60. With diff-gating this
#                 is just how responsive the wake is, NOT a spend knob.
#     --once      one diff-check + maybe-wake pass then exit (for --test / a cron-tick driver)
#     --dry       detect change + idle, but do NOT wake the mind
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"
LOG="$HOME/.mesh/pane-consume.log"   # ops heartbeat ONLY (wake/skip events) — never stream content
ts(){ date -u +%FT%TZ; }

# Mind pane = the BOTTOM pane (largest pane_top) of the channel window.
mind_pane(){ tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}'; }

# Idle detection, engine-agnostic (works for codex/claude/opencode alike): a WORKING TUI redraws
# (spinner, streaming tokens); an IDLE one is static. Double-capture the MIND pane — static = idle.
# (mesh-mind-state's WORKING flag is unreliable for codex, so we use the change signal, like mesh-feed.)
mind_idle(){ # 0 = idle (safe to wake)
  local ch="$1" p a b; p="$(mind_pane "$ch")"
  a="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"; [ -z "$a" ] && return 1
  sleep 2.5
  b="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"
  [ "$a" = "$b" ]
}

# channel→mesh-dash role (mirrors mesh-restore's ensure_uniform_channel mapping; only health differs).
dash_role(){ case "$1" in health) echo check ;; *) echo "$1" ;; esac; }

wake_msg(){ # content-free re: the stream — carries NO stream data/diff; only names HOW to read live state.
  # WHY name the command: "read your pane yourself" is too vague for a non-claude engine — agy/Gemini
  # would think "Prioritizing Tool Usage" and then idle "awaiting data stream" without ever capturing the
  # pane (operator 2026-06-21: "minds mind is not working"). Naming the one-shot read command makes the
  # pull reliable for EVERY engine while keeping the inversion intact (the MIND runs it + owns the filter;
  # the driver never captures/diffs). --once is MANDATORY in the hint: bare `mesh-dash <role>` is the
  # pane's own infinite render loop and hangs the mind's turn forever (that exact trap idled agy).
  local ch="$1" role; role="$(dash_role "$ch")"
  printf '%s' "[$ch consume] Read your live state NOW — run this yourself: mesh-dash --once $role  \
(one-shot, returns immediately; do NOT run it without --once — that is the pane's infinite render loop and will hang your turn). \
That output IS your full UNFILTERED state stream — you own the filter, the source does not gate. Then take ONE concrete action on it, \
or post exactly one terse [idle] line naming the real current state. Never answer 'awaiting data stream' — your state is that command's output."
}

# strip_volatile — remove per-frame CHROME so an unchanged pane hashes stably. Strips ONLY timestamp/
# age/clock tokens + the dash live-heartbeat footer; never bare digits/words (those carry real deltas —
# a count 2->3, a score, a board line — which MUST still wake the mind). Tuned per the delta-flood scar
# (memory delta-channels-need-gate / cross-sense-vocab-contract: gate volatile fields, not content).
strip_volatile(){
  sed -E \
    -e 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z?//g' \
    -e 's/[0-9]{2}:[0-9]{2}:[0-9]{2}//g' \
    -e 's/\b[0-9]+[smhd] ago\b//g' \
    -e 's/\bage [0-9]+[smhd]?\b//g' \
    -e 's/as of [^|·]*//g' \
    -e 's/\brefresh [0-9]+s\b//g' \
    -e 's/cam=LIVE [0-9]+s [0-9]+B/cam=LIVE/g' \
    -e 's/cache [0-9]+s/cache/g' \
    -e 's/[0-9]+ utterances/N utterances/g' \
    -e '/pane live|ticks every frame/d' \
    -e '/^voice: /d'
}
# DISCHARGED STOPGAP (operator 2026-06-25 — top-pane fullness/liveness is each WINDOW MIND's job, NOT a
# forever-growing central strip): the spinner+timer, "name=18m" /compact, parenthetical-age "(42s)/(9m)"
# and "(cached 91s)" rules added during the diff-gate leak sweep are ALL REMOVED again — every owning dash
# now buckets its own ages at the source (minds 24dcb96 · room/genome 4976f47 · senses a57ef36), verified
# quiet over 40s with universal chrome stripping only. strip_volatile is back to UNIVERSAL chrome (absolute
# timestamps/clocks/"as of"/"refresh Ns" + the room-liveness lines below) — the per-window churn it used to
# paper over is fixed where it belongs. If a NEW dash floods, fix that dash, don't re-add a rule here.
# NB the 3 rules above THESE are ROOM-liveness chrome: the cam frame age+JPEG byte size and the ambient
# audio-buffer utterance COUNT wobble every frame but are not a wake-worthy change for the room channel
# (it is gesture-driven — it acts on a thumbs-up / a real transcript line, not on the utterance ticker).
# The voice: line (self-verify, added 2026-07-04) is the SAME class of self-referential chrome and drops
# whole: it summarizes MISHA'S OWN last-5 say-verify verdicts, so it changes every time he speaks AT ALL —
# without this, each utterance re-wakes him via his own dash line with no new transcript content, and
# lacking anything real to add he fills the turn with a bland filler ("Меш слушает комнату, проверка." —
# observed 6x in ~1.5h, operator: "always the same reply, где тут смысл??"). Self-caused, not new
# information, so it must never be a wake trigger — a human watching the pane still sees it live.
# Validated 2026-06-25: with these, every channel's data pane quiets across a no-real-change interval.

# pane_sig — stable signature of a channel's DATA pane (.0) AFTER stripping chrome. A failed capture
# yields the empty-input hash (still stable). || true keeps pipefail from tripping on an empty pane.
pane_sig(){ tmux capture-pane -t "$S:$1.0" -p 2>/dev/null | strip_volatile | sha1sum | awk '{print $1}' || true; }

consume_once(){ # <channel> <dry> -> 0 if a wake was sent/would-be-sent
  local ch="$1" dry="$2" tell_out tell_rc
  if ! mind_idle "$ch"; then
    echo "$(ts) $ch: mind busy — skip wake (will re-invite next pass)" >> "$LOG"; return 1
  fi
  if [ "$dry" = 1 ]; then echo "$(ts) $ch: idle (dry — no wake)" >> "$LOG"; return 0; fi
  # DEAD-SHELL honesty (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): mesh-tell now
  # refuses a send into a shed/killed pane (bare shell, no mind engine) — check its result instead of
  # discarding it, so a refused injection logs as REFUSED, not a false "WOKE mind" claim (this driver's
  # only side-effecting action IS mesh-tell; the guard lives there once, not duplicated here).
  tell_out="$(mesh-tell "$ch" "$(wake_msg "$ch")" 2>&1)"; tell_rc=$?
  if [ "$tell_rc" -ne 0 ] && printf '%s' "$tell_out" | grep -q REFUSED; then
    echo "$(ts) $ch: mesh-tell REFUSED — $tell_out" >> "$LOG"; return 1
  fi
  echo "$(ts) $ch: WOKE mind to consume its stream" >> "$LOG"
  return 0
}

# ---- entry ----
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
  # the wake message must be non-empty, name the one-shot read command, and keep the consumer-owns-filter
  # directive (content-free re: the stream — it must not carry stream data, only HOW to read it).
  m="$(wake_msg senses)"
  [ -n "$m" ] || { echo "smoke-test: FAIL (empty wake msg)"; exit 1; }
  case "$m" in *"you own the filter"*) : ;; *) echo "smoke-test: FAIL (wake msg lost the consumer-filter directive)"; exit 1;; esac
  case "$m" in *"mesh-dash --once"*) : ;; *) echo "smoke-test: FAIL (wake msg must name the one-shot read command for non-claude engines)"; exit 1;; esac
  # health's dash role is 'check' (mirrors mesh-restore) — a wrong role makes the named command render the wrong pane
  case "$(wake_msg health)" in *"mesh-dash --once check"*) : ;; *) echo "smoke-test: FAIL (health must map to dash role 'check')"; exit 1;; esac
  # DIFF-GATE (operator 2026-06-25 droplets model): strip_volatile must QUIET a timestamp-only frame yet
  # PRESERVE a real change — else minds either flood (pane never quiets) or freeze (real change masked).
  q1="$(printf 'presence n=2 | as of 2026-06-25T00:12:31Z · refresh 30s\npane live: ticks every frame' | strip_volatile)"
  q2="$(printf 'presence n=2 | as of 2026-06-25T00:59:05Z · refresh 30s\npane live: ticks every frame' | strip_volatile)"
  [ "$q1" = "$q2" ] || { echo "smoke-test: FAIL (strip_volatile did not quiet a timestamp-only frame — pane would never go quiet, minds flood)"; exit 1; }
  r1="$(printf 'presence n=2 | x' | strip_volatile)"; r2="$(printf 'presence n=3 | x' | strip_volatile)"
  [ "$r1" != "$r2" ] || { echo "smoke-test: FAIL (strip_volatile masked a real change n=2 vs n=3 — mind would never wake)"; exit 1; }
  # per-window leak sweep discharged 2026-06-25 — the dashes bucket their own ages now, so a real diffstat
  # "(+48 -9)" / count must survive universal-only stripping (never masked as if it were chrome).
  e1="$(printf '+ mesh-screen-state (+48 -9)' | strip_volatile)"
  case "$e1" in *'(+48 -9)'*) : ;; *) echo "smoke-test: FAIL (universal strip ate a diffstat (+48 -9) — not chrome, must survive)"; exit 1;; esac
  # voice: self-verify line (room, 2026-07-04) is self-caused chrome — Misha's own speech changes it, so
  # it must never wake him on its own (else every utterance re-wakes him with nothing new to say).
  v1="$(printf 'ear: watcher UP\nvoice: last=MUTED (0/5 verified ok, 0/5 silent/mismatch)' | strip_volatile)"
  v2="$(printf 'ear: watcher UP\nvoice: last=OK (3/5 verified ok, 0/5 silent/mismatch)' | strip_volatile)"
  [ "$v1" = "$v2" ] || { echo "smoke-test: FAIL (voice: verdict churn still wakes the room mind on its own speech)"; exit 1; }
  # ── System-0 policy lock (LIVE-LIT 2026-07-09) ───────────────────────────────────────────────────
  # strip_volatile() IS this node's "System 0": the pre-attentional filter that decides what counts as a
  # wake-worthy change BEFORE any mind (System 1/2) ever reasons on it. Concept: "System 0" — a layer
  # prepended to Kahneman's dual-system model that "precedes and structures both intuitive and reflective
  # thought" — from "Cognitive Assemblages: Living with Algorithms", Big Data & Cognitive Computing
  # 10(2):63 (MDPI, Feb 2026, mdpi.com/2504-2289/10/2/63). Its named danger is OBSCURED interpretive
  # labour (Crosset & Dupont 2022, "the entangled nature of algorithmic content moderation"): an over-broad
  # strip SILENTLY eats a meaningful change → the mind never wakes → a real event vanishes with NO error.
  # A raw shadow-diff can't audit this (chrome legitimately changes every frame — the whole reason the
  # strip exists), so the audit lives HERE, at the policy: the single n=2→n=3 fixture above guarded ONE
  # shape; lock the meaningful-change shapes real dashes actually carry so a future strip-regex edit that
  # would freeze a mind fails loudly instead of shipping a silent System-0 blind spot. (Probed live
  # 2026-07-09: all six SURVIVE the current strip — this is a regression lock, not a bugfix.)
  s0(){ [ "$(printf '%s' "$1" | strip_volatile)" != "$(printf '%s' "$2" | strip_volatile)" ] \
        || { echo "smoke-test: FAIL (System-0 strip masked a real change — mind would freeze on: $3)"; exit 1; }; }
  s0 'posture=NOMINAL'   'posture=WATCH'              'posture flip'
  s0 'stranded=0'        'stranded=2'                 'stranded count'
  s0 'vitality: OK'      'vitality: DEGRADED'         'vitality label'
  s0 'heaps-β=0.718'     'heaps-β=0.719'              'score delta'
  s0 '  [idle] nothing'  '  [task] chat-review/foo'   'board task appears'
  s0 'burst=NONE'        'burst=BURST'                'tamper burst label'
  # DEAD-SHELL honesty (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): consume_once must
  # not claim "WOKE mind" when mesh-tell actually REFUSED (a shed pane, no mind engine) — check the
  # refusal against the real LOG file since consume_once has no return-value hook for its message.
  # mesh-tell stubbed as a shell function (bash resolves it before PATH) + mind_idle stubbed to skip the
  # real 2.5s double-capture wait — hermetic, no live tmux window needed.
  _pc_log="$(mktemp)"; LOG="$_pc_log"
  mind_idle(){ return 0; }
  mesh-tell(){ echo "mesh-tell: REFUSED — fake @ local is a bare shell (no mind engine), not a mind prompt: DEAD-SHELL	bare shell" >&2; return 1; }
  consume_once fakech 0; _pc_rc=$?
  [ "$_pc_rc" -ne 0 ] || { echo "smoke-test: FAIL (consume_once must return non-zero when mesh-tell refuses)"; exit 1; }
  grep -q 'REFUSED' "$_pc_log" || { echo "smoke-test: FAIL (a refused send must log REFUSED, got: $(cat "$_pc_log"))"; exit 1; }
  grep -q 'WOKE mind' "$_pc_log" && { echo "smoke-test: FAIL (a refused send must NOT also log the false WOKE claim: $(cat "$_pc_log"))"; exit 1; }
  # a NORMAL successful send still logs WOKE as before (falsify: swap the stub's rc/output above)
  : > "$_pc_log"
  mesh-tell(){ return 0; }
  consume_once fakech 0; _pc_rc2=$?
  [ "$_pc_rc2" -eq 0 ] || { echo "smoke-test: FAIL (a successful send should return 0)"; exit 1; }
  grep -q 'WOKE mind' "$_pc_log" || { echo "smoke-test: FAIL (a successful send must still log WOKE mind, got: $(cat "$_pc_log"))"; exit 1; }
  unset -f mind_idle mesh-tell; rm -f "$_pc_log"
  echo "smoke-test: ok (diff-gated wake; chrome stripped so panes quiet; real deltas still wake; mind owns the filter + DEAD-SHELL: a refused mesh-tell send logs REFUSED not a false WOKE claim)"; exit 0
fi

ch="${1:?usage: mesh-pane-consume <channel> [--interval N] [--once] [--dry]}"; shift || true
INTERVAL=60; ONCE=0; DRY=0
while [ $# -gt 0 ]; do case "$1" in
  --interval) INTERVAL="$2"; shift 2 ;;
  --once) ONCE=1; shift ;;
  --dry) DRY=1; shift ;;
  *) echo "mesh-pane-consume: unknown arg '$1'" >&2; exit 1 ;;
esac; done

tmux has-session -t "$S" 2>/dev/null || { echo "mesh-pane-consume: no tmux session '$S'" >&2; exit 1; }
tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$ch" || { echo "mesh-pane-consume: no window '$ch'" >&2; exit 1; }

if [ "$ONCE" = 1 ]; then consume_once "$ch" "$DRY"; exit 0; fi
echo "$(ts) consume start ch=$ch interval=${INTERVAL}s dry=$DRY (diff-gated)" >> "$LOG"
# DIFF-GATED loop: re-invite the mind ONLY when the data pane's stripped signature changed (the droplet
# falls only on a real change). First pass always wakes (baseline / spawn-moment read). prev_sig is
# advanced ONLY when consume_once actually delivered (idle+woke / dry-idle) — if the mind was BUSY,
# keep prev_sig so the pending change is retried next pass instead of being silently dropped.
prev_sig=""
while :; do
  cur_sig="$(pane_sig "$ch")"
  if [ "$cur_sig" != "$prev_sig" ]; then
    if consume_once "$ch" "$DRY"; then prev_sig="$cur_sig"; fi
  else
    echo "$(ts) $ch: pane unchanged — no wake (droplet held)" >> "$LOG"
  fi
  sleep "$INTERVAL"
done
