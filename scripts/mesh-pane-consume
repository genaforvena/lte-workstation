#!/usr/bin/env bash
# mesh-pane-consume — CONSUMER-side stream driver (operator 2026-06-21: the "maximally ephemeral
# stream" model). This INVERTS the retired mesh-pane-pump. The design the operator settled:
#
#   "поток сверху должен быть максимально эфемерным … источник толкает всё целиком и НЕ фильтрует;
#    если что-то не нужно — это задача ПОТРЕБИТЕЛЯ (нижнего пейна, ума). Источник просто обновляет
#    верхний пейн, а ум сам решает, когда туда смотреть, на своём ритме."
#
# So: the TOP (data) pane is a live, FULL, unfiltered ephemeral stream (mesh-dash <role> already
# refreshes it). NOTHING is cached, NO log of stream content is kept — the only memory of the stream
# is the tmux scrollback itself (decays on reboot, by design). The SOURCE never pokes the mind.
#
# DIFF-GATED WAKE (operator 2026-06-25, "капельки с крыши" / droplets-from-the-roof — SUPERSEDES the
# 2026-06-21 pure-poll above): "данные сверху всегда свежие и обновляются, но ВНИЗ к уму падает только
# если есть DIFF — одинаковое не копится, капает только изменение." This driver re-invites a TUI mind to
# look at its top pane ONLY when that pane's MEANINGFUL content actually CHANGED. The old pure-poll
# re-invited every interval regardless of change, so every mind burned a full turn deciding "nothing
# changed -> idle" on every tick — the direct cause of the weekly-limit overruns. A quiet pane now costs
# ZERO mind tokens; idle-when-nothing-happens is structural, not a tuned interval.
#
# The diff is a WAKE-GATE, not a source filter: the driver still passes NO stream content to the mind —
# it only decides WHETHER to re-invite. The mind still pulls its own FULL pane and owns the filter. To
# make panes actually quiet, strip_volatile() removes per-frame chrome (clocks / "as of" / ages) before
# hashing — without that, a naive whole-pane hash is always-different (the delta-flood scar) and never
# quiets. Meaningful values (counts, scores, board lines) survive the strip and DO wake the mind. Jobs:
#   1) cheap diff-check the data pane (.0) at --interval, and
#   2) on a real change, idle-gate the MIND pane and re-invite (never type mid-turn), carrying no content.
#
#   mesh-pane-consume <channel> [--interval N] [--once] [--dry]
#     <channel>   tmux window name on this node's session (top=.0 data stream, bottom=.1 mind)
#     --interval  diff-RECHECK cadence seconds (cheap; no mind tokens). Default 60. With diff-gating this
#                 is just how responsive the wake is, NOT a spend knob.
#     --once      one diff-check + maybe-wake pass then exit (for --test / a cron-tick driver)
#     --dry       detect change + idle, but do NOT wake the mind
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"
LOG="${MESH_PANE_CONSUME_LOG:-$HOME/.mesh/pane-consume.log}"   # ops heartbeat ONLY (wake/skip events) — never stream content; override so probes never write the live log a watchdog reads (guardian 09f7914)
ts(){ date -u +%FT%TZ; }

# Mind pane = the BOTTOM pane (largest pane_top) of the channel window.
mind_pane(){ tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}'; }

# Idle detection, engine-agnostic (works for codex/claude/opencode alike): a WORKING TUI redraws
# (spinner, streaming tokens); an IDLE one is static. Double-capture the MIND pane — static = idle.
# (mesh-mind-state's WORKING flag is unreliable for codex, so we use the change signal, like mesh-feed.)
mind_idle(){ # 0 = idle (safe to wake)
  local ch="$1" p a b; p="$(mind_pane "$ch")"
  a="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"; [ -z "$a" ] && return 1
  sleep 2.5
  b="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"
  [ "$a" = "$b" ]
}

# channel→mesh-dash role (mirrors mesh-restore's ensure_uniform_channel mapping; only health differs).
dash_role(){ case "$1" in health) echo check ;; *) echo "$1" ;; esac; }

wake_msg(){ # content-free re: the stream — carries NO stream data/diff; only names HOW to read live state.
  # WHY name the command: "read your pane yourself" is too vague for a non-claude engine — agy/Gemini
  # would think "Prioritizing Tool Usage" and then idle "awaiting data stream" without ever capturing the
  # pane (operator 2026-06-21: "minds mind is not working"). Naming the one-shot read command makes the
  # pull reliable for EVERY engine while keeping the inversion intact (the MIND runs it + owns the filter;
  # the driver never captures/diffs). --once is MANDATORY in the hint: bare `mesh-dash <role>` is the
  # pane's own infinite render loop and hangs the mind's turn forever (that exact trap idled agy).
  local ch="$1" role; role="$(dash_role "$ch")"
  printf '%s' "[$ch consume] Read your live state NOW — run this yourself: mesh-dash --once $role  \
(one-shot, returns immediately; do NOT run it without --once — that is the pane's infinite render loop and will hang your turn). \
That output IS your full UNFILTERED state stream — you own the filter, the source does not gate. Then take ONE concrete action on it, \
or post exactly one terse [idle] line naming the real current state. Never answer 'awaiting data stream' — your state is that command's output. \
Last: PREDICT your pane — run mesh-wake-expect $ch '<egrep pattern>' ... naming the line-shapes you expect to churn harmlessly before your next real wake; \
a change your prediction fully covers will NOT wake you (bounded by TTL + a deaf-guard), an unpredicted line always will. Sharpen it each wake."
}

# strip_volatile — remove per-frame CHROME so an unchanged pane hashes stably. Strips ONLY timestamp/
# age/clock tokens + the dash live-heartbeat footer; never bare digits/words (those carry real deltas —
# a count 2->3, a score, a board line — which MUST still wake the mind). Tuned per the delta-flood scar
# (memory delta-channels-need-gate / cross-sense-vocab-contract: gate volatile fields, not content).
strip_volatile(){
  sed -E \
    -e 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z?//g' \
    -e 's/[0-9]{2}:[0-9]{2}:[0-9]{2}//g' \
    -e 's/\b[0-9]+[smhd] ago\b//g' \
    -e 's/\bage [0-9]+[smhd]?\b//g' \
    -e 's/as of [^|·]*//g' \
    -e 's/\brefresh [0-9]+s\b//g' \
    -e 's/cam=LIVE [0-9]+s [0-9]+B/cam=LIVE/g' \
    -e 's/cache [0-9]+s/cache/g' \
    -e 's/[0-9]+ utterances/N utterances/g' \
    -e '/pane live|ticks every frame/d' \
    -e '/^voice: /d'
}
# DISCHARGED STOPGAP (operator 2026-06-25 — top-pane fullness/liveness is each WINDOW MIND's job, NOT a
# forever-growing central strip): the spinner+timer, "name=18m" /compact, parenthetical-age "(42s)/(9m)"
# and "(cached 91s)" rules added during the diff-gate leak sweep are ALL REMOVED again — every owning dash
# now buckets its own ages at the source (minds 24dcb96 · room/genome 4976f47 · senses a57ef36), verified
# quiet over 40s with universal chrome stripping only. strip_volatile is back to UNIVERSAL chrome (absolute
# timestamps/clocks/"as of"/"refresh Ns" + the room-liveness lines below) — the per-window churn it used to
# paper over is fixed where it belongs. If a NEW dash floods, fix that dash, don't re-add a rule here.
# NB the 3 rules above THESE are ROOM-liveness chrome: the cam frame age+JPEG byte size and the ambient
# audio-buffer utterance COUNT wobble every frame but are not a wake-worthy change for the room channel
# (it is gesture-driven — it acts on a thumbs-up / a real transcript line, not on the utterance ticker).
# The voice: line (self-verify, added 2026-07-04) is the SAME class of self-referential chrome and drops
# whole: it summarizes MISHA'S OWN last-5 say-verify verdicts, so it changes every time he speaks AT ALL —
# without this, each utterance re-wakes him via his own dash line with no new transcript content, and
# lacking anything real to add he fills the turn with a bland filler ("Меш слушает комнату, проверка." —
# observed 6x in ~1.5h, operator: "always the same reply, где тут смысл??"). Self-caused, not new
# information, so it must never be a wake trigger — a human watching the pane still sees it live.
# Validated 2026-06-25: with these, every channel's data pane quiets across a no-real-change interval.

# ── SMART / MIND-DEFINED wake diff (operator 2026-07-18, spec docs/specs/2026-07-18-mind-wake-signature.md)
# The DATA PANE IS SACRED — no dash/producer change (the first draft, a WAKE-SIG line emitted by the
# dashes, was REJECTED: "не меняем топ пейны ради починки миндов"). ALL smartness lives HERE, on the
# reactor's INTERNAL copy of the capture (never shown to anyone), filtered before hashing. Two layers:
#
#   1. SMART-BY-DEFAULT (smart_normalize): strip_volatile already removes CHROME (clocks/ages) but NOT
#      live NUMERICS — latency 7.75→8.1ms, byte counters, rates, key=float telemetry — which fill
#      telemetry-rich panes (vpn/bruno) and woke the mind on numeric JIGGLE, not a state change. So the
#      normalization ALSO neutralizes unit-bearing numerics: a value-only delta no longer changes the
#      hash, while DISCRETE changes (a verdict word UP↔DOWN, an INTEGER count peers=16→15) still wake.
#   2. MIND-DEFINED wake-rule ($WAKE_RULE_DIR/<channel>, gitignored, node-local, the MIND owns+tunes it):
#      one grep -E pattern/line = the SIGNIFICANT lines this mind watches; a leading '-' = an EXCLUDE
#      pattern. When present, the reactor keeps ONLY the mind-selected lines, then normalizes+hashes
#      those (the line filter RESTRICTS the hashed set; smart_normalize still neutralizes intra-line
#      telemetry on a kept line — the dash packs verdict+telemetry on ONE line, so line-selection alone
#      can't quiet it). No file → smart_normalize on the whole pane. Mode is logged per wake.
WAKE_RULE_DIR="${MESH_WAKE_RULE_DIR:-$HOME/.mesh/wake-rule}"

# smart_normalize — strip_volatile (chrome) THEN neutralize unit-bearing telemetry numerics. Order:
# rate (…B/s) BEFORE bytes (…B) so the trailing "/s" isn't orphaned; ms and key=float independent.
# Keeps bare integers (counts) and discrete words — only value-jiggle with a UNIT/float is masked.
smart_normalize(){
  strip_volatile | sed -E \
    -e 's/[0-9]+(\.[0-9]+)? ?[KMGT]?B\/s/<rate>/g' \
    -e 's/[0-9]+(\.[0-9]+)? ?[KMGT]?B\b/<bytes>/g' \
    -e 's/[0-9]+(\.[0-9]+)? ?ms\b/<ms>/g' \
    -e 's/([a-z_]+=)[0-9]+\.[0-9]+/\1<f>/g'
}

# apply_wake_rule — <rulefile> on stdin: keep lines matching ANY include pattern (non-'-' lines), then
# drop lines matching ANY exclude pattern (leading '-'). '#'/blank lines ignored. Only excludes present
# → keep all lines minus excludes. grep -E -f ORs the patterns; failures degrade to empty, not error.
apply_wake_rule(){
  local rf="$1" inc exc buf
  inc="$(sed -E '/^[[:space:]]*($|#)/d; /^-/d' "$rf")"
  exc="$(sed -nE '/^-/{s/^-//;p}' "$rf")"
  buf="$(cat)"
  [ -n "$inc" ] && buf="$(printf '%s\n' "$buf" | grep -E -f <(printf '%s\n' "$inc") || true)"
  [ -n "$exc" ] && buf="$(printf '%s\n' "$buf" | grep -vE -f <(printf '%s\n' "$exc") || true)"
  printf '%s\n' "$buf"
}

# wake_mode — which diff layer applies for <channel>: an explicit mind-owned rule, or the smart default.
wake_mode(){ [ -f "$WAKE_RULE_DIR/$1" ] && echo rule || echo smart-default; }

# norm_of — <channel> on stdin=frame → the reactor's normalized INTERNAL copy (rule-filtered then
# smart-normalized, or smart-normalized whole). Never shown to anyone; the pure core both the sig and
# the predictive gate below diff against (hermetic — --test feeds frames directly).
norm_of(){
  local ch="$1"; local rf="$WAKE_RULE_DIR/$ch"   # two statements: local expands its words BEFORE assigning, $ch would be unbound
  if [ -f "$rf" ]; then apply_wake_rule "$rf" | smart_normalize; else smart_normalize; fi
}

# sig_of — <channel> on stdin=frame → stable signature (hash of the normalized internal copy).
sig_of(){ norm_of "$1" | sha1sum | awk '{print $1}'; }

# pane_norm — normalized internal copy of a channel's DATA pane (.0). Captures as today (pane untouched).
# || true keeps pipefail from tripping on an empty pane.
pane_norm(){ tmux capture-pane -t "$S:$1.0" -p 2>/dev/null | norm_of "$1" || true; }

# ── PREDICTIVE wake gate (operator 2026-07-23: "every mind should be improving its reflexes to predict
# next top pane state … wake only if prediction does not match reality"). Motivating measurement (board
# [fyi] 2026-07-23): at the slow consume tempo the change-gate is VACUOUS — 110-239 WOKE vs 0-10
# no-change skips per channel over the whole log; over a 3-8h interval every pane drifts, so "changed?"
# always answers yes. The upgrade: change-gated → SURPRISE-gated. After handling a wake the MIND writes
# an EXPECTATION for its channel (mesh-wake-expect <chan> — grep -E patterns over NORMALIZED lines it
# PREDICTS will churn). On the next change the reactor diffs the normalized frames; if every changed
# line matches the prediction, the wake is HELD (reality matched the mind's model — no surprise, no
# turn). Any unpredicted line still wakes. Strictly FAIL-TOWARD-WAKING (the mesh's fail-safe doctrine —
# a mind that over-sleeps loses real events irreversibly, an extra wake costs one turn):
#   - no expectation file / no `# expires:` header / EXPIRED (TTL, default 24h) → plain change-gate;
#   - a malformed pattern (grep rc>1) → every changed line counts as surprise → wake;
#   - DEAF-GUARD: at most $MESH_WAKE_DEAF_CAP consecutive holds (default 2), then wake regardless —
#     an over-broad prediction (`.`) can silence at most cap+1 intervals, never forever;
#   - the previous frame lives ONLY in the daemon's memory (ephemerality doctrine: no stream content
#     on disk; decays with the process like scrollback decays on reboot). --once has no prediction.
WAKE_EXPECT_DIR="${MESH_WAKE_EXPECT_DIR:-$HOME/.mesh/wake-expect}"
DEAF_CAP="${MESH_WAKE_DEAF_CAP:-2}"

expect_fresh(){ # <channel> → 0 iff an expectation exists and is unexpired (header written by mesh-wake-expect)
  local f="$WAKE_EXPECT_DIR/$1" exp
  [ -f "$f" ] || return 1
  exp="$(sed -nE 's/^# expires: ([0-9]+)$/\1/p' "$f" | head -1)"
  [ -n "$exp" ] || return 1
  [ "$(date +%s)" -lt "$exp" ]
}

surprise_of(){ # <channel> <prev_norm> <cur_norm> → prints the UNPREDICTED changed lines (empty = fully predicted)
  local ch="$1" prev="$2" cur="$3" changed pats out rc
  local f="$WAKE_EXPECT_DIR/$ch"   # separate statement: local expands its words before assigning $ch
  changed="$(comm -3 <(printf '%s\n' "$prev" | sort -u) <(printf '%s\n' "$cur" | sort -u) | sed 's/^\t//')"
  [ -n "$changed" ] || return 0
  pats="$(sed -E '/^[[:space:]]*($|#)/d' "$f" 2>/dev/null)"
  [ -n "$pats" ] || { printf '%s\n' "$changed"; return 0; }
  out="$(printf '%s\n' "$changed" | grep -vE -f <(printf '%s\n' "$pats") 2>/dev/null)"; rc=$?
  case "$rc" in
    0) printf '%s\n' "$out" ;;
    1) : ;;                            # every changed line predicted
    *) printf '%s\n' "$changed" ;;     # broken pattern → fail toward waking
  esac
}

gate_decision(){ # <channel> <prev_norm> <cur_norm> <consec_holds> → HOLD | WAKE:deaf | WAKE:surprise:<n> | WAKE:plain
  local ch="$1" prev="$2" cur="$3" supp="$4" sur
  if [ -n "$prev" ] && expect_fresh "$ch"; then
    sur="$(surprise_of "$ch" "$prev" "$cur")"
    if [ -z "$sur" ]; then
      if [ "$supp" -lt "$DEAF_CAP" ]; then echo HOLD; else echo WAKE:deaf; fi
    else
      echo "WAKE:surprise:$(printf '%s\n' "$sur" | grep -c .)"
    fi
  else
    echo WAKE:plain
  fi
}

consume_once(){ # <channel> <dry> [<deliver-to>] -> 0 if a wake was sent/would-be-sent
  # <deliver-to> (window-set-consolidation 2026-07-20): diff/name <channel>'s dash, but idle-gate and
  # wake THAT window's mind — the ABSORBING mind of a merged-away channel (vpn→health, bruno→room,
  # models→discover). Default: self-delivery, unchanged for every non-merged channel.
  local ch="$1" dry="$2" dst="${3:-$1}" tell_out tell_rc
  if ! mind_idle "$dst"; then
    echo "$(ts) $ch: mind busy ($dst) — skip wake (will re-invite next pass)" >> "$LOG"; return 1
  fi
  if [ "$dry" = 1 ]; then echo "$(ts) $ch: idle (dry — no wake)" >> "$LOG"; return 0; fi
  # DEAD-SHELL honesty (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): mesh-tell now
  # refuses a send into a shed/killed pane (bare shell, no mind engine) — check its result instead of
  # discarding it, so a refused injection logs as REFUSED, not a false "WOKE mind" claim (this driver's
  # only side-effecting action IS mesh-tell; the guard lives there once, not duplicated here).
  tell_out="$(mesh-tell "$dst" "$(wake_msg "$ch")" 2>&1)"; tell_rc=$?
  if [ "$tell_rc" -ne 0 ] && printf '%s' "$tell_out" | grep -q REFUSED; then
    echo "$(ts) $ch: mesh-tell REFUSED — $tell_out" >> "$LOG"; return 1
  fi
  echo "$(ts) $ch: WOKE mind${dst:+ ($dst)} to consume its stream" >> "$LOG"
  return 0
}

# ---- entry ----
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
  # the wake message must be non-empty, name the one-shot read command, and keep the consumer-owns-filter
  # directive (content-free re: the stream — it must not carry stream data, only HOW to read it).
  m="$(wake_msg senses)"
  [ -n "$m" ] || { echo "smoke-test: FAIL (empty wake msg)"; exit 1; }
  case "$m" in *"you own the filter"*) : ;; *) echo "smoke-test: FAIL (wake msg lost the consumer-filter directive)"; exit 1;; esac
  case "$m" in *"mesh-dash --once"*) : ;; *) echo "smoke-test: FAIL (wake msg must name the one-shot read command for non-claude engines)"; exit 1;; esac
  # health's dash role is 'check' (mirrors mesh-restore) — a wrong role makes the named command render the wrong pane
  case "$(wake_msg health)" in *"mesh-dash --once check"*) : ;; *) echo "smoke-test: FAIL (health must map to dash role 'check')"; exit 1;; esac
  # DIFF-GATE (operator 2026-06-25 droplets model): strip_volatile must QUIET a timestamp-only frame yet
  # PRESERVE a real change — else minds either flood (pane never quiets) or freeze (real change masked).
  q1="$(printf 'presence n=2 | as of 2026-06-25T00:12:31Z · refresh 30s\npane live: ticks every frame' | strip_volatile)"
  q2="$(printf 'presence n=2 | as of 2026-06-25T00:59:05Z · refresh 30s\npane live: ticks every frame' | strip_volatile)"
  [ "$q1" = "$q2" ] || { echo "smoke-test: FAIL (strip_volatile did not quiet a timestamp-only frame — pane would never go quiet, minds flood)"; exit 1; }
  r1="$(printf 'presence n=2 | x' | strip_volatile)"; r2="$(printf 'presence n=3 | x' | strip_volatile)"
  [ "$r1" != "$r2" ] || { echo "smoke-test: FAIL (strip_volatile masked a real change n=2 vs n=3 — mind would never wake)"; exit 1; }
  # per-window leak sweep discharged 2026-06-25 — the dashes bucket their own ages now, so a real diffstat
  # "(+48 -9)" / count must survive universal-only stripping (never masked as if it were chrome).
  e1="$(printf '+ mesh-screen-state (+48 -9)' | strip_volatile)"
  case "$e1" in *'(+48 -9)'*) : ;; *) echo "smoke-test: FAIL (universal strip ate a diffstat (+48 -9) — not chrome, must survive)"; exit 1;; esac
  # voice: self-verify line (room, 2026-07-04) is self-caused chrome — Misha's own speech changes it, so
  # it must never wake him on its own (else every utterance re-wakes him with nothing new to say).
  v1="$(printf 'ear: watcher UP\nvoice: last=MUTED (0/5 verified ok, 0/5 silent/mismatch)' | strip_volatile)"
  v2="$(printf 'ear: watcher UP\nvoice: last=OK (3/5 verified ok, 0/5 silent/mismatch)' | strip_volatile)"
  [ "$v1" = "$v2" ] || { echo "smoke-test: FAIL (voice: verdict churn still wakes the room mind on its own speech)"; exit 1; }
  # ── System-0 policy lock (LIVE-LIT 2026-07-09) ───────────────────────────────────────────────────
  # strip_volatile() IS this node's "System 0": the pre-attentional filter that decides what counts as a
  # wake-worthy change BEFORE any mind (System 1/2) ever reasons on it. Concept: "System 0" — a layer
  # prepended to Kahneman's dual-system model that "precedes and structures both intuitive and reflective
  # thought" — from "Cognitive Assemblages: Living with Algorithms", Big Data & Cognitive Computing
  # 10(2):63 (MDPI, Feb 2026, mdpi.com/2504-2289/10/2/63). Its named danger is OBSCURED interpretive
  # labour (Crosset & Dupont 2022, "the entangled nature of algorithmic content moderation"): an over-broad
  # strip SILENTLY eats a meaningful change → the mind never wakes → a real event vanishes with NO error.
  # A raw shadow-diff can't audit this (chrome legitimately changes every frame — the whole reason the
  # strip exists), so the audit lives HERE, at the policy: the single n=2→n=3 fixture above guarded ONE
  # shape; lock the meaningful-change shapes real dashes actually carry so a future strip-regex edit that
  # would freeze a mind fails loudly instead of shipping a silent System-0 blind spot. (Probed live
  # 2026-07-09: all six SURVIVE the current strip — this is a regression lock, not a bugfix.)
  s0(){ [ "$(printf '%s' "$1" | strip_volatile)" != "$(printf '%s' "$2" | strip_volatile)" ] \
        || { echo "smoke-test: FAIL (System-0 strip masked a real change — mind would freeze on: $3)"; exit 1; }; }
  s0 'posture=NOMINAL'   'posture=WATCH'              'posture flip'
  s0 'stranded=0'        'stranded=2'                 'stranded count'
  s0 'vitality: OK'      'vitality: DEGRADED'         'vitality label'
  s0 'heaps-β=0.718'     'heaps-β=0.719'              'score delta'
  s0 '  [idle] nothing'  '  [task] chat-review/foo'   'board task appears'
  s0 'burst=NONE'        'burst=BURST'                'tamper burst label'
  # DEAD-SHELL honesty (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): consume_once must
  # not claim "WOKE mind" when mesh-tell actually REFUSED (a shed pane, no mind engine) — check the
  # refusal against the real LOG file since consume_once has no return-value hook for its message.
  # mesh-tell stubbed as a shell function (bash resolves it before PATH) + mind_idle stubbed to skip the
  # real 2.5s double-capture wait — hermetic, no live tmux window needed.
  _pc_log="$(mktemp)"; LOG="$_pc_log"
  mind_idle(){ return 0; }
  mesh-tell(){ echo "mesh-tell: REFUSED — fake @ local is a bare shell (no mind engine), not a mind prompt: DEAD-SHELL	bare shell" >&2; return 1; }
  consume_once fakech 0; _pc_rc=$?
  [ "$_pc_rc" -ne 0 ] || { echo "smoke-test: FAIL (consume_once must return non-zero when mesh-tell refuses)"; exit 1; }
  grep -q 'REFUSED' "$_pc_log" || { echo "smoke-test: FAIL (a refused send must log REFUSED, got: $(cat "$_pc_log"))"; exit 1; }
  grep -q 'WOKE mind' "$_pc_log" && { echo "smoke-test: FAIL (a refused send must NOT also log the false WOKE claim: $(cat "$_pc_log"))"; exit 1; }
  # a NORMAL successful send still logs WOKE as before (falsify: swap the stub's rc/output above)
  : > "$_pc_log"
  mesh-tell(){ return 0; }
  consume_once fakech 0; _pc_rc2=$?
  [ "$_pc_rc2" -eq 0 ] || { echo "smoke-test: FAIL (a successful send should return 0)"; exit 1; }
  grep -q 'WOKE mind' "$_pc_log" || { echo "smoke-test: FAIL (a successful send must still log WOKE mind, got: $(cat "$_pc_log"))"; exit 1; }
  unset -f mind_idle mesh-tell; rm -f "$_pc_log"
  # ── DELIVER override (window-set-consolidation 2026-07-20): a merged-away channel's dash still wakes
  # a mind — the ABSORBING one. consume_once <src> <dry> <dst> must diff/name SRC's dash but deliver the
  # wake into DST's mind pane (vpn→health, bruno→room, models→discover). Assert the tell targets DST and
  # the wake message still names SRC's dash role (else the absorbing mind reads the wrong pane).
  _pc_log="$(mktemp)"; LOG="$_pc_log"
  mind_idle(){ return 0; }
  mesh-tell(){ echo "TOLD:$1 MSG:$2" >> "$_pc_log"; return 0; }
  consume_once srcch 0 dstch
  grep -q 'TOLD:dstch' "$_pc_log" || { echo "smoke-test: FAIL (deliver override: wake must be told into DST's mind pane, got: $(grep TOLD: "$_pc_log"))"; exit 1; }
  grep -q 'MSG:\[srcch consume\]' "$_pc_log" || { echo "smoke-test: FAIL (deliver override: wake msg must still name SRC's dash, got: $(grep TOLD: "$_pc_log"))"; exit 1; }
  # and the default (no 3rd arg) stays self-delivery — the non-merged channels must be unaffected
  : > "$_pc_log"
  consume_once solo 0
  grep -q 'TOLD:solo' "$_pc_log" || { echo "smoke-test: FAIL (deliver override: default self-delivery broke, got: $(grep TOLD: "$_pc_log"))"; exit 1; }
  unset -f mind_idle mesh-tell; rm -f "$_pc_log"
  # ── SMART / MIND-DEFINED wake diff (operator 2026-07-18 spec) ────────────────────────────────────
  # ALL smartness is in the reactor; the data pane is never touched. These assert the reactor's INTERNAL
  # filtered copy — sig_of on a frame — behaves right. RED against today's whole-pane hash: a latency-only
  # delta USED to change the sig and wake the mind (demonstrated live before this landed).
  # HERMETIC: point WAKE_RULE_DIR at an EMPTY temp dir so the smart-default cases below are isolated from
  # whatever live rules exist on this node (an installed ~/.mesh/wake-rule/vpn would otherwise route the
  # synthetic 'vpn' frames through rule mode and break these) — the wake-rule cases set their own dir.
  _wr_saved="$WAKE_RULE_DIR"; _wr_empty="$(mktemp -d)"; WAKE_RULE_DIR="$_wr_empty"
  # 1) SMART-DEFAULT: a telemetry-only delta (latency ms, handshake age, byte counter) → SAME sig → no wake.
  j1="$(printf 'egress OK · handshake 70s ago · latency 7.75ms · rx 1.2MB\n  clients: 2 active' | sig_of vpn)"
  j2="$(printf 'egress OK · handshake 1s ago · latency 8.13ms · rx 3.9MB\n  clients: 2 active' | sig_of vpn)"
  [ "$j1" = "$j2" ] || { echo "smoke-test: FAIL (smart-default: latency/byte JIGGLE changed the sig — mind still wakes on telemetry noise)"; exit 1; }
  # 2) SMART-DEFAULT: a DISCRETE verdict word flip (OK→DOWN) → DIFFERENT sig → WAKE.
  v1="$(printf 'egress OK · latency 7.75ms' | sig_of vpn)"
  v2="$(printf 'egress DOWN · latency 7.75ms' | sig_of vpn)"
  [ "$v1" != "$v2" ] || { echo "smoke-test: FAIL (smart-default: verdict OK→DOWN did not change the sig — mind would never wake on a real state change)"; exit 1; }
  # 3) SMART-DEFAULT: an INTEGER count change (peers=16→15) is meaningful → DIFFERENT sig → WAKE
  #    (only UNIT-bearing/float numerics are neutralized; a bare-integer count still wakes).
  c1="$(printf 'wg peers=16 · latency 7.75ms' | sig_of vpn)"
  c2="$(printf 'wg peers=15 · latency 8.90ms' | sig_of vpn)"
  [ "$c1" != "$c2" ] || { echo "smoke-test: FAIL (smart-default: an integer count peers=16→15 was masked — a real change would never wake)"; exit 1; }
  # 4) MIND-DEFINED wake-rule is actually CONSULTED (drive a temp MESH_WAKE_RULE_DIR): a change on a
  #    NON-matching line → NO wake; a change on a MATCHING line → WAKE.
  _wr_tmp="$(mktemp -d)"; WAKE_RULE_DIR="$_wr_tmp"
  printf 'egress=\nverdict=\n' > "$_wr_tmp/tst"   # this mind watches only egress=/verdict= lines
  n1="$(printf 'egress=OK\nnoise: latency 7.75ms\nbytes rx 12MB' | sig_of tst)"
  n2="$(printf 'egress=OK\nnoise: latency 8.13ms\nbytes rx 88MB' | sig_of tst)"
  [ "$n1" = "$n2" ] || { echo "smoke-test: FAIL (wake-rule: a change on a NON-matching line woke the mind — rule not restricting the hashed set)"; exit 1; }
  m1="$(printf 'egress=OK\nnoise: latency 7.75ms' | sig_of tst)"
  m2="$(printf 'egress=DOWN\nnoise: latency 7.75ms' | sig_of tst)"
  [ "$m1" != "$m2" ] || { echo "smoke-test: FAIL (wake-rule: a change on a MATCHING line did NOT wake — rule dropped the significant line)"; exit 1; }
  # 4b) leading '-' EXCLUDE pattern: a matching-exclude line's change must NOT wake even without includes.
  printf -- '-^drop:\n' > "$_wr_tmp/exc"
  x1="$(printf 'keep: state=UP\ndrop: latency 7.75ms' | sig_of exc)"
  x2="$(printf 'keep: state=UP\ndrop: latency 9.90ms' | sig_of exc)"
  [ "$x1" = "$x2" ] || { echo "smoke-test: FAIL (wake-rule exclude: a '-'-excluded line still woke the mind)"; exit 1; }
  x3="$(printf 'keep: state=DOWN\ndrop: latency 7.75ms' | sig_of exc)"
  [ "$x1" != "$x3" ] || { echo "smoke-test: FAIL (wake-rule exclude: a change on a KEPT line did not wake)"; exit 1; }
  # 4c) wake_mode reports the layer honestly (a rule file → 'rule'; none → 'smart-default').
  [ "$(wake_mode tst)" = rule ] || { echo "smoke-test: FAIL (wake_mode must report 'rule' when a rule file exists)"; exit 1; }
  [ "$(wake_mode nope-no-rule)" = smart-default ] || { echo "smoke-test: FAIL (wake_mode must report 'smart-default' with no rule file)"; exit 1; }
  WAKE_RULE_DIR="$_wr_saved"; rm -rf "$_wr_tmp" "$_wr_empty"
  unset -f mind_idle mesh-tell 2>/dev/null || true
  # ── PREDICTIVE wake gate (operator 2026-07-23 "predict next top pane state, wake only on mismatch").
  # Hermetic: temp expect dir; frames fed directly. Every branch of the fail-toward-waking contract is
  # asserted — the irreversible failure here is a mind that SLEEPS through a real change.
  _we_saved="${WAKE_EXPECT_DIR}"; _we_tmp="$(mktemp -d)"; WAKE_EXPECT_DIR="$_we_tmp"
  _now="$(date +%s)"
  # 5) expect_fresh: absent → stale; no expires header → stale; expired → stale; future → fresh.
  expect_fresh nofile && { echo "smoke-test: FAIL (expect_fresh: absent file must read stale)"; exit 1; }
  printf 'somepattern\n' > "$_we_tmp/hdrless"
  expect_fresh hdrless && { echo "smoke-test: FAIL (expect_fresh: a file without '# expires:' must read stale — never trust an unbounded prediction)"; exit 1; }
  printf '# expires: %s\nsomepattern\n' "$((_now - 10))" > "$_we_tmp/old"
  expect_fresh old && { echo "smoke-test: FAIL (expect_fresh: an EXPIRED expectation must read stale)"; exit 1; }
  printf '# expires: %s\nsomepattern\n' "$((_now + 600))" > "$_we_tmp/live"
  expect_fresh live || { echo "smoke-test: FAIL (expect_fresh: a future-expiry expectation must read fresh)"; exit 1; }
  # 6) surprise_of: a fully-PREDICTED change → empty; an UNPREDICTED line → surfaced; a BROKEN regex →
  #    every changed line is a surprise (fail toward waking, never toward sleeping).
  printf '# expires: %s\n^queue depth [0-9]+$\n' "$((_now + 600))" > "$_we_tmp/pch"
  _p=$'state=UP\nqueue depth 4'
  _c1=$'state=UP\nqueue depth 9'
  _c2=$'state=DOWN\nqueue depth 9'
  s="$(surprise_of pch "$_p" "$_c1")"
  [ -z "$s" ] || { echo "smoke-test: FAIL (surprise_of: a fully-predicted change must be empty, got: $s)"; exit 1; }
  s="$(surprise_of pch "$_p" "$_c2")"
  printf '%s' "$s" | grep -q 'state=DOWN' || { echo "smoke-test: FAIL (surprise_of: the unpredicted state=DOWN line must surface, got: $s)"; exit 1; }
  printf '# expires: %s\n[broken(\n' "$((_now + 600))" > "$_we_tmp/bad"
  s="$(surprise_of bad "$_p" "$_c1")"
  [ -n "$s" ] || { echo "smoke-test: FAIL (surprise_of: a broken pattern must fail TOWARD WAKING — all changed lines out, got empty)"; exit 1; }
  # 7) gate_decision: HOLD under cap → WAKE:deaf at cap; WAKE:surprise on mismatch; WAKE:plain with no
  #    expectation or no previous frame (first pass / --once).
  d="$(gate_decision pch "$_p" "$_c1" 0)"
  [ "$d" = HOLD ] || { echo "smoke-test: FAIL (gate_decision: predicted change under cap must HOLD, got: $d)"; exit 1; }
  d="$(gate_decision pch "$_p" "$_c1" "$DEAF_CAP")"
  [ "$d" = WAKE:deaf ] || { echo "smoke-test: FAIL (gate_decision: at $DEAF_CAP consecutive holds the deaf-guard must wake, got: $d)"; exit 1; }
  d="$(gate_decision pch "$_p" "$_c2" 0)"
  case "$d" in WAKE:surprise:*) : ;; *) echo "smoke-test: FAIL (gate_decision: an unpredicted line must WAKE:surprise, got: $d)"; exit 1;; esac
  d="$(gate_decision noexpect "$_p" "$_c1" 0)"
  [ "$d" = WAKE:plain ] || { echo "smoke-test: FAIL (gate_decision: no expectation must fall back to the plain change-gate, got: $d)"; exit 1; }
  d="$(gate_decision pch "" "$_c1" 0)"
  [ "$d" = WAKE:plain ] || { echo "smoke-test: FAIL (gate_decision: no previous frame (first pass) must WAKE:plain, got: $d)"; exit 1; }
  # 8) the wake message must TEACH the reflex — name mesh-wake-expect so every engine learns to predict.
  case "$(wake_msg senses)" in *"mesh-wake-expect senses"*) : ;; *) echo "smoke-test: FAIL (wake msg must name mesh-wake-expect <chan> — the predictive reflex is mesh doctrine, taught on every wake)"; exit 1;; esac
  WAKE_EXPECT_DIR="$_we_saved"; rm -rf "$_we_tmp"
  echo "smoke-test: ok (diff-gated wake; chrome stripped so panes quiet; real deltas still wake; mind owns the filter + DEAD-SHELL: a refused mesh-tell send logs REFUSED not a false WOKE claim + SMART-DEFAULT neutralizes telemetry jiggle, keeps discrete/integer changes + MIND-DEFINED wake-rule consulted, include/exclude compose + PREDICTIVE gate: predicted changes hold, surprises/expiry/broken-pattern/deaf-guard all wake)"; exit 0
fi

if [ "${1:-}" = --expect-check ]; then   # cross-tool contract probe (mesh-wake-expect --test drives it)
  ch="${2:?usage: mesh-pane-consume --expect-check <channel>}"
  if expect_fresh "$ch"; then echo "fresh"; exit 0; else echo "stale-or-absent"; exit 1; fi
fi

ch="${1:?usage: mesh-pane-consume <channel> [--interval N] [--once] [--dry] [--deliver <win>]}"; shift || true
INTERVAL=60; ONCE=0; DRY=0; DELIVER=""
while [ $# -gt 0 ]; do case "$1" in
  --interval) INTERVAL="$2"; shift 2 ;;
  --once) ONCE=1; shift ;;
  --dry) DRY=1; shift ;;
  --deliver) DELIVER="$2"; shift 2 ;;   # wake THIS window's mind instead of $ch's (merged channels)
  *) echo "mesh-pane-consume: unknown arg '$1'" >&2; exit 1 ;;
esac; done

tmux has-session -t "$S" 2>/dev/null || { echo "mesh-pane-consume: no tmux session '$S'" >&2; exit 1; }
tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$ch" || { echo "mesh-pane-consume: no window '$ch'" >&2; exit 1; }

if [ "$ONCE" = 1 ]; then consume_once "$ch" "$DRY" "${DELIVER:-$ch}"; exit 0; fi
echo "$(ts) consume start ch=$ch interval=${INTERVAL}s dry=$DRY (diff-gated, predictive)" >> "$LOG"
# DIFF-GATED + PREDICTIVE loop: re-invite the mind ONLY when the data pane's normalized signature
# changed AND the change is not fully covered by the mind's own expectation (gate_decision above).
# First pass always wakes (baseline / spawn-moment read). prev_sig/prev_frame advance when consume_once
# delivered (idle+woke / dry-idle) — if the mind was BUSY, keep them so the pending change is retried
# next pass instead of silently dropped. A HOLD also advances them (the change is accounted for by the
# prediction) and bumps the deaf-guard counter; any wake resets it.
prev_sig=""; prev_frame=""; supp=0
while :; do
  cur_frame="$(pane_norm "$ch")"
  cur_sig="$(printf '%s\n' "$cur_frame" | sha1sum | awk '{print $1}')"
  if [ "$cur_sig" != "$prev_sig" ]; then
    verdict="$(gate_decision "$ch" "$prev_frame" "$cur_frame" "$supp")"
    case "$verdict" in
      HOLD)
        supp=$((supp+1)); prev_sig="$cur_sig"; prev_frame="$cur_frame"
        echo "$(ts) $ch: change fully PREDICTED — wake held (expect-gate, $supp/$DEAF_CAP consecutive holds)" >> "$LOG"
        sleep "$INTERVAL"; continue ;;
      WAKE:deaf)
        echo "$(ts) $ch: deaf-guard — $supp consecutive predicted holds, waking anyway [$(wake_mode "$ch")]" >> "$LOG" ;;
      WAKE:surprise:*)
        echo "$(ts) $ch: SURPRISE (${verdict##*:} unpredicted line(s)) [$(wake_mode "$ch")] — waking" >> "$LOG" ;;
      *)
        echo "$(ts) $ch: change detected [$(wake_mode "$ch")] — waking" >> "$LOG" ;;
    esac
    if consume_once "$ch" "$DRY" "${DELIVER:-$ch}"; then prev_sig="$cur_sig"; prev_frame="$cur_frame"; supp=0; fi
  else
    echo "$(ts) $ch: pane unchanged — no wake (droplet held)" >> "$LOG"
  fi
  sleep "$INTERVAL"
done
