#!/usr/bin/env bash
# orphan-ok: on-demand file check invoked by tests/CI with a path argument, never scheduled.
# mesh-receipt-gate — deterministic landability gate for task receipts.
#
# A receipt file is landable only if it names a state change, a measurement,
# or a failure with a retry edge. "Looked, PASS, nothing changed" is a ledger
# line, not a file.
#
#   mesh-receipt-gate <file> [...]   check one or more files
#   mesh-receipt-gate --test         self-test (fixtures)
#
# Exit: 0 all landable · 1 at least one HOLD · 2 not-a-receipt-path / usage.
set -uo pipefail
REPO="${MESH_REPO:-$HOME/lte-workstation}"
MAX_BYTES="${MESH_RECEIPT_MAX_BYTES:-8192}"

is_receipt_path(){
  case "${1#"$REPO"/}" in
    task-receipts/*|docs/task-receipts/*) return 0 ;;
  esac
  case "$1" in
    */task-receipts/*|*/docs/task-receipts/*) return 0 ;;
  esac
  return 1
}

gate_one(){
  local f="$1" rel body
  rel="${f#"$REPO"/}"
  is_receipt_path "$f" || { echo "SKIP not-a-receipt-path: $rel"; return 2; }
  [ -f "$f" ] || { echo "HOLD missing-file: $rel"; return 1; }
  local size; size="$(wc -c < "$f" 2>/dev/null || echo 0)"
  [ "$size" -le "$MAX_BYTES" ] || { echo "HOLD oversize ${size}B>${MAX_BYTES}B: $rel — split or roll up, not a new file"; return 1; }
  body="$(cat "$f")"
  grep -qiE '^[[:space:]#*>-]*[*_]*[[:space:]]*(task|chain)[[:space:]]*:' <<<"$body" \
    || { echo "HOLD no-identity: $rel — no Task: line, nothing to settle against"; return 1; }
  local has_artifact=1 has_measure=1 has_failure=1
  grep -qiE 'artifact|evidence|commit|landed|fixed|repaired|changed-to|moved|sha256' <<<"$body" && has_artifact=0
  grep -qiE 'measured|captured|observed|timed|bench|wall-clock|rtf|count|rate|pct|%|ms|s |sec|bytes' <<<"$body" && has_measure=0
  grep -qiE 'failure|blocked|blind|unknown|retry|next|follow-?up|repro|rollback' <<<"$body" && has_failure=0
  # stale-triage class: filename says triage, body says nothing happened
  if [[ "$(basename "$f")" == *triage* ]] && grep -qiE 'stale|already DONE|no .*changed|nothing changed|no action|no .* justified' <<<"$body"; then
    if [ "$has_artifact" != 0 ]; then
      echo "HOLD use-rollup: $rel — stale triage with no artifact belongs in the chronic rollup / ledger line, not a new file"
      return 1
    fi
  fi
  # no-change veto: body declares nothing changed and carries no artifact+measurement
  if grep -qiE 'no .*changed|nothing changed|no action taken|no state changed' <<<"$body" \
    && { [ "$has_artifact" != 0 ] || [ "$has_measure" != 0 ]; }; then
    echo "HOLD proof-of-work-only: $rel — declares no change and names no working artifact; close with a ledger line"
    return 1
  fi
  if [ "$has_artifact" != 0 ] && [ "$has_measure" != 0 ] && [ "$has_failure" != 0 ]; then
    echo "HOLD proof-of-work-only: $rel — no artifact, measurement, or failure+retry edge found"
    return 1
  fi
  echo "PASS: $rel"
  return 0
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  mkdir -p "$d/task-receipts"
  cat > "$d/task-receipts/good.md" <<'EOF'
# Fix — 2026-09-16

Task: `demo/fix`
Artifact: scripts/mesh-demo (commit abc123, landed)
Measured: wall-clock 12.5s over 3 runs, error rate 0%.
EOF
  cat > "$d/task-receipts/stale.md" <<'EOF'
# Health-warning triage — 2026-09-15

Task: `health-warning/f400f1983d2a35a7d257/triage`

The warning was stale. The prerequisite is already DONE.
No state changed. No action taken.
EOF
  cat > "$d/task-receipts/noid.md" <<'EOF'
# Notes

Just some observations, PASS everywhere.
EOF
  pass=0; fail=0
  MESH_REPO="$d" gate_one "$d/task-receipts/good.md" >/dev/null && pass=$((pass+1)) || { echo "FAIL: good receipt must PASS"; fail=$((fail+1)); }
  out="$(MESH_REPO="$d" gate_one "$d/task-receipts/stale.md" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q HOLD <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: stale triage must HOLD (rc=$rc: $out)"; fail=$((fail+1)); }
  MESH_REPO="$d" gate_one "$d/task-receipts/noid.md" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: no-identity must HOLD"; fail=$((fail+1)); }
  MESH_REPO="$d" gate_one "$d/scripts/mesh-foo" >/dev/null 2>&1; [ $? = 2 ] && pass=$((pass+1)) || { echo "FAIL: non-receipt must SKIP rc=2"; fail=$((fail+1)); }
  printf 'x' > "$d/task-receipts/big.md"; { for _ in $(seq 1 9000); do printf 'x'; done >> "$d/task-receipts/big.md"; }
  printf '\nTask: `demo/big`\n' >> "$d/task-receipts/big.md"
  MESH_REPO="$d" gate_one "$d/task-receipts/big.md" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: oversize must HOLD"; fail=$((fail+1)); }
  echo "mesh-receipt-gate --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]
  exit $?
fi

[ $# -ge 1 ] || { echo "usage: mesh-receipt-gate <file> [...] | --test" >&2; exit 2; }
overall=0
for f in "$@"; do
  gate_one "$f" || { rc=$?; [ "$rc" = 1 ] && overall=1; [ "$rc" = 2 ] && [ "$overall" = 0 ] && overall=2; }
done
exit "$overall"
