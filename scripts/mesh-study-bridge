#!/usr/bin/env bash
# reflex-cadence: 41 */4 * * *
# mesh-study-bridge — CLOSE THE RESEARCH LOOP. The study channel (mesh-study) fetches recent
# discourse on a field and stamps it to ~/.mesh/study.log — but it ENDED there: read, never tried
# (operator 2026-06-21: "literature reviews end as nothing but a review"). This bridges study →
# the autonomous work queue.
#
# For the newest un-bridged study brief it distills ONE concrete, worker-doable EXPERIMENT for THIS
# mesh — via mesh-relay (free inference pool, no claude quota burn) — and appends it to the
# ideas-queue as a `[ ] STUDY(<field>)` idea. From there the existing loop carries it the rest of the
# way:  ideas-queue --(mesh-generate)--> backlog --(mesh-feed)--> idle mind --> tries it, leaves
# changes in the tree --> [done] --(mesh-queue-tend)--> [x]. A review now ENDS IN AN ATTEMPT.
#
#   mesh-study-bridge          distill + queue the next un-bridged study brief
#   mesh-study-bridge --dry    print what it WOULD queue; write nothing
#   mesh-study-bridge --list   show which study briefs are bridged / pending
#   mesh-study-bridge --test   smoke test (hermetic; stubs the distiller, no network) — asserts the PARSER
#   mesh-study-bridge --gate-live  drive the REAL distiller against both arms — asserts the DECISION.
#                                  Run it whenever you touch DPROMPT; --test cannot see that half.
#
# Idempotent: each study brief is bridged at most once (~/.mesh/.study-bridged), keyed by BOTH its
# timestamp AND a content hash of its field+items — so a same-topic brief re-emitted under a new ts
# (mesh-study cycles topics) is NOT re-bridged unless its discourse genuinely changed (novelty gate).
# Also: one OPEN study idea per field at a time (no pile-up); exact-duplicate task text is skipped.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; SLOG="$MESH/study.log"; Q="$MESH/ideas-queue"
SEEN="$MESH/.study-bridged"; LOG="$MESH/study-bridge.log"
ts(){ date -u +%FT%TZ; }

# The distiller is overridable so --test can run it hermetically (no network). In production it is
# mesh-relay: text -> cheapest available FREE pool -> text. Read-only, never burns claude quota.
DISTILL_CMD="${MESH_BRIDGE_DISTILL_CMD:-mesh-relay}"

# Pick the newest study.log brief that (a) has real items and (b) isn't already bridged. Emits
# four lines: TS / CKEY / FIELD / then the item block, or nothing. Append-only log → newest block last.
# CKEY ("sha:<hash of field+items>") is the NOVELTY key: mesh-study cycles the same few topics, so a
# later brief on the SAME topic+items carries a NEW timestamp — keying only on ts would re-bridge it
# (re-distill + re-queue = churn, evergreen-repromotion class; discover dogfooded this 2026-06-27).
# Skipping on the content hash too means a topic re-bridges only when its discourse genuinely changed.
pick_brief_py='
import sys, hashlib, datetime
seen=set()
try:
    seen=set(l.strip() for l in open(sys.argv[2]) if l.strip())
except Exception:
    pass
active=set(sys.argv[3:])
blocks=[]
cur=None
for raw in open(sys.argv[1]):
    line=raw.rstrip("\n")
    if line.startswith("=== study: ") and line.endswith("==="):
        if cur: blocks.append(cur)
        # "=== study: <field> (<ts>) ==="
        body=line[len("=== study: "):-len(" ===")].strip()
        field=body; tsv=""
        if body.endswith(")") and "(" in body:
            field=body[:body.rfind("(")].strip()
            tsv=body[body.rfind("(")+1:-1].strip()
        cur={"field":field,"ts":tsv,"items":[]}
    elif cur is not None and line.startswith("- "):
        cur["items"].append(line)
if cur: blocks.append(cur)
for b in reversed(blocks):                       # newest-first
    if not b["items"]: continue                  # empty brief — nothing to distill
    if b["ts"] and b["ts"] in seen: continue     # already bridged (legacy ts-key, back-compat)
    ckey="sha:"+hashlib.sha1("\n".join([b["field"]]+b["items"]).encode()).hexdigest()[:16]
    if ckey in seen: continue                    # same topic+items already bridged (novelty gate)
    if b["field"] in active:
        now=datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
        fld=b["field"]
        ts=b["ts"]
        print(f"{now} DEFER field={fld} ts={ts} — an open STUDY({fld}) idea already exists; deferring brief", file=sys.stderr)
        continue
    print(b["ts"]); print(ckey); print(b["field"])
    for it in b["items"]: print(it)
    break
'

read_brief(){ python3 -c "$pick_brief_py" "$SLOG" "$SEEN" "$@"; }

# THE DECISION MUST BE A FIELD, NOT AN ESCAPE CLAUSE (2026-07-16).
# The old prompt said "Propose ONE concrete, SMALL experiment ... If nothing here genuinely applies,
# reply EXACTLY: SKIP" — one trailing clause after a compliance-demanding imperative. The model never
# DECIDED; it just complied, every time. Driven against a wholly inapplicable field (18th-century
# Baroque oboe reed making), the old prompt returned a task 3/3 — one of them "Measure and use a fixed
# value instead of a magic number for crow pitch calculation", i.e. it proposed we implement oboe reed
# acoustics in the mesh. In production the same shape queued "incremental build cache for Rust on GHA"
# under FIELD=Raft/consensus. The hatch was not reluctant, it was UNREACHABLE: 0 SKIP in the tool's
# entire history (3 QUEUED / 0 SKIP), and health's independent control (n=3, byte-identical live
# prompt, inapplicable field) reproduced it.
# Fix: make the verdict a REQUIRED, SEPARATE output field the model must commit to BEFORE writing the
# task, and name the failure mode (a shared word is not a connection) — the exact way `query=Raft`
# dissolves into Egyptian-Afterlife noise upstream in mesh-study.
#
# WHAT IT ACTUALLY BUYS, MEASURED (2026-07-16, groq llama-3.1-8b-instant = the pool mesh-relay picks;
# oboe arm, n=23 across 3 batches): it reads NO in **16 of 23** runs (~70%) vs the old prompt's
# **0 of 14** (8 driven here + 3 + health's independent n=3). A 0→70% shift no sampling story explains
# away: the fix is REAL. Everything else about the old "3/3 NO" claim was wrong.
# THE NUMBER IS A COIN, AND THE BATCHES DISAGREE: 1/3, then 8/12, then 7/8 — same code, same pool,
# same hour. The 3/3 this comment claimed until now was one n=3 sample of that coin, and it did not
# survive the very next run of the gate asserting it (1/3, which is why the gate FAILED on a prompt
# that was fine). Never read one batch as the rate; a single clean run of a stochastic gate is a draw,
# not a proof. Stamp n, pool and date on any number you replace this with.
# SO THE HATCH IS A DICE ROLL PER BRIEF, NOT A DOOR THAT CLOSES: ~3 in 10 inapplicable briefs still
# queue a task, and when the 8B fails it fails by INVENTING the connection — "implement a gouge
# function to trim canes to a specified thickness in our mesh's woodworking" (run 9/12), the same
# reflex as the original bug. Downstream must keep treating a queued STUDY idea as UNVETTED; this
# prompt lowers the junk rate, it does not make the queue trustworthy. Raising it is a real open lane
# (a stronger pool for this one call — but the free deepseek pool answered EMPTY when driven directly,
# so pinning one is not free).
# Any edit here MUST be re-driven against BOTH arms: `mesh-study-bridge --gate-live`. A prompt that
# only SKIPs is as broken as one that never does.
# NOTE: this prompt is a printf FORMAT string — keep it free of stray '%'.
DPROMPT='You are the engineer of a small self-hosted autonomous agent mesh (bash mesh-* tools in a
git repo; nodes coordinate over tmux + a text board; free LLM inference via a relay). Below are
recent article titles harvested for a field we track. The harvest is keyword-based and sometimes
dissolves: a brief may be off-topic noise wearing the field name.

FIRST decide, THEN write. Answer in exactly two lines and nothing else:
APPLIES: YES or NO
TASK: <one line, or empty if NO>

APPLIES is NO when the items are from a different domain, or are generic tech news carrying no
mechanism transferable to a self-hosted agent mesh. Do not invent a connection — if the only link
is a shared word, that is NO. NO is a correct, expected answer; a forced task is worse than none.

If APPLIES is YES, TASK is ONE concrete SMALL experiment to try in OUR codebase that borrows the
single most useful idea here — imperative, <= 28 words, no markdown, no quotes; a change one worker
can do in a sitting, needing NO operator action, NO new paid accounts, NO external hardware.

FIELD: %s
RECENT ITEMS:
%s'

# Parse the distiller reply into VERDICT (YES|NO|"") + TASK. A real model does NOT emit the one
# byte-exact token a stub does: the live relay returned "APPLIES: NO  " (trailing whitespace) on the
# very first control run. The OLD code tested `[ "$task" = SKIP ]` against a head-1'd line — so of the
# shapes a model actually reaches for, ONLY bare `SKIP` was honoured: `SKIP.` `**SKIP**` `Answer: SKIP`
# and `SKIP — nothing applies` each fell through and were QUEUED AS THE IDEA TEXT ("[ ] STUDY(x): SKIP.")
# to be handed to a worker. And --test drove the SKIP path with `echo SKIP` — the single string that
# worked — so the gate could never see it. Tolerate the mess: markdown, case, trailing punctuation.
# Take the FIRST bare YES/NO token of the value, not the whole scrubbed value: "APPLIES: NO (off-topic)"
# must read NO. \b keeps "NOT APPLICABLE" from reading as NO — that yields no verdict, which is MALFORMED
# (retry, loud), and an unparseable verdict must never silently become one of the two real answers.
parse_verdict(){ printf '%s\n' "$1" | grep -aiE '^[[:space:]]*\**[[:space:]]*APPLIES\**[[:space:]]*:' | head -1 \
  | sed -E 's/^[^:]*:[[:space:]]*//' | tr '[:lower:]' '[:upper:]' | grep -oaE '\b(YES|NO)\b' | head -1; }
parse_task(){ printf '%s\n' "$1" | grep -aiE '^[[:space:]]*\**[[:space:]]*TASK\**[[:space:]]*:' | head -1 \
  | sed -E 's/^[^:]*:[[:space:]]*//' | sed 's/^[-*0-9.[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//; s/[[:space:]]*$//' | head -c 240; }

# ---- subcommands -------------------------------------------------------------------------------
if [ "${1:-}" = --test ]; then
  for d in python3 grep sed flock; do command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($d missing)"; exit 1; }; done
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh"
  cat > "$tmp/.mesh/study.log" <<'EOF'

=== study: crdt (2026-06-12T12:52:59Z) ===
(source: https://example/crdt)
- CRDT: Conflict-free replicated data type  [229pts]  https://en.wikipedia.org/wiki/CRDT
- Practical Demystification of CRDT  [1pts]  http://nami.me/crdt

=== study: empty-field (2026-06-12T13:00:00Z) ===
(source: https://example/empty)
(awaiting a mind to distill -> what to try)
EOF
  : > "$tmp/.mesh/ideas-queue"
  # Stub distiller: deterministic, no network — proves the full distill->queue->dedup path.
  # It speaks the REAL two-field protocol. This test asserts the PARSER; it cannot assert the
  # DECISION (whether a live model ever answers NO) — no stub can, since the stub IS the answer.
  # That half is `--gate-live`, which drives the real relay against both arms. Keep them separate:
  # autowire gates --test under `timeout 30`, and a network-dependent --test would either blow that
  # budget (exit 124 → silently never wired) or go flaky.
  stub="$tmp/distill.sh"; printf '#!/usr/bin/env bash\nprintf "APPLIES: YES\\nTASK: make mesh-chat.log merges last-write-wins-free by tagging each line with node+epoch so two boards converge\\n"\n' > "$stub"; chmod +x "$stub"
  out=$(HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" 2>&1) || { echo "smoke-test: FAIL (bridge run errored: $out)"; exit 1; }
  # the newest NON-empty brief is crdt (the empty-field block has no items → must be skipped)
  grep -qE '^\[ \] STUDY\(crdt\):' "$tmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (no STUDY(crdt) idea queued)"; exit 1; }
  grep -q '2026-06-12T12:52:59Z' "$tmp/.mesh/.study-bridged" || { echo "smoke-test: FAIL (bridged-ts not recorded → would re-queue forever)"; exit 1; }
  # idempotency: a 2nd run must NOT add a duplicate (same brief already bridged)
  before=$(grep -c 'STUDY(crdt)' "$tmp/.mesh/ideas-queue")
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" >/dev/null 2>&1 || true
  after=$(grep -c 'STUDY(crdt)' "$tmp/.mesh/ideas-queue")
  [ "$before" = "$after" ] || { echo "smoke-test: FAIL (re-queued an already-bridged brief: $before -> $after)"; exit 1; }
  # SKIP handling: a distiller that says SKIP records the ts (no retry storm) but queues nothing
  cat >> "$tmp/.mesh/study.log" <<'EOF'

=== study: noise (2026-06-12T14:00:00Z) ===
(source: https://example/noise)
- Ten reasons your standup meeting is broken  [3pts]  https://example/standup
EOF
  skip="$tmp/skip.sh"; printf '#!/usr/bin/env bash\nprintf "APPLIES: NO\\nTASK:\\n"\n' > "$skip"; chmod +x "$skip"
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$skip" bash "$0" >/dev/null 2>&1 || true
  grep -q '2026-06-12T14:00:00Z' "$tmp/.mesh/.study-bridged" || { echo "smoke-test: FAIL (SKIP brief not marked → retry storm)"; exit 1; }
  grep -q 'STUDY(noise)' "$tmp/.mesh/ideas-queue" && { echo "smoke-test: FAIL (SKIP brief should queue nothing)"; exit 1; }

  # THE SHAPES A REAL MODEL EMITS. The old test drove this path with `echo SKIP` — the ONE string the
  # old exact-match `[ "$task" = SKIP ]` honoured — so it passed while every neighbouring shape was
  # queued as the idea TEXT and handed to a worker ("[ ] STUDY(noise): SKIP."). The live relay's very
  # first control reply was "APPLIES: NO  ", trailing whitespace and all. Each shape below gets a
  # FRESH home: a decline must decline on its own run, never by reading a previous run's artifact.
  decline_shape(){ # $1=label  $2=reply-literal  -> asserts: nothing queued, brief marked
    local h="$tmp/shape-$1"; mkdir -p "$h/.mesh"
    printf '\n=== study: noise (2026-06-12T14:00:00Z) ===\n- Ten reasons your standup meeting is broken  [3pts]  https://example/standup\n' > "$h/.mesh/study.log"
    : > "$h/.mesh/ideas-queue"
    local s="$h/d.sh"; { printf '#!/usr/bin/env bash\n'; printf 'cat <<%s\n%s\n%s\n' "'XEOFX'" "$2" "XEOFX"; } > "$s"; chmod +x "$s"
    HOME="$h" MESH_BRIDGE_DISTILL_CMD="$s" bash "$0" >/dev/null 2>&1 || true
    grep -q 'STUDY(noise)' "$h/.mesh/ideas-queue" && { echo "smoke-test: FAIL (decline shape '$1' was QUEUED AS AN IDEA — a worker would be handed it: $(grep 'STUDY(noise)' "$h/.mesh/ideas-queue" | head -c 90))"; exit 1; }
    grep -q '2026-06-12T14:00:00Z' "$h/.mesh/.study-bridged" || { echo "smoke-test: FAIL (decline shape '$1' not marked → re-distills the same dead brief forever)"; exit 1; }
    return 0
  }
  decline_shape trailing-ws 'APPLIES: NO  '            # the shape the live relay actually returned
  decline_shape markdown    '**APPLIES:** **NO**'
  decline_shape reasoned    'APPLIES: NO (different domain; only a shared word)'
  decline_shape lowercase   'applies: no'
  decline_shape legacy-skip 'SKIP.'                    # old protocol + the punctuation that broke it

  # MALFORMED: no verdict field = no decision. Must NOT queue (unjudged work is the bug we removed)
  # and must NOT mark (a non-answer may not burn the brief) — it retries, loudly, in the log.
  mh="$tmp/malformed"; mkdir -p "$mh/.mesh"
  printf '\n=== study: noise (2026-06-12T14:00:00Z) ===\n- Ten reasons your standup meeting is broken  [3pts]  https://example/standup\n' > "$mh/.mesh/study.log"
  : > "$mh/.mesh/ideas-queue"
  # The fixture MUST carry a TASK the bug could queue. A no-verdict/no-task reply is caught by the
  # empty-TASK guard below instead, so it asserts nothing about THIS guard: with the verdict check
  # deleted it still passed (mutation-tested 2026-07-16). A verdict-less reply that DOES name a task
  # is the shape that reaches the queue — unjudged work, which is the whole bug.
  mstub="$mh/d.sh"; printf '#!/usr/bin/env bash\necho "TASK: rewrite the board in Rust"\n' > "$mstub"; chmod +x "$mstub"
  HOME="$mh" MESH_BRIDGE_DISTILL_CMD="$mstub" bash "$0" >/dev/null 2>&1 || true
  grep -q 'STUDY(noise)' "$mh/.mesh/ideas-queue" && { echo "smoke-test: FAIL (a reply with no APPLIES verdict was queued — that is unjudged work, the original bug)"; exit 1; }
  grep -q '2026-06-12T14:00:00Z' "$mh/.mesh/.study-bridged" && { echo "smoke-test: FAIL (malformed reply marked the brief bridged → a non-answer burns the brief)"; exit 1; }
  grep -q 'MALFORMED' "$mh/.mesh/study-bridge.log" || { echo "smoke-test: FAIL (malformed reply left no MALFORMED log line → a silent fallback)"; exit 1; }
  # NOVELTY GATE (discover 2026-06-27): mesh-study cycles the same topics, so a LATER brief on the
  # SAME topic+items arrives under a NEW timestamp. Keying only on ts would re-distill + re-queue it
  # (churn) — even after the prior idea COMPLETED (field-guard no longer blocks). The content-hash
  # must catch it. Re-emit the crdt brief verbatim under a new ts with the queue cleared (idea done):
  : > "$tmp/.mesh/ideas-queue"
  cat >> "$tmp/.mesh/study.log" <<'EOF'

=== study: crdt (2026-06-28T09:00:00Z) ===
(source: https://example/crdt)
- CRDT: Conflict-free replicated data type  [229pts]  https://en.wikipedia.org/wiki/CRDT
- Practical Demystification of CRDT  [1pts]  http://nami.me/crdt
EOF
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" >/dev/null 2>&1 || true
  grep -qE '^\[ \] STUDY\(crdt\):' "$tmp/.mesh/ideas-queue" && { echo "smoke-test: FAIL (re-bridged a same-topic+items brief under a new ts → churn; novelty-gate not catching it)"; exit 1; }
  # but a same topic with GENUINELY NEW items (new content hash) MUST still bridge:
  cat >> "$tmp/.mesh/study.log" <<'EOF'

=== study: crdt (2026-06-28T10:00:00Z) ===
(source: https://example/crdt)
- Automerge 3.0: a new CRDT storage format  [402pts]  https://example/automerge3
EOF
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" >/dev/null 2>&1 || true
  grep -qE '^\[ \] STUDY\(crdt\):' "$tmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (a same-topic brief with NEW items did not bridge → novelty-gate too greedy, blocks real new discourse)"; exit 1; }
  echo "smoke-test: ok (parser: distilled+queued; empty skipped; idempotent; 5 real decline shapes marked-not-queued; no-verdict reply refused+logged; novelty gate both ways). DECISION half = --gate-live"
  exit 0
fi

# --gate-live — the half --test CANNOT assert. A stub cannot tell you whether a live model ever
# ANSWERS no; the stub IS the answer. So this drives the REAL distiller against two pinned fixtures
# and demands the verdict split:
#   SKIP arm  (18th-century Baroque oboe reed making) must read NO often enough — this is the control
#             that caught the original bug. The old prompt returned a task 3/3 here, once proposing we
#             implement oboe crow-pitch calculation in the mesh.
#   APPLY arm (self-healing systems — a real production brief, 100% on-topic) must read YES. Without
#             it a "fix" that simply SKIPs everything scores perfectly on the SKIP arm alone. A prompt
#             that always declines is as broken as one that never does; both arms or neither.
#
# THIS GATE ASSERTS A RATE, SO ITS THRESHOLD IS A STATISTIC, NOT A TASTE. The verdict is a ~0.6 coin
# (see DPROMPT), and the gate's first shape — majority of n=3 — would have FAILED a healthy prompt 31%
# of the time. It did, immediately, on the run after the one that "proved" the fix: 3/3 then 1/3, same
# code, same pool. A gate that flakes a third of the time teaches you to re-run it until it agrees.
# So it is calibrated as a REGRESSION detector, not a quality bar: at n=8, "≥3 NO" passes the measured
# prompt (p≈0.60) 95% of the time and the old escape-clause prompt (p≈0, 0/6 observed) 0.04% of the
# time. It answers "did the hatch stop firing", which is the failure it exists to catch. It does NOT
# certify the rate is good — 3/8 is a floor far below the ~60% we measure. If you improve the prompt,
# RE-MEASURE (n>=12) and raise both the comment and this floor; do not read a pass as "60% held".
# NOT in --test on purpose: mesh-autowire gates --test under `timeout 30`, and 16 relay calls blow it
# (exit 124 reads as "refuse to wire a broken reflex" → silently never wired). It is also network-
# dependent, and a flaky gate on the landing path gets routed around. Run it by hand when you touch
# DPROMPT. Exit 2 = honest n/a (no relay pool reachable) — never a fake green.
if [ "${1:-}" = --gate-live ]; then
  N="${MESH_BRIDGE_GATE_N:-8}"
  gate_oboe='- The Baroque oboe reed: gouging cane to 0.58mm  [12pts]  https://example/gouge
- A history of Viennese reed knives, 1740-1810  [3pts]  https://example/knives
- Why staple length changes the crow pitch  [7pts]  https://example/crow'
  gate_apply='- Show HN: Darnlink – self-healing Markdown links that survive refactors (by UUID)  [1pts]  https://github.com/txemi/darnlink
- 9lives – Self-healing test runner that refuses to mask real bugs  [1pts]  https://github.com/Quality-Max/9lives
- Show HN: Self-healing review gate and knowledge base for Claude Code (Beta)  [5pts]  https://verity.md
- Cadreen – memory, governance, self-healing, and execution as one system  [5pts]  https://news.ycombinator.com/item?id=48780219'
  probe="$("$DISTILL_CMD" 'Reply with the single word: ping' 2>/dev/null)"
  [ -n "$probe" ] || { echo "gate-live: n/a (distiller '$DISTILL_CMD' returned nothing — no relay pool reachable)"; exit 2; }
  echo "=== mesh-study-bridge --gate-live ($(ts), n=$N per arm, distiller=$DISTILL_CMD) ==="
  rc=0
  for arm in "SKIP:NO:18th-century Baroque oboe reed making" "APPLY:YES:self-healing systems"; do
    want="${arm#*:}"; want="${want%%:*}"; label="${arm%%:*}"; fld="${arm##*:}"
    # Per-arm floor, scaled with N so MESH_BRIDGE_GATE_N stays meaningful:
    #   SKIP  = 3/8 of N (min 1) — a regression floor under the measured p≈0.60, NOT a claim about it.
    #   APPLY = majority — the on-topic arm reads YES ~always (9/9 measured), so a majority miss there
    #           means the fix over-corrected into skip-everything, which is the other way to be broken.
    case "$label" in
      SKIP)  items="$gate_oboe";  floor=$(( (N*3+7)/8 )); [ "$floor" -lt 1 ] && floor=1 ;;
      *)     items="$gate_apply"; floor=$(( N/2 + 1 )) ;;
    esac
    hits=0
    for i in $(seq 1 "$N"); do
      # SAME DPROMPT, SAME parse_verdict as production — a gate with its own copy of either is
      # asserting a prompt nothing runs.
      v="$(parse_verdict "$("$DISTILL_CMD" "$(printf "$DPROMPT" "$fld" "$items")" 2>/dev/null)")"
      [ "$v" = "$want" ] && hits=$((hits+1))
      printf '  %-5s arm  run %d/%s  APPLIES=%-9s want=%s\n' "$label" "$i" "$N" "${v:-<none>}" "$want"
    done
    if [ "$hits" -ge "$floor" ]; then
      echo "  -> $label arm: PASS ($hits/$N read $want — floor $floor/$N)"
    else
      echo "  -> $label arm: FAIL ($hits/$N read $want — floor $floor/$N not met)"; rc=1
    fi
  done
  # "ok" = the hatch still FIRES and still HOLDS — not that it fires often enough. It is a ~0.6 coin;
  # ~2 in 5 inapplicable briefs still queue. Downstream treats a STUDY idea as unvetted regardless.
  [ "$rc" = 0 ] && echo "gate-live: ok (hatch fires on inapplicable material AND holds on real material; a rate FLOOR, not a rate — see DPROMPT)" \
                || echo "gate-live: FAIL — do not ship this prompt; a one-armed pass is not a pass"
  exit "$rc"
fi

DRY=0; LIST=0
case "${1:-}" in
  --dry)  DRY=1 ;;
  --list) LIST=1 ;;
  "")     ;;
  *) echo "usage: mesh-study-bridge [--dry|--list|--test]" >&2; exit 1 ;;
esac
mkdir -p "$MESH"; touch "$Q" "$SEEN" "$LOG"

if [ "$LIST" = 1 ]; then
  echo "=== study briefs (bridged ✓ / pending ·) ==="
  python3 -c '
import sys
seen=set(l.strip() for l in open(sys.argv[2]) if l.strip())
for raw in open(sys.argv[1]):
    line=raw.rstrip("\n")
    if line.startswith("=== study: ") and line.endswith("==="):
        body=line[len("=== study: "):-len(" ===")].strip()
        field=body; tsv=""
        if body.endswith(")") and "(" in body:
            field=body[:body.rfind("(")].strip(); tsv=body[body.rfind("(")+1:-1].strip()
        mark="✓" if tsv in seen else "·"
        print(f"  {mark} {tsv}  {field}")
' "$SLOG" "$SEEN" 2>/dev/null
  echo "=== open STUDY ideas in queue ==="
  grep -nE '^\[[ ~]\] STUDY\(' "$Q" 2>/dev/null || echo "  (none)"
  exit 0
fi

[ -s "$SLOG" ] || { echo "mesh-study-bridge: no study.log yet (run mesh-study first)"; exit 0; }

# Bridge any empty briefs or briefs already bridged by content (novelty gate)
python3 -c '
import sys, hashlib, datetime
seen=set()
try:
    seen=set(l.strip() for l in open(sys.argv[2]) if l.strip())
except Exception:
    pass
blocks=[]
cur=None
for raw in open(sys.argv[1]):
    line=raw.rstrip("\n")
    if line.startswith("=== study: ") and line.endswith("==="):
        if cur: blocks.append(cur)
        body=line[len("=== study: "):-len(" ===")].strip()
        field=body; tsv=""
        if body.endswith(")") and "(" in body:
            field=body[:body.rfind("(")].strip()
            tsv=body[body.rfind("(")+1:-1].strip()
        cur={"field":field,"ts":tsv,"items":[]}
    elif cur is not None and line.startswith("- "):
        cur["items"].append(line)
if cur: blocks.append(cur)
new_seen=[]
for b in blocks:
    if b["ts"] and b["ts"] not in seen:
        if not b["items"]:
            new_seen.append(b["ts"])
            now=datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
            fld=b["field"]
            ts=b["ts"]
            print(f"{now} AUTO-BRIDGE field={fld} ts={ts} — empty brief (skipping)", file=sys.stderr)
        else:
            ckey="sha:"+hashlib.sha1("\n".join([b["field"]]+b["items"]).encode()).hexdigest()[:16]
            if ckey in seen:
                new_seen.append(b["ts"])
                now=datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
                fld=b["field"]
                ts=b["ts"]
                print(f"{now} AUTO-BRIDGE field={fld} ts={ts} — content already bridged (novelty gate)", file=sys.stderr)
if new_seen:
    with open(sys.argv[2], "a") as f:
        for s in new_seen:
            f.write(s + "\n")
' "$SLOG" "$SEEN" 2>/dev/null

ACTIVE_FIELDS="$(grep -E "^\[[ ~]\] STUDY\(" "$Q" 2>/dev/null | sed -E 's/^\[[ ~]\] STUDY\(([^)]+)\):.*/\1/' | tr '\n' ' ')"
brief="$(read_brief $ACTIVE_FIELDS)"
[ -n "$brief" ] || { echo "mesh-study-bridge: no un-bridged study brief with items — nothing to do"; exit 0; }
BTS="$(printf '%s\n' "$brief" | sed -n '1p')"
CKEY="$(printf '%s\n' "$brief" | sed -n '2p')"
FIELD="$(printf '%s\n' "$brief" | sed -n '3p')"
ITEMS="$(printf '%s\n' "$brief" | tail -n +4)"
[ -n "$BTS" ] && [ -n "$FIELD" ] && [ -n "$ITEMS" ] || { echo "mesh-study-bridge: malformed brief, skipping"; exit 0; }
# mark_bridged: record BOTH the legacy ts-key and the content novelty key, so a same-topic re-emit
# under a new ts is skipped next time (no re-distill/re-queue churn).
mark_bridged(){ printf '%s\n%s\n' "$BTS" "$CKEY" >> "$SEEN"; }

# distil ONE concrete experiment via the free relay pool (read-only inference)
prompt="$(printf "$DPROMPT" "$FIELD" "$ITEMS")"
reply="$("$DISTILL_CMD" "$prompt" 2>/dev/null)"
VERDICT="$(parse_verdict "$reply")"
task="$(parse_task "$reply")"
# Legacy/degraded shape: a distiller that answers the OLD protocol with a bare SKIP still means NO.
# (Costs nothing, and keeps an older pinned pool honest rather than silently queueing "SKIP" as work.)
[ -z "$VERDICT" ] && [ "$(printf '%s' "$reply" | tr -d '[:space:]*.' | tr '[:lower:]' '[:upper:]')" = SKIP ] && VERDICT=NO

if [ -z "$reply" ]; then
  echo "mesh-study-bridge: distiller returned nothing for '$FIELD' (relay pools down?) — NOT marking, will retry"
  echo "$(ts) NODISTILL field=$FIELD ts=$BTS (relay empty) — leaving un-bridged for retry" >> "$LOG"
  exit 0
fi

# No verdict field = the distiller did not answer the protocol, so WE HAVE NO DECISION. Queueing the
# reply anyway would restore the exact bug this fix removes (a task nobody judged applicable), and
# marking it bridged would burn the brief on a non-answer. Retry instead — rare and LOUD, never a
# silent fallback: if the pool stops honouring the format this shows up as MALFORMED in the log and
# the queue simply stops growing, rather than filling with unjudged work.
if [ -z "$VERDICT" ]; then
  echo "mesh-study-bridge: distiller gave no APPLIES verdict for '$FIELD' — NOT marking, will retry"
  echo "$(ts) MALFORMED field=$FIELD ts=$BTS — no APPLIES field in reply :: ${reply:0:80}" >> "$LOG"
  exit 0
fi

# APPLIES: NO = the field's recent discourse has nothing applicable to us. Mark it bridged (so we
# don't re-spend inference on the same dead brief) but queue nothing.
if [ "$VERDICT" = NO ]; then
  [ "$DRY" = 1 ] && { echo "[dry] $FIELD ($BTS) -> SKIP (nothing applicable)"; exit 0; }
  mark_bridged
  echo "$(ts) SKIP field=$FIELD ts=$BTS (distiller: nothing applicable)" >> "$LOG"
  echo "mesh-study-bridge: $FIELD -> SKIP (marked, nothing queued)"
  exit 0
fi

# YES but no task text — an incomplete answer, not a decision to queue nothing. Retry, don't mark.
if [ -z "$task" ]; then
  echo "mesh-study-bridge: APPLIES=YES but empty TASK for '$FIELD' — NOT marking, will retry"
  echo "$(ts) MALFORMED field=$FIELD ts=$BTS — APPLIES=YES with no TASK line" >> "$LOG"
  exit 0
fi

IDEA="STUDY($FIELD): $task — try it in OUR codebase (small, no operator action), leave changes in the tree. (source: study '$FIELD' brief $BTS)"

if [ "$DRY" = 1 ]; then
  echo "[dry] would queue:"; echo "  [ ] $IDEA"; exit 0
fi

# serialize against mesh-generate / mesh-queue-tend (same lockfile they flock)
exec 9>"$MESH/.ideas-queue.lock" 2>/dev/null || true
flock -w 30 9 2>/dev/null || true

# one OPEN/in-flight study idea per field at a time → no pile-up of unstarted research tasks
if grep -qE "^\[[ ~]\] STUDY\($(printf '%s' "$FIELD" | sed 's/[][\.*^$/]/\\&/g')\):" "$Q" 2>/dev/null; then
  echo "$(ts) DEFER field=$FIELD ts=$BTS — an open STUDY($FIELD) idea already exists; deferring brief" >> "$LOG"
  echo "mesh-study-bridge: open STUDY($FIELD) idea already pending — deferring brief"
  exit 0
fi
# exact-text guard (belt and suspenders)
if grep -qF "$IDEA" "$Q" 2>/dev/null; then
  mark_bridged
  echo "mesh-study-bridge: identical idea already in queue — skipping"; exit 0
fi

printf '[ ] %s\n' "$IDEA" >> "$Q"
mark_bridged
echo "$(ts) QUEUED field=$FIELD ts=$BTS :: ${task:0:80}" >> "$LOG"
echo "mesh-study-bridge: queued STUDY($FIELD) — ${task:0:70}"
