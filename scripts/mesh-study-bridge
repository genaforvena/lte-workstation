#!/usr/bin/env bash
# reflex-cadence: 41 */4 * * *
# mesh-study-bridge — CLOSE THE RESEARCH LOOP. The study channel (mesh-study) fetches recent
# discourse on a field and stamps it to ~/.mesh/study.log — but it ENDED there: read, never tried
# (operator 2026-06-21: "literature reviews end as nothing but a review"). This bridges study →
# the autonomous work queue.
#
# For the newest un-bridged study brief it distills ONE concrete, worker-doable EXPERIMENT for THIS
# mesh — via mesh-relay (free inference pool, no claude quota burn) — and appends it to the
# ideas-queue as a `[ ] STUDY(<field>)` idea. From there the existing loop carries it the rest of the
# way:  ideas-queue --(mesh-generate)--> backlog --(mesh-feed)--> idle mind --> tries it, leaves
# changes in the tree --> [done] --(mesh-queue-tend)--> [x]. A review now ENDS IN AN ATTEMPT.
#
#   mesh-study-bridge          distill + queue the next un-bridged study brief
#   mesh-study-bridge --dry    print what it WOULD queue; write nothing
#   mesh-study-bridge --list   show which study briefs are bridged / pending
#   mesh-study-bridge --test   smoke test (hermetic; stubs the distiller, no network)
#
# Idempotent: each study brief is bridged at most once (~/.mesh/.study-bridged), keyed by BOTH its
# timestamp AND a content hash of its field+items — so a same-topic brief re-emitted under a new ts
# (mesh-study cycles topics) is NOT re-bridged unless its discourse genuinely changed (novelty gate).
# Also: one OPEN study idea per field at a time (no pile-up); exact-duplicate task text is skipped.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; SLOG="$MESH/study.log"; Q="$MESH/ideas-queue"
SEEN="$MESH/.study-bridged"; LOG="$MESH/study-bridge.log"
ts(){ date -u +%FT%TZ; }

# The distiller is overridable so --test can run it hermetically (no network). In production it is
# mesh-relay: text -> cheapest available FREE pool -> text. Read-only, never burns claude quota.
DISTILL_CMD="${MESH_BRIDGE_DISTILL_CMD:-mesh-relay}"

# Pick the newest study.log brief that (a) has real items and (b) isn't already bridged. Emits
# four lines: TS / CKEY / FIELD / then the item block, or nothing. Append-only log → newest block last.
# CKEY ("sha:<hash of field+items>") is the NOVELTY key: mesh-study cycles the same few topics, so a
# later brief on the SAME topic+items carries a NEW timestamp — keying only on ts would re-bridge it
# (re-distill + re-queue = churn, evergreen-repromotion class; discover dogfooded this 2026-06-27).
# Skipping on the content hash too means a topic re-bridges only when its discourse genuinely changed.
pick_brief_py='
import sys, hashlib
seen=set()
try:
    seen=set(l.strip() for l in open(sys.argv[2]) if l.strip())
except Exception:
    pass
blocks=[]
cur=None
for raw in open(sys.argv[1]):
    line=raw.rstrip("\n")
    if line.startswith("=== study: ") and line.endswith("==="):
        if cur: blocks.append(cur)
        # "=== study: <field> (<ts>) ==="
        body=line[len("=== study: "):-len(" ===")].strip()
        field=body; tsv=""
        if body.endswith(")") and "(" in body:
            field=body[:body.rfind("(")].strip()
            tsv=body[body.rfind("(")+1:-1].strip()
        cur={"field":field,"ts":tsv,"items":[]}
    elif cur is not None and line.startswith("- "):
        cur["items"].append(line)
if cur: blocks.append(cur)
for b in reversed(blocks):                       # newest-first
    if not b["items"]: continue                  # empty brief — nothing to distill
    if b["ts"] and b["ts"] in seen: continue     # already bridged (legacy ts-key, back-compat)
    ckey="sha:"+hashlib.sha1("\n".join([b["field"]]+b["items"]).encode()).hexdigest()[:16]
    if ckey in seen: continue                    # same topic+items already bridged (novelty gate)
    print(b["ts"]); print(ckey); print(b["field"])
    for it in b["items"]: print(it)
    break
'

read_brief(){ python3 -c "$pick_brief_py" "$SLOG" "$SEEN" 2>/dev/null; }

DPROMPT='You are the engineer of a small self-hosted autonomous agent mesh (bash mesh-* tools in a
git repo; nodes coordinate over tmux + a text board; free LLM inference via a relay). Below are
recent article titles from a field we track. Propose ONE concrete, SMALL experiment to try in OUR
codebase that borrows the single most useful idea here — a change one worker can do in a sitting,
needing NO operator action, NO new paid accounts, NO external hardware, leaving changes in the
working tree. Reply with ONE LINE ONLY: the task, imperative, <= 28 words, no preamble, no markdown,
no quotes. If nothing here genuinely applies to a self-hosted autonomous mesh, reply EXACTLY: SKIP.

FIELD: %s
RECENT ITEMS:
%s'

# ---- subcommands -------------------------------------------------------------------------------
if [ "${1:-}" = --test ]; then
  for d in python3 grep sed flock; do command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($d missing)"; exit 1; }; done
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh"
  cat > "$tmp/.mesh/study.log" <<'EOF'

=== study: crdt (2026-06-12T12:52:59Z) ===
(source: https://example/crdt)
- CRDT: Conflict-free replicated data type  [229pts]  https://en.wikipedia.org/wiki/CRDT
- Practical Demystification of CRDT  [1pts]  http://nami.me/crdt

=== study: empty-field (2026-06-12T13:00:00Z) ===
(source: https://example/empty)
(awaiting a mind to distill -> what to try)
EOF
  : > "$tmp/.mesh/ideas-queue"
  # stub distiller: deterministic, no network — proves the full distill->queue->dedup path
  stub="$tmp/distill.sh"; printf '#!/usr/bin/env bash\necho "make mesh-chat.log merges last-write-wins-free by tagging each line with node+epoch so two boards converge"\n' > "$stub"; chmod +x "$stub"
  out=$(HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" 2>&1) || { echo "smoke-test: FAIL (bridge run errored: $out)"; exit 1; }
  # the newest NON-empty brief is crdt (the empty-field block has no items → must be skipped)
  grep -qE '^\[ \] STUDY\(crdt\):' "$tmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (no STUDY(crdt) idea queued)"; exit 1; }
  grep -q '2026-06-12T12:52:59Z' "$tmp/.mesh/.study-bridged" || { echo "smoke-test: FAIL (bridged-ts not recorded → would re-queue forever)"; exit 1; }
  # idempotency: a 2nd run must NOT add a duplicate (same brief already bridged)
  before=$(grep -c 'STUDY(crdt)' "$tmp/.mesh/ideas-queue")
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" >/dev/null 2>&1 || true
  after=$(grep -c 'STUDY(crdt)' "$tmp/.mesh/ideas-queue")
  [ "$before" = "$after" ] || { echo "smoke-test: FAIL (re-queued an already-bridged brief: $before -> $after)"; exit 1; }
  # SKIP handling: a distiller that says SKIP records the ts (no retry storm) but queues nothing
  cat >> "$tmp/.mesh/study.log" <<'EOF'

=== study: noise (2026-06-12T14:00:00Z) ===
(source: https://example/noise)
- Ten reasons your standup meeting is broken  [3pts]  https://example/standup
EOF
  skip="$tmp/skip.sh"; printf '#!/usr/bin/env bash\necho SKIP\n' > "$skip"; chmod +x "$skip"
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$skip" bash "$0" >/dev/null 2>&1 || true
  grep -q '2026-06-12T14:00:00Z' "$tmp/.mesh/.study-bridged" || { echo "smoke-test: FAIL (SKIP brief not marked → retry storm)"; exit 1; }
  grep -q 'STUDY(noise)' "$tmp/.mesh/ideas-queue" && { echo "smoke-test: FAIL (SKIP brief should queue nothing)"; exit 1; }
  # NOVELTY GATE (discover 2026-06-27): mesh-study cycles the same topics, so a LATER brief on the
  # SAME topic+items arrives under a NEW timestamp. Keying only on ts would re-distill + re-queue it
  # (churn) — even after the prior idea COMPLETED (field-guard no longer blocks). The content-hash
  # must catch it. Re-emit the crdt brief verbatim under a new ts with the queue cleared (idea done):
  : > "$tmp/.mesh/ideas-queue"
  cat >> "$tmp/.mesh/study.log" <<'EOF'

=== study: crdt (2026-06-28T09:00:00Z) ===
(source: https://example/crdt)
- CRDT: Conflict-free replicated data type  [229pts]  https://en.wikipedia.org/wiki/CRDT
- Practical Demystification of CRDT  [1pts]  http://nami.me/crdt
EOF
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" >/dev/null 2>&1 || true
  grep -qE '^\[ \] STUDY\(crdt\):' "$tmp/.mesh/ideas-queue" && { echo "smoke-test: FAIL (re-bridged a same-topic+items brief under a new ts → churn; novelty-gate not catching it)"; exit 1; }
  # but a same topic with GENUINELY NEW items (new content hash) MUST still bridge:
  cat >> "$tmp/.mesh/study.log" <<'EOF'

=== study: crdt (2026-06-28T10:00:00Z) ===
(source: https://example/crdt)
- Automerge 3.0: a new CRDT storage format  [402pts]  https://example/automerge3
EOF
  HOME="$tmp" MESH_BRIDGE_DISTILL_CMD="$stub" bash "$0" >/dev/null 2>&1 || true
  grep -qE '^\[ \] STUDY\(crdt\):' "$tmp/.mesh/ideas-queue" || { echo "smoke-test: FAIL (a same-topic brief with NEW items did not bridge → novelty-gate too greedy, blocks real new discourse)"; exit 1; }
  echo "smoke-test: ok (newest non-empty brief distilled+queued; empty skipped; idempotent; SKIP marked-not-queued; same-topic re-emit skipped, new-content re-bridges)"
  exit 0
fi

DRY=0; LIST=0
case "${1:-}" in
  --dry)  DRY=1 ;;
  --list) LIST=1 ;;
  "")     ;;
  *) echo "usage: mesh-study-bridge [--dry|--list|--test]" >&2; exit 1 ;;
esac
mkdir -p "$MESH"; touch "$Q" "$SEEN" "$LOG"

if [ "$LIST" = 1 ]; then
  echo "=== study briefs (bridged ✓ / pending ·) ==="
  python3 -c '
import sys
seen=set(l.strip() for l in open(sys.argv[2]) if l.strip())
for raw in open(sys.argv[1]):
    line=raw.rstrip("\n")
    if line.startswith("=== study: ") and line.endswith("==="):
        body=line[len("=== study: "):-len(" ===")].strip()
        field=body; tsv=""
        if body.endswith(")") and "(" in body:
            field=body[:body.rfind("(")].strip(); tsv=body[body.rfind("(")+1:-1].strip()
        mark="✓" if tsv in seen else "·"
        print(f"  {mark} {tsv}  {field}")
' "$SLOG" "$SEEN" 2>/dev/null
  echo "=== open STUDY ideas in queue ==="
  grep -nE '^\[[ ~]\] STUDY\(' "$Q" 2>/dev/null || echo "  (none)"
  exit 0
fi

[ -s "$SLOG" ] || { echo "mesh-study-bridge: no study.log yet (run mesh-study first)"; exit 0; }

brief="$(read_brief)"
[ -n "$brief" ] || { echo "mesh-study-bridge: no un-bridged study brief with items — nothing to do"; exit 0; }
BTS="$(printf '%s\n' "$brief" | sed -n '1p')"
CKEY="$(printf '%s\n' "$brief" | sed -n '2p')"
FIELD="$(printf '%s\n' "$brief" | sed -n '3p')"
ITEMS="$(printf '%s\n' "$brief" | tail -n +4)"
[ -n "$BTS" ] && [ -n "$FIELD" ] && [ -n "$ITEMS" ] || { echo "mesh-study-bridge: malformed brief, skipping"; exit 0; }
# mark_bridged: record BOTH the legacy ts-key and the content novelty key, so a same-topic re-emit
# under a new ts is skipped next time (no re-distill/re-queue churn).
mark_bridged(){ printf '%s\n%s\n' "$BTS" "$CKEY" >> "$SEEN"; }

# distil ONE concrete experiment via the free relay pool (read-only inference)
prompt="$(printf "$DPROMPT" "$FIELD" "$ITEMS")"
task="$("$DISTILL_CMD" "$prompt" 2>/dev/null | grep -vaE '^\s*$' | head -1 | sed 's/^[-*0-9.[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//' | head -c 240)"

if [ -z "$task" ]; then
  echo "mesh-study-bridge: distiller returned nothing for '$FIELD' (relay pools down?) — NOT marking, will retry"
  echo "$(ts) NODISTILL field=$FIELD ts=$BTS (relay empty) — leaving un-bridged for retry" >> "$LOG"
  exit 0
fi

# SKIP = the field's recent discourse has nothing applicable to us. Mark it bridged (so we don't
# re-spend inference on the same dead brief) but queue nothing.
if [ "$task" = SKIP ]; then
  [ "$DRY" = 1 ] && { echo "[dry] $FIELD ($BTS) -> SKIP (nothing applicable)"; exit 0; }
  mark_bridged
  echo "$(ts) SKIP field=$FIELD ts=$BTS (distiller: nothing applicable)" >> "$LOG"
  echo "mesh-study-bridge: $FIELD -> SKIP (marked, nothing queued)"
  exit 0
fi

IDEA="STUDY($FIELD): $task — try it in OUR codebase (small, no operator action), leave changes in the tree. (source: study '$FIELD' brief $BTS)"

if [ "$DRY" = 1 ]; then
  echo "[dry] would queue:"; echo "  [ ] $IDEA"; exit 0
fi

# serialize against mesh-generate / mesh-queue-tend (same lockfile they flock)
exec 9>"$MESH/.ideas-queue.lock" 2>/dev/null || true
flock -w 30 9 2>/dev/null || true

# one OPEN/in-flight study idea per field at a time → no pile-up of unstarted research tasks
if grep -qE "^\[[ ~]\] STUDY\($(printf '%s' "$FIELD" | sed 's/[][\.*^$/]/\\&/g')\):" "$Q" 2>/dev/null; then
  mark_bridged
  echo "$(ts) DEFER field=$FIELD ts=$BTS — an open STUDY($FIELD) idea already exists; marked, not duplicated" >> "$LOG"
  echo "mesh-study-bridge: open STUDY($FIELD) idea already pending — marked brief bridged, not duplicated"
  exit 0
fi
# exact-text guard (belt and suspenders)
if grep -qF "$IDEA" "$Q" 2>/dev/null; then
  mark_bridged
  echo "mesh-study-bridge: identical idea already in queue — skipping"; exit 0
fi

printf '[ ] %s\n' "$IDEA" >> "$Q"
mark_bridged
echo "$(ts) QUEUED field=$FIELD ts=$BTS :: ${task:0:80}" >> "$LOG"
echo "mesh-study-bridge: queued STUDY($FIELD) — ${task:0:70}"
