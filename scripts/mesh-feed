#!/usr/bin/env bash
# mesh-feed — the WORK-PUMP. Breath keeps minds alive (mesh-tick); this keeps them PRODUCTIVE: when a
# worker is idle, assign it the next task from the backlog. Without this, workers idle after finishing
# (the tick nudge only says "do a step or idle"; only the steward assigns — and the steward forgets).
#
# Backlog: ~/.mesh/backlog — one task per line:  <target>|<prompt>
#   target = "local:<win>"  or  "<user@ip>:<win>"   (e.g. local:opencode, user@<ts-ip>:claude)
# Reliable idle-detection via double-capture (same as mesh-tick). One task per idle worker per run.
#   mesh-feed            assign next backlog task to each idle worker
#   mesh-feed --list     show backlog
set -uo pipefail
# node-local worker-pool override (MESH_FEED_WORKERS) — the comment below referenced restore.env but
# the file was never actually sourced, so cron runs used the dead default pool (2026-06-17 fix).
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
# SPEND GOVERNOR (operator 2026-06-21): feeding a paid mind is the hot lane — gate it on mesh-pace so the
# 5h window isn't drained in 2h. The gate is consulted LAZILY at the first real assignment (pace_gate, in
# the backlog walk), AFTER confirming a backlog task AND an idle worker — so an empty-backlog or all-busy
# tick never burns the GAP (chat-review/pace-noop-consumes-slot 2026-06-22). It used to sit HERE at the top
# and record-consume the reserve even when it woke no mind (mesh-pace exit-0 records "now").
[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  S="$(hostname)"
  tmux has-session -t "$S" 2>/dev/null || { echo "smoke-test: FAIL (no tmux session '$S' — feed can't reach workers)"; exit 1; }
  BL="$HOME/.mesh/backlog"
  touch "$BL" 2>/dev/null || { echo "smoke-test: FAIL (cannot touch $BL)"; exit 1; }
  [ -w "$BL" ] || { echo "smoke-test: FAIL (backlog not writable)"; exit 1; }
  # dry-run: idle detection via cap+double-capture — run on a known window
  for w in work verify health; do
    tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$w" || continue
    pane=$(tmux list-panes -t "$S:$w" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
    cap=$(tmux capture-pane -t "$S:$w.${pane:-0}" -p -S -6 2>/dev/null)
    [ -n "$cap" ] && { echo "  ok: cap($w) returns ${#cap} chars"; break; }
  done
  src="${BASH_SOURCE[0]:-$0}"
  grep -q 'STIMULUS-STALL' "$src" || { echo "smoke-test: FAIL (response-threshold instrument: STIMULUS-STALL emit missing)"; exit 1; }
  grep -q 'remain=.*grep -cvE' "$src" || { echo "smoke-test: FAIL (STIMULUS-STALL: backlog-remaining count not wired)"; exit 1; }
  # PACE PLACEMENT (chat-review/pace-noop-consumes-slot): the spend-governor gate must NOT sit at the top
  # (an empty-backlog / all-busy tick would record-consume the GAP); it is consulted lazily via pace_gate
  # at the first real wake. Top (pre-test) must be free of a 'mesh-pace feed' CALL; pace_gate must exist.
  head -20 "$src" | grep -q 'mesh-pace feed' && { echo "smoke-test: FAIL (pace gate at top — empty/all-busy ticks burn the GAP)"; exit 1; }
  grep -q 'pace_gate' "$src" || { echo "smoke-test: FAIL (lazy pace_gate missing — spend governor lost)"; exit 1; }
  # PACED-SKIP heartbeat (feed-pace-skip-hollow-staleness): a paced skip must leave a feed.log trace, else
  # reflex-health (600s) false-alarms this lane DEAD while it is merely throttled (pace gap 4500s).
  grep -q 'PACED-SKIP' "$src" || { echo "smoke-test: FAIL (paced-skip heartbeat missing — throttle reads as a dead lane)"; exit 1; }
  echo "smoke-test: ok (idle-cap + stimulus-stall + lazy-pace + paced-skip-heartbeat wired)"; exit 0
}
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; BL="$MESH/backlog"; LOG="$MESH/feed.log"; touch "$BL"
ts(){ date -u +%FT%TZ; }
[ "${1:-}" = --list ] && { echo "=== backlog ($(wc -l <"$BL") tasks) ==="; cat "$BL"; exit 0; }

cap(){ # $1=node $2=win  -> MIND (bottom) pane text. top is refreshing DATA → would read as always-busy.
  if [ "$1" = local ]; then
    local p; p=$(tmux list-panes -t "$(hostname):$2" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
    tmux capture-pane -t "$(hostname):$2.${p:-0}" -p -S -6 2>/dev/null
  else ssh -o BatchMode=yes -o ConnectTimeout=8 "$1" "p=\$(tmux list-panes -t \$(hostname):$2 -F '#{pane_top} #{pane_index}' 2>/dev/null|sort -n|tail -1|awk '{print \$2}'); tmux capture-pane -t \$(hostname):$2.\${p:-0} -p -S -6 2>/dev/null"; fi; }
idle(){ # 0 = idle. GENERAL signal: did the window CHANGE? A working TUI redraws (spinner, tokens,
  # output); an idle one is static. No content-specific grep (that false-matched opencode's idle stats
  # line — operator: "check 'changed' in general, not specific things"). Just observe the channel. $1=node $2=win
  local a b; a="$(cap "$1" "$2")"; [ -z "$a" ] && return 1; sleep 2.5; b="$(cap "$1" "$2")"
  [ "$a" = "$b" ]   # static = idle (0); changed = busy (1)
}

# Lazy SPEND-GOVERNOR gate (chat-review/pace-noop-consumes-slot): consume one mesh-pace slot the FIRST
# time this run is about to WAKE a mind — never before. So empty-backlog / all-busy no-op runs don't
# record-consume the GAP. Returns 0 = proceed; the first call asks mesh-pace and may return 1 (skip the
# whole run — a skip does NOT record, so the gap is preserved). Fail-open if mesh-pace is absent.
_paced=""
pace_gate(){
  [ -n "$_paced" ] && return 0
  _paced=1
  command -v mesh-pace >/dev/null 2>&1 || return 0
  if mesh-pace feed; then return 0; fi
  # PACED-SKIP heartbeat (chat-review/feed-pace-skip-hollow-staleness 2026-06-24): the spend-governor held
  # the slot, but a SILENT exit froze feed.log's mtime — and reflex-health judges this lane DEAD at 600s
  # while the pace gap is 4500s (7.5× longer), so every sustained throttle false-alarmed a healthy lane.
  # Leave a truthful per-run trace: mtime now tracks RUNS (not just deliveries) and the throttle is honest.
  local r; r=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null); r=${r:-0}
  echo "$(ts) PACED-SKIP spend-governor held the slot; $r backlog waiting (lane alive, throttled by mesh-pace)" >> "$LOG"
  return 1
}

# walk backlog; for the first task whose target is idle, assign + remove that line
assigned=0
while IFS='|' read -r target prompt; do
  [ -z "${target// /}" ] && continue
  case "$target" in \#*) continue;; esac
  node="${target%%:*}"; win="${target##*:}"
  if idle "$node" "$win"; then
    pace_gate || exit 0   # real wake confirmed (backlog task + idle worker) → consume the pace slot now
    if [ "$node" = local ]; then mesh-tell "$win" "$prompt" >/dev/null 2>&1
    else mesh-tell --node "$node" "$win" "$prompt" >/dev/null 2>&1; fi
    echo "$(ts) FED $target <- ${prompt:0:60}" >> "$LOG"
    # remove assigned. NOT `&& mv`: grep -v exits 1 when the result is EMPTY (last task removed),
    # which skipped the mv and left the task in the backlog → it got re-fed to the next idle mind
    # (opencode redid the secrets audit 10 min after posting [done], 2026-06-11).
    grep -vF "$target|$prompt" "$BL" > "$BL.tmp"; mv "$BL.tmp" "$BL"
    assigned=$((assigned+1))
  fi
done < "$BL"

# OPPORTUNISTIC pass: a fast idle worker shouldn't sit while a LOCAL task waits for a slower worker.
# The targeted pass prefers the round-robin owner; this fills idle capacity — any idle local worker
# grabs the next remaining local: task (re-targeted). codex first (fastest model, idles most).
# Operator: "codex seems not so busy" — it finishes fast then waited for its next round-robin turn.
# ALL local worker channels, not just work/verify/health — the dispatch-pool minds (dev/discover/sense)
# were absent here, so generated backlog work never reached them and they sat IDLE forever despite a
# non-empty backlog (operator: "work queues not empty and here we go again", 2026-06-15). Configurable
# via MESH_FEED_WORKERS (restore.env). Keep the order fastest/free-first so quota-bound claude is last.
for w in ${MESH_FEED_WORKERS:-work verify health dev discover sense}; do
  grep -q '^local:' "$BL" 2>/dev/null || break
  idle local "$w" || continue
  task="$(grep -m1 '^local:' "$BL")"; [ -z "$task" ] && break
  prompt="${task#*|}"
  pace_gate || exit 0   # opportunistic real wake → consume the pace slot now (once per run, lazily)
  mesh-tell "$w" "$prompt" >/dev/null 2>&1
  echo "$(ts) FED local:$w (opportunistic, was ${task%%|*}) <- ${prompt:0:50}" >> "$LOG"
  grep -vF "$task" "$BL" > "$BL.tmp"; mv "$BL.tmp" "$BL"
  assigned=$((assigned+1))
done

# NB: `grep -c` prints "0" AND exits 1 on zero matches, so a `|| echo 0` fallback appends a
# SECOND "0" → remain="0\n0" → the `-gt 0` test below dies with "integer expression expected".
# grep -c already prints a count; only default when the var is genuinely empty (missing $BL).
remain=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null); remain=${remain:-0}
echo "$(ts) fed $assigned idle worker(s); $remain backlog remain" >> "$LOG"
# ── STIMULUS-STALL instrument (response-threshold division of labor, read-only). In the swarm model a
# task's stimulus RISES while it stays unperformed, eventually recruiting any free agent; the mesh has
# no such intensity field — allocation is flat first-feasible (this targeted pass + a local-only
# opportunistic recruit). The signature of the gap: demand remains while this run recruited NOBODY —
# the recorded "work queues not empty and here we go again" failure. Surface it (no behavior change);
# repeated STIMULUS-STALL lines in feed.log = intensifying unmet demand the flat allocator never escalates.
stall=0
[ "$remain" -gt 0 ] && [ "$assigned" -eq 0 ] && { stall=1; echo "$(ts) STIMULUS-STALL $remain task(s) unmet, 0 recruited this run — no stimulus-intensity to escalate neglected demand (response-threshold gap)" >> "$LOG"; }
echo "mesh-feed: assigned $assigned, $remain backlog remain$([ "$stall" = 1 ] && echo ' [STIMULUS-STALL: unmet demand, 0 recruited]')"
