#!/usr/bin/env python3
"""mesh-pyparse — catch the DEAD-BUT-GREEN class: a bash tool whose `bash -n` passes but whose
embedded `python3 -c '...'` block has a SyntaxError, so it fails only at RUNTIME with stderr
swallowed (mesh-github-watch f-string SyntaxError + mesh-study IndentationError ran dead-but-green
for days, 2026-06-12). mesh-doctor parses tools by shebang (bash -n / py_compile) — it never looks
INSIDE a bash tool at its embedded python. This closes that gap.

ZERO-FALSE-POSITIVE by design: only STATICALLY-LITERAL blocks are validated —
  - single-quoted   python3 -c '...'      (bash single-quotes never interpolate)
  - quoted heredocs  python3 ... <<'PY' ... PY   (quoted delimiter = literal)
Anything shell-interpolated ($VAR / $(...) / double-quoted -c "...") is SKIPPED, because its real
text is only knowable after the shell runs — validating the raw form false-positives (the 4 known
FPs: mesh-card:226/234, mesh-peers:26, mesh-reflexes:29). Better to under-report than cry wolf.

  mesh-pyparse [DIR-or-FILE ...]   scan (default: ~/.local/bin/mesh-*); prints BAD blocks, rc=1 if any
  mesh-pyparse --test              self-test (a broken block is caught; an interpolated one is skipped)
"""
import sys, os, re, glob

import signal
# SIGTERM MUST UNWIND, or the `finally` in selftest() is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks, so a correct-looking
# cleanup never runs. The signal is not hypothetical: GNU `timeout` wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire, and signals the whole process group.
# sys.exit() from the handler raises SystemExit in the main thread, which is what unwinds.
# SIGKILL stays uncatchable; that half is mesh-tmp-guard's sweep. Pattern: eb5b8e7, mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

# python3[ ] -c '<literal>'  — the closing ' must be a CLEAN shell-arg close (followed by
# whitespace / ) ; | & / EOF). This rejects shell quote-juggling like home="'"$HOME"'" (the
# inner ' is followed by ") and python-string artifacts when scanning a tool that embeds python
# AS DATA (e.g. this scanner's own fixtures) — the two false-positive classes the 2026-06-12
# sweep hit (mesh-reflexes:29 etc.). A python SyntaxError still closes its SHELL quote cleanly,
# so real broken blocks (mesh-study indentation, mesh-github-watch f-string) are still caught.
RE_C = re.compile(r"python3?\s+-c\s+'([^']*)'(?=[\s);|&]|\Z)")
# python3 ... <<'MARKER' (or "MARKER") ... \nMARKER   — quoted delimiter only (literal heredoc)
RE_HD = re.compile(r"<<-?\s*['\"](\w+)['\"]\s*\n(.*?)\n\s*\1\b", re.DOTALL)


def blocks(text):
    """Yield (kind, code) for statically-literal embedded python only."""
    for m in RE_C.finditer(text):
        code = m.group(1)
        # an interpolated heredoc/`-c "..."` never reaches here (wrong quote); guard $ anyway
        if "$" in code:
            continue
        yield ("-c", code)
    for m in RE_HD.finditer(text):
        head = text[max(0, m.start() - 60):m.start()]
        if "python" not in head:           # only heredocs fed to python
            continue
        code = m.group(2)
        if "$" in code:                    # belt-and-suspenders (delimiter was quoted, so rare)
            continue
        yield ("heredoc", code)


def scan_file(path):
    """Return list of (lineno, kind, error) for blocks that won't compile."""
    bad = []
    try:
        with open(path, "r", errors="replace") as f:
            text = f.read()
    except OSError:
        return bad
    if "python" not in text:
        return bad
    for kind, code in blocks(text):
        try:
            compile(code, f"{os.path.basename(path)}::{kind}", "exec")
        except SyntaxError as e:
            # locate the block in the file for a clickable-ish pointer
            idx = text.find(code)
            lineno = text.count("\n", 0, idx) + 1 if idx >= 0 else 0
            bad.append((lineno, kind, f"{e.msg} (line {e.lineno} of block)"))
    return bad


def targets(args):
    if not args:
        args = [os.path.expanduser("~/.local/bin")]
    files = []
    for a in args:
        if os.path.isdir(a):
            files += glob.glob(os.path.join(a, "mesh-*"))
        elif os.path.isfile(a):
            files.append(a)
    return sorted(set(files))


def selftest():
    import tempfile, shutil
    d = tempfile.mkdtemp()
    # The cleanup lives in `finally`, not on a straight line after the assertions: a straight-line
    # rmdir leaks the dir on ANY exception raised in between (a scan_file crash on a new fixture),
    # and — with the SIGTERM handler installed at the top of this file — on the TERM that
    # mesh-doctor's `timeout`-wrapped hourly `--test` sweep delivers.
    try:
        # a bash tool whose bash -n passes but embedded python is broken (indentation, like mesh-study)
        broken = os.path.join(d, "mesh-broken")
        open(broken, "w").write("#!/usr/bin/env bash\ncat x | python3 -c '\n  import sys\ntry: pass\n'\n")
        # an interpolated block that must be SKIPPED (would FP if validated raw)
        interp = os.path.join(d, "mesh-interp")
        open(interp, "w").write('#!/usr/bin/env bash\npython3 -c "import json; print(json.load(open(\'$F\')))"\n')
        # a clean embedded block
        good = os.path.join(d, "mesh-good")
        open(good, "w").write("#!/usr/bin/env bash\necho x | python3 -c 'import sys,json; print(json.load(sys.stdin))'\n")
        ok = True
        if not scan_file(broken):
            print("smoke-test: FAIL (broken embedded python NOT caught)"); ok = False
        if scan_file(interp):
            print("smoke-test: FAIL (interpolated block false-positived — should be skipped)"); ok = False
        if scan_file(good):
            print("smoke-test: FAIL (clean block flagged)"); ok = False
        if ok:
            print("smoke-test: ok")
        return 0 if ok else 1
    finally:
        shutil.rmtree(d, ignore_errors=True)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        sys.exit(selftest())
    any_bad = 0
    for path in targets(args):
        for lineno, kind, err in scan_file(path):
            any_bad = 1
            print(f"{path}:{lineno}: embedded python ({kind}) WON'T COMPILE — {err}")
    if not any_bad:
        print("all statically-literal embedded python compiles")
    sys.exit(any_bad)


if __name__ == "__main__":
    main()
