#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-claim-freshness — ARM 1: fresh-clear claim check (standalone; mesh-board-lint untouched).
#
# A [taking] from a window with no clear/handoff-restore row within
# $MESH_CLAIM_FRESH_HOURS (default 12) verdicts STALE-CONTEXT.
#
#   mesh-claim-freshness --board FILE --clear FILE [--hours N]
#   mesh-claim-freshness --test
#
# Exit: 0 fresh-or-warning-printed (STALE is warn-level, still rc 0? NO —
#   decided: rc 1 when log present+readable and window absent = actionable stale;
#   rc 2/skip when no log available, never fail on missing evidence; rc 0 fresh).
# Rationale for rc 1 (not warn-rc-0): a warn that always exits 0 is invisible to
# gates; rc 2 on missing log keeps "no evidence" distinct from "fresh".
set -uo pipefail
HOURS="${MESH_CLAIM_FRESH_HOURS:-12}"

usage(){ echo "usage: mesh-claim-freshness --board FILE --clear FILE [--hours N] | --test" >&2; }

# epoch of "now - hours" using GNU date
cutoff_epoch(){ date -u -d "$1 hours ago" +%s 2>/dev/null || date -u -v-"$1"H +%s; }

# Extract taking windows: "[taking] <window>:" -> window (lowercased, strip @host)
taking_windows(){
  grep -a '\[taking\]' "$1" 2>/dev/null | sed -n 's/.*\[taking\] *\([^: ]*\).*/\1/p' | tr '[:upper:]' '[:lower:]' | sed 's/@.*//' | sort -u
}

# Extract (window, epoch) rows from clear log: supports JSONL ledger
# ({"window":..,"ts":..}) and mesh-clear-log --tail text ("2026-..Z  <win> ...").
clear_rows(){
  local f="$1"
  if grep -qa '"window"' "$f" 2>/dev/null; then
    python3 - "$f" <<'PY' 2>/dev/null
import json,sys,datetime
for line in open(sys.argv[1], errors='replace'):
    line=line.strip()
    if not line.startswith('{'): continue
    try: o=json.loads(line)
    except Exception: continue
    w=str(o.get('window','')).lower().split('@')[0]
    ts=str(o.get('ts') or o.get('time') or o.get('at') or '')
    if not w or not ts: continue
    try:
        ts=ts.replace('Z','+00:00')
        ep=int(datetime.datetime.fromisoformat(ts).timestamp())
    except Exception: continue
    print(f"{ep} {w}")
PY
  else
    # text format: "<ISOZ>  <win> ..."
    while IFS= read -r ln || [ -n "$ln" ]; do
      ts="$(awk '{print $1}' <<<"$ln")"; w="$(awk '{print $2}' <<<"$ln" | tr '[:upper:]' '[:lower:]')"
      [ -n "$ts" ] && [ -n "$w" ] || continue
      ep="$(date -u -d "$ts" +%s 2>/dev/null || echo "")"
      [ -n "$ep" ] && echo "$ep $w"
    done < "$f"
  fi
}

check(){
  local board="$1" clear="$2" hours="$3"
  [ -r "$board" ] || { echo "SKIP unreadable board: $board"; return 2; }
  [ -r "$clear" ] || { echo "SKIP no clear-log available: $clear — never fail on missing evidence"; return 2; }
  [ -s "$clear" ] || { echo "SKIP empty clear-log — never fail on missing evidence"; return 2; }
  local cutoff; cutoff="$(cutoff_epoch "$hours")"
  local rows; rows="$(clear_rows "$clear")"
  [ -n "$rows" ] || { echo "SKIP clear-log has no parseable rows — never fail on missing evidence"; return 2; }
  local stale=0 win
  while IFS= read -r win || [ -n "$win" ]; do
    [ -n "$win" ] || continue
    if grep -q " $win\$" <<<"$rows" && [ "$(awk -v w="$win" -v c="$cutoff" '$2==w && $1>=c{ok=1} END{print ok+0}' <<<"$rows")" = 1 ]; then
      echo "FRESH: $win (clear within ${hours}h)"
    else
      echo "STALE-CONTEXT: [taking] from '$win' with no clear/handoff-restore row within ${hours}h"
      stale=1
    fi
  done < <(taking_windows "$board")
  [ "$stale" = 1 ] && return 1 || { echo "claim-freshness: clean"; return 0; }
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  pass=0; fail=0; ok(){ pass=$((pass+1)); }; bad(){ echo "FAIL: $1"; fail=$((fail+1)); }
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; old="$(date -u -d '30 hours ago' +%Y-%m-%dT%H:%M:%SZ)"
  printf '2026-09-16T00:00:02Z  m@h  ::  [taking] genome: tool-a/real-thing\n' > "$d/board.log"
  printf '%s  genome ctx=1 mesh-clear [x] task-boundary\n' "$now" > "$d/clear.txt"
  "$0" --board "$d/board.log" --clear "$d/clear.txt" --hours 12 >/dev/null 2>&1; [ $? = 0 ] && ok || bad "fresh window must rc=0"
  printf '%s  genome ctx=1 mesh-clear [x] task-boundary\n' "$old" > "$d/clear-old.txt"
  out="$("$0" --board "$d/board.log" --clear "$d/clear-old.txt" --hours 12 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'STALE-CONTEXT' <<<"$out"; } && ok || bad "absent window must rc=1 STALE-CONTEXT (rc=$rc: $out)"
  "$0" --board "$d/board.log" --clear "$d/nonexistent" >/dev/null 2>&1; [ $? = 2 ] && ok || bad "missing log must rc=2"
  : > "$d/empty.txt"
  "$0" --board "$d/board.log" --clear "$d/empty.txt" >/dev/null 2>&1; [ $? = 2 ] && ok || bad "empty log must rc=2"
  echo "mesh-claim-freshness --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

BOARD=""; CLEAR=""; H="$HOURS"
while [ $# -gt 0 ]; do
  case "$1" in
    --board) BOARD="${2:-}"; shift 2;;
    --clear) CLEAR="${2:-}"; shift 2;;
    --hours) H="${2:-}"; shift 2;;
    -h|--help) usage; exit 0;;
    *) echo "mesh-claim-freshness: unknown arg $1" >&2; usage; exit 2;;
  esac
done
[ -n "$BOARD" ] && [ -n "$CLEAR" ] || { usage; exit 2; }
check "$BOARD" "$CLEAR" "$H"
