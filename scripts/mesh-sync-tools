#!/usr/bin/env bash
# mesh-sync-tools — keep this node's ~/.local/bin/mesh-* in step with the genome (source of truth).
# Stale hand-deployed tools caused most gaps in the 2026-06-10 session (session-watchdog, voice-rx,
# mesh-restore all drifted). This reflex makes drift VISIBLE so it never bites silently again.
#
#   mesh-sync-tools              report drift (genome vs local); edge-triggered alert to mesh-chat
#   mesh-sync-tools --apply      sync genome -> local where they differ (backs up old local first)
#   mesh-sync-tools --loop [s]   run forever: pull + report every N sec (default 3600); supervisable
#
# Exit: 0 = in sync (or applied cleanly); 1 = drift present (report mode) or git-pull failed.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
MESH="$HOME/.mesh"; LOG="$MESH/sync-tools.log"; BK="$MESH/tools-backup"; STATE="$MESH/.sync-tools-state"
mkdir -p "$BK" "$MESH"
ts(){ date -u +%FT%TZ; }

# loop mode: supervisable long-running variant
if [ "${1:-}" = --loop ]; then
  iv="${2:-3600}"
  echo "[mesh-sync-tools] genome drift watch every ${iv}s on $(hostname)"
  while true; do
    : > "$MESH/mesh-sync-tools.beat"
    "$0" || true   # report mode; chat alert fires on drift
    sleep "$iv"
  done
  exit 0
fi

APPLY=0; [ "${1:-}" = --apply ] && APPLY=1

cd "$REPO" 2>/dev/null || { echo "$(ts) FAIL no repo $REPO" >>"$LOG"; exit 1; }
# refresh genome (best-effort; if it fails we still compare against on-disk scripts/)
git pull --ff-only --quiet 2>/dev/null || true

drift=""
for f in scripts/mesh-*; do
  [ -f "$f" ] || continue
  b=$(basename "$f"); dst="$HOME/.local/bin/$b"
  if [ ! -f "$dst" ] || ! diff -q "$f" "$dst" >/dev/null 2>&1; then
    drift="$drift $b"
    if [ "$APPLY" = 1 ]; then
      [ -f "$dst" ] && cp -p "$dst" "$BK/$b.$(date -u +%Y%m%dT%H%M%SZ)" 2>/dev/null
      cp "$f" "$dst" && chmod +x "$dst" && echo "$(ts) SYNCED $b" >>"$LOG"
    fi
  fi
done
drift="${drift# }"

if [ "$APPLY" = 1 ]; then
  [ -n "$drift" ] && echo "$(ts) applied: $drift" >>"$LOG" || echo "$(ts) apply: already in sync" >>"$LOG"
  : > "$STATE"   # cleared: post-apply we're in sync
  exit 0
fi

# report mode — edge-triggered chat alert (only when the drift set CHANGES, no spam)
prev="$(cat "$STATE" 2>/dev/null || echo)"
if [ -n "$drift" ]; then
  echo "$(ts) DRIFT:$drift" >>"$LOG"
  if [ "$drift" != "$prev" ]; then
    echo "$drift" > "$STATE"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-chat "[drift] $(hostname): local tools differ from genome → $drift. Fix: mesh-sync-tools --apply (backs up first)." >/dev/null 2>&1
  fi
  exit 1
else
  [ -n "$prev" ] && { echo "$(ts) drift cleared" >>"$LOG"; : > "$STATE"; }
  exit 0
fi
