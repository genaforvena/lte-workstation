#!/usr/bin/env bash
# mesh-sync-tools — keep this node's ~/.local/bin/mesh-* in step with the genome (source of truth).
# smoke-test: --test checks repo dir exists + readable
# Stale hand-deployed tools caused most gaps in the 2026-06-10 session (session-watchdog, voice-rx,
# mesh-restore all drifted). This reflex makes drift VISIBLE so it never bites silently again.
#
#   mesh-sync-tools              report drift (genome vs local); edge-triggered alert to mesh-chat
#   mesh-sync-tools --apply      sync genome -> local where they differ (backs up old local first)
#   mesh-sync-tools --loop [s]   run forever: pull + report every N sec (default 3600); supervisable
#   mesh-sync-tools --test       smoke test (exit 0 if repo dir present)
#
# Exit: 0 = in sync (or applied cleanly); 1 = drift present (report mode) or git-pull failed.
#
# CADENCE (2026-07-24). This detector was UNWIRED: no `# reflex-cadence:` header, so mesh-autowire
# could never schedule it, and no crontab line on this node — reflexes.cron.example has carried the
# intended `*/20` line COMMENTED OUT since it was written. It still produced [drift] alerts, which
# is what hid the gap: `mesh-dash genome` calls it on every refresh, so drift was watched only for
# as long as somebody kept a dashboard open. That is watching by accident. Measured the same day:
# a deploy shim in ~/.local/bin overwritten by the very tool it wraps (cp scripts/uxn/mesh-body-gate
# over scripts/mesh-body-gate's shim) breaks the */30 body-gate reflex outright — the deployed copy
# resolves $here to ~/.local/bin, where its ROM/ledger/receiver do not exist, so every firing is a
# loud n/a. This tool DOES catch that (sandbox: DRIFT:mesh-body-gate, confirmed on the 2nd cycle,
# rc 1) — it simply was not running unless a human was looking.
# REPORT-ONLY on the cadence: --apply mutates ~/.local/bin and can revert a local-only fix (that is
# what its own [drift-clobber] alert exists for), so the scheduled lane observes and the healing
# stays a decision someone makes.
# reflex-cadence: */20 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
MESH="$HOME/.mesh"; LOG="$MESH/sync-tools.log"; BK="$MESH/tools-backup"; STATE="$MESH/.sync-tools-state"
command -v mkdir >/dev/null 2>&1 || { echo "mesh-sync-tools: missing mkdir" >&2; exit 1; }
mkdir -p "$BK" "$MESH"
ts(){ date -u +%FT%TZ; }

# SCRATCH (2026-08-15, phaedra 100%-/tmp incident): _sc_revert_verdict stages `git show <rev>:<tool>`
# into a temp file and runs its --test under `timeout 60` — and the `rm -f` sat on the fall-through
# path, so ANY exit that did not reach the next line (the timeout's SIGTERM landing on this process,
# an operator ^C, a supervisor's TERM, `exit` from a branch) stranded the copy. This runs */20 as
# root on phaedra; 59,234 stranded temps later /tmp was 100% full and every write on the box failed.
# Two changes, both deliberate:
#   - ONE process-scoped dir removed by a trap, so cleanup is no longer conditional on control flow
#     reaching a statement. NOTE HONESTLY: a trap covers EXIT/INT/HUP/TERM — it CANNOT cover SIGKILL
#     (untrappable by definition) or a power cut. The bounded-age sweep (mesh-tmp-guard) is what
#     covers those; a trap alone would be a fix that reads complete and isn't.
#   - a NAMED prefix instead of bare `tmp.XXXXXXXXXX`, so a leaked temp says who leaked it. The
#     incident's forensics were only possible by opening files and guessing at their contents.
SC_TMPD="$(mktemp -d -t mesh-sync-tools.XXXXXXXX 2>/dev/null || true)"
trap 'rm -rf ${SC_TMPD:+"$SC_TMPD"} ${TMP:+"$TMP"}' EXIT INT HUP TERM
sc_tmp(){ if [ -n "${SC_TMPD:-}" ]; then mktemp -p "$SC_TMPD" 2>/dev/null; else mktemp 2>/dev/null; fi; }

# STRAND-ALERT gate (chat-review/strand-cooldown 2026-07-05): the old edge-trigger fired once per
# DISTINCT behind-count — but the steward lands every tick, so behind INCREMENTS every cycle and
# "edge-triggered" degenerated into a post every */20 run (28+ identical [genome-strand] lines in a
# day, ~62 board posts across the incident). Gate: post only when the count changed AND the last
# post is older than MESH_STRAND_COOLDOWN (2h default). State: "behind epoch" (single-field legacy
# state reads as behind + epoch 0 → posts once, then converts). A frozen count still never re-posts
# (the original edge semantics); recovery still clears state so a NEW strand posts immediately.
strand_gate_decide(){ # $1=behind $2=state-file $3=cooldown_s $4=now_epoch → POST|HOLD (writes state on POST)
  local behind="$1" f="$2" cool="$3" now="$4" last_behind="" last_post=0
  [ -f "$f" ] && read -r last_behind last_post < "$f" 2>/dev/null
  case "${last_post:-}" in ''|*[!0-9]*) last_post=0;; esac
  if [ "$behind" != "$last_behind" ] && [ $(( now - last_post )) -ge "$cool" ]; then
    printf '%s %s\n' "$behind" "$now" > "$f"; echo POST
  else
    echo HOLD
  fi
}

# strand_gate_key <behind> <ahead> <head_sha> → the gate key handed to strand_gate_decide.
# (chat-review/strand-gate-diverged-reposts 2026-07-12): keying on behind alone (or behind:ahead)
# re-posts a DIVERGED strand every cooldown FOREVER — ahead>0 means local HEAD can't FF, so the
# steward's every-tick land only grows `behind` (phaedra 1→14 in a window) while the situation is
# UNCHANGED and only a MANUAL reconcile clears it. A growing behind-count → changing composite key
# → char-identical [genome-strand] re-post every 2h. So:
#   ahead>0  (DIVERGED, manual reconcile): key on divergence IDENTITY (local HEAD sha) → post ONCE,
#            re-post only when local HEAD actually moves (someone reconciled). behind churn is inert.
#   ahead==0 (FF-blocked, self-resolving on pull): keep behind-count keying so a growing strand
#            re-alerts with the updated count (the original strand-cooldown semantics).
strand_gate_key(){
  local behind="$1" ahead="$2" head="$3"
  if [ "${ahead:-0}" -gt 0 ]; then echo "diverged:${head}"; else echo "$behind"; fi
}

# dst_matches_head <genome_file> <deployed_file> → 0 (true) iff the deployed copy's BYTES exactly
# match the file's HEAD-committed content (chat-review/sync-tools-clobber-content-check
# 2026-07-07). The DRIFT-DIRECTION GUARD further down is mtime-only (`dst -nt f` + clean tree) —
# any benign mtime skew (e.g. dst touched by the deploy step itself right after $f was checked
# out) fires a false [drift-clobber] even when dst is byte-identical to HEAD. Live case:
# phaedra's 16:00:19Z clobber alarm on mesh-mic-correlate — genome's own forensic diff found
# dst's md5 EXACTLY matched HEAD@a33f2fc, nothing was reverted, pure mtime-race false-positive.
# Compares against `git show HEAD:$1`, not the working-tree $f — the committed blob is the
# ground truth the mtime pre-filter is trying to approximate; a failed `git show` (any reason)
# makes cmp see empty stdin against a real file → "different" → fail-suspicious, still fires.
dst_matches_head() {
  git show "HEAD:$1" 2>/dev/null | cmp -s - "$2"
}

# _sc_fitness_revert_head <repo> [fitness_log] → 0 (true) iff repo's current HEAD is a
# mesh-fitness auto-revert (chat-review/syncstrand-fitness-revert-unsafe-reset): a `git reset
# --hard @{u}` at this point would discard the revert and restore the very regression fitness
# just undid. Detect via the most-recent fitness.log 'REVERTED ... -> <hash>' entry naming HEAD,
# OR HEAD's own commit message matching git-revert's standard header (mesh-fitness's auto-revert
# runs a plain `git revert --no-edit HEAD`, so its commit carries that header verbatim).
_sc_fitness_revert_head() {
  local repo="$1" flog="${2:-$MESH/fitness.log}" head msg target
  head="$(git -C "$repo" rev-parse HEAD 2>/dev/null)" || return 1
  if [ -f "$flog" ]; then
    target="$(grep 'REVERTED ' "$flog" 2>/dev/null | tail -n1 | sed -n 's/.*-> *\([0-9a-f]\{7,40\}\).*/\1/p')"
    [ -n "$target" ] && [[ "$head" == "$target"* ]] && return 0
  fi
  msg="$(git -C "$repo" log -1 --format=%B HEAD 2>/dev/null)"
  [[ "$msg" == 'Revert "'* ]] && [[ "$msg" == *"This reverts commit"* ]]
}

# _sc_reverted_hash <repo> [fitness_log] → prints the hash of the commit HEAD reverts (the commit
# reverted AWAY), needed to VERIFY whether that commit was actually broken. mesh-fitness auto-reverts
# with `git revert --no-edit HEAD` (mesh-fitness:425) so HEAD's message carries git's standard
# "This reverts commit <hash>" header — the primary, reliable source. Fallback: the most-recent
# fitness.log 'REVERTED <hash> (...) -> <new>' entry, where the hash right after REVERTED is the
# reverted-away commit (the '-> <new>' at the end is the revert commit / new HEAD, NOT this one).
_sc_reverted_hash() {
  local repo="$1" flog="${2:-$MESH/fitness.log}" msg h
  msg="$(git -C "$repo" log -1 --format=%B HEAD 2>/dev/null)"
  h="$(printf '%s\n' "$msg" | sed -n 's/.*This reverts commit \([0-9a-f]\{7,40\}\).*/\1/p' | head -n1)"
  if [ -z "$h" ] && [ -f "$flog" ]; then
    h="$(grep 'REVERTED ' "$flog" 2>/dev/null | tail -n1 | sed -n 's/.*REVERTED \([0-9a-f]\{7,40\}\).*/\1/p')"
  fi
  [ -n "$h" ] && printf '%s\n' "$h"
}

# _sc_revert_verdict <repo> <reverted_hash> → decide whether a fitness-reverted commit was ACTUALLY
# broken (chat-review/syncstrand-false-revert-push-regresses-origin). _sc_fitness_revert_head only
# DETECTS a revert-HEAD — it never checks whether the reverted commit was really regressive. A FALSE
# revert (stale local mesh-fitness reverting a healthy, already-upstream commit — the COMMON case,
# see the fitness-revert-plus-syncpush-regresses-origin memory: 3 today) then got the backwards
# "git push, do NOT reset" advice, which REGRESSES origin. Discriminate by running the reverted
# commit's OWN tool --test in place (rc 0 or 2 = honest n/a = NOT broken):
#   rc 1 → GENUINE regression: a reverted mesh-* tool's --test FAILS. Keep the push-not-reset remedy.
#   rc 0 → FALSE revert: every reverted tool --test PASSES **and** the commit is already an ancestor
#          of upstream (memory's AND condition — reset --hard origin/main is only safe when upstream
#          actually holds the good version, else the reset would discard it). Drop toward origin.
#   rc 2 → INCONCLUSIVE: no testable mesh-* tool in the reverted commit, or it looks healthy but is
#          NOT yet upstream. Neither push nor reset is provably safe → caller asks for manual verify.
# NOTE (deliberate divergence from the task's looser "passes/OR is-ancestor"): is-ancestor ALONE is
# not a false-revert signal — a GENUINE local revert of a broken commit that was already pushed is
# also an ancestor of upstream. The --test is the real discriminator; ancestry only gates whether a
# reset is safe. Grounded in the fitness-revert-plus-syncpush memory ("verified-healthy AND ancestor").
_sc_revert_verdict() {
  local repo="$1" rev="$2" files f tmp rc tested=0 any_fail=0 ref ancestor=0 upstream_ref="" failed_files=""
  [ -n "$rev" ] || return 2
  files="$(git -C "$repo" show --name-only --pretty=format: "$rev" 2>/dev/null | grep -E '(^|/)mesh-[^/[:space:]]*$' || true)"
  for f in $files; do
    case "$f" in *.md|*.service|*.timer|*.json|*.txt) continue ;; esac
    git -C "$repo" cat-file -e "$rev:$f" 2>/dev/null || continue
    tmp="$(sc_tmp)" || continue
    if git -C "$repo" show "$rev:$f" > "$tmp" 2>/dev/null; then
      chmod +x "$tmp" 2>/dev/null
      rc=0
      if command -v timeout >/dev/null 2>&1; then timeout 60 "$tmp" --test >/dev/null 2>&1 || rc=$?
      else "$tmp" --test >/dev/null 2>&1 || rc=$?; fi
      tested=$((tested + 1))
      if [ "$rc" = 0 ] || [ "$rc" = 2 ]; then :; else any_fail=1; failed_files="$failed_files $f"; fi
    fi
    rm -f "$tmp"
  done
  # is the reverted commit already IN upstream, and which ref holds it? (needed by BOTH branches below)
  for ref in '@{u}' origin/main; do
    git -C "$repo" merge-base --is-ancestor "$rev" "$ref" 2>/dev/null && { ancestor=1; upstream_ref="$ref"; break; }
  done
  if [ "$tested" -gt 0 ] && [ "$any_fail" = 1 ]; then
    # The reverted SNAPSHOT fails its own --test. That alone USED to mean "genuine regression → push".
    # But it tests the tool AS OF the reverted commit — a STALE snapshot: a LATER upstream commit may
    # have already fixed that same tool, so the reverted-commit-in-isolation --test still fails while
    # origin/main HEAD is healthy, and pushing the revert would REGRESS origin (chat-review/
    # syncstrand-verdict-tests-stale-snapshot; live phaedra soundscape 80966a4 broken-in-isolation,
    # fixed upstream by 83bc3e3). So when rev is already upstream, re-test each FAILING tool against
    # UPSTREAM HEAD's version — if ALL now pass (rc 0/2, or the tool was deleted upstream), the fix is
    # upstream → FALSE revert, DROP not push. Keep return 1 only when upstream HEAD STILL fails.
    if [ "$ancestor" = 1 ]; then
      local head_all_pass=1 hf htmp hrc
      for hf in $failed_files; do
        git -C "$repo" cat-file -e "$upstream_ref:$hf" 2>/dev/null || continue   # deleted upstream → that fix landed
        htmp="$(sc_tmp)" || { head_all_pass=0; break; }
        if git -C "$repo" show "$upstream_ref:$hf" > "$htmp" 2>/dev/null; then
          chmod +x "$htmp" 2>/dev/null
          hrc=0
          if command -v timeout >/dev/null 2>&1; then timeout 60 "$htmp" --test >/dev/null 2>&1 || hrc=$?
          else "$htmp" --test >/dev/null 2>&1 || hrc=$?; fi
          { [ "$hrc" = 0 ] || [ "$hrc" = 2 ]; } || head_all_pass=0
        else
          head_all_pass=0
        fi
        rm -f "$htmp"
        [ "$head_all_pass" = 0 ] && break
      done
      [ "$head_all_pass" = 1 ] && return 0   # regression already fixed upstream → FALSE revert, DROP toward origin
    fi
    return 1   # not upstream, OR upstream HEAD still fails → genuine regression, keep push-not-reset
  fi
  # verified-healthy (or untestable): only advise reset toward upstream when the reverted commit is
  # actually IN upstream — otherwise reset --hard would throw the good version away.
  [ "$tested" -gt 0 ] && [ "$ancestor" = 1 ] && return 0   # all pass AND upstream holds it → FALSE revert
  return 2                                                  # can't confirm broken / can't safely reset
}

# genome_strand_reason <behind> <ahead> <dirtyn> <repo> [fitness_log] → prints "reason<TAB>remedy"
# (chat-review/syncstrand-blind-to-ahead-divergence 2026-07-08): the strand guard used to compute
# only `behind` and always suggest the stash+pull --ff-only remedy — but that remedy is a no-op
# when local HEAD has ALSO diverged (ahead>0): a --ff-only pull can never succeed against diverged
# history, so the alert kept re-firing every cycle while never telling anyone the real fix. Live
# case: Default-string ahead 1 behind 85 (unpushed 124178b, docs/epistemics.md conflict) — the
# strand grew 76->85 all session because the posted remedy could never actually resolve it.
genome_strand_reason() {
  local behind="$1" ahead="$2" dirtyn="$3" repo="$4" flog="${5:-$MESH/fitness.log}" reason remedy
  if [ "${ahead:-0}" -gt 0 ]; then
    if _sc_fitness_revert_head "$repo" "$flog"; then
      local rev; rev="$(_sc_reverted_hash "$repo" "$flog")"
      _sc_revert_verdict "$repo" "$rev"
      case $? in
        1) # reverted tool's --test FAILS → GENUINE regression: pushing the revert is correct
          reason="DIVERGED (ahead ${ahead}, behind ${behind}) — local HEAD is a mesh fitness-revert protecting a regression (reverted commit ${rev:0:8}'s --test FAILS)"
          remedy="local fitness-revert protecting a regression; git push, do NOT reset --hard" ;;
        0) # reverted commit verified-healthy AND already upstream → FALSE revert: dropping it is correct
          reason="DIVERGED (ahead ${ahead}, behind ${behind}) — local HEAD is a mesh fitness-revert of a VERIFIED-HEALTHY commit (${rev:0:8}) already in upstream (FALSE revert)"
          remedy="stale false-revert: git reset --hard origin/main to DROP it; do NOT push (pushing regresses origin)" ;;
        *) # cannot confirm the revert real or false, or reset would be unsafe → verify, don't guess
          reason="DIVERGED (ahead ${ahead}, behind ${behind}) — local HEAD is a mesh fitness-revert but the reverted commit (${rev:0:8}) is NOT confirmed broken"
          remedy="VERIFY first: run the reverted tool's --test — if it PASSES, git reset --hard origin/main to DROP (false revert); if it FAILS, git push. Do NOT blindly push a revert" ;;
      esac
    else
      reason="DIVERGED (ahead ${ahead}, behind ${behind}) — dirty-tree remedy will NOT resolve this"
      remedy="needs manual reconcile: git log @{u}..HEAD then push or git reset --hard @{u}"
    fi
  else
    reason="genome ${behind} commit(s) behind upstream, FF blocked"
    [ "${dirtyn:-0}" -gt 0 ] && reason="$reason (dirty tree: ${dirtyn} uncommitted file(s))"
    remedy="stash/commit the dirty file(s) then 'git -C ${repo} pull --ff-only'"
  fi
  printf '%s\t%s\n' "$reason" "$remedy"
}

if [ "${1:-}" = --test ]; then
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v cp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cp)"; exit 1; }
  command -v chmod >/dev/null 2>&1 || { echo "smoke-test: FAIL (no chmod)"; exit 1; }
  command -v diff >/dev/null 2>&1 || { echo "smoke-test: FAIL (no diff)"; exit 1; }
  command -v mkdir >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mkdir)"; exit 1; }
  command -v cat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v rm >/dev/null 2>&1 || { echo "smoke-test: FAIL (no rm)"; exit 1; }
  [ -d "$REPO" ] && [ -d "$REPO/scripts" ] || { echo "smoke-test: FAIL (no repo/scripts)"; exit 1; }
  # strand_gate_decide (chat-review/strand-cooldown): first strand posts; count-change WITHIN
  # cooldown holds (the 62-post flood); count-change AFTER cooldown posts; frozen count never
  # re-posts; legacy single-field state converts and posts once.
  _sg="$(mktemp -d)"; _sgf="$_sg/strand"
  [ "$(strand_gate_decide 5 "$_sgf" 7200 1000000)" = POST ] || { rm -rf "$_sg"; echo "smoke-test: FAIL (strand gate: first strand must POST)"; exit 1; }
  [ "$(strand_gate_decide 6 "$_sgf" 7200 1000600)" = HOLD ] || { rm -rf "$_sg"; echo "smoke-test: FAIL (strand gate: count-change within cooldown must HOLD — flood regressed)"; exit 1; }
  [ "$(strand_gate_decide 8 "$_sgf" 7200 1007300)" = POST ] || { rm -rf "$_sg"; echo "smoke-test: FAIL (strand gate: count-change after cooldown must POST)"; exit 1; }
  [ "$(strand_gate_decide 8 "$_sgf" 7200 1020000)" = HOLD ] || { rm -rf "$_sg"; echo "smoke-test: FAIL (strand gate: frozen count must never re-POST)"; exit 1; }
  printf '12\n' > "$_sgf"
  [ "$(strand_gate_decide 13 "$_sgf" 7200 1000000)" = POST ] || { rm -rf "$_sg"; echo "smoke-test: FAIL (strand gate: legacy single-field state must convert+POST)"; exit 1; }
  grep -q '^13 1000000$' "$_sgf" || { rm -rf "$_sg"; echo "smoke-test: FAIL (strand gate: state must persist 'behind epoch')"; exit 1; }
  rm -rf "$_sg"
  # strand_gate_key (chat-review/strand-gate-diverged-reposts): a DIVERGED strand (ahead>0) must key
  # on the local HEAD sha (divergence identity), NOT the steward-grown behind-count, so it posts once
  # and re-posts only when local HEAD actually moves. An FF-blocked strand (ahead==0) keeps
  # behind-count keying. Drive the key selection + gate end-to-end (falsifies the old behind:ahead key).
  _sk="$(mktemp -d)"; _skf="$_sk/strand"
  # (a) DIVERGED, unchanged HEAD, behind grows 3→10 → POST once then HOLD (was: re-POST every cooldown)
  [ "$(strand_gate_key 3 1 abc123)" = "diverged:abc123" ] || { rm -rf "$_sk"; echo "smoke-test: FAIL (strand_gate_key: ahead>0 must key on HEAD sha)"; exit 1; }
  [ "$(strand_gate_decide "$(strand_gate_key 3 1 abc123)" "$_skf" 7200 1000000)" = POST ] || { rm -rf "$_sk"; echo "smoke-test: FAIL (diverged gate: first divergence must POST)"; exit 1; }
  [ "$(strand_gate_decide "$(strand_gate_key 10 1 abc123)" "$_skf" 7200 1009000)" = HOLD ] || { rm -rf "$_sk"; echo "smoke-test: FAIL (diverged gate: behind grows but HEAD unchanged past cooldown must HOLD — the board-spam bug)"; exit 1; }
  # (b) local HEAD changes (someone reconciled → new divergence) past cooldown → POST again
  [ "$(strand_gate_decide "$(strand_gate_key 11 1 def456)" "$_skf" 7200 1020000)" = POST ] || { rm -rf "$_sk"; echo "smoke-test: FAIL (diverged gate: local HEAD change must re-POST)"; exit 1; }
  rm -rf "$_sk"
  # (c) ahead==0 (FF-blocked, self-resolving): key stays the behind-count so a grown strand re-alerts
  _sk2="$(mktemp -d)"; _skf2="$_sk2/strand"
  [ "$(strand_gate_key 5 0 abc123)" = "5" ] || { rm -rf "$_sk2"; echo "smoke-test: FAIL (strand_gate_key: ahead==0 must key on behind-count)"; exit 1; }
  [ "$(strand_gate_decide "$(strand_gate_key 5 0 abc123)" "$_skf2" 7200 1000000)" = POST ] || { rm -rf "$_sk2"; echo "smoke-test: FAIL (ff-blocked gate: first strand must POST)"; exit 1; }
  [ "$(strand_gate_decide "$(strand_gate_key 8 0 abc123)" "$_skf2" 7200 1008000)" = POST ] || { rm -rf "$_sk2"; echo "smoke-test: FAIL (ff-blocked gate: grown behind after cooldown must still POST — FF-blocked keeps behind keying)"; exit 1; }
  rm -rf "$_sk2"
  # genome_strand_reason (chat-review/syncstrand-blind-to-ahead-divergence): behind-only keeps the
  # original FF-pull remedy; behind+ahead (DIVERGED) must switch to the manual-reconcile remedy —
  # the stash+pull --ff-only remedy can never succeed against diverged history.
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 5 0 0 /tmp/repo)"
  [[ "$_r" == genome\ 5\ commit* ]] || { echo "smoke-test: FAIL (genome_strand_reason: behind-only reason text changed)"; exit 1; }
  [[ "$_m" == "stash/commit"* ]] || { echo "smoke-test: FAIL (genome_strand_reason: behind-only remedy must stay the FF-pull remedy)"; exit 1; }
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 85 1 0 /tmp/repo)"
  [[ "$_r" == DIVERGED* ]] || { echo "smoke-test: FAIL (genome_strand_reason: ahead>0 must report DIVERGED, not the plain behind reason)"; exit 1; }
  [[ "$_m" == "needs manual reconcile"* ]] || { echo "smoke-test: FAIL (genome_strand_reason: ahead>0 must NOT suggest the dirty-tree/FF-pull remedy)"; exit 1; }
  # genome_strand_reason fitness-revert VERIFICATION (chat-review/syncstrand-false-revert-push-
  # regresses-origin): _sc_fitness_revert_head only DETECTS a revert-HEAD — it never checks whether
  # the reverted commit was actually broken, so a FALSE revert (stale local mesh-fitness reverting a
  # healthy, already-upstream commit — the common case: 3 today) got the backwards "push, do NOT
  # reset" advice, which REGRESSES origin. The remedy must now be decided by running the reverted
  # commit's OWN tool --test (rc 0/2 = NOT broken) AND upstream ancestry (memory: verified-healthy
  # AND already-in-upstream → drop). Three falsifiable cases below.
  #
  # (c) ordinary ahead (NOT a mesh-fitness revert) → generic manual-reconcile remedy, unchanged.
  _frc0="$(mktemp -d)"
  ( cd "$_frc0" && git init --quiet && git config user.email t@t && git config user.name t \
      && printf 'v1\n' > f && git add f && git commit --quiet -m first \
      && printf 'v2\n' > f && git commit --quiet -am 'ordinary work' )
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 5 1 0 "$_frc0")"
  [[ "$_m" == "needs manual reconcile"* ]] || { rm -rf "$_frc0"; echo "smoke-test: FAIL (genome_strand_reason: ordinary ahead commit must keep the generic manual-reconcile remedy)"; exit 1; }
  rm -rf "$_frc0"
  # (a) FALSE revert — HEAD reverts a HEALTHY commit (--test exits 0) that is already in upstream →
  # remedy MUST be 'reset --hard origin/main to DROP', NOT push (pushing the revert regresses origin).
  _fra="$(mktemp -d)"
  ( cd "$_fra" && git init --quiet && git config user.email t@t && git config user.name t \
      && git commit --quiet --allow-empty -m base && mkdir -p scripts \
      && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo ok; exit 0; }\nexit 0\n' > scripts/mesh-fixture \
      && chmod +x scripts/mesh-fixture && git add scripts/mesh-fixture && git commit --quiet -m 'add mesh-fixture (healthy)' \
      && git update-ref refs/remotes/origin/main HEAD \
      && git revert --no-edit --quiet HEAD >/dev/null 2>&1 )
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 5 1 0 "$_fra")"
  [[ "$_r" == *"FALSE revert"* ]] || { rm -rf "$_fra"; echo "smoke-test: FAIL (genome_strand_reason: revert of a verified-healthy upstream commit must be named a FALSE revert, got: $_r)"; exit 1; }
  [[ "$_m" == *"reset --hard origin/main"* && "$_m" == *"do NOT push"* ]] || { rm -rf "$_fra"; echo "smoke-test: FAIL (genome_strand_reason: FALSE revert must advise DROP via reset --hard origin/main + do NOT push — pushing regresses origin, got: $_m)"; exit 1; }
  rm -rf "$_fra"
  # (b) GENUINE revert — HEAD reverts a BROKEN commit (--test exits 1); even though the commit is an
  # ancestor of upstream (proving is-ancestor ALONE would misclassify), the failing --test keeps the
  # 'push, do NOT reset' remedy so a real regression is not restored.
  _frb="$(mktemp -d)"
  ( cd "$_frb" && git init --quiet && git config user.email t@t && git config user.name t \
      && git commit --quiet --allow-empty -m base && mkdir -p scripts \
      && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo broken; exit 1; }\nexit 0\n' > scripts/mesh-fixture \
      && chmod +x scripts/mesh-fixture && git add scripts/mesh-fixture && git commit --quiet -m 'add mesh-fixture (broken)' \
      && git update-ref refs/remotes/origin/main HEAD \
      && git revert --no-edit --quiet HEAD >/dev/null 2>&1 )
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 5 1 0 "$_frb")"
  [[ "$_r" == *regression* ]] || { rm -rf "$_frb"; echo "smoke-test: FAIL (genome_strand_reason: revert of a --test-FAILING commit must be named a genuine regression, got: $_r)"; exit 1; }
  [[ "$_m" == *"do NOT reset --hard"* && "$_m" == *push* ]] || { rm -rf "$_frb"; echo "smoke-test: FAIL (genome_strand_reason: GENUINE revert (failing --test) must keep push-not-reset even though the commit is upstream, got: $_m)"; exit 1; }
  rm -rf "$_frb"
  # (b3) STALE-SNAPSHOT regression (chat-review/syncstrand-verdict-tests-stale-snapshot): the reverted
  # commit's OWN tool --test FAILS in isolation, but a LATER upstream commit already FIXED that tool so
  # origin/main HEAD's version PASSES and the reverted commit is an ancestor of upstream → the fix is
  # upstream → DROP (reset --hard origin/main), NOT push (pushing the stale revert regresses origin —
  # live phaedra soundscape 80966a4 broken-in-isolation, fixed upstream by 83bc3e3). This is the case
  # the old any_fail→return-1 got backwards. Falsify: revert _sc_revert_verdict to `return 1` on
  # any_fail and this flips to 'push', restoring the origin-regressing advice.
  _frx="$(mktemp -d)"
  ( cd "$_frx" && git init --quiet && git config user.email t@t && git config user.name t \
      && git commit --quiet --allow-empty -m base && mkdir -p scripts \
      && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo broken-in-isolation; exit 1; }\nexit 0\n' > scripts/mesh-fixture \
      && chmod +x scripts/mesh-fixture && git add scripts/mesh-fixture && git commit --quiet -m 'add mesh-fixture (broken in isolation)' )
  _frx_broken="$(cd "$_frx" && git rev-parse HEAD)"
  ( cd "$_frx" && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo fixed-upstream; exit 0; }\nexit 0\n' > scripts/mesh-fixture \
      && git commit --quiet -am 'fix mesh-fixture upstream (later commit)' \
      && git update-ref refs/remotes/origin/main HEAD )
  _frx_head="$(cd "$_frx" && git rev-parse HEAD)"
  _frx_flog="$_frx/fitness.log"
  echo "2026-07-11T00:00:00Z REVERTED $_frx_broken (mesh-fixture stale-snapshot) — fitness drop -> $_frx_head" > "$_frx_flog"
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 19 1 0 "$_frx" "$_frx_flog")"
  [[ "$_r" == *"FALSE revert"* ]] || { rm -rf "$_frx"; echo "smoke-test: FAIL (genome_strand_reason: stale-snapshot revert whose tool is FIXED upstream must be classed a FALSE revert, got: $_r)"; exit 1; }
  [[ "$_m" == *"reset --hard origin/main"* && "$_m" == *"do NOT push"* ]] || { rm -rf "$_frx"; echo "smoke-test: FAIL (genome_strand_reason: reverted tool fails in ISOLATION but origin HEAD's version PASSES + is-ancestor → must DROP via reset --hard origin/main, NOT push the origin-regressing stale revert, got: $_m)"; exit 1; }
  rm -rf "$_frx"
  # (b2) same FALSE-revert verdict via fitness.log detection: HEAD's message is ordinary (not a git
  # revert header), but the most-recent fitness.log 'REVERTED <hash> ... -> <HEAD>' names a healthy,
  # already-upstream commit → drop, not push.
  _frd="$(mktemp -d)"
  ( cd "$_frd" && git init --quiet && git config user.email t@t && git config user.name t \
      && git commit --quiet --allow-empty -m base && mkdir -p scripts \
      && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && exit 0\nexit 0\n' > scripts/mesh-fixture \
      && chmod +x scripts/mesh-fixture && git add scripts/mesh-fixture && git commit --quiet -m 'add mesh-fixture' )
  _frd_healthy="$(cd "$_frd" && git rev-parse HEAD)"
  ( cd "$_frd" && git update-ref refs/remotes/origin/main HEAD \
      && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && exit 0\nexit 0\n# tweak\n' > scripts/mesh-fixture \
      && git commit --quiet -am 'restored tool' )
  _frd_head="$(cd "$_frd" && git rev-parse HEAD)"
  _frd_flog="$_frd/fitness.log"
  echo "2026-07-08T00:00:00Z REVERTED $_frd_healthy (mesh-fixture false-drop) — fitness drop, clean revert -> $_frd_head" > "$_frd_flog"
  IFS=$'\t' read -r _r _m <<<"$(genome_strand_reason 5 1 0 "$_frd" "$_frd_flog")"
  [[ "$_m" == *"reset --hard origin/main"* ]] || { rm -rf "$_frd"; echo "smoke-test: FAIL (genome_strand_reason: fitness.log-detected revert of a healthy upstream commit must also advise DROP via reset --hard origin/main, got: $_m)"; exit 1; }
  rm -rf "$_frd"
  # dst_matches_head (chat-review/sync-tools-clobber-content-check 2026-07-07): the DRIFT-DIRECTION
  # GUARD's outer gates (line-diff differs + git-diff-quiet clean) already guarantee dst≠HEAD in
  # the race-free case, so this false-positive only manifests in the exact mtime-race the fix
  # targets — not deterministically reproducible through the full --apply integration below.
  # Unit-test the extracted comparison directly against a real git repo instead. Falsify: revert
  # dst_matches_head to always return 1 (as if the check never existed) and the first case flips.
  _dm="$(mktemp -d)"
  ( cd "$_dm" && git init --quiet && git commit --quiet --allow-empty -m init \
      && printf 'same content\n' > tool && git add tool && git commit --quiet -m t )
  printf 'same content\n' > "$_dm/deployed-same"
  printf 'DIFFERENT content\n' > "$_dm/deployed-diff"
  ( cd "$_dm" && dst_matches_head tool "$_dm/deployed-same" ) \
    || { rm -rf "$_dm"; echo "smoke-test: FAIL (dst_matches_head: byte-identical content should match HEAD)"; exit 1; }
  ( cd "$_dm" && dst_matches_head tool "$_dm/deployed-diff" ) \
    && { rm -rf "$_dm"; echo "smoke-test: FAIL (dst_matches_head: diverged content should NOT match HEAD)"; exit 1; }
  ( cd "$_dm" && dst_matches_head nonexistent-file "$_dm/deployed-same" ) \
    && { rm -rf "$_dm"; echo "smoke-test: FAIL (dst_matches_head: an unreadable git-show target must fail-suspicious, not match)"; exit 1; }
  rm -rf "$_dm"
  TMP="$(mktemp -d -t mesh-sync-tools-test.XXXXXXXX)"   # cleaned by the process-wide trap above
  mkdir -p "$TMP/repo/scripts" "$TMP/home/.local/bin" "$TMP/home/.mesh"
  ( cd "$TMP/repo" && git init --quiet && git commit --quiet --allow-empty -m init )
  cp "$0" "$TMP/repo/scripts/mesh-sync-tools"
  chmod +x "$TMP/repo/scripts/mesh-sync-tools"
  cat > "$TMP/repo/scripts/mesh-sync-tools-good" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-good"
  cat > "$TMP/repo/scripts/mesh-sync-tools-bad" <<'EOF'
#!/usr/bin/env bash
if then
  echo broken
fi
EOF
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-bad"
  # SHEBANG-GATE (chat-review/synctools-parse-shebang-gate): a non-shell, non-shebang file (the real
  # incident was mesh-imac-cam.m, Objective-C) must NOT be bash -n'd — it has no shebang, so it must
  # deploy clean rather than false-[drift-skip]. Its body would fail bash -n if ever mis-parsed.
  cat > "$TMP/repo/scripts/mesh-sync-tools-objc.m" <<'EOF'
// not a shell script; would fail bash -n if the parse gate ever mis-targeted it
@interface Foo : NSObject
- (void)bar:(int)x with:(int)y;
@end
EOF
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-objc.m"
  # FORENSICS ON THE DEPLOY ASSERTIONS (2026-08-20). doctor's serial-confirm caught this suite
  # FAIL(real) twice at 20:26:35Z with the whole evidence being the words "good fixture not
  # deployed" — an assertion, not a cause. The apply's own $LOG ($TMP/home/.mesh/sync-tools.log)
  # DOES distinguish the three ways that assertion can be reached (SKIP = parse_ok said no /
  # DEPLOY-FAIL = the atomic write lost / neither line at all = the loop never considered the
  # file), and the trap deletes it milliseconds later, so the one artifact that separates them is
  # destroyed by the run that needed it. It was not reproducible afterwards (12 parallel + 3 serial
  # runs, all green), which is exactly the case where the next occurrence is the only chance:
  # capture the apply's stderr and dump the log + the target listing at the failure edge.
  # [[a-confirmed-failure-that-leaves-no-evidence-cannot-be-diagnosed]]
  _ap_out="$TMP/apply.out"
  _st_forensics(){   # <assertion text>
    echo "smoke-test: FAIL ($1)"
    echo "  --- apply stdout/stderr ---"; [ -s "$_ap_out" ] && sed 's/^/  /' "$_ap_out" | tail -20 || echo "  (empty)"
    echo "  --- fixture sync-tools.log (SKIP=parse gate · DEPLOY-FAIL=atomic write · absent=never considered) ---"
    [ -s "$TMP/home/.mesh/sync-tools.log" ] && sed 's/^/  /' "$TMP/home/.mesh/sync-tools.log" | tail -20 || echo "  (no log written)"
    echo "  --- deployed: ---"; ls -la "$TMP/home/.local/bin" 2>&1 | sed 's/^/  /'
    echo "  --- genome side: ---"; ls -la "$TMP/repo/scripts" 2>&1 | sed 's/^/  /'
    echo "  --- df $TMP: ---"; df -h "$TMP" 2>&1 | sed 's/^/  /'
  }
  HOME="$TMP/home" MESH_REPO="$TMP/repo" PATH="$TMP/home/.local/bin:$PATH" "$TMP/repo/scripts/mesh-sync-tools" --apply >"$_ap_out" 2>&1 \
    || { _st_forensics "fixture apply failed"; exit 1; }
  [ -x "$TMP/home/.local/bin/mesh-sync-tools-good" ] || { _st_forensics "good fixture not deployed"; exit 1; }
  [ ! -e "$TMP/home/.local/bin/mesh-sync-tools-bad" ] || { _st_forensics "bad fixture should have been skipped"; exit 1; }
  [ -e "$TMP/home/.local/bin/mesh-sync-tools-objc.m" ] || { _st_forensics "shebang-less non-script false-skipped — extension-allowlist regression"; exit 1; }

  # --- WIP-WINDOW suppression (chat-review/sync-tools-wip-v4) ---
  # FALSIFIABLE by contrast: two tools, both genuine genome→local drift, differ ONLY in commit age.
  #  • -old : committed 2h ago  → MUST be reported as drift (a real stuck deploy).
  #  • -wip : committed just now → must NOT be reported (active iteration), but MUST still deploy on --apply.
  # If suppression is dropped, -wip leaks into the report → FAIL. If it over-suppresses by name not age,
  # -old vanishes → FAIL. If it wrongly blocks --apply, the deploy assert → FAIL.
  for t in old wip; do
    printf '#!/usr/bin/env bash\necho NEW\n' > "$TMP/repo/scripts/mesh-sync-tools-$t"; chmod +x "$TMP/repo/scripts/mesh-sync-tools-$t"
    printf '#!/usr/bin/env bash\necho OLD\n' > "$TMP/home/.local/bin/mesh-sync-tools-$t"; chmod +x "$TMP/home/.local/bin/mesh-sync-tools-$t"  # stale deployed → real drift
  done
  _olddate="$(date -d '2 hours ago' '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S')"
  ( cd "$TMP/repo" && git add scripts/mesh-sync-tools-old \
      && GIT_AUTHOR_DATE="$_olddate" GIT_COMMITTER_DATE="$_olddate" git commit --quiet -m old-deploy )
  ( cd "$TMP/repo" && git add scripts/mesh-sync-tools-wip && git commit --quiet -m wip-recent )
  # Ensure genome copies are NEWER than the stale deployed copies (else the deployed-newer guard skips
  # them before the WIP check). touch bumps working-tree mtime only — commit DATE (what --since reads)
  # is untouched, so -old stays "2h ago".
  touch "$TMP/repo/scripts/mesh-sync-tools-old" "$TMP/repo/scripts/mesh-sync-tools-wip"
  rlog="$TMP/home/.mesh/sync-tools.log"; : > "$rlog" 2>/dev/null || true
  HOME="$TMP/home" MESH_REPO="$TMP/repo" PATH="$TMP/home/.local/bin:$PATH" "$TMP/repo/scripts/mesh-sync-tools" >/dev/null 2>&1
  dline="$(grep '^.*DRIFT:' "$rlog" 2>/dev/null | tail -1 || true)"
  grep -q 'mesh-sync-tools-old' <<<"$dline" || { echo "smoke-test: FAIL (old-committed drift NOT reported — WIP window over-suppresses by name, real stuck deploys go silent)"; exit 1; }
  grep -q 'mesh-sync-tools-wip' <<<"$dline" && { echo "smoke-test: FAIL (recently-committed tool reported as drift — WIP-window suppression broken, board floods on active iteration)"; exit 1; }
  HOME="$TMP/home" MESH_REPO="$TMP/repo" PATH="$TMP/home/.local/bin:$PATH" "$TMP/repo/scripts/mesh-sync-tools" --apply >/dev/null 2>&1
  grep -q 'echo NEW' "$TMP/home/.local/bin/mesh-sync-tools-wip" 2>/dev/null || { echo "smoke-test: FAIL (--apply did not deploy recently-committed tool — suppression wrongly blocks deploy)"; exit 1; }

  # --- DRIFT-CLOBBER still protects a GENUINE local-only fix (chat-review/sync-tools-clobber-
  # content-check 2026-07-07) --- a real end-to-end regression guard alongside the dst_matches_head
  # unit test above: content that ACTUALLY diverges from HEAD (dst mtime-newer, genome tree clean)
  # must still fire [drift-clobber] and keep the local fix on disk, unoverwritten. Mock mesh-chat
  # (found first — $TMP/home/.local/bin is prepended to PATH) so this never posts to the real board.
  cat > "$TMP/home/.local/bin/mesh-chat" <<'MOCKEOF'
#!/usr/bin/env bash
# MOCK_CHAT_SLEEP widens the read→post→persist window so the STATE-race fixture below
# overlaps two runs deterministically instead of betting on a millisecond race.
[ -n "${MOCK_CHAT_SLEEP:-}" ] && sleep "$MOCK_CHAT_SLEEP"
printf '%s\n' "$*" >> "${MOCK_CHAT_LOG:-/dev/null}"
MOCKEOF
  chmod +x "$TMP/home/.local/bin/mesh-chat"
  MOCK_CHAT_LOG="$TMP/mock-chat.log"; : > "$MOCK_CHAT_LOG"
  printf '#!/usr/bin/env bash\necho ORIGINAL\n' > "$TMP/repo/scripts/mesh-sync-tools-diverged"
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-diverged"
  ( cd "$TMP/repo" && git add scripts/mesh-sync-tools-diverged && git commit --quiet -m diverged )
  sleep 1.1   # coarse (1s-resolution) filesystems need a real gap for the deployed copy to be -nt
  printf '#!/usr/bin/env bash\necho LOCAL-ONLY-FIX\n' > "$TMP/home/.local/bin/mesh-sync-tools-diverged"
  chmod +x "$TMP/home/.local/bin/mesh-sync-tools-diverged"
  touch "$TMP/home/.local/bin/mesh-sync-tools-diverged"   # ensure dst -nt genome file
  HOME="$TMP/home" MESH_REPO="$TMP/repo" PATH="$TMP/home/.local/bin:$PATH" MOCK_CHAT_LOG="$MOCK_CHAT_LOG" \
    "$TMP/repo/scripts/mesh-sync-tools" --apply >/dev/null 2>&1
  grep -q 'echo LOCAL-ONLY-FIX' "$TMP/home/.local/bin/mesh-sync-tools-diverged" \
    || { echo "smoke-test: FAIL (genuinely-diverged local fix got overwritten — clobber protection broken)"; exit 1; }
  ls "$TMP/home/.mesh/tools-backup/"mesh-sync-tools-diverged.genome.* >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (diverged fixture: no genome backup left in tools-backup)"; exit 1; }
  grep -q 'drift-clobber.*mesh-sync-tools-diverged' "$MOCK_CHAT_LOG" 2>/dev/null \
    || { echo "smoke-test: FAIL (genuinely-diverged local fix did not fire [drift-clobber] — real clobbers must still alarm, got: $(cat "$MOCK_CHAT_LOG" 2>/dev/null)"; exit 1; }

  # --- STATE-RACE lock (chat-review/sync-tools-state-race-no-lock 2026-07-21) ---
  # Two overlapping --apply runs each read the same stale prev_clobber (line2 of $STATE) before
  # either write lands → both post the identical [drift-clobber] (live: 4x ~140-tool board spam,
  # dual-cron phaedra 14:00-15:00Z). Drive the REAL race, not a source grep: widen the
  # read→post→persist window with a slow mock mesh-chat (MOCK_CHAT_SLEEP=2) and launch two applies
  # in parallel on a fresh clobber. The flock serializes them — run B blocks until run A's STATE
  # write lands, reads clobber==prev_clobber, stays silent → exactly ONE post. Falsify: drop the
  # flock and both runs read the stale prev → 2 identical posts → FAIL. (Seen red 2026-07-21.)
  : > "$MOCK_CHAT_LOG"
  printf '#!/usr/bin/env bash\necho GENOME-V1\n' > "$TMP/repo/scripts/mesh-sync-tools-raced"
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-raced"
  ( cd "$TMP/repo" && git add scripts/mesh-sync-tools-raced && git commit --quiet -m raced )
  sleep 1.1   # coarse-fs gap so the deployed copy is genuinely -nt the genome copy
  printf '#!/usr/bin/env bash\necho LOCAL-RACED-FIX\n' > "$TMP/home/.local/bin/mesh-sync-tools-raced"
  chmod +x "$TMP/home/.local/bin/mesh-sync-tools-raced"
  for _i in 1 2; do
    HOME="$TMP/home" MESH_REPO="$TMP/repo" PATH="$TMP/home/.local/bin:$PATH" \
      MOCK_CHAT_LOG="$MOCK_CHAT_LOG" MOCK_CHAT_SLEEP=2 \
      "$TMP/repo/scripts/mesh-sync-tools" --apply >/dev/null 2>&1 &
  done
  wait
  _races="$(grep -c 'drift-clobber' "$MOCK_CHAT_LOG" 2>/dev/null || true)"
  [ "$_races" = 1 ] || { echo "smoke-test: FAIL (STATE race: expected exactly 1 [drift-clobber] from 2 concurrent applies, got $_races — unlocked prev_clobber read reposts the same alarm)"; exit 1; }

  # --- MARKER ROUTING (chat-review/drift-cleared-to-trace) ---
  # The [drift] open and its [drift-cleared] close are ONE alarm pair → both on mesh-trace (durable
  # history); only the DANGEROUS markers ([drift-clobber] reverted-a-fix, [drift-skip] broken-at-HEAD)
  # stay on the board. Static + falsifiable: revert any routing and the matching assert FAILs.
  grep -Eq 'mesh-trace "\[drift-cleared\]' "$0" || { echo "smoke-test: FAIL ([drift-cleared] not on mesh-trace — alarm open/close split across channels)"; exit 1; }
  grep -Eq 'mesh-chat "\[drift-cleared\]'  "$0" && { echo "smoke-test: FAIL ([drift-cleared] still on mesh-chat — benign close pollutes the board)"; exit 1; }
  grep -Eq 'mesh-trace "\[drift\]'         "$0" || { echo "smoke-test: FAIL ([drift] open not on mesh-trace — pair-channel broken)"; exit 1; }
  grep -Eq 'mesh-chat "\[drift-clobber\]'  "$0" || { echo "smoke-test: FAIL ([drift-clobber] must stay on the board)"; exit 1; }
  grep -Eq 'mesh-chat "\[drift-skip\]'     "$0" || { echo "smoke-test: FAIL ([drift-skip] must stay on the board)"; exit 1; }

  # --- TEMP-LEAK gates (2026-08-15, phaedra 100%-/tmp incident) ---
  # (L1) WHERE the staged copy lands. _sc_revert_verdict runs a reverted tool's --test from a temp
  # copy; if that copy is a bare top-level mktemp, nothing but the next statement removes it. Assert
  # BEHAVIOURALLY, not by reading the source: the fixture tool records its own $0 when run, so the
  # test learns the actual path the verdict staged it at, and requires it to be inside the
  # trap-covered scratch dir. Falsify: change sc_tmp back to a bare `mktemp` and this goes red.
  _lk="$(mktemp -d -t mesh-sync-tools-test.XXXXXXXX)"
  _lk_marker="$_lk/where"
  ( cd "$_lk" && git init --quiet && git config user.email t@t && git config user.name t \
      && git commit --quiet --allow-empty -m base && mkdir -p scripts \
      && printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { printf "%%s" "$0" > "%s"; exit 0; }\nexit 0\n' "$_lk_marker" > scripts/mesh-fixture-where \
      && chmod +x scripts/mesh-fixture-where && git add scripts/mesh-fixture-where \
      && git commit --quiet -m 'add mesh-fixture-where' )
  _lk_rev="$(cd "$_lk" && git rev-parse HEAD)"
  _sc_revert_verdict "$_lk" "$_lk_rev" >/dev/null 2>&1 || true
  _lk_where="$(cat "$_lk_marker" 2>/dev/null || true)"
  [ -n "$_lk_where" ] || { rm -rf "$_lk"; echo "smoke-test: FAIL (temp-leak L1: the reverted tool's --test never ran — the gate would be vacuous)"; exit 1; }
  case "$_lk_where" in
    "$SC_TMPD"/*) : ;;
    *) rm -rf "$_lk"; echo "smoke-test: FAIL (temp-leak L1: staged copy landed at '$_lk_where', OUTSIDE the trap-covered scratch $SC_TMPD — a kill mid---test strands it, which is how phaedra reached 59,234 leaked temps)"; exit 1 ;;
  esac
  # and nothing is left behind in the scratch dir after a NORMAL return
  _lk_left="$(find "$SC_TMPD" -mindepth 1 2>/dev/null | wc -l)"
  [ "$_lk_left" = 0 ] || { rm -rf "$_lk"; echo "smoke-test: FAIL (temp-leak L1: $_lk_left entr(y|ies) left in $SC_TMPD after _sc_revert_verdict returned)"; exit 1; }
  rm -rf "$_lk"
  # (L2) the trap actually FIRES on a signal. Drive the REAL script (loop mode, sandboxed HOME/TMPDIR/
  # PATH so it cannot touch the live mesh or the board), TERM it, and assert its scratch dir is gone.
  # This is the half a `trap` line in the source cannot prove — and note what it does NOT cover:
  # SIGKILL is untrappable, so mesh-tmp-guard's bounded-age sweep remains the backstop for it.
  _lt="$(mktemp -d -t mesh-sync-tools-test.XXXXXXXX)"
  mkdir -p "$_lt/tmp" "$_lt/home" "$_lt/bin" "$_lt/repo"
  ( cd "$_lt/repo" && git init --quiet && git config user.email t@t && git config user.name t \
      && git commit --quiet --allow-empty -m base )
  # (report mode, not --loop: bash defers a trapped signal until the CURRENT foreground command
  # returns, and the loop's `sleep 60` would hold the TERM for a minute. -k is the belt: this gate
  # must never be able to hang the suite.)
  env -i HOME="$_lt/home" TMPDIR="$_lt/tmp" MESH_REPO="$_lt/repo" PATH="$_lt/bin:/usr/bin:/bin" \
      timeout -s TERM -k 5 1 bash "$0" >/dev/null 2>&1 || true
  _lt_left="$(find "$_lt/tmp" -maxdepth 1 -name 'mesh-sync-tools.*' 2>/dev/null | wc -l)"
  [ "$_lt_left" = 0 ] || { rm -rf "$_lt"; echo "smoke-test: FAIL (temp-leak L2: $_lt_left scratch dir(s) survived a run of the real script (TERM at 1s) — nothing but the trap removes SC_TMPD, so this is the trap not firing)"; exit 1; }
  rm -rf "$_lt"

  echo "smoke-test: ok (+ temp-leak L1 staged-inside-scratch, L2 trap fires on SIGTERM)"
  exit 0
fi

# loop mode: supervisable long-running variant
if [ "${1:-}" = --loop ]; then
  iv="${2:-3600}"
  echo "[mesh-sync-tools] genome drift watch every ${iv}s on $(hostname)"
  while true; do
    : > "$MESH/mesh-sync-tools.beat"
    "$0" || true   # report mode; chat alert fires on drift
    # Heartbeat the beat file during the long sleep so the supervisor (1800s threshold)
    # doesn't falsely WEDGE a healthy 3600s loop mid-sleep.
    elapsed=0
    while [ "$elapsed" -lt "$iv" ]; do
      sleep 60; elapsed=$((elapsed + 60))
      : > "$MESH/mesh-sync-tools.beat"
    done
  done
  exit 0
fi

APPLY=0; [ "${1:-}" = --apply ] && APPLY=1

cd "$REPO" 2>/dev/null || { echo "$(ts) FAIL no repo $REPO" >>"$LOG"; exit 1; }
wip_files="$(git status --porcelain 2>/dev/null | cut -c4-)"
# refresh genome (best-effort; if it fails we still compare against on-disk scripts/)
pull_rc=0
git pull --ff-only --quiet 2>/dev/null || pull_rc=$?

# Detect and surface dirty files as an FF-block gap. A dirty tree doesn't block the CURRENT
# comparison (we compare ~/.local/bin against the local genome copy), but it WILL block the
# next git pull — which means the NEXT upstream commit silently strands, deployed tools go
# stale, and the hollow "in sync" conceals it. Surface dirtiness NOW, before the strand hits.
dirtyn=$(git -C "$REPO" status --porcelain 2>/dev/null | wc -l)
now_epoch=$(date +%s)
DIRTY_BACKOFF="${SYNC_DIRTY_BACKOFF:-7200}"
LAST_DIRTY="$MESH/.sync-dirty-last"
if [ "${dirtyn:-0}" -gt 0 ]; then
  echo "$(ts) DIRTY-TREE: ${dirtyn} uncommitted file(s) — will block future FF pull" >>"$LOG"
  last_dirty=$(cat "$LAST_DIRTY" 2>/dev/null || echo 0)
  # TIME-throttle that SURVIVES clean<->dirty flapping. The steward lands work every tick, so the tree
  # oscillates clean->dirty constantly. The earlier edge-trigger keyed on `-z last_hash` AND cleared
  # its state on every CLEAN cycle (the `else rm` below) — so each dirty RE-ENTRY found empty state and
  # re-fired a char-identical [genome-strand] minutes apart, defeating DIRTY_BACKOFF entirely (~28% of
  # the board; the 54f39c3 edge fix handled "stays dirty" but not "re-enters dirty" — novelty-review
  # 2026-06-19, repeats are low-surprise so per-event ranking missed the flood). Fix: gate purely on
  # elapsed time since the last alert, and DO NOT reset that timestamp when the tree goes briefly clean.
  # First-ever fire still works (last_dirty defaults to 0 >> backoff); a genuinely new strand after a
  # long-clean stretch also alerts promptly (elapsed >> backoff). No file-set hash needed.
  if [ $(( now_epoch - last_dirty )) -ge "$DIRTY_BACKOFF" ]; then
    echo "$now_epoch" > "$LAST_DIRTY"
    # PREDICTIVE dirty-tree nag (not yet stranded) → the durable TRACE tier, not the coordination
    # board. The steward lands work every tick, so the tree oscillates dirty constantly and this
    # fired ~72% of all [genome-strand] board lines (96/133) — pure metabolism, no mind coordinates
    # on it (no programmatic consumer greps it). Same de-noise pattern as [autowired]/[sense-evolve]/
    # [evaporated]/[reflexes-selfheal]→trace. The ACTUAL strand alarm (behind upstream, STALE tools,
    # hollow in-sync — below) STAYS on the board: that one is rare, actionable, and the whole reason
    # this reflex exists (the ds 12-commit silent-strand). chat-review/genome-strand-to-trace.
    command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-trace "[genome-strand] $(hostname): ${dirtyn} uncommitted file(s) WILL block next upstream pull — next genome push silently strands here. Resolve: commit or stash the dirty file(s) then 'git -C $REPO pull --ff-only'." >/dev/null 2>&1
  fi
fi
# NOTE: no clean-branch reset of LAST_DIRTY — keeping the timestamp across clean cycles is exactly
# what makes the throttle hold through the steward's land-every-tick oscillation.

# GENOME-STRAND guard: a --ff-only pull can SILENTLY fail (dirty tree, diverged history) — then we'd
# compare ~/.local/bin against a STALE genome and report a HOLLOW "in sync" while the node actually
# runs commits-behind tools. (ds hit this 2026-06-13: a dirty scripts/mesh-mind-state blocked the FF →
# 12 commits stranded → the entire fusion stack never deployed, yet every cycle logged "already in
# sync".) This reflex exists to make drift VISIBLE — so surface the strand instead of swallowing it.
behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
STRAND_STATE="$MESH/.genome-strand-state"
if [ "${behind:-0}" -gt 0 ]; then
  dirtyn=$(git status --porcelain 2>/dev/null | wc -l)
  IFS=$'\t' read -r reason remedy <<<"$(genome_strand_reason "$behind" "$ahead" "$dirtyn" "$REPO")"
  echo "$(ts) GENOME-STRAND $reason" >>"$LOG"
  # edge + cooldown: count-change alone re-fired every cycle while the steward lands (see
  # strand_gate_decide header) — board post needs BOTH a changed key and an expired cooldown.
  # Key selection (strand_gate_key): a DIVERGED strand (ahead>0) keys on local HEAD sha so the
  # steward-driven behind-count growth doesn't re-post an unchanged, manual-reconcile situation
  # every cooldown; an FF-blocked strand (ahead==0) keeps behind-count keying (self-resolving).
  _gate_key="$(strand_gate_key "$behind" "$ahead" "$(git rev-parse HEAD 2>/dev/null || echo unknown)")"
  if [ "$(strand_gate_decide "$_gate_key" "$STRAND_STATE" "${MESH_STRAND_COOLDOWN:-7200}" "$(date +%s)")" = POST ]; then
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-chat "[genome-strand] $(hostname): $reason — deployed tools are STALE, 'in sync' is HOLLOW. Resolve: $remedy" >/dev/null 2>&1
  fi
else
  rm -f "$STRAND_STATE" 2>/dev/null   # FF healthy / recovered → clear so a future strand re-alerts
fi
STRANDED=0; [ "${behind:-0}" -gt 0 ] && STRANDED=1
# A stranded genome (FF-blocked pull) means the local tree is STALE. Any drift comparison
# below runs against a behind-HEAD, so "in sync" is HOLLOW. Exit must reflect the strand.

# A genome file is only deployable if it PARSES — auto-apply runs unattended (incl. on a
# production-adjacent node), so a half-baked/mid-edit HEAD must never brick a deployed tool.
# bash -n for shell, py_compile for python (by .py or shebang). Broken → SKIP + alert, keep
# the working deployed copy. Genome HEAD is meant to be settled (mesh-land gates it), but
# "meant to be" is not a guarantee — this is the safety that makes unattended --apply safe.
parse_ok() {
  # Gate on SHEBANG, not a file-extension allowlist. An allowlist requires enumerating every
  # non-script suffix by hand and guarantees recurrence: a .service unit false-failed bash -n
  # on 'Description=...(...)' (2026-06-21), then mesh-imac-cam.m (Objective-C, unlisted '.m')
  # false-failed the same way and cried [drift-skip] every 20min from phaedra (2026-07-05) — the
  # allowlist can only ever chase suffixes one incident behind. A file with no shebang isn't an
  # executable script we parse; a shebang we don't handle (perl, node, ...) isn't ours to gate
  # either — skip both, only parse what we understand how to check.
  local shebang; shebang="$(head -1 "$1" 2>/dev/null)"
  case "$shebang" in
    '#!'*sh) bash -n "$1" 2>/dev/null ;;
    '#!'*python*) python3 -m py_compile "$1" 2>/dev/null ;;
    *) return 0 ;;
  esac
}
# WIP-WINDOW suppression (chat-review/sync-tools-wip-v4, the recurring drift-flap v2/v3 never killed):
# the noise is a tool sitting in the transient committed→deployed→dirty cycle. Once COMMITTED it leaves
# `wip_files` (git status clean) but its deployed copy is briefly older → flagged [drift] every report
# cycle for many cycles (tuner/tuner-eye/activity-tempo, 6+ cycles 2026-06-20) until the mind deploys.
# Suppress any mesh-* whose LAST genome commit is younger than WIP_WINDOW — that IS active iteration; a
# genuinely STUCK deploy still alerts once commits stop (last commit ages past the window). REPORT MODE
# ONLY — `--apply` must keep deploying committed work, so it never consults this set. One `git log`
# (not per-file) keyed on committer date.
WIP_WINDOW="${SYNC_WIP_WINDOW:-1800}"   # seconds; a tool committed within this = WIP, no drift alert
recent_wip=""
if [ "$APPLY" = 0 ]; then
  _wip_min=$(( WIP_WINDOW / 60 )); [ "$_wip_min" -lt 1 ] && _wip_min=1
  recent_wip="$(git log --since="${_wip_min} minutes ago" --name-only --pretty=format: -- 'scripts/mesh-*' 2>/dev/null | grep -E '^scripts/mesh-' | sort -u)"
fi

drift=""; skipped=""; clobber=""
for f in scripts/mesh-*; do
  [ -f "$f" ] || continue
  # skip self-test fixtures (mesh-land's smoke-test races this loop, briefly planting
  # scripts/mesh-zz-test-unwired-$$ then trap-removing it — if sync-tools catches the
  # window mid-race it deploys a copy that never gets pruned, leaking a permanent stray
  # into ~/.local/bin that re-trips doctor's not-executable/orphan FAIL under a new pid
  # each time the race fires)
  case "$(basename "$f")" in mesh-zz-test-*) continue ;; esac
  # WIP-WINDOW: recently-COMMITTED (active iteration) → suppress from REPORT drift (see note above).
  # here-string match (not a pipe) so `set -o pipefail` + grep -q early-close can't false-negative it
  # ([[pipefail-grep-q-sigpipe-false-fail]]).
  if [ -n "$recent_wip" ] && grep -qxF "$f" <<<"$recent_wip"; then
    continue
  fi
  b=$(basename "$f"); dst="$HOME/.local/bin/$b"
  if [ ! -f "$dst" ] || ! diff -q "$f" "$dst" >/dev/null 2>&1; then
    if [ "$APPLY" = 1 ]; then
      if ! parse_ok "$f"; then
        skipped="$skipped $b"; echo "$(ts) SKIP $b (genome copy fails parse — kept working local)" >>"$LOG"
        continue
      fi
      # DRIFT-DIRECTION GUARD: if the DEPLOYED copy is NEWER, AND the genome copy has no uncommitted changes (worktree==HEAD),
      # AND its content actually DIFFERS from HEAD (dst_matches_head — the content check, not just
      # the mtime pre-filter), this is a LOCAL-ONLY enhancement — do NOT overwrite it. Back up the
      # genome version first, skip deploy, and flag it. Uncommitted genome edits (worktree!=HEAD)
      # WILL deploy to local. A content-identical dst (mtime skew only) falls through to the
      # normal deploy path below — a same-bytes overwrite that also closes the mtime skew.
      [ -f "$dst" ] && [ "$dst" -nt "$f" ] && git diff --quiet HEAD -- "$f" 2>/dev/null \
        && ! dst_matches_head "$f" "$dst" && clobber="$clobber $b" && \
        cp -p "$f" "$BK/$b.genome.$(date -u +%Y%m%dT%H%M%SZ)" 2>/dev/null && continue
      drift="$drift $b"
      [ -f "$dst" ] && cp -p "$dst" "$BK/$b.$(date -u +%Y%m%dT%H%M%SZ)" 2>/dev/null
      # ATOMIC deploy: write a temp then rename. A bare `cp $f $dst` truncates-then-writes in place,
      # so a cron reflex reading $dst mid-write catches a PARTIAL file → "syntax error near unexpected
      # token" + a transient doctor FAIL (hit ds 2026-06-13 on channel-keepalive). `mv` (rename on the
      # same fs) is atomic — a reader sees the whole old OR the whole new file, never a fragment.
      if cp "$f" "$dst.tmp.$$" && chmod +x "$dst.tmp.$$" && mv -f "$dst.tmp.$$" "$dst"; then
        echo "$(ts) SYNCED $b" >>"$LOG"
      else
        rm -f "$dst.tmp.$$" 2>/dev/null; echo "$(ts) DEPLOY-FAIL $b (atomic write failed)" >>"$LOG"
      fi
    else
      drift="$drift $b"   # report-only mode: list all drift, parse-state not yet relevant
    fi
  fi
done
drift="${drift# }"; skipped="${skipped# }"
[ -n "$skipped" ] && command -v mesh-chat >/dev/null 2>&1 && \
  MESH_WHO="sync-tools@$(hostname)" mesh-chat "[drift-skip] $(hostname): genome copy FAILS PARSE, NOT deployed (kept working local) → $skipped — a broken tool reached genome HEAD." >/dev/null 2>&1

# STATE LOCK (chat-review/sync-tools-state-race-no-lock 2026-07-21): everything below is a
# read-compare-post-persist sequence on the shared $STATE (apply: prev/prev_clobber →
# [drift-healed]/[drift-clobber] → write; report: the 2-cycle debounce). Unlocked, two overlapping
# invocations (dual cron on one node, or a slow run meeting the next */20 tick) each read the same
# stale prev_clobber before either write lands → the identical [drift-clobber] posts N times (live:
# 4x ~140-tool board spam, phaedra 2026-07-21 14:00-15:00Z). Serialize with a blocking bounded-wait
# flock held to exit — the loser then reads the winner's fresh STATE and dedups. On timeout (or no
# flock binary) proceed UNLOCKED but say so in the log: a missed dedup is board noise, a swallowed
# run is a blind spot.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$MESH/.sync-tools.lock"
  flock -w "${SYNC_LOCK_WAIT:-120}" 9 || \
    echo "$(ts) LOCK-TIMEOUT after ${SYNC_LOCK_WAIT:-120}s — proceeding UNLOCKED (STATE dedup may race)" >>"$LOG"
fi

if [ "$APPLY" = 1 ]; then
  clobber="${clobber# }"
  if [ -n "$drift" ]; then
    echo "$(ts) applied: $drift" >>"$LOG"
    # auto-heal is VISIBLE but ROUTINE: record to the durable TRACE (not the coordination board) when it
    # actually healed something (edge-triggered, no spam) so the self-repair is in the node's history
    # instead of happening silently — without polluting mesh-chat (a clean genome→local heal needs no
    # other agent's attention; the DANGEROUS heal-that-reverted-a-local-fix is split out to [drift-clobber]
    # below, which DOES stay on the board). Prevents the stale-deployed-tool class (ds came back
    # genome-current but tools stale → session-watchdog storm, 2026-06-11).
    prev="$(sed -n 1p "$STATE" 2>/dev/null || echo)"
    [ "$drift" != "$prev" ] && command -v mesh-trace >/dev/null 2>&1 && \
      MESH_WHO="sync-tools@$(hostname)" mesh-trace "[drift-healed] $(hostname): auto-synced genome→local → $drift" >/dev/null 2>&1
  else
    echo "$(ts) apply: already in sync" >>"$LOG"
  fi
  # DRIFT-DIRECTION alarm: a subset of the "heal" overwrote a NEWER deployed copy → a likely
  # local-only fix just got REVERTED (not healed). Louder + distinct so it isn't swallowed by
  # the [drift-healed] line. The local copy is in $BK; rescue = re-apply to scripts/ then deploy.
  # chat-review/sync-tools-clobber-content-check (2026-07-07): this used to live INSIDE the
  # `-n "$drift"` branch above, so a clobber-only cycle (the exact "one local-only fix, everything
  # else already in sync" case) never alerted — the else-branch's `: > "$STATE"` silently wiped any
  # clobber tracking too. Found live while adding the content-check fixture: an isolated clobber
  # never fired. Now evaluated unconditionally, and STATE always persists BOTH lines every run.
  prev_clobber="$(sed -n 2p "$STATE" 2>/dev/null || echo)"
  [ -n "$clobber" ] && [ "$clobber" != "$prev_clobber" ] && command -v mesh-chat >/dev/null 2>&1 && \
    MESH_WHO="sync-tools@$(hostname)" mesh-chat "[drift-clobber] $(hostname): deployed copy was NEWER than genome → $clobber — genome→local heal likely REVERTED a local-only fix (NOT a clean heal). Backup in $BK. RESCUE genome-first: re-apply the edit to scripts/ then deploy, else next sync re-reverts it." >/dev/null 2>&1
  printf '%s\n%s\n' "$drift" "$clobber" > "$STATE"
  exit $STRANDED
fi

# report mode — 2-cycle DEBOUNCED detection: a commit briefly drifts followers/other-instances every
# time (propagation lag), so detecting/alerting on first sighting spams transient [drift]s that
# self-resolve and strand on the board. Track drift only when the SAME set persists ≥2 report
# cycles (genuinely stuck, not mid-propagation); post [drift-cleared] to close a confirmed alarm.
# ($STATE: line1=prev-cycle drift set, line2=confirmed drift set, line3=alerted-flag.)
prev="$(sed -n 1p "$STATE" 2>/dev/null || echo)"
confirmed="$(sed -n 2p "$STATE" 2>/dev/null || echo)"
prev_alerted="$(sed -n 3p "$STATE" 2>/dev/null || echo)"
if [ -n "$drift" ]; then
  echo "$(ts) DRIFT:$drift" >>"$LOG"
  if [ "$drift" = "$prev" ]; then
    # matched previous cycle: this is CONFIRMED drift (persisted 2 cycles)
    if [ "$confirmed" != "$drift" ] && [ "$prev_alerted" != 1 ]; then
      # first time this drift set is confirmed → alert
      printf '%s\n%s\n1\n' "$drift" "$drift" > "$STATE"
      command -v mesh-trace >/dev/null 2>&1 && \
        MESH_WHO="sync-tools@$(hostname)" mesh-trace "[drift] $(hostname): local tools differ from genome (persisted) → $drift. Fix: mesh-sync-tools --apply (backs up first)." >/dev/null 2>&1
    else
      printf '%s\n%s\n1\n' "$drift" "$drift" > "$STATE"
    fi
    exit 1
  else
    # first sighting / changed set — save as candidate, clear confirmed
    printf '%s\n\n\n' "$drift" > "$STATE"
    exit 0
  fi
else
  if [ -n "$prev" ] || [ -n "$confirmed" ]; then
    echo "$(ts) drift cleared" >>"$LOG"; : > "$STATE"
    # Close the SAME [drift] alarm on the SAME channel it was opened on: the [drift] open (:289) goes to
    # mesh-trace (durable history), so its [drift-cleared] close belongs on mesh-trace too — a benign
    # "back in sync" close needs no other agent's attention (same rationale as [drift-healed]→trace,
    # :256, and the :249-250 note). Only the DANGEROUS markers ([drift-clobber] reverted-a-fix, :264;
    # [drift-skip] broken-tool-at-HEAD, :242) stay on the board. (chat-review/drift-cleared-to-trace.)
    [ "$prev_alerted" = 1 ] && command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-trace "[drift-cleared] $(hostname): genome↔local back in sync." >/dev/null 2>&1
  fi
  exit $STRANDED
fi
