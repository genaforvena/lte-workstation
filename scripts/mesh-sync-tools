#!/usr/bin/env bash
# mesh-sync-tools — keep this node's ~/.local/bin/mesh-* in step with the genome (source of truth).
# smoke-test: --test checks repo dir exists + readable
# Stale hand-deployed tools caused most gaps in the 2026-06-10 session (session-watchdog, voice-rx,
# mesh-restore all drifted). This reflex makes drift VISIBLE so it never bites silently again.
#
#   mesh-sync-tools              report drift (genome vs local); edge-triggered alert to mesh-chat
#   mesh-sync-tools --apply      sync genome -> local where they differ (backs up old local first)
#   mesh-sync-tools --loop [s]   run forever: pull + report every N sec (default 3600); supervisable
#   mesh-sync-tools --test       smoke test (exit 0 if repo dir present)
#
# Exit: 0 = in sync (or applied cleanly); 1 = drift present (report mode) or git-pull failed.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
MESH="$HOME/.mesh"; LOG="$MESH/sync-tools.log"; BK="$MESH/tools-backup"; STATE="$MESH/.sync-tools-state"
command -v mkdir >/dev/null 2>&1 || { echo "mesh-sync-tools: missing mkdir" >&2; exit 1; }
mkdir -p "$BK" "$MESH"
ts(){ date -u +%FT%TZ; }

if [ "${1:-}" = --test ]; then
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v cp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cp)"; exit 1; }
  command -v chmod >/dev/null 2>&1 || { echo "smoke-test: FAIL (no chmod)"; exit 1; }
  command -v diff >/dev/null 2>&1 || { echo "smoke-test: FAIL (no diff)"; exit 1; }
  command -v mkdir >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mkdir)"; exit 1; }
  command -v cat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v rm >/dev/null 2>&1 || { echo "smoke-test: FAIL (no rm)"; exit 1; }
  [ -d "$REPO" ] && [ -d "$REPO/scripts" ] || { echo "smoke-test: FAIL (no repo/scripts)"; exit 1; }
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT INT HUP TERM
  mkdir -p "$TMP/repo/scripts" "$TMP/home/.local/bin" "$TMP/home/.mesh"
  ( cd "$TMP/repo" && git init --quiet && git commit --quiet --allow-empty -m init )
  cp "$0" "$TMP/repo/scripts/mesh-sync-tools"
  chmod +x "$TMP/repo/scripts/mesh-sync-tools"
  cat > "$TMP/repo/scripts/mesh-sync-tools-good" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-good"
  cat > "$TMP/repo/scripts/mesh-sync-tools-bad" <<'EOF'
#!/usr/bin/env bash
if then
  echo broken
fi
EOF
  chmod +x "$TMP/repo/scripts/mesh-sync-tools-bad"
  HOME="$TMP/home" MESH_REPO="$TMP/repo" PATH="$TMP/home/.local/bin:$PATH" "$TMP/repo/scripts/mesh-sync-tools" --apply >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (fixture apply failed)"; exit 1; }
  [ -x "$TMP/home/.local/bin/mesh-sync-tools-good" ] || { echo "smoke-test: FAIL (good fixture not deployed)"; exit 1; }
  [ ! -e "$TMP/home/.local/bin/mesh-sync-tools-bad" ] || { echo "smoke-test: FAIL (bad fixture should have been skipped)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

# loop mode: supervisable long-running variant
if [ "${1:-}" = --loop ]; then
  iv="${2:-3600}"
  echo "[mesh-sync-tools] genome drift watch every ${iv}s on $(hostname)"
  while true; do
    : > "$MESH/mesh-sync-tools.beat"
    "$0" || true   # report mode; chat alert fires on drift
    # Heartbeat the beat file during the long sleep so the supervisor (1800s threshold)
    # doesn't falsely WEDGE a healthy 3600s loop mid-sleep.
    elapsed=0
    while [ "$elapsed" -lt "$iv" ]; do
      sleep 60; elapsed=$((elapsed + 60))
      : > "$MESH/mesh-sync-tools.beat"
    done
  done
  exit 0
fi

APPLY=0; [ "${1:-}" = --apply ] && APPLY=1

cd "$REPO" 2>/dev/null || { echo "$(ts) FAIL no repo $REPO" >>"$LOG"; exit 1; }
# refresh genome (best-effort; if it fails we still compare against on-disk scripts/)
pull_rc=0
git pull --ff-only --quiet 2>/dev/null || pull_rc=$?

# Detect and surface dirty files as an FF-block gap. A dirty tree doesn't block the CURRENT
# comparison (we compare ~/.local/bin against the local genome copy), but it WILL block the
# next git pull — which means the NEXT upstream commit silently strands, deployed tools go
# stale, and the hollow "in sync" conceals it. Surface dirtiness NOW, before the strand hits.
dirtyn=$(git -C "$REPO" status --porcelain 2>/dev/null | wc -l)
now_epoch=$(date +%s)
DIRTY_BACKOFF="${SYNC_DIRTY_BACKOFF:-7200}"
LAST_DIRTY="$MESH/.sync-dirty-last"
if [ "${dirtyn:-0}" -gt 0 ]; then
  echo "$(ts) DIRTY-TREE: ${dirtyn} uncommitted file(s) — will block future FF pull" >>"$LOG"
  last_dirty=$(cat "$LAST_DIRTY" 2>/dev/null || echo 0)
  if [ $(( now_epoch - last_dirty )) -ge "$DIRTY_BACKOFF" ]; then
    echo "$now_epoch" > "$LAST_DIRTY"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-chat "[genome-strand] $(hostname): ${dirtyn} uncommitted file(s) WILL block next upstream pull — next genome push silently strands here. Resolve: commit or stash the dirty file(s) then 'git -C $REPO pull --ff-only'." >/dev/null 2>&1
  fi
else
  rm -f "$LAST_DIRTY" 2>/dev/null  # clean → clear backoff so next dirty alerts immediately
fi

# GENOME-STRAND guard: a --ff-only pull can SILENTLY fail (dirty tree, diverged history) — then we'd
# compare ~/.local/bin against a STALE genome and report a HOLLOW "in sync" while the node actually
# runs commits-behind tools. (ds hit this 2026-06-13: a dirty scripts/mesh-mind-state blocked the FF →
# 12 commits stranded → the entire fusion stack never deployed, yet every cycle logged "already in
# sync".) This reflex exists to make drift VISIBLE — so surface the strand instead of swallowing it.
behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
STRAND_STATE="$MESH/.genome-strand-state"
if [ "${behind:-0}" -gt 0 ]; then
  dirtyn=$(git status --porcelain 2>/dev/null | wc -l)
  reason="genome ${behind} commit(s) behind upstream, FF blocked"
  [ "${dirtyn:-0}" -gt 0 ] && reason="$reason (dirty tree: ${dirtyn} uncommitted file(s))"
  echo "$(ts) GENOME-STRAND $reason" >>"$LOG"
  # edge-triggered: alert once per distinct behind-count (not every */20 cycle)
  if [ "$behind" != "$(cat "$STRAND_STATE" 2>/dev/null)" ]; then
    echo "$behind" > "$STRAND_STATE"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-chat "[genome-strand] $(hostname): $reason — deployed tools are STALE, 'in sync' is HOLLOW. Resolve: stash/commit the dirty file(s) then 'git -C $REPO pull --ff-only'." >/dev/null 2>&1
  fi
else
  rm -f "$STRAND_STATE" 2>/dev/null   # FF healthy / recovered → clear so a future strand re-alerts
fi
STRANDED=0; [ "${behind:-0}" -gt 0 ] && STRANDED=1
# A stranded genome (FF-blocked pull) means the local tree is STALE. Any drift comparison
# below runs against a behind-HEAD, so "in sync" is HOLLOW. Exit must reflect the strand.

# A genome file is only deployable if it PARSES — auto-apply runs unattended (incl. on a
# production-adjacent node), so a half-baked/mid-edit HEAD must never brick a deployed tool.
# bash -n for shell, py_compile for python (by .py or shebang). Broken → SKIP + alert, keep
# the working deployed copy. Genome HEAD is meant to be settled (mesh-land gates it), but
# "meant to be" is not a guarantee — this is the safety that makes unattended --apply safe.
parse_ok() {
  if [ "${1##*.}" = py ] || head -1 "$1" 2>/dev/null | grep -q 'python'; then
    python3 -m py_compile "$1" 2>/dev/null
  else
    bash -n "$1" 2>/dev/null
  fi
}
drift=""; skipped=""; clobber=""
for f in scripts/mesh-*; do
  [ -f "$f" ] || continue
  b=$(basename "$f"); dst="$HOME/.local/bin/$b"
  if [ ! -f "$dst" ] || ! diff -q "$f" "$dst" >/dev/null 2>&1; then
    if [ "$APPLY" = 1 ]; then
      if ! parse_ok "$f"; then
        skipped="$skipped $b"; echo "$(ts) SKIP $b (genome copy fails parse — kept working local)" >>"$LOG"
        continue
      fi
      drift="$drift $b"
      [ -f "$dst" ] && cp -p "$dst" "$BK/$b.$(date -u +%Y%m%dT%H%M%SZ)" 2>/dev/null
      # DRIFT-DIRECTION GUARD (2026-06-17): if the DEPLOYED copy is NEWER than the genome copy,
      # this genome→local "heal" is very likely CLOBBERING a fresh LOCAL-ONLY edit — a mind edited
      # ~/.local/bin directly instead of scripts/ (the recurring anti-pattern; it silently reverted
      # mesh-activity-tempo's phone-ip gate earlier today, and [drift-healed] read as "solved").
      # We STILL deploy (genome is the source of truth) and the backup above preserves the local
      # copy, but we flag it DISTINCTLY so a [drift-healed] isn't mistaken for a clean heal when it
      # was a REVERT — the fix must be re-applied genome-first or the next sync re-reverts it.
      [ -f "$dst" ] && [ "$dst" -nt "$f" ] && clobber="$clobber $b"
      # ATOMIC deploy: write a temp then rename. A bare `cp $f $dst` truncates-then-writes in place,
      # so a cron reflex reading $dst mid-write catches a PARTIAL file → "syntax error near unexpected
      # token" + a transient doctor FAIL (hit ds 2026-06-13 on channel-keepalive). `mv` (rename on the
      # same fs) is atomic — a reader sees the whole old OR the whole new file, never a fragment.
      if cp "$f" "$dst.tmp.$$" && chmod +x "$dst.tmp.$$" && mv -f "$dst.tmp.$$" "$dst"; then
        echo "$(ts) SYNCED $b" >>"$LOG"
      else
        rm -f "$dst.tmp.$$" 2>/dev/null; echo "$(ts) DEPLOY-FAIL $b (atomic write failed)" >>"$LOG"
      fi
    else
      drift="$drift $b"   # report-only mode: list all drift, parse-state not yet relevant
    fi
  fi
done
drift="${drift# }"; skipped="${skipped# }"
[ -n "$skipped" ] && command -v mesh-chat >/dev/null 2>&1 && \
  MESH_WHO="sync-tools@$(hostname)" mesh-chat "[drift-skip] $(hostname): genome copy FAILS PARSE, NOT deployed (kept working local) → $skipped — a broken tool reached genome HEAD." >/dev/null 2>&1

if [ "$APPLY" = 1 ]; then
  if [ -n "$drift" ]; then
    echo "$(ts) applied: $drift" >>"$LOG"
    # auto-heal is VISIBLE: post when it actually healed something (edge-triggered, no spam) so the
    # board sees the self-repair instead of it happening silently. Prevents the stale-deployed-tool
    # class (ds came back genome-current but tools stale → session-watchdog storm, 2026-06-11).
    [ "$drift" != "$(cat "$STATE" 2>/dev/null)" ] && command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="sync-tools@$(hostname)" mesh-chat "[drift-healed] $(hostname): auto-synced genome→local → $drift" >/dev/null 2>&1
    # DRIFT-DIRECTION alarm: a subset of the "heal" overwrote a NEWER deployed copy → a likely
    # local-only fix just got REVERTED (not healed). Louder + distinct so it isn't swallowed by
    # the [drift-healed] line. The local copy is in $BK; rescue = re-apply to scripts/ then deploy.
    clobber="${clobber# }"
    [ -n "$clobber" ] && command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="sync-tools@$(hostname)" mesh-chat "[drift-clobber] $(hostname): deployed copy was NEWER than genome → $clobber — genome→local heal likely REVERTED a local-only fix (NOT a clean heal). Backup in $BK. RESCUE genome-first: re-apply the edit to scripts/ then deploy, else next sync re-reverts it." >/dev/null 2>&1
  else
    echo "$(ts) apply: already in sync" >>"$LOG"
  fi
  : > "$STATE"   # cleared: post-apply we're in sync
  exit $STRANDED
fi

# report mode — DEBOUNCED alert: a commit briefly drifts followers/other-instances every time
# (propagation lag), so alerting on first sighting spams transient [drift]s that self-resolve and
# strand on the board. Alert only when the SAME drift persists ≥2 report cycles (genuinely stuck,
# not mid-propagation), once; post [drift-cleared] to close a confirmed alarm. ($STATE: line1=set,
# line2=alerted-flag.)
prev="$(sed -n 1p "$STATE" 2>/dev/null || echo)"
prev_alerted="$(sed -n 2p "$STATE" 2>/dev/null || echo)"
if [ -n "$drift" ]; then
  echo "$(ts) DRIFT:$drift" >>"$LOG"
  if [ "$drift" = "$prev" ]; then
    if [ "$prev_alerted" != 1 ]; then          # persisted ≥2 cycles → confirm + alert ONCE
      printf '%s\n1\n' "$drift" > "$STATE"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
        mesh-chat "[drift] $(hostname): local tools differ from genome (persisted) → $drift. Fix: mesh-sync-tools --apply (backs up first)." >/dev/null 2>&1
    fi
  else
    printf '%s\n0\n' "$drift" > "$STATE"   # first sighting / changed set — wait one cycle (likely transient)
  fi
  exit 1
else
  if [ -n "$prev" ]; then
    echo "$(ts) drift cleared" >>"$LOG"; : > "$STATE"
    [ "$prev_alerted" = 1 ] && command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="sync-tools@$(hostname)" \
      mesh-chat "[drift-cleared] $(hostname): genome↔local back in sync." >/dev/null 2>&1
  fi
  exit $STRANDED
fi
