#!/usr/bin/env python3
"""mesh-model-watch — the stack's VINTAGE CLOCK: which organ is running an obsolete model.

Operator 2026-07-15 (voice): "я просто зашёл в models и сказал давайте поставим вот этот — а
лучше сделайте себе РЕФЛЕКС, чтобы вы сами доискивали". Not a one-off list review: a wired
reflex that periodically scans for models fitting our organs and proposes an upgrade.
Rationale, his words: "если модели два года, даже год — уже вопросики."

WHAT IT CAN AND CANNOT KNOW — read this before extending it.
It CANNOT know a candidate is BETTER. That needs a run against a real fixture, and no amount
of metadata substitutes. It CAN compute exactly what the operator described in words: how far
our incumbent has drifted, and whether the field moved. So this is a CLOCK, not a judge. It
proposes a [task]; a mind judges. Anything here that starts ranking models by "quality" from
metadata is lying — delete it.

The drift that motivated it, measured 2026-07-15 (createdAt from the HF API, not memory):
    rhasspy/piper-voices           37 mo   (TTS)
    vikhyatk/moondream2            28 mo   (vision)
    Qwen/Qwen2.5-0.5B-Instruct     22 mo   (the alem bench subject)
    openai/whisper-large-v3-turbo  21 mo   (STT — never re-modified since 2024-10-04)
Median age of this node's model stack: two years. The operator was right.

THREE GATES. Each is a real bug someone already paid for — do not "simplify" them away.

 (1) UNKNOWN, NEVER ALL-CLEAR.
     "no new candidates" and "the source did not answer" MUST be different outcomes. This is
     the isp-health bug inverted (an empty log returned the ALL-CLEAR; every inet=DOWN boarded
     an acquittal backed by zero measurements). A scan that cannot read HF reports UNKNOWN and
     proposes NOTHING. Silence is not evidence of currency.

 (2) READ `parameters`, NEVER `total`.
     HF's safetensors.total LIES. For deepreinforce-ai/Ornith-1.0-9B it reports 1469680 while
     parameters.BF16 reports 9409813744 — off by 6400x, and PLAUSIBLE, which is what makes it
     dangerous. A reflex reading `total` would call a 9.4B model 0.001B and report a
     comfortable fit on a 12GB card. Caught only because the operator's own list contained it.

 (3) VRAM FROM DTYPE, NEVER ASSUMED.
     nvidia/nemotron-3.5-asr-streaming-0.6b is F32 — 4 bytes/param = 2.6GB, not the 1.3GB a
     BF16 assumption gives. It is the ONLY F32 model in the operator's list, so a
     BF16-everywhere shortcut is wrong by 2x on exactly the model you would ship.

Usage:
    mesh-model-watch            render the pane (cheap: reads the cached scan)
    mesh-model-watch --scan     one scan pass, propose drifted organs (the reflex mode)
    mesh-model-watch --json     latest scan as JSON
    mesh-model-watch --test     smoke test (pure fixtures + a LIVE source assert)

Env: MW_VRAM_MB (override the card budget) · MW_AGE_MONTHS (drift threshold, default 12)
     MW_COOLDOWN_DAYS (re-propose the same organ no sooner than this, default 14)

DECLARED BUT DELIBERATELY UNSCHEDULED (2026-07-15) — no `# reflex-cadence:` yet, on purpose.
The mechanism is done and its gates are proven (see --test; both critical gates were mutation-
tested and SEEN TO FAIL). The CANDIDATE SELECTION is not, and wiring it would make this tool
commit the exact fault it was written to prevent:

  - `sort=downloads` biases the pool toward giants, because popularity tracks size. The top of
    `text-generation` is GLM-5.2 (720 GB) and Qwen3.6-35B (22 GB). So `mind-small` returns
    status=OK with n_fitting=0 — a CONFIDENT "nothing to upgrade" produced by a pool that never
    contained anything small enough. Qwen/Qwen3.5-0.8B fits this card with room to spare.
  - `pipeline_tag` does not map onto organs. Qwen3.5-0.8B is tagged `image-text-to-text` because
    it is multimodal, so it can never surface under `mind-small` at any pool depth.

Gate (1) protects against an unread source, NOT against a source read through a biased lens.
A silent, well-formed "0 fitting" is the more dangerous answer, and it is the one this tool
currently gives for the organ that motivated it.

FIXTURE, and it currently FAILS: the operator's own 2026-07-15 list —
nemotron-3.5-asr-streaming-0.6b, Ornith-1.0-9B, MiniCPM5-1B, MOSS-Transcribe-Diarize,
v-splade-quality, VoxCPM2, Marlin-2B, Qwen3.5-0.8B, muscriptor-medium, needle. A model-watch
that cannot rediscover the list a human found by hand is not yet doing its job. It surfaces
ZERO of the ten. Fix the selection, make the fixture pass, THEN add the cadence header.

(When it lands: DAILY, e.g. `# reflex-cadence: 17 7 * * *` — releases are a slow signal and the
board must not be nagged; MW_COOLDOWN_DAYS backs the cadence up per organ.)
"""

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone

MESHDIR = os.path.join(os.path.expanduser("~"), ".mesh")
STATE = os.path.join(MESHDIR, "model-watch.json")
PROPOSED = os.path.join(MESHDIR, ".model-watch-proposed")
API = "https://huggingface.co/api/models"

# The DECLARED organ map. Explicit, never inferred from what happens to be installed —
# this node has already paid for identifier-guessing three times today (mesh-dispatch's
# claim_id_of, mesh-chat's derive_who, and a client_name substring in the alem PR).
# organ -> (incumbent HF repo, pipeline_tag it competes in)
ORGANS = {
    "stt": ("openai/whisper-large-v3-turbo", "automatic-speech-recognition"),
    "tts": ("rhasspy/piper-voices", "text-to-speech"),
    "vision": ("vikhyatk/moondream2", "image-text-to-text"),
    "mind-small": ("Qwen/Qwen2.5-0.5B-Instruct", "text-generation"),
}

# bytes per parameter, by the dtype key HF reports in safetensors.parameters
DTYPE_BYTES = {"F64": 8, "F32": 4, "BF16": 2, "F16": 2, "I64": 8, "I32": 4, "F8_E4M3": 1,
               "F8_E5M2": 1, "I8": 1, "U8": 1, "I16": 2, "BOOL": 1, "F4": 0.5}

MIN_DOWNLOADS = 5000  # traction floor: the field moving, not one person's upload
CANDIDATE_POOL = 40   # top-N by downloads to consider per organ


def _get(url, timeout=25):
    """Fetch JSON. Returns None on ANY failure — never {} or [], which a caller could
    mistake for 'the source answered and there is nothing'. Gate (1) lives or dies here."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "mesh-model-watch"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            if r.status != 200:
                return None
            return json.loads(r.read().decode("utf-8"))
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError,
            json.JSONDecodeError, ValueError):
        return None


def params_of(meta):
    """(n_params, bytes_per_param) from safetensors.parameters — NEVER from .total.

    Gate (2). Returns (None, None) when the model publishes no safetensors block, so the
    caller reports UNKNOWN rather than inventing a size. Weighted by dtype so a mixed-
    precision repo is costed by what it actually stores.
    """
    st = (meta or {}).get("safetensors") or {}
    params = st.get("parameters") or {}
    if not isinstance(params, dict):
        return None, None
    total = 0
    weighted = 0.0
    for dtype, n in params.items():
        if dtype == "total" or not isinstance(n, (int, float)):
            continue
        b = DTYPE_BYTES.get(dtype.upper())
        if b is None:
            continue
        total += n
        weighted += n * b
    if total <= 0:
        return None, None
    return total, weighted / total


def vram_mb(meta):
    """Weights-only VRAM estimate. Gate (3): from the real dtype, never an assumption.

    Weights only — KV cache, activations and runtime overhead are on top. Deliberately NOT
    padded with a fudge factor: an honest lower bound a mind can reason about beats a guess
    dressed as a budget.
    """
    n, bpp = params_of(meta)
    if n is None:
        return None
    return (n * bpp) / (1024 * 1024)


def card_mb():
    """Total VRAM of the card, read from the device. UNKNOWN (None) if it cannot be read."""
    env = os.environ.get("MW_VRAM_MB")
    if env:
        try:
            return int(env)
        except ValueError:
            return None
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=20)
        if out.returncode != 0:
            return None
        return int(out.stdout.strip().splitlines()[0])
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return None


def age_months(created, now=None):
    if not created:
        return None
    try:
        d = datetime.fromisoformat(str(created).replace("Z", "+00:00"))
    except ValueError:
        return None
    now = now or datetime.now(timezone.utc)
    return (now - d).days / 30.4


def scan_organ(organ, incumbent, tag, budget_mb, now=None):
    """One organ -> a verdict dict. Never raises; every unreadable source becomes UNKNOWN."""
    inc = _get(f"{API}/{incumbent}")
    if inc is None:
        return {"organ": organ, "incumbent": incumbent, "status": "UNKNOWN",
                "why": "incumbent metadata unreadable"}
    inc_created = inc.get("createdAt")
    inc_age = age_months(inc_created, now)

    pool = _get(f"{API}?pipeline_tag={tag}&sort=downloads&direction=-1"
                f"&limit={CANDIDATE_POOL}&full=true")
    if pool is None:
        # Gate (1): we know the incumbent's age but NOT the field. Reporting "no candidates"
        # here would be the isp-health acquittal — a clean bill backed by zero measurements.
        return {"organ": organ, "incumbent": incumbent, "status": "UNKNOWN",
                "age_months": round(inc_age, 1) if inc_age else None,
                "why": "candidate pool unreadable"}

    cands = []
    for m in pool:
        mid = m.get("id")
        if not mid or mid == incumbent:
            continue
        if (m.get("downloads") or 0) < MIN_DOWNLOADS:
            continue
        c_age = age_months(m.get("createdAt"), now)
        if c_age is None or inc_age is None or c_age >= inc_age:
            continue  # not newer than what we run
        cands.append({"id": mid, "age_months": round(c_age, 1),
                      "downloads": m.get("downloads") or 0})

    # Size needs an individual fetch — the search endpoint omits safetensors entirely.
    # Only the few newest are costed; an unsized candidate stays UNKNOWN, never "fits".
    cands.sort(key=lambda c: c["age_months"])
    sized = []
    for c in cands[:6]:
        meta = _get(f"{API}/{c['id']}")
        v = vram_mb(meta) if meta is not None else None
        c["vram_mb"] = round(v) if v else None
        c["fits"] = (None if v is None or budget_mb is None else bool(v < budget_mb * 0.85))
        sized.append(c)

    fitting = [c for c in sized if c["fits"] is True]
    return {"organ": organ, "incumbent": incumbent, "status": "OK",
            "age_months": round(inc_age, 1) if inc_age else None,
            "candidates": sized, "n_fitting": len(fitting)}


def scan(now=None):
    budget = card_mb()
    rows = [scan_organ(o, inc, tag, budget, now) for o, (inc, tag) in ORGANS.items()]
    return {"ts": (now or datetime.now(timezone.utc)).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "card_mb": budget, "organs": rows}


def _cooldown_ok(organ, days):
    try:
        with open(PROPOSED) as f:
            seen = json.load(f)
    except (OSError, json.JSONDecodeError):
        seen = {}
    last = seen.get(organ)
    if last:
        try:
            d = datetime.fromisoformat(last)
            if (datetime.now(timezone.utc) - d).days < days:
                return False, seen
        except ValueError:
            pass
    return True, seen


def _mark(organ, seen):
    seen[organ] = datetime.now(timezone.utc).isoformat()
    try:
        with open(PROPOSED, "w") as f:
            json.dump(seen, f)
    except OSError:
        pass


def propose(result, threshold, cooldown):
    """Board a [task] per drifted organ that has a FITTING candidate. Rate-limited per organ.

    An organ whose status is UNKNOWN proposes NOTHING — we do not know the field moved, and
    a proposal implies we looked. Silence about an unread source is the only honest output.
    """
    posted = []
    for r in result["organs"]:
        if r.get("status") != "OK":
            continue
        age = r.get("age_months")
        if age is None or age < threshold or not r.get("n_fitting"):
            continue
        ok, seen = _cooldown_ok(r["organ"], cooldown)
        if not ok:
            continue
        top = [c for c in r["candidates"] if c["fits"] is True][:3]
        cl = "; ".join(f"{c['id']} ({c['age_months']:.0f}mo, {c['vram_mb']}MB, "
                       f"{c['downloads']} dl)" for c in top)
        msg = (f"[task] model-watch/{r['organ']}-drift: our {r['organ']} runs "
               f"{r['incumbent']}, now {age:.0f} MONTHS old. {r['n_fitting']} newer "
               f"candidate(s) fit this card: {cl}. model-watch is a VINTAGE CLOCK — it "
               f"cannot know these are BETTER, only that the field moved and ours did not. "
               f"Judging needs a real run on a shared fixture. --test asserts the live HF "
               f"source, so this is not a fallback talking. owner: mesh-model-watch/genome")
        env = dict(os.environ, MESH_WHO=f"model-watch@{os.uname().nodename}")
        try:
            subprocess.run(["mesh-chat", msg], env=env, timeout=45, capture_output=True)
            _mark(r["organ"], seen)
            posted.append(r["organ"])
        except (OSError, subprocess.SubprocessError):
            pass
    return posted


def render(result):
    out = []
    card = result.get("card_mb")
    out.append(f"== model-watch — stack vintage @ {result.get('ts','?')} "
               f"(card {card if card else 'UNKNOWN'} MB) ==")
    for r in result["organs"]:
        if r.get("status") != "OK":
            out.append(f"  {r['organ']:11} {r['incumbent'][:34]:34} UNKNOWN — {r.get('why')}")
            continue
        age = r.get("age_months")
        flag = "DRIFT" if age and age >= 12 else "ok"
        out.append(f"  {r['organ']:11} {r['incumbent'][:34]:34} {age:5.0f}mo {flag:5} "
                   f"{r.get('n_fitting',0)} fitting newer")
        for c in (r.get("candidates") or [])[:2]:
            v = f"{c['vram_mb']}MB" if c["vram_mb"] else "size UNKNOWN"
            fit = {True: "fits", False: "too big", None: "?"}[c["fits"]]
            out.append(f"      -> {c['id'][:44]:44} {c['age_months']:4.0f}mo {v:>12} {fit}")
    return "\n".join(out)


# ─────────────────────────── tests ───────────────────────────

def _test_total_field_lies():
    """Gate (2). THE regression, from a real repo in the operator's own list.

    deepreinforce-ai/Ornith-1.0-9B publishes safetensors.total = 1469680 alongside
    parameters.BF16 = 9409813744. Reading `total` calls a 9.4B model 0.001B and reports a
    comfortable fit on a 12GB card. This fixture is the REAL API response shape.
    """
    meta = {"safetensors": {"parameters": {"BF16": 9409813744}, "total": 1469680}}
    n, bpp = params_of(meta)
    assert n == 9409813744, f"read {n} — reading .total again?"
    assert bpp == 2, bpp
    mb = vram_mb(meta)
    assert 17500 < mb < 18500, mb          # ~18.8 GB
    assert mb > 12288, "a 9.4B BF16 model must NOT be reported as fitting a 3060"
    return "total-field trap"


def _test_dtype_not_assumed():
    """Gate (3). nemotron-3.5-asr-streaming-0.6b is F32: 0.64B*4 = 2.6GB, not 1.3GB.

    The only F32 model in the operator's list — a BF16-everywhere shortcut is wrong by 2x
    on exactly the model you would ship.
    """
    f32 = {"safetensors": {"parameters": {"F32": 643_000_000}}}
    bf16 = {"safetensors": {"parameters": {"BF16": 643_000_000}}}
    a, b = vram_mb(f32), vram_mb(bf16)
    assert abs(a - 2452) < 60, a
    assert abs(b - 1226) < 60, b
    assert abs(a / b - 2.0) < 0.01, "F32 must cost exactly 2x BF16"
    return "dtype-aware vram"


def _test_missing_safetensors_is_unknown_not_zero():
    """A repo with no safetensors block (e.g. hexgrad/Kokoro-82M) must be UNKNOWN.

    Zero is the dangerous answer: 0 MB "fits" any card. None forces the caller to say so.
    """
    assert params_of({}) == (None, None)
    assert params_of({"safetensors": {}}) == (None, None)
    assert vram_mb({"safetensors": {"parameters": {}}}) is None
    return "missing size -> UNKNOWN"


def _test_unreadable_source_is_unknown_not_all_clear():
    """Gate (1), FALSIFIED — the test that must be seen to FAIL, not just to pass.

    Points the fetcher at an unroutable host and asserts the scan says UNKNOWN and proposes
    NOTHING. If it instead reported "no candidates", every organ would board a clean bill of
    currency backed by zero measurements — the isp-health bug, exactly.
    """
    global API
    real = API
    try:
        API = "http://127.0.0.1:9/api/models"   # discard port: always refuses
        r = scan_organ("stt", "openai/whisper-large-v3-turbo",
                       "automatic-speech-recognition", 12288)
        assert r["status"] == "UNKNOWN", f"unreadable source returned {r['status']}!"
        assert "candidates" not in r, "UNKNOWN must not carry candidates"
        posted = propose({"organs": [r]}, threshold=1, cooldown=0)
        assert posted == [], "an UNKNOWN organ must propose NOTHING"
    finally:
        API = real
    return "unreadable -> UNKNOWN (falsified)"


def _test_live_source_is_real():
    """The operator's explicit requirement: assert a REAL readable source, not a fallback.

    Hits the live HF API for a repo whose parameter count we independently verified on
    2026-07-15 (Qwen/Qwen3.5-0.8B, 0.87B). A cached/fallback/offline path cannot satisfy
    this. Network-gated by design: if HF is unreachable this test FAILS LOUDLY rather than
    passing quietly, because a model-watch that cannot read the field is not working.
    """
    meta = _get(f"{API}/Qwen/Qwen3.5-0.8B", timeout=30)
    assert meta is not None, "LIVE SOURCE UNREADABLE — model-watch cannot do its job"
    assert meta.get("id") == "Qwen/Qwen3.5-0.8B", meta.get("id")
    n, _ = params_of(meta)
    assert n is not None and 0.8e9 < n < 0.95e9, f"live param count {n} — API shape changed?"
    created = meta.get("createdAt")
    assert age_months(created) is not None, "createdAt unparseable — the drift signal is dead"
    return f"live source real ({n/1e9:.2f}B, {age_months(created):.0f}mo)"


def run_tests():
    tests = [_test_total_field_lies, _test_dtype_not_assumed,
             _test_missing_safetensors_is_unknown_not_zero,
             _test_unreadable_source_is_unknown_not_all_clear,
             _test_live_source_is_real]
    bad = 0
    for t in tests:
        try:
            print(f"  ok   {t.__name__}: {t()}")
        except AssertionError as e:
            print(f"  FAIL {t.__name__}: {e}")
            bad += 1
        except Exception as e:  # noqa: BLE001
            print(f"  FAIL {t.__name__}: {type(e).__name__}: {e}")
            bad += 1
    print(f"{len(tests)-bad}/{len(tests)} passed")
    return 1 if bad else 0


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--pane"
    if arg == "--test":
        return run_tests()
    if arg in ("--scan", "--json"):
        r = scan()
        try:
            with open(STATE, "w") as f:
                json.dump(r, f, indent=1)
        except OSError:
            pass
        if arg == "--json":
            print(json.dumps(r, indent=1))
            return 0
        posted = propose(r, float(os.environ.get("MW_AGE_MONTHS", 12)),
                         int(os.environ.get("MW_COOLDOWN_DAYS", 14)))
        unknown = [o["organ"] for o in r["organs"] if o.get("status") != "OK"]
        print(render(r))
        print(f"-- proposed: {posted or 'none'} · UNKNOWN: {unknown or 'none'}")
        return 0
    try:
        with open(STATE) as f:
            print(render(json.load(f)))
    except (OSError, json.JSONDecodeError):
        print("== model-watch — no scan yet (run --scan) ==")
    return 0


if __name__ == "__main__":
    sys.exit(main())
