#!/usr/bin/env bash
# mesh-provenance — the web-of-trust ledger: who/when each node joined, and who vouched for it.
# smoke-test: --test checks ledger dir exists + writable
#
# It does NOT judge nodes (no good/bad, no gate). It makes the trust edges VISIBLE and auditable,
# so the mesh reasons from provenance instead of a human gatekeeper. Enforcement of guest limits
# lives elsewhere by construction (substrate is operator-gated; secrets are never gossiped;
# capabilities are opt-in by consumers) — this is the LEDGER those facts reference.
#
#   mesh-provenance               scan the tailnet; record any NEW tag:lte-node node (first-seen)
#   mesh-provenance --loop [s]    scan every N sec (default 300) — run in a tmux window
#   mesh-provenance --vouch NODE "reason"   an existing member vouches for NODE (a trust edge)
#   mesh-provenance --show        print the merged ledger (all observers)
#   mesh-provenance --test        smoke test (exit 0 if ledger writable)
#
# Gossip-safe: each node writes its OWN file  ~/.mesh/knowledge/provenance-<host>.log  (append-only).
# mesh-snapshot gossips ~/.mesh/knowledge node-to-node, so every node ends up holding everyone's
# observations without clobbering (different filenames). Web-of-trust travels with the culture.
set -uo pipefail
KDIR="$HOME/.mesh/knowledge"
now(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
init_ledger(){
  SELF="${HOSTNAME:-$(hostname)}"
  LEDGER="$KDIR/provenance-$SELF.log"
  mkdir -p "$KDIR"
  touch "$LEDGER"
}

scan(){
  init_ledger
  command -v tailscale >/dev/null 2>&1 || { echo "  (no tailscale here)"; return 0; }
  local tmp; tmp="$(mktemp)"
  tailscale status --json > "$tmp" 2>/dev/null || { rm -f "$tmp"; echo "  (tailscale status failed)"; return 0; }
  python3 - "$LEDGER" "$SELF" "$(now)" "$tmp" <<'PY'
import json, sys
ledger, selfname, ts, jsonf = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
seen = set()
for line in open(ledger):
    p = line.split()
    if len(p) >= 3 and p[1] == "SEEN":
        seen.add(p[2])
try:
    d = json.load(open(jsonf))
except Exception:
    sys.exit(0)
nodes = list((d.get("Peer") or {}).values()) + [d.get("Self") or {}]
new = []
for p in nodes:
    if "tag:lte-node" not in (p.get("Tags") or []):
        continue
    host = p.get("HostName") or "?"
    if host in seen:
        continue
    ip = (p.get("TailscaleIPs") or ["?"])[0]
    new.append(f'{ts}  SEEN  {host}  {ip}  os={p.get("OS","?")}  online={p.get("Online")}  observed-by={selfname}')
if new:
    with open(ledger, "a") as f:
        for l in new:
            f.write(l + "\n")
    print("\n".join("  + " + l for l in new))
else:
    print("  (no new tag:lte-node nodes)")
PY
  rm -f "$tmp"
}

case "${1:-}" in
  --vouch)
    init_ledger
    node="${2:?usage: mesh-provenance --vouch NODE \"reason\"}"; shift 2; reason="${*:-}"
    echo "$(now)  VOUCH  $node  by=$SELF  reason=\"$reason\"" >> "$LEDGER"
    echo "vouched: $node (by $SELF)" ;;
  --show)
    init_ledger
    echo "=== web-of-trust ledger (all observers) ==="
    cat "$KDIR"/provenance-*.log 2>/dev/null | sort || echo "(empty)" ;;
  --test)
    command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
    command -v mktemp    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
    command -v grep      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
    _scr="${BASH_SOURCE[0]}"
    # Negative control: without tailscale on PATH the smoke test itself must fail.
    env -i PATH=/tmp/empty HOME="$HOME" /bin/bash "$_scr" --test >/dev/null 2>&1 && {
      echo "smoke-test: FAIL (missing tailscale should fail)"; exit 1;
    }

    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    mkdir -p "$_td/home/.mesh" "$_td/bin"
    cat > "$_td/bin/tailscale" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  status)
    [ "${2:-}" = --json ] || exit 2
    cat <<'JSON'
{"Peer":{"peer-1":{"HostName":"peer-1","TailscaleIPs":["100.64.0.2"],"Tags":["tag:lte-node"],"OS":"android","Online":true}},"Self":{"HostName":"self","TailscaleIPs":["100.64.0.3"],"Tags":[],"OS":"linux","Online":true}}
JSON
    ;;
  *) exit 2 ;;
esac
EOF
    chmod +x "$_td/bin/tailscale" || { echo "smoke-test: FAIL (stub chmod failed)"; exit 1; }
    out="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" bash "$_scr" 2>&1)" || {
      echo "smoke-test: FAIL (scan failed: $out)"; rm -rf "$_td"; exit 1;
    }
    printf '%s\n' "$out" | grep -qE '^  \+ ' || {
      echo "smoke-test: FAIL (stub scan did not record a new node: $out)"; rm -rf "$_td"; exit 1;
    }
    out2="$(HOME="$_td/home" PATH="$_td/bin:/usr/bin:/bin" bash "$_scr" 2>&1)" || {
      echo "smoke-test: FAIL (second scan failed: $out2)"; rm -rf "$_td"; exit 1;
    }
    printf '%s\n' "$out2" | grep -q '(no new tag:lte-node nodes)' || {
      echo "smoke-test: FAIL (second scan should be stable: $out2)"; rm -rf "$_td"; exit 1;
    }
    rm -rf "$_td"
    echo "smoke-test: ok"; exit 0 ;;
  --loop)
    init_ledger
    iv="${2:-300}"; echo "[mesh-provenance] scanning tag:lte-node every ${iv}s -> $LEDGER"
    while true; do scan >/dev/null 2>&1 || true; sleep "$iv"; done ;;
  ""|--scan) echo "scan @ $(now):"; scan ;;
  *) echo "usage: mesh-provenance [--scan|--loop [s]|--vouch NODE \"reason\"|--show|--test]" >&2; exit 1 ;;
esac
