#!/usr/bin/env bash
# orphan-ok: on-demand USB activity relation; no safe cadence is declared until the node's USB
# controller consumer is identified as a stable scheduled organ.
# mesh-usb-activity — joint USB controller interrupt + runtime-active device sense.
#
# The two live axes are deliberately kept separate: xHCI interrupt deltas show controller
# work, while sysfs runtime_status shows USB devices held active by their drivers. ACTIVE is
# only the joint observation where both move; IRQ_ONLY and DEVICE_ONLY preserve the cases
# neither axis can name alone. If either kernel surface is unreachable, this is UNKNOWN (2).
set -uo pipefail

STATE="${MESH_USB_ACTIVITY_STATE:-${HOME:-/root}/.mesh/.usb-activity.state}"
IRQ_FILE="${MESH_USB_ACTIVITY_IRQ_FILE:-/proc/interrupts}"
USB_ROOT="${MESH_USB_ACTIVITY_USB_ROOT:-/sys/bus/usb/devices}"
INTERVAL="${MESH_USB_ACTIVITY_INTERVAL:-0.2}"

read_xhci_irqs() {
  local total=0 line n file="${MESH_USB_ACTIVITY_IRQ_FILE:-$IRQ_FILE}"
  [ -r "$file" ] || return 2
  while IFS= read -r line; do
    case "$line" in
      *xhci_hcd*|*usbcore*|*ehci_hcd*|*ohci_hcd*|*uhci_hcd*)
        n="$(printf '%s\n' "$line" | awk -F: '{print $2}' | awk '{s=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) s+=$i; print s}')"
        case "$n" in ''|*[!0-9]*) return 2;; esac
        total=$((total + n));;
    esac
  done <"$file"
  [ "$total" -ge 0 ] || return 2
  printf '%s\n' "$total"
}

read_active_devices() {
  local f status total=0 seen=0 root="${MESH_USB_ACTIVITY_USB_ROOT:-$USB_ROOT}"
  [ -d "$root" ] || return 2
  shopt -s nullglob
  for f in "$root"/*/power/runtime_status; do
    [ -r "$f" ] || continue
    status="$(tr -d '[:space:]' <"$f" 2>/dev/null)"
    case "$status" in
      active) total=$((total + 1)); seen=$((seen + 1));;
      suspended|unsupported|blocked) seen=$((seen + 1));;
      *) shopt -u nullglob; return 2;;
    esac
  done
  shopt -u nullglob
  [ "$seen" -gt 0 ] || return 2
  printf '%s\n' "$total"
}

classify() {
  case "$1:$2" in
    1:1) echo ACTIVE;;
    1:0) echo IRQ_ONLY;;
    0:1) echo DEVICE_ONLY;;
    0:0) echo QUIET;;
    *) echo UNKNOWN;;
  esac
}

live_read() {
  local i1 d1 i2 d2
  i1="$(read_xhci_irqs)" || return 2
  d1="$(read_active_devices)" || return 2
  sleep "$INTERVAL"
  i2="$(read_xhci_irqs)" || return 2
  d2="$(read_active_devices)" || return 2
  [ "$i2" -ge "$i1" ] || return 2
  printf '%s|%s|%s\n' "$((i2 - i1))" "$d1" "$d2"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  cat >"$td/interrupts" <<'EOF'
           CPU0 CPU1
  51:      10   20  IR-PCI-MSIX xhci_hcd
EOF
  mkdir -p "$td/usb/1-1/power" "$td/usb/1-2/power"
  printf 'active\n' >"$td/usb/1-1/power/runtime_status"
  printf 'suspended\n' >"$td/usb/1-2/power/runtime_status"
  [ "$(MESH_USB_ACTIVITY_IRQ_FILE="$td/interrupts" read_xhci_irqs)" = 30 ] || exit 1
  [ "$(MESH_USB_ACTIVITY_USB_ROOT="$td/usb" read_active_devices)" = 1 ] || exit 1
  [ "$(classify 1 1)" = ACTIVE ] && [ "$(classify 1 0)" = IRQ_ONLY ] || exit 1
  [ "$(classify 0 1)" = DEVICE_ONLY ] && [ "$(classify 0 0)" = QUIET ] || exit 1
  MESH_USB_ACTIVITY_IRQ_FILE="$td/missing" read_xhci_irqs >/dev/null 2>&1 && exit 1
  live="$(live_read 2>/dev/null)" || { echo 'smoke-test: n/a (USB IRQ or runtime-status surface unavailable)' >&2; exit 2; }
  echo "smoke-test: ok (joint fixtures + REAL USB read: irq_delta|active_before|active_after=$live)"
  exit 0
fi

case "${1:-}" in ''|--edge|--json) ;; *) echo 'usage: mesh-usb-activity [--edge|--json|--test]' >&2; exit 1;; esac
live="$(live_read 2>/dev/null)" || { echo 'mesh-usb-activity: UNKNOWN — USB controller IRQ or runtime-status read unavailable/reset' >&2; exit 2; }
IFS='|' read -r irq_delta active_before active_after <<<"$live"
irq_moved=0; [ "$irq_delta" -gt 0 ] && irq_moved=1
device_moved=0; [ "$active_after" -ne "$active_before" ] && device_moved=1
label="$(classify "$irq_moved" "$device_moved")"
[ "$label" != UNKNOWN ] || exit 2
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" || exit 1
printf 'label=%s|xhci_irq_delta=%s|active_before=%s|active_after=%s|interval_s=%s|ts=%s\n' \
  "$label" "$irq_delta" "$active_before" "$active_after" "$INTERVAL" "$ts" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-usb-activity: UNKNOWN — state liveness stamp failed' >&2; exit 1; }
[ "${1:-}" = --edge ] && exit 0
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","xhci_irq_delta":%s,"active_before":%s,"active_after":%s,"interval_s":%s,"ts":"%s"}\n' "$label" "$irq_delta" "$active_before" "$active_after" "$INTERVAL" "$ts"
else
  printf '[usb-activity] %s — xhci_irq_delta=%s active_devices=%s→%s over %ss\n' "$label" "$irq_delta" "$active_before" "$active_after" "$INTERVAL"
fi
