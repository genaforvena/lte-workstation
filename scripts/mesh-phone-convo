#!/usr/bin/env bash
# mesh-phone-convo — phone-body voice conversation loop:
#   phone mic (opus) → WAV → whisper.cpp → text → mesh-relay → TTS on phone
#
# The phone IS the microphone and speaker. Operator speaks to the phone,
# the mesh hears, thinks via relay, and speaks back through the phone.
# Consent: requires ~/.mesh/consent mic_always=yes (operator-granted 2026-06-14).
#
#   mesh-phone-convo [-d SECONDS]   one round-trip (default: 8s listen window)
#   mesh-phone-convo --loop         continuous: listen → reply → repeat
#   mesh-phone-convo --test         smoke test (deps + phone reachability)
#
# Honest-exit: exit 2 = phone unreachable (never fakes a response).
# Requires: gst-launch-1.0 (gstreamer1.0-plugins-good), mesh-transcribe-organ,
#           mesh-relay, whisper.cpp + ggml model.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH_DIR="${HOME}/.mesh"
[ -f "${MESH_DIR}/nodes" ] && . "${MESH_DIR}/nodes"

DURATION="${MESH_CONVO_DURATION:-8}"
CONSENT="${MESH_DIR}/consent"

# ── smoke test — BEFORE consent gate (consent is runtime, not a dep) ─────────
# exit 0 = deps present; exit 1 = missing required dep; exit 2 = n/a on this node
if [ "${1:-}" = "--test" ]; then
  errs=0
  for cmd in mesh-transcribe-organ mesh-relay; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing $cmd)"; errs=$((errs+1)); }
  done
  # opus decode: gst-launch-1.0 preferred; ffmpeg is an acceptable fallback
  { command -v gst-launch-1.0 >/dev/null 2>&1 || command -v ffmpeg >/dev/null 2>&1; } \
    || { echo "smoke-test: FAIL (missing gst-launch-1.0 and ffmpeg — need one for opus decode)"; errs=$((errs+1)); }
  grep -qiE '^[[:space:]]*mic_always[[:space:]]*=[[:space:]]*(yes|true|1)([[:space:]#]|$)' "${CONSENT}" 2>/dev/null \
    || echo "smoke-test: WARN (no consent — add mic_always=yes to ${CONSENT} before use)"
  [ "$errs" -eq 0 ] && echo "smoke-test: ok" && exit 0
  exit 1
fi

# ── consent gate (for actual operation) ──────────────────────────────────────
if ! grep -qiE '^[[:space:]]*mic_always[[:space:]]*=[[:space:]]*(yes|true|1)([[:space:]#]|$)' "${CONSENT}" 2>/dev/null; then
  echo "mesh-phone-convo: consent required — add 'mic_always = yes' to ${CONSENT}" >&2; exit 1
fi

# ── phone coordinates ─────────────────────────────────────────────────────────
# Resolve user from registry; then probe each IP candidate (TS → LAN) to find
# one that actually accepts SSH — fixes silent fail when TS is up but sshd refused.
_puser=""; _pip=""
for _e in ${MESH_NODES:-}; do
  _lbl="$(printf '%s' "${_e%%:*}" | tr '[:upper:]' '[:lower:]')"
  case "$_lbl" in phone|redmi|"redmi 10") _addr="${_e#*:}"; _puser="${_addr%%@*}"; _pip="${_addr##*@}"; break;; esac
done
PHONE_USER="${MESH_PHONE_USER:-${_puser:-u0_a380}}"
PHONE_PORT="${MESH_PHONE_PORT:-8022}"
_SSH_PROBE=(-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new -p "$PHONE_PORT")
PHONE_IP="${MESH_PHONE_IP:-}"
if [ -z "$PHONE_IP" ]; then
  for _try in ${_pip:-} ${PHONE_LAN_IPS:-}; do
    [ -n "$_try" ] || continue
    if timeout 6 ssh "${_SSH_PROBE[@]}" "${PHONE_USER}@${_try}" 'echo ok' </dev/null 2>/dev/null | grep -q ok; then
      PHONE_IP="$_try"; break
    fi
  done
fi
[ -n "$PHONE_IP" ] || { echo "mesh-phone-convo: phone unreachable (tried registry + LAN candidates)" >&2; exit 2; }
SSH_PHONE=(ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -p "${PHONE_PORT}" "${PHONE_USER}@${PHONE_IP}")

phone_ok() { "${SSH_PHONE[@]}" "echo ok" </dev/null 2>/dev/null | grep -q ok; }

# ── one round-trip ────────────────────────────────────────────────────────────
one_round() {
  local dur="${1:-$DURATION}"
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN

  # 1. reachability
  phone_ok || { echo "mesh-phone-convo: phone unreachable (${PHONE_USER}@${PHONE_IP}:${PHONE_PORT})" >&2; return 2; }

  # 2. record on phone (opus, blocks for $dur seconds)
  echo "[phone-convo] listening ${dur}s …" >&2
  "${SSH_PHONE[@]}" "f=\${TMPDIR:-\$HOME}/pc-\$\$.opus
    termux-microphone-record -l ${dur} -f \"\$f\" -e opus -r 16000 -c 1 >/dev/null 2>&1
    cat \"\$f\"; rm -f \"\$f\"" </dev/null > "${tmp}/rec.opus" 2>/dev/null
  [ -s "${tmp}/rec.opus" ] || { echo "mesh-phone-convo: recording empty or failed" >&2; return 2; }

  # 3. opus → 16 kHz mono WAV (GStreamer; no ffmpeg needed)
  gst-launch-1.0 -q \
    filesrc location="${tmp}/rec.opus" ! oggdemux ! opusdec \
    ! audioconvert ! audioresample \
    ! audio/x-raw,format=S16LE,rate=16000,channels=1 \
    ! wavenc ! filesink location="${tmp}/rec.wav" 2>/dev/null
  [ -s "${tmp}/rec.wav" ] || { echo "mesh-phone-convo: opus→WAV failed" >&2; return 2; }

  # 4. transcribe
  local text; text="$(mesh-transcribe-organ "${tmp}/rec.wav" 2>/dev/null)"
  if [ -z "$text" ]; then
    echo "[phone-convo] silence / nothing heard" >&2
    return 0
  fi
  echo "[phone-convo] heard: ${text}" >&2

  # 5. relay → answer
  local prompt="[mesh conversation, phone mic] Respond concisely. Heard: ${text}"
  local reply; reply="$(printf '%s' "$prompt" | mesh-relay 2>/dev/null)"
  [ -n "$reply" ] || { echo "mesh-phone-convo: relay returned empty" >&2; return 2; }
  echo "[phone-convo] reply: ${reply}" >&2

  # 6. speak reply on phone
  "${SSH_PHONE[@]}" "termux-tts-speak $(printf '%q' "${reply}")" </dev/null 2>/dev/null || true
  return 0
}

case "${1:-}" in
  --loop)
    echo "[phone-convo] loop mode — Ctrl-C to stop" >&2
    while true; do one_round "${2:-$DURATION}" || true; sleep 1; done
    ;;
  --test) ;;   # handled above
  *) one_round "${1:-$DURATION}"; exit $? ;;
esac
