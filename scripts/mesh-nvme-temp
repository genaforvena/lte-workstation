#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# reflex-args: --edge
# mesh-nvme-temp — local NVMe controller temperature sense from /sys/class/nvme/*/hwmon*/temp*_input.
#
# Why this is new:
#   The tree already knows chassis / CPU / thermal-zone heat, but not the storage controller's own
#   temperature. NVMe hwmon is a distinct hardware signal: it can warn about throttling or heat
#   before generic thermal zones move.
#
# THE COMPOSITE IS NOT THE DRIVE'S TEMPERATURE (task mesh-nvme-temp, 2026-08-22).
#   Until this fix the glob was `temp1_input` ONLY — temp1 is the controller's *Composite*, a
#   vendor-defined summary, and on the BOOT+ROOT KINGSTON here it read 45.9C/COOL while temp2
#   ("Sensor 1") sat at 74850 — EXACTLY its own published warning line temp1_max=74850. An alarm
#   organ blind to N-1 of its N sensors reports the summary and calls it the maximum.
#   So: enumerate EVERY temp*_input per controller with its _label, publish BOTH the composite and
#   the hottest sensor plus WHICH label won, and derive the verdict from the hottest.
#
# THE ONLY REAL THRESHOLDS ARE temp1_max / temp1_crit.
#   Per-sensor temp{N>=2}_max on this controller is 65261850 (0xFFFF in the NVMe 0.01K encoding =
#   "unset") and temp*_min is -273150 (0 K). A ceiling of 65261.85C is not a ceiling: it passes
#   forever and turns a threshold check into a decoration. Any _max >= 65261850 or _min <= -273150
#   therefore renders the literal UNSET — loud, in the output, never coerced to a number — and
#   classify_temp itself REFUSES a sentinel ceiling so no caller can smuggle one in.
#
# Honest contract:
#   no readable NVMe hwmon temperature -> exit 2, never fabricate a reading
#
#   mesh-nvme-temp            one read → one classified line
#   mesh-nvme-temp --json     machine-readable (incl. the full per-sensor array)
#   mesh-nvme-temp --edge     emit only on band change (state still refreshed every success)
#   mesh-nvme-temp --test     fixture-backed classifier + real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
# MESH_TEST_SANDBOX=1 diverts the state write — pre-fix, --test's fixture + live self-invokes
# stamped the LIVE .nvme-temp.state (task test-live-writes 2026-07-20).
STATE="$MESH/.nvme-temp.state"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${TMPDIR:-/tmp}/.nvme-temp.state.sandbox.$$"
OFFLINEFILE="$MESH/.nvme-temp-offline"
ROOT="${MESH_NVME_ROOT:-/sys/class/nvme}"
mkdir -p "$MESH" 2>/dev/null || true

# The controller's "this attribute is not set" encodings, in millidegrees C as hwmon exports them.
# 0xFFFF * 0.01 K = 655.35 K above 0 K -> 65261850 mC; 0 K -> -273150 mC.
SENTINEL_MAX=65261850
SENTINEL_MIN=-273150

# real_thr <raw> <max|min> — prints the value ONLY if it is a threshold the controller actually
# published. Absent, non-numeric or sentinel -> prints nothing and returns 1 (the caller renders
# UNSET). Never returns a number for a sentinel: that is the whole point of the fix.
real_thr() {
  local v="${1:-}" kind="${2:-max}"
  case "$v" in ''|-|*[!0-9-]*) return 1 ;; esac
  case "$kind" in
    min) [ "$v" -le "$SENTINEL_MIN" ] 2>/dev/null && return 1 ;;
    *)   [ "$v" -ge "$SENTINEL_MAX" ] 2>/dev/null && return 1 ;;
  esac
  printf '%s' "$v"
}

# json_thr <raw> <max|min> — the JSON rendering of one threshold attribute:
#   file absent      -> null   (the controller does not publish it)
#   sentinel present -> "UNSET" (it publishes a non-threshold; say so, do not print 65261850)
#   otherwise        -> the number
json_thr() {
  local v="${1:-}" kind="${2:-max}" ok
  [ -n "$v" ] || { printf 'null'; return; }
  if ok="$(real_thr "$v" "$kind")"; then printf '%s' "$ok"; else printf '"UNSET"'; fi
}

format_c() {
  awk -v m="${1:-}" 'BEGIN{
    if (m == "" || m !~ /^[0-9]+$/) exit 1
    printf "%.1f", m / 1000
  }'
}

# classify_temp <raw> <max> <crit>
# max/crit are expected pre-sanitised by real_thr, but the sentinel refusal is repeated HERE on
# purpose: the classifier is what --test drives, so the gate must live where the decision is made.
classify_temp() {
  local raw="${1:-}" max="${2:-}" crit="${3:-}"
  case "$raw" in ''|*[!0-9]*) echo UNKNOWN; return ;; esac
  case "$max" in  ''|*[!0-9]*) max="" ;;  *) [ "$max"  -ge "$SENTINEL_MAX" ] 2>/dev/null && max="" ;;  esac
  case "$crit" in ''|*[!0-9]*) crit="" ;; *) [ "$crit" -ge "$SENTINEL_MAX" ] 2>/dev/null && crit="" ;; esac
  # A ceiling is AUTHORITATIVE only if the controller actually published it: real (not a sentinel,
  # filtered above) and positive. Collapse both tests into the emptiness of the variable so every
  # arm below can ask ONE question — "did this drive publish a ceiling?" — and no degenerate 0
  # can leave the fallback un-gated on the far side of an arm that declined to fire.
  { [ -n "$max" ]  && [ "$max"  -gt 0 ] 2>/dev/null ; } || max=""
  { [ -n "$crit" ] && [ "$crit" -gt 0 ] 2>/dev/null ; } || crit=""
  if [ -n "$crit" ] && [ "$raw" -ge "$crit" ] 2>/dev/null; then
    echo CRITICAL
  elif [ -n "$max" ] && [ "$raw" -ge "$max" ] 2>/dev/null; then
    echo HOT
  # ABSOLUTE-BAND FALLBACK, and it is GATED ON THE ABSENCE of a published ceiling — never a peer
  # arm beside the calibrated one (task nvme-hot-constant-shadows-the-drives-own-published-ceiling,
  # 2026-08-26). Un-gated, this constant DEFEATED the arm above it: the BOOT+ROOT Kingston here
  # publishes temp1_max=74850 / temp1_crit=79850, so arm 2 fired 15C below the drive's own warning
  # ceiling and arm 1 never fired at all (observed peak over 160 logged rows: 70.8C, 4C short).
  # Measured consequence over 35 up-hours of the board's timestamped tape: HOT dwell 10.00h vs WARM
  # 4.50h — 69% of measured up-time above the constant, i.e. the drive's ORDINARY duty band wearing
  # the word HOT, and 15 HEALTHY->DEGRADED storage-health flips whose "leading indicator" led
  # nowhere 15 times out of 15 (latency read FAST on every one). The whole calibrated apparatus
  # above — real_thr, the sentinel refusal, thr_from=temp1_max/temp1_crit — exists to read the
  # drive's OWN ceiling; a constant that fires first makes all of it decorative.
  # Twin of [[a-constant-outlives-its-reader]] and [[calibrate-a-derived-axis-against-the-live-corpus]].
  elif [ -z "$max" ] && [ "$raw" -ge 60000 ] 2>/dev/null; then
    echo HOT
  elif [ "$raw" -ge 45000 ] 2>/dev/null; then
    echo WARM
  else
    echo COOL
  fi
}

sev_rank() {
  case "${1:-}" in CRITICAL) echo 3 ;; HOT) echo 2 ;; WARM) echo 1 ;; COOL) echo 0 ;; *) echo -1 ;; esac
}

# scan_hwmon <hwmon dir> — one controller. Emits ONE tab-separated record:
#   hot_raw hot_label hot_n hot_src comp_raw comp_label max crit nsensors nunset sensors_json
# Fields are separated by US (0x1f), NOT tab: tab is an IFS-whitespace character, so `IFS=$'\t' read`
# COLLAPSES consecutive tabs and an empty (UNSET) threshold would silently shift every later field
# onto the wrong variable. A non-whitespace IFS preserves empty fields.
# max/crit are temp1_*'s ONLY, already passed through real_thr (so: a number, or empty=UNSET).
scan_hwmon() {
  local d="$1" f n label raw smax scrit smin
  local comp_raw="" comp_label="" max="" crit=""
  local hot_raw="" hot_label="" hot_n="" hot_src=""
  local nsens=0 nunset=0 sj=""
  shopt -s nullglob
  for f in "$d"/temp*_input; do
    n="${f##*/}"; n="${n#temp}"; n="${n%_input}"
    case "$n" in ''|*[!0-9]*) continue ;; esac
    [ -r "$f" ] || continue
    raw="$(cat "$f" 2>/dev/null)"
    case "$raw" in ''|*[!0-9]*) continue ;; esac
    label="$(cat "$d/temp${n}_label" 2>/dev/null || true)"
    label="${label//\"/}"; label="${label//	/ }"
    [ -n "$label" ] || label="temp${n}"
    nsens=$((nsens + 1))
    smax="$(cat "$d/temp${n}_max" 2>/dev/null || true)"
    scrit="$(cat "$d/temp${n}_crit" 2>/dev/null || true)"
    smin="$(cat "$d/temp${n}_min" 2>/dev/null || true)"
    # count every attribute that EXISTS but is a sentinel — this is the loud part
    [ -n "$smax" ]  && ! real_thr "$smax" max   >/dev/null && nunset=$((nunset + 1))
    [ -n "$scrit" ] && ! real_thr "$scrit" max  >/dev/null && nunset=$((nunset + 1))
    [ -n "$smin" ]  && ! real_thr "$smin" min   >/dev/null && nunset=$((nunset + 1))
    sj="$sj${sj:+,}{\"n\":$n,\"label\":\"$label\",\"mC\":$raw,\"c\":$(format_c "$raw"),\"max_mC\":$(json_thr "$smax" max),\"crit_mC\":$(json_thr "$scrit" max),\"min_mC\":$(json_thr "$smin" min)}"
    if [ "$n" = 1 ]; then
      comp_raw="$raw"; comp_label="$label"
      max="$(real_thr "$smax" max)"; crit="$(real_thr "$scrit" max)"
    fi
    if [ -z "$hot_raw" ] || [ "$raw" -gt "$hot_raw" ]; then
      hot_raw="$raw"; hot_label="$label"; hot_n="$n"; hot_src="$f"
    fi
  done
  shopt -u nullglob
  [ -n "$hot_raw" ] || return 1
  printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037[%s]\n' \
    "$hot_raw" "$hot_label" "$hot_n" "$hot_src" "$comp_raw" "$comp_label" \
    "$max" "$crit" "$nsens" "$nunset" "$sj"
}

# discover_nvme — every controller, worst verdict wins (tie -> hottest sensor). Selecting on the
# VERDICT and not on the raw degree matters: two drives publish different ceilings, and 74.9C on a
# 74.85C-warning drive is an incident where the same degree on a 89.85C drive is not.
discover_nvme() {
  local d rec best="" best_rank=-2 best_hot=-1 lbl rank hot
  shopt -s nullglob
  for d in "$ROOT"/*/hwmon*; do
    [ -d "$d" ] || continue
    rec="$(scan_hwmon "$d")" || continue
    IFS=$'\037' read -r hot _ _ _ _ _ _max _crit _ _ _ <<<"$rec"
    lbl="$(classify_temp "$hot" "$_max" "$_crit")"
    rank="$(sev_rank "$lbl")"
    if [ "$rank" -gt "$best_rank" ] || { [ "$rank" -eq "$best_rank" ] && [ "$hot" -gt "$best_hot" ]; }; then
      best_rank="$rank"; best_hot="$hot"; best="$rec"$'\037'"$d"
    fi
  done
  shopt -u nullglob
  [ -n "$best" ] || return 1
  printf '%s\n' "$best"
}

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  # TEST-SANDBOX (task test-live-writes 2026-07-20): self-invokes divert; %y sig gate before exits.
  export MESH_TEST_SANDBOX=1
  _nt_live="$HOME/.mesh/.nvme-temp.state"
  _nt_sig="$(stat -c '%y %s' "$_nt_live" 2>/dev/null || echo absent)"
  # Shared honesty gate — BOTH exits (the live-read n/a path and the ok path) must run it, and both
  # must attribute a moved artifact rather than blame the test. See the comment inside.
  _nt_honesty_gate() {
    local _c; _c="$(stat -c '%y %s' "$_nt_live" 2>/dev/null || echo absent)"
    [ "$_c" = "$_nt_sig" ] && return 0
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick */15, or any other tool that writes
    # the same path) stamping it inside the test window. The single-sample form blamed the test and
    # went red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land
    # and mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    local _fail="smoke-test: FAIL (--test stamped the LIVE state $_nt_live: '$_nt_sig' → '$_c' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "$_fail"; exit 1; fi
    local _a _b
    _a="$(stat -c '%y %s' "$_nt_live" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _b="$(stat -c '%y %s' "$_nt_live" 2>/dev/null || echo absent)"
    [ "$_b" = "$_a" ] || { echo "$_fail"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  fail=0
  nass=0
  # NEVER hand-maintain a count beside the roster it summarises (the mesh-restore "(15-channel set)"
  # lesson: the hand-written number was wrong in both directions at once). Count what actually ran.
  _ok() { nass=$((nass + 1)); }
  _t() {  # _t <name> <json> <grep-pattern>   — assert the pattern is PRESENT
    _ok; printf '%s\n' "$2" | grep -qF -- "$3" || { echo "  FAIL $1: missing '$3' in: $2"; fail=1; }
  }
  _tn() { # _tn <name> <json> <grep-pattern>  — assert the pattern is ABSENT
    _ok; printf '%s\n' "$2" | grep -qF -- "$3" && { echo "  FAIL $1: forbidden '$3' present in: $2"; fail=1; }
    return 0
  }
  _mk() { # _mk <dir> <n> <input> <label> [max] [crit] [min]
    mkdir -p "$1"
    printf '%s\n' "$3" > "$1/temp$2_input"
    printf '%s\n' "$4" > "$1/temp$2_label"
    [ -n "${5:-}" ] && printf '%s\n' "$5" > "$1/temp$2_max"
    [ -n "${6:-}" ] && printf '%s\n' "$6" > "$1/temp$2_crit"
    [ -n "${7:-}" ] && printf '%s\n' "$7" > "$1/temp$2_min"
    return 0
  }
  _run() { MESH_NVME_ROOT="$1" bash "$0" --json 2>/dev/null; }

  # --- A. legacy single-sensor regression: composite alone still classifies as it always did.
  _mk "$td/a/nvme0/hwmon0" 1 36850 Composite 50000 70000
  A="$(_run "$td/a")" || { echo "smoke-test: FAIL (fixture A read)"; exit 1; }
  _t A-label "$A" '"label":"COOL"'
  _t A-temp  "$A" '"temp_c":36.9'
  _t A-hot   "$A" '"hot_label":"Composite"'
  _t A-src   "$A" "\"source\":\"$td/a/nvme0/hwmon0/temp1_input\""

  # --- B. THE FIX (task scope d). sensor2 is HOTTER than the composite AND its own _max is the
  # 0xFFFF sentinel. This one fixture kills BOTH failure modes at once:
  #   * blind to temp2  -> the verdict would be COOL/36.9 off the composite      -> B-label/B-temp red
  #   * sentinel as ceiling -> 52000 < 65261850, so it would drop to the 45C band -> WARM, B-label red
  # The right answer is HOT: 52000 >= temp1_max 50000, the ONLY real ceiling published.
  _mk "$td/b/nvme0/hwmon0" 1 36850 Composite 50000 70000 -273150
  _mk "$td/b/nvme0/hwmon0" 2 52000 "Sensor 1" 65261850 "" -273150
  _mk "$td/b/nvme0/hwmon0" 3 41000 "Sensor 2" 65261850 "" -273150
  B="$(_run "$td/b")" || { echo "smoke-test: FAIL (fixture B read)"; exit 1; }
  _t  B-label     "$B" '"label":"HOT"'
  _t  B-hot-temp  "$B" '"temp_c":52.0'
  _t  B-hot-label "$B" '"hot_label":"Sensor 1"'
  _t  B-hot-n     "$B" '"hot_n":2'
  _t  B-composite "$B" '"composite_c":36.9'
  _t  B-comp-lbl  "$B" '"composite_label":"Composite"'
  _t  B-src       "$B" "\"source\":\"$td/b/nvme0/hwmon0/temp2_input\""
  _t  B-nsens     "$B" '"sensors_n":3'
  _t  B-unset-n   "$B" '"unset_thresholds":5'
  _t  B-sensor2   "$B" '{"n":2,"label":"Sensor 1","mC":52000,"c":52.0,"max_mC":"UNSET","crit_mC":null,"min_mC":"UNSET"}'
  # scope (c): the sentinel must NEVER reach the output as a number, anywhere.
  _tn B-no-sentinel "$B" '65261850'
  _tn B-no-absmin   "$B" '-273150'

  # --- C. the controller publishes NO real threshold at all (both temp1_* are sentinels): the
  # verdict must fall back to the absolute bands and both ceilings must render UNSET, never 65261.9C.
  _mk "$td/c/nvme0/hwmon0" 1 30000 Composite 65261850 65261850 -273150
  _mk "$td/c/nvme0/hwmon0" 2 62000 "Sensor 1" 65261850 "" -273150
  C="$(_run "$td/c")" || { echo "smoke-test: FAIL (fixture C read)"; exit 1; }
  _t  C-label "$C" '"label":"HOT"'
  _t  C-max   "$C" '"max_mC":"UNSET"'
  _t  C-crit  "$C" '"crit_mC":"UNSET"'
  _tn C-no-sentinel "$C" '65261850'

  # --- D. crit still wins over max, measured on the HOTTEST sensor.
  _mk "$td/d/nvme0/hwmon0" 1 36850 Composite 50000 70000
  _mk "$td/d/nvme0/hwmon0" 2 71000 "Sensor 1" 65261850
  D="$(_run "$td/d")"
  _t D-label "$D" '"label":"CRITICAL"'
  _t D-temp  "$D" '"temp_c":71.0'

  # --- E. no threshold FILES at all. Guards the field-shift trap: an empty (UNSET) threshold in a
  # tab-separated record would collapse under IFS-whitespace and slide `source` into `max`.
  _mk "$td/e/nvme0/hwmon0" 1 30000 Composite
  _mk "$td/e/nvme0/hwmon0" 2 47000 "Sensor 1"
  E="$(_run "$td/e")"
  _t E-label "$E" '"label":"WARM"'
  _t E-max   "$E" '"max_mC":"UNSET"'
  _t E-nsens "$E" '"sensors_n":2'
  _t E-src   "$E" "\"source\":\"$td/e/nvme0/hwmon0/temp2_input\""
  _t E-unset "$E" '"unset_thresholds":0'

  # --- F. two controllers: the WORST VERDICT wins, not the highest degree. B is 9C hotter but sits
  # far under its own 89.85C ceiling; A has crossed its own 70C crit. Picking on degrees alone would
  # report the healthy drive and hide the incident.
  _mk "$td/f/nvme0/hwmon0" 1 40000 Composite 60000 70000
  _mk "$td/f/nvme0/hwmon0" 2 76000 "Sensor 1" 65261850
  _mk "$td/f/nvme1/hwmon1" 1 40000 Composite 89850 94850
  _mk "$td/f/nvme1/hwmon1" 2 85000 "Sensor 1" 65261850
  F="$(_run "$td/f")"
  _t F-label "$F" '"label":"CRITICAL"'
  _t F-temp  "$F" '"temp_c":76.0'
  _t F-ctrl  "$F" "\"controller\":\"$td/f/nvme0/hwmon0\""

  # --- G. the classifier itself, called directly: a sentinel ceiling must be REFUSED at the point
  # of decision, not merely filtered by the caller. (A gate that lives only in the reader is one
  # refactor away from being bypassed.)
  # NOTE on what is gateable here: the sentinel refusal on the MAX branch is unobservable by
  # construction — no physical reading can reach 65261850, so `raw >= max` is false either way and
  # a mutant that drops it stays green. That leg's REAL gate is real_thr (G-real_thr-max, seen red)
  # plus fixture B. The CRIT branch, however, does bite: without the refusal a sentinel crit makes
  # `raw >= crit` decidable and would mint a CRITICAL. Assert the branch that can actually fail.
  _ok; g1="$(classify_temp 65261850 "" 65261850)"
  [ "$g1" = HOT ] || { echo "  FAIL G-sentinel-crit: classify_temp accepted the sentinel as a CRITICAL threshold (got '$g1', want HOT via the absolute bands)"; fail=1; }
  _ok; g2="$(classify_temp 52000 50000 70000)"
  [ "$g2" = HOT ] || { echo "  FAIL G-real-ceiling: classify_temp ignored a REAL ceiling (got '$g2', want HOT)"; fail=1; }
  _ok; g3="$(real_thr 65261850 max)"; [ -z "$g3" ] || { echo "  FAIL G-real_thr-max: sentinel rendered as '$g3'"; fail=1; }
  _ok; g4="$(real_thr -273150 min)"; [ -z "$g4" ] || { echo "  FAIL G-real_thr-min: 0K sentinel rendered as '$g4'"; fail=1; }
  _ok; g5="$(real_thr 74850 max)"; [ "$g5" = 74850 ] || { echo "  FAIL G-real_thr-live: a real ceiling was dropped (got '$g5')"; fail=1; }

  # --- H. THE CONSTANT IS A FALLBACK, NOT A PEER ARM (task
  # nvme-hot-constant-shadows-the-drives-own-published-ceiling). Every number here is THIS node's
  # BOOT+ROOT Kingston: temp1_max=74850, temp1_crit=79850, ordinary duty band straddling 60000.
  # H1/H2 are the two arms of the fix; H3/H4 are the CONTROLS that must not move.
  # Mutant to drive: delete the `[ -z "$max" ] &&` gate on the fallback arm -> H1 and H1-sysfs go
  # red (61850 mints HOT again 13C below the drive's own ceiling) while H2/H3/H4 stay green.
  _ok; h1="$(classify_temp 61850 74850 79850)"
  [ "$h1" = WARM ] || { echo "  FAIL H1-ceiling-is-authority: 61.85C on a drive publishing max=74.85C read '$h1', want WARM — the 60000 constant is shadowing the drive's own ceiling"; fail=1; }
  _ok; h2="$(classify_temp 61850 "" "")"
  [ "$h2" = HOT ] || { echo "  FAIL H2-fallback-survives: 61.85C on a controller publishing NO ceiling read '$h2', want HOT — the absolute-band fallback was deleted, not gated"; fail=1; }
  _ok; h3="$(classify_temp 79850 74850 79850)"
  [ "$h3" = CRITICAL ] || { echo "  FAIL H3-control-crit: raw==crit read '$h3', want CRITICAL"; fail=1; }
  _ok; h4="$(classify_temp 74850 74850 79850)"
  [ "$h4" = HOT ] || { echo "  FAIL H4-control-max: raw==max read '$h4', want HOT off the published ceiling"; fail=1; }
  # A degenerate ceiling (0) is NOT a published one — the fallback must still cover it, or the gate
  # opens a hole exactly where arm 1 declines to fire.
  _ok; h5="$(classify_temp 61850 0 0)"
  [ "$h5" = HOT ] || { echo "  FAIL H5-degenerate-ceiling: max=0 is not a published ceiling; read '$h5', want HOT via the fallback"; fail=1; }
  # ...and the same two arms through the WHOLE read path, not just the classifier: a fixture-only
  # gate cannot see a caller that stops passing the ceiling through.
  _mk "$td/h1/nvme0/hwmon0" 1 40850 Composite 74850 79850 -273150
  _mk "$td/h1/nvme0/hwmon0" 2 61850 "Sensor 1" 65261850 "" -273150
  H1="$(_run "$td/h1")"
  _t H1-sysfs-label "$H1" '"label":"WARM"'
  _t H1-sysfs-temp  "$H1" '"temp_c":61.9'
  _t H1-sysfs-max   "$H1" '"max_mC":74850'
  _mk "$td/h2/nvme0/hwmon0" 1 40850 Composite 65261850 65261850 -273150
  _mk "$td/h2/nvme0/hwmon0" 2 61850 "Sensor 1" 65261850 "" -273150
  H2="$(_run "$td/h2")"
  _t H2-sysfs-label "$H2" '"label":"HOT"'
  _t H2-sysfs-max   "$H2" '"max_mC":"UNSET"'

  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }

  _ok; _ok; _ok; _ok; _ok
  real="$(bash "$0" --json 2>/dev/null)" || { _nt_honesty_gate; echo "smoke-test: n/a (no live NVMe hwmon source on this node)"; exit 2; }
  printf '%s\n' "$real" | grep -q '"source":"/sys/class/nvme/' || {
    echo "smoke-test: FAIL (live read missing sysfs source: $real)"; exit 1;
  }
  printf '%s\n' "$real" | grep -q '"temp_c":[0-9]' || {
    echo "smoke-test: FAIL (live read missing numeric temperature: $real)"; exit 1;
  }
  # The live read must ALSO carry the new axes — a real hardware read that publishes only the
  # composite is exactly the blindness this task closed, and would pass every fixture above.
  printf '%s\n' "$real" | grep -q '"composite_c":[0-9]' || {
    echo "smoke-test: FAIL (live read publishes no composite: $real)"; exit 1;
  }
  printf '%s\n' "$real" | grep -q '"hot_label":"[^"]\+"' || {
    echo "smoke-test: FAIL (live read names no winning sensor label: $real)"; exit 1;
  }
  printf '%s\n' "$real" | grep -qF '65261850' && {
    echo "smoke-test: FAIL (live read leaked the 0xFFFF sentinel as a number: $real)"; exit 1;
  }
  # sandbox honesty gate. Falsify: drop the MESH_TEST_SANDBOX diversion at the STATE assignment.
  _nt_honesty_gate
  echo "smoke-test: ok ($nass assertions over 8 fixtures + the classifier unit gate + the live read: hot-sensor-beats-composite, sentinel refused by real_thr and never rendered as a number, sentinel CRIT refused in the classifier, crit>max on the hottest sensor, empty-threshold field integrity, worst-verdict-wins across controllers, the 60C constant gated as a FALLBACK behind a published ceiling and surviving where none is published, live NVMe hwmon read carrying composite+hot+no-sentinel)"
  exit 0
fi

JSON=0
EDGE=0
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --edge) EDGE=1 ;;
  esac
done

readout="$(discover_nvme 2>/dev/null || true)"
[ -n "$readout" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "nvme-temp: UNREACHABLE — no readable NVMe hwmon temp*_input" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

IFS=$'\037' read -r RAW HOTLABEL HOTN SOURCE COMP_RAW COMP_LABEL MAX CRIT NSENS NUNSET SENSORS CTRL <<<"$readout"
TEMP_C="$(format_c "$RAW")" || { echo "nvme-temp: UNREACHABLE — invalid temperature '$RAW'" >&2; exit 2; }
COMP_C="$(format_c "$COMP_RAW")" || COMP_C=""
# MAX/CRIT reached here ONLY through real_thr, so they are a real number or empty. Empty is
# rendered UNSET everywhere a human or machine reads it — never a number, never silently dropped.
LABEL="$(classify_temp "$RAW" "$MAX" "$CRIT")"
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
PREV_LABEL=""
[ -f "$STATE" ] && PREV_LABEL="$(cut -d'|' -f1 "$STATE" 2>/dev/null || true)"

printf '%s|%s|%s|%s|%s|%s|%s|hot_label=%s|hot_n=%s|composite_mC=%s|composite_c=%s|composite_label=%s|sensors=%s|unset_thresholds=%s|thr_from=temp1_max/temp1_crit\n' \
  "$LABEL" "$RAW" "$TEMP_C" "${MAX:-UNSET}" "${CRIT:-UNSET}" "$SOURCE" "$TS" \
  "$HOTLABEL" "$HOTN" "${COMP_RAW:-na}" "${COMP_C:-na}" "${COMP_LABEL:-na}" "$NSENS" "$NUNSET" > "$STATE"
mesh-state-touch "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","temp_mC":%s,"temp_c":%s,"hot_label":"%s","hot_n":%s,"composite_mC":%s,"composite_c":%s,"composite_label":"%s","max_mC":%s,"crit_mC":%s,"thr_from":"temp1_max/temp1_crit","sensors_n":%s,"unset_thresholds":%s,"sensors":%s,"source":"%s","controller":"%s","ts":"%s"}\n' \
    "$LABEL" "$RAW" "$TEMP_C" "$HOTLABEL" "$HOTN" \
    "${COMP_RAW:-null}" "${COMP_C:-null}" "${COMP_LABEL:-}" \
    "${MAX:-\"UNSET\"}" "${CRIT:-\"UNSET\"}" "$NSENS" "$NUNSET" "$SENSORS" "$SOURCE" "$CTRL" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ] && [ "$PREV_LABEL" = "$LABEL" ]; then
  exit 0
fi

printf '[nvme-temp] %s — %s°C "%s" (composite %s°C "%s"; max=%s crit=%s from temp1_*; sensors=%s unset-thresholds=%s source=%s) @ %s %s\n' \
  "$LABEL" "$TEMP_C" "$HOTLABEL" "${COMP_C:-na}" "${COMP_LABEL:-na}" \
  "${MAX:-UNSET}" "${CRIT:-UNSET}" "$NSENS" "$NUNSET" "$SOURCE" "$(hostname)" "$TS"
