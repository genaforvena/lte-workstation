#!/usr/bin/env bash
# mesh-genome-sync — keep the genome alive in two homes: GitHub (origin) and the
# mesh mirror (default-string bare repo). Pull origin, push mirror. Exit reflects truth.
# reflex: emergency
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
LOG="$HOME/.mesh/genome-sync.log"; BACKOFF="$HOME/.mesh/.genome-sync-alert"; mkdir -p "$HOME/.mesh"
ts(){ date -u +%FT%TZ; }
cd "$HOME/lte-workstation" || exit 1
git pull --ff-only --quiet origin main 2>/dev/null
git push --quiet mesh main 2>/dev/null || {
  echo "$(ts) FAIL push to mesh mirror" >> "$LOG"
  # Alert with 6h backoff to avoid spam when mirror node is offline for days
  now=$(date +%s); last=$(cat "$BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 21600 ]; then
    echo "$now" > "$BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "⚠️ genome-sync: mesh mirror push FAILED — check default-string (mirror repo unreachable)" >/dev/null 2>&1 || true
  fi
  exit 1
}
echo "$(ts) OK $(git rev-parse --short HEAD) -> mirror" >> "$LOG"
rm -f "$BACKOFF"  # push succeeded — reset backoff
exit 0
