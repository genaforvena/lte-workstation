#!/usr/bin/env bash
# mesh-genome-sync — keep the genome alive in two homes: GitHub (origin) and
# TWO mesh mirrors: default-string (mesh remote) + phaedra (phaedra remote).
# Pull origin, push both mirrors. Succeed if EITHER mirror lands (ANTI-SPOF 2026-06-15).
# reflex: emergency
set -uo pipefail
[ "${1:-}" = --test ] && { [ -d "$HOME/lte-workstation/.git" ] || { echo "smoke-test: FAIL (no git repo)"; exit 1; }; echo "smoke-test: ok"; exit 0; }
export PATH="$HOME/.local/bin:$PATH"
LOG="$HOME/.mesh/genome-sync.log"; BACKOFF="$HOME/.mesh/.genome-sync-alert"; mkdir -p "$HOME/.mesh"
ts(){ date -u +%FT%TZ; }
cd "$HOME/lte-workstation" || exit 1
# Mirror tracks origin/main (GitHub = source of truth), NOT this node's LOCAL main. A working repo's
# local main can hold un-pushed or rebased-away commits, and pushing THAT forks the mirror permanently
# (2026-06-12: mirror diverged 27 commits with non-origin commits → push rejected forever). `fetch`
# (not pull) refreshes the origin/main ref WITHOUT touching the working tree/local main — so a diverged
# local can't block the sync. Then force-push origin/main to the mirror: the mirror is a pure backup
# written ONLY by this tool, so force is safe + SELF-HEALING (re-seeds a forked mirror automatically).
git fetch --quiet origin main 2>/dev/null
ref=$(git rev-parse --verify --quiet origin/main) || { echo "$(ts) FAIL no origin/main ref" >> "$LOG"; exit 1; }
# Push to BOTH mirrors; succeed if EITHER lands (ANTI-SPOF 2026-06-15).
ds_ok=0; pha_ok=0
timeout 15 git push --quiet --force mesh    "origin/main:main" 2>/dev/null && ds_ok=1 || true
timeout 15 git push --quiet --force phaedra "origin/main:main" 2>/dev/null && pha_ok=1 || true

if [ "$ds_ok" = 0 ] && [ "$pha_ok" = 0 ]; then
  echo "$(ts) FAIL push to BOTH mirrors (mesh=${ds_ok} phaedra=${pha_ok})" >> "$LOG"
  now=$(date +%s); last=$(cat "$BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 21600 ]; then
    echo "$now" > "$BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "⚠️ genome-sync: BOTH mirrors FAILED — check default-string + phaedra (${ref:0:7})" >/dev/null 2>&1 || true
  fi
  exit 1
fi

echo "$(ts) OK ${ref:0:7} (origin/main) -> mesh=${ds_ok} phaedra=${pha_ok}" >> "$LOG"
rm -f "$BACKOFF"  # at least one mirror succeeded — reset backoff
exit 0
