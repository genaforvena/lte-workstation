#!/usr/bin/env bash
# mesh-genome-sync — keep the genome alive off GitHub: an ANCHOR mirror on the node that runs
# this, plus best-effort bare mirrors on peer nodes.
#
#   anchor  ($MESH_GENOME_MIRROR, default $HOME/genome-mirror.git) — local fs on THIS node,
#           auto-created, air-gap-proof. This is the leg that cannot fail by design.
#   mesh / phaedra / ideapad — peer bare mirrors, best-effort, skipped when unreachable.
#
# The anchor is bound to the NODE THAT RUNS IT, never to a peer's name. The old version's
# "always lands, cannot fail by design" leg was the remote literally named `ideapad` — its
# local-fs property held only while the minds lived on IdeaPad. They moved to mesh-home
# 2026-07-14 and the leg became a push to /home/imozerov/genome-mirror.git, a path that does
# not exist here, so the tool could only FAIL on this node. Same family as the TG_HOST
# predicate that aged out. A backup is worthless if it is 8 days stale WHEN the emergency
# arrives: currency must precede the emergency, so this carries a cadence, not `reflex: emergency`.
#
# reflex-cadence: 7,37 * * * *
set -uo pipefail

ts(){ date -u +%FT%TZ; }

# Land $2 (a sha) in the bare repo at $1, creating it if absent. Returns 0 ONLY if the mirror's
# refs/heads/main actually EQUALS $2 afterwards — a push that exits 0 without moving the ref is
# the exact fiction this tool exists to prevent, so the artifact is asserted, not the exit code.
mirror_land(){
  local mirror="$1" ref="$2" landed
  # An empty ref makes the push below `:refs/heads/main` — a DELETE, which exits 0 and leaves
  # landed="" == ref="", so the tool would wipe the backup and report it landed.
  [ -n "$ref" ] || return 1
  [ -d "$mirror" ] || git init --quiet --bare "$mirror" 2>/dev/null || return 1
  git push --quiet --force "$mirror" "${ref}:refs/heads/main" 2>/dev/null || return 1
  landed=$(git --git-dir="$mirror" rev-parse --verify --quiet refs/heads/main 2>/dev/null) || return 1
  [ "$landed" = "$ref" ]
}

# Same for a peer remote, verified by ls-remote. rc 0 = landed · 1 = failed · 2 = unreachable
# (honest n/a — an offline peer is not a fault of ours and must not read as a failed mirror).
peer_land(){
  local peer="$1" ref="$2" landed
  [ -n "$ref" ] || return 1   # see mirror_land: an empty ref deletes the peer's main
  timeout 5 git ls-remote --quiet "$peer" HEAD >/dev/null 2>&1 || return 2
  timeout 20 git push --quiet --force "$peer" "${ref}:refs/heads/main" 2>/dev/null || return 1
  landed=$(timeout 10 git ls-remote "$peer" refs/heads/main 2>/dev/null | awk '{print $1}')
  [ "$landed" = "$ref" ]
}

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  t=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$t"' EXIT
  ( cd "$t" && git init --quiet src && cd src \
      && git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m one \
  ) || { echo "smoke-test: FAIL (cannot build fixture)"; exit 1; }
  cd "$t/src" || { echo "smoke-test: FAIL (cannot cd fixture)"; exit 1; }
  sha=$(git rev-parse HEAD)

  # 1. the REAL path, no network: an ABSENT anchor is created and the ref LANDS in it
  mirror_land "$t/anchor.git" "$sha" || { echo "smoke-test: FAIL (anchor push did not land)"; exit 1; }
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha" ] || { echo "smoke-test: FAIL (mirror ref ${got:-none} != $sha)"; exit 1; }

  # 2. it MOVES on a second commit. A mirror that lands once and then sticks IS the staleness
  #    this tool exists to prevent, and a create-only assertion cannot tell the two apart.
  git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m two
  sha2=$(git rev-parse HEAD)
  mirror_land "$t/anchor.git" "$sha2" || { echo "smoke-test: FAIL (second push did not land)"; exit 1; }
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha2" ] || { echo "smoke-test: FAIL (mirror stuck at ${got:-none}, expected $sha2)"; exit 1; }

  # 3. the NEGATIVE: an anchor that cannot be written must FAIL, never report a landing —
  #    the bug being fixed was a success predicate that could not tell those apart.
  if mirror_land "/proc/nonexistent/anchor.git" "$sha2" 2>/dev/null; then
    echo "smoke-test: FAIL (unwritable anchor reported OK — the success predicate is fiction)"; exit 1
  fi

  # 4. an EMPTY ref must not touch the mirror. Unguarded, the push degrades to `:refs/heads/main`
  #    — a delete that exits 0 — and the landed==ref check passes on ""=="" : OK while the backup
  #    is GONE. The mirror must still hold sha2 and the call must report failure.
  if mirror_land "$t/anchor.git" "" 2>/dev/null; then
    echo "smoke-test: FAIL (empty ref reported as landed)"; exit 1
  fi
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha2" ] || { echo "smoke-test: FAIL (empty ref DESTROYED the mirror: main is now '${got:-deleted}')"; exit 1; }

  echo "smoke-test: ok (anchor creates+lands, moves on a new commit, fails honestly when unwritable, empty ref cannot wipe it)"
  exit 0
fi

export PATH="$HOME/.local/bin:$PATH"
LOG="$HOME/.mesh/genome-sync.log"; BACKOFF="$HOME/.mesh/.genome-sync-alert"; mkdir -p "$HOME/.mesh"
cd "$HOME/lte-workstation" || exit 1
hostname=$(hostname 2>/dev/null || echo "")

# phaedra is a mirror LEAF, not a syncer: it pulls the genome down rather than pushing it out.
if [ "$hostname" = "phaedra" ]; then
  git fetch --quiet ideapad main 2>/dev/null || { echo "$(ts) FAIL fetch from ideapad" >> "$LOG"; exit 1; }
  ref=$(git rev-parse --verify --quiet ideapad/main 2>/dev/null) || { echo "$(ts) FAIL no ideapad/main ref" >> "$LOG"; exit 1; }
  git update-ref refs/heads/main "$ref" 2>/dev/null || { echo "$(ts) FAIL update-ref main" >> "$LOG"; exit 1; }
  echo "$(ts) OK ${ref:0:7} (ideapad/main) -> pulled to phaedra" >> "$LOG"
  rm -f "$BACKOFF"
  exit 0
fi

# A failed fetch leaves origin/main at its last-known value; mirroring that is still worth doing,
# but it is a STALE ref and the log must say so rather than call it current.
src="origin/main"
git fetch --quiet origin main 2>/dev/null || src="origin/main(stale — fetch failed)"
ref=$(git rev-parse --verify --quiet origin/main) || { echo "$(ts) FAIL no origin/main ref" >> "$LOG"; exit 1; }

ANCHOR="${MESH_GENOME_MIRROR:-$HOME/genome-mirror.git}"
mirror_land "$ANCHOR" "$ref" && anchor="ok" || anchor="FAIL"

# Explicit peer list, never "every remote": `ilya` is a live working checkout, not a bare mirror,
# and force-pushing main into someone's working repo is hostile.
peers=""
for p in mesh phaedra ideapad; do
  git remote get-url "$p" >/dev/null 2>&1 || continue
  [ "$(git remote get-url "$p")" = "$ANCHOR" ] && continue   # the anchor already landed above
  peer_land "$p" "$ref"; rc=$?
  case $rc in
    0) peers="$peers $p=ok" ;;
    2) peers="$peers $p=unreachable" ;;
    *) peers="$peers $p=fail" ;;
  esac
done

if [ "$anchor" != "ok" ]; then
  echo "$(ts) FAIL anchor $ANCHOR did not land ${ref:0:7} (peers:${peers:- none})" >> "$LOG"
  now=$(date +%s); last=$(cat "$BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 21600 ]; then
    echo "$now" > "$BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "⚠️ genome-sync: anchor mirror $ANCHOR FAILED — check disk + fs (${ref:0:7})" >/dev/null 2>&1 || true
  fi
  exit 1
fi

echo "$(ts) OK ${ref:0:7} ($src) -> anchor=ok${peers:+ peers:$peers}" >> "$LOG"
rm -f "$BACKOFF"
exit 0
