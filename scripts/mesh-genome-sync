#!/usr/bin/env bash
# mesh-genome-sync — keep the genome alive in two homes: GitHub (origin) and the
# mesh mirror (default-string bare repo). Pull origin, push mirror. Exit reflects truth.
# reflex: emergency
set -uo pipefail
cd "$HOME/lte-workstation" || exit 1
git pull --ff-only --quiet origin main 2>/dev/null
git push --quiet mesh main 2>/dev/null || { echo "$(date -u +%FT%TZ) FAIL push to mesh mirror" >> "$HOME/.mesh/genome-sync.log"; exit 1; }
echo "$(date -u +%FT%TZ) OK $(git rev-parse --short HEAD) -> mirror" >> "$HOME/.mesh/genome-sync.log"
exit 0
