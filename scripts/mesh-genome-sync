#!/usr/bin/env bash
# mesh-genome-sync — keep the genome alive: GitHub (origin) + THREE bare mirrors:
#   ideapad  (local fs, air-gap-proof, always reachable)
#   mesh     (default-string, best-effort)
#   phaedra  (remote peer, second independent node)
# Pull origin, push ALL mirrors. Succeed if EITHER ideapad OR phaedra lands (ANTI-SPOF2).
# ideapad is local → always lands → the push step cannot fail by design.
# reflex: emergency
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  [ -d "$HOME/lte-workstation/.git" ] || { echo "smoke-test: FAIL (no git repo)"; exit 1; }
  cd "$HOME/lte-workstation" || { echo "smoke-test: FAIL (cannot cd)"; exit 1; }
  git remote get-url origin >/dev/null 2>&1 || { echo "smoke-test: FAIL (no origin remote)"; exit 1; }
  # Check both critical mirrors are configured
  git remote get-url ideapad >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ideapad remote — run: git remote add ideapad \$HOME/genome-mirror.git)"; exit 1; }
  git remote get-url phaedra >/dev/null 2>&1 || { echo "smoke-test: FAIL (no phaedra remote)"; exit 1; }
  [ -d "$(git remote get-url ideapad 2>/dev/null)" ] || { echo "smoke-test: FAIL (ideapad bare mirror missing — run: git init --bare \$(git remote get-url ideapad))"; exit 1; }
  git fetch --quiet origin 2>/dev/null || { echo "smoke-test: FAIL (origin unreachable)"; exit 1; }
  git rev-parse --verify --quiet origin/main >/dev/null 2>&1 || { echo "smoke-test: FAIL (no origin/main ref)"; exit 1; }
  echo "smoke-test: ok"; exit 0;
}
export PATH="$HOME/.local/bin:$PATH"
LOG="$HOME/.mesh/genome-sync.log"; BACKOFF="$HOME/.mesh/.genome-sync-alert"; mkdir -p "$HOME/.mesh"
ts(){ date -u +%FT%TZ; }
cd "$HOME/lte-workstation" || exit 1
# Mirror tracks origin/main (GitHub = source of truth), NOT this node's LOCAL main. A working repo's
# local main can hold un-pushed or rebased-away commits, and pushing THAT forks the mirror permanently
# (2026-06-12: mirror diverged 27 commits with non-origin commits → push rejected forever). `fetch`
# (not pull) refreshes the origin/main ref WITHOUT touching the working tree/local main — so a diverged
# local can't block the sync. Then force-push origin/main to the mirror: the mirror is a pure backup
# written ONLY by this tool, so force is safe + SELF-HEALING (re-seeds a forked mirror automatically).
git fetch --quiet origin main 2>/dev/null
ref=$(git rev-parse --verify --quiet origin/main) || { echo "$(ts) FAIL no origin/main ref" >> "$LOG"; exit 1; }
# Push to ALL mirrors; succeed if EITHER ideapad OR phaedra lands (ANTI-SPOF2).
# ideapad is local fs → by definition always reachable → at least one mirror always lands.
ok=0; ds_ok=0; pha_ok=0
timeout 10 git push --quiet --force ideapad "origin/main:refs/heads/main" 2>/dev/null && ok=1 || true
timeout 15 git push --quiet --force mesh    "origin/main:refs/heads/main" 2>/dev/null && ds_ok=1 || true
timeout 15 git push --quiet --force phaedra "origin/main:refs/heads/main" 2>/dev/null && pha_ok=1 || true

if [ "$ok" = 0 ]; then
  echo "$(ts) FAIL push to EVERY mirror (ideapad=${ok} mesh=${ds_ok} phaedra=${pha_ok})" >> "$LOG"
  now=$(date +%s); last=$(cat "$BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 21600 ]; then
    echo "$now" > "$BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "⚠️ genome-sync: ALL mirrors FAILED — check disk + default-string + phaedra (${ref:0:7})" >/dev/null 2>&1 || true
  fi
  exit 1
fi

echo "$(ts) OK ${ref:0:7} (origin/main) -> ideapad=${ok} mesh=${ds_ok} phaedra=${pha_ok}" >> "$LOG"
rm -f "$BACKOFF"
exit 0
