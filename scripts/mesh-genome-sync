#!/usr/bin/env bash
# mesh-genome-sync — keep the genome alive off GitHub: an ANCHOR mirror on the node that runs
# this, plus best-effort bare mirrors on peer nodes.
#
#   anchor  ($MESH_GENOME_MIRROR, default $HOME/genome-mirror.git) — local fs on THIS node,
#           auto-created, air-gap-proof. This is the leg that cannot fail by design.
#   mesh / phaedra / ideapad — peer bare mirrors, best-effort, skipped when unreachable.
#
# The anchor is bound to the NODE THAT RUNS IT, never to a peer's name. The old version's
# "always lands, cannot fail by design" leg was the remote literally named `ideapad` — its
# local-fs property held only while the minds lived on IdeaPad. They moved to mesh-home
# 2026-07-14 and the leg became a push to /home/imozerov/genome-mirror.git, a path that does
# not exist here, so the tool could only FAIL on this node. Same family as the TG_HOST
# predicate that aged out. A backup is worthless if it is 8 days stale WHEN the emergency
# arrives: currency must precede the emergency, so this carries a cadence, not `reflex: emergency`.
#
# reflex-cadence: 7,37 * * * *
set -uo pipefail

ts(){ date -u +%FT%TZ; }

# Land $2 (a sha) in the bare repo at $1, creating it if absent. Returns 0 ONLY if the mirror's
# refs/heads/main actually EQUALS $2 afterwards — a push that exits 0 without moving the ref is
# the exact fiction this tool exists to prevent, so the artifact is asserted, not the exit code.
mirror_land(){
  local mirror="$1" ref="$2" landed
  # An empty ref makes the push below `:refs/heads/main` — a DELETE, which exits 0 and leaves
  # landed="" == ref="", so the tool would wipe the backup and report it landed.
  [ -n "$ref" ] || return 1
  [ -d "$mirror" ] || git init --quiet --bare "$mirror" 2>/dev/null || return 1
  git push --quiet --force "$mirror" "${ref}:refs/heads/main" 2>/dev/null || return 1
  landed=$(git --git-dir="$mirror" rev-parse --verify --quiet refs/heads/main 2>/dev/null) || return 1
  [ "$landed" = "$ref" ]
}

# Same for a peer remote, verified by ls-remote. rc 0 = landed · 1 = failed · 2 = unreachable
# (honest n/a — an offline peer is not a fault of ours and must not read as a failed mirror).
peer_land(){
  local peer="$1" ref="$2" landed
  [ -n "$ref" ] || return 1   # see mirror_land: an empty ref deletes the peer's main
  timeout 5 git ls-remote --quiet "$peer" HEAD >/dev/null 2>&1 || return 2
  timeout 20 git push --quiet --force "$peer" "${ref}:refs/heads/main" 2>/dev/null || return 1
  landed=$(timeout 10 git ls-remote "$peer" refs/heads/main 2>/dev/null | awk '{print $1}')
  [ "$landed" = "$ref" ]
}

# ---------------------------------------------------------------------------
# THE LEAF LANE — a leaf MIRRORS the genome down instead of pushing it out.
#
# This leg carried the exact disease the header above describes curing in the ANCHOR leg, and was
# missed when that one was fixed (fb85906b, 2026-07-15): it fetched the remote literally named
# `ideapad` and force-moved refs/heads/main onto it. The minds left IdeaPad 2026-07-14 and its
# main froze at 4518612 that same day, so phaedra's main was rewound to a July commit every 30
# minutes for 44 days while this logged `OK` every single time (measured 2026-08-27: HEAD 44d
# old, 1717 behind origin, 1129 files reading as uncommitted — which were never local work at
# all, only the delta between a July HEAD and a current worktree, because update-ref moves the
# BRANCH and never touches the tree). A rewind that reports OK is the plausible-constant failure.
#
# Two teeth, because re-aiming at `origin` alone would still leave a blind force-move:
#   * FAST-FORWARD ONLY — a leaf adopts an upstream only when its own main is an ANCESTOR of the
#     incoming ref. A rewind is the signature of a frozen or rogue upstream, and refusing it is
#     what makes such a peer LOUD instead of authoritative. This tooth alone ends the 44-day loop
#     even if the upstream list is never re-aimed.
#   * The adopted ref's AGE rides every OK line, so `OK` can never again mean `frozen`.
# A refused upstream does not abort the lane: the next candidate is tried, so one dead peer can
# never strand a leaf that has a live one.
leaf_sync(){
  local ups="${MESH_GENOME_UPSTREAM:-origin ideapad}" cur ref="" age src="" why="" u loud=""
  cur=$(git rev-parse --verify --quiet refs/heads/main 2>/dev/null || echo "")
  for u in $ups; do
    git remote get-url "$u" >/dev/null 2>&1 || { why="$why $u:no-remote"; continue; }
    timeout 30 git fetch --quiet "$u" main 2>/dev/null || { why="$why $u:unreachable"; continue; }
    ref=$(git rev-parse --verify --quiet "$u/main" 2>/dev/null) || { why="$why $u:no-ref"; ref=""; continue; }
    # `cur` empty = unborn branch on a fresh leaf: there is nothing to rewind, so adoption is safe.
    if [ -n "$cur" ] && [ "$cur" != "$ref" ] \
       && ! git merge-base --is-ancestor "$cur" "$ref" 2>/dev/null; then
      why="$why $u:REWIND-REFUSED(${ref:0:7}~lacks~${cur:0:7})"; ref=""; continue
    fi
    src="$u"; break
  done
  { [ -n "$src" ] && [ -n "$ref" ]; } || {
    echo "$(ts) FAIL leaf: no upstream offered a fast-forward —$why" >> "$LOG"; return 1; }
  git update-ref refs/heads/main "$ref" 2>/dev/null || {
    echo "$(ts) FAIL leaf update-ref main" >> "$LOG"; return 1; }
  age=$(( ( $(date -u +%s) - $(git log -1 --format=%ct "$ref" 2>/dev/null || echo 0) ) / 86400 ))
  [ "$age" -gt "${MESH_GENOME_LEAF_MAX_AGE_D:-7}" ] \
    && loud=" STALE-UPSTREAM(${age}d — $src/main is not moving)"
  echo "$(ts) OK ${ref:0:7} ($src/main, ${age}d old) -> leaf${loud}${why}" >> "$LOG"
  [ -n "$loud" ] && command -v mesh-trace >/dev/null 2>&1 \
    && mesh-trace "genome-sync leaf: $src/main is ${age}d old — upstream frozen?" >/dev/null 2>&1
  return 0
}

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  t=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$t"' EXIT
  ( cd -- "${t:?empty path — refusing to cd into $PWD (fixture would write into the live repo)}" && git init --quiet src && cd src \
      && git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m one \
  ) || { echo "smoke-test: FAIL (cannot build fixture)"; exit 1; }
  cd "$t/src" || { echo "smoke-test: FAIL (cannot cd fixture)"; exit 1; }
  sha=$(git rev-parse HEAD)

  # 1. the REAL path, no network: an ABSENT anchor is created and the ref LANDS in it
  mirror_land "$t/anchor.git" "$sha" || { echo "smoke-test: FAIL (anchor push did not land)"; exit 1; }
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha" ] || { echo "smoke-test: FAIL (mirror ref ${got:-none} != $sha)"; exit 1; }

  # 2. it MOVES on a second commit. A mirror that lands once and then sticks IS the staleness
  #    this tool exists to prevent, and a create-only assertion cannot tell the two apart.
  git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m two
  sha2=$(git rev-parse HEAD)
  mirror_land "$t/anchor.git" "$sha2" || { echo "smoke-test: FAIL (second push did not land)"; exit 1; }
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha2" ] || { echo "smoke-test: FAIL (mirror stuck at ${got:-none}, expected $sha2)"; exit 1; }

  # 3. the NEGATIVE: an anchor that cannot be written must FAIL, never report a landing —
  #    the bug being fixed was a success predicate that could not tell those apart.
  if mirror_land "/proc/nonexistent/anchor.git" "$sha2" 2>/dev/null; then
    echo "smoke-test: FAIL (unwritable anchor reported OK — the success predicate is fiction)"; exit 1
  fi

  # 4. an EMPTY ref must not touch the mirror. Unguarded, the push degrades to `:refs/heads/main`
  #    — a delete that exits 0 — and the landed==ref check passes on ""=="" : OK while the backup
  #    is GONE. The mirror must still hold sha2 and the call must report failure.
  if mirror_land "$t/anchor.git" "" 2>/dev/null; then
    echo "smoke-test: FAIL (empty ref reported as landed)"; exit 1
  fi
  got=$(git --git-dir="$t/anchor.git" rev-parse --verify --quiet refs/heads/main 2>/dev/null)
  [ "$got" = "$sha2" ] || { echo "smoke-test: FAIL (empty ref DESTROYED the mirror: main is now '${got:-deleted}')"; exit 1; }

  # 5. THE LEAF LANE, driven against REAL repos. The 44-day bug was an upstream frozen in the
  #    past force-moving main BACKWARDS every run while logging OK, so the arm that matters is
  #    the REFUSAL. Fixture: base -> ahead -> newer, with `stale` parked at base and `fresh` at
  #    newer, so a refusal and a fall-through can be told apart by an actual ref MOVE.
  #    mutant: drop the `merge-base --is-ancestor` guard -> (5b) goes green with main rewound to
  #    base, which is exactly the production failure this lane shipped for 44 days.
  LOG="$t/leaf.log"; : > "$LOG"
  git init --quiet --bare "$t/up-stale.git"; git init --quiet --bare "$t/up-fresh.git"
  git init --quiet "$t/leaf"
  cd "$t/leaf" || { echo "smoke-test: FAIL (cannot cd leaf fixture)"; exit 1; }
  git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m base
  lbase=$(git rev-parse HEAD)
  git push --quiet "$t/up-stale.git" "HEAD:refs/heads/main" 2>/dev/null
  git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m ahead
  lahead=$(git rev-parse HEAD)
  git -c user.email=t@t -c user.name=t commit --quiet --allow-empty -m newer
  lnewer=$(git rev-parse HEAD)
  git push --quiet "$t/up-fresh.git" "HEAD:refs/heads/main" 2>/dev/null
  git remote add stale "$t/up-stale.git"; git remote add fresh "$t/up-fresh.git"
  git checkout --quiet -B main "$lbase" 2>/dev/null
  [ "$(git rev-parse refs/heads/main)" = "$lbase" ] || { echo "smoke-test: FAIL (leaf fixture did not park main at base)"; exit 1; }

  # 5a. an upstream that CONTAINS our main is a fast-forward and IS adopted.
  MESH_GENOME_UPSTREAM="fresh" leaf_sync || { echo "smoke-test: FAIL (leaf refused a legitimate fast-forward)"; exit 1; }
  [ "$(git rev-parse refs/heads/main)" = "$lnewer" ] || { echo "smoke-test: FAIL (leaf did not adopt the ahead ref)"; exit 1; }
  grep -q 'OK .* (fresh/main' "$LOG" || { echo "smoke-test: FAIL (leaf adopted but did not name the upstream it used)"; exit 1; }

  # 5b. THE PRODUCTION BUG: main is now `newer`; the stale upstream still points at `base`, which
  #     does NOT contain it. That is a REWIND and it must be refused, loudly, with main untouched.
  : > "$LOG"
  MESH_GENOME_UPSTREAM="stale" leaf_sync && { echo "smoke-test: FAIL (leaf accepted a REWIND to a frozen upstream — the 44-day bug)"; exit 1; }
  [ "$(git rev-parse refs/heads/main)" = "$lnewer" ] || { echo "smoke-test: FAIL (a refused upstream still MOVED main to $(git rev-parse --short refs/heads/main))"; exit 1; }
  grep -q 'REWIND-REFUSED' "$LOG" || { echo "smoke-test: FAIL (rewind refused but the log does not say why: $(cat "$LOG"))"; exit 1; }

  # 5c. a refused candidate must not strand the lane: the NEXT upstream is still tried. Without
  #     this the two teeth would fight — one dead peer would leave a leaf with a live one unsynced.
  #     main sits at `ahead`, so `stale` is a genuine rewind and `fresh` is a genuine move.
  : > "$LOG"; git update-ref refs/heads/main "$lahead"
  MESH_GENOME_UPSTREAM="stale fresh" leaf_sync || { echo "smoke-test: FAIL (a refusable first upstream stranded the lane)"; exit 1; }
  [ "$(git rev-parse refs/heads/main)" = "$lnewer" ] || { echo "smoke-test: FAIL (did not fall through past the refused upstream to the live one)"; exit 1; }
  grep -q 'REWIND-REFUSED' "$LOG" || { echo "smoke-test: FAIL (fell through but never recorded WHY the first upstream was skipped)"; exit 1; }

  # 5d. AGE rides the OK line, so a frozen-but-fast-forward upstream cannot wear a bare OK.
  grep -qE 'OK [0-9a-f]+ \(fresh/main, [0-9]+d old\)' "$LOG" || { echo "smoke-test: FAIL (OK line carries no upstream age: $(cat "$LOG"))"; exit 1; }

  # 5e. an upstream that is merely UNREACHABLE is not a rewind and must not be reported as one.
  : > "$LOG"; git remote add dead "$t/does-not-exist.git"
  MESH_GENOME_UPSTREAM="dead fresh" leaf_sync || { echo "smoke-test: FAIL (an unreachable first upstream stranded the lane)"; exit 1; }
  grep -q 'dead:unreachable' "$LOG" || { echo "smoke-test: FAIL (unreachable upstream not named as such: $(cat "$LOG"))"; exit 1; }
  grep -q 'dead:REWIND' "$LOG" && { echo "smoke-test: FAIL (an unreachable upstream was branded a REWIND)"; exit 1; }
  cd "$t/src" || { echo "smoke-test: FAIL (cannot return to fixture)"; exit 1; }

  echo "smoke-test: ok (anchor creates+lands, moves on a new commit, fails honestly when unwritable, empty ref cannot wipe it; leaf fast-forwards, REFUSES a rewind to a frozen upstream, falls through to a live one, and publishes the upstream age)"
  exit 0
fi

export PATH="$HOME/.local/bin:$PATH"
LOG="$HOME/.mesh/genome-sync.log"; BACKOFF="$HOME/.mesh/.genome-sync-alert"; mkdir -p "$HOME/.mesh"
cd "$HOME/lte-workstation" || exit 1
hostname=$(hostname 2>/dev/null || echo "")

# A leaf pulls the genome DOWN rather than pushing it out. Bind that role to a DECLARATION, not
# to a name that ages out (CLAUDE.md); the old `hostname = phaedra` test survives only as a compat
# fallback so an undeclared leaf keeps working. See leaf_sync() for the two teeth it carries.
GENOME_ROLE="${MESH_GENOME_ROLE:-}"
[ -z "$GENOME_ROLE" ] && [ "$hostname" = "phaedra" ] && GENOME_ROLE=leaf
if [ "$GENOME_ROLE" = leaf ]; then
  leaf_sync || exit 1
  rm -f "$BACKOFF"
  exit 0
fi

# A failed fetch leaves origin/main at its last-known value; mirroring that is still worth doing,
# but it is a STALE ref and the log must say so rather than call it current.
src="origin/main"
git fetch --quiet origin main 2>/dev/null || src="origin/main(stale — fetch failed)"
ref=$(git rev-parse --verify --quiet origin/main) || { echo "$(ts) FAIL no origin/main ref" >> "$LOG"; exit 1; }

ANCHOR="${MESH_GENOME_MIRROR:-$HOME/genome-mirror.git}"
mirror_land "$ANCHOR" "$ref" && anchor="ok" || anchor="FAIL"

# Explicit peer list, never "every remote": `ilya` is a live working checkout, not a bare mirror,
# and force-pushing main into someone's working repo is hostile.
peers=""
for p in mesh phaedra ideapad; do
  git remote get-url "$p" >/dev/null 2>&1 || continue
  [ "$(git remote get-url "$p")" = "$ANCHOR" ] && continue   # the anchor already landed above
  peer_land "$p" "$ref"; rc=$?
  case $rc in
    0) peers="$peers $p=ok" ;;
    2) peers="$peers $p=unreachable" ;;
    *) peers="$peers $p=fail" ;;
  esac
done

if [ "$anchor" != "ok" ]; then
  echo "$(ts) FAIL anchor $ANCHOR did not land ${ref:0:7} (peers:${peers:- none})" >> "$LOG"
  now=$(date +%s); last=$(cat "$BACKOFF" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 21600 ]; then
    echo "$now" > "$BACKOFF"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "⚠️ genome-sync: anchor mirror $ANCHOR FAILED — check disk + fs (${ref:0:7})" >/dev/null 2>&1 || true
  fi
  exit 1
fi

echo "$(ts) OK ${ref:0:7} ($src) -> anchor=ok${peers:+ peers:$peers}" >> "$LOG"
rm -f "$BACKOFF"
exit 0
