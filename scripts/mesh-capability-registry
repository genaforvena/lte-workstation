#!/usr/bin/env bash
# mesh-capability-registry — typed capability STATE registry.
# orphan-ok: on-demand registry/sense queried by mesh-card/capability consumers — never scheduled.
# Separates declared/reachable/wired/verified/stale/unknown; a declaration never renders as verified.
# Row (TSV): name | node | state | artifact | freshness_ts | coverage | owner | retry_edge | source
# States: declared (only claimed) · reachable (transport proven, no artifact) · wired (consumer wired,
#   artifact not freshly verified) · verified (live artifact asserted within TTL) · stale (artifact
#   older than TTL or missing) · unknown (cannot decide: no artifact AND no transport evidence).
# Mutation rule: missing artifact -> unknown (if never verified) or stale (if previously verified);
#   verified requires artifact EXISTS + non-empty + newer than TTL. Consumers must read state, never
#   the name alone.
# Verbs: register ... | refresh [--ttl-hours N] | show [--state S] | get <name> | --test | --sample
# Registry: ${MESH_CAPABILITY_REGISTRY:-$HOME/.mesh/capability-registry.tsv}
# launches: (none — sense/registry only, never actuates)
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
REG="${MESH_CAPABILITY_REGISTRY:-$MESH/capability-registry.tsv}"
TTL_H="${MESH_CAPABILITY_TTL_HOURS:-168}"  # 7d default freshness window

usage() { echo "usage: mesh-capability-registry register --name N --node ND --state S [--artifact P] [--coverage C] [--owner O] [--retry R] [--source S] | refresh [--ttl-hours N] | show [--state S] | get <name> | --sample | --test" >&2; exit 64; }

case ":$PATH:" in *":$HOME/.local/bin:"*) : ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac

valid_state() { case "$1" in declared|reachable|wired|verified|stale|unknown) return 0;; *) return 1;; esac; }

artifact_fresh() { # path ttl_hours -> 0 fresh, 1 stale/missing
  local p="$1" ttl="${2:-$TTL_H}"; [ -n "$p" ] && [ -f "$p" ] && [ -s "$p" ] || return 1
  local m now; m=$(stat -c %Y "$p" 2>/dev/null) || return 1; now=$(date +%s)
  [ $(( now - m )) -le $(( ttl * 3600 )) ]
}

# Gate: compute honest state from claimed state + artifact evidence.
# verified claimed but artifact missing/empty/stale -> stale (was verified before) or unknown.
gate_state() { # claimed artifact prior_state ttl -> effective state
  local claimed="$1" art="$2" prior="$3" ttl="${4:-$TTL_H}"
  if [ "$claimed" = verified ]; then
    artifact_fresh "$art" "$ttl" && { echo verified; return; }
    case "$prior" in verified|stale|wired) echo stale;; *) echo unknown;; esac
    return
  fi
  echo "$claimed"
}

if [ "${1:-}" = --test ]; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  export MESH_CAPABILITY_REGISTRY="$tmp/reg.tsv" REG="$tmp/reg.tsv" MESH_CAPABILITY_TTL_HOURS=1 TTL_H=1
  pass=0; fail=0
  ok() { pass=$((pass+1)); }; no() { echo "FAIL: $1"; fail=$((fail+1)); }
  # 1. register declared without artifact -> declared (never verified)
  "$0" register --name cap.a --node n1 --state declared --owner genome --retry "retry-x" --source census >/dev/null
  [ "$("$0" get cap.a | cut -f3)" = declared ] && ok || no "declared without artifact should stay declared"
  # 2. claim verified with missing artifact -> unknown (never verified before)
  "$0" register --name cap.b --node n1 --state verified --artifact "$tmp/nope.bin" --owner genome --retry r --source census >/dev/null
  [ "$("$0" get cap.b | cut -f3)" = unknown ] && ok || no "verified+missing artifact must be unknown, got $("$0" get cap.b | cut -f3)"
  # 3. fresh artifact + verified claim -> verified
  echo data >"$tmp/good.bin"
  "$0" register --name cap.c --node n1 --state verified --artifact "$tmp/good.bin" --owner genome --retry r --source census >/dev/null
  [ "$("$0" get cap.c | cut -f3)" = verified ] && ok || no "verified+fresh artifact must be verified"
  # 4. stale artifact (mtime old) -> stale on refresh
  echo data >"$tmp/old.bin"; touch -d "5 hours ago" "$tmp/old.bin"
  # 5h-old file with TTL=1h is stale at register time; never-verified -> unknown, or stale
  "$0" register --name cap.d --node n1 --state verified --artifact "$tmp/old.bin" --owner genome --retry r --source census >/dev/null
  st="$("$0" get cap.d | cut -f3)"
  { [ "$st" = stale ] || [ "$st" = unknown ]; } && ok || no "stale artifact must not verify, got $st"
  # 5. empty artifact -> not verified
  : >"$tmp/empty.bin"
  "$0" register --name cap.e --node n1 --state verified --artifact "$tmp/empty.bin" --owner genome --retry r --source census >/dev/null
  [ "$("$0" get cap.e | cut -f3)" != verified ] && ok || no "empty artifact must not verify"
  # 6. refresh demotes expired verified -> stale
  echo data >"$tmp/age.bin"
  "$0" register --name cap.f --node n1 --state verified --artifact "$tmp/age.bin" --owner genome --retry r --source census >/dev/null
  touch -d "5 hours ago" "$tmp/age.bin"
  "$0" refresh --ttl-hours 1 >/dev/null
  [ "$("$0" get cap.f | cut -f3)" = stale ] && ok || no "refresh must demote expired verified to stale"
  # 7. declaration never renders as verified in show
  "$0" show --state verified | grep -q "cap.a" && no "declared row leaked into verified view" || ok
  # 8. invalid state rejected
  "$0" register --name cap.g --node n1 --state bogus 2>/dev/null && no "bogus state accepted" || ok
  echo "smoke-test: $pass passed, $fail failed"
  [ "$fail" -eq 0 ]
  exit $?
fi

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  register)
    name=""; node=""; state=""; artifact=""; coverage="na"; owner=""; retry=""; source=""
    while [ $# -gt 0 ]; do case "$1" in
      --name) name="${2:-}"; shift 2;; --node) node="${2:-}"; shift 2;;
      --state) state="${2:-}"; shift 2;; --artifact) artifact="${2:-}"; shift 2;;
      --coverage) coverage="${2:-}"; shift 2;; --owner) owner="${2:-}"; shift 2;;
      --retry) retry="${2:-}"; shift 2;; --source) source="${2:-}"; shift 2;;
      *) echo "register: unknown arg $1" >&2; exit 64;;
    esac; done
    [ -n "$name" ] && [ -n "$node" ] && valid_state "$state" || { echo "register: need --name --node --state(valid)" >&2; exit 64; }
    [ -n "$owner" ] || { echo "register: need --owner" >&2; exit 64; }
    mkdir -p "$(dirname "$REG")"; touch "$REG"
    prior="$(awk -F'\t' -v n="$name" '$1==n{print $3}' "$REG" | tail -1)"
    [ -z "$prior" ] && prior="none"
    eff="$(gate_state "$state" "$artifact" "$prior" "$TTL_H")"
    # replace existing row for name (keep registry one-row-per-capability)
    grep -v -P "^\Q$name\E\t" "$REG" >"$REG.tmp" 2>/dev/null || grep -v "^$name	" "$REG" >"$REG.tmp" || true
    mv "$REG.tmp" "$REG"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$node" "$eff" "$artifact" \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$coverage" "$owner" "$retry" "$source" >>"$REG"
    [ "$eff" != "$state" ] && echo "gate: claimed $state -> $eff (artifact evidence)" >&2
    printf '%s\t%s\t%s\n' "$name" "$node" "$eff"
    ;;
  refresh)
    ttl="$TTL_H"; [ "${1:-}" = --ttl-hours ] && ttl="${2:-$TTL_H}"
    [ -f "$REG" ] || { echo "(no registry yet: $REG)"; exit 0; }
    tmp="$REG.refresh.$$"; : >"$tmp"
    while IFS=$'\t' read -r name node state art fresh cov owner retry source; do
      [ -z "$name" ] && continue
      case "$state" in verified|stale|wired)
        if artifact_fresh "$art" "$ttl"; then new="$state"; [ "$state" = stale ] && new=wired
        else new=stale; fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$node" "$new" "$art" "$fresh" "$cov" "$owner" "$retry" "$source" >>"$tmp"
        [ "$new" != "$state" ] && echo "refresh: $name $state -> $new"
        ;;
      *) printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$node" "$state" "$art" "$fresh" "$cov" "$owner" "$retry" "$source" >>"$tmp";;
      esac
    done <"$REG"; mv "$tmp" "$REG"
    ;;
  show)
    [ -f "$REG" ] || { echo "(no registry yet)"; exit 0; }
    if [ "${1:-}" = --state ]; then s="${2:-}"; valid_state "$s" || exit 64
      awk -F'\t' -v s="$s" '$3==s' "$REG"
    else cat "$REG"; fi
    ;;
  get) awk -F'\t' -v n="${1:-}" '$1==n' "$REG";;
  --sample)
    # Live refreshed sample seeded from the 2026-09-16 census (evidence-backed, honest states).
    # Runs in a TEMP registry (never touches the live one): demonstrates a declared-only row,
    # a verified claim WITH a fresh artifact, and a verified claim with a missing artifact
    # (gated to unknown) — a declaration never renders as verified.
    stmp="$(mktemp -d)"; trap 'rm -rf "$stmp"' EXIT
    echo proof-artifact >"$stmp/note3-camera-proof.bin"
    MESH_CAPABILITY_REGISTRY="$stmp/reg.tsv" "$0" register --name note3.camera --node note3 \
      --state verified --artifact "$stmp/note3-camera-proof.bin" --owner senses \
      --retry "adb shell dumpsys sensorservice" --source mesh-capability-census-20260916
    MESH_CAPABILITY_REGISTRY="$stmp/reg.tsv" "$0" register --name note3.consumer-ir --node note3 \
      --state declared --owner senses --retry "safe frame-emission artifact on adb path" \
      --source mesh-capability-census-20260916 >/dev/null
    MESH_CAPABILITY_REGISTRY="$stmp/reg.tsv" "$0" register --name imac.say --node imac-rozalia \
      --state verified --artifact "$stmp/nope.bin" --owner sound \
      --retry "ssh ilya@100.121.88.110 '/usr/bin/say -v ?'" --source mesh-capability-census-20260916 >/dev/null
    echo "# sample (temp registry): gated states — declaration never renders as verified"
    MESH_CAPABILITY_REGISTRY="$stmp/reg.tsv" "$0" show
    ;;
  *) usage;;
esac
