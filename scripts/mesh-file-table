#!/usr/bin/env bash
# orphan-ok: on-demand kernel file-table capacity reading; no recurring consumer/cadence.
# mesh-file-table — live counts from /proc/sys/fs/file-nr; reports allocation and kernel limit.
set -euo pipefail

SOURCE="${MESH_FILE_NR_PATH:-/proc/sys/fs/file-nr}"

read_values() {
  local path="$1" line allocated unused maximum extra
  line="$(cat -- "$path" 2>/dev/null)" || return 2
  read -r allocated unused maximum extra <<<"$line" || return 2
  [[ -z "${extra:-}" && "$allocated" =~ ^[0-9]+$ && "$unused" =~ ^[0-9]+$ && "$maximum" =~ ^[0-9]+$ ]] || return 2
  (( maximum > 0 && unused <= allocated )) || return 2
  printf '%s\t%s\t%s\n' "$allocated" "$unused" "$maximum"
}

emit() {
  local path="$1" values allocated unused maximum pct
  values="$(read_values "$path")" || {
    printf 'mesh-file-table: UNREACHABLE or malformed source: %s\n' "$path" >&2
    return 2
  }
  IFS=$'\t' read -r allocated unused maximum <<<"$values"
  pct="$(awk -v a="$allocated" -v m="$maximum" 'BEGIN { printf "%.2f", 100*a/m }')"
  if [ "${2:-text}" = json ]; then
    printf '{"source":"%s","allocated":%s,"unused":%s,"maximum":%s,"allocated_pct":%s}\n' \
      "$path" "$allocated" "$unused" "$maximum" "$pct"
  else
    printf 'file_table allocated=%s unused=%s maximum=%s allocated_pct=%s%% source=%s\n' \
      "$allocated" "$unused" "$maximum" "$pct" "$path"
  fi
}

test_tool() {
  local td expected actual live
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' RETURN
  printf '17 3 1000\n' >"$td/valid"
  printf '17 nope 1000\n' >"$td/malformed"
  expected=$'17\t3\t1000'
  actual="$(read_values "$td/valid")" || { echo 'mesh-file-table --test: FAIL (valid fixture rejected)' >&2; return 1; }
  [ "$actual" = "$expected" ] || { echo 'mesh-file-table --test: FAIL (fixture fields changed)' >&2; return 1; }
  if read_values "$td/malformed" >/dev/null 2>&1; then
    echo 'mesh-file-table --test: FAIL (malformed fixture accepted)' >&2; return 1
  fi
  live="$(read_values "$SOURCE")" || { echo "mesh-file-table --test: UNREACHABLE — cannot read live $SOURCE" >&2; return 2; }
  IFS=$'\t' read -r allocated unused maximum <<<"$live"
  printf 'mesh-file-table --test: PASS (fixture parse + live /proc/sys/fs/file-nr read: allocated=%s unused=%s maximum=%s)\n' \
    "$allocated" "$unused" "$maximum"
}

case "${1:-}" in
  --test) test_tool ;;
  --json) emit "$SOURCE" json ;;
  --help|-h) echo 'Usage: mesh-file-table [--json|--test]';;
  '') emit "$SOURCE" text ;;
  *) echo 'Usage: mesh-file-table [--json|--test]' >&2; exit 2 ;;
esac
