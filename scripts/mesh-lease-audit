#!/usr/bin/env bash
# mesh-lease-audit — deploy shim for the uxn lease-vs-cadence ROM auditor (uxn-lease-audit-wire,
# spec docs/superpowers/specs/2026-07-23-uxn-predicate-engine-design.md §3.1).
#
# The real tool lives WITH its ROMs and per-node toolchain at scripts/uxn/mesh-lease-audit (not
# sync-tools-deployed — its $here-relative ROM/uxncli/test resolution needs the genome dir). This
# thin exec makes it PATH-visible and autowirable: the never-wired-reflex rule (cc617e5) — the
# audit existed for days with a documented cadence intent and NO cron line, exactly the hole this
# closes. Cadence daily: it is a REGRESSION guard over genome headers + the reflex-health table
# (its honest zero moves only when a human edits one of those), not a liveness probe.
# reflex-cadence: 41 5 * * * (daily)
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-lease-audit"
[ -x "$TARGET" ] || { echo "mesh-lease-audit: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
