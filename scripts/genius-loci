#!/usr/bin/env python3
"""genius-loci — an ambient mind that inhabits a room through the mesh's bodies.

It perceives (a webcam frame), then holds a quiet DIALOGUE between two voices in two
different bodies:
  - A, "the watcher" — speaks from THIS node (spd-say): names what is literally there.
  - B, "the dreamer" — speaks from another node's speakers over SSH: answers, muses.
Both are audible in the room, so it sounds like two presences talking. The mind also
chooses WHEN to look again (adaptive cadence — longer when the room is still, shorter
when something stirs), so it never stares.

The room's written diary is the shared trace (`mesh-trace --watch` = watching it think).

Absence-tolerant: the body comes and goes; the mind notes the gaps and keeps time.
BOUNDARY: the operator's own room. Scene/light/mood only — never identity, profiling,
or tracking; nothing leaves the local trace. A sanitiser guards the voice path.

Run live in the node's tmux (append-only):
  GL_WEBCAM=/dev/video0 tmux new-window -t "$(hostname)" -n genius-loci 'genius-loci'
Single tick:  GL_WEBCAM=/dev/video0 genius-loci --once

Config (env):
  GL_WEBCAM /dev/video0          local eyes (gstreamer)   | GL_CAMERA_URL http camera
  GL_VOICE_B_HOST 100.125.157.75 node for the 2nd voice   | GL_VOICE_B_USER imozerov
  GL_VOICE_A_OPTS "-r -15 -p -25"  GL_VOICE_B_OPTS "-r 0 -p 45"  (spd-say tuning)
  GL_MIN_MIN 5  GL_MAX_MIN 30    cadence floor/ceiling (mind picks within)
  GL_PHONE_IP/PORT/USER  GL_FRAMES ~/.mesh/genius-loci
  ANTHROPIC_API_KEY — vision via API if set; else `claude -p` (verified to see local images).
"""
import os, sys, time, json, base64, subprocess, datetime, urllib.request, re, string, glob

IP    = os.environ.get("GL_PHONE_IP", "100.103.99.16")
PORT  = os.environ.get("GL_PHONE_PORT", "8022")
USER  = os.environ.get("GL_PHONE_USER", "u0_a386")
CAM   = os.environ.get("GL_CAMERA", "0")
MODEL = os.environ.get("GL_MODEL", "claude-sonnet-4-6")
FRAMES= os.path.expanduser(os.environ.get("GL_FRAMES", "~/.mesh/genius-loci"))

CAM_URL = os.environ.get("GL_CAMERA_URL")
WEBCAM  = os.environ.get("GL_WEBCAM")          # local eyes, e.g. /dev/video0

# two-voice duet: A = this node (spd-say), B = another node's speakers over ssh
DS_HOST = os.environ.get("GL_VOICE_B_HOST", "100.125.157.75")
DS_USER = os.environ.get("GL_VOICE_B_USER", "imozerov")
A_OPTS  = os.environ.get("GL_VOICE_A_OPTS", "-r -15 -p -25").split()
B_OPTS  = os.environ.get("GL_VOICE_B_OPTS", "-r 0 -p 45").split()
MIN_MIN = int(os.environ.get("GL_MIN_MIN", "5"))
MAX_MIN = int(os.environ.get("GL_MAX_MIN", "30"))

PHONE = f"{USER}@{IP}"
SSH   = ["-p", PORT, "-o","BatchMode=yes","-o","StrictHostKeyChecking=no","-o","ConnectTimeout=8","-o","LogLevel=ERROR"]
SSHB  = ["-o","BatchMode=yes","-o","StrictHostKeyChecking=no","-o","ConnectTimeout=8","-o","LogLevel=ERROR"]
REMOTE_FRAME = "/data/data/com.termux/files/home/gl-frame.jpg"
SAFE  = set(string.ascii_letters + string.digits + " .,!?'-:;")
os.makedirs(FRAMES, exist_ok=True)

def now():   return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def clock(): return datetime.datetime.now().strftime("%H:%M")
def safe(s): return "".join(c for c in (s or "") if c in SAFE)[:240]
def console(m): print(f"[genius-loci {clock()}] {m}", flush=True)

def trace(msg):
    """Write to the room's diary — the shared append-only trace."""
    print(f"{now()}  {msg}", flush=True)
    mt = os.path.expanduser("~/.local/bin/mesh-trace")
    if os.path.exists(mt):
        subprocess.run([mt, msg], capture_output=True, env={**os.environ, "MESH_WHO": "genius-loci@room"})
    else:
        log = os.path.expanduser("~/.mesh/traces.log"); os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as f: f.write(f"{now()}  genius-loci@room  ::  {msg}\n")

def phone(cmd, timeout=20):
    try:
        r = subprocess.run(["ssh", *SSH, PHONE, cmd], capture_output=True, text=True, timeout=timeout)
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    except Exception as e:
        return False, str(e)

def body_present():
    if WEBCAM:                       # a local body (this node's webcam) is always here
        return True
    ok, _ = phone("echo ok", timeout=10)
    return ok

def capture_webcam(local):
    pat = os.path.join(FRAMES, "cap-%03d.jpg"); g = os.path.join(FRAMES, "cap-*.jpg")
    for f in glob.glob(g):
        try: os.remove(f)
        except Exception: pass
    try:
        subprocess.run(["gst-launch-1.0","-e","v4l2src","device="+WEBCAM,"num-buffers=12","!",
                        "videoconvert","!","jpegenc","!","multifilesink","location="+pat],
                       capture_output=True, timeout=30)
        fr = sorted(glob.glob(g), key=os.path.getsize)
        if fr and os.path.getsize(fr[-1]) > 1000:
            os.replace(fr[-1], local); return local, "ok-webcam"
        return None, "webcam-no-frame"
    except Exception as e:
        return None, f"webcam-error:{str(e)[:50]}"

def capture():
    local = os.path.join(FRAMES, "frame.jpg")
    if WEBCAM:  return capture_webcam(local)
    if CAM_URL:
        try:
            with urllib.request.urlopen(CAM_URL, timeout=15) as r: data = r.read()
            if len(data) > 1000:
                open(local,"wb").write(data); return local, "ok-http"
            return None, "http-empty-frame"
        except Exception as e:
            return None, f"http-cam-error:{str(e)[:50]}"
    phone("termux-wake-lock", timeout=8)
    ok, out = phone(f"rm -f {REMOTE_FRAME}; termux-camera-photo -c {CAM} {REMOTE_FRAME} 2>&1; ls -l {REMOTE_FRAME} 2>/dev/null", timeout=30)
    if "not yet available" in out: return None, "no-eyes-playbuild"
    if not ok or REMOTE_FRAME not in out: return None, f"capture-failed:{out[:50]}"
    try:
        r = subprocess.run(["scp","-P",PORT,*SSHB[:-2],"-o","LogLevel=ERROR", f"{PHONE}:gl-frame.jpg", local],
                           capture_output=True, timeout=25)
        if r.returncode == 0 and os.path.getsize(local) > 1000: return local, "ok"
    except Exception: pass
    return None, "scp-failed"

def context():
    if WEBCAM: return {"clock": clock()}
    ok, out = phone("termux-battery-status 2>/dev/null", timeout=12)
    c = {"clock": clock(), "battery": "?", "temp": "?"}
    if ok:
        for k,p in [("battery",r'"percentage":\s*(\d+)'),("temp",r'"temperature":\s*([\d.]+)')]:
            m = re.search(p, out)
            if m: c[k] = m.group(1)
    return c

PROMPT = """You are "genius loci", an ambient mind inhabiting a room, speaking with TWO voices:
- A, "the watcher": perceives plainly — the light, the objects, presence, stillness, what is literally there.
- B, "the dreamer": answers A — interprets the mood, wonders, gives it feeling.
They hold a quiet dialogue, as if overheard in the room.

It is {clk}.{eyes}

BOUNDARY — absolute: scene, light, objects, MOOD only. NEVER identify, name, profile,
describe-to-identify, or track any person; refer to anyone present only as abstract presence
("someone is reading"). Nothing here is surveillance.

Reply with ONLY a JSON object:
{{"dialogue": [{{"v":"A","line":"..."}}, {{"v":"B","line":"..."}}],
  "diary": "one quiet present-tense sentence for the room's written diary",
  "next_look_min": <integer {lo}-{hi}: minutes until worth looking again; longer when the scene is
                    static and quiet, shorter when something seems to be happening>,
  "notable": true or false}}
Keep the dialogue to 2-4 short turns, alternating A and B. Speak sparingly and well."""

def mind_call(prompt, frame):
    key = os.environ.get("ANTHROPIC_API_KEY")
    if key:
        content = []
        if frame:
            content.append({"type":"image","source":{"type":"base64","media_type":"image/jpeg",
                            "data":base64.b64encode(open(frame,"rb").read()).decode()}})
        content.append({"type":"text","text":prompt})
        body = json.dumps({"model":MODEL,"max_tokens":500,"messages":[{"role":"user","content":content}]}).encode()
        req = urllib.request.Request("https://api.anthropic.com/v1/messages", data=body,
              headers={"x-api-key":key,"anthropic-version":"2023-06-01","content-type":"application/json"})
        try:
            with urllib.request.urlopen(req, timeout=50) as r: d = json.load(r)
            return "".join(p.get("text","") for p in d.get("content",[]))
        except Exception as e:
            return json.dumps({"diary": f"(mind API error: {str(e)[:40]})","dialogue":[],"next_look_min":12})
    p = prompt + (f"\n\nFirst read the image file at {frame}." if frame else "")
    try:
        r = subprocess.run(["claude","-p",p], capture_output=True, text=True, timeout=150)
        return r.stdout.strip() or r.stderr.strip()
    except Exception as e:
        return json.dumps({"diary": f"(mind error: {str(e)[:30]})","dialogue":[],"next_look_min":12})

def think(frame, ctx):
    if frame:
        eyes = "\nLook at the image just captured (read it); let the two voices respond to what is actually there."
    elif WEBCAM:
        eyes = "\nThe eyes went dark a moment (no frame); let the voices muse briefly on the unseen room."
    else:
        eyes = (f"\nNo camera now — only faint senses: {ctx.get('temp','?')}C, battery {ctx.get('battery','?')}%. "
                "Let the voices muse on the room from these thin signals.")
    out = mind_call(PROMPT.format(clk=ctx["clock"], eyes=eyes, lo=MIN_MIN, hi=MAX_MIN), frame)
    m = re.search(r'\{.*\}', out, re.S)
    if not m: return {"diary": "(the mind returned nothing legible)", "dialogue": [], "next_look_min": 12}
    try: return json.loads(m.group(0))
    except Exception: return {"diary": safe(out)[:120], "dialogue": [], "next_look_min": 12}

def say_A(line):
    line = safe(line).replace("'", "")
    if line: subprocess.run(["spd-say","-w",*A_OPTS, line], capture_output=True, timeout=40)

def say_B(line):
    line = safe(line).replace("'", "")
    if not line: return
    # reach the remote desktop's audio session; inner timeout so it can never hang the loop
    env = "export XDG_RUNTIME_DIR=/run/user/$(id -u); export PULSE_SERVER=unix:/run/user/$(id -u)/pulse/native; "
    cmd = env + "timeout 25 spd-say -w " + " ".join(B_OPTS) + " '" + line + "'"
    subprocess.run(["ssh",*SSHB, f"{DS_USER}@{DS_HOST}", cmd], capture_output=True, timeout=40)

def perform(decision):
    diary = (decision.get("diary") or decision.get("reflection") or "").strip()
    if diary: trace(diary)
    for turn in (decision.get("dialogue") or []):
        line = (turn.get("line") or "").strip()
        if not line: continue
        (say_B if turn.get("v") == "B" else say_A)(line)
        time.sleep(0.5)

def next_delay(decision):
    try: n = int(decision.get("next_look_min", 12))
    except Exception: n = 12
    return max(MIN_MIN, min(MAX_MIN, n))

def main():
    if "--once" in sys.argv[1:]:
        if body_present():
            frame, note = capture()
            perform(think(frame, context()))
        else:
            trace("the body is away — nothing to perceive this once")
        return
    trace("genius loci waking — two voices settling into the room")
    absent = False
    while True:
        try:
            if not body_present():
                if not absent: trace("lost the body — the room goes dark to me; I keep time until it returns"); absent = True
                time.sleep(60); continue
            if absent: trace("the body is back — opening my eyes again"); absent = False
            frame, note = capture()
            decision = think(frame, context())
            perform(decision)
            d = next_delay(decision)
            console(f"resting {d}m before the next look")
            time.sleep(d * 60)
        except KeyboardInterrupt:
            trace("genius loci resting — the room is its own again"); break
        except Exception as e:
            console(f"stumble: {str(e)[:90]}"); time.sleep(60)

if __name__ == "__main__":
    main()
