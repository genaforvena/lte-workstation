#!/usr/bin/env bash
# orphan-ok: on-demand swap-poll — sampled, not continuous (swap usage changes on the minute scale
#   under load; a polled sample is fine and avoids the cost of a continuous monitor)
# mesh-swap — the kernel's MEMORY-SWAP-USAGE sense: a snapshot of /proc/swaps.
#
# The Linux kernel swaps out memory pages to disk when RAM is pressured. Swap usage is a real,
# often-monitored operational signal that's distinct from existing memory tools:
#   mesh-stress   → RSS + loadavg (per-process memory) — the application layer
#   mesh-psi      → /proc/pressure/{cpu,io,memory} (PSI) — kernel wait-stall (partial)
#   mesh-swap      → /proc/swaps total + used + percentage — the PEAK memory fallback
#
# A process can have low RSS but the system can still be swapping (because OTHER processes are
# eating memory). PSI captures the wait-stall; this tool captures the cumulative swap usage
# — the actual amount of memory that's been pushed to disk because RAM was insufficient.
# Three distinct signals of the same underlying problem (memory pressure) at three different
# layers.
#
# Classification (FALSIFIABLE via --test, bands based on used/total percentage):
#   LIGHT     < 25%   — minimal swap activity, plenty of headroom
#   MODERATE  25-50% — system is using swap but not in critical territory
#   HIGH      50-80% — heavy swap pressure, performance impact likely
#   CRITICAL  > 80%  — system is heavily reliant on swap, RAM is insufficient
#   NONE      no swap configured (some systems disable swap)
#   UNKNOWN   /proc unreadable (defensive; never a faked "LIGHT")
#
# Honest-exit contract:
#   0 = verdict produced (LIGHT/MODERATE/HIGH/CRITICAL/NONE)
#   2 = /proc/swaps missing or unreadable — never a fabricated swap count
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
STATE="$HOME/.mesh/.swap-state"

# parse_swap <file> → echoes "used_kb total_kb" or returns 1
# /proc/swaps format (per line): "Filename Type Size Used Priority"
# We parse the headerless table (no "Filename" line in /proc/swaps — that's a sysinfo(2) artifact).
parse_swap() {
  local f="$1" used=0 total=0
  [ -r "$f" ] || return 1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # Skip the header line if present (some kernels include it)
    case "$line" in
      Filename*) continue ;;
    esac
    # awk: extract Size (col 3) and Used (col 4) as integers (in KB)
    local sz ud
    sz="$(printf '%s' "$line" | awk '{print $3}')"
    ud="$(printf '%s' "$line" | awk '{print $4}')"
    [ -n "$sz" ] && [ -n "$ud" ] && [ "$sz" -ge 0 ] 2>/dev/null && [ "$ud" -ge 0 ] 2>/dev/null || continue
    total=$(( total + sz ))
    used=$(( used + ud ))
  done < "$f"
  [ "$total" -gt 0 ] 2>/dev/null || return 1
  printf '%s %s\n' "$used" "$total"
}

# classify_swap <used_kb> <total_kb> → echoes "LABEL|reason"
classify_swap() {
  local used="$1" total="$2"
  # Defensive: non-numeric or zero total → UNKNOWN (we can't compute a percentage).
  # With `set -u`, a non-numeric value in [ "$x" -ge 0 ] would error; guard with 2>/dev/null and
  # a fallback "echo" check below.
  if [ -z "$used" ] || [ -z "$total" ] || [ "$total" -le 0 ] 2>/dev/null; then
    echo "UNKNOWN|non-numeric input (used=$used total=$total)"
    return
  fi
  # Verify both are integers (defensive against non-numeric with set -u)
  if ! printf '%d' "$used" >/dev/null 2>&1 || ! printf '%d' "$total" >/dev/null 2>&1; then
    echo "UNKNOWN|non-numeric input (used=$used total=$total)"
    return
  fi
  if [ "$used" = "0" ]; then
    echo "NONE|0 of ${total}KB swap used — no swapping activity"
    return
  fi
  # Integer percent (used * 100 / total, floored)
  local pct=$(( used * 100 / total ))
  if   [ "$pct" -lt 25 ];  then echo "LIGHT|${pct}% of ${total}KB swap (${used}KB used)"; return; fi
  if   [ "$pct" -lt 50 ];  then echo "MODERATE|${pct}% of ${total}KB swap (${used}KB used)"; return; fi
  if   [ "$pct" -lt 80 ];  then echo "HIGH|${pct}% of ${total}KB swap (${used}KB used)"; return; fi
  echo "CRITICAL|${pct}% of ${total}KB swap (${used}KB used) — RAM insufficient"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # LIGHT: 1GB used of 4GB (24%) — below the 25% cutoff
  r="$(classify_swap 1000000 4194304)"
  [ "$r" = "LIGHT|23% of 4194304KB swap (1000000KB used)" ] || { echo "  FAIL LIGHT: got=$r"; fail=1; }
  # LIGHT boundary: just under 25%
  r="$(classify_swap 1048575 4194304)"
  [ "$r" = "LIGHT|24% of 4194304KB swap (1048575KB used)" ] || { echo "  FAIL LIGHT-boundary: got=$r"; fail=1; }
  # MODERATE: at exactly 25% (the LIGHT→MODERATE cutoff)
  r="$(classify_swap 1048576 4194304)"
  [ "$r" = "MODERATE|25% of 4194304KB swap (1048576KB used)" ] || { echo "  FAIL MODERATE: got=$r"; fail=1; }
  # MODERATE: 2GB of 4GB (50%)
  r="$(classify_swap 2097152 4194304)"
  [ "$r" = "HIGH|50% of 4194304KB swap (2097152KB used)" ] || { echo "  FAIL MODERATE-50: got=$r"; fail=1; }
  # MODERATE: 25% boundary
  r="$(classify_swap 1048576 4194300)"
  [ "$r" = "MODERATE|25% of 4194300KB swap (1048576KB used)" ] || { echo "  FAIL MODERATE-boundary: got=$r"; fail=1; }
  # HIGH: 60% (integer floor — 2516582*100/4194304 = 59)
  r="$(classify_swap 2516582 4194304)"
  [ "$r" = "HIGH|59% of 4194304KB swap (2516582KB used)" ] || { echo "  FAIL HIGH: got=$r"; fail=1; }
  # HIGH boundary: at exactly 50%
  r="$(classify_swap 2097152 4194300)"
  [ "$r" = "HIGH|50% of 4194300KB swap (2097152KB used)" ] || { echo "  FAIL HIGH-boundary: got=$r"; fail=1; }
  # CRITICAL: 90%
  r="$(classify_swap 3774874 4194304)"
  [ "$r" = "CRITICAL|90% of 4194304KB swap (3774874KB used) — RAM insufficient" ] || { echo "  FAIL CRITICAL: got=$r"; fail=1; }
  # CRITICAL boundary: at exactly 80% (used=3355444 gives integer 80%)
  r="$(classify_swap 3355444 4194304)"
  [ "$r" = "CRITICAL|80% of 4194304KB swap (3355444KB used) — RAM insufficient" ] || { echo "  FAIL CRITICAL-boundary: got=$r"; fail=1; }
  # NONE: 0 used
  r="$(classify_swap 0 4194304)"
  [ "$r" = "NONE|0 of 4194304KB swap used — no swapping activity" ] || { echo "  FAIL NONE: got=$r"; fail=1; }
  # UNKNOWN: empty
  r="$(classify_swap '' '')"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL UNKNOWN-empty: got=$r"; fail=1; }
  # UNKNOWN: non-numeric
  r="$(classify_swap abc def)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL UNKNOWN-nonnumeric: got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (11 cases: LIGHT×2, MODERATE×2, HIGH×2, CRITICAL×2, NONE×1, UNKNOWN×2)"
  # REAL-READ gate: reachability ≠ producing. The /proc file must be readable AND produce a
  # 2-tuple (used, total) or the sense is hollow (green test with no real artifact).
  _proc="/proc/swaps"
  [ -r "$_proc" ] || { echo "smoke-test: n/a (/proc/swaps unreadable — kernel not Linux? /procfs missing?); classify-logic ok"; exit 2; }
  _tup="$(parse_swap "$_proc")" || { echo "smoke-test: n/a (parse failed); classify-logic ok"; exit 2; }
  echo "smoke-test: ok (classify: 11 cases + REAL swap read: $_tup)"
  exit 0
fi

# --- Live read path ---
_proc="/proc/swaps"
[ -r "$_proc" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-swap: $_proc not readable (kernel not Linux? /procfs missing?) — not an alarm" >&2
  exit 2
}
tup="$(parse_swap "$_proc")"
[ -n "$tup" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-swap: parse failed (tup='$tup') — not an alarm" >&2
  exit 2
}

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
used="$(printf '%s' "$tup" | awk '{print $1}')"
total="$(printf '%s' "$tup" | awk '{print $2}')"

result="$(classify_swap "$used" "$total")"
label="${result%%|*}"
reason="${result#*|}"

# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|used=%s|total=%s|%s\n' "$label" "$used" "$total" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","used_kb":%s,"total_kb":%s,"ts":"%s"}\n' \
    "$label" "$reason" "$used" "$total" "$TS"
  exit 0
fi
printf '[swap-%s] %s — used=%sKB total=%sKB | %s\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$used" "$total" "$reason"
