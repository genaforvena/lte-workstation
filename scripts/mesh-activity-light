#!/usr/bin/env bash
# orphan-ok: DORMANT until the phone sensorium returns — its 3 inputs (mesh-light/mesh-body-motion/
#   mesh-tamper) are phone-dependent and the Redmi sshd is down, so a live run is DEGRADED-only. The
#   fusion logic is correct + --test-green; wiring it now (a reflex-cadence) would emit DEGRADED noise
#   every run. WIRE IT (add # reflex-cadence + # reflex-args: --edge → mesh-autowire) once the phone
#   senses are reachable again — at which point it produces a real HUMAN-ACTIVE/ENVIRONMENTAL verdict.
# mesh-activity-light — cross-sense FUSION: "who or what changed the light?"
#
# Combines 3 existing senses into a derived signal no single sensor gives:
#   1. mesh-light   → level + velocity (lux/s) + change_class (GRADUAL|SUDDEN|STABLE)
#   2. mesh-body-motion → STILL/CARRIED/HANDLED/COVERED/WALKING
#   3. mesh-tamper   → MOVED/QUIET (recent physical disturbance)
#
# The question: when the light changes, was it a PERSON or the ENVIRONMENT?
#   HUMAN-ACTIVE    sudden light change + body motion/tamper → someone manipulated light/curtain
#   ENVIRONMENTAL   gradual light change + no body motion → sunset, sunrise, clouds
#   STATIC          no light change + no activity → room unchanged
#   AMBIGUOUS       light changed but no body signal (person out of sensor range)
#   DEGRADED        sensors unreachable → honest signal, never silent all-clear
#
# Usage:
#   mesh-activity-light           one-shot verdict
#   mesh-activity-light --edge    emit only on state change (2-consecutive debounce)
#   mesh-activity-light --json    machine-readable JSON
#   mesh-activity-light --test    smoke test (no network, pure fusion logic)
#
# Exit codes (honest-exit contract):
#   0 = verdict assessed (may be DEGRADED if some sensors unreachable)
#   2 = ALL inputs unreachable — cannot assess at all
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE_FILE="$HOME/.mesh/.activity-light.state"
DEGRADED_FILE="$HOME/.mesh/.activity-light.degraded"

# ── Fusion (PURE — no I/O, exercised by --test) ──────────────────────
# classify <light_change> <light_velocity> <body> <tamper> → "VERDICT|reason"
# Honest-degraded: any UNREACHABLE sensor → DEGRADED, never a faked verdict.
classify() {
  local lc="$1" vel="$2" body="$3" tamper="$4"
  local degraded="" reason=""

  [ "$lc" = "UNREACHABLE" ] && degraded="light"
  [ "$body" = "UNREACHABLE" ] && degraded="${degraded:+$degraded + }body-motion"
  [ "$tamper" = "UNREACHABLE" ] && degraded="${degraded:+$degraded + }tamper"

  if [ -n "$degraded" ]; then
    printf 'DEGRADED|unreachable: %s (cannot determine cause of light change)' "$degraded"
    return
  fi

  # No light change → static room
  if [ "$lc" = "STABLE" ]; then
    if [ "$body" != "STILL" ] && [ "$body" != "UNKNOWN" ] && [ "$body" != "COVERED" ]; then
      printf 'STATIC|no light change, but body=%s (activity without light effect)' "$body"
    elif [ "$tamper" = "MOVED" ]; then
      printf 'STATIC|no light change, tamper=MOVED (disturbance had no light effect)'
    else
      printf 'STATIC|no light change, room undisturbed'
    fi
    return
  fi

  # Light changed — classify the cause
  local body_active=0
  case "$body" in
    CARRIED|HANDLED|WALKING) body_active=1 ;;
  esac

  if [ "$lc" = "SUDDEN" ]; then
    if [ "$body_active" = 1 ]; then
      printf 'HUMAN-ACTIVE|sudden light change (velocity=%s lux/s) + body=%s — someone acted on the light' "$vel" "$body"
    elif [ "$tamper" = "MOVED" ]; then
      printf 'HUMAN-ACTIVE|sudden light change + tamper=MOVED — physical disturbance caused light shift'
    else
      printf 'AMBIGUOUS|sudden light change (velocity=%s lux/s) but body=%s tamper=%s — person out of sensor range?' "$vel" "$body" "$tamper"
    fi
  elif [ "$lc" = "GRADUAL" ]; then
    if [ "$body_active" = 1 ]; then
      printf 'HUMAN-ACTIVE|gradual light change + body=%s — person adjusting curtains/light over time' "$body"
    elif [ "$tamper" = "MOVED" ]; then
      printf 'HUMAN-ACTIVE|gradual light change + tamper=MOVED — recent disturbance correlates'
    else
      printf 'ENVIRONMENTAL|gradual light change (velocity=%s lux/s), no body motion — natural (sunset/clouds)' "$vel"
    fi
  else
    printf 'AMBIGUOUS|light change class=%s unknown, body=%s tamper=%s' "$lc" "$body" "$tamper"
  fi
}

# phone_reachable <ip> <port> → exit 0 only if a 2s TCP connect to sshd SUCCEEDS.
# This is the real reachability test the gate must use — an empty/unresolved IP or a
# resolvable-but-DEAD (cached/last-known) IP both correctly yield non-zero (unreachable),
# so a phone that is OFF the network can never be mistaken for reachable.
phone_reachable() {
  local ip="$1" port="$2"
  [ -n "$ip" ] || return 1
  timeout 2 bash -c "echo >/dev/tcp/$ip/$port" 2>/dev/null
}

# ── Smoke test ───────────────────────────────────────────────────────
if [ "${1:-}" = --test ]; then
  fails=0
  # phone-gate reachability regression (the exit0!=reachable bug class, knowledge note):
  # an empty IP and a resolvable-but-dead LAN IP must BOTH read unreachable, never "ok".
  # NOT a public/TEST-NET IP: this node's egress accepts a TCP connect() to ANY public
  # destination regardless of whether anything is listening there (measured 2026-08-11,
  # 'hollow TCP reachability' — router VPN or ISP transparent proxy, mechanism unnamed),
  # so a public dead-IP fixture no longer fails honestly here. PHONE_IP is always
  # LAN/tailnet-scoped in real use (mesh-phone-ip/mesh-peer-addr), never public, so the
  # fixture must match that scope: a nonexistent LAN host still refuses/times out honestly.
  phone_reachable "" 8022             && { echo "FAIL: empty IP must be unreachable"; fails=$((fails+1)); }
  phone_reachable "192.168.8.199" 8022 && { echo "FAIL: dead LAN IP must be unreachable (not trusted as 'ok')"; fails=$((fails+1)); }
  assert() {
    local got; got="$(classify "$2" "$3" "$4" "$5")"; got="${got%%|*}"
    if [ "$got" != "$1" ]; then echo "FAIL: $4 — got '$got' want '$1'"; fails=$((fails+1)); fi
  }
  # SUDDEN + body moving → HUMAN-ACTIVE
  assert HUMAN-ACTIVE  SUDDEN  10.5  CARRIED  QUIET
  assert HUMAN-ACTIVE  SUDDEN  8.2   HANDLED  QUIET
  # SUDDEN + tamper → HUMAN-ACTIVE
  assert HUMAN-ACTIVE  SUDDEN  7.0   STILL    MOVED
  # SUDDEN + still + quiet → AMBIGUOUS
  assert AMBIGUOUS     SUDDEN  5.1   STILL    QUIET
  # GRADUAL + no motion → ENVIRONMENTAL
  assert ENVIRONMENTAL GRADUAL 0.3   STILL    QUIET
  # GRADUAL + body moving → HUMAN-ACTIVE
  assert HUMAN-ACTIVE  GRADUAL 2.0   WALKING  QUIET
  # STABLE → STATIC
  assert STATIC        STABLE  0.0   STILL    QUIET
  # STABLE + moving → STATIC (activity without light effect)
  assert STATIC        STABLE  0.0   CARRIED  QUIET
  # STABLE + tamper → STATIC (disturbance without light effect)
  assert STATIC        STABLE  0.0   STILL    MOVED
  # UNREACHABLE → DEGRADED (never silent all-clear)
  assert DEGRADED      UNREACHABLE UNREACHABLE UNREACHABLE UNREACHABLE
  # One unreachable → DEGRADED
  assert DEGRADED      UNREACHABLE 0.0 STILL    UNREACHABLE
  # Degraded shows which sensor failed
  _d="$(classify UNREACHABLE 0.0 STILL QUIET)"
  printf '%s' "$_d" | grep -q 'light' || { echo "FAIL: DEGRADED should name 'light' in reason"; fails=$((fails+1)); }
  _d2="$(classify SUDDEN 10.0 UNREACHABLE QUIET)"
  printf '%s' "$_d2" | grep -q 'body-motion' || { echo "FAIL: DEGRADED should name 'body-motion' in reason"; fails=$((fails+1)); }
  if [ "$fails" -eq 0 ]; then
    echo "smoke-test: ok (12 fusion assertions: HUMAN-ACTIVE/ENVIRONMENTAL/STATIC/AMBIGUOUS/DEGRADED + degraded-reason checks; +2 phone-gate reachability regressions: empty + dead-IP → unreachable)"
    exit 0
  fi
  echo "smoke-test: FAILED ($fails assertion(s))"; exit 1
fi

# ── Read senses ──────────────────────────────────────────────────────
read_light() {
  local out
  out="$(timeout 15 mesh-light --json 2>/dev/null)" || { echo "UNREACHABLE|UNREACHABLE|UNREACHABLE"; return; }
  printf '%s' "$out" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print('%s|%s|%s' % (d.get('change_class','UNKNOWN'), d.get('velocity',0), d.get('level','UNKNOWN')))
" 2>/dev/null || echo "UNKNOWN|UNKNOWN|UNKNOWN"
}

read_body() {
  local out
  out="$(timeout 15 mesh-body-motion 2>/dev/null)" || { echo "UNREACHABLE"; return; }
  case "$out" in
    *\[body-walking\]*)  echo "WALKING" ;;
    *\[body-carried\]*)  echo "CARRIED" ;;
    *\[body-handled\]*)  echo "HANDLED" ;;
    *\[body-covered\]*)  echo "COVERED" ;;
    *\[body-still\]*)    echo "STILL" ;;
    *)                   echo "UNKNOWN" ;;
  esac
}

read_tamper() {
  local out
  out="$(timeout 15 mesh-tamper 2>/dev/null)" || { echo "UNREACHABLE"; return; }
  case "$out" in
    *\[body-moved\]*) echo "MOVED" ;;
    *\[body-quiet\]*) echo "QUIET" ;;
    *)                echo "UNKNOWN" ;;
  esac
}

# Quick phone reachability gate — probe REAL sshd liveness, NOT mesh-phone-ip's exit code.
# mesh-phone-ip returns a CACHED/last-known IP with exit 0 even when the phone is OFFLINE
# (knowledge/phone-ip-exit0-is-not-reachability) — so the old `mesh-phone-ip && phone_ok=1` gate
# stayed "ok" on a dead phone and light+body+tamper each stalled ~ on the dead IP instead of the
# intended early exit 2. Resolve the address, then a 2s TCP connect to sshd (cf. mesh-room-activity).
PHONE_IP="${PHONE_IP:-$(mesh-phone-ip 2>/dev/null | tail -1)}"
[ -n "$PHONE_IP" ] || PHONE_IP="$(mesh-peer-addr Redmi 2>/dev/null || true)"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
phone_ok=0
if phone_reachable "$PHONE_IP" "$PHONE_PORT"; then
  phone_ok=1
fi

if [ "$phone_ok" = 0 ]; then
  # Phone offline → all 3 senses unreachable → cannot assess
  echo "mesh-activity-light: all inputs unreachable (phone offline) — cannot assess" >&2
  exit 2
fi

light_raw="$(read_light)"
light_change="${light_raw%%|*}"
light_rest="${light_raw#*|}"
light_velocity="${light_rest%%|*}"
light_level="${light_rest#*|}"

body="$(read_body)"
tamper="$(read_tamper)"

# ── Fusion ───────────────────────────────────────────────────────────
fused="$(classify "$light_change" "$light_velocity" "$body" "$tamper")"
verdict="${fused%%|*}"
reason="${fused#*|}"

# ── Hysteresis (2-consecutive debounce) ──────────────────────────────
prev_state=""
[ -f "$STATE_FILE" ] && prev_state="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
prev_raw=""
[ -f "$DEGRADED_FILE" ] && prev_raw="$(cat "$DEGRADED_FILE" 2>/dev/null || echo "")"

changed=0
if [ "$verdict" = "$prev_raw" ] && [ "$verdict" != "$prev_state" ]; then
  echo "$verdict" > "$STATE_FILE"
  changed=1
elif [ "$verdict" != "$prev_raw" ]; then
  :  # record as pending
fi
echo "$verdict" > "$DEGRADED_FILE"

state="$prev_state"
[ "$changed" = "1" ] && state="$verdict"
[ -z "$prev_state" ] && state="$verdict" && changed=1

# ── Output ───────────────────────────────────────────────────────────
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","reason":"%s","light":{"level":"%s","change_class":"%s","velocity":%s},"body":"%s","tamper":"%s","ts":"%s"}\n' \
    "$state" "$reason" "$light_level" "$light_change" "$light_velocity" "$body" "$tamper" "$ts"
elif [ "${1:-}" = --edge ]; then
  [ "$changed" = 0 ] && exit 0
  printf '[activity-light] %s — %s | light=%s/%s vel=%s body=%s tamper=%s\n' \
    "$state" "$reason" "$light_level" "$light_change" "$light_velocity" "$body" "$tamper"
else
  printf '[activity-light] %s — %s | light=%s/%s vel=%s lux/s body=%s tamper=%s\n' \
    "$state" "$reason" "$light_level" "$light_change" "$light_velocity" "$body" "$tamper"
fi
