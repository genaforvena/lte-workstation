#!/usr/bin/env bash
# mesh-display-link — sense: is an EXTERNAL display (HDMI / DisplayPort / DVI / VGA) physically
# plugged into this node? A real-world signal nothing else captures: the laptop being DOCKED to a
# monitor or hooked to a TV vs running mobile on its own panel.
#
# Distinct from the existing display senses:
#   * mesh-backlight / mesh-screen-state — is the INTERNAL panel's backlight ON (brightness/power)
#   * mesh-lid                            — lid open/closed
#   * THIS                                — is an EXTERNAL connector CONNECTED (a cable is plugged)
# The kernel reports per-connector hotplug state, so this is the node's own "am I on a big screen?"
# proprioception — a genuine docking/usage + location proxy (at-desk-dock vs mobile), and a hint for
# the TV organ (an external panel already wired by HDMI).
#
# SOURCE: /sys/class/drm/card*-*/status — kernel DRM connector state, one of:
#   "connected" / "disconnected" / "unknown". The connector name (after the cardN- prefix) classifies
#   it: eDP*/LVDS*/DSI* = the built-in panel (INTERNAL); DP*/HDMI*/DVI*/VGA*/Display* = EXTERNAL.
#
# Honest-exit contract (never fakes a reading):
#   0 = real reading produced (EXTERNAL / INTERNAL-ONLY / NO-DISPLAY)
#   2 = no DRM subsystem at all (a headless box / VM with no GPU connectors) => sense UNREACHABLE,
#       rendered UNKNOWN — visibly different from a genuine "no external plugged" (INTERNAL-ONLY).
#   A connector reading "disconnected" is a REAL reading (cable out), NOT unreachable.
#
#   mesh-display-link          one-line verdict to stdout
#   mesh-display-link --json   machine form {verdict, external, internal, connectors, ts}
#   mesh-display-link --test   smoke test (synthetic DRM fixtures via $DISPLAY_LINK_DRM — no hardware)
#
# Vocab contract: FIRST token after "[display-link] " is the verdict (EXTERNAL|INTERNAL-ONLY|
# NO-DISPLAY|UNKNOWN) and appears nowhere else in the line (consumers grep -q). Read-only.
#
# orphan-ok: on-demand proprioception query — a slow-changing hardware fact (a cable is rarely
# (un)plugged), pulled live by the mind / a docking-aware caller, not a polled sense worth a cron
# artifact. Wiring it would only spin a /sys read nobody currently consumes.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

DRM_ROOT="${DISPLAY_LINK_DRM:-/sys/class/drm}"

# classify a connector basename (cardN- prefix already stripped) -> "internal" | "external"
classify() {
  case "$1" in
    eDP*|LVDS*|DSI*) printf internal ;;
    *)               printf external ;;   # DP/HDMI/DVI/VGA/DisplayPort/etc.
  esac
}

# scan the DRM root; sets globals: EXT_CONN, INT_CONN (lists of connected names), FOUND (any status file)
scan() {
  EXT_CONN=""; INT_CONN=""; FOUND=0
  local s name kind st
  for s in "$DRM_ROOT"/*/status; do
    [ -r "$s" ] || continue
    FOUND=1
    name="$(basename "$(dirname "$s")")"   # e.g. card1-HDMI-A-1
    name="${name#card*-}"                  # -> HDMI-A-1  (strip the cardN- prefix)
    st="$(cat "$s" 2>/dev/null)"
    [ "$st" = connected ] || continue
    kind="$(classify "$name")"
    if [ "$kind" = external ]; then EXT_CONN="$EXT_CONN${EXT_CONN:+,}$name"
    else                            INT_CONN="$INT_CONN${INT_CONN:+,}$name"; fi
  done
}

emit() { # $1=mode (text|json)
  scan
  local verdict reason next
  if [ "$FOUND" -eq 0 ]; then
    verdict=UNKNOWN
    reason="no DRM connectors under $DRM_ROOT — headless/VM, no display subsystem (sense unreachable)"
  elif [ -n "$EXT_CONN" ]; then
    verdict=EXTERNAL
    reason="external display plugged: $EXT_CONN${INT_CONN:+ (+internal $INT_CONN)}"
  elif [ -n "$INT_CONN" ]; then
    verdict=INTERNAL-ONLY
    reason="internal panel only ($INT_CONN) — no external display connected"
  else
    verdict=NO-DISPLAY
    reason="DRM present but no connector connected (all outputs dark)"
  fi
  # count comma-separated items (empty list => 0; awk-on-empty-stdin silently prints nothing → bad JSON)
  ncsv() { local v="$1" c; [ -z "$v" ] && { printf 0; return; }; c="${v//[!,]/}"; printf '%s' "$(( ${#c} + 1 ))"; }
  local extn intn; extn="$(ncsv "$EXT_CONN")"; intn="$(ncsv "$INT_CONN")"
  if [ "$1" = json ]; then
    printf '{"verdict":"%s","external":%s,"internal":%s,"connectors":"%s","reason":"%s","ts":"%s"}\n' \
      "$verdict" "$extn" "$intn" "${EXT_CONN}${EXT_CONN:+;}${INT_CONN}" "$reason" "$(date -u +%FT%TZ)"
  else
    printf '[display-link] %s — %s | external=%s internal=%s\n' "$verdict" "$reason" "$extn" "$intn"
  fi
  [ "$verdict" = UNKNOWN ] && return 2 || return 0
}

# --- smoke test: drive verdicts off synthetic DRM fixtures; no hardware, no live /sys read ---
if [ "${1:-}" = --test ]; then
  fail=0
  mkfix() { # build a fake DRM root: args are "name=status" pairs -> echoes the dir
    local d c n st; d="$(mktemp -d)"
    for c in "$@"; do n="${c%%=*}"; st="${c#*=}"; mkdir -p "$d/card1-$n"; printf '%s\n' "$st" > "$d/card1-$n/status"; done
    printf '%s' "$d"
  }
  check() { # $1=expected-verdict $2=expected-rc ; remaining = connector=status fixtures
    local want_v="$1" want_rc="$2"; shift 2
    local dir out vd rc
    dir="$(mkfix "$@")"
    out="$(DISPLAY_LINK_DRM="$dir" "$0" 2>/dev/null)"; rc=$?
    vd="$(printf '%s' "$out" | sed -nE 's/^\[display-link\] ([A-Z-]+) .*/\1/p')"
    [ "$vd" = "$want_v" ] && [ "$rc" -eq "$want_rc" ] || { echo "  FAIL: got verdict=$vd rc=$rc (want $want_v/$want_rc) [$*]"; fail=1; }
    rm -rf "$dir"
  }
  check EXTERNAL      0 'eDP-1=connected' 'HDMI-A-1=connected'              # docked: panel + HDMI
  check EXTERNAL      0 'eDP-1=disconnected' 'DP-1=connected'              # lid-closed-clamshell on external DP
  check INTERNAL-ONLY 0 'eDP-1=connected' 'HDMI-A-1=disconnected' 'DP-1=disconnected'  # mobile, nothing plugged
  check NO-DISPLAY    0 'eDP-1=disconnected' 'HDMI-A-1=disconnected'      # DRM present, all outputs dark
  # honest-unreachable: an EMPTY DRM root (no status files) must be UNKNOWN + exit 2, NOT a faked INTERNAL-ONLY
  emptyd="$(mktemp -d)"
  out="$(DISPLAY_LINK_DRM="$emptyd" "$0" 2>/dev/null)"; rc=$?
  printf '%s' "$out" | grep -q 'UNKNOWN' && [ "$rc" -eq 2 ] || { echo "  FAIL: empty DRM root must be UNKNOWN/exit-2 (got rc=$rc: $out)"; fail=1; }
  rm -rf "$emptyd"
  [ "$fail" = 0 ] && { echo "smoke-test: ok (4-verdict matrix + honest-unreachable exit-2)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

case "${1:-}" in
  --json) emit json; exit $? ;;
  *)      emit text; exit $? ;;
esac
