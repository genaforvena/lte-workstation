#!/usr/bin/env bash
# mesh-llama-vision — local multimodal OCR/vision organ.
#
#   mesh-llama-vision IMAGE [PROMPT]  send one image and print the model answer
#   mesh-llama-vision --test           run the pinned real-image acceptance gate
#
# The resident llama-server is OpenAI-compatible and defaults to 127.0.0.1:43747.
# Override LLAMA_SERVER_URL or LLAMA_VISION_MODEL for a deliberate local deployment.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
base_url="${LLAMA_SERVER_URL:-http://127.0.0.1:43747}"
base_url="${base_url%/}"
fixture_spec="$repo/docs/local-llama-vision-fixture.json"
# A deployed copy lives in ~/.local/bin, while its pinned fixture remains in the genome.
if [ ! -f "$fixture_spec" ] && [ -f "${MESH_REPO:-$HOME/lte-workstation}/docs/local-llama-vision-fixture.json" ]; then
    repo="${MESH_REPO:-$HOME/lte-workstation}"
    fixture_spec="$repo/docs/local-llama-vision-fixture.json"
fi

usage() {
    cat <<'EOF'
mesh-llama-vision IMAGE [PROMPT]
mesh-llama-vision --test

Send IMAGE to the local multimodal llama-server and print its answer.
Environment: LLAMA_SERVER_URL (default http://127.0.0.1:43747),
LLAMA_VISION_MODEL (optional explicit model id).
--test validates the pinned fixture and performs a live OCR request.
EOF
}

fail() { echo "mesh-llama-vision: FAIL ($*)" >&2; exit 1; }

pick_model() {
    local models="$1"
    if [ -n "${LLAMA_VISION_MODEL:-}" ]; then
        printf '%s' "$LLAMA_VISION_MODEL"
        return
    fi
    printf '%s' "$models" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for item in d.get("models", []) + d.get("data", []):
    if "multimodal" in item.get("capabilities", []):
        print(item.get("id") or item.get("name") or "")
        break
'
}

mime_type() {
    case "$1" in
        *.png|*.PNG) printf 'image/png' ;;
        *.jpg|*.JPG|*.jpeg|*.JPEG) printf 'image/jpeg' ;;
        *) fail "unsupported image type (use PNG or JPEG): $1" ;;
    esac
}

ask() {
    local image="$1" prompt="$2" models model mime request response answer
    [ -s "$image" ] || fail "missing or empty image: $image"
    mime="$(mime_type "$image")"
    models="$(curl -fsS --max-time 5 "$base_url/v1/models" 2>/dev/null)" \
        || fail "llama-server unavailable at $base_url"
    model="$(pick_model "$models")"
    [ -n "$model" ] || fail "no multimodal model advertised (set LLAMA_VISION_MODEL only for an intentional override)"

    request="$(mktemp)"
    response="$(mktemp)"
    trap 'rm -f "$request" "$response"' RETURN
    MIME_TYPE="$mime" python3 - "$image" "$model" "$prompt" >"$request" <<'PY'
import base64, json, sys
image = base64.b64encode(open(sys.argv[1], "rb").read()).decode()
print(json.dumps({
    "model": sys.argv[2],
    "messages": [{"role": "user", "content": [
        {"type": "text", "text": sys.argv[3]},
        {"type": "image_url", "image_url": {"url": "data:" + __import__("os").environ["MIME_TYPE"] + ";base64," + image}},
    ]}],
    "temperature": 0.0,
    "max_tokens": 256,
}))
PY
    MIME_TYPE="$mime" curl -fsS --max-time 60 "$base_url/v1/chat/completions" \
        -H 'Content-Type: application/json' -d "@$request" >"$response" \
        || fail "multimodal request failed"
    answer="$(python3 - "$response" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
content = d["choices"][0]["message"]["content"]
if isinstance(content, list):
    content = " ".join(str(x.get("text", "")) for x in content if isinstance(x, dict))
print(str(content).strip())
PY
)"
    [ -n "$answer" ] || fail "multimodal model returned an empty answer"
    printf '%s\n' "$answer"
}

run_test() {
    [ -s "$fixture_spec" ] || fail "missing fixture specification: $fixture_spec"
    python3 - "$fixture_spec" "$repo" <<'PY'
import hashlib, json, pathlib, sys
spec = json.load(open(sys.argv[1]))
path = pathlib.Path(sys.argv[2]) / spec["fixture"]
assert path.is_file() and path.stat().st_size > 1024, f"missing/short fixture: {path}"
assert path.read_bytes().startswith(b"\x89PNG\r\n\x1a\n"), f"not a PNG: {path}"
got = hashlib.sha256(path.read_bytes()).hexdigest()
assert got == spec["fixture_sha256"], f"fixture SHA mismatch: {got}"
PY
    local answer
    answer="$(ask "$repo/$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["fixture"])' "$fixture_spec")" \
        'Read the title bar in this image. Reply with the exact visible title.')"
    printf '%s' "$answer" | grep -Eiq 'mesh.*chat.*board' \
        || fail "OCR predicate failed: $answer"
    printf 'mesh-llama-vision: PASS (answer=%s)\n' "$answer"
}

case "${1:-}" in
    --help|-h) usage ;;
    --test) run_test ;;
    '') usage >&2; exit 2 ;;
    *)
        image="$1"
        prompt="${2:-Read all visible text in this image and return it exactly.}"
        ask "$image" "$prompt"
        ;;
esac
