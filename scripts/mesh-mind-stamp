#!/usr/bin/env bash
# mesh-mind-stamp — agent stamps "I thought at HH:MM" on each substantive action.
# Used by mesh-mind-watch to distinguish "mind down" from "node down":
#   stale stamp + node SSH-alive + reflexes green = MIND outage (borrow a brain).
#   stale stamp + node SSH-dead                  = NODE outage (mesh-restore, beacon).
# Call at the start of each tick response / substantive work session.
# reflex: mind-beat
BEAT="${HOME}/.mesh/mind-beat.ts"
mkdir -p "$(dirname "$BEAT")"
date -u +%FT%TZ > "$BEAT"
