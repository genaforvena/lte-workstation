#!/usr/bin/env bash
# orphan-ok: DECAYED — the beat WRITER for the decayed mesh-mind-watch; its sole caller (mesh-tick's
#            mindbeat, WIN=plan) was removed and 'plan' no longer exists. Kept, not attic'd; unwired.
#
# mesh-mind-stamp — agent stamps "I thought at HH:MM" (~/.mesh/mind-beat.ts) on each substantive action.
#
# ── DECAYED 2026-07-06 (dead writer of a decayed sense) ───────────────────────────────────────────
# This is the write half of the mind-beat chain read by mesh-mind-watch — now DECAYED (superseded by
# mesh-mind-state, which reads pane content and needs no self-stamp). The ONLY caller was mesh-tick's
# mindbeat(), gated on WIN=plan; the 'plan' window vanished in the 2026-06-17 channel re-org, so this
# has not run since 2026-06-19 — mind-beat.ts is frozen. That dead tick call was removed alongside this
# decay. To revive: see the mesh-mind-watch banner (re-establish a real writer that fires for a live
# window, confirm the beat advances, also re-point mesh-borrowed-brain) — but prefer mesh-mind-state.
# ──────────────────────────────────────────────────────────────────────────────────────────────────
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  command -v mkdir >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mkdir)"; exit 1; }
  command -v dirname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no dirname)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  : > "$HOME/.mesh/.mind-stamp-test" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  rm -f "$HOME/.mesh/.mind-stamp-test"
  # Dry-run: write a stamp to a temp dir and verify ISO 8601 format
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _beat="$_td/mind-beat.ts"
  mkdir -p "$(dirname "$_beat")"
  date -u +%FT%TZ > "$_beat"
  _stamp="$(cat "$_beat")"
  printf '%s' "$_stamp" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
    || { echo "smoke-test: FAIL (bad stamp format: $_stamp)"; exit 1; }
  echo "smoke-test: ok (stamp: $_stamp)"; exit 0
fi
BEAT="${HOME}/.mesh/mind-beat.ts"
mkdir -p "$(dirname "$BEAT")"
date -u +%FT%TZ > "$BEAT"
