#!/usr/bin/env bash
# mesh-mind-stamp — agent stamps "I thought at HH:MM" on each substantive action.
# Used by mesh-mind-watch to distinguish "mind down" from "node down":
#   stale stamp + node SSH-alive + reflexes green = MIND outage (borrow a brain).
#   stale stamp + node SSH-dead                  = NODE outage (mesh-restore, beacon).
# Call at the start of each tick response / substantive work session.
# reflex: mind-beat
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  command -v mkdir >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mkdir)"; exit 1; }
  command -v dirname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no dirname)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  : > "$HOME/.mesh/.mind-stamp-test" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  rm -f "$HOME/.mesh/.mind-stamp-test"
  # Dry-run: write a stamp to a temp dir and verify ISO 8601 format
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _beat="$_td/mind-beat.ts"
  mkdir -p "$(dirname "$_beat")"
  date -u +%FT%TZ > "$_beat"
  _stamp="$(cat "$_beat")"
  printf '%s' "$_stamp" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
    || { echo "smoke-test: FAIL (bad stamp format: $_stamp)"; exit 1; }
  echo "smoke-test: ok (stamp: $_stamp)"; exit 0
fi
BEAT="${HOME}/.mesh/mind-beat.ts"
mkdir -p "$(dirname "$BEAT")"
date -u +%FT%TZ > "$BEAT"
