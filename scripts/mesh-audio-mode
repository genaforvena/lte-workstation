#!/usr/bin/env bash
# reflex-cadence: 3-59/10 * * * *
# reflex-args: --edge
# mesh-audio-mode — CROSS-SENSE FUSION: what is this node's AUDIO PATH actually DOING right now —
# a human on a call, recording, playing media, the mesh itself listening, or nothing?
#
# Fuses two existing single-axis senses into a derived signal neither gives alone:
#   INPUT   — mesh-capture-inuse  (kernel FD holders on /dev/snd/pcmC*c: is the MIC captured, and
#             by a known mesh organ or a FOREIGN process — a real call/recording app)
#   OUTPUT  — mesh-audio-active   (kernel ALSA /proc/asound: is a playback substream RUNNING)
#   CONTEXT — mesh-jack (peripheral note, non-gating) + mesh-netrate (CALL-only corroboration:
#             a live 2-way call should show non-trivial uplink throughput; local playback need not)
#
# THE HOLE this closes: mesh-audio-active alone can't tell "operator watching a video" from "operator
# on a video call" — both are PLAYING. mesh-capture-inuse alone can't tell "the mesh's own overhear/
# room-sense organ is listening" from "a human opened Zoom" — both are mic-in-use. Only the CROSS of
# input+output direction gives the actual desk mode; no single sense reports it.
#
# Verdicts (fusion truth table — mic class x playback state):
#   CALL            — mic held by a FOREIGN process AND speaker PLAYING → live bidirectional call
#                     (foreign app both capturing mic and emitting audio at once)
#   RECORDING       — mic held by a FOREIGN process, speaker SILENT/unknown → voice memo / dictation /
#                     a call not yet exchanging audio (mic captured, nothing playing back)
#   MESH-SENSING    — mic held by a MESH organ (overhear/room-sense/transcribe/mesh-eye's own audio) →
#                     the mesh's own listening, NEVER conflated with a human call regardless of playback
#   MEDIA-PLAYBACK  — mic free/unverified, speaker PLAYING → passive listening, no interaction
#   IDLE            — mic free/unverified, speaker SILENT/unverified → nothing on the audio path
#   UNKNOWN         — BOTH inputs unreachable (no mic-capture read AND no playback read) → cannot
#                     assess anything on this node's audio path (honest n/a, never a faked IDLE)
#
# HONEST degradation (an UNREACHABLE input is NEVER a silent all-clear):
#   - capture-inuse UNKNOWN (no mic hardware / no fuser+lsof) but audio-active reads fine → verdict
#     still computed from playback alone, detail says "(mic-unverified)" — never silently promoted
#     to CALL/RECORDING since we cannot see who, if anyone, holds the mic.
#   - audio-active UNREACHABLE (no sound card) but capture-inuse reads fine → verdict computed from
#     mic alone, detail says "(playback-unverified)".
#   - both UNKNOWN/UNREACHABLE → whole fusion UNKNOWN, exit 2.
#
#   mesh-audio-mode            one-shot fused read
#   mesh-audio-mode --edge     print only on verdict CHANGE (cron mode)
#   mesh-audio-mode --json     machine-readable
#   mesh-audio-mode --test     fixtures + real-read gate (exit 2 = honest n/a)
#
# State: ~/.mesh/.audio-mode-state (content change-gated; mtime refreshed EVERY successful run via
# the shared mesh-state-touch primitive — ran-live != value-changed, the false-STALE rule).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.audio-mode-state"

# classify <mic_class> <playing> → base verdict (pure fusion core, fixture-testable).
# mic_class: FREE|MESH|FOREIGN|UNKNOWN   playing: PLAYING|SILENT|UNKNOWN
classify() {
  local mic="$1" playing="$2"
  case "$mic" in
    MESH)    echo "MESH-SENSING"; return ;;
    FOREIGN) [ "$playing" = "PLAYING" ] && echo "CALL" || echo "RECORDING"; return ;;
  esac
  # FREE or UNKNOWN mic → driven purely by playback
  if [ "$playing" = "PLAYING" ]; then echo "MEDIA-PLAYBACK"; else echo "IDLE"; fi
}

# mic_class_from_json <capture-inuse --json output> → FREE|MESH|FOREIGN|UNKNOWN (pure, testable)
mic_class_from_json() {
  local json="$1" verdict mic_inuse holders
  verdict="$(printf '%s' "$json" | grep -oE '"verdict":"[^"]*"' | cut -d'"' -f4)"
  mic_inuse="$(printf '%s' "$json" | grep -oE '"mic_inuse":[0-9]' | cut -d: -f2)"
  holders="$(printf '%s' "$json" | grep -oE '"holders":"[^"]*"' | cut -d'"' -f4)"
  if [ -z "$verdict" ] || [ "$verdict" = "UNKNOWN" ]; then echo "UNKNOWN"; return; fi
  if [ "${mic_inuse:-0}" != 1 ]; then echo "FREE"; return; fi
  # mic is held — resolve WHICH class from the pcmC holder entry (cam holders don't count here)
  if printf '%s' "$holders" | grep -qE 'pcmC[^ ]*\(FOREIGN\)'; then echo "FOREIGN"; return; fi
  if printf '%s' "$holders" | grep -qE 'pcmC[^ ]*\(MESH\)'; then echo "MESH"; return; fi
  # mic_inuse=1 but the pcmC holder didn't parse out (format drift) — fall back to overall verdict
  case "$verdict" in
    FOREIGN-CAPTURE) echo "FOREIGN" ;;
    MESH-CAPTURE)    echo "MESH" ;;
    *)               echo "FOREIGN" ;;   # mic is definitely held; never silently downgrade to FREE
  esac
}

if [ "${1:-}" = --test ]; then
  command -v mesh-capture-inuse >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-capture-inuse)"; exit 1; }
  command -v mesh-audio-active  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-audio-active)"; exit 1; }
  command -v mesh-state-touch   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-state-touch)"; exit 1; }
  fail=0
  # Fusion truth table (falsifiable: flip any branch in classify() and one of these breaks)
  [ "$(classify FOREIGN PLAYING)" = "CALL" ]           || { echo "FAIL: FOREIGN+PLAYING -> expected CALL"; fail=1; }
  [ "$(classify FOREIGN SILENT)"  = "RECORDING" ]      || { echo "FAIL: FOREIGN+SILENT -> expected RECORDING"; fail=1; }
  [ "$(classify FOREIGN UNKNOWN)" = "RECORDING" ]      || { echo "FAIL: FOREIGN+UNKNOWN -> expected RECORDING (mic class is the strong signal)"; fail=1; }
  [ "$(classify MESH PLAYING)"    = "MESH-SENSING" ]   || { echo "FAIL: MESH+PLAYING -> expected MESH-SENSING (never conflated with CALL)"; fail=1; }
  [ "$(classify MESH SILENT)"     = "MESH-SENSING" ]   || { echo "FAIL: MESH+SILENT -> expected MESH-SENSING"; fail=1; }
  [ "$(classify FREE PLAYING)"    = "MEDIA-PLAYBACK" ] || { echo "FAIL: FREE+PLAYING -> expected MEDIA-PLAYBACK"; fail=1; }
  [ "$(classify FREE SILENT)"     = "IDLE" ]           || { echo "FAIL: FREE+SILENT -> expected IDLE"; fail=1; }
  [ "$(classify UNKNOWN PLAYING)" = "MEDIA-PLAYBACK" ] || { echo "FAIL: UNKNOWN-mic+PLAYING -> expected MEDIA-PLAYBACK (never fabricate CALL without mic evidence)"; fail=1; }
  [ "$(classify UNKNOWN SILENT)"  = "IDLE" ]           || { echo "FAIL: UNKNOWN-mic+SILENT -> expected IDLE"; fail=1; }
  # mic_class_from_json — honest resolution off capture-inuse's own JSON shape
  [ "$(mic_class_from_json '{"verdict":"FREE","cam_inuse":0,"mic_inuse":0,"foreign":0,"holders":"","devices_seen":2,"tool":"fuser","ts":"x"}')" = "FREE" ] \
    || { echo "FAIL: FREE json -> expected FREE"; fail=1; }
  [ "$(mic_class_from_json '{"verdict":"FOREIGN-CAPTURE","cam_inuse":0,"mic_inuse":1,"foreign":1,"holders":"pcmC0c:zoom(FOREIGN)","devices_seen":2,"tool":"fuser","ts":"x"}')" = "FOREIGN" ] \
    || { echo "FAIL: FOREIGN pcmC holder -> expected FOREIGN"; fail=1; }
  [ "$(mic_class_from_json '{"verdict":"MESH-CAPTURE","cam_inuse":0,"mic_inuse":1,"foreign":0,"holders":"pcmC0c:arecord(MESH)","devices_seen":2,"tool":"fuser","ts":"x"}')" = "MESH" ] \
    || { echo "FAIL: MESH pcmC holder -> expected MESH"; fail=1; }
  # mic held (mic_inuse=1) but the holder is on the CAMERA not the mic PCM (format drift case) ->
  # falls back to overall verdict rather than crashing or silently downgrading to FREE
  [ "$(mic_class_from_json '{"verdict":"FOREIGN-CAPTURE","cam_inuse":1,"mic_inuse":1,"foreign":1,"holders":"video0:cheese(FOREIGN)","devices_seen":2,"tool":"fuser","ts":"x"}')" = "FOREIGN" ] \
    || { echo "FAIL: mic_inuse=1 w/ unparseable pcmC holder -> expected fallback FOREIGN"; fail=1; }
  [ "$(mic_class_from_json '{"verdict":"UNKNOWN","cam_inuse":0,"mic_inuse":0,"foreign":0,"holders":"","devices_seen":0,"tool":"none","ts":"x"}')" = "UNKNOWN" ] \
    || { echo "FAIL: UNKNOWN json -> expected UNKNOWN (honest n/a, never faked FREE)"; fail=1; }
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # REAL-READ gate (reachability != producing): both inputs must yield an actual reading on this
  # node or the fusion is hollow — a reachable-but-empty read here is honestly n/a, exit 2.
  ci_json="$(mesh-capture-inuse --json 2>/dev/null)"; ci_rc=$?
  mesh-audio-active >/dev/null 2>&1; aa_rc=$?
  if [ "$ci_rc" != 0 ] && [ "$aa_rc" = 2 ]; then
    echo "smoke-test: n/a (no mic-capture read AND no playback hardware — fusion unavailable here); fusion-logic ok"
    exit 2
  fi
  [ -n "$ci_json" ] || { echo "smoke-test: FAIL (mesh-capture-inuse --json produced no output)"; exit 1; }
  echo "smoke-test: ok (9 classify + json-resolve fixtures + REAL mic-capture read + REAL playback read)"
  exit 0
fi

# --- Live gather: INPUT axis (env-injectable for offline verification) ---
mic="${MESH_AUDIO_MODE_MIC:-}"
mic_ok=1
if [ -z "$mic" ]; then
  ci_json="$(mesh-capture-inuse --json 2>/dev/null)"
  mic="$(mic_class_from_json "$ci_json")"
  [ "$mic" = "UNKNOWN" ] && mic_ok=0
fi

# --- Live gather: OUTPUT axis ---
playing="${MESH_AUDIO_MODE_PLAYING:-}"
play_ok=1
if [ -z "$playing" ]; then
  aa_out="$(mesh-audio-active 2>/dev/null)"; aa_rc=$?
  if [ "$aa_rc" = 2 ]; then
    playing="UNKNOWN"; play_ok=0
  else
    case "$aa_out" in *PLAYING*) playing="PLAYING" ;; *) playing="SILENT" ;; esac
  fi
fi

if [ "$mic_ok" = 0 ] && [ "$play_ok" = 0 ]; then
  echo "[audio-mode] UNKNOWN — no mic-capture read AND no playback read on $(hostname) (both axes dark; not a faked IDLE)"
  exit 2
fi

verdict="$(classify "$mic" "$playing")"

detail="mic=$mic play=$playing"
[ "$mic_ok" = 1 ]  || detail="$detail(mic-unverified)"
[ "$play_ok" = 1 ] || detail="$detail(playback-unverified)"

# CONTEXT: jack peripheral note (non-gating — informational only)
jack_note=""
if jack_out="$(mesh-jack 2>/dev/null)"; then
  jl="$(printf '%s' "$jack_out" | sed -n 's/^\[jack\] \([A-Z-]*\).*/\1/p')"
  [ -n "$jl" ] && jack_note=" jack=$jl"
fi

# CALL-only corroboration: a live 2-way call should show non-trivial uplink throughput.
net_note=""
if [ "$verdict" = "CALL" ] && command -v mesh-netrate >/dev/null 2>&1; then
  nr_out="$(mesh-netrate 2>/dev/null)"
  nl="$(printf '%s' "$nr_out" | sed -n 's/^\[netrate\] \([A-Z]*\).*/\1/p')"
  if [ -n "$nl" ]; then
    net_note=" net=$nl"
    [ "$nl" = "IDLE" ] && net_note="$net_note(uplink quiet for a live call — corroboration weak, not disqualifying)"
  fi
fi

if [ "${1:-}" = --json ]; then
  printf '{"ts":"%s","host":"%s","verdict":"%s","mic":"%s","playing":"%s","mic_ok":%s,"play_ok":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$verdict" "$mic" "$playing" "$mic_ok" "$play_ok"
  exit 0
fi

prev="$(cut -d'|' -f1 "$STATE" 2>/dev/null || echo UNKNOWN)"
if [ "$verdict" != "$prev" ]; then
  printf '%s|%s|%s\n' "$verdict" "$detail" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
fi
mesh-state-touch "$STATE"   # ran-live on EVERY successful eval; content stays change-gated

if [ "${1:-}" = --edge ] && [ "$verdict" = "$prev" ]; then
  exit 0
fi

case "$verdict" in
  CALL)           echo "[audio-mode] CALL — foreign app capturing mic AND emitting audio ($detail$jack_note$net_note): live bidirectional call" ;;
  RECORDING)      echo "[audio-mode] RECORDING — foreign app capturing mic, nothing playing back ($detail$jack_note): voice memo / dictation / not-yet-answered call" ;;
  MESH-SENSING)   echo "[audio-mode] MESH-SENSING — a mesh organ holds the mic ($detail$jack_note): the mesh's own listening, not a human call" ;;
  MEDIA-PLAYBACK) echo "[audio-mode] MEDIA-PLAYBACK — playing, mic free ($detail$jack_note): passive listening, no interaction" ;;
  IDLE)           echo "[audio-mode] IDLE — mic free, nothing playing ($detail$jack_note): audio path quiet" ;;
esac
exit 0
