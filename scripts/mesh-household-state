#!/usr/bin/env bash
# mesh-household-state — HOUSEHOLD situational state: ACTIVE / ASLEEP / AWAY / UNCERTAIN.
# Answers "what mode is the household in right now?" by fusing:
#   - Operator presence (mesh-operator-home: HOME/AWAY/UNCERTAIN)
#   - Room occupancy (mesh-room-sense cached: PRESENT/EMPTY/UNCERTAIN)
#   - Time of day (NIGHT 22:00-08:00 local = sleep band)
# → ACTIVE (home + daytime + PRESENT) / ASLEEP (home + NIGHT or EMPTY) / AWAY / UNCERTAIN
#
#   mesh-household-state            verdict + 3 axis lines
#   mesh-household-state --json     {"state":"ACTIVE","op_home":"HOME","room":"PRESENT","time":"DAY"}
#   mesh-household-state --edge     REFLEX: post [household-*] on state change; wire to */5 cron
#   mesh-household-state --test
#
# Config: MESH_SLEEP_START (default 22), MESH_SLEEP_END (default 8), MESH_HS_STALE_MIN (default 10)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

SLEEP_START="${MESH_SLEEP_START:-22}"
SLEEP_END="${MESH_SLEEP_END:-8}"
HS_STALE_MIN="${MESH_HS_STALE_MIN:-10}"
HS_STATE="$HOME/.mesh/.household.state"
ROOM_STATE="$HOME/.mesh/.room-sense.state"
NOW_H="$(date +%-H)"

[ "${1:-}" = --test ] && {
  command -v mesh-operator-home >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-operator-home)"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

# ---- operator presence ----
op_j="$(mesh-operator-home --json 2>/dev/null || echo '{}')"
op_home="$(printf '%s' "$op_j" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
op_reason="$(printf '%s' "$op_j" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')"
[ -z "$op_home" ] && op_home=UNCERTAIN

# ---- room occupancy (cached) ----
room=UNCERTAIN; room_age=99999
if [ -f "$ROOM_STATE" ]; then
  room="$(cat "$ROOM_STATE" 2>/dev/null || echo UNCERTAIN)"
  mtime="$(date -u -r "$ROOM_STATE" +%FT%TZ 2>/dev/null || echo "")"
  if [ -n "$mtime" ]; then
    room_age=$(( ($(date +%s) - $(date -d "$mtime" +%s 2>/dev/null || echo $(date +%s))) / 60 ))
  fi
  [ "$room_age" -gt "$HS_STALE_MIN" ] && room="UNCERTAIN (stale ${room_age}min)"
fi

# ---- time band ----
if [ "$NOW_H" -ge "$SLEEP_START" ] || [ "$NOW_H" -lt "$SLEEP_END" ]; then
  time_band=NIGHT
else
  time_band=DAY
fi

# ---- FOLD: household state ----
STATE=UNCERTAIN
case "$op_home" in
  AWAY)
    STATE=AWAY ;;
  HOME)
    case "$time_band" in
      NIGHT) STATE=ASLEEP ;;
      DAY)
        case "$room" in
          PRESENT*) STATE=ACTIVE ;;
          EMPTY*)   STATE=ASLEEP ;;  # home but no one in room + daytime = away from room / light sleep
          *)        STATE=ACTIVE ;;  # uncertain room → default to ACTIVE (home + daytime)
        esac ;;
    esac ;;
  UNCERTAIN)
    case "$time_band" in
      NIGHT) STATE=ASLEEP ;;  # nighttime default
      *) STATE=UNCERTAIN ;;
    esac ;;
esac

if [ "$MODE" = json ]; then
  printf '{"state":"%s","op_home":"%s","room":"%s","time":"%s"}\n' \
    "$STATE" "$op_home" "${room%% *}" "$time_band"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$HS_STATE" 2>/dev/null || echo)"
  printf '%s' "$STATE" > "$HS_STATE"
  [ -n "$prev" ] && [ "$STATE" = "$prev" ] && exit 0
  tag="$(printf '%s' "$STATE" | tr 'A-Z' 'a-z')"
  msg="[household-${tag}] household=${STATE}: op=${op_home} room=${room%% *} time=${time_band} (was ${prev:-new})"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="household@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
  printf '%s\n' "$STATE"
  exit 0
fi

printf '=== household-state %s @ %s ===\n' "$(hostname)" "$(date -u +%H:%MZ)"
printf ' STATE    : %s\n' "$STATE"
printf ' operator : %s (%s)\n' "$op_home" "${op_reason:-?}"
printf ' room     : %s\n' "$room"
printf ' time     : %s (hour %s)\n' "$time_band" "$NOW_H"
exit 0
