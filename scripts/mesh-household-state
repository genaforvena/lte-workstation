#!/usr/bin/env bash
# mesh-household-state — HOUSEHOLD situational state: ACTIVE / ASLEEP / AWAY / UNCERTAIN.
# Thin stable API over mesh-home-state (richer inference engine). Maps the fine-grained
# home-state vocabulary to the simpler 4-class household vocabulary.
#
# Canonical hierarchy:
#   mesh-operator-home  — "is operator in building?" (coarse location, fast, always-available)
#   mesh-operator-state — "what is operator doing?" (fine attention, needs phone body-motion)
#   mesh-home-state     — "what is happening at home?" (rich inference: QUIET_NIGHT/WAKING/SOCIAL)
#   mesh-household-state — "household mode?" (ACTIVE/ASLEEP/AWAY/UNCERTAIN — stable API, delegates to above)
#
# Use mesh-home-state for rich context; mesh-household-state when a simple 4-class answer is needed.
#
#   mesh-household-state            verdict + source
#   mesh-household-state --json     {"state":"ACTIVE","home_state":"QUIET_NIGHT"}
#   mesh-household-state --edge     REFLEX: post [household-*] on state change; wire to */5 cron
#   mesh-household-state --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

HS_STATE="$HOME/.mesh/.household.state"

[ "${1:-}" = --test ] && {
  command -v mesh-home-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-home-state)"; exit 1; }
  # Artifact test: delegation chain must produce a valid 4-class household state
  out="$("$0" 2>/dev/null)" || { echo "smoke-test: FAIL (tool failed to run)"; exit 1; }
  if printf '%s' "$out" | grep -qE 'household: (ACTIVE|ASLEEP|AWAY|UNCERTAIN)'; then
    label="$(printf '%s' "$out" | grep -oE 'ACTIVE|ASLEEP|AWAY|UNCERTAIN' | head -1)"
    echo "smoke-test: ok ($label)"; exit 0
  else
    echo "smoke-test: FAIL (unexpected output: '${out:0:80}')"; exit 1
  fi
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

# Delegate to mesh-home-state, then map to simple vocabulary
hs_j="$(mesh-home-state --json 2>/dev/null || echo '{}')"
home_state="$(printf '%s' "$hs_j" | sed -n 's/.*"state": *"\([^"]*\)".*/\1/p')"
[ -z "$home_state" ] && home_state=UNKNOWN

case "$home_state" in
  QUIET_NIGHT|ASLEEP)      STATE=ASLEEP ;;
  WAKING|ACTIVE|ACTIVE_SOCIAL) STATE=ACTIVE ;;
  AWAY)                    STATE=AWAY ;;
  *)                       STATE=UNCERTAIN ;;
esac

if [ "$MODE" = json ]; then
  printf '{"state":"%s","home_state":"%s"}\n' "$STATE" "$home_state"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$HS_STATE" 2>/dev/null || echo)"
  printf '%s' "$STATE" > "$HS_STATE"
  [ -n "$prev" ] && [ "$STATE" = "$prev" ] && exit 0
  tag="$(printf '%s' "$STATE" | tr 'A-Z' 'a-z')"
  msg="[household-${tag}] household=${STATE} (home_state=${home_state}, was ${prev:-new})"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="household@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
  printf '%s\n' "$STATE"
  exit 0
fi

printf 'household: %s (home_state: %s)\n' "$STATE" "$home_state"
exit 0
