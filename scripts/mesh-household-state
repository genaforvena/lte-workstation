#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# reflex-args: --edge
# mesh-household-state — HOUSEHOLD situational state: ACTIVE / ASLEEP / AWAY / UNCERTAIN.
# Thin stable API over mesh-home-state (richer inference engine). Maps the fine-grained
# home-state vocabulary to the simpler 4-class household vocabulary.
#
# Canonical hierarchy:
#   mesh-operator-home  — "is operator in building?" (coarse location, fast, always-available)
#   mesh-operator-state — "what is operator doing?" (fine attention, needs phone body-motion)
#   mesh-home-state     — "what is happening at home?" (rich inference: QUIET_NIGHT/WAKING/SOCIAL)
#   mesh-household-state — "household mode?" (ACTIVE/ASLEEP/AWAY/UNCERTAIN — stable API, delegates to above)
#
# Use mesh-home-state for rich context; mesh-household-state when a simple 4-class answer is needed.
#
#   mesh-household-state            verdict + source
#   mesh-household-state --json     {"state":"ACTIVE","home_state":"QUIET_NIGHT"}
#   mesh-household-state --edge     REFLEX: post [household-*] on state change; wire to */5 cron
#   mesh-household-state --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

HS_STATE="$HOME/.mesh/.household.state"
HS_PEND="$HOME/.mesh/.household.pending"   # in-flight candidate|count for the --edge dwell debounce
HH_DWELL="${MESH_HH_DWELL:-2}"             # consecutive --edge runs a NEW state must persist before posting (~10m @ */5)

# edge_decide STATE — DWELL DEBOUNCE (chat-review/household-edge-dwell 2026-06-22): return 0 (=POST) only
# when STATE differs from the last ANNOUNCED state (HS_STATE) AND has persisted ≥ HH_DWELL consecutive
# --edge runs (counter in HS_PEND); else return 1 (=HOLD, no post) while a candidate dwells or reverts.
# Mirrors mesh-operator-home's consecutive-read AWAY debounce, but SYMMETRIC (EVERY transition dwells) —
# kills the 5-min ASLEEP↔ACTIVE bounce (2× on 2026-06-22: 02:24↔02:29, 02:59↔03:04, single-run flaps that
# returned to ACTIVE before dwelling). Cold start (no announced state) commits immediately (preserve the
# first-run announce). Side effects: updates HS_PEND; on a COMMIT writes HS_STATE (the new announced state).
# LIVENESS (dark-artifact guard, [[dark-artifact-edge-only-write]]): mesh-overview stale-checks
# .household.state's mtime (`_stale .household.state 600`), and --edge is the file's ONLY writer. So
# EVERY run must REWRITE HS_STATE — with the UNCHANGED announced value on a HOLD — or a perfectly-live
# sense reads "[Xm stale]" the moment the household sits stable >10m (the common ASLEEP-all-night case).
# Rewriting the announced value (never the dwelling candidate) refreshes mtime without touching debounce.
edge_decide(){
  local st="$1" announced cand cnt
  announced="$(cat "$HS_STATE" 2>/dev/null || echo)"
  [ -z "$announced" ] && { printf '%s' "$st" > "$HS_STATE"; rm -f "$HS_PEND" 2>/dev/null; return 0; }   # cold start
  [ "$st" = "$announced" ] && { printf '%s' "$announced" > "$HS_STATE"; rm -f "$HS_PEND" 2>/dev/null; return 1; }  # steady/reverted → refresh mtime, clear, no post
  cand=""; cnt=0
  [ -f "$HS_PEND" ] && IFS='|' read -r cand cnt < "$HS_PEND" 2>/dev/null
  case "$cnt" in ''|*[!0-9]*) cnt=0 ;; esac
  if [ "$cand" = "$st" ]; then cnt=$((cnt+1)); else cnt=1; fi                                            # same candidate ++ / new candidate restarts
  if [ "$cnt" -ge "$HH_DWELL" ]; then printf '%s' "$st" > "$HS_STATE"; rm -f "$HS_PEND" 2>/dev/null; return 0; fi
  printf '%s' "$announced" > "$HS_STATE"                                                                 # dwelling → refresh mtime, keep ANNOUNCED (not candidate)
  printf '%s|%s' "$st" "$cnt" > "$HS_PEND"; return 1                                                     # still dwelling → no post
}

[ "${1:-}" = --test ] && {
  command -v mesh-home-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-home-state)"; exit 1; }
  # DWELL DEBOUNCE unit (sandboxed state files, no mesh-home-state needed): a single-run flap must HOLD,
  # a revert must HOLD + reset the counter, and only ≥HH_DWELL consecutive runs of a NEW state may POST.
  ( _s="$(mktemp)"; _p="$(mktemp)"; rm -f "$_p"; HS_STATE="$_s"; HS_PEND="$_p"; HH_DWELL=2
    printf ACTIVE > "$HS_STATE"
    edge_decide ASLEEP; r1=$?     # run1: ASLEEP cnt1 → HOLD
    edge_decide ACTIVE; r2=$?     # run2: back to baseline → HOLD + clear pending
    edge_decide ASLEEP; r3=$?     # run3: ASLEEP cnt1 again (pending was cleared, not cnt2) → HOLD
    edge_decide ASLEEP; r4=$?     # run4: ASLEEP cnt2 → POST
    # LIVENESS regression guard ([[dark-artifact-edge-only-write]]): a HOLD must still REFRESH HS_STATE's
    # mtime (mesh-overview stale-checks it) while preserving the ANNOUNCED value (never the candidate).
    printf ACTIVE > "$HS_STATE"; rm -f "$HS_PEND"; touch -d '1 hour ago' "$HS_STATE"
    o=$(stat -c %Y "$HS_STATE"); edge_decide ASLEEP >/dev/null; n=$(stat -c %Y "$HS_STATE"); held="$(cat "$HS_STATE")"
    rm -f "$_s" "$_p"
    [ "$r1" -ne 0 ] && [ "$r2" -ne 0 ] && [ "$r3" -ne 0 ] && [ "$r4" -eq 0 ] && [ "$n" -gt "$o" ] && [ "$held" = ACTIVE ]
  ) || { echo "smoke-test: FAIL (edge_decide dwell debounce / mtime-refresh)"; exit 1; }
  # n/a passthrough (chat-review/autowire-homestate-senseless-node): a senseless home-state
  # (exit 2) must render UNKNOWN in text mode AND emit NOTHING on --edge — never a flapped verdict.
  # Hermetic: stub mesh-home-state on PATH to exit 2, isolate state files via HOME.
  _na_dir="$(mktemp -d)"; mkdir -p "$_na_dir/.mesh"
  cat > "$_na_dir/mesh-home-state" <<'STUB'
#!/bin/sh
echo '{"state":"UNKNOWN","sensed":false}'
exit 2
STUB
  chmod +x "$_na_dir/mesh-home-state"
  _na_txt="$(HOME="$_na_dir" PATH="$_na_dir:$PATH" "$0" 2>/dev/null)"
  _na_edge="$(HOME="$_na_dir" PATH="$_na_dir:$PATH" "$0" --edge 2>/dev/null)"
  rm -rf "$_na_dir"
  printf '%s' "$_na_txt" | grep -q 'household: UNKNOWN' || { echo "smoke-test: FAIL (n/a home-state not rendered UNKNOWN in text: '$_na_txt')"; exit 1; }
  [ -z "$_na_edge" ] || { echo "smoke-test: FAIL (n/a home-state still emitted on --edge: '$_na_edge')"; exit 1; }
  # Artifact test: delegation chain must produce a valid household state (4-class, or honest UNKNOWN
  # on a senseless node)
  out="$("$0" 2>/dev/null)" || { echo "smoke-test: FAIL (tool failed to run)"; exit 1; }
  if printf '%s' "$out" | grep -qE 'household: (ACTIVE|ASLEEP|AWAY|UNCERTAIN|UNKNOWN)'; then
    label="$(printf '%s' "$out" | grep -oE 'ACTIVE|ASLEEP|AWAY|UNCERTAIN|UNKNOWN' | head -1)"
    echo "smoke-test: ok ($label)"; exit 0
  else
    echo "smoke-test: FAIL (unexpected output: '${out:0:80}')"; exit 1
  fi
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

# Delegate to mesh-home-state, then map to simple vocabulary. Capture the EXIT CODE separately: a
# non-zero `|| echo` fallback would mask mesh-home-state's honest-n/a signal (exit 2 — no
# home-presence modality reachable on a senseless node).
hs_j="$(mesh-home-state --json 2>/dev/null)"; hs_rc=$?
[ -n "$hs_j" ] || hs_j='{}'
home_state="$(printf '%s' "$hs_j" | sed -n 's/.*"state": *"\([^"]*\)".*/\1/p')"
[ -z "$home_state" ] && home_state=UNKNOWN

# Honest-n/a passthrough (chat-review/autowire-homestate-senseless-node): mesh-home-state exits 2
# when NO home-presence modality is reachable (senseless node — no embodied senses + off the
# operator's LAN). Do NOT map that to UNCERTAIN and broadcast it — a node that cannot see the
# household must emit NOTHING, not a confident 4-class verdict about a home it can't observe.
NA=0; { [ "$hs_rc" = 2 ] || [ "$home_state" = UNKNOWN ]; } && NA=1

if [ "$NA" = 1 ]; then
  STATE=UNKNOWN
else
  case "$home_state" in
    QUIET_NIGHT|ASLEEP)      STATE=ASLEEP ;;
    WAKING|ACTIVE|ACTIVE_SOCIAL) STATE=ACTIVE ;;
    AWAY)                    STATE=AWAY ;;
    *)                       STATE=UNCERTAIN ;;
  esac
fi

if [ "$MODE" = json ]; then
  printf '{"state":"%s","home_state":"%s"}\n' "$STATE" "$home_state"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  # senseless node (honest n/a): emit NOTHING — no post, no state-file write. A node that cannot
  # see the household must not broadcast [household-*] about it (chat-review/autowire-homestate-
  # senseless-node). Leaving .household.state untouched lets it go honestly stale (the correct
  # "household sense not producing here" signal) instead of flapping a fabricated verdict.
  [ "$NA" = 1 ] && exit 0
  prev="$(cat "$HS_STATE" 2>/dev/null || echo)"   # last ANNOUNCED state (before edge_decide may commit a new one)
  if edge_decide "$STATE"; then                   # POST only on a DWELL-confirmed change (≥HH_DWELL runs)
    tag="$(printf '%s' "$STATE" | tr 'A-Z' 'a-z')"
    msg="[household-${tag}] household=${STATE} (home_state=${home_state}, was ${prev:-new})"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="household@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
    printf '%s\n' "$STATE"
  fi
  exit 0
fi

printf 'household: %s (home_state: %s)\n' "$STATE" "$home_state"
exit 0
