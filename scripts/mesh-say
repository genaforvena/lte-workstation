#!/usr/bin/env bash
# mesh-say — speak a line aloud in the room (the mesh's voice).
#
# For narrating notable work/events when they're worth hearing — not every step,
# just the ones worth saying out loud. Speaks on THIS node via spd-say (reaching the
# desktop audio session), and leaves a light mark in the trace.
#
#   mesh-say "the egress fix is live and verified"     speak on THIS node
#   mesh-say --phone "text"                            speak on the phone body (termux-tts-speak/SSH)
#   mesh-say --mac "text"                             speak on iMac-Rozalia (macOS say/SSH)
#   mesh-say --deliver "text"                         MUST-DELIVER: speak aloud only if the room is
#                                                     OCCUPIED *and* this node's voice is PROVEN
#                                                     audible (mesh-audible); otherwise reroute to the
#                                                     operator's Telegram (loss-free) and raise a
#                                                     verifiable physical cue via mesh-act. Occupancy
#                                                     alone was not enough: a present operator and a
#                                                     silent speaker lost the line while logging it.
set -uo pipefail
# ── --help guard (pub/argv-is-payload-tools-fire-on-help, 2026-07-15) ──────────────────────────────
# argv IS this tool's payload, so the universal discovery gesture WAS the action: `--help` sent the
# literal string '--help' down the send path. Proven live on the operator at 03:18Z (mesh-tg-update
# --help mailed him a commit digest; mesh-tg --help texted him '--help'). The safe way to ask what a
# thing does must not BE the thing — so this comes FIRST, before any dispatch, sandbox gate or config
# read. usage() renders this file's own header block, so it can never drift from the docs above.
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac


# ── occupancy-adaptive delivery (--deliver): fuse mesh-room-trace so a MUST-DELIVER spoken line is
#    never LOST to an empty room. OCCUPIED → speak aloud locally as normal; anything else (RECENT /
#    VACANT / UNKNOWN) → reroute to mesh-voice-tx (TTS → the operator's Telegram voice note), so the
#    line reaches the operator whether they're across the room or away. Ambient say (no --deliver)
#    keeps the current drop-when-empty behavior — don't spam Telegram with room chatter.
#    Honest-fusion: an unreachable room-trace renders UNKNOWN → reroute (guaranteed delivery), NEVER a
#    faked OCCUPIED that speaks into the void and silently drops the line.
deliver_occupancy(){
  [ -n "${MESH_SAY_OCC:-}" ] && { printf '%s' "$MESH_SAY_OCC"; return; }   # test/override hook
  command -v mesh-room-trace >/dev/null 2>&1 || { printf 'UNKNOWN'; return; }
  local v
  v="$(mesh-room-trace --json 2>/dev/null | sed -n 's/.*"verdict": *"\([^"]*\)".*/\1/p')"
  case "$v" in OCCUPIED|RECENT|VACANT|UNKNOWN) printf '%s' "$v" ;; *) printf 'UNKNOWN' ;; esac
}
# ── AUDIBILITY (2026-07-24, mesh-say × mesh-act pairing) ──────────────────────────────────────────
# Occupancy answers "is anyone there", NOT "can they hear it" — and --deliver routed on occupancy
# ALONE. On mesh-home that sent every must-deliver line down the local speak path into an audio stack
# with no provable output (sole sink = S/PDIF passthrough, all HDMI ELDs monitor_present=0, no
# spd-say/espeak): mesh-tts sets played=1 on the SYNTHESIZED WAV's size and never checks the player's
# rc, so the line was LOST while the trace recorded "said aloud". Identical shape to the Bose Revolve
# (sink present, speaker powered off, 15h green) and to `delivered` being a claim about curl's rc.
# mesh-audible is the missing sense; PROVEN comes only from a recorded acoustic rise, so UNKNOWN is
# the common honest answer and must route AROUND the voice, never through it.
deliver_audible(){
  [ -n "${MESH_SAY_AUD:-}" ] && { printf '%s' "$MESH_SAY_AUD"; return; }   # test/override hook
  command -v mesh-audible >/dev/null 2>&1 || { printf 'UNKNOWN'; return; }
  local v
  v="$(mesh-audible --json 2>/dev/null | sed -n 's/.*"verdict": *"\([^"]*\)".*/\1/p')"
  case "$v" in PROVEN|NO|UNKNOWN) printf '%s' "$v" ;; *) printf 'UNKNOWN' ;; esac
}
# deliver_route OCC AUD → 'speak' ONLY when the room is confirmed OCCUPIED *and* the voice is PROVEN
# audible. Every other combination → 'reroute'. Both axes fail toward reroute (a delivered line), so
# an unreachable room-trace or an unprovable speaker degrades to Telegram, never to silence.
deliver_route(){ { [ "$1" = OCCUPIED ] && [ "${2:-UNKNOWN}" = PROVEN ]; } && printf 'speak' || printf 'reroute'; }

# The pairing's other half: when the room IS occupied but the voice cannot reach it, the occupant is
# present and gets no in-room signal at all — the line silently becomes a Telegram notification they
# may not be looking at. mesh-act supplies the mesh's ONLY read-back-verifiable actuator: write
# brightness, read brightness (mesh-act led-host, verified real+reversible 2026-06-26). So we raise a
# physical cue on a channel we can PROVE actuated, precisely because speech is a channel we cannot.
# Best-effort and non-blocking — delivery never depends on it — but its outcome is REPORTED, never
# swallowed (an unreported cue failure would be the same silent-fallback class this fix is closing).
# The cue must NAME its LED, never ride mesh-act's default. Caught firing this for real: mesh-act's
# `led-host` default target is `scrolllock`, which does not exist on a headless node — `mesh-act
# led-host flash` returns rc=1 and the LED never moves, while `mesh-act --test` reports "host-LED
# real-read ok · write-path: sudo -n" (it asserts a real READ and INFERS the write). So the cue
# resolves a target from the node's own inventory; an empty inventory is honest n/a, not a silent
# no-op against a phantom LED.
cue_led(){
  [ -n "${MESH_SAY_CUE_LED:-}" ] && { printf '%s' "$MESH_SAY_CUE_LED"; return; }
  command -v mesh-act >/dev/null 2>&1 || return 1
  mesh-act led-host list 2>/dev/null | awk 'NF{print $1; exit}'
}
deliver_cue(){
  command -v mesh-act >/dev/null 2>&1 || { printf 'cue n/a (no mesh-act)'; return; }
  local led; led="$(cue_led)"
  [ -n "$led" ] || { printf 'cue n/a (no local LED on this node)'; return; }
  if mesh-act led-host "$led" flash "${MESH_SAY_CUE_SECS:-4}" >/dev/null 2>&1; then
    printf 'cue ok (mesh-act led-host %s flash)' "$led"
  else
    printf 'cue FAILED (mesh-act led-host %s — write path refused)' "$led"
  fi
}

if [ "${1:-}" = --test ]; then
  command -v id >/dev/null 2>&1 || { echo "smoke-test: FAIL (no id)"; exit 1; }
  # TEST-SANDBOX gate: a speak attempted under MESH_TEST_SANDBOX=1 must be SUPPRESSED (exit 0, no
  # sound, no SSH) — the doctor smoke sweep exports it so a leaking child --test can't talk in the
  # room (the 2026-06-19 spoken-"test connectivity" class). Safe to exercise: the gate exits before
  # any TTS engine or remote hop.
  _sup="$(MESH_TEST_SANDBOX=1 "$0" "sandbox probe — must never be spoken" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_sup" | grep -q 'SUPPRESSED'; } \
    || { echo "smoke-test: FAIL (MESH_TEST_SANDBOX gate broken: rc=$_rc out='$_sup')"; exit 1; }
  found=0
  if [ -x "$HOME/.local/bin/mesh-tts" ] && [ -x "$HOME/.mesh/piper/piper/piper" ]; then
    "$HOME/.local/bin/mesh-tts" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-tts test failed)"; exit 1; }
    found=1
  fi
  if command -v spd-say >/dev/null 2>&1; then
    # Verify speech-dispatcher is reachable WITHOUT speaking. A smoke test must NEVER make sound in a
    # shared room: the old `spd-say -o null "test connectivity"` actually SPOKE it aloud here, because
    # this node's speech-dispatcher has no 'null' output module (only espeak-ng/dummy/openjtalk) so
    # -o null fell back to espeak-ng → the room heard "test connectivity" on EVERY smoke run, every
    # few minutes (operator 2026-06-19 — the real injector; mesh-converse only echoed it via the mic).
    # Listing the output modules round-trips to the daemon (proves reachability) and synthesizes
    # NOTHING; fall back to a plain daemon-liveness check. No positional text → it can never speak.
    if XDG_RUNTIME_DIR="/run/user/$(id -u)" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" \
         timeout 5 spd-say -O >/dev/null 2>&1 || pgrep -x speech-dispatcher >/dev/null 2>&1; then
      found=1
    else
      echo "smoke-test: FAIL (spd-say cannot reach speech-dispatcher)"; exit 1
    fi
  fi
  if command -v espeak-ng >/dev/null 2>&1; then
    # Verify espeak-ng produces a valid WAV, not just the binary exists
    wav="$(mktemp /tmp/mesh-say-test.XXXXXX.wav)"
    if timeout 10 espeak-ng -w "$wav" "test" 2>/dev/null; then
      sz=$(stat -c%s "$wav" 2>/dev/null || echo 0)
      [ "$sz" -gt 1000 ] || { echo "smoke-test: FAIL (espeak-ng produced ${sz}B WAV, expected >1KB)"; rm -f "$wav"; exit 1; }
    else
      rm -f "$wav"; echo "smoke-test: FAIL (espeak-ng run failed)"; exit 1
    fi
    rm -f "$wav"
    found=1
  fi
  [ "$found" = 0 ] && { echo "smoke-test: FAIL (no TTS engine — spd-say/espeak-ng/mesh-tts+piper)"; exit 1; }
  # --deliver routing is TWO axes (2026-07-24): OCCUPIED *and* audibility PROVEN → speak locally;
  # every other combination → reroute to voice-tx, so a must-deliver line is never lost to an empty
  # room NOR to a speaker that cannot be heard. Both axes asserted at BOTH edges.
  [ "$(deliver_route OCCUPIED PROVEN)" = speak ]    || { echo "smoke-test: FAIL (deliver_route OCCUPIED+PROVEN→speak)"; exit 1; }
  [ "$(deliver_route VACANT PROVEN)"   = reroute ]  || { echo "smoke-test: FAIL (deliver_route VACANT+PROVEN→reroute)"; exit 1; }
  [ "$(deliver_route RECENT PROVEN)"   = reroute ]  || { echo "smoke-test: FAIL (deliver_route RECENT+PROVEN→reroute)"; exit 1; }
  [ "$(deliver_route UNKNOWN PROVEN)"  = reroute ]  || { echo "smoke-test: FAIL (deliver_route UNKNOWN+PROVEN→reroute)"; exit 1; }
  # THE REGRESSION THIS CLOSES: an occupied room whose voice is not provably audible must NOT speak.
  # This is mesh-home's live state (sole sink = S/PDIF, no acoustic proof) and it silently lost every
  # must-deliver line. UNKNOWN must route around the voice — treating it as "probably fine" IS the bug.
  [ "$(deliver_route OCCUPIED UNKNOWN)" = reroute ] || { echo "smoke-test: FAIL (OCCUPIED+UNKNOWN audibility MUST reroute — the silent-loss regression)"; exit 1; }
  [ "$(deliver_route OCCUPIED NO)"      = reroute ] || { echo "smoke-test: FAIL (OCCUPIED+NO audibility MUST reroute)"; exit 1; }
  # a missing 2nd arg must default to the SAFE side, never to speak (an old 1-arg caller must not
  # silently re-open the hole it was fixed to close)
  [ "$(deliver_route OCCUPIED)" = reroute ] || { echo "smoke-test: FAIL (deliver_route with no audibility arg must default to reroute)"; exit 1; }
  # occupancy override hook + fail-open honest-fusion (room-trace unreachable → UNKNOWN, never OCCUPIED)
  [ "$(MESH_SAY_OCC=OCCUPIED deliver_occupancy)" = OCCUPIED ] || { echo "smoke-test: FAIL (occ override)"; exit 1; }
  [ "$(PATH=/nonexistent deliver_occupancy)" = UNKNOWN ]      || { echo "smoke-test: FAIL (occ fail-open→UNKNOWN)"; exit 1; }
  # audibility axis: override hook + the same fail-toward-reroute honesty when mesh-audible is absent
  [ "$(MESH_SAY_AUD=PROVEN deliver_audible)" = PROVEN ] || { echo "smoke-test: FAIL (aud override)"; exit 1; }
  [ "$(PATH=/nonexistent deliver_audible)" = UNKNOWN ]  || { echo "smoke-test: FAIL (aud fail-safe→UNKNOWN when mesh-audible absent)"; exit 1; }
  # and the live sense must answer inside the contract (it is consulted on every --deliver)
  if command -v mesh-audible >/dev/null 2>&1; then
    case "$(deliver_audible)" in PROVEN|NO|UNKNOWN) ;; *) echo "smoke-test: FAIL (live mesh-audible verdict outside contract)"; exit 1 ;; esac
  fi
  # REFUSE-ON-NO, asserted by BEHAVIOUR (a real invocation), not by grepping our own source. Both
  # directions, because a refusal that also fires on UNKNOWN would mute every honest-unknown node:
  #   NO      → nonzero, and NOT SPOKEN (the refusal is above the engine, so this stays silent)
  #   UNKNOWN → 0, spoken, honestly labelled (the common case; must not regress to a refusal)
  # Watched fail: with the `_aud = NO` branch deleted, leg 1 returns 0 and the assert goes red.
  # A scratch HOME is what keeps this SILENT and keeps it from forging its own evidence: the local
  # engines and mesh-trace are reached by absolute $HOME/.local/bin paths, so an empty HOME means the
  # force leg finds no TTS (announces, then dies at "no TTS on this node" — reached the engine without
  # making a sound) and neither leg can write a "say REFUSED" row into the real trace a human reads.
  # The scratch PATH must still be able to START bash (a bare PATH=/nonexistent makes /usr/bin/env
  # fail and every assertion below then matches on "env: bash: No such file", i.e. green-by-accident
  # on a script that never ran). So: symlink in the interpreter and the few coreutils this path
  # touches, and nothing else — no spd-say, no espeak-ng, so the force leg cannot make a sound even
  # on a node that has them. This node has neither, which is exactly why an absent-engine assumption
  # here would be untested everywhere else.
  _sh="$(mktemp -d /tmp/mesh-say-test-XXXXXX)"; mkdir -p "$_sh/bin"
  for _b in env bash touch id rm hostname; do
    _p="$(command -v "$_b" 2>/dev/null)" && ln -sf "$_p" "$_sh/bin/$_b"
  done
  _rout="$(HOME="$_sh" PATH="$_sh/bin" MESH_SAY_AUD=NO "$0" 'smoke-test refusal' 2>&1)"; _rrc=$?
  [ "$_rrc" != 0 ] || { rm -rf "$_sh"; echo "smoke-test: FAIL (audibility NO must REFUSE nonzero, got rc=0: $_rout)"; exit 1; }
  printf '%s' "$_rout" | grep -q 'REFUSED' || { rm -rf "$_sh"; echo "smoke-test: FAIL (NO refusal must say REFUSED, got: $_rout)"; exit 1; }
  printf '%s' "$_rout" | grep -q 'Not synthesized' || { rm -rf "$_sh"; echo "smoke-test: FAIL (NO refusal must state it did not synthesize, got: $_rout)"; exit 1; }
  # it must refuse BEFORE the engine, so the no-TTS error must NOT appear — that is what "not synthesized" means
  printf '%s' "$_rout" | grep -q 'no TTS on this node' && { rm -rf "$_sh"; echo "smoke-test: FAIL (NO refusal reached the engine — refusal is below the TTS dispatch)"; exit 1; }
  # and the escape hatch must be REACHABLE and LOUD — an unusable hatch is the same as none
  _fout="$(HOME="$_sh" PATH="$_sh/bin" MESH_SAY_AUD=NO MESH_SAY_FORCE=1 "$0" 'smoke-test force' 2>&1)"
  printf '%s' "$_fout" | grep -q 'MESH_SAY_FORCE=1' || { echo "smoke-test: FAIL (force hatch must announce itself, got: $_fout)"; exit 1; }
  printf '%s' "$_fout" | grep -q 'REFUSED' && { echo "smoke-test: FAIL (force hatch still refused: $_fout)"; exit 1; }
  printf '%s' "$_fout" | grep -q 'no TTS on this node' || { echo "smoke-test: FAIL (force hatch did not reach the engine dispatch, got: $_fout)"; exit 1; }
  # THE INVERSE, and it matters more than the refusal: UNKNOWN is absence of evidence, not evidence of
  # absence. A refusal that widens to UNKNOWN mutes every node with a real sink and no acoustic proof —
  # which, per mesh-audible's own contract, is the COMMON case. So UNKNOWN must still reach the engine.
  _uout="$(HOME="$_sh" PATH="$_sh/bin" MESH_SAY_AUD=UNKNOWN "$0" 'smoke-test unknown' 2>&1)"
  printf '%s' "$_uout" | grep -q 'REFUSED' && { echo "smoke-test: FAIL (UNKNOWN must NOT refuse — absence of evidence is not evidence of absence: $_uout)"; exit 1; }
  printf '%s' "$_uout" | grep -q 'no TTS on this node' || { rm -rf "$_sh"; echo "smoke-test: FAIL (UNKNOWN did not reach the engine dispatch, got: $_uout)"; exit 1; }
  rm -rf "$_sh"

  # The mesh-act cue must resolve a REAL LED from the node's own inventory, never mesh-act's default
  # target: `scrolllock` is absent on a headless node, so `led-host flash` rc=1 and nothing actuates
  # while mesh-act --test stays green. Assert the resolved name is one this node actually reports.
  if command -v mesh-act >/dev/null 2>&1; then
    _cl="$(cue_led)"
    if [ -n "$_cl" ]; then
      mesh-act led-host list 2>/dev/null | awk '{print $1}' | grep -qxF "$_cl" \
        || { echo "smoke-test: FAIL (cue_led resolved '$_cl', not in this node's led-host inventory)"; exit 1; }
      [ "$_cl" = scrolllock ] || [ -e "/sys/class/leds/$_cl" ] \
        || { echo "smoke-test: FAIL (cue_led '$_cl' has no /sys/class/leds entry)"; exit 1; }
    fi
    # and the override must win, so a node can pin a deliberate alert LED
    [ "$(MESH_SAY_CUE_LED=probe-led cue_led)" = probe-led ] || { echo "smoke-test: FAIL (MESH_SAY_CUE_LED override ignored)"; exit 1; }
  fi
  # END-TO-END through the real dispatch (dry-run: no sound, no send, no cue): the injected axes must
  # produce the routing decision the unit assertions above promise. Guards the wiring, not just the
  # predicate — a correct deliver_route called with the wrong arguments is still the old bug.
  _d="$(MESH_SAY_DELIVER_DRYRUN=1 MESH_SAY_OCC=OCCUPIED MESH_SAY_AUD=UNKNOWN "$0" --deliver probe 2>&1)"
  printf '%s' "$_d" | grep -q 'route=reroute' || { echo "smoke-test: FAIL (dispatch: OCCUPIED+UNKNOWN did not reroute: $_d)"; exit 1; }
  _d="$(MESH_SAY_DELIVER_DRYRUN=1 MESH_SAY_OCC=OCCUPIED MESH_SAY_AUD=PROVEN "$0" --deliver probe 2>&1)"
  printf '%s' "$_d" | grep -q 'route=speak' || { echo "smoke-test: FAIL (dispatch: OCCUPIED+PROVEN did not speak: $_d)"; exit 1; }
  # self-speech marker contract (interactional-asymmetry fix, 2026-07-07): mesh-say hardcodes
  # $HOME/.mesh/mesh-speaking to match mesh-overhear's MUTE_FLAG=dirname(OH_LOG)/mesh-speaking
  # (OH_LOG defaults to $MESH/overheard.log) — a rename on either side silently reopens the gap
  # (mesh's own voice self-heard as room speech), so assert both literals directly from source.
  grep -q '_MUTE="\$HOME/\.mesh/mesh-speaking"' "$0" \
    || { echo "smoke-test: FAIL (self-speech marker path missing/renamed in mesh-say)"; exit 1; }
  _ohfile="$(dirname "$0")/mesh-overhear"
  if [ -f "$_ohfile" ]; then
    grep -q 'MUTE_FLAG=os\.path\.join(os\.path\.dirname(LOGF),"mesh-speaking")' "$_ohfile" \
      || { echo "smoke-test: FAIL (mesh-overhear's MUTE_FLAG contract drifted from mesh-say's \$HOME/.mesh/mesh-speaking assumption)"; exit 1; }
    grep -q 'OH_LOG="\${OH_LOG:-\$MESH/overheard\.log}"' "$_ohfile" \
      || { echo "smoke-test: FAIL (mesh-overhear's OH_LOG default drifted — mesh-speaking would no longer resolve under \$HOME/.mesh)"; exit 1; }
  fi
  echo "smoke-test: ok (+ MESH_TEST_SANDBOX speak-suppression gate + 9 --deliver occupancy×audibility route assertions + 2 dispatch dry-runs + cue-LED inventory resolution + self-speech marker contract)"; exit 0
fi

# TEST-SANDBOX gate (extends chat-review/doctor-smoke-sandbox-net, 2026-07-02): MESH_TEST_SANDBOX=1
# marks a smoke-sweep context (mesh-doctor exports it around every child --test) — NEVER actuate the
# voice from it: the local speaker, --phone TTS and --mac say are all real room/world side-effects
# (the 2026-06-19 room-heard-"test-connectivity" incident is this exact leak class). Placed before
# ANY branch so all three paths are covered. Suppressed = exit 0 (intentionally not spoken).
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  echo "mesh-say: MESH_TEST_SANDBOX — speak SUPPRESSED (smoke-sweep context): ${*:-}" >&2
  exit 0
fi

# --phone: route the mesh's VOICE to the phone body. termux-tts-speak works even on Play-Store Termux
# (verified 2026-06-12 — location is blocked there, but TTS+camera work). Registry-resolved; message
# piped via stdin so any text is safe across the double shell hop.
if [ "${1:-}" = --phone ]; then
  shift; PMSG="$*"; [ -z "${PMSG// /}" ] && { echo "usage: mesh-say --phone <text>" >&2; exit 1; }
  [ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "mesh-say --phone: phone unreachable (all IPs tried)" >&2; exit 2; }
  if printf '%s' "$PMSG" | timeout 20 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a380}@$pip" 'termux-tts-speak "$(cat)"' 2>/dev/null; then
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "said on phone: $PMSG" >/dev/null 2>&1 || true
    echo "spoke on phone: $PMSG"; exit 0
  else echo "mesh-say --phone: phone TTS failed (phone reachable + Termux running?)" >&2; exit 1; fi
fi
# --mac: route the mesh's VOICE to the iMac-Rozalia (macOS say command over SSH).
# Wireable immediately — no deps, no install (capability-gaps-mac-2026-06-16).
# Tries direct SSH first (IdeaPad LAN); falls back to chain via IdeaPad TS IP
# for nodes (like phaedra) that can't reach 192.168.8.0/24.
if [ "${1:-}" = --mac ]; then
  shift; MSG="$*"; [ -z "${MSG// /}" ] && { echo "usage: mesh-say --mac <text>" >&2; exit 1; }
  MAC_IP="$(mesh-peer-addr mac 2>/dev/null || echo 192.168.8.214)"
  MAC_HOST="ilya@${MAC_IP}"
  # own Tailscale IP for the relay chain — resolved at RUNTIME (canonical `tailscale ip -4`, legacy
  # --self parse as secondary). NO hardcoded node IP: the genome is node-agnostic ("plantable on any
  # node"); the per-node relay is configured explicitly via MESH_SAY_MAC_CHAIN. If both resolutions
  # are empty (tailscale down), the chain is skipped honestly rather than dialing a fabricated IP.
  CHAIN_IP="$(tailscale ip -4 2>/dev/null | head -1)"
  CHAIN_IP="${CHAIN_IP:-$(tailscale status --self 2>/dev/null | awk 'NR==1{print $1}')}"
  MAC_CHAIN="${MESH_SAY_MAC_CHAIN:-$(whoami)@${CHAIN_IP}}"
  say_ok=0
  # try direct (IdeaPad LAN)
  if timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=4 "$MAC_HOST" 'echo ok' </dev/null 2>/dev/null; then
    printf '%s' "$MSG" | timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=6 "$MAC_HOST" 'say "$(cat)"' 2>/dev/null && say_ok=1
  fi
  # fallback chain: via IdeaPad (has SSH key for mac)
  if [ "$say_ok" = 0 ]; then
    if printf '%s' "$MSG" | timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=8 "$MAC_CHAIN" \
      "cat | ssh -o StrictHostKeyChecking=accept-new ilya@${MAC_IP} 'say \"\$(cat)\"'" 2>/dev/null; then
      say_ok=1
    fi
  fi
  if [ "$say_ok" = 1 ]; then
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "said on mac: $MSG" >/dev/null 2>&1 || true
    echo "spoke on mac: $MSG"; exit 0
  fi
  echo "mesh-say --mac: mac TTS failed (direct+chain both tried)" >&2; exit 1
fi
DELIVER=0
if [ "${1:-}" = --deliver ]; then DELIVER=1; shift; fi
MSG="$*"
[ -z "${MSG// /}" ] && { echo "usage: mesh-say [--deliver] <text>" >&2; exit 1; }

# --deliver: occupancy-adaptive, loss-free delivery of a MUST-DELIVER line (fuse mesh-room-trace).
# OCCUPIED → fall through and speak aloud locally (the room hears it); anything else → reroute to the
# operator's Telegram via mesh-voice-tx so the line is never dropped into an empty room.
if [ "$DELIVER" = 1 ]; then
  _occ="$(deliver_occupancy)"; _aud="$(deliver_audible)"; _route="$(deliver_route "$_occ" "$_aud")"
  # dry-run hook (manual/ops verification only — no sound, no send): print the decision and stop.
  if [ "${MESH_SAY_DELIVER_DRYRUN:-0}" = 1 ]; then echo "deliver: occ=$_occ aud=$_aud route=$_route: $MSG"; exit 0; fi
  if [ "$_route" = reroute ]; then
    # Occupied-but-inaudible is the case worth a physical cue: a person IS in the room and the line is
    # about to leave it. Fire the verifiable actuator, then reroute.
    _cue=""
    if [ "$_occ" = OCCUPIED ] && [ "$_aud" != PROVEN ]; then _cue=" · $(deliver_cue)"; fi
    if command -v mesh-voice-tx >/dev/null 2>&1; then
      mesh-voice-tx "$MSG" && { echo "delivered via voice-tx (room $_occ, audibility $_aud)$_cue: $MSG"; exit 0; }
      echo "mesh-say --deliver: voice-tx reroute failed (room $_occ, audibility $_aud)$_cue" >&2; exit 1
    fi
    echo "mesh-say --deliver: room $_occ / audibility $_aud but mesh-voice-tx unavailable — cannot guarantee delivery$_cue" >&2; exit 2
  fi
  # _route=speak (OCCUPIED and audibility PROVEN) → fall through to the local speak path below.
fi

# REFUSE ON A PROVEN-DEAD OUTPUT (2026-08-14, task alc897-sink-claim-gap). Reporting honestly is not
# the same as refusing: this path used to synthesize into `Default Sink: auto_null`, print "synthesized,
# audibility NO", and exit 0 — so every rc-checking caller (and every reflex that only looks at the exit
# code) read a line nobody could have heard as a success. That is the silent-fallback shape at the
# OUTPUT end, and mesh-home sat in it: wireplumber never claimed the only card with analog playback, so
# the node's sole sink was the null placeholder while mesh-say kept returning 0.
#
# NO and UNKNOWN are NOT the same claim and must not share a branch. NO is POSITIVE evidence that
# nothing can emit — there is no real sink at all — so speaking is not best-effort, it is writing to
# /dev/null; we refuse BEFORE synthesizing (no point spending a TTS run on it) and exit nonzero so the
# caller reroutes. UNKNOWN is ABSENCE of evidence (a sink exists, the amp is unknowable) and keeps the
# old behaviour: speak, report honestly, exit 0 — fail toward a delivered line, never toward silence.
#
# MESH_SAY_FORCE=1 speaks anyway, and says LOUDLY on stderr that it is doing so. It exists for bringing
# an output path back up (you must be able to drive audio at a sink the sense still calls dead), not as
# a way for a caller to opt out of the verdict — it never upgrades what gets reported or traced.
_aud="${_aud:-$(deliver_audible)}"
if [ "$_aud" = NO ]; then
  if [ "${MESH_SAY_FORCE:-}" = 1 ]; then
    echo "mesh-say: audibility NO (no real sink — mesh-audible --why) but MESH_SAY_FORCE=1 — speaking into a path proven dead" >&2
  else
    echo "mesh-say: REFUSED — audibility NO: this node has no real sink, so nothing can emit (mesh-audible --why). Not synthesized. Reroute (mesh-say --deliver / mesh-voice-tx / mesh-tg), or MESH_SAY_FORCE=1 to speak anyway: $MSG" >&2
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "say REFUSED (audibility NO — no real sink): $MSG" >/dev/null 2>&1 || true
    exit 3
  fi
fi

# voice gate (operator 2026-06-24): honor the room silence/thermal-auto-mute on the LOCAL speaker.
# --phone/--mac target OTHER devices and exited above; only the local-Bose path is gated here. Fail-OPEN
# (if mesh-voice-gate isn't installed yet, speak — the manual room-voice-off switch is the reliable mute).
if command -v mesh-voice-gate >/dev/null 2>&1; then mesh-voice-gate || { echo "mesh-say: suppressed (voice gate)" >&2; exit 0; }; fi

# self-speech marker (LITERATURE 2026-07-07, interactional-asymmetry gap): mesh-overhear's self/other
# exclusion (MUTE_FLAG=~/.mesh/mesh-speaking, checked by capture_utterance()/_self_playing()) is set by
# ITS OWN internal speak() and by `pgrep pw-play` — but THIS actuator's local engines (mesh-tts →
# aplay/paplay per scripts/mesh-tts:59; spd-say → speech-dispatcher; espeak-ng direct) never spawn
# pw-play and never touch that flag, so mesh-say's narration was invisible to the one mechanism meant
# to stop the mesh mistaking its OWN voice for a person's. Aguilera, Millidge, Tschantz & Buckley's
# "interactional asymmetry" critique of the free energy principle (via Di Paolo's enactivist agency
# conditions) argues a free-energy-minimizing system that can't differentially mark its own causal
# footprint apart from the environment fails a condition for genuine sensorimotor agency — a
# self-generated action collapses into just another correlated observation. Fix: bracket every local
# TTS engine below with the SAME marker mesh-overhear already watches, so a mesh-say narration is
# provably self-caused, not mic-picked-up and misread as room speech. EXIT trap always clears the
# flag even if the engine hangs/errors, so a stuck flag can never permanently mute capture.
_MUTE="$HOME/.mesh/mesh-speaking"
touch "$_MUTE" 2>/dev/null
trap 'rm -f "$_MUTE" 2>/dev/null' EXIT

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

_engine_rc=0
if [ -x "$HOME/.local/bin/mesh-tts" ] && [ -x "$HOME/.mesh/piper/piper/piper" ]; then
    "$HOME/.local/bin/mesh-tts" "${MESH_SAY_VOICE:-ryan}" "$MSG" local || _engine_rc=$?   # natural neural voice
elif command -v spd-say >/dev/null 2>&1; then
    timeout 40 spd-say -w -r -5 "$MSG" || { _engine_rc=$?; echo "(spd-say failed — no reachable audio?)" >&2; }
elif command -v espeak-ng >/dev/null 2>&1; then
    espeak-ng "$MSG" || _engine_rc=$?
else
    echo "(no TTS on this node)" >&2; exit 1
fi
# HONEST REPORTING (2026-07-24). This block used to trace "said aloud" and print "spoke:"
# UNCONDITIONALLY — the engine's rc was discarded, and mesh-tts itself sets played=1 on the
# synthesized WAV's SIZE, never on the player's rc. So a node with no reachable speaker logged a
# clean "said aloud" for a line no one could have heard, and that log is what a human or watchdog
# reads for evidence the voice works. What we can honestly assert is what we did: synthesized, and
# handed it to an output path of KNOWN or UNKNOWN audibility. Only a PROVEN path earns "said aloud".
_aud_now="${_aud:-$(deliver_audible)}"
if [ "$_engine_rc" != 0 ]; then
    echo "mesh-say: TTS engine failed (rc=$_engine_rc) — not spoken: $MSG" >&2
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "say FAILED (engine rc=$_engine_rc): $MSG" >/dev/null 2>&1 || true
    exit 1
fi
if [ "$_aud_now" = PROVEN ]; then
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "said aloud: $MSG" >/dev/null 2>&1 || true
    echo "spoke: $MSG"
else
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "synthesized (audibility $_aud_now, NOT proven heard): $MSG" >/dev/null 2>&1 || true
    echo "synthesized, audibility $_aud_now (not proven heard — mesh-audible --why): $MSG"
fi
