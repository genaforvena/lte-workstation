#!/usr/bin/env bash
# mesh-say — speak a line aloud in the room (the mesh's voice).
#
# For narrating notable work/events when they're worth hearing — not every step,
# just the ones worth saying out loud. Speaks on THIS node via spd-say (reaching the
# desktop audio session), and leaves a light mark in the trace.
#
#   mesh-say "the egress fix is live and verified"     speak on THIS node
#   mesh-say --phone "text"                            speak on the phone body (termux-tts-speak/SSH)
#   mesh-say --mac "text"                             speak on iMac-Rozalia (macOS say/SSH)
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v id >/dev/null 2>&1 || { echo "smoke-test: FAIL (no id)"; exit 1; }
  # TEST-SANDBOX gate: a speak attempted under MESH_TEST_SANDBOX=1 must be SUPPRESSED (exit 0, no
  # sound, no SSH) — the doctor smoke sweep exports it so a leaking child --test can't talk in the
  # room (the 2026-06-19 spoken-"test connectivity" class). Safe to exercise: the gate exits before
  # any TTS engine or remote hop.
  _sup="$(MESH_TEST_SANDBOX=1 "$0" "sandbox probe — must never be spoken" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_sup" | grep -q 'SUPPRESSED'; } \
    || { echo "smoke-test: FAIL (MESH_TEST_SANDBOX gate broken: rc=$_rc out='$_sup')"; exit 1; }
  found=0
  if [ -x "$HOME/.local/bin/mesh-tts" ] && [ -x "$HOME/.mesh/piper/piper/piper" ]; then
    "$HOME/.local/bin/mesh-tts" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-tts test failed)"; exit 1; }
    found=1
  fi
  if command -v spd-say >/dev/null 2>&1; then
    # Verify speech-dispatcher is reachable WITHOUT speaking. A smoke test must NEVER make sound in a
    # shared room: the old `spd-say -o null "test connectivity"` actually SPOKE it aloud here, because
    # this node's speech-dispatcher has no 'null' output module (only espeak-ng/dummy/openjtalk) so
    # -o null fell back to espeak-ng → the room heard "test connectivity" on EVERY smoke run, every
    # few minutes (operator 2026-06-19 — the real injector; mesh-converse only echoed it via the mic).
    # Listing the output modules round-trips to the daemon (proves reachability) and synthesizes
    # NOTHING; fall back to a plain daemon-liveness check. No positional text → it can never speak.
    if XDG_RUNTIME_DIR="/run/user/$(id -u)" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" \
         timeout 5 spd-say -O >/dev/null 2>&1 || pgrep -x speech-dispatcher >/dev/null 2>&1; then
      found=1
    else
      echo "smoke-test: FAIL (spd-say cannot reach speech-dispatcher)"; exit 1
    fi
  fi
  if command -v espeak-ng >/dev/null 2>&1; then
    # Verify espeak-ng produces a valid WAV, not just the binary exists
    wav="$(mktemp /tmp/mesh-say-test.XXXXXX.wav)"
    if timeout 10 espeak-ng -w "$wav" "test" 2>/dev/null; then
      sz=$(stat -c%s "$wav" 2>/dev/null || echo 0)
      [ "$sz" -gt 1000 ] || { echo "smoke-test: FAIL (espeak-ng produced ${sz}B WAV, expected >1KB)"; rm -f "$wav"; exit 1; }
    else
      rm -f "$wav"; echo "smoke-test: FAIL (espeak-ng run failed)"; exit 1
    fi
    rm -f "$wav"
    found=1
  fi
  [ "$found" = 0 ] && { echo "smoke-test: FAIL (no TTS engine — spd-say/espeak-ng/mesh-tts+piper)"; exit 1; }
  echo "smoke-test: ok (+ MESH_TEST_SANDBOX speak-suppression gate)"; exit 0
fi

# TEST-SANDBOX gate (extends chat-review/doctor-smoke-sandbox-net, 2026-07-02): MESH_TEST_SANDBOX=1
# marks a smoke-sweep context (mesh-doctor exports it around every child --test) — NEVER actuate the
# voice from it: the local speaker, --phone TTS and --mac say are all real room/world side-effects
# (the 2026-06-19 room-heard-"test-connectivity" incident is this exact leak class). Placed before
# ANY branch so all three paths are covered. Suppressed = exit 0 (intentionally not spoken).
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  echo "mesh-say: MESH_TEST_SANDBOX — speak SUPPRESSED (smoke-sweep context): ${*:-}" >&2
  exit 0
fi

# --phone: route the mesh's VOICE to the phone body. termux-tts-speak works even on Play-Store Termux
# (verified 2026-06-12 — location is blocked there, but TTS+camera work). Registry-resolved; message
# piped via stdin so any text is safe across the double shell hop.
if [ "${1:-}" = --phone ]; then
  shift; PMSG="$*"; [ -z "${PMSG// /}" ] && { echo "usage: mesh-say --phone <text>" >&2; exit 1; }
  [ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "mesh-say --phone: phone unreachable (all IPs tried)" >&2; exit 2; }
  if printf '%s' "$PMSG" | timeout 20 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a380}@$pip" 'termux-tts-speak "$(cat)"' 2>/dev/null; then
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "said on phone: $PMSG" >/dev/null 2>&1 || true
    echo "spoke on phone: $PMSG"; exit 0
  else echo "mesh-say --phone: phone TTS failed (phone reachable + Termux running?)" >&2; exit 1; fi
fi
# --mac: route the mesh's VOICE to the iMac-Rozalia (macOS say command over SSH).
# Wireable immediately — no deps, no install (capability-gaps-mac-2026-06-16).
# Tries direct SSH first (IdeaPad LAN); falls back to chain via IdeaPad TS IP
# for nodes (like phaedra) that can't reach 192.168.8.0/24.
if [ "${1:-}" = --mac ]; then
  shift; MSG="$*"; [ -z "${MSG// /}" ] && { echo "usage: mesh-say --mac <text>" >&2; exit 1; }
  MAC_IP="$(mesh-peer-addr mac 2>/dev/null || echo 192.168.8.214)"
  MAC_HOST="ilya@${MAC_IP}"
  # own Tailscale IP for the relay chain — resolved at RUNTIME (canonical `tailscale ip -4`, legacy
  # --self parse as secondary). NO hardcoded node IP: the genome is node-agnostic ("plantable on any
  # node"); the per-node relay is configured explicitly via MESH_SAY_MAC_CHAIN. If both resolutions
  # are empty (tailscale down), the chain is skipped honestly rather than dialing a fabricated IP.
  CHAIN_IP="$(tailscale ip -4 2>/dev/null | head -1)"
  CHAIN_IP="${CHAIN_IP:-$(tailscale status --self 2>/dev/null | awk 'NR==1{print $1}')}"
  MAC_CHAIN="${MESH_SAY_MAC_CHAIN:-$(whoami)@${CHAIN_IP}}"
  say_ok=0
  # try direct (IdeaPad LAN)
  if timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=4 "$MAC_HOST" 'echo ok' </dev/null 2>/dev/null; then
    printf '%s' "$MSG" | timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=6 "$MAC_HOST" 'say "$(cat)"' 2>/dev/null && say_ok=1
  fi
  # fallback chain: via IdeaPad (has SSH key for mac)
  if [ "$say_ok" = 0 ]; then
    if printf '%s' "$MSG" | timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=8 "$MAC_CHAIN" \
      "cat | ssh -o StrictHostKeyChecking=accept-new ilya@${MAC_IP} 'say \"\$(cat)\"'" 2>/dev/null; then
      say_ok=1
    fi
  fi
  if [ "$say_ok" = 1 ]; then
    [ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "said on mac: $MSG" >/dev/null 2>&1 || true
    echo "spoke on mac: $MSG"; exit 0
  fi
  echo "mesh-say --mac: mac TTS failed (direct+chain both tried)" >&2; exit 1
fi
MSG="$*"
[ -z "${MSG// /}" ] && { echo "usage: mesh-say <text>" >&2; exit 1; }

# voice gate (operator 2026-06-24): honor the room silence/thermal-auto-mute on the LOCAL speaker.
# --phone/--mac target OTHER devices and exited above; only the local-Bose path is gated here. Fail-OPEN
# (if mesh-voice-gate isn't installed yet, speak — the manual room-voice-off switch is the reliable mute).
if command -v mesh-voice-gate >/dev/null 2>&1; then mesh-voice-gate || { echo "mesh-say: suppressed (voice gate)" >&2; exit 0; }; fi

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

if [ -x "$HOME/.local/bin/mesh-tts" ] && [ -x "$HOME/.mesh/piper/piper/piper" ]; then
    "$HOME/.local/bin/mesh-tts" "${MESH_SAY_VOICE:-ryan}" "$MSG" local      # natural neural voice
elif command -v spd-say >/dev/null 2>&1; then
    timeout 40 spd-say -w -r -5 "$MSG" || echo "(spd-say failed — no reachable audio?)" >&2
elif command -v espeak-ng >/dev/null 2>&1; then
    espeak-ng "$MSG"
else
    echo "(no TTS on this node)" >&2; exit 1
fi
[ -x "$HOME/.local/bin/mesh-trace" ] && MESH_WHO="mesh-say@$(hostname)" "$HOME/.local/bin/mesh-trace" "said aloud: $MSG" >/dev/null 2>&1 || true
echo "spoke: $MSG"
