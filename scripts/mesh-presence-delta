#!/usr/bin/env bash
# mesh-presence-delta — the FILTER for a presence STREAM (operator's pattern, 2026-06-11).
# Reads a mesh-presence scan on STDIN (rssi|mac|name lines + a header), diffs the set of nearby
# devices against the LAST scan, and emits on STDOUT a prompt-to-feed-a-mind ONLY when something
# ARRIVED or DEPARTED. No change ⇒ emits nothing (the mind isn't engaged). State: presence.prev.
#
# Use as a stream:  mesh-stream presence 'mesh-presence' 'mesh-presence-delta'
#   the cheap reflex scans every cycle; the mind wakes only on an arrival/departure EDGE.
#   mesh-presence-delta --test
set -uo pipefail
PREV="$HOME/.mesh/presence.prev"; mkdir -p "$HOME/.mesh"
[ "${1:-}" = --test ] && { echo "smoke-test: ok"; exit 0; }

# current scan → "mac|name" lines (skip the === header and blanks)
cur="$(grep -E '^[+-]?[0-9]+\|' 2>/dev/null | awk -F'|' 'NF>=3{print $2"|"$3}' | sort -u)"
[ -z "$cur" ] && exit 0   # empty/failed scan → say nothing (don't claim "everyone left")

# first run: seed prev, feed nothing (don't flood the mind with the whole room as "arrivals")
if [ ! -f "$PREV" ]; then printf '%s\n' "$cur" > "$PREV"; exit 0; fi

prev="$(cat "$PREV")"
arrived="$(comm -23 <(printf '%s\n' "$cur") <(printf '%s\n' "$prev"))"
departed="$(comm -13 <(printf '%s\n' "$cur") <(printf '%s\n' "$prev"))"
printf '%s\n' "$cur" > "$PREV"   # advance state every cycle

[ -z "$arrived$departed" ] && exit 0   # no edge → nothing to feed

# shape the prompt (this is the text the mind responds to)
{
  echo "presence change near $(hostname) — react if it matters (e.g. note a known device arriving/leaving; otherwise just acknowledge):"
  [ -n "$arrived"  ] && { echo "ARRIVED:";  printf '%s\n' "$arrived"  | sed 's/^/  + /'; }
  [ -n "$departed" ] && { echo "DEPARTED:"; printf '%s\n' "$departed" | sed 's/^/  - /'; }
}
