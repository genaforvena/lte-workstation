#!/usr/bin/env bash
# mesh-presence-delta — the FILTER for a presence STREAM (operator's pattern, 2026-06-11).
# Reads a mesh-presence scan on STDIN (rssi|mac|name lines + a header), diffs the set of nearby
# devices against the LAST *confirmed* scan, and emits on STDOUT a prompt-to-feed-a-mind ONLY when
# something ARRIVED or DEPARTED. No change ⇒ emits nothing (the mind isn't engaged). State: presence.prev.
#
# SIGN-VS-NOISE DEBOUNCE (biosemiotics literature landing, 2026-07-09): Ay & Löhr's formal
# "sensory equivalence" Umwelt definition (arXiv:1603.08389) says two world-states are the SAME
# to an agent iff they yield statistically indistinguishable sensor-output distributions under
# REPEATED probing — a distinction only counts as real if it survives more than one readout.
# Applied here: a single-scan MAC flip (BLE dropout / RSSI fade at the detection boundary) is
# treated as the SAME equivalence class as "still there" until it repeats — only a candidate that
# persists MESH_PRESENCE_DELTA_K consecutive scans crosses into a genuinely new class and fires
# ARRIVED/DEPARTED. A flicker that reverses before reaching K collapses silently (no sign emitted,
# counter reset) — this is the operational mechanism, not just "debounce" folklore: the threshold
# IS the equivalence-class boundary. State: presence.pending (per-mac candidate direction + count).
#
# Use as a stream:  mesh-stream presence 'mesh-presence' 'mesh-presence-delta'
#   the cheap reflex scans every cycle; the mind wakes only on a CONFIRMED arrival/departure edge.
#   MESH_PRESENCE_DELTA_K=1 recovers the old fire-on-first-diff behavior (no debounce).
#   mesh-presence-delta --test
set -uo pipefail
PREV="$HOME/.mesh/presence.prev"
PENDING="$HOME/.mesh/presence.pending"
K="${MESH_PRESENCE_DELTA_K:-2}"

[ "${1:-}" = --test ] && {
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v awk    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v sort   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sort)"; exit 1; }
  command -v comm   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no comm)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh" || { echo "smoke-test: FAIL (no temp mesh dir)"; exit 1; }
  cat > "$tmp/.mesh/presence.prev" <<'EOF'
AA:AA:AA:AA:AA:AA|OldDevice
BB:BB:BB:BB:BB:BB|StayDevice
EOF
  scan="$(printf '%s\n' \
    '=== mesh-presence ===' \
    '-55|BB:BB:BB:BB:BB:BB|StayDevice' \
    '-44|CC:CC:CC:CC:CC:CC|NewDevice')"

  # cycle 1: first sighting of the diff is a CANDIDATE only — must stay silent (not yet a
  # confirmed sign; single readout ≡ same equivalence class as "no change" per the K-gate)
  out1="$(printf '%s\n' "$scan" | HOME="$tmp" "$0" 2>&1)" || { echo "smoke-test: FAIL (cycle1 failed: $out1)"; exit 1; }
  [ -z "$out1" ] || { echo "smoke-test: FAIL (cycle1 should stay silent, candidate not yet confirmed: got '$out1')"; exit 1; }

  # cycle 2: same diff repeats → candidate crosses K=2 → confirmed sign fires
  out2="$(printf '%s\n' "$scan" | HOME="$tmp" "$0" 2>&1)" || { echo "smoke-test: FAIL (cycle2 failed: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q '^ARRIVED:' || { echo "smoke-test: FAIL (missing ARRIVED block after confirm: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q '^DEPARTED:' || { echo "smoke-test: FAIL (missing DEPARTED block after confirm: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q 'CC:CC:CC:CC:CC:CC|NewDevice' || { echo "smoke-test: FAIL (missing arrival detail: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q 'AA:AA:AA:AA:AA:AA|OldDevice' || { echo "smoke-test: FAIL (missing departure detail: $out2)"; exit 1; }

  # flicker case: a candidate that reverses before K must reset to zero, not accumulate across
  # the gap — proves the mechanism is equivalence-class collapse, not a leaky counter
  tmp2="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp2 failed)"; exit 1; }
  mkdir -p "$tmp2/.mesh"
  cat > "$tmp2/.mesh/presence.prev" <<'EOF'
BB:BB:BB:BB:BB:BB|StayDevice
DD:DD:DD:DD:DD:DD|FlickerDevice
EOF
  gone="$(printf '%s\n' '=== mesh-presence ===' '-55|BB:BB:BB:BB:BB:BB|StayDevice')"
  back="$(printf '%s\n' '=== mesh-presence ===' '-55|BB:BB:BB:BB:BB:BB|StayDevice' '-60|DD:DD:DD:DD:DD:DD|FlickerDevice')"
  fa="$(printf '%s\n' "$gone" | HOME="$tmp2" "$0" 2>&1)"   # cycle A: candidate departure, cnt=1, silent
  [ -z "$fa" ] || { echo "smoke-test: FAIL (flicker cycleA should stay silent: got '$fa')"; exit 1; }
  fb="$(printf '%s\n' "$back" | HOME="$tmp2" "$0" 2>&1)"   # cycle B: flicker returns → collapse, silent
  [ -z "$fb" ] || { echo "smoke-test: FAIL (flicker cycleB should collapse silently: got '$fb')"; exit 1; }
  fc="$(printf '%s\n' "$gone" | HOME="$tmp2" "$0" 2>&1)"   # cycle C: departs again → fresh cnt=1 (NOT cnt=2), still silent
  [ -z "$fc" ] || { echo "smoke-test: FAIL (flicker cycleC should be a fresh candidate, not pre-confirmed: got '$fc')"; exit 1; }
  fd="$(printf '%s\n' "$gone" | HOME="$tmp2" "$0" 2>&1)"   # cycle D: confirms → fires now
  printf '%s\n' "$fd" | grep -q '^DEPARTED:' || { echo "smoke-test: FAIL (flicker should still confirm on a real 2-cycle absence: $fd)"; exit 1; }

  # MESH_PRESENCE_DELTA_K=1 recovers old immediate-fire behavior
  tmp3="$(mktemp -d)"; mkdir -p "$tmp3/.mesh"
  cat > "$tmp3/.mesh/presence.prev" <<'EOF'
BB:BB:BB:BB:BB:BB|StayDevice
EOF
  k1="$(printf '%s\n' "$scan" | HOME="$tmp3" MESH_PRESENCE_DELTA_K=1 "$0" 2>&1)"
  printf '%s\n' "$k1" | grep -q '^ARRIVED:' || { echo "smoke-test: FAIL (K=1 should fire immediately: $k1)"; exit 1; }

  echo "smoke-test: ok"; exit 0
}
mkdir -p "$HOME/.mesh"
[ -f "$PENDING" ] || : > "$PENDING"

# current scan → "mac|name" lines (skip the === header and blanks)
cur="$(grep -E '^[+-]?[0-9]+\|' 2>/dev/null | awk -F'|' 'NF>=3{print $2"|"$3}' | sort -u)"
[ -z "$cur" ] && exit 0   # empty/failed scan → say nothing (don't claim "everyone left")

# first run: seed prev, feed nothing (don't flood the mind with the whole room as "arrivals")
if [ ! -f "$PREV" ]; then printf '%s\n' "$cur" > "$PREV"; : > "$PENDING"; exit 0; fi

prev="$(cat "$PREV")"
raw_arrived="$(comm -23 <(printf '%s\n' "$cur") <(printf '%s\n' "$prev"))"
raw_departed="$(comm -13 <(printf '%s\n' "$cur") <(printf '%s\n' "$prev"))"

# Equivalence-class gate: a raw diff only becomes a CONFIRMED sign once the same candidate
# direction repeats K times in a row. A candidate absent from THIS cycle's raw lists (it went
# back to matching prev) is dropped from pending — silent collapse, no leaked counter.
gate_out="$( {
  cat "$PENDING" | sed 's/^/P|/'
  printf '%s\n' "$raw_arrived"  | grep -v '^$' | sed 's/^/A|/'
  printf '%s\n' "$raw_departed" | grep -v '^$' | sed 's/^/D|/'
} | awk -F'|' -v K="$K" '
  $1=="P" { pend[$2] = $3"|"$4"|"$5 }
  $1=="A" { arr[$2] = $3 }
  $1=="D" { dep[$2] = $3 }
  END {
    for (mac in arr) {
      name = arr[mac]; cnt = 1
      if (mac in pend) { split(pend[mac], p, "|"); if (p[2]=="ARR") cnt = p[3] + 1 }
      if (cnt >= K) print "CONFIRMED_ARR|" mac "|" name
      else          print "PEND|" mac "|" name "|ARR|" cnt
      delete pend[mac]
    }
    for (mac in dep) {
      name = dep[mac]; cnt = 1
      if (mac in pend) { split(pend[mac], p, "|"); if (p[2]=="DEP") cnt = p[3] + 1 }
      if (cnt >= K) print "CONFIRMED_DEP|" mac "|" name
      else          print "PEND|" mac "|" name "|DEP|" cnt
      delete pend[mac]
    }
    # anything left in pend was not a candidate this cycle → collapsed back to prev, drop silently
  }
' )"

confirmed_arrived="$(printf '%s\n' "$gate_out" | awk -F'|' '$1=="CONFIRMED_ARR"{print $2"|"$3}')"
confirmed_departed="$(printf '%s\n' "$gate_out" | awk -F'|' '$1=="CONFIRMED_DEP"{print $2"|"$3}')"
printf '%s\n' "$gate_out" | awk -F'|' '$1=="PEND"{print $2"|"$3"|"$4"|"$5}' > "$PENDING"

# advance confirmed state: prev ∪ confirmed_arrived − confirmed_departed
{ printf '%s\n' "$prev"; printf '%s\n' "$confirmed_arrived"; } \
  | grep -v '^$' | sort -u \
  | comm -23 - <(printf '%s\n' "$confirmed_departed" | grep -v '^$' | sort -u) \
  > "$PREV"

[ -z "$confirmed_arrived$confirmed_departed" ] && exit 0   # nothing crossed the sign threshold this cycle

# shape the prompt (this is the text the mind responds to)
{
  echo "presence change near $(hostname) — react if it matters (e.g. note a known device arriving/leaving; otherwise just acknowledge):"
  [ -n "$confirmed_arrived"  ] && { echo "ARRIVED:";  printf '%s\n' "$confirmed_arrived"  | sed 's/^/  + /'; } || true
  [ -n "$confirmed_departed" ] && { echo "DEPARTED:"; printf '%s\n' "$confirmed_departed" | sed 's/^/  - /'; } || true
}
