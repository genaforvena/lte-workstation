#!/usr/bin/env bash
# mesh-tg-typing — operator Telegram typing indicator.
# Sends Telegram sendChatAction(chat_id=51010427, action=typing) every few seconds while the mesh is
# processing an operator message. Started by mesh-voice-rx on ingress; stopped by mesh-voice-tx on reply.
#
#   mesh-tg-typing --start   start/restart the background loop
#   mesh-tg-typing --stop    stop the loop
#   mesh-tg-typing --once    send one typing action now
#   mesh-tg-typing --loop    internal loop mode (foreground)
#   mesh-tg-typing --test    dependency + dry-run test (no real send)
set -uo pipefail

ENVF="$HOME/.config/remote-access/env"
PIDFILE="${MESH_TG_TYPING_PIDFILE:-$HOME/.mesh/.tg-typing.pid}"
INTERVAL="${MESH_TG_TYPING_INTERVAL:-4}"
CURL_BIN="${MESH_TG_TYPING_CURL:-curl}"
OWNER_CHAT="51010427"

load_env() {
  local bot="${BOT_TOKEN:-}" chat="${CHAT_ID:-}"
  [ -f "$ENVF" ] && { set -a; . "$ENVF" 2>/dev/null; set +a; }
  [ -n "$bot" ] && BOT_TOKEN="$bot"
  [ -n "$chat" ] && CHAT_ID="$chat"
}

require_owner() {
  [ "${CHAT_ID:-}" = "$OWNER_CHAT" ] || {
    echo "mesh-tg-typing: CHAT_ID must be $OWNER_CHAT (got ${CHAT_ID:-unset})" >&2
    return 1
  }
}

send_once() {
  load_env
  command -v "$CURL_BIN" >/dev/null 2>&1 || { echo "mesh-tg-typing: missing curl ($CURL_BIN)" >&2; return 1; }
  [ -n "${BOT_TOKEN:-}" ] || { echo "mesh-tg-typing: BOT_TOKEN missing in $ENVF" >&2; return 1; }
  require_owner || return 1
  resp="$("$CURL_BIN" -sS --max-time 10 -X POST \
    "https://api.telegram.org/bot${BOT_TOKEN}/sendChatAction" \
    --data-urlencode "chat_id=${CHAT_ID}" \
    --data-urlencode "action=typing" 2>/dev/null)" || return 1
  printf '%s' "$resp" | grep -q '"ok":true'
}

loop() {
  load_env
  require_owner || exit 1
  trap 'rm -f "$PIDFILE"' EXIT INT TERM
  printf '%s\n' "$$" > "$PIDFILE"
  while :; do
    send_once || true
    sleep "$INTERVAL"
  done
}

start() {
  load_env
  require_owner || exit 1
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    exit 0
  fi
  mkdir -p "$(dirname "$PIDFILE")"
  nohup env \
    BOT_TOKEN="${BOT_TOKEN:-}" \
    CHAT_ID="${CHAT_ID:-}" \
    MESH_TG_TYPING_CURL="$CURL_BIN" \
    MESH_TG_TYPING_PIDFILE="$PIDFILE" \
    MESH_TG_TYPING_INTERVAL="$INTERVAL" \
    "$0" --loop >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
}

test_mode() {
  for x in curl nohup grep mktemp chmod cat sleep kill rm mkdir; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done

  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/calls.log"
  stubdir="$tmp/bin"
  mkdir -p "$stubdir"
  cat >"$stubdir/curl" <<'EOF'
#!/bin/sh
log="${MESH_TG_TYPING_LOG:?}"
printf '%s\n' "$*" >> "$log"
printf '%s' '{"ok":true}'
EOF
  chmod +x "$stubdir/curl" || { echo "smoke-test: FAIL (stub chmod)"; exit 1; }

  BOT_TOKEN="test-token" CHAT_ID="$OWNER_CHAT" \
    MESH_TG_TYPING_CURL="$stubdir/curl" \
    MESH_TG_TYPING_PIDFILE="$tmp/pid" \
    MESH_TG_TYPING_INTERVAL=0.1 \
    MESH_TG_TYPING_LOG="$log" \
    "$0" --start || { echo "smoke-test: FAIL (start)"; exit 1; }

  sleep 0.35

  MESH_TG_TYPING_PIDFILE="$tmp/pid" "$0" --stop
  [ ! -f "$tmp/pid" ] || { echo "smoke-test: FAIL (pidfile not cleared)"; exit 1; }
  [ -s "$log" ] || { echo "smoke-test: FAIL (no typing sent)"; exit 1; }
  n="$(wc -l < "$log" 2>/dev/null || echo 0)"
  [ "$n" -ge 2 ] || { echo "smoke-test: FAIL (loop did not re-send; calls=$n)"; exit 1; }
  grep -q 'sendChatAction' "$log" || { echo "smoke-test: FAIL (wrong API method)"; exit 1; }
  grep -q 'chat_id=51010427' "$log" || { echo "smoke-test: FAIL (wrong chat_id)"; exit 1; }
  grep -q 'action=typing' "$log" || { echo "smoke-test: FAIL (wrong action)"; exit 1; }
  echo "smoke-test: ok (typing loop + dry-run sendChatAction verified)"
}

case "${1:-}" in
  --test) test_mode ;;
  --once) send_once ;;
  --start) start ;;
  --stop) stop ;;
  --loop) loop ;;
  *) echo "usage: mesh-tg-typing [--start|--stop|--once|--loop|--test]" >&2; exit 1 ;;
esac
