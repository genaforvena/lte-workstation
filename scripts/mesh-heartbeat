#!/usr/bin/env bash
# mesh-heartbeat — the steward's liveness + quick "are we fine?" check, with a beacon a NEIGHBOUR
# can restore the loop from.
#
# Each beat runs the quick checks, writes a beacon recording the result AND the loop's intent
# (cadence + how to restore), and pushes the beacon to a neighbour node. If the steward session
# dies, the neighbour holds the last beacon; when it goes stale a neighbour re-establishes the
# loop. Gossiped resilience for the loop itself — the same trick as mesh-snapshot, for liveness.
#
#   mesh-heartbeat           run checks, write + push beacon, print summary
#   mesh-heartbeat --check   just the checks (no beacon)
#   mesh-heartbeat --test    smoke test (syntax + key deps + dry-run checks + beacon format)
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
BEAT="$HOME/.mesh/heartbeat.beat"; mkdir -p "$HOME/.mesh"
OWNER="${HB_OWNER:-steward@$(hostname)}"
PEER="${HB_PEER:-$(mesh-peer-addr default-string 2>/dev/null || true)}"; USER_R="${HB_USER:-$(whoami)}"
CADENCE="${HB_CADENCE:-3h}"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

checks() {
  echo "nodes:"
  "$HOME/.local/bin/mesh-health" 2>/dev/null | grep -E 'PASS|FAIL|OFFLINE|SKIP' | sed 's/^/  /'
  echo "loops (this node's tmux):"
  for w in genius-loci converse snapshot chat; do
    if tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$w"; then echo "  $w: up"; else echo "  $w: MISSING"; fi
  done
  echo "invariant (egress node host stays clean):"
  if [ -n "$PEER" ]; then
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$PEER" \
      'ip route get 1.1.1.1 2>/dev/null | grep -qE "dev (tun|wg|tailscale|gtcld)" && echo "  CHECK: host egress rides a tunnel (not clean)" || echo "  OK host clean"' 2>/dev/null \
      || echo "  peer $PEER unreachable"
  else
    echo "  no peer resolved (HB_PEER unset + registry empty) — skipped, not faking a result"
  fi
}

if [ "${1:-}" = --test ]; then
  fail=0
  command -v tailscale >/dev/null 2>&1 || { echo "  FAIL: no tailscale"; fail=1; }
  command -v tmux >/dev/null 2>&1 || { echo "  FAIL: no tmux"; fail=1; }
  command -v ssh >/dev/null 2>&1 || { echo "  FAIL: no ssh"; fail=1; }
  command -v scp >/dev/null 2>&1 || { echo "  FAIL: no scp"; fail=1; }
  command -v date >/dev/null 2>&1 || { echo "  FAIL: no date"; fail=1; }
  command -v "$HOME/.local/bin/mesh-health" >/dev/null 2>&1 || { echo "  FAIL: no mesh-health"; fail=1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "  FAIL: ~/.mesh not writable"; fail=1; }
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "  FAIL: no tmux session for $(hostname)"; fail=1; }
  # dry-run checks() with PEER empty (skip SSH invariant, avoid timeout): verify mesh-health + tmux parsing
  _c="$(PEER="" checks 2>&1)" || { echo "  FAIL: checks() errored"; fail=1; }
  printf '%s' "$_c" | grep -q 'PASS\|FAIL\|OFFLINE\|SKIP' && echo "  ok: checks() — mesh-health returned node status" || { echo "  FAIL: checks() — no node status from mesh-health"; fail=1; }
  printf '%s' "$_c" | grep -qE 'MISSING|up' && echo "  ok: checks() parsed tmux windows" || { echo "  FAIL: checks() — no tmux window status"; fail=1; }
  # dry-run beacon format: run the template (no SSH), verify it contains the expected sections
  _beat_tmp="$(mktemp)"
  {
    echo "=== HEARTBEAT BEACON ==="
    echo "owner:   steward@$(hostname)"
    echo "at:      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "cadence: 1h"
    echo "--- checks ---"
    PEER="" checks
    echo "--- RESTORE (for a neighbour) ---"
    echo "If 'at:' above is stale"
  } > "$_beat_tmp"
  grep -q '=== HEARTBEAT BEACON ===' "$_beat_tmp" && echo "  ok: beacon header" || { echo "  FAIL: beacon header missing"; fail=1; }
  grep -q 'owner:' "$_beat_tmp" && echo "  ok: beacon owner" || { echo "  FAIL: beacon owner missing"; fail=1; }
  grep -q 'RESTORE' "$_beat_tmp" && echo "  ok: beacon restore section" || { echo "  FAIL: beacon restore section missing"; fail=1; }
  [ "$(wc -c < "$_beat_tmp")" -gt 100 ] && echo "  ok: beacon size $(wc -c < "$_beat_tmp")b" || { echo "  FAIL: beacon too small"; fail=1; }
  rm -f "$_beat_tmp"
  [ "$fail" = 0 ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL"; exit 1; }
fi

[ "${1:-}" = "--check" ] && { checks; exit 0; }

{
  echo "=== HEARTBEAT BEACON ==="
  echo "owner:   $OWNER"
  echo "at:      $(ts)"
  echo "cadence: $CADENCE"
  echo "--- checks ---"
  checks
  echo "--- RESTORE (for a neighbour) ---"
  echo "If 'at:' above is stale (> 2x cadence with no newer beacon), the owner session is gone."
  echo "A neighbour restores the loop by:"
  echo "  1) mesh-chat \"steward beacon stale — covering the heartbeat\""
  echo "  2) run mesh-heartbeat here (take over the checks)"
  echo "  3) when a steward session returns, it re-runs: /loop 3h heartbeat and tmux quick check"
} > "$BEAT"
cat "$BEAT"

myip="$(tailscale ip -4 2>/dev/null | head -1)"
targets=()
if [ -n "$PEER" ]; then
  targets+=("$USER_R@$PEER")
elif [ -f "$HOME/.mesh/nodes" ]; then
  . "$HOME/.mesh/nodes" 2>/dev/null
  set -f
  for _e in ${MESH_NODES:-}; do
    _t="${_e#*:}"
    case "$_t" in local|""|*"$myip"*) continue;; esac
    targets+=("$_t")
  done
  set +f
fi
pushed=0
for _t in "${targets[@]}"; do
  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$_t" 'mkdir -p ~/.mesh' 2>/dev/null \
     && scp -q -o BatchMode=yes -o ConnectTimeout=8 "$BEAT" "$_t:.mesh/heartbeat-$(hostname).beat" 2>/dev/null; then
    echo "beacon pushed to $_t"; pushed=$((pushed+1))
  else
    echo "beacon NOT pushed ($_t unreachable)"
  fi
done
[ "$pushed" = 0 ] && echo "beacon pushed to NO neighbours (set HB_PEER or populate ~/.mesh/nodes MESH_NODES)"
