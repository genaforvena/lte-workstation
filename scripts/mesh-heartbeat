#!/usr/bin/env bash
# mesh-heartbeat — the steward's liveness + quick "are we fine?" check, with a beacon a NEIGHBOUR
# can restore the loop from.
#
# Each beat runs the quick checks, writes a beacon recording the result AND the loop's intent
# (cadence + how to restore), and pushes the beacon to a neighbour node. If the steward session
# dies, the neighbour holds the last beacon; when it goes stale a neighbour re-establishes the
# loop. Gossiped resilience for the loop itself — the same trick as mesh-snapshot, for liveness.
#
#   mesh-heartbeat           run checks, write + push beacon, print summary
#   mesh-heartbeat --check   just the checks (no beacon)
#   mesh-heartbeat --test    smoke test (syntax + key deps)
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v scp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no scp)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  command -v "$HOME/.local/bin/mesh-health" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-health)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  : > "$HOME/.mesh/.heartbeat-test" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  rm -f "$HOME/.mesh/.heartbeat-test"
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "smoke-test: FAIL (no tmux session for $(hostname))"; exit 1; }
  echo "smoke-test: ok"; exit 0
}
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
BEAT="$HOME/.mesh/heartbeat.beat"; mkdir -p "$HOME/.mesh"
OWNER="${HB_OWNER:-steward@$(hostname)}"
PEER="${HB_PEER:-}"; USER_R="${HB_USER:-$(whoami)}"
CADENCE="${HB_CADENCE:-3h}"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

checks() {
  echo "nodes:"
  "$HOME/.local/bin/mesh-health" 2>/dev/null | grep -E 'PASS|FAIL|OFFLINE|SKIP' | sed 's/^/  /'
  echo "loops (this node's tmux):"
  for w in genius-loci converse snapshot chat; do
    if tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$w"; then echo "  $w: up"; else echo "  $w: MISSING"; fi
  done
  echo "invariant (egress node host stays clean):"
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$PEER" \
    'ip route get 1.1.1.1 2>/dev/null | grep -q "dev wlp2s0" && echo "  OK host clean" || echo "  CHECK: host egress not wlp2s0"' 2>/dev/null \
    || echo "  peer $PEER unreachable"
}

[ "${1:-}" = "--check" ] && { checks; exit 0; }

{
  echo "=== HEARTBEAT BEACON ==="
  echo "owner:   $OWNER"
  echo "at:      $(ts)"
  echo "cadence: $CADENCE"
  echo "--- checks ---"
  checks
  echo "--- RESTORE (for a neighbour) ---"
  echo "If 'at:' above is stale (> 2x cadence with no newer beacon), the owner session is gone."
  echo "A neighbour restores the loop by:"
  echo "  1) mesh-chat \"steward beacon stale — covering the heartbeat\""
  echo "  2) run mesh-heartbeat here (take over the checks)"
  echo "  3) when a steward session returns, it re-runs: /loop 3h heartbeat and tmux quick check"
} > "$BEAT"
cat "$BEAT"

myip="$(tailscale ip -4 2>/dev/null | head -1)"
# Push the beat to neighbour(s) so they HOLD the steward's liveness. If HB_PEER is set, push there
# (back-compat). Otherwise push to EVERY registry peer (~/.mesh/nodes MESH_NODES) — a single unset
# HB_PEER used to mean the steward pushed to NOBODY (IdeaPad's cron sets none), freezing its beat on
# neighbours → ds saw a 29h-stale steward beacon → false "steward down" alarm + futile restores
# (2026-06-12). Registry-driven = plantable, and the beat reaches ALL minds (correct for succession).
targets=()
if [ -n "$PEER" ]; then
  targets+=("$USER_R@$PEER")
elif [ -f "$HOME/.mesh/nodes" ]; then
  . "$HOME/.mesh/nodes" 2>/dev/null
  set -f
  for _e in ${MESH_NODES:-}; do
    _t="${_e#*:}"
    case "$_t" in local|""|*"$myip"*) continue;; esac   # skip local/self
    targets+=("$_t")
  done
  set +f
fi
pushed=0
for _t in "${targets[@]}"; do
  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$_t" 'mkdir -p ~/.mesh' 2>/dev/null \
     && scp -q -o BatchMode=yes -o ConnectTimeout=8 "$BEAT" "$_t:.mesh/heartbeat-$(hostname).beat" 2>/dev/null; then
    echo "beacon pushed to $_t"; pushed=$((pushed+1))
  else
    echo "beacon NOT pushed ($_t unreachable)"
  fi
done
[ "$pushed" = 0 ] && echo "beacon pushed to NO neighbours (set HB_PEER or populate ~/.mesh/nodes MESH_NODES)"
