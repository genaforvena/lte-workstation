#!/usr/bin/env bash
# mesh-heartbeat — the steward's liveness + quick "are we fine?" check, with a beacon a NEIGHBOUR
# can restore the loop from.
#
# Each beat runs the quick checks, writes a beacon recording the result AND the loop's intent
# (cadence + how to restore), and pushes the beacon to a neighbour node. If the steward session
# dies, the neighbour holds the last beacon; when it goes stale a neighbour re-establishes the
# loop. Gossiped resilience for the loop itself — the same trick as mesh-snapshot, for liveness.
#
#   mesh-heartbeat           run checks, write + push beacon, print summary
#   mesh-heartbeat --check   just the checks (no beacon)
#   mesh-heartbeat --test    smoke test (syntax + key deps + dry-run checks + beacon format)
#
# SELF-WIRING (chat-review/heartbeat-not-reflex-wired 2026-07-05): the beat used to run ONLY inside
# the steward session's `/loop 3h heartbeat`, so when beacon-watch kill-server'd that session on
# 2026-07-05 11:00Z the heartbeat died WITH it — the beat on the neighbour went 15h stale and the
# next beacon pass escalated a false 🛑 to the operator. A cron backstop makes the beat survive
# session death (idempotent alongside the loop — each run just rewrites+pushes the beacon). Cadence
# 2h keeps the beat well under the beacon's 2×3h=6h max-age even with no session at all.
# reflex-cadence: 0 */2 * * *
set -uo pipefail
# cron's minimal PATH lacks ~/.local/bin — without this the backstop's bare mesh-* calls
# (mesh-peer-addr / mesh-card / mesh-conn / mesh-chat) silently no-op under cron.
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
BEAT="$HOME/.mesh/heartbeat.beat"; mkdir -p "$HOME/.mesh"
OWNER="${HB_OWNER:-steward@$(hostname)}"
PEER="${HB_PEER:-$(mesh-peer-addr default-string 2>/dev/null || true)}"; USER_R="${HB_USER:-$(whoami)}"
CADENCE="${HB_CADENCE:-3h}"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

checks() {
  echo "nodes:"
  timeout "${HB_HEALTH_TIMEOUT:-90}" "${MESH_HEALTH:-$HOME/.local/bin/mesh-health}" 2>/dev/null | grep -E 'PASS|FAIL|OFFLINE|SKIP' | sed 's/^/  /'
  echo "loops (this node's tmux):"
  # watched set = the current canonical mind-node channels (CLAUDE.md "Channel set", planted by
  # mesh-restore since the 2026-06-17 window re-org). The old list here (genius-loci/converse/
  # snapshot) predates that re-org — mesh-restore creates no window by those names any more, so
  # this checkpoint has been reading false MISSING for 3 of its 4 watched loops ever since (a
  # hollow checkpoint: a neighbour reading the beacon would see 3 "dead loops" that were never
  # running under those names). chat kept correct by coincidence (still a real window).
  for w in minds genome tg senses health chat; do
    if tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$w"; then echo "  $w: up"; else echo "  $w: MISSING"; fi
  done
  echo "invariant (egress node host stays clean):"
  if [ -n "$PEER" ]; then
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$PEER" \
      'ip route get 1.1.1.1 2>/dev/null | grep -qE "dev (tun|wg|tailscale|gtcld)" && echo "  CHECK: host egress rides a tunnel (not clean)" || echo "  OK host clean"' 2>/dev/null \
      || echo "  peer $PEER unreachable"
  else
    echo "  no peer resolved (HB_PEER unset + registry empty) — skipped, not faking a result"
  fi
}

# rejoin kernel forensics: capture the journal DATA into variables first, count fault hits from
# those variables, write section headers only afterwards — the counter must never read the log it
# writes (the old grep-the-file matched its own '-- panic/oops/...' header, so every clean rejoin
# beaconed a constant '1 kernel-fault hit'). Sources: journalctl, not dmesg — unprivileged dmesg
# is rc=1 under kernel.dmesg_restrict=1 (the old lane was permanently empty), while journalctl -k
# reads via the adm group; and the current-boot lane captures -p warning, not err, because the
# live rtw88 'failed to leave lps state' stall logs at WARNING (-p err misses it entirely).
# HB_JOURNAL_PREV / HB_JOURNAL_KERN override the source commands (test fixtures).
_fault_re='panic|oops|hardware error|\bmce\b|out of memory|watchdog'
rejoin_forensics(){ # $1 = log path (appended); prints the fault-hit count on stdout
  local _log="$1" _prev _kern _hits
  _prev="$(${HB_JOURNAL_PREV:-journalctl -b -1 -p err --no-pager} 2>/dev/null | tail -30)"
  _kern="$(${HB_JOURNAL_KERN:-journalctl -k -b 0 -p warning --no-pager} 2>/dev/null | tail -40)"
  _hits="$(printf '%s\n%s\n' "$_prev" "$_kern" | grep -ciE "$_fault_re")"
  {
    echo "-- crash-boot forensics (previous boot, journalctl -b -1 -p err) --"
    printf '%s\n' "${_prev:-  (no persistent journal for -b -1)}"
    echo "-- kernel current boot (journalctl -k -b 0 -p warning; unpriv dmesg is empty under dmesg_restrict=1) --"
    printf '%s\n' "${_kern:-  (no kernel warnings this boot, or journalctl unavailable)}"
  } >> "$_log"
  printf '%s\n' "$_hits"
}

# rejoin_fault_phrase $1=hit-count → the boot-aware clause the beacon prints. The count from
# rejoin_forensics is read from -b 0 / -b -1 journals, which do NOT change without a reboot — so a
# NETWORK-only flap (no reboot) re-stamps the SAME count on every rejoin, reading as accumulating
# fault evidence when it is one frozen snapshot (live: '28 hits' on 26 of tonight's rejoins, same
# data). Key on boot-id: unchanged boot = no reboot since the last rejoin = a re-stamp, marked
# '(boot-stable: N historical)'; a NEW boot-id (real reboot) surfaces the count as fresh evidence.
# unknown boot-id (unreadable /proc) NEVER dedups — fail-safe toward showing the real count, never
# hiding a fault. HB_BOOT_ID / HB_REJOIN_STATE override for --test.
rejoin_fault_phrase(){
  local _hits="$1" _bootid _state _last_bid _last_cnt
  _bootid="${HB_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)}"
  _state="${HB_REJOIN_STATE:-$HOME/.mesh/.rejoin-fault-state}"
  _last_bid=""; _last_cnt=""
  [ -r "$_state" ] && read -r _last_bid _last_cnt < "$_state" 2>/dev/null || true
  printf '%s %s\n' "$_bootid" "$_hits" > "$_state" 2>/dev/null || true
  if [ "$_bootid" != unknown ] && [ "$_bootid" = "$_last_bid" ]; then
    printf 'boot-stable: %s historical (no reboot since last rejoin)\n' "$_hits"
  else
    printf '%s kernel-fault hit(s)\n' "$_hits"
  fi
}

# --- rejoin SCOPE + DOWNTIME (task/rejoin-marker-cannot-distinguish-a-6h-poweroff-from-a-link-flap)
# The [node-rejoined] board line read IDENTICALLY for a 29s reboot and a 6h dark node: it carried
# neither how long the node was gone nor whether the link came back INSIDE the same boot. Both
# facts are local and cheap — journalctl's boot table holds prev-boot-last-entry → this-boot-
# first-entry (the real dark window), and the boot-id says whether a reboot happened at all — they
# just never reached the board. A marker that reads the same for both asserts nothing.
# HONEST-NA: missing evidence renders n/a, NEVER 0 — a 0 reads as "came right back", which is the
# very confusion this fixes. The link-only gap is an UPPER BOUND (time since the last sighting the
# stamp recorded, refreshed by every beat), so it is printed as `<=`, never as a measured outage.
# HB_BOOT_ID / HB_SEEN_STATE / HB_LIST_BOOTS / HB_NOW override for --test.
_fmt_dur(){ # $1 = whole seconds -> 29s / 5m3s / 6h12m / 2d3h ; empty/garbage -> n/a
  local _s="${1:-}"
  case "$_s" in ''|*[!0-9]*) printf 'n/a'; return;; esac
  if   [ "$_s" -ge 86400 ]; then printf '%dd%dh' "$((_s/86400))" "$(((_s%86400)/3600))"
  elif [ "$_s" -ge 3600  ]; then printf '%dh%dm' "$((_s/3600))"  "$(((_s%3600)/60))"
  elif [ "$_s" -ge 60    ]; then printf '%dm%ds' "$((_s/60))"    "$((_s%60))"
  else printf '%ds' "$_s"; fi
}
_iso(){ case "${1:-}" in ''|*[!0-9]*) printf 'n/a';; *) date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'n/a';; esac; }
# prints "<gap-secs> <prev-shutdown-epoch> <this-boot-epoch>" for the CURRENT (last-listed) boot,
# or nothing at all when the journal cannot answer (single boot recorded / no jq / no journal).
_boot_dark_gap(){
  command -v jq >/dev/null 2>&1 || return 1
  ${HB_LIST_BOOTS:-journalctl --list-boots -o json --no-pager} 2>/dev/null | jq -r '
    if type != "array" or length < 2 then empty
    else ((.[-2].last_entry/1000000)|floor) as $p | ((.[-1].first_entry/1000000)|floor) as $b
       | if $b > $p then "\($b - $p) \($p) \($b)" else empty end end' 2>/dev/null | head -1
}
rejoin_scope_phrase(){
  local _bootid _state _last_bid _last_seen _now _gap _gs _pv _bt
  _bootid="$(printf '%s' "${HB_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)}" | tr -d -)"
  [ -n "$_bootid" ] || _bootid=unknown
  _state="${HB_SEEN_STATE:-$HOME/.mesh/.rejoin-seen}"
  _now="${HB_NOW:-$(date +%s)}"
  _last_bid=""; _last_seen=""
  [ -r "$_state" ] && read -r _last_bid _last_seen < "$_state" 2>/dev/null || true
  printf '%s %s\n' "$_bootid" "$_now" > "$_state" 2>/dev/null || true
  _gap="$(_boot_dark_gap)"; _gs="${_gap%% *}"; _pv="$(printf '%s' "$_gap" | cut -d' ' -f2)"; _bt="$(printf '%s' "$_gap" | cut -d' ' -f3)"
  if [ "$_bootid" != unknown ] && [ -n "$_last_bid" ] && [ "$_bootid" = "$_last_bid" ]; then
    # same boot-id => the machine never went down; this is a link flap inside the running boot.
    # The bound is now - last sighting; an unusable stamp renders n/a, never 0 (a 0 here would
    # read as "came right back" — the exact reading this marker exists to make impossible).
    local _dark=""
    case "$_last_seen" in ''|*[!0-9]*) _dark="";; *) _dark="$(( _now - _last_seen ))";; esac
    [ -n "$_dark" ] && [ "$_dark" -lt 0 ] 2>/dev/null && _dark=""
    printf 'scope=link-only (no reboot; boot %.8s) downtime<=%s (since last sighting %s)\n' \
      "$_bootid" "$(_fmt_dur "$_dark")" "$(_iso "$_last_seen")"
  elif [ "$_bootid" = unknown ]; then
    printf 'scope=unknown (boot-id unreadable) downtime=n/a\n'
  elif [ -z "$_last_bid" ]; then
    printf 'scope=reboot? (no prior sighting — cannot tell reboot from state loss; boot %.8s) dark-gap=%s (prev shutdown %s -> boot %s)\n' \
      "$_bootid" "$(_fmt_dur "$_gs")" "$(_iso "$_pv")" "$(_iso "$_bt")"
  else
    printf 'scope=reboot (boot-id changed %.8s -> %.8s) downtime=%s (prev shutdown %s -> boot %s)\n' \
      "$_last_bid" "$_bootid" "$(_fmt_dur "$_gs")" "$(_iso "$_pv")" "$(_iso "$_bt")"
  fi
}

if [ "${1:-}" = --test ]; then
  fail=0
  command -v tailscale >/dev/null 2>&1 || { echo "  FAIL: no tailscale"; fail=1; }
  command -v tmux >/dev/null 2>&1 || { echo "  FAIL: no tmux"; fail=1; }
  command -v ssh >/dev/null 2>&1 || { echo "  FAIL: no ssh"; fail=1; }
  command -v scp >/dev/null 2>&1 || { echo "  FAIL: no scp"; fail=1; }
  command -v date >/dev/null 2>&1 || { echo "  FAIL: no date"; fail=1; }
  command -v "$HOME/.local/bin/mesh-health" >/dev/null 2>&1 || { echo "  FAIL: no mesh-health"; fail=1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "  FAIL: ~/.mesh not writable"; fail=1; }
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "  FAIL: no tmux session for $(hostname)"; fail=1; }
  # --test must be FAST + falsifiable. checks() calls the REAL mesh-health, whose full fleet SSH
  # sweep is 22-51s+ with offline peers (it has its OWN --test); re-running it transitively here —
  # TWICE (this dry-run + the beacon-format build below) — blew the smoke budget to 40s+ and
  # cry-wolfed mesh-doctor's parallel storm. So: bound ONE live probe to 8s to KEEP the
  # mesh-health->checks vocab contract (a status-token rename still FAILs here); on timeout fall
  # back to a stub so the parse pipeline is still exercised + say the live probe was skipped —
  # never hang, never fake a fleet result. The beacon test below (structure-only) uses the stub.
  _hb_stub="$(mktemp -d)"
  { echo '#!/usr/bin/env bash'; echo 'echo "node-local  PASS"'; echo 'echo "peer  OFFLINE"'; } > "$_hb_stub/mesh-health"
  chmod +x "$_hb_stub/mesh-health"
  _c="$(PEER="" HB_HEALTH_TIMEOUT="${HB_TEST_HEALTH_TIMEOUT:-8}" checks 2>&1)" || { echo "  FAIL: checks() errored"; fail=1; }
  if printf '%s' "$_c" | grep -q 'PASS\|FAIL\|OFFLINE\|SKIP'; then
    echo "  ok: checks() — mesh-health parsed live (vocab contract held)"
  else
    _cs="$(PEER="" MESH_HEALTH="$_hb_stub/mesh-health" checks 2>&1)"
    printf '%s' "$_cs" | grep -q 'PASS' \
      && echo "  ok: checks() — parse pipeline (stub; live mesh-health >8s — peers offline, skipped)" \
      || { echo "  FAIL: checks() — parse pipeline broken"; fail=1; }
  fi
  printf '%s' "$_c" | grep -qE 'MISSING|up' && echo "  ok: checks() parsed tmux windows" || { echo "  FAIL: checks() — no tmux window status"; fail=1; }
  # dry-run beacon format: run the template (no SSH), verify it contains the expected sections
  _beat_tmp="$(mktemp)"
  {
    echo "=== HEARTBEAT BEACON ==="
    echo "owner:   steward@$(hostname)"
    echo "at:      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "cadence: 1h"
    echo "--- checks ---"
    PEER="" MESH_HEALTH="$_hb_stub/mesh-health" checks
    echo "--- RESTORE (for a neighbour) ---"
    echo "If 'at:' above is stale"
  } > "$_beat_tmp"
  grep -q '=== HEARTBEAT BEACON ===' "$_beat_tmp" && echo "  ok: beacon header" || { echo "  FAIL: beacon header missing"; fail=1; }
  grep -q 'owner:' "$_beat_tmp" && echo "  ok: beacon owner" || { echo "  FAIL: beacon owner missing"; fail=1; }
  grep -q 'RESTORE' "$_beat_tmp" && echo "  ok: beacon restore section" || { echo "  FAIL: beacon restore section missing"; fail=1; }
  [ "$(wc -c < "$_beat_tmp")" -gt 100 ] && echo "  ok: beacon size $(wc -c < "$_beat_tmp")b" || { echo "  FAIL: beacon too small"; fail=1; }
  rm -f "$_beat_tmp"; rm -rf "$_hb_stub"
  # --- rejoin fault counter counts CAPTURED DATA, never its own log file ---
  # (chat-review/rejoin-hits-greps-own-header — the old counter grepped the log AFTER writing a
  # header full of fault words: constant 1 hit on every clean node. Fixture-driven through the
  # REAL rejoin_forensics: clean journals must count 0, one injected fault line exactly 1.)
  _rj_tmp="$(mktemp -d)"
  : > "$_rj_tmp/empty"
  printf '%s\n' 'usb 1-1: device descriptor read/64, error -71' > "$_rj_tmp/clean"
  _h0="$(HB_JOURNAL_PREV="cat $_rj_tmp/empty" HB_JOURNAL_KERN="cat $_rj_tmp/clean" rejoin_forensics "$_rj_tmp/log0")"
  [ "$_h0" = 0 ] && echo "  ok: rejoin forensics — clean capture counts 0 hits" \
    || { echo "  FAIL: rejoin forensics counted $_h0 on a clean capture (own-log self-match?)"; fail=1; }
  printf '%s\n' 'BUG: unable to handle kernel NULL pointer dereference — Oops: 0002' > "$_rj_tmp/fault"
  _h1="$(HB_JOURNAL_PREV="cat $_rj_tmp/empty" HB_JOURNAL_KERN="cat $_rj_tmp/fault" rejoin_forensics "$_rj_tmp/log1")"
  [ "$_h1" = 1 ] && echo "  ok: rejoin forensics — injected oops counts exactly 1 hit" \
    || { echo "  FAIL: rejoin forensics counted $_h1 on one injected fault (want 1)"; fail=1; }
  grep -q 'Oops: 0002' "$_rj_tmp/log1" && echo "  ok: rejoin forensics — captured data reaches the log" \
    || { echo "  FAIL: injected fault line missing from the rejoin log"; fail=1; }
  # --- boot-stable dedup: a network flap (unchanged boot-id) must NOT re-stamp the count as fresh ---
  # (chat-review/rejoin-faultcount-is-boot-stable-constant — the count is a -b0/-b-1 snapshot, frozen
  # without a reboot, so every network flap re-posted '28 hits' as if faults accumulated.) Falsify:
  # make rejoin_fault_phrase ignore boot-id → the same-boot leg stops saying 'boot-stable'.
  _bs_state="$_rj_tmp/faultstate"
  _p1="$(HB_BOOT_ID=boot-aaa HB_REJOIN_STATE="$_bs_state" rejoin_fault_phrase 28)"
  printf '%s' "$_p1" | grep -q '28 kernel-fault hit' \
    && echo "  ok: rejoin phrase — first sight of a boot shows the real count" \
    || { echo "  FAIL: first-sight phrase wrong: $_p1"; fail=1; }
  _p2="$(HB_BOOT_ID=boot-aaa HB_REJOIN_STATE="$_bs_state" rejoin_fault_phrase 28)"
  printf '%s' "$_p2" | grep -q 'boot-stable: 28 historical' \
    && echo "  ok: rejoin phrase — same boot-id re-stamp marked boot-stable, not fresh evidence" \
    || { echo "  FAIL: same-boot flap not deduped (reads as accumulating faults): $_p2"; fail=1; }
  _p3="$(HB_BOOT_ID=boot-bbb HB_REJOIN_STATE="$_bs_state" rejoin_fault_phrase 5)"
  printf '%s' "$_p3" | grep -q '5 kernel-fault hit' \
    && echo "  ok: rejoin phrase — a NEW boot-id (real reboot) surfaces fresh evidence" \
    || { echo "  FAIL: reboot phrase not fresh: $_p3"; fail=1; }
  _p4="$(HB_BOOT_ID=unknown HB_REJOIN_STATE="$_rj_tmp/nostate" rejoin_fault_phrase 9)"
  printf '%s' "$_p4" | grep -q '9 kernel-fault hit' \
    && echo "  ok: rejoin phrase — unknown boot-id fails safe to the real count (never hides a fault)" \
    || { echo "  FAIL: unknown boot-id did not fail safe: $_p4"; fail=1; }
  # --- rejoin SCOPE + DOWNTIME reach the BOARD LINE, and a reboot never reads like a flap ---
  # (task/rejoin-marker-cannot-distinguish-a-6h-poweroff-from-a-link-flap) The gate drives the REAL
  # --rejoin path in a child with an isolated HOME and a mesh-chat stub that captures what is
  # actually posted — asserting the artifact (the board line), not the phrase function in isolation.
  # A marker that reads the same for a 29s reboot and a 6h dark node asserts nothing, so the core
  # assertion is that the three lines DIFFER from each other, not merely that each is non-empty.
  # ${BASH_SOURCE[0]} not $0: run under a PATH name, $0 is the DEPLOYED copy and the gate would
  # test a different file than the one being edited (memory/a-bare-dollar-zero-child-runs-the-deployed-copy).
  _sc_self="${BASH_SOURCE[0]}"
  _sc_tmp="$(mktemp -d)"; mkdir -p "$_sc_tmp/bin" "$_sc_tmp/home/.mesh"
  for _stub in mesh-card mesh-conn mesh-peer-addr; do printf '#!/bin/sh\nexit 0\n' > "$_sc_tmp/bin/$_stub"; done
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "$SC_POSTED"\n' > "$_sc_tmp/bin/mesh-chat"
  chmod +x "$_sc_tmp/bin"/*
  printf '[{"index":-1,"boot_id":"aaaa","last_entry":1786000000000000},{"index":0,"boot_id":"bbbb","first_entry":1786000029000000}]\n' > "$_sc_tmp/boots29"
  printf '[{"index":-1,"boot_id":"aaaa","last_entry":1786000000000000},{"index":0,"boot_id":"bbbb","first_entry":1786021600000000}]\n' > "$_sc_tmp/boots6h"
  _sc_drive(){ # $1=label $2=seed-state-line $3=HB_BOOT_ID $4=list-boots fixture(or "")
    local _st="$_sc_tmp/state.$1" _out="$_sc_tmp/posted.$1"
    printf '%s\n' "$2" > "$_st"; : > "$_out"
    ( export HOME="$_sc_tmp/home" PATH="$_sc_tmp/bin:$PATH" SC_POSTED="$_out" \
             HB_PEER="" HB_BOOT_ID="$3" HB_SEEN_STATE="$_st" HB_NOW=1786021600
      [ -n "${4:-}" ] && export HB_LIST_BOOTS="cat $4"
      timeout 40 bash "$_sc_self" --rejoin ) >/dev/null 2>&1
    grep -m1 '\[node-rejoined\]' "$_out" 2>/dev/null
  }
  _l_flap="$(_sc_drive flap  "bbbb 1786021230" bbbb "")"
  _l_29s="$(_sc_drive reboot29 "aaaa 1785990000" bbbb "$_sc_tmp/boots29")"
  _l_6h="$(_sc_drive reboot6h  "aaaa 1785990000" bbbb "$_sc_tmp/boots6h")"
  printf '%s' "$_l_flap" | grep -q 'scope=link-only' \
    && echo "  ok: rejoin board line — same boot-id posts scope=link-only" \
    || { echo "  FAIL: link-only rejoin did not reach the board line: ${_l_flap:-<no line posted>}"; fail=1; }
  printf '%s' "$_l_flap" | grep -q 'downtime<=6m10s' \
    && echo "  ok: rejoin board line — link-only carries a BOUNDED dark window (<=, not a measured outage)" \
    || { echo "  FAIL: link-only line missing its <=6m10s bound: ${_l_flap:-<none>}"; fail=1; }
  printf '%s' "$_l_29s" | grep -q 'scope=reboot (boot-id changed' \
    && printf '%s' "$_l_29s" | grep -q 'downtime=29s' \
    && echo "  ok: rejoin board line — a reboot posts scope=reboot with the prev-shutdown->boot gap (29s)" \
    || { echo "  FAIL: 29s reboot line wrong: ${_l_29s:-<no line posted>}"; fail=1; }
  printf '%s' "$_l_6h" | grep -q 'downtime=6h0m' \
    && echo "  ok: rejoin board line — a 6h dark node posts its real 6h gap" \
    || { echo "  FAIL: 6h dark line wrong: ${_l_6h:-<no line posted>}"; fail=1; }
  # THE gate: all three must be mutually distinguishable on the board.
  if [ -n "$_l_flap" ] && [ "$_l_flap" != "$_l_29s" ] && [ "$_l_29s" != "$_l_6h" ] && [ "$_l_flap" != "$_l_6h" ]; then
    echo "  ok: rejoin board lines DIFFER across link-flap / 29s reboot / 6h poweroff"
  else
    echo "  FAIL: rejoin board lines do not distinguish the three cases (marker asserts nothing)"; fail=1
  fi
  # honest-n/a: no boot table and no prior sighting must render n/a, never 0 ("came right back").
  _l_na="$(HB_BOOT_ID=cccc HB_SEEN_STATE="$_sc_tmp/none" HB_LIST_BOOTS="true" rejoin_scope_phrase)"
  # Assert the DURATION field itself, not a bare 'n/a' anywhere on the line — the timestamps in
  # the same line also render n/a, and a substring gate on a composite artifact is satisfied by a
  # neighbouring field (a mutant returning 0s for an empty duration passed that weaker form).
  printf '%s' "$_l_na" | grep -qE '(downtime|dark-gap)(<=|=)n/a' \
    && echo "  ok: rejoin scope — missing evidence renders n/a, never a fabricated 0s" \
    || { echo "  FAIL: missing evidence did not render n/a: $_l_na"; fail=1; }
  rm -rf "$_sc_tmp"
  rm -rf "$_rj_tmp"
  # --- self-wiring + cron-safety (chat-review/heartbeat-not-reflex-wired) ---
  # (a) the reflex-cadence header must exist so mesh-autowire wires the cron backstop (else the beat
  #     dies with the session again). Split the literal so this guard line never self-matches.
  _rc_a='# reflex-'; _rc_b='cadence: 0 */2'
  grep -qF "${_rc_a}${_rc_b}" "$0" || { echo "  FAIL: reflex-cadence header missing — cron backstop won't self-wire"; fail=1; }
  # (b) PATH export — without it the cron run's bare mesh-* calls no-op (cron's minimal PATH).
  _pe_a='export PATH="$HOME/.local'; _pe_b='/bin:$PATH"'
  grep -qF "${_pe_a}${_pe_b}" "$0" || { echo "  FAIL: PATH export missing — cron backstop can't find ~/.local/bin tools"; fail=1; }
  # (c) push-result log lines must be ts-stamped (forensic dating of a push failure).
  _ts_a='echo "$(ts) beacon '; _ts_b='pushed to $_t"'
  grep -qF "${_ts_a}${_ts_b}" "$0" || { echo "  FAIL: push-result log lines not timestamped — can't date a push failure"; fail=1; }
  [ "$fail" = 0 ] && echo "smoke-test: ok (self-wire cadence + cron PATH + timestamped push log all asserted)" && exit 0 || { echo "smoke-test: FAIL"; exit 1; }
fi

[ "${1:-}" = "--check" ] && { checks; exit 0; }

# --rejoin — connectivity-up PUSH (operator 2026-06-21: "reconnect = first beat of the same
# heartbeat"). When a node's link comes back, IT pushes immediately (not steward-pull/5min): a
# [node-rejoined] board beacon + live node-local data + crash-boot forensics from the PREVIOUS boot,
# captured while still fresh — then falls through to the normal beacon write+push (renewing its lease
# the instant it reconnects). Triggered by the node's own connectivity-up edge (mesh-selfcare).

if [ "${1:-}" = --rejoin ]; then
  _host="$(hostname)"; _rlog="$HOME/.mesh/rejoin-$_host.log"
  {
    echo "==== $(ts) [node-rejoined] $_host — connectivity up; live data + crash-boot forensics ===="
    echo "-- card --";          command -v mesh-card >/dev/null 2>&1 && mesh-card 2>/dev/null | sed -n '1,40p'
    echo "-- connectivity --";   command -v mesh-conn >/dev/null 2>&1 && mesh-conn --oneline 2>/dev/null
    echo "-- temps (local thermal zones) --"
    for _z in /sys/class/thermal/thermal_zone*/temp; do [ -r "$_z" ] && echo "  $(basename "$(dirname "$_z")"): $(( $(cat "$_z" 2>/dev/null || echo 0)/1000 ))C"; done
    echo "-- uptime --";         uptime 2>/dev/null
  } > "$_rlog" 2>&1
  _hits="$(rejoin_forensics "$_rlog" 2>>"$_rlog")"
  _faultmsg="$(rejoin_fault_phrase "$_hits")"
  # scope+downtime FIRST on the line: a reader must be able to tell a 29s reboot from a 6h dark
  # node without opening the log. (rejoin_scope_phrase also re-stamps the sighting state.)
  _scopemsg="$(rejoin_scope_phrase)"
  printf '%s\n' "-- rejoin scope --" "  $_scopemsg" >> "$_rlog"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="rejoin@$_host" \
    mesh-chat "[node-rejoined] $_host — ${_scopemsg}; live data + crash-boot forensics captured (${_faultmsg}) → $_rlog (steward: diagnose if unexpected)" >/dev/null 2>&1
  echo "[node-rejoined] $_host — ${_scopemsg}; forensics → $_rlog (${_faultmsg}); renewing lease (beacon below)"
  # fall through → write + push the beacon NOW = the lease is renewed the instant we reconnect.
fi

# Re-stamp the sighting on EVERY beat (not only on rejoins): the link-only downtime bound is
# now - last sighting, so a stamp written only at rejoin edges would report the gap since the last
# FLAP instead of the gap since the node was last known up. 2h cadence => bound <=2h.
: > /dev/null; { _hb_bid="$(printf '%s' "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)" | tr -d -)"
  printf '%s %s\n' "${_hb_bid:-unknown}" "$(date +%s)" > "${HB_SEEN_STATE:-$HOME/.mesh/.rejoin-seen}"; } 2>/dev/null || true

{
  echo "=== HEARTBEAT BEACON ==="
  echo "owner:   $OWNER"
  echo "at:      $(ts)"
  echo "cadence: $CADENCE"
  echo "--- checks ---"
  checks
  echo "--- RESTORE (for a neighbour) ---"
  echo "If 'at:' above is stale (> 2x cadence with no newer beacon), the owner session is gone."
  echo "A neighbour restores the loop by:"
  echo "  1) mesh-chat \"steward beacon stale — covering the heartbeat\""
  echo "  2) run mesh-heartbeat here (take over the checks)"
  echo "  3) when a steward session returns, it re-runs: /loop 3h heartbeat and tmux quick check"
} > "$BEAT"
cat "$BEAT"

myip="$(tailscale ip -4 2>/dev/null | head -1)"
targets=()
if [ -n "$PEER" ]; then
  targets+=("$USER_R@$PEER")
elif [ -f "$HOME/.mesh/nodes" ]; then
  . "$HOME/.mesh/nodes" 2>/dev/null
  set -f
  for _e in ${MESH_NODES:-}; do
    _t="${_e#*:}"
    case "$_t" in local|""|*"$myip"*) continue;; esac
    targets+=("$_t")
  done
  set +f
fi
pushed=0
for _t in "${targets[@]}"; do
  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$_t" 'mkdir -p ~/.mesh' 2>/dev/null \
     && scp -q -o BatchMode=yes -o ConnectTimeout=8 "$BEAT" "$_t:.mesh/heartbeat-$(hostname).beat" 2>/dev/null; then
    echo "$(ts) beacon pushed to $_t"; pushed=$((pushed+1))
  else
    echo "$(ts) beacon NOT pushed ($_t unreachable)"
  fi
done
[ "$pushed" = 0 ] && echo "$(ts) beacon pushed to NO neighbours (set HB_PEER or populate ~/.mesh/nodes MESH_NODES)"
