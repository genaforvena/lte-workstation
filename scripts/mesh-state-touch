#!/usr/bin/env bash
# orphan-ok: liveness PRIMITIVE invoked by other reflexes (`mesh-state-touch "$STATE"`), never itself
#            cron-scheduled — on-demand by design, so the orphan check must not flag it.
# mesh-state-touch — liveness primitive: refresh a STATE artifact's mtime on every successful eval,
# WITHOUT touching its content. The shared fix for the conditional-write FALSE-STALE class
# (chat-review/conditional-write-liveness-touch 2026-06-25).
#
# THE PROBLEM it ends: a reflex that only REWRITES its STATE file when the VALUE changes leaves the
# mtime frozen on a long-stable-but-LIVE value. The staleness watchdogs (mesh-reflex-health / mesh-pulse)
# age a reflex by its artifact mtime, so a value that legitimately holds for hours reads as a DEAD reflex
# → chronic per-tool false-STALE (mesh-activity-tempo's oscillating-axis case, f3f84c1). Staleness must
# mean "the reflex STOPPED RUNNING", never "the value didn't change".
#
# THE CONVENTION: every reflex calls `mesh-state-touch "$STATE"` (or a bare `touch "$STATE"`) on EVERY
# successful eval — decoupling ran-live (mtime, owned here) from value-changed (content, still owned by
# the reflex's own change-gated write). A genuinely dead cron never runs → never touches → still goes
# honest-STALE. Idempotent, content-preserving, cheap.
#
#   mesh-state-touch <file>...        refresh mtime of each EXISTING file (missing files are SKIPPED —
#                                     never create a hollow state that consumers would read as real)
#   mesh-state-touch --create <f>...  also create an empty file if missing (first-run seed)
#   mesh-state-touch --test           smoke test
set -uo pipefail

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$d"' EXIT
  # content-preserving mtime refresh on an existing file
  printf 'VALUE-HELD\n' > "$d/s"; touch -d '1 hour ago' "$d/s"
  old=$(stat -c %Y "$d/s")
  "$0" "$d/s" || { echo "smoke-test: FAIL (touch existing returned nonzero)"; exit 1; }
  new=$(stat -c %Y "$d/s")
  [ "$new" -gt "$old" ] || { echo "smoke-test: FAIL (mtime not refreshed: $old→$new)"; exit 1; }
  [ "$(cat "$d/s")" = "VALUE-HELD" ] || { echo "smoke-test: FAIL (content changed — must be preserved)"; exit 1; }
  # missing file is SKIPPED (no hollow create) without --create
  "$0" "$d/missing" >/dev/null 2>&1
  [ ! -e "$d/missing" ] || { echo "smoke-test: FAIL (created a missing file without --create — hollow state)"; exit 1; }
  # --create seeds an empty file
  "$0" --create "$d/seed" || { echo "smoke-test: FAIL (--create returned nonzero)"; exit 1; }
  [ -f "$d/seed" ] && [ ! -s "$d/seed" ] || { echo "smoke-test: FAIL (--create did not seed an empty file)"; exit 1; }
  echo "smoke-test: ok (mtime refresh + content-preserve + missing-skip + --create seed)"; exit 0
fi

create=0
[ "${1:-}" = --create ] && { create=1; shift; }
[ "$#" -ge 1 ] || { echo "usage: mesh-state-touch [--create] <file>..." >&2; exit 2; }

rc=0
for f in "$@"; do
  if [ -e "$f" ]; then
    touch "$f" 2>/dev/null || rc=1
  elif [ "$create" = 1 ]; then
    : > "$f" 2>/dev/null || rc=1
  fi   # missing + no --create → skip (never fabricate a hollow state file)
done
exit "$rc"
