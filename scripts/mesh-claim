    # sandbox-outbound).
    _gk_board="$(mktemp)"; _gk_orig_board="$BOARD"; _gk_orig_who="$WHO"
    _gk_now="$(date -u +%FT%TZ)"
    printf '%s  turbo-lid@h  ::  [claim] gk-test-key ttl=7200\n' "$_gk_now" > "$_gk_board"
    BOARD="$_gk_board"
    WHO="genome@h";     _done_gate gk-test-key 0; [ $? -eq 2 ] || f="$f done-other-owner-not-refused"
    _o3="$(WHO="genome@h" _done_gate gk-test-key 0 2>&1 1>/dev/null)"
    case "$_o3" in *"turbo-lid@h"*) : ;; *) f="$f done-other-owner-msg-missing-owner:[$_o3]" ;; esac
    WHO="genome@h";     _done_gate gk-test-key 1; [ $? -eq 0 ] || f="$f done-force-not-honored"
    WHO="turbo-lid@h";  _done_gate gk-test-key 0; [ $? -eq 0 ] || f="$f done-own-claim-refused"
    _gk_past="$(date -u -d '-1 hour' +%FT%TZ)"
    printf '%s  turbo-lid@h  ::  [claim] gk-stale-key ttl=60\n' "$_gk_past" > "$_gk_board"
    WHO="genome@h";     _done_gate gk-stale-key 0; [ $? -eq 0 ] || f="$f done-stale-claim-refused"
    WHO="genome@h";     _done_gate gk-unclaimed-key 0; [ $? -eq 0 ] || f="$f done-unclaimed-key-refused"
    # donegate-caller-tag (chat-review, live-reproduced 2026-07-06T22:44Z via mesh-chat's own --test
    # #10): the SAME principal claiming as one caller then releasing as a DIFFERENT caller (e.g.
    # claim via `mesh-claim` directly, release via mesh-chat's [done] auto-release) must NOT be
    # refused — only the /<caller> tag differs, the <user>@<host> principal is identical. A
    # genuinely different USER must still be refused.
    [ "$(_principal 'imozerov/mesh-claim@h')" = "$(_principal 'imozerov/mesh-chat@h')" ] \
      || f="$f principal-strip-mismatch (same user, different caller tag, must collapse to one principal)"
    [ "$(_principal 'genome@h')" = "genome@h" ] \
      || f="$f principal-bare-passthrough (an explicit no-slash MESH_WHO must pass through unchanged)"
    printf '%s  imozerov/mesh-claim@h  ::  [claim] gk-caller-key ttl=7200\n' "$_gk_now" > "$_gk_board"
    WHO="imozerov/mesh-chat@h"; _done_gate gk-caller-key 0; [ $? -eq 0 ] \
      || f="$f donegate-caller-tag (same user/host, different caller tag, must be allowed to release)"
    WHO="otheruser/mesh-chat@h"; _done_gate gk-caller-key 0; [ $? -eq 2 ] \
      || f="$f donegate-genuinely-other-user-not-refused (a truly different user must still be refused)"
    BOARD="$_gk_orig_board"; WHO="$_gk_orig_who"; rm -f "$_gk_board"
    # owner_liveness DEAD-SHELL (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): a shed/
    # killed owner's window must age its claim as STALE, same as plain DEAD (exit 5) — NOT fall
    # through to the default branch's LIVE (DEAD-SHELL never textually contains "IDLE"). Stub
    # mesh-mind-state as a shell function (bash resolves it before PATH — same convention used
    # throughout this codebase for hermetic outbound-capture tests).
    mesh-mind-state(){ return 8; }
    [ "$(owner_liveness "fakewin@$HOST")" = STALE ] || f="$f owner-liveness-dead-shell-not-stale"
    mesh-mind-state(){ return 9; }   # AUTH-DEAD (chat-review/mindstate-loggedout-not-idle): logged-out owner → STALE (else reads LIVE forever)
    [ "$(owner_liveness "fakewin@$HOST")" = STALE ] || f="$f owner-liveness-auth-dead-not-stale"
    mesh-mind-state(){ return 5; }   # unchanged sibling case, still correct after the new arm
    [ "$(owner_liveness "fakewin@$HOST")" = STALE ] || f="$f owner-liveness-dead-regressed"
    unset -f mesh-mind-state

    # --- claim-idle-is-not-abandoned (chat-review, live-reproduced 2026-07-15 07:37:02) --------------
    # THE REAL SPLIT: "walked away" vs "resting between turns" both print IDLE. Assert that IDLE alone
    # can no longer convict, that the TTL arm (dead code before this fix — nothing survived to reach
    # its own clock) DOES fire, and that provable death still fires instantly.
    # Own state dir + own artifacts: the strike record must never be the real one, and the mtime under
    # test must be a scratch file, never a path anything reads for liveness (mesh-guardian lesson).
    _cl_dir="$(mktemp -d)"; _cl_orig_strike="$STRIKE_DIR"; STRIKE_DIR="$_cl_dir/strikes"
    # stamped BEFORE the first sandboxed arm: the real-board leak gate below is time-scoped to
    # this run, so a leak already standing on the node can never wedge the suite forever.
    _cl_t0="$(date -u +%FT%TZ)"; _cl_seen=""
    _cl_now=2000000000                       # synthetic clock — every epoch here is passed in, not read
    _cl_busy="$_cl_dir/busy-artifact"; : > "$_cl_busy"
    _cl_gone="$_cl_dir/gone-artifact"; : > "$_cl_gone"
    mesh-mind-state(){ printf 'IDLE\tready prompt, no turn running\n'; return 0; }   # the mandated resting state
    # (a) THE REGRESSION: fresh claim + IDLE owner + artifact touched SINCE the claim epoch → LIVE.
    # This is the exact shape of the two claims the 07:37 sweep wrongly cried: a mind that did work and
    # is resting between turns. It must stay LIVE no matter how many sweeps look at it.
    touch -d "@$(( _cl_now - 100 ))" "$_cl_busy"
    [ "$(owner_liveness "w@$HOST" "$_cl_busy" $(( _cl_now - 500 )) "$_cl_now")" = LIVE ] \
      || f="$f idle-owner-touched-artifact-convicted (IDLE+work-in-flight must stay LIVE)"
    [ "$(owner_liveness "w@$HOST" "$_cl_busy" $(( _cl_now - 500 )) $(( _cl_now + 6000 )))" = LIVE ] \
      || f="$f idle-owner-touched-artifact-convicted-later-sweep"
    # (b) IDLE + artifact UNTOUCHED since the claim: one sweep is a hint, not a verdict → LIVE...
    touch -d "@$(( _cl_now - 900 ))" "$_cl_gone"          # mtime BEFORE the claim epoch: no work done
    [ "$(owner_liveness "w2@$HOST" "$_cl_gone" $(( _cl_now - 500 )) "$_cl_now")" = LIVE ] \
      || f="$f idle-first-sweep-convicted (one glance at a resting mind is not abandonment)"
    # ...and a burst of --check calls inside one sweep window must NOT stack strikes...
    [ "$(owner_liveness "w2@$HOST" "$_cl_gone" $(( _cl_now - 500 )) $(( _cl_now + 10 )))" = LIVE ] \
      || f="$f idle-rapid-recheck-stacked-strikes (two --check calls 10s apart must not convict)"
    # ...but a genuinely separate sweep (>= IDLE_MIN_SPAN later) reaching the strike count → STALE.
    [ "$(owner_liveness "w2@$HOST" "$_cl_gone" $(( _cl_now - 500 )) $(( _cl_now + 400 )))" = STALE ] \
      || f="$f idle-two-sweeps-untouched-not-stale (real abandonment must still age out)"
    # a re-claim (new epoch) restarts the count — a fresh claim never inherits the old one's strikes
    [ "$(owner_liveness "w2@$HOST" "$_cl_gone" $(( _cl_now + 500 )) $(( _cl_now + 900 )))" = LIVE ] \
      || f="$f idle-strikes-survived-reclaim"
    # (c) THE CLOCK ARM, which the IDLE bug made unreachable: a claim past its TTL must reach a
    # DIFFERENT verdict than one inside it — the ttl= a caller passes has to decide something.
    #
    # THIS ARM USED TO ASSERT `= stale` AND THAT ASSERTION *WAS* THE BUG {#b2d997b4}. Written to prove
    # the clock was reachable, it fixed the reachable state as the RECLAIMABLE one, so the gate itself
    # certified a WORKING owner's claim as abandoned and would have gone red at the fix. A gate can
    # enshrine the defect it was built beside; the fix is the word, and the arm now asserts the word.
    _cl_board="$(mktemp)"; _cl_orig_board="$BOARD"; _cl_orig_who="$WHO"; BOARD="$_cl_board"; WHO="genome@$HOST"
    mesh-mind-state(){ printf 'WORKING\ta turn is running\n'; return 0; }
    # ONE timestamp for the whole arm. Deriving it twice from `date -u -d '-1 hour'` puts a second's
    # tick between the board's claim epoch and anything computed from it, which silently restarts the
    # idle-strike record (it is keyed on the claim epoch) and turns the decay arm into a coin flip.
    _cl_ts="$(date -u -d '-1 hour' +%FT%TZ)"; _cl_ce="$(date -d "$_cl_ts" +%s)"
    # A CHILD PROCESS INHERITS NEITHER $BOARD (a shell variable, not the env) NOR the mesh-mind-state
    # SHELL FUNCTION. The first draft of these CLI arms ran `"$0" <key>` with both unset: the child
    # read the REAL board, saw the key unclaimed, and POSTED A LIVE [claim] for a /tmp path — the exact
    # reflex-test-must-sandbox-outbound hazard this file warns about two screens up, committed by the
    # gate written to enforce it. The child gets the board by ENV and the stub by PATH, and the
    # sandbox is asserted below before any arm is allowed to conclude anything.
    # THE STUB DIR IS A FAKE HOME's .local/bin, NOT a bare PATH prepend. This script's own line 2
    # does `export PATH="$HOME/.local/bin:$PATH"`, so a stub merely prepended to PATH loses the race
    # to the REAL mesh-mind-state — measured here: the child answered past-ttl-liveness-unknown
    # because the real tool read window 'wlive' as ABSENT ([[a-poisoned-binary-can-lose-a-path-race-
    # to-the-real-one]]). Moving HOME makes the child's own re-export put the stub first.
    # mesh-chat is stubbed onto the SAME dir so that if the stand-down guard ever regresses, the
    # phantom [claim] lands in the sandbox board instead of the live one — the leak this arm already
    # caused once is not allowed to depend on the assertion below being correct.
    _cl_home="$_cl_dir/home"; _cl_bin="$_cl_home/.local/bin"; mkdir -p "$_cl_bin"
    printf '#!/bin/sh\nprintf "WORKING\\ta turn is running\\n"\nexit 0\n' > "$_cl_bin/mesh-mind-state"
    printf '#!/bin/sh\nprintf "%%s  stranger@%s  ::  %%s\\n" "$(date -u +%%FT%%TZ)" "$1" >> "%s"\nexit 0\n' \
      "$HOST" "$_cl_board" > "$_cl_bin/mesh-chat"
    chmod +x "$_cl_bin/mesh-mind-state" "$_cl_bin/mesh-chat"
    _cl_child() { HOME="$_cl_home" MESH_CHAT_LOG="$_cl_board" MESH_CLAIM_STRIKE_DIR="$STRIKE_DIR" \
                  MESH_WHO="stranger@$HOST" "$0" "$@"; }
    printf '%s  wlive@%s  ::  [claim] %s ttl=60\n' "$_cl_ts" "$HOST" "$_cl_gone" > "$_cl_board"
    # falsify the sandbox itself FIRST: if the child were reading the real board it would answer
    # 'unclaimed' here, and every assertion below would be about the wrong file.
    # ANCHORED *unclaimed:* with stderr DISCARDED, not `unclaimed:*` with 2>&1 — measured: the
    # unsandboxed child emits a "No such file or directory" line FIRST, which prefixed the capture and
    # made this very guard silently unmatchable in the one mutation it exists to catch.
    case "$(_cl_child --check "$_cl_gone" 2>/dev/null)" in
      *unclaimed:*) f="$f test-child-not-sandboxed (the child is reading a DIFFERENT board — every arm below is vacuous AND it may post to the real one)" ;;
    esac
    set -- $(_resolve "$_cl_gone")
    [ "$1" = expired ] \
      || f="$f expired-live-collapsed (a WORKING owner past its TTL is EXPIRED, never abandoned — got '$1')"
    [ "$2" = 2 ] \
      || f="$f expired-wrong-rc (expired must carry rc 2 so every existing stand-down reader is right — got '$2')"
    [ "$5" = past-ttl-owner-live ] \
      || f="$f expired-wrong-evidence (the verdict must carry the measurement it rests on — got '$5')"
    # THE LIVE REPRODUCTION, end-to-end through the CLI the way the 16:57Z hh-driver read went:
    # --check must not print the reclaimable word, and the claim path must STAND DOWN, not take it.
    _cl_chk="$(_cl_child --check "$_cl_gone" 2>&1)"; _cl_chkrc=$?
    case "$_cl_chk" in expired:*) : ;; *) f="$f check-expired-render:[$_cl_chk]" ;; esac
    # keyed on the STALE renderer's exact wording, not on a bare "reclaimable" — the correct expired
    # line legitimately contains "NOT reclaimable", and a substring test would fail on the fix.
    case "$_cl_chk" in *"→ reclaimable"*|*abandoned*) f="$f check-expired-says-reclaimable:[$_cl_chk]" ;; esac
    [ "$_cl_chkrc" = 2 ] || f="$f check-expired-rc:[$_cl_chkrc]"
    _cl_n0="$(grep -acF "[claim] $_cl_gone" "$_cl_board")"
    _cl_take="$(_cl_child "$_cl_gone" 2>&1 1>/dev/null)"; _cl_takerc=$?
    _cl_n1="$(grep -acF "[claim] $_cl_gone" "$_cl_board")"
    [ "$_cl_takerc" = 2 ] \
      || f="$f expired-claim-taken (the whole point: a second writer must be refused — rc $_cl_takerc)"
    [ "$_cl_n1" = "$_cl_n0" ] \
      || f="$f expired-claim-posted (standing down must post NOTHING — board grew $_cl_n0 -> $_cl_n1)"
    # ...and it must not be releasable by a stranger either — a lapsed clock changes the remedy,
    # never the ownership.
    _done_gate "$_cl_gone" 0 2>/dev/null \
      && f="$f expired-done-gate-open (a stranger released a live owner's expired claim)"
    # the SWEEP split: an expired claim must be absent from the [stale] state-fn (that list is what
    # posted hh-driver to the board at 16:37Z) and present in its own.
    [ -z "$(_cl_child --list-stale 2>/dev/null | grep -F "$_cl_gone")" ] \
      || f="$f expired-in-list-stale (the board [stale] cry would advertise a live owner reclaimable)"
    [ -n "$(_cl_child --list-expired 2>/dev/null | grep -F "$_cl_gone")" ] \
      || f="$f expired-missing-from-list-expired"
    [ "$(_cl_child --list 2>/dev/null | awk -F'\t' -v k="$_cl_gone" '$1==k{print $4}')" = EXPIRED ] \
      || f="$f expired-list-column (mesh-chat's [done] auto-release and the dash both read column 4)"
    # the census must not depend on WHO is reading it: the OWNER's own view of its own expired claim
    # is still EXPIRED, even though --check honestly calls it "yours". Live-measured on this node —
    # the first draft rendered LIVE here and the claim fell out of --list-expired entirely.
    [ "$(HOME="$_cl_home" MESH_CHAT_LOG="$_cl_board" MESH_CLAIM_STRIKE_DIR="$STRIKE_DIR" MESH_WHO="wlive@$HOST" \
         "$0" --list 2>/dev/null | awk -F'\t' -v k="$_cl_gone" '$1==k{print $4}')" = EXPIRED ] \
      || f="$f expired-census-hidden-from-its-own-owner"
    [ -n "$(HOME="$_cl_home" MESH_CHAT_LOG="$_cl_board" MESH_CLAIM_STRIKE_DIR="$STRIKE_DIR" MESH_WHO="wlive@$HOST" \
            "$0" --list-expired 2>/dev/null | grep -F "$_cl_gone")" ] \
      || f="$f expired-owner-view-missing-from-list-expired"
    # ABANDONED must still be reachable by the clock alone when liveness is UNKNOWABLE — a remote or
    # non-window owner has no evidence either way and nothing a nudge could reach, so the clock stays
    # the arbiter for that class. Without this the fix would make every remote claim immortal.
    mesh-mind-state(){ return 7; }   # ABSENT -> UNKNOWN
    set -- $(_resolve "$_cl_gone")
    [ "$1" = stale ] \
      || f="$f unknown-liveness-past-ttl-not-stale (a claim whose owner cannot be measured must still age out — got '$1')"
    [ "$5" = past-ttl-liveness-unknown ] \
      || f="$f unknown-liveness-wrong-evidence (it must not borrow the dead owner's word — got '$5')"
    # and a REAL abandonment past TTL is still ABANDONED, not softened into expired
    mesh-mind-state(){ return 5; }   # DEAD
    set -- $(_resolve "$_cl_gone")
    [ "$1" = stale ] || f="$f dead-owner-past-ttl-not-stale (got '$1')"
    [ "$5" = owner-dead-or-idle-past-strikes ] || f="$f dead-owner-wrong-evidence (got '$5')"
    # NOT IMMORTAL: the same claim, same lapsed clock, once its owner stops tending it. This is the
    # argument that liveness may veto the clock at all — EXPIRED decays into ABANDONED on its own.
    mesh-mind-state(){ printf 'IDLE\tready prompt, no turn running\n'; return 0; }
    touch -d "@1" "$_cl_gone"                                   # artifact untouched since the claim
    _strike_reset "$_cl_gone"
    set -- $(_resolve "$_cl_gone"); _cl_v1="$1"                 # sweep 1 — a glance is not a verdict
    mkdir -p "$STRIKE_DIR"; printf '%s|%s|%s|%s\n' "$_cl_ce" 1 1 1 > "$(_strike_path "$_cl_gone")"
    set -- $(_resolve "$_cl_gone"); _cl_v2="$1"                 # sweep 2, a real span later
    [ "$_cl_v1" = expired ] || f="$f expired-decay-first-sweep (got '$_cl_v1')"
    [ "$_cl_v2" = stale ]   || f="$f expired-never-decays-to-abandoned (an unrenewed claim whose owner walked away must become reclaimable — got '$_cl_v2'; without this the veto would mint immortal claims)"
    mesh-mind-state(){ printf 'WORKING\ta turn is running\n'; return 0; }
    touch "$_cl_gone"; _strike_reset "$_cl_gone"
    # and the same owner INSIDE its TTL is theirs/live — the ttl= a caller passes now actually decides
    printf '%s  wlive@%s  ::  [claim] %s ttl=7200\n' "$_cl_ts" "$HOST" "$_cl_gone" > "$_cl_board"
    set -- $(_resolve "$_cl_gone"); [ "$1" = theirs ] \
      || f="$f inside-ttl-swept (a live owner inside its TTL must be theirs — got '$1')"
    # (d) an IDLE owner inside its TTL whose artifact is in flight — the live 07:37 case, end-to-end
    mesh-mind-state(){ printf 'IDLE\tready prompt, no turn running\n'; return 0; }
    printf '%s  wrest@%s  ::  [claim] %s ttl=5400\n' "$(date -u -d '-20 min' +%FT%TZ)" "$HOST" "$_cl_busy" > "$_cl_board"
    touch "$_cl_busy"                                     # owner did work, then rested (mtime > claim epoch)
    set -- $(_resolve "$_cl_busy"); [ "$1" = theirs ] \
      || f="$f live-idle-claim-inside-ttl-swept (the exact 2026-07-15 07:37 mesh-room-gigaam case — got '$1')"
    # (e) provable death still fires IMMEDIATELY — no strikes, no artifact evidence, no waiting
    mesh-mind-state(){ return 5; }
    [ "$(owner_liveness "wdead@$HOST" "$_cl_gone" $(( _cl_now - 10 )) "$_cl_now")" = STALE ] \
      || f="$f dead-owner-needs-strikes (DEAD is real abandonment — must not wait for sweeps)"
    mesh-mind-state(){ return 8; }
    [ "$(owner_liveness "wdead@$HOST" "$_cl_gone" $(( _cl_now - 10 )) "$_cl_now")" = STALE ] \
      || f="$f dead-shell-owner-needs-strikes"
    mesh-mind-state(){ return 9; }
    [ "$(owner_liveness "wdead@$HOST" "$_cl_gone" $(( _cl_now - 10 )) "$_cl_now")" = STALE ] \
      || f="$f auth-dead-owner-needs-strikes"
    # --- RATE-LIMITED IS THE THIRD WORD (chat-review/rate-limited-owner-reads-live {#4cdb7881}) -----
    # Live case behind it: hh-browser, owner job@mesh-home, rendered EXPIRED 360m -> 450m and collected
    # 38 no-op nudges while its owner sat "SHED until 22:48Z (rate-limit wall, shed #2)". Every arm here
    # is written to go RED on the pre-fix code, where rc 6 fell to the catch-all and answered LIVE.
    mesh-mind-state(){ printf 'RATE-LIMITED\t--- SHED until 22:48Z (rate-limit wall, shed #2) ---\n'; return 6; }
    # (1) the WORD. LIVE was the defect; STALE would be the opposite defect.
    _cl_rl="$(owner_liveness "wlive@$HOST" "$_cl_gone" $(( _cl_now - 10 )) "$_cl_now")"
    [ "$_cl_rl" = HELD-INCAPABLE ] \
      || f="$f ratelimited-owner-word (a quota-shed owner must be HELD-INCAPABLE — LIVE mislabels a mind that cannot execute a turn, STALE hands its work to a second writer — got [$_cl_rl])"
    # (2) THE STRIKE COUNTER IS NOT RESET. This is the half of the defect that is invisible in the
    # verdict: the catch-all ran _strike_reset on EVERY sweep, so conviction could never accumulate
    # across a shed and an owner that never came back could never be convicted either.
    mkdir -p "$STRIKE_DIR"; printf '%s|%s|%s|%s\n' "$_cl_ce" 1 1 1 > "$(_strike_path "$_cl_gone")"
    owner_liveness "wlive@$HOST" "$_cl_gone" "$_cl_ce" "$_cl_now" >/dev/null
    [ -s "$(_strike_path "$_cl_gone")" ] \
      || f="$f ratelimited-resets-strikes (a shed sweep wiped the idle-conviction record — after this the owner can never be convicted no matter how long it stays away)"
    _strike_reset "$_cl_gone"
    # THE CHILD ARMS NEED THE STUB ON DISK, NOT THE SHELL FUNCTION. A child process inherits neither,
    # and $_cl_bin/mesh-mind-state still answers WORKING — so without this rewrite every _cl_child arm
    # below would measure the EXPIRED path and pass or fail for the wrong reason (measured: the first
    # run of this arm rendered 'expired:' from --check while the in-process word was already correct).
    printf '#!/bin/sh\nprintf "RATE-LIMITED\\t--- SHED until 22:48Z (rate-limit wall, shed #2) ---\\n"\nexit 6\n' \
      > "$_cl_bin/mesh-mind-state"; chmod +x "$_cl_bin/mesh-mind-state"
    # (3) INSIDE the hold: past TTL, but NOT reclaimable — the owner auto-resumes in minutes.
    printf '%s  wlive@%s  ::  [claim] %s ttl=60\n' "$_cl_ts" "$HOST" "$_cl_gone" > "$_cl_board"
    set -- $(_resolve "$_cl_gone")
    [ "$1" = held-incapable ] \
      || f="$f ratelimited-not-held-incapable (past TTL with a shed owner must resolve held-incapable — got [$1])"
    [ "$2" = 2 ] || f="$f ratelimited-wrong-rc (must ride rc 2 so every existing stand-down reader is right — got [$2])"
    [ "$5" = past-ttl-owner-rate-limited ] \
      || f="$f ratelimited-wrong-evidence (the verdict must name the measurement it rests on — got [$5])"
    # NEITHER RELEASED NOR NUDGED: absent from both lists mesh-claim-verify acts on, present in its own.
    [ -z "$(_cl_child --list-stale 2>/dev/null | grep -F "$_cl_gone")" ] \
      || f="$f ratelimited-in-list-stale (the [stale] cry would advertise a shed owner's work reclaimable)"
    [ -z "$(_cl_child --list-expired 2>/dev/null | grep -F "$_cl_gone")" ] \
      || f="$f ratelimited-in-list-expired (this list is the NUDGE feed — that is where the 38 no-op nudges came from, and a shed mind cannot read a nudge)"
    [ -n "$(_cl_child --list-held-incapable 2>/dev/null | grep -F "$_cl_gone")" ] \
      || f="$f ratelimited-missing-from-list-held-incapable (not acted on must not mean invisible)"
    [ "$(_cl_child --list 2>/dev/null | awk -F'\t' -v k="$_cl_gone" '$1==k{print $4}')" = HELD-INCAPABLE ] \
      || f="$f ratelimited-list-column"
    # the census must not depend on WHO reads it — classify() folds the owner's OWN held claim into
    # "yours", exactly the trap that once hid expired claims from their own owner.
    [ "$(HOME="$_cl_home" MESH_CHAT_LOG="$_cl_board" MESH_CLAIM_STRIKE_DIR="$STRIKE_DIR" MESH_WHO="wlive@$HOST" \
         "$0" --list 2>/dev/null | awk -F'\t' -v k="$_cl_gone" '$1==k{print $4}')" = HELD-INCAPABLE ] \
      || f="$f ratelimited-census-hidden-from-its-own-owner"
    # a stranger may neither TAKE it nor RELEASE it
    _cl_n0="$(grep -acF "[claim] $_cl_gone" "$_cl_board")"
    _cl_child "$_cl_gone" >/dev/null 2>&1; _cl_takerc=$?
    [ "$_cl_takerc" = 2 ] || f="$f ratelimited-claim-taken (a second writer must be refused — rc $_cl_takerc)"
    [ "$(grep -acF "[claim] $_cl_gone" "$_cl_board")" = "$_cl_n0" ] \
      || f="$f ratelimited-claim-posted (standing down must post NOTHING)"
    _done_gate "$_cl_gone" 0 2>/dev/null \
      && f="$f ratelimited-done-gate-open (a stranger released a shed owner's claim)"
    _cl_chk="$(_cl_child --check "$_cl_gone" 2>&1)"
    case "$_cl_chk" in held-incapable:*) : ;; *) f="$f ratelimited-check-render:[$_cl_chk]" ;; esac
    case "$_cl_chk" in *"→ reclaimable"*|*abandoned*) f="$f ratelimited-check-says-reclaimable:[$_cl_chk]" ;; esac
    # (4) AN ENDLESS SHED CONVERGES. The hold is bounded by arithmetic, so a claim whose owner never
    # comes back does become reclaimable — without this arm the fix would mint the immortal claim the
    # EXPIRED word was written to avoid.
    printf '%s  wlive@%s  ::  [claim] %s ttl=60\n' "$(date -u -d "-$(( 60 + INCAPABLE_HOLD + 600 )) sec" +%FT%TZ)" \
      "$HOST" "$_cl_gone" > "$_cl_board"
    set -- $(_resolve "$_cl_gone")
    [ "$1" = stale ] \
      || f="$f ratelimited-hold-never-expires (an endless shed must converge to reclaimable — got [$1])"
    [ "$5" = incapable-hold-exhausted ] \
      || f="$f ratelimited-converged-wrong-evidence (got [$5])"
    # (5) CONTROL — INSIDE its TTL a shed owner's claim is simply held, and the word still says why.
    printf '%s  wlive@%s  ::  [claim] %s ttl=7200\n' "$_cl_ts" "$HOST" "$_cl_gone" > "$_cl_board"
    set -- $(_resolve "$_cl_gone")
    [ "$1" = held-incapable ] || f="$f ratelimited-inside-ttl-wrong-verdict (got [$1])"
    [ "$5" = owner-rate-limited-within-ttl ] || f="$f ratelimited-inside-ttl-wrong-evidence (got [$5])"
    # (6) CONTROL — the other liveness words are UNMOVED by this arm: a WORKING owner past TTL is
    # still expired, a DEAD one still stale. Without these the new branch could swallow either.
    mesh-mind-state(){ printf 'WORKING\ta turn is running\n'; return 0; }
    printf '%s  wlive@%s  ::  [claim] %s ttl=60\n' "$_cl_ts" "$HOST" "$_cl_gone" > "$_cl_board"
    set -- $(_resolve "$_cl_gone"); [ "$1" = expired ] || f="$f ratelimited-arm-broke-expired (got [$1])"
    mesh-mind-state(){ return 5; }
    set -- $(_resolve "$_cl_gone"); [ "$1" = stale ] || f="$f ratelimited-arm-broke-dead (got [$1])"
    _strike_reset "$_cl_gone"
    # restore the on-disk stub for anything downstream that still uses a child
    printf '#!/bin/sh\nprintf "WORKING\\ta turn is running\\n"\nexit 0\n' > "$_cl_bin/mesh-mind-state"
    chmod +x "$_cl_bin/mesh-mind-state"
    unset -f mesh-mind-state
    # --- claim-test-take-path-escapes-the-fake-home-stub (chat-review, live leak 2026-08-28T21:07:33Z)
    # THE SANDBOX ASSERTION AT THE TOP OF THIS ARM IS NOT THE ARTIFACT. It proves the child READS the
    # fake board; it says nothing about where a WRITE lands. The leak is the proof: a fixture claim
    # stood in the LIVE claim table tagged stranger@, rendering LIVE for a window that does not exist,
    # while every read-side assertion here was green — and the ttl gave the route away (the fixture
    # SEEDS ttl=60, the leaked line carried the 7200 default, so it came from a real post, not the
    # seed). So stop inferring containment from a read and ASK THE REAL BOARD.
    # THE BOARD A LEAK LANDS IN IS mesh-chat'S OWN TARGET, never $BOARD: mesh-chat computes
    # ${MESH_DIR:-$HOME/.mesh}/chat.log (mesh-chat:58) and does not read MESH_CHAT_LOG at all, so the
    # env this arm hands its children cannot redirect a post — only a fake HOME can. $_cl_orig_board is
    # checked too, so a harness that DID move MESH_CHAT_LOG is still covered.
    # TIME-SCOPED ON THE WHO LEG, deliberately: the 21:07:33Z line still stands on this node's board,
    # and an unscoped WHO match would be a standing accusation about a leak already fixed — red forever
    # on every node that ever leaked, which is a node fact, not a code verdict. The per-run mktemp
    # prefix needs no clock: it cannot exist on the board unless THIS run put it there.
    for _cl_rb in "${MESH_DIR:-$HOME/.mesh}/chat.log" "$_cl_orig_board"; do
      [ -f "$_cl_rb" ] || continue
      case "$_cl_seen" in *"|$_cl_rb|"*) continue ;; esac
      _cl_seen="$_cl_seen|$_cl_rb|"
      _cl_leak="$(grep -F "$_cl_dir" "$_cl_rb" 2>/dev/null | head -3)"
      [ -z "$_cl_leak" ] \
        || f="$f test-leaked-fixture-key-to-real-board (a --test arm posted a scratch key to $_cl_rb: $_cl_leak)"
      _cl_leak="$(awk -v t0="$_cl_t0" -v h="$HOST" \
        '$1>=t0 && ($2=="stranger@"h || $2=="wlive@"h || $2=="wrest@"h || $2=="wdead@"h || $2=="w@"h || $2=="w2@"h)' \
        "$_cl_rb" 2>/dev/null | head -3)"
      [ -z "$_cl_leak" ] \
        || f="$f test-leaked-fixture-who-to-real-board (a --test arm posted as a fixture owner to $_cl_rb: $_cl_leak)"
    done
    BOARD="$_cl_orig_board"; WHO="$_cl_orig_who"; STRIKE_DIR="$_cl_orig_strike"
    rm -rf "$_cl_dir" "$_cl_board"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (valid_key, parse_latest body-anchor, is_stale_clock, classify, WHO-never-anon, + EXPIRED-IS-NOT-ABANDONED {#b2d997b4}: a WORKING owner past its TTL resolves 'expired' rc 2 carrying past-ttl-owner-live, --check never prints the reclaimable word for it, a second writer's claim STANDS DOWN and posts nothing, _done_gate refuses a stranger's release, it is absent from --list-stale (the board [stale] cry) and present in --list-expired with column 4 EXPIRED, an UNKNOWN-liveness owner past TTL is still stale with its OWN evidence word, a DEAD one is still stale, and an EXPIRED claim DECAYS to stale once its owner goes idle past its strikes so the liveness veto cannot mint an immortal claim, + trailing-colon-key rejected + extra-positional-arg rejected exit 64 w/ both tokens in the message, + --done ownership-gated: other's live claim refused exit 2 naming the owner / --force overrides / own claim + stale claim + unclaimed key still release clean, + donegate-caller-tag: same-user-different-caller-tag allowed to release, genuinely-different-user still refused, + owner_liveness: DEAD-SHELL and DEAD both resolve STALE, + claim-idle-is-not-abandoned: IDLE+touched-artifact stays LIVE, IDLE+untouched needs >=2 spaced sweeps (rapid re-check cannot stack), the TTL arm fires past-TTL and holds inside-TTL, DEAD/DEAD-SHELL/AUTH-DEAD still immediate, + RATE-LIMITED IS THE THIRD WORD {#4cdb7881}: a quota-shed owner resolves HELD-INCAPABLE (not LIVE, which mislabels a mind that cannot take a turn, and not STALE, which hands its work away), the idle-strike record is NOT wiped by a shed sweep so conviction survives it, the claim is absent from --list-stale AND from --list-expired (the nudge feed that produced 38 no-op nudges) but present in --list-held-incapable and column 4 even in its own owner's view, a second writer is refused and posts nothing, a stranger cannot release it, --check never says reclaimable, the hold is BOUNDED so an endless shed converges to stale carrying incapable-hold-exhausted, and the WORKING/DEAD arms are unmoved + the REAL board carries neither this run's scratch keys nor a fixture WHO after every sandboxed arm)"; exit 0 ;;

  --check)
    key="${2:-}"; valid_key "$key" || { echo "mesh-claim: invalid key (artifact id, no spaces): '$key'" >&2; exit 64; }
    set -- $(_resolve "$key"); verdict="$1"; code="$2"; owner="${3:-}"; age="${4:-0}"; why="${5:-}"
    case "$verdict" in
      unclaimed) echo "unclaimed: $key" ;;
      yours)     echo "yours: $key (held ${age}s$([ "$why" = past-ttl-owner-live ] && echo ' — TTL LAPSED; re-claim to renew it')" ;;
      theirs)    echo "theirs: $key — held by $owner (${age}s, live)" ;;
      # The two words the whole fix is for. They must never be paraphrased into each other: the
      # remedies are opposites, and the reader acts on the first word of the line.
      expired)   echo "expired: $key — held by $owner (${age}s), TTL LAPSED but the owner is LIVE (mesh-mind-state says it is tending this claim) → NOT reclaimable. Poke the owner to renew (mesh-claim $key --ttl <sec>) or hand it back (mesh-claim --yield $key); --force to override deliberately." ;;
      held-incapable) echo "held-incapable: $key — held by $owner (${age}s; $why), whose window is RATE-LIMITED (quota wall / keepalive shed) → NOT reclaimable and NOT nudgeable: the owner cannot read a nudge until it resumes. Wait for it, or take it deliberately with --force. It converts to reclaimable on its own once the hold is spent (TTL + ${INCAPABLE_HOLD}s)." ;;
      stale)     echo "stale: $key — $owner abandoned it (${age}s; $why) → reclaimable" ;;
    esac
    exit "$code" ;;

  --list)
    # active claims = a [claim] with no later [claim-done]/[yield], one line: key owner age LIVE/STALE
    keys="$(awk -v sep=' :: ' '
      { i=index($0,sep); if(i==0)next; msg=substr($0,i+4); sub(/^[ \t]+/,"",msg)
        if(msg ~ /^\[(claim|claim-done|yield)\] /){ b=msg; sub(/^\[[a-z-]+\] /,"",b); sub(/[ \t].*$/,"",b); print b } }
    ' "$BOARD" 2>/dev/null | sort -u)"
    [ -n "$keys" ] || exit 0
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      set -- $(_resolve "$key"); verdict="$1"; owner="${3:-}"; age="${4:-0}"; why="${5:-}"
      # --list is a CENSUS OF STATE, so column 4 keys on the evidence word ($5), never on the
      # ownership verdict. classify() folds an expired claim of YOUR OWN back into "yours" (correct
      # for --check and for the claim path — you are the one who renews it), and keying the census on
      # that made a mind's own expired claims render LIVE and vanish from --list-expired: the state
      # was measured and then discarded by the renderer, which is the same bug one layer out.
      case "$verdict" in
        theirs|yours) case "$why" in
                        past-ttl-owner-live) printf '%s\t%s\t%ss\tEXPIRED\n' "$key" "$owner" "$age" ;;
                        # same trap as EXPIRED one line up: classify() folds a mind's OWN
                        # held-incapable claim back into "yours", so a census keyed on the verdict
                        # would render it LIVE and drop it out of --list-held-incapable entirely.
                        owner-rate-limited-*|past-ttl-owner-rate-limited)
                                             printf '%s\t%s\t%ss\tHELD-INCAPABLE\n' "$key" "$owner" "$age" ;;
                        *)                   printf '%s\t%s\t%ss\tLIVE\n'    "$key" "$owner" "$age" ;;
                      esac ;;
        expired)      printf '%s\t%s\t%ss\tEXPIRED\n' "$key" "$owner" "$age" ;;
        held-incapable) printf '%s\t%s\t%ss\tHELD-INCAPABLE\n' "$key" "$owner" "$age" ;;
        stale)        printf '%s\t%s\t%ss\tSTALE\n'   "$key" "$owner" "$age" ;;
      esac
    done <<<"$keys"
    exit 0 ;;

  --list-stale)
    # the --sweep state-fn: ONLY stale (ABANDONED) active claims, DELTA-STABLE (no volatile age →
    # mesh-delta won't see a fresh delta every run just because seconds ticked; delta-channels-need-gate).
    # EXPIRED claims are NOT in here by construction — this list feeds the board [stale] "reclaimable"
    # cry and mesh-claim-verify's auto-RELEASE path, and both of those are the wrong remedy for a claim
    # whose owner is mid-turn. That mis-listing IS the 16:37Z hh-driver post.
    # "$0", never the bare name: `mesh-claim --list` resolves through PATH to the DEPLOYED binary, so
    # a source tree under test (or mid-deploy drift) has its sub-reads answered by a DIFFERENT version
    # of itself — measured here, where the deployed copy predated the EXPIRED column and this list
    # therefore still contained the very claims the fix removes from it.
    "$0" --list 2>/dev/null | awk -F'\t' '$4=="STALE"{printf "%s\towner=%s\tSTALE\n",$1,$2}'
    exit 0 ;;

  --list-expired)
    # the other half of the split: claims past TTL whose owner is measurably LIVE. Same delta-stable
    # shape as --list-stale so it can drive its own change-gated remedy (poke the owner to renew),
    # and deliberately a SEPARATE list rather than a column consumers must remember to filter.
    "$0" --list 2>/dev/null | awk -F'\t' '$4=="EXPIRED"{printf "%s\towner=%s\tEXPIRED\n",$1,$2}'
    exit 0 ;;

  --list-held-incapable)
    # the third list. It exists so a shed-owner claim is VISIBLE rather than merely absent from the
    # other two: a claim that is in neither --list-stale nor --list-expired is correctly not acted on,
    # but silence is how a held claim ages where nobody is looking. Same delta-stable shape.
    "$0" --list 2>/dev/null | awk -F'\t' '$4=="HELD-INCAPABLE"{printf "%s\towner=%s\tHELD-INCAPABLE\n",$1,$2}'
    exit 0 ;;

  --sweep)
    # STALE-SWEEP reflex (gf-borrowing-1 inc2). mesh-delta is the pure CHANGE-DETECTOR (debounce): an
    # unchanged stale-set emits NOTHING, so we never re-post (the gf-claim-sweep every-minute flood).
    # On a CHANGE we post ONE clean [stale] line; the chat mind reads it and reclaims/clears/redispatches.
    command -v mesh-delta >/dev/null 2>&1 || { echo "mesh-claim --sweep: mesh-delta not found" >&2; exit 0; }
    # The EXPIRED set rides this same cadence rather than asking mesh-autowire for a second cron line —
    # it is the same read of the same board, and a surfacing arm that needs its own scheduler is one
    # more thing that can silently never be wired. It runs FIRST because --sweep below exits early on
    # an unchanged stale-set, and an early return must not swallow the other half of the split.
    "$0" --sweep-expired >/dev/null 2>&1 || true
    export MESH_WHO="claim-sweep@$HOST"            # clean board attribution (not the bare $USER@host fallback)
    stale_now="$("$0" --list-stale 2>/dev/null)"
    delta="$(printf '%s\n' "$stale_now" | mesh-delta gf-claim-sweep 2>/dev/null)"
    [ -n "$delta" ] || exit 0                      # no change (or stale-set empty) → silent
    [ -n "${stale_now//[[:space:]]/}" ] || exit 0  # change was 'all cleared' → nothing to escalate
    n="$(printf '%s\n' "$stale_now" | grep -c .)"
    keys="$(printf '%s\n' "$stale_now" | awk -F'\t' '{print $1}' | paste -sd, -)"
    _post "[stale] claim-sweep: $n stale claim(s) — $keys — owner idle/dead, or past TTL with liveness unknown; reclaimable (mesh-claim --check <key>)"
    exit 0 ;;

  --sweep-expired)
    # EXPIRED surfacing. Its own mesh-delta channel (never gf-claim-sweep's) so the two sets cannot
    # debounce each other, and its own marker: [fyi], NOT [stale]. mesh-interpret's DETECTOR_MARKERS
    # ('stale|drift|fail|red|alert') turns a [stale] line into actionable reclaim/redispatch work —
    # which is precisely the wrong remedy here, and would re-introduce the bug through the board.
    command -v mesh-delta >/dev/null 2>&1 || { echo "mesh-claim --sweep-expired: mesh-delta not found" >&2; exit 0; }
    export MESH_WHO="claim-sweep@$HOST"
    exp_now="$("$0" --list-expired 2>/dev/null)"
    delta="$(printf '%s\n' "$exp_now" | mesh-delta gf-claim-sweep-expired 2>/dev/null)"
    [ -n "$delta" ] || exit 0
    [ -n "${exp_now//[[:space:]]/}" ] || exit 0
    n="$(printf '%s\n' "$exp_now" | grep -c .)"
    keys="$(printf '%s\n' "$exp_now" | awk -F'\t' '{print $1}' | paste -sd, -)"
    _post "[fyi] claim-sweep: $n EXPIRED claim(s) — $keys — TTL lapsed but the owner is LIVE and tending them. NOT reclaimable: poke the owner to renew (mesh-claim <key> --ttl <sec>) or --yield. Do not take this work."
    exit 0 ;;

  --done)
    # chat-review/claim-done-ownership-gate: --done used to release WHATEVER key it was handed, so
    # any caller could stand down another mind's still-LIVE claim (live 2026-07-06T15:11:40Z: genome
    # released turbo-lid@'s held actuator claim). _done_gate refuses a LIVE 'theirs' verdict (exit
    # 2, --force to override); yours/stale/unclaimed release exactly as before (no behavior change
    # for the common case: releasing your own claim, or clearing an already-stale one).
    key="${2:-}"; valid_key "$key" || { echo "mesh-claim: invalid key: '$key'" >&2; exit 64; }
    force=0; [ "${3:-}" = "--force" ] && force=1
    _done_gate "$key" "$force" || exit 2
    _strike_reset "$key"   # the key's lifecycle ended; a later re-claim starts its strike count clean
    _post "[claim-done] $key"; echo "released (done): $key"; exit 0 ;;

  --yield)
    key="${2:-}"; valid_key "$key" || { echo "mesh-claim: invalid key: '$key'" >&2; exit 64; }
    _strike_reset "$key"
    _post "[yield] $key"; echo "yielded: $key"; exit 0 ;;

  ""|-h|--help)
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;

  *)
    key="$1"; shift
    ttl="$(claim_args_ttl "$@")" || { echo "mesh-claim: unexpected extra argument(s) '$*' after key '$key' — a claim key is ONE token; a multi-word claim is always a caller formatting bug (e.g. 'mesh-claim genome: chat-review/mindstate-card-gate' silently claimed a phantom 'genome:' key live 2026-07-06T20:14:28Z)" >&2; exit 64; }
    valid_key "$key" || { echo "mesh-claim: invalid key (artifact id, no spaces): '$key'" >&2; exit 64; }
    set -- $(_resolve "$key"); verdict="$1"; owner="${3:-}"
    case "$verdict" in
      theirs)  echo "mesh-claim: '$key' already held by $owner (live) — standing down" >&2; exit 2 ;;
      # THE POINT OF THE WHOLE FIX: a lapsed clock is not an invitation. Standing down here is what
      # stops the second writer the 16:37Z [stale] post was inviting onto contended work.
      expired) echo "mesh-claim: '$key' held by $owner — its TTL lapsed, but the owner is LIVE and tending it. Standing down. Ask $owner to renew (mesh-claim $key --ttl <sec>) or --yield; --force is not a claim path — take it only after the owner goes idle/dead and it reads 'stale'." >&2; exit 2 ;;
      # a shed owner is even less of an invitation than a lapsed clock: it did not walk away, it was
      # taken off the keyboard by a quota wall and comes back on its own. Standing down here is what
      # keeps HELD-INCAPABLE from being STALE wearing a nicer word.
      held-incapable) echo "mesh-claim: '$key' held by $owner — its window is RATE-LIMITED (quota wall / keepalive shed), so it can neither tend nor release this right now. Standing down. It becomes reclaimable on its own once the hold is spent (TTL + ${INCAPABLE_HOLD}s); --force only if you mean to take live work." >&2; exit 2 ;;
      yours)   echo "already yours: $key (re-claim is a no-op; not re-posting)"; exit 1 ;;   # debounce: no spam
      *)       _post "[claim] $key ttl=$ttl"; echo "claimed: $key (ttl=${ttl}s)"; exit 0 ;;   # unclaimed or stale → take it
    esac ;;
esac
