    # WHO identity: NEVER anonymous, caller-distinguishing (chat-review/claim-anonymous-owner-aliasing)
    [ "$(_norm_tag '/home/x/mesh-cpu-throttle')" = "mesh-cpu-throttle" ] || f="$f tag-basename"
    [ "$(_norm_tag '')" = "cron" ]                                       || f="$f tag-empty"   # never empty
    [ "$(_norm_tag '/bin/bad;name here')" = "bad_name_here" ]            || f="$f tag-sanitize"  # no unsafe chars/spaces
    [ "$(_norm_tag 'mesh-a')" != "$(_norm_tag 'mesh-b')" ]              || f="$f tag-distinct"  # two callers -> two tags
    who="$(MESH_WHO= USER= derive_who)"                                  # simulate cron: both unset
    case "$who" in *'?'*|*' '*) f="$f who-anon" ;; esac                  # falsify: old fallback minted '?@host'
