#!/usr/bin/env bash
# mesh-claim — real CLAIMS on the mesh-chat board ("the bus IS the lock"), upgrading the weak
# [taking] marker into a claim with TTL + LIVENESS + an artifact KEY. Borrowing #1 from the
# operator's work mesh (guy-fawxible / Foxible), re-derived as OUR tool over OUR mesh-chat markers
# — never their repo/instance. Fixes the double-dispatch / two-minds-race-same-task bug
# (parallel-minds-same-goal-different-file): before working an artifact, claim it; a peer's --check
# sees the live claim and stands down.
#
# Why a claim beats a bare [taking]:
#   - KEY MUST BE AN ARTIFACT (alert id, repo+run, card id, file path, design slug) — never free
#     text. A claim names the THING, so two minds aiming at the same goal collide on the same key.
#   - TTL: a claim ages out (default 2h) so a forgotten claim never blocks the artifact forever.
#   - LIVENESS beats the clock: if the claimer's mind window is provably DEAD (via mesh-mind-state),
#     the claim is STALE immediately — it walked away — without waiting for the TTL.
#
# IDLE IS NOT ABANDONED (chat-review/claim-idle-is-not-abandoned, 2026-07-15). The liveness arm used to
# read a bare `mesh-mind-state <win> | grep -qiw IDLE` as "walked away" → STALE. But mesh-mind-state
# prints "IDLE  ready prompt, no turn running" for EVERY mind BETWEEN TURNS, and CLAUDE.md's
# end-of-session protocol MANDATES exactly that resting state — so "walked away" and "finished this
# turn, work still in flight" were the SAME STRING. Every claim went STALE at the first sweep after its
# owner's turn ended, which meant the TTL arm (is_stale_clock) was DEAD CODE: no claim ever survived
# long enough to reach its own clock, so every ttl= a caller passed was decoration. Live proof
# (2026-07-15 07:37:02 sweep): scripts/mesh-model-watch swept at 74min of a 120min ttl, and
# scripts/mesh-room-gigaam swept at 20min of a 90min ttl — both re-cried at 07:47 and 07:57.
# The fix: IDLE alone is only a HINT. An IDLE owner's claim goes stale only when ALL of:
#   1. the owner reads IDLE (not WORKING/NEEDS-INPUT), AND
#   2. the claimed artifact's mtime has NOT moved since the claim epoch (a touched artifact is
#      work-in-flight — the owner did something and is resting between turns), AND
#   3. IDLE has been observed across >= MESH_CLAIM_IDLE_STRIKES (2) sweeps, spanning >=
#      MESH_CLAIM_IDLE_MIN_SPAN (300s) — one glance at a resting mind is not abandonment, and the
#      span keeps two rapid `--check` calls from convicting a live owner in seconds.
# DEAD (5) / DEAD-SHELL (8) / AUTH-DEAD (9) still fire IMMEDIATELY — those are real abandonment,
# process-truth, not an inference from a resting prompt.
#
# Claims are board markers (so every node sees them, decay on reboot like the rest of the bus):
#   [claim] <key> ttl=<seconds>      a claim (owner = the board WHO field, i.e. the poster)
#   [claim-done] <key>               released by completion
#   [yield] <key>                    released without completing (handing it back)
# The ACTIVE claim for a key = its latest [claim] with no later [claim-done]/[yield].
#
# Usage:
#   mesh-claim <key> [--ttl <sec>]   claim <key> (refuses if someone else holds a LIVE claim; exit 2)
#   mesh-claim --done <key>          mark your claim complete
#   mesh-claim --yield <key>         release your claim without completing
#   mesh-claim --check <key>         status only, no post — prints verdict, sets exit code:
#                                      0 unclaimed · 1 yours · 2 theirs(live) · 2 expired · 3 stale
#                                      (expired shares rc 2 on purpose — see EXPIRED IS NOT ABANDONED)
#   mesh-claim --list                active (unreleased) claims, one per line: key  owner  age  LIVE/EXPIRED/STALE
#   mesh-claim --test                smoke test (pure: valid_key / parse_latest / classify / is_stale)
#
#   mesh-claim --list-stale          ONLY stale (ABANDONED) active claims, delta-stable lines:
#                                      "<key>\towner=<who>\tSTALE" — the --sweep state-fn
#   mesh-claim --list-expired        ONLY EXPIRED active claims (past TTL, owner LIVE) — same shape,
#                                      the --sweep-expired state-fn. Poke the owner; never take it.
#   mesh-claim --list-held-incapable ONLY HELD-INCAPABLE active claims (owner window RATE-LIMITED /
#                                      quota-shed) — same shape. Neither take it nor nudge it: the
#                                      owner cannot read a nudge. It converts to reclaimable by
#                                      itself once TTL + MESH_CLAIM_INCAPABLE_HOLD is spent.
#   mesh-claim --sweep-expired       surfaces newly-EXPIRED claims as a [fyi] line (NOT [stale] —
#                                      [stale] is a mesh-interpret detector marker and means "take it")
#   mesh-claim --sweep               STALE-SWEEP reflex (increment 2): surfaces newly-stale claims to
#                                      the board as a clean [stale] line, DEBOUNCED — uses mesh-delta as
#                                      a pure change-detector so an unchanged stale-set posts NOTHING.
#                                      The chat mind reads [stale] and re-dispatches/reclaims/clears
#                                      (deterministic detect → mind interprets; главный-закон pattern).
#
# debounce: the verbs (claim/done/yield) post only on the explicit action and never re-post; --sweep
# posts a [stale] line ONLY when the stale-set CHANGES (mesh-delta gate) — the guy-fawxible-claim-sweep
# every-minute-identical-line flood is the negative example we will NOT reproduce.
#
# reflex-cadence: 7-59/10 * * * *
# reflex-args: --sweep
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron PATH gap: --sweep calls bare `mesh-delta`, absent from cron's minimal PATH (the claim.log "mesh-delta not found" doctor FAIL)

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
HOST="$(hostname)"

# --- WHO identity: NEVER mint an anonymous '?' (chat-review/claim-anonymous-owner-aliasing) --------
# The old fallback `${USER:-?}@host` minted `?@host` when USER is unset (every cron reflex). Two such
# anonymous claimants share ONE WHO, so classify() (:146) reads owner==me as "yours" for BOTH — the
# single-writer guard is VOID exactly where reflexes claim. Fix: derive a real, caller-DISTINGUISHING
# identity — the login user (id -un, always resolvable even when $USER is unset) tagged with the CALLER
# (parent script's arg0), so two different cron reflexes get two different WHOs and '?' can never appear.
_norm_tag() {  # pure: raw caller string -> sanitized, bounded tag; NEVER empty (falls back to 'cron')
  local base
  base="$(basename -- "${1:-}" 2>/dev/null)"
  base="$(printf '%s' "$base" | tr -c 'A-Za-z0-9._-' '_')"
  base="${base#_}"; base="${base%_}"; base="${base:0:24}"
  [ -n "$base" ] && printf '%s' "$base" || printf 'cron'
}
_caller_raw() {  # impure: the parent's script/arg0 (mesh-cpu-throttle), preferred over the bash/sh interpreter
  local pp="$PPID" c
  c="$(tr '\0' '\n' < "/proc/$pp/cmdline" 2>/dev/null \
       | grep -avE '^-|^/usr/bin/env$|(^|/)(env|bash|sh|dash)$' | head -1)"
  [ -n "$c" ] || c="$(ps -o comm= -p "$pp" 2>/dev/null)"
  printf '%s' "$c"
}
derive_who() {  # honor MESH_WHO; else <login-user>/<caller>@host — NEVER '?', caller-distinguishing
  [ -n "${MESH_WHO:-}" ] && { printf '%s' "$MESH_WHO"; return; }
  local u; u="${USER:-}"; [ -n "$u" ] || u="$(id -un 2>/dev/null)"; [ -n "$u" ] || u="uid$(id -u 2>/dev/null || echo 0)"
  printf '%s/%s@%s' "$u" "$(_norm_tag "$(_caller_raw)")" "$HOST"
}
WHO="$(derive_who)"
DEFAULT_TTL="${MESH_CLAIM_TTL:-7200}"        # 2h default; a claim older than this with no liveness signal is stale
SEP=" :: "                                    # mesh-chat field separator (ts<2sp>who<2sp>::<sp>msg)

# --- IDLE-strike state (claim-idle-is-not-abandoned) ------------------------------------------------
# An IDLE reading is a hint, not a verdict; convicting a claim needs the SAME hint across >=2 sweeps.
# That needs state ACROSS sweeps — and the persistence trap (the mesh-guardian lesson, 09f7914) is that
# a test writing the artifact a watchdog reads for liveness FORGES its own evidence. Here the liveness
# signal under test is the CLAIMED ARTIFACT's mtime; the strike file is a SEPARATE, dedicated path that
# is never read as liveness by anything — and MESH_CLAIM_STRIKE_DIR gives --test its own dir so the
# suite never touches the real strike state.
STRIKE_DIR="${MESH_CLAIM_STRIKE_DIR:-$HOME/.mesh/claim-idle-strikes}"
IDLE_STRIKES_REQUIRED="${MESH_CLAIM_IDLE_STRIKES:-2}"   # sweeps of IDLE needed before "abandoned"
IDLE_MIN_SPAN="${MESH_CLAIM_IDLE_MIN_SPAN:-300}"        # min seconds between counted strikes (sweep cadence is 10m)
# HELD-INCAPABLE hold bound (chat-review/rate-limited-owner-reads-live {#4cdb7881}). A quota-shed owner
# is neither tending its claim nor gone, so the hold must be BOUNDED BY ARITHMETIC, not open-ended:
# channel-keepalive pauses a shed mind for 1800s and gives up after 3 tries (MESH_AUTH_GIVEUP=3), so
# three shed windows past the claim's own TTL is the point at which "it returns in minutes" has been
# falsified by measurement. Past that the clock takes the claim back — an endless shed CONVERGES.
INCAPABLE_HOLD="${MESH_CLAIM_INCAPABLE_HOLD:-5400}"     # extra seconds past TTL a rate-limited owner keeps its claim

_strike_path() { printf '%s/%s' "$STRIKE_DIR" "$(printf '%s' "${1:-}" | tr -c 'A-Za-z0-9._-' '_')"; }
_strike_reset() { rm -f "$(_strike_path "${1:-}")" 2>/dev/null; return 0; }

# _artifact_mtime — impure: the claimed key's mtime epoch, or EMPTY when the key names no file on this
# node. A key is often an artifact path (scripts/mesh-claim) but may be an abstract id (alert:ds-freeze-
# 2026); an abstract key simply carries no mtime evidence and falls through to the strike rule alone.
_artifact_mtime() {
  local k="${1:-}" p
  [ -n "$k" ] || return 0
  case "$k" in
    /*) [ -e "$k" ] && stat -c %Y "$k" 2>/dev/null; return 0 ;;
  esac
  for p in "$k" "${MESH_GENOME:-$HOME/lte-workstation}/$k"; do
    [ -e "$p" ] && { stat -c %Y "$p" 2>/dev/null; return 0; }
  done
  return 0
}

# _idle_strikes — record ONE observation of (key IDLE, artifact untouched) and print the resulting
# strike count. Pure w.r.t. its args (all of epoch/mtime/now are passed in, never read from the clock)
# so --test can drive it deterministically. The record is keyed on (claim_epoch, artifact_mtime): a
# re-claim or a touched artifact makes the stored record stale and restarts the count at 1. A strike is
# only COUNTED when >= IDLE_MIN_SPAN has passed since the last counted one, so a burst of --check calls
# cannot stack strikes and convict a live owner.
_idle_strikes() {  # <key> <claim_epoch> <artifact_mtime> <now> -> prints count
  local key="${1:-}" ce="${2:-0}" mt="${3:-0}" now="${4:-0}" rec sce smt cnt last
  mkdir -p "$STRIKE_DIR" 2>/dev/null
  local file; file="$(_strike_path "$key")"
  rec="$(cat "$file" 2>/dev/null)"
  IFS='|' read -r sce smt cnt last <<<"${rec:-}"
  if [ "${sce:-}" != "$ce" ] || [ "${smt:-}" != "$mt" ]; then
    cnt=1; last="$now"                                   # new claim / artifact moved → restart
  elif [ $(( now - ${last:-0} )) -ge "$IDLE_MIN_SPAN" ]; then
    cnt=$(( ${cnt:-0} + 1 )); last="$now"                # a genuinely separate sweep
  else
    cnt="${cnt:-1}"                                      # same sweep window → no double-count
  fi
  printf '%s|%s|%s|%s\n' "$ce" "$mt" "$cnt" "$last" > "$file" 2>/dev/null
  printf '%s\n' "$cnt"
}

# --- pure: an artifact key is a single token, never free text (no spaces), bounded, sane charset ----
valid_key() {  # <key> -> 0 valid / 1 invalid
  local k="${1:-}"
  [ -n "$k" ] || return 1
  case "$k" in --* | *[!A-Za-z0-9._:/#-]* | *" "*) return 1 ;; esac  # reject flag-shaped tokens: a leading '--' is an unknown/typo'd flag (--release/--bogus), never a legit artifact id — else the dispatch default (:262) claims it as a phantom key (chat-review/claim-unknown-flag-phantom)
  case "$k" in *:) return 1 ;; esac  # reject a TRAILING colon (chat-review/claim-trailing-colon-key 2026-07-06): interior colons stay legit (alert:ds-freeze-2026), but a trailing ':' is always a WHO/label-prefix artifact ('genome:' from a mis-typed '[taking]'-style call), never a real key — live 2026-07-06T20:14:28Z 'mesh-claim genome: chat-review/mindstate-card-gate' created exactly this phantom
  [ "${#k}" -le 120 ] || return 1
  return 0
}

# claim_args_ttl — pure: parse the positional args AFTER the key on the default claim path. Prints the
# resolved ttl and returns 0, or returns 1 (silent) on any unrecognized extra token — a claim key is ONE
# token; a second bare positional is always a caller formatting bug, never a legit second argument. The
# old inline loop silently `shift`ed away anything it didn't recognize (chat-review/claim-trailing-colon-
# key 2026-07-06): 'mesh-claim genome: chat-review/mindstate-card-gate' claimed key 'genome:' and threw
# the real key away with zero warning — the phantom then aged into a [stale] cry every claim-sweep.
claim_args_ttl() {
  local ttl="$DEFAULT_TTL"
  while [ $# -gt 0 ]; do
    case "$1" in
      --ttl) ttl="${2:-$DEFAULT_TTL}"; shift 2 ;;
      *) return 1 ;;
    esac
  done
  printf '%s\n' "$ttl"
}

# --- pure: from board lines on STDIN, emit the LATEST lifecycle event for <key> as "type|who|epoch|ttl"
# (type = claim|done|yield; empty output = no event = unclaimed). Marker is BODY-ANCHORED (right after
# the ' :: ' separator) so prose quoting "[claim]" never false-matches (board-marker-grep-must-anchor).
#
# LITERATURE (genome, 2026-07-01, distributed-coordination critique — HELD, 0 behavior change): "LATEST"
# here means tail -1 over whatever order the board happens to be in — locally that's true append order,
# but mesh-chat-sync's cross-node merge (`LC_ALL=C sort -u` on the FULL line) resorts by the line's TEXT,
# starting with its wall-clock timestamp. Two claim-lifecycle events for the SAME key from DIFFERENT
# nodes stamped the same second (routine at claim/release cadence, and worse under any clock skew) don't
# tie-break on causal truth — sort falls through to the next differing byte, i.e. the WHO field,
# lexicographically. A clock-behind node's genuinely-LATER [claim-done] can sort BEFORE the [claim] it
# releases post-merge, flipping mesh-claim's verdict for a cross-node claim — exactly the double-dispatch
# class this tool exists to prevent ([[parallel-minds-same-goal-different-file]]), just the cross-node-
# clock-skew instance of it, which single-node use never hits (append order = real order there).
# The missing concept: HYBRID LOGICAL CLOCKS (Kulkarni, Demirbas, Madappa, Avva, Leone, "Logical Physical
# Clocks and Consistent Snapshots in Globally Distributed Databases", OPODIS 2014, LNCS 8878:17-32) — a
# (physical_ms, logical_counter) pair, monotonic and NTP-close like a wall clock but tie-broken like a
# Lamport clock: the logical counter increments whenever two events land on the same physical tick (or a
# received timestamp is >= the local clock), giving a total order consistent with happens-before without
# full vector-clock state. DISTINCT from every mesh-chat-sync citation (`scripts/mesh-chat-sync:5-22` G-Set
# convergence, `:30-35` PBS t-visibility, `:44-58` Bayou session guarantees, `:170-182` Merkle anti-entropy)
# — none of those order events WITHIN one key; they converge/measure/verify the SET, not a per-key register.
# HELD (steward-gated, wire-format change touching every mesh-chat writer): stamp claim/done/yield lines
# with an HLC-lite suffix (`hlc=<physical_epoch>.<logical>`, logical bumped only on a same-tick collision
# or a received hlc >= local) and have parse_latest tie-break on hlc instead of raw board order — makes
# "latest" merge-order-independent and causally sound. Not shipped: needs a shared HLC-state file per
# writer + touches mesh-chat's post path, a scope decision for the steward, not a solo genome edit.
parse_latest() {  # <key>  (reads board on stdin)
  local key="$1"
  awk -v key="$key" '
    {
      i = index($0, " :: "); if (i == 0) next
      meta = substr($0, 1, i-1); msg = substr($0, i+4)
      sub(/[ \t]+$/, "", meta); sub(/^[ \t]+/, "", msg)   # board sep is "  ::  " (2sp) — trim the stray space
      # who = last whitespace-run-delimited field of meta; ts = first field
      ts = meta; sub(/[ \t].*$/, "", ts)
      who = meta; sub(/^.*[ \t]/, "", who)
      type = ""
      if (msg ~ /^\[claim\] /)       type = "claim"
      else if (msg ~ /^\[claim-done\] /) type = "done"
      else if (msg ~ /^\[yield\] /)  type = "yield"
      else next
      # first token of the marker body is the key
      body = msg; sub(/^\[[a-z-]+\] /, "", body)
      k = body; sub(/[ \t].*$/, "", k)
      if (k != key) next
      ttl = ""
      if (match(msg, /ttl=[0-9]+/)) ttl = substr(msg, RSTART+4, RLENGTH-4)
      print type "|" who "|" ts "|" ttl
    }
  ' | tail -1
}

# --- liveness: is the OWNER mind still tending its claim? STALE if its window is IDLE or DEAD/ABSENT.
# Only resolvable for a LOCAL-host owner (window@thishost); a remote owner falls back to TTL (prints "").
owner_liveness() {  # <who> [<key> <claim_epoch> <now>]  ->  prints LIVE|STALE|UNKNOWN
  local who="$1" win="${1%@*}" ohost="${1##*@}" key="${2:-}" ce="${3:-0}" now="${4:-0}"
  [ "$ohost" = "$HOST" ] || { echo UNKNOWN; return; }   # remote owner: clock-only, not liveness
  command -v mesh-mind-state >/dev/null 2>&1 || { echo UNKNOWN; return; }
  mesh-mind-state "$win" >/dev/null 2>&1
  case "$?" in
    5)   echo STALE ;;          # DEAD pane → the claimer window existed and is gone
    8)   echo STALE ;;          # DEAD-SHELL (chat-review/shed-pane-dead-shell-misclassified 2026-07-07):
                                # process-truth confirms no mind engine at all — MORE certain than plain
                                # DEAD, not less. Without this the default branch below falls through
                                # (DEAD-SHELL never contains the word "IDLE") to LIVE — a shed/killed
                                # owner's claim would never age out.
    9)   echo STALE ;;          # AUTH-DEAD (chat-review/mindstate-loggedout-not-idle): owner window is
                                # LOGGED OUT — can't act on its claim until a human re-logs it in. Same
                                # default-branch trap as DEAD-SHELL (AUTH-DEAD text never contains "IDLE"),
                                # so without this arm a logged-out owner's claim reads LIVE forever.
    6)   # RATE-LIMITED — THE THIRD WORD (chat-review/rate-limited-owner-reads-live {#4cdb7881},
         # filed by witness 2026-08-30 off a live case: hh-browser, owner job@mesh-home, read EXPIRED
         # 360m -> 450m while its owner sat "SHED until 22:48Z (rate-limit wall)" and collected 38
         # no-op nudges). Before this arm there was no case for 6, so a quota-shed owner fell to the
         # '*)' catch-all below, whose ONLY test is `grep -qiw IDLE` — a shed banner never contains
         # the word IDLE, so the branch ran `_strike_reset; echo LIVE; return` and did TWO wrongs at
         # once: it labelled a mind that cannot execute a turn as tending its claim, AND it wiped the
         # strike record on EVERY sweep, so conviction could never accumulate across the shed.
         #
         # STALE is the wrong word too, and in the opposite direction: it would hand a second window
         # a resource whose owner auto-resumes in minutes — the single-writer break this file's
         # EXPIRED arm already exists to prevent. Neither LIVE nor STALE is true, so the answer is a
         # WORD, not a threshold: HELD-INCAPABLE — held, and the holder cannot act. _resolve turns it
         # into a claim that is neither released nor nudged, with its reason named, under a BOUNDED
         # hold (INCAPABLE_HOLD) so an endless shed still converges to abandoned.
         #
         # It touches the strike record in NEITHER direction. Not reset — that reset is half the
         # defect. Not incremented either: the strike counter is the IDLE conviction ladder, and a
         # shed pane is not idle; incrementing here would convict on evidence of a different fault.
         # Left alone, whatever conviction the owner had accrued before the shed is still standing
         # when it resumes, which is the accumulation the reset destroyed.
         echo HELD-INCAPABLE ;;
    7)   echo UNKNOWN ;;        # ABSENT: no such window — a reflex/non-window owner, NOT provably dead → clock only
    4)   echo LIVE  ;;          # NEEDS-INPUT: blocked but alive — keep the claim (clock can still age it)
    *)   # 0 = WORKING/IDLE/UNKNOWN. IDLE is a HINT, NOT a verdict (claim-idle-is-not-abandoned): every
         # mind reads "IDLE  ready prompt, no turn running" between turns, exactly as the end-of-session
         # protocol mandates. Convict only on IDLE + artifact-untouched-since-claim + >=2 spaced sweeps.
         if ! mesh-mind-state "$win" 2>/dev/null | grep -qiw IDLE; then
           _strike_reset "$key"; echo LIVE; return          # WORKING/other → tending it, clear the record
         fi
         local mt; mt="$(_artifact_mtime "$key")"
         if [ -n "$mt" ] && [ "$mt" -gt "$ce" ] 2>/dev/null; then
           _strike_reset "$key"; echo LIVE; return          # artifact moved since the claim → work in flight
         fi
         local n; n="$(_idle_strikes "$key" "$ce" "${mt:-0}" "$now")"
         if [ "$n" -ge "$IDLE_STRIKES_REQUIRED" ] 2>/dev/null; then echo STALE; else echo LIVE; fi ;;
  esac
}

# --- pure: stale by the CLOCK? claim epoch + ttl < now. (liveness is layered on top by the caller) ---
is_stale_clock() {  # <claim_epoch> <ttl> <now> -> 0 stale / 1 fresh
  local ce="${1:-0}" ttl="${2:-0}" now="${3:-0}"
  [ "$ce" -gt 0 ] 2>/dev/null || return 1
  [ "$ttl" -gt 0 ] 2>/dev/null || ttl="$DEFAULT_TTL"
  [ $(( ce + ttl )) -lt "$now" ] && return 0 || return 1
}

# --- EXPIRED IS NOT ABANDONED (task {#b2d997b4}, live-reproduced 2026-08-28T16:57Z) -----------------
# The sibling of IDLE-IS-NOT-ABANDONED one ring down, and it was hiding inside the fix for it. _resolve
# layered liveness over the clock as a ONE-WAY arm:
#     if [ "$live" = STALE ]; then stale=1; elif is_stale_clock ...; then stale=1; fi
# LIVE could only fail to ADD staleness — it could never VETO the clock. So the tool HELD the
# measurement that the owner was tending its claim and then discarded it: hh-driver, owner
# senses@mesh-home, claim 15:31:59Z ttl=3600 — mesh-mind-state read WORKING (a turn 53s in) while
# --check printed "abandoned it (4978s) -> reclaimable" and --sweep posted it [stale] to the board at
# 16:37Z, inviting a second writer onto contended work. That is the single-writer discipline breaking
# from the inside, and it is worse than the IDLE bug it grew out of: the idle arm demands strikes AND
# artifact evidence before convicting, while the clock arm convicted a provably WORKING owner on no
# evidence at all.
#
# The missing thing is a WORD, not a fifth threshold. Two states, OPPOSITE remedies:
#   ABANDONED (stale, rc 3)  — the owner is gone: DEAD/DEAD-SHELL/AUTH-DEAD, or IDLE past its strikes,
#                              or past TTL with liveness UNKNOWN (remote/non-window owner — no evidence
#                              either way, and nothing will ever poke a reflex to renew). -> TAKE IT.
#   EXPIRED   (expired, rc 2) — the TTL lapsed but the owner is measurably LIVE and tending it.
#                              -> DO NOT TAKE IT. Poke the owner to renew (mesh-claim <key> --ttl N),
#                              --yield, or --force past the guard deliberately.
# A claim can NOT become immortal this way: an owner that stops tending goes IDLE, and the idle arm
# (untouched artifact + >=MESH_CLAIM_IDLE_STRIKES spaced sweeps) converts EXPIRED -> ABANDONED within a
# couple of sweeps. Liveness vetoes the clock; it does not repeal it.
#
# rc: EXPIRED deliberately reuses code 2 (theirs/live) rather than minting a 4th code. A new sentinel
# outruns every consumer allowlist ([[a-new-verdict-word-must-be-in-the-consumers-alphabet]]), and 2 is
# the one code whose existing meaning — "someone else holds this, stand down" — is already the CORRECT
# behavior for a live owner. Every rc reader (mesh-dms _fence_ok, mesh-interpret already_tracked) gets
# the right answer with no change. The distinct REMEDY travels in the verdict WORD, which the text
# readers (--check, --list, mesh-exit-node-lan-heal, mesh-claim-verify) are swept for below.

# --- pure: final verdict from (last event type, owner, me, state-word) -> "<verdict> <code>" ---------
classify() {  # <type> <owner> <me> <live|expired|abandoned>  ->  prints "verdict code"
  local type="${1:-}" owner="${2:-}" me="${3:-}" state="${4:-live}"
  case "$type" in
    ""|done|yield) echo "unclaimed 0" ;;
    claim)
      case "$state" in
        abandoned) echo "stale 3" ;;
        # yours-and-expired is still YOURS: you are the one who would renew it, and a re-claim is the
        # renewal. Only a STRANGER needs the expired word, because only a stranger might take it.
        expired)   if [ "$owner" = "$me" ]; then echo "yours 1"; else echo "expired 2"; fi ;;
        # held-incapable rides rc 2 for the same reason expired does: 2 already means "someone else
        # holds this, stand down", which is the correct behavior, and a 4th sentinel would outrun
        # every consumer allowlist ([[a-new-verdict-word-must-be-in-the-consumers-alphabet]]). The
        # distinct REMEDY — do not take it AND do not nudge it, the owner cannot read a nudge —
        # travels in the WORD, which the text readers below are swept for.
        held-incapable) if [ "$owner" = "$me" ]; then echo "yours 1"; else echo "held-incapable 2"; fi ;;
        *)         if [ "$owner" = "$me" ]; then echo "yours 1"; else echo "theirs 2"; fi ;;
      esac ;;
    *) echo "unclaimed 0" ;;
  esac
}

# --- resolve a key's current state into "verdict code owner age why" (the shared read path) ----------
# Field 5 (why) is the EVIDENCE CLASS the verdict rests on, so a renderer can never write down
# "abandoned" over a measurement that says the opposite. Every field is non-empty (owner falls back to
# '-'): callers read by POSITION, and an empty field would shift every field after it.
_resolve() {  # <key>  ->  echoes: verdict code owner age why
  local key="$1" rec type who ts ttl epoch now age live state why
  rec="$(parse_latest "$key" < "$BOARD" 2>/dev/null)"
  now="$(date +%s)"
  if [ -z "$rec" ]; then echo "unclaimed 0 - 0 no-claim"; return; fi
  IFS='|' read -r type who ts ttl <<<"$rec"
  epoch="$(date -d "$ts" +%s 2>/dev/null || echo 0)"
  age=$(( now - epoch )); [ "$age" -ge 0 ] || age=0
  state=live; why=released
  if [ "$type" = claim ]; then
    why=owner-live
    live="$(owner_liveness "$who" "$key" "$epoch" "$now")"
    if [ "$live" = STALE ]; then
      state=abandoned; why=owner-dead-or-idle-past-strikes   # POSITIVE evidence the owner walked away
    elif [ "$live" = HELD-INCAPABLE ]; then
      # A quota-shed owner. It vetoes the clock the way LIVE does — a claim must not be handed to a
      # second writer while its owner auto-resumes in minutes — but the veto is BOUNDED, because
      # "incapable" is the one liveness word that carries no promise the owner will ever act. Past
      # TTL + INCAPABLE_HOLD the hold is spent and the clock takes the claim back, so an endless
      # shed converges to abandoned instead of minting the immortal claim the EXPIRED arm warns of.
      if is_stale_clock "$epoch" "$(( ${ttl:-$DEFAULT_TTL} + INCAPABLE_HOLD ))" "$now"; then
        state=abandoned; why=incapable-hold-exhausted
      elif is_stale_clock "$epoch" "${ttl:-$DEFAULT_TTL}" "$now"; then
        state=held-incapable; why=past-ttl-owner-rate-limited
      else
        state=held-incapable; why=owner-rate-limited-within-ttl
      fi
    elif is_stale_clock "$epoch" "${ttl:-$DEFAULT_TTL}" "$now"; then
      # THE VETO. Past TTL is not by itself abandonment — it is only abandonment when nothing
      # contradicts it. A LIVE owner is exactly that contradiction, and discarding it was the bug.
      if [ "$live" = LIVE ]; then state=expired;   why=past-ttl-owner-live
      else                        state=abandoned; why=past-ttl-liveness-unknown; fi
      # liveness UNKNOWN = a remote owner (mesh-mind-state can't see another node) or a non-window
      # reflex identity (ABSENT). We have no evidence either way, and no owner a nudge could reach, so
      # the clock stays the only arbiter for that class — unchanged behavior, but it now SAYS so
      # instead of borrowing the dead owner's word.
    fi
  fi
  set -- $(classify "$type" "$who" "$WHO" "$state")
  echo "$1 $2 ${who:--} $age $why"
}

_post() { mesh-chat "$1" >/dev/null; }   # canonical arg form (the whole codebase posts this way)

# _principal <who> — strip the caller-DISTINGUISHING /<caller> tag (chat-review/donegate-caller-tag,
# live-reproduced 2026-07-06T22:44Z): derive_who mints "<user>/<caller>@<host>" so two DIFFERENT cron
# reflexes sharing one unix user don't alias to one anonymous claimant
# ([[claim-anonymous-owner-aliasing]]). But that /<caller> tag is a DEBUG label, not an ownership
# identity — the SAME logical flow (claim via mesh-claim directly, release via mesh-chat's [done]
# auto-release, :~668) calls mesh-claim as a child of a DIFFERENT parent each time, so the two WHOs
# differ only in that tag and _done_gate's raw WHO-vs-WHO compare misread a legitimate self-release as
# "theirs" — mesh-chat's own --test #10 caught this LIVE (a [done] naming a LIVE claim's key failed to
# release it). The STABLE principal is <user>@<host> (or a bare explicit MESH_WHO like "genome@host",
# which has no slash and passes through unchanged) — ownership compares on THAT, never the tag.
_principal() {
  local w="$1" rest user host
  case "$w" in
    */*@*) rest="${w%%@*}"; host="${w#*@}"; user="${rest%%/*}"; printf '%s@%s' "$user" "$host" ;;
    *) printf '%s' "$w" ;;
  esac
}
# --- claim-done-ownership-gate (chat-review/claim-done-ownership-gate): refuse --done on a LIVE
# claim held by someone other than the caller. Split out from the --done case arm so --test can
# exercise the gate purely (swap $BOARD, call this, check the verdict) without ever invoking the
# real _post/mesh-chat — a --test that side-effects the live board on every run is the exact
# hazard reflex-test-must-sandbox-outbound exists to catch. -----------------------------------
_done_gate() {  # <key> <force:0|1>  ->  0 allow (may already be unclaimed/yours/stale) / 2 refuse
  local key="$1" force="$2" verdict owner
  [ "$force" = 1 ] && return 0
  set -- $(_resolve "$key"); verdict="$1"; owner="${3:-}"
  # expired is gated exactly like theirs: the TTL lapsing changes the REMEDY (poke to renew), never
  # who owns the work. A stranger releasing a claim whose owner is measurably mid-turn is the same
  # 2026-07-06 failure this gate exists for, just with a lapsed clock as the excuse.
  case "$verdict" in
    theirs|expired|held-incapable)
      if [ "$(_principal "$owner")" != "$(_principal "$WHO")" ]; then
        echo "mesh-claim: '$key' is held by $owner ($([ "$verdict" = held-incapable ] && echo 'owner RATE-LIMITED — it cannot release this itself right now' || { echo -n 'owner LIVE'; [ "$verdict" = expired ] && echo -n ', TTL lapsed'; echo; })) — refusing --done (use --force to override)" >&2
        return 2
      fi ;;
  esac
  return 0
}

case "${1:-}" in
  --test)
    f=""
    valid_key "alert:ds-freeze-2026"      || f="$f key-good"
    valid_key "repo/run#42"               || f="$f key-good2"
    ! valid_key ""                        || f="$f empty-key"
    ! valid_key "free text claim"         || f="$f free-text"
    ! valid_key "bad;rm"                  || f="$f badchar"
    ! valid_key "--release"               || f="$f flag-key"    # chat-review/claim-unknown-flag-phantom: a flag-shaped token (unknown/typo'd flag) is never a legit artifact id — every post path (:252/:256/:265) gates on valid_key + exits 64, so this rejection PROVES no phantom '[claim] --release' is posted (hermetic — fires no outbound)
    ! valid_key "--bogus"                 || f="$f flag-key2"
    # trailing-colon key (chat-review/claim-trailing-colon-key 2026-07-06): the live phantom was exactly
    # 'genome:' — a WHO/label prefix, never a real artifact id. Interior colons (already tested above via
    # 'alert:ds-freeze-2026') MUST stay valid — only a TRAILING ':' is rejected.
    ! valid_key "genome:"                 || f="$f trailing-colon-accepted"
    ! valid_key "alert:"                  || f="$f trailing-colon-accepted2"
    valid_key "alert:ds-freeze-2026"      || f="$f interior-colon-broken"
    # claim_args_ttl: pure parse of the args AFTER the key on the default claim path
    [ "$(claim_args_ttl)" = "$DEFAULT_TTL" ]         || f="$f args-default-ttl"
    [ "$(claim_args_ttl --ttl 99)" = 99 ]            || f="$f args-ttl-override"
    claim_args_ttl extra-token >/dev/null 2>&1        && f="$f args-extra-not-rejected"
    claim_args_ttl --ttl 50 stray >/dev/null 2>&1     && f="$f args-extra-after-ttl-not-rejected"
    # live end-to-end (safe: both invocations are rejected BEFORE ever reaching _resolve/_post — no
    # board side-effect, hermetic like the flag-key case above). Reproduces the exact live misuse.
    _o1="$("$0" 'genome:' 2>&1 1>/dev/null)"; _rc1=$?
    [ "$_rc1" -eq 64 ] || f="$f cli-trailing-colon-not-64:[$_o1]"
    _o2="$("$0" 'genome:' 'chat-review/mindstate-card-gate' 2>&1 1>/dev/null)"; _rc2=$?
    [ "$_rc2" -eq 64 ] || f="$f cli-extra-arg-not-64:[$_o2]"
    case "$_o2" in *"genome:"*"chat-review/mindstate-card-gate"*) : ;; *) f="$f cli-extra-arg-msg-missing-tokens:[$_o2]" ;; esac
    # parse_latest: latest event per key wins, body-anchored, ignores prose mention
    board='2026-06-24T01:00:00Z  a@h  ::  [claim] task-x ttl=60
2026-06-24T01:05:00Z  b@h  ::  prose mentioning [claim] task-x should not match
2026-06-24T01:10:00Z  a@h  ::  [claim-done] task-x
2026-06-24T02:00:00Z  c@h  ::  [claim] task-y ttl=99'
    [ "$(printf '%s\n' "$board" | parse_latest task-x)" = "done|a@h|2026-06-24T01:10:00Z|" ] || f="$f parse-x"
    [ "$(printf '%s\n' "$board" | parse_latest task-y)" = "claim|c@h|2026-06-24T02:00:00Z|99" ] || f="$f parse-y"
    [ -z "$(printf '%s\n' "$board" | parse_latest task-z)" ] || f="$f parse-none"
    # is_stale_clock
    is_stale_clock 1000 60 2000           || f="$f clock-stale"
    ! is_stale_clock 1000 60 1030         || f="$f clock-fresh"
    # classify
    [ "$(classify '' '' me 0)"          = "unclaimed 0" ] || f="$f cl-unclaimed"
    [ "$(classify done a@h me 0)"       = "unclaimed 0" ] || f="$f cl-done"
    [ "$(classify claim me@h me@h live)"   = "yours 1" ]     || f="$f cl-yours"
    [ "$(classify claim other@h me@h live)" = "theirs 2" ]   || f="$f cl-theirs"
    [ "$(classify claim other@h me@h abandoned)" = "stale 3" ] || f="$f cl-stale"
    # EXPIRED IS NOT ABANDONED (task {#b2d997b4}) — the third state, and its CODE matters as much as
    # its word: rc 2 is what every existing rc reader (mesh-dms _fence_ok, mesh-interpret) already
