    [ "$(classify claim '?@h' "$who" live)" = "theirs 2" ]              || f="$f who-not-yours" # anon claim, real me -> theirs
    # claim-done-ownership-gate (chat-review/claim-done-ownership-gate, live-reproduced
    # 2026-07-06T15:11:40Z: genome released turbo-lid@'s held actuator claim): _done_gate refuses
