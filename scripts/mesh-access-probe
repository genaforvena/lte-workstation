#!/usr/bin/env bash
# mesh-access-probe — PROPRIOCEPTION: does THIS observer still have its senses (reach + creds)?
#
# Our own essay docs/proprioception-from-sys.md said embodiment is an interpretation problem: read a
# reach the mesh already depends on and name what its breakage means. guy-fawxible shipped that idea
# as a reflex (gf-access-probe, operator 2026-07-09 "все доступы должны быть рефлексы ... пусть ты
# просыпаешься если эти сенсоры падают") pointed at prod (YC/VM/PG/CH). This is OUR re-derivation over
# OUR reaches — never their repo/instance.
#
# This is NOT "is the mesh up" (mesh-health owns the fleet table, mesh-egress-health the uplink). This
# owns the OBSERVER'S OWN reach — the creds/paths a mind silently loses and only discovers mid-task:
#   - ts        Tailscale backend Running + Self.Online — the mesh nervous system. If DOWN, the node is
#               blind to the mesh and the mesh to it (CLAUDE.md: "tmux is the only way to see a node").
#   - anthropic api.anthropic.com REACHABLE (not geo-blocked 403) — the minds' egress lifeblood. A
#               silent 403/DNS/route break wedges every mind (cf. memory mind-401 / egress class).
#   - groq      the inference key still authenticates (models list 200, not 401) — a rotated/expired
#               GROQ key breaks mesh-relay silently. n/a (skipped) if no key is configured.
#   - phone     the sense body reachable over SSH+termux. SOFT about SLEEP, hard about REFUSAL: nothing
#               answering = BLIND (couldn't attempt — a phone is expected-asleep, it never cries wolf
#               when it sleeps), but an sshd that ANSWERS and refuses our creds = DOWN. Those are two
#               claims and collapsing them is what hid a dead phone lane here for days (see s_phone).
#
# The three proprioception disciplines, applied (docs/proprioception-from-sys.md):
#   1. Read what already exists — each probe is the EXISTING auth handshake, adds no instrumentation
#      (a HEAD to the API, `tailscale status`, a battery read). Never reads/logs content.
#   2. Count, never content — reports reach STATE only (OK/DOWN/BLIND). A 401-vs-200 carries no info
#      but "the creds work"; a battery read is a liveness ping, not surveillance.
#   3. Honest absence over a faked calm — three states: OK (tried, works), DOWN (tried, broken — the
#      observer's sense is HURT; wakes the minds), BLIND (couldn't even attempt — a dependency was down;
#      NEVER "all clear"). Explicit cascade: ts DOWN -> phone BLIND (the phone is felt over tailscale).
#
# NO STATE FILE (bus-as-lock, mirrors mesh-claim: a side file is a second source of truth). The durable
# state is ONE `[access-state] ts=.. anthropic=.. ..` marker on the mesh-chat board, posted by the cron
# ONLY on a change (quiet when calm) — and because that board is a mesh-chat-sync UNION of every peer's
# log, "the marker" means THIS NODE'S OWN marker: every read is keyed to the poster (see bus_lines).
# A DOWN transition posts a board `[alert]` (wakes the minds); set
# MESH_ACCESS_DM=1 to also DM the operator (default off — the operator reads the room, no TG spam).
#
# THE ALERT SITS BEHIND mesh-link-heal's OUTCOME, not on the fault. A new DOWN whose CAUSE is a reach
# failure is HELD one bounded window (default 600s, one cadence) and spent only if the sense is STILL
# down when it closes; a self-cured episode costs zero mind turns and its restore [note] is suppressed
# with it. Auth/unknown causes are never held. Every edge — held, discharged or fired — is a row in
# `~/.mesh/access-holds.log` (TAB-delimited, parsed by position), which is the only place the
# suppression rate is visible; the board never sees a held alert. See the block above consider().
#
# THE SOFT (BLIND) EDGE HAS ITS OWN LADDER. An expected doze — BLIND, "could not attempt", never an
# ALERT — used to post a [note] on every sleep and every wake (45 doze notes in 3.2 days here). It is
# now HELD too, against a window MEASURED from this sense's own recorded doze runs (p90 of the
# [access-state] marker stream) rather than a constant, and fired as one note only when the absence
# outlasts the sense's own habit. Its rows carry the key `<sense>:soft` and its suppression rate is
# reported APART from the DOWN one. See the block above soft_decide().
#
# reflex-cadence: 4-59/10 * * * *
#
#   mesh-access-probe           one cron cycle: probe, escalate on CHANGE, post the marker on change
#   mesh-access-probe --once    probe LIVE now, print the block; no bus/DM/escalation (display)
#   mesh-access-probe --watch   LIVE loop (MESH_ACCESS_INTERVAL, default 90s); display-only
#   mesh-access-probe --render  print last states from the BUS marker (a data-pane one-shot)
#   mesh-access-probe --holds   the hold ledger + its suppression rate (what the held alerts cost)
#   mesh-access-probe --dry     probe + print what WOULD escalate/post; touch nothing
#   mesh-access-probe --test    hermetic smoke: pure state-parse + transition + cascade + hold logic
#
# Knobs: MESH_ACCESS_HOLD_WINDOW (seconds a DOWN edge stays unspent, default 600) ·
#        MESH_ACCESS_SOFT_HOLD_WINDOW (override the MEASURED doze window; unset = corpus p90) ·
#        MESH_ACCESS_SOFT_HOLD_MIN/MAX (clamp on the measured doze window, 600/7200) ·
#        MESH_ACCESS_DOZE_MIN_N (runs needed before the corpus may calibrate, default 8) ·
#        MESH_ACCESS_HOLDLOG (the hold ledger) · MESH_LINKHEAL_LOG (the actuator's own tape).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
HOST="$(hostname)"
TIMEOUT="${MESH_ACCESS_TIMEOUT:-10}"
# probe_who — the identity this tool posts its [access-state] marker under. It is the KEY of the
# tool's own durable state, so it must be a fact about the TOOL, never about whoever launched it:
# `: "${MESH_WHO:=access-probe@$HOST}"` deferred to an inherited value, and every mind pane exports
# one (MESH_WHO=genome@mesh-home here), so a hand-run read its markers under the caller's window name,
# found none, and reported "no [access-state] marker yet / first run" on a board holding 164 of them —
# a silent fallback wearing the calm word for a key split ([[a-silent-fallback-turns-a-failure-into-a-plausible-constant]]).
probe_who(){ printf 'access-probe@%s' "${1:-$HOST}"; }
MESH_WHO="$(probe_who "$HOST")"; export MESH_WHO
[ -r "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
[ -r "$HOME/.mesh/groq.env" ] && . "$HOME/.mesh/groq.env" 2>/dev/null || true
PHONE_USER="${PHONE_USER:-u0_a380}"
PHONE_TS_IP="${PHONE_TS_IP:-100.103.99.16}"
PHONE_SSH_PORT="${PHONE_SSH_PORT:-8022}"
GROQKEY="${GROQ_API_KEY:-${GROQ_KEY:-}}"

# --- bus-as-lock: prev state derived from the last [access-state] marker (no side file) -------------
# THE BOARD IS A UNION, SO THE MARKER STREAM MUST BE KEYED TO THIS NODE'S OWN POSTS. $BOARD is
# ~/.mesh/chat.log, which mesh-chat-sync UNIONS across peers — phaedra's [access-state] lines sit in
# mesh-home's log and vice versa. An unfiltered `tail -1` therefore makes "my previous state" mean
# "whichever node posted last": each node's change-gate compares its reading against the OTHER node's,
# so a calm mesh posts a marker EVERY cycle (measured 2026-08-26: 24 markers per 220 board lines
# against a header promising "ONLY on a change") and each node's escalation ladder remembers the other
# node's history. The fingerprint that rules out a flapping world: phaedra's last 24 phone verdicts ran
# DOWN,BLIND,DOWN,BLIND — perfect period-2, ZERO runs of length 2. A flapping sshd produces runs
# ([[redmi-sshd-flaps-so-a-probe-is-a-sample]]); a square wave is the two writers oscillating against
# each other, and phaedra's half of it asserted a fault (DOWN wakes the minds) every other cycle.
# The filter keys on the WRITER identity mesh-chat will actually stamp ($MESH_WHO), so reader and
# writer agree by construction, and it matches the poster FIELD — not a substring — so a verdict's
# free text quoting "[access-state]" (witness's own chat-review line does exactly that, and it is on
# this board) can never be read as a marker ([[a-verdicts-free-text-quotes-another-records-fields]]).
BUS_WHO="$MESH_WHO"
bus_lines(){   # this node's OWN [access-state] board lines, oldest first, whole lines
  [ -r "$BOARD" ] || return 0
  awk -v who="$BUS_WHO" '
    { i = index($0, "  ::  "); if (i == 0) next
      head = substr($0, 1, i - 1); body = substr($0, i + 6)
      j = index(head, "  "); if (j == 0) next
      if (substr(head, j + 2) != who) next
      if (substr(body, 1, 15) != "[access-state] ") next
      print }' "$BOARD" 2>/dev/null
}
bus_marker(){ bus_lines | tail -1; }
bus_snap(){   bus_marker | sed -n 's/.*\[access-state\] *//p'; }   # "ts=OK anthropic=OK groq=OK phone=BLIND"
bus_when(){   bus_marker | awk '{print $1}'; }
# prev_st <sense> <snapshot> -> the recorded STATE or "" (pure: snapshot passed in, testable)
prev_st(){ printf '%s' "${2:-}" | grep -oE "$1=[A-Z]+" | head -1 | cut -d= -f2; }
# bus_last_informative <sense> -> the last NON-BLIND state recorded for the axis, or "".
# BLIND is "couldn't attempt" — it carries no information about the sense, so it must not erase a
# recorded DOWN from the escalation ladder's memory (it stays the marker/display truth). Read from
# the same board markers (bus-as-lock, no side file); "" = no informative history (fail-loud: a
# DOWN with no informative past is news).
bus_last_informative(){
  bus_lines | grep -oE "$1=[A-Z]+" | cut -d= -f2 | grep -v '^BLIND$' | tail -1
}

# retry-once: this node's LTE/DNS uplink blips for seconds; one failure is a blip, not DOWN.
try2(){ "$@" >/dev/null 2>&1 && return 0; sleep 2; "$@" >/dev/null 2>&1; }

# --- sensors: each prints "STATE<TAB>detail". Three states only. BLIND is never a hard outage. -------
s_ts() {
  local raw st be cz
  # BackendState comes back BESIDE the verdict because it is the CAUSE, and the cause decides whether
  # this DOWN is one mesh-link-heal could ever fix. "backend down or logged out" was one sentence for
  # two different faults: NeedsLogin is a credential loss no re-associate touches, while Running with
  # Self.Online false is exactly what a link flap looks like from here.
  raw="$(timeout "$TIMEOUT" tailscale status --json 2>/dev/null \
       | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); b=d.get("BackendState") or "?"
 print(("OK" if b=="Running" and (d.get("Self") or {}).get("Online") else "DOWN"), b)
except Exception: print("DOWN","?")' 2>/dev/null)"
  st="${raw%% *}"; be="${raw#* }"; [ -n "$st" ] || { st=DOWN; be="?"; }
  [ "$st" = OK ] && { printf 'OK\ttailscale Running + Self.Online\tnone'; return; }
  cz="$(cause_of_backend "$be")"
  printf 'DOWN\ttailscale not Running/Online (BackendState=%s)\t%s' "$be" "$cz"
}
# cause_of_backend — pure: a tailscale BackendState -> the CAUSE class of a DOWN carrying it.
# Written as a declaration of what the state CLAIMS to be, never as an allowlist of the reach-y ones:
# an unrecognised backend state is `other`, and `other` is the LOUD direction (it is never held).
cause_of_backend(){
  case "$1" in
    NeedsLogin|NeedsMachineAuth) echo auth ;;
    Running|Starting|NoState)    echo reach ;;
    *)                           echo other ;;
  esac
}
# anthropic_verdict / groq_verdict — PURE: an HTTP code -> "STATE<TAB>cause". Split out of the
# sensors so the cause mapping is drivable without a network: it is the predicate the hold gate reads,
# and a gate whose predicate can only be exercised live is a gate proved by the world, not by a test.
anthropic_verdict(){  # <http-code> -> STATE<TAB>cause
  case "$1" in
    000|"") printf 'DOWN\treach' ;;
    403)    printf 'DOWN\tauth' ;;
    *)      printf 'OK\tnone' ;;
  esac
}
groq_verdict(){       # <http-code> -> STATE<TAB>cause
  case "$1" in
    200)     printf 'OK\tnone' ;;
    401|403) printf 'DOWN\tauth' ;;
    000|"")  printf 'DOWN\treach' ;;
    *)       printf 'DOWN\tother' ;;
  esac
}
s_anthropic() {
  # reach, not auth: any HTTP response that is NOT a connect-fail(000) and NOT a geo-block(403) = reachable.
  local code
  code="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" https://api.anthropic.com/v1/models 2>/dev/null)"
  case "$code" in
    000|"") sleep 2; code="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" https://api.anthropic.com/v1/models 2>/dev/null)" ;;
  esac
  local v st cz
  v="$(anthropic_verdict "$code")"; st="${v%%$'\t'*}"; cz="${v##*$'\t'}"
  case "$cz" in
    reach) printf 'DOWN\tapi.anthropic.com unreachable (DNS/route/connect — minds egress cut)\t%s' "$cz" ;;
    auth)  printf 'DOWN\tapi.anthropic.com 403 (geo-blocked — minds egress cut)\t%s' "$cz" ;;
    *)     printf '%s\tapi.anthropic.com reachable (HTTP %s, not 403)\t%s' "$st" "$code" "$cz" ;;
  esac
}
s_groq() {
  [ -n "$GROQKEY" ] || { printf 'BLIND\tno GROQ key configured (~/.mesh/groq.env) — sense n/a\tnone'; return; }
  local code
  code="$(try2_code https://api.groq.com/openai/v1/models "$GROQKEY")"
  local v st cz
  v="$(groq_verdict "$code")"; st="${v%%$'\t'*}"; cz="${v##*$'\t'}"
  case "$cz" in
    none)  printf '%s\tgroq key authenticates (models 200)\t%s' "$st" "$cz" ;;
    auth)  printf '%s\tgroq key rejected (HTTP %s — rotated/expired)\t%s' "$st" "$code" "$cz" ;;
    reach) printf '%s\tgroq unreachable (DNS/route/connect)\t%s' "$st" "$cz" ;;
    *)     printf '%s\tgroq unexpected HTTP %s\t%s' "$st" "$code" "$cz" ;;
  esac
}
try2_code(){ # <url> <bearer> -> http_code, retry once on connect-fail
  local url="$1" key="$2" c
  c="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -H "Authorization: Bearer $key" "$url" 2>/dev/null)"
  case "$c" in 000|"") sleep 2; c="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -H "Authorization: Bearer $key" "$url" 2>/dev/null)" ;; esac
  printf '%s' "$c"
}
# --- pure: what ONE ssh attempt's outcome MEANS (testable, no I/O) ----------------------------------
# "asleep" and "refusing us" are DIFFERENT CLAIMS and the old code collapsed them: any non-zero ssh
# was reported 'phone unreachable/asleep (expected — not a fault)', so a phone that is AWAKE with a
# live sshd that REFUSES OUR CREDENTIALS read as a soft, expected BLIND — forever, and this tool's
# entire remit is the creds a mind silently loses. Live proof on mesh-home 2026-07-16: 74/74 board
# posts said phone=BLIND, and ~/.mesh/phone-collect.log held ONE distinct line — '[phone-unreachable]
# no ADB, LAN or WG path' — for all 179 entries since the 07-14 migration, i.e. the phone body has
# never once been read here. The phone was awake the whole time (192.168.8.203, sshd answering, host
# key identical to the .146 known_hosts entry = same device); mesh-home simply has NO ssh private key
# (~/.ssh holds only authorized_keys/config/known_hosts, every `identity file ... type -1`). Peers
# hid it: phaedra authenticates via TAILSCALE SSH (method "none", no key), so `ssh phaedra` works and
# only the phone's real OpenSSH on 8022 ever needed the key we don't have.
# rc=0                        -> OK    (we ran a command: reach AND creds intact)
# sshd answered, refused us   -> DOWN  (the phone is awake and REFUSING US — our own sense is HURT)
# nothing answered at all     -> BLIND (nothing to attempt — expected-asleep, never a fault)
classify_ssh_outcome(){  # <rc> <stderr-text> -> OK|DOWN|BLIND
  local rc="$1" err="$2"
  [ "$rc" = 0 ] && { echo OK; return; }
  case "$err" in
    *"Permission denied"*|*"Too many authentication failures"*|*"Authentication failed"*|\
    *"Host key verification failed"*|*"no matching host key"*|*"no mutual signature"*|\
    *"REMOTE HOST IDENTIFICATION HAS CHANGED"*) echo DOWN ;;
    *) echo BLIND ;;
  esac
}
# phone_candidates — the addresses this node may feel the body at. NOT ${PHONE_TS_IP} alone: the old
# code dialled only the tailnet, so a phone that fell off the tailnet but sits on the LAN (exactly
# this node's case — PHONE_LAN_IPS is configured in ~/.mesh/nodes and every other phone tool honours
# it) was unreachable by construction. The ts cascade still holds where it is TRUE: with no LAN
# candidates configured, a down tailnet means we genuinely cannot attempt.
phone_candidates(){  # <ts_state> -> addresses, one per line (empty = cannot attempt)
  local ts_state="$1" ip
  [ "$ts_state" = OK ] && [ -n "${PHONE_TS_IP:-}" ] && printf '%s\n' "$PHONE_TS_IP"
  for ip in ${PHONE_LAN_IPS:-}; do [ -n "$ip" ] && printf '%s\n' "$ip"; done
}
# phone_verdict — fold per-candidate outcomes into one state. OK wins (any path that WORKS proves the
# sense); else a REFUSAL anywhere outranks silence (an awake body refusing us is news, an absent one
# is not); else BLIND.
phone_verdict(){  # <outcome>... -> OK|DOWN|BLIND
  local o seen_down=""
  for o in "$@"; do
    [ "$o" = OK ] && { echo OK; return; }
    [ "$o" = DOWN ] && seen_down=1
  done
  [ -n "$seen_down" ] && echo DOWN || echo BLIND
}
s_phone() {  # reach+creds to the sense body. BLIND=asleep (soft). DOWN=awake but refusing us (a fault).
  local ts_state="$1" ip err rc outcomes=() at_down="" cands
  cands="$(phone_candidates "$ts_state")"
  [ -n "$cands" ] || { printf 'BLIND\tno phone address to try (tailscale down, no PHONE_LAN_IPS) — could not attempt\tnone'; return; }
  while read -r ip; do
    [ -n "$ip" ] || continue
    err="$(timeout "$TIMEOUT" ssh -p "$PHONE_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
             -o StrictHostKeyChecking=no "$PHONE_USER@$ip" 'termux-battery-status' 2>&1 >/dev/null)"; rc=$?
    case "$(classify_ssh_outcome "$rc" "$err")" in
      OK)    printf 'OK\tphone ssh+termux responsive at %s\tnone' "$ip"; return ;;
      DOWN)  outcomes+=(DOWN); [ -n "$at_down" ] || at_down="$ip" ;;
      *)     outcomes+=(BLIND) ;;
    esac
  done <<< "$cands"
  if [ "$(phone_verdict "${outcomes[@]}")" = DOWN ]; then
    printf 'DOWN\tphone AWAKE at %s but sshd refuses us — our reach/creds to the body are broken, not asleep\tauth' "$at_down"
  else
    printf 'BLIND\tphone unreachable/asleep (expected — not a fault)\tnone'
  fi
}

# --- pure transition classifier (testable, no I/O): st vs prev -> "ALERT|NOTE|NONE reason" -----------
# DOWN (newly) -> ALERT (wakes minds). BLIND (from non-BLIND) -> NOTE. OK-from-DOWN -> NOTE
# (restored). No change -> NONE. The phone is soft only about SLEEP: it stays quiet (BLIND->NOTE) when
# nothing answers, but a refusal makes it DOWN like any other sense, and DOWN wakes the minds.
# "Newly" is judged against the last INFORMATIVE state (3rd arg), not the raw marker: BLIND carries
# no information, and when it overwrote a recorded DOWN the next DOWN re-ALERTed the same chronic
# fault every sleep/wake cycle (live 2026-07-17: phone DOWN 16:24 -> BLIND 16:34 -> DOWN 16:44
# re-alert, 8 alarms in a day for the one known no-key-on-redmi state). A DOWN whose last
# informative state was DOWN is a re-manifestation, not news; same for a restore seen through a
# BLIND gap (OK-from-BLIND with an informative DOWN behind it IS a restore -> NOTE).
classify_transition(){  # <st> <prev> [<last-informative>] -> "ALERT"|"NOTE"|"NONE"
  local st="$1" prev="$2" li="${3:-$2}"
  [ "$st" = "$prev" ] && { echo NONE; return; }
  case "$st" in
    DOWN)  [ "$li" = DOWN ] && echo NONE || echo ALERT ;;   # chronic re-manifestation is not news
    BLIND) [ "$li" = DOWN ] && echo NONE || echo NOTE ;;  # BLIND-from-DOWN = sleep phase of a known fault, not news
    OK)    [ "$li" = DOWN ] && echo NOTE || echo NONE ;;    # OK is only newsworthy as a RESTORE
    *)     echo NONE ;;
  esac
}

# --- the alert sits BEHIND mesh-link-heal's OUTCOME, not on the fault ------------------------------
# This node's sole uplink is a wedging USB dongle and `mesh-link-heal` re-associates it on a 60s tick.
# Measured 2026-08-27 (chat-review/access-down-alerts-on-the-fault-not-on-link-heals-outcome): 24 of 32
# ACCESS-DOWN alerts posted here were followed by a mesh-link-heal RECOVERED within 300s — the last
# eight at 16s 136s 21s 3s 92s 83s 73s 14s — and each of those episodes ALSO posted a restore [note],
# so a fault the mesh repaired by itself spent TWO paid mind turns. classify_transition's chronic guard
# structurally cannot suppress it: every flap restores to OK in between, so each DOWN is genuinely news
# by its own truth table. The fix is not a fifth condition in that table — it is that once a detector
# has an actuator, the alert's question stops being "is this broken" and becomes "could the actuator
# NOT fix it" ([[an-alert-wired-to-the-fault-not-to-its-actuators-outcome]]).
#
# So a new DOWN whose CAUSE is a reach failure is HELD, not spent: no [alert], no restore [note] if it
# cures. Three things keep the hold from becoming a silence, and they are the same three the sound
# reflex's deferral earned:
#   * It is BOUNDED by the gate's own arithmetic, measured live rather than asserted: HOLD_WINDOW
#     (default one probe cadence, 600s) against the healer's OWN recovery distribution read out of
#     ~/.mesh/link-heal.log. Live at the time of writing: n=289, p50=60s, p90=120s, p95=296s — so one
#     cadence covers the healer's p95 with room, and the 9089s tail episode is exactly the one that
#     SHOULD wake somebody. Every ledger row and the alert itself carry that p95 and its n; if the
#     measured bound ever exceeds the window the row says so in words (bound-exceeded), because a hold
#     shorter than what it is waiting for is a delay pretending to be a filter.
#   * The MARKER is never falsified to carry the hold. The [access-state] line stays the honest reading
#     (it is also --render's display truth); the unresolved edge lives in this ledger alone, which is
#     also what makes an unclosed hold a visible, aged liability rather than an invisible one.
#   * Every hold is LOUD in its OWN ledger, never the board — a held alert written where the delivered
#     ones go forges the evidence a mind was told ([[a-dry-run-that-writes-the-liveness-log-forges-its-own-evidence]]).
#     And the ledger records the FIRED edges too, including the ones never eligible for a hold: a tape
#     of only suppressions is a numerator with no denominator ([[a-tape-of-only-positives-is-a-numerator]]),
#     and the number this change has to be judged on is the suppression RATE.
#
# The eligibility gate is the sensor's own CAUSE, not a list of senses. An allowlist of "network-ish"
# senses fails toward silence the moment a new sense joins ([[an-exclusion-allowlist-fails-toward-silence-so-invert-the-polarity]]);
# a cause the sensors DECLARE means an unrecognised fault is `other`, and `other` is never held.
HOLDLOG="${MESH_ACCESS_HOLDLOG:-$HOME/.mesh/access-holds.log}"
LINKHEAL_LOG="${MESH_LINKHEAL_LOG:-$HOME/.mesh/link-heal.log}"
HOLD_WINDOW="${MESH_ACCESS_HOLD_WINDOW:-600}"   # seconds an edge may stay unspent (one probe cadence)

# healer_bound -> "<p95-seconds> <n>" from mesh-link-heal's own RECOVERED rows, or "na 0".
# TWO row shapes are read on purpose: the older `>=Ns dark (lower bound...)` and the current
# `/ Ns to-recovery`, because a parser that knows one label renders every other as absence
# ([[a-parser-that-knows-one-label-renders-every-other-as-absence]]) and this file changed shape
# mid-corpus — 285 rows in the old spelling against 4 in the new on the day this was written.
# CAVEAT carried in the published number, not just here: that tape is a FLOOR. mesh-link-heal polls at
# TICK=60 and ~60% of measured episodes were shorter than one tick, so the rows that exist are biased
# LONG. For a hold bound that bias is the SAFE direction — it over-states what we must wait for.
healer_bound(){
  local vals n
  vals="$(grep RECOVERED "$LINKHEAL_LOG" 2>/dev/null \
          | grep -oE '(>=[0-9]+s dark|[0-9]+s to-recovery)' | grep -oE '^[>=]*[0-9]+' | tr -d '>=' | sort -n)"
  n="$(printf '%s\n' "$vals" | grep -c '[0-9]' 2>/dev/null)"
  [ "${n:-0}" -gt 0 ] 2>/dev/null || { printf 'na 0'; return; }
  printf '%s %s' "$(printf '%s\n' "$vals" | awk -v n="$n" '{a[NR]=$1} END{i=int(n*0.95)+1; if(i>n)i=n; print a[i]}')" "$n"
}

# healer_heals_since <epoch> -> how many mesh-link-heal RECOVERED rows landed at/after <epoch>, or
# "na" when the healer's ledger cannot be read at all. This is CORROBORATION printed beside the
# verdict, never the verdict itself: the healer fires several times an hour here, so "a RECOVERED
# happened inside the window" is a coincidence of two unscheduled windows
# ([[a-discharge-condition-that-is-a-coincidence-of-two-unscheduled-windows]]). What actually decides
# a discharge is that the sense READS OK AGAIN — attribution is not a health verdict
# ([[an-attribution-is-not-a-health-verdict]]).
healer_heals_since(){
  local since="$1" c=0 ts e
  [ -r "$LINKHEAL_LOG" ] || { printf 'na'; return; }
  while read -r ts _; do
    e="$(date -u -d "$ts" +%s 2>/dev/null)" || continue
    [ -n "$e" ] && [ "$e" -ge "$since" ] 2>/dev/null && c=$((c+1))
  done < <(grep RECOVERED "$LINKHEAL_LOG" 2>/dev/null | tail -500)
  printf '%s' "$c"
}

# --- the hold ledger. TAB-delimited, parsed BY POSITION -------------------------------------------
# ts \t VERB \t sense \t since(ISO) \t holds \t free text. The free text is last and is never parsed:
# a verdict's prose can quote another record's fields, and a positional read is the only one that
# survives it ([[a-verdicts-free-text-quotes-another-records-fields]]).
hold_write(){  # <verb> <sense> <since-iso> <holds> <note>
  if [ "${dry:-}" = 1 ]; then printf '[dry] hold-ledger: %s %s since=%s holds=%s %s\n' "$1" "$2" "$3" "$4" "$5" >&2; return; fi
  mkdir -p "$(dirname "$HOLDLOG")" 2>/dev/null
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" "$4" "$5" >> "$HOLDLOG" 2>/dev/null
}
# hold_pending <sense> -> "<since-iso> <holds>" if this sense's LAST ledger row is an unresolved HELD,
# else "". FIRED and DISCHARGED both resolve it, which is what stops a fired edge re-firing every
# cycle and what lets a legitimate restore note through after an alert really was spent.
hold_pending(){
  [ -r "$HOLDLOG" ] || return 0
  awk -F'\t' -v k="$1" '$3==k{v2=$2; v4=$4; v5=$5} END{ if (v2=="HELD") printf "%s %s", v4, v5 }' "$HOLDLOG" 2>/dev/null
}

# hold_decide — PURE, no I/O: what happens to this sense's DOWN edge THIS cycle.
#   <st> <cause> <pending: HELD|""> <elapsed-seconds> <hold-window> -> HELD|FIRED|DISCHARGED|PASS
# With no pending edge it is only ever asked about a NEW alert-worthy DOWN, and the answer is the
# cause: reach is held, everything else — auth, other, an unrecognised word — fires now.
# With a pending edge the ACTUATOR'S OUTCOME answers:
#   OK    -> DISCHARGED (the only positive evidence the fault is gone)
#   BLIND -> HELD, and the hold does NOT advance: BLIND means we could not attempt, so it is not
#            evidence either way. The elapsed clock still runs, so a sense that goes blind forever
#            cannot hold an edge forever — the window closes it on the next DOWN.
#   DOWN  -> FIRED once elapsed has reached the window, HELD before that.
hold_decide(){
  local st="$1" cz="$2" pend="$3" elapsed="$4" win="$5"
  if [ "$pend" = HELD ]; then
    case "$st" in
      OK)    echo DISCHARGED ;;
      BLIND) echo HELD ;;
      *)     [ "${elapsed:-0}" -ge "${win:-0}" ] 2>/dev/null && echo FIRED || echo HELD ;;
    esac
    return
  fi
  [ "$cz" = reach ] && echo HELD || echo FIRED
}

# --- the SOFT axis: an expected DOZE is not news until it outlasts the sense's own doze ------------
# chat-review/phone-soft-blind-edge-skips-the-hold-ladder (2026-08-28). consider() routed only an
# ALERT-worthy DOWN through the ladder above; a NOTE-classified edge returned before hold_decide ever
# saw it. So the phone's expected doze (BLIND-from-OK, classify_transition's NOTE row) posted a [note]
# on EVERY sleep and again on every wake: measured on this node's own board over 3.2 days — 55 phone
# notes, 45 of them the bare `phone: BLIND — phone unreachable/asleep (expected — not a fault)`, each
# paired with its [access-state] line, ~3.7% of all 3000 board lines. 17/day and 15/day on the last two
# full days. The detail says "expected — not a fault" and then wakes the board about it.
#
# The remedy is the SAME ladder, not a suppression: a BLIND edge is HELD, and the next readings decide
# it. Three properties are carried over deliberately, because the 179-entry episode recorded at the top
# of this file is exactly what a silent collapse of the phone claims looks like:
#   * NEVER a silent drop. Every held doze is a row in the same ledger, and hold_summary publishes the
#     soft suppression RATE and the age of any still-open hold, next to (never pooled with) the hard
#     one — a pooled order statistic over a mixture tests the mixture weights, not the material
#     ([[a-pooled-median-over-a-mixture-tests-the-prune-ratio]]).
#   * The window is MEASURED from the live corpus, never asserted. doze_bound reads this node's own
#     [access-state] markers — the only record of how long this sense actually dozes — and takes p90,
#     so ~90% of ordinary dozes are absorbed and an absence LONGER than this sense's own habit is
#     still news ([[calibrate-a-derived-axis-against-the-live-corpus]]). Live at the time of writing:
#     n=51 runs, p50=1191s p75=1228s p90=3606s, and 23 of the 51 are exactly one 600s cadence. A
#     fallback that cannot read the corpus does NOT quote a constant as if it were measured: it says
#     `src=default-uncalibrated` in the row.
#   * It CANNOT silence an alert. BLIND is never ALERT (classify_transition), so this ladder only ever
#     delays a NOTE, and it delays it by a bounded, published, self-measured window.
#
# The eligibility gate is the sensor's own declared STATE, not a list of senses: BLIND means "could not
# attempt" by this tool's definition, whichever sense says it, so a new dozing sense is held too and no
# allowlist ages out ([[an-exclusion-allowlist-fails-toward-silence-so-invert-the-polarity]]).
#
# The ledger KEY is "<sense>:soft" so the two axes never consume each other's pending edge: hold_pending
# matches $3 exactly, so a phone doze hold and a phone auth DOWN hold are separate promises with
# separate ages, and hold_summary reports them apart.
SOFT_KEY_SUFFIX=":soft"
SOFT_WINDOW_DEFAULT=1800                       # used ONLY when the corpus cannot calibrate, and named as such
SOFT_WINDOW_MIN="${MESH_ACCESS_SOFT_HOLD_MIN:-600}"    # one probe cadence: below this the hold spans no reading
SOFT_WINDOW_MAX="${MESH_ACCESS_SOFT_HOLD_MAX:-7200}"   # a corpus dragged by power-offs must not mint an all-day hold

# doze_bound <sense> -> "<p90-seconds> <n>" over this node's OWN recorded runs of BLIND, or "na 0".
# The corpus is the [access-state] marker stream, which is posted ONLY on change, so consecutive
# markers ARE the state runs. Two honesty terms travel with it:
#   * n is published everywhere the number is, and below MIN_N the answer is `na` — an order statistic
#     off three points is not a habit.
#   * the runs are quantised to the probe cadence and a run spanning a power-off is the NODE being
#     off, not the sense dozing ([[an-age-that-spans-a-power-off-is-not-a-silence]]). p90 is chosen
#     partly because it is robust to that top-decile contamination; the MAX clamp bounds the rest.
DOZE_MIN_N="${MESH_ACCESS_DOZE_MIN_N:-8}"
doze_bound(){  # <sense> -> "<p90> <n>"
  local vals n
  vals="$(bus_lines | TZ=UTC0 awk -v s="$1" '
    function ep(t){ gsub(/[-:TZ]/, " ", t); return mktime(t) }
    { if (match($0, s"=[A-Z]+") == 0) next
      st = substr($0, RSTART + length(s) + 1, RLENGTH - length(s) - 1)
      e = ep($1); if (e < 0) next        # mktime returns -1 on a bad parse; 0 is a real epoch
      if (prev == "") { prev = st; pe = e; next }
      if (st != prev) { if (prev == "BLIND" && e > pe) print e - pe; prev = st; pe = e } }' 2>/dev/null | sort -n)"
  n="$(printf '%s\n' "$vals" | grep -c '[0-9]' 2>/dev/null)"
  [ "${n:-0}" -ge "$DOZE_MIN_N" ] 2>/dev/null || { printf 'na %s' "${n:-0}"; return; }
  printf '%s %s' "$(printf '%s\n' "$vals" | awk -v n="$n" '{a[NR]=$1} END{i=int(n*0.9)+1; if(i>n)i=n; print a[i]}')" "$n"
}

# soft_window <sense> -> "<seconds> <src> <p90> <n>". The source word is part of the published reading:
# an operator override, a corpus-derived p90, a clamped p90, or the uncalibrated constant are four
# different claims and a row that renders them identically is a constant wearing a measurement's
# clothes ([[a-fallback-constant-run-as-a-peer-arm-shadows-the-calibration-beside-it]]).
soft_window(){  # <sense>
  local b p n w src
  b="$(doze_bound "$1")"; p="${b%% *}"; n="${b##* }"
  if [ -n "${MESH_ACCESS_SOFT_HOLD_WINDOW:-}" ]; then
    printf '%s env %s %s' "$MESH_ACCESS_SOFT_HOLD_WINDOW" "$p" "$n"; return
  fi
  [ "$p" = na ] && { printf '%s default-uncalibrated na %s' "$SOFT_WINDOW_DEFAULT" "$n"; return; }
  w="$p"; src=corpus-p90
  [ "$w" -lt "$SOFT_WINDOW_MIN" ] 2>/dev/null && { w="$SOFT_WINDOW_MIN"; src=corpus-p90-clamped-min; }
  [ "$w" -gt "$SOFT_WINDOW_MAX" ] 2>/dev/null && { w="$SOFT_WINDOW_MAX"; src=corpus-p90-clamped-max; }
  printf '%s %s %s %s' "$w" "$src" "$p" "$n"
}

# soft_decide — PURE, no I/O: what happens to this sense's BLIND edge THIS cycle.
#   <st> <pending: HELD|""> <elapsed-seconds> <window> -> HELD|FIRED|DISCHARGED|PASS
# Note the deliberate ASYMMETRY with hold_decide: there BLIND means "could not attempt" and does NOT
# advance the hold; here BLIND IS the held evidence — the doze we are timing — so it advances, and the
# window is what eventually makes it news. Anything that is not BLIND ended the doze: OK discharges it
# unspent, and DOWN discharges it too because a refusal is a FAULT and belongs to the hard ladder,
# which must judge it on its own age rather than inherit a doze's clock.
soft_decide(){
  local st="$1" pend="$2" elapsed="$3" win="$4"
  if [ "$pend" = HELD ]; then
    case "$st" in
      BLIND) [ "${elapsed:-0}" -ge "${win:-0}" ] 2>/dev/null && echo FIRED || echo HELD ;;
      *)     echo DISCHARGED ;;
    esac
    return
  fi
  [ "$st" = BLIND ] && echo HELD || echo PASS
}

# hold_elapsed <since-iso> -> whole seconds since that stamp (0 if unparseable — fail toward FIRING
# is wrong here, so an unparseable stamp yields 0 and the edge is held one more cycle, but the ledger
# row records the raw stamp so the loop is visible rather than silent).
hold_elapsed(){
  local e n
  e="$(date -u -d "$1" +%s 2>/dev/null)" || e=""
  [ -n "$e" ] || { printf '0'; return; }
  n="$(date -u +%s)"; printf '%s' "$(( n - e > 0 ? n - e : 0 ))"
}

# hold_summary — the ledger's own verdict, in one line. A suppression ledger nobody reads is a
# gate's verdict with no reader ([[a-gates-verdict-with-no-reader]]), so this is welded into --render
# (the data-pane one-shot) rather than left as a file a mind has to remember to cat. It publishes the
# DENOMINATOR beside the rate, and it names any edge still OPEN past the window — an unresolved hold
# is a promise that never settled, and the whole point of holding an alert is that the hold is
# temporary ([[a-claim-that-never-settles-is-a-leaked-promise]]).
# The two axes are reported APART. Pooling them would let the soft axis's volume (a doze every few
# hours) swamp the hard axis's rate and make one percentage stand for two populations with different
# denominators and opposite meanings ([[a-pooled-median-over-a-mixture-tests-the-prune-ratio]]). A soft
# row is identified by its ledger KEY ending in ":soft", read by POSITION like every other field.
hold_summary(){
  [ -r "$HOLDLOG" ] || { printf 'no hold ledger yet (%s) — no edge has been seen since it was wired' "$HOLDLOG"; return; }
  local sk sws="" w1 w2 w3 w4
  # the soft window is published PER SENSE that actually has a soft edge on the tape — never for a
  # hardcoded "phone", which would be the sense allowlist this ladder was built to avoid.
  for sk in $(awk -F'\t' '$3 ~ /:soft$/ && !seen[$3]++ {print substr($3, 1, length($3)-5)}' "$HOLDLOG" 2>/dev/null); do
    read -r w1 w2 w3 w4 <<<"$(soft_window "$sk")"   # never `set --`: it would rewrite the script's own argv
    sws="$sws ${sk} $w1 $w2 $w3 $w4"
  done
  # no soft edge on the tape yet -> say so in words. A placeholder row rendered through the same
  # printf reads as a measured window of "na" seconds, which is a number-shaped nothing.
  awk -F'\t' -v win="$HOLD_WINDOW" -v sw="$sws" '
    function rate(d, fr, what,   n) {
      n = d + fr
      if (n == 0) return sprintf("%d written, no %s edge resolved yet", heldc[what]+0, what)
      return sprintf("%d suppressed / %d resolved %s edges (%.0f%% never reached the board)", d+0, n, what, 100*d/n)
    }
    { soft = (substr($3, length($3)-4) == ":soft")
      last[$3]=$2; since[$3]=$4
      if ($2=="DISCHARGED") { if (soft) sd++; else hd++ }
      if ($2=="FIRED")      { if (soft) sf++; else hf++ }
      if ($2=="HELD")       { if (soft) heldc["doze"]++; else heldc["DOWN"]++ } }
    END{
      printf "holds: %s · %s", rate(hd, hf, "DOWN"), rate(sd, sf, "doze")
      open=0; oldest=""
      for (k in last) if (last[k]=="HELD") { open++; if (oldest=="" || since[k]<oldest) { oldest=since[k]; ok_=k } }
      if (open>0) printf " · %d open (%s since %s)", open, ok_, oldest
      printf " · window %ss", win
      nw = split(sw, w, " ")
      if (nw < 5) printf " / doze window n/a (no doze edge on the tape yet)"
      for (i = 1; i + 4 <= nw; i += 5)
        printf " / doze[%s] %ss(src=%s p90=%s n=%s)", w[i], w[i+1], w[i+2], (w[i+3] == "na" ? "na" : w[i+3] "s"), w[i+4]
    }' "$HOLDLOG" 2>/dev/null
}

consider(){  # <sense> <st> <detail> <cause>
  local k="$1" st="$2" det="$3" cz="${4:-other}" prev li v pend since holds elapsed d heals bnd p95 bn warn
  local spend ssince sholds selapsed sd swb swin swrest ssrc sp90 sn
  prev="$(prev_st "$k" "$prev_snap")"
  li="$(bus_last_informative "$k")"
  [ "$st" = "$prev" ] || changed=1
  v="$(classify_transition "$st" "$prev" "$li")"

  pend="$(hold_pending "$k")"
  if [ -n "$pend" ]; then since="${pend%% *}"; holds="${pend##* }"; else since=""; holds=0; fi

  # --- the SOFT ladder: a BLIND edge is an expected doze, held against this sense's own doze window.
  # It runs BEFORE the early return below, because that return is precisely what used to hand every
  # doze straight to the board. It only ever rewrites $v/$det for a NOTE; it can neither create nor
  # suppress an ALERT (BLIND is never ALERT), and it keeps its own ledger key so the hard ladder's
  # pending edge is untouched.
  spend="$(hold_pending "$k$SOFT_KEY_SUFFIX")"
  if [ -n "$spend" ] || { [ "$v" = NOTE ] && [ "$st" = BLIND ]; }; then
    if [ -n "$spend" ]; then ssince="${spend%% *}"; sholds="${spend##* }"; else ssince="$(date -u +%FT%TZ)"; sholds=0; fi
    selapsed="$(hold_elapsed "$ssince")"
    swb="$(soft_window "$k")"; swin="${swb%% *}"; swrest="${swb#* }"; ssrc="${swrest%% *}"
    swrest="${swrest#* }"; sp90="${swrest%% *}"; sn="${swrest##* }"
    sd="$(soft_decide "$st" "${spend:+HELD}" "$selapsed" "$swin")"
    case "$sd" in
      HELD)
        sholds=$((sholds+1))
        hold_write HELD "$k$SOFT_KEY_SUFFIX" "$ssince" "$sholds" \
          "SOFT-DOZE st=$st elapsed=${selapsed}s/${swin}s window_src=$ssrc doze_p90=${sp90}s(n=$sn) — the expected doze; note unspent, the next reading decides it"
        v=NONE
        ;;
      FIRED)
        hold_write FIRED "$k$SOFT_KEY_SUFFIX" "$ssince" "$sholds" \
          "SOFT-DOZE hold spent: still BLIND after ${selapsed}s >= ${swin}s (window_src=$ssrc doze_p90=${sp90}s n=$sn) — longer than this sense's own measured doze, so it is news"
        v=NOTE
        det="$det [blind ${selapsed}s across ${sholds} cycle(s) — past this sense's own doze window ${swin}s (src=$ssrc, p90=${sp90}s over n=$sn runs)]"
        ;;
      DISCHARGED)
        hold_write DISCHARGED "$k$SOFT_KEY_SUFFIX" "$ssince" "$sholds" \
          "SOFT-DOZE self-cured: $k reads $st after ${selapsed}s and the doze note was never spent; window=${swin}s src=$ssrc doze_p90=${sp90}s(n=$sn)"
        ;;
    esac
  fi

  # Only a NEW alert-worthy DOWN, or an edge already being held, reaches the hold ladder. Everything
  # else keeps the old behaviour exactly — this change adds a gate in front of the ALERT, it does not
  # re-decide the truth table underneath it.
  if [ -z "$pend" ] && [ "$v" != ALERT ]; then
    case "$v" in NOTE) note="${note}  $k: $st — $det\n" ;; esac
    return
  fi

  [ -n "$since" ] || since="$(date -u +%FT%TZ)"
  elapsed="$(hold_elapsed "$since")"
  bnd="$(healer_bound)"; p95="${bnd%% *}"; bn="${bnd##* }"
  warn=""
  [ "$p95" != na ] && [ "${p95:-0}" -gt "$HOLD_WINDOW" ] 2>/dev/null \
    && warn=" BOUND-EXCEEDED(healer p95 ${p95}s > hold window ${HOLD_WINDOW}s — this hold is shorter than what it waits for)"
  [ "$p95" = na ] && warn=" BOUND-UNMEASURED(no readable mesh-link-heal RECOVERED rows — holding on an unverified window)"
  heals="$(healer_heals_since "$(date -u -d "$since" +%s 2>/dev/null || date -u +%s)")"

  d="$(hold_decide "$st" "$cz" "${pend:+HELD}" "$elapsed" "$HOLD_WINDOW")"
  case "$d" in
    HELD)
      # BLIND does not advance the count — it is "could not attempt", not evidence. The elapsed clock
      # keeps running underneath it, so a permanently blind sense still closes its own window.
      [ "$st" = BLIND ] || holds=$((holds+1))
      hold_write HELD "$k" "$since" "$holds" "cause=$cz st=$st elapsed=${elapsed}s/${HOLD_WINDOW}s healer_p95=${p95}s(n=$bn) heals_since_edge=$heals$warn — unspent; the actuator's outcome decides it next cycle"
      ;;
    DISCHARGED)
      hold_write DISCHARGED "$k" "$since" "$holds" "self-cured: $k reads $st after ${elapsed}s and the alert was never spent; heals_since_edge=$heals healer_p95=${p95}s(n=$bn)$warn"
      # ...and the restore [note] goes with it. A restore is only news if the DOWN it restores from was
      # ANNOUNCED; suppressing the alert while still posting its restore is the second of the two paid
      # turns this change exists to stop.
      v=NONE
      ;;
    FIRED)
      if [ -n "$pend" ]; then
        hold_write FIRED "$k" "$since" "$holds" "hold spent: still DOWN after ${elapsed}s >= ${HOLD_WINDOW}s; heals_since_edge=$heals healer_p95=${p95}s(n=$bn)$warn"
        alert="${alert}  $k: DOWN — $det [held ${elapsed}s across ${holds} cycle(s); ${heals} mesh-link-heal RECOVERED landed inside that window and the sense is STILL down — healer p95 ${p95}s/n=$bn$warn]\n"
      else
        hold_write FIRED "$k" "$since" 0 "not held: cause=$cz is not a reach failure, so mesh-link-heal's outcome cannot answer it"
        alert="${alert}  $k: DOWN — $det [cause=$cz — not a link fault; fired immediately, no hold]\n"
      fi
      ;;
  esac
  case "$v" in NOTE) note="${note}  $k: $st — $det\n" ;; esac
}
# The escalation line a mind reads MID-OUTAGE — so its seams are load-bearing, not cosmetic.
# Join header/body/states with EXPLICIT newlines. The body arrives carrying "\n" escapes and its own
# trailing one; strip that here ONCE (deterministically) and re-add each seam, because the obvious
# spelling cannot work: $(printf '%b' "$body") deletes trailing newlines, so the old
# "...$(printf '\n'; printf '%b' "$alert")states: $snap" welded the last detail onto the label —
# "curl exit 7states: ts=DOWN". The DM (mesh-tg) renders the newlines; the board copy gets them
# flattened to spaces by mesh-chat's tr, which is why a REAL separator has to be there to flatten.
NL="$(printf '\nx')"; NL="${NL%x}"
weld_msg(){  # <header> <body-with-\n-escapes> [snapshot] -> multi-line message
  # snapshot OPTIONAL: omit it (note path) and NO 'states:' line is welded — the human delta
  # only. The canonical machine snapshot is the separate [access-state] line; duplicating it in
  # the [note] body was pure noise on every change (chat-review 21:39, access-probe-note-state-dup).
  local hdr="$1" body="$2" snap="${3-}"
  body="$(printf '%b' "$body")"
  if [ -n "$snap" ]; then
    printf '%s%s%s%sstates: %s' "$hdr" "$NL" "$body" "$NL" "$snap"
  else
    printf '%s%s%s' "$hdr" "$NL" "$body"
  fi
}

render() {
  local snap ts now e age k st
  snap="$(bus_snap)"; [ -n "$snap" ] || { echo "  (access senses: no [access-state] marker yet — cron posts on first run/change)"; return; }
  ts="$(bus_when)"; now=$(date +%s); e=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
  age=$(( (now - e) / 60 )); [ "$age" -lt 0 ] && age=0
  echo "  access senses (proprioception — stable since last change ${age}m ago):"
  for k in ts anthropic groq phone; do
    st="$(prev_st "$k" "$snap")"; printf '    %-10s %s\n' "$k" "${st:--}"
  done
  printf '    %s\n' "$(hold_summary)"
}

probe_all() {  # echoes "ts=.. anthropic=.. groq=.. phone=.." to stdout, detail lines to fd 3
  # Each sensor prints STATE<TAB>detail<TAB>cause. The cause is the sensor's own claim about WHAT KIND
  # of fault it saw (reach|auth|other|none) and it is read HERE, at the source, never re-derived by
  # scanning the detail prose downstream ([[substring-scan-turns-prose-into-a-verdict]]).
  local a
  a="$(s_ts)";             IFS=$'\t' read -r TS_ST  TS_DT  TS_CZ  <<<"$a"
  a="$(s_anthropic)";      IFS=$'\t' read -r ANT_ST ANT_DT ANT_CZ <<<"$a"
  a="$(s_groq)";           IFS=$'\t' read -r GRQ_ST GRQ_DT GRQ_CZ <<<"$a"
  a="$(s_phone "$TS_ST")"; IFS=$'\t' read -r PH_ST  PH_DT  PH_CZ  <<<"$a"
  : "${TS_CZ:=other}" "${ANT_CZ:=other}" "${GRQ_CZ:=other}" "${PH_CZ:=other}"
  printf 'ts=%s anthropic=%s groq=%s phone=%s\n' "$TS_ST" "$ANT_ST" "$GRQ_ST" "$PH_ST"
}

live_once() {
  probe_all >/dev/null
  echo "  access senses (LIVE — probed $(date -u +%H:%M:%SZ)):"
  printf '  %-10s %-5s %s\n' ts        "$TS_ST"  "$TS_DT"
  printf '  %-10s %-5s %s\n' anthropic "$ANT_ST" "$ANT_DT"
  printf '  %-10s %-5s %s\n' groq      "$GRQ_ST" "$GRQ_DT"
  printf '  %-10s %-5s %s\n' phone     "$PH_ST"  "$PH_DT"
  [ "$TS_ST" = DOWN ] || [ "$ANT_ST" = DOWN ] || [ "$GRQ_ST" = DOWN ] \
    && echo "  ! a sense is DOWN — escalation is the cron's job (transition-only)"
  return 0
}

case "${1:-}" in
  --test)
    f=""
    # the marker's key is the TOOL's identity, immune to an inherited MESH_WHO (every mind pane has one)
    [ "$(probe_who h1)" = "access-probe@h1" ]                    || f="$f who-not-tool-scoped"
    [ "$(MESH_WHO=intruder@x probe_who h1)" = "access-probe@h1" ] || f="$f who-taken-from-env"
    [ "$BUS_WHO" = "$MESH_WHO" ]                                 || f="$f who-read-write-split"
    # prev_st: pure parse from a snapshot string
    snap="ts=OK anthropic=DOWN groq=BLIND phone=OK"
    [ "$(prev_st ts "$snap")" = OK ]         || f="$f prevst-ts"
    [ "$(prev_st anthropic "$snap")" = DOWN ] || f="$f prevst-ant"
    [ "$(prev_st groq "$snap")" = BLIND ]    || f="$f prevst-groq"
    [ -z "$(prev_st missing "$snap")" ]      || f="$f prevst-missing-not-empty"
    # classify_transition: the escalation truth table
    [ "$(classify_transition DOWN OK)" = ALERT ]    || f="$f ct-down-alert"
    [ "$(classify_transition DOWN DOWN)" = NONE ]   || f="$f ct-down-nochange"
    [ "$(classify_transition DOWN '')" = ALERT ]    || f="$f ct-down-fromblank"   # first-run DOWN alerts unless first-run gate suppresses (see run body)
    [ "$(classify_transition BLIND OK)" = NOTE ]    || f="$f ct-blind-note"
    [ "$(classify_transition OK DOWN)" = NOTE ]     || f="$f ct-restore-note"
    [ "$(classify_transition OK BLIND)" = NONE ]    || f="$f ct-ok-fromblind-quiet"
    [ "$(classify_transition OK OK)" = NONE ]       || f="$f ct-ok-nochange"
    # chronic-DOWN re-arm (2026-07-17): BLIND carries no information, but it overwrote the recorded
    # DOWN in the marker, so the next DOWN read as news and re-ALERTed the same known fault every
    # sleep/wake cycle (8+ phone alarms in a day for the one no-key-on-redmi state). The ALERT
    # decision takes a third arg — the last INFORMATIVE (non-BLIND) recorded state — and a DOWN
    # whose last informative state was already DOWN is a re-manifestation, not news.
    [ "$(classify_transition DOWN BLIND DOWN)" = NONE ]  || f="$f ct-reblind-rearmed"
    [ "$(classify_transition DOWN BLIND OK)" = ALERT ]   || f="$f ct-down-after-restore-quiet"
    [ "$(classify_transition OK BLIND DOWN)" = NOTE ]    || f="$f ct-restore-thru-blind-quiet"
    # BLIND mirrors DOWN's chronic-suppression: a BLIND whose last informative state was DOWN is the
    # SLEEP phase of the same known fault (phone DOWN then asleep), not a fresh sight-loss — so NONE,
    # not a re-NOTE every sleep/wake cycle. BLIND-from-OK / BLIND-from-blank stay NOTE: first sight-loss
    # IS news. Restores are unaffected — they surface via the OK branch (OK-from-blind-with-DOWN-behind
    # -> NOTE). (chat-review/access-probe-blind-from-down-asymmetric-note.)
    [ "$(classify_transition BLIND DOWN DOWN)" = NONE ]  || f="$f ct-blind-from-down-quiet"
    [ "$(classify_transition BLIND OK OK)" = NOTE ]      || f="$f ct-blind-from-ok-note"
    [ "$(classify_transition BLIND '' '')" = NOTE ]      || f="$f ct-blind-fromblank-note"
    # a SLEEPING phone must never cry wolf: BLIND is the quiet state, whatever it came from
    [ "$(classify_transition BLIND OK)" != ALERT ]  || f="$f phone-blind-alerted"
    # classify_ssh_outcome: "asleep" vs "refusing us" are different claims (the bug this tool shipped:
    # every non-zero ssh read as expected-asleep, so a live sshd rejecting our creds was never a fault)
    [ "$(classify_ssh_outcome 0 '')" = OK ]                                              || f="$f ssho-rc0-not-ok"
    [ "$(classify_ssh_outcome 255 'u0_a380@1.2.3.4: Permission denied (publickey).')" = DOWN ] || f="$f ssho-refused-not-down"
    [ "$(classify_ssh_outcome 255 'Received disconnect: Too many authentication failures')" = DOWN ] || f="$f ssho-toomany-not-down"
    [ "$(classify_ssh_outcome 255 'Host key verification failed.')" = DOWN ]             || f="$f ssho-hostkey-not-down"
    [ "$(classify_ssh_outcome 255 'ssh: connect to host 1.2.3.4 port 8022: Connection timed out')" = BLIND ] || f="$f ssho-timeout-not-blind"
    [ "$(classify_ssh_outcome 255 'ssh: connect to host 1.2.3.4 port 8022: No route to host')" = BLIND ]     || f="$f ssho-noroute-not-blind"
    [ "$(classify_ssh_outcome 124 '')" = BLIND ]                                         || f="$f ssho-timeoutkill-not-blind"
    # the two must not be the same answer — the whole point of the split
    [ "$(classify_ssh_outcome 255 'Permission denied (publickey).')" \
      != "$(classify_ssh_outcome 255 'Connection timed out')" ]                          || f="$f ssho-refused-eq-asleep"
    # and a REFUSAL must reach an ALERT end-to-end (DOWN is only news if the ladder carries it)
    [ "$(classify_transition "$(classify_ssh_outcome 255 'Permission denied (publickey).')" BLIND)" = ALERT ] || f="$f ssho-refusal-no-alert"
    # phone_verdict: OK wins; a refusal on ANY path outranks silence on the others; else BLIND
    [ "$(phone_verdict BLIND OK)" = OK ]        || f="$f pv-ok-loses"
    [ "$(phone_verdict BLIND DOWN)" = DOWN ]    || f="$f pv-down-loses-to-blind"
    [ "$(phone_verdict DOWN OK)" = OK ]         || f="$f pv-ok-loses-to-down"
    [ "$(phone_verdict BLIND BLIND)" = BLIND ]  || f="$f pv-blind"
    # phone_candidates: the LAN is a real path — dialling only the tailnet is how an awake body
    # (off-tailnet, on-LAN — this node's live case) became unreachable BY CONSTRUCTION
    _c="$(PHONE_TS_IP=100.0.0.1 PHONE_LAN_IPS='192.168.9.9 192.168.9.10' phone_candidates OK)"
    [ "$(printf '%s' "$_c" | grep -c .)" = 3 ]  || f="$f pc-not-3"
    case "$_c" in *192.168.9.10*) ;; *) f="$f pc-drops-lan" ;; esac
    # ts DOWN does not blind us to a body on the LAN...
    _c="$(PHONE_TS_IP=100.0.0.1 PHONE_LAN_IPS='192.168.9.9' phone_candidates DOWN)"
    [ "$_c" = 192.168.9.9 ]                     || f="$f pc-ts-down-drops-lan"
    # ...but with no LAN configured, ts DOWN really is "cannot attempt" — the cascade where it's TRUE
    [ -z "$(PHONE_TS_IP=100.0.0.1 PHONE_LAN_IPS='' phone_candidates DOWN)" ] || f="$f pc-ts-down-no-lan-not-empty"
    # bus_last_informative + the live treadmill, driven end-to-end against a sandboxed board:
    # OK -> DOWN -> BLIND -> DOWN must raise exactly ONE ALERT, while the marker (display truth)
    # still records the BLIND. All fixture writes go to a scratch board, never the real one.
    _tb="$(mktemp)"; _ob="$BOARD"; BOARD="$_tb"; _obw="$BUS_WHO"; BUS_WHO="access-probe@self"; _alerts=0; _notes=0
    # Fixture rows are written in mesh-chat's REAL wire format ('%s  %s  ::  %s', two-space fields) and
    # carry a POSTER, because the board this tool actually reads is a mesh-chat-sync UNION of every
    # peer's log. The old fixture stamped one hardcoded poster ('test') on every row, so the treadmill
    # below was proven only against a single-writer board — structurally blind to the union, which is
    # exactly why the gate read green while the live tool posted a marker every cycle.
    _mark(){ # <poster> <phone-state>
      printf '2026-07-17T00:00:00Z  %s  ::  [access-state] ts=OK anthropic=OK groq=OK phone=%s\n' "$1" "$2" >> "$_tb"; }
    _mark "$BUS_WHO" OK
    # two full flaps: the chronic no-key phone sleeps and wakes twice — exactly ONE ALERT (the first
    # DOWN) and ZERO NOTEs (every DOWN-re-manifest and every BLIND-from-DOWN is the same known fault).
    for _st in DOWN BLIND DOWN BLIND; do
      _p="$(prev_st phone "$(bus_snap)")"; _li="$(bus_last_informative phone)"
      [ "$_st" = BLIND ] && { [ "$_p" = DOWN ] || f="$f drive-prev-lost"; }
      _v="$(classify_transition "$_st" "$_p" "$_li")"
      [ "$_v" = ALERT ] && _alerts=$((_alerts+1))
      [ "$_v" = NOTE ]  && _notes=$((_notes+1))
      _mark "$BUS_WHO" "$_st"
    done
    [ "$_alerts" = 1 ] || f="$f drive-alerts-$_alerts-not-1"
    [ "$_notes" = 0 ]  || f="$f drive-notes-$_notes-not-0"
    # mid-treadmill the marker really did say BLIND (display truth intact) and li still said DOWN
    printf '%s\n' "$(head -3 "$_tb")" > "$_tb"   # rewind to after the BLIND marker
    [ "$(prev_st phone "$(bus_snap)")" = BLIND ]     || f="$f drive-display-not-blind"
    [ "$(bus_last_informative phone)" = DOWN ]       || f="$f li-not-down-thru-blind"
    # all-BLIND history -> li empty -> a DOWN still ALERTs (fail-loud: no informative past = news)
    : > "$_tb"; _mark "$BUS_WHO" BLIND
    [ -z "$(bus_last_informative phone)" ]           || f="$f li-allblind-not-empty"
    [ "$(classify_transition DOWN BLIND "$(bus_last_informative phone)")" = ALERT ] || f="$f li-empty-down-no-alert"

    # --- TWO-POSTER UNION (the live shape): a PEER flapping while OUR OWN reading never moves -------
    # This is the arm the single-poster fixture could not have: the board carries a second node's
    # markers interleaved with ours. Ours say phone=OK throughout; the peer alternates DOWN/BLIND.
    # A correctly-keyed reader sees prev=OK and li=OK on EVERY cycle -> zero changes, zero escalations,
    # and the marker stays quiet. Unfiltered (the shipped bug) prev is the PEER's value, so every
    # cycle registers a change and the tool posts a marker per cycle forever.
    : > "$_tb"; _peer="access-probe@peer"; _changes=0; _alerts2=0; _notes2=0
    _mark "$BUS_WHO" OK
    for _st in DOWN BLIND DOWN BLIND DOWN; do
      _mark "$_peer" "$_st"                      # the peer posts first this cycle
      _p="$(prev_st phone "$(bus_snap)")"; _li="$(bus_last_informative phone)"
      [ "$_p" = OK ]  || _changes=$((_changes+1))   # OUR reading is OK every cycle
      _v="$(classify_transition OK "$_p" "$_li")"
      [ "$_v" = ALERT ] && _alerts2=$((_alerts2+1))
      [ "$_v" = NOTE ]  && _notes2=$((_notes2+1))
      _mark "$BUS_WHO" OK                        # ...and we post ours, unchanged
    done
    [ "$_changes" = 0 ] || f="$f union-prev-stolen-$_changes"
    [ "$_alerts2" = 0 ] || f="$f union-alerts-$_alerts2"
    [ "$_notes2" = 0 ]  || f="$f union-notes-$_notes2"
    # A marker whose poster is a peer is not ours even when it is the LAST line on the board — and
    # the peer's DOWN must never enter OUR escalation ladder's memory. That second one is the
    # DANGEROUS direction and it needs the peer's DOWN to be the last informative line on the board:
    # with an unfiltered bus_last_informative our own FIRST DOWN reads as a re-manifestation of the
    # peer's chronic fault (classify_transition DOWN OK DOWN = NONE) and we go SILENT on a real
    # break of our own reach. Assert the verdict, not just the field — a peer-scoped li check taken
    # while our own OK is still the newest informative line cannot tell the two readers apart.
    _mark "$_peer" DOWN
    [ "$(prev_st phone "$(bus_snap)")" = OK ]  || f="$f union-tail-is-peer"
    [ "$(bus_last_informative phone)" = OK ]   || f="$f union-li-from-peer"
    [ "$(classify_transition DOWN OK "$(bus_last_informative phone)")" = ALERT ] \
      || f="$f union-peer-down-silences-ours"
    # a verdict's FREE TEXT quoting a whole marker line is not a marker (witness posts exactly this)
    printf '2026-07-17T00:00:00Z  witness@self  ::  [chat-review] CODE: 2026-07-17T00:00:00Z  %s  ::  [access-state] ts=OK anthropic=OK groq=OK phone=DOWN is the bug\n' "$BUS_WHO" >> "$_tb"
    [ "$(prev_st phone "$(bus_snap)")" = OK ] || f="$f union-prose-read-as-marker"
    # ...and the poster must be matched as the FIELD, never as a substring of the whole line. The
    # prose arm above cannot prove that: its body is "[chat-review] ...", so the BODY predicate
    # rejects it whichever way the poster is matched, and a substring mutant stays GREEN through it
    # ([[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]). The discriminating case
    # is a FOREIGN poster whose body IS a well-formed marker and whose text merely NAMES us — a peer
    # relaying or quoting our identity inside its own state line. Only a field match rejects it.
    printf '2026-07-17T00:00:01Z  %s  ::  [access-state] ts=OK anthropic=OK groq=OK phone=DOWN (relayed for %s)\n' "$_peer" "$BUS_WHO" >> "$_tb"
    [ "$(prev_st phone "$(bus_snap)")" = OK ] || f="$f union-poster-matched-as-substring"
    rm -f "$_tb"; BOARD="$_ob"; BUS_WHO="$_obw"
    # weld_msg: the seam before 'states:' — the line a mind reads mid-outage, in BOTH consumers.
    _a="  ts: DOWN — tailscaled not running\n  anthropic: DOWN — curl exit 7\n"
    _snap="ts=DOWN anthropic=DOWN groq=OK phone=OK"
    _m="$(weld_msg "ACCESS-DOWN — reach broken." "$_a" "$_snap")"
    # (a) DM/raw: 'states:' must start its own line, never glued to a detail ('exit 7states:')
    case "$_m" in *"${NL}states: ts=DOWN"*) ;; *) f="$f weld-states-not-line-start" ;; esac
    printf '%s' "$_m" | grep -qE '[^[:space:]]states:'  && f="$f weld-states-glued"
    [ "$(printf '%s' "$_m" | wc -l)" = 3 ]              || f="$f weld-not-multiline"   # DM keeps its lines
    # (b) board: flattened through mesh-chat's own tr, the seam must survive as ' states: '
    _flat="$(printf '%s' "$_m" | tr '\n\t' '  ' | tr -s ' ')"
    case "$_flat" in *" states: ts=DOWN"*) ;; *) f="$f weld-flat-seam" ;; esac
    case "$_flat" in *"7states:"*) f="$f weld-flat-glued" ;; esac
    # (c) the [note] path (snapshot OMITTED) carries the human delta ONLY — NO 'states:' snapshot.
    # That snapshot is the separate [access-state] line's job; welding it into the note duplicated it
    # on every change (chat-review 21:39). RED without the optional-snap branch: 2-arg weld still emits 'states:'.
    _note="$(weld_msg "access change:" "$_a")"
    case "$_note" in *states:*) f="$f note-duplicates-snapshot" ;; esac
    case "$_note" in *"access change:"*"ts: DOWN"*) ;; *) f="$f note-lost-delta" ;; esac
    # --- the alert behind the ACTUATOR's outcome (chat-review/access-down-alerts-on-the-fault-...) ----
    # (i) the CAUSE mapping, pure. This is the eligibility predicate the hold gate reads, so it is
    # driven directly rather than inferred from a live probe.
    [ "$(cause_of_backend NeedsLogin)" = auth ]        || f="$f cz-needslogin-not-auth"
    [ "$(cause_of_backend NeedsMachineAuth)" = auth ]  || f="$f cz-needsmachineauth-not-auth"
    [ "$(cause_of_backend Running)" = reach ]          || f="$f cz-running-not-reach"
    [ "$(cause_of_backend NoState)" = reach ]          || f="$f cz-nostate-not-reach"
    [ "$(cause_of_backend Stopped)" = other ]          || f="$f cz-stopped-not-other"
    [ "$(cause_of_backend '?')" = other ]              || f="$f cz-unknown-not-other"
    [ "$(cause_of_backend SomeFutureState)" = other ]  || f="$f cz-future-state-not-other"
    [ "$(anthropic_verdict 000)" = "$(printf 'DOWN\treach')" ] || f="$f av-000-not-reach"
    [ "$(anthropic_verdict 403)" = "$(printf 'DOWN\tauth')" ]  || f="$f av-403-not-auth"
    [ "$(anthropic_verdict 405)" = "$(printf 'OK\tnone')" ]    || f="$f av-405-not-ok"
    [ "$(groq_verdict 200)" = "$(printf 'OK\tnone')" ]         || f="$f gv-200-not-ok"
    [ "$(groq_verdict 401)" = "$(printf 'DOWN\tauth')" ]       || f="$f gv-401-not-auth"
    [ "$(groq_verdict 000)" = "$(printf 'DOWN\treach')" ]      || f="$f gv-000-not-reach"
    [ "$(groq_verdict 503)" = "$(printf 'DOWN\tother')" ]      || f="$f gv-503-not-other"
    # a reach fault and an auth fault must not share an answer — the whole point of the split
    [ "$(groq_verdict 000)" != "$(groq_verdict 401)" ]         || f="$f gv-reach-eq-auth"

    # (ii) hold_decide truth table, pure
    [ "$(hold_decide DOWN reach '' 0 600)" = HELD ]        || f="$f hd-new-reach-not-held"
    [ "$(hold_decide DOWN auth  '' 0 600)" = FIRED ]       || f="$f hd-new-auth-not-fired"
    [ "$(hold_decide DOWN other '' 0 600)" = FIRED ]       || f="$f hd-new-other-not-fired"
    [ "$(hold_decide DOWN '' '' 0 600)" = FIRED ]          || f="$f hd-new-blank-cause-not-fired"
    [ "$(hold_decide DOWN reach HELD 0 600)" = HELD ]      || f="$f hd-pending-early-not-held"
    [ "$(hold_decide DOWN reach HELD 599 600)" = HELD ]    || f="$f hd-pending-underwindow-not-held"
    [ "$(hold_decide DOWN reach HELD 600 600)" = FIRED ]   || f="$f hd-pending-atwindow-not-fired"
    [ "$(hold_decide DOWN reach HELD 9000 600)" = FIRED ]  || f="$f hd-pending-late-not-fired"
    [ "$(hold_decide OK reach HELD 30 600)" = DISCHARGED ] || f="$f hd-restore-not-discharged"
    [ "$(hold_decide BLIND reach HELD 30 600)" = HELD ]    || f="$f hd-blind-not-held"
    # BLIND is not evidence, but it must not become an immortal hold either: past the window a DOWN
    # still fires, so the elapsed clock — not the reading — is what closes it.
    [ "$(hold_decide BLIND reach HELD 9000 600)" = HELD ]  || f="$f hd-blind-past-window-not-held"
    [ "$(hold_decide DOWN auth HELD 0 600)" = HELD ]       || f="$f hd-pending-ignores-cause"
    # the discriminating pair: an auth DOWN and a reach DOWN take DIFFERENT paths on first sight
    [ "$(hold_decide DOWN reach '' 0 600)" != "$(hold_decide DOWN auth '' 0 600)" ] || f="$f hd-cause-not-load-bearing"

    # (iii) the ledger: positional parse, and a resolved edge stops being pending
    _hl="$(mktemp)"; _ohl="$HOLDLOG"; HOLDLOG="$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:00:00Z HELD ts 2026-08-27T00:00:00Z 1 'cause=reach' >> "$_hl"
    [ "$(hold_pending ts)" = "2026-08-27T00:00:00Z 1" ] || f="$f hp-not-pending"
    [ -z "$(hold_pending anthropic)" ]                  || f="$f hp-wrong-sense-pending"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:10:00Z FIRED ts 2026-08-27T00:00:00Z 1 'hold spent' >> "$_hl"
    [ -z "$(hold_pending ts)" ]                         || f="$f hp-fired-still-pending"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:20:00Z HELD ts 2026-08-27T00:20:00Z 1 'cause=reach' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:30:00Z DISCHARGED ts 2026-08-27T00:20:00Z 1 'self-cured' >> "$_hl"
    [ -z "$(hold_pending ts)" ]                         || f="$f hp-discharged-still-pending"
    # a FIRED row whose FREE TEXT quotes the word HELD is still resolved — the verb is read by
    # POSITION, never found in the prose ([[a-verdicts-free-text-quotes-another-records-fields]])
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:40:00Z FIRED groq 2026-08-27T00:35:00Z 2 'was HELD 2 cycles before this' >> "$_hl"
    [ -z "$(hold_pending groq)" ]                       || f="$f hp-prose-read-as-verb"
    rm -f "$_hl"; HOLDLOG="$_ohl"

    # (iv) healer_bound reads BOTH row shapes, and says so when it can read neither
    _lh="$(mktemp)"; _olh="$LINKHEAL_LOG"; LINKHEAL_LOG="$_lh"
    [ "$(healer_bound)" = "na 0" ]                      || f="$f hb-empty-not-na"
    printf '2026-08-21T16:04:02Z  RECOVERED iface=w after 1 down-check(s) / >=61s dark (lower bound, window=5s/60s)\n' >> "$_lh"
    printf '2026-08-27T01:34:01Z  RECOVERED iface=w shape=x after 3 down-check(s) / 174s to-recovery (elapsed)\n' >> "$_lh"
    [ "$(healer_bound)" = "174 2" ]                     || f="$f hb-both-shapes-$(healer_bound)"
    # a row in ONLY the old spelling must still be counted — the corpus changed shape mid-life
    : > "$_lh"; printf '2026-08-21T16:04:02Z  RECOVERED iface=w after 1 down-check(s) / >=61s dark (lower bound)\n' >> "$_lh"
    [ "$(healer_bound)" = "61 1" ]                      || f="$f hb-old-shape-only-$(healer_bound)"
    # a non-RECOVERED row carrying the same words is not a recovery
    : > "$_lh"; printf '2026-08-21T16:04:02Z  ACTION reassociate mentions >=61s dark somewhere\n' >> "$_lh"
    [ "$(healer_bound)" = "na 0" ]                      || f="$f hb-action-row-counted"
    _hs="$(healer_heals_since 0)"; [ "$_hs" = 0 ] || f="$f hs-action-row-counted-$_hs"
    rm -f "$_lh"; LINKHEAL_LOG="$_olh"
    [ "$(MESH_LINKHEAL_LOG=/nonexistent-$$ ; LINKHEAL_LOG=/nonexistent-$$; healer_heals_since 0)" = na ] || f="$f hs-unreadable-not-na"

    # (v) END-TO-END through consider(): the four-cycle episode this task was filed for.
    # Cycle 1 a reach DOWN -> held, board silent. Cycle 2 the healer fixed it -> discharged, and the
    # RESTORE note is suppressed too (the DOWN it restores from was never announced). Cycle 3 a fresh
    # reach DOWN -> held. Cycle 4 still DOWN past the window -> the alert finally fires, carrying the
    # elapsed downtime. Nothing here touches the real ledger, the real healer log or the real board.
    # THE BOARD IS SANDBOXED AND FED per cycle, not left pointing at the live one: prev AND the last
    # informative state both come off it, and against the real board `li` reads whatever this node's
    # senses actually are — which made the restore-suppression assertions pass for a reason that had
    # nothing to do with the suppression ([[a-mutant-can-go-red-for-the-wrong-reason]]).
    _age_edge(){ # <ledger> — force every edge's `since` (field 4) far into the past, deterministically
      awk -F'\t' -v OFS='\t' '{ $4 = "2020-01-01T00:00:00Z"; print }' "$1" > "$1.aged" && mv "$1.aged" "$1"; }
    _hl="$(mktemp)"; _lh="$(mktemp)"; _tb2="$(mktemp)"
    _ohl="$HOLDLOG"; _olh="$LINKHEAL_LOG"; _ow="$HOLD_WINDOW"; _obd2="$BOARD"; _obw2="$BUS_WHO"
    HOLDLOG="$_hl"; LINKHEAL_LOG="$_lh"; HOLD_WINDOW=600; BOARD="$_tb2"; BUS_WHO="access-probe@self"
    printf '2026-08-27T01:34:01Z  RECOVERED iface=w after 3 down-check(s) / 174s to-recovery\n' >> "$_lh"
    _mk2(){ printf '2026-08-27T00:00:00Z  %s  ::  [access-state] ts=%s anthropic=OK groq=OK phone=OK\n' "$BUS_WHO" "$1" >> "$_tb2"; }
    _cycle(){ # <state> <cause> — prev and li BOTH come from the sandboxed board
      alert=""; note=""; changed=0; dry=""; prev_snap="$(bus_snap)"
      consider ts "$1" "detail-for-$1" "$2"
    }
    _mk2 OK
    _cycle DOWN reach
    [ -z "$alert" ]                                      || f="$f e2e-first-down-alerted"
    [ -z "$note" ]                                       || f="$f e2e-first-down-noted"
    [ -n "$(hold_pending ts)" ]                          || f="$f e2e-first-down-not-held"
    grep -q "$(printf 'HELD\tts')" "$_hl"                || f="$f e2e-no-held-row"
    _mk2 DOWN                                            # the marker stays HONEST while the edge is held
    [ "$(bus_last_informative ts)" = DOWN ]              || f="$f e2e-li-not-down"   # else the next leg is vacuous
    _cycle OK none
    [ -z "$alert" ]                                      || f="$f e2e-restore-alerted"
    [ -z "$note" ]                                       || f="$f e2e-restore-note-not-suppressed"
    [ -z "$(hold_pending ts)" ]                          || f="$f e2e-discharge-left-pending"
    grep -q "$(printf 'DISCHARGED\tts')" "$_hl"          || f="$f e2e-no-discharged-row"
    # a second episode: this one the healer does NOT fix, and the held alert must come due
    _mk2 OK
    _cycle DOWN reach
    [ -z "$alert" ]                                      || f="$f e2e-second-down-alerted"
    _mk2 DOWN
    _age_edge "$_hl"                                       # age the edge past the window (by FIELD, not by a clock race)
    _cycle DOWN reach
    [ -n "$alert" ]                                      || f="$f e2e-spent-hold-never-fired"
    case "$alert" in *"held "*"cycle(s)"*) ;; *) f="$f e2e-alert-lost-hold-provenance" ;; esac
    grep -q "$(printf 'FIRED\tts')" "$_hl"               || f="$f e2e-no-fired-row"
    # an AUTH DOWN is never held: it fires on its first sighting, with a row of its own
    : > "$_tb2"; _mk2 OK
    _cycle DOWN auth
    [ -n "$alert" ]                                      || f="$f e2e-auth-down-held"
    case "$alert" in *"cause=auth"*) ;; *) f="$f e2e-auth-alert-no-cause" ;; esac
    [ -z "$(hold_pending ts)" ]                          || f="$f e2e-auth-left-pending"
    # ...and it is ON THE TAPE. An edge that was never ELIGIBLE for a hold still belongs in the
    # denominator: without its row the ledger answers "of the edges we held, how many self-cured",
    # which is not the suppression rate anyone wants to read
    # ([[a-tape-of-only-positives-is-a-numerator]]). Read by POSITION — holds=0 is what marks an
    # edge that was fired without ever being held.
    [ "$(awk -F'\t' '$2=="FIRED" && $5=="0"{c++} END{print c+0}' "$_hl")" = 1 ] \
      || f="$f e2e-unheld-edge-not-ledgered"
    # ...and after a real FIRE, a restore IS news again — the suppression is scoped to edges that
    # were never announced, not to restores in general.
    _mk2 DOWN
    [ "$(bus_last_informative ts)" = DOWN ]              || f="$f e2e-li2-not-down"
    _cycle OK none
    [ -n "$note" ]                                       || f="$f e2e-restore-after-fire-suppressed"
    [ -z "$alert" ]                                      || f="$f e2e-restore-after-fire-alerted"
    # both verbs are on the tape, so a suppression rate is computable rather than a numerator
    grep -q "$(printf '\tDISCHARGED\t')" "$_hl" && grep -q "$(printf '\tFIRED\t')" "$_hl" \
      || f="$f e2e-ledger-has-no-denominator"
    # --dry must never write the ledger (a dry run that writes the record forges it)
    : > "$_tb2"; _mk2 OK
    _n0=$(wc -l < "$_hl"); alert=""; note=""; changed=0; prev_snap="$(bus_snap)"; dry=1
    consider ts DOWN detail reach 2>/dev/null
    [ "$(wc -l < "$_hl")" = "$_n0" ]                     || f="$f dry-wrote-the-ledger"
    dry=""
    rm -f "$_hl" "$_lh" "$_tb2"
    HOLDLOG="$_ohl"; LINKHEAL_LOG="$_olh"; HOLD_WINDOW="$_ow"; BOARD="$_obd2"; BUS_WHO="$_obw2"
    unset -f _cycle _mk2

    # (vi) hold_summary — the ledger's reader. A suppression rate is only visible if something prints
    # it, and the DENOMINATOR is the resolved edges (discharged + fired), never the held rows.
    _hl="$(mktemp)"; _ohl="$HOLDLOG"; HOLDLOG="$_hl"; _ow2="$HOLD_WINDOW"; HOLD_WINDOW=600
    case "$(HOLDLOG=/nonexistent-$$ hold_summary)" in *"no hold ledger yet"*) ;; *) f="$f hs-absent-not-said" ;; esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:10:00Z DISCHARGED ts 2026-08-27T00:00:00Z 1 'self-cured' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:20:00Z HELD ts 2026-08-27T00:20:00Z 1 'held' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:30:00Z FIRED ts 2026-08-27T00:20:00Z 1 'spent' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:40:00Z HELD groq 2026-08-27T00:40:00Z 1 'held' >> "$_hl"
    _hsum="$(hold_summary)"
    case "$_hsum" in *"1 suppressed / 2 resolved DOWN edges"*) ;; *) f="$f hs-rate-wrong: $_hsum" ;; esac
    case "$_hsum" in *"50%"*) ;; *) f="$f hs-pct-wrong: $_hsum" ;; esac
    # the still-open edge must be NAMED — an unresolved hold is a promise that never settled
    case "$_hsum" in *"1 open (groq since 2026-08-27T00:40:00Z)"*) ;; *) f="$f hs-open-edge-unnamed: $_hsum" ;; esac
    # ts's HELD row is NOT open: a later FIRED for the same sense resolved it (last-row-wins, by sense)
    case "$_hsum" in *"2 open"*) f="$f hs-resolved-counted-open" ;; esac
    case "$_hsum" in *"window 600s"*) ;; *) f="$f hs-no-window" ;; esac
    # a ledger with holds but nothing resolved must not mint a rate out of an empty denominator
    : > "$_hl"; printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:40:00Z HELD groq 2026-08-27T00:40:00Z 1 'held' >> "$_hl"
    case "$(hold_summary)" in *"no DOWN edge resolved yet"*) ;; *) f="$f hs-empty-denominator-minted-a-rate" ;; esac
    rm -f "$_hl"; HOLDLOG="$_ohl"; HOLD_WINDOW="$_ow2"

    # --- (vii) the SOFT ladder (chat-review/phone-soft-blind-edge-skips-the-hold-ladder) -----------
    # (a) soft_decide truth table, PURE. Note the two rows that discriminate it from hold_decide:
    # a pending BLIND ADVANCES here (it is the doze being timed) and a pending DOWN DISCHARGES here
    # (a refusal is a fault and belongs to the hard ladder, which must age it from its own edge).
    [ "$(soft_decide BLIND '' 0 1800)" = HELD ]           || f="$f sd-new-blind-not-held"
    [ "$(soft_decide OK    '' 0 1800)" = PASS ]           || f="$f sd-new-ok-not-pass"
    [ "$(soft_decide DOWN  '' 0 1800)" = PASS ]           || f="$f sd-new-down-not-pass"
    [ "$(soft_decide BLIND HELD 0 1800)" = HELD ]         || f="$f sd-pending-early-not-held"
    [ "$(soft_decide BLIND HELD 1799 1800)" = HELD ]      || f="$f sd-pending-underwindow-not-held"
    [ "$(soft_decide BLIND HELD 1800 1800)" = FIRED ]     || f="$f sd-pending-atwindow-not-fired"
    [ "$(soft_decide OK    HELD 60 1800)" = DISCHARGED ]  || f="$f sd-wake-not-discharged"
    [ "$(soft_decide DOWN  HELD 60 1800)" = DISCHARGED ]  || f="$f sd-refusal-not-discharged"
    # the discriminating pair against the HARD table: same inputs, opposite answers, so a soft edge
    # routed through hold_decide (or vice versa) cannot pass this
    [ "$(soft_decide BLIND HELD 9000 600)" != "$(hold_decide BLIND reach HELD 9000 600)" ] \
      || f="$f sd-blind-same-as-hard"
    # (b) doze_bound: the window is MEASURED off this node's own marker stream, and refuses to
    # calibrate off a corpus too small to be a habit — a p90 over three points is a constant wearing
    # a measurement's clothes.
    _tb4="$(mktemp)"; _ob4="$BOARD"; _obw4="$BUS_WHO"; BOARD="$_tb4"; BUS_WHO="access-probe@self"
    _mk4(){ printf '%s  %s  ::  [access-state] ts=OK anthropic=OK groq=OK phone=%s\n' "$1" "$BUS_WHO" "$2" >> "$_tb4"; }
    [ "$(doze_bound phone)" = "na 0" ]                    || f="$f db-empty-not-na"
    # ten runs: nine of 600s and one of 6000s -> p90 must be the 600s habit, not the outlier
    _h=0; _t0=1700000000
    while [ "$_h" -lt 9 ]; do
      _mk4 "$(TZ=UTC0 date -u -d "@$((_t0))" +%FT%TZ)" BLIND
      _mk4 "$(TZ=UTC0 date -u -d "@$((_t0+600))" +%FT%TZ)" OK
      _t0=$((_t0+7200)); _h=$((_h+1))
    done
    [ "$(doze_bound phone)" = "600 9" ]                   || f="$f db-nine-600s-$(doze_bound phone)"
    # ...and below MIN_N it says na WITH the count, never a number
    case "$(MESH_ACCESS_DOZE_MIN_N=20 ; DOZE_MIN_N=20; doze_bound phone)" in "na 9") ;; *) f="$f db-underpowered-minted-a-number" ;; esac
    _mk4 "$(TZ=UTC0 date -u -d "@$((_t0))" +%FT%TZ)" BLIND
    _mk4 "$(TZ=UTC0 date -u -d "@$((_t0+6000))" +%FT%TZ)" OK
    [ "$(doze_bound phone)" = "6000 10" ]                 || f="$f db-p90-not-top-decile-$(doze_bound phone)"
    # a PEER's markers are not our corpus (the board is a union) — same filter as every other reader
    printf '2001-01-01T00:00:00Z  access-probe@peer  ::  [access-state] ts=OK anthropic=OK groq=OK phone=BLIND\n' >> "$_tb4"
    printf '2002-01-01T00:00:00Z  access-probe@peer  ::  [access-state] ts=OK anthropic=OK groq=OK phone=OK\n' >> "$_tb4"
    [ "$(doze_bound phone)" = "6000 10" ]                 || f="$f db-peer-runs-in-our-corpus"
    # (c) soft_window: four SOURCES that must never render alike
    _sw="$(soft_window phone)";           case "$_sw" in "6000 corpus-p90 6000 10") ;; *) f="$f sw-corpus-$_sw" ;; esac
    _sw="$(SOFT_WINDOW_MAX=3000 soft_window phone)"
    case "$_sw" in "3000 corpus-p90-clamped-max 6000 10") ;; *) f="$f sw-clamp-max-$_sw" ;; esac
    _sw="$(SOFT_WINDOW_MIN=6500 soft_window phone)"
    case "$_sw" in "6500 corpus-p90-clamped-min 6000 10") ;; *) f="$f sw-clamp-min-$_sw" ;; esac
    _sw="$(MESH_ACCESS_SOFT_HOLD_WINDOW=42 soft_window phone)"
    case "$_sw" in "42 env 6000 10") ;; *) f="$f sw-env-$_sw" ;; esac
    : > "$_tb4"
    _sw="$(soft_window phone)"
    case "$_sw" in "1800 default-uncalibrated na 0") ;; *) f="$f sw-uncalibrated-$_sw" ;; esac
    # ...and the uncalibrated fallback must NOT wear the calibrated word — that is the whole point
    case "$_sw" in *corpus*) f="$f sw-fallback-claims-corpus" ;; esac
    rm -f "$_tb4"; BOARD="$_ob4"; BUS_WHO="$_obw4"; unset -f _mk4

    # (d) END-TO-END through consider(): the doze episode this task was filed for.
    # Cycle 1 the phone dozes -> HELD, board silent (this is the 45-notes-in-3.2-days case).
    # Cycle 2 it wakes inside the window -> DISCHARGED, and NO note was ever spent.
    # Cycle 3 it dozes again and STAYS blind past the window -> ONE note, carrying its age.
    # Cycle 4 a refusal (DOWN) arrives on a pending doze -> the doze discharges and the HARD ladder
    #         judges the fault on its own edge: the alert is NOT swallowed.
    _hl="$(mktemp)"; _tb5="$(mktemp)"; _lh5="$(mktemp)"
    _ohl="$HOLDLOG"; _obd5="$BOARD"; _obw5="$BUS_WHO"; _olh5="$LINKHEAL_LOG"
    HOLDLOG="$_hl"; BOARD="$_tb5"; BUS_WHO="access-probe@self"; LINKHEAL_LOG="$_lh5"
    export MESH_ACCESS_SOFT_HOLD_WINDOW=1800     # pinned so the arm tests the LADDER, not the corpus
    _mk5(){ printf '2026-08-28T00:00:00Z  %s  ::  [access-state] ts=OK anthropic=OK groq=OK phone=%s\n' "$BUS_WHO" "$1" >> "$_tb5"; }
    _cyc5(){ alert=""; note=""; changed=0; dry=""; prev_snap="$(bus_snap)"; consider phone "$1" "detail-$1" "$2"; }
    _mk5 OK
    _cyc5 BLIND none
    [ -z "$note" ]                                        || f="$f soft-e2e-doze-noted"
    [ -z "$alert" ]                                       || f="$f soft-e2e-doze-alerted"
    [ -n "$(hold_pending phone:soft)" ]                    || f="$f soft-e2e-doze-not-held"
    [ -z "$(hold_pending phone)" ]                         || f="$f soft-e2e-doze-took-the-hard-key"
    _mk5 BLIND
    _cyc5 OK none
    [ -z "$note" ]                                        || f="$f soft-e2e-wake-noted"
    [ -z "$(hold_pending phone:soft)" ]                    || f="$f soft-e2e-wake-left-pending"
    grep -q "$(printf 'DISCHARGED\tphone:soft')" "$_hl"    || f="$f soft-e2e-no-discharged-row"
    # a second doze that does NOT end: the note must come due, ONCE, with its age
    _mk5 OK
    _cyc5 BLIND none
    [ -z "$note" ]                                        || f="$f soft-e2e-second-doze-noted"
    _mk5 BLIND
    _cyc5 BLIND none                                       # a second unchanged cycle: the count must ADVANCE
    [ -z "$note" ]                                        || f="$f soft-e2e-held-cycle-noted"
    _age_edge "$_hl"                                       # age the edge past the window (by FIELD, not by a clock race)
    _cyc5 BLIND none
    [ -n "$note" ]                                        || f="$f soft-e2e-spent-doze-never-fired"
    case "$note" in *"blind "*"cycle(s)"*) ;; *) f="$f soft-e2e-note-lost-hold-provenance" ;; esac
    # the COUNT itself, not merely the words: two HELD cycles preceded this fire
    case "$note" in *"across 2 cycle(s)"*) ;; *) f="$f soft-e2e-hold-count-not-advanced: $note" ;; esac
    case "$note" in *"doze window"*) ;; *) f="$f soft-e2e-note-lost-its-window" ;; esac
    grep -q "$(printf 'FIRED\tphone:soft')" "$_hl"         || f="$f soft-e2e-no-fired-row"
    # ...and it fires ONCE: the next identical cycle is quiet (the hold is resolved, no edge reopens)
    _cyc5 BLIND none
    [ -z "$note" ]                                        || f="$f soft-e2e-fired-twice"
    # (e) THE SAFETY ARM: a refusal arriving on a pending doze must still ALERT. This is the direction
    # the 179-entry episode at the top of this file went wrong in — collapsing the phone's claims hid a
    # dead lane — so the soft ladder is not allowed to swallow a DOWN.
    : > "$_hl"; : > "$_tb5"; _mk5 OK
    _cyc5 BLIND none
    [ -n "$(hold_pending phone:soft)" ]                    || f="$f soft-safety-precondition"   # else vacuous
    _mk5 BLIND
    _cyc5 DOWN auth
    [ -n "$alert" ]                                       || f="$f soft-swallowed-a-refusal"
    case "$alert" in *"cause=auth"*) ;; *) f="$f soft-refusal-alert-no-cause" ;; esac
    [ -z "$(hold_pending phone:soft)" ]                    || f="$f soft-refusal-left-doze-pending"
    # (f) --dry must not write the doze ledger either
    : > "$_hl"; : > "$_tb5"; _mk5 OK
    _n1=$(wc -l < "$_hl"); alert=""; note=""; changed=0; prev_snap="$(bus_snap)"; dry=1
    consider phone BLIND detail none 2>/dev/null
    [ "$(wc -l < "$_hl")" = "$_n1" ]                      || f="$f soft-dry-wrote-the-ledger"
    dry=""
    # (g) the two axes are reported APART, and the soft window reaches the reader
    : > "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-28T00:10:00Z DISCHARGED ts 2026-08-28T00:00:00Z 1 'hard self-cured' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-28T00:30:00Z FIRED ts 2026-08-28T00:20:00Z 1 'hard spent' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-28T00:40:00Z DISCHARGED phone:soft 2026-08-28T00:35:00Z 3 'doze self-cured' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-28T00:50:00Z DISCHARGED phone:soft 2026-08-28T00:45:00Z 2 'doze self-cured' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-28T00:55:00Z HELD phone:soft 2026-08-28T00:55:00Z 1 'dozing' >> "$_hl"
    _hs2="$(hold_summary)"
    case "$_hs2" in *"1 suppressed / 2 resolved DOWN edges"*) ;; *) f="$f soft-hs-hard-rate-polluted: $_hs2" ;; esac
    case "$_hs2" in *"2 suppressed / 2 resolved doze edges"*) ;; *) f="$f soft-hs-doze-rate-wrong: $_hs2" ;; esac
    case "$_hs2" in *"100%"*) ;; *) f="$f soft-hs-doze-pct-wrong: $_hs2" ;; esac
    case "$_hs2" in *"1 open (phone:soft since 2026-08-28T00:55:00Z)"*) ;; *) f="$f soft-hs-open-doze-unnamed: $_hs2" ;; esac
    case "$_hs2" in *"doze[phone] 1800s(src=env"*) ;; *) f="$f soft-hs-no-doze-window: $_hs2" ;; esac
    # a ledger with NO soft rows must not mint a doze rate out of an empty denominator
    : > "$_hl"; printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-28T00:30:00Z FIRED ts 2026-08-28T00:20:00Z 1 'hard spent' >> "$_hl"
    case "$(hold_summary)" in *"no doze edge resolved yet"*) ;; *) f="$f soft-hs-empty-doze-denominator-minted" ;; esac
    unset MESH_ACCESS_SOFT_HOLD_WINDOW
    rm -f "$_hl" "$_tb5" "$_lh5"
    HOLDLOG="$_ohl"; BOARD="$_obd5"; BUS_WHO="$_obw5"; LINKHEAL_LOG="$_olh5"
    unset -f _cyc5 _mk5 _age_edge

    # ...and the summary must actually REACH the pane. Asserting hold_summary alone leaves the one
    # line that gives it a reader untested — deleting it from render() kept every other leg green
    # ([[testing-the-parts-is-not-testing-the-wiring]]).
    _hl="$(mktemp)"; _tb3="$(mktemp)"; _ohl="$HOLDLOG"; _obd3="$BOARD"; _obw3="$BUS_WHO"
    HOLDLOG="$_hl"; BOARD="$_tb3"; BUS_WHO="access-probe@self"
    printf '2026-08-27T00:00:00Z  %s  ::  [access-state] ts=OK anthropic=OK groq=OK phone=OK\n' "$BUS_WHO" > "$_tb3"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:10:00Z DISCHARGED ts 2026-08-27T00:00:00Z 1 'self-cured' >> "$_hl"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' 2026-08-27T00:30:00Z FIRED ts 2026-08-27T00:20:00Z 1 'spent' >> "$_hl"
    _rend="$(render)"
    case "$_rend" in *"1 suppressed / 2 resolved DOWN edges"*) ;; *) f="$f render-drops-hold-summary" ;; esac
    case "$_rend" in *"ts         OK"*) ;; *) f="$f render-lost-its-states" ;; esac
    rm -f "$_hl" "$_tb3"; HOLDLOG="$_ohl"; BOARD="$_obd3"; BUS_WHO="$_obw3"

    # deps present
    command -v curl >/dev/null 2>&1      || f="$f no-curl"
    command -v tailscale >/dev/null 2>&1 || f="$f no-tailscale"
    command -v mesh-chat >/dev/null 2>&1 || f="$f no-mesh-chat"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (prev_st pure-parse, classify_transition truth table: new-DOWN->ALERT / BLIND-from-OK|blank->NOTE / BLIND-from-DOWN->NONE (sleep phase of a known fault) / restore->NOTE / no-change+OK-from-BLIND->quiet, BLIND never erases an informative DOWN (DOWN->BLIND->DOWN|BLIND drive = ONE alert, ZERO notes), phone-soft never ALERTs, bus reads are KEYED TO THIS NODE'S OWN POSTS on a two-poster union board (a peer flapping DOWN/BLIND beside our steady OK = 0 changes / 0 escalations, a peer's tail marker is not our prev, a peer's DOWN never enters our li and so cannot silence our own first DOWN, a verdict's prose quoting a marker line is not a marker, and the poster is matched as the FIELD so a peer's own marker naming us in its text is not ours), weld_msg seam holds raw+board-flattened, the ALERT sits behind mesh-link-heal's OUTCOME (sensor-declared cause: reach held / auth+other+unknown fired now; hold_decide truth table incl. BLIND-holds-without-advancing and the elapsed clock closing it anyway; ledger read BY POSITION so a FIRED row quoting 'HELD' is still resolved; healer_bound reads BOTH ledger shapes and says na on neither; end-to-end four-cycle episode: first DOWN silent+held, self-cure discharges AND suppresses the restore note, a spent hold fires carrying its provenance, an auth DOWN never holds, a restore after a real fire IS news again, the tape carries FIRED as well as DISCHARGED — including the never-eligible edges, holds=0, so the suppression rate has a real denominator, and --dry writes nothing; hold_summary publishes the rate over the RESOLVED edges, names the still-open one, and refuses to mint a rate from an empty denominator, and REACHES the --render pane); the SOFT (doze) ladder: soft_decide truth table with the two rows that INVERT hold_decide's (a pending BLIND advances the count here, a pending DOWN discharges here so a refusal is never swallowed), doze_bound calibrates p90 off THIS node's own marker runs and says na-with-its-count rather than mint an order statistic from a corpus below MIN_N, a peer's markers are not our corpus, soft_window renders its four sources apart (corpus-p90 / clamped-min / clamped-max / env / default-uncalibrated — and the uncalibrated fallback never wears the corpus word), end-to-end doze episode: a doze is held silent, a wake inside the window discharges it with NO note ever spent, a doze past the window fires ONE note carrying its measured age and advanced cycle count, a refusal on a pending doze still ALERTs with its cause, --dry writes nothing, and hold_summary reports the two axes APART with the doze window and its provenance, refusing an empty doze denominator), deps present)"; exit 0 ;;
  --render) render; exit 0 ;;
  --holds)  echo "$(hold_summary)"; [ -r "$HOLDLOG" ] && { echo; column -t -s "$(printf '\t')" "$HOLDLOG" 2>/dev/null || cat "$HOLDLOG"; }; exit 0 ;;
  --once)   live_once; exit 0 ;;
  --watch)
    interval="${MESH_ACCESS_INTERVAL:-90}"
    while true; do printf '\033[2J\033[H'; echo "=== access senses — LIVE — $(date -u +%FT%TZ) — every ${interval}s ==="; live_once; sleep "$interval"; done ;;
esac

# --- cron cycle: probe, escalate on TRANSITION only, post the marker on change ----------------------
dry=""; [ "${1:-}" = --dry ] && dry=1
probe_all >/dev/null                     # call DIRECTLY (not $(...)) so its globals reach this scope
snapshot="ts=$TS_ST anthropic=$ANT_ST groq=$GRQ_ST phone=$PH_ST"
prev_snap="$(bus_snap)"; first_run=0; [ -z "$(bus_marker)" ] && first_run=1

alert=""; note=""; changed=0
consider ts        "$TS_ST"  "$TS_DT"  "$TS_CZ"
consider anthropic "$ANT_ST" "$ANT_DT" "$ANT_CZ"
consider groq      "$GRQ_ST" "$GRQ_DT" "$GRQ_CZ"
consider phone     "$PH_ST"  "$PH_DT"  "$PH_CZ"

post(){ # <bus-line> <dm-or-empty>
  if [ "$dry" = 1 ]; then printf '[dry] bus: %s\n' "$1" >&2; [ -n "${2:-}" ] && printf '[dry] DM : %s\n' "$2" >&2; return; fi
  mesh-chat "$1" >/dev/null 2>&1 || true
  [ -n "${2:-}" ] && [ "${MESH_ACCESS_DM:-0}" = 1 ] && { mesh-tg "$2" >/dev/null 2>&1 || true; }
}

# First-ever run: seed the baseline marker, NO escalation (a cold start's DOWN senses are not news).
if [ "$first_run" = 1 ]; then
  post "[access-state] $snapshot" ""
  [ "$dry" = 1 ] && echo "first run — baseline seeded, no escalation: $snapshot"
  exit 0
fi

if [ -n "$alert" ]; then
  msg="$(weld_msg "ACCESS-DOWN — the observer's OWN reach is broken (this is OUR sense, not necessarily the world)." "$alert" "$snapshot")"
  post "[alert] $msg" "$msg"
fi
[ -n "$note" ] && post "[note] $(weld_msg "access change:" "$note")" ""
[ "$changed" = 1 ] && post "[access-state] $snapshot" ""

# exit 1 if any hard sense is DOWN (cron-visible), 0 otherwise
case "$snapshot" in *=DOWN*) exit 1 ;; *) exit 0 ;; esac
