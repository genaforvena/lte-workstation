#!/usr/bin/env bash
# mesh-access-probe — PROPRIOCEPTION: does THIS observer still have its senses (reach + creds)?
#
# Our own essay docs/proprioception-from-sys.md said embodiment is an interpretation problem: read a
# reach the mesh already depends on and name what its breakage means. guy-fawxible shipped that idea
# as a reflex (gf-access-probe, operator 2026-07-09 "все доступы должны быть рефлексы ... пусть ты
# просыпаешься если эти сенсоры падают") pointed at prod (YC/VM/PG/CH). This is OUR re-derivation over
# OUR reaches — never their repo/instance.
#
# This is NOT "is the mesh up" (mesh-health owns the fleet table, mesh-egress-health the uplink). This
# owns the OBSERVER'S OWN reach — the creds/paths a mind silently loses and only discovers mid-task:
#   - ts        Tailscale backend Running + Self.Online — the mesh nervous system. If DOWN, the node is
#               blind to the mesh and the mesh to it (CLAUDE.md: "tmux is the only way to see a node").
#   - anthropic api.anthropic.com REACHABLE (not geo-blocked 403) — the minds' egress lifeblood. A
#               silent 403/DNS/route break wedges every mind (cf. memory mind-401 / egress class).
#   - groq      the inference key still authenticates (models list 200, not 401) — a rotated/expired
#               GROQ key breaks mesh-relay silently. n/a (skipped) if no key is configured.
#   - phone     the sense body reachable over SSH+termux. SOFT: a phone is expected-asleep, so
#               unreachable = BLIND (couldn't attempt), NEVER DOWN — it never cries wolf when it sleeps.
#
# The three proprioception disciplines, applied (docs/proprioception-from-sys.md):
#   1. Read what already exists — each probe is the EXISTING auth handshake, adds no instrumentation
#      (a HEAD to the API, `tailscale status`, a battery read). Never reads/logs content.
#   2. Count, never content — reports reach STATE only (OK/DOWN/BLIND). A 401-vs-200 carries no info
#      but "the creds work"; a battery read is a liveness ping, not surveillance.
#   3. Honest absence over a faked calm — three states: OK (tried, works), DOWN (tried, broken — the
#      observer's sense is HURT; wakes the minds), BLIND (couldn't even attempt — a dependency was down;
#      NEVER "all clear"). Explicit cascade: ts DOWN -> phone BLIND (the phone is felt over tailscale).
#
# NO STATE FILE (bus-as-lock, mirrors mesh-claim: a side file is a second source of truth). The durable
# state is ONE `[access-state] ts=.. anthropic=.. ..` marker on the mesh-chat board, posted by the cron
# ONLY on a change (quiet when calm). A DOWN transition posts a board `[alert]` (wakes the minds); set
# MESH_ACCESS_DM=1 to also DM the operator (default off — the operator reads the room, no TG spam).
#
# reflex-cadence: 4-59/10 * * * *
#
#   mesh-access-probe           one cron cycle: probe, escalate on CHANGE, post the marker on change
#   mesh-access-probe --once    probe LIVE now, print the block; no bus/DM/escalation (display)
#   mesh-access-probe --watch   LIVE loop (MESH_ACCESS_INTERVAL, default 90s); display-only
#   mesh-access-probe --render  print last states from the BUS marker (a data-pane one-shot)
#   mesh-access-probe --dry     probe + print what WOULD escalate/post; touch nothing
#   mesh-access-probe --test    hermetic smoke: pure state-parse + transition + cascade logic
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
HOST="$(hostname)"
TIMEOUT="${MESH_ACCESS_TIMEOUT:-10}"
: "${MESH_WHO:=access-probe@$HOST}"; export MESH_WHO
[ -r "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
[ -r "$HOME/.mesh/groq.env" ] && . "$HOME/.mesh/groq.env" 2>/dev/null || true
PHONE_USER="${PHONE_USER:-u0_a380}"
PHONE_TS_IP="${PHONE_TS_IP:-100.103.99.16}"
PHONE_SSH_PORT="${PHONE_SSH_PORT:-8022}"
GROQKEY="${GROQ_API_KEY:-${GROQ_KEY:-}}"

# --- bus-as-lock: prev state derived from the last [access-state] marker (no side file) -------------
bus_marker(){ [ -r "$BOARD" ] && grep -aE '\[access-state\]' "$BOARD" 2>/dev/null | tail -1; }
bus_snap(){   bus_marker | sed -n 's/.*\[access-state\] *//p'; }   # "ts=OK anthropic=OK groq=OK phone=BLIND"
bus_when(){   bus_marker | awk '{print $1}'; }
# prev_st <sense> <snapshot> -> the recorded STATE or "" (pure: snapshot passed in, testable)
prev_st(){ printf '%s' "${2:-}" | grep -oE "$1=[A-Z]+" | head -1 | cut -d= -f2; }

# retry-once: this node's LTE/DNS uplink blips for seconds; one failure is a blip, not DOWN.
try2(){ "$@" >/dev/null 2>&1 && return 0; sleep 2; "$@" >/dev/null 2>&1; }

# --- sensors: each prints "STATE<TAB>detail". Three states only. BLIND is never a hard outage. -------
s_ts() {
  local st
  st="$(timeout "$TIMEOUT" tailscale status --json 2>/dev/null \
       | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); print("OK" if d.get("BackendState")=="Running" and (d.get("Self") or {}).get("Online") else "DOWN")
except Exception: print("DOWN")' 2>/dev/null)"
  [ "$st" = OK ] && printf 'OK\ttailscale Running + Self.Online' || printf 'DOWN\ttailscale not Running/Online (backend down or logged out)'
}
s_anthropic() {
  # reach, not auth: any HTTP response that is NOT a connect-fail(000) and NOT a geo-block(403) = reachable.
  local code
  code="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" https://api.anthropic.com/v1/models 2>/dev/null)"
  case "$code" in
    000|"") sleep 2; code="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" https://api.anthropic.com/v1/models 2>/dev/null)" ;;
  esac
  case "$code" in
    000|"") printf 'DOWN\tapi.anthropic.com unreachable (DNS/route/connect — minds egress cut)' ;;
    403)    printf 'DOWN\tapi.anthropic.com 403 (geo-blocked — minds egress cut)' ;;
    *)      printf 'OK\tapi.anthropic.com reachable (HTTP %s, not 403)' "$code" ;;
  esac
}
s_groq() {
  [ -n "$GROQKEY" ] || { printf 'BLIND\tno GROQ key configured (~/.mesh/groq.env) — sense n/a'; return; }
  local code
  code="$(try2_code https://api.groq.com/openai/v1/models "$GROQKEY")"
  case "$code" in
    200)    printf 'OK\tgroq key authenticates (models 200)' ;;
    401|403) printf 'DOWN\tgroq key rejected (HTTP %s — rotated/expired)' "$code" ;;
    000|"") printf 'DOWN\tgroq unreachable (DNS/route/connect)' ;;
    *)      printf 'DOWN\tgroq unexpected HTTP %s' "$code" ;;
  esac
}
try2_code(){ # <url> <bearer> -> http_code, retry once on connect-fail
  local url="$1" key="$2" c
  c="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -H "Authorization: Bearer $key" "$url" 2>/dev/null)"
  case "$c" in 000|"") sleep 2; c="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -H "Authorization: Bearer $key" "$url" 2>/dev/null)" ;; esac
  printf '%s' "$c"
}
s_phone() {  # SOFT sense: unreachable = BLIND, never DOWN (a phone is expected-asleep)
  local ts_state="$1"
  [ "$ts_state" = OK ] || { printf 'BLIND\ttailscale down — could not attempt phone'; return; }
  if try2 timeout "$TIMEOUT" ssh -p "$PHONE_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
        -o StrictHostKeyChecking=no "$PHONE_USER@$PHONE_TS_IP" 'termux-battery-status'; then
    printf 'OK\tphone ssh+termux responsive'
  else
    printf 'BLIND\tphone unreachable/asleep (expected — not a fault)'
  fi
}

# --- pure transition classifier (testable, no I/O): st vs prev -> "ALERT|NOTE|NONE reason" -----------
# DOWN (from non-DOWN) -> ALERT (wakes minds). BLIND (from non-BLIND) -> NOTE. OK-from-DOWN -> NOTE
# (restored). No change -> NONE. A phone can only be OK/BLIND, so it never ALERTs.
classify_transition(){  # <st> <prev> -> "ALERT"|"NOTE"|"NONE"
  local st="$1" prev="$2"
  [ "$st" = "$prev" ] && { echo NONE; return; }
  case "$st" in
    DOWN)  echo ALERT ;;
    BLIND) echo NOTE ;;
    OK)    [ "$prev" = DOWN ] && echo NOTE || echo NONE ;;   # OK is only newsworthy as a RESTORE
    *)     echo NONE ;;
  esac
}

render() {
  local snap ts now e age k st
  snap="$(bus_snap)"; [ -n "$snap" ] || { echo "  (access senses: no [access-state] marker yet — cron posts on first run/change)"; return; }
  ts="$(bus_when)"; now=$(date +%s); e=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
  age=$(( (now - e) / 60 )); [ "$age" -lt 0 ] && age=0
  echo "  access senses (proprioception — stable since last change ${age}m ago):"
  for k in ts anthropic groq phone; do
    st="$(prev_st "$k" "$snap")"; printf '    %-10s %s\n' "$k" "${st:--}"
  done
}

probe_all() {  # echoes "ts=.. anthropic=.. groq=.. phone=.." to stdout, detail lines to fd 3
  local a b
  a="$(s_ts)";               TS_ST="${a%%$'\t'*}";        TS_DT="${a#*$'\t'}"
  a="$(s_anthropic)";        ANT_ST="${a%%$'\t'*}";       ANT_DT="${a#*$'\t'}"
  a="$(s_groq)";             GRQ_ST="${a%%$'\t'*}";       GRQ_DT="${a#*$'\t'}"
  a="$(s_phone "$TS_ST")";   PH_ST="${a%%$'\t'*}";        PH_DT="${a#*$'\t'}"
  printf 'ts=%s anthropic=%s groq=%s phone=%s\n' "$TS_ST" "$ANT_ST" "$GRQ_ST" "$PH_ST"
}

live_once() {
  probe_all >/dev/null
  echo "  access senses (LIVE — probed $(date -u +%H:%M:%SZ)):"
  printf '  %-10s %-5s %s\n' ts        "$TS_ST"  "$TS_DT"
  printf '  %-10s %-5s %s\n' anthropic "$ANT_ST" "$ANT_DT"
  printf '  %-10s %-5s %s\n' groq      "$GRQ_ST" "$GRQ_DT"
  printf '  %-10s %-5s %s\n' phone     "$PH_ST"  "$PH_DT"
  [ "$TS_ST" = DOWN ] || [ "$ANT_ST" = DOWN ] || [ "$GRQ_ST" = DOWN ] \
    && echo "  ! a sense is DOWN — escalation is the cron's job (transition-only)"
  return 0
}

case "${1:-}" in
  --test)
    f=""
    # prev_st: pure parse from a snapshot string
    snap="ts=OK anthropic=DOWN groq=BLIND phone=OK"
    [ "$(prev_st ts "$snap")" = OK ]         || f="$f prevst-ts"
    [ "$(prev_st anthropic "$snap")" = DOWN ] || f="$f prevst-ant"
    [ "$(prev_st groq "$snap")" = BLIND ]    || f="$f prevst-groq"
    [ -z "$(prev_st missing "$snap")" ]      || f="$f prevst-missing-not-empty"
    # classify_transition: the escalation truth table
    [ "$(classify_transition DOWN OK)" = ALERT ]    || f="$f ct-down-alert"
    [ "$(classify_transition DOWN DOWN)" = NONE ]   || f="$f ct-down-nochange"
    [ "$(classify_transition DOWN '')" = ALERT ]    || f="$f ct-down-fromblank"   # first-run DOWN alerts unless first-run gate suppresses (see run body)
    [ "$(classify_transition BLIND OK)" = NOTE ]    || f="$f ct-blind-note"
    [ "$(classify_transition OK DOWN)" = NOTE ]     || f="$f ct-restore-note"
    [ "$(classify_transition OK BLIND)" = NONE ]    || f="$f ct-ok-fromblind-quiet"
    [ "$(classify_transition OK OK)" = NONE ]       || f="$f ct-ok-nochange"
    # phone can only be OK/BLIND -> it must NEVER produce an ALERT
    [ "$(classify_transition BLIND OK)" != ALERT ]  || f="$f phone-blind-alerted"
    # deps present
    command -v curl >/dev/null 2>&1      || f="$f no-curl"
    command -v tailscale >/dev/null 2>&1 || f="$f no-tailscale"
    command -v mesh-chat >/dev/null 2>&1 || f="$f no-mesh-chat"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (prev_st pure-parse, classify_transition truth table: DOWN->ALERT / BLIND->NOTE / restore->NOTE / no-change+OK-from-BLIND->quiet, phone-soft never ALERTs, deps present)"; exit 0 ;;
  --render) render; exit 0 ;;
  --once)   live_once; exit 0 ;;
  --watch)
    interval="${MESH_ACCESS_INTERVAL:-90}"
    while true; do printf '\033[2J\033[H'; echo "=== access senses — LIVE — $(date -u +%FT%TZ) — every ${interval}s ==="; live_once; sleep "$interval"; done ;;
esac

# --- cron cycle: probe, escalate on TRANSITION only, post the marker on change ----------------------
dry=""; [ "${1:-}" = --dry ] && dry=1
probe_all >/dev/null                     # call DIRECTLY (not $(...)) so its globals reach this scope
snapshot="ts=$TS_ST anthropic=$ANT_ST groq=$GRQ_ST phone=$PH_ST"
prev_snap="$(bus_snap)"; first_run=0; [ -z "$(bus_marker)" ] && first_run=1

alert=""; note=""; changed=0
consider(){  # <sense> <st> <detail>
  local k="$1" st="$2" det="$3" prev v
  prev="$(prev_st "$k" "$prev_snap")"
  [ "$st" = "$prev" ] || changed=1
  v="$(classify_transition "$st" "$prev")"
  case "$v" in
    ALERT) alert="${alert}  $k: DOWN — $det\n" ;;
    NOTE)  note="${note}  $k: $st — $det\n" ;;
  esac
}
consider ts        "$TS_ST"  "$TS_DT"
consider anthropic "$ANT_ST" "$ANT_DT"
consider groq      "$GRQ_ST" "$GRQ_DT"
consider phone     "$PH_ST"  "$PH_DT"

post(){ # <bus-line> <dm-or-empty>
  if [ "$dry" = 1 ]; then printf '[dry] bus: %s\n' "$1" >&2; [ -n "${2:-}" ] && printf '[dry] DM : %s\n' "$2" >&2; return; fi
  mesh-chat "$1" >/dev/null 2>&1 || true
  [ -n "${2:-}" ] && [ "${MESH_ACCESS_DM:-0}" = 1 ] && { mesh-tg "$2" >/dev/null 2>&1 || true; }
}

# First-ever run: seed the baseline marker, NO escalation (a cold start's DOWN senses are not news).
if [ "$first_run" = 1 ]; then
  post "[access-state] $snapshot" ""
  [ "$dry" = 1 ] && echo "first run — baseline seeded, no escalation: $snapshot"
  exit 0
fi

if [ -n "$alert" ]; then
  msg="ACCESS-DOWN — the observer's OWN reach is broken (this is OUR sense, not necessarily the world).$(printf '\n'; printf '%b' "$alert")states: $snapshot"
  post "[alert] $msg" "$msg"
fi
[ -n "$note" ] && post "[note] access change:$(printf '\n'; printf '%b' "$note")states: $snapshot" ""
[ "$changed" = 1 ] && post "[access-state] $snapshot" ""

# exit 1 if any hard sense is DOWN (cron-visible), 0 otherwise
case "$snapshot" in *=DOWN*) exit 1 ;; *) exit 0 ;; esac
