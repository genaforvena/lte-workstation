#!/usr/bin/env bash
# mesh-access-probe — PROPRIOCEPTION: does THIS observer still have its senses (reach + creds)?
#
# Our own essay docs/proprioception-from-sys.md said embodiment is an interpretation problem: read a
# reach the mesh already depends on and name what its breakage means. guy-fawxible shipped that idea
# as a reflex (gf-access-probe, operator 2026-07-09 "все доступы должны быть рефлексы ... пусть ты
# просыпаешься если эти сенсоры падают") pointed at prod (YC/VM/PG/CH). This is OUR re-derivation over
# OUR reaches — never their repo/instance.
#
# This is NOT "is the mesh up" (mesh-health owns the fleet table, mesh-egress-health the uplink). This
# owns the OBSERVER'S OWN reach — the creds/paths a mind silently loses and only discovers mid-task:
#   - ts        Tailscale backend Running + Self.Online — the mesh nervous system. If DOWN, the node is
#               blind to the mesh and the mesh to it (CLAUDE.md: "tmux is the only way to see a node").
#   - anthropic api.anthropic.com REACHABLE (not geo-blocked 403) — the minds' egress lifeblood. A
#               silent 403/DNS/route break wedges every mind (cf. memory mind-401 / egress class).
#   - groq      the inference key still authenticates (models list 200, not 401) — a rotated/expired
#               GROQ key breaks mesh-relay silently. n/a (skipped) if no key is configured.
#   - phone     the sense body reachable over SSH+termux. SOFT about SLEEP, hard about REFUSAL: nothing
#               answering = BLIND (couldn't attempt — a phone is expected-asleep, it never cries wolf
#               when it sleeps), but an sshd that ANSWERS and refuses our creds = DOWN. Those are two
#               claims and collapsing them is what hid a dead phone lane here for days (see s_phone).
#
# The three proprioception disciplines, applied (docs/proprioception-from-sys.md):
#   1. Read what already exists — each probe is the EXISTING auth handshake, adds no instrumentation
#      (a HEAD to the API, `tailscale status`, a battery read). Never reads/logs content.
#   2. Count, never content — reports reach STATE only (OK/DOWN/BLIND). A 401-vs-200 carries no info
#      but "the creds work"; a battery read is a liveness ping, not surveillance.
#   3. Honest absence over a faked calm — three states: OK (tried, works), DOWN (tried, broken — the
#      observer's sense is HURT; wakes the minds), BLIND (couldn't even attempt — a dependency was down;
#      NEVER "all clear"). Explicit cascade: ts DOWN -> phone BLIND (the phone is felt over tailscale).
#
# NO STATE FILE (bus-as-lock, mirrors mesh-claim: a side file is a second source of truth). The durable
# state is ONE `[access-state] ts=.. anthropic=.. ..` marker on the mesh-chat board, posted by the cron
# ONLY on a change (quiet when calm). A DOWN transition posts a board `[alert]` (wakes the minds); set
# MESH_ACCESS_DM=1 to also DM the operator (default off — the operator reads the room, no TG spam).
#
# reflex-cadence: 4-59/10 * * * *
#
#   mesh-access-probe           one cron cycle: probe, escalate on CHANGE, post the marker on change
#   mesh-access-probe --once    probe LIVE now, print the block; no bus/DM/escalation (display)
#   mesh-access-probe --watch   LIVE loop (MESH_ACCESS_INTERVAL, default 90s); display-only
#   mesh-access-probe --render  print last states from the BUS marker (a data-pane one-shot)
#   mesh-access-probe --dry     probe + print what WOULD escalate/post; touch nothing
#   mesh-access-probe --test    hermetic smoke: pure state-parse + transition + cascade logic
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
HOST="$(hostname)"
TIMEOUT="${MESH_ACCESS_TIMEOUT:-10}"
: "${MESH_WHO:=access-probe@$HOST}"; export MESH_WHO
[ -r "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
[ -r "$HOME/.mesh/groq.env" ] && . "$HOME/.mesh/groq.env" 2>/dev/null || true
PHONE_USER="${PHONE_USER:-u0_a380}"
PHONE_TS_IP="${PHONE_TS_IP:-100.103.99.16}"
PHONE_SSH_PORT="${PHONE_SSH_PORT:-8022}"
GROQKEY="${GROQ_API_KEY:-${GROQ_KEY:-}}"

# --- bus-as-lock: prev state derived from the last [access-state] marker (no side file) -------------
bus_marker(){ [ -r "$BOARD" ] && grep -aE '\[access-state\]' "$BOARD" 2>/dev/null | tail -1; }
bus_snap(){   bus_marker | sed -n 's/.*\[access-state\] *//p'; }   # "ts=OK anthropic=OK groq=OK phone=BLIND"
bus_when(){   bus_marker | awk '{print $1}'; }
# prev_st <sense> <snapshot> -> the recorded STATE or "" (pure: snapshot passed in, testable)
prev_st(){ printf '%s' "${2:-}" | grep -oE "$1=[A-Z]+" | head -1 | cut -d= -f2; }
# bus_last_informative <sense> -> the last NON-BLIND state recorded for the axis, or "".
# BLIND is "couldn't attempt" — it carries no information about the sense, so it must not erase a
# recorded DOWN from the escalation ladder's memory (it stays the marker/display truth). Read from
# the same board markers (bus-as-lock, no side file); "" = no informative history (fail-loud: a
# DOWN with no informative past is news).
bus_last_informative(){
  [ -r "$BOARD" ] || return 0
  grep -aE '\[access-state\]' "$BOARD" 2>/dev/null | grep -oE "$1=[A-Z]+" | cut -d= -f2 \
    | grep -v '^BLIND$' | tail -1
}

# retry-once: this node's LTE/DNS uplink blips for seconds; one failure is a blip, not DOWN.
try2(){ "$@" >/dev/null 2>&1 && return 0; sleep 2; "$@" >/dev/null 2>&1; }

# --- sensors: each prints "STATE<TAB>detail". Three states only. BLIND is never a hard outage. -------
s_ts() {
  local st
  st="$(timeout "$TIMEOUT" tailscale status --json 2>/dev/null \
       | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); print("OK" if d.get("BackendState")=="Running" and (d.get("Self") or {}).get("Online") else "DOWN")
except Exception: print("DOWN")' 2>/dev/null)"
  [ "$st" = OK ] && printf 'OK\ttailscale Running + Self.Online' || printf 'DOWN\ttailscale not Running/Online (backend down or logged out)'
}
s_anthropic() {
  # reach, not auth: any HTTP response that is NOT a connect-fail(000) and NOT a geo-block(403) = reachable.
  local code
  code="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" https://api.anthropic.com/v1/models 2>/dev/null)"
  case "$code" in
    000|"") sleep 2; code="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" https://api.anthropic.com/v1/models 2>/dev/null)" ;;
  esac
  case "$code" in
    000|"") printf 'DOWN\tapi.anthropic.com unreachable (DNS/route/connect — minds egress cut)' ;;
    403)    printf 'DOWN\tapi.anthropic.com 403 (geo-blocked — minds egress cut)' ;;
    *)      printf 'OK\tapi.anthropic.com reachable (HTTP %s, not 403)' "$code" ;;
  esac
}
s_groq() {
  [ -n "$GROQKEY" ] || { printf 'BLIND\tno GROQ key configured (~/.mesh/groq.env) — sense n/a'; return; }
  local code
  code="$(try2_code https://api.groq.com/openai/v1/models "$GROQKEY")"
  case "$code" in
    200)    printf 'OK\tgroq key authenticates (models 200)' ;;
    401|403) printf 'DOWN\tgroq key rejected (HTTP %s — rotated/expired)' "$code" ;;
    000|"") printf 'DOWN\tgroq unreachable (DNS/route/connect)' ;;
    *)      printf 'DOWN\tgroq unexpected HTTP %s' "$code" ;;
  esac
}
try2_code(){ # <url> <bearer> -> http_code, retry once on connect-fail
  local url="$1" key="$2" c
  c="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -H "Authorization: Bearer $key" "$url" 2>/dev/null)"
  case "$c" in 000|"") sleep 2; c="$(timeout "$TIMEOUT" curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -H "Authorization: Bearer $key" "$url" 2>/dev/null)" ;; esac
  printf '%s' "$c"
}
# --- pure: what ONE ssh attempt's outcome MEANS (testable, no I/O) ----------------------------------
# "asleep" and "refusing us" are DIFFERENT CLAIMS and the old code collapsed them: any non-zero ssh
# was reported 'phone unreachable/asleep (expected — not a fault)', so a phone that is AWAKE with a
# live sshd that REFUSES OUR CREDENTIALS read as a soft, expected BLIND — forever, and this tool's
# entire remit is the creds a mind silently loses. Live proof on mesh-home 2026-07-16: 74/74 board
# posts said phone=BLIND, and ~/.mesh/phone-collect.log held ONE distinct line — '[phone-unreachable]
# no ADB, LAN or WG path' — for all 179 entries since the 07-14 migration, i.e. the phone body has
# never once been read here. The phone was awake the whole time (192.168.8.203, sshd answering, host
# key identical to the .146 known_hosts entry = same device); mesh-home simply has NO ssh private key
# (~/.ssh holds only authorized_keys/config/known_hosts, every `identity file ... type -1`). Peers
# hid it: phaedra authenticates via TAILSCALE SSH (method "none", no key), so `ssh phaedra` works and
# only the phone's real OpenSSH on 8022 ever needed the key we don't have.
# rc=0                        -> OK    (we ran a command: reach AND creds intact)
# sshd answered, refused us   -> DOWN  (the phone is awake and REFUSING US — our own sense is HURT)
# nothing answered at all     -> BLIND (nothing to attempt — expected-asleep, never a fault)
classify_ssh_outcome(){  # <rc> <stderr-text> -> OK|DOWN|BLIND
  local rc="$1" err="$2"
  [ "$rc" = 0 ] && { echo OK; return; }
  case "$err" in
    *"Permission denied"*|*"Too many authentication failures"*|*"Authentication failed"*|\
    *"Host key verification failed"*|*"no matching host key"*|*"no mutual signature"*|\
    *"REMOTE HOST IDENTIFICATION HAS CHANGED"*) echo DOWN ;;
    *) echo BLIND ;;
  esac
}
# phone_candidates — the addresses this node may feel the body at. NOT ${PHONE_TS_IP} alone: the old
# code dialled only the tailnet, so a phone that fell off the tailnet but sits on the LAN (exactly
# this node's case — PHONE_LAN_IPS is configured in ~/.mesh/nodes and every other phone tool honours
# it) was unreachable by construction. The ts cascade still holds where it is TRUE: with no LAN
# candidates configured, a down tailnet means we genuinely cannot attempt.
phone_candidates(){  # <ts_state> -> addresses, one per line (empty = cannot attempt)
  local ts_state="$1" ip
  [ "$ts_state" = OK ] && [ -n "${PHONE_TS_IP:-}" ] && printf '%s\n' "$PHONE_TS_IP"
  for ip in ${PHONE_LAN_IPS:-}; do [ -n "$ip" ] && printf '%s\n' "$ip"; done
}
# phone_verdict — fold per-candidate outcomes into one state. OK wins (any path that WORKS proves the
# sense); else a REFUSAL anywhere outranks silence (an awake body refusing us is news, an absent one
# is not); else BLIND.
phone_verdict(){  # <outcome>... -> OK|DOWN|BLIND
  local o seen_down=""
  for o in "$@"; do
    [ "$o" = OK ] && { echo OK; return; }
    [ "$o" = DOWN ] && seen_down=1
  done
  [ -n "$seen_down" ] && echo DOWN || echo BLIND
}
s_phone() {  # reach+creds to the sense body. BLIND=asleep (soft). DOWN=awake but refusing us (a fault).
  local ts_state="$1" ip err rc outcomes=() at_down="" cands
  cands="$(phone_candidates "$ts_state")"
  [ -n "$cands" ] || { printf 'BLIND\tno phone address to try (tailscale down, no PHONE_LAN_IPS) — could not attempt'; return; }
  while read -r ip; do
    [ -n "$ip" ] || continue
    err="$(timeout "$TIMEOUT" ssh -p "$PHONE_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
             -o StrictHostKeyChecking=no "$PHONE_USER@$ip" 'termux-battery-status' 2>&1 >/dev/null)"; rc=$?
    case "$(classify_ssh_outcome "$rc" "$err")" in
      OK)    printf 'OK\tphone ssh+termux responsive at %s' "$ip"; return ;;
      DOWN)  outcomes+=(DOWN); [ -n "$at_down" ] || at_down="$ip" ;;
      *)     outcomes+=(BLIND) ;;
    esac
  done <<< "$cands"
  if [ "$(phone_verdict "${outcomes[@]}")" = DOWN ]; then
    printf 'DOWN\tphone AWAKE at %s but sshd refuses us — our reach/creds to the body are broken, not asleep' "$at_down"
  else
    printf 'BLIND\tphone unreachable/asleep (expected — not a fault)'
  fi
}

# --- pure transition classifier (testable, no I/O): st vs prev -> "ALERT|NOTE|NONE reason" -----------
# DOWN (newly) -> ALERT (wakes minds). BLIND (from non-BLIND) -> NOTE. OK-from-DOWN -> NOTE
# (restored). No change -> NONE. The phone is soft only about SLEEP: it stays quiet (BLIND->NOTE) when
# nothing answers, but a refusal makes it DOWN like any other sense, and DOWN wakes the minds.
# "Newly" is judged against the last INFORMATIVE state (3rd arg), not the raw marker: BLIND carries
# no information, and when it overwrote a recorded DOWN the next DOWN re-ALERTed the same chronic
# fault every sleep/wake cycle (live 2026-07-17: phone DOWN 16:24 -> BLIND 16:34 -> DOWN 16:44
# re-alert, 8 alarms in a day for the one known no-key-on-redmi state). A DOWN whose last
# informative state was DOWN is a re-manifestation, not news; same for a restore seen through a
# BLIND gap (OK-from-BLIND with an informative DOWN behind it IS a restore -> NOTE).
classify_transition(){  # <st> <prev> [<last-informative>] -> "ALERT"|"NOTE"|"NONE"
  local st="$1" prev="$2" li="${3:-$2}"
  [ "$st" = "$prev" ] && { echo NONE; return; }
  case "$st" in
    DOWN)  [ "$li" = DOWN ] && echo NONE || echo ALERT ;;   # chronic re-manifestation is not news
    BLIND) echo NOTE ;;
    OK)    [ "$li" = DOWN ] && echo NOTE || echo NONE ;;    # OK is only newsworthy as a RESTORE
    *)     echo NONE ;;
  esac
}

# The escalation line a mind reads MID-OUTAGE — so its seams are load-bearing, not cosmetic.
# Join header/body/states with EXPLICIT newlines. The body arrives carrying "\n" escapes and its own
# trailing one; strip that here ONCE (deterministically) and re-add each seam, because the obvious
# spelling cannot work: $(printf '%b' "$body") deletes trailing newlines, so the old
# "...$(printf '\n'; printf '%b' "$alert")states: $snap" welded the last detail onto the label —
# "curl exit 7states: ts=DOWN". The DM (mesh-tg) renders the newlines; the board copy gets them
# flattened to spaces by mesh-chat's tr, which is why a REAL separator has to be there to flatten.
NL="$(printf '\nx')"; NL="${NL%x}"
weld_msg(){  # <header> <body-with-\n-escapes> <snapshot> -> multi-line message
  local hdr="$1" body="$2" snap="$3"
  body="$(printf '%b' "$body")"
  printf '%s%s%s%sstates: %s' "$hdr" "$NL" "$body" "$NL" "$snap"
}

render() {
  local snap ts now e age k st
  snap="$(bus_snap)"; [ -n "$snap" ] || { echo "  (access senses: no [access-state] marker yet — cron posts on first run/change)"; return; }
  ts="$(bus_when)"; now=$(date +%s); e=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
  age=$(( (now - e) / 60 )); [ "$age" -lt 0 ] && age=0
  echo "  access senses (proprioception — stable since last change ${age}m ago):"
  for k in ts anthropic groq phone; do
    st="$(prev_st "$k" "$snap")"; printf '    %-10s %s\n' "$k" "${st:--}"
  done
}

probe_all() {  # echoes "ts=.. anthropic=.. groq=.. phone=.." to stdout, detail lines to fd 3
  local a b
  a="$(s_ts)";               TS_ST="${a%%$'\t'*}";        TS_DT="${a#*$'\t'}"
  a="$(s_anthropic)";        ANT_ST="${a%%$'\t'*}";       ANT_DT="${a#*$'\t'}"
  a="$(s_groq)";             GRQ_ST="${a%%$'\t'*}";       GRQ_DT="${a#*$'\t'}"
  a="$(s_phone "$TS_ST")";   PH_ST="${a%%$'\t'*}";        PH_DT="${a#*$'\t'}"
  printf 'ts=%s anthropic=%s groq=%s phone=%s\n' "$TS_ST" "$ANT_ST" "$GRQ_ST" "$PH_ST"
}

live_once() {
  probe_all >/dev/null
  echo "  access senses (LIVE — probed $(date -u +%H:%M:%SZ)):"
  printf '  %-10s %-5s %s\n' ts        "$TS_ST"  "$TS_DT"
  printf '  %-10s %-5s %s\n' anthropic "$ANT_ST" "$ANT_DT"
  printf '  %-10s %-5s %s\n' groq      "$GRQ_ST" "$GRQ_DT"
  printf '  %-10s %-5s %s\n' phone     "$PH_ST"  "$PH_DT"
  [ "$TS_ST" = DOWN ] || [ "$ANT_ST" = DOWN ] || [ "$GRQ_ST" = DOWN ] \
    && echo "  ! a sense is DOWN — escalation is the cron's job (transition-only)"
  return 0
}

case "${1:-}" in
  --test)
    f=""
    # prev_st: pure parse from a snapshot string
    snap="ts=OK anthropic=DOWN groq=BLIND phone=OK"
    [ "$(prev_st ts "$snap")" = OK ]         || f="$f prevst-ts"
    [ "$(prev_st anthropic "$snap")" = DOWN ] || f="$f prevst-ant"
    [ "$(prev_st groq "$snap")" = BLIND ]    || f="$f prevst-groq"
    [ -z "$(prev_st missing "$snap")" ]      || f="$f prevst-missing-not-empty"
    # classify_transition: the escalation truth table
    [ "$(classify_transition DOWN OK)" = ALERT ]    || f="$f ct-down-alert"
    [ "$(classify_transition DOWN DOWN)" = NONE ]   || f="$f ct-down-nochange"
    [ "$(classify_transition DOWN '')" = ALERT ]    || f="$f ct-down-fromblank"   # first-run DOWN alerts unless first-run gate suppresses (see run body)
    [ "$(classify_transition BLIND OK)" = NOTE ]    || f="$f ct-blind-note"
    [ "$(classify_transition OK DOWN)" = NOTE ]     || f="$f ct-restore-note"
    [ "$(classify_transition OK BLIND)" = NONE ]    || f="$f ct-ok-fromblind-quiet"
    [ "$(classify_transition OK OK)" = NONE ]       || f="$f ct-ok-nochange"
    # chronic-DOWN re-arm (2026-07-17): BLIND carries no information, but it overwrote the recorded
    # DOWN in the marker, so the next DOWN read as news and re-ALERTed the same known fault every
    # sleep/wake cycle (8+ phone alarms in a day for the one no-key-on-redmi state). The ALERT
    # decision takes a third arg — the last INFORMATIVE (non-BLIND) recorded state — and a DOWN
    # whose last informative state was already DOWN is a re-manifestation, not news.
    [ "$(classify_transition DOWN BLIND DOWN)" = NONE ]  || f="$f ct-reblind-rearmed"
    [ "$(classify_transition DOWN BLIND OK)" = ALERT ]   || f="$f ct-down-after-restore-quiet"
    [ "$(classify_transition OK BLIND DOWN)" = NOTE ]    || f="$f ct-restore-thru-blind-quiet"
    # a SLEEPING phone must never cry wolf: BLIND is the quiet state, whatever it came from
    [ "$(classify_transition BLIND OK)" != ALERT ]  || f="$f phone-blind-alerted"
    # classify_ssh_outcome: "asleep" vs "refusing us" are different claims (the bug this tool shipped:
    # every non-zero ssh read as expected-asleep, so a live sshd rejecting our creds was never a fault)
    [ "$(classify_ssh_outcome 0 '')" = OK ]                                              || f="$f ssho-rc0-not-ok"
    [ "$(classify_ssh_outcome 255 'u0_a380@1.2.3.4: Permission denied (publickey).')" = DOWN ] || f="$f ssho-refused-not-down"
    [ "$(classify_ssh_outcome 255 'Received disconnect: Too many authentication failures')" = DOWN ] || f="$f ssho-toomany-not-down"
    [ "$(classify_ssh_outcome 255 'Host key verification failed.')" = DOWN ]             || f="$f ssho-hostkey-not-down"
    [ "$(classify_ssh_outcome 255 'ssh: connect to host 1.2.3.4 port 8022: Connection timed out')" = BLIND ] || f="$f ssho-timeout-not-blind"
    [ "$(classify_ssh_outcome 255 'ssh: connect to host 1.2.3.4 port 8022: No route to host')" = BLIND ]     || f="$f ssho-noroute-not-blind"
    [ "$(classify_ssh_outcome 124 '')" = BLIND ]                                         || f="$f ssho-timeoutkill-not-blind"
    # the two must not be the same answer — the whole point of the split
    [ "$(classify_ssh_outcome 255 'Permission denied (publickey).')" \
      != "$(classify_ssh_outcome 255 'Connection timed out')" ]                          || f="$f ssho-refused-eq-asleep"
    # and a REFUSAL must reach an ALERT end-to-end (DOWN is only news if the ladder carries it)
    [ "$(classify_transition "$(classify_ssh_outcome 255 'Permission denied (publickey).')" BLIND)" = ALERT ] || f="$f ssho-refusal-no-alert"
    # phone_verdict: OK wins; a refusal on ANY path outranks silence on the others; else BLIND
    [ "$(phone_verdict BLIND OK)" = OK ]        || f="$f pv-ok-loses"
    [ "$(phone_verdict BLIND DOWN)" = DOWN ]    || f="$f pv-down-loses-to-blind"
    [ "$(phone_verdict DOWN OK)" = OK ]         || f="$f pv-ok-loses-to-down"
    [ "$(phone_verdict BLIND BLIND)" = BLIND ]  || f="$f pv-blind"
    # phone_candidates: the LAN is a real path — dialling only the tailnet is how an awake body
    # (off-tailnet, on-LAN — this node's live case) became unreachable BY CONSTRUCTION
    _c="$(PHONE_TS_IP=100.0.0.1 PHONE_LAN_IPS='192.168.9.9 192.168.9.10' phone_candidates OK)"
    [ "$(printf '%s' "$_c" | grep -c .)" = 3 ]  || f="$f pc-not-3"
    case "$_c" in *192.168.9.10*) ;; *) f="$f pc-drops-lan" ;; esac
    # ts DOWN does not blind us to a body on the LAN...
    _c="$(PHONE_TS_IP=100.0.0.1 PHONE_LAN_IPS='192.168.9.9' phone_candidates DOWN)"
    [ "$_c" = 192.168.9.9 ]                     || f="$f pc-ts-down-drops-lan"
    # ...but with no LAN configured, ts DOWN really is "cannot attempt" — the cascade where it's TRUE
    [ -z "$(PHONE_TS_IP=100.0.0.1 PHONE_LAN_IPS='' phone_candidates DOWN)" ] || f="$f pc-ts-down-no-lan-not-empty"
    # bus_last_informative + the live treadmill, driven end-to-end against a sandboxed board:
    # OK -> DOWN -> BLIND -> DOWN must raise exactly ONE ALERT, while the marker (display truth)
    # still records the BLIND. All fixture writes go to a scratch board, never the real one.
    _tb="$(mktemp)"; _ob="$BOARD"; BOARD="$_tb"; _alerts=0
    _mark(){ printf '2026-07-17T00:00:00Z test :: [access-state] ts=OK anthropic=OK groq=OK phone=%s\n' "$1" >> "$_tb"; }
    _mark OK
    for _st in DOWN BLIND DOWN; do
      _p="$(prev_st phone "$(bus_snap)")"; _li="$(bus_last_informative phone)"
      [ "$_st" = BLIND ] && { [ "$_p" = DOWN ] || f="$f drive-prev-lost"; }
      [ "$(classify_transition "$_st" "$_p" "$_li")" = ALERT ] && _alerts=$((_alerts+1))
      _mark "$_st"
    done
    [ "$_alerts" = 1 ] || f="$f drive-alerts-$_alerts-not-1"
    # mid-treadmill the marker really did say BLIND (display truth intact) and li still said DOWN
    printf '%s\n' "$(head -3 "$_tb")" > "$_tb"   # rewind to after the BLIND marker
    [ "$(prev_st phone "$(bus_snap)")" = BLIND ]     || f="$f drive-display-not-blind"
    [ "$(bus_last_informative phone)" = DOWN ]       || f="$f li-not-down-thru-blind"
    # all-BLIND history -> li empty -> a DOWN still ALERTs (fail-loud: no informative past = news)
    printf '2026-07-17T00:00:00Z test :: [access-state] ts=OK anthropic=OK groq=OK phone=BLIND\n' > "$_tb"
    [ -z "$(bus_last_informative phone)" ]           || f="$f li-allblind-not-empty"
    [ "$(classify_transition DOWN BLIND "$(bus_last_informative phone)")" = ALERT ] || f="$f li-empty-down-no-alert"
    rm -f "$_tb"; BOARD="$_ob"
    # weld_msg: the seam before 'states:' — the line a mind reads mid-outage, in BOTH consumers.
    _a="  ts: DOWN — tailscaled not running\n  anthropic: DOWN — curl exit 7\n"
    _snap="ts=DOWN anthropic=DOWN groq=OK phone=OK"
    _m="$(weld_msg "ACCESS-DOWN — reach broken." "$_a" "$_snap")"
    # (a) DM/raw: 'states:' must start its own line, never glued to a detail ('exit 7states:')
    case "$_m" in *"${NL}states: ts=DOWN"*) ;; *) f="$f weld-states-not-line-start" ;; esac
    printf '%s' "$_m" | grep -qE '[^[:space:]]states:'  && f="$f weld-states-glued"
    [ "$(printf '%s' "$_m" | wc -l)" = 3 ]              || f="$f weld-not-multiline"   # DM keeps its lines
    # (b) board: flattened through mesh-chat's own tr, the seam must survive as ' states: '
    _flat="$(printf '%s' "$_m" | tr '\n\t' '  ' | tr -s ' ')"
    case "$_flat" in *" states: ts=DOWN"*) ;; *) f="$f weld-flat-seam" ;; esac
    case "$_flat" in *"7states:"*) f="$f weld-flat-glued" ;; esac
    # deps present
    command -v curl >/dev/null 2>&1      || f="$f no-curl"
    command -v tailscale >/dev/null 2>&1 || f="$f no-tailscale"
    command -v mesh-chat >/dev/null 2>&1 || f="$f no-mesh-chat"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (prev_st pure-parse, classify_transition truth table: new-DOWN->ALERT / BLIND->NOTE / restore->NOTE / no-change+OK-from-BLIND->quiet, BLIND never erases an informative DOWN (DOWN->BLIND->DOWN drive = ONE alert), phone-soft never ALERTs, weld_msg seam holds raw+board-flattened, deps present)"; exit 0 ;;
  --render) render; exit 0 ;;
  --once)   live_once; exit 0 ;;
  --watch)
    interval="${MESH_ACCESS_INTERVAL:-90}"
    while true; do printf '\033[2J\033[H'; echo "=== access senses — LIVE — $(date -u +%FT%TZ) — every ${interval}s ==="; live_once; sleep "$interval"; done ;;
esac

# --- cron cycle: probe, escalate on TRANSITION only, post the marker on change ----------------------
dry=""; [ "${1:-}" = --dry ] && dry=1
probe_all >/dev/null                     # call DIRECTLY (not $(...)) so its globals reach this scope
snapshot="ts=$TS_ST anthropic=$ANT_ST groq=$GRQ_ST phone=$PH_ST"
prev_snap="$(bus_snap)"; first_run=0; [ -z "$(bus_marker)" ] && first_run=1

alert=""; note=""; changed=0
consider(){  # <sense> <st> <detail>
  local k="$1" st="$2" det="$3" prev li v
  prev="$(prev_st "$k" "$prev_snap")"
  li="$(bus_last_informative "$k")"
  [ "$st" = "$prev" ] || changed=1
  v="$(classify_transition "$st" "$prev" "$li")"
  case "$v" in
    ALERT) alert="${alert}  $k: DOWN — $det\n" ;;
    NOTE)  note="${note}  $k: $st — $det\n" ;;
  esac
}
consider ts        "$TS_ST"  "$TS_DT"
consider anthropic "$ANT_ST" "$ANT_DT"
consider groq      "$GRQ_ST" "$GRQ_DT"
consider phone     "$PH_ST"  "$PH_DT"

post(){ # <bus-line> <dm-or-empty>
  if [ "$dry" = 1 ]; then printf '[dry] bus: %s\n' "$1" >&2; [ -n "${2:-}" ] && printf '[dry] DM : %s\n' "$2" >&2; return; fi
  mesh-chat "$1" >/dev/null 2>&1 || true
  [ -n "${2:-}" ] && [ "${MESH_ACCESS_DM:-0}" = 1 ] && { mesh-tg "$2" >/dev/null 2>&1 || true; }
}

# First-ever run: seed the baseline marker, NO escalation (a cold start's DOWN senses are not news).
if [ "$first_run" = 1 ]; then
  post "[access-state] $snapshot" ""
  [ "$dry" = 1 ] && echo "first run — baseline seeded, no escalation: $snapshot"
  exit 0
fi

if [ -n "$alert" ]; then
  msg="$(weld_msg "ACCESS-DOWN — the observer's OWN reach is broken (this is OUR sense, not necessarily the world)." "$alert" "$snapshot")"
  post "[alert] $msg" "$msg"
fi
[ -n "$note" ] && post "[note] $(weld_msg "access change:" "$note" "$snapshot")" ""
[ "$changed" = 1 ] && post "[access-state] $snapshot" ""

# exit 1 if any hard sense is DOWN (cron-visible), 0 otherwise
case "$snapshot" in *=DOWN*) exit 1 ;; *) exit 0 ;; esac
