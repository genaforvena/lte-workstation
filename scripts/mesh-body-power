#!/usr/bin/env bash
# reflex-cadence: 5-59/10 * * * *
# doctor-artifact: $HOME/.mesh/.body-power-state 2400 phone
#   ^ smoke-theater gate (mesh-doctor): .body-power-state is rewritten on EVERY successful read (LOW or
#     OK branch), so phone-reachable + state >2400s stale ⟹ the sense is silently not producing despite
#     a green --test. Phone offline → gate skips (no false-fail). See mesh-doctor _theater_check.
# mesh-body-power — watch the phone BODY's battery so it doesn't silently DIE and take the mesh's
# physical senses+actuators offline. The body is expensive to restore (operator must physically revive
# Termux/sshd on the phone), so a low battery during an absence = days of lost capability. Edge-triggered
# (trustworthy-signal: alarm LOW+discharging, recover on charge); reads battery only — non-intrusive.
#
#   mesh-body-power          one check; edge-trigger [body-power-low]/[body-power-ok]
#   mesh-body-power --status print current battery, no alarm
#   mesh-body-power --test   smoke test
#
# Threshold: MESH_BODY_POWER_MIN (default 20). Registry-resolved phone (~/.mesh/nodes / mesh-peer-addr).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
# ── HOMEORHESIS: this reflex defends a STATE, but the battery's health is a TRAJECTORY ──
# LITERATURE (homeostasis/allostasis/ultrastability, 2026-07-12, genome mind — live web).
# Concept: HOMEORHESIS (C.H. Waddington, *The Strategy of the Genes*, 1957 — coined in explicit
# contrast to homeostasis). Homeostasis stabilizes a STATE (a value held constant by negative
# feedback to a threshold/set-point); homeorhesis stabilizes a TRAJECTORY — a canalized path/flow
# (a "chreode"): "if the system is made to deviate from this path, it will return to the path
# FURTHER ALONG," not to the point it left. The area's own 2024-25 framing: "stabilized flow rather
# than stabilized state" (Bechtel, *J. Physiol.* 2024, doi:10.1113/JP286883; homeorhesis quantified
# in synthetic microbial ecosystems, *PNAS* 2019 doi:10.1073/pnas.1901055116; homeorhetic regulation
# of cellular phenotype, bioRxiv 2025.06.06.658216). Verified live (WebSearch 2026-07-12).
# Where THIS reflex stops short: mesh-body-power is a pure STATE-threshold defender — it alarms only
# when level < THRESH (20%) AND discharging (:48, :21). But a battery's health lives in its DISCHARGE
# CHREODE, not its level: two phones both at 60% are NOT equally healthy — one on its normal slow
# discharge slope, one plummeting on a stuck wakelock / runaway sensor loop. The rogue-drain phone is
# a HOMEORHETIC deviation (departed its expected discharge path) detectable while still well ABOVE
# 20% — hours before this threshold ever fires. We defend the state and are blind to the trajectory.
# CONCRETE APPLICATION (proposed, NOT shipped here — needs live series to calibrate): a read-only,
# off-by-default `mesh-body-power --trajectory` that fits the recent discharge slope from the
# body-power.log %-series and flags DRAIN-ANOMALY when the observed slope departs its own recent
# chreode by > k·MAD — advisory only (no board/TG/state write, no alarm gate), mirroring the honesty
# posture of `mesh-therm-watch --csd`/`--dfa`. Held un-built this turn: the phone is offline (log is
# all "phone unreachable"), so there is no live discharge series to calibrate the slope band against —
# shipping the math un-vetted would be exactly the settling-point/threshold overreach this names.
# DISTINCT from the already-landed neighbours: NOT set-point-vs-settling-point (that says a variable
# has no controller — here there IS a defended threshold, just aimed at the wrong observable);
# NOT loss-of-complexity/DFA-α (fractal structure of a series) nor CDP variance-collapse/FROZEN
# (too-little jitter = dead sensor). Homeorhesis names a THIRD thing: the SHAPE of the path over
# time, and defending it instead of the instantaneous level.
THRESH="${MESH_BODY_POWER_MIN:-20}"
STATE="$HOME/.mesh/.body-power-state"
OFFLINEFILE="$HOME/.mesh/.body-power-offline"

if [ "${1:-}" = --test ]; then
  e=0
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: dep python3"; e=$((e+1)); }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "FAIL: no ~/.mesh"; e=$((e+1)); }
  # dry-run battery JSON parser with synthetic inputs
  r="$(printf '{"percentage":85,"status":"Discharging","temperature":28.0}' | python3 -c 'import json,sys
d=json.load(sys.stdin); print(int(d.get("percentage",100)), d.get("status","UNKNOWN"))' 2>/dev/null)"
  [ "$r" = "85 Discharging" ] || { echo "FAIL: parse-85-discharging => '$r'"; e=$((e+1)); }
  r="$(printf '{"percentage":5,"status":"Discharging"}' | python3 -c 'import json,sys
d=json.load(sys.stdin); print(int(d.get("percentage",100)), d.get("status","UNKNOWN"))' 2>/dev/null)"
  [ "$r" = "5 Discharging" ] || { echo "FAIL: parse-5-discharging => '$r'"; e=$((e+1)); }
  r="$(printf '{"percentage":15,"status":"Charging"}' | python3 -c 'import json,sys
d=json.load(sys.stdin); print(int(d.get("percentage",100)), d.get("status","UNKNOWN"))' 2>/dev/null)"
  [ "$r" = "15 Charging" ] || { echo "FAIL: parse-15-charging => '$r'"; e=$((e+1)); }
  r="$(printf '{}' | python3 -c 'import json,sys
d=json.load(sys.stdin); print(int(d.get("percentage",100)), d.get("status","UNKNOWN"))' 2>/dev/null)"
  [ "$r" = "100 UNKNOWN" ] || { echo "FAIL: parse-empty => '$r'"; e=$((e+1)); }
  r="$(printf 'invalid' | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); print(int(d.get("percentage",100)), d.get("status","UNKNOWN"))
except Exception:
    print(100, "UNKNOWN")' 2>/dev/null)"
  [ "$r" = "100 UNKNOWN" ] || { echo "FAIL: parse-invalid-json => '$r'"; e=$((e+1)); }
  # classification logic: low = level < THRESH && status == DISCHARGING
  THRESH=20; low=0
  [ "$(printf '15 Discharging\n' | while read l s; do [ "$l" -lt "$THRESH" ] && [ "$s" = Discharging ] && echo 1 || echo 0; done)" = 1 ] || { echo "FAIL: classify-15-discharging-not-low"; e=$((e+1)); }
  [ "$(printf '85 Discharging\n' | while read l s; do [ "$l" -lt "$THRESH" ] && [ "$s" = Discharging ] && echo 1 || echo 0; done)" = 0 ] || { echo "FAIL: classify-85-discharging-false-pos"; e=$((e+1)); }
  [ "$(printf '15 Charging\n' | while read l s; do [ "$l" -lt "$THRESH" ] && [ "$s" = Discharging ] && echo 1 || echo 0; done)" = 0 ] || { echo "FAIL: classify-15-charging-false-pos"; e=$((e+1)); }
  [ "$(printf '15 UNKNOWN\n' | while read l s; do [ "$l" -lt "$THRESH" ] && [ "$s" = Discharging ] && echo 1 || echo 0; done)" = 0 ] || { echo "FAIL: classify-15-unknown-false-pos"; e=$((e+1)); }
  [ "$e" -eq 0 ] || { echo "smoke: FAIL ($e fail(s))"; exit 1; }

  # REAL-READ GATE (doctrine: --test must assert a live read PRODUCES data, not just that the
  # offline classifier compiles — that hollow gap is the mesh-mag/mesh-gyro dead-but-green class:
  # a synthetic-fixture-only --test stays green forever even if the live SSH/JSON pipeline breaks).
  # Honest contract: real numeric percentage => ok(0); unreachable/empty => n/a(2), never FAIL.
  tpip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke: ok (11 fixture assertions); n/a live read (phone unreachable)"; exit 2; }
  tj="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$tpip" \
    'termux-battery-status 2>/dev/null' </dev/null 2>/dev/null)"
  [ -n "$tj" ] || { echo "smoke: ok (11 fixture assertions); n/a live read (ssh/termux-battery-status unreachable or empty — mesh-phone-ip can return a stale cached IP even when the phone is actually offline)"; exit 2; }
  tlevel="$(printf '%s' "$tj" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); print(int(d["percentage"]))
except Exception:
    pass' 2>/dev/null)"
  [ -n "$tlevel" ] || { echo "smoke: FAIL (live read did not parse a real percentage: $tj)"; exit 1; }
  echo "smoke: ok (11 fixture assertions + live read: ${tlevel}%)"; exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)" || {
    if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read battery (not an alarm)"; touch "$OFFLINEFILE"; fi
    printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
    mesh-state-touch "$STATE"
    exit 2
}
rm -f "$OFFLINEFILE"

j="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a380}@$pip" 'termux-battery-status 2>/dev/null' </dev/null 2>/dev/null)"
[ -n "$j" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read battery (not an alarm)"; touch "$OFFLINEFILE"; fi; printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE"; exit 2; }

read -r level status < <(printf '%s' "$j" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); print(int(d.get("percentage",100)), d.get("status","UNKNOWN"))
except Exception:
    print(100, "UNKNOWN")' 2>/dev/null)
[ -n "${level:-}" ] || { echo "battery parse failed (not an alarm)"; exit 0; }

if [ "${1:-}" = --status ]; then echo "body battery: ${level}% ${status}"; exit 0; fi

# ADAPTIVITY GAP (Di Paolo, *Autopoiesis, Adaptivity, Teleology, Agency*, Phenomenology & the
# Cognitive Sciences 2005; live in enactivism 2024/2025): bare autopoiesis is ALL-OR-NOTHING —
# a system is viable or it disintegrates, with NO graded appreciation of *heading toward* the
# boundary. Di Paolo's adaptivity is the added capacity to monitor viability as a GRADED TENDENCY
# and regulate it BEFORE the edge — the property that grounds intrinsic concern/teleology (bare
# self-production cannot, because it only "knows" the all-or-nothing fact of still existing).
# This alarm is exactly the all-or-nothing case: it fires only as `level` crosses the FIXED 20%
# boundary, and it reads $STATE for the LABEL (OK/LOW) ONLY — never the prior (level, time), so it
# has NO discharge RATE / projected time-to-empty, which is the adaptive signal. It bites HERE
# above all: the body is the highest-stakes, near-IRREVERSIBLE viability variable (an away operator
# can't recharge it; a dead body = days of lost senses/actuators). Under fast discharge (the phone
# runs hot/overloaded — [[phone-wg-channel-replace-tailscale]]) 20% can mean <1h of runway → the
# single boundary alarm is too LATE to act on; a slow trickle at 19% fires the same alarm need-
# lessly. The RATE is the urgency, and it is unmeasured. The mesh DOES embody adaptivity elsewhere:
# mesh-homeostasis is an I-controller accumulating GRADED error on the egress invariant, escalating
# before catastrophe — body-power is its un-adapted sibling.
# HELD FIX (steward lands — behavioral): persist (level, epoch) in $STATE; difference across the
# */10 reads → discharge rate → projected time-to-empty; alarm on a GRADED runway margin (e.g.
# projected <Xh) in addition to the fixed %. Held because alarm-tuning is the cry-wolf class —
# instrument-first (log the rate, confirm it LEADS real lows) before touching the alarm.
# See [[liveness-is-lease-not-cached-status]] (a graded margin beats a cached binary flag).
prev="$(cat "$STATE" 2>/dev/null || echo OK)"
low=0; [ "$level" -lt "$THRESH" ] && [ "$status" = DISCHARGING ] && low=1
alert(){ # MESH_ALERT_DRYRUN=1 → print, don't send (safe testing of the alarm path; learned the hard way)
         if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] would alert: $2" >&2; return; fi
         command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$1" >/dev/null 2>&1
         command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="body-power@$(hostname)" mesh-chat "$2" >/dev/null 2>&1; }

if [ "$low" = 1 ]; then
  echo LOW > "$STATE"
  [ "$prev" != LOW ] && alert "🔋 Phone (the mesh's body) at ${level}% and discharging — plug it in to keep its senses/voice online." \
                              "[body-power-low] phone ${level}% discharging — body will go offline if not charged."
  echo "body-power: LOW ${level}%"; exit 1
else
  echo OK > "$STATE"
  [ "$prev" = LOW ] && alert "✅ Phone (mesh body) charging again at ${level}% — body power recovered." \
                            "[body-power-ok] phone ${level}% ${status} — body power recovered."
  echo "body-power: ok ${level}% ${status}"; exit 0
fi
