#!/usr/bin/env bash
# reflex-cadence: 5-59/10 * * * *
# doctor-artifact: $HOME/.mesh/.body-power-state 2400 phone
#   ^ smoke-theater gate (mesh-doctor): .body-power-state is rewritten on EVERY successful read (LOW or
#     OK branch), so phone-reachable + state >2400s stale ⟹ the sense is silently not producing despite
#     a green --test. Phone offline → gate skips (no false-fail). See mesh-doctor _theater_check.
# mesh-body-power — watch the phone BODY's battery so it doesn't silently DIE and take the mesh's
# physical senses+actuators offline. The body is expensive to restore (operator must physically revive
# Termux/sshd on the phone), so a low battery during an absence = days of lost capability. Edge-triggered
# (trustworthy-signal: alarm LOW+discharging, recover on charge); reads battery only — non-intrusive.
#
#   mesh-body-power          one check; edge-trigger [body-power-low]/[body-power-ok]
#   mesh-body-power --status print current battery, no alarm
#   mesh-body-power --test   smoke test
#   mesh-body-power --rate   reachability over the run ledger's own span, per boot (never across one)
#
# Threshold: MESH_BODY_POWER_MIN (default 20). Registry-resolved phone (~/.mesh/nodes / mesh-peer-addr).
#
# ── HONEST-DEGRADED CONTRACT (2026-08-19) ──────────────────────────────────────────────────────────
# EVERY line in $STATE is `VERDICT|k=v|...` — field 1 is always a bare verdict word, never payload.
#   OK|level=83|status=DISCHARGING|ts=<iso>      a real reading, battery fine
#   LOW|level=17|status=DISCHARGING|ts=<iso>     a real reading, below threshold and draining
#   UNREACHABLE|why=no-ip|ts=<iso>|last=<OK|LOW> mesh-phone-ip yielded nothing — the LINK, pre-connect
#   UNREACHABLE|why=ssh|ts=<iso>|last=…          ssh transport failed (rc 255) — the LINK
#   TIMEOUT|why=read-timeout|ts=<iso>|last=…     the read wall-clocked out (rc 124) — layer UNDECIDABLE
#   SENSOR-DARK|why=empty-read|ts=<iso>|last=…   ssh answered, battery organ returned ZERO bytes
#   SENSOR-DARK|why=no-organ|ts=<iso>|last=…     ssh answered rc 127 — termux-battery-status not there
#   UNREADABLE|why=parse|ts=<iso>|last=…         bytes arrived, no usable percentage in them
#
# ── WHY MORE THAN ONE n/a WORD (the collapse this tool carried until 2026-08-19) ──
# Both n/a branches used to write the single literal `OFFLINE <ts>`: one fires when there is no IP at
# all (the link), the other when the phone ACCEPTED ssh and its battery organ said nothing (the phone
# is up; only the organ is silent). A reader cannot act on a cause that has been collapsed away — a
# dead link is fixed by the link, a silent organ by a retry or by reviving termux-api. Census of
# body-power.log at the time of the fix: 1373 of 1603 lines (86%) were that one word, and the LOG line
# was BYTE-IDENTICAL for both branches too ("phone unreachable — can't read battery"), so the split
# could not be recovered even by hand. `na_state()` below is the ONE place a cause maps to a word.
# Same shape mesh-phone-prox was fixed for hours earlier (3280500); this is its named sibling.
# ([[a-collapsed-reason-makes-blind-and-quiet-identical]], [[an-error-message-names-a-cause-not-the-cause]])
#
# TIMEOUT is deliberately its OWN word and not folded into either layer: a read that expires does not
# tell you whether the link or the organ is at fault, and a probe that shares a failure mode with the
# thing it measures must not name a culprit it cannot see ([[a-timeout-is-not-a-refusal]],
# [[a-shared-failure-mode-lets-a-probe-blame-the-far-end]]).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
# ── HOMEORHESIS: this reflex defends a STATE, but the battery's health is a TRAJECTORY ──
# LITERATURE (homeostasis/allostasis/ultrastability, 2026-07-12, genome mind — live web).
# Concept: HOMEORHESIS (C.H. Waddington, *The Strategy of the Genes*, 1957 — coined in explicit
# contrast to homeostasis). Homeostasis stabilizes a STATE (a value held constant by negative
# feedback to a threshold/set-point); homeorhesis stabilizes a TRAJECTORY — a canalized path/flow
# (a "chreode"): "if the system is made to deviate from this path, it will return to the path
# FURTHER ALONG," not to the point it left. The area's own 2024-25 framing: "stabilized flow rather
# than stabilized state" (Bechtel, *J. Physiol.* 2024, doi:10.1113/JP286883; homeorhesis quantified
# in synthetic microbial ecosystems, *PNAS* 2019 doi:10.1073/pnas.1901055116; homeorhetic regulation
# of cellular phenotype, bioRxiv 2025.06.06.658216). Verified live (WebSearch 2026-07-12).
# Where THIS reflex stops short: mesh-body-power is a pure STATE-threshold defender — it alarms only
# when level < THRESH (20%) AND discharging (:48, :21). But a battery's health lives in its DISCHARGE
# CHREODE, not its level: two phones both at 60% are NOT equally healthy — one on its normal slow
# discharge slope, one plummeting on a stuck wakelock / runaway sensor loop. The rogue-drain phone is
# a HOMEORHETIC deviation (departed its expected discharge path) detectable while still well ABOVE
# 20% — hours before this threshold ever fires. We defend the state and are blind to the trajectory.
# CONCRETE APPLICATION (proposed, NOT shipped here — needs live series to calibrate): a read-only,
# off-by-default `mesh-body-power --trajectory` that fits the recent discharge slope from the
# body-power.log %-series and flags DRAIN-ANOMALY when the observed slope departs its own recent
# chreode by > k·MAD — advisory only (no board/TG/state write, no alarm gate), mirroring the honesty
# posture of `mesh-therm-watch --csd`/`--dfa`. Held un-built this turn: the phone is offline (log is
# all "phone unreachable"), so there is no live discharge series to calibrate the slope band against —
# shipping the math un-vetted would be exactly the settling-point/threshold overreach this names.
# DISTINCT from the already-landed neighbours: NOT set-point-vs-settling-point (that says a variable
# has no controller — here there IS a defended threshold, just aimed at the wrong observable);
# NOT loss-of-complexity/DFA-α (fractal structure of a series) nor CDP variance-collapse/FROZEN
# (too-little jitter = dead sensor). Homeorhesis names a THIRD thing: the SHAPE of the path over
# time, and defending it instead of the instantaneous level.
THRESH="${MESH_BODY_POWER_MIN:-20}"
STATE="$HOME/.mesh/.body-power-state"
OFFLINEFILE="$HOME/.mesh/.body-power-offline"
# The LOW alarm's edge memory, deliberately a SEPARATE fact from the label in $STATE. See
# classify_recovered: the label may read OK while the body is still draining, and conflating the
# two is what let a few-percent jitter both cancel the alarm and re-arm it.
ARMFILE="$HOME/.mesh/.body-power-armed"

# ── THE RUN LEDGER — the tape body-power.log could never be ────────────────────────────────────────
# `body-power.log` is the CRON STDOUT redirect and NOT ONE OF ITS ROWS CARRIES A TIME. That is not a
# cosmetic gap: measured 2026-08-29 on a 2078-row tape whose tail alternates UNREACHABLE/ok 1:1, the
# alternation could not be decided between a 20-minute period, a day-long era, and rows straddling
# three power-offs — this node power-cycles, so A ROW IS NOT A TICK. Every rate anyone has ever
# quoted off that tape is therefore unfounded, including the "~86% of ticks" in this file's own
# header (that is 86% of ROWS) and the `--test` gate rationale resting on it.
#
# AND THE ROWS ARE NOT EVEN ONE PER TICK, IN ONE DIRECTION ONLY. `na_out` prints its line only when
# the cause CHANGES (the per-cause notice, deliberate — it stops an outage repeating itself hourly),
# while every successful read prints unconditionally. So the stdout tape is EDGE-triggered on failure
# and LEVEL-triggered on success. Driven live 2026-08-29 against a real ssh to an unroutable address,
# five consecutive n/a ticks: **1 row in the stdout tape, 5 in this ledger**. That asymmetry is the
# alternation — one UNREACHABLE row per outage EPISODE against one `ok` row per successful TICK — and
# it means the header's 1373 n/a lines are 1373 EPISODES, so the true unreachable share of ticks is
# not 86% but unknowable from that tape, and higher. A tape that counts one class by edges and the
# other by levels cannot be a ratio of anything. [[a-tape-of-only-positives-is-a-numerator]]
# Both of this tool's held fixes name that tape as their source — the `--trajectory` discharge-slope
# in the homeorhesis note above, and the graded time-to-empty in the adaptivity note below. A SLOPE
# NEEDS A TIME AXIS. This is it.
#
# Three things it does that the stdout tape structurally cannot:
#   · EVERY attempt writes exactly one row, whatever the outcome — the n/a causes included. A tape of
#     only the reads that SUCCEEDED is a numerator with no denominator, and its silences fuse "the
#     phone was quiet" with "the reflex never ran". [[a-tape-of-only-positives-is-a-numerator]]
#   · Each row carries the BOOT ID. Consecutive rows on this node can span a power-off, so a
#     difference taken across a boot boundary is not a discharge rate — it is an artifact of the
#     machine having been off. A consumer that cannot see the boundary cannot refuse to cross it.
#     [[an-age-that-spans-a-power-off-is-not-a-silence]]
#   · It is a SEPARATE file from body-power.log on purpose. Sharing them would double-count every
#     rate, and it is the file a `--test` must never touch — a dry-run that writes the durable record
#     forges the evidence it exists to check. The gate below asserts the ledger does not grow under
#     `--test`. [[a-dry-run-that-writes-the-liveness-log-forges-its-own-evidence]]
LEDGER="$HOME/.mesh/body-power-readings.log"

# boot_id → this boot's kernel identity, short. `na` when the kernel will not say, never a constant:
# a fabricated boot id silently re-joins two sides of a power-off, which is the one join it exists to
# forbid.
boot_id() {
  local b
  b="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '-' | cut -c1-8)"
  [ -n "$b" ] && printf '%s' "$b" || printf 'na'
}

# launched_by → the PARENT's comm: `cron` for a scheduled tick, a shell name for a hand run. This is
# the field that makes the tape a RATE SOURCE rather than a pile of readings — `argv=` only separates
# an explicit `--status`, and a bare hand-driven run is byte-identical to a cron tick without this
# (measured 2026-08-29: three of my own hand runs landed in the live ledger wearing `argv=-`, wholly
# indistinguishable from the 14:45:01 cron row beside them, and every one of them inflated the tick
# denominator). It names what LAUNCHED the run, never a capability the run happened to have.
# [[an-exemption-that-cites-a-capability-is-not-a-launcher]]
# `na` when /proc will not say — never a guess, and `--rate` counts pre-field rows APART rather than
# assuming they were ticks.
# The IMMEDIATE parent is not the launcher. Measured 2026-08-29: a hand run through `timeout 60 …`
# reported `by=timeout`, and cron does not exec the tool directly either — it runs `/bin/sh -c <line>`,
# so the immediate parent of a scheduled tick is a SHELL. Keying on $PPID alone would have put `sh` on
# every cron row, `cron` on none, and left --rate reading 0 ticks forever off a tape full of them —
# a denominator that silently empties. So walk UP past the transparent wrappers (shells, `timeout`,
# `env`, `nohup`) to the first ancestor that actually decided this run should happen.
# Bounded at 8 hops; `na` when /proc stops answering — never a guess, and never the last comm we saw.
launched_by() {
  local pid="$PPID" c hops=0
  while [ "$hops" -lt 8 ] && [ -n "$pid" ] && [ "$pid" != 0 ] && [ "$pid" != 1 ]; do
    c="$(tr -cd 'A-Za-z0-9_.-' < "/proc/$pid/comm" 2>/dev/null)"
    [ -n "$c" ] || { printf 'na'; return; }
    case "$c" in
      sh|bash|dash|zsh|timeout|env|nohup|setsid|nice|ionice) : ;;
      *) printf '%s' "$c"; return ;;
    esac
    pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)"
    hops=$((hops+1))
  done
  printf 'na'
}

# ledger_row <verdict> <level|""> <status|""> <rc|""> → one dated row. Absent evidence renders `na`,
# NEVER 0 and never an omitted field: an omitted field encodes the default value to whatever parses
# it by position. [[an-omitted-field-can-encode-the-default-value]]
# MESH_BODY_POWER_LEDGER= (empty) suppresses the write — that is how `--test` stays unable to forge a
# row, and it is set by the gate, never by the read path.
ledger_row() {
  [ -n "${LEDGER:-}" ] || return 0
  printf '%s %s level=%s status=%s rc=%s boot=%s argv=%s by=%s\n' \
    "$TS" "${1:-UNKNOWN}" "${2:-na}" "${3:-na}" "${4:-na}" "$(boot_id)" "${MESH_BODY_POWER_ARGV:--}" \
    "$(launched_by)" >> "$LEDGER" 2>/dev/null || true
}


# ── THE CAUSE MAP + THE SHARED READ/PARSE/CLASSIFY PATH ───────────────────────────────────────────
# na_state <cause> <ts> [last-reading] → the honest-n/a state line. THE ONE PLACE a cause maps to a
# verdict word, so a new cause cannot silently inherit another cause's meaning. Pure and
# offline-testable, which is the whole point: this phone is unreachable on MOST ticks, so a gate
# that needed a live branch to be driven would assert nothing on exactly the runs that matter.
# The rationale stands; the NUMBER that used to sit here ("~86% of ticks") does not, and it was the
# founding defect of this file's own ledger — 86% is a share of ROWS in body-power.log, which carries
# no time axis and no boot id, so it was never a tick rate at all (see the header, ~L90). Do not
# re-quote it. The measured axis now lives in `--rate`, which counts CRON ticks only, excludes hand
# runs by the `by=` field, names its span and its boot count, and says in its own output that its
# denominator is rows the ledger HOLDS rather than the cron cadence — a tick the node was powered
# off for left no row. First honest reading 2026-08-29T16:15Z: reachable 4/9 ticks (44.4%) over an
# 80-minute span across 1 boot, 5 hand runs excluded. n=9 — that is a first reading, NOT a rate to
# quote as settled, and re-quoting it as one would repeat exactly the fault it replaced.
na_state() {
  local w
  case "${1:-}" in
    no-ip)        w='UNREACHABLE|why=no-ip' ;;
    ssh)          w='UNREACHABLE|why=ssh' ;;
    read-timeout) w='TIMEOUT|why=read-timeout' ;;
    empty-read)   w='SENSOR-DARK|why=empty-read' ;;
    no-organ)     w='SENSOR-DARK|why=no-organ' ;;
    parse)        w='UNREADABLE|why=parse' ;;
    *)            w="UNREADABLE|why=${1:-unknown}" ;;
  esac
  printf '%s|ts=%s%s\n' "$w" "${2:-}" "${3:+|last=$3}"
}

# ok_state <OK|LOW> <level> <status> <ts> → a READING line, in the SAME record shape as the n/a lines.
ok_state() { printf '%s|level=%s|status=%s|ts=%s\n' "${1:-}" "${2:-}" "${3:-}" "${4:-}"; }

# is_na_verdict <word> → 0 when the word is an n/a marker rather than a reading. Keyed on the marker
# SET so adding a seventh cause cannot quietly make the edge logic treat it as a value.
is_na_verdict() {
  case "${1:-}" in UNREACHABLE|TIMEOUT|SENSOR-DARK|UNREADABLE) return 0 ;; *) return 1 ;; esac
}

# prev_reading <state-line> → the last CONFIRMED OK/LOW, seen THROUGH an n/a line via its carried
# `last=`. Without this an n/a line reads as "prev is not LOW": a LOW→offline→LOW flap re-fires the
# low alarm (cry-wolf) and a LOW→offline→OK recovery is swallowed silently — the n/a marker being
# consumed as if it were a value. Legacy bare `OK`/`LOW` and the legacy `OFFLINE <ts>` still parse.
prev_reading() {
  local f1 l
  f1="$(printf '%s' "${1:-}" | cut -d'|' -f1 | cut -d' ' -f1)"
  case "$f1" in OK|LOW) printf '%s' "$f1"; return ;; esac
  l="$(printf '%s' "${1:-}" | tr '|' '\n' | sed -n 's/^last=//p' | head -1)"
  case "$l" in OK|LOW) printf '%s' "$l" ;; *) printf 'OK' ;; esac
}

# read_battery_json <ip> → the raw termux-battery-status stream on stdout; the RETURN CODE ENCODES THE
# LAYER, which is the whole reason the two branches can be told apart at all:
#   0 + bytes = a real read · 0 + empty = organ silent · 124 = read expired · 255 = ssh transport
#   failed · 127 = the phone answered but termux-battery-status is not installed
read_battery_json() {
  local out rc
  out="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$1" \
    'termux-battery-status 2>/dev/null' </dev/null 2>/dev/null)"; rc=$?
  printf '%s' "$out"
  return "$rc"
}

# read_battery_retry <ip> → the stream with ONE bounded retry on a non-answer. MEASURED on this phone
# 2026-08-19, 6 back-to-back reads while `ssh … echo` answered instantly: 2 returned zero bytes (rc=124,
# the 12s read expiring) and 4 returned 294 bytes. A single-shot read therefore reports the body dead on
# roughly a third of ticks — the mesh-mag/mesh-gyro `-n 1` shape (d657375) and mesh-phone-prox's
# (3280500). Retry only on the failure path: a first-read success costs nothing extra. Bounded at ONE
# so a genuinely dead body still renders inside the cron stride.
read_battery_retry() {
  local out rc
  out="$(read_battery_json "$1")"; rc=$?
  if [ -z "$out" ]; then sleep "${MESH_BODY_POWER_RETRY_SLEEP:-3}"; out="$(read_battery_json "$1")"; rc=$?; fi
  printf '%s' "$out"
  return "$rc"
}

# parse_battery <json> → "<level> <status>" or "" (empty = unreadable). NO DEFAULTS: the old parser
# answered `100 UNKNOWN` on ANY exception, so an unparseable stream was published as a FULL, healthy
# battery — a silent fallback indistinguishable from success, on the one variable this reflex exists to
# defend. Absence renders UNREADABLE now, never a fabricated 100%.
parse_battery() {
  printf '%s' "${1:-}" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print(int(d["percentage"]), str(d.get("status", "UNKNOWN")))
except Exception:
    pass
' 2>/dev/null
}

# classify_low <level> <status> → 1 when the body is genuinely draining below the threshold. BOTH the
# read path and --test call THIS. The old --test re-implemented the comparison inline and asserted the
# COPY — and the copy compared `Discharging` while the live code compared `DISCHARGING`, so the gate
# could not fail on the thing it claimed to check (source text is never behaviour). Status is
# upper-cased here, so a Termux build that returns mixed case cannot silently disarm the alarm.
classify_low() {
  local l="${1:-}" s
  s="$(printf '%s' "${2:-}" | tr 'a-z' 'A-Z')"
  case "$l" in ''|*[!0-9]*) echo 0; return ;; esac
  if [ "$l" -lt "$THRESH" ] && [ "$s" = DISCHARGING ]; then echo 1; else echo 0; fi
}

# classify_recovered <status> → 1 only when the body has genuinely STOPPED draining.
#
# THE ASYMMETRY THIS EXISTS TO KILL. classify_low is a CONJUNCTION — below the threshold AND
# DISCHARGING — but the recovery verdict used to be its plain NEGATION (`else` on `low != 1`), so it
# was reached on EITHER disjunct failing. A battery that jittered a few percent back over 20 while
# still discharging therefore announced "✅ charging again — body power recovered", and the chat line
# printed the contradiction verbatim: `[body-power-ok] phone 22% DISCHARGING — body power recovered`.
# Measured twice in one afternoon on this node (board, 2026-08-21): LOW 19% at 14:35 → "recovered"
# at 22% DISCHARGING 16:05 → LOW 19% again 18:05 → "recovered" at 21% DISCHARGING 18:55. Every
# all-clear was false and each one re-armed the alarm, so ONE draining episode cries wolf N times —
# the cry-wolf the fixed-boundary design was chosen to avoid, arriving through the recovery edge
# instead of the alarm edge.
#
# So recovery is a POSITIVE test on the status word, never the negation of the alarm. The evidence
# that ends a "the body is draining" alarm is the draining STOPPING — a power source appearing —
# not the level wandering back over a line it will cross again in twenty minutes. Same shape as the
# doctrine rule one ring out: a verdict must be earned by the evidence its claim names.
#
# UNKNOWN is NOT recovery. A status the phone could not report says nothing about whether power
# arrived, and treating unreadable as recovered is the silent-fallback failure — a default
# indistinguishable from a success will be one.
classify_recovered() {
  local s
  s="$(printf '%s' "${1:-}" | tr 'a-z' 'A-Z')"
  case "$s" in CHARGING|FULL|NOT_CHARGING|'NOT CHARGING') echo 1 ;; *) echo 0 ;; esac
}

# edge_verdict <armed> <low> <recovered> → what the ALARM does this tick, as one word. The read path
# and --test both call THIS; the decision is not spelled inline anywhere, so the gate cannot pass on
# a copy of a rule the live code does not run (the mixed-case lesson from classify_low, one function
# over).
#   alarm   — the LOW edge: tell the operator once, arm.
#   hold    — outstanding alarm, level back above the threshold but STILL not on power. SILENT.
#   recover — the alarm ends because the draining STOPPED. Disarm, say so.
#   none    — nothing to say.
edge_verdict() {
  local armed="${1:-0}" low="${2:-0}" rec="${3:-0}"
  if [ "$low" = 1 ]; then
    [ "$armed" = 1 ] && { echo none; return; }; echo alarm; return
  fi
  [ "$armed" = 1 ] || { echo none; return; }
  [ "$rec" = 1 ] && { echo recover; return; }
  echo hold
}

# HOISTED above the `--test` block on purpose: the gate drives this function for real to prove
# the n/a path is WIRED to the ledger, and a function defined below an `exit`-ing gate does not
# exist to it. Its inputs ($TS/$LAST/$STATE/$OFFLINEFILE) are late-bound, so hoisting changes
# nothing about the read path.
# na_out <cause> <human line> → render the honest n/a and leave: the distinct word + why= in $STATE,
# the cause named in the LOG. The notice is per-CAUSE, not per-episode — the old gate printed once per
# offline stretch, so a link outage that turned into a silent battery organ said nothing at all, and
# the two log lines were byte-identical anyway. $LAST rides along so the alarm edge survives the gap.
na_out() {
  local prevcause
  prevcause="$(cat "$OFFLINEFILE" 2>/dev/null || true)"
  if [ "$prevcause" != "$1" ]; then echo "body-power: $2"; printf '%s\n' "$1" > "$OFFLINEFILE"; fi
  na_state "$1" "$TS" "$LAST" > "$STATE"
  # The ledger row carries the VERDICT WORD, read back out of the state line na_state just built, so
  # the tape and the state can never disagree about what this tick decided — and a seventh cause added
  # to na_state reaches the ledger without a second edit here.
  ledger_row "$(printf '%s' "$(na_state "$1" "$TS")" | cut -d'|' -f1)" "" "" "${NA_RC:-}"
  mesh-state-touch "$STATE"
  exit 2
}


# --rate → what the undated stdout tape could never answer: the reachability rate of the body, over
# the ledger's OWN span, per BOOT. Three refusals are the whole point of it:
#   · it never differences across a boot boundary — on a node that power-cycles, two adjacent rows can
#     be nine hours apart with the machine off in between, and a "rate" computed across that gap is an
#     artifact of the power-off, not of the phone;
#   · an absent or single-row tape renders UNKNOWN with the span it actually has, never 0 and never a
#     rate off one point;
#   · the denominator is the ROWS THE LEDGER HOLDS, stated out loud — not the cron cadence. A cadence
#     is what was scheduled; the ledger is what ran. [[a-sense-that-does-not-name-its-denominator]]
# Hand-driven reads (argv=--status) are excluded from the cadence arithmetic and counted apart: a
# reading a human asked for is real, but it is not a tick.
if [ "${1:-}" = --rate ]; then
  _L="$HOME/.mesh/body-power-readings.log"
  if [ ! -s "$_L" ]; then
    echo "body-power --rate: UNKNOWN — no ledger at $_L (the tape starts empty by design; it is not a zero)"
    exit 2
  fi
  awk '
    { n++
      if (first=="") first=$1
      lastts=$1
      by=""; argv=""
      for(i=1;i<=NF;i++){ if($i ~ /^by=/) by=substr($i,4); if($i ~ /^argv=/) argv=substr($i,6) }
      if (argv == "--status" || argv == "--test") { hand++; next }
      if (by == "")   { prefield++; next }            # written before the launcher field existed
      if (by == "na") { unknownlaunch++; next }       # /proc would not say — not assumed to be a tick
      if (by != "cron") { handrun++; next }           # a bare hand run is NOT a tick
      ticks++
      w=$2; if (w=="OK"||w=="LOW"||w=="READ") reach++
      boot=""; for(i=1;i<=NF;i++) if ($i ~ /^boot=/) boot=substr($i,6)
      if (boot != last_boot) { boots++; last_boot=boot }
    }
    END {
      if (ticks < 2) {
        printf "body-power --rate: UNKNOWN — %d row(s), %d cron tick(s); a rate needs two (span %s..%s)", n, ticks, first, lastts
        if (handrun)       printf " · %d hand run(s)", handrun
        if (prefield)      printf " · %d pre-launcher-field row(s), NOT assumed to be ticks", prefield
        if (unknownlaunch) printf " · %d row(s) whose launcher was unreadable", unknownlaunch
        printf "\n"
        exit 2
      }
      printf "body-power --rate: reachable %d/%d CRON tick(s) (%.1f%%) over %s..%s across %d boot(s)",
             reach, ticks, 100*reach/ticks, first, lastts, boots
      if (hand)          printf " · %d --status read(s) excluded", hand
      if (handrun)       printf " · %d hand run(s) excluded", handrun
      if (prefield)      printf " · %d pre-launcher-field row(s) excluded (NOT assumed to be ticks)", prefield
      if (unknownlaunch) printf " · %d row(s) whose launcher was unreadable, excluded", unknownlaunch
      printf "\n"
      printf "  denominator = rows this ledger HOLDS, not the cron cadence — a scheduled tick the node was powered off for left no row.\n"
    }' "$_L"
  exit $?
fi

# --test-ledger-forgery → run the FULL `--test` and assert the durable ledger did not grow. A dry-run
# that writes the record a human or watchdog reads for liveness forges the evidence it exists to
# check, so this is asserted from OUTSIDE the gate, on the real file, around the real invocation —
# never by the gate inspecting itself. [[a-dry-run-that-writes-the-liveness-log-forges-its-own-evidence]]
if [ "${1:-}" = --test-ledger-forgery ]; then
  _L="$HOME/.mesh/body-power-readings.log"
  _b=0; [ -f "$_L" ] && _b="$(wc -l < "$_L")"
  "$0" --test >/dev/null 2>&1; _trc=$?
  _a=0; [ -f "$_L" ] && _a="$(wc -l < "$_L")"
  if [ "$_a" -ne "$_b" ]; then
    echo "forgery: FAIL — --test grew the durable ledger by $((_a-_b)) row(s) ($_b -> $_a)"; exit 1
  fi
  echo "forgery: ok — --test (rc=$_trc) wrote 0 rows to $_L (held at $_b)"; exit 0
fi

if [ "${1:-}" = --test ]; then
  e=0
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: dep python3"; e=$((e+1)); }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "FAIL: no ~/.mesh"; e=$((e+1)); }
  # --- PARSER: drives the REAL parse_battery the read path calls, never an inline copy of it ---
  r="$(parse_battery '{"percentage":85,"status":"DISCHARGING","temperature":28.0}')"
  [ "$r" = "85 DISCHARGING" ] || { echo "FAIL: parse-85-discharging => '$r'"; e=$((e+1)); }
  r="$(parse_battery '{"percentage":5,"status":"DISCHARGING"}')"
  [ "$r" = "5 DISCHARGING" ] || { echo "FAIL: parse-5-discharging => '$r'"; e=$((e+1)); }
  r="$(parse_battery '{"percentage":15,"status":"CHARGING"}')"
  [ "$r" = "15 CHARGING" ] || { echo "FAIL: parse-15-charging => '$r'"; e=$((e+1)); }
  # NO-FABRICATION gate: absence must render EMPTY, never a healthy-looking default. The old parser
  # answered `100 UNKNOWN` for all three of these — an unreadable stream published as a FULL battery,
  # written to $STATE as a plain `OK` and indistinguishable from a real one.
  r="$(parse_battery '{}')"
  [ -z "$r" ] || { echo "FAIL: missing percentage must parse EMPTY, not a fabricated level => '$r'"; e=$((e+1)); }
  r="$(parse_battery 'invalid')"
  [ -z "$r" ] || { echo "FAIL: invalid JSON must parse EMPTY, not a fabricated level => '$r'"; e=$((e+1)); }
  r="$(parse_battery '')"
  [ -z "$r" ] || { echo "FAIL: empty stream must parse EMPTY => '$r'"; e=$((e+1)); }
  # --- CLASSIFIER: the real classify_low, so the gate cannot pass on a copy that never runs ---
  THRESH=20
  [ "$(classify_low 15 DISCHARGING)" = 1 ] || { echo "FAIL: classify-15-discharging-not-low"; e=$((e+1)); }
  [ "$(classify_low 85 DISCHARGING)" = 0 ] || { echo "FAIL: classify-85-discharging-false-pos"; e=$((e+1)); }
  [ "$(classify_low 15 CHARGING)"    = 0 ] || { echo "FAIL: classify-15-charging-false-pos"; e=$((e+1)); }
  [ "$(classify_low 15 UNKNOWN)"     = 0 ] || { echo "FAIL: classify-15-unknown-false-pos"; e=$((e+1)); }
  [ "$(classify_low 15 Discharging)" = 1 ] || { echo "FAIL: mixed-case status must not disarm the low alarm"; e=$((e+1)); }
  [ "$(classify_low '' UNKNOWN)"     = 0 ] || { echo "FAIL: an empty level must never classify LOW"; e=$((e+1)); }
  # --- RECOVERY: a POSITIVE test, never the negation of the alarm (the 2026-08-21 false all-clear) ---
  [ "$(classify_recovered CHARGING)"     = 1 ] || { echo "FAIL: CHARGING must be recovery"; e=$((e+1)); }
  [ "$(classify_recovered FULL)"         = 1 ] || { echo "FAIL: FULL must be recovery"; e=$((e+1)); }
  [ "$(classify_recovered Charging)"     = 1 ] || { echo "FAIL: mixed-case status must not withhold recovery"; e=$((e+1)); }
  [ "$(classify_recovered DISCHARGING)"  = 0 ] || { echo "FAIL: a DISCHARGING body has NOT recovered"; e=$((e+1)); }
  [ "$(classify_recovered UNKNOWN)"      = 0 ] || { echo "FAIL: an unreadable status must not read as recovery"; e=$((e+1)); }
  [ "$(classify_recovered '')"           = 0 ] || { echo "FAIL: an empty status must not read as recovery"; e=$((e+1)); }
  # --- EDGE: the real edge_verdict, replayed against the MEASURED episode this fix exists for ---
  # Board, 2026-08-21: LOW 19% 14:35 -> "recovered" 22% DISCHARGING 16:05 -> LOW 19% 18:05 ->
  # "recovered" 21% DISCHARGING 18:55. Two false all-clears and one re-armed cry-wolf, from a battery
  # that was never once on power. Replayed as (armed, low, recovered) the old negation produced
  # alarm/recover/alarm/recover; the required shape is alarm/hold/none/hold — ONE poke for ONE episode.
  _seq=""; _armed=0
  for _step in "19 DISCHARGING" "22 DISCHARGING" "19 DISCHARGING" "21 DISCHARGING"; do
    set -- $_step
    _v="$(edge_verdict "$_armed" "$(classify_low "$1" "$2")" "$(classify_recovered "$2")")"
    case "$_v" in alarm) _armed=1 ;; recover) _armed=0 ;; esac
    _seq="$_seq$_v "
  done
  [ "$_seq" = "alarm hold none hold " ] \
    || { echo "FAIL: the 2026-08-21 jitter episode must poke ONCE, got '$_seq'"; e=$((e+1)); }
  # And a genuine recovery must still END the alarm — otherwise the fix trades a false all-clear for
  # a permanently stuck one, and the operator is never told the body is safe.
  [ "$(edge_verdict 1 0 1)" = recover ] || { echo "FAIL: a real CHARGING recovery must disarm"; e=$((e+1)); }
  [ "$(edge_verdict 0 0 1)" = none ]    || { echo "FAIL: recovery with no alarm outstanding says nothing"; e=$((e+1)); }
  [ "$(edge_verdict 1 1 0)" = none ]    || { echo "FAIL: a still-LOW tick must not re-poke"; e=$((e+1)); }
  [ "$(edge_verdict 0 1 0)" = alarm ]   || { echo "FAIL: the first LOW tick must alarm"; e=$((e+1)); }
  unset _seq _armed _step _v
  # --- n/a CAUSE-WORD gates: the collapse this tool carried until 2026-08-19 (see header census) ---
  # Gated OFFLINE, on the pure na_state, for the same reason the live read gate exits 2 rather than
  # failing: the phone is unreachable on most ticks, and a mapping asserted only when a live branch
  # can be driven is a mapping that is unasserted exactly when it is being used.
  _v(){ printf '%s' "$1" | cut -d'|' -f1; }
  [ "$(_v "$(na_state no-ip T)")"        = UNREACHABLE ] || { echo "FAIL: no phone IP must say UNREACHABLE"; e=$((e+1)); }
  [ "$(_v "$(na_state ssh T)")"          = UNREACHABLE ] || { echo "FAIL: ssh refused must say UNREACHABLE"; e=$((e+1)); }
  [ "$(_v "$(na_state read-timeout T)")" = TIMEOUT     ] || { echo "FAIL: a timeout must not name a layer it cannot see"; e=$((e+1)); }
  [ "$(_v "$(na_state empty-read T)")"   = SENSOR-DARK ] || { echo "FAIL: a silent battery organ must NOT wear the link-down word"; e=$((e+1)); }
  [ "$(_v "$(na_state no-organ T)")"     = SENSOR-DARK ] || { echo "FAIL: absent termux-api must render a sensor word"; e=$((e+1)); }
  [ "$(_v "$(na_state parse T)")"        = UNREADABLE  ] || { echo "FAIL: parse-fail must say UNREADABLE"; e=$((e+1)); }
  for _c in empty-read no-organ parse; do
    [ "$(_v "$(na_state "$_c" T)")" != UNREACHABLE ] \
      || { echo "FAIL: cause '$_c' fires with the phone UP — it must not claim the link is down"; e=$((e+1)); }
  done
  [ "$(_v "$(na_state ssh T)")" != "$(_v "$(na_state empty-read T)")" ] \
    || { echo "FAIL: a down link and a silent organ must be distinguishable — that IS the bug"; e=$((e+1)); }
  # a verdict word with no cause beside it is the same collapse in a new coat
  for _c in no-ip ssh read-timeout empty-read no-organ parse; do
    case "$(na_state "$_c" T)" in *"|why=$_c|"*) : ;; *) echo "FAIL: n/a line for '$_c' must carry why=$_c"; e=$((e+1)) ;; esac
  done
  # and nothing may resurrect the one collapsed word
  for _c in no-ip ssh read-timeout empty-read no-organ parse future-cause; do
    case "$(na_state "$_c" T)" in OFFLINE*) echo "FAIL: cause '$_c' still renders the collapsed OFFLINE word"; e=$((e+1)) ;; esac
  done
  # --- RECORD SHAPE: field 1 of EVERY line — n/a AND reading — is one bare verdict word, no payload.
  # mesh-sensorium renders the value slot as `cut -d'|' -f1 | cut -d' ' -f1`; the old n/a line was
  # space-delimited (`OFFLINE <ts>`) while nothing else was, which is how the pane came to show
  # `power=OFFLINE 2026-08-19T08:57:04Z (fresh)` — the timestamp sitting in the VALUE slot (3280500).
  # `future-cause` is what makes this gate INDEPENDENT of the word assertions above: only the `*)`
  # fallback and the reading lines are covered by this gate alone.
  for _l in "$(na_state no-ip 2026-08-19T00:00:00Z)" "$(na_state empty-read 2026-08-19T00:00:00Z LOW)" \
            "$(na_state future-cause 2026-08-19T00:00:00Z)" \
            "$(ok_state OK 83 DISCHARGING 2026-08-19T00:00:00Z)" \
            "$(ok_state LOW 7 DISCHARGING 2026-08-19T00:00:00Z)"; do
    _f1="$(printf '%s' "$_l" | cut -d'|' -f1)"
    case "$_f1" in *[[:space:]]*) echo "FAIL: field 1 of '$_l' carries payload ('$_f1') — a reader renders it as the value"; e=$((e+1)) ;; esac
    [ -n "$_f1" ] || { echo "FAIL: empty verdict field in '$_l'"; e=$((e+1)); }
    case "$_l" in *'|ts='*) : ;; *) echo "FAIL: '$_l' carries no ts="; e=$((e+1)) ;; esac
  done
  # --- is_na_verdict must cover every marker and NO reading ---
  for _w in UNREACHABLE TIMEOUT SENSOR-DARK UNREADABLE; do
    is_na_verdict "$_w" || { echo "FAIL: is_na_verdict must accept marker '$_w'"; e=$((e+1)); }
  done
  for _w in OK LOW; do
    if is_na_verdict "$_w"; then echo "FAIL: is_na_verdict must reject reading '$_w'"; e=$((e+1)); fi
  done
  # --- EDGE MEMORY: an n/a line is not a reading. Reading $STATE for the label alone made an offline
  # blip read as "prev is not LOW", so a LOW→n/a→LOW flap re-fired the low alarm (cry-wolf) and a
  # LOW→n/a→OK recovery was swallowed — and this phone flaps: 1373 n/a episodes in body-power.log.
  [ "$(prev_reading "$(ok_state LOW 7 DISCHARGING T)")" = LOW ] || { echo "FAIL: prev_reading must read LOW off a reading line"; e=$((e+1)); }
  [ "$(prev_reading "$(ok_state OK 83 DISCHARGING T)")" = OK ]  || { echo "FAIL: prev_reading must read OK off a reading line"; e=$((e+1)); }
  [ "$(prev_reading "$(na_state ssh T LOW)")" = LOW ] || { echo "FAIL: an n/a line must CARRY the last reading, not erase it"; e=$((e+1)); }
  [ "$(prev_reading "$(na_state empty-read T OK)")" = OK ] || { echo "FAIL: an n/a line must carry OK through"; e=$((e+1)); }
  [ "$(prev_reading 'LOW')" = LOW ] || { echo "FAIL: a legacy bare LOW state must still parse"; e=$((e+1)); }
  [ "$(prev_reading 'OFFLINE 2026-08-19T08:57:04Z')" = OK ] || { echo "FAIL: the legacy space-delimited line must degrade to OK, not to payload"; e=$((e+1)); }
  [ "$(prev_reading '')" = OK ] || { echo "FAIL: an empty state must default OK"; e=$((e+1)); }
  # --- RETRY, gated OFFLINE with a stub `ssh`. The live gate below exits 2 when the phone is away —
  # which is precisely when a silently-lost retry would go unnoticed — so the retry is asserted here
  # against the measured shape (2 of 6 back-to-back reads empty while ssh itself answered instantly).
  # The stub is found because the tool prepends $HOME/.local/bin to PATH and `ssh` does not live there;
  # PATH is changed inside a command substitution only, so nothing leaks into the live read below.
  _sd="$(mktemp -d)"
  printf '%s\n' '#!/usr/bin/env bash' \
    'n=$(cat "$SSH_STUB_COUNT" 2>/dev/null || echo 0); n=$((n+1)); printf %s "$n" > "$SSH_STUB_COUNT"' \
    '[ "$n" -le "${SSH_STUB_FAIL:-1}" ] && exit "${SSH_STUB_RC:-124}"' \
    'printf %s "$SSH_STUB_OUT"' > "$_sd/ssh"
  chmod +x "$_sd/ssh"
  export SSH_STUB_COUNT="$_sd/n" SSH_STUB_OUT='{"percentage":42,"status":"CHARGING"}' \
         SSH_STUB_FAIL=1 SSH_STUB_RC=124 MESH_BODY_POWER_RETRY_SLEEP=0
  printf 0 > "$SSH_STUB_COUNT"
  _out="$( PATH="$_sd:$PATH"; read_battery_retry 1.2.3.4 )"
  [ "$(parse_battery "$_out")" = "42 CHARGING" ] || { echo "FAIL: a first-read miss must be RETRIED, not published as a dead body => '$_out'"; e=$((e+1)); }
  [ "$(cat "$SSH_STUB_COUNT")" = 2 ] || { echo "FAIL: the retry must issue exactly one extra read (issued $(cat "$SSH_STUB_COUNT"))"; e=$((e+1)); }
  printf 0 > "$SSH_STUB_COUNT"; SSH_STUB_FAIL=9
  _out="$( PATH="$_sd:$PATH"; read_battery_retry 1.2.3.4 )"; _rc=$?
  [ -z "$_out" ] || { echo "FAIL: a genuinely dead organ must render empty, not a value"; e=$((e+1)); }
  [ "$(cat "$SSH_STUB_COUNT")" = 2 ] || { echo "FAIL: the retry must be BOUNDED at one (issued $(cat "$SSH_STUB_COUNT"))"; e=$((e+1)); }
  [ "$_rc" = 124 ] || { echo "FAIL: the read's rc must survive the retry — it is the ONLY thing that names the layer (got $_rc)"; e=$((e+1)); }
  SSH_STUB_FAIL=1; rm -rf "$_sd"
  unset SSH_STUB_COUNT SSH_STUB_OUT SSH_STUB_FAIL SSH_STUB_RC MESH_BODY_POWER_RETRY_SLEEP
  # --- THE RUN LEDGER: dated, unconditional, boot-aware, and unforgeable by this very gate ---------
  # Driven against a SANDBOX ledger path, never the live one — the whole point of the file is that a
  # dry-run cannot write it, so a gate that wrote the real tape to prove it works would be the defect.
  _ld="$(mktemp -d)"; trap 'rm -rf "$_ld"' EXIT
  _real_LEDGER="$LEDGER"; _real_TS="${TS:-}"
  LEDGER="$_ld/ledger.log"; TS="2026-01-02T03:04:05Z"; MESH_BODY_POWER_ARGV="-"
  # (a) a READING row carries the level and the status verbatim
  ledger_row OK 66 DISCHARGING 0
  r="$(sed -n 1p "$LEDGER")"
  case "$r" in
    "2026-01-02T03:04:05Z OK level=66 status=DISCHARGING rc=0 boot="*" argv=- by="*) : ;;
    *) echo "FAIL: a reading row must carry ts/verdict/level/status/rc verbatim => '$r'"; e=$((e+1)) ;;
  esac
  # (b) ABSENT evidence renders `na` in every field — never 0, never an omitted column. An omitted
  #     field shifts every field after it, so a positional reader silently reads the NEXT value.
  ledger_row UNREACHABLE "" "" ""
  r="$(sed -n 2p "$LEDGER")"
  case "$r" in
    *" level=na status=na rc=na boot="*) : ;;
    *) echo "FAIL: absent evidence must render na in EVERY field, never 0 and never omitted => '$r'"; e=$((e+1)) ;;
  esac
  [ "$(awk '{print NF}' <<<"$r")" = "$(awk '{print NF}' <<<"$(sed -n 1p "$LEDGER")")" ] \
    || { echo "FAIL: an n/a row and a reading row must have the SAME field count (positional readers)"; e=$((e+1)); }
  # (c) EVERY n/a cause reaches the ledger with its OWN word. The cause map is the single source, so
  #     this walks na_state's whole cause set rather than a copy of it — a seventh cause added there
  #     and forgotten here shows up as a bare UNREADABLE, not as a silent hole.
  : > "$LEDGER"
  for _c in no-ip ssh read-timeout empty-read no-organ parse; do
    ledger_row "$(printf '%s' "$(na_state "$_c" T)" | cut -d'|' -f1)" "" "" ""
  done
  [ "$(wc -l < "$LEDGER")" -eq 6 ] || { echo "FAIL: every n/a cause must write exactly one ledger row"; e=$((e+1)); }
  _w="$(awk '{print $2}' "$LEDGER" | sort -u | tr '\n' ',')"
  [ "$_w" = "SENSOR-DARK,TIMEOUT,UNREACHABLE,UNREADABLE," ] \
    || { echo "FAIL: the ledger must carry the cause map's own verdict WORDS => '$_w'"; e=$((e+1)); }
  # (d) BOOT ID — the field that forbids differencing across a power-off. It must be THIS boot's, not
  #     a constant: a fabricated id re-joins the two sides of the gap it exists to mark.
  _lb="$(awk 'NR==1{for(i=1;i<=NF;i++) if($i ~ /^boot=/){sub(/^boot=/,"",$i); print $i}}' "$LEDGER")"
  _kb="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '-' | cut -c1-8)"
  if [ -n "$_kb" ]; then
    [ "$_lb" = "$_kb" ] || { echo "FAIL: the ledger's boot id must be THIS boot's ('$_lb' vs kernel '$_kb')"; e=$((e+1)); }
  else
    [ "$_lb" = na ] || { echo "FAIL: an unreadable boot id must render na, never a constant => '$_lb'"; e=$((e+1)); }
  fi
  # (e) SUPPRESSION is what makes the forgery gate below possible at all: an empty LEDGER writes
  #     nothing AND still returns success, so a suppressed run cannot be mistaken for a failed one.
  #     HOME is sandboxed for this arm too: a suppression that silently FELL BACK to the real default
  #     path would leave this ledger unchanged and read as compliance, while writing the live tape.
  #     The assertion is that NOTHING under the sandbox home appears, not that one named file held.
  _before="$(wc -l < "$LEDGER")"
  mkdir -p "$_ld/home/.mesh"
  ( HOME="$_ld/home"; LEDGER=""; ledger_row OK 50 CHARGING 0 ) \
    || { echo "FAIL: a suppressed ledger write must still succeed"; e=$((e+1)); }
  [ "$(wc -l < "$LEDGER")" -eq "$_before" ] || { echo "FAIL: an empty LEDGER must write NO row"; e=$((e+1)); }
  _leak="$(find "$_ld/home" -type f 2>/dev/null | wc -l)"
  [ "$_leak" -eq 0 ] \
    || { echo "FAIL: an empty LEDGER must write NOWHERE — a fallback to the default path wrote $_leak file(s)"; e=$((e+1)); }
  # (f) WIRING — the arms above prove ledger_row WRITES; none of them proves anything CALLS it.
  #     Testing the parts is not testing the wiring: with every assertion above green, deleting the
  #     call from na_out leaves the n/a path — the majority of this reflex's ticks — writing nothing
  #     at all. So drive the REAL na_out in a sandbox and assert a row lands. It exits 2 by contract,
  #     which is why it runs in a subshell. [[passing-a-test-and-being-wired-are-unrelated-facts]]
  : > "$LEDGER"
  ( STATE="$_ld/state"; OFFLINEFILE="$_ld/offline"; LAST=""; NA_RC=255
    na_out ssh "sandbox" >/dev/null 2>&1 )
  _n="$(wc -l < "$LEDGER" 2>/dev/null || echo 0)"
  [ "$_n" -eq 1 ] || { echo "FAIL: na_out must write exactly one ledger row (wrote $_n) — the n/a path is the MAJORITY of ticks"; e=$((e+1)); }
  case "$(sed -n 1p "$LEDGER")" in
    *" UNREACHABLE level=na status=na rc=255 "*) : ;;
    *) echo "FAIL: na_out's row must carry the cause's verdict word and the ssh rc => '$(sed -n 1p "$LEDGER")'"; e=$((e+1)) ;;
  esac
  #     A SECOND cause, whose word differs — one cause alone cannot tell "reads the cause map" from
  #     "hardcodes the word that cause happens to produce".
  : > "$LEDGER"
  ( STATE="$_ld/state"; OFFLINEFILE="$_ld/offline2"; LAST=""; NA_RC=124
    na_out read-timeout "sandbox" >/dev/null 2>&1 )
  [ "$(awk 'NR==1{print $2}' "$LEDGER")" = TIMEOUT ] \
    || { echo "FAIL: na_out must read the CAUSE MAP for its word, not hardcode one => '$(awk 'NR==1{print $2}' "$LEDGER")'"; e=$((e+1)); }
  LEDGER="$_real_LEDGER"; TS="$_real_TS"
  # (g) THE READING PATHS, END TO END. The n/a wiring arm above cannot reach them: OK and LOW are
  #     decided after a real battery number, and the live-read arm below cannot choose that number.
  #     So drive the WHOLE tool as a subprocess against a stubbed body, once per branch. The stubs are
  #     found because the tool prepends $HOME/.local/bin to PATH and HOME is the sandbox — the same
  #     trick the retry arm above uses, with the home faked too so the ledger, state and armfile all
  #     land inside the sandbox and the live tape is untouched.
  #     Without this the LOW branch is a call site nothing exercises: a battery low enough to drive it
  #     is exactly the tick nobody wants to wait for, which is how such a site stays unwired for good.
  _fh="$_ld/fakehome"; mkdir -p "$_fh/.local/bin" "$_fh/.mesh"
  printf '%s\n' '#!/usr/bin/env bash' 'printf 1.2.3.4' > "$_fh/.local/bin/mesh-phone-ip"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0'          > "$_fh/.local/bin/mesh-state-touch"
  printf '%s\n' '#!/usr/bin/env bash' 'printf %s "$SSH_STUB_OUT"' > "$_fh/.local/bin/ssh"
  chmod +x "$_fh/.local/bin/mesh-phone-ip" "$_fh/.local/bin/mesh-state-touch" "$_fh/.local/bin/ssh"
  _drive() { # <fixture-json> → run the real tool against a stubbed body; echo its ledger's last row
    env -u MESH_BODY_POWER_ARGV HOME="$_fh" PATH="$_fh/.local/bin:/usr/bin:/bin" \
        MESH_ALERT_DRYRUN=1 SSH_STUB_OUT="$1" bash "$0" >/dev/null 2>&1
    tail -1 "$_fh/.mesh/body-power-readings.log" 2>/dev/null
  }
  _r="$(_drive '{"percentage":66,"status":"DISCHARGING"}')"
  case "$_r" in
    *" OK level=66 status=DISCHARGING rc=0 boot="*) : ;;
    *) echo "FAIL: the OK reading path must write its own ledger row => '$_r'"; e=$((e+1)) ;;
  esac
  _r="$(_drive '{"percentage":5,"status":"DISCHARGING"}')"
  case "$_r" in
    *" LOW level=5 status=DISCHARGING rc=0 boot="*) : ;;
    *) echo "FAIL: the LOW reading path must write its own ledger row => '$_r'"; e=$((e+1)) ;;
  esac
  #     THE DENOMINATOR: three drives, three rows. A tape that skips a branch is a numerator, and the
  #     branch it skips is invisible to every rate computed from it.
  _r="$(_drive '{"percentage":80,"status":"CHARGING"}')"
  _n="$(wc -l < "$_fh/.mesh/body-power-readings.log")"
  [ "$_n" -eq 3 ] || { echo "FAIL: every run must write exactly one row — 3 drives left $_n row(s)"; e=$((e+1)); }
  #     And the rows must be DATED with a real clock, not the frozen fixture stamp the arms above use.
  awk 'NR==1{exit ($1 ~ /^20[0-9][0-9]-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z$/) ? 0 : 1}' \
      "$_fh/.mesh/body-power-readings.log" \
    || { echo "FAIL: a ledger row must open with a real ISO-8601 UTC stamp — the time axis IS the point"; e=$((e+1)); }

  # (h) --rate: the tape's reader. A tape nobody reads is a file, not an instrument — and the three
  #     refusals below are the reason it exists rather than a bare `grep -c`.
  _rl="$_fh/.mesh/rate.log"; mkdir -p "$_fh/.mesh"
  _rate() { env HOME="$_fh" PATH="/usr/bin:/bin" bash "$0" --rate 2>&1; }
  rm -f "$_fh/.mesh/body-power-readings.log"
  _r="$(_rate)"; _rc=$?
  case "$_r" in *UNKNOWN*) : ;; *) echo "FAIL: an absent ledger must render UNKNOWN, never a rate => '$_r'"; e=$((e+1)) ;; esac
  [ "$_rc" -eq 2 ] || { echo "FAIL: an absent ledger must exit 2, not 0 (got $_rc)"; e=$((e+1)); }
  #     ONE row is not a rate either — a single point has no interval.
  printf '2026-01-01T00:00:00Z OK level=50 status=DISCHARGING rc=0 boot=aaaa argv=- by=cron\n' > "$_fh/.mesh/body-power-readings.log"
  _r="$(_rate)"
  case "$_r" in *UNKNOWN*) : ;; *) echo "FAIL: a one-row ledger must render UNKNOWN, never a 100% rate => '$_r'"; e=$((e+1)) ;; esac
  #     BOOTS ARE COUNTED AND SAID OUT LOUD: rows spanning a power-off must not read as one run.
  cat > "$_fh/.mesh/body-power-readings.log" <<'_EOF_'
2026-01-01T00:00:00Z OK level=50 status=DISCHARGING rc=0 boot=aaaa argv=- by=cron
2026-01-01T00:10:00Z UNREACHABLE level=na status=na rc=255 boot=aaaa argv=- by=cron
2026-01-01T09:00:00Z OK level=90 status=CHARGING rc=0 boot=bbbb argv=- by=cron
2026-01-01T09:10:00Z OK level=91 status=CHARGING rc=0 boot=bbbb argv=- by=cron
_EOF_
  _r="$(_rate)"
  case "$_r" in *"3/4 CRON tick(s) (75.0%)"*) : ;; *) echo "FAIL: --rate must count reachable ticks over the rows it HOLDS => '$_r'"; e=$((e+1)) ;; esac
  case "$_r" in *"across 2 boot(s)"*) : ;; *) echo "FAIL: --rate must NAME the boot count — a span crossing a power-off is not one run => '$_r'"; e=$((e+1)) ;; esac
  #     A HAND-DRIVEN read is a real reading but not a tick; folding it in inflates the denominator.
  printf '2026-01-01T09:20:00Z OK level=92 status=CHARGING rc=0 boot=bbbb argv=--status by=cron\n' >> "$_fh/.mesh/body-power-readings.log"
  _r="$(_rate)"
  case "$_r" in *"3/4 CRON tick(s)"*"1 --status read(s) excluded"*) : ;;
    *) echo "FAIL: a --status read must be excluded from the cadence denominator and counted apart => '$_r'"; e=$((e+1)) ;; esac
  #     THE LAUNCHER SPLIT. A bare hand run wears the same argv as a cron tick; only `by=` separates
  #     them, and folding one in inflates the denominator with runs nobody scheduled. The three
  #     non-cron classes are counted APART, never silently as ticks and never as zero.
  cat > "$_fh/.mesh/body-power-readings.log" <<'_EOF_'
2026-01-01T00:00:00Z OK level=50 status=DISCHARGING rc=0 boot=aaaa argv=- by=cron
2026-01-01T00:10:00Z UNREACHABLE level=na status=na rc=255 boot=aaaa argv=- by=cron
2026-01-01T00:11:00Z OK level=51 status=DISCHARGING rc=0 boot=aaaa argv=- by=bash
2026-01-01T00:12:00Z OK level=52 status=DISCHARGING rc=0 boot=aaaa argv=- by=na
2026-01-01T00:13:00Z OK level=53 status=DISCHARGING rc=0 boot=aaaa argv=-
_EOF_
  _r="$(_rate)"
  case "$_r" in *"1/2 CRON tick(s) (50.0%)"*) : ;;
    *) echo "FAIL: only by=cron rows may be cadence ticks => '$_r'"; e=$((e+1)) ;; esac
  case "$_r" in *"1 hand run(s) excluded"*) : ;;
    *) echo "FAIL: a bare HAND RUN wears a cron row's argv — only by= separates them => '$_r'"; e=$((e+1)) ;; esac
  case "$_r" in *"1 row(s) whose launcher was unreadable, excluded"*) : ;;
    *) echo "FAIL: an unreadable launcher must be counted apart, never assumed to be a tick => '$_r'"; e=$((e+1)) ;; esac
  case "$_r" in *"1 pre-launcher-field row(s) excluded"*) : ;;
    *) echo "FAIL: a row written before the launcher field existed must be counted apart => '$_r'"; e=$((e+1)) ;; esac
  #     And the field must be the REAL parent, not a constant: this gate's own rows are launched by
  #     the shell running it, so a hardcoded `cron` would show up here.
  #     NOTE THE ORDER. This arm first read `: > "$LEDGER"; LEDGER="$_ld/lb.log"` — the truncate ran
  #     while LEDGER still pointed at the DURABLE tape, and it deleted every row the live ledger held.
  #     The forgery gate caught it as "grew by -1 row(s)", which is why that gate compares counts in
  #     BOTH directions and not just for growth: a dry run that ERASES the record is the same defect
  #     as one that writes it. Assign the sandbox path first; never write through $LEDGER while it is
  #     the real one.
  LEDGER="$_ld/lb.log"; : > "$LEDGER"; ledger_row OK 1 X 0
  _lby="$(awk 'NR==1{for(i=1;i<=NF;i++) if($i ~ /^by=/){sub(/^by=/,"",$i); print $i}}' "$_ld/lb.log")"
  [ "$_lby" != cron ] || { echo "FAIL: by= must be the REAL parent comm — this gate is not launched by cron"; e=$((e+1)); }
  [ -n "$_lby" ] || { echo "FAIL: by= must always be present (na when /proc will not say)"; e=$((e+1)); }
  LEDGER="$_real_LEDGER"
  rm -f "$_fh/.mesh/body-power-readings.log"

  # (i) THE FORGERY GATE, asserted on the LIVE tape: this `--test` must not have grown the durable
  #     ledger by so much as a line — including the live-read arm below it, which drives the same
  #     read_battery_retry the read path uses but must reach no writer. Counted around the whole gate
  #     by the wrapper in `--test-ledger-forgery`; here we assert the invariant this run depends on:
  #     nothing above this line ever assigned the real LEDGER a row.
  [ "$LEDGER" = "$_real_LEDGER" ] || { echo "FAIL: the gate must restore the live LEDGER path"; e=$((e+1)); }
  rm -rf "$_ld"; trap - EXIT

  # The failure count is read HERE, after every arm above — placed before them it made each new arm a
  # gate that could print FAIL and still exit 0. A gate you have not seen FAIL is not a gate.
  [ "$e" -eq 0 ] || { echo "smoke: FAIL ($e fail(s))"; exit 1; }
  NA=101

  # REAL-READ GATE (doctrine: --test must assert a live read PRODUCES data, not just that the
  # offline classifier compiles — that hollow gap is the mesh-mag/mesh-gyro dead-but-green class:
  # a synthetic-fixture-only --test stays green forever even if the live SSH/JSON pipeline breaks).
  # Honest contract: real numeric percentage => ok(0); unreachable/empty => n/a(2), never FAIL.
  # It drives read_battery_retry — the SAME call the read path makes, so the gate exercises the
  # retry it is meant to cover rather than a second invocation nothing uses.
  tpip="$(mesh-phone-ip 2>/dev/null)" || tpip=""
  [ -n "$tpip" ] || { echo "smoke: ok ($NA fixture/cause-map assertions); n/a live read (no phone IP — link down)"; exit 2; }
  tj="$(read_battery_retry "$tpip")"; trc=$?
  [ -n "$tj" ] || { echo "smoke: ok ($NA fixture/cause-map assertions); n/a live read (empty after retry, rc=$trc — link down, organ silent, or read expired; mesh-phone-ip can return a stale cached IP even when the phone is offline)"; exit 2; }
  tr="$(parse_battery "$tj")"
  [ -n "$tr" ] || { echo "smoke: FAIL (live read returned bytes but no usable percentage: $tj)"; exit 1; }
  echo "smoke: ok ($NA fixture/cause-map assertions + live read: ${tr%% *}% ${tr#* })"; exit 0
fi

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# argv rides in the row so a consumer computing a CADENCE can exclude hand-driven reads: a `--status`
# a human typed is a real reading but not a tick, and folding it into a rate inflates the denominator.
MESH_BODY_POWER_ARGV="${1:--}"
LAST="$(prev_reading "$(cat "$STATE" 2>/dev/null || true)")"

pip="$(mesh-phone-ip 2>/dev/null)" || pip=""
[ -n "$pip" ] || na_out no-ip "UNREACHABLE — no phone IP, the LINK is down (says nothing about the battery organ; not an alarm)"

j="$(read_battery_retry "$pip")"; rrc=$?
if [ -z "$j" ]; then
  # The layer is read off the RETURN CODE, not guessed. Each of these used to write the same word.
  NA_RC="$rrc"
  case "$rrc" in
    124) na_out read-timeout "TIMEOUT — the battery read expired twice; link vs organ undecidable from here (not an alarm)" ;;
    255) na_out ssh         "UNREACHABLE — ssh transport failed, the LINK is down (not an alarm)" ;;
    127) na_out no-organ    "SENSOR-DARK — the phone ANSWERED but termux-battery-status is not installed (not an alarm)" ;;
    *)   na_out empty-read  "SENSOR-DARK — the phone IS reachable and its battery organ returned nothing after a retry (not an alarm)" ;;
  esac
fi
rm -f "$OFFLINEFILE"

read -r level status < <(parse_battery "$j")
[ -n "${level:-}" ] || na_out parse "UNREADABLE — bytes arrived but carried no usable percentage (not an alarm)"

if [ "${1:-}" = --status ]; then
  ledger_row READ "$level" "$status" 0
  echo "body battery: ${level}% ${status}"; exit 0
fi

# ADAPTIVITY GAP (Di Paolo, *Autopoiesis, Adaptivity, Teleology, Agency*, Phenomenology & the
# Cognitive Sciences 2005; live in enactivism 2024/2025): bare autopoiesis is ALL-OR-NOTHING —
# a system is viable or it disintegrates, with NO graded appreciation of *heading toward* the
# boundary. Di Paolo's adaptivity is the added capacity to monitor viability as a GRADED TENDENCY
# and regulate it BEFORE the edge — the property that grounds intrinsic concern/teleology (bare
# self-production cannot, because it only "knows" the all-or-nothing fact of still existing).
# This alarm is exactly the all-or-nothing case: it fires only as `level` crosses the FIXED 20%
# boundary, and it reads $STATE for the LABEL (OK/LOW) ONLY — never the prior (level, time), so it
# has NO discharge RATE / projected time-to-empty, which is the adaptive signal. It bites HERE
# above all: the body is the highest-stakes, near-IRREVERSIBLE viability variable (an away operator
# can't recharge it; a dead body = days of lost senses/actuators). Under fast discharge (the phone
# runs hot/overloaded — [[phone-wg-channel-replace-tailscale]]) 20% can mean <1h of runway → the
# single boundary alarm is too LATE to act on; a slow trickle at 19% fires the same alarm need-
# lessly. The RATE is the urgency, and it is unmeasured. The mesh DOES embody adaptivity elsewhere:
# mesh-homeostasis is an I-controller accumulating GRADED error on the egress invariant, escalating
# before catastrophe — body-power is its un-adapted sibling.
# HELD FIX (steward lands — behavioral): persist (level, epoch) in $STATE; difference across the
# */10 reads → discharge rate → projected time-to-empty; alarm on a GRADED runway margin (e.g.
# projected <Xh) in addition to the fixed %. Held because alarm-tuning is the cry-wolf class —
# instrument-first (log the rate, confirm it LEADS real lows) before touching the alarm.
# See [[liveness-is-lease-not-cached-status]] (a graded margin beats a cached binary flag).
low="$(classify_low "$level" "$status")"
alert(){ # MESH_ALERT_DRYRUN=1 → print, don't send (safe testing of the alarm path; learned the hard way)
         if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] would alert: $2" >&2; return; fi
         command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$1" >/dev/null 2>&1
         command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="body-power@$(hostname)" mesh-chat "$2" >/dev/null 2>&1; }

# The alarm EDGE is read from $ARMFILE, not from the label in $STATE. The label still records what the
# last confirmed reading WAS ($LAST, which n/a lines carry through); it no longer doubles as "is an
# alarm outstanding", because the label legitimately reads OK on a body that is still draining just
# above the threshold — and that conflation is exactly what let a jitter cancel and re-arm the alarm.
armed=0; [ -f "$ARMFILE" ] && armed=1
verdict="$(edge_verdict "$armed" "$low" "$(classify_recovered "$status")")"

if [ "$low" = 1 ]; then
  ok_state LOW "$level" "$status" "$TS" > "$STATE"
  ledger_row LOW "$level" "$status" 0
  if [ "$verdict" = alarm ]; then
    printf '%s %s\n' "$TS" "$level" > "$ARMFILE"
    alert "🔋 Phone (the mesh's body) at ${level}% and discharging — plug it in to keep its senses/voice online." \
          "[body-power-low] phone ${level}% discharging — body will go offline if not charged."
  fi
  echo "body-power: LOW ${level}%"; exit 1
fi

ok_state OK "$level" "$status" "$TS" > "$STATE"
ledger_row OK "$level" "$status" 0
case "$verdict" in
  recover)
    rm -f "$ARMFILE"
    alert "✅ Phone (mesh body) on power again at ${level}% (${status}) — body power recovered." \
          "[body-power-ok] phone ${level}% ${status} — body power recovered."
    ;;
  hold)
    # Above the threshold but STILL not on power: the alarm stays outstanding and SILENT. Loud enough
    # to read in the log, never a second poke — the operator was already told once and nothing changed.
    echo "body-power: ok ${level}% ${status} — alarm still ARMED (above ${THRESH}% but not on power)"
    exit 0
    ;;
esac
echo "body-power: ok ${level}% ${status}"; exit 0
