#!/usr/bin/env bash
# mesh-weather — outdoor thermal FORECAST sense: the fleet's binding constraint (heat) gets a forecast.
#
# WHY (spec: ~/.mesh/knowledge/capability-weather-thermal-forecast-20260705.md, discover 2026-07-05):
# every thermal defense is REACTIVE (mesh-therm-watch tiers on the CURRENT temp) while thermal is THE
# binding fleet constraint — IdeaPad throttles 93–97°C under mind load, ds freeze-reboots at 88–90°C,
# the operator moved minds to phaedra explicitly for heat. This sense makes a thermal DAY predictable
# at MORNING, so shedding/offload can happen before the 15:00 peak, not during it.
#
#   mesh-weather           hourly cron: open-meteo fetch → tape 'weather now_c= today_max_c=
#                          peak_hour= thermal_day=' + state; ONE [fyi] board flag per calendar day
#                          when thermal_day=1 first detected (edge, not a repeat)
#   mesh-weather --status  current state line, no fetch
#   mesh-weather --test    fixture parse/flag/edge/BLIND assertions + live real-read gate
#                          (exit 2 honest-n/a while ~/.mesh/weather.env is unseeded or offline)
#
# Config (PRIVACY — hard constraint): coordinates live ONLY in gitignored ~/.mesh/weather.env
# (MESH_WEATHER_LAT / MESH_WEATHER_LON, city-level 2 decimals suffices), NEVER this file — the
# genome origin is public ([[genome-origin-public-dont-push]]). Optional MESH_WEATHER_THERMAL_C
# (default 28) = today_max threshold flagging a thermal day (calibrate later vs therm-watch history).
#
# Honest exits: unseeded coords OR fetch/parse failure → exit 2, state UNTOUCHED (offline ≠ mild
# day, never a faked all-clear). Liveness-touch every successful pass. Consumers: mesh-therm-watch
# preemptive tier, minds allocation (prefer phaedra on thermal days), node-care forensics.
#
# reflex-cadence: 23 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.weather-state"
FLAGGED="$STATE_DIR/.weather-flagged"          # calendar date of the last thermal-day board flag
TAPE="${MESH_WEATHER_TAPE:-$STATE_DIR/weather.log}"
ENVF="${MESH_WEATHER_ENV:-$STATE_DIR/weather.env}"
CHAT="${MESH_WEATHER_CHAT:-1}"
SRC="${MESH_WEATHER_SRC:-}"                    # test fixture: open-meteo JSON file
THERMAL_C_DEFAULT=28

mkdir -p "$STATE_DIR"
TS="$(date -u +%FT%TZ)"
TODAY="$(date +%F)"

[ -f "$ENVF" ] && . "$ENVF" 2>/dev/null
LAT="${MESH_WEATHER_LAT:-}"; LON="${MESH_WEATHER_LON:-}"
THERMAL_C="${MESH_WEATHER_THERMAL_C:-$THERMAL_C_DEFAULT}"

fetch(){ # open-meteo hourly JSON for today; empty on failure
  if [ -n "$SRC" ]; then cat "$SRC" 2>/dev/null
  else curl -s -m 15 "https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&hourly=temperature_2m&forecast_days=1&timezone=auto" 2>/dev/null
  fi
}

parse_weather(){ # stdin: open-meteo JSON; $1=local hour (0-23) → "now_c today_max_c peak_hour"; rc 1 unparseable
  python3 -c '
import json, sys
hour = int(sys.argv[1])
try:
    d = json.load(sys.stdin)
    temps = d["hourly"]["temperature_2m"]
    assert len(temps) >= 24 and all(t is not None for t in temps[:24])
except Exception:
    sys.exit(1)
temps = temps[:24]
peak = max(range(24), key=lambda i: temps[i])
print(f"{temps[min(hour,23)]:.1f} {max(temps):.1f} {peak}")
' "$1" 2>/dev/null
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  _td="$(mktemp -d)"; _fx="$_td/openmeteo.json"
  python3 -c '
import json
temps = [18.0 + (0.9 * i if i <= 15 else -(0.8 * (i - 15))) for i in range(24)]  # peak 31.5 @ h15
print(json.dumps({"hourly": {"time": [f"2026-07-05T{h:02d}:00" for h in range(24)], "temperature_2m": temps}}))
' > "$_fx"
  # parser: now at h10 = 27.0, max 31.5, peak hour 15
  read -r n m p < <(parse_weather 10 < "$_fx")
  { [ "$n" = 27.0 ] && [ "$m" = 31.5 ] && [ "$p" = 15 ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (parser: now=$n max=$m peak=$p, want 27.0/31.5/15)"; exit 1; }
  # full pass on fixture: thermal_day=1 (31.5 ≥ 28) taped + state + ONE flag, second run no re-flag
  _env="MESH_STATE_DIR=$_td MESH_WEATHER_SRC=$_fx MESH_WEATHER_CHAT=0 MESH_WEATHER_ENV=$_td/weather.env MESH_WEATHER_TAPE=$_td/weather.log"
  printf 'MESH_WEATHER_LAT=0.00\nMESH_WEATHER_LON=0.00\n' > "$_td/weather.env"
  out="$(env $_env "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && grep -qE 'weather now_c=[0-9.]+ today_max_c=31.5 peak_hour=15 thermal_day=1' "$_td/weather.log" \
      && grep -q 'thermal_day=1' "$_td/.weather-state" && printf '%s' "$out" | grep -q 'thermal-day'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (thermal fixture pass: rc=$rc out='$out' tape='$(cat "$_td/weather.log" 2>/dev/null)')"; exit 1; }
  out="$(env $_env "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -q 'thermal-day'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (same-day re-run must not re-flag: rc=$rc out='$out')"; exit 1; }
  # mild fixture: thermal_day=0, no flag
  python3 -c '
import json
print(json.dumps({"hourly": {"temperature_2m": [12.0 + 0.3*i for i in range(24)]}}))
' > "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && grep -q 'thermal_day=0' "$_td/.weather-state" && ! printf '%s' "$out" | grep -q 'thermal-day'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (mild day must be thermal_day=0, no flag: rc=$rc)"; exit 1; }
  # BLIND: unparseable fetch → exit 2, state untouched
  echo 'not json' > "$_fx"
  st_before="$(cat "$_td/.weather-state")"
  env $_env "$0" >/dev/null 2>&1; rc=$?
  { [ "$rc" = 2 ] && [ "$(cat "$_td/.weather-state")" = "$st_before" ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (BLIND must exit 2 + not touch state: rc=$rc)"; exit 1; }
  # UNSEEDED: no coords → exit 2 (never a guess)
  rm -f "$_td/weather.env"
  env MESH_STATE_DIR="$_td" MESH_WEATHER_CHAT=0 MESH_WEATHER_ENV="$_td/weather.env" MESH_WEATHER_TAPE="$_td/weather.log" MESH_WEATHER_LAT= MESH_WEATHER_LON= "$0" >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { rm -rf "$_td"; echo "smoke-test: FAIL (unseeded coords must exit 2: rc=$rc)"; exit 1; }
  rm -rf "$_td"
  # REAL-read gate (verification principle): with seeded coords the LIVE fetch must parse; unseeded
  # is honest-n/a (operator seeds ~/.mesh/weather.env), offline likewise — never a fake green.
  if [ -z "$LAT" ] || [ -z "$LON" ]; then
    echo "smoke-test: n/a (fixtures ok; ~/.mesh/weather.env unseeded — operator: set MESH_WEATHER_LAT/MESH_WEATHER_LON, city-level 2 decimals)"; exit 2
  fi
  if fetch | parse_weather "$(date +%-H)" >/dev/null; then
    echo "smoke-test: ok (fixtures + live open-meteo fetch parsed for seeded coords)"; exit 0
  else
    echo "smoke-test: n/a (fixtures ok; live open-meteo fetch failed — offline or API unreachable)"; exit 2
  fi
fi

if [ "${1:-}" = --status ]; then
  [ -r "$STATE" ] && cat "$STATE" || echo "mesh-weather: no state yet"
  exit 0
fi

if [ -z "$LAT" ] || [ -z "$LON" ]; then
  echo "mesh-weather: n/a — coords unseeded; operator: put MESH_WEATHER_LAT/MESH_WEATHER_LON in $ENVF (gitignored, 2-decimal city precision)" >&2
  exit 2
fi

hour="$(date +%-H)"
read -r now_c max_c peak_h < <(fetch | parse_weather "$hour") || true
if [ -z "${now_c:-}" ] || [ -z "${max_c:-}" ]; then
  echo "mesh-weather: BLIND (open-meteo fetch/parse failed — offline ≠ mild day)" >&2
  exit 2
fi

thermal=0
awk -v m="$max_c" -v t="$THERMAL_C" 'BEGIN{exit !(m >= t)}' && thermal=1
printf '%s weather now_c=%s today_max_c=%s peak_hour=%s thermal_day=%s\n' "$TS" "$now_c" "$max_c" "$peak_h" "$thermal" >> "$TAPE"
printf 'OK %s now_c=%s today_max_c=%s peak_hour=%s thermal_day=%s thresh_c=%s\n' "$TS" "$now_c" "$max_c" "$peak_h" "$thermal" "$THERMAL_C" > "$STATE"
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true

# ONE board flag per calendar day, on the first thermal_day=1 reading (usually the morning run) —
# the preemptive signal the spec exists for. Consumers do the actual shedding; this is the heads-up.
if [ "$thermal" = 1 ] && [ "$(cat "$FLAGGED" 2>/dev/null)" != "$TODAY" ]; then
  printf '%s\n' "$TODAY" > "$FLAGGED"
  echo "[thermal-day] today peaks ${max_c}°C at ~${peak_h}:00 (threshold ${THERMAL_C}°C) — shed/offload heavy minds to phaedra BEFORE the peak"
  [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1 && \
    MESH_WHO="weather@$(hostname)" mesh-chat "[fyi] mesh-weather: THERMAL DAY — outdoor peak ${max_c}°C at ~${peak_h}:00 (≥${THERMAL_C}°C threshold). Preemptive: prefer phaedra for heavy dispatch today; IdeaPad/ds throttle risk before the 15:00 indoor lag peak." >/dev/null 2>&1 || true
fi

echo "mesh-weather: now ${now_c}°C, today max ${max_c}°C @ ${peak_h}:00, thermal_day=$thermal"
exit 0
