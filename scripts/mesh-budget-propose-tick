#!/usr/bin/env bash
# mesh-budget-propose-tick — the CADENCE `mesh-budget --propose` never had.
#
# THE LEAK (witness, {#68035ef9}, 2026-08-25): `mesh-budget --sample` is wired 3-59/5 and books the
# accumulators every five minutes, but `--propose` — the step that turns those samples into a number a
# human can arm — was scheduled NOWHERE. The measured cap could only ever be read when a mind HAPPENED
# to look AND the node HAPPENED to be holding 24/24 sampled hours in the trailing 24h. At 62.6% uptime
# that coincidence is rare, and it is exactly why {#abf39f5a} aged 89h through three pickups: nobody
# was neglecting it, the two windows simply never overlapped. A step everything downstream depends on
# must have its own unconditional cadence and must not ride a path that only fires when something else
# did. This tool IS that cadence, and nothing else.
#
# WHAT IT IS NOT. It arms nothing — not one byte of budget.conf is written here, and the caps stay in
# the operator's hands (his rule: numbers only after a day of measurement). It also does not decide
# ripeness: it CALLS `mesh-budget --propose` and reads what came back. A private copy of the 24/24
# coverage arithmetic would be a second predicate free to rot away from the one the tool actually uses
# — a lint whose predicate is not the parser's own predicate is not a guard on that parser.
#
# HOW THE OUTPUT IS READ — positively on BOTH sides, never by fall-through. An axis line counts as
# REFUSING only if it says so in mesh-budget's own words, and as PROPOSING only if it carries that
# axis's cap-assignment token (FRAMES_PER_HOUR= / GPU_MIN_PER_DAY=). Anything else is UNPARSED, and an
# unparsed run is UNKNOWN: it posts nothing, leaves the state file untouched and exits non-zero. The
# alternative — "not refusing, therefore proposing" — would turn any future rewording of the refusal
# into a confident recommendation of a number nobody measured, and the opposite default ("not
# proposing, therefore refusing") would make a reworded PROPOSAL into permanent silence. Both failure
# directions are silent, so neither is available: the reading must be affirmed or it is unknown.
#
# WHY IT ONLY SPEAKS ON A TRANSITION. Posting every tick would make this the board's loudest reflex
# and the recommendation would be scrolled past exactly like the silence it replaces. It posts when the
# set of PROPOSING axes GAINS a member — the refusing->proposing edge — and then holds its tongue while
# that set is unchanged. It is an edge detector, NOT a one-shot latch: if coverage falls back below
# 24/24 the state resets, so a later re-ripening is a new edge and speaks again. That matters on a node
# at 62.6% uptime, where the window will close and reopen many times.
#
# THE TAPE IS NOT ONLY THE POSITIVES. Every run writes a row to its own ledger whether it spoke or not
# — verdict, the proposing set, the delta — so a reader can tell "ran and had nothing to say" from
# "never ran", which is the same distinction the board post exists to make about the cap itself.
# The state file is also touched on every successful eval: mtime is liveness, content is the
# change-gated write, and a change-gated writer that only touches mtime when the VALUE moves reads as
# dead to the mtime-aging watchdogs while it is perfectly alive.
#
# NOT A TRANSIENT TIMER, DELIBERATELY. senses armed a one-shot systemd --user timer against this exact
# leak on 2026-08-21T12:52Z; it was LoadState=not-found after the next reboot, with no journal row to
# say it had ever existed. A one-shot armed against a leak is itself a promise with no keeper. This
# carries a `# reflex-cadence:` header instead, so mesh-autowire plants it on any node that deploys it
# and `mesh-reflexes --apply` keeps it in crontab across reboots.
#
# CADENCE: hourly, because the predicate's own resolution is an HOUR. Coverage is counted in distinct
# sampled HOUR BUCKETS, so it cannot change between two ticks inside one hour; polling faster would
# walk the whole ledger repeatedly to re-derive a number that provably has not moved. :17 keeps it off
# the phase of --sample (3-59/5) and of the other hourly reflexes.
#
# Env: MESH_DIR · MESH_BUDGET_PROPOSE_BIN (default mesh-budget) · MESH_BUDGET_TICK_LEDGER ·
#      MESH_BUDGET_TICK_STATE · MESH_BUDGET_TICK_CHAT (default mesh-chat)
#
# reflex-cadence: 17 * * * *
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
BIN="${MESH_BUDGET_PROPOSE_BIN:-mesh-budget}"
# NOT budget-propose-tick.log: mesh-autowire redirects a wired reflex's stdout to
# $HOME/.mesh/<tool>.log, so a ledger under that name would have every tick's chatter appended into
# the very tape a reader parses for edges — the run-log and the artifact must not be one file.
LEDGER="${MESH_BUDGET_TICK_LEDGER:-$MESH/budget-propose-tick-edges.log}"
STATE="${MESH_BUDGET_TICK_STATE:-$MESH/.budget-propose-tick.state}"
CHAT="${MESH_BUDGET_TICK_CHAT:-mesh-chat}"
AXES="frames gpu"

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
say(){ printf '%s  %s\n' "$(ts)" "$*" >> "$LEDGER" 2>/dev/null || true; printf '%s\n' "$*"; }

# The cap token each axis's PROPOSING line must carry. This is the affirmative half of the reading:
# a proposal is recognised by the assignment it is recommending, not by the absence of a refusal.
axis_token(){ case "$1" in frames) echo 'FRAMES_PER_HOUR=' ;; gpu) echo 'GPU_MIN_PER_DAY=' ;; esac; }

# axis_verdict <axis> <<< propose-output  ->  proposing | refusing | unparsed
axis_verdict(){
  local axis="$1" line tok
  tok="$(axis_token "$axis")"
  line="$(grep -m1 "^  $axis:" 2>/dev/null)"
  [ -n "$line" ] || { echo unparsed; return; }
  case "$line" in
    *"REFUSED to propose"*) echo refusing ;;
    *"$tok"*)               echo proposing ;;
    *)                      echo unparsed ;;
  esac
}

main(){
  mkdir -p "$MESH" 2>/dev/null
  local out rc
  out="$("$BIN" --propose 2>&1)"; rc=$?
  if [ "$rc" != 0 ]; then
    say "UNKNOWN reason=propose-rc=$rc bin=$BIN — the ripeness predicate could not be consulted; state untouched, nothing posted"
    return 1
  fi

  local axis v now="" unparsed=""
  for axis in $AXES; do
    v="$(printf '%s\n' "$out" | axis_verdict "$axis")"
    case "$v" in
      proposing) now="${now:+$now }$axis" ;;
      unparsed)  unparsed="${unparsed:+$unparsed }$axis" ;;
    esac
  done
  if [ -n "$unparsed" ]; then
    say "UNKNOWN reason=unparsed-axis-line axes=$unparsed bin=$BIN — mesh-budget answered but not in a shape this reader can affirm either way; state untouched, nothing posted"
    return 1
  fi

  local prev; prev="$(cat "$STATE" 2>/dev/null)"; prev="${prev:--}"
  local cur="${now:--}"

  # The EDGE: an axis that is proposing now and was not in the last recorded set.
  local gained=""
  for axis in $now; do
    case " $prev " in *" $axis "*) : ;; *) gained="${gained:+$gained }$axis" ;; esac
  done

  # State first, unconditionally on a parsed run: if the post below fails, the next tick must not
  # re-post the same edge forever. The write is unconditional rather than gated on a value change, so
  # mtime moves on EVERY successful eval and the mtime-aging watchdogs read a long-stable set as alive
  # instead of as a dead reflex — no mesh-state-touch is needed here precisely because of that, and
  # adding one would only paper over a change-gated write this deliberately does not do.
  printf '%s\n' "$cur" > "$STATE" 2>/dev/null || true

  if [ -z "$gained" ]; then
    say "quiet set=$cur prev=$prev — no refusing->proposing edge this tick"
    return 0
  fi

  # The proposal lines themselves, verbatim from the tool that measured them — minus backticks, which
  # mesh-chat evaluates as a command substitution in the message it is handed. mesh-budget's own paid
  # line quotes a command in backticks, so passing its text through unfiltered would execute it.
  # ONE LINE. The board is line-oriented — every scan, every tail and every promise-ledger parse reads
  # a post as a row — so the axis lines are joined rather than kept as the paragraph --propose prints.
  local body; body="$(printf '%s\n' "$out" | grep -E '^  (frames|gpu|paid):' | tr -d '`' \
    | sed 's/^  //' | paste -sd '@' - | sed 's/@/ · /g')"
  local msg
  msg="[fyi] mesh-budget: the measured cap is RIPE for $gained — a RECOMMENDATION to the operator, nothing is armed. \
This is the refusing->proposing edge: 24/24 sampled hours now exist in the trailing 24h, which on this node is a \
coincidence of two windows that rarely overlap, so the number is being surfaced the moment it becomes real rather \
than the next time a mind happens to look. What --propose measured: $body — TWO STANDING CAVEATS, carried verbatim because a cap armed without them is armed against the wrong quantity. \
(1) The frames number is a declared LOWER BOUND: only the mesh-cam-lock openers are counted — bruno-watch, eye, \
light, misha-wake — while cam-watch, the iMac cam and the phone cams are invisible to it, so the true aggregate is \
higher than the figure above and a cap armed at it will refuse organs that were never measured. (2) The paid axis is \
NOT proposed here at all: its cap is MESH_LABOR_BUDGET_USD, revised through mesh-labor --propose-cap and enforced by \
mesh-pace — a second authority over one axis in a second unit is the trap this tool refuses to fall into. \
Arming is the operator's: mesh-budget --propose prints it, budget.conf holds it, this reflex only tells you it exists."
  if command -v "$CHAT" >/dev/null 2>&1; then
    "$CHAT" "$msg" >/dev/null 2>&1 || true
    say "POSTED gained=$gained set=$cur prev=$prev"
  else
    say "POSTED-SKIPPED gained=$gained set=$cur prev=$prev — no $CHAT on PATH, the edge is recorded here only"
  fi
  return 0
}

# ---- test -------------------------------------------------------------------------------------
# RED-FIRST, and against the REAL mesh-budget wherever it can be: the whole point of this tool is that
# it does not carry its own copy of the ripeness rule, so a suite that drives a hand-written stub for
# the ripe/unripe legs would assert only this file's assumptions about a predicate living in another
# file. The fixtures are ledgers; the predicate under them is the production one.
do_test(){
  local e=0 SELF; SELF="$(readlink -f "$0")"
  # snapshot THIS node's own durable artifacts before anything runs (leg 10 proves we never wrote them)
  local rl="$MESH/budget-propose-tick-edges.log" rs="$MESH/.budget-propose-tick.state" real_before
  real_before="$(stat -c %Y-%s "$rl" "$rs" 2>/dev/null | tr '\n' ' ')"
  local td; td="$(mktemp -d)" || { echo "test: mktemp FAIL"; return 1; }
  trap 'rm -rf "$td"' RETURN
  local NOW="2026-08-24T12:00:00Z"

  # The partner under test is the one that ships BESIDE us — the copy being landed — falling back to
  # PATH. Which one ran is printed, so a green line can never hide that it drove a different binary.
  local bud; bud="$(dirname "$SELF")/mesh-budget"
  [ -x "$bud" ] || bud="$(command -v mesh-budget 2>/dev/null)"
  [ -x "$bud" ] || { echo "test: no mesh-budget to drive (neither beside $SELF nor on PATH) FAIL"; return 1; }

  # a fake home, so mesh-budget's ledger/conf AND this tool's ledger/state all land inside it and the
  # real ones on this node are untouchable by the suite.
  local fh="$td/home"; mkdir -p "$fh/.local/bin" "$fh/.mesh"
  ln -sf "$bud" "$fh/.local/bin/mesh-budget"
  # one CALL marker per invocation, then the message: a post that grew a newline would otherwise be
  # counted as several posts, and the one-line-per-board-row contract would go unasserted.
  printf '#!/usr/bin/env bash\n{ echo "---CALL---"; printf "%%s\\n" "$*"; } >> "$HOME/.mesh/chat-stub.log"\n' > "$fh/.local/bin/mesh-chat"
  chmod +x "$fh/.local/bin/mesh-chat"

  # <n-hours> — a ledger holding n distinct SAMPLED HOUR BUCKETS ending 1h before NOW, plus three
  # frames grants inside one bucket so the frames proposal has a real worst hour (3 -> int(3*1.2)+1=4).
  mkfix(){
    local n="$1" i st f="$fh/.mesh/budget-ledger.log"; : > "$f"
    for i in $(seq "$n" -1 1); do
      st="$(date -u -d "$NOW - $i hours" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
      printf '%s sample gpu_ms=%d\n' "${st%:*}:05Z" $(( (n - i + 1) * 60000 )) >> "$f"
    done
    st="$(date -u -d "$NOW - 2 hours" +%Y-%m-%dT%H)"
    for i in 10 20 30; do printf '%s:00:%sZ grant axis=frames why=light cost=1 cap=unset spent=1\n' "$st" "$i" >> "$f"; done
  }
  # the real path: env -i, so the child builds its own PATH and the fake home's bin wins.
  tick(){ env -i HOME="$fh" PATH="/usr/bin:/bin" MESH_BUDGET_NOW="$NOW" bash "$SELF" "$@" 2>&1; }
  posts(){ grep -c -- '---CALL---' "$fh/.mesh/chat-stub.log" 2>/dev/null || echo 0; }
  # a board post is ONE row: assert the shape, never assume it.
  post_lines(){ grep -vc -- '---CALL---' "$fh/.mesh/chat-stub.log" 2>/dev/null || echo 0; }

  # ---- 1. RED: below 24/24 the tool must be SILENT. This is also the live state of this node today
  #         (9/24 at the time of writing), so the red arm is not a contrived one.
  mkfix 9
  local o; o="$(tick)"
  case "$o" in *"quiet set=-"*) : ;; *) echo "test: 9/24 sampled hours did not render quiet, got '$o' FAIL"; e=1 ;; esac
  [ "$(posts)" = 0 ] || { echo "test: the tool posted to the board while mesh-budget was still REFUSING to propose FAIL"; e=1; }

  # ---- 2. GREEN: 24/24 -> exactly one post, carrying the measured numbers.
  mkfix 24
  o="$(tick)"
  case "$o" in *"POSTED gained=frames gpu"*) : ;; *) echo "test: a ripe 24/24 window did not post both axes, got '$o' FAIL"; e=1 ;; esac
  [ "$(posts)" = 1 ] || { echo "test: expected exactly 1 board post on the ripeness edge, got $(posts) FAIL"; e=1; }
  local msg; msg="$(cat "$fh/.mesh/chat-stub.log")"
  [ "$(post_lines)" = 1 ] || { echo "test: the board post is $(post_lines) lines — a board row is one line FAIL"; e=1; }
  case "$msg" in *"FRAMES_PER_HOUR=4"*) : ;; *) echo "test: the post does not carry the measured frames cap (expected FRAMES_PER_HOUR=4 from a worst hour of 3) FAIL"; e=1 ;; esac
  case "$msg" in *"GPU_MIN_PER_DAY="*) : ;; *) echo "test: the post does not carry a measured gpu cap FAIL"; e=1 ;; esac

  # ---- 3. the two standing caveats, and the fact that this arms NOTHING.
  case "$msg" in *"LOWER BOUND"*"bruno-watch"*"iMac cam"*) : ;; *) echo "test: the frames lower-bound caveat (cam-lock openers only) is missing from the post FAIL"; e=1 ;; esac
  case "$msg" in *"MESH_LABOR_BUDGET_USD"*"mesh-labor --propose-cap"*) : ;; *) echo "test: the paid-axis caveat is missing from the post FAIL"; e=1 ;; esac
  case "$msg" in *"RECOMMENDATION"*"nothing is armed"*) : ;; *) echo "test: the post does not declare itself a recommendation that arms nothing FAIL"; e=1 ;; esac
  # mesh-chat EVALUATES backticks in the message it is handed, and mesh-budget's own paid line quotes a
  # command in backticks — so the passthrough must strip them or this reflex executes that command.
  case "$msg" in *'`'*) echo "test: the posted message still carries a backtick — mesh-chat would run it as a command substitution FAIL"; e=1 ;; esac
  case "$(sed -n 's/^FRAMES_PER_HOUR=//p' "$fh/.mesh/budget.conf" 2>/dev/null)" in
    "") : ;; *) echo "test: the tick ARMED a cap in budget.conf — it must only recommend FAIL"; e=1 ;; esac

  # ---- 4. and then it SHUTS UP: the following tick, same ripe window, must add no second post.
  o="$(tick)"
  case "$o" in *"quiet set=frames gpu prev=frames gpu"*) : ;; *) echo "test: the tick after the edge was not quiet, got '$o' FAIL"; e=1 ;; esac
  [ "$(posts)" = 1 ] || { echo "test: the tool re-posted a standing proposal — it is a level detector, not an edge one FAIL"; e=1; }

  # ---- 5. it is an EDGE detector, not a one-shot latch: coverage falling back and re-ripening speaks
  #         again. On a node at 62.6% uptime that window closes and reopens constantly, and a latch
  #         would go permanently silent after the first time it was ever seen.
  mkfix 9;  o="$(tick)"
  case "$o" in *"quiet set=- prev=frames gpu"*) : ;; *) echo "test: coverage falling back below 24/24 did not reset the set, got '$o' FAIL"; e=1 ;; esac
  mkfix 24; o="$(tick)"
  case "$o" in *"POSTED gained=frames gpu"*) : ;; *) echo "test: a RE-ripened window did not post again (the state is a latch, not an edge) FAIL"; e=1 ;; esac
  [ "$(posts)" = 2 ] || { echo "test: expected a second post on re-ripening, got $(posts) FAIL"; e=1; }

  # ---- 6. THE POLARITY. A reworded proposal line that carries no cap token must read UNKNOWN, never
  #         "not refusing therefore proposing" — the failure direction that would recommend a number
  #         nobody measured. And a reworded REFUSAL must not read as a proposal either.
  local stub="$td/stub"; mkdir -p "$stub"
  # mkstub <what --propose should print> [exit code] — records the argv it was called with.
  mkstub(){
    printf '%s\n' "$1" > "$td/stub-out"; printf '%s\n' "${2:-0}" > "$td/stub-rc"
    { echo '#!/usr/bin/env bash'
      echo 'printf "%s\n" "$@" > "'"$td"'/argv"'
      echo 'cat "'"$td"'/stub-out"'
      echo 'exit "$(cat "'"$td"'/stub-rc")"'
    } > "$stub/mesh-budget"; chmod +x "$stub/mesh-budget"
  }
  stubtick(){ env -i HOME="$fh" PATH="$stub:/usr/bin:/bin" MESH_BUDGET_PROPOSE_BIN="$stub/mesh-budget" \
                MESH_BUDGET_TICK_CHAT="$fh/.local/bin/mesh-chat" bash "$SELF" 2>&1; }
  local before_state; before_state="$(cat "$fh/.mesh/.budget-propose-tick.state")"
  mkstub '  frames: the cap works out to about forty an hour
  gpu: REFUSED to propose — only 3/24 sampled hours in the last 24h.'
  o="$(stubtick)"; local rc=$?
  case "$o" in *"UNKNOWN reason=unparsed-axis-line axes=frames"*) : ;; *) echo "test: a reworded proposal with no cap token was not UNKNOWN, got '$o' FAIL"; e=1 ;; esac
  [ "$rc" != 0 ] || { echo "test: an unparseable answer exited 0 — an unknown reading must be loud FAIL"; e=1; }
  [ "$(posts)" = 2 ] || { echo "test: the tool posted off an unparseable answer FAIL"; e=1; }
  [ "$(cat "$fh/.mesh/.budget-propose-tick.state")" = "$before_state" ] \
    || { echo "test: an UNKNOWN run rewrote the state — a broken read must not erase the memory of what was already announced FAIL"; e=1; }

  # ---- 7. it must CALL --propose and nothing else: the argv the partner saw is asserted, so no future
  #         edit can quietly grow a second private copy of the ripeness arithmetic here.
  [ "$(cat "$td/argv" 2>/dev/null)" = "--propose" ] \
    || { echo "test: the partner was invoked as '$(cat "$td/argv" 2>/dev/null)', expected exactly --propose FAIL"; e=1; }

  # ---- 8. a partner that FAILS is UNKNOWN with its rc named, never a quiet 'still measuring'.
  mkstub 'boom' 3
  o="$(stubtick)"; rc=$?
  case "$o" in *"UNKNOWN reason=propose-rc=3"*) : ;; *) echo "test: a failing mesh-budget did not render UNKNOWN with its rc, got '$o' FAIL"; e=1 ;; esac
  [ "$rc" != 0 ] || { echo "test: a failing partner exited 0 FAIL"; e=1; }
  # ---- 8b. an EMPTY answer is unparsed too — silence from the partner is not evidence of unripeness.
  mkstub ''
  o="$(stubtick)"
  case "$o" in *"UNKNOWN reason=unparsed-axis-line axes=frames gpu"*) : ;; *) echo "test: an empty answer was not UNKNOWN, got '$o' FAIL"; e=1 ;; esac

  # ---- 9. the tape is not only the positives: quiet ticks are on it too, so 'ran with nothing to say'
  #         is distinguishable from 'never ran' — the same distinction the board post exists to make.
  local led="$fh/.mesh/budget-propose-tick-edges.log"
  [ "$(grep -c 'quiet ' "$led" 2>/dev/null)" -ge 3 ] \
    || { echo "test: quiet ticks left no row — the ledger is a numerator FAIL"; e=1; }
  [ "$(grep -c 'POSTED ' "$led" 2>/dev/null)" = 2 ] \
    || { echo "test: the ledger does not carry exactly the 2 posted edges FAIL"; e=1; }
  # and the ledger is NOT the file autowire redirects stdout into, or every tick's chatter lands in it.
  case "$led" in *"/budget-propose-tick.log") echo "test: the ledger IS the cron stdout log FAIL"; e=1 ;; esac

  # ---- 10. the suite must not have written THIS node's own durable ledger or state: a dry run that
  #          writes the record it exists to check forges its own evidence.
  if [ "$real_before" != "$(stat -c %Y-%s "$rl" "$rs" 2>/dev/null | tr '\n' ' ')" ]; then
    echo "test: --test wrote this node's own $rl / $rs FAIL"; e=1
  fi

  [ "$e" = 0 ] && echo "mesh-budget-propose-tick --test: PASS (drove $bud: 9/24 silent · 24/24 posts once with the measured caps, both caveats, no backtick, budget.conf untouched · next tick quiet · fall-back-and-re-ripen posts again, so it is an edge not a latch · a reworded proposal, an rc!=0 partner and an empty answer are all UNKNOWN-and-loud with the state left intact · argv asserted as exactly --propose · quiet ticks are on the tape · this node's own ledger and state untouched)" \
    || echo "mesh-budget-propose-tick --test: FAIL"
  [ "$e" = 0 ]
}

case "${1:-}" in
  ""|--tick) main ;;
  --test)   do_test ;;
  --status)
    echo "state: $(cat "$STATE" 2>/dev/null || echo '<none — never evaluated>')"
    echo "ledger: $LEDGER"; tail -n 5 "$LEDGER" 2>/dev/null ;;
  -h|--help) sed -n '1,60p' "$0" ;;
  *) echo "usage: mesh-budget-propose-tick [--tick|--status|--test]" >&2; exit 2 ;;
esac
