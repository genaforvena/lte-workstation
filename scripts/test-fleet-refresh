#!/usr/bin/env python3
"""Exercise real fleet collection with isolated, slow/failing peer tools."""
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time
import sys

subject = Path(sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] != '--test'
               else Path(__file__).with_name('mesh-fleet-health')).resolve()
with tempfile.TemporaryDirectory() as td:
    home = Path(td)
    bins = home / '.local/bin'
    bins.mkdir(parents=True)
    (home / '.mesh').mkdir()
    (home / '.mesh/nodes').write_text('MESH_NODES="lan:user@192.0.2.8"\n')
    peers = [dict(hostname=n, ip=ip, online=online) for n, ip, online in [
        ('slow', '100.0.0.1', True), ('resolver', '100.0.0.2', True),
        ('healthy', '100.0.0.3', True), ('cardless', '100.0.0.4', True),
        ('imozerov-IdeaPad-3-15IIL05', '100.0.0.5', False)]]
    def stub(name, body):
        p = bins / name
        p.write_text('#!/usr/bin/env bash\n' + body + '\n')
        p.chmod(0o755)
    stub('hostname', 'echo fixture-self')
    stub('mesh-peers', "echo '" + json.dumps(peers) + "'")
    card = '  power: AC\n  vitals: ok\n  upstream: up\n  minds: none\n  default-egress: dev eth0'
    stub('mesh-card', "printf '%s\\n' '" + card + "'")
    stub('mesh-peer-addr', '[[ $1 == resolver ]] && { sleep 90; exit; }; exit 1')
    stub('ssh', '''case "$*" in
      *100.0.0.1*|*192.0.2.8*) trap '' TERM; sleep 90 ;;
      *100.0.0.3*) mesh-card ;;
      *100.0.0.4*) case "${!#}" in *mesh-card*) exit 1 ;; true) exit 0 ;; *) echo '0|0.1' ;; esac ;;
      *) exit 255 ;;
    esac''')
    stub('ping', 'exit 1')
    stub('sleep', 'echo $$ >> "$HOME/worker-pids"; exec /bin/sleep "$@"')
    env = dict(HOME=td, PATH='/usr/bin:/bin', MESH_FLEET_FORCE_LOAD='0',
               FLEET_SSH_CMD_T='60')
    start = time.monotonic()
    run = subprocess.run(['bash', str(subject)], env=env, capture_output=True,
                         text=True, timeout=35)
    elapsed = time.monotonic() - start
    assert run.returncode == 0, run.stderr
    rows = {}
    for line in run.stdout.splitlines():
        fields = line.split()
        if fields and fields[0] in ['fixture-self', 'lan'] + [p['hostname'] for p in peers]:
            assert fields[0] not in rows, run.stdout
            rows[fields[0]] = fields[1]
    expected = {'fixture-self': 'LOCAL', 'slow': 'UNKNOWN(timeout)',
                'resolver': 'UNKNOWN(timeout)', 'healthy': 'yes',
                'cardless': 'NO-CARD', 'imozerov-IdeaPad-3-15IIL05': 'OFFLINE',
                'lan': 'UNKNOWN(timeout)'}
    assert rows == expected, (rows, run.stdout, run.stderr)
    assert 'PATH:' in run.stdout
    for pid in (home / 'worker-pids').read_text().splitlines():
        stat = Path('/proc') / pid / 'stat'
        deadline = time.monotonic() + 2
        while stat.exists() and stat.read_text().split()[2] != 'Z' and time.monotonic() < deadline:
            time.sleep(0.02)
        assert not stat.exists() or stat.read_text().split()[2] == 'Z', f'leaked child {pid}'
    print(f'PASS: complete seven-row snapshot in {elapsed:.2f}s; slow SSH, resolver, LAN; healthy/cardless/offline preserved')
    # Roster failures must never look like a successful local-only refresh.
    for body in ['exit 1', "echo 'invalid json'"]:
        stub('mesh-peers', body)
        failed = subprocess.run(['bash', str(subject)], env=env, capture_output=True, timeout=8)
        assert failed.returncode != 0, failed.stdout
    print('PASS: failed and malformed enumeration refuse publication')
