# nodes.example — YOUR mesh's node registry.  Copy to ~/.mesh/nodes (node-local, NOT committed) and
# fill in YOUR nodes. Mesh tools source this instead of hard-coding IPs, so the genome plants on ANY
# mesh, not just the one it was born in. Everything here is plain shell (sourced), so keep it simple.
#
#   cp scripts/nodes.example ~/.mesh/nodes   &&   $EDITOR ~/.mesh/nodes
#
# Empty values are fine: a brand-new FIRST node has no peer yet and grows from itself.

# Your first / steward peer — a Tailscale 100.x or LAN IP. Empty = this is the first node.
MESH_PEER=

# Space-separated "label:user@host" for multi-node tools (mesh-verify, mesh-morning, mesh-organs…).
# Empty = single-node mesh (tools just act locally).
MESH_NODES=""

# --- example (delete and replace with your own) ---
# MESH_PEER=100.64.0.1
# MESH_NODES="laptop:you@100.64.0.1 server:you@100.64.0.2 phone:u0_aXX@100.64.0.3"
