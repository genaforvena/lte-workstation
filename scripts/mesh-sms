#!/usr/bin/env bash
# mesh-sms — send an SMS via the phone body (termux-sms-send).
# TG-independent alert channel: works when Telegram is geo-blocked or down.
# Reaches the phone via SSH the same path as mesh-act/mesh-light/mesh-body-*.
#
# Config (in priority order):
#   MESH_SMS_NUMBER env var  — recipient number (e.g. +79001234567)
#   ~/.mesh/sms.conf         — one line: the number (no quotes, no comments)
#
#   mesh-sms "message text"     send SMS to the configured number
#   mesh-sms --test             smoke test (checks phone reachable + termux-sms-send present)
#
# Exit codes (honest-exit contract, matches mesh-act/mesh-light):
#   0 = sent OK
#   1 = config error (no number configured / no message)
#   2 = phone unreachable / send failed (NOT "SMS sent" — a failed delivery is never exit 0)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# TEST-SANDBOX gate (extends chat-review/doctor-smoke-sandbox-net, 2026-07-02): MESH_TEST_SANDBOX=1
# marks a smoke-sweep context (mesh-doctor exports it around every child --test) — NEVER send a real
# SMS from it; a tool whose --test forgot to gate its own outbound would otherwise text the operator's
# phone. Placed BEFORE the mesh-phone-ip resolution (that already probes the network) with a --test
# exemption, so the sweep still runs this tool's own --test. Suppressed = exit 0 (success to the
# caller: the message was intentionally not delivered).
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ] && [ "${1:-}" != --test ]; then
  echo "mesh-sms: MESH_TEST_SANDBOX — real SMS send SUPPRESSED (smoke-sweep context): ${*:-}" >&2
  exit 0
fi
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new"

# Resolve phone IP: probe-based (TS → LAN candidates, first that connects)
PHONE_IP="$(mesh-phone-ip 2>/dev/null)" || PHONE_IP=""

# Resolve SMS number: env var > config file
SMS_NUMBER="${MESH_SMS_NUMBER:-}"
if [ -z "$SMS_NUMBER" ] && [ -f "$HOME/.mesh/sms.conf" ]; then
  SMS_NUMBER="$(head -1 "$HOME/.mesh/sms.conf" 2>/dev/null | tr -d '[:space:]')"
fi

if [ "${1:-}" = --test ]; then
  # TEST-SANDBOX gate: a send attempted under MESH_TEST_SANDBOX=1 must be SUPPRESSED (exit 0, no SSH,
  # no SMS) — asserted BEFORE the phone-reach check so the gate is proven even with the phone offline.
  _sup="$(MESH_TEST_SANDBOX=1 "$0" "sandbox probe — must never become a real SMS" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_sup" | grep -q 'SUPPRESSED'; } \
    || { echo "smoke-test: FAIL (MESH_TEST_SANDBOX gate broken: rc=$_rc out='$_sup')"; exit 1; }
  [ -n "$PHONE_IP" ] || { echo "smoke-test: n/a (no PHONE_IP / Redmi not in registry + MESH_TEST_SANDBOX gate ok)"; exit 2; }
  result="$(timeout 10 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}" \
    "command -v termux-sms-send >/dev/null 2>&1 && echo ok || echo missing" 2>/dev/null)" || {
    echo "smoke-test: n/a (phone unreachable at ${PHONE_USER}@${PHONE_IP}:${PHONE_PORT})"; exit 2
  }
  [ "$result" = ok ] || { echo "smoke-test: FAIL (termux-sms-send not found on phone)"; exit 1; }
  [ -n "$SMS_NUMBER" ] || { echo "smoke-test: WARN (no number configured — set MESH_SMS_NUMBER or ~/.mesh/sms.conf)"; exit 0; }
  echo "smoke-test: ok (number=${SMS_NUMBER}, phone=${PHONE_IP} + MESH_TEST_SANDBOX send-suppression gate)"; exit 0
fi

[ -n "$SMS_NUMBER" ] || {
  echo "mesh-sms: no recipient number — set MESH_SMS_NUMBER or write number to ~/.mesh/sms.conf" >&2
  exit 1
}

[ -n "$PHONE_IP" ] || {
  echo "mesh-sms: phone IP unresolved (Redmi not in registry and unreachable via LAN)" >&2
  exit 2
}

MSG="${*:-}"
[ -n "$MSG" ] || { echo "mesh-sms: no message text" >&2; exit 1; }

# Send: pipe message via stdin to avoid shell-quoting issues with special chars
esc_num="$(printf '%s' "$SMS_NUMBER" | sed "s/'/'\\\\''/g")"
rc=0
printf '%s' "$MSG" | timeout 20 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}" \
  "termux-sms-send -n '${esc_num}'" 2>&1 || rc=$?

if [ $rc -eq 124 ] || [ $rc -eq 255 ]; then
  echo "mesh-sms: phone unreachable during send" >&2; exit 2
fi
[ $rc -eq 0 ] || { echo "mesh-sms: send failed (rc=$rc)" >&2; exit 2; }

msglen="${#MSG}"
[ -x "$HOME/.local/bin/mesh-trace" ] && \
  MESH_WHO="mesh-sms@$(hostname)" "$HOME/.local/bin/mesh-trace" \
  "[sms-sent] to=${SMS_NUMBER} len=${msglen}" >/dev/null 2>&1 || true

echo "mesh-sms: sent to ${SMS_NUMBER} (${msglen} chars)"
