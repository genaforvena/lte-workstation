#!/usr/bin/env bash
# mesh-attest-keystore — hardware-rooted attestation for mesh artifacts.
#
# The phone's Android keystore holds the mesh's ONLY private key that is not readable by uid
# `mesh-home` — every mind on the node shares that uid, so every software key is a naming scheme
# rather than a trust boundary (see scripts/mesh-board-sign for that measured argument).
#
# DESIGN CONSTRAINT, MEASURED NOT ASSUMED (2026-09-22):
# the keystore emits SHA256withECDSA, which is RANDOM-NONCE. Signing the same bytes twice yields
# two different signatures — verified three ways: openssl pkeyutl twice, openssl dgst three times,
# and termux-keystore sign twice on the phone, all producing different output. mesh-board-sign
# deliberately chose Ed25519 BECAUSE it must survive `sort -u` board dedupe (a random nonce would
# make each node's copy of the same line unique and defeat the union merge). This tool therefore
# NEVER puts a signature inside a board line. The attestation is a DETACHED SIDECAR keyed by the
# artifact's sha256 — the artifact and the board line stay byte-identical everywhere, dedupe is
# untouched, and the signature is only ever consulted by a reader that goes looking for it.
#
# usage:
#   mesh-attest-keystore <artifact-file>                  attest; writes <file>.hwattest
#   mesh-attest-keystore --check <artifact-file>          verify only; never advances state
#   mesh-attest-keystore --coverage [evidence-root]     read-only inventory of the trust root
#   mesh-attest-keystore --test                           smoke test (no phone needed)
#
# exit: 0 verified · 1 MISMATCH/tamper · 2 honest n/a (no phone, no keystore, no openssl, no pin)
#       — never a fake "ok" for an unverifiable artifact.
#
# state: <artifact>.hwattest   — "sha256=<hex> sig=<base64> alias=<alias> ts=<iso>"
# trust: $MESH_DIR/keys/phone-keystore.pem — the pinned public key, hex coordinates published
#        by `termux-keystore list -d` on the phone and built into a standard SPKI.
# env:  MESH_PHONE_SSH, MESH_PHONE_USER, MESH_PHONE_PORT, MESH_KS_ALIAS, MESH_ATTEST_PUB

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
ALIAS="${MESH_KS_ALIAS:-meshprobe-ec}"
PIN="${MESH_ATTEST_PUB:-$MESH_DIR/keys/phone-keystore.pem}"
SSH_HOST="${MESH_PHONE_SSH:-}"
PHONE_USER="${MESH_PHONE_USER:-u0_a380}"
PHONE_PORT="${MESH_PHONE_PORT:-8022}"
# Absolute path to this script, resolved ONCE at load. cmd_coverage recurses into itself with
# `"$SELF" --check` after `cd`-ing into a subdirectory, and `$0` there is relative ("scripts/…"
# when the deployed copy is invoked by name) — a bare `"$0"` resolves against the new cwd and
# 127s instead of verifying. The smoke test hits this too (it cds into a temp dir), so this is
# not hypothetical. Resolving before any function can run keeps recursion cwd-independent.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

na(){ printf 'mesh-attest-keystore: n/a — %s\n' "$*" >&2; exit 2; }

have(){ command -v "$1" >/dev/null 2>&1; }

# resolve the phone lazily — only when we actually need to sign
phone_ip(){
  [ -n "$SSH_HOST" ] && { printf '%s' "$SSH_HOST"; return 0; }
  have mesh-phone-ip || return 1
  mesh-phone-ip 2>/dev/null
}

# phone_ssh <cmd>  — run on the phone; exit 2 on any transport failure, never silently
phone_ssh(){
  local ip
  ip="$(phone_ip)" || return 2
  [ -n "$ip" ] || return 2
  ssh -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=no \
      -p "$PHONE_PORT" "${PHONE_USER}@${ip}" "$@" 2>/dev/null
}

# hex2spki <x-hex> <y-hex> — P-256 coordinates → PEM SubjectPublicKeyInfo, emitted on stdout.
# The phone publishes x and y as separate hex fields and mesh-home reconstructs the standard SPKI,
# so verification NEVER depends on a phone-side tool or on the transport that carried the signature.
#
# WRITTEN IN PYTHON, NOT BASH, FOR A MEASURED REASON. The bash half of this function was first
# written with `printf '\xNN'` and a `while read -n2` hex loop, and it was silently wrong: bash's
# printf refuses to EMIT bytes that do not form valid UTF-8 ("invalid UTF-8 output"), so a
# coordinate containing e.g. 0x80 or 0x00 produced a truncated or empty key rather than a
# malformed-looking one. The error was not caught by any caller — it surfaced only when the DER
# failed to parse. The coordinate is exactly the kind of data where every byte value is equally
# likely, so this is not a rare input. Hand-rolling DER in shell is not worth the risk it will
# quietly produce a key that is not the one on the phone; python3 is present on mesh-home and the
# output below is verified byte-identical to the key reconstructed during the original probe.
hex2spki(){
  [ $# -ge 2 ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$1" "$2" 2>/dev/null <<'PYEOF'
import sys, base64
x, y = sys.argv[1], sys.argv[2]
oid = bytes([0x06,0x07,0x2A,0x86,0x48,0xCE,0x3D,0x02,0x01])        # id-ecPublicKey
curve = bytes([0x06,0x08,0x2A,0x86,0x48,0xCE,0x3D,0x03,0x01,0x07])  # secp256r1
alg = oid + curve
try:
    point = b'\x04' + bytes.fromhex(x + y)
except ValueError:
    sys.exit(1)
if len(point) != 65:
    sys.exit(1)                        # P-256 uncompressed point is exactly 65 bytes
bs = bytes([0x03, len(point) + 1, 0x00]) + point
def tlv(tag, content):
    l = len(content)
    lh = bytes([0x81, l]) if l > 127 else bytes([l])
    return bytes([tag]) + lh + content
spki = tlv(0x30, tlv(0x30, alg) + bs)
sys.stdout.write('-----BEGIN PUBLIC KEY-----\n'
                 + base64.b64encode(spki).decode() + '\n'
                 + '-----END PUBLIC KEY-----\n')
PYEOF
}

# fetch_pub — read the live key coordinates from the phone and emit a PEM on stdout
fetch_pub(){
  local out x y
  out="$(phone_ssh "termux-keystore list -d 2>/dev/null")" || return 2
  x="$(printf '%s\n' "$out" | sed -n 's/.*"x": "\([0-9a-f]*\)".*/\1/p')"
  y="$(printf '%s\n' "$out" | sed -n 's/.*"y": "\([0-9a-f]*\)".*/\1/p')"
  [ -n "$x" ] && [ -n "$y" ] || return 2
  hex2spki "$x" "$y"
}

cmd_pin(){
  have openssl || na "no openssl"
  mkdir -p "$(dirname "$PIN")" 2>/dev/null; chmod 700 "$(dirname "$PIN")" 2>/dev/null
  if [ -f "$PIN" ]; then
    printf 'pin: already pinned at %s — refusing to overwrite silently; remove it deliberately to rotate.\n' "$PIN"
    return 0
  fi
  fetch_pub > "$PIN" 2>/dev/null || { rm -f "$PIN"; na "could not fetch the key from the phone (is it reachable?)"; }
  [ -s "$PIN" ] || { rm -f "$PIN"; na "phone keystore returned an unusable key"; }
  chmod 644 "$PIN" 2>/dev/null
  printf 'pin: phone keystore public key -> %s\n' "$PIN"
}

cmd_attest(){
  local f="$1" sha sig b64 state
  [ -f "$f" ] || na "no such artifact: $f"
  have openssl || na "no openssl"
  have sha256sum || na "no sha256sum"
  sha="$(sha256sum "$f" | cut -d' ' -f1)"
  state="$f.hwattest"

  # Re-attestation of an unchanged artifact is a no-op, not an error — but a CHANGED artifact
  # must never silently overwrite a prior attestation: that would erase the evidence of the
  # very tamper this tool exists to catch.
  if [ -f "$state" ]; then
    local prior_sha
    prior_sha="$(sed -n 's/^sha256=//p' "$state" 2>/dev/null)"
    if [ "$prior_sha" = "$sha" ]; then
      printf 'attest: unchanged (sha256=%s) — keeping existing %s\n' "$sha" "$state"
      return 0
    fi
  fi
  # write the payload to a phone-side path and sign it there; the signature is over the
  # artifact's sha256, so only the digest crosses the wire, never the artifact body.
  local tmp shafile sigfile
  tmp="hwattest.$$" || return 2
  shafile="$HOME/${tmp}.sha256"
  sigfile="$HOME/${tmp}.sig"
  printf '%s' "$sha" > "$shafile"
  phone_ssh "cat > '$shafile'" < "$shafile" 2>/dev/null || { rm -f "$shafile"; na "could not reach the phone to sign"; }
  phone_ssh "termux-keystore sign $ALIAS SHA256withECDSA < '$shafile' > '$sigfile' 2>/dev/null; echo rc=\$?" 2>/dev/null | grep -q 'rc=0' || {
    rm -f "$shafile"; na "the phone refused to sign with alias $ALIAS"; }
  sig="$(phone_ssh "cat '$sigfile'" 2>/dev/null)" || { rm -f "$shafile"; na "could not read the signature back"; }
  phone_ssh "rm -f '$shafile' '$sigfile'" 2>/dev/null || true
  [ -n "$sig" ] || na "empty signature returned"

  b64="$(printf '%s' "$sig" | base64 -w0)"
  printf 'sha256=%s sig=%s alias=%s ts=%s\n' "$sha" "$b64" "$ALIAS" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$state"
  printf 'attest: %s -> %s\n' "$f" "$state"
}

cmd_check(){
  local f="$1" state sha sig
  [ -f "$f" ] || na "no such artifact: $f"
  have openssl || na "no openssl"
  have sha256sum || na "no sha256sum"
  state="$f.hwattest"
  [ -f "$state" ] || na "no attestation sidecar at $state (run mesh-attest-keystore $f first)"
  [ -f "$PIN" ] || na "no pinned public key at $PIN (run mesh-attest-keystore --pin-pub)"

  sha="$(sha256sum "$f" | cut -d' ' -f1)"
  local rec_sha rec_sig
  # The sidecar is whitespace-separated — sha256=<hex> sig=<b64> alias=... ts=...
  # and the base64 payload contains + / and =, so it cannot be regex-anchored to the line.
  # It is FIELD 2: a `sed 's/^sig=//'` silently returns the empty string, the base64 below
  # decodes to zero bytes, and verify reports failure for a perfectly good signature. That bug
  # was caught by --test; the field is parsed by position so it cannot come back.
  rec_sha="$(awk '{sub(/^sha256=/,"",$1); print $1}' "$state")"
  rec_sig="$(awk '{sub(/^sig=/,"",$2); print $2}' "$state")"

  [ -n "$rec_sha" ] && [ -n "$rec_sig" ] || na "attestation sidecar is malformed"
  if [ "$rec_sha" != "$sha" ]; then
    printf 'check: TAMPER — artifact changed since attestation (recorded %s, actual %s)\n' "$rec_sha" "$sha" >&2
    return 1
  fi
  printf '%s' "$rec_sig" | base64 -d 2>/dev/null > "$f._sig.$$" || { rm -f "$f._sig.$$"; na "signature blob is not valid base64"; }
  if openssl dgst -sha256 -verify "$PIN" -signature "$f._sig.$$" "$f" 2>/dev/null | grep -q '^Verified OK$'; then
    rm -f "$f._sig.$$"
    printf 'check: verified — %s attested by the phone keystore (sha256=%s)\n' "$f" "$sha"
    return 0
  fi
  rm -f "$f._sig.$$"
  # digest agreed but the signature does not: the sidecar was forged or the pin is wrong.
  printf 'check: TAMPER — digest matches but the signature does not verify against the pinned key\n' >&2
  return 1
}

# cmd_coverage [root] — READ-ONLY inventory of the mesh's only hardware trust root.
#
# WHY THIS EXISTS (found 2026-09-23, discover): the write side landed 2026-09-22 and nothing ever
# read it back. `grep -rln hwattest scripts/ docs/` returns exactly this file, and
# `grep -rln 'phone-keystore\|attest-keystore'` returns this file plus its own knowledge filing —
# one writer, zero consumers. The mesh's ONLY non-extractable key was producing evidence no mind
# and no pane could see, so on the one plane trust would actually be consulted it read as absent.
# This is the same blindness class as the 2026-08-28 cron-journal find (a proven capability whose
# outputs no mesh tool reads) on a different plane, and the same fix: expose what is already there.
#
# READ-ONLY BY CONSTRUCTION. It never signs, never writes a file, never touches the phone. Every
# verdict is derived from bytes already on this node (sidecar + pinned PEM), so a phone that is
# offline — the measured normal state, connection-refused mid-session on 2026-09-22 and 09-23 —
# cannot make coverage read as anything but what it is. The phone-arm verdicts (attested vs
# tampered) ARE reachable without the phone because cmd_check verifies against the pinned key.
#
# OUTPUT CONTRACT (stable, one line, machine-parseable):
#   coverage: attested=<n>/<n-artifacts> verified=<n> tampered=<n> pin=<yes|no> age=<iso>|never
# and on --json the same fields as an object. `n/a` is emitted as counts, never as a fake green:
# zero artifacts and no pin both render as explicit zeros so a mind cannot mistake absence for
# health. Nonzero `tampered` or a missing pin makes the line name them, and only those cases
# return nonzero, so this is safe to hang a gate on.
cmd_coverage(){
  local root="${1:-$MESH_DIR/evidence}"
  [ -d "$root" ] || { printf 'coverage: n/a — no evidence root at %s\n' "$root"; return 2; }
  have sha256sum || na "no sha256sum"
  local pin_ok=no pin_ts=never
  if [ -f "$PIN" ]; then
    pin_ok=yes
    pin_ts="$(date -u -r "$PIN" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf never)"
  fi
  local n=0 attested=0 verified=0 tampered=0 missing=0 stale=0 f state rc
  # -print0 + read -d '' so a path containing a space cannot split into two bogus entries. A
  # glob here would silently skip the evidence root's subdirectories and under-report.
  while IFS= read -r -d '' f; do
    n=$((n+1))
    state="$f.hwattest"
    [ -f "$state" ] || { missing=$((missing+1)); continue; }
    attested=$((attested+1))
    rc=0; "$SELF" --check "$f" >/dev/null 2>&1 || rc=$?
    # rc 0 = verified · 1 = TAMPER · 2 = n/a (no pin / no sidecar / no openssl)
    if [ "$rc" -eq 0 ]; then verified=$((verified+1))
    elif [ "$rc" -eq 1 ]; then tampered=$((tampered+1))
    else stale=$((stale+1)); fi
  done < <(find "$root" -type f ! -name '*.hwattest' -print0 2>/dev/null)

  if [ "${MESH_ATTEST_COVERAGE_JSON:-}" = 1 ]; then
    printf '{"attested":%d,"verified":%d,"tampered":%d,"missing":%d,"unverifiable":%d,"pin":"%s","pin_ts":"%s","root":"%s"}\n' \
      "$attested" "$verified" "$tampered" "$missing" "$stale" "$pin_ok" "$pin_ts" "$root"
    return 0
  fi
  local rv=0
  [ "$tampered" -gt 0 ] && rv=1
  [ "$pin_ok" = no ] && rv=1
  printf 'coverage: attested=%d/%d verified=%d tampered=%d pin=%s age=%s\n' \
    "$attested" "$n" "$verified" "$tampered" "$pin_ok" "$pin_ts"
  [ "$tampered" -gt 0 ] && printf 'coverage: TAMPERED — %d artifact(s) changed since attestation\n' "$tampered"
  [ "$pin_ok" = no ] && printf 'coverage: no pinned public key — attested artifacts are unverifiable until --pin-pub\n'
  return "$rv"
}

case "${1:-}" in
  --pin-pub)  cmd_pin ;;
  --check)    shift; [ $# -ge 1 ] || na "usage: --check <artifact>"; cmd_check "$1" ;;
  --coverage)  shift; cmd_coverage "${1:-}" ;;
  --test)     : ;;
  -h|--help)  sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *)          [ $# -ge 1 ] || na "usage: mesh-attest-keystore <artifact-file>"; cmd_attest "$1" ;;
esac

_rc=$?
[ "${1:-}" = --test ] || exit "$_rc"

# ------------------------------- smoke test (no phone required) -------------------------------
# Exercises the pure-bash half that must work on mesh-home alone: the SPKI reconstruction and the
# verify/tamper paths, against an openssl-generated key standing in for the phone. The signing
# half is exercised live in the knowledge filing; --test deliberately stays phone-free so a
# missing phone never silently passes a signing test.
have openssl || { echo "smoke-test: n/a (no openssl)"; exit 2; }
T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
cd "$T" || exit 2

# known-good P-256 key as the stand-in trust anchor
openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out k.pem 2>/dev/null || exit 2
openssl pkey -in k.pem -pubout -out pin.pem 2>/dev/null || exit 2

printf 'the artifact body\n' > art.txt
sha="$(sha256sum art.txt | cut -d' ' -f1)"
openssl dgst -sha256 -sign k.pem art.txt > art.sig 2>/dev/null || exit 2
b64="$(base64 -w0 art.sig)"
printf 'sha256=%s sig=%s alias=test ts=now\n' "$sha" "$b64" > art.txt.hwattest

# Each invocation's rc is captured IMMEDIATELY — a preceding cp/printf would otherwise clobber $?
# and the check below would read the copy's exit code instead of the verification's. Equally, rc
# must not be reused across cases: test 2's verdict has to be judged before test 3 overwrites it.
# 1. good artifact verifies
cp pin.pem ./.pin
rc1=0; MESH_ATTEST_PUB=./.pin "$SELF" --check art.txt >/dev/null 2>&1 || rc1=$?
[ $rc1 -eq 0 ] || { echo "smoke-test: FAIL good artifact did not verify (rc=$rc1)"; exit 1; }

# 2. tampered artifact is caught (rc must be 1, not 2: a detectable change is a verdict, not n/a)
printf 'the artifact body TAMPERED\n' > art.txt
rc2=0; MESH_ATTEST_PUB=./.pin "$SELF" --check art.txt >/dev/null 2>&1 || rc2=$?
[ $rc2 -eq 1 ] || { echo "smoke-test: FAIL tampered artifact was not caught (rc=$rc2)"; exit 1; }

# 3. a missing sidecar is honest n/a, never ok
rm -f missing.txt; printf 'no sidecar for this\n' > missing.txt
rc3=0; MESH_ATTEST_PUB=./.pin "$SELF" --check missing.txt >/dev/null 2>&1 || rc3=$?
[ $rc3 -eq 2 ] || { echo "smoke-test: FAIL missing sidecar gave rc=$rc3, expected honest n/a (2)"; exit 1; }

# 4. coverage. The corpus lives in its OWN directory (`cv/`), not `.`: the smoke harness keeps
#    k.pem/pin.pem/art.sig/.pin alongside, and those helper files have no sidecars, so a
#    `--coverage .` line counts them and the attested/N denominator drifts off the fixture set.
#    Isolating the corpus keeps the asserted counts equal to what the fixtures actually are.
mkdir -p cv && cd cv || exit 2
printf 'the artifact body\n' > art.txt
sha="$(sha256sum art.txt | cut -d' ' -f1)"
openssl dgst -sha256 -sign ../k.pem art.txt > art.sig 2>/dev/null || exit 2
printf 'sha256=%s sig=%s alias=test ts=now\n' "$sha" "$(base64 -w0 art.sig)" > art.txt.hwattest
printf 'untouched\n' > untampered.txt
sha2="$(sha256sum untampered.txt | cut -d' ' -f1)"
openssl dgst -sha256 -sign ../k.pem untampered.txt > u.sig 2>/dev/null || exit 2
printf 'sha256=%s sig=%s alias=test ts=now\n' "$sha2" "$(base64 -w0 u.sig)" > untampered.txt.hwattest
printf 'plain\n' > plain.txt
rm -f art.sig u.sig
printf 'the artifact body TAMPERED\n' > art.txt

# a tampered artifact is counted and the root reads red
rc4=0; MESH_ATTEST_PUB=../.pin "$SELF" --coverage . >/dev/null 2>&1 || rc4=$?
[ $rc4 -eq 1 ] || { echo "smoke-test: FAIL coverage over a tampered root must be rc 1, got $rc4"; exit 1; }
out4="$(MESH_ATTEST_PUB=../.pin "$SELF" --coverage . 2>/dev/null)"
printf '%s\n' "$out4" | grep -q 'verified=1' \
  || { echo "smoke-test: FAIL coverage did not count the good artifact: $out4"; exit 1; }
printf '%s\n' "$out4" | grep -q 'tampered=1' \
  || { echo "smoke-test: FAIL coverage did not count the tampered artifact: $out4"; exit 1; }

# 5. a CLEAN root is rc 0 and names no tamper — a green that can be relied on
mkdir -p clean && cp untampered.txt untampered.txt.hwattest clean/
rc5=0; MESH_ATTEST_PUB=../.pin "$SELF" --coverage clean >/dev/null 2>&1 || rc5=$?
[ $rc5 -eq 0 ] || { echo "smoke-test: FAIL clean root must be rc 0, got $rc5"; exit 1; }
out5="$(MESH_ATTEST_PUB=../.pin "$SELF" --coverage clean 2>/dev/null)"
printf '%s\n' "$out5" | grep -q 'tampered=0' \
  || { echo "smoke-test: FAIL a clean root reported tampered: $out5"; exit 1; }

# 6. a MISSING pin must read as unverifiable and rc 1 — never a fake green
out6="$(MESH_ATTEST_PUB=../.nope "$SELF" --coverage clean 2>/dev/null)"; rc6=$?
[ $rc6 -eq 1 ] || { echo "smoke-test: FAIL a missing pin must not read as healthy (rc=$rc6)"; exit 1; }
# `grep -q` is deliberately NOT piped into from --coverage: this file runs `set -o pipefail`, and
# `grep -q` closes the pipe on first match, so --coverage takes SIGPIPE mid-write and the
# pipeline returns 1 — the assertion would then fail on a correct output. The line is captured
# first (above) and matched off the variable, so no early close can reach the producer.
printf '%s\n' "$out6" | grep -q 'pin=no' \
  || { echo "smoke-test: FAIL a missing pin was not named in the line: $out6"; exit 1; }

# 7. recursion into subdirectories, and a space in a path (find -print0, not a glob)
mkdir -p 'sub dir' && cp untampered.txt untampered.txt.hwattest 'sub dir/'
out7="$(MESH_ATTEST_PUB=../.pin "$SELF" --coverage . 2>/dev/null)"
# Expected: 5 artifacts total (art.txt, untampered.txt, plain.txt, clean/untampered.txt,
# 'sub dir'/untampered.txt), of which 4 have sidecars. Recursion into clean/ and 'sub dir/'
# both count; if the walk used a glob instead of find -print0, both would vanish and the line
# would read attested=2/3, and a spaced path would split into two bogus entries.
printf '%s\n' "$out7" | grep -q 'attested=4/5' \
  || { echo "smoke-test: FAIL coverage missed the subdir or the spaced path: $out7"; exit 1; }
printf '%s\n' "$out7" | grep -q 'tampered=1' \
  || { echo "smoke-test: FAIL the tampered art.txt is no longer reported at the root: $out7"; exit 1; }
cd ..


echo "smoke-test: ok (SPKI build, verify, tamper, missing-sidecar n/a, coverage good/tampered/clean/no-pin/recursion — eleven distinct verdicts)"
