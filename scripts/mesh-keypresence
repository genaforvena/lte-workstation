#!/usr/bin/env bash
# orphan-ok: on-demand person-corroborator, mind/fusion-invoked live (like body-context/tamper/
#   operator-state — the LIVE-ONLY mind-probe class), NOT a cron reflex; no per-run cache by design.
# mesh-keypresence — PHYSICAL keyboard-presence sense: is a human physically typing on THIS node?
#
# WHY this is a NEW, distinct sense (not covered by the existing perception set):
#   - It is the GOLD person-specific signal the appliance-vs-person trap asks for. A keyboard
#     keypress can ONLY be produced by a human at this physical machine — unlike mic-LOUD or a
#     BLE-device count, which a TV / speaker / appliance fakes. See memory appliance-vs-person-
#     fusion-trap: "before merging any presence/occupancy fusion, ask what in these inputs can
#     ONLY be a person?" — a hardware keypress is exactly that.
#   - It isolates PHYSICAL presence from REMOTE presence. A dozen remote SSH/tmux (pts) sessions do
#     NOT bump the keyboard controller IRQ; only a body at the actual keyboard does. So it cleanly
#     separates "someone is sitting at this laptop" from "someone is shelled in over the network".
#   - It corroborates operator-home / operator-state with a person-specific input the others lack
#     (those lean on mic energy + phone-LAN; this is a direct physical-interaction signal).
#
# SOURCE: /proc/interrupts — the keyboard controller's IRQ counter (i8042 / atkbd). World-readable,
# no root, no `input` group, headless-safe (evdev /dev/input/event* needs the input group → not
# usable by a normal-user reflex; the IRQ counter needs nothing). We sample the summed counter twice
# over a short window: it RISES iff a physical key was pressed in that window.
#
# HONEST scope + degradation (the no-faked-reading rule):
#   - ONLY a DEDICATED, input-isolated keyboard IRQ is used. The touchpad here shares its IRQ with a
#     DMA engine (idma64) whose traffic would masquerade as "input" — a shared/contaminated IRQ is
#     EXCLUDED, never counted (it would fabricate presence). So this senses the KEYBOARD only, on
#     purpose, and says so — it does not overclaim "all input".
#   - No dedicated keyboard IRQ found (a headless VM/server with no physical keyboard) => EXIT 2
#     "unreachable", NOT a fake QUIET. Absence-of-hardware must read differently from a real quiet.
#   - QUIET means "no physical keypress in the sample window" — it is NOT a claim of human absence
#     (a person can sit and read). ACTIVE is the only positive assertion; QUIET stays agnostic.
#
# Usage:
#   mesh-keypresence            sample (default 4s window) -> ACTIVE | QUIET + delta
#   mesh-keypresence <seconds>  custom window
#   mesh-keypresence --once     alias for a single sample (same as default)
#   mesh-keypresence --test     smoke test (parse + isolation logic on a synthetic fixture)
#   exit 0 = real reading · exit 2 = no dedicated keyboard IRQ (sense unreachable on this node)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"

# --- find_kbd_irq_sum <interrupts-text>: echo the SUMMED counter across CPUs for the dedicated,
# input-isolated keyboard IRQ line(s); echo nothing if none. A line qualifies iff:
#   (a) its trailing device label matches a keyboard-controller pattern (i8042|atkbd|*kbd*|keyboard)
#   (b) it is NOT shared with a non-input device (no comma-listed dma/i2c/smbus/idma/gpio on the line)
# The per-CPU counts are the pure-digit fields after the "N:" column (labels like "1-edge" carry a
# dash so they are not pure-digit and are skipped).
find_kbd_irq_sum() {
  awk '
    # device label = everything after the trigger field; we test the whole line tail for sharing
    {
      line=$0
      # qualify: keyboard controller present in the label tail
      if (line !~ /(i8042|atkbd|[Kk]eyboard|[ ,]kbd)/) next
      # isolation: reject a shared IRQ whose line also names a non-input (DMA/bus) device
      if (line ~ /(idma|dma|i2c|smbus|gpio|xhci|nvme|ahci|eth|wlan)/) next
      s=0
      for (i=2; i<=NF; i++) if ($i ~ /^[0-9]+$/) s+=$i
      total+=s; found=1
    }
    END { if (found) print total }
  ' <<<"$1"
}

if [ "${1:-}" = --test ]; then
  _f=0
  # synthetic /proc/interrupts fixtures (FALSIFIABLE: change the parser → these fail)
  dedicated='   1:       100          5 IR-IO-APIC    1-edge      i8042'          # dedicated kbd
  shared='  17:    6209715          0 IR-IO-APIC   17-fasteoi   idma64.1, i2c_designware.1'  # touchpad bus + DMA → must be EXCLUDED
  noisefan='  18:        42          0 IR-IO-APIC   18-fasteoi   ahci'            # non-input → excluded
  # (a) dedicated keyboard line → summed = 105
  [ "$(find_kbd_irq_sum "$dedicated")" = 105 ] || { echo "  FAIL: dedicated kbd IRQ sum should be 105, got '$(find_kbd_irq_sum "$dedicated")'"; _f=1; }
  # (b) DMA-shared touchpad bus → EXCLUDED (empty), never counted as input
  [ -z "$(find_kbd_irq_sum "$shared")" ] || { echo "  FAIL: DMA-shared IRQ must be excluded (got '$(find_kbd_irq_sum "$shared")')"; _f=1; }
  # (c) unrelated device → excluded
  [ -z "$(find_kbd_irq_sum "$noisefan")" ] || { echo "  FAIL: non-input IRQ must be excluded"; _f=1; }
  # (d) full fixture: only the dedicated line contributes → 105 (the trap: shared line not added)
  [ "$(find_kbd_irq_sum "$(printf '%s\n%s\n%s\n' "$dedicated" "$shared" "$noisefan")")" = 105 ] \
    || { echo "  FAIL: mixed fixture should sum ONLY the dedicated kbd (105)"; _f=1; }
  # (e) no keyboard at all (headless) → empty → caller exits 2
  [ -z "$(find_kbd_irq_sum "$noisefan")" ] || { echo "  FAIL: headless (no kbd) must yield empty"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (kbd-IRQ parse + DMA-shared isolation + headless-empty: 5 assertions)"; exit 0
fi

WIN="${1:-4}"; [ "$WIN" = --once ] && WIN=4
case "$WIN" in ''|*[!0-9]*) WIN=4 ;; esac

[ -r /proc/interrupts ] || { echo "[keypresence] UNREACHABLE — /proc/interrupts unreadable on $HOST" >&2; exit 2; }

s1="$(find_kbd_irq_sum "$(cat /proc/interrupts)")"
if [ -z "$s1" ]; then
  # honest-degraded: no dedicated keyboard IRQ → this node has no physical keyboard to sense
  # (headless VM/server). NOT a QUIET reading — the hardware sense itself is absent here.
  echo "[keypresence] UNREACHABLE — no dedicated keyboard IRQ on $HOST (headless / no physical keyboard; not 'quiet')" >&2
  exit 2
fi
sleep "$WIN"
s2="$(find_kbd_irq_sum "$(cat /proc/interrupts)")"
delta=$(( s2 - s1 ))

ts="$(date -u +%FT%TZ)"
if [ "$delta" -gt 0 ]; then
  echo "[keypresence] ACTIVE — physical keyboard input on $HOST (Δ${delta} keypress-IRQs in ${WIN}s) → a human is at this machine"
else
  echo "[keypresence] QUIET — no physical keypress on $HOST in ${WIN}s (NOT 'absent' — a person may be idle/reading)"
fi
exit 0
