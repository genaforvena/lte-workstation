#!/usr/bin/env python3
"""mesh-face-recognize — zero-shot person classification on camera frames.

Identify who is in the photo:
  - Ilya (male operator, sitting at the desk / computer)
  - Rozalia (female partner/wife, in the room)
  - Nobody (empty room/desk)
  - Stranger (any other person)

Two backends (MESH_FACE_BACKEND=auto|local|groq, default auto):
  - LOCAL  — ollama moondream on this node's GPU. Home frames NEVER leave the house,
             no cloud cost, no shared-TPD-quota drain. Preferred on mesh-home (RTX 3060).
  - GROQ   — Llama/qwen Vision in the cloud (fallback when ollama/model unreachable).
  auto: use local if ollama is up AND the model is pulled, else fall back to groq.

Usage:
  mesh-face-recognize [image.jpg]    classify the image, output one label
  mesh-face-recognize --test         smoke test (logic + a REAL live read on the active backend)

── THE BLACK HOLE: why 'Unsure' exists (LITERATURE 2026-08-17, live review) ──────────────
Source, read live: Yazan Nasrallah, "The face as political infrastructure", Media@LSE,
26 Jun 2026 — occasioned by the England & Wales High Court dismissing the Big Brother
Watch / Shaun Thompson challenge to Met LFR on 21 Apr 2026, after Thompson was
MISidentified and detained. Anchor text: Claudio Celis Bueno, "The Face Revisited: Using
Deleuze and Guattari to Explore the Politics of Algorithmic Face Recognition", Theory,
Culture & Society 37(1), 2020. Concept: Deleuze & Guattari's ABSTRACT MACHINE OF FACIALITY
(A Thousand Plateaus, plateau 7), whose mechanism is a "white wall / black hole" system
running two operations at once — BIUNIVOCALIZATION ("is it a or b?", sorting a signal into
a grid of accepted units) and BINARIZATION/REJECTIVITY ("is it a face at all?"). The
machine does not identify; it computes DEGREES OF DIVERGENCE from a norm-face, and
everything past a threshold falls into one undifferentiated black hole. Nasrallah's point
is that the deviance class is not an accident of the model but the thing the machine IS.

This organ was that machine, precisely: {Ilya, Rozalia} is the biunivocal grid and
{Nobody, Stranger} is the binary, with 'Stranger' as local_map's FALL-THROUGH — i.e. the
regex residue emitted as a positive identification of a person.

MEASURED here before changing anything (~/.mesh/imac-cam-watch.log, 449 labelled frames
over 8 days, median gap 532s): Stranger = 18 episodes, mean run 1.06 frames, max 2 — the
LEAST persistent label in the system, below even Nobody (1.37) and far below Ilya (4.18,
max 30). All 18 are bracketed by household labels; not one begins at START, ends at END,
or touches another Stranger. Ilya→Stranger→Ilya x5. A person entering a house does not
appear for one nine-minute frame between two frames of the resident, eighteen times. That
4.0% is the grid's own miss rate wearing the deviance label.

The alarm path was already defended — mesh-stranger-watch requires 2-of-2 consecutive
Stranger frames, which suppresses 17 of those 18. But corroboration living in ONE consumer
is not corroboration ("a rule asserted at one call site is not asserted"): mesh-cam-watch
and mesh-desk-state take a single raw Stranger and write cam_person=1. So the fix belongs
at the SOURCE. Giving the machine an output for "a face I cannot place" is the whole of it.
"""
import os
import sys
import base64
import json
import subprocess

import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes — and the signal is routine here, not hypothetical:
# GNU `timeout` without --foreground signals the whole PROCESS GROUP, which is how mesh-doctor's
# hourly --test sweep reaches this process. sys.exit() from a handler raises SystemExit in the MAIN
# THREAD, and that is what makes try/finally unwind. SIGKILL stays uncatchable — that half is
# mesh-tmp-guard's age sweep, never this. Class + population: mesh-tmp-guard --unwind-scan.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

import tempfile

GROQ_ENV = os.path.expanduser("~/.mesh/groq.env")


def _default_img():
    """The frame used when none is passed (and by --test's real-read gate). Honors
    MESH_FACE_DEFAULT_IMG, else the first camera frame that actually exists on this node —
    cam-prev.jpg is the fleet convention; note3-cam-last.jpg is mesh-home's live eye."""
    env = os.environ.get("MESH_FACE_DEFAULT_IMG")
    if env:
        return os.path.expanduser(env)
    for cand in ("~/.mesh/cam-prev.jpg", "~/.mesh/note3-cam-last.jpg"):
        p = os.path.expanduser(cand)
        if os.path.exists(p):
            return p
    return os.path.expanduser("~/.mesh/cam-prev.jpg")


DEFAULT_IMG = _default_img()
# MESH_FACE_MODEL: per-caller override. Default qwen (reasoning, best accuracy) suits one-shot
# reads; a POLLING caller (mesh-stranger-watch every cycle) must use a non-reasoning model on its
# OWN per-model TPD bucket (llama-4-scout) or it exhausts the shared qwen daily quota alone.
MODEL = os.environ.get("MESH_FACE_MODEL", "qwen/qwen3.6-27b")

import re

# Local backend (ollama on this node's GPU). auto → prefer local, fall back to groq.
BACKEND = os.environ.get("MESH_FACE_BACKEND", "auto").lower()  # auto | local | groq
OLLAMA_URL = os.environ.get("MESH_OLLAMA_URL", "http://localhost:11434").rstrip("/")
LOCAL_MODEL = os.environ.get("MESH_FACE_LOCAL_MODEL", "qwen3-vl:4b-instruct")

# moondream (1.6B) is the ONE local model that can't follow the strict 4-way named-identity prompt —
# it just emits "ilya" regardless (benched 2026-07-17: "ilya" on two empty-room frames, both wrong,
# a false-positive on the home-privacy path). But it DESCRIBES a scene accurately (gender + presence),
# so under moondream the local backend asks a free-text question and keyword-maps the reply — a
# GENDER+PRESENCE sense (man→Ilya, woman→Rozalia, empty→Nobody), NOT face identity.
#
# Every other local VLM DOES follow the strict prompt. qwen3-vl:4b-instruct (the default since
# 2026-07-17, benched: clean one-word labels, "Nobody" correct where moondream said "ilya") runs the
# SAME strict CLASSIFY_PROMPT + label parse as the groq path — so it can tell Stranger from household,
# not just gender. LOCAL_STRICT selects which path: strict for capable models, keyword-map for
# moondream. Force either way with MESH_FACE_LOCAL_STRICT=1|0.
_LOCAL_BASE = LOCAL_MODEL.split(":", 1)[0]
LOCAL_STRICT = os.environ.get(
    "MESH_FACE_LOCAL_STRICT", "0" if _LOCAL_BASE == "moondream" else "1") == "1"

# A full-res camera frame tokenizes to >4096 tokens under a real VLM (qwen3-vl: ~4154) — over ollama's
# DEFAULT num_ctx=4096 → HTTP 400 exceed_context_size (the swap silently breaks without this). Pin a
# larger window; moondream ignores the extra room.
LOCAL_NUM_CTX = int(os.environ.get("MESH_FACE_LOCAL_NUM_CTX", "8192"))

# Free-text prompt used ONLY on the moondream (non-strict) path. NB: the literal word "nobody" (and
# quoted tokens) make moondream return an EMPTY string every time — so the empty case is phrased "or
# is the room empty?" and local_map catches "empty"/"no one". An explicit MESH_FACE_LOCAL_PROMPT
# override wins on either path.
_LOCAL_PROMPT_OVERRIDE = os.environ.get("MESH_FACE_LOCAL_PROMPT")
LOCAL_PROMPT = _LOCAL_PROMPT_OVERRIDE or (
    "Describe the person in this photo. Is it a man or a woman, or is the room empty?")

# Word-boundary matched so "man" never fires inside "woman". Female checked first: moondream
# sometimes hedges "there is no one... the girl lying on the bed" — a named gender beats the hedge.
_FEMALE_RE = re.compile(r"\b(woman|women|girl|girls|female|lady|she|her|hers)\b", re.I)
_MALE_RE = re.compile(r"\b(man|men|boy|boys|male|gentleman|guy|he|him|his)\b", re.I)
_EMPTY_RE = re.compile(r"\b(nobody|no ?one|no person|no people|empty|unoccupied|not any (?:person|people))\b", re.I)


def local_map(text):
    """Map moondream's free-text scene answer onto our label set. Gender-word > empty-hedge.

    FALL-THROUGH IS 'Unsure', NEVER 'Stranger' (2026-08-17, the faciality read — see the
    header). This was the black hole: an unmatched reply is the RESIDUE of three regexes,
    and emitting it as 'Stranger' turns "I could not parse this" into a positive
    identification of a person who is not in the household. The empty string is the worst
    case and it is a DOCUMENTED one — the LOCAL_PROMPT comment above records that moondream
    returns "" outright under some phrasings, and "" matches no regex, so a total read
    failure rendered as an intruder. Under moondream this label was never sound anyway:
    this path is a GENDER+PRESENCE sense, not face identity, so it has no evidence with
    which to affirm "a person, and not one of ours"."""
    if _FEMALE_RE.search(text):
        return "Rozalia"
    if _MALE_RE.search(text):
        return "Ilya"
    if _EMPTY_RE.search(text):
        return "Nobody"
    return "Unsure"

# The classification prompt is shared by both backends so a local/cloud swap can't drift the labels.
CLASSIFY_PROMPT = (
    "This is a photo captured by a home security/monitoring webcam.\n"
    "Identify who is in this image. Use these instructions:\n"
    "- If there is a man in the photo (typically sitting at the computer desk / laptop), classify as 'Ilya'.\n"
    "- If there is a woman in the photo, classify as 'Rozalia'.\n"
    "- If there is nobody in the photo (empty desk/room/chair), classify as 'Nobody'.\n"
    "- If there is any other person, and you are confident they are NOT the man or the woman above, classify as 'Stranger'.\n"
    "- If a person IS present but you cannot confidently place them (bad angle, motion blur, "
    "darkness, only part of a body visible, a face in a photo/screen/mirror), classify as 'Unsure'. "
    "Do NOT guess 'Stranger' — 'Stranger' means you are sure it is someone else.\n\n"
    "Output EXACTLY one word from this list: Ilya, Rozalia, Nobody, Stranger, Unsure. Do not write any other text, explanation, or punctuation."
)
# 'Unsure' is the ABSTENTION and it is deliberately NOT a person-identification: it means the grid
# could not place what it saw. Every existing reader was checked (2026-08-17) and already fails
# closed on a label outside its own case-list — mesh-cam-watch → "?" rc2, mesh-desk-state → MOTION
# with no who= and no cam_person, mesh-room → UNKNOWN, mesh-stranger-watch → read-failure → silent,
# mesh-operator-home → only Ilya counts. So adding it REMOVES a false person-assertion from four
# consumers without touching them. Keep it LAST: canonical_label substring-matches in list order.
LABELS = ["Ilya", "Rozalia", "Nobody", "Stranger", "Unsure"]


def canonical_label(text):
    """Map a free-text model reply onto our exact label set (substring match), else return as-is."""
    if "</think>" in text:
        text = text.split("</think>", 1)[1]
    text = text.strip().strip('"').strip("'").strip(".")
    for label in LABELS:
        if label.lower() in text.lower():
            return label
    return text


def ollama_ready():
    """True iff the local ollama server answers AND the vision model is pulled — the gate that
    lets `auto` fall through to groq instead of hard-failing on a node with no GPU/model."""
    try:
        proc = subprocess.run(
            ["curl", "-s", "-m", "3", f"{OLLAMA_URL}/api/tags"],
            capture_output=True, text=True, timeout=5)
    except (subprocess.TimeoutExpired, OSError):
        return False
    if proc.returncode != 0:
        return False
    try:
        tags = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return False
    names = [m.get("name", "") for m in tags.get("models", [])]
    # moondream may be tagged "moondream:latest" — match on the family prefix.
    base = LOCAL_MODEL.split(":", 1)[0]
    return any(n == LOCAL_MODEL or n.split(":", 1)[0] == base for n in names)


def classify_image_local_safe(img_path):
    """Local ollama classification with the SAME (status, value) contract as the groq path:
      ('ok', label)   the model returned a usable reply
      ('na', reason)  ollama unreachable/timeout (transient — treat like a rate-limit, not a break)
      ('fail', reason) something actually broken (unreadable image, malformed response)"""
    try:
        base64_image = encode_image(img_path)
    except OSError as e:
        return ("fail", f"cannot read image: {e}")

    # Capable models get the strict CLASSIFY_PROMPT + direct label parse (real identity, like groq);
    # moondream gets the free-text prompt + gender/presence keyword map. An explicit prompt override
    # wins either way. num_ctx MUST be large enough for a full-res frame (see LOCAL_NUM_CTX).
    prompt = _LOCAL_PROMPT_OVERRIDE or (CLASSIFY_PROMPT if LOCAL_STRICT else LOCAL_PROMPT)
    parse = canonical_label if LOCAL_STRICT else local_map
    payload = {
        "model": LOCAL_MODEL,
        "prompt": prompt,
        "images": [base64_image],
        "stream": False,
        "options": {"temperature": 0.0, "num_ctx": LOCAL_NUM_CTX},
    }
    # Same temp-file + `-d @file` trick as the groq path: a camera-resolution base64 image blows
    # past Linux's per-argv limit if passed inline.
    req_fd, req_path = tempfile.mkstemp(prefix="face-rec-local-", suffix=".json")
    try:
        with os.fdopen(req_fd, "w") as f:
            json.dump(payload, f)
        cmd = ["curl", "-s", "-m", "60", f"{OLLAMA_URL}/api/generate",
               "-H", "Content-Type: application/json", "-d", f"@{req_path}"]
        # moondream occasionally returns an empty string on an image it can otherwise describe —
        # retry a couple of times before conceding 'na', so a transient blank isn't a lost read.
        last = None
        for _ in range(3):
            try:
                proc = subprocess.run(cmd, capture_output=True, text=True, timeout=65)
            except subprocess.TimeoutExpired:
                return ("na", "ollama generate timed out")
            if proc.returncode != 0:
                return ("na", f"curl exit {proc.returncode} (ollama unreachable): {proc.stderr.strip()[:200]}")
            try:
                data = json.loads(proc.stdout)
            except json.JSONDecodeError:
                return ("fail", f"non-JSON response: {proc.stdout[:200]}")
            if "response" not in data:
                if "error" in data:
                    return ("na", f"ollama error: {str(data['error'])[:200]}")
                return ("fail", f"no 'response' field: {proc.stdout[:200]}")
            reply = data["response"].strip()
            if reply:
                return ("ok", parse(reply))
            last = f"empty reply from {LOCAL_MODEL} (3 attempts)"
        return ("na", last)
    finally:
        try: os.remove(req_path)
        except OSError: pass

def load_groq_key():
    if not os.path.exists(GROQ_ENV):
        return None
    with open(GROQ_ENV) as f:
        for line in f:
            if line.startswith("GROQ_API_KEY="):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    return None

def encode_image(img_path):
    with open(img_path, "rb") as image_file:
        return base64.b64encode(image_file.read()).decode('utf-8')

def classify_image_safe(img_path, api_key):
    """Live classification that never sys.exit()s — returns (status, value):
      ('ok', label)   real API call produced a recognizable label
      ('na', reason)  honest unreachable/rate-limited (transient, not a break)
      ('fail', reason) something actually broken (bad key, malformed response, curl missing, ...)
    Used by both the real classify_image() (below) and --test's REAL-READ GATE, so the smoke
    test exercises the exact same live path a real run takes — no mock can catch a shared-bucket
    quota exhaustion silently drowning ~97% of real runs (2026-07-08, imac-person-log.tsv)."""
    try:
        base64_image = encode_image(img_path)
    except OSError as e:
        return ("fail", f"cannot read image: {e}")

    payload = {
        "model": MODEL,
        "messages": [
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": CLASSIFY_PROMPT},
                    {
                        "type": "image_url",
                        "image_url": {
                            "url": f"data:image/jpeg;base64,{base64_image}"
                        }
                    }
                ]
            }
        ],
        "temperature": 0.0,
        "max_tokens": 1000
    }

    # payload (embeds the base64 image) goes to a temp file + `-d @file`, NOT a curl argv element:
    # a single argv over ~128KiB trips Linux's per-argument limit ("Argument list too long") for any
    # real camera-resolution frame — mesh-object-id already avoids this the same way (req file + -d @).
    req_fd, req_path = tempfile.mkstemp(prefix="face-rec-req-", suffix=".json")
    try:
        with os.fdopen(req_fd, "w") as f:
            json.dump(payload, f)

        cmd = [
            "curl", "-s", "-m", "30",
            "https://api.groq.com/openai/v1/chat/completions",
            "-H", "Content-Type: application/json",
            "-H", f"Authorization: Bearer {api_key}",
            "-d", f"@{req_path}"
        ]
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=35)
        except subprocess.TimeoutExpired:
            return ("na", "curl timed out — Groq API unreachable")
        if proc.returncode != 0:
            return ("na", f"curl exit {proc.returncode}: {proc.stderr.strip()[:200]}")
        try:
            data = json.loads(proc.stdout)
        except json.JSONDecodeError:
            return ("fail", f"non-JSON response: {proc.stdout[:200]}")
        if "choices" not in data:
            err = data.get("error", {}) if isinstance(data, dict) else {}
            code = str(err.get("code", ""))
            msg = str(err.get("message", ""))
            if code == "rate_limit_exceeded" or "rate limit" in msg.lower():
                return ("na", f"rate-limited: {msg[:200]}")
            return ("fail", f"no choices in response: {proc.stdout[:200]}")
        result = data["choices"][0]["message"]["content"]
        return ("ok", canonical_label(result))
    finally:
        try: os.remove(req_path)
        except OSError: pass

def resolve_backend():
    """Which backend a call will actually use, honoring MESH_FACE_BACKEND + live availability.
    Returns 'local' or 'groq' (or 'none' when neither is usable)."""
    if BACKEND == "local":
        return "local"
    if BACKEND == "groq":
        return "groq" if load_groq_key() else "none"
    # auto: privacy-first — local if the GPU model is really up, else cloud fallback.
    if ollama_ready():
        return "local"
    return "groq" if load_groq_key() else "none"


def classify_safe(img_path):
    """Backend-resolving classify. Returns (status, value, backend). In `auto`, a local 'na'
    (ollama up a moment ago but the read went transient) falls through to groq when a key exists,
    so a flaky GPU never silently drops a frame that the cloud could still label."""
    backend = resolve_backend()
    if backend == "local":
        status, value = classify_image_local_safe(img_path)
        if status == "na" and BACKEND == "auto" and load_groq_key():
            gs, gv = classify_image_safe(img_path, load_groq_key())
            return (gs, gv, "groq")
        return (status, value, "local")
    if backend == "groq":
        status, value = classify_image_safe(img_path, load_groq_key())
        return (status, value, "groq")
    return ("fail", "no backend available (ollama+model down AND no Groq key)", "none")


def classify_image(img_path):
    status, value, backend = classify_safe(img_path)
    if status == "ok":
        return value
    print(f"Error ({backend} backend): {value}", file=sys.stderr)
    sys.exit(1)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--test":
        # Smoke test path
        if not subprocess.run(["which", "curl"], capture_output=True).stdout:
            print("smoke-test: FAIL (curl command missing)", file=sys.stderr)
            sys.exit(1)
        backend = resolve_backend()
        if backend == "none":
            print("smoke-test: FAIL (no backend: ollama+model down AND no Groq key)", file=sys.stderr)
            sys.exit(1)

        # Test mock encoding and payload format
        mock_data = b"fake-jpeg-data"
        base64_mock = base64.b64encode(mock_data).decode('utf-8')
        assert len(base64_mock) > 0
        
        # Test successful mock parsing
        mock_response = {
            "choices": [
                {
                    "message": {
                        "content": "  'Ilya'. "
                    }
                }
            ]
        }
        assert canonical_label(mock_response["choices"][0]["message"]["content"]) == "Ilya"

        # ── THE BLACK-HOLE GATE (see the header) ────────────────────────────────────────
        # An unplaceable reply must render the ABSTENTION, never the deviance class. The
        # empty string is the documented moondream failure and is the one that must not
        # come back as an intruder.
        fail = []
        for probe, why in (
            ("", "empty reply — the documented moondream read failure"),
            ("   \n ", "whitespace-only reply"),
            ("I cannot tell from this image.", "explicit model refusal"),
            ("A cat is sitting on the sofa.", "a non-person subject"),
            ("The image is too dark to make anything out.", "an unusable frame"),
        ):
            got = local_map(probe)
            if got == "Stranger":
                fail.append(f"local_map({why}) -> Stranger (BLACK HOLE: a miss sold as an intruder)")
            elif got != "Unsure":
                fail.append(f"local_map({why}) -> {got!r}, expected Unsure")
        # ...and the grid itself must still work, or the abstention has just eaten everything
        # (a label that only ever abstains is as useless as one that never does).
        for probe, want in (("a man at the desk", "Ilya"),
                            ("a woman in the room", "Rozalia"),
                            ("the room is empty", "Nobody")):
            got = local_map(probe)
            if got != want:
                fail.append(f"local_map({probe!r}) -> {got!r}, expected {want} (grid broken by the abstention)")
        # Stranger must remain REACHABLE on the strict path — we removed the fall-through,
        # not the class. And the strict prompt must actually offer the abstention, or the
        # model can never emit it (a label the prompt does not name is unreachable).
        # NB both of these gates were VACUOUS on first writing and the mutants caught it:
        #  - canonical_label("Unsure") round-trips even with Unsure absent from LABELS,
        #    because the fall-through returns the raw text. Probe with the label EMBEDDED in
        #    a sentence instead: only the LABELS substring match can extract it.
        #  - '"Unsure" in CLASSIFY_PROMPT' stayed true when the instruction was rewritten to
        #    say Stranger, because the word survived in the trailing output-list line.
        #    Assert the INSTRUCTION and the output list separately.
        if canonical_label("The answer is Stranger") != "Stranger":
            fail.append("strict parse can no longer extract Stranger — the class was deleted, not un-defaulted")
        if canonical_label("The answer is Unsure") != "Unsure":
            fail.append("strict parse cannot extract Unsure — the abstention is unreachable")
        if "Unsure" not in LABELS:
            fail.append("Unsure absent from LABELS — the abstention cannot be parsed back")
        if "classify as 'Unsure'" not in CLASSIFY_PROMPT:
            fail.append("CLASSIFY_PROMPT carries no 'classify as Unsure' INSTRUCTION — the model is never told when to abstain")
        if "Nobody, Stranger, Unsure" not in CLASSIFY_PROMPT:
            fail.append("CLASSIFY_PROMPT's output list omits Unsure — the model cannot emit a label it is not offered")
        # The cross-sense vocabulary is a contract (mesh-misha-eye-contact:10): the four
        # original labels must survive verbatim for the consumers that grep that exact set.
        for lab in ("Ilya", "Rozalia", "Nobody", "Stranger"):
            if lab not in LABELS:
                fail.append(f"contract label {lab} dropped from LABELS")
        if fail:
            print("smoke-test: FAIL (" + " | ".join(fail) + ")", file=sys.stderr)
            sys.exit(1)

        # REAL-READ GATE (doctrine: --test must assert a live read PRODUCES data, not just that
        # curl/key exist — the mock-only smoke test above stayed green while ~97% of real runs
        # silently failed on a drained shared Groq TPD bucket, 2026-07-08). Honest contract: a real
        # labeled reply => ok(0); rate-limited/unreachable => n/a(2), never FAIL, so mesh-land treats
        # a transient shared-quota drain as a pass, not a blocked landing; a genuinely broken call
        # (bad response shape, parse failure) => FAIL(1).
        if not os.path.exists(DEFAULT_IMG):
            print(f"smoke-test: n/a (no test image at {DEFAULT_IMG})")
            sys.exit(2)
        status, value, used = classify_safe(DEFAULT_IMG)
        if status == "ok":
            print(f"smoke-test: ok ({used} backend, live read produced real label: {value})")
            sys.exit(0)
        elif status == "na":
            print(f"smoke-test: n/a (honest — {used} backend: {value})")
            sys.exit(2)
        else:
            print(f"smoke-test: FAIL ({used} backend: {value})", file=sys.stderr)
            sys.exit(1)

    img = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_IMG
    if not os.path.exists(img):
        print(f"Error: Image not found at {img}", file=sys.stderr)
        sys.exit(1)

    verdict = classify_image(img)
    print(verdict)

if __name__ == "__main__":
    main()
