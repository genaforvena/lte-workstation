#!/usr/bin/env bash
# phone-setup — one-shot deploy script to configure Termux:Boot autostart on the phone body.
# Run FROM the IdeaPad (or any mesh node with SSH access to the phone).
# Creates ~/.termux/boot/start.sh on the phone: wakelock + sshd + keepalive loop.
#
#   phone-setup                    auto-detect phone IP and user
#   phone-setup [user@]ip[:port]   override (e.g. u0_a380@192.168.8.146:8022)
#   phone-setup --test             smoke test (SSH + connectivity check, no writes)
#
# Auto-detection: tries PHONE_IP/PHONE_USER env vars, then ~/.mesh/nodes, then known
# LAN fallbacks (192.168.8.146, 192.168.8.203). Tries users u0_a380, u0_a386 in order.
# Set PHONE_IP / PHONE_USER / PHONE_SSH_PORT in ~/.mesh/nodes to pin the values.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_IP="${PHONE_IP:-}"
PHONE_USER="${PHONE_USER:-}"

# parse override arg: [user@]ip[:port]
parse_override(){
  local arg="$1"
  # strip user@ prefix
  if [[ "$arg" == *@* ]]; then
    PHONE_USER="${arg%%@*}"
    arg="${arg#*@}"
  fi
  # strip :port suffix
  if [[ "$arg" == *:* ]]; then
    PHONE_PORT="${arg##*:}"
    arg="${arg%:*}"
  fi
  PHONE_IP="$arg"
}

# probe a single user@ip over SSH; return 0 if connected
probe_ssh(){
  local user="$1" ip="$2" port="$3"
  timeout 10 ssh -p "$port" -o BatchMode=yes -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=accept-new "${user}@${ip}" 'echo ok' </dev/null >/dev/null 2>&1
}

# auto-detect: try all known LAN IPs x known users
auto_detect(){
  local reg_ip
  local -a candidate_ips=()
  # try registry first
  reg_ip="$(mesh-peer-addr Redmi 2>/dev/null || mesh-peer-addr redmi 2>/dev/null || true)"
  [ -n "$reg_ip" ] && candidate_ips+=("$reg_ip")
  # known LAN fallbacks (order: 146 first, 203 second)
  candidate_ips+=(192.168.8.146 192.168.8.203)
  # user order: u0_a380 observed 2026-06-14 (drifts on Termux reinstall), then u0_a386
  local -a candidate_users=(u0_a380 u0_a386)

  for ip in "${candidate_ips[@]}"; do
    for user in "${candidate_users[@]}"; do
      printf 'trying %s@%s:%s ... ' "$user" "$ip" "$PHONE_PORT" >&2
      if probe_ssh "$user" "$ip" "$PHONE_PORT"; then
        printf 'OK\n' >&2
        PHONE_USER="$user"
        PHONE_IP="$ip"
        return 0
      else
        printf 'no\n' >&2
      fi
    done
  done
  return 1
}

# handle args
MODE=""
for arg in "$@"; do
  case "$arg" in
    --test) MODE="test";;
    -*) echo "phone-setup: unknown flag $arg" >&2; exit 1;;
    *) parse_override "$arg";;
  esac
done

# resolve phone address
if [ -z "$PHONE_IP" ]; then
  echo "auto-detecting phone..." >&2
  if ! auto_detect; then
    echo "ERROR: could not reach phone on any known IP/user" >&2
    echo "  Set PHONE_IP / PHONE_USER in ~/.mesh/nodes, or pass user@ip as an argument." >&2
    exit 1
  fi
elif [ -z "$PHONE_USER" ]; then
  # IP known, user unknown — probe users
  found=0
  for user in u0_a380 u0_a386; do
    printf 'trying %s@%s:%s ... ' "$user" "$PHONE_IP" "$PHONE_PORT" >&2
    if probe_ssh "$user" "$PHONE_IP" "$PHONE_PORT"; then
      printf 'OK\n' >&2
      PHONE_USER="$user"
      found=1
      break
    else
      printf 'no\n' >&2
    fi
  done
  [ "$found" = 1 ] || { echo "ERROR: could not authenticate to $PHONE_IP on any known user" >&2; exit 1; }
else
  # both known — still verify reachability
  printf 'verifying %s@%s:%s ... ' "$PHONE_USER" "$PHONE_IP" "$PHONE_PORT" >&2
  if probe_ssh "$PHONE_USER" "$PHONE_IP" "$PHONE_PORT"; then
    printf 'OK\n' >&2
  else
    echo "ERROR: cannot reach ${PHONE_USER}@${PHONE_IP}:${PHONE_PORT}" >&2; exit 1
  fi
fi

echo "phone: ${PHONE_USER}@${PHONE_IP}:${PHONE_PORT}" >&2

if [ "$MODE" = "test" ]; then
  echo "smoke-test: ok (phone reachable; no writes in --test mode)"
  exit 0
fi

# deploy the Termux:Boot startup script via SSH heredoc-over-stdin
echo "creating ~/.termux/boot/start.sh on phone..." >&2
ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=10 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@${PHONE_IP}" \
  'mkdir -p ~/.termux/boot && cat > ~/.termux/boot/start.sh' </dev/null <<'BOOT'
#!/data/data/com.termux/files/usr/bin/bash
# Termux:Boot autostart — runs on every Android boot
termux-wake-lock                        # prevent CPU sleep
sshd                                    # start SSH server
# Keep termux alive (Termux:Boot requires the process to not exit)
while true; do sleep 3600; done
BOOT

# make it executable in a separate call (stdin consumed above)
ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=10 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@${PHONE_IP}" \
  'chmod +x ~/.termux/boot/start.sh' </dev/null

# verify
echo "verifying..." >&2
result="$(ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=10 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@${PHONE_IP}" \
  'test -x ~/.termux/boot/start.sh && echo "exists+executable" || echo "MISSING"' </dev/null 2>&1)"

if [ "$result" = "exists+executable" ]; then
  echo "phone-setup: OK — ~/.termux/boot/start.sh deployed and executable"
  echo "  Phone will auto-start sshd + wake-lock on every Android boot (Termux:Boot must be installed)."
else
  echo "phone-setup: FAIL — file check returned: $result" >&2
  exit 1
fi
