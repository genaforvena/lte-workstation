#!/usr/bin/env bash
# reflex-cadence: 17 */2 * * *
# reflex-args: --edge
# mesh-battery-voltage — local battery VOLTAGE sense.
#
# WHY this is new: the tree already knows battery health, AC state, and power flow, but not the raw
# battery voltage itself. That voltage is a real hardware signal exposed by the kernel and is useful
# as a coarse electrical-state cue on its own.
#
# Honest contract: no readable battery voltage source -> exit 2, never a fabricated value.
#
#   mesh-battery-voltage          one voltage line
#   mesh-battery-voltage --json    machine-readable JSON
#   mesh-battery-voltage --edge    emit only on band change
#   mesh-battery-voltage --test    smoke test (fixtures + reachability gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.battery-voltage.state"
OFFLINEFILE="$MESH/.battery-voltage-offline"
mkdir -p "$MESH" 2>/dev/null || true

discover_battery() {
  local d
  for d in /sys/class/power_supply/*/; do
    [ -d "$d" ] || continue
    [ -r "${d}type" ] || continue
    [ -r "${d}voltage_now" ] || continue
    case "$(cat "${d}type" 2>/dev/null)" in
      Battery) printf '%s' "${d%/}"; return 0 ;;
    esac
  done
  for d in /sys/class/hwmon/hwmon*/; do
    [ -d "$d" ] || continue
    [ -r "${d}name" ] || continue
    [ -r "${d}in0_input" ] || continue
    case "$(cat "${d}name" 2>/dev/null)" in
      BAT0|battery|Battery) printf '%s' "${d%/}"; return 0 ;;
    esac
  done
  return 1
}

format_v() {
  awk -v uv="${1:-}" 'BEGIN{
    if (uv == "" || uv !~ /^[0-9]+$/) exit 1
    printf "%.3f", uv / 1000000
  }'
}

classify_voltage() {
  local uv="${1:-}"
  case "$uv" in ''|*[!0-9]*) echo UNKNOWN; return ;; esac
  if   [ "$uv" -lt 7600000 ]; then echo LOW
  elif [ "$uv" -lt 8300000 ]; then echo MID
  else                             echo HIGH
  fi
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  [ "$(format_v 8439000)" = "8.439" ] || { echo "smoke-test: FAIL (format 8439000 -> $(format_v 8439000), want 8.439)"; exit 1; }
  [ "$(classify_voltage 7500000)" = LOW ] || { echo "smoke-test: FAIL (7.5V boundary -> LOW)"; exit 1; }
  [ "$(classify_voltage 8000000)" = MID ] || { echo "smoke-test: FAIL (8.0V -> MID)"; exit 1; }
  [ "$(classify_voltage 8439000)" = HIGH ] || { echo "smoke-test: FAIL (8.439V -> HIGH)"; exit 1; }
  [ "$(classify_voltage '')" = UNKNOWN ] || { echo "smoke-test: FAIL (empty -> UNKNOWN)"; exit 1; }
  bat="$(discover_battery 2>/dev/null || true)"
  [ -n "$bat" ] || { echo "smoke-test: n/a (no readable battery voltage source on this node); classify-logic ok"; exit 2; }
  [ -r "$bat/voltage_now" ] || { echo "smoke-test: FAIL (battery path lacks voltage_now: $bat)"; exit 1; }
  uv="$(cat "$bat/voltage_now" 2>/dev/null || true)"
  [ -n "$uv" ] || { echo "smoke-test: FAIL (battery voltage_now unreadable at $bat)"; exit 1; }
  echo "smoke-test: ok (format + classify + live battery voltage source)"
  exit 0
fi

JSON=0; EDGE=0
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --edge) EDGE=1 ;;
  esac
done

bat="$(discover_battery 2>/dev/null || true)"
[ -n "$bat" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "battery-voltage: UNREACHABLE — no readable battery voltage source" >&2; : > "$OFFLINEFILE"; }
  exit 2
}

uv="$(cat "$bat/voltage_now" 2>/dev/null || true)"
[ -n "$uv" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "battery-voltage: UNREACHABLE — battery voltage_now unreadable" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

band="$(classify_voltage "$uv")"
volts="$(format_v "$uv")" || { echo "battery-voltage: UNREACHABLE — invalid voltage '$uv'"; exit 2; }
host="$(hostname)"
ts="$(date -u +%FT%TZ)"

status=""
capacity=""
[ -r "$bat/status" ] && status="$(cat "$bat/status" 2>/dev/null || true)"
[ -r "$bat/capacity" ] && capacity="$(cat "$bat/capacity" 2>/dev/null || true)"

printf '%s|%s|%s|%s|%s|%s|%s\n' "$band" "$uv" "$volts" "$status" "$capacity" "$bat" "$ts" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"band":"%s","voltage_uv":%s,"voltage_v":%s,"status":"%s","capacity":%s,"source":"%s","ts":"%s"}\n' \
    "$band" "$uv" "$volts" "${status:-unknown}" "${capacity:-null}" "$bat" "$ts"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE.prev" 2>/dev/null || true)"
  printf '%s\n' "$band" > "$STATE.prev"
  [ "$band" = "$prev" ] && exit 0
fi

printf '[battery-voltage] %s — %sV (status=%s capacity=%s%% source=%s) @ %s %s\n' \
  "$band" "$volts" "${status:-unknown}" "${capacity:-?}" "$bat" "$host" "$ts"
