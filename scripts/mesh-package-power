#!/usr/bin/env bash
# mesh-package-power — CPU package watt-draw sense (Intel RAPL): the LEADING thermal signal.
#
# Reads /sys/class/powercap/intel-rapl:0/energy_uj twice (~2s apart), wrap-safe µJ-delta / µs
# elapsed → real package watts. Everything else the mesh consumes for the thermal axis is LAGGING
# (coretemp rises AFTER the heat is made; battery %/load lag further) — watt-draw jumps the instant
# minds start burning, seconds before the die heats toward the 93-97°C throttle that starves the
# operator channel (memory thermal-throttle-starves-operator-channel). This sense gives the
# shed decision a head start (find: capability-rapl-package-power-20260702.md).
#
# Access: the counter is 0400 root (post-Spectre RAPL side-channel restriction); read via
# `sudo -n cat` (NOPASSWD verified live on this node 2026-07-02, health-verified 09:04Z).
# A test fixture path (MESH_RAPL_PATH) that IS readable is read with plain cat.
#
# COVERAGE — the ~2s window on a */5 cadence saw 0.67% of wallclock (window-cadence-aliasing sweep,
# docs/window-cadence-coverage-2026-08-15.md). energy_uj is a MONOTONIC ACCUMULATOR (wrapping at
# max_energy_range_uj): the tool differenced it 2s apart and threw the counters away, so 99.3% of
# every interval went unobserved. On a LEADING thermal signal that is the wrong 0.67% to keep — a
# mind-burn that starts and ends between two cron ticks left this sense reporting LOW, honestly, and
# the shed decision never got the head start the sense exists to give. Carrying the counters in the
# state file and delta'ing ACROSS runs covers 100% of the interval at zero cost.
# BOTH windows are kept (the interval mean dilutes a 20-second burn; the 2s one misses everything
# between ticks), folded with a max that NAMES its winner (won=inst|iv), coverage published IN the
# reading (window=inst+iv), and missing evidence renders na — never 0 W, which on this axis reads as
# a cold idle machine. Wrap adds an na case the in-run window never had: across an interval the
# counter can wrap more than once, each extra wrap ADDS max to the true energy, so the usual single
# correction comes out too SMALL — a fabricated calm that looks perfectly ordinary. Nothing in the
# two values says how many wraps happened; what decides it is PHYSICS (a package cannot exceed
# MAX_PLAUSIBLE_W), so the reading is published only when the next wrap candidate is impossible, and
# renders na when two candidates both fit under the ceiling (see iv_watts).
#
# Honest n/a: no RAPL / sudo -n denied → exit 2 (UNREACHABLE), never a fabricated wattage.
# State artifact ~/.mesh/.package-power-state is written EVERY run (mtime = liveness, no
# state-touch needed); per-run log ~/.mesh/power.log accumulates calibration telemetry.
#
# BANDS ARE NO LONGER ABSOLUTE WATTS. They were, and they died silently on 2026-08-14 when this
# node was swapped to AMD: an inherited Intel table (9 W / 15 W) put every one of 7811 logged
# samples in HIGH for 47 days while the watts under the word ranged 5.4x. They are now cut from
# this node's OWN corpus (power.log p25/p75), so all three are reachable by construction and re-cut
# themselves at the next hardware swap; --test asserts that reachability against the live corpus
# rather than against any number, and the ladder ends in an UNRANKED refusal, never in a constant.
# See the block above LOW_W/HIGH_W. The cap note that used to live here is separately FALSE on this
# hardware: checked 2026-08-15, /sys/class/powercap/intel-rapl:0/ holds only enabled/energy_uj/
# max_energy_range_uj/name — there is no constraint_* file at all (AMD Ryzen 7 5700X, domain
# "package-0"), so cap_w renders `?` and the reading it was meant to caveat never existed.
#
#   mesh-package-power          one ~2s sample: watts + LOW/NORMAL/HIGH/UNRANKED, state + log
#   mesh-package-power --json   same sample, JSON
#   mesh-package-power --status last state-file reading, no new sample
#   mesh-package-power --test   fixture math (delta, wrap, classify) + REAL-READ GATE + the BAND
#                               REACHABILITY gate (every band this tool can print must hold rows in
#                               the live corpus — a band 0 samples can reach is a dead verdict)
#                               (live sample must yield finite positive watts; exit 2 if no RAPL)
#
# CORE/UNCORE SPLIT (literature/wire-rapl-core-uncore 2026-07-04, capability-rapl-core-uncore-
# split-20260704.md): package-total watts conflates CPU-compute load with iGPU/memory-subsystem
# load. intel-rapl:0 exposes two child subdomains (intel-rapl:0:0=core, intel-rapl:0:1=uncore) —
# same wrap-safe delta-sampling as the package counter, sampled over the SAME t1/t2 window.
# THE SUBDOMAIN'S NAME IS THE INTEL ONE ON EVERY VENDOR, AND ITS SCOPE IS NOT. On Intel, :0:0 is
# PP0 = the package's cores in aggregate, and package - core really is uncore. On AMD Zen the same
# node is fed by MSR_AMD_CORE_ENERGY_STAT, which is PER-CORE — whichever core the read landed on —
# so it is not package-scope, package - core is NOT uncore, and core= printed beside the package
# figure is not a comparable quantity. Every emission therefore carries core_scope beside the
# number (see core_scope()); this box additionally exposes no intel-rapl:0:1 at all, so uncore
# correctly abstains rather than being derived by a subtraction across two different scopes.
# Best-effort/non-fatal: an older kernel or non-Intel node without these children still gets the
# package figure exactly as before (core_w/uncore_w just read "?" — honest-unknown, never fatal;
# the package reading remains the load-bearing signal, this is a complementary attribution only).
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

RAPL="${MESH_RAPL_PATH:-/sys/class/powercap/intel-rapl:0/energy_uj}"
RAPL2="${MESH_RAPL_PATH2:-$RAPL}"                 # second fixture for deterministic --test deltas
MAXP="${MESH_RAPL_MAX_PATH:-/sys/class/powercap/intel-rapl:0/max_energy_range_uj}"
CAPP="${MESH_RAPL_CAP_PATH:-/sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw}"
RAPL_CORE="${MESH_RAPL_CORE_PATH:-/sys/class/powercap/intel-rapl:0/intel-rapl:0:0/energy_uj}"
RAPL_CORE2="${MESH_RAPL_CORE_PATH2:-$RAPL_CORE}"
MAXP_CORE="${MESH_RAPL_CORE_MAX_PATH:-/sys/class/powercap/intel-rapl:0/intel-rapl:0:0/max_energy_range_uj}"
RAPL_UNCORE="${MESH_RAPL_UNCORE_PATH:-/sys/class/powercap/intel-rapl:0/intel-rapl:0:1/energy_uj}"
RAPL_UNCORE2="${MESH_RAPL_UNCORE_PATH2:-$RAPL_UNCORE}"
MAXP_UNCORE="${MESH_RAPL_UNCORE_MAX_PATH:-/sys/class/powercap/intel-rapl:0/intel-rapl:0:1/max_energy_range_uj}"
SECS="${MESH_PKG_SAMPLE_SECS:-2}"
# --- BAND EDGES ARE CUT FROM THIS NODE'S OWN CORPUS, never from a constant -----------------------
# The 9 W / 15 W edges this file carried until 2026-08-30 were cut on the Intel IdeaPad where
# near-idle was 7.05 W. The node was swapped to AMD Zen on 2026-07-14; the table was not, and the
# bands died with the swap: 7811/7811 logged samples read HIGH (100.00%), the observed MINIMUM
# sitting 2.1x above the HIGH edge and 3.5x above the LOW edge, so LOW and NORMAL were not merely
# unvisited but UNREACHABLE — the verdict word carried zero bits while the watts under it carried a
# 5.4x range, and mesh-stress's CALM->WARM pkg_lead promotion fired on every evaluation for 47 days.
# (CLAUDE.md: an-input-swap-under-a-fixed-band-table-kills-the-bands-it-keeps · a-saturated-level-
# is-not-a-state.) So the edges are now a POSITION in the axis's measured reachable range — the
# corpus's own p25/p75 — which makes all three bands reachable BY CONSTRUCTION on whatever hardware
# this is, and re-cuts itself the next time the hardware changes.
# The ladder never ends in a constant (calibrate-a-derived-axis-against-the-live-corpus): a pin, then
# this corpus, then the last cut measured on THIS hardware, then an honest refusal to rank. Each
# names itself in band_src, so a consumer can weigh the verdict instead of guessing what produced it.
BAND_LO_PCT="${MESH_PKG_BAND_LO_PCT:-25}"         # percentile of the live corpus that cuts LOW|NORMAL
BAND_HI_PCT="${MESH_PKG_BAND_HI_PCT:-75}"         # percentile that cuts NORMAL|HIGH
BAND_MIN_N="${MESH_PKG_BAND_MIN_N:-200}"          # fewer rows than this cannot cut a band
BAND_CACHE="${MESH_PKG_BAND_CACHE:-$HOME/.mesh/.package-power-bands}"
PIN_LO="${MESH_PKG_LOW_W:-}"                      # an explicit pin (operator or --test) wins its edge
PIN_HI="${MESH_PKG_HIGH_W:-}"
LOW_W='?'; HIGH_W='?'; BAND_SRC='none'            # resolved by resolve_bands, below
STATE="${MESH_PKG_STATE:-$HOME/.mesh/.package-power-state}"
LOG="${MESH_PKG_LOG:-$HOME/.mesh/power.log}"
MAX_IV_AGE="${MESH_PKG_MAX_IV_AGE:-1200}"     # baseline older than this → interval na (4x the */5 cadence)
# A PHYSICAL upper bound on what this package can draw — the only thing that can decide how many
# times the energy counter wrapped across an interval (see iv_watts). It must sit ABOVE the node's
# real peak (a burn past the bound renders na) and BELOW max_energy_range/interval (or every reading
# is ambiguous and renders na). Measured here: Ryzen 7 5700X, 65 W TDP / ~88 W PPT, observed
# 62-76 W package, max_energy_range 65.5 kJ → at the */5 cadence the next wrap candidate sits 218 W
# above the first, so 200 leaves a wide margin on both sides. There is no constraint_0_power_limit_uw
# on this AMD domain to read it from — the file the header's "200 W firmware cap" refers to does not
# exist here (checked 2026-08-15), so this is a stated assumption, not a hardware read.
MAX_PLAUSIBLE_W="${MESH_PKG_MAX_PLAUSIBLE_W:-200}"

read_uj(){ # $1=path — plain cat when readable (fixtures), sudo -n for the 0400 root counter
  local v
  if [ -r "$1" ]; then v=$(cat "$1" 2>/dev/null); else v=$(sudo -n cat "$1" 2>/dev/null); fi
  case "$v" in (''|*[!0-9]*) return 1;; esac
  printf '%s' "$v"
}

watts_between(){ # $1=e1_uj $2=e2_uj $3=dt_us $4=max_range_uj → watts (wrap-safe: µJ/µs = W)
  awk -v a="$1" -v b="$2" -v us="$3" -v max="$4" \
    'BEGIN{ d=b-a; if (d<0) d+=max; if (us<=0 || d<0) exit 1; printf "%.2f", d/us }'
}

# iv_watts <prev_epoch> <prev_uj> <now_epoch> <now_uj> <max_range_uj> <max_age_s> <max_plausible_w>
#   -> watts over the ACROSS-RUN interval, or "na".
# MISSING EVIDENCE RENDERS na, NEVER 0 — and on a watt axis a fabricated 0 is a fabricated COLD
# MACHINE, the exact reading that would tell the shed logic to relax. Refused: no baseline (first
# run / pre-upgrade state line), a garbage field, dt<=0, a baseline past max_age (the reflex was
# down — never average across an unobserved gap), a max_energy_range that CHANGED (a different RAPL
# domain, so the wrap arithmetic no longer applies), a first candidate already above max_plausible
# (a symptom, not a measurement), and an AMBIGUOUS wrap count — see the awk body.
iv_watts(){
  local pe="$1" pv="$2" ne="$3" nv="$4" maxr="$5" maxage="$6" maxw="$7" dt _f
  for _f in "$pe" "$pv" "$ne" "$nv" "$maxr"; do
    case "$_f" in ''|*[!0-9]*) printf 'na'; return;; esac
  done
  dt=$(( ne - pe ))
  [ "$dt" -gt 0 ] || { printf 'na'; return; }
  [ "$dt" -le "$maxage" ] || { printf 'na'; return; }
  awk -v a="$pv" -v b="$nv" -v us="$(( dt * 1000000 ))" -v max="$maxr" -v cap="$maxw" 'BEGIN{
    # The counter wrapped k>=0 times in this interval and NOTHING in the two values says which k.
    # Every k is arithmetically consistent (energy = d + k*max), and each extra wrap ADDS max — so
    # the usual single correction silently picks the SMALLEST, i.e. a fabricated calm that looks
    # perfectly ordinary. What decides k is PHYSICS: the package cannot draw more than `cap` watts.
    #   w0 = the smallest candidate. If even w0 exceeds cap, this is not a reading, it is a symptom.
    #   w1 = the next candidate. If w1 is ALSO physically possible, two different answers survive
    #        and the honest output is na — never the smaller one just because it came first.
    # This is self-adapting: at a 300 s interval on this node max/us is 218 W, so w1 clears any
    # plausible w0 by more than cap and the interval is decidable; stretch the interval toward an
    # hour and max/us shrinks until both candidates fit under cap, which is exactly when the reading
    # stops being knowable. A fixed "dt too long" rule cannot express that — the counter size, the
    # interval and the ceiling decide it together.
    d=b-a; if (d<0) d+=max;
    w0=d/us; w1=(d+max)/us;
    if (w0 > cap) { printf "na"; exit }
    if (w1 <= cap) { printf "na"; exit }
    printf "%.2f", w0;
  }'
}

# fold_w <inst> <iv|na> -> "<fused> <winner>"  (winner: inst|iv; na loses, ties name inst)
# The louder window wins. Naming it is not decoration: "the package drew 60 W across the last five
# minutes" and "the two seconds I watched drew 60 W" are different claims about the thermal future.
fold_w(){
  local inst="$1" iv="${2:-na}"
  case "$iv" in ''|na) printf '%s inst\n' "$inst"; return;; esac
  awk -v a="$inst" -v b="$iv" 'BEGIN{ if (b+0 > a+0) printf "%s iv\n", b; else printf "%s inst\n", a }'
}

# cut_bands <corpus-log> -> "lo hi n" on stdout, or empty (and rc 1) when the corpus cannot cut.
# Field 2 of the calibration tape is the published fused watts. A corpus whose two percentiles
# COINCIDE is refused: identical edges make NORMAL a band nothing can land in, which is the very
# defect this replaces, only wearing a measured number instead of an inherited one.
cut_bands(){
  local log="$1" out
  [ -s "$log" ] || return 1
  # `sort -n` and not gawk's asort: this tool is planted on nodes carrying mawk/busybox awk, where
  # asort does not exist and its absence would render as an uncuttable corpus on every one of them.
  out=$(awk '$2 ~ /^[0-9]+\.?[0-9]*$/ {print $2+0}' "$log" 2>/dev/null | sort -n \
        | awk -v lop="$BAND_LO_PCT" -v hip="$BAND_HI_PCT" -v minn="$BAND_MIN_N" '
      { v[++n]=$1+0 }
      END{
        if (n < minn) exit 1
        li=int(n*lop/100)+1; hi=int(n*hip/100)+1
        if (li>n) li=n; if (hi>n) hi=n
        if (v[hi] <= v[li]) exit 1          # degenerate spread — cannot cut three live bands
        printf "%.2f %.2f %d", v[li], v[hi], n
      }') || return 1
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# resolve_bands — fills LOW_W / HIGH_W / BAND_SRC. Ladder, each rung naming itself:
#   pinned  an explicit MESH_PKG_LOW_W / MESH_PKG_HIGH_W (per edge)
#   corpus  cut from this node's own log right now, and cached
#   cache   the last cut measured on THIS hardware, with its age published
#   none    no evidence — the edge stays '?' and classify refuses to rank. NEVER a constant.
resolve_bands(){
  local cut lo hi n cs cached cage
  LOW_W='?'; HIGH_W='?'
  local slo='none' shi='none'
  [ -n "$PIN_LO" ] && { LOW_W="$PIN_LO";  slo='pinned'; }
  [ -n "$PIN_HI" ] && { HIGH_W="$PIN_HI"; shi='pinned'; }
  if [ "$LOW_W" = '?' ] || [ "$HIGH_W" = '?' ]; then
    if cut=$(cut_bands "$LOG"); then
      read -r lo hi n <<<"$cut"
      cs="corpus:n=$n"
      mkdir -p "$(dirname "$BAND_CACHE")" 2>/dev/null
      printf '%s %s %s %s\n' "$lo" "$hi" "$n" "$(date -u +%FT%TZ)" >"$BAND_CACHE" 2>/dev/null
    elif [ -s "$BAND_CACHE" ]; then
      read -r lo hi n _ <<<"$(cat "$BAND_CACHE")"
      case "${lo:-}${hi:-}" in (''|*[!0-9.]*) lo=''; hi='';; esac
      cage=$(( $(date +%s) - $(date -r "$BAND_CACHE" +%s 2>/dev/null || date +%s) ))
      cs="cache:age=${cage}s,n=${n:-?}"
    fi
    if [ -n "${lo:-}" ] && [ -n "${hi:-}" ]; then
      [ "$LOW_W"  = '?' ] && { LOW_W="$lo";  slo="$cs"; }
      [ "$HIGH_W" = '?' ] && { HIGH_W="$hi"; shi="$cs"; }
    fi
  fi
  BAND_SRC="lo=$slo,hi=$shi"
}

# classify — an edge we do not have cannot rule. A missing edge renders UNRANKED, never a band:
# fabricating LOW here would be a fabricated cold machine, the one reading that tells the shed
# logic to relax. mesh-stress's pkg_lead bumps on the literal word HIGH only, so UNRANKED is inert
# for the single consumer that opens this bit (verified by grep 2026-08-30, no other reader).
classify(){ # $1=watts
  awk -v w="$1" -v hi="$HIGH_W" -v lo="$LOW_W" \
    'BEGIN{
       hk = (hi != "?"); lk = (lo != "?")
       if (hk && w+0 >= hi+0) { print "HIGH"; exit }
       if (lk && w+0 <  lo+0) { print "LOW";  exit }
       if (hk && lk)          { print "NORMAL"; exit }
       print "UNRANKED"
     }'
}
resolve_bands

# core_scope — what intel-rapl:0:0 ACTUALLY measures on this silicon. The domain is NAMED "core" by
# the powercap tree on every vendor, but the name is the Intel one: on Intel it is PP0, the
# package's cores in aggregate, and subtracting it from the package yields uncore. On AMD Zen the
# same node is fed by MSR_AMD_CORE_ENERGY_STAT, which is PER-CORE — the energy of whichever core the
# read landed on — so it is not package-scope, `package - core` is not uncore, and the two figures
# printed side by side are not comparable quantities. Publishing the scope beside the number is the
# whole fix (the uncore=? abstention was already correct: this box exposes no intel-rapl:0:1).
# The word is derived from the VENDOR, which is a structural fact about the counter; the pinned-
# spinner cpu0-vs-cpu9 discrimination that first exposed it is corroboration and is not re-driven
# here (a --test that burns cores to re-confirm a structural premise is the wrong trade).
core_scope(){
  case "$(sed -n 's/^vendor_id[[:space:]]*:[[:space:]]*//p' "${MESH_CPUINFO:-/proc/cpuinfo}" 2>/dev/null | head -1)" in
    (AuthenticAMD) echo 'per-core:amd-core-energy';;
    (GenuineIntel) echo 'pkg-cores:intel-pp0';;
    (*)            echo 'scope-unknown-vendor';;
  esac
}
CORE_SCOPE="$(core_scope)"

if [ "${1:-}" = "--test" ]; then
  fail=0
  td=$(mktemp -d); trap 'rm -rf "$td"' EXIT
  # fixture delta: 14,000,000 µJ over 2,000,000 µs = 7.00 W
  w=$(watts_between 1000000 15000000 2000000 262143328850)
  [ "$w" = "7.00" ] || { echo "  FAIL: plain delta → $w (want 7.00)"; fail=1; }
  # wrap: e2 < e1 must add max_energy_range, same 7.00 W
  w=$(watts_between 262143328000 13999150 2000000 262143328850)
  [ "$w" = "7.00" ] || { echo "  FAIL: wrap-safe delta → $w (want 7.00)"; fail=1; }
  watts_between 1000 2000 0 100 >/dev/null 2>&1 && { echo "  FAIL: zero-interval must error"; fail=1; }
  # classify against EXPLICIT edges — the constants that used to sit here were the defect
  ( LOW_W=9; HIGH_W=15
    [ "$(classify 7.05)" = LOW ]     || { echo "  FAIL: classify(7.05) != LOW"; exit 1; }
    [ "$(classify 12.0)" = NORMAL ]  || { echo "  FAIL: classify(12.0) != NORMAL"; exit 1; }
    [ "$(classify 9.0)"  = NORMAL ]  || { echo "  FAIL: classify(9.0) != NORMAL (boundary)"; exit 1; }
    [ "$(classify 15.0)" = HIGH ]    || { echo "  FAIL: classify(15.0) != HIGH (boundary)"; exit 1; } ) || fail=1

  # ---- AN EDGE WE DO NOT HAVE CANNOT RULE ------------------------------------------------------
  # A missing edge must render UNRANKED, never a band. The failure direction matters on this axis:
  # a fabricated LOW is a fabricated cold machine, the one reading that tells the shed logic to relax.
  ( LOW_W='?'; HIGH_W='?'
    [ "$(classify 70)" = UNRANKED ] || { echo "  FAIL: no edges at all must render UNRANKED, got $(classify 70)"; exit 1; } ) || fail=1
  ( LOW_W='?'; HIGH_W=120
    [ "$(classify 150)" = HIGH ]     || { echo "  FAIL: a known HIGH edge must still rule above it"; exit 1; }
    [ "$(classify 70)"  = UNRANKED ] || { echo "  FAIL: below a known hi with lo unknown is UNRANKED, not $(classify 70) — LOW vs NORMAL is undecidable"; exit 1; } ) || fail=1

  # ---- THE BANDS MUST BE CUTTABLE, AND CUT FROM A SPREAD ---------------------------------------
  printf '%s\n' "$(for i in $(seq 1 400); do echo "T $(( 20 + i % 100 )).00 X"; done)" >"$td/corpus"
  _cb=$(cut_bands "$td/corpus") || _cb=""
  [ -n "$_cb" ] || { echo "  FAIL: a 400-row spread corpus produced no band cut"; fail=1; }
  read -r _clo _chi _cn <<<"${_cb:-0 0 0}"
  awk -v lo="$_clo" -v hi="$_chi" 'BEGIN{exit !(hi+0 > lo+0)}' \
    || { echo "  FAIL: cut produced hi=$_chi not above lo=$_clo"; fail=1; }
  [ "$_cn" = 400 ] || { echo "  FAIL: cut reported n=$_cn over a 400-row corpus"; fail=1; }
  # too few rows cannot cut; a DEGENERATE corpus (no spread) must be refused rather than cut into
  # a NORMAL band nothing can land in — the same defect this replaces, wearing a measured number
  # NOTE the spread: a flat 50-row fixture is ALSO degenerate, so the zero-spread guard refuses it
  # and this arm can never witness the min-n guard at all (measured — the min-n mutant ran green).
  for i in $(seq 1 50); do echo "T $(( 20 + i )).00 X"; done >"$td/small"
  cut_bands "$td/small" >/dev/null 2>&1 && { echo "  FAIL: a 50-row corpus must not cut (min $BAND_MIN_N)"; fail=1; }
  for i in $(seq 1 400); do echo "T 77.00 X"; done >"$td/flat"
  cut_bands "$td/flat" >/dev/null 2>&1 && { echo "  FAIL: a degenerate (zero-spread) corpus must be refused, not cut"; fail=1; }
  : >"$td/empty"
  cut_bands "$td/empty" >/dev/null 2>&1 && { echo "  FAIL: an empty corpus must not cut"; fail=1; }

  # ---- THE LADDER NEVER ENDS IN A CONSTANT -----------------------------------------------------
  # No pin, no corpus, no cache => the edges stay '?' and the tool refuses to rank. This is the arm
  # that goes red if anyone reinstates an inherited default at the bottom of resolve_bands.
  _lr=$( LOG="$td/empty" BAND_CACHE="$td/nocache" PIN_LO='' PIN_HI=''
         resolve_bands; printf '%s|%s|%s|%s' "$LOW_W" "$HIGH_W" "$BAND_SRC" "$(classify 70)" )
  [ "$_lr" = '?|?|lo=none,hi=none|UNRANKED' ] \
    || { echo "  FAIL: with no pin, no corpus and no cache the ladder must end in '?/?/none/UNRANKED', got '$_lr'"; fail=1; }
  # the cache rung: corpus unusable but a cut measured on THIS hardware exists — use it and SAY so
  printf '11.11 22.22 700 2026-08-30T00:00:00Z\n' >"$td/cache"
  _cr=$( LOG="$td/empty" BAND_CACHE="$td/cache" PIN_LO='' PIN_HI=''
         resolve_bands; printf '%s|%s|%s' "$LOW_W" "$HIGH_W" "$BAND_SRC" )
  case "$_cr" in (11.11'|'22.22'|lo=cache:age='*',n=700,hi=cache:age='*) :;;
    (*) echo "  FAIL: cache rung — want the cached edges with a self-naming aged source, got '$_cr'"; fail=1;; esac
  # a pin wins its own edge and says which one is pinned
  _pr=$( LOG="$td/corpus" BAND_CACHE="$td/nocache" PIN_LO='' PIN_HI=120
         resolve_bands; printf '%s|%s' "$HIGH_W" "$BAND_SRC" )
  case "$_pr" in (120'|'*hi=pinned*) :;; (*) echo "  FAIL: a pinned hi must win its edge and name itself, got '$_pr'"; fail=1;; esac

  # ---- EVERY BAND THIS TOOL CAN PRINT MUST BE REACHABLE ON THIS NODE'S OWN CORPUS ---------------
  # THE gate for {#4da628d0}: the 9/15 W table inherited from Intel silicon left LOW and NORMAL
  # unreachable (7811/7811 samples HIGH) for 47 days, and nothing went red — the verdict word was a
  # constant while the watts under it moved 5.4x. So assert the PROPERTY, never the numbers: run the
  # LIVE corpus through the RESOLVED edges and require all three bands to hold rows. Re-derived every
  # run, so it re-cuts itself the next time this hardware changes. A corpus too small to cut is a
  # NAMED skip, never a silent pass — the reachability question is simply unasked there.
  if _lc=$(cut_bands "$LOG"); then
    read -r _llo _lhi _ln <<<"$_lc"
    _dist=$(awk -v lo="$_llo" -v hi="$_lhi" '
        $2 ~ /^[0-9]+\.?[0-9]*$/ { if ($2+0>=hi+0) h++; else if ($2+0<lo+0) l++; else m++ }
        END{ printf "%d %d %d", l+0, m+0, h+0 }' "$LOG")
    read -r _dl _dm _dh <<<"$_dist"
    if [ "${_dl:-0}" -gt 0 ] && [ "${_dm:-0}" -gt 0 ] && [ "${_dh:-0}" -gt 0 ]; then
      echo "  bands reachable on the live corpus (n=$_ln, lo<$_llo hi>=$_lhi): LOW=$_dl NORMAL=$_dm HIGH=$_dh"
    else
      echo "  FAIL: band table is SATURATED on this node's own corpus (n=$_ln, lo<$_llo hi>=$_lhi) — LOW=$_dl NORMAL=$_dm HIGH=$_dh; a band 0 samples can reach is a verdict nothing can produce"; fail=1
    fi
  else
    echo "  bands: reachability UNASKED — the live corpus at $LOG cannot cut (n<$BAND_MIN_N or no spread); not a pass"
  fi

  # ---- core= MUST CARRY ITS DOMAIN SCOPE -------------------------------------------------------
  # intel-rapl:0:0 is named "core" on every vendor, but on AMD Zen it is fed by
  # MSR_AMD_CORE_ENERGY_STAT (per-core), not Intel's PP0 (package cores) — so an unqualified core=
  # invites a package-minus-core "uncore" that is arithmetic over two different scopes.
  printf 'vendor_id\t: AuthenticAMD\n' >"$td/cpuinfo_amd"
  printf 'vendor_id\t: GenuineIntel\n' >"$td/cpuinfo_intel"
  : >"$td/cpuinfo_none"
  [ "$(MESH_CPUINFO="$td/cpuinfo_amd"   core_scope)" = 'per-core:amd-core-energy' ] \
    || { echo "  FAIL: AMD must qualify core= as the per-core domain"; fail=1; }
  [ "$(MESH_CPUINFO="$td/cpuinfo_intel" core_scope)" = 'pkg-cores:intel-pp0' ] \
    || { echo "  FAIL: Intel must qualify core= as PP0"; fail=1; }
  [ "$(MESH_CPUINFO="$td/cpuinfo_none"  core_scope)" = 'scope-unknown-vendor' ] \
    || { echo "  FAIL: an unreadable vendor must render scope-unknown, never a vendor's word"; fail=1; }
  # fixture end-to-end via env-path override (proves the read path honors fixtures, no sudo)
  printf '1000000\n' >"$td/e1"; printf '15000000\n' >"$td/e2"
  e1=$(MESH_RAPL_PATH="$td/e1" read_uj "$td/e1") && e2=$(read_uj "$td/e2") \
    && [ "$e1" = 1000000 ] && [ "$e2" = 15000000 ] || { echo "  FAIL: fixture read_uj"; fail=1; }
  printf 'garbage\n' >"$td/bad"
  read_uj "$td/bad" >/dev/null 2>&1 && { echo "  FAIL: non-numeric read must fail"; fail=1; }
  # core/uncore fixture read (same read_uj, distinct path vars — soc-rapl-core-uncore-split)
  printf '172916117880\n' >"$td/core1"; printf '172930117880\n' >"$td/core2"
  c1=$(MESH_RAPL_CORE_PATH="$td/core1" read_uj "$td/core1") && c2=$(read_uj "$td/core2") \
    && [ "$c1" = 172916117880 ] && [ "$c2" = 172930117880 ] || { echo "  FAIL: core fixture read_uj"; fail=1; }
  # non-fatal gate: only computed when BOTH samples of a domain succeed — one missing → "" not a crash
  u1=""; u2=$(read_uj "$td/e2" 2>/dev/null) || u2=""
  uw=""; if [ -n "$u1" ] && [ -n "$u2" ]; then uw=$(watts_between "$u1" "$u2" 2000000 262143328850); fi
  [ -z "$uw" ] || { echo "  FAIL: uncore_w computed with one empty sample (should stay empty)"; fail=1; }
  # --- COVERAGE gates: the across-run interval window and the fold that names its winner ---------
  # fold_w: the max must NAME which window won, and na must never beat a real read.
  [ "$(fold_w 7.00 42.00)"  = "42.00 iv" ]   || { echo "  FAIL: fold_w 7 42 → $(fold_w 7.00 42.00) (want '42.00 iv')"; fail=1; }
  [ "$(fold_w 61.00 8.00)"  = "61.00 inst" ] || { echo "  FAIL: fold_w 61 8 → $(fold_w 61.00 8.00) (want '61.00 inst')"; fail=1; }
  [ "$(fold_w 12.00 12.00)" = "12.00 inst" ] || { echo "  FAIL: fold_w tie → $(fold_w 12.00 12.00) (want '12.00 inst')"; fail=1; }
  [ "$(fold_w 9.50 na)"     = "9.50 inst" ]  || { echo "  FAIL: fold_w na → $(fold_w 9.50 na) (want '9.50 inst' — na never wins)"; fail=1; }
  # iv_watts: 15,000,000,000 µJ across a 300 s interval = 50.00 W (a real ACROSS-RUN delta, not a 2 s one)
  [ "$(iv_watts 1000 0 1300 15000000000 65532610987 1800 200)" = "50.00" ] \
    || { echo "  FAIL: iv_watts plain → $(iv_watts 1000 0 1300 15000000000 65532610987 1800 200) (want 50.00)"; fail=1; }
  # the counter WRAPPED inside the interval (e2 < e1): +max_energy_range recovers the same 50.00 W
  [ "$(iv_watts 1000 60000000000 1300 9467389013 65532610987 1800 200)" = "50.00" ] \
    || { echo "  FAIL: iv_watts wrap-safe → $(iv_watts 1000 60000000000 1300 9467389013 65532610987 1800 200) (want 50.00)"; fail=1; }
  # MISSING EVIDENCE RENDERS na, NEVER 0 — on a watt axis a fabricated 0 is a fabricated COLD MACHINE.
  [ "$(iv_watts '' '' 1300 15000000000 65532610987 1800 200)" = na ] \
    || { echo "  FAIL: no baseline (first run) must be na, got $(iv_watts '' '' 1300 15000000000 65532610987 1800 200)"; fail=1; }
  [ "$(iv_watts 1000 garbage 1300 15000000000 65532610987 1800 200)" = na ] \
    || { echo "  FAIL: garbage baseline field must be na"; fail=1; }
  [ "$(iv_watts 1000 0 1000 15000000000 65532610987 1800 200)" = na ] \
    || { echo "  FAIL: dt=0 must be na"; fail=1; }
  # The stale-baseline fixture needs a counter BIG enough that the wrap test would still decide it —
  # on the 65.5 kJ counter any long dt is ambiguous anyway, so the wrap guard would shadow this one
  # and it would assert nothing (measured: deleting the max-age check left it green). 1300 s on a
  # 262 kJ counter at 20 W is decidable (the next candidate is 221 W, past the ceiling) and stale.
  [ "$(iv_watts 1000 0 2300 26000000000 262143328850 1200 200)" = na ] \
    || { echo "  FAIL: stale baseline past max-age → $(iv_watts 1000 0 2300 26000000000 262143328850 1200 200) (want na — never average across an unobserved gap)"; fail=1; }
  # WRAP — the na the other cases cannot reach, and the one this fix twice got wrong. A multi-wrap
  # does NOT show up as an absurd number (each extra wrap ADDS max, so the single-correction answer
  # comes out too SMALL), and it is not a plain "dt too long" rule either: what decides it is whether
  # a SECOND candidate is physically possible. Fixtures use this node's real counter (65.5 kJ).
  # 300 s at 70 W: the next candidate is 70+218=288 W, past the 200 W ceiling → decidable.
  [ "$(iv_watts 1000 0 1300 21000000000 65532610987 1800 200)" = "70.00" ] \
    || { echo "  FAIL: iv_watts 70 W over 300 s → $(iv_watts 1000 0 1300 21000000000 65532610987 1800 200) (want 70.00 — decidable, the second wrap candidate is impossible)"; fail=1; }
  # 1000 s at 70 W: max/us has shrunk to 65 W, so 135 W is ALSO possible → two answers survive → na.
  [ "$(iv_watts 1000 0 2000 70000000000 65532610987 1800 200)" = na ] \
    || { echo "  FAIL: ambiguous wrap count over 1000 s → $(iv_watts 1000 0 2000 70000000000 65532610987 1800 200) (want na — the smaller candidate is not the true one just because it came first)"; fail=1; }
  # A first candidate already past the ceiling is a symptom, not a measurement.
  [ "$(iv_watts 1000 0 1300 90000000000 65532610987 1800 200)" = na ] \
    || { echo "  FAIL: 300 W implied draw must be na, got $(iv_watts 1000 0 1300 90000000000 65532610987 1800 200)"; fail=1; }

  # REAL-READ GATE (verification principle: a sense --test asserts real hardware produces data,
  # not just the offline classifier). Unreadable counter = honest n/a exit 2, never fake green.
  if ! r1=$(read_uj "$RAPL"); then
    echo "smoke-test: n/a — RAPL counter not readable on this node (no intel-rapl or sudo -n denied)"
    exit 2
  fi
  # core/uncore live read is OPTIONAL/best-effort (older kernel or non-Intel node may lack these
  # subdomains) — soft NOTE if absent, but if present it must produce finite data, same as package.
  cr1=$(read_uj "$RAPL_CORE" 2>/dev/null) || cr1=""
  ur1=$(read_uj "$RAPL_UNCORE" 2>/dev/null) || ur1=""
  t1=$(date +%s%N); sleep 1
  r2=$(read_uj "$RAPL2") || { echo "  FAIL: second live RAPL read failed after first succeeded"; fail=1; r2=$r1; }
  cr2=$(read_uj "$RAPL_CORE2" 2>/dev/null) || cr2=""
  ur2=$(read_uj "$RAPL_UNCORE2" 2>/dev/null) || ur2=""
  t2=$(date +%s%N)
  maxr=$(read_uj "$MAXP" 2>/dev/null) || maxr=262143328850
  lw=$(watts_between "$r1" "$r2" $(( (t2 - t1) / 1000 )) "$maxr") || lw=""
  case "$lw" in
    (''|0.00) echo "  FAIL: live read gate — watts '$lw' not finite-positive (hollow sense)"; fail=1;;
    (*) echo "  live read: ${lw} W ($(classify "$lw")) — real hardware produced data";;
  esac
  # NOTE: unlike package-total (never near-zero — CPU always has an idle floor), a subdomain CAN
  # legitimately read ~0.00W at idle (uncore/igpu measured 0.005W idle on this node's hardware,
  # rounds to 0.00) — so only an EMPTY result (read/compute failure) is a real hollow-sense FAIL here.
  if [ -n "$cr1" ] && [ -n "$cr2" ]; then
    lwc=$(watts_between "$cr1" "$cr2" $(( (t2 - t1) / 1000 )) "$(read_uj "$MAXP_CORE" 2>/dev/null || echo 262143328850)") || lwc=""
    case "$lwc" in ('') echo "  FAIL: live core read produced no watts figure"; fail=1;;
      (*) echo "  live core read: ${lwc} W — real hardware produced data";; esac
  else
    echo "  core: n/a (no intel-rapl:0:0 or sudo -n denied — optional, non-fatal)"
  fi
  if [ -n "$ur1" ] && [ -n "$ur2" ]; then
    lwu=$(watts_between "$ur1" "$ur2" $(( (t2 - t1) / 1000 )) "$(read_uj "$MAXP_UNCORE" 2>/dev/null || echo 262143328850)") || lwu=""
    case "$lwu" in ('') echo "  FAIL: live uncore read produced no watts figure"; fail=1;;
      (*) echo "  live uncore read: ${lwu} W — real hardware produced data";; esac
  else
    echo "  uncore: n/a (no intel-rapl:0:1 or sudo -n denied — optional, non-fatal)"
  fi
  # ---- STATE ROUND-TRIP: the interval exists only if run N's counters reach run N+1 -------------
  # Drive two real runs against a sandboxed state/log (a --test must NEVER write the artifact a
  # watchdog reads for liveness) and assert the coverage WIDENS: run 1 has no baseline (window=inst,
  # watts_iv=null), run 2 must read run 1's counters (window=inst+iv, numeric). A gate that only
  # checked run 1 would pass with the carry deleted.
  _sd=$(mktemp -d)
  _p1=$(MESH_PKG_STATE="$_sd/s" MESH_PKG_LOG="$_sd/l" MESH_PKG_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  _p2=$(MESH_PKG_STATE="$_sd/s" MESH_PKG_LOG="$_sd/l" MESH_PKG_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  _w1=$(printf '%s' "$_p1" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _w2=$(printf '%s' "$_p2" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _iv2=$(printf '%s' "$_p2" | sed -n 's/.*"watts_iv":\([a-z0-9.]*\).*/\1/p')
  _raw2=$(sed -n 's/.* raw=\([0-9? ]*\)$/\1/p' "$_sd/s" 2>/dev/null | tail -1)
  rm -rf "$_sd"
  [ "$_w1" = inst ] || { echo "smoke-test: FAIL (run 1 has no baseline but reported window=$_w1 — an interval was invented from nothing)"; exit 1; }
  [ "$_w2" = "inst+iv" ] || { echo "smoke-test: FAIL (run 2 reported window=$_w2 — the accumulator is NOT carried across runs, coverage is still ${SECS}s/300s)"; exit 1; }
  case "$_iv2" in ''|null) echo "smoke-test: FAIL (run 2 watts_iv=$_iv2 — the interval window produced no reading)"; exit 1;; esac
  [ -n "$_raw2" ] || { echo "smoke-test: FAIL (state carries no raw= counters — the next run cannot compute an interval)"; exit 1; }

  # ---- CONSUMING the interval is not COMPUTING it ----------------------------------------------
  # Seed a baseline 100 s old whose counter sits far enough behind the live one to imply a ~150 W
  # interval, and pin HIGH_W at 120 W for the child so the LIVE draw CANNOT reach it: the fused
  # verdict must then be HIGH and the 1s sample's verdict NORMAL. Without the pinned threshold this
  # gate was vacuous on a busy node — the real package already reads HIGH, so classifying off the
  # wrong window produced the same word and the mutant survived (measured).
  _fd=$(mktemp -d)
  _e_now=$(read_uj "$RAPL") || { echo "smoke-test: FAIL (RAPL read failed while seeding the fold gate)"; exit 1; }
  _maxr_now=$(read_uj "$MAXP" 2>/dev/null) || _maxr_now=262143328850
  _seed_uj=$(( _e_now - 15000000000 ))       # 15,000 J behind, over 100s → 150 W
  [ "$_seed_uj" -ge 0 ] || _seed_uj=$(( _e_now + _maxr_now - 20000000000 ))   # counter young: seed pre-wrap
  printf 'SEED 0W core=? uncore=? raw=%s %s ? ? %s\n' "$(( $(date +%s) - 100 ))" "$_seed_uj" "$_maxr_now" > "$_fd/s"
  _pf=$(MESH_PKG_STATE="$_fd/s" MESH_PKG_LOG="$_fd/l" MESH_PKG_SAMPLE_SECS=1 MESH_PKG_HIGH_W=120 "$0" --json 2>/dev/null)
  _pf_inst=$(printf '%s' "$_pf" | sed -n 's/.*"watts_inst":\([0-9.]*\).*/\1/p')
  rm -rf "$_fd"
  _fwon=$(printf '%s' "$_pf" | sed -n 's/.*"won":"\([a-z]*\)".*/\1/p')
  _flvl=$(printf '%s' "$_pf" | sed -n 's/.*"level":"\([A-Z]*\)".*/\1/p')
  _fw=$(printf '%s' "$_pf"   | sed -n 's/.*"watts":\([0-9.]*\).*/\1/p')
  [ "$_fwon" = iv ] || { echo "smoke-test: FAIL (seeded a ~150 W interval but the fold named won=$_fwon — the interval window loses to the ${SECS}s sample)"; exit 1; }
  awk -v v="${_fw:-0}" 'BEGIN{exit !(v+0 > 120)}' || { echo "smoke-test: FAIL (interval won but watts=$_fw — the published axis is not the fold's value)"; exit 1; }
  awk -v v="${_pf_inst:-999}" 'BEGIN{exit !(v+0 < 120)}' || { echo "smoke-test: n/a — the live package really is drawing ${_pf_inst}W, past the 120W the fold gate pins as unreachable; the gate cannot discriminate on this reading"; exit 2; }
  [ "$_flvl" = HIGH ] || { echo "smoke-test: FAIL (fused ${_fw}W over a 120W threshold the ${SECS}s sample (${_pf_inst}W) cannot reach, but level=$_flvl — the verdict does not ride on the fused axis)"; exit 1; }

  # ---- A BASELINE FROM ANOTHER DOMAIN IS NOT A BASELINE ----------------------------------------
  # Seed a fresh, otherwise-perfect baseline whose max_energy_range differs from the live counter's:
  # the wrap arithmetic that turns those two numbers into watts is only valid within one domain, so
  # the run must fall back to window=inst rather than reason across a re-enumerated powercap tree.
  _md=$(mktemp -d)
  _e_md=$(read_uj "$RAPL") || { echo "smoke-test: FAIL (RAPL read failed while seeding the domain gate)"; exit 1; }
  printf 'SEED 0W core=? uncore=? raw=%s %s ? ? %s\n' "$(( $(date +%s) - 60 ))" "$(( _e_md > 1000000000 ? _e_md - 1000000000 : 0 ))" 999999999999 > "$_md/s"
  _pm=$(MESH_PKG_STATE="$_md/s" MESH_PKG_LOG="$_md/l" MESH_PKG_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  rm -rf "$_md"
  _mwin=$(printf '%s' "$_pm" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  [ "$_mwin" = inst ] || { echo "smoke-test: FAIL (baseline carried a DIFFERENT max_energy_range but the run still computed an interval (window=$_mwin) — the wrap arithmetic was applied across two domains)"; exit 1; }

  [ "$fail" = 0 ] && { echo "smoke-test: ok (fixture math + 13 coverage asserts + real RAPL read + across-run carry inst→inst+iv + seeded interval drives the verdict + cross-domain baseline refused + bands cut from the live corpus and all three reachable + the ladder ends in a refusal not a constant + core= carries its domain scope)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

if [ "${1:-}" = "--status" ]; then
  if [ -s "$STATE" ]; then
    printf '[package-power] %s (as of %s)\n' "$(cat "$STATE")" \
      "$(date -u -r "$STATE" +%FT%TZ 2>/dev/null || echo '?')"
    exit 0
  fi
  echo "[package-power] no state yet — run mesh-package-power for a sample"; exit 2
fi

e1=$(read_uj "$RAPL") || { echo "mesh-package-power: RAPL counter not readable (no intel-rapl or sudo -n denied) — UNREACHABLE" >&2; exit 2; }
t1=$(date +%s%N)
# The PREVIOUS run's raw counters, read before the state file is overwritten. Absent (first run, or
# a state line predating this field) => the interval window renders na, never a fabricated wattage.
prev_raw="$(sed -n 's/.* raw=\([0-9? ]*\)$/\1/p' "$STATE" 2>/dev/null | tail -1)"
read -r p_epoch p_pkg p_core p_uncore p_maxr <<< "${prev_raw:-}"
# core/uncore first-samples, read right alongside e1 (best-effort/non-fatal — see header)
core1=$(read_uj "$RAPL_CORE" 2>/dev/null) || core1=""
uncore1=$(read_uj "$RAPL_UNCORE" 2>/dev/null) || uncore1=""
[ "$RAPL2" = "$RAPL" ] && sleep "$SECS"
e2=$(read_uj "$RAPL2") || { echo "mesh-package-power: second RAPL read failed — UNREACHABLE" >&2; exit 2; }
t2=$(date +%s%N)
core2=$(read_uj "$RAPL_CORE2" 2>/dev/null) || core2=""
uncore2=$(read_uj "$RAPL_UNCORE2" 2>/dev/null) || uncore2=""
dt_us=$(( (t2 - t1) / 1000 ))
maxr=$(read_uj "$MAXP" 2>/dev/null) || maxr=262143328850
watts=$(watts_between "$e1" "$e2" "$dt_us" "$maxr") \
  || { echo "mesh-package-power: bad sample (dt=${dt_us}µs) — UNREACHABLE" >&2; exit 2; }
# (the level is classified further down, AFTER the two windows are folded — classifying here as well
#  would leave a stale verdict variable one edit away from being the one that gets printed)
cap_uw=$(read_uj "$CAPP" 2>/dev/null) || cap_uw=""
cap_w=${cap_uw:+$(awk -v c="$cap_uw" 'BEGIN{printf "%.0f", c/1000000}')}
ts=$(date -u +%FT%TZ)

# core/uncore watts: only computed when BOTH samples of a domain succeeded — never fatal to the
# package reading above (a node without these subdomains just gets "?", per header).
core_w=""; uncore_w=""
maxr_core=$(read_uj "$MAXP_CORE" 2>/dev/null) || maxr_core=262143328850
maxr_uncore=$(read_uj "$MAXP_UNCORE" 2>/dev/null) || maxr_uncore=262143328850
if [ -n "$core1" ] && [ -n "$core2" ]; then
  core_w=$(watts_between "$core1" "$core2" "$dt_us" "$maxr_core" 2>/dev/null) || core_w=""
fi
if [ -n "$uncore1" ] && [ -n "$uncore2" ]; then
  uncore_w=$(watts_between "$uncore1" "$uncore2" "$dt_us" "$maxr_uncore" 2>/dev/null) || uncore_w=""
fi

# --- INTERVAL window: the same counters delta'd against the PREVIOUS run (100% coverage) ---
# A max_energy_range that changed means the baseline came from a DIFFERENT domain (a re-enumerated
# powercap tree), so its wrap arithmetic no longer applies — drop the baseline rather than reason
# across it.
now_s=$(( t2 / 1000000000 ))
if [ "${p_maxr:-}" != "$maxr" ]; then p_epoch=""; p_pkg=""; p_core=""; p_uncore=""; fi
iv_w=$(iv_watts "${p_epoch:-}" "${p_pkg:-}" "$now_s" "$e2" "$maxr" "$MAX_IV_AGE" "$MAX_PLAUSIBLE_W")
iv_core_w=na; iv_uncore_w=na
[ -n "$core2" ]   && iv_core_w=$(iv_watts   "${p_epoch:-}" "${p_core:-}"   "$now_s" "$core2"   "$maxr_core"   "$MAX_IV_AGE" "$MAX_PLAUSIBLE_W")
[ -n "$uncore2" ] && iv_uncore_w=$(iv_watts "${p_epoch:-}" "${p_uncore:-}" "$now_s" "$uncore2" "$maxr_uncore" "$MAX_IV_AGE" "$MAX_PLAUSIBLE_W")

# --- Fold on the package axis: max, winner NAMED; the sub-domain split comes from the SAME window
read -r fused_w won <<< "$(fold_w "$watts" "$iv_w")"
if [ "$won" = iv ]; then
  r_core="$iv_core_w"; r_uncore="$iv_uncore_w"
else
  r_core="${core_w:-?}"; r_uncore="${uncore_w:-?}"
fi
[ "$r_core" = na ] && r_core="?"; [ "$r_uncore" = na ] && r_uncore="?"
if [ "$iv_w" = na ]; then window="inst"; else window="inst+iv"; fi
# ONE quantity, ONE rendering: watts carry their W and an absent reading is a bare `na`, never "naW"
IV_W_R="$iv_w"; [ "$iv_w" = na ] || IV_W_R="${iv_w}W"
level=$(classify "$fused_w")   # the VERDICT rides on the fused axis, not on the 2s sample

mkdir -p "$(dirname "$STATE")" 2>/dev/null
# Tokens 1-2 stay "<LEVEL> <watts>W" (mesh-stress and friends read field 1); coverage fields and the
# trailing raw= carry — which is what makes the interval window possible at all — are appended.
printf '%s %sW core=%s(%s) uncore=%s window=%s w_inst=%s w_iv=%s won=%s bands=%s/%s band_src=%s raw=%s %s %s %s %s\n' \
  "$level" "$fused_w" "$r_core" "$CORE_SCOPE" "$r_uncore" "$window" "$watts" "$iv_w" "$won" \
  "$LOW_W" "$HIGH_W" "$BAND_SRC" \
  "$now_s" "$e2" "${core2:-?}" "${uncore2:-?}" "$maxr" >"$STATE"  # unconditional write: mtime = liveness
printf '%s %s %s core=%s(%s) uncore=%s window=%s w_inst=%s w_iv=%s won=%s bands=%s/%s\n' \
  "$ts" "$fused_w" "$level" "$r_core" "$CORE_SCOPE" "$r_uncore" "$window" "$watts" "$iv_w" "$won" \
  "$LOW_W" "$HIGH_W" >>"$LOG" # calibration telemetry (see header)
if [ "$(wc -l <"$LOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

if [ "${1:-}" = "--json" ]; then
  printf '{"level":"%s","watts":%s,"elapsed_us":%s,"cap_w":%s,"core_w":%s,"core_scope":"%s","uncore_w":%s,"window":"%s","watts_inst":%s,"watts_iv":%s,"won":"%s","band_lo":%s,"band_hi":%s,"band_src":"%s","ts":"%s"}\n' \
    "$level" "$fused_w" "$dt_us" "${cap_w:-null}" \
    "$([ "$r_core" = '?' ] && echo null || echo "$r_core")" "$CORE_SCOPE" \
    "$([ "$r_uncore" = '?' ] && echo null || echo "$r_uncore")" \
    "$window" "$watts" "$([ "$iv_w" = na ] && echo null || echo "$iv_w")" "$won" \
    "$([ "$LOW_W" = '?' ] && echo null || echo "$LOW_W")" \
    "$([ "$HIGH_W" = '?' ] && echo null || echo "$HIGH_W")" "$BAND_SRC" "$ts"
else
  printf '[package-power] %s — %s W | window=%s inst=%sW iv=%s won=%s (sample %ss) | bands lo<%s hi>=%s src=%s | fw-cap=%s | core=%sW(%s) uncore=%sW\n' \
    "$level" "$fused_w" "$window" "$watts" "$IV_W_R" "$won" \
    "$(awk -v us="$dt_us" 'BEGIN{printf "%.1f", us/1000000}')" \
    "$LOW_W" "$HIGH_W" "$BAND_SRC" "${cap_w:-?}W(unset-default, unused)" "$r_core" "$CORE_SCOPE" "$r_uncore"
  case "$CORE_SCOPE" in (per-core:*) printf '  note: core= is a PER-CORE domain on this silicon (%s) — it is not package-scope, so package-core is NOT uncore and the two figures are not comparable\n' "$CORE_SCOPE";; esac
fi
