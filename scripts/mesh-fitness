#!/usr/bin/env bash
# mesh-fitness — SELECTION for the autopoiesis loop. The mesh produces ~50 changes/day but nothing
# decides whether a self-modification made it BETTER or WORSE — so production can drift into
# regression/bloat. This is the Darwinian step: after a SELF-PRODUCED commit lands, check its fitness
# and undo it if it regressed the mesh. Without selection, self-production isn't viability-preserving.
#
# Fitness signal (unambiguous, cheap, no false-positive reverts):
#   a tool CHANGED by the commit now fails ITS OWN syntax check (shebang-dispatched: `bash -n` for
#   bash/sh, `python3 -m py_compile` for python3 — an interpreter we don't recognize is SKIPPED, never
#   flagged) OR fails its own `--test`, run via its own shebang (never forced through `bash`) with a
#   generous timeout (MESH_FITNESS_TEST_TIMEOUT, default 60s). That is a hard regression — the commit
#   shipped a broken tool. (Subtler quality deltas are left to mesh-vitality's trend alarm, not to an
#   auto-revert, on purpose.) FIXED 2026-07-07 (chat-review/fitness-false-revert-bash-n-on-python,
#   live-reproduced): the prior form ran a bare `bash -n`/`bash "$f" --test` on EVERY changed tool
#   regardless of shebang — a valid #!/usr/bin/env python3 tool is invalid bash BY CONSTRUCTION, so
#   two good commits (mesh-minds/mesh-sense-map, the node-def-any-transport feature) got auto-reverted
#   TWICE before this fix; the same run also caught a genuinely-passing-but-slow bash --test
#   (mesh-overhear, ~35.6s real) getting killed by the old bare `timeout 30` and misread the same way.
#
# Guardrails (it can rewrite git history — must be safe):
#   - HEAD ONLY: checks the tip commit (clean to revert, no conflict risk); state-tracked so each
#     commit is judged once.
#   - SELF-PRODUCED ONLY: acts only on commits carrying the "Co-Authored-By: Claude" trailer; an
#     operator commit is marked checked and never touched.
#   - CLEAN-TREE revert: auto-reverts only when the working tree is clean; if dirty (the genome lane
#     leaves in-progress work), it ALARMS [fitness-regression] instead of risking a stash/clobber.
#   - Local revert only (no push) — sync-tools redeploys the restored tool; steward pushes.
#   mesh-fitness           judge HEAD; revert-or-alarm on regression
#   mesh-fitness --check   report HEAD's fitness, change nothing
#   mesh-fitness --test    smoke test
# reflex-cadence: */9 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; REPO="$HOME/lte-workstation"; STATE="$M/.fitness-state"; LOG="$M/fitness.log"
ts(){ date -u +%FT%TZ; }

# ── NORMATIVITY: a self-generated norm of BETTER, not just bivalent ALIVE/DEAD (a known CRITIQUE of
#    autopoiesis — Barandiaran, Di Paolo & Rohde; Weber & Varela; Di Paolo) ─────────────────────────
# LITERATURE (autopoiesis & biology of cognition — a known CRITIQUE / failure mode of the area):
# the standard critique that autopoiesis, as originally stated by Maturana & Varela, grounds only
# BIVALENT CONSERVATION (the system is autopoietic-or-not = alive-or-dead) and therefore provides NO
# account of NORMATIVITY — a self-generated standard by which the system's own actions/products are
# FUNCTIONAL vs DYSFUNCTIONAL, BETTER vs WORSE, while it is still alive. Without an intrinsic norm a
# self-maintaining system cannot be WRONG by its own lights; it can only be dead. Sources: Xabier
# Barandiaran, Ezequiel Di Paolo & Marieke Rohde, "Defining Agency: Individuality, Normativity,
# Asymmetry and Spatio-temporality in Action" (Adaptive Behavior 17(5), 2009) — agency needs
# individuality + interactional asymmetry + NORMATIVITY, and autopoiesis supplies only the first;
# Andreas Weber & Francisco Varela, "Life after Kant: Natural purposes and the autopoietic foundations
# of biological individuality" (Phenomenology & the Cognitive Sciences 1, 2002); Ezequiel Di Paolo,
# "Autopoiesis, Adaptivity, Teleology, Agency" (Phenom. & Cog. Sci. 4, 2005).
#   GAP HERE (this file IS the failure mode): mesh-fitness NAMES itself "SELECTION … decides whether a
#   self-modification made it BETTER or WORSE" (header) — a normative claim. But its actual fitness
#   SIGNAL is purely bivalent CONSERVATION: a changed tool fails `bash -n` OR its own `--test` = broken
#   (dead) else fit (alive). There is NO self-generated norm of FUNCTIONAL VALUE: a commit that ships a
#   syntactically-valid, --test-passing, but USELESS or value-regressive tool is judged "fit". "Fit"
#   here means "not-broken", NEVER "better" — exactly the conservation-without-normativity the critique
#   names. The header's own goal (better-or-worse) is UNMET by its own signal (broken-or-not), and it
#   even concedes "subtler quality deltas are left to mesh-vitality" — i.e. the norm is deliberately absent.
#   HONEST MIRROR: this session's 128 same-shape inoculation commits ALL pass this check (each parses,
#   each --test passes) → fitness reads every one "fit" while having no norm to ask "did this make the
#   mesh BETTER, or merely not-broken?". A green "fit" certifies survival, not value.
#   DISTINCT from prior reviews (no overlap):
#     • NOT the error-threshold/quasispecies review (review-error-threshold-quasispecies-mesh-fitness,
#       same file): that is THROUGHPUT of selection — do commits land faster than HEAD-only judging can
#       keep up (unjudged-mutation backlog vs the error threshold). This is the NORM selection judges BY
#       (bivalent survival vs functional value) — orthogonal: "judging fast enough" vs "judging by a
#       genuine norm".
#     • NOT adaptivity/graded-viability (review-adaptivity-graded-viability-mesh-body-power): that is a
#       graded distance to a SURVIVAL boundary on one variable (a richer aliveness sensor). Normativity
#       is a self-generated standard of ACTION/PRODUCT correctness — not survival distance. (Di Paolo
#       links them — adaptivity grounds normativity — but the graded-viability SENSOR landed on
#       body-power; the norm-of-product-VALUE is a different construct, and it lands on the selector.)
#     • NOT irruption/absorption (review-irruption-vs-absorption-agency-signature-mesh-needs): that is
#       the SOURCE of activity (self-originated vs triggered). This is the STANDARD activity is judged
#       by. Source vs standard — different agency conditions from the same "Defining Agency" lineage.
#   HELD fix (instrument-first, steward/operator-gated): report fitness as TWO axes — CONSERVATION
#   (broken-or-not, the current auto-revert trigger) AND a separate, NON-reverting FUNCTIONAL-VALUE
#   read (did the change add capability / get consumed by other tools / reduce a real deficit — vs
#   merely parse) — so "fit" is never silently read as "valuable". WHY HELD: a norm of "better" that
#   could trigger AUTO-REVERT (rewriting git history) is precisely the false-positive-revert danger the
#   file's guardrails exist to avoid (header: "subtler quality deltas … not to an auto-revert, on
#   purpose"). The safe half is NAMING the two axes apart in --check; any value-norm that gates a revert
#   must be validated against real commit history first. Not shipped (comment-only; 0 behavior change).
#
# _interp_of <file> → bash|python3|other, from the shebang line. fitness-false-revert-bash-n-on-python
# (2026-07-07, live-reproduced): regressions() used to run `bash -n`/`bash "$f" --test` on EVERY
# changed tool with NO shebang dispatch — a #!/usr/bin/env python3 tool (mesh-minds, mesh-sense-map)
# is INVALID bash syntax by construction ("syntax error near unexpected token sys.argv"), so a
# perfectly good python commit was auto-reverted TWICE (e6916b1 reverting the real feature c7ee86d, on
# both ds and IdeaPad) — a selector whose test is wrong selects AGAINST fitness. Dispatch the syntax
# check by the tool's OWN interpreter instead of assuming bash for everything.
_interp_of(){
  local shb; shb="$(head -1 "$1" 2>/dev/null)"
  case "$shb" in
    '#!'*/bash|'#!'*'env bash')     echo bash ;;
    '#!'*/sh|'#!'*'env sh')         echo bash ;;   # POSIX sh is bash -n-compatible for our tools' subset
    '#!'*/python3*|'#!'*'env python3'*|'#!'*/python|'#!'*'env python') echo python3 ;;
    *) echo other ;;
  esac
}
TEST_TIMEOUT="${MESH_FITNESS_TEST_TIMEOUT:-60}"   # was a bare 30 (no override) — live-reproduced
                                                   # false-positive: mesh-overhear's REAL --test run
                                                   # takes ~35.6s (multiple python/audioop STT
                                                   # subprocess fixtures) and is legitimately slow, not
                                                   # broken; `timeout 30` killed it (rc=124) and
                                                   # regressions() read the kill as ":--test" failure —
                                                   # the SAME false-revert failure mode as the shebang
                                                   # bug (a test-runner artifact misread as a real
                                                   # regression), caught alongside it (fd28da8, 2026-07-06
                                                   # 23:27Z [fitness-regression] alarm).
# --- mem-pressure gate (chat-review/fitness-mempressure-gate-missing, 2026-07-10) --------------------
# regressions() below used to treat ANY --test rc other than {0,2} as an unconditional broken-tool
# [fitness-regression] — no retry, no memory check — while mesh-doctor's serial-confirm already learned
# (the hard way, across three chat-reviews) that a rc=1/124 under genuine memory starvation is a
# storm/ENOMEM VICTIM, not a broken tool: swap-thrash ENOMEMs BOTH the run and any quiet re-run, so the
# tool passes standalone yet FAILs under an 8-core saturation storm. Live cost: the 2026-07-10T02:28:02Z
# [fitness-regression] against 11c842b was exactly this false alarm — health spent a full mind-cycle
# re-running --test from src+deployed, md5-diffing, and cross-checking doctor's own recovery to conclude
# "same ENOMEM pattern as doctor" (02:31:54Z). These two helpers mirror mesh-doctor's _sc_mem_pressure_high
# / _sc_mem_exhausted (same MESH_FITNESS_* override env-vars for --test parity) so the gate is testable
# with fixture meminfo/PSI; kept self-contained here (no shared lib exists yet — a future extract of
# both copies into mesh-patterns.sh would DRY them, tracked as the same class as this finding).
# PSI avg10 (active refault/thrash) OR meminfo swap/avail exhaustion (swapped-out-but-not-faulting reads
# ~0 PSI yet still ENOMEMs a fork-heavy --test). A swapless node (SwapTotal=0) never trips the swap leg.
#
# ── COVERAGE (window-cadence-aliasing sweep 2026-08-15, docs/window-cadence-coverage-2026-08-15.md)
# avg10 is a TEN-SECOND kernel average consulted on a 540 s cadence: 1.85% of the interval. Here that
# is not a corroborator that can afford to miss things — it is the VERDICT axis that decides whether
# an auto-revert fires on a real commit, and it decides in the "do NOT flag" direction, so a window
# that misses the storm re-arms the false revert this gate exists to prevent (the 2026-07-10T06:54Z
# revert of 403a6c0: two --test attempts died inside one sub-second fork-storm while avg10 read 0.00).
# Three wider windows were sitting in the SAME LINE the whole time, free: avg60, avg300, and `total=`
# — a MONOTONIC ACCUMULATOR of stall-µs whose delta across two runs covers 100% of the interval. All
# four are read, folded with a max that NAMES its winner, and the winning window is published in the
# note the deferral writes (the branch used to skip in silence: an else-branch must say why).
# Missing evidence renders na, never 0 — no baseline, a reset counter, a stale baseline and an
# unreadable PSI file each drop that window rather than contribute a calm reading. Widening can only
# make the gate defer MORE often, which is the safe direction for a tool whose failure mode is
# reverting innocent commits; a real regression fails again at the next */9 tick.
_FIT_MEMP_NOTE=""      # the reading behind the last _fit_mem_pressure_high call (windows + winner)

# _fit_psi_iv <prev_raw> <now_epoch> <now_total_us> <max_age_s> -> stall % over the interval, or na
_fit_psi_iv(){
  local prev="$1" ne="$2" nt="$3" maxage="$4" pe pt dt _f
  read -r pe pt <<< "$prev"
  for _f in "$pe" "$pt" "$ne" "$nt"; do case "$_f" in ''|*[!0-9]*) printf 'na'; return;; esac; done
  dt=$(( ne - pe ))
  [ "$dt" -gt 0 ] || { printf 'na'; return; }
  [ "$dt" -le "$maxage" ] || { printf 'na'; return; }
  [ "$nt" -ge "$pt" ] || { printf 'na'; return; }          # counter reset (reboot) — not a calm interval
  awk -v d="$(( nt - pt ))" -v dt="$dt" 'BEGIN{ printf "%.2f", d/(dt*1000000.0)*100.0 }'
}

# _fit_psi_fold <avg10> <avg60> <avg300> <iv> -> "<fused> <winner>"; na/empty candidates never win.
_fit_psi_fold(){
  awk -v a="${1:-na}" -v b="${2:-na}" -v c="${3:-na}" -v d="${4:-na}" 'BEGIN{
    split("avg10 avg60 avg300 iv", n, " "); v[1]=a; v[2]=b; v[3]=c; v[4]=d;
    best=""; who="none";
    for (i=1;i<=4;i++) {
      if (v[i]=="" || v[i]=="na") continue;
      if (best=="" || v[i]+0 > best+0) { best=v[i]+0; who=n[i] }
    }
    if (best=="") { print "na none"; exit }
    printf "%.2f %s\n", best, who;
  }'
}

_fit_mem_pressure_high(){
  local f="${MESH_FITNESS_MEMPRESSURE_FILE:-/proc/pressure/memory}" thresh="${MESH_FITNESS_MEMPRESSURE_AVG10:-10.0}"
  local avg10 avg60 avg300 total iv fused won window
  _FIT_MEMP_NOTE=""
  if [ -r "$f" ]; then
    read -r avg10 avg60 avg300 total <<< "$(awk '/^some/{a="na";b="na";c="na";t="na";
      for(i=1;i<=NF;i++){ if($i ~ /^avg10=/){sub(/^avg10=/,"",$i);a=$i}
                          else if($i ~ /^avg60=/){sub(/^avg60=/,"",$i);b=$i}
                          else if($i ~ /^avg300=/){sub(/^avg300=/,"",$i);c=$i}
                          else if($i ~ /^total=/){sub(/^total=/,"",$i);t=$i} }
      print a, b, c, t; exit}' "$f" 2>/dev/null)"
    iv="$(_fit_psi_iv "${_FIT_PSI_PREV:-}" "$(date -u +%s)" "${total:-na}" "${MESH_FITNESS_PSI_MAX_IV_AGE:-2160}")"
    read -r fused won <<< "$(_fit_psi_fold "${avg10:-na}" "${avg60:-na}" "${avg300:-na}" "$iv")"
    if [ "$iv" = na ]; then window="inst"; else window="inst+iv"; fi
    _FIT_MEMP_NOTE="psi window=$window avg10=${avg10:-na} avg60=${avg60:-na} avg300=${avg300:-na} iv=$iv fused=$fused won=$won thresh=$thresh"
    if [ "$fused" != na ] && awk -v v="$fused" -v t="$thresh" 'BEGIN{exit !(v+0 >= t+0)}'; then return 0; fi
  else
    _FIT_MEMP_NOTE="psi window=none (unreadable $f)"
  fi
  local mf="${MESH_FITNESS_MEMINFO_FILE:-/proc/meminfo}" swap_pct="${MESH_FITNESS_SWAPFREE_PCT:-5}" avail_pct="${MESH_FITNESS_MEMAVAIL_PCT:-10}"
  [ -r "$mf" ] || { _FIT_MEMP_NOTE="$_FIT_MEMP_NOTE; meminfo unreadable"; return 1; }
  if awk -v sp="$swap_pct" -v ap="$avail_pct" '
    /^SwapTotal:/ {st=$2} /^SwapFree:/ {sf=$2}
    /^MemTotal:/  {mt=$2} /^MemAvailable:/ {ma=$2}
    END { if (st > 0 && (sf/st*100) < sp) exit 0; if (mt > 0 && (ma/mt*100) < ap) exit 0; exit 1 }' "$mf"; then
    _FIT_MEMP_NOTE="$_FIT_MEMP_NOTE; meminfo exhaustion leg fired"
    return 0
  fi
  return 1
}

# regression check on a set of changed paths: any changed mesh tool failing its OWN syntax check or
# its own --test. echoes the offending "tool:reason" lines; empty = fit. A tool whose interpreter we
# don't recognize is SKIPPED (a note on stderr, not a "tool:reason" line) — never flagged as a false
# regression just because we don't know how to syntax-check it.
regressions(){ # $1 = newline list of changed paths
  printf '%s\n' "$1" | while IFS= read -r f; do
    case "$f" in scripts/mesh-*|*/mesh-*) :;; *) continue;; esac
    [ -f "$REPO/$f" ] || continue                       # deleted file → not a runtime regression here
    interp="$(_interp_of "$REPO/$f")"
    case "$interp" in
      bash)
        bash -n "$REPO/$f" 2>/dev/null || { echo "$(basename "$f"):bash-n"; continue; } ;;
      python3)
        python3 -m py_compile "$REPO/$f" 2>/dev/null || { echo "$(basename "$f"):py-compile"; continue; } ;;
      other)
        echo "regressions: skip $(basename "$f") — unrecognized interpreter, not syntax-checked" >&2
        continue ;;
    esac
    if grep -q '\-\-test' "$REPO/$f" 2>/dev/null; then
      # run via the tool's OWN shebang (never force `bash <script>` on a non-bash tool) — the exact
      # form every consumer of this same tool invokes it with elsewhere in the genome.
      [ -x "$REPO/$f" ] || chmod +x "$REPO/$f" 2>/dev/null || true
      timeout "$TEST_TIMEOUT" "$REPO/$f" --test >/dev/null 2>&1
      trc=$?
      # rc=2 is the mesh-wide HONEST-N/A convention (organ unreachable, hollow-sense real-read gates —
      # mag/gyro d657375, mesh-cell-signal 68b85dd) that mesh-land ALREADY treats as a pass; without
      # this, fitness auto-reverts every tool following that convention the instant its cron happens
      # to run while the sensed organ is offline (68b85dd auto-reverted b67da54, 2026-07-07 20:00Z).
      [ "$trc" = 0 ] || [ "$trc" = 2 ] && continue
      # mem-pressure gate (chat-review/fitness-mempressure-gate-missing): a bare rc=1 gets ONE quiet
      # retry (a CPU-storm flake clears on the second attempt; a genuine break fails twice) — mirrors
      # mesh-doctor's _sc_confirm_tool storm-flake guard. If it STILL fails (rc=1 or the 124 timeout)
      # while the node is genuinely memory-starved, it is an ENOMEM victim, not a broken tool → defer
      # (do NOT flag), exactly as doctor defers to n/a. A repeat failure under NORMAL memory is a real
      # regression and still flagged. Falsify: drop the retry+pressure check and 11c842b's false alarm
      # (rc under swap-thrash) re-fires.
      # A bare rc=1 OR rc=124 gets up to RETRIES quiet retries, SPACED by a cooldown. rc=124 (timeout)
      # joined the ladder 2026-07-16 (chat-review/fitness-rc124-single-sample-verdict): the suite is
      # sleep/IO-bound, so load stretches it toward the ceiling — a timeout is the failure mode MOST
      # correlated with transient load, yet it used to fall straight through to a single-sample hard
      # verdict (the 09:46Z false REGRESSION on 8acecfe — identical bytes passed rc=0 twice that same
      # day at 12s wall vs the 60s ceiling). The spacing is load-bearing:
      # the 2026-07-10T06:54Z false-revert of 403a6c0 (chat-review/rollcall-fitness-revert-403a6c0-false-
      # positive) failed TWO back-to-back attempts within 5s because both landed inside the SAME
      # sub-second fork-storm (concurrent minds transiently exhausting fork/allocation) — a spike that
      # moves NO standing metric, so _fit_mem_pressure_high read calm (PSI avg10=0.00 cold-hollow,
      # MemAvail 27%, SwapFree 36%) and the pressure backstop missed it; it reverted a tool whose --test
      # passes 3x in place. A single unspaced retry (the prior gate) both fell in the same window. The
      # cooldown lets a transient storm DRAIN between attempts; a genuine break fails every attempt
      # regardless of spacing. (Sleep is set to 0 in --test via the env knob so the suite stays fast.)
      if [ "$trc" = 1 ] || [ "$trc" = 124 ]; then
        _rtry=0
        while [ "$_rtry" -lt "${MESH_FITNESS_TEST_RETRIES:-2}" ]; do
          sleep "${MESH_FITNESS_TEST_RETRY_SLEEP:-2}" 2>/dev/null || true
          timeout "$TEST_TIMEOUT" "$REPO/$f" --test >/dev/null 2>&1; trc=$?
          { [ "$trc" = 0 ] || [ "$trc" = 2 ]; } && break
          _rtry=$((_rtry+1))
        done
        { [ "$trc" = 0 ] || [ "$trc" = 2 ]; } && continue
      fi
      # The deferral used to be silent — a branch that suppresses the mesh's only auto-revert and
      # says nothing leaves no way to tell "deferred under real pressure" from "never ran". It now
      # names the reading AND which window carried it, to stderr and to the durable log.
      if { [ "$trc" = 1 ] || [ "$trc" = 124 ]; } && _fit_mem_pressure_high; then
        echo "regressions: DEFER $(basename "$f") (rc=$trc) — node memory-starved: $_FIT_MEMP_NOTE" >&2
        printf '%s DEFER %s (rc=%s) memory-starved: %s\n' "$(ts)" "$(basename "$f")" "$trc" "$_FIT_MEMP_NOTE" >> "$LOG" 2>/dev/null || true
        continue
      fi
      # rc travels in the flag (→ reg_one → log line + alarm text): a 124 (timeout under load) and a
      # triple rc=1 (real assert failure) are different diagnoses and must read differently post-hoc.
      echo "$(basename "$f"):--test(rc=$trc)"
    fi
  done
}

# ── AGENCY GATE: blame only the failure THIS commit CAUSED (interactional asymmetry) ─────────────
# LITERATURE (enactivism & 4E cognition, live 2026): Haoliang Han, "From Detecting Agency to Doing
# Work: Self-Caused Credit Builds a Durable Behavioral Self in a Minimal Spiking Agent"
# (arXiv:2606.30191, submitted 2026-06-29). Verbatim from the abstract: "agency-gated slow credit --
# a conjunctive term Own*Agency*Salience driving a slow parameter update -- produces post-unload
# behavioral residue"; the dissociation is clean ("post-unload self-preservation 1.00 vs 0.00") and
# "the multiplicative veto also prevents forgetting: it retains old tasks ... where ADDITIVE POOLING
# collapses to chance-level recall, the NO-AGENCY ABLATION falls BELOW chance". The transferable
# operational claim: a system that updates itself from outcomes must gate credit/blame MULTIPLICATIVELY
# on whether the outcome was SELF-CAUSED. Ungated, the update is worse than not updating at all.
#   This is the third leg of the agency criterion this file already cites at :46-52 — Barandiaran,
#   Di Paolo & Rohde name individuality + INTERACTIONAL ASYMMETRY + normativity. The normativity leg
#   got its instrument (interscale_conflict). ASYMMETRY — "the agent is the CAUSE of the modulation"
#   — was never implemented here.
#   GAP (this file is the failure mode): the verdict "HEAD shipped a BROKEN tool" and the auto-revert
#   that follows are asserted from a SINGLE observation — the tool fails NOW. Nothing asks whether it
#   failed BEFORE. A tool broken by an earlier commit (exactly what this file's own unjudged_backlog
#   error-threshold margin says goes unjudged), or by a persistent environmental fault below the rc=2
#   convention, keeps failing; the NEXT self-produced commit that so much as touches that path is
#   blamed and reverted. That commit may be the repair. Additive blame, no agency term.
#   Mesh Verification Principle, same shape: a revert restores the PARENT's bytes, so an auto-revert
#   only repairs anything if the PARENT PASSES. That artifact was never checked — the revert asserted
#   a cure it had not seen.
# inherited_regressions <reg-lines> <changed-paths> — echo the TOOL BASENAMES in $reg that ALSO fail
# when judged against the PARENT commit's bytes (scratch tree, the same regressions() judge — the
# form the dirty-overlap attribution already uses at :601+). Those failures PREDATE HEAD: agency=0,
# blame vetoed. Matched on tool name, not on "tool:reason" — a tool that fails bash-n at the parent
# and --test at HEAD is still a pre-existing break, not something this commit caused.
# FAIL-CONSERVATIVE: no parent (root commit), a path the parent does not carry (added by HEAD), or an
# unreadable blob → nothing echoed → the entry stays attributed to HEAD, i.e. today's behavior. The
# gate can only ever WITHHOLD a revert, never mint one.
inherited_regressions(){ # $1 = newline "tool:reason" lines, $2 = newline changed paths
  local reg="$1" changed="$2" parent td f b e t paths inh
  parent="$(git rev-parse --verify -q 'HEAD^' 2>/dev/null)" || return 0
  [ -n "$parent" ] || return 0
  paths=""
  for e in $reg; do
    t="${e%%:*}"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ "$(basename "$f")" = "$t" ] && paths="$paths$f"$'\n'
    done <<EOF_CH
$changed
EOF_CH
  done
  [ -n "$paths" ] || return 0
  td="$(mktemp -d)" || return 0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mkdir -p "$td/$(dirname "$f")" 2>/dev/null || continue
    git show "$parent:$f" > "$td/$f" 2>/dev/null && chmod +x "$td/$f" 2>/dev/null || rm -f "$td/$f"
  done <<EOF_P
$paths
EOF_P
  inh="$(REPO="$td" regressions "$paths")"
  rm -rf "$td"
  for e in $inh; do b="${e%%:*}"; printf '%s\n' "$b"; done | sort -u
}

# unjudged_backlog $last $head — Eigen error-threshold instrument (read-only). Selection here is
# HEAD-only (judges 1 commit/run); when self-produced commits land faster than this runs (*/9), the
# commits BELOW the tip are never judged (HEAD moves past them). Count the self-produced commits in
# last..head that fall below the tip = the unselected-mutation backlog (the error-threshold margin).
unjudged_backlog(){
  case "$1" in none|"") echo 0; return;; esac
  git rev-list "$1..$2" 2>/dev/null | tail -n +2 | while IFS= read -r c; do
    git log -1 --format='%B' "$c" 2>/dev/null | grep -qi 'Co-Authored-By: Claude' && echo x
  done | grep -c . || true
}

# ── INTER-SCALE CONFLICT: a SECOND (PHYLOGENETIC) fitness grain ──────────────────────────────────
# (chat-review/fitness-interscale-conflict — grounds the HELD two-axis fix above (`:69-76`) + the
#  mesh-vitality POSIWID confession as an ACTUAL selection signal.) Sources: Coninx 2023, "the dark
#  side of niche construction" — an action FIT at the individual/short (ONTOGENETIC) scale can be
#  MALADAPTIVE at the population/long (PHYLOGENETIC) scale (INTER-SCALE CONFLICT); Scott-Phillips,
#  Laland, Shuker, Dickins & West 2014, "The Niche Construction Perspective: A Critical Appraisal"
#  (Evolution 68-5) — the forward-directional test of whether a modification is adaptive vs maladaptive.
# The existing signal is purely the ONTOGENETIC grain: does the tip PARSE + pass its own --test (micro-
# fit / survival). A commit can PASS that yet be long-grain maladaptive — pure comment/doc growth that
# "counts as production" (the POSIWID confession: this loop's ~128 same-shape inoculation commits each
# --test-passed while changing NO behavior), or a tool bloating with no new verification. This gate adds
# the phylogenetic read as REPORT-ONLY [fitness-conflict] — quarantine/flag, NEVER an auto-revert (that
# path stays for hard bash-n/--test regressions only). Cheap objective proxies (no semantic judgement):
#   comment-only : the commit's ADDED lines to a changed mesh tool are ALL comment/blank — 0 changed
#                  EXECUTABLE line — yet it landed as a self-produced production commit.
#   size-bloat   : the tool's byte size grew >BLOAT_X (default 1.5×) across its last K commits while its
#                  --test assert count did NOT rise (growth with zero new verification).
BLOAT_X_NUM="${MESH_FITNESS_BLOAT_X_NUM:-3}"; BLOAT_X_DEN="${MESH_FITNESS_BLOAT_X_DEN:-2}"  # 3/2 = 1.5×
BLOAT_K="${MESH_FITNESS_BLOAT_K:-5}"
interscale_conflict(){ # $1 = commit ref (default HEAD) → echoes "tool:grain" lines; empty = no conflict
  local commit="${1:-HEAD}" f
  # test-assertion signal for the size-bloat proxy: the shell 'smoke-test: FAIL' idiom PLUS this
  # codebase's dominant python fail-accumulator idiom (fails.append(...)/errors.append(...)). The old
  # 'FAIL|smoke-test|assert'-only pattern was blind to the append form, MALADAPTIVE-flagging well-tested
  # python commits whose fails.append count nearly doubled while grep-matched 'asserts' stayed flat
  # (chat-review/fitness-assert-counter-blind-to-append-idiom; live false-pos 6d7307c mesh-wifi-crossval:
  # grep-matched 3->3 while fails.append went 16->29). Overridable (MESH_FITNESS_AS_RE) so --test can
  # drive the pre-fix regex and watch the false-positive fire (RED-first proof it's load-bearing).
  local AS_RE="${MESH_FITNESS_AS_RE:-FAIL|smoke-test|assert|(fail|error|err|bad|problem|issue|warn)s?\.append\(}"
  git diff-tree --no-commit-id --name-only -r "$commit" 2>/dev/null | grep -vE '^$' | while IFS= read -r f; do
    case "$f" in scripts/mesh-*|*/mesh-*) :;; *) continue;; esac
    git cat-file -e "$commit:$f" 2>/dev/null || continue          # file present at that commit
    # proxy 1 — comment-only production: added lines all comment/blank, none executable.
    # EXCEPT the mesh's MACHINE-READ headers, which are '#'-prefixed by shell syntax but are
    # BEHAVIOR by function — a consumer parses them: `# reflex-cadence:`/`# reflex-args:` wire a
    # reflex into cron (mesh-autowire), `# orphan-ok:` suppresses the orphan WARN (mesh-doctor),
    # `# cap-allow:` scopes an organ (mesh-organ). A commit whose whole diff to a tool is such a
    # header IS the change — wiring an unwired reflex is the canonical never-wired-reflex fix, and
    # it flagged comment-only-production live (17da774, the sync-tools cadence). Counting them as
    # prose makes fitness cry-wolf on exactly the healthiest commits of the reflex/ROM-shim lane.
    local added exec_added prod_re
    # MESH_FITNESS_NO_HDR=1 disables the exemption so --test can drive the pre-fix behavior and watch
    # the false-positive fire (RED-first proof the exemption is load-bearing, not gate-widening).
    prod_re='^[[:space:]]*#[[:space:]]*(reflex-cadence|reflex-args|orphan-ok|cap-allow):'
    [ "${MESH_FITNESS_NO_HDR:-0}" = 1 ] && prod_re='^\0$'   # a pattern no line matches → exemption off
    added="$(git show -U0 --format= "$commit" -- "$f" 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+')"
    if [ -n "$added" ]; then
      exec_added="$(printf '%s\n' "$added" | sed 's/^+//' | grep -vcE '^[[:space:]]*#|^[[:space:]]*$')"
      local hdr_added
      hdr_added="$(printf '%s\n' "$added" | sed 's/^+//' | grep -cE "$prod_re")"
      [ "${exec_added:-0}" -eq 0 ] && [ "${hdr_added:-0}" -eq 0 ] \
        && { echo "$(basename "$f"):comment-only-production"; continue; }
    fi
    # proxy 2 — size bloat with no new --test asserts across the tool's last K commits.
    # Count asserts in the tool file AND in its SIBLING test-<name> harness: the uxn lane's tools
    # (mesh-lease-gate, mesh-series-stats, mesh-board-check…) are thin ROM dispatchers that carry ~0
    # inline asserts by design — the whole truth-table + twin-AGREE suite lives in test-<name>. Counting
    # only the tool file sees 0→0 and false-flags any growth size-bloat-no-new-asserts, the same class as
    # the fails.append blindness fixed before (6d7307c) — an assert the proxy cannot see is not a missing
    # assert. asserts_at <commit> <toolpath> → count across the tool + its harness at that commit.
    local prev cur_sz prev_sz cur_as prev_as
    asserts_at(){ # $1=commit $2=toolpath
      local c="$1" tf="$2" dir base test n
      dir="$(dirname "$tf")"; base="$(basename "$tf")"; test="$dir/test-${base#mesh-}"
      n="$(git show "$c:$tf" 2>/dev/null | grep -cE "$AS_RE")"
      # only ADD the harness where one exists at that commit — a tool with inline asserts and no
      # test-<name> is unchanged; MESH_FITNESS_NO_HARNESS=1 drives the pre-fix (tool-only) count.
      if [ "${MESH_FITNESS_NO_HARNESS:-0}" != 1 ] && git cat-file -e "$c:$test" 2>/dev/null; then
        n=$(( n + $(git show "$c:$test" 2>/dev/null | grep -cE "$AS_RE") ))
      fi
      printf '%s' "$n"
    }
    prev="$(git rev-list -n 1 --skip="$BLOAT_K" "$commit" -- "$f" 2>/dev/null)"
    if [ -n "$prev" ] && [ "$prev" != "$commit" ]; then
      cur_sz="$(git cat-file -s "$commit:$f" 2>/dev/null || echo 0)"
      prev_sz="$(git cat-file -s "$prev:$f" 2>/dev/null || echo 0)"
      cur_as="$(asserts_at "$commit" "$f")"
      prev_as="$(asserts_at "$prev" "$f")"
      if [ "${prev_sz:-0}" -gt 0 ] && [ $(( cur_sz * BLOAT_X_DEN )) -gt $(( prev_sz * BLOAT_X_NUM )) ] \
         && [ "${cur_as:-0}" -le "${prev_as:-0}" ]; then
        echo "$(basename "$f"):size-bloat-no-new-asserts(${prev_sz}->${cur_sz}b,asserts=${prev_as}->${cur_as})"
      fi
    fi
  done
}

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  SELF="$(cd "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)/$(basename -- "$0")"  # abs path — fixtures below cd away
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT; mkdir -p "$td/scripts"
  REPO="$td"
  # Pin the mem-pressure gate to a HEALTHY fixture for the whole --test block so the rc=1 assertions
  # below (mesh-realfail etc.) are deterministic regardless of the CI/host's real memory state — the
  # starved-fixture defer case overrides these two vars locally. (chat-review/fitness-mempressure-gate-missing)
  printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=0\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n' > "$td/psi-healthy"
  printf 'MemTotal:       8000000 kB\nMemAvailable:   6000000 kB\nSwapTotal:      8000000 kB\nSwapFree:       6000000 kB\n' > "$td/meminfo-healthy"
  printf 'MemTotal:       8000000 kB\nMemAvailable:    200000 kB\nSwapTotal:      8000000 kB\nSwapFree:        100000 kB\n' > "$td/meminfo-starved"
  export MESH_FITNESS_MEMPRESSURE_FILE="$td/psi-healthy" MESH_FITNESS_MEMINFO_FILE="$td/meminfo-healthy"
  export MESH_FITNESS_TEST_RETRY_SLEEP=0   # keep the retry cooldown out of the suite's wall-clock (prod default 2s)
  printf '#!/usr/bin/env bash\necho ok\n' > "$td/scripts/mesh-good"
  printf '#!/usr/bin/env bash\nif [ then oops\n'           > "$td/scripts/mesh-bad"   # broken syntax
  [ -z "$(regressions 'scripts/mesh-good')" ] || { echo "smoke-test: FAIL (good tool flagged)"; exit 1; }
  [ -n "$(regressions 'scripts/mesh-bad')" ]  || { echo "smoke-test: FAIL (broken syntax not caught)"; exit 1; }
  [ -z "$(regressions 'README.md')" ]         || { echo "smoke-test: FAIL (non-tool path flagged)"; exit 1; }
  # fitness-false-revert-bash-n-on-python: a VALID python3 tool (with a bash-INVALID body — the exact
  # live shape of mesh-minds/mesh-sense-map) must NOT be flagged; a genuinely-broken python tool still
  # must be. Falsify: revert _interp_of/regressions to the old bare `bash -n`/`bash "$f" --test` and
  # the FIRST assert here trips (bash -n on `sys.argv` throws "syntax error near unexpected token").
  printf '#!/usr/bin/env python3\nimport sys\nif len(sys.argv) > 1 and sys.argv[1] == "--test":\n    print("smoke-test: ok")\n    sys.exit(0)\nprint("ok")\n' > "$td/scripts/mesh-py-good"
  chmod +x "$td/scripts/mesh-py-good"
  [ -z "$(regressions 'scripts/mesh-py-good')" ] || { echo "smoke-test: FAIL (valid python3 tool flagged as a bash-syntax regression — the exact live mesh-minds/mesh-sense-map false-revert)"; exit 1; }
  printf '#!/usr/bin/env python3\ndef f(:\n    pass\n' > "$td/scripts/mesh-py-bad"   # broken python syntax
  [ -n "$(regressions 'scripts/mesh-py-bad')" ] || { echo "smoke-test: FAIL (genuinely broken python3 tool NOT caught — py-compile gate is a no-op)"; exit 1; }
  # a tool with an interpreter we don't dispatch (e.g. perl) is SKIPPED, never flagged — "skip-with-
  # note", not a false regression on a tool we simply don't know how to syntax-check.
  printf '#!/usr/bin/perl\nthis is not even valid perl {{{\n' > "$td/scripts/mesh-perl-thing"
  [ -z "$(regressions 'scripts/mesh-perl-thing' 2>/dev/null)" ] || { echo "smoke-test: FAIL (unrecognized-interpreter tool must be skipped, not flagged)"; exit 1; }
  # fitness-honest-n-a-not-regression (68b85dd auto-reverted b67da54, live 2026-07-07 20:00Z): a --test
  # exiting 2 is the mesh-wide HONEST-N/A convention (organ unreachable, hollow-sense real-read gates)
  # that mesh-land already treats as a pass — must NOT be flagged as a regression. A --test exiting 1
  # (a real failure) must still be flagged. Falsify: revert the `trc`-capture back to a bare `... || echo`
  # and the first assert here trips (rc=2 gets flagged same as rc=1).
  printf '#!/usr/bin/env bash\ncase "${1:-}" in --test) echo "smoke-test: n/a (organ unreachable)"; exit 2;; esac\necho ok\n' > "$td/scripts/mesh-na"
  chmod +x "$td/scripts/mesh-na"
  [ -z "$(regressions 'scripts/mesh-na')" ] || { echo "smoke-test: FAIL (honest rc=2 --test flagged as a regression — the exact live mesh-cell-signal false-revert)"; exit 1; }
  printf '#!/usr/bin/env bash\ncase "${1:-}" in --test) echo "smoke-test: FAIL"; exit 1;; esac\necho ok\n' > "$td/scripts/mesh-realfail"
  chmod +x "$td/scripts/mesh-realfail"
  [ -n "$(regressions 'scripts/mesh-realfail')" ] || { echo "smoke-test: FAIL (real rc=1 --test failure NOT caught — honest-n/a exemption swallowed real regressions too)"; exit 1; }
  # --- mem-pressure gate (chat-review/fitness-mempressure-gate-missing) ---------------------------------
  # (a) a rc=1 storm-flake (fails ONCE, passes on the quiet retry) must NOT be flagged — the retry rescues.
  printf '#!/usr/bin/env bash\nc="%s/flaky-count"\ncase "${1:-}" in --test) n=$(cat "$c" 2>/dev/null||echo 0); n=$((n+1)); echo "$n">"$c"; [ "$n" -ge 2 ] && exit 0 || exit 1;; esac\necho ok\n' "$td" > "$td/scripts/mesh-flaky1"
  chmod +x "$td/scripts/mesh-flaky1"; rm -f "$td/flaky-count"
  [ -z "$(regressions 'scripts/mesh-flaky1')" ] || { echo "smoke-test: FAIL (rc=1 storm-flake that passes on the quiet retry must NOT be flagged)"; exit 1; }
  # (a2) a rc=1 storm-flake that fails TWICE and passes on the THIRD attempt must NOT be flagged — the
  # multi-retry rescues it. This is the 403a6c0 false-revert class: two back-to-back attempts both fell
  # in the same fork-storm; only a SECOND spaced retry clears it. Falsify: set MESH_FITNESS_TEST_RETRIES=1
  # (the old single-retry gate) → mesh-flaky2 flags (breaks), reproducing the 06:54Z false-revert.
  printf '#!/usr/bin/env bash\nc="%s/flaky2-count"\ncase "${1:-}" in --test) n=$(cat "$c" 2>/dev/null||echo 0); n=$((n+1)); echo "$n">"$c"; [ "$n" -ge 3 ] && exit 0 || exit 1;; esac\necho ok\n' "$td" > "$td/scripts/mesh-flaky2"
  chmod +x "$td/scripts/mesh-flaky2"; rm -f "$td/flaky2-count"
  [ -z "$(regressions 'scripts/mesh-flaky2')" ] || { echo "smoke-test: FAIL (rc=1 storm-flake needing a SECOND spaced retry — the 403a6c0 double-fail class — must NOT be flagged)"; exit 1; }
  rm -f "$td/flaky2-count"
  [ -n "$(MESH_FITNESS_TEST_RETRIES=1 regressions 'scripts/mesh-flaky2')" ] || { echo "smoke-test: FAIL (falsify: with only ONE retry the double-fail flake must flag — proves the second retry is load-bearing)"; exit 1; }
  # (a3) rc=124 storm-flake (chat-review/fitness-rc124-single-sample-verdict — the 2026-07-16 09:46Z
  # false REGRESSION on 8acecfe): a --test that TIMES OUT once and passes on the spaced retry must NOT
  # be flagged. The suite is sleep/IO-bound, so transient load stretches it toward the timeout ceiling —
  # rc=124 is the failure mode MOST correlated with load, yet the old ladder gated on trc=1 only, making
  # a single timeout a hard-regression verdict shielded only by the pressure gate that its own header
  # documents as blind to sub-second storms. Watched RED against the trc=1-only ladder before the fix.
  printf '#!/usr/bin/env bash\nc="%s/flaky124-count"\ncase "${1:-}" in --test) n=$(cat "$c" 2>/dev/null||echo 0); n=$((n+1)); echo "$n">"$c"; [ "$n" -ge 2 ] && exit 0; sleep 5; exit 1;; esac\necho ok\n' "$td" > "$td/scripts/mesh-flaky124"
  chmod +x "$td/scripts/mesh-flaky124"; rm -f "$td/flaky124-count"
  [ -z "$(TEST_TIMEOUT=1 regressions 'scripts/mesh-flaky124')" ] || { echo "smoke-test: FAIL (rc=124 timeout-once flake that passes on the spaced retry must NOT be flagged — the 8acecfe false-REGRESSION class)"; exit 1; }
  # (a4) the rc must be RECORDED in the flag line (it flows via reg_one into BOTH the log line and the
  # alarm text) and the messages must DIFFER per failure mode — the 09:46 false alarm was undiagnosable
  # post-hoc because nothing recorded whether it saw 124 or a triple rc=1 (an-error-message-names-a-cause).
  # An ALWAYS-timing-out tool must STILL flag (the retry ladder must never give a genuine hang a pass).
  printf '#!/usr/bin/env bash\ncase "${1:-}" in --test) sleep 5; exit 1;; esac\necho ok\n' > "$td/scripts/mesh-alwayshang"
  chmod +x "$td/scripts/mesh-alwayshang"
  _r1="$(regressions 'scripts/mesh-realfail')"; _r124="$(TEST_TIMEOUT=1 regressions 'scripts/mesh-alwayshang')"
  printf '%s' "$_r1"   | grep -q 'rc=1'   || { echo "smoke-test: FAIL (rc=1 regression flag must record its rc, got '$_r1')"; exit 1; }
  printf '%s' "$_r124" | grep -q 'rc=124' || { echo "smoke-test: FAIL (always-timeout must still flag AND record rc=124 so the alarm differs from a triple-rc=1, got '$_r124')"; exit 1; }
  # (b) a tool that ALWAYS fails rc=1, under genuine memory starvation (starved meminfo fixture), is an
  # ENOMEM victim → must NOT be flagged (deferred, exactly like mesh-doctor's serial-confirm defers to n/a).
  [ -z "$(MESH_FITNESS_MEMINFO_FILE="$td/meminfo-starved" MESH_FITNESS_MEMPRESSURE_FILE="$td/nonexistent-psi" regressions 'scripts/mesh-realfail')" ] \
    || { echo "smoke-test: FAIL (repeat rc=1 under genuine mem-starvation must be DEFERRED, not flagged — ENOMEM victim ≠ broken tool)"; exit 1; }
  # (b2) COVERAGE of the pressure gate itself: avg10 is 1.85% of a 540 s cadence, and the windows that
  # cover the rest sit in the same PSI line. Fixture: avg10 CALM (0.00) while avg300 is 40 — the storm
  # was 4 minutes ago and the ten-second window has already forgotten it. A repeat rc=1 here is an
  # ENOMEM victim and must DEFER. Against the old avg10-only gate this fixture FLAGS (measured) — it
  # is the 403a6c0 false-revert class written down as a test.
  printf 'some avg10=0.00 avg60=12.00 avg300=40.00 total=99999\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n' > "$td/psi-wide"
  [ -z "$(MESH_FITNESS_MEMPRESSURE_FILE="$td/psi-wide" MESH_FITNESS_MEMINFO_FILE="$td/meminfo-healthy" regressions 'scripts/mesh-realfail')" ] \
    || { echo "smoke-test: FAIL (avg10=0 but avg300=40: a repeat rc=1 during a storm the 10s window already forgot must DEFER — the 403a6c0 class)"; exit 1; }
  # …and the deferral must SAY SO. A branch that suppresses the mesh's only auto-revert in silence is
  # indistinguishable from one that never ran, so the note is part of the behaviour, not decoration —
  # asserted here on the real stderr of a real deferring call (deleting the echo leaves this green
  # otherwise: measured).
  _defmsg="$(MESH_FITNESS_MEMPRESSURE_FILE="$td/psi-wide" MESH_FITNESS_MEMINFO_FILE="$td/meminfo-healthy" regressions 'scripts/mesh-realfail' 2>&1 >/dev/null)"
  case "$_defmsg" in
    *DEFER*won=avg300*) : ;;
    *) echo "smoke-test: FAIL (a deferral must name itself and the window that carried it, got: '$_defmsg')"; exit 1 ;;
  esac
  # …and the WINNER must be named in the note, or the deferral cannot be read back post-hoc.
  MESH_FITNESS_MEMPRESSURE_FILE="$td/psi-wide" MESH_FITNESS_MEMINFO_FILE="$td/meminfo-healthy" _fit_mem_pressure_high
  case "$_FIT_MEMP_NOTE" in
    *"won=avg300"*) : ;;
    *) echo "smoke-test: FAIL (the widest window carried the verdict but the note does not name it: '$_FIT_MEMP_NOTE')"; exit 1 ;;
  esac
  # (b3) the INTERVAL window: every avg is calm, and only the carried `total=` accumulator shows the
  # interval was 50% stalled (270,000,000 µs of stall across the 540 s since the baseline — one
  # cadence, inside MAX_IV_AGE). Nothing readable in the PSI line at this instant says so: this is
  # exactly the window the sweep is about, and the only one that covers 100% of the interval.
  printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=270000000\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n' > "$td/psi-iv"
  _FIT_PSI_PREV="$(( $(date -u +%s) - 540 )) 0" \
    MESH_FITNESS_MEMPRESSURE_FILE="$td/psi-iv" MESH_FITNESS_MEMINFO_FILE="$td/meminfo-healthy" _fit_mem_pressure_high \
    || { echo "smoke-test: FAIL (all avgs calm but the interval accumulator shows 50% stall — the gate did not see it)"; exit 1; }
  case "$_FIT_MEMP_NOTE" in
    *"window=inst+iv"*"won=iv"*) : ;;
    *) echo "smoke-test: FAIL (the interval window carried the verdict but the note reads '$_FIT_MEMP_NOTE')"; exit 1 ;;
  esac
  # (b4) …and widening must NOT swallow a real regression: all four windows calm + healthy memory →
  # the repeat rc=1 is still FLAGGED. Without this the fix would trade false reverts for silence.
  printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=1000\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n' > "$td/psi-calm"
  [ -n "$(_FIT_PSI_PREV="$(( $(date -u +%s) - 540 )) 900" MESH_FITNESS_MEMPRESSURE_FILE="$td/psi-calm" MESH_FITNESS_MEMINFO_FILE="$td/meminfo-healthy" regressions 'scripts/mesh-realfail')" ] \
    || { echo "smoke-test: FAIL (all four windows calm and memory healthy — a repeat rc=1 is a REAL regression and must still be flagged)"; exit 1; }
  # _fit_psi_iv: a real across-run delta — 54,000,000 µs of stall in 540 s = 10.00%.
  [ "$(_fit_psi_iv "1000 0" 1540 54000000 2160)" = "10.00" ] \
    || { echo "smoke-test: FAIL (_fit_psi_iv → $(_fit_psi_iv "1000 0" 1540 54000000 2160), want 10.00)"; exit 1; }
  # MISSING EVIDENCE RENDERS na, NEVER 0 — a 0 here is a fabricated calm, and this gate's calm side
  # is the one that lets an auto-revert fire on an innocent commit.
  [ "$(_fit_psi_iv "" 1540 54000000 2160)" = na ]           || { echo "smoke-test: FAIL (no baseline must be na)"; exit 1; }
  [ "$(_fit_psi_iv "1000 garbage" 1540 54000000 2160)" = na ] || { echo "smoke-test: FAIL (garbage baseline must be na)"; exit 1; }
  [ "$(_fit_psi_iv "1540 0" 1540 54000000 2160)" = na ]     || { echo "smoke-test: FAIL (dt=0 must be na)"; exit 1; }
  [ "$(_fit_psi_iv "1000 0" 99999 54000000 2160)" = na ]    || { echo "smoke-test: FAIL (stale baseline past max-age must be na)"; exit 1; }
  [ "$(_fit_psi_iv "1000 99999999" 1540 54000000 2160)" = na ] || { echo "smoke-test: FAIL (counter went BACKWARDS (reboot) must be na, not a calm interval)"; exit 1; }
  # _fit_psi_fold: max across the four windows, and it must NAME the one it took.
  [ "$(_fit_psi_fold 0.00 1.00 40.00 na)"   = "40.00 avg300" ] || { echo "smoke-test: FAIL (fold → $(_fit_psi_fold 0.00 1.00 40.00 na), want '40.00 avg300')"; exit 1; }
  [ "$(_fit_psi_fold 0.00 0.00 0.00 33.30)" = "33.30 iv" ]     || { echo "smoke-test: FAIL (fold must let the interval win and name it)"; exit 1; }
  [ "$(_fit_psi_fold 55.00 1.00 2.00 3.00)" = "55.00 avg10" ]  || { echo "smoke-test: FAIL (fold must still let the 10s window win when it IS the loudest)"; exit 1; }
  [ "$(_fit_psi_fold na na na na)"          = "na none" ]      || { echo "smoke-test: FAIL (no readable window must fold to 'na none', never to 0)"; exit 1; }
  # (c) regression guard: the SAME always-fail tool under NORMAL memory (healthy fixture, exported above)
  # must STILL be flagged — the defer must never give a real repeat-failure a free pass. This is exactly
  # the mesh-realfail assertion above (runs under the healthy fixture); the two together are the both-ways
  # falsify: revert the pressure check → (b) flags (breaks); revert the retry → (a) flags (breaks).
  # timeout-too-short false-positive (fd28da8/mesh-overhear, live 2026-07-06 23:27Z): a LEGITIMATELY
  # slow but passing --test must not be killed by an unrealistically tight timeout and misread as a
  # regression. Falsify: drop MESH_FITNESS_TEST_TIMEOUT override and this trips (bare TEST_TIMEOUT=60
  # default still wouldn't cover a slower CI box, which is the whole point of making it overridable).
  printf '#!/usr/bin/env bash\ncase "${1:-}" in --test) sleep 2; echo "smoke-test: ok"; exit 0;; esac\necho ok\n' > "$td/scripts/mesh-slow"
  chmod +x "$td/scripts/mesh-slow"
  [ -n "$(TEST_TIMEOUT=1 regressions 'scripts/mesh-slow')" ] || { echo "smoke-test: FAIL (a --test slower than the timeout should still be CAUGHT as :--test when the timeout is genuinely too short — sanity-checking the mechanism itself)"; exit 1; }
  [ -z "$(TEST_TIMEOUT=10 regressions 'scripts/mesh-slow')" ] || { echo "smoke-test: FAIL (a slow-but-passing --test must NOT be flagged once the timeout comfortably covers its real runtime)"; exit 1; }
  # error-threshold instrument: build a 3-commit history (base + 2 self-produced); base..tip holds the
  # tip PLUS one self-produced commit BELOW it → the unjudged backlog must be 1 (that below-tip commit).
  ( cd "$td" && git init -q 2>/dev/null && git config user.email t@t && git config user.name t \
    && git commit -q --allow-empty -m base \
    && git commit -q --allow-empty -m "$(printf 'c1\n\nCo-Authored-By: Claude')" \
    && git commit -q --allow-empty -m "$(printf 'c2 tip\n\nCo-Authored-By: Claude')" ) \
    || { echo "smoke-test: FAIL (could not build test history)"; exit 1; }
  cd "$td" || { echo "smoke-test: FAIL (cd test repo)"; exit 1; }
  etm_base="$(git rev-parse HEAD~2)"; etm_tip="$(git rev-parse HEAD)"
  got="$(unjudged_backlog "$etm_base" "$etm_tip")"
  [ "$got" = 1 ] || { echo "smoke-test: FAIL (error-threshold margin: want 1 unjudged self-produced commit below tip, got '$got')"; exit 1; }
  [ "$(unjudged_backlog none "$etm_tip")" = 0 ] || { echo "smoke-test: FAIL (error-threshold margin: first-run/no-state must be 0)"; exit 1; }
  # ── inter-scale conflict gate (fitness-interscale-conflict) — falsifiable BOTH ways ──────────────
  # A behavior-changing commit must PASS (empty); a pure comment-only commit must TRIP. (cwd = $td repo)
  mkdir -p "$td/scripts"
  printf '#!/usr/bin/env bash\necho v1\n' > "$td/scripts/mesh-fix"
  git add scripts/mesh-fix >/dev/null 2>&1
  git commit -q -m "$(printf 'add mesh-fix\n\nCo-Authored-By: Claude')" >/dev/null 2>&1
  printf '#!/usr/bin/env bash\necho v1\necho v2\n' > "$td/scripts/mesh-fix"   # ADD an executable line
  git commit -aqm "$(printf 'real change\n\nCo-Authored-By: Claude')" >/dev/null 2>&1
  ic_real="$(interscale_conflict HEAD)"
  [ -z "$ic_real" ] || { echo "smoke-test: FAIL (interscale: behavior-changing commit must PASS the gate, got '$ic_real')"; exit 1; }
  printf '#!/usr/bin/env bash\necho v1\necho v2\n# just a doc note, zero behavior\n' > "$td/scripts/mesh-fix"  # ADD only a comment
  git commit -aqm "$(printf 'comment only\n\nCo-Authored-By: Claude')" >/dev/null 2>&1
  ic_cmt="$(interscale_conflict HEAD)"
  printf '%s' "$ic_cmt" | grep -q 'mesh-fix:comment-only-production' || { echo "smoke-test: FAIL (interscale: comment-only commit must TRIP the gate, got '$ic_cmt')"; exit 1; }
  # MACHINE-READ HEADER is production, not prose (fitness-header-idiom-is-not-comment): a commit whose
  # only added line to a tool is a `# reflex-cadence:` header wires that reflex into cron — it must NOT
  # trip comment-only. Falsifiable BOTH ways: under MESH_FITNESS_NO_HDR=1 (the pre-fix behavior) the
  # SAME commit MUST trip, proving the exemption is load-bearing and not just widening the gate to pass.
  printf '#!/usr/bin/env bash\necho v1\necho v2\n# just a doc note, zero behavior\n# reflex-cadence: */20 * * * *\n' > "$td/scripts/mesh-fix"
  git commit -aqm "$(printf 'wire the reflex\n\nCo-Authored-By: Claude')" >/dev/null 2>&1
  ic_hdr="$(interscale_conflict HEAD)"
  printf '%s' "$ic_hdr" | grep -q 'mesh-fix:comment-only-production' && { echo "smoke-test: FAIL (interscale: a # reflex-cadence: wiring commit must NOT trip comment-only — it schedules the reflex, got '$ic_hdr')"; exit 1; }
  ic_hdr_old="$(MESH_FITNESS_NO_HDR=1 interscale_conflict HEAD)"
  printf '%s' "$ic_hdr_old" | grep -q 'mesh-fix:comment-only-production' || { echo "smoke-test: FAIL (falsify: with the header exemption OFF, the cadence-only commit MUST trip — proves the exemption is load-bearing, got '$ic_hdr_old')"; exit 1; }
  # GUARD the changed-file detection form (the live-path `changed=` line) — `git show --no-patch
  # --name-only` FATALS on git ≥2.43 → empty list → reg always empty → auto-revert core DEAD. Assert
  # the diff-tree form actually names the changed tool, so that silent-empty regression can't recur.
  _chg="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -vE '^$')"
  printf '%s' "$_chg" | grep -q 'scripts/mesh-fix' || { echo "smoke-test: FAIL (changed-file detection returned empty — the git show --no-patch --name-only fatal-bug regressed)"; exit 1; }
  # ── size-bloat assert-counter (chat-review/fitness-assert-counter-blind-to-append-idiom) — RED-first ──
  # The bloat proxy compares --test assert counts across BLOAT_K(=5) commits; the OLD regex counted only
  # 'FAIL|smoke-test|assert' and was BLIND to this codebase's dominant python idiom fails.append(...), so a
  # commit that grew a tool >1.5× WHILE nearly doubling its real fails.append assertions got a false
  # size-bloat-no-new-asserts verdict (live 6d7307c mesh-wifi-crossval: grep-matched 3->3 while
  # fails.append went 16->29, MALADAPTIVE-flagged on mesh-home+phaedra 18:27Z). Fixture: 6 commits (so
  # rev-list --skip=5 reaches the base) that each grow the file AND add a fails.append line. Under the
  # FIXED regex it must NOT flag; under the pre-fix regex the SAME commit MUST flag (append-matching load-bearing).
  bloaty="$td/scripts/mesh-bloaty"
  for i in 0 1 2 3 4 5; do
    { printf '#!/usr/bin/env python3\nfails=[]\n'
      j=0; while [ "$j" -le "$i" ]; do printf 'fails.append("a%s")\n' "$j"; j=$((j+1)); done
      k=0; while [ "$k" -le "$i" ]; do printf '# pad-%s-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n' "$k"; k=$((k+1)); done
    } > "$bloaty"
    git add scripts/mesh-bloaty >/dev/null 2>&1
    git commit -aqm "$(printf 'bloaty c%s\n\nCo-Authored-By: Claude' "$i")" >/dev/null 2>&1
  done
  ic_bloat="$(interscale_conflict HEAD)"
  printf '%s' "$ic_bloat" | grep -q 'mesh-bloaty:size-bloat' && { echo "smoke-test: FAIL (size-bloat false-positive: a commit ADDING fails.append assertions must NOT be flagged no-new-asserts, got '$ic_bloat')"; exit 1; }
  ic_bloat_old="$(MESH_FITNESS_AS_RE='FAIL|smoke-test|assert' interscale_conflict HEAD)"
  printf '%s' "$ic_bloat_old" | grep -q 'mesh-bloaty:size-bloat' || { echo "smoke-test: FAIL (falsify: under the pre-fix regex the append-only growth MUST flag size-bloat — proves fails.append counting is load-bearing, got '$ic_bloat_old')"; exit 1; }
  # ── external-harness assert-counting (fitness-blind-to-external-test-harness) — RED-first ──────────
  # The uxn lane's tools are thin ROM dispatchers with ~0 INLINE asserts; the whole suite lives in a
  # sibling test-<name>. A tool that GROWS while its EXTERNAL harness gains asserts must NOT flag
  # size-bloat. 6 commits (rev-list --skip=5 reaches base): each grows scripts/uxn/mesh-romtool AND
  # adds a 'FAIL' assert to test-romtool — the tool file's own assert count stays 0 throughout.
  mkdir -p "$td/scripts/uxn"
  for i in 0 1 2 3 4 5; do
    { printf '#!/usr/bin/env bash\n# thin ROM dispatcher, asserts live in test-romtool\n'
      j=0; while [ "$j" -le "$i" ]; do printf 'exec_line_%s=%s   # real logic, not a comment\n' "$j" "$j"; j=$((j+1)); done
    } > "$td/scripts/uxn/mesh-romtool"
    { printf '#!/usr/bin/env bash\n# test-romtool — the external harness\n'
      k=0; while [ "$k" -le "$i" ]; do printf 'echo "FAIL: axis %s"   # an assertion\n' "$k"; k=$((k+1)); done
    } > "$td/scripts/uxn/test-romtool"
    git add scripts/uxn/mesh-romtool scripts/uxn/test-romtool >/dev/null 2>&1
    git commit -aqm "$(printf 'romtool c%s\n\nCo-Authored-By: Claude' "$i")" >/dev/null 2>&1
  done
  ic_ext="$(interscale_conflict HEAD)"
  printf '%s' "$ic_ext" | grep -q 'mesh-romtool:size-bloat' && { echo "smoke-test: FAIL (external-harness: a uxn tool growing while its test-<name> gains asserts must NOT flag size-bloat, got '$ic_ext')"; exit 1; }
  ic_ext_old="$(MESH_FITNESS_NO_HARNESS=1 interscale_conflict HEAD)"
  printf '%s' "$ic_ext_old" | grep -q 'mesh-romtool:size-bloat' || { echo "smoke-test: FAIL (falsify: counting the tool file ALONE, the external-harness tool MUST flag size-bloat — proves harness-counting is load-bearing, got '$ic_ext_old')"; exit 1; }
  # ── dirty-gate scope (chat-review/fitness-dirty-gate-is-tree-wide) — falsifiable BOTH ways ────────
  # The auto-revert dirty gate was tree-WIDE (ANY porcelain line disarmed it) while the risk is
  # path-scoped: git revert itself only refuses when local mods OVERLAP the reverted paths. Live
  # cost: ONE untracked root _tr.log disarmed auto-revert for 2 days (c97959e's [done]) — on busy
  # landing days, exactly when a broken commit is most likely, the only auto-recovery was off.
  # Both fixtures drive the LIVE judge (bash "$SELF" under a fixture HOME → its own REPO/STATE/LOG).
  # Fixture A: broken self-produced HEAD + an UNRELATED untracked file → must REVERT (HEAD moves).
  # Watched RED against the tree-wide gate before the dirty∩changed fix.
  _dg="$td/dg-unrel"; mkdir -p "$_dg/.mesh" "$_dg/lte-workstation/scripts"
  ( cd "$_dg/lte-workstation" \
    && git init -q && git config user.email t@t && git config user.name t \
    && printf '#!/usr/bin/env bash\necho ok\n' > scripts/mesh-brk && chmod +x scripts/mesh-brk \
    && git add -A && git commit -qm base \
    && printf '#!/usr/bin/env bash\nif [ then oops\n' > scripts/mesh-brk \
    && git commit -aqm "$(printf 'break it\n\nCo-Authored-By: Claude')" \
    && echo junk > _unrelated.log ) || { echo "smoke-test: FAIL (dirty-gate fixture A build)"; exit 1; }
  _dg_pre="$(git -C "$_dg/lte-workstation" rev-parse HEAD)"
  HOME="$_dg" bash "$SELF" >/dev/null 2>&1
  _dg_post="$(git -C "$_dg/lte-workstation" rev-parse HEAD)"
  [ "$_dg_post" != "$_dg_pre" ] || { echo "smoke-test: FAIL (an UNRELATED dirty file disarmed auto-revert — tree-wide gate; want dirty∩changed scope)"; exit 1; }
  grep -q 'REVERTED' "$_dg/.mesh/fitness.log" || { echo "smoke-test: FAIL (dirty-gate fixture A: HEAD moved but no REVERTED log line)"; exit 1; }
  # Fixture B (regression guard): dirt OVERLAPPING the judged commit's own path must still
  # alarm-not-revert — the path-scoped gate must never widen into reverting over local edits.
  _dg2="$td/dg-over"; mkdir -p "$_dg2/.mesh" "$_dg2/lte-workstation/scripts"
  ( cd "$_dg2/lte-workstation" \
    && git init -q && git config user.email t@t && git config user.name t \
    && printf '#!/usr/bin/env bash\necho ok\n' > scripts/mesh-brk && chmod +x scripts/mesh-brk \
    && git add -A && git commit -qm base \
    && printf '#!/usr/bin/env bash\nif [ then oops\n' > scripts/mesh-brk \
    && git commit -aqm "$(printf 'break it\n\nCo-Authored-By: Claude')" \
    && echo '# local uncommitted tweak' >> scripts/mesh-brk ) || { echo "smoke-test: FAIL (dirty-gate fixture B build)"; exit 1; }
  _dg2_pre="$(git -C "$_dg2/lte-workstation" rev-parse HEAD)"
  HOME="$_dg2" bash "$SELF" >/dev/null 2>&1
  _dg2_post="$(git -C "$_dg2/lte-workstation" rev-parse HEAD)"
  [ "$_dg2_post" = "$_dg2_pre" ] || { echo "smoke-test: FAIL (OVERLAPPING dirt must alarm-not-revert, but HEAD moved)"; exit 1; }
  grep -q 'DIRTY' "$_dg2/.mesh/fitness.log" || { echo "smoke-test: FAIL (dirty-gate fixture B: no DIRTY alarm line in fitness.log)"; exit 1; }
  # ── attribution (chat-review/fitness-dirty-overlap-misattributes-to-head) ────────────────────────
  # Fixture C: GREEN self-produced HEAD + broken UNCOMMITTED edit on the same path. regressions()
  # tested WORKING-TREE bytes, so the old code stamped 'HEAD shipped a BROKEN tool' + a revert
  # instruction for bytes HEAD never contained (live 01:09Z on 7fa9a20 — two minds burned a
  # verification pass each calling it stale). On overlap the judge must re-run the COMMITTED copy
  # (git show HEAD:$f): committed-pass + tree-fail = MID-WORK note, no alarm, exit 0. Fixture B above
  # is the both-ways control: committed-fail + overlap still stamps today's DIRTY alarm, now truthful.
  # Watched RED pre-fix (log carried the DIRTY attribution, rc=1).
  _dg3="$td/dg-midwork"; mkdir -p "$_dg3/.mesh" "$_dg3/lte-workstation/scripts"
  ( cd "$_dg3/lte-workstation" \
    && git init -q && git config user.email t@t && git config user.name t \
    && printf '#!/usr/bin/env bash\necho ok\n' > scripts/mesh-brk && chmod +x scripts/mesh-brk \
    && git add -A && git commit -qm base \
    && printf '#!/usr/bin/env bash\ncase "${1:-}" in --test) echo "smoke-test: ok"; exit 0;; esac\necho ok\n' > scripts/mesh-brk \
    && git commit -aqm "$(printf 'improve it\n\nCo-Authored-By: Claude')" \
    && printf '#!/usr/bin/env bash\nif [ then oops\n' > scripts/mesh-brk ) || { echo "smoke-test: FAIL (attribution fixture C build)"; exit 1; }
  _dg3_pre="$(git -C "$_dg3/lte-workstation" rev-parse HEAD)"
  HOME="$_dg3" bash "$SELF" >/dev/null 2>&1; _dg3_rc=$?
  _dg3_post="$(git -C "$_dg3/lte-workstation" rev-parse HEAD)"
  [ "$_dg3_post" = "$_dg3_pre" ] || { echo "smoke-test: FAIL (fixture C: mid-work dirt must never move HEAD, but it moved)"; exit 1; }
  grep -q 'MID-WORK' "$_dg3/.mesh/fitness.log" || { echo "smoke-test: FAIL (fixture C: green HEAD + broken uncommitted edit must log MID-WORK, not a shipped regression)"; exit 1; }
  if grep -q 'DIRTY' "$_dg3/.mesh/fitness.log"; then echo "smoke-test: FAIL (fixture C: the 'shipped a BROKEN tool' DIRTY attribution fired on a green HEAD)"; exit 1; fi
  [ "$_dg3_rc" = 0 ] || { echo "smoke-test: FAIL (fixture C: a mid-work verdict is not a fitness failure — must exit 0, got $_dg3_rc)"; exit 1; }
  # ── AGENCY GATE (enactivism/4E, Han arXiv:2606.30191 — self-caused credit) — the DISCRIMINATOR PAIR ──
  # Fixture D is fixture A with ONE bit changed: the PARENT is already broken. Everything else is
  # identical (same tool, same broken bytes at HEAD, same clean tree, same self-produced trailer), so
  # anything that separates them separates on CAUSATION alone. A must REVERT (asserted above — that
  # leg is also this gate's falsifier: a gate that vetoed everything would redden it); D must NOT.
  # Watched RED pre-gate: D reverted the innocent commit and logged REVERTED.
  _ag="$td/ag-inherited"; mkdir -p "$_ag/.mesh" "$_ag/lte-workstation/scripts"
  ( cd "$_ag/lte-workstation" \
    && git init -q && git config user.email t@t && git config user.name t \
    && printf '#!/usr/bin/env bash\nif [ then oops\n' > scripts/mesh-brk && chmod +x scripts/mesh-brk \
    && git add -A && git commit -qm "base (ALREADY broken)" \
    && printf '#!/usr/bin/env bash\nif [ then oops\n# an innocent touch — maybe the start of the repair\n' > scripts/mesh-brk \
    && git commit -aqm "$(printf 'touch the already-broken tool\n\nCo-Authored-By: Claude')" ) \
    || { echo "smoke-test: FAIL (agency-gate fixture D build)"; exit 1; }
  _ag_pre="$(git -C "$_ag/lte-workstation" rev-parse HEAD)"
  # MESH_DIR redirected OFF "$HOME/.mesh" (second instance of chat-review/quotareact-test-sandboxed-
  # chat-swallow, 2026-08-10): mesh-chat's MESH_TEST_SANDBOX defense — which mesh-doctor exports
  # around EVERY child --test — swallows any post whose MESH_DIR == "$HOME/.mesh", because HOME-only
  # sandboxing is indistinguishable from "a tool that forgot to sandbox its outbound". A redirected
  # MESH_DIR is mesh-chat's own documented self-sandbox escape, so the post still lands. Without it
  # this suite was rc=0 bare and rc=1 under the doctor sweep FOREVER — the alarm assertion below
  # asserted only that a bare run posts, and doctor cried FAIL(real) on a suite nobody could
  # reproduce by hand. fitness.log stays HOME-derived (:35 M="$HOME/.mesh"), so only the board moves.
  HOME="$_ag" MESH_DIR="$_ag/chat-sb" bash "$SELF" >/dev/null 2>&1; _ag_rc=$?
  _ag_post="$(git -C "$_ag/lte-workstation" rev-parse HEAD)"
  [ "$_ag_post" = "$_ag_pre" ] || { echo "smoke-test: FAIL (agency gate: a break INHERITED from the parent must never be reverted — HEAD moved, an innocent commit was destroyed and the tool is still broken)"; exit 1; }
  grep -q 'INHERITED-BREAK' "$_ag/.mesh/fitness.log" || { echo "smoke-test: FAIL (agency gate: pre-existing break must log INHERITED-BREAK, got: $(cat "$_ag/.mesh/fitness.log" 2>/dev/null))"; exit 1; }
  if grep -q 'REVERTED' "$_ag/.mesh/fitness.log"; then echo "smoke-test: FAIL (agency gate: fixture D reverted a commit that caused nothing)"; exit 1; fi
  [ "$_ag_rc" = 0 ] || { echo "smoke-test: FAIL (agency gate: an inherited break is not a HEAD regression — must exit 0, got $_ag_rc)"; exit 1; }
  # The verdict must stay LOUD: agency=0 withholds the REVERT, never the alarm (a silenced
  # pre-existing break is the dead-lane shape — nothing else judges it, HEAD-only selection walked past).
  # Ordered BEFORE the alarm assertion on purpose: if a future edit drops the MESH_DIR redirect, the
  # post lands on the HOME board and this names the reason, instead of the generic "withheld the
  # alarm" below sending the reader after a regulation bug that isn't there. (Under the doctor sweep
  # the same edit yields NO post on either board, and the assertion below is the honest report.)
  [ ! -s "$_ag/.mesh/chat.log" ] \
    || { echo "smoke-test: FAIL (agency gate: the child posted to the HOME board, not the redirected MESH_DIR sandbox — mesh-chat's MESH_TEST_SANDBOX gate will swallow it under mesh-doctor)"; exit 1; }
  grep -q 'fitness-inherited' "$_ag/chat-sb/chat.log" 2>/dev/null \
    || { echo "smoke-test: FAIL (agency gate: withheld the revert AND the alarm — the break must still be reported, got: $(cat "$_ag/chat-sb/chat.log" 2>/dev/null))"; exit 1; }
  # Direct unit leg on the helper: parent-green → NOTHING inherited (the gate cannot veto a real
  # self-caused break), asserted against the same repo used for the changed-file guard above.
  cd "$td" || { echo "smoke-test: FAIL (cd back to $td)"; exit 1; }
  printf '#!/usr/bin/env bash\nif [ then oops\n' > "$td/scripts/mesh-fix"
  git commit -aqm "$(printf 'break mesh-fix\n\nCo-Authored-By: Claude')" >/dev/null 2>&1
  _ag_u="$(inherited_regressions 'mesh-fix:bash-n' 'scripts/mesh-fix')"
  [ -z "$_ag_u" ] || { echo "smoke-test: FAIL (agency gate: parent was GREEN, so nothing may be marked inherited — got '$_ag_u'; a gate that vetoes a real break disables auto-revert entirely)"; exit 1; }
  echo "smoke-test: ok (regressions: good/bad bash + good/bad python3 (shebang-dispatched syntax check) + unrecognized-interpreter skip + honest-rc2-not-flagged + real-rc1-still-flagged + rc1-storm-flake-retry-rescued + rc124-timeout-once-retry-rescued + always-hang-still-flagged-with-rc-recorded + repeat-rc1-under-mem-starvation-deferred + PSI COVERAGE: avg300-only storm deferred, interval-accumulator-only storm deferred, all-windows-calm still flagged, na-not-0 (5) + fold names its window (4); timeout-too-short mechanism sanity + timeout-comfortably-covers-real-runtime; error-threshold margin; interscale-conflict pass/trip; changed-file diff-tree detection; dirty-overlap attribution: mid-work-not-alarmed + committed-fail-still-alarmed; agency gate: inherited-break-not-reverted-but-still-alarmed + parent-green-still-reverts + helper-vetoes-nothing-on-a-green-parent)"; exit 0
fi

CHECK=0; [ "${1:-}" = --check ] && CHECK=1

# PSI baseline carry (see _fit_mem_pressure_high). Read the PREVIOUS run's stall counter, then stamp
# this run's — so the mem-pressure gate can measure the WHOLE interval between two fitness runs and
# not just the kernel's last 10 seconds. Done HERE, above the "already judged this tip" early exit
# that most runs take: parked below it the baseline would only refresh when a new commit appeared,
# and every interval would be days wide, i.e. permanently stale → permanently na.
_FIT_PSI_RAW="${MESH_FITNESS_PSI_RAW:-$M/.fitness-psi-raw}"
_FIT_PSI_PREV="$(cat "$_FIT_PSI_RAW" 2>/dev/null | tail -1)"
{
  _psi_now_total="$(awk '/^some/{for(i=1;i<=NF;i++) if ($i ~ /^total=/) { sub(/^total=/,"",$i); print $i; exit }}' \
    "${MESH_FITNESS_MEMPRESSURE_FILE:-/proc/pressure/memory}" 2>/dev/null)"
  case "${_psi_now_total:-}" in ''|*[!0-9]*) : ;; *) printf '%s %s\n' "$(date -u +%s)" "$_psi_now_total" > "$_FIT_PSI_RAW" 2>/dev/null || true ;; esac
} 2>/dev/null

cd "$REPO" 2>/dev/null || { echo "$(ts) no repo" >> "$LOG"; exit 0; }

head="$(git rev-parse HEAD 2>/dev/null)" || exit 0
last="$(cat "$STATE" 2>/dev/null || echo none)"
[ "$head" = "$last" ] && [ "$CHECK" != 1 ] && exit 0     # already judged this tip

# ERROR-THRESHOLD instrument (read-only, no behavior change): how many self-produced commits landed
# since the last check but fall BELOW this tip → they are never judged (HEAD-only selection skips
# past them). Eigen: above the threshold, unselected mutations accumulate (error catastrophe).
# Make the margin VISIBLE before any range-revert enforcement (instrument-before-actuator).
etm="$(unjudged_backlog "$last" "$head")"
[ "${etm:-0}" -gt 0 ] && {
  echo "$(ts) FITNESS-BACKLOG $etm self-produced commit(s) in $(printf '%.8s' "$last")..$(printf '%.8s' "$head") below the tip go UNJUDGED (error-threshold margin: variation outpacing HEAD-only selection)" >> "$LOG"
  [ "$CHECK" = 1 ] && echo "fitness: error-threshold margin = $etm self-produced commit(s) since last check go UNJUDGED (HEAD-only selection; variation > selection rate)"
}

# self-produced only — never touch an operator commit
body="$(git log -1 --format='%B' 2>/dev/null)"
if ! printf '%s' "$body" | grep -qi 'Co-Authored-By: Claude'; then
  [ "$CHECK" = 1 ] && { echo "fitness: HEAD is an operator commit — out of scope"; exit 0; }
  echo "$head" > "$STATE"; echo "$(ts) HEAD $(git log -1 --oneline) not self-produced — skip" >> "$LOG"; exit 0
fi

# NOTE (fitness-interscale-conflict, 2026-07-06): `git show --no-patch --name-only` FATALS on git ≥2.43
# ('-s' and '--name-only' are mutually exclusive) — with 2>/dev/null that silently yielded an EMPTY
# changed-list → reg always empty → EVERY commit read FIT, the auto-revert core DEAD. Use diff-tree.
changed="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -vE '^$')"
reg="$(regressions "$changed")"

# AGENCY GATE (see inherited_regressions above): split the observed failures into SELF-CAUSED (the
# parent's bytes pass — this commit is the cause) and INHERITED (broken at the parent too). Only the
# self-caused half may drive the auto-revert. Runs solely on the rare regression path, so the extra
# --test pass costs nothing on a green tip.
inherited=""
if [ -n "$reg" ]; then
  inh_tools="$(inherited_regressions "$reg" "$changed")"
  if [ -n "$inh_tools" ]; then
    _self=""
    for _e in $reg; do
      if printf '%s\n' "$inh_tools" | grep -qxF "${_e%%:*}"; then inherited="$inherited $_e"
      else _self="$_self$_e"$'\n'; fi
    done
    reg="$(printf '%s' "$_self" | grep -vE '^$' || true)"
    inherited="${inherited# }"
  fi
fi

conflict="$(interscale_conflict HEAD)"   # phylogenetic grain (report-only, never reverts)

if [ "$CHECK" = 1 ]; then
  [ -n "$conflict" ] && echo "fitness: INTER-SCALE CONFLICT at HEAD — micro-fit but long-grain-maladaptive → $(printf '%s' "$conflict" | tr '\n' ' ')"
  [ -n "$inherited" ] && echo "fitness: INHERITED (broken at the parent too, NOT caused by HEAD) → $inherited"
  if [ -n "$reg" ]; then echo "fitness: REGRESSED at HEAD ($(git log -1 --oneline)) → $reg"; exit 1
  else echo "fitness: ok ($(git log -1 --oneline) — changed tools pass bash -n + --test)"; exit 0; fi
fi

if [ -z "$reg" ] && [ -n "$inherited" ]; then
  # AGENCY=0: every observed failure predates HEAD. Reverting would destroy an innocent (possibly
  # repairing) commit and restore bytes that fail identically — a cure with no artifact. But the break
  # is REAL and nothing else is looking at it (HEAD-only selection walked past the commit that caused
  # it — the error-threshold margin, made concrete). LOUD, never silent; owner clause so it routes.
  echo "$head" > "$STATE"
  echo "$(ts) HEAD $(git log -1 --oneline) INHERITED-BREAK ($inherited) — broken at the parent too, NOT caused by HEAD; no revert" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="fitness@$(hostname)" \
    mesh-chat "[fitness-inherited] $(echo "$head" | cut -c1-8) touched ($inherited) but did NOT break them — the SAME failure reproduces on its parent $(git rev-parse --short 'HEAD^' 2>/dev/null). Agency gate held the auto-revert (reverting restores bytes that fail identically). A PRE-EXISTING break is live and unowned — HEAD-only selection walked past whatever caused it. owner: genome/health." >/dev/null 2>&1 || true
  exit 0
fi

if [ -z "$reg" ]; then
  # micro-fit (conservation) PASSED. Phylogenetic grain: if long-grain-maladaptive, FLAG once — no revert.
  if [ -n "$conflict" ]; then
    conflict_one="$(printf '%s' "$conflict" | tr '\n' ' ')"
    echo "$(ts) HEAD $(git log -1 --oneline) FIT(micro) but INTER-SCALE-CONFLICT ($conflict_one) — flagged, NOT reverted" >> "$LOG"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="fitness@$(hostname)" \
      mesh-chat "[fitness-conflict] $(echo "$head" | cut -c1-8) passed --test (micro-fit) but is long-grain-MALADAPTIVE: $conflict_one. Quarantine/flag only — NOT auto-reverted (the phylogenetic grain grounds the mesh-vitality POSIWID confession as a selection signal; a mind/steward decides). owner: mind/steward." >/dev/null 2>&1 || true
  fi
  echo "$head" > "$STATE"; echo "$(ts) HEAD $(git log -1 --oneline) FIT" >> "$LOG"; exit 0
fi

# regression confirmed on a self-produced HEAD — and, after the agency gate, CAUSED by it
reg_one="$(printf '%s' "$reg" | tr '\n' ' ')"
# partial split: some tools were already broken at the parent. Say so wherever the verdict is read,
# so the revert is never mistaken for a fix of THOSE (they survive it).
inh_note=""; [ -n "$inherited" ] && inh_note=" [inherited, NOT reverted-away: $inherited]"
# Dirty gate is PATH-SCOPED, not tree-wide (chat-review/fitness-dirty-gate-is-tree-wide): git revert
# only refuses when local mods OVERLAP the reverted paths, so gate on dirty∩changed — the tree-wide
# form let ONE unrelated untracked file disarm auto-revert for 2 days, i.e. the mesh's only
# auto-recovery was off exactly on busy landing days. Unrelated dirt falls through to the revert
# (git itself still enforces the real conflict case, and that failure path alarms below).
dirty="$(git status --porcelain 2>/dev/null | cut -c4- | sed 's/^.* -> //')"   # rename lines keep the NEW path
overlap=""
[ -n "$dirty" ] && [ -n "$changed" ] && \
  overlap="$(comm -12 <(printf '%s\n' "$dirty" | sort -u) <(printf '%s\n' "$changed" | sort -u))"
if [ -n "$overlap" ]; then
  # dirt on the judged commit's OWN paths (genome lane mid-work on that very tool) — do NOT risk a
  # revert. But regressions() above tested WORKING-TREE bytes, so before attributing the failure to
  # HEAD ('shipped a BROKEN tool' + a revert instruction), re-judge the COMMITTED copies
  # (chat-review/fitness-dirty-overlap-misattributes-to-head — live 01:09Z: genome's mid-session
  # edits failed --test and fitness handed out 'git revert' for a green commit; the dirty gate
  # protected the REVERT but not the ATTRIBUTION). git show HEAD:$f → scratch tree → the same
  # regressions() judge. Failures on non-overlap paths ran clean bytes and stay attributed to HEAD.
  overlap_one="$(printf '%s' "$overlap" | tr '\n' ' ')"
  _att_td="$(mktemp -d)"
  while IFS= read -r _of; do
    [ -n "$_of" ] || continue
    mkdir -p "$_att_td/$(dirname "$_of")"
    git show "HEAD:$_of" > "$_att_td/$_of" 2>/dev/null && chmod +x "$_att_td/$_of" 2>/dev/null || true
  done <<EOF_ATT
$overlap
EOF_ATT
  _att_reg="$(REPO="$_att_td" regressions "$overlap")"
  rm -rf "$_att_td"
  _overlap_bases="$(printf '%s\n' "$overlap" | while IFS= read -r _p; do [ -n "$_p" ] && basename "$_p"; done)"
  _head_fail=""; _tree_fail=""
  for _entry in $reg; do
    _b="${_entry%%:*}"
    if printf '%s\n' "$_overlap_bases" | grep -qxF "$_b" && ! printf '%s' "$_att_reg" | grep -qF "$_b:"; then
      _tree_fail="$_tree_fail $_entry"     # committed copy passes — the break is the local edit
    else
      _head_fail="$_head_fail $_entry"     # committed copy fails too (or path isn't dirty) — HEAD's
    fi
  done
  echo "$head" > "$STATE"   # mark judged so we don't re-alarm/re-note every run
  if [ -z "$_head_fail" ]; then
    echo "$(ts) MID-WORK working-tree edits break ($reg_one) on ($overlap_one) but the committed copies at HEAD pass — not a shipped regression, no alarm" >> "$LOG"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="fitness@$(hostname)" \
      mesh-chat "[fyi] fitness: working-tree edits break ($reg_one) — mid-work on ($overlap_one), NOT a shipped regression (committed copies at HEAD $(echo "$head" | cut -c1-8) pass --test). No revert needed; whoever owns the edits finishes or discards them." >/dev/null 2>&1
    exit 0
  fi
  echo "$(ts) REGRESSION at HEAD ($reg_one) but tree DIRTY on the judged paths ($overlap_one) — alarmed, not reverted (committed-copy re-judge confirms:$_head_fail)" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="fitness@$(hostname)" \
    mesh-chat "[fitness-regression] HEAD $(git log -1 --oneline | cut -c1-50) shipped a BROKEN tool (committed-copy re-judge confirms:$_head_fail) but local edits overlap its paths ($overlap_one) — NOT auto-reverting. A mind/steward: fix or 'git revert $head'." >/dev/null 2>&1
  exit 1
fi

# clean tree → safe to auto-revert the tip
if git revert --no-edit HEAD >/dev/null 2>&1; then
  new="$(git rev-parse HEAD)"; echo "$new" > "$STATE"
  echo "$(ts) REVERTED $head ($reg_one) — fitness drop, clean revert -> $new$inh_note" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="fitness@$(hostname)" \
    mesh-chat "[fitness-revert] auto-reverted $(echo "$head" | cut -c1-8) — it shipped a broken tool ($reg_one). Selection: a regressive self-modification was undone.$inh_note sync-tools redeploys the restored tool; steward pushes." >/dev/null 2>&1
  exit 1
else
  git revert --abort >/dev/null 2>&1 || true
  echo "$head" > "$STATE"
  echo "$(ts) REGRESSION at HEAD ($reg_one) — revert FAILED (conflict?), alarmed" >> "$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="fitness@$(hostname)" \
    mesh-chat "[fitness-regression] HEAD shipped a broken tool ($reg_one); auto-revert failed (conflict) — needs a mind/steward." >/dev/null 2>&1
  exit 1
fi