#!/usr/bin/env bash
# reflex-cadence: 7-59/15 * * * *
# mesh-queue-tend — conservative reconcile: flip [~]→[x] in ideas-queue when a board [done]
# strongly matches. Never flips on weak matches (losing undone work > clutter).
#
#   mesh-queue-tend --list      dry-run (no edits)
#   mesh-queue-tend             apply flips
#   mesh-queue-tend --test      smoke test
set -uo pipefail
MESH="$HOME/.mesh"; Q="$MESH/ideas-queue"; CHAT="$MESH/chat.log"; TRACES="$MESH/traces.log"
STOPF="$MESH/.queue-tend-stopwords"
LOG="$MESH/queue-tend.log"
ts(){ date -u +%FT%TZ; }

# ── TEACHBACK instrument (Pask Conversation Theory, read-only). An idea is closed when a [done]
# KEYWORD-matches it — but a [done] that merely RESTATES the task's words with no concrete artifact
# is ROTE, and Pask's "agreement on understanding" rejects rote: understanding must be DEMONSTRATED by
# applying it to a concrete situation. Here "concrete" = a real cite (commit hash / path / artifact
# filename). Measure how often the queue closes on a rote [done] BEFORE gating it
# (instrument-before-actuator). No behavior change — counts + logs only.
rote_flips=0
done_demonstrates(){  # 0 = carries a concrete cite (demonstrated); 1 = rote (keyword echo only)
  grep -qE '(^|[^0-9a-f])[0-9a-f]{7,40}([^0-9a-f]|$)|[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+|\.(md|sh|py|json|conf|log)([^A-Za-z]|$)' <<<"$1"
}
note_teachback(){  # $1=cat  $2=matched-[done]-text — log+count when an idea closes on a rote done
  done_demonstrates "$2" && return 0
  rote_flips=$((rote_flips+1))
  echo "$(ts) TEACHBACK-ROTE closed [$1] on a [done] with no concrete cite (rote restatement, understanding not demonstrated): ${2:0:70}" >> "$LOG" 2>/dev/null || true
}

# ─── tilde-reaper config (queue-tend/tilde-reaper) ──────────────────────────────────────────────
# A [~] is "claimed/in-flight". A worker can die or move on, leaving a ZOMBIE [~] that is neither
# done [x] nor available [ ] — the floor starves while claimed-never-resolved ideas pile up. The
# reaper: a [~] older than REAP_WINDOW with NO live [taking] and NO resolution → DEMOTE [~]→[ ] so
# it re-enters the floor; blocked-on-external (phone/IR/SIM offline) → PARK (stay [~], never demote
# into a re-block loop nor close); fresh or token-matched-resolved/claimed → stay. NOT blind-close.
SEEN="$MESH/.ideas-tilde-seen"               # sha1(idea)<sp>first-seen-epoch — per-idea age (no per-line ts in the queue)
REAP_WINDOW="${MESH_REAP_WINDOW:-86400}"     # a [~] unclaimed+unresolved this long → reap. Default 1d (conservative:
                                             # existing [~] age from the FIRST reaper run, so nothing demotes for a window).
# blocked-on-external: cannot progress without an OFFLINE dependency → park, do not re-floor (would
# just re-dispatch into the same block) and do not close (not resolved). Honest classification.
BLOCKED_RE='BLOCKED|phone (offline|body|next reachable|reachable)|[Nn]eeds?( a)? .*phone|phone body|Redmi|IR blast|infrared|termux|\bSIM\b|when phone'
idea_key(){ printf '%s' "$1" | sha1sum 2>/dev/null | cut -c1-16; }
distinct_tokens(){ # idea -> up to 6 distinctive lowercase tokens (>3 chars, non-stopword) for overlap checks
  echo "${1#\[~\] }" | sed -E 's/\(source:.*//;s/ —.*//' | tr -cs '[:alnum:]' '\n' \
    | awk 'length>3' | tr 'A-Z' 'a-z' | grep -viFf "$STOPF" 2>/dev/null | sort -u | head -6
}
tokens_overlap(){ # $1=tokens(newline) $2=lines $3=min -> 0 if SOME line shares >=min tokens (resolved/claimed)
  local toks="$1" lines="$2" min="$3" ln t hits
  [ -z "$lines" ] && return 1
  while IFS= read -r ln; do
    [ -z "$ln" ] && continue
    hits=0
    for t in $toks; do echo "$ln" | grep -Fiq "$t" && hits=$((hits+1)); [ "$hits" -ge "$min" ] && return 0; done
  done <<< "$lines"
  return 1
}

# ── SEMANTIC second-chance for the tilde-reaper (queue-tend/semantic-keep) ──────────────────────
# tokens_overlap is PURELY LEXICAL: it KEEPS a stale [~] only when the resolving/claiming board line
# shares ≥2 distinctive tokens. A [done] that resolved the idea in DIFFERENT WORDS (a paraphrase —
# "delete stale scratch files" vs "purge obsolete temp caches") shares <2 tokens → the idea is
# wrongly DEMOTED/re-floored → duplicate dispatch. mesh-embed (local all-minilm/GPU semantic organ,
# landed 2026-07-18) closes that gap. This is FAIL-SAFE in the conservative direction: a semantic
# match only ever PREVENTS a demote (KEEP), never causes one — the reaper's own bias (losing undone
# work > clutter). HONEST: if the embed organ is absent (exit 2), EMBED_OK stays 0 and we skip the
# semantic pass entirely → the existing lexical-only behaviour is unchanged (never a faked all-clear).
SEM_MIN="${MESH_QUEUE_SEMANTIC_MIN:-0.45}"      # cos ≥ this = semantically resolved/claimed (paraphrase 0.50–0.82; mesh-noise ceiling ~0.17 — measured all-minilm 2026-07-18)
SEM_SCAN_MAX="${MESH_QUEUE_SEMANTIC_SCAN:-40}"  # cap the board lines a demote-candidate is embedded against (most-recent tail) — bound the per-run embed cost
EMBED_OK=0   # set to 1 once at reaper start iff mesh-embed reports an embed model (honest exit-2 gate)
semantic_overlap(){ # $1=idea $2=lines -> 0 if the idea is semantically near SOME line (cos ≥ SEM_MIN)
  [ "$EMBED_OK" = 1 ] || return 1
  local idea lines ln msg cos scanned=0
  idea="$(echo "${1#\[~\] }" | sed -E 's/\(source:.*//;s/ —.*//')"   # mirror distinct_tokens' stripping
  [ -z "$idea" ] && return 1
  lines="$2"; [ -z "$lines" ] && return 1
  # newest first (a resolution post-dates the idea), capped — bound embed calls per candidate
  while IFS= read -r ln; do
    [ -z "$ln" ] && continue
    [ "$scanned" -ge "$SEM_SCAN_MAX" ] && break
    scanned=$((scanned+1))
    msg="${ln#*:: }"   # compare against the board MESSAGE, not the ts/node prefix
    cos="$(mesh-embed --cos "$idea" "$msg" 2>/dev/null)" || continue   # exit 2 (organ blip) → skip this line, no fake
    awk -v c="$cos" -v m="$SEM_MIN" 'BEGIN{exit !(c+0>=m+0)}' && return 0
  done <<< "$(printf '%s\n' "$lines" | grep -v '^[[:space:]]*$' | tail -n "$SEM_SCAN_MAX" | tac)"
  return 1
}

extract_cat() { echo "$1" | sed -E 's/^\[[^]]*\][[:space:]]*//; s/:.*//'; }

extract_words() {
  local desc="${1#*: }"
  desc="$(echo "$desc" | sed -E 's/\(field:.*\)//;s/\(idea:.*\)//;s/\(.*//;s/ —.*//')"
  echo "$desc" | tr -cs '[:alnum:]' '\n' | awk 'length>2' | grep -viFf "$STOPF" | head -5
}

# A bounded token match: <needle> appears in <line> as a whole word, optionally mesh-prefixed.
# Avoids substring false-positives ("say" must not match "essay"/"saves").
word_in() { echo "$2" | grep -iqE "(^|[^a-z0-9-])(mesh-)?${1}([^a-z0-9-]|\$)"; }

# Auto-novelty ideas (CONNECTION / LITERATURE generate→filter) are resolved by EITHER a [done]
# OR an [idle] dead-end discard (per the method: "if it is a dead end, post a one-line [idle] why
# and discard"). Their resolution lines reference the SPECIFIC content — the fused tool names or
# the quoted topic — never the generic "(auto novelty)" category prefix, so match on that.
# Sets MATCH_SUMMARY and returns 0 when resolved.
NOV_LINES=""
novelty_match() {
  local idea="$1" kind="$2" ln t all hits need topic tools twords sig sigA sigB anchA anchB a hitA hitB
  # ALSO read traces.log: gen-pair/CONNECTION dead-ends are recorded ONCE there (mesh-generate frames
  # the worker to `mesh-trace "gen-pair-deadend A×B: why"`, NOT a board [idle] — keeps negative
  # exploration off the coordination board while still resolving the idea here). genpair-deadend-to-trace.
  # STUDY dead-ends use the SAME off-board convention (chat-review/study-kind-deadend-never-reconciles,
  # 2026-07-01): a genome worker that hits a STUDY dead-end posts [fyi] + `mesh-trace "study-deadend
  # <topic-slug>/...: why"` (genome-established 2026-06-28T02:56:19Z), not [done]/[idle] — mirror the
  # gen-pair-deadend widening below.
  [ -z "$NOV_LINES" ] && NOV_LINES="$(grep -E '\[(done|idle)\]' "$CHAT" 2>/dev/null; grep -iE 'gen-pair-deadend|study-deadend' "$TRACES" 2>/dev/null)"
  if [ "$kind" = "CONNECTION" ]; then
    # fused tool bare-names (strip mesh-); need >=2; ONE resolution line must mention ALL of them
    tools="$(echo "$idea" | grep -oE 'mesh-[a-z0-9-]+' | sed 's/^mesh-//' | sort -u)"
    if [ "$(echo "$tools" | grep -c .)" -ge 2 ]; then
      while IFS= read -r ln; do
        [ -z "$ln" ] && continue
        all=1; for t in $tools; do word_in "$t" "$ln" || { all=0; break; }; done
        [ "$all" = 1 ] && { MATCH_SUMMARY="$(echo "$ln" | sed -E 's/.*\[(done|idle)\][[:space:]]*//' | head -c 100)"; return 0; }
      done <<< "$(echo "$NOV_LINES" | grep -iE 'CONNECTION|gen-pair')"
      return 1
    fi
    # CONNECTION (data-seeded): names raw SENSOR/DEVICE identifiers, not mesh- tools (mesh-ideate's
    # template: "...shows the <A> sense and the <B> sense are empirically coupled...") — the mesh-
    # token extraction above always finds <2 for this template, so without this fallback these ideas
    # can NEVER auto-resolve even when a valid gen-pair-deadend trace already names both signals.
    # Same STIMULUS-STALL class the CO-OSCILLATION branch below exists to fix for a sibling kind
    # (observed live 2026-07-22: DV8235×LE-Bose Revolve SoundLink traced dead-end on 2026-07-21
    # sat [~] forever — "CONNECTION" kind never reached a signal-name matcher). Mirrors
    # CO-OSCILLATION's distinctive-anchor + both-sides-required guards below.
    echo "$idea" | grep -q '(data-seeded)' || return 1
    sig="$(echo "$idea" | sed -E 's/^.*shows the //; s/ sense are empirically coupled.*//')"
    sigA="${sig% sense and the *}"; sigB="${sig##* sense and the }"
    { [ -z "$sigA" ] || [ -z "$sigB" ] || [ "$sigA" = "$sig" ]; } && return 1
    anchA="$(echo "$sigA" | tr -cs '[:alnum:]_' '\n' | grep -viwE 'the|and|sense' | awk 'length>=4 || (length>=2 && /[A-Za-z]/ && /[0-9]/)')"
    anchB="$(echo "$sigB" | tr -cs '[:alnum:]_' '\n' | grep -viwE 'the|and|sense' | awk 'length>=4 || (length>=2 && /[A-Za-z]/ && /[0-9]/)')"
    { [ -z "$anchA" ] || [ -z "$anchB" ]; } && return 1
    while IFS= read -r ln; do
      [ -z "$ln" ] && continue
      hitA=0; for a in $anchA; do echo "$ln" | grep -Fiq "$a" && { hitA=1; break; }; done
      [ "$hitA" = 1 ] || continue
      hitB=0; for a in $anchB; do echo "$ln" | grep -Fiq "$a" && { hitB=1; break; }; done
      [ "$hitB" = 1 ] && { MATCH_SUMMARY="$(echo "$ln" | sed -E 's/.*gen-pair-deadend[[:space:]]*//; s/.*\[(done|idle)\][[:space:]]*//' | head -c 100)"; return 0; }
    done <<< "$(echo "$NOV_LINES" | grep -iE 'CONNECTION|gen-pair')"
  elif [ "$kind" = "CO-OSCILLATION" ]; then
    # CO-OSCILLATION (auto, real data): "<signalA> and <signalB> fluctuate …" — the resolution
    # names the two co-oscillating SIGNALS (devices/APs), NOT mesh- tools, so the CONNECTION arm's
    # `mesh-` extraction finds <2 and never matches. Without this branch these ideas can NEVER
    # resolve (the generic matcher keys on a board [done] echoing the category prefix, which a
    # signal-named gen-pair-deadend trace never carries) → permanent STIMULUS-STALL re-float.
    # Require BOTH signals named: split "<A> and <B>" and demand >=1 distinctive anchor from EACH
    # side in the resolution line. A total-anchor-count match would false-close a LIVE idea when an
    # unrelated trace/done shares 2 incidental tokens (one side, or generic noise) — verified against
    # real data: an arrivals×stress trace and plan-stream dones spuriously matched the loose form.
    sig="$(echo "$idea" | sed -E 's/^.*\(auto, real data\): *//; s/ +fluctuate.*//')"
    sigA="${sig% and *}"; sigB="${sig##* and }"
    # DISTINCTIVE anchors only: a token >=4 chars, OR a >=2-char alphanumeric MIX (e.g. "N7",
    # "DV8235"). Drops 2-3 char pure-alpha/pure-digit fragments ("Wi","Fi","GL","24","765") that
    # substring-match incidental words/numbers and false-close a LIVE idea (verified on real data:
    # "24" hit a zonemap done; "Wi"/"Fi" — fragments of a split "Wi-Fi 1202" AP name — hit unrelated dones).
    anchA="$(echo "$sigA" | tr -cs '[:alnum:]_' '\n' | grep -viwE 'wifi|and|the|ble|device|count|over|real|data|auto' | awk 'length>=4 || (length>=2 && /[A-Za-z]/ && /[0-9]/)')"
    anchB="$(echo "$sigB" | tr -cs '[:alnum:]_' '\n' | grep -viwE 'wifi|and|the|ble|device|count|over|real|data|auto' | awk 'length>=4 || (length>=2 && /[A-Za-z]/ && /[0-9]/)')"
    { [ -z "$anchA" ] || [ -z "$anchB" ]; } && return 1
    while IFS= read -r ln; do
      [ -z "$ln" ] && continue
      hitA=0; for a in $anchA; do echo "$ln" | grep -Fiq "$a" && { hitA=1; break; }; done
      [ "$hitA" = 1 ] || continue
      hitB=0; for a in $anchB; do echo "$ln" | grep -Fiq "$a" && { hitB=1; break; }; done
      [ "$hitB" = 1 ] && { MATCH_SUMMARY="$(echo "$ln" | sed -E 's/.*gen-pair-deadend[[:space:]]*//; s/.*\[(done|idle)\][[:space:]]*//' | head -c 100)"; return 0; }
    done <<< "$(echo "$NOV_LINES" | grep -iE 'gen-pair|co-oscillation')"
  elif [ "$kind" = "STUDY" ]; then
    # STUDY ideas are worded 'STUDY(<topic-slug>): ...' — no double-quoted topic (the LITERATURE
    # branch's quote-extraction below doesn't apply, so STUDY ideas fell through to the generic
    # word-matcher, which requires an exact 'STUDY(topic)' substring in a [done] — effectively never
    # matches → permanently stranded [~]). Match the topic slug verbatim: covers both an ordinary
    # [done] citing the slug AND the study-deadend trace convention above.
    topic="$(echo "$idea" | grep -oE 'STUDY\([^)]+\)' | head -1 | sed -E 's/^STUDY\(//; s/\)$//')"
    [ -z "$topic" ] && return 1
    # Require the EXACT marker — 'STUDY(<topic>)' verbatim, or 'study-deadend <topic>' adjacency —
    # not a bare substring: a short/generic slug ("crdt") false-matched an UNRELATED [done] that
    # merely discussed the concept in prose while resolving a DIFFERENT idea (verified live
    # 2026-07-01: "STUDY(distributed-systems) — ADJUDICATED: ... G-Set CRDT ..." incidentally
    # contains "crdt" and wrongly closed STUDY(crdt), which had never actually been resolved).
    while IFS= read -r ln; do
      [ -z "$ln" ] && continue
      { echo "$ln" | grep -Fq "STUDY($topic)" || echo "$ln" | grep -Eq "study-deadend[[:space:]]+${topic}(/|:|[[:space:]]|\$)"; } \
        && { MATCH_SUMMARY="$(echo "$ln" | sed -E 's/.*study-deadend[[:space:]]*//; s/.*\[(done|idle)\][[:space:]]*//' | head -c 100)"; return 0; }
    done <<< "$(echo "$NOV_LINES" | grep -E 'study-deadend|STUDY\(')"
  else  # LITERATURE: quoted topic words must appear in a LITERATURE resolution line
    topic="$(echo "$idea" | grep -oE '"[^"]+"' | head -1 | tr -d '"')"
    [ -z "$topic" ] && return 1
    twords="$(echo "$topic" | tr -cs '[:alnum:]' '\n' | awk 'length>3' | grep -viFf "$STOPF" | head -5)"
    [ -z "$twords" ] && return 1
    need="$(echo "$twords" | grep -c .)"; [ "$need" -gt 2 ] && need=2
    while IFS= read -r ln; do
      [ -z "$ln" ] && continue
      hits=0; for t in $twords; do echo "$ln" | grep -Fiq "$t" && hits=$((hits+1)); done
      [ "$hits" -ge "$need" ] && { MATCH_SUMMARY="$(echo "$ln" | sed -E 's/.*\[(done|idle)\][[:space:]]*//' | head -c 100)"; return 0; }
    done <<< "$(echo "$NOV_LINES" | grep -i 'LITERATURE')"
  fi
  return 1
}

[ "${1:-}" = "--test" ] && {
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v awk  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v sed  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  # Dry-run: synthetic ideas-queue + chat.log, exercise matching algorithm via --list.
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/.mesh"
  # Seed stopwords (extract_words depends on it)
  printf 'a an the for\n' > "$_td/.mesh/.queue-tend-stopwords"
  # Synthetic ideas-queue: SHOULD flip = SMOKE GAP(done) + CONNECTION(idle discard) + LITERATURE(done);
  # SHOULD stay = EXOTIC(no done) + CONNECTION(no resolution).
  printf '%s\n' '[~] SMOKE GAP: add meaningful --test to mesh-foo (field: testing)' > "$_td/.mesh/ideas-queue"
  printf '%s\n' '[~] EXOTIC: build underwater mesh node (idea: hardware)' >> "$_td/.mesh/ideas-queue"
  printf '%s\n' '[~] CONNECTION (auto novelty): fuse mesh-aaa (x) × mesh-bbb (y). What NEW sense emerges?' >> "$_td/.mesh/ideas-queue"
  printf '%s\n' '[~] CONNECTION (auto novelty): fuse mesh-ccc (x) × mesh-ddd (y). What NEW sense emerges?' >> "$_td/.mesh/ideas-queue"
  printf '%s\n' '[~] LITERATURE (auto novelty): "quantum foam" — does the mesh embody it?' >> "$_td/.mesh/ideas-queue"
  # Synthetic chat.log: [done] for SMOKE GAP + LITERATURE; [idle] dead-end discard for CONNECTION aaa×bbb.
  printf '%s\n' '2026-06-17T12:00Z ?@test :: [done] SMOKE GAP: mesh-foo now has a --test that passes' > "$_td/.mesh/chat.log"
  printf '%s\n' '2026-06-17T12:01Z ?@test :: [done] DOC DRIFT: fix docs/bar.md typo' >> "$_td/.mesh/chat.log"
  printf '%s\n' '2026-06-17T12:02Z ?@test :: [idle] CONNECTION aaa × bbb = dead end, discard' >> "$_td/.mesh/chat.log"
  printf '%s\n' '2026-06-17T12:03Z ?@test :: [done] LITERATURE quantum foam: mesh lacks it' >> "$_td/.mesh/chat.log"
  # Run with --list (dry-run, no edits)
  out="$(HOME="$_td" bash "$0" --list 2>/dev/null)" || { echo "smoke-test: FAIL (exec errored: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '3 flipped \+ 2 stayed' || { echo "smoke-test: FAIL (expected 3 flip 2 stay, got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'SMOKE GAP.*→ \[x\]'      || { echo "smoke-test: FAIL (SMOKE GAP should flip to [x], no match: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'aaa.*bbb\|→ \[x\]  resolved:.*aaa' || { echo "smoke-test: FAIL (CONNECTION aaa×bbb should flip via [idle] discard, got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'quantum foam\|→ \[x\]' || { echo "smoke-test: FAIL (LITERATURE quantum foam should flip, got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'EXOTIC'                     || { echo "smoke-test: FAIL (EXOTIC should appear in stayed, got: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'ccc'                        || { echo "smoke-test: FAIL (CONNECTION ccc×ddd should stay — no resolution, got: $out)"; exit 1; }
  # teachback instrument: classifier + the rote-flip summary must surface (all 3 synthetic dones are
  # rote — keyword echoes with no commit/path/artifact cite — so the queue closes them on rote).
  done_demonstrates 'fixed in scripts/mesh-foo (abc1234)' || { echo "smoke-test: FAIL (teachback: a done citing a path+hash must read DEMONSTRATED)"; exit 1; }
  done_demonstrates 'all good now, works great'           && { echo "smoke-test: FAIL (teachback: a done with no concrete cite must read ROTE)"; exit 1; }
  printf '%s\n' "$out" | grep -qE 'teachback: [0-9]+ of [0-9]+ flip' || { echo "smoke-test: FAIL (teachback rote-flip summary missing from output: $out)"; exit 1; }
  # Verify queue was NOT modified (--list is dry-run)
  grep -q '^\[~\] SMOKE GAP' "$_td/.mesh/ideas-queue"  || { echo "smoke-test: FAIL (--list modified the queue — dry-run broken)"; exit 1; }
  # APPLY run: real flips must be EXACT-line — a resolved novelty idea must NOT collapse its
  # still-open sibling that shares the "CONNECTION (auto novelty)" header (the 2026-06-20 bug).
  HOME="$_td" bash "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (apply errored)"; exit 1; }
  q="$_td/.mesh/ideas-queue"
  grep -q '^\[x\] CONNECTION (auto novelty): fuse mesh-aaa' "$q" || { echo "smoke-test: FAIL (aaa×bbb should be [x] after apply)"; exit 1; }
  grep -q '^\[~\] CONNECTION (auto novelty): fuse mesh-ccc' "$q" || { echo "smoke-test: FAIL (ccc×ddd sibling collapsed/lost — exact-line flip broken)"; exit 1; }
  grep -qx '\[x\] \[~\].*' "$q" && { echo "smoke-test: FAIL (marker mangled to '[x] [~]')"; exit 1; }
  [ "$(grep -c '^\[x\]' "$q")" = 3 ] || { echo "smoke-test: FAIL (expected exactly 3 [x] after apply, got $(grep -c '^\[x\]' "$q"))"; exit 1; }
  # ─── tilde-reaper sub-test (REAP_WINDOW=0 → all [~] are "stale"): demote unclaimed-unresolved-
  #     unblocked → [ ]; PARK blocked-on-external (stays [~]); KEEP token-matched live [taking];
  #     NEVER blind-close ([~]→[x]). ───
  rt="$_td/reap"; mkdir -p "$rt/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$rt/.mesh/"
  printf '%s\n' '[~] ZOMBIE: wire mesh-zzz to mesh-www aggregator (field: fusion)'   > "$rt/.mesh/ideas-queue"
  printf '%s\n' '[~] PHONE-INTEGRATION: deploy phone-setup (BLOCKED: phone offline)' >> "$rt/.mesh/ideas-queue"
  printf '%s\n' '[~] ACTIVE-CLAIM: build the kelvin telemetry probe (idea: hw)'      >> "$rt/.mesh/ideas-queue"
  printf '%s\n' '2026-06-20T10:00Z x :: [taking] ACTIVE-CLAIM kelvin telemetry probe — on it' > "$rt/.mesh/chat.log"
  HOME="$rt" MESH_REAP_WINDOW=0 bash "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (reaper apply errored)"; exit 1; }
  rq="$rt/.mesh/ideas-queue"
  grep -q '^\[ \] ZOMBIE' "$rq"          || { echo "smoke-test: FAIL (stale unclaimed ZOMBIE must demote [~]→[ ] for re-floor)"; exit 1; }
  grep -q '^\[~\] PHONE-INTEGRATION' "$rq" || { echo "smoke-test: FAIL (blocked-on-external must PARK [~], never demote into a re-block loop)"; exit 1; }
  grep -q '^\[~\] ACTIVE-CLAIM' "$rq"    || { echo "smoke-test: FAIL (idea with a live [taking] must stay [~], not be reaped)"; exit 1; }
  grep -qE '^\[x\]' "$rq"               && { echo "smoke-test: FAIL (reaper must NEVER blind-close [~]→[x])"; exit 1; }
  # conservative-first-run: with the default window + no sidecar, a fresh [~] must NOT demote
  rt2="$_td/reap2"; mkdir -p "$rt2/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$rt2/.mesh/"
  printf '%s\n' '[~] ZOMBIE: wire mesh-zzz to mesh-www aggregator (field: fusion)' > "$rt2/.mesh/ideas-queue"
  : > "$rt2/.mesh/chat.log"
  HOME="$rt2" bash "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (default-window run errored)"; exit 1; }
  grep -q '^\[~\] ZOMBIE' "$rt2/.mesh/ideas-queue" || { echo "smoke-test: FAIL (fresh [~] demoted on first run — not conservative, would mass-reap on deploy)"; exit 1; }
  # ─── semantic second-chance sub-test (queue-tend/semantic-keep): a stale [~] resolved by a
  #     PARAPHRASE [done] shares <2 distinctive tokens → the LEXICAL reaper would demote it, but the
  #     mesh-embed semantic pass must KEEP it; an UNRELATED stale [~] with no resolver must still
  #     demote (the negative twin proves it isn't a free pass). REAL-READ gate: requires the embed
  #     organ — exit 2 (n/a) where absent, like mesh-embed's own --test, so mesh-land passes on a
  #     model-less node without blocking, but the paraphrase-KEEP is asserted for REAL where present. ───
  rts="$_td/reapsem"; mkdir -p "$rts/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$rts/.mesh/"
  # TIDYUP idea and its resolving [done] share ZERO >3-char distinctive tokens (schedule/recurring/
  # delete/stale/scratch/files vs created/periodic/background/cleanup/erases/leftover/cache) — cos
  # 0.556 > SEM_MIN 0.45, mesh-noise ceiling ~0.17 (measured all-minilm). SEMGONE has no resolver.
  printf '%s\n' '[~] TIDYUP: schedule a recurring job to delete stale scratch files (field: housekeeping)' > "$rts/.mesh/ideas-queue"
  printf '%s\n' '[~] SEMGONE: calibrate the barometric altitude drift correction (field: sensors)'        >> "$rts/.mesh/ideas-queue"
  printf '%s\n' '2026-06-20T10:00Z x :: [done] created a periodic background cleanup that erases leftover cache directories' > "$rts/.mesh/chat.log"
  if mesh-embed --which >/dev/null 2>&1; then
    # confirm the fixture pair truly EVADES the lexical path (else the semantic assertion is vacuous)
    _stopf="$rts/.mesh/.queue-tend-stopwords"
    _itok="$(echo 'TIDYUP: schedule a recurring job to delete stale scratch files' | tr -cs '[:alnum:]' '\n' | awk 'length>3' | tr 'A-Z' 'a-z' | grep -viFf "$_stopf" 2>/dev/null | sort -u)"
    _ov=0; for t in $_itok; do echo 'created a periodic background cleanup that erases leftover cache directories' | grep -Fiq "$t" && _ov=$((_ov+1)); done
    [ "$_ov" -lt 2 ] || { echo "smoke-test: FAIL (semantic fixture not lexically-disjoint: $_ov shared tokens — test would pass on the lexical path)"; exit 1; }
    HOME="$rts" MESH_REAP_WINDOW=0 bash "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (semantic reaper apply errored)"; exit 1; }
    grep -q '^\[~\] TIDYUP' "$rts/.mesh/ideas-queue" || { echo "smoke-test: FAIL (paraphrase-resolved [~] DEMOTED — semantic second-chance not keeping it; lexical-only regression)"; exit 1; }
    grep -q '^\[ \] SEMGONE' "$rts/.mesh/ideas-queue" || { echo "smoke-test: FAIL (unrelated stale [~] must still demote — semantic pass must not false-KEEP everything)"; exit 1; }
    # prove the KEEP is the SEMANTIC decision, not a free pass: re-run with the threshold set
    # UNREACHABLE (cos can't exceed 1) — same organ, same fixture, but now TIDYUP MUST demote.
    printf '%s\n' '[~] TIDYUP: schedule a recurring job to delete stale scratch files (field: housekeeping)' > "$rts/.mesh/ideas-queue"
    HOME="$rts" MESH_REAP_WINDOW=0 MESH_QUEUE_SEMANTIC_MIN=1.1 bash "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (unreachable-threshold reaper errored)"; exit 1; }
    grep -q '^\[ \] TIDYUP' "$rts/.mesh/ideas-queue" || { echo "smoke-test: FAIL (with SEM_MIN unreachable the paraphrase [~] must DEMOTE — proves the KEEP came from cos≥SEM_MIN, not a free pass)"; exit 1; }
    echo "  ok: semantic second-chance KEEPs a paraphrase-resolved [~] (cos≥$SEM_MIN) + DEMOTES it (threshold unreachable) + demotes an unrelated stale [~]"
  else
    echo "  n/a: mesh-embed organ absent — semantic second-chance is lexical-only here (honest degrade, mesh-land passes)"
  fi
  # ─── trace-resolved dead-end sub-test (genpair-deadend-to-trace): a gen-pair dead-end recorded ONCE
  #     in traces.log — NOT a board [idle] — must still resolve its CONNECTION idea [~]→[x]. The
  #     negative twin proves the match is keyed on the trace, not a free pass. FALSIFIABLE: drop
  #     traces.log from NOV_LINES (:81) or the 'gen-pair' filter widening (:90) and the positive FAILs. ───
  tt="$_td/trace"; mkdir -p "$tt/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$tt/.mesh/"
  printf '%s\n' '[~] CONNECTION (auto novelty): fuse mesh-eee (x) × mesh-fff (y). What NEW sense emerges?' > "$tt/.mesh/ideas-queue"
  : > "$tt/.mesh/chat.log"
  printf '%s\n' '2026-06-25T09:00Z node :: gen-pair-deadend mesh-eee×mesh-fff: overlap already covered, discard' > "$tt/.mesh/traces.log"
  # NOTE: --list exits 1 when stayed=0 (its last line is `[ stayed -gt 0 ] && …`) — harmless, so
  # assert on the OUTPUT, not the rc (this single-idea case flips → stayed=0).
  tout="$(HOME="$tt" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$tout" | grep -qE '→ \[x\].*eee' || { echo "smoke-test: FAIL (CONNECTION eee×fff must resolve [~]→[x] from a traces.log gen-pair-deadend line, not a board [idle]; got: $tout)"; exit 1; }
  tn="$_td/tracenone"; mkdir -p "$tn/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$tn/.mesh/"
  printf '%s\n' '[~] CONNECTION (auto novelty): fuse mesh-eee (x) × mesh-fff (y). What NEW sense emerges?' > "$tn/.mesh/ideas-queue"
  : > "$tn/.mesh/chat.log"; : > "$tn/.mesh/traces.log"
  tnout="$(HOME="$tn" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$tnout" | grep -qE '→ \[x\].*eee' && { echo "smoke-test: FAIL (eee×fff resolved with NO trace line — false positive, matcher not actually keyed on the trace)"; exit 1; }
  # ─── NEVER-CLAIMED sub-test (open-idea-trace-resolve): a mind can trace a gen-pair-deadend for a
  #     CONNECTION idea BEFORE mesh-generate ever pops it into [~] (discover mind self-picks straight
  #     off the queue) — the [~]-only scan is blind to a still-[ ] idea, so a traced dead-end sat [ ]
  #     forever with no automated close (verified live 2026-07-22: mesh-tg-typing×mesh-say). Must
  #     still resolve [ ]→[x] from the SAME trace convention, with the SAME negative twin. FALSIFIABLE:
  #     revert the open_ideas pass or the extract_cat bracket-generalization → this FAILs.
  ot="$_td/opentrace"; mkdir -p "$ot/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$ot/.mesh/"
  printf '%s\n' '[ ] CONNECTION (auto novelty): fuse mesh-ggg (x) × mesh-hhh (y). What NEW sense emerges?' > "$ot/.mesh/ideas-queue"
  : > "$ot/.mesh/chat.log"
  printf '%s\n' '2026-06-25T09:00Z node :: gen-pair-deadend mesh-ggg×mesh-hhh: overlap already covered, discard' > "$ot/.mesh/traces.log"
  otout="$(HOME="$ot" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$otout" | grep -qE '\[ \]→\[x\].*ggg' || { echo "smoke-test: FAIL (never-claimed [ ] CONNECTION ggg×hhh must resolve [ ]→[x] from a traces.log gen-pair-deadend line; got: $otout)"; exit 1; }
  HOME="$ot" bash "$0" >/dev/null 2>&1
  grep -q '^\[x\].*ggg' "$ot/.mesh/ideas-queue" || { echo "smoke-test: FAIL (open-idea flip did not persist to ideas-queue on a real, non---list apply)"; exit 1; }
  otn="$_td/opentracenone"; mkdir -p "$otn/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$otn/.mesh/"
  printf '%s\n' '[ ] CONNECTION (auto novelty): fuse mesh-ggg (x) × mesh-hhh (y). What NEW sense emerges?' > "$otn/.mesh/ideas-queue"
  : > "$otn/.mesh/chat.log"; : > "$otn/.mesh/traces.log"
  otnout="$(HOME="$otn" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$otnout" | grep -qE '\[x\].*ggg' && { echo "smoke-test: FAIL (ggg×hhh flipped with NO trace line — false positive on the never-claimed path)"; exit 1; }
  grep -q '^\[ \].*ggg' "$otn/.mesh/ideas-queue" || { echo "smoke-test: FAIL (untraced [ ] idea must be left exactly as-is)"; exit 1; }
  echo "  ok: never-claimed [ ] CONNECTION idea resolves [ ]→[x] from a gen-pair-deadend trace (and stays [ ] with no trace)"
  # ─── CO-OSCILLATION trace-resolve sub-test: a "(auto, real data)" idea names two SIGNALS (not
  #     mesh- tools); a gen-pair-deadend trace naming both must flip it [~]→[x]. Negative twin: no
  #     trace → stays. FALSIFIABLE: revert the :225 gate widening OR the CO-OSCILLATION branch → +FAILs. ───
  co="$_td/coosc"; mkdir -p "$co/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$co/.mesh/"
  printf '%s\n' '[~] CO-OSCILLATION (auto, real data): LE-Bose Revolve SoundLink and wifi N7 fluctuate in anti-phase (r=-0.75, 23 Δ-steps) — same zone or coincidence?' > "$co/.mesh/ideas-queue"
  : > "$co/.mesh/chat.log"
  printf '%s\n' '2026-06-25T11:46Z node :: gen-pair-deadend mesh-presence(LE-Bose Revolve SoundLink) × mesh-wifiscan(N7): confound, neither can co-move, discard' > "$co/.mesh/traces.log"
  coout="$(HOME="$co" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$coout" | grep -qE 'CO-OSCILLATION.*→ \[x\] +resolved' || { echo "smoke-test: FAIL (CO-OSCILLATION must resolve [~]→[x] from a gen-pair-deadend trace naming both signals; got: $coout)"; exit 1; }
  con="$_td/cooscnone"; mkdir -p "$con/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$con/.mesh/"
  printf '%s\n' '[~] CO-OSCILLATION (auto, real data): LE-Bose Revolve SoundLink and wifi N7 fluctuate in anti-phase (r=-0.75, 23 Δ-steps) — same zone or coincidence?' > "$con/.mesh/ideas-queue"
  : > "$con/.mesh/chat.log"; : > "$con/.mesh/traces.log"
  conout="$(HOME="$con" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$conout" | grep -qE 'CO-OSCILLATION.*→ \[x\]' && { echo "smoke-test: FAIL (CO-OSCILLATION resolved with NO trace — false positive, matcher not keyed on the trace)"; exit 1; }
  # both-sides guard: a trace naming only ONE signal (+ incidental tokens) must NOT resolve the idea.
  co1="$_td/coosc1"; mkdir -p "$co1/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$co1/.mesh/"
  printf '%s\n' '[~] CO-OSCILLATION (auto, real data): LE-Bose Revolve SoundLink and wifi N7 fluctuate in anti-phase (r=-0.75, 23 Δ-steps) — same zone or coincidence?' > "$co1/.mesh/ideas-queue"
  : > "$co1/.mesh/chat.log"
  printf '%s\n' '2026-06-25T11:46Z node :: gen-pair-deadend mesh-arrivals × mesh-stress: SoundLink orthogonal domains, discard' > "$co1/.mesh/traces.log"
  co1out="$(HOME="$co1" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$co1out" | grep -qE 'CO-OSCILLATION.*→ \[x\]' && { echo "smoke-test: FAIL (CO-OSCILLATION false-closed by a trace naming only ONE signal — both-sides guard broken)"; exit 1; }
  # distinctive-anchor guard: a 2-3 char pure-digit/pure-alpha fragment ("24","Wi") must NOT anchor —
  # the per-side hit needs a DISTINCTIVE token, else incidental numbers/word-fragments false-close.
  co2="$_td/coosc2"; mkdir -p "$co2/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$co2/.mesh/"
  printf '%s\n' '[~] CO-OSCILLATION (auto, real data): Gizmo 24 and wifi N7 fluctuate in sync (r=0.7, 9 Δ-steps) — same zone?' > "$co2/.mesh/ideas-queue"
  printf '%s\n' '2026-06-20T10:00Z node :: [done] CO-OSCILLATION zonemap note: saw 24 blips on N7 channel today' > "$co2/.mesh/chat.log"
  : > "$co2/.mesh/traces.log"
  co2out="$(HOME="$co2" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$co2out" | grep -qE 'CO-OSCILLATION.*→ \[x\]' && { echo "smoke-test: FAIL (pure-digit '24' fragment anchored a match — distinctive-anchor guard broken; 'Gizmo' absent must keep it [~])"; exit 1; }
  # ─── CONNECTION (data-seeded) trace-resolve sub-test: names raw sense identifiers (mesh-ideate's
  #     "shows the A sense and the B sense are empirically coupled" template), NOT mesh- tools — the
  #     generic CONNECTION mesh-token matcher always finds <2 tokens here, so without the data-seeded
  #     fallback these ideas can never auto-resolve (verified live 2026-07-22, DV8235×Bose). FALSIFIABLE:
  #     revert the data-seeded fallback in the CONNECTION branch → this FAILs. ───
  ds="$_td/dataseeded"; mkdir -p "$ds/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$ds/.mesh/"
  printf '%s\n' '[~] CONNECTION (data-seeded): the sensor tape shows the DV8235 sense and the LE-Bose Revolve SoundLink sense are empirically coupled (coosc: r=0.65, 13 Δ-steps over 48.0h of sensor scans, p_corr=0.041 over 3 pairs tested) — NOT a random pairing, the DATA flagged it. What mechanism links them?' > "$ds/.mesh/ideas-queue"
  : > "$ds/.mesh/chat.log"
  printf '%s\n' '2026-07-21T08:28:49Z discover@node :: gen-pair-deadend mesh-presence(DV8235)×mesh-presence(LE-Bose Revolve SoundLink): scanner-side common-mode, both stationary appliances, discard' > "$ds/.mesh/traces.log"
  dsout="$(HOME="$ds" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$dsout" | grep -qE 'CONNECTION.*→ \[x\] +resolved' || { echo "smoke-test: FAIL (CONNECTION data-seeded must resolve [~]→[x] from a gen-pair-deadend trace naming both signals; got: $dsout)"; exit 1; }
  dsn="$_td/dataseedednone"; mkdir -p "$dsn/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$dsn/.mesh/"
  printf '%s\n' '[~] CONNECTION (data-seeded): the sensor tape shows the DV8235 sense and the LE-Bose Revolve SoundLink sense are empirically coupled (coosc: r=0.65, 13 Δ-steps over 48.0h of sensor scans, p_corr=0.041 over 3 pairs tested) — NOT a random pairing, the DATA flagged it. What mechanism links them?' > "$dsn/.mesh/ideas-queue"
  : > "$dsn/.mesh/chat.log"; : > "$dsn/.mesh/traces.log"
  dsnout="$(HOME="$dsn" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$dsnout" | grep -qE 'CONNECTION.*→ \[x\]' && { echo "smoke-test: FAIL (CONNECTION data-seeded resolved with NO trace — false positive, matcher not keyed on the trace)"; exit 1; }
  # both-sides guard: a trace naming only ONE signal must NOT resolve the idea.
  ds1="$_td/dataseeded1"; mkdir -p "$ds1/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$ds1/.mesh/"
  printf '%s\n' '[~] CONNECTION (data-seeded): the sensor tape shows the DV8235 sense and the LE-Bose Revolve SoundLink sense are empirically coupled (coosc: r=0.65, 13 Δ-steps over 48.0h of sensor scans, p_corr=0.041 over 3 pairs tested) — NOT a random pairing, the DATA flagged it. What mechanism links them?' > "$ds1/.mesh/ideas-queue"
  : > "$ds1/.mesh/chat.log"
  printf '%s\n' '2026-07-21T08:28:49Z discover@node :: gen-pair-deadend mesh-arrivals×mesh-stress: DV8235 orthogonal domains, discard' > "$ds1/.mesh/traces.log"
  ds1out="$(HOME="$ds1" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$ds1out" | grep -qE 'CONNECTION.*→ \[x\]' && { echo "smoke-test: FAIL (CONNECTION data-seeded false-closed by a trace naming only ONE signal — both-sides guard broken)"; exit 1; }
  echo "  ok: CONNECTION (data-seeded) idea resolves [~]→[x] from a gen-pair-deadend trace naming both raw sense identifiers (and stays [~] with no/one-sided trace)"
  # ─── STUDY-kind dead-end sub-test (study-kind-deadend-never-reconciles): a STUDY(<slug>) idea
  #     resolved ONLY via a traces.log study-deadend line (the genome off-board convention, no
  #     [done]/[idle]) must still flip [~]→[x]. Negative twin: no trace → stays. Positive-via-[done]
  #     twin: an ordinary [done] citing the slug must also flip (the old generic matcher never fired
  #     since STUDY ideas don't literally say "auto novelty"). FALSIFIABLE: revert the routing OR() at
  #     the "STUDY(" idea-kind gate, the kind-derivation branch, or the study-deadend NOV_LINES/kind
  #     branch → these FAIL. ───
  st="$_td/study"; mkdir -p "$st/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$st/.mesh/"
  printf '%s\n' "[~] STUDY(timeseries-anomaly): Implement online One-Class SVM anomaly detection using ADTK in the tmux board logging worker. — try it in OUR codebase (small, no operator action), leave changes in the tree. (source: study 'timeseries-anomaly' brief 2026-06-27T21:23:01Z)" > "$st/.mesh/ideas-queue"
  : > "$st/.mesh/chat.log"
  printf '%s\n' '2026-06-28T02:56:19Z genome@node :: study-deadend timeseries-anomaly/oneclass-svm-adtk-on-board: adtk+sklearn+pandas all ABSENT, mined-theory churn not novel capability' > "$st/.mesh/traces.log"
  stout="$(HOME="$st" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$stout" | grep -qE 'STUDY.*→ \[x\]' || { echo "smoke-test: FAIL (STUDY(timeseries-anomaly) must resolve [~]→[x] from a traces.log study-deadend line; got: $stout)"; exit 1; }
  stn="$_td/studynone"; mkdir -p "$stn/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$stn/.mesh/"
  printf '%s\n' "[~] STUDY(timeseries-anomaly): Implement online One-Class SVM anomaly detection using ADTK in the tmux board logging worker. — try it in OUR codebase (small, no operator action), leave changes in the tree. (source: study 'timeseries-anomaly' brief 2026-06-27T21:23:01Z)" > "$stn/.mesh/ideas-queue"
  : > "$stn/.mesh/chat.log"; : > "$stn/.mesh/traces.log"
  stnout="$(HOME="$stn" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$stnout" | grep -qE 'STUDY.*→ \[x\]' && { echo "smoke-test: FAIL (STUDY resolved with NO trace/done — false positive, matcher not keyed on the slug)"; exit 1; }
  std="$_td/studydone"; mkdir -p "$std/.mesh"; cp "$_td/.mesh/.queue-tend-stopwords" "$std/.mesh/"
  printf '%s\n' '[~] STUDY(byzantine-consensus): simulate a lost-node failure. (source: study by-zantine-consensus brief)' > "$std/.mesh/ideas-queue"
  printf '%s\n' '2026-06-20T10:00Z node :: [done] STUDY(byzantine-consensus): shipped scripts/mesh-chaos --kill-node fixture, commit a1b2c3d' > "$std/.mesh/chat.log"
  : > "$std/.mesh/traces.log"
  stdout="$(HOME="$std" bash "$0" --list 2>/dev/null)"
  printf '%s\n' "$stdout" | grep -qE 'STUDY.*→ \[x\]' || { echo "smoke-test: FAIL (STUDY(byzantine-consensus) must also resolve via an ordinary [done] citing the slug; got: $stdout)"; exit 1; }
  echo "smoke-test: ok (3 flip novelty + reaper: demote/park/keep + NEVER blind-close + conservative-first-run + trace-resolved dead-end ± + CO-OSCILLATION trace-resolve ± + CONNECTION-data-seeded trace-resolve ± + STUDY dead-end/done trace-resolve ±)"; exit 0
}

# Ensure stopwords file exists (3+ chars only, to avoid substring false positives)
[ -f "$STOPF" ] || awk 'length>2' << 'SW' > "$STOPF"
a an the for and or of in on to is it by with when that this which build make add fix prove verify check wrap compare flag feed report list find enumerate audit each node nodes every via new also one two how what why where then than not but if so do no yes up down all any may can must shall will now here there into onto over under out off back before after during while between through across around about above below left right top bottom front inside outside near far same other another such just only even still already yet ever never always sometimes often rarely usually perhaps maybe probably certainly definitely possibly likely unlikely
SW

# Serialize against mesh-generate's queue writes (append / [ ]->[~] flip): both flock the SAME
# lockfile so neither's rewrite lose-updates the other (read->rewrite->mv race). Real/--list path
# only — --test returned above. Best-effort: proceed unlocked if flock is missing. Held until exit.
# NOTE: do NOT append `2>/dev/null` here — `exec <redir>` with no command applies the redirect
# PERMANENTLY to the shell, so `exec 9>lock 2>/dev/null` silences stderr for the WHOLE rest of the
# run. That masked the set-u unbound-variable crash in the apply block for who-knows-how-long
# (queue reconciliation silently dead, no error surfaced). A failed lock-open is rare and worth
# seeing; `|| true` keeps it non-fatal without blinding the script.
exec 9>"$MESH/.ideas-queue.lock" || true
flock -w 30 9 2>/dev/null || true

dones="$(grep '\[done\]' "$CHAT" 2>/dev/null)"
ideas=(); while IFS= read -r l; do ideas+=("$l"); done < <(grep '^\[~\]' "$Q" 2>/dev/null)

echo "=== mesh-queue-tend @ $(ts) ==="
echo "ideas: ${#ideas[@]} [~]  |  board: $(echo "$dones" | wc -l) [done]"
echo ""

# Arrays MUST be initialized empty-but-SET (=()): under `set -u`, ${#arr[@]} on a bare
# `declare -a arr` that was never assigned throws "unbound variable" (bash 5.2) — which crashed
# the apply-block guard below before the awk ran whenever there were flips but no demotes (the
# normal case), silently killing every queue reconciliation. (=() makes the array "set".)
flipped=0; stayed=0; declare -a stayed_list=(); declare -a flip_lines=()

for idea in "${ideas[@]}"; do
  cat="$(extract_cat "$idea")"

  # Auto-novelty ideas: route to the specific-content matcher (handles [done] AND [idle] discards).
  # STUDY(...) ideas route here too — same off-board dead-end convention (study-deadend trace),
  # even though the idea text itself carries no "auto novelty"/"auto, real data" marker.
  if echo "$idea" | grep -qiE 'auto novelty|auto, real data|data-seeded' || echo "$idea" | grep -qE 'STUDY\('; then
    MATCH_SUMMARY=""
    if echo "$cat" | grep -qE '^STUDY\('; then kind="STUDY"; else kind="$(echo "$cat" | awk '{print toupper($1)}')"; fi
    if novelty_match "$idea" "$kind"; then
      echo "  ✓ [$cat] → [x]  resolved: $MATCH_SUMMARY"
      flipped=$((flipped+1)); flip_lines+=("$idea"); note_teachback "$cat" "$MATCH_SUMMARY"
    else
      stayed=$((stayed+1)); stayed_list+=("[$cat] ${idea:0:90}")
    fi
    continue
  fi

  cat_lower="$(echo "$cat" | tr '[:upper:]' '[:lower:]')"
  words="$(extract_words "$idea")"
  [ -z "$words" ] && { stayed=$((stayed+1)); stayed_list+=("[$cat] ${idea:0:90}"); continue; }
  
  # Fast: find done lines containing category
  cands="$(echo "$dones" | grep -Fi "$cat_lower" 2>/dev/null)"
  [ -z "$cands" ] && { stayed=$((stayed+1)); stayed_list+=("[$cat] ${idea:0:90}"); continue; }
  
  # Check word matches — require 2+ for single-word categories (prevent false positives)
  cat_words=$(echo "$cat" | wc -w)
  min_hits=1
  [ "$cat_words" -le 1 ] && min_hits=2
  matched=0; match_summary=""
  while IFS= read -r c; do
    [ -z "$c" ] && continue
    hits=0
    for w in $words; do echo "$c" | grep -Fiq "$w" && hits=$((hits+1)); done
    [ "$hits" -ge "$min_hits" ] && { matched=1; match_summary="$(echo "$c" | sed -E 's/.*\[done\][[:space:]]*//' | head -c 100)"; break; }
  done <<< "$cands"
  
  if [ "$matched" = "1" ]; then
    echo "  ✓ [$cat] → [x]  done: $match_summary"
    flipped=$((flipped+1)); flip_lines+=("$idea"); note_teachback "$cat" "$match_summary"
  else
    stayed=$((stayed+1)); stayed_list+=("[$cat] ${idea:0:90}")
  fi
done

# ─── open ([ ]) auto-novelty/STUDY ideas: a discover mind can self-pick a CONNECTION/STUDY idea
#     straight off the queue and trace a dead-end BEFORE mesh-generate ever pops it into [~] (the
#     discover mission explicitly invites self-picking, not only fed ideas) — the [~]-only scan
#     above is BLIND to a still-[ ] idea, so a traced dead-end sits [ ] forever: mesh-generate can
#     re-pop the SAME already-resolved pair later and re-dispatch it as if new. Verified live
#     2026-07-22: mesh-tg-typing×mesh-say was traced gen-pair-deadend at 13:08:10Z while still [ ],
#     invisible to this reconcile, closed only by a mind's manual line-edit. Mirror the same
#     high-precision novelty_match pass (BOTH fused tool names, or an explicit gen-pair/study-deadend
#     marker, in ONE resolution line) over [ ] lines too, flipping straight [ ]→[x] — no [~] hop.
open_ideas=(); while IFS= read -r l; do open_ideas+=("$l"); done < <(grep '^\[ \]' "$Q" 2>/dev/null)
open_flipped=0; declare -a open_flip_lines=()
for idea in "${open_ideas[@]}"; do
  cat="$(extract_cat "$idea")"
  if echo "$idea" | grep -qiE 'auto novelty|auto, real data|data-seeded' || echo "$idea" | grep -qE 'STUDY\('; then
    MATCH_SUMMARY=""
    if echo "$cat" | grep -qE '^STUDY\('; then kind="STUDY"; else kind="$(echo "$cat" | awk '{print toupper($1)}')"; fi
    if novelty_match "$idea" "$kind"; then
      echo "  ✓ [$cat] [ ]→[x]  trace-resolved (never claimed): $MATCH_SUMMARY"
      open_flipped=$((open_flipped+1)); open_flip_lines+=("$idea")
    fi
  fi
done

# ─── tilde-reaper: over the ideas the resolve pass did NOT flip (stayed = no [done] match),
#     demote the genuinely-stale-unclaimed-unresolved [~]→[ ]; park blocked-on-external; keep fresh
#     and token-matched-resolved/claimed. ────────────────────────────────────────────────────────
now=$(date +%s)
# semantic organ probe (ONCE): mesh-embed --which exits 0 with a model name iff the embed organ is
# live here; any exit 2 (ollama down / no model) → EMBED_OK stays 0 → reaper is lexical-only, honest.
command -v mesh-embed >/dev/null 2>&1 && mesh-embed --which >/dev/null 2>&1 && EMBED_OK=1
takings="$(grep '\[taking\]' "$CHAT" 2>/dev/null | tail -500)"
idle_done="$dones
$(grep '\[idle\]' "$CHAT" 2>/dev/null | tail -500)
$(grep -i 'gen-pair-deadend' "$TRACES" 2>/dev/null | tail -500)"
declare -a demote_lines=(); reaped=0; parked=0; fresh=0   # =() — set-u-safe (see flip_lines note above)
declare -A seen_at=() seen_now=()
[ -f "$SEEN" ] && while read -r k e; do [ -n "$k" ] && seen_at["$k"]="$e"; done < "$SEEN"
# stayed_ideas = the full [~] lines NOT marked for flip
declare -A is_flip=(); for f in "${flip_lines[@]:-}"; do [ -n "$f" ] && is_flip["$f"]=1; done
for idea in "${ideas[@]}"; do
  [ -n "${is_flip[$idea]:-}" ] && continue
  key="$(idea_key "$idea")"; first="${seen_at[$key]:-$now}"; seen_now["$key"]="$first"
  age=$(( now - first ))
  if [ "$age" -lt "$REAP_WINDOW" ]; then fresh=$((fresh+1)); continue; fi
  if echo "$idea" | grep -qE "$BLOCKED_RE"; then
    parked=$((parked+1)); echo "  ⏸ [$(extract_cat "$idea")] PARK: blocked-on-external (stays [~], not re-floored)"; continue
  fi
  toks="$(distinct_tokens "$idea")"
  if [ -n "$toks" ] && { tokens_overlap "$toks" "$idle_done" 2 || tokens_overlap "$toks" "$takings" 2; }; then
    parked=$((parked+1)); echo "  ⏸ [$(extract_cat "$idea")] KEEP: token-matched a [done]/[idle]/[taking] (resolved or claimed — no blind demote)"; continue
  fi
  # SECOND-CHANCE (semantic): lexical missed, but a paraphrased [done]/[idle]/[taking] may still have
  # resolved/claimed this idea. Only PREVENTS a demote (fail-safe); skipped entirely when EMBED_OK=0.
  if semantic_overlap "$idea" "$idle_done" || semantic_overlap "$idea" "$takings"; then
    parked=$((parked+1))
    echo "  ⏸ [$(extract_cat "$idea")] KEEP: semantic-matched a [done]/[idle]/[taking] (paraphrase lexical missed — no blind demote)"
    echo "$(ts) SEMANTIC-KEEP [$(extract_cat "$idea")] — cos≥$SEM_MIN to a resolved/claimed line the token-overlap missed: ${idea:0:70}" >> "$LOG" 2>/dev/null || true
    continue
  fi
  demote_lines+=("$idea"); reaped=$((reaped+1))
  echo "  ⇊ [$(extract_cat "$idea")] → [ ]  reaped: stale $((age/3600))h, no live [taking], unresolved → re-floored"
done
# Persist the sidecar (current [~] keys only → prune resolved/demoted) — skip in --list (keep dry-run pure)
if [ "${1:-}" != "--list" ]; then
  : > "$SEEN.tmp" 2>/dev/null && { for k in "${!seen_now[@]}"; do printf '%s %s\n' "$k" "${seen_now[$k]}"; done >> "$SEEN.tmp"; mv "$SEEN.tmp" "$SEEN" 2>/dev/null || true; }
fi

# Apply flips ([~]→[x]) AND demotes ([~]→[ ]) by EXACT full-line match (never by category prefix —
# that collapses sibling ideas sharing a "CONNECTION (auto novelty)" header). Single atomic rewrite.
if [ "${1:-}" != "--list" ] && { [ "${#flip_lines[@]}" -gt 0 ] || [ "${#demote_lines[@]}" -gt 0 ] || [ "${#open_flip_lines[@]}" -gt 0 ]; }; then
  _ff="$(mktemp)"; _df="$(mktemp)"; _of="$(mktemp)"
  [ "${#flip_lines[@]}" -gt 0 ]      && printf '%s\n' "${flip_lines[@]}"      > "$_ff"
  [ "${#demote_lines[@]}" -gt 0 ]    && printf '%s\n' "${demote_lines[@]}"    > "$_df"
  [ "${#open_flip_lines[@]}" -gt 0 ] && printf '%s\n' "${open_flip_lines[@]}" > "$_of"
  awk -v ff="$_ff" -v df="$_df" -v of="$_of" '
    BEGIN { while ((getline l < ff) > 0) flip[l]=1; while ((getline d < df) > 0) demote[d]=1; while ((getline o < of) > 0) openflip[o]=1 }
    { if ($0 in flip) sub(/^\[~\]/, "[x]"); else if ($0 in demote) sub(/^\[~\]/, "[ ]"); else if ($0 in openflip) sub(/^\[ \]/, "[x]"); print }
  ' "$Q" > "$Q.tmp" && mv "$Q.tmp" "$Q"
  rm -f "$_ff" "$_df" "$_of"
fi

echo ""; echo "=== $flipped flipped + $stayed stayed = ${#ideas[@]} total ==="
[ "$open_flipped" -gt 0 ] && echo "=== $open_flipped never-claimed [ ]→[x] auto-resolved (traced dead-end, no manual edit needed) ==="
echo "=== reaper: $reaped reaped→[ ]  +  $parked parked/kept  +  $fresh fresh (window ${REAP_WINDOW}s) ==="
[ "$rote_flips" -gt 0 ] && echo "=== teachback: $rote_flips of $flipped flip(s) closed on a ROTE [done] (no concrete cite — understanding not demonstrated; see $LOG) ==="
[ "${1:-}" = "--list" ] && echo "(dry-run)"
[ "$stayed" -gt 0 ] && { echo ""; echo "── stayed ──"; printf '  %s\n' "${stayed_list[@]}"; }
