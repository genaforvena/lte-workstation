#!/usr/bin/env python3
"""mesh-model-bench — measure one candidate model against one fixture. One row of truth.

TWO AXES, BOTH MANDATORY. Speed alone selects the fastest wrong answer: whisper
ggml-tiny does this fixture in 0.8s and returns a DIFFERENT SENTENCE (2026-07-15,
room's bench). A bench that ranks on wall-clock is a bench that would have made the
room deaf to the very ask that commissioned it.

WALL-CLOCK AT A REAL DURATION, NEVER RTF. RTF measured on a short clip is
load-dominated: the ~11s whisper model load dwarfs inference, so a 3.36s clip
extrapolated to "60s note -> 795s" when the real number is 27.9s. 28x wrong. The
tell was that the 3.36s clip took LONGER than the 18s one. Fixtures here are 18s.

STDLIB ONLY. System python3 on this node has no numpy. WER is hand-rolled.
"""
import os
import re
import sys
import time
import tempfile
import subprocess
from pathlib import Path

import signal
# SIGTERM MUST UNWIND, or every `finally` in this file is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks (and without
# TemporaryDirectory.__exit__), so a correct-looking cleanup never runs. The signal is not
# hypothetical: GNU `timeout` — which wraps this tool at its call sites and wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire — puts its child in its OWN process group and
# signals the GROUP, so this process gets the TERM. sys.exit() from the handler raises SystemExit in
# the main thread, which is what actually unwinds. SIGKILL stays uncatchable; that half is
# mesh-tmp-guard's sweep. Pattern and the measured mechanism: eb5b8e7, scripts/mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

HOME = Path.home()
MESH = HOME / ".mesh"
FIXTURES = MESH / "model-fixtures"
LEDGER = MESH / "model-bench.log"

# Normalise before scoring: CTC models (gigaam) emit lowercase, unpunctuated text by
# design. Scoring raw against a punctuated reference charges them a penalty for a
# formatting choice and hands the win to whisper on an artifact. Case + punctuation
# are not accuracy.
_PUNCT = re.compile(r"[^\w\s]", re.UNICODE)
_WS = re.compile(r"\s+", re.UNICODE)


def normalise(s):
    s = s.lower().replace("ё", "е")
    s = _PUNCT.sub(" ", s)
    return [w for w in _WS.sub(" ", s).strip().split(" ") if w]


def wer(ref, hyp):
    """Word error rate: Levenshtein over WORDS / len(ref). 0.0 = perfect, >=1.0 = hopeless."""
    r, h = normalise(ref), normalise(hyp)
    if not r:
        return 0.0 if not h else 1.0
    # full DP row-by-row — fixtures are one sentence, no need to be clever
    prev = list(range(len(h) + 1))
    for i, rw in enumerate(r, 1):
        cur = [i]
        for j, hw in enumerate(h, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (rw != hw)))
        prev = cur
    return prev[len(h)] / len(r)


WHISPER_BIN = MESH / "whispercpp" / "main"
WHISPER_MODELS = MESH / "whispercpp" / "models"
VENV_AI = HOME / ".venv-ai" / "bin" / "python"
PIPER_BIN = HOME / ".venv-ai" / "bin" / "piper"
PIPER_VOICES = HOME / ".local" / "share" / "piper-voices"

# Candidate registry. NOTE the exact filenames: there is NO ggml-large-v3-turbo.bin on
# this node — it is -q5_0. mesh-voice-rx:49's ladder greps for the exact unsuffixed name
# and silently misses it (discover, 2026-07-15 04:47). Name-match fallbacks are invisible.
STT_CANDIDATES = {
    "whisper-tiny": ("whisper", "ggml-tiny.bin"),
    "whisper-base": ("whisper", "ggml-base.bin"),
    "whisper-large-v3-turbo-q5_0": ("whisper", "ggml-large-v3-turbo-q5_0.bin"),
    "gigaam-v2_ctc": ("gigaam", "v2_ctc"),
}

# TTS candidate registry. `organ tts` benches these; each renders the fixture's input.txt.
# THE THREE PIPER VOICES ARE ALL ru_RU-*-MEDIUM — same model, different SPEAKER. Benching them
# against each other is an A/B of speakers, NOT a model tier (piper ru tops out at medium). A real
# model upgrade is a different architecture — silero v4_ru (torch, runs in ~/.venv-ai alongside
# gigaam), added below once its hub cache exists (raises FileNotFoundError -> honest n/a until then).
# The silero ref is "<repo-speaker>:<voice>" — v4_ru is MULTI-speaker; we compare a female voice
# (baya) against irina, a female piper voice, so the A/B is voice-model, not gender.
TTS_CANDIDATES = {
    "piper-irina-medium":  ("piper", "ru_RU-irina-medium.onnx"),
    "piper-ruslan-medium": ("piper", "ru_RU-ruslan-medium.onnx"),
    "piper-dmitri-medium": ("piper", "ru_RU-dmitri-medium.onnx"),
    "silero-v4-ru-baya":   ("silero", "v4_ru:baya"),
}

# WAKE candidate registry: ollama tags the room wake gate (mesh-room-address) could run.
# The ref IS the ollama tag. Benched through the DEPLOYED gate itself (`ROOM_ADDRESS_MODEL=<tag>
# mesh-room-address "<line>"`), never a re-implementation of its prompt/parser — a harness that
# measures a path the live consumer does not run would crown a model the gate cannot use
# (the qwen3.5 lesson: its loss is PARSING, not competence, and the live gate parses).
WAKE_CANDIDATES = {
    "qwen2.5:3b":   ("ollama", "qwen2.5:3b"),
    "qwen3.5:0.8b": ("ollama", "qwen3.5:0.8b"),
    "qwen3.5:2b":   ("ollama", "qwen3.5:2b"),
    "qwen3.5:4b":   ("ollama", "qwen3.5:4b"),
    "granite4.1:3b": ("ollama", "granite4.1:3b"),
    "gemma4:e2b-it-qat": ("ollama", "gemma4:e2b-it-qat"),
}
# COVERAGE candidate registry: ollama tags the mesh-clear CLEAR-GATE could run as its coverage judge
# (does a FRESH handoff cover the work the pane scrollback shows?). The ref IS the ollama tag. Benched
# through mesh-clear's OWN _classify_coverage — prompt, --think=false, timeout and fail-safe parse
# exactly as the live gate pays them — never a re-implementation (a second copy of the parser drifts;
# same rule that makes bench_wake drive mesh-room-address's own wake_value, and the whole reason e2b
# read as a coin was OUR parser eating its Thinking… block, not the model).
#
# CURRENT-GENERATION ONLY (operator 2026-07-18): every candidate is a current family — gemma4, qwen3.5.
# The step-2 "slightly bigger local" fallback is qwen3.5:4b, which is ALREADY PULLED, not the old-gen
# qwen2.5:7b / llama3.1:8b / gemma2:9b (superseded by gemma4/qwen3.5/llama3.2 — benching them is spend on
# a stale conclusion; see memory bench-current-generation-models-only). qwen2.5:3b stays ONLY as the
# incumbent baseline being REPLACED (measured always-NO), never a model to crown.
COVERAGE_CANDIDATES = {
    "gemma4:e2b-it-qat":  ("ollama", "gemma4:e2b-it-qat"),   # PRIMARY — current, thinking-family, --think=false unblocks it
    "qwen3.5:2b":         ("ollama", "qwen3.5:2b"),          # current-gen small alt (already pulled)
    "qwen3.5:4b":         ("ollama", "qwen3.5:4b"),          # step-2 bigger fallback, current-gen (already pulled)
    "qwen2.5:3b":         ("ollama", "qwen2.5:3b"),          # incumbent-being-replaced baseline (measured always-NO); NOT a crown candidate
}
BIN = Path(os.environ.get("MESH_BIN_DIR", HOME / ".local/bin"))


def _run_whisper(model_file, wav):
    """Returns (text, wall_seconds) or raises. Wall-clock INCLUDES model load — that is
    the honest cost of a call on this organ."""
    mp = WHISPER_MODELS / model_file
    if not WHISPER_BIN.exists() or not mp.exists():
        raise FileNotFoundError(f"whisper organ absent: {WHISPER_BIN if not WHISPER_BIN.exists() else mp}")
    t0 = time.monotonic()
    p = subprocess.run([str(WHISPER_BIN), "-m", str(mp), "-l", "ru", "-nt", "-f", str(wav)],
                       capture_output=True, text=True, timeout=600)
    wall = time.monotonic() - t0
    if p.returncode != 0:
        # rc=127 here is the rpath bug's signature: executable and LOADABLE are different
        # claims. Fail loud — an empty transcript must never read as "no speech".
        raise RuntimeError(f"whisper rc={p.returncode}: {p.stderr.strip()[:200]}")
    return p.stdout.strip(), wall


def _run_gigaam(model_id, wav):
    """GigaAM runs in ~/.venv-ai (system python3 has no torch/numpy). .transcribe()
    returns a TranscriptionResult, NOT a str — reading it as a str was fatal and shipped
    undetected because the daemon had never run (3a56a92).

    THE FIELD IS `.text`, NOT `.transcription`. An earlier version of this line read
    `getattr(r,'transcription',None)` — a field that does not exist on
    TranscriptionResult, so it ALWAYS returned None and fell through to `str(r)`, which
    only produced correct text because TranscriptionResult.__str__ happens to return
    self.text. Right output, wrong reason: the day gigaam drops that __str__ (or a
    caller passes a bare str, whose __str__ is the identity but whose *repr* is not),
    this silently writes an object repr into the ledger as a "transcript" — non-empty,
    so read_status stays read-ok and WER is corrupted with no error, no loud failure.
    Match scripts/mesh-room-gigaam's shape: read .text directly, fall back to str(r)
    only for a bare-str result.

    WALL IS MEASURED FROM THE PARENT, ACROSS THE WHOLE SUBPROCESS — load, import, interpreter
    startup and all. It did not used to be, and the ledger lied for it.

    Until 2026-07-15 this timed `t0=monotonic()` INSIDE the child, AFTER load_model(), while
    _run_whisper timed the whole subprocess from out here. Same ledger column, two different
    meanings — and the tools that rank on it read it as one axis. Measured cost of the omission:
    gigaam recorded 0.61s where a per-note caller really pays 4.63s (2.50s load + 0.65s infer +
    ~1.4s interpreter/import). 7.5x, all of it flattering.

    It produced a false headline. On the recorded numbers gigaam (0.61s/0.312) appeared to
    DOMINATE whisper-base (1.07s/0.812) — faster AND more accurate, no tradeoff to argue about.
    Honestly measured it does not: base is 4x FASTER, gigaam 2.6x more accurate, and which one
    you want depends on the consumer. An axis that means different things per row manufactures
    exactly the kind of un-arguable claim nobody re-checks.

    This is the RTF bug's twin (CLAUDE.local.md): a timing that omits a FIXED cost and so
    flatters whatever pays that cost. There, ~11s of whisper load was extrapolated as if it were
    a rate; here, 2.5s of gigaam load was dropped as if it were free. Both times the number was
    plausible, and plausible is what makes it dangerous.

    NB the 0.61s was not fiction — it is what a WARM caller pays, and the room-ear daemon
    (mesh-room-gigaam) genuinely pays it because it holds the model resident. It is simply not
    what a per-call consumer pays. It now has its OWN column: the child times call N+1 on the
    already-loaded model and prints it as a marker line; the parent subtracts that segment out
    of its own total so `wall` keeps meaning exactly what it meant (interpreter + import + load
    + ONE inference — the cold per-call cost). Returns (text, wall_cold, wall_warm). Both are
    real and they differ ~7.6x on this node; which one a consumer pays depends on whether it
    holds the model resident (room-ear does, voice-rx/mesh-ear spawn per call) — that question
    is mesh-model-gap's to ask, per-consumer. Cross-ref [[rtf-on-a-short-clip-is-not-a-rate]]:
    the same fixed cost, counted IN for some callers and OUT for others, which is precisely why
    it needs a NAME and a column rather than a convention."""
    if not VENV_AI.exists():
        raise FileNotFoundError(f"gigaam organ absent: {VENV_AI}")
    code = (
        "import sys,time,gigaam\n"
        f"m=gigaam.load_model({model_id!r})\n"
        f"r=m.transcribe({str(wav)!r})\n"
        # CONTRACT CHECK, NOT AN OUTPUT CHECK. The fallback below is a real safety net, but
        # it is SILENT, and a silent fallback hides a dead primary path: `.transcription`
        # never existed on this class, so that getattr returned None on every call and
        # str(r) rescued it via TranscriptionResult.__str__ -> self.text. The output was
        # always right, so NO output assertion could ever see it. Proven by mutation
        # 2026-07-15: reverting .text -> .transcription leaves the whole --test GREEN.
        # So assert the FIELD exists, loudly, before trusting anything downstream. This is
        # the only gate that catches the primary path dying.
        "if not isinstance(r,str) and not hasattr(r,'text'):\n"
        "    print('CONTRACT: TranscriptionResult has no .text — fields=%r' % (dir(r),), file=sys.stderr)\n"
        "    sys.exit(3)\n"
        "t=getattr(r,'text',None)\n"
        "t=t if t is not None else (r if isinstance(r,str) else str(r))\n"
        # WARM = call N+1 on the ALREADY-LOADED model, timed INSIDE the child. That placement
        # is deliberate and is NOT the 2026-07-15 timer bug coming back: the bug was the COLD
        # column timed in here (omitting the fixed load cost); the warm column's whole meaning
        # IS "the segment after the fixed cost is paid" — what a resident daemon pays per call.
        "t0=time.monotonic()\n"
        f"r2=m.transcribe({str(wav)!r})\n"
        "warm=time.monotonic()-t0\n"
        "print(t, flush=True)\n"
        "print('__WARM_SECONDS__=%.3f' % warm, flush=True)\n"
    )
    t0 = time.monotonic()
    p = subprocess.run([str(VENV_AI), "-c", code], capture_output=True, text=True, timeout=600)
    total = time.monotonic() - t0
    if p.returncode != 0:
        raise RuntimeError(f"gigaam rc={p.returncode}: {p.stderr.strip()[:200]}")
    warm, text_lines = None, []
    for ln in p.stdout.strip().splitlines():
        if ln.startswith("__WARM_SECONDS__="):
            warm = float(ln.split("=", 1)[1])
        else:
            text_lines.append(ln)
    if warm is None:
        # rc=0 with no marker means the child never timed call N+1 — a code bug, never a quiet
        # "-" (a silent None here would age into an unmeasured-looking column on a measured run).
        raise RuntimeError("gigaam warm marker missing — child did not time call N+1")
    # cold = total minus exactly the timed second call, so `wall` still means
    # interpreter + import + load + ONE inference — the honest cold per-call cost.
    return "\n".join(text_lines).strip(), total - warm, warm


def _run_piper(voice_file, text, out_wav):
    """Render `text` -> out_wav via piper. Returns wall_seconds, PARENT-TIMED across the whole
    subprocess (piper reloads the onnx every call, so this INCLUDES load — the honest per-call
    cost, same convention as _run_whisper. Do not move the clock inside the child; that is the
    gigaam-timer bug that flattered a 4.63s call to 0.61s, CLAUDE.local.md)."""
    vp = PIPER_VOICES / voice_file
    if not PIPER_BIN.exists() or not vp.exists():
        raise FileNotFoundError(f"piper organ absent: {PIPER_BIN if not PIPER_BIN.exists() else vp}")
    t0 = time.monotonic()
    p = subprocess.run([str(PIPER_BIN), "-m", str(vp), "-f", str(out_wav)],
                       input=text, capture_output=True, text=True, timeout=600)
    wall = time.monotonic() - t0
    if p.returncode != 0:
        raise RuntimeError(f"piper rc={p.returncode}: {p.stderr.strip()[:200]}")
    # rc=0 with no/empty wav is the silent-fallback shape: the render "succeeded" but the organ
    # is dead. An empty wav must never read as a quiet pass (the whisper rpath / room-music echo-500
    # family). Fail loud here so the floor gate below never scores silence as a working render.
    if not out_wav.exists() or out_wav.stat().st_size == 0:
        raise RuntimeError("piper rc=0 but produced no/empty wav — render is hollow")
    return wall


def _run_silero(mref, text, out_wav):
    """Render `text` -> out_wav via silero v4_ru (torch, in ~/.venv-ai). `mref` is "<speaker>:<voice>"
    (e.g. "v4_ru:baya"). Returns wall_seconds, parent-timed across the whole subprocess.

    Silero's model is fetched by torch.hub on first use and cached under ~/.cache/torch/hub. If that
    cache is absent this raises FileNotFoundError (honest n/a -> exit 2), NOT a fake render — an
    unfetched model is 'organ absent', not 'organ broken'. A present-but-broken load fails loud (rc)."""
    if not VENV_AI.exists():
        raise FileNotFoundError(f"silero organ absent (no venv): {VENV_AI}")
    hub = HOME / ".cache" / "torch" / "hub" / "snakers4_silero-models_master"
    if not hub.exists():
        raise FileNotFoundError(f"silero organ absent (hub not fetched): {hub}")
    speaker, voice = (mref.split(":", 1) + ["baya"])[:2]
    # sample_rate 48000 is silero v4's high-quality rate; save via its own utils to a real wav.
    code = (
        "import sys,torch\n"
        "torch.set_num_threads(4)\n"
        "dev=torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n"
        f"m,_=torch.hub.load('snakers4/silero-models','silero_tts',language='ru',speaker={speaker!r},trust_repo=True)\n"
        "m.to(dev)\n"
        f"text=open({str(out_wav)+'.txt'!r},encoding='utf-8').read()\n"
        f"p=m.save_wav(text=text,speaker={voice!r},sample_rate=48000,audio_path={str(out_wav)!r})\n"
        "print(p,flush=True)\n"
    )
    # pass the text via a sidecar file so quoting/newlines never corrupt the -c payload
    (Path(str(out_wav) + ".txt")).write_text(text, encoding="utf-8")
    t0 = time.monotonic()
    p = subprocess.run([str(VENV_AI), "-c", code], capture_output=True, text=True, timeout=600)
    wall = time.monotonic() - t0
    try:
        (Path(str(out_wav) + ".txt")).unlink()
    except OSError:
        pass
    if p.returncode != 0:
        raise RuntimeError(f"silero rc={p.returncode}: {p.stderr.strip()[:200]}")
    if not out_wav.exists() or out_wav.stat().st_size == 0:
        raise RuntimeError("silero rc=0 but produced no/empty wav — render is hollow")
    return wall


def _dur(wav):
    p = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                        "-of", "csv=p=0", str(wav)], capture_output=True, text=True)
    return float(p.stdout.strip()) if p.returncode == 0 else 0.0


def bench(organ, model, fixture_id, consumer="-", ledger=LEDGER):
    """One fixture x one candidate -> one ledger row. Raises FileNotFoundError when the
    organ/model is genuinely absent (caller maps that to exit 2 — honest n/a, never a
    fake green)."""
    fdir = FIXTURES / fixture_id
    wav, truth_f = fdir / "input.wav", fdir / "truth.txt"
    if not wav.exists() or not truth_f.exists():
        raise FileNotFoundError(f"fixture incomplete: {fdir}")
    if model not in STT_CANDIDATES:
        raise KeyError(f"unknown candidate: {model}")
    kind, mref = STT_CANDIDATES[model]
    if kind == "whisper":
        # whisper.cpp's CLI loads the model on EVERY call — there is no resident mode on this
        # harness, so there is no warm number to measure. `-` in the warm column means exactly
        # that; a number here would be the gigaam-timer bug reincarnated (a fixed cost dropped
        # as if it were free, flattering whoever pays it — CLAUDE.local.md, dafaf8d).
        text, wall = _run_whisper(mref, wav)
        warm = None
    else:
        text, wall, warm = _run_gigaam(mref, wav)
    truth = truth_f.read_text().strip()
    w = wer(truth, text)
    # Column 9 is a FACT ABOUT THIS RUN, not a judgment: did the model return words at all.
    # An empty transcript is a FAILURE, never a quiet pass — empty stdout reading as "no
    # transcript" is exactly how the whisper rpath bug stayed invisible for a day (974d864).
    #
    # THE LEDGER STORES FACTS; THE PANE RANKS. There is deliberately NO absolute WER
    # threshold here. Two reasons, both measured:
    #
    #  1. An assumed range lies. This plan originally carried `ok if w < 0.15`. Measured on
    #     this fixture: large-v3-turbo-q5_0 = 0.250, gigaam-v2_ctc = 0.312, whisper-tiny =
    #     0.875. That threshold labels the mesh's BEST STT organ — the only reason the room
    #     understood the operator's 08:12 ask at all — "poor". Same family as
    #     mesh-soundscape's `act > 0.55` -> "busy", which can never fire because act never
    #     exceeds .544 on real material.
    #
    #  2. This reference's absolutes are inflated. ~half of every candidate's WER is the
    #     REFERENCE's rendering of an English loanword ("text-to-speech" -> "текст-ту-спич"
    #     vs "тексту спич"); no model renders it identically. It hits every candidate
    #     EQUALLY, so ORDERING is trustworthy and absolute values are not. A threshold read
    #     against those absolutes asserts something the fixture cannot support.
    #
    # A verdict frozen at write time also goes stale: bench tiny first and it is labelled
    # against an empty corpus forever. Ranking is the pane's job, recomputed as the corpus
    # grows.
    read_status = "EMPTY" if not normalise(text) else "read-ok"
    # Column 10 = wall_warm: what call N+1 costs a consumer that holds the model RESIDENT
    # (room-ear's daemon does; voice-rx/mesh-ear spawn per call and pay column 6). "-" is a
    # CLAIM — this harness has no resident mode — never a formatting default for a dropped
    # measurement (that path raises in _run_gigaam). Both numbers are real and differ ~7.6x
    # on this node; ranking every consumer on either one alone fits neither (pub, 2026-07-15).
    row = "\t".join([time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), organ, consumer,
                     model, fixture_id, f"{wall:.2f}", f"{_dur(wav):.2f}", f"{w:.3f}", read_status,
                     "-" if warm is None else f"{warm:.2f}"])
    with open(ledger, "a") as fh:
        fh.write(row + "\n")
    return row, text


def bench_tts(model, fixture_id, consumer="-", ledger=LEDGER):
    """One TTS candidate x one authored fixture -> one ledger row, SAME 9-column schema as bench()
    so the dash `models` pane ranks it unchanged (organ='tts' groups it apart from stt rows).

    Columns for a tts row:  wall = render wall-clock (real per-call cost) · dur = RENDERED audio
    seconds (= speaking-rate proxy, a stable voice trait, since the input is fixed) · wer = the
    FLOOR-GATE round-trip WER · read_status = EMPTY when the round-trip returned nothing (render
    is silence/hollow).

    THE WER HERE IS A FLOOR GATE, NOT A QUALITY RANKER — and this is the whole reason the arm is
    built this way. Measured on this fixture (provenance, 2026-07-15): irina/ruslan/dmitri ALL
    round-trip through gigaam at WER 0.000. Clean TTS is the easiest possible STT input, so a good
    reader reads every voice back perfectly — the axis is a CONSTANT for working voices and cannot
    rank them (same dead-axis family as soundscape's tone median==max, act>0.55). What it CAN do is
    catch a regression: a materially non-zero WER means the render is mispronouncing, truncated, or
    silence. Voice QUALITY (naturalness) is the operator's EAR, not this number — the sample wav is
    kept under the fixture's samples/ dir precisely so the ear can judge «натурально»."""
    fdir = FIXTURES / fixture_id
    txt_f = fdir / "input.txt"
    if not txt_f.exists():
        raise FileNotFoundError(f"tts fixture incomplete (no input.txt): {fdir}")
    if model not in TTS_CANDIDATES:
        raise KeyError(f"unknown tts candidate: {model}")
    kind, mref = TTS_CANDIDATES[model]
    text = txt_f.read_text().strip()
    # keep the render for the operator's EAR — quality is the ear's call, never a number.
    sdir = fdir / "samples"
    sdir.mkdir(exist_ok=True)
    wav = sdir / f"{model}.wav"
    wall = _run_piper(mref, text, wav) if kind == "piper" else _run_silero(mref, text, wav)
    dur = _dur(wav)
    # FLOOR GATE: round-trip the render through the room STT (gigaam) and score against the very
    # text we rendered. Reuse _run_gigaam for the text only; its OWN wall is irrelevant here.
    rt_text, _gwall, _gwarm = _run_gigaam("v2_ctc", wav)
    w = wer(text, rt_text)
    read_status = "EMPTY" if not normalise(rt_text) else "read-ok"
    # wall_warm is "-" for every TTS row: no TTS consumer holds a renderer resident (piper
    # reloads the onnx each call; note3-say spawns), so a warm number would describe a caller
    # that does not exist here. The round-trip gigaam's warm is its own cost, not this voice's.
    row = "\t".join([time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "tts", consumer,
                     model, fixture_id, f"{wall:.2f}", f"{dur:.2f}", f"{w:.3f}", read_status, "-"])
    with open(ledger, "a") as fh:
        fh.write(row + "\n")
    return row, rt_text


def _extract_bash_func(body, name):
    """Extract a named bash function definition from `body`, whether it is a ONE-LINER
    (`name() { ...; }` all on one line) or MULTI-LINE (header ... `}` at column 0). Returns the
    source text or None. The one-liner case is not incidental: mesh-room-address's wake_value was
    refactored to `wake_value() { field_value wake; }`, and a multi-line-only `.*?^\\}` regex
    silently swallowed everything up to the NEXT function's closing brace — the extracted parser
    went vacuous (field_value: command not found on every call) while the gate that depends on it
    read green. Extract exactly the function, and its transitive helper alongside it."""
    # one-liner first: whole def on a single line with balanced braces
    m = re.search(rf"^{re.escape(name)}\(\)[^\n]*\}}[^\n]*$", body, re.M)
    if m and m.group(0).count("{") == m.group(0).count("}") and m.group(0).count("{") >= 1:
        return m.group(0)
    # multi-line: header down to a `}` at column 0
    m = re.search(rf"^{re.escape(name)}\(\) \{{.*?^\}}", body, re.S | re.M)
    return m.group(0) if m else None


def _gate_wake_value(raw):
    """Run mesh-room-address's OWN wake_value() parser over `raw`. Extracted from the DEPLOYED
    tool, never re-implemented — a second copy of the parser drifts from the first exactly as
    silently as a second map (the mesh-model-resolve rule). Returns 'true'/'false'/'' (unparseable),
    or raises FileNotFoundError when the gate tool is absent.

    Extracts BOTH wake_value AND its helper field_value: wake_value is now `field_value wake`, so
    the helper must ride along or the isolated function dies `field_value: command not found` — a
    vacuous parser reading as a working one (the exact drift this file keeps catching elsewhere)."""
    src = BIN / "mesh-room-address"
    if not src.exists():
        raise FileNotFoundError(f"wake gate absent: {src}")
    body = src.read_text(errors="ignore")
    wv = _extract_bash_func(body, "wake_value")
    if not wv:
        raise RuntimeError("mesh-room-address has no wake_value() — its parser was renamed or removed")
    fv = _extract_bash_func(body, "field_value")   # wake_value delegates here; may be None on an older layout
    snippet = ((fv + "\n") if fv else "") + wv + "\nwake_value"
    p = subprocess.run(["bash", "-c", snippet],
                       input=raw, capture_output=True, text=True, timeout=30)
    return p.stdout.strip()


def _wake_score(labels, verdicts):
    """Pure scoring for a wake run: (deaf, false, false_rate). Two error classes, NOT symmetric
    (fixture provenance): DEAF = a WAKE line judged IGNORE — the mind misses a real call, which
    DISQUALIFIES the model outright; FALSE = an IGNORE line judged WAKE — burns one paid turn.
    false_rate is FALSE / #IGNORE-lines, the wake row's `wer` column."""
    deaf = sum(1 for l, v in zip(labels, verdicts) if l == "WAKE" and not v)
    false_ = sum(1 for l, v in zip(labels, verdicts) if l == "IGNORE" and v)
    n_ign = sum(1 for l in labels if l == "IGNORE")
    return deaf, false_, (false_ / n_ign if n_ign else 0.0)


def bench_wake(model, fixture_id, consumer="-", ledger=LEDGER):
    """One wake-gate candidate x one labeled corpus -> one ledger row, in the ledger's schema
    (10-column contract agreed with the warm-vs-cold task, 2026-07-16: col6 = COLD per-call
    cost, col10 = wall_warm, '-' when unmeasured).

    Columns for a wake row: wall(col6) = the parse probe's wall — includes the ollama model
    load ONLY when the model was not already resident in the server (a recently-used incumbent
    probes warm: measured 0.38s for qwen2.5:3b while live, vs seconds for a true cold load), so
    col6 is an UPPER-BOUND-when-idle, not a guaranteed cold number · dur = corpus size in
    lines · wer = FALSE-rate (junk lines that woke / all junk lines) · col10 = WARM median
    per-line latency through the DEPLOYED gate — what the reflex pays per candidate line
    inside a conversation. Ranking wake models on speed must read col10 · status:
      read-ok   — honest run, rankable
      DEAF      — missed >=1 real address. DISQUALIFIED: a deaf gate can never be crowned,
                  however few its false wakes (it would win by silencing everything).
      UNPARSED  — the model's output carries no wake field the gate's own parser can read
                  (the qwen3.5 thinking family). DISQUALIFIED **LOUDLY**: under the live gate
                  every unparseable verdict fails open, so ranking it low-but-rankable would
                  launder a parsing loss into a competence loss (the trap that made qwen3.5
                  look 3x worse than it is). Named, never silently ranked.

    THE HARNESS IS THE DEPLOYED GATE. Each line runs `ROOM_ADDRESS_MODEL=<tag> mesh-room-address
    "<line>"` — prompt, parser, timeout and fail-open exactly as the live reflex pays them."""
    fdir = FIXTURES / fixture_id
    corpus_f = fdir / "corpus.tsv"
    if not corpus_f.exists():
        raise FileNotFoundError(f"wake fixture incomplete (no corpus.tsv): {fdir}")
    if model not in WAKE_CANDIDATES:
        raise KeyError(f"unknown wake candidate: {model}")
    gate = BIN / "mesh-room-address"
    if not gate.exists():
        raise FileNotFoundError(f"wake gate absent: {gate}")
    have = subprocess.run(["bash", "-c", "command -v ollama >/dev/null 2>&1 && ollama list 2>/dev/null"],
                          capture_output=True, text=True, timeout=30)
    if have.returncode != 0 or model.split(":", 1)[0] not in have.stdout:
        raise FileNotFoundError(f"ollama/{model} not present — cannot bench a model that is not pulled")
    lines = [(p[0], p[1]) for p in
             (ln.split("\t", 1) for ln in corpus_f.read_text(encoding="utf-8").splitlines() if "\t" in ln)
             if p[0] in ("WAKE", "IGNORE")]
    if not lines:
        raise FileNotFoundError(f"wake corpus empty/unlabeled: {corpus_f}")

    # PARSE PROBE (doubles as the warm-up AND the cold-cost measurement): drive the model through
    # --format json and the gate's own extracted parser. No wake field readable -> UNPARSED, skip
    # the full run (28 fail-open calls would measure the fail-open constant, not the model).
    probe_q = ('Ответь строго одним JSON-объектом вида {"wake":true} или {"wake":false}. '
               'Обращаются ли к Мише в реплике: "Время"')
    t0 = time.monotonic()
    # mirrors mesh-room-address's model_raw() exactly — --think=false included, else a thinking
    # model reads UNPARSED here while the fixed gate parses it fine (probe and gate must agree)
    pr = subprocess.run(["bash", "-c", 'timeout 60 ollama run "$1" --think=false --format json "$2" 2>/dev/null | tr -d "\\n"',
                         "_", model, probe_q], capture_output=True, text=True, timeout=120)
    cold = time.monotonic() - t0
    raw = pr.stdout.strip()
    if not raw:
        raise RuntimeError(f"wake parse probe produced NOTHING from {model} — the model/backend is "
                           f"broken, not unparseable")
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if not _gate_wake_value(raw):
        row = "\t".join([now, "wake", consumer, model, fixture_id,
                         f"{cold:.2f}", f"{len(lines):.2f}", "1.000", "UNPARSED", "-"])
        with open(ledger, "a") as fh:
            fh.write(row + "\n")
        return row, f"UNPARSED — gate's own parser reads no wake field in: {raw[:120]}"

    verdicts, walls = [], []
    env = dict(os.environ, ROOM_ADDRESS_MODEL=model)
    for _label, text in lines:
        t0 = time.monotonic()
        p = subprocess.run([str(gate), text], capture_output=True, text=True, timeout=120, env=env)
        walls.append(time.monotonic() - t0)
        verdicts.append(p.returncode == 0)          # 0 = WAKE (incl. fail-open), 1 = IGNORE
    deaf, false_, rate = _wake_score([l for l, _ in lines], verdicts)
    warm = sorted(walls)[len(walls) // 2]
    status = "DEAF" if deaf else "read-ok"
    row = "\t".join([time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "wake", consumer,
                     model, fixture_id, f"{cold:.2f}", f"{len(lines):.2f}", f"{rate:.3f}", status,
                     f"{warm:.2f}"])
    with open(ledger, "a") as fh:
        fh.write(row + "\n")
    return row, (f"deaf={deaf} false={false_}/{sum(1 for l, _ in lines if l == 'IGNORE')} "
                 f"cold={cold:.2f}s warm-median={warm:.2f}s")


def _gate_cover_verdict(evidence, model, timeout_s=25):
    """Run mesh-clear's OWN _classify_coverage() over `evidence`, pinned to `model`. Extracted from
    the DEPLOYED tool, never re-implemented — a re-implementation drifts from the live prompt/parser
    exactly as silently as a second map (the mesh-model-resolve rule; same reason _gate_wake_value
    extracts wake_value). Returns 'YES'|'NO'|'UNSURE' — whatever the gate would actually decide,
    including its fail-safe (any unparse/timeout -> UNSURE -> block). Raises FileNotFoundError when
    mesh-clear is absent on this node."""
    src = BIN / "mesh-clear"
    if not src.exists():
        raise FileNotFoundError(f"clear gate absent: {src}")
    body = src.read_text(errors="ignore")
    m = re.search(r"^_classify_coverage\(\) \{.*?^\}", body, re.S | re.M)
    if not m:
        raise RuntimeError("mesh-clear has no _classify_coverage() — its parser was renamed or removed")
    # MODEL is read from the enclosing script in the live tool; supply it + the timeout, leave
    # MESH_CLEAR_CLASSIFY_CMD UNSET so the real ollama path (with --think=false) runs, then call it
    # with the evidence on stdin exactly as _gate() feeds it.
    snippet = f'MODEL={model!r}\nMESH_CLEAR_MODEL_TIMEOUT={timeout_s}\n' + m.group(0) + "\n_classify_coverage"
    p = subprocess.run(["bash", "-c", snippet], input=evidence, capture_output=True, text=True,
                       timeout=timeout_s + 15)
    v = p.stdout.strip()
    return v if v in ("YES", "NO", "UNSURE") else "UNSURE"


def _cover_score(labels, verdicts):
    """Pure scoring for a coverage run. TWO error classes, ASYMMETRIC — and the asymmetry is the whole
    point of the CLEAR gate (mesh-clear's fail-safe doctrine):

      FALSE-YES = an UNCOVERED handoff the model called YES. This is the IRREVERSIBLE error: the gate
                  would /clear a mind whose work the handoff does NOT capture, and the thread is gone
                  FOREVER. Any false-YES DISQUALIFIES a model outright (status UNSAFE) — the exact mirror
                  of a wake gate's DEAF: however good the rest, one unrecoverable miss is fatal.
      OVER-BLOCK = a COVERED handoff the model did NOT call YES (NO or UNSURE). The mind is merely
                  refused a /clear it could safely have — annoying, fully RECOVERABLE (update handoff /
                  retry). This is the rankable rate (the row's `wer` col); lower is better.

    A model that always says NO scores ZERO false-YES (safe!) but over-blocks EVERY covered case
    (rate 1.000) — safe-but-useless, which is precisely today's qwen2.5:3b. That is DEGENERATE, not a
    winner: it never lets a legitimate clear through. So a usable model needs BOTH false_yes==0 AND a
    low over-block rate. Returns (false_yes, over_block, n_covered, rate)."""
    false_yes = sum(1 for l, v in zip(labels, verdicts) if l == "UNCOVERED" and v == "YES")
    over_block = sum(1 for l, v in zip(labels, verdicts) if l == "COVERED" and v != "YES")
    n_cov = sum(1 for l in labels if l == "COVERED")
    return false_yes, over_block, n_cov, (over_block / n_cov if n_cov else 0.0)


def bench_cover(model, fixture_id, consumer="-", ledger=LEDGER):
    """One coverage-gate candidate x one labeled corpus -> one ledger row, 10-column schema.

    Columns for a coverage row: wall(col6) = first-call wall through the deployed classify (includes
    ollama load when the model was idle — an upper-bound-when-cold, like the wake row) · dur = corpus
    size in cases · wer(col8) = OVER-BLOCK rate (covered cases the gate refused / all covered cases;
    the rankable, RECOVERABLE error) · col10 = WARM median per-case latency · status:
      read-ok    — safe AND discriminating (rankable; false_yes==0, over-block < 1.0)
      UNSAFE     — >=1 FALSE-YES. DISQUALIFIED: it would /clear a mind whose handoff misses its work,
                   losing the thread irreversibly. However clean the rest, this can never be crowned —
                   the mirror of a DEAF wake gate. Named LOUDLY, never ranked as merely-worse.
      DEGENERATE — safe (false_yes==0) but over-block rate 1.000: it NEVER permits a covered clear
                   (the always-NO trap; today's qwen2.5:3b). Safe to ship as a blocker, useless as a
                   gate — surfaced so 'safe' is never mistaken for 'works'.

    THE HARNESS IS THE DEPLOYED GATE. Each case runs mesh-clear's own _classify_coverage over
    HANDOFF+SCROLLBACK — the same prompt, --think=false, timeout and fail-safe parse the live /clear
    pays. A harness that measured a re-implemented prompt could crown a model the gate cannot use (the
    qwen3.5 lesson: the loss was PARSING, and the live gate parses)."""
    fdir = FIXTURES / fixture_id
    corpus_f = fdir / "corpus.jsonl"
    if not corpus_f.exists():
        raise FileNotFoundError(f"coverage fixture incomplete (no corpus.jsonl): {corpus_f}")
    if model not in COVERAGE_CANDIDATES:
        raise KeyError(f"unknown coverage candidate: {model}")
    if not (BIN / "mesh-clear").exists():
        raise FileNotFoundError(f"clear gate absent: {BIN / 'mesh-clear'}")
    have = subprocess.run(["bash", "-c", "command -v ollama >/dev/null 2>&1 && ollama list 2>/dev/null"],
                          capture_output=True, text=True, timeout=30)
    if have.returncode != 0 or model not in have.stdout:
        raise FileNotFoundError(f"ollama/{model} not present — cannot bench a model that is not pulled")
    cases = []
    for ln in corpus_f.read_text(encoding="utf-8").splitlines():
        ln = ln.strip()
        if not ln:
            continue
        c = __import__("json").loads(ln)
        if c.get("label") in ("COVERED", "UNCOVERED"):
            cases.append(c)
    if not cases:
        raise FileNotFoundError(f"coverage corpus empty/unlabeled: {corpus_f}")

    # each case's evidence is EXACTLY what _gate() builds: the handoff, then a SCROLLBACK section.
    def _evidence(c):
        return f"{c['handoff']}\n=== SCROLLBACK ({len(c['scrollback'].splitlines())} lines) ===\n{c['scrollback']}"

    labels, verdicts, walls = [], [], []
    for c in cases:
        t0 = time.monotonic()
        v = _gate_cover_verdict(_evidence(c), model)
        walls.append(time.monotonic() - t0)
        labels.append(c["label"])
        verdicts.append(v)
    false_yes, over_block, n_cov, rate = _cover_score(labels, verdicts)
    cold = walls[0] if walls else 0.0
    warm = sorted(walls[1:])[len(walls[1:]) // 2] if len(walls) > 1 else cold
    if false_yes > 0:
        status = "UNSAFE"
    elif n_cov and over_block == n_cov:
        status = "DEGENERATE"
    else:
        status = "read-ok"
    row = "\t".join([time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "coverage", consumer,
                     model, fixture_id, f"{cold:.2f}", f"{len(cases):.2f}", f"{rate:.3f}", status,
                     f"{warm:.2f}"])
    with open(ledger, "a") as fh:
        fh.write(row + "\n")
    n_unc = sum(1 for l in labels if l == "UNCOVERED")
    return row, (f"false-YES={false_yes}/{n_unc} (UNSAFE if >0) · over-block={over_block}/{n_cov} "
                 f"rate={rate:.3f} · cold={cold:.2f}s warm-median={warm:.2f}s · status={status}")


def run_test():
    f = 0
    truth = "Уши на текст-ту-спич и спич-ту-текст должны быть прямо крошечные и суперские модели"

    # identical text scores 0.0
    if wer(truth, truth) != 0.0:
        print("  FAIL: identical text did not score 0.0"); f = 1

    # THE CTC GATE: lowercase + unpunctuated must NOT be penalised. This is the
    # difference between recommending gigaam and recommending whisper.
    ctc = "уши на текст-ту-спич и спич-ту-текст должны быть прямо крошечные и суперские модели"
    if wer(truth, ctc) != 0.0:
        print(f"  FAIL: CTC-style (lowercase/unpunctuated) penalised — wer={wer(truth, ctc)}"); f = 1

    # ordering must hold: tiny is worse than a near-perfect read
    near = "уши на текст ту спич и спич ту текст должны быть прямо крошечные и суперские модели"

    # THE PUNCTUATION GATE: `ctc` above differs from truth only by CASE — both keep
    # the internal hyphens ("текст-ту-спич"), so it never exercises _PUNCT.sub at all.
    # A review disabled that line entirely (`_PUNCT.sub(" ", s)` -> no-op) and every
    # assertion in this suite still passed. The real gap: GigaAM's actual output has
    # NO punctuation whatsoever — "текст-ту-спич" comes back as three bare words, not
    # one hyphenated token. `near` is truth fully de-hyphenated (zero punctuation, same
    # words) — with punctuation-stripping working it's a PERFECT match to normalise(truth),
    # because stripping "-" splits truth's hyphenated words the same way. If the strip is
    # disabled, truth's hyphenated tokens stay glued and this stops being a perfect match.
    w_near = wer(truth, near)
    if w_near != 0.0:
        print(f"  FAIL: punctuation-free CTC-shaped hyp not a perfect match — wer={w_near}"); f = 1

    # THE WHISPER-TINY GATE: the real garbage tiny produced must score as garbage.
    # If this ever reads low, the scorer is broken and the bench will recommend tiny.
    tiny = "Маш на тех, что спичка, спичка тех, что нужно тебя кружчивать и субтитровать"
    w_tiny = wer(truth, tiny)
    if w_tiny < 0.5:
        print(f"  FAIL: whisper-tiny's real output scored {w_tiny:.2f} — a scorer this blind picks tiny"); f = 1

    # ordering must hold: tiny is worse than a near-perfect read
    if not (w_near < w_tiny):
        print("  FAIL: garbage did not score worse than a near-perfect read"); f = 1

    # THE DP-COST GATE: the recurrence has three terms — deletion (prev[j]+1),
    # insertion (cur[j-1]+1), substitution (prev[j-1]+diff) — and until now nothing
    # pinned an EXACT expected distance, so a review made insertion free
    # (cur[j-1]+1 -> cur[j-1]) and, separately, deletion free (prev[j]+1 -> prev[j])
    # and "smoke-test: ok" printed both times. Distinct single-letter tokens rule out
    # any cheaper substitution path, so the edit distance is exactly the count of
    # extra/missing words — hand-verified below.
    ins_ref, ins_hyp = "a b c", "a b c d e"          # hyp has 2 words ref doesn't — pure insertion
    w_ins = wer(ins_ref, ins_hyp)
    if abs(w_ins - 2 / 3) > 1e-9:
        print(f"  FAIL: pure-insertion WER should be 2/3, got {w_ins}"); f = 1

    del_ref, del_hyp = "a b c d e", "a b c"          # ref has 2 words hyp doesn't — pure deletion
    w_del = wer(del_ref, del_hyp)
    if abs(w_del - 2 / 5) > 1e-9:
        print(f"  FAIL: pure-deletion WER should be 2/5, got {w_del}"); f = 1

    # empty hypothesis is total failure, never a free pass (the silent-fallback family:
    # a model that returns nothing must not read as accurate)
    if wer(truth, "") < 1.0:
        print("  FAIL: empty hypothesis did not score as total failure"); f = 1

    # THE REAL-MODEL GATE. mesh-whisper-run --test drove echobin/errbin/sleep stubs,
    # asserted nice/ionice/flock/admission green, and NEVER INVOKED WHISPER — while
    # whisper died rc=127 on every real call for a day (974d864). A bench whose test
    # never benches is worse than no bench. This drives the smallest real model against
    # a real fixture and asserts real words come back.
    #
    # It goes THROUGH bench() into a TEMP ledger — never the real one (a --test must never
    # forge the artifact a human/pane reads, mesh-guardian 09f7914) — so the ROW is a live
    # artifact the gates below can assert on, not just the transcript.
    fx = FIXTURES / "stt-ru-operator-0812"
    if not (fx / "input.wav").exists():
        print("  n/a: fixture stt-ru-operator-0812 absent — cannot assert a real read")
        print("smoke-test: n/a (no fixture)")
        return 2
    if not WHISPER_BIN.exists():
        print("  n/a: whisper organ absent — cannot assert a real read")
        print("smoke-test: n/a (no whisper)")
        return 2
    tmp_ledger = Path(tempfile.mkdtemp()) / "bench-test.ledger"
    try:
        t_row, text = bench("stt", "whisper-tiny", "stt-ru-operator-0812",
                            consumer="selftest", ledger=tmp_ledger)
    except Exception as e:
        print(f"  FAIL: the real read raised — the organ is broken, not the test: {e}")
        print("smoke-test: FAIL")
        return 1
    tfields = t_row.split("\t")
    wall = float(tfields[5])
    if not normalise(text):
        # empty stdout from a green-looking binary IS the rpath signature
        print("  FAIL: real whisper read returned EMPTY — executable != loadable (check ldd on lib*.so.*)")
        print("smoke-test: FAIL")
        return 1
    if wall <= 0.0:
        print("  FAIL: wall-clock was not measured on a real call"); f = 1
    # THE SPAWNING-HARNESS GATE: whisper.cpp's CLI loads per call — no resident mode exists,
    # so its wall_warm MUST be the "-" claim. A number here is the warm column leaking onto a
    # consumer that never pays it (the exact direction the 0.61s bug flattered).
    if len(tfields) != 10 or tfields[9] != "-":
        print(f"  FAIL: whisper row wall_warm = {tfields[9:] or 'MISSING'!r}, expected '-' — "
              f"a harness that loads per call must never be scored warm"); f = 1
    print(f"  real read ok: tiny returned {len(normalise(text))} words in {wall:.1f}s")

    # THE GIGAAM REAL-READ GATE. Without this, _run_gigaam has ZERO coverage — exactly
    # the failure class this whole file exists to catch (mesh-whisper-run --test drove
    # stubs and never invoked whisper; whisper died rc=127 on every real call for a
    # day, undetected). VENV_AI absent means the organ genuinely is not on this node —
    # that is an honest n/a (exit 2, mesh-land counts it a pass). VENV_AI present but
    # broken, empty, or garbage is NOT n/a — it must fail loud (exit 1), never vanish
    # into a green board the way the .transcription/.text mixup did.
    if not VENV_AI.exists():
        print("  n/a: gigaam organ absent — cannot assert a real read")
        print("smoke-test: n/a (no gigaam)")
        return 2
    try:
        g_row, g_text = bench("stt", "gigaam-v2_ctc", "stt-ru-operator-0812",
                              consumer="selftest", ledger=tmp_ledger)
    except Exception as e:
        print(f"  FAIL: the real gigaam read raised — the organ is broken, not the test: {e}")
        print("smoke-test: FAIL")
        return 1
    gfields = g_row.split("\t")
    g_wall = float(gfields[5])
    if not normalise(g_text):
        # empty output from a green-looking subprocess is the same shape as the whisper
        # rpath signature — a call that "succeeds" (rc=0) but produced nothing real.
        print("  FAIL: real gigaam read returned EMPTY — a broken organ must never read as silence")
        print("smoke-test: FAIL")
        return 1
    if g_wall <= 0.0:
        print("  FAIL: gigaam wall-clock was not measured on a real call"); f = 1

    # THE FIXED-COST GATE — the one that was missing when the ledger recorded 0.61s for a call
    # that really costs 4.63s. _run_gigaam used to start its timer INSIDE the child, after
    # load_model(), while _run_whisper timed the whole subprocess from the parent. Same column,
    # two meanings, and gigaam came out looking like it DOMINATED whisper-base when it does not.
    #
    # NO MAGIC THRESHOLD. "wall must exceed 2s" would be an assumed range, and assumed ranges lie
    # (see the `ok if w < 0.15` note above, and mesh-soundscape's act > 0.55 that can never fire).
    # Calibrate against a MEASURED floor instead: an honest parent-side wall MUST exceed the cost
    # of merely starting that interpreter and importing gigaam — a cost we measure right here, on
    # this node, at this moment. Time the timer against the world, not against a constant.
    t0 = time.monotonic()
    subprocess.run([str(VENV_AI), "-c", "import gigaam"], capture_output=True, timeout=600)
    floor = time.monotonic() - t0
    if g_wall <= floor:
        print(f"  FAIL: gigaam wall {g_wall:.2f}s <= the bare import floor {floor:.2f}s — the "
              f"timer is inside the child and the ledger is omitting a fixed cost, exactly as it "
              f"did until 2026-07-15 (0.61s recorded for a 4.63s call)"); f = 1

    # THE WARM GATE — the other half of the same bug, guarded in the other direction. The warm
    # column exists because 0.61s was never fiction: it is what the RESIDENT room-ear daemon pays
    # per call, and after dafaf8d fixed the cold timer that real number had no column at all (pub,
    # warm-vs-cold-needs-two-columns). But a warm number is only honest if it EXCLUDES the fixed
    # cost — a warm that quietly includes load (or a cold that quietly excludes it) is the same
    # lie with a new name. So: measure the LOAD cost live (import+load child minus the bare-import
    # floor above — a measured quantity, never an assumed "~2.5s"), then assert cold exceeds warm
    # by at least that load cost. cold - warm = interpreter + import + load, so the margin above
    # load_cost is the whole interpreter+import floor — noise cannot flip this on a healthy run.
    if len(gfields) != 10 or gfields[9] == "-":
        print(f"  FAIL: gigaam row wall_warm = {gfields[9:] or 'MISSING'!r} — a resident-capable "
              f"harness must publish what call N+1 costs; '-' here is a dropped measurement "
              f"reading as an honest claim"); f = 1
    else:
        g_warm = float(gfields[9])
        t0 = time.monotonic()
        subprocess.run([str(VENV_AI), "-c", "import gigaam\ngigaam.load_model('v2_ctc')"],
                       capture_output=True, timeout=600)
        load_cost = (time.monotonic() - t0) - floor
        if g_warm <= 0.0:
            print("  FAIL: gigaam wall_warm was not measured on a real call"); f = 1
        elif (g_wall - g_warm) < load_cost:
            print(f"  FAIL: cold {g_wall:.2f}s exceeds warm {g_warm:.2f}s by less than the "
                  f"measured load cost {load_cost:.2f}s — one of the two columns is counting "
                  f"the fixed cost on the wrong side"); f = 1
        else:
            print(f"  warm gate ok: cold {g_wall:.2f}s / warm {g_warm:.2f}s "
                  f"(measured load cost {load_cost:.2f}s)")
    print(f"  real read ok: gigaam v2_ctc returned {len(normalise(g_text))} words in {g_wall:.1f}s "
          f"(incl. load; bare-import floor {floor:.1f}s)")

    # THE TTS REAL-RENDER + FLOOR-GATE GATE. Same family as the STT real-read gates above: a bench
    # whose --test never renders is worse than no bench (mesh-whisper-run drove stubs, never
    # invoked whisper, and whisper died rc=127 for a day). This drives a REAL piper render of the
    # authored fixture and asserts the round-trip floor gate actually fires. It writes NO ledger
    # row — a --test must never forge the artifact a human/pane reads for liveness (mesh-guardian,
    # 09f7914) — so it calls _run_piper/_run_gigaam directly, not bench_tts.
    tfx = FIXTURES / "tts-ru-authored-01"
    irina = PIPER_VOICES / "ru_RU-irina-medium.onnx"
    if not (tfx / "input.txt").exists():
        print("  n/a: tts fixture tts-ru-authored-01 absent — cannot assert a real render")
        print("smoke-test: n/a (no tts fixture)")
        return 2
    if not PIPER_BIN.exists() or not irina.exists():
        print("  n/a: piper organ/voice absent — cannot assert a real render")
        print("smoke-test: n/a (no piper)")
        return 2
    ttext = (tfx / "input.txt").read_text().strip()
    twav = Path(tempfile.mkdtemp()) / "tts-test.wav"
    try:
        p_wall = _run_piper("ru_RU-irina-medium.onnx", ttext, twav)
    except Exception as e:
        print(f"  FAIL: the real piper render raised — the organ is broken, not the test: {e}")
        print("smoke-test: FAIL")
        return 1
    if p_wall <= 0.0:
        print("  FAIL: piper wall-clock was not measured on a real render"); f = 1
    tdur = _dur(twav)
    if tdur <= 0.0:
        print("  FAIL: rendered wav has zero duration — render is hollow"); f = 1
    # the floor gate itself: round-trip through gigaam must read the render back near-perfect.
    # 0.5 is a BROKEN/working split, NOT a quality threshold (a working render scores ~0.0, a
    # silence/wrong render ~1.0). It cannot label a good voice 'poor' — every working voice reads
    # back ~0.0 — so it is not the `ok<0.15` assumed-range trap; it is the floor gate's real
    # semantic, calibrated against the measured fact that clean TTS round-trips at ~0.000.
    if VENV_AI.exists():
        try:
            rt, _, _ = _run_gigaam("v2_ctc", twav)
        except Exception as e:
            print(f"  FAIL: the round-trip gigaam read raised: {e}")
            print("smoke-test: FAIL")
            return 1
        if not normalise(rt):
            print("  FAIL: floor-gate round-trip returned EMPTY — a working irina render is not silence")
            print("smoke-test: FAIL")
            return 1
        rt_wer = wer(ttext, rt)
        if rt_wer >= 0.5:
            print(f"  FAIL: floor-gate round-trip WER {rt_wer:.3f} >= 0.5 — a working irina render "
                  f"must read back near-perfect; the floor gate or the render is broken"); f = 1
        print(f"  tts real render ok: irina {p_wall:.1f}s -> {tdur:.1f}s audio, floor round-trip WER {rt_wer:.3f}")
    else:
        print(f"  tts real render ok: irina {p_wall:.1f}s -> {tdur:.1f}s audio (gigaam absent, floor gate skipped)")
    try:
        twav.unlink(); twav.parent.rmdir()
    except OSError:
        pass

    # ---- WAKE ARM GATES ----------------------------------------------------------------
    # THE WAKE SCORER GATES (pure): the two error classes must count correctly and stay
    # ASYMMETRIC — one missed real address is DEAF (disqualifies), however clean the rest.
    labels = ["WAKE", "WAKE", "IGNORE", "IGNORE", "IGNORE", "IGNORE"]
    d, fl, r = _wake_score(labels, [True, True, True, False, False, False])
    if (d, fl) != (0, 1) or abs(r - 0.25) > 1e-9:
        print(f"  FAIL: wake scorer miscounts — deaf={d} false={fl} rate={r} (want 0,1,0.25)"); f = 1
    d, fl, r = _wake_score(labels, [True, False, False, False, False, False])
    if d != 1:
        print("  FAIL: a missed real address did not count as DEAF"); f = 1
    # a gate that silences EVERYTHING scores 0 false — only DEAF disqualification stops it winning
    d, fl, r = _wake_score(labels, [False] * 6)
    if not (d == 2 and fl == 0 and r == 0.0):
        print("  FAIL: the silence-everything degenerate case must read deaf>0 false=0 — DEAF "
              "status is the ONLY thing keeping it off the podium"); f = 1

    # THE EXTRACTED-PARSER GATE: _gate_wake_value must run the DEPLOYED gate's own wake_value()
    # — a thinking-style wrapper with no wake field is unparseable ('' -> UNPARSED row), a real
    # verdict parses. This is the branch that keeps a parsing loss from being ranked as a
    # competence loss. n/a when the gate tool is absent on this node.
    try:
        if _gate_wake_value('Thinking... {"reasoning_content":"...false..."}') != "":
            print("  FAIL: gate parser mined a verdict out of thinking prose — an UNPARSED model "
                  "would be silently ranked instead of loudly disqualified"); f = 1
        if _gate_wake_value('{"wake": "false"}') != "false":
            print("  FAIL: gate parser cannot read a quoted/spaced false"); f = 1
        if _gate_wake_value('{"wake":true}') != "true":
            print("  FAIL: gate parser cannot read a bare true"); f = 1
        # THE REAL-HARNESS GATE: one real line through the deployed gate under an explicit
        # ROOM_ADDRESS_MODEL — asserts the harness path (env pin -> gate -> verdict exit code)
        # executes, not what the model answers (a per-line answer assertion would be the
        # stochastic-gate trap; the never-deaf assertions live in mesh-room-address --test).
        wfx = FIXTURES / "wakegate-ru-01"
        have = subprocess.run(["bash", "-c",
                               "command -v ollama >/dev/null 2>&1 && ollama list 2>/dev/null"],
                              capture_output=True, text=True, timeout=30)
        if (wfx / "corpus.tsv").exists() and have.returncode == 0 and "qwen2.5" in have.stdout:
            env = dict(os.environ, ROOM_ADDRESS_MODEL="qwen2.5:3b")
            p = subprocess.run([str(BIN / "mesh-room-address"), "Миша, ты нас слышишь?"],
                               capture_output=True, text=True, timeout=120, env=env)
            if p.returncode not in (0, 1):
                print(f"  FAIL: real wake-harness call exited rc={p.returncode} — the gate "
                      f"crashed rather than judged"); f = 1
            else:
                print(f"  wake harness ok: deployed gate judged a real line (rc={p.returncode})")
        else:
            print("  n/a: wake fixture/ollama/qwen2.5 absent — real wake-harness call skipped")
    except FileNotFoundError as e:
        print(f"  n/a: {e} — wake parser/harness gates skipped")

    # ---- COVERAGE ARM GATES ------------------------------------------------------------
    # THE COVERAGE SCORER GATES (pure): the asymmetry must hold — a FALSE-YES (clearing an
    # UNCOVERED handoff) DISQUALIFIES however clean the rest, and an always-NO model is
    # DEGENERATE (safe, useless), NOT a winner. This encodes mesh-clear's fail-safe doctrine.
    cl = ["COVERED", "COVERED", "UNCOVERED", "UNCOVERED"]
    # perfect: covered->YES, uncovered->NO
    fy, ob, nc, r = _cover_score(cl, ["YES", "YES", "NO", "NO"])
    if (fy, ob, nc) != (0, 0, 2) or r != 0.0:
        print(f"  FAIL: coverage scorer miscounts a perfect run — fy={fy} ob={ob} rate={r}"); f = 1
    # one FALSE-YES (an uncovered handoff called YES) — the irreversible error
    fy, ob, nc, r = _cover_score(cl, ["YES", "YES", "YES", "NO"])
    if fy != 1:
        print("  FAIL: an UNCOVERED handoff called YES did not count as false-YES (the "
              "irreversible clear-loss error)"); f = 1
    # UNSURE on an UNCOVERED case is SAFE (it blocks) — must NOT count as false-YES
    fy, ob, nc, r = _cover_score(cl, ["YES", "YES", "UNSURE", "UNSURE"])
    if fy != 0:
        print("  FAIL: UNSURE on an uncovered case counted as false-YES — UNSURE blocks, it is safe"); f = 1
    # always-NO: zero false-YES (safe) but over-blocks EVERY covered case → rate 1.000 (DEGENERATE)
    fy, ob, nc, r = _cover_score(cl, ["NO", "NO", "NO", "NO"])
    if not (fy == 0 and ob == 2 and abs(r - 1.0) < 1e-9):
        print("  FAIL: always-NO must read false-YES=0 (safe) but over-block rate 1.000 — the "
              "safe-but-useless degenerate that DEGENERATE status exists to surface"); f = 1

    # THE EXTRACTED-CLASSIFY GATE: _gate_cover_verdict must run mesh-clear's OWN _classify_coverage,
    # not a re-impl. Force the gate's MESH_CLEAR_CLASSIFY_CMD override so the verdict is deterministic
    # (no model), proving the EXTRACTION + invocation + fail-safe passthrough plumbing — the branch
    # that keeps this harness measuring the deployed parser instead of a private copy. n/a if absent.
    try:
        import os as _os
        env_bak = _os.environ.get("MESH_CLEAR_CLASSIFY_CMD")
        _os.environ["MESH_CLEAR_CLASSIFY_CMD"] = "printf YES"
        try:
            v = _gate_cover_verdict("handoff x\n=== SCROLLBACK ===\ndid x", "gemma4:e2b-it-qat")
        finally:
            if env_bak is None:
                _os.environ.pop("MESH_CLEAR_CLASSIFY_CMD", None)
            else:
                _os.environ["MESH_CLEAR_CLASSIFY_CMD"] = env_bak
        if v != "YES":
            print(f"  FAIL: _gate_cover_verdict did not run mesh-clear's own classify (got {v!r}, "
                  f"expected YES via the injected override) — the extraction/plumbing is broken"); f = 1
        else:
            print("  coverage classify-extraction ok: drove mesh-clear's own _classify_coverage")
        # THE REAL MODEL-PATH GATE: one case through the DEPLOYED classify under a pulled current-gen
        # model — asserts the live ollama path (prompt + --think=false + parse) completes and yields a
        # valid verdict, NOT a specific answer (a per-case answer assertion would be the stochastic-gate
        # trap). This is the branch that would have caught the Thinking… leak had it existed sooner.
        have = subprocess.run(["bash", "-c",
                               "command -v ollama >/dev/null 2>&1 && ollama list 2>/dev/null"],
                              capture_output=True, text=True, timeout=30)
        if have.returncode == 0 and "gemma4:e2b" in have.stdout and (BIN / "mesh-clear").exists():
            ev = ("fixed foo.py and ran its tests green; next: none\n=== SCROLLBACK ===\n"
                  "$ hx foo.py\n$ ./foo.py --test\nok")
            v = _gate_cover_verdict(ev, "gemma4:e2b-it-qat")
            if v not in ("YES", "NO", "UNSURE"):
                print(f"  FAIL: real coverage classify returned an unparseable verdict {v!r}"); f = 1
            else:
                print(f"  coverage real model-path ok: deployed classify judged a real case (verdict={v})")
        else:
            print("  n/a: gemma4/ollama/mesh-clear absent — real coverage model-path call skipped")
    except FileNotFoundError as e:
        print(f"  n/a: {e} — coverage extraction/harness gates skipped")

    print("smoke-test: ok" if f == 0 else "smoke-test: FAIL")
    return f


if __name__ == "__main__":
    if sys.argv[1:2] == ["--test"]:
        sys.exit(run_test())
    if len(sys.argv) < 3:
        print("usage: mesh-model-bench <organ> <model> [--fixture <id>] [--consumer <name>]", file=sys.stderr)
        print(f"       stt candidates:      {' '.join(STT_CANDIDATES)}", file=sys.stderr)
        print(f"       tts candidates:      {' '.join(TTS_CANDIDATES)}", file=sys.stderr)
        print(f"       wake candidates:     {' '.join(WAKE_CANDIDATES)}", file=sys.stderr)
        print(f"       coverage candidates: {' '.join(COVERAGE_CANDIDATES)}", file=sys.stderr)
        sys.exit(2)
    organ, model = sys.argv[1], sys.argv[2]
    # the default fixture is organ-specific: tts renders an authored text, stt reads a recorded
    # wav, wake judges a labeled corpus through the deployed gate, coverage judges handoff<->scrollback.
    default_fx = {"tts": "tts-ru-authored-01", "wake": "wakegate-ru-01",
                  "coverage": "coverage-ru-01"}.get(organ, "stt-ru-operator-0812")
    fixture = sys.argv[sys.argv.index("--fixture") + 1] if "--fixture" in sys.argv else default_fx
    consumer = sys.argv[sys.argv.index("--consumer") + 1] if "--consumer" in sys.argv else "-"
    try:
        if organ == "tts":
            row, text = bench_tts(model, fixture, consumer)
        elif organ == "wake":
            row, text = bench_wake(model, fixture, consumer)
        elif organ == "coverage":
            row, text = bench_cover(model, fixture, consumer)
        else:
            row, text = bench(organ, model, fixture, consumer)
    except FileNotFoundError as e:
        print(f"n/a: {e}", file=sys.stderr)   # honest n/a — organ absent, not a fake green
        sys.exit(2)
    except (RuntimeError, KeyError) as e:
        print(f"FAIL: {e}", file=sys.stderr)
        sys.exit(1)
    print(row)
    print(f"  -> {text[:160]}")
