#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-cpu-demand — demand-driven CPU frequency axis.
#
# Reads the kernel's per-policy scaling_cur_freq files on demand. This is deliberately a raw
# delivered-frequency observation, not mesh-cpufreq's residency verdict. Every discovered policy
# gets a row; a policy that cannot be read is `na`, never zero-filled or omitted. The state artifact
# carries the observation timestamp and age so consumers cannot mistake a cached read for live data.
#
# Exit codes: 0 = at least one policy was read; 2 = cpufreq absent or all policy reads failed.
set -u
set -o pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_CPU_DEMAND_ROOT:-/sys/devices/system/cpu/cpufreq}"
STATE="${MESH_CPU_DEMAND_STATE:-$MESH/.cpu-demand-state}"

json_escape() {
  local s="${1:-}"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

read_rows() {
  local d name raw
  POLICIES=0; READABLE=0; SUM=0; ROWS=""
  shopt -s nullglob
  local dirs=("$ROOT"/policy*)
  shopt -u nullglob
  for d in "${dirs[@]}"; do
    [ -d "$d" ] || continue
    name="${d##*/}"
    POLICIES=$((POLICIES + 1))
    raw=""
    if [ -r "$d/scaling_cur_freq" ]; then
      raw="$(tr -d '[:space:]' <"$d/scaling_cur_freq" 2>/dev/null || true)"
    fi
    case "$raw" in
      ''|*[!0-9]*) ROWS="${ROWS}${ROWS:+$'\n'}${name}|na" ;;
      *) READABLE=$((READABLE + 1)); SUM=$((SUM + raw)); ROWS="${ROWS}${ROWS:+$'\n'}${name}|$raw" ;;
    esac
  done
  if [ "$READABLE" -gt 0 ]; then AVERAGE=$((SUM / READABLE)); else AVERAGE="na"; fi
}

emit() {
  local mode="${1:-text}" now epoch old_sig sig row first=1
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  epoch="$(date +%s)"
  old_sig=""
  [ -r "$STATE" ] && old_sig="$(sed -n 's/^signature=//p' "$STATE" | head -1)" || true
  sig="policies=$POLICIES|readable=$READABLE|average_khz=$AVERAGE|rows=$(printf '%s' "$ROWS" | sha256sum | cut -d' ' -f1)"

  mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
  {
    printf 'observed_at=%s\n' "$now"
    printf 'observed_epoch=%s\n' "$epoch"
    printf 'signature=%s\n' "$sig"
    printf 'policies=%s\nreadable=%s\naverage_khz=%s\n' "$POLICIES" "$READABLE" "$AVERAGE"
    while IFS='|' read -r name value; do
      [ -n "$name" ] || continue
      printf '%s=%s\n' "$name" "$value"
    done <<< "$ROWS"
  } > "$STATE" || return 1
  mesh-state-touch "$STATE" 2>/dev/null || true
  # --edge suppresses repeated prose, not the artifact write: the observed timestamp and mtime are
  # the liveness evidence, so a quiet unchanged reading must still refresh them.
  if [ "${EDGE:-0}" = 1 ] && [ -n "$old_sig" ] && [ "$old_sig" = "$sig" ]; then
    [ "$READABLE" -gt 0 ] && return 0
    return 2
  fi

  if [ "$mode" = json ]; then
    if [ "$READABLE" -gt 0 ]; then status=READ; else status=UNKNOWN; fi
    printf '{"status":"%s","observed_at":"%s","age_s":0,"policies":%s,"readable":%s,"average_khz":%s,"rows":[' "$status" "$now" "$POLICIES" "$READABLE" "$AVERAGE"
    while IFS='|' read -r name value; do
      [ -n "$name" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"policy":"%s","cur_khz":%s}' "$(json_escape "$name")" "$value"
    done <<< "$ROWS"
    printf ']}\n'
  else
    if [ "$READABLE" -eq 0 ]; then
      printf '[cpu-demand] UNKNOWN — %s policies discovered, none readable (age=0s)\n' "$POLICIES"
    else
      printf '[cpu-demand] READ — average=%s kHz readable=%s/%s age=0s\n' "$AVERAGE" "$READABLE" "$POLICIES"
    fi
    while IFS='|' read -r name value; do
      [ -n "$name" ] || continue
      printf '  %s cur_khz=%s\n' "$name" "$value"
    done <<< "$ROWS"
  fi
  [ "$READABLE" -gt 0 ] && return 0
  return 2
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d "${TMPDIR:-/tmp}/mesh-cpu-demand.XXXXXX")" || exit 1
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/cpufreq/policy0" "$td/cpufreq/policy1" "$td/cpufreq/policy2"
  printf '2200000\n' > "$td/cpufreq/policy0/scaling_cur_freq"
  printf '4500000\n' > "$td/cpufreq/policy1/scaling_cur_freq"
  out="$(MESH_CPU_DEMAND_ROOT="$td/cpufreq" MESH_CPU_DEMAND_STATE="$td/fixture-state" "$0" --json 2>/dev/null)" || {
    echo 'smoke-test: FAIL (fixture read)'; exit 1;
  }
  printf '%s\n' "$out" | grep -q '"policies":3' || { echo 'smoke-test: FAIL (policy count)'; exit 1; }
  printf '%s\n' "$out" | grep -q '"readable":2' || { echo 'smoke-test: FAIL (readable count)'; exit 1; }
  printf '%s\n' "$out" | grep -q 'policy2.*na' || { echo 'smoke-test: FAIL (na policy)'; exit 1; }
  printf '%s\n' "$out" | grep -q '"average_khz":3350000' || { echo 'smoke-test: FAIL (average)'; exit 1; }
  live_rc=0
  live="$(MESH_CPU_DEMAND_STATE="$td/live-state" "$0" --json 2>/dev/null)" || live_rc=$?
  case "$live_rc" in
    0) printf '%s\n' "$live" | grep -q '"readable":[1-9]' || { echo 'smoke-test: FAIL (live read empty)'; exit 1; } ;;
    2) printf '%s\n' "$live" | grep -q 'UNKNOWN\|OFFLINE' || { echo 'smoke-test: FAIL (live absence not honest)'; exit 1; } ;;
    *) echo "smoke-test: FAIL (live rc=$live_rc)"; exit 1 ;;
  esac
  if [ "$live_rc" = 2 ]; then echo "smoke-test: n/a (cpufreq scaling_cur_freq unavailable on $(hostname); fixture + live gate passed)"; exit 2; fi
  echo 'smoke-test: ok (fixture per-policy read + unreadable=na + REAL scaling_cur_freq read)'
  exit 0
fi

EDGE=0; JSON=0
for arg in "$@"; do case "$arg" in --edge) EDGE=1;; --json) JSON=1;; esac; done
read_rows
if [ "$JSON" = 1 ]; then emit json; else emit text; fi
