#!/usr/bin/env bash
# mesh-log-attest — deploy shim for the uxn log-integrity attester.
#
# The real tool lives WITH its ROM + uxncli at scripts/uxn/mesh-log-attest ($here-relative
# fletcher16.rom / bin/uxncli resolution needs the genome dir). This thin exec makes it
# PATH-visible; it stays usable ON-DEMAND for ANY append-only log (an operator/steward points it at
# the board, the trace, whatever — `mesh-log-attest [--check] <log>`).
#
# The one target it is WIRED to guard is ~/.mesh/clear-log.jsonl — the /clear ledger CLAUDE.md tells
# the operator to trust "by numbers, not blind". That ledger is genuinely append-only (mesh-clear-log
# is its single writer, open(...,"a"); mesh-clear-audit/mesh-mind-compact only read it), so a moved
# prefix is real corruption, not a windowing artifact. --alert runs the default attest daily (advances
# the mark on clean, posts a board [alert] only on TAMPER, silent otherwise). NOTE: chat.log is NOT a
# valid target — it is a sorted sliding window (mesh-chat-sync sort -u | tail -3000) that false-TAMPERs
# within minutes; that retarget is why this guard points at clear-log.jsonl instead.
# reflex-cadence: 17 4 * * *
# reflex-args: --alert $HOME/.mesh/clear-log.jsonl
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-log-attest"
[ -x "$TARGET" ] || { echo "mesh-log-attest: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
