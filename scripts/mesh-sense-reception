#!/usr/bin/env bash
# mesh-sense-reception — the RECEPTION plane: does a consumer render the sign its producer EMITTED?
# orphan-ok: on-demand audit — read-only, runs live consumers; invoked by a mind or a sweep, not cron.
#
#   mesh-sense-reception          report every declared producer->consumer edge (read-only)
#   mesh-sense-reception --json   same, one JSON object per edge
#   mesh-sense-reception --test   fixture-driven gate, seen RED on the live fault shape
#
# ── WHY THIS PLANE EXISTS (gen-pair mesh-sensorium x mesh-sense-monitor, discover 2026-08-21) ────────
# mesh-sensorium --articulation already checks a sense's CONTENT plane (the producer's reading LOG)
# against its EXPRESSION plane (the .state sign consumers act on). Nobody checked the third plane:
# RECEPTION — what the consumer ACTUALLY RENDERED and fused. That is the plane the mind reads off the
# pane and the plane every downstream verdict is built from, and the two tools that fuse this node's
# senses disagreed about the same producer in the same instant:
#
#   20:32:21Z  mesh-sensorium --cached  ->  motion=OFFLINE (fresh)       [field 2 of .body-motion-state]
#   20:32:24Z  mesh-sense-monitor       ->  body=STILL steps=0           [grep of the producer's stdout]
#                                       ->  activity: QUIET - body=STILL + quiet audio -> still/calm
#                                           with body ABSENT from its own degraded=[wifi:unreachable]
#
# CAUSE (measured, not inferred). mesh-body-motion runs a HYSTERESIS: while a new classification is
# still debouncing it EMITS the held state and NAMES the candidate it is holding back, in prose:
#   OFFLINE HELD - hyst=1/2 holding previous state; raw candidate [body-still] STILL: flat face-up ...
# and it writes the same split into the state file, `|OFFLINE|1|[body-still]|569448|0`
# (steps|TAG|hyst|PENDING|dwell|changes). Consumers then pick the PENDING candidate out of either
# surface and act on it as if it were the emitted sign:
#   mesh-motion-type    greps  \[body-[a-z]+\]   over the producer's stdout   -> STILL
#   mesh-room-activity  does   case *STILL*)     over the whole stdout line   -> STILL, body_reach=1
#   mesh-rhythm-state   greps  \[body-[a-z]+\]   over state-file LINE 1        -> "body still"
# None of the three has an OFFLINE arm. The debounce exists precisely so consumers do NOT act on the
# held-back candidate; every one of these parsers walks around it. (mesh-body-context is the control:
# it renders UNKNOWN and is the reason this check is not vacuously red.)
#
# WHAT THE CHECK IS. Per edge: the producer's EMITTED sign (a named state-file FIELD, never a
# substring of the line) vs the consumer's RENDERED value, with a signed verdict:
#   FABRICATED  producer emitted a not-a-reading (OFFLINE/UNKNOWN); consumer rendered a real value.
#               The dangerous direction - a dead sense becomes a plausible constant downstream.
#   LOST        producer emitted a real value; consumer rendered a not-a-reading. Blind, not lying.
#   MISMATCH    both real, different words.
#   AGREE       both the same, or both a not-a-reading.
#   n/a         the sign is STALE, or absent, or the consumer is absent / its field unparsed.
# Judged ONLY while the sign is FRESH (mtime age <= MAX_AGE, default 2x the producer's 10m cadence).
# A stale sign renders n/a and is NEVER counted as agreement - an old sign and a fresh render
# legitimately differ, and scoring that as a pass is the silent-fallback failure one ring out.
# LIMIT (measured, do not read past it): this is a ONE-SHOT, per-sample verdict. Where the producer
# itself alternates, so does the edge — mesh-room-activity read FABRICATED at 20:39:51Z, AGREE at
# 20:42:02Z and FABRICATED again seconds later, because each run re-invokes mesh-body-motion and lands
# on a different sample. That is not flapping in the check; it is the producer's own population, and
# on this node it is 1050 log lines = 513 'phone unreachable' (honest n/a) + 278 'OFFLINE HELD' (the
# divergent shape) + 0 clean emitted readings. So a single AGREE here is NOT evidence an edge is sound
# — only a FABRICATED/LOST is evidence, and the base rate belongs in any claim made off this tool.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MAX_AGE="${MESH_RECEPTION_MAX_AGE:-1200}"   # 2x mesh-body-motion's `# reflex-cadence: 7-59/10`

# A "not-a-reading" word: the producer or consumer is declaring it does not have the fact.
_notread() {
  case "${1:-}" in
    ''|OFFLINE|UNKNOWN|UNREACHABLE|DEGRADED|NA|N/A|NONE|'?') return 0 ;;
    *) return 1 ;;
  esac
}

# ── EDGE TABLE ──────────────────────────────────────────────────────────────────────────────────────
# label <TAB> state-file <TAB> field <TAB> vocab <TAB> consumer command <TAB> extractor pipeline
# The field number is load-bearing: reading the sign as a FIELD is exactly what the broken consumers
# do not do. The extractor runs on the consumer's stdout and must print ONE bare token (or nothing).
#
# `vocab` is the honesty column, and it was forced by the gate: leg 2 of --test failed on its first
# run because mesh-body-context renders RESTING where the producer emits STILL. That is a SYNONYM in
# a foreign vocabulary, not a divergence — scoring it as one would have made this check a generator
# of false findings against every consumer that names things in its own words.
#   own      the consumer renders the producer's OWN tokens (STILL/CARRIED/HANDLED/COVERED), so a
#            word-vs-word comparison is meaningful and a difference is a real MISMATCH.
#   foreign  the consumer re-words the sign. Only the POLARITY is judged — reading vs not-a-reading,
#            which is vocabulary-independent — and two real words render POLARITY-OK, never MISMATCH.
# FABRICATED and LOST apply to BOTH kinds: they are polarity verdicts. Do NOT "fix" a foreign edge by
# hand-maintaining a synonym map here — a table of another tool's words is a constant that outlives
# its reader, and the polarity check is the part that carries the finding.
_edges() {
  cat <<'EOF'
body-motion -> motion-type	.body-motion-state	2	own	timeout 30 mesh-motion-type	grep -oE 'body=[A-Za-z?-]+' | head -1 | cut -d= -f2
body-motion -> room-activity	.body-motion-state	2	own	timeout 60 mesh-room-activity	grep -oE 'body=[A-Za-z?-]+\(' | head -1 | cut -d= -f2 | tr -d '('
body-motion -> rhythm-state	.body-motion-state	2	own	timeout 30 mesh-rhythm-state	grep -oiE 'body (still|walking|handled|carried|covered)' | head -1 | awk '{print toupper($2)}'
body-motion -> body-context	.body-motion-state	2	foreign	timeout 30 mesh-body-context	grep -oE '\[body-context\] [A-Z-]+' | head -1 | awk '{print $2}'
EOF
}

# ── one edge -> "verdict<TAB>emitted<TAB>received<TAB>note" ─────────────────────────────────────────
_check_edge() {
  local sfile="$1" field="$2" vocab="$3" cmd="$4" extract="$5"
  local path="$HOME/.mesh/$sfile" emitted received age out

  [ -f "$path" ] || { printf 'n/a\t-\t-\tno sign artifact (%s)\n' "$path"; return; }
  age=$(( $(date +%s) - $(stat -c %Y "$path" 2>/dev/null || echo 0) ))
  emitted="$(head -1 "$path" 2>/dev/null | cut -d'|' -f"$field")"
  if [ "$age" -gt "$MAX_AGE" ]; then
    printf 'n/a\t%s\t-\tsign aged %ss > %ss — not judged (an old sign vs a fresh render is not a divergence)\n' \
      "${emitted:-<empty>}" "$age" "$MAX_AGE"; return
  fi

  local bin="${cmd##* }"; bin="$(printf '%s' "$cmd" | awk '{print $NF}')"
  command -v "$bin" >/dev/null 2>&1 || { printf 'n/a\t%s\t-\tconsumer %s absent from PATH\n' "${emitted:-<empty>}" "$bin"; return; }

  out="$(eval "$cmd" 2>/dev/null)"
  received="$(printf '%s\n' "$out" | eval "$extract" 2>/dev/null | tr -d '\n')"
  received="$(printf '%s' "$received" | tr '[:lower:]' '[:upper:]')"
  if [ -z "$received" ]; then
    printf 'n/a\t%s\t-\tconsumer field unparsed (rendered nothing this extractor could read)\n' "${emitted:-<empty>}"; return
  fi

  local e="$(printf '%s' "$emitted" | tr '[:lower:]' '[:upper:]')"
  if _notread "$e"; then
    if _notread "$received"; then printf 'AGREE\t%s\t%s\tboth decline the fact\n' "${e:-<empty>}" "$received"
    else printf 'FABRICATED\t%s\t%s\tconsumer rendered a reading the producer is NOT emitting (fresh %ss)\n' "${e:-<empty>}" "$received" "$age"; fi
  else
    if _notread "$received"; then printf 'LOST\t%s\t%s\tconsumer blind to a sign the producer IS emitting (fresh %ss)\n' "$e" "$received" "$age"
    elif [ "$e" = "$received" ]; then printf 'AGREE\t%s\t%s\tsame word\n' "$e" "$received"
    elif [ "$vocab" = foreign ]; then printf 'POLARITY-OK\t%s\t%s\tboth a real reading; words not comparable (foreign vocabulary)\n' "$e" "$received"
    else printf 'MISMATCH\t%s\t%s\tboth real, different words (fresh %ss)\n' "$e" "$received" "$age"; fi
  fi
}

_report() {
  local mode="$1" fab=0 lost=0 mis=0 agree=0 na=0 total=0
  [ "$mode" = json ] || printf '=== sense reception (EXPRESSION vs RECEPTION) @ %s ===\n' "$(date -u +%FT%TZ)"
  local label sfile field vocab cmd extract row verdict emitted received note
  while IFS=$'\t' read -r label sfile field vocab cmd extract; do
    [ -n "$label" ] || continue
    total=$((total+1))
    row="$(_check_edge "$sfile" "$field" "$vocab" "$cmd" "$extract")"
    IFS=$'\t' read -r verdict emitted received note <<<"$row"
    case "$verdict" in
      FABRICATED) fab=$((fab+1)) ;; LOST) lost=$((lost+1)) ;; MISMATCH) mis=$((mis+1)) ;;
      AGREE|POLARITY-OK) agree=$((agree+1)) ;; *) na=$((na+1)) ;;
    esac
    if [ "$mode" = json ]; then
      printf '{"edge":"%s","verdict":"%s","emitted":"%s","received":"%s","note":"%s"}\n' \
        "$label" "$verdict" "$emitted" "$received" "$note"
    else
      printf '  %-30s emitted=%-10s received=%-10s %-11s %s\n' "$label" "$emitted" "$received" "$verdict" "$note"
    fi
  done < <(_edges)
  [ "$mode" = json ] || printf 'edges=%s  FABRICATED=%s LOST=%s MISMATCH=%s AGREE=%s n/a=%s\n' \
    "$total" "$fab" "$lost" "$mis" "$agree" "$na"
  [ $((fab+lost+mis)) -eq 0 ]
}

# ── --test: the gate must be SEEN RED on the real fault shape ───────────────────────────────────────
# Three legs under a throwaway HOME. Stubs go in $FIX/.local/bin — which every mesh tool PREPENDS to
# PATH itself (`export PATH="$HOME/.local/bin:$PATH"`), so the real consumers on the outer PATH run
# unmodified against a stubbed PRODUCER. Never write a stub into the real ~/.local/bin: a stub that
# follows a symlink destroys the tool under test (catalogued).
if [ "${1:-}" = --test ]; then
  command -v mesh-motion-type >/dev/null 2>&1 || { echo "smoke-test: n/a (mesh-motion-type absent — nothing to receive)"; exit 2; }
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  FIX="$(mktemp -d)"; trap 'rm -rf "$FIX"' EXIT INT TERM   # TERM too: an exit-only trap leaks (catalogued)
  mkdir -p "$FIX/.mesh" "$FIX/.local/bin"
  for s in mesh-gyro mesh-light mesh-wifi-motion mesh-presence mesh-ambient-level; do
    printf '#!/bin/sh\nexit 1\n' > "$FIX/.local/bin/$s"; chmod +x "$FIX/.local/bin/$s"
  done
  _stub_body() { printf '#!/bin/sh\nprintf "%%s\\n" %q\nexit 0\n' "$1" > "$FIX/.local/bin/mesh-body-motion"
                 chmod +x "$FIX/.local/bin/mesh-body-motion"; }
  fail=0

  # LEG 1 (RED) — the live shape measured 2026-08-21: emitted sign OFFLINE, candidate named in prose.
  printf '|OFFLINE|1|[body-still]|569448|0\n' > "$FIX/.mesh/.body-motion-state"
  _stub_body 'OFFLINE HELD — hyst=1/2 holding previous state; raw candidate [body-still] STILL: flat face-up, at rest | lux=173 prox=5 steps=None(Δ?) linaccel=0.04 az=11 conf=0.85(high)'
  out1="$(HOME="$FIX" bash "$SELF" 2>&1)"; rc1=$?
  if printf '%s' "$out1" | grep -q 'motion-type.*FABRICATED' && [ "$rc1" != 0 ]; then
    echo "  ok: RED on the live shape — emitted OFFLINE, motion-type rendered STILL, rc=$rc1"
  else
    echo "  FAIL: the fault shape did not go red (rc=$rc1)"; printf '%s\n' "$out1" | sed 's/^/    /'; fail=1
  fi

  # LEG 2 (GREEN) — a producer NOT under hysteresis: emitted sign and rendered word are the same.
  printf '12345|STILL|2||100|3\n' > "$FIX/.mesh/.body-motion-state"
  _stub_body '[body-still] STILL: flat face-up, at rest | lux=173 prox=5 steps=12345(Δ+0) conf=0.85(high)'
  out2="$(HOME="$FIX" bash "$SELF" 2>&1)"; rc2=$?
  if printf '%s' "$out2" | grep -q 'motion-type.*emitted=STILL *received=STILL *AGREE' && [ "$rc2" = 0 ]; then
    echo "  ok: GREEN when the consumer renders the emitted sign (rc=0)"
  else
    echo "  FAIL: a clean edge did not read AGREE (rc=$rc2)"; printf '%s\n' "$out2" | sed 's/^/    /'; fail=1
  fi

  # LEG 3 — polarity: emitted real, consumer blind => LOST, not AGREE. Proves the check is SIGNED and
  # cannot be satisfied by a consumer that simply says nothing.
  printf '12345|WALKING|2||100|3\n' > "$FIX/.mesh/.body-motion-state"
  _stub_body 'phone unreachable'
  out3="$(HOME="$FIX" bash "$SELF" 2>&1)"; rc3=$?
  if printf '%s' "$out3" | grep -qE 'motion-type.*(LOST|MISMATCH)' && [ "$rc3" != 0 ]; then
    echo "  ok: SIGNED — a consumer blind to a live sign is LOST/MISMATCH, not AGREE (rc=$rc3)"
  else
    echo "  FAIL: emitted WALKING with a blind consumer did not go red (rc=$rc3)"; printf '%s\n' "$out3" | sed 's/^/    /'; fail=1
  fi

  # LEG 4 — the staleness gate: the SAME red shape as leg 1, but with an aged sign, must render n/a
  # and NOT be scored. Without this the check would manufacture findings out of ordinary cache age.
  printf '|OFFLINE|1|[body-still]|569448|0\n' > "$FIX/.mesh/.body-motion-state"
  touch -d '3 hours ago' "$FIX/.mesh/.body-motion-state"
  _stub_body 'OFFLINE HELD — hyst=1/2 holding previous state; raw candidate [body-still] STILL: at rest'
  out4="$(HOME="$FIX" bash "$SELF" 2>&1)"; rc4=$?
  if printf '%s' "$out4" | grep -q 'motion-type.*n/a.*sign aged' && [ "$rc4" = 0 ]; then
    echo "  ok: an ALREADY-RED shape renders n/a when the sign is stale (not judged, not passed)"
  else
    echo "  FAIL: the staleness gate did not hold (rc=$rc4)"; printf '%s\n' "$out4" | sed 's/^/    /'; fail=1
  fi

  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

case "${1:-}" in
  --json) _report json ;;
  *)      _report text ;;
esac
