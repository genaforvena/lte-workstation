#!/usr/bin/env bash
# mesh-sense-reception — the RECEPTION plane: does a consumer render the sign its producer EMITTED?
# orphan-ok: on-demand audit — read-only, runs live consumers; invoked by a mind or a sweep, not cron.
#
#   mesh-sense-reception          report every declared producer->consumer edge (read-only)
#   mesh-sense-reception --json   same, one JSON object per edge
#   mesh-sense-reception --test   fixture-driven gate, seen RED on the live fault shape
#
# ── WHY THIS PLANE EXISTS (gen-pair mesh-sensorium x mesh-sense-monitor, discover 2026-08-21) ────────
# mesh-sensorium --articulation already checks a sense's CONTENT plane (the producer's reading LOG)
# against its EXPRESSION plane (the .state sign consumers act on). Nobody checked the third plane:
# RECEPTION — what the consumer ACTUALLY RENDERED and fused. That is the plane the mind reads off the
# pane and the plane every downstream verdict is built from, and the two tools that fuse this node's
# senses disagreed about the same producer in the same instant:
#
#   20:32:21Z  mesh-sensorium --cached  ->  motion=OFFLINE (fresh)       [field 2 of .body-motion-state]
#   20:32:24Z  mesh-sense-monitor       ->  body=STILL steps=0           [grep of the producer's stdout]
#                                       ->  activity: QUIET - body=STILL + quiet audio -> still/calm
#                                           with body ABSENT from its own degraded=[wifi:unreachable]
#
# CAUSE (measured, not inferred). mesh-body-motion runs a HYSTERESIS: while a new classification is
# still debouncing it EMITS the held state and NAMES the candidate it is holding back, in prose:
#   OFFLINE HELD - hyst=1/2 holding previous state; raw candidate [body-still] STILL: flat face-up ...
# and it writes the same split into the state file, `|OFFLINE|1|[body-still]|569448|0`
# (steps|TAG|hyst|PENDING|dwell|changes). Consumers then pick the PENDING candidate out of either
# surface and act on it as if it were the emitted sign:
#   mesh-motion-type    greps  \[body-[a-z]+\]   over the producer's stdout   -> STILL
#   mesh-room-activity  does   case *STILL*)     over the whole stdout line   -> STILL, body_reach=1
#   mesh-rhythm-state   greps  \[body-[a-z]+\]   over state-file LINE 1        -> "body still"
# None of the three has an OFFLINE arm. The debounce exists precisely so consumers do NOT act on the
# held-back candidate; every one of these parsers walks around it. (mesh-body-context is the control:
# it renders UNKNOWN and is the reason this check is not vacuously red.)
#
# WHAT THE CHECK IS. Per edge: the producer's EMITTED sign (a named state-file FIELD, never a
# substring of the line) vs the consumer's RENDERED value, with a signed verdict:
#   FABRICATED  producer emitted a not-a-reading (OFFLINE/UNKNOWN); consumer rendered a real value.
#               The dangerous direction - a dead sense becomes a plausible constant downstream.
#   LOST        producer emitted a real value; consumer rendered a not-a-reading. Blind, not lying.
#   MISMATCH    both real, different words.
#   AGREE       both the same, or both a not-a-reading.
#   n/a         the sign is STALE, or absent, or the consumer is absent / its field unparsed.
# Judged ONLY while the sign is FRESH (mtime age <= MAX_AGE, default 2x the producer's 10m cadence).
# A stale sign renders n/a and is NEVER counted as agreement - an old sign and a fresh render
# legitimately differ, and scoring that as a pass is the silent-fallback failure one ring out.
# LIMIT (measured, do not read past it): this is a ONE-SHOT, per-sample verdict. Where the producer
# itself alternates, so does the edge — mesh-room-activity read FABRICATED at 20:39:51Z, AGREE at
# 20:42:02Z and FABRICATED again seconds later, because each run re-invokes mesh-body-motion and lands
# on a different sample. That is not flapping in the check; it is the producer's own population, and
# on this node it is 1050 log lines = 513 'phone unreachable' (honest n/a) + 278 'OFFLINE HELD' (the
# divergent shape) + 0 clean emitted readings. So a single AGREE here is NOT evidence an edge is sound
# — only a FABRICATED/LOST is evidence, and the base rate belongs in any claim made off this tool.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MAX_AGE="${MESH_RECEPTION_MAX_AGE:-1200}"   # 2x mesh-body-motion's `# reflex-cadence: 7-59/10`

# A "not-a-reading" word: the producer or consumer is declaring it does not have the fact.
_notread() {
  case "${1:-}" in
    ''|OFFLINE|UNKNOWN|UNREACHABLE|UNREACH|DEGRADED|NA|N/A|NONE|OTHER|'?') return 0 ;;
    *) return 1 ;;
  esac
}

# ── EDGE TABLE ──────────────────────────────────────────────────────────────────────────────────────
# label <TAB> state-file <TAB> field <TAB> vocab <TAB> consumer command <TAB> extractor pipeline
# The field number is load-bearing: reading the sign as a FIELD is exactly what the broken consumers
# do not do. The extractor runs on the consumer's stdout and must print ONE bare token (or nothing).
#
# `vocab` is the honesty column, and it was forced by the gate: leg 2 of --test failed on its first
# run because mesh-body-context renders RESTING where the producer emits STILL. That is a SYNONYM in
# a foreign vocabulary, not a divergence — scoring it as one would have made this check a generator
# of false findings against every consumer that names things in its own words.
#   own      the consumer renders the producer's OWN tokens (STILL/CARRIED/HANDLED/COVERED), so a
#            word-vs-word comparison is meaningful and a difference is a real MISMATCH.
#   foreign  the consumer re-words the sign. Only the POLARITY is judged — reading vs not-a-reading,
#            which is vocabulary-independent — and two real words render POLARITY-OK, never MISMATCH.
# FABRICATED and LOST apply to BOTH kinds: they are polarity verdicts. Do NOT "fix" a foreign edge by
# hand-maintaining a synonym map here — a table of another tool's words is a constant that outlives
# its reader, and the polarity check is the part that carries the finding.
_edges() {
  # OVERRIDABLE FOR --test. The gate on THIS CHECK must not depend on a live consumer still being
  # BROKEN: legs 1-4 used to drive mesh-motion-type, so repairing mesh-motion-type turned the
  # check's own --test red — a gate that fails when the world gets better, and one that would have
  # pushed the next mind to "fix" the check by reverting the consumer. Those legs now drive stub
  # consumers through this override; leg 5 drives the REAL table below against the live ones.
  if [ -n "${MESH_RECEPTION_EDGES:-}" ] && [ -f "${MESH_RECEPTION_EDGES}" ]; then
    cat "$MESH_RECEPTION_EDGES"; return
  fi
  cat <<'EOF'
body-motion -> motion-type	.body-motion-state	2	own	timeout 30 mesh-motion-type	grep -oE 'body=[A-Za-z?-]+' | head -1 | cut -d= -f2
body-motion -> room-activity	.body-motion-state	2	own	timeout 60 mesh-room-activity	grep -oE 'body=[A-Za-z?-]+\(' | head -1 | cut -d= -f2 | tr -d '('
body-motion -> rhythm-state	.body-motion-state	2	own	timeout 30 mesh-rhythm-state	grep -oiE 'body[ =](still|walking|handled|carried|covered|offline)' | head -1 | sed -E 's/^[Bb]ody[ =]//'
body-motion -> body-context	.body-motion-state	2	foreign	timeout 30 mesh-body-context	grep -oE '\[body-context\] [A-Z-]+' | head -1 | awk '{print $2}'
body-motion -> occupancy-kind	.body-motion-state	2	foreign	timeout 45 mesh-occupancy-kind --json	grep -oE '"motion":"[^"]*"' | head -1 | cut -d'"' -f4
body-motion -> window-state	.body-motion-state	2	foreign	timeout 45 mesh-window-state --json	grep -oE '"body":"[^"]*"' | head -1 | cut -d'"' -f4
body-motion -> physical-context	.body-motion-state	2	own	timeout 45 mesh-physical-context --json	grep -oE '"motion":"[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^body-//'
body-motion -> motion-fuse	.body-motion-state	2	foreign	timeout 45 mesh-motion-fuse --json	grep -oE '"body":"[^"]*"' | head -1 | cut -d'"' -f4
body-motion -> social-context	.body-motion-state	2	own	timeout 45 mesh-social-context	grep -oE 'body=[A-Za-z?-]+' | head -1 | cut -d= -f2
EOF
}

# ── one edge -> "verdict<TAB>emitted<TAB>received<TAB>note" ─────────────────────────────────────────
_check_edge() {
  local sfile="$1" field="$2" vocab="$3" cmd="$4" extract="$5"
  local path="$HOME/.mesh/$sfile" emitted received age out

  [ -f "$path" ] || { printf 'n/a\t-\t-\tno sign artifact (%s)\n' "$path"; return; }
  age=$(( $(date +%s) - $(stat -c %Y "$path" 2>/dev/null || echo 0) ))
  emitted="$(head -1 "$path" 2>/dev/null | cut -d'|' -f"$field")"
  if [ "$age" -gt "$MAX_AGE" ]; then
    printf 'n/a\t%s\t-\tsign aged %ss > %ss — not judged (an old sign vs a fresh render is not a divergence)\n' \
      "${emitted:-<empty>}" "$age" "$MAX_AGE"; return
  fi

  # The consumer binary is the FIRST word after any `timeout <n>` prefix — never the LAST word,
  # which the previous `awk '{print $NF}'` took: it works only while every command happens to end
  # in its own name, and the first edge carrying a flag (`... mesh-occupancy-kind --json`) made it
  # probe `command -v --json`, rendering a silent n/a "consumer absent" for a consumer that is
  # installed. An n/a is exactly the verdict a broken edge should not be able to wear.
  local bin; bin="$(printf '%s' "$cmd" | sed -E 's/^[[:space:]]*timeout[[:space:]]+[0-9]+[[:space:]]+//' | awk '{print $1}')"
  command -v "$bin" >/dev/null 2>&1 || { printf 'n/a\t%s\t-\tconsumer %s absent from PATH\n' "${emitted:-<empty>}" "$bin"; return; }

  out="$(eval "$cmd" 2>/dev/null)"
  received="$(printf '%s\n' "$out" | eval "$extract" 2>/dev/null | tr -d '\n')"
  received="$(printf '%s' "$received" | tr '[:lower:]' '[:upper:]')"
  if [ -z "$received" ]; then
    printf 'n/a\t%s\t-\tconsumer field unparsed (rendered nothing this extractor could read)\n' "${emitted:-<empty>}"; return
  fi

  # The producer spells its sign BRACKETED and TAG-PREFIXED in the state file (`[body-still]`)
  # while consumers render the bare word (`STILL`). That is one sign in two spellings, not a
  # divergence — unwrap it, or every clean sample reads MISMATCH and the check becomes a generator
  # of false findings. This was invisible until the new edges landed because leg 2's fixture was
  # hand-written in the PARSER's preferred spelling (`12345|STILL|2||100|3`) rather than the
  # producer's real live line; the fixture is corrected below.
  local e="$emitted"
  case "$e" in '[body-'*']') e="${e#[}"; e="${e%]}"; e="${e#*-}" ;; esac
  e="$(printf '%s' "$e" | tr '[:lower:]' '[:upper:]')"
  if _notread "$e"; then
    if _notread "$received"; then printf 'AGREE\t%s\t%s\tboth decline the fact\n' "${e:-<empty>}" "$received"
    else printf 'FABRICATED\t%s\t%s\tconsumer rendered a reading the producer is NOT emitting (fresh %ss)\n' "${e:-<empty>}" "$received" "$age"; fi
  else
    if _notread "$received"; then printf 'LOST\t%s\t%s\tconsumer blind to a sign the producer IS emitting (fresh %ss)\n' "$e" "$received" "$age"
    elif [ "$e" = "$received" ]; then printf 'AGREE\t%s\t%s\tsame word\n' "$e" "$received"
    elif [ "$vocab" = foreign ]; then printf 'POLARITY-OK\t%s\t%s\tboth a real reading; words not comparable (foreign vocabulary)\n' "$e" "$received"
    else printf 'MISMATCH\t%s\t%s\tboth real, different words (fresh %ss)\n' "$e" "$received" "$age"; fi
  fi
}

_report() {
  local mode="$1" fab=0 lost=0 mis=0 agree=0 na=0 total=0
  [ "$mode" = json ] || printf '=== sense reception (EXPRESSION vs RECEPTION) @ %s ===\n' "$(date -u +%FT%TZ)"
  local label sfile field vocab cmd extract row verdict emitted received note
  while IFS=$'\t' read -r label sfile field vocab cmd extract; do
    [ -n "$label" ] || continue
    total=$((total+1))
    row="$(_check_edge "$sfile" "$field" "$vocab" "$cmd" "$extract")"
    IFS=$'\t' read -r verdict emitted received note <<<"$row"
    case "$verdict" in
      FABRICATED) fab=$((fab+1)) ;; LOST) lost=$((lost+1)) ;; MISMATCH) mis=$((mis+1)) ;;
      AGREE|POLARITY-OK) agree=$((agree+1)) ;; *) na=$((na+1)) ;;
    esac
    if [ "$mode" = json ]; then
      printf '{"edge":"%s","verdict":"%s","emitted":"%s","received":"%s","note":"%s"}\n' \
        "$label" "$verdict" "$emitted" "$received" "$note"
    else
      printf '  %-30s emitted=%-10s received=%-10s %-11s %s\n' "$label" "$emitted" "$received" "$verdict" "$note"
    fi
  done < <(_edges)
  [ "$mode" = json ] || printf 'edges=%s  FABRICATED=%s LOST=%s MISMATCH=%s AGREE=%s n/a=%s\n' \
    "$total" "$fab" "$lost" "$mis" "$agree" "$na"
  [ $((fab+lost+mis)) -eq 0 ]
}

# ── --test: two gates, deliberately separated ───────────────────────────────────────────────────────
# LEGS 1-4 gate THE CHECK — can it tell FABRICATED from AGREE from LOST, and does it decline a stale
#   sign? They run against STUB consumers via MESH_RECEPTION_EDGES. They used to drive the live
#   mesh-motion-type, which meant repairing that consumer turned this --test RED: a gate that fails
#   when the world gets better is a gate that argues for reverting the fix.
# LEG 5 gates THE CONSUMERS — the real edge table, real consumers, a stubbed producer, in BOTH
#   polarities: the hysteresis shape must not be received as a reading (FABRICATED), and a clean
#   emitted reading must still arrive (LOST). One polarity alone is not a gate — blinding every
#   consumer would pass the first and fail nothing.
# Stubs go in $FIX/.local/bin, which every mesh tool PREPENDS to PATH itself, so real consumers on
# the outer PATH run unmodified against a stubbed PRODUCER. Never write a stub into the real
# ~/.local/bin: a stub that follows a symlink destroys the tool under test (catalogued).
if [ "${1:-}" = --test ]; then
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  FIX="$(mktemp -d)"; trap 'rm -rf "$FIX"' EXIT INT TERM   # TERM too: an exit-only trap leaks (catalogued)
  mkdir -p "$FIX/.mesh" "$FIX/.local/bin"
  fail=0

  # THE PRODUCER'S TWO REAL SHAPES, copied from this node's own artifacts — not hand-written in the
  # parser's preferred spelling. The state line carries the tag BRACKETED (`[body-still]`), which an
  # invented fixture (`12345|STILL|2||100|3`) does not, and that difference is exactly what a
  # field-2 reader must survive.
  HELD_STATE='|OFFLINE|1|[body-still]|569448|0'
  HELD_LINE='OFFLINE HELD — hyst=1/2 holding previous state; raw candidate [body-still] STILL: flat face-up, at rest | lux=173 prox=5 steps=None(Δ?) linaccel=0.04 az=11 conf=0.85(high)'
  CLEAN_STATE='4213|[body-still]|0||1800|3'
  CLEAN_LINE='[body-still] STILL — flat face-up, at rest | lux=173 prox=5 steps=4213(Δ+0) linaccel=0.04 az=11 conf=0.85(high)'

  # ── stub consumers for legs 1-4: one of each verdict-shape, none of them a live tool ──
  cat > "$FIX/.local/bin/rx-fabricator" <<'RXF'
#!/bin/sh
echo "body=STILL"          # renders a reading no matter what the producer emits
RXF
  cat > "$FIX/.local/bin/rx-blind" <<'RXB'
#!/bin/sh
echo "body=UNKNOWN"        # never renders a reading, whatever the producer emits
RXB
  cat > "$FIX/.local/bin/rx-honest" <<'RXH'
#!/bin/sh
# reads the EMITTED sign as field 2 and unwraps it — the shape every fixed consumer now has
t="$(head -1 "$HOME/.mesh/.body-motion-state" 2>/dev/null | cut -d'|' -f2)"
case "$t" in '[body-'*']') t="${t#[}"; t="${t%]}"; t="${t#*-}" ;; esac
[ -n "$t" ] || t=UNKNOWN
echo "body=$t"
RXH
  chmod +x "$FIX/.local/bin/rx-fabricator" "$FIX/.local/bin/rx-blind" "$FIX/.local/bin/rx-honest"
  _stub_edges() {   # $1 = consumer binary → a one-edge table naming it
    printf 'body-motion -> %s\t.body-motion-state\t2\town\t%s\tgrep -oE "body=[A-Za-z?-]+" | head -1 | cut -d= -f2\n' \
      "$1" "$1" > "$FIX/edges.tsv"
    printf '%s' "$FIX/edges.tsv"
  }
  _run() {   # $1 = edge file, $2 = state line → sets out/rc
    printf '%s\n' "$2" > "$FIX/.mesh/.body-motion-state"
    out="$(env HOME="$FIX" MESH_RECEPTION_EDGES="$1" bash "$SELF" 2>&1)"; rc=$?
  }

  # LEG 1 (RED) — the live shape: producer emits OFFLINE, consumer renders STILL.
  _run "$(_stub_edges rx-fabricator)" "$HELD_STATE"
  if printf '%s' "$out" | grep -q 'FABRICATED' && [ "$rc" != 0 ]; then
    echo "  ok: RED — emitted OFFLINE, consumer rendered STILL, rc=$rc"
  else echo "  FAIL: the fault shape did not go red (rc=$rc)"; printf '%s\n' "$out" | sed 's/^/    /'; fail=1; fi

  # LEG 2 (GREEN) — a producer NOT under hysteresis, read as a FIELD: emitted sign == rendered word.
  _run "$(_stub_edges rx-honest)" "$CLEAN_STATE"
  if printf '%s' "$out" | grep -qE 'emitted=STILL +received=STILL +AGREE' && [ "$rc" = 0 ]; then
    echo "  ok: GREEN when the consumer renders the emitted sign (rc=0)"
  else echo "  FAIL: a clean edge did not read AGREE (rc=$rc)"; printf '%s\n' "$out" | sed 's/^/    /'; fail=1; fi

  # LEG 2b — the same honest consumer on the HELD shape must decline, not render field 4.
  _run "$(_stub_edges rx-honest)" "$HELD_STATE"
  if printf '%s' "$out" | grep -q 'AGREE' && [ "$rc" = 0 ]; then
    echo "  ok: a field-2 reader declines the held-back candidate (emitted OFFLINE → AGREE)"
  else echo "  FAIL: the honest consumer did not decline the held shape (rc=$rc)"; printf '%s\n' "$out" | sed 's/^/    /'; fail=1; fi

  # LEG 3 — polarity: emitted real, consumer blind ⇒ LOST, never AGREE. Proves the check is SIGNED
  # and cannot be satisfied by a consumer that simply says nothing — i.e. that "fix everything to
  # UNKNOWN" is not a way to pass leg 5.
  _run "$(_stub_edges rx-blind)" "$CLEAN_STATE"
  if printf '%s' "$out" | grep -qE 'LOST|MISMATCH' && [ "$rc" != 0 ]; then
    echo "  ok: SIGNED — a consumer blind to a live sign is LOST/MISMATCH, not AGREE (rc=$rc)"
  else echo "  FAIL: emitted STILL with a blind consumer did not go red (rc=$rc)"; printf '%s\n' "$out" | sed 's/^/    /'; fail=1; fi

  # LEG 4 — the staleness gate: the SAME red shape as leg 1, but with an aged sign, must render n/a
  # and NOT be scored. Without this the check would manufacture findings out of ordinary cache age.
  _run "$(_stub_edges rx-fabricator)" "$HELD_STATE"
  touch -d '3 hours ago' "$FIX/.mesh/.body-motion-state"
  out="$(env HOME="$FIX" MESH_RECEPTION_EDGES="$FIX/edges.tsv" bash "$SELF" 2>&1)"; rc=$?
  if printf '%s' "$out" | grep -q 'n/a.*sign aged' && [ "$rc" = 0 ]; then
    echo "  ok: an ALREADY-RED shape renders n/a when the sign is stale (not judged, not passed)"
  else echo "  FAIL: the staleness gate did not hold (rc=$rc)"; printf '%s\n' "$out" | sed 's/^/    /'; fail=1; fi

  # ── LEG 5: THE CONSUMER GATE — real table, real consumers, both polarities ──────────────────────
  # Every SIBLING axis is a copy of this node's own state files, kept FRESH. With a sibling stubbed
  # dark several consumers short-circuit before they ever render the body axis and the fabrication
  # hides behind an n/a — a verdict that means "not judged", which is precisely where a broken edge
  # would sit unseen. n/a is therefore counted as a FAILURE of this leg, not tolerated.
  if command -v mesh-motion-type >/dev/null 2>&1; then
    L5="$(mktemp -d)"; mkdir -p "$L5/.mesh" "$L5/.local/bin"
    cp -a "$HOME"/.mesh/.*state* "$L5/.mesh/" 2>/dev/null
    touch "$L5"/.mesh/.*state* 2>/dev/null
    printf '#!/bin/sh\nexit 0\n' > "$L5/.local/bin/mesh-state-touch"; chmod +x "$L5/.local/bin/mesh-state-touch"
    for s5 in mesh-gyro mesh-wifi-motion mesh-ambient-level mesh-audio-energy mesh-tamper mesh-peer-addr; do
      printf '#!/bin/sh\nexit 1\n' > "$L5/.local/bin/$s5"; chmod +x "$L5/.local/bin/$s5"   # no live radio from a fixture
    done
    _leg5() {   # $1 = label, $2 = stdout line, $3 = state line, $4 = "decline"|"render"
      { printf '#!/bin/sh\n'; printf 'printf "%%s\\n" %q\n' "$2"; printf 'exit 0\n'; } > "$L5/.local/bin/mesh-body-motion"
      chmod +x "$L5/.local/bin/mesh-body-motion"
      printf '%s\n' "$3" > "$L5/.mesh/.body-motion-state"
      local o r
      o="$(env HOME="$L5" bash "$SELF" 2>&1)"; r=$?
      # Assert the SUMMARY COUNTERS, never the words — the summary line itself ends in "n/a=0",
      # so a grep for the bare word `n/a` matches a report that has none and fails a passing leg.
      if [ "$r" = 0 ] && printf '%s' "$o" | grep -qE 'FABRICATED=0 LOST=0 MISMATCH=0 .*n/a=0$'; then
        echo "  ok: leg5/$1 — every declared edge ${4}s the sign (rc=0, no FABRICATED/LOST/n/a)"
      else
        echo "  FAIL: leg5/$1 — an edge did not ${4} the emitted sign (rc=$r)"
        printf '%s\n' "$o" | sed 's/^/    /'; fail=1
      fi
    }
    _leg5 held  "$HELD_LINE"  "$HELD_STATE"  decline
    _leg5 clean "$CLEAN_LINE" "$CLEAN_STATE" render
    rm -rf "$L5"
  else
    echo "  n/a: leg5 skipped — no live consumers on PATH (mesh-motion-type absent)"
  fi

  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

case "${1:-}" in
  --json) _report json ;;
  *)      _report text ;;
esac
