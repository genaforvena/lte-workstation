#!/usr/bin/env python3
"""test-voice-tx-loopback — verifiable artifact for mesh-voice-tx software loopback.

Asserts the verification principle on the voice actuator: a synthesized voice must transcribe
back to the source text (the operator's 2026-06-24 case — English read by the ru 'ruslan' voice
is gibberish, so it must be FLAGGED, not reported as rc=0 success). Exercises:
  - --test (piper smoke + loopback self-test on the configured voice)
  - --loopback "<text>" [voice]  the EN+ru=gibberish vs EN+en=ok vs RU+ru=ok cases
"""
import subprocess, sys, os

TOOL = os.path.expanduser("~/.local/bin/mesh-voice-tx")
passed = failed = skipped = 0

def run(args, env=None):
    e = dict(os.environ, **(env or {}))
    return subprocess.run([TOOL] + args, capture_output=True, text=True, env=e, timeout=180)

def loopback(phrase, voice):
    r = run(["--loopback", phrase, voice])
    return r.returncode, (r.stdout + r.stderr).strip()

print("=== mesh-voice-tx software-loopback suite ===\n")

# ── --test: piper smoke + loopback self-test on the configured (default ruslan) voice ──────────
print("--test (piper smoke + loopback self-test):")
r = run(["--test"])
out = (r.stdout + r.stderr).strip()
for ln in out.splitlines():
    print("  " + ln)
if r.returncode == 0 and ("loopback: ok" in out or "loopback: SKIP" in out):
    passed += 1; print("  [PASS]")
else:
    failed += 1; print(f"  [FAIL] exit={r.returncode}")

# ── the operator's case: EN source + ru voice = gibberish → must MISMATCH ──────────────────────
print("\nEN source + ru voice (ruslan) — must MISMATCH:")
code, out = loopback("Turn on the lights in the kitchen.", "ruslan")
print(f"  {out}")
if code == 1 and "MISMATCH" in out:
    passed += 1; print("  [PASS]")
elif "SKIP" in out and code == 0:
    skipped += 1; print("  [SKIP] whisper not available on this node")
else:
    failed += 1; print(f"  [FAIL] expected MISMATCH exit=1, got exit={code}")

# ── EN source + en voice = intelligible → must OK ─────────────────────────────────────────────
print("\nEN source + en voice (ryan) — must OK:")
code, out = loopback("Turn on the lights in the kitchen.", "ryan")
print(f"  {out}")
if code == 0 and "OK" in out and "sim=" in out:
    passed += 1; print("  [PASS]")
elif "SKIP" in out:
    skipped += 1; print("  [SKIP] whisper not available")
elif "n/a" in out and ("piper/voice" in out or "ryan" in out):
    skipped += 1; print("  [SKIP] ryan voice not installed")
else:
    failed += 1; print(f"  [FAIL] expected OK exit=0, got exit={code}")

# ── RU source + ru voice = intelligible → must OK ─────────────────────────────────────────────
print("\nRU source + ru voice (ruslan) — must OK:")
code, out = loopback("Включи свет на кухне.", "ruslan")
print(f"  {out}")
if code == 0 and "OK" in out:
    passed += 1; print("  [PASS]")
elif "SKIP" in out:
    skipped += 1; print("  [SKIP] whisper not available")
else:
    failed += 1; print(f"  [FAIL] expected OK exit=0, got exit={code}")

print(f"\n=== {passed} passed, {failed} failed, {skipped} skipped ===")
sys.exit(0 if failed == 0 else 1)
