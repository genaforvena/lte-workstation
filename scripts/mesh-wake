#!/usr/bin/env bash
# orphan-ok: on-demand LIVE-ONLY sleep/wake-cycle probe (mind/fusion-invoked; reads an INSTANTANEOUS
#   derived-from-journal state, no per-run cache to schedule — same class as mesh-jack / body-context).
# mesh-wake — when did THIS node last resume from suspend, and how many sleep/wake cycles this boot?
#
# WHY this is a NEW, distinct real-world sense (not in the existing perception set):
#   - mesh-lid       = INSTANTANEOUS lid open|closed (a state, not the sleep TRANSITION).
#   - mesh-kbd-activity / mesh-seat-presence = input/interrupt activity (a human typing NOW).
#   - mesh-node-power / mesh-clock-sync / mesh-cpu-throttle = power source / NTP / thermal counters.
#   None of them perceive the discrete SUSPEND→RESUME event: the machine went to sleep (lid shut,
#   idle-suspend, operator walked away) and later WOKE UP (lid opened, key pressed — operator returned).
#   That transition is a real-world physical signal the mesh could perceive but does not:
#       fresh resume  -> operator just returned to this machine (a coarse arrival cue)
#       never suspended this boot -> an always-on / continuously-attended node
#   A genuine usage-rhythm cue no current sense reports. It claims a MACHINE power-cycle, never a person
#   directly (an idle-timer can suspend an empty desk) — a rhythm/arrival cue, not a presence assertion.
#
# SOURCE: kernel journal `PM: suspend exit` lines (each = one RESUME) since boot, addressed by the
#   stable kernel message text; last line's epoch = last resume, line count = cycles this boot.
#   `/sys/power/state` = the capability gate (does this node support suspend at all).
#
# HONEST degradation (the no-faked-reading rule):
#   - no `/sys/power/state` (node can't suspend — many VMs/containers), OR no journalctl, OR the kernel
#     journal is not readable by this user -> EXIT 2 "UNREACHABLE" — NOT a fake AWAKE. Inability to
#     PERCEIVE the history must read visibly different from a real "never suspended". An unreachable
#     wake sense is honestly n/a, never a silent all-clear.
#   - journal readable + ZERO resume events this boot -> AWAKE (honest real empty: continuously awake).
#
# Verdicts (exit 0 = real read): AWAKE | FRESH-WAKE | WAKED ;  exit 2 = UNREACHABLE.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

FRESH_SEC="${MESH_WAKE_FRESH_SEC:-300}"   # resume younger than this -> FRESH-WAKE (operator likely back)

# human-readable age (pure, no I/O)
human(){ local s="${1:-}"; case "$s" in ''|*[!0-9]*) echo "n/a"; return;; esac
  if   [ "$s" -lt 60 ]    ; then echo "${s}s"
  elif [ "$s" -lt 3600 ]  ; then echo "$((s/60))m"
  elif [ "$s" -lt 86400 ] ; then echo "$((s/3600))h"
  else echo "$((s/86400))d"; fi; }

# pure classifier (no I/O) — token-driven so --test drives the full truth table offline
classify(){ # $1=cycles $2=age_sec(may be empty) $3=fresh_sec
  local cyc="${1:-0}" age="${2:-}" fresh="${3:-0}"
  case "$cyc" in ''|*[!0-9]*) cyc=0;; esac
  if [ "$cyc" -le 0 ]; then echo "AWAKE|no suspend/resume since boot — continuously awake"; return; fi
  if [ -n "$age" ] && case "$age" in *[!0-9]*) false;; *) [ "$age" -lt "$fresh" ];; esac; then
    echo "FRESH-WAKE|resumed from suspend just now — operator likely just returned"; return; fi
  echo "WAKED|resumed from suspend earlier this boot"
}

# probe (I/O) — echoes "cycles last_epoch" (last_epoch empty if none); caller must gate UNREACHABLE first
probe(){
  local lines n=0 last=""
  lines="$(timeout 8 journalctl -k -b --no-pager -o short-unix 2>/dev/null | grep -F 'PM: suspend exit')"
  if [ -n "$lines" ]; then
    n=$(printf '%s\n' "$lines" | grep -c .)
    last=$(printf '%s\n' "$lines" | tail -1 | awk '{print $1}' | cut -d. -f1)
  fi
  printf '%s %s\n' "$n" "$last"
}

if [ "${1:-}" = --test ]; then
  # 1) pure classifier truth-table (offline, no hardware/journal)
  c=$(classify 0 "" 300)        ; [ "${c%%|*}" = AWAKE ]      || { echo "smoke-test: FAIL (cycles=0 -> ${c%%|*}, want AWAKE)"; exit 1; }
  c=$(classify 3 60 300)        ; [ "${c%%|*}" = FRESH-WAKE ] || { echo "smoke-test: FAIL (age 60<300 -> ${c%%|*}, want FRESH-WAKE)"; exit 1; }
  c=$(classify 3 9000 300)      ; [ "${c%%|*}" = WAKED ]      || { echo "smoke-test: FAIL (age 9000 -> ${c%%|*}, want WAKED)"; exit 1; }
  c=$(classify "" "" 300)       ; [ "${c%%|*}" = AWAKE ]      || { echo "smoke-test: FAIL (garbage cycles -> ${c%%|*}, want AWAKE)"; exit 1; }
  [ "$(human 30)" = 30s ] && [ "$(human 120)" = 2m ] && [ "$(human 7200)" = 2h ] && [ "$(human 172800)" = 2d ] \
    || { echo "smoke-test: FAIL (human() age formatting)"; exit 1; }
  # 2) REAL read gate (doctrine: --test must assert a live read produces data, not just the offline
  #    classifier). If this node can't PERCEIVE sleep/wake history it is honestly UNREACHABLE -> exit 2
  #    (mesh-land treats exit 2 as a pass), never a fake green.
  [ -e /sys/power/state ] || { echo "smoke-test: n/a (no /sys/power/state — node can't suspend, UNREACHABLE)"; exit 2; }
  command -v journalctl >/dev/null 2>&1 || { echo "smoke-test: n/a (no journalctl — UNREACHABLE)"; exit 2; }
  journalctl -k -b -n0 >/dev/null 2>&1 || { echo "smoke-test: n/a (kernel journal not readable by $(id -un) — UNREACHABLE)"; exit 2; }
  read -r cyc last < <(probe)
  case "$cyc" in ''|*[!0-9]*) echo "smoke-test: FAIL (live read yielded non-integer cycles '$cyc')"; exit 1;; esac
  age=""; [ -n "$last" ] && age=$(( $(date +%s) - last ))
  v=$(classify "$cyc" "$age" "$FRESH_SEC"); v="${v%%|*}"
  case "$v" in AWAKE|FRESH-WAKE|WAKED) : ;; *) echo "smoke-test: FAIL (live verdict '$v' not in AWAKE|FRESH-WAKE|WAKED)"; exit 1 ;; esac
  echo "smoke-test: ok (4 classify truth-table + human() + live read cycles=$cyc verdict=$v age=$(human "$age"))"
  exit 0
fi

JSON=false; [ "${1:-}" = --json ] && JSON=true
host="$(hostname)"; ts="$(date -u +%FT%TZ)"

# --- UNREACHABLE gates: inability to PERCEIVE reads differently from a real AWAKE ---
fail2(){ if $JSON; then printf '{"verdict":"UNREACHABLE","cycles":null,"last_wake_iso":null,"age_sec":null,"reason":"%s","host":"%s","ts":"%s"}\n' "$1" "$host" "$ts"
         else echo "[wake] UNREACHABLE — $1 @ $host $ts"; fi; exit 2; }
[ -e /sys/power/state ]                  || fail2 "no /sys/power/state (node cannot suspend)"
command -v journalctl >/dev/null 2>&1    || fail2 "no journalctl (cannot read suspend history)"
journalctl -k -b -n0 >/dev/null 2>&1     || fail2 "kernel journal not readable by $(id -un)"

read -r cyc last < <(probe)
case "$cyc" in ''|*[!0-9]*) cyc=0;; esac
age=""; last_iso="n/a"
if [ -n "$last" ]; then age=$(( $(date +%s) - last )); last_iso="$(date -u -d "@$last" +%FT%TZ 2>/dev/null || echo n/a)"; fi

out="$(classify "$cyc" "$age" "$FRESH_SEC")"; verdict="${out%%|*}"; reason="${out#*|}"

if $JSON; then
  printf '{"verdict":"%s","cycles":%s,"last_wake_iso":"%s","age_sec":%s,"reason":"%s","host":"%s","ts":"%s"}\n' \
    "$verdict" "$cyc" "$last_iso" "${age:-null}" "$reason" "$host" "$ts"
else
  echo "[wake] $verdict — $reason [cycles=$cyc last_wake=$last_iso age=$(human "$age")] @ $host $ts"
fi
exit 0
