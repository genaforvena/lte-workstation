#!/usr/bin/env bash
# mesh-evidence-dir — resolve the node-local roots that run receipts, observation artifacts and
# scratch plans live in. They are not repo material: keeping them in the genome working tree made
# every write a landing candidate and a dirty-surface incident owned by genome, so genome landed
# them one by one (~51 genome-owned receipt/land chains on 2026-09-16).
#
# Roots (first set wins): MESH_EVIDENCE_ROOT, then $MESH_DIR/evidence, then ~/.mesh/evidence.
# Plans are their own root — MESH_PLANS_DIR, then $MESH_DIR/plans, then ~/.mesh/plans — because a
# plan is a work input to `mesh-task create <chain> <plan.tsv>`, not a receipt of finished work.
#
#   mesh-evidence-dir receipts            → the receipts root (print)
#   mesh-evidence-dir artifacts           → the artifacts root (print)
#   mesh-evidence-dir chat-range-reviews  → the chat-range review root (print)
#   mesh-evidence-dir plans               → the scratch-plan root (print)
#   mesh-evidence-dir --resolve <path>    → canonical path for a repo-relative or absolute path
#   mesh-evidence-dir --mkdir <kind>      → resolve, create it, print it
#   mesh-evidence-dir --test
#
# --resolve maps a LEGACY repo path onto the evidence root and is a pure string function: it never
# touches git, so a ledger row naming docs/task-receipts/x.md can be located without the file still
# being under the repository. A path that is not a legacy evidence path is printed unchanged, so
# callers can use it as a drop-in normaliser.
set -u -o pipefail

MESH_DIR_RESOLVED="${MESH_DIR:-$HOME/.mesh}"
EVIDENCE_ROOT="${MESH_EVIDENCE_ROOT:-$MESH_DIR_RESOLVED/evidence}"
PLANS_ROOT="${MESH_PLANS_DIR:-$MESH_DIR_RESOLVED/plans}"

usage(){
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
}

resolve_kind(){
    case "$1" in
        receipts)  printf '%s\n' "$EVIDENCE_ROOT/receipts" ;;
        artifacts) printf '%s\n' "$EVIDENCE_ROOT/artifacts" ;;
        audits)    printf '%s\n' "$EVIDENCE_ROOT/audits" ;;
        chat-range-reviews) printf '%s\n' "$EVIDENCE_ROOT/chat-range-reviews" ;;
        plans)     printf '%s\n' "$PLANS_ROOT" ;;
        *) echo "mesh-evidence-dir: unknown kind '$1' (receipts|artifacts|audits|chat-range-reviews|plans)" >&2; return 2 ;;
    esac
}

# resolve_path <path> — legacy repo evidence path → node-local evidence path, else unchanged.
# Longest-prefix first: `task-receipts/` must not be shadowed by the `docs/task-receipts/` arm,
# and both must stop at a component boundary so `docs/task-receipts-notes.md` is left alone.
resolve_path(){
    local p="$1" rest
    p="${p#"$PWD"/}"
    case "$p" in
        "$EVIDENCE_ROOT"/*) printf '%s\n' "$p"; return 0 ;;
    esac
    # Each arm strips its OWN literal prefix. A shared `#*/task-receipts/` anchor would silently
    # fail to strip the top-level spelling (no `/` before it), and would over-strip a nested one.
    case "$p" in
        docs/task-receipts/*) rest="${p#docs/task-receipts/}"; printf '%s\n' "$EVIDENCE_ROOT/receipts/$rest" ;;
        task-receipts/*)      rest="${p#task-receipts/}";      printf '%s\n' "$EVIDENCE_ROOT/receipts/$rest" ;;
        docs/audits/*)        rest="${p#docs/audits/}";        printf '%s\n' "$EVIDENCE_ROOT/audits/$rest" ;;
        audits/*)             rest="${p#audits/}";             printf '%s\n' "$EVIDENCE_ROOT/audits/$rest" ;;
        docs/chat-range-reviews/*) rest="${p#docs/chat-range-reviews/}"; printf '%s\n' "$EVIDENCE_ROOT/chat-range-reviews/$rest" ;;
        chat-range-reviews/*)      rest="${p#chat-range-reviews/}";      printf '%s\n' "$EVIDENCE_ROOT/chat-range-reviews/$rest" ;;
        docs/task-plans/*)    rest="${p#docs/task-plans/}";    printf '%s\n' "$PLANS_ROOT/$rest" ;;
        task-plans/*)         rest="${p#task-plans/}";         printf '%s\n' "$PLANS_ROOT/$rest" ;;
        artifacts/*)          rest="${p#artifacts/}";          printf '%s\n' "$EVIDENCE_ROOT/artifacts/$rest" ;;
        *) printf '%s\n' "$p" ;;
    esac
}

test_self(){
    local fail=0 got
    # --resolve: both legacy spellings, the boundary case, and a pass-through
    [ "$("$0" --resolve docs/task-receipts/a.md)" = "$EVIDENCE_ROOT/receipts/a.md" ] \
        || { echo "  FAIL: docs/task-receipts/ must map to the receipts root"; fail=1; }
    [ "$("$0" --resolve task-receipts/a.md)" = "$EVIDENCE_ROOT/receipts/a.md" ] \
        || { echo "  FAIL: top-level task-receipts/ must map to the receipts root"; fail=1; }
    [ "$("$0" --resolve artifacts/x/y.txt)" = "$EVIDENCE_ROOT/artifacts/x/y.txt" ] \
        || { echo "  FAIL: artifacts/ must map to the artifacts root"; fail=1; }
    [ "$("$0" --resolve docs/task-receipts-notes.md)" = "docs/task-receipts-notes.md" ] \
        || { echo "  FAIL: the arm must stop at a component boundary (docs/task-receipts-notes.md is not a receipt)"; fail=1; }
    [ "$("$0" --resolve docs/chat-range-reviews/witness-x.md.findings.json)" = "$EVIDENCE_ROOT/chat-range-reviews/witness-x.md.findings.json" ] \
        || { echo "  FAIL: docs/chat-range-reviews/ must map to the chat-range review root (a ledger row names these sidecars)"; fail=1; }
    [ "$("$0" --resolve chat-range-reviews/witness-x.md)" = "$EVIDENCE_ROOT/chat-range-reviews/witness-x.md" ] \
        || { echo "  FAIL: top-level chat-range-reviews/ must map to the chat-range review root"; fail=1; }
    [ "$("$0" --resolve docs/chat-range-reviews-notes.md)" = "docs/chat-range-reviews-notes.md" ] \
        || { echo "  FAIL: the review arm must stop at a component boundary"; fail=1; }
    [ "$("$0" --resolve docs/task-plans/plan-20260916.tsv)" = "$PLANS_ROOT/plan-20260916.tsv" ] \
        || { echo "  FAIL: docs/task-plans/ must map to the plans root, not the evidence root (chat.log and chains cite these paths)"; fail=1; }
    [ "$("$0" --resolve task-plans/plan-20260916.tsv)" = "$PLANS_ROOT/plan-20260916.tsv" ] \
        || { echo "  FAIL: top-level task-plans/ must map to the plans root"; fail=1; }
    [ "$("$0" --resolve docs/task-plans-notes.md)" = "docs/task-plans-notes.md" ] \
        || { echo "  FAIL: the plans arm must stop at a component boundary"; fail=1; }
    [ "$("$0" --resolve docs/task-receipts/a.md)" != "$PLANS_ROOT/a.md" ] \
        || { echo "  FAIL: a receipt path must not be rewritten into the plans root"; fail=1; }
    [ "$("$0" --resolve scripts/mesh-land)" = "scripts/mesh-land" ] \
        || { echo "  FAIL: a non-evidence path must pass through unchanged"; fail=1; }
    # already-resolved paths are idempotent
    got="$("$0" --resolve "$EVIDENCE_ROOT/receipts/a.md")"
    [ "$got" = "$EVIDENCE_ROOT/receipts/a.md" ] \
        || { echo "  FAIL: an already-resolved path must be stable (got $got)"; fail=1; }
    # roots respect the override and never fall back to the repo
    got="$(MESH_EVIDENCE_ROOT=/tmp/ev "$0" receipts)"
    [ "$got" = "/tmp/ev/receipts" ] || { echo "  FAIL: MESH_EVIDENCE_ROOT override ignored (got $got)"; fail=1; }
    got="$(MESH_EVIDENCE_ROOT=/tmp/ev "$0" chat-range-reviews)"
    [ "$got" = "/tmp/ev/chat-range-reviews" ] || { echo "  FAIL: the chat-range review kind ignored MESH_EVIDENCE_ROOT (got $got)"; fail=1; }
    # plans are a SEPARATE root: MESH_EVIDENCE_ROOT must not move them
    got="$(MESH_EVIDENCE_ROOT=/tmp/ev "$0" plans)"
    [ "$got" = "$PLANS_ROOT" ] || { echo "  FAIL: plans must not follow MESH_EVIDENCE_ROOT (got $got)"; fail=1; }
    got="$(MESH_PLANS_DIR=/tmp/pl "$0" plans)"
    [ "$got" = "/tmp/pl" ] || { echo "  FAIL: MESH_PLANS_DIR override ignored (got $got)"; fail=1; }
    # --mkdir actually creates it
    local td; td="$(mktemp -d)"; mkdir -p "$td"
    got="$(MESH_EVIDENCE_ROOT="$td/ev" "$0" --mkdir receipts)"
    [ -d "$got" ] || { echo "  FAIL: --mkdir did not create $got"; fail=1; }
    rm -rf "$td"
    [ "$fail" = 0 ] && { echo "smoke-test: ok (evidence roots resolve, legacy paths map, boundary and override held)"; exit 0; }
    echo "smoke-test: FAIL"; exit 1
}

case "${1:-}" in
    --test) test_self ;;
    --help|-h|"") usage ;;
    --resolve) [ $# -eq 2 ] || { echo "mesh-evidence-dir: --resolve needs one path" >&2; exit 2; }; resolve_path "$2" ;;
    --mkdir)   [ $# -eq 2 ] || { echo "mesh-evidence-dir: --mkdir needs one kind" >&2; exit 2; }
               d="$(resolve_kind "$2")" || exit 2; mkdir -p "$d" || exit 1; printf '%s\n' "$d" ;;
    receipts|artifacts|audits|chat-range-reviews|plans) resolve_kind "$1" ;;
    *) echo "mesh-evidence-dir: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
esac
