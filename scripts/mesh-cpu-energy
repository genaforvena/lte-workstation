#!/usr/bin/env bash
# reflex-cadence: 7-57/15 * * * *
# reflex-args: --edge
# mesh-cpu-energy — CPU ENERGY-POLICY sense.
#
# Reads the kernel's CPU energy preference / bias knobs:
#   * /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference
#   * fallback: /sys/devices/system/cpu/cpu*/power/energy_perf_bias
#
# This is a distinct signal from mesh-cpufreq:
#   mesh-cpufreq reports the actual clock rate now.
#   mesh-cpu-energy reports the policy that steers the CPU toward performance or power saving.
#
# Honest contract:
#   * unreadable / absent policy sources -> exit 2
#   * never synthesize a preference
#
#   mesh-cpu-energy          one-shot status line
#   mesh-cpu-energy --json   machine-readable
#   mesh-cpu-energy --edge   emit only when the signature changes
#   mesh-cpu-energy --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.cpu-energy-state"
SYSROOT="${MESH_CPU_ENERGY_SYSROOT:-/sys}"

shopt -s nullglob

json_escape() {
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

classify_pref() {
  case "${1:-}" in
    performance) echo PERFORMANCE ;;
    balance_performance) echo BALANCE_PERFORMANCE ;;
    balance_power) echo BALANCE_POWER ;;
    power) echo POWER_SAVE ;;
    default) echo DEFAULT ;;
    *) echo CUSTOM ;;
  esac
}

classify_bias() {
  local b="${1:-}"
  case "$b" in ''|*[!0-9-]*) echo UNKNOWN; return ;; esac
  if   [ "$b" -le 3 ] 2>/dev/null; then echo PERFORMANCE
  elif [ "$b" -le 11 ] 2>/dev/null; then echo BALANCED
  else echo POWER_SAVE
  fi
}

collect_values() {
  local kind="$1" pat="$2" f v got=0
  for f in $pat; do
    [ -r "$f" ] || continue
    v="$(tr -d '\n\r' < "$f" 2>/dev/null || true)"
    [ -n "$v" ] || continue
    printf '%s|%s\n' "$f" "$v"
    got=1
  done
  [ "$got" = 1 ]
}

discover() {
  local lines="" kind=""
  lines="$(collect_values epp "$SYSROOT/devices/system/cpu/cpufreq/policy*/energy_performance_preference" 2>/dev/null || true)"
  if [ -n "$lines" ]; then
    kind="epp"
  else
    lines="$(collect_values bias "$SYSROOT/devices/system/cpu/cpu*/power/energy_perf_bias" 2>/dev/null || true)"
    [ -n "$lines" ] && kind="bias"
  fi
  [ -n "$lines" ] || return 1
  printf '%s\n' "$kind"
  printf '%s\n' "$lines"
}

if [ "${1:-}" = --test ]; then
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v sort >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sort)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT

  mkdir -p "$_td/devices/system/cpu/cpufreq/policy0" \
           "$_td/devices/system/cpu/cpufreq/policy2" \
           "$_td/devices/system/cpu/cpu0/power"
  printf 'balance_performance\n' > "$_td/devices/system/cpu/cpufreq/policy0/energy_performance_preference"
  printf 'balance_performance\n' > "$_td/devices/system/cpu/cpufreq/policy2/energy_performance_preference"
  printf '6\n' > "$_td/devices/system/cpu/cpu0/power/energy_perf_bias"

  out="$(MESH_CPU_ENERGY_SYSROOT="$_td" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (fixture json failed)"; exit 1; }
  printf '%s' "$out" | grep -q '"label":"BALANCE_PERFORMANCE"' || { echo "smoke-test: FAIL (epp label): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"source_kind":"epp"' || { echo "smoke-test: FAIL (epp source_kind): $out"; exit 1; }

  printf 'performance\n' > "$_td/devices/system/cpu/cpufreq/policy2/energy_performance_preference"
  out2="$(MESH_CPU_ENERGY_SYSROOT="$_td" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (fixture mixed json failed)"; exit 1; }
  printf '%s' "$out2" | grep -q '"label":"MIXED"' || { echo "smoke-test: FAIL (mixed label): $out2"; exit 1; }

  rm -f "$_td"/devices/system/cpu/cpufreq/policy*/energy_performance_preference
  out3="$(MESH_CPU_ENERGY_SYSROOT="$_td" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (bias json failed)"; exit 1; }
  printf '%s' "$out3" | grep -q '"label":"BALANCED"' || { echo "smoke-test: FAIL (bias label): $out3"; exit 1; }
  printf '%s' "$out3" | grep -q '"source_kind":"bias"' || { echo "smoke-test: FAIL (bias source_kind): $out3"; exit 1; }

  rm -rf "$_td"
  trap - EXIT
  # REAL-READ gate (2026-07-15) — every assertion above proves the CLASSIFIER against a SYNTHETIC /sys
  # built in a tmpdir and pointed at via MESH_CPU_ENERGY_SYSROOT. None asks whether THIS node exposes an
  # energy-policy knob, so --test returned 0 on mesh-home and autowire read PASS instead of n/a, then
  # cron-wired a reflex that has emitted the identical "UNREACHABLE — no readable CPU energy policy
  # source in /sys" 26/26 times since 2026-07-14. Same bypass as mesh-motion-attrib (562938a),
  # mesh-therm-watch (dacf6f1), mesh-battery (97589f0), mesh-cpu-avgfreq (74f0815).
  #
  # The absence is REAL, verified by control rather than assumed (the mesh-therm lesson: that bug was a
  # wrong PATH, not a missing signal). Both declared tiers are genuinely absent here: no
  # cpufreq/policy*/energy_performance_preference and no cpu*/power/energy_perf_bias — EPP is an
  # amd-pstate/intel_pstate knob and this box runs acpi-cpufreq. Nor is a tier missing: RAPL's
  # /sys/class/powercap/intel-rapl:0/energy_uj does exist here, but it is CONSUMPTION (µJ counters,
  # root-only 0400), not the POLICY this sense reads (:4-8) — a different signal, not a fallback.
  live_rc=0; live="$("$0" 2>&1)" || live_rc=$?
  if [ "$live_rc" = 2 ]; then
    echo "smoke-test: n/a — no CPU energy-policy organ on $(hostname): neither EPP nor energy_perf_bias exists under the $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || echo unknown) driver ($live). All classification assertions passed; this tool is sound, this node's cpufreq driver simply exposes no energy-policy knob."
    exit 2
  fi
  echo "smoke-test: ok (3 classification assertions + honest fallback + real-read gate: live energy-policy source present)"
  exit 0
fi

EDGE=0; JSON=0
for a in "$@"; do
  case "$a" in
    --edge) EDGE=1 ;;
    --json) JSON=1 ;;
  esac
done

disc="$(discover 2>/dev/null || true)"
[ -n "$disc" ] || { echo "mesh-cpu-energy: UNREACHABLE — no readable CPU energy policy source in /sys" >&2; exit 2; }

source_kind="$(printf '%s\n' "$disc" | head -1)"
mapfile -t lines < <(printf '%s\n' "$disc" | tail -n +2 | sed '/^$/d')
[ "${#lines[@]}" -gt 0 ] || { echo "mesh-cpu-energy: UNREACHABLE — empty policy read" >&2; exit 2; }

values=""
paths=""
for line in "${lines[@]}"; do
  path="${line%%|*}"
  value="${line#*|}"
  paths="${paths}${paths:+,}$path"
  values="${values}${values:+
}$value"
done

uniq_values="$(printf '%s\n' "$values" | sort -u | sed '/^$/d')"
uniq_count="$(awk 'NF{c++} END{print c+0}' <<<"$uniq_values")"
signature="$(awk 'NF{printf "%s%s", sep, $0; sep=","} END{print ""}' <<<"$uniq_values")"

label=""
reason=""
raw_value="$(awk 'NF{print; exit}' <<<"$uniq_values")"
if [ "$uniq_count" -gt 1 ]; then
  label="MIXED"
  reason="policy values differ across ${#lines[@]} source(s): ${signature}"
elif [ "$source_kind" = epp ]; then
  label="$(classify_pref "$raw_value")"
  reason="energy_performance_preference=${raw_value} from ${#lines[@]} policy file(s)"
else
  label="$(classify_bias "$raw_value")"
  reason="energy_perf_bias=${raw_value} from ${#lines[@]} cpu power file(s)"
fi

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
prev_label=""
prev_sig=""
if [ -r "$STATE" ]; then
  prev_label="$(head -1 "$STATE" 2>/dev/null | cut -d'|' -f1)"
  prev_sig="$(head -1 "$STATE" 2>/dev/null | sed -n 's/.*sig=\([^|]*\).*/\1/p')"
fi

printf '%s|sig=%s|source_kind=%s|values=%s|paths=%s|%s\n' \
  "$label" "$source_kind:$signature" "$source_kind" "$signature" "$paths" "$reason" > "$STATE"
mesh-state-touch "$STATE"

if [ "$EDGE" = 1 ] && [ "$prev_label" = "$label" ] && [ "$prev_sig" = "$source_kind:$signature" ]; then
  exit 0
fi

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","reason":"%s","source_kind":"%s","signature":"%s","sources":%s,"ts":"%s"}\n' \
    "$(json_escape "$label")" "$(json_escape "$reason")" "$(json_escape "$source_kind")" \
    "$(json_escape "$source_kind:$signature")" "${#lines[@]}" "$TS"
  exit 0
fi

printf '[cpu-energy-%s] %s — %s [source=%s sig=%s]\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason" "$source_kind" "$source_kind:$signature"
