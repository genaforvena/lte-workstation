#!/usr/bin/env bash
# mesh-imac-cam — on-demand still capture from the iMac's (ilya) FaceTime camera → a real JPEG,
# pulled to THIS node. macOS analogue of mesh-camera (which is v4l2-only, Linux-specific): the iMac
# has no ffmpeg/imagesnap/cv2, and PyObjC's block-signature bridging is broken there (BridgeSupport
# parse failure on AVFoundation async completion handlers) — so capture is a small native
# Objective-C helper (scripts/mesh-imac-cam.m, this tool's tracked source of truth) using a plain
# delegate method instead, which the ObjC runtime handles without any bridge metadata.
#
#   mesh-imac-cam [out.jpg]   capture one frame from the iMac, save locally (default ~/.mesh/cam/imac-last.jpg)
#   mesh-imac-cam --test      smoke: consent + reachability + deploy/compile + a REAL capture
#
# CONSENT-GATED (operator 2026-07-04, explicit go-ahead — ~/.mesh/consent camera=yes on ilya, matching
# the mesh-eye/mesh-object-id convention). Self-deploying: pushes the .m source + compiles with clang
# if the remote binary is missing or the source has drifted (md5 compare), so a genome update here
# reaches the iMac on the next call without a separate deploy step.
# orphan-ok: on-demand capture verb, pulled by mesh-imac-cam-watch or ad-hoc — not itself scheduled
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
IMAC="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
SSH_OPTS=(-o StrictHostKeyChecking=no -o ConnectTimeout=8)
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$SELF_DIR/mesh-imac-cam.m"
OUT="${1:-$HOME/.mesh/cam/imac-last.jpg}"

consent_ok(){  # rc 0 granted / 1 reachable-but-refused / 255 ssh transport failure (unreachable) — never collapse the two
  ssh "${SSH_OPTS[@]}" "$IMAC" "grep -qiE '^[[:space:]]*camera[[:space:]]*=[[:space:]]*(yes|true|1)' ~/.mesh/consent 2>/dev/null"
  local rc=$?
  [ "$rc" -eq 255 ] && return 255
  return "$rc"
}

# ensure the remote binary exists and matches the tracked source (md5); (re)compile if not.
ensure_binary(){
  [ -f "$SRC" ] || { echo "mesh-imac-cam: source missing locally: $SRC" >&2; return 1; }
  local local_md5 remote_md5
  local_md5="$(md5sum "$SRC" 2>/dev/null | cut -d' ' -f1)"
  remote_md5="$(ssh "${SSH_OPTS[@]}" "$IMAC" "md5 -q ~/.mesh/imac-cam.m 2>/dev/null")"
  if [ "$local_md5" != "$remote_md5" ] || ! ssh "${SSH_OPTS[@]}" "$IMAC" "[ -x ~/.mesh/imac-cam ]" 2>/dev/null; then
    scp "${SSH_OPTS[@]}" "$SRC" "$IMAC:~/.mesh/imac-cam.m" >/dev/null 2>&1 || return 1
    ssh "${SSH_OPTS[@]}" "$IMAC" "cd ~/.mesh && clang -fobjc-arc -framework Foundation -framework AVFoundation -framework CoreMedia -framework CoreVideo -framework ImageIO -framework CoreServices -framework CoreImage -framework CoreGraphics -o imac-cam imac-cam.m 2>&1 | grep -v 'text-based stub\|falling back'" >&2
    ssh "${SSH_OPTS[@]}" "$IMAC" "[ -x ~/.mesh/imac-cam ]" 2>/dev/null || return 1
  fi
  return 0
}

capture_to(){  # $1 local outpath -> rc 0 on a real non-empty jpeg
  local out="$1" remote="/tmp/.mesh-imac-cam-$$.jpg"
  timeout 20 ssh "${SSH_OPTS[@]}" "$IMAC" "~/.mesh/imac-cam '$remote'" >/dev/null 2>&1 || return 1
  mkdir -p "$(dirname "$out")"
  scp "${SSH_OPTS[@]}" "$IMAC:$remote" "$out" >/dev/null 2>&1
  local rc=$?
  ssh "${SSH_OPTS[@]}" "$IMAC" "rm -f '$remote'" >/dev/null 2>&1 || true
  [ "$rc" -eq 0 ] && [ -s "$out" ]
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }

  # offline fixtures (chat-review/imac-cam-consent-unreachable-reads-refused): consent_ok must
  # distinguish an ssh TRANSPORT failure (rc 255, iMac unreachable) from a real no-consent grep
  # miss (rc 1) — collapsing both into one bool misreported ~640 unreachable-LAN cycles as
  # "REFUSED — no camera consent grant" during the 2026-07-21 20:07-21:33 outage while the consent
  # file sat intact. First prove consent_ok's own return code (stubbed ssh), then the ACTUAL
  # capture-path exit code/wording via a recursive real-script call (PATH-shimmed ssh, no network).
  f=0
  ssh(){ return 255; }
  consent_ok; crc=$?; [ "$crc" -eq 255 ] || { echo "  FAIL: consent_ok must return 255 on ssh transport failure, got $crc"; f=1; }
  unset -f ssh
  ssh(){ return 1; }
  consent_ok; crc=$?; [ "$crc" -eq 1 ] || { echo "  FAIL: consent_ok must return 1 on a reachable no-consent grep miss, got $crc"; f=1; }
  unset -f ssh

  tdshim="$(mktemp -d)"; trap 'rm -rf "$tdshim"' RETURN 2>/dev/null || true
  printf '#!/usr/bin/env bash\nexit 255\n' > "$tdshim/ssh"; chmod +x "$tdshim/ssh"
  out="$(PATH="$tdshim:$PATH" "$0" "/tmp/.mesh-imac-cam-test-$$.jpg" 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" -eq 2 ] && echo "$out" | grep -qi unreachable; } \
    || { echo "  FAIL: unreachable (ssh rc255) capture path must exit 2 with 'unreachable' wording, got rc=$rc: $out"; f=1; }
  printf '#!/usr/bin/env bash\nexit 1\n' > "$tdshim/ssh"
  out="$(PATH="$tdshim:$PATH" "$0" "/tmp/.mesh-imac-cam-test-$$.jpg" 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" -eq 1 ] && echo "$out" | grep -qi refused; } \
    || { echo "  FAIL: reachable no-consent (ssh rc1) capture path must exit 1 with 'REFUSED' wording, got rc=$rc: $out"; f=1; }
  rm -rf "$tdshim"
  [ "$f" != 0 ] && { echo "smoke-test: FAIL"; exit 1; }

  # Unreachable organ = honest n/a (exit 2, doctor/land convention) — the iMac sleeps nightly; only a
  # REACHABLE iMac that can't produce a frame is a real FAIL.
  ssh "${SSH_OPTS[@]}" "$IMAC" true 2>/dev/null || { echo "smoke-test: n/a (iMac unreachable: $IMAC)"; exit 2; }
  consent_ok || { echo "smoke-test: FAIL (no camera consent grant on iMac — ~/.mesh/consent camera=yes)"; exit 1; }
  ensure_binary || { echo "smoke-test: FAIL (deploy/compile of imac-cam failed on the iMac)"; exit 1; }
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  capture_to "$td/test.jpg" || { echo "smoke-test: FAIL (real capture produced no file)"; exit 1; }
  sz="$(stat -c %s "$td/test.jpg" 2>/dev/null || stat -f %z "$td/test.jpg" 2>/dev/null)"
  [ "${sz:-0}" -gt 1000 ] || { echo "smoke-test: FAIL (captured file too small to be a real frame: ${sz}B)"; exit 1; }
  file "$td/test.jpg" 2>/dev/null | grep -qi jpeg || { echo "smoke-test: FAIL (captured file is not a JPEG)"; exit 1; }
  echo "smoke-test: ok (reachable; consented; binary deployed; REAL capture ${sz}B JPEG)"; exit 0
fi

consent_ok; ccrc=$?
if [ "$ccrc" -eq 255 ]; then
  echo "mesh-imac-cam: n/a — iMac unreachable ($IMAC)" >&2; exit 2
elif [ "$ccrc" -ne 0 ]; then
  echo "mesh-imac-cam: REFUSED — no camera consent grant on the iMac (~/.mesh/consent camera=yes)" >&2; exit 1
fi
ensure_binary || { echo "mesh-imac-cam: deploy/compile failed" >&2; exit 1; }
capture_to "$OUT" || { echo "mesh-imac-cam: capture failed (device busy, unreachable, or no frame)" >&2; exit 1; }
echo "$OUT"
