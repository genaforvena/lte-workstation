#!/usr/bin/env bash
# orphan-ok: on-demand remote iMac camera capture; pulled by mesh-imac-cam-watch or invoked ad hoc.
# mesh-imac-cam — compatibility entrypoint; SSH/SCP adapter and its Objective-C helper live in integrations/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in
  */*) ;;
  *) self="$(command -v "$self")" || exit 127 ;;
esac

# Resolve installed symlinks back to this repository before selecting the sibling source.
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in
    /*) self="$link_target" ;;
    *) self="$self_dir/$link_target" ;;
  esac
done

script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/integrations/mesh-imac-cam"
if [ ! -x "$implementation" ]; then
  repo_root="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
  implementation="$repo_root/scripts/integrations/mesh-imac-cam"
fi
[ -x "$implementation" ] || {
  printf 'mesh-imac-cam: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
