#!/usr/bin/env bash
# mesh-peers — the canonical tag:lte-node peer list, DE-DUPLICATED by hostname.
#
# Tailscale keeps a STALE duplicate record when a node re-registers (e.g. GL-MT3000 at an old IP,
# marked offline, alongside the live one at a new IP — same HostName). A tool that reads
# `tailscale status` naively then sees the stale record and reports a LIVE node as OFFLINE
# ("router offline 1d" false alarms, 2026-06-12). mesh-peers collapses each HostName to its BEST
# record — Online wins; otherwise the most-recently-seen — so every consumer sees the truth.
# This is the shared primitive the peer-reading tools should use instead of re-rolling the query.
#
#   mesh-peers            table:  HOSTNAME  IP  OS  STATE
#   mesh-peers --json     JSON array: [{"hostname","ip","os","online"}...]
#                         (+ "state","lan_ip" under --verify; state=unreach = present on the LAN,
#                          not enumerable over the tailnet — NEVER offline, which means "not there")
#   mesh-peers --online   online peers only, one per line: "hostname<TAB>ip"
#   mesh-peers --test     smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

if [ "${1:-}" = --test ]; then
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  tailscale status --json >/dev/null 2>&1 || { echo "smoke-test: FAIL (tailscale status unavailable)"; exit 1; }
  # Dry-run: feed synthetic tailscale JSON through the dedup parser
  # Tests: (1) stale+online duplicate → online wins, (2) non-tagged peers filtered, (3) JSON output
  # e/f/g are the OFF-TAILNET population the LAN leg classifies: gw is present on the LAN, gone
  # resolves only to its own dead TS address (a guess), dark resolves to a LAN address that is silent.
  _synthetic='{"Peer":{"a":{"HostName":"router","TailscaleIPs":["10.0.0.1"],"OS":"linux","Online":false,"LastSeen":"2026-06-18T10:00:00Z","Tags":["tag:lte-node"]},"b":{"HostName":"router","TailscaleIPs":["10.0.0.2"],"OS":"linux","Online":true,"LastSeen":"2026-06-19T10:00:00Z","Tags":["tag:lte-node"]},"c":{"HostName":"friend-pc","TailscaleIPs":["10.0.0.3"],"OS":"windows","Online":true,"Tags":[]},"d":{"HostName":"phone","TailscaleIPs":["10.0.0.4"],"OS":"android","Online":true,"Tags":["tag:lte-node"]},"e":{"HostName":"gw","TailscaleIPs":["10.0.0.5"],"OS":"linux","Online":false,"LastSeen":"2026-06-19T07:11:27Z","Tags":["tag:lte-node"]},"f":{"HostName":"gone","TailscaleIPs":["10.0.0.6"],"OS":"linux","Online":false,"LastSeen":"2026-06-19T07:11:27Z","Tags":["tag:lte-node"]},"g":{"HostName":"dark","TailscaleIPs":["10.0.0.7"],"OS":"linux","Online":false,"LastSeen":"2026-06-19T07:11:27Z","Tags":["tag:lte-node"]}}}'
  _result="$(printf '%s' "$_synthetic" | python3 -c "
import json, sys
d = json.load(sys.stdin)
best = {}
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' not in (p.get('Tags') or []):
        continue
    h = p.get('HostName', '?')
    rec = {'hostname': h, 'ip': (p.get('TailscaleIPs') or ['?'])[0], 'online': bool(p.get('Online')), 'lastseen': p.get('LastSeen', '')}
    cur = best.get(h)
    if cur is None:
        best[h] = rec
    elif rec['online'] and not cur['online']:
        best[h] = rec
    elif rec['online'] == cur['online'] and rec['lastseen'] > cur['lastseen']:
        best[h] = rec
rows = sorted(best.values(), key=lambda r: r['hostname'].lower())
print(json.dumps(rows))
" 2>/dev/null)"
  # Should have 5 peers (router + phone + gw + gone + dark), friend-pc filtered (no tag)
  _count="$(printf '%s' "$_result" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null)"
  [ "$_count" = "5" ] || { echo "smoke-test: FAIL (dedup gave $_count peers, want 5)"; exit 1; }
  # Router should be online (the online record won over stale)
  _check="$(printf '%s' "$_result" | python3 -c 'import json,sys; rows=json.load(sys.stdin); r=next((x for x in rows if x["hostname"]=="router"),None); print("ok" if r and r["online"] and r["ip"]=="10.0.0.2" else "FAIL")' 2>/dev/null)"
  [ "$_check" = "ok" ] || { echo "smoke-test: FAIL (dedup logic: $_check)"; exit 1; }
  # --verify corroboration: mock tailscale + stub ping + stub resolver.
  _vt="$(mktemp -d)"; trap 'rm -rf "$_vt"' EXIT
  printf '%s' "$_synthetic" > "$_vt/ts.json"
  printf '#!/bin/sh\ncat "%s/ts.json"\n' "$_vt" > "$_vt/tailscale"; chmod +x "$_vt/tailscale"
  # ping that answers ONLY for phone (10.0.0.4) and the gateway's LAN address (192.168.8.1);
  # router(10.0.0.2) unreachable → must be stale. Every probe is TAPED so the retry loop can be
  # asserted to have really run through the injected stub.
  printf '#!/bin/sh\necho "$1" >> "%s/pings"\ncase "$1" in 10.0.0.4|192.168.8.1) exit 0 ;; *) exit 1 ;; esac\n' "$_vt" > "$_vt/png"; chmod +x "$_vt/png"
  # Resolver stub, injected by ENV and not by PATH on purpose: line 16 prepends $HOME/.local/bin, so
  # a stub dir a caller adds to PATH LOSES the race to the deployed mesh-peer-addr and the fixture
  # would silently drive the real resolver against the real network.
  #   gw   → a distinct LAN address that answers          (presence)
  #   dark → a distinct LAN address that is silent        (an unpinged fallback just moves the corpse)
  #   gone → its OWN dead TS address, which is what mesh-peer-addr returns as an admitted guess
  printf '#!/bin/sh\ncase "$1" in gw) echo 192.168.8.1 ;; dark) echo 192.168.8.99 ;; gone) echo 10.0.0.6 ;; *) exit 1 ;; esac\n' > "$_vt/addr"; chmod +x "$_vt/addr"
  _venv=(MESH_PEERS_PING_CMD="$_vt/png" MESH_PEERS_ADDR_CMD="$_vt/addr" MESH_PRESENCE_TRIES=2 MESH_PRESENCE_GAP_S=0)
  _vj="$(PATH="$_vt:$PATH" env "${_venv[@]}" bash "$0" --json --verify 2>/dev/null)"
  printf '%s' "$_vj" | python3 -c 'import json,sys
rows=json.load(sys.stdin); g=lambda n: next((x for x in rows if x["hostname"]==n),None)
r,p,w,k,d=g("router"),g("phone"),g("gw"),g("gone"),g("dark")
assert r and r["state"]=="stale" and r["online"] is False, ("router must be stale", r)
assert p and p["state"]=="online" and p["online"] is True, ("phone must be online", p)
# PRESENCE, never capability: off-tailnet + a resolved LAN address that answers = unreach, and the
# row carries online:true + lan_ip ONLY. Never offline, which is a claim the device is NOT THERE.
assert w and w["state"]=="unreach" and w["online"] is True and w["lan_ip"]=="192.168.8.1", ("gw must be unreach and name its lan_ip", w)
# a resolver handing back the same dead TS address has told us nothing — a guess is not a verdict
assert k and k["state"]=="offline" and k["online"] is False and not k["lan_ip"], ("gone: a ts-addr guess must not become presence", k)
# an unpinged fallback just moves the corpse one column over
assert d and d["state"]=="offline" and d["online"] is False and not d["lan_ip"], ("dark: a LAN address that does not answer is not presence", d)
# stale is the INVERSE case of unreach; collapsing the two would let a ping-dead peer wear presence
assert not r["lan_ip"], ("a stale row claims no LAN presence", r)' \
    || { echo "smoke-test: FAIL (--verify states — got: $_vj)"; exit 1; }
  # The retry ran through the INJECTED stub: a retry buried inside the default helper is bypassed by
  # every fixture, so it could assert nothing about the path that actually runs (mesh-minds 2026-08-22).
  _dk="$(grep -c '^192\.168\.8\.99$' "$_vt/pings" 2>/dev/null)"
  [ "$_dk" = 2 ] || { echo "smoke-test: FAIL (LAN probe must retry MESH_PRESENCE_TRIES=2 times, taped $_dk)"; exit 1; }
  _vo="$(PATH="$_vt:$PATH" env "${_venv[@]}" bash "$0" --online --verify 2>/dev/null)"
  printf '%s\n' "$_vo" | grep -q '^phone' || { echo "smoke-test: FAIL (--online --verify must list phone: $_vo)"; exit 1; }
  printf '%s\n' "$_vo" | grep -q '^router' && { echo "smoke-test: FAIL (--online --verify must EXCLUDE stale router: $_vo)"; exit 1; }
  # --online hands out addresses a caller will ssh to; presence is not that claim.
  printf '%s\n' "$_vo" | grep -q '^gw' && { echo "smoke-test: FAIL (--online --verify must EXCLUDE the unreach gw: $_vo)"; exit 1; }
  rm -rf "$_vt"; trap '' EXIT
  echo "smoke-test: ok (dedup: 5 peers, online-wins, non-tagged filtered; --verify: stale, LAN-present unreach, guess/silent-fallback offline)"; exit 0
fi

# --verify: CORROBORATE each Tailscale-online peer with a fresh ping (liveness is a LEASE, not the
# cached .Online flag — operator 2026-06-21 ds false-all-clear). An online-but-unreachable peer is
# reported 'stale', never a false 'online'. OPT-IN so every existing caller keeps the cheap cached
# path (no new heat); only a caller that asks (e.g. mesh-card --refresh) pays the pings.
# MESH_PEERS_PING_CMD=<cmd> overrides the probe (<cmd> <ip>, exit 0=alive) — used by --test.
#
# THE LAN LEG (2026-08-24). The arm above corroborates the ONLINE rows and had nothing at all for the
# offline ones, so Online=false fell straight through to state=offline — a claim that the device is
# NOT THERE. Measured 2026-08-24T21:54Z on mesh-home: GL-MT3000 read `offline` here while 192.168.8.1
# answered ICMP 3/3 at 0% loss and `mesh-peer-addr GL-MT3000` returned that very address; mesh-card
# writes the word verbatim into the durable ~/.mesh-card. senses fixed exactly this in `mesh-minds`
# on 2026-08-22 and swept five CONSUMERS — this file is the PRODUCER four more consumers read, and it
# was not in that set. The vocabulary slot already existed: `unreach` is the INVERSE of `stale`.
#
# The shape is mesh-minds' `_resolve_lan_present`, mirrored, and mirroring is the point:
#   * the address is RESOLVED, never guessed — `mesh-peer-addr` is the mesh's one resolver and it
#     already applies MESH_LAN_FALLBACK ("GL-MT3000:192.168.8.1", written by the operator on
#     2026-06-19, the day the router left the tailnet);
#   * a resolver that hands back the same dead TS address has told us NOTHING — it says so on stderr
#     ("returning ts addr as a guess") — so cand == ts ip is skipped: a guess is not a verdict;
#   * the row claims PRESENCE, never CAPABILITY: online:true + lan_ip ONLY, ip untouched.
#     Reachability-for-exec stays the caller's own probe, which is why `--online --verify` keeps
#     EXCLUDING an unreach peer — that arm exists to hand out addresses someone will ssh to;
#   * retries, because one lost datagram must not decide a word meaning "not there" while our own
#     sole uplink goes dark tens of times a day. Same knobs as mesh-minds
#     (MESH_PRESENCE_TRIES/MESH_PRESENCE_GAP_S) so one tuning moves both probers.
# MESH_PEERS_ADDR_CMD=<cmd> overrides the resolver (<cmd> <hostname> → address on stdout) — used by
# --test, and by ENV rather than a PATH stub because line 16 prepends $HOME/.local/bin, so a stub dir
# a caller puts on PATH loses the race to the DEPLOYED mesh-peer-addr.
VERIFY=0; MODE=table
for _a in "$@"; do case "$_a" in --verify) VERIFY=1;; --json|--online|--table) MODE="$_a";; esac; done
[ "$MODE" = --table ] && MODE=table

if [ "$VERIFY" = 1 ]; then
  _pingcmd="${MESH_PEERS_PING_CMD:-}"
  _addrcmd="${MESH_PEERS_ADDR_CMD:-}"
  _tries="${MESH_PRESENCE_TRIES:-3}"; _gap="${MESH_PRESENCE_GAP_S:-1.5}"
  case "$_tries" in ''|*[!0-9]*) _tries=3 ;; esac; [ "$_tries" -lt 1 ] && _tries=1
  _corrob(){ local ip="$1"; { [ -z "$ip" ] || [ "$ip" = '?' ]; } && return 1
    if [ -n "$_pingcmd" ]; then "$_pingcmd" "$ip" >/dev/null 2>&1; else ping -c1 -W2 "$ip" >/dev/null 2>&1; fi; }
  # LAN presence for an OFF-TAILNET peer: echo the LAN address that answered (rc 0), else rc 1.
  # </dev/null on the resolver: these run inside a `while read` fed by a here-string, and a child
  # that inherits that stdin eats the rows behind it.
  _lan_present(){
    local h="$1" ts="$2" cand="" _i=0
    if [ -n "$_addrcmd" ]; then cand="$("$_addrcmd" "$h" 2>/dev/null </dev/null | head -1)"
    elif command -v mesh-peer-addr >/dev/null 2>&1; then cand="$(timeout 25 mesh-peer-addr "$h" 2>/dev/null </dev/null | head -1)"
    else return 1; fi
    cand="$(printf '%s' "$cand" | tr -d '[:space:]')"
    [ -n "$cand" ] || return 1
    [ "$cand" = "$ts" ] && return 1          # the resolver's admitted guess is not a resolution
    while [ "$_i" -lt "$_tries" ]; do
      _corrob "$cand" && { printf '%s' "$cand"; return 0; }
      _i=$((_i+1)); [ "$_i" -lt "$_tries" ] && sleep "$_gap"
    done
    return 1
  }
  # ONE classifier for all three render modes — three private copies of a verdict are all green and
  # none of them is the same predicate. Sets $_st and $_lan.
  _classify(){
    if [ "$3" = 1 ]; then _lan=""; _corrob "$2" && _st=online || _st=stale
    else _lan="$(_lan_present "$1" "$2")" && _st=unreach || { _st=offline; _lan=""; }
    fi
  }
  # raw collapsed rows (same online-wins dedup as below): hostname\tip\tos\tonline(0/1)
  _raw=$(tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
best={}
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' not in (p.get('Tags') or []): continue
    h=p.get('HostName','?')
    rec={'h':h,'ip':(p.get('TailscaleIPs') or ['?'])[0],'os':p.get('OS','?'),'on':bool(p.get('Online')),'ls':p.get('LastSeen','')}
    cur=best.get(h)
    if cur is None: best[h]=rec
    elif rec['on'] and not cur['on']: best[h]=rec
    elif rec['on']==cur['on'] and rec['ls']>cur['ls']: best[h]=rec
for r in sorted(best.values(),key=lambda r:r['h'].lower()):
    print('%s\t%s\t%s\t%d' % (r['h'],r['ip'],r['os'],1 if r['on'] else 0))
")
  if [ "$MODE" = --json ]; then
    _first=1; printf '['
    while IFS=$'\t' read -r h ip os on; do
      [ -z "$h" ] && continue
      _classify "$h" "$ip" "$on"
      [ "$_first" = 1 ] || printf ','; _first=0
      # online: the PRESENCE claim (online|unreach), not the exec claim. lan_ip is always present in
      # the schema and empty when there is none — a key that appears only sometimes is a key every
      # consumer forgets to open.
      case "$_st" in online|unreach) _on=true ;; *) _on=false ;; esac
      printf '{"hostname":"%s","ip":"%s","os":"%s","online":%s,"state":"%s","lan_ip":"%s"}' "$h" "$ip" "$os" "$_on" "$_st" "$_lan"
    done <<<"$_raw"
    printf ']\n'
  elif [ "$MODE" = --online ]; then
    while IFS=$'\t' read -r h ip os on; do
      [ -z "$h" ] && continue
      [ "$on" = 1 ] && _corrob "$ip" && printf '%s\t%s\n' "$h" "$ip"   # only truly-corroborated online
    done <<<"$_raw"
  else
    while IFS=$'\t' read -r h ip os on; do
      [ -z "$h" ] && continue
      _classify "$h" "$ip" "$on"
      printf '%-24s %-16s %-8s %s%s\n' "$h" "$ip" "$os" "$_st" "${_lan:+  lan=$_lan}"
    done <<<"$_raw"
  fi
  exit 0
fi

tailscale status --json 2>/dev/null | python3 -c "
import json, sys
mode = sys.argv[1] if len(sys.argv) > 1 else 'table'
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)

# collapse each HostName to its best record: Online wins; else most-recently-seen (LastSeen).
best = {}
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' not in (p.get('Tags') or []):
        continue
    h = p.get('HostName', '?')
    rec = {
        'hostname': h,
        'ip': (p.get('TailscaleIPs') or ['?'])[0],
        'os': p.get('OS', '?'),
        'online': bool(p.get('Online')),
        'lastseen': p.get('LastSeen', ''),
    }
    cur = best.get(h)
    if cur is None:
        best[h] = rec
    else:
        # prefer online; if tie on online, prefer the later LastSeen
        if rec['online'] and not cur['online']:
            best[h] = rec
        elif rec['online'] == cur['online'] and rec['lastseen'] > cur['lastseen']:
            best[h] = rec

rows = sorted(best.values(), key=lambda r: r['hostname'].lower())

if mode == '--json':
    print(json.dumps([{k: r[k] for k in ('hostname','ip','os','online')} for r in rows]))
elif mode == '--online':
    for r in rows:
        if r['online']:
            print(f\"{r['hostname']}\t{r['ip']}\")
else:
    for r in rows:
        state = 'online' if r['online'] else 'offline'
        print(f\"{r['hostname']:<24} {r['ip']:<16} {r['os']:<8} {state}\")
" "$MODE"
