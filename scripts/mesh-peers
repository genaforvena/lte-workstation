#!/usr/bin/env bash
# mesh-peers — the canonical tag:lte-node peer list, DE-DUPLICATED by hostname.
#
# Tailscale keeps a STALE duplicate record when a node re-registers (e.g. GL-MT3000 at an old IP,
# marked offline, alongside the live one at a new IP — same HostName). A tool that reads
# `tailscale status` naively then sees the stale record and reports a LIVE node as OFFLINE
# ("router offline 1d" false alarms, 2026-06-12). mesh-peers collapses each HostName to its BEST
# record — Online wins; otherwise the most-recently-seen — so every consumer sees the truth.
# This is the shared primitive the peer-reading tools should use instead of re-rolling the query.
#
#   mesh-peers            table:  HOSTNAME  IP  OS  STATE
#   mesh-peers --json     JSON array: [{"hostname","ip","os","online"}...]
#   mesh-peers --online   online peers only, one per line: "hostname<TAB>ip"
#   mesh-peers --test     smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

if [ "${1:-}" = --test ]; then
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  tailscale status --json >/dev/null 2>&1 || { echo "smoke-test: FAIL (tailscale status unavailable)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

MODE="${1:-table}"
tailscale status --json 2>/dev/null | python3 -c "
import json, sys
mode = sys.argv[1] if len(sys.argv) > 1 else 'table'
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)

# collapse each HostName to its best record: Online wins; else most-recently-seen (LastSeen).
best = {}
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' not in (p.get('Tags') or []):
        continue
    h = p.get('HostName', '?')
    rec = {
        'hostname': h,
        'ip': (p.get('TailscaleIPs') or ['?'])[0],
        'os': p.get('OS', '?'),
        'online': bool(p.get('Online')),
        'lastseen': p.get('LastSeen', ''),
    }
    cur = best.get(h)
    if cur is None:
        best[h] = rec
    else:
        # prefer online; if tie on online, prefer the later LastSeen
        if rec['online'] and not cur['online']:
            best[h] = rec
        elif rec['online'] == cur['online'] and rec['lastseen'] > cur['lastseen']:
            best[h] = rec

rows = sorted(best.values(), key=lambda r: r['hostname'].lower())

if mode == '--json':
    print(json.dumps([{k: r[k] for k in ('hostname','ip','os','online')} for r in rows]))
elif mode == '--online':
    for r in rows:
        if r['online']:
            print(f\"{r['hostname']}\t{r['ip']}\")
else:
    for r in rows:
        state = 'online' if r['online'] else 'offline'
        print(f\"{r['hostname']:<24} {r['ip']:<16} {r['os']:<8} {state}\")
" "$MODE"
