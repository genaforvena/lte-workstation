#!/usr/bin/env bash
# orphan-ok: liveness PRIMITIVE invoked by other reflexes (`mesh-lease renew ...`), never itself
#            cron-scheduled — on-demand by design, so the orphan check must not flag it.
#
# mesh-lease — liveness as a LEASE, not a touch. The counter-primitive to mesh-state-touch.
#
# THE PROBLEM it ends. mesh-state-touch's convention is "refresh mtime on EVERY successful eval",
# which proves THE CODE RAN. Nobody reading a liveness artifact wants that claim. They want "the
# SENSE PRODUCED". Those came apart today, in the open, for 4h40m:
#
#   $ stat -c '%y %s' ~/.mesh/room-transcript.txt
#   2026-07-15 14:38:04 +0000   0        <- mtime 7 SECONDS ago. ZERO BYTES.
#
# The room ear went deaf at 09:58:44 (pw-record bound to a dead mic; RMS max 2 against its own
# START_RMS=600 gate). Its cron never missed a tick, so it touched every run, so every mtime-aging
# watchdog read it as maximally alive while it heard nothing. mesh-state-touch's own promise — "a
# genuinely dead cron never runs -> never touches -> still goes honest-STALE" — is TRUE and
# IRRELEVANT. The cron was not dead. The ORGAN was. A touch cannot tell those apart BY CONSTRUCTION:
# it is the reflex asserting its own execution, which is the artifact-shaped form of a gate that
# greps its own source (1969a5d). And mesh-reflex-health:41-43 excludes the @cond class OUTRIGHT as
# "NOT WATCHABLE" — so the reflexes most likely to be hollow are precisely the ones nobody watches.
#
# THE INVERSION. A touch is a claim that decays only if someone runs a watchdog to age it. A lease
# EXPIRES ON ITS OWN and the reader sees the expiry with no watchdog in the loop:
#
#   touch   default GREEN. Renewed by EXECUTION.  Absence noticed only by a scanner (that can itself
#                                                 die, or exclude your class outright).
#   lease   default EXPIRED. Renewed by EVIDENCE. Absence IS the signal — no scanner required.
#
# Three properties, and the third is the one that earns the tool:
#   1. DEFAULT EXPIRED   — no lease file => EXPIRED, rc 1. Never "green because nothing said no".
#   2. EVIDENCE REQUIRED — `renew` without a non-empty --evidence is REFUSED (rc 2). You cannot
#                          renew a lease by existing. The measured value must reach the artifact.
#   3. FLATLINE VISIBLE  — the lease keeps the last N evidence values. Byte-identical evidence across
#                          FLATLINE_MIN renewals reports FLATLINE. This makes the mesh's own
#                          "1 distinct line in a log = dead lane" detector STRUCTURAL instead of
#                          something a human has to remember to go run. It is exactly how the fan
#                          tach was called hollow this morning: 10 channels, "byte-identical across a
#                          3s re-read (no tach jitter)" at 54C with the fans visibly spinning.
#
# WHAT THIS TOOL CANNOT DO, stated plainly because the alternative is a silent fallback. It CANNOT
# verify the evidence came from a real read. `--evidence "OK"` renews just fine. Nothing at this
# layer can check that — the caller is the only thing that touched the organ. What the lease changes
# is that a constant is now VISIBLE (FLATLINE) instead of invisible: mesh-hw-health --edge:369-377
# computes a full report with real temps into $out and then writes `tail -1` to its log, so
# ~/.mesh/hw-health.log is "HW: OK" x N — BYTE-IDENTICAL before and after the 6593f8a thermal fix
# that changed what the tool can physically see. The lease does not make lying impossible. It makes
# a lie leave a trace. That is the whole claim; do not read it as more.
#
# FLATLINE IS A WARN, NOT A FAIL, and --discrete turns it off. Real sensor reads jitter (that jitter
# is the liveness); a boolean/enum sense legitimately holds one value for days. Declaring the axis is
# the caller's job, and a wrong default here would manufacture exactly the confident lie this tool
# exists to catch.
#
# Usage:
#   mesh-lease renew <name> --ttl <sec> --evidence <str> [--discrete]   renew; evidence REQUIRED
#   mesh-lease check <name>            rc 0 LIVE · rc 1 EXPIRED/absent · prints state + remaining
#   mesh-lease list                    every lease, newest first, with remaining/EXPIRED/FLATLINE
#   mesh-lease --test                  gate
#
# Store: $MESH_LEASE_DIR (default ~/.mesh/leases)/<name>.lease — append-only "<epoch> <ttl> <ev>".
set -uo pipefail

LEASE_DIR="${MESH_LEASE_DIR:-$HOME/.mesh/leases}"
KEEP=12          # history lines retained per lease
FLATLINE_MIN=5   # identical evidence across this many renewals => FLATLINE

_now(){ date -u +%s; }
_lf(){ printf '%s/%s.lease' "$LEASE_DIR" "$1"; }

# name must be a safe filename — a lease called "../../etc/x" must never escape the store
_valid_name(){ case "$1" in ''|*/*|*..*) return 1;; *) return 0;; esac; }

_renew(){
  local name="$1"; shift
  local ttl="" ev="" discrete=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --ttl)      ttl="${2:-}"; shift 2 ;;
      --evidence) ev="${2:-}"; shift 2 ;;
      --discrete) discrete=1; shift ;;
      *) echo "mesh-lease renew: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  _valid_name "$name" || { echo "mesh-lease renew: bad lease name '$name'" >&2; return 2; }
  case "$ttl" in ''|*[!0-9]*) echo "mesh-lease renew: --ttl <seconds> required (got '$ttl')" >&2; return 2 ;; esac
  [ "$ttl" -gt 0 ] 2>/dev/null || { echo "mesh-lease renew: --ttl must be > 0" >&2; return 2; }
  # PROPERTY 2: you cannot renew a lease by existing.
  case "$ev" in
    ''|' '*) : ;;
  esac
  if [ -z "$(printf '%s' "$ev" | tr -d '[:space:]')" ]; then
    echo "mesh-lease renew: --evidence REQUIRED and must be non-empty — a lease is renewed by what the sense PRODUCED, never by the fact it ran" >&2
    return 2
  fi
  mkdir -p "$LEASE_DIR" 2>/dev/null || { echo "mesh-lease: cannot create $LEASE_DIR" >&2; return 2; }
  local f; f="$(_lf "$name")"
  # evidence is one line: newlines would corrupt the history/flatline read
  ev="$(printf '%s' "$ev" | tr '\n\t' '  ' | cut -c1-200)"
  printf '%s %s %s%s\n' "$(_now)" "$ttl" "$([ "$discrete" = 1 ] && printf '[discrete] ')" "$ev" >> "$f"
  # retain only the last $KEEP lines
  if [ "$(wc -l < "$f" 2>/dev/null || echo 0)" -gt "$KEEP" ]; then
    tail -n "$KEEP" "$f" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  fi
  return 0
}

# prints "<STATE> <detail>"; rc 0 live, 1 expired/absent
_check(){
  local name="$1" quiet="${2:-0}" f last ts ttl ev now left n ident
  _valid_name "$name" || { echo "mesh-lease check: bad lease name '$name'" >&2; return 2; }
  f="$(_lf "$name")"
  # PROPERTY 1: absent => EXPIRED, never green-by-default.
  if [ ! -s "$f" ]; then
    [ "$quiet" = 1 ] || echo "EXPIRED $name — no lease (never renewed; absence is the signal, not an all-clear)"
    return 1
  fi
  last="$(tail -n 1 "$f")"
  ts="${last%% *}"; local rest="${last#* }"; ttl="${rest%% *}"; ev="${rest#* }"
  case "$ts$ttl" in *[!0-9]*) echo "EXPIRED $name — lease line unparseable: $last"; return 1 ;; esac
  now="$(_now)"; left=$(( ts + ttl - now ))
  if [ "$left" -le 0 ]; then
    [ "$quiet" = 1 ] || echo "EXPIRED $name — last renewal $(( now - ts ))s ago, ttl ${ttl}s (expired $(( -left ))s ago) · last evidence: $ev"
    return 1
  fi
  # PROPERTY 3: flatline is visible. --discrete opts an enum/boolean axis out.
  case "$ev" in
    '[discrete] '*) ;;
    *)
      n="$(wc -l < "$f")"
      if [ "$n" -ge "$FLATLINE_MIN" ]; then
        # compare the evidence field of the last FLATLINE_MIN lines
        ident="$(tail -n "$FLATLINE_MIN" "$f" | sed 's/^[0-9]* [0-9]* //' | sort -u | wc -l)"
        if [ "$ident" = 1 ]; then
          [ "$quiet" = 1 ] || echo "FLATLINE $name — live (${left}s left) BUT evidence byte-identical across last $FLATLINE_MIN renewals: '$ev' — a real read jitters; a dead organ repeats. (--discrete if this axis is an enum)"
          return 0
        fi
      fi
      ;;
  esac
  [ "$quiet" = 1 ] || echo "LIVE $name — ${left}s left (ttl ${ttl}s) · evidence: $ev"
  return 0
}

_list(){
  [ -d "$LEASE_DIR" ] || { echo "no leases ($LEASE_DIR absent) — nothing has claimed liveness on this node"; return 0; }
  local any=0 f n
  for f in "$LEASE_DIR"/*.lease; do
    [ -e "$f" ] || continue
    any=1; n="$(basename "$f" .lease)"
    _check "$n"
  done
  [ "$any" = 1 ] || echo "no leases in $LEASE_DIR — nothing has claimed liveness on this node"
}

# ---------------------------------------------------------------- gate
if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$d"' EXIT
  # LEASE_DIR is bound ONCE at load, ABOVE this block — exporting MESH_LEASE_DIR here would come too
  # late and every renew would land in the REAL store. That is not hypothetical: the first run of this
  # gate forged five mock leases into ~/.mesh/leases (a "temp" lease reading 42.1C that no sensor ever
  # produced) while three assertions passed for the WRONG REASON, reading an absent file in $d. The
  # 09f7914 trap — a test that writes the artifact it exists to check — inside the tool whose entire
  # subject is liveness artifacts. So: rebind the real variable, then ASSERT the redirection took,
  # and refuse to run at all if it did not.
  LEASE_DIR="$d"; export MESH_LEASE_DIR="$d"
  real_store="${HOME}/.mesh/leases"
  case "$LEASE_DIR" in
    "$real_store"|"$HOME/.mesh"|"$HOME"|/) echo "smoke-test: FAIL (refusing to run against the REAL store $LEASE_DIR)"; exit 1 ;;
  esac
  [ -n "${d:-}" ] && [ -d "$d" ] || { echo "smoke-test: FAIL (no sandbox)"; exit 1; }
  store_before="$(ls -A "$real_store" 2>/dev/null | sort | md5sum)"
  fails=0
  t(){ if eval "$2"; then echo "  ok: $1"; else echo "  FAIL: $1"; fails=$((fails+1)); fi; }

  # The FIRST assertion, because every one below is void if this fails: the gate writes to the
  # sandbox and CANNOT touch the store a human reads.
  _renew sandbox-canary --ttl 60 --evidence "canary" >/dev/null 2>&1
  t "gate writes to the SANDBOX, not the real store" '[ -s "$d/sandbox-canary.lease" ] && [ ! -e "$real_store/sandbox-canary.lease" ]'
  rm -f "$d/sandbox-canary.lease"

  # 1. DEFAULT EXPIRED — the property that makes absence a signal
  out="$(_check never-renewed 2>&1)"; rc=$?
  t "absent lease => EXPIRED rc1 (never green-by-default)" '[ "$rc" = 1 ] && printf "%s" "$out" | grep -q "^EXPIRED"'

  # 2. EVIDENCE REQUIRED — cannot renew by existing
  out="$(_renew ev-test --ttl 60 2>&1)"; rc=$?
  t "renew with NO --evidence is refused rc2" '[ "$rc" = 2 ] && printf "%s" "$out" | grep -q "REQUIRED"'
  out="$(_renew ev-test --ttl 60 --evidence "   " 2>&1)"; rc=$?
  t "renew with whitespace-only evidence is refused rc2" '[ "$rc" = 2 ]'
  t "a refused renew wrote NO lease (still EXPIRED)" '! _check ev-test >/dev/null 2>&1'
  out="$(_renew ev-test --ttl 60 --evidence "" 2>&1)"; rc=$?
  t "renew with empty-string evidence is refused rc2" '[ "$rc" = 2 ]'

  # ttl validation
  t "renew with no --ttl is refused rc2"   '_renew t2 --evidence x >/dev/null 2>&1; [ $? = 2 ]'
  t "renew with --ttl 0 is refused rc2"    '_renew t2 --ttl 0 --evidence x >/dev/null 2>&1; [ $? = 2 ]'
  t "renew with non-numeric ttl refused"   '_renew t2 --ttl abc --evidence x >/dev/null 2>&1; [ $? = 2 ]'
  t "lease name cannot escape the store"   '_renew ../escape --ttl 60 --evidence x >/dev/null 2>&1; [ $? = 2 ]'

  # 3. a real renewal reads LIVE and carries its evidence
  _renew temp --ttl 3600 --evidence "42.1C" >/dev/null 2>&1
  out="$(_check temp 2>&1)"; rc=$?
  t "renewed lease => LIVE rc0" '[ "$rc" = 0 ] && printf "%s" "$out" | grep -q "^LIVE"'
  t "LIVE line carries the EVIDENCE, not just a verdict" 'printf "%s" "$out" | grep -q "42.1C"'

  # 4. EXPIRY is real — a past renewal with a short ttl expires with NO watchdog running
  printf '%s 1 30.0C\n' "$(( $(_now) - 500 ))" > "$d/stale.lease"
  out="$(_check stale 2>&1)"; rc=$?
  t "a lease past its ttl => EXPIRED rc1 (expires on its own)" '[ "$rc" = 1 ] && printf "%s" "$out" | grep -q "^EXPIRED"'

  # 5. FLATLINE — the hw-health "HW: OK" x N case, structurally
  rm -f "$d/flat.lease"
  i=0; while [ $i -lt 6 ]; do _renew flat --ttl 3600 --evidence "HW: OK" >/dev/null 2>&1; i=$((i+1)); done
  out="$(_check flat 2>&1)"; rc=$?
  t "byte-identical evidence x6 => FLATLINE (rc0, live but suspect)" '[ "$rc" = 0 ] && printf "%s" "$out" | grep -q "^FLATLINE"'

  # a JITTERING axis must NOT flatline — the false-positive control
  rm -f "$d/jit.lease"
  for v in 41.9C 42.1C 42.0C 42.3C 41.8C 42.2C; do _renew jit --ttl 3600 --evidence "$v" >/dev/null 2>&1; done
  out="$(_check jit 2>&1)"; rc=$?
  t "a jittering real read does NOT flatline" '[ "$rc" = 0 ] && printf "%s" "$out" | grep -q "^LIVE"'

  # --discrete opts an enum axis out of flatline
  rm -f "$d/disc.lease"
  i=0; while [ $i -lt 6 ]; do _renew disc --ttl 3600 --evidence "ON" --discrete >/dev/null 2>&1; i=$((i+1)); done
  out="$(_check disc 2>&1)"; rc=$?
  t "--discrete enum holding one value does NOT flatline" '[ "$rc" = 0 ] && printf "%s" "$out" | grep -q "^LIVE"'

  # flatline must not mask EXPIRY (expiry is the stronger claim)
  rm -f "$d/fe.lease"
  i=0; while [ $i -lt 6 ]; do printf '%s 1 SAME\n' "$(( $(_now) - 900 ))" >> "$d/fe.lease"; i=$((i+1)); done
  out="$(_check fe 2>&1)"; rc=$?
  t "an EXPIRED flatlined lease reports EXPIRED, not FLATLINE" '[ "$rc" = 1 ] && printf "%s" "$out" | grep -q "^EXPIRED"'

  # 6. history is bounded
  rm -f "$d/keep.lease"; i=0
  while [ $i -lt 20 ]; do _renew keep --ttl 3600 --evidence "v$i" >/dev/null 2>&1; i=$((i+1)); done
  t "history retained to KEEP=$KEEP lines" '[ "$(wc -l < "$d/keep.lease")" = "'"$KEEP"'" ]'

  # 7. THE LIVE CASE this tool was built for: room-transcript.txt is fresh AND empty.
  #    mtime says maximally alive; the sense produced nothing. Drive both models over the SAME
  #    artifact and assert they DISAGREE — that disagreement is the tool's whole reason to exist.
  probe="$d/room-transcript.txt"; : > "$probe"    # 0 bytes, mtime now — the real artifact's shape
  age=$(( $(_now) - $(stat -c %Y "$probe") ))
  t "touch-model reads the fresh+empty artifact as ALIVE (age ${age}s)" '[ "$age" -lt 60 ]'
  # the lease model asks the PRODUCER: bytes produced. 0 bytes => nothing to renew with.
  bytes=$(stat -c %s "$probe")
  if [ "$bytes" -gt 0 ]; then _renew room-ear --ttl 600 --evidence "${bytes}B transcript" >/dev/null 2>&1; fi
  out="$(_check room-ear 2>&1)"; rc=$?
  t "lease-model reads the SAME artifact as EXPIRED (the disagreement IS the find)" '[ "$rc" = 1 ]'

  # LAST assertion: the ENTIRE run left the real store byte-for-byte as it found it. The opening
  # canary only proves the first renew was redirected; this proves every arm after it was too.
  store_after="$(ls -A "$real_store" 2>/dev/null | sort | md5sum)"
  t "the real store is UNCHANGED by this run (no forged liveness)" '[ "$store_before" = "$store_after" ]'

  echo
  if [ "$fails" = 0 ]; then echo "smoke-test: ok"; exit 0; else echo "smoke-test: FAIL ($fails)"; exit 1; fi
fi

case "${1:-}" in
  renew) shift; [ $# -ge 1 ] || { echo "usage: mesh-lease renew <name> --ttl <sec> --evidence <str> [--discrete]" >&2; exit 2; }
         n="$1"; shift; _renew "$n" "$@"; exit $? ;;
  check) shift; [ $# -ge 1 ] || { echo "usage: mesh-lease check <name>" >&2; exit 2; }
         _check "$1"; exit $? ;;
  list|'') _list; exit 0 ;;
  -h|--help) sed -n '5,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "mesh-lease: unknown command '${1:-}' (renew|check|list|--test)" >&2; exit 2 ;;
esac
