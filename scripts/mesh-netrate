#!/usr/bin/env bash
# orphan-ok: on-demand activity-probe, mind/fusion-invoked LIVE (LIVE-ONLY class like mesh-audio-active /
#   keypresence — reads an INSTANTANEOUS rate over a short sample window, no per-run cache to schedule).
# mesh-netrate — how much traffic is flowing through THIS node's uplink RIGHT NOW (bytes/sec)?
#
# WHY this is a NEW, distinct sense (not covered by the existing perception set):
#   - mesh-wifi-link / mesh-wifi-quality sense the WiFi LINK (RSSI, signal quality, association) — "is the
#     radio connected and how strong". They say nothing about VOLUME. This senses THROUGHPUT: the live
#     byte-rate crossing the busiest interface — "is the uplink actually carrying traffic right now". A
#     node can have a perfect-RSSI link and zero flow (idle), or a weak link saturated with a download.
#   - It is an ACTIVITY + uplink-liveness signal: sustained zero on a node that should be talking is a
#     wedge; a burst is real work/streaming/sync. It claims nothing about WHO — pure volume (no person).
#
# SOURCE: /proc/net/dev — the kernel's per-interface cumulative byte counters. Sampled twice over a short
#   window; the delta / window = current bytes/sec. World-readable, no root, no SSH, headless-safe.
#
# HONEST degradation (the no-faked-reading rule):
#   - No non-loopback interface present at all (nothing to measure) => EXIT 2 "unreachable" — NOT a fake
#     IDLE. Absence-of-an-interface must read differently from a real quiet link.
#   - A present interface carrying ~no traffic => IDLE (honest: a real, measured near-zero rate). IDLE is
#     NOT a claim the uplink is down — the link may simply be quiet this instant.
#
# Usage:
#   mesh-netrate            one-shot live read over ~2s -> IDLE|LIGHT|ACTIVE|BUSY (+ iface, rx/tx KB/s)
#   mesh-netrate <secs>     sample over <secs> instead of the 2s default (min 1)
#   mesh-netrate --json     machine form {ts,host,iface,rx_bps,tx_bps,status}
#   mesh-netrate --test     smoke test (pure classify on synthetic byte-rates, no /proc read, no sleep)
#   exit 0 = real reading · exit 2 = no measurable interface (sense unreachable on this node)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"

# --- classify_rate <total-bytes-per-sec>: echo IDLE|LIGHT|ACTIVE|BUSY for the combined rx+tx rate.
# Thresholds tunable via env. FALSIFIABLE: shift a boundary and the --test fixtures fail.
#   IDLE   < 10 KB/s   — effectively quiet (keepalives, ARP, the odd beacon)
#   LIGHT  < 200 KB/s  — light interactive (SSH, chat, a page load)
#   ACTIVE < 2 MB/s    — steady transfer (a sync, a stream)
#   BUSY  >= 2 MB/s    — saturating / bulk transfer
classify_rate() {  # <total_bps> -> label
  local bps="${1:-0}"
  local idle="${MESH_NETRATE_IDLE:-10240}"      # 10 KB/s
  local light="${MESH_NETRATE_LIGHT:-204800}"   # 200 KB/s
  local active="${MESH_NETRATE_ACTIVE:-2097152}" # 2 MB/s
  case "$bps" in ''|*[!0-9]*) echo UNKNOWN; return ;; esac
  if   [ "$bps" -lt "$idle" ];   then echo IDLE
  elif [ "$bps" -lt "$light" ];  then echo LIGHT
  elif [ "$bps" -lt "$active" ]; then echo ACTIVE
  else echo BUSY; fi
}

if [ "${1:-}" = --test ]; then
  _f=0
  [ "$(classify_rate 0)" = IDLE ]        || { echo "  FAIL: 0 bps should be IDLE"; _f=1; }
  [ "$(classify_rate 5000)" = IDLE ]     || { echo "  FAIL: 5 KB/s should be IDLE"; _f=1; }
  [ "$(classify_rate 50000)" = LIGHT ]   || { echo "  FAIL: 50 KB/s should be LIGHT"; _f=1; }
  [ "$(classify_rate 1000000)" = ACTIVE ] || { echo "  FAIL: 1 MB/s should be ACTIVE"; _f=1; }
  [ "$(classify_rate 5000000)" = BUSY ]  || { echo "  FAIL: 5 MB/s should be BUSY"; _f=1; }
  # boundary: exactly the IDLE ceiling is no longer IDLE (FALSIFIABLE edge)
  [ "$(classify_rate 10240)" = LIGHT ]   || { echo "  FAIL: 10240 (IDLE ceiling) should tip to LIGHT"; _f=1; }
  # honest-degraded: a non-numeric rate must not silently read as IDLE
  [ "$(classify_rate x)" = UNKNOWN ]     || { echo "  FAIL: non-numeric must be UNKNOWN, never IDLE"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (classify IDLE/LIGHT/ACTIVE/BUSY + boundary + non-numeric: 7 assertions)"; exit 0
fi

JSON=0; INTERVAL=2
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    [0-9]*) INTERVAL="$a" ;;
  esac
done
[ "$INTERVAL" -ge 1 ] 2>/dev/null || INTERVAL=2

# read one interface's cumulative rx/tx bytes from /proc/net/dev: "<iface> <rx_bytes> <tx_bytes>"
# picks the busiest non-loopback interface (max rx+tx cumulative) as the node's primary uplink.
pick_iface() {
  # normalise the "iface:" colon to a space first (handles a counter glued to the colon on a
  # busy iface, e.g. "eth0:12345678") so default-FS awk skips the leading indent cleanly:
  #   after sed → "<iface> <rx_bytes> ... <tx_bytes> ..."; rx=field 1 ($2), tx=field 9 ($10).
  sed 's/:/ /' /proc/net/dev 2>/dev/null | awk '
    NR>2 { iface=$1; if (iface=="lo") next; rx=$2; tx=$10; tot=rx+tx;
           if (tot>=max) { max=tot; best=iface; brx=rx; btx=tx } }
    END { if (best!="") print best, brx, btx }'
}

read -r iface rx0 tx0 <<<"$(pick_iface)"
if [ -z "${iface:-}" ]; then
  # honest-degraded: no non-loopback interface exists to measure (not a fake IDLE)
  if [ "$JSON" = 1 ]; then
    printf '{"ts":"%s","host":"%s","iface":null,"rx_bps":0,"tx_bps":0,"status":"UNREACHABLE"}\n' "$(date -u +%FT%TZ)" "$HOST"
  fi
  echo "[netrate] UNREACHABLE — no non-loopback interface in /proc/net/dev on $HOST (nothing to measure; not 'idle')" >&2
  exit 2
fi

sleep "$INTERVAL"
read -r iface2 rx1 tx1 <<<"$(pick_iface)"
ts="$(date -u +%FT%TZ)"
# guard against counter reset / iface change mid-sample → treat as 0 delta (honest, not negative)
rx_bps=$(( (rx1 - rx0) / INTERVAL )); [ "$rx_bps" -ge 0 ] 2>/dev/null || rx_bps=0
tx_bps=$(( (tx1 - tx0) / INTERVAL )); [ "$tx_bps" -ge 0 ] 2>/dev/null || tx_bps=0
total=$(( rx_bps + tx_bps ))
status="$(classify_rate "$total")"

if [ "$JSON" = 1 ]; then
  printf '{"ts":"%s","host":"%s","iface":"%s","rx_bps":%d,"tx_bps":%d,"status":"%s"}\n' \
    "$ts" "$HOST" "$iface" "$rx_bps" "$tx_bps" "$status"
  exit 0
fi

# human form: KB/s with one decimal
rx_kb=$(( rx_bps / 1024 )); tx_kb=$(( tx_bps / 1024 ))
echo "[netrate] $status — $iface rx=${rx_kb} KB/s tx=${tx_kb} KB/s (over ${INTERVAL}s) → live uplink throughput (ACTIVITY, not a presence claim)"
exit 0
