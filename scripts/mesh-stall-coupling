#!/usr/bin/env bash
# orphan-ok: on-demand joint CPU×memory stall probe; no scheduled consumer yet
# mesh-stall-coupling — a relation over two live kernel PSI axes.
#
# The signal is simultaneous CPU and memory stall pressure.  Either axis alone is
# descriptive; only their joint high state earns COUPLED.  Missing or malformed
# PSI is UNKNOWN (rc=2), never a fabricated calm.
set -u

CPU_FILE="${MESH_STALL_CPU_FILE:-/proc/pressure/cpu}"
MEMORY_FILE="${MESH_STALL_MEMORY_FILE:-/proc/pressure/memory}"
CPU_THRESHOLD="${MESH_STALL_CPU_THRESHOLD:-10.0}"
MEMORY_THRESHOLD="${MESH_STALL_MEMORY_THRESHOLD:-1.0}"

read_some_avg10() {
  awk '
    $1 == "some" {
      for (i = 2; i <= NF; i++) {
        split($i, kv, "=")
        if (kv[1] == "avg10") value = kv[2]
      }
    }
    END {
      if (value !~ /^[0-9]+([.][0-9]+)?$/) exit 1
      print value
    }
  ' "$1" 2>/dev/null
}

relation_for() {
  awk -v cpu="$1" -v memory="$2" -v ct="$CPU_THRESHOLD" -v mt="$MEMORY_THRESHOLD" \
    'BEGIN {
      if ((cpu + 0) >= (ct + 0) && (memory + 0) >= (mt + 0)) print "COUPLED"
      else if ((cpu + 0) >= (ct + 0)) print "CPU_ONLY"
      else if ((memory + 0) >= (mt + 0)) print "MEMORY_ONLY"
      else print "CALM"
    }'
}

read_relation() {
  local cpu memory relation cpu_file memory_file
  cpu_file="${MESH_STALL_CPU_FILE:-$CPU_FILE}"
  memory_file="${MESH_STALL_MEMORY_FILE:-$MEMORY_FILE}"
  cpu="$(read_some_avg10 "$cpu_file")" || return 2
  memory="$(read_some_avg10 "$memory_file")" || return 2
  relation="$(relation_for "$cpu" "$memory")"
  printf '%s\t%s\t%s\n' "$cpu" "$memory" "$relation"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  printf 'some avg10=12.5 avg60=8 avg300=4 total=100\nfull avg10=0 avg60=0 avg300=0 total=0\n' >"$td/cpu"
  printf 'some avg10=3 avg60=2 avg300=1 total=200\nfull avg10=0 avg60=0 avg300=0 total=0\n' >"$td/memory"
  fixture="$(MESH_STALL_CPU_FILE="$td/cpu" MESH_STALL_MEMORY_FILE="$td/memory" read_relation)" || {
    echo 'smoke-test: FAIL (fixture parse)'; exit 1;
  }
  [ "$(printf '%s' "$fixture" | cut -f3)" = COUPLED ] || {
    echo "smoke-test: FAIL (joint fixture: $fixture)"; exit 1;
  }
  printf 'some avg10=0 avg60=0 avg300=0 total=200\nfull avg10=0 avg60=0 avg300=0 total=0\n' >"$td/memory"
  fixture="$(MESH_STALL_CPU_FILE="$td/cpu" MESH_STALL_MEMORY_FILE="$td/memory" read_relation)" || {
    echo 'smoke-test: FAIL (one-sided fixture parse)'; exit 1;
  }
  [ "$(printf '%s' "$fixture" | cut -f3)" = CPU_ONLY ] || {
    echo "smoke-test: FAIL (one-sided fixture: $fixture)"; exit 1;
  }
  MESH_STALL_CPU_FILE="$td/missing" MESH_STALL_MEMORY_FILE="$td/memory" read_relation >/dev/null 2>&1 && {
    echo 'smoke-test: FAIL (missing PSI accepted)'; exit 1;
  }
  live="$(read_relation)" || { echo 'smoke-test: n/a (live PSI unavailable)'; exit 2; }
  printf 'smoke-test: ok (joint/one-sided fixtures + REAL CPU/memory PSI read: %s)\n' "$live"
  exit 0
fi

reading="$(read_relation)" || {
  echo "mesh-stall-coupling: UNKNOWN — cannot read both $CPU_FILE and $MEMORY_FILE" >&2
  exit 2
}
IFS=$'\t' read -r cpu memory relation <<<"$reading"
timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
case "${1:-}" in
  --json)
    printf '{"relation":"%s","cpu_some_avg10":%s,"memory_some_avg10":%s,"source_cpu":"%s","source_memory":"%s","observed_at":"%s"}\n' \
      "$relation" "$cpu" "$memory" "$CPU_FILE" "$MEMORY_FILE" "$timestamp"
    ;;
  *)
    printf '[stall-coupling] %s — cpu_some_avg10=%s memory_some_avg10=%s observed_at=%s\n' \
      "$relation" "$cpu" "$memory" "$timestamp"
    ;;
esac
