#!/usr/bin/env bash
# orphan-ok: node-bound companion loop for the mesh-home room ears (started by
#   mesh-room-transcribe.service, not cron-wired elsewhere).
# mesh-room-transcribe-loop — keep ~/.mesh/room-transcript.txt LIVE by transcribing each new
# audio-buffer chunk the mesh-overhear --daemon writes. Bridges the on-demand --hear/--ingest
# path while that is being fixed in the genome (the room pane reads --show → this file).
#
# Cheap: whisper TINY (OH_MODEL) on a handful of threads; an 18s chunk ≈ ~1s. Prunes to the
# last OH_KEEP_MIN minutes. Skips whisper hallucination lines on silence/music.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export LC_ALL=C.UTF-8   # so grep -i folds Cyrillic (else "Субтитр" won't match "субтитр" → hallucinations leak)
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
BUF="$HOME/.mesh/audio-buffer"
OUT="$HOME/.mesh/room-transcript.txt"
WHISPER="$HOME/.mesh/whispercpp/main"
MODEL="${OH_MODEL:-$HOME/.mesh/whispercpp/models/ggml-tiny.bin}"
KEEP_MIN="${OH_KEEP_MIN:-10}"
THREADS="${OH_WHISPER_THREADS:-6}"
LANG="${OH_LANG:-ru}"
MARK="$HOME/.mesh/.room-transcribe-last"   # newest chunk epoch already ingested

# hallucination fragments whisper invents on silence/music — never real speech (SUBSTRING match)
HALLU='спокойная музыка|продолжение следует|субтитр|dimatorzok|torzok|создавал|\[музыка\]|\[аплодисменты\]|^музыка$|спасибо за просмотр|редактор|корректор|thank you|^тишина$|amara|подписывайтесь|dj s'

# Stock lines whisper-tiny invents on near-silence — matched WHOLE-LINE only (2026-07-14). These are
# ordinary Russian words, so a substring match would deafen us to real speech: «Время, которое мы не
# можем сделать...» is the operator talking and must pass, while a bare «Время» is the model filling
# silence. Tonight's storm was 5x«Поехали» 5x«Время» 3x«КОНЕЦ» — all leaked through HALLU.
HALLU_LINE='поехали|конец|время|аплодисменты|динамичная музыка|играет музыка|музыка|тишина|смотрите продолжение в следующей серии|продолжение следует|субтитры'

is_real() {
  # NB: no `tr` fold here — tr does NOT fold Cyrillic under C.UTF-8 (verified), so it was a no-op on
  # Russian; the length gate rides on sed alone and grep -i does the folding.
  local t stripped
  t="$(printf '%s' "$1" | sed 's/[^[:alnum:]]//g')"
  [ "${#t}" -ge 4 ] || return 1
  printf '%s' "$1" | grep -qiE "$HALLU" && return 1
  stripped="$(printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[.!?…,]*$//')"
  printf '%s' "$stripped" | grep -qixE "$HALLU_LINE" && return 1
  return 0
}

if [ "${1:-}" = --test ]; then
  f=0
  # tonight's actual junk must be dropped
  for junk in 'Время' 'Время.' 'Поехали.' 'КОНЕЦ' 'Аплодисменты.' 'ДИНАМИЧНАЯ МУЗЫКА' 'Играет музыка.' 'Смотрите продолжение в следующей серии.'; do
    is_real "$junk" && { echo "  FAIL: hallucination leaked through: '$junk'"; f=1; }
  done
  # real speech containing those same words must survive
  for real in 'Время, которое мы не можем сделать, мы можем сделать это.' 'Миша, ты нас слышишь сейчас или нет?' 'Поехали в магазин завтра утром' 'Ну вот, Миш, плохо слушать'; do
    is_real "$real" || { echo "  FAIL: real speech dropped: '$real'"; f=1; }
  done
  # too-short noise still dies
  is_real 'ах' && { echo "  FAIL: sub-4-char noise passed"; f=1; }
  [ "$f" = 0 ] && echo "  PASS: stock hallucinations dropped, real speech survives" || exit 1
  exit 0
fi

prune() {  # keep the last N lines (robust: line-count, no awk/date — a broken time-prune emptied the file)
  [ -f "$OUT" ] || return 0
  local keep="${ROOM_KEEP_LINES:-40}"
  if [ "$(wc -l < "$OUT" 2>/dev/null || echo 0)" -gt "$keep" ]; then
    tail -n "$keep" "$OUT" > "$OUT.tmp" && [ -s "$OUT.tmp" ] && mv "$OUT.tmp" "$OUT" || rm -f "$OUT.tmp"
  fi
}

while :; do
  last=0; [ -f "$MARK" ] && last="$(cat "$MARK" 2>/dev/null || echo 0)"
  newest=0
  for W in $(ls -t "$BUF"/*.wav 2>/dev/null | head -4 | tac); do
    b="$(basename "$W" .wav)"; ep=$(( ${b:0:10} ))
    [ "$ep" -le "$last" ] && continue
    txt="$(LD_LIBRARY_PATH="$HOME/.mesh/whispercpp" "$WHISPER" -m "$MODEL" -f "$W" -l "$LANG" -nt -t "$THREADS" 2>/dev/null \
           | tr -d '\r' | tr '\n' ' ' | sed 's/  */ /g;s/^ *//;s/ *$//')"
    if [ -n "$txt" ] && is_real "$txt"; then
      printf '[%s] %s\n' "$(date -d @"$ep" +%H:%M:%S)" "$txt" >> "$OUT"
    fi
    [ "$ep" -gt "$newest" ] && newest="$ep"
  done
  [ "$newest" -gt "$last" ] && echo "$newest" > "$MARK"
  prune
  sleep "${ROOM_TRANSCRIBE_EVERY:-12}"
done
