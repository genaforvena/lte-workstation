#!/usr/bin/env bash
# Periodic witness-side lifecycle audit for board promises.
# A dispatch is routing evidence only; [taking] or an equivalent owner receipt is start evidence.
set -euo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
CHAT="${MESH_CHAT_LOG:-$MESH_DIR/chat.log}"
STATE="${MESH_WITNESS_PROMISE_STATE:-$MESH_DIR/witness-promises.state}"

status_for() {
  local owner="$1" slug="$2" board="$3"
  if grep -F '[taking]' <<<"$board" | grep -F -- "$slug" >/dev/null 2>&1; then
    printf 'started'
  elif grep -F '[dispatch]' <<<"$board" | grep -F -- "$slug" >/dev/null 2>&1; then
    printf 'dispatched-but-not-started'
  else
    printf 'not-dispatched'
  fi
}

if [[ "${1:-}" == --test ]]; then
  fixture='2026-09-07T00:00:00Z witness :: [dispatch] → genome: Board task assigned; TASK: tiny-fleet-corpus-fixture-manifest'
  [[ "$(status_for genome tiny-fleet-corpus-fixture-manifest "$fixture")" == dispatched-but-not-started ]] || exit 1
  fixture+=$'\n2026-09-07T00:01:00Z genome :: [taking] tiny-fleet-corpus-fixture-manifest'
  [[ "$(status_for genome tiny-fleet-corpus-fixture-manifest "$fixture")" == started ]] || exit 1
  [[ "$(status_for genome missing-task "$fixture")" == not-dispatched ]] || exit 1
  printf '%s\n' 'not-dispatched' 'dispatched-but-not-started' 'started' 'mesh-witness-promises --test: PASS'
  exit 0
fi

command -v mesh-board >/dev/null 2>&1 || { echo 'mesh-witness-promises: mesh-board unavailable' >&2; exit 2; }
mesh-promises --feed >/dev/null 2>&1 || true
board="$(cat "$CHAT" 2>/dev/null || true)"
mkdir -p "$(dirname "$STATE")"
touch "$STATE"
alerts=0
needs_retry=0
while IFS=$'\t' read -r owner slug priority lead; do
  [[ -n "$owner" && -n "$slug" ]] || continue
  status="$(status_for "$owner" "$slug" "$board")"
  [[ "$status" == started ]] && continue
  needs_retry=$((needs_retry+1))
  sig="$owner|$slug|$status"
  if ! grep -Fqx -- "$sig" "$STATE"; then
    printf '%s\n' "$sig" >>"$STATE"
    MESH_WHO=witness mesh-chat "[fyi] promise lifecycle audit: $slug owner=$owner status=$status; dispatch is not start evidence. Require owner [taking]/live receipt, then artifact and verification." >/dev/null 2>&1 || true
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$owner" "$slug" "$status"
    alerts=$((alerts+1))
  fi
done < <(mesh-board open --dispatch 2>/dev/null || true)

# Durable chain lifecycle is independently audited: an open dispatch has no owner receipt,
# an expired live owner needs a renewal, and an abandoned owner needs reassignment. BLOCKED is
# deliberately observable but never fed to mesh-dispatch before its retry edge.
if command -v mesh-task >/dev/null 2>&1; then
  while IFS=$'\t' read -r lifecycle owner task detail; do
    [[ -n "$lifecycle" && -n "$task" ]] || continue
    sig="chain|$lifecycle|$owner|$task|$detail"
    grep -Fqx -- "$sig" "$STATE" && continue
    printf '%s\n' "$sig" >>"$STATE"
    if [[ "$lifecycle" != BLOCKED ]]; then
      MESH_WHO=witness mesh-chat "[fyi] task lifecycle audit: task:$task owner=$owner state=$lifecycle $detail; exact ownership/progress required." >/dev/null 2>&1 || true
      alerts=$((alerts+1))
    fi
    printf '%s\t%s\t%s\t%s\n' "$lifecycle" "$owner" "$task" "$detail"
  done < <(mesh-task audit 2>/dev/null || true)
fi

# Keep the existing pacing/ownership policy as the actuator for anything still not started.
if (( needs_retry > 0 )); then
  mesh-dispatch >/dev/null 2>&1 || true
fi
printf 'mesh-witness-promises: audited alerts=%d retry_candidates=%d\n' "$alerts" "$needs_retry"
