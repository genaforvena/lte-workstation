#!/usr/bin/env bash
# Periodic witness-side lifecycle audit for board promises.
# A dispatch is routing evidence only; [taking] or an equivalent owner receipt is start evidence.
set -euo pipefail

# Cron invokes this file by absolute path with a deliberately minimal PATH.  Resolve
# the sibling source tools and the installed mesh tools before any command -v gate;
# otherwise the reflex silently stops at "mesh-board unavailable" and the witness
# dashboard keeps rendering an old coordination summary.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if ! command -v mesh-board >/dev/null 2>&1; then
  export PATH="$HOME/.local/bin:$SCRIPT_DIR:$PATH"
fi

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
CHAT="${MESH_CHAT_LOG:-$MESH_DIR/chat.log}"
STATE="${MESH_WITNESS_PROMISE_STATE:-$MESH_DIR/witness-promises.state}"
SUMMARY="${MESH_WITNESS_COORDINATION_SUMMARY:-$MESH_DIR/witness-coordination.summary}"
CHAT_CMD="${MESH_WITNESS_PROMISE_CHAT:-mesh-chat}"

status_for() {
  local owner="$1" slug="$2" board="$3"
  printf '%s\n' "$board" | python3 -c '
import re, sys
owner, slug = sys.argv[1:]
def key(value):
    return re.sub(r"[\W_]+", "-", value.lower()).strip("-")
status = "not-dispatched"
for line in sys.stdin:
    match = re.match(r"^\S+\s+(\S+)\s+::\s+(?:\[@[^]]+\]\s*)*\[(taking|dispatch|yield)\]\s*(.*)$", line)
    if not match:
        continue
    author, kind, body = match.groups()
    explicit = re.search(r"(?:^|[ ;])task:\s*([^\s,;]+)", body, re.I)
    identity = explicit.group(1) if explicit else body.split()[0].rstrip(":") if body.split() else ""
    if key(identity) != key(slug):
        continue
    if kind == "dispatch":
        if status != "started":
            status = "dispatched-but-not-started"
    elif author.split("@")[0] == owner:
        status = "started" if kind == "taking" else "not-dispatched"
print(status, end="")
' "$owner" "$slug"
}

post_alert() {
  # An untargeted board line is only a record; it cannot wake the mind that owes the
  # reconciliation.  Targeted delivery is durable/idle-gated, and the caller records
  # the dedupe key only after this post succeeds so a failed route remains retryable.
  local message="$1"
  MESH_WHO=witness "$CHAT_CMD" --to witness "$message" >/dev/null 2>&1
}

record_alert() {
  local sig="$1" message="$2"
  grep -Fqx -- "$sig" "$STATE" 2>/dev/null && return 0
  if post_alert "$message"; then
    printf '%s\n' "$sig" >>"$STATE"
    return 0
  fi
  printf 'mesh-witness-promises: targeted alert failed (will retry): %s\n' "$sig" >&2
  return 1
}

if [[ "${1:-}" == --test ]]; then
  fixture='2026-09-07T00:00:00Z witness :: [dispatch] → genome: Board task assigned; TASK: tiny-fleet-corpus-fixture-manifest'
  [[ "$(status_for genome tiny-fleet-corpus-fixture-manifest "$fixture")" == dispatched-but-not-started ]] || exit 1
  fixture+=$'\n2026-09-07T00:01:00Z genome :: [taking] tiny-fleet-corpus-fixture-manifest'
  [[ "$(status_for genome tiny-fleet-corpus-fixture-manifest "$fixture")" == started ]] || exit 1
  [[ "$(status_for genome missing-task "$fixture")" == not-dispatched ]] || exit 1
  fixture='2026-09-08T03:24:39Z job@mesh-home :: [taking] chain/02-supply-map: job; task:chain/02-supply-map, owner:job'
  [[ "$(status_for job chain-02-supply-map "$fixture")" == started ]] || { echo 'FAIL: canonical chain receipt missed'; exit 1; }
  [[ "$(status_for genome chain-02-supply-map "$fixture")" == not-dispatched ]] || { echo 'FAIL: foreign owner accepted'; exit 1; }
  fixture='2026-09-08T03:24:39Z job@mesh-home :: [taking] work-extra: task:work-extra, owner:job'
  [[ "$(status_for job work "$fixture")" == not-dispatched ]] || { echo 'FAIL: sibling task accepted'; exit 1; }
  printf '%s\n' 'not-dispatched' 'dispatched-but-not-started' 'started' 'mesh-witness-promises --test: PASS'
  exit 0
fi

command -v mesh-board >/dev/null 2>&1 || { echo 'mesh-witness-promises: mesh-board unavailable' >&2; exit 2; }
ledger_status=PASS
ledger_error=''
if ! command -v mesh-promises >/dev/null 2>&1; then
  ledger_status=FAIL
  ledger_error='mesh-promises unavailable'
elif ! mesh-promises --feed >/dev/null 2>&1; then
  ledger_status=FAIL
  ledger_error='promise ledger/feed failed'
elif ! mesh-promises --check >/dev/null 2>&1; then
  ledger_status=FAIL
  ledger_error='promise ledger/check failed'
fi
board="$(cat "$CHAT" 2>/dev/null || true)"
mkdir -p "$(dirname "$STATE")"
touch "$STATE"
summary_tmp="${SUMMARY}.tmp.$$"
mkdir -p "$(dirname "$SUMMARY")"
printf 'timestamp=%s\n' "$(date -u +%FT%TZ)" >"$summary_tmp"
printf 'promise_ledger=%s\n' "$ledger_status" >>"$summary_tmp"
if [[ "$ledger_status" != PASS ]]; then
  mkdir -p "$(dirname "$STATE")"
  touch "$STATE"
  ledger_sig="ledger|$ledger_error"
  record_alert "$ledger_sig" "[fyi] promise ledger audit failed: $ledger_error; witness must repair/recheck ledger before routing" || true
  printf 'mesh-witness-promises: %s\n' "$ledger_error" >&2
  mv -f -- "$summary_tmp" "$SUMMARY"
  exit 1
fi
alerts=0
needs_retry=0
while IFS=$'\t' read -r owner slug priority lead; do
  [[ -n "$owner" && -n "$slug" ]] || continue
  status="$(status_for "$owner" "$slug" "$board")"
  [[ "$status" == started ]] && continue
  needs_retry=$((needs_retry+1))
  sig="$owner|$slug|$status"
  if ! grep -Fqx -- "$sig" "$STATE"; then
    if record_alert "$sig" "[fyi] promise lifecycle audit: $slug owner=$owner status=$status; dispatch is not start evidence. Require owner [taking]/live receipt, then artifact and verification."; then
      alerts=$((alerts+1))
    fi
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$owner" "$slug" "$status"
  fi
done < <(mesh-board open --dispatch 2>/dev/null || true)

# Durable chain lifecycle is independently audited: an open dispatch has no owner receipt,
# and an overdue owner needs a visible progress, block, done, or reasoned-ignore decision.
# Lease age is an attention signal, never a reassignment or closure. BLOCKED is deliberately
# observable but never fed to mesh-dispatch before its retry edge.
if command -v mesh-task >/dev/null 2>&1; then
  chain_audit="$(mesh-task audit 2>/dev/null || true)"
  chain_findings=0
  chain_total=0
  while IFS=$'\t' read -r lifecycle owner task detail rest; do
    [[ -n "$lifecycle" && -n "$task" ]] || continue
    chain_total=$((chain_total+1))
    chain_detail="$detail"
    [[ -n "$rest" ]] && chain_detail+=$'\t'"$rest"
    printf '%s\t%s\t%s\t%s\n' "$lifecycle" "$owner" "$task" "$chain_detail" >>"$summary_tmp"
    case "$lifecycle" in
      DONE|IGNORED|QUEUED|RUNNING) ;;
      *) chain_findings=$((chain_findings+1));;
    esac
  done <<<"$chain_audit"
  printf 'chain_steps=%d findings=%d status=%s\n' "$chain_total" "$chain_findings" \
    "$([[ "$chain_findings" -eq 0 ]] && echo PASS || echo FAIL)" >>"$summary_tmp"
  while IFS=$'\t' read -r lifecycle owner task detail rest; do
    [[ -n "$lifecycle" && -n "$task" ]] || continue
    case "$lifecycle" in
      DONE|IGNORED|QUEUED|RUNNING) continue ;;
    esac
    # Re-deliver only genuinely unclaimed work. An active task remains owned regardless
    # of lease age: its owner must progress, block, complete, or reasonedly ignore it.
    case "$lifecycle" in
      OPEN_UNOWNED)
        MESH_TASK_ACTOR=witness mesh-task reschedule-task "$task" >/dev/null 2>&1 || \
          printf 'mesh-witness-promises: task re-schedule failed: %s\n' "$task" >&2
        ;;
    esac
    sig="chain|$lifecycle|$owner|$task|$detail"
    grep -Fqx -- "$sig" "$STATE" && continue
    if [[ "$lifecycle" != BLOCKED ]]; then
      if record_alert "$sig" "[fyi] task lifecycle audit: task:$task owner=$owner state=$lifecycle $detail; exact ownership/progress required."; then
        alerts=$((alerts+1))
      fi
    else
      # BLOCKED is still a durable finding, but it is deliberately not a wake/alert.
      printf '%s\n' "$sig" >>"$STATE"
    fi
    chain_detail="$detail"
    [[ -n "$rest" ]] && chain_detail+=$'\t'"$rest"
    printf '%s\t%s\t%s\t%s\n' "$lifecycle" "$owner" "$task" "$chain_detail"
  done <<<"$chain_audit"
fi

mv -f -- "$summary_tmp" "$SUMMARY"

# Keep the existing pacing/ownership policy as the actuator for anything still not started.
if (( needs_retry > 0 )); then
  mesh-dispatch >/dev/null 2>&1 || true
fi
printf 'mesh-witness-promises: audited alerts=%d retry_candidates=%d\n' "$alerts" "$needs_retry"
[[ "$ledger_status" == PASS ]] || exit 1
