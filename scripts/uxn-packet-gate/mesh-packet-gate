#!/usr/bin/env bash
# orphan-ok: on-demand/opt-in filter — a node CHOOSES to run --run <qnum> behind its own iptables
#   NFQUEUE rule (a single-writer substrate change); never cron-wired mesh-wide. --test is the test-*
#   harness. Same intentional-unwired class as the other scripts/uxn gate ROMs.
# mesh-packet-gate — the shell entry for the uxn packet-filter unit (uxn-packet-gate 2026-07-24).
#
# The filter DECISION is a byte-identical portable ROM (packet-gate.rom); the NFQUEUE plumbing is the
# vendored-emulator harness (nfq-gate). This shim is the operator-facing verbs + the gate's --test.
#
#   mesh-packet-gate --one <proto src_hi src_lo dst_hi dst_lo sport dport len>
#                                    one-shot verdict, rc 0 ACCEPT · 1 DROP · 2 n/a  (mesh-rom-gate
#                                    rc contract; verdict via the SAME embedded emulator NFQUEUE uses)
#   mesh-packet-gate --pps [iters]   measure ROM decisions/sec on THIS node, append a ledger row
#   mesh-packet-gate --ledger        append a {sha256,pps,contract} row to ~/.mesh/packet-gate.log
#   mesh-packet-gate --run <qnum>    attach to NFQUEUE <qnum> and filter (needs root; on-demand/unit)
#   mesh-packet-gate --test          RED-first proof: a REAL packet through a REAL NFQUEUE, in an
#                                    isolated netns (never the host substrate), seen NOT-dropped by an
#                                    accept-all ROM, then DROPPED by the real ROM. Plus the rc 0/1/2
#                                    truth table and the sha256 hash-then-run pin. rc 0 green · 1 FAIL
#                                    · 2 honest n/a (no root / no NFQUEUE / no netns on this node).
#
# exit/verdict contract is the threshold-ledger family: OK->ACCEPT(rc0), RED->DROP(rc1), NA->n/a(rc2).
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"
ROM="${PACKET_GATE_ROM:-$HERE/packet-gate.rom}"
LEDGER="${MESH_PACKET_GATE_LOG:-$HOME/.mesh/packet-gate.log}"
BIN="$HERE/nfq-gate"

ensure_built() {
	[ -f "$ROM" ] || ./build.sh --rom >/dev/null 2>&1 || true
	[ -x "$BIN" ] || ./build.sh --bin >/dev/null 2>&1 || true
}

rom_sha() { sha256sum "$ROM" 2>/dev/null | cut -d' ' -f1; }

# verify the vendored emulator against VENDOR-MANIFEST — the pin is a GATE (a provenance comment is a
# claim; these sha256 rows are the artifact). Any drift/patch not re-pinned fails here.
verify_manifest() {
	local man="$HERE/VENDOR-MANIFEST" bad=0 sha path
	[ -f "$man" ] || { echo "no VENDOR-MANIFEST" >&2; return 2; }
	while read -r sha path; do
		case "$sha" in ''|\#*) continue;; esac
		[ -f "$HERE/emu/$path" ] || { echo "manifest: missing emu/$path" >&2; bad=1; continue; }
		local actual; actual="$(sha256sum "$HERE/emu/$path" | cut -d' ' -f1)"
		[ "$actual" = "$sha" ] || { echo "manifest: emu/$path sha256 drift (pinned $sha actual $actual)" >&2; bad=1; }
	done < "$man"
	return $bad
}

# --note3: prove the SAME ROM runs byte-identically on the Note3 (armhf) with the SAME verdict.
# rc 0 proven · 1 differs/wrong-verdict · 2 honest n/a (phone unreachable / no on-device uxncli).
note3_proof() {
	command -v adb >/dev/null || { echo "note3: n/a — no adb on this node" >&2; return 2; }
	local S="${MESH_BODY_ADB_SERIAL:-4d00553d61ab90b7}" D="${MESH_BODY_GATE_DIR:-/data/local/tmp}"
	adb -s "$S" get-state 2>/dev/null | grep -q device || { echo "note3: n/a — Note3 ($S) unreachable over adb" >&2; return 2; }
	local CLI; CLI="$(adb -s "$S" shell "for c in $D/uxncli-new $D/uxncli; do [ -x \$c ] && echo \$c && break; done" | tr -d '\r')"
	[ -n "$CLI" ] || { echo "note3: n/a — no on-device uxncli (run scripts/uxn/verify-note3.sh)" >&2; return 2; }
	adb -s "$S" push "$ROM" "$D/packet-gate.rom" >/dev/null 2>&1 || { echo "note3: n/a — adb push failed" >&2; return 2; }
	local v; v="$(adb -s "$S" shell "$CLI $D/packet-gate.rom 6 2056 2056 3232 235 44000 22 60" | tr -d '\r' | tr -d '[:space:]')"
	adb -s "$S" pull "$D/packet-gate.rom" /tmp/pg.fromnote3.$$ >/dev/null 2>&1
	local x a; x="$(rom_sha)"; a="$(sha256sum /tmp/pg.fromnote3.$$ 2>/dev/null | cut -d' ' -f1)"
	rm -f /tmp/pg.fromnote3.$$
	if [ "$v" = RED ] && [ "$x" = "$a" ]; then
		echo "note3: armhf verdict RED (non-LAN TCP:22) · byte-identical sha256=$x"
		return 0
	fi
	echo "note3: MISMATCH — armhf verdict='$v' (want RED), sha256 x86=$x armhf=$a" >&2
	return 1
}

case "${1:---test}" in
--one)
	shift
	ensure_built
	PACKET_GATE_ROM="$ROM" "$BIN" --one "$@"
	exit $?
	;;
--pps)
	ensure_built
	out="$(PACKET_GATE_ROM="$ROM" "$BIN" --pps "${2:-200000}")"
	echo "$out"
	pps="$(printf '%s' "$out" | sed -n 's/^pps=\([0-9]*\).*/\1/p')"
	mkdir -p "$(dirname "$LEDGER")"
	printf '%s pps sha256=%s pps=%s node=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(rom_sha)" "${pps:-NA}" "$(hostname)" >> "$LEDGER"
	exit 0
	;;
--ledger)
	ensure_built
	sha="$(rom_sha)"
	# contract self-check: the rc 0/1/2 polarities through the embedded emulator.
	c_red=$(PACKET_GATE_ROM="$ROM" "$BIN" --one 6 2056 2056 3232 235 44000 22 60 >/dev/null 2>&1; echo $?)
	c_ok=$(PACKET_GATE_ROM="$ROM" "$BIN" --one 6 49320 2053 3232 235 44000 22 60 >/dev/null 2>&1; echo $?)
	c_na=$(PACKET_GATE_ROM="$ROM" "$BIN" --one 6 1 >/dev/null 2>&1; echo $?)
	contract="drop=$c_red accept=$c_ok na=$c_na"
	pps="$(PACKET_GATE_ROM="$ROM" "$BIN" --pps 200000 | sed -n 's/^pps=\([0-9]*\).*/\1/p')"
	mkdir -p "$(dirname "$LEDGER")"
	printf '%s ledger sha256=%s pps=%s contract=[%s] size=%sb node=%s\n' \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" "${pps:-NA}" "$contract" "$(wc -c <"$ROM")" "$(hostname)" >> "$LEDGER"
	echo "packet-gate ledger: sha256=$sha pps=$pps contract=[$contract]"
	exit 0
	;;
--run)
	ensure_built
	exec sudo -n env PACKET_GATE_ROM="$ROM" "$BIN" "${2:?usage: --run <queue-num>}"
	;;
--verify)
	verify_manifest && echo "VENDOR-MANIFEST: ok (vendored emulator matches pins)" && exit 0
	echo "VENDOR-MANIFEST: FAIL" >&2; exit 1
	;;
--note3)
	ensure_built
	note3_proof; exit $?
	;;
--test) : ;;   # fall through to the test body below
*) echo "usage: $0 [--one|--pps|--ledger|--run|--test] …" >&2; exit 2 ;;
esac

# ================================ --test ================================
ensure_built
FAIL=0
naexit() { echo "packet-gate-test: n/a — $*" >&2; exit 2; }
fail()   { echo "  FAIL: $*"; FAIL=1; }

[ -f "$ROM" ] || naexit "no ROM at $ROM (build?)"
[ -x "$BIN" ] || naexit "no nfq-gate binary (build?)"

echo "== 0. VENDOR-MANIFEST pin (vendored uxn.c emulator, like chibicc) =="
if verify_manifest; then echo "  ok: emu/ matches VENDOR-MANIFEST (uxn.c a7029a2b…, +system/console)"; else fail "vendored emulator drifted from VENDOR-MANIFEST"; fi

echo "== 1. verdict rc 0/1/2 truth table (packet-fixtures, embedded emulator == mesh-rom-gate) =="
# ONE source of truth: drive every row of packet-fixtures through the embedded emulator.
FIX="$HERE/packet-fixtures"
if [ -f "$FIX" ]; then
	while IFS= read -r line; do
		case "$line" in ''|\#*) continue;; esac
		etxt="$(printf '%s' "$line" | awk -F'|' '{print $1}' | awk '{print $1}')"
		erc="$(printf '%s' "$line" | awk -F'|' '{print $1}' | awk '{print $2}')"
		flds="$(printf '%s' "$line" | awk -F'|' '{print $2}')"
		# shellcheck disable=SC2086
		out="$(PACKET_GATE_ROM="$ROM" "$BIN" --one $flds 2>/dev/null)"; rc=$?
		out="${out%$'\n'}"
		if [ "$rc" = "$erc" ] && [ "$out" = "$etxt" ]; then echo "  ok: [$flds] -> $out/rc$rc"
		else fail "[$flds] want $etxt/rc$erc got '$out'/rc$rc"; fi
	done < "$FIX"
else fail "no packet-fixtures at $FIX"; fi
# cross-check the SAME ROM through mesh-rom-gate (the shell/uxncli path) if present.
if [ -x ../mesh-rom-gate ]; then
	v="$(../mesh-rom-gate "$ROM" 6 2056 2056 3232 235 44000 22 60 2>/dev/null)"; rc=$?
	[ "$rc" = 1 ] && [ "$v" = RED ] || fail "mesh-rom-gate path disagrees: want RED/rc1 got '$v'/rc$rc"
	echo "  ok: mesh-rom-gate path agrees (RED/rc1) — one ROM, two runners"
fi

echo "== 2. sha256 hash-then-execute pin (harness refuses a tampered ROM) =="
real="$(rom_sha)"
mine="$(PACKET_GATE_ROM_SHA256=deadbeef PACKET_GATE_ROM="$ROM" "$BIN" --one 6 1 1 1 1 1 1 1 2>&1 | sed -n 's/.*actual \([0-9a-f]*\).*/\1/p')"
[ "$mine" = "$real" ] || fail "harness sha256 ($mine) != sha256sum ($real)"
cp "$ROM" /tmp/pg-tamper.$$ && printf '\x00' >> /tmp/pg-tamper.$$
PACKET_GATE_ROM_SHA256="$real" PACKET_GATE_ROM=/tmp/pg-tamper.$$ "$BIN" --one 6 1 1 1 1 1 1 1 >/dev/null 2>/tmp/pg-tamper-err.$$
trc=$?
terr="$(cat /tmp/pg-tamper-err.$$ 2>/dev/null)"
rm -f /tmp/pg-tamper.$$ /tmp/pg-tamper-err.$$
if [ "$trc" = 2 ] && printf '%s' "$terr" | grep -q mismatch; then
	echo "  ok: tampered ROM refused pre-exec (rc2, sha256 mismatch)"
else
	fail "tampered ROM not refused (rc=$trc, err='$terr')"
fi

echo "== 3. REAL packet through REAL NFQUEUE in a netns — RED-first, then GREEN =="
if ! nm "$BIN" 2>/dev/null | grep -qi nfq_create_queue; then
	echo "  n/a: nfq-gate built without NFQUEUE (--one/--pps still gated above)"
else
  if ! sudo -n true 2>/dev/null; then echo "  n/a: no NOPASSWD sudo (real-packet test needs root)";
  elif ! command -v python3 >/dev/null; then echo "  n/a: no python3 for the probe";
  else
	NS="pgtest$$"
	cleanup_ns() { sudo -n ip netns pids "$NS" 2>/dev/null | xargs -r sudo -n kill 2>/dev/null; sudo -n ip netns del "$NS" 2>/dev/null; }
	trap cleanup_ns EXIT
	if ! sudo -n ip netns add "$NS" 2>/dev/null; then echo "  n/a: cannot create netns"; else
		sudo -n ip netns exec "$NS" ip link set lo up
		if ! sudo -n ip netns exec "$NS" iptables -A OUTPUT -o lo -p tcp -j NFQUEUE --queue-num 5 2>/dev/null; then
			echo "  n/a: iptables NFQUEUE target unavailable in netns"
		else
			# probe <rom> -> prints "<port22-result> <port443-result>": connected|refused|timeout|err
			probe() {
				local rom="$1" log="/tmp/pg-nfq.$$"
				sudo -n ip netns exec "$NS" env PACKET_GATE_ROM="$rom" "$BIN" 5 >"$log" 2>&1 &
				local qpid=$!
				sleep 0.4
				local pyc='import socket
def t(p):
 s=socket.socket();s.settimeout(1.5)
 try:
  s.connect(("127.0.0.1",p));return "connected"
 except ConnectionRefusedError:return "refused"
 except socket.timeout:return "timeout"
 except Exception as e:return "err:"+type(e).__name__
 finally:
  s.close()
print(t(22),t(443))'
				local out
				out="$(sudo -n ip netns exec "$NS" python3 -c "$pyc" 2>/dev/null)"
				sudo -n kill "$qpid" 2>/dev/null; wait "$qpid" 2>/dev/null
				rm -f "$log"
				echo "$out"
			}
			# RED-FIRST: an accept-all ROM must let :22 through (refused, i.e. NOT dropped) — proving
			# the test can OBSERVE a non-drop (a gate never seen fail is not a gate).
			sed 's/if (proto == 6 && dport == 22 && !is_lan_src)/if (0)/' packet-gate.c > /tmp/pg-accept.$$.c
			if ../uxn/cc-rom.sh /tmp/pg-accept.$$.c /tmp/pg-accept.$$.rom >/dev/null 2>&1; then
				red="$(probe /tmp/pg-accept.$$.rom)"; r22="${red% *}"
				if [ "$r22" = refused ]; then echo "  RED-first ok: accept-all ROM lets :22 through ($red) — the DROP assertion CAN fail"
				else fail "RED-first inconclusive: accept-all :22 was '$r22' (expected refused)"; fi
			else fail "could not build accept-all mutant"; fi
			rm -f /tmp/pg-accept.$$.c /tmp/pg-accept.$$.rom
			# GREEN: the real ROM DROPs :22 (SYN filtered -> timeout) and ACCEPTs :443 (passed -> refused).
			grn="$(probe "$ROM")"; g22="${grn% *}"; g443="${grn#* }"
			[ "$g22" = timeout ]  || fail "real ROM must DROP :22 through NFQUEUE (got '$g22', full: $grn)"
			[ "$g443" = refused ] || fail "real ROM must ACCEPT :443 through NFQUEUE (got '$g443', full: $grn)"
			[ "$g22" = timeout ] && [ "$g443" = refused ] && \
				echo "  GREEN ok: real ROM DROPs :22 (timeout) + ACCEPTs :443 (refused) via live NFQUEUE ($grn)"
		fi
	fi
	cleanup_ns; trap - EXIT
  fi
fi

echo "== 4. pps sanity (a number, not 'fast') =="
pps="$(PACKET_GATE_ROM="$ROM" "$BIN" --pps 50000 | sed -n 's/^pps=\([0-9]*\).*/\1/p')"
[ -n "$pps" ] && [ "$pps" -gt 0 ] 2>/dev/null && echo "  ok: $pps decisions/sec" || fail "pps not measured ('$pps')"

echo "== 5. same ROM byte-identical + same verdict on Note3 (armhf) =="
n3="$(note3_proof 2>&1)"; nrc=$?
if [ "$nrc" = 0 ]; then echo "  ok: $n3"
elif [ "$nrc" = 2 ]; then echo "  n/a: ${n3#note3: n/a — }"   # honest n/a — phone unreachable, never a fake green
else fail "$n3"; fi

if [ "$FAIL" = 0 ]; then
	echo "packet-gate-test: ok (manifest · rc0/1/2 truth table · sha256 pin · RED-first→GREEN real NFQUEUE drop · pps=$pps · note3 armhf)"
	exit 0
else
	echo "packet-gate-test: FAIL"
	exit 1
fi
