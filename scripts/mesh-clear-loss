#!/usr/bin/env bash
# mesh-clear-loss — the JUDGE-FREE meter for what a /clear COSTS (mind-recycle spec, 2026-07-18).
#
# The mind-recycle policy clears a mind after a stop and carries work forward through the durable
# handoff (mesh-handoff's extraction, restored by the SessionStart hook). The open question is not
# "does the plumbing run" — shadow mode already proves that. It is also NOT "did a classifier approve the
# clear": that gate is gone (2026-07-24), and it was near-tautological anyway — the handoff is extracted
# FROM the scrollback, so a coverage check almost always said "covered". The real question is a SERIALIZATION ROUND-TRIP one: does clearing DROP a
# mid-turn discovery? This tool measures that with a ground truth, not a classifier.
#
#   mesh-clear-loss --canary [--task-type T] [--n K]   run canaries: recycled arm vs control arm,
#                                                       binary verify, append per-run rows to the ledger
#   mesh-clear-loss --report                            print cost = failrate(recycled) − failrate(control)
#                                                       per task-type from the ledger
#   mesh-clear-loss --catchup [--task-type T] [--n K]   boot-time: run a sweep IFF the ledger has gone stale
#                                                       (missed daily cron slot); fresh ledger = no-op
#   mesh-clear-loss --probe <win>                       (secondary, continuous) round-trip probe — SCAFFOLD
#   mesh-clear-loss --test                              RED-first: pure verify + arm-wiring + KNOWN-DROPPED
#                                                       calibration (the meter must DETECT loss when it exists)
#
# CANARY (primary, judge-free). Each canary plants a constraint C in step1 that step2's correct answer
# must honor WITHOUT step2 restating it; verify(step2_output) is a real predicate encoding C — reality
# grades it, NO judge model in the scoring path. Two arms, ALWAYS both:
#   · recycled arm: run step1 → EXTRACT a handoff (mesh-handoff's _extract_terse, verbatim) → discard the
#     step1 context, restore the handoff ONLY → run step2 → verify.
#   · control  arm: identical, NO clear between step1 and step2 (full step1 context retained).
# cost(task-type) = failrate_recycled − failrate_control. The control subtracts the baseline a mind flunks
# WITHOUT any clear (ambiguous task / just-forgot); the DIFFERENCE is the loss attributable to the clear,
# denominated in dropped directives. Same reasoner on both arms → the differential is meaningful even when
# the absolute rate is reasoner-dependent (stand-in reasoner; a v2 routes arms to real mind panes).
#
# REUSE, DON'T FORK. Real handoff extraction is mesh-handoff's `_extract_terse` (sourced via lib mode),
# so there is one extractive path, not a second copy. The reasoner is pluggable (MESH_CANARY_MIND_CMD);
# --test drives everything with deterministic stubs so the gate needs no live model.
#
# reflex-cadence: 17 4 * * *
# reflex-args: --canary
#   The daily canary sweep FEEDS the ledger the audit reads. The mind-recycle spec (§Sequencing) wants a
#   WEEK of numbers, not one manual snapshot — left on-demand, the ledger froze at N=12 while mesh-clear-audit
#   kept reading it every 5min as authoritative. Now a sweep runs daily; --report stamps LAST_TS so the audit
#   can FLAG a FROZEN ledger (dead canary cron → stale → not authoritative), the twin of its 'meter-absent'
#   guard. Still runnable on demand; the cron sweep spends via mesh-relay (~16 reasoner calls/run). A 2-day
#   audit staleness budget tolerates one missed daily run before flagging.
set -uo pipefail
# cron hands this script a bare PATH (/usr/bin:/bin) — without ~/.local/bin, _reason's
# `command -v mesh-relay` fails and EVERY canary row lands as SKIP (the ledger froze on SKIPs from the
# first cron run, 2026-07-19, while manual runs kept working — the meter was dead only under cron).
export PATH="$HOME/.local/bin:$PATH"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
# Ledger path is ~/.mesh/clear-loss.log — named literally here so mesh-autowire's journal-collision guard
# (greps the source for .mesh/<stem>.log) routes the cron STDOUT journal to clear-loss.cron.log, NOT this
# ledger (a stdout redirect INTO the ledger would double-count every canary row printed to progress).
LEDGER="${MESH_CLEAR_LOSS_LOG:-$MESH_DIR/clear-loss.log}"   # == $HOME/.mesh/clear-loss.log
CORPUS="${MESH_CLEAR_LOSS_CORPUS:-}"        # optional external corpus file (pipe-sep, see below); else built-in

# --- reasoner: reads a full prompt on stdin, emits the mind's response on stdout ---
# default = a local scratch context via mesh-relay (text→cheapest pool→text). test overrides with a stub.
_reason() {
  if [ -n "${MESH_CANARY_MIND_CMD:-}" ]; then eval "$MESH_CANARY_MIND_CMD"; return; fi
  command -v mesh-relay >/dev/null 2>&1 || { echo "__NO_REASONER__"; return; }
  mesh-relay 2>/dev/null
}

# --- handoff extractor: transcript on stdin → handoff on stdout. Reuse the mesh's ONE extractor, don't fork.
# It used to be mesh-clear's `_extract_handoff` (a model call at clear time); when the clear-gate's model was
# removed (2026-07-24, operator: "dead simple") the extractive path collapsed onto mesh-handoff's
# `_extract_terse` — the same deterministic furniture-stripping the */5 snapshot uses. The canary must extract
# what a REAL clear extracts, or it measures a handoff nothing in the mesh actually writes. ---
_extract() {
  if [ -n "${MESH_CLEAR_LOSS_EXTRACT_CMD:-}" ]; then eval "$MESH_CLEAR_LOSS_EXTRACT_CMD"; return; fi
  if command -v mesh-handoff >/dev/null 2>&1 && MESH_HANDOFF_LIB_ONLY=1 . "$(command -v mesh-handoff)" 2>/dev/null; then
    _extract_terse          # mesh-handoff's extractive generator (verbatim; no invented next-step)
  else
    cat                     # last resort: carry the whole transcript (over-generous; flagged)
  fi
}

# --- built-in canary corpus. Fields: id | task_type | step1 | step2 | violation_regex ---
# violation_regex MATCHES step2 output  ⇒  the constraint was DROPPED  ⇒  FAIL (a loss).
# Spread across the tacit-discovery axis: `budget`/`schema` constraints emerge from doing step1 and a
# mind would not naturally spell them into a handoff (tacit); `naming` is more handoff-able (plumbing floor).
_builtin_corpus() {
  cat <<'EOF'
batch-cap|budget|Read the job runner config. It reports MAX_CONCURRENT=3 — the runner corrupts state if more than 3 jobs are dispatched at once. Acknowledge the limit.|Now dispatch these 7 queued jobs as efficiently as possible. Show the dispatch batches.|([4-9]|1[0-9]) *jobs|batch of ([4-9]|[1-9][0-9])|all *7|7 *at *once
schema-key|schema|Inspect the events table. The primary key is (tenant_id, ts) — tenant_id is REQUIRED on every row or the insert is rejected.|Write an INSERT for a new event with action='login' and ts=now. Give the SQL.|(?i)insert[^;]*events(?![^;]*tenant)
unit-mm|units|Query the sensor. It returns distance in MILLIMETRES, not metres.|Report whether the object at raw reading 4200 is within the 3-metre safety zone. Answer yes or no with the comparison.|(?i)(4200 *m\b|4200 *metre|is (within|inside).*yes)
alias-name|naming|The service is registered under the alias 'billing-v2', NOT 'billing'. Requests to 'billing' 404.|Write the curl command to hit the health endpoint of the billing service.|(?i)/billing/(?!v2)|host: *billing\.|billing\.internal
EOF
}

# --- verify: binary. $1=violation_regex, stdin=step2 output → prints PASS|FAIL ---
_verify() {
  # PCRE (-P), not -E: the violation patterns use case-insensitive `(?i)` and negative lookahead
  # `(?!...)` (e.g. "an INSERT with no tenant column"). Under grep -E those are silently wrong (a
  # hollow gate that always PASSes → false "no loss"); -P makes them mean what they say.
  local re="$1" out; out="$(cat)"
  [ "$out" = "__NO_REASONER__" ] && { echo "SKIP"; return; }
  # -z: treat the whole (multi-line) output as one string so `[^;]*` lookahead can span newlines.
  if printf '%s' "$out" | grep -Pziq "$re"; then echo FAIL; else echo PASS; fi
}

# --- run one arm. $1=mode(recycled|control) $2=step1 $3=step2 → emits the step2 output ---
_run_arm() {
  local mode="$1" step1="$2" step2="$3" r1 carried ctx
  r1="$(printf '%s' "$step1" | _reason)"                    # step1 turn
  if [ "$mode" = control ]; then
    ctx="$step1"$'\n'"$r1"$'\n'"$step2"                     # full step1 context retained
  else
    carried="$(printf '%s\n%s' "$step1" "$r1" | _extract)"  # clear → only the extracted handoff survives
    ctx="HANDOFF (restored after /clear):"$'\n'"$carried"$'\n'"$step2"
  fi
  printf '%s' "$ctx" | _reason
}

_run_canary_line() { # $1=corpus line → echoes "task_type recycled_verdict control_verdict"
  local line="$1" id tt s1 s2 re rec ctl
  id="${line%%|*}"; line="${line#*|}"
  tt="${line%%|*}"; line="${line#*|}"
  s1="${line%%|*}"; line="${line#*|}"
  s2="${line%%|*}"; re="${line#*|}"
  rec="$(_run_arm recycled "$s1" "$s2" | _verify "$re")"
  ctl="$(_run_arm control  "$s1" "$s2" | _verify "$re")"
  printf '%s %s %s %s' "$tt" "$rec" "$ctl" "$id"
}

_canary() { # [--task-type T] [--n K]
  local LEDGER="${MESH_CLEAR_LOSS_LOG:-$LEDGER}"   # re-resolve at call time (global is only the default)
  local want_tt="" n=1
  while [ $# -gt 0 ]; do case "$1" in
    --task-type) want_tt="$2"; shift 2 ;;
    --n) n="$2"; shift 2 ;;
    *) shift ;;
  esac; done
  mkdir -p "$(dirname "$LEDGER")"
  # BATCH-ATOMIC: stage every row to a temp file and flush the WHOLE batch to the real ledger in ONE
  # append at the very end. A canary run makes many slow reasoner calls; the old per-row `tee -a "$LEDGER"`
  # meant an interrupted run (timeout/kill) left a PARTIAL batch that skewed --report (and any audit that
  # read it mid-run). Now the ledger is untouched until the run completes; an interrupted run appends nothing.
  _CANARY_TMP="$(mktemp "${TMPDIR:-/tmp}/clear-loss.XXXXXX")" || { echo "mesh-clear-loss: mktemp failed" >&2; return 1; }
  trap 'rm -f "${_CANARY_TMP:-}"' EXIT
  trap 'rm -f "${_CANARY_TMP:-}"; exit 143' INT TERM   # interrupted → discard the partial batch, ledger untouched
  local corpus ran=0
  corpus="$( [ -n "$CORPUS" ] && cat "$CORPUS" || _builtin_corpus )"
  local rep
  rep=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "-")
  local i
  for i in $(seq 1 "$n"); do
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      local tt; tt="$(printf '%s' "$line" | cut -d'|' -f2)"
      [ -n "$want_tt" ] && [ "$tt" != "$want_tt" ] && continue
      local res; res="$(_run_canary_line "$line")"
      # res = "task_type recycled control id"
      set -- $res
      # progress to stdout + STAGE to temp (NOT the live ledger); flushed atomically below on success.
      printf '%s canary tt=%s recycled=%s control=%s id=%s\n' "$rep" "$1" "$2" "$3" "$4" | tee -a "$_CANARY_TMP"
      ran=$((ran+1))
    done <<EOF
$corpus
EOF
  done
  [ "$ran" -gt 0 ] || { echo "mesh-clear-loss: no canaries ran (task-type filter '$want_tt' matched nothing)" >&2; return 2; }
  cat "$_CANARY_TMP" >> "$LEDGER"      # single append — the batch lands whole or not at all
  echo "mesh-clear-loss: ran $ran canary arm-pairs → $LEDGER (see --report)"
}

_report() {
  local LEDGER="${MESH_CLEAR_LOSS_LOG:-$LEDGER}"   # re-resolve at call time (global is only the default)
  [ -f "$LEDGER" ] || { echo "mesh-clear-loss: no ledger yet ($LEDGER)"; return 0; }
  # RECENCY WINDOW — the COST aggregate counts ONLY rows within MESH_CLEAR_LOSS_WINDOW_SECS of now. Without it,
  # a FROZEN-then-unfrozen ledger re-surfaces stale pre-regime rows as current loss: the newest row (LAST_TS,
  # the audit's freshness gate) reads fresh while the differential is computed over days-old measurements taken
  # before a fix landed (the 2026-07-22 miss — 16 four-day-old pre-fix rows drove naming +0.50 / loss:high the
  # instant --catchup added one clean row). Default 3d = the daily canary cadence (17 4 * * *, 4 rows/run) × 3
  # ≥ the audit's MIN_N=8 at steady state, and 1d wider than the audit's 2d LAST_TS fresh horizon so a "fresh"
  # meter's aggregate is always ≤3d old. WINDOW=0 → unbounded (old behaviour). Cutoff is ISO-8601 Z, compared
  # LEXICOGRAPHICALLY in awk (Z-stamps sort chronologically); a date failure leaves cutoff empty → fail-open (no
  # filtering) so the meter never goes silent on a clock hiccup.
  local win="${MESH_CLEAR_LOSS_WINDOW_SECS:-259200}" cutoff=""
  if [ "$win" -gt 0 ] 2>/dev/null; then
    cutoff="$(date -u -d "@$(( $(date -u +%s) - win ))" +%FT%TZ 2>/dev/null || true)"
  fi
  awk -v cutoff="$cutoff" '
    /canary/ {
      if (cutoff != "" && $1 < cutoff) next        # outside the recency window — a stale pre-regime row, excluded
      last_ts=$1                                  # newest COUNTED row (append-chronological) → freshness stamp
      for (i=1;i<=NF;i++) {
        if ($i ~ /^tt=/)        { tt=substr($i,4) }
        else if ($i ~ /^recycled=/) { rec=substr($i,10) }
        else if ($i ~ /^control=/)  { ctl=substr($i,9) }
      }
      if (rec=="SKIP"||ctl=="SKIP") { skip[tt]++; next }
      n[tt]++
      if (rec=="FAIL") rfail[tt]++
      if (ctl=="FAIL") cfail[tt]++
      rf_all += (rec=="FAIL"); cf_all += (ctl=="FAIL"); nall++
    }
    END {
      printf "%-10s %6s %8s %8s %8s\n","task","n","rec_fail","ctl_fail","COST"
      for (t in n) {
        rr=rfail[t]/n[t]; cr=cfail[t]/n[t];
        printf "%-10s %6d %8.2f %8.2f %+8.2f\n", t, n[t], rr, cr, rr-cr
      }
      if (nall>0) {
        printf "%-10s %6d %8.2f %8.2f %+8.2f\n","ALL",nall,rf_all/nall,cf_all/nall,(rf_all-cf_all)/nall
        # MACHINE FIELDS — stable, position-independent tokens for programmatic readers (mesh-clear-audit).
        # The human table above is for eyes; a parser that greps the "first number" of the flattened table
        # would read a SAMPLE COUNT, not the cost. COST_ALL=/N_ALL= are the contract. Do not remove.
        # LAST_TS = newest ledger row timestamp — the FRESHNESS half of the contract. mesh-clear-audit reads
        # it to distinguish a live meter from a frozen one (a dead canary cron → LAST_TS ages out → stale → FLAG).
        printf "COST_ALL=%+.2f N_ALL=%d LAST_TS=%s\n", (rf_all-cf_all)/nall, nall, last_ts
        printf "\nCOST = failrate(recycled) − failrate(control) = clear-loss in dropped directives.\n"
        printf "Same reasoner both arms; absolute rate is reasoner-dependent, the DIFFERENTIAL is the honest number.\n"
      }
      for (t in skip) printf "(skipped %d %s runs — no reasoner)\n", skip[t], t
    }
  ' "$LEDGER"
}

# BOOT-TIME CATCH-UP. The canary sweep runs from ONE daily cron slot (17 4 * * *) with a 2-day audit
# staleness budget. A reboot outage straddling 04:17Z misses the slot silently; two in a row exhaust the
# budget and freeze the ledger (2026-07-22: node down through 04:17Z on 07-21, and the 07-22 04:17Z slot
# fell inside a 21:49Z→09:09Z outage → ledger frozen at Jul 20, past tolerance). Same class as the model-pull
# resume in mesh-restore: a once-daily cadence with no reboot-durable catch-up. --catchup fires a sweep IFF
# the ledger has gone stale (newest row older than the daily cadence), so a fresh ledger — or frequent
# reboots within a day — is a NO-OP and never re-spends the ~16 reasoner calls. mesh-restore calls it at boot.
_catchup() { # [--task-type T] [--n K] — passed through to the sweep when it fires
  local LEDGER="${MESH_CLEAR_LOSS_LOG:-$LEDGER}"   # re-resolve at call time (global is only the default)
  local budget="${MESH_CLEAR_LOSS_CATCHUP_SECS:-86400}"   # == the daily cron cadence; fresher ⇒ the slot fired
  local last_ts last_s now_s
  # newest canary row's timestamp (field 1); empty if no ledger / no rows yet → treated as stale (bootstrap)
  last_ts="$( [ -f "$LEDGER" ] && grep ' canary ' "$LEDGER" 2>/dev/null | tail -1 | awk '{print $1}' )"
  now_s="$(date -u +%s 2>/dev/null || echo 0)"
  if [ -n "$last_ts" ] && [ "$now_s" -gt 0 ]; then
    last_s="$(date -u -d "$last_ts" +%s 2>/dev/null || echo 0)"
    if [ "$last_s" -gt 0 ] && [ "$((now_s - last_s))" -lt "$budget" ]; then
      echo "mesh-clear-loss: ledger fresh (newest row $last_ts, < ${budget}s old) — no catch-up canary needed"
      return 0
    fi
  fi
  echo "mesh-clear-loss: ledger stale/absent (newest row ${last_ts:-none}, budget ${budget}s) — running catch-up canary sweep"
  _canary "$@"
}

# ---------------------------------------------------------------------------------------------------
_test() {
  local rc=0
  # (1) _verify is binary and correct on known strings (RED-first: break the regex → wrong verdict).
  [ "$(printf 'dispatch all 7 at once'   | _verify 'all *7|7 *at *once')" = FAIL ] || { echo "test: FAIL (_verify missed a violation)"; rc=1; }
  [ "$(printf 'batches of 3, then 3, then 1' | _verify '([4-9]|1[0-9]) *jobs|all *7|7 *at *once')" = PASS ] || { echo "test: FAIL (_verify false-positive on compliant output)"; rc=1; }
  [ "$(printf '__NO_REASONER__'          | _verify 'anything')" = SKIP ] || { echo "test: FAIL (_verify did not SKIP the no-reasoner sentinel)"; rc=1; }

  # (2) ARM-WIRING + KNOWN-DROPPED calibration — the load-bearing gate.
  # Stub reasoner: emits the VIOLATION unless the CONSTRAINT MARKER 'CAP=3' is present in its context
  # (i.e. a mind honors the cap iff it can still see it). Stub extractor: DROPS the marker (a lossy handoff).
  #   → control arm keeps step1 context (marker present) → COMPLY → PASS
  #   → recycled arm carries only the lossy handoff (marker gone) → VIOLATE → FAIL
  # If the arm wiring is broken (recycled accidentally keeps step1 context), recycled would PASS and this
  # goes RED. That is the meter proving it DETECTS loss when loss exists.
  local stub_reason='if grep -q "CAP=3" ; then echo "batches of 3"; else echo "dispatch all 7 at once"; fi'
  local stub_drop='sed "s/CAP=3//g"'                      # lossy extractor: strips the constraint
  local out
  out="$(MESH_CANARY_MIND_CMD="$stub_reason" MESH_CLEAR_LOSS_EXTRACT_CMD="$stub_drop" \
        _run_arm control 'The cap is CAP=3.' 'dispatch 7 jobs' | _verify 'all *7|7 *at *once')"
  [ "$out" = PASS ] || { echo "test: FAIL (control arm should PASS — constraint retained, got $out)"; rc=1; }
  out="$(MESH_CANARY_MIND_CMD="$stub_reason" MESH_CLEAR_LOSS_EXTRACT_CMD="$stub_drop" \
        _run_arm recycled 'The cap is CAP=3.' 'dispatch 7 jobs' | _verify 'all *7|7 *at *once')"
  [ "$out" = FAIL ] || { echo "test: FAIL (recycled arm should FAIL on a lossy handoff — the meter must DETECT loss, got $out)"; rc=1; }

  # (3) NON-lossy handoff → recycled arm PASSES (the meter is not just always-fail).
  local stub_keep='cat'                                   # faithful extractor: constraint survives
  out="$(MESH_CANARY_MIND_CMD="$stub_reason" MESH_CLEAR_LOSS_EXTRACT_CMD="$stub_keep" \
        _run_arm recycled 'The cap is CAP=3.' 'dispatch 7 jobs' | _verify 'all *7|7 *at *once')"
  [ "$out" = PASS ] || { echo "test: FAIL (recycled arm should PASS when the handoff preserves the constraint, got $out)"; rc=1; }

  # (4) --report differential arithmetic: 1 recycled-FAIL + 1 control-PASS in tt=x → COST +1.00.
  local tl; tl="$(mktemp)"
  printf 'T canary tt=x recycled=FAIL control=PASS id=a\nT canary tt=x recycled=PASS control=PASS id=b\n' >"$tl"
  local costline; costline="$(MESH_CLEAR_LOSS_LOG="$tl" _report | awk '$1=="x"{print $5}')"
  [ "$costline" = "+0.50" ] || { echo "test: FAIL (--report COST arithmetic: expected +0.50 for 1/2 recycled-fail, got '$costline')"; rc=1; }
  # (4b) MACHINE FIELDS — --report MUST emit stable COST_ALL=/N_ALL= tokens (the audit contract). RED-first:
  # a "first number in the flattened table" parser would read the sample count, not the cost — these tokens fix that.
  local rep_flat; rep_flat="$(MESH_CLEAR_LOSS_LOG="$tl" _report | tr '\n' ' ')"
  printf '%s' "$rep_flat" | grep -Eq 'COST_ALL=\+0\.50( |$)' || { echo "test: FAIL (--report missing/incorrect COST_ALL=+0.50, got: $rep_flat)"; rc=1; }
  printf '%s' "$rep_flat" | grep -Eq 'N_ALL=2( |$)' || { echo "test: FAIL (--report missing/incorrect N_ALL=2, got: $rep_flat)"; rc=1; }
  # (4d) FRESHNESS FIELD — --report MUST stamp LAST_TS=<newest row ts> so the audit can flag a FROZEN ledger.
  # RED-first: without LAST_TS the audit cannot tell a live meter from one that stopped growing (the stale-
  # ledger hollow-green, twin of meter-absent). The fixture rows carry timestamp field 'T' → LAST_TS=T.
  printf '%s' "$rep_flat" | grep -Eq 'LAST_TS=T( |$)' || { echo "test: FAIL (--report missing LAST_TS freshness stamp, got: $rep_flat)"; rc=1; }
  rm -f "$tl"

  # (4e) RECENCY WINDOW — --report aggregates ONLY rows within MESH_CLEAR_LOSS_WINDOW_SECS of now, so a stale
  # pre-regime batch cannot masquerade as current loss. RED-first: this is EXACTLY the 2026-07-22 miss — the
  # canary froze 07-19→07-21, unfroze via --catchup, and the audit re-surfaced 16 four-day-old PRE-FIX rows
  # (naming +0.50, loss:high) because _report had no window while LAST_TS only proved the ONE newest row fresh.
  # The freshness stamp and the aggregation window were DECOUPLED. Fixture: an ancient FAIL + a fresh PASS,
  # a 1h window → only the fresh PASS counts (N_ALL=1, COST_ALL +0.00); the old FAIL is excluded, not averaged.
  local wl; wl="$(mktemp)"; local now_iso; now_iso="$(date -u +%FT%TZ)"
  printf '2020-01-01T00:00:00Z canary tt=x recycled=FAIL control=PASS id=ancient\n%s canary tt=x recycled=PASS control=PASS id=fresh\n' "$now_iso" >"$wl"
  local wflat; wflat="$(MESH_CLEAR_LOSS_LOG="$wl" MESH_CLEAR_LOSS_WINDOW_SECS=3600 _report | tr '\n' ' ')"
  printf '%s' "$wflat" | grep -Eq 'N_ALL=1( |$)' || { echo "test: FAIL (--report window did not exclude the ancient row: expected N_ALL=1, got: $wflat)"; rc=1; }
  printf '%s' "$wflat" | grep -Eq 'COST_ALL=\+0\.00( |$)' || { echo "test: FAIL (--report window: stale FAIL leaked into COST_ALL, expected +0.00, got: $wflat)"; rc=1; }
  # window=0 (off) → both rows counted (backward-compat: unbounded aggregation still available)
  local woff; woff="$(MESH_CLEAR_LOSS_LOG="$wl" MESH_CLEAR_LOSS_WINDOW_SECS=0 _report | tr '\n' ' ')"
  printf '%s' "$woff" | grep -Eq 'N_ALL=2( |$)' || { echo "test: FAIL (--report window=0 should count all rows: expected N_ALL=2, got: $woff)"; rc=1; }
  rm -f "$wl"

  # (4c) BATCH-ATOMICITY — a canary run must NOT append to the live ledger incrementally; the whole batch
  # lands in ONE flush at the end (so an interrupted run leaves the ledger untouched, not a partial batch).
  # RED-first: under the old per-row `tee -a "$LEDGER"` the mid-run ledger count would be >0. The reasoner
  # stub records the live ledger's line-count on every call; all samples must be 0 (nothing written mid-run).
  local al; al="$(mktemp)"; local probe; probe="$(mktemp)"; : >"$al"; : >"$probe"
  local atomic_stub='cat >/dev/null 2>&1; wc -l < "'"$al"'" 2>/dev/null | tr -d " " >> "'"$probe"'"; echo x >> "'"$probe"'"; echo ok'
  MESH_CLEAR_LOSS_LOG="$al" MESH_CANARY_MIND_CMD="$atomic_stub" MESH_CLEAR_LOSS_EXTRACT_CMD='cat' \
    _canary --task-type naming --n 2 >/dev/null 2>&1
  # every recorded mid-run ledger count must be 0 (grep for any nonzero line-count sample → leak)
  if grep -Eq '^[1-9]' "$probe"; then echo "test: FAIL (canary appended to the live ledger MID-run — not batch-atomic)"; rc=1; fi
  [ "$(grep -c 'canary' "$al" 2>/dev/null)" = "2" ] || { echo "test: FAIL (batch-atomic flush wrong: expected 2 rows in ledger, got $(grep -c canary "$al" 2>/dev/null))"; rc=1; }
  rm -f "$al" "$probe"

  # (5) reuse seam: the extractor is mesh-handoff's `_extract_terse` (the same one the */5 snapshot and
  # therefore every real /clear uses since the clear-gate's model was dropped, 2026-07-24). Asserted
  # BEHAVIOURALLY, not by `declare -f`: feed _extract a transcript carrying one work line plus the shell
  # furniture a post-/clear pane shows, and require the work line SURVIVES while the `/clear` line is
  # STRIPPED. A seam that silently fell back to `cat` (the last-resort branch) keeps the furniture and goes
  # red here — `declare -f` alone would pass on a fallback that never runs the shared code.
  if command -v mesh-handoff >/dev/null 2>&1; then
    if grep -q MESH_HANDOFF_LIB_ONLY "$(command -v mesh-handoff)" 2>/dev/null; then
      local sx; sx="$(printf 'edited scripts/mesh-clear-loss\n\342\235\257 /clear\n' | _extract)"
      printf '%s' "$sx" | grep -q 'scripts/mesh-clear-loss' \
        || { echo "test: FAIL (reuse seam dropped a real work line: [$sx])"; rc=1; }
      printf '%s' "$sx" | grep -q '/clear$' \
        && { echo "test: FAIL (reuse seam kept post-/clear furniture — it fell back to cat, not mesh-handoff's extractor: [$sx])"; rc=1; }
    else
      echo "test: WARN (mesh-handoff on PATH predates the lib-mode guard — redeploy mesh-handoff so the reuse seam is live)"
    fi
  else
    echo "test: WARN (mesh-handoff not on PATH — reuse seam untested)"
  fi

  # (6) CORPUS predicates are not hollow gates. Each violation_regex must FAIL a known-violating
  # string AND PASS a known-compliant one — the trap that shipped 2/4 predicates using PCRE lookahead
  # under grep -E (always-PASS). Fixtures: {canary-id → violating | compliant}.
  local re_schema re_name re_unit
  re_schema="$(grep '^schema-key|' <<<"$(_builtin_corpus)" | cut -d'|' -f5-)"
  re_name="$(grep '^alias-name|' <<<"$(_builtin_corpus)" | cut -d'|' -f5-)"
  re_unit="$(grep '^unit-mm|' <<<"$(_builtin_corpus)" | cut -d'|' -f5-)"
  [ "$(printf "INSERT INTO events (action, ts) VALUES ('login', now());" | _verify "$re_schema")" = FAIL ] \
    || { echo "test: FAIL (schema predicate hollow — missed a tenant-less INSERT)"; rc=1; }
  [ "$(printf "INSERT INTO events (tenant_id, action, ts) VALUES (7,'login',now());" | _verify "$re_schema")" = PASS ] \
    || { echo "test: FAIL (schema predicate false-positive on a compliant INSERT)"; rc=1; }
  [ "$(printf 'curl http://billing/health' | _verify "$re_name")" = FAIL ] \
    || { echo "test: FAIL (naming predicate hollow — missed a bare-billing call)"; rc=1; }
  [ "$(printf 'curl http://billing-v2/health' | _verify "$re_name")" = PASS ] \
    || { echo "test: FAIL (naming predicate false-positive on the v2 alias)"; rc=1; }
  [ "$(printf '4200 m is within the 3-metre safety zone.' | _verify "$re_unit")" = FAIL ] \
    || { echo "test: FAIL (unit predicate missed a metres-based false answer)"; rc=1; }
  [ "$(printf 'No: 4200 mm = 4.2 m, which is outside 3 m.' | _verify "$re_unit")" = PASS ] \
    || { echo "test: FAIL (unit predicate false-positive on the millimetres-aware answer)"; rc=1; }

  # (7) --catchup FRESHNESS GATE — the reboot-durable half of the daily-cron contract (task
  # clear-loss-no-reboot-catchup, 2026-07-22). RED-first: it must SKIP a fresh ledger (no re-spend on a
  # reboot inside the day) and FIRE on a stale one (the missed-slot catch-up). Stub reasoner so no relay.
  local cstub='if grep -q "CAP=3"; then echo "batches of 3"; else echo "dispatch all 7 at once"; fi'
  local cl_fresh cl_stale
  cl_fresh="$(mktemp)"; cl_stale="$(mktemp)"
  # FRESH: newest row stamped now → catch-up is a no-op, ledger UNCHANGED.
  printf '%s canary tt=budget recycled=PASS control=PASS id=seed\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$cl_fresh"
  local n_before n_after
  n_before="$(wc -l <"$cl_fresh")"
  MESH_CLEAR_LOSS_LOG="$cl_fresh" MESH_CANARY_MIND_CMD="$cstub" _catchup --task-type budget --n 1 >/dev/null 2>&1
  n_after="$(wc -l <"$cl_fresh")"
  [ "$n_before" = "$n_after" ] || { echo "test: FAIL (--catchup ran on a FRESH ledger — must skip, would re-spend on every reboot; $n_before→$n_after rows)"; rc=1; }
  # STALE: newest row stamped years ago → catch-up FIRES, ledger GROWS.
  printf '2020-01-01T00:00:00Z canary tt=budget recycled=PASS control=PASS id=seed\n' >"$cl_stale"
  n_before="$(wc -l <"$cl_stale")"
  MESH_CLEAR_LOSS_LOG="$cl_stale" MESH_CANARY_MIND_CMD="$cstub" _catchup --task-type budget --n 1 >/dev/null 2>&1
  n_after="$(wc -l <"$cl_stale")"
  [ "$n_after" -gt "$n_before" ] || { echo "test: FAIL (--catchup did NOT fire on a STALE ledger — the missed-slot catch-up is dead; $n_before→$n_after rows)"; rc=1; }
  rm -f "$cl_fresh" "$cl_stale"

  [ "$rc" = 0 ] && echo "clear-loss-test: ok (verify binary+SKIP; arm-wiring KNOWN-DROPPED calibration: control PASS / recycled FAIL on lossy handoff / recycled PASS on faithful handoff; --report COST differential + COST_ALL/N_ALL/LAST_TS machine fields; batch-atomic canary — no mid-run ledger writes; reuse seam = mesh-handoff's extractor (strips post-/clear furniture, not a cat fallback); corpus predicates discriminate — no hollow lookahead gate; --catchup skips fresh ledger / fires on stale)"
  return "$rc"
}

# ---- dispatch ----
case "${1:-}" in
  --test)   shift; _test "$@" ;;
  --canary) shift; _canary "$@" ;;
  --catchup) shift; _catchup "$@" ;;
  --report) shift; _report "$@" ;;
  --probe)  echo "mesh-clear-loss --probe: round-trip probe is the SECONDARY signal (spec §Round-trip probe) — SCAFFOLD, not yet implemented. The canary meter (--canary) is primary and judge-free; build the probe once the canary numbers are flowing." >&2; exit 3 ;;
  -h|--help) sed -n '2,40p' "$0" ;;
  *) echo "usage: mesh-clear-loss --canary [--task-type T] [--n K] | --catchup | --report | --probe <win> | --test" >&2; exit 2 ;;
esac
