#!/usr/bin/env bash
# mesh-sms-rx — receive half of the SMS survival channel (send side: mesh-sms).
# Polls termux-sms-list (inbox) over SSH for new inbound SMS; feeds each as a
# board line. Offset-tracked by message timestamp — no re-feed on re-run.
#
# The TG-independent operator floor: if Telegram is geo-blocked or down, the
# operator can SMS the phone; this reflex picks it up within the poll interval.
#
#   mesh-sms-rx          poll once (for cron wiring, */5)
#   mesh-sms-rx --status last-seen timestamp + inbox count, no feed
#   mesh-sms-rx --test   smoke test
#
# Board output per new SMS:
#   [sms-rx] from=+NUMBER YYYY-MM-DDTHH:MMZ — "message body"
#
# Exit codes (honest-exit contract):
#   0 = poll succeeded (0 or more new messages fed)
#   2 = phone unreachable — cannot assess (never fake an empty read)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new"
OFFLINEFILE="$HOME/.mesh/.sms-rx-offline"
OFFSET_F="$HOME/.mesh/.sms-rx-offset"
LOG="$HOME/.mesh/sms-rx.log"
HOST="$(hostname)"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1    || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  [ -d "$HOME/.mesh" ]               || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable)"; exit 2; }
  ok="$(timeout 10 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${pip}" \
    "command -v termux-sms-list >/dev/null 2>&1 && echo ok || echo missing" 2>/dev/null)" || {
      echo "smoke-test: n/a (phone SSH failed)"; exit 2; }
  [ "$ok" = ok ] || { echo "smoke-test: FAIL (termux-sms-list not found on phone)"; exit 1; }
  echo "smoke-test: ok (phone=${pip})"; exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)" || { if [ ! -f "$OFFLINEFILE" ]; then echo "mesh-sms-rx: phone unreachable" >&2; touch "$OFFLINEFILE"; fi; exit 2; }
rm -f "$OFFLINEFILE"

# Fetch inbox (limit 50; -t inbox = received messages only)
raw="$(timeout 20 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${pip}" \
  "termux-sms-list -t inbox -l 50 2>/dev/null" 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "mesh-sms-rx: SSH fetch failed" >&2; touch "$OFFLINEFILE"; fi; exit 2; }

# An empty response is a valid honest answer (phone answered, inbox empty)
[ -n "$raw" ] || { echo "mesh-sms-rx: empty response (ok — inbox empty)"; exit 0; }

# Watermark: ms epoch of most-recent message already fed (0 = never run)
last_ms="$(cat "$OFFSET_F" 2>/dev/null | tr -dc '0-9')"
last_ms="${last_ms:-0}"

if [ "${1:-}" = --status ]; then
  count="$(printf '%s' "$raw" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo '?')"
  ts_fmt="$([ "${last_ms:-0}" -gt 0 ] && python3 -c "
import datetime
print(datetime.datetime.utcfromtimestamp(${last_ms}/1000).strftime('%Y-%m-%dT%H:%MZ'))" 2>/dev/null || echo 'never')"
  echo "sms-rx: inbox=${count}, last-seen=${ts_fmt}"; exit 0
fi

# First run (OFFSET_F absent): seed the watermark without posting anything.
# Prevents flooding the board with all historical SMS on initial deploy.
# If inbox is empty, seed to current epoch so any future message has date > watermark.
if [ ! -f "$OFFSET_F" ]; then
  max_ms="$(printf '%s' "$raw" | python3 -c "
import json, sys
try:
    msgs = json.load(sys.stdin)
    inbox = [m for m in msgs if isinstance(m, dict) and str(m.get('type','')) == '1']
    print(max((int(m.get('date','0')) for m in inbox), default=0))
except Exception:
    print(0)
" 2>/dev/null || echo 0)"
  # Fall back to current epoch (ms) so future SMS have date > watermark even on empty inbox
  if [ "${max_ms:-0}" = "0" ]; then
    max_ms="$(python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null || echo 0)"
  fi
  printf '%s' "$max_ms" > "$OFFSET_F"
  echo "mesh-sms-rx: first run — seeded to ${max_ms}ms, monitoring from now"
  exit 0
fi

# Parse new messages: type "1" = inbox; date (ms) > last_ms = not yet fed
new_msgs="$(printf '%s' "$raw" | python3 -c "
import json, sys, datetime
last_ms = ${last_ms}
try:
    msgs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(msgs, list):
    sys.exit(0)
new = [m for m in msgs
       if isinstance(m, dict)
       and int(m.get('date', '0')) > last_ms
       and str(m.get('type', '')) == '1']
new.sort(key=lambda m: int(m.get('date', '0')))
for m in new:
    dt = datetime.datetime.utcfromtimestamp(int(m.get('date','0'))/1000).strftime('%Y-%m-%dT%H:%MZ')
    # Replace field-separator in body to protect the tab-delimited format below
    body = m.get('body', '').replace('\n', ' ').replace('\t', ' ')[:200]
    # tab-separated: date_ms TAB sender TAB ts TAB body
    print(m.get('date','0') + '\t' + m.get('address','?') + '\t' + dt + '\t' + body)
" 2>/dev/null)"

[ -n "$new_msgs" ] || { echo "mesh-sms-rx: no new messages"; exit 0; }

new_max_ms="$last_ms"
feed_count=0

while IFS=$'\t' read -r date_ms sender ts_fmt body; do
  [ -z "$date_ms" ] && continue
  board_line="[sms-rx] from=${sender} ${ts_fmt} — \"${body}\""
  MESH_WHO="sms-rx@${HOST}" mesh-chat "$board_line" >/dev/null 2>&1 || true
  printf '%s  sms-rx@%s  ::  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$HOST" "$board_line" >> "$LOG"
  [ "$date_ms" -gt "$new_max_ms" ] 2>/dev/null && new_max_ms="$date_ms"
  feed_count=$((feed_count + 1))
done <<< "$new_msgs"

[ "$new_max_ms" -gt "$last_ms" ] 2>/dev/null && printf '%s' "$new_max_ms" > "$OFFSET_F"
echo "mesh-sms-rx: fed ${feed_count} new message(s)"
