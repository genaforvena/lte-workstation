#!/usr/bin/env bash
# mesh-tuner-eye — CAMERA TRIGGER for the tuner. Watches the room webcam; when a guitar or cello
# (any held string instrument) ENTERS the frame it opens the SILENT VISUAL tuner fullscreen on ds's
# GNOME desktop (`mesh-tuner --display`, with an on-screen "Вижу виолончель — тюнер" banner — NO
# sound); when the instrument LEAVES the frame it stops it (the window closes).
# Operator 2026-06-20: visual tuner on the Default-String SCREEN, NO audio at all.
#
# Vision = Groq zero-shot (qwen vision, same path as mesh-face-recognize) — a couple seconds of
# latency is fine for a TRIGGER (the tuner itself stays pure-local + fast). The webcam frame is
# captured to a temp file, classified, then DELETED — no image is ever kept (mesh-eye doctrine).
# CONSENT-GATED: refuses unless ~/.mesh/consent grants camera=yes (the room node already does).
#
# Runs on the mic + Bose + webcam node (default-string), same node as mesh-tuner / mesh-overhear.
#
#   mesh-tuner-eye --loop        watch continuously: instrument in frame → start tuner, gone → stop
#   mesh-tuner-eye --once        one capture → classify → print (guitar|cello|none), no action
#   mesh-tuner-eye --detect      alias of --once (frame → label only, no tuner, no voice)
#   mesh-tuner-eye --test        logic self-test (no cam, no cloud) — state machine + parsing
#
# Tunables (env): EYE_CAM=/dev/video0 · CAM_RES=640x480 · TUNEREYE_POLL=18 (seconds between frames
#   — the Groq vision call costs a FIXED ~1900 input tokens/frame and the on_demand TPM ceiling is
#   8000/min SHARED with mesh-relay/face-recognize, so poll slowly: ~3 frames/min leaves headroom) ·
#   TUNEREYE_ON=2 (consecutive instrument-frames to START) · TUNEREYE_OFF=3 (consecutive empty-frames
#   to STOP) — hysteresis so a blurred/averted frame doesn't flap the tuner.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
MESH="${MESH_DIR:-$HOME/.mesh}"
CONSENT="$MESH/consent"
export OH_PIPER="${OH_PIPER:-$MESH/piper/piper/piper}"
export OH_PIPERLIB="${OH_PIPERLIB:-$MESH/piper/piper}"
export OH_VOICE="${OH_VOICE:-$MESH/piper/voices/ruslan.onnx}"
export MUTE_FLAG="${MUTE_FLAG:-$MESH/mesh-speaking}"
export TUNEREYE_VOICE="${TUNEREYE_VOICE:-$MESH/tuner-voice/start.wav}"
export EYE_CAM="${EYE_CAM:-/dev/video0}"
export CAM_RES="${CAM_RES:-640x480}"
export GROQ_ENV="${GROQ_ENV:-$MESH/groq.env}"
export TUNEREYE_POLL="${TUNEREYE_POLL:-18}"           # idle watch cadence (TPM-safe ~3.3 frames/min)
export TUNEREYE_ACTIVE_POLL="${TUNEREYE_ACTIVE_POLL:-16}"  # cadence while the tuner is running
export TUNEREYE_CONFIRM="${TUNEREYE_CONFIRM:-3}"      # fast re-poll mid-transition (enter/leave) → snappy
export TUNEREYE_ON="${TUNEREYE_ON:-2}"
export TUNEREYE_OFF="${TUNEREYE_OFF:-2}"              # stop within ~CONFIRM of the 2nd empty frame
export TUNEREYE_PID="${TUNEREYE_PID:-$MESH/tuner-eye.tunerpid}"
export LOG="${TUNEREYE_LOG:-$MESH/tuner-eye.log}"

consent_camera_ok(){
  [ -f "$CONSENT" ] && grep -qiE '^[[:space:]]*camera[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT"
}

PY="$(mktemp /tmp/tunereye-XXXXXX.py)"; trap 'rm -f "$PY"' EXIT
cat > "$PY" <<'PYEOF'
import os, sys, json, time, base64, subprocess, shlex

CAM   = os.environ["EYE_CAM"]; RES = os.environ["CAM_RES"]
POLL  = float(os.environ.get("TUNEREYE_POLL","18"))
ACTIVE_POLL = float(os.environ.get("TUNEREYE_ACTIVE_POLL","16"))
CONFIRM     = float(os.environ.get("TUNEREYE_CONFIRM","3"))
NEED_ON  = int(os.environ.get("TUNEREYE_ON","2"))
NEED_OFF = int(os.environ.get("TUNEREYE_OFF","2"))
VOICEDIR = os.path.dirname(os.environ["TUNEREYE_VOICE"])
# Two start phrases, keyed by what the camera saw — operator wants "Вижу <инструмент>, запускаю тюнер".
START_PHRASES = {"guitar": ("Вижу гитару, запускаю тюнер",     "start_guitar.wav"),
                 "cello":  ("Вижу виолончель, запускаю тюнер", "start_cello.wav")}
GROQ_ENV = os.environ["GROQ_ENV"]; MODEL = "meta-llama/llama-4-scout-17b-16e-instruct"
# llama-4-scout (vision, NON-reasoning) replaced qwen3.6-27b 2026-06-20: the reasoning model emitted a
# long <think> block needing max_tokens=1000 → ~heavy TPM → frequent 429s ("vision call failed: 'choices'"
# = error body with no choices key) that left the eye BLIND (operator sat with his cello, nothing fired).
# scout answers the one word directly in ~0.8s with a fraction of the tokens → no 429, snappier trigger.
PIPER = os.environ["OH_PIPER"]; PIPERLIB = os.environ["OH_PIPERLIB"]; VOICE = os.environ["OH_VOICE"]
STARTWAV = os.environ["TUNEREYE_VOICE"]; MUTE = os.environ["MUTE_FLAG"]
PIDFILE = os.environ["TUNEREYE_PID"]; LOG = os.environ["LOG"]

def log(msg):
    line = "%s  tuner-eye  ::  %s" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), msg)
    try:
        with open(LOG,"a") as f: f.write(line+"\n")
    except Exception: pass
    print(line, flush=True)

def groq_key():
    try:
        with open(GROQ_ENV) as f:
            for ln in f:
                if ln.startswith("GROQ_API_KEY="):
                    return ln.split("=",1)[1].strip().strip('"').strip("'")
    except Exception: pass
    return None

def capture():
    f = "/tmp/tunereye-%d.jpg" % os.getpid()
    subprocess.run(["fswebcam","--no-banner","-d",CAM,"-r",RES,"-S","8",f],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return f if (os.path.exists(f) and os.path.getsize(f)>0) else None

# Groq zero-shot: is a guitar / cello (held string instrument) in frame? -> "guitar"|"cello"|"none"
def classify(jpg, key):
    try:
        b64 = base64.b64encode(open(jpg,"rb").read()).decode()
    except Exception:
        return "none"
    prompt = ("Look at this webcam frame of a room. Is a person holding, playing, or about to "
              "play a string instrument? Answer with EXACTLY one lowercase word:\n"
              "- 'guitar' if a guitar (acoustic or electric) is present/held,\n"
              "- 'cello' if a cello or similar large bowed string instrument is present/held,\n"
              "- 'none' if there is no such instrument in the frame.\n"
              "Output only the one word, no punctuation, no explanation.")
    # scout answers the one word directly (no <think> block) → 30 tokens is ample and keeps TPM low.
    payload = {"model": MODEL, "temperature": 0.0, "max_tokens": 30, "messages": [
        {"role":"user","content":[
            {"type":"text","text":prompt},
            {"type":"image_url","image_url":{"url":"data:image/jpeg;base64,%s"%b64}}]}]}
    cmd = ["curl","-s","-m","30","https://api.groq.com/openai/v1/chat/completions",
           "-H","Content-Type: application/json","-H","Authorization: Bearer %s"%key,
           "-d", json.dumps(payload)]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True).stdout
        data = json.loads(out)
        r = data["choices"][0]["message"]["content"]
        if "</think>" in r: r = r.split("</think>",1)[1]
        return parse_label(r)
    except Exception as e:
        log("[warn] vision call failed: %s" % e)
        return "error"

def parse_label(raw):
    r = (raw or "").strip().lower()
    if "guitar" in r: return "guitar"
    if "cello" in r or "violoncello" in r: return "cello"
    if "none" in r or "no " in r or "empty" in r: return "none"
    return "none"

def piper_render(text, outwav):
    try:
        subprocess.run([PIPER,"-m",VOICE,"-f",outwav], input=text.encode(),
            env=dict(os.environ, LD_LIBRARY_PATH=PIPERLIB),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return os.path.exists(outwav) and os.path.getsize(outwav)>0
    except Exception: return False

def bose_id():
    try:
        import re
        out = subprocess.run(["wpctl","status"],capture_output=True,timeout=5).stdout.decode("utf-8","ignore")
        in_sinks=False
        for ln in out.splitlines():
            if "Sinks:" in ln: in_sinks=True; continue
            if "Sources:" in ln or "endpoints" in ln: in_sinks=False
            if in_sinks and ("bose" in ln.lower() or "soundlink" in ln.lower()):
                m=re.search(r'(\d+)\.', ln)
                if m: return m.group(1)
    except Exception: pass
    return None

def _vol_floor(bid, floor=0.9):
    """Operator couldn't hear the start announcement. Unmute the Bose and raise it to >= floor JUST for
    the announcement, returning the prior volume so we restore it after (don't hijack the music level)."""
    prev=None
    try:
        import re
        out=subprocess.run(["wpctl","get-volume",bid],capture_output=True,text=True,timeout=5).stdout
        m=re.search(r'Volume:\s*([0-9.]+)', out); prev=float(m.group(1)) if m else None
        subprocess.run(["wpctl","set-mute",bid,"0"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
        if prev is None or prev < floor:
            subprocess.run(["wpctl","set-volume",bid,str(floor)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
    except Exception: pass
    return prev

def _vol_restore(bid, prev):
    if prev is None: return
    try: subprocess.run(["wpctl","set-volume",bid,str(prev)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
    except Exception: pass

def say(text, wav=None):
    wav = wav or STARTWAV
    os.makedirs(os.path.dirname(wav), exist_ok=True)
    if not (os.path.exists(wav) and os.path.getsize(wav)>0):
        piper_render(text, wav)
    if not os.path.exists(wav): return
    try: open(MUTE,"w").close()          # tell the overhear listener "that's me"
    except Exception: pass
    bid = bose_id(); prev=None
    if bid:
        try: subprocess.run(["wpctl","set-default",bid],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
        except Exception: pass
        prev=_vol_floor(bid)             # make sure it's actually audible
        subprocess.run(["pw-play","--target",bid,wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        _vol_restore(bid, prev)
    else:
        subprocess.run(["pw-play",wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    try: time.sleep(0.2); os.remove(MUTE)
    except Exception: pass

# ---- SILENT VISUAL launch (operator 2026-06-20: tuner on ds's SCREEN, NO sound). The eye opens a
# fullscreen gnome-terminal on the GNOME/Wayland desktop running `mesh-tuner --display <banner>`, and
# stops it via the pid that --display writes to DISPLAY_PID. say()/piper/Bose are RETIRED for the eye. ----
MESH       = os.path.dirname(LOG)                                   # LOG = $MESH/tuner-eye.log
DISPLAY_PID= os.path.join(MESH, "tuner-display.pid")               # the actual mesh-tuner --display pid
TERM       = os.environ.get("TUNEREYE_TERM", "gnome-terminal")
TERM_FLAG  = os.environ.get("TUNEREYE_TERM_FLAG", "--full-screen")
SCREEN_BANNER = {"guitar":"Вижу гитару — тюнер", "cello":"Вижу виолончель — тюнер"}

def graphical_env():
    """Build the env to draw onto the logged-in GNOME/Wayland session (same user, /run/user/<uid>)."""
    import glob
    env=dict(os.environ); uid=os.getuid(); xrd="/run/user/%d"%uid
    env["XDG_RUNTIME_DIR"]=xrd
    env.setdefault("DBUS_SESSION_BUS_ADDRESS","unix:path=%s/bus"%xrd)
    socks=[s for s in sorted(glob.glob(os.path.join(xrd,"wayland-*"))) if not s.endswith(".lock")]
    if socks: env["WAYLAND_DISPLAY"]=os.path.basename(socks[0])
    env.setdefault("DISPLAY",":0")                                  # Xwayland fallback for GTK
    env["TUNER_DISPLAY_PID"]=DISPLAY_PID                            # so --display records its pid for us
    return env

def tuner_running():
    try:
        pid=int(open(DISPLAY_PID).read().strip()); os.kill(pid,0); return pid
    except Exception:
        return None

def start_tuner(label="guitar"):
    if tuner_running(): return
    banner = SCREEN_BANNER.get(label, "Тюнер")
    inner = "exec mesh-tuner --display %s" % shlex.quote(banner)
    argv = [TERM, TERM_FLAG, "--", "bash", "-lc", inner]
    try:
        subprocess.Popen(argv, env=graphical_env(), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        log("[on] %s in frame → VISUAL tuner launched on screen (banner: %s)" % (label, banner))
    except Exception as e:
        log("[warn] could not launch visual tuner (%s) — set TUNEREYE_TERM/_FLAG in restore.env" % e)

def stop_tuner():
    pid = tuner_running()
    if pid:
        try: os.kill(pid, 15)                  # --display is SIGTERM-clean: restores the terminal + exits
        except Exception: pass
        log("[off] instrument left frame → visual tuner stopped (pid %d); window closes" % pid)
    try: os.remove(DISPLAY_PID)
    except Exception: pass

def mode_once(key):
    jpg = capture()
    if not jpg: print("none (no-frame)"); return 2
    label = classify(jpg, key) if key else "none"
    try: os.remove(jpg)
    except Exception: pass
    print(label); return 0

def mode_loop(key):
    log("[start] watching %s (idle %ss / active %ss / confirm %ss · on=%d off=%d)"
        % (CAM, POLL, ACTIVE_POLL, CONFIRM, NEED_ON, NEED_OFF))
    on=0; off=0; active=False; errs=0; seen="guitar"
    while True:
        jpg = capture()
        label = classify(jpg, key) if (jpg and key) else "none"
        if jpg:
            try: os.remove(jpg)
            except Exception: pass
        present = label in ("guitar","cello")
        if present: on+=1; off=0; seen=label    # remember WHICH instrument for the start phrase
        elif label=="none": off+=1; on=0
        # 'error' frames (incl. TPM 429) neither confirm nor deny — hold state, just back off.
        if not active and on>=NEED_ON:
            start_tuner(seen); active=True; on=0
        elif active and off>=NEED_OFF:
            stop_tuner(); active=False; off=0
        # adaptive cadence: poll FAST mid-transition (a change just started → confirm it quickly so
        # start/stop land within ~CONFIRM s), ACTIVE_POLL while tracking, slow POLL while idle-watching.
        if (not active and 0 < on < NEED_ON) or (active and 0 < off < NEED_OFF):
            delay = CONFIRM
        else:
            delay = ACTIVE_POLL if active else POLL
        errs = errs+1 if label=="error" else 0   # back off only when the TPM is exhausted
        if label=="error": delay = max(delay, POLL) * (1 + min(errs, 4))
        time.sleep(delay)

def mode_test():
    ok=True
    cases=[("guitar","guitar"),("  Guitar.","guitar"),("cello","cello"),
           ("a cello is held","cello"),("none","none"),("There is no instrument","none"),
           ("<think>hmm</think> guitar","guitar")]
    for raw,exp in cases:
        # strip think like the live path does
        r = raw.split("</think>",1)[1] if "</think>" in raw else raw
        got=parse_label(r); good=(got==exp)
        print("  %-28s → %-7s %s" % (repr(raw), got, "ok" if good else "FAIL")); ok=ok and good
    # hysteresis state machine: NEED_ON instrument-frames START, NEED_OFF empty-frames STOP, and an
    # 'error' frame (TPM 429) must HOLD state — never spuriously stop the tuner mid-tuning.
    seq=["none","guitar","guitar","error","none","none","guitar","cello"]
    on=0; off=0; active=False; events=[]; seen="guitar"
    for lbl in seq:
        present=lbl in ("guitar","cello")
        if present: on+=1; off=0; seen=lbl
        elif lbl=="none": off+=1; on=0
        if not active and on>=NEED_ON: events.append("START:"+seen); active=True; on=0
        elif active and off>=NEED_OFF: events.append("STOP"); active=False; off=0
    exp_ev=["START:guitar","STOP","START:cello"]
    hok=(events==exp_ev); print("  hysteresis(on=%d off=%d) → %s %s" % (NEED_ON,NEED_OFF,events,"ok" if hok else "FAIL")); ok=ok and hok
    print("smoke-test: %s" % ("ok (parse + state machine sound)" if ok else "FAIL")); return 0 if ok else 1

mode = sys.argv[1] if len(sys.argv)>1 else "once"
if mode=="test": sys.exit(mode_test())
key = groq_key()
if not key and mode in ("once","loop"):
    print("mesh-tuner-eye: no Groq key in %s" % GROQ_ENV, file=sys.stderr); sys.exit(1)
if   mode=="loop": sys.exit(mode_loop(key) or 0)
elif mode=="once": sys.exit(mode_once(key))
else: print("unknown mode: %s"%mode, file=sys.stderr); sys.exit(2)
PYEOF

case "${1:-}" in
  --loop)
    consent_camera_ok || { echo "mesh-tuner-eye: REFUSED — camera consent not granted in $CONSENT" >&2; exit 3; }
    exec python3 "$PY" loop ;;
  --once|--detect)
    consent_camera_ok || { echo "mesh-tuner-eye: REFUSED — camera consent not granted in $CONSENT" >&2; exit 3; }
    python3 "$PY" once ;;
  --test)
    command -v python3 >/dev/null || { echo "smoke-test: n/a (no python3)"; exit 2; }
    python3 "$PY" test ;;
  *) sed -n '2,18p' "$0" ;;
esac
