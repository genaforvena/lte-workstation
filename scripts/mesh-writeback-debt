#!/usr/bin/env bash
# orphan-ok: on-demand live STORAGE-WRITE-DEBT gauge — a mind/fusion pulls it, stateless, not scheduled.
# mesh-writeback-debt — how much MODIFIED page-cache is still un-flushed to disk, RIGHT NOW, and
# how close that backlog sits to the kernel's own write-throttle threshold.
#
# Distinct axis from every existing storage/memory sense. mesh-swap*/mesh-psi-memory see ANONYMOUS
# reclaim (RAM → swap); mesh-diskio/mesh-disk-latency see disk THROUGHPUT/latency; mesh-psi sees the
# aggregate STALL %. None sees the write DEBT: the volume of dirtied file pages the kernel has accepted
# but not yet persisted (Dirty:) plus the slice currently in flight to the device (Writeback:). That
# backlog is a real physical property of the storage subsystem under load, and it has a hard kernel
# consequence: when Dirty+Writeback crosses vm.dirty_ratio% of dirtyable memory, the kernel stops
# letting writers proceed asynchronously and forces them to write pages SYNCHRONOUSLY — a write stall
# that shows up as latency spikes everywhere, before any swap or OOM. vm.dirty_background_ratio% is the
# softer trigger where the flusher threads wake to drain in the background. This sense reads that debt
# live and reports it as a fraction of those kernel-defined thresholds.
#
# Source: /proc/meminfo {MemTotal,MemAvailable,Dirty,Writeback} + /proc/sys/vm/{dirty_ratio,
# dirty_background_ratio,dirty_bytes,dirty_background_bytes}. Denominator for the ratio mode is the
# kernel-provided MemAvailable (a close, honest stand-in for global_dirtyable_memory; falls back to
# MemTotal on kernels without MemAvailable). If vm.dirty_bytes>0 the kernel is in ABSOLUTE-bytes mode
# and we use those bytes directly instead of the ratios.
#
# Verdicts (dirty = Dirty+Writeback, in kB):
#   CLEAN      — dirty < background threshold: kernel isn't even background-flushing. Nominal.
#   FLUSHING   — background <= dirty < throttle threshold: flusher threads are actively draining.
#   THROTTLED  — dirty >= throttle threshold: writers are being FORCED synchronous = write stall NOW.
# A single read is meaningful (this is a LEVEL/gauge, not a cumulative counter) — LIVE-ONLY class like
# mesh-nic-drops/mesh-irq-rate: no window, no state file, no cron.
# Exit 2: /proc/meminfo unreadable or Dirty/denominator unparseable — honest n/a, never a faked CLEAN.
#
#   mesh-writeback-debt          one live reading
#   mesh-writeback-debt --test   smoke test (parser+classifier fixtures + real /proc/meminfo read gate)
set -uo pipefail

MEMINFO="${MESH_MEMINFO:-/proc/meminfo}"
SYSVM="${MESH_SYSVM:-/proc/sys/vm}"

# meminfo_kb <key> <file> -> integer kB (empty if absent/garbage; never a fabricated number)
meminfo_kb() {
  local key="$1" f="$2" v
  v="$(awk -v k="$key:" '$1==k{print $2; exit}' "$f" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) return 1;; esac
  printf '%s\n' "$v"
}

# vmknob <name> -> integer (empty if absent) from $SYSVM/<name>
vmknob() {
  local v; v="$(cat "$SYSVM/$1" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) return 1;; esac
  printf '%s\n' "$v"
}

# classify <dirty_kb> <bg_kb> <thr_kb> -> verdict
classify() {
  local dirty=$1 bg=$2 thr=$3
  if [ "$dirty" -ge "$thr" ]; then echo THROTTLED; return; fi
  if [ "$dirty" -ge "$bg" ];  then echo FLUSHING;  return; fi
  echo CLEAN
}

# thresholds: echoes "bg_kb thr_kb mode" given denom_kb + the four knobs.
# absolute mode when dirty_bytes>0, else ratio-of-denom.
thresholds() {
  local denom=$1 dr=$2 dbr=$3 db=$4 dbb=$5
  if [ "${db:-0}" -gt 0 ]; then
    echo "$(( ${dbb:-0} / 1024 )) $(( db / 1024 )) bytes"
  else
    echo "$(( dbr * denom / 100 )) $(( dr * denom / 100 )) ratio"
  fi
}

if [ "${1:-}" = --test ]; then
  e=0
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  # --- fixture meminfo + sysvm (ratio mode: denom=MemAvailable=1000000kB, dr=20 dbr=10) ---
  cat > "$td/meminfo" <<'EOF'
MemTotal:        2000000 kB
MemFree:          100000 kB
MemAvailable:    1000000 kB
Dirty:            150000 kB
Writeback:         10000 kB
EOF
  mkdir -p "$td/vm"
  printf '20\n' > "$td/vm/dirty_ratio"
  printf '10\n' > "$td/vm/dirty_background_ratio"
  printf '0\n'  > "$td/vm/dirty_bytes"
  printf '0\n'  > "$td/vm/dirty_background_bytes"

  # parser
  [ "$(meminfo_kb Dirty "$td/meminfo")"        = 150000 ]  || { echo "FAIL: parse Dirty";       e=$((e+1)); }
  [ "$(meminfo_kb Writeback "$td/meminfo")"    = 10000  ]  || { echo "FAIL: parse Writeback";   e=$((e+1)); }
  [ "$(meminfo_kb MemAvailable "$td/meminfo")" = 1000000 ] || { echo "FAIL: parse MemAvailable"; e=$((e+1)); }
  meminfo_kb Bogus "$td/meminfo" >/dev/null && { echo "FAIL: absent key must fail"; e=$((e+1)); }

  # thresholds (ratio): bg=10% of 1e6=100000, thr=20%=200000
  read -r bg thr mode < <(thresholds 1000000 20 10 0 0)
  [ "$bg $thr $mode" = "100000 200000 ratio" ] || { echo "FAIL: ratio thresholds => '$bg $thr $mode'"; e=$((e+1)); }
  # thresholds (absolute): dirty_bytes=209715200 (200MB) -> 204800kB, bg bytes=104857600 -> 102400kB
  read -r bg2 thr2 mode2 < <(thresholds 1000000 20 10 209715200 104857600)
  [ "$bg2 $thr2 $mode2" = "102400 204800 bytes" ] || { echo "FAIL: abs thresholds => '$bg2 $thr2 $mode2'"; e=$((e+1)); }

  # classifier boundaries (bg=100000 thr=200000)
  [ "$(classify 50000  100000 200000)" = CLEAN     ] || { echo "FAIL: clean";            e=$((e+1)); }
  [ "$(classify 100000 100000 200000)" = FLUSHING  ] || { echo "FAIL: bg boundary";      e=$((e+1)); }
  [ "$(classify 199999 100000 200000)" = FLUSHING  ] || { echo "FAIL: just under thr";   e=$((e+1)); }
  [ "$(classify 200000 100000 200000)" = THROTTLED ] || { echo "FAIL: thr boundary";     e=$((e+1)); }
  # end-to-end on the fixture: dirty=160000 (150000+10000), bg=100000, thr=200000 -> FLUSHING
  d_fx=$(( $(meminfo_kb Dirty "$td/meminfo") + $(meminfo_kb Writeback "$td/meminfo") ))
  [ "$(classify "$d_fx" 100000 200000)" = FLUSHING ] || { echo "FAIL: fixture e2e"; e=$((e+1)); }

  # real-read gate: live /proc/meminfo MUST yield an integer Dirty + a denominator, and produce a
  # verdict (classifier-only green is hollow — the sense must prove it reads real kernel state).
  rd="$(meminfo_kb Dirty "$MEMINFO")" || { echo "smoke-test: n/a (no readable Dirty in $MEMINFO)"; exit 2; }
  rw="$(meminfo_kb Writeback "$MEMINFO")" || rw=0
  rdenom="$(meminfo_kb MemAvailable "$MEMINFO")" || rdenom="$(meminfo_kb MemTotal "$MEMINFO")" || { echo "smoke-test: n/a (no denominator in $MEMINFO)"; exit 2; }
  [ "$rdenom" -gt 0 ] 2>/dev/null || { echo "FAIL: live denominator non-positive => '$rdenom'"; e=$((e+1)); }
  rdr="$(vmknob dirty_ratio)"            || rdr=20
  rdbr="$(vmknob dirty_background_ratio)" || rdbr=10
  read -r rbg rthr _ < <(thresholds "$rdenom" "$rdr" "$rdbr" "$(vmknob dirty_bytes || echo 0)" "$(vmknob dirty_background_bytes || echo 0)")
  rv="$(classify $((rd+rw)) "$rbg" "$rthr")"
  case "$rv" in CLEAN|FLUSHING|THROTTLED) : ;; *) echo "FAIL: live verdict garbage => '$rv'"; e=$((e+1));; esac

  if [ "$e" -eq 0 ]; then
    echo "smoke-test: ok (14 assertions incl. real /proc/meminfo read: Dirty+Writeback=$((rd+rw))kB verdict=$rv)"; exit 0
  fi
  echo "smoke-test: FAIL ($e fail(s))"; exit 1
fi

# ---- live reading ----
[ -r "$MEMINFO" ] || { echo "writeback-debt: UNREACHABLE (no readable $MEMINFO)" >&2; exit 2; }
dirty="$(meminfo_kb Dirty "$MEMINFO")"      || { echo "writeback-debt: UNREACHABLE (Dirty unparseable in $MEMINFO)" >&2; exit 2; }
wb="$(meminfo_kb Writeback "$MEMINFO")"     || wb=0
denom="$(meminfo_kb MemAvailable "$MEMINFO")"; denom_src=MemAvailable
if [ -z "${denom:-}" ]; then denom="$(meminfo_kb MemTotal "$MEMINFO")" || { echo "writeback-debt: UNREACHABLE (no denominator in $MEMINFO)" >&2; exit 2; }; denom_src=MemTotal; fi
[ "$denom" -gt 0 ] 2>/dev/null || { echo "writeback-debt: UNREACHABLE (denominator non-positive)" >&2; exit 2; }

dr="$(vmknob dirty_ratio)"             || dr=20
dbr="$(vmknob dirty_background_ratio)" || dbr=10
db="$(vmknob dirty_bytes || echo 0)"
dbb="$(vmknob dirty_background_bytes || echo 0)"

read -r bg thr mode < <(thresholds "$denom" "$dr" "$dbr" "$db" "$dbb")
debt=$(( dirty + wb ))
verdict="$(classify "$debt" "$bg" "$thr")"

# percent of the synchronous-throttle threshold (guard div0)
pct=0
[ "$thr" -gt 0 ] && pct=$(( 100 * debt / thr ))
mb() { echo $(( $1 / 1024 )); }

if [ "$mode" = bytes ]; then
  basis="vm.dirty_bytes=$(mb "$((db/1))")MB (absolute mode)"
else
  basis="vm.dirty_ratio=${dr}% over ${denom_src} $(mb "$denom")MB"
fi

echo "writeback-debt: ${verdict}  debt=$(mb "$debt")MB (dirty $(mb "$dirty") + writeback $(mb "$wb")) = ${pct}% of $(mb "$thr")MB throttle threshold (bg-flush at $(mb "$bg")MB); ${basis}"

case "$verdict" in THROTTLED) exit 0;; esac   # verdict is on stdout; exit 0 = read succeeded
exit 0
