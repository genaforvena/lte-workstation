#!/usr/bin/env bash
# reflex-cadence: 14-59/15 * * * *
# mesh-ideate — NOVELTY idea generator (operator 2026-06-20: "идея должна искать СВЯЗИ").
#
# Replaces the killed repetitive evergreen treadmill (mesh-generate MESH_EVERGREEN, off by default)
# with GENUINE novelty, two sources the operator named:
#   1. CONNECTION  — Deleuzian random/aleatory synthesis: fuse organ/sense A × B and ask what new
#                    capability or insight emerges ("what if THIS organ meets THIS one?").
#   2. LITERATURE  — a concept from autopoiesis / cybernetics / complexity / Deleuze, asked against
#                    the real mesh: do we embody it or lack it?
# Divergent generation; the MIND is the value FILTER (silly → discard with one line; valuable →
# prototype). A generated connection is a REAL new idea = a real diff in idea-space, NOT a fake tick.
# Non-repeating via a small recent-key state so it keeps producing fresh pairs/concepts.
#
#   mesh-ideate            emit ONE novel idea to ideas-queue (alternates connection / literature)
#   mesh-ideate --connect  force a connection idea
#   mesh-ideate --lit      force a literature idea
#   mesh-ideate --dry      print the idea to stdout, do NOT append to the queue
#   mesh-ideate --test     smoke test (logic + inventory + non-repeat, no queue write)
set -uo pipefail
# CRON PATH GAP (chat-review, doctor FAIL 2026-06-28 "ideate.log: no fresh idea" → exact same
# hollow-sense pattern as mesh-cooscillate/correlate: under cron's minimal PATH, the bare sibling
# call `mesh-state-touch` (liveness, lines below) wouldn't resolve — so the recent run
# (`... mesh-ideate: no fresh idea ...`) fired exit 1 with no state-touch, leaving the state file
# stale. HOME guard first (some crons run with HOME unset, in which case $HOME/.local/bin would be
# /.local/bin) + export PATH so the child shell sees the appended bin dir.
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH:-$HOME/.mesh}"
Q="$MESH/ideas-queue"
STATE="$MESH/.ideate-state"      # recent pair/concept keys (one per line), capped
SEEDS="$MESH/.correlation-seeds" # data-grounded pairs from mesh-correlate (operator 2026-06-20)
RECENT_MAX=14                    # don't repeat a pair/concept within this many emissions
SPLOG="${SPLOG:-$MESH/ideate.log}"   # novelty-search sparseness instrument log (overridable for --test sandbox)
TRACES="${TRACES:-$MESH/traces.log}"       # gen-pair-deadend discard verdicts live here (overridable for --test)
REPELLENT="${REPELLENT:-$MESH/.ideate-repellent}"  # negative pheromone store: expiry<TAB>key
ILLUM="${ILLUM:-$MESH/.ideate-illumination}"       # MAP-Elites coverage archive: one "area|angle" cell per emitted lit review (rolling)
ILLUM_MAX="${MESH_IDEATE_ILLUM_MAX:-500}"          # rolling window of coverage history (~4.6 full 108-cell grids); a cell dark for >this many emissions is legitimately un-illuminated again
REPELLENT_TTL="${MESH_IDEATE_REPELLENT_TTL:-2592000}"  # 30d — asymmetrically LONGER than RECENT_MAX's attractant window (Robinson et al. 2005: the repellent is the STRONGER + longer-lived of the two)
REPELLENT_COUNTERACT_FLOOR="${MESH_IDEATE_REPELLENT_FLOOR:-6}"  # counteractive NC only fires above this store size — never thin a small deposit (nothing to oppose)
ABLATION="${ABLATION:-$MESH/.ideate-ablation}"  # niche-construction ABLATION-control window: one 0/1 per emission (null-draw collided with the muted region?) — see block comment above gen_connection (overridable for --test sandbox)
ABLATION_WINDOW="${MESH_IDEATE_ABLATION_WINDOW:-30}"  # emit a measured NICHE-CONSTRUCTION-CONTRIBUTION verdict every N probes
GENOME="${MESH_GENOME:-${MESH_REPO:-$HOME/lte-workstation}}"   # git checkout — the LITERATURE lane's landings live at $GENOME/docs/reviews
REVIEWS="${REVIEWS:-$GENOME/docs/reviews}"      # the LANDING artifacts (one <area-prefix>-...-YYYY-MM-DD.md per review that produced a not-embodied finding); overridable for --test
VIABILITY_WINDOW_D="${MESH_IDEATE_VIABILITY_WINDOW_D:-30}"   # a review-area is MCC-VIABLE if it landed a finding within this many days (minimal-criterion recency)
EVOL_WINDOW_D="${MESH_IDEATE_EVOL_WINDOW_D:-60}"       # evolvability needs OFFSPRING HISTORY, so a longer window than viability's recency test (at 30d most areas fall under N<2 → n/a)
EVOL_MIN_N="${MESH_IDEATE_EVOL_MIN_N:-3}"              # below this many resolved landings an area is too thin to call one-trick (reported, never flagged)
EVOL_ONE_TRICK_E="${MESH_IDEATE_EVOL_ONE_TRICK_E:-0.34}"  # E at or under this = offspring collapse onto ~one organ (E=(K-1)/(N-1); 1/3 of the possible spread)
ts(){ date -u +%FT%TZ; }

# Read the oldest correlation seed (A\tB\tkind\tevidence). CONSUME it (remove line 1) ONLY when we're
# actually appending an idea (append=1); on --dry/preview (append=0) PEEK without removing — a preview
# must never burn a scarce data-grounded seed (the --dry contract is "no state mutation", and the seed
# is the rare signal the data sources produce). Empty if none → caller falls back to random aleatory.
seed_pop(){
  [ -s "$SEEDS" ] || return 1
  local first; first="$(sed -n '1p' "$SEEDS" 2>/dev/null)"
  [ -z "$first" ] && return 1
  [ "${append:-1}" = 1 ] && { sed -i '1d' "$SEEDS" 2>/dev/null || return 1; }
  printf '%s' "$first"
}

# Inventory: the live sensorium/actuator catalog (name<TAB>desc), parsed from mesh-tools.
inventory(){
  mesh-tools perceive 2>/dev/null | awk '
    /^[[:space:]]+mesh-/ {
      name=$1; $1=""; sub(/^[[:space:]]+/,""); desc=$0;
      if (name != "" && desc != "") print name "\t" desc
    }'
}

# Literature is NOT a frozen list (operator 2026-06-20: "литература выходит непрерывно — застывший
# список перебирает одно и то же"). Instead the source emits a LIVE-REVIEW DIRECTIVE: land randomly
# on a broad AREA from a random ANGLE; the MIND that picks it up does the ACTUAL review with live web
# search and surfaces ONE current concept/paper we don't embody. Concept-space = the live literature
# (inexhaustible), not my hardcoded glosses. The script only picks WHERE to look; the mind reads what's
# actually published NOW. area×angle is a large combinatorial space → lands somewhere fresh each time.
AREAS=$(cat <<'EOF'
autopoiesis & the biology of cognition (Maturana, Varela)
second-order cybernetics (von Foerster, Pask, Beer)
the free energy principle & active inference (Friston)
swarm intelligence & stigmergy
complex adaptive systems & the edge of chaos (Santa Fe)
Deleuze & Guattari — assemblage, rhizome, the machinic
enactivism & 4E (embodied/embedded/enacted/extended) cognition
homeostasis, allostasis & ultrastability (Ashby, Sterling)
niche construction & the extended phenotype
antifragility, convexity & ruin theory (Taleb)
distributed systems coordination — gossip, CRDTs, eventual consistency
information theory of agency — empowerment, predictive information
predictive processing & the Bayesian brain
artificial life & open-ended evolution
the viable system model & management cybernetics (Stafford Beer)
biosemiotics — sign and meaning in living systems
self-organizing criticality & power-law dynamics
relevance realization & the frame problem (Vervaeke)
EOF
)
ANGLES=$(cat <<'EOF'
a RECENT result (2023-2026) — what's new in this area right now
a foundational idea we may have MISread or applied too loosely
a known CRITIQUE or failure mode of this area
a CROSS-DOMAIN transfer: apply it concretely to a distributed sensor mesh
an OPERATIONAL mechanism it proposes (not just philosophy) we could implement
a concrete METRIC or experiment this area uses to measure itself
EOF
)

recent_has(){ [ -f "$STATE" ] && grep -qxF "$1" "$STATE"; }
recent_add(){ printf '%s\n' "$1" >> "$STATE"; tail -n "$RECENT_MAX" "$STATE" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"; }

# Rebuild the repellent store from traces.log's gen-pair-deadend lines (the discard→idea-key feedback
# channel this review was HELD on — see below — landed independently 2026-06-25, aff952b). Idempotent:
# fully rederived each call, deduped by key keeping the LATEST expiry (a re-confirmed dead-end extends
# the mute — decaying, not permanent, per Robinson's finding the repellent itself evaporates).
#
# A MEMORY HORIZON IS min(TTL, READ WINDOW) (2026-08-20, measured). This used to read
# `tail -n 2000 "$TRACES"` while declaring REPELLENT_TTL=30d, and the two do not compose: the horizon a
# store actually has is the SHORTER of the two, and only the TTL is visible in the source. Measured on
# this node the same day: traces.log 22839 lines, the 2000-line tail spanned 46.6h (~43 lines/h) and
# contained 2 of the 63 all-time gen-pair-deadend verdicts. So the parser fix below — which recovers 12
# of 63 previously-unparseable verdicts — could only ever raise the live store from 1 to at most 2,
# because the other 61 lines were never READ. The wifi TP-Link_97E0_5G × Keenetic-8813 verdict that
# motivated the parser fix sat at depth 488/2000 and would have aged out of the read window in ~35h
# with 29 days of its own TTL still to run. A 30-day mute backed by a 46-hour memory is a 46-hour mute.
#
# Note what made it invisible: nothing here was ever WRONG. Every stored entry was correct, the decay
# arithmetic was right, the TTL constant said 30d and meant it. The bound was a second, undeclared
# horizon in a different unit (lines, not time) whose value depends on how chatty the WHOLE mesh is —
# so an unrelated tool getting noisier silently shortens this tool's memory. General rule: a store with
# a TTL must read by TIME or by MARKER, never by a line count in a shared log; if you must bound the
# read, the bound has to be in the SAME unit as the TTL so the two can be compared.
#
# Fixed by grepping the marker over the whole file and letting the TTL be the only horizon. That is
# cheap and self-bounding — the marker is rare (63 lines in 22839, 0.3%) and the decay filter below
# discards anything past TTL — and it is what the sibling consumer already does: mesh-queue-tend:121
# greps `$TRACES` unbounded, so the old comment's claim that it "uses the same tail bound" was false in
# both directions (it has no tail bound, and matching a bound that does not exist was the excuse).
repellent_ingest(){
  [ -r "$TRACES" ] || return 0
  local now tmp; now=$(date -u +%s); tmp="$(mktemp)"
  while IFS= read -r line; do
    # A SIGNAL NAME IS NOT A TOKEN (2026-08-20, discover — measured, not theorised). The A-side used to
    # be `[^[:space:]]+`, i.e. one whitespace-free run, and the separator had to be a bare `×` with no
    # spaces around it. That is the shape a mesh-TOOL pair has (`mesh-a×mesh-b`) and precisely NOT the
    # shape a DATA-SEEDED pair has: mesh-ideate's own seeded template names raw sense identifiers, and
    # every channel label mesh-leadlag/mesh-cooscillate emit carries a space — `wifi <SSID>`,
    # `mesh-presence(LE-Bose Revolve SoundLink)`. So the very ideas the repellent exists to mute were
    # the ones structurally incapable of arming it: their dead-end verdict parsed to nothing and the
    # store stayed empty for that pair.
    #
    # It is not hypothetical and it is not rare. `wifi TP-Link_97E0_5G × wifi Keenetic-8813` was
    # dissected and traced a dead end 2026-08-19T19:44:03Z (circular-shift p=0.050, reverse leg
    # STRONGER than the forward, lag-0 -0.185) — and re-seeded as a fresh CONNECTION idea 14.5h later
    # on 2026-08-20T10:17:18Z, order flipped, straight back into the queue with a full paid mind-turn
    # behind it. Over the whole trace log 12 of 63 gen-pair-deadend verdicts (19%) parsed to nothing;
    # the live store held ONE entry.
    #
    # Note the asymmetry that hid it, and it is the general lesson: mesh-queue-tend consumes THE SAME
    # trace line with an anchor matcher that handles spaced signal names fine, so the idea DID resolve
    # [~]→[x] every time. One consumer closing the ticket makes the other consumer's silence look like
    # agreement. A negative-feedback loop with two readers is only as armed as its WEAKEST parser.
    #
    # `[^×]+` for the A side (the separator is the only delimiter that can be trusted), explicit trim
    # of both sides, and — separately — a lone ASCII ` x ` accepted as the separator when the line
    # carries no `×` at all: 10 of those 12 drops are a mind that typed `x` for the multiplication
    # sign. Only when there is no `×`, so a real × line can never be re-split on the letter x.
    local ln2 ts_epoch expiry key A B
    ln2="$line"
    case "$ln2" in *×*) ;; *) ln2="$(printf '%s' "$ln2" | sed -E 's/(gen-pair-deadend[[:space:]]+[^:]+)[[:space:]]x[[:space:]]/\1 × /')" ;; esac
    [[ "$ln2" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})Z.*gen-pair-deadend[[:space:]]+([^×]+)×([^:]+): ]] || continue
    A="${BASH_REMATCH[2]}"; B="${BASH_REMATCH[3]}"
    A="${A#"${A%%[![:space:]]*}"}"; A="${A%"${A##*[![:space:]]}"}"   # trim both ends
    B="${B#"${B%%[![:space:]]*}"}"; B="${B%"${B##*[![:space:]]}"}"
    { [ -z "$A" ] || [ -z "$B" ]; } && continue                      # half a pair is not a pair
    ts_epoch=$(date -u -d "${BASH_REMATCH[1]}Z" +%s 2>/dev/null) || continue
    expiry=$((ts_epoch + REPELLENT_TTL))
    [ "$expiry" -le "$now" ] && continue   # already decayed — don't bother storing
    if [[ "$A" < "$B" ]]; then key="conn:$A|$B"; else key="conn:$B|$A"; fi
    printf '%s\t%s\n' "$expiry" "$key" >> "$tmp"
  done < <(grep -aF 'gen-pair-deadend' "$TRACES" 2>/dev/null)
  if [ -s "$tmp" ]; then
    sort -t $'\t' -k2,2 -k1,1nr "$tmp" | awk -F'\t' '!seen[$2]++' > "$REPELLENT.tmp" 2>/dev/null \
      && mv "$REPELLENT.tmp" "$REPELLENT"
  fi
  rm -f "$tmp"
}
# NON-expired negative marker for this key — checked ALONGSIDE recent_has (stronger + longer-lived,
# per Robinson: repellent shifts trail choice −49% vs the attractant's +25%).
repellent_has(){
  [ -f "$REPELLENT" ] || return 1
  local now; now=$(date -u +%s)
  awk -F'\t' -v k="$1" -v nowe="$now" '$2==k && ($1+0)>nowe{f=1} END{exit !f}' "$REPELLENT"
}

# ── REPELLENT / "NO-ENTRY" STIGMERGY — the missing NEGATIVE pheromone (Robinson, Jackson, Holcombe &
# Ratnieks, "'No entry' signal in ant foraging", Nature 438:442, 2005; swarm intelligence & stigmergy,
# read-only). FOUNDATIONAL result applied TOO LOOSELY here: real foraging colonies coordinate with TWO
# pheromones — an ATTRACTANT (go here) AND a REPELLENT laid on an unrewarding branch (DON'T go here) —
# and the repellent is the STRONGER of the two (−49% on trail choice vs the attractant's +25%) and
# outlives it. Its specific job: stop a random fluctuation from snowballing into a positive-feedback
# LOCK-IN on an unrewarding trail, and let the colony REFOCUS when the food moves. recent_has/recent_add
# above is only an ATTRACTANT memory — a SHORT, exact-key, POSITIVE block ("don't re-mint THIS key for
# RECENT_MAX=14 emissions"). It carries no VERDICT and it AGES OUT: a pair a mind explicitly judged
# SPURIOUS/dead-end (the gen_* prompts literally say "if it is a dead end, post a one-line [idle] why and
# discard") leaves NO repellent — so once the 14-window scrolls past, or the same pair arrives from a
# different co-occurrence source, the forager re-explores the exhausted avenue. That is exactly this
# session's home_state↔desk RE-FLOOD (the same spurious pair dispatched 4×): mesh-correlate's
# seed-laundering gate patched ONE source path; the GENERAL fix is a repellent — feed the DISCARD verdict
# back as a negative marker that steers the forager away, asymmetrically STRONGER and LONGER-lived than
# the positive recent_has memory.
# SHIPPED 2026-07-01 (discover mind — unblocking this HELD review): a `.ideate-repellent` store keyed
# like STATE but (a) WRITTEN from a mind's discard verdict, (b) CHECKED in gen_connection's callers
# ALONGSIDE recent_has to suppress re-mint with HIGHER weight + LONGER TTL (30d vs RECENT_MAX's ~14
# emissions), (c) DECAYING (expiry-based, not permanent — a mute that outlives Robinson's own repellent
# would freeze out a pairing that later becomes real). Was held because it needed a discard→idea-key
# feedback channel the board did not yet emit — that channel landed independently 2026-06-25 (aff952b,
# `mesh-trace "gen-pair-deadend A×B: why"`, originally built for mesh-queue-tend's [~]→[x] reconcile, not
# for this review) and nobody had connected the two until now. repellent_ingest()/repellent_has() below
# rederive the store from that same trace line each run — no new instrumentation needed, only the
# missing consumer. This is the exact DUAL of board-evaporation-gap.md (the ATTRACTANT too persistent)
# and DISTINCT from the novelty-search sparseness instrument below (which rewards DISTANCE in
# behavior-space; a repellent suppresses a KNOWN-bad region by VERDICT, not by geometry). It is the
# negative-feedback HALF of stigmergic recruitment — orthogonal to the response-threshold (rising
# stimulus recruits to NEGLECTED work) and quorum reviews, which are positive/aggregate mechanisms.

# ── SHARED PROTENTION (LITERATURE, active inference — foundational idea applied too loosely here,
# read-only marker, HELD not shipped): Albarracin, Pitliya, St Clere Smithe, Friedman, Friston &
# Ramstead, "Shared Protentions in Multi-Agent Active Inference", Entropy 26(4):303, 2024,
# doi:10.3390/e26040303 (PMC11049075) — extends Husserl's temporal triad
# (RETENTION = the just-past, held in living form; PRIMAL IMPRESSION = the present instant; PROTENTION =
# implicit, pre-reflective anticipation of the immediate future) to groups: agents don't just share a
# record of the past, they can share an ANTICIPATION of what comes next, letting each agent predict not
# only its own trajectory but how CO-AGENTS are about to act — genuine coordination around a common
# future, not incidental alignment discovered after the fact.
# The gap: recent_has/repellent_has above are BOTH pure RETENTION — an attractant and a repellent, but
# both keyed on THIS mind's own PAST emissions (recent_has: my last RECENT_MAX keys; repellent_has: my
# discard verdicts). Neither carries a shred of PROTENTION — no signal for "what idea-space do I expect
# a PEER mind to explore in the next cycle" — so two minds researching the SAME area concurrently are
# invisible to each other until one posts a result (the exact live collision this review's own dispatch
# demonstrates: chat-review/room-speech-clean-stop-unwatched and this LITERATURE task both fired the same
# session with zero mutual anticipation). NOT the same gap as the Mitwelt/co-subject HELD fix on
# mesh-chat (review-mitwelt-co-subject-coordination-mesh-chat-2026-06-22.md): that is a PRESENT-tense
# "I am orienting toward X now" ping (primal impression, shared); protention is specifically FUTURE-
# tense — a checkable claim about the anticipated near-term trajectory, not current attention.
# HELD, not shipped (same caution as the Mitwelt FOCUS-payload — a naive per-mind "next idea-space I
# expect to explore" broadcast risks becoming a second mandatory ritual / board-noise source before it's
# shown to actually reduce collisions): a lightweight `~/.mesh/.ideate-protention` store — key + expiry,
# written by gen_connection/gen_literature BEFORE dispatch (not after, like repellent_ingest) — checked
# by a PEER's gen_* alongside recent_has/repellent_has, so a mind about to explore an area a peer already
# anticipates exploring can defer instead of colliding. Full citation + non-overlap analysis:
# knowledge/review-shared-protention-multiagent-active-inference-mesh-ideate-2026-07-05.md.

# ── novelty-search SPARSENESS instrument (Lehman & Stanley, read-only). recent_has blocks only EXACT
# key repeats; novelty search rewards DISTANCE in behavior space (avg distance to k-nearest neighbors)
# and keeps a GROWING archive. A new key sharing a DIMENSION (a connection tool, or a literature area)
# with one already in the archive is a near-neighbor = LOW SPARSENESS — distinct key, same region. Log
# it (no behavior change). NOTE: conservative — only sees the ≤RECENT_MAX archive, so it UNDER-counts
# (a near-neighbor >14 emissions ago is invisible to both the dedup AND this; the tiny finite archive
# is itself part of the gap). High LOW-SPARSENESS = the generator cycles a dense region (criticality
# 50×, affordance 20× in the real corpus) instead of expanding into unexplored concept-space.
#
# ORDER FROM NOISE (von Foerster 1960 — a foundational 2nd-order idea applied TOO LOOSELY here). This
# instrument is only the STUCK-DETECTOR half of von Foerster's order-from-noise loop: random
# perturbation (the aleatory `shuf` pairing below) should drive the generator OUT of a shallow/dense
# attractor toward a DEEPER one, and recent work (arXiv:2508.12791; a 2024 "order through noise"
# instantiation) frames the noise as ADAPTIVE — its amplitude RESPONDS to the order state. Here the
# two halves are UNCOUPLED: the noise is OPEN-LOOP (constant shuf) and LOW-SPARSENESS merely LOGS, so a
# sustained dense-region run never raises exploration to escape it. Missing piece = the feedback:
# high LOW-SPARSENESS → widen the draw (bias shuf toward archive-DISTANT tokens / briefly lift
# recent_has). NOT shipped — constant-cranked randomness floods the queue with incoherent filler (the
# very failure this lane fights), so the sparseness→novelty-yield relation must be instrumented and the
# exploration temperature BOUNDED first. This is PRODUCTIVE (Deleuzian creation of new connections),
# NOT the lack-shaped "reduce uncertainty" the operator rejected ([[desire-is-production-not-lack]]).
# See ~/.mesh/knowledge/review-order-from-noise-adaptive-perturbation-mesh-ideate-2026-06-21.md
sparseness_note(){  # $1=full-key  $2..=dimension token(s) to match as a near-neighbor
  local key="$1"; shift
  local d near=""
  for d in "$@"; do
    [ -z "$d" ] && continue
    near="$(grep -F "$d" "$STATE" 2>/dev/null | grep -vxF "$key" | head -1)"
    [ -n "$near" ] && break
  done
  [ -n "$near" ] && echo "$(date -u +%FT%TZ) LOW-SPARSENESS $key — near-neighbor already in archive ($near): distinct key, same region (novelty-search sparseness gap; exact-key dedup is not behavior-distance)" >> "$SPLOG" 2>/dev/null || true
}
# ── RR-INSIGHT / IMPASSE DETECTION: sparseness_note LOGS a frozen frame but never ESCALATES it ──────
# LITERATURE (live review — an OPERATIONAL mechanism of relevance realization, not just philosophy):
# Vervaeke's RR answers the frame problem (zero in on the relevant, ignore the combinatorial rest); its
# INSIGHT mechanism is the operational move that "converts ILL-defined problems into WELL-defined ones"
# by problem-FORMULATION / REFRAMING — the "aha" that restructures WHICH problem is even being solved
# (Andersen, Miller & Vervaeke, "Predictive processing and relevance realization: convergent solutions
# to the frame problem", Phenom. & Cog. Sci. 2022/2025; frame-problem framing per the RR program). Insight
# DECOMPOSES into two operational halves: (a) IMPASSE DETECTION — registering repeated NON-PROGRESS within
# the current frame (the precursor that says "reframe needed") — which is COMPUTABLE; and (b) the creative
# REFRAME itself — which is NOT an algorithm (Jaeger, Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing
# relevance realization: why agency and cognition are fundamentally not computational", Front. Psychol.
# 2024, PMC11231436 — already embodied as the small-world LIMIT at mesh-precision).
#
# THE GAP THIS NAMES: sparseness_note() ABOVE detects a frozen frame ONE EMISSION AT A TIME (LOW-SPARSENESS:
# "this idea is a near-neighbor of an archived one") but it only LOGS — it has NO MEMORY across emissions
# and NEVER ESCALATES. So when the SAME area-key returns LOW-SPARSENESS (or comes back [done]-stale) again
# and again — lit:predictive-processing, lit:deleuze-guattari, lit:antifragility ALL re-fired and re-staled
# 2026-06-22 — the forager has no impasse signal; it re-emits the exhausted frame forever. That IS the RR
# frame problem in miniature: the loop cannot REALIZE that "review area X" has stopped being relevant. The
# impasse (repeated non-progress) is the exact signal RR-insight uses to trigger reframing, and the mesh
# throws it away every cycle.
#
# DISTINCT from what's already embodied: NOT the MAP-ELITES coverage gap (mesh-generate:46-79 — that needs
# the hard behaviour-distance DESCRIPTOR; impasse-detection needs only the exact-KEY + an outcome count the
# mesh ALREADY produces in $SPLOG / the board's [done]-stale, so it is the CHEAP computable half); NOT the
# non-computability limit (mesh-precision — that bounds the creative reframe (b), not the detection (a));
# NOT order-from-noise (review-order-from-noise-adaptive-perturbation-mesh-ideate-2026-06-21 — perturbation,
# not impasse). It is the missing PRECURSOR-to-reframing stage.
# HELD FIX (steward lands — behavioral): give sparseness_note an impasse COUNTER per area-key over its
# LOW-SPARSENESS / [done]-stale history; on N repeated returns mark the frame EXHAUSTED and RETIRE or MUTATE
# that area out of rotation (via negativa — the subtract-arm of [[review-antifragility-iatrogenics-via-negativa]],
# the saturation signal it wanted) instead of re-emitting it. WHY HELD: the creative reframe (what NEW area
# replaces it) is the non-computable half (Jaeger 2024) — the mesh can detect and SUBTRACT the dead frame but
# cannot algorithmically MINT the live one; and retiring on a count risks dropping a still-fertile area whose
# recent reviews merely happened to find it embodied (the outcome signal must be real, not a flap — the same
# honest-flap caveat as every gate). Detection is shipped-able; the reframe stays open. Named here; wiring is the steward's.

# ── NICHE-CONSTRUCTION ABLATION CONTROL — MEASURE the field's causal contribution, don't ASSERT it ──
# LITERATURE (live review 2026-07-11, RECENT result 2023-2026): Rösner, Sasson, Bhattacharya, ... &
# Kurtz, "Experimental Removal of Niche Construction Alters the Pace and Mechanisms of Resistance
# Evolution", bioRxiv 2025.03.27.645637 (posted 2025-04). Red flour beetles CONDITION their flour with
# stink-gland secretions (external niche construction → ecological inheritance: the next generation
# develops in the medium its parents modified). The study's METHOD is the new thing: you cannot infer
# niche construction's causal effect from the constructed state alone — you must EXPERIMENTALLY REMOVE it
# (RNAi-knockdown of the secretion gene) and compare adaptation WITH vs WITHOUT the inherited legacy. The
# finding: removal changed not only the PACE but the MECHANISM of adaptation (which pathway the lineage
# takes). Removal-as-measurement — the ablation CONTROL — is the concept.
#
# THE GAP IT NAMES HERE: mesh-ideate constructs its OWN idea-search niche — recent_has (attractant) +
# repellent_has (no-entry) are exactly a self-deposited field the NEXT emission develops inside (idea-space
# ecological inheritance). The Talamali density-relaxation block below already SUSPECTS the field can turn
# net-negative ("a random walker would out-cover it", lines in gen_connection + the REPELLENT-SATURATED
# log) — but it ASSERTS this from a PROXY (strict draws exhausted / all 24 tries muted), never from the
# beetle paper's actual control. It has no measured answer to "is my constructed field load-bearing, or
# would field-OFF cover the same/fresher space?". That is precisely the counterfactual the paper says you
# must run. DISTINCT from everything embodied: not the density-relaxation THRESHOLD (a reactive proxy, not
# a measurement), not the repellent (the field itself, not its ablation), not sparseness (behavior-distance,
# not a null control), not RR-impasse (frame-exhaustion, not field causal-attribution).
#
# SHIPPED (this review, cheap + read-mostly): on each field-guided emission, ablation_probe draws ONE
# ungated NULL pair (the RNAi knockdown: field removed) and records whether it lands in the MUTED region
# (recent_has || repellent_has). Over an ABLATION_WINDOW it emits a MEASURED verdict to $SPLOG:
#   high muted-rate  → field is LOAD-BEARING (null draw keeps hitting the dead region the field steers past
#                      → niche construction is net-positive, the assertion is now MEASURED-true)
#   near-zero rate   → field is INERT/OVER-CONSTRAINING (a field-OFF walker covers fresh space fine →
#                      the constructed field adds little or over-constrains — the Talamali collapse, MEASURED
#                      not proxied → operator/steward signal to prune $REPELLENT / widen the inventory)
# It only LOGS (no behavior change) — the measurement is the artifact, exactly as the paper's control is.
#
# ── COUNTERACTIVE NICHE CONSTRUCTION — oppose the reflex's OWN over-construction, restore the match ──
# LITERATURE (live review 2026-07-11): Odling-Smee, Laland & Feldman, "Niche Construction: The
# Neglected Process in Evolution" (Princeton Univ. Press, 2003) — the typology's INCEPTIVE vs
# COUNTERACTIVE axis. Their canonical case is nest thermoregulation: wasps/bees do not build a new
# selection pressure, they actively CANCEL a drift away from their adapted state (fan/evaporate in the
# heat, muscle-heat in the cold), restoring the previously-evolved match. Counteractive NC is
# stabilizing/conservative — an organism modifying its environment to OPPOSE an ongoing change, not
# to initiate one. THE GAP: everything mesh-ideate did was INCEPTIVE (deposit the attractant/repellent
# field) or MEASUREMENT (the ablation control above) or DETECT-AND-LOG (the REPELLENT-SATURATED line in
# gen_connection just SURFACES over-constraint and waits for an operator to "prune $REPELLENT"). The
# counteractive cell was empty: when the ablation control MEASURES the field has drifted to
# OVER-CONSTRAINING, the reflex should ACT to restore its own adapted density — decay the OLDEST tail of
# its repellent deposit (the entries nearest natural REPELLENT_TTL expiry anyway, so the Robinson
# asymmetry is preserved: the store is thinned back toward its adapted size, never nuked) — instead of
# leaving the over-construction in place until a human intervenes. DISTINCT from all embodied: not
# inceptive (this UN-builds toward the setpoint), not the Talamali relaxation (that lifts the ATTRACTANT
# per-emission and explicitly KEEPS honoring the repellent; this thins the REPELLENT store itself), not
# the ablation control (that MEASURES and logs; this is the ACT the measurement licenses). Measured
# trigger (never a proxy), bounded act (~1/3 tail), self-restoring: counteractive-perturbational NC.
repellent_counteract(){
  [ -f "$REPELLENT" ] || return 0
  local total; total=$(grep -c . "$REPELLENT" 2>/dev/null); total=${total:-0}
  [ "$total" -ge "$REPELLENT_COUNTERACT_FLOOR" ] || return 0   # small deposit — nothing to oppose
  local drop keep
  drop=$(( total / 3 )); [ "$drop" -ge 1 ] || return 0          # decay ~1/3 of the tail
  keep=$(( total - drop ))
  # OLDEST = smallest expiry (earliest deposited / soonest to naturally decay). Keep the freshest $keep.
  sort -t $'\t' -k1,1nr "$REPELLENT" 2>/dev/null | head -n "$keep" > "$REPELLENT.tmp" \
    && mv "$REPELLENT.tmp" "$REPELLENT"
  echo "$(ts) REPELLENT-COUNTERACT decayed $drop/$total oldest repellent entries — measured over-construction → oppose own deposit, restore adapted density (counteractive niche construction; Odling-Smee/Laland/Feldman 2003)" >> "$SPLOG" 2>/dev/null
  return 0
}
ablation_probe(){  # $1=the key we just emitted (field ON)  $2=inventory blob
  local emitted="$1" inv="$2" na nb key muted=0
  local two; two="$(printf '%s\n' "$inv" | shuf -n 2 2>/dev/null)"
  na="$(printf '%s\n' "$two" | sed -n 1p)"; na="${na%%$'\t'*}"
  nb="$(printf '%s\n' "$two" | sed -n 2p)"; nb="${nb%%$'\t'*}"
  [ -z "$na" ] || [ -z "$nb" ] || [ "$na" = "$nb" ] && return 0   # degenerate draw → skip this probe
  if [[ "$na" < "$nb" ]]; then key="conn:$na|$nb"; else key="conn:$nb|$na"; fi
  { recent_has "$key" || repellent_has "$key"; } && muted=1
  printf '%s\n' "$muted" >> "$ABLATION" 2>/dev/null || return 0
  local n; n=$(grep -c . "$ABLATION" 2>/dev/null)   # grep -c prints 0 on no-match; no `|| echo 0` (that duplicates → "0\n0")
  [ "${n:-0}" -ge "$ABLATION_WINDOW" ] || return 0
  local hits pct verdict
  hits=$(grep -cx 1 "$ABLATION" 2>/dev/null)
  pct=$(( hits * 100 / n ))
  if   [ "$pct" -ge 50 ]; then verdict="FIELD-LOAD-BEARING (net-positive niche construction: field steers past a dead region a null walker keeps hitting)"
  elif [ "$pct" -le 15 ]; then verdict="FIELD-INERT/OVER-CONSTRAINING (a field-OFF walker covers fresh space fine — Talamali collapse, MEASURED not proxied → counteracting)"; repellent_counteract
  else verdict="FIELD-MARGINAL (mixed — the constructed field neither clearly helps nor clearly over-constrains)"; fi
  echo "$(ts) NICHE-CONSTRUCTION-CONTRIBUTION $pct% null-draw muted-rate over $n probes → $verdict (ablation control, Rösner et al. bioRxiv 2025.03.27.645637)" >> "$SPLOG" 2>/dev/null
  : > "$ABLATION"   # roll the window: start the next measurement fresh
}

gen_connection(){
  repellent_ingest
  # DATA-SEEDED first (operator 2026-06-20): if mesh-correlate left a real empirically-coupled pair,
  # fuse THAT instead of two random organs — the value filter moved upstream (data pre-selects the
  # pairing worth a mind's time). Falls back to random aleatory when there is no seed.
  local seed; seed="$(seed_pop)" && [ -n "$seed" ] && {
    local sa sb sk sev skey
    sa="$(printf '%s' "$seed" | cut -f1)"; sb="$(printf '%s' "$seed" | cut -f2)"
    sk="$(printf '%s' "$seed" | cut -f3)"; sev="$(printf '%s' "$seed" | cut -f4)"
    if [[ "$sa" < "$sb" ]]; then skey="conn:$sa|$sb"; else skey="conn:$sb|$sa"; fi
    # DEDUP the data-seeded path TOO — symmetry with the random path's `recent_has && continue` guard
    # below. mesh-cooscillate/mesh-correlate REWRITE .correlation-seeds every run, so an already-emitted
    # (and usually already-[x]-DISCARDED) pair gets RE-SEEDED every cycle; without this guard the seeded
    # branch re-emits it unconditionally (recent_add-then-emit, no recent_has). That was the DV8235×Mobicar2
    # phantom: re-fired 6× in ~2h (ideas-queue 2915–2925, every one [x] with the identical common-mode
    # verdict). recent_has ages out at RECENT_MAX emissions, so it only stopped the acute re-fire, not a
    # stale re-seed much later — repellent_has (below) now covers exactly that: a gen-pair-deadend
    # discard verdict on this pair mutes it for REPELLENT_TTL regardless of how long ago it fired.
    if recent_has "$skey" || repellent_has "$skey"; then
      echo "$(date -u +%FT%TZ) SEED-SUPPRESS $skey — re-seeded within RECENT_MAX or under an active repellent (a mind already discarded this pair via gen-pair-deadend); dropping duplicate data-seeded emission, falling back to aleatory" >> "$SPLOG" 2>/dev/null || true
    else
      recent_add "$skey"; sparseness_note "$skey" "$sa" "$sb"
      printf 'CONNECTION (data-seeded): the sensor tape shows the %s sense and the %s sense are empirically coupled (%s: %s) — NOT a random pairing, the DATA flagged it. What mechanism links them? Propose the SMALLEST thing that exploits or explains it: a fused sense, a reflex, or the literature concept that names this coupling. If it is spurious, say so in one line and discard. (Grounded in real observation — the value filter moved upstream.)' \
        "$sa" "$sb" "$sk" "$sev"
      return 0
    fi
  }
  local inv; inv="$(inventory)"
  local n; n=$(printf '%s\n' "$inv" | grep -c .)
  [ "${n:-0}" -lt 2 ] && return 1
  # DENSITY-DEPENDENT RELAXATION of stigmergic avoidance (LITERATURE, 2026-07-10 live review —
  # Talamali, Marshall, Bose & Reina, "Sensing and avoiding ... testing the limits of pheromone
  # stigmergy in high-density robot swarms", R. Soc. Open Sci. 6:190225, 2019): past a density
  # threshold a repellent-AVOIDING agent covers LESS ground than a NON-interacting random walker —
  # it is over-constrained by the field its own peers deposit. Our generator has the same failure
  # in miniature: as recent_has (attractant) + repellent_has (30d dead-end mute) grow, the random
  # draw's chance of hitting an un-muted pair falls, and a fixed 12-try budget can exhaust to a
  # SILENT `return 1` = "no fresh idea" (the 2026-06-28 doctor FAIL). The Royal-Society fix is to
  # RELAX avoidance when over-constrained. Phase 0 = strict (honor attractant AND repellent).
  # Phase 1 = lift ONLY the WEAKER attractant (recent_has: a recently-EMITTED pair is merely soft-
  # discouraged; re-emitting it beats starving) while STILL honoring the STRONGER, longer-lived
  # repellent (verified dead-ends; Robinson 2005 asymmetry). If even Phase 1 is empty the REPELLENT
  # itself saturates the viable pair-space: SURFACE that over-constraint (log REPELLENT-SATURATED)
  # instead of corrupting output by re-emitting a known dead-end — a random walker would out-cover
  # us there, and the honest signal is "prune the mute store / widen the inventory", not noise.
  local relax
  for relax in 0 1; do
    local tries=0 a b key na da nb db
    while [ "$tries" -lt 12 ]; do
      tries=$((tries+1))
      local two; two="$(printf '%s\n' "$inv" | shuf -n 2 2>/dev/null)"
      a="$(printf '%s\n' "$two" | sed -n 1p)"; b="$(printf '%s\n' "$two" | sed -n 2p)"
      na="${a%%$'\t'*}"; da="${a#*$'\t'}"; nb="${b%%$'\t'*}"; db="${b#*$'\t'}"
      [ -z "$na" ] || [ -z "$nb" ] || [ "$na" = "$nb" ] && continue
      # order-independent key so A×B == B×A for the repeat-guard
      if [[ "$na" < "$nb" ]]; then key="conn:$na|$nb"; else key="conn:$nb|$na"; fi
      [ "$relax" = 0 ] && recent_has "$key" && continue   # attractant honored ONLY in the strict phase
      repellent_has "$key" && continue                    # repellent honored in BOTH phases (Robinson asymmetry)
      recent_add "$key"; sparseness_note "$key" "$na" "$nb"
      [ "$relax" = 1 ] && echo "$(ts) FIELD-RELAX gen_connection: strict draws exhausted (attractant-saturated) → lifted recent_has, emitted $key — density-dependent stigmergy relaxation, repellent still honored (Talamali 2019 rsos.190225)" >> "$SPLOG" 2>/dev/null
      ablation_probe "$key" "$inv"   # niche-construction ablation control: measure whether the field is load-bearing (block comment above)
      printf 'CONNECTION (auto novelty): fuse %s (%s) × %s (%s). What NEW sense, actuator, fusion, or insight emerges from connecting these two? If genuinely valuable, sketch the SMALLEST prototype that tests it (one tool or one reflex) and post [taking]; if it is a dead end, post a one-line [idle] why and discard. Most pairings ARE dead ends — that is the method (divergent generate → value filter).' \
        "$na" "$da" "$nb" "$db"
      return 0
    done
  done
  echo "$(ts) REPELLENT-SATURATED gen_connection: $n inventory items, 24 draws all muted even after lifting the attractant — the repellent field over-constrains the generator (density-dependent stigmergy collapse; a random walker would out-cover it). Prune $REPELLENT or widen the inventory." >> "$SPLOG" 2>/dev/null
  return 1
}

# ── MAP-ELITES ILLUMINATION over the literature niche-grid (Mouret & Clune 2015; QD lineage 2024-25) ──
# LITERATURE (artificial life & open-ended evolution, OPERATIONAL mechanism, live review 2026-07-28).
# MAP-Elites (Mouret & Clune, "Illuminating search spaces by mapping elites", arXiv:1504.04909, 2015;
# Quality-Diversity lineage — Pugh/Lehman/Stanley; recent OEE instantiation: Faldor & Cully, "Toward
# artificial open-ended evolution within Lenia using quality-diversity", ALIFE 2024, arXiv:2406.04235):
# instead of sampling uniformly, discretize a BEHAVIOURAL-DESCRIPTOR space into a niche grid and drive
# generation toward the EMPTY / least-covered cells — "illuminating" the whole space rather than
# re-sampling a dense region. mesh-generate:59 documents this as the mesh's standing OEE gap but HELD it
# on "descriptor CHOICE is MAP-Elites' own documented weakness" — the hard behaviour-distance descriptor
# for the CODEBASE lane. THE KEY OBSERVATION THIS LANDS: the LITERATURE sub-lane's descriptor is already
# FREE and DISCRETE — the AREAS×ANGLES grid (18×6 = 108 niches) — so QD illumination applies here with no
# descriptor to invent. The prior draw was uniform `shuf` gated only by recent_has (exact-key dedup of the
# last RECENT_MAX=14): over 108 cells with a 14-deep memory that is coupon-collector sampling — it re-hits
# recent-ish niches while whole areas×angles stay DARK for long stretches. illum_pick() below turns the
# draw into empty-cell targeting: pick a GLOBAL-MINIMUM-coverage cell from the ILLUM archive (random among
# ties), so the grid is systematically illuminated. DISTINCT from the novelty-search sparseness instrument
# above (Lehman & Stanley — a distance REWARD with no grid, no per-cell retention) and from the repellent
# (a VERDICT-keyed no-entry marker): this is the QD coverage/illumination move, the exact thing MAP-Elites
# adds beyond novelty search. Report/steer only on the free descriptor; the codebase-lane descriptor stays
# open (mesh-generate). Artifact: docs/reviews/map-elites-illumination-literature-lane-2026-07-28.md
# ── SOLENOIDAL CIRCULATION ON THE ILLUMINATION ISOCONTOUR (FEP, live review 2026-08-18) ──
# Friston, Da Costa, Sajid, Heins, Ueltzhoffer, Pavliotis & Parr, "The free energy principle made simpler
# but not too simple", Physics Reports 1024 (2023) 1-29, eq. (6) and p.17. The Helmholtz decomposition of
# any flow that maintains a steady-state density has TWO components, not one:
#     f(x) = Q(x)grad I(x)  -  Gamma grad I(x) - Lambda(x)        Q = -Q^T (antisymmetric)
#            \___solenoidal___/   \_____gradient_____/
# The gradient part descends the surprisal. The solenoidal part is "a solenoidal circulation on the
# isocontours of the steady-state density ... This component breaks detailed balance and renders the
# steady-state density a nonequilibrium steady-state density". It costs nothing: "biological behaviour
# may be characterised by internal solenoidal flows that do not change variational free energy - or
# surprisal - and yet move on the internal (statistical) manifold". And it PAYS: "the mixing afforded by
# solenoidal flow can render gradient descent more efficient" (their refs [113-115] are the non-reversible
# sampling results - Hwang, Hwang-Ma & Sheu, "Accelerating diffusions", Ann. Appl. Probab. 15(2) 2005
# 1433-1444, and Lelievre, Nier & Pavliotis, "Optimal non-reversible linear drift...", J. Stat. Phys.
# 152(2) - a divergence-free drift leaves the target measure INVARIANT while cutting mixing time and
# asymptotic variance). Pavliotis co-authors both lineages; the import is deliberate, not analogy.
#
# WHAT WE HAD: illum_pick was the gradient term ALONE. It targeted the global-min-coverage cell (the
# MAP-Elites move, 07-28) and then broke ties with `shuf` - an i.i.d. draw, i.e. the REVERSIBLE choice
# that respects detailed balance. On this grid the tie is not an edge case, it is the normal state: the
# live archive (500 emissions over 108 cells, 2026-08-18) sits at coverage 3/4/5 with 1/38/69 cells - the
# gradient is essentially FLAT and nearly every pick is decided by the tie-break, not by the gradient.
#
# WHAT THE MEASUREMENT ACTUALLY SHOWED, including the half that failed. Simulated both tie-breaks on the
# real 108-cell grid with the real ILLUM_MAX=500 window, 40 seeds x 3000 draws:
#     random tie-break:      cover all 108 = 108 draws | worst revisit gap 379.5 (max 467) | mean gap 106.9
#     circulating tie-break: cover all 108 = 108 draws | worst revisit gap 108.0 (max 108) | mean gap 108.0
# The COUPON-COLLECTOR story is FALSE here and I am recording that rather than quietly dropping it: the
# min-coverage gradient already forces a perfect first sweep, so cold-start coverage is identical (108 vs
# 108) and MAP-Elites had already bought that win. The entire remaining difference is in the TAIL. Same
# stationary distribution (mean gap 107 vs 108), same coverage spread (sd 0.487 vs 0.483) - and yet a
# random tie-break lets a niche go dark for up to 4.3x the grid period while a circulating one guarantees
# exactly one period. At this lane's measured rate (209 reviews / 2026-07-06..08-18 = ~5/day) that is a
# cell unvisited for ~93 days instead of a guaranteed ~22. This is the non-reversible-sampling result
# exactly: the invariant measure is untouched, the variance is not.
#
# NOTE THE SHAPE, because it is why nothing here flagged it: EVERY aggregate we keep looks identical under
# the two rules. Mean gap, coverage sd, cold-start coverage - all unchanged. Only the worst-case tail moves.
# An even-looking average can hide a starving tail, and a coverage sense that reports only the mean is
# structurally blind to the thing it exists to prevent.
#
# THE CIRCULATION, discretely: among the min-coverage cells (the isocontour), take the LEAST RECENTLY
# EMITTED. That is a deterministic antisymmetric rotation on the contour - it never leaves the contour
# (free energy unchanged, the gradient's choice is fully respected), it visits every tied cell exactly
# once per cycle, and its long-run marginal over the tie is exactly uniform, so the MAP-Elites guarantee
# above is preserved and not merely approximated. Ranked, not scalar: gen_literature walks the ranking
# (illum_pick <n>) because a deterministic pick would otherwise return the SAME rejected cell on every
# recent_has retry, where `shuf` used to re-draw - the one behaviour the randomness was silently providing.
illum_pick(){  # print "area<TAB>angle" of the Nth cell (default 1) ranked by coverage asc, then staleness
  local want="${1:-1}" a g
  case "$want" in ''|*[!0-9]*) want=1 ;; esac
  [ "$want" -ge 1 ] 2>/dev/null || want=1
  { while IFS= read -r a; do [ -z "$a" ] && continue
      while IFS= read -r g; do [ -z "$g" ] && continue; printf 'CELL\t%s\t%s\n' "$a" "$g"; done <<< "$ANGLES"
    done <<< "$AREAS"
    [ -f "$ILLUM" ] && awk 'NF{print "HIT\t"$0}' "$ILLUM" 2>/dev/null
  } | awk -F'\t' '
      $1=="CELL" { k=$2"|"$3; if(!(k in seen)){ seen[k]=1; ord[++nc]=k; ar[k]=$2; an[k]=$3; c[k]=0; l[k]=0 } next }
      $1=="HIT"  { n++; if($2 in seen){ c[$2]++; l[$2]=n } }
      END { for(i=1;i<=nc;i++){ k=ord[i]; printf "%d\t%d\t%d\t%s\t%s\n", c[k], l[k], i, ar[k], an[k] } }' \
  | sort -t"$(printf '\t')" -k1,1n -k2,2n -k3,3n | sed -n "${want}p" | cut -f4,5
}
illum_add(){ # record an emitted cell into the rolling coverage archive
  mkdir -p "$MESH"; printf '%s\n' "$1" >> "$ILLUM"
  tail -n "$ILLUM_MAX" "$ILLUM" > "$ILLUM.tmp" 2>/dev/null && mv "$ILLUM.tmp" "$ILLUM"
}

# ── MINIMAL-CRITERION VIABILITY over the review-area population (MCC — the fitness dual of illumination) ──
# LITERATURE (artificial life & open-ended evolution, OPERATIONAL mechanism, live review 2026-07-29).
# MINIMAL CRITERION COEVOLUTION — Brant & Stanley, "Minimal Criterion Coevolution: a new approach to
# open-ended search", GECCO 2017 (dl.acm.org/10.1145/3071178.3071186; thesis stars.library.ucf.edu/etd2020/21;
# still the reference OEE-without-archive mechanism — current per the 2025 awesome-open-ended survey
# github.com/jennyzzt/awesome-open-ended and the "Benchmarking open-endedness in MCC" follow-up, GECCO 2019).
# THE MECHANISM: open-ended divergence needs NEITHER an objective NOR a novelty archive/behaviour-descriptor —
# it falls out of TWO coevolving populations, each individual eligible to reproduce ONLY when it satisfies a
# pass/fail MINIMAL CRITERION defined by its interaction with the OTHER population (their maze/agent world: a
# maze is viable iff SOME-but-not-ALL agents solve it — neither trivial nor impossible; an agent is viable iff
# it solves ≥1 maze). Brant & Stanley's thesis is precisely that unconstrained novelty/illumination WANDERS
# INTO FUNCTIONLESS regions, and the coevolving minimal criterion is what keeps the search FUNCTIONAL without
# an objective.
#
# THE MESH ALREADY HAS BOTH POPULATIONS, coevolving: (A) the review-AREAS (the "mazes" — problems to review)
# and (B) the mesh's EMBODIED-CAPABILITY set (the "agents" — what it can already absorb). The minimal criterion
# is the "novel AND learnable" test the LITERATURE directive itself states and mesh-vitality already reads on
# the measurement side (Hughes et al. ICML 2024): an AREA is VIABLE iff it still yields a mechanism the mesh
# does NOT already embody — a review that lands (a docs/reviews artifact). And population B COEVOLVES against A:
# every landing ADDS an embodied mechanism, raising the bar for "not-already-embodied", so a once-fertile area
# EXHAUSTS as the capability set absorbs it. That is the coevolutionary ratchet — the growing embodied-set is
# the parasite that turns old mazes trivial, forcing the area population toward ever-newer niches.
#
# THE GAP THIS NAMES: illum_pick() above draws the DARKEST (least-COVERED) cell — pure divergence, with NO
# fitness term. It will keep re-drawing an EXHAUSTED area (one the capability-set has fully absorbed) purely
# because its grid-cell is under-covered, spending review turns that come back "already embodied". That is
# exactly the "illumination without a minimal criterion wanders into the functionless" failure MCC fixes.
# DISTINCT from everything embodied: NOT MAP-Elites illumination (illum_pick — COVERAGE, no fitness); NOT the
# novelty-search sparseness note (behaviour-distance, no productivity signal); NOT the repellent (a VERDICT-keyed
# dead-end mute, not an area's landing history); and it is the POSITIVE dual of the RR-IMPASSE detector above
# (which counts in-frame NON-progress from $SPLOG — a NEGATIVE signal that says "retire this frame"): MCC needs
# the POSITIVE fitness count — WHICH areas are still landing — the exact "outcome count the mesh already
# produces" (docs/reviews landings) that the RR-impasse block wanted and did not read.
#
# ── DISENGAGEMENT: the failure mode MCC's own literature names, and this file did not measure ──────
# LITERATURE (live review 2026-08-18; area = artificial life & open-ended evolution, angle = a known
# CRITIQUE / failure mode of the area).
#
# THE CONCEPT — COEVOLUTIONARY DISENGAGEMENT. Coevolutionary algorithms are known to fail in ways a
# single population cannot: cycling, over-focusing, and DISENGAGEMENT. Disengagement is when one
# population outstrips the other so far that EVERY encounter has the SAME outcome — every parasite
# beaten, or every host beaten. The relative fitness gradient vanishes, selection degenerates to
# drift, and the run continues looking active while it has stopped choosing anything. The
# counter-intuitive fix is REDUCED VIRULENCE: selecting for maximum ability to defeat the opponent is
# what destroys the gradient, so a MODERATELY virulent parasite outperforms a maximally virulent one.
#   Origin: Cartlidge & Bullock, "Combating Coevolutionary Disengagement by Reducing Parasite
#   Virulence", Evolutionary Computation 12(2):193-222 (2004), PMID 15157374. HONEST SOURCING: the
#   full text was NOT reachable from this node (403 at MIT Press, Southampton eprints and PubMed), so
#   nothing above is quoted from it — it is cited by record for the concept's origin only.
#   Read FIRST-HAND instead, the same principle in its live ML form: Parker-Holder, Jiang, Dennis,
#   Samvelyan, Foerster, Grefenstette & Rocktaeschel, "Evolving Curricula with Regret-Based
#   Environment Design" (ACCEL), ICML 2022, PMLR v162 — verbatim: levels "that are currently TOO HARD
#   OR TOO EASY" are moved "towards the frontier of the agent's capabilities", and "since ACCEL uses a
#   minimax REGRET objective (rather than minimax as in POET), it naturally promotes levels at the
#   frontier of agent's capabilities". Maximise learnability, NOT difficulty — reduced virulence,
#   rediscovered. Still live: Mead, Lacerda, Foerster & Hawes, "Improving Regret Approximation for
#   Unsupervised Dynamic Environment Generation", arXiv:2601.14957, 21 Jan 2026.
#   Prior-art gate 2026-08-18: "coevolutionary disengagement" CLEAN, "virulence" CLEAN — zero hits in
#   knowledge/, chat.log, scripts+docs.
#
# WHY IT LANDS HERE AND NOWHERE ELSE. This file quotes Brant & Stanley's criterion correctly two
# paragraphs up — a maze is viable iff "SOME-but-not-ALL agents solve it — neither trivial nor
# impossible" — and then implements only the SOME half: viability_tally() asks n>0 and nothing else.
# A one-sided criterion cannot detect its own saturation, which is exactly disengagement.
#
# MEASURED ON THE LIVE CORPUS, 2026-08-18, with this tool's OWN VIABILITY_MAP and window:
#     FERTILE = 18, DORMANT = 0, of 18 areas  ->  discrimination rate 0.000
# Every area passes. The MCC-VIABILITY line is therefore a CONSTANT — it prints the whole population
# as FERTILE and "DORMANT: none" every run — and the HELD selection step this file proposes ("bias
# illum_pick toward VIABLE areas") would be a literal no-op, because VIABLE is the entire population.
# That is not a healthy reading of a fertile mesh; it is the criterion having stopped discriminating,
# and it is invisible in a line that only lists who passed.
#
# SHIPPED (this review): viability_tally() now publishes ENGAGEMENT beside the partition — the
# fraction of the area population the criterion actually separates — and names the pole when it
# saturates: DISENGAGED(all-pass) when nothing is dormant, DISENGAGED(all-dormant) when nothing is
# fertile, ENGAGED otherwise. Report-only, exactly as the partition already is. The point is that
# an all-pass and a genuinely-fertile mesh currently print the SAME line, and after this they do not.
# HELD (behavioural, steward/operator-gated): the reduced-virulence move itself — tighten the
# criterion (shorten the window, or require MORE than one landing) until it discriminates again,
# which is "aim at the frontier, not at maximum difficulty" transposed. Held because changing the
# criterion changes which areas get drawn, and that is a generation-BEHAVIOUR change; and because a
# saturated read has a benign reading too (a genuinely productive spell across every area), which
# only a trend over several windows can separate from a criterion that has gone slack.
#
# SHIPPED (this review, cheap + read-mostly): viability_tally() reads the LANDING artifacts ($REVIEWS =
# docs/reviews) — one file per productive review, its filename carrying the area-prefix and a -YYYY-MM-DD stamp —
# and over VIABILITY_WINDOW_D emits ONE measured MCC-VIABILITY line to $SPLOG: which review-AREAS still pass the
# minimal criterion (landed within the window = VIABLE/fertile) vs which are DORMANT (no recent landing = the
# maze the capability-set has made trivial). It only LOGS — the measurement is the artifact.
# HELD (behavioral, steward/operator-gated — the SELECTION side): bias illum_pick toward VIABLE areas (a
# minimal-criterion filter on the illumination draw — Brant & Stanley's actual move), and, the generative half
# the RR-impasse block called "the non-computable reframe (Jaeger 2024)": MCC shows new problems need NOT be
# externally minted — a DORMANT area is retired and a VIABLE one SPAWNS a variant (mutate its angle), a
# coevolving population under the minimal criterion with no external creativity. WHY HELD: biasing the draw is a
# generation-BEHAVIOUR change (steward's, not a report), and a dormant read must be REAL not a flap — an area
# can read dormant merely because its recent reviews happened to find it already-embodied (the honest-flap caveat
# every gate here carries). Detection ships; the selection/spawn stays open. Artifact:
# docs/reviews/oee-minimal-criterion-coevolution-viability-mesh-ideate-2026-07-29.md
# area<TAB>regex over review-filename prefixes (the landing artifacts use short slugs, not the prose AREA names).
VIABILITY_MAP=$(cat <<'EOF'
autopoiesis	^(autopoiesis|allopoiesis|enactiv)
second-order cybernetics	^(second-order|vsm|von-foerster|nontrivial|scheduled-appearance|soc-)
free energy / active inference	^(efe|active-inference|free-energy|fep|expected-free)
swarm & stigmergy	^(swarm|forage|stigmerg|ant-)
edge of chaos / CAS	^(edge-of|complex-adaptive|criticality|dynamic-range)
Deleuze & Guattari	^(deleuze)
enactivism & 4E	^(enactiv|umwelt|4e-)
homeostasis & allostasis	^(homeostasis|allostasis|rheostasis|ultrastab|antifragility-parisian|correlation-body)
niche construction	^(niche|extended-phenotype)
antifragility & ruin	^(antifragility|convexity|ruin|via-negativa)
distributed coordination	^(distributed|crdt|gossip|distsys|causal|hledger)
information theory of agency	^(info-theory|empowerment|predictive-information)
predictive processing	^(predictive-processing|bayesian|rr-precision|precision)
artificial life & OEE	^(alife|oee|open-ended|map-elites|modes)
viable system model	^(vsm|management-cyb|stafford)
biosemiotics	^(biosemiotics|umwelt|semiotic)
self-organized criticality	^(self-organiz|criticality|power-law|soc-|edge-of-chaos-bin)
relevance realization	^(rr-|relevance|frame-problem|vervaeke)
EOF
)
# Report-only. Reads $REVIEWS filenames (basename<area-prefix>-...-YYYY-MM-DD.md), buckets by VIABILITY_MAP
# regex, and logs the minimal-criterion viability partition of the AREA population. Never blocks emission.
viability_tally(){
  [ -d "$REVIEWS" ] || { echo "$(ts) MCC-VIABILITY n/a — no landing corpus at $REVIEWS (minimal-criterion viability unobservable; Brant & Stanley 2017)" >> "$SPLOG" 2>/dev/null; return 0; }
  local cutoff files fertile="" dormant="" area re n nf=0 nd=0
  cutoff=$(date -u -d "$VIABILITY_WINDOW_D days ago" +%F 2>/dev/null) || cutoff="0000-00-00"
  files=$(ls -1 "$REVIEWS" 2>/dev/null | grep -E '\.md$') || files=""
  while IFS=$'\t' read -r area re; do
    [ -z "$area" ] && continue
    # a landing is VIABLE iff its filename date-stamp is within the window (ISO dates compare lexically)
    n=$(printf '%s\n' "$files" | grep -E "$re" 2>/dev/null \
        | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}\.md$' | sed 's/\.md$//' \
        | awk -v c="$cutoff" '$0 >= c' | grep -c .) ; n=${n:-0}
    if [ "$n" -gt 0 ]; then fertile="$fertile $area($n)"; nf=$((nf+1)); else dormant="$dormant $area"; nd=$((nd+1)); fi
  done <<< "$VIABILITY_MAP"
  # ENGAGEMENT — the fraction of the population the minimal criterion actually SEPARATES. Brant &
  # Stanley's criterion is "SOME but NOT ALL"; this tally tests only SOME, so it cannot see its own
  # saturation. A criterion that passes everyone (or no-one) has no gradient left: the partition below
  # is a constant and any selection keyed on it is a no-op. See the DISENGAGEMENT block in the header.
  local ntot=$((nf+nd)) eng="n/a" engv="UNOBSERVABLE"
  if [ "$ntot" -gt 0 ]; then
    eng=$(awk -v d="$nd" -v t="$ntot" 'BEGIN{printf "%.3f", d/t}')
    if   [ "$nd" -eq 0 ]; then engv="DISENGAGED(all-pass — every area clears the criterion, so FERTILE is the whole population and a selection keyed on it changes nothing)"
    elif [ "$nf" -eq 0 ]; then engv="DISENGAGED(all-dormant — no area clears the criterion, so the partition is equally empty of gradient)"
    else                        engv="ENGAGED"
    fi
  fi
  echo "$(ts) MCC-VIABILITY (${VIABILITY_WINDOW_D}d, minimal-criterion coevolution, Brant & Stanley 2017): FERTILE(still land not-embodied → keep drawing):${fertile:- none} | DORMANT(no recent landing → capability-set absorbed → HELD: retire/spawn-variant, don't keep coverage-drawing):${dormant:- none} | ENGAGEMENT ${eng} (${nd}/${ntot} discriminated out): ${engv}" >> "$SPLOG" 2>/dev/null
  return 0
}

# ── EVOLVABILITY over the review-area population (the OFFSPRING-DISTRIBUTION axis MCC/QD both miss) ──
# LITERATURE (artificial life & open-ended evolution, live review 2026-08-04 — the angle: a foundational
# idea applied TOO LOOSELY).
# THE IDEA: **evolvability** — "the capacity to generate adaptive variation" — is a property of a parent's
# OFFSPRING DISTRIBUTION, not of the parent's own performance, novelty, or productivity. Mengistu, Lehman &
# Clune, "Evolvability Search: Directly Selecting for Evolvability in order to Study and Produce It", GECCO
# 2016, estimate an individual's future potential as THE BEHAVIOURAL DIVERSITY OF ITS IMMEDIATE OFFSPRING and
# select on that directly — the paper exists precisely because the indirect proxies (fitness, novelty,
# archive coverage) were ASSUMED to imply evolvability and do not. Katona, Franks & Walker, "Quality
# Evolvability ES", arXiv:2103.10790 (2021), draw the line this block turns on, verbatim: "While Quality
# Diversity aims to find an archive of diverse and well-performing, but potentially genetically distant
# individuals, Quality Evolvability aims to find a single individual with a DIVERSE ... DISTRIBUTION OF
# OFFSPRING." Live end of the literature: Barnett, Meister & Rainey, "Experimental evolution of evolvability",
# Science 387(6736):eadr2756, 21 Feb 2025 (doi 10.1126/science.adr2756) — evolvability is itself a trait
# under selection, so it is a thing to MEASURE, not a side effect to assume.
#
# WHAT THE MESH READ TOO LOOSELY: this lane already carries the two neighbours and neither is this one.
# illum_pick() (MAP-Elites, 07-28) reads CELL COVERAGE — an archive property, no parent attribution at all.
# viability_tally() (MCC, 07-29) reads the parent's own PRODUCTIVITY — "did this area land a finding in the
# window" — a COUNT with no variance term. Katona et al.'s sentence above is exactly the QD-vs-QE distinction
# the mesh collapsed: an area that lands 8 findings ALL INTO THE SAME ORGAN scores maximally FERTILE under the
# minimal criterion and is, in the literature's own terms, a LOW-EVOLVABILITY parent — one trick, repeated.
# MEASURED ON THE LIVE CORPUS (137 docs/reviews landings, 60d window, this review): "self-organized
# criticality" N=8 K=3 E=0.29 (6 of 8 into mesh-criticality) and "swarm & stigmergy" N=10 K=4 E=0.33 both read
# top-tier FERTILE by count, while "Deleuze & Guattari" N=8 K=7 E=0.86 and "enactivism & 4E" N=10 K=10 E=1.00
# have the SAME landing counts and TEN TIMES the offspring spread. Count and spread are decoupled here, live —
# viability_tally cannot tell those pairs apart, and "edge of chaos / CAS" (N=3, K=1, E=0.00 — every landing
# into mesh-criticality) is FERTILE(3) to it. The sharpest form of it, same run: MCC reads ALL 18 AREAS FERTILE
# and DORMANT:none — on today's corpus the minimal criterion discriminates NOTHING — while evolvability splits
# the same 18 into 5 ONE-TRICK / 13 DIVERSIFYING. Those figures are the tool's answer on the day, NOT constants:
# the corpus grows and every one of them moves. Re-derive by running it; never quote these back.
# WHY IT'S CHEAP HERE (the same shape as the MAP-Elites landing's free descriptor): the field's standing
# objection to evolvability search is COST — Doncieux, Paolo, Laflaquière & Coninx, "Novelty Search makes
# Evolvability Inevitable", GECCO 2020 (arXiv:2005.06224), opens by noting estimation "is generally too
# expensive to be directly used as selective pressure", which is why they chase it as a SIDE EFFECT of novelty
# instead. That cost is sampling offspring you have not got. The mesh's offspring ALREADY EXIST as artifacts
# on disk — one docs/reviews file per landing — and their behavioural descriptor (WHICH ORGAN the landing
# modified) is already written down. Nothing is simulated; the whole instrument is a read. And Doncieux et
# al.'s "inevitable" does not cover this lane either way: the draw here is coverage+recency, not novelty
# search, and the live E above ranges 0.00–1.00 across areas, so it is plainly not uniform.
#
# SHIPPED: evolvability_tally() — report-only, logs ONE line beside MCC-VIABILITY. Per AREA over
# EVOL_WINDOW_D: N = resolved landings, K = distinct organs among them, E = (K-1)/(N-1) ∈ [0,1] — 0 = every
# offspring the same organ (one-trick parent), 1 = every offspring a different one. N<2 → honest n/a, never a
# guessed 0 (one landing has no offspring DISTRIBUTION). HELD (behavioural, steward's): using E to bias
# illum_pick — a one-trick area is not necessarily to be retired (it may be deepening a real organ), and that
# judgement is a selection change, not a report.
# Artifact: docs/reviews/oee-evolvability-offspring-distribution-mesh-ideate-2026-08-04.md

# Resolve a landing's OFFSPRING PHENOTYPE = the organ that landing modified. $1 = review basename.
# Prints "<organ>\t<name|body>"; rc=1 when unresolvable. TWO SOURCES, NOT a strong path with a rare fallback —
# on the live corpus the split is name=29 body=108, i.e. the body read is the MAJORITY resolver, and the tally
# prints the split on EVERY line so that never reads as a silent default. (name) = the organ token the modern
# landing convention puts last in the filename before the date stamp: exact, but only the post-2026-07-25
# landings carry it. (body) = the modal `scripts/mesh-X` mention inside the artifact: covers the whole corpus
# (137/137 resolve under the pair) at the cost of being MODAL — a review that merely discusses another organ
# more often than the one it landed in is misattributed. That is the instrument's weakest joint; it biases K
# DOWNWARD toward whichever organ a family of reviews keeps citing, so a ONE-TRICK verdict is the direction it
# can manufacture and a DIVERSIFYING verdict is the safe one. Read one-trick as a prompt to look, not a fact.
landing_organ(){
  local f="$1" stem o
  stem="${f%.md}"; stem="${stem%-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]}"
  o=$(printf '%s\n' "$stem" | grep -oE 'mesh-[a-z0-9]+(-[a-z0-9]+)*$' 2>/dev/null) || o=""
  [ -n "$o" ] && { printf '%s\tname\n' "$o"; return 0; }
  o=$(grep -ohE 'scripts/mesh-[a-z0-9]+(-[a-z0-9]+)*' "$REVIEWS/$f" 2>/dev/null | sed 's|scripts/||' \
      | sort | uniq -c | sort -rn | head -1 | awk '{print $2}') || o=""
  [ -n "$o" ] && { printf '%s\tbody\n' "$o"; return 0; }
  return 1
}

# Report-only. Never blocks emission. Same AREA buckets as viability_tally (VIABILITY_MAP) on purpose — the
# two lines are meant to be read side by side, since the whole finding is that they disagree.
evolvability_tally(){
  [ -d "$REVIEWS" ] || { echo "$(ts) EVOLVABILITY n/a — no landing corpus at $REVIEWS (offspring distribution unobservable; Mengistu/Lehman/Clune GECCO 2016)" >> "$SPLOG" 2>/dev/null; return 0; }
  local cutoff files resolved="" f d org area re organs n k e top
  local one_trick="" diversifying="" thin="" nm=0 nb=0 nu=0
  cutoff=$(date -u -d "$EVOL_WINDOW_D days ago" +%F 2>/dev/null) || cutoff="0000-00-00"
  files=$(ls -1 "$REVIEWS" 2>/dev/null | grep -E '\.md$') || files=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    d=$(printf '%s' "$f" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}\.md$' 2>/dev/null | sed 's/\.md$//') || d=""
    [ -z "$d" ] && continue
    [ "$d" '<' "$cutoff" ] && continue        # ISO dates compare lexically
    if org=$(landing_organ "$f"); then
      case "${org#*$'\t'}" in name) nm=$((nm+1)) ;; body) nb=$((nb+1)) ;; esac
      resolved="$resolved$f"$'\t'"${org%%$'\t'*}"$'\n'
    else nu=$((nu+1)); fi
  done <<< "$files"
  while IFS=$'\t' read -r area re; do
    [ -z "$area" ] && continue
    organs=$(printf '%s' "$resolved" | awk -F'\t' -v re="$re" 'NF>=2 && $1 ~ re {print $2}')
    n=$(printf '%s\n' "$organs" | grep -c .); n=${n:-0}
    [ "$n" -lt 1 ] && continue
    k=$(printf '%s\n' "$organs" | sort -u | grep -c .); k=${k:-0}
    # one landing is not an offspring DISTRIBUTION — honest n/a, never E=0 (which would read as one-trick)
    [ "$n" -lt 2 ] && { thin="$thin $area(N=$n)"; continue; }
    e=$(awk -v k="$k" -v n="$n" 'BEGIN{printf "%.2f",(k-1)/(n-1)}')
    if [ "$n" -ge "$EVOL_MIN_N" ] && awk -v e="$e" -v t="$EVOL_ONE_TRICK_E" 'BEGIN{exit !(e<=t)}'; then
      top=$(printf '%s\n' "$organs" | sort | uniq -c | sort -rn | head -1 | awk '{print $2}')
      one_trick="$one_trick $area(N=$n,K=$k,E=$e→$top)"
    else
      diversifying="$diversifying $area(N=$n,K=$k,E=$e)"
    fi
  done <<< "$VIABILITY_MAP"
  echo "$(ts) EVOLVABILITY (${EVOL_WINDOW_D}d, offspring-organ diversity per review-AREA, E=(K-1)/(N-1); Mengistu/Lehman/Clune GECCO 2016 · Katona et al. arXiv:2103.10790): ONE-TRICK(≥$EVOL_MIN_N landings, E≤$EVOL_ONE_TRICK_E — MCC reads these FERTILE while the offspring collapse onto ONE organ):${one_trick:- none} | DIVERSIFYING:${diversifying:- none} | thin(N<2 → honest n/a, no offspring distribution):${thin:- none} | descriptor: name=$nm body=$nb unresolved=$nu" >> "$SPLOG" 2>/dev/null
  return 0
}

gen_literature(){
  local na; na=$(printf '%s\n' "$AREAS" | grep -c .)
  [ "${na:-0}" -lt 1 ] && return 1
  viability_tally   # report-only: log the minimal-criterion viability partition of the AREA population (MCC) — never blocks
  evolvability_tally   # report-only: the offspring-distribution axis MCC's landing COUNT is blind to — never blocks

  # DENSITY-DEPENDENT RELAXATION (Talamali 2019 rsos.190225 — see gen_connection): the AREAS×ANGLES
  # grid is small and recent_has (RECENT_MAX window) can mute all of it in a busy run → silent
  # starve. Phase 0 strict; Phase 1 lifts recent_has so a soft-discouraged directive re-emits rather
  # than the generator producing nothing (there is no repellent on the literature path, so Phase 1
  # always recovers as long as the grid is non-empty).
  local relax
  for relax in 0 1; do
    local tries=0 area angle key
    while [ "$tries" -lt 12 ]; do
      tries=$((tries+1))
      # MAP-ELITES illumination (see header): draw the DARKEST niche of the AREAS×ANGLES grid instead of a
      # uniform-random cell, so the 108-cell descriptor space is systematically illuminated rather than
      # coupon-collected. The darkest cell is by construction rarely-emitted, so it seldom collides with
      # recent_has — empty-cell targeting and the exact-key dedup reinforce rather than fight.
      # walk the RANKING, not a re-draw: the circulation is deterministic, so a rejected cell would
      # come back identical on every retry (`shuf` used to hide this by re-drawing). Rank n == the nth
      # cell along the isocontour, so a recent_has rejection advances the circulation instead of stalling.
      local cell; cell="$(illum_pick "$tries")"
      area="${cell%%$'\t'*}"; angle="${cell#*$'\t'}"
      [ -z "$area" ] && continue
      key="lit:$area|$angle"
      [ "$relax" = 0 ] && recent_has "$key" && continue
      recent_add "$key"; sparseness_note "$key" "$area"; illum_add "$area|$angle"
      [ "$relax" = 1 ] && echo "$(ts) FIELD-RELAX gen_literature: strict draws exhausted → lifted recent_has, emitted $key (density-dependent relaxation, Talamali 2019)" >> "$SPLOG" 2>/dev/null
      printf 'LITERATURE (live review): land on the area of %s, from the angle of %s. Do an ACTUAL review — search current, real sources (web), read, and surface ONE concept, paper, or mechanism we do NOT already embody. Name it, cite where you found it, and propose ONE concrete application to a real organ/sense/reflex (name the file) — or discard in one line why it does not apply. The point is LIVE literature (continuously published), not a fixed list: land somewhere we have not been.' \
        "$area" "$angle"
      return 0
    done
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  f=0
  command -v shuf >/dev/null 2>&1 || { echo "smoke-test: FAIL (shuf missing — random pairing impossible)"; exit 1; }
  command -v mesh-tools >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-tools missing — no inventory)"; exit 1; }
  invn=$(inventory | grep -c .)
  [ "${invn:-0}" -ge 2 ] || { echo "smoke-test: FAIL (inventory < 2 items: $invn — mesh-tools perceive parse broke)"; exit 1; }
  echo "  ok: inventory parsed ($invn senses/actuators)"
  arean=$(printf '%s\n' "$AREAS" | grep -c .); anglen=$(printf '%s\n' "$ANGLES" | grep -c .)
  [ "$arean" -ge 8 ] && [ "$anglen" -ge 3 ] || { echo "smoke-test: FAIL (literature space too small: $arean areas x $anglen angles)"; exit 1; }
  echo "  ok: live-review space ($arean areas x $anglen angles = $((arean*anglen)) directives)"
  # sandbox STATE *and* SEEDS *and* SPLOG *and* TRACES/REPELLENT so the test never touches the real
  # recent-state/seeds/log/traces/repellent-store
  STATE="$(mktemp)"; SEEDS="$(mktemp)"; SPLOG="$(mktemp)"; TRACES="$(mktemp)"; REPELLENT="$(mktemp)"; ABLATION="$(mktemp)"; ILLUM="$(mktemp)"
  trap 'rm -f "$STATE" "$STATE.tmp" "$SEEDS" "$SPLOG" "$TRACES" "$REPELLENT" "$REPELLENT.tmp" "$ABLATION" "$ILLUM" "$ILLUM.tmp"' EXIT
  : > "$TRACES"; : > "$REPELLENT"; : > "$ABLATION"; : > "$ILLUM"
  # sparseness instrument: a 2nd literature key in the SAME area (different angle) is a near-neighbor —
  # distinct key, but exact-key dedup let it through → must log LOW-SPARSENESS.
  printf 'lit:criticality|angleA\n' > "$STATE"
  sparseness_note "lit:criticality|angleB" "criticality"
  grep -q 'LOW-SPARSENESS lit:criticality|angleB' "$SPLOG" || { echo "smoke-test: FAIL (sparseness: same-area near-neighbor not flagged)"; exit 1; }
  : > "$SPLOG"
  # a genuinely novel area must NOT flag (no near-neighbor in the archive)
  sparseness_note "lit:far-out-topic|angleA" "far-out-topic"
  [ -s "$SPLOG" ] && { echo "smoke-test: FAIL (sparseness: novel area wrongly flagged as low-sparseness)"; exit 1; }
  : > "$STATE"; : > "$SPLOG"
  echo "  ok: novelty-search sparseness instrument flags same-region, passes novel"
  # ── MAP-ELITES ILLUMINATION (Mouret & Clune 2015): gen_literature must draw the DARKEST area×angle
  # niche, not a uniform-random one. Seed the coverage archive with EVERY grid cell at count 1 EXCEPT one
  # target cell (absent → count 0 = the UNIQUE global minimum); one emission MUST land on the target cell.
  # Drives the REAL gen_literature/illum_pick (defined above this block), no hermetic copy. FALSIFIABLE:
  # under the pre-fix uniform `shuf` the emission is a random cell → hits the target ~1/108 → RED.
  ( _ill_state="$(mktemp)"; STATE="$_ill_state"; SPLOG="$(mktemp)"
    _ta="artificial life & open-ended evolution"; _tg="a known CRITIQUE or failure mode of this area"
    : > "$ILLUM"
    while IFS= read -r _a; do [ -z "$_a" ] && continue
      while IFS= read -r _g; do [ -z "$_g" ] && continue; printf '%s|%s\n' "$_a" "$_g"; done <<< "$ANGLES"
    done <<< "$AREAS" | grep -vxF "$_ta|$_tg" > "$ILLUM"
    _out="$(gen_literature)"
    { printf '%s' "$_out" | grep -qF "$_ta" && printf '%s' "$_out" | grep -qF "$_tg"; } \
      || { echo "smoke-test: FAIL (MAP-Elites: gen_literature did not target the unique darkest niche — got: $(printf '%s' "$_out" | head -c 100))"; rm -f "$_ill_state" "$SPLOG"; exit 1; }
    rm -f "$_ill_state" "$_ill_state.tmp" "$SPLOG" ) || exit 1
  : > "$ILLUM"; : > "$STATE"
  echo "  ok: MAP-Elites illumination targets the darkest area×angle niche (empty-cell targeting)"
  # ── SOLENOIDAL CIRCULATION ON THE ISOCONTOUR (FEP / Physics Reports 2023, eq. 6; non-reversible
  # sampling refs [113-115]). The gate above covers the GRADIENT term (a unique global minimum). This
  # covers the term that was missing: what happens ON the isocontour, where the gradient says nothing.
  # Seed the archive with EVERY cell emitted exactly once, in a known order — so all 108 are tied at
  # coverage 1 and the ONLY remaining signal is staleness. The picks must then come out in exactly the
  # seeded order, oldest first, with no repeat: that IS the circulation. FALSIFIABLE: under the pre-fix
  # `shuf` tie-break the odds of reproducing 6 in order are ~108^-6, and a repeat is near-certain.
  ( : > "$ILLUM"
    while IFS= read -r _a; do [ -z "$_a" ] && continue
      while IFS= read -r _g; do [ -z "$_g" ] && continue; printf '%s|%s\n' "$_a" "$_g"; done <<< "$ANGLES"
    done <<< "$AREAS" | tac > "$ILLUM"          # reverse grid order, so grid order cannot fake a pass
    _want="$(head -6 "$ILLUM")"; _got=""; _seen=""
    for _i in 1 2 3 4 5 6; do
      _c="$(illum_pick)"; _cell="${_c%%$'\t'*}|${_c#*$'\t'}"
      case "$_seen" in *"[$_cell]"*) echo "smoke-test: FAIL (solenoidal: circulation repeated $_cell within one cycle — the tie-break is not divergence-free)"; exit 1;; esac
      _seen="$_seen[$_cell]"
      _got="${_got:+$_got
}$_cell"
      illum_add "$_cell"
    done
    [ "$_got" = "$_want" ] || { echo "smoke-test: FAIL (solenoidal: on a flat isocontour the pick must circulate oldest-first)"; printf '  want: %s\n  got:  %s\n' "$(printf '%s' "$_want" | head -2 | tr '\n' ' ')" "$(printf '%s' "$_got" | head -2 | tr '\n' ' ')"; exit 1; }
    # the ranking must also be a real ranking: rank 2 is the NEXT cell along the contour, never rank 1
    # (this is what lets a recent_has rejection advance the circulation instead of stalling on it)
    : > "$ILLUM"
    while IFS= read -r _a; do [ -z "$_a" ] && continue
      while IFS= read -r _g; do [ -z "$_g" ] && continue; printf '%s|%s\n' "$_a" "$_g"; done <<< "$ANGLES"
    done <<< "$AREAS" | tac > "$ILLUM"
    _r1="$(illum_pick 1)"; _r2="$(illum_pick 2)"
    [ -n "$_r1" ] && [ -n "$_r2" ] && [ "$_r1" != "$_r2" ] \
      || { echo "smoke-test: FAIL (solenoidal: illum_pick <n> does not walk the ranking — a rejected cell would stall the draw)"; exit 1; }
  ) || exit 1
  : > "$ILLUM"; : > "$STATE"
  echo "  ok: solenoidal circulation on the illumination isocontour (oldest-first, no repeat, ranked walk)"
  # ── NICHE-CONSTRUCTION ABLATION CONTROL (Rösner et al. bioRxiv 2025.03.27.645637 — removal-as-
  # measurement). Drive ablation_probe over a full window with the field forced so EVERY null draw lands
  # muted → must emit a MEASURED FIELD-LOAD-BEARING verdict at the window boundary, then roll clean.
  # FALSIFIABLE: force the field to never mute → must emit FIELD-INERT/OVER-CONSTRAINING instead.
  ( ABLATION="$(mktemp)"; SPLOG="$(mktemp)"; ABLATION_WINDOW=5
    recent_has(){ return 0; }; repellent_has(){ return 1; }   # every null draw is muted → load-bearing
    i=0; while [ "$i" -lt "$ABLATION_WINDOW" ]; do ablation_probe "conn:x|y" "A"$'\t'"d1"$'\n'"B"$'\t'"d2"; i=$((i+1)); done
    grep -q 'NICHE-CONSTRUCTION-CONTRIBUTION 100% .* FIELD-LOAD-BEARING' "$SPLOG" || { echo "  FAIL: all-muted null draws must measure FIELD-LOAD-BEARING"; exit 3; }
    [ -s "$ABLATION" ] && { echo "  FAIL: ablation window not rolled after verdict"; exit 3; }
    : > "$SPLOG"
    recent_has(){ return 1; }; repellent_has(){ return 1; }   # never muted → field inert/over-constraining
    i=0; while [ "$i" -lt "$ABLATION_WINDOW" ]; do ablation_probe "conn:x|y" "A"$'\t'"d1"$'\n'"B"$'\t'"d2"; i=$((i+1)); done
    grep -q 'NICHE-CONSTRUCTION-CONTRIBUTION 0% .* FIELD-INERT/OVER-CONSTRAINING' "$SPLOG" || { echo "  FAIL: no-mute null draws must measure FIELD-INERT/OVER-CONSTRAINING"; exit 3; }
    rm -f "$ABLATION" "$SPLOG" ) || { echo "smoke-test: FAIL (niche-construction ablation control regressed)"; exit 1; }
  echo "  ok: niche-construction ablation control measures field contribution (load-bearing vs inert)"
  # ── COUNTERACTIVE NICHE CONSTRUCTION (Odling-Smee/Laland/Feldman 2003 — oppose own over-construction).
  # A store above the floor must be thinned to ~2/3, keeping the FRESHEST (largest-expiry) entries; a
  # store at/below the floor must be untouched (nothing to oppose). FALSIFIABLE: if counteract dropped the
  # freshest instead of the oldest, the surviving max-expiry would fall — assert the freshest survives.
  ( REPELLENT="$(mktemp)"; SPLOG="$(mktemp)"; REPELLENT_COUNTERACT_FLOOR=6
    i=1; while [ "$i" -le 9 ]; do printf '%s\tconn:k%s\n' "$((1000+i))" "$i" >> "$REPELLENT"; i=$((i+1)); done
    repellent_counteract
    left=$(grep -c . "$REPELLENT"); [ "$left" = 6 ] || { echo "  FAIL: counteract of 9 must keep 6 (kept $left)"; exit 4; }
    grep -q 'conn:k9' "$REPELLENT" || { echo "  FAIL: freshest (largest expiry) entry must survive counteract"; exit 4; }
    grep -q 'conn:k1' "$REPELLENT" && { echo "  FAIL: oldest (smallest expiry) entry must be decayed by counteract"; exit 4; }
    grep -q 'REPELLENT-COUNTERACT decayed 3/9' "$SPLOG" || { echo "  FAIL: counteract not logged"; exit 4; }
    # below-floor store is untouched (nothing to oppose)
    : > "$REPELLENT"; : > "$SPLOG"
    i=1; while [ "$i" -le 4 ]; do printf '%s\tconn:s%s\n' "$((1000+i))" "$i" >> "$REPELLENT"; i=$((i+1)); done
    repellent_counteract
    [ "$(grep -c . "$REPELLENT")" = 4 ] || { echo "  FAIL: below-floor store must be untouched"; exit 4; }
    [ -s "$SPLOG" ] && { echo "  FAIL: below-floor counteract must be a no-op (logged anyway)"; exit 4; }
    rm -f "$REPELLENT" "$REPELLENT.tmp" "$SPLOG" ) || { echo "smoke-test: FAIL (counteractive niche construction regressed)"; exit 1; }
  echo "  ok: counteractive niche construction thins own over-deposit (oldest tail), spares fresh + below-floor"
  : > "$SEEDS"   # empty seeds → connection falls back to random aleatory
  c="$(gen_connection)" || { echo "smoke-test: FAIL (gen_connection produced nothing)"; exit 1; }
  printf '%s' "$c" | grep -q '^CONNECTION (auto novelty)' || { echo "smoke-test: FAIL (random connection malformed: $c)"; exit 1; }
  echo "  ok: random connection idea generated (no seed → aleatory)"
  # data-seeded path: plant a correlation seed, assert gen_connection consumes it
  printf 'tempo\tpsi\tlift\tlift 2.1, 9 co-bins of 20, window 3.0h\n' > "$SEEDS"
  cs="$(gen_connection)" || { echo "smoke-test: FAIL (seeded gen_connection produced nothing)"; exit 1; }
  printf '%s' "$cs" | grep -q '^CONNECTION (data-seeded).*tempo.*psi' || { echo "smoke-test: FAIL (data-seeded connection didn't use the seed: $cs)"; exit 1; }
  [ -s "$SEEDS" ] && { echo "smoke-test: FAIL (seed not consumed/removed: $(cat "$SEEDS"))"; exit 1; }
  echo "  ok: data-seeded connection consumed the correlation seed (append path)"
  # SEED-SUPPRESS: a pair already in the recent archive (re-seeded by the sliding coosc/correlate
  # window) must NOT re-emit a data-seeded duplicate — it falls back to aleatory. conn:psi|tempo is
  # in STATE from the emission just above. (DV8235×Mobicar2 re-fired 6× in ~2h before this guard;
  # ideas-queue 2915–2925, every one [x] with the identical common-mode verdict.)
  : > "$SPLOG"
  printf 'tempo\tpsi\tcoosc\tr=0.6, 10 Δ-steps over 4.0h\n' > "$SEEDS"
  cs3="$(gen_connection)" || { echo "smoke-test: FAIL (suppress-path gen_connection produced nothing)"; exit 1; }
  printf '%s' "$cs3" | grep -q '^CONNECTION (data-seeded).*tempo.*psi' && { echo "smoke-test: FAIL (re-seeded already-emitted pair re-emitted as data-seeded — dedup missing): $cs3"; exit 1; }
  grep -q 'SEED-SUPPRESS conn:psi|tempo' "$SPLOG" || { echo "smoke-test: FAIL (re-seeded pair not logged SEED-SUPPRESS)"; exit 1; }
  [ -s "$SEEDS" ] && { echo "smoke-test: FAIL (suppressed seed not consumed/removed: $(cat "$SEEDS"))"; exit 1; }
  echo "  ok: re-seeded already-emitted pair suppressed (falls back to aleatory, SEED-SUPPRESS logged)"
  : > "$STATE"   # clear archive so the preview test below is a clean peek-vs-consume check, not a dedup hit
  # PREVIEW path (append=0) must PEEK, not consume — a --dry preview burning a scarce seed is a bug
  printf 'tempo\tpsi\tcoosc\tr=0.6, 10 Δ-steps over 4.0h\n' > "$SEEDS"
  cs2="$(append=0; gen_connection)" || { echo "smoke-test: FAIL (preview gen_connection produced nothing)"; exit 1; }
  printf '%s' "$cs2" | grep -q '^CONNECTION (data-seeded).*tempo.*psi' || { echo "smoke-test: FAIL (preview didn't use the seed: $cs2)"; exit 1; }
  [ -s "$SEEDS" ] || { echo "smoke-test: FAIL (--dry/preview CONSUMED the seed — append=0 must only peek)"; exit 1; }
  echo "  ok: preview (append=0) peeks the seed without consuming it"
  # ── DENSITY-DEPENDENT stigmergy RELAXATION (Talamali et al., R.Soc.Open Sci. 6:190225, 2019) ──
  # Past a density threshold a repellent-avoiding agent covers LESS than a random walker. When the
  # field saturates the viable pair-space, gen_connection must RELAX the weaker attractant and still
  # emit (never a silent 'no fresh idea' starve — the 2026-06-28 doctor FAIL); when even the STRONGER
  # repellent saturates it must SURFACE the over-constraint (log REPELLENT-SATURATED), not corrupt
  # output by re-emitting a known dead-end. Stubs run in SUBSHELLS so the inventory/recent_has/
  # repellent_has overrides never leak into later tests. FALSIFIABLE — drop the Phase-1 loop and (a)
  # FAILs; make Phase 1 lift the repellent too and (c) FAILs.
  : > "$SEEDS"; : > "$SPLOG"   # aleatory path (no seed) so the draw exercises recent_has/repellent_has
  df=0
  # (a) attractant-saturated (recent_has matches ALL), repellent empty → Phase 1 lifts recent → emits.
  ra="$( inventory(){ printf 'A\tx\nB\ty\n'; }; recent_has(){ return 0; }; recent_add(){ :; }; repellent_has(){ return 1; }; gen_connection )"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$ra" | grep -q '^CONNECTION'; } || { echo "  FAIL: attractant-saturated field must RELAX+emit (got rc=$rc)"; df=1; }
  grep -q 'FIELD-RELAX gen_connection' "$SPLOG" || { echo "  FAIL: relaxation not logged (FIELD-RELAX absent)"; df=1; }
  : > "$SPLOG"
  # (b) BOTH saturated (recent AND repellent match all) → no honest pair → emit NOTHING, rc=1, + surface.
  rb="$( inventory(){ printf 'A\tx\nB\ty\n'; }; recent_has(){ return 0; }; recent_add(){ :; }; repellent_has(){ return 0; }; gen_connection )"; rc=$?
  { [ "$rc" = 1 ] && [ -z "$rb" ]; } || { echo "  FAIL: fully-saturated field must emit nothing + rc=1 (got rc=$rc out=$rb)"; df=1; }
  grep -q 'REPELLENT-SATURATED gen_connection' "$SPLOG" || { echo "  FAIL: over-constraint not surfaced (REPELLENT-SATURATED absent — silent starve regressed)"; df=1; }
  : > "$SPLOG"
  # (c) FALSIFIER — relaxation must NOT lift the REPELLENT. recent matches all (forces relax); repellent
  #     mutes the sole pair conn:A|B → it must STILL be skipped → rc=1 (never re-emit a dead-end).
  rc2="$( inventory(){ printf 'A\tx\nB\ty\n'; }; recent_has(){ return 0; }; recent_add(){ :; }; repellent_has(){ [ "$1" = 'conn:A|B' ]; }; gen_connection )"; rcx=$?
  [ "$rcx" = 1 ] || { echo "  FAIL: relaxed phase leaked past the repellent (re-emitted a dead-end): rc=$rcx out=$rc2"; df=1; }
  : > "$SPLOG"
  [ "$df" = 0 ] || { echo "smoke-test: FAIL (density-dependent stigmergy relaxation regressed)"; exit 1; }
  echo "  ok: field-saturation relaxation (Talamali 2019): attractant-saturated→relax+emit, fully-saturated→surface REPELLENT-SATURATED, repellent honored under relax"
  l="$(gen_literature)" || { echo "smoke-test: FAIL (gen_literature produced nothing)"; exit 1; }
  printf '%s' "$l" | grep -q '^LITERATURE (live review)' || { echo "smoke-test: FAIL (literature directive malformed: $l)"; exit 1; }
  echo "  ok: literature live-review directive generated"
  # non-repeat: STATE now has keys; a 2nd connection must differ from the 1st
  k1=$(sed -n '1p' "$STATE")
  c2="$(gen_connection)" && [ -n "$c2" ] && echo "  ok: non-repeat state holds ${k1}"
  # ROTATION: a waiting data-grounded seed must PREEMPT the lit-parity (data-driven dominates). Run the
  # full flow in a sandboxed MESH so the inline rotation logic is exercised (not just the functions).
  rs="$(mktemp -d)"
  printf 'A_sense\tB_sense\tcoosc\tr=0.7, 12 Δ-steps\n' > "$rs/.correlation-seeds"
  printf 'k1\nk2\n' > "$rs/.ideate-state"           # cnt=2 → 2%%3==2 → parity alone would pick LITERATURE
  ro="$(MESH="$rs" bash "$0" --dry 2>&1)"
  printf '%s' "$ro" | grep -q '^CONNECTION (data-seeded)' \
    || { echo "smoke-test: FAIL (waiting seed did NOT preempt lit-rotation: $ro)"; rm -rf "$rs"; exit 1; }
  [ -s "$rs/.correlation-seeds" ] || { echo "smoke-test: FAIL (rotation/--dry consumed the seed)"; rm -rf "$rs"; exit 1; }
  echo "  ok: data-grounded seed preempts the lit-parity rotation (--dry preserved it)"
  rm -rf "$rs"
  # fallback: with NO seed and the SAME parity state (cnt%%3==2), rotation must pick LITERATURE. Fresh
  # sandbox so the previous run's recent-state mutation can't shift the count.
  rs2="$(mktemp -d)"
  : > "$rs2/.correlation-seeds"
  printf 'k1\nk2\n' > "$rs2/.ideate-state"          # cnt=2 → 2%%3==2 → parity picks LITERATURE
  rl="$(MESH="$rs2" bash "$0" --dry 2>&1)"
  printf '%s' "$rl" | grep -q '^LITERATURE' \
    || { echo "smoke-test: FAIL (no-seed parity should pick literature at cnt%%3==2: $rl)"; rm -rf "$rs2"; exit 1; }
  echo "  ok: no-seed fallback honors the connection/literature parity"
  rm -rf "$rs2"
  # REPELLENT / no-entry stigmergy (Robinson et al. 2005; review-repellent-no-entry-stigmergy-mesh-ideate,
  # unblocked 2026-07-01 by the gen-pair-deadend trace channel that landed independently 2026-06-25,
  # aff952b). A fresh dead-end must repel (order-independent key); one older than REPELLENT_TTL must not
  # (decays, doesn't freeze the pairing out forever).
  now_epoch=$(date -u +%s)
  fresh_ts=$(date -u -d "@$((now_epoch - 60))" +%FT%TZ)
  stale_ts=$(date -u -d "@$((now_epoch - REPELLENT_TTL - 3600))" +%FT%TZ)
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-zzz×mesh-yyy: dead end, discard\n' "$fresh_ts" > "$TRACES"
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-old1×mesh-old2: ancient dead end\n' "$stale_ts" >> "$TRACES"
  repellent_ingest
  repellent_has "conn:mesh-yyy|mesh-zzz" || { echo "smoke-test: FAIL (fresh gen-pair-deadend not ingested into repellent store, order-independent key)"; exit 1; }
  repellent_has "conn:mesh-old1|mesh-old2" && { echo "smoke-test: FAIL (trace line older than REPELLENT_TTL wrongly repelled — decay broken)"; exit 1; }
  echo "  ok: repellent_ingest derives a non-expired negative marker from gen-pair-deadend, decays past TTL"
  # SPACED SIGNAL NAMES (2026-08-20) — the regression that let wifi TP-Link_97E0_5G × wifi Keenetic-8813
  # be re-seeded 14.5h after its own dead-end verdict. Uses the VERBATIM live trace shape: multi-word
  # sides, spaces flanking the ×, and the reverse order the re-seed arrived in (the key must be
  # order-independent, so the SAME trace must repel BOTH orderings). Second leg: the ASCII ` x ` a mind
  # types for the multiplication sign (10 of the 12 real drops). Break either and this goes red — the
  # pre-fix `[^[:space:]]+×` parses NEITHER line, leaving the store empty and the pair free to re-mint.
  printf '%sZ  discover@test  ::  gen-pair-deadend wifi TP-Link_97E0_5G × wifi Keenetic-8813: spurious, discard\n' "$fresh_ts" > "$TRACES"
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-aaa x mesh-bbb: ascii separator, discard\n' "$fresh_ts" >> "$TRACES"
  repellent_ingest
  repellent_has "conn:wifi Keenetic-8813|wifi TP-Link_97E0_5G" \
    || { echo "smoke-test: FAIL (spaced multi-word signal names must arm the repellent — the live wifi re-seed: $(cat "$REPELLENT"))"; exit 1; }
  repellent_has "conn:mesh-aaa|mesh-bbb" \
    || { echo "smoke-test: FAIL (ASCII ' x ' separator must arm the repellent when the line carries no ×)"; exit 1; }
  # NEGATIVE: a × line must never be re-split on a literal letter x inside a name.
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-xray×mesh-oxide: keep whole, discard\n' "$fresh_ts" > "$TRACES"
  repellent_ingest
  repellent_has "conn:mesh-oxide|mesh-xray" \
    || { echo "smoke-test: FAIL (× line wrongly re-split on a literal 'x' inside a tool name)"; exit 1; }
  echo "  ok: repellent_ingest parses spaced multi-word signal names + an ASCII 'x' separator (no × line re-split)"
  # DEPTH (2026-08-20) — the read window must not be a second, shorter horizon than the TTL. The verdict
  # is buried under 2500 lines of unrelated filler, i.e. PAST the `tail -n 2000` this used to read, while
  # its own 30d TTL has 30d left to run. Under the old bound the store comes back EMPTY and the pair is
  # free to re-mint — which is exactly what happened live, where the motivating wifi verdict sat at depth
  # 488/2000 and was ~35h from ageing out. The stale line stays too, so this leg cannot pass by simply
  # ignoring the TTL: reading deeper must not resurrect a decayed verdict. Seen red against `tail -n 2000`.
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-deep1×mesh-deep2: buried dead end, discard\n' "$fresh_ts" > "$TRACES"
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-oldd1×mesh-oldd2: buried ancient dead end\n' "$stale_ts" >> "$TRACES"
  awk -v n=2500 'BEGIN{for(i=0;i<n;i++) printf "2026-08-20T00:00:00Z  filler@test  ::  unrelated trace line %d\n", i}' >> "$TRACES"
  : > "$REPELLENT"
  repellent_ingest
  repellent_has "conn:mesh-deep1|mesh-deep2" \
    || { echo "smoke-test: FAIL (a verdict buried under 2500 filler lines must still arm — the read window is a SECOND horizon shorter than REPELLENT_TTL; store: $(cat "$REPELLENT"))"; exit 1; }
  repellent_has "conn:mesh-oldd1|mesh-oldd2" \
    && { echo "smoke-test: FAIL (reading the whole file resurrected a verdict past REPELLENT_TTL — decay must stay the only horizon)"; exit 1; }
  echo "  ok: repellent_ingest reads a verdict buried past 2500 lines; TTL decay is the only horizon"
  # restore the fixture the integration leg below reads (this block rewrote $TRACES)
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-zzz×mesh-yyy: dead end, discard\n' "$fresh_ts" > "$TRACES"
  printf '%sZ  discover@test  ::  gen-pair-deadend mesh-old1×mesh-old2: ancient dead end\n' "$stale_ts" >> "$TRACES"
  # integration: a data-seeded pair under an active repellent must SEED-SUPPRESS just like recent_has,
  # even though it was never in STATE (this is the DV8235×Mobicar2-class re-seed the review named).
  : > "$SPLOG"; : > "$STATE"
  printf 'mesh-yyy\tmesh-zzz\tcoosc\tr=0.9, 5 Δ-steps\n' > "$SEEDS"
  csr="$(gen_connection)" || { echo "smoke-test: FAIL (repellent-path gen_connection produced nothing)"; exit 1; }
  printf '%s' "$csr" | grep -q '^CONNECTION (data-seeded)' && { echo "smoke-test: FAIL (repelled pair still emitted as data-seeded): $csr"; exit 1; }
  grep -q 'SEED-SUPPRESS conn:mesh-yyy|mesh-zzz' "$SPLOG" || { echo "smoke-test: FAIL (repelled pair not logged SEED-SUPPRESS)"; exit 1; }
  [ -s "$SEEDS" ] && { echo "smoke-test: FAIL (repelled seed not consumed/removed)"; exit 1; }
  echo "  ok: active repellent suppresses a data-seeded pair a mind already discarded, falls back to aleatory"
  # ── MINIMAL-CRITERION VIABILITY (MCC, Brant & Stanley 2017) — viability_tally reads the landing corpus ──
  # FALSIFIABLE: a RECENT landing for an area → that area reads FERTILE; an area with only an ANCIENT landing
  # (older than the window) → DORMANT. Break the `>= cutoff` recency test and (a) fails (ancient reads fertile).
  vt="$(mktemp -d)"; recent_d=$(date -u -d '2 days ago' +%F); old_d=$(date -u -d '400 days ago' +%F)
  : > "$SPLOG"
  # a fresh alife landing (VIABLE) and an ANCIENT deleuze landing (past the 30d window → DORMANT)
  : > "$vt/alife-fresh-mechanism-${recent_d}.md"
  : > "$vt/deleuze-ancient-idea-${old_d}.md"
  REVIEWS="$vt" viability_tally
  vline="$(grep 'MCC-VIABILITY' "$SPLOG" | tail -1)"
  printf '%s' "$vline" | grep -q 'FERTILE.*artificial life & OEE(1)' \
    || { echo "smoke-test: FAIL (recent alife landing not read FERTILE by minimal criterion: $vline)"; rm -rf "$vt"; exit 1; }
  printf '%s' "$vline" | grep -qE 'DORMANT[^|]*Deleuze' \
    || { echo "smoke-test: FAIL (ancient-only deleuze landing must read DORMANT — recency criterion broken: $vline)"; rm -rf "$vt"; exit 1; }
  # a missing corpus is honest-n/a, never a faked all-fertile
  : > "$SPLOG"; REVIEWS="$vt/nope" viability_tally
  grep -q 'MCC-VIABILITY n/a' "$SPLOG" || { echo "smoke-test: FAIL (absent landing corpus must log honest n/a, not fake viability)"; rm -rf "$vt"; exit 1; }
  rm -rf "$vt"
  echo "  ok: minimal-criterion viability (MCC): recent landing→FERTILE, ancient-only→DORMANT, absent corpus→honest n/a"
  # ── DISENGAGEMENT / ENGAGEMENT (Cartlidge & Bullock 2004; ACCEL ICML 2022) ──────────────────────
  # A one-sided criterion cannot see its own saturation. The partition alone prints the SAME shape
  # whether the criterion is discriminating or has gone slack, so the gate must show all three states
  # and, above all, that all-pass and mixed do NOT print the same verdict. Measured on the live corpus
  # 2026-08-18 the real answer was 0/18 — this is not a hypothetical pole.
  # The mixed case first, off the fixture built above (fresh alife + ancient deleuze, REAL map):
  printf '%s' "$vline" | grep -q 'ENGAGEMENT' \
    || { echo "smoke-test: FAIL (the MCC line must publish ENGAGEMENT — a partition with no discrimination rate cannot show its own saturation: $vline)"; rm -rf "$vt"; exit 1; }
  printf '%s' "$vline" | grep -q 'ENGAGED' \
    || { echo "smoke-test: FAIL (a fixture with BOTH a fertile and a dormant area must read ENGAGED: $vline)"; rm -rf "$vt"; exit 1; }
  printf '%s' "$vline" | grep -q 'DISENGAGED' \
    && { echo "smoke-test: FAIL (a discriminating criterion must NOT read DISENGAGED — the verdict would be a constant: $vline)"; rm -rf "$vt"; exit 1; }
  # ...then BOTH saturated poles, on a 2-area substitute map so the fixture is exact and small.
  dz="$(mktemp -d)"
  _dzmap=$(printf 'alpha\t^(alpha)\nbeta\t^(beta)\n')
  : > "$dz/alpha-x-${recent_d}.md"; : > "$dz/beta-x-${recent_d}.md"
  : > "$SPLOG"; VIABILITY_MAP="$_dzmap" REVIEWS="$dz" viability_tally
  dline="$(grep 'MCC-VIABILITY' "$SPLOG" | tail -1)"
  printf '%s' "$dline" | grep -q 'ENGAGEMENT 0.000 (0/2 discriminated out): DISENGAGED(all-pass' \
    || { echo "smoke-test: FAIL (every area passing is DISENGAGEMENT, not health — the gradient is gone and any selection on FERTILE is a no-op: $dline)"; rm -rf "$vt" "$dz"; exit 1; }
  rm -f "$dz"/*.md; : > "$dz/alpha-x-${old_d}.md"; : > "$dz/beta-x-${old_d}.md"
  : > "$SPLOG"; VIABILITY_MAP="$_dzmap" REVIEWS="$dz" viability_tally
  dline2="$(grep 'MCC-VIABILITY' "$SPLOG" | tail -1)"
  printf '%s' "$dline2" | grep -q 'ENGAGEMENT 1.000 (2/2 discriminated out): DISENGAGED(all-dormant' \
    || { echo "smoke-test: FAIL (no area passing is the OTHER disengaged pole and must be named as such, not read as maximal discrimination: $dline2)"; rm -rf "$vt" "$dz"; exit 1; }
  # the two poles must not share a verdict string — a collapsed reason makes all-pass and all-dormant
  # indistinguishable, which is the failure this whole leg exists to prevent.
  pole1="$(printf '%s' "$dline"  | grep -o 'DISENGAGED([a-z]*-[a-z]*')"
  pole2="$(printf '%s' "$dline2" | grep -o 'DISENGAGED([a-z]*-[a-z]*')"
  if [ -z "$pole1" ] || [ -z "$pole2" ] || [ "$pole1" = "$pole2" ]; then
    echo "smoke-test: FAIL (all-pass and all-dormant must name DIFFERENT poles — opposite states, same sentence: '$pole1' vs '$pole2')"; rm -rf "$vt" "$dz"; exit 1
  fi
  rm -rf "$dz"
  echo "  ok: MCC disengagement: mixed→ENGAGED, all-pass→DISENGAGED(all-pass), all-dormant→DISENGAGED(all-dormant), poles named apart"
  # ── EVOLVABILITY / offspring-organ diversity (Mengistu, Lehman & Clune GECCO 2016; Katona et al.
  # arXiv:2103.10790). One fixture, two areas with the IDENTICAL landing COUNT and opposite offspring spread.
  # FALSIFIABLE: drop the distinct-organ term K and both areas read the same → (a)/(b) go red; drop the N<2
  # guard and a single landing reads E=0.00 → one-trick → (d) goes red.
  et="$(mktemp -d)"; ed=$(date -u -d '2 days ago' +%F)
  : > "$SPLOG"
  # (a) ONE-TRICK: 3 landings for "edge of chaos / CAS", every one into the SAME organ → K=1, E=0.00
  : > "$et/edge-of-chaos-a-mesh-criticality-${ed}.md"
  : > "$et/edge-of-chaos-b-mesh-criticality-${ed}.md"
  : > "$et/edge-of-chaos-c-mesh-criticality-${ed}.md"
  # (b) DIVERSIFYING: 3 landings for "biosemiotics", each into a DIFFERENT organ → K=3, E=1.00
  : > "$et/biosemiotics-a-mesh-alpha-${ed}.md"
  : > "$et/biosemiotics-b-mesh-beta-${ed}.md"
  : > "$et/biosemiotics-c-mesh-gamma-${ed}.md"
  # (d) THIN: one landing is not an offspring distribution → honest n/a, must NEVER read one-trick
  : > "$et/niche-solo-mesh-forage-${ed}.md"
  # (e) body-resolved: no organ token in the filename → modal `scripts/mesh-X` mention in the artifact
  printf 'lands in scripts/mesh-zzz — see scripts/mesh-zzz for the gate\n' > "$et/deleuze-body-resolved-${ed}.md"
  ef=0
  REVIEWS="$et" evolvability_tally
  eline="$(grep 'EVOLVABILITY' "$SPLOG" | tail -1)"
  printf '%s' "$eline" | grep -q 'ONE-TRICK[^|]*edge of chaos / CAS(N=3,K=1,E=0.00→mesh-criticality)' \
    || { echo "  FAIL: 3 landings into ONE organ must read ONE-TRICK E=0.00 (got: $eline)"; ef=1; }
  printf '%s' "$eline" | grep -q 'DIVERSIFYING[^|]*biosemiotics(N=3,K=3,E=1.00)' \
    || { echo "  FAIL: 3 landings into 3 organs must read DIVERSIFYING E=1.00 (got: $eline)"; ef=1; }
  printf '%s' "$eline" | grep -q 'thin[^|]*niche construction(N=1)' \
    || { echo "  FAIL: a single landing must be honest n/a (thin), never E=0/one-trick (got: $eline)"; ef=1; }
  printf '%s' "$eline" | grep -qE 'ONE-TRICK[^|]*niche construction' \
    && { echo "  FAIL: N=1 area flagged ONE-TRICK — the no-distribution guard is gone"; ef=1; }
  printf '%s' "$eline" | grep -q 'descriptor: name=7 body=1 unresolved=0' \
    || { echo "  FAIL: descriptor-source split not reported honestly (body fallback must be loud, not silent) (got: $eline)"; ef=1; }
  # THESIS leg: the minimal criterion sees the SAME two areas as EQUALLY fertile — count is blind to spread.
  : > "$SPLOG"; REVIEWS="$et" viability_tally
  vl="$(grep 'MCC-VIABILITY' "$SPLOG" | tail -1)"
  { printf '%s' "$vl" | grep -q 'edge of chaos / CAS(3)' && printf '%s' "$vl" | grep -q 'biosemiotics(3)'; } \
    || { echo "  FAIL: thesis leg broken — MCC must read BOTH fixture areas FERTILE(3) (got: $vl)"; ef=1; }
  # absent corpus → honest n/a, never a faked all-diverse
  : > "$SPLOG"; REVIEWS="$et/nope" evolvability_tally
  grep -q 'EVOLVABILITY n/a' "$SPLOG" || { echo "  FAIL: absent landing corpus must log honest n/a"; ef=1; }
  rm -rf "$et"; : > "$SPLOG"
  [ "$ef" = 0 ] || { echo "smoke-test: FAIL (evolvability / offspring-distribution instrument regressed)"; exit 1; }
  echo "  ok: evolvability (offspring-organ spread): same-organ→ONE-TRICK E=0.00, all-different→DIVERSIFYING E=1.00, N=1→honest n/a, MCC calls both FERTILE(3)"
  echo "smoke-test: ok"
  exit 0
fi

mode="rotate"
append=1
case "${1:-}" in
  --connect) mode="connect" ;;
  --lit)     mode="lit" ;;
  --dry)     append=0 ;;
  "")        ;;
  *) echo "usage: mesh-ideate [--connect|--lit|--dry|--test]" >&2; exit 2 ;;
esac
[ "${2:-}" = --dry ] && append=0

# rotate: a DATA-GROUNDED seed (left by mesh-correlate/mesh-cooscillate) PREEMPTS the finite
# connection/literature parity rotation — a real observation from the sensor data should dominate the
# synthetic spaces (operator 2026-06-20: let the data-driven source dominate). Only when NO seed waits
# do we fall back to the parity rotation (2/3 connection, 1/3 literature). `-s` is a peek, not a
# consume (seed_pop does the consume, append-only) — so this never burns the seed.
if [ "$mode" = rotate ]; then
  if [ -s "$SEEDS" ]; then
    mode="connect"     # unconsumed data-grounded seed exists → data-seeded connection takes priority
  else
    cnt=$(grep -c . "$STATE" 2>/dev/null); cnt="${cnt:-0}"
    if [ $(( cnt % 3 )) -eq 2 ]; then mode="lit"; else mode="connect"; fi
  fi
fi

# FLOOR gate (append mode only): seed a genuinely-empty queue, never pile on. If real or novel
# work is already pending (>= IDEATE_FLOOR open [ ] items), hold — one provocation at a time; the
# mind chews it, the next appears only once the queue drains. Keeps this a gentle source, not a
# treadmill. (Skipped for --dry so you can always preview.)
if [ "$append" = 1 ]; then
  floor="${IDEATE_FLOOR:-1}"
  open=$(grep -c '^\[ \]' "$Q" 2>/dev/null); open="${open:-0}"
  if [ "$open" -ge "$floor" ]; then
    echo "$(ts) mesh-ideate: queue has $open open idea(s) (>= floor $floor) — hold, not piling on"
    # mtime-touch (shared primitive, NOT a bare touch) — the fire-on-event tool's STATE file
    # holds only the recent-emitted-keys cache, so the mtime DOESN'T advance on a no-finding run
    # and a stale-mtime watchdog (mesh-reflex-health, mesh-doctor theater-check) false-fires
    # as "hollow cron-green with no fresh artifact". The hold path IS a successful cron eval:
    # the watch ran, the threshold held, no idea was emitted. Stamp the liveness without
    # polluting the recent-keys cache content. (Same fix as mesh-cooscillate, mesh-correlate,
    # mesh-leadlag — applied here for the same reason — 2026-06-28 audit of fire-on-event tools.)
    mesh-state-touch "$STATE"
    exit 0
  fi
fi

idea=""
case "$mode" in
  connect) idea="$(gen_connection)" || idea="$(gen_literature)" ;;
  lit)     idea="$(gen_literature)" || idea="$(gen_connection)" ;;
esac
[ -z "$idea" ] && { echo "$(ts) mesh-ideate: no fresh idea (inventory/recent exhausted)" >&2; mesh-state-touch "$STATE"; exit 1; }

if [ "$append" = 1 ]; then
  # Append under the shared queue lock — a bare >> can be lost if mesh-queue-tend's full-file
  # rewrite swaps the inode mid-append (same .ideas-queue.lock mesh-generate/queue-tend/correlate take).
  exec 9>"$MESH/.ideas-queue.lock" 2>/dev/null || true
  flock -w 30 9 2>/dev/null || true
  printf '[ ] %s\n' "$idea" >> "$Q"
  echo "$(ts) mesh-ideate: +1 ${mode} idea -> ideas-queue"
else
  printf '%s\n' "$idea"
fi
