#!/usr/bin/env bash
# mesh-tamper-attrib — CROSS-SENSE FUSION: mesh-tamper (phone SIGNIFICANT_MOTION disturbance) x
# mesh-presence (BLE personal-presence attribution) -> "was a physical disturbance ATTRIBUTABLE to
# a known/familiar person nearby, or UNATTRIBUTED?" Neither sense alone answers this: tamper says
# something moved but not WHO; presence says who's nearby but not WHETHER anything was disturbed.
# Fused: moved + FAMILIAR personal presence ACTIVE_NEAR/FAR reads as expected household activity;
# moved + EMPTY/APPLIANCE-only/STRANGER presence reads as an unattributed disturbance — the
# security-relevant signal neither sense produces solo.
#
#   mesh-tamper-attrib           cached-state fusion (fast, cron-friendly): reads mesh-tamper's +
#                                mesh-presence's persisted STATE files, no live watch/scan
#   mesh-tamper-attrib --status  alias for the default cached read (symmetry w/ sibling senses)
#   mesh-tamper-attrib --live    forces a REAL live read of both inputs (mesh-tamper watch ~8s +
#                                mesh-presence BLE scan ~5s) instead of trusting the cache
#   mesh-tamper-attrib --json    same read as default, one-line JSON record
#   mesh-tamper-attrib --test    classify-logic fixtures (offline, falsifiable) + a real cached-state
#                                read (exit reflects whatever the real inputs currently are — an
#                                unreachable/stale input is a PASS, never a forced green)
#
# Verdicts: ATTRIBUTED (moved, familiar person nearby — expected) · SUSPECT (moved, nobody familiar
# accounted for — empty/appliance-only/stranger nearby) · AMBIGUOUS (moved, presence inconclusive) ·
# NONE (tamper genuinely quiet — nothing to attribute) · UNKNOWN (tamper or presence input
# unreachable/stale/missing).
#
# Honest-degraded (no silent all-clear): UNKNOWN is a DISTINCT verdict from NONE. A consumer must
# never read "an input broke" as "nothing happened" — UNKNOWN carries the broken input's name in its
# reason so a fused-state reader can tell which side went dark.
#
# reflex-cadence: 4-59/10 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"
[ -f "$MESH/nodes" ] && . "$MESH/nodes"

TAMPER_STATE="$MESH/.tamper-state"        # verdict|epoch|window|recency|events_24h
PRESENCE_STATE="$MESH/.presence-state"    # space-separated key=val summary (see mesh-presence)
STATE="$MESH/.tamper-attrib-state"        # verdict|epoch|tamper_raw|presence_raw|familiarity
# The classify + state write run BEFORE the --test dispatch, so a smoke run stamps the live artifact
# at load — divert when this IS a test ($1) or a test's child (task test-live-writes 2026-07-20).
if [ "${1:-}" = --test ] || [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then STATE="${TMPDIR:-/tmp}/.tamper-attrib-state.sandbox.$$"; fi

TAMPER_STALE="${MESH_TAMPER_ATTRIB_TAMPER_STALE:-1800}"     # tamper has no fixed cadence (called
                                                             # live by many consumers) — generous window
PRESENCE_STALE="${MESH_TAMPER_ATTRIB_PRESENCE_STALE:-900}"  # presence cron is */10min

# ---- read cached tamper verdict: echoes moved|quiet|STALE|MISSING|UNREADABLE ----
read_tamper_cached() {
  [ -f "$TAMPER_STATE" ] || { echo "MISSING"; return; }
  local mtime age v
  mtime="$(stat -c %Y "$TAMPER_STATE" 2>/dev/null || echo 0)"
  [ "$mtime" -gt 0 ] || { echo "MISSING"; return; }
  age=$(( $(date +%s) - mtime ))
  [ "$age" -le "$TAMPER_STALE" ] || { echo "STALE"; return; }
  IFS='|' read -r v _ < "$TAMPER_STATE" 2>/dev/null
  case "$v" in
    moved|quiet) echo "$v" ;;
    OFFLINE|"") echo "UNREADABLE" ;;
    *) echo "UNREADABLE" ;;
  esac
}

# ---- read cached presence summary: echoes "<personal_presence>|<familiarity>" or a degraded token ----
read_presence_cached() {
  [ -f "$PRESENCE_STATE" ] || { echo "MISSING|MISSING"; return; }
  local mtime age line pp fam
  mtime="$(stat -c %Y "$PRESENCE_STATE" 2>/dev/null || echo 0)"
  [ "$mtime" -gt 0 ] || { echo "MISSING|MISSING"; return; }
  age=$(( $(date +%s) - mtime ))
  [ "$age" -le "$PRESENCE_STALE" ] || { echo "STALE|STALE"; return; }
  line="$(cat "$PRESENCE_STATE" 2>/dev/null)"
  [ -n "$line" ] || { echo "UNREADABLE|UNREADABLE"; return; }
  pp="$(printf '%s' "$line" | grep -oE 'personal_presence=[A-Za-z_]+' | cut -d= -f2)"
  fam="$(printf '%s' "$line" | grep -oE 'familiarity=[A-Za-z_]+' | cut -d= -f2)"
  echo "${pp:-UNREADABLE}|${fam:-UNREADABLE}"
}

# classify_tamper_attrib <tamper_raw> <personal_presence> <familiarity> -> "VERDICT|reason"
# Pure + offline-testable. tamper_raw must be moved|quiet or the fusion is UNKNOWN; personal_presence
# must be a real mesh-presence token (ACTIVE_NEAR/ACTIVE_FAR/ARRIVING/DEPARTING/INITIAL/AMBIGUOUS/
# APPLIANCE/EMPTY) or the fusion is UNKNOWN — either input degraded degrades the WHOLE verdict, never
# a half-fabricated read.
classify_tamper_attrib() {
  local traw="$1" pp="$2" fam="$3"
  case "$traw" in
    moved|quiet) : ;;
    *) echo "UNKNOWN|tamper input unreachable/stale/missing ($traw)"; return ;;
  esac
  case "$pp" in
    ACTIVE_NEAR|ACTIVE_FAR|ARRIVING|DEPARTING|INITIAL|AMBIGUOUS|APPLIANCE|EMPTY) : ;;
    *) echo "UNKNOWN|presence input unreachable/stale/missing ($pp)"; return ;;
  esac
  if [ "$traw" = "quiet" ]; then
    echo "NONE|tamper quiet — nothing to attribute"
    return
  fi
  case "$pp" in
    ACTIVE_NEAR|ACTIVE_FAR)
      case "$fam" in
        FAMILIAR) echo "ATTRIBUTED|moved + $pp + familiar presence nearby — likely household" ;;
        STRANGER) echo "SUSPECT|moved + $pp but STRANGER presence — unfamiliar, unaccounted" ;;
        *)        echo "AMBIGUOUS|moved + $pp + familiarity=$fam — inconclusive" ;;
      esac
      ;;
    EMPTY)     echo "SUSPECT|moved + EMPTY presence — nobody detected nearby, unattributed" ;;
    APPLIANCE) echo "SUSPECT|moved + only APPLIANCE presence nearby — no personal device accounted for" ;;
    *)         echo "AMBIGUOUS|moved + presence=$pp — transitional/inconclusive" ;;
  esac
}

emit_json() {
  local verdict="$1" reason="$2" traw="$3" pp="$4" fam="$5" mode="$6"
  python3 - "$verdict" "$reason" "$traw" "$pp" "$fam" "$mode" "$(hostname)" <<'PY'
import json, sys, subprocess
verdict, reason, traw, pp, fam, mode, host = sys.argv[1:8]
ts = subprocess.run(["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"], capture_output=True, text=True).stdout.strip()
none = lambda v: None if v in ("", "MISSING", "STALE", "UNREADABLE") else v
print(json.dumps({
    "verdict": verdict, "reason": reason, "mode": mode, "host": host, "ts": ts,
    "inputs": {"tamper": none(traw), "personal_presence": none(pp), "familiarity": none(fam)},
}, separators=(",", ":")))
PY
}

mode="cached"
out="${1:-}"
case "$out" in --live) mode="live";; esac

if [ "$mode" = "live" ]; then
  traw_line="$(timeout 15 mesh-tamper --window 8 2>/dev/null)"; trc=$?
  if [ "$trc" = 2 ] || [ -z "$traw_line" ]; then
    traw="unreachable"
  else
    case "$traw_line" in
      *body-moved*|*\[moved\]*) traw="moved" ;;
      *body-quiet*|*\[quiet\]*) traw="quiet" ;;
      *) traw="UNREADABLE" ;;
    esac
  fi
  pjson="$(timeout 15 mesh-presence --json 5 2>/dev/null)"
  if [ -n "$pjson" ]; then
    pstatus="$(printf '%s' "$pjson" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status",""))' 2>/dev/null)"
    if [ "$pstatus" = "ok" ]; then
      pp="$(printf '%s' "$pjson" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("personal_presence") or "")' 2>/dev/null)"
      fam="$(printf '%s' "$pjson" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("familiarity") or "")' 2>/dev/null)"
    else
      pp="unreachable"; fam="unreachable"
    fi
  else
    pp="unreachable"; fam="unreachable"
  fi
else
  traw="$(read_tamper_cached)"
  IFS='|' read -r pp fam < <(read_presence_cached)
fi

result="$(classify_tamper_attrib "$traw" "$pp" "$fam")"
verdict="${result%%|*}"
reason="${result#*|}"
NOW=$(date +%s)

printf '%s|%s|%s|%s|%s\n' "$verdict" "$NOW" "$traw" "$pp" "$fam" > "$STATE"
mesh-state-touch "$STATE"

if [ "$out" = "--test" ]; then
  fail=0
  # sandbox honesty (mechanism-assert, note3-ambient class): this run's pre-dispatch write must have
  # gone to the diverted path. Falsify: delete the diversion line at the STATE assignment.
  { [ "$STATE" != "$MESH/.tamper-attrib-state" ] && [ -e "$STATE" ]; } \
    || { echo "FAIL: state diversion inactive — this --test stamped the LIVE artifact ($STATE)"; fail=1; }
  rm -f "$STATE" 2>/dev/null
  assert() { [ "$1" = "$2" ] || { echo "FAIL: $3 (got '$1' want '$2')"; fail=1; }; }

  r="$(classify_tamper_attrib moved ACTIVE_NEAR FAMILIAR)";    assert "${r%%|*}" ATTRIBUTED "moved+near+familiar"
  r="$(classify_tamper_attrib moved ACTIVE_FAR FAMILIAR)";     assert "${r%%|*}" ATTRIBUTED "moved+far+familiar"
  r="$(classify_tamper_attrib moved ACTIVE_NEAR STRANGER)";    assert "${r%%|*}" SUSPECT "moved+near+stranger"
  r="$(classify_tamper_attrib moved EMPTY FAMILIAR)";          assert "${r%%|*}" SUSPECT "moved+empty"
  r="$(classify_tamper_attrib moved APPLIANCE FAMILIAR)";      assert "${r%%|*}" SUSPECT "moved+appliance-only"
  r="$(classify_tamper_attrib moved ARRIVING FAMILIAR)";       assert "${r%%|*}" AMBIGUOUS "moved+arriving"
  r="$(classify_tamper_attrib moved ACTIVE_NEAR MIXED)";       assert "${r%%|*}" AMBIGUOUS "moved+near+mixed-fam"
  r="$(classify_tamper_attrib quiet ACTIVE_NEAR FAMILIAR)";    assert "${r%%|*}" NONE "quiet+anything"
  r="$(classify_tamper_attrib quiet EMPTY INITIAL)";           assert "${r%%|*}" NONE "quiet+empty"
  r="$(classify_tamper_attrib unreachable ACTIVE_NEAR FAMILIAR)"; assert "${r%%|*}" UNKNOWN "tamper-unreachable"
  r="$(classify_tamper_attrib STALE ACTIVE_NEAR FAMILIAR)";    assert "${r%%|*}" UNKNOWN "tamper-stale"
  r="$(classify_tamper_attrib moved STALE FAMILIAR)";          assert "${r%%|*}" UNKNOWN "presence-stale"
  r="$(classify_tamper_attrib moved MISSING FAMILIAR)";        assert "${r%%|*}" UNKNOWN "presence-missing"
  r="$(classify_tamper_attrib moved garbage FAMILIAR)";        assert "${r%%|*}" UNKNOWN "presence-garbage-token"

  # UNKNOWN must never collide with NONE's reason text (the honest-degraded contract)
  r1="$(classify_tamper_attrib quiet EMPTY FAMILIAR)"
  r2="$(classify_tamper_attrib unreachable EMPTY FAMILIAR)"
  [ "${r1%%|*}" != "${r2%%|*}" ] || { echo "FAIL: NONE and UNKNOWN must be distinct verdicts"; fail=1; }

  echo "smoke-test: real cached read -> verdict=$verdict reason=\"$reason\" (tamper=$traw presence=$pp/$fam)"
  [ "$fail" = 0 ] && echo "smoke-test: ok (14 classify assertions + 1 distinctness check + real read)"
  exit "$fail"
fi

if [ "$out" = "--json" ]; then
  emit_json "$verdict" "$reason" "$traw" "$pp" "$fam" "$mode"
  exit 0
fi

echo "tamper-attrib: $verdict — $reason (mode=$mode, tamper=$traw, presence=$pp/$fam)"
exit 0
