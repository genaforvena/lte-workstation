#!/usr/bin/env bash
# mesh-sound-progress — ONE line of measured progress against the sound lane's DECLARED GOAL
# (mesh-handoff --goal sound): "делать звук, который оператор реально слушает, а не тот, который
# хорошо ранжируется" — sound he actually LISTENS to, not sound that RANKS well.
#
# orphan-ok: on-demand — invoked by the `progress:` line in charter/sound.md, read by
#   `mesh-handoff --goal sound` for the sound data pane. Not scheduled.
#
# IT DELIBERATELY REPORTS NO SCORE. The whole point of the goal is that ranking well is not the
# target, so a score here would restate the thing the goal warns against. What it can honestly
# measure is two counts plus one ABSENCE, and the absence is the load-bearing field:
#   · grind-delivered/24h — renders this lane actually shipped him. A SEND, not a listen.
#   · his gestures/24h    — drops he recorded. His action, the best engagement proxy we hold.
#   · LISTENED            — UNMEASURED, always, until a playback channel exists. TG tells us
#                           nothing about play. The only listening evidence ever observed is a
#                           render he sent BACK (n=1: yyCZ-18-lib-l1400-s1.25.mp3, delivered
#                           2026-07-25, returned 2026-08-16). Rendering that as 0, or quietly
#                           substituting the send count, is exactly the failure the goal names.
S="$HOME/.mesh/room-music-sent.log"; R="$HOME/.mesh/records.log"; I="$HOME/.mesh/tg-inbox"
cut=$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M 2>/dev/null) || cut="0000"
# the sent tape is NOT one-record-per-line (wrapped lines + embedded JSON): key on the VERB column,
# never on a line count — a naive `wc -l` over this window reads 1915 against a true 158.
d=$(awk -v c="$cut" '$1>=c && $2=="sent" && /\(grind-deliver\)/' "$S" 2>/dev/null | wc -l)
g=$(awk -v c="$cut" '$1>=c && $2=="drop"' "$R" 2>/dev/null | wc -l)
ret=0; last="never"
if [ -d "$I" ]; then
  for f in "$I"/*; do [ -e "$f" ] || continue
    b="${f##*/}"; b="${b#*-}"
    grep -qF -- "$b" "$S" 2>/dev/null && { ret=$((ret+1)); last=$(date -u -r "$f" +%Y-%m-%d 2>/dev/null); }
  done
fi
# LISTENED LEADS. The dash clips this to one pane-width row (mesh-dash: "ONE ROW, CLIPPED"), so
# whatever sits at the tail is invisible to the reader who only ever sees the pane. The goal's own
# axis is listening, so the field that says it is UNMEASURED must survive the clip — the counts,
# which are the lesser claim, are what may fall off the end.
printf 'LISTENED: UNMEASURED (no playback channel; only ever 1 render sent BACK, %s) · grind-delivered/24h %s · his gestures/24h %s\n' \
  "$last" "$d" "$g"
