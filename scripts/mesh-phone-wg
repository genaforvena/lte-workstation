#!/usr/bin/env bash
# mesh-phone-wg — WireGuard diagnostic tool for the phone body (Android WireGuard app)
# Checks whether WG is actually routing the phone's traffic through the expected exit IP.
# The Android WG app creates a VPN userspace tunnel — `wg` CLI may be unavailable from Termux,
# so the authoritative test is: get the phone's external IP → does it match the WG exit?
#   PASS    phone's ext IP == expected WG exit IP → tunnel routing correctly
#   FAIL    phone reachable but ext IP != WG exit → tunnel down / routing wrong
#   DEGRADED phone ext IP = LAN IP (on WiFi + tunnel down → blocked by always-on VPN)
#   UNREACHABLE phone offline
# Usage: mesh-phone-wg [--json] [--exit-ip <IP>]
#   --exit-ip <IP>  Override the expected WG exit IP (default: ${MESH_WG_EXIT_IP:-router LAN VPN NL 194.147.115.17})
#   --json          Machine-readable JSON output
# --test: smoke-test deps (mesh-phone-ip, curl)
# reflex-cadence: off
# RETIRED as an autowired reflex 2026-06-19: the phone's single Android VPN slot belongs to the
# operator's onVao censorship-bypass (trojan :8443). The mesh must NOT contend for that slot — our
# WireGuard-on-phone initiative displaced his working VPN overnight (Android = one VpnService).
# This tool stays as an on-demand READ-ONLY diagnostic; it must never be cron-wired. See memory
# never-touch-working-vpn / phone-wg-channel-replace-tailscale.

MESH_WG_EXIT_IP="${MESH_WG_EXIT_IP:-194.147.115.17}"
MESH_PHONE_SSH_PORT="${MESH_PHONE_SSH_PORT:-8022}"
MESH_PHONE_USER="${MESH_PHONE_USER:-u0_a386}"

TESTS_PASSED=0
TESTS_FAILED=0

test_ok()  { echo "  ok: $1"; TESTS_PASSED=$((TESTS_PASSED+1)); }
test_fail(){ echo "  FAIL: $1"; TESTS_FAILED=$((TESTS_FAILED+1)); }

json_escape() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null || printf '"%s"' "$1"; }

do_test() {
  command -v mesh-phone-ip >/dev/null 2>&1 && test_ok "mesh-phone-ip present" || test_fail "mesh-phone-ip not found"
  command -v curl >/dev/null 2>&1 && test_ok "curl present" || test_fail "curl not found"
  command -v timeout >/dev/null 2>&1 && test_ok "timeout present" || test_fail "timeout not found"
  if [ $TESTS_FAILED -gt 0 ]; then echo "smoke-test: FAIL"; exit 1; fi
  echo "smoke-test: ok"
  exit 0
}

JSON_MODE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON_MODE=1; shift;;
    --exit-ip) MESH_WG_EXIT_IP="$2"; shift 2;;
    --test) do_test;;
    *) echo "usage: $0 [--json] [--exit-ip <IP>] [--test]"; exit 1;;
  esac
done

# 1. Resolve phone
PHONE_IP=$(mesh-phone-ip 2>/dev/null || true)
SSH_TARGET="ssh -p ${MESH_PHONE_SSH_PORT} -o StrictHostKeyChecking=no -o ConnectTimeout=5 ${MESH_PHONE_USER}@127.0.0.1"

if [ -z "$PHONE_IP" ] || [ "$PHONE_IP" = "phone unreachable" ]; then
  if [ "$JSON_MODE" = 1 ]; then
    echo '{"status":"UNREACHABLE","phone_reachable":false,"msg":"phone unreachable — ADB tunnel down or sshd not listening"}'
  else
    echo "mesh-phone-wg :: UNREACHABLE — phone not reachable via ADB tunnel"
  fi
  exit 2
fi

# 2. Get phone's external IP
PHONE_EXT_IP=""
PHONE_EXT_IP=$(${SSH_TARGET} "timeout 10 curl -s ifconfig.me 2>/dev/null" 2>/dev/null || true)
CURL_RC=$?

# 3. Check what interfaces the phone sees
PHONE_IFACES=$(${SSH_TARGET} "ip link show 2>/dev/null | grep -o '^[0-9]*: [^:]*'" 2>/dev/null || true)

# 4. Check if the WG server is reachable
WG_SERVER_REACHABLE=0
WG_SERVER_IP=$(printf '%s' "$MESH_WG_EXIT_IP" | cut -d. -f1-3).1  # crude guess: server is .1 of the exit network
PING_RESULT=$(${SSH_TARGET} "timeout 5 ping -c 1 -W 3 ${WG_SERVER_IP} 2>/dev/null" 2>/dev/null || true)
if printf '%s' "$PING_RESULT" | grep -q '1 received'; then WG_SERVER_REACHABLE=1; fi

# 5. Check routing
PHONE_DEFAULT_ROUTE=$(${SSH_TARGET} "ip route show default 2>/dev/null | head -1" 2>/dev/null || true)

# 6. Determine WG status
if [ "$CURL_RC" = 0 ] && [ -n "$PHONE_EXT_IP" ]; then
  if [ "$PHONE_EXT_IP" = "$MESH_WG_EXIT_IP" ]; then
    STATUS="PASS"
    MSG="phone ext IP ${PHONE_EXT_IP} matches expected WG exit IP — tunnel routing correctly"
  else
    STATUS="FAIL"
    MSG="phone ext IP ${PHONE_EXT_IP} != expected WG exit ${MESH_WG_EXIT_IP} — tunnel not routing this traffic"
  fi
elif [ "$CURL_RC" != 0 ]; then
  # curl failed — might be always-on VPN blocking without tunnel
  STATUS="DEGRADED"
  MSG="phone reachable but curl ifconfig.me failed (exit ${CURL_RC}) — likely WG always-on VPN blocking untunneled traffic without tunnel established"
else
  STATUS="UNKNOWN"
  MSG="phone reachable but cannot determine external IP"
fi

# 7. Output
if [ "$JSON_MODE" = 1 ]; then
cat <<JSONEOF
{
  "status":"${STATUS}",
  "phone_reachable":true,
  "external_ip":$(json_escape "$PHONE_EXT_IP"),
  "expected_exit_ip":"${MESH_WG_EXIT_IP}",
  "wg_server_reachable":${WG_SERVER_REACHABLE},
  "default_route":$(json_escape "$PHONE_DEFAULT_ROUTE"),
  "interfaces":$(json_escape "$(printf '%s\n' "$PHONE_IFACES" | tr '\n' ' ')"),
  "msg":$(json_escape "$MSG")
}
JSONEOF
else
  echo "mesh-phone-wg :: ${STATUS}"
  echo "  phone ext IP:   ${PHONE_EXT_IP:-UNKNOWN}"
  echo "  expected WG:    ${MESH_WG_EXIT_IP}"
  [ -n "$PHONE_IFACES" ] && echo "  interfaces:     $(printf '%s\n' "$PHONE_IFACES" | tr '\n' ' ')"
  [ -n "$PHONE_DEFAULT_ROUTE" ] && echo "  default route:  ${PHONE_DEFAULT_ROUTE}"
  echo "  WG server ${WG_SERVER_IP}: $([ ${WG_SERVER_REACHABLE} = 1 ] && echo 'reachable' || echo 'unreachable')"
  echo "  ${MSG}"
fi

case "$STATUS" in
  PASS)    exit 0;;
  DEGRADED|FAIL) exit 1;;
  UNKNOWN) exit 2;;
  *)       exit 2;;
esac
