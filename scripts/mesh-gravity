#!/usr/bin/env bash
# orphan-ok: on-demand gravity vector sense — phone orientation relative to Earth gravity
# mesh-gravity — reads the phone's GRAVITY sensor (3-axis gravity vector from Android's low-pass
# filtered accelerometer fusion) via termux-sensor over SSH.
#
# Classification (gravity dominant axis):
#   FLAT    — gravity on Z (phone flat on surface, screen up/down)
#   UPRIGHT — gravity on Y (phone held vertically in portrait)
#   SIDEWAYS— gravity on X (phone on side / landscape)
#   TILTED  — no axis dominates (angled / in pocket)
#   UNKNOWN — no sensor reading / value outside expected range
#
# Uses mesh-state-touch on EVERY successful run so a long-stable orientation
# (e.g. phone flat on table for hours) does not decay to FALSE STALE —
# mtime = ran-live, content = value-changed.
#
# Exit codes:
#   0 = artifact produced
#   2 = phone unreachable or sensor absent — never fakes a reading
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.gravity-state"
OFFLINEFILE="$HOME/.mesh/.mesh-gravity-offline"

# read_gravity <ip> → echoes "x y z" or returns 1
read_gravity() {
  local _ip="$1" _out _x _y _z
  for _try in 1 2; do
    _out="$(timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ServerAliveInterval=3 -o ConnectTimeout=5 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_ip" \
      "termux-sensor -s GRAVITY -n 1 2>/dev/null" </dev/null 2>/dev/null)" || continue
    [ -n "$_out" ] || continue
    _x="$(printf '%s' "$_out" | python3 -c '
import json, sys
try:
    d, _ = json.JSONDecoder().raw_decode(sys.stdin.read().strip())
    v = d.get("GRAVITY", {}).get("values", [])
    if len(v) >= 3:
        print(v[0], v[1], v[2])
except Exception:
    pass
' 2>/dev/null)"
    [ -n "$_x" ] && { printf '%s' "$_x"; return 0; }
  done
  return 1
}

# classify_g x y z → label
# Uses python3 for float-safe comparison (bash cannot compare floats).
classify_g() {
  local x="${1:-0}" y="${2:-0}" z="${3:-0}" label
  label="$(python3 -c "
x, y, z = $x, $y, $z
mag = (x**2 + y**2 + z**2)**0.5
if mag < 5 or mag > 12:
    print('UNKNOWN')
    exit(0)
ax, ay, az = abs(x), abs(y), abs(z)
# Determine if one axis clearly dominates (>2x the next axis and > 7 magnitude)
ax2 = ax * 2; ay2 = ay * 2; az2 = az * 2
if az >= 7 and az2 >= ay and az2 >= ax:
    print('FLAT' if z > 0 else 'FLAT_REVERSE')
elif ay >= 7 and ay2 >= ax and ay2 >= az:
    print('UPRIGHT' if y > 0 else 'UPRIGHT_REVERSE')
elif ax >= 7 and ax2 >= ay and ax2 >= az:
    print('SIDEWAYS_RIGHT' if x < 0 else 'SIDEWAYS_LEFT')
else:
    print('TILTED')
" 2>/dev/null)" || echo "UNKNOWN"
  printf '%s' "$label"
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  command -v mesh-state-touch >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-state-touch)"; exit 1; }
  fail=0

  # classify-g
  r="$(classify_g 0 0 9.8)";   [ "$r" = "FLAT" ] || { echo "  FAIL: 0,0,9.8 → FLAT got=$r"; fail=1; }
  r="$(classify_g 0 0 -9.8)";  [ "$r" = "FLAT_REVERSE" ] || { echo "  FAIL: 0,0,-9.8 → FLAT_REVERSE got=$r"; fail=1; }
  r="$(classify_g 0 9.8 0)";   [ "$r" = "UPRIGHT" ] || { echo "  FAIL: 0,9.8,0 → UPRIGHT got=$r"; fail=1; }
  r="$(classify_g -9.8 0 0)";  [ "$r" = "SIDEWAYS_RIGHT" ] || { echo "  FAIL: -9.8,0,0 → SIDEWAYS_RIGHT got=$r"; fail=1; }
  r="$(classify_g 5 5 5)";     [ "$r" = "TILTED" ] || { echo "  FAIL: 5,5,5 → TILTED got=$r"; fail=1; }
  r="$(classify_g 0 0 0)";     [ "$r" = "UNKNOWN" ] || { echo "  FAIL: 0,0,0 → UNKNOWN got=$r"; fail=1; }
  r="$(classify_g 0 0 50)";    [ "$r" = "UNKNOWN" ] || { echo "  FAIL: 0,0,50 → UNKNOWN got=$r"; fail=1; }
  echo "  ok: classify_g (7 assertions)"

  # REAL-READ assertion: reachability ≠ producing — actual sensor read must yield a 3-axis value
  pip="$(timeout 10 mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable); classify-logic ok"; exit 2; }
  raw="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ServerAliveInterval=3 -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
    "termux-sensor -s GRAVITY -n 1 2>/dev/null" </dev/null 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — no GRAVITY read); classify-logic ok"; exit 2; }
  [ -n "$raw" ] || { echo "smoke-test: n/a (empty GRAVITY read); classify-logic ok"; exit 2; }
  v="$(printf '%s' "$raw" | python3 -c '
import json, sys
try:
    d, _ = json.JSONDecoder().raw_decode(sys.stdin.read().strip())
    v = d.get("GRAVITY", {}).get("values", [])
    if len(v) >= 3: print("%.4f %.4f %.4f" % (v[0], v[1], v[2]))
except Exception: pass
' 2>/dev/null)"
  [ -n "$v" ] || { echo "smoke-test: n/a (GRAVITY did not yield 3-axis reading); classify-logic ok"; exit 2; }

  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (classify + REAL GRAVITY read: $v)"
  exit 0
fi

# --- Phone reachability gate ---
pip="$(timeout 10 mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read gravity (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}
rm -f "$OFFLINEFILE"

# --- Read gravity ---
grav="$(read_gravity "$pip")"
[ -n "$grav" ] || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "gravity read failed — sensor absent or not producing (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
x="$(printf '%s' "$grav" | awk '{print $1}')"
y="$(printf '%s' "$grav" | awk '{print $2}')"
z="$(printf '%s' "$grav" | awk '{print $3}')"
label="$(classify_g "$x" "$y" "$z")"

# --- Write state + touch liveness ---
printf '%s x=%.3f y=%.3f z=%.3f %s\n' "$label" "$x" "$y" "$z" "$TS" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","x":%.6f,"y":%.6f,"z":%.6f,"grav_mag":%.4f,"ts":"%s"}\n' \
    "$label" "$x" "$y" "$z" "$(python3 -c "print(($x**2+$y**2+$z**2)**0.5)" 2>/dev/null)" "$TS"
  exit 0
fi

if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
  [ "$prev" != "$label" ] || exit 0
  printf '[grav-%s] %s — gravity (%.2f, %.2f, %.2f)\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$x" "$y" "$z"
  exit 0
fi

printf '[grav-%s] %s — gravity (%.2f, %.2f, %.2f) | mag=%.2f\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$x" "$y" "$z" \
  "$(python3 -c "print(($x**2+$y**2+$z**2)**0.5)" 2>/dev/null)"

