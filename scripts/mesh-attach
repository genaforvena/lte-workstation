#!/usr/bin/env bash
# mesh-attach [node] — mesh-wide tmux: ONE fabric over the per-node hostname-named sessions.
# Each node runs a tmux session named $(hostname) (mesh doctrine, docs/mesh-skeleton.md); the sessions
# are already cross-node attachable over SSH — this makes that a single command instead of per-node lore.
#
#   mesh-attach            list EVERY mesh node + its session state (windows / attached / missing)
#   mesh-attach <node>     ssh -t to <node> and attach-or-create its hostname session (you're now in it)
#   mesh-attach --test     smoke test
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
NODES="${MESH_NODES:-}"

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v ssh  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  [ -n "$NODES" ] || { echo "smoke-test: FAIL (no MESH_NODES in ~/.mesh/nodes)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

# MESH_NODES = "name:user@addr name2:local ..." — resolve a name to its target.
resolve() {
  for pair in $NODES; do [ "${pair%%:*}" = "$1" ] && { printf '%s' "${pair#*:}"; return 0; }; done
  return 1
}
sshport() { case "$1" in Redmi|phone) printf '%s' "-p ${PHONE_SSH_PORT:-8022}" ;; *) printf '' ;; esac; }

SELF_IP="$(tailscale ip -4 2>/dev/null | head -1)"
is_self() { # addr (user@host or host) -> true if it resolves to this node
  local h="${1##*@}"   # strip user@ if present
  case "$h" in
    localhost|127.*) return 0 ;;
    "$SELF_IP")      return 0 ;;
    "$(hostname)")   return 0 ;;
  esac
  return 1
}
session_info() { # target -> one-line session status (windows / attached / none / unreachable)
  local fmt='#{session_name}: #{session_windows} windows#{?session_attached, (attached),}'
  if [ "$1" = local ] || is_self "$1"; then
    tmux list-sessions -F "$fmt" 2>/dev/null | head -1 || echo "(no session)"
  else
    timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=8 ${2:-} "$1" \
      "tmux list-sessions -F '$fmt' 2>/dev/null | head -1 || echo '(no session)'" 2>/dev/null || echo "(unreachable)"
  fi
}

# no arg → list the whole mesh's sessions
if [ -z "${1:-}" ]; then
  [ -n "$NODES" ] || { echo "mesh-attach: no MESH_NODES in ~/.mesh/nodes" >&2; exit 1; }
  echo "=== mesh-wide tmux sessions ==="
  for pair in $NODES; do
    name="${pair%%:*}"; addr="${pair#*:}"
    printf '  %-18s %s\n' "$name" "$(session_info "$addr" "$(sshport "$name")")"
  done
  echo "attach any:  mesh-attach <node>"
  exit 0
fi

# arg → attach that node's session (the mesh-wide jump)
addr="$(resolve "$1")" || { echo "mesh-attach: unknown node '$1' (known: $(echo "$NODES" | tr ' ' '\n' | cut -d: -f1 | tr '\n' ' '))" >&2; exit 1; }
if [ "$addr" = local ] || is_self "$addr"; then
  exec tmux new-session -A -s "$(hostname)"
else
  exec ssh $(sshport "$1") -t "$addr" 'tmux new-session -A -s "$(hostname)"'
fi
