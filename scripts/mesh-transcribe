#!/usr/bin/env bash
# mesh-transcribe — continuously transcribe EVERYTHING the mic hears into a running transcript.
# No wake word, no loud-gate — the full stream, for interest. Consent-gated (mic). Uses a reliable
# fixed-duration capture (arecord -d) — unlike the wake-word ear, which can hang on an open recorder.
#   mesh-transcribe         loop: record chunk -> whisper -> append ~/.mesh/transcript.log
#   mesh-transcribe --tail  live-tail the transcript
#   mesh-transcribe --once  one chunk -> stdout (for verification)
#   mesh-transcribe --test  smoke test (whisper + model + consent + audio tools)
set -uo pipefail
MESH="$HOME/.mesh"; LOG="$MESH/transcript.log"; CONSENT="$MESH/consent"
WHISP="$MESH/whispercpp/main"; MODEL="${TR_MODEL:-$MESH/whispercpp/models/ggml-base.bin}"
CHUNK="${TR_CHUNK:-6}"; mkdir -p "$MESH"; touch "$LOG"
consent(){ grep -qiE '^[[:space:]]*mic[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" 2>/dev/null; }
grab(){ # record CHUNK seconds -> $1 (arecord fixed-duration; fall back to pw-record)
  timeout $((CHUNK+3)) arecord -q -f S16_LE -r 16000 -c1 -d "$CHUNK" "$1" 2>/dev/null \
    || timeout $((CHUNK+3)) pw-record --rate 16000 --channels 1 --target 0 "$1" 2>/dev/null || true
}
hear(){ "$WHISP" -m "$MODEL" -f "$1" -nt -l auto -t 4 2>/dev/null | tr '\n' ' ' | python3 -c '
import sys,re
t=sys.stdin.read()
t=re.sub(r"\[[^\]]*\]","",t); t=re.sub(r"\([^)]*\)","",t); t=re.sub(r"\*[^*]*\*","",t)
t=" ".join(t.split()).strip()
low=t.lower()
H=("ご視聴","thanks for watching","subscribe","продолжение следует","субтитры","amara.org","редактор субтитров")
bad = (not re.search(r"[0-9A-Za-zА-Яа-яЁё]{2,}",t)) or any(h in low for h in H)
w=t.split()
if w and len(set(x.lower() for x in w))==1 and len(w)>=2: bad=True
if len(t.replace(" ",""))>=6 and len(set(low.replace(" ","")))<=4: bad=True
print("" if bad else t)
'; }
case "${1:-}" in
  --tail) tail -n 30 -f "$LOG" ;;
  --test)
    [ -x "$WHISP" ] || { echo "smoke-test: FAIL (whisper not executable at $WHISP)"; exit 1; }
    [ -f "$MODEL" ] || { echo "smoke-test: FAIL (model not found at $MODEL)"; exit 1; }
    consent || { echo "smoke-test: WARN (no mic consent — see ~/.mesh/consent)"; }
    command -v arecord >/dev/null 2>&1 || command -v pw-record >/dev/null 2>&1 || { echo "smoke-test: FAIL (no audio tool: arecord/pw-record)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;
  --once)
    consent || { echo "no mic consent"; exit 3; }
    t=$(mktemp --suffix=.wav); grab "$t"; echo "wav=$(stat -c%s "$t" 2>/dev/null)b"; echo "heard: $(hear "$t")"; rm -f "$t" ;;
  ""|--run)
    consent || { echo "mesh-transcribe: no mic consent (~/.mesh/consent: mic = yes)"; exit 3; }
    [ -x "$WHISP" ] || { echo "whisper not found at $WHISP"; exit 1; }
    echo "[mesh-transcribe] full transcript -> $LOG (everything, no gate)"
    while true; do
      t=$(mktemp --suffix=.wav); grab "$t"
      txt="$(hear "$t")"; rm -f "$t"
      [ -n "$txt" ] && printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$txt" >> "$LOG"
    done ;;
  *) echo "usage: mesh-transcribe [--run|--tail|--once|--test]" >&2; exit 1 ;;
esac
