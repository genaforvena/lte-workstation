#!/usr/bin/env bash
# mesh-reflect — the TELOS REFLEX: periodically think the goal through, as a reflex, not a one-off.
# Assembles the organism's current state (learnings, chaos proofs/gaps, channel activity, roadmap) into
# a reflection BRIEF, then records a reflection to ~/.mesh/telos.log (durable + gossiped): what did I
# learn, where am I vs the goal (autopoiesis / the eternity audit), what should I become next, any drift
# from the boundaries (owned/consented/no-metastasis). The $0 brief runs autonomously; the deep
# reflection is written by whatever mind is awake — or by a claude -p reflex once autonomy is flipped
# (MESH_REFLECT_AUTO=1). See docs/telos.md, docs/eternity-and-its-fields.md.
#
#   mesh-reflect --brief   assemble + print the brief ($0, no mind)
#   mesh-reflect           reflect (autonomous if MESH_REFLECT_AUTO=1 + claude; else stamp brief for a mind)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; TELOS="$MESH/telos.log"; mkdir -p "$MESH"
brief(){
  echo "=== organism reflection brief $(date -u +%FT%TZ) on $(hostname) ==="
  echo "-- recent learnings --"; tail -n 5 "$MESH/learnings.log" 2>/dev/null
  echo "-- chaos (resilience proofs/gaps) --"; tail -n 5 "$MESH/chaos.log" 2>/dev/null
  echo "-- channel activity --"; for f in "$MESH"/channels/*.inbox; do [ -f "$f" ] && echo "  $(basename "$f"): $(wc -l < "$f" 2>/dev/null) msgs"; done
  echo "-- roadmap (top) --"; grep -E '^[0-9]+\.|^- \*\*|^## ' "$MESH/roadmap.md" 2>/dev/null | head -10
  echo "-- the goal --"; echo "  self-resilient autonomous autopoiesis, BOUNDED/owned/consented (docs/telos.md)"
}
[ "${1:-}" = --test ] && {
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/channels"
  echo "2026-06-12 test learning" > "$tmp/learnings.log"
  echo "2026-06-12 test chaos" > "$tmp/chaos.log"
  echo "test message" > "$tmp/channels/mainframe.inbox"
  echo "1. test roadmap item" > "$tmp/roadmap.md"
  out="$(MESH="$tmp" brief 2>&1)" || { echo "smoke-test: FAIL (brief failed: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'organism reflection brief' || { echo "smoke-test: FAIL (brief missing header)"; exit 1; }
  printf '%s' "$out" | grep -q 'test learning' || { echo "smoke-test: FAIL (brief missing learnings)"; exit 1; }
  echo "test reflection" >> "$tmp/telos.log" 2>/dev/null || { echo "smoke-test: FAIL (telos.log not writable)"; exit 1; }
  [ -s "$tmp/telos.log" ] || { echo "smoke-test: FAIL (telos.log empty after write)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
}
[ "${1:-}" = --brief ] && { brief; exit 0; }
rc=0
if [ "${MESH_REFLECT_AUTO:-0}" = 1 ] && command -v claude >/dev/null 2>&1; then
  PROMPT="You are the organism reflecting on its own becoming (telos reflex). From the brief below write
ONE short HONEST reflection (6-10 lines): what did the organism learn; where is it vs the goal
(autopoiesis / the gaps in docs/eternity-and-its-fields.md); the single most valuable next step; any
drift from the boundaries (owned/consented, no metastasis). No fluff, real assessment.
BRIEF:
$(brief)"
  out=$(timeout 300 claude -p "$PROMPT" --dangerously-skip-permissions 2>/dev/null || true) || rc=$?
  if [ -n "$out" ]; then
    printf '\n=== %s reflection (%s) ===\n%s\n' "$(date -u +%FT%TZ)" "$(hostname)" "$out" >> "$TELOS"
    echo "reflection appended to telos.log"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflect@$(hostname)" mesh-chat "[reflect] daily reflection written to telos.log" >/dev/null 2>&1
  else
    echo "reflection produced nothing (rc=$rc)"
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflect@$(hostname)" mesh-chat "[reflect] WARN: daily reflection failed (rc=$rc)" >/dev/null 2>&1
  fi
else
  { echo; echo "=== $(date -u +%FT%TZ) brief (awaiting a mind to reflect) ==="; brief; } >> "$TELOS"
  echo "brief stamped to telos.log (enable MESH_REFLECT_AUTO=1 + autonomy for self-reflection)"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflect@$(hostname)" mesh-chat "[reflect] brief stamped to telos.log" >/dev/null 2>&1
fi
