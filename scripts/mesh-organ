#!/usr/bin/env bash
# mesh-organ — the CAPABILITY ROUTER: run an organ by NAME, wherever it physically lives.
# Operator 2026-06-13: "it shouldn't matter WHERE the organs are." From any node,
# `mesh-organ camera` finds a node that HAS a camera, runs it there, returns the artifact.
# Layer B of knowledge/location-transparency-design-2026-06-13.md. Purely additive: read-only
# resolution (mesh-organs --json) + SSH execution; no node-local hardware assumptions.
#
#   mesh-organ --list                 the fleet capability map (which node offers what)
#   mesh-organ --manifest             read-only capability manifest (name -> tool -> host)
#   mesh-organ <name>@<node> [args]   run capability <name> on a SPECIFIC node (place-bound default)
#   mesh-organ <name> [args...]       run <name>: 1 offerer → there; many → fungible routes/failover,
#                                     place-bound refuses & asks for <name>@<node> (the 3-voices case)
#   mesh-organ --node <label> <name>  force a specific host (alias of <name>@<label>)
#   mesh-organ --where <name>         just print which node(s) offer <name>, don't run
#   mesh-organ --scope <name>[@node]  read-only: print a cap's WHERE-scope + WHO cap-allow list
#   mesh-organ --why <name>           read-only: the PARADIGM OF CHOICE — every offerer, every
#                                     constraint's verdict on it, the decisive one, and the
#                                     alternatives it ruled out (never executes the cap)
#   mesh-organ --as <role> <name>     name the calling agent-context for the cap-allow gate
#   mesh-organ --qualify [<cap>] [--json]
#                                     read-only: THE RESIDUAL of the declared constraint framework.
#                                     Of the routes where(cap-scope)+who(cap-allow)+reach all
#                                     APPROVED, how many did the world refuse anyway — and does that
#                                     residual concentrate on ONE offerer the framework calls
#                                     interchangeable? That concentration is a candidate UNSTATED
#                                     PRECONDITION (McCarthy's qualification problem). Never executes
#                                     a cap. Reads ~/.mesh/organ-routes.log; exit 2 when unmeasured.
#   mesh-organ --test
#
# CAPABILITY SCOPING (study 'capability security', clayseal.com): a cap may declare an authorization
# allow-list `# cap-allow: <role>...` (roles = channels: genome/tg/senses/…); the router DENIES (exit 3)
# an unlisted caller before any exec. Caller id = $MESH_CALLER > --as > tmux window > unknown. No
# cap-allow header ⇒ unrestricted (additive). Where a scope IS declared, it is deny-by-default.
#
# A capability = an executable in ~/.mesh/caps/ whose FILENAME is its name (self-describing; the
# name IS the command, secrets stay inside it). Legacy senses/actuators (mesh-<tool>) still route.
# Honest-fusion: distinguishes no-such-organ / all-offering-nodes-offline / ran-here-is-the-artifact.
#
# THE PARADIGM OF CHOICE (--why). Live-literature landing, biosemiotics/translation semiotics:
# Rędzioch-Korkuz, A. 2025, "(Re)conceptualizing translation as a dynamic dialogue of constraints",
# *Sign Systems Studies* 53(3/4): 333-356, https://doi.org/10.12697/SSS.2025.53.3-4.03 (open
# access). Routing a capability IS a translation event in that paper's sense: a request crosses a
# semiotic border (name -> instance, here -> there) and what survives the crossing is decided by
# several constraints acting AT ONCE. Two of its claims are load-bearing here and neither was
# embodied:
#
#   1. "Irrespective of their actual potency, ALL the constraints operate in each translation
#      event... if we want to understand a particular translation event, we should most likely
#      attempt at reconstructing the WHOLE framework of constraints, rather than focus on a
#      detailed analysis of single aspects." This router already declares two constraint TYPES
#      (where = cap-scope, who = cap-allow) and adds a third implicitly (reach = an address in
#      ~/.mesh/nodes). It consulted them one at a time and reported none of them.
#   2. Constraints are "both what is given and what could have been given" (the ABSENTIAL, Marais
#      2023 via Deacon 2011) — they "define the paradigm of choice... thus reducing the number of
#      possibilities" (Levý). So the meaning of a routing decision is not the node it picked; it
#      is the node it picked TOGETHER WITH the ones it ruled out and the constraint that ruled
#      them out. `[mesh-organ] say -> mesh-home` publishes the choice and destroys the paradigm.
#
# The mesh already knows the near-miss of this (doctrine: "fold with a max that NAMES its
# winner") — naming the winner. This is the other half: name the LOSERS and what eliminated them.
# --why is READ-ONLY and never executes the cap; the route path prints the same paradigm from
# data it has already computed, so it costs no extra ssh.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# Self-describing capability (operator design 2026-06-21): a capability is an EXECUTABLE whose
# FILENAME is its name, in ~/.mesh/caps/. No name->command table — the name IS the command. The
# secrets/env live INSIDE the file, on the node; the router runs it by its path (no special
# provider verb). The file declares its own nature via a `# cap-scope: fungible|bound` header
# (read back via `<cap> --scope`; default = bound). Place-bound is the default because senses +
# actuators are a point in space; fungibility is only for PLACELESS caps (pure compute, egress,
# bridge-to-a-single-external-sink) where the effect doesn't depend on WHICH node runs it.
CAP_DIR="${MESH_CAP_DIR:-$HOME/.mesh/caps}"

# ─────────────────────────────────────────────────────────────────────────────
# THE OUTCOME TAPE — McCarthy's QUALIFICATION PROBLEM, made measurable.
#
# Live-literature landing, relevance realization & the frame problem (Vervaeke), cross-domain
# transfer. The frame problem has two halves. We already embody the RAMIFICATION half
# (docs/reviews/rr-frame-problem-ramification-change-anchored-supersession-doctor-2026-08-17.md:
# you cannot enumerate an action's EFFECTS). This is the other half, and nothing in the genome
# had touched it: McCarthy's QUALIFICATION problem — you cannot axiomatize an action's
# PRECONDITIONS. Jaeger, Riedl, Djedovic, Vervaeke & Walsh (Front. Psychol. 2024,
# doi:10.3389/fpsyg.2024.1362658) put the RR reading of it plainly: an algorithm "exists in a
# small world by definition, since it is embedded within a predefined formalized ontology", and
# large-world features "cannot be prestated explicitly in the form of a mathematical set". The
# operational answer the robotics literature gives is not to enumerate harder but to LEARN the
# precondition from EXECUTION OUTCOMES — ConditionNET (arXiv:2502.01167, 2025) learns preconditions
# AND effects as an execution monitor; LASP (arXiv:2407.09792) diagnoses a failed execution and
# incrementally ADDS the precondition it did not have.
#
# This router is a small world by construction. It declares exactly three constraint types —
# where(cap-scope), who(cap-allow), reach(address) — and `--why` reconstructs all three. What it
# cannot represent is the constraint it does not know it has: the wedged dongle, the missing
# `video` group, the driver that returns empty, the daemon that died. Those are unenumerable, and
# the router's own tie-break admits the consequence: among fungible offerers FIRST-OFFERED wins,
# with no retry, forever, no matter how many times that offerer has failed at exec.
#
# It could not learn them even in principle, because IT HANDED OFF AND FORGOT: both terminal paths
# were `exec` (local) or a last-command `ssh` (remote), so no line of this script ran after the
# capability did, and no outcome was ever observable to it. A router with no outcome memory cannot
# have a discovered-precondition lane; the tape below is what makes one possible, and `--qualify`
# is the lens that reads it. The tape is APPEND-ONLY, BEST-EFFORT, and can never change a routing
# decision: every write is `|| true`, and a tape that cannot be written is a silent no-op.
#
# THE ONE SEMANTIC CHANGE, stated plainly rather than slipped in: recording an outcome requires
# OUTLIVING the capability, so the local `exec` becomes run-then-record-then-exit. The child's exit
# code is propagated byte for byte and stdin/stdout/stderr still pass straight through, but a bash
# parent now stays resident for the capability's lifetime, and a SIGTERM aimed at the ROUTER pid no
# longer lands on the capability ([[killing-a-wrapper-does-not-reap-a-sudo-child]]). A caller that
# needs the old process semantics sets MESH_ORGAN_NO_RECORD=1, which restores `exec` exactly and
# writes nothing.
ROUTE_LOG="${MESH_ORGAN_ROUTE_LOG:-$HOME/.mesh/organ-routes.log}"
RECORD_ROUTES=1; [ "${MESH_ORGAN_NO_RECORD:-0}" = 1 ] && RECORD_ROUTES=0

# One route, one line. Tab-free by construction (every field is a bare token) so a reader can split
# on spaces; the fields are key=value so a later field can be added without shifting the old ones
# ([[a-leading-empty-field-shifts-under-tab-read]]).
#   cap=<name> node=<short> caller=<role> route=<local|remote> offerers=<n> decisive=<constraint>
#   rc=<int> secs=<int>
# `decisive` is the constraint the ROUTER used to pick — it is what makes the residual measurable:
# every line on this tape is a decision the declared framework already approved.
record_route(){ # <cap> <node> <route> <offerers> <decisive> <rc> <secs>
  [ "$RECORD_ROUTES" = 1 ] || return 0
  mkdir -p "$(dirname "$ROUTE_LOG")" 2>/dev/null || return 0
  printf '%s  ROUTE cap=%s node=%s caller=%s route=%s offerers=%s decisive=%s rc=%s secs=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$(mesh_caller)" "$3" "$4" "$5" "$6" "$7" \
    >>"$ROUTE_LOG" 2>/dev/null || true
  return 0
}

# Run the capability, record what the world said, exit with the capability's own code.
run_recorded(){ # <cap> <node> <route> <offerers> <decisive> -- <cmd> [args...]
  local _cap="$1" _node="$2" _route="$3" _off="$4" _dec="$5"; shift 5
  [ "${1:-}" = -- ] && shift
  if [ "$RECORD_ROUTES" = 0 ]; then exec "$@"; fi
  local _t0 _rc=0
  _t0="$(date +%s)"
  "$@" || _rc=$?
  record_route "$_cap" "$_node" "$_route" "$_off" "$_dec" "$_rc" "$(( $(date +%s) - _t0 ))"
  exit "$_rc"
}
is_cap_local(){ [ -x "$CAP_DIR/$1" ]; }           # a new-style capability present on THIS node
# scope is read PASSIVELY from the cap file's `# cap-scope:` header — never by executing the cap
# (a place-bound actuator must not fire just to ask its scope). Absent header ⇒ bound (the safe
# default: place-bound, so a multi-offerer call can't silently fan out to the wrong instance).
scope_sed='s/^#[[:space:]]*cap-scope:[[:space:]]*//p'
cap_scope(){ # <short-node> <name> -> "fungible" | "bound"
  # v MUST be initialised. `is_cap_local && v=...` leaves v UNSET when there is no caps/<name>
  # file (every legacy mesh-<tool> organ), and under `set -u` the expansion below kills this
  # command substitution outright — the caller then reads "" and treats it as "bound". The axis
  # did not merely default; it was never evaluated, and nothing printed it, so nothing said so.
  local s="$1" nm="$2" u i p v=""
  if [ "$s" = "$(short "$(hostname)")" ]; then
    is_cap_local "$nm" && v="$(sed -n "$scope_sed" "$CAP_DIR/$nm" 2>/dev/null | head -1)"
  else
    u="$(peer_user "$s")"; i="$(peer_ip "$s")"; p="$(peer_port "$s")"
    if [ -n "$i" ]; then
      local o=(-o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
      [ "$p" != 22 ] && o+=(-p "$p")
      v="$(ssh "${o[@]}" "$u@$i" "sed -n '$scope_sed' \$HOME/.mesh/caps/$nm 2>/dev/null | head -1" </dev/null 2>/dev/null | tr -d '\r')"
    fi
  fi
  [ "$v" = fungible ] && echo fungible || echo bound
}

# --- capability SCOPING (adapted from clayseal.com "runtime capability scoping for agents",
#     study 'capability security' 2026-07-16) ---------------------------------------------------
# cap-scope answers WHERE a cap runs; this answers WHO/which-agent-context may INVOKE it — the
# object-capability least-privilege core: an agent gets exactly the caps its context is granted,
# enforced at the router (the agents' choke point), never inside the actuator that would already
# have fired. A cap declares its allow-list PASSIVELY in a header (read, never executed):
#     # cap-allow: genome tg          # only the genome & tg channels may fire this actuator
#     # cap-allow: *                  # explicitly unrestricted
# ADDITIVE & least-astonishment: a cap with NO cap-allow header is UNRESTRICTED (every legacy cap
# keeps working). But a cap that DECLARES a scope is enforced FAIL-CLOSED — an unknown/unlisted
# caller is DENIED (exit 3), because for a scoped-sensitive cap the safe error is "refuse", not
# "fire anyway" (the mesh no-faked-all-clear rule, applied to authorization). The distinction is
# the whole point: opt-in scoping, and where you opted in, deny-by-default.
allow_sed='s/^#[[:space:]]*cap-allow:[[:space:]]*//p'
cap_allow(){ # <short-node> <name> -> the raw allow-list string ("" = no header = unrestricted)
  local s="$1" nm="$2" u i p v=""   # see cap_scope: unset v + set -u kills the substitution
  if [ "$s" = "$(short "$(hostname)")" ]; then
    is_cap_local "$nm" && v="$(sed -n "$allow_sed" "$CAP_DIR/$nm" 2>/dev/null | head -1)"
  else
    u="$(peer_user "$s")"; i="$(peer_ip "$s")"; p="$(peer_port "$s")"
    if [ -n "$i" ]; then
      local o=(-o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
      [ "$p" != 22 ] && o+=(-p "$p")
      v="$(ssh "${o[@]}" "$u@$i" "sed -n '$allow_sed' \$HOME/.mesh/caps/$nm 2>/dev/null | head -1" </dev/null 2>/dev/null | tr -d '\r')"
    fi
  fi
  printf '%s' "$v"
}

# caller identity = which agent/context is asking. MESH_CALLER wins (a mind exports it), then an
# explicit --as, then the tmux WINDOW name (the channel IS the agent in this mesh: genome/tg/…),
# else "unknown" (which a scoped cap denies — least privilege for an unattributable caller).
mesh_caller(){
  [ -n "${MESH_CALLER:-}" ] && { printf '%s' "$MESH_CALLER"; return; }
  [ -n "${_AS:-}" ] && { printf '%s' "$_AS"; return; }
  local w; w="$(tmux display-message -p '#W' 2>/dev/null)"; [ -n "$w" ] && { printf '%s' "$w"; return; }
  printf 'unknown'
}

# THE GATE (runtime enforcement, called immediately before every exec path). Prints nothing and
# returns 0 when permitted; on denial it is LOUD (says the cap, the caller, and the required
# scope) and exits 3 — a code distinct from 1 (caller error) / 2 (offline) so a denial is never
# mistaken for "organ absent".
cap_gate(){ # <short-node> <name>
  local allow caller
  allow="$(cap_allow "$1" "$2")"
  [ -z "$allow" ] && return 0                     # no header ⇒ unrestricted (additive default)
  caller="$(mesh_caller)"
  local g; for g in $allow; do
    { [ "$g" = '*' ] || [ "$g" = "$caller" ]; } && return 0
  done
  echo "mesh-organ: DENY '$2' — caller '$caller' not in cap-allow scope [$allow] (set MESH_CALLER or --as <role>)" >&2
  exit 3
}

# organ NAME → the canonical mesh-* tool that exercises it. (sense/actuator class → tool)
tool_for(){ case "$1" in
    camera)        echo "mesh-camera" ;;
    ble|presence)  echo "mesh-presence" ;;
    mic|hear)      echo "mesh-hear" ;;
    notify)        echo "mesh-notify" ;;
    volume)        echo "mesh-volume" ;;
    speaker|say|tts|speech) echo "mesh-say" ;;
    light)         echo "mesh-light" ;;
    location)      echo "mesh-location" ;;
    motion|body-motion) echo "mesh-body-motion" ;;
    power|battery) echo "mesh-power" ;;
    lid)           echo "mesh-lid" ;;
    wifi)          echo "mesh-wifi" ;;
    tv|dlna-tv)    echo "mesh-tv" ;;
    *)             echo "mesh-$1" ;;   # default: name IS the tool suffix
  esac
}

# A real organ resolves to a tool that actually exists (genome is synced to every node, so the
# tool is present fleet-wide even when only one node has the HARDWARE). A typo resolves to a
# non-existent mesh-<typo>. This is how we keep "unknown organ" distinct from "real-but-offline"
# (header's honest-fusion claim) — without it, a typo reads as 'real organ, just offline'.
KNOWN_ORGANS="camera ble presence mic hear notify volume speaker say tts speech light location motion body-motion power battery lid wifi tv dlna-tv shadowsocks"
known_organ(){ command -v "$(tool_for "$1")" >/dev/null 2>&1; }
reject_unknown_organ(){
  known_organ "$1" && return 0
  is_cap_local "$1" && return 0                       # a caps/<name> capability on THIS node
  [ -n "$(offerers "$1")" ] && return 0              # some node's card declares it (cap or legacy organ)
  echo "mesh-organ: unknown organ '$1' — no such tool '$(tool_for "$1")' (known: $KNOWN_ORGANS; see mesh-organ --list)" >&2
  exit 1   # caller error (distinct from exit 2 = real organ but all offerers offline)
}

peer_user(){ # registry first (label:user@ip), then conventions
  if [ -f "$HOME/.mesh/nodes" ]; then
    local e; e=$(. "$HOME/.mesh/nodes" 2>/dev/null; for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$e" in *@*) echo "${e%%@*}"; return ;; esac
  fi
  case "$1" in Redmi|phone) echo "${PHONE_USER:-u0_a380}" ;; router|GL-MT3000) echo root ;; *) echo "${SSH_USER:-$(whoami)}" ;; esac
}
peer_ip(){ if [ -f "$HOME/.mesh/nodes" ]; then . "$HOME/.mesh/nodes" 2>/dev/null; for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { local r="${n#*:}"; echo "${r##*@}"; return; }; done; fi; }
peer_port(){ case "$1" in Redmi|phone) echo 8022 ;; *) echo 22 ;; esac; }
short(){ case "$1" in imozerov-IdeaPad-3-15IIL05) echo IdeaPad ;; imozerov-Default-string) echo default-string ;; "Redmi 10") echo Redmi ;; GL-MT3000) echo router ;; *) echo "$1" ;; esac; }

# nodes offering an organ (online, live>0), as hostnames — via the live fleet organ map.
# MESH_ORGANS_JSON substitutes a FIXTURE fleet map for --test. The seam is deliberately at the
# `mesh-organs --json` boundary and not at the offerer LIST: injecting the list would bypass the
# parser below, so every branch would be gated against a shape the live path never produces. A
# PATH stub cannot be used here — this script prepends $HOME/.local/bin to PATH itself, so a stub
# dir can never shadow the deployed mesh-organs.
offerers(){ local name="$1"
  { if [ -n "${MESH_ORGANS_JSON:-}" ]; then cat "$MESH_ORGANS_JSON"; else mesh-organs --json 2>/dev/null; fi; } | python3 -c "
import json,sys
name='$name'.lower()
for p in json.load(sys.stdin):
    caps=(p.get('senses','')+' '+p.get('actuators','')).lower()
    if name in caps.split() and p.get('live',0)>0:
        print(p['node'])
" 2>/dev/null
}

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  for x in ssh python3 mesh-organs; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -n "$(tool_for camera)" ] || { echo "smoke-test: FAIL (tool map broken)"; exit 1; }
  # --where exit 1 = no offerers (valid); only exit >1 = real error
  "$0" --where notify >/dev/null 2>&1; _rc=$?; [ "$_rc" -le 1 ] || { echo "smoke-test: FAIL (--where errored rc=$_rc)"; exit 1; }

  # capability-scoping gate — drive the REAL cap_gate against REAL cap files in a throwaway
  # CAP_DIR (never the live ~/.mesh/caps). Asserts all three arms of the object-capability model:
  # scoped+allowed → RUNS, scoped+unlisted → DENY exit 3, no-header → UNRESTRICTED. A gate whose
  # DENY arm is never exercised is not a gate (mesh doctrine): the exit-3 assertion IS the test.
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  printf '#!/bin/sh\n# cap-allow: genome tg\necho GATED_RAN\n' >"$_td/scopedcap"; chmod +x "$_td/scopedcap"
  printf '#!/bin/sh\necho OPEN_RAN\n'                          >"$_td/opencap";   chmod +x "$_td/opencap"
  _self="$(short "$(hostname)")"
  # arm 1: allowed caller → gate passes → cap actually runs
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_td" "$0" --as genome "scopedcap@$_self" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_o" | grep -q GATED_RAN; } || { echo "smoke-test: FAIL (scoped+allowed did not run: rc=$_rc out=$_o)"; exit 1; }
  # arm 2: unlisted caller → DENY, exit 3, cap must NOT have run
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_td" "$0" --as health "scopedcap@$_self" 2>&1)"; _rc=$?
  { [ "$_rc" = 3 ] && ! printf '%s' "$_o" | grep -q GATED_RAN; } || { echo "smoke-test: FAIL (scoped+unlisted not denied with rc3: rc=$_rc out=$_o)"; exit 1; }
  # arm 3: no cap-allow header → unrestricted → runs for an arbitrary caller
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_td" "$0" --as whoever "opencap@$_self" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_o" | grep -q OPEN_RAN; } || { echo "smoke-test: FAIL (unrestricted cap blocked: rc=$_rc out=$_o)"; exit 1; }
  rm -rf "$_td"; trap - EXIT

  # ---- THE PARADIGM OF CHOICE (--why) ------------------------------------------------------
  # Driven against a FIXTURE fleet map so the branch under test is chosen by the test, not by
  # whichever peers happen to be online this minute (the live map went 2 offerers -> 1 between
  # two runs while this was being written; a gate keyed on that is a coin toss).
  _wd="$(mktemp -d)"; trap 'rm -rf "$_wd"' EXIT
  _self="$(short "$(hostname)")"; _hn="$(hostname)"
  _fleet(){ # <json-file> <caps-for-self...>  — a fleet map in the REAL mesh-organs --json shape
    printf '[{"node":"%s","senses":"whycap","actuators":"","live":9,"total":9},' "$_hn" >"$1"
    printf '{"node":"peer-a","senses":"whycap","actuators":"","live":9,"total":9},' >>"$1"
    printf '{"node":"peer-b","senses":"whycap","actuators":"","live":9,"total":9}]' >>"$1"
  }
  _fleet "$_wd/fleet.json"
  mkdir -p "$_wd/caps"
  # A CAP THAT WOULD LEAVE A MARK IF IT RAN. --why explains a place-bound actuator; if explaining
  # one fires it, the mode is a weapon. This marker is the only proof that it does not.
  printf '#!/bin/sh\n# cap-scope: bound\ntouch "%s/FIRED"\necho RAN\n' "$_wd" >"$_wd/caps/whycap"
  chmod +x "$_wd/caps/whycap"
  _why(){ env -u MESH_CALLER MESH_ORGANS_JSON="$_wd/fleet.json" MESH_CAP_DIR="$_wd/caps" \
            "$0" --as "${1:-genome}" --why whycap 2>&1; }

  _o="$(_why)"; _rc=$?
  [ "$_rc" = 0 ] || { echo "smoke-test: FAIL (--why rc=$_rc: $_o)"; exit 1; }
  [ -e "$_wd/FIRED" ] && { echo "smoke-test: FAIL (--why EXECUTED the capability)"; exit 1; }
  printf '%s' "$_o" | grep -q "3 offerer(s)" || { echo "smoke-test: FAIL (--why lost the option set: $_o)"; exit 1; }
  # THE WHOLE FRAMEWORK, NOT ONE ASPECT: every declared constraint must appear as a verdict on
  # every offerer. A mode that printed only the winner would pass a mere rc check.
  for _n in "$_self" peer-a peer-b; do
    printf '%s' "$_o" | grep -q "^  $_n " || { echo "smoke-test: FAIL (--why omitted offerer $_n: $_o)"; exit 1; }
  done
  # bound + >1 offerer: --why must PREDICT the refusal, and the router must actually refuse.
  printf '%s' "$_o" | grep -q "decisive: where(cap-scope=bound)" \
    || { echo "smoke-test: FAIL (--why did not name the decisive constraint: $_o)"; exit 1; }
  _o2="$(env -u MESH_CALLER MESH_ORGANS_JSON="$_wd/fleet.json" MESH_CAP_DIR="$_wd/caps" \
           "$0" --as genome whycap 2>&1)"; _rc2=$?
  { [ "$_rc2" = 1 ] && ! [ -e "$_wd/FIRED" ]; } \
    || { echo "smoke-test: FAIL (--why predicted refusal but router rc=$_rc2 fired=$([ -e "$_wd/FIRED" ] && echo y || echo n))"; exit 1; }

  # THE ABSENTIAL HALF. A caller outside cap-allow must be RULED OUT *by name and by cause* — the
  # whole point is that the paradigm records what was eliminated, not only what won.
  printf '#!/bin/sh\n# cap-scope: fungible\n# cap-allow: tg\ntouch "%s/FIRED"\n' "$_wd" >"$_wd/caps/whycap"
  chmod +x "$_wd/caps/whycap"
  _o="$(_why health)"
  printf '%s' "$_o" | grep -q "RULED OUT by who" \
    || { echo "smoke-test: FAIL (unlisted caller not ruled out: $_o)"; exit 1; }
  printf '%s' "$_o" | grep -q "ruled out:.*$_self(who)" \
    || { echo "smoke-test: FAIL (ruled-out line does not name the node and the cause: $_o)"; exit 1; }
  # ...and the SAME cap with an allowed caller is eligible, so the leg above is testing the gate
  # and not merely a string this mode always prints.
  printf '%s' "$(_why tg)" | grep -q "RULED OUT by who" \
    && { echo "smoke-test: FAIL (allowed caller ruled out by who)"; exit 1; }
  # fungible + >1 offerer: first-offered wins and the runners-up must be NAMED (not just counted).
  # This needs a peer that survives the REACH constraint, so give peer-a an address and leave
  # peer-b without one — which also separates the two rejection causes: without the addressed
  # peer, "no runners-up" and "runners-up suppressed" print identically.
  mkdir -p "$_wd/home/.mesh"
  printf 'MESH_NODES="peer-a:u@192.0.2.7"\n' >"$_wd/home/.mesh/nodes"   # TEST-NET-1, never routes
  _o="$(env -u MESH_CALLER HOME="$_wd/home" MESH_ORGANS_JSON="$_wd/fleet.json" \
          MESH_CAP_DIR="$_wd/caps" "$0" --as tg --why whycap 2>&1)"
  printf '%s' "$_o" | grep -q "decisive: where(cap-scope=fungible)" \
    || { echo "smoke-test: FAIL (fungible decisive not named: $_o)"; exit 1; }
  printf '%s' "$_o" | grep -qE "runner\(s\)-up:.*peer-a" \
    || { echo "smoke-test: FAIL (runners-up not named: $_o)"; exit 1; }
  printf '%s' "$_o" | grep -q "peer-b(reach)" \
    || { echo "smoke-test: FAIL (an unaddressed offerer must be ruled out by reach, not silently: $_o)"; exit 1; }

  # AN EMPTY OPTION SET IS NOT A CHOICE — and must not render as a table with no rows.
  printf '[{"node":"%s","senses":"whycap","actuators":"","live":0,"total":0}]' "$_hn" >"$_wd/empty.json"
  _o="$(env -u MESH_CALLER MESH_ORGANS_JSON="$_wd/empty.json" MESH_CAP_DIR="$_wd/caps" "$0" --as genome --why whycap 2>&1)"
  { printf '%s' "$_o" | grep -q "option set: EMPTY" && ! printf '%s' "$_o" | grep -q "eligible"; } \
    || { echo "smoke-test: FAIL (empty option set rendered as a choice: $_o)"; exit 1; }

  # THE ROUTE ITSELF MUST CARRY ITS PARADIGM. Not a --why-only courtesy: the line a human reads
  # in a log a day later is this one.
  _o="$(env -u MESH_CALLER MESH_ORGANS_JSON="$_wd/fleet.json" MESH_CAP_DIR="$_wd/caps" \
          "$0" --as tg whycap 2>&1)"
  printf '%s' "$_o" | grep -q "paradigm:.*chosen from 3 offerer(s)" \
    || { echo "smoke-test: FAIL (route printed a choice with no paradigm: $_o)"; exit 1; }
  printf '%s' "$_o" | grep -q "not chosen:" \
    || { echo "smoke-test: FAIL (route did not name what it ruled out: $_o)"; exit 1; }

  # THE CONSTRAINT THAT WAS NEVER EVALUATED. cap_scope/cap_allow left `v` unset when the node has
  # no caps/<name> file — under `set -u` that killed the command substitution, and the caller read
  # the empty result as "bound"/"unrestricted". Silent, and every legacy mesh-<tool> organ hits it.
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_wd/nosuchdir" "$0" --scope "camera@$_self" 2>&1)"
  printf '%s' "$_o" | grep -q "unbound variable" \
    && { echo "smoke-test: FAIL (cap_scope/cap_allow die on a node with no caps file: $_o)"; exit 1; }
  printf '%s' "$_o" | grep -q "cap-scope=bound" \
    || { echo "smoke-test: FAIL (absent cap file must still render bound: $_o)"; exit 1; }

  # LIVE PATH, not only the fixture: --why against the real fleet map must run clean and print a
  # verdict, whatever this minute's peers happen to be.
  _o="$("$0" --why camera 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_o" | grep -q "decisive:" \
    && ! printf '%s' "$_o" | grep -q "unbound variable"; } \
    || { echo "smoke-test: FAIL (--why on the LIVE fleet map: rc=$_rc $_o)"; exit 1; }
  rm -rf "$_wd"; trap - EXIT

  # ── THE OUTCOME TAPE + --qualify (the qualification-problem lens) ───────────────────────────
  # Six legs. The load-bearing one is the VACUITY PAIR: two fixtures carrying the IDENTICAL
  # failure multiset (30 routes, 12 failures) that differ ONLY in which offerer the failures are
  # paired with. A lens that reads the failure RATE passes both, so the pair is the only thing
  # that can tell "found node structure" apart from "counted failures". Seen red both ways: with
  # weighted_tv() returning a constant the concentrated fixture reads NO-NODE-STRUCTURE, and with
  # the permutation replaced by a fixed p=0.001 the flat fixture reads UNSTATED-PRECONDITION-SUSPECTED.
  _qd="$MESH_TEST_TMPD/qualify"; mkdir -p "$_qd"
  _q_fix(){ # $1=file  $2..=<node>:<rc> triples, one per route
    local f="$1"; shift; local i=0 e
    : >"$f"
    for e in "$@"; do i=$((i+1))
      printf '2026-08-19T00:%02d:00Z  ROUTE cap=camera node=%s caller=genome route=remote offerers=2 decisive=where-fungible+first-offered rc=%s secs=1\n' \
        "$((i % 60))" "${e%%:*}" "${e##*:}" >>"$f"
    done
  }
  _q_conc=""; _q_flat=""; _i=0
  while [ "$_i" -lt 15 ]; do _q_conc="$_q_conc A:0"; _i=$((_i+1)); done
  _i=0; while [ "$_i" -lt 12 ]; do _q_conc="$_q_conc B:1"; _i=$((_i+1)); done
  _i=0; while [ "$_i" -lt 3  ]; do _q_conc="$_q_conc B:0"; _i=$((_i+1)); done
  _i=0; while [ "$_i" -lt 6  ]; do _q_flat="$_q_flat A:1"; _i=$((_i+1)); done
  _i=0; while [ "$_i" -lt 9  ]; do _q_flat="$_q_flat A:0"; _i=$((_i+1)); done
  _i=0; while [ "$_i" -lt 6  ]; do _q_flat="$_q_flat B:1"; _i=$((_i+1)); done
  _i=0; while [ "$_i" -lt 9  ]; do _q_flat="$_q_flat B:0"; _i=$((_i+1)); done
  _q_fix "$_qd/conc" $_q_conc
  _q_fix "$_qd/flat" $_q_flat

  _o="$(MESH_ORGAN_ROUTE_LOG="$_qd/conc" "$0" --qualify --json 2>&1)"
  printf '%s' "$_o" | grep -q '"verdict": "UNSTATED-PRECONDITION-SUSPECTED"' \
    || { echo "smoke-test: FAIL (--qualify missed a residual concentrated on one offerer: $_o)"; exit 1; }
  _o="$(MESH_ORGAN_ROUTE_LOG="$_qd/flat" "$0" --qualify --json 2>&1)"
  printf '%s' "$_o" | grep -q '"verdict": "NO-NODE-STRUCTURE"' \
    || { echo "smoke-test: FAIL (--qualify invented node structure in an evenly-spread residual — the two fixtures carry the SAME multiset: $_o)"; exit 1; }

  # Below the minimum is `na` WITH ITS n, never a verdict on four routes.
  head -19 "$_qd/conc" > "$_qd/few"
  _o="$(MESH_ORGAN_ROUTE_LOG="$_qd/few" "$0" --qualify 2>&1)"
  { printf '%s' "$_o" | grep -q "verdict=na" && printf '%s' "$_o" | grep -q "need 20"; } \
    || { echo "smoke-test: FAIL (--qualify rendered a verdict below the minimum n: $_o)"; exit 1; }

  # A row missing rc is COUNTED and dropped. Defaulting it to 0 would turn an unreadable route
  # into a success ([[an-empty-read-written-as-truth-erases-the-tracked-state]]).
  { cat "$_qd/conc"; echo "2026-08-19T01:00:00Z  ROUTE cap=camera node=B caller=genome route=remote"; } > "$_qd/bad"
  _o="$(MESH_ORGAN_ROUTE_LOG="$_qd/bad" "$0" --qualify --json 2>&1)"
  printf '%s' "$_o" | grep -q '"malformed": 1' \
    || { echo "smoke-test: FAIL (--qualify silently swallowed a malformed row: $_o)"; exit 1; }

  # An absent tape is n/a (exit 2) and SAYS the series starts empty by construction — the one
  # reading this lens gives on a router that has just grown it.
  _o="$(MESH_ORGAN_ROUTE_LOG="$_qd/never" "$0" --qualify 2>&1)"; _rc=$?
  { [ "$_rc" = 2 ] && printf '%s' "$_o" | grep -q "BY CONSTRUCTION"; } \
    || { echo "smoke-test: FAIL (--qualify on an absent tape: rc=$_rc $_o)"; exit 1; }

  # THE WRITE HALF. A lens over a tape nobody writes is a reflex that was never wired: drive a
  # REAL local route and assert the tape grew a row carrying the capability's OWN exit code.
  mkdir -p "$_qd/caps"
  printf '#!/bin/sh\n# cap-scope: fungible\nexit 7\n' > "$_qd/caps/qcap"; chmod +x "$_qd/caps/qcap"
  printf '[{"node":"%s","senses":"qcap","actuators":"","live":1,"total":1}]\n' "$(hostname)" > "$_qd/organs.json"
  : > "$_qd/live"
  MESH_CAP_DIR="$_qd/caps" MESH_ORGAN_ROUTE_LOG="$_qd/live" MESH_ORGANS_JSON="$_qd/organs.json" \
    MESH_CALLER=genome "$0" qcap >/dev/null 2>&1; _rc=$?
  { [ "$_rc" = 7 ] && grep -q 'cap=qcap .*rc=7' "$_qd/live"; } \
    || { echo "smoke-test: FAIL (route outcome not recorded, or the cap's exit code was not propagated: rc=$_rc tape=$(cat "$_qd/live"))"; exit 1; }
  # MESH_ORGAN_NO_RECORD=1 restores the old `exec` semantics exactly and writes NOTHING.
  : > "$_qd/quiet"
  MESH_ORGAN_NO_RECORD=1 MESH_CAP_DIR="$_qd/caps" MESH_ORGAN_ROUTE_LOG="$_qd/quiet" \
    MESH_ORGANS_JSON="$_qd/organs.json" "$0" qcap >/dev/null 2>&1; _rc=$?
  { [ "$_rc" = 7 ] && [ ! -s "$_qd/quiet" ]; } \
    || { echo "smoke-test: FAIL (MESH_ORGAN_NO_RECORD did not restore a silent exec: rc=$_rc size=$(wc -c <"$_qd/quiet"))"; exit 1; }

  echo "smoke-test: ok"; exit 0
fi

# --as <role> is pre-parsed HERE, before the read-only modes, not only on the route path. --why
# and --scope report what the WHO gate would say for a given caller, so the flag that names the
# caller has to be visible to them; `--as genome --why <cap>` previously fell through to the
# route parser and died as "unknown organ '--why'".
_AS=""; if [ "${1:-}" = --as ]; then _AS="$2"; shift 2; fi

case "${1:-}" in
  --manifest)
    echo "=== mesh capability manifest ==="
    printf '%s\n' 'node|senses|actuators|live|total'
    mesh-organs --json 2>/dev/null | python3 -c 'import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for p in data:
    print("{node}|{senses}|{actuators}|{live}|{total}".format(
        node=p.get("node","?"),
        senses=(p.get("senses") or ""),
        actuators=(p.get("actuators") or ""),
        live=p.get("live","?"),
        total=p.get("total","?"),
    ))'
    exit 0 ;;
  --list|"") echo "=== mesh fleet capability map ==="; mesh-organs 2>/dev/null; exit 0 ;;
  --where)   name="${2:?need organ name}"; reject_unknown_organ "$name"; o="$(offerers "$name")"
             if [ -z "$o" ]; then echo "no online node offers '$name'"; exit 0; fi
             echo "$name offered by:"; printf '%s\n' "$o" | while read -r h; do echo "  $(short "$h")"; done; exit 0 ;;
  --scope)   # read-only: print a cap's scope + authorization allow-list, without executing it
             name="${2:?need organ name}"; case "$name" in *@*) tgt="${name##*@}"; name="${name%@*}" ;; *) tgt="$(short "$(hostname)")" ;; esac
             a="$(cap_allow "$tgt" "$name")"
             echo "$name@$tgt: cap-scope=$(cap_scope "$tgt" "$name") cap-allow=${a:-<unrestricted>}"; exit 0 ;;
  --why)     # THE WHOLE FRAMEWORK, NOT ONE ASPECT. Read-only reconstruction of the routing
             # decision: every offerer in the option set, every declared constraint's verdict on
             # it, the DECISIVE constraint, and — the absential half — what was ruled out and by
             # what. Never executes the cap (a place-bound actuator must not fire to explain
             # itself), so this is safe to run against a speaker or a camera.
             name="${2:?need organ name}"; case "$name" in *@*) name="${name%@*}" ;; esac
             reject_unknown_organ "$name"
             _caller="$(mesh_caller)"; _self="$(short "$(hostname)")"
             echo "=== mesh-organ --why $name — the paradigm of choice ==="
             echo "  caller: $_caller"
             echo "  constraint types declared by this router: where(cap-scope) who(cap-allow) reach(~/.mesh/nodes address)"
             _hosts="$(offerers "$name")"
             if [ -z "$_hosts" ]; then
               # AN EMPTY OPTION SET IS NOT A CHOICE. Say that, rather than print a header over
               # nothing — a blank table reads as "considered and found fine".
               echo "  option set: EMPTY — no online node offers '$name'"
               echo "  decisive: reach — there is no choice to explain (the router would exit 2)"
               exit 0
             fi
             _n=$(printf '%s\n' "$_hosts" | grep -c .)
             echo "  option set: $_n offerer(s)"
             printf '  %-16s %-9s %-22s %-9s %s\n' NODE WHERE WHO REACH VERDICT
             _elig=""; _out=""
             while read -r _h; do
               [ -n "$_h" ] || continue
               _s="$(short "$_h")"
               _sc="$(cap_scope "$_s" "$name")"
               _al="$(cap_allow "$_s" "$name")"
               # WHO: evaluated against the REAL caller with the REAL rule, not restated from the
               # header — a header echoed back is not a verdict.
               if [ -z "$_al" ]; then _who="<unrestricted>"; _wok=1
               else
                 _wok=0; for _g in $_al; do { [ "$_g" = '*' ] || [ "$_g" = "$_caller" ]; } && _wok=1; done
                 _who="$_al"
               fi
               if [ "$_s" = "$_self" ]; then _rch="local"; _rok=1
               elif [ -n "$(peer_ip "$_s")" ]; then _rch="addressed"; _rok=1
               else _rch="NO-ADDR"; _rok=0
               fi
               if [ "$_wok" = 0 ]; then _v="RULED OUT by who"; _out="$_out $_s(who)"
               elif [ "$_rok" = 0 ]; then _v="RULED OUT by reach"; _out="$_out $_s(reach)"
               else _v="eligible"; _elig="$_elig $_s"
               fi
               printf '  %-16s %-9s %-22s %-9s %s\n' "$_s" "$_sc" "$_who" "$_rch" "$_v"
             done < <(printf '%s\n' "$_hosts")
             _ne=$(printf '%s' "$_elig" | wc -w)
             _first="$(short "$(printf '%s\n' "$_hosts" | head -1)")"
             echo "  ruled out:${_out:- none}"
             if [ "$_ne" = 0 ]; then
               echo "  decisive: who/reach — every offerer was ruled out; the router would DENY or fail to address"
             elif [ "$_n" -gt 1 ] && [ "$(cap_scope "$_first" "$name")" != fungible ]; then
               echo "  decisive: where(cap-scope=bound) with $_n offerers — the router REFUSES (exit 1) and makes you name the instance"
             elif [ "$_n" -gt 1 ]; then
               echo "  decisive: where(cap-scope=fungible) — then FIRST-OFFERED wins; runner(s)-up:$(printf '%s' "$_elig" | tr ' ' '\n' | grep -v "^$_first$" | tr '\n' ' ')"
               echo "  NOTE: first-offered is the whole tie-break. The router does NOT retry the runners-up if the winner's ssh fails — the header's word 'failover' overstates it."
             else
               echo "  decisive: reach — one offerer, so the option set never had an alternative"
             fi
             exit 0 ;;
  --qualify) # THE RESIDUAL OF THE DECLARED FRAMEWORK — read-only, never executes a cap.
             # `--why` answers "which constraints did the router consult?" over a CLOSED set of
             # three. This answers the question that set cannot: of the routes every declared
             # constraint APPROVED, how many did the world refuse anyway? That share is the
             # qualification problem's bite in this router, in the router's own numbers — and
             # where it concentrates on ONE offerer that the framework calls interchangeable is a
             # candidate UNSTATED PRECONDITION, which is the thing McCarthy says you cannot
             # enumerate ahead of time and ConditionNET/LASP say you must learn from outcomes.
             # It is a HYPOTHESIS, never a cause: this lens sees rc and node, not mechanism.
             _qcap=""; _qjson=0
             for _a in "$@"; do case "$_a" in --qualify) : ;; --json) _qjson=1 ;; *) [ -z "$_qcap" ] && _qcap="$_a" ;; esac; done
             if [ ! -r "$ROUTE_LOG" ]; then
               echo "mesh-organ qualify: n/a — no route tape at $ROUTE_LOG. This router recorded nothing until the outcome tape landed, so the series starts empty BY CONSTRUCTION and is not a quiet fleet."
               exit 2
             fi
             MESH_ORGAN_Q_CAP="$_qcap" MESH_ORGAN_Q_JSON="$_qjson" python3 - "$ROUTE_LOG" <<'PYQ'
import os, random, sys, re
log = sys.argv[1]
want = os.environ.get("MESH_ORGAN_Q_CAP","") or None
as_json = os.environ.get("MESH_ORGAN_Q_JSON","0") == "1"
MIN   = int(os.environ.get("MESH_ORGAN_QUALIFY_MIN","20"))
PERMS = int(os.environ.get("MESH_ORGAN_QUALIFY_PERMS","999"))
SEED  = int(os.environ.get("MESH_ORGAN_QUALIFY_SEED","20260819"))
ALPHA = float(os.environ.get("MESH_ORGAN_QUALIFY_ALPHA","0.05"))

rows, malformed = [], 0
for line in open(log, errors="replace"):
    if " ROUTE " not in line:
        continue
    kv = dict(re.findall(r"(\w+)=(\S+)", line))
    # A row missing any field this lens SCORES is counted and dropped, never defaulted: an
    # rc silently read as 0 would turn an unreadable row into a success.
    if not all(k in kv for k in ("cap","node","rc","route")):
        malformed += 1; continue
    try: rc = int(kv["rc"])
    except ValueError: malformed += 1; continue
    rows.append((kv["cap"], kv["node"], rc, kv["route"], kv.get("decisive","?")))

scored = [r for r in rows if want is None or r[0] == want]
random.seed(SEED)

def weighted_tv(nodes, fails):
    """sum_i n_i * |p_i - p_pooled| — how much the per-offerer failure rate departs from the
    pooled one. Zero when every offerer fails at the same rate, which is exactly the null the
    router's fungibility claim asserts."""
    tot = len(fails)
    if tot == 0: return 0.0
    pooled = sum(fails)/tot
    per = {}
    for nd, f in zip(nodes, fails):
        a = per.setdefault(nd, [0,0]); a[0] += 1; a[1] += f
    return sum(n*abs(f/n - pooled) for n, f in per.values())

caps = {}
for cap, node, rc, route, dec in scored:
    caps.setdefault(cap, []).append((node, rc, route))

out = []
for cap, obs in sorted(caps.items()):
    nodes = [o[0] for o in obs]
    fails = [1 if o[1] != 0 else 0 for o in obs]
    transport = sum(1 for o in obs if o[1] == 255 and o[2] == "remote")
    n, nf = len(obs), sum(fails)
    distinct = sorted(set(nodes))
    verdict, pval, stat = "na", None, None
    if n < MIN:
        why = "%d route(s), need %d — unmeasured, not clean" % (n, MIN)
    elif len(distinct) < 2:
        why = "only one offerer ever ran this cap (%s) — there is no interchangeability claim to test" % distinct[0]
    else:
        stat = weighted_tv(nodes, fails)
        perm = fails[:]
        hits = 0
        for _ in range(PERMS):
            random.shuffle(perm)
            if weighted_tv(nodes, perm) >= stat: hits += 1
        pval = (hits + 1) / (PERMS + 1)
        if nf == 0:
            verdict, why = "NO-RESIDUAL", "every approved route succeeded"
        elif pval <= ALPHA:
            verdict, why = "UNSTATED-PRECONDITION-SUSPECTED", "failures concentrate on an offerer the framework calls interchangeable"
        else:
            verdict, why = "NO-NODE-STRUCTURE", "the residual is spread across offerers"
    per_node = {}
    for nd, f in zip(nodes, fails):
        a = per_node.setdefault(nd, [0,0]); a[0] += 1; a[1] += f
    out.append(dict(cap=cap, n=n, failed=nf, residual=(nf/n if n else 0.0),
                    transport_255=transport, offerers=distinct, verdict=verdict,
                    p=pval, stat=stat, why=why,
                    per_node={k: dict(n=v[0], failed=v[1]) for k, v in per_node.items()}))

tot_n = sum(o["n"] for o in out); tot_f = sum(o["failed"] for o in out)
if as_json:
    import json
    print(json.dumps(dict(tape=log, routes=tot_n, failed=tot_f,
                          residual=(tot_f/tot_n if tot_n else None),
                          malformed=malformed, min_routes=MIN, perms=PERMS, alpha=ALPHA,
                          caps=out), sort_keys=True))
    sys.exit(0)

print("=== mesh-organ --qualify — the residual of the declared constraint framework ===")
print("  tape: %s" % log)
print("  the framework this router declares: where(cap-scope) who(cap-allow) reach(address).")
print("  EVERY row below is a route those three APPROVED. The residual is what the world said anyway —")
print("  McCarthy's qualification problem (you cannot axiomatize an action's preconditions) in numbers.")
if malformed:
    print("  %d row(s) were malformed and dropped — counted, never defaulted to rc=0." % malformed)
if not out:
    print("  na — the tape carries no scorable route%s. Nothing has been routed since the tape landed."
          % (" for '%s'" % want if want else ""))
    sys.exit(2)
print("  routes=%d failed=%d residual=%.3f  (min per cap=%d, perms=%d, alpha=%.2f)"
      % (tot_n, tot_f, (tot_f/tot_n if tot_n else 0.0), MIN, PERMS, ALPHA))
for o in out:
    print("  %-16s n=%-4d failed=%-4d residual=%.3f  verdict=%s"
          % (o["cap"], o["n"], o["failed"], o["residual"], o["verdict"]))
    if o["p"] is not None:
        print("      p=%.4f  weighted-TV=%.3f  (permutation null: the SAME failure multiset reshuffled across the same offerers)" % (o["p"], o["stat"]))
    print("      %s" % o["why"])
    for nd in sorted(o["per_node"]):
        v = o["per_node"][nd]
        print("      offerer %-14s n=%-4d failed=%-4d" % (nd, v["n"], v["failed"]))
    if o["transport_255"]:
        print("      of which %d were ssh-transport (rc=255) on a remote route — reach failed AT USE, which the address check cannot see" % o["transport_255"])
print("  NOT A CAUSE. This lens sees a capability name, an offerer and an exit code. A concentrated")
print("  residual names WHERE to look for the precondition nobody wrote down; it never names it.")
PYQ
             exit $? ;;
esac

# --as <role>: the caller names its own agent-context for the scope check (a mind that did not
# export MESH_CALLER can still attribute itself). Consumed before target resolution.
if [ "${1:-}" = --as ]; then _AS="$2"; shift 2; fi   # (pre-parsed above; do not reset it)
FORCE=""; if [ "${1:-}" = --node ]; then FORCE="$2"; shift 2; fi
if [ "${1:-}" = --as ]; then _AS="$2"; shift 2; fi   # allow --node then --as ordering too
name="${1:?usage: mesh-organ <name>[@<node>] [args] | --list | --where <name> | --why <name> | --node <label> <name>}"; shift || true
# <name>@<node> = explicit instance addressing — the default intent for place-bound caps
# (one speaker is not another). The @node wins over a bare --node only if --node wasn't given.
case "$name" in *@*) [ -z "$FORCE" ] && FORCE="${name##*@}"; name="${name%@*}" ;; esac
reject_unknown_organ "$name"
SELF_SHORT="$(short "$(hostname)")"

# resolve target node
if [ -n "$FORCE" ]; then
  target_short="$FORCE"
else
  hosts="$(offerers "$name")"
  [ -z "$hosts" ] && { echo "mesh-organ: no ONLINE node offers '$name' (try: mesh-organ --list)"; exit 2; }
  n_off=$(printf '%s\n' "$hosts" | grep -c .)
  target_short="$(short "$(printf '%s\n' "$hosts" | head -1)")"
  if [ "$n_off" -gt 1 ]; then
    # multiple offerers + no explicit instance: fungible → route to any (failover); place-bound
    # → refuse and make the caller name the instance (the 3-voices case).
    if [ "$(cap_scope "$target_short" "$name")" != fungible ]; then
      echo "mesh-organ: '$name' is place-bound and $n_off nodes offer it — name the instance: $name@<node>" >&2
      printf '%s\n' "$hosts" | while read -r h; do echo "  $name@$(short "$h")" >&2; done
      exit 1
    fi
  fi
fi

# The decisive constraint, as a token for the outcome tape. This is the SAME axis `--why` prints;
# recording it is what makes the residual in `--qualify` a statement about the DECLARED framework
# ("every constraint said go, and it still failed") rather than a bare failure rate.
if [ -n "$FORCE" ]; then _DECISIVE=explicit-instance; _NOFF=na
elif [ "${n_off:-1}" -gt 1 ]; then _DECISIVE=where-fungible+first-offered; _NOFF="${n_off}"
else _DECISIVE=reach-sole-offerer; _NOFF="${n_off:-1}"
fi

# THE ROUTE PRINTS ITS PARADIGM, NOT ONLY ITS CHOICE. `[mesh-organ] say -> mesh-home` is a
# choice with its alternatives destroyed: read it a day later and there is no way to tell whether
# one node offered the organ or four did and three lost. One line, from data already in hand (no
# extra ssh), restores what the pick ruled out and by what.
if [ "${n_off:-1}" -gt 1 ]; then
  _rest="$(printf '%s\n' "$hosts" | while read -r _h; do
             [ -n "$_h" ] || continue; _s="$(short "$_h")"
             [ "$_s" != "$target_short" ] && printf '%s ' "$_s"; done)"
  echo "[mesh-organ] paradigm: $target_short chosen from $n_off offerer(s) by where(cap-scope=fungible)+first-offered; not chosen: ${_rest:-none} (no retry on failure — mesh-organ --why $name)" >&2
fi
tool="$(tool_for "$name")"
# Pure router: invoke the capability by its PATH on the chosen node — a caps/<name> executable
# if present (filename IS the name; secrets stay inside it), else the legacy mesh-<tool>. No
# special provider verb; the path is the resolution.
cap_gate "$target_short" "$name"   # runtime authorization scope check — DENY (exit 3) before any exec
if [ "$target_short" = "$SELF_SHORT" ]; then
  if is_cap_local "$name"; then echo "[mesh-organ] $name → local (caps/$name)"
    run_recorded "$name" "$target_short" local "$_NOFF" "$_DECISIVE" -- "$CAP_DIR/$name" "$@"; fi
  echo "[mesh-organ] $name → local ($tool)"
  run_recorded "$name" "$target_short" local "$_NOFF" "$_DECISIVE" -- "$HOME/.local/bin/$tool" "$@"
fi
user="$(peer_user "$target_short")"; ip="$(peer_ip "$target_short")"; port="$(peer_port "$target_short")"
[ -z "$ip" ] && { echo "mesh-organ: can't resolve address for '$target_short' (not in ~/.mesh/nodes)"; exit 2; }
echo "[mesh-organ] $name → $target_short ($user@$ip)"
opts=(-o ConnectTimeout=6 -o BatchMode=yes -o StrictHostKeyChecking=accept-new); [ "$port" != 22 ] && opts+=(-p "$port")
run_recorded "$name" "$target_short" remote "$_NOFF" "$_DECISIVE" -- \
  ssh "${opts[@]}" "$user@$ip" \
  "p=\"\$HOME/.mesh/caps/$name\"; if [ -x \"\$p\" ]; then exec \"\$p\" $*; else exec \"\$HOME/.local/bin/$tool\" $*; fi" 2>&1 </dev/null
