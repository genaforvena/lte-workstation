#!/usr/bin/env bash
# mesh-organ — the CAPABILITY ROUTER: run an organ by NAME, wherever it physically lives.
# Operator 2026-06-13: "it shouldn't matter WHERE the organs are." From any node,
# `mesh-organ camera` finds a node that HAS a camera, runs it there, returns the artifact.
# Layer B of knowledge/location-transparency-design-2026-06-13.md. Purely additive: read-only
# resolution (mesh-organs --json) + SSH execution; no node-local hardware assumptions.
#
#   mesh-organ --list                 the fleet capability map (which node offers what)
#   mesh-organ --manifest             read-only capability manifest (name -> tool -> host)
#   mesh-organ <name>@<node> [args]   run capability <name> on a SPECIFIC node (place-bound default)
#   mesh-organ <name> [args...]       run <name>: 1 offerer → there; many → fungible routes/failover,
#                                     place-bound refuses & asks for <name>@<node> (the 3-voices case)
#   mesh-organ --node <label> <name>  force a specific host (alias of <name>@<label>)
#   mesh-organ --where <name>         just print which node(s) offer <name>, don't run
#   mesh-organ --scope <name>[@node]  read-only: print a cap's WHERE-scope + WHO cap-allow list
#   mesh-organ --as <role> <name>     name the calling agent-context for the cap-allow gate
#   mesh-organ --test
#
# CAPABILITY SCOPING (study 'capability security', clayseal.com): a cap may declare an authorization
# allow-list `# cap-allow: <role>...` (roles = channels: genome/tg/senses/…); the router DENIES (exit 3)
# an unlisted caller before any exec. Caller id = $MESH_CALLER > --as > tmux window > unknown. No
# cap-allow header ⇒ unrestricted (additive). Where a scope IS declared, it is deny-by-default.
#
# A capability = an executable in ~/.mesh/caps/ whose FILENAME is its name (self-describing; the
# name IS the command, secrets stay inside it). Legacy senses/actuators (mesh-<tool>) still route.
# Honest-fusion: distinguishes no-such-organ / all-offering-nodes-offline / ran-here-is-the-artifact.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# Self-describing capability (operator design 2026-06-21): a capability is an EXECUTABLE whose
# FILENAME is its name, in ~/.mesh/caps/. No name->command table — the name IS the command. The
# secrets/env live INSIDE the file, on the node; the router runs it by its path (no special
# provider verb). The file declares its own nature via a `# cap-scope: fungible|bound` header
# (read back via `<cap> --scope`; default = bound). Place-bound is the default because senses +
# actuators are a point in space; fungibility is only for PLACELESS caps (pure compute, egress,
# bridge-to-a-single-external-sink) where the effect doesn't depend on WHICH node runs it.
CAP_DIR="${MESH_CAP_DIR:-$HOME/.mesh/caps}"
is_cap_local(){ [ -x "$CAP_DIR/$1" ]; }           # a new-style capability present on THIS node
# scope is read PASSIVELY from the cap file's `# cap-scope:` header — never by executing the cap
# (a place-bound actuator must not fire just to ask its scope). Absent header ⇒ bound (the safe
# default: place-bound, so a multi-offerer call can't silently fan out to the wrong instance).
scope_sed='s/^#[[:space:]]*cap-scope:[[:space:]]*//p'
cap_scope(){ # <short-node> <name> -> "fungible" | "bound"
  local s="$1" nm="$2" u i p v
  if [ "$s" = "$(short "$(hostname)")" ]; then
    is_cap_local "$nm" && v="$(sed -n "$scope_sed" "$CAP_DIR/$nm" 2>/dev/null | head -1)"
  else
    u="$(peer_user "$s")"; i="$(peer_ip "$s")"; p="$(peer_port "$s")"
    if [ -n "$i" ]; then
      local o=(-o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
      [ "$p" != 22 ] && o+=(-p "$p")
      v="$(ssh "${o[@]}" "$u@$i" "sed -n '$scope_sed' \$HOME/.mesh/caps/$nm 2>/dev/null | head -1" </dev/null 2>/dev/null | tr -d '\r')"
    fi
  fi
  [ "$v" = fungible ] && echo fungible || echo bound
}

# --- capability SCOPING (adapted from clayseal.com "runtime capability scoping for agents",
#     study 'capability security' 2026-07-16) ---------------------------------------------------
# cap-scope answers WHERE a cap runs; this answers WHO/which-agent-context may INVOKE it — the
# object-capability least-privilege core: an agent gets exactly the caps its context is granted,
# enforced at the router (the agents' choke point), never inside the actuator that would already
# have fired. A cap declares its allow-list PASSIVELY in a header (read, never executed):
#     # cap-allow: genome tg          # only the genome & tg channels may fire this actuator
#     # cap-allow: *                  # explicitly unrestricted
# ADDITIVE & least-astonishment: a cap with NO cap-allow header is UNRESTRICTED (every legacy cap
# keeps working). But a cap that DECLARES a scope is enforced FAIL-CLOSED — an unknown/unlisted
# caller is DENIED (exit 3), because for a scoped-sensitive cap the safe error is "refuse", not
# "fire anyway" (the mesh no-faked-all-clear rule, applied to authorization). The distinction is
# the whole point: opt-in scoping, and where you opted in, deny-by-default.
allow_sed='s/^#[[:space:]]*cap-allow:[[:space:]]*//p'
cap_allow(){ # <short-node> <name> -> the raw allow-list string ("" = no header = unrestricted)
  local s="$1" nm="$2" u i p v
  if [ "$s" = "$(short "$(hostname)")" ]; then
    is_cap_local "$nm" && v="$(sed -n "$allow_sed" "$CAP_DIR/$nm" 2>/dev/null | head -1)"
  else
    u="$(peer_user "$s")"; i="$(peer_ip "$s")"; p="$(peer_port "$s")"
    if [ -n "$i" ]; then
      local o=(-o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
      [ "$p" != 22 ] && o+=(-p "$p")
      v="$(ssh "${o[@]}" "$u@$i" "sed -n '$allow_sed' \$HOME/.mesh/caps/$nm 2>/dev/null | head -1" </dev/null 2>/dev/null | tr -d '\r')"
    fi
  fi
  printf '%s' "$v"
}

# caller identity = which agent/context is asking. MESH_CALLER wins (a mind exports it), then an
# explicit --as, then the tmux WINDOW name (the channel IS the agent in this mesh: genome/tg/…),
# else "unknown" (which a scoped cap denies — least privilege for an unattributable caller).
mesh_caller(){
  [ -n "${MESH_CALLER:-}" ] && { printf '%s' "$MESH_CALLER"; return; }
  [ -n "${_AS:-}" ] && { printf '%s' "$_AS"; return; }
  local w; w="$(tmux display-message -p '#W' 2>/dev/null)"; [ -n "$w" ] && { printf '%s' "$w"; return; }
  printf 'unknown'
}

# THE GATE (runtime enforcement, called immediately before every exec path). Prints nothing and
# returns 0 when permitted; on denial it is LOUD (says the cap, the caller, and the required
# scope) and exits 3 — a code distinct from 1 (caller error) / 2 (offline) so a denial is never
# mistaken for "organ absent".
cap_gate(){ # <short-node> <name>
  local allow caller
  allow="$(cap_allow "$1" "$2")"
  [ -z "$allow" ] && return 0                     # no header ⇒ unrestricted (additive default)
  caller="$(mesh_caller)"
  local g; for g in $allow; do
    { [ "$g" = '*' ] || [ "$g" = "$caller" ]; } && return 0
  done
  echo "mesh-organ: DENY '$2' — caller '$caller' not in cap-allow scope [$allow] (set MESH_CALLER or --as <role>)" >&2
  exit 3
}

# organ NAME → the canonical mesh-* tool that exercises it. (sense/actuator class → tool)
tool_for(){ case "$1" in
    camera)        echo "mesh-camera" ;;
    ble|presence)  echo "mesh-presence" ;;
    mic|hear)      echo "mesh-hear" ;;
    notify)        echo "mesh-notify" ;;
    volume)        echo "mesh-volume" ;;
    speaker|say|tts|speech) echo "mesh-say" ;;
    light)         echo "mesh-light" ;;
    location)      echo "mesh-location" ;;
    motion|body-motion) echo "mesh-body-motion" ;;
    power|battery) echo "mesh-power" ;;
    lid)           echo "mesh-lid" ;;
    wifi)          echo "mesh-wifi" ;;
    tv|dlna-tv)    echo "mesh-tv" ;;
    *)             echo "mesh-$1" ;;   # default: name IS the tool suffix
  esac
}

# A real organ resolves to a tool that actually exists (genome is synced to every node, so the
# tool is present fleet-wide even when only one node has the HARDWARE). A typo resolves to a
# non-existent mesh-<typo>. This is how we keep "unknown organ" distinct from "real-but-offline"
# (header's honest-fusion claim) — without it, a typo reads as 'real organ, just offline'.
KNOWN_ORGANS="camera ble presence mic hear notify volume speaker say tts speech light location motion body-motion power battery lid wifi tv dlna-tv shadowsocks"
known_organ(){ command -v "$(tool_for "$1")" >/dev/null 2>&1; }
reject_unknown_organ(){
  known_organ "$1" && return 0
  is_cap_local "$1" && return 0                       # a caps/<name> capability on THIS node
  [ -n "$(offerers "$1")" ] && return 0              # some node's card declares it (cap or legacy organ)
  echo "mesh-organ: unknown organ '$1' — no such tool '$(tool_for "$1")' (known: $KNOWN_ORGANS; see mesh-organ --list)" >&2
  exit 1   # caller error (distinct from exit 2 = real organ but all offerers offline)
}

peer_user(){ # registry first (label:user@ip), then conventions
  if [ -f "$HOME/.mesh/nodes" ]; then
    local e; e=$(. "$HOME/.mesh/nodes" 2>/dev/null; for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$e" in *@*) echo "${e%%@*}"; return ;; esac
  fi
  case "$1" in Redmi|phone) echo "${PHONE_USER:-u0_a380}" ;; router|GL-MT3000) echo root ;; *) echo "${SSH_USER:-$(whoami)}" ;; esac
}
peer_ip(){ if [ -f "$HOME/.mesh/nodes" ]; then . "$HOME/.mesh/nodes" 2>/dev/null; for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { local r="${n#*:}"; echo "${r##*@}"; return; }; done; fi; }
peer_port(){ case "$1" in Redmi|phone) echo 8022 ;; *) echo 22 ;; esac; }
short(){ case "$1" in imozerov-IdeaPad-3-15IIL05) echo IdeaPad ;; imozerov-Default-string) echo default-string ;; "Redmi 10") echo Redmi ;; GL-MT3000) echo router ;; *) echo "$1" ;; esac; }

# nodes offering an organ (online, live>0), as hostnames — via the live fleet organ map
offerers(){ local name="$1"
  mesh-organs --json 2>/dev/null | python3 -c "
import json,sys
name='$name'.lower()
for p in json.load(sys.stdin):
    caps=(p.get('senses','')+' '+p.get('actuators','')).lower()
    if name in caps.split() and p.get('live',0)>0:
        print(p['node'])
" 2>/dev/null
}

if [ "${1:-}" = --test ]; then
  for x in ssh python3 mesh-organs; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -n "$(tool_for camera)" ] || { echo "smoke-test: FAIL (tool map broken)"; exit 1; }
  # --where exit 1 = no offerers (valid); only exit >1 = real error
  "$0" --where notify >/dev/null 2>&1; _rc=$?; [ "$_rc" -le 1 ] || { echo "smoke-test: FAIL (--where errored rc=$_rc)"; exit 1; }

  # capability-scoping gate — drive the REAL cap_gate against REAL cap files in a throwaway
  # CAP_DIR (never the live ~/.mesh/caps). Asserts all three arms of the object-capability model:
  # scoped+allowed → RUNS, scoped+unlisted → DENY exit 3, no-header → UNRESTRICTED. A gate whose
  # DENY arm is never exercised is not a gate (mesh doctrine): the exit-3 assertion IS the test.
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  printf '#!/bin/sh\n# cap-allow: genome tg\necho GATED_RAN\n' >"$_td/scopedcap"; chmod +x "$_td/scopedcap"
  printf '#!/bin/sh\necho OPEN_RAN\n'                          >"$_td/opencap";   chmod +x "$_td/opencap"
  _self="$(short "$(hostname)")"
  # arm 1: allowed caller → gate passes → cap actually runs
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_td" "$0" --as genome "scopedcap@$_self" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_o" | grep -q GATED_RAN; } || { echo "smoke-test: FAIL (scoped+allowed did not run: rc=$_rc out=$_o)"; exit 1; }
  # arm 2: unlisted caller → DENY, exit 3, cap must NOT have run
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_td" "$0" --as health "scopedcap@$_self" 2>&1)"; _rc=$?
  { [ "$_rc" = 3 ] && ! printf '%s' "$_o" | grep -q GATED_RAN; } || { echo "smoke-test: FAIL (scoped+unlisted not denied with rc3: rc=$_rc out=$_o)"; exit 1; }
  # arm 3: no cap-allow header → unrestricted → runs for an arbitrary caller
  _o="$(env -u MESH_CALLER MESH_CAP_DIR="$_td" "$0" --as whoever "opencap@$_self" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_o" | grep -q OPEN_RAN; } || { echo "smoke-test: FAIL (unrestricted cap blocked: rc=$_rc out=$_o)"; exit 1; }
  rm -rf "$_td"; trap - EXIT

  echo "smoke-test: ok"; exit 0
fi

case "${1:-}" in
  --manifest)
    echo "=== mesh capability manifest ==="
    printf '%s\n' 'node|senses|actuators|live|total'
    mesh-organs --json 2>/dev/null | python3 -c 'import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for p in data:
    print("{node}|{senses}|{actuators}|{live}|{total}".format(
        node=p.get("node","?"),
        senses=(p.get("senses") or ""),
        actuators=(p.get("actuators") or ""),
        live=p.get("live","?"),
        total=p.get("total","?"),
    ))'
    exit 0 ;;
  --list|"") echo "=== mesh fleet capability map ==="; mesh-organs 2>/dev/null; exit 0 ;;
  --where)   name="${2:?need organ name}"; reject_unknown_organ "$name"; o="$(offerers "$name")"
             if [ -z "$o" ]; then echo "no online node offers '$name'"; exit 0; fi
             echo "$name offered by:"; printf '%s\n' "$o" | while read -r h; do echo "  $(short "$h")"; done; exit 0 ;;
  --scope)   # read-only: print a cap's scope + authorization allow-list, without executing it
             name="${2:?need organ name}"; case "$name" in *@*) tgt="${name##*@}"; name="${name%@*}" ;; *) tgt="$(short "$(hostname)")" ;; esac
             a="$(cap_allow "$tgt" "$name")"
             echo "$name@$tgt: cap-scope=$(cap_scope "$tgt" "$name") cap-allow=${a:-<unrestricted>}"; exit 0 ;;
esac

# --as <role>: the caller names its own agent-context for the scope check (a mind that did not
# export MESH_CALLER can still attribute itself). Consumed before target resolution.
_AS=""; if [ "${1:-}" = --as ]; then _AS="$2"; shift 2; fi
FORCE=""; if [ "${1:-}" = --node ]; then FORCE="$2"; shift 2; fi
if [ "${1:-}" = --as ]; then _AS="$2"; shift 2; fi   # allow --node then --as ordering too
name="${1:?usage: mesh-organ <name>[@<node>] [args] | --list | --where <name> | --node <label> <name>}"; shift || true
# <name>@<node> = explicit instance addressing — the default intent for place-bound caps
# (one speaker is not another). The @node wins over a bare --node only if --node wasn't given.
case "$name" in *@*) [ -z "$FORCE" ] && FORCE="${name##*@}"; name="${name%@*}" ;; esac
reject_unknown_organ "$name"
SELF_SHORT="$(short "$(hostname)")"

# resolve target node
if [ -n "$FORCE" ]; then
  target_short="$FORCE"
else
  hosts="$(offerers "$name")"
  [ -z "$hosts" ] && { echo "mesh-organ: no ONLINE node offers '$name' (try: mesh-organ --list)"; exit 2; }
  n_off=$(printf '%s\n' "$hosts" | grep -c .)
  target_short="$(short "$(printf '%s\n' "$hosts" | head -1)")"
  if [ "$n_off" -gt 1 ]; then
    # multiple offerers + no explicit instance: fungible → route to any (failover); place-bound
    # → refuse and make the caller name the instance (the 3-voices case).
    if [ "$(cap_scope "$target_short" "$name")" != fungible ]; then
      echo "mesh-organ: '$name' is place-bound and $n_off nodes offer it — name the instance: $name@<node>" >&2
      printf '%s\n' "$hosts" | while read -r h; do echo "  $name@$(short "$h")" >&2; done
      exit 1
    fi
  fi
fi

tool="$(tool_for "$name")"
# Pure router: invoke the capability by its PATH on the chosen node — a caps/<name> executable
# if present (filename IS the name; secrets stay inside it), else the legacy mesh-<tool>. No
# special provider verb; the path is the resolution.
cap_gate "$target_short" "$name"   # runtime authorization scope check — DENY (exit 3) before any exec
if [ "$target_short" = "$SELF_SHORT" ]; then
  if is_cap_local "$name"; then echo "[mesh-organ] $name → local (caps/$name)"; exec "$CAP_DIR/$name" "$@"; fi
  echo "[mesh-organ] $name → local ($tool)"; exec "$HOME/.local/bin/$tool" "$@"
fi
user="$(peer_user "$target_short")"; ip="$(peer_ip "$target_short")"; port="$(peer_port "$target_short")"
[ -z "$ip" ] && { echo "mesh-organ: can't resolve address for '$target_short' (not in ~/.mesh/nodes)"; exit 2; }
echo "[mesh-organ] $name → $target_short ($user@$ip)"
opts=(-o ConnectTimeout=6 -o BatchMode=yes -o StrictHostKeyChecking=accept-new); [ "$port" != 22 ] && opts+=(-p "$port")
ssh "${opts[@]}" "$user@$ip" \
  "p=\"\$HOME/.mesh/caps/$name\"; if [ -x \"\$p\" ]; then exec \"\$p\" $*; else exec \"\$HOME/.local/bin/$tool\" $*; fi" 2>&1 </dev/null
