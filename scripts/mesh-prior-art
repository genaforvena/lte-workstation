#!/usr/bin/env bash
# mesh-prior-art — pre-file novelty gate: has the mesh already catalogued this thing?
#
# Why it exists: a discover pass "verified novelty" by grepping scripts/+docs/ only, so the same
# device was re-filed as a FRESH find four times in a week (07-15/07-18/07-20/07-21) — the prior
# filings lived in ~/.mesh/knowledge/ and on the board, the two surfaces the check never read.
# ([task] discover-novelty-check-misses-own-knowledge-ledger, 2026-07-21.) This tool is the ONE
# mechanical check across all four surfaces: knowledge ledger, chat board, scripts/, docs/.
#
#   mesh-prior-art <term> [term...]   term = the thing's unique identifier: VID:PID, MAC,
#                                     hostname, model string, slug words. Fixed strings,
#                                     case-insensitive; a WHOLE-TOKEN hit on ANY term is prior art.
#   mesh-prior-art --test             smoke test (fixture-driven, isolated)
#
# The verdict is GRADED, not collapsed (2026-08-16 — see the whole-token post-filter below):
# exit 0 = PRIOR ART  — a WHOLE-TOKEN hit: cite/supersede the newest hit, do not re-file as fresh
# exit 0 = NEAR-MATCH — no exact phrase, but all the term's words are catalogued together, reworded.
#                       The words must EARN that verdict (2026-08-21): each is matched as a token
#                       PREFIX (never an infix — `oom` is not `room`), and a surface is re-scanned
#                       only while chance co-presence there stays below one record. A surface that
#                       fails that says so out loud with its live calibration; it is never dropped.
# exit 1 = WEAK       — the term matched only INSIDE longer words ('edac ⊂ redaction'). Not prior art.
#                       The collisions are printed so they can be dismissed at a glance, and the rc is
#                       the file-it code: a scripted caller reads the rc, not the prose.
# exit 1 = CLEAN      — no match at all on any surface
# exit 2 = usage
#
# The scripts/ sweep excludes THIS file: the header above names past incidents, and a gate that
# matches its own text asserts nothing (the self-grep family, 1969a5d).
# orphan-ok: on-demand pre-file check run by minds (wired into the discover baton duty + tick
# nudge + discover dash), deliberately not scheduled.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
KDIR="${MESH_KNOWLEDGE_DIR:-$MESH/knowledge}"
CHAT="${MESH_CHAT_LOG:-$MESH/chat.log}"
REPO="${MESH_REPO:-$HOME/lte-workstation}"

usage() { echo "usage: mesh-prior-art <term> [term...]   (VID:PID / MAC / name — any hit = prior art)" >&2; }

# ── NEAR-MATCH helpers (2026-07-25) ────────────────────────────────────────────────────────────
# All three surface scans are `grep -F` — ONE literal string. A MULTI-WORD term therefore hits only
# where the catalogue used that exact wording, so a thing already filed under different phrasing
# reads CLEAN: the precise false verdict this gate exists to prevent. Measured live:
# `mesh-prior-art "BLE advertise beacon"` → CLEAN, while
# knowledge/capability-ble-peripheral-advertising-outward-actuator-mesh-home-20260721.md (filed 4
# days earlier) carries BLE x12, advertise x8, beacon x2 — every word, none of the phrase. And the
# gate's own --test only ever asked single-token terms (VID:PID, one slug), so the case minds
# ACTUALLY type — the dash says "name" — was never exercised.
# Cost asymmetry decides the policy: a false CLEAN re-files a known thing (the 4x incident this
# tool was built for); a false NEAR-MATCH costs one file read. So when the phrase finds nothing,
# rescan for files/lines carrying ALL the term's words in ANY order, and say so LOUDLY.

# ── DISCRIMINATIVENESS OF THE SPLIT WORDS (2026-08-21) ─────────────────────────────────────────
# The slug split further down is load-bearing and STAYS (it is how minds actually type an
# identifier). What it does not establish is that the split words carry EVIDENCE. Measured live:
# `mesh-prior-art oom_score` answered NEAR-MATCH — rc 0, the STOP code — with ZERO whole-token hits
# on any of the three surfaces, citing 8 ledger files about Bayesian model reduction, epistemic
# value and circular inference. Two independent causes, both fixed here:
#
#  1. THE RESCAN MATCHED SUBSTRINGS. Both helpers below were `grep -Fi`, so `oom` matched inside
#     `room` (193 of 847 ledger files) and `ble` inside `able`/`table`/`possible` (743 of 847 — the
#     single commonest "word" in the corpus). That is the `edac ⊂ redaction` shape the 08-16
#     post-filter exists for, on the one path the post-filter never covered.
#     The fix is NOT that post-filter: the rescan's whole job is to see REWORDINGS — `advertise`
#     inside `advertising`, `wake` inside `wake-alarm`/`wakealarm` — and a whole-token rule kills
#     BOTH documented near-match cases. So a word must START AT A TOKEN BOUNDARY and may run on: a
#     prefix, not a substring, not a whole token. Anchoring costs the good cases nothing (advertise
#     23→23, beacon 44→44, alarm 116→116) and guts the accidents (oom 193→28, ble 743→138).
#
#  2. CO-PRESENCE OF COMMON WORDS IS NOT EVIDENCE. Anchoring alone still leaves `sense_score` on 35
#     ledger files and `mem_pressure` on 24. A PER-WORD frequency floor cannot be the fix, and the
#     live corpus is what says so: `score` sits in 52 of 847 files and `beacon` in 44, so any floor
#     that drops the noise word also drops the word the documented BLE case depends on. What
#     separates them is the JOINT — how many records would carry ALL the words together BY CHANCE,
#     N·Π(df_i/N). Below one record a hit is surprising, so it is evidence; at or above one record
#     the corpus is EXPECTED to produce such a record with no relation at all, so the hit says
#     nothing and must not mint a verdict. The floor is ONE RECORD: not a tuned constant but the
#     point where accidental co-presence becomes expected, and every quantity in it (N and each df)
#     is re-measured from the live corpus on every run — so it cannot rot as the ledger grows. It
#     gets STRICTER as the corpus grows, which is the correct direction: a bigger corpus makes
#     accidents likelier. Each surface is calibrated against ITS OWN corpus (files for the ledger
#     and the genome, LINES for the board, which is a log and not a corpus).
#     Measured 2026-08-21, RE-DERIVE and never quote: oom_score 1.72 REJECT · sense_score 25.1
#     REJECT · mem_pressure 13.9 REJECT · cpu_usage 4.08 REJECT || rtc-wake-alarm 0.11 KEEP ·
#     rtc0-wakealarm 0.005 KEEP · "BLE advertise beacon" 0.20 KEEP.
#     (doctrine: a-common-word-slug-manufactures-citation-edges — presence is not evidence unless
#     the form is arbitrary; and no-silent-caps — a rejected surface SAYS SO, with its number.)
#
# NEAR-MATCH helpers (2026-07-25) ──────────────────────────────────────────────────────────────

# a split word anchored to a token START; it may run on (rewording/stemming is the point). The word
# is ERE-escaped, so a `.` in it can never act as a wildcard. `-` `_` `.` are BOUNDARIES here — the
# opposite of the phrase scan's id-preserving alphabet, and deliberately so: the term was already
# split on them to get here, so this is a question about WORDS, not about identifiers.
anchored_re() {
  printf '(^|[^a-zA-Z0-9])%s' "$(printf '%s' "$1" | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
}

# files under ROOTS containing ALL words (any order) — $1=extra grep opts, $2=roots, $3..=words
files_all_words() {
  local opts="$1" roots="$2"; shift 2
  local -a cand=(); local w first=1
  for w in "$@"; do
    if [ "$first" = 1 ]; then
      set -f  # $opts carries --include='*.md'; unquoted expansion must NOT glob against cwd
      mapfile -t cand < <(grep -ErilI $opts -- "$(anchored_re "$w")" $roots 2>/dev/null | sort)
      set +f; first=0
    else
      [ "${#cand[@]}" -gt 0 ] || return 0
      mapfile -t cand < <(printf '%s\n' "${cand[@]}" | tr '\n' '\0' | xargs -0 -r grep -EilI -- "$(anchored_re "$w")" 2>/dev/null | sort)
    fi
  done
  [ "${#cand[@]}" -gt 0 ] && printf '%s\n' "${cand[@]}"
  return 0
}

# lines of FILE containing ALL words (any order) — $1=file, $2..=words
lines_all_words() {
  local f="$1"; shift
  local out w
  out="$(cat "$f" 2>/dev/null)" || return 0
  for w in "$@"; do
    out="$(printf '%s\n' "$out" | grep -Ei -- "$(anchored_re "$w")")" || return 0
  done
  printf '%s\n' "$out"
}

# expected number of FILES under ROOTS carrying all the words by chance: N · Π(df_i/N).
# echoes "<expected> <N>" — the caller prints the number; a surface is never dropped silently.
chance_files() {  # $1=opts $2=roots $3..=words
  local opts="$1" roots="$2"; shift 2
  local n exp w df
  set -f
  n="$(grep -rlI $opts -e '' -- $roots 2>/dev/null | wc -l | tr -d ' ')"
  if [ "${n:-0}" -le 0 ]; then set +f; echo "0 0"; return 0; fi
  exp="$n"
  for w in "$@"; do
    df="$(grep -ErilI $opts -- "$(anchored_re "$w")" $roots 2>/dev/null | wc -l | tr -d ' ')"
    exp="$(awk -v e="$exp" -v d="${df:-0}" -v n="$n" 'BEGIN{ printf "%.4f", e*d/n }')"
  done
  set +f
  echo "$exp $n"
}

# same, for the board — the record is a LINE, not a file.
chance_lines() {  # $1=file $2..=words
  local f="$1"; shift
  local n exp w df
  n="$(wc -l < "$f" 2>/dev/null | tr -d ' ')"
  if [ "${n:-0}" -le 0 ]; then echo "0 0"; return 0; fi
  exp="$n"
  for w in "$@"; do
    df="$(grep -EicI -- "$(anchored_re "$w")" "$f" 2>/dev/null || true)"
    exp="$(awk -v e="$exp" -v d="${df:-0}" -v n="$n" 'BEGIN{ printf "%.4f", e*d/n }')"
  done
  echo "$exp $n"
}

# is chance co-presence below ONE record? ($1 = expected count)
discriminating() { awk -v e="${1:-0}" 'BEGIN{ exit !(e + 0 < 1) }'; }

# the loud refusal — a surface whose words carry no evidence says so, with its calibration
say_undisc() {  # $1=label $2=expected $3=N $4..=words
  local label="$1" e="$2" n="$3"; shift 3
  local joined; joined="$(printf '%s,' "$@")"; joined="{${joined%,}}"
  printf '  near-match rescan REFUSED on %s: %s is not discriminating there — chance alone puts all %d word(s) together in %s of %s record(s), and the floor is <1. Co-presence of words this common is not evidence of a filing.\n' \
    "$label" "$joined" "$#" "$e" "$n"
}

# ── WHOLE-TOKEN POST-FILTER (2026-08-16) ────────────────────────────────────────────────────────
# All three surface scans are `grep -F`: fixed-string, case-insensitive, NO word boundary. The -F is
# CORRECT for the candidate scan — ids carry regex-hostile chars (046d:0825, MACs, dotted slugs) — but
# the same substring match was ALSO the verdict, so a short kernel/driver id matched inside longer
# unrelated words and rendered the STOP verdict. Measured on this tree 2026-08-16 (re-derive, never
# quote — the counts move as scripts/+docs/ grow): edac ⊂ redaction (mesh-log-scrub), mce ⊂ McEwen,
# ras ⊂ Infrastructure, tc ⊂ catch, sar ⊂ DISARM, psi ⊂ collapsing, lm ⊂ overwhelming. It fired on a
# finder mid-pass: `mesh-prior-art edac` answered PRIOR ART citing a log-scrubbing tool, and the loop
# prompt makes obeying that verdict mandatory. A false CLEAN loses one filing; a false PRIOR ART loses
# the FIND and teaches the finder the frontier is drier than it is, with a citation attached.
#
# The fix is NOT `grep -w`: -w's word class is [A-Za-z0-9_], so it would break the ids this gate exists
# to check — 046d:0825, rtc-wake-alarm and mesh-psi-attrib would stop matching themselves, and `psi`
# would count as a whole word inside `mesh-psi-attrib`. So: keep -Fril as the CANDIDATE scan, then
# post-filter each candidate for a WHOLE-TOKEN occurrence with the alphabet the MESH's ids actually
# use — `-` `_` `.` `:` are INSIDE identifiers and therefore NOT boundaries.
# (doctrine: a-guards-alphabet-must-match-its-patterns.)
#
# The term is passed through the ENVIRONMENT, never `awk -v`: -v processes backslash escapes in the
# value, so a term carrying one would be silently altered before it was ever compared
# (doctrine: awk-v-eats-the-regex-backslashes). And the comparison is index()-based, not a regex, so
# NOTHING in the term is ever interpreted — no escaping table to get wrong.
TOK_FUNCS='
function tokchar(c) { return (c != "" && c ~ /[A-Za-z0-9_]/) }
# `-` `.` `:` JOIN an identifier only when a character continues it on the far side. A trailing dot is
# sentence punctuation, not part of the id: without this, `mesh-prior-art 192.168.8.225` reads WEAK
# against prose that ends "... at 192.168.8.225." — the check going soft on exactly the ids it exists
# to check. Adjacency alone is not membership; what makes the joiner part of the token is what follows it.
function joiner(c) { return (c == "-" || c == "." || c == ":") }
function inside_l(s, i) {
  if (i < 1) return 0
  if (tokchar(substr(s, i, 1))) return 1
  if (joiner(substr(s, i, 1))) return (i >= 2 && tokchar(substr(s, i - 1, 1)))
  return 0
}
function inside_r(s, i) {
  if (i > length(s)) return 0
  if (tokchar(substr(s, i, 1))) return 1
  if (joiner(substr(s, i, 1))) return tokchar(substr(s, i + 1, 1))
  return 0
}
function cword(s, p, n,   st, en) {
  st = p; while (inside_l(s, st - 1)) st--
  en = p + n - 1; while (inside_r(s, en + 1)) en++
  return substr(s, st, en - st + 1)
}
BEGIN { t = tolower(ENVIRON["PA_TERM"]); n = length(t); if (n == 0) exit }
'

# classify_files <term> <newline-separated candidate files>
#   emits  "W<TAB><file>"                 whole-token hit
#          "S<TAB><file><TAB><word>"      substring-only, with the word that swallowed the term
classify_files() {
  local term="$1" files="$2"
  [ -n "$files" ] || return 0
  printf '%s\n' "$files" | tr '\n' '\0' | PA_TERM="$term" xargs -0 -r awk "$TOK_FUNCS"'
    {
      line = tolower($0); pos = 0
      while ((i = index(substr(line, pos + 1), t)) > 0) {
        p = pos + i
        if (inside_l(line, p - 1) || inside_r(line, p + n)) {
          if (!(FILENAME in ww)) ww[FILENAME] = cword($0, p, n)
          wk[FILENAME] = 1
        } else whole[FILENAME] = 1
        pos = p
      }
    }
    END { for (f in whole) printf "W\t%s\n", f
          for (f in wk) if (!(f in whole)) printf "S\t%s\t%s\n", f, ww[f] }' 2>/dev/null
}

# classify_lines <term> <file>  — same grading, one record per LINE (the board is a log, not a corpus)
classify_lines() {
  local term="$1" f="$2"
  [ -r "$f" ] || return 0
  PA_TERM="$term" awk "$TOK_FUNCS"'
    {
      line = tolower($0); pos = 0; w = 0; sw = ""
      while ((i = index(substr(line, pos + 1), t)) > 0) {
        p = pos + i
        if (inside_l(line, p - 1) || inside_r(line, p + n)) {
          if (sw == "") sw = cword($0, p, n)
        } else w = 1
        pos = p
      }
      if (w) printf "W\t%s\n", $0
      else if (sw != "") printf "S\t%s\t%s\n", sw, $0
    }' "$f" 2>/dev/null
}

# the substring-only evidence block: LOUD enough to dismiss in one look, capped with its TRUE total
# announced (no silent truncation — the 2026-07-22 rule applies to this surface too).
show_weak() {  # $1 = term, $2 = surface label, $3 = rows "<word><TAB><where>", $4 = TRUE total (opt)
  local term="$1" label="$2" rows="$3" tot cap
  [ -n "$rows" ] || return 0
  # the true total is passed in wherever the caller retained only a tail of the matches — a count
  # taken from the retained rows would announce a cap while silently hiding a larger one (the
  # 2026-07-22 rule: any cap is announced LOUDLY, against the FULL match set).
  tot="${4:-}"
  [ -n "$tot" ] || tot="$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
  cap="${MESH_PRIOR_ART_WEAK_MAX:-5}"
  if [ "$tot" -gt "$cap" ]; then
    echo "  $label: $tot substring-only collision(s), showing $cap of $tot:"
  else
    echo "  $label: $tot substring-only collision(s):"
  fi
  printf '%s\n' "$rows" | head -"$cap" | while IFS="$(printf '\t')" read -r word where; do
    printf '    %s ⊂ %s   %s\n' "$term" "${word:-?}" "${where:-?}"
  done
}

scan() {
  local found=0 near=0 weak=0 tfound term undisc khits chits rhits kweak cweak cweak_all cweak_n rweak kall kcls ccls rcls rcand
  for term in "$@"; do
    tfound=0
    echo "== prior-art: $term =="
    # knowledge ledger — the tier the 4x re-discovery never checked
    kall="$(grep -FrilI --include='*.md' -- "$term" "$KDIR" 2>/dev/null | sort)"
    kcls="$(classify_files "$term" "$kall")"
    khits="$(printf '%s\n' "$kcls" | awk -F'\t' '$1 == "W" { print $2 }' | sort | tail -8)"
    kweak="$(printf '%s\n' "$kcls" | awk -F'\t' '$1 == "S" { printf "%s\t%s\n", $3, $2 }' | sort -u)"
    if [ -n "$khits" ]; then
      found=1; tfound=1
      echo "knowledge/ ($(printf '%s\n' "$khits" | wc -l)):"
      printf '%s\n' "$khits" | while IFS= read -r f; do echo "  $(basename "$f")"; done
    else
      echo "knowledge/ (0 whole-token)"
    fi
    if [ -n "$kweak" ]; then weak=1; show_weak "$term" "knowledge/" "$(printf '%s\n' "$kweak" | while IFS="$(printf '\t')" read -r w f; do printf '%s\t%s\n' "$w" "$(basename "$f")"; done)"; fi
    # board history — filings + discussion both count as prior art
    ccls="$(classify_lines "$term" "$CHAT")"
    chits="$(printf '%s\n' "$ccls" | awk -F'\t' '$1 == "W" { print $2 }' | tail -3)"
    cweak_all="$(printf '%s\n' "$ccls" | awk -F'\t' '$1 == "S" { printf "%s\t%s\n", $2, substr($3, 1, 90) }')"
    cweak_n="$(printf '%s' "$cweak_all" | grep -c . || true)"
    cweak="$(printf '%s\n' "$cweak_all" | tail -20)"
    if [ -n "$chits" ]; then
      found=1; tfound=1
      echo "chat.log (newest 3):"
      printf '%s\n' "$chits" | cut -c1-160 | sed 's/^/  /'
    else
      echo "chat.log (0 whole-token)"
    fi
    if [ "${cweak_n:-0}" -gt 0 ]; then weak=1; show_weak "$term" "chat.log" "$cweak" "$cweak_n"; fi
    # genome surfaces (what the old check DID read — kept so this is the one gate)
    # NO SILENT TRUNCATION: the total is counted from the FULL match set, and any cap is announced LOUDLY
    # (the 2026-07-22 miss — 'sort | tail -5' hid mesh-note3-prox, which sorts early, and reported 5 as the
    # total, so discover re-built an already-wired proximity sense). Cap is generous (default 40 → normal
    # prior-art checks show every filename) and, when it bites, shows the alphabetically-FIRST hits via head
    # (deterministic, never silently drops an early-sorting relevant match) with the TRUE total + a refine hint.
    # -I: a BINARY is not a catalogue entry. Without it, random bytes in scripts/uxn/bin/uxncli.arm64
    # and docs/board.png read as whole-token hits — and for `ras` that binary was the ONLY whole-token
    # hit on this tree, i.e. it alone decided PRIOR ART vs WEAK. (Pre-existing in the -F scan; it only
    # became verdict-critical once the verdict stopped collapsing every substring into a stop.)
    rcand="$(grep -FrilI --exclude='mesh-prior-art' -- "$term" "$REPO/scripts" "$REPO/docs" 2>/dev/null | sort)"
    rcls="$(classify_files "$term" "$rcand")"
    rall="$(printf '%s\n' "$rcls" | awk -F'\t' '$1 == "W" { print $2 }' | sort)"
    rweak="$(printf '%s\n' "$rcls" | awk -F'\t' '$1 == "S" { printf "%s\t%s\n", $3, $2 }' | sort -u)"
    if [ -n "$rall" ]; then
      found=1; tfound=1
      rtot="$(printf '%s\n' "$rall" | wc -l | tr -d ' ')"
      rcap="${MESH_PRIOR_ART_MAX:-40}"
      if [ "$rtot" -gt "$rcap" ]; then
        echo "scripts+docs ($rtot, showing first $rcap — refine the term):"
        rhits="$(printf '%s\n' "$rall" | head -"$rcap")"
      else
        echo "scripts+docs ($rtot):"
        rhits="$rall"
      fi
      printf '%s\n' "$rhits" | while IFS= read -r f; do echo "  ${f#"$REPO"/}"; done
    else
      echo "scripts+docs (0 whole-token)"
    fi
    if [ -n "$rweak" ]; then weak=1; show_weak "$term" "scripts+docs" "$(printf '%s\n' "$rweak" | while IFS="$(printf '\t')" read -r w f; do printf '%s\t%s\n' "$w" "${f#"$REPO"/}"; done)"; fi

    # near-match: ask the weaker question the -F scan cannot ("are all these words already
    # catalogued together, worded differently?"). TWO triggers, not one:
    #   tfound=0   the term would otherwise read CLEAN — ask all three surfaces before letting it.
    #   khits=""   the phrase hit only the WEAK surfaces (board / scripts+docs) while the KNOWLEDGE
    #              ledger — the authoritative tier, the one whose absence caused the 4x re-filing —
    #              reported (0). Measured 2026-07-25: `mesh-prior-art "BLE advertise beacon"` prints
    #              "knowledge/ (0)" and verdict PRIOR ART citing two board posts that are the mesh
    #              discussing THIS GATE, while three knowledge files carry all three words, incl. the
    #              correct citation capability-ble-peripheral-advertising-outward-actuator-...-20260721.md.
    #              The verdict was right and the CITE was wrong — and the verdict line says
    #              "cite/supersede the newest hit above", so the mind is sent to a chat line instead of
    #              the capability file. A hit on the weakest surface must never suppress the strongest
    #              surface's reworded evidence. (This is also why the near-match fix could not be
    #              demonstrated on its own example: discover's 00:57Z [fyi] put the literal phrase on
    #              the board, so the phrase scan hit chat.log and the rescan never ran — health, 01:20Z.)
    # In the khits="" case the BOARD is deliberately not re-mined: it already produced the phrase hit,
    # re-printing those lines is noise, and it is the surface minds pollute with meta-discussion of
    # this very tool. Single-token terms are skipped either way: phrase == word, nothing to add.
    if [ "$tfound" = 0 ] || [ -z "$khits" ]; then
      local -a ws=(); local w nk nc nr
      # A SLUG IS HOW MINDS ACTUALLY TYPE AN IDENTIFIER, and the 07-25 near-match could not see one.
      # The old class preserved `-` `_`, so a hyphen-joined term was ONE word, `${#ws[@]} >= 2` was
      # false, and the rescan NEVER RAN — the fix for "different phrasing" was dead for precisely the
      # phrasing the dash itself prints (`capability-rtc-hw-wake`, `[task] <slug>`). Measured live
      # 2026-08-03: `mesh-prior-art rtc-wake-alarm` / `rtc0-wakealarm` both read CLEAN while
      # knowledge/capability-rtc-hardware-wake-alarm-mesh-home-20260721.md (13 days older, same node,
      # same device, same "a scheduler that doesn't need the OS running" framing) carried every word
      # — so the capability was re-filed as a FRESH find and re-verified by a second window. That is
      # the 4x-re-discovery incident this whole tool exists to stop, recurring THROUGH the tool.
      # Split on `-` `_` `/` too; keep `.` and `:` ATOMIC so an IP (192.168.8.225) and a VID:PID /
      # colon-MAC stay single identifiers. The >=3 filter below is what makes a dashed MAC safe:
      # aa-bb-cc-dd-ee-ff yields only 2-char parts, so ws is empty and no rescan is manufactured
      # out of hex pairs.
      set -f; for w in $(printf '%s' "$term" | tr -c '[:alnum:]:.' ' '); do
        [ "${#w}" -ge 3 ] && ws+=("$w")
      done; set +f
      if [ "${#ws[@]}" -ge 2 ]; then
        # Each surface earns its rescan by its OWN corpus: the words must be rare enough there that
        # chance alone would not already put them together in a record. Never a silent drop — a
        # refused surface prints its calibration, and a surface that PASSES publishes the number it
        # passed on, so the reader can weigh the citation instead of trusting the label.
        local ek en cek cen rek ren nk_n nc_n nr_n
        read -r ek en < <(chance_files "--include=*.md" "$KDIR" "${ws[@]}")
        read -r rek ren < <(chance_files "--exclude=mesh-prior-art" "$REPO/scripts $REPO/docs" "${ws[@]}")
        nk=""; nc=""; nr=""; undisc=""
        if discriminating "$ek"; then nk="$(files_all_words "--include=*.md" "$KDIR" "${ws[@]}")"
        else undisc="$undisc$(say_undisc "knowledge/" "$ek" "$en" "${ws[@]}")"$'\n'; fi
        if discriminating "$rek"; then nr="$(files_all_words "--exclude=mesh-prior-art" "$REPO/scripts $REPO/docs" "${ws[@]}")"
        else undisc="$undisc$(say_undisc "scripts+docs" "$rek" "$ren" "${ws[@]}")"$'\n'; fi
        if [ "$tfound" = 0 ]; then
          read -r cek cen < <(chance_lines "$CHAT" "${ws[@]}")
          if discriminating "$cek"; then nc="$(lines_all_words "$CHAT" "${ws[@]}")"
          else undisc="$undisc$(say_undisc "chat.log" "$cek" "$cen" "${ws[@]}")"$'\n'; fi
        fi
        if [ -n "$nk$nc$nr" ]; then
          near=1
          echo "NEAR-MATCH (all words, different phrasing — the -F phrase scan above cannot see these):"
          # totals are counted from the FULL hit set and the cap is announced (the 2026-07-22 rule
          # applies here too — the oom_score false verdict printed exactly 8 ledger files and 8
          # genome files with no total, so a shotgun read as a short, specific citation).
          if [ -n "$nk" ]; then
            nk_n="$(printf '%s\n' "$nk" | wc -l | tr -d ' ')"
            [ "$nk_n" -gt 8 ] && echo "  knowledge/ ($nk_n, showing newest 8 — chance would give $ek of $en):" || echo "  knowledge/ ($nk_n — chance would give $ek of $en):"
            printf '%s\n' "$nk" | tail -8 | while IFS= read -r f; do echo "    $(basename "$f")"; done
          fi
          if [ -n "$nc" ]; then
            nc_n="$(printf '%s\n' "$nc" | wc -l | tr -d ' ')"
            [ "$nc_n" -gt 3 ] && echo "  chat.log ($nc_n, showing newest 3 — chance would give $cek of $cen lines):" || echo "  chat.log ($nc_n — chance would give $cek of $cen lines):"
            printf '%s\n' "$nc" | tail -3 | cut -c1-160 | sed 's/^/    /'
          fi
          if [ -n "$nr" ]; then
            nr_n="$(printf '%s\n' "$nr" | wc -l | tr -d ' ')"
            [ "$nr_n" -gt 8 ] && echo "  scripts+docs ($nr_n, showing first 8 — chance would give $rek of $ren):" || echo "  scripts+docs ($nr_n — chance would give $rek of $ren):"
            printf '%s\n' "$nr" | head -8 | while IFS= read -r f; do echo "    ${f#"$REPO"/}"; done
          fi
        fi
        [ -n "$undisc" ] && printf '%s' "$undisc"
      fi
    fi
  done
  if [ "$found" = 1 ]; then
    echo "verdict: PRIOR ART — cite/supersede the newest hit above ([fyi] 'already catalogued, see X'), do not re-file as fresh"
    return 0
  fi
  if [ "$near" = 1 ]; then
    echo "verdict: NEAR-MATCH — no exact phrase, but the words are already catalogued together above. READ those before filing; if your thing is genuinely different, say so IN the filing (cite what it is not)."
    return 0
  fi
  # GRADED, not collapsed. A substring-only hit is EVIDENCE THE FINDER CAN DISMISS IN ONE LOOK, and it
  # must never carry the stop verdict's exit code: rc 0 means "already catalogued, do not file", and a
  # scripted caller reads the rc, not the prose. So substring-only returns the FILE-IT code, loudly.
  if [ "$weak" = 1 ]; then
    echo "verdict: WEAK — no WHOLE-TOKEN hit on any surface; every match above is this term sitting inside a longer word (shown as 'term ⊂ word'). This is NOT prior art and does NOT suppress filing — glance at the collisions, then file."
    return 1
  fi
  echo "verdict: CLEAN — no prior art for: $*"
  return 1
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  fail=0
  mkdir -p "$td/knowledge" "$td/repo/scripts" "$td/repo/docs"
  cat > "$td/knowledge/capability-fixture-widget-20260720.md" <<'EOF'
# capability: fixture widget (VID:PID 9999:abcd)
Latent actuator, catalogued 2026-07-20.
EOF
  printf '2026-07-20T10:00:00Z  discover@node  ::  [task] fixture widget 9999:abcd catalogued\n' > "$td/chat.log"

  run() { MESH_KNOWLEDGE_DIR="$td/knowledge" MESH_CHAT_LOG="$td/chat.log" MESH_REPO="$td/repo" "$0" "$@"; }

  # 1. a catalogued identifier is PRIOR ART (exit 0) and the hit names the ledger file
  out="$(run 9999:abcd)"; rc=$?
  [ "$rc" = 0 ] || { echo "FAIL: catalogued term rc=$rc (want 0)"; fail=1; }
  case "$out" in *capability-fixture-widget-20260720.md*) :;; *) echo "FAIL: hit does not cite the knowledge file"; fail=1;; esac
  case "$out" in *"PRIOR ART"*) :;; *) echo "FAIL: no PRIOR ART verdict"; fail=1;; esac

  # 2. a board-only mention (no knowledge file) is still prior art
  printf '2026-07-21T11:00:00Z  chat@node  ::  [fyi] board-only-token-77 discussed\n' >> "$td/chat.log"
  run board-only-token-77 >/dev/null; rc=$?
  [ "$rc" = 0 ] || { echo "FAIL: board-only term rc=$rc (want 0)"; fail=1; }

  # 3. an unknown identifier is CLEAN (exit 1)
  out="$(run zz-no-such-token-zz)"; rc=$?
  [ "$rc" = 1 ] || { echo "FAIL: novel term rc=$rc (want 1)"; fail=1; }
  case "$out" in *CLEAN*) :;; *) echo "FAIL: no CLEAN verdict on novel term"; fail=1;; esac

  # 4. multi-term: ANY hit wins (novel + catalogued together = prior art)
  run zz-no-such-token-zz 9999:abcd >/dev/null; rc=$?
  [ "$rc" = 0 ] || { echo "FAIL: multi-term with one hit rc=$rc (want 0)"; fail=1; }

  # 5. usage: no args
  "$0" >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "FAIL: no-args rc=$rc (want 2)"; fail=1; }

  # 6. NO SILENT TRUNCATION of the scripts+docs surface (the 2026-07-22 miss: 'sort | tail -5' hid
  #    mesh-note3-prox — which sorts EARLY — for every proximity term, and wc -l reported 5 as the total,
  #    so discover re-built an already-wired capability). RED-first: 6 files match a term, the truly-relevant
  #    one sorts alphabetically FIRST; under the old 'tail -5' it is dropped and the count reads 5. Assert the
  #    first-sorting match STILL appears AND the TRUE total (6) is printed. Cap forced small to exercise >cap.
  for n in aaa-relevant bbb ccc ddd eee fff; do
    printf '# xyzuniqterm marker\n' > "$td/repo/scripts/${n}.sh"
  done
  out="$(MESH_PRIOR_ART_MAX=5 run xyzuniqterm)"; rc=$?
  case "$out" in *aaa-relevant.sh*) :;; *) echo "FAIL: truncation dropped the alphabetically-first relevant hit (aaa-relevant.sh)"; fail=1;; esac
  case "$out" in *"scripts+docs (6"*) :;; *) echo "FAIL: scripts+docs count reports the truncated length, not the true total (6)"; fail=1;; esac

  # 7. NEAR-MATCH: a MULTI-WORD term whose words are all catalogued under DIFFERENT phrasing must
  #    NOT read CLEAN (2026-07-25 measured false verdict: "BLE advertise beacon" → CLEAN while the
  #    capability file filed 4 days earlier carried BLE/advertise/beacon). Every fixture above uses
  #    a single token — the case minds actually type ("name", per the dash) was untested.
  cat > "$td/knowledge/capability-fixture-radio-20260722.md" <<'EOF'
# capability: radio broadcast mode (fixture)
The widget can BROADCAST a beacon payload over its own radio, advertising-style.
EOF
  out="$(run "beacon broadcast radio")"; rc=$?
  case "$out" in *"NEAR-MATCH"*) :;; *) echo "FAIL: reworded catalogued thing read as CLEAN (near-match scan dead)"; fail=1;; esac
  case "$out" in *capability-fixture-radio-20260722.md*) :;; *) echo "FAIL: near-match does not cite the ledger file it found"; fail=1;; esac
  [ "$rc" = 0 ] || { echo "FAIL: near-match rc=$rc (want 0 — not-clean)"; fail=1; }

  # 8. NEAR-MATCH must not cry wolf: a genuinely novel multi-word term stays CLEAN (exit 1). A gate
  #    that flags everything is ignored, which is the same outcome as no gate.
  out="$(run "zzqqx-nothing zzqqy-either")"; rc=$?
  case "$out" in *CLEAN*) :;; *) echo "FAIL: novel multi-word term did not read CLEAN"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: novel multi-word rc=$rc (want 1)"; fail=1; }

  # 9. an EXACT phrase hit still reports PRIOR ART, never demoted to the weaker NEAR-MATCH label
  out="$(run "fixture widget")"
  case "$out" in *"PRIOR ART"*) :;; *) echo "FAIL: exact multi-word phrase hit lost its PRIOR ART verdict"; fail=1;; esac

  # 10. A PHRASE HIT ON A WEAK SURFACE MUST NOT HIDE THE KNOWLEDGE LEDGER'S REWORDED FILING.
  #     Measured live 2026-07-25: `mesh-prior-art "BLE advertise beacon"` → "knowledge/ (0)" +
  #     PRIOR ART citing two board posts (the mesh discussing this very gate), while three knowledge
  #     files carried all three words including the right citation. Verdict right, CITE wrong — and
  #     the verdict line orders the mind to "cite/supersede the newest hit above". Fixture reproduces
  #     it exactly: the phrase exists ONLY on the board; the knowledge file has all the words,
  #     reworded. RED-first — with the trigger back at `tfound = 0` this cannot cite the file.
  printf '2026-07-24T09:00:00Z  discover@node  ::  [fyi] looking at sonar chirp probe as a new find\n' >> "$td/chat.log"
  cat > "$td/knowledge/capability-fixture-sonar-20260723.md" <<'EOF'
# capability: ultrasonic ranging (fixture)
Emits a chirp and listens for the echo; the sonar head is probed over I2C.
EOF
  out="$(run "sonar chirp probe")"; rc=$?
  case "$out" in *"PRIOR ART"*) :;; *) echo "FAIL: weak-surface phrase hit lost its PRIOR ART verdict"; fail=1;; esac
  case "$out" in *capability-fixture-sonar-20260723.md*) :;; *) echo "FAIL: board-only phrase hit hid the knowledge ledger's reworded filing (the cite the mind is told to supersede)"; fail=1;; esac
  [ "$rc" = 0 ] || { echo "FAIL: weak-surface phrase hit rc=$rc (want 0)"; fail=1; }
  #     ...and the board is NOT re-mined in that case: it already produced the phrase hit, so echoing
  #     the same lines under NEAR-MATCH is noise (and this is the surface that carries meta-discussion
  #     of this tool). The near-match block must cite files, not repeat the chat line above it.
  case "$out" in *"chat.log: "*) echo "FAIL: near-match re-printed the board line that already produced the phrase hit"; fail=1;; *) :;; esac

  # 11. A HYPHENATED SLUG IS A MULTI-WORD TERM. The 07-25 near-match split on whitespace only, so a
  #     slug — the form the dash prints and minds type — stayed ONE word and the rescan never ran.
  #     Measured live 2026-08-03: `mesh-prior-art rtc-wake-alarm` read CLEAN against a 13-day-old
  #     knowledge file titled "RTC hardware wake-alarm", and the capability was re-filed as fresh.
  #     RED-first: restore `tr -c '[:alnum:]:._-'` above and this goes CLEAN again.
  cat > "$td/knowledge/capability-fixture-thermal-20260724.md" <<'EOF'
# capability: chassis thermal probe (fixture)
A thermal sensor on the chassis, read over the probe bus.
EOF
  out="$(run chassis-thermal-probe)"; rc=$?
  case "$out" in *"NEAR-MATCH"*) :;; *) echo "FAIL: a hyphenated SLUG whose words are all catalogued read CLEAN — the near-match splitter is blind to the exact form the dash prints and minds type"; fail=1;; esac
  case "$out" in *capability-fixture-thermal-20260724.md*) :;; *) echo "FAIL: slug near-match does not cite the ledger file it found"; fail=1;; esac
  [ "$rc" = 0 ] || { echo "FAIL: slug near-match rc=$rc (want 0 — not-clean)"; fail=1; }

  # 12. ...and the split must not manufacture near-matches out of an IDENTIFIER. A dash-form MAC is
  #     six 2-char parts: under the >=3 filter ws is empty, so no rescan runs and a genuinely novel
  #     address stays CLEAN. Without that filter every hex pair ('aa','ff') matches half the corpus
  #     and the gate cries wolf on every address — the same outcome as no gate (test 8's rule).
  out="$(run de-ad-be-ef-00-11)"; rc=$?
  case "$out" in *CLEAN*) :;; *) echo "FAIL: a novel dash-form MAC did not read CLEAN — the slug split is manufacturing near-matches out of hex pairs"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: novel dash-MAC rc=$rc (want 1)"; fail=1; }

  # 12b. A BINARY IS NOT A CATALOGUE ENTRY. grep -l happily matches inside a compiled blob, and random
  #      bytes are surrounded by non-token bytes — so a binary reads as a WHOLE-TOKEN hit and mints the
  #      stop verdict. Measured on this tree: scripts/uxn/bin/uxncli.arm64 was the ONLY whole-token hit
  #      for `ras`, i.e. one blob decided PRIOR ART vs WEAK.
  printf 'zzbinterm\000\001\002binary payload\000\377\n' > "$td/repo/scripts/blob.bin"
  out="$(run zzbinterm)"; rc=$?
  case "$out" in *"PRIOR ART"*) echo "FAIL: a binary blob minted PRIOR ART (grep -l matches inside binaries; -I is what keeps a catalogue check reading catalogues)"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: binary-only hit rc=$rc (want 1)"; fail=1; }

  # 13. THE SUBSTRING TRAP — the defect this whole post-filter exists for. A file whose ONLY relation
  #     to `edac` is the word `redaction` must NOT mint the STOP verdict, and the finder must be able
  #     to dismiss it in one look. Measured live 2026-08-16: `mesh-prior-art edac` answered PRIOR ART
  #     citing scripts/mesh-log-scrub (⊂ redaction), mid-find, on a real memory-error probe.
  #     RED-first: restore the plain `grep -Fril` verdict and all four assertions below go red.
  #     THE EXIT CODE IS ASSERTED, not just the prose — rc 0 is the stop signal a scripted caller reads.
  cat > "$td/repo/docs/scrubbing.md" <<'EOF'
Log redaction policy: every secret is replaced by a redacted marker before shipping.
EOF
  out="$(run edac)"; rc=$?
  case "$out" in *"PRIOR ART"*) echo "FAIL: 'edac' inside 'redaction' minted the PRIOR ART stop verdict"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: substring-only rc=$rc (want 1 — must not suppress filing; a scripted caller reads the rc)"; fail=1; }
  case "$out" in *"edac ⊂ redaction"*) :;; *) echo "FAIL: the containing word is not shown — a finder cannot dismiss the collision without opening the file"; fail=1;; esac
  case "$out" in *WEAK*) :;; *) echo "FAIL: a substring-only match must be GRADED (WEAK), not silently dropped either"; fail=1;; esac

  # 14. ...and the OTHER edge: when the term IS a whole token, PRIOR ART still fires. Without this the
  #     post-filter could be a constant 'never prior art' and test 13 would pass just as green.
  cat > "$td/repo/docs/memory-errors.md" <<'EOF'
The edac subsystem exposes correctable-error counters per memory controller.
EOF
  out="$(run edac)"; rc=$?
  case "$out" in *"PRIOR ART"*) :;; *) echo "FAIL: a WHOLE-TOKEN hit lost the PRIOR ART verdict — the post-filter rejects everything"; fail=1;; esac
  [ "$rc" = 0 ] || { echo "FAIL: whole-token hit rc=$rc (want 0)"; fail=1; }
  case "$out" in *memory-errors.md*) :;; *) echo "FAIL: the whole-token hit does not cite its file"; fail=1;; esac
  #     ...and the collision file must NOT be listed among the whole-token hits it sits beside
  case "$out" in *"scripts+docs (1"*) :;; *) echo "FAIL: the substring-only file was counted as a whole-token hit"; fail=1;; esac

  # 15. THE BOUNDARY ALPHABET IS THE MESH'S, NOT grep -w's. `-` `_` `.` `:` live INSIDE mesh ids, so
  #     they are not boundaries: `psi` inside `mesh-psi-attrib` is a SUBSTRING (grep -w would call it a
  #     word and re-mint the false verdict), while the full slug matches itself. This is the assertion
  #     that fails if anyone "simplifies" the post-filter to \b or -w.
  cat > "$td/knowledge/capability-fixture-attrib-20260815.md" <<'EOF'
# capability: mesh-psi-attrib names the stall owner
Per-cgroup attribution, consumed by mesh-psi --edge.
EOF
  out="$(run psi)"; rc=$?
  case "$out" in *"PRIOR ART"*) echo "FAIL: 'psi' inside 'mesh-psi-attrib' minted PRIOR ART — the boundary class is treating '-' as a word boundary (that is grep -w's alphabet, not the mesh's)"; fail=1;; esac
  case "$out" in *"psi ⊂ mesh-psi-attrib"*) :;; *) echo "FAIL: the containing IDENTIFIER must be shown whole: $out"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: 'psi' rc=$rc (want 1)"; fail=1; }
  out="$(run mesh-psi-attrib)"; rc=$?
  case "$out" in *"PRIOR ART"*) :;; *) echo "FAIL: a hyphenated id no longer matches ITSELF as a whole token — the post-filter broke the ids this gate exists to check"; fail=1;; esac
  [ "$rc" = 0 ] || { echo "FAIL: whole-slug rc=$rc (want 0)"; fail=1; }

  # 16. The regex-hostile ids the -F candidate scan exists for must survive the post-filter: a VID:PID
  #     (colon), an IP (dots) and a dotted version are single identifiers, and nothing in the term is
  #     ever interpreted (the comparison is index()-based, so a '.' cannot match any character).
  cat > "$td/knowledge/capability-fixture-ids-20260815.md" <<'EOF'
# capability: fixture ids
Device 046d:0825 at 192.168.8.225 running v1.17.20.
EOF
  for id in 046d:0825 192.168.8.225 v1.17.20; do
    out="$(run "$id")"; rc=$?
    case "$out" in *"PRIOR ART"*) :;; *) echo "FAIL: identifier '$id' lost its whole-token match through the post-filter"; fail=1;; esac
    [ "$rc" = 0 ] || { echo "FAIL: identifier '$id' rc=$rc (want 0)"; fail=1; }
  done
  #     ...and a '.' in the term must not act as a regex wildcard (192x168x8x225 must NOT match)
  out="$(run 192x168x8x225)"; rc=$?
  [ "$rc" = 1 ] || { echo "FAIL: a dotted term matched as a regex wildcard — the term is being interpreted, not compared"; fail=1; }

  # 17. THE BOARD IS GRADED TOO. It is the prose-heaviest surface, and a substring collision there was
  #     enough to mint PRIOR ART on its own (each surface sets the verdict independently).
  printf '2026-08-15T10:00:00Z  pub@node  ::  [design] on the redaction of secrets in published logs\n' >> "$td/chat.log"
  rm -f "$td/repo/docs/memory-errors.md"
  out="$(run edac)"; rc=$?
  case "$out" in *"PRIOR ART"*) echo "FAIL: a board-line substring collision minted PRIOR ART: $out"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: board substring-only rc=$rc (want 1)"; fail=1; }
  case "$out" in *"chat.log"*"substring-only"*) :;; *) echo "FAIL: the board's collisions are not graded/shown: $out"; fail=1;; esac

  # 18. A SPLIT WORD IS A PREFIX, NEVER AN INFIX. The near-match rescan was `grep -Fi`, so a split
  #     word matched anywhere inside a longer word — the `edac ⊂ redaction` shape (test 13) on the
  #     one path the 08-16 post-filter never covered. Measured live 2026-08-21: `oom_score` split to
  #     {oom, score}, `oom` matched inside `room` in 193 of 847 ledger files, and the gate answered
  #     NEAR-MATCH (rc 0 — the STOP code) citing Bayesian model reduction and epistemic value with
  #     ZERO whole-token hits anywhere. Both words here are RARE, so the discriminativeness floor
  #     (test 19) cannot be what saves this — the anchoring is.
  #     RED-first: restore `grep -Fi` in files_all_words/lines_all_words and this goes NEAR-MATCH.
  cat > "$td/knowledge/capability-fixture-infix-20260820.md" <<'EOF'
# capability: fixture infix (bazzoom)
The bazzoom handle is scored by zzscore under load.
EOF
  out="$(run zzoom-zzscore)"; rc=$?
  case "$out" in *"NEAR-MATCH"*) echo "FAIL: a split word matched as an INFIX (zzoom inside bazzoom) and minted the NEAR-MATCH stop verdict"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: infix-only near-match rc=$rc (want 1 — must not suppress filing)"; fail=1; }
  #     ...and the OTHER edge: the same word AS A PREFIX still matches, so the rescan keeps seeing
  #     rewordings (advertise→advertising, wake→wakealarm) and is not a constant 'never near-match'.
  out="$(run zzscore-bazzoom)"; rc=$?
  case "$out" in *"NEAR-MATCH"*) :;; *) echo "FAIL: prefix matching lost — the rescan can no longer see a reworded filing"; fail=1;; esac
  [ "$rc" = 0 ] || { echo "FAIL: prefix near-match rc=$rc (want 0)"; fail=1; }

  # 19. CO-PRESENCE OF COMMON WORDS IS NOT EVIDENCE, and the refusal is LOUD. Two words that most of
  #     the corpus carries land together by chance, so an all-words hit on them establishes nothing —
  #     yet it minted rc 0, the same STOP a real filing mints. The floor is ONE RECORD of expected
  #     chance co-presence, N·Π(df_i/N), re-measured live (never a stored constant), per surface.
  #     RED-first: delete the `discriminating` guard and this goes NEAR-MATCH on 12 unrelated files.
  for n in $(seq 1 12); do
    printf '# fixture common %s\nThe kommonalfa is discussed, and kommonbeta separately.\n' "$n" \
      > "$td/knowledge/capability-fixture-common-$n.md"
  done
  out="$(run kommonalfa-kommonbeta)"; rc=$?
  case "$out" in *"NEAR-MATCH"*) echo "FAIL: two corpus-wide common words minted NEAR-MATCH — co-presence is being read as evidence"; fail=1;; esac
  [ "$rc" = 1 ] || { echo "FAIL: non-discriminating near-match rc=$rc (want 1)"; fail=1; }
  #     NO SILENT DROP: a refused surface must say so with its calibration, or the reader cannot tell
  #     'nothing there' from 'we declined to look' (the 2026-07-22 rule, applied to a refusal).
  case "$out" in *"REFUSED on knowledge/"*) :;; *) echo "FAIL: the rescan was dropped SILENTLY — no refusal line naming the surface"; fail=1;; esac
  case "$out" in *"of 18 record(s)"*|*"record(s)"*) :;; *) echo "FAIL: the refusal does not publish the corpus it was calibrated against"; fail=1;; esac

  [ "$fail" = 0 ] && echo "smoke-test: ok (ledger-hit + board-hit + clean + multi-term + usage + no-silent-truncation + near-match reworded/no-wolf/phrase-precedence + weak-surface-hit-cannot-hide-the-ledger + a hyphenated SLUG is split like a phrase while an IP/VID:PID/dash-MAC stays atomic + WHOLE-TOKEN grading: substring-only never mints PRIOR ART and never suppresses filing (rc asserted), whole-token still does, and the boundary alphabet keeps - _ . : INSIDE mesh ids + near-match split words are PREFIXES not infixes, and a word pair chance alone would put together is REFUSED loudly instead of minting a stop)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi

[ $# -ge 1 ] || { usage; exit 2; }
scan "$@"
