#!/usr/bin/env bash
# mesh-upnp-census — LAN UPnP/SSDP service census: which devices are AWAKE and announcing.
#
# The signal no other sense gives: SSDP answers track a device's POWERED/AWAKE state at the
# service level — a TV in standby keeps its DHCP lease (mesh-lan-newdevice still sees the MAC)
# but stops answering M-SEARCH. So "MediaRenderer appeared" = the TV woke up; "departed" = it
# slept. mesh-tv-dlna uses SSDP too but is an on-demand ACTUATOR (cast/control); this is the
# passive census over time. Consumers: mesh-perimeter NETWORK axis / household-state can read
# the log read-only (same doctrine as gateway-identity: consume the artifact, don't re-sweep).
#
# Output (stdout, one line):
#   PRESENT n=<devices> <ip>=<kind>[,<kind>...] ... @ <host> <ts>
#   EMPTY n=0 (lan-ok — no UPnP responders; media devices off/asleep) @ <host> <ts>
# Exit 2 (honest n/a, stderr): no default route, or 0 replies AND gateway unreachable
#   (multicast domain unattestable — never claim EMPTY blind).
# First field is the verdict token (PRESENT|EMPTY); additive fields follow — consumers doing
# whole-string checks must strip at first space (cross-sense vocab contract).
#
# STATE (~/.mesh/.upnp-census): written UNCONDITIONALLY every successful run (mtime = ran-live;
# no change-gating, so no separate state-touch subtlety). Device-set changes append
# ARRIVED/DEPARTED lines to ~/.mesh/upnp-census.log; --edge prints only on a set change.
#
# reflex-cadence: 7-59/15 * * * *
# reflex-args: --edge
set -u

STATE="${MESH_UPNP_STATE:-$HOME/.mesh/.upnp-census}"
LOG="${MESH_UPNP_LOG:-$HOME/.mesh/upnp-census.log}"
WAIT="${MESH_UPNP_WAIT:-4}"
HOSTN="$(hostname)"
now_ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

EDGE=0
[ "${1:-}" = "--edge" ] && { EDGE=1; shift; }

# --- sweep: M-SEARCH ssdp:all, aggregate per device ip → sorted unique service STs ---
# Fixture override (test only): file of "ip<TAB>st" lines replaces the live sweep.
sweep() {
  if [ -n "${MESH_UPNP_FIXTURE:-}" ]; then
    cat "$MESH_UPNP_FIXTURE" 2>/dev/null
    return 0
  fi
  python3 - "$WAIT" <<'EOF'
import socket, sys, time
wait = float(sys.argv[1])
msg = b"\r\n".join([b"M-SEARCH * HTTP/1.1", b"HOST:239.255.255.250:1900",
    b'MAN:"ssdp:discover"', b"MX:2", b"ST:ssdp:all", b"", b""])
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.settimeout(min(wait, 3))
    s.sendto(msg, ("239.255.255.250", 1900))
except OSError as e:
    print(f"sweep-error: {e}", file=sys.stderr); sys.exit(3)
t = time.time()
while time.time() - t < wait:
    try:
        d, addr = s.recvfrom(4096)
    except socket.timeout:
        break
    except OSError:
        break
    st = ""
    for l in d.decode("utf-8", "replace").split("\r\n"):
        if l.lower().startswith("st:"):
            st = l.split(":", 1)[1].strip()
    if st:
        print(f"{addr[0]}\t{st}")
EOF
}

# --- classify: service-type strings for one device → kind csv (pure, testable) ---
classify() {  # $1 = newline-joined STs of one device
  local sts="$1" kinds=""
  local lc; lc="$(printf '%s' "$sts" | tr 'A-Z' 'a-z')"
  case "$lc" in *sony*|*bravia*|*ircc*) kinds="tv";; esac
  case "$lc" in *dial*|*mediarenderer*) kinds="${kinds:+$kinds,}media";; esac
  case "$lc" in *mediaserver*|*contentdirectory*) kinds="${kinds:+$kinds,}server";; esac
  case "$lc" in *internetgateway*|*wandevice*|*wanipconn*) kinds="${kinds:+$kinds,}router";; esac
  case "$lc" in *printer*) kinds="${kinds:+$kinds,}printer";; esac
  printf '%s' "${kinds:-upnp}"
}

# --- gateway reachability (qualifies EMPTY; mirrors gateway-identity's vantage) ---
lan_ok() {
  local gw
  gw="$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')"
  [ -n "$gw" ] || return 1
  ping -c1 -W2 "$gw" >/dev/null 2>&1
}

# --- --test ---------------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
  fails=0; n=0
  ok() { n=$((n+1)); }
  bad() { n=$((n+1)); fails=$((fails+1)); echo "FAIL: $1" >&2; }

  # classify fixtures
  [ "$(classify 'urn:schemas-sony-com:service:IRCC:1
urn:dial-multiscreen-org:service:dial:1
urn:schemas-upnp-org:device:MediaRenderer:1')" = "tv,media" ] && ok || bad "classify sony tv"
  [ "$(classify 'urn:schemas-upnp-org:device:InternetGatewayDevice:1')" = "router" ] && ok || bad "classify router"
  [ "$(classify 'urn:weird-vendor:service:Frobnicator:1')" = "upnp" ] && ok || bad "classify unknown → upnp"

  # sandboxed end-to-end via fixture: PRESENT verdict + edge suppression + state-every-run
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  printf '192.168.8.130\turn:schemas-sony-com:service:IRCC:1\n192.168.8.130\turn:dial-multiscreen-org:service:dial:1\n' > "$_td/fix1"
  out1="$(MESH_UPNP_FIXTURE="$_td/fix1" MESH_UPNP_STATE="$_td/state" MESH_UPNP_LOG="$_td/log" bash "$0")"
  case "$out1" in PRESENT\ n=1\ 192.168.8.130=tv,media*) ok;; *) bad "fixture PRESENT line: $out1";; esac
  grep -q 'ARRIVED 192.168.8.130=tv,media' "$_td/log" && ok || bad "ARRIVED logged"
  # second run same fixture, --edge → silent, exit 0, state mtime still refreshed
  touch -d '2000-01-01' "$_td/state"
  out2="$(MESH_UPNP_FIXTURE="$_td/fix1" MESH_UPNP_STATE="$_td/state" MESH_UPNP_LOG="$_td/log" bash "$0" --edge)"; rc2=$?
  [ $rc2 -eq 0 ] && [ -z "$out2" ] && ok || bad "edge unchanged not silent (rc=$rc2 out=$out2)"
  [ "$(find "$_td/state" -newermt '2020-01-01' | wc -l)" = 1 ] && ok || bad "state mtime not refreshed on suppressed run"
  # device disappears → --edge fires EMPTY? fixture empty + we cannot fake lan; use fixture path:
  : > "$_td/fix2"
  out3="$(MESH_UPNP_FIXTURE="$_td/fix2" MESH_UPNP_STATE="$_td/state" MESH_UPNP_LOG="$_td/log" MESH_UPNP_LANOK=1 bash "$0" --edge)"
  case "$out3" in EMPTY\ n=0*) ok;; *) bad "edge fire on departure: $out3";; esac
  grep -q 'DEPARTED 192.168.8.130=tv,media' "$_td/log" && ok || bad "DEPARTED logged"
  # empty + lan NOT ok → exit 2, no EMPTY claim
  out4="$(MESH_UPNP_FIXTURE="$_td/fix2" MESH_UPNP_STATE="$_td/state2" MESH_UPNP_LOG="$_td/log2" MESH_UPNP_LANOK=0 bash "$0" 2>/dev/null)"; rc4=$?
  [ $rc4 -eq 2 ] && [ -z "$out4" ] && ok || bad "blind empty must exit 2 (rc=$rc4 out=$out4)"

  # REAL-READ gate: live sweep must execute cleanly (rc 0 or honest 2 — never crash).
  # 0 responders with lan-ok is a TRUE state (media devices asleep), so PRESENT isn't required.
  live="$(MESH_UPNP_STATE="$_td/lstate" MESH_UPNP_LOG="$_td/llog" bash "$0" 2>&1)"; lrc=$?
  if [ $lrc -eq 0 ]; then
    case "$live" in PRESENT\ n=[1-9]*|EMPTY\ n=0*) ok;; *) bad "live line malformed: $live";; esac
  elif [ $lrc -eq 2 ]; then ok  # honest n/a (no route / gateway dark)
  else bad "live sweep rc=$lrc: $live"; fi

  if [ $fails -eq 0 ]; then echo "mesh-upnp-census --test: ok — $n assertions [3 classify + 6 fixture-e2e + 1 live]"; exit 0
  else echo "mesh-upnp-census --test: $fails/$n FAILED" >&2; exit 1; fi
fi

# --- main -----------------------------------------------------------------
raw="$(sweep)"; src_rc=$?
if [ $src_rc -eq 3 ]; then
  echo "upnp-census: UNREACHABLE (socket error — no usable network path) @ $HOSTN $(now_ts)" >&2
  exit 2
fi

# aggregate: ip → kinds
census=""
if [ -n "$raw" ]; then
  ips="$(printf '%s\n' "$raw" | cut -f1 | sort -u)"
  for ip in $ips; do
    sts="$(printf '%s\n' "$raw" | awk -F'\t' -v i="$ip" '$1==i {print $2}' | sort -u)"
    census="${census:+$census }$ip=$(classify "$sts")"
  done
fi
if [ -n "$census" ]; then ndev="$(printf '%s\n' "$census" | tr ' ' '\n' | grep -c '=')"; else ndev=0; fi

if [ "$ndev" -eq 0 ]; then
  _lanok="${MESH_UPNP_LANOK:-}"
  if [ -z "$_lanok" ]; then lan_ok && _lanok=1 || _lanok=0; fi
  if [ "$_lanok" != 1 ]; then
    echo "upnp-census: UNREACHABLE (0 replies and gateway dark — multicast domain unattestable) @ $HOSTN $(now_ts)" >&2
    exit 2
  fi
  line="EMPTY n=0 (lan-ok — no UPnP responders; media devices off/asleep) @ $HOSTN $(now_ts)"
  sig=""
else
  line="PRESENT n=$ndev $census @ $HOSTN $(now_ts)"
  sig="$census"
fi

prev_sig="$(head -1 "$STATE" 2>/dev/null | sed 's/^sig=//')"
mkdir -p "$(dirname "$STATE")" 2>/dev/null
{ printf 'sig=%s\n%s\n' "$sig" "$line"; } > "$STATE"

if [ "$sig" != "$prev_sig" ]; then
  ts="$(now_ts)"
  for d in $prev_sig; do case " $sig " in *" $d "*) ;; *) echo "[upnp-census] DEPARTED $d @ $HOSTN $ts" >> "$LOG";; esac; done
  for d in $sig; do case " $prev_sig " in *" $d "*) ;; *) echo "[upnp-census] ARRIVED $d @ $HOSTN $ts" >> "$LOG";; esac; done
  echo "[upnp-census] CENSUS n=$ndev ${sig:-—} @ $HOSTN $ts" >> "$LOG"
  echo "$line"
  exit 0
fi

[ "$EDGE" = 1 ] && exit 0
echo "$line"
