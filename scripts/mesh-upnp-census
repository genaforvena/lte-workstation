#!/usr/bin/env bash
# mesh-upnp-census — LAN UPnP/SSDP service census: which devices are AWAKE and announcing.
#
# The signal no other sense gives: SSDP answers track a device's POWERED/AWAKE state at the
# service level — a TV in standby keeps its DHCP lease (mesh-lan-newdevice still sees the MAC)
# but stops answering M-SEARCH. So "MediaRenderer appeared" = the TV woke up; "departed" = it
# slept. mesh-tv-dlna uses SSDP too but is an on-demand ACTUATOR (cast/control); this is the
# passive census over time. Consumers: mesh-perimeter NETWORK axis / household-state can read
# the log read-only (same doctrine as gateway-identity: consume the artifact, don't re-sweep).
#
# Output (stdout, one line):
#   PRESENT n=<devices> <ip>=<kind>[,<kind>...] ... @ <host> <ts>
#   EMPTY n=0 (lan-ok, mcast-path-ok — no UPnP responders; media devices off/asleep) @ <host> <ts>
# Exit 2 (honest n/a, stderr): no default route; 0 replies AND the SSDP group does not leave by the
#   LAN device (SWALLOWED — the query never reached the LAN, so silence is blindness); 0 replies and
#   the group's device is unresolvable (UNATTESTABLE); or 0 replies AND gateway unreachable.
#   Never claim EMPTY blind, and never name a cause (asleep/off) that was not measured.
# --mcast-path [group] prints the deciding grammar as one line — `state=<ok|swallowed|no-route|
#   unknown> group=<g> dev=<d> lan_dev=<l> (<why>)`. mesh-tv-dlna calls THIS rather than keeping a
#   second copy of the predicate.
# First field is the verdict token (PRESENT|EMPTY); additive fields follow — consumers doing
# whole-string checks must strip at first space (cross-sense vocab contract).
#
# STATE (~/.mesh/.upnp-census): written UNCONDITIONALLY every successful run (mtime = ran-live;
# no change-gating, so no separate state-touch subtlety). Device-set changes append
# ARRIVED/DEPARTED lines to ~/.mesh/upnp-census.log; --edge prints only on a set change.
#
# reflex-cadence: 7-59/15 * * * *
# reflex-args: --edge
set -u

STATE="${MESH_UPNP_STATE:-$HOME/.mesh/.upnp-census}"
LOG="${MESH_UPNP_LOG:-$HOME/.mesh/upnp-census.log}"
WAIT="${MESH_UPNP_WAIT:-4}"
HOSTN="$(hostname)"
now_ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

EDGE=0
[ "${1:-}" = "--edge" ] && { EDGE=1; shift; }

# --- sweep: M-SEARCH ssdp:all, aggregate per device ip → sorted unique service STs ---
# Fixture override (test only): file of "ip<TAB>st" lines replaces the live sweep.
sweep() {
  if [ -n "${MESH_UPNP_FIXTURE:-}" ]; then
    cat "$MESH_UPNP_FIXTURE" 2>/dev/null
    return 0
  fi
  python3 - "$WAIT" "$(lan_src)" <<'EOF'
import socket, sys, time
wait = float(sys.argv[1])
lan_src = sys.argv[2] if len(sys.argv) > 2 else ""
msg = b"\r\n".join([b"M-SEARCH * HTTP/1.1", b"HOST:239.255.255.250:1900",
    b'MAN:"ssdp:discover"', b"MX:2", b"ST:ssdp:all", b"", b""])
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    # PIN the egress interface. Without this the M-SEARCH follows the FIB, and under an exit node the
    # FIB sends 224.0.0.0/4 down the tunnel — the swallow this tool's guard reports. Pinning is the
    # CURE the guard only names; mesh-mdns-census already pins (it survived the same swallow because
    # mDNS responders announce unsolicited, so its LISTENER heard the LAN anyway — SSDP has no such
    # luck: an M-SEARCH answer is unicast back to whoever asked, and nobody asked from the LAN).
    # A failure to pin is NOT fatal and NOT silent: the sweep proceeds unpinned and the guard below
    # still refuses to call the result a census.
    if lan_src:
        try: s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(lan_src))
        except OSError as e: print(f"sweep-warn: could not pin IP_MULTICAST_IF to {lan_src}: {e}", file=sys.stderr)
    s.settimeout(min(wait, 3))
    s.sendto(msg, ("239.255.255.250", 1900))
except OSError as e:
    print(f"sweep-error: {e}", file=sys.stderr); sys.exit(3)
t = time.time()
while time.time() - t < wait:
    try:
        d, addr = s.recvfrom(4096)
    except socket.timeout:
        break
    except OSError:
        break
    st = ""
    for l in d.decode("utf-8", "replace").split("\r\n"):
        if l.lower().startswith("st:"):
            st = l.split(":", 1)[1].strip()
    if st:
        print(f"{addr[0]}\t{st}")
EOF
}

# --- classify: service-type strings for one device → kind csv (pure, testable) ---
classify() {  # $1 = newline-joined STs of one device
  local sts="$1" kinds=""
  local lc; lc="$(printf '%s' "$sts" | tr 'A-Z' 'a-z')"
  case "$lc" in *sony*|*bravia*|*ircc*) kinds="tv";; esac
  case "$lc" in *dial*|*mediarenderer*) kinds="${kinds:+$kinds,}media";; esac
  case "$lc" in *mediaserver*|*contentdirectory*) kinds="${kinds:+$kinds,}server";; esac
  case "$lc" in *internetgateway*|*wandevice*|*wanipconn*) kinds="${kinds:+$kinds,}router";; esac
  case "$lc" in *printer*) kinds="${kinds:+$kinds,}printer";; esac
  printf '%s' "${kinds:-upnp}"
}

# --- MULTICAST-PATH guard (2026-08-30; discover {#39af3e18} find, health verified live) ------------
# THE DECIDING GRAMMAR, and it lives here ONCE: mesh-tv-dlna calls `mesh-upnp-census --mcast-path`
# rather than carrying a second copy, because two copies of a predicate drift the day one is widened
# ([[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]).
#
# lan_ok() below pings the GATEWAY, which is UNICAST — and an M-SEARCH is not. On a node consuming a
# tailscale exit node the exit-node table's `default dev tailscale0` swallows 224.0.0.0/4 (the throw
# set is unicast-only: measured here 2026-08-30, table 52 carried throws for the rescue /32, 127/8,
# 172.17/16, 192.168.8/24 and fe80::/64 and NO 224.0.0.0/4), so every M-SEARCH left by the tunnel and
# came back with zero responders while the gateway ping stayed perfect. The census then printed
# `EMPTY n=0 (lan-ok — no UPnP responders; media devices off/asleep)` — a false ALL-CLEAR naming a
# cause nobody measured, while the operator's BRAVIA answered 200 on
# http://192.168.8.130:52323/dmr.xml over unicast in the same minute.
#
# The artifact is the FIB LOOKUP for the GROUP THE SOCKET ACTUALLY SENDS TO, and the DEVICE it comes
# back on — never a pref, never a ping of something else ([[a-declared-pref-is-not-the-fib]],
# [[a-unicast-reachability-guard-cannot-attest-a-multicast-path]]). POLARITY: swallowed is decided by
# "it did NOT leave by the main table's own default device", never by the name `tailscale0` — an
# allowlist of known swallowers fails toward SILENCE, and the next tunnel would wear a different name
# ([[an-exclusion-allowlist-fails-toward-silence-so-invert-the-polarity]]).
MCAST_GROUP="${MESH_UPNP_MCAST_GROUP:-239.255.255.250}"
# The address to pin the multicast socket to. It MUST come from the MAIN table's own default route —
# never from `ip route get <group>`, which on a swallowed node is answered BY the exit-node table and
# hands back the tunnel's source (measured here: `ip route get 224.0.0.251` → src 100.81.222.19, while
# the LAN src is 192.168.8.224). Deriving the cure's input from the poisoned route pins the socket to
# the very interface being escaped.
lan_src() {
  [ -n "${MESH_UPNP_LAN_SRC+x}" ] && { printf '%s' "$MESH_UPNP_LAN_SRC"; return 0; }
  ip route show default 2>/dev/null | awk '/^default/ {for(i=1;i<NF;i++) if($i=="src") {print $(i+1); exit}}'
}
# TEST SEAM: the two INPUTS are overridable, never the verdict. An earlier draft let a fixture replace
# the whole function's OUTPUT and a mutant that inverted the comparison survived GREEN — the fixture
# short-circuited the one line under test ([[a-fixture-driven-gate-cannot-cover-the-live-path]]).
# Overriding the inputs keeps the deciding comparison on the real code path in every arm.
mcast_path() {
  local g="${1:-$MCAST_GROUP}" lan dev out
  lan="${MESH_UPNP_LAN_DEV:-$(ip route show default 2>/dev/null | awk '/^default/ {for(i=1;i<NF;i++) if($i=="dev") {print $(i+1); exit}}')}"
  if [ -n "${MESH_UPNP_MCAST_DEV+x}" ]; then dev="$MESH_UPNP_MCAST_DEV"; else
  out="$(ip route get "$g" 2>/dev/null)" || out=""
  dev="$(printf '%s\n' "$out" | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')"
  fi
  if [ -z "$lan" ]; then
    printf 'state=no-route group=%s dev=%s lan_dev=- (no default route — nothing to compare the multicast path against)\n' "$g" "${dev:--}"
  elif [ -z "$dev" ]; then
    printf 'state=unknown group=%s dev=- lan_dev=%s (the FIB named no device for the group — the guard cannot attest this path either way)\n' "$g" "$lan"
  elif [ "$dev" = "$lan" ]; then
    printf 'state=ok group=%s dev=%s lan_dev=%s (the group leaves by the LAN device)\n' "$g" "$dev" "$lan"
  else
    printf 'state=swallowed group=%s dev=%s lan_dev=%s (the group does NOT leave by the LAN device — an M-SEARCH cannot reach the LAN, so silence here is BLINDNESS, not absence)\n' "$g" "$dev" "$lan"
  fi
}
if [ "${1:-}" = "--mcast-path" ]; then mcast_path "${2:-}"; exit 0; fi

# --- gateway reachability (qualifies EMPTY; mirrors gateway-identity's vantage) ---
lan_ok() {
  local gw
  gw="$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')"
  [ -n "$gw" ] || return 1
  ping -c1 -W2 "$gw" >/dev/null 2>&1
}

# --- --test ---------------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
  fails=0; n=0
  ok() { n=$((n+1)); }
  bad() { n=$((n+1)); fails=$((fails+1)); echo "FAIL: $1" >&2; }

  # classify fixtures
  [ "$(classify 'urn:schemas-sony-com:service:IRCC:1
urn:dial-multiscreen-org:service:dial:1
urn:schemas-upnp-org:device:MediaRenderer:1')" = "tv,media" ] && ok || bad "classify sony tv"
  [ "$(classify 'urn:schemas-upnp-org:device:InternetGatewayDevice:1')" = "router" ] && ok || bad "classify router"
  [ "$(classify 'urn:weird-vendor:service:Frobnicator:1')" = "upnp" ] && ok || bad "classify unknown → upnp"

  # sandboxed end-to-end via fixture: PRESENT verdict + edge suppression + state-every-run
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  printf '192.168.8.130\turn:schemas-sony-com:service:IRCC:1\n192.168.8.130\turn:dial-multiscreen-org:service:dial:1\n' > "$_td/fix1"
  out1="$(MESH_UPNP_FIXTURE="$_td/fix1" MESH_UPNP_STATE="$_td/state" MESH_UPNP_LOG="$_td/log" bash "$0")"
  case "$out1" in PRESENT\ n=1\ 192.168.8.130=tv,media*) ok;; *) bad "fixture PRESENT line: $out1";; esac
  grep -q 'ARRIVED 192.168.8.130=tv,media' "$_td/log" && ok || bad "ARRIVED logged"
  # second run same fixture, --edge → silent, exit 0, state mtime still refreshed
  touch -d '2000-01-01' "$_td/state"
  out2="$(MESH_UPNP_FIXTURE="$_td/fix1" MESH_UPNP_STATE="$_td/state" MESH_UPNP_LOG="$_td/log" bash "$0" --edge)"; rc2=$?
  [ $rc2 -eq 0 ] && [ -z "$out2" ] && ok || bad "edge unchanged not silent (rc=$rc2 out=$out2)"
  [ "$(find "$_td/state" -newermt '2020-01-01' | wc -l)" = 1 ] && ok || bad "state mtime not refreshed on suppressed run"
  # device disappears → --edge fires EMPTY? fixture empty + we cannot fake lan; use fixture path:
  : > "$_td/fix2"
  # inputs, not verdicts: the deciding comparison still runs on the real code path in every arm
  out3="$(MESH_UPNP_FIXTURE="$_td/fix2" MESH_UPNP_MCAST_DEV=lan0 MESH_UPNP_LAN_DEV=lan0 MESH_UPNP_STATE="$_td/state" MESH_UPNP_LOG="$_td/log" MESH_UPNP_LANOK=1 bash "$0" --edge)"
  case "$out3" in EMPTY\ n=0*) ok;; *) bad "edge fire on departure: $out3";; esac
  grep -q 'DEPARTED 192.168.8.130=tv,media' "$_td/log" && ok || bad "DEPARTED logged"
  # empty + lan NOT ok → exit 2, no EMPTY claim
  out4="$(MESH_UPNP_FIXTURE="$_td/fix2" MESH_UPNP_MCAST_DEV=lan0 MESH_UPNP_LAN_DEV=lan0 MESH_UPNP_STATE="$_td/state2" MESH_UPNP_LOG="$_td/log2" MESH_UPNP_LANOK=0 bash "$0" 2>/dev/null)"; rc4=$?
  [ $rc4 -eq 2 ] && [ -z "$out4" ] && ok || bad "blind empty must exit 2 (rc=$rc4 out=$out4)"

  # ── MULTICAST-PATH guard ({#39af3e18}) ──────────────────────────────────────────────────────────
  # RED-first in the only sense that matters here: the SAME zero-reply sweep with a HEALTHY multicast
  # path is the arm above (out3 → EMPTY), so this arm changes exactly ONE variable — the FIB's answer
  # for the group — and the verdict must flip. Without the pair, a SWALLOWED verdict could be coming
  # from the empty fixture rather than from the path.
  err5="$(MESH_UPNP_FIXTURE="$_td/fix2" MESH_UPNP_MCAST_DEV=tun0 MESH_UPNP_LAN_DEV=lan0 MESH_UPNP_STATE="$_td/state5" MESH_UPNP_LOG="$_td/log5" MESH_UPNP_LANOK=1 bash "$0" 2>&1 >/dev/null)"; rc5=$?
  [ $rc5 -eq 2 ] && ok || bad "swallowed multicast path must exit 2, got rc=$rc5"
  case "$err5" in *SWALLOWED*) ok;; *) bad "swallowed path did not produce the SWALLOWED word: $err5";; esac
  case "$err5" in *dev=tun0*lan_dev=lan0*) ok;; *) bad "SWALLOWED verdict does not name the device it left by vs the LAN device: $err5";; esac
  # THE WHOLE POINT: it must not name a cause it never measured, and must not wear lan-ok.
  case "$err5" in *asleep*|*off*|*lan-ok*) bad "SWALLOWED verdict still names an unmeasured cause / wears lan-ok: $err5";; *) ok;; esac
  # ...and the gateway ping must NOT be able to rescue it — LANOK=1 above is exactly that attempt.
  out5b="$(MESH_UPNP_FIXTURE="$_td/fix2" MESH_UPNP_MCAST_DEV=tun0 MESH_UPNP_LAN_DEV=lan0 MESH_UPNP_STATE="$_td/state5b" MESH_UPNP_LOG="$_td/log5b" MESH_UPNP_LANOK=1 bash "$0" 2>/dev/null)"
  [ -z "$out5b" ] && ok || bad "a swallowed path still emitted a stdout census line (a unicast fact outranked the multicast one): $out5b"
  # PRESENT is self-attesting: responders ARRIVED down the path, so the guard must not veto them.
  out5c="$(MESH_UPNP_FIXTURE="$_td/fix1" MESH_UPNP_MCAST_DEV=tun0 MESH_UPNP_LAN_DEV=lan0 MESH_UPNP_STATE="$_td/state5c" MESH_UPNP_LOG="$_td/log5c" bash "$0")"
  case "$out5c" in PRESENT\ n=1*) ok;; *) bad "the guard vetoed a sweep that actually got replies — replies ARE the path: $out5c";; esac
  # ── THE PIN (the cure, not just the word) ───────────────────────────────────────────────────────
  # lan_src() must come from the MAIN table's default route. Deriving it from `ip route get <group>`
  # — the obvious-looking source, and what mesh-mdns-census did until this pass — asks the SWALLOWING
  # table for the address you are trying to escape it with.
  _dflt_src="$(ip route show default 2>/dev/null | awk '/^default/ {for(i=1;i<NF;i++) if($i=="src") {print $(i+1); exit}}')"
  _grp_src="$(ip route get "$MCAST_GROUP" 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')"
  if [ -n "$_dflt_src" ]; then
    [ "$(lan_src)" = "$_dflt_src" ] && ok || bad "lan_src is not the main default route's src ($(lan_src) vs $_dflt_src)"
    if [ -n "$_grp_src" ] && [ "$_grp_src" != "$_dflt_src" ]; then
      # This node is LIVE-swallowed, so the two sources differ and the arm DISCRIMINATES.
      [ "$(lan_src)" != "$_grp_src" ] && ok || bad "lan_src took the group lookup's src ($_grp_src) — the swallowing table's own answer"
    else
      ok   # healthy/equal here: the arm above is the one carrying the claim, this one cannot discriminate
    fi
  else ok; fi   # no default route: nothing to pin against, and the no-route state is asserted elsewhere
  # the VALUE lan_src returns must actually reach the socket — drive a bogus one and require the pin
  # failure to be LOUD on stderr. Without this the pin could be computed and never applied.
  _pinwarn="$(MESH_UPNP_LAN_SRC=203.0.113.9 MESH_UPNP_FIXTURE= MESH_UPNP_STATE="$_td/pstate" MESH_UPNP_LOG="$_td/plog" bash "$0" 2>&1 >/dev/null | head -1)"
  case "$_pinwarn" in sweep-warn:*203.0.113.9*) ok;; *) bad "the pin address never reached the socket (no loud warn for an unassignable one): $_pinwarn";; esac
  # the deciding grammar itself, all four states, one entry point (mesh-tv-dlna calls this)
  case "$(MESH_UPNP_MCAST_DEV=lan0 MESH_UPNP_LAN_DEV=lan0 bash "$0" --mcast-path)" in state=ok\ *) ok;; *) bad "--mcast-path did not expose the grammar";; esac
  live_mc="$(bash "$0" --mcast-path)"
  case "$live_mc" in state=ok*|state=swallowed*|state=no-route*|state=unknown*) ok;; *) bad "live --mcast-path is not one of the four declared states: $live_mc";; esac
  case "$live_mc" in *dev=*lan_dev=*) ok;; *) bad "live --mcast-path omits the devices its verdict rests on: $live_mc";; esac

  # REAL-READ gate: live sweep must execute cleanly (rc 0 or honest 2 — never crash).
  # 0 responders with lan-ok is a TRUE state (media devices asleep), so PRESENT isn't required.
  live="$(MESH_UPNP_STATE="$_td/lstate" MESH_UPNP_LOG="$_td/llog" bash "$0" 2>&1)"; lrc=$?
  if [ $lrc -eq 0 ]; then
    case "$live" in PRESENT\ n=[1-9]*|EMPTY\ n=0*) ok;; *) bad "live line malformed: $live";; esac
  elif [ $lrc -eq 2 ]; then ok  # honest n/a (no route / gateway dark)
  else bad "live sweep rc=$lrc: $live"; fi

  if [ $fails -eq 0 ]; then echo "mesh-upnp-census --test: ok — $n assertions [3 classify + 6 fixture-e2e + 9 multicast-path guard + 3 egress pin + 1 live]"; exit 0
  else echo "mesh-upnp-census --test: $fails/$n FAILED" >&2; exit 1; fi
fi

# --- main -----------------------------------------------------------------
raw="$(sweep)"; src_rc=$?
if [ $src_rc -eq 3 ]; then
  echo "upnp-census: UNREACHABLE (socket error — no usable network path) @ $HOSTN $(now_ts)" >&2
  exit 2
fi

# aggregate: ip → kinds
census=""
if [ -n "$raw" ]; then
  ips="$(printf '%s\n' "$raw" | cut -f1 | sort -u)"
  for ip in $ips; do
    sts="$(printf '%s\n' "$raw" | awk -F'\t' -v i="$ip" '$1==i {print $2}' | sort -u)"
    census="${census:+$census }$ip=$(classify "$sts")"
  done
fi
if [ -n "$census" ]; then ndev="$(printf '%s\n' "$census" | tr ' ' '\n' | grep -c '=')"; else ndev=0; fi

if [ "$ndev" -eq 0 ]; then
  # The multicast path is asked FIRST and it OUTRANKS the gateway ping: a swallowed group makes the
  # gateway's reachability irrelevant, and answering with the unicast fact is exactly the false
  # all-clear this guard exists to end. Zero replies down a path that cannot carry the query is not
  # a reading about the LAN at all.
  _mc="$(mcast_path)"
  case "$_mc" in
    state=swallowed*)
      echo "upnp-census: SWALLOWED (0 replies, and $_mc) — NOT a census of the LAN; nothing is claimed about what is awake @ $HOSTN $(now_ts)" >&2
      exit 2 ;;
    state=no-route*|state=unknown*)
      echo "upnp-census: UNATTESTABLE (0 replies, and $_mc) @ $HOSTN $(now_ts)" >&2
      exit 2 ;;
  esac
  _lanok="${MESH_UPNP_LANOK:-}"
  if [ -z "$_lanok" ]; then lan_ok && _lanok=1 || _lanok=0; fi
  if [ "$_lanok" != 1 ]; then
    echo "upnp-census: UNREACHABLE (0 replies and gateway dark — multicast domain unattestable) @ $HOSTN $(now_ts)" >&2
    exit 2
  fi
  line="EMPTY n=0 (lan-ok, mcast-path-ok — no UPnP responders; media devices off/asleep) @ $HOSTN $(now_ts)"
  sig=""
else
  line="PRESENT n=$ndev $census @ $HOSTN $(now_ts)"
  sig="$census"
fi

prev_sig="$(head -1 "$STATE" 2>/dev/null | sed 's/^sig=//')"
mkdir -p "$(dirname "$STATE")" 2>/dev/null
{ printf 'sig=%s\n%s\n' "$sig" "$line"; } > "$STATE"

if [ "$sig" != "$prev_sig" ]; then
  ts="$(now_ts)"
  for d in $prev_sig; do case " $sig " in *" $d "*) ;; *) echo "[upnp-census] DEPARTED $d @ $HOSTN $ts" >> "$LOG";; esac; done
  for d in $sig; do case " $prev_sig " in *" $d "*) ;; *) echo "[upnp-census] ARRIVED $d @ $HOSTN $ts" >> "$LOG";; esac; done
  echo "[upnp-census] CENSUS n=$ndev ${sig:-—} @ $HOSTN $ts" >> "$LOG"
  echo "$line"
  exit 0
fi

[ "$EDGE" = 1 ] && exit 0
echo "$line"
