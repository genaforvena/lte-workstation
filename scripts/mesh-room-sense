#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-room-sense — room OCCUPANCY fusion: is someone in the room?
# Folds BLE presence (local) + body-motion + WiFi motion + ambient light (phone) → PRESENT/EMPTY/UNCERTAIN.
#
# Usage:
#   mesh-room-sense           one-shot verdict to stdout
#   mesh-room-sense --edge    only emit when verdict changes (for cron wiring)
#   mesh-room-sense --json    machine-readable JSON {verdict, signals, reason, ts}
#   mesh-room-sense --test    smoke test (no scan)
#
# Signals (all best-effort — a missing signal degrades to UNCERTAIN, never fakes a clear):
#   BLE (IdeaPad-local):  named device visible at rssi > -82 → PRESENT weight
#   Body motion (phone):  CARRIED/HANDLED = strong occupancy (mesh-body-motion)
#   WiFi motion (phone):  MOTION/STILL/UNCERTAIN (mesh-wifi-motion)
#   Ambient light (phone): DARK/LIT (mesh-light)
#
# Fusion:
#   PRESENT  if: body=CARRIED|HANDLED OR named BLE strong (≥-82) OR wifi=MOTION OR (wifi≠STILL AND light=LIT)
#   EMPTY    if: wifi=STILL AND light=DARK AND body≠CARRIED|HANDLED AND no strong named BLE
#   UNCERTAIN if: phone offline (can't assess WiFi/light/body) OR all signals weak/mixed
#
# Exit codes (honest-exit contract):
#   0 = verdict assessed (may be UNCERTAIN if signals conflict)
#   2 = cannot assess at all (BLE scan failed AND phone unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
OFFLINEFILE="$HOME/.mesh/.room-sense-offline"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH_DIR/.room-sense.state"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no"
PHONE_IP="${PHONE_IP:-$(mesh-peer-addr Redmi 2>/dev/null || true)}"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
BLE_RSSI_THRESHOLD="${MESH_ROOM_RSSI:--82}"

# Source canonical BLE patterns from mesh-patterns.sh (DRY — avoids drift).
# MESH_PERSON_RE = mobile person-devices (STRONG for occupancy).
# MESH_FIXED_RE  = stationary appliances (WEAK — only corroborate, never drive PRESENT alone).
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then
  . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
elif [ -f "$HOME/.local/bin/mesh-patterns" ]; then
  . "$HOME/.local/bin/mesh-patterns" 2>/dev/null || true
fi
STRONG_BLE_PATTERNS="${MESH_PERSON_RE:-JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi}"
WEAK_BLE_PATTERNS="${MESH_FIXED_RE:-\\[TV\\]|MiTV|Bose}"

[ "${1:-}" = --test ] && {
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  [ -d "$MESH_DIR" ] || { echo "smoke-test: FAIL (no $MESH_DIR)"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

MODE=oneshot
[ "${1:-}" = --edge ] && MODE=edge
[ "${1:-}" = --json ] && MODE=json

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- BLE scan (IdeaPad-local, no phone needed) ---
ble_verdict="NONE"
ble_reason=""
ble_out="$(mesh-presence 10 2>/dev/null)" || true
if [ -n "$ble_out" ]; then
  # Check for strong named devices (non-? names, strong RSSI)
  while IFS='|' read -r rssi mac name; do
    [ -z "$name" ] || [ "$name" = '?' ] && continue
    [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]] && continue  # bare MAC = unnamed
    rssi_num="${rssi//[^0-9-]/}"
    [ -z "$rssi_num" ] && continue
    if [ "$rssi_num" -ge "$BLE_RSSI_THRESHOLD" ] 2>/dev/null; then
      if printf '%s' "$name" | grep -qE "$STRONG_BLE_PATTERNS"; then
        ble_verdict="PRESENT_STRONG"
        ble_reason="named BLE '$name' at ${rssi} dBm"
        break
      elif printf '%s' "$name" | grep -qE "$WEAK_BLE_PATTERNS"; then
        ble_verdict="PRESENT_WEAK"
        ble_reason="TV/static BLE '$name' at ${rssi} dBm"
      fi
    fi
  done < <(printf '%s\n' "$ble_out" | grep -E '^-?[0-9]+\|')
fi
ble_ok=$( [ -n "$ble_out" ] && echo 1 || echo 0 )

# --- WiFi motion (phone) ---
# mesh-wifi-motion and mesh-light run locally and SSH to the phone themselves.
# DO NOT SSH-wrap them — $HOME/.local/bin/ is IdeaPad-local, not a Termux path.
wifi_verdict="UNKNOWN"
phone_ok=0
_wifi_rc=0
wifi_out="$(timeout 12 mesh-wifi-motion 2>/dev/null)" || _wifi_rc=$?
if [ "$_wifi_rc" = 2 ]; then
  phone_ok=0   # phone unreachable (honest exit 2 from mesh-wifi-motion)
else
  phone_ok=1
  rm -f "$OFFLINEFILE"
  if printf '%s' "$wifi_out" | grep -q 'MOTION'; then
    wifi_verdict="MOTION"
  elif printf '%s' "$wifi_out" | grep -q 'STILL'; then
    wifi_verdict="STILL"
  elif printf '%s' "$wifi_out" | grep -q 'UNCERTAIN'; then
    wifi_verdict="UNCERTAIN"
  fi
fi

# --- Ambient light (phone) ---
light_verdict="UNKNOWN"
if [ "$phone_ok" = 1 ]; then
  light_out="$(timeout 10 mesh-light 2>/dev/null)" || true
  if printf '%s' "$light_out" | grep -q 'LIT'; then
    light_verdict="LIT"
  elif printf '%s' "$light_out" | grep -q 'DARK'; then
    light_verdict="DARK"
  fi
fi

# --- Body motion (phone) — strongest occupancy signal ---
body_verdict="UNKNOWN"
if [ "$phone_ok" = 1 ]; then
  body_out="$(timeout 14 mesh-body-motion 2>/dev/null)" || true
  if printf '%s' "$body_out" | grep -q '\[body-carried\]'; then
    body_verdict="CARRIED"
  elif printf '%s' "$body_out" | grep -q '\[body-handled\]'; then
    body_verdict="HANDLED"
  elif printf '%s' "$body_out" | grep -q '\[body-covered\]'; then
    body_verdict="COVERED"
  elif printf '%s' "$body_out" | grep -q '\[body-still\]'; then
    body_verdict="STILL"
  fi
fi

# --- Fusion ---
verdict="UNCERTAIN"
reason=""

if [ "$body_verdict" = "CARRIED" ] || [ "$body_verdict" = "HANDLED" ]; then
  verdict="PRESENT"
  reason="body=$body_verdict (phone being moved/held)"
  [ "$ble_verdict" = "PRESENT_STRONG" ] && reason="$reason + $ble_reason"
elif [ "$ble_verdict" = "PRESENT_STRONG" ]; then
  verdict="PRESENT"
  reason="$ble_reason"
  [ "$body_verdict" != "UNKNOWN" ] && [ "$body_verdict" != "STILL" ] && reason="$reason + body=$body_verdict"
elif [ "$wifi_verdict" = "MOTION" ]; then
  verdict="PRESENT"
  reason="WiFi RSSI motion detected"
  [ "$light_verdict" = "LIT" ] && reason="$reason + room lit"
  [ -n "$ble_reason" ] && reason="$reason + $ble_reason"
  [ "$body_verdict" != "UNKNOWN" ] && [ "$body_verdict" != "STILL" ] && reason="$reason + body=$body_verdict"
elif [ "$wifi_verdict" = "STILL" ] && [ "$light_verdict" = "DARK" ] && [ "$ble_verdict" = "NONE" ] \
     && [ "$body_verdict" != "CARRIED" ] && [ "$body_verdict" != "HANDLED" ]; then
  verdict="EMPTY"
  reason="WiFi STILL + ambient DARK + no known BLE + body=$body_verdict"
elif [ "$wifi_verdict" = "STILL" ] && [ "$light_verdict" = "DARK" ] && [ "$ble_verdict" = "PRESENT_WEAK" ] \
     && [ "$body_verdict" != "CARRIED" ] && [ "$body_verdict" != "HANDLED" ]; then
  verdict="EMPTY"
  reason="WiFi STILL + ambient DARK (TV BLE not occupancy) + body=$body_verdict"
elif [ "$phone_ok" = 0 ] && [ "$ble_ok" = 0 ]; then
  # Can't assess at all
  if [ ! -f "$OFFLINEFILE" ]; then echo "mesh-room-sense: phone unreachable AND BLE scan failed — cannot assess" >&2; touch "$OFFLINEFILE"; fi
  exit 2
elif [ "$phone_ok" = 0 ]; then
  # BLE only, no phone
  if [ "$ble_verdict" = "PRESENT_STRONG" ]; then
    verdict="PRESENT"; reason="$ble_reason (phone offline, BLE only)"
  elif [ "$ble_verdict" = "PRESENT_WEAK" ]; then
    verdict="UNCERTAIN"; reason="TV BLE visible, phone offline — cannot confirm"
  else
    verdict="UNCERTAIN"; reason="phone offline, no strong BLE — cannot assess"
  fi
elif [ "$wifi_verdict" != "STILL" ] || [ "$light_verdict" = "LIT" ] || [ "$ble_verdict" != "NONE" ] \
     || [ "$body_verdict" = "COVERED" ]; then
  verdict="UNCERTAIN"
  reason="mixed signals: wifi=$wifi_verdict light=$light_verdict ble=$ble_verdict body=$body_verdict"
fi

signals="ble=${ble_verdict} body=${body_verdict} wifi=${wifi_verdict} light=${light_verdict}"

case "$MODE" in
  json)
    printf '{"verdict":"%s","signals":"%s","reason":"%s","ts":"%s","phone_ok":%s,"ble_ok":%s,"body":"%s"}\n' \
      "$verdict" "$signals" "$reason" "$TS" "$phone_ok" "$ble_ok" "$body_verdict"
    ;;
  edge)
    # 2-consecutive-scan debounce: a threshold-straddling sensor can flip PRESENT↔UNCERTAIN
    # every scan. Only fire after 2 consecutive same verdicts.
    # STATE = confirmed verdict; PENDING = "verdict:count" for the in-progress candidate.
    PENDING="${STATE%.state}.pending"
    confirmed="$(cat "$STATE" 2>/dev/null || true)"
    pending_line="$(cat "$PENDING" 2>/dev/null || true)"
    pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

    if [ -z "$confirmed" ]; then
      # First run: seed silently
      printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
    elif [ "$verdict" = "$confirmed" ]; then
      rm -f "$PENDING"   # stable — clear any in-progress candidate
    elif [ "$verdict" = "$pending" ]; then
      pcount=$((pcount + 1))
      if [ "$pcount" -ge 2 ]; then
        # Two consecutive readings agree — genuine change
        printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
        printf '[room-sense] %s — %s (%s)\n' "$verdict" "$reason" "$signals"
      else
        printf '%s:%d\n' "$verdict" "$pcount" > "$PENDING"
      fi
    else
      # New candidate — start fresh pending (count=1)
      printf '%s:1\n' "$verdict" > "$PENDING"
    fi
    # touch every run so the state-file mtime tracks last-RUN (liveness), not last-CHANGE —
    # else a stable verdict reads as a dead reflex to the sensorium roll-call's age/STALE check.
    [ -e "$STATE" ] && touch "$STATE" 2>/dev/null || printf '%s\n' "$verdict" > "$STATE"
    ;;
  *)
    printf 'room-sense: %s — %s [%s]\n' "$verdict" "$reason" "$signals"
    ;;
esac
