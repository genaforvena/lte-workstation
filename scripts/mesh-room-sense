#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-room-sense — room OCCUPANCY fusion: is someone in the room?
# Folds BLE presence (local) + ambient-level mic (local) + keyboard activity (local)
#   + body-motion + WiFi motion + ambient light (phone) → PRESENT/EMPTY/UNCERTAIN.
#
# Usage:
#   mesh-room-sense           one-shot verdict to stdout
#   mesh-room-sense --edge    only emit when verdict changes (for cron wiring)
#   mesh-room-sense --json    machine-readable JSON {verdict, occupancy, confidence, degraded, signals, reason, ts}
#   mesh-room-sense --test    smoke test (no scan)
#
# Signals (all best-effort — a missing signal degrades to UNCERTAIN, never fakes a clear):
#   Keyboard (IdeaPad-local):    TYPING → definitive PRESENT; LIGHT → corroborating; IDLE → neutral
#   BLE (IdeaPad-local):         named device visible at rssi > -82 → PRESENT weight
#   Ambient level (IdeaPad mic): SILENCE→empty weight, MODERATE/LOUD→present weight
#   Body motion (phone):         CARRIED/HANDLED = strong occupancy (mesh-body-motion)
#   WiFi motion (phone):         MOTION/STILL/UNCERTAIN (mesh-wifi-motion)
#   Ambient light (phone):       5 levels (mesh-light): DARK/DIM→LOW, MODERATE/LIT/BRIGHT→LIT
#
# Fusion:
#   PRESENT  if: body=CARRIED|HANDLED OR named BLE strong (≥-82) OR wifi=MOTION
#            OR (ambient=MODERATE|LOUD AND phone offline — sound proves occupancy)
#   EMPTY    if: wifi=STILL AND light=DARK AND body≠CARRIED|HANDLED AND no strong named BLE
#            AND (ambient=SILENCE|QUIET OR ambient unknown)
#   UNCERTAIN if: phone offline (can't assess WiFi/light/body) OR all signals weak/mixed
#
# Exit codes (honest-exit contract):
#   0 = verdict assessed (may be UNCERTAIN if signals conflict)
#   2 = cannot assess at all (BLE scan failed AND phone unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
OFFLINEFILE="$HOME/.mesh/.room-sense-offline"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH_DIR/.room-sense.state"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no"
PHONE_IP="${PHONE_IP:-$(mesh-peer-addr Redmi 2>/dev/null || true)}"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
BLE_RSSI_THRESHOLD="${MESH_ROOM_RSSI:--82}"

# Source canonical BLE patterns from mesh-patterns.sh (DRY — avoids drift).
# MESH_PERSON_RE = mobile person-devices (STRONG for occupancy).
# MESH_FIXED_RE  = stationary appliances (WEAK — only corroborate, never drive PRESENT alone).
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then
  . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
elif [ -f "$HOME/.local/bin/mesh-patterns" ]; then
  . "$HOME/.local/bin/mesh-patterns" 2>/dev/null || true
fi
STRONG_BLE_PATTERNS="${MESH_PERSON_RE:-JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi}"
WEAK_BLE_PATTERNS="${MESH_FIXED_RE:-\\[TV\\]|MiTV|Bose}"

# --- Fusion engine (extracted for testability) ---
# Usage: _fuse_verdict body_verdict ble_verdict ble_reason wifi_verdict light_verdict phone_ok ble_ok ambient_level kbd_verdict
# Sets verdict, reason, signals globals. Returns 0 (assessed) or 2 (cannot assess).
_fuse_verdict() {
  local bd="$1" bl="$2" br="$3" wf="$4" lt="$5" po="$6" bo="$7" al="${8:-UNKNOWN}" kd="${9:-UNKNOWN}"
  verdict="UNCERTAIN"; reason=""; signals=""
  if [ "$bd" = "CARRIED" ] || [ "$bd" = "HANDLED" ]; then
    verdict="PRESENT"; reason="body=$bd (phone being moved/held)"
    [ "$bl" = "PRESENT_STRONG" ] && reason="$reason + $br"
  elif [ "$kd" = "TYPING" ]; then
    # Keyboard TYPING is a definitive local signal: operator is at this machine.
    # Checked before BLE/wifi so phone-offline can't suppress it.
    verdict="PRESENT"; reason="keyboard TYPING on IdeaPad"
    [ "$bl" = "PRESENT_STRONG" ] && reason="$reason + $br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$bl" = "PRESENT_STRONG" ]; then
    verdict="PRESENT"; reason="$br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$wf" = "MOTION" ]; then
    verdict="PRESENT"; reason="WiFi RSSI motion detected"
    [ "$lt" = "LIT" ] && reason="$reason + room lit"
    [ -n "$br" ] && reason="$reason + $br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$bl" = "NONE" ] \
       && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ]; then
    verdict="EMPTY"; reason="WiFi STILL + ambient LOW + no known BLE + body=$bd"
  elif [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$bl" = "PRESENT_WEAK" ] \
       && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ]; then
    verdict="EMPTY"; reason="WiFi STILL + ambient LOW (TV BLE not occupancy) + body=$bd"
  elif [ "$po" = 0 ] && [ "$bo" = 0 ]; then
    # Phone AND BLE both offline — but local signals (mic + keyboard) may still prove occupancy
    if [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; then
      verdict="PRESENT"; reason="ambient $al (mic hears activity, no phone/BLE)"
      return 0
    elif [ "$al" = "SILENCE" ] || [ "$al" = "QUIET" ]; then
      verdict="UNCERTAIN"; reason="ambient $al but no phone/BLE to confirm — quiet≠empty"
      return 0
    fi
    return 2
  elif [ "$po" = 0 ]; then
    if [ "$bl" = "PRESENT_STRONG" ]; then
      verdict="PRESENT"; reason="$br (phone offline, BLE only)"
    elif [ "$bl" = "PRESENT_WEAK" ]; then
      verdict="UNCERTAIN"; reason="TV BLE visible, phone offline — cannot confirm"
    elif [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; then
      verdict="PRESENT"; reason="ambient $al + phone offline (mic hears activity)"
    else
      verdict="UNCERTAIN"; reason="phone offline, no strong BLE — cannot assess"
    fi
  elif [ "$wf" != "STILL" ] || [ "$lt" = "LIT" ] || [ "$bl" != "NONE" ] || [ "$bd" = "COVERED" ]; then
    verdict="UNCERTAIN"; reason="mixed signals: wifi=$wf light=$lt ble=$bl body=$bd"
  fi
  signals="kbd=${kd} ble=${bl} body=${bd} wifi=${wf} light=${lt} ambient=${al}"
  return 0
}

_derive_occupancy() {
  local vd="$1" bd="$2" bl="$3" wf="$4" lt="$5" po="$6" bo="$7" al="${8:-UNKNOWN}" kd="${9:-UNKNOWN}"
  local degraded_parts=()
  occupancy="UNKNOWN"
  confidence="low"
  degraded="none"

  [ "$po" = 1 ] || degraded_parts+=("phone-unreachable")
  [ "$bo" = 1 ] || degraded_parts+=("ble-unavailable")
  [ "$bd" != "UNKNOWN" ] || degraded_parts+=("body-unknown")
  [ "$wf" != "UNKNOWN" ] || degraded_parts+=("wifi-unknown")
  [ "$lt" != "UNKNOWN" ] || degraded_parts+=("light-unknown")
  [ "$al" != "UNKNOWN" ] || degraded_parts+=("ambient-unknown")
  [ "$kd" != "UNKNOWN" ] || degraded_parts+=("kbd-unknown")

  case "$vd" in
    PRESENT)
      occupancy="OCCUPIED"
      confidence="medium"
      if [ "$bd" = "CARRIED" ] || [ "$bd" = "HANDLED" ] || [ "$kd" = "TYPING" ] || [ "$bl" = "PRESENT_STRONG" ] || [ "$wf" = "MOTION" ]; then
        confidence="high"
      elif [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; then
        confidence="medium"
      fi
      ;;
    EMPTY)
      occupancy="EMPTY"
      confidence="medium"
      [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$po" = 1 ] && confidence="high"
      ;;
    *)
      occupancy="UNKNOWN"
      confidence="low"
      ;;
  esac

  if [ "${#degraded_parts[@]}" -gt 0 ]; then
    local IFS=,
    degraded="${degraded_parts[*]}"
  fi
}

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
}

[ "${1:-}" = --test ] && {
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  [ -d "$MESH_DIR" ] || { echo "smoke-test: FAIL (no $MESH_DIR)"; exit 1; }
  # Exercise the fusion engine directly with synthetic args, no sensor subprocesses.
  # _fuse_verdict sets globals verdict/reason/signals and returns 0 or 2.
  # Case 1: body=CARRIED (+ any BLE) → PRESENT
  _fuse_verdict 'CARRIED' 'NONE' '' 'STILL' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: body CARRIED should give PRESENT (got $verdict)"; exit 1; }
  # Case 2: strong BLE only → PRESENT
  _fuse_verdict 'STILL' 'PRESENT_STRONG' 'JBL at -68' 'STILL' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: strong BLE should give PRESENT (got $verdict)"; exit 1; }
  # Case 3: wifi MOTION (+ still, DARK, no BLE) → PRESENT
  _fuse_verdict 'STILL' 'NONE' '' 'MOTION' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: wifi MOTION should give PRESENT (got $verdict)"; exit 1; }
  # Case 4: no strong anything + wifi STILL + light LOW → EMPTY
  _fuse_verdict 'STILL' 'NONE' '' 'STILL' 'LOW' 1 1
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: nothing active + STILL LOW should give EMPTY (got $verdict)"; exit 1; }
  # Case 5: weak BLE + STILL + LOW → EMPTY (TV BLE not occupancy)
  _fuse_verdict 'STILL' 'PRESENT_WEAK' 'TV' 'STILL' 'LOW' 1 1
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: weak BLE + STILL LOW should give EMPTY (got $verdict)"; exit 1; }
  # Case 6: phone offline + strong BLE → PRESENT
  _fuse_verdict 'UNKNOWN' 'PRESENT_STRONG' 'JBL' 'UNKNOWN' 'UNKNOWN' 0 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: offline + strong BLE should give PRESENT (got $verdict)"; exit 1; }
  # Case 7: phone offline + no strong BLE → UNCERTAIN
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: offline + no BLE should give UNCERTAIN (got $verdict)"; exit 1; }
  # Case 8: phone+BLE both offline → exit 2 (return 2)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 && { echo "  FAIL: both offline should return 2"; exit 1; }
  # Case 9: mixed signals (wifi=STILL, light=LIT, no BLE) → UNCERTAIN
  _fuse_verdict 'STILL' 'NONE' '' 'STILL' 'LIT' 1 1
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: mixed STILL+LIT should give UNCERTAIN (got $verdict)"; exit 1; }
  # Case 10: body HANDLED → PRESENT
  _fuse_verdict 'HANDLED' 'NONE' '' 'STILL' 'DARK' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: body HANDLED should give PRESENT (got $verdict)"; exit 1; }
  # Case 11: phone+BLE offline but ambient LOUD → PRESENT (mic hears activity)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: all-offline + LOUD should give PRESENT (got $verdict)"; exit 1; }
  # Case 12: phone+BLE offline + ambient SILENCE → UNCERTAIN (quiet ≠ empty)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'SILENCE'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: all-offline + SILENCE should give UNCERTAIN (got $verdict)"; exit 1; }
  # Case 13: phone offline + no BLE + ambient MODERATE → PRESENT
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'MODERATE'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: phone-offline + MODERATE should give PRESENT (got $verdict)"; exit 1; }
  # Case 14: unreachable phone is visible degradation, not EMPTY/all-clear.
  _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 1 'QUIET'
  [ "$occupancy" = "UNKNOWN" ] || { echo "  FAIL: degraded offline should be UNKNOWN occupancy (got $occupancy)"; exit 1; }
  printf '%s' "$degraded" | grep -q 'phone-unreachable' || { echo "  FAIL: degraded offline should mention phone-unreachable (got $degraded)"; exit 1; }
  # Case 15: a genuine empty room keeps a different artifact from unreachable.
  _derive_occupancy 'EMPTY' 'STILL' 'NONE' 'STILL' 'LOW' 1 1 'QUIET'
  [ "$occupancy" = "EMPTY" ] || { echo "  FAIL: genuine empty should be EMPTY occupancy (got $occupancy)"; exit 1; }
  [ "$confidence" = "high" ] || { echo "  FAIL: genuine empty with phone evidence should be high confidence (got $confidence)"; exit 1; }
  printf '%s' "$degraded" | grep -q 'phone-unreachable' && { echo "  FAIL: genuine empty should not mention phone-unreachable (got $degraded)"; exit 1; }
  # Case 16: kbd TYPING → PRESENT even with phone offline and no BLE (local-only proof)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'SILENCE' 'TYPING'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: kbd TYPING + all offline should give PRESENT (got $verdict)"; exit 1; }
  # Case 17: kbd TYPING → high confidence in _derive_occupancy
  _derive_occupancy 'PRESENT' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 1 'SILENCE' 'TYPING'
  [ "$confidence" = "high" ] || { echo "  FAIL: kbd TYPING should give high confidence (got $confidence)"; exit 1; }
  # Case 18 (FALSIFIABLE): a SUSPECT/BUSY presence read is UNSAMPLED, never a confident empty.
  # Locks the READ-path classifier (case "$ble_out" in *BUSY*|*SUSPECT*) so the mesh-presence
  # honest-degraded n=0 never feeds a false "no BLE present" into occupancy.
  case "=== mesh-presence x — SUSPECT: 0 of 7 known device(s) gave a fresh RSSI ===" in
    *BUSY*|*SUSPECT*) : ;; *) echo "  FAIL: SUSPECT presence not flagged unsampled"; exit 1;; esac
  case "=== mesh-presence x — BUSY (adapter scan-locked) ===" in
    *BUSY*|*SUSPECT*) : ;; *) echo "  FAIL: BUSY presence not flagged unsampled"; exit 1;; esac
  case "=== mesh-presence x — 3 device(s) in range ===" in
    *BUSY*|*SUSPECT*) echo "  FAIL: real scan wrongly flagged unsampled"; exit 1;; esac
  echo "smoke-test: ok (15 fusion + 4 derived + 3 unsampled-presence assertions)"; exit 0
}

MODE=oneshot
[ "${1:-}" = --edge ] && MODE=edge
[ "${1:-}" = --json ] && MODE=json

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- BLE scan (IdeaPad-local, no phone needed) ---
ble_verdict="NONE"
ble_reason=""
ble_out="$(mesh-presence 3 2>/dev/null)" || true
# A BUSY (adapter scan-locked) or SUSPECT (mesh-presence's n=0 honest-degraded path: known devices but
# 0 fresh RSSI = race-cleared cache) read has the header but NO device rows — it is NOT a successful
# empty scan. Treating it as ble_ok=1 + ble_verdict=NONE would feed a FALSE "no BLE present" into the
# occupancy fusion (the exact false-empty we refuse). Mark BLE UNSAMPLED so it degrades to UNCERTAIN.
case "$ble_out" in
  *BUSY*|*SUSPECT*) ble_out=""; ble_verdict="UNKNOWN"; ble_reason="BLE unsampled (degraded read)" ;;
esac
if [ -n "$ble_out" ]; then
  # Check for strong named devices (non-? names, strong RSSI)
  while IFS='|' read -r rssi mac name; do
    [ -z "$name" ] || [ "$name" = '?' ] && continue
    [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]] && continue  # bare MAC = unnamed
    rssi_num="${rssi//[^0-9-]/}"
    [ -z "$rssi_num" ] && continue
    if [ "$rssi_num" -ge "$BLE_RSSI_THRESHOLD" ] 2>/dev/null; then
      if printf '%s' "$name" | grep -qE "$STRONG_BLE_PATTERNS"; then
        ble_verdict="PRESENT_STRONG"
        ble_reason="named BLE '$name' at ${rssi} dBm"
        break
      elif printf '%s' "$name" | grep -qE "$WEAK_BLE_PATTERNS"; then
        ble_verdict="PRESENT_WEAK"
        ble_reason="TV/static BLE '$name' at ${rssi} dBm"
      fi
    fi
  done < <(printf '%s\n' "$ble_out" | grep -E '^-?[0-9]+\|')
fi
ble_ok=$( [ -n "$ble_out" ] && echo 1 || echo 0 )

# --- Persist BLE RSSI state (per-device snapshot) ---
BLE_RSSI_STATE="$HOME/.mesh/.room-sense-ble-rssi"
if [ -n "$ble_out" ]; then
  printf '%s\n' "$ble_out" | grep -E '^-?[0-9]+\|' | while IFS='|' read -r rssi mac name; do
    [ -z "$name" ] || [ "$name" = '?' ] && continue
    [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]] && continue
    echo "$name:$rssi"
  done > "$BLE_RSSI_STATE"
fi

# --- Ambient level (IdeaPad mic, local — no phone needed) ---
# mesh-ambient-level reads 1s of audio → RMS dB → SILENCE/QUIET/MODERATE/LOUD
# MODERATE/LOUD = sound activity in the room = occupancy weight when phone offline
ambient_level="UNKNOWN"
if command -v mesh-ambient-level >/dev/null 2>&1; then
  al_out="$(timeout 5 mesh-ambient-level 2>/dev/null)" || true
  if printf '%s' "$al_out" | grep -q 'LOUD'; then
    ambient_level="LOUD"
  elif printf '%s' "$al_out" | grep -q 'MODERATE'; then
    ambient_level="MODERATE"
  elif printf '%s' "$al_out" | grep -q 'QUIET'; then
    ambient_level="QUIET"
  elif printf '%s' "$al_out" | grep -q 'SILENCE'; then
    ambient_level="SILENCE"
  fi
fi

# --- Keyboard activity (IdeaPad-local, no phone needed) ---
# Read the confirmed state from mesh-kbd-activity (cron: 3-59/5 --edge writes on transitions).
# TYPING = operator is actively typing → definitive PRESENT.
# LIGHT  = occasional key events → weak corroborating signal (not used to force PRESENT alone).
# IDLE   = no keyboard events in last assessment window → neutral.
kbd_verdict="UNKNOWN"
if [ -f "$HOME/.mesh/.kbd-activity.state" ]; then
  kbd_verdict="$(cat "$HOME/.mesh/.kbd-activity.state" 2>/dev/null || echo UNKNOWN)"
fi

# --- WiFi motion (phone) ---
# mesh-wifi-motion and mesh-light run locally and SSH to the phone themselves.
# DO NOT SSH-wrap them — $HOME/.local/bin/ is IdeaPad-local, not a Termux path.
wifi_verdict="UNKNOWN"
phone_ok=0
_wifi_rc=0
# Quick pre-check avoids 12s timeout when phone clearly offline
if [ -n "$PHONE_IP" ] && timeout 2 bash -c "echo >/dev/tcp/$PHONE_IP/$PHONE_PORT" 2>/dev/null; then
  wifi_out="$(timeout 12 mesh-wifi-motion 2>/dev/null)" || _wifi_rc=$?
else
  _wifi_rc=2
fi
if [ "$_wifi_rc" = 2 ]; then
  phone_ok=0   # phone unreachable (honest exit 2 from mesh-wifi-motion)
else
  phone_ok=1
  rm -f "$OFFLINEFILE"
  if printf '%s' "$wifi_out" | grep -q 'MOTION'; then
    wifi_verdict="MOTION"
  elif printf '%s' "$wifi_out" | grep -q 'STILL'; then
    wifi_verdict="STILL"
  elif printf '%s' "$wifi_out" | grep -q 'UNCERTAIN'; then
    wifi_verdict="UNCERTAIN"
  fi
fi

# --- Ambient light (phone) — 5 levels mapped to LOW/LIT for fusion ---
# mesh-light now classifies DARK/DIM/MODERATE/LIT/BRIGHT (full 0-65K lux range).
# For occupancy fusion, map to binary: DARK|DIM → LOW (dark signals → EMPTY),
# MODERATE|LIT|BRIGHT → LIT (bright signals → PRESENT).
light_verdict="UNKNOWN"
if [ "$phone_ok" = 1 ]; then
  light_out="$(timeout 10 mesh-light 2>/dev/null)" || true
  if printf '%s' "$light_out" | grep -qE 'BRIGHT|LIT|MODERATE'; then
    light_verdict="LIT"
  elif printf '%s' "$light_out" | grep -qE 'DARK|DIM'; then
    light_verdict="LOW"
  fi
fi

# --- Body motion (phone) — strongest occupancy signal ---
body_verdict="UNKNOWN"
if [ "$phone_ok" = 1 ]; then
  body_out="$(timeout 14 mesh-body-motion 2>/dev/null)" || true
  if printf '%s' "$body_out" | grep -q '\[body-carried\]'; then
    body_verdict="CARRIED"
  elif printf '%s' "$body_out" | grep -q '\[body-handled\]'; then
    body_verdict="HANDLED"
  elif printf '%s' "$body_out" | grep -q '\[body-covered\]'; then
    body_verdict="COVERED"
  elif printf '%s' "$body_out" | grep -q '\[body-still\]'; then
    body_verdict="STILL"
  fi
fi

# --- Fusion ---
_fuse_verdict "$body_verdict" "$ble_verdict" "$ble_reason" "$wifi_verdict" "$light_verdict" "$phone_ok" "$ble_ok" "$ambient_level" "$kbd_verdict" && ec=0 || ec=$?
if [ "$ec" = 2 ]; then
  if [ ! -f "$OFFLINEFILE" ]; then echo "mesh-room-sense: phone unreachable AND BLE scan failed — cannot assess" >&2; touch "$OFFLINEFILE"; fi
  exit 2
fi
_derive_occupancy "$verdict" "$body_verdict" "$ble_verdict" "$wifi_verdict" "$light_verdict" "$phone_ok" "$ble_ok" "$ambient_level" "$kbd_verdict"

case "$MODE" in
  json)
    printf '{"verdict":"%s","occupancy":"%s","confidence":"%s","degraded":"%s","signals":%s,"reason":%s,"ts":"%s","phone_ok":%s,"ble_ok":%s,"body":"%s","ambient":"%s","kbd":"%s"}\n' \
      "$verdict" "$occupancy" "$confidence" "$degraded" "$(printf '%s' "$signals" | json_escape)" "$(printf '%s' "$reason" | json_escape)" "$TS" "$phone_ok" "$ble_ok" "$body_verdict" "$ambient_level" "$kbd_verdict"
    ;;
  edge)
    # 2-consecutive-scan debounce: a threshold-straddling sensor can flip PRESENT↔UNCERTAIN
    # every scan. Only fire after 2 consecutive same verdicts.
    # STATE = confirmed verdict; PENDING = "verdict:count" for the in-progress candidate.
    PENDING="${STATE%.state}.pending"
    confirmed="$(cat "$STATE" 2>/dev/null || true)"
    pending_line="$(cat "$PENDING" 2>/dev/null || true)"
    pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

    if [ -z "$confirmed" ]; then
      # First run: seed silently
      printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
    elif [ "$verdict" = "$confirmed" ]; then
      rm -f "$PENDING"   # stable — clear any in-progress candidate
    elif [ "$verdict" = "$pending" ]; then
      pcount=$((pcount + 1))
      if [ "$pcount" -ge 2 ]; then
        # Two consecutive readings agree — genuine change
        printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
        printf '[room-sense] %s occupancy=%s confidence=%s degraded=%s — %s (%s)\n' "$verdict" "$occupancy" "$confidence" "$degraded" "$reason" "$signals"
      else
        printf '%s:%d\n' "$verdict" "$pcount" > "$PENDING"
      fi
    else
      # New candidate — start fresh pending (count=1)
      printf '%s:1\n' "$verdict" > "$PENDING"
    fi
    # touch every run so the state-file mtime tracks last-RUN (liveness), not last-CHANGE —
    # else a stable verdict reads as a dead reflex to the sensorium roll-call's age/STALE check.
    [ -e "$STATE" ] && touch "$STATE" 2>/dev/null || printf '%s\n' "$verdict" > "$STATE"
    ;;
  *)
    printf 'room-sense: %s occupancy=%s confidence=%s degraded=%s — %s [%s]\n' "$verdict" "$occupancy" "$confidence" "$degraded" "$reason" "$signals"
    ;;
esac
