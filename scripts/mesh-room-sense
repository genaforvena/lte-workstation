#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-state: $HOME/.mesh/.room-sense.state
# reflex-args: --edge
# mesh-room-sense — room OCCUPANCY fusion: is someone in the room?
# Folds BLE presence (local) + ambient-level mic (local) + keyboard activity (local)
#   + screen power/backlight (local) + body-motion + WiFi motion + ambient light (phone)
#   → PRESENT/EMPTY/UNCERTAIN.
#
# Usage:
#   mesh-room-sense           one-shot verdict to stdout
#   mesh-room-sense --edge    only emit when verdict changes (for cron wiring)
#   mesh-room-sense --json    machine-readable JSON {verdict, occupancy, confidence, room_mode, degraded, signals, reason, ts}
#   mesh-room-sense --status  non-blocking cached read: last CONFIRMED verdict + age (no BLE scan,
#                             no phone SSH, no mic/cam reads, no writes) — the fusion has 7+ live
#                             sub-reads (BLE/mic/kbd/cam/phone-SSH triad), so a dash/consumer that
#                             wants "what does room-sense currently think" was forced to pay the FULL
#                             multi-second fusion every poll, same gap mesh-light/mesh-body-motion/
#                             mesh-tamper already closed with their own --status. Read-only (memory:
#                             status-read-shares-write-path-mutates — never touches $STATE).
#   mesh-room-sense --redundancy  read-only AUDIT: is this fusion's state CONFINED to one channel, or
#                             REDUNDANTLY carried by the surviving families? Ablates the target's own
#                             derivatives, scores each remaining family against a circular-shift null,
#                             and refuses to answer unless a built-in positive control clears that
#                             null. Reads the UNGATED observation tape and REFUSES the wake-gated log.
#                             See CHANNEL REDUNDANCY below. exit 0 = answered, 2 = honest n/a.
#   mesh-room-sense --test    smoke test (no scan)
#
# Artifacts:
#   ~/.mesh/room-sense.log       WAKE-SIGNAL edge line — gated (PRESENT+confidence=high only, ~3% of
#                                runs). An actuator trigger, NOT a record of what the sense saw.
#   ~/.mesh/room-sense-tape.log  OBSERVATION TAPE — one line per --edge evaluation, unconditional:
#                                every verdict, every confidence level (see tape_room_eval). Read
#                                THIS for any question about the sense's own distribution.
#
# Signals (all best-effort — a missing signal degrades to UNCERTAIN, never fakes a clear):
#   Keyboard (IdeaPad-local):    TYPING → definitive PRESENT; LIGHT → corroborating; IDLE → neutral
#   BLE (IdeaPad-local):         named device visible at rssi > -82 → PRESENT weight; a NAMELESS
#                                RANDOM-MAC (privacy-rotating phone/wearable) at NEAR (> -75) → person
#                                weight too (attribution × proximity — catches privacy-rotating phones
#                                that carry no name; PUBLIC nameless MAC = appliance, NOT counted)
#   Ambient level (IdeaPad mic): SILENCE→empty weight, MODERATE/LOUD→present weight
#   Ambient clock (neighbor TV / fixed-appliance context): ACTIVE/MODERATE can explain loud
#     room audio as external appliance activity instead of occupancy; used as an honest
#     disambiguator, never as a standalone presence proof.
#   Screen power/backlight (IdeaPad-local): OFF corroborates vacancy; ON/DIM/BRIGHT are
#     cautionary only, never a standalone presence proof.
#   Self-playback (IdeaPad-local, mesh-audio-active /proc/asound): PLAYING = this node's own
#     speakers are emitting (nightly room-music grind) → the mic's MODERATE/LOUD is self-noise,
#     so "sound proves occupancy" is discounted to UNCERTAIN. Never a presence OR vacancy proof;
#     UNKNOWN (no tool / no card) cannot discount (2026-07-06).
#   Body motion (phone):         WALKING/CARRIED/HANDLED = strong occupancy (mesh-body-motion);
#                                VEHICLE mapped but kept neutral (a body in transit most often means
#                                the person left the monitored space — never asserted as PRESENT or
#                                EMPTY on that signal alone, sense-enrichment 2026-07-09)
#   WiFi motion (phone):         MOTION/STILL/UNCERTAIN (mesh-wifi-motion)
#   Ambient light (phone/webcam): mesh-light phone lux DARK/DIM→LOW, MODERATE/LIT/BRIGHT→LIT;
#                                webcam-coarse fallback DARK/DIM→LOW, TWILIGHT/LIT→LIT (phone offline)
#
# Fusion:
#   PRESENT  if: body=WALKING|CARRIED|HANDLED OR named BLE strong (≥-82) OR wifi=MOTION
#            OR (ambient=MODERATE|LOUD AND phone offline — sound proves occupancy)
#   EMPTY    if: wifi=STILL AND light=DARK AND body≠WALKING|CARRIED|HANDLED AND no strong named BLE
#            AND (ambient=SILENCE|QUIET OR ambient unknown)
#   UNCERTAIN if: phone offline (can't assess WiFi/light/body) OR all signals weak/mixed
#
# Exit codes (honest-exit contract):
#   0 = verdict assessed (may be UNCERTAIN if signals conflict)
#   2 = cannot assess at all (BLE scan failed AND phone unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
OFFLINEFILE="$HOME/.mesh/.room-sense-offline"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH_DIR/.room-sense.state"
EVENTS="$MESH_DIR/.room-sense-events"  # one epoch per verdict change, self-prunes to 24h
# Tape path/retention defined HERE (not beside tape_room_eval, where its long rationale lives — see
# the OBSERVATION TAPE block below) because the read-only --redundancy dispatch runs above the live
# probes and must resolve the same path. ONE definition, two readers.
ROOM_TAPE="${ROOM_TAPE:-$MESH_DIR/room-sense-tape.log}"
ROOM_TAPE_KEEP="${ROOM_TAPE_KEEP:-4032}"   # 14 days at the 2-59/5 cadence (288/day)

# BLIND_GAP_S — the width above which a hole in the tape means "this sense was not observing",
# not "cron jittered". Measured on this node's own tape, 1196 consecutive gaps: median 300.0s,
# p90 301s, p99 312s, and exactly FOUR gaps over 900s (1562, 4199, 21901, 32998) — every one a
# real outage, the largest being the 2026-08-22T00:32:04Z→09:42:02Z power-off. 3x the tool's own
# cadence separates them with two orders of magnitude of room on either side.
BLIND_GAP_S="${BLIND_GAP_S:-900}"

# --status: READ-ONLY cached read of the last CONFIRMED (edge-debounced) verdict — $STATE + its
# mtime, nothing else. MUST run before any of the live-probe setup below (mesh-phone-ip alone can
# block for 7s+ on a dozing/offline phone, on top of the full fusion's own BLE scan/mic/cam/SSH
# reads) — a consumer asking "what does room-sense currently think" was forced to pay that whole
# multi-second-to-tens-of-seconds cost every poll, the same gap mesh-light/mesh-body-motion/
# mesh-tamper already closed with their own --status. Never writes (memory: status-read-shares-
# write-path-mutates). $STATE is refreshed on EVERY successful --edge cron tick (2-59/5, this
# tool's own cadence), including runs where the verdict didn't change (the dwell-append near the
# bottom of the --edge branch touches it unconditionally) — so its mtime is real cron liveness,
# not just a last-verdict-change stamp.
if [ "${1:-}" = --status ]; then
  if [ -f "$STATE" ]; then
    raw="$(cat "$STATE" 2>/dev/null)"
    label="${raw%%|*}"
    mtime="$(stat -c %Y "$STATE" 2>/dev/null || echo 0)"
    age=$(( $(date +%s) - mtime ))
    dwell="$(printf '%s' "$raw" | grep -oE 'dwell_s=[0-9]+' | cut -d= -f2)"
    changes="$(printf '%s' "$raw" | grep -oE 'changes_24h=[0-9]+' | cut -d= -f2)"
    if [ -z "$label" ]; then
      echo "room-sense: cached state unreadable (empty)"; exit 2
    fi
    printf 'room-sense: %s (%ss ago%s%s)\n' "$label" "$age" \
      "${dwell:+, dwell_s=$dwell}" "${changes:+, changes_24h=$changes}"
    [ "$label" = "OFFLINE" ] && exit 2
    exit 0
  fi
  echo "room-sense: no cached state yet (never produced)"
  exit 2
fi

# --- CHANNEL REDUNDANCY (--redundancy): is this fusion's state CONFINED to one channel? ----------
# LIVE REVIEW 2026-08-17 (area: homeostasis / allostasis / ultrastability). Source: Cobb & Cobb-Ellis,
# "Predictive Allostatic Organization in Recurrent and Spiking Agents Under Partial Observability",
# arXiv:2608.11506v1 (2026-08-11), §4.3 + Fig.4 / App.B. Their ENERGY-CONTROL probe is the concept we
# did not embody: the agent's allostatic essential variable (low energy) stays STRONGLY DECODABLE
# after the EXPLICIT energy channel is ablated — internal dynamics without explicit energy terms
# ROC-AUC ~0.927, core dynamics without them ~0.886, against ~0.934 WITH the explicit variables. Their
# conclusion: "energy-relevant structure is distributed through internal dynamics rather than confined
# to a single explicit energy channel." The METHOD is feature-family controls — partition the recorded
# state into families and probe the target from each family with the explicit channel removed.
#
# WHY IT BINDS HERE. The mesh's honest-fusion rule ("an unreachable input renders UNKNOWN/partial,
# never a faked all-clear") is a rule about not FABRICATING; it is silent about REDUNDANCY. When a
# channel goes blind we render UNKNOWN/degraded and stop — nobody has ever asked whether the state
# that channel carried is still recoverable from the surviving families. Live case, this node, today:
# the BLE vantage was blind 16:20->17:10Z (hci0 firmware reload), presence.log took 0 lines, and
# downstream read ambient=DATA-STALE. Was occupancy still decodable from mic/wifi/light/cam in that
# window? Unasked. If it is REDUNDANT, an UNKNOWN is a CHOICE; if CONFINED, the UNKNOWN is NECESSARY
# and the real finding is that a 10-axis-looking fusion is, on the evidence, one axis wide.
#
#   mesh-room-sense --redundancy   read-only; never scans, never writes. exit 0 = answered
#                                  (REDUNDANT|CONFINED), exit 2 = honestly cannot answer.
#
# WHAT IT DOES, and the three ways this measurement lies if done naively:
#  1. IT READS THE UNGATED TAPE, AND REFUSES THE GATED LOG. room-sense.log is emitted only on
#     verdict=PRESENT && confidence=high — and that gate is itself a function of the BLE reading
#     (_ble_hard in _derive_occupancy). You cannot measure a channel's redundancy on a tape that was
#     SELECTED ON THAT CHANNEL: conditioning on the gate destroys the association you are testing.
#     Measured on the gated log for exactly this reason (n=255, 33 days) every surviving family came
#     back within-null — a number that means nothing, which is why pointing this mode at that file is
#     a refusal, not an option.
#  2. IT ABLATES THE TARGET'S OWN DERIVATIVES, AND NAMES WHAT IT ABLATED. presence_familiarity and
#     presence_session_max_s are computed FROM the BLE census; verdict/confidence/status/occupancy are
#     the fusion's own outputs. On the gated log room_mode scored AUC 0.750 vs a 0.683 null — the one
#     "ABOVE-NULL" family in the whole sweep, and pure leakage (room_mode=ACTIVE is set from
#     ble=PRESENT_STRONG). An unablated probe rediscovers the channel through its own shadow.
#  3. IT REFUSES FEATURES THAT CAN MEMORISE. presence_session_max_s carries 254 distinct values over
#     255 rows: scored in-sample it hits AUC 1.000 — and 1.000 against a CIRCULARLY SHIFTED target
#     too, which is the tell. Any family with more levels than N/CARD_DIV is reported MEMORISING, not
#     scored. (The joint of all survivors, 79 levels, hit 0.950 with a 0.975 null: same trap.)
# NULL: max AUC over ALL circular shifts of the target series — shift, not i.i.d. shuffle, because
# occupancy series are strongly autocorrelated and a permutation null is anticonservative on one
# (house standard, cooscillate-parametric-p finding). This is the paper's shuffled-partner control
# done correctly for time series.
# POSITIVE CONTROL: a probe that answers CONFINED because it is BLIND is indistinguishable from a
# probe that answers CONFINED because the state really is confined. So a synthetic 2-level family
# (the target with every RC_CTRL_FLIP-th row flipped) is scored in the same sweep and MUST land above
# the null; if it does not, the run reports PROBE-UNVALIDATED and refuses the verdict entirely.
# (No negative control: the two obvious ones are unsound here — a periodic label is invariant under a
# circular shift, and a blocky one is confounded with nonstationarity, so both would manufacture a
# false PROBE-UNVALIDATED rather than catch anything.)
# REPORT-ONLY, deliberately. The actuator this suggests — "fall back to family X while the channel is
# blind" — must not be wired off a measurement the node has not yet been able to make; and a CONFINED
# answer is an argument for ADDING an independent axis, not for inventing one.
if [ "${1:-}" = --redundancy ]; then
  _rc_tape="${MESH_RS_RED_TAPE:-$ROOM_TAPE}"
  case "$(basename "$_rc_tape")" in
    room-sense.log)
      echo "room-sense --redundancy: REFUSED — $_rc_tape is the WAKE-GATED edge log (emitted only on"
      echo "  PRESENT+high, a gate that reads the BLE channel itself). A redundancy answer computed on"
      echo "  a tape selected by the target channel is void by construction. Use the observation tape"
      echo "  ($ROOM_TAPE) or point MESH_RS_RED_TAPE at another UNGATED record."
      exit 2 ;;
  esac
  if [ ! -s "$_rc_tape" ]; then
    echo "room-sense --redundancy: n/a — no observation tape at $_rc_tape (nothing recorded yet)"
    exit 2
  fi
  command -v python3 >/dev/null 2>&1 || {
    echo "room-sense --redundancy: n/a — python3 absent (the probe needs it; no fallback that would"
    echo "  render a plausible number without doing the arithmetic)"; exit 2; }
  RC_TAPE="$_rc_tape" python3 - <<'PY'
import os, re, sys, collections

TAPE   = os.environ["RC_TAPE"]
TARGET = os.environ.get("MESH_RS_RED_TARGET", "ble")
# "the channel read nothing real" vs "the channel did not read at all": only the first is a usable
# negative. UNKNOWN/UNSAMPLED rows are DROPPED, never folded into the negative class — a blind read
# scored as an absence is the faked all-clear this whole file refuses.
ABSENT   = set(os.environ.get("MESH_RS_RED_ABSENT", "NONE,EMPTY").split(","))
BLIND    = set(os.environ.get("MESH_RS_RED_BLIND", "UNKNOWN,UNSAMPLED,BUSY,SUSPECT,n/a").split(","))
MIN_N    = int(os.environ.get("MESH_RS_RED_MIN_N", "200"))     # rows with a usable target
MIN_MIN  = int(os.environ.get("MESH_RS_RED_MIN_MINORITY", "20"))  # rows in the smaller target class
CARD_DIV = int(os.environ.get("MESH_RS_RED_CARD_DIV", "10"))   # levels > n/CARD_DIV => MEMORISING
MIN_EFF  = float(os.environ.get("MESH_RS_RED_MIN_EFF", "0.05"))# practical floor on |AUC-0.5|
CTRL_FLIP= int(os.environ.get("MESH_RS_RED_CTRL_FLIP", "5"))   # positive control: flip every Nth row
CADENCE_M= int(os.environ.get("MESH_RS_RED_CADENCE_MIN", "5")) # tape cadence, for the "answerable at"

# Families derived FROM the target channel, plus the fusion's own outputs (functions of it). Ablated
# and NAMED. Keyed by target so a different --target does not silently inherit ble's ablation list.
DERIVED = {
    "ble": ["presence_familiarity", "presence_session_max_s", "presence", "room_mode",
            "verdict", "confidence", "status", "occupancy", "degraded"],
}
ablated = DERIVED.get(TARGET, ["verdict", "confidence", "status", "occupancy", "degraded"])

# The tape CHAINS assignments — `... degraded=none signals=kbd=UNKNOWN screen=UNKNOWN ...`. A plain
# (\w+)=(value) scan eats `signals=kbd` as one pair, inventing a family "signals" and SILENTLY LOSING
# whichever real channel happens to sit first after `signals=`. The lookahead demands the value be
# followed by whitespace/EOL, so `signals=kbd` cannot match and `kbd=UNKNOWN` does.
FIELD_RE = re.compile(r"(\w+)=([^\s=]+)(?=\s|$)")
rows = []
for line in open(TAPE, errors="replace"):
    d = dict(FIELD_RE.findall(line))
    if TARGET in d:
        rows.append(d)

def fail(verdict, msg, extra=()):
    print(f"room-sense --redundancy: {verdict} — {msg}")
    for e in extra: print("  " + e)
    sys.exit(2)

if not rows:
    fail("n/a", f"no rows carrying {TARGET}= in {TAPE}")

usable = [r for r in rows if r[TARGET] not in BLIND]
y = [0 if r[TARGET] in ABSENT else 1 for r in usable]
n = len(y); pos = sum(y); neg = n - pos
minority = min(pos, neg)

if minority == 0:
    fail("NO-VARIANCE",
         f"{TARGET} never changed class over {n} usable rows (all "
         f"{'present' if pos else 'absent'}) — its redundancy is untestable, not confirmed",
         [f"tape={TAPE}  rows={len(rows)}  blind-dropped={len(rows)-n}"])

if n < MIN_N or minority < MIN_MIN:
    need = max(MIN_N - n, 0)
    hrs = (need * CADENCE_M) / 60.0
    fail("INSUFFICIENT",
         f"n={n} (need {MIN_N}), minority class={minority} (need {MIN_MIN}) — refusing to answer",
         [f"tape={TAPE}  rows={len(rows)}  blind-dropped={len(rows)-n}",
          f"answerable in ~{hrs:.1f}h of tape at the {CADENCE_M}-min cadence, if the minority class fills"])

def auc(x, yy):
    # Rank-AUC of the per-level empirical rate P(y=1 | level). Closed form over LEVELS (O(L^2)), not
    # over row pairs (O(pos*neg)) — the shift null re-scores this n-1 times and the pairwise form put
    # the smoke test past its runner's timeout.
    tab = collections.defaultdict(lambda: [0, 0])
    for xi, yi in zip(x, yy): tab[xi][yi] += 1
    # MERGE levels that share a score before ranking: two distinct levels with the same P(y=1|level)
    # are indistinguishable to the scorer, so their rows TIE (0.5) — ordering them by dict/sort order
    # would silently award one of them a win it did not earn.
    merged = collections.defaultdict(lambda: [0, 0])
    for c in tab.values():
        s = c[1] / (c[0] + c[1])
        merged[s][0] += c[1]; merged[s][1] += c[0]
    lv = sorted((s, m[0], m[1]) for s, m in merged.items())
    P = sum(l[1] for l in lv); Q = sum(l[2] for l in lv)
    if not P or not Q: return float("nan")
    t = 0.0; seen_q = 0
    for _, p, q in lv:            # ascending score: positives here beat all lower-scored negatives
        t += p * seen_q + 0.5 * p * q
        seen_q += q
    return t / (P * Q)

def shift_null(x):
    return max(auc(x, y[k:] + y[:k]) for k in range(1, n))

fams = sorted({k for r in usable for k in r
               if k not in ablated and k != TARGET and not k.startswith("_")})
control = ["FLIP" if (i % CTRL_FLIP == 0) != bool(yi) else "SAME" for i, yi in enumerate(y)]

results, ctrl_ok = [], False
for name, x in [(f, [r.get(f, "-") for r in usable]) for f in fams] + [("__control__", control)]:
    lv = len(set(x))
    if lv > max(2, n // CARD_DIV):
        results.append((name, lv, None, None, "MEMORISING"))
        continue
    o, nl = auc(x, y), shift_null(x)
    verd = "ABOVE-NULL" if (o > nl and abs(o - 0.5) >= MIN_EFF) else "within-null"
    if name == "__control__":
        ctrl_ok = verd == "ABOVE-NULL"
    else:
        results.append((name, lv, o, nl, verd))

print(f"room-sense --redundancy: target={TARGET} (present vs absent) on {TAPE}")
print(f"  n={n} usable rows (present={pos} absent={neg}), {len(rows)-n} blind-dropped; "
      f"null = max AUC over all {n-1} circular shifts")
print(f"  ablated as target-derived: {' '.join(ablated)}")
for name, lv, o, nl, verd in sorted(results, key=lambda r: (-(r[2] or 0), r[0])):
    if verd == "MEMORISING":
        print(f"  {name:22s} levels={lv:4d}  refused: MEMORISING (> n/{CARD_DIV} levels — an "
              f"in-sample fit here scores 1.000 against a shifted target too)")
    else:
        print(f"  {name:22s} levels={lv:4d}  auc={o:.3f}  null_max={nl:.3f}  {verd}")

if not ctrl_ok:
    print("room-sense --redundancy: PROBE-UNVALIDATED — the synthetic positive control "
          f"(target, with 1 row in every {CTRL_FLIP} flipped) did NOT clear its own null.")
    print("  The probe cannot see an association it was handed, so it cannot claim there is none. "
          "No verdict.")
    sys.exit(2)

carriers = [r for r in results if r[4] == "ABOVE-NULL"]
if carriers:
    print("room-sense --redundancy: REDUNDANT — " + ", ".join(f"{c[0]}(auc={c[2]:.3f})" for c in carriers)
          + f" carry {TARGET}'s state independently of it.")
    print(f"  So rendering UNKNOWN while {TARGET} is blind is a CHOICE, not a necessity. "
          "Report-only: no fallback is wired.")
else:
    print(f"room-sense --redundancy: CONFINED — no surviving family decodes {TARGET}'s state above "
          "its own shift null.")
    print(f"  The fusion names many axes, but on this evidence {TARGET} is the only carrier: its "
          "blindness is TOTAL blindness, and the honest UNKNOWN is necessary.")
    print("  This inverts the source result (energy stayed decodable at ~0.886-0.927 with the "
          "explicit channel ablated) — the redundancy is theirs, not ours.")
sys.exit(0)
PY
  exit $?
fi

AMBIENT_CLOCK_STATE="$MESH_DIR/.ambient-clock.state"
AMBIENT_CLOCK_STALE="${MESH_ROOM_AMBIENT_CLOCK_STALE:-2100}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no"
# Resolve the phone address LAN-FIRST. mesh-phone-ip does LAN discovery — the phone is often OFF
# Tailscale but reachable on the home LAN (192.168.8.x). mesh-peer-addr returns ONLY the Tailscale IP,
# which is CLOSED when the phone drops off the tailnet → room-sense would falsely mark phone-unreachable
# and drop the body/wifi/light axes even though the phone is reachable on LAN (observed 2026-06-21: phone
# at .203 OPEN, but mesh-peer-addr gave the closed 100.103.99.16 → all phone axes lost). Reachability is
# still gated by the real tcp probe below, so a stale cached IP degrades honestly. (Matches mesh-light.)
PHONE_IP="${PHONE_IP:-$(mesh-phone-ip 2>/dev/null | tail -1)}"
[ -n "$PHONE_IP" ] || PHONE_IP="$(mesh-peer-addr Redmi 2>/dev/null || true)"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
BLE_RSSI_THRESHOLD="${MESH_ROOM_RSSI:--82}"
# A nameless device carries NO name pattern, but its ADDRESS TYPE still carries person/appliance info:
# a RANDOM (locally-administered) BLE address is a privacy address advertised ~only by phones/wearables
# (fixed appliances use public OUI addresses) — so a nameless RANDOM-MAC at NEAR proximity is a PERSON
# occupancy signal that named-only BLE wholly misses. We demand a STRICTER proximity bar than named
# devices (a known name we trust further out; an attributed-but-nameless device must be genuinely in-room,
# not a neighbour's phone through a wall). Fuses mesh-presence's classify_addrtype × proximity.
PERSONAL_RSSI_THRESHOLD="${MESH_ROOM_PERSONAL_RSSI:--75}"

# Source canonical BLE patterns from mesh-patterns.sh (DRY — avoids drift).
# MESH_PERSON_RE = mobile person-devices (STRONG for occupancy).
# MESH_FIXED_RE  = stationary appliances (WEAK — only corroborate, never drive PRESENT alone).
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then
  . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
elif [ -f "$HOME/.local/bin/mesh-patterns" ]; then
  . "$HOME/.local/bin/mesh-patterns" 2>/dev/null || true
fi
STRONG_BLE_PATTERNS="${MESH_PERSON_RE:-JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi}"
WEAK_BLE_PATTERNS="${MESH_FIXED_RE:-\\[TV\\]|MiTV|Bose}"

# _is_random_mac <mac> → returns 0 (true) iff the MAC is a BLE RANDOM address — the privacy-rotating
# address advertised ~only by phones/wearables (fixed appliances use public OUIs).
# The U/L-bit (0x02 of the first octet) test that stood here until 2026-08-16 was NOT a discriminator on
# BLE — the spec fixes only bits 7:6 of a random address (11/01/00) and leaves bit 1 random, so ~half of
# all privacy addresses read "public" and public OUIs with the bit set read "random". Falsified live on
# this node's own room, 4 contacts misclassified against BlueZ's truth (see mesh-presence
# classify_addrtype). It is the WIFI rule (802.11 randomization deliberately sets the LAA bit), which is
# why mesh-perimeter/mesh-operator-home keep it and BLE must not.
# Single source stays mesh-presence: the map is BlueZ's own org.bluez.Device1 AddressType, pulled ONCE
# per run (--addrtype-map) because a per-MAC call would cost a python+D-Bus round-trip each. Unknown MAC,
# empty map (no python3-dbus / BlueZ holds nothing) or malformed octet → NOT random (return 1): the axis
# is LOST honestly and a nameless device simply stops corroborating a person, never a guessed one.
# The map is fetched EAGERLY into a plain variable by _addrtype_map_init, never lazily inside
# _is_random_mac: that runs in a $( ) subshell, so a cache it filled would be discarded and every device
# in the loop would pay its own mesh-presence invocation.
_ADDRTYPE_MAP_CACHE=""
_addrtype_map_init() {
  if [ -n "${MESH_ADDRTYPE_MAP+x}" ]; then _ADDRTYPE_MAP_CACHE="$MESH_ADDRTYPE_MAP"; return; fi
  _ADDRTYPE_MAP_CACHE="$(mesh-presence --addrtype-map 2>/dev/null || true)"
}
_is_random_mac() {
  local first="${1%%:*}" mac="${1^^}"
  [[ "$first" =~ ^[0-9A-Fa-f]{2}$ ]] || return 1
  [ "$(printf '%s\n' "$_ADDRTYPE_MAP_CACHE" | awk -v m="$mac" '$1==m{print $2; exit}')" = random ]
}

_read_state() {
  local f="$1" lim="${2:-1800}"
  [ -f "$f" ] || { echo ""; return; }
  local mtime age
  mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ "$mtime" -gt 0 ] || { echo ""; return; }
  age=$(( $(date +%s) - mtime ))
  [ "$age" -gt "$lim" ] && { echo ""; return; }
  head -1 "$f" 2>/dev/null | cut -d'|' -f1
}

# The kbd axis's LOCAL read, as one testable unit (the live path below calls exactly this, so the
# --test cases assert the behaviour of the call site and not merely of the helper it uses).
# Age-gated via _read_state; missing OR stale renders UNKNOWN — never a cached verdict.
# See the long note at the live call site for why (incident: kbd=IDLE was a 28-day corpse).
_kbd_verdict_local() {
  local v; v="$(_read_state "$1" "$2")"
  [ -n "$v" ] || v="UNKNOWN"
  printf '%s\n' "$v"
}

# --- OCCUPANCY_DWELL enrichment (2026-06-29) ---
# The existing 1-field state (PRESENT|EMPTY|UNCERTAIN) captures the CURRENT verdict but NOT how
# long it has been held. The new additive fields 2+3 are `<dwell_s>|<changes_24h>` — seconds-since-
# last-verdict-change and count of changes in the last 24h. Captures "PRESENT held for 4h" vs
# "just transitioned to PRESENT" — distinct from the per-fusion verdict (which is just "what
# is it now?"). Consistent with the dwell vocabulary used by motion_dwell / light_dwell /
# wifi_motion_dwell / label_dwell / tamper_recency. Consumers wanting "has the room been
# occupied for a while?" grep `dwell_s=`. The .room-sense-events log is the durable change
# record (one epoch per change, pruned to 24h).
#
#   classify_dwell <seconds> → echoes "BAND|seconds". Pure, offline-testable.
#   Bands (FALSIFIABLE: change the 5/60/1800 thresholds → tests flip):
#     TRANSITION  0–5s    — just changed
#     RECENT     5–60s   — recently changed
#     STABLE     1–30m   — held for a while
#     CHRONIC    30m+    — long-stable verdict
#     NEVER      no reading on record
classify_dwell() {
  local s="${1:-}"
  if [ -z "$s" ] || ! [ "$s" -ge 0 ] 2>/dev/null; then echo "NEVER|no reading on record"; return; fi
  if   [ "$s" -lt 5 ];    then echo "TRANSITION|${s}s (just changed)"; return; fi
  if   [ "$s" -lt 60 ];   then echo "RECENT|${s}s (under 1m)"; return; fi
  if   [ "$s" -lt 1800 ]; then echo "STABLE|$((s/60))m (under 30m)"; return; fi
  echo "CHRONIC|$((s/60))m (long-stable)"
}
# gate_tamper_recency <label> <state_epoch> <now> <stale_s> → echoes the EFFECTIVE recency label.
# The tamper recency label (ACTIVE/RECENT/...) is computed at .tamper-state WRITE time. room-sense
# drives a definitive PRESENT off ACTIVE/RECENT, so a FROZEN state (tamper reflex stalled / phone gone
# offline / cron skipped) would keep asserting "phone recently disturbed" on a stale positive forever —
# a HOLLOW PRESENT. Recompute against NOW: only the POSITIVE labels can go hollow-stale; if the state's
# own epoch is older than <stale_s>, degrade ACTIVE/RECENT → STALE (neutral, non-driving). Non-positive
# labels (COLD/NEVER/OFFLINE) and a malformed/absent epoch pass through unchanged (nothing to fake).
# Pure, offline-testable (FALSIFIABLE: change <stale_s> → the boundary cases flip).
gate_tamper_recency() {
  local label="$1" epoch="$2" now="$3" stale="$4"
  case "$label" in
    ACTIVE|RECENT) : ;;                        # only positive labels can decay into a hollow PRESENT
    *) printf '%s' "$label"; return ;;
  esac
  case "$epoch" in
    ''|*[!0-9]*) printf '%s' "$label"; return ;;   # malformed/absent epoch → trust the label as-is
  esac
  if [ $(( now - epoch )) -gt "$stale" ]; then
    printf 'STALE'
  else
    printf '%s' "$label"
  fi
}
# count_recent_events <log> <now> <window_sec> → integer. Prunes log to 24h on the fly and counts
# events in [now-window, now]. Reused from the ambient-clock dwell enrichment; file-bound.
count_recent_events() {
  local f="$1" now="$2" win="$3" cutoff c _ts
  cutoff=$(( now - win ))
  c=0
  [ -f "$f" ] || { echo 0; return; }
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    _ts="$(printf '%s' "$line" | cut -d'|' -f1)"
    [ "$_ts" -ge "$cutoff" ] 2>/dev/null && c=$((c+1))
  done < "$f"
  echo "$c"
}
# --- OBSERVED dwell: a continuity claim cannot cross an interval nobody watched ---
# `dwell_s` was `now - last_change_ts`, read off EVENTS — a log that records only CHANGES. So a
# sense that stopped running entirely kept accruing dwell at wall-clock rate, and the number it
# published was indistinguishable from one earned by continuous observation. Caught live
# 2026-08-22: the node was OFF 00:32:04Z→09:42:02Z (9h09m58s, `journalctl --list-boots`) and
# `.room-sense.state` read `PRESENT|dwell_s=86366` — a 24h continuous-occupancy claim of which
# 38% was a powered-down machine. The room could have emptied and refilled twice.
#
# The evidence was already on disk and the arithmetic simply never opened it: ROOM_TAPE takes one
# line per EVALUATION, unconditionally, precisely so the observation history is separable from the
# verdict history.
#
# WHICH BIT TO NARROW. 22 tools read $STATE and 21 of them would never open a new 4th field
# (a-sidecar-cannot-narrow-a-bit-its-readers-never-open), so the fix shrinks the bit they ALL
# already open: `dwell_s` now counts from the LATER of (last verdict change, end of the last blind
# gap) — i.e. it finally means the thing its name always claimed, "observed continuously for N
# seconds". Every existing reader gets a number that no longer over-claims, and the direction of
# the change is conservative: dwell only ever shrinks, so no consumer's threshold is crossed by
# this that was not crossed before. `dwell_cov=` then carries the narrowed-away case for the one
# reader that should watch it.
#
# dwell_observed <tape> <last_change_ts> <now> → "<dwell_s>|<cov>"
#   cov is the integer percent of (now - last_change_ts) that was actually observed, or `na` when
#   the tape cannot answer — absent, unreadable, or not reaching back as far as the last change
#   (14-day retention vs an older change). MISSING EVIDENCE RENDERS na, NEVER 100: a tape that has
#   been pruned past the window is exactly the case where the old wall-clock number is unvouched,
#   so it is reported AS the old number with cov=na rather than silently blessed as full coverage.
dwell_observed() {
  local tape="$1" start="$2" now="$3" out
  if [ -z "$start" ] || ! [ "$start" -gt 0 ] 2>/dev/null; then printf '0|na\n'; return; fi
  if [ ! -r "$tape" ]; then printf '%s|na\n' "$(( now - start ))"; return; fi
  out="$(awk -v start="$start" -v now="$now" -v thr="$BLIND_GAP_S" '
    # days_from_civil (Howard Hinnant) — exact, and portable in a way mktime() is not: this must
    # not quietly degrade to a wrong number under mawk. All tape stamps are UTC by construction.
    function dfc(y,m,d,  era,yoe,doy,doe) {
      if (m <= 2) y--
      era = int((y >= 0 ? y : y-399) / 400)
      yoe = y - era*400
      doy = int((153*(m + (m > 2 ? -3 : 9)) + 2)/5) + d - 1
      doe = yoe*365 + int(yoe/4) - int(yoe/100) + doy
      return era*146097 + doe - 719468
    }
    {
      if ($1 !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/) next
      y=substr($1,1,4)+0; mo=substr($1,6,2)+0; d=substr($1,9,2)+0
      h=substr($1,12,2)+0; mi=substr($1,15,2)+0; se=substr($1,18,2)+0
      t = dfc(y,mo,d)*86400 + h*3600 + mi*60 + se
      if (first == 0) first = t
      if (prev > 0 && t > start) {
        gap = t - prev
        if (gap > thr) { blind += gap; if (t > eff) eff = t }
      }
      prev = t
    }
    END {
      if (first == 0) { print "na|na"; exit }              # no parseable row at all
      if (first > start) { print "na|na"; exit }           # tape does not reach back to the change
      if (eff < start) eff = start
      printf "%d|%d\n", eff, blind
    }' "$tape" 2>/dev/null)"
  local eff="${out%%|*}" blind="${out##*|}" wall=$(( now - start ))
  if [ "$eff" = "na" ] || [ -z "$eff" ]; then printf '%s|na\n' "$wall"; return; fi
  local dw=$(( now - eff )); [ "$dw" -lt 0 ] && dw=0
  local cov=100
  [ "$wall" -gt 0 ] && cov=$(( (wall - blind) * 100 / wall ))
  [ "$cov" -lt 0 ] && cov=0
  printf '%s|%s\n' "$dw" "$cov"
}
# log_room_event <log> <epoch> <verdict> <now> — append a verdict-change event and prune to 24h from
# NOW. Format: epoch|verdict. Stale events older than 24h relative to NOW are pruned, so the log
# self-bounds and a sense with a churning verdict never grows unbounded.
log_room_event() {
  local f="$1" epoch="$2" verdict="$3" now="$4" cutoff
  cutoff=$(( now - 86400 ))
  [ -d "$(dirname "$f")" ] || return 1
  if [ -f "$f" ]; then
    local tmp="${f}.tmp.$$"
    : > "$tmp"
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      _ts="$(printf '%s' "$line" | cut -d'|' -f1)"
      [ "$_ts" -ge "$cutoff" ] 2>/dev/null && printf '%s\n' "$line" >> "$tmp"
    done < "$f"
    mv -f "$tmp" "$f" 2>/dev/null || rm -f "$tmp"
  fi
  [ "$epoch" -ge "$cutoff" ] 2>/dev/null && printf '%s|%s\n' "$epoch" "$verdict" >> "$f"
}

# ── OBSERVATION TAPE vs WAKE EDGE — SELECTION ON THE PREDICTOR ───────────────────────────────────
# LITERATURE (live review, 2026-08-17): predictive processing / Bayesian brain measures a
# confidence signal with TYPE-2 (metacognitive) sensitivity — not "was the verdict right" (type-1)
# but "does the system's own confidence discriminate its right calls from its wrong ones", a
# separate axis by construction. Current live source: Jon-Paul Cacioli, "Do LLMs Know What They
# Know? Measuring Metacognitive Efficiency with Signal Detection Theory", arXiv:2603.25112
# (Mar 2026, v3 Jul 2026). Two results that bind here: (1) the standard summary M-ratio =
# meta-d'/d' (Maniscalco & Lau; HMeta-d, Fleming, Neurosci. Consciousness 2017 nix007) is
# criticised as pinned near 1 by construction and undefined without a two-alternative type-1
# decision — report the model-free quantity instead, normalised metacognitive information
# meta-I_2r, i.e. the information the confidence label carries about correctness; (2) that
# information is UNCORRELATED with accuracy (rank ρ = -0.80 / +0.00 across two benchmarks) and
# tracks the accuracy gain from confidence-based ABSTENTION perfectly (ρ = +1.00). So a confidence
# label is worth exactly the abstention it enables, and that worth is bounded above by H(confidence)
# AS RECORDED.
# THE GAP THIS FILLS (measured on this node, 2026-08-17): ~/.mesh/room-sense.log held 253 records
# across 33 days (2026-07-15 → 2026-08-17) and `confidence=high` in 253 of 253 — H = 0 bits. That is
# NOT a degenerate sense: the emit below is CONDITIONED on `verdict=PRESENT && confidence=high`, so
# the only durable tape of this sense was SELECTED ON THE VERY VARIABLE whose informativeness one
# would score. At the declared 5-min cadence the reflex evaluates ~288×/day and retained ~7.7 — the
# other ~97% (every EMPTY, every UNCERTAIN, every medium/low) was never written anywhere. meta-I_2r
# over that tape is 0 by construction, and no consumer could ever profit from abstaining on a label
# that is a constant where it is readable. Same shape as the doctrine's guardian fix (a dry-run
# writing the record it exists to check → give it its OWN log) and the liveness-touch convention
# (decouple ran-live from value-changed): ONE printf was serving two duties — the WAKE SIGNAL (an
# actuator trigger, correctly gated: a room change must not wake Misha off ambient sound) and the
# OBSERVATION RECORD (must be unconditional, or it is not an observation). They are now two
# functions, `wake_emit_ok` and `tape_room_eval`, asserted to behave OPPOSITELY on the same input.
# HONEST LIMIT: an unconditional tape restores H(confidence); it does NOT supply the correctness
# labels meta-I_2r needs. It is the precondition, not the measurement — scoring still needs an
# outcome channel independent of this fusion's own inputs (room speech is the candidate; absence of
# speech is not evidence of EMPTY, so that side stays one-sided). Do not read a restored tape as a
# scored confidence.
# (ROOM_TAPE / ROOM_TAPE_KEEP are DEFINED near the top, beside STATE/EVENTS — --redundancy reads the
# tape above the live probes and must resolve the same path from one definition.)

# wake_emit_ok <verdict> <confidence> → rc 0 if this evaluation may fire the WAKE-SIGNAL line.
# Misha dormant-by-default (operator 2026-06-24, tier-1): only a CONFIRMED occupancy edge
# (PRESENT + confidence=high = non-audio corroboration: cam/kbd/body/BLE/wifi) wakes him, so a room
# change never wakes Misha off ambient sound/music. MISHA_CONFIRMED_ONLY=0 opts out (legacy).
# This is an ACTUATOR gate and stays gated; it is NOT the observation record (see tape_room_eval).
wake_emit_ok() {
  [ "${MISHA_CONFIRMED_ONLY:-1}" != 1 ] && return 0
  [ "${1:-}" = "PRESENT" ] && [ "${2:-}" = "high" ]
}

# tape_room_eval <ts> <verdict> <confidence> <status> <occupancy> [degraded] [signals]
# UNCONDITIONAL per-evaluation record — every --edge tick, every verdict, every confidence level.
# Never gate this on the value being recorded; that is the selection bug it exists to undo.
tape_room_eval() {
  local f="$ROOM_TAPE" n
  [ -d "$(dirname "$f")" ] || return 0
  printf '%s verdict=%s confidence=%s status=%s occupancy=%s degraded=%s signals=%s\n' \
    "${1:-?}" "${2:-?}" "${3:-?}" "${4:-?}" "${5:-?}" "${6:-none}" "${7:-none}" >> "$f" 2>/dev/null || return 0
  n="$(grep -c '' "$f" 2>/dev/null || echo 0)"
  if [ "${n:-0}" -gt $(( ROOM_TAPE_KEEP + 288 )) ] 2>/dev/null; then
    tail -n "$ROOM_TAPE_KEEP" "$f" > "$f.trim" 2>/dev/null \
      && mv -f "$f.trim" "$f" 2>/dev/null || rm -f "$f.trim" 2>/dev/null
  fi
  return 0
}

# --- Fusion engine (extracted for testability) ---
# Usage: _fuse_verdict body_verdict ble_verdict ble_reason wifi_verdict light_verdict phone_ok ble_ok ambient_level kbd_verdict cam_verdict ambient_clock presence_familiarity presence_session_max_s [screen_state] [tamper_recency] [audio_self]
# Sets verdict, reason, signals globals. Returns 0 (assessed) or 2 (cannot assess).
# audio_self (PLAYING_SELF|PLAYING_EXTERNAL|SILENT|UNKNOWN, from mesh-audio-active's efference-copy
# `source=` field): is THIS node emitting sound right now, and is that emission SELF-caused or not?
# PLAYING_SELF (reafference — mesh-speaking flag / a player process the mesh itself launched, e.g. the
# nightly mesh-room-music grind) contaminates the mic's MODERATE/LOUD, so "sound proves occupancy" must
# NOT fire — those branches downgrade to honest UNCERTAIN. PLAYING_EXTERNAL (exafference — an outside
# stream: a person's video/call, nothing the mesh caused) is NOT discounted here — it falls through to
# the existing ambient-clock/camera checks below exactly like a bare "sound is happening" read, because
# an outside stream IS real activity at this node. Checked BEFORE the ambient-clock/camera inferences:
# self-emission is kernel ground truth (/proc/asound RUNNING + the efference copy), not an inference.
# UNKNOWN (tool absent / no sound card) cannot discount — sound-proves-occupancy stands, exactly like
# cm=UNKNOWN. (PLAYING_SELF/PLAYING_EXTERNAL split — sense-enrichment 2026-07-10, mesh-audio-active.)
_fuse_verdict() {
  local bd="$1" bl="$2" br="$3" wf="$4" lt="$5" po="$6" bo="$7" al="${8:-UNKNOWN}" kd="${9:-UNKNOWN}" cm="${10:-UNKNOWN}" ac="${11:-UNKNOWN}" pf="${12:-INITIAL}" ps="${13:--1}" sc="${14:-UNKNOWN}" tr="${15:-OFFLINE}" aself="${16:-UNKNOWN}"
  verdict="UNCERTAIN"; reason=""
  # signals describes the INPUTS only, so it is built up front — the po=0&bo=0 sub-branches
  # early-return and used to leave it empty (a live UNCERTAIN/PRESENT from the mic paths carried
  # no signals evidence at all).
  signals="kbd=${kd} screen=${sc} cam=${cm} ble=${bl} body=${bd} wifi=${wf} light=${lt} ambient=${al} ambient_clock=${ac} presence_familiarity=${pf} presence_session_max_s=${ps} tamper_recency=${tr} audio_self=${aself}"
  if [ "$bd" = "CARRIED" ] || [ "$bd" = "HANDLED" ] || [ "$bd" = "WALKING" ]; then
    verdict="PRESENT"; reason="body=$bd (phone being moved/held)"
    [ "$bl" = "PRESENT_STRONG" ] && reason="$reason + $br"
  elif [ "$kd" = "TYPING" ]; then
    # Keyboard TYPING is a definitive local signal: operator is at this machine.
    # Checked before BLE/wifi so phone-offline can't suppress it.
    verdict="PRESENT"; reason="keyboard TYPING on $(hostname)"
    [ "$bl" = "PRESENT_STRONG" ] && reason="$reason + $br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$cm" = "MOTION" ]; then
    # Camera motion (mesh-cam-watch) is a definitive LOCAL signal: movement seen in the room.
    # Phone-INDEPENDENT, so a flapping/offline phone can't suppress it — checked before BLE/wifi.
    verdict="PRESENT"; reason="camera motion on $(hostname)"
    [ "$bl" = "PRESENT_STRONG" ] && reason="$reason + $br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$tr" = "ACTIVE" ] || [ "$tr" = "RECENT" ]; then
    # Tamper recency ACTIVE/RECENT — recent phone disturbance = recent human activity.
    # Strong corroborator even when phone is now offline (physical disturbance was observed).
    verdict="PRESENT"; reason="phone recently disturbed (tamper recency=$tr)"
    [ "$bl" = "PRESENT_STRONG" ] && reason="$reason + $br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$bl" = "PRESENT_STRONG" ]; then
    verdict="PRESENT"; reason="$br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$wf" = "MOTION" ]; then
    verdict="PRESENT"; reason="WiFi RSSI motion detected"
    [ "$lt" = "LIT" ] && reason="$reason + room lit"
    [ -n "$br" ] && reason="$reason + $br"
    [ "$bd" != "UNKNOWN" ] && [ "$bd" != "STILL" ] && reason="$reason + body=$bd"
  elif [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$bl" = "NONE" ] \
       && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ] && [ "$bd" != "WALKING" ]; then
    verdict="EMPTY"; reason="WiFi STILL + ambient LOW + no known BLE + body=$bd"
  elif [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$bl" = "PRESENT_WEAK" ] \
       && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ] && [ "$bd" != "WALKING" ]; then
    verdict="EMPTY"; reason="WiFi STILL + ambient LOW (TV BLE not occupancy) + body=$bd"
  elif [ "$po" = 0 ] && [ "$bo" = 0 ]; then
    # Phone AND BLE both offline — but local signals (mic + keyboard) may still prove occupancy
    if [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; then
      # appliance-vs-person: ambient LOUD ALONE is faked by a TV/speaker. A LIVE camera showing STILL
      # (cm=STILL, NOT the dead/absent UNKNOWN) is a real person-negative signal — sound + no motion +
      # no BLE is far more consistent with media than a present-but-silent person → honest UNCERTAIN.
      # cm=UNKNOWN (camera dead/absent) cannot contradict, so sound-proves-occupancy stays.
      # Self-playback first: if THIS node's own speakers are RUNNING with the mesh's OWN efference
      # copy active, the mic is hearing ITSELF — the one appliance case the ambient-clock (neighbor
      # BLE) and camera can both miss. PLAYING_EXTERNAL (no efference copy) skips this branch.
      if [ "$aself" = "PLAYING_SELF" ]; then
        verdict="UNCERTAIN"; reason="ambient $al but own speakers PLAYING — self-playback contaminates mic evidence"
      elif [ "$ac" = "ACTIVE" ] || [ "$ac" = "MODERATE" ]; then
        verdict="UNCERTAIN"; reason="ambient $al but ambient-clock=$ac suggests external appliance activity"
      elif [ "$cm" = "STILL" ]; then
        verdict="UNCERTAIN"; reason="ambient $al but camera live+STILL & no phone/BLE — likely TV/appliance, not a person"
      else
        verdict="PRESENT"; reason="ambient $al (mic hears activity, no phone/BLE)"
      fi
      return 0
    elif [ "$al" = "SILENCE" ] || [ "$al" = "QUIET" ]; then
      if [ "$sc" = "OFF" ]; then
        verdict="EMPTY"; reason="ambient $al + screen OFF + no phone/BLE — likely vacant"
      elif [ "$tr" = "ACTIVE" ] || [ "$tr" = "RECENT" ]; then
        # Recent tamper event + quiet room: someone was recently active but it's quiet now.
        # Better evidence for occupancy than pure UNCERTAIN (no signal either way).
        verdict="PRESENT"; reason="phone recently disturbed (tamper recency=$tr) + ambient $al"
      else
        verdict="UNCERTAIN"; reason="ambient $al but no phone/BLE to confirm — quiet≠empty"
      fi
      return 0
    elif [ "$sc" = "OFF" ] && [ "$wf" = "STILL" ] && [ "$cm" = "STILL" ] \
         && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ] && [ "$bd" != "WALKING" ]; then
      verdict="EMPTY"; reason="screen OFF + WiFi STILL + live camera STILL + no phone/BLE — likely vacant"
      return 0
    fi
    return 2
  elif [ "$po" = 0 ]; then
    if [ "$bl" = "PRESENT_STRONG" ]; then
      verdict="PRESENT"; reason="$br (phone offline, BLE only)"
      [ "$pf" = "FAMILIAR" ] && reason="$reason + settled session ${ps}s"
    elif [ "$bl" = "PRESENT_WEAK" ]; then
      verdict="UNCERTAIN"; reason="TV BLE visible, phone offline — cannot confirm"
    elif [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; then
      # appliance-vs-person (see the po=0&bo=0 branch above): a LIVE camera STILL contradicts a present
      # person, so LOUD-alone → UNCERTAIN (likely TV); cm=UNKNOWN can't contradict → PRESENT stands.
      # Self-playback first (same gate as above): own speakers RUNNING + efference copy = the mic
      # hears the node itself. PLAYING_EXTERNAL (no efference copy) skips this branch.
      if [ "$aself" = "PLAYING_SELF" ]; then
        verdict="UNCERTAIN"; reason="ambient $al but own speakers PLAYING — self-playback contaminates mic evidence"
      elif [ "$ac" = "ACTIVE" ] || [ "$ac" = "MODERATE" ]; then
        verdict="UNCERTAIN"; reason="ambient $al + ambient-clock=$ac suggests external appliance activity"
      elif [ "$cm" = "STILL" ]; then
        verdict="UNCERTAIN"; reason="ambient $al but camera live+STILL & no strong BLE — likely TV/appliance, not a person"
      else
        verdict="PRESENT"; reason="ambient $al + phone offline (mic hears activity)"
      fi
    elif [ "$sc" = "OFF" ] && [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$bl" = "NONE" ]; then
      verdict="EMPTY"; reason="screen OFF + WiFi STILL + ambient $al + no known BLE — likely vacant"
    elif [ "$sc" = "OFF" ] && [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$bl" = "PRESENT_WEAK" ]; then
      verdict="EMPTY"; reason="screen OFF + WiFi STILL + ambient $al (TV BLE not occupancy) + body=$bd"
    elif [ "$sc" = "OFF" ] && [ "$wf" = "STILL" ] && [ "$cm" = "STILL" ] \
         && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ] && [ "$bd" != "WALKING" ] && [ "$bl" != "PRESENT_STRONG" ]; then
      verdict="EMPTY"; reason="screen OFF + WiFi STILL + live camera STILL + no strong BLE — likely vacant"
    else
      verdict="UNCERTAIN"; reason="phone offline, no strong BLE — cannot assess"
    fi
  elif [ "$wf" != "STILL" ] || [ "$lt" = "LIT" ] || [ "$bl" != "NONE" ] || [ "$bd" = "COVERED" ]; then
    verdict="UNCERTAIN"; reason="mixed signals: wifi=$wf light=$lt ble=$bl body=$bd"
  fi
  return 0
}

_derive_occupancy() {
  local vd="$1" bd="$2" bl="$3" wf="$4" lt="$5" po="$6" bo="$7" al="${8:-UNKNOWN}" kd="${9:-UNKNOWN}" cm="${10:-UNKNOWN}" ac="${11:-UNKNOWN}" pf="${12:-INITIAL}" ps="${13:--1}" sc="${14:-UNKNOWN}"
  local degraded_parts=()
  occupancy="UNKNOWN"
  confidence="low"
  room_mode="MIXED"
  degraded="none"

  [ "$po" = 1 ] || degraded_parts+=("phone-unreachable")
  [ "$bo" = 1 ] || degraded_parts+=("ble-unavailable")
  [ "$bd" != "UNKNOWN" ] || degraded_parts+=("body-unknown")
  [ "$wf" != "UNKNOWN" ] || degraded_parts+=("wifi-unknown")
  [ "$lt" != "UNKNOWN" ] || degraded_parts+=("light-unknown")
  [ "$al" != "UNKNOWN" ] || degraded_parts+=("ambient-unknown")
  # Keyboard: degraded ONLY when a keyboard sense EXISTS but contributed nothing — either the organ
  # is here and its reflex went silent, or a ROOM_KBD_NODE is declared and unreachable. A node with
  # no keyboard at all (kbd_absent=1, from mesh-kbd-activity's exit 2 at the read site) has no kbd
  # sense to lose — same rule as screen and camera below, same reason.
  [ "$kd" != "UNKNOWN" ] || [ "${kbd_absent:-0}" = 1 ] || degraded_parts+=("kbd-unknown")
  # Screen: degraded ONLY when a screen sense EXISTS but could not be read. A node with no
  # backlight-bearing display (screen_absent=1, set from mesh-screen-state's exit 2) has no screen
  # sense to lose — same rule as the camera below, and for the same reason. Without this the
  # IdeaPad-shaped axis (see the read site) rendered its own absence as a permanent DEGRADED on
  # every desktop node.
  [ "$sc" != "UNKNOWN" ] || [ "${screen_absent:-0}" = 1 ] || degraded_parts+=("screen-unknown")
  # Camera: degraded ONLY when a daemon that WAS running went stale (cam_degraded=1, set from cam-prev.jpg
  # liveness). A camera-less node (no cam-prev at all) is NOT degraded — there is no camera sense to lose.
  [ "${cam_degraded:-0}" = 1 ] && degraded_parts+=("cam-blind")
  # cam-dark = camera alive but the room is unlit (flat frame + light=LOW): the axis contributes
  # nothing tonight, which is honest degradation — but it is EXPECTED, not a fault like cam-blind.
  [ "${cam_dark:-0}" = 1 ] && degraded_parts+=("cam-dark")

  case "$vd" in
    PRESENT)
      occupancy="OCCUPIED"
      confidence="medium"
      room_mode="QUIET"
      # A hard corroborator (a device we RECOGNISE / a motion axis) → high confidence. A NAMELESS
      # random-MAC BLE alone (ble_nameless_only=1) is person-ISH but unidentified — a neighbour's
      # rotating-MAC phone through a wall reads identically — so it must NOT alone yield HIGH while the
      # corroborating axes are blind. Cap it at medium unless another hard axis confirms. (03:12Z senses
      # audit: OCCUPIED/high from one nameless -68 dBm BLE with phone/body/light/cam all degraded.)
      local _ble_hard=0
      [ "$bl" = "PRESENT_STRONG" ] && [ "${ble_nameless_only:-0}" != 1 ] && _ble_hard=1
      if [ "$bd" = "CARRIED" ] || [ "$bd" = "HANDLED" ] || [ "$bd" = "WALKING" ] || [ "$kd" = "TYPING" ] || [ "$cm" = "MOTION" ] || [ "$_ble_hard" = 1 ] || [ "$wf" = "MOTION" ]; then
        confidence="high"
        room_mode="ACTIVE"
      elif [ "$bl" = "PRESENT_STRONG" ] || [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; then
        confidence="medium"
        room_mode="ACTIVE"
      fi
      if [ "$pf" = "FAMILIAR" ] && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ] && [ "$bd" != "WALKING" ] \
         && [ "$kd" != "TYPING" ] && [ "$cm" != "MOTION" ] && [ "$wf" != "MOTION" ] \
         && [ "$al" != "MODERATE" ] && [ "$al" != "LOUD" ]; then
        room_mode="SETTLED"
        confidence="high"
      fi
      ;;
    EMPTY)
      occupancy="EMPTY"
      confidence="medium"
      room_mode="VACANT"
      [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$po" = 1 ] && confidence="high"
      [ "$sc" = "OFF" ] && confidence="high"
      ;;
    *)
      occupancy="UNKNOWN"
      confidence="low"
      # OFFLINE means an ORGAN is down (phone/BLE unreachable) — not "one soft axis was unknown".
      # The old any-degraded→OFFLINE rendered a richly-assessed UNCERTAIN (8/10 axes read, only the
      # cam flat) as OFFLINE all night, telling consumers the room was UNOBSERVED when it was merely
      # ambiguous (found live 2026-07-03). Soft axis gaps with both organs up stay room_mode=MIXED.
      if [ "$po" != 1 ] || [ "$bo" != 1 ]; then
        [ "${#degraded_parts[@]}" -gt 0 ] && room_mode="OFFLINE"
      fi
      if [ "${#degraded_parts[@]}" -eq 0 ] && { [ "$al" = "MODERATE" ] || [ "$al" = "LOUD" ]; } \
         && { [ "$ac" = "ACTIVE" ] || [ "$ac" = "MODERATE" ]; } \
         && [ "$wf" = "STILL" ] && [ "$lt" = "LOW" ] && [ "$cm" = "STILL" ] \
         && [ "$bd" != "CARRIED" ] && [ "$bd" != "HANDLED" ] && [ "$bd" != "WALKING" ] && [ "$bl" != "PRESENT_STRONG" ]; then
        room_mode="APPLIANCE"
      fi
      ;;
  esac

  if [ "${#degraded_parts[@]}" -gt 0 ]; then
    local IFS=,
    degraded="${degraded_parts[*]}"
  fi
}

# room_status <ec> <occupancy> <degraded> → explicit surface label for consumers.
# This keeps a real empty room distinct from an unreachable fusion: EMPTY remains EMPTY,
# while failed assessment is rendered as UNREACHABLE or DEGRADED instead of collapsing to
# the same-looking UNKNOWN/quiet artifact.
room_status() {
  local ec="${1:-0}" occ="${2:-UNKNOWN}" degraded="${3:-}"
  if [ "$ec" = 2 ]; then
    echo "UNREACHABLE"
    return
  fi
  case "$occ" in
    OCCUPIED) echo "OCCUPIED" ;;
    EMPTY)    echo "EMPTY" ;;
    UNKNOWN)
      [ -n "$degraded" ] && [ "$degraded" != "none" ] && echo "DEGRADED" || echo "UNKNOWN"
      ;;
    *) echo "$occ" ;;
  esac
}

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
}

# A FRESH cam-prev.jpg proves the daemon is WRITING, but NOT that the lens can SEE: a privacy-covered /
# capped lens still updates the frame as a near-constant FLAT field (stddev≈0) carrying no scene info.
# Treating that as a live "STILL" feeds a false person-NEGATIVE into fusion (a blind camera wrongly
# contradicting a present person in the appliance-vs-person branches). So a fresh-but-FLAT frame is
# cam-BLIND (degraded), never STILL — mirrors mesh-light's flat-field guard + the dead-daemon honesty.
# _cam_flat <frame> → echoes 1 if flat (stddev < CAM_FLAT_STDDEV), 0 if it carries scene variance, or ''
# when it cannot assess (no PIL / unreadable) → caller keeps the mtime-only STILL (never fabricates blind).
CAM_FLAT_STDDEV="${MESH_CAM_FLAT_STDDEV:-3}"
_cam_flat() {
  python3 - "$1" "$CAM_FLAT_STDDEV" <<'PY' 2>/dev/null
import sys
try:
    from PIL import Image, ImageStat
    sd=ImageStat.Stat(Image.open(sys.argv[1]).convert("L")).stddev[0]
    print(1 if sd < float(sys.argv[2]) else 0)
except Exception:
    pass
PY
}

# _cam_reclass <cam_degraded> <flat_fresh> <light_verdict> → OK | DARK | BLIND
# A FRESH-but-FLAT frame is not always a fault: a camera cannot see an UNLIT room, so when the
# light axis independently reads the room as dark (LOW), the flat field is EXPECTED PHYSICS —
# the daemon is alive and the flatness corroborates darkness. Without that corroboration
# (light LIT/UNKNOWN) a flat frame keeps meaning covered/blind lens. A STALE frame (flat_fresh=0)
# stays BLIND regardless — a dead daemon in a dark room is still a dead daemon. Found live
# 2026-07-03: every dark night rendered degraded=cam-blind + room_mode=OFFLINE all night.
_cam_reclass() {
  [ "${1:-0}" = 1 ] || { echo OK; return; }
  if [ "${2:-0}" = 1 ] && [ "${3:-}" = LOW ]; then echo DARK; else echo BLIND; fi
}

# _light_map <mesh-light output> → LIT | LOW | UNKNOWN — maps BOTH mesh-light sources into the
# fusion's 2-level axis. Phone (precise lux): DARK/DIM→LOW, MODERATE/LIT/BRIGHT→LIT. Webcam
# (coarse, phone offline): DARK/DIM→LOW, TWILIGHT/LIT→LIT (TWILIGHT is mid-luma "some light
# present", same side of the cut as phone-MODERATE). Any n/a line (unreachable / covered /
# no-frame / stale / no-pil) carries no level token → UNKNOWN, so mesh-light's honest exit-2
# reasons never leak in as a faked level. Word-boundary match: "covered"/"TWILIGHT" must not
# substring-hit DARK/LIT.
_light_map() {
  if printf '%s' "$1" | grep -qwE 'BRIGHT|LIT|MODERATE|TWILIGHT'; then echo LIT
  elif printf '%s' "$1" | grep -qwE 'DARK|DIM'; then echo LOW
  else echo UNKNOWN; fi
}

# parse_presence_field <inventory_line> <field> → extracts a field from mesh-presence's human summary
# line. This lets room-sense reuse mesh-presence's settled-session signal instead of re-deriving or
# discarding it.
parse_presence_field() {
  local line="$1" field="$2"
  case "$field" in
    familiarity)
      printf '%s\n' "$line" | sed -nE 's/.*familiarity: ([A-Z]+)\|.*/\1/p' | head -1
      ;;
    session_max_s)
      printf '%s\n' "$line" | sed -nE 's/.*session_max_s=([0-9-]+).*/\1/p' | head -1
      ;;
  esac
}

[ "${1:-}" = --test ] && {
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  [ -d "$MESH_DIR" ] || { echo "smoke-test: FAIL (no $MESH_DIR)"; exit 1; }
  # Exercise the fusion engine directly with synthetic args, no sensor subprocesses.
  # _fuse_verdict sets globals verdict/reason/signals and returns 0 or 2.
  # Case 1: body=CARRIED (+ any BLE) → PRESENT
  _fuse_verdict 'CARRIED' 'NONE' '' 'STILL' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: body CARRIED should give PRESENT (got $verdict)"; exit 1; }
  # Case 2: strong BLE only → PRESENT
  _fuse_verdict 'STILL' 'PRESENT_STRONG' 'JBL at -68' 'STILL' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: strong BLE should give PRESENT (got $verdict)"; exit 1; }
  # Case 3: wifi MOTION (+ still, DARK, no BLE) → PRESENT
  _fuse_verdict 'STILL' 'NONE' '' 'MOTION' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: wifi MOTION should give PRESENT (got $verdict)"; exit 1; }
  # Case 4: no strong anything + wifi STILL + light LOW → EMPTY
  _fuse_verdict 'STILL' 'NONE' '' 'STILL' 'LOW' 1 1
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: nothing active + STILL LOW should give EMPTY (got $verdict)"; exit 1; }
  # Case 5: weak BLE + STILL + LOW → EMPTY (TV BLE not occupancy)
  _fuse_verdict 'STILL' 'PRESENT_WEAK' 'TV' 'STILL' 'LOW' 1 1
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: weak BLE + STILL LOW should give EMPTY (got $verdict)"; exit 1; }
  # Case 6: phone offline + strong BLE → PRESENT
  _fuse_verdict 'UNKNOWN' 'PRESENT_STRONG' 'JBL' 'UNKNOWN' 'UNKNOWN' 0 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: offline + strong BLE should give PRESENT (got $verdict)"; exit 1; }
  # Case 7: phone offline + no strong BLE → UNCERTAIN
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: offline + no BLE should give UNCERTAIN (got $verdict)"; exit 1; }
  # Case 8: phone+BLE both offline → exit 2 (return 2)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 && { echo "  FAIL: both offline should return 2"; exit 1; }
  # Case 9: mixed signals (wifi=STILL, light=LIT, no BLE) → UNCERTAIN
  _fuse_verdict 'STILL' 'NONE' '' 'STILL' 'LIT' 1 1
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: mixed STILL+LIT should give UNCERTAIN (got $verdict)"; exit 1; }
  # Case 10: body HANDLED → PRESENT
  _fuse_verdict 'HANDLED' 'NONE' '' 'STILL' 'DARK' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: body HANDLED should give PRESENT (got $verdict)"; exit 1; }
  # Case 10b (coverage fix 2026-07-09): body WALKING → PRESENT, same as CARRIED/HANDLED. Before the
  # fix, [body-walking] mapped to body_verdict=UNKNOWN in the caller, so this case never reached
  # _fuse_verdict as a strong signal at all.
  _fuse_verdict 'WALKING' 'NONE' '' 'STILL' 'DARK' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: body WALKING should give PRESENT (got $verdict)"; exit 1; }
  # Case 10c: body WALKING must ALSO block the STILL+LOW+no-BLE EMPTY branch — the exact live failure
  # mode the coverage fix closes (a WALKING body reaching EMPTY because it fell through as UNKNOWN,
  # which the old check did not exclude either). FALSIFIABLE: drop the WALKING exclusion → this fails.
  _fuse_verdict 'WALKING' 'NONE' '' 'STILL' 'LOW' 1 1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: body WALKING must override WiFi STILL + light LOW toward PRESENT, not fall to EMPTY (got $verdict)"; exit 1; }
  # Case 10d: body VEHICLE stays NEUTRAL — must NOT be asserted as a strong PRESENT driver (a body in
  # transit most often means the person left the monitored space); with no other corroborating signal
  # it falls to the same STILL+LOW+no-BLE EMPTY branch as UNKNOWN/STILL would.
  _fuse_verdict 'VEHICLE' 'NONE' '' 'STILL' 'LOW' 1 1
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: body VEHICLE alone should NOT force PRESENT (got $verdict, expected EMPTY like an unknown/still body)"; exit 1; }
  # Case 11: phone+BLE offline but ambient LOUD → PRESENT (mic hears activity)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: all-offline + LOUD should give PRESENT (got $verdict)"; exit 1; }
  # Case 11b: loud audio + ambient-clock ACTIVE → UNCERTAIN, not a false PRESENT.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD' 'IDLE' 'UNKNOWN' 'ACTIVE'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: loud audio + ambient-clock ACTIVE should be UNCERTAIN (got $verdict)"; exit 1; }
  # Case 12: phone+BLE offline + ambient SILENCE → UNCERTAIN (quiet ≠ empty)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'SILENCE'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: all-offline + SILENCE should give UNCERTAIN (got $verdict)"; exit 1; }
  # Case 12b: phone+BLE offline + ambient SILENCE + screen OFF → EMPTY (vacancy corroborated locally)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'SILENCE' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: all-offline + SILENCE + screen OFF should give EMPTY (got $verdict)"; exit 1; }
  # Case 12c: phone+BLE offline + camera STILL + screen OFF → EMPTY even when ambient is UNKNOWN.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'STILL' 'UNKNOWN' 0 0 'UNKNOWN' 'IDLE' 'STILL' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: all-offline + camera STILL + screen OFF should give EMPTY (got $verdict)"; exit 1; }
  # Case 13: phone offline + no BLE + ambient MODERATE → PRESENT
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'MODERATE'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: phone-offline + MODERATE should give PRESENT (got $verdict)"; exit 1; }
  # Case 14: unreachable phone is visible degradation, not EMPTY/all-clear.
  _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 1 'QUIET'
  [ "$occupancy" = "UNKNOWN" ] || { echo "  FAIL: degraded offline should be UNKNOWN occupancy (got $occupancy)"; exit 1; }
  [ "$room_mode" = "OFFLINE" ] || { echo "  FAIL: degraded offline should be room_mode=OFFLINE (got $room_mode)"; exit 1; }
  printf '%s' "$degraded" | grep -q 'phone-unreachable' || { echo "  FAIL: degraded offline should mention phone-unreachable (got $degraded)"; exit 1; }
  # Case 14b: explicit surface status must distinguish unreachable from a genuine empty room.
  [ "$(room_status 2 UNKNOWN 'phone-unreachable,ble-unavailable')" = "UNREACHABLE" ] || { echo "  FAIL: room_status(UNREACHABLE) must be UNREACHABLE"; exit 1; }
  [ "$(room_status 0 EMPTY 'none')" = "EMPTY" ] || { echo "  FAIL: room_status(EMPTY) must be EMPTY"; exit 1; }
  [ "$(room_status 0 UNKNOWN 'phone-unreachable')" = "DEGRADED" ] || { echo "  FAIL: room_status(DEGRADED) must be DEGRADED"; exit 1; }
  # Case 15: a genuine empty room keeps a different artifact from unreachable.
  _derive_occupancy 'EMPTY' 'STILL' 'NONE' 'STILL' 'LOW' 1 1 'QUIET'
  [ "$occupancy" = "EMPTY" ] || { echo "  FAIL: genuine empty should be EMPTY occupancy (got $occupancy)"; exit 1; }
  [ "$confidence" = "high" ] || { echo "  FAIL: genuine empty with phone evidence should be high confidence (got $confidence)"; exit 1; }
  [ "$room_mode" = "VACANT" ] || { echo "  FAIL: genuine empty should be room_mode=VACANT (got $room_mode)"; exit 1; }
  printf '%s' "$degraded" | grep -q 'phone-unreachable' && { echo "  FAIL: genuine empty should not mention phone-unreachable (got $degraded)"; exit 1; }
  # Case 15b: genuine empty + screen OFF should be high confidence from the new local corroborator.
  _derive_occupancy 'EMPTY' 'STILL' 'NONE' 'STILL' 'LOW' 1 1 'QUIET' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  [ "$occupancy" = "EMPTY" ] || { echo "  FAIL: screen-off empty should stay EMPTY (got $occupancy)"; exit 1; }
  [ "$confidence" = "high" ] || { echo "  FAIL: screen-off empty should be high confidence (got $confidence)"; exit 1; }
  # Case 15c: ambient UNKNOWN + screen OFF + still/low/no-BLE should also be EMPTY.
  _derive_occupancy 'EMPTY' 'STILL' 'NONE' 'STILL' 'LOW' 1 1 'UNKNOWN' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  [ "$occupancy" = "EMPTY" ] || { echo "  FAIL: ambient-unknown screen-off empty should stay EMPTY (got $occupancy)"; exit 1; }
  [ "$confidence" = "high" ] || { echo "  FAIL: ambient-unknown screen-off empty should be high confidence (got $confidence)"; exit 1; }
  # Case 16: kbd TYPING → PRESENT even with phone offline and no BLE (local-only proof)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'SILENCE' 'TYPING'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: kbd TYPING + all offline should give PRESENT (got $verdict)"; exit 1; }
  # Case 17: kbd TYPING → high confidence in _derive_occupancy
  _derive_occupancy 'PRESENT' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 1 'SILENCE' 'TYPING'
  [ "$confidence" = "high" ] || { echo "  FAIL: kbd TYPING should give high confidence (got $confidence)"; exit 1; }
  # Case 18 (FALSIFIABLE): a SUSPECT/BUSY presence read is UNSAMPLED, never a confident empty.
  # Locks the READ-path classifier (case "$ble_out" in *BUSY*|*SUSPECT*) so the mesh-presence
  # honest-degraded n=0 never feeds a false "no BLE present" into occupancy.
  case "=== mesh-presence x — SUSPECT: 0 of 7 known device(s) gave a fresh RSSI ===" in
    *BUSY*|*SUSPECT*) : ;; *) echo "  FAIL: SUSPECT presence not flagged unsampled"; exit 1;; esac
  case "=== mesh-presence x — BUSY (adapter scan-locked) ===" in
    *BUSY*|*SUSPECT*) : ;; *) echo "  FAIL: BUSY presence not flagged unsampled"; exit 1;; esac
  case "=== mesh-presence x — 3 device(s) in range ===" in
    *BUSY*|*SUSPECT*) echo "  FAIL: real scan wrongly flagged unsampled"; exit 1;; esac
  # Case 19 (FALSIFIABLE): camera MOTION → PRESENT even with phone offline + no BLE (local, phone-free)
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'SILENCE' 'IDLE' 'MOTION'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: cam MOTION + phone offline should give PRESENT (got $verdict)"; exit 1; }
  # Case 20: camera MOTION → high confidence in _derive_occupancy
  _derive_occupancy 'PRESENT' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 1 'SILENCE' 'IDLE' 'MOTION'
  [ "$confidence" = "high" ] || { echo "  FAIL: cam MOTION should give high confidence (got $confidence)"; exit 1; }
  # Case 21 (BACK-COMPAT): a cam-absent 9-arg call (cm defaults UNKNOWN) must NOT alter existing verdicts
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'STILL' 'LOW' 1 1 'SILENCE' 'IDLE'
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: cam-absent default param must preserve EMPTY (got $verdict)"; exit 1; }
  # Case 22 (LIVENESS): cam=STILL must NOT assert presence — a live-but-still camera is neutral, treated
  # exactly like UNKNOWN by the fuser (only MOTION proves a person). EMPTY must survive a STILL camera.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'STILL' 'LOW' 1 1 'SILENCE' 'IDLE' 'STILL'
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: cam STILL must not flip EMPTY (got $verdict)"; exit 1; }
  # Case 23 (HONEST-DEGRADED): a proven-dead camera daemon (cam_degraded=1) must surface as cam-blind in
  # the degraded list — visibly different from a camera-less node, never a silent drop.
  cam_degraded=1; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'IDLE' 'UNKNOWN'
  case "$degraded" in *cam-blind*) :;; *) echo "  FAIL: dead cam daemon must list cam-blind (got $degraded)"; exit 1;; esac
  # Case 24 (NOT a degradation): a camera-less node (cam_degraded=0) must NOT list cam-blind.
  cam_degraded=0; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'IDLE' 'UNKNOWN'
  case "$degraded" in *cam-blind*) echo "  FAIL: camera-less node must NOT list cam-blind (got $degraded)"; exit 1;; esac
  # Case 24d (SCREEN ORGAN ABSENT — same rule as the camera above): a node with no backlight-bearing
  # display (mesh-screen-state exits 2: desktop/external monitor/VM) has no screen sense to LOSE, so
  # screen-unknown is NOT a degradation. Before this gate the mind-home node (a desktop, HDMI monitor,
  # no /sys/class/backlight) stamped degraded=screen-unknown on EVERY run forever — a permanent alarm
  # that can never clear carries no information, and it pinned status=DEGRADED on the node that now
  # hosts all the minds.
  screen_absent=1; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'IDLE' 'UNKNOWN'
  case "$degraded" in *screen-unknown*) echo "  FAIL: screen-less node must NOT list screen-unknown (got $degraded)"; exit 1;; esac
  # Case 24e (SCREEN ORGAN PRESENT BUT UNREADABLE — the honest degradation the rule must PRESERVE):
  # a node that HAS a backlight yet returned no parseable verdict is genuinely blind on that axis and
  # MUST still surface screen-unknown. This is the falsifying half of 24d: drop the screen_absent
  # guard and 24d fails; widen it to always-suppress and 24e fails.
  screen_absent=0; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'IDLE' 'UNKNOWN'
  case "$degraded" in *screen-unknown*) :;; *) echo "  FAIL: readable-screen node must list screen-unknown (got $degraded)"; exit 1;; esac
  # Case 24f: a real screen verdict is never degraded regardless of the absent flag.
  screen_absent=0; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  case "$degraded" in *screen-unknown*) echo "  FAIL: screen=OFF must not be degraded (got $degraded)"; exit 1;; esac
  screen_absent=0
  # Case 24g (KBD STALENESS GATE — the 28-day corpse): the local .kbd-activity.state read must go
  # through _read_state's age gate, so a file older than the 720s window contributes NOTHING and the
  # axis renders UNKNOWN. Drives the REAL helper the live path calls, on real files with real mtimes
  # (a fresh one must still pass — a gate that rejects everything is not a gate).
  _kt="$(mktemp -d)"
  printf 'IDLE\n' > "$_kt/kbd"; touch -d '2026-07-17 18:28:04 UTC' "$_kt/kbd"
  [ "$(_kbd_verdict_local "$_kt/kbd" 720)" = UNKNOWN ] \
    || { echo "  FAIL: a month-old kbd state must render UNKNOWN (got '$(_kbd_verdict_local "$_kt/kbd" 720)')"; rm -rf "$_kt"; exit 1; }
  touch -d '15 minutes ago' "$_kt/kbd"   # 900s > 720s — just past the gate
  [ "$(_kbd_verdict_local "$_kt/kbd" 720)" = UNKNOWN ] \
    || { echo "  FAIL: a 15-min-old kbd state must render UNKNOWN at a 720s gate"; rm -rf "$_kt"; exit 1; }
  printf 'TYPING\n' > "$_kt/kbd"         # fresh mtime
  [ "$(_kbd_verdict_local "$_kt/kbd" 720)" = TYPING ] \
    || { echo "  FAIL: a FRESH kbd state must pass the gate (got '$(_kbd_verdict_local "$_kt/kbd" 720)')"; rm -rf "$_kt"; exit 1; }
  [ "$(_kbd_verdict_local "$_kt/absent" 720)" = UNKNOWN ] \
    || { echo "  FAIL: a missing kbd state must render UNKNOWN"; rm -rf "$_kt"; exit 1; }
  rm -rf "$_kt"
  # Case 24h (KBD ORGAN ABSENT — same rule as screen/cam): a node with no keyboard (mesh-kbd-activity
  # exits 2) has no kbd sense to LOSE, so kbd-unknown is NOT a degradation. Without this the fix for
  # 24g would stamp a permanent, un-clearable degraded=kbd-unknown on every keyboard-less node.
  kbd_absent=1; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'UNKNOWN' 'UNKNOWN'
  case "$degraded" in *kbd-unknown*) echo "  FAIL: keyboard-less node must NOT list kbd-unknown (got $degraded)"; exit 1;; esac
  # Case 24i (KBD ORGAN PRESENT BUT SILENT — the falsifying half of 24h): a node that HAS a keyboard
  # sense (or a declared ROOM_KBD_NODE) and got nothing from it IS blind on that axis and must say so.
  # This is the harm the incident named: a dead axis rendering as a live negative kept kbd out of
  # degraded= and understated the fusion's own blindness by one axis.
  kbd_absent=0; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'UNKNOWN' 'UNKNOWN'
  case "$degraded" in *kbd-unknown*) :;; *) echo "  FAIL: silent-but-present kbd sense must list kbd-unknown (got $degraded)"; exit 1;; esac
  # Case 24j: a REAL kbd verdict is never degraded, whatever the absent flag says.
  kbd_absent=0; _derive_occupancy 'UNCERTAIN' 'UNKNOWN' 'NONE' 'UNKNOWN' 'UNKNOWN' 0 0 'QUIET' 'IDLE' 'UNKNOWN'
  case "$degraded" in *kbd-unknown*) echo "  FAIL: kbd=IDLE must not be degraded (got $degraded)"; exit 1;; esac
  kbd_absent=0
  # Case 24b (CAM-DARK RECLASS, FALSIFIABLE): fresh flat frame + light=LOW → DARK (expected physics);
  # flat WITHOUT dark corroboration → BLIND; a STALE frame stays BLIND even in a dark room (dead
  # daemon); no degradation at all → OK.
  [ "$(_cam_reclass 1 1 LOW)" = DARK ]      || { echo "  FAIL: fresh flat + light=LOW must reclass DARK (dark room, live cam)"; exit 1; }
  [ "$(_cam_reclass 1 1 LIT)" = BLIND ]     || { echo "  FAIL: fresh flat in a LIT room must stay BLIND (covered lens)"; exit 1; }
  [ "$(_cam_reclass 1 1 UNKNOWN)" = BLIND ] || { echo "  FAIL: fresh flat with light UNKNOWN must stay BLIND (no corroboration)"; exit 1; }
  [ "$(_cam_reclass 1 0 LOW)" = BLIND ]     || { echo "  FAIL: STALE frame must stay BLIND even in a dark room (dead daemon)"; exit 1; }
  [ "$(_cam_reclass 0 1 LOW)" = OK ]        || { echo "  FAIL: undegraded cam must reclass OK"; exit 1; }
  # Case 24e (LIGHT MAP, both sources + honest n/a): phone-precise and webcam-coarse levels both
  # land on the fusion axis; every exit-2 reason line maps UNKNOWN — never a faked level.
  [ "$(_light_map '[room-moderate] MODERATE — ambient light 53 lux (prev=MODERATE, delta=-21, stable=5196s, velocity=0.0 lux/s [STABLE FLAT])')" = LIT ] \
    || { echo "  FAIL: phone MODERATE must map LIT"; exit 1; }
  [ "$(_light_map '[room-dim] DIM — ambient light 12 lux (prev=DIM, delta=0, stable=60s, velocity=0.0 lux/s [STABLE FLAT])')" = LOW ] \
    || { echo "  FAIL: phone DIM must map LOW"; exit 1; }
  [ "$(_light_map '[room-lit] LIT (webcam-derived, coarse — phone offline; LIT mean=142.3 stddev=38.1)')" = LIT ] \
    || { echo "  FAIL: webcam-coarse LIT must map LIT"; exit 1; }
  [ "$(_light_map '[room-twilight] TWILIGHT (webcam-derived, coarse — phone offline; TWILIGHT mean=61.0 stddev=22.4)')" = LIT ] \
    || { echo "  FAIL: webcam TWILIGHT (mid-luma, some light) must map LIT like phone-MODERATE"; exit 1; }
  [ "$(_light_map '[room-dark] DARK (webcam-derived, coarse — phone offline; DARK mean=9.2 stddev=6.0)')" = LOW ] \
    || { echo "  FAIL: webcam DARK must map LOW"; exit 1; }
  [ "$(_light_map 'n/a covered (lens blocked/blank — flat field mean=128.0 stddev=1.2 < 4.0, no ambient-light info)')" = UNKNOWN ] \
    || { echo "  FAIL: covered lens must map UNKNOWN, never a faked level"; exit 1; }
  [ "$(_light_map 'phone unreachable — can'\''t read ambient light (not an alarm)')" = UNKNOWN ] \
    || { echo "  FAIL: unreachable n/a must map UNKNOWN"; exit 1; }
  [ "$(_light_map '')" = UNKNOWN ] || { echo "  FAIL: empty (timeout-killed) output must map UNKNOWN"; exit 1; }
  # Case 24c (CAM-DARK TOKEN): cam_dark surfaces as cam-dark in degraded — visibly distinct from
  # cam-blind (fault) so a dark night stops reading as a broken camera.
  cam_degraded=0; cam_dark=1; _derive_occupancy 'UNCERTAIN' 'STILL' 'NONE' 'STILL' 'LOW' 1 1 'QUIET' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  case "$degraded" in *cam-dark*) :;; *) echo "  FAIL: cam_dark must list cam-dark (got $degraded)"; exit 1;; esac
  case "$degraded" in *cam-blind*) echo "  FAIL: cam-dark night must NOT read cam-blind (got $degraded)"; exit 1;; esac
  # Case 24d (MIXED-NOT-OFFLINE): soft axis gaps with BOTH organs up must render room_mode=MIXED —
  # OFFLINE is reserved for a down organ (the live 8/10-axes-assessed-yet-OFFLINE overstatement).
  [ "$room_mode" = "MIXED" ] || { echo "  FAIL: soft-degraded UNCERTAIN with organs up must be MIXED not $room_mode"; exit 1; }
  cam_dark=0
  cam_degraded=1; _derive_occupancy 'UNCERTAIN' 'STILL' 'NONE' 'UNKNOWN' 'LOW' 1 1 'QUIET' 'IDLE' 'UNKNOWN'
  [ "$room_mode" = "MIXED" ] || { echo "  FAIL: cam-blind alone (organs up) must be MIXED not $room_mode"; exit 1; }
  case "$degraded" in *cam-blind*) :;; *) echo "  FAIL: cam-blind must still be LISTED while MIXED (got $degraded)"; exit 1;; esac
  cam_degraded=0
  # Case 25 (APPLIANCE-VS-PERSON, phone+BLE offline): ambient LOUD + LIVE camera STILL must NOT assert
  # PRESENT — a live-still cam contradicts a present person; LOUD-alone is likely the TV → UNCERTAIN.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD' 'IDLE' 'STILL'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: LOUD+cam-STILL (no phone/BLE) must be UNCERTAIN not $verdict (appliance-vs-person)"; exit 1; }
  # Case 26 (APPLIANCE-VS-PERSON, phone offline / BLE saw nothing): same gate on the po=0 branch — this
  # is the live-reproduced false-PRESENT (operator AWAY, TV LOUD, cam STILL, ble NONE).
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'LOUD' 'IDLE' 'STILL'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: LOUD+cam-STILL (phone offline, no BLE) must be UNCERTAIN not $verdict"; exit 1; }
  # Case 26b (HONEST-DEGRADED): camera STILL + screen OFF + WiFi STILL should settle EMPTY even when BLE is only weak/none.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'STILL' 'UNKNOWN' 0 1 'SILENCE' 'IDLE' 'STILL' 'UNKNOWN' 'INITIAL' '-1' 'OFF'
  [ "$verdict" = "EMPTY" ] || { echo "  FAIL: cam STILL + screen OFF + WiFi STILL should give EMPTY (got $verdict)"; exit 1; }
  # Case 27 (NO over-correction): cam=UNKNOWN (dead/absent camera) cannot contradict, so LOUD-alone
  # KEEPS sound-proves-occupancy=PRESENT — the downgrade is gated on a LIVE STILL camera, not on absence.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'LOUD' 'IDLE' 'UNKNOWN'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: LOUD+cam-UNKNOWN must stay PRESENT (no over-correction) not $verdict"; exit 1; }
  # Case 28 (SELF-PLAYBACK, phone+BLE offline): own speakers PLAYING_SELF + ambient LOUD must NOT
  # assert PRESENT — the mic is hearing this node's own room-music grind (covered cam + NIGHT-QUIET
  # clock both miss it: the live 2026-07-06 false-PRESENT hole). FALSIFIABLE: drop the aself gate → flips.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'UNKNOWN' 'OFFLINE' 'PLAYING_SELF'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: LOUD + own speakers PLAYING_SELF (no phone/BLE) must be UNCERTAIN not $verdict (self-playback)"; exit 1; }
  printf '%s' "$reason" | grep -q 'self-playback' || { echo "  FAIL: self-playback downgrade must name self-playback in reason (got $reason)"; exit 1; }
  # Case 28b (SELF-PLAYBACK, phone offline / BLE saw nothing): same gate on the po=0 branch.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'MODERATE' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'UNKNOWN' 'OFFLINE' 'PLAYING_SELF'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: MODERATE + own speakers PLAYING_SELF (phone offline) must be UNCERTAIN not $verdict"; exit 1; }
  # Case 28g (EXAFFERENCE, phone+BLE offline): own speakers PLAYING_EXTERNAL (an outside stream, e.g.
  # a person's video — NOT the mesh's own output) must NOT be discounted like PLAYING_SELF — it falls
  # through to the same LOUD-alone reasoning as a bare non-playing read (cm=UNKNOWN can't contradict).
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'UNKNOWN' 'OFFLINE' 'PLAYING_EXTERNAL'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: LOUD + PLAYING_EXTERNAL (no phone/BLE, cam UNKNOWN) must be PRESENT not $verdict (exafference isn't self-noise)"; exit 1; }
  # Case 28h (EXAFFERENCE still contradicted by a live-STILL camera): PLAYING_EXTERNAL skips the
  # self-playback branch but a LIVE camera showing STILL still means "likely TV", same as bare LOUD.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD' 'IDLE' 'STILL' 'UNKNOWN' 'INITIAL' '-1' 'UNKNOWN' 'OFFLINE' 'PLAYING_EXTERNAL'
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: LOUD + PLAYING_EXTERNAL + cam-STILL must still be UNCERTAIN not $verdict"; exit 1; }
  # Case 28c (NO over-correction): speakers verifiably SILENT keeps sound-proves-occupancy=PRESENT —
  # the discount fires only on a POSITIVE PLAYING read, exactly like the cam=UNKNOWN rule.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'UNKNOWN' 'OFFLINE' 'SILENT'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: LOUD + speakers SILENT must stay PRESENT (no over-correction) not $verdict"; exit 1; }
  # Case 28d (person-specific signals NEVER discounted): kbd TYPING wins over self-playback.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 1 'LOUD' 'TYPING' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1' 'UNKNOWN' 'OFFLINE' 'PLAYING_SELF'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: kbd TYPING must stay PRESENT even while self-playing (got $verdict)"; exit 1; }
  # Case 28e (BACK-COMPAT): a 15-arg call (aself defaults UNKNOWN) must preserve Case 11's PRESENT.
  _fuse_verdict 'UNKNOWN' 'NONE' '' 'UNKNOWN' 'UNKNOWN' 0 0 'LOUD'
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL: aself-absent default must preserve LOUD→PRESENT (got $verdict)"; exit 1; }
  # Case 28f (EVIDENCE): the early-return mic paths must carry a populated signals string (was empty).
  printf '%s' "$signals" | grep -q 'audio_self=UNKNOWN' || { echo "  FAIL: mic-path signals must carry audio_self (got '$signals')"; exit 1; }
  # Case 28 (FLAT-FIELD / BLIND-LENS, FALSIFIABLE): a fresh-but-FLAT cam-prev.jpg (covered/capped lens) must
  # be detected as flat (→ cam_degraded/cam-blind, NOT a faked live STILL). A frame with real scene variance
  # must read non-flat (→ eligible for STILL). Synthetic grayscale frames; PIL-gated (skip if absent).
  if python3 -c 'import PIL' 2>/dev/null; then
    _cd="$(mktemp -d)"
    python3 - "$_cd" <<'PY'
import sys, os, random
from PIL import Image
d=sys.argv[1]
Image.new("L",(48,48),17).save(os.path.join(d,"flat.jpg"))   # covered lens: constant field
random.seed(2); im=Image.new("L",(48,48)); px=im.load()
for y in range(48):
    for x in range(48): px[x,y]=int(max(0,min(255,90+random.randint(-30,30))))
im.save(os.path.join(d,"scene.jpg"))                          # real scene variance
PY
    [ "$(_cam_flat "$_cd/flat.jpg")" = 1 ]  || { echo "  FAIL: flat field (covered lens) must be flat=1 → cam-blind, not a faked STILL"; rm -rf "$_cd"; exit 1; }
    [ "$(_cam_flat "$_cd/scene.jpg")" = 0 ] || { echo "  FAIL: frame with scene variance must be flat=0 → eligible for STILL"; rm -rf "$_cd"; exit 1; }
    rm -rf "$_cd"
  fi
  # Case 29 (ADDR-TYPE FUSION, FALSIFIABLE): the nameless-BLE person discriminator. A RANDOM
  # (locally-administered, 0x02 bit set) first octet → person-attributed; a PUBLIC OUI → NOT; a
  # malformed octet → NOT (honest, never silently personal). Live examples from a real scan row.
  # Address type comes from BlueZ, NOT from the MAC bytes. The fixtures below are this node's own room
  # (2026-08-16): 61:22:E7 and 45:D7:88 have the U/L bit CLEAR yet BlueZ calls them random, E7:4D:F9 has
  # it SET yet BlueZ calls it public — so the deleted bit-rule goes red on all three instead of agreeing
  # by luck, and a U/L-set MAC that BlueZ does not hold must NOT be called random.
  MESH_ADDRTYPE_MAP="$(printf '%s\n' '61:22:E7:C3:60:DE random' '45:D7:88:2B:A6:29 random' 'E7:4D:F9:65:B0:65 public')" _addrtype_map_init
  _is_random_mac "61:22:E7:C3:60:DE" || { echo "  FAIL: U/L-bit CLEAR but BlueZ says RANDOM — must be person-attributed"; exit 1; }
  _is_random_mac "45:d7:88:2b:a6:29" || { echo "  FAIL: lowercase MAC must match the (uppercase) BlueZ map"; exit 1; }
  _is_random_mac "E7:4D:F9:65:B0:65" && { echo "  FAIL: U/L-bit SET but BlueZ says PUBLIC — must NOT be person-attributed"; exit 1; }
  _is_random_mac "73:EA:8D:A5:F3:71" && { echo "  FAIL: MAC absent from the BlueZ map must NOT be called random (axis lost honestly, never guessed)"; exit 1; }
  _is_random_mac "zz:bb:cc:dd:ee:ff" && { echo "  FAIL: malformed first octet must NOT be called random (honest)"; exit 1; }
  MESH_ADDRTYPE_MAP="" _addrtype_map_init
  _is_random_mac "61:22:E7:C3:60:DE" && { echo "  FAIL: empty map (no BlueZ/dbus) must degrade to NOT-random, never guessed from the bit"; exit 1; }
  # the map really comes from mesh-presence's single source (not re-derived here) — every line it hands
  # back must be a MAC + a real address type; a live BlueZ device must resolve through this same path.
  _atm="$(mesh-presence --addrtype-map 2>/dev/null || true)"
  if [ -n "$_atm" ]; then
    printf '%s\n' "$_atm" | grep -qvE '^[0-9A-F]{2}(:[0-9A-F]{2}){5} (public|random)$' \
      && { echo "  FAIL: mesh-presence --addrtype-map emitted a malformed line"; exit 1; }
    _atm_r="$(printf '%s\n' "$_atm" | awk '$2=="random"{print $1; exit}')"
    if [ -n "$_atm_r" ]; then
      _addrtype_map_init
      _is_random_mac "$_atm_r" || { echo "  FAIL: live BlueZ random device $_atm_r must read random through _is_random_mac"; exit 1; }
    fi
  fi
  # Case 30 (PRESENCE SESSION FUSION, FALSIFIABLE): parse the settled-session summary from mesh-presence
  # and use it to upgrade a strong BLE-present room into SETTLED/high rather than plain ACTIVE/medium.
  _pl="inventory: 2 devices | strongest: [TV] Samsung 5 Series (40) (-74 dBm) | types: VR:1 TV:1  | proximity: ROOM:2  | churn: new=0 gone=4 stable=2 | trend: approaching=0 receding=0 stable=2 initial=0 | attribution: personal=1 appliance=1 ambiguous=0 | unidentified: public=0 random=0 unknown=0 | personal_presence: ACTIVE_FAR (pers-trend: approaching=0 receding=0 stable=1 initial=0; pers-prox: near=0 far=1) | familiarity: FAMILIAR|30min+ (settled presence) (session_max_s=230350)"
  [ "$(parse_presence_field "$_pl" familiarity)" = FAMILIAR ] || { echo "  FAIL: presence summary familiarity should parse as FAMILIAR"; exit 1; }
  [ "$(parse_presence_field "$_pl" session_max_s)" = 230350 ] || { echo "  FAIL: presence summary session_max_s should parse as 230350"; exit 1; }
  _derive_occupancy 'PRESENT' 'UNKNOWN' 'PRESENT_STRONG' 'UNKNOWN' 'UNKNOWN' 0 1 'QUIET' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'FAMILIAR' '230350'
  [ "$room_mode" = "SETTLED" ] || { echo "  FAIL: familiar strong BLE should yield room_mode=SETTLED (got $room_mode)"; exit 1; }
  [ "$confidence" = "high" ] || { echo "  FAIL: familiar strong BLE should yield high confidence (got $confidence)"; exit 1; }
  # Case 30b (NAMELESS-BLE CONFIDENCE CAP, FALSIFIABLE): PRESENT via a nameless random-MAC ALONE, with
  # every corroborating axis blind (loud room, no motion/body/kbd, INITIAL familiarity so the SETTLED
  # path can't upgrade it), must stay OCCUPIED but confidence=medium — not high. Flipping ble_nameless_only
  # (nameless→named) flips the assert to high, proving the cap keys on the device being unidentified.
  ble_nameless_only=1; cam_degraded=0
  _derive_occupancy 'PRESENT' 'UNKNOWN' 'PRESENT_STRONG' 'UNKNOWN' 'UNKNOWN' 0 1 'LOUD' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1'
  [ "$occupancy" = "OCCUPIED" ] || { echo "  FAIL: nameless BLE present should stay OCCUPIED (got $occupancy)"; exit 1; }
  [ "$confidence" = "medium" ] || { echo "  FAIL: nameless-random BLE ALONE must cap confidence at medium, not high (got $confidence)"; exit 1; }
  ble_nameless_only=0
  _derive_occupancy 'PRESENT' 'UNKNOWN' 'PRESENT_STRONG' 'UNKNOWN' 'UNKNOWN' 0 1 'LOUD' 'IDLE' 'UNKNOWN' 'UNKNOWN' 'INITIAL' '-1'
  [ "$confidence" = "high" ] || { echo "  FAIL: NAMED strong BLE (same posture) should yield high confidence (got $confidence)"; exit 1; }
  ble_nameless_only=0
  # Case 31 (APPLIANCE CONTEXT FUSION, FALSIFIABLE): loud/moderate audio + appliance clock + live STILL
  # camera + WiFi STILL is richer than plain UNKNOWN; surface it as room_mode=APPLIANCE.
  cam_degraded=0; _derive_occupancy 'UNCERTAIN' 'STILL' 'NONE' 'STILL' 'LOW' 1 1 'LOUD' 'IDLE' 'STILL' 'ACTIVE' 'INITIAL' '-1' 'OFF'
  [ "$occupancy" = "UNKNOWN" ] || { echo "  FAIL: appliance context should stay UNKNOWN occupancy (got $occupancy)"; exit 1; }
  [ "$room_mode" = "APPLIANCE" ] || { echo "  FAIL: appliance context should yield room_mode=APPLIANCE (got $room_mode)"; exit 1; }
  # --- OCCUPANCY_DWELL classifier (FALSIFIABLE: change the 5/60/1800 thresholds → these flip) ---
  _df=0
  # TRANSITION: 0s, 4s
  r="$(classify_dwell 0)";   echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 0s: got=$r"; _df=1; }
  r="$(classify_dwell 4)";   echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 4s: got=$r"; _df=1; }
  # RECENT: 5s (boundary), 59s
  r="$(classify_dwell 5)";   echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 5s: got=$r"; _df=1; }
  r="$(classify_dwell 59)";  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 59s: got=$r"; _df=1; }
  # STABLE: 60s (boundary), 1740s
  r="$(classify_dwell 60)";  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 60s: got=$r"; _df=1; }
  r="$(classify_dwell 1740)";echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 1740s: got=$r"; _df=1; }
  # CHRONIC: 1800s (boundary), 86400s
  r="$(classify_dwell 1800)";echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 1800s: got=$r"; _df=1; }
  r="$(classify_dwell 86400)";echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 86400s: got=$r"; _df=1; }
  # NEVER: empty
  r="$(classify_dwell '')";  [ "$r" = "NEVER|no reading on record" ] || { echo "  FAIL dwell NEVER: got=$r"; _df=1; }
  # log_room_event: pure, file-bound
  _ed="$(mktemp -d)"; _ef="$_ed/e"
  log_room_event "$_ef" 100 PRESENT 200
  log_room_event "$_ef" 150 EMPTY 200
  log_room_event "$_ef" 175 PRESENT 200
  c="$(count_recent_events "$_ef" 250 86400)"
  [ "$c" = "3" ] || { echo "  FAIL log_room_event basic: expected 3 got=$c"; _df=1; }
  # Pruning: events older than 24h relative to NOW are dropped
  log_room_event "$_ef" -100000 PRESENT 200
  c2="$(count_recent_events "$_ef" 200 86400)"
  [ "$c2" = "3" ] || { echo "  FAIL log_room_event pruning: expected 3 got=$c2"; _df=1; }
  rm -rf "$_ed"
  # gate_tamper_recency: freshness gate on the tamper positive labels (honest-degrade)
  #   FRESH positive passes through; STALE positive → STALE; non-positive & malformed epoch pass through.
  r="$(gate_tamper_recency RECENT 900 1000 1500)"; [ "$r" = "RECENT" ] || { echo "  FAIL tamper-gate fresh RECENT: got=$r"; _df=1; }
  r="$(gate_tamper_recency ACTIVE 990 1000 1500)"; [ "$r" = "ACTIVE" ] || { echo "  FAIL tamper-gate fresh ACTIVE: got=$r"; _df=1; }
  r="$(gate_tamper_recency RECENT 1000 3000 1500)";[ "$r" = "STALE" ]  || { echo "  FAIL tamper-gate frozen RECENT→STALE: got=$r"; _df=1; }
  r="$(gate_tamper_recency ACTIVE 1000 3000 1500)";[ "$r" = "STALE" ]  || { echo "  FAIL tamper-gate frozen ACTIVE→STALE: got=$r"; _df=1; }
  r="$(gate_tamper_recency RECENT 1000 2501 1500)";[ "$r" = "STALE" ]  || { echo "  FAIL tamper-gate boundary >stale→STALE: got=$r"; _df=1; }
  r="$(gate_tamper_recency RECENT 1000 2500 1500)";[ "$r" = "RECENT" ] || { echo "  FAIL tamper-gate boundary ==stale→hold: got=$r"; _df=1; }
  r="$(gate_tamper_recency COLD 1000 9999 1500)";  [ "$r" = "COLD" ]   || { echo "  FAIL tamper-gate non-positive passthrough: got=$r"; _df=1; }
  r="$(gate_tamper_recency OFFLINE 1000 9999 1500)";[ "$r" = "OFFLINE" ]|| { echo "  FAIL tamper-gate OFFLINE passthrough: got=$r"; _df=1; }
  r="$(gate_tamper_recency RECENT xyz 3000 1500)"; [ "$r" = "RECENT" ] || { echo "  FAIL tamper-gate malformed-epoch passthrough: got=$r"; _df=1; }
  r="$(gate_tamper_recency RECENT '' 3000 1500)";  [ "$r" = "RECENT" ] || { echo "  FAIL tamper-gate empty-epoch passthrough: got=$r"; _df=1; }
  # Fusion integration: a STALE tamper must NOT force PRESENT when every other axis is blind/neutral
  #   (proves the gate actually closes the hollow-PRESENT path, not just relabels the field).
  _fuse_verdict STILL PRESENT_WEAK "" UNCERTAIN UNKNOWN 0 0 UNKNOWN UNKNOWN UNKNOWN UNKNOWN INITIAL -1 UNKNOWN STALE UNKNOWN >/dev/null 2>&1; _fv=$?
  [ "$verdict" != "PRESENT" ] || { echo "  FAIL tamper-gate STALE must not force PRESENT: got verdict=$verdict"; _df=1; }
  # Control: the SAME inputs with a live RECENT tamper DO force PRESENT (the gate is the only difference).
  _fuse_verdict STILL PRESENT_WEAK "" UNCERTAIN UNKNOWN 0 0 UNKNOWN UNKNOWN UNKNOWN UNKNOWN INITIAL -1 UNKNOWN RECENT UNKNOWN >/dev/null 2>&1
  [ "$verdict" = "PRESENT" ] || { echo "  FAIL tamper-gate live RECENT should drive PRESENT (control): got verdict=$verdict"; _df=1; }
  [ "$_df" = 0 ] || { echo "smoke-test: FAIL (occupancy_dwell assertions)"; exit 1; }

  # --- dwell_observed: the blind-gap truncation (regression for the 2026-08-22 9h10m power-off,
  # where .room-sense.state published dwell_s=86366 across an interval nobody was watching) ---
  _dw=0
  _dwt="$(mktemp)"; _sav_bg="$BLIND_GAP_S"; BLIND_GAP_S=900
  # A 5-minute-cadence tape covering 01:00:00Z..02:00:00Z with NO hole. start = 01:00:00Z.
  : > "$_dwt"; _t=$(date -u -d '2026-08-22T01:00:00Z' +%s)
  for _i in $(seq 0 12); do date -u -d "@$(( _t + _i*300 ))" +%FT%TZ >> "$_dwt"; done
  _r="$(dwell_observed "$_dwt" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "3600|100" ] || { echo "  FAIL dwell_observed: unbroken tape should be 3600|100, got '$_r'"; _dw=1; }
  # Same window, but 01:10:00Z..01:50:00Z is missing (a 2400s hole > 900s). The claim must restart
  # at the far side of the hole, not span it: dwell = 02:00 - 01:50 = 600s, coverage = (3600-2400)/3600.
  : > "$_dwt"
  for _i in 0 1 2; do date -u -d "@$(( _t + _i*300 ))" +%FT%TZ >> "$_dwt"; done
  for _i in 10 11 12; do date -u -d "@$(( _t + _i*300 ))" +%FT%TZ >> "$_dwt"; done
  _r="$(dwell_observed "$_dwt" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "600|33" ] || { echo "  FAIL dwell_observed: 2400s blind gap should truncate to 600|33, got '$_r'"; _dw=1; }
  # Cron jitter is NOT blindness: a 600s hole (2x cadence, under the 900s threshold) changes nothing.
  : > "$_dwt"
  for _i in 0 1 2 4 5 6 7 8 9 10 11 12; do date -u -d "@$(( _t + _i*300 ))" +%FT%TZ >> "$_dwt"; done
  _r="$(dwell_observed "$_dwt" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "3600|100" ] || { echo "  FAIL dwell_observed: a 600s sub-threshold hole must not truncate, got '$_r'"; _dw=1; }
  # MISSING EVIDENCE RENDERS na, NEVER 100 — the whole point of the field. Three shapes:
  _r="$(dwell_observed "$_dwt/no-such-dir/tape" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "3600|na" ] || { echo "  FAIL dwell_observed: unreadable tape must be <wall>|na, got '$_r'"; _dw=1; }
  : > "$_dwt"
  _r="$(dwell_observed "$_dwt" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "3600|na" ] || { echo "  FAIL dwell_observed: empty tape must be <wall>|na, got '$_r'"; _dw=1; }
  # Tape pruned past the window (retention shorter than the dwell): first row is AFTER the change,
  # so nothing can be said about the interval before it — na, not a flattering 100.
  : > "$_dwt"
  for _i in 6 7 8 9 10 11 12; do date -u -d "@$(( _t + _i*300 ))" +%FT%TZ >> "$_dwt"; done
  _r="$(dwell_observed "$_dwt" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "3600|na" ] || { echo "  FAIL dwell_observed: tape not reaching the change must be <wall>|na, got '$_r'"; _dw=1; }
  # A junk-only tape parses nothing — a parse that consumes nothing is never a measurement.
  printf 'garbage\nnot a timestamp\n' > "$_dwt"
  _r="$(dwell_observed "$_dwt" "$_t" "$(( _t + 3600 ))")"
  [ "$_r" = "3600|na" ] || { echo "  FAIL dwell_observed: unparseable tape must be <wall>|na, got '$_r'"; _dw=1; }
  # No last-change timestamp at all → 0|na, never a wall-clock number off an empty start.
  _r="$(dwell_observed "$_dwt" "" "$(( _t + 3600 ))")"
  [ "$_r" = "0|na" ] || { echo "  FAIL dwell_observed: empty start must be 0|na, got '$_r'"; _dw=1; }
  # Cross-year civil-date arithmetic (the hand-rolled dfc() replaces gawk's mktime, so its
  # leap/era handling is asserted rather than assumed): 2028-02-29 is a real day.
  _t2=$(date -u -d '2028-02-29T23:00:00Z' +%s); : > "$_dwt"
  for _i in $(seq 0 12); do date -u -d "@$(( _t2 + _i*300 ))" +%FT%TZ >> "$_dwt"; done
  _r="$(dwell_observed "$_dwt" "$_t2" "$(( _t2 + 3600 ))")"
  [ "$_r" = "3600|100" ] || { echo "  FAIL dwell_observed: leap-day boundary should be 3600|100, got '$_r'"; _dw=1; }
  rm -f "$_dwt"; BLIND_GAP_S="$_sav_bg"
  [ "$_dw" = 0 ] || { echo "smoke-test: FAIL (dwell_observed assertions)"; exit 1; }
  # --- --status fixtures (offline, file-bound — no scan, no phone, no writes) ---
  # STATE is derived from MESH_DIR ("$MESH_DIR/.room-sense.state", hardcoded concat, not itself
  # env-overridable) — so fixtures point a sandboxed MESH_DIR at the re-exec'd "$0" --status rather
  # than trying to override STATE directly (that env var would just be clobbered by the concat).
  _sd="$(mktemp -d)"; _sstate="$_sd/.room-sense.state"
  printf 'PRESENT|dwell_s=42|changes_24h=3\n' > "$_sstate"
  _so="$(MESH_DIR="$_sd" "$0" --status 2>&1)"; _src=$?
  [ "$_src" = 0 ] || { echo "  FAIL status: fresh PRESENT state should exit 0, got rc=$_src"; _df=1; }
  printf '%s' "$_so" | grep -q 'PRESENT' || { echo "  FAIL status: expected label PRESENT in output: $_so"; _df=1; }
  printf '%s' "$_so" | grep -q 'dwell_s=42' || { echo "  FAIL status: expected dwell_s=42 passthrough: $_so"; _df=1; }
  printf '%s' "$_so" | grep -q 'changes_24h=3' || { echo "  FAIL status: expected changes_24h=3 passthrough: $_so"; _df=1; }
  printf 'OFFLINE|2026-01-01T00:00:00Z\n' > "$_sstate"
  _before_mtime="$(stat -c %Y "$_sstate")"
  _so2="$(MESH_DIR="$_sd" "$0" --status 2>&1)"; _src2=$?
  [ "$_src2" = 2 ] || { echo "  FAIL status: OFFLINE cached state should exit 2, got rc=$_src2"; _df=1; }
  printf '%s' "$_so2" | grep -q 'OFFLINE' || { echo "  FAIL status: expected OFFLINE label: $_so2"; _df=1; }
  _after_mtime="$(stat -c %Y "$_sstate")"
  [ "$_before_mtime" = "$_after_mtime" ] || { echo "  FAIL status: --status must be read-only (mtime changed)"; _df=1; }
  _so3="$(MESH_DIR="$_sd/absent" "$0" --status 2>&1)"; _src3=$?
  [ "$_src3" = 2 ] || { echo "  FAIL status: no cached state should exit 2, got rc=$_src3"; _df=1; }
  printf '%s' "$_so3" | grep -qi 'no cached state' || { echo "  FAIL status: expected 'no cached state' message: $_so3"; _df=1; }
  rm -rf "$_sd"
  [ "$_df" = 0 ] || { echo "smoke-test: FAIL (status fixtures)"; exit 1; }

  # --- OBSERVATION TAPE vs WAKE EDGE (selection-on-the-predictor, 2026-08-17) ---
  # The load-bearing key: the two duties must DISAGREE on the same input. A medium-confidence
  # evaluation is exactly what the wake gate drops — if the tape drops it too, the tape is still
  # selected on the variable it records and H(confidence) stays 0 (mutant: gate tape_room_eval on
  # confidence=high and this block goes red).
  _tf=0
  wake_emit_ok PRESENT high    || { echo "  FAIL wake_emit_ok: PRESENT+high must fire the wake edge"; _tf=1; }
  wake_emit_ok PRESENT medium  && { echo "  FAIL wake_emit_ok: PRESENT+medium must NOT fire the wake edge"; _tf=1; }
  wake_emit_ok EMPTY high      && { echo "  FAIL wake_emit_ok: EMPTY must NOT fire the wake edge"; _tf=1; }
  ( MISHA_CONFIRMED_ONLY=0; wake_emit_ok EMPTY low ) || { echo "  FAIL wake_emit_ok: MISHA_CONFIRMED_ONLY=0 opt-out lost"; _tf=1; }
  _td="$(mktemp -d)"; ROOM_TAPE="$_td/room-sense-tape.log"; ROOM_TAPE_KEEP=5
  tape_room_eval 2026-08-17T00:00:00Z PRESENT   high   OCCUPIED OCCUPIED none ble
  tape_room_eval 2026-08-17T00:05:00Z EMPTY     medium EMPTY    EMPTY    cam-blind kbd
  tape_room_eval 2026-08-17T00:10:00Z UNCERTAIN low    UNKNOWN  UNKNOWN  phone-unreachable none
  [ "$(grep -c '' "$ROOM_TAPE" 2>/dev/null)" = 3 ] || { echo "  FAIL tape: 3 evaluations must yield 3 records, got $(grep -c '' "$ROOM_TAPE" 2>/dev/null)"; _tf=1; }
  grep -q 'verdict=EMPTY confidence=medium' "$ROOM_TAPE" || { echo "  FAIL tape: the medium-confidence EMPTY the wake gate DROPS must still be recorded"; _tf=1; }
  # H(confidence) > 0 as recorded — the whole point: >1 distinct value survives to the tape
  _tc="$(grep -o 'confidence=[a-z]*' "$ROOM_TAPE" | sort -u | grep -c '')"
  [ "$_tc" -ge 3 ] || { echo "  FAIL tape: confidence axis collapsed to $_tc distinct value(s) — selection on the predictor is back"; _tf=1; }
  # Trim keeps the NEWEST ROOM_TAPE_KEEP lines (a trim that keeps the oldest would freeze the tape)
  _i=0; while [ "$_i" -lt 300 ]; do tape_room_eval "2026-08-17T01:00:0${_i}Z" PRESENT high OCCUPIED OCCUPIED none fill; _i=$((_i+1)); done
  [ "$(grep -c '' "$ROOM_TAPE")" -le 300 ] || { echo "  FAIL tape: trim never fired — file grew to $(grep -c '' "$ROOM_TAPE") lines"; _tf=1; }
  tail -1 "$ROOM_TAPE" | grep -q 'signals=fill' || { echo "  FAIL tape: the newest record must survive a trim"; _tf=1; }
  # Direction of the trim: appends always land at the end, so "newest survives" cannot tell tail from
  # head. The discriminating claim is that the OLDEST records were the ones EVICTED.
  grep -q 'confidence=medium' "$ROOM_TAPE" && { echo "  FAIL tape: trim must evict the OLDEST records (a head-trim freezes the tape at its first window)"; _tf=1; }
  # Missing directory → no-op, never a crash and never a partial record elsewhere
  ROOM_TAPE="$_td/absent-dir/tape.log"; tape_room_eval 2026-08-17T02:00:00Z PRESENT high OCCUPIED OCCUPIED none x \
    || { echo "  FAIL tape: absent directory must be a silent no-op (rc=0)"; _tf=1; }
  [ -e "$_td/absent-dir/tape.log" ] && { echo "  FAIL tape: must not create a tree under an absent directory"; _tf=1; }
  rm -rf "$_td"; unset ROOM_TAPE ROOM_TAPE_KEEP
  [ "$_tf" = 0 ] || { echo "smoke-test: FAIL (observation-tape / wake-edge separation)"; exit 1; }

  # --- --redundancy: channel-redundancy probe (arXiv:2608.11506 energy-control transfer) ----------
  # Drives the REAL dispatch as a child with MESH_RS_RED_TAPE pointed at fixtures — never the live
  # tape, never a real artifact. Each leg names the direction it guards; every one was seen RED
  # against a mutant before it was kept (field-regex, blind-as-absent, no-cardinality-guard,
  # control-always-ok, no-gated-refusal, null=0.5, insufficient-exits-0, always-redundant).
  # UNCOVERED, named rather than papered over: MESH_RS_RED_MIN_EFF (the practical |AUC-0.5| floor)
  # survives being zeroed — with a real shift null no fixture family lands in the thin band where
  # that floor is the only thing deciding. It is a belt-and-braces knob, not a load-bearing gate.
  _rf=0
  _rd="$(mktemp -d)"
  # gen <file> <n> <mode:redundant|confined|lag> <uniqfield:0|1> <allpresent:0|1>
  # Deterministic LCG (no $RANDOM — a fixture that moves between runs cannot be argued about).
  _rgen() {
    local f="$1" n="$2" mode="$3" uniq="$4" allpres="$5" i s=12345 t=999 b w k extra
    local -a _b=()
    : > "$f"
    # The target is a PERSISTENT 2-state chain (stay put with p=0.93), not i.i.d. coin flips: real
    # occupancy comes in runs, and an i.i.d. fixture makes the shift null trivially easy — the lag
    # leg below cannot even exist against a series that has no autocorrelation to re-align.
    local cur=PRESENT_STRONG
    for (( i=0; i<n; i++ )); do
      s=$(( (1103515245*s + 12345) % 2147483648 ))
      if [ $(( (s/65536) % 100 )) -ge 93 ]; then
        [ "$cur" = NONE ] && cur=PRESENT_STRONG || cur=NONE
      fi
      _b[i]="$cur"
    done
    for (( i=0; i<n; i++ )); do
      t=$(( (1103515245*t + 12345) % 2147483648 ))
      b="${_b[i]}"
      if [ "$mode" = redundant ]; then
        # wifi agrees with ble 85% of the time → a genuine independent carrier
        if [ $(( (t/65536) % 100 )) -lt 85 ]; then
          [ "$b" = NONE ] && w=STILL || w=MOTION
        else
          [ "$b" = NONE ] && w=MOTION || w=STILL
        fi
      elif [ "$mode" = lag ]; then
        # wifi IS the target series, lagged 5 rows — a high raw AUC that is pure re-alignment.
        [ "${_b[$(( (i + n - 5) % n ))]}" = NONE ] && w=STILL || w=MOTION
      else
        if [ $(( (t/65536) % 100 )) -lt 50 ]; then w=STILL; else w=MOTION; fi
      fi
      if [ $(( (t/65536) % 3 )) = 0 ]; then k=IDLE; else k=TYPING; fi
      extra=""; [ "$uniq" = 1 ] && extra=" sess=$i"
      if [ "$allpres" = 1 ]; then
        b=PRESENT_STRONG; [ $(( i % 7 )) = 0 ] && b=UNKNOWN
      fi
      printf '2026-08-01T00:00:00Z verdict=X confidence=low status=S occupancy=O degraded=none signals=kbd=%s ble=%s wifi=%s%s\n' \
        "$k" "$b" "$w" "$extra"
    done > "$f"
  }
  # ${BASH_SOURCE[0]}, never "$0": invoked as `bash mesh-room-sense --test`, $0 carries NO slash, so
  # `env $0 …` searches PATH and silently drives the DEPLOYED copy instead of the file under test —
  # every leg then asserts against yesterday's binary (seen live: the legs failed, and the run took
  # 2m40 because the deployed copy has no --redundancy and fell through to the full live fusion).
  _rrun() { local tape="$1"; shift; MESH_RS_RED_TAPE="$tape" env "$@" bash "${BASH_SOURCE[0]}" --redundancy 2>&1; }

  _rgen "$_rd/redundant.log" 240 redundant 0 0
  _rgen "$_rd/confined.log"  240 confined  0 0
  _rgen "$_rd/uniq.log"      240 confined  1 0
  _rgen "$_rd/allpres.log"   240 confined  0 1
  _rgen "$_rd/short.log"      50 confined  0 0
  _rgen "$_rd/lag.log"       240 lag       0 0

  # 1. A family that really carries the target must be FOUND — else the probe is decorative.
  _o="$(_rrun "$_rd/redundant.log")"
  case "$_o" in *"REDUNDANT"*) ;; *) echo "  FAIL redundancy: a real carrier (wifi, 85% agreement) was not detected"; _rf=1 ;; esac
  case "$_o" in *"wifi"*ABOVE-NULL*) ;; *) echo "  FAIL redundancy: the carrier must be NAMED with its AUC, not just totalled"; _rf=1 ;; esac
  # 2. …and NOT found when it is not there. Same generator, same n, only the coupling removed.
  _o="$(_rrun "$_rd/confined.log")"
  case "$_o" in *"CONFINED"*) ;; *) echo "  FAIL redundancy: an uncoupled fixture must render CONFINED"; _rf=1 ;; esac
  # 2b. THE NULL MUST BIND, not just be described. A family that is the target series LAGGED 5 rows
  #     scores a high raw AUC and is not an independent carrier at all — only the shift null can say
  #     so, and it must. (Honest limit this leg pins down: the circular-shift null is CONSERVATIVE
  #     against lag-coupled relationships — a genuinely lagged carrier is refused too. That is the
  #     price of a null that survives autocorrelation, and it is the direction we want to fail in.)
  _o="$(_rrun "$_rd/lag.log")"
  case "$_o" in *"CONFINED"*) ;; *) echo "  FAIL redundancy: a LAGGED copy of the target must not pass as an independent carrier (shift null not binding)"; _rf=1 ;; esac
  # 3. The chained `signals=k=v` parse. `signals=kbd=IDLE` must yield the family kbd — a naive
  #    (\w+)=(\S+) scan eats `signals=kbd` and silently DROPS whichever channel sits first.
  case "$_o" in *"kbd "*) ;; *) echo "  FAIL redundancy: the first channel after signals= was swallowed by the field parse"; _rf=1 ;; esac
  case "$_o" in *"  signals "*) echo "  FAIL redundancy: 'signals' became a phantom family (chained-assignment parse)"; _rf=1 ;; esac
  # 4. A near-unique feature must be REFUSED, not scored — in-sample it fits any label, shifted too.
  _o="$(_rrun "$_rd/uniq.log")"
  case "$_o" in *"sess"*MEMORISING*) ;; *) echo "  FAIL redundancy: a 240-level field must be refused as MEMORISING"; _rf=1 ;; esac
  case "$_o" in *"REDUNDANT"*) echo "  FAIL redundancy: a memorising field must never become a carrier"; _rf=1 ;; esac
  # 5. A blind read (UNKNOWN) must be DROPPED, never folded into the absent class — folding it in
  #    would manufacture variance out of blindness and turn NO-VARIANCE into a scoreable answer.
  _o="$(_rrun "$_rd/allpres.log")"
  case "$_o" in *"NO-VARIANCE"*) ;; *) echo "  FAIL redundancy: an all-present target with UNKNOWN rows must render NO-VARIANCE (UNKNOWN folded into absent?)"; _rf=1 ;; esac
  case "$_o" in *"blind-dropped=34"*|*"blind-dropped=35"*) ;; *) echo "  FAIL redundancy: the blind-dropped count must be reported"; _rf=1 ;; esac
  # 6. Under the floor it refuses, and says WHEN it could answer instead of guessing now.
  _o="$(_rrun "$_rd/short.log")"; _rc=$?
  case "$_o" in *"INSUFFICIENT"*"answerable in"*) ;; *) echo "  FAIL redundancy: below the floor it must refuse AND date its own answerability"; _rf=1 ;; esac
  # 7. The WAKE-GATED log is refused by name: a redundancy answer computed on a tape selected by the
  #    target channel is void, so it must not be silently computable.
  _o="$(_rrun "$MESH_DIR/room-sense.log")"
  case "$_o" in *"REFUSED"*) ;; *) echo "  FAIL redundancy: the wake-gated room-sense.log must be REFUSED, not scored"; _rf=1 ;; esac
  # 8. The probe must PROVE it can see. With an uninformative control it must withhold the verdict —
  #    a CONFINED from a blind probe and a CONFINED from a confined channel read identically.
  _o="$(_rrun "$_rd/redundant.log" MESH_RS_RED_CTRL_FLIP=2)"
  case "$_o" in *"PROBE-UNVALIDATED"*) ;; *) echo "  FAIL redundancy: a control that cannot clear its null must void the verdict"; _rf=1 ;; esac
  case "$_o" in *"REDUNDANT — "*) echo "  FAIL redundancy: PROBE-UNVALIDATED must SUPPRESS the verdict, not accompany it"; _rf=1 ;; esac
  # 9. Exit codes: answered = 0, honestly-cannot-answer = 2 (the mesh n/a contract).
  _rrun "$_rd/confined.log" >/dev/null 2>&1;  [ $? = 0 ] || { echo "  FAIL redundancy: an ANSWERED run must exit 0"; _rf=1; }
  _rrun "$_rd/short.log"    >/dev/null 2>&1;  [ $? = 2 ] || { echo "  FAIL redundancy: INSUFFICIENT must exit 2 (n/a), not 0"; _rf=1; }
  # 10. Read-only: no writes to the tape it reads, none to STATE.
  _rb="$(stat -c %Y "$_rd/confined.log" 2>/dev/null)"
  _rrun "$_rd/confined.log" >/dev/null 2>&1
  [ "$_rb" = "$(stat -c %Y "$_rd/confined.log" 2>/dev/null)" ] || { echo "  FAIL redundancy: the probe wrote to the tape it reads"; _rf=1; }
  rm -rf "$_rd"
  [ "$_rf" = 0 ] || { echo "smoke-test: FAIL (channel-redundancy probe)"; exit 1; }

  echo "smoke-test: ok (16 fusion + 9 derived + 3 unsampled-presence + 3 cam-motion + 3 cam-liveness + 5 cam-dark-reclass + 8 light-map (phone/webcam/n-a-honesty) + 4 mixed-not-offline/cam-dark-token + 4 appliance-vs-person + 7 self-playback + 2 flat-field/blind-lens + 6 addr-type-fusion + live-bluez-addrtype + 2 presence-session fusion + 2 nameless-ble confidence-cap + 9 occupancy_dwell + 9 dwell_observed blind-gap assertions + 10 tamper-freshness-gate + 2 tamper-gate fusion + 5 status-read-only + 4 wake-edge-gate + 7 observation-tape + 17 channel-redundancy)"; exit 0
}

MODE=oneshot
[ "${1:-}" = --edge ] && MODE=edge
[ "${1:-}" = --json ] && MODE=json

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- BLE scan (node-local, no phone needed) ---
ble_verdict="NONE"
ble_reason=""
ble_out="$(mesh-presence 3 2>/dev/null)" || true
# A BUSY (adapter scan-locked) or SUSPECT (mesh-presence's n=0 honest-degraded path: known devices but
# 0 fresh RSSI = race-cleared cache) read has the header but NO device rows — it is NOT a successful
# empty scan. Treating it as ble_ok=1 + ble_verdict=NONE would feed a FALSE "no BLE present" into the
# occupancy fusion (the exact false-empty we refuse). Mark BLE UNSAMPLED so it degrades to UNCERTAIN.
case "$ble_out" in
  *BUSY*|*SUSPECT*) ble_out=""; ble_verdict="UNKNOWN"; ble_reason="BLE unsampled (degraded read)" ;;
esac
presence_familiarity="INITIAL"
presence_session_max_s="-1"
if [ -n "$ble_out" ]; then
  presence_line="$(printf '%s\n' "$ble_out" | grep '^inventory:' | tail -1)"
  if [ -n "$presence_line" ]; then
    presence_familiarity="$(parse_presence_field "$presence_line" familiarity)"
    presence_session_max_s="$(parse_presence_field "$presence_line" session_max_s)"
    [ -n "$presence_familiarity" ] || presence_familiarity="INITIAL"
    [ -n "$presence_session_max_s" ] || presence_session_max_s="-1"
  fi
fi
person_attr_reason=""   # nameless RANDOM-MAC (personal-attributed) candidate at NEAR proximity
ble_nameless_only=0     # 1 iff PRESENT_STRONG rests SOLELY on a nameless random-MAC (weaker than a named device)
if [ -n "$ble_out" ]; then
  _addrtype_map_init   # ONE BlueZ sweep for the whole loop (see _is_random_mac)
  # Check for strong named devices (non-? names, strong RSSI). A NAMELESS device is no longer discarded:
  # its address type is fused (RANDOM at NEAR proximity → person-occupancy candidate) — see below.
  while IFS='|' read -r rssi mac name; do
    rssi_num="${rssi//[^0-9-]/}"
    [ -z "$rssi_num" ] && continue
    if [ -z "$name" ] || [ "$name" = '?' ] || [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]]; then
      # Nameless / bare-MAC: no pattern to match, but a RANDOM-MAC at NEAR proximity is a person hint
      # (privacy-rotating phone/wearable). Record the strongest such candidate; a PUBLIC nameless MAC
      # (appliance/infra) is NOT recorded → never an over-claimed person. (named verdict still outranks.)
      if [ "$rssi_num" -ge "$PERSONAL_RSSI_THRESHOLD" ] 2>/dev/null && _is_random_mac "$mac"; then
        [ -z "$person_attr_reason" ] && person_attr_reason="personal-attributed nameless BLE (random addr) at ${rssi} dBm"
      fi
      continue
    fi
    if [ "$rssi_num" -ge "$BLE_RSSI_THRESHOLD" ] 2>/dev/null; then
      if printf '%s' "$name" | grep -qE "$STRONG_BLE_PATTERNS"; then
        ble_verdict="PRESENT_STRONG"
        ble_reason="named BLE '$name' at ${rssi} dBm"
        break
      elif printf '%s' "$name" | grep -qE "$WEAK_BLE_PATTERNS"; then
        ble_verdict="PRESENT_WEAK"
        ble_reason="TV/static BLE '$name' at ${rssi} dBm"
      fi
    fi
  done < <(printf '%s\n' "$ble_out" | grep -E '^-?[0-9]+\|')
  # A named known person-device (PRESENT_STRONG) outranks; otherwise a personal-attributed nameless
  # device promotes over NONE *and* over a mere appliance (PRESENT_WEAK = TV) — a present person beats a
  # present TV. Reuses the existing PRESENT_STRONG token (NO vocab change → no consumer ripple).
  if [ "$ble_verdict" != "PRESENT_STRONG" ] && [ -n "$person_attr_reason" ]; then
    ble_verdict="PRESENT_STRONG"
    ble_reason="$person_attr_reason"
    ble_nameless_only=1   # promoted by a nameless random-MAC, not a recognised device → confidence cap applies
  fi
fi
ble_ok=$( [ -n "$ble_out" ] && echo 1 || echo 0 )

# --- Persist BLE RSSI state (per-device snapshot) ---
BLE_RSSI_STATE="$HOME/.mesh/.room-sense-ble-rssi"
if [ -n "$ble_out" ]; then
  printf '%s\n' "$ble_out" | grep -E '^-?[0-9]+\|' | while IFS='|' read -r rssi mac name; do
    [ -z "$name" ] || [ "$name" = '?' ] && continue
    [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]] && continue
    echo "$name:$rssi"
  done > "$BLE_RSSI_STATE"
fi

# --- Ambient level (IdeaPad mic, local — no phone needed) ---
# mesh-ambient-level reads 1s of audio → RMS dB → SILENCE/QUIET/MODERATE/LOUD
# MODERATE/LOUD = sound activity in the room = occupancy weight when phone offline
ambient_level="UNKNOWN"
if command -v mesh-ambient-level >/dev/null 2>&1; then
  al_out="$(timeout 8 mesh-ambient-level 2>/dev/null)" || true
  if printf '%s' "$al_out" | grep -q 'LOUD'; then
    ambient_level="LOUD"
  elif printf '%s' "$al_out" | grep -q 'MODERATE'; then
    ambient_level="MODERATE"
  elif printf '%s' "$al_out" | grep -q 'QUIET'; then
    ambient_level="QUIET"
  elif printf '%s' "$al_out" | grep -q 'SILENCE'; then
    ambient_level="SILENCE"
  fi
fi

# --- Keyboard activity (node-local, no phone needed) ---
# Read the confirmed state from mesh-kbd-activity (cron: 3-59/5 --edge writes on transitions).
# TYPING = operator is actively typing → definitive PRESENT.
# LIGHT  = occasional key events → weak corroborating signal (not used to force PRESENT alone).
# IDLE   = no keyboard events in last assessment window → neutral.
#
# STALENESS GATE (2026-08-17, incident-room-sense-kbd-idle-is-a-28-day-corpse): this read used to be
# a bare `[ -f ] && cat`, while the REMOTE read fifteen lines below already gated at ≤720s with the
# reason spelled out — "older is a dead reflex, contributes nothing, never a cached PRESENT". Same
# value, two standards, adjacent lines, and the three sibling consumers (mesh-burn-window:read_fresh,
# mesh-interruptibility:read_axis, mesh-operator-focus:read_sense) all gate. On mesh-home
# mesh-kbd-activity exits 2 — correctly, the node has no keyboard (no i8042, no readable *-event-kbd)
# — so the reflex has written nothing since 2026-07-17, and the fusion published that corpse as a
# live `kbd=IDLE` for 28 days: a POSITIVE claim ("no key events in the last window") about a node
# that cannot make it. An honest exit 2 leaves the last value on disk; n/a is a verdict, not an
# eraser, so the gate belongs at the READER. 720s = 2× the 5-min reflex stride + jitter, matching the
# remote gate. The mtime is a valid liveness axis here because --edge TOUCHES $STATE every run
# (mesh-kbd-activity's liveness heartbeat) even when the verdict is unchanged — a frozen mtime means
# the reflex stopped answering, not that the verdict held.
kbd_verdict="$(_kbd_verdict_local "${MESH_KBD_STATE:-$HOME/.mesh/.kbd-activity.state}" "${MESH_KBD_MAX_AGE:-720}")"
# ABSENT vs UNREADABLE — the same split the screen axis makes below, for the same reason. A node with
# no keyboard has no keyboard sense to LOSE, so kbd-unknown there is not a degradation (that mistake
# is what pinned a permanent degraded=screen-unknown on this desktop until 2026-07-15). A node that
# HAS the organ and whose reflex went silent IS blind on that axis and must say so. Probe the tool
# itself rather than re-deriving its source detection (a second implementation of the i8042/evdev
# rule would be a fourth call site of the same lie): its availability gate exits 2 BEFORE the
# sampling sleep, so on a keyboard-less node this returns instantly. Only runs when the local state
# contributed nothing — a healthy node never pays for it.
kbd_absent=0
if [ "$kbd_verdict" = "UNKNOWN" ]; then
  if command -v mesh-kbd-activity >/dev/null 2>&1; then
    MESH_KBD_WINDOW=1 timeout 8 mesh-kbd-activity >/dev/null 2>&1
    [ $? = 2 ] && kbd_absent=1
  else
    kbd_absent=1   # no tool at all = no organ
  fi
fi
# ROOM-node keyboard: the room's physical keyboard may live on another node (default-string —
# the mic+Bose machine — runs mesh-kbd-activity on ITS keyboard). ROOM_KBD_NODE (user@host,
# set in ~/.mesh/nodes) names it; read its state with a staleness gate (≤720s = 2× the 5-min
# reflex stride + jitter — older is a dead reflex, contributes nothing, never a cached PRESENT).
# Merge keeps the STRONGER evidence: remote TYPING wins outright; LIGHT upgrades non-TYPING;
# IDLE only fills UNKNOWN (a real assessment beats blindness, never overrides local activity).
if [ -n "${ROOM_KBD_NODE:-}" ]; then
  # A DECLARED room keyboard is an organ this fusion EXPECTS. Whether it answers or not, the node is
  # not keyboard-less on this axis — so absence never applies here and an unreachable ROOM_KBD_NODE
  # stays an honest DEGRADATION, never a quiet "nothing to lose". (mesh-home's ROOM_KBD_NODE points
  # at default-string, gone since 2026-07-14; that is exactly the case that must keep surfacing.)
  kbd_absent=0
  _rkbd="$(timeout 5 ssh -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no "$ROOM_KBD_NODE" \
    'f="$HOME/.mesh/.kbd-activity.state"; if [ -f "$f" ] && [ "$(( $(date +%s) - $(stat -c %Y "$f") ))" -le 720 ]; then cat "$f"; fi' 2>/dev/null | head -1)"
  case "$_rkbd" in
    TYPING) kbd_verdict="TYPING" ;;
    LIGHT)  [ "$kbd_verdict" != "TYPING" ] && kbd_verdict="LIGHT" ;;
    IDLE)   [ "$kbd_verdict" = "UNKNOWN" ] && kbd_verdict="IDLE" ;;
  esac
fi

# --- Camera (node-local, phone-INDEPENDENT) ---
# Two facts, in priority order:
#  (1) MOTION — a FRESH .cam-motion stamp (≤ CAM_MOTION_TTL, default 180s): mesh-cam-watch saw movement
#      in the room → definitive LOCAL PRESENT (covers the room=UNCERTAIN gap when the phone is offline).
#  (2) Daemon LIVENESS — mesh-cam-watch rewrites cam-prev.jpg every poll (~1.5s). A FRESH cam-prev
#      (≤ CAM_LIVE_TTL) with no fresh motion = camera ALIVE, room at rest → STILL (a REAL signal, not
#      blind). A STALE cam-prev = the daemon DIED → UNKNOWN + cam-blind degraded (we WERE watching, now
#      blind — honest). An ABSENT cam-prev = this node has no camera sense → UNKNOWN, NOT degraded
#      (nothing to degrade). Mirrors mesh-activity-tempo _cam_classify — never a faked STILL on a dead cam.
# The old code keyed STILL off a STALE .cam-motion stamp, so a quiet room that had never moved (no stamp
# file) read UNKNOWN though the camera was live — a working sensor falsely rendered blind. Fixed here.
cam_verdict="UNKNOWN"; cam_degraded=0; cam_dark=0; cam_flat_fresh=0
CAM_MOTION_TTL="${MESH_CAM_MOTION_TTL:-180}"
CAM_LIVE_TTL="${MESH_CAM_LIVE_TTL:-120}"
_camnow="$(date +%s)"
if [ -f "$HOME/.mesh/.cam-motion" ]; then
  _cm="$(cat "$HOME/.mesh/.cam-motion" 2>/dev/null || echo 0)"; case "$_cm" in ''|*[!0-9]*) _cm=0;; esac
  [ "$(( _camnow - _cm ))" -ge 0 ] && [ "$(( _camnow - _cm ))" -le "$CAM_MOTION_TTL" ] && cam_verdict="MOTION"
fi
if [ "$cam_verdict" != "MOTION" ] && [ -f "$HOME/.mesh/cam-prev.jpg" ]; then
  _pv="$(stat -c %Y "$HOME/.mesh/cam-prev.jpg" 2>/dev/null || echo 0)"
  if [ "$(( _camnow - _pv ))" -ge 0 ] && [ "$(( _camnow - _pv ))" -le "$CAM_LIVE_TTL" ]; then
    # Fresh frame → daemon writing. But a covered/capped lens writes a FLAT field (no scene info): that is
    # BLIND, not a live STILL. Gate the STILL on real scene variance; flat → cam_degraded (cam-blind).
    if [ "$(_cam_flat "$HOME/.mesh/cam-prev.jpg")" = 1 ]; then
      cam_degraded=1         # fresh but FLAT → covered/blind lens → honestly blind, not a faked STILL
      cam_flat_fresh=1       # remember WHY: a fresh flat frame may reclassify to cam-dark once the
                             # light axis is known (dark room = expected flat, not a fault) — see _cam_reclass
    else
      cam_verdict="STILL"    # camera alive AND seeing scene detail, no recent motion → room genuinely at rest
    fi
  else
    cam_degraded=1           # cam-prev exists but stale → daemon died → honestly blind, not a faked STILL
  fi
fi

# --- Phone reachability (gates ONLY the genuinely phone-dependent axis: body motion) ---
# Derive phone_ok from a DIRECT TCP probe to the phone's sshd — NOT from wifi-motion's exit code.
# wifi-motion is now phone-free (node-side tape) and its exit 2 means "stale tape", so using it as a
# phone-liveness proxy FALSELY marked the phone unreachable whenever the wifi tape was stale (observed
# 2026-06-24: room-sense said phone-unreachable while the phone was LAN-reachable at .203 but the
# wifi.log tape was power-save-frozen). Decoupled: tape staleness no longer impersonates phone-offline.
phone_ok=0
if [ -n "$PHONE_IP" ] && timeout 2 bash -c "echo >/dev/tcp/$PHONE_IP/$PHONE_PORT" 2>/dev/null; then
  phone_ok=1
  rm -f "$OFFLINEFILE"
fi

# --- WiFi motion — PHONE-FREE (reads node-side ~/.mesh/wifi.log, the mesh-wifiscan nmcli tape) ---
# Revived node-side 2026-06-20 (the old phone-SSH version decayed: Android stopped refreshing its scan
# cache). Call UNCONDITIONALLY; it self-degrades to UNCERTAIN on a stale/short tape. Gating it on
# phone_ok was the same stale assumption as the light axis — WiFi motion sensing needs no phone, so it
# must work even when the phone is offline. ($HOME/.local/bin is IdeaPad-local — never SSH-wrap it.)
wifi_verdict="UNKNOWN"
# Capture BOTH streams: mesh-wifi-motion prints MOTION/STILL to stdout but its degraded UNCERTAIN
# (stale/short tape) to STDERR — 2>/dev/null would drop it and mislabel a stale tape as UNKNOWN.
wifi_out="$(timeout 12 mesh-wifi-motion 2>&1)" || true
if printf '%s' "$wifi_out" | grep -q 'MOTION'; then
  wifi_verdict="MOTION"
elif printf '%s' "$wifi_out" | grep -q 'STILL'; then
  wifi_verdict="STILL"
elif printf '%s' "$wifi_out" | grep -q 'UNCERTAIN'; then
  wifi_verdict="UNCERTAIN"
fi

# --- Ambient light (phone precise / webcam coarse) — mapped to LOW/LIT for fusion ---
# mesh-light is phone-first (Termux lux, DARK/DIM/MODERATE/LIT/BRIGHT) but now carries its OWN
# webcam fallback (coarse DARK/DIM/TWILIGHT/LIT off the cam-watch frame or one direct fswebcam
# grab; honest exit 2 with a classified reason — covered/no-frame/stale — when that fails too).
# So the old phone_ok gate here (which itself CORRECTED 6fd5688, right at the time: mesh-light
# had no webcam path then) is now the stale premise — it zeroed the light axis to UNKNOWN for
# the whole phone-offline stretch while mesh-light could answer coarsely from the webcam
# (observed live 2026-07-06: light axis UNKNOWN all afternoon, mesh-light webcam path healthy).
# UNGATE: always ask mesh-light; _light_map turns any n/a into UNKNOWN, so honesty is preserved.
# Timeout must cover the worst offline path INSIDE mesh-light (≈6s SSH probe + up to 20s direct
# fswebcam grab) — the old 10s would behead the fallback and re-create the UNKNOWN it exists to fix.
# _cam_reclass stays sound with a webcam-derived LOW: a flat (covered) frame never yields a level
# (mesh-light exits 2), so LOW always comes from a TEXTURED dark frame — a live camera.
light_out="$(timeout "${MESH_ROOM_LIGHT_TIMEOUT:-35}" mesh-light 2>/dev/null)" || true
light_verdict="$(_light_map "$light_out")"

# Cam flat-field reclassification — needs the light axis, so it runs HERE, not in the cam block:
# a fresh-but-flat frame in a room the light sense reads as dark is cam-DARK (expected, camera
# alive), not cam-BLIND (fault). See _cam_reclass for the full rationale.
if [ "$(_cam_reclass "$cam_degraded" "$cam_flat_fresh" "$light_verdict")" = DARK ]; then
  cam_degraded=0; cam_dark=1
fi

# --- Ambient clock (neighbor TV / fixed appliance context) ---
# Optional corroborator for loud-mic reads: ACTIVE/MODERATE suggests the room audio may be external
# appliance activity rather than occupancy. This is an honest disambiguator only; a missing/stale
# ambient-clock never blocks the sense.
ambient_clock="UNKNOWN"
ac_raw="$(_read_state "$AMBIENT_CLOCK_STATE" "$AMBIENT_CLOCK_STALE")"
[ -n "$ac_raw" ] && ambient_clock="$ac_raw"

# --- Screen state (backlight-bearing displays only) ---
# OFF is a real vacancy corroborator; ON/DIM/BRIGHT are cautionary only.
#
# ABSENT vs UNREADABLE (2026-07-15): mesh-screen-state reads /sys/class/backlight — a LAPTOP organ.
# This axis was written on the IdeaPad and never revisited when the minds migrated to mesh-home, a
# desktop with an HDMI monitor and no backlight sysfs, where the tool exits 2 on every call. The old
# code discarded that rc with `|| true` and collapsed BOTH outcomes into a bare UNKNOWN, so "this node
# has no such organ" and "this node's screen read failed" became the same claim — and the node's own
# absence was reported back as its perception being DEGRADED, permanently, since the migration.
# Keep the two apart: rc=2 (or the tool missing) = no organ → screen_absent=1, not a degradation;
# rc=0 with no parseable verdict = the organ is there and broke → UNKNOWN and honestly degraded.
# NOTE (do not "fix" by substituting DRM dpms here): measured on mesh-home 2026-07-15, dpms is
# root-read-only and pinned "On" with consoleblank=0 under a bare tty — a CONSTANT, so keying the
# axis on it would fabricate an always-on screen that can never corroborate vacancy.
screen_state="UNKNOWN"
screen_absent=1
if command -v mesh-screen-state >/dev/null 2>&1; then
  screen_out="$(timeout 5 mesh-screen-state 2>&1)"; screen_rc=$?
  if [ "$screen_rc" != 2 ]; then
    screen_absent=0
    screen_state="$(printf '%s' "$screen_out" | grep -oE '\b(OFF|DIM|NORMAL|BRIGHT)\b' | head -1)"
    [ -n "$screen_state" ] || screen_state="UNKNOWN"
  fi
fi

# --- Body motion (phone) — strongest occupancy signal ---
# COVERAGE FIX (sense-enrichment 2026-07-09): mesh-body-motion emits SIX tags
# ([body-walking]/[body-carried]/[body-handled]/[body-vehicle]/[body-covered]/[body-still]), but
# this mapping only recognised four of them — [body-walking] (active locomotion, step_delta>0 +
# linaccel>1.0 — the single STRONGEST occupancy signal body-motion can produce) and [body-vehicle]
# silently fell through to body_verdict="UNKNOWN", i.e. "no signal". A body that is literally being
# WALKED right now contributed NOTHING to a sense whose own comment calls it the "strongest
# occupancy signal" — worse, _fuse_verdict's EMPTY branches only exclude CARRIED/HANDLED, so a
# WALKING body (no signal ⟹ falls through as UNKNOWN, which does NOT block EMPTY) could still
# verdict EMPTY while someone was actively walking around with the phone. WALKING now maps through
# and is treated identically to CARRIED/HANDLED below (same "phone actively moving with a person"
# category, arguably stronger). VEHICLE is mapped too (for accurate signals=/degraded= reporting)
# but deliberately kept OUT of the PRESENT-driving/EMPTY-excluding set: a body in a vehicle most
# often means the person left the monitored space, so treating it as neutral (same as today's
# UNKNOWN) is the honest-degrade call, not a fabricated PRESENT or EMPTY.
body_verdict="UNKNOWN"
if [ "$phone_ok" = 1 ]; then
  body_out="$(timeout 14 mesh-body-motion 2>/dev/null)" || true
  if printf '%s' "$body_out" | grep -q '\[body-walking\]'; then
    body_verdict="WALKING"
  elif printf '%s' "$body_out" | grep -q '\[body-carried\]'; then
    body_verdict="CARRIED"
  elif printf '%s' "$body_out" | grep -q '\[body-handled\]'; then
    body_verdict="HANDLED"
  elif printf '%s' "$body_out" | grep -q '\[body-vehicle\]'; then
    body_verdict="VEHICLE"
  elif printf '%s' "$body_out" | grep -q '\[body-covered\]'; then
    body_verdict="COVERED"
  elif printf '%s' "$body_out" | grep -q '\[body-still\]'; then
    body_verdict="STILL"
  fi
fi

# --- Tamper recency (phone disturbance history) — human activity signal ---
# Tamper recency indicates whether the phone was recently physically disturbed.
# ACTIVE/RECENT = recent human activity (strong occupancy signal even if phone now offline).
# COLD/NEVER/OFFLINE = neutral (no recent activity OR cannot assess).
TAMPER_STATE="$MESH_DIR/.tamper-state"
# 2.5× the 10-min tamper cadence — a healthy reflex refreshes .tamper-state well within this; beyond it
# a stored ACTIVE/RECENT is a FROZEN positive (reflex stalled / phone offline) and must NOT drive a
# hollow PRESENT. Overridable for testability.
TAMPER_STALE_S="${MESH_TAMPER_STALE_S:-1500}"
tamper_recency="OFFLINE"
if [ -f "$TAMPER_STATE" ]; then
  tamper_line="$(head -1 "$TAMPER_STATE" 2>/dev/null)"
  tamper_recency="$(printf '%s' "$tamper_line" | cut -d'|' -f4)"
  # Normalize: if empty or malformed, treat as OFFLINE (phone unreachable)
  [ -n "$tamper_recency" ] || tamper_recency="OFFLINE"
  # Freshness gate (honest-degrade): the recency label was computed at write time; a stale state epoch
  # (field 2) means the reflex stopped writing, so a frozen ACTIVE/RECENT would fake occupancy. Recompute
  # against NOW — degrade a hollow positive to STALE (which _fuse_verdict treats as neutral, non-driving).
  tamper_epoch="$(printf '%s' "$tamper_line" | cut -d'|' -f2)"
  tamper_recency="$(gate_tamper_recency "$tamper_recency" "$tamper_epoch" "$(date +%s)" "$TAMPER_STALE_S")"
fi

# --- Self-playback (is THIS node emitting sound right now, and is it OUR OWN doing?) — mic-
# contamination gate, fused from TWO senses ---
# mesh-audio-active reads /proc/asound (kernel ALSA substream state, no session bus, no root) AND
# subtracts the mesh's own audio efference copy (mesh-speaking flag / a live player process) to
# classify the source as self (reafference) vs external (exafference) — see mesh-audio-active's
# `source=` field. PLAYING_SELF = own speakers active from the mesh's OWN output (nightly room-music
# grind etc.) → the mic axis is hearing the node itself, so "sound proves occupancy" is discounted in
# fusion below. PLAYING_EXTERNAL = an outside stream (a person's video/call) → real activity, NOT
# discounted. Honest degradation: tool absent or exit 2 (no sound card) → UNKNOWN, which cannot
# discount anything. A bare PLAYING with no parseable source= (older mesh-audio-active without the
# efference-copy field) falls back to the conservative PLAYING_SELF reading — the pre-existing
# behavior. MESH_ROOM_AUDIO_SELF overrides for live debugging (accepts PLAYING_SELF/PLAYING_EXTERNAL/
# SILENT/UNKNOWN).
audio_self="${MESH_ROOM_AUDIO_SELF:-UNKNOWN}"
if [ "$audio_self" = "UNKNOWN" ] && command -v mesh-audio-active >/dev/null 2>&1; then
  if _aa_out="$(mesh-audio-active 2>/dev/null)"; then
    case "$_aa_out" in
      *'source=self'*)     audio_self="PLAYING_SELF" ;;
      *'source=external'*) audio_self="PLAYING_EXTERNAL" ;;
      *PLAYING*)            audio_self="PLAYING_SELF" ;;
      *SILENT*)             audio_self="SILENT" ;;
    esac
  fi
fi

# --- Fusion ---
_fuse_verdict "$body_verdict" "$ble_verdict" "$ble_reason" "$wifi_verdict" "$light_verdict" "$phone_ok" "$ble_ok" "$ambient_level" "$kbd_verdict" "$cam_verdict" "$ambient_clock" "$presence_familiarity" "$presence_session_max_s" "$screen_state" "$tamper_recency" "$audio_self" && ec=0 || ec=$?
if [ "$ec" = 2 ]; then
  occupancy="UNKNOWN"
  confidence="low"
  room_mode="OFFLINE"
  degraded="phone-unreachable,ble-unavailable"
  reason="phone unreachable AND BLE scan failed — cannot assess"
  signals="phone_ok=0 ble_ok=0"
  status="$(room_status 2 "$occupancy" "$degraded")"
  if [ ! -f "$OFFLINEFILE" ]; then echo "mesh-room-sense: phone unreachable AND BLE scan failed — cannot assess" >&2; touch "$OFFLINEFILE"; fi
  # mtime-touch (shared primitive, NOT a bare touch) — the exit-2 / "cannot assess" path IS a successful
  # cron eval (the watch ran, both phone and BLE are down) — stamp the liveness so the dashboard
  # sees a recent mtime + an explicit OFFLINE marker, never a faked "PRESENT". (Same fix as
  # mesh-cooscillate:613, mesh-correlate:441, mesh-ideate:374, mesh-rhythm:282 — applied here
  # for the same reason — 2026-06-28 audit of fire-on-event / unreachable tools.)
  printf 'OFFLINE|%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  case "$MODE" in
    json)
      printf '{"verdict":"%s","status":"%s","occupancy":"%s","confidence":"%s","room_mode":"%s","degraded":"%s","signals":%s,"reason":%s,"ts":"%s","phone_ok":%s,"ble_ok":%s,"body":"%s","ambient":"%s","kbd":"%s","presence_familiarity":"%s","presence_session_max_s":%s,"tamper_recency":"%s"}\n' \
        "$verdict" "$status" "$occupancy" "$confidence" "$room_mode" "$degraded" \
        "$(printf '%s' "$signals" | json_escape)" "$(printf '%s' "$reason" | json_escape)" "$TS" "$phone_ok" "$ble_ok" "$body_verdict" "$ambient_level" "$kbd_verdict" \
        "$presence_familiarity" "$presence_session_max_s" "$tamper_recency"
      ;;
    *)
      printf 'room-sense: %s status=%s occupancy=%s confidence=%s room_mode=%s degraded=%s — %s [%s; presence=%s/%ss]\n' \
        "$verdict" "$status" "$occupancy" "$confidence" "$room_mode" "$degraded" "$reason" "$signals" "$presence_familiarity" "$presence_session_max_s"
      ;;
  esac
  exit 2
fi
_derive_occupancy "$verdict" "$body_verdict" "$ble_verdict" "$wifi_verdict" "$light_verdict" "$phone_ok" "$ble_ok" "$ambient_level" "$kbd_verdict" "$cam_verdict" "$ambient_clock" "$presence_familiarity" "$presence_session_max_s" "$screen_state"
status="$(room_status 0 "$occupancy" "$degraded")"

# Misha-gate sidecar (operator 2026-06-24): record whether occupancy is CONFIRMED (PRESENT+high — by
# fusion reachable ONLY via non-audio signals) so sibling reflexes (mesh-room-activity --edge) can defer
# to this authority without re-running the whole fusion. Written EVERY run (data-pane current).
case "$verdict:$confidence" in
  PRESENT:high) echo confirmed > "$MESH_DIR/.room-sense.occ" 2>/dev/null ;;
  *)            echo unconfirmed > "$MESH_DIR/.room-sense.occ" 2>/dev/null ;;
esac

case "$MODE" in
  json)
    # OCCUPANCY_DWELL: compute dwell_s + changes_24h on demand for the JSON output (the --edge
    # path has already maintained the events log; --json doesn't touch STATE, so we recompute here
    # for parity with the consumer-facing output).
    _now="$(date +%s)"
    _last_change_ts=""; [ -f "$EVENTS" ] && _last_change_ts="$(tail -n 1 "$EVENTS" 2>/dev/null | cut -d'|' -f1)"
    _dwell_s=0; _dwell_cov=na
    if [ -n "$_last_change_ts" ] && [ "$_last_change_ts" -gt 0 ] 2>/dev/null; then
      _do="$(dwell_observed "$ROOM_TAPE" "$_last_change_ts" "$_now")"
      _dwell_s="${_do%%|*}"; _dwell_cov="${_do##*|}"
    fi
    _changes_24h="$(count_recent_events "$EVENTS" "$_now" 86400)"
    printf '{"verdict":"%s","status":"%s","occupancy":"%s","confidence":"%s","room_mode":"%s","degraded":"%s","signals":%s,"reason":%s,"ts":"%s","phone_ok":%s,"ble_ok":%s,"body":"%s","ambient":"%s","kbd":"%s","presence_familiarity":"%s","presence_session_max_s":%s,"tamper_recency":"%s","dwell_s":%d,"dwell_band":"%s","dwell_cov":"%s","changes_24h":%d}\n' \
      "$verdict" "$status" "$occupancy" "$confidence" "$room_mode" "$degraded" "$(printf '%s' "$signals" | json_escape)" "$(printf '%s' "$reason" | json_escape)" "$TS" "$phone_ok" "$ble_ok" "$body_verdict" "$ambient_level" "$kbd_verdict" \
      "$presence_familiarity" "$presence_session_max_s" "$tamper_recency" \
      "$_dwell_s" "${_dwell_s:+$(classify_dwell "$_dwell_s" | cut -d'|' -f1)}" "$_dwell_cov" \
      "$_changes_24h"
    ;;
  edge)
    # OBSERVATION TAPE first, unconditionally: this line is written for EVERY cron evaluation,
    # before any debounce/edge/confidence gating below can drop it. The wake-signal printf further
    # down fires on ~3% of runs (PRESENT+high only) and was the sense's ONLY durable record — a tape
    # selected on the confidence value it records (see the block at tape_room_eval).
    tape_room_eval "$TS" "$verdict" "$confidence" "$status" "$occupancy" "$degraded" "$signals"
    # 2-consecutive-scan debounce: a threshold-straddling sensor can flip PRESENT↔UNCERTAIN
    # every scan. Only fire after 2 consecutive same verdicts.
    # STATE = confirmed verdict (additive 4-field: VERDICT|dwell_s=N|changes_24h=N|dwell_cov=N|na);
    # PENDING = "verdict:count" for the in-progress candidate. dwell_s is the OBSERVED dwell (see
    # dwell_observed) and dwell_cov the percent of the wall-clock window this sense actually watched.
    PENDING="${STATE%.state}.pending"
    confirmed_raw="$(cat "$STATE" 2>/dev/null || true)"
    # Extract just the bare label (1st field) for back-compat with the legacy 1-field STATE
    confirmed="${confirmed_raw%%|*}"
    pending_line="$(cat "$PENDING" 2>/dev/null || true)"
    pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

    if [ -z "$confirmed" ]; then
      # First run: seed silently — write the bare label only (additive fields populated below)
      printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
      # SEED: log this as the first event so dwell_s has a real start (mirrors mesh-ambient-clock
      # dwell enrichment: a present-but-uncounted history is a worse signal than a known-fresh baseline)
      log_room_event "$EVENTS" "$(date +%s)" "$verdict" "$(date +%s)"
    elif [ "$verdict" = "$confirmed" ]; then
      rm -f "$PENDING"   # stable — clear any in-progress candidate
    elif [ "$verdict" = "$pending" ]; then
      pcount=$((pcount + 1))
      if [ "$pcount" -ge 2 ]; then
        # Two consecutive readings agree — genuine change
        printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
        # Log the event so dwell_s starts counting from now
        log_room_event "$EVENTS" "$(date +%s)" "$verdict" "$(date +%s)"
        # WAKE SIGNAL (actuator trigger) — gated by wake_emit_ok: only a CONFIRMED occupancy edge
        # fires it, so a room change never wakes Misha off ambient sound/music. STATE still updates
        # (data panes read it) and the observation tape above records EVERY evaluation regardless;
        # only the reactive wake signal is gated. MISHA_CONFIRMED_ONLY=0 opts out (legacy behavior).
        if wake_emit_ok "$verdict" "$confidence"; then
          # $TS prefix: the edge log is consulted forensically ("when did PRESENT fire?") — without a
          # timestamp the emit time is only guessable from neighbours (bit twice, 2026-07-02).
          printf '%s [room-sense] %s status=%s occupancy=%s confidence=%s room_mode=%s degraded=%s — %s (%s; presence=%s/%ss)\n' "$TS" "$verdict" "$status" "$occupancy" "$confidence" "$room_mode" "$degraded" "$reason" "$signals" "$presence_familiarity" "$presence_session_max_s"
        fi
      else
        printf '%s:%d\n' "$verdict" "$pcount" > "$PENDING"
      fi
    else
      # New candidate — start fresh pending (count=1)
      printf '%s:1\n' "$verdict" > "$PENDING"
    fi
    # OCCUPANCY_DWELL: append dwell_s + changes_24h to STATE on every successful run (additive
    # 3-field format — back-compat: head -1 | cut -d'|' -f1 still recovers the bare label).
    # Bare 'touch' on a non-existent STATE would create a hollow state file (consumers would read it
    # as real) — so we ONLY touch an existing STATE.
    _now="$(date +%s)"
    _last_change_ts=""; [ -f "$EVENTS" ] && _last_change_ts="$(tail -n 1 "$EVENTS" 2>/dev/null | cut -d'|' -f1)"
    _dwell_s=0; _dwell_cov=na
    if [ -n "$_last_change_ts" ] && [ "$_last_change_ts" -gt 0 ] 2>/dev/null; then
      _do="$(dwell_observed "$ROOM_TAPE" "$_last_change_ts" "$_now")"
      _dwell_s="${_do%%|*}"; _dwell_cov="${_do##*|}"
    fi
    _changes_24h="$(count_recent_events "$EVENTS" "$_now" 86400)"
    if [ -e "$STATE" ]; then
      # Re-read the just-written 1st field (might be new) and append the dwell fields
      _cur_label="$(head -1 "$STATE" 2>/dev/null | cut -d'|' -f1)"
      [ -n "$_cur_label" ] && printf '%s|dwell_s=%s|changes_24h=%s|dwell_cov=%s\n' "$_cur_label" "$_dwell_s" "$_changes_24h" "$_dwell_cov" > "$STATE"
      # touch every run so the state-file mtime tracks last-RUN (liveness), not last-CHANGE —
      # else a stable verdict reads as a dead reflex to the sensorium roll-call's age/STALE check.
      # Use the shared liveness primitive (chat-review/state-touch-adoption 2026-06-25) — bare
      # `touch "$STATE"` was a fallback when mesh-state-touch was missing; the primitive is now
      # the canonical path (handles --create, mirrors mesh-psi / mesh-net-drop / mesh-wifi-crossval
      # / mesh-vpn-health hollow-sense fixes).
      [ -x "$HOME/.local/bin/mesh-state-touch" ] && "$HOME/.local/bin/mesh-state-touch" --create "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null
    else
      printf '%s|dwell_s=%s|changes_24h=%s|dwell_cov=%s\n' "$verdict" "$_dwell_s" "$_changes_24h" "$_dwell_cov" > "$STATE"
    fi
    ;;
  *)
    printf 'room-sense: %s status=%s occupancy=%s confidence=%s room_mode=%s degraded=%s — %s [%s; presence=%s/%ss]\n' "$verdict" "$status" "$occupancy" "$confidence" "$room_mode" "$degraded" "$reason" "$signals" "$presence_familiarity" "$presence_session_max_s"
    ;;
esac
