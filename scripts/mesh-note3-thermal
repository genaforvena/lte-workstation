#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-note3-thermal — the Note3's OWN battery/charger thermal probes
# (/sys/class/sensors/temphumidity_sensor/{batt_temperature,chg_temperature}, tenths-of-°C) as a
# COOL/NORMAL/WARM/HOT hysteresis edge for its fixed craft-room location, via the SAME adb->ds
# relay mesh-baro/mesh-note3-motion/mesh-note3-mag/mesh-note3-prox/mesh-note3-desk already use.
#
# WHY THIS IS NEW: mesh-baro's header already documents that the SHTC1 ambient_temperature /
# relative_humidity Android sensor HAL entries on this sysfs class are dead (dumpsys cached
# last=<0.0,...>, no listener ever registered — same "0 clients" trap mesh-note3-mag hit before
# it switched to the dumpsys-cache path). But `temphumidity_sensor`'s OTHER attribute files —
# batt_temperature / chg_temperature — are direct sysfs reads with NO listener requirement,
# verified LIVE 2026-07-10 (batt=280 -> 28.0C, chg=380 -> 38.0C, stable across repeated cat).
# Nothing on the mesh reads them: mesh-body-thermal is Redmi-only (termux-battery-status), and no
# note3-* tool touches this path. Thermal is a modality none of mag/prox/motion/desk give for the
# Note3 body — a rising batt/chg gap or an unexplained batt-temp climb on an otherwise-stationary
# shelf device is a heat/fault signal no other Note3 sense would catch.
#
# Honest contract: sysfs values are raw driver reads, always populated once the kernel node
# exists (unlike the dead ambient_temperature/humidity HAL entries) — but adb/ssh unreachable OR
# the value unparsable -> UNREACHABLE, exit 2, never a faked reading. classify_thermal() reuses
# mesh-body-thermal's exact hysteresis thresholds/vocab (COOL/NORMAL/WARM/HOT) so this stays on
# the same cross-sense vocabulary as the Redmi body's thermal sense.
#
#   mesh-note3-thermal            one-shot verdict (INIT|COOL|NORMAL|WARM|HOT) + batt/chg °C
#   mesh-note3-thermal --json     machine-readable
#   mesh-note3-thermal --edge     debounced state write; board post ONLY on a level transition
#   mesh-note3-thermal --test     fixture-driven classifier smoke test + live adb read-gate
#
# Exit: 0 = assessed (INIT/COOL/NORMAL/WARM/HOT) · 2 = adb body unreachable (honest n/a, never faked)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.note3-thermal-state"          # "verdict|batt_c|chg_c|ts"
EDGE_STATE="$MESH/.note3-thermal-edge"      # last POSTED verdict (for --edge dedup)

# Same fixed adb->ds relay every other Note3 sense uses; falls back to the baro node vars so
# a single ~/.mesh/nodes entry covers every Note3-body sense.
NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"

# classify_thermal <temp_c> <prev_level> -> COOL|NORMAL|WARM|HOT (pure, offline-testable).
# Identical thresholds/hysteresis to mesh-body-thermal — same cross-sense vocab, different body.
classify_thermal() {
  local t="$1" p="$2"
  case "$p" in
    COOL)   awk -v t="$t" 'BEGIN{exit !(t>30)}' && { echo NORMAL; return; }; echo COOL;;
    NORMAL) awk -v t="$t" 'BEGIN{exit !(t<26)}' && { echo COOL;   return; }
            awk -v t="$t" 'BEGIN{exit !(t>34)}' && { echo WARM;   return; }; echo NORMAL;;
    WARM)   awk -v t="$t" 'BEGIN{exit !(t<32)}' && { echo NORMAL; return; }
            awk -v t="$t" 'BEGIN{exit !(t>38)}' && { echo HOT;    return; }; echo WARM;;
    HOT)    awk -v t="$t" 'BEGIN{exit !(t<36)}' && { echo WARM;   return; }; echo HOT;;
    *)      if   awk -v t="$t" 'BEGIN{exit !(t<28)}';  then echo COOL
            elif awk -v t="$t" 'BEGIN{exit !(t<=33)}'; then echo NORMAL
            elif awk -v t="$t" 'BEGIN{exit !(t<=37)}'; then echo WARM
            else echo HOT; fi;;
  esac
}

# note3_thermal_raw — live "batt_c chg_c" from the two sysfs tenths-of-degree files in ONE adb
# shell call. Empty + rc1 on any failure (adb down, ssh down, no digits). Test override:
# NOTE3_THERMAL_RAW_OVERRIDE="batt chg" (tenths, e.g. "280 380") skips the network entirely.
note3_thermal_raw() {
  local out
  if [ -n "${NOTE3_THERMAL_RAW_OVERRIDE:-}" ]; then
    out="$NOTE3_THERMAL_RAW_OVERRIDE"
  else
    [ -z "$NOTE3_ADB_NODE" ] && return 1
    local ser=""; [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
    local cmd="cat /sys/class/sensors/temphumidity_sensor/batt_temperature /sys/class/sensors/temphumidity_sensor/chg_temperature"
    if [ "$NOTE3_ADB_NODE" = local ]; then
      out="$(timeout 15 adb $ser shell "$cmd" 2>/dev/null | tr -d '\r' | tr '\n' ' ')"
    else
      out="$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        "$NOTE3_ADB_NODE" "adb $ser shell '$cmd'" </dev/null 2>/dev/null | tr -d '\r' | tr '\n' ' ')"
    fi
  fi
  read -r b c <<<"$out"
  case "$b" in ''|*[!0-9]*) return 1;; esac
  case "$c" in ''|*[!0-9]*) return 1;; esac
  printf '%s %s' "$b" "$c"
}

# is_relay_run <arg1> <adb_node> -> rc0 when this is a SCHEDULED --edge poll on a RELAY node
# (adb_node is a non-empty remote host, i.e. NOT "local"). A relay reaches the SAME physical Note3
# by SSH-ing to the direct-adb owner, so its cron poll is pure redundancy — a double board post +
# divergence from racing the same on-change HAL cache — with zero added resilience (the relay read
# already fails whenever the owner is down). The direct-adb owner (adb_node="local") is the sole
# scheduled poster; on-demand reads (no-arg/--json) stay available from any node. Pure — testable.
is_relay_run() { [ "$1" = --edge ] && [ -n "$2" ] && [ "$2" != local ]; }

# ─── --test: fixture-driven classifier + live adb read-gate ────────────────
if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  _f=0
  # Snap (first-run, no hysteresis) — mirrors mesh-body-thermal's fixture set exactly.
  [ "$(classify_thermal 20 UNKNOWN)" = COOL   ] || { echo "  FAIL: 20C snap -> COOL"; _f=1; }
  [ "$(classify_thermal 28 UNKNOWN)" = NORMAL ] || { echo "  FAIL: 28C snap -> NORMAL"; _f=1; }
  [ "$(classify_thermal 34 UNKNOWN)" = WARM   ] || { echo "  FAIL: 34C snap -> WARM"; _f=1; }
  [ "$(classify_thermal 38 UNKNOWN)" = HOT    ] || { echo "  FAIL: 38C snap -> HOT"; _f=1; }
  # Hysteresis dead-bands
  [ "$(classify_thermal 30 COOL)" = COOL   ] || { echo "  FAIL: 30C COOL stays COOL"; _f=1; }
  [ "$(classify_thermal 31 COOL)" = NORMAL ] || { echo "  FAIL: 31C COOL -> NORMAL"; _f=1; }
  [ "$(classify_thermal 25 NORMAL)" = COOL ] || { echo "  FAIL: 25C NORMAL -> COOL"; _f=1; }
  [ "$(classify_thermal 35 NORMAL)" = WARM ] || { echo "  FAIL: 35C NORMAL -> WARM"; _f=1; }
  [ "$(classify_thermal 31 WARM)" = NORMAL ] || { echo "  FAIL: 31C WARM -> NORMAL"; _f=1; }
  [ "$(classify_thermal 39 WARM)" = HOT    ] || { echo "  FAIL: 39C WARM -> HOT"; _f=1; }
  [ "$(classify_thermal 36 HOT)" = HOT ] || { echo "  FAIL: 36C HOT stays HOT"; _f=1; }
  [ "$(classify_thermal 35 HOT)" = WARM ] || { echo "  FAIL: 35C HOT -> WARM"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_thermal hysteresis)"; exit 1; }

  # parse gate: malformed raw must be rejected, well-formed accepted, tenths passed through raw
  NOTE3_THERMAL_RAW_OVERRIDE="not a number" note3_thermal_raw >/dev/null 2>&1 && { echo "  FAIL: malformed raw must be rejected"; _f=1; }
  NOTE3_THERMAL_RAW_OVERRIDE="280 380" note3_thermal_raw >/dev/null 2>&1 || { echo "  FAIL: well-formed raw must be accepted"; _f=1; }
  [ "$(NOTE3_THERMAL_RAW_OVERRIDE='280 380' note3_thermal_raw)" = "280 380" ] || { echo "  FAIL: raw passthrough mismatch"; _f=1; }

  # ── relay-node gate (is_relay_run): scheduled --edge on a RELAY skips; owner + on-demand don't ──
  is_relay_run --edge imozerov@100.125.157.75 || { echo "  FAIL: --edge on a relay node must skip"; _f=1; }
  is_relay_run --edge local                    && { echo "  FAIL: --edge on the direct-adb owner must NOT skip"; _f=1; }
  is_relay_run --edge ''                        && { echo "  FAIL: --edge with no adb node must NOT skip (n/a path handles it)"; _f=1; }
  is_relay_run --json imozerov@100.125.157.75  && { echo "  FAIL: on-demand --json from a relay must NOT skip"; _f=1; }
  is_relay_run '' imozerov@100.125.157.75      && { echo "  FAIL: on-demand no-arg from a relay must NOT skip"; _f=1; }
  # integration: a real relay --edge run must write NOTHING to the board (falsify by reverting the gate)
  _rsd="$(mktemp -d)"; _rboard="$_rsd/chat.log"; : > "$_rboard"
  MESH_DIR="$_rsd" MESH_SKIP_NODES_SOURCE=1 MESH_NOTE3_THERMAL_BOARD="$_rboard" \
    MESH_NOTE3_ADB_NODE='relay@203.0.113.9' MESH_BARO_ADB_NODE='' "$0" --edge >/dev/null 2>&1
  [ -s "$_rboard" ] && { echo "  FAIL: relay --edge wrote to the board (should skip): $(cat "$_rboard")"; _f=1; }
  rm -rf "$_rsd" 2>/dev/null || true

  # ── live adb read-gate (mesh-land treats exit 2 = honest n/a as a pass) ──
  if [ -z "$NOTE3_ADB_NODE" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (MESH_NOTE3_ADB_NODE/MESH_BARO_ADB_NODE unset — Note3 body not configured on this node)"
    exit 2
  fi
  _live="$(note3_thermal_raw)"
  if [ -z "$_live" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (adb body unreachable — Note3 thermal sense unavailable)"
    exit 2
  fi
  read -r _lb _lc <<<"$_live"
  case "$_lb$_lc" in *[!0-9]*|'') echo "  FAIL: live raw not plain digit pairs: '$_live'"; _f=1;; esac
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify/parse/live-read contract violated)"; exit 1; }
  echo "smoke-test: ok (12 classifier + parse-gate + 5 relay-gate unit + 1 board-skip integration + LIVE adb read batt=${_lb} chg=${_lc})"
  exit 0
fi

# ─── relay-node gate: only the direct-adb owner runs the scheduled --edge poll (see is_relay_run) ─
if is_relay_run "${1:-}" "$NOTE3_ADB_NODE"; then
  echo "note3-thermal: relay-skip (adb owner=$NOTE3_ADB_NODE; scheduled poll deferred to the direct-adb owner — no double board post)"
  exit 0
fi

# ─── live read ───────────────────────────────────────────────────────────
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
raw="$(note3_thermal_raw)"
if [ -z "$raw" ]; then
  echo "note3-thermal: UNREACHABLE (adb body offline/unreadable/sysfs absent)" >&2
  [ "${1:-}" = --json ] && printf '{"verdict":"UNREACHABLE"}\n'
  exit 2
fi
read -r batt_t chg_t <<<"$raw"
batt_c="$(awk -v v="$batt_t" 'BEGIN{printf "%.1f", v/10}')"
chg_c="$(awk -v v="$chg_t" 'BEGIN{printf "%.1f", v/10}')"

verdict_init=1
prev_level=UNKNOWN
if [ -f "$STATE" ]; then
  verdict_init=0
  IFS='|' read -r prev_level _ _ _ < "$STATE"
fi
verdict="$(classify_thermal "$batt_c" "$prev_level")"
[ "$verdict_init" = 1 ] && verdict=INIT

printf '%s|%s|%s|%s\n' "$verdict" "$batt_c" "$chg_c" "$ts" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # ran-live liveness, independent of value-changed

case "${1:-}" in
  --json)
    printf '{"verdict":"%s","batt_c":%s,"chg_c":%s,"ts":"%s"}\n' "$verdict" "$batt_c" "$chg_c" "$ts"
    ;;
  --edge)
    prev_posted=""
    [ -f "$EDGE_STATE" ] && prev_posted="$(cat "$EDGE_STATE" 2>/dev/null)"
    if [ "$verdict" != "$prev_posted" ] && [ "$verdict" != INIT ]; then
      board="${MESH_NOTE3_THERMAL_BOARD:-$MESH/chat.log}"
      ts_board="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      printf '%s  note3-thermal@%s  ::  [note3-thermal] %s (batt=%s°C chg=%s°C)\n' "$ts_board" "$(hostname)" "$verdict" "$batt_c" "$chg_c" >> "$board" 2>/dev/null || true
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    elif [ "$verdict" = INIT ]; then
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    fi
    printf 'note3-thermal: %s (batt=%s°C chg=%s°C)\n' "$verdict" "$batt_c" "$chg_c"
    ;;
  *)
    printf 'note3-thermal: %s (batt=%s°C chg=%s°C)\n' "$verdict" "$batt_c" "$chg_c"
    ;;
esac
exit 0
