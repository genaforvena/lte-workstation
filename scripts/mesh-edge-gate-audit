#!/usr/bin/env bash
# reflex-cadence: 41 5 * * *
# mesh-edge-gate-audit — drive every `--edge` reflex in the genome and prove the gate can BOTH fire
# and hold. Source text is never behaviour; this asserts the artifact.
#
# WHY THIS EXISTS. `--edge` reflexes are the mesh's change-triggered senses: cron runs them every few
# minutes and they print only when their verdict MOVES. That makes silence their normal output — and
# therefore makes a broken gate INVISIBLE. Five of them were structurally mute for 33 days (~9,500 cron
# invocations each, zero lines) and nothing noticed, because a dead edge gate and a genuinely steady
# world produce byte-identical logs. The mechanism was one ordering mistake, repeated by copy:
#
#     printf '%s|...' "$label" ... > "$STATE"     # unconditional write
#     ...
#     --edge)  prev="$(head -1 "$STATE" | cut -d'|' -f1)"   # reads back what it JUST wrote
#              [ "$prev" = "$label" ] && exit 0             # therefore ALWAYS exits 0
#
# TWO DIRECTIONS, because a gate fails both ways. A gate that never fires is a dead sense; a gate that
# always fires is a log flood that trains every reader to ignore it. So each tool is driven twice:
#   FIRE — seed a label that differs from the live one; --edge MUST emit >0 bytes.
#   HOLD — seed the tool's own current state line; --edge MUST emit 0 bytes.
# Passing only the FIRE leg would greenlight `prev=""`, which is how the first attempt at this very fix
# went wrong.
#
# FOUR TRAPS, each one paid for during the sweep that found the bug:
#
#   1. A ONE-SHOT PROBE LIES. mesh-light probed DEAD once and LIVE on all three retries — its source is
#      a beacon whose freshness window can lapse between the control run and the edge run. Every verdict
#      here is the consensus of $REPEAT runs; a tool that disagrees with itself renders FLAKY, never
#      DEAD. A single red run is a lead, not a verdict.
#   2. THE PREV FILE IS NOT ALWAYS THE STATE FILE. mesh-rtc-drift keeps prev in `$STATE.prev` and
#      mesh-mem-guard in a separate episode flag, so seeding `$STATE` moves nothing and both probe DEAD
#      while being perfectly alive. The state file is discovered by MTIME — whatever the tool actually
#      wrote — never by parsing a `STATE=` line, and a tool that writes several gets each one seeded.
#   3. A MUTE CONTROL IS NOT A DEAD GATE. If the bare run prints nothing (organ unreachable, n/a on this
#      node) then --edge printing nothing proves nothing. That renders `inconclusive`, never DEAD — the
#      honest-n/a rule: an unreachable organ is not a failing one.
#   4. DRIVING A REFLEX HAS SIDE EFFECTS. Some `--edge` branches post to the board or actuate on the
#      transition — driving those to prove a gate would forge exactly the alarm a human reads. Any tool
#      whose edge path can reach mesh-chat/mesh-tell/mesh-say/mesh-act is SKIPPED by name and counted as
#      skipped, never silently folded into the pass column.
#
#   5. A NONZERO EDGE RUN IS NOT A MUTE GATE. Silence is the only evidence DEAD rests on, so the
#      audit must know WHY the run was silent. `mesh-phone-prox --edge` exits 2 and `mesh-powerbtn`
#      exits 1 — an organ that is away and a run that errored — and both were graded DEAD off the
#      byte count alone, which is the mute-control trap (3) one level down: the bare run printed, so
#      the control passed, and the EDGE run's own honest n/a was read as a broken gate. rc is now
#      carried beside the byte count and only a run that is silent AND exit 0 can support a DEAD.
#      Note the ordering: BYTES WIN. A tool that fires and exits nonzero has fired — its rc is not
#      allowed to overturn the evidence — so this leg can never hide a gate that works.
#   6. A DEAD YOU HAVE NOT SEEN REPRODUCE IS NOT A DEATH. Seeding prev cannot manufacture an edge in
#      a tool whose emission also requires a non-calm CURRENT band, so a single sweep's silence means
#      "the node was quiet at 02:05Z", not "the gate is broken" — and the verdict then sits on the
#      dash as a red X for a full day. Measured 2026-08-21: 8 of 12 gates graded DEAD fired on the
#      audit's own seed when re-probed 78 minutes later. So DEAD is now a TWO-RUN verdict: the first
#      silence renders DEAD-CANDIDATE (not an alarm, not a pass), and only a repeat whose earlier
#      sighting is at least CONFIRM_GAP old promotes it to DEAD. The repeats inside one run cannot
#      do this — they share the node's moment, which is the whole reason the verdict was wrong.
#
# THE AUDIT NEVER TOUCHES PRODUCTION. Every probe runs with HOME redirected at a sandbox holding a
# COPY of the state dotfiles, so the tools write their state and append their logs inside it and the
# real ~/.mesh is not mutated at all. The first design seeded the live state files and restored them
# afterwards, and that was wrong in a way restoring cannot fix: driving a reflex makes the reflex
# APPEND ITS OWN LINE to its durable log, so the audit's probe label landed in lan-jitter.log,
# mdns-census.log and bt-census.log — the audit forged entries in the very records it exists to check,
# and no restore of the state file undoes an append to a log. Sandboxing the whole HOME is the only
# version of this tool that is safe to run on a cadence.
#
# Verdicts: LIVE (fires and holds) · DEAD (cannot fire, and a run separated in time already saw it —
# the alarm, exit 1) · DEAD-CANDIDATE (silent once; neither alarm nor pass) · STUCK-OPEN (fires when it
# should hold) · FLAKY (disagrees with itself across repeats) · inconclusive (mute control / no state
# file found / the edge run itself exited n/a or errored) · SKIP (side-effecting edge path, or not an
# --edge tool).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# Absolute self-path. A bare `$0` re-invocation resolves against PATH, so a test run as
# `bash mesh-edge-gate-audit` from anywhere but the script's own directory dies rc=127 — a red that
# looks like a failing assertion and is really a failing lookup.
SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"

MESH="${MESH_DIR:-$HOME/.mesh}"
BIN="${MESH_EDGE_AUDIT_BIN:-$HOME/.local/bin}"
SRC="${MESH_EDGE_AUDIT_SRC:-$HOME/lte-workstation/scripts}"
LOG="${MESH_EDGE_AUDIT_LOG:-$MESH/edge-gate-audit.log}"
STATE="${MESH_EDGE_AUDIT_STATE:-$MESH/.edge-gate-audit-state}"
REPEAT="${MESH_EDGE_AUDIT_REPEAT:-3}"       # a one-shot probe lies; consensus of this many
TIMEOUT="${MESH_EDGE_AUDIT_TIMEOUT:-90}"    # per invocation
SEED_LABEL="${MESH_EDGE_AUDIT_SEED:-ZZ_EDGE_AUDIT_SEED}"
# A DEAD is only published once a run SEPARATED IN TIME has already seen it (trap 6). This is the
# minimum age of that earlier run; below it, "twice" is the same node-moment counted twice.
CONFIRM_GAP="${MESH_EDGE_AUDIT_CONFIRM_GAP:-3600}"

SANDBOX=""
cleanup(){ [ -n "$SANDBOX" ] && [ -d "$SANDBOX" ] && rm -rf "$SANDBOX"; }
trap cleanup EXIT INT TERM

# build_sandbox — a throwaway HOME whose .mesh holds a COPY of the state dotfiles (~1.6MB, 779 files
# here; the 11GB of logs are deliberately NOT copied). Tools resolve their paths from $HOME, so every
# write they make during a probe lands here and dies with the tempdir.
# A tool that needs a log it cannot find renders whatever it renders and the probe calls that
# inconclusive — coverage lost, and SAID SO, which is the honest trade against forging a log line.
build_sandbox(){
  SANDBOX="$(mktemp -d)" || return 1
  mkdir -p "$SANDBOX/.mesh" "$SANDBOX/.local" || return 1
  cp -a "$MESH"/.[!.]* "$SANDBOX/.mesh/" 2>/dev/null || true
  ln -s "$HOME/.local/bin" "$SANDBOX/.local/bin" 2>/dev/null || true
  return 0
}

# side_effecting <script> — does the --edge path reach something that talks to the mesh? Deliberately
# CONSERVATIVE and file-wide: a false SKIP costs coverage and says so, a false drive forges an alarm.
# The alternatives are WORD-ANCHORED. Unanchored, `mesh-act` matches inside `mesh-activity-tempo` —
# which is a doc-comment mention in half the fusion tools — and mesh-tempo-context was skipped on that
# alone, silently costing coverage while reading as a deliberate exclusion. A false SKIP is quiet.
side_effecting(){ grep -qE '\b(mesh-chat|mesh-tell|mesh-say|mesh-act|mesh-tg|notify-send)\b' "$1"; }

# edge_tools — every script that accepts --edge, named by basename, from the SOURCE tree (the genome is
# the roster; the deployed copy is what gets driven).
edge_tools(){
  local f
  for f in "$SRC"/mesh-*; do
    [ -f "$f" ] || continue
    grep -qE '"--edge"|= --edge|--edge\)' "$f" || continue
    printf '%s\n' "$(basename "$f")"
  done | sort -u
}

# snapshot_mtimes / changed_since — discover the state file BEHAVIOURALLY. Parsing `STATE=` gets the
# wrong file whenever prev lives somewhere else (trap 2), and gets nothing at all when the path is
# assembled from a variable.
snapshot_mtimes(){ find "$SANDBOX/.mesh" -maxdepth 1 -name '.*' -type f -printf '%T@ %p\n' 2>/dev/null | sort; }

# Every invocation runs against the sandbox HOME. MESH_DIR is cleared so a tool honouring it cannot
# reach around the redirect and back into production.
# NOTE the argument order: env parses its options BEFORE assignments, so `env HOME=x -u MESH_DIR cmd`
# treats `-u` as the program to run and every probe silently returns 0 bytes — which this tool would
# then have reported as a node full of mute organs. Options first.
run_tool(){ env -u MESH_DIR HOME="$SANDBOX" timeout "$TIMEOUT" "$BIN/$1" ${2:+"$2"} 2>/dev/null; }

# probe_once <tool> <state-file> → "fire_bytes fire_rc hold_bytes hold_rc"
# The rc is captured because silence alone cannot say WHY a run was silent (trap 5). Output goes to a
# file rather than through `| wc -c` for two reasons: a pipeline's `$?` is the LAST stage's (wc always
# succeeds, so the tool's rc would be unreachable), and a command substitution strips trailing
# newlines, which would quietly change the byte count the verdict rests on.
probe_once(){
  local t="$1" sf="$2" cur fire frc hold hrc o="$SANDBOX/.probe-out"
  cur="$(head -1 "$sf" 2>/dev/null)"
  # FIRE: a label that cannot equal the live one.
  printf '%s\n' "$SEED_LABEL" > "$sf"
  run_tool "$t" --edge > "$o"; frc=$?
  fire="$(wc -c < "$o")"
  # HOLD: the tool's own line, as it would have written it — a genuine non-edge.
  printf '%s\n' "$cur" > "$sf"
  run_tool "$t" --edge > "$o"; hrc=$?
  hold="$(wc -c < "$o")"
  printf '%s %s %s %s' "$fire" "$frc" "$hold" "$hrc"
}

# prior_sighting <tool> → prints "<age-seconds> <verdict>" for this tool in the PREVIOUS run's state
# file, or nothing. The previous run is the only witness that can separate "silent because the node
# was quiet at 02:05Z" from "silent because the gate is broken" — the repeats inside one run all share
# the same node-moment.
prior_sighting(){
  local t="$1" row pt now
  [ -n "$PRIOR_TS" ] || return 1
  row="$(printf '%s\n' "$PRIOR_ROWS" | awk -v t="$t" '$1==t {print $2; exit}')"
  [ -n "$row" ] || return 1
  pt="$(date -u -d "$PRIOR_TS" +%s 2>/dev/null)" || return 1
  [ -n "$pt" ] || return 1
  now="$(date -u +%s)"
  printf '%s %s' "$(( now - pt ))" "$row"
}

audit_tool(){ # → "<tool> <verdict> <detail>"
  local t="$1" src="$SRC/$t" pre post sf n fires="" frcs="" holds="" i
  [ -x "$BIN/$t" ] || { printf '%s SKIP not-deployed\n' "$t"; return 0; }
  if side_effecting "$src"; then
    printf '%s SKIP side-effecting-edge-path(not-counted-as-pass)\n' "$t"; return 0
  fi
  # CONTROL: a bare run must both PRINT and reveal its state file. A mute control makes the whole
  # probe unreadable (trap 3), so it renders inconclusive rather than DEAD.
  pre="$(snapshot_mtimes)"
  local bare; bare="$(run_tool "$t" | wc -c)"
  post="$(snapshot_mtimes)"
  [ "$bare" -gt 0 ] || { printf '%s inconclusive mute-control(bare=0B;organ-n/a-here)\n' "$t"; return 0; }
  # WHICH changed file is THIS tool's? On a live node other reflexes write during the same window, so
  # mtime alone loses a race: mesh-gravity's first audit picked `.voice-rx-state` — a file it never
  # touched — and reported DEAD off it. Narrow by NAME STEM (mesh-gravity → gravity) and, when that
  # cannot pick exactly one, render inconclusive-ambiguous. A verdict about the wrong file is worse
  # than no verdict: it is a fabricated alarm, and it names an innocent tool.
  local cands stem
  # Locks are excluded before anything else. NOT fixture-gated — the synthetic fixture could not be
  # made to reproduce the selection order, and a green assertion that cannot fail is worse than none;
  # this rule is verified against the live genome instead, where `.node-health-state.lock` and
  # `.ss-test.lock` matched
  # their tools' stems better than the real state files did, and seeding a flock file changes no
  # verdict at all — so both tools were reported DEAD off a file no gate has ever read.
  cands="$(comm -13 <(printf '%s\n' "$pre") <(printf '%s\n' "$post") | awk '{print $2}' | grep -v '\.lock$')"
  [ -n "$cands" ] || { printf '%s inconclusive no-state-file-written-by-a-bare-run\n' "$t"; return 0; }
  stem="${t#mesh-}"
  sf="$(printf '%s\n' "$cands" | grep -F "$stem" | head -1)"
  if [ -z "$sf" ]; then
    if [ "$(printf '%s\n' "$cands" | wc -l)" -eq 1 ]; then
      sf="$cands"     # exactly one writer in the window and no stem match — accept it, say so below
    else
      printf '%s inconclusive ambiguous-state-file(%s changed in the window, none matching stem "%s")\n' \
        "$t" "$(printf '%s\n' "$cands" | wc -l)" "$stem"; return 0
    fi
  fi
  [ -f "$sf" ] || { printf '%s inconclusive state-file-vanished\n' "$t"; return 0; }
  n="$(basename "$sf")"
  i=0
  while [ "$i" -lt "$REPEAT" ]; do
    local r fb frc hb hrc; r="$(probe_once "$t" "$sf")"
    read -r fb frc hb hrc <<< "$r"
    fires="$fires $fb"; frcs="$frcs $frc"; holds="$holds $hb"
    i=$(( i + 1 ))
  done
  # Consensus. Disagreement with itself is FLAKY — the mesh-light shape (trap 1) — never a verdict.
  # Each FIRE run lands in exactly one class, and BYTES WIN: a run that printed has fired, whatever
  # its rc, so an alarm-by-exit-code tool can never be demoted to n/a by this leg (trap 5).
  #   fired  — printed something: the gate works
  #   mute   — silent AND exit 0: the only shape that can support a DEAD
  #   na     — silent AND exit 2: organ away, which mesh-land itself treats as a pass
  #   err    — silent AND any other rc: the run failed; it says nothing about the gate
  local nf_pos=0 nf_mute=0 nf_na=0 nf_err=0 nh_pos=0 v c
  set -- $frcs
  for v in $fires; do
    c="$1"; shift
    if [ "$v" -gt 0 ]; then nf_pos=$(( nf_pos + 1 ))
    elif [ "$c" = 0 ];  then nf_mute=$(( nf_mute + 1 ))
    elif [ "$c" = 2 ];  then nf_na=$(( nf_na + 1 ))
    else                     nf_err=$(( nf_err + 1 ))
    fi
  done
  for v in $holds; do [ "$v" -gt 0 ] && nh_pos=$(( nh_pos + 1 )); done
  # STUCK-OPEN requires EVERY repeat to emit on a non-edge. A tool that emitted on 1 of 3 holds is
  # disagreeing with itself — that is FLAKY, the same consensus rule the FIRE leg already obeys, and
  # calling it STUCK-OPEN turned three intermittent census tools into confident findings.
  if [ "$nh_pos" = "$REPEAT" ]; then
    printf '%s STUCK-OPEN emits-on-a-NON-edge(hold=%s;state=%s)\n' "$t" "${holds# }" "$n"
  elif [ "$nh_pos" -gt 0 ]; then
    printf '%s FLAKY holds-inconsistently(hold=%s;state=%s)\n' "$t" "${holds# }" "$n"
  elif [ "$nf_na" = "$REPEAT" ]; then
    # The bare control printed, so trap 3 passed — but the EDGE run itself is the honest n/a here.
    printf '%s inconclusive edge-run-is-n-a(rc=2 on every repeat; organ away, not a dead gate;state=%s)\n' "$t" "$n"
  elif [ "$nf_err" = "$REPEAT" ]; then
    printf '%s inconclusive edge-run-errored(rc=%s;a failed run says nothing about the gate;state=%s)\n' "$t" "${frcs# }" "$n"
  elif [ "$nf_mute" = "$REPEAT" ]; then
    # TWO-RUN VERDICT (trap 6): one sweep's silence is a lead. Only an earlier run — at least
    # CONFIRM_GAP old, so it is a different node-moment and not this one counted twice — promotes it.
    local ps age pv why
    if ps="$(prior_sighting "$t")"; then
      age="${ps%% *}"; pv="${ps##* }"
      case "$pv" in
        DEAD|DEAD-CANDIDATE)
          if [ "$age" -ge "$CONFIRM_GAP" ]; then
            printf '%s DEAD cannot-fire-on-a-real-edge(fire=%s;bare=%sB;state=%s;reproduced — prior run %ss ago also %s)\n' \
              "$t" "${fires# }" "$bare" "$n" "$age" "$pv"
            return 0
          fi
          why="prior sighting only ${age}s old (<${CONFIRM_GAP}s: same node-moment, not a second witness)" ;;
        *) why="prior run graded it $pv" ;;
      esac
    else
      why="no prior run to reproduce it (first sighting, or an unreadable/absent audit state)"
    fi
    printf '%s DEAD-CANDIDATE silent-once-not-yet-reproduced(fire=%s;bare=%sB;state=%s;%s)\n' \
      "$t" "${fires# }" "$bare" "$n" "$why"
  elif [ "$nf_pos" = "$REPEAT" ]; then
    printf '%s LIVE fires=%s holds-silent(state=%s)\n' "$t" "${fires# }" "$n"
  else
    printf '%s FLAKY disagrees-across-%s-repeats(fire=%s;rc=%s;state=%s)\n' "$t" "$REPEAT" "${fires# }" "${frcs# }" "$n"
  fi
}

main(){
  # SINGLE WRITER. Two audits at once interleave their seeds in one sandbox tree and each reads the
  # other's label as the tool's own — measured: two overlapping runs on this node produced mutually
  # corrupt verdicts. -n so the second one declines instead of queueing behind a 20-minute sweep.
  exec 9>"$MESH/.edge-gate-audit.lock" 2>/dev/null || true
  if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
    echo "edge-gate-audit: n/a — another audit holds the lock (single-writer; no claim made this run)"
    exit 2
  fi
  # The PREVIOUS run's rows, read before anything can overwrite them — the second witness a DEAD
  # needs (trap 6). Absent or unparseable is not an error: it means nothing can be confirmed yet.
  PRIOR_TS=""; PRIOR_ROWS=""
  if [ -f "$STATE" ]; then
    PRIOR_TS="$(sed -n 's/^TS=//p' "$STATE" | head -1)"
    PRIOR_ROWS="$(grep -vE '^(SUMMARY|TS)=' "$STATE" 2>/dev/null)"
  fi
  build_sandbox || { echo "edge-gate-audit: n/a — could not build the probe sandbox"; exit 2; }
  local t out="" dead=0 cand=0 stuck=0 flaky=0 live=0 skip=0 inc=0
  for t in $(edge_tools); do
    local r; r="$(audit_tool "$t")"
    out="$out$r"$'\n'
    case "$r" in
      *" DEAD-CANDIDATE "*) cand=$(( cand + 1 )) ;;   # FIRST: " DEAD " must not claim this row
      *" DEAD "*)         dead=$(( dead + 1 )) ;;
      *" STUCK-OPEN "*)   stuck=$(( stuck + 1 )) ;;
      *" FLAKY "*)        flaky=$(( flaky + 1 )) ;;
      *" LIVE "*)         live=$(( live + 1 )) ;;
      *" inconclusive "*) inc=$(( inc + 1 )) ;;
      *)                  skip=$(( skip + 1 )) ;;
    esac
  done
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local summary="live=$live dead=$dead dead-candidate=$cand stuck-open=$stuck flaky=$flaky inconclusive=$inc skipped=$skip"
  # Coverage is published IN the reading: a pass count means nothing without the count of tools this
  # audit could not drive at all.
  echo "edge-gate-audit: $summary (skipped+inconclusive+dead-candidate are NOT passes; a dead-candidate is one sweep's silence awaiting a second, later run)"
  # EVERY row is printed, alarms marked `!`. Printing only the alarms would hide the coverage: a run
  # that skipped fifteen tools and audited two would read identically to one that audited seventeen.
  printf '%s' "$out" | sed -E 's/^(.* DEAD-CANDIDATE )/~ \1/; t; s/^(.* (DEAD|STUCK-OPEN|FLAKY) )/! \1/; t; s/^/  /'
  { printf '%s  %s\n' "$ts" "$summary"; printf '%s' "$out" | sed 's/^/    /'; } >> "$LOG" 2>/dev/null || true
  printf 'SUMMARY=%s\nTS=%s\n%s' "$summary" "$ts" "$out" > "$STATE" 2>/dev/null || true
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
  [ $(( dead + stuck )) -gt 0 ] && exit 1
  exit 0
}

# ── smoke test ─────────────────────────────────────────────────────────────────────────────────
# Runs against PURPOSE-BUILT fixture tools in a tempdir — a known-dead one, a known-live one and a
# known-stuck-open one — so the detector is proven on gates whose true verdict is not in doubt. The
# real reflexes cannot serve as fixtures: their live verdict is what this tool exists to discover, so
# asserting against them would be asserting against the answer.
if [ "${1:-}" = --test ]; then
  e=0
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/bin" "$tmp/src" "$tmp/mesh"

  mkfix(){ # $1 name  $2 body-flavour
    cat > "$tmp/src/mesh-fix-$1" <<EOF
#!/usr/bin/env bash
set -uo pipefail
STATE="\$HOME/.mesh/.fix-$1.state"
label=STEADY
EOF
    case "$2" in
      dead) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
printf '%s|x=1\n' "$label" > "$STATE"
if [ "${1:-}" = --edge ]; then
  prev="$(head -1 "$STATE" | cut -d'|' -f1)"      # reads back what it just wrote
  [ "$prev" = "$label" ] && exit 0
  echo "[fix] $label"; exit 0
fi
echo "[fix] $label"
EOF
        ;;
      live) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
prev=""; [ -f "$STATE" ] && prev="$(head -1 "$STATE" | cut -d'|' -f1)"
if [ "${1:-}" = --edge ]; then
  # NOTE the shape: --edge does NOT rewrite state (mesh-rtc-drift and mesh-mem-guard are real
  # examples — their prev lives outside the file the bare path writes). This is what makes the
  # restore assertion load-bearing: nothing but the audit's own backup puts the file back.
  [ "$prev" = "$label" ] && exit 0
  echo "[fix] $label"; exit 0
fi
# A DECOY, written FIRST so it carries the earlier mtime: real tools touch several files per run and
# other reflexes write concurrently, so "the file that changed" is a set, not a singleton. Picking the
# wrong member reports a verdict about a file the tool never gated on — mesh-gravity was reported DEAD
# off `.voice-rx-state` exactly this way.
: > "${STATE%/*}/.aaa-decoy-state"
# deliberately MULTI-LINE: real state files carry extra rows (mesh-kernel-taint's has six), and a
# probe that seeds by rewriting line 1 destroys the rest unless it restores the whole file.
printf '%s|x=1\nSINCE=fixture\nEXTRA=row\n' "$label" > "$STATE"
echo "[fix] $label"
EOF
        ;;
      stuck) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
prev=""                                            # the other failure direction: always fires
printf '%s|x=1\n' "$label" > "$STATE"
if [ "${1:-}" = --edge ]; then
  [ "$prev" = "$label" ] && exit 0
  echo "[fix] $label"; exit 0
fi
echo "[fix] $label"
EOF
        ;;
      needsprior) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
[ -f "$STATE" ] || exit 0                          # no prior state → nothing to say at all
prev="$(head -1 "$STATE" | cut -d'|' -f1)"
if [ "${1:-}" = --edge ]; then
  [ "$prev" = "$label" ] && exit 0
  printf '%s|x=1\n' "$label" > "$STATE"
  echo "[fix] $label (prior=$prev)"; exit 0
fi
printf '%s|x=1\n' "$label" > "$STATE"
echo "[fix] $label (prior=$prev)"
EOF
        ;;
      mute) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
if [ "${1:-}" = --edge ]; then exit 0; fi          # organ n/a: prints nothing, ever
exit 0
EOF
        ;;
      naedge) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
# The bare run PRINTS (so the mute-control leg passes) but the EDGE run is an honest n/a: the organ
# is away. This is mesh-phone-prox, which was graded DEAD off the byte count alone.
if [ "${1:-}" = --edge ]; then exit 2; fi
printf '%s|x=1\n' "$label" > "$STATE"
echo "[fix] $label"
EOF
        ;;
      errored) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
# Same, but the edge run FAILS rather than declining. mesh-powerbtn, rc=1. A failed run says nothing
# about the gate, so it is inconclusive — a distinct word from n/a, because the causes differ.
if [ "${1:-}" = --edge ]; then exit 1; fi
printf '%s|x=1\n' "$label" > "$STATE"
echo "[fix] $label"
EOF
        ;;
      loudfail) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
# BYTES WIN. This gate works and signals its finding by EXIT CODE as well as by printing. If rc were
# allowed to overturn the byte count, the rc leg above would demote a working gate to inconclusive.
prev=""; [ -f "$STATE" ] && prev="$(head -1 "$STATE" | cut -d'|' -f1)"
if [ "${1:-}" = --edge ]; then
  [ "$prev" = "$label" ] && exit 0
  echo "[fix] $label"; exit 3
fi
printf '%s|x=1\n' "$label" > "$STATE"
echo "[fix] $label"
EOF
        ;;
      poster) cat >> "$tmp/src/mesh-fix-$1" <<'EOF'
prev=""; [ -f "$STATE" ] && prev="$(head -1 "$STATE" | cut -d'|' -f1)"
printf '%s|x=1\n' "$label" > "$STATE"
if [ "${1:-}" = --edge ] && [ "$prev" != "$label" ]; then mesh-chat "[fyi] fixture fired"; fi
echo "[fix] $label"
EOF
        ;;
    esac
    chmod +x "$tmp/src/mesh-fix-$1"; cp -a "$tmp/src/mesh-fix-$1" "$tmp/bin/mesh-fix-$1"
  }
  mkfix dead dead; mkfix live live; mkfix stuck stuck; mkfix mute mute; mkfix poster poster
  mkfix naedge naedge; mkfix errored errored; mkfix loudfail loudfail
  # A tool that merely MENTIONS a sibling whose name has an actuator as a PREFIX (mesh-activity-tempo
  # contains "mesh-act") must still be audited. The unanchored regex skipped mesh-tempo-context on
  # exactly this, and a false SKIP reads as a deliberate exclusion rather than lost coverage.
  # A tool whose reading depends on state from PREVIOUS runs: mute unless its state file already
  # exists. Without the sandbox carrying a COPY of the real state dotfiles, every such tool would be
  # probed from a blank baseline and render inconclusive — coverage quietly lost across the family.
  mkfix needsprior needsprior
  mkfix mentioner live
  printf '\n# doc: reads mesh-activity-tempo and mesh-actigraphy-like siblings\n' >> "$tmp/src/mesh-fix-mentioner"
  printf '\n# doc: reads mesh-activity-tempo and mesh-actigraphy-like siblings\n' >> "$tmp/bin/mesh-fix-mentioner"

  # The gap is pinned LARGE so that two back-to-back runs in this test can never accidentally confirm
  # each other — every confirmation below is driven by a HAND-SEEDED prior state whose age is explicit.
  aud(){ MESH_DIR="$tmp/mesh" MESH_EDGE_AUDIT_BIN="$tmp/bin" MESH_EDGE_AUDIT_SRC="$tmp/src" \
         MESH_EDGE_AUDIT_LOG="$tmp/log" MESH_EDGE_AUDIT_STATE="$tmp/st" \
         MESH_EDGE_AUDIT_CONFIRM_GAP="${2:-3600}" \
         MESH_EDGE_AUDIT_REPEAT="${1:-2}" "$SELF" 2>&1; }
  seed_prior(){ # <verdict> <TS> — the previous run's artifact, the only witness a DEAD may lean on
    printf 'SUMMARY=seeded\nTS=%s\nmesh-fix-dead %s seeded-by-the-test\n' "$2" "$1" > "$tmp/st"; }
  # Lay down a production state for the live fixture first: an assertion that a file did not change
  # is vacuous if the file does not exist.
  printf 'STEADY|x=1\nSINCE=fixture\nEXTRA=row\n' > "$tmp/mesh/.fix-live.state"
  printf 'OLDLABEL|x=1\n' > "$tmp/mesh/.fix-needsprior.state"
  _prod_before="$(cat "$tmp/mesh/.fix-live.state")"
  o="$(aud)"; rc=$?

  # 1. The detector must NAME the dead gate — the whole point. On a FIRST sighting it names it as a
  #    CANDIDATE: one sweep's silence is a function of what the node was doing, not of the gate (8 of
  #    12 real DEADs fired when re-probed 78 min later). The alarm is arm 1b, below.
  case "$o" in *"mesh-fix-dead DEAD-CANDIDATE"*) : ;; *) echo "test: a first-sighting dead gate must be reported DEAD-CANDIDATE, got: $o FAIL"; e=1 ;; esac
  case "$o" in *"dead=0 dead-candidate=1"*) : ;; *) echo "test: an unreproduced silence must not be counted in dead=, got: $o FAIL"; e=1 ;; esac
  # 2. …and must NOT flag the correctly-ordered one. A detector that calls everything dead is useless.
  case "$o" in *"mesh-fix-live LIVE"*) : ;; *) echo "test: the correctly-ordered gate must be reported LIVE FAIL"; e=1 ;; esac
  # 3. THE OTHER DIRECTION: a gate that fires on a NON-edge is broken too, and a FIRE-only assertion
  #    would greenlight it. This is the leg that catches a botched fix (prev="").
  case "$o" in *"mesh-fix-stuck STUCK-OPEN"*) : ;; *) echo "test: an always-firing gate must be STUCK-OPEN, not LIVE FAIL"; e=1 ;; esac
  # 3b. THE STATE FILE MUST BE THE TOOL'S OWN. A decoy file touched by an unrelated writer during the
  #     probe window must not be picked up and reported against: mesh-gravity was first reported DEAD
  #     off `.voice-rx-state`, a file it never writes. The decoy here is touched by a background
  #     toucher while the audit runs, exactly as a concurrent reflex would.
  #     mesh-fix-live writes `.aaa-decoy-state` BEFORE its real state, so the decoy holds the earlier
  #     mtime and any "first file that changed" pick lands on it — deterministically, no race to lose.
  case "$o" in *"state=.aaa-decoy-state"*) echo "test: a decoy file was reported as the tool's state — the stem filter is not selecting FAIL"; e=1 ;; esac

  # 4. A mute control is inconclusive, NEVER dead — an unreachable organ is not a failing one.
  case "$o" in *"mesh-fix-mute inconclusive"*) : ;; *) echo "test: a mute control must render inconclusive, not DEAD FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-mute DEAD"*) echo "test: a mute control must NEVER be called DEAD FAIL"; e=1 ;; esac
  # 5. A side-effecting edge path is SKIPPED and counted as skipped — never driven (it would forge the
  #    very board post a human reads), and never folded into the pass column.
  case "$o" in *"mesh-fix-poster SKIP side-effecting"*) : ;; *) echo "test: a posting edge path must be SKIPPED by name FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-mentioner SKIP"*) echo "test: a tool that only MENTIONS mesh-activity-tempo must NOT be skipped as side-effecting FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-mentioner LIVE"*) : ;; *) echo "test: the mentioner fixture must be audited and LIVE, got: $o FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-needsprior inconclusive"*) echo "test: the sandbox did not carry the existing state across — a tool needing prior state was probed from a blank baseline FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-needsprior LIVE"*) : ;; *) echo "test: a tool depending on prior state must still be audited, got: $o FAIL"; e=1 ;; esac
  case "$o" in *"skipped+inconclusive+dead-candidate are NOT passes"*) : ;; *) echo "test: the summary must publish its own coverage FAIL"; e=1 ;; esac
  # 5b. AN EDGE RUN THAT EXITS 2 IS AN ORGAN THAT IS AWAY, NOT A DEAD GATE. The bare control PRINTS
  #     here, so trap 3 does not catch it: the silence is in the edge run itself, and only its rc says
  #     why. mesh-phone-prox was graded DEAD off the byte count alone and sat red on the dash all day.
  case "$o" in *"mesh-fix-naedge inconclusive edge-run-is-n-a"*) : ;; *) echo "test: an --edge run exiting 2 must render inconclusive-organ-away, got: $o FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-naedge DEAD"*) echo "test: an --edge run exiting 2 must NEVER be graded DEAD (nor a candidate) FAIL"; e=1 ;; esac
  # 5c. …and a run that ERRORED is a third thing again: it says nothing about the gate either way.
  case "$o" in *"mesh-fix-errored inconclusive edge-run-errored"*) : ;; *) echo "test: an --edge run exiting 1 must render inconclusive-errored, got: $o FAIL"; e=1 ;; esac
  case "$o" in *"mesh-fix-errored DEAD"*) echo "test: an --edge run exiting 1 must NEVER be graded DEAD (nor a candidate) FAIL"; e=1 ;; esac
  # 5d. THE ORDERING, which is what keeps 5b/5c from weakening the detector: BYTES WIN. A gate that
  #     fires AND signals by exit code has fired, and no rc rule may demote it.
  case "$o" in *"mesh-fix-loudfail LIVE"*) : ;; *) echo "test: a gate that fires and exits nonzero must still be LIVE — rc must not overturn bytes, got: $o FAIL"; e=1 ;; esac

  # 6. A DEAD finding is an ALARM, not a note (here the alarm is the STUCK-OPEN fixture; the dead one
  #    is still only a candidate on this first pass — arm 1b proves its own exit code).
  [ "$rc" = 1 ] || { echo "test: a STUCK-OPEN gate must exit 1, got $rc FAIL"; e=1; }
  # 7. PRODUCTION IS NEVER TOUCHED — not "restored afterwards", never written. The seed must not
  #    appear anywhere under the real mesh dir, in a state file OR in a log: driving a reflex makes it
  #    append its own line to its durable log, and no restore undoes an append. This is the assertion
  #    the first design could not have passed — its probe label reached three production logs.
  if grep -rl "$SEED_LABEL" "$tmp/mesh" >/dev/null 2>&1; then
    echo "test: the audit wrote its seed into the production tree — it forges the records it audits FAIL"; e=1
  fi
  # 8. THE WHOLE FILE IS RESTORED, not just line 1. Seeding rewrites the file, so every row below the
  #    label is destroyed unless the backup is put back — and mesh-fix-live's state is multi-line, and
  #    its --edge path deliberately does NOT rewrite state, precisely so this can fail.
  #    Asserting only line 1 was VACUOUS and measured so: it passed with EVERY restore path deleted,
  #    because the probe's own HOLD leg rewrites line 1 on its way out. A gate you have not seen fail.
  [ "$(cat "$tmp/mesh/.fix-live.state" 2>/dev/null)" = "$_prod_before" ] || { echo "test: the PRODUCTION state file changed during the audit — the sandbox redirect is not holding FAIL"; e=1; }
  [ "$(wc -l < "$tmp/mesh/.fix-live.state")" -eq 3 ] || { echo "test: the production multi-line state file was truncated FAIL"; e=1; }
  # 1b. THE PROMOTION. With a prior run that already saw it — and that run old enough to be a
  #     different node-moment — the same silence becomes the alarm. Without this arm the tool could
  #     never emit DEAD at all, which is the way this fix would fail silently.
  seed_prior DEAD-CANDIDATE "$(date -u -d '-2 hours' +%Y-%m-%dT%H:%M:%SZ)"
  o1b="$(aud)"; rc1b=$?
  case "$o1b" in *"mesh-fix-dead DEAD "*) : ;; *) echo "test: a silence REPRODUCED by an older run must be promoted to DEAD, got: $o1b FAIL"; e=1 ;; esac
  case "$o1b" in *"reproduced — prior run"*) : ;; *) echo "test: the DEAD row must cite the run that reproduced it FAIL"; e=1 ;; esac
  [ "$rc1b" = 1 ] || { echo "test: a confirmed DEAD gate must exit 1, got $rc1b FAIL"; e=1; }
  # 1c. THE GAP IS REAL. A prior sighting from THIS node-moment is the same sample counted twice — the
  #     exact error the fix exists to undo — so it must not confirm.
  seed_prior DEAD-CANDIDATE "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  o1c="$(aud)"
  case "$o1c" in *"mesh-fix-dead DEAD-CANDIDATE"*) : ;; *) echo "test: a prior sighting younger than the confirm gap must NOT promote to DEAD, got: $o1c FAIL"; e=1 ;; esac
  # 1d. …and the prior run's VERDICT is read, not merely its presence: an old run that graded the tool
  #     LIVE is evidence AGAINST the death, and must never be mistaken for a second sighting.
  seed_prior LIVE "$(date -u -d '-2 hours' +%Y-%m-%dT%H:%M:%SZ)"
  o1d="$(aud)"
  case "$o1d" in *"mesh-fix-dead DEAD-CANDIDATE"*) : ;; *) echo "test: a prior run that graded it LIVE must not confirm a death, got: $o1d FAIL"; e=1 ;; esac

  # 9. All-clear must exit 0: strip the broken fixtures and the same detector must go green, or its
  #    exit code is a constant rather than a verdict.
  rm -f "$tmp/src/mesh-fix-dead" "$tmp/bin/mesh-fix-dead" "$tmp/src/mesh-fix-stuck" "$tmp/bin/mesh-fix-stuck"
  o2="$(aud)"; rc2=$?
  [ "$rc2" = 0 ] || { echo "test: with no dead gate the audit must exit 0, got $rc2 :: $o2 FAIL"; e=1; }
  case "$o2" in *"dead=0"*) : ;; *) echo "test: the all-clear summary must say dead=0, got '$o2' FAIL"; e=1 ;; esac

  [ "$e" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok — detector driven against purpose-built fixtures whose true verdict is not in doubt (the real reflexes cannot be fixtures: their verdict is what this tool exists to discover): a write-then-read gate reported DEAD and exit 1, a correctly-ordered one LIVE, an always-firing one STUCK-OPEN (the failure direction a FIRE-only assertion would greenlight, and exactly how the first attempt at this fix went wrong), a mute control inconclusive and never DEAD, a posting edge path SKIPPED by name rather than driven; coverage published in the summary; the PRODUCTION tree is byte-unchanged and carries no seed in any state file OR log (the audit probes under a redirected HOME rather than seeding-then-restoring, because driving a reflex makes it append to its durable log and no restore undoes an append); exit code proven a verdict, not a constant, by re-running clean for 0"
  exit 0
fi

case "${1:-}" in
  --help|-h) sed -n '3,55p' "$SELF"; exit 0 ;;
  *) main ;;
esac
