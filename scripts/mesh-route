#!/usr/bin/env bash
# mesh-route — the THIN context router (the mesh's switchboard). Reads NEW lines from the unified
# inbox (voice-in.log), ATTRIBUTES each (who) + CLASSIFIES (which channel) + files into that channel's
# inbox, so each mind reads only its own stream and the mainframe stays about-the-organism.
# Deliberately thin + rule-first + explicit-tag-first; ambiguous -> mainframe (it decides). Every mesh
# can swap the rules (config, not hardcode). State: ~/.mesh/.route-offset. See
# knowledge/channels-and-context-routing.md.
#
#   mesh-route            route new messages since last run
#   mesh-route --since N  (re)route from line N (demo / replay)
#   mesh-route --show     show per-channel inbox tails
set -uo pipefail
MESH="${MESH:-$HOME/.mesh}"
INBOX="${INBOX:-$MESH/voice-in.log}"
CH="${CH:-$MESH/channels}"
OFF="${OFF:-$MESH/.route-offset}"

# ---- configurable rules (swap per mesh) ---------------------------------
CARE_USERS_RE='розал|разал|rozal'                         # known non-operator people the mesh serves
TAG_RE='это (розал|разал)|rozal[iy]|розал|разал'          # explicit speaker tags
CARE_RE='пита|еда|поел|поесть|съест|диет|самочувств|болит|давлен|здоров|гастрит|таблет|аптек|желч|вертиг|кружит'
MESH_RE='нод[аеуыо]|genome|геном|vpn|маршрут|рефлекс|деплой|коммит|\bpr\b|ревью|ilya|substrate|mesh-|меш|роутер|канал|стюард|steward|реборут|ребут|reboot'

classify(){ # stdin: one message -> prints "who chan"
  local line low who="operator" chan="mainframe"
  line="$1"; low=$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')
  printf '%s' "$low" | grep -qE "$TAG_RE" && who="rozalia"
  if [ "$who" != operator ] || printf '%s' "$low" | grep -qE "$CARE_RE"; then chan="care"
  elif printf '%s' "$low" | grep -qE "$MESH_RE"; then chan="mesh-steward"; fi
  printf '%s %s' "$who" "$chan"
}

if [ "${1:-}" = --test ]; then
  command -v grep   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v tail   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tail)"; exit 1; }
  command -v wc     >/dev/null 2>&1 || { echo "smoke-test: FAIL (no wc)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v date   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/channels" || { echo "smoke-test: FAIL (tmp channels mkdir)"; exit 1; }
  cat > "$tmp/voice-in.log" <<'EOF'
это розал пита
please reboot routing after the vpn change
EOF
  out="$(MESH="$tmp" INBOX="$tmp/voice-in.log" CH="$tmp/channels" OFF="$tmp/.route-offset" "$0" 2>&1)" || {
    echo "smoke-test: FAIL (route run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q 'routed 2 message(s)' || {
    echo "smoke-test: FAIL (unexpected route output: $out)"; exit 1;
  }
  grep -q 'who=rozalia' "$tmp/channels/care.inbox" 2>/dev/null || {
    echo "smoke-test: FAIL (care inbox missing rozalia route)"; exit 1;
  }
  grep -q 'who=operator' "$tmp/channels/mesh-steward.inbox" 2>/dev/null || {
    echo "smoke-test: FAIL (mesh-steward inbox missing operator route)"; exit 1;
  }
  echo "smoke-test: ok"
  exit 0
fi

mkdir -p "$CH"

if [ "${1:-}" = --show ]; then
  for f in "$CH"/*.inbox; do [ -f "$f" ] || continue; echo "== ${f##*/} =="; tail -n 3 "$f"; echo; done
  exit 0
fi

total=$(wc -l < "$INBOX" 2>/dev/null || echo 0)
seen=$(cat "$OFF" 2>/dev/null || echo 0)
[ "${1:-}" = --since ] && seen="${2:-0}"
[ "$total" -le "$seen" ] && { echo "nothing new (seen=$seen total=$total)"; exit 0; }

n=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  read -r who chan <<<"$(classify "$line")"
  printf '%s | who=%s | %s\n' "$(date -u +%FT%TZ)" "$who" "$line" >> "$CH/${chan}.inbox"
  n=$((n+1))
done < <(tail -n +"$((seen+1))" "$INBOX")
echo "$total" > "$OFF"
echo "routed $n message(s); offset -> $total"
