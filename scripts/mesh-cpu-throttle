#!/usr/bin/env bash
# mesh-cpu-throttle — CPU THERMAL-THROTTLE sense: the EFFECT mesh-therm only predicts.
#   mesh-therm/mesh-stress read TEMPERATURE (the cause); this reads the hardware
#   THROTTLE-EVENT counters (/sys/devices/system/cpu/cpuN/thermal_throttle/) — the
#   actual performance LOSS when the CPU is forced below its rated clock. On
#   intel_pstate the throttle happens in HARDWARE (HWP): scaling_max_freq STAYS at
#   the hardware max even while throttling, so a freq/ceiling-clamp check MISSES it
#   entirely — only the event counters reveal it. This is the mesh's #1 documented
#   failure (thermal throttle starves the operator channel) made directly visible.
#   Load-independent: idle low-frequency (power-saving) is NOT a throttle event, so
#   this never confuses an idle node with a thermally-limited one.
# HONEST: exit 2 (UNAVAILABLE) when the throttle counters are absent — a VM, a
#   container, or a non-Intel CPU has no such sysfs; we report BLIND, never a faked
#   NOMINAL from an unreadable signal.
# DEBOUNCE: four anti-oscillation layers — (0) SIZE floor (chat-review/cputhrottle-magnitude-floor
#   2026-07-12): dwell/cooldowns debounce the CADENCE of throttling, not its SIZE — require the
#   per-interval throttle delta to clear MESH_THROTTLE_MIN_DELTA (default 20) before the board
#   alarm is eligible, so a sustained handful-of-events blip (of a ~300k cumulative, freq healthy)
#   routes to trace instead of crying 'shed a mind'; a real storm (hundreds-to-thousands/interval)
#   clears it, and a small blip never spends the episode's alarm eligibility (announced stays 0);
#   then (1) NOMINAL-side cooldown: suppress board
#   post within MESH_THROTTLE_NOM_COOLDOWN (default 1800s) of last nominal post,
#   routing recent recoveries to trace only; (2) THROTTLING-side dwell: require
#   MESH_THROTTLE_DWELL (default 2) consecutive positive deltas before posting
#   [cpu-throttling] to the board, routing sub-threshold events to trace only;
#   (3) ALARM-side cooldown (chat-review/cputhrottle-realarm-cooldown 2026-07-06 — the
#   NOMINAL-side cooldown alone was one-sided: a posted [cpu-nominal] recovery could be
#   contradicted by a fresh [cpu-throttling] re-alarm 10min later on a +4-event blip,
#   live on ds 17:16→17:26Z/18:36→18:46Z): a re-alarm within MESH_THROTTLE_ALARM_COOLDOWN
#   (default 1800s) of the last BOARD-POSTED [cpu-nominal] routes to trace instead —
#   the announced flag still flips so the eventual recovery stays correctly paired.
#   ALARM-PAIRING: TWO flags distinguish "alarm-eligible" from "actually board-posted".
#   'announced' (5th field) records whether THIS episode reached the alarm threshold
#   (dwell>=THROTTLE_DWELL) — it flips even when the alarm is trace-suppressed, so the
#   alarm fires ONCE per episode and the re-arm logic stays correct. 'board_alarmed'
#   (6th field, chat-review/cputhrottle-nominal-unpaired-on-board) records whether the
#   [cpu-throttling] alarm actually hit the BOARD (do_throttle_post=1) — it stays 0 for
#   an alarm routed to trace by the ALARM-side cooldown. The NOMINAL recovery posts
#   board [cpu-nominal] ONLY for a board_alarmed episode; a sub-dwell OR a trace-only
#   (cooldown-suppressed) episode recovers to trace — never an unpaired 'headroom
#   recovered' on the board with no preceding board [cpu-throttling]. (Using 'announced'
#   for this gate was the bug: a cooldown-suppressed alarm carried announced=1 and its
#   recovery leaked an orphaned board [cpu-nominal], e.g. ds 7-nominal-vs-2-throttling.)
#   The alarm fires ONCE per episode, when dwell first reaches the threshold — NOT on
#   the entry edge alone (entry is always dwell=1 since any positive delta is THROTTLING,
#   so the old entry-only guard never fired for a SUSTAINED throttle → [cpu-throttling]
#   was silently dead).
#   State file format: "<pkg> <state> <ms> <dwell> <announced> <board_alarmed>" (6 fields).
# reflex-cadence: 1-59/5 * * * *
# reflex-args: --edge
set -u

CPUBASE="${MESH_CPUBASE:-/sys/devices/system/cpu}"
TT="${MESH_TT_DIR:-$CPUBASE/cpu0/thermal_throttle}"
STATE="${MESH_THROTTLE_STATE:-$HOME/.mesh/cpu-throttle.state}"

# verdict_for_delta <delta-throttle-events> -> prints THROTTLING | NOMINAL
verdict_for_delta() { if [ "${1:-0}" -gt 0 ] 2>/dev/null; then echo THROTTLING; else echo NOMINAL; fi; }

# board post — sandbox-gated: MESH_THROTTLE_NOCHAT=1 suppresses the real outbound
# so --edge can be exercised in a test without spamming the board.
post() {
  [ -n "${MESH_THROTTLE_NOCHAT:-}" ] && { echo "[would-post] $*" >&2; return 0; }
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$*" >/dev/null 2>&1
}

# trace — the sub-threshold / suppressed sink; honors NOCHAT so --test stays hermetic
trace() {
  [ -n "${MESH_THROTTLE_NOCHAT:-}" ] && return 0
  command -v mesh-trace >/dev/null 2>&1 && mesh-trace "$*" >/dev/null 2>&1 || true
}

read_int() { local f="$1"; [ -r "$f" ] && cat "$f" 2>/dev/null || echo ""; }

# per_core_summary — the DIE-HOTSPOT skew axis the package counter is blind to.
#   package_throttle_count is UNIFORM across all CPUs, so mesh-therm/pkg senses can't tell
#   WHICH physical core is cooking. This folds logical CPUs → physical cores via
#   topology/core_id, AVERAGES the HT-sibling counters (a physical core has ONE throttle
#   counter shared by its threads; a read race can leave siblings off-by-one, so summing
#   would DOUBLE-COUNT — we average), then derives the asymmetry (hot core / cold core).
#   Live on IdeaPad: core2=544933 vs core3=37 → a ~14700x stable die hotspot.
# Sets globals (n/a-safe): pc_avail(1/0) pc_list("core0=N core1=N …") pc_ncores
#   pc_hot_core pc_hot_count pc_cold_core pc_cold_count pc_ratio pc_skew(1/0)
per_core_summary() {
  pc_avail=0; pc_list=""; pc_ncores=0
  pc_hot_core=na; pc_hot_count=0; pc_cold_core=na; pc_cold_count=0; pc_ratio=0; pc_skew=0
  declare -A _sum _cnt
  local any=0 d cpu core c first avg denom
  for d in "$CPUBASE"/cpu[0-9]*/thermal_throttle/core_throttle_count; do
    [ -r "$d" ] || continue
    cpu="${d%/thermal_throttle/core_throttle_count}"; cpu="${cpu##*/}"   # cpuN
    core=$(read_int "$CPUBASE/$cpu/topology/core_id"); core="${core:-${cpu#cpu}}"
    c=$(read_int "$d"); [ -n "$c" ] || continue
    [ "$c" -ge 0 ] 2>/dev/null || continue
    _sum[$core]=$(( ${_sum[$core]:-0} + c ))
    _cnt[$core]=$(( ${_cnt[$core]:-0} + 1 ))
    any=1
  done
  [ "$any" = 1 ] || return 0   # no core_throttle_count files → honest n/a (VM/container/pkg-only)
  pc_avail=1; first=1
  for core in $(printf '%s\n' "${!_sum[@]}" | sort -n); do
    avg=$(( _sum[$core] / _cnt[$core] ))    # AVERAGE siblings — never sum (would double-count)
    pc_list="$pc_list core$core=$avg"
    pc_ncores=$((pc_ncores + 1))
    if [ "$first" = 1 ]; then
      pc_hot_core=$core; pc_hot_count=$avg; pc_cold_core=$core; pc_cold_count=$avg; first=0
    else
      [ "$avg" -gt "$pc_hot_count" ] && { pc_hot_core=$core; pc_hot_count=$avg; }
      [ "$avg" -lt "$pc_cold_count" ] && { pc_cold_core=$core; pc_cold_count=$avg; }
    fi
  done
  pc_list="${pc_list# }"
  # skew ratio = hottest / coldest (coldest clamped to 1 → a 0-count cold core against a hot
  # one is maximal asymmetry, not a div-by-zero). No throttle anywhere (hot=0) → no skew.
  if [ "$pc_hot_count" -gt 0 ]; then
    denom="$pc_cold_count"; [ "$denom" -lt 1 ] && denom=1
    pc_ratio=$(( pc_hot_count / denom ))
    [ "$pc_ratio" -ge "${MESH_THROTTLE_SKEW_RATIO:-4}" ] && pc_skew=1
  fi
  return 0
}

# --- portable logic self-test (runs on ANY node, no sysfs needed) -------------
if [ "${1:-}" = "--test" ]; then
  fail=""
  [ "$(verdict_for_delta 0)"  = NOMINAL ]    || fail="$fail delta0!=NOMINAL"
  [ "$(verdict_for_delta 7)"  = THROTTLING ] || fail="$fail delta7!=THROTTLING"
  [ "$(verdict_for_delta "")" = NOMINAL ]    || fail="$fail empty!=NOMINAL"
  if [ -n "$fail" ]; then echo "smoke-test: FAIL ($fail )"; exit 1; fi

  # --- edge state-machine: announced-flag alarm/recovery pairing (hermetic) ------
  # Re-execs the SAME --edge code path against a fixture counter dir; post() emits
  # "[would-post] …" on stderr under NOCHAT, trace() is silenced — so we assert on
  # exactly the BOARD posts, with zero real side-effects.
  et=$(mktemp -d); ett="$et/tt"; mkdir -p "$ett"
  edge() {  # $1=package_throttle_count value -> echoes any [would-post] board lines
    printf '%s\n' "$1" > "$ett/package_throttle_count"
    printf '0\n'      > "$ett/package_throttle_total_time_ms"
    MESH_TT_DIR="$ett" MESH_THROTTLE_STATE="$et/state" \
    MESH_NOM_COOLDOWN_FILE="$et/cooldown" MESH_THROTTLE_NOCHAT=1 \
    MESH_THROTTLE_MIN_DELTA=1 MESH_CPUBASE="$et/nocpu" \
      "$0" --edge 2>&1 1>/dev/null
  }
  efail=""
  edge 100 >/dev/null           # seed (prev_state NONE — no post)
  s1=$(edge 101)                # delta1 -> THROTTLING dwell1 (sub-threshold)
  s2=$(edge 101)                # delta0 -> NOMINAL: recovery of an UNannounced episode
  # A (the core fix): a sub-dwell throttle→recover cycle yields ZERO board posts
  [ -z "$s1$s2" ] || efail="$efail subdwell-posted:[$s1|$s2]"
  edge 103 >/dev/null           # delta2 -> THROTTLING dwell1
  s3=$(edge 105)                # delta2 -> THROTTLING dwell2 -> ALARM (revived)
  # B: a sustained throttle (dwell>=THROTTLE_DWELL) alarms exactly once
  case "$s3" in *'[cpu-throttling]'*) : ;; *) efail="$efail dwell2-no-alarm:[$s3]";; esac
  s3b=$(edge 107)               # delta2 -> still THROTTLING, already announced -> silent
  case "$s3b" in *'[cpu-'*) efail="$efail double-alarm:[$s3b]";; esac
  s4=$(edge 107)                # delta0 -> NOMINAL: recovery of an ANNOUNCED episode
  # C: recovery of an announced episode still posts [cpu-nominal] (no over-suppression)
  case "$s4" in *'[cpu-nominal]'*) : ;; *) efail="$efail announced-recovery-silent:[$s4]";; esac
  # s4 just wrote a FRESH epoch to the nominal-cooldown file — the next episode's alarm is now
  # inside the default 1800s ALARM_COOLDOWN window (chat-review/cputhrottle-realarm-cooldown 2026-07-06:
  # a re-alarm this soon after a posted recovery was the live ds oscillation, +9ev/+4ev 10min apart).
  edge 109 >/dev/null           # delta2 -> THROTTLING dwell1 (sub-threshold, not yet alarm-eligible)
  s5=$(edge 111)                # delta2 -> THROTTLING dwell2 -> alarm-ELIGIBLE, but cooldown just set by s4
  # D: re-alarm inside the cooldown window is suppressed to trace (no board post)...
  case "$s5" in *'[cpu-'*) efail="$efail cooldown-not-suppressing-realarm:[$s5]";; esac
  # ...while 'announced' still flips to 1 in the state file, so the eventual recovery stays PAIRED
  # (never an orphaned [cpu-nominal] with no matching alarm) — this is the actual pairing guarantee.
  _ann5="$(awk '{print $5}' "$et/state" 2>/dev/null)"
  [ "$_ann5" = 1 ] || efail="$efail announced-not-set-during-cooldown-suppression:[$_ann5]"
  # E: falsify the gate is a genuine TIME WINDOW, not a permanent silence — collapse
  # MESH_THROTTLE_ALARM_COOLDOWN to 0 and repeat an identical recover→rethrottle sequence; an
  # immediate re-alarm must now reach the board (elapsed-since-last-nominal is never < 0).
  export MESH_THROTTLE_ALARM_COOLDOWN=0
  edge 111 >/dev/null           # delta0 -> NOMINAL: recovery of the cooldown-suppressed-but-announced episode
  edge 113 >/dev/null           # delta2 -> THROTTLING dwell1 (sub-threshold)
  s6=$(edge 115)                # delta2 -> THROTTLING dwell2 -> alarm-eligible, cooldown=0 -> must post
  case "$s6" in *'[cpu-throttling]'*) : ;; *) efail="$efail zero-cooldown-should-still-alarm:[$s6]";; esac
  unset MESH_THROTTLE_ALARM_COOLDOWN
  rm -rf "$et"

  # F: orphaned-nominal fix (chat-review/cputhrottle-nominal-unpaired-on-board) — an alarm
  #    TRACE-SUPPRESSED by the ALARM cooldown must NOT leak a board [cpu-nominal] on recovery.
  #    Construct: alarm suppressed (recent last-nominal + huge ALARM_COOLDOWN) so board_alarmed
  #    stays 0 while announced flips 1; then FORCE the nominal-side cooldown OPEN (last-nom=0)
  #    before recovery — so the ONLY thing that can still route the recovery to trace is the
  #    board_alarmed gate. Reverting :206 to the old prev_announced gate makes THIS recovery hit
  #    the board (now-0 > 1800) → the assertion FAILS, i.e. it genuinely catches the bug.
  ft=$(mktemp -d); ftt="$ft/tt"; mkdir -p "$ftt"
  fedge() {  # $1=pkg value ; $2(optional)=pre-seed the nominal-cooldown file with this epoch
    printf '%s\n' "$1" > "$ftt/package_throttle_count"
    printf '0\n'      > "$ftt/package_throttle_total_time_ms"
    [ -n "${2:-}" ] && printf '%s\n' "$2" > "$ft/cooldown"
    MESH_TT_DIR="$ftt" MESH_THROTTLE_STATE="$ft/state" \
    MESH_NOM_COOLDOWN_FILE="$ft/cooldown" MESH_THROTTLE_NOCHAT=1 \
    MESH_THROTTLE_MIN_DELTA=1 \
    MESH_THROTTLE_ALARM_COOLDOWN=999999 MESH_CPUBASE="$ft/nocpu" \
      "$0" --edge 2>&1 1>/dev/null
  }
  _now=$(date +%s)
  fedge 200 "$_now" >/dev/null   # seed (prev NONE); last-nominal := now → ALARM cooldown armed
  fedge 202 >/dev/null           # delta2 -> THROTTLING dwell1 (sub-threshold)
  fa=$(fedge 204)                # delta2 -> THROTTLING dwell2 -> alarm-eligible, inside ALARM_COOLDOWN -> SUPPRESSED to trace
  case "$fa" in *'[cpu-throttling]'*) efail="$efail F-suppressed-alarm-hit-board:[$fa]";; esac
  _ba="$(awk '{print $6}' "$ft/state" 2>/dev/null)"   # board_alarmed must stay 0 (never board-posted)
  [ "$_ba" = 0 ] || efail="$efail F-board_alarmed-set-on-suppressed-alarm:[$_ba]"
  fr=$(fedge 204 0)              # delta0 -> NOMINAL recovery; force nominal-cooldown OPEN (last-nom=0)
  # board_alarmed=0 -> recovery to TRACE, NO orphaned board [cpu-nominal] (old prev_announced gate posts here).
  case "$fr" in *'[cpu-nominal]'*) efail="$efail F-orphaned-board-nominal:[$fr]";; esac
  rm -rf "$ft"

  # G: SIZE floor (chat-review/cputhrottle-magnitude-floor) — a sustained but SMALL throttle
  #    (dwell met, per-interval delta below MESH_THROTTLE_MIN_DELTA) must NOT board-alarm; a
  #    genuinely large delta must; and a small blip must NOT spend the episode's alarm eligibility.
  #    Default MIN_DELTA (20) applies here (no MIN_DELTA override), unlike the helpers above.
  gt=$(mktemp -d); gtt="$gt/tt"; mkdir -p "$gtt"
  gedge() {  # $1=pkg value -> echoes any [would-post] board lines (MIN_DELTA at production default)
    printf '%s\n' "$1" > "$gtt/package_throttle_count"
    printf '0\n'      > "$gtt/package_throttle_total_time_ms"
    MESH_TT_DIR="$gtt" MESH_THROTTLE_STATE="$gt/state" \
    MESH_NOM_COOLDOWN_FILE="$gt/cooldown" MESH_THROTTLE_NOCHAT=1 \
    MESH_THROTTLE_ALARM_COOLDOWN=0 MESH_CPUBASE="$gt/nocpu" \
      "$0" --edge 2>&1 1>/dev/null
  }
  gedge 1000 >/dev/null          # seed (prev NONE)
  g1=$(gedge 1003)               # +3 -> THROTTLING dwell1
  g2=$(gedge 1006)               # +3 -> THROTTLING dwell2, delta 3 < 20 -> sub-magnitude, NO board post
  case "$g1$g2" in *'[cpu-throttling]'*) efail="$efail G-submagnitude-hit-board:[$g1|$g2]";; esac
  _gann="$(awk '{print $5}' "$gt/state" 2>/dev/null)"   # announced must stay 0 (episode not spent)
  [ "$_gann" = 0 ] || efail="$efail G-submagnitude-spent-announced:[$_gann]"
  # falsify: a LATER large interval in the SAME sustained episode must still alarm (eligibility intact)
  g3=$(gedge 1036)               # +30 >= 20, dwell3, ALARM_COOLDOWN=0 -> board post
  case "$g3" in *'[cpu-throttling]'*) : ;; *) efail="$efail G-large-after-small-no-alarm:[$g3]";; esac
  rm -rf "$gt"

  if [ -n "$efail" ]; then echo "edge-test: FAIL ($efail )"; exit 1; fi

  # --- per-physical-core DIE-HOTSPOT skew (hermetic, via --json against a fixture CPUBASE) -----
  #   Exercises the real fold-and-skew path: build cpu0..7 with core_ids 0,1,2,3 (HT-siblings
  #   share a core_id) + a package fixture so the exit-2 gate passes, then parse --json.
  pfail=""
  pt=$(mktemp -d); pkgd="$pt/pkg"; mkdir -p "$pkgd"
  printf '10\n' > "$pkgd/package_throttle_count"; printf '0\n' > "$pkgd/package_throttle_total_time_ms"
  mk_cpu() {  # $1=cpubase $2=cpuN $3=core_id $4=count
    mkdir -p "$1/$2/thermal_throttle" "$1/$2/topology"
    printf '%s\n' "$3" > "$1/$2/topology/core_id"
    printf '%s\n' "$4" > "$1/$2/thermal_throttle/core_throttle_count"
  }
  pcj() { MESH_TT_DIR="$pkgd" MESH_CPUBASE="$1" MESH_THROTTLE_NOCHAT=1 "$0" --json; }

  # (1) core2 >> core3 → hotspot=core2, skew flagged.  (3) siblings AVERAGED not summed:
  #     core2 = (500000+499999)/2 = 499999, NOT ~1,000,000.
  cbS="$pt/skew"
  mk_cpu "$cbS" cpu0 0 100 ; mk_cpu "$cbS" cpu4 0 100
  mk_cpu "$cbS" cpu1 1 200 ; mk_cpu "$cbS" cpu5 1 200
  mk_cpu "$cbS" cpu2 2 500000 ; mk_cpu "$cbS" cpu6 2 499999   # off-by-one read race
  mk_cpu "$cbS" cpu3 3 50  ; mk_cpu "$cbS" cpu7 3 50
  jS=$(pcj "$cbS")
  case "$jS" in *'"hotspot_core":2'*) : ;; *) pfail="$pfail skew-hotspot-not-core2:[$jS]";; esac
  case "$jS" in *'"skew":true'*)      : ;; *) pfail="$pfail skew-not-flagged:[$jS]";; esac
  case "$jS" in *'"2":499999'*)       : ;; *) pfail="$pfail siblings-not-averaged(double-count?):[$jS]";; esac

  # (2) uniform cores → NO skew (ratio 1x, skew:false)
  cbU="$pt/uniform"
  mk_cpu "$cbU" cpu0 0 42 ; mk_cpu "$cbU" cpu4 0 42
  mk_cpu "$cbU" cpu1 1 42 ; mk_cpu "$cbU" cpu5 1 42
  mk_cpu "$cbU" cpu2 2 42 ; mk_cpu "$cbU" cpu6 2 42
  mk_cpu "$cbU" cpu3 3 42 ; mk_cpu "$cbU" cpu7 3 42
  jU=$(pcj "$cbU")
  case "$jU" in *'"skew":false'*) : ;; *) pfail="$pfail uniform-flagged-skew:[$jU]";; esac

  # (4) missing core_throttle_count files → honest n/a (null), never a faked distribution
  cbN="$pt/nocores"; mkdir -p "$cbN"
  jN=$(pcj "$cbN")
  case "$jN" in *'"per_core_throttle":null'*) : ;; *) pfail="$pfail missing-cores-not-null:[$jN]";; esac
  case "$jN" in *'"hotspot_core":null'*)      : ;; *) pfail="$pfail missing-hotspot-not-null:[$jN]";; esac
  rm -rf "$pt"
  if [ -n "$pfail" ]; then echo "percore-test: FAIL ($pfail )"; exit 1; fi

  if [ -r "$TT/package_throttle_count" ]; then
    echo "smoke-test: ok (logic sound; counters present — sense LIVE here)"
  else
    echo "smoke-test: ok (logic sound; no throttle counters — sense reports UNAVAILABLE/exit2 here)"
  fi
  exit 0
fi

# --- availability: the honest exit-2 gate -------------------------------------
if [ ! -r "$TT/package_throttle_count" ]; then
  echo "cpu-throttle: UNAVAILABLE (no thermal_throttle counters — VM/container/non-Intel) — BLIND, not nominal"
  exit 2
fi

# --- read the real signal -----------------------------------------------------
pkg=$(read_int "$TT/package_throttle_count")
pkg_ms=$(read_int "$TT/package_throttle_total_time_ms"); pkg_ms="${pkg_ms:-0}"
core_max=0
for d in "$CPUBASE"/cpu[0-9]*/thermal_throttle/core_throttle_count; do
  c=$(read_int "$d"); [ -n "$c" ] && [ "$c" -gt "$core_max" ] 2>/dev/null && core_max="$c"
done
# per-physical-core distribution + die-hotspot skew axis (core_max above stays unchanged)
per_core_summary

# current avg frequency across cores — CONTEXT only (low freq != throttle)
sum_cur=0; max_one=0; n=0
for d in "$CPUBASE"/cpu[0-9]*/cpufreq/scaling_cur_freq; do
  v=$(read_int "$d"); [ -n "$v" ] || continue
  sum_cur=$((sum_cur + v)); n=$((n + 1))
done
max_one=$(read_int "$CPUBASE/cpu0/cpufreq/cpuinfo_max_freq"); max_one="${max_one:-0}"
avg_mhz=0; pct=0
[ "$n" -gt 0 ] && avg_mhz=$(( sum_cur / n / 1000 ))
[ "$max_one" -gt 0 ] && [ "$n" -gt 0 ] && pct=$(( (sum_cur / n) * 100 / max_one ))

# --- edge / stream mode: stateful delta, post on transition -------------------
if [ "${1:-}" = "--edge" ]; then
  prev_pkg=""; prev_state="NONE"; prev_dwell=0; prev_announced=0; prev_board_alarmed=0; prev_hot_core=na
  if [ -r "$STATE" ]; then read -r prev_pkg prev_state _ prev_dwell prev_announced prev_board_alarmed prev_hot_core < "$STATE" 2>/dev/null || true; fi
  prev_dwell="${prev_dwell:-0}"; prev_announced="${prev_announced:-0}"; prev_board_alarmed="${prev_board_alarmed:-0}"; prev_hot_core="${prev_hot_core:-na}"
  delta=0
  if [ -n "$prev_pkg" ] && [ "$pkg" -ge "$prev_pkg" ] 2>/dev/null; then delta=$((pkg - prev_pkg)); fi
  state=$(verdict_for_delta "$delta")
  # Dwell counter: consecutive positive deltas. Reset on delta=0 (throttle stopped).
  if [ "$delta" -gt 0 ]; then
    dwell=$((prev_dwell + 1))
  else
    dwell=0
  fi
  THROTTLE_DWELL="${MESH_THROTTLE_DWELL:-2}"
  ALARM_COOLDOWN="${MESH_THROTTLE_ALARM_COOLDOWN:-1800}"
  NOM_COOLDOWN="${MESH_NOM_COOLDOWN_FILE:-$HOME/.mesh/.cpu-nominal-cooldown}"
  # 'announced': 1 once this THROTTLING episode has been board-alarmed. Alarm ONCE
  # per episode, the first cycle dwell reaches THROTTLE_DWELL (carry the flag through
  # the rest of the episode; reset on recovery so the next episode re-arms). This
  # replaces the old entry-edge-only guard, which never fired for a sustained throttle.
  MIN_DELTA="${MESH_THROTTLE_MIN_DELTA:-20}"
  announced="$prev_announced"; board_alarmed="$prev_board_alarmed"; do_throttle_post=0; alarm_cooldown_active=0; submagnitude=0
  if [ "$state" = THROTTLING ]; then
    if [ "$prev_announced" != 1 ] && [ "$dwell" -ge "$THROTTLE_DWELL" ] && [ "$delta" -lt "$MIN_DELTA" ]; then
      # SIZE floor (chat-review/cputhrottle-magnitude-floor 2026-07-12): dwell debounces the
      # CADENCE of throttling but not its SIZE — a sustained +3/+6-event blip (of a ~300k-event
      # cumulative, freq healthy 79%) still reaches dwell and cried 'operator channel at risk —
      # shed a mind' on the BOARD (5 such alarms/14h live on ds/IdeaPad). A real throttle STORM
      # emits hundreds-to-thousands of events per interval (die hotspot core2=544933); noise a
      # handful. Require the interval delta to clear MESH_THROTTLE_MIN_DELTA (default 20) before
      # the alarm is eligible. Crucially leave 'announced'=0 here so a LATER genuinely-large
      # interval in the SAME sustained episode still alarms (a small blip never marks the episode
      # spent), and route this sub-magnitude reading to trace, not the board.
      submagnitude=1
    elif [ "$prev_announced" != 1 ] && [ "$dwell" -ge "$THROTTLE_DWELL" ]; then
      announced=1
      # ALARM-side cooldown (symmetric to the NOMINAL-side one below): a re-alarm within
      # ALARM_COOLDOWN of the last BOARD-POSTED [cpu-nominal] is very likely re-flipping on
      # the same noise that already recovered — route to trace, but keep announced=1 so
      # this episode's eventual recovery still pairs (never an unpaired [cpu-nominal]).
      _alarm_now=$(date +%s)
      _last_nom=$(cat "$NOM_COOLDOWN" 2>/dev/null || echo 0)
      if [ $((_alarm_now - _last_nom)) -lt "$ALARM_COOLDOWN" ]; then
        alarm_cooldown_active=1
      else
        do_throttle_post=1
        board_alarmed=1   # only set when the alarm actually reaches the BOARD; carried
                          # through the episode, reset on recovery. Gates the board [cpu-nominal].
      fi
    fi
  else
    announced=0
    board_alarmed=0
  fi
  # DIE-HOTSPOT drift: the throttle-eating physical core MOVING is itself a signal (a new die
  # region is now cooking). Delta-gated — trace ONLY when the hot core changes across a real skew,
  # never every run. (Trace, not board: informational; the board alarm stays the pkg-rate one above.)
  if [ "$prev_state" != "NONE" ] && [ "$pc_avail" = 1 ] && [ "$pc_skew" = 1 ] \
     && [ "$prev_hot_core" != na ] && [ "$pc_hot_core" != "$prev_hot_core" ]; then
    trace "[cpu-hotspot-moved] $(hostname): die throttle hotspot moved core${prev_hot_core}→core${pc_hot_core} (${pc_ratio}x skew) — a different die region is now absorbing the throttle."
  fi
  mkdir -p "$(dirname "$STATE")" 2>/dev/null
  # 7th field = current hot physical core (delta-gated content above; the file itself is written
  # UNCONDITIONALLY every run so mtime==liveness, then state-touched per the liveness convention —
  # a value that legitimately holds must never read as a dead reflex).
  printf '%s %s %s %s %s %s %s\n' "$pkg" "$state" "$pkg_ms" "$dwell" "$announced" "$board_alarmed" "$pc_hot_core" > "$STATE"
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
  # seed silently on first run (no prior baseline)
  if [ "$prev_state" = "NONE" ]; then exit 0; fi
  if [ "$do_throttle_post" = 1 ]; then
    post "[cpu-throttling] $(hostname): CPU actively thermal-throttling — +$delta pkg throttle event(s) since last check (total ${pkg}, ${pkg_ms}ms). Freq ${avg_mhz}MHz (${pct}% of max). The operator channel is at risk — shed a mind / cool the box."
  elif [ "$alarm_cooldown_active" = 1 ]; then
    trace "[cpu-throttling-suppressed] $(hostname): +$delta pkg throttle event(s) (dwell $dwell/$THROTTLE_DWELL, alarm-eligible) — re-alarm within ${ALARM_COOLDOWN}s of the last posted [cpu-nominal], routed to trace (anti-oscillation); announced flag still set for recovery pairing."
  elif [ "$submagnitude" = 1 ]; then
    trace "[cpu-throttling-suppressed] $(hostname): +$delta pkg throttle event(s) (dwell $dwell/$THROTTLE_DWELL met, but below MESH_THROTTLE_MIN_DELTA=$MIN_DELTA) — sustained but sub-magnitude, routed to trace not the board (anti cry-wolf); still alarm-eligible if a later interval clears the floor."
  elif [ "$state" = THROTTLING ] && [ "$prev_state" != THROTTLING ]; then
    trace "[cpu-throttling-suppressed] $(hostname): +$delta pkg throttle event(s) (dwell $dwell/$THROTTLE_DWELL) — sub-threshold, trace only."
  elif [ "$state" = NOMINAL ] && [ "$prev_state" = THROTTLING ]; then
    # cpu-nominal recovery. Two gates so a recovery only reaches the board when it
    # PAIRS a real BOARD alarm and isn't oscillation noise:
    #  (1) board_alarmed gate: an episode that never posted [cpu-throttling] to the BOARD
    #      — sub-dwell OR trace-suppressed by the ALARM cooldown — recovers to trace only,
    #      never an unpaired '[cpu-nominal] headroom recovered' with no preceding board
    #      alarm. (prev_announced would be 1 for a cooldown-suppressed episode → leaked an
    #      orphaned board [cpu-nominal]; prev_board_alarmed is 1 only for a real board post.)
    #  (2) 30-min cooldown: halve throttle↔nominal oscillation on board-alarmed episodes.
    if [ "$prev_board_alarmed" != 1 ]; then
      trace "[cpu-nominal-suppressed] $(hostname): CPU throttling stopped (episode never board-alarmed — sub-threshold or cooldown-suppressed). Freq ${avg_mhz}MHz (${pct}% of max)."
    else
      _nom_now=$(date +%s)
      _nom_last=$(cat "$NOM_COOLDOWN" 2>/dev/null || echo 0)
      if [ $((_nom_now - _nom_last)) -lt 1800 ]; then
        trace "[cpu-nominal-suppressed] $(hostname): CPU throttling stopped — no new throttle events. Freq ${avg_mhz}MHz (${pct}% of max)."
      else
        post "[cpu-nominal] $(hostname): CPU throttling stopped — no new throttle events. Freq ${avg_mhz}MHz (${pct}% of max). Thermal headroom recovered."
        printf '%s\n' "$_nom_now" > "$NOM_COOLDOWN"
      fi
    fi
  fi
  exit 0
fi

# --- json ---------------------------------------------------------------------
if [ "${1:-}" = "--json" ]; then
  if [ "$pc_avail" = 1 ]; then
    pc_json="{"; _sep=""
    for kv in $pc_list; do k="${kv%%=*}"; k="${k#core}"; v="${kv#*=}"; pc_json="$pc_json$_sep\"$k\":$v"; _sep=","; done
    pc_json="$pc_json}"
    hotspot_j="$pc_hot_core"; ratio_j="$pc_ratio"; skew_j=$([ "$pc_skew" = 1 ] && echo true || echo false)
  else
    pc_json=null; hotspot_j=null; ratio_j=null; skew_j=false
  fi
  printf '{"package_throttle_count":%s,"package_throttle_total_ms":%s,"core_throttle_count_max":%s,"avg_freq_mhz":%s,"freq_pct_of_max":%s,"ever_throttled":%s,"per_core_throttle":%s,"hotspot_core":%s,"skew_ratio":%s,"skew":%s}\n' \
    "$pkg" "$pkg_ms" "$core_max" "$avg_mhz" "$pct" "$([ "$pkg" -gt 0 ] && echo true || echo false)" \
    "$pc_json" "$hotspot_j" "$ratio_j" "$skew_j"
  exit 0
fi

# --- one-shot human read ------------------------------------------------------
if [ "$pkg" -gt 0 ]; then
  echo "cpu-throttle: THROTTLED-SINCE-BOOT — pkg events=${pkg}, total throttled=${pkg_ms}ms, max core events=${core_max}"
else
  echo "cpu-throttle: CLEAN — never throttled since boot (pkg events=0)"
fi
echo "  freq now: ${avg_mhz}MHz (${pct}% of hardware max) across ${n} cores  [context — idle low-freq is NOT throttle]"
if [ "$pc_avail" = 1 ]; then
  echo "  per-core throttle: ${pc_list}  [physical cores, HT-siblings folded/averaged]"
  if [ "$pc_skew" = 1 ]; then
    echo "  DIE-HOTSPOT: core${pc_hot_core} eats ${pc_hot_count} vs core${pc_cold_core}=${pc_cold_count} (${pc_ratio}x skew)"
    echo "  HINT: pin sustained work OFF the hot core — 'taskset -c <cpus-of-core-${pc_cold_core}>' (coolest); keep it off core ${pc_hot_core}"
  else
    echo "  die-throttle even across cores (no hotspot skew, ${pc_ratio}x)"
  fi
else
  echo "  per-core throttle: n/a (no core_throttle_count — package-only sysfs)"
fi
echo "  (use --edge for the stateful ACTIVE-throttle reflex; --json for machines)"
exit 0
