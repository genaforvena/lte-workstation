#!/usr/bin/env bash
# orphan-ok: on-demand cellular-radio read for the Note3 body (physical-device credential lane);
#            pulled by a mind or fused on request, not scheduled — stateless stdout fold, no artifact of its own.
# mesh-note3-cellsignal — the Note3's CELLULAR RADIO signal sense (previously unsensed anywhere).
#
# The gap: the mesh watches wifi RSSI, BLE proximity, thermals, traffic — but never the
# cellular radio itself, even though the Note3 is a PHONE on a live mobile network and its
# serving-cell strength encodes radio conditions, physical movement and dead zones no other
# axis sees. Reads `dumpsys telephony.registry` over the existing adb lane (same SERIAL relay
# the netstats/netpolicy tools use) and parses mSignalStrength + mServiceState.
#
# Android 5.0 SignalStrength toString shape (positional, no keys):
#   SignalStrength: <gsmAsu 0-31|99=unknown> <gsmBer> <cdmaDbm> <cdmaEcio> <evdoDbm>
#     <evdoEcio> <evdoSnr> <lteAsu> <lteRsrp> <lteRsrq> <lteRssnr> <lteCqi> <radio...>
# A 2147483647 field or gsmAsu=99 is an UNKNOWN slot, never a measurement. Preference: a valid
# LTE RSRP wins (it is the data radio); else a valid GSM ASU converts via dBm = -113 + 2*asu.
# Levels on dBm (FALSIFIABLE via --test — move the cuts and the fixtures flip):
#   STRONG  >= -75   solid cell, full bars territory
#   FAIR    -76..-85 usable, minor degradation
#   WEAK    -86..-100 struggling, drops likely on the move
#   POOR    < -100  barely holding the cell
#
#   mesh-note3-cellsignal          one read → `status=OK radio=... asu=... dbm=... level=...`
#   mesh-note3-cellsignal --test   parser fixtures + one live adb read asserting a numeric artifact
#
# Honest-exit contract: anything that is not a numeric signal off a live adb read renders
# status=UNKNOWN with a NAMED reason (adb_unreachable|empty_capture|no_signal_line|
# malformed_signal|radio_unknown) and exits 2 — never a fabricated level. A radio whose every
# slot reads unknown is UNKNOWN, not POOR: absence of measurement is not a bad measurement.
set -uo pipefail

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"

# parse_signal_line <mSignalStrength-line> → "radio asu dbm" (rc 0) or "UNKNOWN <reason>" (rc 2).
# Pure, offline-testable: feeds on one dumpsys line, never touches adb.
parse_signal_line() {
  local line="$1" body f1 f9 radio asu dbm
  body="$(printf '%s' "$line" | sed -n 's/.*mSignalStrength=SignalStrength:[[:space:]]*//p')"
  [ -n "$body" ] || { echo "UNKNOWN no_signal_line"; return 2; }
  f1="$(printf '%s' "$body" | awk '{print $1}')"
  f9="$(printf '%s' "$body" | awk '{print $9}')"
  case "$f1:$f9" in *[!0-9:-]*|""|*:*":") echo "UNKNOWN malformed_signal"; return 2 ;; esac
  if [ "$f9" != 2147483647 ] && [ "$f9" -lt 0 ] 2>/dev/null; then
    radio=lte; asu="$f9"; dbm="$f9"
  elif [ "$f1" != 99 ] && [ "$f1" -ge 0 ] 2>/dev/null && [ "$f1" -le 31 ] 2>/dev/null; then
    radio=gsm; asu="$f1"; dbm=$(( -113 + 2 * f1 ))
  else
    echo "UNKNOWN radio_unknown"; return 2
  fi
  printf '%s %s %s\n' "$radio" "$asu" "$dbm"
}

# classify_level <dbm> → STRONG|FAIR|WEAK|POOR. Pure, offline-testable.
classify_level() {
  local dbm="$1"
  printf '%s' "$dbm" | grep -qE '^-?[0-9]+$' || { echo "UNKNOWN"; return 2; }
  if [ "$dbm" -ge -75 ]; then echo STRONG
  elif [ "$dbm" -ge -85 ]; then echo FAIR
  elif [ "$dbm" -ge -100 ]; then echo WEAK
  else echo POOR; fi
}

unknown() {
  printf 'status=UNKNOWN reason=%s radio=unknown asu=unknown dbm=unknown level=unknown\n' "${1:-unknown}"
  return 2
}

live_read() {
  local raw radio asu dbm level
  raw="$(adb -s "$SERIAL" shell 'dumpsys telephony.registry' 2>/dev/null | tr -d '\r' | grep -E 'mSignalStrength=' | head -1)"
  [ -n "$raw" ] || unknown adb_unreachable
  local parsed
  parsed="$(parse_signal_line "$raw")" || { unknown radio_unknown; }
  radio="${parsed%% *}"; asu="${parsed#* }"; asu="${asu%% *}"; dbm="${parsed##* }"
  level="$(classify_level "$dbm")" || unknown malformed_signal
  printf 'status=OK radio=%s asu=%s dbm=%s level=%s\n' "$radio" "$asu" "$dbm" "$level"
}

if [ "${1:-}" = --test ]; then
  fail=0
  chk() { [ "$2" = "$3" ] || { echo "  FAIL: $1 got=[$2] want=[$3]"; fail=1; }; }
  # GSM path: the live shape seen 2026-09-21 (asu 21 → -71 dBm → STRONG boundary-adjacent FAIR? no: -71 >= -75 → STRONG)
  chk gsm-live-shape "$(parse_signal_line 'mSignalStrength=SignalStrength: 21 99 -21 -200 -21 -200 -1 99 2147483647 2147483647 2147483647 -1 2147483647 0x4 gsm|lte')" "gsm 21 -71"
  chk gsm-strong "$(classify_level -71)" STRONG
  chk gsm-fair-lo "$(classify_level -85)" FAIR
  chk gsm-fair-hi "$(classify_level -76)" FAIR
  chk gsm-weak "$(classify_level -86)" WEAK
  chk gsm-poor "$(classify_level -101)" POOR
  chk cut-strong-boundary "$(classify_level -75)" STRONG
  chk cut-weak-boundary "$(classify_level -100)" WEAK
  # LTE path wins when RSRP is valid (field 9 negative, not the 2147483647 sentinel)
  chk lte-wins "$(parse_signal_line 'mSignalStrength=SignalStrength: 99 99 -1 -1 -1 -1 -1 99 -105 -12 30 -1 2147483647 0x4 lte')" "lte -105 -105"
  chk lte-level "$(classify_level -105)" POOR
  # Unknown slots are UNKNOWN, never a level
  parse_signal_line 'mSignalStrength=SignalStrength: 99 99 -1 -1 -1 -1 -1 99 2147483647 2147483647 2147483647 -1 2147483647 0x4 gsm|lte' >/dev/null 2>&1 \
    && { echo "  FAIL: all-unknown slots must exit 2"; fail=1; }
  parse_signal_line 'no signal here' >/dev/null 2>&1 \
    && { echo "  FAIL: missing line must exit 2"; fail=1; }
  classify_level 'abc' >/dev/null 2>&1 \
    && { echo "  FAIL: non-numeric dbm must exit 2"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # Live adb read: must yield a NUMERIC signal or an honest UNKNOWN (rc 2) — never rc 0 without numbers.
  out="$(live_read 2>/dev/null)"; rc=$?
  if [ "$rc" = 0 ]; then
    echo "$out" | grep -qE '^status=OK radio=(gsm|lte) asu=-?[0-9]+ dbm=-?[0-9]+ level=(STRONG|FAIR|WEAK|POOR)$' \
      || { echo "  FAIL: live rc=0 without numeric artifact: $out"; exit 1; }
    echo "smoke-test: ok (parser fixtures + live read: $out)"
  elif [ "$rc" = 2 ]; then
    echo "$out" | grep -qE '^status=UNKNOWN reason=[a-z_]+ ' \
      || { echo "  FAIL: rc=2 without named reason: $out"; exit 1; }
    echo "smoke-test: n/a (parser fixtures ok; live adb dark: $out)"
  else
    echo "  FAIL: live read exited $rc (expected 0 or 2)"; exit 1
  fi
  exit 0
fi

live_read
