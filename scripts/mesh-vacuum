#!/usr/bin/env bash
# orphan-ok: on-demand LIVE-ONLY miIO liveness/identity probe of the home robot vacuum (mind/fusion-
#   invoked; reads an INSTANTANEOUS reachability+identity state, no per-run cache to schedule — control
#   + telemetry are token-gated/unbuilt, so there is nothing to wire as a reflex yet). Promote to a
#   scheduled liveness/telemetry sense once the operator supplies MESH_VACUUM_TOKEN (Path B, below).
# mesh-vacuum — is the home robot vacuum's miIO daemon reachable, and who is it? (UNAUTH identity read)
#
# WHY a NEW real-world sense (verified find, discover→health→genome 2026-06-27):
#   The Xiaomi-class robot vacuum (192.168.8.127, hostname rk3308_robot32.lan — a Rockchip RK3308 robot)
#   speaks the miIO LAN protocol on UDP:54321. Its "hello" handshake — a fixed 32-byte packet — is
#   answered WITHOUT any token: the device returns its device_id plus a monotonically-ADVANCING stamp.
#   That is a real, reproducible artifact, verified THREE times by independent live reads:
#     discover 00:42 id=0x3f57547a stamp=895886 → health 00:54 896632 → genome 01:04 897371
#   (+~740 ticks each read = a LIVE counting daemon, not a cached replay). The vacuum is the ONLY
#   untapped ROVING platform on the LAN (LIDAR room-mapper + cam + mic + wheels) — this tool is its
#   reachability+identity sense, the foundation Path B (control/telemetry) extends once tokened.
#
# SCOPE (honest — claim only what produces a real artifact; the verification principle):
#   • status (default): UNAUTH miIO hello → device_id, stamp(liveness), token-exposure. SHIPPED + TESTED.
#   • control (move/clean/dock) + telemetry (LIDAR map, battery, fan, sensors): require the device
#     TOKEN. A STOCK provisioned vacuum WITHHOLDS the token from the hello (the 16-byte token field
#     reads all-0xff here) → the operator must pull it from their Xiaomi Home app / cloud account
#     (Path B — a software step, lighter than the under-dustbin serial for SSH-root Path A; and
#     path-independent of rooted-vs-stock, see memory vacuum-onboarding-s10). NOT IMPLEMENTED: shipping
#     miIO-encrypted command crypto we cannot exercise (no token) would be a HOLLOW capability claim.
#     A control verb honestly reports GATED (exit 3) until MESH_VACUUM_TOKEN is set; that env var is the
#     seam the next genome increment builds on.
#
# HONEST degradation (the no-faked-reading rule):
#   • no reply (vacuum off / off-LAN / daemon down) → EXIT 2 UNREACHABLE — never a fake ONLINE. A
#     powered-off vacuum must read visibly different from a reachable one.
#   • reply parsed → ONLINE (exit 0, a real read).
#
# Verdicts: ONLINE (exit 0, real read) | UNREACHABLE (exit 2) | GATED (exit 3 — control needs the token).
#
# FINGERPRINT (firmware/onboarding posture — discover→health VERIFIED 2026-06-27 01:30/01:41):
#   `mesh-vacuum fingerprint` re-observes (never caches — liveness is a lease) the UNAUTH signals that
#   disambiguate the two onboarding paths: the SSH:22 banner (OpenSSH ⇒ rooted/custom fw; Dropbear/
#   busybox ⇒ factory rk3308/Dreame stock) + the Valetudo web ports (:80/:8080/:4000 open ⇒ vanilla
#   rooted). Live here: banner=SSH-2.0-OpenSSH_7.6 + Valetudo-web closed ⇒ ROOTED/custom, NOT vanilla
#   Valetudo ⇒ Path A (under-dustbin serial→md5 root-pw) viable-INFERRED, Path B (miIO token) lighter.
#   All probes are identity-enum reads (TCP connect + server-hello, no login/command) — the same
#   consent boundary discover/health observed. This turns a decaying chat-prose claim into a durable,
#   re-observable organ read.
#
#   mesh-vacuum            liveness + identity (UNAUTH miIO hello)
#   mesh-vacuum status     same (explicit)
#   mesh-vacuum fingerprint firmware/onboarding posture (unauth SSH-banner + Valetudo-web reads)
#   mesh-vacuum --test     smoke test (offline packet+posture asserts + live real-read gate; exit 2 if off)
#   mesh-vacuum <verb>     control verb (find/clean/home/…) → GATED until MESH_VACUUM_TOKEN exists
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

VAC_HOST="${MESH_VACUUM_HOST:-192.168.8.127}"
VAC_PORT="${MESH_VACUUM_PORT:-54321}"
VAC_SSH_PORT="${MESH_VACUUM_SSH_PORT:-22}"
VAC_TIMEOUT="${MESH_VACUUM_TIMEOUT:-3}"
host="$(hostname 2>/dev/null || echo node)"
ts="$(date -u +%FT%TZ)"

# miIO hello: 32-byte fixed handshake — magic 0x2131, length 0x0020 (32), then 28 bytes 0xff (unknown +
# device_id + stamp + md5 checksum, all unset for a hello). Pure-python UDP (no deps, no root, headless-
# safe). Emits ONE line to stdout:
#   "ONLINE <devid_hex> <devid_dec> <stamp> <tokenfield_hex>"  on a parsed 0x2131 reply
#   "UNREACHABLE"                                              on timeout / error / malformed reply
miio_hello(){
  MV_HOST="$VAC_HOST" MV_PORT="$VAC_PORT" MV_TO="$VAC_TIMEOUT" python3 - <<'PY'
import os,socket,struct,binascii,sys
host=os.environ["MV_HOST"]; port=int(os.environ["MV_PORT"]); to=float(os.environ["MV_TO"])
hello=bytes.fromhex("21310020"+"ff"*28)        # magic+len then 28×0xff = the canonical unauth hello
assert len(hello)==32
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(to)
try:
    s.sendto(hello,(host,port)); data,_=s.recvfrom(1024)
    if len(data)<32 or data[0:2]!=b'\x21\x31':
        print("UNREACHABLE"); sys.exit(0)
    devid=struct.unpack(">I",data[8:12])[0]; stamp=struct.unpack(">I",data[12:16])[0]
    tok=binascii.hexlify(data[16:32]).decode()
    print("ONLINE 0x%08x %d %d %s"%(devid,devid,stamp,tok))
except Exception:
    print("UNREACHABLE")
finally:
    s.close()
PY
}

# interpret the 16-byte token field: stock/provisioned devices withhold it (all-ff or all-00);
# a fresh/unprovisioned device exposes the real token in the hello.
token_note(){ # $1=tokenfield hex
  case "$1" in
    ffffffffffffffffffffffffffffffff|00000000000000000000000000000000)
      echo "withheld (stock/provisioned — pull from Xiaomi Home app for control)";;
    "") echo "absent";;
    *)  echo "EXPOSED (fresh device) token=$1";;
  esac
}

# ssh_banner: read the SSH:22 greeting line (an UNAUTH identity read — TCP connect, recv the
# server-hello, close; NO login/auth attempt, consent-respected). Echoes the banner ("SSH-2.0-...")
# or "" on closed/filtered/unreachable. The banner DISAMBIGUATES firmware: OpenSSH ⇒ rooted/custom,
# Dropbear/busybox ⇒ factory rk3308/Dreame stock.
ssh_banner(){
  MV_HOST="$VAC_HOST" MV_SPORT="$VAC_SSH_PORT" MV_TO="$VAC_TIMEOUT" python3 - <<'PY'
import os,socket
h=os.environ["MV_HOST"]; p=int(os.environ["MV_SPORT"]); to=float(os.environ["MV_TO"])
try:
    s=socket.create_connection((h,p),timeout=to); s.settimeout(to)
    b=s.recv(80).decode("ascii","replace").strip(); s.close()
    print(b if b.startswith("SSH-") else "")
except Exception:
    print("")
PY
}

# valetudo_probe: is a Valetudo web UI listening? (vanilla-rooted vacuums serve :80/:8080/:4000).
# Pure TCP connect (no HTTP, no auth) → "open" if any answers, else "closed". TCP is definitive.
valetudo_probe(){
  MV_HOST="$VAC_HOST" MV_TO="$VAC_TIMEOUT" python3 - <<'PY'
import os,socket
h=os.environ["MV_HOST"]; to=min(2.0,float(os.environ["MV_TO"]))
for p in (80,8080,4000):
    try:
        socket.create_connection((h,p),timeout=to).close(); print("open"); break
    except Exception: pass
else:
    print("closed")
PY
}

# firmware_posture: classify the onboarding posture from the unauth identity reads (SSH banner +
# Valetudo web). PURE function of (banner, valetudo) → offline-testable; NEVER a faked posture (an
# unread banner ⇒ UNKNOWN, not a guess). Honest boundary (per health's 01:41 feedback): OpenSSH+no-
# Valetudo SUPPORTS 'rooted' and INFERS Path A is viable, but only a real login with the correct SN
# proves the md5 root-pw unlock — that stays operator-gated, NOT attempted (lockout-avoided).
firmware_posture(){ # $1=ssh banner ("" if unread)  $2=valetudo (open|closed)
  case "$1" in
    "")            echo "UNKNOWN — SSH:22 banner unread (closed/filtered); firmware indeterminate";;
    *[Dd]ropbear*) echo "STOCK — Dropbear/busybox (factory rk3308/Dreame); md5(under-dustbin-SN)|base64 root-pw recipe N/A → use Path B (miIO token)";;
    *OpenSSH*)
      if [ "$2" = open ]; then
        echo "VALETUDO — OpenSSH + Valetudo web up (vanilla rooted); web UI is the control path"
      else
        echo "ROOTED/custom — OpenSSH ($1), Valetudo web closed (rooted, NOT vanilla Valetudo) → Path A (under-dustbin serial→md5 root-pw) viable-INFERRED full-node [real login w/ correct SN confirms; operator-gated, not attempted]; Path B (miIO token) lighter"
      fi ;;
    *)             echo "UNKNOWN — unrecognized SSH banner '$1'";;
  esac
}

# ---------- self-test ----------
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # 1) OFFLINE packet-structure assert — the hello must be exactly the 32-byte 0x2131/len-0x0020 frame
  #    with 28 trailing 0xff. Deterministic, no network. (Falsifiable: change the builder hex → FAIL.)
  hb="$(python3 - <<'PY'
import binascii
h=bytes.fromhex("21310020"+"ff"*28)
print(binascii.hexlify(h).decode(), len(h))
PY
)"
  hexpkt="${hb% *}"; hlen="${hb#* }"
  [ "$hlen" = 32 ] || { echo "smoke-test: FAIL (hello not 32 bytes: $hlen)"; exit 1; }
  [ "$hexpkt" = "21310020ffffffffffffffffffffffffffffffffffffffffffffffffffffffff" ] \
    || { echo "smoke-test: FAIL (hello packet bytes wrong: $hexpkt)"; exit 1; }
  # token_note classifier truth table (offline)
  [ "$(token_note ffffffffffffffffffffffffffffffff)" = "withheld (stock/provisioned — pull from Xiaomi Home app for control)" ] \
    || { echo "smoke-test: FAIL (token_note ff-field not 'withheld')"; exit 1; }
  case "$(token_note 0123456789abcdef0123456789abcdef)" in EXPOSED*) : ;; *) echo "smoke-test: FAIL (token_note real-token not EXPOSED)"; exit 1;; esac
  # firmware_posture classifier truth table (offline, pure function — falsifiable: change a verdict → FAIL)
  case "$(firmware_posture 'SSH-2.0-OpenSSH_7.6' closed)"        in ROOTED*)   : ;; *) echo "smoke-test: FAIL (posture OpenSSH+no-valetudo not ROOTED)"; exit 1;; esac
  case "$(firmware_posture 'SSH-2.0-dropbear_2017.75' closed)"   in STOCK*)    : ;; *) echo "smoke-test: FAIL (posture dropbear not STOCK)"; exit 1;; esac
  case "$(firmware_posture 'SSH-2.0-OpenSSH_7.6' open)"          in VALETUDO*) : ;; *) echo "smoke-test: FAIL (posture OpenSSH+valetudo not VALETUDO)"; exit 1;; esac
  case "$(firmware_posture '' closed)"                           in UNKNOWN*)  : ;; *) echo "smoke-test: FAIL (posture empty-banner not UNKNOWN)"; exit 1;; esac
  # 2) REAL-READ gate (doctrine: --test must assert a LIVE read yields data, not just the offline
  #    classifier). Send the unauth hello to the real vacuum. If it answers → assert device_id parses
  #    nonzero + a stamp is present (a genuine miIO frame). If it does NOT answer (vacuum off / off-LAN)
  #    the organ is honestly UNREACHABLE → exit 2 (mesh-land treats exit 2 as a pass — the real-read gate
  #    requires the hardware without blocking landing), never a fake green.
  line="$(miio_hello)"
  case "$line" in
    ONLINE\ *)
      set -- $line   # ONLINE <hex> <dec> <stamp> <tokfield>
      [ "$3" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL (live reply but device_id not >0: $line)"; exit 1; }
      [ -n "$4" ] && [ "$4" -ge 0 ] 2>/dev/null || { echo "smoke-test: FAIL (live reply but no numeric stamp: $line)"; exit 1; }
      echo "smoke-test: ok (offline packet/classifier asserts + LIVE miIO read: device_id=$2 stamp=$4)"
      exit 0 ;;
    *)
      echo "smoke-test: n/a (vacuum at $VAC_HOST:$VAC_PORT did not answer the miIO hello — UNREACHABLE, honest; powered off / off-LAN)"; exit 2 ;;
  esac
fi

# ---------- control verbs (GATED — token not yet available) ----------
case "${1:-status}" in
  status|"" ) : ;;  # fall through to the liveness read
  -h|--help )
    echo "usage: mesh-vacuum [status|fingerprint|--test|<control-verb>]"
    echo "  status (default)  UNAUTH miIO liveness+identity read"
    echo "  fingerprint       firmware/onboarding posture (unauth SSH-banner + Valetudo-web reads)"
    echo "  <verb>            find/clean/home/… → GATED until MESH_VACUUM_TOKEN is set (Path B)"
    exit 0 ;;
  fingerprint|paths|onboard )
    # onboarding-posture read: re-observe (never cache — liveness is a lease) the firmware signal that
    # disambiguates the onboarding paths. UNAUTH identity reads only (miIO hello + SSH banner + Valetudo
    # TCP) — NO login/command attempted, consent-respected. Wires discover→health's 01:30/01:41 VERIFIED
    # find (SSH=OpenSSH ⇒ rooted, Valetudo-web closed) into a live organ read, not a decaying chat claim.
    mline="$(miio_hello)"; ban="$(ssh_banner)"; val="$(valetudo_probe)"
    case "$mline" in ONLINE\ *) set -- $mline; miio="up device_id=$2 stamp=$4";; *) miio="no-reply";; esac
    if [ "$miio" = no-reply ] && [ -z "$ban" ]; then
      echo "[vacuum] UNREACHABLE — neither miIO ($VAC_HOST:$VAC_PORT) nor SSH ($VAC_HOST:$VAC_SSH_PORT) answered (vacuum off / off-LAN) @ $host $ts"
      exit 2
    fi
    echo "[vacuum] FINGERPRINT @ $VAC_HOST · miIO=$miio · ssh=${ban:-closed} · valetudo-web=$val"
    echo "         firmware: $(firmware_posture "$ban" "$val")"
    echo "         @ $host $ts"
    exit 0 ;;
  * )
    verb="$1"
    if [ -z "${MESH_VACUUM_TOKEN:-}" ]; then
      echo "[vacuum] GATED — control verb '$verb' needs the device TOKEN. Set MESH_VACUUM_TOKEN (Path B:"
      echo "         the operator's Xiaomi Home app / cloud account). miIO-encrypted command crypto is"
      echo "         NOT yet implemented — shipping it untested (no token to verify) would be a hollow"
      echo "         claim. This is the seam the next genome increment extends. @ $host $ts"
      exit 3
    fi
    echo "[vacuum] GATED — MESH_VACUUM_TOKEN is set, but encrypted miIO command send is not yet built"
    echo "         (intentionally deferred until it can be verified against a live tokened device). @ $host $ts"
    exit 3 ;;
esac

# ---------- liveness + identity (UNAUTH) ----------
line="$(miio_hello)"
case "$line" in
  ONLINE\ * )
    set -- $line   # ONLINE <hex> <dec> <stamp> <tokfield>
    devhex="$2"; stamp="$4"; tokf="$5"
    echo "[vacuum] ONLINE — miIO daemon up @ $VAC_HOST:$VAC_PORT · device_id=$devhex stamp=$stamp (live-counting) · token=$(token_note "$tokf") · control=GATED (set MESH_VACUUM_TOKEN) @ $host $ts"
    exit 0 ;;
  * )
    echo "[vacuum] UNREACHABLE — no miIO reply @ $VAC_HOST:$VAC_PORT (vacuum off / off-LAN / daemon down) @ $host $ts"
    exit 2 ;;
esac
