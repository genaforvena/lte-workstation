#!/usr/bin/env python3
"""mesh-voice-rx — the mesh HEARS the operator over Telegram. Receives the operator's messages
(TEXT and VOICE) via the bot's getUpdates, downloads voice notes
and transcribes them with whisper, and writes everything as text into the voice channel
(~/.mesh/voice-in.log). Operator-only (CHAT_ID); strangers are logged, never answered.
smoke-test: --test checks BOT_TOKEN + CHAT_ID presence

  mesh-voice-rx           poll loop -> append to ~/.mesh/voice-in.log
  mesh-voice-rx --once    one poll cycle (for testing)
  mesh-voice-rx --test    smoke test
"""
import fcntl, os, re, sys, json, time, subprocess, urllib.request, urllib.parse, urllib.error
from datetime import datetime, timezone
from pathlib import Path

# urllib.request does not support SOCKS proxies and will crash if socks5h:// is in env
for env_var in ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"]:
    if env_var in os.environ and os.environ[env_var].startswith("socks"):
        del os.environ[env_var]

HOME = Path.home(); MESH = HOME / ".mesh"; MESH.mkdir(exist_ok=True)
LOG = MESH / "voice-in.log"; OFFSET_F = MESH / ".tg-offset"; STRANGERS = MESH / "tg-strangers.log"
PROCESSED_F = MESH / ".tg-processed"
OPERATOR_FYI_LOG = Path(os.environ.get("MESH_OPERATOR_FYI_LOG", str(MESH / "operator-fyi.log")))
LOCK_F = Path(os.environ.get("MESH_VOICE_RX_LOCK", str(MESH / ".voice-rx.lock")))
_LOCK_FH = None
SCRUB_CMD = os.environ.get("MESH_LOG_SCRUB_CMD", "mesh-log-scrub")

# Route through mesh-whisper-run (nice+ionice+flock shim, drop-in args) so a voice-note burst can't
# stack whisper RSS on top of a concurrent overhear/transcribe run — the 2026-07-05 20:05-20:12Z OOM
# batch was unserialized whisper jobs racing. Raw binary where the shim isn't deployed.
_WSHIM = HOME / ".local/bin/mesh-whisper-run"
WHISPER = _WSHIM if _WSHIM.exists() else MESH / "whispercpp" / "main"
def _model_override():
    # node-local fast-model override: a thermally-throttled node (large-v3-turbo = ~150s for a 17s
    # note here, OVER the timeout → every voice note wedged the queue) prefers ggml-base (~5s, meaning
    # preserved) for real-time latency. Set MESH_WHISPER_MODEL=ggml-base.bin in env or os.environ.
    v = os.environ.get("MESH_WHISPER_MODEL")
    if not v:
        f = HOME / ".config/remote-access/env"
        if f.exists():
            for ln in f.read_text().splitlines():
                ln = ln.strip()
                if ln.startswith("MESH_WHISPER_MODEL="):
                    v = ln.partition("=")[2].strip()
    return v

def _best_model():
    md = MESH / "whispercpp" / "models"
    ov = _model_override()
    if ov:
        p = md / ov
        if p.exists() and p.stat().st_size > 50_000_000:
            return p
    for name in ("ggml-large-v3-turbo.bin", "ggml-large-v3.bin", "ggml-medium.bin", "ggml-base.bin"):
        p = md / name
        if p.exists() and p.stat().st_size > 50_000_000:  # skip the tiny for-tests stubs
            return p
    return md / "ggml-base.bin"
MODEL = _best_model()   # node-local override (slow nodes), else prefer a bigger/better model (Russian quality)

def env():
    e = {}
    f = HOME / ".config/remote-access/env"
    if f.exists():
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if "=" in ln and not ln.startswith("#"):
                k, _, v = ln.partition("="); e[k.strip()] = v.strip()
    return e
E = env()
TOKEN = os.environ.get("BOT_TOKEN") or E.get("BOT_TOKEN", "")
OWNER = int(os.environ.get("CHAT_ID") or E.get("CHAT_ID", "0"))
API = f"https://api.telegram.org/bot{TOKEN}"
FILEAPI = f"https://api.telegram.org/file/bot{TOKEN}"

if len(sys.argv) > 1 and sys.argv[1] == '--test':
    import shutil
    fails = []
    def _t(ok, msg):
        if not ok: fails.append(msg)

    # 1) deps
    _t(shutil.which("python3"), "no python3")
    _t(shutil.which("ffmpeg") or FFMPEG, "no ffmpeg")
    _t(WHISPER.exists(), f"no whisper.cpp at {WHISPER}")

    # 2) env
    _t(TOKEN, "BOT_TOKEN missing")
    _t(OWNER, "CHAT_ID missing")

    # 3) Telegram getMe — proves token is valid + API reachable
    if TOKEN:
        try:
            url = f"https://api.telegram.org/bot{TOKEN}/getMe"
            with urllib.request.urlopen(url, timeout=15) as r:
                resp = json.load(r)
            _t(resp.get("ok"), f"getMe failed: {resp.get('description','?')}")
            _t(resp.get("result", {}).get("is_bot"), "getMe result is not a bot")
        except Exception as e:
            _t(False, f"getMe exception: {e}")

    # 4) voice-in.log writable
    _t(LOG.parent.exists() and os.access(LOG.parent, os.W_OK), f"~/.mesh not writable")

    if fails:
        print("smoke-test: FAIL (" + "; ".join(fails) + ")", flush=True); sys.exit(1)
    print("smoke-test: ok", flush=True); sys.exit(0)

def acquire_instance_lock():
    """Hold one poller per node; a competing launch exits without noise."""
    global _LOCK_FH
    _LOCK_FH = open(LOCK_F, "a+")
    try:
        fcntl.flock(_LOCK_FH.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        _LOCK_FH.close()
        _LOCK_FH = None
        return False
    return True

# Reject a competing poller before opening logs or spawning the scrubber. Focused unit-style tests do
# not poll Telegram, so they may run beside the live receiver.
_NO_POLL_TEST = len(sys.argv) > 1 and sys.argv[1] in ('--test-operator-fyi-routing', '--test-image-routing')
if not _NO_POLL_TEST and not acquire_instance_lock():
    sys.exit(0)

# persistent pipe to log scrubber — all log writes go through it; fail-safe: if scrub missing, write raw + warn
import shutil
_SCRUB_AVAIL = shutil.which(SCRUB_CMD) is not None
_LOG_FH = open(LOG, "a")
if _SCRUB_AVAIL:
    _SCRUB = subprocess.Popen(
        [SCRUB_CMD],
        stdin=subprocess.PIPE, stdout=_LOG_FH, text=True, bufsize=1,
    )
else:
    print(f"WARN: {SCRUB_CMD} not found — appending raw to voice-in.log", file=sys.stderr)
    _SCRUB = None

def ffmpeg_bin():
    # MUST decode OGG/Opus (Telegram voice). imageio-ffmpeg ships a full build with libopus;
    # the playwright bundled ffmpeg does NOT have an opus decoder, so it is avoided.
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        pass
    import shutil
    return shutil.which("ffmpeg") or "ffmpeg"
FFMPEG = ffmpeg_bin()

def get(method, **params):
    url = f"{API}/{method}"
    if params: url += "?" + urllib.parse.urlencode(params)
    try:
        with urllib.request.urlopen(url, timeout=40) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        # Telegram sends its real error as JSON in the 4xx body (e.g. getFile on a >20MB file →
        # 400 'file is too big'). Raising here made handle() drop the whole update with only a
        # stderr line — the 2026-07-06 jam-track loss. Return the parsed error so callers see
        # ok:false + description and can tell the operator WHY.
        try:
            return json.load(e)
        except Exception:
            return {"ok": False, "description": f"HTTP {e.code}"}

# Full ISO-8601 (date+time), not %H:%M:%SZ — voice-in.log/strangers.log are never rotated, so a
# time-only stamp made cross-day entries indistinguishable: yesterday's 23:06Z sat among today's
# 18:55Z looking "out of order / future-of-now", which made operator-message loss-detection
# impossible (the 2026-06-13 409 lifeline adjudication couldn't tell what arrived "today since X").
# Matches the board/trace ISO convention; consumers (mesh-dash tails+displays) are format-agnostic.
def ts(): return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def _raw_write(line):
    _LOG_FH.write(line + "\n")
    _LOG_FH.flush()

def write(kind, text):
    global _SCRUB
    line = f"{ts()}  {kind}  {text}".rstrip()
    if _SCRUB is not None:
        try:
            if _SCRUB.poll() is not None:
                raise BrokenPipeError(f"{SCRUB_CMD} exited early")
            _SCRUB.stdin.write(line + "\n")
            _SCRUB.stdin.flush()
        except (BrokenPipeError, OSError, ValueError) as e:
            print(f"WARN: {SCRUB_CMD} failed — appending raw to voice-in.log", file=sys.stderr)
            _SCRUB = None
            _raw_write(line)
    else:
        _raw_write(line)
    print(line, flush=True)

def _processed_keys():
    try:
        return set(PROCESSED_F.read_text().splitlines()[-2000:])
    except Exception:
        return set()

def _mark_processed(*keys):
    keys = [k for k in keys if k]
    if not keys:
        return
    try:
        with open(PROCESSED_F, "a") as f:
            for key in keys:
                f.write(key + "\n")
    except Exception:
        pass

def update_key(update):
    uid = update.get("update_id")
    return f"u:{uid}" if uid is not None else ""

def message_key(update):
    msg = update.get("message") or update.get("edited_message") or {}
    chat_id = (msg.get("chat") or {}).get("id")
    mid = msg.get("message_id")
    if chat_id is None or mid is None:
        return ""
    kind = "edit" if update.get("edited_message") else "msg"
    return f"m:{chat_id}:{mid}:{kind}"

def already_processed(update):
    keys = _processed_keys()
    return update_key(update) in keys or message_key(update) in keys

def kick_feed():
    """Event-driven feed: the moment an operator message lands, push it to the tg mind pane NOW
    instead of waiting for the */1 mesh-channel-tg cron (up to 60s of "почему не сразу"). Detached +
    best-effort so a slow feed never stalls the poll loop; the */1 cron stays as a backstop and the
    feed itself is flock-serialized, so the cron and this kick can't double-inject the same line."""
    try:
        ctg = os.path.expanduser("~/.local/bin/mesh-channel-tg")
        if os.path.exists(ctg):
            subprocess.Popen([ctg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
    except Exception:
        pass

TYPING = Path(os.environ.get("MESH_TG_TYPING", os.path.expanduser("~/.local/bin/mesh-tg-typing")))

def typing_start():
    """Start the operator typing loop best-effort; no-op if helper is absent."""
    try:
        if OWNER == 51010427 and TYPING.exists():
            subprocess.Popen([str(TYPING), "--start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass

def post_to_board(text):
    """Record the operator's message as FYI CONTEXT ONLY — NOT a board directive.
    History (2026-06-18 fix): the old version told the board "reply to the operator via mesh-tg,
    ONE taker" — but the vision-less opencode minds (genome/chat) don't coordinate; they EACH fired a
    reply and confabulated "can't read image / no OCR" on the operator's screenshots, flooding his
    trust-critical channel with junk in my (the tg mind's) name. Doctrine is operator comms = the tg
    mind ONLY (kick_feed feeds it directly; mesh-tg-reply-watch backstops silence).

    2026-06-20 board-hygiene: even non-actionable [operator-fyi] lines wake every coordination reader
    and bury cross-mind signal. Keep the forensic/context trail in a dedicated tg relay log instead of
    shared chat.log; the tg mind still receives the live message via voice-in.log -> mesh-channel-tg."""
    try:
        OPERATOR_FYI_LOG.parent.mkdir(parents=True, exist_ok=True)
        snippet = " ".join(text.split())[:300]
        with open(OPERATOR_FYI_LOG, "a") as f:
            f.write(f"{ts()}  operator-fyi  {snippet}\n")
    except Exception:
        pass

if len(sys.argv) > 1 and sys.argv[1] == '--test-operator-fyi-routing':
    before = OPERATOR_FYI_LOG.read_text() if OPERATOR_FYI_LOG.exists() else ""
    post_to_board("hello from operator")
    after = OPERATOR_FYI_LOG.read_text() if OPERATOR_FYI_LOG.exists() else ""
    if after == before or "hello from operator" not in after:
        print("smoke-test: FAIL (operator-fyi not written to dedicated log)", flush=True)
        sys.exit(1)
    print("smoke-test: ok (operator-fyi writes dedicated log, not mesh-chat)", flush=True)
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] == '--test-write':
    write("TEXT", os.environ.get("MESH_VOICE_RX_TEST_LINE", "smoke-write"))
    print("smoke-write: ok", flush=True)
    sys.exit(0)

def _image_intro(kind, dest, caption):
    """Build the voice-in.log line for an inbound operator IMAGE/FILE — a directive the (vision-capable
    claude) tg mind can act on: it NAMES the saved path to Read and PRESERVES any caption (the operator's
    text sent with the image, previously dropped). Pure (no I/O) so it is testable without firing the
    real Telegram download or kick_feed. (fix 2026-06-20: images were saved to inbox but never routed/
    kick_fed → silently dropped; 'как обычно ты пропустил'.)"""
    if kind == "audio":
        line = (f"operator sent an audio file -> {dest} — this is an AUDIO SOURCE (music/recording, "
                f"not readable text); reply to the operator and use the file as he asks")
    else:
        line = f"operator sent an {kind} -> {dest} — Read this path to see it, then reply to the operator"
    caption = (caption or "").strip()
    if caption:
        line += f" | caption: {caption}"
    return line

def _music_only(txt):
    """True when a whisper transcript carries NO speech — only annotations like '(upbeat music)',
    '[музыка]', '♪'. Pure (no I/O) so it is testable offline. Conservative: any residual word
    outside brackets means speech, keep the normal STT path."""
    if not txt or txt.startswith("[voice:"):
        return False
    residue = re.sub(r"[\(\[][^)\]]{0,80}[\)\]]|[♪♫]", " ", txt)
    return re.sub(r"[\s\.,!\?\-–—…]+", "", residue) == ""

if len(sys.argv) > 1 and sys.argv[1] == '--test-image-routing':
    ok = True
    a = _image_intro("image", "/home/x/.mesh/inbox/photo-ab12cd34.jpg", "вот скрин")
    if "/home/x/.mesh/inbox/photo-ab12cd34.jpg" not in a:
        print("smoke-test: FAIL (saved path not in image line)"); ok = False
    elif "Read this path" not in a:
        print("smoke-test: FAIL (no Read-it directive for the vision mind)"); ok = False
    elif "caption: вот скрин" not in a:
        print("smoke-test: FAIL (caption dropped — operator's text lost)"); ok = False
    b = _image_intro("file", "/tmp/doc.pdf", None)
    if ok and ("caption:" in b or "/tmp/doc.pdf" not in b):
        print("smoke-test: FAIL (no-caption file line wrong)"); ok = False
    c = _image_intro("audio", "/home/x/.mesh/inbox/jam1.aac", "сделай grainneukeln")
    if ok and ("/home/x/.mesh/inbox/jam1.aac" not in c or "AUDIO SOURCE" not in c
               or "caption: сделай grainneukeln" not in c):
        print("smoke-test: FAIL (audio line lacks path/AUDIO-SOURCE directive/caption)"); ok = False
    if ok and not _music_only("(upbeat music) (upbeat music) (music) ..."):
        print("smoke-test: FAIL (pure music-annotation transcript not detected)"); ok = False
    if ok and _music_only("(музыка) ну вот такой трек, сделайте вариации"):
        print("smoke-test: FAIL (real speech misclassified as music-only)"); ok = False
    if ok and _music_only("[voice: transcription timed out (>240s)]"):
        print("smoke-test: FAIL (error placeholder misclassified as music-only)"); ok = False
    print("smoke-test: ok (image/file/audio lines + music-only voice-note detection)" if ok
          else "smoke-test: FAILED")
    sys.exit(0 if ok else 1)

WHISPER_FILTER = os.path.expanduser("~/.local/bin/mesh-whisper-filter")
def clean_transcript(txt):
    """Strip whisper hallucination TAILS (subtitle credits 'Редактор субтитров…', [музыка]) off
    real speech before it's logged/boarded/fed to the tg mind — chat-review 2026-06-19: these get
    treated as operator content (a named entity 'А.Семкин' he never said). Reuses the patterns in
    mesh-whisper-filter --strip (one source of truth). CONSERVATIVE: on any failure, or if stripping
    would BLANK otherwise-real speech, keep the original — never lose operator content."""
    if not txt or txt.startswith("[voice:"):
        return txt
    try:
        out = subprocess.run([WHISPER_FILTER, "--strip", "--text", txt],
                             capture_output=True, text=True, timeout=10)
        cleaned = out.stdout.strip()
        return cleaned if cleaned else txt
    except Exception:
        return txt

def _groq_key():
    """GROQ_API_KEY from ~/.mesh/groq.env (gitignored, never the genome). Returns '' if absent."""
    f = MESH / "groq.env"
    if not f.exists():
        return ""
    try:
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if ln.startswith("GROQ_API_KEY="):
                return ln.partition("=")[2].strip().strip('"').strip("'")
    except OSError:
        pass
    return ""

def groq_stt(wav):
    """CLOUD fallback STT when local whisper.cpp can't run (admission-refused under memory pressure →
    empty stdout, which used to surface as a FAKE '[voice: empty transcript]'; honest-fusion 2026-07-07).
    Groq hosts whisper-large-v3-turbo and needs ZERO local RAM, so voice survives an OOM-pressured node.
    Returns the transcript text, or None on any failure (no key / network / API error / truly empty)."""
    key = _groq_key()
    if not key or not wav.exists():
        return None
    try:
        data = wav.read_bytes()
    except OSError:
        return None
    boundary = "----meshvoicerx" + str(len(data))
    model = os.environ.get("MESH_GROQ_STT_MODEL", "whisper-large-v3-turbo")
    parts = []
    def _field(name, value):
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode())
    _field("model", model)
    _field("response_format", "text")
    parts.append((f'--{boundary}\r\nContent-Disposition: form-data; name="file"; '
                  f'filename="voice.wav"\r\nContent-Type: audio/wav\r\n\r\n').encode())
    parts.append(data)
    parts.append(f"\r\n--{boundary}--\r\n".encode())
    body = b"".join(parts)
    req = urllib.request.Request(
        "https://api.groq.com/openai/v1/audio/transcriptions", data=body,
        headers={"Authorization": f"Bearer {key}",
                 "Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            txt = r.read().decode("utf-8", "replace").strip()
        return txt or None
    except Exception as e:
        print(f"[voice-rx] groq_stt failed: {str(e)[:80]}", file=sys.stderr)
        return None

def transcribe(file_id):
    info = get("getFile", file_id=file_id)
    path = info.get("result", {}).get("file_path")
    if not path: return "[voice: getFile failed]"
    oga = MESH / "voice-in.oga"; wav = MESH / "voice-in.wav"
    urllib.request.urlretrieve(f"{FILEAPI}/{path}", oga)
    subprocess.run([FFMPEG, "-y", "-i", str(oga), "-ar", "16000", "-ac", "1", str(wav)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wav.exists(): return "[voice: ffmpeg failed]"
    local_admit_refused = False; local_timed_out = False
    try:
        out = subprocess.run([str(WHISPER), "-m", str(MODEL), "-f", str(wav), "-nt", "-l", "auto"],
                             capture_output=True, text=True, timeout=240)
        # rc 75 = the whisper-run admission gate REFUSED (node too memory-pressured to run the ~2GB
        # job) → stdout is empty but the audio was NEVER transcribed. Do NOT surface that as an
        # "empty transcript" (a FAKE — the operator DID speak). Fall through to the cloud fallback.
        local_admit_refused = (out.returncode == 75)
        txt = clean_transcript(" ".join(out.stdout.split()).strip())
    except subprocess.TimeoutExpired:
        # CRITICAL: never let a slow transcription RAISE — it would propagate to poll_once and stop
        # the offset advancing, wedging the WHOLE inbound queue on one note. Fall through to cloud.
        local_timed_out = True; txt = ""
    except Exception as e:
        print(f"[voice-rx] local whisper error: {str(e)[:80]}", file=sys.stderr)
        txt = ""
    # CLOUD FALLBACK: local whisper produced nothing (admission-refused under memory pressure, timed
    # out, or errored). Groq STT needs zero local RAM, so voice survives an OOM-pressured node instead
    # of the mesh going silently deaf. Only reached when local yields empty — a real local transcript
    # is authoritative and never overridden. (honest-fusion, 2026-07-07 empty-transcript incident.)
    if not txt:
        cloud = groq_stt(wav)
        if cloud:
            txt = clean_transcript(" ".join(cloud.split()).strip())
    # prosody hook: read HOW the operator sounds (energy/rate/pitch) off the SAME decoded wav for
    # mesh-operator-mood's arousal co-primary — best-effort, never let it delay/raise into the poll
    # loop (short note → <1s; capped anyway). Operator-only (this path is already CHAT_ID-gated); the
    # tool persists only derived scalars, never the audio (local-only, within granted mood consent).
    try:
        subprocess.run([os.path.expanduser("~/.local/bin/mesh-voice-prosody"), str(wav)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except Exception:
        pass
    if _music_only(txt):
        # the transcript is ONLY non-speech annotations — the audio itself is the payload (operator
        # recorded music as a voice note). Save the original opus instead of discarding it.
        inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
        dest = inbox / f"voice-music-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}.oga"
        try:
            oga.replace(dest)
            txt = (f"operator sent a voice note that is MUSIC, not speech (transcript was only music "
                   f"annotations) — saved to {dest}; if he asked for remixes/processing, use this file "
                   f"as the source, and reply to the operator")
        except OSError:
            pass
    for p in (oga, wav):
        try: p.unlink()
        except OSError: pass
    if txt:
        return txt
    # Still empty after local + cloud. Be HONEST about WHY: an admission-refused local run means the
    # operator spoke but the node was too loaded to transcribe and the cloud fallback also failed —
    # tell them to resend as text, never fake a content-free "empty transcript" that reads as "he sent
    # nothing" (the 2026-07-07 incident: 4 real notes surfaced as blanks → operator "Mesh, wtf?!").
    if local_admit_refused:
        return ("[voice: node too memory-pressured to transcribe and cloud STT unavailable — "
                "your note was NOT empty; please resend as text if urgent]")
    if local_timed_out:
        return ("[voice: transcription timed out (node under load) and cloud STT unavailable — "
                "your note was NOT empty; please resend as text if urgent]")
    return "[voice: empty transcript]"

def handle(update):
    msg = update.get("message") or update.get("edited_message")
    if not msg: return
    frm = (msg.get("from") or {}).get("id")
    if frm != OWNER:
        with open(STRANGERS, "a") as f:
            f.write(f"{ts()}  from={frm}  {json.dumps(msg.get('text') or '[non-text]')[:120]}\n")
        return
    if msg.get("voice"):
        # voice NOTES only — TG "audio" (music files) must NOT ride the STT path: it used to be
        # transcribed to "(upbeat music)…" garbage and the file DELETED (2026-07-06: operator's 3
        # jam tracks lost — 1 garbled, 2 silently dropped). Audio routes to the inbox branch below.
        fid = msg["voice"]["file_id"]
        txt = transcribe(fid)
        write("VOICE", txt)
        typing_start(); kick_feed(); post_to_board(txt)
    elif msg.get("text"):
        write("TEXT", msg["text"])
        typing_start(); kick_feed(); post_to_board(msg["text"])
    elif msg.get("photo") or msg.get("document") or msg.get("audio"):
        # operator screenshots/files → download into ~/.mesh/inbox AND route to the tg mind exactly like
        # text/voice (typing_start + kick_feed + post_to_board) so a VISION-CAPABLE mind Reads + replies,
        # instead of silently saving. Routing is tg-mind-ONLY (kick_feed pokes its pane; post_to_board
        # writes the dedicated OPERATOR_FYI_LOG, never chat.log) — preserving the 2026-06-18 doctrine that
        # kept vision-less opencode minds from confabulating on the operator's screenshots. Every outcome
        # (saved / download-failed / getFile-failed) routes, so the operator never gets silence.
        is_photo = bool(msg.get("photo"))
        if is_photo:
            doc = max(msg["photo"], key=lambda p: p.get("file_size") or 0)  # largest rendition
            name = f"photo-{doc['file_id'][:8]}.jpg"
            kind = "image"
        elif msg.get("audio"):
            doc = msg["audio"]
            name = (doc.get("file_name") or f"audio-{doc['file_id'][:8]}.oga").replace("/", "_").replace("..", "_")
            kind = "audio"
        else:
            doc = msg["document"]
            name = (doc.get("file_name") or f"file-{doc['file_id'][:8]}").replace("/", "_").replace("..", "_")
            kind = "file"
        info = get("getFile", file_id=doc["file_id"])
        path = info.get("result", {}).get("file_path")
        err = (info.get("description") or "").lower()
        if path:
            inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
            dest = inbox / name
            try:
                urllib.request.urlretrieve(f"{FILEAPI}/{path}", dest)
                line = _image_intro(kind, dest, msg.get("caption"))
            except Exception as e:
                line = f"operator sent an {kind} but the download FAILED ({e}) — tell the operator it didn't arrive and ask him to resend"
        elif "too big" in err:
            # Bot API hard cap: getFile refuses files >20MB — resending the SAME file can never work
            line = (f"operator sent an {kind} ({name}) that is OVER Telegram's 20MB bot download limit — "
                    f"tell the operator resending won't help; ask him to split it or compress it under 20MB")
        else:
            line = f"operator sent an {kind} but getFile FAILED ({name}: {err or 'no file_path'}) — tell the operator it couldn't be fetched and ask him to resend"
        write("DOCUMENT", line)
        typing_start(); kick_feed(); post_to_board(line)
    else:
        write("MSG", "[non-text/voice message]")

def poll_once(offset):
    data = get("getUpdates", timeout=25, offset=offset)
    if not data.get("ok"):
        print(f"[rx] getUpdates not ok: {data.get('description')}", file=sys.stderr); return offset
    for up in data.get("result", []):
        # ALWAYS advance the offset, even if handle() throws — a single un-handleable update
        # (bad voice note, download error, anything) must NOT wedge the entire inbound queue.
        try:
            if not already_processed(up):
                handle(up)
                _mark_processed(update_key(up), message_key(up))
        except Exception as e:
            print(f"[rx] handle failed for update {up.get('update_id')}: {e}", file=sys.stderr)
        offset = up["update_id"] + 1
        OFFSET_F.write_text(str(offset))
    return offset

def main():
    if not TOKEN or not OWNER: sys.exit("BOT_TOKEN/CHAT_ID not set")
    offset = int(OFFSET_F.read_text()) if OFFSET_F.exists() else 0
    once = "--once" in sys.argv
    print(f"[mesh-voice-rx] listening (owner={OWNER}) -> {LOG}", flush=True)
    import urllib.error
    backoff = 0   # 409 = another getUpdates consumer owns this bot (historically proxy-bot.service on
                  # default-string — retired 2026-06-13 after it silently ate operator messages).
                  # Telegram allows ONE poller per token, so persistent 409 means a competing poller is
                  # live SOMEWHERE on the mesh — hunt it down, don't just back off. DON'T hammer (was
                  # retrying every 3s, spamming 409): exponential backoff, reset on a clean poll.
    while True:
        try:
            offset = poll_once(offset); backoff = 0
        except urllib.error.HTTPError as e:
            if e.code == 409:
                backoff = min((backoff or 1) * 2, 120)
                print(f"[rx] 409 Conflict — another poller owns this bot; yielding {backoff}s", file=sys.stderr)
                time.sleep(backoff)
            else:
                print(f"[rx] HTTP {e.code}", file=sys.stderr); time.sleep(3)
        except Exception as e:
            print(f"[rx] {e}", file=sys.stderr); time.sleep(3)
        if once: break

if __name__ == "__main__":
    main()
