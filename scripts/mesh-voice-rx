#!/usr/bin/env python3
"""mesh-voice-rx — the mesh HEARS the operator over Telegram. Receives the operator's messages
(TEXT and VOICE) via the bot's getUpdates (proxy-bot retired -> token free), downloads voice notes
and transcribes them with whisper, and writes everything as text into the voice channel
(~/.mesh/voice-in.log). Operator-only (CHAT_ID); strangers are logged, never answered.

  mesh-voice-rx           poll loop -> append to ~/.mesh/voice-in.log
  mesh-voice-rx --once    one poll cycle (for testing)
"""
import os, sys, json, time, subprocess, urllib.request, urllib.parse
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home(); MESH = HOME / ".mesh"; MESH.mkdir(exist_ok=True)
LOG = MESH / "voice-in.log"; OFFSET_F = MESH / ".tg-offset"; STRANGERS = MESH / "tg-strangers.log"
WHISPER = MESH / "whispercpp" / "main"
MODEL = MESH / "whispercpp" / "models" / "ggml-base.bin"   # real 147MB model (NOT the for-tests stubs)

def env():
    e = {}
    f = HOME / ".config/remote-access/env"
    if f.exists():
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if "=" in ln and not ln.startswith("#"):
                k, _, v = ln.partition("="); e[k.strip()] = v.strip()
    return e
E = env()
TOKEN = os.environ.get("BOT_TOKEN") or E.get("BOT_TOKEN", "")
OWNER = int(os.environ.get("CHAT_ID") or E.get("CHAT_ID", "0"))
API = f"https://api.telegram.org/bot{TOKEN}"
FILEAPI = f"https://api.telegram.org/file/bot{TOKEN}"

def ffmpeg_bin():
    import glob
    g = sorted(glob.glob(str(HOME / ".cache/ms-playwright/ffmpeg-*/ffmpeg-linux")))
    return g[-1] if g else "ffmpeg"
FFMPEG = ffmpeg_bin()

def get(method, **params):
    url = f"{API}/{method}"
    if params: url += "?" + urllib.parse.urlencode(params)
    with urllib.request.urlopen(url, timeout=40) as r:
        return json.load(r)

def ts(): return datetime.now(timezone.utc).strftime("%H:%M:%SZ")
def write(kind, text):
    line = f"{ts()}  {kind}  {text}".rstrip()
    with open(LOG, "a") as f: f.write(line + "\n")
    print(line, flush=True)

def transcribe(file_id):
    info = get("getFile", file_id=file_id)
    path = info.get("result", {}).get("file_path")
    if not path: return "[voice: getFile failed]"
    oga = MESH / "voice-in.oga"; wav = MESH / "voice-in.wav"
    urllib.request.urlretrieve(f"{FILEAPI}/{path}", oga)
    subprocess.run([FFMPEG, "-y", "-i", str(oga), "-ar", "16000", "-ac", "1", str(wav)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wav.exists(): return "[voice: ffmpeg failed]"
    out = subprocess.run([str(WHISPER), "-m", str(MODEL), "-f", str(wav), "-nt", "-l", "auto"],
                         capture_output=True, text=True, timeout=120)
    txt = " ".join(out.stdout.split()).strip()
    for p in (oga, wav):
        try: p.unlink()
        except OSError: pass
    return txt or "[voice: empty transcript]"

def handle(update):
    msg = update.get("message") or update.get("edited_message")
    if not msg: return
    frm = (msg.get("from") or {}).get("id")
    if frm != OWNER:
        with open(STRANGERS, "a") as f:
            f.write(f"{ts()}  from={frm}  {json.dumps(msg.get('text') or '[non-text]')[:120]}\n")
        return
    if msg.get("voice") or msg.get("audio"):
        fid = (msg.get("voice") or msg.get("audio")).get("file_id")
        write("VOICE", transcribe(fid))
    elif msg.get("text"):
        write("TEXT", msg["text"])
    else:
        write("MSG", "[non-text/voice message]")

def poll_once(offset):
    data = get("getUpdates", timeout=25, offset=offset)
    if not data.get("ok"):
        print(f"[rx] getUpdates not ok: {data.get('description')}", file=sys.stderr); return offset
    for up in data.get("result", []):
        handle(up); offset = up["update_id"] + 1
        OFFSET_F.write_text(str(offset))
    return offset

def main():
    if not TOKEN or not OWNER: sys.exit("BOT_TOKEN/CHAT_ID not set")
    offset = int(OFFSET_F.read_text()) if OFFSET_F.exists() else 0
    once = "--once" in sys.argv
    print(f"[mesh-voice-rx] listening (owner={OWNER}) -> {LOG}", flush=True)
    while True:
        try:
            offset = poll_once(offset)
        except Exception as e:
            print(f"[rx] {e}", file=sys.stderr); time.sleep(3)
        if once: break

if __name__ == "__main__":
    main()
