#!/usr/bin/env python3
"""mesh-voice-rx — the mesh HEARS the operator over Telegram. Receives the operator's messages
(TEXT and VOICE) via the bot's getUpdates, downloads voice notes
and transcribes them with whisper, and writes everything as text into the voice channel
(~/.mesh/voice-in.log). Operator-only (CHAT_ID); strangers are logged, never answered.
smoke-test: --test checks BOT_TOKEN + CHAT_ID presence

  mesh-voice-rx           poll loop -> append to ~/.mesh/voice-in.log
  mesh-voice-rx --once    one poll cycle (for testing)
  mesh-voice-rx --test    smoke test
"""
import fcntl, os, sys, json, time, subprocess, urllib.request, urllib.parse
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home(); MESH = HOME / ".mesh"; MESH.mkdir(exist_ok=True)
LOG = MESH / "voice-in.log"; OFFSET_F = MESH / ".tg-offset"; STRANGERS = MESH / "tg-strangers.log"
LOCK_F = Path(os.environ.get("MESH_VOICE_RX_LOCK", str(MESH / ".voice-rx.lock")))
_LOCK_FH = None
SCRUB_CMD = os.environ.get("MESH_LOG_SCRUB_CMD", "mesh-log-scrub")

WHISPER = MESH / "whispercpp" / "main"
def _model_override():
    # node-local fast-model override: a thermally-throttled node (large-v3-turbo = ~150s for a 17s
    # note here, OVER the timeout → every voice note wedged the queue) prefers ggml-base (~5s, meaning
    # preserved) for real-time latency. Set MESH_WHISPER_MODEL=ggml-base.bin in env or os.environ.
    v = os.environ.get("MESH_WHISPER_MODEL")
    if not v:
        f = HOME / ".config/remote-access/env"
        if f.exists():
            for ln in f.read_text().splitlines():
                ln = ln.strip()
                if ln.startswith("MESH_WHISPER_MODEL="):
                    v = ln.partition("=")[2].strip()
    return v

def _best_model():
    md = MESH / "whispercpp" / "models"
    ov = _model_override()
    if ov:
        p = md / ov
        if p.exists() and p.stat().st_size > 50_000_000:
            return p
    for name in ("ggml-large-v3-turbo.bin", "ggml-large-v3.bin", "ggml-medium.bin", "ggml-base.bin"):
        p = md / name
        if p.exists() and p.stat().st_size > 50_000_000:  # skip the tiny for-tests stubs
            return p
    return md / "ggml-base.bin"
MODEL = _best_model()   # node-local override (slow nodes), else prefer a bigger/better model (Russian quality)

def env():
    e = {}
    f = HOME / ".config/remote-access/env"
    if f.exists():
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if "=" in ln and not ln.startswith("#"):
                k, _, v = ln.partition("="); e[k.strip()] = v.strip()
    return e
E = env()
TOKEN = os.environ.get("BOT_TOKEN") or E.get("BOT_TOKEN", "")
OWNER = int(os.environ.get("CHAT_ID") or E.get("CHAT_ID", "0"))
API = f"https://api.telegram.org/bot{TOKEN}"
FILEAPI = f"https://api.telegram.org/file/bot{TOKEN}"

if len(sys.argv) > 1 and sys.argv[1] == '--test':
    ok = all(k in os.environ or k in E for k in ['BOT_TOKEN', 'CHAT_ID'])
    print('smoke-test: ok' if ok else 'smoke-test: FAIL (BOT_TOKEN or CHAT_ID missing)', flush=True)
    sys.exit(0 if ok else 1)

def acquire_instance_lock():
    """Hold one poller per node; a competing launch exits without noise."""
    global _LOCK_FH
    _LOCK_FH = open(LOCK_F, "a+")
    try:
        fcntl.flock(_LOCK_FH.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        _LOCK_FH.close()
        _LOCK_FH = None
        return False
    return True

# Reject a competing poller before opening logs or spawning the scrubber.
if not acquire_instance_lock():
    sys.exit(0)

# persistent pipe to log scrubber — all log writes go through it; fail-safe: if scrub missing, write raw + warn
import shutil
_SCRUB_AVAIL = shutil.which(SCRUB_CMD) is not None
_LOG_FH = open(LOG, "a")
if _SCRUB_AVAIL:
    _SCRUB = subprocess.Popen(
        [SCRUB_CMD],
        stdin=subprocess.PIPE, stdout=_LOG_FH, text=True, bufsize=1,
    )
else:
    print(f"WARN: {SCRUB_CMD} not found — appending raw to voice-in.log", file=sys.stderr)
    _SCRUB = None

def ffmpeg_bin():
    # MUST decode OGG/Opus (Telegram voice). imageio-ffmpeg ships a full build with libopus;
    # the playwright bundled ffmpeg does NOT have an opus decoder, so it is avoided.
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        pass
    import shutil
    return shutil.which("ffmpeg") or "ffmpeg"
FFMPEG = ffmpeg_bin()

def get(method, **params):
    url = f"{API}/{method}"
    if params: url += "?" + urllib.parse.urlencode(params)
    with urllib.request.urlopen(url, timeout=40) as r:
        return json.load(r)

# Full ISO-8601 (date+time), not %H:%M:%SZ — voice-in.log/strangers.log are never rotated, so a
# time-only stamp made cross-day entries indistinguishable: yesterday's 23:06Z sat among today's
# 18:55Z looking "out of order / future-of-now", which made operator-message loss-detection
# impossible (the 2026-06-13 409 lifeline adjudication couldn't tell what arrived "today since X").
# Matches the board/trace ISO convention; consumers (mesh-dash tails+displays) are format-agnostic.
def ts(): return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def _raw_write(line):
    _LOG_FH.write(line + "\n")
    _LOG_FH.flush()

def write(kind, text):
    global _SCRUB
    line = f"{ts()}  {kind}  {text}".rstrip()
    if _SCRUB is not None:
        try:
            if _SCRUB.poll() is not None:
                raise BrokenPipeError(f"{SCRUB_CMD} exited early")
            _SCRUB.stdin.write(line + "\n")
            _SCRUB.stdin.flush()
        except (BrokenPipeError, OSError, ValueError) as e:
            print(f"WARN: {SCRUB_CMD} failed — appending raw to voice-in.log", file=sys.stderr)
            _SCRUB = None
            _raw_write(line)
    else:
        _raw_write(line)
    print(line, flush=True)

def kick_feed():
    """Event-driven feed: the moment an operator message lands, push it to the tg mind pane NOW
    instead of waiting for the */1 mesh-channel-tg cron (up to 60s of "почему не сразу"). Detached +
    best-effort so a slow feed never stalls the poll loop; the */1 cron stays as a backstop and the
    feed itself is flock-serialized, so the cron and this kick can't double-inject the same line."""
    try:
        ctg = os.path.expanduser("~/.local/bin/mesh-channel-tg")
        if os.path.exists(ctg):
            subprocess.Popen([ctg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
    except Exception:
        pass

if len(sys.argv) > 1 and sys.argv[1] == '--test-write':
    write("TEXT", os.environ.get("MESH_VOICE_RX_TEST_LINE", "smoke-write"))
    print("smoke-write: ok", flush=True)
    sys.exit(0)

def transcribe(file_id):
    info = get("getFile", file_id=file_id)
    path = info.get("result", {}).get("file_path")
    if not path: return "[voice: getFile failed]"
    oga = MESH / "voice-in.oga"; wav = MESH / "voice-in.wav"
    urllib.request.urlretrieve(f"{FILEAPI}/{path}", oga)
    subprocess.run([FFMPEG, "-y", "-i", str(oga), "-ar", "16000", "-ac", "1", str(wav)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wav.exists(): return "[voice: ffmpeg failed]"
    try:
        out = subprocess.run([str(WHISPER), "-m", str(MODEL), "-f", str(wav), "-nt", "-l", "auto"],
                             capture_output=True, text=True, timeout=240)
        txt = " ".join(out.stdout.split()).strip()
    except subprocess.TimeoutExpired:
        # CRITICAL: never let a slow transcription RAISE — it would propagate to poll_once and stop
        # the offset advancing, wedging the WHOLE inbound queue on one note. Log a placeholder instead.
        txt = "[voice: transcription timed out (>240s) — node under load; please resend as text if urgent]"
    except Exception as e:
        txt = f"[voice: transcription error: {str(e)[:60]}]"
    for p in (oga, wav):
        try: p.unlink()
        except OSError: pass
    return txt or "[voice: empty transcript]"

def handle(update):
    msg = update.get("message") or update.get("edited_message")
    if not msg: return
    frm = (msg.get("from") or {}).get("id")
    if frm != OWNER:
        with open(STRANGERS, "a") as f:
            f.write(f"{ts()}  from={frm}  {json.dumps(msg.get('text') or '[non-text]')[:120]}\n")
        return
    if msg.get("voice") or msg.get("audio"):
        fid = (msg.get("voice") or msg.get("audio")).get("file_id")
        write("VOICE", transcribe(fid))
        kick_feed()
    elif msg.get("text"):
        write("TEXT", msg["text"])
        kick_feed()
    elif msg.get("photo") or msg.get("document"):
        # operator screenshots/files → download into ~/.mesh/inbox so a mind can read them
        if msg.get("photo"):
            doc = max(msg["photo"], key=lambda p: p.get("file_size") or 0)  # largest rendition
            name = f"photo-{doc['file_id'][:8]}.jpg"
        else:
            doc = msg["document"]
            name = (doc.get("file_name") or f"file-{doc['file_id'][:8]}").replace("/", "_").replace("..", "_")
        info = get("getFile", file_id=doc["file_id"])
        path = info.get("result", {}).get("file_path")
        if path:
            inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
            dest = inbox / name
            try:
                urllib.request.urlretrieve(f"{FILEAPI}/{path}", dest)
                write("DOCUMENT", f"saved -> {dest}")
            except Exception as e:
                write("DOCUMENT", f"[download failed: {e}]")
        else:
            write("DOCUMENT", f"[getFile failed] {name}")
    else:
        write("MSG", "[non-text/voice message]")

def poll_once(offset):
    data = get("getUpdates", timeout=25, offset=offset)
    if not data.get("ok"):
        print(f"[rx] getUpdates not ok: {data.get('description')}", file=sys.stderr); return offset
    for up in data.get("result", []):
        # ALWAYS advance the offset, even if handle() throws — a single un-handleable update
        # (bad voice note, download error, anything) must NOT wedge the entire inbound queue.
        try:
            handle(up)
        except Exception as e:
            print(f"[rx] handle failed for update {up.get('update_id')}: {e}", file=sys.stderr)
        offset = up["update_id"] + 1
        OFFSET_F.write_text(str(offset))
    return offset

def main():
    if not TOKEN or not OWNER: sys.exit("BOT_TOKEN/CHAT_ID not set")
    offset = int(OFFSET_F.read_text()) if OFFSET_F.exists() else 0
    once = "--once" in sys.argv
    print(f"[mesh-voice-rx] listening (owner={OWNER}) -> {LOG}", flush=True)
    import urllib.error
    backoff = 0   # 409 = another getUpdates consumer owns this bot (historically proxy-bot.service on
                  # default-string — retired 2026-06-13 after it silently ate operator messages).
                  # Telegram allows ONE poller per token, so persistent 409 means a competing poller is
                  # live SOMEWHERE on the mesh — hunt it down, don't just back off. DON'T hammer (was
                  # retrying every 3s, spamming 409): exponential backoff, reset on a clean poll.
    while True:
        try:
            offset = poll_once(offset); backoff = 0
        except urllib.error.HTTPError as e:
            if e.code == 409:
                backoff = min((backoff or 1) * 2, 120)
                print(f"[rx] 409 Conflict — another poller owns this bot; yielding {backoff}s", file=sys.stderr)
                time.sleep(backoff)
            else:
                print(f"[rx] HTTP {e.code}", file=sys.stderr); time.sleep(3)
        except Exception as e:
            print(f"[rx] {e}", file=sys.stderr); time.sleep(3)
        if once: break

if __name__ == "__main__":
    main()
