#!/usr/bin/env python3
"""mesh-voice-rx — the mesh HEARS the operator over Telegram. Receives the operator's messages
(TEXT and VOICE) via the bot's getUpdates, downloads voice notes
and transcribes them with whisper, and writes everything as text into the voice channel
(~/.mesh/voice-in.log). Operator-only (CHAT_ID); strangers are logged, never answered.
smoke-test: --test checks BOT_TOKEN + CHAT_ID presence

  mesh-voice-rx           poll loop -> append to ~/.mesh/voice-in.log
  mesh-voice-rx --once    one poll cycle (for testing)
  mesh-voice-rx --test    smoke test
"""
import fcntl, os, re, sys, json, time, subprocess, urllib.request, urllib.parse, urllib.error
from datetime import datetime, timezone
from pathlib import Path

import signal
# SIGTERM MUST UNWIND, or every `finally` in this file is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks (and without
# TemporaryDirectory.__exit__), so a correct-looking cleanup never runs. The signal is not
# hypothetical: GNU `timeout` — which wraps this tool at its call sites and wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire — puts its child in its OWN process group and
# signals the GROUP, so this process gets the TERM. sys.exit() from the handler raises SystemExit in
# the main thread, which is what actually unwinds. SIGKILL stays uncatchable; that half is
# mesh-tmp-guard's sweep. Pattern and the measured mechanism: eb5b8e7, scripts/mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

# urllib.request does not support SOCKS proxies and will crash if socks5h:// is in env
for env_var in ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"]:
    if env_var in os.environ and os.environ[env_var].startswith("socks"):
        del os.environ[env_var]

HOME = Path.home(); MESH = HOME / ".mesh"; MESH.mkdir(exist_ok=True)
LOG = MESH / "voice-in.log"; OFFSET_F = MESH / ".tg-offset"; STRANGERS = MESH / "tg-strangers.log"
PROCESSED_F = MESH / ".tg-processed"
# Operator-channel liveness marker, mirroring .egress-state (which mesh-stress already consumes). This
# is the INBOUND half of "is the operator channel at risk": mesh-stress's whole thesis, yet its only
# axes were thermal/load/egress-ping — all OUTBOUND proxies, none the channel itself. On 2026-07-25
# voice-rx went DEAF 01:41–01:47Z (getaddrinfo DNS failure) and mesh-stress posted nothing in that
# window — a real ~6min operator-channel outage the tool named after that exact risk never flagged
# (knowledge/capability-mesh-stress-blind-to-voice-rx-functional-failure-mesh-home-20260728.md).
# WRITTEN ON EVERY POLL CYCLE (success AND failure) so mtime = liveness (a wedged/dead poller freezes
# it → mesh-stress reads STALE); field 1 = status token (OK | ERR:<class>), field 2 = ISO ts for humans.
RX_STATE = MESH / ".voice-rx-state"
OPERATOR_FYI_LOG = Path(os.environ.get("MESH_OPERATOR_FYI_LOG", str(MESH / "operator-fyi.log")))
LOCK_F = Path(os.environ.get("MESH_VOICE_RX_LOCK", str(MESH / ".voice-rx.lock")))
_LOCK_FH = None
# Bounded hold for the operator's original voice audio (see the voice-hold block in transcribe()).
# Long enough that a misclassified recording survives until he asks for it, short enough that this
# is retention and not an archive. 0 restores the old destroy-on-classify behaviour (do not).
VOICE_HOLD_DAYS = float(os.environ.get("MESH_VOICE_HOLD_DAYS", "7"))
# Provenance for inbound voice audio: the Telegram file_id/file_unique_id of every note, beside the
# path its audio landed on (see _log_voice_file). Outlives the bounded hold on purpose — it is the
# handle by which a note can be re-fetched after its audio is pruned.
VOICE_FILES_LOG = Path(os.environ.get("MESH_VOICE_FILES_LOG", str(MESH / "voice-in-files.log")))
SCRUB_CMD = os.environ.get("MESH_LOG_SCRUB_CMD", "mesh-log-scrub")

# Route through mesh-whisper-run (nice+ionice+flock shim, drop-in args) so a voice-note burst can't
# stack whisper RSS on top of a concurrent overhear/transcribe run — the 2026-07-05 20:05-20:12Z OOM
# batch was unserialized whisper jobs racing. Raw binary where the shim isn't deployed.
_WSHIM = HOME / ".local/bin/mesh-whisper-run"
WHISPER = _WSHIM if _WSHIM.exists() else MESH / "whispercpp" / "main"
def _model_override():
    # node-local model pin. Set MESH_WHISPER_MODEL=<file> in env or ~/.config/remote-access/env.
    # It was ggml-base here on an ARITHMETIC premise that died with the hardware: "large-v3-turbo =
    # ~150s for a 17s note, OVER the timeout" was measured on IdeaPad (2-core, thermally throttled).
    # The config file migrated to mesh-home (16 cores) on 2026-07-14 and the number came with it
    # unre-measured. Benched here on the operator's own ru note: turbo-q5_0 is 15.04s against a 240s
    # timeout, 10x off the inherited claim, at wer 0.250 vs base's 0.812 — so base was costing 3.2x
    # the error to dodge a cost that does not exist on this node. Pinned to turbo 2026-07-15
    # (operator approved). Re-measure before trusting this on any other node.
    v = os.environ.get("MESH_WHISPER_MODEL")
    if not v:
        f = HOME / ".config/remote-access/env"
        if f.exists():
            for ln in f.read_text().splitlines():
                ln = ln.strip()
                if ln.startswith("MESH_WHISPER_MODEL="):
                    v = ln.partition("=")[2].strip()
    return v

def _best_model():
    md = MESH / "whispercpp" / "models"
    ov = _model_override()
    if ov:
        p = md / ov
        if p.exists() and p.stat().st_size > 50_000_000:
            return p
    # EXACT-NAME, so a model on disk under a name absent here is INVISIBLE to the ladder and it
    # falls silently to base. That was live: only ggml-large-v3-turbo-q5_0.bin was ever downloaded
    # here, the ladder asked for the unquantized ggml-large-v3-turbo.bin, and the unpinned fallback
    # was therefore base-forever with a 574MB turbo sitting beside it. mesh-model-resolve reports
    # this miss; keep the quant names listed. (2026-07-15)
    for name in ("ggml-large-v3-turbo.bin", "ggml-large-v3-turbo-q5_0.bin", "ggml-large-v3.bin",
                 "ggml-medium.bin", "ggml-base.bin"):
        p = md / name
        if p.exists() and p.stat().st_size > 50_000_000:  # skip the tiny for-tests stubs
            return p
    return md / "ggml-base.bin"
MODEL = _best_model()   # node-local override (slow nodes), else prefer a bigger/better model (Russian quality)

def env():
    e = {}
    f = HOME / ".config/remote-access/env"
    if f.exists():
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if "=" in ln and not ln.startswith("#"):
                k, _, v = ln.partition("="); e[k.strip()] = v.strip()
    return e
E = env()
TOKEN = os.environ.get("BOT_TOKEN") or E.get("BOT_TOKEN", "")
OWNER = int(os.environ.get("CHAT_ID") or E.get("CHAT_ID", "0"))
API = f"https://api.telegram.org/bot{TOKEN}"
FILEAPI = f"https://api.telegram.org/file/bot{TOKEN}"

BREAK_MARK = " ⏎ "

def _collapse_breaks(text):
    """One operator message -> exactly ONE voice-in.log line. See write() for the failure this fixes.
    Defined up here (above the --test block) so the smoke test can assert it without a live poll."""
    return str(text).replace("\r\n", "\n").replace("\r", "\n").replace("\n", BREAK_MARK)

SOUNDSCAPE = HOME / ".local/bin/mesh-soundscape"
# AUDIO-SIDE instrumental check — the signal `_music_only()` structurally cannot have.
# `_music_only` reads the TRANSCRIPT, and whisper does not always render music as annotations: over
# the operator's 85s guitar take (2026-08-14 21:39Z) it produced a fluent verse-and-chorus LYRIC.
# By text alone that is speech, and no widening of _NOISE_ANNOT can ever separate it — the evidence
# is not in the text. These two axes (mesh-soundscape --measure, added e5a61e3) are computed on the
# WHOLE decoded file, peak-normalised, so recording level cannot move them:
#   voiced = fraction of frames with a confident f0 in 70–700 Hz · chent = chroma entropy (0 = one
#   pitch class, 1 = pitchless).
# Labelled reads, the operator's own audio (fixtures in ~/.mesh/fixtures/guitar-calib, README carries
# provenance): his guitar chent .978–.990 / voiced .32–.54 · him TALKING 60s earlier on the same
# phone chent .993–.997 / voiced .64–.87 · 400 ambient fanout captures chent med .996 voiced med .11.
# The thresholds sit in the gaps of BOTH axes and are ANDed, which is what keeps ambient/silence out
# (low voiced, but chent too high to be a played instrument).
# n is small (one take, one talking sample, one ambient corpus) and this is deliberately the WEAKEST
# claim in the path — so it gates only a LABEL, never a deletion: after 0ccf506 the audio is held
# either way, a false positive costs a hedged routing line, a false negative costs the old behaviour.
INSTR_VOICED_MAX = float(os.environ.get("MESH_VOICE_INSTR_VOICED_MAX", "0.60"))
INSTR_CHENT_MAX = float(os.environ.get("MESH_VOICE_INSTR_CHENT_MAX", "0.992"))

def _instrumental(chent, voiced):
    """True when the AUDIO reads as a played instrument rather than a voice. Pure, so the thresholds
    are assertable offline; missing axes (soundscape absent/timed out) render False — an unmeasured
    file is never CLAIMED to be music, it just falls back to the text-only path."""
    if chent is None or voiced is None:
        return False
    return voiced < INSTR_VOICED_MAX and chent < INSTR_CHENT_MAX

# THE TIMEOUT IS A DURATION ASSUMPTION (2026-08-21). The local whisper run was capped at a FLAT 240s
# regardless of how long the operator spoke, so the cap silently encoded "his notes are short". A
# 410s note (15:46:01Z) could not fit it on any loaded node — the cloud fallback was down on DNS that
# minute, and the note surfaced as "[voice: transcription timed out (node under load)]", which named
# LOAD as the cause when the real cause was that the budget never looked at the audio. Recovered by
# hand afterwards; it was a grind test, so nothing was lost, but the shape is the one to keep: a
# constant wall-clock cap over a variable-length input is a claim about the input.
#
# Size it to the audio instead. The wav is always 16 kHz mono s16 here (ffmpeg above writes it), so
# its duration is bytes/32000 — read from the file we are about to transcribe, never from Telegram's
# `duration` field, which is absent for a spooled note and is the sender's claim either way.
# FACTOR: turbo-q5_0 on this node measured 60s of speech in 27.9s (~0.47x realtime) quiet; 3x
# realtime plus a fixed 60s of model load is generous headroom for a loaded node without being
# unbounded. FLOOR keeps the old 240s for short notes (never a regression). CEILING is NOT a taste
# call — mesh-voice-rx.service sets WatchdogSec=900 and the loop's only ping site is per-update
# (line ~1303), so a single whisper run that outlives the watchdog gets the poller KILLED mid-note.
# 600s leaves the download and the ffmpeg pass inside the same 900s window. Raising it means moving
# WatchdogSec first, or pinging from inside the run.
WHISPER_BUDGET_FLOOR = 240
WHISPER_BUDGET_CEILING = 600

def _wav_seconds(wav):
    """Duration of a 16 kHz mono s16 wav from its size, or None if it cannot be read."""
    try:
        n = Path(wav).stat().st_size - 44          # RIFF header; a few ms of error, irrelevant here
        return max(0.0, n / 32000.0) if n > 0 else 0.0
    except OSError:
        return None

def _whisper_budget(wav, floor=WHISPER_BUDGET_FLOOR, ceiling=WHISPER_BUDGET_CEILING):
    """Seconds to allow the local whisper run, sized to the AUDIO. Unmeasurable -> the old floor."""
    secs = _wav_seconds(wav)
    if secs is None:
        return floor
    return int(max(floor, min(ceiling, 60.0 + 3.0 * secs)))

def _instrumental_intro(chent, voiced, dest, heard):
    """The routed line for a note whose TEXT says speech but whose AUDIO says instrument. Pure, so
    the contract that matters is assertable offline: it CARRIES the transcript verbatim (a note the
    operator recorded over his own playing would otherwise lose his words), it names where the audio
    is, and it tells the mind not to act on the words as an instruction."""
    return (f"operator sent a voice note whose AUDIO reads as a PLAYED INSTRUMENT, not a voice "
            f"(voiced={voiced:.2f} chent={chent:.4f}; his talking reads ~.80/.995, his guitar "
            f"~.45/.988) — the transcript below is very likely whisper HALLUCINATING words over "
            f"music, so do NOT act on it as an instruction"
            + (f"; the audio is saved at {dest}" if dest else "")
            + f". Ask the operator what he wants done with it. transcript-as-heard: "
            + (heard or "(nothing)"))

if len(sys.argv) > 1 and sys.argv[1] == '--test':
    import shutil
    fails = []
    def _t(ok, msg):
        if not ok: fails.append(msg)

    # 1) deps
    _t(shutil.which("python3"), "no python3")
    _t(shutil.which("ffmpeg") or FFMPEG, "no ffmpeg")
    _t(WHISPER.exists(), f"no whisper.cpp at {WHISPER}")

    # 2) env
    _t(TOKEN, "BOT_TOKEN missing")
    _t(OWNER, "CHAT_ID missing")

    # 3) Telegram getMe — proves token is valid + API reachable
    if TOKEN:
        try:
            url = f"https://api.telegram.org/bot{TOKEN}/getMe"
            with urllib.request.urlopen(url, timeout=15) as r:
                resp = json.load(r)
            _t(resp.get("ok"), f"getMe failed: {resp.get('description','?')}")
            _t(resp.get("result", {}).get("is_bot"), "getMe result is not a bot")
        except Exception as e:
            _t(False, f"getMe exception: {e}")

    # 4) voice-in.log writable
    _t(LOG.parent.exists() and os.access(LOG.parent, os.W_OK), f"~/.mesh not writable")

    # 5) a multi-line operator message MUST become one physical log line. RED before 2026-08-14:
    # the raw text went in with its newlines and mesh-channel fed the mind only the first line,
    # so anything he wrote under a quote was invisible. Assert on the real text that exposed it.
    _real = "> Test page is LIVE. Open this on your phone with Wi-Fi OFF, mobile data only:\n\nyou've just sent me and that is it. again nothing after \":\". plzzzz fix"
    _c = _collapse_breaks(_real)
    _t("\n" not in _c, "multi-line operator message still contains a newline (mind gets line 1 only)")
    _t("plzzzz fix" in _c, "text after the break was lost in collapse")
    _t(_collapse_breaks("a\r\nb") == "a" + BREAK_MARK + "b", "CRLF not collapsed to a single break mark")
    _t(_collapse_breaks("no breaks here") == "no breaks here", "single-line text must pass through unchanged")

    # 6) The AUDIO-side witness's OFFLINE half, chained here because this is the only --test a runner
    # ever invokes (mesh-land `timeout 30`, mesh-doctor hourly): the focused blocks below are manual.
    # The LIVE half — his labelled guitar/speech through the real mesh-soundscape — stays in
    # `--test-instrumental` (~34s, past mesh-land's window; run it after touching the thresholds).
    _t(not _instrumental(None, None), "an unmeasured note reads as an instrument")
    _t(not _instrumental(0.9953, 0.800), "him TALKING reads as an instrument (thresholds inverted)")
    _t(_instrumental(0.9882, 0.449), "his guitar take reads as speech (thresholds inverted)")
    # 7) THE BUDGET IS SIZED TO THE AUDIO, not a constant (2026-08-21). Goes RED if anyone restores
    # a flat cap, if the floor stops protecting short notes, or if the ceiling drifts past the
    # 900s WatchdogSec that bounds it.
    import tempfile as _tf_b
    with _tf_b.TemporaryDirectory() as _bd:
        def _mkwav(secs):
            p = Path(_bd) / f"w{secs}.wav"; p.write_bytes(b"\0" * (44 + int(secs * 32000))); return p
        _t(_whisper_budget(_mkwav(10)) == 240, "a short note lost the 240s floor")
        _t(_whisper_budget(_mkwav(410)) > 240, "a 410s note still gets the flat 240s cap (the fault)")
        _t(_whisper_budget(_mkwav(410)) == 600, "the 410s budget is not the ceiling it should clamp to")
        _t(_whisper_budget(_mkwav(120)) == 420, "the 120s budget is not 60+3x realtime")
        _t(_whisper_budget(Path(_bd) / "absent.wav") == 240, "an unmeasurable wav must fall to the floor")
        _t(WHISPER_BUDGET_CEILING <= 600, "ceiling raised past what WatchdogSec=900 can carry")
        _t(abs(_wav_seconds(_mkwav(60)) - 60) < 0.1, "wav duration from size is wrong")

    _line = _instrumental_intro(0.9882, 0.449, "/tmp/x.oga", "то что он сказал")
    _t("то что он сказал" in _line, "the hedged routing line DROPS the transcript")
    _t("/tmp/x.oga" in _line and "not act on it" in _line.lower(), "routing line loses the audio path or the warning")

    if fails:
        print("smoke-test: FAIL (" + "; ".join(fails) + ")", flush=True); sys.exit(1)
    print("smoke-test: ok", flush=True); sys.exit(0)

def acquire_instance_lock():
    """Hold one poller per node; a competing launch exits without noise."""
    global _LOCK_FH
    _LOCK_FH = open(LOCK_F, "a+")
    try:
        fcntl.flock(_LOCK_FH.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        _LOCK_FH.close()
        _LOCK_FH = None
        return False
    return True

# Reject a competing poller before opening logs or spawning the scrubber. Focused unit-style tests do
# not poll Telegram, so they may run beside the live receiver.
_NO_POLL_TEST = len(sys.argv) > 1 and sys.argv[1] in ('--test-operator-fyi-routing', '--test-image-routing', '--test-document-board-claim', '--test-voice-hold', '--test-instrumental', '--test-spool')
if not _NO_POLL_TEST and not acquire_instance_lock():
    sys.exit(0)

# persistent pipe to log scrubber — all log writes go through it; fail-safe: if scrub missing, write raw + warn
import shutil
_SCRUB_AVAIL = shutil.which(SCRUB_CMD) is not None
_LOG_FH = open(LOG, "a")
if _SCRUB_AVAIL:
    _SCRUB = subprocess.Popen(
        [SCRUB_CMD],
        stdin=subprocess.PIPE, stdout=_LOG_FH, text=True, bufsize=1,
    )
else:
    print(f"WARN: {SCRUB_CMD} not found — appending raw to voice-in.log", file=sys.stderr)
    _SCRUB = None

def ffmpeg_bin():
    # MUST decode OGG/Opus (Telegram voice). imageio-ffmpeg ships a full build with libopus;
    # the playwright bundled ffmpeg does NOT have an opus decoder, so it is avoided.
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        pass
    import shutil
    return shutil.which("ffmpeg") or "ffmpeg"
FFMPEG = ffmpeg_bin()

def get(method, **params):
    url = f"{API}/{method}"
    if params: url += "?" + urllib.parse.urlencode(params)
    try:
        with urllib.request.urlopen(url, timeout=40) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        # Telegram sends its real error as JSON in the 4xx body (e.g. getFile on a >20MB file →
        # 400 'file is too big'). Raising here made handle() drop the whole update with only a
        # stderr line — the 2026-07-06 jam-track loss. Return the parsed error so callers see
        # ok:false + description and can tell the operator WHY.
        try:
            return json.load(e)
        except Exception:
            return {"ok": False, "description": f"HTTP {e.code}"}

# Full ISO-8601 (date+time), not %H:%M:%SZ — voice-in.log/strangers.log are never rotated, so a
# time-only stamp made cross-day entries indistinguishable: yesterday's 23:06Z sat among today's
# 18:55Z looking "out of order / future-of-now", which made operator-message loss-detection
# impossible (the 2026-06-13 409 lifeline adjudication couldn't tell what arrived "today since X").
# Matches the board/trace ISO convention; consumers (mesh-dash tails+displays) are format-agnostic.
def ts(): return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def write_rx_state(status):
    # status: "OK" (a poll completed) or "ERR:<class>" (dns|conflict|http|net|other). Write on EVERY
    # cycle so mtime tracks liveness even when the value is unchanged (liveness-touch convention:
    # mtime = ran-live, content = last outcome). Best-effort — never let a state-write failure kill
    # the poller; the operator channel matters more than its own health marker.
    try:
        RX_STATE.write_text(f"{status}\t{ts()}\n")
    except Exception:
        pass

# --- systemd watchdog: the ONLY guard that can end a HANG from OUTSIDE the hung process ---
# 2026-08-21: this poller went DEAF for 2h13m (22:29:24Z -> 00:42Z) without dying. It hung inside a
# getUpdates recv: the TCP socket to Telegram stayed ESTABLISHED with an empty receive queue, the
# urlopen(timeout=40) never fired, not one line reached the log — no message, no error — and the
# process stayed in `wait_woken`. Every liveness claim in the mesh was TRUE and USELESS: `pgrep`
# found it, `systemctl` said `active (running)`, `Restart=always` had nothing to restart, and the
# tg pane printed `voice-rx UP` the whole time. The operator noticed before any sense did.
#
# In-process retry cannot fix this (the retry loop is what is hung), so the guard must live outside:
# systemd pings us via WatchdogSec and kills+restarts the unit when the ping stops. We notify per
# LOOP ITERATION, not per successful poll — a long DNS outage is a live loop and must not be
# restarted, only a stalled one. handle() can legitimately run minutes (voice download + whisper up
# to 240s), so it pings from inside the update loop too, and WatchdogSec is set well above one
# worst-case cycle. Best-effort by construction: no NOTIFY_SOCKET (run by hand, --once, --test) is a
# silent no-op, never a crash.
def _sd_notify(msg):
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    try:
        import socket as _s
        if addr.startswith("@"):
            addr = "\0" + addr[1:]          # abstract namespace
        with _s.socket(_s.AF_UNIX, _s.SOCK_DGRAM) as sk:
            sk.sendto(msg.encode(), addr)
    except Exception:
        pass

def _watchdog_ping():
    _sd_notify("WATCHDOG=1")

# A singleton whose restart is silent teaches nothing: the interesting number is not "it started",
# it is HOW LONG the previous instance had been failing to complete a cycle. RX_STATE's mtime
# answers exactly that, and it is already on disk before we overwrite it — so read it FIRST. A
# normal restart reports a small gap; a hang like the one above reports the whole outage, naming
# itself on the board without anyone having to diagnose it.
def _announce_start():
    gap = None
    try:
        gap = int(time.time() - RX_STATE.stat().st_mtime)
    except Exception:
        pass
    if gap is None:
        detail = "no prior state file (first start / fresh node)"
    elif gap >= 300:
        detail = f"previous instance completed NO poll cycle for {gap // 60}m — that window was DEAF"
    else:
        detail = f"previous cycle {gap}s ago (clean restart)"
    line = f"[fyi] voice-rx (operator TG ear) STARTED on {os.uname().nodename}: {detail}"
    try:
        subprocess.run(["mesh-chat", line], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=15)
    except Exception:
        pass
    print(f"[rx] start: {detail}", flush=True)

def _err_class(exc):
    # Map an exception from the poll cycle to a coarse class mesh-stress can escalate on. DNS
    # (getaddrinfo) is the 2026-07-25 incident's class and reads as a URLError whose reason mentions
    # name resolution; it is NOT an HTTPError, so main()'s bare except is where it lands.
    s = str(getattr(exc, "reason", exc)).lower()
    if "name resolution" in s or "getaddrinfo" in s or "name or service not known" in s:
        return "dns"
    if isinstance(exc, urllib.error.HTTPError):
        return "conflict" if getattr(exc, "code", 0) == 409 else "http"
    if isinstance(exc, urllib.error.URLError):
        return "net"
    return "other"
def _raw_write(line):
    _LOG_FH.write(line + "\n")
    _LOG_FH.flush()

def write(kind, text):
    global _SCRUB
    # voice-in.log is LINE-ORIENTED: mesh-channel feeds it to the mind ONE PHYSICAL LINE AT A TIME
    # through mesh-tg-filter, whose regex requires a `<stamp>  <KIND>  ` prefix. A multi-line operator
    # message written raw therefore reached the mind as its FIRST LINE ONLY — every continuation line
    # carried no prefix, matched nothing, and was consumed as "not an operator message". Measured
    # 2026-08-14: his message quoted one of mine and asked "plzzzz fix" below the quote; the mind
    # received only the quoted line and answered as if the rest did not exist. Collapse the breaks
    # here, at the WRITE, so one message is always exactly one line for every reader downstream.
    text = _collapse_breaks(text)
    line = f"{ts()}  {kind}  {text}".rstrip()
    if _SCRUB is not None:
        try:
            if _SCRUB.poll() is not None:
                raise BrokenPipeError(f"{SCRUB_CMD} exited early")
            _SCRUB.stdin.write(line + "\n")
            _SCRUB.stdin.flush()
        except (BrokenPipeError, OSError, ValueError) as e:
            print(f"WARN: {SCRUB_CMD} failed — appending raw to voice-in.log", file=sys.stderr)
            _SCRUB = None
            _raw_write(line)
    else:
        _raw_write(line)
    print(line, flush=True)

def _processed_keys():
    try:
        return set(PROCESSED_F.read_text().splitlines()[-2000:])
    except Exception:
        return set()

def _mark_processed(*keys):
    keys = [k for k in keys if k]
    if not keys:
        return
    try:
        with open(PROCESSED_F, "a") as f:
            for key in keys:
                f.write(key + "\n")
    except Exception:
        pass

def update_key(update):
    uid = update.get("update_id")
    return f"u:{uid}" if uid is not None else ""

def message_key(update):
    msg = update.get("message") or update.get("edited_message") or {}
    chat_id = (msg.get("chat") or {}).get("id")
    mid = msg.get("message_id")
    if chat_id is None or mid is None:
        return ""
    kind = "edit" if update.get("edited_message") else "msg"
    return f"m:{chat_id}:{mid}:{kind}"

def already_processed(update):
    keys = _processed_keys()
    return update_key(update) in keys or message_key(update) in keys

def kick_feed():
    """Event-driven feed: the moment an operator message lands, push it to the tg mind pane NOW
    instead of waiting for the */1 mesh-channel-tg cron (up to 60s of "почему не сразу"). Detached +
    best-effort so a slow feed never stalls the poll loop; the */1 cron stays as a backstop and the
    feed itself is flock-serialized, so the cron and this kick can't double-inject the same line."""
    try:
        ctg = os.path.expanduser("~/.local/bin/mesh-channel-tg")
        if os.path.exists(ctg):
            subprocess.Popen([ctg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
    except Exception:
        pass

TYPING = Path(os.environ.get("MESH_TG_TYPING", os.path.expanduser("~/.local/bin/mesh-tg-typing")))

def typing_start():
    """Start the operator typing loop best-effort; no-op if helper is absent."""
    try:
        if OWNER == 51010427 and TYPING.exists():
            subprocess.Popen([str(TYPING), "--start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass

def post_to_board(text):
    """Record the operator's message as FYI CONTEXT ONLY — NOT a board directive.
    History (2026-06-18 fix): the old version told the board "reply to the operator via mesh-tg,
    ONE taker" — but the vision-less opencode minds (genome/chat) don't coordinate; they EACH fired a
    reply and confabulated "can't read image / no OCR" on the operator's screenshots, flooding his
    trust-critical channel with junk in my (the tg mind's) name. Doctrine is operator comms = the tg
    mind ONLY (kick_feed feeds it directly; mesh-tg-reply-watch backstops silence).

    2026-06-20 board-hygiene: even non-actionable [operator-fyi] lines wake every coordination reader
    and bury cross-mind signal. Keep the forensic/context trail in a dedicated tg relay log instead of
    shared chat.log; the tg mind still receives the live message via voice-in.log -> mesh-channel-tg."""
    try:
        OPERATOR_FYI_LOG.parent.mkdir(parents=True, exist_ok=True)
        snippet = " ".join(text.split())[:300]
        with open(OPERATOR_FYI_LOG, "a") as f:
            f.write(f"{ts()}  operator-fyi  {snippet}\n")
    except Exception:
        pass

# NB: NOT MESH_CHAT_CMD — that name is already the ENGINE override for the 'chat' channel in
# restore.env (e.g. a claude binary); reusing it here would point the board post at an LLM binary.
CHAT_CMD = os.environ.get("MESH_VOICE_RX_CHAT_CMD", os.path.expanduser("~/.local/bin/mesh-chat"))

def post_task_to_board(path, caption):
    """Route an operator DOCUMENT to the shared board as a STANDING [task] claim — a liability
    mesh-promises can age — instead of a kick_feed poke that evaporates.

    Why this exists (fix operator-document-has-no-durable-claim): a document lands in ~/.mesh/inbox and
    its ONLY trace was the fyi-log line + the pane inject. Both are lossy — the inject silently swallows
    when the mind is mid-turn (the composer-swallow / [dispatch-noack] shape) and the next /clear drops
    it. Measured 2026-07-31: a 34KB render-sim task doc sat unread 52min with ZERO board rows until the
    operator re-asked. A text QUESTION survives because he re-asks; a task doc he expects to be working
    is exactly what nobody re-asks. A [task] row is a claim mesh-promises tracks and ages — durable.

    DOCUMENTS ONLY (kind == "file"). Photos/screenshots keep the tg-mind-only path (2026-06-18
    confabulation doctrine, post_to_board above); this does NOT reopen it — a [task] is a dispatchable
    claim, not the old "reply to the operator, ONE taker" board directive that made vision-less minds
    confabulate. The fyi-log line is KEPT alongside (both carriers, one durable)."""
    try:
        cap = " ".join((caption or "").split())[:200]
        pname = os.path.basename(str(path))
        body = f"[task] operator sent document {pname} -> {path} — Read it and act on the operator's request"
        if cap:
            body += f"; caption: {cap}"
        body += " owner: tg"
        if os.path.exists(CHAT_CMD):
            env = {**os.environ, "MESH_WHO": os.environ.get("MESH_WHO") or f"tg-rx@{os.uname().nodename}"}
            subprocess.run([CHAT_CMD, body], env=env,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    except Exception:
        pass

if len(sys.argv) > 1 and sys.argv[1] == '--test-operator-fyi-routing':
