def _inbox_name(kind, doc):
    """Inbox filename for one inbound media doc — UNIQUE PER FILE, so an album never eats itself.

    The old name was `photo-{file_id[:8]}.jpg`, and a Telegram photo file_id's first 8 chars are a
    CONSTANT header ('AgACAgIA') shared by every photo the bot ever receives — so every photo landed
    on the SAME path and each one overwrote the last. An operator album of 100 diary pages left ONE
    file on disk (2026-07-25); the loss is silent, because each write succeeds and each routed line
    names a path that really exists. Key the name on `file_unique_id` (Telegram's per-file identity,
    stable across re-sends and distinct between files); fall back to the tail — never the head — of
    file_id when it is absent. A caller-supplied file_name keeps the operator's own name but still
    carries the unique id, so two different `IMG_0001.jpg` cannot collide either."""
    uid = re.sub(r"[^A-Za-z0-9_-]", "", (doc.get("file_unique_id") or "") or (doc.get("file_id") or "")[-12:])[:16] or "nouid"
    given = (doc.get("file_name") or "").replace("/", "_").replace("..", "_").strip()
    if given:
        stem, dot, ext = given.rpartition(".")
        return f"{stem}-{uid}{dot}{ext}" if dot else f"{given}-{uid}"
    if kind == "image":
        return f"photo-{uid}.jpg"
    if kind == "audio":
        return f"audio-{uid}.oga"
    return f"file-{uid}"

def _image_intro(kind, dest, caption):
    """Build the voice-in.log line for an inbound operator IMAGE/FILE — a directive the (vision-capable
    claude) tg mind can act on: it NAMES the saved path to Read and PRESERVES any caption (the operator's
    text sent with the image, previously dropped). Pure (no I/O) so it is testable without firing the
    real Telegram download or kick_feed. (fix 2026-06-20: images were saved to inbox but never routed/
    kick_fed → silently dropped; 'как обычно ты пропустил'.)"""
    if kind == "audio":
        line = (f"operator sent an audio file -> {dest} — this is an AUDIO SOURCE (music/recording, "
                f"not readable text); reply to the operator and use the file as he asks")
    else:
        line = f"operator sent an {kind} -> {dest} — Read this path to see it, then reply to the operator"
    caption = (caption or "").strip()
    if caption:
        line += f" | caption: {caption}"
    return line

WHISPER_FILTER = os.path.expanduser("~/.local/bin/mesh-whisper-filter")

# The SAME annotation alphabet mesh-whisper-filter marks as inline noise (_INLINE_NOISE there).
# It MUST stay a twin of that pattern: this guard decides whether the operator's .oga survives, and an
# annotation form the filter knows but this guard does not reads as speech → the audio is DELETED.
# 2026-07-31 22:29Z: whisper returned '*music* *music* … *s*****' for a 198s track the operator sent as
# a voice note; the old alphabet knew (), [] and ♪ but NOT *…*, so every token counted as residue,
# _music_only said False, and the .oga was unlinked — his source material destroyed on arrival
# (recovered only because the message still lived in his Telegram account). The gate below cross-checks
# the two alphabets against the live filter so this cannot silently drift apart again.
_NOISE_ANNOT = re.compile(r"\[[^\]]*\]|\([^)]*\)|\*[^*]*\*|[♪♫]")

def _music_only(txt):
    """True when a whisper transcript carries NO speech — only annotations like '(upbeat music)',
    '[музыка]', '*music*', '♪'. Pure (no I/O) so it is testable offline. Conservative: any residual
    word outside the annotation marks means speech, keep the normal STT path."""
    if not txt or txt.startswith("[voice:"):
        return False
    residue = _NOISE_ANNOT.sub(" ", txt)
    return re.sub(r"[\s\.,!\?\-–—…]+", "", residue) == ""


def _pitch_axes(wav, timeout=120):
    """(chent, voiced) for a decoded wav via the live `mesh-soundscape --measure`, or (None, None).

    Honest n/a on every failure path — absence must never render as a value (a fabricated 0.0 voiced
    would call every unmeasurable note an instrument). Cost is bounded and off the transcription
    critical path's order of magnitude: measured 3.3s on an 11s chop, 7.5s on the operator's 85s
    take, both on this node."""
    if not SOUNDSCAPE.exists():
        return None, None
    try:
        out = subprocess.run([str(SOUNDSCAPE), "--measure", str(wav)],
                             capture_output=True, text=True, timeout=timeout)
    except Exception as e:
        print(f"[voice-rx] pitch axes failed: {str(e)[:80]}", file=sys.stderr)
        return None, None
    def _ax(name):
        m = re.search(rf"\b{name}=([0-9]*\.?[0-9]+)\b", out.stdout)
        return float(m.group(1)) if m else None
    return _ax("chent"), _ax("voiced")


def _log_voice_file(doc, dest):
    """Record the Telegram identity of an inbound voice note beside where its audio came to rest.

    Without this the ONLY handle on the audio is the local file: when the 21:39Z guitar take was
    unlinked, the bot API could not re-fetch it (getFile needs a file_id that was never written
    down) and it was recovered only through the operator's userbot session. file_id is re-fetchable
    by this bot; file_unique_id is the stable cross-session identity a userbot search can match."""
    try:
        with open(VOICE_FILES_LOG, "a") as f:
            f.write("%s  file_id=%s  file_unique_id=%s  dur=%s  dest=%s\n"
                    % (ts(), (doc or {}).get("file_id", "na"), (doc or {}).get("file_unique_id", "na"),
                       (doc or {}).get("duration", "na"), dest if dest else "na"))
    except OSError as e:
        print(f"[voice-rx] voice-file log failed: {str(e)[:80]}", file=sys.stderr)

def _hold_audio(oga, hold_dir=None, days=None):
    """Move the operator's original voice audio into a BOUNDED hold instead of deleting it.

    Returns the held path (or None if there was nothing to hold / the move failed). Separated from
    transcribe() so the retention contract is assertable offline — transcribe() itself is all
    network I/O, and a rule asserted only inside it is not asserted.
    """
    hold = Path(hold_dir) if hold_dir else (MESH / "voice-hold")
    d = VOICE_HOLD_DAYS if days is None else days
    dest = None
    try:
        hold.mkdir(parents=True, exist_ok=True)
        if oga is not None and Path(oga).exists():
            dest = hold / f"voice-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')}.oga"
            Path(oga).replace(dest)
        cutoff = time.time() - d * 86400
        for old in hold.glob("voice-*.oga"):
            if old.stat().st_mtime < cutoff:
                old.unlink()
    except OSError as e:
        print(f"[voice-rx] voice-hold failed: {str(e)[:80]}", file=sys.stderr)
        return None
    return dest


if len(sys.argv) > 1 and sys.argv[1] == '--test-voice-hold':
    # GATE for the retention contract (2026-08-14). Goes RED if the hold is ever reverted to an
    # unlink, if the prune window stops binding, or if a "speech" transcript can still destroy audio.
    import tempfile
    ok = True
    with tempfile.TemporaryDirectory() as td:
        td = Path(td); hold = td / "hold"
        src = td / "voice-in.oga"; src.write_bytes(b"OGGSfake")
        # 1. A note whose transcript reads as SPEECH must STILL keep its audio. This is the whole
        #    fix: whisper hallucinated fluent lyrics over the operator's guitar recording, so the
        #    text classifier said "speech" and the old code unlinked the file.
        held = _hold_audio(src, hold_dir=hold, days=7)
        if held is None or not held.exists() or held.read_bytes() != b"OGGSfake":
            print("smoke-test: FAIL (audio not held — a misclassified recording would be destroyed)")
            ok = False
        if ok and src.exists():
            print("smoke-test: FAIL (original left in place — transcribe() unlinks it next line)")
            ok = False
        # 2. Retention is BOUNDED, not an archive: anything past the window is pruned.
        if ok:
            stale = hold / "voice-20200101T000000000000Z.oga"; stale.write_bytes(b"old")
            os.utime(stale, (time.time() - 30 * 86400, time.time() - 30 * 86400))
            fresh = _hold_audio(None, hold_dir=hold, days=7)
            if stale.exists():
                print("smoke-test: FAIL (stale hold entry not pruned — retention is unbounded)")
                ok = False
            if ok and not held.exists():
                print("smoke-test: FAIL (prune ate an in-window entry)")
                ok = False
            if ok and fresh is not None:
                print("smoke-test: FAIL (holding nothing must return None, not a path)")
                ok = False
        # 3. Two notes in the same second must not collide (one overwriting the other is a
        #    quieter version of the same data loss).
        if ok:
            a = td / "a.oga"; a.write_bytes(b"A")
            b = td / "b.oga"; b.write_bytes(b"B")
            pa = _hold_audio(a, hold_dir=hold, days=7); pb = _hold_audio(b, hold_dir=hold, days=7)
            if pa is None or pb is None or pa == pb or not (pa.exists() and pb.exists()):
                print("smoke-test: FAIL (same-second notes collide — one recording overwrites another)")
                ok = False
    print("smoke-test: ok" if ok else "smoke-test: FAILED")
    sys.exit(0 if ok else 1)


if len(sys.argv) > 1 and sys.argv[1] == '--test-instrumental':
    # GATE for the AUDIO-side witness (2026-08-14). The offline half asserts the predicate and the
    # routing contract; the LIVE half drives the operator's OWN labelled audio through the real
    # `mesh-soundscape --measure` subprocess — a fixture-driven gate on injected numbers could not
    # see the parse break, and the axes are the whole claim. Exit 2 (honest n/a) where that audio or
    # the measure tract is absent, so mesh-land does not block on a node without them.
    import tempfile
    ok = True
    # 1. Missing axes must NEVER read as music — absence is not a verdict.
    if _instrumental(None, None) or _instrumental(None, 0.1) or _instrumental(0.98, None):
        print("smoke-test: FAIL (an unmeasured note reads as an instrument)"); ok = False
    # 2. The routing line must carry the transcript verbatim — hedging must not become dropping.
    if ok:
        line = _instrumental_intro(0.9882, 0.449, Path("/tmp/x.oga"), "весь текст который он сказал")
        if "весь текст который он сказал" not in line or "/tmp/x.oga" not in line:
            print("smoke-test: FAIL (routing line drops the transcript or the audio path)"); ok = False
        if ok and "not act on it" not in line.lower():
            print("smoke-test: FAIL (routing line does not warn the mind off the hallucination)"); ok = False
    # 3. The file_id is written down — the 21:39Z take could not be re-fetched because it was not.
    if ok:
        with tempfile.TemporaryDirectory() as td:
            VOICE_FILES_LOG = Path(td) / "voice-in-files.log"
            _log_voice_file({"file_id": "AwACFID123", "file_unique_id": "AgADuniq", "duration": 85},
                            Path(td) / "held.oga")
            got = VOICE_FILES_LOG.read_text() if VOICE_FILES_LOG.exists() else ""
            if "AwACFID123" not in got or "AgADuniq" not in got or "held.oga" not in got:
                print("smoke-test: FAIL (voice file_id not logged — a lost note cannot be re-fetched)")
                ok = False
    # 4. LIVE: his guitar take reads instrumental, him TALKING does not. Real audio, real measure.
    fx = Path(os.path.expanduser("~/.mesh/fixtures/guitar-calib"))
    pos, neg = fx / "guitar-take-20260814T2139Z.oga", fx / "speech.wav"
    if not ok:
        pass
    elif not (SOUNDSCAPE.exists() and pos.exists() and neg.exists()):
        print("smoke-test: n/a (operator-labelled audio or mesh-soundscape absent on this node)")
        sys.exit(2)
    else:
        pc, pv = _pitch_axes(pos)
        nc, nv = _pitch_axes(neg)
        if pc is None or nc is None:
            print("smoke-test: FAIL (measure returned no axes — parse or tract broken)"); ok = False
        elif not _instrumental(pc, pv):
            print(f"smoke-test: FAIL (his guitar take reads as speech: chent={pc} voiced={pv})"); ok = False
        elif _instrumental(nc, nv):
            print(f"smoke-test: FAIL (him TALKING reads as an instrument: chent={nc} voiced={nv})"); ok = False
        else:
            print(f"  live: guitar chent={pc} voiced={pv} -> instrumental · speech chent={nc} voiced={nv} -> voice")
    print("smoke-test: ok" if ok else "smoke-test: FAILED")
    sys.exit(0 if ok else 1)


if len(sys.argv) > 1 and sys.argv[1] == '--test-image-routing':
    ok = True
    # ALBUM COLLISION gate (2026-07-25): two DIFFERENT photos of one album must land on two different
    # paths. Real file_ids from a real album — they share the 'AgACAgIA' header the old name sliced,
    # so this assertion goes RED under `file_id[:8]` and can only pass on a per-file identity.
    _a = {"file_id": "AgACAgIAAxkBAAIcsGiC1", "file_unique_id": "AQADvbcxG7Ro8Ep4", "file_size": 191384}
    _b = {"file_id": "AgACAgIAAxkBAAIcsWiC2", "file_unique_id": "AQADvrcxG7Ro8Eq9", "file_size": 189102}
    if _inbox_name("image", _a) == _inbox_name("image", _b):
        print(f"smoke-test: FAIL (album collision — two photos share the inbox name {_inbox_name('image', _a)})"); ok = False
    if ok and _inbox_name("image", _a) != _inbox_name("image", dict(_a)):
        print("smoke-test: FAIL (same photo renamed between calls — re-send would duplicate)"); ok = False
    # a caller-supplied file_name is kept but must still separate two distinct files
    _c = {"file_id": "BQACx1", "file_unique_id": "UNIQ111", "file_name": "IMG_0001.jpg"}
    _d = {"file_id": "BQACx2", "file_unique_id": "UNIQ222", "file_name": "IMG_0001.jpg"}
    if ok and (_inbox_name("file", _c) == _inbox_name("file", _d) or "IMG_0001" not in _inbox_name("file", _c)
               or not _inbox_name("file", _c).endswith(".jpg")):
        print("smoke-test: FAIL (same-named documents collide, or operator's name/extension lost)"); ok = False
    if ok and "/" in _inbox_name("file", {"file_unique_id": "U1", "file_name": "../../etc/passwd"}):
        print("smoke-test: FAIL (path separator survived into the inbox name)"); ok = False
    a = _image_intro("image", "/home/x/.mesh/inbox/photo-ab12cd34.jpg", "вот скрин")
    if "/home/x/.mesh/inbox/photo-ab12cd34.jpg" not in a:
        print("smoke-test: FAIL (saved path not in image line)"); ok = False
    elif "Read this path" not in a:
        print("smoke-test: FAIL (no Read-it directive for the vision mind)"); ok = False
    elif "caption: вот скрин" not in a:
        print("smoke-test: FAIL (caption dropped — operator's text lost)"); ok = False
    b = _image_intro("file", "/tmp/doc.pdf", None)
    if ok and ("caption:" in b or "/tmp/doc.pdf" not in b):
        print("smoke-test: FAIL (no-caption file line wrong)"); ok = False
    c = _image_intro("audio", "/home/x/.mesh/inbox/jam1.aac", "сделай grainneukeln")
    if ok and ("/home/x/.mesh/inbox/jam1.aac" not in c or "AUDIO SOURCE" not in c
               or "caption: сделай grainneukeln" not in c):
        print("smoke-test: FAIL (audio line lacks path/AUDIO-SOURCE directive/caption)"); ok = False
    if ok and not _music_only("(upbeat music) (upbeat music) (music) ..."):
        print("smoke-test: FAIL (pure music-annotation transcript not detected)"); ok = False
    if ok and _music_only("(музыка) ну вот такой трек, сделайте вариации"):
        print("smoke-test: FAIL (real speech misclassified as music-only)"); ok = False
    if ok and _music_only("[voice: transcription timed out (>240s)]"):
        print("smoke-test: FAIL (error placeholder misclassified as music-only)"); ok = False
    # REGRESSION (2026-07-31 22:29Z, verbatim): the operator's 198s track sent as a voice note came
    # back as asterisk-marked annotations. Under the old ()/[]/♪-only alphabet this reads as speech and
    # the .oga is unlinked — his source material destroyed. Fails RED on the pre-fix pattern.
    if ok and not _music_only("*music* *music* *music* *music* *music* *music* *s*****"):
        print("smoke-test: FAIL (asterisk-marked music annotations read as speech — the .oga gets deleted)"); ok = False
    # ALPHABET-DRIFT cross-check: _music_only is a hand-copied twin of mesh-whisper-filter's
    # _INLINE_NOISE. Ask the LIVE filter, don't trust the copy — a form it strips to nothing but this
    # guard keeps is exactly the shape that destroys operator audio. exit-2-style skip if absent.
    if ok and os.path.exists(WHISPER_FILTER):
        for probe in ("*music*", "(upbeat music)", "[музыка]", "♪ ♪", "*музыка* [music] (music)"):
            try:
                r = subprocess.run([WHISPER_FILTER, "--strip", "--text", probe],
                                   capture_output=True, text=True, timeout=10)
            except Exception as e:
                print(f"smoke-test: SKIP (whisper-filter cross-check unavailable: {e})"); break
            if r.stdout.strip() == "" and not _music_only(probe):
                print(f"smoke-test: FAIL (alphabet drift — whisper-filter calls {probe!r} pure noise, "
                      f"_music_only calls it speech → the operator's .oga would be deleted)"); ok = False; break
    print("smoke-test: ok (image/file/audio lines + music-only voice-note detection)" if ok
          else "smoke-test: FAILED")
    sys.exit(0 if ok else 1)

def clean_transcript(txt):
    """Strip whisper hallucination TAILS (subtitle credits 'Редактор субтитров…', [музыка]) off
    real speech before it's logged/boarded/fed to the tg mind — chat-review 2026-06-19: these get
    treated as operator content (a named entity 'А.Семкин' he never said). Reuses the patterns in
    mesh-whisper-filter --strip (one source of truth). CONSERVATIVE: on any failure, or if stripping
    would BLANK otherwise-real speech, keep the original — never lose operator content."""
    if not txt or txt.startswith("[voice:"):
        return txt
    try:
        out = subprocess.run([WHISPER_FILTER, "--strip", "--text", txt],
                             capture_output=True, text=True, timeout=10)
        cleaned = out.stdout.strip()
        return cleaned if cleaned else txt
    except Exception:
        return txt

def _groq_key():
    """GROQ_API_KEY from ~/.mesh/groq.env (gitignored, never the genome). Returns '' if absent."""
    f = MESH / "groq.env"
    if not f.exists():
        return ""
    try:
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if ln.startswith("GROQ_API_KEY="):
                return ln.partition("=")[2].strip().strip('"').strip("'")
    except OSError:
        pass
    return ""

def groq_stt(wav):
    """CLOUD fallback STT when local whisper.cpp can't run (admission-refused under memory pressure →
    empty stdout, which used to surface as a FAKE '[voice: empty transcript]'; honest-fusion 2026-07-07).
    Groq hosts whisper-large-v3-turbo and needs ZERO local RAM, so voice survives an OOM-pressured node.
    Returns the transcript text, or None on any failure (no key / network / API error / truly empty)."""
    key = _groq_key()
    if not key or not wav.exists():
        return None
    try:
        data = wav.read_bytes()
    except OSError:
        return None
    boundary = "----meshvoicerx" + str(len(data))
    model = os.environ.get("MESH_GROQ_STT_MODEL", "whisper-large-v3-turbo")
    parts = []
    def _field(name, value):
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode())
    _field("model", model)
    _field("response_format", "text")
    parts.append((f'--{boundary}\r\nContent-Disposition: form-data; name="file"; '
                  f'filename="voice.wav"\r\nContent-Type: audio/wav\r\n\r\n').encode())
    parts.append(data)
    parts.append(f"\r\n--{boundary}--\r\n".encode())
    body = b"".join(parts)
    req = urllib.request.Request(
        "https://api.groq.com/openai/v1/audio/transcriptions", data=body,
        headers={"Authorization": f"Bearer {key}",
                 "Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            txt = r.read().decode("utf-8", "replace").strip()
        return txt or None
    except Exception as e:
        print(f"[voice-rx] groq_stt failed: {str(e)[:80]}", file=sys.stderr)
        return None

def transcribe(file_id, doc=None, spooled=None):
    oga = MESH / "voice-in.oga"; wav = MESH / "voice-in.wav"
    if spooled and Path(spooled).exists():
        # SPOOL-FIRST consumer. The bytes are already on disk; re-downloading them would re-run the
        # exact network step that lost update 879098783 on an SSL timeout, for no new information.
        # COPY, never move — the spool is the durable catch and this function ends by unlinking its
        # working copy, so a move would make the interpreter destroy the material again.
        import shutil as _sh_tr
        _sh_tr.copyfile(str(spooled), str(oga))
    else:
        info = get("getFile", file_id=file_id)
        path = info.get("result", {}).get("file_path")
        if not path: return "[voice: getFile failed]"
        urllib.request.urlretrieve(f"{FILEAPI}/{path}", oga)
    subprocess.run([FFMPEG, "-y", "-i", str(oga), "-ar", "16000", "-ac", "1", str(wav)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wav.exists(): return "[voice: ffmpeg failed]"
    local_admit_refused = False; local_timed_out = False
    budget = _whisper_budget(wav); wav_secs = _wav_seconds(wav)
    try:
        out = subprocess.run([str(WHISPER), "-m", str(MODEL), "-f", str(wav), "-nt", "-l", "auto"],
                             capture_output=True, text=True, timeout=budget)
        # rc 75 = the whisper-run admission gate REFUSED (node too memory-pressured to run the ~2GB
        # job) → stdout is empty but the audio was NEVER transcribed. Do NOT surface that as an
        # "empty transcript" (a FAKE — the operator DID speak). Fall through to the cloud fallback.
        local_admit_refused = (out.returncode == 75)
        txt = clean_transcript(" ".join(out.stdout.split()).strip())
    except subprocess.TimeoutExpired:
        # CRITICAL: never let a slow transcription RAISE — it would propagate to poll_once and stop
        # the offset advancing, wedging the WHOLE inbound queue on one note. Fall through to cloud.
        local_timed_out = True; txt = ""
    except Exception as e:
        print(f"[voice-rx] local whisper error: {str(e)[:80]}", file=sys.stderr)
        txt = ""
    # CLOUD FALLBACK: local whisper produced nothing (admission-refused under memory pressure, timed
    # out, or errored). Groq STT needs zero local RAM, so voice survives an OOM-pressured node instead
    # of the mesh going silently deaf. Only reached when local yields empty — a real local transcript
    # is authoritative and never overridden. (honest-fusion, 2026-07-07 empty-transcript incident.)
    if not txt:
        cloud = groq_stt(wav)
        if cloud:
            txt = clean_transcript(" ".join(cloud.split()).strip())
    # The RAW transcript, captured BEFORE the music/instrumental classifiers below can replace `txt`
    # with a description sentence. The verb lane's cheap short-circuit reads the operator's FIRST
    # WORD; both classifiers rewrite txt into prose that starts with "operator sent a voice note…",
    # which would make hint_says_no() rule out a real «грайнд <гитара>» note — the exact note most
    # likely to trip the instrumental classifier. So the hint is taken from the words he actually said.
    verb_hint = txt

    # prosody hook: read HOW the operator sounds (energy/rate/pitch) off the SAME decoded wav for
    # mesh-operator-mood's arousal co-primary — best-effort, never let it delay/raise into the poll
    # loop (short note → <1s; capped anyway). Operator-only (this path is already CHAT_ID-gated); the
    # tool persists only derived scalars, never the audio (local-only, within granted mood consent).
    try:
        subprocess.run([os.path.expanduser("~/.local/bin/mesh-voice-prosody"), str(wav)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except Exception:
        pass
    # TWO INDEPENDENT WITNESSES that a note is music, because they fail in opposite directions:
    # the TEXT one (_music_only) is certain when whisper annotates ('*music*', '[музыка]') and blind
    # when it hallucinates lyrics; the AUDIO one (_instrumental) cannot be fooled by the transcript at
    # all but rests on a small labelled sample. Consult text first — it is the stronger claim when it
    # fires — and let audio catch only what text structurally cannot see.
    chent, voiced = _pitch_axes(wav)
    saved = None
    if _music_only(txt):
        # the transcript is ONLY non-speech annotations — the audio itself is the payload (operator
        # recorded music as a voice note). Save the original opus instead of discarding it.
        inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
        dest = inbox / f"voice-music-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}.oga"
        try:
            oga.replace(dest)
            saved = dest
            txt = (f"operator sent a voice note that is MUSIC, not speech (transcript was only music "
                   f"annotations) — saved to {dest}; if he asked for remixes/processing, use this file "
                   f"as the source, and reply to the operator")
        except OSError:
            pass
    elif _instrumental(chent, voiced):
        # The text says speech; the AUDIO says a played instrument. This is the 2026-08-14 case: a
        # guitar take that came back as a full lyric. Never DROP the transcript (a real note recorded
        # over a guitar would lose the operator's words) — surface both, marked, and put the audio
        # where a request to process it can reach it. The hedge is the point: the mind must not act on
        # a hallucinated lyric as if it were an instruction.
        inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
        dest = inbox / f"voice-instrumental-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}.oga"
        try:
            oga.replace(dest)
            saved = dest
        except OSError:
            dest = None
        txt = _instrumental_intro(chent, voiced, dest, txt)
    # HOLD, don't destroy. The line below used to `unlink()` the operator's original .oga whenever
    # `_music_only(txt)` was False — i.e. the irreversible step was gated on a TEXT classifier reading
    # a hallucination-prone transcript. That gate cannot see the case it most needs to: whisper does
    # not always render music as annotations, it sometimes hallucinates fluent LYRICS. Then the
    # transcript is indistinguishable from speech by text alone, `_music_only` says False (correctly,
    # on the text it was given), and the audio is deleted.
    # 2026-08-14 21:41Z, the second time this destroyed operator material: he sent a GUITAR RECORDING
    # made on the mac, asking us to calibrate the guitar-extraction with it. whisper returned a full
    # verse-and-chorus lyric over the instrumental; no alphabet widening can catch that (the
    # 2026-07-31 fix at _NOISE_ANNOT widened the alphabet and is orthogonal). The .oga was unlinked
    # and the recording exists nowhere on this node — only in his Telegram account.
    # So: stop deciding destruction from a guess. A misclassification now costs disk, not the
    # material. Retention stays BOUNDED (the privacy stance is unchanged in kind — the audio was
    # never meant to live forever, only to survive long enough to be recoverable).
    held = _hold_audio(oga)
    _log_voice_file(doc or {"file_id": file_id}, saved or held)
    # ── «ГРАЙНД» VERB LANE (operator 2026-08-21: «хочется просто говорить „грайнд"») ─────────────
    # mesh-voice-verb existed with a green --test and NO CALLER anywhere on this node — detection
    # without delivery, so «Грайнд Миша» (14:46:32Z) produced exactly nothing. This is the call that
    # was missing. Three properties it must have, each learned the hard way in this very file:
    #  · DETACHED. The verb pass runs a SECOND whisper (word timestamps) and the grind is minutes of
    #    render. Inline, a slow note would wedge the WHOLE inbound queue behind one message — the
    #    failure the transcription block above is already armoured against. start_new_session so it
    #    outlives this poll cycle and is not killed with the loop.
    #  · ON A SURVIVING PATH. `oga` is unlinked three lines below, so hand the child the HELD copy
    #    (or the saved one) — the lifecycle-managed file, not the one we are about to destroy. If
    #    holding is disabled and nothing was saved there is no durable source; skip rather than race
    #    the unlink, and say so in the log instead of failing invisibly.
    #  · NEVER RAISING. A verb-lane error must not cost the operator his message; the transcript
    #    below is returned either way.
    _verb_src = saved or held
    if _verb_src and not _NO_POLL_TEST:
        try:
            subprocess.Popen([os.path.expanduser("~/.local/bin/mesh-voice-grind"),
                              str(_verb_src), verb_hint or ""],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        except Exception as e:
            print(f"[voice-rx] verb lane spawn failed: {str(e)[:80]}", file=sys.stderr)
    elif not _verb_src:
        print("[voice-rx] verb lane SKIPPED: no held/saved copy of the note "
              "(MESH_VOICE_HOLD_DAYS=0?) — the audio is about to be unlinked", file=sys.stderr)
    for p in (oga, wav):
        try: p.unlink()
        except OSError: pass
    if txt:
        return txt
    # Still empty after local + cloud. Be HONEST about WHY: an admission-refused local run means the
    # operator spoke but the node was too loaded to transcribe and the cloud fallback also failed —
    # tell them to resend as text, never fake a content-free "empty transcript" that reads as "he sent
    # nothing" (the 2026-07-07 incident: 4 real notes surfaced as blanks → operator "Mesh, wtf?!").
    if local_admit_refused:
        return ("[voice: node too memory-pressured to transcribe and cloud STT unavailable — "
                "your note was NOT empty; please resend as text if urgent]")
    if local_timed_out:
        # Name the BUDGET and the DURATION, not just "load": a note longer than the ceiling allows
        # is a different fault from a node too busy to keep up, and the old message could not tell
        # the operator which one he hit (nor the next hand where to look).
        _d = f"{wav_secs:.0f}s note" if wav_secs is not None else "note of unknown length"
        return (f"[voice: local transcription exceeded its {budget}s budget for a {_d} and cloud STT "
                "was unavailable — your note was NOT empty; please resend as text if urgent]")
    return "[voice: empty transcript]"

def handle(update):
    msg = update.get("message") or update.get("edited_message")
    if not msg: return
    frm = (msg.get("from") or {}).get("id")
    if frm != OWNER:
        with open(STRANGERS, "a") as f:
            f.write(f"{ts()}  from={frm}  {json.dumps((msg.get('text') or '[non-text]')[:500])}\n")
        return
    if msg.get("voice"):
        # voice NOTES only — TG "audio" (music files) must NOT ride the STT path: it used to be
        # transcribed to "(upbeat music)…" garbage and the file DELETED (2026-07-06: operator's 3
        # jam tracks lost — 1 garbled, 2 silently dropped). Audio routes to the inbox branch below.
        fid = msg["voice"]["file_id"]
        txt = transcribe(fid, msg["voice"], spooled=spool_audio_path(update))
        write("VOICE", txt)
        typing_start(); kick_feed(); post_to_board(txt)
    elif msg.get("text"):
        write("TEXT", msg["text"])
        typing_start(); kick_feed(); post_to_board(msg["text"])
    elif msg.get("photo") or msg.get("document") or msg.get("audio"):
        # operator screenshots/files → download into ~/.mesh/inbox AND route to the tg mind exactly like
        # text/voice (typing_start + kick_feed + post_to_board) so a VISION-CAPABLE mind Reads + replies,
        # instead of silently saving. Routing is tg-mind-ONLY (kick_feed pokes its pane; post_to_board
        # writes the dedicated OPERATOR_FYI_LOG, never chat.log) — preserving the 2026-06-18 doctrine that
        # kept vision-less opencode minds from confabulating on the operator's screenshots. Every outcome
        # (saved / download-failed / getFile-failed) routes, so the operator never gets silence.
        is_photo = bool(msg.get("photo"))
        if is_photo:
            doc = max(msg["photo"], key=lambda p: p.get("file_size") or 0)  # largest rendition
            kind = "image"
        elif msg.get("audio"):
            doc = msg["audio"]
            kind = "audio"
        else:
            doc = msg["document"]
            kind = "file"
        name = _inbox_name(kind, doc)
        info = get("getFile", file_id=doc["file_id"])
        path = info.get("result", {}).get("file_path")
        err = (info.get("description") or "").lower()
        saved = None
        if path:
            inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
            dest = inbox / name
            try:
                urllib.request.urlretrieve(f"{FILEAPI}/{path}", dest)
                line = _image_intro(kind, dest, msg.get("caption"))
                saved = dest
            except Exception as e:
                line = f"operator sent an {kind} but the download FAILED ({e}) — tell the operator it didn't arrive and ask him to resend"
        elif "too big" in err:
            # Bot API hard cap: getFile refuses files >20MB — resending the SAME file can never work
            line = (f"operator sent an {kind} ({name}) that is OVER Telegram's 20MB bot download limit — "
                    f"tell the operator resending won't help; ask him to split it or compress it under 20MB")
        else:
            line = f"operator sent an {kind} but getFile FAILED ({name}: {err or 'no file_path'}) — tell the operator it couldn't be fetched and ask him to resend"
        write("DOCUMENT", line)
        # A DOCUMENT the operator sends is work he expects done; the pane inject + fyi-log are both
        # lossy (mid-turn composer-swallow / next /clear), so file it as a durable board [task] claim
        # FIRST — before the lossy carriers, so a pane-inject failure can never strand the claim. Only
        # a successfully-saved file (a real inbox artifact to act on); mesh-promises ages the claim.
        if kind == "file" and saved is not None:
            post_task_to_board(saved, msg.get("caption"))
        typing_start(); kick_feed(); post_to_board(line)
    else:
        write("MSG", "[non-text/voice message]")

if len(sys.argv) > 1 and sys.argv[1] == '--test-document-board-claim':
    # GATE for operator-document-has-no-durable-claim: drive a fake DOCUMENT update through handle()
    # with the pane inject FORCED TO FAIL (kick_feed raises), and assert a durable board [task] row
    # landed in chat.log anyway. RED before the fix (handle wrote only the fyi-log, never chat.log).
    import tempfile, shutil as _sh
    if not os.path.exists(CHAT_CMD):
        print("smoke-test: n/a (mesh-chat not deployed — board carrier absent)", flush=True)
        sys.exit(2)
    td = tempfile.mkdtemp(prefix="voicerx-doctest-"); tdp = Path(td)
    globals()["MESH"] = tdp                                  # inbox + fyi-log → temp
    globals()["OPERATOR_FYI_LOG"] = tdp / "operator-fyi.log"
    globals()["OWNER"] = 999999
    os.environ["MESH_DIR"] = str(tdp)                        # mesh-chat writes chat.log here
    os.environ["MESH_WHO"] = "tg-rx@test"
    chatlog = tdp / "chat.log"
    def _boom(*a, **k): raise RuntimeError("pane inject failed (composer swallow)")
    globals()["kick_feed"] = _boom                           # pane inject FORCED TO FAIL
    globals()["typing_start"] = lambda *a, **k: None
    globals()["write"] = lambda *a, **k: None
    globals()["get"] = lambda method, **p: {"result": {"file_path": "documents/render-sim"}}
    urllib.request.urlretrieve = lambda url, dest: Path(dest).write_bytes(b"# task doc\n")
    upd = {"message": {"from": {"id": 999999}, "chat": {"id": 999999}, "message_id": 7,
                       "document": {"file_id": "BQACdoc", "file_unique_id": "u7",
                                    "file_name": "render-sim.md"},
                       "caption": "please work this render sim"}}
    try:
        handle(upd)                                          # pane failure must NOT strand the claim
    except Exception:
        pass
    board = chatlog.read_text() if chatlog.exists() else ""
    ok = ("[task]" in board and "render-sim" in board and "owner: tg" in board
          and "please work this render sim" in board)
    try: _sh.rmtree(td)
    except Exception: pass
    if not ok:
        print(f"smoke-test: FAIL (document produced no durable board [task] row; board={board!r})", flush=True)
        sys.exit(1)
    print("smoke-test: ok (operator document -> durable board [task] claim despite pane-inject failure)", flush=True)
    sys.exit(0)

# --- SPOOL-FIRST: the raw update is durable BEFORE anything interprets it --------------------
# 2026-08-21, operator: "где бы полер ни был, должно доставляться". Two independent losses in one
# night, and neither needed the other:
#   (1) a SECOND poller (phaedra, pid 3307678) won the getUpdates race, had no whisper stack, and
#       wrote every note it stole into its OWN /root/.mesh/voice-in.log as "[voice: empty
#       transcript]" — destruction on a machine nobody reads;
#   (2) update 879098783 died on an SSL timeout INSIDE handle() at 02:36:46Z and was lost for
#       good, because poll_once advances the offset unconditionally. That one needed no second
#       poller at all — a lone receiver loses it identically.
# Both are one shape: the only copy of the operator's words was produced by INTERPRETING them, so
# every interpretation failure was a destruction. The fix separates CATCHING from READING. The
# spool is the catch — the update's JSON, and for a voice note the raw opus bytes, fsynced under
# the update_id BEFORE handle() is called. Interpretation then reads the spool; an interpreter
# that dies leaves the material on disk, and a poller on a node that cannot transcribe still holds
# an update_id-keyed artifact another node can merge, instead of a ruined transcript.
# BOUNDARY, stated rather than implied: bytes are spooled for VOICE ONLY. Photos/documents/audio
# already land in ~/.mesh/inbox and carry a durable board [task] row (its own gate at
# --test-document-board-claim), and re-fetching a 20MB document buys nothing. Widen this
# deliberately, never by reflex.
SPOOL_DIR = Path(os.environ.get("MESH_TG_SPOOL", str(MESH / "tg-spool")))
SPOOL_LOG = Path(os.environ.get("MESH_TG_SPOOL_LOG", str(MESH / "tg-spool.log")))
SPOOL_KEEP_DAYS = float(os.environ.get("MESH_TG_SPOOL_DAYS", "7"))
# A spool failure must NOT advance the offset — that is the entire point. But it must not wedge the
# queue forever either (the hazard the old unconditional advance was written against), so the hold
# is BOUNDED and giving up is LOUD: after this many consecutive failures on one update_id the
# offset advances, handle() still gets its best-effort try (never WORSE than the old path), and a
# SPOOL-FAILED line reaches the log the operator's mind actually reads. Silence is not available in
# either direction.
SPOOL_MAX_ATTEMPTS = int(os.environ.get("MESH_TG_SPOOL_ATTEMPTS", "3"))
_SPOOL_FAILS = {}

def _fsync_write(path, data):
    """Write atomically and fsync BOTH the file and its directory.

    Without the DIRECTORY fsync the rename itself can be lost on power failure, leaving exactly the
    state this mechanism exists to prevent: an advanced offset and no artifact. A tmp name in the
    same directory (not with_suffix, which chokes on a two-dot suffix) keeps the replace atomic.
    """
    path = Path(path)
    if isinstance(data, str):
        data = data.encode()
    tmp = path.parent / (path.name + ".part")
    with open(tmp, "wb") as f:
        f.write(data); f.flush(); os.fsync(f.fileno())
    tmp.replace(path)
    dfd = os.open(str(path.parent), os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)
    return path

def spool_voice_doc(update):
    """The voice payload of an update, or None. Separate so the routing is assertable offline.

    OWNER-gated on purpose: a stranger's update is logged and never fetched, so spooling can never
    be used to make this node download a file on an unauthenticated party's command.
    """
    msg = update.get("message") or update.get("edited_message") or {}
    if (msg.get("from") or {}).get("id") != OWNER:
        return None
    return msg.get("voice")

def spool_audio_path(update):
    """Where spool_update put this update's opus, or None. The consumer's half of the contract."""
    uid = (update or {}).get("update_id")
    if uid is None:
        return None
    p = SPOOL_DIR / f"{uid}.oga"
    return p if p.exists() else None

def _spool_note(uid, update, apath):
    """One manifest row per caught update — update_id keyed, so two nodes' spools MERGE and DEDUPE.

    The ledger outlives the bytes (the prune below is bounded): after the audio is gone the row is
    still the handle by which a note is known to have arrived, and by whom it was caught.
    """
    msg = (update.get("message") or update.get("edited_message") or {})
    kind = ("voice" if msg.get("voice") else "text" if msg.get("text") else
            "photo" if msg.get("photo") else "document" if msg.get("document") else
            "audio" if msg.get("audio") else "other")
    try:
        with open(SPOOL_LOG, "a") as f:
            f.write("%s  node=%s  update_id=%s  kind=%s  audio=%s  bytes=%s\n"
                    % (ts(), os.uname().nodename, uid, kind,
                       apath.name if apath else "na",
                       apath.stat().st_size if apath and apath.exists() else "na"))
    except OSError as e:
        print(f"[rx] spool ledger write failed: {str(e)[:80]}", file=sys.stderr)

def _spool_prune():
    """Bounded retention, same stance as voice-hold: long enough to recover, not an archive."""
    cutoff = time.time() - SPOOL_KEEP_DAYS * 86400
    try:
        for old in SPOOL_DIR.iterdir():
            try:
                if old.is_file() and old.stat().st_mtime < cutoff:
                    old.unlink()
            except OSError:
                pass
    except OSError:
        pass

def spool_update(update):
    """Make the update durable BEFORE it is interpreted. True = caught.

    False means the CATCH failed (getFile / download / disk), NOT that the update was bad — the
    caller must then hold the offset so Telegram re-offers the same update on the next poll.
    """
    uid = update.get("update_id")
    if uid is None:
        return True                      # nothing to key on; no worse than the old path
    try:
        SPOOL_DIR.mkdir(parents=True, exist_ok=True)
        _fsync_write(SPOOL_DIR / f"{uid}.json", json.dumps(update, ensure_ascii=False))
        doc = spool_voice_doc(update)
        apath = None
        if doc and doc.get("file_id"):
            apath = SPOOL_DIR / f"{uid}.oga"
            if not apath.exists():       # idempotent: a retry after a partial batch re-fetches nothing
                info = get("getFile", file_id=doc["file_id"])
                fp = ((info or {}).get("result") or {}).get("file_path")
                if not fp:
                    raise RuntimeError(f"getFile: {(info or {}).get('description') or 'no file_path'}")
                with urllib.request.urlopen(f"{FILEAPI}/{fp}", timeout=120) as r:
                    blob = r.read()
                if not blob:
                    # A zero-byte catch is a FAILED catch, not a caught silence. Distinguishing
                    # these two is the whole lesson of "[voice: empty transcript]".
                    raise RuntimeError("downloaded 0 bytes")
                _fsync_write(apath, blob)
        _spool_note(uid, update, apath)
        _spool_prune()
        return True
    except Exception as e:
        print(f"[rx] spool FAILED for update {uid}: {str(e)[:120]}", file=sys.stderr)
        return False

def poll_once(offset):
    data = get("getUpdates", timeout=25, offset=offset)
    if not data.get("ok"):
        desc = (data.get("description") or "").lower()
        cls = "conflict" if ("conflict" in desc or "terminated by other" in desc) else "http"
        write_rx_state(f"ERR:{cls}")
        print(f"[rx] getUpdates not ok: {data.get('description')}", file=sys.stderr); return offset
    write_rx_state("OK")   # reached Telegram → operator channel is UP (the axis mesh-stress consumes)
    for up in data.get("result", []):
        uid = up.get("update_id")
        # SPOOL-FIRST. The offset is the mesh's only claim that an update was RECEIVED, and it used
        # to advance on nothing but "Telegram handed us JSON" — so any failure downstream of that
        # (download, ffmpeg, whisper, a poller with no whisper at all) converted the operator's words
        # into a permanent absence. Now the offset moves only once the raw material is on disk.
        if not spool_update(up):
            n = _SPOOL_FAILS.get(uid, 0) + 1
            _SPOOL_FAILS[uid] = n
            write_rx_state("ERR:spool")
            if n < SPOOL_MAX_ATTEMPTS:
                # HOLD the offset — Telegram re-offers this update (and everything behind it) on the
                # next poll. This is a deliberate, bounded wedge: ~SPOOL_MAX_ATTEMPTS poll cycles.
                print(f"[rx] spool attempt {n}/{SPOOL_MAX_ATTEMPTS} failed for {uid}; holding offset",
                      file=sys.stderr)
                return offset
            # Bounded hold expired. Fall through to handle() — best-effort interpretation is exactly
            # the OLD behaviour, so giving up is never worse than before it existed — but say so in
            # the log the mind reads, because a loss the operator learns about can be resent and a
            # loss recorded only on stderr cannot.
            print(f"[rx] spool giving up on {uid} after {n} attempts; interpreting unspooled",
                  file=sys.stderr)
            try:
                write("FYI", f"[spool-failed] the raw material for update {uid} could not be saved "
                             f"after {n} attempts — if this was a voice note and it comes back empty, "
                             f"ask the operator to resend")
            except Exception:
                pass
        else:
            _SPOOL_FAILS.pop(uid, None)
        try:
            if not already_processed(up):
                handle(up)
                _mark_processed(update_key(up), message_key(up))
        except Exception as e:
            # Still non-fatal, and now genuinely non-destructive: the spool holds the raw update, so
            # an un-handleable one costs an interpretation, not the material.
            print(f"[rx] handle failed for update {up.get('update_id')}: {e}", file=sys.stderr)
        offset = up["update_id"] + 1
        OFFSET_F.write_text(str(offset))
        _watchdog_ping()   # handle() can run minutes (download + whisper); still alive, still working
    return offset

if len(sys.argv) > 1 and sys.argv[1] == '--test-spool':
    # GATE for SPOOL-FIRST (2026-08-21). The claim under test is NOT "a spool directory exists" —
    # that is a mode bit. It is the OFFSET CONTRACT: the receipt marker may move only after the raw
    # material is on disk, and when it cannot be, the hold is bounded and the giving-up is audible.
    # Every arm below was seen RED against a mutant before this was trusted (see the commit body).
    import tempfile, shutil as _sh, types
    fails = []
    def _t(ok, msg):
        if not ok: fails.append(msg)
    td = Path(tempfile.mkdtemp(prefix="spool-gate-"))
    g = globals()
    g["SPOOL_DIR"] = td / "spool"
    g["SPOOL_LOG"] = td / "spool.log"
    g["OFFSET_F"] = td / "offset"
    g["RX_STATE"] = td / "rx-state"
    g["OWNER"] = 4242
    g["SPOOL_MAX_ATTEMPTS"] = 3
    g["_SPOOL_FAILS"] = {}

    wrote = []
    g["write"] = lambda kind, text: wrote.append((kind, text))
    handled = []
    g["handle"] = lambda up: handled.append(up.get("update_id"))
    g["already_processed"] = lambda up: False
    g["_mark_processed"] = lambda *a: None
    g["_watchdog_ping"] = lambda: None
    g["kick_feed"] = lambda: None

    def _voice_update(uid, from_id=4242):
        return {"update_id": uid,
                "message": {"message_id": uid, "chat": {"id": from_id}, "from": {"id": from_id},
                            "voice": {"file_id": f"fid{uid}", "file_unique_id": f"u{uid}",
                                      "duration": 3}}}

    calls = {"getFile": 0, "download": 0}
    dl_ok = {"v": True}
    def _fake_get(method, **params):
        if method == "getFile":
            calls["getFile"] += 1
            return {"ok": True, "result": {"file_path": "voice/x.oga"}}
        return {"ok": True, "result": []}
    class _Resp:
        def __init__(self, blob): self.blob = blob
        def read(self): return self.blob
        def __enter__(self): return self
        def __exit__(self, *a): return False
    def _fake_urlopen(url, timeout=None):
        calls["download"] += 1
        if not dl_ok["v"]:
            raise urllib.error.URLError("simulated SSL timeout (the 879098783 failure)")
        return _Resp(b"OPUSOPUSOPUS")
    g["get"] = _fake_get
    _real_urlopen = urllib.request.urlopen
    urllib.request.urlopen = _fake_urlopen

    def _poll(updates):
        g["get"] = lambda method, **p: ({"ok": True, "result": updates} if method == "getUpdates"
                                        else _fake_get(method, **p))
        try:
            return poll_once(int(OFFSET_F.read_text()) if OFFSET_F.exists() else 0)
        finally:
            g["get"] = _fake_get

    # ---- A) HAPPY PATH: caught, then interpreted, then the receipt moves ----------------------
    off = _poll([_voice_update(100)])
    _t((SPOOL_DIR / "100.json").exists(), "spool did not write the update JSON")
    _t((SPOOL_DIR / "100.oga").read_bytes() == b"OPUSOPUSOPUS" if (SPOOL_DIR / "100.oga").exists()
       else False, "spool did not write the raw opus bytes")
    _t(SPOOL_LOG.exists() and "update_id=100" in SPOOL_LOG.read_text(),
       "spool ledger has no row for the caught update (two nodes cannot merge/dedupe without it)")
    _t("kind=voice" in (SPOOL_LOG.read_text() if SPOOL_LOG.exists() else ""),
       "spool ledger row does not name the kind")
    _t(off == 101 and OFFSET_F.read_text() == "101", f"offset did not advance after a good catch ({off})")
    _t(handled == [100], f"handle() was not reached on the happy path ({handled})")

    # ---- B) CATCH FAILS: the receipt must NOT move -------------------------------------------
    dl_ok["v"] = False
    handled.clear()
    before = OFFSET_F.read_text()
    off = _poll([_voice_update(200)])
    _t(off == 101, f"offset ADVANCED past an update whose raw material was never saved ({off})")
    _t(OFFSET_F.read_text() == before, "offset file moved past an uncaught update")
    _t(not (SPOOL_DIR / "200.oga").exists(), "a failed download left an artifact behind")
    _t(handled == [], f"an uncaught update was interpreted anyway on attempt 1 ({handled})")
    _t(RX_STATE.exists() and RX_STATE.read_text().startswith("ERR:spool"),
       "a spool failure is invisible in the rx state a watchdog reads")

    # ---- B2) A ZERO-BYTE CATCH IS A FAILED CATCH, NOT A CAUGHT SILENCE ----------------------
    # This is the "[voice: empty transcript]" lesson at the catch layer: an empty artifact that is
    # accepted is indistinguishable from a note the operator never sent.
    dl_ok["v"] = True
    _empty = {"v": True}
    _prev_urlopen = urllib.request.urlopen
    urllib.request.urlopen = lambda url, timeout=None: _Resp(b"")
    _t(spool_update(_voice_update(250)) is False, "a 0-byte download was accepted as a caught note")
    _t(not (SPOOL_DIR / "250.oga").exists(), "a 0-byte download left an empty artifact on disk")
    urllib.request.urlopen = _prev_urlopen
    dl_ok["v"] = False

    # ---- C) THE HOLD IS BOUNDED, AND GIVING UP IS AUDIBLE ------------------------------------
    off = _poll([_voice_update(200)])                       # attempt 2 — still holding
    _t(off == 101, f"the hold released early, at attempt 2 ({off})")
    off = _poll([_voice_update(200)])                       # attempt 3 — bounded hold expires
    _t(off == 201, f"the bounded hold never released — one bad note wedges the whole queue ({off})")
    _t(handled == [200], f"giving up did not fall through to best-effort handle() ({handled})")
    _t(any("spool-failed" in t for _, t in wrote),
       "the mesh gave up on the operator's material and said so NOWHERE the mind reads")

    # ---- D) THE CONSUMER READS THE SPOOL, IT DOES NOT RE-FETCH -------------------------------
    dl_ok["v"] = True
    _poll([_voice_update(300)])
    n_get, n_dl = calls["getFile"], calls["download"]
    spooled = spool_audio_path(_voice_update(300))
    _t(spooled is not None and spooled.exists(), "spool_audio_path cannot find what spool_update wrote")
    # Guarded, so a mutant that never spools bytes at all FAILS BY NAME instead of raising an
    # AttributeError — an assertion that dies before it speaks tells the next reader nothing.
    if spooled is not None and spooled.exists():
        try:
            transcribe("fid300", {"file_id": "fid300"}, spooled=spooled)
        except Exception as e:
            _t(False, f"transcribe on a spooled note raised: {str(e)[:80]}")
        _t(calls["getFile"] == n_get and calls["download"] == n_dl,
           "transcribe RE-FETCHED a note whose bytes were already spooled (the lost-update step, re-run)")
        _t(spooled.exists(), "transcribe DESTROYED the spooled original (moved instead of copied)")

    # ---- E) A STRANGER'S UPDATE IS NEVER FETCHED ---------------------------------------------
    _t(spool_voice_doc(_voice_update(400, from_id=9999)) is None,
       "a stranger's voice note is spooled — an unauthenticated party can make this node download")
    _t(spool_voice_doc(_voice_update(401)) is not None, "the OWNER's voice note is not spooled")

    urllib.request.urlopen = _real_urlopen
    try: _sh.rmtree(td)
    except Exception: pass
    if fails:
        print("smoke-test: FAIL (" + "; ".join(fails) + ")", flush=True); sys.exit(1)
    print("smoke-test: ok (spool-first: the offset moves only after the raw material is on disk; "
          "the hold is bounded and audible; the consumer reads the spool)", flush=True)
    sys.exit(0)

def main():
    if not TOKEN or not OWNER: sys.exit("BOT_TOKEN/CHAT_ID not set")
    offset = int(OFFSET_F.read_text()) if OFFSET_F.exists() else 0
    once = "--once" in sys.argv
    print(f"[mesh-voice-rx] listening (owner={OWNER}) -> {LOG}", flush=True)
    if not once:
        _announce_start()   # reads RX_STATE mtime BEFORE the first cycle overwrites it
    _sd_notify("READY=1")
    import urllib.error
    backoff = 0   # 409 = another getUpdates consumer owns this bot (historically proxy-bot.service on
                  # default-string — retired 2026-06-13 after it silently ate operator messages).
                  # Telegram allows ONE poller per token, so persistent 409 means a competing poller is
                  # live SOMEWHERE on the mesh — hunt it down, don't just back off. DON'T hammer (was
                  # retrying every 3s, spamming 409): exponential backoff, reset on a clean poll.
    while True:
        try:
            offset = poll_once(offset); backoff = 0
        except urllib.error.HTTPError as e:
            if e.code == 409:
                write_rx_state("ERR:conflict")
                backoff = min((backoff or 1) * 2, 120)
                print(f"[rx] 409 Conflict — another poller owns this bot; yielding {backoff}s", file=sys.stderr)
                time.sleep(backoff)
            else:
                write_rx_state(f"ERR:{_err_class(e)}")
                print(f"[rx] HTTP {e.code}", file=sys.stderr); time.sleep(3)
        except Exception as e:
            # DNS/getaddrinfo (the 2026-07-25 DEAF incident) is a URLError and lands here, NOT in the
            # HTTPError arm above — record its class so mesh-stress's operator-channel axis can see it.
            write_rx_state(f"ERR:{_err_class(e)}")
            print(f"[rx] {e}", file=sys.stderr); time.sleep(3)
        # Per ITERATION, not per success: a DNS outage loops honestly and must survive; only a stall
        # inside the poll (the 2026-08-21 hang) stops reaching here and earns the systemd restart.
        _watchdog_ping()
        if once: break

if __name__ == "__main__":
    main()
