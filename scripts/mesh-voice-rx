#!/usr/bin/env python3
"""mesh-voice-rx — the mesh HEARS the operator over Telegram. Receives the operator's messages
(TEXT and VOICE) via the bot's getUpdates (proxy-bot retired -> token free), downloads voice notes
and transcribes them with whisper, and writes everything as text into the voice channel
(~/.mesh/voice-in.log). Operator-only (CHAT_ID); strangers are logged, never answered.
smoke-test: --test checks BOT_TOKEN + CHAT_ID presence

  mesh-voice-rx           poll loop -> append to ~/.mesh/voice-in.log
  mesh-voice-rx --once    one poll cycle (for testing)
  mesh-voice-rx --test    smoke test
"""
import os, sys, json, time, subprocess, urllib.request, urllib.parse
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home(); MESH = HOME / ".mesh"; MESH.mkdir(exist_ok=True)
LOG = MESH / "voice-in.log"; OFFSET_F = MESH / ".tg-offset"; STRANGERS = MESH / "tg-strangers.log"

# persistent pipe to log scrubber — all log writes go through it; fail-safe: if scrub missing, write raw + warn
import shutil
_SCRUB_AVAIL = shutil.which("mesh-log-scrub") is not None
_LOG_FH = open(LOG, "a")
if _SCRUB_AVAIL:
    _SCRUB = subprocess.Popen(
        ["mesh-log-scrub"],
        stdin=subprocess.PIPE, stdout=_LOG_FH, text=True, bufsize=1,
    )
else:
    print("WARN: mesh-log-scrub not found — appending raw to voice-in.log", file=sys.stderr)
    _SCRUB = None
WHISPER = MESH / "whispercpp" / "main"
def _best_model():
    md = MESH / "whispercpp" / "models"
    for name in ("ggml-large-v3-turbo.bin", "ggml-large-v3.bin", "ggml-medium.bin", "ggml-base.bin"):
        p = md / name
        if p.exists() and p.stat().st_size > 50_000_000:  # skip the tiny for-tests stubs
            return p
    return md / "ggml-base.bin"
MODEL = _best_model()   # prefer a bigger/better model if present (Russian quality)

def env():
    e = {}
    f = HOME / ".config/remote-access/env"
    if f.exists():
        for ln in f.read_text().splitlines():
            ln = ln.strip()
            if "=" in ln and not ln.startswith("#"):
                k, _, v = ln.partition("="); e[k.strip()] = v.strip()
    return e
E = env()
TOKEN = os.environ.get("BOT_TOKEN") or E.get("BOT_TOKEN", "")
OWNER = int(os.environ.get("CHAT_ID") or E.get("CHAT_ID", "0"))
API = f"https://api.telegram.org/bot{TOKEN}"
FILEAPI = f"https://api.telegram.org/file/bot{TOKEN}"

if len(sys.argv) > 1 and sys.argv[1] == '--test':
    ok = all(k in os.environ or k in E for k in ['BOT_TOKEN', 'CHAT_ID'])
    print('smoke-test: ok' if ok else 'smoke-test: FAIL (BOT_TOKEN or CHAT_ID missing)', flush=True)
    sys.exit(0 if ok else 1)

def ffmpeg_bin():
    # MUST decode OGG/Opus (Telegram voice). imageio-ffmpeg ships a full build with libopus;
    # the playwright bundled ffmpeg does NOT have an opus decoder, so it is avoided.
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        pass
    import shutil
    return shutil.which("ffmpeg") or "ffmpeg"
FFMPEG = ffmpeg_bin()

def get(method, **params):
    url = f"{API}/{method}"
    if params: url += "?" + urllib.parse.urlencode(params)
    with urllib.request.urlopen(url, timeout=40) as r:
        return json.load(r)

def ts(): return datetime.now(timezone.utc).strftime("%H:%M:%SZ")
def write(kind, text):
    line = f"{ts()}  {kind}  {text}".rstrip()
    if _SCRUB is not None:
        _SCRUB.stdin.write(line + "\n"); _SCRUB.stdin.flush()
    else:
        _LOG_FH.write(line + "\n"); _LOG_FH.flush()
    print(line, flush=True)

def transcribe(file_id):
    info = get("getFile", file_id=file_id)
    path = info.get("result", {}).get("file_path")
    if not path: return "[voice: getFile failed]"
    oga = MESH / "voice-in.oga"; wav = MESH / "voice-in.wav"
    urllib.request.urlretrieve(f"{FILEAPI}/{path}", oga)
    subprocess.run([FFMPEG, "-y", "-i", str(oga), "-ar", "16000", "-ac", "1", str(wav)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wav.exists(): return "[voice: ffmpeg failed]"
    out = subprocess.run([str(WHISPER), "-m", str(MODEL), "-f", str(wav), "-nt", "-l", "auto"],
                         capture_output=True, text=True, timeout=120)
    txt = " ".join(out.stdout.split()).strip()
    for p in (oga, wav):
        try: p.unlink()
        except OSError: pass
    return txt or "[voice: empty transcript]"

def handle(update):
    msg = update.get("message") or update.get("edited_message")
    if not msg: return
    frm = (msg.get("from") or {}).get("id")
    if frm != OWNER:
        with open(STRANGERS, "a") as f:
            f.write(f"{ts()}  from={frm}  {json.dumps(msg.get('text') or '[non-text]')[:120]}\n")
        return
    if msg.get("voice") or msg.get("audio"):
        fid = (msg.get("voice") or msg.get("audio")).get("file_id")
        write("VOICE", transcribe(fid))
    elif msg.get("text"):
        write("TEXT", msg["text"])
    elif msg.get("photo") or msg.get("document"):
        # operator screenshots/files → download into ~/.mesh/inbox so a mind can read them
        if msg.get("photo"):
            doc = max(msg["photo"], key=lambda p: p.get("file_size") or 0)  # largest rendition
            name = f"photo-{doc['file_id'][:8]}.jpg"
        else:
            doc = msg["document"]
            name = (doc.get("file_name") or f"file-{doc['file_id'][:8]}").replace("/", "_").replace("..", "_")
        info = get("getFile", file_id=doc["file_id"])
        path = info.get("result", {}).get("file_path")
        if path:
            inbox = MESH / "inbox"; inbox.mkdir(exist_ok=True)
            dest = inbox / name
            try:
                urllib.request.urlretrieve(f"{FILEAPI}/{path}", dest)
                write("DOCUMENT", f"saved -> {dest}")
            except Exception as e:
                write("DOCUMENT", f"[download failed: {e}]")
        else:
            write("DOCUMENT", f"[getFile failed] {name}")
    else:
        write("MSG", "[non-text/voice message]")

def poll_once(offset):
    data = get("getUpdates", timeout=25, offset=offset)
    if not data.get("ok"):
        print(f"[rx] getUpdates not ok: {data.get('description')}", file=sys.stderr); return offset
    for up in data.get("result", []):
        handle(up); offset = up["update_id"] + 1
        OFFSET_F.write_text(str(offset))
    return offset

def main():
    if not TOKEN or not OWNER: sys.exit("BOT_TOKEN/CHAT_ID not set")
    offset = int(OFFSET_F.read_text()) if OFFSET_F.exists() else 0
    once = "--once" in sys.argv
    print(f"[mesh-voice-rx] listening (owner={OWNER}) -> {LOG}", flush=True)
    while True:
        try:
            offset = poll_once(offset)
        except Exception as e:
            print(f"[rx] {e}", file=sys.stderr); time.sleep(3)
        if once: break

if __name__ == "__main__":
    main()
