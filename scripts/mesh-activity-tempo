#!/usr/bin/env bash
# reflex-cadence: 8-59/10 * * * *
# reflex-args: --edge
# mesh-activity-tempo — room ACTIVITY TEMPO: fuses mesh-tamper (brief physical
# disturbance) + mesh-wifi-motion (sustained WiFi radar motion) + mesh-light
# (ambient context) into a ROOM ACTIVITY signal that no single sensor gives alone.
#
# Tamper catches a brief bump (phone picked up, put back) that body-motion's
# instant sample can miss. WiFi-motion catches sustained walking/movement that
# tamper's 8s window can miss. Light provides context: activity in the dark
# is unusual (DARK_BUSTLE) vs expected in a lit room (BUSTLE).
#
#   mesh-activity-tempo              one-shot tempo + key signals
#   mesh-activity-tempo --status     same as default (verbose)
#   mesh-activity-tempo --edge       emit only on state change (2-consecutive debounce)
#   mesh-activity-tempo --json       machine-readable
#   mesh-activity-tempo --test       smoke test (exit 2 = phone unreachable)
#
# Fusion:
#   SILENT       = tamper=quiet + wifi=STILL + light=DARK  → room at rest
#   RESTING      = tamper=quiet + wifi=STILL + light=LIT   → lit room, no motion
#   STIR         = tamper=body-moved                        → brief physical disturbance
#   BUSTLE       = wifi=MOTION + light=LIT                 → sustained activity in lit room
#   DARK_BUSTLE  = wifi=MOTION + light=DARK                → sustained activity in dark
#   DEGRADED     = one or more signals weak/unavailable    → cannot assess fully
#   Exit 2       = phone unreachable (never fakes a clear)
#
# WiFi-degraded 3-signal path (wifi=UNKNOWN suppressed, or wifi=UNCERTAIN):
#   mesh-wifi-motion is DECAYED (Android scan cache never refreshes — see that tool's header).
#   After 3 consecutive stale reads it suppresses output → wifi=UNKNOWN every run.
#   Falls back to a 2-signal fusion (tamper + light):
#   SILENT  = tamper=quiet + light=DARK  (wifi-axis degraded)
#   RESTING = tamper=quiet + light=LIT   (wifi-axis degraded)
#   JSON field "wifi_degraded": true when wifi-axis was UNKNOWN or UNCERTAIN.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.activity-tempo.state"
OFFLINEFILE="$HOME/.mesh/.activity-tempo-offline"

if [ "${1:-}" = --test ]; then
  command -v mesh-light >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-light)"; exit 1; }
  command -v mesh-wifi-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-wifi-motion)"; exit 1; }
  command -v mesh-tamper >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tamper)"; exit 1; }

  fail=0
  for cmd in mesh-light mesh-wifi-motion mesh-tamper; do
    $cmd --test >/dev/null 2>&1; rc=$?
    if [ "$rc" = 2 ]; then
      echo "smoke-test: n/a (phone unreachable — no activity tempo)"
      exit 2
    elif [ "$rc" != 0 ]; then
      echo "smoke-test: FAIL ($cmd --test rc=$rc)"
      fail=1
    fi
  done
  [ "$fail" = 0 ] || exit 1
  echo "smoke-test: ok"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
TS=$(date -u +%H:%M:%SZ)

# --- Early phone-reachability gate (avoid 3 sequential SSH stalls when phone offline) ---
# All three senses below are phone-dependent; with the phone unreachable each blocks on
# its own SSH timeout (~10+15+20s). Resolve the phone IP once upfront and bail fast —
# matches mesh-body-motion's upfront mesh-phone-ip. (Re-applied to genome 2026-06-17:
# the sense mind fixed only the deployed copy and auto-sync genome→local clobbered it.)
if command -v mesh-phone-ip >/dev/null 2>&1; then
  if ! timeout 12 mesh-phone-ip >/dev/null 2>&1; then
    if [ ! -f "$OFFLINEFILE" ]; then echo "activity-tempo: phone unreachable — cannot assess room tempo" >&2; touch "$OFFLINEFILE"; fi
    exit 2
  fi
fi

# --- Read all three senses ---
# Light (fast, ~1s)
light_out="$(timeout 10 mesh-light 2>/dev/null)" || true
# mesh-light emits 5 levels — map DARK/DIM→DARK, MODERATE/LIT/BRIGHT→LIT (matches mesh-room-sense)
if printf '%s' "$light_out" | grep -qE 'BRIGHT|LIT|MODERATE'; then
  light="LIT"
elif printf '%s' "$light_out" | grep -qE 'DARK|DIM'; then
  light="DARK"
else
  light="UNKNOWN"
fi

# WiFi motion (fast, ~2s)
wifi_out="$(timeout 15 mesh-wifi-motion 2>/dev/null)"; wifi_rc=$?
if [ "$wifi_rc" = 2 ]; then
  phone_unreachable=1
  wifi="UNKNOWN"
else
  phone_unreachable=0
  if printf '%s' "$wifi_out" | grep -q 'MOTION'; then
    wifi="MOTION"
  elif printf '%s' "$wifi_out" | grep -q 'STILL'; then
    wifi="STILL"
  elif printf '%s' "$wifi_out" | grep -q 'UNCERTAIN'; then
    wifi="UNCERTAIN"
  elif printf '%s' "$wifi_out" | grep -q 'FIRST-RUN'; then
    wifi="FIRST-RUN"
  else
    wifi="UNKNOWN"
  fi
fi

# Tamper (blocks up to ~8-10s, but the only sense that catches brief pickup-and-put-down)
tamper_out="$(timeout 20 mesh-tamper 2>/dev/null)"; tamper_rc=$?
if [ "$tamper_rc" = 2 ]; then
  tamper="UNKNOWN"
elif printf '%s' "$tamper_out" | grep -q 'body-moved'; then
  tamper="MOVED"
elif printf '%s' "$tamper_out" | grep -q 'body-quiet'; then
  tamper="QUIET"
else
  tamper="UNKNOWN"
fi

# --- Honest-degraded: phone unreachable → cannot assess ---
if [ "$phone_unreachable" = 1 ] && [ "$tamper" = "UNKNOWN" ]; then
  if [ ! -f "$OFFLINEFILE" ]; then echo "activity-tempo: phone unreachable — cannot assess room tempo" >&2; touch "$OFFLINEFILE"; fi
  exit 2
fi
rm -f "$OFFLINEFILE"

# --- Fusion ---
tempo=""
reason=""
signals="tamper=${tamper} wifi=${wifi} light=${light}"

if [ "$tamper" = "MOVED" ] && [ "$wifi" != "MOTION" ]; then
  # Brief disturbance without sustained motion — tamper caught it, wifi didn't
  tempo="STIR"
  reason="brief physical disturbance (tamper fired, no sustained motion)"
elif [ "$wifi" = "MOTION" ] && [ "$light" = "DARK" ]; then
  tempo="DARK_BUSTLE"
  reason="sustained activity in darkness"
elif [ "$wifi" = "MOTION" ]; then
  tempo="BUSTLE"
  reason="sustained activity in lit room"
elif [ "$wifi" = "STILL" ] && [ "$light" = "DARK" ]; then
  tempo="SILENT"
  reason="room at rest, dark"
elif [ "$wifi" = "STILL" ] && [ "$light" = "LIT" ]; then
  tempo="RESTING"
  reason="room quiet but lit"
elif [ "$wifi" = "UNCERTAIN" ] || [ "$wifi" = "UNKNOWN" ]; then
  # WiFi axis unavailable (decayed/suppressed) or borderline — 2-signal fallback.
  # tamper=MOVED is already caught by the STIR branch; here we only need QUIET.
  if [ "$tamper" = "QUIET" ] && [ "$light" = "DARK" ]; then
    tempo="SILENT"; reason="room dark, no tamper (wifi-axis:${wifi,,})"
  elif [ "$tamper" = "QUIET" ] && [ "$light" = "LIT" ]; then
    tempo="RESTING"; reason="lit room, no tamper (wifi-axis:${wifi,,})"
  else
    tempo="DEGRADED"; reason="wifi-axis ${wifi,,} and light/tamper also unavailable"
  fi
elif [ "$tamper" = "UNKNOWN" ]; then
  tempo="DEGRADED"
  reason="tamper unavailable — cannot assess tempo"
elif [ "$wifi" = "FIRST-RUN" ]; then
  tempo="DEGRADED"
  reason="WiFi motion first run (baseline not yet established)"
else
  tempo="DEGRADED"
  reason="mixed signals — tamper=${tamper} wifi=${wifi} light=${light}"
fi

# --- Output ---
wifi_deg=false; { [ "$wifi" = "UNCERTAIN" ] || [ "$wifi" = "UNKNOWN" ]; } && wifi_deg=true
if [ "$MODE" = json ]; then
  printf '{"tempo":"%s","reason":"%s","signals":"%s","wifi_degraded":%s,"ts":"%s","phone_ok":%s}\n' \
    "$tempo" "$reason" "$signals" "$wifi_deg" "$TS" "$(( 1 - phone_unreachable ))"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$tempo" > "$STATE"; rm -f "$PENDING"
  elif [ "$tempo" = "$confirmed" ]; then
    rm -f "$PENDING"
  elif [ "$tempo" = "$pending" ]; then
    pcount=$((pcount + 1))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$tempo" > "$STATE"; rm -f "$PENDING"
      printf '[activity-tempo] %s — %s | %s\n' "$tempo" "$reason" "$signals"
    else
      printf '%s:%d\n' "$tempo" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$tempo" > "$PENDING"
  fi
  exit 0
fi

printf '[activity-tempo] %s — %s | %s\n' "$tempo" "$reason" "$signals"
