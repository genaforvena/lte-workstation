#!/usr/bin/env bash
# reflex-cadence: 8-59/10 * * * *
# reflex-args: --edge
# mesh-activity-tempo — room ACTIVITY TEMPO: fuses mesh-tamper (brief physical
# disturbance) + mesh-wifi-motion (sustained WiFi radar motion) + mesh-light
# (ambient context) into a ROOM ACTIVITY signal that no single sensor gives alone.
#
# Tamper catches a brief bump (phone picked up, put back) that body-motion's
# instant sample can miss. WiFi-motion catches sustained walking/movement that
# tamper's 8s window can miss. Light provides context: activity in the dark
# is unusual (DARK_BUSTLE) vs expected in a lit room (BUSTLE).
#
#   mesh-activity-tempo              one-shot tempo + key signals
#   mesh-activity-tempo --status     same as default (verbose)
#   mesh-activity-tempo --edge       emit only on state change (2-consecutive debounce)
#   mesh-activity-tempo --json       machine-readable
#   mesh-activity-tempo --test       smoke test (exit 2 = all axes unavailable)
#
# Fusion:
#   SILENT       = tamper=quiet + wifi=STILL + light=DARK  → room at rest
#   RESTING      = tamper=quiet + wifi=STILL + light=LIT   → lit room, no motion
#   STIR         = tamper=body-moved                        → brief physical disturbance
#   BUSTLE       = wifi=MOTION + light=LIT                 → sustained activity in lit room
#   DARK_BUSTLE  = wifi=MOTION + light=DARK                → sustained activity in dark
#   DEGRADED     = one or more signals weak/unavailable    → cannot assess fully
#                  state line carries the cause as a 2nd pipe field: DEGRADED|reason=<axes-dark|
#                  no-tamper|wifi-warmup|mixed-signals|all-dark> (2026-07-05 — consumers read field 1)
#   Exit 2       = ALL axes unavailable: phone off AND node-side wifi tape thin (never fakes a clear)
#
# Phone-offline path — wifi + light + cam all carry on WITHOUT the phone. wifi-motion is NODE-SIDE /
# phone-free since 04ae803 (persistence-baseline d29388a — reads ~/.mesh/wifi.log); cam is the node's own
# webcam; and LIGHT joined them 2026-08-15 (it grew a phaedra-beacon path and a webcam mean-luma path and
# exits 2 itself when both are dark, so it is read ALWAYS and no longer sits behind the phone gate — for
# ~a month of phone outage that gate pinned light=UNKNOWN while a live DARK sat one row above it in the
# senses dash, and every night of motion logged as plain BUSTLE instead of DARK_BUSTLE).
# TAMPER is the one axis still phone-bound — no beacon or node-side substitute exists for it:
#   DARK_BUSTLE = wifi=MOTION + light=DARK   (now reachable phone-off; was unreachable before 2026-08-15)
#   BUSTLE      = wifi=MOTION + light=LIT/UNKNOWN
#   SILENT      = wifi=STILL  + light=DARK   (likewise)
#   RESTING     = wifi=STILL  + light=LIT/UNKNOWN
#   wifi=UNCERTAIN/UNKNOWN → 2-signal fallback: tamper+light (phone up), else cam=STILL. Light alone
#   does NOT resolve it — an illumination axis carries no motion, so that stays an honest DEGRADED.
#   JSON field "wifi_degraded": true when wifi-axis was UNKNOWN or UNCERTAIN.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.activity-tempo.state"
OFFLINEFILE="$HOME/.mesh/.activity-tempo-offline"

# _cam_classify <camprev_age_s> <motion_age_s> <ttl> → MOTION | STILL | UNKNOWN
# Honest liveness: cam-prev.jpg older than 120s = mesh-cam-watch daemon DOWN → UNKNOWN (sense
# UNREACHABLE, never a faked STILL/empty). Daemon live + fresh motion stamp → MOTION; live + no/old
# stamp → STILL (genuinely no movement). This is what keeps an UNREACHABLE camera visibly distinct.
_cam_classify() {
  local prev_age="${1:-99999}" motion_age="${2:-99999}" ttl="${3:-180}"
  case "$prev_age" in ''|*[!0-9]*) echo UNKNOWN; return;; esac
  [ "$prev_age" -le 120 ] || { echo UNKNOWN; return; }
  case "$motion_age" in ''|*[!0-9]*) echo STILL; return;; esac
  [ "$motion_age" -le "$ttl" ] && echo MOTION || echo STILL
}

# Flat-field (blind-lens) guard: a covered/capped lens still yields FRESH frames, and mesh-cam-watch can
# stamp .cam-motion from JPEG-noise diffs on the FLAT field → a false cam=MOTION → false BUSTLE. A flat
# frame (luma stddev<FLAT) carries no scene: the lens is BLIND, so the camera axis is UNREACHABLE, never
# MOTION/STILL. (Freshness proves the daemon writes, not that the lens can SEE; a genuinely dark room
# still carries sensor-noise variance, stddev ≳ 2–10.) Shared threshold w/ mesh-room-sense/mesh-cam-light.
CAM_FLAT_STDDEV="${MESH_CAM_FLAT_STDDEV:-3}"
_cam_flat() {  # <frame> -> 1 (flat/covered → blind), 0 (scene variance), "" (unreadable / no PIL)
  python3 - "$1" "$CAM_FLAT_STDDEV" <<'PY' 2>/dev/null
import sys
try:
    from PIL import Image, ImageStat
    sd = ImageStat.Stat(Image.open(sys.argv[1]).convert("L")).stddev[0]
    print(1 if sd < float(sys.argv[2]) else 0)
except Exception:
    pass
PY
}

if [ "${1:-}" = --test ]; then
  # FALSIFIABLE cam liveness assertions (phone-independent — run before the phone-gated dep checks):
  [ "$(_cam_classify 5 5 180)" = MOTION ]    || { echo "  FAIL: live cam + fresh motion → MOTION"; exit 1; }
  [ "$(_cam_classify 5 9999 180)" = STILL ]  || { echo "  FAIL: live cam + no motion → STILL"; exit 1; }
  [ "$(_cam_classify 9999 5 180)" = UNKNOWN ]|| { echo "  FAIL: dead cam (stale prev) must be UNKNOWN, not a faked STILL"; exit 1; }
  [ "$(_cam_classify 9999 9999 180)" = UNKNOWN ] || { echo "  FAIL: absent cam → UNKNOWN"; exit 1; }
  # FALSIFIABLE flat-field (blind-lens) assertions (phone-independent — PIL-gated):
  if python3 -c 'import PIL' 2>/dev/null; then
    _td="$(mktemp -d)"
    python3 - "$_td" <<'PY'
import sys
from PIL import Image
d=sys.argv[1]
Image.new("L",(64,48),90).save(d+"/flat.jpg")                 # constant → covered lens
im=Image.new("L",(64,48)); px=im.load()
for y in range(48):
    for x in range(64): px[x,y]=(x*4+y*3)%200+10              # gradient → real scene variance
im.save(d+"/noisy.jpg")
PY
    [ "$(_cam_flat "$_td/flat.jpg")" = 1 ]  || { echo "  FAIL: covered/flat frame must read blind (1)";       rm -rf "$_td"; exit 1; }
    [ "$(_cam_flat "$_td/noisy.jpg")" = 0 ] || { echo "  FAIL: scene-variance frame must read not-blind (0)"; rm -rf "$_td"; exit 1; }
    rm -rf "$_td"
  fi
  # FALSIFIABLE all-dark liveness assertions (phone-independent stub harness): the exit-2 path must
  # (a) neutralize a held POSITIVE tempo to DEGRADED (no stale-positive survives an all-dark sense)
  # and (b) refresh STATE mtime on every subsequent all-dark run (alive-but-dark ≠ reflex-dead STALE).
  _sd="$(mktemp -d)"
  mkdir -p "$_sd/home/.mesh" "$_sd/bin"
  printf '#!/bin/sh\nexit 1\n' > "$_sd/bin/mesh-phone-ip"
  printf '#!/bin/sh\nexit 2\n' > "$_sd/bin/mesh-wifi-motion"
  # mesh-light stubbed n/a HERE too: since 2026-08-15 it is read phone-independently, so a real
  # webcam-derived DARK could leak into this fixture and "all axes dark" would no longer be all-dark.
  # NOT a gate and honestly not currently load-bearing — deleting this stub still passes, because the
  # sandbox HOME hides cam-prev.jpg and the direct fswebcam grab happened to fail. That is a COINCIDENCE
  # of who holds the webcam at test time, not a property: keep the stub so the all-dark fixture is
  # all-dark by construction rather than by luck.
  printf '#!/bin/sh\nexit 2\n' > "$_sd/bin/mesh-light"
  chmod +x "$_sd/bin/"*
  _senv() { env HOME="$_sd/home" PATH="$_sd/bin:$HOME/.local/bin:/usr/bin:/bin" bash "${BASH_SOURCE[0]}" --edge; }
  printf 'RESTING\n' > "$_sd/home/.mesh/.activity-tempo.state"
  _alerr="$(_senv 2>&1 >/dev/null)"; _rc=$?
  [ "$_rc" = 2 ] || { echo "  FAIL: all-dark must exit 2 (rc=$_rc)"; rm -rf "$_sd"; exit 1; }
  # DATED-LOG assertion (all-dark leg): this stderr line is appended to the edge-deduped reflex log by
  # cron, so it is the ONLY record that the sense went all-dark at a given moment. Undated, the mtime
  # dates the last line and nothing dates the rest. Drop the "$TS " prefix and this goes RED.
  printf '%s' "$_alerr" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z ' || {
    echo "  FAIL: the all-dark log line must carry a full ISO-8601 UTC stamp (got: $_alerr)"; rm -rf "$_sd"; exit 1; }
  [ "$(cat "$_sd/home/.mesh/.activity-tempo.state")" = "DEGRADED|reason=all-dark" ] || {
    echo "  FAIL: all-dark must neutralize held RESTING → DEGRADED|reason=all-dark, not leave a stale positive (got: $(cat "$_sd/home/.mesh/.activity-tempo.state"))"; rm -rf "$_sd"; exit 1; }
  touch -d '40 minutes ago' "$_sd/home/.mesh/.activity-tempo.state"
  _senv >/dev/null 2>&1
  _age=$(( $(date +%s) - $(stat -c %Y "$_sd/home/.mesh/.activity-tempo.state") ))
  [ "$_age" -lt 300 ] || { echo "  FAIL: repeat all-dark run must refresh STATE mtime (still ${_age}s old)"; rm -rf "$_sd"; exit 1; }
  # FALSIFIABLE phone-free-light assertions: the light axis must be read from the SENSE's own honest
  # exit, not from phone reachability. Phone UNREACHABLE + wifi=MOTION + light=DARK is precisely the
  # night-motion case that logged as plain BUSTLE for the whole phone outage; it must classify
  # DARK_BUSTLE. Re-point the light read back under `if [ "$phone_ok" = 1 ]` and both go RED.
  printf '#!/bin/sh\necho "[wifi-motion] MOTION"\n' > "$_sd/bin/mesh-wifi-motion"
  printf '#!/bin/sh\necho "[room-dark] DARK (webcam-derived, coarse — phone offline; via=direct)"\n' > "$_sd/bin/mesh-light"
  chmod +x "$_sd/bin/"*
  rm -f "$_sd/home/.mesh/.activity-tempo.state"
  _lt="$(env HOME="$_sd/home" PATH="$_sd/bin:$HOME/.local/bin:/usr/bin:/bin" bash "${BASH_SOURCE[0]}" 2>/dev/null)"
  printf '%s' "$_lt" | grep -q 'DARK_BUSTLE' || {
    echo "  FAIL: phone offline + wifi=MOTION + phone-free light=DARK must read DARK_BUSTLE, not a light-blind BUSTLE (got: $_lt)"; rm -rf "$_sd"; exit 1; }
  printf '%s' "$_lt" | grep -q 'light COARSE' || {
    echo "  FAIL: a webcam-derived light level must be NAMED coarse in the signals line (a mean-luma bucket is not lux) (got: $_lt)"; rm -rf "$_sd"; exit 1; }
  # DATED-LOG assertion (transition leg): the ONLY other line that reaches the reflex log is the
  # debounce-confirmed TRANSITION emit. Drive a real one — held RESTING, then two consecutive
  # DARK_BUSTLE runs (pcount reaches 2) — and assert the emitted line is dated. This exercises the
  # actual --edge emit path, not a string in the source. Drop the "$TS " prefix and it goes RED.
  rm -f "$_sd/home/.mesh/.activity-tempo.pending" "$_sd/home/.mesh/.activity-tempo-offline"
  printf 'RESTING\n' > "$_sd/home/.mesh/.activity-tempo.state"
  _senv >/dev/null 2>&1                     # run 1: pending DARK_BUSTLE:1, no emit yet
  _tl="$(_senv 2>/dev/null)"                # run 2: debounce confirms → emits the transition line
  printf '%s' "$_tl" | grep -q '\[activity-tempo\]' || {
    echo "  FAIL: two consecutive DARK_BUSTLE runs must emit a confirmed transition line (got: $_tl)"; rm -rf "$_sd"; exit 1; }
  printf '%s' "$_tl" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z \[activity-tempo\]' || {
    echo "  FAIL: the transition log line must carry a full ISO-8601 UTC stamp (got: $_tl)"; rm -rf "$_sd"; exit 1; }
  # ...and the axes-dark cause line may never call a LIVE axis unavailable.
  printf '#!/bin/sh\necho "[wifi-motion] UNCERTAIN"\n' > "$_sd/bin/mesh-wifi-motion"
  chmod +x "$_sd/bin/mesh-wifi-motion"
  rm -f "$_sd/home/.mesh/.activity-tempo.state"
  _lt2="$(env HOME="$_sd/home" PATH="$_sd/bin:$HOME/.local/bin:/usr/bin:/bin" bash "${BASH_SOURCE[0]}" 2>/dev/null)"
  printf '%s' "$_lt2" | grep -q 'light/tamper\|light.*unavailable.*light' && {
    echo "  FAIL: DEGRADED cause names light as unavailable while light is live (got: $_lt2)"; rm -rf "$_sd"; exit 1; }
  printf '%s' "$_lt2" | grep -q 'DEGRADED' || {
    echo "  FAIL: wifi UNCERTAIN + light-only must still DEGRADE honestly — light is not a motion axis (got: $_lt2)"; rm -rf "$_sd"; exit 1; }
  rm -rf "$_sd"
  command -v mesh-light >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-light)"; exit 1; }
  command -v mesh-wifi-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-wifi-motion)"; exit 1; }
  command -v mesh-tamper >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tamper)"; exit 1; }

  # Exit-2 contract (header): n/a means ALL axes unavailable. A single phone-bound axis
  # (light/tamper) reading n/a must NOT veto the whole tool — the wifi axis is node-side and
  # carries a verdict alone (phone-offline path above). The old any-axis-n/a → exit 2 kept
  # autowire from ever wiring this reflex on the mind node, where wifi.log is healthiest and
  # the live run exits 0 with a verdict, so tempo=? sat permanently dark (2026-07-16).
  fail=0; na=0; na_axes=""
  for cmd in mesh-light mesh-wifi-motion mesh-tamper; do
    $cmd --test >/dev/null 2>&1; rc=$?
    if [ "$rc" = 2 ]; then
      na=$((na+1)); na_axes="$na_axes $cmd"
    elif [ "$rc" != 0 ]; then
      echo "smoke-test: FAIL ($cmd --test rc=$rc)"
      fail=1
    fi
  done
  [ "$fail" = 0 ] || exit 1
  if [ "$na" = 3 ]; then
    echo "smoke-test: n/a (all axes unavailable — no activity tempo)"
    exit 2
  fi
  [ "$na" = 0 ] || echo "  note: n/a axes (live run degrades honestly):$na_axes"
  echo "smoke-test: ok (+4 cam-liveness +2 blind-lens +2 all-dark-liveness +4 phone-free-light +3 dated-log assertions)"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
# Date-BEARING, always. The two lines this tool emits into `~/.mesh/activity-tempo.log` are appended by
# cron (`--edge >> log`) and the log is EDGE-DEDUPED — every line in it marks a state TRANSITION, which is
# the one thing a transition log exists to date. It carried no timestamp at all for 242 lines, so the only
# recoverable time was the file's mtime, i.e. the LAST line; every earlier transition was timeless and an
# hours-old flap read as "now" (cost 2026-08-15: an 09:48 all-dark line read as the current verdict and
# nearly filed a false regression against a fix that was working). `%H:%M:%SZ` alone is the same trap one
# step milder — a 23h-old reading renders an hour in the FUTURE. Full ISO-8601 UTC; no consumer parses the
# JSON `ts` (swept: every reader takes the state file), so widening it breaks nothing.
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Phone reachability (resolve once, then VERIFY it actually accepts SSH) ---
# light + tamper are phone senses (each SSH-stalls ~10s when the phone is offline), so resolve the phone
# IP upfront and SKIP them when unreachable (no ~20s of dead stalls). BUT mesh-phone-ip returns a CACHED /
# registry last-known IP with exit 0 even when the phone is OFFLINE — its documented contract is "degrade
# honestly", so exit 0 means resolved-OR-last-known, NOT reachable (verified 2026-06-25: it served a dead
# LAN IP, "No route to host", exit 0). Gating on phone-ip's exit code ALONE therefore never skips the dead
# senses — it ate the full ~20s of stalls every run, defeating this gate's own stated purpose. So after
# resolving the IP, do ONE fast SSH liveness probe (short ConnectTimeout): phone_ok=1 only if the phone
# truly ACCEPTS — else skip light+tamper (honest UNKNOWN, ~4s not ~20s). wifi-motion is NODE-SIDE / phone-
# free since 04ae803 → ALWAYS read; the tool only bails (exit 2) when EVERY axis (incl. node-side wifi) is
# dark. (Genome-authoritative — the sense mind once fixed only the deployed copy and auto-sync clobbered it.)
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
phone_ok=0
if command -v mesh-phone-ip >/dev/null 2>&1; then
  _pip="$(timeout 12 mesh-phone-ip 2>/dev/null)" || _pip=""
  if [ -n "$_pip" ] && timeout 6 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=4 \
       -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_pip" true </dev/null >/dev/null 2>&1; then
    phone_ok=1   # phone genuinely reachable → embodied senses worth reading
  fi
fi

# --- WiFi motion: NODE-SIDE, phone-free — ALWAYS read (local wifi.log, fast) ---
wifi_out="$(timeout 15 mesh-wifi-motion 2>/dev/null)"; wifi_rc=$?
if [ "$wifi_rc" = 2 ]; then
  wifi="UNKNOWN"                      # node-side tape thin/absent — NOT a phone signal
elif printf '%s' "$wifi_out" | grep -q 'MOTION'; then
  wifi="MOTION"
elif printf '%s' "$wifi_out" | grep -q 'STILL'; then
  wifi="STILL"
elif printf '%s' "$wifi_out" | grep -q 'UNCERTAIN'; then
  wifi="UNCERTAIN"
elif printf '%s' "$wifi_out" | grep -q 'FIRST-RUN'; then
  wifi="FIRST-RUN"
else
  wifi="UNKNOWN"
fi

# --- Camera motion: NODE-SIDE, phone-free — mesh-cam-watch stamps ~/.mesh/.cam-motion on movement ---
# Honest liveness: the daemon rewrites cam-prev.jpg every poll, so its freshness = sense reachable.
#   cam-prev FRESH + .cam-motion fresh  → MOTION  (movement seen in room, phone-independent)
#   cam-prev FRESH + no/stale .cam-motion → STILL (sense LIVE, genuinely no motion)
#   cam-prev STALE/absent → UNKNOWN (daemon down — sense UNREACHABLE, NOT a faked "still/empty")
CAM_MOTION_TTL="${MESH_CAM_MOTION_TTL:-180}"
_now="$(date +%s)"
_camprev="$HOME/.mesh/cam-prev.jpg"
_prev_age=99999; [ -f "$_camprev" ] && _prev_age=$(( _now - $(stat -c %Y "$_camprev" 2>/dev/null || echo 0) ))
_motion_age=99999
if [ -f "$HOME/.mesh/.cam-motion" ]; then
  _cm="$(cat "$HOME/.mesh/.cam-motion" 2>/dev/null || echo 0)"; case "$_cm" in ''|*[!0-9]*) _cm=0;; esac
  _motion_age=$(( _now - _cm ))
fi
cam="$(_cam_classify "$_prev_age" "$_motion_age" "$CAM_MOTION_TTL")"
# Blind-lens override: a fresh frame that is FLAT (covered/capped lens) is not a live read — its
# MOTION/STILL is meaningless, so neutralize the camera axis to UNKNOWN (unreachable) so a covered lens
# can never drive a false BUSTLE. Set cam_blind for a transparent note in the signals line.
cam_blind=0
if [ "$cam" != UNKNOWN ] && [ "$(_cam_flat "$_camprev")" = 1 ]; then cam=UNKNOWN; cam_blind=1; fi

# --- Light: ALWAYS read — it is NO LONGER a phone-bound axis (2026-08-15) ---
# mesh-light was born a phone sense (the lux chip is on the body), so it lived under the phone_ok gate
# with tamper. It has since grown TWO phone-free paths — the phaedra beacon (source=beacon, real lux)
# and the node's own webcam (coarse mean-luma, via=direct) — and it exits 2 honestly when both are also
# dark. The gate was never re-pointed, exactly the correction wifi-motion got in 04ae803, so on a
# phone-offline node the light axis was pinned UNKNOWN while a live DARK sat one row above it in the
# senses dash. Cost was not just a missing field: DARK_BUSTLE and SILENT are the two verdicts that NEED
# the light axis, so with the phone down every night of sustained motion logged as plain BUSTLE
# "(wifi-only; no light context)" — a true statement produced by a gate, not by the sense. Bind the read
# to the SENSE's own honest exit, never to a prerequisite the sense outgrew. No new stall risk: with the
# phone offline this path is a local file read + webcam grab (measured ~1s), and timeout 10 still caps it.
light_out="$(timeout 10 mesh-light 2>/dev/null)"; light_rc=$?
if [ "$light_rc" = 2 ]; then
  light="UNKNOWN"                     # phone AND beacon AND webcam dark — the sense says so itself
elif printf '%s' "$light_out" | grep -qE 'BRIGHT|LIT|MODERATE'; then
  light="LIT"
elif printf '%s' "$light_out" | grep -qE 'DARK|DIM'; then
  light="DARK"
else
  light="UNKNOWN"
fi
# Coarse (webcam-derived) light is still a REAL read of the room's darkness — it drives DARK_BUSTLE/
# SILENT the same as lux does — but it is a different instrument, so name it in the signals line rather
# than let a consumer read a mean-luma bucket as a lux measurement.
light_coarse=0
printf '%s' "$light_out" | grep -q 'coarse' && light_coarse=1

# --- Tamper: STILL phone-bound (no beacon/webcam path exists) — honest UNKNOWN when unreachable ---
if [ "$phone_ok" = 1 ]; then
  # Tamper (blocks ~8-10s; the only sense that catches a brief pickup-and-put-down)
  tamper_out="$(timeout 20 mesh-tamper 2>/dev/null)"; tamper_rc=$?
  if [ "$tamper_rc" = 2 ]; then
    tamper="UNKNOWN"
  elif printf '%s' "$tamper_out" | grep -q 'body-moved'; then
    tamper="MOVED"
  elif printf '%s' "$tamper_out" | grep -q 'body-quiet'; then
    tamper="QUIET"
  else
    tamper="UNKNOWN"
  fi
else
  tamper="UNKNOWN"   # phone offline — the embodied disturbance sense is skipped (no SSH stall)
fi

# --- Honest-degraded: exit 2 ONLY when EVERY axis is dark (incl. node-side wifi + camera) ---
if [ "$wifi" = "UNKNOWN" ] && [ "$tamper" = "UNKNOWN" ] && [ "$light" = "UNKNOWN" ] && [ "$cam" = "UNKNOWN" ]; then
  if [ ! -f "$OFFLINEFILE" ]; then echo "$TS activity-tempo: all sensors unavailable (phone offline + node-side wifi tape thin + camera down) — cannot assess room tempo" >&2; touch "$OFFLINEFILE"; fi
  # Liveness on the all-dark path (--edge only, same scoping as mesh-imac-wifi's mark_unreach): this
  # run DID execute — exiting 2 without refreshing STATE leaves its mtime frozen, so the mtime-aging
  # dash reads a LIVE-but-dark reflex as "reflex dead" (false-STALE; hit live 2026-07-05: marker
  # touched :08, STATE frozen 40min → tempo=DEGRADED (STALE) while cron was fine). mtime = ran-live,
  # content = honest verdict: a held POSITIVE tempo must not survive an all-dark sense as fresh, so
  # the transition writes DEGRADED once (edge-deduped), then only the mtime moves.
  if [ "$EDGE" = 1 ]; then
    # Field-1 compare: the state line carries the DEGRADED cause as a 2nd pipe field (see rslug below)
    if [ "$(cut -d'|' -f1 "$STATE" 2>/dev/null || true)" = "DEGRADED" ]; then
      mesh-state-touch "$STATE"
    else
      printf 'DEGRADED|reason=all-dark\n' > "$STATE"
    fi
  fi
  exit 2
fi
rm -f "$OFFLINEFILE"

# --- Fusion ---
tempo=""
reason=""
# rslug: compact STATIC token naming WHY the verdict is DEGRADED (axes-dark|no-tamper|wifi-warmup|
# mixed-signals; the all-dark exit-2 path uses all-dark). Persisted as a 2nd pipe field of the state
# line (`DEGRADED|reason=<slug>`) so the dash names the cause — each slug needs a physically
# different fix, and the bare DEGRADED lumped them (same defect class as mesh-light's bare OFFLINE,
# fixed 2026-07-05). STATIC tokens only — never embed a live axis value here, or the slug oscillates
# run-to-run and churns the state file on a held label.
rslug=""
signals="tamper=${tamper} wifi=${wifi} light=${light} cam=${cam}"
[ "$light_coarse" = 1 ] && signals="${signals} (light COARSE: webcam mean-luma, not lux)"
[ "$cam_blind" = 1 ] && signals="${signals} (cam BLIND: lens covered/flat — neutralized)"

if [ "$cam" = "MOTION" ]; then
  # Camera motion (mesh-cam-watch) is a definitive phone-INDEPENDENT activity signal — it resolves the
  # tempo even when the phone axes (tamper/light) are dark, the gap that left tempo DEGRADED for the
  # whole time the phone was offline. Cross-corroborate with the other motion axes for the label.
  if [ "$light" = "DARK" ]; then
    tempo="DARK_BUSTLE"; reason="camera motion in darkness (wifi:${wifi,,})"
  elif [ "$wifi" = "MOTION" ] || [ "$tamper" = "MOVED" ]; then
    tempo="BUSTLE"; reason="camera motion + wifi=${wifi}/tamper=${tamper} — corroborated activity"
  else
    tempo="BUSTLE"; reason="camera motion in room (phone-independent activity)"
  fi
elif [ "$tamper" = "MOVED" ] && [ "$wifi" != "MOTION" ]; then
  # Brief disturbance without sustained motion — tamper caught it, wifi didn't
  tempo="STIR"
  reason="brief physical disturbance (tamper fired, no sustained motion)"
elif [ "$wifi" = "MOTION" ] && [ "$light" = "DARK" ]; then
  tempo="DARK_BUSTLE"
  reason="sustained activity in darkness"
elif [ "$wifi" = "MOTION" ]; then
  tempo="BUSTLE"
  if [ "$light" = "LIT" ]; then reason="sustained activity in lit room"; else reason="sustained activity (wifi-only; no light context)"; fi
elif [ "$wifi" = "STILL" ] && [ "$light" = "DARK" ]; then
  tempo="SILENT"
  reason="room at rest, dark"
elif [ "$wifi" = "STILL" ] && [ "$light" = "LIT" ]; then
  tempo="RESTING"
  reason="room quiet but lit"
elif [ "$wifi" = "STILL" ]; then
  # wifi definite-STILL with light context unavailable (phone offline) — node-side wifi carries it
  tempo="RESTING"
  reason="room at rest (wifi-only; phone axes offline — no light context)"
elif [ "$wifi" = "UNCERTAIN" ] || [ "$wifi" = "UNKNOWN" ]; then
  # WiFi axis unavailable (node-side tape thin) or borderline UNCERTAIN — 2-signal fallback.
  # tamper=MOVED is already caught by the STIR branch; here we only need QUIET.
  if [ "$tamper" = "QUIET" ] && [ "$light" = "DARK" ]; then
    tempo="SILENT"; reason="room dark, no tamper (wifi-axis:${wifi,,})"
  elif [ "$tamper" = "QUIET" ] && [ "$light" = "LIT" ]; then
    tempo="RESTING"; reason="lit room, no tamper (wifi-axis:${wifi,,})"
  elif [ "$cam" = "STILL" ]; then
    # phone axes dark + wifi thin, but the CAMERA is live and sees no motion → genuinely at rest.
    # cam=STILL (sense live, no movement) is what rescues this from a faked DEGRADED — and it stays
    # DEGRADED honestly if the camera is also UNKNOWN (daemon down), never a guessed RESTING.
    tempo="RESTING"; reason="camera live, no motion — room at rest (phone axes offline, wifi:${wifi,,})"
  else
    # Name ONLY the axes that are genuinely dark. Light can now be LIVE here (phone-free) and still not
    # resolve the tempo — light is an illumination axis, not a motion one, so DARK alone cannot separate
    # "asleep" from "moving in the dark". That is an honest DEGRADED, but the old blanket sentence
    # ("light/tamper/camera also unavailable") reported it as a REACHABILITY failure and would have sent
    # the next reader to fix a sense that is working. A verdict may be held; its stated cause may not lie.
    _dark=""
    [ "$tamper" = "UNKNOWN" ] && _dark="${_dark}tamper/"
    [ "$light"  = "UNKNOWN" ] && _dark="${_dark}light/"
    [ "$cam"    = "UNKNOWN" ] && _dark="${_dark}camera/"
    _dark="${_dark%/}"
    tempo="DEGRADED"
    if [ "$light" != "UNKNOWN" ]; then
      reason="wifi-axis ${wifi,,}, ${_dark} unavailable — light=${light} is live but carries no motion"
    else
      reason="wifi-axis ${wifi,,} and ${_dark} also unavailable"
    fi
    rslug="axes-dark"
  fi
elif [ "$tamper" = "UNKNOWN" ]; then
  tempo="DEGRADED"
  reason="tamper unavailable — cannot assess tempo"
  rslug="no-tamper"
elif [ "$wifi" = "FIRST-RUN" ]; then
  tempo="DEGRADED"
  reason="WiFi motion first run (baseline not yet established)"
  rslug="wifi-warmup"
else
  tempo="DEGRADED"
  reason="mixed signals — tamper=${tamper} wifi=${wifi} light=${light}"
  rslug="mixed-signals"
fi

# --- Output ---
wifi_deg=false; { [ "$wifi" = "UNCERTAIN" ] || [ "$wifi" = "UNKNOWN" ]; } && wifi_deg=true
if [ "$MODE" = json ]; then
  printf '{"tempo":"%s","reason":"%s","signals":"%s","wifi_degraded":%s,"ts":"%s","phone_ok":%s}\n' \
    "$tempo" "$reason" "$signals" "$wifi_deg" "$TS" "$phone_ok"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  # The persisted line is the bare label for real tempos; DEGRADED carries its cause as a 2nd pipe
  # field (`DEGRADED|reason=<slug>` — additive, same format family as ambient-clock's LABEL|dwell_s).
  # ALL debounce/dedup arithmetic below runs on the LABEL ONLY (field 1), so a cause-slug change on a
  # held DEGRADED never churns the transition logic. Consumers swept 2026-07-05: interruptibility
  # (%%|*), presence-density (cut -f1), tempo-context (awk $1 → non-vocab collapses to OFFLINE, same
  # as bare DEGRADED did), room-context (field-1 strip added same day), operator-mood (non-vocab →
  # tempo_ok false, unchanged), sensorium (renders the line verbatim — the payoff).
  confirmed_label="${confirmed%%|*}"
  sline="$tempo"
  [ "$tempo" = "DEGRADED" ] && [ -n "$rslug" ] && sline="DEGRADED|reason=${rslug}"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  # LIVENESS freshness (touch-state-every-LIVE-run): the sense just ran, so refresh STATE mtime even
  # when the debounced verdict neither confirmed nor changed. Staleness must mean "the reflex STOPPED
  # running", NOT "the verdict has been oscillating" — an unstable-but-LIVE tempo (the wifi axis
  # flipping MOTION/UNCERTAIN run-to-run) never matches `confirmed`, so it would never reach the
  # confirmed-match touch below and would decay to a FALSE STALE while perfectly alive. A genuinely
  # dead reflex (cron stopped) never runs → never touches → STILL goes honest-STALE. Content (the
  # confirmed tempo) is still only rewritten by the debounce branches below; only mtime moves here.
  [ -n "$confirmed" ] && touch "$STATE"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$sline" > "$STATE"; rm -f "$PENDING"
  elif [ "$tempo" = "$confirmed_label" ]; then
    # Same LABEL re-confirmed. If the DEGRADED cause slug moved (no-tamper → wifi-warmup), rewrite
    # the content in place — the label (the consumer contract) is unchanged, so no debounce applies;
    # only the diagnostic field updates.
    [ "$sline" = "$confirmed" ] || printf '%s\n' "$sline" > "$STATE"
    mesh-state-touch "$STATE"   # re-confirmed the SAME tempo → refresh freshness via the SHARED liveness
                     # primitive (chat-review/state-touch-adoption). The dash ages STATE by mtime, so without
                     # this a genuinely STABLE, live tempo (re-confirmed every 10min) decays to a FALSE STALE
                     # — misreading a healthy sense as dark. A truly dead reflex never reaches here, so the
                     # STALE flag still correctly catches a STOPPED sense. (touch-state-every-run)
    rm -f "$PENDING"
  elif [ "$tempo" = "$pending" ]; then
    pcount=$((pcount + 1))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$sline" > "$STATE"; rm -f "$PENDING"
      printf '%s [activity-tempo] %s — %s | %s\n' "$TS" "$tempo" "$reason" "$signals"
    else
      printf '%s:%d\n' "$tempo" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$tempo" > "$PENDING"
  fi
  # The state file records liveness as well as the last confirmed tempo. A live
  # but unstable tempo that keeps moving through debounce should still age as
  # fresh; otherwise the room fusion reads a working organ as stale.
  mesh-state-touch "$STATE"
  exit 0
fi

printf '[activity-tempo] %s — %s | %s\n' "$tempo" "$reason" "$signals"
