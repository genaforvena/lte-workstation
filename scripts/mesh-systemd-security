#!/usr/bin/env bash
# mesh-systemd-security — read-only census of running systemd service exposure.
#
# It deliberately reports posture only. It does not reload units, edit unit files, or
# attempt to harden services. Exit 2 means the census was blind/incomplete; findings
# are still printed and do not masquerade as a clean read.
set -uo pipefail

usage() {
  cat <<'USAGE'
Usage: mesh-systemd-security [--units | --test]

  --units       census running service units (the default)
  --test        parser smoke test; does not read or change the live system
USAGE
}

parse_report() {
  local unit="$1" report="$2" line score verdict
  line="$(grep -E 'Overall exposure level for .*: [0-9]+(\.[0-9]+)? (OK|MEDIUM|UNSAFE) ' <<<"$report" | tail -1)"
  [ -n "$line" ] || return 1
  if [[ "$line" =~ Overall[[:space:]]exposure[[:space:]]level[[:space:]]for[[:space:]].*:[[:space:]]([0-9]+(\.[0-9]+)?)[[:space:]](OK|MEDIUM|UNSAFE)[[:space:]] ]]; then
    score="${BASH_REMATCH[1]}"
    verdict="${BASH_REMATCH[3]}"
    printf '%s\t%s\t%s\n' "$unit" "$score" "$verdict"
    return 0
  fi
  return 1
}

run_test() {
  local report='→ Overall exposure level for fixture.service: 9.6 UNSAFE :-{'
  local parsed
  parsed="$(parse_report fixture.service "$report")" || { echo 'mesh-systemd-security --test: FAIL (fixture did not parse)' >&2; return 1; }
  [ "$parsed" = $'fixture.service\t9.6\tUNSAFE' ] || { echo "mesh-systemd-security --test: FAIL (parsed '$parsed')" >&2; return 1; }
  echo 'mesh-systemd-security --test: PASS (exposure parser)'
}

case "${1:---units}" in
  --help|-h) usage; exit 0 ;;
  --test) run_test; exit $? ;;
  --units) ;;
  *) usage >&2; exit 2 ;;
esac

command -v systemctl >/dev/null 2>&1 || { echo 'systemd-security: BLIND (systemctl unavailable)' >&2; exit 2; }
command -v systemd-analyze >/dev/null 2>&1 || { echo 'systemd-security: BLIND (systemd-analyze unavailable)' >&2; exit 2; }

units="$(LC_ALL=C systemctl list-units --type=service --state=running --no-legend --no-pager 2>/dev/null)"
systemctl_rc=$?
[ "$systemctl_rc" -eq 0 ] || { echo "systemd-security: BLIND (systemctl list failed rc=$systemctl_rc)" >&2; exit 2; }

total=0 ok=0 medium=0 unsafe=0 unreadable=0 umask_fail=0
printf 'UNIT\tSCORE\tVERDICT\n'
while IFS= read -r unit; do
  [ -n "$unit" ] || continue
  total=$((total + 1))
  report="$(LC_ALL=C systemd-analyze security "$unit" --no-pager 2>/dev/null)"
  if parsed="$(parse_report "$unit" "$report")"; then
    printf '%s\n' "$parsed"
    verdict="${parsed##*$'\t'}"
    case "$verdict" in
      OK) ok=$((ok + 1)) ;;
      MEDIUM) medium=$((medium + 1)) ;;
      UNSAFE) unsafe=$((unsafe + 1)) ;;
    esac
    grep -Eq 'UMask=.*world-readable|UMask=.*default' <<<"$report" && umask_fail=$((umask_fail + 1))
  else
    unreadable=$((unreadable + 1))
    printf '%s\tNA\tUNREADABLE\n' "$unit"
  fi
done < <(awk '{print $1}' <<<"$units")

printf 'systemd-security: units=%d ok=%d medium=%d unsafe=%d unreadable=%d umask-risk=%d\n' \
  "$total" "$ok" "$medium" "$unsafe" "$unreadable" "$umask_fail"
[ "$total" -gt 0 ] && [ "$unreadable" -eq 0 ]
