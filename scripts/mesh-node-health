#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-node-health — cross-sense fusion: WHAT'S HURTING THE NODE RIGHT NOW?
# Combines 4 node-resource senses into a single health verdict no single sensor gives.
#
# Inputs (all best-effort, each independently OFFLINE-able; 2+ missing → DEGRADED):
#   mesh-entropy       .entropy-state        FULL/GOOD/LOW/CRITICAL/UNKNOWN  (kernel crypto pool)
#   mesh-sockstat      .sockstat-state       HEALTHY/BUSY/CONCERN/UNKNOWN    (open sockets)
#   mesh-swap          .swap-state           LIGHT/MODERATE/HIGH/CRITICAL/NONE/UNKNOWN  (memory swap)
#   mesh-loadavg       .loadavg-state        RISING/FALLING/STABLE/SPIKE/LIGHT/OVERLOADED/UNKNOWN  (CPU load)
#   mesh-psi           .psi.state            CALM/BUSY/STALLED/UNAVAILABLE (fused cpu+io+mem stall, corroborates swap)
#   mesh-psi-memory    .psi-memory-state     QUIET/BUSY/PRESSURED/SATURATED (memory-SPECIFIC stall, preferred swap corroborator)
#
# No single sensor answers "is the node healthy?" — entropy alone says "crypto is fine" but says
# nothing about CPU; swap alone says "memory is exhausted" but says nothing about connectivity;
# loadavg alone says "CPU is spiking" but says nothing about crypto readiness. Fused, you get a
# single worst-of verdict: "the node has a problem, and here's the worst input".
#
# Classification (FALSIFIABLE via --test, worst-of priority — change a band and the test flips):
#   CRITICAL   any input is CRITICAL (kernel crypto exhausted OR swap exhausted)
#   DEGRADED   1+ input is DEGRADED but none is CRITICAL (e.g., entropy LOW, sockstat CONCERN,
#              swap HIGH, loadavg OVERLOADED)
#   HEALTHY    all 4 inputs are at their respective healthy bands
#   DEGRADED   2+ inputs are UNKNOWN (safety rail — missing inputs are themselves a concern)
#   UNKNOWN    1 input is UNKNOWN (with the other 3 healthy, single-missing is "one-off")
#
# Honest-fusion: 2+ OFFLINE → DEGRADED with explicit missing list (a consumer reading
# "DEGRADED|missing: entropy,swap" sees that 2 senses are unreachable — never confused with
# "HEALTHY" which is the strong claim "all 4 senses are healthy").
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.node-health-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=600

# stride_from_cronfield <minute-field> → the /N stride in minutes ('' if fixed-minute). Pure.
# Same idiom as mesh-window-state's wifi_stale_s() (7a01b9b) — derive a staleness bound from the
# LIVE cron stride instead of a literal that can silently drift out of sync with the real cadence.
stride_from_cronfield() { printf '%s' "$1" | grep -oE '/[0-9]+$' | tr -d '/'; }

# psi_stale_s — mesh-psi is the ONE input here that is NOT force-refreshed before read (line ~284:
# "independently cron-wired... no force-refresh needed"), so unlike entropy/sockstat/swap/loadavg
# (always <1s old at read time) it is genuinely exposed to its own cron cadence. A flat STALE_S=600
# (10min) false-OFFLINEs it for most of every cycle whenever the LIVE mesh-psi cron entry runs
# slower than 10min (chat-review/node-health-psi-reader-offline, 2026-07-07 — live-confirmed: this
# node's crontab has mesh-psi wired at 3-59/30, a 30min stride, so .psi.state legitimately sits
# >600s old for ~20 of every 30 minutes even though mesh-psi itself is healthy and firing on
# schedule — the swap-psi CALM-downgrade gate (79cdc86) never sees a real band during that window).
# Derive the bound from the live feeder's actual stride ×2 (self-correcting — no literal to drift
# out of sync again if the cadence changes), falling back to a generous default when the cron line
# isn't readable (non-cron env, tests).
# cron_stale_s <tool-grep-pattern> <fallback-seconds> — 2x the live cron stride for that tool, or
# the fallback if its cron line isn't found/readable. Shared by psi_stale_s and psimem_stale_s below
# (mesh-psi and mesh-psi-memory are wired on independent cadences, chat-review/node-health-psi-
# reader-offline + route-orphan/genome-178298).
cron_stale_s() {
  local pat="$1" fallback="$2" stride
  stride="$(stride_from_cronfield "$(crontab -l 2>/dev/null | grep -m1 -E "^[^#]*${pat}([[:space:]]|\$)" | awk '{print $1}')")"
  if [ -n "$stride" ] && [ "$stride" -gt 0 ] 2>/dev/null; then echo $((stride * 60 * 2)); else echo "$fallback"; fi
}
psi_stale_s() { cron_stale_s 'mesh-psi' 1800; }
psimem_stale_s() { cron_stale_s 'mesh-psi-memory' 1800; }
PSI_STALE_S="${MESH_NODE_HEALTH_PSI_STALE:-$(psi_stale_s)}"
PSIMEM_STALE_S="${MESH_NODE_HEALTH_PSIMEM_STALE:-$(psimem_stale_s)}"

# read_label <state> → echoes the first pipe-delimited field of the first line (the band label),
# or OFFLINE if the file is missing or stale. The state files use format "LABEL|field2|field3..."
# (e.g., "FULL|avail=256 poolsize=256 (100%)" or "HEALTHY|inuse=31|orphans=0|tw=40").
# awk '{print $1}' on whitespace gives "LABEL|field2" (the pipe is NOT a whitespace separator) —
# we split on | to get the bare label.
read_label() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# read_psi_band <state> → echoes CALM|BUSY|STALLED|UNAVAILABLE|OFFLINE (chat-review/
# node-health-swap-psi-gate 2026-07-07). mesh-psi's .psi.state is a BARE single-token label (its
# confirmed worst-of verdict, no pipe fields — unlike the other 4 inputs here), so this reads the
# whole first line, not a cut -d'|' -f1 split.
read_psi_band() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$PSI_STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# read_psi_mem_band <state> → echoes QUIET|BUSY|PRESSURED|SATURATED|OFFLINE (route-orphan/
# genome-178298). Unlike mesh-psi's bare-token .psi.state, mesh-psi-memory's .psi-memory-state is
# pipe-delimited (label|some10|...) same shape as the other 4 inputs, so this is read_label's idiom
# but against its own PSIMEM_STALE_S bound (mesh-psi-memory's live cron stride is independent of
# mesh-psi's — see cron_stale_s above).
read_psi_mem_band() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$PSIMEM_STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    QUIET|BUSY|PRESSURED|SATURATED) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# band_severity <label> → echoes CRITICAL|DEGRADED|HEALTHY|UNKNOWN. The "how bad is this
# input's verdict" mapping (priority order: CRITICAL > DEGRADED > HEALTHY > UNKNOWN).
band_severity() {
  local l="$1"
  case "$l" in
    CRITICAL|OVERLOADED) echo "CRITICAL" ;;   # kernel crypto exhausted, swap exhausted, OR CPU oversaturated
    LOW|CONCERN|HIGH|BUSY|SPIKE) echo "DEGRADED" ;;  # any of these is concerning
    GOOD|FULL|MODERATE|LIGHT|STABLE|RISING|FALLING|HEALTHY) echo "HEALTHY" ;;
    NONE) echo "HEALTHY" ;;          # NONE = swap disabled, that's a config choice not a problem
    OFFLINE|UNKNOWN|"") echo "UNKNOWN" ;;
    *) echo "UNKNOWN" ;;              # defensive: any unrecognized label
  esac
}

# classify_node_health <entropy_band> <sockstat_band> <swap_band> <loadavg_band> [psi_band] [psimem_band] →
# "LABEL|reason" — pure, offline-testable (worst-of priority). psi_band (mesh-psi's fused
# CALM/BUSY/STALLED/UNAVAILABLE) and psimem_band (mesh-psi-memory's memory-SPECIFIC
# QUIET/BUSY/PRESSURED/SATURATED, preferred when present) both corroborate swap alone; see the
# swap-severity gate below.
classify_node_health() {
  local e="$1" sk="$2" sw="$3" ld="$4" psi="${5:-}" psimem="${6:-}"
  # Compute severities for each input
  local e_sev sk_sev sw_sev ld_sev missing=""
  e_sev="$(band_severity "$e")"
  sk_sev="$(band_severity "$sk")"
  sw_sev="$(band_severity "$sw")"
  ld_sev="$(band_severity "$ld")"
  # chat-review/node-health-swap-psi-gate (2026-07-07), amended route-orphan/genome-178298: raw
  # swap% pins CRITICAL on COLD evicted pages that won't drain on their own. The original gate
  # corroborated against the FUSED mesh-psi band (cpu+io+mem worst-of) — but that fuses in IO-axis
  # noise unrelated to memory: live-confirmed this node's mesh-psi flips CALM<->STALLED every few
  # minutes off io_uring cqring phantom-stall churn while mesh-psi-memory's some/full sit at 0.00
  # avg10/60/300 the entire time, so a swap=CRITICAL node with genuinely-fine memory still read
  # CRITICAL for however long the unrelated IO axis happened to be non-CALM (the false-positive this
  # ticket reports). mesh-psi-memory is the memory-SPECIFIC PSI sense, so it is now the preferred
  # corroborator:
  #   psimem=QUIET                       → direct evidence of no real memory stall → downgrade
  #   psimem=BUSY/PRESSURED/SATURATED     → direct evidence OF a real memory stall → stays CRITICAL
  #                                         (even if the noisier fused psi happens to read CALM)
  #   psimem=OFFLINE/UNAVAILABLE/missing  → no direct read; fall back to the original fused-psi
  #                                         CALM check (legacy 5-arg callers keep today's behavior)
  local sw_downgraded=0 sw_downgrade_reason=""
  # chat-review/node-health-swap-psi-gate (2026-07-07), route-orphan/genome-178298, extended to
  # HIGH-severity in chat-review/node-health-swap-HIGH-psi-gate (2026-07-18): raw swap% pins
  # CRITICAL on cold evicted pages AND HIGH on merely-parked ones, neither of which will drain
  # itself — both false-positives when the memory-SPECIFIC PSI axis shows no real stall. The
  # gate applies to EITHER severity; the depth of the downgrade depends on the raw band:
  #   CRITICAL + psimem=QUIET|BUSY → DEGRADED (90%+ swap consumed is still concerning even cold)
  #   HIGH     + psimem=QUIET|BUSY → HEALTHY  (cold parked pages are normal, no real pressure)
  # Live HIGH repro (2026-07-18): 4.9G/8G swap HIGH + psimem QUIET + 14G RAM free + SwapCached 16M
  # = ML model weights parked out (voice-clone/room-note3/room-gigaa), pinned DEGRADED for hours.
  # psimem=BUSY is only some_avg10>0.5% with full≈0 (mesh-psi-memory:51-53) — momentary jitter,
  # not a real stall; treat it like QUIET. Only PRESSURED (some>=10%)/SATURATED (full>=5%) are
  # direct evidence of a genuine stall worth keeping the severity for.
  if [ "$sw_sev" = "CRITICAL" ] || [ "$sw_sev" = "DEGRADED" ]; then
    case "$psimem" in
      QUIET|BUSY)
        if [ "$sw_sev" = "CRITICAL" ]; then
          sw_sev="DEGRADED"
        else
          sw_sev="HEALTHY"
        fi
        sw_downgraded=1; sw_downgrade_reason="psimem=$psimem"
        ;;
      PRESSURED|SATURATED) : ;;  # real memory-specific stall — keep severity, no fallback
      *)
        # psimem OFFLINE/UNAVAILABLE/missing — fall back to the original fused-psi CALM check
        # (legacy 5-arg callers keep today's behavior; an unreadable corroboration never quietly
        # downgrades a real exhaustion).
        if [ "$psi" = "CALM" ]; then
          if [ "$sw_sev" = "CRITICAL" ]; then
            sw_sev="DEGRADED"
          else
            sw_sev="HEALTHY"
          fi
          sw_downgraded=1; sw_downgrade_reason="psi=CALM"
        fi
        ;;
    esac
  fi
  # Count UNKNOWN inputs (missing/degraded)
  local unk=0
  [ "$e_sev" = "UNKNOWN" ]  && unk=$((unk+1)) && missing="${missing}entropy,"
  [ "$sk_sev" = "UNKNOWN" ] && unk=$((unk+1)) && missing="${missing}sockstat,"
  [ "$sw_sev" = "UNKNOWN" ] && unk=$((unk+1)) && missing="${missing}swap,"
  [ "$ld_sev" = "UNKNOWN" ] && unk=$((unk+1)) && missing="${missing}loadavg,"
  missing="${missing%,}"
  # Any CRITICAL → CRITICAL
  if [ "$e_sev" = "CRITICAL" ] || [ "$sk_sev" = "CRITICAL" ] || [ "$sw_sev" = "CRITICAL" ] || [ "$ld_sev" = "CRITICAL" ]; then
    # Identify which input is critical
    local which=""
    [ "$e_sev" = "CRITICAL" ] && which="${which}entropy,"
    [ "$sk_sev" = "CRITICAL" ] && which="${which}sockstat,"
    [ "$sw_sev" = "CRITICAL" ] && which="${which}swap,"
    [ "$ld_sev" = "CRITICAL" ] && which="${which}loadavg,"
    which="${which%,}"
    echo "CRITICAL|$which (critical input)"
    return
  fi
  # Any DEGRADED → DEGRADED
  if [ "$e_sev" = "DEGRADED" ] || [ "$sk_sev" = "DEGRADED" ] || [ "$sw_sev" = "DEGRADED" ] || [ "$ld_sev" = "DEGRADED" ]; then
    local which=""
    [ "$e_sev" = "DEGRADED" ] && which="${which}entropy=$e,"
    [ "$sk_sev" = "DEGRADED" ] && which="${which}sockstat=$sk,"
    if [ "$sw_sev" = "DEGRADED" ]; then
      if [ "$sw_downgraded" = 1 ]; then which="${which}swap=$sw(${sw_downgrade_reason}→no real stall),"
      else which="${which}swap=$sw,"; fi
    fi
    [ "$ld_sev" = "DEGRADED" ] && which="${which}loadavg=$ld,"
    which="${which%,}"
    echo "DEGRADED|$which"
    return
  fi
  # 2+ UNKNOWN → DEGRADED (the safety rail: too many senses unreachable for confident HEALTHY)
  if [ "$unk" -ge 2 ]; then
    echo "DEGRADED|missing: $missing (too many senses unreachable — safety rail)"
    return
  fi
  # 1 UNKNOWN + others healthy → UNKNOWN (single-missing is a one-off concern)
  if [ "$unk" -eq 1 ]; then
    echo "UNKNOWN|missing: $missing (one sense unreachable, can't fully assert)"
    return
  fi
  # All healthy
  if [ "$sw_downgraded" = 1 ]; then
    echo "HEALTHY|all inputs healthy — swap=$sw downgraded (${sw_downgrade_reason}→cold parked pages, no real stall) (entropy=$e sockstat=$sk loadavg=$ld)"
  else
    echo "HEALTHY|all 4 inputs healthy (entropy=$e sockstat=$sk swap=$sw loadavg=$ld)"
  fi
}

if [ "${1:-}" = --test ]; then
  fail=0
  # HEALTHY: all 4 healthy
  r="$(classify_node_health FULL HEALTHY LIGHT STABLE)"
  [ "$r" = "HEALTHY|all 4 inputs healthy (entropy=FULL sockstat=HEALTHY swap=LIGHT loadavg=STABLE)" ] \
    || { echo "  FAIL HEALTHY all: got=$r"; fail=1; }
  # CRITICAL: entropy CRITICAL
  r="$(classify_node_health CRITICAL HEALTHY LIGHT STABLE)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL entropy: got=$r"; fail=1; }
  echo "$r" | grep -q 'entropy' || { echo "  FAIL CRITICAL should list entropy: got=$r"; fail=1; }
  # CRITICAL: swap CRITICAL (takes priority over DEGRADED)
  r="$(classify_node_health GOOD BUSY CRITICAL STABLE)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL swap: got=$r"; fail=1; }
  echo "$r" | grep -q 'swap' || { echo "  FAIL CRITICAL-swap should list swap: got=$r"; fail=1; }
  # --- chat-review/node-health-swap-psi-gate (2026-07-07): swap=CRITICAL raw-% pins on cold
  # evicted pages that won't drain themselves. Corroborate against mesh-psi before trusting it
  # alone. Falsify: drop the psi gate in classify_node_health and the CALM case flips to CRITICAL.
  # (1) swap=CRITICAL + psi=CALM (no real stall anywhere) → downgrades to DEGRADED
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE CALM)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL swap=CRITICAL+psi=CALM should downgrade to DEGRADED: got=$r"; fail=1; }
  echo "$r" | grep -q 'swap=CRITICAL' || { echo "  FAIL downgraded reason should still name swap=CRITICAL: got=$r"; fail=1; }
  echo "$r" | grep -q 'psi=CALM' || { echo "  FAIL downgraded reason should cite psi=CALM: got=$r"; fail=1; }
  # (2) swap=CRITICAL + psi=STALLED (a real stall corroborates it) → stays CRITICAL, unchanged
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE STALLED)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL swap=CRITICAL+psi=STALLED must stay CRITICAL: got=$r"; fail=1; }
  # (3) swap=CRITICAL + psi=BUSY (some contention, not calm) → stays CRITICAL too, not just STALLED
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE BUSY)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL swap=CRITICAL+psi=BUSY must stay CRITICAL: got=$r"; fail=1; }
  # (4) swap=CRITICAL + psi=UNAVAILABLE (unreadable — no kernel PSI support) → fail-suspicious,
  # stays CRITICAL. An unconfirmed corroboration must never quietly downgrade a real exhaustion.
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE UNAVAILABLE)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL swap=CRITICAL+psi=UNAVAILABLE must stay CRITICAL (fail-suspicious): got=$r"; fail=1; }
  # (5) legacy 4-arg call (no psi arg at all) → unchanged CRITICAL, exactly today's behavior
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL legacy 4-arg swap=CRITICAL must stay CRITICAL: got=$r"; fail=1; }
  # (6) the psi gate must be swap-SPECIFIC — a genuinely critical OTHER input alongside a
  # psi=CALM swap must still surface CRITICAL overall (psi only exempts swap, nothing else)
  r="$(classify_node_health CRITICAL HEALTHY CRITICAL STABLE CALM)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL entropy=CRITICAL alongside psi-exempted swap must stay CRITICAL: got=$r"; fail=1; }
  echo "$r" | grep -q 'entropy' || { echo "  FAIL should still name entropy as the critical input: got=$r"; fail=1; }
  # --- route-orphan/genome-178298: psimem (mesh-psi-memory, memory-SPECIFIC PSI) is now the
  # PREFERRED swap corroborator over the fused mesh-psi band, because the fused band's IO axis can
  # be non-CALM (phantom io_uring stalls) while memory is genuinely quiet. Falsify: drop the psimem
  # branch in classify_node_health and case (7) below flips back to CRITICAL.
  # (7) THE REPRO: swap=CRITICAL + fused psi=STALLED (would stay CRITICAL under the old psi-only
  # gate) + psimem=QUIET (direct memory evidence: some/full=0.00) → downgrades to DEGRADED anyway
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE STALLED QUIET)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL psimem=QUIET must downgrade even with fused psi=STALLED: got=$r"; fail=1; }
  echo "$r" | grep -q 'psimem=QUIET' || { echo "  FAIL downgraded reason should cite psimem=QUIET: got=$r"; fail=1; }
  # (8) swap=CRITICAL + fused psi=CALM + psimem=PRESSURED (direct memory evidence of a REAL stall)
  # → stays CRITICAL — memory-specific evidence overrides an optimistic fused-CALM read
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE CALM PRESSURED)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL psimem=PRESSURED must override psi=CALM and stay CRITICAL: got=$r"; fail=1; }
  # (9) swap=CRITICAL + fused psi=CALM + psimem=SATURATED → stays CRITICAL, same reasoning
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE CALM SATURATED)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL psimem=SATURATED must override psi=CALM and stay CRITICAL: got=$r"; fail=1; }
  # (10) chat-review/node-health-psimem-busy-not-critical (2026-07-09): swap=CRITICAL + psimem=BUSY
  # → downgrades to DEGRADED, same as QUIET. BUSY is only some_avg10>0.5% with full≈0
  # (mesh-psi-memory:51-53) — momentary jitter, not direct evidence of a real memory stall; only
  # PRESSURED (some>=10%)/SATURATED (full>=5%) are. Falsify by reverting :161's BUSY branch — this
  # assertion used to require CRITICAL (superseded, was itself the bug: node-health flapped
  # CRITICAL<->DEGRADED live as some_avg10 jittered across the bare 0.5% line).
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE CALM BUSY)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL psimem=BUSY must downgrade to DEGRADED (momentary jitter, not a real stall): got=$r"; fail=1; }
  echo "$r" | grep -q 'psimem=BUSY' || { echo "  FAIL downgraded reason should cite psimem=BUSY: got=$r"; fail=1; }
  # (11) swap=CRITICAL + fused psi=CALM + psimem=OFFLINE (unreadable) → falls back to the fused-psi
  # CALM check, same as a 5-arg legacy call — downgrades
  r="$(classify_node_health GOOD HEALTHY CRITICAL STABLE CALM OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL psimem=OFFLINE should fall back to psi=CALM downgrade: got=$r"; fail=1; }
  echo "$r" | grep -q 'psi=CALM' || { echo "  FAIL fallback reason should cite psi=CALM (not psimem): got=$r"; fail=1; }
  # --- chat-review/node-health-swap-HIGH-psi-gate (2026-07-18): the CRITICAL gate above is
  # necessary but NOT sufficient. swap=HIGH (DEGRADED sev) ALSO pins on cold parked pages that
  # aren't draining — health's live repro: 4.9G/8G swap HIGH + psimem QUIET + 14G RAM free +
  # SwapCached 16M = ML model weights parked out (voice-clone/room-note3/room-gigaa), NOT memory
  # pressure. The classifier pinned DEGRADED on it every 5min for hours, inheriting into
  # system-vitality. The same psimem/psi corroborator that gates CRITICAL must also gate HIGH:
  #   psimem=QUIET|BUSY  → downgrade HIGH→HEALTHY (cold parked pages are normal, no real stall)
  #   psimem=PRESSURED|SATURATED → keep DEGRADED (real memory stall corroborates the HIGH read)
  #   psimem=OFFLINE/missing + fused psi=CALM → same downgrade (legacy 5-arg fallback)
  # Falsify: drop the DEGRADED half of the gate below and (12) flips back to DEGRADED.
  # (12) THE REPRO: swap=HIGH + psimem=QUIET → HEALTHY (cold parked pages, no real stall)
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE CALM QUIET)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL swap=HIGH+psimem=QUIET must downgrade to HEALTHY (cold parked pages): got=$r"; fail=1; }
  echo "$r" | grep -q 'swap=HIGH' || { echo "  FAIL HEALTHY reason should still name swap=HIGH (the raw band): got=$r"; fail=1; }
  echo "$r" | grep -q 'psimem=QUIET' || { echo "  FAIL HEALTHY reason should cite psimem=QUIET (why it downgraded): got=$r"; fail=1; }
  # (13) swap=HIGH + psimem=BUSY → HEALTHY (BUSY is some_avg10>0.5% jitter, not a real stall —
  # same reasoning as case (10) for CRITICAL).
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE CALM BUSY)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL swap=HIGH+psimem=BUSY must downgrade to HEALTHY (jitter, not a stall): got=$r"; fail=1; }
  # (14) swap=HIGH + psimem=PRESSURED → DEGRADED (real memory stall corroborates the HIGH read)
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE CALM PRESSURED)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL swap=HIGH+psimem=PRESSURED must stay DEGRADED (real stall): got=$r"; fail=1; }
  # (15) swap=HIGH + psimem=SATURATED → DEGRADED (same)
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE CALM SATURATED)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL swap=HIGH+psimem=SATURATED must stay DEGRADED: got=$r"; fail=1; }
  # (16) swap=HIGH + psimem=OFFLINE + fused psi=CALM → HEALTHY (fallback to fused-psi CALM check)
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE CALM OFFLINE)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL swap=HIGH+psimem=OFFLINE+psi=CALM must downgrade to HEALTHY (fallback): got=$r"; fail=1; }
  echo "$r" | grep -q 'psi=CALM' || { echo "  FAIL fallback reason should cite psi=CALM (not psimem): got=$r"; fail=1; }
  # (17) swap=HIGH + psimem=OFFLINE + fused psi=STALLED → DEGRADED (no corroborated CALM to downgrade on)
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE STALLED OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL swap=HIGH+psimem=OFFLINE+psi=STALLED must stay DEGRADED (no CALM corroboration): got=$r"; fail=1; }
  # (18) legacy 4-arg call (no psi/psimem) → unchanged DEGRADED, exactly today's behavior
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL legacy 4-arg swap=HIGH must stay DEGRADED: got=$r"; fail=1; }
  # (19) the gate must still let OTHER degraded axes surface: swap=HIGH+psimem=QUIET (→HEALTHY)
  # alongside entropy=LOW keeps overall DEGRADED with entropy listed (swap-HIGH is downgraded
  # out of the which-list, but the entropy issue must still drive the verdict).
  r="$(classify_node_health LOW HEALTHY HIGH STABLE CALM QUIET)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL entropy=LOW alongside downgraded swap-HIGH must stay DEGRADED: got=$r"; fail=1; }
  echo "$r" | grep -q 'entropy=LOW' || { echo "  FAIL should still name entropy=LOW as the degraded input: got=$r"; fail=1; }
  echo "$r" | grep -vq 'swap=HIGH' || { echo "  FAIL downgraded swap-HIGH should NOT appear in the DEGRADED which-list: got=$r"; fail=1; }
  # CRITICAL: loadavg OVERLOADED
  r="$(classify_node_health GOOD HEALTHY LIGHT OVERLOADED)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL loadavg: got=$r"; fail=1; }
  # DEGRADED: entropy LOW (not CRITICAL)
  r="$(classify_node_health LOW HEALTHY LIGHT STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-entropy-LOW: got=$r"; fail=1; }
  echo "$r" | grep -q 'entropy=LOW' || { echo "  FAIL should list entropy=LOW: got=$r"; fail=1; }
  # DEGRADED: sockstat CONCERN
  r="$(classify_node_health GOOD CONCERN LIGHT STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-sockstat-CONCERN: got=$r"; fail=1; }
  # DEGRADED: swap HIGH
  r="$(classify_node_health GOOD HEALTHY HIGH STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-swap-HIGH: got=$r"; fail=1; }
  # DEGRADED: loadavg SPIKE
  r="$(classify_node_health GOOD HEALTHY LIGHT SPIKE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-loadavg-SPIKE: got=$r"; fail=1; }
  # CRITICAL priority over DEGRADED
  r="$(classify_node_health LOW BUSY CRITICAL STABLE)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL>DEGRADED: got=$r"; fail=1; }
  echo "$r" | grep -q 'swap' || { echo "  FAIL CRITICAL should list swap (not entropy LOW): got=$r"; fail=1; }
  # CRITICAL priority over 1-UNKNOWN
  r="$(classify_node_health OFFLINE HEALTHY LIGHT OVERLOADED)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL>1-UNKNOWN: got=$r"; fail=1; }
  # DEGRADED priority over 1-UNKNOWN
  r="$(classify_node_health OFFLINE BUSY LIGHT STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED>1-UNKNOWN: got=$r"; fail=1; }
  # 1 UNKNOWN (single missing) — not the safety rail, single-missing is just UNKNOWN
  r="$(classify_node_health OFFLINE HEALTHY LIGHT STABLE)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL 1-UNKNOWN: got=$r"; fail=1; }
  echo "$r" | grep -q 'entropy' || { echo "  FAIL 1-UNKNOWN should list entropy: got=$r"; fail=1; }
  # 2 UNKNOWN → DEGRADED (safety rail)
  r="$(classify_node_health OFFLINE OFFLINE LIGHT STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL 2-UNKNOWN: got=$r"; fail=1; }
  echo "$r" | grep -q 'missing' || { echo "  FAIL 2-UNKNOWN should list missing: got=$r"; fail=1; }
  # 3 UNKNOWN
  r="$(classify_node_health OFFLINE OFFLINE OFFLINE STABLE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL 3-UNKNOWN: got=$r"; fail=1; }
  # 4 UNKNOWN (all unreachable) → DEGRADED
  r="$(classify_node_health OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL 4-UNKNOWN: got=$r"; fail=1; }
  # NONE swap (swap disabled) → HEALTHY
  r="$(classify_node_health GOOD HEALTHY NONE STABLE)"
  [ "$r" = "HEALTHY|all 4 inputs healthy (entropy=GOOD sockstat=HEALTHY swap=NONE loadavg=STABLE)" ] \
    || { echo "  FAIL NONE-swap: got=$r"; fail=1; }
  # Unrecognized label → UNKNOWN
  r="$(classify_node_health GOOD HEALTHY LIGHT WEIRD_LABEL)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL unrecognized: got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (16 cases: HEALTHY×2, CRITICAL×3, DEGRADED×5, priority×1, 1-UNKNOWN, 2/3/4-UNKNOWN×3, NONE-swap, unrecognized)"
  echo "  ok: swap-psi gate (6 cases: CALM-downgrade, STALLED/BUSY/UNAVAILABLE/legacy-4arg stay CRITICAL, swap-specific-only)"
  echo "  ok: swap-psimem gate (5 cases: QUIET/BUSY-downgrade-despite-fused-STALLED-or-CALM [the repro], PRESSURED/SATURATED override fused-CALM to stay CRITICAL, OFFLINE falls back to fused-psi)"
  echo "  ok: swap-HIGH-psi gate (8 cases: QUIET/BUSY→HEALTHY [the live repro], PRESSURED/SATURATED stay DEGRADED, OFFLINE+psi=CALM→HEALTHY fallback, OFFLINE+psi=STALLED stay DEGRADED, legacy-4arg stay DEGRADED, downgraded-swap lets other-degraded-axes surface)"
  # psi_stale_s: derive from the LIVE mesh-psi cron stride, not a flat literal
  # (chat-review/node-health-psi-reader-offline). FALSIFIABLE: hardcode STALE_S=600 back into
  # read_psi_band and this whole gate (plus the live-band assertion below) fails on any node whose
  # mesh-psi cron stride exceeds 10min — exactly the live 3-59/30 case that motivated the fix.
  _pcdir="$(mktemp -d)"
  cat > "$_pcdir/crontab" <<'CRONSTUB'
#!/bin/sh
printf '%s\n' \
  '3-59/30 * * * * $HOME/.local/bin/mesh-psi --edge >> $HOME/.mesh/psi.log 2>&1   # autowired 2026-06-17' \
  '11-59/10 * * * * $HOME/.local/bin/mesh-psi-memory --edge >> $HOME/.mesh/psi-memory.log 2>&1'
CRONSTUB
  chmod +x "$_pcdir/crontab"
  _got="$(PATH="$_pcdir:$PATH" psi_stale_s)"
  [ "$_got" = 3600 ] || { echo "  FAIL psi_stale_s: 30min stride should derive 3600s (30*60*2), got=$_got"; fail=1; }
  cat > "$_pcdir/crontab" <<'CRONSTUB'
#!/bin/sh
printf '%s\n' '0 3 * * * /opt/unrelated --thing'
CRONSTUB
  chmod +x "$_pcdir/crontab"
  _got="$(PATH="$_pcdir:$PATH" psi_stale_s)"
  [ "$_got" = 1800 ] || { echo "  FAIL psi_stale_s: no mesh-psi line found should fall back to 1800, got=$_got"; fail=1; }
  rm -rf "$_pcdir"
  echo "  ok: psi_stale_s (derives 2× the live cron stride; falls back to 1800 when unreadable)"
  # psimem_stale_s: same derivation, independent of mesh-psi's own stride (route-orphan/genome-178298)
  _pcdir="$(mktemp -d)"
  cat > "$_pcdir/crontab" <<'CRONSTUB'
#!/bin/sh
printf '%s\n' \
  '3-59/30 * * * * $HOME/.local/bin/mesh-psi --edge >> $HOME/.mesh/psi.log 2>&1   # autowired 2026-06-17' \
  '11-59/10 * * * * $HOME/.local/bin/mesh-psi-memory --edge >> $HOME/.mesh/psi-memory.log 2>&1'
CRONSTUB
  chmod +x "$_pcdir/crontab"
  _got="$(PATH="$_pcdir:$PATH" psimem_stale_s)"
  [ "$_got" = 1200 ] || { echo "  FAIL psimem_stale_s: 10min stride should derive 1200s (10*60*2), got=$_got"; fail=1; }
  cat > "$_pcdir/crontab" <<'CRONSTUB'
#!/bin/sh
printf '%s\n' '0 3 * * * /opt/unrelated --thing'
CRONSTUB
  chmod +x "$_pcdir/crontab"
  _got="$(PATH="$_pcdir:$PATH" psimem_stale_s)"
  [ "$_got" = 1800 ] || { echo "  FAIL psimem_stale_s: no mesh-psi-memory line found should fall back to 1800, got=$_got"; fail=1; }
  rm -rf "$_pcdir"
  echo "  ok: psimem_stale_s (derives 2× the live mesh-psi-memory cron stride, independent of mesh-psi's; falls back to 1800 when unreadable)"
  # REAL-READ gate for psi (chat-review/node-health-psi-reader-offline): on a node where mesh-psi is
  # actually wired, PSI_STALE_S must be wide enough that read_psi_band yields a REAL band — not the
  # honest-but-wrong OFFLINE a too-tight flat threshold produces between cron cycles. n/a (not a
  # fail) if this node has no live .psi.state at all — that's genuinely no sense here, not this bug.
  if [ -f "$MESH/.psi.state" ]; then
    _pband="$(read_psi_band "$MESH/.psi.state")"
    case "$_pband" in
      CALM|BUSY|STALLED|UNAVAILABLE) echo "  ok: read_psi_band yields a real band on this node (psi=$_pband, PSI_STALE_S=${PSI_STALE_S}s)" ;;
      *) echo "  FAIL read_psi_band: expected a real band on this node, got '$_pband' (PSI_STALE_S=${PSI_STALE_S}s, mtime-age=$(( $(date +%s) - $(stat -c %Y "$MESH/.psi.state" 2>/dev/null || echo 0) ))s)"; fail=1 ;;
    esac
  else
    echo "  n/a: no $MESH/.psi.state on this node — psi real-read gate skipped (nothing to read)"
  fi
  # REAL-READ gate for psi-memory (route-orphan/genome-178298): same idiom as the psi gate above —
  # PSIMEM_STALE_S must be wide enough that read_psi_mem_band yields a real band, not an honest-but-
  # wrong OFFLINE between mesh-psi-memory's own cron cycles.
  if [ -f "$MESH/.psi-memory-state" ]; then
    _pmband="$(read_psi_mem_band "$MESH/.psi-memory-state")"
    case "$_pmband" in
      QUIET|BUSY|PRESSURED|SATURATED) echo "  ok: read_psi_mem_band yields a real band on this node (psimem=$_pmband, PSIMEM_STALE_S=${PSIMEM_STALE_S}s)" ;;
      *) echo "  FAIL read_psi_mem_band: expected a real band on this node, got '$_pmband' (PSIMEM_STALE_S=${PSIMEM_STALE_S}s, mtime-age=$(( $(date +%s) - $(stat -c %Y "$MESH/.psi-memory-state" 2>/dev/null || echo 0) ))s)"; fail=1 ;;
    esac
  else
    echo "  n/a: no $MESH/.psi-memory-state on this node — psi-memory real-read gate skipped (nothing to read)"
  fi
  # REAL-READ gate: reachability ≠ producing. All 4 /proc files must be readable AND parseable
  # or the sense is hollow (green test with no real artifact).
  for _p in /proc/sys/kernel/random/entropy_avail /proc/net/sockstat /proc/swaps /proc/loadavg; do
    [ -r "$_p" ] || { echo "smoke-test: n/a ($_p unreadable — kernel not Linux? /procfs missing?); classify-logic ok"; exit 2; }
  done
  _e="$(awk '{print $1}' /proc/sys/kernel/random/entropy_avail 2>/dev/null || echo none)"
  _sk="$(head -1 /proc/net/sockstat 2>/dev/null || echo none)"
  _sw="$(awk 'NR==2{print $3, $4}' /proc/swaps 2>/dev/null || echo none)"
  _ld="$(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null || echo none)"
  # HOLLOW-FUSION regression gate (senses 2026-07-03): a full live run must end with ZERO
  # all-four-missing — the fusion refreshes its own on-demand inputs now (the 4.6-day
  # all-OFFLINE hollow). Skipped only if the input tools aren't deployed (source-tree test).
  if command -v mesh-entropy >/dev/null 2>&1; then
    # SANDBOX-HOME (task test-live-writes 2026-07-20): pre-fix this live run refreshed the four
    # input senses INTO THEIR LIVE STATES (.entropy-state etc.) and wrote the live fusion state —
    # 5 live artifacts stamped per smoke. The input tools hardcode $HOME/.mesh, so the sandbox is a
    # throwaway HOME: the children still run the REAL refresh chain end-to-end (/proc reads are
    # HOME-independent; PATH keeps the parent's real dirs as suffix), the hollow-fusion regression
    # gate keeps its full meaning, and zero live files move — proven by the %y sig gate below.
    _nh_home="$(mktemp -d)"; mkdir -p "$_nh_home/.mesh"
    _nh_files="$HOME/.mesh/.node-health-state $HOME/.mesh/.entropy-state $HOME/.mesh/.sockstat-state $HOME/.mesh/.swap-state $HOME/.mesh/.loadavg-state"
    _nh_sig=""; for _f in $_nh_files; do _nh_sig="$_nh_sig;$(stat -c '%y %s' "$_f" 2>/dev/null || echo A)"; done
    HOME="$_nh_home" "$0" >/dev/null 2>&1
    _nh_state="$_nh_home/.mesh/.node-health-state"
    if grep -q 'missing: entropy,sockstat,swap,loadavg' "$_nh_state" 2>/dev/null; then
      rm -rf "$_nh_home"
      echo "smoke-test: FAIL (live run still reads ALL inputs OFFLINE — input refresh not firing, fusion is hollow)"; exit 1
    fi
    [ -s "$_nh_state" ] || { rm -rf "$_nh_home"; echo "smoke-test: FAIL (sandbox-HOME run produced no fusion state — leg is vacuous, not sandbox-clean)"; exit 1; }
    echo "  ok: live fusion non-hollow ($(cut -d'|' -f1-7 "$_nh_state" 2>/dev/null))"
    rm -rf "$_nh_home"
    # sandbox honesty gate: none of the 5 live artifacts moved. Falsify: drop the HOME override.
    _nh_sig2=""; for _f in $_nh_files; do _nh_sig2="$_nh_sig2;$(stat -c '%y %s' "$_f" 2>/dev/null || echo A)"; done
    [ "$_nh_sig2" = "$_nh_sig" ] || { echo "smoke-test: FAIL (live-fusion leg stamped a LIVE artifact: '$_nh_sig' → '$_nh_sig2')"; exit 1; }
  fi
  echo "smoke-test: ok (classify: 16 cases + swap-psi×6 + swap-psimem×5 + swap-HIGH-psi×8 + REAL reads: entropy=$_e, sockstat=$_sk, swap=$_sw, loadavg=$_ld)"
  exit 0
fi

# --- Live read path ---
# REFRESH inputs first (hollow-fusion fix, senses 2026-07-03): the four input senses are
# orphan-ok ON-DEMAND tools — nothing else schedules them, so their states went stale 10min
# after the last manual run and this cron-green fusion emitted the same all-OFFLINE verdict
# every 5min for 4.6 days. They are pure local /proc reads (~60ms for all four), so the
# scheduled consumer IS the on-demand caller. A tool that errors/vanishes still reads OFFLINE
# below — the honest rail stays; MESH_NODE_HEALTH_NO_REFRESH=1 lets --test fixtures skip this.
if [ -z "${MESH_NODE_HEALTH_NO_REFRESH:-}" ]; then
  for _t in mesh-entropy mesh-sockstat mesh-swap mesh-loadavg; do
    command -v "$_t" >/dev/null 2>&1 && "$_t" >/dev/null 2>&1 || true
  done
fi
entropy="$(read_label "$MESH/.entropy-state")"
sockstat="$(read_label "$MESH/.sockstat-state")"
swap="$(read_label "$MESH/.swap-state")"
loadavg="$(read_label "$MESH/.loadavg-state")"
# psi + psi-memory are independently cron-wired (their own reflex-cadences), unlike the 4 on-demand
# inputs above — no force-refresh needed here, just read their existing state (stale/missing →
# OFFLINE, honest).
psi="$(read_psi_band "$MESH/.psi.state")"
psimem="$(read_psi_mem_band "$MESH/.psi-memory-state")"

result="$(classify_node_health "$entropy" "$sockstat" "$swap" "$loadavg" "$psi" "$psimem")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|entropy=%s|sockstat=%s|swap=%s|loadavg=%s|psi=%s|psimem=%s|%s\n' "$label" "$entropy" "$sockstat" "$swap" "$loadavg" "$psi" "$psimem" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"entropy":"%s","sockstat":"%s","swap":"%s","loadavg":"%s","psi":"%s","psimem":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$entropy" "$sockstat" "$swap" "$loadavg" "$psi" "$psimem" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
  prev_label="${prev%%|*}"
  [ "$prev_label" = "$label" ] && exit 0
  printf '[nodehealth-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[nodehealth-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
