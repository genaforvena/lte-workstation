#!/usr/bin/env bash
# mesh-presence-trends — analyse accumulated BLE presence logs
# smoke-test: --test checks presence.log exists + readable
# Reads ~/.mesh/presence.log (self) + optionally peer's via SSH.
# Detects device ARRIVALS / DEPARTURES / TRANSIENTS / RESIDENTS.
#
#   mesh-presence-trends [--samples N]
#   mesh-presence-trends --peer user@host [--samples N]
#   mesh-presence-trends --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; LOG="$MESH/presence.log"
DEFAULT_SAMPLES=20; SAMPLE_WIN="$DEFAULT_SAMPLES"; PEER=""

for a in "$@"; do
  case "$a" in --samples) SAMPLE_WIN="${2:-$DEFAULT_SAMPLES}"; shift;; --peer) PEER="${2:-}"; shift;; --test) [ -f "$LOG" ] && [ -r "$LOG" ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL"; exit 1; };; esac
done

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
echo "=== mesh-presence-trends @ $(ts) ==="
echo "Window: last $SAMPLE_WIN of {self} samples"
[ -f "$LOG" ] || { echo "no $LOG"; exit 1; }

analyze(){
  local log="$1" label="$2"
  echo ""
  echo "» $label"
  local total; total="$(wc -l < "$log")"
  echo "  samples: $total"
  [ "$total" -lt 3 ] && { echo "  (insufficient data)"; return; }

  awk -v total="$total" -v win="$SAMPLE_WIN" '
  BEGIN { cutoff = total - win; if (cutoff < 1) cutoff = 1 }
  {
    s = $0
    # handle both "devices=[rssi|mac|name ...]" and older "closest=[rssi|mac|name]" format
    p1 = index(s, "devices=["); p2 = index(s, "closest=")
    if (p1) d = substr(s, p1 + 9)
    else if (p2) d = substr(s, p2 + 8)
    else next
    gsub(/\]/, "", d)
    n = split(d, toks, " ")
    for (i = 1; i <= n; i++) {
      split(toks[i], p, "|")
      if (length(p) < 2) continue
      rssi = p[1] + 0; mac = p[2]; nm = (length(p) >= 3 ? p[3] : "?")
      seen[mac]++; last[mac] = NR; rssi_last[mac] = rssi
      if (!first[mac]) first[mac] = NR
      rssi_sum[mac] += rssi
      if (!name[mac] && nm != "?") name[mac] = nm
      if (nm != "?" && name[mac] != nm) name[mac] = nm  # prefer named
    }
  }
  END {
    # classify
    for (mac in seen) {
      cnt = seen[mac]; fs = first[mac]; ls = last[mac]; avg = rssi_sum[mac] / cnt
      recently = (ls > cutoff)
      persistent = (cnt >= 3)
      consistent = (cnt >= total * 0.3)
      pct = (cnt / total) * 100

      if (recently && consistent)          cls = "resident"
      else if (recently && !consistent)    cls = "transient"
      else if (!recently && cnt >= 3)     cls = "DEPARTED"
      else if (!recently && cnt < 3)      cls = "gone"
      else                                 cls = "?"
      # arrivals: first seen in recent window
      if (fs > cutoff && cnt >= 2)         cls = "ARRIVED"
      if (fs > cutoff && cnt == 1)         cls = "new"

      data[mac] = cls; d_cnt[mac] = cnt; d_pct[mac] = pct; d_avg[mac] = avg
      d_name[mac] = (name[mac] ? name[mac] : "?"); d_last[mac] = ls
    }

    # print resident
    nres = 0; print "\n  ├─ RESIDENTS (always here):"; for (m in data) if (data[m] == "resident") { nres++; n = d_name[m]; printf "  │  %-22s %-28s %3d/%-3d %4.0f%%  avgRSSI=%3d\n", m, (length(n)>27?substr(n,1,24)"...":n), d_cnt[m], total, d_pct[m], d_avg[m] } if (!nres) print "  │  (none)"
    narr = 0; print "\n  ├─ ARRIVALS (newly seen):"; for (m in data) if (data[m] == "ARRIVED") { narr++; n = d_name[m]; printf "  │  %-22s %-28s %3d/%-3d %4.0f%%  avgRSSI=%3d\n", m, (length(n)>27?substr(n,1,24)"...":n), d_cnt[m], total, d_pct[m], d_avg[m] } if (!narr) print "  │  (none)"
    nnew = 0; print "\n  ├─ NEW (first seen, single sample):"; for (m in data) if (data[m] == "new") { nnew++; n = d_name[m]; printf "  │  %-22s %-28s  avgRSSI=%d\n", m, (length(n)>27?substr(n,1,24)"...":n), d_avg[m] } if (!nnew) print "  │  (none)"
    ndep = 0; print "\n  ├─ DEPARTURES (used to be here, gone):"; for (m in data) if (data[m] == "DEPARTED") { ndep++; n = d_name[m]; printf "  │  %-22s %-28s %3d/%-3d %4.0f%%  avgRSSI=%3d\n", m, (length(n)>27?substr(n,1,24)"...":n), d_cnt[m], total, d_pct[m], d_avg[m] } if (!ndep) print "  │  (none)"
    ngone = 0; print "\n  └─ GONE (seen once, not back):"; for (m in data) if (data[m] == "gone") ngone++; printf "     (%d devices seen once, not in recent window)\n", ngone

    print ""
    printf "     Summary: %d residents + %d arrivals + %d new + %d departures + %d gone = %d unique devices\n", nres, narr, nnew, ndep, ngone, length(data)
  }' "$log"
}

analyze "$LOG" "self: $(hostname)"

if [ -n "$PEER" ]; then
  pl="$(ssh "$PEER" 'cat "$HOME/.mesh/presence.log"' 2>/dev/null)" || { echo "  peer $PEER unreachable"; exit 0; }
  pf="/tmp/presence-peer-$$.log"; printf '%s\n' "$pl" > "$pf"
  analyze "$pf" "peer: $PEER"
  rm -f "$pf"
fi
# Also analyze fusion.log (cross-node overlap trends)
FL="$MESH/presence-fusion.log"
if [ -f "$FL" ] && [ "$(wc -l < "$FL")" -ge 2 ]; then
  echo ""
  echo "» cross-node fusion trends"
  echo "  log: presence-fusion.log"
  echo "  samples: $(wc -l < "$FL")"
  echo ""
  echo "  ├─ Overlap over time:"
  awk '{ n=$0; gsub(/.*overlap=/,"",n); gsub(/ .*/,"",n); printf "     %s  %s overlap\n", $1, n }' "$FL" | tail -5
  echo "  │"
  echo "  ├─ Latest fusion snapshot:"
  tail -1 "$FL"
  echo "  │"
  echo "  └─ Trend:"
  avg_ov=$(awk '{ n=$0; gsub(/.*overlap=/,"",n); gsub(/ .*/,"",n); s+=n; c++ } END { printf "%.0f", s/c }' "$FL")
  first_ov=$(awk '{ n=$0; gsub(/.*overlap=/,"",n); gsub(/ .*/,"",n); print n; exit }' "$FL")
  last_ov=$(tail -1 "$FL" | awk '{ n=$0; gsub(/.*overlap=/,"",n); gsub(/ .*/,"",n); print n }')
  first_ts=$(head -1 "$FL" | awk '{print $1}')
  last_ts=$(tail -1 "$FL" | awk '{print $1}')
  echo "     window: $first_ts → $last_ts"
  echo "     avg overlap: $avg_ov devices (first: $first_ov, last: $last_ov)"
fi

echo ""
echo "=== Done ==="
