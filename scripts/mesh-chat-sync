#!/usr/bin/env bash
# mesh-chat-sync — converge the chat BOARD across nodes so minds coordinate BETWEEN nodes.
#
# Until now each node's ~/.mesh/chat.log was node-local: a mind on IdeaPad couldn't see a mind on
# ilya. This anti-entropy reflex pulls every reachable peer's chat.log and merges (union → sort →
# dedup) into the local board. The board's lines are append-only + timestamped, so the union is a
# CRDT — precisely a GROW-ONLY SET (G-Set, the simplest state-based CRDT): each line is an immutable
# element, merge = set union (LC_ALL=C sort -u), idempotent + commutative + associative, so every
# node converges to ONE shared board regardless of pull order. Now [check]/[verify]/[task]/[done]
# posted on any node are seen by the planner (and every mind) on every node. (operator: "minds
# should coordinate between nodes".)
#
# WHY NOT last-writer-wins / vector clocks (a recurring idea — study 'crdt' brief 2026-06-12, audited
# 2026-06-21): both are the WRONG model for a message LOG and would REGRESS the append-only invariant.
# LWW is an LWW-Register CRDT — one mutable slot where concurrent writes are RESOLVED by DISCARDING all
# but the latest. A coordination board must KEEP every message ([[tmux-append-only]]); throwing away a
# concurrent [task]/[done] because another line shares its second is data loss, not conflict-resolution.
# Vector clocks DETECT concurrent-vs-causal writes so a register can flag conflicts — but a G-Set has NO
# conflicts to detect (union always converges), so they add per-node state to solve a problem we don't
# have. ("LWW vector clock" also conflates two distinct mechanisms: LWW picks a winner by wall-clock;
# vector clocks track causality precisely to AVOID needing a wall-clock winner — you use one OR the
# other, never both.) The board is already conflict-free by construction; the right CRDT was chosen.
#
#   mesh-chat-sync          one anti-entropy round (pull peers, merge, converge)
#   mesh-chat-sync --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
MESH="$HOME/.mesh"; LOG="$MESH/chat.log"
# Convergence-lag state: per-peer epoch of the last SUCCESSFUL anti-entropy pull. The gossip
# literature measures eventual consistency not as a binary but as STALENESS = anti-entropy
# propagation lag (Probabilistically Bounded Staleness / t-visibility — Bailis et al. VLDB 2012;
# delta-state anti-entropy — Almeida/Shoker/Baquero arXiv:1603.01529). We embodied the MECHANISM
# (union/sort/dedup convergence) but never the METRIC: a peer reachable-for-health yet silently
# failing this pull makes the board diverge with zero signal. `--lag` exposes per-peer t-visibility.
LAGF="$MESH/.chat-sync-lag"
# ── SESSION GUARANTEES: convergence ≠ a consistency model for a CONSUMER ────────────────────────
# (LITERATURE inoculation 2026-06-22, distributed-coordination critique — eventual consistency's
#  client-centric gap. Instrument-first: 0 behavior change; named so the HELD fix is a known unit.)
# The two blocks above settle the REPLICA side: the board CONVERGES (G-Set union, `:6-22`) and we
# MEASURE how stale a replica is (t-visibility, `:30-35`). Neither says anything about what a
# CONSUMER of the board may safely CONCLUDE from a single read — and that is a SEPARATE consistency
# axis the gossip literature names: SESSION GUARANTEES (Terry, Demers, Petersen, Spreitzer, Theimer
# & Welch, "Session Guarantees for Weakly Consistent Replicated Data", PDIS 1994 — the Bayou system,
# Xerox PARC). Eventual consistency provides convergence but NONE of the four client-centric
# guarantees: READ-YOUR-WRITES, MONOTONIC READS, WRITES-FOLLOW-READS, MONOTONIC WRITES. Modern tie:
# session guarantees are still the live tier layered on replicated logs (Mehdi et al., "Session
# Guarantees with Raft and Hybrid Logical Clocks", arXiv:1808.05698, 2018; Viotti & Vukolić,
# "Consistency in Non-Transactional Distributed Storage Systems", ACM Comput. Surv. 49(1), 2016).
# WHERE IT BITES (real, in-mesh): the [taking]/[done] re-dispatch path. `mesh-chat-review` already
# warns "a re-raised [task] double-dispatches a worker onto already-done work"; `mesh-dispatch`
# guards "double-dispatch"; `[[parallel-minds-same-goal-different-file]]` is the LOGGED harm (two
# minds raced one task). Root cause in this vocabulary: a node reading its CONVERGED-BUT-LAGGING
# board (the lag `--lag` quantifies) sees a stale view that does NOT yet reflect a peer's [done]/
# [taking] — a WRITES-FOLLOW-READS / MONOTONIC-READS violation. The [taking]-slug convention assumes
# the claimant can SEE prior claims; the t-visibility window is exactly when it cannot. So the file's
# own staleness METRIC has a consumer-side CONSEQUENCE it never names: a board read is a weakly-
# consistent read, and a reflex that treats "[task] not [done] on MY board" as ground truth inherits
# the lag as a re-dispatch hazard.
# HONEST SCOPE (refused to overclaim): session guarantees are PER-CLIENT view consistency; they do
# NOT provide cross-client MUTUAL EXCLUSION (two independent minds concurrently claiming needs
# CONSENSUS/CAS, which eventual consistency fundamentally cannot give — and the mesh already escalates
# that to git-as-lock for code, [[collective-stewardship-decide-in-chat]]). What session guarantees
# DO bound is the stale-READ class above. DISTINCT from the why-not-LWW/vector-clocks block (`:12-22`,
# which settles SET convergence — a replica property) and from t-visibility (`:30-35`, which MEASURES
# lag); this names the CONSUMER consistency tier the measured lag violates.
# HELD fix (steward/operator, behavioral): a read-your-writes / monotonic-read BARRIER — before a
# reflex honors or re-raises a claim it forces one anti-entropy pull (this tool) so its read
# monotonically includes peers' recent [taking]/[done], collapsing the t-visibility window for that
# decision. HELD because it is a new consumer contract on every board-scraper ([[cross-sense-vocab-
# contract]]) + a latency/staleness tradeoff (how fresh must a claim-read be?) that is the steward's.
# Peers to converge the board with. Override via MESH_CHAT_PEERS="user@ip ..."; otherwise DERIVE from
# the registry — every MESH_NODES entry whose role is 'mind' (router/sense carry no mind-board), deduped.
# A hardcoded list silently STRANDS any node it omits (ilya's ~9 agents sat idle 17.5h on an empty local
# board because it wasn't listed) — the cross-node task bridge IS this convergence; deriving keeps every
# mind-node (and any new one) in it automatically. Same registry-resolve pattern as mesh-knowledge-sync.
PEERS="${MESH_CHAT_PEERS:-}"
if [ -z "${PEERS//[[:space:]]/}" ]; then
  declare -A _CROLE; for r in ${MESH_ROLES:-}; do _CROLE["${r%%:*}"]="${r#*:}"; done
  for entry in ${MESH_NODES:-}; do
    label="${entry%%:*}"; tgt="${entry#*:}"
    [ "$tgt" = local ] && continue
    [ "${_CROLE[$label]:-mind}" = mind ] || continue
    PEERS="$PEERS $tgt"
  done
  PEERS="$(printf '%s\n' $PEERS | sort -u | tr '\n' ' ')"
fi
SSH="ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"

if [ "${1:-}" = --test ]; then
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v mktemp    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v sort      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sort)"; exit 1; }
  command -v tail      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tail)"; exit 1; }
  command -v wc        >/dev/null 2>&1 || { echo "smoke-test: FAIL (no wc)"; exit 1; }
  command -v awk       >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v sed       >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  command -v date      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh" || { echo "smoke-test: FAIL (no temp mesh dir)"; exit 1; }
  cat > "$tmp/.mesh/chat.log" <<'EOF'
2026-06-12T06:00:00Z  a@node  ::  [taking] alpha
2026-06-12T06:00:00Z  a@node  ::  [taking] alpha
— legacy junk that must be dropped
[task] @old undated assignment
| mesh-foo | KEEP | table-row junk |
NODE                 REACHABLE  table-header junk
mesh-doctor: stray tool-output junk
6. Firewall — digit-starting continuation junk
8/8 match digit-starting junk
12:00:00Z  b@node  ::  old-format line
2026-06-12T06:01:00Z  b@node  ::  [done] beta
EOF
  out="$(
    sed -E "s/^([0-9]{2}:[0-9]{2}:[0-9]{2}Z) /0000-00-00T\\1 /" "$tmp/.mesh/chat.log" \
      | awk -v today="$(date -u +%F)" -v yday="$(date -u -d yesterday +%F)" -v now="$(date -u +%H:%M:%S)" '{
          if ($0 ~ "^" today "T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z") {
            t = substr($0, length(today) + 2, 8)
            if (t > now) { print yday "T" substr($0, length(today) + 2); next }
          }
          print
        }' \
      | grep -E '^[0-9]{4}-|^[0-9]{2}:' \
      | LC_ALL=C sort -u | tail -3000
  )" || { echo "smoke-test: FAIL (merge dry-run failed)"; exit 1; }
  printf '%s\n' "$out" | grep -q '^0000-00-00T12:00:00Z  b@node  ::  old-format line$' || {
    echo "smoke-test: FAIL (legacy timestamp normalization missing)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[task\] @' && { echo "smoke-test: FAIL (undated task junk survived)"; exit 1; }
  printf '%s\n' "$out" | grep -q '^—' && { echo "smoke-test: FAIL (manifesto junk survived)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^\||^NODE|^mesh-' && { echo "smoke-test: FAIL (non-digit junk survived the invariant filter)"; exit 1; }
  printf '%s\n' "$out" | grep -qE '^6\. |^8/8' && { echo "smoke-test: FAIL (digit-starting continuation junk survived)"; exit 1; }
  [ "$(printf '%s\n' "$out" | grep -Fc '[taking] alpha')" -eq 1 ] || {
    echo "smoke-test: FAIL (duplicate collapse failed)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\S' || { echo "smoke-test: FAIL (no merged output)"; exit 1; }
  # convergence-lag metric (--lag): fresh peer → OK, long-stale → STALE, epoch-0 → NEVER-CONVERGED.
  now_e=$(date +%s)
  printf 'fresh@n %s\nstale@n %s\nnever@n 0\n' "$now_e" "$(( now_e - 99999 ))" > "$tmp/.mesh/.chat-sync-lag"
  lout="$(HOME="$tmp" MESH_CHATSYNC_LAG_WARN=1800 bash "$0" --lag 2>/dev/null)"
  echo "$lout" | grep -q 'fresh@n.*\[OK\]'           || { echo "smoke-test: FAIL (--lag: fresh peer not OK): $lout"; exit 1; }
  echo "$lout" | grep -q 'stale@n.*\[STALE\]'        || { echo "smoke-test: FAIL (--lag: 99999s-stale peer not STALE): $lout"; exit 1; }
  echo "$lout" | grep -q 'never@n.*NEVER-CONVERGED'  || { echo "smoke-test: FAIL (--lag: epoch-0 not NEVER-CONVERGED): $lout"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

# --lag: report per-peer convergence lag (t-visibility of the gossip board) — the staleness METRIC.
# lag = now - last successful pull from that peer. A peer whose lag exceeds the warn threshold while
# the node is otherwise pingable = a SILENT GOSSIP PARTITION (board diverging though health is green).
if [ "${1:-}" = --lag ]; then
  now_epoch=$(date +%s); thr="${MESH_CHATSYNC_LAG_WARN:-1800}"; worst=0; flag=0
  [ -f "$LAGF" ] || { echo "chat-sync lag: no anti-entropy round recorded yet"; exit 0; }
  while read -r p e; do
    [ -n "$p" ] || continue
    if [ "${e:-0}" -eq 0 ] 2>/dev/null; then printf '  %-30s NEVER-CONVERGED\n' "$p"; flag=1; continue; fi
    lag=$(( now_epoch - e )); [ "$lag" -gt "$worst" ] && worst=$lag
    st=OK; [ "$lag" -gt "$thr" ] && { st=STALE; flag=1; }
    printf '  %-30s lag=%ss  [%s]\n' "$p" "$lag" "$st"
  done < "$LAGF"
  echo "chat-sync convergence: worst peer lag ${worst}s (warn>${thr}s) — t-visibility of the shared board"
  exit "$flag"
fi

mkdir -p "$MESH"; touch "$LOG"
SELF_TS="$(tailscale ip -4 2>/dev/null | head -1)"

tmp="$(mktemp)"; cat "$LOG" > "$tmp"
pulled=0
now_epoch=$(date +%s)
declare -A _LAST
[ -f "$LAGF" ] && while read -r _pp _pe; do [ -n "$_pp" ] && _LAST["$_pp"]="$_pe"; done < "$LAGF"
# ── MERKLE-TREE ANTI-ENTROPY: verify convergence in O(1), reconcile only the DIFFERENCE (Dynamo) ──
# This pull is FULL-STATE every round: `cat ~/.mesh/chat.log` ships the peer's ENTIRE board (O(board),
# capped at tail -3000) and re-unions it, EVEN WHEN THE TWO BOARDS ARE ALREADY IDENTICAL. The metric
# distributed-systems anti-entropy uses to avoid exactly this is MERKLE-TREE reconciliation (Dynamo —
# DeCandia et al., "Dynamo: Amazon's Highly Available Key-value Store", SOSP 2007; same mechanism in
# Cassandra/Riak): each replica keeps a hash tree over its element set; two peers first exchange ROOT
# HASHES — equal ⇒ provably converged in O(1), ship NOTHING; unequal ⇒ recurse only into mismatching
# subtrees, so data exchanged is proportional to the DIVERGENCE, not the total size. We embodied the
# convergence MECHANISM (G-Set union, `:5-22`) and its LATENCY metric (PBS t-visibility, `:30-35`) but
# NOT its EFFICIENCY metric: there is no cheap "are we already in sync?" test, so a fleet of N already-
# converged boards still pays O(N·board) transfer every round. DISTINCT from the delta-state CRDT cite
# (`:33`): delta-CRDT ships small deltas of CHANGES once you KNOW them; Merkle is the cheap way to FIND
# whether/where there is any change at all (and to confirm convergence) — the missing pre-check upstream
# of either full-pull or delta-ship. HELD (behavioral, steward-gated): exchange a cheap digest first
# (even a one-shot `sha256sum`/`wc -l` of the dedup'd board, or a coarse bucketed hash tree) and SKIP
# the full `cat` when the peer's root digest matches local — validated to not mask a real divergence
# (the tail -3000 eviction window means two boards can share a root-relevant suffix yet differ in
# evicted history; the digest must be over the SAME windowed view both sides converge to). Not shipped.
for p in $PEERS; do
  case "$p" in *"${SELF_TS:-__none__}"*) continue ;; esac          # skip self
  port=""; case "$p" in u0_a386@*|u0_a380@*) port="-p ${PHONE_SSH_PORT:-8022}" ;; esac
  if $SSH $port "$p" 'cat ~/.mesh/chat.log 2>/dev/null' 2>/dev/null >> "$tmp"; then pulled=$((pulled+1)); _LAST["$p"]="$now_epoch"; fi
done
# persist per-peer last-successful-converge epoch (the convergence-lag metric state). A peer that
# fails this round keeps its OLD epoch → its lag grows → --lag surfaces the silent partition.
{ for p in $PEERS; do
    case "$p" in *"${SELF_TS:-__none__}"*) continue ;; esac
    printf '%s %s\n' "$p" "${_LAST[$p]:-0}"
  done; } > "$LAGF.tmp" 2>/dev/null && mv -f "$LAGF.tmp" "$LAGF" 2>/dev/null || true
# normalize old-format timestamps for SORTING ONLY — sentinel 0000-00-00, NOT today's date:
# stamping $(date) fabricated history (yesterday's posts re-surfaced dated TODAY 2026-06-11 —
# planner chased ghost steward-pushes for a tick). Unknown date stays visibly unknown; legacy
# lines sort before all dated lines as an "earlier era".
sed -i -E "s/^([0-9]{2}:[0-9]{2}:[0-9]{2}Z) /0000-00-00T\1 /" "$tmp" 2>/dev/null || true
# repair provably-future stamps from peers still carrying the 2026-06-11 fabrication: a line
# dated today with a time AFTER now cannot be today's — it is yesterday's (see mesh-board-timerepair).
# Self-healing merge: peers converge via their own genome pull; we never write to them.
awk -v today="$(date -u +%F)" -v yday="$(date -u -d yesterday +%F)" -v now="$(date -u +%H:%M:%S)" '{
  if ($0 ~ "^" today "T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z") {
    t = substr($0, length(today) + 2, 8)
    if (t > now) { print yday "T" substr($0, length(today) + 2); next }
  }
  print
}' "$tmp" > "$tmp.r" && mv "$tmp.r" "$tmp"
# drop board junk so it can't re-merge from a peer. INVARIANT, not an enumeration: a board line
# starts with a digit (2026-…T dated, 0000- sentinel, or legacy HH:MMZ era). Everything else —
# manifesto "—" lines, undated [task]@, table rows "|…", stray tool output ("mesh-…", "NODE …") —
# is junk that sorts lexically AFTER all dates and camps at the visible tail; at the 3000-line cap
# each merge then evicts REAL dated history to keep junk (caught live 2026-06-13: 128 junk lines,
# board pinned at cap, oldest real lines falling off).
# (digit-start alone was NOT enough — "6. Firewall…"/"8/8 match…" continuation junk passed it)
grep -E '^[0-9]{4}-|^[0-9]{2}:' "$tmp" > "$tmp.f" 2>/dev/null && mv "$tmp.f" "$tmp"
# converge: dedup exact lines, stable sort (lines start YYYY-MM-DDTHH:MM:SSZ → chronological), bound size
LC_ALL=C sort -u "$tmp" | tail -3000 > "$LOG.new" 2>/dev/null && mv "$LOG.new" "$LOG"
rm -f "$tmp"
# convergence-lag summary (stdout only — NOT the board; routine sync is not coordination):
stale=0
for p in $PEERS; do
  case "$p" in *"${SELF_TS:-__none__}"*) continue ;; esac
  e="${_LAST[$p]:-0}"
  { [ "$e" -eq 0 ] 2>/dev/null || [ $(( now_epoch - e )) -gt "${MESH_CHATSYNC_LAG_WARN:-1800}" ]; } && stale=$((stale+1))
done
echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-sync: merged $pulled peer board(s); $(wc -l <"$LOG") lines converged; $stale peer(s) stale (--lag for t-visibility)"
