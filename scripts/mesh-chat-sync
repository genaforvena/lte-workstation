#!/usr/bin/env bash
# mesh-chat-sync — converge the chat BOARD across nodes so minds coordinate BETWEEN nodes.
#
# Until now each node's ~/.mesh/chat.log was node-local: a mind on IdeaPad couldn't see a mind on
# ilya. This anti-entropy reflex pulls every reachable peer's chat.log and merges (union → sort →
# dedup) into the local board. The board's lines are append-only + timestamped, so the union is a
# CRDT-ish set: every node converges to ONE shared board. Now [check]/[verify]/[task]/[done] posted
# on any node are seen by the planner (and every mind) on every node. (operator: "minds should
# coordinate between nodes".)
#
#   mesh-chat-sync          one anti-entropy round (pull peers, merge, converge)
#   mesh-chat-sync --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; LOG="$MESH/chat.log"
PEERS="${MESH_CHAT_PEERS:-}"
SSH="ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"

if [ "${1:-}" = --test ]; then
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v mktemp    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v sort      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sort)"; exit 1; }
  command -v tail      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tail)"; exit 1; }
  command -v wc        >/dev/null 2>&1 || { echo "smoke-test: FAIL (no wc)"; exit 1; }
  command -v awk       >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v sed       >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  command -v date      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh" || { echo "smoke-test: FAIL (no temp mesh dir)"; exit 1; }
  cat > "$tmp/.mesh/chat.log" <<'EOF'
2026-06-12T06:00:00Z  a@node  ::  [taking] alpha
2026-06-12T06:00:00Z  a@node  ::  [taking] alpha
— legacy junk that must be dropped
[task] @old undated assignment
12:00:00Z  b@node  ::  old-format line
2026-06-12T06:01:00Z  b@node  ::  [done] beta
EOF
  out="$(
    sed -E "s/^([0-9]{2}:[0-9]{2}:[0-9]{2}Z) /0000-00-00T\\1 /" "$tmp/.mesh/chat.log" \
      | awk -v today="$(date -u +%F)" -v yday="$(date -u -d yesterday +%F)" -v now="$(date -u +%H:%M:%S)" '{
          if ($0 ~ "^" today "T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z") {
            t = substr($0, length(today) + 2, 8)
            if (t > now) { print yday "T" substr($0, length(today) + 2); next }
          }
          print
        }' \
      | grep -vE '^—|^\[task\] @' \
      | LC_ALL=C sort -u | tail -3000
  )" || { echo "smoke-test: FAIL (merge dry-run failed)"; exit 1; }
  printf '%s\n' "$out" | grep -q '^0000-00-00T12:00:00Z  b@node  ::  old-format line$' || {
    echo "smoke-test: FAIL (legacy timestamp normalization missing)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[task\] @' && { echo "smoke-test: FAIL (undated task junk survived)"; exit 1; }
  printf '%s\n' "$out" | grep -q '^—' && { echo "smoke-test: FAIL (manifesto junk survived)"; exit 1; }
  [ "$(printf '%s\n' "$out" | grep -Fc '[taking] alpha')" -eq 1 ] || {
    echo "smoke-test: FAIL (duplicate collapse failed)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\S' || { echo "smoke-test: FAIL (no merged output)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

mkdir -p "$MESH"; touch "$LOG"
SELF_TS="$(tailscale ip -4 2>/dev/null | head -1)"

tmp="$(mktemp)"; cat "$LOG" > "$tmp"
pulled=0
for p in $PEERS; do
  case "$p" in *"${SELF_TS:-__none__}"*) continue ;; esac          # skip self
  port=""; case "$p" in u0_a386@*) port="-p 8022" ;; esac
  if $SSH $port "$p" 'cat ~/.mesh/chat.log 2>/dev/null' 2>/dev/null >> "$tmp"; then pulled=$((pulled+1)); fi
done
# normalize old-format timestamps for SORTING ONLY — sentinel 0000-00-00, NOT today's date:
# stamping $(date) fabricated history (yesterday's posts re-surfaced dated TODAY 2026-06-11 —
# planner chased ghost steward-pushes for a tick). Unknown date stays visibly unknown; legacy
# lines sort before all dated lines as an "earlier era".
sed -i -E "s/^([0-9]{2}:[0-9]{2}:[0-9]{2}Z) /0000-00-00T\1 /" "$tmp" 2>/dev/null || true
# repair provably-future stamps from peers still carrying the 2026-06-11 fabrication: a line
# dated today with a time AFTER now cannot be today's — it is yesterday's (see mesh-board-timerepair).
# Self-healing merge: peers converge via their own genome pull; we never write to them.
awk -v today="$(date -u +%F)" -v yday="$(date -u -d yesterday +%F)" -v now="$(date -u +%H:%M:%S)" '{
  if ($0 ~ "^" today "T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z") {
    t = substr($0, length(today) + 2, 8)
    if (t > now) { print yday "T" substr($0, length(today) + 2); next }
  }
  print
}' "$tmp" > "$tmp.r" && mv "$tmp.r" "$tmp"
# drop board junk so it can't re-merge from a peer: the legacy manifesto dump (lines starting "—")
# and old undated [task]@ assignments aren't board posts; they sort to the tail and pollute the view.
grep -vE '^—|^\[task\] @' "$tmp" > "$tmp.f" 2>/dev/null && mv "$tmp.f" "$tmp"
# converge: dedup exact lines, stable sort (lines start YYYY-MM-DDTHH:MM:SSZ → chronological), bound size
LC_ALL=C sort -u "$tmp" | tail -3000 > "$LOG.new" 2>/dev/null && mv "$LOG.new" "$LOG"
rm -f "$tmp"
echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-sync: merged $pulled peer board(s); $(wc -l <"$LOG") lines converged"
