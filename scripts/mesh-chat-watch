#!/usr/bin/env bash
# reflex-cadence: */3 * * * *
# mesh-chat-watch — wake the CHAT mind FAST when the board gains a genuinely coordination-relevant
# event, between its hourly mesh-chat-review deep-analysis passes. Operator 2026-06-17: "chat should
# react faster to fresh board activity" — chose a BOARD-CHANGE-GATED wake (not a blind timer).
#
# What wakes chat (role-appropriate — chat is the COORDINATION/analysis mind, NOT a worker):
#   [question] / [blocker] / [help]   → chat answers/coordinates
# (Operator comms are NOT matched here — they route through the tg channel, [[tg-mind-handles-operator]].
#  An earlier loose `operator` substring match falsely fired on [strand] lines that merely LIST
#  mesh-operator-* tool filenames — anchor to the unambiguous markers only.)
# Deliberately NOT [task] (those are worker work, routed to genome via mesh-feed/dispatch — a chat
# mind grabbing [task]s would be the wrong actor) and NOT mind-churn/[strand]/[drift]/[verify]/[done]
# (low-signal or already-handled; hourly chat-review weighs PATTERNS, this handles live EVENTS).
# Because those events are RARE, the gate is genuinely quiet when the board is quiet — no churn-feed.
#
# Edge-deduped (won't re-feed the same line) + IDLE-gated via mesh-mind-state (never interrupts a
# working/blocked/walled mind — [[self-feed-gate-on-mind-state]]: gate on --stats, never a raw pane grep).
#
#   mesh-chat-watch          feed chat the newest unseen actionable line, if chat IDLE
#   mesh-chat-watch --test   smoke (deps + gates + filter; no injection, no side effect)
# Exit 0 always (reflex-friendly).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

WIN="${MESH_CHAT_WATCH_WIN:-chat}"
CHATLOG="${CA_LOG:-$HOME/.mesh/chat.log}"
MARK="$HOME/.mesh/.chat-watch-lastfed"
LOOKBACK="${MESH_CHAT_WATCH_LINES:-40}"

# the role-appropriate actionable signal: newest [question]/[blocker]/[help] OR operator line in the
# recent window, that is not itself already a [taking]/[done]. Empty = nothing to wake for.
newest_actionable(){
  tail -n "$LOOKBACK" "$CHATLOG" 2>/dev/null \
    | grep -aE '\[question\]|\[blocker\]|\[help\]' \
    | grep -avE '\[taking\]|\[done\]|\[news\]' \
    | tail -1
}

card_declares_minds(){
  local l; l="$(grep -E '^[[:space:]]*minds:' "$HOME/.mesh-card" 2>/dev/null || true)"
  l="$(printf '%s' "$l" | sed 's/^.*minds:[[:space:]]*//')"
  case "$l" in *claude*|*opencode*|*codex*|*gemini*) return 0;; *) return 1;; esac
}

if [ "${1:-}" = --test ]; then
  command -v mesh-tell      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
  command -v mesh-mind-state>/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
  command -v mesh-chat-filter>/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat-filter)"; exit 1; }
  # filter must MATCH a [question], SKIP a [task]/[taking], and NOT false-match a [strand] line that
  # merely lists a mesh-operator-* tool name (the substring bug this script was fixed for).
  s="$(printf '%s\n%s\n%s\n%s\n' \
        '2026-01-01T00:00:00Z  a@n  ::  [task] build X' \
        '2026-01-01T00:00:01Z  b@n  ::  [question] which egress for Y?' \
        '2026-01-01T00:00:02Z  c@n  ::  [taking] b: build X' \
        '2026-01-01T00:00:03Z  land@n  ::  [strand] uncommitted: mesh-operator-home mesh-situation')"
  got="$(printf '%s' "$s" | grep -aE '\[question\]|\[blocker\]|\[help\]' | grep -avE '\[taking\]|\[done\]|\[news\]' | tail -1)"
  case "$got" in *'[question] which egress'*) :;; *) echo "smoke-test: FAIL (actionable filter wrong: '$got')"; exit 1;; esac
  if card_declares_minds; then cg=declares-minds; else cg=hands-off; fi
  echo "smoke-test: ok (win=$WIN lookback=$LOOKBACK card=$cg chatlog=$([ -r "$CHATLOG" ] && echo readable || echo MISSING))"
  exit 0
fi

# card gate — hands-off a node that declares no minds (operator rule 2026-06-15)
card_declares_minds || { echo "$(date -u +%FT%TZ) skip: card declares no minds (hands-off)"; exit 0; }
# window must exist
tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN" \
  || { echo "$(date -u +%FT%TZ) skip: no '$WIN' window"; exit 0; }

line="$(newest_actionable)"
[ -z "${line//[[:space:]]/}" ] && { echo "$(date -u +%FT%TZ) skip: no actionable board event"; exit 0; }
# edge-dedup — already fed this exact line?
[ "$line" = "$(cat "$MARK" 2>/dev/null || true)" ] && { echo "$(date -u +%FT%TZ) skip: already fed"; exit 0; }
# idle gate — never interrupt a working / blocked / rate-limited mind
st="$(mesh-mind-state "$WIN" 2>/dev/null | cut -f1)"
[ "$st" = IDLE ] || { echo "$(date -u +%FT%TZ) skip: $WIN is $st (only inject when IDLE)"; exit 0; }

prompt="$(printf '%s\n' "$line" | mesh-chat-filter 2>/dev/null || true)"
[ -z "${prompt//[[:space:]]/}" ] && { echo "$(date -u +%FT%TZ) skip: filter emitted nothing"; exit 0; }

if mesh-tell "$WIN" "$prompt" >/dev/null 2>&1; then
  printf '%s' "$line" > "$MARK"
  echo "$(date -u +%FT%TZ) fed $WIN: ${line:0:80}"
fi
exit 0
