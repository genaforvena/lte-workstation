#!/usr/bin/env bash
# mesh-motion-fuse — MOTION-ATTRIBUTION fusion: did the TRACKED BODY move, or did the
# UNTRACKED ENVIRONMENT move around a still node?
#
# Fuses TWO independent motion senses that measure DIFFERENT bodies:
#   * mesh-wifi-motion (NODE-LOCAL RF radar, phone-free): motion in the SPACE around this
#     stationary node — a body perturbs the node↔AP multipath even carrying no device.
#   * mesh-body-motion (PHONE IMU): whether the tracked body (the phone) is itself being
#     WALKED / CARRIED / HANDLED, vs lying STILL.
#
# Neither alone answers "is the activity the node/phone being handled, or PEOPLE moving around
# a put-down phone?". mesh-room-sense folds both into one PRESENT/EMPTY occupancy verdict and
# loses this distinction. This tool exposes it:
#
#   BODY-MOVING   the tracked body itself is in motion (phone walked/carried/handled)
#   AMBIENT-ONLY  RF environment moving while the tracked body is STILL → someone/something
#                 moving in the space that is NOT the phone-holder (phone put down)
#   QUIET         both motion axes still — calm
#   STILL-RF      RF still BUT body axis unreachable — NOT confirmed quiet (phone may be moving
#                 elsewhere); honest-degraded, visibly different from QUIET
#   STILL-BODY    body still BUT RF axis unreachable — can't see ambient motion; honest-degraded
#   UNKNOWN       BOTH axes unreachable — cannot assess (exit 2; never a faked all-clear)
#
# Honest-fusion rule (operator doctrine): an UNREACHABLE input renders the verdict visibly
# DEGRADED, never a silent QUIET. The two STILL-* verdicts + the trailing `degraded=` field carry
# that; a single live axis still yields a verdict, but flagged.
#
# PEER-RF RESCUE (3rd axis, 2026-07-02): the local RF axis goes UNCERTAIN on thin night tape
# (diurnal — neighbour APs fade below the anchor floor at this vantage; evidence
# ~/.mesh/knowledge/wifi-motion-diurnal-thinness.md). The mesh has OTHER wifi vantages
# (default-string's USB adapter is a PROVEN distinct RSSI anchor, cf. mesh-wifi-crossval 3rd
# vantage). When — and ONLY when — the local RF read is UNREACH/UNCERTAIN, this tool queries the
# peer's own `mesh-wifi-motion` over SSH and lets a LIVE peer verdict stand in for the RF axis:
# previously-UNKNOWN states become assessable. A peer-backed reading is NEVER a clean local one —
# `degraded=` carries `rf-peer` and the JSON gains `rf_src:"peer"` (honest-fusion: visibly
# different vantage, never a silent substitution). Peer unreachable/UNCERTAIN → exactly the old
# behaviour (back-compat; a flaky peer can never flip a live local verdict — it is consulted only
# when local RF is already blind).
#   MESH_MOTION_FUSE_PEER          ssh target for the peer RF vantage (default: mesh-peer-addr default-string)
#   MESH_MOTION_FUSE_PEER_TIMEOUT  peer read timeout, s (default 20)
#
#   mesh-motion-fuse           one-line attribution verdict to stdout (exit 0; 2 if both axes dark)
#   mesh-motion-fuse --json    machine-readable {verdict, wifi, body, intensity, corroborated, degraded, rf_src, reason, ts}
#   mesh-motion-fuse --test    smoke-test (synthetic axis overrides — no live read, no phone, no network)
#
# Vocab contract: FIRST token after "[motion-fuse] " is the verdict above and appears nowhere
# else in the line (consumers grep -q 'AMBIENT-ONLY' etc.). Read-only (no actuators).
#
# orphan-ok: on-demand motion-ATTRIBUTION query, not a scheduled sense. Both axes (wifi-motion,
# body-motion) are already independently cached by their own reflexes and room-sense fuses occupancy
# on a timer, so wiring this to cron would only duplicate them while adding a phone-SSH read that
# drains the (often low) Redmi battery. No consumer reads a cached artifact — the mind pulls it live
# when it wants BODY-vs-AMBIENT attribution (the distinction room-sense collapses).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

BODY_TIMEOUT="${MESH_MOTION_FUSE_BODY_TIMEOUT:-25}"   # phone SSH read can be slow
PEER_TIMEOUT="${MESH_MOTION_FUSE_PEER_TIMEOUT:-20}"   # peer-RF rescue SSH read

# --- smoke-test: drive the fusion matrix via synthetic axis overrides; NO live read, no phone, no net ---
if [ "${1:-}" = --test ]; then
  fail=0
  check(){ # $1=wifi-override $2=body-override $3=expected-verdict $4=expected-degraded
    local got vd dg
    got="$(MOTION_FUSE_WIFI="$1" MOTION_FUSE_BODY="$2" "$0" 2>/dev/null)"
    vd="$(printf '%s' "$got" | sed -nE 's/^\[motion-fuse\] ([A-Z-]+) .*/\1/p')"
    dg="$(printf '%s' "$got" | grep -oE 'degraded=[a-z-]+' | cut -d= -f2)"
    if [ "$vd" != "$3" ] || [ "$dg" != "$4" ]; then
      echo "  FAIL: wifi='$1' body='$2' → verdict=$vd degraded=$dg (want $3/$4)"; fail=1
    fi
  }
  #     wifi            body          verdict       degraded
  check 'MOTION|STRONG' 'STILL|x'     AMBIENT-ONLY  none          # the headline case: env moves, phone still
  check 'MOTION|STRONG' 'MOVING|x'    BODY-MOVING   none          # both move → tracked body, RF corroborates
  check 'STILL|NONE'    'MOVING|x'    BODY-MOVING   none          # phone handled in place, RF still
  check 'STILL|NONE'    'STILL|x'     QUIET         none          # genuinely calm
  check 'MOTION|WEAK'   'UNREACH|-'   AMBIENT-ONLY  body-unreach  # env moves, phone dark → flagged, NOT QUIET
  check 'STILL|NONE'    'UNREACH|-'   STILL-RF      body-unreach  # RF still + phone dark → NOT a faked QUIET
  check 'UNREACH|-'     'STILL|x'     STILL-BODY    rf-unreach    # phone still + RF dark → flagged
  check 'UNREACH|-'     'MOVING|x'    BODY-MOVING   rf-unreach    # phone moving, RF dark → still attributable
  check 'UNREACH|-'     'UNREACH|-'   UNKNOWN       both-unreach  # both dark → UNKNOWN, never all-clear
  # honest-degraded invariant: an unreachable axis must NEVER collapse to QUIET
  q="$(MOTION_FUSE_WIFI='STILL|NONE' MOTION_FUSE_BODY='UNREACH|-' "$0" 2>/dev/null)"
  printf '%s' "$q" | grep -q 'QUIET' && { echo "  FAIL: STILL+UNREACH must NOT read QUIET (honest-degraded)"; fail=1; }
  # exit-code contract: both-unreach must exit 2
  MOTION_FUSE_WIFI='UNREACH|-' MOTION_FUSE_BODY='UNREACH|-' "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || { echo "  FAIL: both-unreach must exit 2 (cannot-assess)"; fail=1; }
  # --- peer-RF rescue matrix (local RF forced blind; peer axis synthetic — NO ssh fires) ---
  checkp(){ # $1=peer-rf $2=body $3=expected-verdict $4=expected-degraded
    local got vd dg
    got="$(MOTION_FUSE_WIFI='UNREACH|-' MOTION_FUSE_PEER_RF="$1" MOTION_FUSE_BODY="$2" "$0" 2>/dev/null)"
    vd="$(printf '%s' "$got" | sed -nE 's/^\[motion-fuse\] ([A-Z-]+) .*/\1/p')"
    dg="$(printf '%s' "$got" | grep -oE 'degraded=[a-z-]+' | cut -d= -f2)"
    if [ "$vd" != "$3" ] || [ "$dg" != "$4" ]; then
      echo "  FAIL(peer): peer='$1' body='$2' → verdict=$vd degraded=$dg (want $3/$4)"; fail=1
    fi
  }
  #      peer-rf         body          verdict       degraded
  checkp 'MOTION|STRONG' 'STILL|x'     AMBIENT-ONLY  rf-peer               # peer sees the motion the blind local tape missed
  checkp 'STILL|NONE'    'STILL|x'     QUIET         rf-peer               # peer-backed calm — flagged, never a clean local QUIET
  checkp 'STILL|NONE'    'UNREACH|-'   STILL-RF      body-unreach-rf-peer  # both degradations visible, composed
  checkp 'MOTION|WEAK'   'MOVING|x'    BODY-MOVING   rf-peer               # peer corroborates room-scale movement
  checkp 'UNREACH|-'     'STILL|x'     STILL-BODY    rf-unreach            # peer ALSO dark → exactly the old behaviour
  # peer-backed reading must never render degraded=none (visibly different from a clean local read)
  p="$(MOTION_FUSE_WIFI='UNREACH|-' MOTION_FUSE_PEER_RF='STILL|NONE' MOTION_FUSE_BODY='STILL|x' "$0" 2>/dev/null)"
  printf '%s' "$p" | grep -q 'degraded=none' && { echo "  FAIL: peer-backed read must NOT show degraded=none"; fail=1; }
  # --- precision-weighting the body axis (aberrant-precision guard, Benrimoh et al. 2018) ---
  # mesh-body-motion emits a per-state confidence (0.0-1.0, sensor-coverage precision). A body read
  # BELOW BODY_CONF_MIN must not masquerade as a full-precision corroboration: it flags
  # degraded=body-lowconf and demotes corr — a low-precision channel treated as precise is exactly the
  # failure mode. Override carries conf as a 3rd pipe field: VERDICT|tag|conf (2-field overrides above
  # keep conf empty → full precision → unchanged, which is why the 14 cases above still pass).
  lc="$(MOTION_FUSE_WIFI='MOTION|STRONG' MOTION_FUSE_BODY='MOVING|[body-walking]|0.30' "$0" --json 2>/dev/null)"
  printf '%s' "$lc" | grep -q '"degraded":"body-lowconf"' || { echo "  FAIL: low-conf body must flag degraded=body-lowconf (got: $lc)"; fail=1; }
  printf '%s' "$lc" | grep -q '"corroborated":"no"'       || { echo "  FAIL: low-conf body must NOT read corroborated=yes"; fail=1; }
  # falsifiability the other way: a HIGH-confidence body read keeps the clean corroboration + no flag
  hc="$(MOTION_FUSE_WIFI='MOTION|STRONG' MOTION_FUSE_BODY='MOVING|[body-walking]|0.90' "$0" --json 2>/dev/null)"
  printf '%s' "$hc" | grep -q 'body-lowconf'        && { echo "  FAIL: high-conf body must NOT flag lowconf (got: $hc)"; fail=1; }
  printf '%s' "$hc" | grep -q '"corroborated":"yes"' || { echo "  FAIL: high-conf body must keep corroborated=yes (got: $hc)"; fail=1; }
  # a low-conf reading on the UNREACHABLE body axis is a no-op (no verdict from that axis to weight)
  ur="$(MOTION_FUSE_WIFI='MOTION|STRONG' MOTION_FUSE_BODY='UNREACH|-|0.10' "$0" --json 2>/dev/null)"
  printf '%s' "$ur" | grep -q 'body-lowconf' && { echo "  FAIL: UNREACH body must NOT flag lowconf (nothing to weight)"; fail=1; }
  [ "$fail" = 0 ] && { echo "smoke-test: ok (attribution matrix 9 + peer-rescue 5 + honest-degraded + exit-2 contract + body-precision 5)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

# --- axis readers (overridable for --test: set MOTION_FUSE_WIFI / MOTION_FUSE_BODY to bypass live reads) ---
# wifi axis → echoes "VERDICT|INTENSITY" where VERDICT ∈ MOTION|STILL|UNREACH, INTENSITY ∈ WEAK|MODERATE|STRONG|NONE|-
read_wifi() {
  if [ -n "${MOTION_FUSE_WIFI:-}" ]; then printf '%s' "$MOTION_FUSE_WIFI"; return; fi
  local out tok inten
  out="$(mesh-wifi-motion 2>/dev/null)"
  if [ $? -ne 0 ] || [ -z "$out" ]; then printf 'UNREACH|-'; return; fi
  tok="$(printf '%s' "$out" | grep -oE '\b(MOTION|STILL|UNCERTAIN)\b' | head -1)"
  inten="$(printf '%s' "$out" | grep -oE 'intensity=[A-Z]+' | head -1 | cut -d= -f2)"
  case "$tok" in
    MOTION) printf 'MOTION|%s' "${inten:-STRONG}" ;;
    STILL)  printf 'STILL|%s'  "${inten:-NONE}" ;;
    *)      printf 'UNREACH|-' ;;   # UNCERTAIN / unparseable → cannot-assess
  esac
}
# body axis → echoes VERDICT ∈ STILL|MOVING|UNREACH  (WALKING/CARRIED/HANDLED collapse to MOVING),
# then the raw [body-xxx] tag (or -), then mesh-body-motion's own confidence 0.0-1.0 (or empty).
# Schema is 3-field VERDICT|tag|conf; the confidence is the body sense's PRECISION for the emitted
# state (which sensors actually covered it) — carried so fusion can precision-weight it below rather
# than treat a partial-coverage read as fully precise (aberrant-precision guard).
read_body() {
  if [ -n "${MOTION_FUSE_BODY:-}" ]; then printf '%s' "$MOTION_FUSE_BODY"; return; fi
  local out tag conf
  out="$(timeout "$BODY_TIMEOUT" mesh-body-motion 2>/dev/null)"
  if [ $? -ne 0 ] || [ -z "$out" ]; then printf 'UNREACH|-|'; return; fi
  # THE EMITTED SIGN IS THE LEADING TOKEN, NEVER A SUBSTRING (2026-08-21, reception plane).
  # mesh-body-motion's hysteresis names the candidate it is WITHHOLDING in the same line it emits
  # the held sign on; unanchored, this grep attributed that candidate to the body and rendered
  # STILL|[body-still] with full confidence while the producer was emitting OFFLINE. Anchored, a
  # HELD/OFFLINE line yields no tag and falls to the '' arm = UNREACH — the honest degraded axis
  # this tool already models (degraded=body-unreach), not a fabricated STILL-BODY attribution.
  tag="$(printf '%s' "$out" | grep -oE '^\[body-[a-z]+\]' | head -1)"
  conf="$(printf '%s' "$out" | grep -oiE 'conf(idence)?=[0-9.]+' | head -1 | cut -d= -f2)"
  case "$tag" in
    '[body-still]')                                printf 'STILL|%s|%s' "$tag" "$conf" ;;
    '[body-walking]'|'[body-carried]'|'[body-handled]') printf 'MOVING|%s|%s' "$tag" "$conf" ;;
    '') printf 'UNREACH|-|' ;;
    *)  printf 'MOVING|%s|%s' "$tag" "$conf" ;;   # any other named motion state = the body moved
  esac
}

# peer-RF rescue axis → same "VERDICT|INTENSITY" vocabulary as read_wifi. Consulted ONLY when the
# local RF axis is blind. Test-sandbox rule (reflex-test doctrine): a synthetic local axis
# (MOTION_FUSE_WIFI set) means NO live outbound — the peer axis then comes only from
# MOTION_FUSE_PEER_RF or reads UNREACH.
read_peer_rf() {
  if [ -n "${MOTION_FUSE_PEER_RF:-}" ]; then printf '%s' "$MOTION_FUSE_PEER_RF"; return; fi
  [ -n "${MOTION_FUSE_WIFI:-}" ] && { printf 'UNREACH|-'; return; }
  local peer out tok inten
  peer="${MESH_MOTION_FUSE_PEER:-$(mesh-peer-addr default-string 2>/dev/null)}"
  [ -n "$peer" ] || { printf 'UNREACH|-'; return; }
  out="$(timeout "$PEER_TIMEOUT" ssh -o ConnectTimeout=6 -o BatchMode=yes -o StrictHostKeyChecking=no \
        "$peer" '~/.local/bin/mesh-wifi-motion' 2>/dev/null)"
  [ -n "$out" ] || { printf 'UNREACH|-'; return; }
  tok="$(printf '%s' "$out" | grep -oE '\b(MOTION|STILL|UNCERTAIN)\b' | head -1)"
  inten="$(printf '%s' "$out" | grep -oE 'intensity=[A-Z]+' | head -1 | cut -d= -f2)"
  case "$tok" in
    MOTION) printf 'MOTION|%s' "${inten:-STRONG}" ;;
    STILL)  printf 'STILL|%s'  "${inten:-NONE}" ;;
    *)      printf 'UNREACH|-' ;;   # UNCERTAIN peer can't rescue a blind local axis
  esac
}

# --- fuse ---
ts="$(date -u +%FT%TZ)"
wifi_raw="$(read_wifi)";  wifi="${wifi_raw%%|*}";  inten="${wifi_raw#*|}"
rf_src=local
if [ "$wifi" = UNREACH ]; then
  peer_raw="$(read_peer_rf)"
  if [ "${peer_raw%%|*}" != UNREACH ]; then
    wifi="${peer_raw%%|*}"; inten="${peer_raw#*|}"; rf_src=peer
  fi
fi
body_raw="$(read_body)";  IFS='|' read -r body btag body_conf <<<"$body_raw"

corr=no; degraded=none
case "${wifi}::${body}" in
  UNREACH::UNREACH)
    verdict=UNKNOWN; degraded=both-unreach
    reason="both motion axes unreachable (wifi tape stale/absent AND phone dark) — cannot assess" ;;
  *::MOVING)
    verdict=BODY-MOVING
    if [ "$wifi" = MOTION ]; then corr=yes
      reason="tracked body in motion ($btag); RF environment corroborates (intensity=$inten)"
    elif [ "$wifi" = STILL ]; then
      reason="tracked body in motion ($btag) but RF environment STILL — handled in place, no room-scale movement"
    else degraded=rf-unreach
      reason="tracked body in motion ($btag); RF axis unreachable (can't corroborate room-scale movement)"
    fi ;;
  MOTION::STILL)
    verdict=AMBIENT-ONLY; corr=yes
    reason="RF environment moving (intensity=$inten) while tracked body STILL ($btag) — someone/something moving near a put-down phone, NOT the phone-holder" ;;
  MOTION::UNREACH)
    verdict=AMBIENT-ONLY; degraded=body-unreach
    reason="RF environment moving (intensity=$inten); body axis unreachable — can't confirm it isn't the phone itself moving" ;;
  STILL::STILL)
    verdict=QUIET
    reason="both motion axes still ($btag + RF baseline) — calm, no tracked or ambient motion" ;;
  STILL::UNREACH)
    verdict=STILL-RF; degraded=body-unreach
    reason="RF environment still BUT body axis unreachable — phone may be moving elsewhere; NOT confirmed quiet" ;;
  UNREACH::STILL)
    verdict=STILL-BODY; degraded=rf-unreach
    reason="tracked body STILL ($btag) BUT RF axis unreachable — cannot see ambient/room motion" ;;
  *)
    verdict=UNKNOWN; degraded=parse
    reason="unclassified axis combination (wifi=$wifi body=$body)" ;;
esac

# precision-weight the body axis (aberrant-precision guard). mesh-body-motion emits a per-state
# confidence reflecting which sensors actually covered the emitted classification; a low-precision
# read (partial coverage) must not masquerade as a full-precision corroboration/attribution. When the
# body axis contributed a verdict (STILL/MOVING) with confidence below BODY_CONF_MIN, demote corr and
# flag degraded=body-lowconf — the graded extension of honest-fusion's binary reachable/UNREACH.
# Down-weighting the precision of a channel to match its actual reliability is the fix the literature
# names for false-positive inference (Benrimoh, Parr, Vincent, Adams & Friston, Computational
# Psychiatry 2018): a low-precision channel treated as precise is aberrant precision.
BODY_CONF_MIN="${MESH_MOTION_FUSE_BODY_CONF_MIN:-0.5}"
if [ -n "${body_conf:-}" ] && [[ "$body_conf" =~ ^[0-9.]+$ ]] \
   && awk "BEGIN{exit !($body_conf < $BODY_CONF_MIN)}"; then
  case "$body" in
    STILL|MOVING)
      corr=no
      if [ "$degraded" = none ]; then degraded=body-lowconf; else degraded="${degraded}-body-lowconf"; fi
      reason="$reason [body axis LOW-CONFIDENCE ($body_conf<$BODY_CONF_MIN) — partial sensor coverage, not a full-precision read]" ;;
  esac
fi

# peer-backed RF is never a clean local reading: flag it in degraded= + reason (honest-fusion)
if [ "$rf_src" = peer ]; then
  reason="$reason [RF axis via PEER vantage — local tape blind/thin; peer wifi-motion stood in]"
  if [ "$degraded" = none ]; then degraded=rf-peer; else degraded="${degraded}-rf-peer"; fi
fi

if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","wifi":"%s","body":"%s","intensity":"%s","corroborated":"%s","degraded":"%s","rf_src":"%s","reason":"%s","ts":"%s"}\n' \
    "$verdict" "$wifi" "$body" "$inten" "$corr" "$degraded" "$rf_src" "$reason" "$ts"
else
  printf '[motion-fuse] %s — %s | wifi=%s body=%s corr=%s degraded=%s\n' \
    "$verdict" "$reason" "$wifi" "$body" "$corr" "$degraded"
fi

[ "$verdict" = UNKNOWN ] && exit 2 || exit 0
