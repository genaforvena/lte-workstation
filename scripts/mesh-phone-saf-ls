#!/usr/bin/env bash
# mesh-phone-saf-ls — consume one Redmi SAF folder listing over the phone body lane.
#
# Every successful result is a fresh SSH read. The remote contract is
# `termux-saf-ls folder-uri` → JSON array; [] is valid empty data. Transport and remote
# failures remain UNKNOWN and never become an empty list.
#
# Exit codes: 0 = valid JSON array (including []); 1 = invalid local request/dependency;
# 2 = phone transport, remote command, or malformed response (UNKNOWN).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
DEFAULT_URI="${MESH_PHONE_SAF_LS_URI:-content://com.android.externalstorage.documents/tree/primary%3ADownload}"

usage() { echo "usage: $0 [--test|--help] FOLDER-URI" >&2; }

if [ "${1:-}" = --help ]; then usage; exit 0; fi
uri="${1:-$DEFAULT_URI}"
if [ "${1:-}" = --test ]; then uri="${MESH_PHONE_SAF_LS_TEST_URI:-$DEFAULT_URI}"; fi
if [ -z "$uri" ] || [[ "$uri" == *$'\n'* || "$uri" == *$'\r'* ]]; then
  echo "phone-saf-ls: folder URI is required and must be one line" >&2
  exit 1
fi

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no ssh)'; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no mesh-phone-ip)'; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no python3 JSON validator)'; exit 1; }
fi

ip=""
if command -v mesh-phone-ip >/dev/null 2>&1; then ip="$(timeout 12 mesh-phone-ip 2>/dev/null)" || ip=""; fi
if [ -z "$ip" ]; then
  echo "[phone-saf-ls] UNKNOWN folder-uri=$uri why=transport-unreachable" >&2
  [ "${1:-}" = --test ] && echo 'smoke-test: n/a (Redmi unreachable)' >&2
  exit 2
fi

remote_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
remote_uri="$(remote_quote "$uri")"
result=""
rc=0
result="$(timeout 25 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@${ip}" \
  "termux-saf-ls $remote_uri" </dev/null 2>/dev/null)" || rc=$?
if [ "$rc" -ne 0 ]; then
  echo "[phone-saf-ls] UNKNOWN folder-uri=$uri why=transport-or-remote-failure rc=$rc" >&2
  [ "${1:-}" = --test ] && echo "smoke-test: n/a (SAF listing unavailable rc=$rc)" >&2
  exit 2
fi

if ! printf '%s' "$result" | python3 -c 'import json,sys; value=json.load(sys.stdin); raise SystemExit(0 if isinstance(value,list) else 1)' 2>/dev/null; then
  echo "[phone-saf-ls] UNKNOWN folder-uri=$uri why=malformed-json-array" >&2
  [ "${1:-}" = --test ] && echo 'smoke-test: FAIL (reachable Redmi returned non-array JSON)' >&2
  exit 2
fi

printf '%s\n' "$result"
if [ "${1:-}" = --test ]; then
  echo 'smoke-test: ok (live termux-saf-ls returned a JSON array)' >&2
fi
exit 0
