#!/usr/bin/env bash
# reflex-cadence: 9-59/10 * * * *
# reflex-args: 12
# WIRED 2026-08-21 (sound). This carried `orphan-ok: on-demand … pulled when a window wants room
# audio` and NOTHING EVER PULLED IT. That is not an on-demand organ, it is a silent one: the newest
# ear-*.wav on disk was 2026-07-24 (200 of them, one burst), while every OTHER note3 sense —
# light-raw, mag, motion, prox, thermal, orient, ambient, uxn-sense — has run */5..*/10 since July.
# The one note3 organ with no cadence was the sound lane's ONLY physically independent microphone,
# so the grind lane ate `ear` (the node's own mic) 6/6 and mesh-sound-reflex posted SOURCE-STARVED
# reading `note3 … SILENT 1d9h — the SOURCE stopped`. The source had not broken: `--test` on
# 2026-08-21T20:2xZ returned `ok (LIVE mic, rms 139.5)` on the first try. A declared-on-demand organ
# with no caller is indistinguishable from a dead one, and the starvation detector must not have to
# guess which. 12s because that is what the 2026-07-24 burst used (377644-byte wavs = 11.8s) and it
# is the length at which this material clears the grinder's rhythm floor — 188 of those 200 cleared
# it and lost the score race; only 12 fell below.
# mesh-note3-ear — LIVE microphone capture from the Note3 (SM-N900), a second physical ear.
#
# The Note3's YMU831 codec is DSP-firmware-routed: raw tinyalsa opens the capture PCM but streams
# ZEROS (the mic→ADC path needs the Samsung HAL's DSP init blob, not reproducible via tinymix).
# `slrec` — a native OpenSL ES recorder (NDK-built, ~/.mesh/note3/) run as ROOT — records THROUGH
# AudioFlinger → the HAL, which owns the routing. Proven live 2026-07-17 (rms 375, 92% nonzero).
# Output: 16 kHz mono S16 WAV. Root required (AudioFlinger recordingAllowed bypass for uid 0).
#
#   mesh-note3-ear [secs]        record <secs> (default 4) → prints WAV path + rms
#   mesh-note3-ear [secs] --raw  print the WAV path only (for piping to STT etc.)
#   mesh-note3-ear --test        real-read gate: capture must carry acoustic energy (exit 2 = unreachable)
#
# Exit codes: 0 = audio captured · 2 = phone unreachable · 1 = reachable but silent (hollow capture)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
ADB="adb -s $SERIAL"
OUTDIR="$HOME/.mesh/note3"; mkdir -p "$OUTDIR"

SECS=4; RAW=0
for a in "$@"; do case "$a" in --raw) RAW=1;; --test) MODE=test;; [0-9]*) SECS="$a";; esac; done

capture() {   # record $SECS on phone, pull PCM → WAV at $1; echo rms (empty on failure)
  local wav="$1" pcm="/data/local/tmp/note3-ear.pcm" lpcm="$OUTDIR/.ear.pcm"
  mesh-note3-tool-install slrec >/dev/null 2>&1 || return 1
  timeout $((SECS + 15)) $ADB shell "su -c '/data/local/tmp/slrec $pcm $SECS; chmod 666 $pcm'" >/dev/null 2>&1 || return 1
  timeout 20 $ADB pull "$pcm" "$lpcm" >/dev/null 2>&1 || return 1
  python3 -c "
import wave,array,math,sys
raw=open('$lpcm','rb').read()
if not raw: sys.exit(1)
a=array.array('h'); a.frombytes(raw)
w=wave.open('$wav','wb'); w.setnchannels(1); w.setsampwidth(2); w.setframerate(16000); w.writeframes(raw); w.close()
rms=math.sqrt(sum(x*x for x in a)/len(a)) if a else 0
print(f'{rms:.1f}')
" 2>/dev/null
}

if [ "${MODE:-}" = test ]; then
  if ! timeout 8 $ADB shell "echo ok" 2>/dev/null | grep -q ok; then echo "smoke-test: n/a (Note3 unreachable)"; exit 2; fi
  SECS=3; rms="$(capture "$OUTDIR/.ear-test.wav")"
  [ -z "$rms" ] && { echo "smoke-test: FAIL (no capture)"; exit 1; }
  ok="$(python3 -c "print(1 if float('$rms')>15 else 0)" 2>/dev/null)"
  [ "$ok" = 1 ] && echo "smoke-test: ok (LIVE mic, rms $rms)" || { echo "smoke-test: FAIL (silent capture rms $rms — codec routing lost)"; exit 1; }
  exit 0
fi

# Cap the capture dir: note3 wavs now feed the records archivist (mesh-records `note3` organ), so a
# continuous ear-loop caller would otherwise leak GBs here (575M on 2026-07-18). Keep the newest
# N — mesh-records dedupes on content and sweeps its own capped corpus, so a rolling window suffices.
KEEP="${MESH_NOTE3_EAR_KEEP:-200}"
ls -t "$OUTDIR"/ear-*.wav 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm -f 2>/dev/null

WAV="$OUTDIR/ear-$(date +%s 2>/dev/null || echo latest).wav"
rms="$(capture "$WAV")"
[ -z "$rms" ] && { echo "note3-ear: n/a (Note3 unreachable or capture failed)"; exit 2; }
silent="$(python3 -c "print(1 if float('$rms')<=15 else 0)" 2>/dev/null)"
if [ "$RAW" = 1 ]; then echo "$WAV"; else echo "wav=$WAV secs=$SECS rms=$rms"; fi
[ "$silent" = 1 ] && exit 1 || exit 0
