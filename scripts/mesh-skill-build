#!/usr/bin/env bash
# mesh-skill-build — extract a skill card from a verify-passing [done] message. ASPIRE-style
# continual learning: validated fixes become retrievable knowledge for future tasks.
# Reads a [done] message from stdin or argument, extracts symptom/diagnosis/fix/retrieval-cue,
# writes ~/.mesh/knowledge/skills/<slug>.md. Floor-gated by verification recency.
# Usage: mesh-skill-build "[done] message content" OR echo "[done]..." | mesh-skill-build
# reflex-cadence: none (on-demand, triggered by verify-passing [done] detection)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

SKILLS_DIR="${SKILLS_DIR:-$HOME/.mesh/knowledge/skills}"
mkdir -p "$SKILLS_DIR"

if [ "${1:-}" = "--test" ]; then
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  run(){ SKILLS_DIR="$td" "$0" "$1" 2>&1; }
  # regression (chat-review/skillbuild-slug-truncation): the old fallback slug generator was a raw
  # `cut -c1-50` over every lowercase word-run in the symptom — no stopword filter, no word-boundary
  # cutoff — so a long symptom with no explicit 'slug:'/'owner:' field produced a run-on, mid-word-
  # truncated id. Confirmed live 2026-07-05: 'fixed-mesh-mag-race-raced-driver-empty-read-every-'.
  # The bounded token-count generator must stay short, end on a whole word, and drop filler like "every".
  out="$(run '[done] fixed mesh-mag race raced the driver every empty read every cron backlog went stale for five days')"
  slug="$(printf '%s\n' "$out" | grep '^Slug:' | sed 's/^Slug: //')"
  case "$slug" in *-) echo "smoke-test: FAIL (slug ends with a trailing hyphen — mid-word/token cut: $slug)"; exit 1 ;; esac
  [ "${#slug}" -le 40 ] || { echo "smoke-test: FAIL (slug too long: $slug)"; exit 1; }
  tokens=$(( $(printf '%s' "$slug" | tr -cd '-' | wc -c) + 1 ))
  [ "$tokens" -le 6 ] || { echo "smoke-test: FAIL (slug has too many tokens ($tokens): $slug)"; exit 1; }
  case "-$slug-" in *-every-*) echo "smoke-test: FAIL (filler word 'every' leaked into slug: $slug)"; exit 1 ;; esac
  echo "  bounded fallback slug ok: $slug"
  # an ordinary short symptom still yields a real slug, not the content-free epoch fallback
  out2="$(run '[done] fixed the mesh-mag race condition in the empty read gate')"
  slug2="$(printf '%s\n' "$out2" | grep '^Slug:' | sed 's/^Slug: //')"
  case "$slug2" in skill-*) echo "smoke-test: FAIL (ordinary symptom fell through to the epoch fallback: $slug2)"; exit 1 ;; esac
  [ -n "$slug2" ] || { echo "smoke-test: FAIL (ordinary symptom produced an empty slug)"; exit 1; }
  echo "  ordinary symptom slug ok: $slug2"
  echo "smoke-test: ok (bounded whole-token slug: no trailing hyphen, length/token-capped, stopwords dropped, epoch fallback only for content-free input)"
  exit 0
fi

# Parse [done] message
done_msg="${1:-}"
if [ -z "$done_msg" ]; then
  done_msg=$(cat)
fi

# Extract key fields from [done] message format:
# [done] <owner>: <description> — commit <hash>
# [done] <slug>: <detailed description>
# or [done] <description> (no explicit slug)

timestamp=$(date -u +%Y-%m-%d)  # Default to today, could extract from message
author="unknown@unknown"
slug=""
symptom=""
diagnosis=""
fix=""
retrieval_cue=""
context=""

# Parse the [done] message structure
if [[ "$done_msg" =~ \[done\]\ (.+) ]]; then
  content="${BASH_REMATCH[1]}"

  # Try to extract slug (if present as "slug:" or "owner:")
  if [[ "$content" =~ ^([^:]+): ]]; then
    first_field="${BASH_REMATCH[1]}"
    # Board convention is "[done] <owner>: <description>" (owner is often a bare
    # name like "genome", not an email) — never trust it as the slug, or every
    # "genome:"-prefixed done message collides into one skill file. Only strip it
    # as an owner/noise prefix; the slug is always derived from content below.
    if [[ ! "$first_field" =~ \[ ]] && [[ ${#first_field} -lt 30 ]]; then
      [[ "$first_field" =~ @ ]] && author="$first_field"
      rest="${content#$first_field: }"
    else
      rest="$content"
    fi
  else
    rest="$content"
  fi

  # Extract commit hash if present
  if [[ "$rest" =~ commit\ ([a-f0-9]+) ]]; then
    commit_hash="${BASH_REMATCH[1]}"
    rest="${rest% — commit*}"
  fi

  # Main description is the symptom
  symptom="$rest"

  # Try to extract structured components from the description
  # Look for "FIXED —" pattern for retrieval cue
  if [[ "$symptom" =~ FIXED\ —\ (.+) ]]; then
    retrieval_cue="${BASH_REMATCH[1]}"
    symptom="${symptom%FIXED —*}"
  fi

  # Look for file references for fix
  if [[ "$symptom" =~ (File:\|files:)\ ([^\.]+) ]]; then
    fix_reference="${BASH_REMATCH[2]}"
    fix="See: $fix_reference"
    symptom="${symptom%File:*}"
    symptom="${symptom%files:*}"
  fi

  # Clean up symptom
  symptom=$(echo "$symptom" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
fi

# If we couldn't extract a slug, generate one from the symptom (chat-review/skillbuild-slug-
# truncation): tokenize on whole lowercase-letter runs (punctuation/hyphens are natural word
# boundaries, so tokens are never mid-word), drop short filler/stopwords, then join WHOLE tokens
# up to a token-count + length budget — the cutoff can only ever land on a token boundary, unlike
# the old raw `cut -c1-50` which severed mid-word and let filler words balloon the id into a
# run-on symptom dump (observed live: 'fixed-mesh-mag-race-raced-driver-empty-read-every-').
if [ -z "$slug" ]; then
  slug_max_tokens=6
  slug_max_len=40
  slug=""
  ntok=0
  for w in $(echo "$symptom" | tr '[:upper:]' '[:lower:]' | grep -oE '[a-z]+'); do
    [ "${#w}" -ge 3 ] || continue
    case "$w" in
      the|a|an|and|or|but|in|on|at|to|for|of|with|is|was|were|be|been|this|that|it|its|not|no|so|then|than|from|as|by|has|had|have|will|would|can|could|should|every|each|any|all|via|over|into|onto|out|off|up|down) continue ;;
    esac
    cand="${slug:+$slug-}$w"
    [ "${#cand}" -le "$slug_max_len" ] || break
    slug="$cand"
    ntok=$((ntok + 1))
    [ "$ntok" -ge "$slug_max_tokens" ] && break
  done
  if [ -z "$slug" ]; then
    slug="skill-$(date +%s)"
  fi
fi

# Create the skill card
skill_file="$SKILLS_DIR/${slug}.md"

# Check if skill already exists
if [ -f "$skill_file" ]; then
  echo "Skill already exists: $skill_file"
  echo "To update, remove the existing file first."
  exit 1
fi

# Write the skill card
cat > "$skill_file" <<EOF
---
slug: $slug
verified: $timestamp
author: $author
symptom: $symptom
diagnosis: $diagnosis
fix: $fix
retrieval_cue: $retrieval_cue
context: $context
---

## Symptom
$symptom

EOF

# Add additional sections if we have content
if [ -n "$diagnosis" ]; then
  cat >> "$skill_file" <<EOF
## Diagnosis
$diagnosis

EOF
fi

if [ -n "$fix" ]; then
  cat >> "$skill_file" <<EOF
## Fix
$fix

EOF
fi

if [ -n "$retrieval_cue" ]; then
  cat >> "$skill_file" <<EOF
## When to Retrieve
When: $retrieval_cue

EOF
fi

if [ -n "$context" ]; then
  cat >> "$skill_file" <<EOF
## Context
$context

EOF
fi

echo "Skill card created: $skill_file"
echo "Slug: $slug"
echo "Verified: $timestamp"
echo "Symptom: $symptom"