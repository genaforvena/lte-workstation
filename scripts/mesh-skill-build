#!/usr/bin/env bash
# mesh-skill-build — extract a skill card from a verify-passing [done] message. ASPIRE-style
# continual learning: validated fixes become retrievable knowledge for future tasks.
# Reads a [done] message from stdin or argument, extracts symptom/diagnosis/fix/retrieval-cue,
# writes ~/.mesh/knowledge/skills/<slug>.md. Floor-gated by verification recency.
# Usage: mesh-skill-build "[done] message content" OR echo "[done]..." | mesh-skill-build
# reflex-cadence: none (on-demand, triggered by verify-passing [done] detection)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

SKILLS_DIR="$HOME/.mesh/knowledge/skills"
mkdir -p "$SKILLS_DIR"

# Parse [done] message
done_msg="${1:-}"
if [ -z "$done_msg" ]; then
  done_msg=$(cat)
fi

# Extract key fields from [done] message format:
# [done] <owner>: <description> — commit <hash>
# [done] <slug>: <detailed description>
# or [done] <description> (no explicit slug)

timestamp=$(date -u +%Y-%m-%d)  # Default to today, could extract from message
author="unknown@unknown"
slug=""
symptom=""
diagnosis=""
fix=""
retrieval_cue=""
context=""

# Parse the [done] message structure
if [[ "$done_msg" =~ \[done\]\ (.+) ]]; then
  content="${BASH_REMATCH[1]}"

  # Try to extract slug (if present as "slug:" or "owner:")
  if [[ "$content" =~ ^([^:]+): ]]; then
    first_field="${BASH_REMATCH[1]}"
    # Check if it's likely a slug/owner or just start of description
    if [[ "$first_field" =~ @ ]]; then
      author="$first_field"
      rest="${content#$first_field: }"
    elif [[ ! "$first_field" =~ \[ ]]; then
      # Could be a slug
      slug="$first_field"
      rest="${content#$first_field: }"
    else
      rest="$content"
    fi
  else
    rest="$content"
  fi

  # Extract commit hash if present
  if [[ "$rest" =~ commit\ ([a-f0-9]+) ]]; then
    commit_hash="${BASH_REMATCH[1]}"
    rest="${rest% — commit*}"
  fi

  # Main description is the symptom
  symptom="$rest"

  # Try to extract structured components from the description
  # Look for "FIXED —" pattern for retrieval cue
  if [[ "$symptom" =~ FIXED\ —\ (.+) ]]; then
    retrieval_cue="${BASH_REMATCH[1]}"
    symptom="${symptom%FIXED —*}"
  fi

  # Look for file references for fix
  if [[ "$symptom" =~ (File:\|files:)\ ([^\.]+) ]]; then
    fix_reference="${BASH_REMATCH[2]}"
    fix="See: $fix_reference"
    symptom="${symptom%File:*}"
    symptom="${symptom%files:*}"
  fi

  # Clean up symptom
  symptom=$(echo "$symptom" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
fi

# If we couldn't extract a slug, generate one from the symptom
if [ -z "$slug" ]; then
  # Generate a simple slug from key words in the symptom
  slug=$(echo "$symptom" | grep -oE '[a-z-]{3,}' | tr '\n' '-' | sed 's/-$//;s/-\+/-/g' | cut -c1-50)
  if [ -z "$slug" ]; then
    slug="skill-$(date +%s)"
  fi
fi

# Create the skill card
skill_file="$SKILLS_DIR/${slug}.md"

# Check if skill already exists
if [ -f "$skill_file" ]; then
  echo "Skill already exists: $skill_file"
  echo "To update, remove the existing file first."
  exit 1
fi

# Write the skill card
cat > "$skill_file" <<EOF
---
slug: $slug
verified: $timestamp
author: $author
symptom: $symptom
diagnosis: $diagnosis
fix: $fix
retrieval_cue: $retrieval_cue
context: $context
---

## Symptom
$symptom

EOF

# Add additional sections if we have content
if [ -n "$diagnosis" ]; then
  cat >> "$skill_file" <<EOF
## Diagnosis
$diagnosis

EOF
fi

if [ -n "$fix" ]; then
  cat >> "$skill_file" <<EOF
## Fix
$fix

EOF
fi

if [ -n "$retrieval_cue" ]; then
  cat >> "$skill_file" <<EOF
## When to Retrieve
When: $retrieval_cue

EOF
fi

if [ -n "$context" ]; then
  cat >> "$skill_file" <<EOF
## Context
$context

EOF
fi

echo "Skill card created: $skill_file"
echo "Slug: $slug"
echo "Verified: $timestamp"
echo "Symptom: $symptom"