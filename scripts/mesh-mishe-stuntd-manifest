#!/usr/bin/env python3
"""Build a labeled stuntd manifest by joining feed pane pairs to legacy verdicts.

Legacy `mesh-pane-consume` already decides whether a cleaner pane change is worth
waking on: `surprise_of()` diffs the normalized frames and wakes on any unpredicted
line. That decision is deterministic and is recorded with a UTC timestamp in
pane-consume.log. This script recovers those verdicts as labels.

A pane pair (previous, current) is labeled `yes` when at least one legacy SURPRISE
verdict falls inside its open-closed timestamp window (previous < verdict <= current).
Every other pair is `no`. No label is inferred from pane content, timestamp
proximity alone, or receipt fanout; the verdict must already exist on disk.

The manifest is the input contract of `mesh-mishe-stuntd-export`, which re-validates
every pair against the feed and refuses to write training rows without both classes.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

QUESTION_VERSION = "projected-pair-v1.1"
LEGACY_LOG = "pane-consume.log"
CHANNEL = "cleaner"


def _parse_zulu(stamp: str) -> datetime:
    return datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone(timezone.utc)


def legacy_verdicts(home: Path, channel: str) -> list[datetime]:
    """UTC timestamps of legacy SURPRISE wake verdicts for one channel, ascending."""
    log = home / ".mesh" / LEGACY_LOG
    if not log.is_file():
        raise ValueError(f"legacy log not found: {log}")
    probe = subprocess.run(
        ["bash", "-c", f"grep -a '{channel}: SURPRISE' {log}"],
        capture_output=True,
        text=True,
        check=False,
    )
    stamps: list[datetime] = []
    for line in probe.stdout.splitlines():
        head = line.split(" ", 1)[0]
        try:
            stamps.append(_parse_zulu(head))
        except ValueError:
            continue
    stamps.sort()
    return stamps


def build(manifest_out: Path, feed_home: Path, home: Path, channel: str) -> tuple[int, int]:
    import os

    core = Path(os.environ.get("MESH_MISHE_CORE", str(Path.home() / "mishe-tauftauf")))
    sys.path.insert(0, str(core / "src"))
    from mishe_tauftauf.external_view import safe_publish_delta_view  # noqa: PLC0415
    from mishe_tauftauf.feed import Feed  # noqa: PLC0415

    verdicts = legacy_verdicts(home, channel)
    observations = [
        entry
        for entry in Feed(feed_home).entries()
        if entry.source == f"observation/{channel}"
    ]
    if len(observations) < 2:
        raise ValueError(f"need at least two {channel} observations, found {len(observations)}")

    seen: set[str] = set()
    rows: list[dict] = []
    counts = {"yes": 0, "no": 0}
    skipped_unsafe = 0
    for previous, current in zip(observations, observations[1:]):
        pair = safe_publish_delta_view(previous.body, current.body)
        if pair is None:
            # Identical panes or a projection the privacy guard refuses to emit.
            skipped_unsafe += 1
            continue
        digest = hashlib.sha256(pair.encode("utf-8")).hexdigest()
        if digest in seen:
            continue
        window = (_parse_zulu(previous.timestamp), _parse_zulu(current.timestamp))
        hit = any(window[0] < verdict <= window[1] for verdict in verdicts)
        label = "yes" if hit else "no"
        basis = (
            "legacy mesh-pane-consume SURPRISE verdict inside the open-closed "
            "timestamp window of this feed pane pair"
        )
        rows.append(
            {
                "question_version": QUESTION_VERSION,
                "kind": "pane-pair",
                "previous_feed_sequence": previous.sequence,
                "current_feed_sequence": current.sequence,
                "pair_sha256": digest,
                "expected_label": label,
                "basis": basis,
            }
        )
        seen.add(digest)
        counts[label] += 1

    if not rows or not all(counts.values()):
        raise ValueError(
            f"insufficient labels: yes={counts['yes']} no={counts['no']} "
            f"(skipped {skipped_unsafe} unsafe or identical pairs)"
        )
    manifest_out.parent.mkdir(parents=True, exist_ok=True)
    tmp = manifest_out.with_suffix(manifest_out.suffix + ".tmp")
    tmp.write_text(
        "".join(json.dumps(row, ensure_ascii=True, sort_keys=True) + "\n" for row in rows),
        encoding="utf-8",
    )
    tmp.replace(manifest_out)
    try:
        manifest_out.chmod(0o600)
    except OSError:
        pass
    return counts["yes"], counts["no"]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--feed-home", type=Path, default=Path.home() / ".mesh/mishe-tauftauf")
    parser.add_argument("--channel", default=CHANNEL)
    args = parser.parse_args()
    try:
        yes, no = build(args.manifest, args.feed_home, Path.home(), args.channel)
    except (OSError, UnicodeError, ValueError, ImportError, KeyError) as exc:
        print(f"mesh-mishe-stuntd-manifest: UNKNOWN {exc}", file=sys.stderr)
        return 2
    print(f"mesh-mishe-stuntd-manifest: PASS yes={yes} no={no} total={yes + no}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
