#!/usr/bin/env bash
# mesh-since — bounded on-return brief: what changed since a human time expression.
# Reuses mesh-digest's zero-inference sources: git, chat.log, traces.log, live health.
#   mesh-since '2 hours ago'
#   mesh-since '2026-06-11 12:00 UTC'
#   mesh-since --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

REPO="${MESH_REPO:-$HOME/lte-workstation}"
MESH="${MESH_DIR:-$HOME/.mesh}"
CHAT="${MESH_CHAT_LOG:-$MESH/chat.log}"
TRACE="${MESH_TRACE_LOG:-$MESH/traces.log}"
LIMIT="${MESH_SINCE_LIMIT:-12}"
NOW_EPOCH="${MESH_SINCE_NOW:-$(date -u +%s)}"

usage() {
  echo "usage: mesh-since <when> [--send]" >&2
  echo "examples: mesh-since '2 hours ago' | mesh-since 'today 09:00 UTC'" >&2
}

parse_when() {
  date -u -d "$1" +%s 2>/dev/null
}

chat_matches() {
  local pattern="$1"
  python3 - "$CHAT" "$SINCE_EPOCH" "$NOW_EPOCH" "$LIMIT" "$pattern" <<'PY'
import datetime as dt
import re
import sys

path, since_s, now_s, limit_s, pattern = sys.argv[1:]
since, now, limit = int(since_s), int(now_s), int(limit_s)
rx = re.compile(pattern, re.I)
now_dt = dt.datetime.fromtimestamp(now, dt.timezone.utc)
rows = []
try:
    fh = open(path, encoding="utf-8", errors="replace")
except OSError:
    sys.exit(0)
with fh:
    for raw in fh:
        if not rx.search(raw):
            continue
        m = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\s+", raw)
        if m:
            try:
                stamp = dt.datetime.fromisoformat(m.group(1).replace("Z", "+00:00"))
            except ValueError:
                continue
        else:
            m = re.match(r"^(\d\d):(\d\d):(\d\d)Z\s+", raw)
            if not m:
                continue
            h, minute, sec = map(int, m.groups())
            stamp = now_dt.replace(hour=h, minute=minute, second=sec, microsecond=0)
            # chat.log has time-of-day only. A large future gap is yesterday across
            # midnight; a small future gap is clock skew and must not be reported yet.
            if stamp.timestamp() > now:
                if stamp.timestamp() - now > 12 * 3600:
                    stamp -= dt.timedelta(days=1)
                else:
                    continue
        if stamp.timestamp() < since:
            continue
        text = raw.rstrip().replace("  ::  ", " ")
        rows.append((stamp.timestamp(), text[:180]))
for _, text in rows[-limit:]:
    print("• " + text)
PY
}

trace_health() {
  python3 - "$TRACE" "$SINCE_EPOCH" "$LIMIT" <<'PY'
import datetime as dt
import re
import sys

path, since_s, limit_s = sys.argv[1:]
since, limit = int(since_s), int(limit_s)
rx = re.compile(r"HEALTH (?:FAIL|RECOVERED)|\b(?:ALERT|BLOCKED|RECOVERED)\b|internet starvation|egress", re.I)
rows = []
try:
    fh = open(path, encoding="utf-8", errors="replace")
except OSError:
    sys.exit(0)
with fh:
    for raw in fh:
        m = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\s+", raw)
        if not m or not rx.search(raw):
            continue
        try:
            stamp = dt.datetime.fromisoformat(m.group(1).replace("Z", "+00:00")).timestamp()
        except ValueError:
            continue
        if stamp >= since:
            rows.append((stamp, raw.rstrip().replace("  ::  ", " ")[:180]))
for _, text in rows[-limit:]:
    print("• " + text)
PY
}

if [ "${1:-}" = "--test" ]; then
  for dep in date git python3; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; exit 1; }
  done
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (repo missing)"; exit 1; }
  [ -r "$CHAT" ] || { echo "smoke-test: FAIL (chat log unreadable)"; exit 1; }
  parse_when "1 hour ago" >/dev/null || { echo "smoke-test: FAIL (date parser)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

[ $# -ge 1 ] || { usage; exit 2; }
WHEN="$1"; shift
SEND=0
[ "${1:-}" = "--send" ] && { SEND=1; shift; }
[ $# -eq 0 ] || { usage; exit 2; }
SINCE_EPOCH=$(parse_when "$WHEN") || { echo "mesh-since: cannot parse time: $WHEN" >&2; exit 2; }
[ "$SINCE_EPOCH" -le "$NOW_EPOCH" ] || { echo "mesh-since: time is in the future: $WHEN" >&2; exit 2; }
SINCE_ISO=$(date -u -d "@$SINCE_EPOCH" +%Y-%m-%dT%H:%M:%SZ)
NOW_ISO=$(date -u -d "@$NOW_EPOCH" +%Y-%m-%dT%H:%M:%SZ)
OUT=$(mktemp)
trap 'rm -f "$OUT"' EXIT

{
  echo "mesh since $SINCE_ISO -> $NOW_ISO"

  echo; echo "-- commits --"
  commits=$(cd "$REPO" 2>/dev/null && git log --since="@$SINCE_EPOCH" --until="@$NOW_EPOCH" --date=short --pretty='• %h %ad %s' 2>/dev/null | head -n "$LIMIT")
  printf '%s\n' "${commits:-• (none)}"

  echo; echo "-- decisions / coordination --"
  decisions=$(chat_matches '\[(norm|decision|plan|gap|substrate-claim|substrate-release|retire|discovery|idea)\]')
  printf '%s\n' "${decisions:-• (none flagged)}"

  echo; echo "-- completed work --"
  done_rows=$(chat_matches '\[done\]')
  printf '%s\n' "${done_rows:-• (none flagged)}"

  echo; echo "-- incidents / health deltas --"
  incidents=$(chat_matches '\[(health-fail|selfcare|doctor|organ-down|mind-blocked|storm|flag|blocker)\]')
  trace_rows=$(trace_health)
  if [ -n "$incidents$trace_rows" ]; then
    [ -n "$incidents" ] && printf '%s\n' "$incidents"
    [ -n "$trace_rows" ] && printf '%s\n' "$trace_rows"
  else
    echo "• (none flagged)"
  fi

  echo; echo "-- current health --"
  if command -v mesh-vitals >/dev/null 2>&1; then echo "• vitals: $(mesh-vitals 2>/dev/null || echo unavailable)"; fi
  if command -v mesh-isp-health >/dev/null 2>&1; then echo "• upstream: $(mesh-isp-health --verdict 2>/dev/null || echo unavailable)"; fi
  if command -v mesh-supervise >/dev/null 2>&1; then
    down=$(mesh-supervise --status 2>/dev/null | awk '$1!="UP"{print $2}' | paste -sd, -)
    echo "• supervised reflexes: ${down:+DOWN: $down}${down:-all UP}"
  fi
  if command -v tailscale >/dev/null 2>&1; then
    echo "• active tailnet peers: $(tailscale status 2>/dev/null | grep -c 'active')"
  fi
} > "$OUT"

cat "$OUT"
if [ "$SEND" -eq 1 ]; then
  command -v mesh-tg >/dev/null 2>&1 || { echo "[mesh-tg not found]"; exit 1; }
  mesh-tg "$(cat "$OUT")" >/dev/null && echo "[sent to operator Telegram]"
fi
