#!/usr/bin/env bash
# orphan-ok: on-demand phone USAGE-STATE fusion — combines mesh-body-thermal (battery heat) +
#   mesh-body-load (discharge/charge rate) into a derived signal NEITHER gives alone: what the phone
#   is doing electrically (IDLE / LIGHT-USE / ACTIVE-USE / HEAVY-USE / CHARGING / STRESS). A warm
#   battery alone could be charging; a high drain alone could be brief; warm + sustained high drain =
#   heavy active use; HOT + high load = battery/electrical stress. Complements mesh-body-context
#   (physical pose/motion) — this is the phone's electrical/thermal load state. Born on-demand; wire
#   a scheduled axis via `# reflex-cadence: <cron>` + mesh-autowire.
# mesh-body-usage — fuse thermal-band + load-band → phone usage-state.
#
# WHY THIS IS NEW: no tool fuses the two battery INTERPRETATIONS. mesh-body-power=level,
# mesh-body-thermal=temperature band, mesh-body-load=rate band. This fuses thermal+load (2 senses)
# into a usage-state no single axis gives. The cross-check also catches anomalies (HOT but IDLE
# drain = environmental heat / sun, not use; HEAVY drain but COOL = a brief burst).
#
# Honest-fusion contract (no silent all-clear):
#   * BOTH senses reachable        → confident usage-state
#   * ONE reachable, other UNREACH → DEGRADED (partial — states which axis is missing; NEVER a
#                                     confident IDLE built on an unread axis)
#   * BOTH unreachable             → UNKNOWN (battery/phone down)
#   UNREACHABLE renders visibly distinct from a genuine IDLE (cool + idle drain, both read).
#
#   mesh-body-usage           one usage-state line
#   mesh-body-usage --json    {usage, thermal, load, rate_ma, temp_c, charging, percentage, degraded, ts}
#   mesh-body-usage --edge    emit only on usage-state change
#   mesh-body-usage --test    fuse_usage fixtures (offline) + deps gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
STATE="$HOME/.mesh/.body-usage-state"

# fuse_usage <thermal_band|UNREACH> <load_band|UNREACH> → echoes "USAGE|reason" (pure, offline-testable).
# load_band encodes charge (TRICKLE/CHARGING/FAST-CHARGE) vs discharge (IDLE/LIGHT/ACTIVE/HEAVY).
fuse_usage() {
  local t="$1" l="$2"
  if [ "$t" = "UNREACH" ] && [ "$l" = "UNREACH" ]; then
    echo "UNKNOWN|both battery senses unreachable — can't assess usage"; return; fi
  if [ "$t" = "UNREACH" ] || [ "$l" = "UNREACH" ]; then
    local av="$t"; [ "$t" = "UNREACH" ] && av="$l"
    echo "DEGRADED|partial — only ${av} available (the other axis unreachable; no confident state)"; return; fi
  # STRESS: heat + high electrical load (heavy drain OR fast charge) — battery at risk
  if [ "$t" = "HOT" ] && { [ "$l" = "HEAVY" ] || [ "$l" = "FAST-CHARGE" ]; }; then
    echo "STRESS|thermal HOT + ${l} load — battery/electrical stress"; return; fi
  # CHARGING (plugged): load band is a charge band
  case "$l" in
    TRICKLE|CHARGING|FAST-CHARGE)
      if [ "$t" = "HOT" ] || [ "$t" = "WARM" ]; then echo "CHARGING|charging (${l}, ${t} — charging heat)"
      else echo "CHARGING|charging (${l}, ${t})"; fi
      return;;
  esac
  # Discharge bands → usage intensity (thermal as context)
  case "$l" in
    HEAVY)  echo "HEAVY-USE|high drain (${t}) — gaming/camera/hotspot/call";;
    ACTIVE) echo "ACTIVE-USE|active drain (${t}) — screen-on use";;
    LIGHT)  echo "LIGHT-USE|light drain (${t})";;
    IDLE|*) echo "IDLE|low drain (${t}) — parked/screen-off";;
  esac
}

if [ "${1:-}" = --test ]; then
  for d in python3 mesh-body-thermal mesh-body-load; do
    command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing fused-sense dep: $d)"; exit 1; }
  done
  _f=0
  u(){ fuse_usage "$1" "$2" | cut -d'|' -f1; }
  # Both reachable — discharge usage ladder:
  [ "$(u COOL   IDLE)"   = IDLE ]        || { echo "  FAIL: COOL+IDLE → IDLE"; _f=1; }
  [ "$(u NORMAL LIGHT)"  = LIGHT-USE ]   || { echo "  FAIL: NORMAL+LIGHT → LIGHT-USE"; _f=1; }
  [ "$(u NORMAL ACTIVE)" = ACTIVE-USE ]  || { echo "  FAIL: NORMAL+ACTIVE → ACTIVE-USE"; _f=1; }
  [ "$(u WARM   HEAVY)"  = HEAVY-USE ]   || { echo "  FAIL: WARM+HEAVY → HEAVY-USE"; _f=1; }
  # STRESS (HOT + HEAVY or FAST-CHARGE) wins over everything:
  [ "$(u HOT    HEAVY)"  = STRESS ]      || { echo "  FAIL: HOT+HEAVY → STRESS"; _f=1; }
  [ "$(u HOT    FAST-CHARGE)" = STRESS ] || { echo "  FAIL: HOT+FAST-CHARGE → STRESS"; _f=1; }
  # CHARGING bands:
  [ "$(u NORMAL CHARGING)" = CHARGING ]  || { echo "  FAIL: NORMAL+CHARGING → CHARGING"; _f=1; }
  [ "$(u COOL   TRICKLE)"  = CHARGING ]  || { echo "  FAIL: COOL+TRICKLE → CHARGING"; _f=1; }
  # HONEST-DEGRADED: one axis UNREACH → DEGRADED (NOT a confident IDLE); both UNREACH → UNKNOWN
  [ "$(u UNREACH IDLE)"   = DEGRADED ]   || { echo "  FAIL: thermal-UNREACH + IDLE → DEGRADED (not IDLE)"; _f=1; }
  [ "$(u COOL   UNREACH)" = DEGRADED ]   || { echo "  FAIL: COOL + load-UNREACH → DEGRADED"; _f=1; }
  [ "$(u UNREACH UNREACH)" = UNKNOWN ]   || { echo "  FAIL: both UNREACH → UNKNOWN"; _f=1; }
  # DEGRADED must NOT equal a genuine IDLE (no silent all-clear on an unread axis)
  [ "$(u UNREACH IDLE)" != "$(u COOL IDLE)" ] || { echo "  FAIL: DEGRADED must differ from genuine IDLE"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (fuse_usage logic)"; exit 1; }
  echo "smoke-test: ok (12 fusion assertions: usage ladder + STRESS + CHARGING + DEGRADED≠IDLE + UNKNOWN)"
  exit 0
fi

EDGE=0; JSON=0
for a in "$@"; do case "$a" in --edge) EDGE=1;; --json) JSON=1;; esac; done

# ---- Sample the two fused senses (each its own honest-exit-2-on-unreachable) ----
tj="$(timeout 25 mesh-body-thermal --json 2>/dev/null)"; trc=$?
lj="$(timeout 25 mesh-body-load    --json 2>/dev/null)"; lrc=$?

tband="UNREACH"; t_c=""; pct=""; charging=0
if [ "$trc" -eq 0 ] && [ -n "$tj" ]; then
  tband="$(printf '%s' "$tj" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("level","UNREACH"))' 2>/dev/null)"
  t_c="$(printf '%s' "$tj"  | python3 -c 'import json,sys; print(json.load(sys.stdin).get("temp_c",""))' 2>/dev/null)"
  pct="$(printf '%s' "$tj"  | python3 -c 'import json,sys; print(json.load(sys.stdin).get("percentage",""))' 2>/dev/null)"
  [ "$(printf '%s' "$tj" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("charging",False))' 2>/dev/null)" = "True" ] && charging=1
fi
lband="UNREACH"; rate=""
if [ "$lrc" -eq 0 ] && [ -n "$lj" ]; then
  lband="$(printf '%s' "$lj" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("load","UNREACH"))' 2>/dev/null)"
  rate="$(printf '%s' "$lj" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("rate_ma",""))' 2>/dev/null)"
  [ -z "$pct" ] && pct="$(printf '%s' "$lj" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("percentage",""))' 2>/dev/null)"
  [ "$charging" = 0 ] && [ "$(printf '%s' "$lj" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("charging",False))' 2>/dev/null)" = "True" ] && charging=1
fi

verdict="$(fuse_usage "$tband" "$lband")"
usage="${verdict%%|*}"; reason="${verdict#*|}"
degraded=false; case "$usage" in DEGRADED|UNKNOWN) degraded=true;; esac
TS="$(date -u +%Y-%m-%dT%H:%MZ)"
# Write STATE every run (unconditional → mtime = ran-live, not change-gated).
printf '%s\n' "$usage" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"usage":"%s","thermal":"%s","load":"%s","rate_ma":"%s","temp_c":"%s","charging":%s,"percentage":"%s","degraded":%s,"reason":"%s","ts":"%s"}\n' \
    "$usage" "$tband" "$lband" "${rate:-}" "${t_c:-}" "$charging" "${pct:-}" "$degraded" "$reason" "$TS"
  exit 0
fi
if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE.prev" 2>/dev/null || true)"; printf '%s\n' "$usage" > "$STATE.prev"
  [ "$usage" = "$prev" ] && exit 0
fi
printf '[body-usage-%s] %s — %s | thermal=%s load=%s %s°C %smA %s (%s%%)\n' \
  "${usage,,}" "$usage" "$reason" "$tband" "$lband" "${t_c:-?}" "${rate:-?}" \
  "$([ "$charging" = 1 ] && echo charging || echo unplugged)" "${pct:-?}"
