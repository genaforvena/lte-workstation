#!/usr/bin/env bash
# test-mesh-plant — "can a stranger plant this genome?" as a repeatable green/red check.
#
# Runs the NON-PRIVILEGED half of bootstrap.sh in a throwaway $HOME (no sudo/network/tailscale):
# install scripts/* → seed ~/.mesh/nodes from nodes.example → assert a fresh plant is healthy.
# Catches plant-breakers a read-through misses (e.g. a --test that needs runtime files that don't
# exist on a fresh node, or an operator IP baked into a tool).
#
#   test-mesh-plant            run all assertions; exit = number FAILED (0 = plantable)
#   test-mesh-plant --test     self-smoke
set -uo pipefail
REPO="${MESH_REPO:-$HOME/lte-workstation}"
[ "${1:-}" = --test ] && { [ -d "$REPO/scripts" ] && echo "smoke-test: ok" || { echo "smoke-test: FAIL (no repo)"; exit 1; }; exit 0; }

FAIL=0
pass(){ printf '  \033[32mPASS\033[0m %s\n' "$1"; }
fail(){ FAIL=$((FAIL+1)); printf '  \033[31mFAIL\033[0m %s\n' "$1"; }

SBX="$(mktemp -d)"; trap 'rm -rf "$SBX"' EXIT
echo "== test-mesh-plant: fresh plant in $SBX =="

# (1) install the body
mkdir -p "$SBX/.local/bin" "$SBX/.mesh/knowledge"
n=0
for f in "$REPO"/scripts/*; do
  b=$(basename "$f"); case "$b" in *.service|*.timer|*.bak*) continue ;; esac
  install -m755 "$f" "$SBX/.local/bin/" 2>/dev/null && n=$((n+1))
done
[ "$n" -gt 0 ] && pass "installed $n tools" || fail "no tools installed"

# (2) seed the registry from the template (what bootstrap does)
if [ -f "$REPO/nodes.example" ]; then
  cp "$REPO/nodes.example" "$SBX/.mesh/nodes" && chmod 600 "$SBX/.mesh/nodes"
  [ "$(stat -c %a "$SBX/.mesh/nodes")" = 600 ] && pass "registry seeded (600)" || fail "registry perms != 600"
else
  fail "no nodes.example to seed from"
fi

# (3) empty-registry resolution is graceful (a first node has no peers)
out=$(HOME="$SBX" "$SBX/.local/bin/mesh-peer-addr" somepeer 2>&1 | head -1)
case "$out" in *"unknown peer"*) pass "empty-registry resolution graceful" ;; *) fail "peer-addr on empty registry: $out" ;; esac

# (4) CORE tools (no hardware/secret/network deps) must --test PASS on a fresh plant. This is what
# catches real plant-breakers (a core tool needing runtime state that doesn't exist yet — how the
# mesh-route fresh-plant FAIL was found). Hardware/secret/network tools (voice-rx→BOT_TOKEN,
# transcribe-organ→whisper, find/presence→BLE, lan-presence→router, sync-tools→git remote) are
# EXPECTED n/a on a bare sandbox — reported, not failed.
CORE="mesh-doctor mesh-route mesh-reflect mesh-generate mesh-feed mesh-tick mesh-chaos-doctor mesh-organ-keepalive mesh-supervise mesh-card"
cfail=""; for t in $CORE; do
  [ -x "$SBX/.local/bin/$t" ] || continue
  grep -q -- '--test' "$SBX/.local/bin/$t" 2>/dev/null || continue
  HOME="$SBX" MESH_REPO="$REPO" timeout 20 "$SBX/.local/bin/$t" --test >/dev/null 2>&1 || cfail="$cfail $t"
done
[ -z "$cfail" ] && pass "all CORE --test pass on a fresh plant" || fail "fresh-plant CORE --test FAIL:$cfail"
# informational: which non-core tools are n/a until configured (hardware/secrets/network)
na=""; for t in "$SBX"/.local/bin/mesh-*; do
  b=$(basename "$t"); case " $CORE " in *" $b "*) continue ;; esac
  grep -q -- '--test' "$t" 2>/dev/null || continue
  HOME="$SBX" MESH_REPO="$REPO" timeout 20 "$t" --test >/dev/null 2>&1 || na="$na $b"
done
[ -n "$na" ] && echo "  n/a until configured (expected):$na"

# (5) no operator topology leaked into the installed tools (CGNAT host IPs, excl. examples)
allow2=$(printf '%s.%s.%s.%s' 100 64 0 2)
allow3=$(printf '%s.%s.%s.%s' 100 64 0 3)
allow4=$(printf '%s.%s.%s.%s' 100 64 0 4)
leak=$(grep -rhoE '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+' "$SBX/.local/bin/" 2>/dev/null \
       | grep -vE '\.0\.0$' | grep -vxF "$allow2" | grep -vxF "$allow3" | grep -vxF "$allow4" | sort -u | head -3)
[ -z "$leak" ] && pass "no hardcoded node IPs in installed tools" || fail "topology leak in tools: $(echo $leak)"

# (6) a planted host IP in a tool body is still caught, while config/CIDR/network-bases are ignored.
planted_ip=$(printf '%s.%s.%s.%s' 100 99 1 2)
network_base=$(printf '%s.%s.%s.%s' 100 99 0 0)
cidr_base=$(printf '%s.%s.%s.%s' 100 64 0 0)
mkdir -p "$SBX/fixtures"
cat > "$SBX/fixtures/mesh-topology-leak-fixture" <<FIXTURE
#!/usr/bin/env bash
echo "user@$planted_ip"
echo "$cidr_base/10"
echo "$network_base"
echo "$planted_ip"
FIXTURE
chmod +x "$SBX/fixtures/mesh-topology-leak-fixture"
scan_topology_file() {
  local f="$1" leak=""
  while IFS= read -r line; do
    ip=$(printf '%s' "$line" | grep -oP '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+' | head -1)
    [ -z "$ip" ] && continue
    printf '%s' "$line" | grep -qE "[a-zA-Z0-9._-]+@$ip" && continue
    printf '%s' "$line" | grep -qE "$ip/[0-9]" && continue
    case "$ip" in *.*.0.0) continue ;; esac
    leak="$leak $ip"
  done < "$f"
  printf '%s' "$leak" | xargs -r
}
fixture_leak=$(scan_topology_file "$SBX/fixtures/mesh-topology-leak-fixture")
[ "$fixture_leak" = "$planted_ip" ] && pass "planted host IP detected; config/CIDR/network-base ignored" || fail "planted topology fixture not handled right: $(echo "$fixture_leak")"

echo "== test-mesh-plant: $FAIL failed =="
exit "$FAIL"
