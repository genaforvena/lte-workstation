#!/usr/bin/env bash
# mesh-window-repair — detect + auto-repair broken tmux panes (top data / bottom mind).
# A pane is broken if: blank, dead process, or bare shell below a dead mind footer.
#
#   mesh-window-repair          scan all windows, repair broken panes
#   mesh-window-repair --edge   cron mode: post to board only on state change
#   mesh-window-repair --test   smoke
# Exit: 0 = nothing broken · 1 = repaired something · 2 = n/a
EDGE=false; [ "${1:-}" = --edge ] && shift && EDGE=true
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
SESS="$(hostname)"; MESH="$HOME/.mesh"

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

# window → dash role (for data pane respawn)
dash_role(){
  case "$1" in
    plan)     echo plan;;
    health)   echo check;;
    verify)   echo verify;;
    work)     echo codex;;
    dev)      echo dev;;
    discover) echo discover;;
    sense)    echo sense;;
    minds)    echo minds;;
    tg)       echo tg;;
    tg-roz)   echo tg-roz;;
    chat)     echo chat;;
    derived)  echo derived;;
    *)        echo "$1";;
  esac
}

# is a pane "broken"? Check: process alive + doing its job.
pane_broken(){
  local pane="$1" role="$2"  # role: data or mind
  local pid cmdline
  pid="$(tmux display-message -t "$pane" -p '#{pane_pid}' 2>/dev/null)"
  [ -z "$pid" ] && return 0  # no PID → broken
  kill -0 "$pid" 2>/dev/null || return 0  # dead process → broken
  cmdline="$(ps -p "$pid" -o args= 2>/dev/null)"

  if [ "$role" = data ]; then
    # Known dash loops are always OK (process check, not content check)
    case "$cmdline" in
      *mesh-dash*|*mesh-chat\ --watch*|*watch\ -n*|*tail\ -n\ *\ -F*) return 1;;
    esac
    # Unknown command: check if pane has any visible non-blank content
    local vis
    vis="$(tmux capture-pane -t "$pane" -p 2>/dev/null | tr -d '[:space:]')"
    [ -z "$vis" ] && return 0  # blank → broken
    return 1  # has content → ok
  fi

  if [ "$role" = mind ]; then
    # Check if any process on this pane's tty is a known mind engine
    local tty; tty="$(tmux display -t "$pane" -p '#{pane_tty}' 2>/dev/null)"
    if [ -n "$tty" ] && ps -t "$tty" -o args= 2>/dev/null | grep -qE '(opencode|claude|codex)'; then
      return 1  # mind engine running on this pty → ok
    fi
    # No engine found on tty — check if pane shows engine footer (engine might be in subshell)
    local bot
    bot="$(tmux capture-pane -t "$pane" -p -S -5 2>/dev/null)"
    case "$bot" in
      *'OpenCode'*|*'Claude Code'*|*'Kodex'*) return 1;;  # footer still visible → alive
    esac
    # No engine running, no footer → mind is dead (bare shell)
    return 0
  fi
  return 1  # not broken
}

# respawn a data pane with the correct dash loop
respawn_data(){
  local pane="$1" win="$2"
  local role; role="$(dash_role "$win")"
  local cmd
  if [ "$win" = chat ]; then
    cmd="while :; do mesh-chat --watch 2>/dev/null; sleep 10; done"
  else
    cmd="while :; do mesh-dash $role 2>/dev/null; sleep 10; done"
  fi
  tmux respawn-pane -k -t "$pane" "$cmd" 2>/dev/null && return 0 || return 1
}

# ---------- main scan ----------
repaired=0
state_file="$MESH/.window-repair.state"
new_state=""

while IFS= read -r win; do
  [ -z "$win" ] && continue
  np="$(tmux list-panes -t "${SESS}:${win}" -F '#{pane_index}' 2>/dev/null | wc -l)"
  [ "$np" -lt 2 ] && continue  # single-pane window, skip (shell, derived single-pane)

  # pane 0 = top (data), pane N = bottom (mind)
  top_pane="${SESS}:${win}.0"
  # find bottom pane index
  bot_idx="$(tmux list-panes -t "${SESS}:${win}" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  bot_pane="${SESS}:${win}${bot_idx:+.$bot_idx}"

  top_ok="ok"; mind_ok="ok"
  pane_broken "$top_pane" data && top_ok="broken"
  pane_broken "$bot_pane" mind && mind_ok="broken"

  new_state="${new_state}${win}:d=$top_ok,m=$mind_ok"$'\n'

  if [ "$top_ok" = broken ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) repair[$win]: top data pane broken → respawning (mesh-dash $(dash_role "$win"))"
    if respawn_data "$top_pane" "$win"; then
      repaired=$(( repaired + 1 ))
    fi
  fi

  if [ "$mind_ok" = broken ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) repair[$win]: bottom mind pane broken (bare shell, mind dead)"
    if command -v mesh-channel-keepalive >/dev/null 2>&1; then
      out="$(mesh-channel-keepalive "$win" 2>&1)" || true
      if echo "$out" | grep -q 'relaunch'; then
        echo "$(date -u +%Y-%m-%dT%H:%MZ) repair[$win]: keepalive relaunched mind"
        repaired=$(( repaired + 1 ))
      fi
    fi
  fi
done < <(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null)

if $EDGE; then
  prev="$(cat "$state_file" 2>/dev/null)"
  if [ "$new_state" != "$prev" ]; then
    echo "$new_state" > "$state_file"
    [ "$repaired" -gt 0 ] && msg="[window-repair] repaired $repaired broken pane(s)" || msg="[window-repair] all windows healthy"
    MESH_WHO="repair@$SESS" mesh-chat "$msg" >/dev/null 2>&1 || true
  fi
else
  [ "$repaired" -gt 0 ] && \
    MESH_WHO="repair@$SESS" mesh-chat "[window-repair] repaired $repaired broken pane(s)" >/dev/null 2>&1 || true
fi

exit 0
