#!/usr/bin/env bash
# mesh-embed — LOCAL semantic-embedding primitive (text → vector) on this node's ollama/GPU.
#   Closes the find discover→health verified 2026-07-18: mesh-home had NO embed organ, so ALL
#   mesh dedup/recall (board [taking] dedup, mesh-ideate novelty, MEMORY.md recall,
#   review-similarity) is keyword-only/lexical — a paraphrase reads as unrelated. This is the
#   organ those consumers OPT INTO for semantic similarity; until they do, nothing changes.
#
#   mesh-embed "text"              → the embedding vector as a JSON array (one line)
#   mesh-embed --cos "a" "b"       → cosine similarity of two texts (the useful primitive: 1=same)
#   mesh-embed --model <m> ...     → force an embed model (else MESH_EMBED_MODEL, else auto-pick)
#   mesh-embed --which             → print the embed model that would be used (or UNAVAILABLE)
#   mesh-embed --test
#
# HONEST (the mesh no-faked-all-clear rule): if ollama is down OR no embed model is pulled, we
# exit 2 (UNAVAILABLE) — NEVER a zero-vector or a faked 0.0/1.0 similarity. A zero-vector would
# read to every consumer as "orthogonal to everything" = a silent all-different, worse than the
# keyword fallback it replaces. Callers gate on exit 2 → keep their existing lexical path.
#
# WHY exit 2, not a fallback here: the embedding must be REAL to be worth anything. A fabricated
# vector poisons a dedup index invisibly (the classic silent-fallback: cmd || echo <default>).
#
# orphan-ok: on-demand semantic primitive, consumed by dedup/recall/novelty callers — not a
#   scheduled reflex (parallel to mesh-relay). No cron; invoked when a consumer wants similarity.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
OLLAMA_URL="${OLLAMA_HOST:-http://localhost:11434}"
# embed-model families ollama serves in pooling (embedding) mode out of the box.
EMBED_FAMILIES='all-minilm nomic-embed-text bge-m3 bge-large mxbai-embed-large snowflake-arctic-embed'

# pick the embed model: explicit --model > MESH_EMBED_MODEL > first pulled embed-family model.
pick_model(){
  [ -n "${_MODEL:-}" ] && { printf '%s' "$_MODEL"; return 0; }
  [ -n "${MESH_EMBED_MODEL:-}" ] && { printf '%s' "$MESH_EMBED_MODEL"; return 0; }
  local pulled fam
  pulled="$(ollama list 2>/dev/null | awk 'NR>1{print $1}')" || return 1
  for fam in $EMBED_FAMILIES; do
    printf '%s\n' "$pulled" | grep -qiE "^${fam}(:|$)" && {
      printf '%s\n' "$pulled" | grep -iE "^${fam}(:|$)" | head -1 | tr -d '\r'; return 0; }
  done
  return 1   # no embed model pulled
}

ollama_up(){ curl -s -m 3 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; }

# raw embed: text -> JSON array string on stdout; rc 2 if unavailable. Uses ollama /api/embed
# (pooling). The response shape is {"embeddings":[[...]]} for a single string input.
embed_vec(){ # <model> <text>
  local m="$1" t="$2" resp
  resp="$(curl -s -m 30 "$OLLAMA_URL/api/embed" \
        -H 'Content-Type: application/json' \
        --data "$(printf '%s' "$t" | python3 -c 'import json,sys; print(json.dumps({"model": sys.argv[1], "input": sys.stdin.read()}))' "$m")" 2>/dev/null)" || return 2
  # extract embeddings[0]; fail (rc2) on any error/empty/degenerate (all-zero) vector — honest.
  printf '%s' "$resp" | python3 -c '
import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(2)
if "error" in d: sys.exit(2)
e=d.get("embeddings") or []
if not e or not e[0]: sys.exit(2)
v=e[0]
if not any(abs(x)>0 for x in v): sys.exit(2)   # all-zero = degenerate, refuse
print(json.dumps(v))
' || return 2
}

cosine(){ # <jsonvec-a> <jsonvec-b> -> float on stdout
  python3 -c '
import json,sys,math
a=json.loads(sys.argv[1]); b=json.loads(sys.argv[2])
if len(a)!=len(b) or not a:
    print("ERR"); sys.exit(2)
dot=sum(x*y for x,y in zip(a,b))
na=math.sqrt(sum(x*x for x in a)); nb=math.sqrt(sum(y*y for y in b))
if na==0 or nb==0: print("ERR"); sys.exit(2)
print("%.4f" % (dot/(na*nb)))
' "$1" "$2"
}

# ---- arg parse ----
_MODEL=""
if [ "${1:-}" = --model ]; then _MODEL="$2"; shift 2; fi

case "${1:-}" in
  --which)
    ollama_up || { echo "UNAVAILABLE (ollama down at $OLLAMA_URL)"; exit 2; }
    m="$(pick_model)" || { echo "UNAVAILABLE (no embed model pulled — try: ollama pull all-minilm)"; exit 2; }
    echo "$m"; exit 0 ;;

  --test)
    command -v curl    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
    command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
    # pure-python cosine must work with no numpy (system py3 has none) — assert the math first,
    # offline, so a math regression fails RED even on a node with no model.
    _c="$(cosine '[1,0,0]' '[1,0,0]')"; [ "$_c" = "1.0000" ] || { echo "smoke-test: FAIL (cosine identity=$_c, want 1.0000)"; exit 1; }
    _c="$(cosine '[1,0,0]' '[0,1,0]')"; [ "$_c" = "0.0000" ] || { echo "smoke-test: FAIL (cosine orthogonal=$_c, want 0.0000)"; exit 1; }
    # HONEST n/a: no ollama or no embed model → exit 2 (like mesh-mag on an unreachable organ),
    # so mesh-land treats it as pass without a model, but the REAL read is required where present.
    ollama_up || { echo "smoke-test: n/a (ollama down — embed organ absent here)"; exit 2; }
    m="$(pick_model)" || { echo "smoke-test: n/a (no embed model pulled — ollama pull all-minilm)"; exit 2; }
    # THE DISCRIMINATE GATE (health flagged this UNVERIFIED until a model lands): a real embedding
    # must place a PARAPHRASE nearer than an UNRELATED sentence. Non-empty is not correct — assert
    # cos(paraphrase) STRICTLY exceeds cos(unrelated), the property every consumer relies on.
    va="$(embed_vec "$m" "the cat sat on the warm windowsill")"    || { echo "smoke-test: FAIL (embed read failed for $m)"; exit 1; }
    vp="$(embed_vec "$m" "a feline rested on the sunny window ledge")" || { echo "smoke-test: FAIL (embed read failed, paraphrase)"; exit 1; }
    vu="$(embed_vec "$m" "quarterly tax filings are due next Tuesday")"  || { echo "smoke-test: FAIL (embed read failed, unrelated)"; exit 1; }
    cp="$(cosine "$va" "$vp")"; cu="$(cosine "$va" "$vu")"
    python3 -c 'import sys; sys.exit(0 if float(sys.argv[1])>float(sys.argv[2]) else 1)' "$cp" "$cu" \
      || { echo "smoke-test: FAIL (model=$m does NOT discriminate: cos(paraphrase)=$cp !> cos(unrelated)=$cu)"; exit 1; }
    echo "smoke-test: ok (model=$m discriminates: paraphrase=$cp > unrelated=$cu)"; exit 0 ;;

  --cos)
    a="${2:?usage: mesh-embed --cos \"text a\" \"text b\"}"; b="${3:?need second text}"
    ollama_up || { echo "mesh-embed: UNAVAILABLE (ollama down)" >&2; exit 2; }
    m="$(pick_model)" || { echo "mesh-embed: UNAVAILABLE (no embed model pulled)" >&2; exit 2; }
    va="$(embed_vec "$m" "$a")" || { echo "mesh-embed: UNAVAILABLE (embed read failed)" >&2; exit 2; }
    vb="$(embed_vec "$m" "$b")" || { echo "mesh-embed: UNAVAILABLE (embed read failed)" >&2; exit 2; }
    cosine "$va" "$vb"; exit 0 ;;

  ""|-h|--help)
    echo "usage: mesh-embed \"text\" | --cos \"a\" \"b\" | --which | --model <m> ... | --test" ;;

  *)
    ollama_up || { echo "mesh-embed: UNAVAILABLE (ollama down)" >&2; exit 2; }
    m="$(pick_model)" || { echo "mesh-embed: UNAVAILABLE (no embed model pulled — ollama pull all-minilm)" >&2; exit 2; }
    embed_vec "$m" "$1" || { echo "mesh-embed: UNAVAILABLE (embed read failed)" >&2; exit 2; } ;;
esac
