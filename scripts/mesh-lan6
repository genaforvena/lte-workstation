#!/usr/bin/env bash
# reflex-cadence: */9 * * * *
# mesh-lan6 — IPv6 neighbor-discovery LAN vantage: who is on the link that IPv4 cannot see.
#
# WHY THIS IS A NEW, distinct real-world sense (not in the existing perception set):
#   Every LAN-presence sense so far is IPv4-eyed — mesh-lan-newdevice filters `ip neigh` to the
#   IPv4 subnet, mesh-presence is BLE, mesh-arrivals/mesh-find ride those. But a dozing Android
#   ignores IPv4 ping/ARP while its stack still answers IPv6 ND — proven live 2026-07-06 17:47Z:
#   ds saw the operator's phone ONLY as an fe80 EUI-64 neighbor entry (IPv4 dead, sshd dead), and
#   IdeaPad was blind (zero genome scripts read `ip -6 neigh`). The IPv6 neighbor table is a real,
#   separate RF-adjacent signal surface: SLAAC/ND chatter exposes devices that are IPv4-silent.
#   Active stimulus: ONE multicast all-nodes ping (ff02::1%iface) solicits every IPv6 host on the
#   link — the ND equivalent of a 254-host ARP sweep, 2 packets instead of 762 (proven live: +7
#   duplicate replies, 5 distinct MACs incl. a randomized-MAC personal device the ARP table lacked).
#
# Honest contract:
#   - no LAN iface / iface has no fe80 (IPv6 off) / ping6 unusable -> exit 2, never a fake reading
#   - 0 neighbors after a real probe on a live IPv6 iface = a REAL reading (client isolation /
#     lonely link), emitted as LONELY, exit 0 — absence measured is not absence of measurement
#   - change-gated STATE (sorted MAC set) + mesh-state-touch every successful run: mtime = ran-live,
#     content = the device-set actually changed (so diff-consumers wake on real churn only)
#
# Vocab (contract — consumers grep these tokens): [lan6] · personal(LA) · LONELY · NO-IPV6
#
#   mesh-lan6          one-line reading (probe + table read)
#   mesh-lan6 --json   machine-readable
#   mesh-lan6 --test   smoke test (parse/classify fixtures + LIVE read gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.lan6.state"
mkdir -p "$HOME/.mesh"

# locally-administered bit: second hex digit of the first octet in {2,6,a,e} = randomized MAC
# (a personal device doing MAC randomization), universal = infrastructure/older gear.
la_mac() { case "$1" in ?[26aAeE]:*) return 0;; *) return 1;; esac; }

# parse_neigh: `ip -6 neigh` lines on stdin -> "mac|router|state" (lowercased, lladdr lines only,
# deduped by MAC — one device advertises several fe80/global addresses; FAILED entries dropped).
parse_neigh() {
  awk '{
    mac=""; router=0; state="?"
    for (i=1; i<=NF; i++) {
      if ($i=="lladdr") mac=tolower($(i+1))
      if ($i=="router") router=1
    }
    st=$NF; if (st ~ /^(REACHABLE|STALE|DELAY|PROBE|PERMANENT)$/) state=st
    if (mac != "" && !seen[mac]++) print mac "|" router "|" state
  }'
}

lan_iface() {
  [ -n "${MESH_LAN6_IF:-}" ] && { printf '%s\n' "$MESH_LAN6_IF"; return 0; }
  ip -4 route show default 2>/dev/null | grep -v tailscale | awk '{for(i=1;i<NF;i++) if($i=="dev") print $(i+1)}' | head -1
}

if [ "${1:-}" = --test ]; then
  fix=$'fe80::9683:c4ff:fe68:766 lladdr 94:83:c4:68:07:66 router REACHABLE\nfe80::1813:dd2a:8b70:778c lladdr 7C:C3:A1:A5:20:D7 DELAY\nfe80::a00:27ff:fe9c:3c1e lladdr 7c:c3:a1:a5:20:d7 STALE\nfe80::dead lladdr 7e:c7:c7:86:23:03 DELAY\nfe80::beef  FAILED'
  out="$(printf '%s\n' "$fix" | parse_neigh)"
  f=0
  # grep -c . not `printf '%s\n' | wc -l`: an empty $out must count 0, not 1 (doctor's wc-l lint)
  [ "$(printf '%s' "$out" | grep -c .)" = 3 ] || { echo "  FAIL: dedup — 5 lines (2 same MAC, 1 FAILED) must yield 3 devices, got: $out"; f=1; }
  printf '%s\n' "$out" | grep -q '^94:83:c4:68:07:66|1|REACHABLE$' || { echo "  FAIL: router line must parse mac|1|REACHABLE"; f=1; }
  printf '%s\n' "$out" | grep -q '^7c:c3:a1:a5:20:d7|0|DELAY$'     || { echo "  FAIL: mixed-case MAC must lowercase + keep FIRST state"; f=1; }
  printf '%s\n' "$out" | grep -q 'fe80::beef'                        && { echo "  FAIL: a FAILED entry (no lladdr) must be dropped"; f=1; }
  la_mac 7e:c7:c7:86:23:03 || { echo "  FAIL: LA-MAC: 7e:... must read locally-administered"; f=1; }
  la_mac ca:dc:f3:77:04:53 || { echo "  FAIL: LA-MAC: ca:... (the phone) must read locally-administered"; f=1; }
  la_mac 94:83:c4:68:07:66 && { echo "  FAIL: LA-MAC: universal router MAC must NOT read LA"; f=1; }
  # LIVE gate (verification principle: a reachable iface whose read yields nothing is a hollow
  # sense): the real probe on this node must produce >=1 neighbor MAC. No IPv6 iface -> honest n/a.
  ifc="$(lan_iface)"
  if [ -z "$ifc" ] || ! ip -6 addr show dev "$ifc" 2>/dev/null | grep -q 'inet6 fe80'; then
    echo "smoke-test: n/a (no IPv6-capable LAN iface — cannot assert a live read)"; exit 2
  fi
  ping -6 -c 2 -W 2 "ff02::1%$ifc" >/dev/null 2>&1 || true
  live_n="$(ip -6 neigh show dev "$ifc" 2>/dev/null | parse_neigh | wc -l)"
  [ "$live_n" -ge 1 ] || { echo "smoke-test: FAIL (live probe on $ifc yielded 0 neighbors — hollow read)"; f=1; }
  [ "$f" != 0 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (7 parse/classify fixtures + live read: $live_n neighbor(s) on $ifc)"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

IFC="$(lan_iface)"
[ -n "$IFC" ] || { echo "[lan6] NO-IPV6 — no LAN interface found"; exit 2; }
ip -6 addr show dev "$IFC" 2>/dev/null | grep -q 'inet6 fe80' \
  || { echo "[lan6] NO-IPV6 — $IFC has no link-local address (IPv6 off)"; exit 2; }

# active solicit: all-nodes multicast; duplicates are the whole point, rc is irrelevant as long as
# the socket worked (a hard send failure with an fe80 present = broken stack -> honest n/a below).
if ! ping -6 -c 2 -W 2 "ff02::1%$IFC" >/dev/null 2>&1; then
  ping -6 -c 1 -W 1 "ff02::1%$IFC" >/dev/null 2>&1 || true
fi
neigh="$(ip -6 neigh show dev "$IFC" 2>/dev/null | parse_neigh)" || neigh=""

n=0; routers=0; la=0; reach=0
macs=""
if [ -n "$neigh" ]; then
  n="$(printf '%s' "$neigh" | grep -c .)"
  routers="$(printf '%s' "$neigh" | awk -F'|' '$2==1' | grep -c .)"
  reach="$(printf '%s' "$neigh" | grep -c '|REACHABLE$' || true)"
  while IFS='|' read -r m _ _; do la_mac "$m" && la=$((la+1)); done <<< "$neigh"
  macs="$(printf '%s\n' "$neigh" | cut -d'|' -f1 | sort)"
fi
infra=$(( n - la ))

# change-gated STATE: content = the sorted device set (diff-consumers wake on real churn);
# mesh-state-touch decouples ran-live (mtime) from value-changed (content) — liveness convention.
newstate="$(printf '%s\n%s' "$n" "$macs")"
[ "$newstate" = "$(cat "$STATE" 2>/dev/null)" ] || printf '%s\n' "$newstate" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"

if [ "$MODE" = json ]; then
  printf '{"ts":"%s","iface":"%s","devices":%s,"routers":%s,"personal_la":%s,"infra":%s,"reachable":%s}\n' \
    "$TS" "$IFC" "$n" "$routers" "$la" "$infra" "$reach"
else
  if [ "$n" = 0 ]; then
    echo "[lan6] LONELY — 0 IPv6-ND neighbors on $IFC after multicast solicit (client isolation?)"
  else
    echo "[lan6] $n device(s) on $IFC via IPv6-ND — router=$routers personal(LA)=$la infra=$infra reachable=$reach"
  fi
fi
exit 0
