#!/usr/bin/env bash
# mesh-chat-deliver — the PUSH side of targeted chat delivery (operator 2026-06-21: "таргетированная
# доставка пушей … как в слаке подтегли тебя"). The ONE chat (mesh-chat / ~/.mesh/chat.log) is the
# substrate; `mesh-chat --to <tgt> "msg"` writes a line marked `[@<tgt>]` at the body start. This driver
# delivers each such line to <tgt>'s MIND pane, exactly once-or-more (at-least-once), never mid-turn.
#
# Why a cursor + idle-gate (and why that's NOT the "retry machinery" the operator pruned): a targeted line
# PERSISTS in the chat — it is never dropped. The per-target cursor (~/.mesh/.chat-deliver-<tgt>.cursor =
# count of lines already delivered) simply does not advance until the line actually lands on an IDLE mind.
# A busy mind isn't a special case to retry — the cursor just waits; next pass delivers. Self-tag is
# harmless (a normal delivery). No anti-loop guard needed: the cursor guarantees each line pushes once.
#
# Addressee is validated AT SEND TIME by `mesh-chat --to` (unknown → error, nothing posted), so every
# `[@<tgt>]` line in the log is already a real, intended target — this side just delivers. The marker is
# matched ANCHORED at the body start (after `::  `), per memory board-marker-grep-must-anchor-to-body, so
# prose that merely mentions `[@x]` mid-sentence is not mistaken for an address.
#
#   mesh-chat-deliver               ONE delivery pass over every live target (the cron-safe default + backstop)
#   mesh-chat-deliver --once [tgt]  one pass (all targets, or just <tgt>) — the send-time hook; same as bare
#   mesh-chat-deliver --loop        durable daemon (deliver every MESH_CHAT_DELIVER_INTERVAL s) — opt-in only
#   mesh-chat-deliver --test        smoke
#
# Default is a SINGLE pass, NOT a daemon: `mesh-autowire` wires the BARE command on the reflex-cadence, and a
# bare invocation that looped forever would have cron try to spawn a new daemon every minute (the flock caps
# it to one, but a one-pass default is the honest, footgun-free shape). The minute cron is the at-least-once
# BACKSTOP; instant delivery comes from the send-time `--once <tgt>` hook in `mesh-chat --to`.
#
# reflex-cadence: * * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
S="$(hostname)"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH_DIR/chat.log"
DLOG="$MESH_DIR/chat-deliver.log"   # delivery receipts (the "when it landed" visibility — ack tier)
INTERVAL="${MESH_CHAT_DELIVER_INTERVAL:-20}"
ts(){ date -u +%FT%TZ; }

# live valid targets = single source of truth is mesh-chat --targets (declared ∩ live mind windows).
targets(){ mesh-chat --targets 2>/dev/null; }

# Mind pane = BOTTOM pane (largest pane_top); idle-gate = double-capture (a working TUI redraws). Same
# convention as mesh-tell / mesh-pane-consume so delivery never types into a mind mid-turn.
mind_pane(){ tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}'; }
mind_idle(){ local ch="$1" p a b; p="$(mind_pane "$ch")"
  a="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"; [ -z "$a" ] && return 1
  sleep 2.5; b="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"; [ "$a" = "$b" ]; }

# all targeted lines for <tgt> in the log (anchored marker after the `::  ` body start).
target_lines(){ grep -aE "^[0-9][0-9T:+-]*Z  .*  ::  \[@$1\] " "$LOG" 2>/dev/null; }

deliver_target(){ # <tgt> — push not-yet-delivered targeted lines to the mind (idle-gated, at-least-once)
  local tgt="$1"   # NB: separate stmt — `local tgt=$1 curf=...$tgt...` expands $tgt before it's set (set -u trap)
  local curf="$MESH_DIR/.chat-deliver-$tgt.cursor" all total delivered new payload
  all="$(target_lines "$tgt")"
  total="$(printf '%s\n' "$all" | grep -c .)"
  [ "$total" -eq 0 ] && return 0
  delivered="$(cat "$curf" 2>/dev/null)"; delivered="${delivered:-0}"
  [ "$total" -le "$delivered" ] && return 0
  mind_idle "$tgt" || return 0   # busy — cursor NOT advanced → delivered next pass (at-least-once, not dropped)
  new="$(printf '%s\n' "$all" | sed -n "$((delivered+1)),${total}p")"
  # render each undelivered line as "[sender] text", join with | for a single push.
  payload="$(printf '%s\n' "$new" | sed -E "s/^[0-9T:+-]*Z  (.*)  ::  \[@$tgt\] /[\1] /" | tr '\n' '|')"
  mesh-tell "$tgt" "[chat → you] targeted message(s) addressed to YOU: ${payload} — act on it, or post one terse ack in chat (mesh-chat). Delivered via mesh-chat --to; this is a pushed FACT, not a state read." >/dev/null 2>&1
  echo "$total" > "$curf"
  echo "$(ts) delivered $((total - delivered)) line(s) to $tgt" >> "$DLOG"
}

# ---- test ----
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
  command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat)"; exit 1; }
  # the marker match must be ANCHORED at the body start — a mid-prose [@x] must NOT count as a target line.
  _t="$(mktemp)"; trap 'rm -f "$_t"' EXIT
  printf '%s\n' "2026-06-21T00:00:00Z  a@b  ::  [@minds] real targeted line" >> "$_t"
  printf '%s\n' "2026-06-21T00:00:01Z  a@b  ::  prose that mentions [@minds] mid-sentence" >> "$_t"
  _hits="$(LOG="$_t" bash -c 'grep -aE "^[0-9][0-9T:+-]*Z  .*  ::  \[@minds\] " "'"$_t"'" | wc -l')"
  [ "$_hits" = "1" ] || { echo "smoke-test: FAIL (anchored marker matched $_hits lines, want 1 — mid-prose leaked)"; exit 1; }
  echo "smoke-test: ok (anchored [@tgt] match; idle-gated per-target cursor delivery; busy=wait not drop)"; exit 0
fi

mkdir -p "$MESH_DIR"; touch "$LOG"
tmux has-session -t "$S" 2>/dev/null || { echo "mesh-chat-deliver: no tmux session '$S'" >&2; exit 1; }

# serialize passes (send-time --once + cron --once + loop) so the per-target cursor never double-advances.
exec 9>"$MESH_DIR/.chat-deliver.lock"; flock -w 5 9 || exit 0

one_pass(){ # [tgt...] — deliver to the given targets, or to every live target if none named
  if [ $# -gt 0 ]; then for t in "$@"; do deliver_target "$t" || true; done
  else for t in $(targets); do deliver_target "$t" || true; done; fi
}

case "${1:-}" in
  --loop) shift; while :; do one_pass "$@"; sleep "$INTERVAL"; done ;;   # opt-in daemon (holds the flock)
  --once) shift; one_pass "$@" ;;
  *)      one_pass "$@" ;;                                               # DEFAULT = one cron-safe pass
esac
