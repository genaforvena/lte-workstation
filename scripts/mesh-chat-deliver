#!/usr/bin/env python3
# reflex-cadence: * * * * *
"""Bounded, idempotent push delivery for targeted mesh-chat records."""
from __future__ import annotations
import fcntl, hashlib, json, os, re, socket, subprocess, sys, tempfile, time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh")))
CHAT = Path(os.environ.get("MESH_CHAT_LOG", str(ROOT / "chat.log")))
LEDGER = Path(os.environ.get("MESH_CHAT_DELIVER_LEDGER", str(ROOT / "chat-deliver-ledger.json")))
DLOG = Path(os.environ.get("MESH_CHAT_DELIVER_LOG", str(ROOT / "chat-deliver.log")))
HOST = socket.gethostname()
MAX_ATTEMPTS = int(os.environ.get("MESH_CHAT_DELIVER_MAX_ATTEMPTS", "3"))
MAX_AGE = int(os.environ.get("MESH_CHAT_DELIVER_MAX_AGE", "900"))
INTERVAL = int(os.environ.get("MESH_CHAT_DELIVER_INTERVAL", "20"))
LINE = re.compile(r"^(\S+)  (.*?)  ::  \[@([^]]+)\] (.*)$")
CONTROL = re.compile(r"^\[(?:ack|delivery-failed)\]\s")
ACK = re.compile(r"^\[ack\]\s+ack:([0-9a-f]{16})\b")

def stamp(): return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def epoch(value):
    try: return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError: return time.time()
def message_id(raw): return hashlib.sha256(raw.encode()).hexdigest()[:16]
def run(args, **kwargs): return subprocess.run(args, text=True, check=False, **kwargs)

def targets():
    proc = run(["mesh-chat", "--targets"], capture_output=True)
    return proc.stdout.split() if proc.returncode == 0 else []

def mind_idle(target):
    panes = run(["tmux", "list-panes", "-t", f"{HOST}:{target}", "-F", "#{pane_top} #{pane_index}"], capture_output=True)
    if panes.returncode: return False
    parsed = sorted((int(a), b) for a, b in (x.split() for x in panes.stdout.splitlines()))
    if not parsed: return False
    cmd = ["tmux", "capture-pane", "-t", f"{HOST}:{target}.{parsed[-1][1]}", "-p", "-S", "-6"]
    first = run(cmd, capture_output=True)
    if first.returncode or not first.stdout: return False
    time.sleep(float(os.environ.get("MESH_CHAT_DELIVER_IDLE_DELAY", "2.5")))
    second = run(cmd, capture_output=True)
    return second.returncode == 0 and first.stdout == second.stdout

def load():
    try:
        value = json.loads(LEDGER.read_text())
        return value if isinstance(value, dict) else {"version": 1, "messages": {}}
    except (FileNotFoundError, json.JSONDecodeError): return {"version": 1, "messages": {}}

def save(value):
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".chat-deliver.", dir=LEDGER.parent, text=True)
    try:
        with os.fdopen(fd, "w") as handle: json.dump(value, handle, indent=2, sort_keys=True); handle.write("\n")
        os.replace(name, LEDGER)
    finally:
        try: os.unlink(name)
        except FileNotFoundError: pass

def records():
    data, acks = [], {}
    try: lines = CHAT.read_text(errors="replace").splitlines()
    except FileNotFoundError: return data, acks
    for raw in lines:
        match = LINE.match(raw)
        if not match: continue
        when, sender, target, body = match.groups()
        receipt = ACK.match(body)
        if receipt: acks[receipt.group(1)] = (sender.split("@")[0], target); continue
        if CONTROL.match(body): continue
        data.append({"id": message_id(raw), "when": when, "sender": sender.split("@")[0], "target": target, "body": body})
    return data, acks

def emit_failure(rec):
    text = f"[delivery-failed] msg:{rec['id']} target:{rec['target']} attempts:{MAX_ATTEMPTS} age-limit:{MAX_AGE}s"
    return run(["mesh-chat", "--to", rec["sender"], text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def one_pass(wanted):
    ledger = load(); states = ledger.setdefault("messages", {})
    rows, acks = records(); now_s = time.time(); valid = set(wanted or targets())
    for rec in rows:
        if rec["target"] not in valid: continue
        age = max(0, now_s - epoch(rec["when"]))
        if rec["id"] not in states and age >= MAX_AGE:
            # Deployment bootstrap: old board history predates this ledger. Tombstone it without
            # manufacturing thousands of retroactive failure records; only messages observed
            # inside the live retry window receive the bounded failure edge.
            states[rec["id"]] = {"target": rec["target"], "sender": rec["sender"], "first_seen": rec["when"],
                                 "attempts": 0, "status": "expired-preledger"}
            continue
        state = states.setdefault(rec["id"], {"target": rec["target"], "sender": rec["sender"], "first_seen": rec["when"], "attempts": 0, "status": "pending"})
        if acks.get(rec["id"]) == (rec["target"], rec["sender"]):
            state.update(status="acked", acked_at=stamp()); continue
        if state["status"] in ("acked", "failed", "expired-preledger"): continue
        age = max(0, now_s - epoch(state["first_seen"]))
        if state["attempts"] >= MAX_ATTEMPTS or age >= MAX_AGE:
            if emit_failure(rec):
                state.update(status="failed", failed_at=stamp(), failure_emitted=True)
                DLOG.parent.mkdir(parents=True, exist_ok=True)
                with DLOG.open("a") as out: out.write(f"{stamp()} delivery-failed msg:{rec['id']} target:{rec['target']} attempts:{state['attempts']} age:{int(age)}s\n")
            continue
        if not mind_idle(rec["target"]): continue
        payload = (f"[chat → you] [{rec['sender']}] {rec['body']} msg:{rec['id']} — act on it; "
                   f"receipt: mesh-chat --to {rec['sender']} '[ack] ack:{rec['id']}'. This terminal receipt is never pushed.")
        if run(["mesh-tell", rec["target"], payload], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            state["attempts"] += 1; state["last_attempt"] = stamp(); state["status"] = "awaiting-ack"
            DLOG.parent.mkdir(parents=True, exist_ok=True)
            with DLOG.open("a") as out: out.write(f"{stamp()} delivered msg:{rec['id']} attempt:{state['attempts']} target:{rec['target']}\n")
    save(ledger)

def self_test():
    raw = "2026-06-21T00:00:00Z  vpn@node  ::  [@witness] fact"
    assert message_id(raw) == message_id(raw) and len(message_id(raw)) == 16
    assert LINE.match(raw) and not LINE.match("2026-06-21T00:00:00Z  x :: prose [@witness] fact")
    assert ACK.match("[ack] ack:0123456789abcdef") and CONTROL.match("[delivery-failed] msg:x")
    print("mesh-chat-deliver: smoke-test ok (stable message id, terminal controls, bounded ledger contract)")

def main():
    if sys.argv[1:2] == ["--test"]: self_test(); return
    ROOT.mkdir(parents=True, exist_ok=True); CHAT.touch(); lock = (ROOT / ".chat-deliver.lock").open("w")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError: return
    args = sys.argv[1:]; loop = bool(args and args[0] == "--loop")
    if args and args[0] in ("--once", "--loop"): args = args[1:]
    while True:
        one_pass(args)
        if not loop: break
        time.sleep(INTERVAL)

if __name__ == "__main__": main()
