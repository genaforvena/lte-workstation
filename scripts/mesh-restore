#!/usr/bin/env bash
# mesh-restore — bring this node's standard loops back (idempotent). The WHY and the full
# intended state live in docs/runbook.md (the text); this is the thin hand that re-establishes
# the body. Optional, judgment-laden things (genius-loci, voice) are NOT auto-started here.
#
#   mesh-restore          ensure the standard loops (chat, snapshot) are running
#   mesh-restore --show   open a 'restore' window with the runbook (how-why-how)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # works under cron, @reboot, and non-interactive SSH
S="$(hostname)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
[ "${1:-}" = --test ] && { command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux — can't restore a session)"; exit 1; }; [ -d "$REPO/scripts" ] || { echo "smoke-test: FAIL (no genome at $REPO)"; exit 1; }; echo "smoke-test: ok"; exit 0; }
ensure_win(){ tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$1" || tmux new-window -t "$S" -n "$1" "$2"; }

# CHANNEL builder (operator: top=DATA refreshing, bottom=MIND). Reincarnates each mind as a 2-pane
# channel so a reboot restores the FULL architecture, not just the old loops. Idempotent + append-only:
# missing -> build (top=dash, bottom=mind); legacy single-pane -> add the mind below; already 2-pane ->
# leave it (mesh-channel-keepalive tends it). The mind is wrapped so its pane survives the mind exiting
# (drops to a login shell), keeping the window a 2-pane channel that keepalive can relaunch into.
ensure_channel(){ # $1=win  $2=dash-role  $3=mind-cmd
  local win="$1" role="$2" mind="$3"
  local mw="bash -lc 'cd \$HOME/lte-workstation 2>/dev/null; $mind; exec bash -l'"
  if ! tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$win"; then
    tmux new-window -d -t "$S" -n "$win" "exec $HOME/.local/bin/mesh-dash $role"   # top = DATA
    tmux split-window -v -t "$S:$win" "$mw"                                        # bottom = MIND
    tmux select-layout -t "$S:$win" even-vertical 2>/dev/null || true
  elif ! tmux list-panes -t "$S:$win" -F '#{pane_index}' 2>/dev/null | grep -qx 1; then
    tmux send-keys -t "$S:$win.0" C-u 2>/dev/null; sleep 0.1
    tmux send-keys -t "$S:$win.0" "exec $HOME/.local/bin/mesh-dash $role" C-m      # make the bare pane DATA
    tmux split-window -v -t "$S:$win" "$mw"                                        # add MIND below
    tmux select-layout -t "$S:$win" even-vertical 2>/dev/null || true
  fi
}

tmux has-session -t "$S" 2>/dev/null || tmux new-session -d -s "$S"
KDIR="$HOME/.mesh/knowledge"     # the gossiped living-text tier (NOT git)

case "${1:-}" in
  --show)
    ensure_win restore "less '$KDIR/runbook.md'"
    echo "runbook open in window 'restore' (how-why-how to bring the node back)"; exit 0;;
  --pull)
    peer="${2:?usage: mesh-restore --pull <neighbour-ip>}"; user="${MESH_USER:-$USER}"
    mkdir -p "$KDIR"
    scp -qr -o BatchMode=yes -o ConnectTimeout=8 "$user@$peer:.mesh/knowledge/." "$KDIR/" 2>/dev/null \
      && echo "pulled living knowledge from $peer ($(ls "$KDIR"/*.md 2>/dev/null | wc -l) docs)" \
      || { echo "could not pull knowledge from $peer"; exit 1; }
    exit 0;;
esac

# wire/repair the node's cron reflexes. The DECLARED set (~/.mesh/reflexes.cron) self-heals:
# mesh-reflexes --apply (flock'd, idempotent) re-adds any dropped reflex and NEVER removes a line,
# so a clobber-race drop is back within one restore cycle (*/5). Falls back to the minimal mesh-tick
# seed on a fresh node with no declared set yet (run `mesh-reflexes --snapshot` once its reflexes
# are installed to begin self-healing them).
if command -v mesh-reflexes >/dev/null 2>&1 && [ -r "$HOME/.mesh/reflexes.cron" ]; then
  mesh-reflexes --apply >> "$HOME/.mesh/reflexes.log" 2>&1 || true
else
  grep -q 'mesh-tick' <(crontab -l 2>/dev/null) || \
    (crontab -l 2>/dev/null; echo "*/2 * * * * $HOME/.local/bin/mesh-tick >> $HOME/.mesh/tick.log 2>&1") | crontab -
fi

ensure_win shell    "bash -l"
ensure_win chat     "exec $HOME/.local/bin/mesh-chat --watch"
ensure_win snapshot "exec $HOME/.local/bin/mesh-snapshot --loop 600"
# self-care: the node KNOWS its connectivity and HEALS what it can, on its own (reflexive breathing).
[ -x "$HOME/.local/bin/mesh-selfcare" ] && ensure_win selfcare "exec $HOME/.local/bin/mesh-selfcare --loop 180"
# verifier/planner: only on the node that carries the mission — revive its window across reboots too.
[ -f "$HOME/.mesh/verifier-mission.md" ] && ensure_win verifier \
  "bash -lc 'echo === VERIFIER ===; echo mission: ~/.mesh/verifier-mission.md; echo plan: ~/.mesh/PLAN.md; echo; mesh-verify 2>/dev/null; echo; echo \"smart pass: invoke a claude here deliberately\"; exec bash'"
# MIND channels — top=data dash, bottom=mind. The feed reflexes (mesh-tick/mesh-feed/mesh-channel)
# drive the BOTTOM pane. claude=plan/steward, opencode=check, gemini=verify, codex=worker. tg + chat
# are file-sourced channels built by their own crons (mesh-channel-tg / mesh-channel chat).
ensure_channel claude   steward "claude"
ensure_channel opencode check   "opencode"
# verify role: window named 'gemini' (the tick/feed crons target that name) but runs OPENCODE — the
# gemini binary here authenticates via Google browser OAuth (no API key), so it hits a login wall on
# every reboot = not reincarnation-survivable. opencode is keyless + reliable, so it's the verify mind.
ensure_channel gemini   verify  "opencode"
command -v codex >/dev/null 2>&1 && \
  ensure_channel codex  codex   "codex --dangerously-bypass-approvals-and-sandbox"   # operator-authorized full bypass

echo "standard loops ensured: shell relay, chat, snapshot, self-care$([ -f "$HOME/.mesh/verifier-mission.md" ] && echo ', verifier'); mind channels: claude/opencode/gemini$(command -v codex >/dev/null 2>&1 && echo /codex)."
echo "optional (judgment — start deliberately, see docs/runbook.md):"
echo "  genius-loci:  GL_WEBCAM=/dev/video0 tmux new-window -n genius-loci 'genius-loci'"
echo "  voice agent:  mesh-voice"
echo "  heartbeat:    /loop 3h heartbeat and tmux quick check"
