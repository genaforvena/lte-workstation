#!/usr/bin/env bash
# mesh-restore — bring this node's standard loops back (idempotent). The WHY and the full
# intended state live in docs/runbook.md (the text); this is the thin hand that re-establishes
# the body. Optional, judgment-laden things (genius-loci, voice) are NOT auto-started here.
#
#   mesh-restore          ensure the standard loops (chat, snapshot) are running
#   mesh-restore --show   open a 'restore' window with the runbook (how-why-how)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # works under cron, @reboot, and non-interactive SSH
# nvm-installed minds (codex lives in ~/.nvm/.../bin) are invisible to cron's bare PATH — without
# this the codex channel silently never restores after reboot ('command -v codex' fails under cron)
NVM_BIN=$(ls -d "$HOME/.nvm/versions/node/"*/bin 2>/dev/null | sort -V | tail -1)
[ -n "$NVM_BIN" ] && export PATH="$NVM_BIN:$PATH"
S="$(hostname)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
# node-local restore config (gitignored, per-node) — operational opt-ins that must NOT live in the
# plantable genome. e.g. MESH_CODEX_CMD lets a node run codex with autonomous flags; the genome default
# stays SAFE (plain `codex`), the node opts in locally. Keeps dangerous flags out of fleet-wide auto-heal.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

# NATIVE CLAUDE, ALWAYS (operator hard rule 2026-06-19): a mind must launch the native claude
# binary, never an npm/node wrapper. The official native installer drops an ELF at
# ~/.local/bin/claude (or ~/.claude/local/claude); an npm install is a node script. So the launch
# DEFAULT resolves the native ELF by checking the 0x7f 'E' 'L' 'F' magic — bare PATH `claude` (which
# could be an npm shim earlier on PATH) is only the last resort if no native binary is present. A
# node may still override with MESH_CLAUDE_CMD (restore.env), which wins.
CLAUDE_BIN=claude
for _c in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
  [ -x "$_c" ] || continue
  [ "$(od -An -tx1 -N4 "$_c" 2>/dev/null | tr -d ' ')" = 7f454c46 ] || continue
  CLAUDE_BIN="$_c"; break
done

# LEAN-MCP (chat-review/channel-minds-lean-mcp 2026-07-06, corrected by health same day): every claude
# channel mind inherits the OPERATOR's user-level ~/.claude/settings.json enabledPlugins — so a
# monitor-only channel (senses/health/chat/...) that never touches a browser spawns the SAME heavy
# per-plugin MCP servers as a dev channel. Live count on this node: context7×33 chrome-devtools×27
# zai×33 playwright×33 (~3.4G RAM, ~115 procs total, health 2026-07-06) — the standing tax behind 3 OOM
# storms in 24h.
# VERIFIED MECHANISM (empirical, this session — the two levers discover originally proposed do NOT
# work): --strict-mcp-config + --mcp-config do not gate plugin-provided MCP servers at all — `claude
# mcp list` output was IDENTICAL with/without them (tested live). A --settings override that simply
# OMITS a plugin (or lists only a trimmed positive subset) ALSO does not disable it — still inherited
# from the base ~/.claude/settings.json, same processes came up. The ONLY lever that actually works:
# explicit `"<plugin>": false` in the --settings override, for EACH plugin to strip — verified live:
# an all-false override made context7/playwright/chrome-devtools-mcp/github/terraform/desktop-commander
# vanish from `claude mcp list`, while the non-plugin mcpServers (zai-mcp-server/web-search-prime/
# web-reader/zread, sourced from ~/.claude.json not ~/.claude/settings.json) were untouched, as expected.
LEAN_MCP_FILE="$HOME/.mesh/claude-lean-settings.json"
LEAN_MCP_PLUGINS="context7@claude-plugins-official playwright@claude-plugins-official chrome-devtools-mcp@claude-plugins-official github@claude-plugins-official terraform@claude-plugins-official desktop-commander@claude-plugins-official"
lean_mcp_settings_file(){ # (re)writes $LEAN_MCP_FILE (idempotent — self-heals if hand-edited/removed), prints its path
  local body="" p
  for p in $LEAN_MCP_PLUGINS; do body="${body}${body:+,\n    }\"$p\": false"; done
  printf '{\n  "enabledPlugins": {\n    %b\n  }\n}\n' "$body" > "$LEAN_MCP_FILE" 2>/dev/null
  printf '%s' "$LEAN_MCP_FILE"
}
# OPT-IN, DEFAULT OFF (MESH_MCP_LEAN=1 in restore.env — same node-local-lever pattern as MESH_CODEX_CMD/
# MESH_SEED_CLAUDE_TRUST above): health's own caveat on the verified find was "verify each channel's
# actual MCP usage from session jsonl before defaulting it lean" — that per-channel audit has NOT been
# done yet, so this ships as an instrument to turn on deliberately, not a silent default-on behavior
# change. mcp_full_for_win is the per-channel escape hatch (MESH_MCP_FULL_<CHAN>=1) for a channel later
# found to need context7/playwright/chrome-devtools for real work.
mcp_full_for_win(){ # $1=win -> true (0) if this channel opts OUT of lean (keeps the full plugin set)
  case "$1" in
    minds)    [ "${MESH_MCP_FULL_MINDS:-0}" = 1 ];;
    genome)   [ "${MESH_MCP_FULL_GENOME:-0}" = 1 ];;
    tg)       [ "${MESH_MCP_FULL_TG:-0}" = 1 ];;
    senses)   [ "${MESH_MCP_FULL_SENSES:-0}" = 1 ];;
    health)   [ "${MESH_MCP_FULL_HEALTH:-0}" = 1 ];;
    chat)     [ "${MESH_MCP_FULL_CHAT:-0}" = 1 ];;
    room)     [ "${MESH_MCP_FULL_ROOM:-0}" = 1 ];;
    pub)      [ "${MESH_MCP_FULL_PUB:-0}" = 1 ];;
    discover) [ "${MESH_MCP_FULL_DISCOVER:-0}" = 1 ];;
    sound)    [ "${MESH_MCP_FULL_SOUND:-0}" = 1 ];;
    models)   [ "${MESH_MCP_FULL_MODELS:-0}" = 1 ];;
    # 2 = NO ARM FOR THIS CHANNEL, distinct from 1 = "has an arm, opted in to lean".
    # This used to `return 1`, which made the :147 gate VACUOUS: a missing arm returned the
    # same code as a present one, so the loop's own "falsify: drop a case arm" invitation
    # did not hold — dropping the models arm left smoke-test GREEN (verified 2026-07-15).
    # The 34th self-certifying gate on this node. Callers only ever test truthiness
    # (:384 `! mcp_full_for_win "$win"`), so 2 behaves exactly as 1 did there.
    *)        return 2 ;;
  esac
}

# Pre-seed claude's workspace TRUST so a FRESH mind node doesn't gate every mind on the one-time
# "Do you trust the files in this folder?" prompt (phaedra, 2026-06-15: all 5 minds stuck on it →
# a peer can't cross-press it = permission-laundering, so it stranded the whole node's onboarding).
#
# OPT-IN, DEFAULT-OFF — pre-accepting a trust gate is a permission-BYPASS, so (like the codex bypass
# flags below) it must be a node-local decision in ~/.mesh/restore.env, NEVER a genome default that
# silently disarms the folder-trust guardrail fleet-wide. The node's OWNER sets MESH_SEED_CLAUDE_TRUST=1
# to declare "I trust my own genome folder on this node + I run minds in --permission-mode auto anyway".
# With it unset, mesh-restore touches no config and the gate behaves normally (operator answers it once).
# When enabled: idempotent (merge, never clobber creds/other projects), best-effort (never fails
# restore), re-seeded each run so a mind's config write-back can't strand it; gated minds unblock on
# their next channel-keepalive relaunch (the new process reads the seeded trust → no prompt).
seed_claude_trust(){
  [ "${MESH_SEED_CLAUDE_TRUST:-0}" = 1 ] || return 0     # node-local opt-in only (restore.env)
  command -v claude >/dev/null 2>&1 || return 0          # only on nodes that run claude minds
  command -v python3 >/dev/null 2>&1 || return 0          # safe JSON merge needs python3
  local cj="$HOME/.claude.json"
  MESH_TRUST_REPO="$REPO" MESH_TRUST_HOME="$HOME/lte-workstation" python3 - "$cj" <<'PY' 2>/dev/null || true
import json,os,sys,tempfile
cj=sys.argv[1]
paths={p for p in (os.environ.get("MESH_TRUST_REPO"),os.environ.get("MESH_TRUST_HOME")) if p}
try:
    d=json.load(open(cj)) if os.path.exists(cj) and os.path.getsize(cj) else {}
except Exception:
    sys.exit(0)            # unparseable (e.g. mid-write by a running claude) → don't risk clobbering it
changed=False
if not d.get("hasCompletedOnboarding"): d["hasCompletedOnboarding"]=True; changed=True
proj=d.setdefault("projects",{})
for p in paths:
    e=proj.setdefault(p,{})
    if not e.get("hasTrustDialogAccepted"): e["hasTrustDialogAccepted"]=True; changed=True
if changed:
    fd,tmp=tempfile.mkstemp(dir=os.path.dirname(cj) or ".",prefix=".claude.json.")
    with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2)
    os.replace(tmp,cj)              # atomic — a concurrent reader never sees a half-written file
PY
}
seed_claude_trust

[ "${1:-}" = --test ] && { fail=0
  command -v tmux >/dev/null 2>&1 || { echo "  FAIL: no tmux — can't restore a session"; fail=1; }
  [ -d "$REPO/scripts" ] || { echo "  FAIL: no genome at $REPO"; fail=1; }
  [ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || [ ! -f "$HOME/.mesh/restore.env" ] || { echo "  FAIL: restore.env unparseable"; fail=1; }
  command -v mesh-chat >/dev/null 2>&1 || { echo "  FAIL: no mesh-chat"; fail=1; }
  command -v mesh-heartbeat >/dev/null 2>&1 || { echo "  FAIL: no mesh-heartbeat"; fail=1; }
  command -v mesh-reflexes >/dev/null 2>&1 || { echo "  FAIL: no mesh-reflexes"; fail=1; }
  tmux has-session -t "$S" 2>/dev/null || { echo "  FAIL: tmux session '$S' missing — run mesh-restore (no args) to create it"; fail=1; }
  bash -n "$0" >/dev/null 2>&1 || { echo "  FAIL: bash syntax error in $0"; fail=1; }
  grep -q 'mind-spawn-audit.log' "$0" || { echo "  FAIL: ensure_channel's mw template lost the spawn-audit log line"; fail=1; }
  # LEAN-MCP (chat-review/channel-minds-lean-mcp): the settings file must carry EXPLICIT false entries —
  # a positive/trimmed allowlist or a bare omission does NOT disable an inherited plugin (verified live
  # this session: --strict-mcp-config/--mcp-config and an omission-based --settings override both left
  # the identical plugin MCP servers running under `claude mcp list`). Falsify: change the body back to
  # a positive list and this still writes valid JSON but is a functional no-op for the real lever.
  _lf="$(lean_mcp_settings_file)"
  [ -s "$_lf" ] || { echo "  FAIL: lean_mcp_settings_file wrote nothing"; fail=1; }
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
p = d['enabledPlugins']
assert p.get('context7@claude-plugins-official') is False, 'context7 not explicit-false'
assert p.get('playwright@claude-plugins-official') is False, 'playwright not explicit-false'
assert p.get('chrome-devtools-mcp@claude-plugins-official') is False, 'chrome-devtools-mcp not explicit-false'
" "$_lf" 2>/tmp/.lean-mcp-test-err || { echo "  FAIL: lean-mcp settings file not valid/explicit-false ($(cat /tmp/.lean-mcp-test-err 2>/dev/null))"; fail=1; }
  fi
  # per-channel escape hatch must exist for every manifest channel (falsify: drop a case arm)
  for _w in minds genome tg senses health chat room pub discover sound models; do
    mcp_full_for_win "$_w" >/dev/null 2>&1
    case "$?" in 0|1) :;; *) echo "  FAIL: mcp_full_for_win has no case arm for channel '$_w'"; fail=1;; esac
  done
  # default (MESH_MCP_LEAN unset) must NOT opt any channel out unexpectedly — a stray '=1' default would
  # silently change the plugin surface for every claude mind fleet-wide the next time restore/keepalive runs
  grep -qE '^\s*if \[ "\$mtype" = claude \] && \[ "\$\{MESH_MCP_LEAN:-0\}" = 1 \]' "$0" \
    || { echo "  FAIL: lean-mcp gate not wired into ensure_uniform_channel (or defaults on)"; fail=1; }
  # NB: does not exit here — ensure_channel is defined further down, and its own --test fixtures
  # (chat-review/restore-chat-commons-collision-repair) run after that definition, sharing this
  # same $fail accumulator. This block just bails out early on an already-failed prior assertion.
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
}
ensure_win(){ tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$1" || tmux new-window -t "$S" -n "$1" "$2"; }

# CHANNEL builder (operator: top=DATA refreshing, bottom=MIND). Reincarnates each mind as a 2-pane
# channel so a reboot restores the FULL architecture, not just the old loops. Idempotent + append-only:
# missing -> build (top=dash, bottom=mind); legacy single-pane -> add the mind below; already 2-pane ->
# leave it (mesh-channel-keepalive tends it). The mind is wrapped so its pane survives the mind exiting
# (drops to a login shell), keeping the window a 2-pane channel that keepalive can relaunch into.
ensure_channel(){ # $1=win  $2=dash-role  $3=mind-cmd
  local win="$1" role="$2" mind="$3"
  # Antigravity (`agy`) needs the node-local scoped VPN egress wrapper for Gemini. Operators may set
  # a lane command to bare `agy` or an absolute agy path in restore.env; normalize those through
  # mesh-agy so restored minds keep public model traffic on the Canada SOCKS tunnel while LAN/mesh
  # traffic stays direct.
  case "$mind" in
    agy|agy\ *) mind="mesh-agy${mind#agy}" ;;
    "$HOME/.local/bin/agy"|"$HOME/.local/bin/agy"\ *) mind="mesh-agy${mind#"$HOME/.local/bin/agy"}" ;;
  esac
  # PATH-robust mind launch: a bare `bash -lc` login shell finds claude/gemini but NOT opencode
  # (~/.opencode/bin) or codex (nvm) — they'd die as 'command not found' → bare shell, leaving the
  # health/verify/work channels with dead bottoms (2026-06-13). Prepend the mind-install dirs + source
  # nvm so every declared mind actually launches, regardless of the node's login-shell config.
  # MESH_WHO carries the WINDOW identity onto every board post this mind makes — mesh-chat falls back
  # to $USER@host when unset, so all mind windows collapse into one 'imozerov@host' identity that's
  # unattributable by lane (chat-review/window-attribution). $win is UNESCAPED so the PARENT substitutes
  # the real window name into mw (exactly like $mind); a \$win would expand in the child bash -lc where
  # win is unset → MESH_WHO="@host" (empty lane name, worse than the status quo).
  # SPAWN-AUDIT (chat-review/mind-spawn-audit-log, 2026-07-01): record win+resolved-MESH_WHO+engine at
  # the moment this mind actually starts, so a live MESH_WHO cross-window misattribution (chat-review
  # 06:46:04Z — 5 running procs had the WRONG MESH_WHO baked in, root spawn mechanism unidentified) is
  # traceable to its real spawn event instead of unprovable after the fact. Logged right after MESH_WHO
  # is set, before the mind launches (not literally before 'exec bash -l' — that fires only at mind EXIT,
  # which would record an exit event, not a spawn).
  local mw="bash -lc 'export MESH_WHO=\"$win@\$(hostname)\"; { echo \"\$(date -u +%FT%TZ) win=$win who=\$MESH_WHO engine=$mind site=restore\" >> \"\$HOME/.mesh/.mind-spawn-audit.log\"; } 2>/dev/null; export PATH=\"\$HOME/.opencode/bin:\$HOME/.bun/bin:\$HOME/.local/bin:\$PATH\"; [ -s \"\$HOME/.nvm/nvm.sh\" ] && . \"\$HOME/.nvm/nvm.sh\" >/dev/null 2>&1; cd \$HOME/lte-workstation 2>/dev/null; $mind; exec bash -l'"
  # Known DATA-loop occupants — a pane running one of these is rendering the channel's data
  # surface, never a mind. Shared between the single-pane classifier and the 2-pane hardening
  # below (chat-review/restore-chat-commons-collision-repair): mesh-chat --commons can land its
  # --watch tail in whichever pane was a bare shell when the commons started, which for the
  # 'chat' window is the MIND slot — a data process squats the mind pane forever, no mind ever
  # launches (live: phaedra chat=opencode stuck, channel-keepalive's own conservative
  # never-touch-occupied rule can't fix it either — this is restore-time repair only).
  local data_re='mesh-dash|mesh-chat[[:space:]]+--watch'
  if ! tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$win"; then
    tmux new-window -d -t "$S" -n "$win" "exec $HOME/.local/bin/mesh-dash $role"   # top = DATA
    tmux split-window -v -t "$S:$win" "$mw"                                        # bottom = MIND
    tmux select-layout -t "$S:$win" even-vertical 2>/dev/null || true
  elif ! tmux list-panes -t "$S:$win" -F '#{pane_index}' 2>/dev/null | grep -qx 1; then
    # single-pane window: LOOK at what occupies it before touching it. Typing 'exec mesh-dash'
    # blindly assumed a bare shell — 2026-06-13 near-miss: gemini's lone pane held 'ssh ilya'
    # (a peer's mind behind it); the exec would have run ON THE PEER. Three cases:
    local ppid occ
    ppid=$(tmux display -p -t "$S:$win.0" '#{pane_pid}' 2>/dev/null)
    occ="$(ps -o args= -p "$ppid" 2>/dev/null; pgrep -P "$ppid" 2>/dev/null | xargs -r ps -o args= -p 2>/dev/null)"
    if printf '%s' "$occ" | grep -qE "$data_re"; then
      tmux split-window -v -t "$S:$win" "$mw"                                      # lone DATA (mesh-dash or the chat-commons tail) → add MIND below
    elif [ -z "$(pgrep -P "$ppid" 2>/dev/null)" ] && printf '%s' "$occ" | grep -qE '^-?(ba|z|da)?sh( -l)?[[:space:]]*$'; then
      tmux send-keys -t "$S:$win.0" C-u 2>/dev/null; sleep 0.1
      tmux send-keys -t "$S:$win.0" "exec $HOME/.local/bin/mesh-dash $role" C-m    # bare shell → make it DATA
      tmux split-window -v -t "$S:$win" "$mw"                                      # add MIND below
    else
      # OCCUPIED (a mind TUI, an ssh, any live process): inject NOTHING into it — split the DATA
      # pane ABOVE (-b → new pane idx 0) so the occupant keeps the bottom = mind slot the feeders drive
      tmux split-window -vb -d -t "$S:$win.0" "exec $HOME/.local/bin/mesh-dash $role"
    fi
    tmux select-layout -t "$S:$win" even-vertical 2>/dev/null || true
  else
    # 2-pane window already exists — but pane-1-EXISTS is not the same claim as
    # pane-1-IS-THE-MIND. The commons collision leaves BOTH panes rendering data (pane .0 the
    # normal dash, pane .1 the stray chat-commons tail) with zero minds. Detect it the same way
    # the single-pane classifier does (occupant process, not pane content) and repair: kill the
    # data occupant and respawn that pane with the real mind command in its place — the pane
    # keeps its .1 index, its ROLE just corrects from data back to mind (2-pane invariant held).
    local bpid bocc
    bpid=$(tmux display -p -t "$S:$win.1" '#{pane_pid}' 2>/dev/null)
    bocc="$(ps -o args= -p "$bpid" 2>/dev/null; pgrep -P "$bpid" 2>/dev/null | xargs -r ps -o args= -p 2>/dev/null)"
    if printf '%s' "$bocc" | grep -qE "$data_re"; then
      tmux respawn-pane -k -t "$S:$win.1" "$mw"
    fi
  fi
}

# chat-review/restore-chat-commons-collision-repair (2026-07-07): ensure_channel fixtures, run
# here (after its own definition — the earlier --test block at :118 exits before this point is
# ever reached) against a REAL, ISOLATED tmux session (own name, killed at the end — never the
# node's real hostname-named session). Uses the real `mesh-chat --watch` as the collision
# occupant (read-only tail+grep, safe) for fidelity to the live phaedra symptom, and a harmless
# `sleep <sentinel>` as the mind-cmd so no real opencode/claude ever launches during the test.
[ "${1:-}" = --test ] && {
  fail2=0
  _fail2(){ echo "  FAIL: $1"; fail2=1; }
  _occ(){ # $1=pane target -> occupant ps args (self + children), same shape ensure_channel uses
    local pid; pid=$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null)
    ps -o args= -p "$pid" 2>/dev/null; pgrep -P "$pid" 2>/dev/null | xargs -r ps -o args= -p 2>/dev/null
  }
  # ISOLATION (live incident 2026-07-14 on mesh-home): an own-name fixture is not enough — these
  # sessions used to live on the node's DEFAULT tmux server, where killing the LAST session (fixtures
  # included) exits tmux and takes the node session + every mind pane with it. Per-invocation
  # TMUX_TMPDIR gives the fixtures their own server (same pattern as mesh-quota-react/mesh-mind-compact),
  # and it is inherited by the mind-cmd/mesh-chat processes ensure_channel spawns. Never fall back.
  # `unset TMUX` is LOAD-BEARING: from INSIDE a pane ($TMUX set) tmux takes the socket path FROM $TMUX
  # and ignores TMUX_TMPDIR — the fixtures would land on the node's DEFAULT server and the teardown
  # kill-server would take the node session + every mind pane down (live incident 2026-07-14 23:00Z).
  # This one is the sharpest edge in the set: mesh-restore is what REBUILDS the session it would kill.
  _rs_td="$(mktemp -d 2>/dev/null)" || _rs_td=""
  [ -n "$_rs_td" ] || { echo "smoke-test: FAIL (mktemp -d failed — refusing to run tmux fixtures on the node's shared server)"; exit 1; }
  export TMUX_TMPDIR="$_rs_td"
  unset TMUX
  _rs_sock="$_rs_td/tmux-$(id -u)/default"
  # Guarded on OUR PRIVATE SOCKET FILE — never on $TMUX_TMPDIR (set even when tmux talks to the
  # default socket; that false guard is what let kill-server reach the node's server).
  trap '[ -S "${_rs_sock:-}" ] && tmux kill-server 2>/dev/null; rm -rf "$_rs_td"' EXIT TERM INT
  _S="$S"; S="restore-test-$$"
  tmux kill-session -t "$S" 2>/dev/null
  tmux new-session -d -s "$S" -n placeholder 2>/dev/null
  # ISOLATION assert (two real observables): our private server exists (what the teardown is guarded
  # on), and the fixture is invisible on the node's default server. Falsify: drop the `unset TMUX`
  # and run from inside a pane → it appears there → FAIL.
  [ -S "$_rs_sock" ] || {
    echo "smoke-test: FAIL (no private tmux socket at $_rs_sock — fixtures are NOT isolated)"; exit 1; }
  env -u TMUX_TMPDIR tmux has-session -t "$S" 2>/dev/null && {
    echo "smoke-test: FAIL (fixture session '$S' is visible on the node's DEFAULT tmux server — not isolated)"; exit 1; }
  if ! tmux has-session -t "$S" 2>/dev/null; then
    _fail2 "could not create isolated fixture session '$S'"
  else
    # (1) single-pane 'chat' window running mesh-chat --watch → ensure_channel must grow it to
    #     2 panes with the declared mind actually running in the bottom pane (the (a) fix).
    tmux new-window -d -t "$S" -n chat "mesh-chat --watch" 2>/dev/null
    sleep 0.3
    ensure_channel chat chat "sleep 194201"
    sleep 0.5
    np="$(tmux list-panes -t "$S:chat" -F '#{pane_index}' 2>/dev/null | wc -l)"
    [ "$np" -eq 2 ] || _fail2 "single-pane chat-commons collision: expected 2 panes after repair, got $np"
    bidx="$(tmux list-panes -t "$S:chat" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
    _occ "$S:chat.$bidx" | grep -q 'sleep 194201' \
      || _fail2 "single-pane collision: bottom pane is not running the declared mind cmd"
    # (2) 2-pane window where pane .1 is ALSO the stray chat-commons tail (both panes data, zero
    #     minds) → ensure_channel must respawn pane .1 into the declared mind (the (b) hardening).
    #     Falsify: revert the classifier/hardening and pane .1 keeps tailing chat.log forever.
    tmux new-window -d -t "$S" -n chat2 "sleep 999" 2>/dev/null
    tmux split-window -v -t "$S:chat2" "mesh-chat --watch" 2>/dev/null
    sleep 0.3
    _occ "$S:chat2.1" | grep -qE 'mesh-chat[[:space:]]+--watch' \
      || _fail2 "2-pane fixture setup: pane .1 did not start as the collision occupant"
    ensure_channel chat2 chat "sleep 194202"
    sleep 0.5
    _occ "$S:chat2.1" | grep -q 'sleep 194202' \
      || _fail2 "2-pane collision: pane .1 still not running the declared mind after repair"
    _occ "$S:chat2.1" | grep -qE 'mesh-chat[[:space:]]+--watch' \
      && _fail2 "2-pane collision: pane .1 still shows the stray chat-commons tail after repair"
  fi
  tmux kill-session -t "$S" 2>/dev/null
  S="$_S"
  [ "$fail2" = 0 ] && echo "  ok: ensure_channel chat-commons-collision repair (single-pane + 2-pane fixtures)"
  # $fail (the earlier block) is guaranteed 0 here — that block already exits 1 on its own failure.
  [ "$fail2" = 0 ] && echo "smoke-test: ok" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
}

tmux has-session -t "$S" 2>/dev/null || tmux new-session -d -s "$S"
KDIR="$HOME/.mesh/knowledge"     # the gossiped living-text tier (NOT git)

case "${1:-}" in
  --show)
    ensure_win restore "less '$KDIR/runbook.md'"
    echo "runbook open in window 'restore' (how-why-how to bring the node back)"; exit 0;;
  --pull)
    peer="${2:?usage: mesh-restore --pull <neighbour-ip>}"; user="${MESH_USER:-$USER}"
    mkdir -p "$KDIR"
    scp -qr -o BatchMode=yes -o ConnectTimeout=8 "$user@$peer:.mesh/knowledge/." "$KDIR/" 2>/dev/null \
      && echo "pulled living knowledge from $peer ($(ls "$KDIR"/*.md 2>/dev/null | wc -l) docs)" \
      || { echo "could not pull knowledge from $peer"; exit 1; }
    exit 0;;
esac

# wire/repair the node's cron reflexes. The DECLARED set (~/.mesh/reflexes.cron) self-heals:
# mesh-reflexes --apply (flock'd, idempotent) re-adds any dropped reflex and NEVER removes a line,
# so a clobber-race drop is back within one restore cycle (*/5). Falls back to the minimal mesh-tick
# seed on a fresh node with no declared set yet (run `mesh-reflexes --snapshot` once its reflexes
# are installed to begin self-healing them).
if command -v mesh-reflexes >/dev/null 2>&1 && [ -r "$HOME/.mesh/reflexes.cron" ]; then
  mesh-reflexes --apply >> "$HOME/.mesh/reflexes.log" 2>&1 || true
else
  grep -q 'mesh-tick' <(crontab -l 2>/dev/null) || \
    (crontab -l 2>/dev/null; echo "*/2 * * * * $HOME/.local/bin/mesh-tick >> $HOME/.mesh/tick.log 2>&1") | crontab -
fi

# shell folded into the genome channel (operator 2026-06-17: every window is data/mind; the genome
# mind runs its own build/deploy ops). chat is now a uniform 2-pane channel in THE MANIFEST below.
# INFRA LOOPS — WINDOWLESS (operator 2026-06-13: a window = data+MIND; no mindless loop-host windows).
# snapshot + selfcare are background reflex LOOPS, not windows-to-watch. They run headless under
# supervise (both in supervise.list); kick them here so they're live immediately on boot (idempotent —
# supervise's pgrep/flock prevents doubles). The old 2-log-tail 'reflex' window (no mind) is RETIRED;
# 'bash' (dup of shell) and 'verifier' are not recreated either.
pgrep -u "$(id -u)" -f 'mesh-snapshot --loop' >/dev/null 2>&1 || setsid bash -lc "exec $HOME/.local/bin/mesh-snapshot --loop 600" >/dev/null 2>&1 &
[ -x "$HOME/.local/bin/mesh-selfcare" ] && { pgrep -u "$(id -u)" -f 'mesh-selfcare --loop' >/dev/null 2>&1 || setsid bash -lc "exec $HOME/.local/bin/mesh-selfcare --loop 180" >/dev/null 2>&1 & }
# DATA CHANNELS — a window is a CHANNEL named after the DATA its TOP pane observes (mesh-dash <role>);
# the BOTTOM pane holds a mind, distributed across channels (NOT one-window-per-mind). 2026-06-13 operator
# reframe: window-name = the data/role, NOT the mind. Mapping: plan←claude, health/verify←opencode,
# work←codex, + a `minds` channel (top: all-minds state, bottom: a reviver loop, no agent).
# DECLARATION-DRIVEN + PATH-ROBUST: gate each mind channel on the node's CARD declaration (the card was
# built with full detection), NOT a live `command -v` (which missed nvm-installed minds in a non-login
# PATH and degraded ds). Fall back to command -v (nvm sourced) only when there's no card yet.
DECLARED="$(grep -E '^  *minds:' "$HOME/.mesh-card" 2>/dev/null | sed 's/^.*minds: *//')"
if [ -z "${DECLARED//[[:space:]]/}" ] || [ "$DECLARED" = "(none)" ]; then
  [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use node >/dev/null 2>&1 || true
  DECLARED=""; for a in claude opencode gemini codex; do command -v "$a" >/dev/null 2>&1 && DECLARED="$DECLARED $a"; done
fi
has_mind(){ case " $DECLARED " in *" $1 "*) return 0;; *) return 1;; esac; }
# UNIFORM SESSION MANIFEST (operator 2026-06-13: "every node's session the same — it shouldn't matter
# WHERE the mind/tmux/organs are"). EVERY node builds the SAME window set, in the SAME order. A
# mind-channel whose mind is not LOCAL still EXISTS: top = live data pane (mesh-dash <role>), bottom =
# a note that the mind is REMOTE + how to drive it (mesh-tell --node / mesh-organ). Location
# transparency — attach any node, see the same map; work routes to wherever the mind physically runs.
ensure_uniform_channel(){ # $1=win  $2=dash-role  $3=mind-type  $4=mind-cmd
  local win="$1" role="$2" mtype="$3" mcmd="$4"
  # LEAN-NODE allowlist: when MESH_MIND_CHANNELS (restore.env) is set, ONLY the listed channels run a
  # LOCAL mind; the rest become data-only (top dash + remote-note bottom). For RAM-constrained nodes
  # that cannot host the full ~9-mind suite (e.g. phaedra 1.9Gi → MESH_MIND_CHANNELS="dev verify").
  # Unset → full uniform suite (default, every existing node unchanged).
  if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
    case " $MESH_MIND_CHANNELS " in *" $win "*) :;; *) mtype="__lean_skip__";; esac
  fi
  # LEAN-MCP wiring (chat-review/channel-minds-lean-mcp): opt-in, claude-only (enabledPlugins/--settings
  # are a claude-code concept — opencode's MCP config is separate, out of scope here), per-channel
  # escape hatch via mcp_full_for_win. See the LEAN-MCP block near the top of this file for the WHY.
  if [ "$mtype" = claude ] && [ "${MESH_MCP_LEAN:-0}" = 1 ] && ! mcp_full_for_win "$win"; then
    mcmd="$mcmd --settings $(lean_mcp_settings_file)"
  fi
  if has_mind "$mtype"; then ensure_channel "$win" "$role" "$mcmd"; return 0; fi
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$win" && return 0
  tmux new-window -d -t "$S" -n "$win" "exec $HOME/.local/bin/mesh-dash $role"     # top = DATA
  # remote-mind note — META-CHAR FREE (no < > | ( ) — they'd be parsed as redirections through the
  # nested tmux/bash quoting and break the pane, which is exactly what bit the first rollout).
  tmux split-window -v -t "$S:$win" "bash -lc 'echo; echo \"  channel $win — mind type $mtype is REMOTE on this node\"; echo \"  data above is live: mesh-dash $role\"; echo \"  drive the mind where it runs:  mesh-tell --node PEER $win\"; echo; exec bash -l'"
}
# THE MANIFEST — identical on every node (the only difference: bottom pane is a local mind or a remote note)
# MINIMAL 6-CHANNEL SET (operator 2026-06-17 — minds are IdeaPad-only; re-org'd from scratch).
# Every window = 2-pane data/mind. genome = autonomous development of the CODEBASE (absorbs old
# dev/discover/work/verify/plan); senses = keep+develop the SENSES (perception analogue of genome).
# Engines: claude on the 3 that need reasoning/operator-facing (minds/genome/tg), free opencode on
# the 3 monitors (senses/health/chat) — quota+heat aware. All 6 run a persistent local mind.
ensure_uniform_channel minds   minds   claude   "${MESH_MINDS_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
ensure_uniform_channel genome  genome  claude   "${MESH_GENOME_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
ensure_uniform_channel tg      tg      claude   "${MESH_CLAUDE_CMD:-$CLAUDE_BIN}"
ensure_uniform_channel senses  senses  opencode "${MESH_SENSES_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
ensure_uniform_channel health  check   opencode "${MESH_HEALTH_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
ensure_uniform_channel chat    chat    opencode "${MESH_CHAT_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
# room = the mesh as a THIRD PARTY in the room (operator 2026-06-20). Data pane = the live rolling
# ~15-min transcript mesh-overhear keeps on the mic+Bose node; MIND = claude (operator: "навесим клода"),
# the observer that on a thumbs-up reads the transcript and speaks a comment on the Bose. Mostly idle
# (only acts on the gesture), so it adds little continuous heat on this node.
ensure_uniform_channel room    room    claude   "${MESH_ROOM_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
# pub = the PUBLISHING channel (operator 2026-06-24/25). Data pane = mesh-pub-dash's two-half surface
# (LEFT: local novelties + genome literature reviews to write about; RIGHT: external comments/reactions
# on our posts — HN/Reddit/dev.to). MIND = claude: writes + publishes to dev.to (mesh-devto-publish,
# key in ~/.mesh/devto.env) and reacts to accumulated comments. Lives in the manifest so it survives a
# reboot (was a manual extra window before, lost on the 2026-06-25 lean reboot → operator asked it back).
# Mostly idle + a SLOW consume interval (restore.env pub:900) — little continuous heat.
ensure_uniform_channel pub     pub     claude   "${MESH_PUB_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
# discover = the GROWTH/DISCOVERY channel (operator 2026-06-25, revived). Data pane = mesh-dash discover
# (the capability-research frontier: WIRED-vs-AVAILABLE, opencode spend, phone termux surface, recent
# finds). MIND = claude with the standing ~/.mesh/discover-mission.md charter: NOT a health-checker — it
# only hunts NEW reach (senses/actuators/nodes/fusions), proves each with an artifact, hands wins to the
# steward. The old discover channel was folded into genome on 2026-06-17; operator wants it back DEDICATED
# so growth effort isn't crowded out by genome's codebase work. SLOW consume (restore.env discover:900).
ensure_uniform_channel discover discover claude  "${MESH_DISCOVER_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
# sound = the SOUND-STUDIO channel (operator 2026-07-06 over TG, dedicated window asked explicitly):
# (a) sound transformations — granular renders of his jams per the grainneukeln taste memory,
# (b) stewardship of the ~/grainneukeln repo. Note 3 was scoped in then REMOVED same day (operator
# + mesh concurred) — it stays with senses/discover/genome. Charter: ~/.mesh/sound-mission.md.
# SLOW consume (restore.env sound:3600).
ensure_uniform_channel sound   sound   claude   "${MESH_SOUND_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
# models = the MODEL-SELECTION channel (operator 2026-07-15: "lets make it work" — the lane that
# replaces the stale stack: piper 37mo / moondream2 28mo / whisper-turbo 21mo, stack median TWO
# YEARS). Data pane = mesh-dash models: which model each organ ACTUALLY runs (mesh-model-resolve,
# observed per CONSUMER — never a map: mesh-model-watch claimed whisper while gigaam was live) +
# the measured ledger, where UNMEASURED renders UNMEASURED. opencode (free): accuracy here is
# MECHANICAL (WER vs a ground-truth fixture), not a judgment call, so the lane needs no paid
# reasoner. Charter: docs/superpowers/specs/2026-07-15-models-channel-design.md.
ensure_uniform_channel models  models  opencode "${MESH_MODELS_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
# vpn = the VPN-SERVICE channel (operator 2026-07-06 over TG: "раз это важный сервис — отдельное окно").
# Data pane = mesh-dash vpn (server health + end-to-end tunnel + who's-connected + [vpn-*] verdicts, all
# from CACHED reflex artifacts). The Fedya-catch: mesh-vpn-health --edge already posts [vpn-down] to the
# board on a break, so WE see it before a user complains; the mind here diagnoses READ-ONLY and never
# restarts a working VPN (never-touch-working-vpn). opencode = free pool (mostly idle, steady OK).
ensure_uniform_channel vpn     vpn     opencode "${MESH_VPN_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
# bruno = the CAT channel (operator 2026-07-06 over TG: dedicated window, 2nd instance of channel-genesis).
# Data pane = mesh-dash bruno (mesh-bruno's ONE cross-section: cam+wifi-motion+operator labels → coarse
# ACTIVITY, not location). MIND tunes the classifier against the operator's own TG ground-truth labels.
# opencode = free pool (sense-tending, like senses). SLOW consume — the cat is not urgent.
ensure_uniform_channel bruno   bruno   opencode "${MESH_BRUNO_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
# witness = the SELF-MEASUREMENT channel (operator 2026-07-06 over TG: "окно witness — меш, который
# меряет сам себя. постоянная лента измерений"). Data pane = mesh-dash witness = the mesh-witness
# ledger, a PURE-ALGORITHMIC render fed by the mesh-witness --measure reflex — NO AI in the measurement
# tract (operator rule, same thread). The opencode mind (FREE pool) only WITNESSES the tape: reacts to
# drift/anomaly, posts [fyi] to the board — it never writes a measurement.
ensure_uniform_channel witness witness opencode "${MESH_WITNESS_CMD:-${MESH_OPENCODE_CMD:-opencode}}"

echo "UNIFORM session ensured (14-channel set): minds genome tg senses health chat room pub discover sound vpn bruno witness models (local minds: ${DECLARED# })."
echo "optional (judgment — start deliberately, see docs/runbook.md):"
echo "  genius-loci:  GL_WEBCAM=/dev/video0 tmux new-window -n genius-loci 'genius-loci'"
echo "  voice agent:  mesh-voice"
