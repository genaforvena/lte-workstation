#!/usr/bin/env bash
# mesh-restore — bring this node's standard loops back (idempotent). The WHY and the full
# intended state live in docs/runbook.md (the text); this is the thin hand that re-establishes
# the body. Optional, judgment-laden things (genius-loci, voice) are NOT auto-started here.
#
#   mesh-restore          ensure the standard loops (chat, snapshot) are running
#   mesh-restore --show   open a 'restore' window with the runbook (how-why-how)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # works under cron, @reboot, and non-interactive SSH
# nvm-installed minds (codex lives in ~/.nvm/.../bin) are invisible to cron's bare PATH — without
# this the codex channel silently never restores after reboot ('command -v codex' fails under cron)
NVM_BIN=$(ls -d "$HOME/.nvm/versions/node/"*/bin 2>/dev/null | sort -V | tail -1)
[ -n "$NVM_BIN" ] && export PATH="$NVM_BIN:$PATH"
S="$(hostname)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
# node-local restore config (gitignored, per-node) — operational opt-ins that must NOT live in the
# plantable genome. e.g. MESH_CODEX_CMD lets a node run codex with autonomous flags; the genome default
# stays SAFE (plain `codex`), the node opts in locally. Keeps dangerous flags out of fleet-wide auto-heal.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

# NATIVE CLAUDE, ALWAYS (operator hard rule 2026-06-19): a mind must launch the native claude
# binary, never an npm/node wrapper. The official native installer drops an ELF at
# ~/.local/bin/claude (or ~/.claude/local/claude); an npm install is a node script. So the launch
# DEFAULT resolves the native ELF by checking the 0x7f 'E' 'L' 'F' magic — bare PATH `claude` (which
# could be an npm shim earlier on PATH) is only the last resort if no native binary is present. A
# node may still override with MESH_CLAUDE_CMD (restore.env), which wins.
CLAUDE_BIN=claude
for _c in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
  [ -x "$_c" ] || continue
  [ "$(od -An -tx1 -N4 "$_c" 2>/dev/null | tr -d ' ')" = 7f454c46 ] || continue
  CLAUDE_BIN="$_c"; break
done

# Pre-seed claude's workspace TRUST so a FRESH mind node doesn't gate every mind on the one-time
# "Do you trust the files in this folder?" prompt (phaedra, 2026-06-15: all 5 minds stuck on it →
# a peer can't cross-press it = permission-laundering, so it stranded the whole node's onboarding).
#
# OPT-IN, DEFAULT-OFF — pre-accepting a trust gate is a permission-BYPASS, so (like the codex bypass
# flags below) it must be a node-local decision in ~/.mesh/restore.env, NEVER a genome default that
# silently disarms the folder-trust guardrail fleet-wide. The node's OWNER sets MESH_SEED_CLAUDE_TRUST=1
# to declare "I trust my own genome folder on this node + I run minds in --permission-mode auto anyway".
# With it unset, mesh-restore touches no config and the gate behaves normally (operator answers it once).
# When enabled: idempotent (merge, never clobber creds/other projects), best-effort (never fails
# restore), re-seeded each run so a mind's config write-back can't strand it; gated minds unblock on
# their next channel-keepalive relaunch (the new process reads the seeded trust → no prompt).
seed_claude_trust(){
  [ "${MESH_SEED_CLAUDE_TRUST:-0}" = 1 ] || return 0     # node-local opt-in only (restore.env)
  command -v claude >/dev/null 2>&1 || return 0          # only on nodes that run claude minds
  command -v python3 >/dev/null 2>&1 || return 0          # safe JSON merge needs python3
  local cj="$HOME/.claude.json"
  MESH_TRUST_REPO="$REPO" MESH_TRUST_HOME="$HOME/lte-workstation" python3 - "$cj" <<'PY' 2>/dev/null || true
import json,os,sys,tempfile
cj=sys.argv[1]
paths={p for p in (os.environ.get("MESH_TRUST_REPO"),os.environ.get("MESH_TRUST_HOME")) if p}
try:
    d=json.load(open(cj)) if os.path.exists(cj) and os.path.getsize(cj) else {}
except Exception:
    sys.exit(0)            # unparseable (e.g. mid-write by a running claude) → don't risk clobbering it
changed=False
if not d.get("hasCompletedOnboarding"): d["hasCompletedOnboarding"]=True; changed=True
proj=d.setdefault("projects",{})
for p in paths:
    e=proj.setdefault(p,{})
    if not e.get("hasTrustDialogAccepted"): e["hasTrustDialogAccepted"]=True; changed=True
if changed:
    fd,tmp=tempfile.mkstemp(dir=os.path.dirname(cj) or ".",prefix=".claude.json.")
    with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2)
    os.replace(tmp,cj)              # atomic — a concurrent reader never sees a half-written file
PY
}
seed_claude_trust

[ "${1:-}" = --test ] && { fail=0
  command -v tmux >/dev/null 2>&1 || { echo "  FAIL: no tmux — can't restore a session"; fail=1; }
  [ -d "$REPO/scripts" ] || { echo "  FAIL: no genome at $REPO"; fail=1; }
  [ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || [ ! -f "$HOME/.mesh/restore.env" ] || { echo "  FAIL: restore.env unparseable"; fail=1; }
  command -v mesh-chat >/dev/null 2>&1 || { echo "  FAIL: no mesh-chat"; fail=1; }
  command -v mesh-heartbeat >/dev/null 2>&1 || { echo "  FAIL: no mesh-heartbeat"; fail=1; }
  command -v mesh-reflexes >/dev/null 2>&1 || { echo "  FAIL: no mesh-reflexes"; fail=1; }
  tmux has-session -t "$S" 2>/dev/null || { echo "  FAIL: tmux session '$S' missing — run mesh-restore (no args) to create it"; fail=1; }
  bash -n "$0" >/dev/null 2>&1 || { echo "  FAIL: bash syntax error in $0"; fail=1; }
  [ "$fail" = 0 ] && echo "smoke-test: ok" || { echo "smoke-test: FAIL"; exit 1; }; exit 0; }
ensure_win(){ tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$1" || tmux new-window -t "$S" -n "$1" "$2"; }

# CHANNEL builder (operator: top=DATA refreshing, bottom=MIND). Reincarnates each mind as a 2-pane
# channel so a reboot restores the FULL architecture, not just the old loops. Idempotent + append-only:
# missing -> build (top=dash, bottom=mind); legacy single-pane -> add the mind below; already 2-pane ->
# leave it (mesh-channel-keepalive tends it). The mind is wrapped so its pane survives the mind exiting
# (drops to a login shell), keeping the window a 2-pane channel that keepalive can relaunch into.
ensure_channel(){ # $1=win  $2=dash-role  $3=mind-cmd
  local win="$1" role="$2" mind="$3"
  # PATH-robust mind launch: a bare `bash -lc` login shell finds claude/gemini but NOT opencode
  # (~/.opencode/bin) or codex (nvm) — they'd die as 'command not found' → bare shell, leaving the
  # health/verify/work channels with dead bottoms (2026-06-13). Prepend the mind-install dirs + source
  # nvm so every declared mind actually launches, regardless of the node's login-shell config.
  # MESH_WHO carries the WINDOW identity onto every board post this mind makes — mesh-chat falls back
  # to $USER@host when unset, so all mind windows collapse into one 'imozerov@host' identity that's
  # unattributable by lane (chat-review/window-attribution). $win is UNESCAPED so the PARENT substitutes
  # the real window name into mw (exactly like $mind); a \$win would expand in the child bash -lc where
  # win is unset → MESH_WHO="@host" (empty lane name, worse than the status quo).
  local mw="bash -lc 'export MESH_WHO=\"$win@\$(hostname)\"; export PATH=\"\$HOME/.opencode/bin:\$HOME/.bun/bin:\$HOME/.local/bin:\$PATH\"; [ -s \"\$HOME/.nvm/nvm.sh\" ] && . \"\$HOME/.nvm/nvm.sh\" >/dev/null 2>&1; cd \$HOME/lte-workstation 2>/dev/null; $mind; exec bash -l'"
  if ! tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$win"; then
    tmux new-window -d -t "$S" -n "$win" "exec $HOME/.local/bin/mesh-dash $role"   # top = DATA
    tmux split-window -v -t "$S:$win" "$mw"                                        # bottom = MIND
    tmux select-layout -t "$S:$win" even-vertical 2>/dev/null || true
  elif ! tmux list-panes -t "$S:$win" -F '#{pane_index}' 2>/dev/null | grep -qx 1; then
    # single-pane window: LOOK at what occupies it before touching it. Typing 'exec mesh-dash'
    # blindly assumed a bare shell — 2026-06-13 near-miss: gemini's lone pane held 'ssh ilya'
    # (a peer's mind behind it); the exec would have run ON THE PEER. Three cases:
    local ppid occ
    ppid=$(tmux display -p -t "$S:$win.0" '#{pane_pid}' 2>/dev/null)
    occ="$(ps -o args= -p "$ppid" 2>/dev/null; pgrep -P "$ppid" 2>/dev/null | xargs -r ps -o args= -p 2>/dev/null)"
    if printf '%s' "$occ" | grep -qE 'mesh-dash'; then
      tmux split-window -v -t "$S:$win" "$mw"                                      # lone DATA → add MIND below
    elif [ -z "$(pgrep -P "$ppid" 2>/dev/null)" ] && printf '%s' "$occ" | grep -qE '^-?(ba|z|da)?sh( -l)?[[:space:]]*$'; then
      tmux send-keys -t "$S:$win.0" C-u 2>/dev/null; sleep 0.1
      tmux send-keys -t "$S:$win.0" "exec $HOME/.local/bin/mesh-dash $role" C-m    # bare shell → make it DATA
      tmux split-window -v -t "$S:$win" "$mw"                                      # add MIND below
    else
      # OCCUPIED (a mind TUI, an ssh, any live process): inject NOTHING into it — split the DATA
      # pane ABOVE (-b → new pane idx 0) so the occupant keeps the bottom = mind slot the feeders drive
      tmux split-window -vb -d -t "$S:$win.0" "exec $HOME/.local/bin/mesh-dash $role"
    fi
    tmux select-layout -t "$S:$win" even-vertical 2>/dev/null || true
  fi
}

tmux has-session -t "$S" 2>/dev/null || tmux new-session -d -s "$S"
KDIR="$HOME/.mesh/knowledge"     # the gossiped living-text tier (NOT git)

case "${1:-}" in
  --show)
    ensure_win restore "less '$KDIR/runbook.md'"
    echo "runbook open in window 'restore' (how-why-how to bring the node back)"; exit 0;;
  --pull)
    peer="${2:?usage: mesh-restore --pull <neighbour-ip>}"; user="${MESH_USER:-$USER}"
    mkdir -p "$KDIR"
    scp -qr -o BatchMode=yes -o ConnectTimeout=8 "$user@$peer:.mesh/knowledge/." "$KDIR/" 2>/dev/null \
      && echo "pulled living knowledge from $peer ($(ls "$KDIR"/*.md 2>/dev/null | wc -l) docs)" \
      || { echo "could not pull knowledge from $peer"; exit 1; }
    exit 0;;
esac

# wire/repair the node's cron reflexes. The DECLARED set (~/.mesh/reflexes.cron) self-heals:
# mesh-reflexes --apply (flock'd, idempotent) re-adds any dropped reflex and NEVER removes a line,
# so a clobber-race drop is back within one restore cycle (*/5). Falls back to the minimal mesh-tick
# seed on a fresh node with no declared set yet (run `mesh-reflexes --snapshot` once its reflexes
# are installed to begin self-healing them).
if command -v mesh-reflexes >/dev/null 2>&1 && [ -r "$HOME/.mesh/reflexes.cron" ]; then
  mesh-reflexes --apply >> "$HOME/.mesh/reflexes.log" 2>&1 || true
else
  grep -q 'mesh-tick' <(crontab -l 2>/dev/null) || \
    (crontab -l 2>/dev/null; echo "*/2 * * * * $HOME/.local/bin/mesh-tick >> $HOME/.mesh/tick.log 2>&1") | crontab -
fi

# shell folded into the genome channel (operator 2026-06-17: every window is data/mind; the genome
# mind runs its own build/deploy ops). chat is now a uniform 2-pane channel in THE MANIFEST below.
# INFRA LOOPS — WINDOWLESS (operator 2026-06-13: a window = data+MIND; no mindless loop-host windows).
# snapshot + selfcare are background reflex LOOPS, not windows-to-watch. They run headless under
# supervise (both in supervise.list); kick them here so they're live immediately on boot (idempotent —
# supervise's pgrep/flock prevents doubles). The old 2-log-tail 'reflex' window (no mind) is RETIRED;
# 'bash' (dup of shell) and 'verifier' are not recreated either.
pgrep -u "$(id -u)" -f 'mesh-snapshot --loop' >/dev/null 2>&1 || setsid bash -lc "exec $HOME/.local/bin/mesh-snapshot --loop 600" >/dev/null 2>&1 &
[ -x "$HOME/.local/bin/mesh-selfcare" ] && { pgrep -u "$(id -u)" -f 'mesh-selfcare --loop' >/dev/null 2>&1 || setsid bash -lc "exec $HOME/.local/bin/mesh-selfcare --loop 180" >/dev/null 2>&1 & }
# DATA CHANNELS — a window is a CHANNEL named after the DATA its TOP pane observes (mesh-dash <role>);
# the BOTTOM pane holds a mind, distributed across channels (NOT one-window-per-mind). 2026-06-13 operator
# reframe: window-name = the data/role, NOT the mind. Mapping: plan←claude, health/verify←opencode,
# work←codex, + a `minds` channel (top: all-minds state, bottom: a reviver loop, no agent).
# DECLARATION-DRIVEN + PATH-ROBUST: gate each mind channel on the node's CARD declaration (the card was
# built with full detection), NOT a live `command -v` (which missed nvm-installed minds in a non-login
# PATH and degraded ds). Fall back to command -v (nvm sourced) only when there's no card yet.
DECLARED="$(grep -E '^  *minds:' "$HOME/.mesh-card" 2>/dev/null | sed 's/^.*minds: *//')"
if [ -z "${DECLARED//[[:space:]]/}" ] || [ "$DECLARED" = "(none)" ]; then
  [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use node >/dev/null 2>&1 || true
  DECLARED=""; for a in claude opencode gemini codex; do command -v "$a" >/dev/null 2>&1 && DECLARED="$DECLARED $a"; done
fi
has_mind(){ case " $DECLARED " in *" $1 "*) return 0;; *) return 1;; esac; }
# UNIFORM SESSION MANIFEST (operator 2026-06-13: "every node's session the same — it shouldn't matter
# WHERE the mind/tmux/organs are"). EVERY node builds the SAME window set, in the SAME order. A
# mind-channel whose mind is not LOCAL still EXISTS: top = live data pane (mesh-dash <role>), bottom =
# a note that the mind is REMOTE + how to drive it (mesh-tell --node / mesh-organ). Location
# transparency — attach any node, see the same map; work routes to wherever the mind physically runs.
ensure_uniform_channel(){ # $1=win  $2=dash-role  $3=mind-type  $4=mind-cmd
  local win="$1" role="$2" mtype="$3" mcmd="$4"
  # LEAN-NODE allowlist: when MESH_MIND_CHANNELS (restore.env) is set, ONLY the listed channels run a
  # LOCAL mind; the rest become data-only (top dash + remote-note bottom). For RAM-constrained nodes
  # that cannot host the full ~9-mind suite (e.g. phaedra 1.9Gi → MESH_MIND_CHANNELS="dev verify").
  # Unset → full uniform suite (default, every existing node unchanged).
  if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
    case " $MESH_MIND_CHANNELS " in *" $win "*) :;; *) mtype="__lean_skip__";; esac
  fi
  if has_mind "$mtype"; then ensure_channel "$win" "$role" "$mcmd"; return 0; fi
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$win" && return 0
  tmux new-window -d -t "$S" -n "$win" "exec $HOME/.local/bin/mesh-dash $role"     # top = DATA
  # remote-mind note — META-CHAR FREE (no < > | ( ) — they'd be parsed as redirections through the
  # nested tmux/bash quoting and break the pane, which is exactly what bit the first rollout).
  tmux split-window -v -t "$S:$win" "bash -lc 'echo; echo \"  channel $win — mind type $mtype is REMOTE on this node\"; echo \"  data above is live: mesh-dash $role\"; echo \"  drive the mind where it runs:  mesh-tell --node PEER $win\"; echo; exec bash -l'"
}
# THE MANIFEST — identical on every node (the only difference: bottom pane is a local mind or a remote note)
# MINIMAL 6-CHANNEL SET (operator 2026-06-17 — minds are IdeaPad-only; re-org'd from scratch).
# Every window = 2-pane data/mind. genome = autonomous development of the CODEBASE (absorbs old
# dev/discover/work/verify/plan); senses = keep+develop the SENSES (perception analogue of genome).
# Engines: claude on the 3 that need reasoning/operator-facing (minds/genome/tg), free opencode on
# the 3 monitors (senses/health/chat) — quota+heat aware. All 6 run a persistent local mind.
ensure_uniform_channel minds   minds   claude   "${MESH_MINDS_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
ensure_uniform_channel genome  genome  claude   "${MESH_GENOME_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
ensure_uniform_channel tg      tg      claude   "${MESH_CLAUDE_CMD:-$CLAUDE_BIN}"
ensure_uniform_channel senses  senses  opencode "${MESH_SENSES_CMD:-${MESH_OPENCODE_CMD:-opencode}}"
ensure_uniform_channel health  check   opencode "${MESH_OPENCODE_CMD:-opencode}"
ensure_uniform_channel chat    chat    opencode "${MESH_OPENCODE_CMD:-opencode}"
# room = the mesh as a THIRD PARTY in the room (operator 2026-06-20). Data pane = the live rolling
# ~15-min transcript mesh-overhear keeps on the mic+Bose node; MIND = claude (operator: "навесим клода"),
# the observer that on a thumbs-up reads the transcript and speaks a comment on the Bose. Mostly idle
# (only acts on the gesture), so it adds little continuous heat on this node.
ensure_uniform_channel room    room    claude   "${MESH_ROOM_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"
# pub = the PUBLISHING channel (operator 2026-06-24/25). Data pane = mesh-pub-dash's two-half surface
# (LEFT: local novelties + genome literature reviews to write about; RIGHT: external comments/reactions
# on our posts — HN/Reddit/dev.to). MIND = claude: writes + publishes to dev.to (mesh-devto-publish,
# key in ~/.mesh/devto.env) and reacts to accumulated comments. Lives in the manifest so it survives a
# reboot (was a manual extra window before, lost on the 2026-06-25 lean reboot → operator asked it back).
# Mostly idle + a SLOW consume interval (restore.env pub:900) — little continuous heat.
ensure_uniform_channel pub     pub     claude   "${MESH_PUB_CMD:-${MESH_CLAUDE_CMD:-$CLAUDE_BIN}}"

echo "UNIFORM session ensured (8-channel set): minds genome tg senses health chat room pub (local minds: ${DECLARED# })."
echo "optional (judgment — start deliberately, see docs/runbook.md):"
echo "  genius-loci:  GL_WEBCAM=/dev/video0 tmux new-window -n genius-loci 'genius-loci'"
echo "  voice agent:  mesh-voice"
echo "  heartbeat:    /loop 3h heartbeat and tmux quick check"
