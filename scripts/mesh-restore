#!/usr/bin/env bash
# mesh-restore — bring this node's standard loops back (idempotent). The WHY and the full
# intended state live in docs/runbook.md (the text); this is the thin hand that re-establishes
# the body. Optional, judgment-laden things (genius-loci, voice) are NOT auto-started here.
#
#   mesh-restore          ensure the standard loops (chat, snapshot) are running
#   mesh-restore --show   open a 'restore' window with the runbook (how-why-how)
set -uo pipefail
S="$(hostname)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
ensure_win(){ tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$1" || tmux new-window -t "$S" -n "$1" "$2"; }

tmux has-session -t "$S" 2>/dev/null || tmux new-session -d -s "$S"
KDIR="$HOME/.mesh/knowledge"     # the gossiped living-text tier (NOT git)

case "${1:-}" in
  --show)
    ensure_win restore "less '$KDIR/runbook.md'"
    echo "runbook open in window 'restore' (how-why-how to bring the node back)"; exit 0;;
  --pull)
    peer="${2:?usage: mesh-restore --pull <neighbour-ip>}"; user="${MESH_USER:-$USER}"
    mkdir -p "$KDIR"
    scp -qr -o BatchMode=yes -o ConnectTimeout=8 "$user@$peer:.mesh/knowledge/." "$KDIR/" 2>/dev/null \
      && echo "pulled living knowledge from $peer ($(ls "$KDIR"/*.md 2>/dev/null | wc -l) docs)" \
      || { echo "could not pull knowledge from $peer"; exit 1; }
    exit 0;;
esac

ensure_win chat     "exec $HOME/.local/bin/mesh-chat --watch"
ensure_win snapshot "exec $HOME/.local/bin/mesh-snapshot --loop 600"
# self-care: the node KNOWS its connectivity and HEALS what it can, on its own (reflexive breathing).
[ -x "$HOME/.local/bin/mesh-selfcare" ] && ensure_win selfcare "exec $HOME/.local/bin/mesh-selfcare --loop 180"
echo "standard loops ensured: chat, snapshot, self-care."
echo "optional (judgment — start deliberately, see docs/runbook.md):"
echo "  genius-loci:  GL_WEBCAM=/dev/video0 tmux new-window -n genius-loci 'genius-loci'"
echo "  voice agent:  mesh-voice"
echo "  heartbeat:    /loop 3h heartbeat and tmux quick check"
