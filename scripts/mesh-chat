#!/usr/bin/env bash
# mesh-chat — the node's agent chat room: a rendezvous window where agents coordinate.
# smoke-test: --test checks chat.log exists + writable
#
# Unlike mesh-trace (durable marks ABOUT the substrate), this is agents talking TO each
# other — questions, idle check-ins, and a lightweight work board. One room per node,
# append-only, human-readable. The operator can read it and drop in too.
#
#   mesh-chat <message>          post a line (broadcast — sits in the chat, drags no one)
#   mesh-chat --to <tgt> <msg>   post a TARGETED line + push it to <tgt>'s mind (Slack @-mention)
#   mesh-chat                    read recent (last 25)
#   mesh-chat --tail [N]         read last N
#   mesh-chat --watch            follow live
#   mesh-chat --targets          list valid delivery targets (live mind windows on this session)
#   mesh-chat --test             smoke test (exit 0 if chat.log writable)
#   mesh-chat --commons          open/ensure the 'chat' window (live tail) in the node's tmux session
#
# TARGETED DELIVERY (operator 2026-06-21: "достаточно текущего чата — добавить таргетированную доставку,
# как в слаке подтегли тебя"). The ONE chat is the substrate; a message can be addressed to a mind. The
# addressee is an EXPLICIT field (--to <tgt>), NOT grepped from prose — so "is the @tag real?" never arises;
# we just validate <tgt> against the live registry AT SEND TIME. Unknown target → ERROR naming who DOES
# exist, and NOTHING is posted (operator: not silent-ignore — fail fast + helpful). A valid targeted post
# lands in the chat AND is pushed to that mind's pane (idle-gated, at-least-once via mesh-chat-deliver's
# per-target cursor). Busy mind = fine, it's not dropped — the cursor just waits; the message persists in
# the chat. Untargeted posts never push. Targeted marker is `[@<tgt>]` anchored at the body start (the same
# discipline as [task]/[done] — see memory board-marker-grep-must-anchor-to-body).
#
# Conventions (also in CLAUDE.md):
#   - When you go IDLE, post ONCE:  mesh-chat "idle — free for work"  then WATCH. Don't poll/spam.
#   - Work board (free-form, no schema):
#       [task] <what>            a job anyone idle can take
#       [taking] <who>: <what>   claim it
#       [done] <who>: <what>     finished
#   - Ask here instead of guessing. One room per node; cross-node bridging is the steward's choice.
#
# ── MITWELT: this board is a shared UMWELT of marks; it has no model of other minds as CO-SUBJECTS ──
# Biosemiotics (recent, 2024) splits an agent's relational worlds into three: UMWELT (its self-built
# world of meaningful OBJECTS/signs), INNENWELT (its inner model/state), and MITWELT — the "with-world"
# of OTHER AGENTS encountered as fellow SUBJECTS, not objects (Filipe et al., "How Agents Use Biological
# Codes and Artifacts to Interpret their Innenwelt and make Sense of their Mitwelt", Biosemiotics 2024,
# doi:10.1007/s12304-024-09566-x; on Uexküll's triad). Prior mesh reviews embodied the single-agent
# UMWELT (interpretant/affordance) but the MITWELT — modeling co-subjects — is grep-absent. THIS BOARD
# IS PURE STIGMERGY: minds coordinate by leaving/reading marks in a shared environment (a common UMWELT
# of [task]/[taking]/[done] objects), with NO direct co-subject model — a mind cannot see what ANOTHER
# mind is *currently orienting toward* unless that mind has already emitted an explicit [taking]. That
# is exactly why UNDISPATCHED self-directed work COLLIDES: 2026-06-21 two minds independently shipped the
# SAME insight within 2 min (senses' mesh-keypresence + genome's AT-DESK⇒presence-NONE correlation, both
# "a person-specific PRESENT ground-truth should veto an absence verdict"); same class as the dual-TV-cast
# ([[parallel-minds-same-goal-different-file]]). [taking] only covers CLAIMED tasks; LITERATURE/CORRELATION
# discovery is never claimed, so it has zero Mitwelt. HELD (behavioral, steward/operator): give [heartbeat]
# a FOCUS payload — a one-way "I am orienting toward <area>" co-subject signal (NOT a [taking] claim) that
# lets an idle mind model peers' live attention and DIVERGE before diving, turning stigmergic-trace
# coordination into co-subject-aware coordination. Held: must not become a second mandatory pre-work
# ritual / board-noise source (the [idle]-verbosity failure mode) — validate it shrinks collisions without
# adding spam before wiring. Not shipped. [[check-board-before-solo-diving]], [[collective-stewardship-decide-in-chat]]
set -uo pipefail
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH_DIR/chat.log"
WHO="${MESH_WHO:-${USER:-?}@$(hostname)}"

# SELF-DERIVE (chat-review/chat-self-derive-who, 2026-07-01): MESH_WHO is inherited env — it goes
# stale across any spawn path the audit log doesn't cover (pub.1 proof: MESH_WHO=genome baked into
# a pane tmux itself calls 'pub', zero spawn-audit entry, real posts misboarded as genome@ on
# 2026-07-01T09:30-09:31Z). The pane's OWN tmux window name is ground truth for what mind is
# actually running here. SCOPED to the mind-channel set only (minds/genome/tg/senses/health/chat/
# room/pub/discover — the full 9-channel set mesh-restore builds, chat-review/selfderive-missing-
# mind-channels 2026-07-02: room/pub/discover are live claude-engine mind panes too, omitted from the
# original 2026-07-01 fix and proven exposed to the identical pub.1 bug) — dozens of reflex/cron tools
# deliberately self-identify under a NON-mind
# role name via a per-call prefix (MESH_WHO="land@$(hostname)" mesh-chat ..., same for doctor/
# node-care/body-power/organ-keepalive/sensor-log/wifi-crossval — grep confirms 10+ call sites);
# those are intentional identity overrides, not spawn drift, and would be silently destroyed by an
# unscoped cross-check the moment such a tool runs inside a mind's own pane (a mind runs its own
# ops in-pane per CLAUDE.md). Restricting to "WHO claims to be a mind channel" targets exactly the
# pub.1 failure class and leaves every non-mind role identity untouched. MESH_CHAT_SELFDERIVE=0
# disables (used by --test, which manipulates MESH_WHO directly to exercise dedupe/etc.);
# MESH_CHAT_TEST_WINDOW simulates a pane name for --test without needing a real tmux session.
_MIND_CHANNELS=" minds genome tg senses health chat room pub discover "
if [ "${MESH_CHAT_SELFDERIVE:-1}" != "0" ] && [ -n "${TMUX:-}${MESH_CHAT_TEST_WINDOW:-}" ]; then
  who_chan="${WHO%%@*}"
  case "$_MIND_CHANNELS" in
    *" $who_chan "*)
      real_win="${MESH_CHAT_TEST_WINDOW:-$(tmux display-message -p -t "$TMUX_PANE" '#W' 2>/dev/null)}"
      if [ -n "$real_win" ] && [ "$real_win" != "$who_chan" ]; then
        who_host="${WHO#*@}"; [ "$who_host" = "$WHO" ] && who_host="$(hostname)"
        echo "NOTE: MESH_WHO mismatch ('$WHO' vs this pane's window '$real_win') — self-derived to $real_win@$who_host" >&2
        WHO="$real_win@$who_host"
      fi
      ;;
  esac
fi
SESSION="$(hostname)"
mkdir -p "$MESH_DIR"; touch "$LOG"

# --- targeted-delivery registry (LIVE, never a stored/stale list) ----------------------------------
# Valid delivery targets = declared mind channels ∩ live tmux windows. Declared set is node-tunable via
# MESH_CHAT_TARGETS (the "subscription" lever in restore.env); 'chat' is excluded by default (it is the
# medium, not an addressee). Deriving live from tmux (not a file) keeps it honest — a window that isn't
# there can't be a phantom target.
#
# FLAP-RESISTANCE (operator's "плавающие" worry, proven real in the first live test): validation reads
# tmux ONCE (one list-windows), NOT a per-target pane probe — a per-target read flaps under tmux load and
# momentarily drops a REAL target, which would FALSE-REJECT a valid addressee. And if that one read comes
# back EMPTY (tmux contention / no session), we FAIL OPEN to the declared set rather than reject everyone:
# a false reject (refusing to deliver to a real mind) is the harm to avoid; a false accept just means the
# message still lands in the chat. We deliberately dropped the "≥2 panes = has a mind" check — the default
# targets are curated mind channels, and mesh-tell delivers to the bottom pane regardless.
default_chat_targets="minds genome tg senses health room"
CHAT_TARGETS="${MESH_CHAT_TARGETS:-$default_chat_targets}"
valid_targets(){
  local lw t; lw="$(tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null)"
  [ -z "$lw" ] && { printf '%s\n' $CHAT_TARGETS; return; }   # tmux read failed → fail OPEN (don't false-reject)
  lw=" $(printf '%s ' $lw) "
  for t in $CHAT_TARGETS; do case "$lw" in *" $t "*) echo "$t" ;; esac; done
}
target_exists(){ valid_targets | grep -qx "$1"; }

append_log(){
  local line="$1"
  if command -v mesh-log-scrub &>/dev/null; then
    if ! printf '%s\n' "$line" | mesh-log-scrub >> "$LOG"; then
      echo "WARN: mesh-log-scrub failed — appending raw" >&2
      printf '%s\n' "$line" >> "$LOG"
    fi
  else
    echo "WARN: mesh-log-scrub not found — appending raw" >&2
    printf '%s\n' "$line" >> "$LOG"
  fi
}

# HARD idle-length cap (chat-review/idle-hardcap, 2026-06-24). Doctrine: "[idle] is ONE LINE" — verbose
# idles are the board's single largest noise source (CLAUDE.md; median idle ~980 chars). The SOFT warn
# (idle-length-guard, 2026-06-21) was IGNORED — minds tripped it repeatedly — so this ENFORCES the cap:
# an [idle] body over the cap is TRIMMED (to a word boundary + a marker) for the BOARD, and its FULL text
# is tee'd to the overflow tier (~/.mesh/chat-overflow.log) so NOTHING is lost (trim-with-overflow, NOT
# reject — coordination traffic is never dropped). [idle]-ONLY: [fyi]/[done]/[task]/[verify] legitimately
# run long and are NEVER capped. Tunable: MESH_CHAT_IDLE_CAP_CHARS (default 200). Returns the body to post.
IDLE_CAP="${MESH_CHAT_IDLE_CAP_CHARS:-200}"
idle_cap(){ # <body> → (possibly trimmed) body on stdout; full text tee'd to overflow when it was trimmed
  local body="$1"
  case "$body" in '[idle]'*) : ;; *) printf '%s' "$body"; return 0 ;; esac   # cap [idle] ONLY
  [ "${#body}" -le "$IDLE_CAP" ] && { printf '%s' "$body"; return 0; }        # within cap → untouched
  # over cap → archive the FULL line to the overflow tier (SCRUBBED, like the board — never an unscrubbed
  # sink), then trim for the board
  { printf '%s  %s  ::  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$WHO" "$body" \
      | { command -v mesh-log-scrub >/dev/null 2>&1 && mesh-log-scrub || cat; } ; } >> "$MESH_DIR/chat-overflow.log" 2>/dev/null || true
  local mark=' ...[+overflow]' keep head wb
  keep=$(( IDLE_CAP - ${#mark} )); [ "$keep" -lt 1 ] && keep="$IDLE_CAP"
  head="${body:0:keep}"
  wb="${head% *}"                                   # back off to the last word boundary…
  [ "${#wb}" -ge $(( keep / 2 )) ] && head="$wb"    # …but ONLY if it keeps most of the budget (a long
                                                    # unbroken idle has just the post-'[idle]' space →
                                                    # word-backoff would collapse to '[idle]'; hard-cut instead)
  echo "NOTE: [idle] was ${#body} chars (> ${IDLE_CAP}) — TRIMMED to the board; full text saved to chat-overflow.log. Use [fyi] for detail." >&2
  printf '%s%s' "$head" "$mark"
}

# IDLE DEDUPE (chat-review/idle-dedupe, owner mesh-chat 2026-06-24). Doctrine: "[idle] is ONE LINE,
# one per idle transition" — a mind re-posting a byte-identical [idle] across ticks (state unchanged)
# is the board's single largest noise source. This SUPPRESSES a repeat: if the new post is an [idle]
# line AND its body is byte-identical to THIS mind's most recent post, it is NOT appended (the first
# [idle] stands until the state — i.e. the body text — actually changes). Append-only is preserved:
# we never rewrite the kept line, so there is no in-place "counter" (that would mutate a logged line
# and risk a torn read); instead the suppressed caller is told on STDERR how many identical repeats
# have now been swallowed, which is the feedback a counter would give without touching the log. Scoped
# to [idle] only (substantive markers — [done]/[fyi]/[verify]/… — are NEVER deduped, even if repeated).
# Compares against the last line authored by THIS $WHO (interleaved posts from other minds don't reset
# it — A's repeat is A's repeat). Safe split on the "  ::  " delimiter: the post body has already been
# `tr -s ' '`-squeezed (no double-space can occur inside a body), so `${line##*  ::  }` yields the body
# exactly. Disable per-node with MESH_CHAT_DEDUPE=0. Returns 0 = post it, 1 = suppressed (skip append).
# WHY it fired 0/53 (chat-review/idle-hardcap audit 2026-06-24): it is NOT broken — byte-equality is just
# rarely met because minds REWORD each idle (every repost differs by a few chars), so the exact-repeat case
# this correctly guards seldom occurs. KEPT (a correct guard; removing loses lazy-exact-repeat protection),
# and it is now MORE effective: idle_cap() above trims every over-cap [idle] to a normalized ≤cap form, so
# two reposts of the SAME long idle become byte-identical after the trim → dedupe NOW catches them. The
# over-LONG-idle noise (the actual problem) is handled by idle_cap's hard cap, not by this dedupe.
# idle_sig — the STRUCTURED STATE-KEY of an [idle] body (chat-review/idle-statekey-dedupe, 2026-06-25).
# The prior version stripped volatile TOKENS but KEPT the free prose, so a reworded same-state idle stayed
# byte-unique and every one appended — idles became the board's #1 noise (102/220 lines; minds reword the
# SAME '0-task/0-claim/green' status four ways in 30min and all land). We now canonicalize an [idle] to ONLY
# its decision-bearing state — open-task count + active-claim count + health/degrade tier — and dedupe on
# THAT alone; the narrative garnish ('minds idle too', 'no deltas since 12:24', cross-window events, running
# totals, hashes, temps) is DISCARDED. A count absent from the prose defaults to 0 (an idling mind states a
# non-zero count when it matters; the noise is all zero-state green idles). Tier = the first explicit self-
# degrade word, else 'green' — so green↔degraded and 0↔N count changes still post as REAL new state.
# Over-suppressing a status-yield [idle] is low-harm BY DOCTRINE: a real finding belongs in a marker
# ([done]/[fyi]/[task]/[verify]), which is NEVER deduped; under-suppression (the leak) was the actual bug.
idle_sig(){
  local b tasks claims tier; b="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  # open-task count: "<N> [open/…] task[s]" (digits bar cross-spanning); "no/zero tasks" → 0; default 0
  tasks="$(printf '%s' "$b" | grep -oE '[0-9]+[ /a-z-]*task' | grep -oE '^[0-9]+' | head -1)"
  case "$b" in *'no task'*|*'no open task'*|*'zero task'*) tasks=0 ;; esac
  # active-claim count: "<N> claim[s]" — the combined "tasks/claims" shares its leading count; "no claims" → 0
  claims="$(printf '%s' "$b" | grep -oE '[0-9]+[ /a-z-]*claim' | grep -oE '^[0-9]+' | head -1)"
  case "$b" in *task/claim*|*tasks/claims*) [ -z "$claims" ] && claims="${tasks:-0}" ;; esac
  case "$b" in *'no claim'*|*'zero claim'*) claims=0 ;; esac
  # tier: first explicit self-degrade word, else green. Extracted ONLY from the LEADING CLAUSE — a genuine
  # status tier ALWAYS leads an idle (right after the self-label: "minds: DEGRADED …", "chat — green …"),
  # while degrade-words in cross-window NARRATIVE always TRAIL ("… real DEGRADED→degraded", "… algedonic
  # false-CRITICAL self-fixed"). Scanning the whole body let a trailing narrative degrade-word poison an
  # otherwise-green idle's key, so a later clean green idle didn't dedupe — the #1 board-noise leak, recurring
  # through ever-narrower regex holes (e8f7455 hyphen-compound, 7b975c3 space-anchor). Leading-clause scope is
  # the structural fix. The clause boundary is the FIRST ';' (always a narrative separator) PLUS a 6-word cap
  # (status sits within the first ~4 tokens regardless of which convention; comma-only narrative trails past
  # word 6). The em-dash is deliberately NOT a cut point — it is overloaded (status/narrative sep in "who:
  # STATUS — …" but who/status sep in "who — STATUS …"), so cutting on it would drop a real leading STATUS.
  # SPACE-anchor kept as defense-in-depth (blocks 'oom'-in-'room' + hyphen-compound narrative within the head).
  local head; head="${b%%;*}"; head="$(printf '%s' "$head" | tr -s '[:space:]' ' ' | cut -d' ' -f1-6)"
  tier="$(printf '%s' "$head" | grep -oE '(^|[[:space:]])(degraded|warn|critical|throttl|unhealthy|oom|blocked|stale|uncertain|partial|offline)' | sed -E 's/^[[:space:]]+//' | head -1)"
  printf 'tasks=%s|claims=%s|tier=%s' "${tasks:-0}" "${claims:-0}" "${tier:-green}"
}
# IDLE DEDUPE — now SEMANTIC (chat-review/idle-semantic-dedupe, 2026-06-25). Suppress an [idle] whose
# state-SIGNATURE (idle_sig: volatile tokens stripped) matches THIS mind's last [idle] — so a reworded-or-
# recounted-but-unchanged idle stops appending. Strict superset of the old byte-equality (identical bytes →
# identical sig). Compares against this WHO's last [IDLE] specifically (an interleaved [done]/[fyi] doesn't
# reset it — the task is "same state as my last idle?"). Append-only preserved (kept line never rewritten;
# the swallow count lives in a per-WHO sidecar reported on STDERR). [idle]-ONLY. Disable: MESH_CHAT_DEDUPE=0.
idle_dedupe(){
  local body="$1"
  [ "${MESH_CHAT_DEDUPE:-1}" = 0 ] && return 0
  [ "${body#\[idle\]}" != "$body" ] || return 0        # only dedupe [idle] posts
  local sig; sig="$(idle_sig "$body")"
  local who_tag; who_tag="$(printf '%s' "$WHO" | tr -c 'A-Za-z0-9' _)"
  # (1) CONSECUTIVE dedupe (existing): identical state-key as THIS who's LAST [idle] in the log → swallow.
  if [ -f "$LOG" ]; then
    local last last_body
    last="$(grep -aF "  $WHO  ::  [idle]" "$LOG" 2>/dev/null | tail -1)"   # this mind's last [idle]
    if [ -n "$last" ]; then
      last_body="${last##*  ::  }"                      # strip date+who+delim → body (no double-space inside)
      if [ "$sig" = "$(idle_sig "$last_body")" ]; then  # same-state (byte-identical OR reworded/recounted)
        local cf; cf="$MESH_DIR/.idle-dedupe.$who_tag"
        local n; n=$(( $(cat "$cf" 2>/dev/null || echo 1) + 1 )); printf '%s' "$n" > "$cf" 2>/dev/null
        echo "NOTE: same-state [idle] suppressed (×$n unchanged repeats; first still stands; reworded counts/timestamps don't count as new state) — post a NEW state or stay silent. MESH_CHAT_DEDUPE=0 to disable." >&2
        return 1
      fi
    fi
  fi
  # (2) HEARTBEAT TTL gate (idle-heartbeat-ttl): the consecutive check only catches a same-key repeat of the
  # IMMEDIATELY-preceding idle — a WHO whose key briefly changes then RETURNS (oscillation), or whose run is
  # otherwise reset, still re-posts an unchanged state. So also suppress an identical state-key this WHO
  # already EMITTED within the cadence window, regardless of what posted in between. A CHANGED sig is never in
  # the ledger → emits immediately; the SAME sig re-emits only once its window elapses (a real heartbeat, not
  # noise). Per-(who,sig) last-emit epochs live in a small bounded ledger. Tunable; MESH_CHAT_IDLE_TTL_S=0 off.
  local ttl="${MESH_CHAT_IDLE_TTL_S:-1200}"
  case "$ttl" in ''|*[!0-9]*) ttl=1200 ;; esac
  if [ "$ttl" -gt 0 ]; then
    local tf now last_emit age
    tf="$MESH_DIR/.idle-ttl.$who_tag"
    now="$(date +%s)"
    last_emit="$(awk -F'\t' -v s="$sig" '$2==s{e=$1} END{if(e!="")print e}' "$tf" 2>/dev/null)"
    if [ -n "$last_emit" ]; then
      age=$(( now - last_emit ))
      if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ]; then
        echo "NOTE: same-state [idle] suppressed (heartbeat TTL: identical state-key '$sig' last emitted ${age}s ago, < ${ttl}s window — board stays silent until the state changes or the window elapses). MESH_CHAT_IDLE_TTL_S=0 to disable." >&2
        return 1
      fi
    fi
    # EMIT path: stamp this sig's emit time so the next identical one is gated; keep the ledger bounded.
    { printf '%s\t%s\n' "$now" "$sig" >> "$tf"; } 2>/dev/null
    if [ "$(wc -l < "$tf" 2>/dev/null || echo 0)" -gt 50 ]; then
      tail -n 50 "$tf" > "$tf.tmp" 2>/dev/null && mv "$tf.tmp" "$tf" 2>/dev/null
    fi
  fi
  return 0
}

case "${1:-}" in
  --test)
    # Real dry-run of the load-bearing logic (was: only `[ -f LOG ] && [ -w LOG ]`, which passes even
    # if the multi-line→one-line collapse or the view's dated-line filter is broken — the two behaviours
    # that actually keep the board readable). Sandboxed in a temp MESH_DIR: NO write to the real board.
    # Existing tests below drive MESH_WHO directly to exercise dedupe/etc — self-derive would
    # clobber those synthetic identities if this pane happens to be TMUX-attached, so it's off
    # for the whole suite except the dedicated self-derive test (8.) which re-enables it locally.
    export MESH_CHAT_SELFDERIVE=0
    command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep — view filter dead)"; exit 1; }
    command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
    [ -f "$LOG" ] && [ -w "$LOG" ] || { echo "smoke-test: FAIL (real chat.log not writable)"; exit 1; }
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    # 1. a MULTI-LINE post must collapse to exactly ONE dated line (else continuations scatter the board)
    MESH_DIR="$_td" "$0" "$(printf 'alpha\nbeta\tgamma')" >/dev/null 2>&1
    _n=$(wc -l < "$_td/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "1" ] || { echo "smoke-test: FAIL (multi-line post didn't collapse to 1 line: got $_n)"; exit 1; }
    grep -qE '^[0-9]{4}-[0-9T:-]+Z  .*::  alpha beta gamma$' "$_td/chat.log" \
      || { echo "smoke-test: FAIL (post not dated/collapsed: $(cat "$_td/chat.log"))"; exit 1; }
    # 2. the view filter must KEEP the dated post and DROP a non-dated junk fragment
    printf 'JUNK fragment with no timestamp\n' >> "$_td/chat.log"
    _view="$(MESH_DIR="$_td" "$0" --tail 50)"
    printf '%s\n' "$_view" | grep -q 'alpha beta gamma' \
      || { echo "smoke-test: FAIL (view dropped a valid dated line)"; exit 1; }
    printf '%s\n' "$_view" | grep -q 'JUNK fragment' \
      && { echo "smoke-test: FAIL (view kept a non-dated junk line — filter broken)"; exit 1; }
    # 3. TARGETED-SEND validation: an unknown addressee must ERROR (exit 2) and post NOTHING (operator's
    #    one rule — fail fast, not silent-ignore). Use a definitely-bogus target so it fails regardless of
    #    which windows are live. Assert the sandbox log did NOT grow.
    _before=$(wc -l < "$_td/chat.log" 2>/dev/null || echo 0)
    MESH_DIR="$_td" "$0" --to __nope__ "should not post" >/dev/null 2>&1
    _rc=$?
    [ "$_rc" = "2" ] || { echo "smoke-test: FAIL (--to unknown target should exit 2, got $_rc)"; exit 1; }
    _after=$(wc -l < "$_td/chat.log" 2>/dev/null || echo 0)
    [ "$_before" = "$_after" ] || { echo "smoke-test: FAIL (--to unknown target POSTED — must post nothing)"; exit 1; }
    # 4. HARDCAP (chat-review/idle-hardcap): an over-cap [idle] is TRIMMED to ≤cap on the board, STILL posts
    #    (trim-not-reject), full text tee'd to overflow; a short [idle] is untouched; a long [fyi] is NEVER capped.
    _before=$(wc -l < "$_td/chat.log" 2>/dev/null || echo 0)
    # realistic word filler (NOT a repeated single char — that trips mesh-log-scrub's secret redaction);
    # 'ZTAIL' is a unique sentinel at the very END so it lands in overflow but is trimmed off the board.
    _fill="$(for i in $(seq 1 55); do printf 'w%02d ' "$i"; done)"   # 'w01 w02 … w55 ' ≈ 220 chars
    _long="[idle] ${_fill}ZTAIL"
    # DEDUPE=0 here: this probe is about the hardcap TRIM, not dedupe — and the over-cap + short idles below
    # are both zero-state green, which the structured-key dedupe (correctly) collapses; isolate so trimming
    # is what's measured (dedupe has its own tests 5/5b/5c).
    _err="$(MESH_DIR="$_td" MESH_CHAT_DEDUPE=0 "$0" "$_long" 2>&1 >/dev/null)"
    _after=$(wc -l < "$_td/chat.log" 2>/dev/null || echo 0)
    [ "$_after" -gt "$_before" ] || { echo "smoke-test: FAIL (over-cap [idle] did not post — must TRIM, not reject)"; exit 1; }
    _bl="$(grep -a '  ::  \[idle\] w01' "$_td/chat.log" | tail -1)"; _bl="${_bl##*  ::  }"
    { [ -n "$_bl" ] && [ "${#_bl}" -le "${MESH_CHAT_IDLE_CAP_CHARS:-200}" ]; } || { echo "smoke-test: FAIL (over-cap [idle] not trimmed to ≤cap on board: '${#_bl}')"; exit 1; }
    grep -aq 'ZTAIL' "$_td/chat-overflow.log" || { echo "smoke-test: FAIL (full [idle] text not preserved in overflow tier — sentinel missing)"; exit 1; }
    printf '%s' "$_bl" | grep -q 'ZTAIL' && { echo "smoke-test: FAIL (board line NOT trimmed — tail sentinel still present)"; exit 1; }
    printf '%s' "$_err" | grep -q 'TRIMMED' || { echo "smoke-test: FAIL (over-cap [idle] gave no trim NOTE on stderr)"; exit 1; }
    _mid="all green nothing new this tick holding terse one liner"   # ≤ cap → must pass untouched
    MESH_DIR="$_td" MESH_CHAT_DEDUPE=0 "$0" "[idle] $_mid" >/dev/null 2>&1
    grep -aq "\[idle\] $_mid\$" "$_td/chat.log" || { echo "smoke-test: FAIL (short [idle] wrongly trimmed)"; exit 1; }
    _fyi="$(for i in $(seq 1 55); do printf 'f%02d ' "$i"; done)FYEND"   # long [fyi] must pass untouched
    MESH_DIR="$_td" "$0" "[fyi] $_fyi" >/dev/null 2>&1
    grep -aq 'FYEND' "$_td/chat.log" || { echo "smoke-test: FAIL (long [fyi] wrongly capped — cap must be [idle]-only)"; exit 1; }
    # 5. IDLE DEDUPE: a same-state consecutive [idle] from the same mind is suppressed (not appended);
    #    a CHANGED [idle] posts; a repeated NON-[idle] marker is never deduped; MESH_CHAT_DEDUPE=0 disables.
    _dd="$(mktemp -d)"; export MESH_WHO="ddtest@host"
    MESH_DIR="$_dd" "$0" "[idle] alpha state" >/dev/null 2>&1            # 1st idle → lands
    _err="$(MESH_DIR="$_dd" "$0" "[idle] alpha state" 2>&1 >/dev/null)"  # identical → suppressed
    _n=$(grep -c 'alpha state' "$_dd/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "1" ] || { echo "smoke-test: FAIL (identical [idle] not deduped: $_n copies)"; rm -rf "$_dd"; exit 1; }
    printf '%s' "$_err" | grep -q 'same-state \[idle\] suppressed' || { echo "smoke-test: FAIL (dedupe did not NOTE on stderr)"; rm -rf "$_dd"; exit 1; }
    MESH_DIR="$_dd" "$0" "[idle] beta state, 1 open task" >/dev/null 2>&1   # real state change (tasks 0→1) → lands
    grep -q 'beta state' "$_dd/chat.log" || { echo "smoke-test: FAIL (changed [idle] was wrongly suppressed)"; rm -rf "$_dd"; exit 1; }
    # 5b. SEMANTIC dedupe: an [idle] differing ONLY in volatile tokens (running 'N done' total, a timestamp,
    #     a commit hash) is the SAME state → suppressed; a real count change (claims/open-tasks) → posts.
    _sd="$(mktemp -d)"; export MESH_WHO="sigtest@host"
    MESH_DIR="$_sd" "$0" "[idle] board healthy (47 done, 0 claims), ambient STABLE 01:11Z" >/dev/null 2>&1
    _err="$(MESH_DIR="$_sd" "$0" "[idle] board healthy (52 done, 0 claims), ambient STABLE 01:24Z" 2>&1 >/dev/null)"
    _n=$(grep -c 'board healthy' "$_sd/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "1" ] || { echo "smoke-test: FAIL (reworded-but-unchanged [idle] not semantically deduped: $_n)"; rm -rf "$_sd"; exit 1; }
    printf '%s' "$_err" | grep -q 'same-state \[idle\] suppressed' || { echo "smoke-test: FAIL (semantic dedupe gave no NOTE)"; rm -rf "$_sd"; exit 1; }
    MESH_DIR="$_sd" "$0" "[idle] board healthy (52 done, 2 claims), ambient STABLE 01:30Z" >/dev/null 2>&1   # claims 0→2 = real change
    _n=$(grep -c 'board healthy' "$_sd/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (real claim-count change wrongly suppressed: $_n)"; rm -rf "$_sd"; exit 1; }
    unset MESH_WHO; rm -rf "$_sd"
    # 5c. STRUCTURED state-key (chat-review/idle-statekey-dedupe): two idles with WHOLLY DIFFERENT prose +
    #     cross-window narrative but the SAME state (0 tasks / 0 claims / green) collapse to ONE; a tier
    #     change (green→degraded) and a count change still post as a real new state.
    _sk="$(mktemp -d)"; export MESH_WHO="sktest@host"
    MESH_DIR="$_sk" "$0" "[idle] minds: green — tree clean, 0 open tasks, genome self-driving, all windows idle-green" >/dev/null 2>&1
    _err="$(MESH_DIR="$_sk" "$0" "[idle] minds: converged, 0 tasks/claims, no new board activity since earlier, chat idle too" 2>&1 >/dev/null)"
    _n=$(grep -c '  ::  \[idle\] minds:' "$_sk/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "1" ] || { echo "smoke-test: FAIL (reworded same-state idle not collapsed by structured key: $_n)"; rm -rf "$_sk"; exit 1; }
    printf '%s' "$_err" | grep -q 'same-state \[idle\] suppressed' || { echo "smoke-test: FAIL (structured-key dedupe gave no NOTE)"; rm -rf "$_sk"; exit 1; }
    MESH_DIR="$_sk" "$0" "[idle] minds: DEGRADED — egress WARN, 0 tasks" >/dev/null 2>&1   # tier green→degraded = real change
    _n=$(grep -c '  ::  \[idle\] minds:' "$_sk/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (tier change green→degraded wrongly suppressed: $_n)"; rm -rf "$_sk"; exit 1; }
    MESH_DIR="$_sk" "$0" "[idle] minds: green again, 2 open tasks queued" >/dev/null 2>&1   # task-count 0→2 = real change
    _n=$(grep -c '  ::  \[idle\] minds:' "$_sk/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "3" ] || { echo "smoke-test: FAIL (open-task count change 0→2 wrongly suppressed: $_n)"; rm -rf "$_sk"; exit 1; }
    unset MESH_WHO; rm -rf "$_sk"
    # 5d. NARRATIVE degrade-word must NOT poison the tier: a green idle that merely NARRATES a past degrade
    #     in a hyphen-compound ('false-CRITICAL fix landed') is still tier=green and dedupes against a clean
    #     green idle — else any idle mentioning past work leaks. (The real leak observed live, 2026-06-25.)
    _sn="$(mktemp -d)"; export MESH_WHO="narr@host"
    MESH_DIR="$_sn" "$0" "[idle] minds: green — 0 tasks, all nominal" >/dev/null 2>&1
    _err="$(MESH_DIR="$_sn" "$0" "[idle] minds: green — 0 tasks, the algedonic false-CRITICAL fix landed, board reconverged" 2>&1 >/dev/null)"
    _n=$(grep -c '  ::  \[idle\] minds:' "$_sn/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "1" ] || { echo "smoke-test: FAIL (narrative degrade-word 'false-CRITICAL' poisoned tier → idle not deduped: $_n)"; rm -rf "$_sn"; exit 1; }
    unset MESH_WHO; rm -rf "$_sn"
    # 5e. SPACE-LED trailing narrative degrade-word must NOT poison the tier either — the case 7b975c3's
    #     space-anchor MISSED (it only blocked hyphen-compounds): a standalone 'DEGRADED' in TRAILING prose
    #     ('… real DEGRADED→degraded …') is still tier=green because it's past the leading clause. Closed by
    #     leading-clause scope. (The recurrence chat [verify]'d live, 2026-06-25 13:16.)
    _se="$(mktemp -d)"; export MESH_WHO="trail@host"
    MESH_DIR="$_se" "$0" "[idle] chat — green, 0 tasks/claims" >/dev/null 2>&1
    _err="$(MESH_DIR="$_se" "$0" "[idle] chat — green, 0 tasks/claims; tier-extraction verify closed, re-verified from source (narrative green, real DEGRADED to degraded), loop done" 2>&1 >/dev/null)"
    _n=$(grep -c '  ::  \[idle\] chat' "$_se/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "1" ] || { echo "smoke-test: FAIL (SPACE-LED trailing 'DEGRADED' narrative poisoned tier → green idle not deduped: $_n)"; rm -rf "$_se"; exit 1; }
    # negative twin: a LEADING DEGRADED (real status) still tiers degraded and posts as a new state
    MESH_DIR="$_se" "$0" "[idle] chat — DEGRADED, egress WARN, 1 task" >/dev/null 2>&1
    _n=$(grep -c '  ::  \[idle\] chat' "$_se/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (real LEADING-clause DEGRADED wrongly suppressed: $_n)"; rm -rf "$_se"; exit 1; }
    unset MESH_WHO; rm -rf "$_se"
    # 5f. HEARTBEAT TTL (idle-heartbeat-ttl): an unchanged state-key re-emitted by the SAME who WITHIN the
    #     cadence window is suppressed EVEN when the immediately-preceding idle differed (oscillation /
    #     counter-reset). KEEPS the consecutive dedupe; ADDS a per-(who,sig) last-emit interval gate. A
    #     CHANGED sig emits immediately; the SAME sig AFTER the window emits again (a real heartbeat); TTL=0
    #     disables the interval gate.
    _tt="$(mktemp -d)"; export MESH_WHO="ttltest@host"
    # changed-sig-always-emits: A(tasks=0) then B(tasks=2, changed) → BOTH land
    MESH_DIR="$_tt" "$0" "[idle] minds: green, 0 open tasks, 0 claims" >/dev/null 2>&1
    MESH_DIR="$_tt" "$0" "[idle] minds: green, 2 open tasks, 0 claims" >/dev/null 2>&1
    _n=$(grep -c '  ::  \[idle\] minds:' "$_tt/chat.log" 2>/dev/null; true); _n=${_n:-0}
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (changed-sig idle wrongly suppressed: $_n)"; rm -rf "$_tt"; exit 1; }
    # same-sig-within-TTL suppressed: post A again. Consecutive lets it through (last idle was B), but the TTL
    #     gate holds it (A emitted <window ago) — proving the gate goes BEYOND the consecutive check.
    _err="$(MESH_DIR="$_tt" "$0" "[idle] minds: green, 0 open tasks, 0 claims" 2>&1 >/dev/null)"
    _n=$(grep -c '  ::  \[idle\] minds:' "$_tt/chat.log" 2>/dev/null; true); _n=${_n:-0}
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (same-sig within TTL not suppressed across an intervening idle: $_n)"; rm -rf "$_tt"; exit 1; }
    printf '%s' "$_err" | grep -q 'heartbeat TTL' || { echo "smoke-test: FAIL (TTL suppression gave no heartbeat-TTL NOTE)"; rm -rf "$_tt"; exit 1; }
    # same-sig-after-TTL emits: a 1s window + 2s wait → the A heartbeat re-emits once its window elapsed.
    MESH_DIR="$_tt" "$0" "[idle] minds: green, 5 open tasks, 0 claims" >/dev/null 2>&1   # C (changed) so A isn't the last idle
    sleep 2
    MESH_DIR="$_tt" MESH_CHAT_IDLE_TTL_S=1 "$0" "[idle] minds: green, 0 open tasks, 0 claims" >/dev/null 2>&1
    _n=$(grep -c '  ::  \[idle\] minds:' "$_tt/chat.log" 2>/dev/null; true); _n=${_n:-0}
    [ "$_n" = "4" ] || { echo "smoke-test: FAIL (same-sig AFTER its TTL window did not re-emit: $_n)"; rm -rf "$_tt"; exit 1; }
    # TTL=0 disables the interval gate: a differing-last A (not consecutive) lands even within the window.
    MESH_DIR="$_tt" "$0" "[idle] minds: green, 9 open tasks, 0 claims" >/dev/null 2>&1   # E (changed)
    MESH_DIR="$_tt" MESH_CHAT_IDLE_TTL_S=0 "$0" "[idle] minds: green, 0 open tasks, 0 claims" >/dev/null 2>&1
    _n=$(grep -c '  ::  \[idle\] minds:' "$_tt/chat.log" 2>/dev/null; true); _n=${_n:-0}
    [ "$_n" = "6" ] || { echo "smoke-test: FAIL (MESH_CHAT_IDLE_TTL_S=0 did not disable the interval gate: $_n)"; rm -rf "$_tt"; exit 1; }
    unset MESH_WHO; rm -rf "$_tt"; export MESH_WHO="ddtest@host"
    MESH_DIR="$_dd" "$0" "[done] same result" >/dev/null 2>&1; MESH_DIR="$_dd" "$0" "[done] same result" >/dev/null 2>&1
    _n=$(grep -c 'same result' "$_dd/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (non-[idle] marker wrongly deduped: $_n)"; rm -rf "$_dd"; exit 1; }
    MESH_DIR="$_dd" MESH_CHAT_DEDUPE=0 "$0" "[idle] beta state, 1 open task" >/dev/null 2>&1   # same state as prior; DEDUPE=0 → still lands
    _n=$(grep -c 'beta state' "$_dd/chat.log" 2>/dev/null || echo 0)
    [ "$_n" = "2" ] || { echo "smoke-test: FAIL (MESH_CHAT_DEDUPE=0 did not disable: $_n)"; rm -rf "$_dd"; exit 1; }
    unset MESH_WHO; rm -rf "$_dd"
    # 6. HELP (chat-review/chat-help-leak): --help / -h must PRINT usage to stdout and POST NOTHING
    #    (the bug: '--help' fell to the *) catch-all and got posted to the board as a message).
    _hd="$(mktemp -d)"   # fresh sandbox: a no-op --help must never CREATE the board log
    _hout="$(MESH_DIR="$_hd" "$0" --help 2>/dev/null)"
    printf '%s' "$_hout" | grep -q 'mesh-chat <message>' || { echo "smoke-test: FAIL (--help did not print usage)"; rm -rf "$_hd"; exit 1; }
    [ ! -s "$_hd/chat.log" ] || { echo "smoke-test: FAIL (--help POSTED to the board — must post nothing)"; rm -rf "$_hd"; exit 1; }
    MESH_DIR="$_hd" "$0" -h 2>/dev/null | grep -q 'mesh-chat <message>' || { echo "smoke-test: FAIL (-h alias did not print usage)"; rm -rf "$_hd"; exit 1; }
    [ ! -s "$_hd/chat.log" ] || { echo "smoke-test: FAIL (-h POSTED to the board — must post nothing)"; rm -rf "$_hd"; exit 1; }
    rm -rf "$_hd"
    # 7. UNRECOGNIZED OPTION: --any-bogus-option must exit 2 and post NOTHING (chat-review/chat-option-fallback-post)
    _ud="$(mktemp -d)"
    MESH_DIR="$_ud" "$0" --bogus-option-here >/dev/null 2>&1
    _rc=$?
    [ "$_rc" = "2" ] || { echo "smoke-test: FAIL (unrecognized option should exit 2, got $_rc)"; rm -rf "$_ud"; exit 1; }
    [ ! -s "$_ud/chat.log" ] || { echo "smoke-test: FAIL (unrecognized option posted to board — must post nothing)"; rm -rf "$_ud"; exit 1; }
    rm -rf "$_ud"
    # 8. SELF-DERIVE (chat-review/chat-self-derive-who): a mismatched inherited MESH_WHO gets
    #    overridden to the pane's real window name + a stderr NOTE; a matching one is left alone
    #    and silent. MESH_CHAT_TEST_WINDOW simulates the pane without needing real tmux.
    # [fyi] (never deduped/capped, unlike [idle]) so this test isolates self-derive from dedupe.
    _sw="$(mktemp -d)"
    _err="$(MESH_DIR="$_sw" MESH_CHAT_SELFDERIVE=1 MESH_CHAT_TEST_WINDOW=pub MESH_WHO="genome@testhost" "$0" "[fyi] mismatch case" 2>&1 >/dev/null)"
    grep -aq '  pub@testhost  ::  \[fyi\] mismatch case$' "$_sw/chat.log" \
      || { echo "smoke-test: FAIL (mismatched MESH_WHO not self-derived to pane window: $(cat "$_sw/chat.log")"; rm -rf "$_sw"; exit 1; }
    printf '%s' "$_err" | grep -q 'MESH_WHO mismatch' \
      || { echo "smoke-test: FAIL (self-derive override gave no NOTE on stderr)"; rm -rf "$_sw"; exit 1; }
    _err="$(MESH_DIR="$_sw" MESH_CHAT_SELFDERIVE=1 MESH_CHAT_TEST_WINDOW=pub MESH_WHO="pub@testhost" "$0" "[fyi] match case" 2>&1 >/dev/null)"
    grep -aq '  pub@testhost  ::  \[fyi\] match case$' "$_sw/chat.log" \
      || { echo "smoke-test: FAIL (matching MESH_WHO wrongly altered)"; rm -rf "$_sw"; exit 1; }
    printf '%s' "$_err" | grep -q 'MESH_WHO mismatch' \
      && { echo "smoke-test: FAIL (matching MESH_WHO wrongly warned)"; rm -rf "$_sw"; exit 1; }
    # non-mind-channel role identity (land@, doctor@, node-care@... — a per-call self-identify
    # prefix, not spawn drift) must survive UNTOUCHED even inside a mismatched pane, or this fix
    # would silently break the dozens of reflex tools that deliberately post under their own name.
    _err="$(MESH_DIR="$_sw" MESH_CHAT_SELFDERIVE=1 MESH_CHAT_TEST_WINDOW=pub MESH_WHO="land@testhost" "$0" "[fyi] role-identity case" 2>&1 >/dev/null)"
    grep -aq '  land@testhost  ::  \[fyi\] role-identity case$' "$_sw/chat.log" \
      || { echo "smoke-test: FAIL (non-mind-channel role identity wrongly self-derived away)"; rm -rf "$_sw"; exit 1; }
    printf '%s' "$_err" | grep -q 'MESH_WHO mismatch' \
      && { echo "smoke-test: FAIL (non-mind-channel role identity wrongly warned)"; rm -rf "$_sw"; exit 1; }
    rm -rf "$_sw"
    echo "smoke-test: ok (post-collapse + dated filter + targeted-send validates addressee + idle HARDCAP [over-cap trimmed+overflow, short untouched, [fyi] uncapped] + idle-dedupe: identical-consecutive + semantic-volatile + STRUCTURED state-key collapses reworded same-state idles while tier/count changes still post + tier from LEADING clause only (trailing narrative degrade-word can't poison a green idle; real leading status still tiers) + heartbeat-TTL interval gate (same-key held within window across an intervening idle, re-emits after window, changed always emits, TTL=0 disables) + --help/-h prints usage posts nothing + unrecognized option checks + self-derive MESH_WHO override scoped to mind channels only: pane-window mismatch corrected, match silent, non-mind role identities (land@/doctor@/...) untouched)"; exit 0 ;;
  # views show only well-formed dated board lines — drops legacy junk + any stray continuation
  # fragments so the chat window shows the real recent board, not noise.
  "")        grep -aE '^[0-9]{2,4}[-:0-9T]*Z ' "$LOG" | tail -n 25 ;;
  --tail)    grep -aE '^[0-9]{2,4}[-:0-9T]*Z ' "$LOG" | tail -n "${2:-25}" ;;
  --watch)   tail -n 60 -F "$LOG" | grep --line-buffered -aE '^[0-9]{2,4}[-:0-9T]*Z ' ;;
  --targets) valid_targets ;;
  --to)
    tgt="${2:-}"; shift 2 2>/dev/null || shift $#
    [ -n "$tgt" ] || { echo "mesh-chat --to: missing <target>. valid: $(valid_targets | tr '\n' ' ')" >&2; exit 2; }
    msg="$*"
    [ -n "$msg" ] || { echo "mesh-chat --to: empty message" >&2; exit 1; }
    # VALIDATE-TARGET-AT-SEND (operator's one rule): unknown addressee → error + who exists, post NOTHING.
    if ! target_exists "$tgt"; then
      echo "mesh-chat --to: no such target '$tgt' — NOT posted. valid targets: $(valid_targets | tr '\n' ' ' | sed 's/ $//')" >&2
      exit 2
    fi
    msg="$(printf '%s' "$msg" | tr '\n\t' '  ' | tr -s ' ')"
    line="$(date -u +%Y-%m-%dT%H:%M:%SZ)  $WHO  ::  [@$tgt] $msg"
    append_log "$line"
    printf '%s\n' "$line"
    # instant best-effort idle-gated delivery now; the cron backstop (mesh-chat-deliver) guarantees
    # at-least-once if the target is busy this instant (cursor just doesn't advance until it lands).
    command -v mesh-chat-deliver >/dev/null 2>&1 && mesh-chat-deliver --once "$tgt" >/dev/null 2>&1 || true
    ;;
  --commons)
    tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION"
    if tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx chat; then
      echo "chat window already live in session $SESSION"
    else
      tmux new-window -t "$SESSION" -n chat "exec $0 --watch"
      echo "chat room opened in window 'chat' of session $SESSION"
    fi
    ;;
  -h|--help)
    # print usage to STDOUT and post NOTHING (chat-review/chat-help-leak: '--help' used to fall through
    # to the *) catch-all below and get POSTED to the board as a message — live bug 22:03:59).
    cat <<'USAGE'
mesh-chat — the node's agent chat room (rendezvous board).

  mesh-chat <message>          post a line (broadcast — drags no one)
  mesh-chat --to <tgt> <msg>   post a TARGETED line + push to <tgt>'s mind (@-mention)
  mesh-chat                    read recent (last 25)
  mesh-chat --tail [N]         read last N
  mesh-chat --watch            follow live
  mesh-chat --targets          list valid delivery targets
  mesh-chat --commons          open/ensure the 'chat' window in the node's tmux session
  mesh-chat --test             smoke test
  mesh-chat -h | --help        this help

Sender shown on the board = $MESH_WHO (falls back to $USER@$(hostname)).
USAGE
    ;;
  *)
    # Reject unrecognized options starting with - or -- instead of posting them (chat-review/chat-option-fallback-post)
    if [[ "${1:-}" == -* ]]; then
      echo "mesh-chat: unrecognized option '$1'" >&2
      exit 2
    fi
    # ONE line per post: collapse embedded newlines/tabs to spaces. A multi-line post (table, paths,
    # multi-line report) otherwise becomes several log lines whose continuations have no timestamp —
    # chat-sync's sort then scatters them to the board's tail and the chat window shows junk.
    msg="$(printf '%s' "$*" | tr '\n\t' '  ' | tr -s ' ')"
    msg="$(idle_cap "$msg")"   # ENFORCE the [idle] one-line cap: trim over-long [idle] for the board, full text → overflow tier
    idle_dedupe "$msg" || exit 0   # swallow a byte-identical consecutive [idle] from this mind (exit clean) — trim above normalizes long idles so reposts now dedupe
    # posting a NON-suppressed [idle] means the state changed (or it's the first) → reset the run counter
    [ "${msg#\[idle\]}" != "$msg" ] && rm -f "$MESH_DIR/.idle-dedupe.$(printf '%s' "$WHO" | tr -c 'A-Za-z0-9' _)" 2>/dev/null
    line="$(date -u +%Y-%m-%dT%H:%M:%SZ)  $WHO  ::  $msg"
    append_log "$line"
    printf '%s\n' "$line"
    ;;
esac
