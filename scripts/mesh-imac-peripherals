#!/usr/bin/env bash
# orphan-ok: on-demand callee — new organ, no consumer wired yet (discover find 2026-07-22)
# mesh-imac-peripherals — Bluetooth peripheral BATTERY sense over the SSH organ.
# One SSH round-trip: `system_profiler SPBluetoothDataType`, parsed for CONNECTED devices
# that report a Battery Level (Apple Wireless Keyboard / Magic Mouse / Trackpad — Apple's
# own peripherals expose battery over the classic-BT HID profile; audio/phone pairings in
# the same output never carry Battery Level and are skipped). A genuinely new sense: no
# existing organ (mesh-imac-input reads HID idle-time + display power, not peripheral
# battery) reads this axis. Read-only, no consent needed (operator's own paired hardware).
#
# Output (one line per PAIRED peripheral this read could identify):
#   [imac-peripheral] addr=7C-C3-A1-8C-26-6B name="Apple Wireless Keyboard" battery=62 low=no
#   [imac-peripheral] addr=28-11-A5-B8-9E-A2 name="Bose Revolve SoundLink" battery=na low=na reason=disconnected
#
# THE SUBJECT IS THE ADDRESS, NOT THE NAME (biosemiotics landing 2026-08-22; review:
# docs/reviews/biosemiotics-dicisign-subject-index-vs-predicate-imac-peripherals-2026-08-22.md).
# Peirce's DICISIGN — the simplest sign that can be TRUE or FALSE — is composite by necessity: an
# INDEXICAL part that picks out WHICH object the sign is about, and an ICONIC part that says what is
# the case of it. Both, separately identifiable, or the sign cannot be false about a PARTICULAR
# thing. This tool used to emit a measured predicate (battery=62) attached to a subject that was a
# human-typed NICKNAME the operator can change in macOS System Settings — so a rename read as a new
# device, two peripherals sharing a name collapsed onto one utterance, and no reading could be tied
# to the same object across time (no drain rate, no "this one went quiet"). The Address was parsed
# and thrown away. It is now the subject and the name is demoted to a label.
#
# And the predicate is now allowed to be ABSENT WITHOUT THE SUBJECT VANISHING. Devices that are
# Connected: No, or connected but carrying no Battery Level, used to be dropped silently — which is
# exactly the wrong failure direction for a battery sense: a peripheral whose battery dies
# DISCONNECTS, so the old reading went silent precisely at the event it exists to predict, and that
# silence was indistinguishable from "never paired". Such a device now renders battery=na with the
# REASON, never 0 and never omitted.
#
# Exit codes (honest-exit contract):
#   0 = real read from the iMac (0 or more peripherals reported — a genuinely empty
#       paired-set is not a failure, e.g. nothing paired at all right now)
#   2 = iMac unreachable or parse failed — honest n/a, never a faked reading
#
# Usage:
#   mesh-imac-peripherals          one-shot reading
#   mesh-imac-peripherals --json   machine-readable
#   mesh-imac-peripherals --test   smoke test (parse fixtures + real-read gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
LOW_BATT_PCT="${MESH_IMAC_PERIPH_LOW_PCT:-20}"
MODE=text; [ "${1:-}" = --json ] && MODE=json

read_imac() {
  timeout "${MESH_IMAC_PERIPH_TIMEOUT:-15}" ssh -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "$IMAC_HOST" \
    "system_profiler SPBluetoothDataType 2>/dev/null" \
    </dev/null 2>/dev/null
}

# stdin: raw system_profiler text -> stdout: "addr|name|battery|reason" per identifiable device.
# EVERY device carrying an Address is emitted — the SUBJECT is what makes the utterance possible, the
# predicate is what makes it true or false. A device with no Address has no index and so cannot be a
# subject at all; it is counted (below) and named as such, never dropped in silence.
parse_devices() {
  awk '
    function flush(   r) {
      if (name == "" && addr == "") return
      if (addr == "") { print "|" name "||no-address"; return }
      if (connected != "Yes")    r = "disconnected"
      else if (batt == "")       r = "no-battery-profile"
      else                       r = ""
      print addr "|" name "|" batt "|" r
    }
    /^      Devices \(Paired/ { inDev=1; next }
    /^      Services:/        { if (inDev) { flush(); name=""; addr="" } inDev=0 }
    inDev && /^          [^ ].*:[ \t]*$/ {
      flush()
      name=$0; sub(/^ +/,"",name); sub(/:[ \t]*$/,"",name); connected=""; batt=""; addr=""; next
    }
    inDev && /Address:/ {
      a=$0; sub(/.*Address: */,"",a); sub(/[ \t]*$/,"",a); addr=a
    }
    inDev && /Connected:/ {
      c=$0; sub(/.*Connected: */,"",c); sub(/[ \t]*$/,"",c); connected=c
    }
    inDev && /Battery Level:/ {
      b=$0; sub(/.*Battery Level: */,"",b); sub(/%.*/,"",b); batt=b
    }
    END { if (inDev) flush() }
  '
}

emit() {  # $1=addr(subject) $2=name(label) $3=battery $4=reason
  local low=no batt="$3"
  if [ -z "$batt" ]; then batt=na; low=na
  else
    case "$batt" in (*[!0-9]*) batt=na; low=na ;; (*) [ "$batt" -le "$LOW_BATT_PCT" ] && low=yes ;; esac
  fi
  if [ "$MODE" = json ]; then
    printf '{"addr":"%s","name":"%s","battery":%s,"low":"%s","reason":"%s","ts":"%s"}\n' \
      "$1" "$2" "$([ "$batt" = na ] && echo null || echo "$batt")" "$low" "$4" "$(date -u +%FT%TZ)"
  else
    printf '[imac-peripheral] addr=%s name="%s" battery=%s low=%s%s\n' \
      "$1" "$2" "$batt" "$low" "${4:+ reason=$4}"
  fi
}

run() {
  local raw parsed
  raw="$(read_imac)" || { echo "imac-peripherals: iMac unreachable ($IMAC_HOST) — sense dark, not faked" >&2; return 2; }
  [ -n "$raw" ] || { echo "imac-peripherals: empty read from iMac — sense dark, not faked" >&2; return 2; }
  printf '%s\n' "$raw" | grep -q '^Bluetooth:' || { echo "imac-peripherals: SPBluetoothDataType parse failed (no Bluetooth: header)" >&2; return 2; }
  parsed="$(printf '%s\n' "$raw" | parse_devices)"
  if [ -z "$parsed" ]; then
    # valid read, nothing paired at all right now — honest, not an error
    [ "$MODE" = json ] && echo '[]' || echo "[imac-peripheral] none paired"
    return 0
  fi
  local noidx=0
  while IFS='|' read -r addr name batt reason; do
    [ -n "$addr$name" ] || continue
    if [ -z "$addr" ]; then
      # A device the read could see but could not INDEX. It has no subject, so nothing true or
      # false can be said of it — counted and named, never quietly folded into the others.
      noidx=$((noidx+1)); continue
    fi
    emit "$addr" "$name" "$batt" "$reason"
  done <<<"$parsed"
  [ "$noidx" -gt 0 ] && printf '[imac-peripheral] unindexable=%d (paired device(s) with no Address — no subject, so no reading can be about them)\n' "$noidx"
  return 0
}

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  fail=0
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _scr="${BASH_SOURCE[0]}"

  # Fixture 1: two connected battery-reporting peripherals + one connectionless audio device
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
cat <<'FIX'
Bluetooth:

      Hardware, Features, and Settings:
          Name: iMac - Test
      Devices (Paired, Configured, etc.):
          Apple Wireless Keyboard:
              Address: 7C-C3-A1-8C-26-6B
              Connected: Yes
              Battery Level: 62%
          Розалия - мышь:
              Address: 7C-C3-A1-64-48-D0
              Connected: Yes
              Battery Level: 18%
          Bose Revolve SoundLink:
              Address: 28-11-A5-B8-9E-A2
              Connected: No
      Services:
          Bluetooth File Transfer:
              State: Disabled
FIX
EOF
  chmod +x "$_td/ssh"
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)"
  # The SUBJECT is the Address. Asserted by address, not by name, precisely because the name is the
  # part the operator can change without changing the object.
  printf '%s\n' "$out" | grep -qF '[imac-peripheral] addr=7C-C3-A1-8C-26-6B name="Apple Wireless Keyboard" battery=62 low=no' || { echo "FAIL: keyboard fixture (got: $out)"; fail=1; }
  printf '%s\n' "$out" | grep -qF '[imac-peripheral] addr=7C-C3-A1-64-48-D0 name="Розалия - мышь" battery=18 low=yes' || { echo "FAIL: mouse low-batt fixture (got: $out)"; fail=1; }
  # A disconnected peripheral must remain UTTERABLE with an absent predicate. This assertion is the
  # inversion of the one this tool shipped with ("Bose must not appear") — a battery sense whose
  # subject vanishes when the battery dies goes silent at exactly the event it exists to report.
  printf '%s\n' "$out" | grep -qF '[imac-peripheral] addr=28-11-A5-B8-9E-A2 name="Bose Revolve SoundLink" battery=na low=na reason=disconnected' || { echo "FAIL: a disconnected subject must survive with an na predicate + reason (got: $out)"; fail=1; }
  # RENAME INVARIANCE — the whole point of an indexical subject, driven rather than argued.
  sed 's/Apple Wireless Keyboard/Клавиатура Ильи/' "$_td/ssh" > "$_td/ssh2" && mv "$_td/ssh2" "$_td/ssh" && chmod +x "$_td/ssh"
  out2="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)"
  printf '%s\n' "$out2" | grep -qF 'addr=7C-C3-A1-8C-26-6B name="Клавиатура Ильи" battery=62 low=no' || { echo "FAIL: renamed device must keep its subject (got: $out2)"; fail=1; }
  [ "$(printf '%s\n' "$out"  | grep -c '^\[imac-peripheral\] addr=')" = "$(printf '%s\n' "$out2" | grep -c '^\[imac-peripheral\] addr=')" ] || { echo "FAIL: a rename changed the population of subjects"; fail=1; }
  # A device with NO Address has no index: it is counted and named, never silently folded in.
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
cat <<'FIX'
Bluetooth:

      Devices (Paired, Configured, etc.):
          Nameless Thing:
              Connected: Yes
              Battery Level: 44%
      Services:
FIX
EOF
  chmod +x "$_td/ssh"
  out3="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)"
  printf '%s\n' "$out3" | grep -qF 'unindexable=1' || { echo "FAIL: a subject with no index must be counted and named (got: $out3)"; fail=1; }
  printf '%s\n' "$out3" | grep -q 'battery=44' && { echo "FAIL: a predicate was asserted of a thing the read cannot index (got: $out3)"; fail=1; }

  # Fixture 2: reachable, zero connected battery-reporting peripherals -> honest empty, rc0
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
cat <<'FIX'
Bluetooth:

      Devices (Paired, Configured, etc.):
          Some Phone:
              Connected: No
      Services:
FIX
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)"; rc=$?
  # "Some Phone" is Connected: No and carries no Address -> no subject, so the utterance is the
  # unindexable count, not a peripheral row and not a faked all-clear.
  { [ "$rc" = 0 ] && [ "$out" = "[imac-peripheral] unindexable=1 (paired device(s) with no Address — no subject, so no reading can be about them)" ]; } || { echo "FAIL: zero-peripheral fixture (rc=$rc got: $out)"; fail=1; }

  # Fixture 3: unreachable -> exit 2, no faked reading on stdout
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
exit 255
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: unreachable must exit 2 with empty stdout (rc=$rc out=$out)"; fail=1; }

  # Fixture 4: garbled read (no Bluetooth: header) -> exit 2, never emit garbage
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf 'permission denied\n'
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: garbled read must exit 2 (rc=$rc out=$out)"; fail=1; }

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL (fixtures)"; exit 1; }

  # Real-read gate (verification principle: a live read must produce parseable data or an
  # honest zero-set; unreachable iMac = honest exit 2, never fake green).
  live="$(bash "$_scr" 2>/dev/null)"; live_rc=$?
  if [ "$live_rc" = 0 ]; then
    printf '%s\n' "$live" | grep -qE '^\[imac-peripheral\] (addr=\S+ name="[^"]*" battery=([0-9]+|na) low=(yes|no|na)( reason=\S+)?|unindexable=[0-9]+ .*|none paired)$' || {
      echo "smoke-test: FAIL (live read rc=0 but output malformed: $live)"; exit 1; }
    echo "smoke-test: ok (parse fixtures incl. dicisign subject/predicate split: address-keyed subject, rename-invariant, disconnected subject survives with an na predicate, unindexable named; + live read: $live)"
    exit 0
  else
    echo "smoke-test: n/a — fixtures ok but iMac unreachable (honest exit 2, live read unverified)"
    exit 2
  fi
}

run
