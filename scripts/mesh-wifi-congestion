#!/usr/bin/env bash
# orphan-ok: on-demand RF-air congestion read (mind pulls it when wifi feels slow; live nmcli-cache read, stateless, not scheduled)
# mesh-wifi-congestion — co-channel RF crowding: how contested is OUR channel's air.
# smoke-test: --test runs classifier fixtures + asserts a real cached-scan read parses (exit 2 honest n/a if radio absent/cache empty)
#
# NEW SIGNAL (no existing sense perceives it): the scanners (wifiscan/wifi-motion/wifi-newap/
# anchor-map) use AP identity+RSSI for motion/novelty/location; wifi-quality reads OUR link.
# None derives CHANNEL CONTENTION — how many neighbor APs compete for the same air we transmit
# in, and how loud the strongest rival is. That is the RF-neighborhood signal behind "wifi is
# slow but our link looks fine".
#
# Radio-gentle by design: default reads NM's CACHED scan table (--rescan no — zero radio work;
# the cache is kept warm by mesh-wifiscan's 10-min tape cron + NM background scans). This node's
# radio carries forwarded exit-node traffic, and a rescan goes briefly off-channel (wifiscan
# header, 2026-06-20) — so a fresh scan is opt-in via --fresh (blocking --rescan yes, never a
# hand-rolled rescan+sleep race).
#
# Overlap model: 2.4GHz (ch 1-14) counts co-channel (same ch) + adjacent-overlap (|Δch|<5 —
# 20MHz masks overlap up to 4 channels away). 5/6GHz counts primary-channel matches only
# (40/80MHz secondary-width overlap NOT modeled — undercounts wide-channel rivals; noted, honest).
#
# Verdicts (vocab is a contract — consumers grep these tokens):
#   CLEAR      0 co-channel rivals
#   LIGHT      1-2
#   BUSY       3-5
#   CONGESTED  >=6
#   UNASSOCIATED  radio up, APs visible, but no active AP (no home channel to judge)
#   UNKNOWN    cache empty/hollow (n<sanity-min) or scan unreadable -> exit 2, never a fake CLEAR
#
#   mesh-wifi-congestion            read from NM cache (radio-passive)
#   mesh-wifi-congestion --fresh    force a blocking rescan first (off-channel blip; avoid in tight loops)
#   mesh-wifi-congestion --json     machine-readable
#   mesh-wifi-congestion --test     fixtures + real cached-read gate
#
# exit: 0 = verdict rendered · 2 = honest n/a (no radio / empty-hollow cache)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SANITY_MIN="${WIFI_CONGESTION_SANITY_MIN:-3}"   # below this AP count the cache is a stale miss, not ground truth (wifiscan convention)

# --- pure classifier: verdict from co-channel rival count ---
classify() { # <co_count>
  local c="$1"
  if   [ "$c" -eq 0 ]; then echo CLEAR
  elif [ "$c" -le 2 ]; then echo LIGHT
  elif [ "$c" -le 5 ]; then echo BUSY
  else echo CONGESTED; fi
}

# --- pure fuse: parse nmcli -t rows (ACTIVE:CHAN:SIGNAL:FREQ:SSID, \: pre-squashed) ---
# stdout: "<verdict>|<our_ch>|<our_sig>|<co>|<ovl>|<rival_max>|<total>"
fuse() {
  local rows="$1" total=0 our_ch="" our_sig="" co=0 ovl=0 rival_max=-999
  local active ch sig freq ssid
  while IFS=':' read -r active ch sig freq ssid; do
    [ -z "$ch" ] && continue
    case "$ch" in *[!0-9]*) continue;; esac
    total=$((total+1))
    if [ "$active" = "yes" ] && [ -z "$our_ch" ]; then our_ch="$ch"; our_sig="$sig"; fi
  done <<< "$rows"
  [ "$total" -eq 0 ] && { echo "UNKNOWN||||||0"; return; }
  [ -z "$our_ch" ] && { echo "UNASSOCIATED||||||$total"; return; }
  while IFS=':' read -r active ch sig freq ssid; do
    [ -z "$ch" ] && continue
    case "$ch" in *[!0-9]*) continue;; esac
    [ "$active" = "yes" ] && continue
    if [ "$ch" -eq "$our_ch" ]; then
      co=$((co+1))
      [ "${sig:-0}" -gt "$rival_max" ] 2>/dev/null && rival_max="$sig"
    elif [ "$our_ch" -le 14 ] && [ "$ch" -le 14 ]; then
      local d=$((ch - our_ch)); [ "$d" -lt 0 ] && d=$((-d))
      [ "$d" -lt 5 ] && ovl=$((ovl+1))
    fi
  done <<< "$rows"
  echo "$(classify "$co")|$our_ch|$our_sig|$co|$ovl|$rival_max|$total"
}

# --- test: fixtures (offline) + real cached-read gate ---
if [ "${1:-}" = --test ]; then
  fail=0
  t() { local got want="$2"; got="$(fuse "$1")"; [ "$got" = "$want" ] || { echo "  FAIL: want=$want got=$got"; fail=1; }; }
  # our AP alone on ch 6, one AP far away on ch 11 (no overlap at Δ5)
  t $'yes:6:70:2437:home\nno:11:40:2462:far' "CLEAR|6|70|0|0|-999|2"
  # 2 co-channel rivals -> LIGHT, strongest rival tracked
  t $'yes:6:70:2437:home\nno:6:55:2437:rivalA\nno:6:38:2437:rivalB' "LIGHT|6|70|2|0|55|3"
  # 4 co-channel -> BUSY
  t $'yes:1:60:2412:home\nno:1:50:2412:a\nno:1:40:2412:b\nno:1:30:2412:c\nno:1:20:2412:d' "BUSY|1|60|4|0|50|5"
  # 7 co-channel -> CONGESTED
  t "$(printf 'yes:36:80:5180:home\n'; for i in 1 2 3 4 5 6 7; do printf 'no:36:%s:5180:r%s\n' "$((30+i))" "$i"; done)" "CONGESTED|36|80|7|0|37|8"
  # 2.4GHz adjacent overlap: ch4 vs our ch6 overlaps (|Δ|=2<5), ch11 does not (Δ=5)
  t $'yes:6:70:2437:home\nno:4:50:2427:adj\nno:11:45:2462:far' "CLEAR|6|70|0|1|-999|3"
  # 5GHz: adjacent numbers do NOT overlap-count (only same primary)
  t $'yes:36:70:5180:home\nno:40:60:5200:next' "CLEAR|36|70|0|0|-999|2"
  # radio up but not associated
  t $'no:6:50:2437:a\nno:11:40:2462:b' "UNASSOCIATED||||||2"
  # empty scan -> UNKNOWN, never CLEAR
  t "" "UNKNOWN||||||0"
  [ "$fail" -ne 0 ] && { echo "smoke-test: FAIL (fixtures)"; exit 1; }
  # real hardware read gate: the cached scan table must parse to >=1 row (real NM read, radio-passive).
  # No radio / empty cache -> honest n/a exit 2 (mesh-land treats as pass), NEVER a fake green.
  command -v nmcli >/dev/null 2>&1 || { echo "smoke-test: n/a (no nmcli)"; exit 2; }
  nmcli -t radio wifi 2>/dev/null | grep -q enabled || { echo "smoke-test: n/a (wifi radio absent/disabled)"; exit 2; }
  live="$(timeout 10 nmcli -t -f ACTIVE,CHAN,SIGNAL,FREQ,SSID device wifi list --rescan no 2>/dev/null | sed 's/\\:/@/g')"
  liven="$(printf '%s' "$live" | grep -c '^[a-z]*:[0-9]' || true)"
  [ "${liven:-0}" -ge 1 ] || { echo "smoke-test: n/a (NM scan cache empty — no real rows to assert)"; exit 2; }
  echo "smoke-test: ok (8 fuse fixtures + real cached-scan read: $liven rows)"; exit 0
fi

JSON=0; FRESH=0
for a in "$@"; do case "$a" in --json) JSON=1;; --fresh) FRESH=1;; esac; done

command -v nmcli >/dev/null 2>&1 || { echo "wifi-congestion: UNKNOWN (no nmcli)"; exit 2; }
nmcli -t radio wifi 2>/dev/null | grep -q enabled || { echo "wifi-congestion: UNKNOWN (wifi radio absent/disabled)"; exit 2; }

RESCAN=no; [ "$FRESH" -eq 1 ] && RESCAN=yes
rows="$(timeout 25 nmcli -t -f ACTIVE,CHAN,SIGNAL,FREQ,SSID device wifi list --rescan "$RESCAN" 2>/dev/null | sed 's/\\:/@/g')"

IFS='|' read -r verdict our_ch our_sig co ovl rival_max total <<< "$(fuse "$rows")"

# hollow-cache guard: a near-empty table in a lived-in home is a stale-cache miss (wifiscan SANITY_MIN),
# not a genuinely clear air — render UNKNOWN, never CLEAR-by-blindness
if [ "$verdict" != "UNASSOCIATED" ] && [ "${total:-0}" -lt "$SANITY_MIN" ]; then
  echo "wifi-congestion: UNKNOWN (scan table hollow: $total APs < sanity-min $SANITY_MIN — stale cache or dead air; try --fresh)"
  exit 2
fi

rival_txt="none"; [ "${rival_max:--999}" != "-999" ] && [ -n "$rival_max" ] && rival_txt="${rival_max}%"
if [ "$JSON" -eq 1 ]; then
  printf '{"verdict":"%s","channel":%s,"our_signal":%s,"co_channel":%s,"overlap_24":%s,"strongest_rival":%s,"total_aps":%s,"fresh":%s}\n' \
    "$verdict" "${our_ch:-null}" "${our_sig:-null}" "${co:-null}" "${ovl:-null}" \
    "$([ "$rival_txt" = none ] && echo null || echo "$rival_max")" "${total:-0}" "$FRESH"
else
  if [ "$verdict" = "UNASSOCIATED" ]; then
    echo "wifi-congestion: UNASSOCIATED (radio up, $total APs visible, no active AP — no home channel to judge)"
  else
    echo "wifi-congestion: $verdict (ch $our_ch: $co co-channel rivals, strongest $rival_txt vs ours ${our_sig}%; +$ovl adjacent-overlap; $total APs total$([ "$FRESH" -eq 1 ] && echo ', fresh scan' || echo ', cached'))"
  fi
fi
exit 0
