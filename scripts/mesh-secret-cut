#!/usr/bin/env python3
"""mesh-secret-cut — the ONE way a mind removes a live secret from a log: STORE IT, then POINT AT IT.

  mesh-secret-cut --key MAC_ILYA_PASS --file ~/.mesh/voice-in.log   # value on stdin, never argv
  mesh-secret-cut --audit                                           # who is holding a pointerless cut
  mesh-secret-cut --audit --new-only                                # the wired form: alarm on NEW ones
  mesh-secret-cut --test

# reflex-cadence: 41 9 * * *
# reflex-args: --audit --new-only

WHY THIS TOOL EXISTS, and why it is NOT mesh-log-scrub ({#23a80c22}, measured 2026-08-29).
The incident that commissioned it named the scrubber as the cutter. It was not: mesh-log-scrub is a
pipe filter that matches the SHAPE of a secret, and both lost credentials were ordinary prose
("<name> <password>!"), which it passed through untouched — driven live, and no commit of that file
has ever emitted the `[REDACTED]` marker those lines carry. A HAND cut them, and the hand that did it
said so the same night: "Из логов я его стёр (voice-in.log, textin.log, operator-fyi.log) ... Наш
скруббер его не поймал и не мог". So the rule belongs where the erasure actually happens.

A BARE CUT IS INDISTINGUISHABLE FROM AN INTACT SECRET, and that is the whole cost. `[REDACTED]` reads
identically whether the value is safe in a store or destroyed forever; the difference surfaces at the
first attempt to USE it, which here was NINE DAYS later. One line separates them:
    lost   :  ilya / [REDACTED]!
    kept   :  <REDACTED — stored in ~/.mesh/mail.env MAIL_PASS>
Measured cost of the bare form on this node: the 2026-08-20T10:10 mac credential is gone from every
copy (voice-in.log, operator-fyi.log, textin.log were cut identically) and is recoverable from no
artifact here.

THREE WORDS, because a cut has three outcomes and only one of them is fine:
  POINTED       the marker names a store file and a key    -> the secret is alive
  NOT-STORED    the marker SAYS the value was destroyed     -> a declared loss, visible immediately
  SILENT        a bare marker naming nothing                -> the fault: a loss wearing the look of a save
An unrecognised marker classifies SILENT, never POINTED: the failure direction of a pointer-shape
allowlist is silence, and silence is the thing being fixed.

THE VALUE ARRIVES ON STDIN, NEVER IN ARGV. argv is world-readable in /proc and this mesh's own tools
walk it (mesh-doctor's cmdline census, rq-wait's top line above quotes whole command lines); a secret
passed as a flag is published by the act of cutting it.
"""
import argparse, os, re, sys, glob, stat

HOME = os.path.expanduser("~")
DEFAULT_STORE = os.path.join(HOME, ".mesh", "secrets", "scrubbed.env")
POINTER = "<REDACTED — stored in {store} {key}>"
NOT_STORED = "[REDACTED — NOT STORED]"

# Any marker that CLAIMS a redaction. Deliberately wide: this is the census of cuts, and a marker
# shape nobody taught it must land in SILENT rather than escape the audit entirely.
MARKER = re.compile(r'(\[REDACTED[^\]]*\]|<REDACTED[^>]*>)')
# The shape-based placeholders mesh-log-scrub emits (TOKEN_REDACTED, TSKEY_REDACTED, SK_REDACTED…)
# are NOT in scope: they are a pipe filter's verdict on a string's shape — a slug, a file id, a SHA —
# and there is no operator credential behind them to store. Folding them in would bury the handful of
# real cuts under hundreds of rows and make the audit unreadable, which is how a census stops
# being read. They carry no brackets, so MARKER cannot reach them by construction.


def classify(marker):
    inner = marker[1:-1]
    if re.search(r'stored in\s+\S+\s+\S', inner):
        return "POINTED"
    if "NOT STORED" in inner.upper():
        return "NOT-STORED"
    return "SILENT"


def _store_write(store, key, value):
    """append KEY=value to a 0600 store; returns the path actually written."""
    d = os.path.dirname(store)
    os.makedirs(d, exist_ok=True)
    os.chmod(d, 0o700)
    existing = ""
    if os.path.exists(store):
        existing = open(store, encoding="utf-8", errors="replace").read()
    keyre = re.compile(r'^%s=' % re.escape(key), re.M)
    line = "%s=%s\n" % (key, value)
    if keyre.search(existing):
        out = keyre.sub(lambda m: m.group(0), existing)   # key exists: never silently overwrite
        raise SystemExit("mesh-secret-cut: REFUSE — key %s already in %s; pick another key or edit by hand "
                         "(overwriting would destroy the value this tool exists to keep)" % (key, store))
    fd = os.open(store, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(line)
    os.chmod(store, 0o600)
    return store


def cut(value, key, files, store, pretty_store):
    if not value:
        raise SystemExit("mesh-secret-cut: REFUSE — empty value on stdin (nothing to store, so a cut "
                         "here would only destroy)")
    stored = None
    try:
        stored = _store_write(store, key, value)
    except SystemExit:
        raise
    except OSError as e:
        stored = None
        print("mesh-secret-cut: STORE FAILED (%s) — cutting as %s, the loss is DECLARED not hidden"
              % (e, NOT_STORED), file=sys.stderr)
    repl = POINTER.format(store=pretty_store, key=key) if stored else NOT_STORED
    hits = 0
    for f in files:
        f = os.path.expanduser(f)
        if not os.path.exists(f):
            print("mesh-secret-cut: no such file: %s" % f, file=sys.stderr); continue
        text = open(f, encoding="utf-8", errors="replace").read()
        n = text.count(value)
        if not n:
            print("mesh-secret-cut: value not present in %s" % f, file=sys.stderr); continue
        open(f, "w", encoding="utf-8").write(text.replace(value, repl))
        hits += n
        print("mesh-secret-cut: %s — %d occurrence(s) -> %s" % (f, n, repl))
    if not hits:
        print("mesh-secret-cut: value stored at %s %s but replaced NOWHERE — the log copy you meant is "
              "not in the file list" % (pretty_store, key), file=sys.stderr)
    return 0 if (stored and hits) else 1


BASELINE = os.path.join(HOME, ".mesh", ".secret-cut-baseline")


def _fingerprint(f, ctx):
    import hashlib
    return hashlib.sha256(("%s|%s" % (os.path.basename(f), ctx)).encode("utf-8")).hexdigest()[:16]


def audit(paths, new_only=False):
    rows = []
    for p in paths:
        for f in sorted(glob.glob(os.path.expanduser(p))):
            if not os.path.isfile(f):
                continue
            try:
                fh = open(f, encoding="utf-8", errors="replace")
            except OSError:
                continue
            with fh:
                for i, line in enumerate(fh, 1):
                    for m in MARKER.findall(line):
                        rows.append((classify(m), f, i, m, line.strip()[:90]))
    counts = {"POINTED": 0, "NOT-STORED": 0, "SILENT": 0}
    for r in rows:
        counts[r[0]] += 1
    # A BACKLOG MUST NOT BECOME A STANDING ACCUSATION. This node carries silent cuts made by hand
    # BEFORE the tool existed, and several cannot be repaired honestly: pointing them at a store I
    # merely SUSPECT holds the value would claim a recoverability nobody has verified, which is worse
    # than the bare marker. So a wired run alarms on cuts it has NOT SEEN BEFORE, and carries the
    # backlog in the census line where it stays counted and visible. The baseline is fingerprinted on
    # basename+context, never file:line — every one of these logs is append-only, so a line number
    # moves under any row that predates today's writes.
    known = set()
    if new_only and os.path.exists(BASELINE):
        known = {l.strip() for l in open(BASELINE, encoding="utf-8", errors="replace") if l.strip()}
    fresh = [r for r in rows if r[0] == "SILENT" and _fingerprint(r[1], r[4]) not in known]
    for verdict, f, i, m, ctx in rows:
        if verdict == "SILENT" and (not new_only or _fingerprint(f, ctx) not in known):
            print("SILENT%s %s:%d  %s" % ("(NEW) " if new_only else "      ", f, i, ctx))
    for verdict, f, i, m, ctx in rows:
        if verdict == "NOT-STORED" and not new_only:
            print("NOT-STORED  %s:%d  %s" % (f, i, ctx))
    if new_only:
        seen = known | {_fingerprint(r[1], r[4]) for r in rows if r[0] == "SILENT"}
        try:
            os.makedirs(os.path.dirname(BASELINE), exist_ok=True)
            fd = os.open(BASELINE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write("\n".join(sorted(seen)) + "\n")
        except OSError as e:
            print("mesh-secret-cut: baseline unwritable (%s) — every silent cut will re-alarm next "
                  "run; that is loud, not silent, so it stands" % e, file=sys.stderr)
    print("mesh-secret-cut --audit: %d pointed · %d declared-lost · %d SILENT%s"
          % (counts["POINTED"], counts["NOT-STORED"], counts["SILENT"],
             " (%d of them NEW since the baseline)" % len(fresh) if new_only else ""))
    return 1 if (fresh if new_only else counts["SILENT"]) else 0


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--key")
    ap.add_argument("--file", action="append", default=[])
    ap.add_argument("--store", default=DEFAULT_STORE)
    ap.add_argument("--audit", action="store_true")
    ap.add_argument("--new-only", action="store_true",
                    help="alarm only on silent cuts unseen at the baseline (the wired form)")
    ap.add_argument("--test", action="store_true")
    a = ap.parse_args()
    if a.test:
        return selftest()
    if a.audit:
        paths = a.file or [os.path.join(HOME, ".mesh", "*.log")]
        return audit(paths, new_only=a.new_only)
    if not a.key or not a.file:
        ap.error("--key and at least one --file are required (value comes on stdin)")
    if sys.stdin.isatty():
        ap.error("the secret is read from STDIN, never argv — pipe it in")
    value = sys.stdin.read().rstrip("\n")
    pretty = a.store.replace(HOME, "~")
    return cut(value, a.key, a.file, a.store, pretty)


def selftest():
    import tempfile, subprocess
    fails = []
    self_ = os.path.abspath(__file__)
    with tempfile.TemporaryDirectory() as td:
        # 1) classify: the three words, and the unknown marker fails toward the ALARM
        cases = [("<REDACTED — stored in ~/.mesh/mail.env MAIL_PASS>", "POINTED"),
                 ("[REDACTED — NOT STORED]", "NOT-STORED"),
                 ("[REDACTED]", "SILENT"),
                 ("<REDACTED-CREDENTIAL>", "SILENT"),
                 ("<REDACTED — stored in>", "SILENT")]   # names a store, names no key
        for marker, want in cases:
            got = classify(marker)
            if got != want:
                fails.append("classify(%r) = %s, want %s" % (marker, got, want))
        # 2) END TO END: a real cut stores the value and leaves a pointer that classifies POINTED.
        log = os.path.join(td, "voice-in.log"); store = os.path.join(td, "secrets", "scrubbed.env")
        secret = "Tr0ub4dor&3!"
        open(log, "w").write("2026-01-01T00:00:00Z  TEXT  ilya / %s! for the mac\nunrelated line\n" % secret)
        p = subprocess.run([sys.executable, self_, "--key", "MAC_TEST", "--file", log, "--store", store],
                           input=secret, capture_output=True, text=True)
        body = open(log).read()
        if secret in body:
            fails.append("end-to-end: the secret is STILL in the log after a cut")
        if not os.path.exists(store):
            fails.append("end-to-end: no store written — the cut destroyed the value it promised to keep")
        else:
            if secret not in open(store).read():
                fails.append("end-to-end: the store does not hold the value")
            mode = stat.S_IMODE(os.stat(store).st_mode)
            if mode != 0o600:
                fails.append("end-to-end: store mode is %o, not 0600" % mode)
            ms = MARKER.findall(body)
            if not ms or classify(ms[0]) != "POINTED":
                fails.append("end-to-end: the marker left behind is %r, which does not classify POINTED" % (ms or None))
            if "MAC_TEST" not in body:
                fails.append("end-to-end: the pointer does not name the KEY, so nothing can be looked up")
        # 3) THE STORE FAILING MUST DECLARE THE LOSS, never leave a bare marker. Drive it for real:
        #    a store path under a NON-DIRECTORY cannot be created.
        log2 = os.path.join(td, "l2.log"); open(log2, "w").write("x %s y\n" % secret)
        blocker = os.path.join(td, "blocker"); open(blocker, "w").write("")
        p2 = subprocess.run([sys.executable, self_, "--key", "K2", "--file", log2,
                             "--store", os.path.join(blocker, "sub", "s.env")],
                            input=secret, capture_output=True, text=True)
        b2 = open(log2).read()
        if secret in b2:
            fails.append("store-fail: the secret survived in the log (the cut did not happen at all)")
        elif NOT_STORED not in b2:
            fails.append("store-fail: the cut left %r instead of the declared-loss marker — a destroyed "
                         "value wearing the look of a saved one" % b2.strip())
        if p2.returncode == 0:
            fails.append("store-fail: exited 0, so a caller cannot tell a save from a loss")
        # 4) AUDIT separates the three, and a SILENT row makes it exit non-zero.
        a1 = os.path.join(td, "a1.log")
        open(a1, "w").write("ok <REDACTED — stored in ~/.mesh/x.env K>\nbad [REDACTED]!\ndec [REDACTED — NOT STORED]\n")
        p3 = subprocess.run([sys.executable, self_, "--audit", "--file", a1], capture_output=True, text=True)
        if "1 pointed · 1 declared-lost · 1 SILENT" not in p3.stdout:
            fails.append("audit: wrong census: %r" % p3.stdout)
        if p3.returncode == 0:
            fails.append("audit: a SILENT cut exited 0 — the fault reads as clean")
        if "a1.log:2" not in p3.stdout:
            fails.append("audit: the SILENT row does not carry file:line, so nobody can go look")
        # 4b) --new-only: the FIRST run records the backlog and must NOT alarm on it; a cut added
        #     AFTERWARDS must alarm. Without this arm the wired form would either accuse the node
        #     every night for a pre-existing backlog it cannot repair, or (mutant) go permanently
        #     quiet and never report a new one either.
        a3 = os.path.join(td, "a3.log")
        open(a3, "w").write("old [REDACTED] one\n")
        env = dict(os.environ, HOME=td)
        r1 = subprocess.run([sys.executable, self_, "--audit", "--new-only", "--file", a3],
                            capture_output=True, text=True, env=env)
        # The first run DOES alarm — it has never seen these — and that is deliberate: a backlog gets
        # named exactly ONCE. What must not happen is the run after it repeating the accusation every
        # night for cuts nobody can repair, which is how a gate becomes furniture.
        if r1.returncode == 0:
            fails.append("new-only: the first sighting of a silent cut did not alarm at all: %r" % r1.stdout)
        if "1 SILENT" not in r1.stdout:
            fails.append("new-only: the backlog vanished from the census instead of being carried: %r" % r1.stdout)
        r1b = subprocess.run([sys.executable, self_, "--audit", "--new-only", "--file", a3],
                             capture_output=True, text=True, env=env)
        if r1b.returncode != 0:
            fails.append("new-only: the SAME backlog alarmed a second time — a standing accusation: %r" % r1b.stdout)
        if "1 SILENT" not in r1b.stdout:
            fails.append("new-only: a recorded backlog dropped out of the census, so the loss stops being visible: %r" % r1b.stdout)
        with open(a3, "a") as fh:
            fh.write("fresh [REDACTED] two\n")
        r2 = subprocess.run([sys.executable, self_, "--audit", "--new-only", "--file", a3],
                            capture_output=True, text=True, env=env)
        if r2.returncode == 0:
            fails.append("new-only: a NEW silent cut did not alarm — the wired form is permanently quiet")
        if "fresh" not in r2.stdout or "old [REDACTED] one" in r2.stdout:
            fails.append("new-only: the alarm names the wrong rows: %r" % r2.stdout)
        # 5) THE SCRUBBER'S OWN PLACEHOLDERS ARE OUT OF SCOPE — they carry no brackets, and folding
        #    them in would bury the real cuts.
        a2 = os.path.join(td, "a2.log"); open(a2, "w").write("TOKEN_REDACTED TSKEY_REDACTED SK_REDACTED\n")
        p4 = subprocess.run([sys.executable, self_, "--audit", "--file", a2], capture_output=True, text=True)
        if "0 pointed · 0 declared-lost · 0 SILENT" not in p4.stdout:
            fails.append("scope: shape placeholders were counted as cuts: %r" % p4.stdout)
        # 6) A VALUE ON ARGV IS NOT A THING THIS TOOL ACCEPTS: an empty stdin must refuse, not cut.
        log3 = os.path.join(td, "l3.log"); open(log3, "w").write("y\n")
        p5 = subprocess.run([sys.executable, self_, "--key", "K3", "--file", log3,
                             "--store", os.path.join(td, "s3.env")], input="", capture_output=True, text=True)
        if p5.returncode == 0:
            fails.append("empty-stdin: exited 0 instead of refusing")
        # 7) AN EXISTING KEY IS NEVER OVERWRITTEN — that would destroy a kept secret.
        p6 = subprocess.run([sys.executable, self_, "--key", "MAC_TEST", "--file", log, "--store", store],
                            input="another", capture_output=True, text=True)
        if p6.returncode == 0 or "already in" not in (p6.stdout + p6.stderr):
            fails.append("key-collision: a second cut under the same key was allowed to overwrite")
    if fails:
        for f in fails:
            print("smoke-test: FAIL (%s)" % f)
        return 1
    print("smoke-test: ok (three-word classify incl. unknown-marker->SILENT + end-to-end cut stores 0600 "
          "and points at file+key + store-failure DECLARES the loss and exits non-zero + audit census "
          "with file:line and non-zero on SILENT + scrubber shape-placeholders out of scope + empty "
          "stdin refuses + an existing key is never overwritten + --new-only records a "
          "backlog without accusing it and still alarms on a fresh cut)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
