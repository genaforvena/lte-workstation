#!/usr/bin/env bash
# mesh-location — the mesh's LOCATION sense: read the phone BODY's GPS/network position.
# The phone is the ONLY node with a location sense (laptops/router have none). Registry-resolved
# over SSH (termux-location, requires the F-Droid Termux:API app + CLI + granted location perm).
#
#   mesh-location            current location (network provider — fast, ~city-block accuracy) → JSON
#   mesh-location --gps      GPS provider (more accurate, slower; needs sky view) → JSON
#   mesh-location --brief    one line: "lat,lon (±accuracy m, provider)"
#   mesh-location --test     smoke test
#
# Read-only. Privacy: reveals the operator's physical location — the operator wired this on purpose.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

# State-file suppression: only announce phone-offline ONCE per transition.
# If the phone is offline and the marker exists, suppress further noise.
OFFLINEFILE="$HOME/.mesh/.mesh-location-offline"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  if [ "${2:-}" = --fallback ]; then
    rm -f "$OFFLINEFILE"
    _rc=0
    # Re-exec self in main path with MOCK_PHONE_OFFLINE=1 (exit check, not test run)
    MOCK_PHONE_OFFLINE=1 bash -c 'PATH="$0/.local/bin:$PATH" exec $0/.local/bin/mesh-location' "$HOME" 2>/dev/null && _rc=1 || _rc=$?
    [ "$_rc" = 2 ] && echo "smoke-test: ok (fallback exit 2)" || { echo "smoke-test: FAIL (expected exit 2, got $_rc)"; exit 1; }
    exit 0
  fi
  # Default --test asserted only command existence (theater: green even with the sense
  # dead for days). Add a real reachability probe so doctor sees honest n/a when offline.
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — location unavailable)"; exit 2; }
  echo "smoke-test: ok"; exit 0
fi

prov=network; brief=0
for a in "$@"; do case "$a" in --gps) prov=gps;; --brief) brief=1;; esac; done

# mesh-phone-ip probes TS IP → LAN IPs → ADB tunnel; handles the common case where
# the phone's Tailscale is offline but sshd is reachable on the home LAN.
pip="$(mesh-phone-ip 2>/dev/null)"
[ -n "${MOCK_PHONE_OFFLINE:-}" ] && pip=""
[ -n "$pip" ] || {
    if [ ! -f "$OFFLINEFILE" ]; then
        echo "[mesh-location] phone offline (TS+LAN unreachable) — no location sense" >&2
        touch "$OFFLINEFILE"
    fi
    exit 2
}

# Recovery: phone is now reachable — clear offline state (if it existed)
rm -f "$OFFLINEFILE"

json="$(timeout 35 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" "timeout 28 termux-location -p $prov" \
  </dev/null 2>/dev/null)"
[ -n "$json" ] || { echo "phone unreachable or no $prov fix (try: mesh-location --gps, outdoors)" >&2; exit 1; }
# guard: termux-api-not-installed / error strings aren't a fix
printf '%s' "$json" | grep -q '"latitude"' || { echo "no valid fix: $(printf '%s' "$json" | head -c 80)" >&2; exit 1; }

if [ "$brief" = 1 ]; then
  printf '%s' "$json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print("%s,%s (±%sm, %s)" % (d.get("latitude"), d.get("longitude"), d.get("accuracy"), d.get("provider")))' 2>/dev/null \
    || printf '%s\n' "$json"
else
  printf '%s\n' "$json"
fi
