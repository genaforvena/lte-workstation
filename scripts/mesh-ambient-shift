#!/usr/bin/env bash
# mesh-ambient-shift — robust LEVEL-SHIFT (change-point) detector on the ambient dB tape.
#
# Distinct from periodicity/duty-cycle (senses' fridge work): this flags a REGIME shift in the
# ambient sound LEVEL (quiet↔active room) via ROBUST statistics — median + MAD (median absolute
# deviation), the outlier-resistant core of time-series anomaly detection (Decade Review,
# arXiv 2412.20512; ADTK LevelShiftAD). mean/stddev are dragged by transient LOUD spikes (a TV
# burst, a door slam) and hide a true SUSTAINED level change; median/MAD are not, so a real regime
# shift is separated from foreground noise. (Mirrors the senses [design] insight that the regime
# lives in the floor, not the raw dB — applied to the LEVEL axis instead of the periodic axis.)
#
# method: baseline window (older W rows) vs recent window (R rows) over the rms_db column.
#   robust z = (median_recent - median_base) / (1.4826 * MAD_base)    [1.4826: MAD→σ for normal]
#   |z| >= K (default 3)  => SHIFT  (UP = louder regime, DOWN = quieter).  MAD_base=0 handled
#   (flat baseline: any move of >= a small absolute floor counts; else STEADY).
#
# Honest-exit contract (mirrors mesh-light):
#   0 = assessed (STEADY or SHIFT)
#   2 = cannot read: no tape / fewer than MIN valid rows / tape stale
#
#   mesh-ambient-shift           human line
#   mesh-ambient-shift --json    {state, z, dir, med_base, med_recent, mad_base, n, ts}
#   mesh-ambient-shift --test    smoke test (synthetic step + flat fixtures)
#
# orphan-ok: on-demand detector — wire a dash/cron/wake consumer on demand (don't pre-build).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="$HOME/.mesh"
TAPE="${MESH_AMBIENT_TAPE:-$MESH/ambient-db-tape.tsv}"
R="${MESH_SHIFT_RECENT:-8}"      # recent window rows
W="${MESH_SHIFT_BASE:-40}"       # baseline window rows (immediately before recent)
K="${MESH_SHIFT_K:-3}"           # robust-z threshold
MIN=$(( R + 8 ))                 # need at least recent + a little baseline
STALE_S="${MESH_SHIFT_STALE_S:-1800}"   # tape older than this (s) = cannot read

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

# robust shift over a stream of rms_db values on stdin (one per line, oldest→newest).
# emits: "state z dir med_base med_recent mad_base n"  or  "CANNOT"
robust_shift(){
  awk -v R="$R" -v W="$W" -v K="$K" '
    { v[n++] = $1 }
    function median(arr, lo, hi,   m, c, i, b) {
      c = 0; for (i = lo; i <= hi; i++) b[c++] = arr[i]
      # insertion sort (windows are small)
      for (i = 1; i < c; i++) { m = b[i]; j = i - 1; while (j >= 0 && b[j] > m) { b[j+1] = b[j]; j-- } b[j+1] = m }
      if (c % 2) return b[(c-1)/2]
      return (b[c/2 - 1] + b[c/2]) / 2.0
    }
    END {
      if (n < R + 1) { print "CANNOT"; exit }
      rlo = n - R; rhi = n - 1            # recent window
      blo = rlo - W; if (blo < 0) blo = 0
      bhi = rlo - 1
      if (bhi - blo + 1 < 4) { print "CANNOT"; exit }   # too little baseline
      medr = median(v, rlo, rhi)
      medb = median(v, blo, bhi)
      # MAD of baseline: median(|v_i - medb|)
      c = 0; for (i = blo; i <= bhi; i++) dev[c++] = (v[i] >= medb ? v[i]-medb : medb-v[i])
      # reuse median() over dev[0..c-1]
      madb = median(dev, 0, c-1)
      sigma = 1.4826 * madb
      diff = medr - medb
      dir = (diff >= 0 ? "UP" : "DOWN")
      if (sigma > 0) {
        z = diff / sigma
      } else {
        # flat baseline: fall back to a small absolute floor (dBFS) so noise alone never trips
        z = (diff >= 0 ? diff : -diff) >= 3.0 ? (diff >= 0 ? 99 : -99) : 0
      }
      az = (z >= 0 ? z : -z)
      state = (az >= K ? "SHIFT" : "STEADY")
      printf "%s %.2f %s %.1f %.1f %.2f %d\n", state, z, dir, medb, medr, madb, (bhi-blo+1)+R
    }'
}

read_tape_values(){
  # valid rms_db values, oldest→newest; skip header/comments + NA/UNREACHABLE rows
  [ -r "$TAPE" ] || return 1
  awk -F'\t' '
    /^#/ || $1=="ts" { next }
    $2=="NA" || $2=="UNREACHABLE" || $2=="" { next }
    ($2+0)==$2 || $2 ~ /^-?[0-9]+(\.[0-9]+)?$/ { print $2 }
  ' "$TAPE"
}

tape_fresh(){
  [ -r "$TAPE" ] || return 1
  local m; m=$(stat -c %Y "$TAPE" 2>/dev/null) || return 1
  local now; now=$(date +%s)
  [ $(( now - m )) -le "$STALE_S" ]
}

# ---- test ----
if [ "${1:-}" = --test ]; then
  fail=0
  command -v awk >/dev/null 2>&1 || { echo "  FAIL: no awk"; fail=1; }
  # fixture 1: a clear step change (quiet baseline ~ -40, recent jump to ~ -10) => SHIFT UP
  step="$(printf -- '-40\n-41\n-39\n-40\n-42\n-38\n-40\n-41\n-39\n-40\n-41\n-39\n-40\n-42\n-38\n-40\n-10\n-11\n-9\n-10\n-12\n-9\n-10\n-11\n')"
  out=$(printf '%s\n' "$step" | robust_shift)
  case "$out" in
    SHIFT\ *UP*) echo "  ok: step-change fixture → $out" ;;
    *) echo "  FAIL: step change not detected (got: $out)"; fail=1 ;;
  esac
  # fixture 2: flat-ish noisy floor, no sustained shift => STEADY
  flat="$(printf -- '-40\n-41\n-39\n-40\n-42\n-38\n-40\n-41\n-39\n-40\n-41\n-39\n-40\n-42\n-38\n-40\n-39\n-41\n-40\n-38\n-41\n-40\n-39\n-40\n')"
  out=$(printf '%s\n' "$flat" | robust_shift)
  case "$out" in
    STEADY\ *) echo "  ok: flat fixture → $out" ;;
    *) echo "  FAIL: flat fixture should be STEADY (got: $out)"; fail=1 ;;
  esac
  # fixture 3: a single transient spike in an otherwise flat floor must NOT trip (robustness)
  spike="$(printf -- '-40\n-41\n-39\n-40\n-42\n-38\n-40\n-41\n-39\n-40\n-41\n-39\n-40\n-42\n-38\n-40\n-39\n-40\n-5\n-40\n-39\n-41\n-40\n-39\n')"
  out=$(printf '%s\n' "$spike" | robust_shift)
  case "$out" in
    STEADY\ *) echo "  ok: single-spike fixture stays STEADY (robust) → $out" ;;
    *) echo "  FAIL: single transient spike tripped a shift (got: $out)"; fail=1 ;;
  esac
  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

JSON=0
case "${1:-}" in
  --json) JSON=1 ;;
  ""|--report) : ;;
  *) echo "usage: mesh-ambient-shift [--json | --test]" >&2; exit 1 ;;
esac

if ! [ -r "$TAPE" ]; then
  [ "$JSON" = 1 ] && echo '{"state":"NA","reason":"no tape"}' || echo "ambient-shift: cannot read — no dB tape ($TAPE)"
  exit 2
fi
if ! tape_fresh; then
  [ "$JSON" = 1 ] && echo '{"state":"NA","reason":"tape stale"}' || echo "ambient-shift: cannot read — dB tape stale (>${STALE_S}s old)"
  exit 2
fi

nvals=$(read_tape_values | wc -l)
if [ "${nvals:-0}" -lt "$MIN" ]; then
  [ "$JSON" = 1 ] && echo "{\"state\":\"NA\",\"reason\":\"too few rows ($nvals<$MIN)\"}" || echo "ambient-shift: cannot read — too few valid rows ($nvals < $MIN)"
  exit 2
fi

res=$(read_tape_values | robust_shift)
if [ "$res" = CANNOT ] || [ -z "$res" ]; then
  [ "$JSON" = 1 ] && echo '{"state":"NA","reason":"insufficient window"}' || echo "ambient-shift: cannot read — insufficient window"
  exit 2
fi

set -- $res
state="$1"; z="$2"; dir="$3"; medb="$4"; medr="$5"; madb="$6"; n="$7"
if [ "$JSON" = 1 ]; then
  printf '{"state":"%s","z":%s,"dir":"%s","med_base":%s,"med_recent":%s,"mad_base":%s,"n":%s,"ts":"%s"}\n' \
    "$state" "$z" "$dir" "$medb" "$medr" "$madb" "$n" "$(ts)"
else
  if [ "$state" = SHIFT ]; then
    echo "ambient-shift: SHIFT $dir — level moved ${medb}dB → ${medr}dB (robust z=$z, MAD=${madb}, n=$n). Sustained regime change, not a transient spike."
  else
    echo "ambient-shift: STEADY — level ~${medr}dB (robust z=$z vs baseline ${medb}dB, MAD=${madb}, n=$n)."
  fi
fi
