#!/usr/bin/env bash
# mesh-reflex-decay — auto-decay for unused+failing reflexes (autophagy)
# Scans ~/.local/bin/mesh-*, checks usage + smoke, moves decayed to ~/.mesh/attic/.
#
# COMPLEXITY-TERM GAP (Bayesian model reduction / Friston). Free energy = complexity − accuracy;
# this tool prunes ONLY on the accuracy/liveness axis (dead = unused + smoke-fail). The
# `~ unused but smoke passes (lives)` branch below KEEPS every functional component — so a reflex
# that runs fine yet earns NO accuracy (its per-run artifact is constant / fully REDUNDANT given a
# sibling sense) is never a prune candidate. BMR is the missing dual: reduce a model by removing
# parameters redundant given the rest (complexity drops, accuracy preserved) — Occam, scored from
# data already held, no refit. The principled next step is a READ-ONLY `--complexity-audit` lens
# ranking reflexes by accuracy-contribution-vs-complexity (instrument-before-actuator: NEVER wire an
# auto-kill onto a fresh redundancy proxy — kill-onto-detector is the most-bloodied change class).
# See ~/.mesh/knowledge/review-bayesian-model-reduction-complexity-term-mesh-reflex-decay-2026-06-21.md
#
#   mesh-reflex-decay          REPORT-ONLY: list decay candidates, move/post nothing (safe for a cron/needs probe)
#   mesh-reflex-decay --apply  actually attic the candidates found by the report pass (mv + [decay] post)
#   mesh-reflex-decay --undo   list + restore all decayed reflexes
#   mesh-reflex-decay --candidates   names only, from the PERSISTED report ($MESH/reflex-decay.log);
#                              rc=2 when there is no report or it is stale — never a faked all-clear
#
# reflex-cadence: 41 4 * * *
#
# APPLY GATE (chat-review/reflex-decay-attic-churn-needs-dryrun 2026-07-07): bare run used to mv +
# post [decay] unconditionally — but mesh-needs:165 already called it BARE believing that was a
# dry-run probe (its own comment said so). Real effect: every mesh-needs tick actually attic'd +
# announced candidates, and a genome-present tool (still deployed by mesh-sync-tools on the next
# sync) got attic'd → resurrected → attic'd again — 4 identical [decay] posts for the same tools
# (incl. fresh mesh-ble-heal) in 45min on phaedra. Fix: bare run reports only; --apply performs the
# move. Genome-present tools are additionally NEVER moved (see genome_skip below) even under --apply,
# since sync-tools would just redeploy them right back — that's pure churn, not decay.
#
# See doctrine: ~/.mesh/knowledge/reflex-doctrine.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"; ATTIC="$MESH/attic"; mkdir -p "$ATTIC"
# The scanned bin, overridable — not a nicety: with the directory hard-wired, NO assertion could
# ever drive the real scan, which is why both dead gates below survived. A gate you cannot point at
# a fixture is a gate you can only assert by re-implementing it beside itself (which this tool's
# --test already did: `[ "x--apply" = "x--apply" ]` asserts a tautology, not the code).
BIN_DIR="${MESH_DECAY_BIN:-$HOME/.local/bin}"
REPORT="$MESH/reflex-decay.log"

# ── the scan is EXPENSIVE now that the smoke gate is reachable ───────────────────────────────────
# It runs the declared self-test of every unused tool — ~350 of them here, minutes of wall clock.
# It used to return instantly, but only because presence.log marked everything "recently used" and
# no self-test was ever spawned. mesh-needs:165 inherited that false cheapness and probed this tool
# inline under `timeout 25`; reviving the gate turned that probe into a guaranteed timeout, i.e. a
# silent permanent "no decay candidates". So: the full run PERSISTS its report, and callers read the
# report through --candidates, which goes honest-n/a (rc=2) rather than answering from a stale file.
if [ "${1:-}" = "--candidates" ]; then
  [ -f "$REPORT" ] || { echo "mesh-reflex-decay: no report at $REPORT yet — run it bare (report-only) first" >&2; exit 2; }
  _rage=$(( ( $(date +%s) - $(stat -c %Y "$REPORT" 2>/dev/null || echo 0) ) / 3600 ))
  [ "$_rage" -le "${MESH_DECAY_CACHE_H:-30}" ] \
    || { echo "mesh-reflex-decay: report is ${_rage}h old (max ${MESH_DECAY_CACHE_H:-30}h) — STALE, refusing to answer from it" >&2; exit 2; }
  # WHITELIST the real-candidate markers only. The "UNUSED + FAILS smoke" phrase alone is NOT a
  # candidate signal — the GENOME-PRESENT *skip* branch emits the identical phrase before deciding
  # NOT to attic ("… but GENOME-PRESENT (…) → skip attic"; sync-tools would resurrect an attic'd
  # copy, so it is explicitly never a candidate). Matching the bare phrase leaked every genome-present
  # smoke-failure into --candidates, and mesh-needs re-injected each as an UNRESOLVABLE "DECAY REVIEW"
  # task every 15 min forever (live: mesh-rns-offgrid, mesh-skill-ls, mesh-stress, mesh-therm-ambient —
  # all deployed+genome-tracked, none atticable). A real candidate carries the "DECAY CANDIDATE"
  # (report-only) or "DECAYING to attic" (--apply) verdict; the skip lines carry "skip attic". Key on
  # the verdict, so any current OR future skip reason is excluded by construction.
  grep -oE 'mesh-[a-z0-9-]+ — UNUSED \+ FAILS smoke .*(DECAY CANDIDATE|DECAYING to attic)' "$REPORT" 2>/dev/null | sed 's/ — .*//' | sort -u
  exit 0
fi

# Persist the report of any real scan (bare or --apply) so --candidates has something to read.
# Re-exec through tee rather than juggling process substitution: the mv must not race the flush.
if [ "${1:-}" != "--test" ] && [ "${1:-}" != "--undo" ] && [ -z "${MESH_DECAY_NOTEE:-}" ]; then
  MESH_DECAY_NOTEE=1 "$0" "$@" 2>&1 | tee "$REPORT.tmp"
  _src=${PIPESTATUS[0]}
  mv -f "$REPORT.tmp" "$REPORT" 2>/dev/null || rm -f "$REPORT.tmp"
  exit "$_src"
fi
SUPERVISE_LIST="$MESH/supervise.list"
DECAY_DAYS="${MESH_DECAY_DAYS:-14}"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
APPLY=0; [ "${1:-}" = "--apply" ] && APPLY=1

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
now="$(date +%s)"

# --- quick smoke test (do NOT iterate reflexes) ---
if [ "${1:-}" = "--test" ]; then
  e=0
  for dep in find grep awk stat timeout; do
    command -v "$dep" >/dev/null 2>&1 || { echo "FAIL: dep $dep"; e=$((e+1)); }
  done
  [ -d "$HOME/.local/bin" ] || { echo "FAIL: no ~/.local/bin"; e=$((e+1)); }
  [ -d "$MESH" ] || { echo "FAIL: no ~/.mesh"; e=$((e+1)); }
  # dry-run emergency_check logic
  EMERGENCY_SET="mesh-fix-egress mesh-revert-catch mesh-restore"
  emergency_check(){
    local f="$1" x; f="$(basename "$f" .sh)"
    for x in $EMERGENCY_SET; do [ "$f" = "$x" ] && return 0; done
    grep -q '# reflex: emergency' "$1" 2>/dev/null && return 0
    return 1
  }
  sandbox="$(mktemp -d /tmp/reflex-decay-test.XXXXXX)"
  touch "$sandbox/mesh-restore"; emergency_check "$sandbox/mesh-restore" || { echo "FAIL: emergency-name mesh-restore not exempt"; e=$((e+1)); }
  touch "$sandbox/mesh-random"; emergency_check "$sandbox/mesh-random" && { echo "FAIL: emergency-name mesh-random false-exempt"; e=$((e+1)); } || true
  touch "$sandbox/mesh-custom"; echo '#!/bin/bash' > "$sandbox/mesh-custom"; echo '# reflex: emergency' >> "$sandbox/mesh-custom"
  emergency_check "$sandbox/mesh-custom" || { echo "FAIL: emergency-tag not detected"; e=$((e+1)); }
  rm -rf "$sandbox"
  # APPLY-gate arg parsing (chat-review/reflex-decay-attic-churn-needs-dryrun): only the literal
  # --apply token flips it; any other arg (or none) stays report-only.
  a=0; [ "x--apply" = "x--apply" ] && a=1; [ "$a" = 1 ] || { echo "FAIL: --apply should set APPLY=1"; e=$((e+1)); }
  a=0; [ "x--test" = "x--apply" ] && a=1; [ "$a" = 0 ] || { echo "FAIL: --test must not set APPLY=1"; e=$((e+1)); }
  a=0; [ "x" = "x--apply" ] && a=1; [ "$a" = 0 ] || { echo "FAIL: bare (no arg) must not set APPLY=1"; e=$((e+1)); }
  # GENOME-PRESENT check: a tool still tracked in $REPO/scripts/ must be detected present
  sandbox2="$(mktemp -d /tmp/reflex-decay-genome-test.XXXXXX)"
  mkdir -p "$sandbox2/scripts"
  touch "$sandbox2/scripts/mesh-genome-present"
  [ -f "$sandbox2/scripts/mesh-genome-present" ] || { echo "FAIL: genome-present fixture not detected"; e=$((e+1)); }
  [ -f "$sandbox2/scripts/mesh-genome-absent" ] && { echo "FAIL: genome-absent fixture false-positive"; e=$((e+1)); } || true
  rm -rf "$sandbox2"
  # log pattern logic: strip mesh- prefix for log files
  r="$(n='mesh-body-power'; echo "${n#mesh-}")"; [ "$r" = "body-power" ] || { echo "FAIL: strip-mesh-prefix => '$r'"; e=$((e+1)); }
  r="$(n='mesh-reflex-decay'; echo "${n#mesh-}")"; [ "$r" = "reflex-decay" ] || { echo "FAIL: strip-mesh-prefix2 => '$r'"; e=$((e+1)); }
  r="$(n='mesh-act'; echo "${n#mesh-}")"; [ "$r" = "act" ] || { echo "FAIL: strip-mesh-prefix3 => '$r'"; e=$((e+1)); }
  # ── END-TO-END: drive the REAL scan against a fixture bin, not a re-implementation beside it ────
  # Everything above this line asserts a COPY of the logic (`[ "x--apply" = "x--apply" ]` is a
  # tautology, not a test of the parser). That is exactly why both dead gates below shipped green:
  # nothing here had ever run the loop. These legs point the actual tool at a fixture bin + a
  # fixture $MESH and read its verdicts.
  sbin="$(mktemp -d /tmp/reflex-decay-bin.XXXXXX)"; smesh="$(mktemp -d /tmp/reflex-decay-mesh.XXXXXX)"
  _mk(){ printf '#!/bin/bash\n%s\n' "$2" > "$sbin/$1"; chmod +x "$sbin/$1"; }
  _mk mesh-zzok     'case "${1:-}" in --test) exit 0;; *) echo usage; exit 0;; esac'
  _mk mesh-zzred    'case "${1:-}" in --test) exit 1;; *) echo usage; exit 0;; esac'
  # A genome-present tool that FAILS smoke: the scan must skip atticking it (sync-tools would
  # resurrect it) AND --candidates must NOT name it — the exact leak that fed mesh-needs an
  # unresolvable DECAY REVIEW every cycle. mesh-zzred (genome-ABSENT below) is the contrast.
  _mk mesh-zzgenome 'case "${1:-}" in --test) exit 1;; *) echo usage; exit 0;; esac'
  _mk mesh-zzna     'case "${1:-}" in --test) exit 2;; *) echo usage; exit 0;; esac'
  _mk mesh-zznotest 'echo usage; exit 0'
  _mk mesh-presence 'echo usage; exit 0'
  # foreign-node tool: an absolute shebang whose interpreter is ABSENT on this node (a Termux
  # phone-BODY sense on the Ubuntu mind node). Exec yields rc=127 before any line runs; it must
  # LIVE as unassessable, never be read as "FAILS smoke" and re-flagged forever.
  printf '#!/no/such/interp/sh\ncase "${1:-}" in --test) exit 0;; *) echo usage; exit 0;; esac\n' > "$sbin/mesh-zzforeign"; chmod +x "$sbin/mesh-zzforeign"
  printf '[Unit]\nDescription=fixture\n' > "$sbin/mesh-zzunit.service"; chmod 755 "$sbin/mesh-zzunit.service"
  : > "$smesh/presence.log"     # FRESH — the artifact that used to rescue every tool in the mesh
  mkdir -p "$smesh/repo/scripts"; : > "$smesh/repo/scripts/mesh-zzgenome"   # mesh-zzgenome is GENOME-PRESENT; every other fixture stays genome-absent
  out="$(MESH_DIR="$smesh" MESH_DECAY_BIN="$sbin" MESH_REPO="$smesh/repo" \
         timeout 120 "$0" 2>&1)" || true
  _line(){ grep -F -- " $1 —" <<<"$out" | head -1; }
  # 1. THE PRESENCE-LOG RESCUE IS GONE. A fresh presence.log is a claim about mesh-presence and
  #    about nothing else. Before the fix this leg was 601/608 of the live mesh.
  case "$(_line mesh-zzok)" in
    *"recently used"*) echo "FAIL: a fresh \$MESH/presence.log still marks mesh-zzok 'recently used' — the liveness axis is a constant again and the smoke gate below is unreachable"; e=$((e+1)) ;;
  esac
  # 1b. ...but the tool it IS a claim about must still be rescued by it (both directions).
  case "$(_line mesh-presence)" in
    *"recently used"*) : ;;
    *) echo "FAIL: presence.log no longer rescues mesh-presence itself — the scoping threw away the real special case: $(_line mesh-presence)"; e=$((e+1)) ;;
  esac
  # 2. A RED --test MUST FAIL SMOKE. The old probe rescued it with `|| --help`, so a self-test that
  #    fails and one that passes were indistinguishable.
  case "$(_line mesh-zzred)" in
    *"FAILS smoke"*) : ;;
    *) echo "FAIL: mesh-zzred exits 1 from --test and is still not a decay candidate — a usage banner is rescuing a RED self-test: $(_line mesh-zzred)"; e=$((e+1)) ;;
  esac
  # 3. rc=2 is honest n/a (organ absent), NOT failure — decaying a tool for this node's missing
  #    hardware would be vandalism. Same rule mesh-land uses.
  case "$(_line mesh-zzna)" in
    *"smoke passes"*"rc=2"*) : ;;
    *) echo "FAIL: mesh-zzna exits 2 (honest n/a) and was not kept alive as n/a: $(_line mesh-zzna)"; e=$((e+1)) ;;
  esac
  case "$(_line mesh-zzok)" in
    *"smoke passes"*"rc=0"*) : ;;
    *) echo "FAIL: mesh-zzok passes its own --test and was not recorded as passing: $(_line mesh-zzok)"; e=$((e+1)) ;;
  esac
  # 4. A tool with no self-test lives, but the verdict must not read as evidence about the REFLEX.
  case "$(_line mesh-zznotest)" in
    *"PARSES"*) : ;;
    *) echo "FAIL: a tool with no self-test is reported without saying --help proves only that it parses: $(_line mesh-zznotest)"; e=$((e+1)) ;;
  esac
  # 4b. A DEPLOYED SYSTEMD UNIT IS NOT A REFLEX. mode 755, no --help, no self-test — with the smoke
  #     gate working it walks straight into "UNUSED + FAILS smoke" and the lane proposes atticking a
  #     live unit. (mesh-liveness-loop.service, mesh-imac-cam-watch.service and mesh-imac-cam.m are
  #     all really in this node's bin.) Skipped by suffix, named in the output, counted in the total.
  case "$(_line mesh-zzunit.service)" in
    *"not a reflex"*) : ;;
    *) echo "FAIL: an executable .service unit was scanned as a reflex: $(_line mesh-zzunit.service)"; e=$((e+1)) ;;
  esac
  # 4c. A FOREIGN-NODE TOOL (absent shebang interpreter → exec rc=127) is UNASSESSABLE here, not a
  #     smoke failure. Without the wrong-node guard it read as "FAILS smoke [--test rc=127]" and the
  #     decay lane re-flagged mesh-phone-beacon2 / mesh-sms-* every scan forever.
  case "$(_line mesh-zzforeign)" in
    *"UNASSESSABLE"*) : ;;
    *"FAILS smoke"*) echo "FAIL: a foreign-node tool (absent interpreter, rc=127) was read as FAILS smoke, not unassessable — the wrong-node guard is dead: $(_line mesh-zzforeign)"; e=$((e+1)) ;;
    *) echo "FAIL: mesh-zzforeign (absent shebang interpreter) was not reported as unassessable-and-alive: $(_line mesh-zzforeign)"; e=$((e+1)) ;;
  esac
  # 5. THE REPORT IS PERSISTED, and --candidates answers from it — or refuses. The full scan above
  #    ran with MESH_DIR=$smesh, so its report landed there; nothing touched the live one.
  [ -s "$smesh/reflex-decay.log" ] || { echo "FAIL: a real scan left no persisted report at \$MESH/reflex-decay.log — --candidates has nothing to read and mesh-needs goes permanently silent"; e=$((e+1)); }
  cnd="$(MESH_DIR="$smesh" timeout 20 "$0" --candidates 2>/dev/null)"; crc=$?
  [ "$crc" = 0 ] || { echo "FAIL: --candidates rc=$crc against a FRESH report"; e=$((e+1)); }
  case "$cnd" in
    *mesh-zzred*) : ;;
    *) echo "FAIL: --candidates did not name mesh-zzred (the only failing fixture): '$cnd'"; e=$((e+1)) ;;
  esac
  case "$cnd" in
    *mesh-zzok*|*mesh-zzna*|*mesh-zznotest*|*mesh-zzforeign*) echo "FAIL: --candidates named a HEALTHY/UNASSESSABLE fixture — the old scrape matched the 'unused but smoke passes' branch too: '$cnd'"; e=$((e+1)) ;;
  esac
  # THE GENOME-PRESENT LEAK. mesh-zzgenome FAILS smoke but is genome-present, so the scan skips
  # atticking it — yet the old --candidates regex matched the shared "UNUSED + FAILS smoke" phrase on
  # its skip line and named it anyway, feeding mesh-needs an UNRESOLVABLE DECAY REVIEW every cycle.
  # RED-first: revert the line-56 whitelist and this assertion fires.
  case "$(_line mesh-zzgenome)" in
    *"GENOME-PRESENT"*"skip attic"*) : ;;
    *) echo "FAIL: mesh-zzgenome (genome-present, fails smoke) was not reported as GENOME-PRESENT skip-attic: $(_line mesh-zzgenome)"; e=$((e+1)) ;;
  esac
  case "$cnd" in
    *mesh-zzgenome*) echo "FAIL: --candidates named mesh-zzgenome — a genome-present skip line leaked as a candidate; sync-tools would resurrect it, so mesh-needs re-injects an unresolvable DECAY REVIEW forever: '$cnd'"; e=$((e+1)) ;;
  esac
  # STALE must be n/a (rc=2, no names), never a faked empty all-clear.
  touch -d '10 days ago' "$smesh/reflex-decay.log"
  cnd2="$(MESH_DIR="$smesh" timeout 20 "$0" --candidates 2>/dev/null)"; crc2=$?
  { [ "$crc2" = 2 ] && [ -z "$cnd2" ]; } \
    || { echo "FAIL: a 10-day-old report answered anyway (rc=$crc2, out='$cnd2') — a stale cache must go honest n/a, not report yesterday's mesh as today's"; e=$((e+1)); }
  rm -f "$smesh/reflex-decay.log"
  MESH_DIR="$smesh" timeout 20 "$0" --candidates >/dev/null 2>&1
  [ "$?" = 2 ] || { echo "FAIL: --candidates with NO report at all did not exit 2"; e=$((e+1)); }
  rm -rf "$sbin" "$smesh"
  # No hand-maintained assertion COUNT (the roster-beside-the-roster trap) — name what was asserted.
  [ "$e" -eq 0 ] && echo "smoke: ok (deps; emergency exemption by name and by tag; --apply gate; genome-present detection; log-name mapping; and end-to-end against a fixture bin: a fresh presence.log no longer rescues every tool yet still rescues mesh-presence, a RED --test is a decay candidate instead of being saved by its usage banner, rc=2 is honest n/a and lives, rc=0 passes, a tool with no self-test is labelled as parse-only, an executable .service unit is not scanned as a reflex, and --candidates names only the failing one — going honest n/a (rc=2) on a stale or absent report instead of a silent all-clear)" \
    || { echo "smoke: FAIL ($e fail(s))"; exit 1; }
  exit 0
fi

# emergency exemptions: well-known critical reflexes (fire extinguishers)
EMERGENCY_SET="mesh-fix-egress mesh-revert-catch mesh-restore mesh-borrowed-brain mesh-dms mesh-genome-sync"

emergency_check(){
  local f="$1"; f="$(basename "$f" .sh)"
  # by name
  for e in $EMERGENCY_SET; do [ "$f" = "$e" ] && return 0; done
  # by header tag
  grep -q '# reflex: emergency' "$1" 2>/dev/null && return 0
  return 1
}

# Find all mesh reflex scripts
reflexes=()
while IFS= read -r -d '' f; do
  reflexes+=("$f")
done < <(find "$BIN_DIR" -maxdepth 1 -name 'mesh-*' -type f -print0 2>/dev/null | sort -z)

# Read currently-supervised loops (running = in use by definition)
declare -A supervised
supervised_count=0
while IFS='|' read -r name _; do
  name="$(echo "$name" | xargs)"
  if [ -n "$name" ] && [ "${supervised[$name]:-}" != 1 ]; then
    supervised["$name"]=1
    supervised_count=$((supervised_count + 1))
  fi
done < "$SUPERVISE_LIST" 2>/dev/null

echo "=== mesh-reflex-decay @ $(ts) ==="
echo "decay threshold: ${DECAY_DAYS}d since last use"
echo "total reflexes: ${#reflexes[@]}"
echo "supervised: $supervised_count"
echo ""

decayed=0; exempt=0; alive=0; no_test=0; genome_skip=0; candidates=0; nonreflex=0
declare -a decayed_list

for rf in "${reflexes[@]}"; do
  name="$(basename "$rf")"

  # NOT EVERY mesh-* FILE IN THE BIN IS A REFLEX. Deployed systemd units and helper data sit beside
  # the scripts (mesh-liveness-loop.service is mode 755, so an executable-bit filter would not catch
  # it). They have no self-test and no --help by construction, so once the smoke gate started
  # working they marched straight into "UNUSED + FAILS smoke" — the lane would have proposed
  # atticking a live systemd unit. Counted and named, never silently dropped.
  case "$name" in
    *.service|*.timer|*.socket|*.path|*.mount|*.json|*.md|*.conf|*.env|*.m)
      echo "  · $name — not a reflex (non-script artifact deployed to the bin) — skipped"
      nonreflex=$((nonreflex + 1))
      continue ;;
  esac

  # Check emergency exemption
  if emergency_check "$rf"; then
    echo "  ☩ $name — EXEMPT (emergency)"
    exempt=$((exempt + 1))
    continue
  fi

  # Check if it's currently supervised (actively running = in use)
  if [ "${supervised[$name]:-}" = "1" ]; then
    echo "  ✓ $name — supervised (active loop)"
    alive=$((alive + 1))
    continue
  fi

  # Check for recent log/beat files.
  #
  # THE ARTIFACT MUST BE A CLAIM ABOUT *THIS* TOOL. `$MESH/presence.log` was in this list
  # UNCONDITIONALLY — added as a "special case: mesh-presence logs here", but applied to every name
  # in the scan. presence.log is written every few minutes by a live sense, so `recent_use=1` fired
  # for all of them: measured 2026-07-24, **601 of 608** tools reported "recently used (< 14d)",
  # including `mesh-zonemap`, which has no log, no beat and no health file of any kind. The liveness
  # axis was a CONSTANT, the smoke gate below was never once REACHED, and the whole decay lane —
  # report and --apply alike — could not name a candidate. A tool nobody has seen decay anything is
  # not an autophagy reflex. Same shape as health's funnel find (`tailscale funnel --help` rc=0 while
  # the capability is absent): reading an artifact that is not a claim about the thing being probed.
  recent_use=0
  for logpat in "$MESH/${name#mesh-}.log" "$MESH/${name#mesh-}.beat" "$MESH/${name}.log" "$MESH/${name}.beat" \
    "$MESH/${name#mesh-}.cron.log" \
    "$MESH/${name#mesh-}-health.log" "$MESH/${name#mesh-}-health.beat" \
    "$([ "$name" = mesh-presence ] && echo "$MESH/presence.log")"; do   # the real special case, SCOPED
    [ -n "$logpat" ] && [ -f "$logpat" ] || continue
    mod="$(stat -c %Y "$logpat" 2>/dev/null)" || continue
    age=$(( (now - mod) / 86400 ))
    if [ "$age" -lt "$DECAY_DAYS" ]; then
      recent_use=1
      break
    fi
  done

  if [ "$recent_use" = "1" ]; then
    echo "  ✓ $name — recently used (< ${DECAY_DAYS}d)"
    alive=$((alive + 1))
    continue
  fi

  # Unused — now smoke test.
  #
  # WHAT THE OLD PROBE ACTUALLY ASSERTED: nothing. `--test || --smoke || --help` rescued every RED
  # --test with a usage banner, so a self-test that FAILS and one that PASSES produced the same
  # verdict. The no-self-test arm was worse: it accepted a run whose output merely matched
  # `usage|help|error|mesh-` — i.e. the literal string "error" counted as evidence of health, and
  # "mesh-" matches essentially any mesh tool's output — and then `[ $? -ne 0 ] || smoke_ok=1`
  # stamped it a second time off a stale $?. Three independent rubber stamps on one gate.
  #
  # The honest probe runs the self-test the tool DECLARES and reads its exit code as the mesh reads
  # exit codes everywhere else: 0 = pass · 2 = honest n/a, the organ is absent and the tool is sound
  # (mesh-land's rule; decaying a tool because this node lacks its hardware would be pure vandalism)
  # · 124 = the timeout fired, which is UNKNOWN, not failure (slow-but-green is a known shape here)
  # · anything else = FAIL. `--help` is never a rescue; for a tool that declares no self-test at all
  # it is the only thing available, and the verdict says exactly what it proves.
  smoke_ok=0; smoke_why=""
  probe=""
  grep -q -- '--test'  "$rf" 2>/dev/null && probe="--test"
  [ -z "$probe" ] && grep -q -- '--smoke' "$rf" 2>/dev/null && probe="--smoke"
  # WRONG-NODE GUARD (foreign-node tool): a phone-BODY Termux sense carries an absolute
  # #!/data/data/com.termux/files/usr/bin/sh shebang; on this Ubuntu mind node that interpreter
  # is absent, so the kernel refuses to EXEC it and returns 127 ("required file not found")
  # BEFORE a line of the script runs. That is not a smoke FAILURE — it is the tool's INTERPRETER
  # being absent, the same class as rc=2 "organ absent, tool sound" (mesh-land's rule). Without
  # this, the lane re-flags every phone sense (mesh-phone-beacon2, mesh-sms-*) as "UNUSED + FAILS
  # smoke [--test rc=127]" on every scan, forever. Detect it DETERMINISTICALLY — parse the shebang
  # interpreter and check it exists — never by swallowing a bare rc=127, which a real test can
  # legitimately return from a command IT invokes. (Sibling of mesh-doctor's UNASSESSED-vs-n/a
  # split, 55aef43; "n/a must be a claim about the node".)
  interp=""
  sb=$(head -1 "$rf" 2>/dev/null)
  case "$sb" in
    '#!'*) interp=${sb#\#!}; interp=${interp# }; interp=${interp%% *} ;;
  esac
  case "$interp" in
    /*) if [ ! -x "$interp" ]; then
          echo "  ~ $name — unused but smoke UNASSESSABLE on this node (lives) [interpreter $interp absent — foreign-node tool, cannot exec here]"
          no_test=$((no_test + 1)); continue
        fi ;;
  esac
  if [ -n "$probe" ]; then
    timeout 20 "$rf" "$probe" >/dev/null 2>&1; prc=$?
    case "$prc" in
      0)   smoke_ok=1; smoke_why="$probe rc=0" ;;
      2)   smoke_ok=1; smoke_why="$probe rc=2 (honest n/a — organ absent, tool sound)" ;;
      124) smoke_ok=1; smoke_why="$probe rc=124 (timed out — UNKNOWN, never decay on a timeout)" ;;
      *)   smoke_ok=0; smoke_why="$probe rc=$prc" ;;
    esac
  elif timeout 10 "$rf" --help >/dev/null 2>&1; then
    # NOT a pass on the reflex — a pass on the FILE. Kept alive (this lane must not attic a working
    # tool for lacking a self-test) but labelled so the two are never read as the same evidence.
    smoke_ok=1; smoke_why="no self-test; --help rc=0 proves only that it PARSES"
  else
    smoke_ok=0; smoke_why="no self-test and --help rc!=0"
  fi

  if [ "$smoke_ok" = "1" ]; then
    echo "  ~ $name — unused but smoke passes (lives) [$smoke_why]"
    no_test=$((no_test + 1))
    continue
  fi

  # Unused AND fails smoke → decay candidate. GENOME-PRESENT GUARD (chat-review/reflex-decay-attic-
  # churn-needs-dryrun): if the genome still tracks this tool, mesh-sync-tools redeploys it right
  # back on the next sync — atticking the deployed copy is pure churn, never real decay. Skip
  # unconditionally (report-only AND --apply alike); the real fix is removing it from the genome.
  if [ -f "$REPO/scripts/$name" ]; then
    echo "  ○ $name — UNUSED + FAILS smoke [$smoke_why] but GENOME-PRESENT ($REPO/scripts/$name) → skip attic (sync-tools would resurrect it); remove from genome to actually retire it"
    genome_skip=$((genome_skip + 1))
    continue
  fi

  if [ "$APPLY" = "1" ]; then
    echo "  ✖ $name — UNUSED + FAILS smoke [$smoke_why] → DECAYING to attic"
    mv "$rf" "$ATTIC/$name"
    decayed_list+=("$name")
    decayed=$((decayed + 1))
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflex-decay@$(hostname)" mesh-chat "[decay] $name: unused (no activity ${DECAY_DAYS}d) + failed smoke test → moved to ~/.mesh/attic/ (reversible)" >/dev/null 2>&1
  else
    echo "  ✖ $name — UNUSED + FAILS smoke [$smoke_why] → DECAY CANDIDATE (report-only; re-run with --apply to attic it)"
    candidates=$((candidates + 1))
  fi
done

echo ""
echo "=== Summary: $decayed decayed + $alive alive + $exempt exempt + $no_test unused-but-functional + $genome_skip genome-present-skip + $nonreflex non-reflex-artifact + $candidates report-only-candidate(s) = ${#reflexes[@]} total ==="
[ "$APPLY" = "1" ] || [ "$candidates" -eq 0 ] || echo "(report-only pass — re-run with --apply to actually attic the $candidates candidate(s) above)"
echo ""

# Undo mode: list attic and restore
if [ "${1:-}" = "--undo" ]; then
  echo "=== attic contents ==="
  ls -la "$ATTIC/" 2>/dev/null || echo "(empty)"
  echo ""
  if [ -n "${2:-}" ]; then
    if [ -f "$ATTIC/$2" ]; then
      mv "$ATTIC/$2" "$HOME/.local/bin/$2"
      echo "restored: $2"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflex-decay@$(hostname)" mesh-chat "[restore] $2 restored from attic" >/dev/null 2>&1
    else
      echo "not found in attic: $2"
    fi
  else
    echo "usage: mesh-reflex-decay --undo <name>"
  fi
fi

exit 0
