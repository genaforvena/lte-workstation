#!/usr/bin/env bash
# mesh-reflex-decay — auto-decay for unused+failing reflexes (autophagy)
# Scans ~/.local/bin/mesh-*, checks usage + smoke, moves decayed to ~/.mesh/attic/.
#
#   mesh-reflex-decay          run decay pass, report what happened
#   mesh-reflex-decay --undo   list + restore all decayed reflexes
#
# See doctrine: ~/.mesh/knowledge/reflex-doctrine.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; ATTIC="$MESH/attic"; mkdir -p "$ATTIC"
SUPERVISE_LIST="$MESH/supervise.list"
DECAY_DAYS="${MESH_DECAY_DAYS:-14}"

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
now="$(date +%s)"

# --- quick smoke test (do NOT iterate reflexes) ---
if [ "${1:-}" = "--test" ]; then
  for dep in find grep awk stat timeout; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep not found)"; exit 1; }
  done
  [ -d "$HOME/.local/bin" ] || { echo "smoke-test: FAIL (~/.local/bin not found)"; exit 1; }
  [ -d "$MESH" ] || { echo "smoke-test: FAIL (~/.mesh not found)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

# emergency exemptions: well-known critical reflexes (fire extinguishers)
EMERGENCY_SET="mesh-fix-egress mesh-revert-catch mesh-restore mesh-borrowed-brain mesh-dms mesh-genome-sync"

emergency_check(){
  local f="$1"; f="$(basename "$f" .sh)"
  # by name
  for e in $EMERGENCY_SET; do [ "$f" = "$e" ] && return 0; done
  # by header tag
  grep -q '# reflex: emergency' "$1" 2>/dev/null && return 0
  return 1
}

# Find all mesh reflex scripts
reflexes=()
while IFS= read -r -d '' f; do
  reflexes+=("$f")
done < <(find "$HOME/.local/bin" -maxdepth 1 -name 'mesh-*' -type f -print0 2>/dev/null | sort -z)

# Read currently-supervised loops (running = in use by definition)
declare -A supervised
while IFS='|' read -r name _; do
  name="$(echo "$name" | xargs)"
  [ -n "$name" ] && supervised["$name"]=1
done < "$SUPERVISE_LIST" 2>/dev/null

echo "=== mesh-reflex-decay @ $(ts) ==="
echo "decay threshold: ${DECAY_DAYS}d since last use"
echo "total reflexes: ${#reflexes[@]}"
echo "supervised: ${#supervised[@]}"
echo ""

decayed=0; exempt=0; alive=0; no_test=0
declare -a decayed_list

for rf in "${reflexes[@]}"; do
  name="$(basename "$rf")"

  # Check emergency exemption
  if emergency_check "$rf"; then
    echo "  ☩ $name — EXEMPT (emergency)"
    exempt=$((exempt + 1))
    continue
  fi

  # Check if it's currently supervised (actively running = in use)
  if [ "${supervised[$name]:-}" = "1" ]; then
    echo "  ✓ $name — supervised (active loop)"
    alive=$((alive + 1))
    continue
  fi

  # Check for recent log/beat files
  recent_use=0
  for logpat in "$MESH/${name#mesh-}.log" "$MESH/${name#mesh-}.beat" "$MESH/${name}.log" "$MESH/${name}.beat" \
    "$MESH/${name#mesh-}-health.log" "$MESH/${name#mesh-}-health.beat" \
    "$MESH/presence.log"; do  # special case: mesh-presence logs here
    [ -f "$logpat" ] || continue
    mod="$(stat -c %Y "$logpat" 2>/dev/null)" || continue
    age=$(( (now - mod) / 86400 ))
    if [ "$age" -lt "$DECAY_DAYS" ]; then
      recent_use=1
      break
    fi
  done

  if [ "$recent_use" = "1" ]; then
    echo "  ✓ $name — recently used (< ${DECAY_DAYS}d)"
    alive=$((alive + 1))
    continue
  fi

  # Unused — now smoke test
  smoke_ok=0
  # Try --test, --smoke, or just help flag
  if grep -q '# smoke-test\|--test\|--smoke' "$rf" 2>/dev/null; then
    if timeout 10 "$rf" --test 2>/dev/null || timeout 10 "$rf" --smoke 2>/dev/null || timeout 10 "$rf" --help >/dev/null 2>&1; then
      smoke_ok=1
    fi
  else
    # No smoke test: try basic run with help or version
    if timeout 5 "$rf" 2>&1 | grep -qi "usage\|help\|error\|mesh-" 2>/dev/null; then
      smoke_ok=1
    elif timeout 5 "$rf" --help >/dev/null 2>&1; then
      smoke_ok=1
    fi
    [ $? -ne 0 ] || smoke_ok=1
  fi

  if [ "$smoke_ok" = "1" ]; then
    echo "  ~ $name — unused but smoke passes (lives)"
    no_test=$((no_test + 1))
    continue
  fi

  # Unused AND fails smoke → decay
  echo "  ✖ $name — UNUSED + FAILS smoke → DECAYING to attic"
  mv "$rf" "$ATTIC/$name"
  decayed_list+=("$name")
  decayed=$((decayed + 1))
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflex-decay@$(hostname)" mesh-chat "[decay] $name: unused (no activity ${DECAY_DAYS}d) + failed smoke test → moved to ~/.mesh/attic/ (reversible)" >/dev/null 2>&1
done

echo ""
echo "=== Summary: $decayed decayed + $alive alive + $exempt exempt + $no_test unused-but-functional = ${#reflexes[@]} total ==="
echo ""

# Undo mode: list attic and restore
if [ "${1:-}" = "--undo" ]; then
  echo "=== attic contents ==="
  ls -la "$ATTIC/" 2>/dev/null || echo "(empty)"
  echo ""
  if [ -n "${2:-}" ]; then
    if [ -f "$ATTIC/$2" ]; then
      mv "$ATTIC/$2" "$HOME/.local/bin/$2"
      echo "restored: $2"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="reflex-decay@$(hostname)" mesh-chat "[restore] $2 restored from attic" >/dev/null 2>&1
    else
      echo "not found in attic: $2"
    fi
  else
    echo "usage: mesh-reflex-decay --undo <name>"
  fi
fi

exit 0
