#!/usr/bin/env python3
"""Read-only fleet and wake-caller inventory. Exit 1 when a live channel is unsafe."""

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
MESH = HOME / ".mesh"
NAME = re.compile(r"^[a-z][a-z0-9-]*$")
MANIFEST = re.compile(r'^\s*ensure_uniform_channel\s+([a-z][a-z0-9-]*)\s+([a-z][a-z0-9-]*)\s+')
WITNESS_MANIFEST = re.compile(r"^ensure_witness_data\s*$")
RETIRED = {"diary", "models", "room", "bruno", "chat"}
REFERENCE_ONLY = {"mesh-edge-gate-audit", "mesh-handoff", "mesh-land", "mesh-mishe-channels",
                  "mesh-mishe-shadow-volume", "mesh-promises", "mesh-receipt-peer-vantage",
                  "mesh-restore", "mesh-roll-call-retire-arm", "mesh-tell", "mesh-tg-reply-watch",
                  "mesh-vitality"}
PRIVATE = {"tg", "tg-roz", "pub", "job", "hire", "vpn", "health", "witness"}
PROTECTED = {"vpn": ["routing", "dns", "firewall", "tunnel"], "health": ["critical-alert"],
             "tg": ["operator-message"], "tg-roz": ["private-message"], "pub": ["publication"],
             "job": ["application"], "hire": ["application"]}
CALLER_POLICY = {
    "mesh-feed": ("sensor/peer event", "feed event"),
    "mesh-chat-deliver": ("task prompt", "outbox task identity"),
    "mesh-supervise": ("lifecycle reinvite", "invocation recovery"),
    "mesh-presence-fuse-stream": ("sensor/peer event", "feed event"),
    "mesh-overhear": ("sensor/peer event", "feed event"),
    "mesh-stream": ("sensor/peer event", "feed event"),
    "mesh-textin": ("operator ingress", "operator ingress record"),
    "mesh-land-wake": ("lifecycle reinvite", "feed event"),
    "mesh-pane-consume": ("lifecycle reinvite", "projected event"),
    "mesh-mind-control": ("task prompt", "outbox task identity"),
    "mesh-dispatch": ("task prompt", "outbox task identity"),
    "mesh-consume-all": ("lifecycle reinvite", "invocation recovery"),
    "mesh-loop-baton": ("baton transfer", "baton graph event"),
    "mesh-liveness-loop": ("lifecycle reinvite", "invocation recovery"),
    "mesh-health-critical-wake": ("sensor/peer event", "critical feed event"),
    "mesh-chat-watch": ("task prompt", "outbox task identity"),
    "mesh-chat-review": ("task prompt", "outbox task identity"),
    "mesh-failover": ("task prompt", "outbox task identity"),
    "mesh-ask-notify": ("task prompt", "outbox task identity"),
    "mesh-sound-reflex": ("sensor/peer event", "feed event"),
    "mesh-room-reflex": ("sensor/peer event", "feed event"),
    "mesh-room-sense-loss": ("sensor/peer event", "feed event"),
    "mesh-room-music": ("sensor/peer event", "feed event"),
    "mesh-roz-channel": ("operator ingress", "private ingress record"),
    "mesh-egress-stream": ("sensor/peer event", "feed event"),
    "mesh-sense-evolve": ("task prompt", "outbox task identity"),
    "mesh-witness-stall-sweep": ("task prompt", "outbox task identity"),
    "mesh-witness-task-autonomy": ("task prompt", "outbox task identity"),
    "mesh-mind-recycle": ("lifecycle reinvite", "invocation recovery"),
    "mesh-mind-snapshot": ("lifecycle reinvite", "invocation recovery"),
    "mesh-mind-state": ("lifecycle reinvite", "invocation recovery"),
    "mesh-channel-keepalive": ("lifecycle reinvite", "invocation recovery"),
    "mesh-roll-call": ("lifecycle reinvite", "invocation recovery"),
    "mesh-quota-react": ("lifecycle reinvite", "invocation recovery"),
    "mesh-bruno": ("sensor/peer event", "feed event"),
    "mesh-council": ("manual control", "manual control"),
}
CALL = re.compile(r"\bmesh-tell\b|mesh-mind-control\s+--dispatch|mesh-consume-all\s+--kick")


def run(*argv):
    p = subprocess.run(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout if p.returncode == 0 else None


def effective_env(path):
    names = ["MESH_MIND_CHANNELS", "MESH_CONSUME_CHANNELS", "MESH_RETIRED_CHANNELS",
             "MESH_PRIMARY_MIND_TYPE", "MESH_PRIMARY_MIND_CMD", "MESH_MISHE_WITNESS_MODEL"]
    code = 'source "$1" >/dev/null 2>&1; shift; for n; do printf "%s=%s\\0" "$n" "${!n-}"; done'
    p = subprocess.run(["bash", "-c", code, "_", str(path), *names], stdout=subprocess.PIPE)
    if p.returncode:
        raise ValueError("restore.env could not be sourced")
    return dict(part.decode().split("=", 1) for part in p.stdout.split(b"\0") if part)


def manifests(path):
    rows = {}
    for line in path.read_text().splitlines():
        match = MANIFEST.match(line)
        if match:
            channel, role = match.groups()
            if channel in rows:
                raise ValueError(f"duplicate restore channel: {channel}")
            rows[channel] = role
        if WITNESS_MANIFEST.match(line):
            if "witness" in rows:
                raise ValueError("duplicate restore channel: witness")
            rows["witness"] = "witness"
    return rows


def engine(command):
    matches = re.findall(r"(?:^|[/\s'\"])(omp|codex|claude|opencode|gemini)(?=\s|$)", command)
    return matches[-1] if matches else None


def model(command):
    match = re.search(r"--model\s+([^\s'\"]+)", command)
    return match.group(1) if match else None


def pane_state(session):
    out = run("tmux", "list-windows", "-t", session, "-F", "#{window_name}|#{window_panes}")
    if out is None:
        raise ValueError("tmux window listing unavailable")
    rows = {}
    for line in out.splitlines():
        name, count = line.rsplit("|", 1)
        if name in rows:
            raise ValueError(f"duplicate tmux window: {name}")
        rows[name] = int(count)
    return rows


def caller_inventory(script_dir, mesh_dir):
    callers = []
    for path in sorted(script_dir.iterdir()):
        if not path.is_file() or not os.access(path, os.X_OK) or path.name.startswith("test-") or path.name in REFERENCE_ONLY:
            continue
        try:
            lines = path.read_text().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        hits = [i for i, line in enumerate(lines, 1)
                if CALL.search(line) and not line.lstrip().startswith("#")
                and not line.lstrip().startswith(('echo ', 'printf ', 'grep ', 'assert '))]
        if not hits:
            continue
        policy = CALLER_POLICY.get(path.name)
        callers.append({"path": str(path), "lines": hits, "owner": path.name,
                        "class": policy[0] if policy else "unclassified",
                        "replacement": policy[1] if policy else None})
    # Local loop scripts are separately executable and can inject directly.
    loops = mesh_dir / "loops"
    if loops.is_dir():
        for path in sorted(loops.glob("*.sh")):
            if os.access(path, os.X_OK):
                hits = [i for i, line in enumerate(path.read_text().splitlines(), 1)
                        if CALL.search(line) and not line.lstrip().startswith("#")]
                if hits:
                    callers.append({"path": str(path), "lines": hits, "owner": path.stem,
                                    "class": "lifecycle reinvite", "replacement": "feed event"})
    return callers


def inventory(args):
    env = effective_env(args.env)
    manifest = manifests(args.restore)
    retired = set(env["MESH_RETIRED_CHANNELS"].split())
    operator_stop = env["MESH_MIND_CHANNELS"] == "__operator_stopped__"
    configured = [] if operator_stop else env["MESH_MIND_CHANNELS"].split()
    errors = []
    for label, values in (("configured", configured), ("retired", list(retired))):
        if len(values) != len(set(values)) or any(not NAME.fullmatch(v) for v in values):
            errors.append(f"invalid or duplicate {label} channel")
    for ch in configured:
        if ch not in manifest and ch != "tiny-fleet":
            errors.append(f"unknown configured channel: {ch}")
    if retired & set(configured):
        errors.append("configured and retired channel overlap")
    session = args.session or (run("hostname") or "").strip()
    panes = pane_state(session)
    live = {ch for ch, count in panes.items() if count >= 2 and ch not in {"codex", "witness"}}
    live_data = set(panes) & set(manifest) - retired - {"codex"}
    unknown_live = live - set(manifest) - {"tiny-fleet"}
    errors.extend(f"unknown live channel: {ch}" for ch in sorted(unknown_live))
    card = args.card.read_text() if args.card.exists() else ""
    cap_match = re.search(r"^\s*minds:\s*(.*)$", card, re.M)
    capabilities = cap_match.group(1).split() if cap_match else []
    overrides = {}
    for item in env["MESH_CONSUME_CHANNELS"].split():
        source, sep, interval = item.partition(":")
        source = source.split(">", 1)[0]
        if sep and interval.isdigit():
            overrides[source] = int(interval)
    rows = []
    ps = run("ps", "-eo", "args=") or ""
    cron = run("crontab", "-l") or ""
    sockets = run("ss", "-lxnp") or ""
    task_queue = run("mesh-task", "queue", "--dispatch")
    task_owners = {}
    if task_queue is None:
        errors.append("task owner journal unavailable")
    else:
        for line in task_queue.splitlines():
            fields = line.split("\t")
            if len(fields) != 4 or fields[0] == "owner":
                continue
            owner = fields[0].strip()
            if not owner or owner.lower() in {"none", "unowned", "unknown"}:
                errors.append("unowned task in dispatch queue")
            else:
                task_owners[owner] = task_owners.get(owner, 0) + 1
    for ch in sorted(set(configured) | live | live_data):
        if ch == "witness":
            reasons = []
            if panes.get(ch) != 1:
                reasons.append("one-shot witness requires exactly one data pane")
            if ch in configured:
                reasons.append("one-shot witness must not be in resident mind allowlist")
            if ch not in manifest:
                reasons.append("one-shot witness absent from restore manifest")
            charter = args.charters / "witness.md"
            if not charter.is_file():
                reasons.append("missing charter")
            consumer_process = bool(re.search(r"mesh-pane-consume\s+witness(?:\s|$)", ps))
            if consumer_process:
                reasons.append("one-shot witness has a resident consumer")
            renderer_cmd = run("tmux", "display-message", "-t", f"{session}:witness.0", "-p", "#{pane_start_command}") if ch in panes else None
            top = run("tmux", "capture-pane", "-p", "-t", f"{session}:witness.0", "-S", "-100") if ch in panes else None
            lease = re.search(r"pane live(?:\s*:\s*as of)?\s+(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)", top or "")
            if not lease or (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(lease.group(1).replace("Z", "+00:00"))).total_seconds() > 180:
                reasons.append("stale or unrecognized top-pane lease")
            rows.append({"channel": ch, "state": "one-shot-data-only", "disposition": "guarded S0/S1; no resident mind",
                         "renderer_role": manifest.get(ch), "renderer_command": renderer_cmd,
                         "engine": "omp", "model": env.get("MESH_MISHE_WITNESS_MODEL") or None,
                         "wake_rule": "projected RED and explicit S1 verdict; hold controls authority",
                         "privacy_class": "private", "risk_class": "human",
                         "allowed_sink": "mesh-mishe-mind-sink", "protected_side_effects": [],
                         "charter": str(charter), "pane_count": panes.get(ch, 0), "consumer_process": consumer_process,
                         "poll_seconds": 60,
                         "launch_allowed": False, "issues": reasons})
            errors.extend(f"{ch}: {reason}" for reason in reasons)
            continue
        active = ch in live and ch in configured and ch not in retired
        # Effective selected command is resolved in a restricted subprocess below.
        cmd = effective_command(args.env, ch)
        declared_engine = engine(cmd)
        pane_cmd = run("tmux", "display-message", "-t", f"{session}:{ch}.1", "-p", "#{pane_start_command}") if ch in live else None
        renderer_cmd = run("tmux", "display-message", "-t", f"{session}:{ch}.0", "-p", "#{pane_start_command}") if ch in live_data else None
        live_engine = engine(pane_cmd or "")
        charter = args.charters / f"{ch}.md"
        reasons = []
        if ch in live and ch not in configured and not operator_stop:
            reasons.append("live window absent from mind allowlist")
        if ch in configured and ch not in live and ch != "tiny-fleet":
            reasons.append("configured channel has no live two-pane window")
        if active and ch not in manifest:
            reasons.append("live window absent from restore manifest")
        if active and not charter.is_file():
            reasons.append("missing charter")
        if active and panes[ch] != 2:
            reasons.append("unexpected pane count")
        if active and not live_engine:
            reasons.append("mind engine absent from pane")
        if active and live_engine not in capabilities:
            reasons.append("mind engine absent from card")
        if active and declared_engine != live_engine:
            reasons.append("configured/live engine disagreement")
        consumer_process = bool(re.search(rf"mesh-pane-consume\s+{re.escape(ch)}(?:\s|$)", ps))
        if active and not consumer_process:
            reasons.append("active channel has no consumer process")
        # The footer can sit above the final twelve lines on tall or split panes.
        top = run("tmux", "capture-pane", "-p", "-t", f"{session}:{ch}.0", "-S", "-100") if active else None
        if active and (not top or "pane live" not in top.lower()):
            reasons.append("stale or unrecognized top-pane lease")
        elif active:
            lease = re.search(r"pane live(?:\s*:\s*as of)?\s+(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)", top)
            if not lease or (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(lease.group(1).replace("Z", "+00:00"))).total_seconds() > 180:
                reasons.append("stale top-pane lease")
        rows.append({"channel": ch, "state": "active" if active else "suspended-data-only" if operator_stop and ch in live_data else "configured-inactive" if ch in configured else "unconfigured-live",
                     "disposition": "operator-stopped; read-only shadow observation" if operator_stop and ch in live_data else "no live window; no automatic launch" if ch == "tiny-fleet" and not active else None,
                     "renderer_role": manifest.get(ch), "renderer_command": renderer_cmd,
                     "engine": live_engine or declared_engine,
                     "model": model(cmd), "poll_seconds": overrides.get(ch, 60),
                     "wake_rule": "pane change, exact-owner task, prediction expiry; legacy authority",
                     "prediction_source": "mesh-wake-expect", "task_owner_rule": f"exact owner={ch}",
                     "exact_owner_queued_tasks": task_owners.get(ch, 0),
                     "privacy_class": "private" if ch in PRIVATE else "internal",
                     "risk_class": "protected" if ch in {"vpn", "health"} else "human" if ch in PRIVATE else "standard",
                     "allowed_sink": "mesh-tell via authority fence", "protected_side_effects": PROTECTED.get(ch, []),
                     "charter": str(charter), "pane_count": panes.get(ch, 0),
                     "consumer_process": consumer_process,
                     "launch_allowed": bool(active and live_engine in capabilities),
                     "cron_ref_count": sum(1 for line in cron.splitlines() if ch in line and not line.lstrip().startswith("#")),
                     "socket_ref": ch in sockets, "issues": reasons})
        errors.extend(f"{ch}: {reason}" for reason in reasons)
    callers = caller_inventory(args.scripts, args.mesh)
    for caller in callers:
        name = caller["owner"]
        caller["running_process"] = bool(re.search(rf"(?:^|[/\s]){re.escape(name)}(?:\s|$)", ps, re.M))
        caller["installed_cron"] = any(re.search(rf"(?:^|[/\s]){re.escape(name)}(?:\s|$)", line)
                                       for line in cron.splitlines() if not line.lstrip().startswith("#"))
        caller["socket_ref"] = name in sockets
    errors.extend(f"unclassified direct caller: {c['owner']}" for c in callers if c["class"] == "unclassified")
    return {"schema": 1, "status": "FAIL" if errors else "PASS", "session": session,
            "channels": rows, "retired": sorted(retired), "direct_callers": callers,
            "errors": errors}


def effective_command(path, channel):
    name = "MESH_" + channel.upper().replace("-", "") + "_CMD"
    code = 'source "$1" >/dev/null 2>&1; n="$2"; printf "%s" "${!n:-${MESH_PRIMARY_MIND_CMD:-}}"'
    p = subprocess.run(["bash", "-c", code, "_", str(path), name], stdout=subprocess.PIPE)
    return p.stdout.decode() if p.returncode == 0 else ""


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--env", type=Path, default=MESH / "restore.env")
    parser.add_argument("--restore", type=Path, default=ROOT / "scripts/mesh-restore")
    parser.add_argument("--scripts", type=Path, default=ROOT / "scripts")
    parser.add_argument("--mesh", type=Path, default=MESH)
    parser.add_argument("--charters", type=Path, default=MESH / "charter")
    parser.add_argument("--card", type=Path, default=HOME / ".mesh-card")
    parser.add_argument("--session")
    args = parser.parse_args()
    try:
        result = inventory(args)
    except (OSError, ValueError) as exc:
        result = {"schema": 1, "status": "FAIL", "errors": [str(exc)]}
    summary = (f"mesh-mishe-channels {result['status']}: {len(result.get('channels', []))} rows, "
               f"{len(result.get('direct_callers', []))} callers")
    if result["errors"]:
        summary += "; " + "; ".join(result["errors"])
    print(json.dumps(result, sort_keys=True, indent=2) if args.json else summary)
    return 1 if args.check and result["status"] != "PASS" else 0


if __name__ == "__main__":
    sys.exit(main())
