#!/usr/bin/env sh
# mesh-steward-deadman — last-resort alarm for "the mesh's only mind went silent".
#
# IdeaPad is currently the only always-on MIND. If it dies (crash/power/hang), every IdeaPad-hosted
# reflex dies with it and NOTHING tells the operator. This dead-man lives on the always-on ROUTER
# (independent of IdeaPad) and shouts via Telegram if the steward's heartbeat goes stale.
#
# Two modes:
#   mesh-steward-deadman --beat        run ON the steward (IdeaPad) by cron: push a fresh heartbeat
#                                      to the router (echo epoch > /etc/mesh-steward-beat over SSH)
#   mesh-steward-deadman --check       run ON the router by cron: if the beat is older than
#                                      STALE_SEC, alert the operator via Telegram (once per outage)
#   mesh-steward-deadman --test        smoke test
#
# busybox-sh compatible (the router has no bash/python — curl + ash only).
# ARM-GATED (operator's call, secret boundary): --check only alerts if BOTH exist on the router:
#   /etc/mesh-tg-token  (bot token)   and   /etc/mesh-tg-chat  (personal CHAT_ID 51010427)
# Until the operator drops those, --check logs but does not send (no token copied by the agent).
ROUTER="${MESH_ROUTER:-$(mesh-peer-addr router 2>/dev/null || mesh-peer-addr GL-MT3000 2>/dev/null)}"; RUSER="${MESH_ROUTER_USER:-root}"
BEAT="${MESH_BEAT_FILE:-/etc/mesh-steward-beat}"
STALE_SEC="${MESH_STALE_SEC:-1800}"          # 30 min silent => steward presumed dead
FLAG=/tmp/mesh-steward-deadman.fired         # edge-trigger: alert once per outage

now() { date +%s; }

case "${1:-}" in
  --test)
    command -v ssh >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (need ssh or curl)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;

  --beat)   # ON IdeaPad: push heartbeat to the router
    ssh -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o BatchMode=yes "$RUSER@$ROUTER" \
        "echo $(now) > $BEAT" 2>/dev/null \
      && echo "beat pushed -> $RUSER@$ROUTER:$BEAT" \
      || { echo "beat push FAILED (router unreachable)" >&2; exit 1; } ;;

  --check)  # ON the router: alert if the beat is stale
    [ -r "$BEAT" ] || { echo "no beat file yet ($BEAT) — waiting for first --beat"; exit 0; }
    last=$(cat "$BEAT" 2>/dev/null); age=$(( $(now) - ${last:-0} ))
    if [ "$age" -lt "$STALE_SEC" ]; then
      rm -f "$FLAG" 2>/dev/null            # healthy: reset edge-trigger
      echo "steward alive (beat ${age}s ago)"; exit 0
    fi
    echo "STEWARD SILENT: beat ${age}s old (>${STALE_SEC}s)"
    [ -f "$FLAG" ] && exit 0               # already alerted this outage
    tok=$(cat /etc/mesh-tg-token 2>/dev/null); chat=$(cat /etc/mesh-tg-chat 2>/dev/null)
    if [ -n "$tok" ] && [ -n "$chat" ]; then
      msg="🚨 mesh: steward IdeaPad SILENT for $((age/60)) min — the mesh's only live mind may be down. Check it."
      curl -s -m10 "https://api.telegram.org/bot$tok/sendMessage" \
           --data-urlencode "chat_id=$chat" --data-urlencode "text=$msg" >/dev/null 2>&1 \
        && { touch "$FLAG"; echo "operator ALERTED via Telegram"; } \
        || echo "alert send FAILED (telegram unreachable)"
    else
      touch "$FLAG"
      echo "DISARMED: would alert, but /etc/mesh-tg-token + /etc/mesh-tg-chat not set on router (operator must drop them)"
    fi ;;

  *) echo "usage: mesh-steward-deadman --beat|--check|--test" >&2; exit 1 ;;
esac
