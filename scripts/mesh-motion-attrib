#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# mesh-motion-attrib — CROSS-SENSE FUSION: camera motion × room occupancy × named-device arrivals
# → WHOSE motion did the lens see? No single sensor answers that: cam-watch says "something moved",
# room-sense says "someone is (not) here", arrivals says "a known device just came/went". Fused:
#
#   QUIET           cam live, no recent motion — genuine calm (only claimable with a LIVE lens)
#   ATTRIBUTED      motion explained: actor=occupant (room-sense PRESENT) or actor=arrival:<name>
#                   (a KNOWN device edge inside the window — someone just walked in)
#   UNATTRIBUTED    motion while room-sense says EMPTY and no known arrival — the alarm-grade
#                   signal (movement nobody accounts for); perimeter/situation-relevant
#   UNCORROBORATED  motion real but occupancy UNCERTAIN/stale — attribution honestly impossible
#   UNKNOWN         cam state stale or CAPTURE-FAIL → the lens is UNREACHABLE/blocked: rendered
#                   loudly + exit 2 (honest n/a), NEVER a silent all-clear
#
# Inputs (all local files, no radio/SSH — cheap enough for 5-min cron):
#   ~/.mesh/.cam-watch.state  label|stats (mtime = cam loop ran-live; ≤60s refresh when healthy)
#   ~/.mesh/.cam-motion       epoch of the last motion detection (stamped pre-cooldown, every hit)
#   ~/.mesh/.room-sense.state PRESENT/EMPTY/UNCERTAIN|dwell_s=... (5-min reflex)
#   ~/.mesh/arrivals.log      [arrived]/[left] <name> edges (mtime = last edge)
# STATE: ~/.mesh/.motion-attrib.state — written unconditionally EVERY run (mtime = liveness,
# no change-gating → no false-STALE class). Node-bound: camera nodes only.
#
#   mesh-motion-attrib          one fused read → verdict line on stdout + state write
#   mesh-motion-attrib --state  print the last written verdict (no fresh eval)
#   mesh-motion-attrib --test   fixture matrix (all 5 classes) + a live well-formed read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

M="${MOTION_ATTRIB_DIR:-$HOME/.mesh}"
CAMSTATE="$M/.cam-watch.state"
CAMMOTION="$M/.cam-motion"
ROOMSTATE="$M/.room-sense.state"
ARRLOG="$M/arrivals.log"
STATE="$M/.motion-attrib.state"
WINDOW="${MOTION_ATTRIB_WINDOW:-300}"      # how recent motion/arrival must be to fuse
CAM_FRESH="${MOTION_ATTRIB_CAM_FRESH:-180}"   # cam-watch refreshes state ≤60s; 3× = stale
ROOM_FRESH="${MOTION_ATTRIB_ROOM_FRESH:-900}" # room-sense is a 5-min reflex; 3× = stale

age_of(){ [ -e "$1" ] && echo $(( $(date +%s) - $(stat -c %Y "$1") )) || echo -1; }

evaluate(){
  local now cam_age label motion_age room_age occ arr_age arr_name v
  now="$(date +%s)"

  # 1) the lens must be LIVE to say anything about the room
  cam_age="$(age_of "$CAMSTATE")"
  if [ "$cam_age" -lt 0 ] || [ "$cam_age" -gt "$CAM_FRESH" ]; then
    echo "UNKNOWN|cam=UNREACHABLE|state_age=${cam_age}s"; return 2
  fi
  label="$(cut -d'|' -f1 "$CAMSTATE" 2>/dev/null)"
  if [ "$label" = "CAPTURE-FAIL" ]; then
    echo "UNKNOWN|cam=CAPTURE-FAIL|state_age=${cam_age}s"; return 2
  fi

  # 2) recent motion?
  motion_age=-1
  [ -s "$CAMMOTION" ] && motion_age=$(( now - $(cat "$CAMMOTION" 2>/dev/null || echo 0) ))
  if [ "$motion_age" -lt 0 ] || [ "$motion_age" -gt "$WINDOW" ]; then
    local lm="never"; [ "$motion_age" -ge 0 ] && lm="${motion_age}s"
    echo "QUIET|cam=$label|last_motion=$lm"; return 0
  fi

  # 3) motion is fresh — attribute it. Arrival edge first (the most specific explanation).
  arr_age="$(age_of "$ARRLOG")"
  if [ "$arr_age" -ge 0 ] && [ "$arr_age" -le "$WINDOW" ]; then
    arr_name="$(grep -oP '^\s*\[arrived\]\s+\K.+' "$ARRLOG" 2>/dev/null | tail -1)"
    [ -n "$arr_name" ] && { echo "ATTRIBUTED|actor=arrival:$arr_name|motion_age=${motion_age}s"; return 0; }
  fi

  # 4) fall to occupancy — honest about a stale/unsure room read
  room_age="$(age_of "$ROOMSTATE")"
  if [ "$room_age" -lt 0 ] || [ "$room_age" -gt "$ROOM_FRESH" ]; then
    echo "UNCORROBORATED|occ=UNKNOWN(room-sense stale ${room_age}s)|motion_age=${motion_age}s"; return 0
  fi
  occ="$(cut -d'|' -f1 "$ROOMSTATE" 2>/dev/null)"
  case "$occ" in
    PRESENT) echo "ATTRIBUTED|actor=occupant|motion_age=${motion_age}s"; return 0 ;;
    EMPTY)   echo "UNATTRIBUTED|occ=EMPTY|motion_age=${motion_age}s"; return 0 ;;
    *)       echo "UNCORROBORATED|occ=${occ:-?}|motion_age=${motion_age}s"; return 0 ;;
  esac
}

if [ "${1:-}" = --state ]; then cat "$STATE" 2>/dev/null || { echo "no state yet" >&2; exit 1; }; exit 0; fi

if [ "${1:-}" = --test ]; then
  T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
  fx(){ MOTION_ATTRIB_DIR="$T" MOTION_ATTRIB_WINDOW=300 "$0"; }
  # (a) cam state missing → UNKNOWN + rc=2 (unreachable ≠ quiet)
  out="$(fx)"; rc=$?
  [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|cam=UNREACHABLE' \
    || { echo "smoke-test: FAIL (missing cam state → got rc=$rc '$out', want UNKNOWN rc=2)"; exit 1; }
  # (b) CAPTURE-FAIL label → UNKNOWN (a blocked lens can't claim calm)
  echo 'CAPTURE-FAIL|-' > "$T/.cam-watch.state"
  out="$(fx)"; rc=$?
  [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|cam=CAPTURE-FAIL' \
    || { echo "smoke-test: FAIL (CAPTURE-FAIL → got '$out')"; exit 1; }
  # (c) live lens, no motion → QUIET
  echo 'DARK|diff=0.1|mean=17|span=2' > "$T/.cam-watch.state"
  out="$(fx)" || { echo "smoke-test: FAIL (quiet rc)"; exit 1; }
  printf '%s' "$out" | grep -q '^QUIET|cam=DARK|last_motion=never' \
    || { echo "smoke-test: FAIL (quiet → got '$out')"; exit 1; }
  # (d) fresh motion + room PRESENT → ATTRIBUTED occupant
  date +%s > "$T/.cam-motion"
  echo 'PRESENT|dwell_s=100|changes_24h=3' > "$T/.room-sense.state"
  out="$(fx)" && printf '%s' "$out" | grep -q '^ATTRIBUTED|actor=occupant' \
    || { echo "smoke-test: FAIL (occupant → got '$out')"; exit 1; }
  # (e) fresh motion + fresh [arrived] edge wins attribution with the NAME
  printf 'header line\n  [arrived] Quest 3\n' > "$T/arrivals.log"
  out="$(fx)" && printf '%s' "$out" | grep -q '^ATTRIBUTED|actor=arrival:Quest 3' \
    || { echo "smoke-test: FAIL (arrival → got '$out')"; exit 1; }
  # (f) fresh motion + room EMPTY, no arrival → UNATTRIBUTED (the alarm-grade class)
  rm -f "$T/arrivals.log"
  echo 'EMPTY|dwell_s=50|changes_24h=3' > "$T/.room-sense.state"
  out="$(fx)" && printf '%s' "$out" | grep -q '^UNATTRIBUTED|occ=EMPTY' \
    || { echo "smoke-test: FAIL (unattributed → got '$out')"; exit 1; }
  # (g) fresh motion + stale room state → UNCORROBORATED, never a guessed attribution
  touch -d '1 hour ago' "$T/.room-sense.state"
  out="$(fx)" && printf '%s' "$out" | grep -q '^UNCORROBORATED|occ=UNKNOWN' \
    || { echo "smoke-test: FAIL (stale room → got '$out')"; exit 1; }
  # (h) REAL read: the live eval must emit a well-formed verdict (rc 0, or honest 2 if lens down)
  out="$("$0")"; rc=$?
  { [ "$rc" = 0 ] || [ "$rc" = 2 ]; } && printf '%s' "$out" | grep -qE '^(QUIET|ATTRIBUTED|UNATTRIBUTED|UNCORROBORATED|UNKNOWN)\|' \
    || { echo "smoke-test: FAIL (live read malformed: rc=$rc '$out')"; exit 1; }
  # (i) NODE-BOUND gate: this tool FUSES a producer's output — it has no organ of its own. Its input is
  # mesh-cam-watch's .cam-watch.state (a node-specific systemd unit, on-demand canon: deployed only on
  # camera nodes). cam=UNREACHABLE with no state file means the producer does not run HERE, so every
  # eval is a structural UNKNOWN forever. Before this, (a)-(g) proved the classifier against SYNTHETIC
  # fixtures in a tmpdir and (h) accepted rc=2, so --test exited 0 on a node with no lens at all →
  # autowire read PASS instead of n/a and cron-wired it → 71/71 identical "UNKNOWN|cam=UNREACHABLE|
  # state_age=-1s" on mesh-home, every 5 min since 2026-07-14. A consumer's real-read gate must require
  # its PRODUCER exactly as a sensor's requires its hardware: absent ⇒ exit 2 (honest n/a), which
  # autowire SKIPs and mesh-land passes. Self-healing: deploy cam-watch here and the next autowire
  # */30 sees PASS and wires it. CAPTURE-FAIL is NOT n/a — the producer runs, the lens is merely
  # blocked, and reporting UNKNOWN is then the correct live verdict.
  if printf '%s' "$out" | grep -q '^UNKNOWN|cam=UNREACHABLE'; then
    echo "smoke-test: n/a — no live lens on $(hostname): mesh-cam-watch does not run here, so $CAMSTATE is absent/stale ($out). Classifier fixtures (a)-(g) all passed; this tool is sound, its producer is simply not on this node."
    exit 2
  fi
  echo "smoke-test: ok"; exit 0
fi

# --- one fused read: evaluate, write state unconditionally (mtime = ran-live), echo ---
v="$(evaluate)"; rc=$?
printf '%s\n' "$v" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
echo "$v"
exit "$rc"
