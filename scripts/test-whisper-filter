#!/usr/bin/env python3
"""test-whisper-filter — verifiable artifact for mesh-whisper-filter.

Creates synthetic wav clips (no mic needed) and runs all three filter stages.
Exit 0 = all assertions passed.  Exit 1 = failure (prints which case failed).
"""
import subprocess, sys, wave, struct, math, os, tempfile

FILTER = os.path.expanduser("~/.local/bin/mesh-whisper-filter")

# ── Wav generators ───────────────────────────────────────────────────────────

def make_wav(path, samples, rate=16000):
    with wave.open(path, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(rate)
        wf.writeframes(struct.pack(f"<{len(samples)}h", *samples))

def silent_wav(duration_s=1.0, rate=16000):
    """All-zero samples — RMS = 0."""
    n = int(duration_s * rate)
    return [0] * n

def near_silent_wav(duration_s=1.0, rate=16000, amplitude=50):
    """Very low amplitude noise — RMS well below threshold 300."""
    import random; rng = random.Random(42)
    n = int(duration_s * rate)
    return [rng.randint(-amplitude, amplitude) for _ in range(n)]

def speech_wav(duration_s=1.0, rate=16000, amplitude=8000, freq=440):
    """Synthetic speech-level tone — RMS ~5600, clearly above threshold."""
    n = int(duration_s * rate)
    return [int(amplitude * math.sin(2 * math.pi * freq * i / rate)) for i in range(n)]

# ── Test runner ──────────────────────────────────────────────────────────────

def run_filter(*args):
    r = subprocess.run([FILTER] + list(args), capture_output=True, text=True)
    return r.returncode, r.stdout.strip()

passed = failed = 0

def check(name, expected_exit, *args):
    global passed, failed
    code, out = run_filter(*args)
    ok = code == expected_exit
    status = "PASS" if ok else "FAIL"
    verdict = "DROP" if expected_exit == 1 else "PASS"
    print(f"  [{status}] {name}: expected {verdict}, got exit={code} '{out}'")
    if ok:
        passed += 1
    else:
        failed += 1

print("=== mesh-whisper-filter test suite ===\n")

with tempfile.TemporaryDirectory() as td:
    silent   = os.path.join(td, "silent.wav")
    nearquiet= os.path.join(td, "nearquiet.wav")
    speech   = os.path.join(td, "speech.wav")
    tooshort = os.path.join(td, "tooshort.wav")

    make_wav(silent,    silent_wav(1.0))
    make_wav(nearquiet, near_silent_wav(1.0, amplitude=50))
    make_wav(speech,    speech_wav(1.0))
    make_wav(tooshort,  speech_wav(0.05))   # 0.05s = 800 samples < MIN_SPEECH_SAMPLES

    # ── Stage 1: energy / silence gate ──────────────────────────────────────
    print("Stage 1 — energy/silence gate:")
    check("all-zero wav (silence)",         1, "--wav", silent)
    check("near-silent wav (RMS ~29)",      1, "--wav", nearquiet)
    check("speech-level tone (RMS ~5600)",  0, "--wav", speech)
    check("too-short clip (0.05s)",         1, "--wav", tooshort)

    # ── Stage 2: boilerplate drop ────────────────────────────────────────────
    print("\nStage 2 — boilerplate/hallucination drop:")
    check("'Thanks for watching'",          1, "--text", "Thanks for watching!")
    check("'thank you for watching'",       1, "--text", "Thank you for watching.")
    check("'Please subscribe'",             1, "--text", "Please subscribe to my channel.")
    check("'продолжение следует'",          1, "--text", "продолжение следует...")
    check("'[BLANK_AUDIO]'",                1, "--text", "[BLANK_AUDIO]")
    check("'ご視聴ありがとうございました'", 1, "--text", "ご視聴ありがとうございました")

    # ── Stage 3: repetition / entropy gate ───────────────────────────────────
    print("\nStage 3 — repetition/entropy gate:")
    check("single-word repetition (JANU×4)",     1, "--text", "JANU JANU JANU JANU")
    check("low-entropy string (JANUJANU...)",     1, "--text", "JANUJANUJANU")
    check("empty after cleanup (*sound*)",        1, "--text", "*wind noise*")
    check("no real word content (punctuation)",   1, "--text", "... ...")

    # ── PASS cases: real speech ───────────────────────────────────────────────
    print("\nReal speech — must PASS:")
    check("English command",    0, "--text", "Turn on the lights in the living room.")
    check("Russian command",    0, "--text", "Включи свет на кухне.")
    check("Short real phrase",  0, "--text", "Yes okay.")
    check("Numeric content",    0, "--text", "Set timer 10 minutes.")

    # ── Combined wav + text ───────────────────────────────────────────────────
    print("\nCombined --wav + --text:")
    check("silent wav blocks real text",    1, "--wav", silent,  "--text", "Turn on the lights.")
    check("speech wav + real text passes",  0, "--wav", speech,  "--text", "Turn on the lights.")
    check("speech wav + boilerplate drops", 1, "--wav", speech,  "--text", "Thanks for watching!")

print(f"\n=== {passed} passed, {failed} failed ===")
sys.exit(0 if failed == 0 else 1)
