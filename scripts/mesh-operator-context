#!/usr/bin/env bash
# mesh-operator-context — the META-FUSION: "what is the operator doing right now?"
# Fuses 5 senses into one answer:
#   mesh-body-motion (STILL/WALKING/CARRIED/HANDLED/COVERED)
#   mesh-grip (HELD/PUT-DOWN)
#   mesh-ambient-level (SILENCE/QUIET/MODERATE/LOUD)
#   mesh-light (DARK/DIM/LIT/BRIGHT)
#   mesh-proximity (HERE/NEAR/FAR/OUT_OF_RANGE)
#
# Classification:
#   AT_COMPUTER   — holding phone, at rest, room has ambient activity (operator present, working)
#   PASSIVE       — holding phone, at rest, quiet room (phone nearby but not in active use)
#   ACTIVE_MOBILE — walking/carrying, or loud+motion (operator moving through space)
#   RESTING       — dark, quiet, still, no proximity (operator away or sleeping)
#   UNCERTAIN     — inputs disagree or unavailable
#
# UNREACHABLE ≠ RESTING: a phone we can't reach renders [unreachable] explicitly.
#
#   mesh-operator-context           one classified line
#   mesh-operator-context --json    machine-readable
#   mesh-operator-context --edge    emit only on state change
#   mesh-operator-context --test    smoke test (exit 2 = phone unreachable)
#   mesh-operator-context --verbose show all inputs
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.operator-context-state"
OFFLINEFILE="$HOME/.mesh/.operator-context-offline"

# --- Test mode ---
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # Classifier tests with synthetic state
  _f=0
  _classify() {
    python3 -c '
import sys, re
body=sys.argv[1]; grip=sys.argv[2]; ambient=sys.argv[3]; light=sys.argv[4]; prox=sys.argv[5]
# Extract state tag from body-motion STATE format: |<step>|<tag>|<hyst>
m = re.search(r"\[([^\]]+)\]", body)
body = m.group(1).upper().replace("BODY-", "") if m else body.strip()
grip = grip.strip().split()[0] if grip.strip() else ""
ambient = ambient.strip()
light = light.strip()
prox = prox.strip()

unreachable = any(v in ("UNREACHABLE","","MISSING") for v in [body, grip, ambient, light, prox])
if unreachable:
    parts = []
    for name, val in [("body", body), ("grip", grip), ("ambient", ambient), ("light", light), ("prox", prox)]:
        if val in ("UNREACHABLE","","MISSING"):
            parts.append(name)
    print(f"[unreachable:{",".join(parts)}] UNCERTAIN")
    sys.exit(0)

walking = body in ("WALKING", "CARRIED")
handled = body == "HANDLED"
covered = body == "COVERED"
held = grip == "HELD"
loud = ambient in ("LOUD", "MODERATE")
bright = light in ("LIT", "BRIGHT")
nearby = prox in ("HERE", "NEAR")

if walking:
    tag, st = "[operator-mobile]", "ACTIVE_MOBILE"
elif handled and loud:
    tag, st = "[operator-active]", "ACTIVE_MOBILE"
elif held and not walking and loud and not bright:
    tag, st = "[operator-at-computer]", "AT_COMPUTER"
elif held and not walking and bright:
    tag, st = "[operator-at-computer]", "AT_COMPUTER"
elif held and not walking:
    tag, st = "[operator-passive]", "PASSIVE"
elif not held and not walking and not loud and not bright:
    tag, st = "[operator-resting]", "RESTING"
else:
    tag, st = "[operator-uncertain]", "UNCERTAIN"

print(f"{tag} {st}")
' "$1" "$2" "$3" "$4" "$5"
  }
  # AT_COMPUTER: held, still, loud, not bright
  r="$(_classify '|[body-still]|2' 'HELD 5 17593' 'LOUD' 'DARK' 'OUT_OF_RANGE')"
  echo "$r" | grep -q 'AT_COMPUTER' || { echo "  FAIL: held+still+loud+dark → AT_COMPUTER, got: $r"; _f=1; }
  # PASSIVE: held, still, quiet
  r="$(_classify '|[body-still]|2' 'HELD 2 3000' 'QUIET' 'DIM' 'NEAR')"
  echo "$r" | grep -q 'PASSIVE' || { echo "  FAIL: held+still+quiet+dim → PASSIVE, got: $r"; _f=1; }
  # ACTIVE_MOBILE: walking
  r="$(_classify '|[body-walking]|2' 'PUT-DOWN 0 0' 'LOUD' 'LIT' 'OUT_OF_RANGE')"
  echo "$r" | grep -q 'ACTIVE_MOBILE' || { echo "  FAIL: walking → ACTIVE_MOBILE, got: $r"; _f=1; }
  # RESTING: dark, quiet, not held
  r="$(_classify '|[body-still]|2' 'PUT-DOWN 0 0' 'SILENCE' 'DARK' 'OUT_OF_RANGE')"
  echo "$r" | grep -q 'RESTING' || { echo "  FAIL: dark+quiet+put-down → RESTING, got: $r"; _f=1; }
  # UNREACHABLE: missing grip
  r="$(_classify '|[body-still]|2' '' 'LOUD' 'DARK' 'OUT_OF_RANGE')"
  echo "$r" | grep -q 'unreachable' || { echo "  FAIL: missing grip → unreachable, got: $r"; _f=1; }
  # ACTIVE_MOBILE: handled + loud
  r="$(_classify '|[body-handled]|2' 'PUT-DOWN 0 0' 'LOUD' 'DARK' 'OUT_OF_RANGE')"
  echo "$r" | grep -q 'ACTIVE_MOBILE' || { echo "  FAIL: handled+loud → ACTIVE_MOBILE, got: $r"; _f=1; }
  # ACTIVE_MOBILE: carried
  r="$(_classify '|[body-carried]|2' 'PUT-DOWN 0 0' 'QUIET' 'DARK' 'OUT_OF_RANGE')"
  echo "$r" | grep -q 'ACTIVE_MOBILE' || { echo "  FAIL: carried → ACTIVE_MOBILE, got: $r"; _f=1; }
  [ "$_f" = 0 ] && { echo "smoke-test: ok (8 assertions)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

MODE=text; EDGE=0; VERBOSE=0
for a in "$@"; do case "$a" in --json) MODE=json;; --edge) EDGE=1;; --verbose) VERBOSE=1;; esac; done

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Read state files ---
_body_motion=""; _grip=""; _ambient=""; _light=""; _prox=""

# body-motion: extract tag from STATE file (|<step>|<tag>|<hyst>)
if [ -f "$HOME/.mesh/.body-motion-state" ]; then
  _body_motion="$(cut -d'|' -f2 "$HOME/.mesh/.body-motion-state" 2>/dev/null | tr -d '[]')"
fi

# grip: first word from STATE file
if [ -f "$HOME/.mesh/.grip-state" ]; then
  _grip="$(awk '{print $1}' "$HOME/.mesh/.grip-state" 2>/dev/null)"
fi

# ambient-level: full content
if [ -f "$HOME/.mesh/.ambient-level" ]; then
  _ambient="$(cat "$HOME/.mesh/.ambient-level" 2>/dev/null | head -1)"
fi

# light: first word
if [ -f "$HOME/.mesh/.light-state" ]; then
  _light="$(awk '{print $1}' "$HOME/.mesh/.light-state" 2>/dev/null)"
fi

# proximity: first word
if [ -f "$HOME/.mesh/.proximity.state" ]; then
  _prox="$(awk '{print $1}' "$HOME/.mesh/.proximity.state" 2>/dev/null)"
fi

# --- Check for unreachable inputs ---
_UNREACHABLE=()
[ -z "$_body_motion" ] && _UNREACHABLE+=("body-motion")
[ -z "$_grip" ] && _UNREACHABLE+=("grip")
[ -z "$_ambient" ] && _UNREACHABLE+=("ambient")
[ -z "$_light" ] && _UNREACHABLE+=("light")
[ -z "$_prox" ] && _UNREACHABLE+=("prox")

if [ ${#_UNREACHABLE[@]} -gt 0 ]; then
  _joined="$(IFS=,; echo "${_UNREACHABLE[*]}")"
  tag="[unreachable:${_joined}] operator-uncertain"
  state="UNCERTAIN"
else
  # --- Classify ---
  result="$(python3 -c "
body='${_body_motion}'
grip='${_grip}'
ambient='${_ambient}'
light='${_light}'
prox='${_prox}'

walking = body in ('WALKING', 'CARRIED')
handled = body == 'HANDLED'
covered = body == 'COVERED'
held = grip == 'HELD'
loud = ambient in ('LOUD', 'MODERATE')
bright = light in ('LIT', 'BRIGHT')

if walking:
    tag, st = '[operator-mobile]', 'ACTIVE_MOBILE'
elif handled and loud:
    tag, st = '[operator-active]', 'ACTIVE_MOBILE'
elif held and not walking and loud and not bright:
    tag, st = '[operator-at-computer]', 'AT_COMPUTER'
elif held and not walking and bright:
    tag, st = '[operator-at-computer]', 'AT_COMPUTER'
elif held and not walking:
    tag, st = '[operator-passive]', 'PASSIVE'
elif not held and not walking and not loud and not bright:
    tag, st = '[operator-resting]', 'RESTING'
else:
    tag, st = '[operator-uncertain]', 'UNCERTAIN'

print(f'{tag} {st}')
" 2>/dev/null)"
  tag="$(echo "$result" | awk '{print $1}')"
  state="$(echo "$result" | awk '{print $2}')"
fi

# --- Read previous state ---
prev_state=""
if [ -f "$STATE" ]; then read -r prev_state _ < "$STATE" 2>/dev/null || true; fi

# --- Write state ---
printf '%s %s %s %s %s %s %s\n' "$state" "$_body_motion" "$_grip" "$_ambient" "$_light" "$_prox" "$TS" > "$STATE"

# --- Edge trigger ---
if [ "$EDGE" = 1 ]; then [ "$state" = "$prev_state" ] && exit 0; fi

# --- Output ---
case "$MODE" in
  json)
    printf '{"state":"%s","body":"%s","grip":"%s","ambient":"%s","light":"%s","prox":"%s","ts":"%s"}\n' \
      "$state" "$_body_motion" "$_grip" "$_ambient" "$_light" "$_prox" "$TS"
    ;;
  verbose)
    printf '%s %s — body=%s grip=%s ambient=%s light=%s prox=%s\n' \
      "$tag" "$state" "$_body_motion" "$_grip" "$_ambient" "$_light" "$_prox"
    ;;
  *)
    printf '%s %s\n' "$tag" "$state"
    ;;
esac
