#!/usr/bin/env bash
# reflex-cadence: 5-59/10 * * * *
# reflex-args: --edge
# mesh-note3-battery — the authorized Samsung Galaxy Note3's ADB battery sense.
# Reads the selected SM-N900 with `dumpsys battery`; this is distinct from mesh-body-power,
# which reads the Redmi body over Termux SSH, and from mesh-battery, which reads this node's sysfs.
#
#   mesh-note3-battery          one-shot normalized battery reading
#   mesh-note3-battery --json   machine-readable reading
#   mesh-note3-battery --edge   persist and post only a changed battery signature
#   mesh-note3-battery --test   fixture parser + live ADB read gate
#
# Honest contract: an absent/unreachable ADB device, malformed output, or a missing acceptance
# field exits 2 and never writes a plausible-looking reading. Temperature is normalized from
# Android's tenths-of-a-degree Celsius to degrees Celsius.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"
SERIAL="${MESH_NOTE3_BATTERY_SERIAL:-${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}}"
STATE="$MESH/.note3-battery-state"
BOARD="${MESH_NOTE3_BATTERY_BOARD:-$MESH/chat.log}"

# parse_battery <dumpsys battery text> -> pipe-separated normalized fields.
# Required fields are deliberately the same acceptance predicate as the discovery artifact.
parse_battery() {
  awk -F': *' '
    function clean(v) { gsub(/[\r]/, "", v); return v }
    { key=$1; gsub(/^[ \t]+|[ \t]+$/, "", key) }
    key == "present" { present=clean($2) }
    key == "level" { level=clean($2) }
    key == "scale" { scale=clean($2) }
    key == "temperature" { temperature=clean($2) }
    key == "AC powered" { ac=clean($2) }
    key == "USB powered" { usb=clean($2) }
    key == "Wireless powered" { wireless=clean($2) }
    key == "status" { status=clean($2) }
    key == "voltage" { voltage=clean($2) }
    END {
      if (present !~ /^(true|false)$/ || level !~ /^[0-9]+$/ || scale !~ /^[0-9]+$/ ||
          temperature !~ /^-?[0-9]+$/ || ac !~ /^(true|false)$/ || usb !~ /^(true|false)$/ ||
          wireless !~ /^(true|false)$/) exit 1
      source=(usb=="true" ? "USB" : (ac=="true" ? "AC" : (wireless=="true" ? "WIRELESS" : "BATTERY")))
      printf "%s|%s|%s|%s|%s|%s|%s|%s", present, level, scale, temperature, source, status, voltage, ac
    }'
}

read_raw() {
  if [ -n "${MESH_NOTE3_BATTERY_RAW_OVERRIDE:-}" ]; then
    printf '%s\n' "$MESH_NOTE3_BATTERY_RAW_OVERRIDE"
    return 0
  fi
  [ -n "$SERIAL" ] || return 1
  timeout 15 adb -s "$SERIAL" shell dumpsys battery 2>/dev/null | tr -d '\r'
}

if [ "${1:-}" = --test ]; then
  fail=0
  fixture='AC powered: false
USB powered: true
Wireless powered: false
status: 5
present: true
level: 100
scale: 100
temperature: 271
voltage: 4302'
  got="$(MESH_NOTE3_BATTERY_RAW_OVERRIDE="$fixture" "$0" --json 2>/dev/null)" || {
    echo 'smoke-test: FAIL (fixture read rejected)'; exit 1;
  }
  case "$got" in *'"present":true'*'"level":100'*'"scale":100'*'"temperature_c":27.1'*'"power_source":"USB"'*) :;;
    *) echo "smoke-test: FAIL (fixture acceptance fields missing: $got)"; exit 1;;
  esac
  bad='present: true
level: 100
scale: 100
temperature: nope
USB powered: true'
  if MESH_NOTE3_BATTERY_RAW_OVERRIDE="$bad" "$0" --json >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (malformed temperature accepted)'; exit 1
  fi
  raw="$(read_raw 2>/dev/null || true)"
  parsed="$(printf '%s\n' "$raw" | parse_battery 2>/dev/null || true)"
  if [ -z "$parsed" ]; then
    [ "$fail" = 0 ] || exit 1
    echo "smoke-test: n/a (ADB serial $SERIAL unreachable or battery fields unavailable; fixture acceptance passed)"
    exit 2
  fi
  echo "smoke-test: ok (fixture acceptance + live ADB serial $SERIAL read)"
  exit 0
fi

raw="$(read_raw 2>/dev/null || true)"
parsed="$(printf '%s\n' "$raw" | parse_battery 2>/dev/null || true)"
if [ -z "$parsed" ]; then
  echo "note3-battery: UNREACHABLE (ADB serial $SERIAL offline/unreadable or required fields missing)" >&2
  exit 2
fi
IFS='|' read -r present level scale temperature source status voltage ac <<<"$parsed"
temperature_c="$(awk -v t="$temperature" 'BEGIN { printf "%.1f", t/10 }')"
ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
mkdir -p "$MESH" 2>/dev/null || true
signature="present=$present level=$level/$scale temperature=${temperature_c}°C power=$source status=$status voltage=${voltage}mV"

case "${1:-}" in
  --json)
    printf '{"serial":"%s","present":%s,"level":%s,"scale":%s,"temperature_c":%s,"power_source":"%s","status":%s,"voltage_mv":%s,"ts":"%s"}\n' \
      "$SERIAL" "$present" "$level" "$scale" "$temperature_c" "$source" \
      "${status:-null}" "${voltage:-null}" "$ts"
    ;;
  --edge)
    previous="$(cat "$STATE" 2>/dev/null || true)"
    printf '%s\n' "$signature" > "$STATE"
    if [ "$signature" != "$previous" ]; then
      printf '%s  note3-battery@%s  ::  [note3-battery] %s serial=%s\n' \
        "$ts" "$(hostname)" "$signature" "$SERIAL" >> "$BOARD" 2>/dev/null || true
    fi
    printf 'note3-battery: %s\n' "$signature"
    ;;
  *) printf 'note3-battery: %s serial=%s ts=%s\n' "$signature" "$SERIAL" "$ts" ;;
esac
exit 0
