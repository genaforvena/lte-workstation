#!/usr/bin/env bash
# mesh-body-context — the mesh's SITUATIONAL sense of the body: one line fusing the cheap, proven
# organs into a single human-readable situation, because no single sensor says much but together
# they say a lot. Activity (mesh-body-motion) + ambient light → a stable situational label:
#
#   STILL + dark  → DORMANT   (parked, dark, undisturbed — the normal resting state)
#   STILL + lit   → RESTING   (parked but lights on — someone's around / daytime)
#   CARRIED       → TRAVELLING (being walked with — step delta)
#   HANDLED       → HANDLED   (picked up / moved — interaction or tamper)
#   COVERED       → STOWED    (face-down or pocketed)
# Optional (slower, opt-in): --presence adds who's near (BLE), --location adds where (GPS),
#   --tamper adds a WINDOWED disturbance read (mesh-tamper watches SIGNIFICANT_MOTION for the
#   whole window — it catches a brief bump that the instant body-motion SAMPLE misses between
#   reads). A tamper-fire on a parked body yields a DISTURBED/INTERACTED label that no instant
#   pose alone can produce: STILL-now but disturbed-in-the-window = something just touched it.
#
# Tamper fusion (the richer derived signal — 3 senses, no single sensor gives it):
#   pose=STILL  + tamper=MOVED  → DISTURBED  (parked body was just disturbed; now back at rest —
#                                            body-motion samples STILL and would miss it)
#   pose=HANDLED+ tamper=MOVED  → INTERACTED (in hand AND just disturbed = active handling)
#   pose=STILL  + tamper=QUIET  → DORMANT/RESTING · tamper-clear (CONFIRMED undisturbed — the
#                                 watch ran the whole window and nothing fired)
#   pose=*      + tamper=N/A    → pose label unchanged, but NO tamper-clear marker (an unreachable
#                                 tamper can NOT confirm "undisturbed" — visibly distinct from a
#                                 genuine quiet, never a silent all-clear). Shown as tamper=n/a.
# Honest-degraded: mesh-tamper exits 2 on phone-unreachable (never a fabricated quiet, via its
#   TAMPER_EOF sentinel); that surfaces here as tamper=n/a, distinct from tamper=quiet.
#
#   mesh-body-context              one situational line (body activity + ambient)
#   mesh-body-context --presence   also scan who/what is near the body (BLE — slower)
#   mesh-body-context --location   also add the body's location (GPS — slower)
#   mesh-body-context --power      also read charge state (termux-battery-status — one more
#                             bounded SSH read): STILL+lit+plugged → DOCKED, STILL+lit on
#                             battery stays RESTING; unreachable probe → power=n/a, pose
#                             label unchanged (visibly distinct from on-battery)
#   mesh-body-context --tamper     also watch for a windowed disturbance (blocks ~window s)
#   mesh-body-context --full       activity + presence + location + tamper (the whole picture)
#   mesh-body-context --json       machine-readable JSON output
#   mesh-body-context --test       derive_situ fixtures (offline) + deps + reachability gate
#
# Read-only. Honest-organ: it composes organs that each gate on phone-reachability (exit 2);
# if the body sense is n/a, the context is n/a — never a fabricated situation.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
OFFLINEFILE="$HOME/.mesh/.body-context-offline"
# The composed body organ, as a seam: the n/a path (rc=2) is the one a mind actually meets
# on this node, so --test must be able to DRIVE it. A PATH stub cannot shadow it -- this
# script re-prepends $HOME/.local/bin above, which wins over any dir the caller prepends.
BODY_MOTION_CMD="${MESH_BODY_MOTION_CMD:-mesh-body-motion}"
TAMPER_WINDOW="${MESH_BODY_CONTEXT_TAMPER_WINDOW:-5}"

# classify_power <termux-battery-status json> → plugged|battery|na (pure, offline-testable).
# PLUGGED_* (AC/USB/WIRELESS) → plugged; UNPLUGGED → battery; anything unparseable (probe
# failed, empty, truncated JSON) → na — an unreadable charge read is NOT "on battery".
classify_power() {
  local plugged
  plugged="$(printf '%s' "${1:-}" | grep -oE '"plugged"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | cut -d'"' -f4)"
  case "$plugged" in
    PLUGGED_*) echo "plugged" ;;
    UNPLUGGED) echo "battery" ;;
    *) echo "na" ;;
  esac
}

# derive_situ <tag> <dark 0/1> <tamper: moved|quiet|na|> [power: plugged|battery|na|] → echoes "situ|gloss" (pure, offline-testable).
# The tamper axis is the FUSION: a windowed disturbance the instant pose can miss between samples.
# The power axis is the second FUSION (3 senses: motion+light+charge): a STILL body in a lit room
# reads RESTING ("parked but lights on — someone's around"), but that conflates two worlds — on a
# charger (the normal overnight/desk state, stillness explained by docking) vs on battery in a lit
# room (someone IS around). PLUGGED on a parked body yields DOCKED, which no single sensor gives:
# motion says still, light says lit, power says tethered — together they say docked, not attended.
# power=na (unreachable probe) leaves the pose label UNCHANGED and earns no docked marker — visibly
# distinct from on-battery, never a silent charge claim.
derive_situ() {
  local tag="$1" dark="$2" tamper="${3:-}" power="${4:-}" situ="" gloss=""
  # tamper=MOVED overrides the instant pose: a parked body that was just disturbed is DISTURBED
  # (it may read STILL-now because body-motion samples a single instant and missed the bump).
  if [ "$tamper" = "moved" ]; then
    if [ "$tag" = "[body-handled]" ]; then
      echo "INTERACTED|in hand + just disturbed (active handling)"
    else
      echo "DISTURBED|parked body was just physically disturbed (instant pose ${tag})"
    fi
    return
  fi
  case "$tag" in
    '[body-carried]') situ="TRAVELLING"; gloss="body is being walked with";;
    '[body-handled]') situ="HANDLED";    gloss="body was just picked up / moved";;
    '[body-covered]') situ="STOWED";     gloss="face-down or pocketed";;
    '[body-still]')   if [ "$dark" = 1 ]; then situ="DORMANT";  gloss="parked, dark, undisturbed";
                      else                     situ="RESTING";  gloss="parked, lights on"; fi;;
    *)                situ="UNKNOWN";    gloss="unclassified body state";;
  esac
  # tamper=QUIET on a parked (STILL-derived) body is a CONFIRMED undisturbed: the watch ran the
  # whole window and nothing fired. tamper=na must NOT earn this marker (unreachable ≠ quiet).
  if [ "$tamper" = "quiet" ] && { [ "$situ" = "DORMANT" ] || [ "$situ" = "RESTING" ]; }; then
    gloss="$gloss · tamper-clear (undisturbed)"
  fi
  # power=PLUGGED on a parked body re-labels to DOCKED: stillness explained by the charger, not by
  # attendance. Only the parked labels qualify — a TRAVELLING/HANDLED/STOWED body on a power bank
  # is still travelling/handled/stowed. power=na or battery leaves the pose label untouched.
  if [ "$power" = "plugged" ] && { [ "$situ" = "DORMANT" ] || [ "$situ" = "RESTING" ]; }; then
    situ="DOCKED"; gloss="parked on charger (stillness explained by docking, not attendance)"
    if [ "$tamper" = "quiet" ]; then gloss="$gloss · tamper-clear (undisturbed)"; fi
  fi
  printf '%s|%s\n' "$situ" "$gloss"
}

if [ "${1:-}" = --test ]; then
  command -v mesh-body-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-body-motion)"; exit 1; }
  _f=0
  # --- derive_situ() fixtures (OFFLINE, phone-independent — the tamper-fusion decision logic) ---
  # Pose-only (no tamper requested): original behavior preserved.
  [ "$(derive_situ '[body-still]'   1 "")" = "DORMANT|parked, dark, undisturbed" ] || { echo "  FAIL: still+dark (no tamper) → DORMANT"; _f=1; }
  [ "$(derive_situ '[body-carried]' 0 "")" = "TRAVELLING|body is being walked with" ] || { echo "  FAIL: carried → TRAVELLING"; _f=1; }
  [ "$(derive_situ '[body-covered]' 0 "")" = "STOWED|face-down or pocketed" ] || { echo "  FAIL: covered → STOWED"; _f=1; }
  # THE FUSION — moved override (the signal no single sensor gives):
  [ "$(derive_situ '[body-still]'   1 "moved")" = "DISTURBED|parked body was just physically disturbed (instant pose [body-still])" ] \
    || { echo "  FAIL: still + tamper-moved → DISTURBED (the fusion signal)"; _f=1; }
  [ "$(derive_situ '[body-handled]' 0 "moved")" = "INTERACTED|in hand + just disturbed (active handling)" ] \
    || { echo "  FAIL: handled + tamper-moved → INTERACTED"; _f=1; }
  # tamper=quiet confirms undisturbed (watch ran, nothing fired):
  _q="$(derive_situ '[body-still]' 1 "quiet")"
  case "$_q" in DORMANT\|*\ ·\ tamper-clear\ \(undisturbed\)) :;; *) echo "  FAIL: still+dark + tamper-quiet → DORMANT · tamper-clear (got: $_q)"; _f=1;; esac
  # HONEST-DEGRADED: tamper=na (unreachable) must NOT earn the tamper-clear marker — visibly
  # distinct from a genuine quiet (no silent all-clear on an unreachable input).
  _na="$(derive_situ '[body-still]' 1 "na")"
  case "$_na" in DORMANT\|*) :;; *) echo "  FAIL: still+dark + tamper-na → DORMANT (got: $_na)"; _f=1;; esac
  case "$_na" in *tamper-clear*) echo "  FAIL: tamper-na (unreachable) must NOT carry tamper-clear (silent all-clear)"; _f=1;; esac
  [ "$_q" != "$_na" ] || { echo "  FAIL: tamper-quiet and tamper-na must render differently"; _f=1; }
  # --- power fusion fixtures (motion+light+charge → DOCKED; na≠battery) ---
  [ "$(derive_situ '[body-still]' 0 "" "plugged")" = "DOCKED|parked on charger (stillness explained by docking, not attendance)" ] \
    || { echo "  FAIL: still+lit + plugged → DOCKED"; _f=1; }
  [ "$(derive_situ '[body-still]' 1 "" "plugged")" = "DOCKED|parked on charger (stillness explained by docking, not attendance)" ] \
    || { echo "  FAIL: still+dark + plugged → DOCKED"; _f=1; }
  [ "$(derive_situ '[body-still]' 0 "" "battery")" = "RESTING|parked, lights on" ] \
    || { echo "  FAIL: still+lit + battery → RESTING unchanged"; _f=1; }
  [ "$(derive_situ '[body-still]' 0 "" "na")" = "RESTING|parked, lights on" ] \
    || { echo "  FAIL: still+lit + power-na → RESTING unchanged (unreachable earns nothing)"; _f=1; }
  [ "$(derive_situ '[body-still]' 0 "" "")" = "RESTING|parked, lights on" ] \
    || { echo "  FAIL: still+lit, power not requested → RESTING (backward compatible)"; _f=1; }
  # power only re-labels PARKED bodies: travelling on a power bank is still travelling.
  [ "$(derive_situ '[body-carried]' 0 "" "plugged")" = "TRAVELLING|body is being walked with" ] \
    || { echo "  FAIL: carried + plugged stays TRAVELLING"; _f=1; }
  [ "$(derive_situ '[body-handled]' 0 "moved" "plugged")" = "INTERACTED|in hand + just disturbed (active handling)" ] \
    || { echo "  FAIL: tamper-moved override wins over power (INTERACTED, not DOCKED)"; _f=1; }
  # docked + tamper-quiet keeps the tamper-clear marker (confirmed undisturbed AND docked).
  _dq="$(derive_situ '[body-still]' 1 "quiet" "plugged")"
  case "$_dq" in DOCKED\|*\ tamper-clear*) :;; *) echo "  FAIL: docked + tamper-quiet keeps tamper-clear (got: $_dq)"; _f=1;; esac
  # classify_power() fixtures: the probe parser (pure).
  [ "$(classify_power '{"plugged":"PLUGGED_AC"}')" = "plugged" ] || { echo "  FAIL: plugged AC → plugged"; _f=1; }
  [ "$(classify_power '{"plugged":"UNPLUGGED"}')" = "battery" ] || { echo "  FAIL: unplugged → battery"; _f=1; }
  [ "$(classify_power 'garbage')" = "na" ] || { echo "  FAIL: unparseable probe → na"; _f=1; }
  [ "$(classify_power '')" = "na" ] || { echo "  FAIL: empty probe → na"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (derive_situ logic)"; exit 1; }
  # --- the n/a path must SPEAK (this is the path a mind actually meets here) ---
  # Drives the real script top-to-bottom with the body organ forced to rc=2, WITH the offline
  # sentinel present -- exactly the state in which the old code exited 2 in total silence.
  # Asserts a verdict lands on STDOUT (where a consumer's $(...) capture reads it), not stderr.
  _sd="$(mktemp -d)"; printf '#!/bin/sh\nexit 2\n' > "$_sd/motion-stub"; chmod +x "$_sd/motion-stub"
  _had_sentinel=1; [ -f "$OFFLINEFILE" ] || { _had_sentinel=0; touch "$OFFLINEFILE"; }
  _naout="$(MESH_BODY_MOTION_CMD="$_sd/motion-stub" "$0" 2>/dev/null)"; _narc=$?
  [ "$_had_sentinel" = 1 ] || rm -f "$OFFLINEFILE"
  rm -rf "$_sd"
  [ "$_narc" = 2 ] || { echo "  FAIL: forced-unreachable run must exit 2 (got rc=$_narc)"; _f=1; }
  [ -n "$_naout" ] || { echo "  FAIL: the n/a path printed NOTHING on stdout — an empty read is indistinguishable from crashed/killed/absent"; _f=1; }
  case "$_naout" in *n/a*unreachable*) :;; *) echo "  FAIL: the n/a verdict must NAME what is unreachable (got: '$_naout')"; _f=1;; esac
  case "$_naout" in *NOT*) :;; *) echo "  FAIL: the n/a verdict must say what it is NOT (no silent all-clear vocabulary)"; _f=1;; esac
  # A second consecutive run must speak too -- the old suppressor was once-only, so a gate that
  # ran the n/a path a single time would have passed on the broken code.
  _sd2="$(mktemp -d)"; printf '#!/bin/sh\nexit 2\n' > "$_sd2/motion-stub"; chmod +x "$_sd2/motion-stub"
  _naout2="$(MESH_BODY_MOTION_CMD="$_sd2/motion-stub" "$0" 2>/dev/null)"
  rm -rf "$_sd2"
  [ -n "$_naout2" ] || { echo "  FAIL: the SECOND consecutive n/a run fell mute (once-only suppression)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (n/a path must speak)"; exit 1; }

  # --- reachability gate (unchanged) ---
  $BODY_MOTION_CMD --test >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] && { echo "smoke-test: n/a (phone unreachable — no body context); derive-logic + n/a-path-speaks ok"; exit 2; }
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (mesh-body-motion --test rc=$rc)"; exit 1; }
  echo "smoke-test: ok (derive_situ: pose + moved→DISTURBED/INTERACTED + quiet-clear + na≠quiet + n/a-path-speaks + reachability)"; exit 0
fi

want_presence=0; want_location=0; want_json=0; want_tamper=0; want_power=0
for a in "$@"; do case "$a" in
  --presence) want_presence=1;;
  --location) want_location=1;;
  --power)    want_power=1;;
  --tamper)   want_tamper=1;;
  --full)     want_presence=1; want_location=1; want_tamper=1;;
  --json)     want_json=1;;
esac; done

# Core: one body-activity read (mesh-body-motion does the single fused SSH sensor read + classify).
motion="$($BODY_MOTION_CMD 2>/dev/null)"; rc=$?
# The n/a VERDICT goes to stdout on EVERY run. It was previously printed once, to stderr,
# gated on the sentinel not existing -- so after the first offline run the tool fell totally
# mute on both streams (36 days here: sentinel touched 2026-07-14). An empty read is not an
# honest n/a: it is string-identical to "crashed", "killed", "not installed", and the sole
# reader is a mind probing this live off the senses dash. The sentinel keeps only its edge
# role (entered-offline marker, cleared on recovery) and gates NOTHING that is output.
[ "$rc" = 2 ] && {
  echo "[body-context] n/a — phone unreachable, so body context is UNREAD (NOT 'calm', NOT 'still')"
  [ -f "$OFFLINEFILE" ] || touch "$OFFLINEFILE"
  exit 2
}
[ -n "$motion" ] || { echo "[body-context] unavailable — the body organ returned rc=$rc with an empty read"; exit 1; }
rm -f "$OFFLINEFILE" 2>/dev/null || true

# derive activity tag + lux from the body-motion line:
#   "[body-still] STILL — flat face-up, at rest | lux=274 steps=... linaccel=... az=.."
tag="$(printf '%s' "$motion" | grep -oE '^\[body-[a-z]+\]')"
lux="$(printf '%s' "$motion" | grep -oE 'lux=[0-9]+' | head -1 | cut -d= -f2)"
dark=0; [ -n "$lux" ] && [ "$lux" -lt 3 ] 2>/dev/null && dark=1

# ---- Windowed-disturbance fusion (mesh-tamper): catches a brief bump the instant pose misses ----
# Only meaningful when the body is reachable (body-motion above already gated that). mesh-tamper
# exits 2 on unreachable → "na", visibly distinct from a genuine "quiet" (never a silent all-clear).
tamper=""   # "" = not requested | moved | quiet | na
if [ "$want_tamper" = 1 ]; then
  _tout="$(timeout $(( TAMPER_WINDOW + 10 )) mesh-tamper --window "$TAMPER_WINDOW" 2>/dev/null)"; _trc=$?
  case "$_trc" in
    0) case "$_tout" in *"[body-moved]"*) tamper="moved";; *) tamper="quiet";; esac;;
    *) tamper="na";;   # exit 2 (unreachable) / timeout / any failure — honest n/a, NOT quiet
  esac
fi

# ---- Charge-state fusion (termux-battery-status): parked+lit+plugged → DOCKED ----
# One more bounded SSH read on the same transport body-motion already proved reachable.
# Unreachable/unparseable probe → "na": pose label unchanged, visibly distinct from battery.
power=""   # "" = not requested | plugged | battery | na
if [ "$want_power" = 1 ]; then
  _pip="$(mesh-phone-ip 2>/dev/null || true)"
  if [ -n "$_pip" ]; then
    _bout="$(timeout 15 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      "${PHONE_USER:-u0_a380}@${_pip}" 'termux-battery-status' </dev/null 2>/dev/null || true)"
    power="$(classify_power "$_bout")"
  else
    power="na"
  fi
fi

sg="$(derive_situ "$tag" "$dark" "$tamper" "$power")"
situ="${sg%%|*}"; gloss="${sg#*|}"

ambient="lux=${lux:-?}$([ "$dark" = 1 ] && echo ' (dark)' || echo ' (lit)')"
tamper_s=""; [ -n "$tamper" ] && tamper_s=" | tamper=${tamper}"
power_s="";  [ -n "$power" ]  && power_s=" | power=${power}"
extra=""
presence_json="null"
location_json="null"
tamper_json="null"
power_json="null"
[ "$power" = "plugged" ] && power_json='"plugged"'
[ "$power" = "battery" ] && power_json='"battery"'
[ "$power" = "na" ]      && power_json='"na"'
[ "$tamper" = "moved" ] && tamper_json='"moved"'
[ "$tamper" = "quiet" ] && tamper_json='"quiet"'
[ "$tamper" = "na" ]    && tamper_json='"na"'

if [ "$want_presence" = 1 ]; then
  # single-node BLE scan; summarize as count + strongest (closest) device.
  # timeout 45, not 30 (2026-08-19, presence-scan-lock-contends-four-ways-on-the-sole-uplink-chip):
  # mesh-presence's own cap sum is `flock -w WIN+25` + the WIN-second scan, so a shorter budget
  # kills this leg while it is still QUEUED behind another scanner — blind, and not even an
  # honest BUSY.
  praw="$(timeout 45 mesh-presence 2>/dev/null || true)"
  pres="$(printf '%s' "$praw" | grep -oE '\-?[0-9]+\|[0-9A-Fa-f:]{17}\|.*$' | sort -t'|' -k1 -n | tail -3)"
  if [ -n "$pres" ]; then
    n="$(printf '%s\n' "$pres" | grep -c .)"
    closest="$(printf '%s\n' "$pres" | tail -1)"
    extra="$extra | near: ${n} BLE dev (closest: ${closest})"
    presence_json="{\"count\":${n},\"closest\":\"$(printf '%s' "$closest" | sed 's/"/\\"/g')\"}"
  else
    extra="$extra | near: <no BLE devices / scan n/a>"
    presence_json="{\"count\":0,\"closest\":null}"
  fi
fi
if [ "$want_location" = 1 ]; then
  loc="$(timeout 40 mesh-location --brief 2>/dev/null | head -1 || true)"
  extra="$extra | at: ${loc:-<no location fix>}"
  [ -n "$loc" ] && location_json="\"$(printf '%s' "$loc" | sed 's/"/\\"/g')\""
fi

if [ "$want_json" = 1 ]; then
  lux_val="${lux:-null}"
  dark_bool="false"; [ "$dark" = 1 ] && dark_bool="true"
  printf '{"context":"%s","situation":"%s","gloss":"%s","lux":%s,"dark":%s,"ambient":"%s","tamper":%s,"power":%s,"presence":%s,"location":%s}\n' \
    "${situ}" "${situ}" "${gloss}" "$lux_val" "$dark_bool" "${ambient}" "$tamper_json" "$power_json" "$presence_json" "$location_json"
else
  echo "[body-context] ${situ} — ${gloss} | ${ambient}${tamper_s}${power_s}${extra}"
fi
