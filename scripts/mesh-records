#!/usr/bin/env bash
# mesh-records — the ARCHIVIST: keep every record the mesh makes, measured, before it prunes itself.
#
# Operator 2026-07-15: "it would make sense to feed all records that mesh makes here so that you
# could be deciding what to do with them with grainneukeln." The problem that ask exposes: the mesh
# records constantly and keeps almost none of it. ~/.mesh/audio-buffer (the overhear ear) is a
# ROLLING buffer that prunes within the hour; mesh-soundscape keeps only its own winning clip
# (SS_KEEP_DAYS=2). Everything the mesh hears expires before the sound mind ever gets to decide
# about it — the mind is handed a corpus that is already gone.
#
# So: sweep every record-producing organ, MEASURE each new file through the ear's own analyzer
# (mesh-soundscape --measure — one measure tract, never a second librosa drifting out of sync),
# copy it into a capped corpus, and append one line to the LEDGER (~/.mesh/records.log). The ledger
# is the durable index: it outlives the audio, so a record evicted for space still leaves its
# measurement behind. mesh-sound-reflex reads the ledger and decides what to grind.
#
#   mesh-records            one sweep: archive + measure what's new, prune the corpus
#   mesh-records --list [n] last n ledger entries (cheap — pure tail, for the dash)
#   mesh-records --organs   the DECLARED organ names, one per line (readers must not copy the list)
#   mesh-records --stats    corpus size/count/axis medians + per-organ ledger SPAN (n is not coverage)
#   mesh-records --test     real-read gate: measure a real wav, assert dur+beats+axes come back
#
# Tunables (env): MESH_REC_MAX_MB=2000 · MESH_REC_KEEP_DAYS=14 · MESH_REC_MAX_PER_SWEEP=8
#   MESH_REC_LOG_KEEP=600 · MESH_REC_LOG_RESERVE=90 (of LOG_KEEP, spent on SPAN not recency)
#   MESH_REC_MIN_AGE=5 (s — never archive a file still being written) · MESH_REC_DIR · MESH_REC_LOG
#
# reflex-cadence: */2 * * * *
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"
export LC_ALL=C.UTF-8
MESH="${MESH_DIR:-$HOME/.mesh}"
[ -f "$MESH/nodes" ] && . "$MESH/nodes" 2>/dev/null || true

REC_DIR="${MESH_REC_DIR:-$MESH/records}"
REC_LOG="${MESH_REC_LOG:-$MESH/records.log}"
SEEN="${MESH_REC_SEEN:-$MESH/.records-seen}"      # content hashes already archived (dedupe key)
# Derived from the ledger path so a sandboxed --test run locks its OWN file and never contends with
# (or is silently skipped by) a live cron sweep.
LOCK="${MESH_REC_LOCK:-$REC_LOG.lock}"
TICK="${MESH_REC_TICK:-$MESH/.records-tick}"      # liveness marker (mtime = ran, always)
MAX_MB="${MESH_REC_MAX_MB:-2000}"
KEEP_DAYS="${MESH_REC_KEEP_DAYS:-14}"
MAX_PER_SWEEP="${MESH_REC_MAX_PER_SWEEP:-8}"      # bound the librosa cost of one cron sweep
MIN_AGE="${MESH_REC_MIN_AGE:-5}"                  # s — a file younger than this may still be open
LOG_KEEP="${MESH_REC_LOG_KEEP:-600}"              # ledger lines retained
# COVERAGE RESERVE — the slice of LOG_KEEP that is NOT spent on recency (2026-08-20, fep active
# data selection). A pure `tail -n LOG_KEEP` per organ is a RECENCY sampler, and recency is a
# property of a record ALONE, never of the record relative to what the ledger already holds. Live
# here the same day: the ear's 600 retained lines spanned 00:25Z->13:30Z — THIRTEEN HOURS, against
# a corpus that keeps 14 days — and inside that window the dyn median moved 0.144 (oldest 100) ->
# 0.332 (newest 100), +130.6%. drop, whose 600 lines span 16 days, moved -1.9% on the same axis. So
# the number mesh-sound-reflex calls "the corpus centre" was, for the chattiest organ, an answer
# about which HOUR you asked. This reserve keeps R evenly-spaced older lines (the oldest ALWAYS)
# beside the newest LOG_KEEP-R, so the retained span grows without bound while the count stays
# capped: the old span decimates a little further each sweep instead of being cut off. 0 restores
# the pure recency window.
LOG_RESERVE="${MESH_REC_LOG_RESERVE:-90}"         # of LOG_KEEP, spent on span instead of recency

# The organs that produce records here. `organ|glob` — organ is the ledger's provenance field, and
# `drop` (the operator's own jams) is privileged everywhere downstream: it outranks the ear for
# grinding and is never evicted for space. A gesture beats ambience.
# `note3` = the Note3's slrec physical ear (independent hardware via adb). The onboard `ear`
# (mesh-overhear → audio-buffer, ALC897 Front Mic) went silent headless — its records feed died, so
# every note3 capture that carried real acoustic energy was measured, transcribed, then DISCARDED and
# never reached the grinder (music-is-deaf-note3-ear-discards-audio, 2026-07-18). Feeding note3 wavs
# straight to the archivist is DELIBERATELY transcript-free: the operator wants mixes cut from the
# mesh's own ambient and distrusts STT (it hallucinates lyrics), and the reflex's rhythm-floor already
# filters non-grindable material — so no speech/instrumental split is needed here.
ORGANS_DEFAULT="drop|$MESH/inbox/*.aac
drop|$MESH/inbox/*.oga
drop|$MESH/inbox/*.ogg
drop|$MESH/inbox/*.m4a
drop|$MESH/inbox/*.wav
drop|$MESH/inbox/*.mp3
ear|$MESH/audio-buffer/*.wav
note3|$MESH/note3/ear-*.wav
scape|$MESH/soundscapes/*.wav
voice|$MESH/voiceref/*.wav"
ORGANS="${MESH_REC_ORGANS:-$ORGANS_DEFAULT}"

ts_utc(){ date -u +%FT%H:%MZ 2>/dev/null; }
now(){ date +%s; }

# ── corpus calibration (baked prior) ─────────────────────────────────────────────────────────────
# MEASURED 2026-07-15 over the whole live corpus (n=29: audio-buffer + soundscapes + voiceref), NOT
# assumed. The axes are NOT uniform on real material and a naive 0.5 split is wrong on every one of
# them: real medians are dyn 0.265, act 0.319, move 0.141, rich 0.611. `tone` is DEAD as a
# discriminator here — its median IS its max (1.000), i.e. every real record reads "tonal", so any
# rule keyed on it evaluates to a constant (the same shape of bug as mesh-soundscape's threshold-55
# mix lane that sat above its own ceiling and never fired). mesh-sound-reflex ranks a record against
# the LIVE corpus once there is enough of it and falls back to these measured medians before then.
REC_CAL_DYN="${REC_CAL_DYN:-0.265}"
REC_CAL_ACT="${REC_CAL_ACT:-0.319}"
REC_CAL_RICH="${REC_CAL_RICH:-0.611}"
REC_CAL_MOVE="${REC_CAL_MOVE:-0.141}"
REC_CAL_CENT="${REC_CAL_CENT:-1101.9}"
REC_CAL_SCORE="${REC_CAL_SCORE:-44.7}"

hash8(){ sha1sum "$1" 2>/dev/null | cut -c1-8; }

# archive_one <organ> <file> -> ledger line on stdout (empty = skipped). Never throws.
archive_one(){
  local organ="$1" f="$2" h m dur score beats label dyn act rich move cent dst age
  [ -f "$f" ] || return 0
  [ -s "$f" ] || return 0
  age=$(( $(now) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  # A file younger than MIN_AGE may still be OPEN (overhear writes audio-buffer wavs continuously).
  # Archiving a half-written wav gives a truncated copy and a measurement of nothing — wait a sweep.
  [ "$age" -lt "$MIN_AGE" ] && return 0
  h="$(hash8 "$f")"; [ -n "$h" ] || return 0
  # dedupe on CONTENT, not path: a rolling-buffer file surviving two sweeps must land once, and an
  # identical capture re-appearing under a new name is the same record.
  grep -qxF "$h" "$SEEN" 2>/dev/null && return 0

  m="$(timeout "${MESH_REC_MEASURE_TIMEOUT:-90}" mesh-soundscape --measure "$f" 2>/dev/null | head -1)"
  case "$m" in
    ""|"MEASURE none")
      # Unmeasurable/near-silent: mark seen anyway so we never re-pay librosa for it every 2 minutes,
      # and leave a ledger line so the record is accounted for rather than silently vanishing.
      echo "$h" >> "$SEEN"
      printf '%s %s %s dur=? score=? beats=? [unmeasurable] -> skip:silent-or-unreadable\n' \
        "$(ts_utc)" "$organ" "$h"
      return 0 ;;
  esac
  kv(){ grep -oE "(^| )$1=[^ ]+" <<<"$m" | head -1 | cut -d= -f2; }
  # dur = the WHOLE file; win = the analyzer's winning WINDOW. Both, because `beats` is counted over
  # the WINDOW, not the file: dividing the file duration by the window's beat count is a category
  # error that yields a nonsense period (18s/5b = 3600ms), falls outside the detector's honest range,
  # and silently lands on the 500ms fallback — flattening `l = beat x f` to a constant across every
  # render. Same shape as the mesh-room-music flat-beat bug fixed the same day. Consumers doing beat
  # math MUST use win/beats.
  dur="$(kv total)"; win="$(kv dur)"; score="$(kv score)"; beats="$(kv beats)"; label="$(kv label)"
  dyn="$(kv dyn)"; act="$(kv act)"; rich="$(kv rich)"; move="$(kv move)"; cent="$(kv cent)"
  # COVERAGE + the WHOLE-FILE axes. win/dur told a consumer to do its beat math on the window; these
  # tell it how much of the source that window even IS, and what the material reads like at full
  # length. On the operator's 149.06s drop 9a11e5d1 the winning window was 3.00s — cov=0.020 — and
  # read move=1.000 (saturated) against the file's 0.522, which is a different piece of material to
  # anyone deriving a recipe from it. A consumer is free to keep using the window axes; it is not
  # free to keep mistaking them for the source. na (never 0) when no whole-file scan was made.
  cov="$(kv cov)"; fbeats="$(kv fbeats)"; fdyn="$(kv fdyn)"; fact="$(kv fact)"
  frich="$(kv frich)"; fmove="$(kv fmove)"; fcent="$(kv fcent)"

  dst="$REC_DIR/$(date -u -d "@$(stat -c %Y "$f" 2>/dev/null || now)" +%Y%m%d-%H%M%S 2>/dev/null || date -u +%Y%m%d-%H%M%S)-$organ-$h.${f##*.}"
  cp -p "$f" "$dst" 2>/dev/null || return 0
  echo "$h" >> "$SEEN"
  printf '%s %s %s dur=%s win=%s cov=%s score=%s beats=%s [%s] dyn=%s act=%s rich=%s move=%s cent=%s fbeats=%s fdyn=%s fact=%s frich=%s fmove=%s fcent=%s -> pending\n' \
    "$(ts_utc)" "$organ" "$h" "${dur:-?}" "${win:-?}" "${cov:-?}" "${score:-?}" "${beats:-?}" "${label:-?}" \
    "${dyn:-?}" "${act:-?}" "${rich:-?}" "${move:-?}" "${cent:-?}" \
    "${fbeats:-na}" "${fdyn:-na}" "${fact:-na}" "${frich:-na}" "${fmove:-na}" "${fcent:-na}"
}

# prune — cap the corpus by age then size, evicting oldest-lowest-score first. Operator drops are
# NEVER evicted for space: an operator gesture is not ambience and must not be aged out by room hum.
#
# AN UNJOINED RECORD IS UNKNOWN, NOT WORTHLESS (2026-08-19, ranker-unit-seam-sweep). The score
# lives in the ledger and is joined on the hash, and `${score:-0}` used to turn every join MISS
# into the lowest possible score — so an unmeasured record was evicted ahead of every measured one,
# and the eviction order silently became "whatever the ledger has forgotten". That is not a rare
# corner: measured here the same day, 660 of 940 corpus files found their hash in the ledger, so
# 30% of the corpus was ranked at zero by a fallback rather than by a measurement. And it is
# self-inflicted — `records.log` is a SLIDING WINDOW pruned every sweep (memory
# `records-log-is-a-sliding-window`), so a record OUTLIVES its own ledger line by design: the
# archivist whose contract is "the ledger outlives the audio" was in fact destroying the record the
# moment its measurement aged out. Same shape as the honest-fusion rule everywhere else in the
# mesh: an unreachable input renders UNKNOWN, never a faked reading.
#
# So an unjoined record ranks at the corpus MEDIAN score — neither privileged nor condemned, it
# competes on its mtime like the median record it might be — and the count is NAMED on stderr, so a
# join that has quietly rotted to nothing is visible instead of looking like a corpus of zeros.
prune_corpus(){
  find "$REC_DIR" -type f -mtime +"$KEEP_DAYS" ! -name '*-drop-*' -delete 2>/dev/null
  local used
  used=$(( $(du -sm "$REC_DIR" 2>/dev/null | cut -f1 || echo 0) ))
  [ "$used" -le "$MAX_MB" ] && return 0
  # the stand-in for an unjoined record: the median of the scores this ledger DOES carry. Falls
  # back to 0 only when the ledger holds no score at all — there, every record is unjoined, the
  # ranking is mtime either way, and there is no median to be had.
  local med unjoined
  med="$(grep -oE 'score=[0-9.]+' "$REC_LOG" 2>/dev/null | cut -d= -f2 | sort -n \
         | awk '{v[NR]=$1} END{if(NR) printf "%.1f", v[int(NR/2)+1]; else print "0"}')"
  [ -n "$med" ] || med=0
  local hash score f
  # counted in ONE pass up front, never inside the eviction loop: that loop's body runs inside a
  # command substitution, so a counter incremented there lives and dies in a subshell and the
  # report would be a permanent zero — the silent-fallback shape this whole fix is about.
  unjoined=0
  for p in "$REC_DIR"/*; do
    [ -f "$p" ] || continue
    case "$p" in *-drop-*) continue ;; esac
    hash="${p##*-}"; hash="${hash%.*}"
    grep -qF " $hash " "$REC_LOG" 2>/dev/null || unjoined=$(( unjoined + 1 ))
  done
  # STDOUT, not stderr, and the reason is a live trap in this very file: `exec 9>"$LOCK" 2>/dev/null`
  # above has no command, so its redirect is PERMANENT — every stderr write after that line is
  # swallowed for the rest of the run (memory `exec-redirect-eats-script-stderr`). A report written
  # to stderr here would be a report nobody has ever read.
  [ "$unjoined" -gt 0 ] && echo "  prune: $unjoined unjoined record(s) ranked at the ledger median $med (no score line)"
  while [ "$used" -gt "$MAX_MB" ]; do
    f="$(for p in "$REC_DIR"/*; do
           [ -f "$p" ] || continue
           case "$p" in *-drop-*) continue ;; esac
           hash="${p##*-}"; hash="${hash%.*}"
           score="$(grep -F " $hash " "$REC_LOG" 2>/dev/null | tail -1 | grep -oE 'score=[0-9.]+' | cut -d= -f2)"
           [ -n "$score" ] || score="$med"
           printf '%s\t%s\t%s\n' "$score" "$(stat -c %Y "$p" 2>/dev/null || echo 0)" "$p"
         done | sort -k1,1n -k2,2n | head -1 | cut -f3)"
    [ -n "$f" ] || break
    rm -f "$f" 2>/dev/null || break
    used=$(( $(du -sm "$REC_DIR" 2>/dev/null | cut -f1 || echo 0) ))
  done
  return 0
}

case "${1:-}" in
  --organs)
    # THE DECLARED ORGAN SET, for readers that must not hand-maintain a copy of it (2026-08-21).
    # mesh-dash's SOURCES panel — the panel whose whole job is reporting source DIVERSITY — carried
    # the literal `for _o in ear voice scape drop`, four names beside this file's five. `note3` (the
    # Note3's slrec ear, this node's only physically independent mic) was therefore unrenderable by
    # construction: 200 wavs on disk, 200 measured ledger rows, and no line on the panel at all —
    # an absence that reads as "not an organ", not as "an organ with nothing". Same family as the
    # roster-count rule in CLAUDE.md: never hand-maintain a list beside the list. Prints one name
    # per line, deduped, in declaration order, and honours MESH_REC_ORGANS so a --test override is
    # visible to its readers too.
    printf '%s\n' "$ORGANS" | sed -n 's/^\([a-z0-9_-]\{1,\}\)|.*/\1/p' | awk '!seen[$0]++'
    exit 0 ;;

  --list)
    n="${2:-6}"
    [ -s "$REC_LOG" ] && tail -n "$n" "$REC_LOG" || echo "  (no records yet)"
    exit 0 ;;

  --stats)
    if [ ! -s "$REC_LOG" ]; then echo "records: none yet ($REC_LOG)"; exit 0; fi
    cnt="$(ls "$REC_DIR" 2>/dev/null | wc -l)"
    mb="$(du -sm "$REC_DIR" 2>/dev/null | cut -f1)"
    echo "corpus: ${cnt} file(s) / ${mb:-0}M (cap ${MAX_MB}M / ${KEEP_DAYS}d) · ledger $(wc -l < "$REC_LOG") line(s)"
    awk '{for(i=1;i<=NF;i++){split($i,a,"=");
            if(a[1]=="score"&&a[2]+0>0){s[++n]=a[2]+0}
            if(a[1]=="dyn"&&a[2]!="?"){d[++m]=a[2]+0}
            if(a[1]=="act"&&a[2]!="?"){c[++k]=a[2]+0}}}
         END{if(n){asort(s); asort(d); asort(c);
             printf "  medians: score %.1f · dyn %.3f · act %.3f  (n=%d — the reflex ranks against these)\n",
               s[int(n/2)+1], d[int(m/2)+1], c[int(k/2)+1], n}}' "$REC_LOG" 2>/dev/null \
      || echo "  (medians need gawk)"
    # THE SPAN, BESIDE THE COUNT. n is not coverage: the ear's n=600 was THIRTEEN HOURS while drop's
    # n=600 was sixteen days, and the reflex pools them into one "corpus median" with no way to see
    # that. Same rule as mesh-psi's `window=` — publish the coverage IN the reading so a consumer can
    # never mistake the narrow claim for the wide one. `res` is how many of the retained lines are
    # coverage reserve rather than recent (see LOG_RESERVE); a span that stops growing while res>0
    # means the reserve is not being kept.
    awk -v k="$LOG_KEEP" -v R="$LOG_RESERVE" '
      { o=$2; if (!(o in first)) first[o]=$1; last[o]=$1; c[o]++ }
      END { printf "  span (n is not coverage):\n"
            for (o in c) {
              t1=first[o]; t2=last[o]
              gsub(/[-T:Z]/," ",t1); gsub(/[-T:Z]/," ",t2)
              h=(mktime(t2" 00")-mktime(t1" 00"))/3600
              res=(c[o]>=k && R>0) ? R : 0
              printf "    %-6s n=%-4d %s -> %s  (%.1fh%s)\n", o, c[o], first[o], last[o], h,
                     (res? sprintf(", %d reserve", res) : "")
            } }' "$REC_LOG" 2>/dev/null || echo "  (span needs gawk)"
    grep -c ' -> pending' "$REC_LOG" 2>/dev/null | sed 's/^/  pending: /'
    exit 0 ;;

  --test)
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    # ENV-ABSENT is honest n/a (exit 2), never FAIL: the audio stack + grainneukeln venv only exist on
    # nodes carrying this sense. mesh-land treats 2 as a pass, so the real-read gate can require the
    # hardware without blocking a landing on a node that has none. FAIL is reserved for a REAL
    # regression: env present but the archivist misreads a real wav.
    na(){ echo "smoke-test: n/a ($1)"; exit 2; }
    command -v ffmpeg >/dev/null 2>&1 || na "no ffmpeg (audio stack absent)"
    command -v mesh-soundscape >/dev/null 2>&1 || na "mesh-soundscape absent (measure tract missing)"
    mesh-soundscape --measure /nonexistent.wav >/dev/null 2>&1
    [ "$?" = 2 ] || [ "$?" = 1 ] || na "mesh-soundscape --measure not available (old version deployed?)"

    # REAL-READ GATE: archive an actual synthesized wav through the real path and assert the ledger
    # line carries a real measurement. A sense whose --test only exercises the offline bookkeeping is
    # HOLLOW — it goes green while the thing it exists to do (measure a record) returns nothing.
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    src="$tmp/src"; mkdir -p "$src"
    ffmpeg -v quiet -y -f lavfi \
      -i "aevalsrc='0.3*(1+sin(2*PI*0.5*t))*sin(2*PI*(300+200*t)*t)':d=14:s=22050" -ac 1 "$src/probe.wav" \
      || fail "ffmpeg synth failed"
    touch -d '@1' "$src/probe.wav" 2>/dev/null   # age it past MIN_AGE

    # Drive the REAL entry point against a sandboxed corpus/ledger/seen-index — never the live ones.
    out="$(MESH_REC_DIR="$tmp/rec" MESH_REC_LOG="$tmp/log" MESH_REC_SEEN="$tmp/seen" \
           MESH_REC_TICK="$tmp/tick" MESH_REC_ORGANS="drop|$src/*.wav" "$0" 2>&1)"
    [ -s "$tmp/log" ] || fail "sweep wrote no ledger line for a real 14s wav (real-read gate) — out: $out"
    l="$(head -1 "$tmp/log")"
    echo "  ledger: $l"
    case "$l" in *unmeasurable*) fail "archivist could not measure a real structured 14s signal (real-read gate)";; esac
    for k in dur win score beats dyn act rich move cent; do
      grep -qE "(^| )$k=[0-9.]+" <<<"$l" || fail "ledger line missing real '$k' (measurement did not land)"
    done
    # win (the analyzer's winning WINDOW) must be present AND <= dur (the whole file). Consumers do
    # beat math as win/beats; if win silently vanished or took the file duration, the period lands
    # out of range and the grinder falls back to a constant 500ms on every render — the beat axis
    # dies while the renders still come out looking fine.
    wv="$(grep -oE '(^| )win=[0-9.]+' <<<"$l" | grep -oE '[0-9.]+')"
    dv="$(grep -oE '(^| )dur=[0-9.]+' <<<"$l" | grep -oE '[0-9.]+')"
    awk -v w="$wv" -v d="$dv" 'BEGIN{exit !(w+0 > 0 && w+0 <= d+0)}' \
      || fail "win=$wv is not a window within dur=$dv (beat math would take the 500ms fallback)"
    # COVERAGE gate. cov and the f* axes are the ONLY thing on the line that says how much of the
    # source the window axes describe — 71% of the live corpus (n=698, 2026-08-18) sits below cov
    # 0.25 and 56% below 0.10, so a consumer reading dyn/act/move as "the material" is usually
    # reading a few percent of it. If these silently stop landing the line still looks complete and
    # the blindness goes back to being invisible, which is the whole failure this closes. Assert the
    # VALUE, and assert it AGREES with win/dur — a cov that does not equal its own window fraction is
    # a number that has come loose from what it claims.
    grep -qE '(^| )cov=[0-9.]+' <<<"$l" || fail "ledger line has no real cov= (window/source ratio did not land)"
    cv="$(grep -oE '(^| )cov=[0-9.]+' <<<"$l" | grep -oE '[0-9.]+')"
    awk -v c="$cv" -v w="$wv" -v d="$dv" 'BEGIN{exit !(d>0 && (c-w/d)<0.005 && (w/d-c)<0.005)}' \
      || fail "cov=$cv disagrees with win/dur=$wv/$dv (coverage has come loose from its own window)"
    # The whole-file axes are in the default scale set, so this run MUST carry real ones. na here
    # means soundscape stopped scanning the whole file (or was not deployed with this) — either way
    # nothing downstream can tell a 2%-coverage window from the material again.
    for k in fbeats fdyn fact frich fmove fcent; do
      grep -qE "(^| )$k=[0-9.]+" <<<"$l" || fail "ledger line missing real '$k' — the whole-file axes did not land, so cov has nothing to compare against"
    done
    grep -qE '(^| )dur=[0-9.]+' <<<"$l" || fail "no duration measured"
    d="$(grep -oE '(^| )dur=[0-9.]+' <<<"$l" | grep -oE '[0-9.]+')"
    awk -v v="$d" 'BEGIN{exit !(v+0>=10 && v+0<=20)}' || fail "measured dur=$d for a 14s wav (wrong read)"
    [ "$(ls "$tmp/rec" 2>/dev/null | wc -l)" -ge 1 ] || fail "record was measured but never archived to the corpus"
    # DEDUPE gate: a second sweep over the same content must NOT re-archive (the rolling buffer
    # re-presents surviving files every sweep; without content-dedupe the corpus duplicates hourly).
    MESH_REC_DIR="$tmp/rec" MESH_REC_LOG="$tmp/log" MESH_REC_SEEN="$tmp/seen" \
      MESH_REC_TICK="$tmp/tick" MESH_REC_ORGANS="drop|$src/*.wav" "$0" >/dev/null 2>&1
    n="$(ls "$tmp/rec" 2>/dev/null | wc -l)"
    [ "$n" = 1 ] || fail "re-sweep duplicated an identical record ($n copies — content-dedupe broken)"

    # CONCURRENCY gate: reproduce the live 2026-07-15 race. Content-dedupe is check-then-write, so
    # two sweeps racing the same NEW record both pass the check and both archive it. Without the
    # lock this yields 2 ledger rows for one record; with it, exactly 1. This is the steady state
    # once autowired, not a corner case — a sweep costs ~29s and the cadence is 120s.
    rm -rf "$tmp/rec2"; mkdir -p "$tmp/rec2"; : > "$tmp/log2"; : > "$tmp/seen2"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.4*sin(2*PI*(200+120*t)*t)':d=12:s=22050" -ac 1 "$src/race.wav" \
      || fail "ffmpeg synth (race probe) failed"
    touch -d '@1' "$src/race.wav" 2>/dev/null
    for _ in 1 2; do
      MESH_REC_DIR="$tmp/rec2" MESH_REC_LOG="$tmp/log2" MESH_REC_SEEN="$tmp/seen2" \
        MESH_REC_TICK="$tmp/tick2" MESH_REC_ORGANS="drop|$src/race.wav" "$0" >/dev/null 2>&1 &
    done
    wait
    rc="$(grep -c 'race\|drop ' "$tmp/log2" 2>/dev/null || echo 0)"
    hd="$(awk '{print $3}' "$tmp/log2" 2>/dev/null | sort | uniq -d | wc -l)"
    [ "$hd" = 0 ] || fail "two concurrent sweeps duplicated a ledger row (TOCTOU race — the lock is not holding)"
    echo "  concurrency: 2 racing sweeps -> $rc row(s), 0 duplicate hashes"
    [ -f "$tmp/tick" ] || fail "no liveness touch (mtime-aging watchdogs would read a live archivist as STALE)"

    # RETENTION gate: the ledger is the ONLY thing the grinder ranks, and a CHATTY organ must never
    # flush a RARE organ's provenance out of it. Live 2026-07-15: the ledger trimmed to the last 600
    # lines GLOBALLY while the ear wrote ~120 lines/h — so the window was ~6h of ear, the corpus kept
    # 14d, and all 5 voice records sat in the corpus with ZERO ledger lines. They were also in the
    # seen-index (never re-archived), so they were double-locked out: permanently invisible to the
    # grinder. Result: 0 non-ear records EVER ground, and the dash reported "5 in corpus · 0 ground"
    # — which reads as "not picked" when the truth was "never seen". Retention must be PER-ORGAN.
    : > "$tmp/log3"; : > "$tmp/seen3"; mkdir -p "$tmp/rec3"; mkdir -p "$tmp/empty"
    echo "2026-07-15T00:00Z voice deadbeef dur=5.0 win=3.0 score=57.3 beats=3 [even] dyn=0.3 act=0.3 rich=0.6 move=0.8 cent=1923.3 -> pending" >> "$tmp/log3"
    for i in $(seq 1 40); do
      echo "2026-07-15T0${i}:00Z ear ea00$i dur=3.0 win=3.0 score=40.0 beats=2 [even] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100.0 -> pending" >> "$tmp/log3"
    done
    MESH_REC_DIR="$tmp/rec3" MESH_REC_LOG="$tmp/log3" MESH_REC_SEEN="$tmp/seen3" \
      MESH_REC_TICK="$tmp/tick3" MESH_REC_LOG_KEEP=10 MESH_REC_ORGANS="ear|$tmp/empty/*.wav" \
      "$0" >/dev/null 2>&1
    grep -q ' voice deadbeef ' "$tmp/log3" \
      || fail "a chatty organ (40 ear lines) flushed a RARE organ's ledger line out (keep=10) — voice is in the corpus but unrankable, so it can never be ground"
    echo "  retention: rare organ survives 40 ear lines at keep=10 ($(wc -l < "$tmp/log3") line(s) kept)"

    # SEEN-INDEX RETENTION. Sibling of the ledger gate above, and it bit for a whole month before
    # anyone counted it. The index is the ONLY thing stopping a source that is still on disk from
    # being re-archived, re-measured (paid librosa), re-ground (paid render) and re-DELIVERED. It was
    # trimmed `tail -n 5000` — measured 2026-08-20 at 150-200 records/hour, that is ~ONE DAY, while
    # drop sources live for weeks: 19 of 294 source hashes carried more than one grind manifest,
    # fdfdd3fb FOUR of them, and ee7f3fca was delivered 08-03 then re-ground 08-20. Drive it: a hash
    # far outside the OLD 5000 must still suppress a re-archive. With the pinned cap this leg goes red.
    : > "$tmp/log5"; : > "$tmp/seen5"; mkdir -p "$tmp/rec5" "$tmp/src5"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.4*sin(2*PI*300*t)':d=12:s=22050" -ac 1 "$tmp/src5/keep.wav" \
      || fail "ffmpeg synth (seen-retention probe) failed"
    touch -d '@1' "$tmp/src5/keep.wav" 2>/dev/null
    MESH_REC_DIR="$tmp/rec5" MESH_REC_LOG="$tmp/log5" MESH_REC_SEEN="$tmp/seen5" \
      MESH_REC_TICK="$tmp/tick5" MESH_REC_ORGANS="drop|$tmp/src5/*.wav" "$0" >/dev/null 2>&1
    seen_h="$(head -1 "$tmp/seen5")"
    [ -n "$seen_h" ] || fail "seen-retention probe: first sweep archived nothing, so the leg would assert nothing"
    # Bury it under 6000 later hashes — past the old 5000 cap, so a recency trim evicts it.
    for i in $(seq 1 6000); do printf 'ffff%04x\n' "$i"; done >> "$tmp/seen5"
    MESH_REC_DIR="$tmp/rec5" MESH_REC_LOG="$tmp/log5" MESH_REC_SEEN="$tmp/seen5" \
      MESH_REC_TICK="$tmp/tick5" MESH_REC_ORGANS="drop|$tmp/src5/*.wav" "$0" >/dev/null 2>&1
    grep -qxF "$seen_h" "$tmp/seen5" \
      || fail "the seen-index evicted a hash whose SOURCE FILE is still on disk (buried under 6000 later hashes) — that file is now re-archived, re-measured, re-ground and re-DELIVERED on every sweep"
    n5="$(grep -c " $seen_h " "$tmp/log5" 2>/dev/null || echo 0)"
    [ "$n5" -le 1 ] \
      || fail "a still-present source was re-archived after its hash aged out of the seen-index ($n5 ledger rows for one file) — paid re-measure + re-grind + duplicate send"
    echo "  seen-retention: hash survives 6000 later hashes (old cap 5000), source archived once"

    # AN UNJOINED RECORD MUST NOT BE EVICTED AHEAD OF A MEASURED ONE. The ledger is a sliding
    # window, so a record outliving its own score line is the NORMAL case, not a corner — and
    # `${score:-0}` used to make that the death sentence. Drive the real prune under a 0 MB cap
    # with one high-scoring measured record and one unjoined record that is OLDER: under the old
    # fallback the unjoined one dies first every time (score 0 beats score 90); ranked at the
    # median it dies first only because it is older, which is the honest reason.
    : > "$tmp/log4"; mkdir -p "$tmp/rec4"
    echo "2026-07-15T00:00Z ear aaaa1111 dur=3.0 win=3.0 score=90.0 beats=2 [even] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100.0 -> pending" >> "$tmp/log4"
    echo "2026-07-15T00:01Z ear aaaa2222 dur=3.0 win=3.0 score=10.0 beats=2 [even] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100.0 -> pending" >> "$tmp/log4"
    # THREE scores, not two: with an even n the median lands ON an endpoint, and a gate asserting
    # "strictly between" would then be asserting the endpoint. An odd ledger gives the stand-in an
    # interior value, which is the only shape that can tell a median apart from the old 0 fallback
    # AND from "it just took the top score".
    echo "2026-07-15T00:02Z ear aaaa3333 dur=3.0 win=3.0 score=50.0 beats=2 [even] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100.0 -> pending" >> "$tmp/log4"
    head -c 200000 /dev/zero > "$tmp/rec4/20260715-000000-ear-aaaa1111.wav"   # measured, score 90
    head -c 200000 /dev/zero > "$tmp/rec4/20260715-000200-ear-nojoin00.wav"   # unjoined, NEWER
    # mtimes must stay INSIDE the age window: the age sweep runs before the size sweep, so
    # backdating the fixture past KEEP_DAYS deletes both files and the size prune never runs at all
    # — a green gate that measured nothing. Relative offsets, one minute apart, so the ordering is
    # still asserted and the fixture cannot age out as the calendar moves.
    touch -d '5 minutes ago' "$tmp/rec4/20260715-000000-ear-aaaa1111.wav"
    touch -d '4 minutes ago' "$tmp/rec4/20260715-000200-ear-nojoin00.wav"
    # BOTH streams: this script's `exec 9>"$LOCK" 2>/dev/null` makes stderr a black hole for
    # everything after it, so a gate that watched stderr alone could never see this report.
    perr="$(MESH_REC_DIR="$tmp/rec4" MESH_REC_LOG="$tmp/log4" MESH_REC_SEEN="$tmp/seen4" \
      MESH_REC_TICK="$tmp/tick4" MESH_REC_MAX_MB=0 MESH_REC_ORGANS="ear|$tmp/empty/*.wav" \
      "$0" 2>&1)"
    printf '%s' "$perr" | grep -q 'unjoined' \
      || fail "the prune did not NAME its unjoined records — a join rotted to nothing looks like a corpus of zeros"
    printf '%s' "$perr" | grep -q 'ledger median' \
      || fail "the prune names unjoined records without naming the stand-in it ranked them at"
    # the ordering itself: with the cap at 0 both go, so assert the RANK directly instead — the
    # unjoined record must not sort below the score-90 one on score.
    medv="$(grep -oE 'score=[0-9.]+' "$tmp/log4" | cut -d= -f2 | sort -n \
            | awk '{v[NR]=$1} END{if(NR) printf "%.1f", v[int(NR/2)+1]; else print "0"}')"
    awk -v m="$medv" 'BEGIN{ if (m+0 <= 0) exit 1; if (m+0 >= 90) exit 1; exit 0 }' \
      || fail "the unjoined stand-in ($medv) is not a median between the fixture's 10 and 90 — the gate cannot distinguish it from the old 0 fallback"
    echo "  prune: unjoined records rank at the ledger median ($medv), not at 0, and the count is named"
    # AND THE RANKING ITSELF, not just the number it prints. Asserting the median VALUE leaves the
    # eviction free to keep using 0 — measured: a mutant restoring `score=0` passed every check
    # above. So drive a real eviction whose OUTCOME differs between the two rules: a MEASURED
    # record scored 10 against an UNJOINED one. Under the old 0 fallback the unjoined dies (0 < 10);
    # ranked at the median 50 the measured low-scorer dies instead and the unjoined SURVIVES.
    : > "$tmp/log5"; mkdir -p "$tmp/rec5"
    for sc in 10.0 50.0 90.0; do
      echo "2026-07-15T00:00Z ear bbbb${sc%%.*} dur=3.0 win=3.0 score=$sc beats=2 [even] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100.0 -> pending" >> "$tmp/log5"
    done
    head -c 2000000 /dev/zero > "$tmp/rec5/20260715-000000-ear-bbbb10.wav"    # measured, score 10
    head -c 2000000 /dev/zero > "$tmp/rec5/20260715-000100-ear-nojoin11.wav"  # unjoined
    touch -d '5 minutes ago' "$tmp/rec5/20260715-000000-ear-bbbb10.wav"
    touch -d '4 minutes ago' "$tmp/rec5/20260715-000100-ear-nojoin11.wav"
    MESH_REC_DIR="$tmp/rec5" MESH_REC_LOG="$tmp/log5" MESH_REC_SEEN="$tmp/seen5" \
      MESH_REC_TICK="$tmp/tick5" MESH_REC_MAX_MB=3 MESH_REC_ORGANS="ear|$tmp/empty/*.wav" \
      "$0" >/dev/null 2>&1
    [ -f "$tmp/rec5/20260715-000100-ear-nojoin11.wav" ] \
      || fail "the unjoined record was evicted ahead of a MEASURED score-10 one — the eviction still ranks a missing join at 0, whatever the report says"
    [ -f "$tmp/rec5/20260715-000000-ear-bbbb10.wav" ] \
      && fail "nothing was evicted — the size prune never ran, so this gate asserted nothing"
    echo "  prune: an unjoined record OUTLIVES a measured score-10 one (the eviction uses the median, not just the report)"

    # COVERAGE-RESERVE gate (2026-08-20). Per-organ retention above stopped a chatty organ from
    # flushing a RARE one; it did nothing about a chatty organ flushing its OWN history. Live the
    # same day: the ear's 600 retained lines spanned 13.1h while the corpus kept 14d, and the dyn
    # median moved +130.6% between the oldest and newest 100 of that window — so mesh-sound-reflex's
    # "corpus centre" was an answer about one hour. Drive the real trim: 60 lines, keep=10,
    # reserve=4. The OLDEST line must survive (span), and the count must still cap at 10 (budget).
    # This leg goes RED with MESH_REC_LOG_RESERVE=0 — verified by running it both ways.
    : > "$tmp/log6"; : > "$tmp/seen6"; mkdir -p "$tmp/rec6"
    for i in $(seq -w 1 60); do
      echo "2026-07-15T00:${i}Z ear cc0000$i dur=3.0 win=3.0 score=40.0 beats=2 [even] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100.0 -> pending" >> "$tmp/log6"
    done
    MESH_REC_DIR="$tmp/rec6" MESH_REC_LOG="$tmp/log6" MESH_REC_SEEN="$tmp/seen6" \
      MESH_REC_TICK="$tmp/tick6" MESH_REC_LOG_KEEP=10 MESH_REC_LOG_RESERVE=4 \
      MESH_REC_ORGANS="ear|$tmp/empty/*.wav" "$0" >/dev/null 2>&1
    n6="$(wc -l < "$tmp/log6")"
    [ "$n6" -le 10 ] || fail "the coverage reserve blew the retention budget ($n6 lines kept at keep=10) — the ledger is no longer bounded"
    grep -q ' ear cc000001 ' "$tmp/log6" \
      || fail "the oldest ledger line was flushed at keep=10/reserve=4 — retention is still a pure recency window, so the prior's 'corpus centre' is only ever the last few hours of the chattiest organ"
    grep -q ' ear cc000060 ' "$tmp/log6" \
      || fail "the NEWEST ledger line was flushed — the reserve has displaced recency instead of sharing the budget with it"
    sp6="$(awk '{print $1}' "$tmp/log6" | sed -n '1p;$p' | tr '\n' ' ')"
    echo "  reserve: 60 lines -> $n6 kept at keep=10/reserve=4, span $sp6 (oldest survives; res=0 makes this leg red)"

    # --organs IS THE DECLARATION, and its readers must not be able to drift from it (2026-08-21).
    # mesh-dash's SOURCES panel hand-carried four of these five names, so note3 was unrenderable
    # by construction. Two legs: the EMITTER must reproduce ORGANS_DEFAULT exactly (mutating the
    # sed/dedupe goes red — seen: a dropped `!seen[$0]++` renders "drop drop drop drop drop drop
    # ear …"), and an override must be honoured (a --test fixture's readers must see the fixture's
    # organs, not the node's).
    # WHAT THIS LEG CANNOT SEE, stated so nobody reads more into it: it re-derives the expectation
    # from ORGANS_DEFAULT in THIS file, so deleting an organ from the declaration deletes it from
    # both sides and the leg stays green (verified with that exact mutant — it survived). A gate
    # whose expectation is rebuilt from its own subject can only catch the transform, never the
    # input. The cross-file claim — "every DECLARED organ is actually rendered" — is asserted where
    # the two files meet, in mesh-dash --test's SOURCES coverage gate, which compares the panel's
    # output against `mesh-records --organs`; that one was seen RED against the four-name literal.
    _og="$("$0" --organs 2>/dev/null | tr '\n' ' ')"
    _od="$(printf '%s\n' "$ORGANS_DEFAULT" | sed -n 's/^\([a-z0-9_-]\{1,\}\)|.*/\1/p' | awk '!seen[$0]++' | tr '\n' ' ')"
    [ "$_og" = "$_od" ] \
      || { echo "smoke-test: FAIL (--organs '$_og' != the declared set '$_od' — a reader consuming it would drift from the declaration it exists to mirror)"; exit 1; }
    _oo="$(MESH_REC_ORGANS="zzz|/nowhere/*.wav" "$0" --organs 2>/dev/null | tr '\n' ' ')"
    [ "$_oo" = "zzz " ] \
      || { echo "smoke-test: FAIL (--organs ignored MESH_REC_ORGANS — got '$_oo', want 'zzz '; a fixture's readers would be told the NODE's organs)"; exit 1; }
    echo "smoke-test: ok (archived+measured a real 14s wav -> dur=${d}s, all axes real; content-dedupe holds on re-sweep; liveness touch present; per-organ retention holds; the coverage reserve keeps the oldest line inside the budget; unjoined records rank at the median, not 0; no mic/grind side-effect; --organs mirrors the declaration and honours an override)"
    exit 0 ;;

  ""|--sweep) : ;;
  *) echo "usage: mesh-records [--sweep] | --list [n] | --organs | --stats | --test"; exit 1 ;;
esac

mkdir -p "$REC_DIR"; touch "$SEEN" 2>/dev/null

# SINGLE-WRITER. The dedupe is check-then-write (grep the seen-index, then archive, then append), so
# two concurrent sweeps both pass the check and both archive the same record — a TOCTOU race that
# duplicates every ledger row. Not theoretical: caught live 2026-07-15, minutes after mesh-autowire
# put this on */2 — the cron sweep and a manual sweep interleaved and produced 16 rows from a sweep
# capped at 8, each hash written twice. It is also self-inflicted at steady state: one sweep costs
# ~29s of librosa for 8 records, so a backlog (or bigger files) pushes it past the 120s cadence and
# it races ITSELF. A skipped sweep is free — the next one is 2 minutes away and the work is
# idempotent — so a held lock exits 0, not an error.
exec 9>"$LOCK" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { [ -t 1 ] && echo "records: another sweep holds the lock — skipping (not an error)"; exit 0; }
fi

n=0
while IFS='|' read -r organ glob; do
  [ -n "${organ:-}" ] || continue
  for f in $glob; do
    [ -f "$f" ] || continue
    [ "$n" -ge "$MAX_PER_SWEEP" ] && break 2
    line="$(archive_one "$organ" "$f")"
    [ -n "$line" ] || continue
    echo "$line" >> "$REC_LOG"
    n=$((n+1))
    [ -t 1 ] && echo "$line"
  done
done <<< "$ORGANS"

prune_corpus
# Retain PER ORGAN, never by a global line count. A global `tail -n 600` is a retention unit the
# CHATTIEST organ owns: the ear writes ~120 lines/h, so the window was ~6h of ear while the corpus
# kept 14d, and every voice/scape line was flushed within hours of landing (live 2026-07-15 — corpus
# vs ledger: ear 1512/599, voice 5/0, scape 5/1).
#
# CORRECTED (same day, 9e5528f-era): the first version of this comment, and the commit message that
# landed it (3e15eb5), claimed this was WHY 0 non-ear records had ever been ground — "the grinder was
# never told they existed". That is FALSE, and it was inferred from a ledger that had flushed the very
# evidence which would have refuted it. A record's line is FRESH the moment it lands, and the reflex
# only ever reads fresh lines (after its anchor), so a non-ear record IS a candidate in the block it
# arrives in, whatever gets pruned 6h later. The seen-index backup settles it: the voice/scape hashes
# sit at positions 11-107 of 1535 in archive order, i.e. they were archived in the earliest sweeps and
# did compete. They lost, or failed MIN_BEATS. 0 non-ear renders (confirmed independently: 95/95 ear in
# room-music-params.log over 16h) is explained by RARITY — ~5 scapes per 16h against ~120 ear/h — plus
# the beat floor, not by this bug.
#
# What this retention actually breaks, which is still worth fixing: the ledger is the population
# corpus_pct ranks against and outlier_hw's high-water reads, and it is what the dash and any audit
# report. Flushing a rare organ makes that population a monoculture, silently. Per-organ keeps it
# bounded (organs x LOG_KEEP) while a rare organ keeps its whole history. File order is chronological,
# so emitting by original line number preserves it.
#
# AND WITHIN an organ, not all of the budget goes to the newest lines — see LOG_RESERVE above. The
# newest k-R are kept outright; R evenly-spaced picks across everything older keep the SPAN alive
# (index 1, the oldest surviving line, is always among them). Cheap, deterministic, no state: the
# older span is re-stratified from what survives, so it decimates progressively rather than being
# truncated, and total retained per organ never exceeds k.
awk -v k="$LOG_KEEP" -v R="$LOG_RESERVE" '
  { organ=$2; c[organ]++; at[organ SUBSEP c[organ]]=NR; line[NR]=$0 }
  END { if (R+0 < 0) R = 0
        if (R+0 > int(k/2)) R = int(k/2)          # the reserve may never outweigh recency
        for (o in c) {
          n = c[o]
          if (n <= k) { for (i=1; i<=n; i++) sel[at[o SUBSEP i]]=1; continue }
          s = n - (k - R) + 1; if (s < 1) s = 1
          for (i=s; i<=n; i++) sel[at[o SUBSEP i]]=1
          old = s - 1
          if (R > 0 && old > 0) {
            if (R >= old) { for (i=1; i<=old; i++) sel[at[o SUBSEP i]]=1 }
            else if (R == 1) sel[at[o SUBSEP 1]]=1
            else for (j=0; j<R; j++) {
              i = 1 + int(j * (old - 1) / (R - 1) + 0.5)
              if (i < 1) i = 1; if (i > old) i = old
              sel[at[o SUBSEP i]]=1
            }
          }
        }
        for (r=1; r<=NR; r++) if (r in sel) print line[r] }
' "$REC_LOG" > "$REC_LOG.tmp" 2>/dev/null && mv "$REC_LOG.tmp" "$REC_LOG"
# SEEN-INDEX RETENTION. The old comment here named the right hazard and the wrong BOUND: it said the
# index "must outlive the ledger's own window", and pinned 5000. The binding requirement is not the
# ledger's window — it is the SOURCE FILES' lifetime. A hash evicted from this index while its file is
# still on disk means that file is re-archived as new, re-measured (paid librosa), re-picked by the
# grinder, re-rendered (paid) and re-DELIVERED to the operator. The index is a dedup key store, not a
# log; trimming it by recency is trimming correctness.
#
# 5000 rotted into ~ONE DAY. Measured 2026-08-20: 150-200 records/hour (~4800/day), the file sitting
# at exactly 5000 with all 5000 distinct — i.e. saturated and evicting daily, while drop sources
# persist for weeks. Cost, counted in the manifests: 19 of 294 distinct source hashes carry more than
# one grind manifest; fdfdd3fb has FOUR (07-19, 07-20, 07-23, 08-19) and ee7f3fca was DELIVERED
# 08-03 and re-ground 08-20. Every one of those is a source ground twice and shipped twice.
#
# Derived, not pinned, for the reason this file already learned one prune below (the ledger keeps
# PER ORGAN "never by a global line count"): scale with the live ledger and floor high enough that a
# day's intake cannot turn it over. At 9 bytes/hash the floor costs ~1.8MB — nothing against one
# re-render. Re-derive the turnover before touching the floor; do not quote the figures above.
_seen_cap=$(( 50 * $(wc -l < "$REC_LOG" 2>/dev/null || echo 0) ))
[ "$_seen_cap" -lt 200000 ] && _seen_cap=200000
tail -n "$_seen_cap" "$SEEN" > "$SEEN.tmp" 2>/dev/null && mv "$SEEN.tmp" "$SEEN"

# mtime = liveness (EVERY successful sweep, whether or not anything was new); content = the ledger's
# own change-gated write. Decoupling them is the liveness-touch convention: a quiet-but-live
# archivist must never read as STALE to the mtime-aging watchdogs, and a dead cron never runs, never
# touches, and stays honestly STALE.
# --create, not a bare touch: mesh-state-touch SKIPS a missing file by design (it refuses to create a
# hollow state a consumer would read as real) and still exits 0, so a `|| touch` fallback never fires
# and the very first sweep leaves no marker at all — the archivist would read STALE from birth.
if command -v mesh-state-touch >/dev/null 2>&1; then
  mesh-state-touch --create "$TICK" >/dev/null 2>&1 || touch "$TICK"
else touch "$TICK"; fi
[ -t 1 ] && [ "$n" = 0 ] && echo "records: nothing new (corpus $(ls "$REC_DIR" 2>/dev/null | wc -l) files)"
exit 0
