#!/usr/bin/env python3
"""Consume post-activation synthetic wake requests through a durable outbox."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
from mesh_mishe_delivery import BoundaryError, atomic_json, check, dispatch_once, home, read_authority, read_json, synthetic


def mind_once(channel):
    """Explicit synthetic-only bridge: delivered outbox identity → disposable Mind."""
    synthetic(channel)
    dispatched = dispatch_once(channel)
    results = []
    for item in dispatched["results"]:
        if item["status"] != "delivered":
            results.append(item)
            continue
        current = read_authority(channel)
        if current["authority"] != "mishe" or current["generation"] != dispatched["generation"]:
            raise BoundaryError("authority changed before Mind launch")
        request_id = f"{channel}-g{current['generation']}-r{item['key'].rsplit(':', 1)[-1]}"
        path = home() / "mind-events" / channel / f"{request_id}.json"
        event = {"channel": channel, "request_id": request_id, "source": "observation/synthetic",
                 "generation": current["generation"], "outbox_key": item["key"]}
        if path.exists() and json.loads(path.read_text()) != event:
            raise BoundaryError("Mind event identity conflict")
        atomic_json(path, event)
        cmd = os.environ.get("MESH_MISHE_MIND_CMD", str(Path(__file__).with_name("mesh-mishe-mind")))
        try:
            attempt = subprocess.run([cmd, "--channel", channel, "--request-id", request_id,
                                      "--event-file", str(path)], text=True, capture_output=True, timeout=690)
            receipt = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh"))) / "mishe-mind" / channel / f"{request_id}.json"
            accepted = attempt.returncode == 0 and receipt.exists() and read_json(receipt).get("status") == "settled"
            detail = (attempt.stdout or attempt.stderr)[:300]
        except (OSError, subprocess.TimeoutExpired, BoundaryError) as exc:
            accepted, detail = False, f"{type(exc).__name__}: {exc}"[:300]
        results.append({"key": item["key"], "status": "mind-settled" if accepted else "unknown",
                        "request_id": request_id, "detail": detail})
    return {"channel": channel, "generation": dispatched["generation"], "results": results}


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--once", metavar="CHANNEL")
    mode.add_argument("--check", metavar="CHANNEL")
    mode.add_argument("--mind-once", metavar="CHANNEL")
    args = parser.parse_args()
    try:
        report = mind_once(args.mind_once) if args.mind_once else (dispatch_once(args.once) if args.once else check(args.check))
    except (BoundaryError, ValueError, OSError, ImportError) as exc:
        print(f"mesh-mishe-dispatch: UNKNOWN {exc}", file=sys.stderr)
        return 2
    print(json.dumps(report, sort_keys=True))
    if args.check:
        return 2 if report["status"] == "UNKNOWN" else 0
    return 2 if any(item["status"] == "unknown" for item in report["results"]) else 0


if __name__ == "__main__":
    raise SystemExit(main())
