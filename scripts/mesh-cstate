#!/usr/bin/env bash
# mesh-cstate — the CPU's DEEP-SLEEP residency sense: how deeply the silicon is actually resting.
# The CPU sibling of mesh-gpu-activity (which reads i915 RC6 = the GPU's deep-sleep). Reads the
# per-CPU hardware idle counters at /sys/devices/system/cpu/cpu*/cpuidle/state*/time (µs cumulative,
# world-readable 0444, NO sudo) — two snapshots over a ~2s wall window give the fraction of core-time
# spent idle, and of that, the fraction spent in DEEP C-states (C2/C3+) vs shallow (POLL/C1).
#
# WHY THIS IS A NEW SIGNAL (verified uncovered 2026-07-06 — no tool reads cpuidle; the grep hits were
# MAC-address fragments + GPU RC6, not CPU C-states):
#   - Load average / CPU-util count RUNNABLE tasks — they say the machine is "idle" at load 0. They are
#     BLIND to WHY it's idle: a core at load 0 can be in deep C3 (truly at rest, cool, ~0W) OR bouncing
#     in and out of shallow C1 on a wakeup storm (a chatty timer/IRQ/poller) — idle by the scheduler yet
#     never actually RESTING, burning power and heat. This sense sees that difference; load average can't.
#   - mesh-package-power (RAPL) reads the WATTS but not the sleep DEPTH; mesh-cpufreq reads clock when
#     AWAKE but says nothing about sleep; mesh-cooling-load reads the cooler's response. None reads how
#     deeply the cores sleep. This is the missing "quiescence" axis.
#
# CLASSIFICATION (the value-add is distinguishing the two flavours of "idle"):
#   BUSY          idle% < BUSY_LO — cores active, doing real work.
#   DEEP-REST     idle% >= IDLE_HI AND deep-of-idle ratio >= DEEP_RATIO — truly quiescent (cool, low power).
#   SHALLOW-REST  idle% >= IDLE_HI BUT deep ratio < DEEP_RATIO — "restless idle": idle by load but kept
#                 out of deep sleep by frequent wakeups. Invisible to every other sense. (retune from LOG)
#   LIGHT         in between.
#
# COVERAGE — the ~2s window on a */5 cadence saw 0.70% of wallclock (window-cadence-aliasing sweep,
# docs/window-cadence-coverage-2026-08-15.md). cpuidle state*/time is a MONOTONIC ACCUMULATOR and the
# tool differenced it 2s apart and threw the counters away: 99.3% of every interval went unobserved,
# so a four-minute wakeup storm that starts and ends between two cron ticks left this sense reporting
# DEEP-REST — honestly, and about 2 seconds of a 300-second claim. Carrying the counters in the state
# file and delta'ing ACROSS runs covers 100% of the interval at zero extra cost.
# BOTH windows are kept (the interval mean dilutes a sharp storm; the 2s one misses everything
# between ticks) and folded on the ACTIVITY direction — the BUSIER window (lower idle%) wins, named
# in won=inst|iv, with the deep%/ratio taken from the SAME window so the pair stays coherent. The
# per-window LEVELS are published too (level_inst/level_iv), because idle% alone cannot express the
# SHALLOW-vs-DEEP disjunction this sense exists for: a fold that only kept the busier window could
# hide a SHALLOW-REST seen by the other. Missing evidence renders na, never 0 — a reboot-reset
# counter differenced into "0% idle" would read as a fabricated BUSY, and a CPU hotplug changing
# ncpu changes the denominator, so that too is na.
#
# Every invocation rewrites the baseline, so the interval is "since the last run by ANYONE" (cron,
# a human, mesh-wakeup-attrib's fusion read) — never an assumed 300s. dt comes from the stored epoch,
# so a shorter or longer gap is measured, not guessed; only a gap past MAX_IV_AGE renders na.
#
# HONEST n/a: no readable cpuidle state*/time on this node (a VM/container with cpuidle hidden) → exit 2
#   (UNREACHABLE), never a fabricated residency. reflex-health/mesh-land treat exit 2 as an honest pass.
#
# State artifact ~/.mesh/.cstate-state is written EVERY run (UNCONDITIONAL → mtime = liveness, so no
# false-STALE; not change-gated, so no mesh-state-touch needed — same convention as mesh-gpu-activity).
# Per-run telemetry accumulates in ~/.mesh/cstate.log (thresholds below are PROVISIONAL — retune from it).
#
# THE MISPREDICTION AXIS (--predict, added 2026-08-18) — a DIFFERENT QUANTITY on the same surface.
# state*/time says how much idle and how deep; state*/{usage,above,below,rejected} (same 0444, no sudo,
# same monotonic accumulators) say how WELL the governor predicted: `above` = it went too DEEP and the
# core woke sooner than the state's target residency, paying that state's exit latency for nothing;
# `below` = too SHALLOW, it could have slept deeper; `rejected` = the driver refused the choice. A node
# can read DEEP-REST at 90% idle with a third of its entries mispredicted — residency cannot see that.
#
# TWO CELLS ARE 0 BY CONSTRUCTION and must never be folded in: the SHALLOWEST state cannot be "too
# deep" (above[0]) and the DEEPEST cannot be "too shallow" (below[N-1]) — measured 16/16 CPUs lifetime
# and in a 38s delta on this node. So the rates are published PER STATE, never blended: `above` only
# over states 1..N-1 and `below` only over 0..N-2. A blend would divide by the structural zeros and
# dilute every rate toward calm — and C2 alone carries ~87% of idle entries here, so the dilution is
# not small. `rejected` publishes its COVERAGE beside it (readable/expected, 48/48 today): all-zero is
# the HEALTHY reading, so a half-failed read's 0 must not wear it.
# The counters reset with state*/time on reboot, so they ride the SAME baseline file and the SAME
# staleness/hotplug/backwards guard (baseline_ok) — not a second one that can drift from it.
# NO THRESHOLD BAND, NO CLASSIFICATION here by design: bands are unearned until ~/.mesh/cstate-predict.log
# has accumulated something to retune from. The measurement lands first.
# An axis-less driver renders the misprediction verb n/a (exit 2) and leaves the residency verb exactly
# as it is today — an ADDED axis degrades to yesterday's behaviour, never to UNREACHABLE.
#
#   mesh-cstate           one ~2s sample: idle%/deep% + BUSY/LIGHT/SHALLOW-REST/DEEP-REST, writes state+log
#   mesh-cstate --json    same sample, JSON
#   mesh-cstate --status  last state-file reading, no new sample (READ-ONLY, no mutation)
#   mesh-cstate --predict [--json]   per-state above/below/rejected rates, inst + across-run interval
#                         (READ-ONLY: reads the baseline, writes nothing — the */5 run does the logging)
#   mesh-cstate --test    fixture math (delta/clamp/classify) + REAL-READ GATE (live sample 0-100 or exit 2)
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MODE="${1:-}"   # captured BEFORE any `set -- ...` below clobbers $1 (was: --json silently never fired)

CPUDIR="${MESH_CSTATE_CPUDIR:-/sys/devices/system/cpu}"
DEEP_IDX="${MESH_CSTATE_DEEP_IDX:-2}"          # cpuidle state index >= this = a DEEP C-state (state0=POLL,1=C1 shallow)
SECS="${MESH_CSTATE_SAMPLE_SECS:-2}"
IDLE_HI="${MESH_CSTATE_IDLE_HI:-80}"           # idle% at/above this = "resting" (provisional)
BUSY_LO="${MESH_CSTATE_BUSY_LO:-40}"           # idle% below this = BUSY (provisional)
DEEP_RATIO="${MESH_CSTATE_DEEP_RATIO:-0.50}"   # deep/total-idle at/above this = DEEP vs SHALLOW rest (provisional)
STATE="${MESH_CSTATE_STATE:-$HOME/.mesh/.cstate-state}"
LOG="${MESH_CSTATE_LOG:-$HOME/.mesh/cstate.log}"
# Misprediction telemetry lands in its OWN file so cstate.log's columns stay stable for its readers.
PLOG="${MESH_CSTATE_PREDICT_LOG:-$HOME/.mesh/cstate-predict.log}"
# How stale a carried baseline may be before the interval renders na: past it the reflex was DOWN
# and the "average" would span a gap nobody observed. 4x the */5 cadence.
MAX_IV_AGE="${MESH_CSTATE_MAX_IV_AGE:-1200}"

# snapshot: sum idle µs across ALL cpus → "all_us deep_us ncpu". Deep = state index >= DEEP_IDX.
# Returns 1 (fail) if no readable cpuidle counters exist (honest n/a, never a fabricated 0).
snapshot() {
  local all=0 deep=0 ncpu=0 cpu st idx t
  for cpu in "$CPUDIR"/cpu[0-9]*/cpuidle; do
    [ -d "$cpu" ] || continue
    ncpu=$((ncpu + 1))
    for st in "$cpu"/state[0-9]*; do
      [ -r "$st/time" ] || continue
      idx="${st##*/state}"
      case "$idx" in (''|*[!0-9]*) continue;; esac
      t=$(cat "$st/time" 2>/dev/null)
      case "$t" in (''|*[!0-9]*) continue;; esac
      all=$((all + t))
      [ "$idx" -ge "$DEEP_IDX" ] && deep=$((deep + t))
    done
  done
  [ "$ncpu" -gt 0 ] || return 1
  printf '%s %s %s' "$all" "$deep" "$ncpu"
}

# state_names: the C-state NAMES from the first cpu (POLL C1 C2 ...), for rendering only. A name is
# cosmetic; every rate below is keyed on the state INDEX, which is what the counters are keyed on.
state_names() {
  local cpu st n out=""
  for cpu in "$CPUDIR"/cpu[0-9]*/cpuidle; do
    [ -d "$cpu" ] || continue
    for st in "$cpu"/state[0-9]*; do
      n=''; [ -r "$st/name" ] && read -r n < "$st/name" 2>/dev/null
      out="$out ${n:-state${st##*/state}}"
    done
    break
  done
  printf '%s' "${out# }"
}

# pred_snapshot: the MISPREDICTION counters — usage/above/below/rejected summed across all cpus, kept
# PER STATE (never pre-blended; see the header). Reads are bash builtins, no fork per file.
# prints "<nstates> <nexp> <nread> <nrej> u0 a0 b0 r0 u1 a1 b1 r1 ..."
#   nexp  = (cpu,state) cells enumerated            — the COVERAGE denominator
#   nread = cells that gave usage AND above AND below
#   nrej  = cells that gave rejected               — published beside the value, because all-zero is
#           the healthy reading and a half-failed read's 0 must not be mistaken for it.
# returns 1 if NOT ONE cell exposed above/below (a driver without the axis) → honest n/a, and the
# caller must leave the residency verb alone.
pred_snapshot() {
  local cpu st idx u a b r nexp=0 nread=0 nrej=0 maxidx=-1 i out=""
  local -a U=() A=() B=() R=()
  for cpu in "$CPUDIR"/cpu[0-9]*/cpuidle; do
    [ -d "$cpu" ] || continue
    for st in "$cpu"/state[0-9]*; do
      idx="${st##*/state}"
      case "$idx" in (''|*[!0-9]*) continue;; esac
      nexp=$((nexp + 1))
      [ "$idx" -gt "$maxidx" ] && maxidx="$idx"
      u=''; a=''; b=''; r=''
      [ -r "$st/usage" ]    && read -r u < "$st/usage"    2>/dev/null
      [ -r "$st/above" ]    && read -r a < "$st/above"    2>/dev/null
      [ -r "$st/below" ]    && read -r b < "$st/below"    2>/dev/null
      [ -r "$st/rejected" ] && read -r r < "$st/rejected" 2>/dev/null
      case "$u" in (''|*[!0-9]*) u='';; esac
      case "$a" in (''|*[!0-9]*) a='';; esac
      case "$b" in (''|*[!0-9]*) b='';; esac
      case "$r" in (''|*[!0-9]*) r='';; esac
      if [ -n "$u" ] && [ -n "$a" ] && [ -n "$b" ]; then
        nread=$((nread + 1))
        U[$idx]=$(( ${U[$idx]:-0} + u )); A[$idx]=$(( ${A[$idx]:-0} + a )); B[$idx]=$(( ${B[$idx]:-0} + b ))
      fi
      if [ -n "$r" ]; then nrej=$((nrej + 1)); R[$idx]=$(( ${R[$idx]:-0} + r )); fi
    done
  done
  [ "$nread" -gt 0 ] || return 1
  for ((i = 0; i <= maxidx; i++)); do
    out="$out ${U[$i]:-0} ${A[$i]:-0} ${B[$i]:-0} ${R[$i]:-0}"
  done
  printf '%s %s %s %s%s' "$((maxidx + 1))" "$nexp" "$nread" "$nrej" "$out"
}

# pred_delta <nstates> "<prev quads>" "<now quads>" -> one line per state: "idx d_usage d_above d_below d_rejected"
# Returns 1 if ANY counter went BACKWARDS — these reset together with state*/time on reboot, which is
# the whole reason they share the residency axis's baseline instead of growing their own.
pred_delta() {
  awk -v ns="$1" -v p="$2" -v c="$3" 'BEGIN{
    np=split(p,P," "); nc=split(c,C," ");
    if (ns+0<1 || np<ns*4 || nc<ns*4) exit 1;
    for (i=1;i<=ns*4;i++) { d=C[i]-P[i]; if (d<0) exit 1; D[i]=d }
    for (s=0;s<ns;s++) printf "%d %d %d %d %d\n", s, D[s*4+1], D[s*4+2], D[s*4+3], D[s*4+4];
  }'
}

# pred_rates <nstates> "<names>"   (delta lines on stdin)
#   -> "idx name d_usage above_pct below_pct d_rejected" per state, then
#      "worst <above_state> <above_pct> <below_state> <below_pct> <total_rejected> <total_usage>"
# THE STRUCTURAL CELLS RENDER na, NOT 0: above on state 0 and below on state N-1 are zero by
# construction, and a 0 there is a value that would drag any later fold toward calm. na is a claim
# about the AXIS ("this cell cannot carry a misprediction"), 0 would be a claim about the node.
pred_rates() {
  awk -v ns="$1" -v names="$2" '
  BEGIN{ split(names, NM, " ") }
  {
    s=$1; du=$2; da=$3; db=$4; dr=$5;
    nm=((s+1) in NM) ? NM[s+1] : ("state" s);
    ab="na"; bl="na";
    if (s > 0      && du > 0) ab=sprintf("%.1f", da*100/du);
    if (s < ns-1   && du > 0) bl=sprintf("%.1f", db*100/du);
    printf "%d %s %d %s %s %d\n", s, nm, du, ab, bl, dr;
    if (ab != "na" && (!sa || ab+0 > wa)) { sa=1; wa=ab+0; wan=nm }
    if (bl != "na" && (!sb || bl+0 > wb)) { sb=1; wb=bl+0; wbn=nm }
    tr+=dr; tu+=du;
  }
  END{
    printf "worst %s %s %s %s %d %d\n",
      (sa?wan:"na"), (sa?sprintf("%.1f",wa):"na"),
      (sb?wbn:"na"), (sb?sprintf("%.1f",wb):"na"), tr+0, tu+0;
  }'
}

# pred_arr_json  (rate lines on stdin, worst line skipped) -> a JSON array; na renders null, never 0.
pred_arr_json() {
  local first=1 out="[" s nm du ab bl dr
  while read -r s nm du ab bl dr; do
    [ "$s" = worst ] && continue
    [ "$first" = 1 ] || out="$out,"; first=0
    out="$out{\"state\":$s,\"name\":\"$nm\",\"usage\":$du,\"above_pct\":$([ "$ab" = na ] && echo null || echo "$ab"),\"below_pct\":$([ "$bl" = na ] && echo null || echo "$bl"),\"rejected\":$dr}"
  done
  printf '%s]' "$out"
}

# compute: all1 all2 deep1 deep2 ncpu dt_us → "idle_pct deep_pct deep_ratio" (clamped 0-100; monotonic
# counters so a negative delta = error). avail = ncpu × dt_us (each core has dt_us of wall to spend).
compute() {
  awk -v a1="$1" -v a2="$2" -v d1="$3" -v d2="$4" -v n="$5" -v dt="$6" 'BEGIN{
    da=a2-a1; dd=d2-d1; avail=n*dt;
    if (dt<=0 || n<=0 || da<0 || dd<0 || avail<=0) exit 1;
    idle=da/avail*100; deep=dd/avail*100;
    if (idle>100) idle=100; if (deep>100) deep=100; if (idle<0) idle=0; if (deep<0) deep=0;
    dr=(da>0)?dd/da:0;
    printf "%.1f %.1f %.2f", idle, deep, dr;
  }'
}

# interval_res <prev_raw> <now_epoch_s> <all_us> <deep_us> <ncpu> <max_age_s>
#   -> "idle_pct deep_pct deep_ratio" from the ACROSS-RUN accumulator delta, or "na na na".
# MISSING EVIDENCE RENDERS na, NEVER 0: no baseline (first run / pre-upgrade state line), a counter
# that went BACKWARDS (reboot — cpuidle time resets to 0), a baseline older than max_age (never
# average across a gap the reflex did not watch), a garbage field, dt<=0, or an ncpu that CHANGED
# (hotplug moves the denominator: avail = ncpu × dt, so the same delta means something else).
# 0% idle is the BUSY end of this axis, so a fabricated 0 here is a fabricated ALARM, not a
# fabricated calm — wrong in the other direction, equally wrong.
# baseline_ok <prev_raw> <now_epoch_s> <ncpu> <max_age_s> -> prints dt(s), rc 0 if the carried
# baseline is comparable at all. THE ONE guard, shared by EVERY axis delta'd across runs (residency
# AND the misprediction counters): they live in one file, reset together on reboot and go stale
# together, so a second copy of this rule could only drift out of step with the first.
# Trailing fields beyond the 4 it validates are the misprediction block and are ignored here —
# _rest exists so `read` does not stuff them into pn and turn every interval into a false na.
baseline_ok() {
  local prev="$1" ne="$2" n="$3" maxage="$4"
  local pe pall pdeep pn _rest dt _f
  read -r pe pall pdeep pn _rest <<< "$prev"
  for _f in "$pe" "$pall" "$pdeep" "$pn"; do
    case "$_f" in ''|*[!0-9]*) return 1;; esac
  done
  dt=$(( ne - pe ))
  [ "$dt" -gt 0 ] || return 1
  [ "$dt" -le "$maxage" ] || return 1
  [ "$pn" = "$n" ] || return 1
  printf '%s' "$dt"
}

interval_res() {
  local prev="$1" ne="$2" all="$3" deep="$4" n="$5" maxage="$6"
  local pe pall pdeep pn _rest dt
  dt=$(baseline_ok "$prev" "$ne" "$n" "$maxage") || { printf 'na na na\n'; return; }
  read -r pe pall pdeep pn _rest <<< "$prev"
  if [ "$all" -lt "$pall" ] || [ "$deep" -lt "$pdeep" ]; then printf 'na na na\n'; return; fi
  compute "$pall" "$all" "$pdeep" "$deep" "$n" "$(( dt * 1000000 ))" 2>/dev/null || printf 'na na na\n'
}

# fold_idle <inst_idle> <iv_idle|na> -> "<fused> <winner>"  (winner: inst|iv)
# The fold runs on the ACTIVITY direction: the BUSIER window (LOWER idle%) wins, because that is the
# one that saw work the other missed. na loses by default; a tie names inst. A max that hides its
# disjunction turns "the CPU rested for the last five minutes" and "the two seconds I watched were
# restful" into the same sentence — they are different claims, so the winner is always named.
fold_idle() {
  local inst="$1" iv="${2:-na}"
  case "$iv" in ''|na) printf '%s inst\n' "$inst"; return;; esac
  awk -v a="$inst" -v b="$iv" 'BEGIN{ if (b+0 < a+0) printf "%s iv\n", b; else printf "%s inst\n", a }'
}

# classify: idle_pct deep_ratio → BUSY | DEEP-REST | SHALLOW-REST | LIGHT
classify() {
  awk -v i="$1" -v dr="$2" -v ihi="$IDLE_HI" -v blo="$BUSY_LO" -v drhi="$DEEP_RATIO" 'BEGIN{
    if (i < blo) print "BUSY";
    else if (i >= ihi && dr >= drhi) print "DEEP-REST";
    else if (i >= ihi) print "SHALLOW-REST";
    else print "LIGHT";
  }'
}

# ============================== --test (sandboxed: no state/log write) ==============================
if [ "$MODE" = "--test" ]; then
  fail=0
  # (a) plain delta: over a 2s window (2000000µs) on 4 cpus (avail=8000000), cores idle 6000000µs of which
  #     4000000µs deep → idle 75.0%, deep 50.0%, ratio 0.67
  read -r ip dp dr <<<"$(compute 0 6000000 0 4000000 4 2000000)"
  [ "$ip" = 75.0 ] && [ "$dp" = 50.0 ] && [ "$dr" = 0.67 ] || { echo "  FAIL: delta → idle=$ip deep=$dp dr=$dr (want 75.0 50.0 0.67)"; fail=1; }
  # (b) fully idle + all deep → 100/100/1.00
  read -r ip dp dr <<<"$(compute 0 8000000 0 8000000 4 2000000)"
  [ "$ip" = 100.0 ] && [ "$dp" = 100.0 ] && [ "$dr" = 1.00 ] || { echo "  FAIL: full-deep → $ip $dp $dr (want 100.0 100.0 1.00)"; fail=1; }
  # (c) slight timing overshoot must CLAMP to 100, never exceed
  read -r ip dp dr <<<"$(compute 0 8100000 0 0 4 2000000)"
  [ "$ip" = 100.0 ] || { echo "  FAIL: idle overshoot must clamp to 100.0, got $ip"; fail=1; }
  # (d) fully busy: no idle delta → 0/0/0
  read -r ip dp dr <<<"$(compute 5000 5000 5000 5000 4 2000000)"
  [ "$ip" = 0.0 ] || { echo "  FAIL: fully-busy idle → $ip (want 0.0)"; fail=1; }
  # (e) error guards: zero interval + negative delta must fail
  compute 0 100 0 0 4 0 >/dev/null 2>&1 && { echo "  FAIL: zero interval must error"; fail=1; }
  compute 100 0 0 0 4 2000000 >/dev/null 2>&1 && { echo "  FAIL: negative idle delta must error"; fail=1; }
  # (f) classify: the four regimes + the SHALLOW-vs-DEEP distinction (the whole point)
  [ "$(classify 20.0 0.9)" = BUSY ]         || { echo "  FAIL: classify(20,.9) != BUSY"; fail=1; }
  [ "$(classify 90.0 0.8)" = DEEP-REST ]    || { echo "  FAIL: classify(90,.8) != DEEP-REST"; fail=1; }
  [ "$(classify 90.0 0.2)" = SHALLOW-REST ] || { echo "  FAIL: classify(90,.2) != SHALLOW-REST (restless idle)"; fail=1; }
  [ "$(classify 60.0 0.9)" = LIGHT ]        || { echo "  FAIL: classify(60,.9) != LIGHT"; fail=1; }
  [ "$(classify 80.0 0.50)" = DEEP-REST ]   || { echo "  FAIL: boundary classify(80,.50) != DEEP-REST"; fail=1; }
  [ "$(classify 40.0 0.9)" = LIGHT ]        || { echo "  FAIL: boundary classify(40,.9) != LIGHT (not BUSY)"; fail=1; }
  # (g) snapshot honest-fail on an empty fixture dir (no cpuidle → return 1, never a fake 0)
  _td=$(mktemp -d); trap 'rm -rf "$_td"' EXIT
  if CPUDIR="$_td" snapshot >/dev/null 2>&1; then echo "  FAIL: snapshot on empty dir must fail (no fabricated 0)"; fail=1; fi
  # (h) snapshot fixture: 2 cpus, states 0..3, deep=state>=2
  for c in 0 1; do for s in 0 1 2 3; do mkdir -p "$_td/cpu$c/cpuidle/state$s"; printf '%s\n' "$(( (s+1)*1000 ))" >"$_td/cpu$c/cpuidle/state$s/time"; done; done
  read -r sa sd sn <<<"$(CPUDIR="$_td" snapshot)"
  # per cpu: all=1000+2000+3000+4000=10000, deep(s2+s3)=3000+4000=7000; ×2 cpus
  [ "$sa" = 20000 ] && [ "$sd" = 14000 ] && [ "$sn" = 2 ] || { echo "  FAIL: snapshot fixture → all=$sa deep=$sd n=$sn (want 20000 14000 2)"; fail=1; }
  # ---- MISPREDICTION axis: the per-state mapping, the structural cells, the honest n/a ----------
  # pred_delta must keep the quads PER STATE. A rotated index is THE failure mode of this axis (it
  # silently moves a real above-rate onto a cell that is 0 by construction), so the arithmetic is
  # pinned here and the live gate below aims at the same wire.
  _pdd=$(pred_delta 3 "10 0 5 0 20 1 6 0 30 2 7 0" "12 0 6 0 25 3 6 0 36 8 7 0")
  [ "$(printf '%s\n' "$_pdd" | tr '\n' ';')" = "0 2 0 1 0;1 5 2 0 0;2 6 6 0 0;" ] \
    || { echo "  FAIL: pred_delta per-state → $(printf '%s' "$_pdd" | tr '\n' ';') (want '0 2 0 1 0;1 5 2 0 0;2 6 6 0 0;')"; fail=1; }
  # these counters reset with state*/time on reboot — a backwards delta must refuse, never wrap
  pred_delta 3 "10 0 5 0 20 1 6 0 30 2 7 0" "9 0 6 0 25 3 6 0 36 8 7 0" >/dev/null 2>&1 \
    && { echo "  FAIL: pred_delta must refuse a BACKWARDS counter (reboot resets these too)"; fail=1; }
  pred_delta 3 "10 0 5 0" "12 0 6 0 25 3 6 0 36 8 7 0" >/dev/null 2>&1 \
    && { echo "  FAIL: pred_delta must refuse a SHORT baseline (state count changed)"; fail=1; }
  _prr=$(printf '%s\n' "$_pdd" | pred_rates 3 "POLL C1 C2")
  # THE STRUCTURAL CELLS RENDER na, NOT 0: shallowest-above and deepest-below cannot carry a
  # misprediction, and a 0 there would drag any downstream fold toward calm.
  printf '%s\n' "$_prr" | grep -q '^0 POLL 2 na 50\.0 0$' \
    || { echo "  FAIL: shallowest above must be na (structural), got: $(printf '%s\n' "$_prr" | sed -n 1p)"; fail=1; }
  printf '%s\n' "$_prr" | grep -q '^1 C1 5 40\.0 0\.0 0$' \
    || { echo "  FAIL: middle state rates → $(printf '%s\n' "$_prr" | sed -n 2p) (want '1 C1 5 40.0 0.0 0')"; fail=1; }
  printf '%s\n' "$_prr" | grep -q '^2 C2 6 100\.0 na 0$' \
    || { echo "  FAIL: deepest below must be na (structural), got: $(printf '%s\n' "$_prr" | sed -n 3p)"; fail=1; }
  # ...and the per-state rate is NOT the blend: pooled above = (0+2+6)/(2+5+6) = 61.5%, which is
  # neither C1's 40.0 nor C2's 100.0. The worst-of NAMES its state so the two can never be confused.
  printf '%s\n' "$_prr" | grep -q '^worst C2 100\.0 POLL 50\.0 0 13$' \
    || { echo "  FAIL: worst line → $(printf '%s\n' "$_prr" | grep '^worst') (want 'worst C2 100.0 POLL 50.0 0 13')"; fail=1; }
  # coverage travels WITH the value: rejected all-zero is the HEALTHY reading, so nread/nrej are
  # reported per read and a baseline taken at a different coverage is refused upstream.
  _pe=$(mktemp -d)
  if CPUDIR="$_pe" pred_snapshot >/dev/null 2>&1; then echo "  FAIL: pred_snapshot on an empty dir must fail (no fabricated 0)"; fail=1; fi
  # (d) A DRIVER WITHOUT THE AXIS: usage/time present, above/below absent → pred_snapshot n/a while
  # snapshot() still reads fine. The added axis must degrade to yesterday's behaviour, not take the
  # residency verb down with it.
  for c in 0 1; do for st in 0 1 2 3; do
    mkdir -p "$_pe/cpu$c/cpuidle/state$st"
    printf '%s\n' "$(( (st+1)*1000 ))" >"$_pe/cpu$c/cpuidle/state$st/time"
    printf '%s\n' "$(( (st+1)*10 ))"   >"$_pe/cpu$c/cpuidle/state$st/usage"
  done; done
  if CPUDIR="$_pe" pred_snapshot >/dev/null 2>&1; then echo "  FAIL: usage-only driver (no above/below) must render n/a, not a rate"; fail=1; fi
  CPUDIR="$_pe" snapshot >/dev/null 2>&1 || { echo "  FAIL: the residency snapshot must still work on a driver that hides above/below"; fail=1; }
  # now give it the axis: 2 cpus x 4 states, above=0 on state0 and below=0 on state3 (as the hardware has)
  for c in 0 1; do for st in 0 1 2 3; do
    printf '%s\n' "$([ "$st" = 0 ] && echo 0 || echo $(( st*7 )))" >"$_pe/cpu$c/cpuidle/state$st/above"
    printf '%s\n' "$([ "$st" = 3 ] && echo 0 || echo $(( st*3 + 1 )))" >"$_pe/cpu$c/cpuidle/state$st/below"
    printf '0\n' >"$_pe/cpu$c/cpuidle/state$st/rejected"
  done; done
  read -r _fns _fnexp _fnread _fnrej _fq <<< "$(CPUDIR="$_pe" pred_snapshot)"
  [ "$_fns" = 4 ] && [ "$_fnexp" = 8 ] && [ "$_fnread" = 8 ] && [ "$_fnrej" = 8 ] \
    || { echo "  FAIL: pred_snapshot coverage → ns=$_fns nexp=$_fnexp nread=$_fnread nrej=$_fnrej (want 4 8 8 8)"; fail=1; }
  [ "$_fq" = "20 0 2 0 40 14 8 0 60 28 14 0 80 42 0 0" ] \
    || { echo "  FAIL: pred_snapshot quads → '$_fq' (want '20 0 2 0 40 14 8 0 60 28 14 0 80 42 0 0')"; fail=1; }
  # a half-failed read must MOVE THE COVERAGE, not quietly shrink the sums into a plausible number
  rm -f "$_pe/cpu1/cpuidle/state2/above" "$_pe/cpu1/cpuidle/state2/rejected"
  read -r _fns2 _fnexp2 _fnread2 _fnrej2 _fq2 <<< "$(CPUDIR="$_pe" pred_snapshot)"
  [ "$_fnread2" = 7 ] && [ "$_fnrej2" = 7 ] && [ "$_fnexp2" = 8 ] \
    || { echo "  FAIL: a half-failed read must show cov 7/8, got nread=$_fnread2 nrej=$_fnrej2 nexp=$_fnexp2"; fail=1; }
  rm -rf "$_pe"
  # ---- COVERAGE gates: the across-run interval window and the fold that names its winner --------
  # fold_idle folds on the ACTIVITY direction — the BUSIER (lower-idle) window wins, and is NAMED.
  [ "$(fold_idle 90.0 30.0)" = "30.0 iv" ]   || { echo "  FAIL: fold_idle 90 30 → $(fold_idle 90.0 30.0) (want '30.0 iv' — the busier window wins)"; fail=1; }
  [ "$(fold_idle 20.0 95.0)" = "20.0 inst" ] || { echo "  FAIL: fold_idle 20 95 → $(fold_idle 20.0 95.0) (want '20.0 inst')"; fail=1; }
  [ "$(fold_idle 50.0 50.0)" = "50.0 inst" ] || { echo "  FAIL: fold_idle tie → $(fold_idle 50.0 50.0) (want '50.0 inst')"; fail=1; }
  [ "$(fold_idle 77.0 na)"   = "77.0 inst" ] || { echo "  FAIL: fold_idle na → $(fold_idle 77.0 na) (want '77.0 inst' — na never wins)"; fail=1; }
  # interval_res: a real across-run delta. prev at t=0 on 2 cpus; now at t=100s with 150000000µs
  # idle of which 100000000µs deep → avail=200000000µs → idle 75.0%, deep 50.0%, ratio 0.67.
  r="$(interval_res "0 0 0 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "75.0 50.0 0.67" ] || { echo "  FAIL: interval_res → '$r' (want '75.0 50.0 0.67')"; fail=1; }
  # MISSING EVIDENCE RENDERS na, NEVER 0 — and 0 is the BUSY end here, so a fabricated 0 is a
  # fabricated ALARM. Each of these must refuse to produce a reading.
  r="$(interval_res "" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: no baseline (first run) → '$r' (want na)"; fail=1; }
  # This one asserts the CONTRACT (na on a backwards counter), not a particular line: compute()'s own
  # negative-delta check catches the same fixture, so deleting interval_res's explicit reset guard
  # ALONE leaves this green — measured. It goes red when both are gone (the reading then clamps to
  # idle=0.0%, a fabricated BUSY). Recorded rather than hidden: a gate that overlaps another guard
  # pins behaviour, not that guard.
  r="$(interval_res "0 999999999 0 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: counter went BACKWARDS (reboot resets cpuidle) → '$r' (want na)"; fail=1; }
  r="$(interval_res "0 0 0 2" 99999 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: stale baseline past max-age → '$r' (want na — never average across an unobserved gap)"; fail=1; }
  r="$(interval_res "0 0 garbage 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: garbage state field → '$r' (want na)"; fail=1; }
  r="$(interval_res "100 0 0 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: dt=0 → '$r' (want na)"; fail=1; }
  # ncpu CHANGED (hotplug) moves the denominator avail=ncpu×dt — the same delta then means something
  # else, so the baseline is not comparable. Without this guard the reading is silently rescaled.
  r="$(interval_res "0 0 0 4" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: ncpu changed 4→2 (hotplug) → '$r' (want na — the denominator moved)"; fail=1; }
  # ---- REAL-READ GATE: a live sample must yield finite 0-100 idle% or honestly exit 2 (no fake green) ----
  if ! s1=$(snapshot); then
    echo "smoke-test: n/a — no readable cpuidle state*/time on this node (cpuidle hidden — VM/container)"
    exit 2
  fi
  t1=$(date +%s%N); sleep 1; s2=$(snapshot) || { echo "  FAIL: second live snapshot failed after first succeeded"; fail=1; s2=$s1; }
  t2=$(date +%s%N)
  set -- $s1; a1=$1 d1=$2 n1=$3; set -- $s2; a2=$1 d2=$2
  live=$(compute "$a1" "$a2" "$d1" "$d2" "$n1" $(( (t2 - t1) / 1000 ))) || live=""
  case "$live" in
    ('') echo "  FAIL: live-read gate — idle% not finite (hollow sense)"; fail=1;;
    (*)  set -- $live; echo "  live read: idle=$1% deep=$2% ratio=$3 ($(classify "$1" "$3")) — real hardware produced data";;
  esac

  # ---- REAL-READ GATE for the MISPREDICTION axis + the two structural zeros --------------------
  # A fixture cannot catch a miswired state index when every cell is nonzero. The hardware can: the
  # SHALLOWEST state's `above` and the DEEPEST state's `below` are 0 by construction, so a rotated
  # mapping lands a real, large number in a cell that must be zero. Both windows are asserted — the
  # live delta (this run really read the counters) and the LIFETIME totals (where the constraint is
  # unambiguous and cannot pass by accident on a quiet second).
  if ! _L1=$(pred_snapshot); then
    echo "  note: cpuidle above/below not exposed here — --predict renders n/a and the residency verbs are unaffected"
  else
    sleep 1
    if ! _L2=$(pred_snapshot); then
      echo "  FAIL: second live pred_snapshot failed after the first succeeded"; fail=1
    else
      read -r _lns _lnexp _lnread _lnrej _lq1 <<< "$_L1"
      read -r _x1 _x2 _x3 _x4 _lq2 <<< "$_L2"
      if ! _ld=$(pred_delta "$_lns" "$_lq1" "$_lq2"); then
        echo "  FAIL: live misprediction delta went backwards within one second"; fail=1
      else
        # (0) the state COUNT must match the state dirs the driver publishes. MEASURED, not assumed:
        #     shifting pred_snapshot's index by +1 leaves (2) and (3) GREEN — the displaced cell is
        #     empty, so both structural zeros still hold and the run only prints the not-discriminating
        #     note. The count is what goes red on that mutation, so it is not a redundant assert.
        _nnm=$(state_names | wc -w)
        [ "$_lns" = "$_nnm" ] || { echo "  FAIL: pred_snapshot saw $_lns states but the driver publishes $_nnm — the state index is shifted"; fail=1; }
        # (1) a REAL read: the hardware moved at least one state's usage in 1s
        _nz=$(printf '%s\n' "$_ld" | awk '$2>0{c++} END{print c+0}')
        [ "$_nz" -gt 0 ] || { echo "  FAIL: live-read gate — no Δusage on ANY cpuidle state in 1s (hollow read)"; fail=1; }
        # (2) THE STRUCTURAL ZEROS in the live delta
        _da0=$(printf '%s\n' "$_ld" | awk '$1==0{print $3}')
        _dbN=$(printf '%s\n' "$_ld" | awk -v s=$((_lns-1)) '$1==s{print $4}')
        [ "${_da0:-x}" = 0 ] || { echo "  FAIL: shallowest state's Δabove=$_da0, must be 0 by construction — the state index mapping is wired wrong"; fail=1; }
        [ "${_dbN:-x}" = 0 ] || { echo "  FAIL: deepest state's Δbelow=$_dbN, must be 0 by construction — the state index mapping is wired wrong"; fail=1; }
        # (3) the same two cells over LIFETIME — a much longer window, so a rotation cannot hide in
        #     a quiet second. Their non-structural partners must be NONZERO, else assertion (2) is
        #     agreeing with an all-quiet axis rather than constraining anything; that vacuity is
        #     PRINTED rather than hidden, because a gate that cannot fail is not a gate.
        _la0=$(awk -v q="$_lq2" 'BEGIN{split(q,Q," "); print Q[2]+0}')
        _lbN=$(awk -v q="$_lq2" -v s=$((_lns-1)) 'BEGIN{split(q,Q," "); print Q[s*4+3]+0}')
        _laN=$(awk -v q="$_lq2" -v s=$((_lns-1)) 'BEGIN{split(q,Q," "); print Q[s*4+2]+0}')
        _lb0=$(awk -v q="$_lq2" 'BEGIN{split(q,Q," "); print Q[3]+0}')
        [ "$_la0" = 0 ] || { echo "  FAIL: shallowest state's LIFETIME above=$_la0 (must be 0 by construction — miswired index, or this driver breaks the constraint)"; fail=1; }
        [ "$_lbN" = 0 ] || { echo "  FAIL: deepest state's LIFETIME below=$_lbN (must be 0 by construction — miswired index, or this driver breaks the constraint)"; fail=1; }
        if [ "$_laN" -gt 0 ] && [ "$_lb0" -gt 0 ]; then
          echo "  live misprediction read: ${_lns} states, cov ${_lnread}/${_lnexp} (rejected ${_lnrej}/${_lnexp}), Δusage on $_nz state(s); structural zeros hold and DISCRIMINATE (deepest above=$_laN, shallowest below=$_lb0 are nonzero)"
        else
          echo "  note: deepest-above=$_laN shallowest-below=$_lb0 — both non-structural partners are quiet, so the structural-zero gate is NOT discriminating on this node right now"
        fi
      fi
    fi
  fi

  # ---- STATE ROUND-TRIP: the interval exists only if run N's counters reach run N+1 -------------
  # The pure functions cannot prove the carry happens. Drive two real runs against a sandboxed
  # state/log (a --test must NEVER write the artifact a watchdog reads for liveness) and assert the
  # coverage WIDENS: run 1 has no baseline (window=inst, idle_pct_iv=null), run 2 must read run 1's
  # counters (window=inst+iv, numeric). A gate that only checked run 1 passes with the carry deleted.
  _sd=$(mktemp -d)
  _c1=$(MESH_CSTATE_STATE="$_sd/s" MESH_CSTATE_LOG="$_sd/l" MESH_CSTATE_PREDICT_LOG="$_sd/p" MESH_CSTATE_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  _c2=$(MESH_CSTATE_STATE="$_sd/s" MESH_CSTATE_LOG="$_sd/l" MESH_CSTATE_PREDICT_LOG="$_sd/p" MESH_CSTATE_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  _w1=$(printf '%s' "$_c1" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _w2=$(printf '%s' "$_c2" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _iv2=$(printf '%s' "$_c2" | sed -n 's/.*"idle_pct_iv":\([a-z0-9.]*\).*/\1/p')
  _raw2=$(sed -n 's/.* raw=\([0-9 ]*\)$/\1/p' "$_sd/s" 2>/dev/null | tail -1)
  rm -rf "$_sd"
  [ "$_w1" = inst ] || { echo "smoke-test: FAIL (run 1 has no baseline but reported window=$_w1 — an interval was invented from nothing)"; exit 1; }
  [ "$_w2" = "inst+iv" ] || { echo "smoke-test: FAIL (run 2 reported window=$_w2 — the accumulator is NOT carried across runs, coverage is still ${SECS}s/300s)"; exit 1; }
  case "$_iv2" in ''|null) echo "smoke-test: FAIL (run 2 idle_pct_iv=$_iv2 — the interval window produced no reading)"; exit 1;; esac
  [ -n "$_raw2" ] || { echo "smoke-test: FAIL (state carries no raw= counters — the next run cannot compute an interval)"; exit 1; }

  # ---- CONSUMING the interval is not COMPUTING it ----------------------------------------------
  # Seed a baseline 100s old holding the CURRENT counters: the interval then sees ~no idle time
  # accumulated over 100s of wall — idle≈0%, unambiguously BUSY and unambiguously the busier window.
  # Assert the fold NAMES it and the published LEVEL rides on it. Without this the tool can compute a
  # perfect interval, print it, and still classify off the 2s sample.
  _fd=$(mktemp -d)
  _snap=$(snapshot) || { echo "smoke-test: FAIL (snapshot failed while seeding the fold gate)"; exit 1; }
  set -- $_snap
  printf 'SEED raw=%s %s %s %s\n' "$(( $(date +%s) - 100 ))" "$1" "$2" "$3" > "$_fd/s"
  _cf=$(MESH_CSTATE_STATE="$_fd/s" MESH_CSTATE_LOG="$_fd/l" MESH_CSTATE_PREDICT_LOG="$_fd/p" MESH_CSTATE_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  rm -rf "$_fd"
  _fwon=$(printf '%s' "$_cf" | sed -n 's/.*"won":"\([a-z]*\)".*/\1/p')
  _flvl=$(printf '%s' "$_cf" | sed -n 's/.*"level":"\([A-Z-]*\)".*/\1/p')
  _fidle=$(printf '%s' "$_cf" | sed -n 's/.*"idle_pct":\([0-9.]*\).*/\1/p')
  [ "$_fwon" = iv ] || { echo "smoke-test: FAIL (seeded a ~0%-idle interval but the fold named won=$_fwon — the interval window loses to the ${SECS}s sample)"; exit 1; }
  awk -v v="${_fidle:-100}" 'BEGIN{exit !(v+0 < 40)}' || { echo "smoke-test: FAIL (interval won but idle_pct=$_fidle — the published axis is not the fold's value)"; exit 1; }
  [ "$_flvl" = BUSY ] || { echo "smoke-test: FAIL (fused idle=$_fidle% but level=$_flvl — the verdict does not ride on the fused axis)"; exit 1; }

  # ---- CARRY + READ-ONLY: --predict lives off the baseline the */5 run writes -------------------
  # The pure functions cannot prove the counters reach the next run. Drive real runs against a
  # sandboxed state/log and assert the window WIDENS — and that --predict itself wrote NOTHING (a
  # dry-run or read-only verb that writes the durable telemetry forges the evidence it exists on).
  if pred_snapshot >/dev/null 2>&1; then
    _qd=$(mktemp -d)
    _pe1() { MESH_CSTATE_STATE="$_qd/s" MESH_CSTATE_LOG="$_qd/l" MESH_CSTATE_PREDICT_LOG="$_qd/p" MESH_CSTATE_SAMPLE_SECS=1 "$0" "$@" 2>/dev/null; }
    _q1=$(_pe1 --predict --json)
    _qw1=$(printf '%s' "$_q1" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
    [ "$_qw1" = inst ] || { echo "  FAIL: --predict with no baseline reported window=$_qw1 — an interval was invented from nothing"; fail=1; }
    _pe1 --json >/dev/null            # a normal run: writes the baseline, incl. the misprediction block
    [ -s "$_qd/p" ] && { echo "  FAIL: the first run (no baseline → interval na) wrote a predict-telemetry row anyway"; fail=1; }
    _q2=$(_pe1 --predict --json)
    _qw2=$(printf '%s' "$_q2" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
    [ "$_qw2" = "inst+iv" ] || { echo "  FAIL: --predict after a real run reported window=$_qw2 — the MAIN run does not carry usage/above/below into raw=, so this axis has ${SECS}s coverage, not 100%"; fail=1; }
    [ -s "$_qd/p" ] && { echo "  FAIL: --predict wrote the durable telemetry log — it is READ-ONLY; the */5 run owns that write"; fail=1; }
    _pe1 --json >/dev/null            # second real run: now the interval exists → one telemetry row
    [ -s "$_qd/p" ] || { echo "  FAIL: a run WITH a usable baseline wrote no predict-telemetry row — nothing will ever accumulate to retune a band from"; fail=1; }
    grep -q 'cov=[0-9]*/[0-9]*' "$_qd/p" 2>/dev/null || { echo "  FAIL: the telemetry row carries no cov= — rejected's 0 would be unreadable"; fail=1; }
    rm -rf "$_qd"
  fi

  [ "$fail" = 0 ] && { echo "smoke-test: ok (fixture math + 12 coverage asserts + real cpuidle read + across-run carry inst→inst+iv + seeded interval drives the verdict + misprediction axis: per-state mapping, structural zeros live+lifetime, coverage, honest n/a, read-only --predict)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

# ---- --status : READ-ONLY, no new sample, no mutation ----
if [ "$MODE" = "--status" ]; then
  if [ -s "$STATE" ]; then
    printf '[cstate] %s (as of %s)\n' "$(cat "$STATE")" "$(date -u -r "$STATE" +%FT%TZ 2>/dev/null || echo '?')"
    exit 0
  fi
  echo "[cstate] no state yet — run mesh-cstate for a sample"; exit 2
fi

# ---- --predict : the MISPREDICTION axis. READ-ONLY (reads the baseline the */5 run writes, writes
# nothing itself), and its absence NEVER takes the residency verb down — exit 2 here leaves every
# other verb exactly as it was before this axis existed.
if [ "$MODE" = "--predict" ]; then
  PJSON=0; [ "${2:-}" = "--json" ] && PJSON=1
  P1=$(pred_snapshot) || {
    echo "mesh-cstate --predict: cpuidle above/below not exposed by this driver — n/a (residency verbs unaffected)" >&2
    exit 2; }
  pt1=$(date +%s%N)
  # The baseline the LAST run (cron, a human, a consumer) left behind — read before anyone rewrites it.
  prev_raw="$(sed -n 's/.* raw=\([0-9 ]*\)$/\1/p' "$STATE" 2>/dev/null | tail -1)"
  sleep "$SECS"
  P2=$(pred_snapshot) || { echo "mesh-cstate --predict: second cpuidle read failed — n/a" >&2; exit 2; }
  pt2=$(date +%s%N)
  NAMES="$(state_names)"
  read -r c_ns c_nexp c_nread c_nrej c_q <<< "$P2"
  read -r p_ns p_nexp p_nread p_nrej p_q <<< "$P1"

  # inst window: the two live snapshots above.
  inst_d=$(pred_delta "$c_ns" "$p_q" "$c_q") || inst_d=""
  [ -n "$inst_d" ] || { echo "mesh-cstate --predict: live delta went backwards mid-sample — n/a" >&2; exit 2; }
  inst_r=$(printf '%s\n' "$inst_d" | pred_rates "$c_ns" "$NAMES")

  # interval window: the SAME baseline and the SAME guard as the residency axis (baseline_ok), plus
  # the shape checks that are specific to this block — a baseline taken with different COVERAGE
  # (fewer readable files, or a different state count) sums over a different set of cells, so its
  # delta would be a coverage artifact wearing a rate's name.
  iv_r=""; iv_dt=na; now_s=$(( pt2 / 1000000000 ))
  NCPU=""; _sn=$(snapshot) && read -r _sa _sd NCPU <<< "$_sn"
  if [ -n "$NCPU" ] && iv_dt=$(baseline_ok "$prev_raw" "$now_s" "$NCPU" "$MAX_IV_AGE"); then
    read -r b_e b_a b_d b_n b_ns b_nexp b_nread b_nrej b_q <<< "$prev_raw"
    if [ -n "${b_q:-}" ] && [ "${b_ns:-}" = "$c_ns" ] && [ "${b_nread:-}" = "$c_nread" ] && [ "${b_nrej:-}" = "$c_nrej" ]; then
      iv_d=$(pred_delta "$c_ns" "$b_q" "$c_q") && iv_r=$(printf '%s\n' "$iv_d" | pred_rates "$c_ns" "$NAMES")
    fi
  fi
  [ -n "$iv_r" ] || iv_dt=na
  if [ -n "$iv_r" ]; then pwindow="inst+iv"; else pwindow="inst"; fi
  pts=$(date -u +%FT%TZ)
  p_ms=$(( (pt2 - pt1) / 1000000 ))

  if [ "$PJSON" = 1 ]; then
    printf '{"window":"%s","nstates":%s,"cov":"%s/%s","rej_cov":"%s/%s","sample_ms":%s,"iv_secs":%s,"inst":%s,"iv":%s' \
      "$pwindow" "$c_ns" "$c_nread" "$c_nexp" "$c_nrej" "$c_nexp" "$p_ms" \
      "$([ "$iv_dt" = na ] && echo null || echo "$iv_dt")" \
      "$(printf '%s\n' "$inst_r" | grep -v '^worst ' | pred_arr_json)" \
      "$([ -n "$iv_r" ] && printf '%s\n' "$iv_r" | grep -v '^worst ' | pred_arr_json || echo null)"
    read -r _w wan wap wbn wbp wrej _wu <<< "$(printf '%s\n' "${iv_r:-$inst_r}" | grep '^worst ')"
    printf ',"worst_window":"%s","worst_above":{"state":"%s","pct":%s},"worst_below":{"state":"%s","pct":%s},"rejected":%s,"ts":"%s"}\n' \
      "$([ -n "$iv_r" ] && echo iv || echo inst)" \
      "$wan" "$([ "$wap" = na ] && echo null || echo "$wap")" \
      "$wbn" "$([ "$wbp" = na ] && echo null || echo "$wbp")" "$wrej" "$pts"
    exit 0
  fi

  printf '[cstate-predict] window=%s states=%s cov=%s/%s rej_cov=%s/%s (sample %sms, iv %ss)\n' \
    "$pwindow" "$c_ns" "$c_nread" "$c_nexp" "$c_nrej" "$c_nexp" "$p_ms" "$iv_dt"
  # ONE quantity, ONE rendering: a rate carries its %, and a STRUCTURAL cell is a bare `na` — never
  # `na%` (which reads as "na percent") and never 0 (which would read as a measured absence of
  # misprediction rather than a cell that cannot hold one).
  _prow() { printf '%s\n' "$2" | grep -v '^worst ' | while read -r _s nm du ab bl dr; do
      [ "$ab" = na ] || ab="$ab%"; [ "$bl" = na ] || bl="$bl%"
      printf '  %-4s %-6s usage=+%-9s above=%-7s below=%-7s rejected=%s\n' "$1" "$nm" "$du" "$ab" "$bl" "$dr"
    done; }
  _prow inst "$inst_r"
  [ -n "$iv_r" ] && _prow iv "$iv_r"
  read -r _w wan wap wbn wbp wrej _wu <<< "$(printf '%s\n' "${iv_r:-$inst_r}" | grep '^worst ')"
  # na on a structural cell is NOT a rate of 0 — the worst-of names the state it came from so the
  # per-state reading can never be re-read as one blended number.
  [ "$wap" = na ] || wap="$wap%"; [ "$wbp" = na ] || wbp="$wbp%"
  printf '  worst(%s) above=%s %s | below=%s %s | rejected=%s (all-zero is the HEALTHY reading — read cov= beside it)\n' \
    "$([ -n "$iv_r" ] && echo iv || echo inst)" "$wan" "$wap" "$wbn" "$wbp" "$wrej"
  exit 0
fi

# ============================== live sample ==============================
s1=$(snapshot) || { echo "mesh-cstate: no readable cpuidle state*/time (cpuidle hidden — VM/container) — UNREACHABLE" >&2; exit 2; }
t1=$(date +%s%N)
# The PREVIOUS run's raw counters, read before the state file is overwritten. Absent (first run, or
# a state line predating this field) => the interval window renders na, never a fabricated reading.
prev_raw="$(sed -n 's/.* raw=\([0-9 ]*\)$/\1/p' "$STATE" 2>/dev/null | tail -1)"
sleep "$SECS"
s2=$(snapshot) || { echo "mesh-cstate: second cpuidle snapshot failed — UNREACHABLE" >&2; exit 2; }
t2=$(date +%s%N)
set -- $s1; A1=$1 D1=$2 N=$3
set -- $s2; A2=$1 D2=$2
# The MISPREDICTION counters ride along in the SAME baseline. If the driver hides them, PRED2 is
# empty and everything below degrades to exactly the pre-2026-08-18 behaviour — the residency verb
# does not notice, and raw= keeps its original 4 fields.
PRED2="$(pred_snapshot)" || PRED2=""
c_ns=''; c_nexp=''; c_nread=''; c_nrej=''; c_q=''
b_ns=''; b_nread=''; b_nrej=''; b_q=''
[ -n "$PRED2" ] && read -r c_ns c_nexp c_nread c_nrej c_q <<< "$PRED2"
dt_us=$(( (t2 - t1) / 1000 ))
res=$(compute "$A1" "$A2" "$D1" "$D2" "$N" "$dt_us") \
  || { echo "mesh-cstate: bad sample (dt=${dt_us}us n=$N) — UNREACHABLE" >&2; exit 2; }
set -- $res; I_IDLE=$1 I_DEEP=$2 I_DR=$3
level_inst=$(classify "$I_IDLE" "$I_DR")

# --- INTERVAL window: the same counters delta'd against the PREVIOUS run (100% coverage) ---
now_s=$(( t2 / 1000000000 ))
read -r V_IDLE V_DEEP V_DR <<< "$(interval_res "$prev_raw" "$now_s" "$A2" "$D2" "$N" "$MAX_IV_AGE")"
if [ "$V_IDLE" = na ]; then level_iv=na; else level_iv=$(classify "$V_IDLE" "$V_DR"); fi

# --- Fold: the busier window wins and is NAMED; deep%/ratio come from the SAME window ---
read -r IDLE won <<< "$(fold_idle "$I_IDLE" "$V_IDLE")"
if [ "$won" = iv ]; then DEEP="$V_DEEP"; DR="$V_DR"; else DEEP="$I_DEEP"; DR="$I_DR"; fi
if [ "$V_IDLE" = na ]; then window="inst"; else window="inst+iv"; fi

level=$(classify "$IDLE" "$DR")
ts=$(date -u +%FT%TZ)
# ONE quantity, ONE rendering: a percentage carries its % and an absent reading is a bare `na`.
# `iv=na%` would read as "na percent" and `idle_iv=75.1` as a different unit from idle_inst=75.1%.
V_IDLE_R="$V_IDLE"; [ "$V_IDLE" = na ] || V_IDLE_R="${V_IDLE}%"

mkdir -p "$(dirname "$STATE")" 2>/dev/null
# Leading token stays the LEVEL and idle=/deep=/ratio= keep their names (existing consumers read
# those); the coverage fields and the trailing raw= carry — which is what makes the interval window
# possible at all — are appended. Unconditional write: mtime = liveness.
# raw= gains the misprediction block AFTER its original 4 fields: still digits-and-spaces to EOL, so
# the existing `sed -n 's/.* raw=\([0-9 ]*\)$/\1/p'` reader is untouched and an old state line
# (4 fields) simply renders the new axis na on the next run.
printf '%s idle=%s%% deep=%s%% ratio=%s window=%s idle_inst=%s%% idle_iv=%s won=%s level_inst=%s level_iv=%s raw=%s %s %s %s%s\n' \
  "$level" "$IDLE" "$DEEP" "$DR" "$window" "$I_IDLE" "$V_IDLE_R" "$won" "$level_inst" "$level_iv" \
  "$now_s" "$A2" "$D2" "$N" \
  "$([ -n "$PRED2" ] && printf ' %s %s %s %s %s' "$c_ns" "$c_nexp" "$c_nread" "$c_nrej" "$c_q")" >"$STATE"
printf '%s %s %s %s %s %s %s %s %s\n' "$ts" "$level" "$IDLE" "$DEEP" "$DR" "$N" "$window" "$won" "$level_inst" >>"$LOG"

# --- MISPREDICTION telemetry: the ACROSS-RUN rates, which cover 100% of the interval at no extra
# cadence. Logged (never classified) so a band can one day be retuned from real numbers instead of
# guessed now. No row at all when the interval is na — a missing row is honest, a row of zeros is not.
if [ -n "$PRED2" ] && [ "$V_IDLE" != na ]; then
  read -r _be _ba _bd _bn b_ns b_nexp b_nread b_nrej b_q <<< "$prev_raw"
  if [ -n "${b_q:-}" ] && [ "${b_ns:-}" = "$c_ns" ] && [ "${b_nread:-}" = "$c_nread" ] && [ "${b_nrej:-}" = "$c_nrej" ]; then
    if p_d=$(pred_delta "$c_ns" "$b_q" "$c_q"); then
      p_r=$(printf '%s\n' "$p_d" | pred_rates "$c_ns" "$(state_names)")
      p_cols=""
      while read -r _s nm du ab bl dr; do p_cols="$p_cols $nm=$du,$ab,$bl,$dr"; done <<< "$(printf '%s\n' "$p_r" | grep -v '^worst ')"
      read -r _w wan wap wbn wbp wrej _wu <<< "$(printf '%s\n' "$p_r" | grep '^worst ')"
      mkdir -p "$(dirname "$PLOG")" 2>/dev/null
      printf '%s iv cov=%s/%s rej_cov=%s/%s rej=%s worst_above=%s,%s worst_below=%s,%s%s\n' \
        "$ts" "$c_nread" "$c_nexp" "$c_nrej" "$c_nexp" "$wrej" "$wan" "$wap" "$wbn" "$wbp" "$p_cols" >>"$PLOG"
      if [ "$(wc -l <"$PLOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
        tail -n 5000 "$PLOG" >"$PLOG.tmp" && mv "$PLOG.tmp" "$PLOG"
      fi
    fi
  fi
fi
if [ "$(wc -l <"$LOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

if [ "$MODE" = "--json" ]; then
  # level/idle_pct/deep_ratio are the FUSED reading; the *_inst fields are the in-run sample alone.
  # A consumer pairing cstate with another instantaneous read (mesh-wakeup-attrib's irq correlation)
  # must use the _inst fields — correlating a 5-minute mean with a 2-second irq sample is a claim
  # about two different windows wearing one sentence.
  printf '{"level":"%s","idle_pct":%s,"deep_pct":%s,"deep_ratio":%s,"ncpu":%s,"elapsed_ms":%s,"window":"%s","won":"%s","level_inst":"%s","idle_pct_inst":%s,"deep_pct_inst":%s,"deep_ratio_inst":%s,"level_iv":"%s","idle_pct_iv":%s,"ts":"%s"}\n' \
    "$level" "$IDLE" "$DEEP" "$DR" "$N" "$(( dt_us / 1000 ))" "$window" "$won" \
    "$level_inst" "$I_IDLE" "$I_DEEP" "$I_DR" "$level_iv" \
    "$([ "$V_IDLE" = na ] && echo null || echo "$V_IDLE")" "$ts"
else
  printf '[cstate] %s — idle=%s%% (deep=%s%%, deep-of-idle=%s) across %s cpus | window=%s inst=%s%%(%s) iv=%s(%s) won=%s (sample %ss) | thresholds idle>=%s busy<%s deep>=%s\n' \
    "$level" "$IDLE" "$DEEP" "$DR" "$N" "$window" "$I_IDLE" "$level_inst" "$V_IDLE_R" "$level_iv" "$won" \
    "$(awk -v u="$dt_us" 'BEGIN{printf "%.1f", u/1000000}')" "$IDLE_HI" "$BUSY_LO" "$DEEP_RATIO"
fi
