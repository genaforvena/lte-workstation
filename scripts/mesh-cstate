#!/usr/bin/env bash
# mesh-cstate — the CPU's DEEP-SLEEP residency sense: how deeply the silicon is actually resting.
# The CPU sibling of mesh-gpu-activity (which reads i915 RC6 = the GPU's deep-sleep). Reads the
# per-CPU hardware idle counters at /sys/devices/system/cpu/cpu*/cpuidle/state*/time (µs cumulative,
# world-readable 0444, NO sudo) — two snapshots over a ~2s wall window give the fraction of core-time
# spent idle, and of that, the fraction spent in DEEP C-states (C2/C3+) vs shallow (POLL/C1).
#
# WHY THIS IS A NEW SIGNAL (verified uncovered 2026-07-06 — no tool reads cpuidle; the grep hits were
# MAC-address fragments + GPU RC6, not CPU C-states):
#   - Load average / CPU-util count RUNNABLE tasks — they say the machine is "idle" at load 0. They are
#     BLIND to WHY it's idle: a core at load 0 can be in deep C3 (truly at rest, cool, ~0W) OR bouncing
#     in and out of shallow C1 on a wakeup storm (a chatty timer/IRQ/poller) — idle by the scheduler yet
#     never actually RESTING, burning power and heat. This sense sees that difference; load average can't.
#   - mesh-package-power (RAPL) reads the WATTS but not the sleep DEPTH; mesh-cpufreq reads clock when
#     AWAKE but says nothing about sleep; mesh-cooling-load reads the cooler's response. None reads how
#     deeply the cores sleep. This is the missing "quiescence" axis.
#
# CLASSIFICATION (the value-add is distinguishing the two flavours of "idle"):
#   BUSY          idle% < BUSY_LO — cores active, doing real work.
#   DEEP-REST     idle% >= IDLE_HI AND deep-of-idle ratio >= DEEP_RATIO — truly quiescent (cool, low power).
#   SHALLOW-REST  idle% >= IDLE_HI BUT deep ratio < DEEP_RATIO — "restless idle": idle by load but kept
#                 out of deep sleep by frequent wakeups. Invisible to every other sense. (retune from LOG)
#   LIGHT         in between.
#
# COVERAGE — the ~2s window on a */5 cadence saw 0.70% of wallclock (window-cadence-aliasing sweep,
# docs/window-cadence-coverage-2026-08-15.md). cpuidle state*/time is a MONOTONIC ACCUMULATOR and the
# tool differenced it 2s apart and threw the counters away: 99.3% of every interval went unobserved,
# so a four-minute wakeup storm that starts and ends between two cron ticks left this sense reporting
# DEEP-REST — honestly, and about 2 seconds of a 300-second claim. Carrying the counters in the state
# file and delta'ing ACROSS runs covers 100% of the interval at zero extra cost.
# BOTH windows are kept (the interval mean dilutes a sharp storm; the 2s one misses everything
# between ticks) and folded on the ACTIVITY direction — the BUSIER window (lower idle%) wins, named
# in won=inst|iv, with the deep%/ratio taken from the SAME window so the pair stays coherent. The
# per-window LEVELS are published too (level_inst/level_iv), because idle% alone cannot express the
# SHALLOW-vs-DEEP disjunction this sense exists for: a fold that only kept the busier window could
# hide a SHALLOW-REST seen by the other. Missing evidence renders na, never 0 — a reboot-reset
# counter differenced into "0% idle" would read as a fabricated BUSY, and a CPU hotplug changing
# ncpu changes the denominator, so that too is na.
#
# Every invocation rewrites the baseline, so the interval is "since the last run by ANYONE" (cron,
# a human, mesh-wakeup-attrib's fusion read) — never an assumed 300s. dt comes from the stored epoch,
# so a shorter or longer gap is measured, not guessed; only a gap past MAX_IV_AGE renders na.
#
# HONEST n/a: no readable cpuidle state*/time on this node (a VM/container with cpuidle hidden) → exit 2
#   (UNREACHABLE), never a fabricated residency. reflex-health/mesh-land treat exit 2 as an honest pass.
#
# State artifact ~/.mesh/.cstate-state is written EVERY run (UNCONDITIONAL → mtime = liveness, so no
# false-STALE; not change-gated, so no mesh-state-touch needed — same convention as mesh-gpu-activity).
# Per-run telemetry accumulates in ~/.mesh/cstate.log (thresholds below are PROVISIONAL — retune from it).
#
#   mesh-cstate           one ~2s sample: idle%/deep% + BUSY/LIGHT/SHALLOW-REST/DEEP-REST, writes state+log
#   mesh-cstate --json    same sample, JSON
#   mesh-cstate --status  last state-file reading, no new sample (READ-ONLY, no mutation)
#   mesh-cstate --test    fixture math (delta/clamp/classify) + REAL-READ GATE (live sample 0-100 or exit 2)
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MODE="${1:-}"   # captured BEFORE any `set -- ...` below clobbers $1 (was: --json silently never fired)

CPUDIR="${MESH_CSTATE_CPUDIR:-/sys/devices/system/cpu}"
DEEP_IDX="${MESH_CSTATE_DEEP_IDX:-2}"          # cpuidle state index >= this = a DEEP C-state (state0=POLL,1=C1 shallow)
SECS="${MESH_CSTATE_SAMPLE_SECS:-2}"
IDLE_HI="${MESH_CSTATE_IDLE_HI:-80}"           # idle% at/above this = "resting" (provisional)
BUSY_LO="${MESH_CSTATE_BUSY_LO:-40}"           # idle% below this = BUSY (provisional)
DEEP_RATIO="${MESH_CSTATE_DEEP_RATIO:-0.50}"   # deep/total-idle at/above this = DEEP vs SHALLOW rest (provisional)
STATE="${MESH_CSTATE_STATE:-$HOME/.mesh/.cstate-state}"
LOG="${MESH_CSTATE_LOG:-$HOME/.mesh/cstate.log}"
# How stale a carried baseline may be before the interval renders na: past it the reflex was DOWN
# and the "average" would span a gap nobody observed. 4x the */5 cadence.
MAX_IV_AGE="${MESH_CSTATE_MAX_IV_AGE:-1200}"

# snapshot: sum idle µs across ALL cpus → "all_us deep_us ncpu". Deep = state index >= DEEP_IDX.
# Returns 1 (fail) if no readable cpuidle counters exist (honest n/a, never a fabricated 0).
snapshot() {
  local all=0 deep=0 ncpu=0 cpu st idx t
  for cpu in "$CPUDIR"/cpu[0-9]*/cpuidle; do
    [ -d "$cpu" ] || continue
    ncpu=$((ncpu + 1))
    for st in "$cpu"/state[0-9]*; do
      [ -r "$st/time" ] || continue
      idx="${st##*/state}"
      case "$idx" in (''|*[!0-9]*) continue;; esac
      t=$(cat "$st/time" 2>/dev/null)
      case "$t" in (''|*[!0-9]*) continue;; esac
      all=$((all + t))
      [ "$idx" -ge "$DEEP_IDX" ] && deep=$((deep + t))
    done
  done
  [ "$ncpu" -gt 0 ] || return 1
  printf '%s %s %s' "$all" "$deep" "$ncpu"
}

# compute: all1 all2 deep1 deep2 ncpu dt_us → "idle_pct deep_pct deep_ratio" (clamped 0-100; monotonic
# counters so a negative delta = error). avail = ncpu × dt_us (each core has dt_us of wall to spend).
compute() {
  awk -v a1="$1" -v a2="$2" -v d1="$3" -v d2="$4" -v n="$5" -v dt="$6" 'BEGIN{
    da=a2-a1; dd=d2-d1; avail=n*dt;
    if (dt<=0 || n<=0 || da<0 || dd<0 || avail<=0) exit 1;
    idle=da/avail*100; deep=dd/avail*100;
    if (idle>100) idle=100; if (deep>100) deep=100; if (idle<0) idle=0; if (deep<0) deep=0;
    dr=(da>0)?dd/da:0;
    printf "%.1f %.1f %.2f", idle, deep, dr;
  }'
}

# interval_res <prev_raw> <now_epoch_s> <all_us> <deep_us> <ncpu> <max_age_s>
#   -> "idle_pct deep_pct deep_ratio" from the ACROSS-RUN accumulator delta, or "na na na".
# MISSING EVIDENCE RENDERS na, NEVER 0: no baseline (first run / pre-upgrade state line), a counter
# that went BACKWARDS (reboot — cpuidle time resets to 0), a baseline older than max_age (never
# average across a gap the reflex did not watch), a garbage field, dt<=0, or an ncpu that CHANGED
# (hotplug moves the denominator: avail = ncpu × dt, so the same delta means something else).
# 0% idle is the BUSY end of this axis, so a fabricated 0 here is a fabricated ALARM, not a
# fabricated calm — wrong in the other direction, equally wrong.
interval_res() {
  local prev="$1" ne="$2" all="$3" deep="$4" n="$5" maxage="$6"
  local pe pall pdeep pn dt _f
  read -r pe pall pdeep pn <<< "$prev"
  for _f in "$pe" "$pall" "$pdeep" "$pn"; do
    case "$_f" in ''|*[!0-9]*) printf 'na na na\n'; return;; esac
  done
  dt=$(( ne - pe ))
  [ "$dt" -gt 0 ] || { printf 'na na na\n'; return; }
  [ "$dt" -le "$maxage" ] || { printf 'na na na\n'; return; }
  [ "$pn" = "$n" ] || { printf 'na na na\n'; return; }
  if [ "$all" -lt "$pall" ] || [ "$deep" -lt "$pdeep" ]; then printf 'na na na\n'; return; fi
  compute "$pall" "$all" "$pdeep" "$deep" "$n" "$(( dt * 1000000 ))" 2>/dev/null || printf 'na na na\n'
}

# fold_idle <inst_idle> <iv_idle|na> -> "<fused> <winner>"  (winner: inst|iv)
# The fold runs on the ACTIVITY direction: the BUSIER window (LOWER idle%) wins, because that is the
# one that saw work the other missed. na loses by default; a tie names inst. A max that hides its
# disjunction turns "the CPU rested for the last five minutes" and "the two seconds I watched were
# restful" into the same sentence — they are different claims, so the winner is always named.
fold_idle() {
  local inst="$1" iv="${2:-na}"
  case "$iv" in ''|na) printf '%s inst\n' "$inst"; return;; esac
  awk -v a="$inst" -v b="$iv" 'BEGIN{ if (b+0 < a+0) printf "%s iv\n", b; else printf "%s inst\n", a }'
}

# classify: idle_pct deep_ratio → BUSY | DEEP-REST | SHALLOW-REST | LIGHT
classify() {
  awk -v i="$1" -v dr="$2" -v ihi="$IDLE_HI" -v blo="$BUSY_LO" -v drhi="$DEEP_RATIO" 'BEGIN{
    if (i < blo) print "BUSY";
    else if (i >= ihi && dr >= drhi) print "DEEP-REST";
    else if (i >= ihi) print "SHALLOW-REST";
    else print "LIGHT";
  }'
}

# ============================== --test (sandboxed: no state/log write) ==============================
if [ "$MODE" = "--test" ]; then
  fail=0
  # (a) plain delta: over a 2s window (2000000µs) on 4 cpus (avail=8000000), cores idle 6000000µs of which
  #     4000000µs deep → idle 75.0%, deep 50.0%, ratio 0.67
  read -r ip dp dr <<<"$(compute 0 6000000 0 4000000 4 2000000)"
  [ "$ip" = 75.0 ] && [ "$dp" = 50.0 ] && [ "$dr" = 0.67 ] || { echo "  FAIL: delta → idle=$ip deep=$dp dr=$dr (want 75.0 50.0 0.67)"; fail=1; }
  # (b) fully idle + all deep → 100/100/1.00
  read -r ip dp dr <<<"$(compute 0 8000000 0 8000000 4 2000000)"
  [ "$ip" = 100.0 ] && [ "$dp" = 100.0 ] && [ "$dr" = 1.00 ] || { echo "  FAIL: full-deep → $ip $dp $dr (want 100.0 100.0 1.00)"; fail=1; }
  # (c) slight timing overshoot must CLAMP to 100, never exceed
  read -r ip dp dr <<<"$(compute 0 8100000 0 0 4 2000000)"
  [ "$ip" = 100.0 ] || { echo "  FAIL: idle overshoot must clamp to 100.0, got $ip"; fail=1; }
  # (d) fully busy: no idle delta → 0/0/0
  read -r ip dp dr <<<"$(compute 5000 5000 5000 5000 4 2000000)"
  [ "$ip" = 0.0 ] || { echo "  FAIL: fully-busy idle → $ip (want 0.0)"; fail=1; }
  # (e) error guards: zero interval + negative delta must fail
  compute 0 100 0 0 4 0 >/dev/null 2>&1 && { echo "  FAIL: zero interval must error"; fail=1; }
  compute 100 0 0 0 4 2000000 >/dev/null 2>&1 && { echo "  FAIL: negative idle delta must error"; fail=1; }
  # (f) classify: the four regimes + the SHALLOW-vs-DEEP distinction (the whole point)
  [ "$(classify 20.0 0.9)" = BUSY ]         || { echo "  FAIL: classify(20,.9) != BUSY"; fail=1; }
  [ "$(classify 90.0 0.8)" = DEEP-REST ]    || { echo "  FAIL: classify(90,.8) != DEEP-REST"; fail=1; }
  [ "$(classify 90.0 0.2)" = SHALLOW-REST ] || { echo "  FAIL: classify(90,.2) != SHALLOW-REST (restless idle)"; fail=1; }
  [ "$(classify 60.0 0.9)" = LIGHT ]        || { echo "  FAIL: classify(60,.9) != LIGHT"; fail=1; }
  [ "$(classify 80.0 0.50)" = DEEP-REST ]   || { echo "  FAIL: boundary classify(80,.50) != DEEP-REST"; fail=1; }
  [ "$(classify 40.0 0.9)" = LIGHT ]        || { echo "  FAIL: boundary classify(40,.9) != LIGHT (not BUSY)"; fail=1; }
  # (g) snapshot honest-fail on an empty fixture dir (no cpuidle → return 1, never a fake 0)
  _td=$(mktemp -d); trap 'rm -rf "$_td"' EXIT
  if CPUDIR="$_td" snapshot >/dev/null 2>&1; then echo "  FAIL: snapshot on empty dir must fail (no fabricated 0)"; fail=1; fi
  # (h) snapshot fixture: 2 cpus, states 0..3, deep=state>=2
  for c in 0 1; do for s in 0 1 2 3; do mkdir -p "$_td/cpu$c/cpuidle/state$s"; printf '%s\n' "$(( (s+1)*1000 ))" >"$_td/cpu$c/cpuidle/state$s/time"; done; done
  read -r sa sd sn <<<"$(CPUDIR="$_td" snapshot)"
  # per cpu: all=1000+2000+3000+4000=10000, deep(s2+s3)=3000+4000=7000; ×2 cpus
  [ "$sa" = 20000 ] && [ "$sd" = 14000 ] && [ "$sn" = 2 ] || { echo "  FAIL: snapshot fixture → all=$sa deep=$sd n=$sn (want 20000 14000 2)"; fail=1; }
  # ---- COVERAGE gates: the across-run interval window and the fold that names its winner --------
  # fold_idle folds on the ACTIVITY direction — the BUSIER (lower-idle) window wins, and is NAMED.
  [ "$(fold_idle 90.0 30.0)" = "30.0 iv" ]   || { echo "  FAIL: fold_idle 90 30 → $(fold_idle 90.0 30.0) (want '30.0 iv' — the busier window wins)"; fail=1; }
  [ "$(fold_idle 20.0 95.0)" = "20.0 inst" ] || { echo "  FAIL: fold_idle 20 95 → $(fold_idle 20.0 95.0) (want '20.0 inst')"; fail=1; }
  [ "$(fold_idle 50.0 50.0)" = "50.0 inst" ] || { echo "  FAIL: fold_idle tie → $(fold_idle 50.0 50.0) (want '50.0 inst')"; fail=1; }
  [ "$(fold_idle 77.0 na)"   = "77.0 inst" ] || { echo "  FAIL: fold_idle na → $(fold_idle 77.0 na) (want '77.0 inst' — na never wins)"; fail=1; }
  # interval_res: a real across-run delta. prev at t=0 on 2 cpus; now at t=100s with 150000000µs
  # idle of which 100000000µs deep → avail=200000000µs → idle 75.0%, deep 50.0%, ratio 0.67.
  r="$(interval_res "0 0 0 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "75.0 50.0 0.67" ] || { echo "  FAIL: interval_res → '$r' (want '75.0 50.0 0.67')"; fail=1; }
  # MISSING EVIDENCE RENDERS na, NEVER 0 — and 0 is the BUSY end here, so a fabricated 0 is a
  # fabricated ALARM. Each of these must refuse to produce a reading.
  r="$(interval_res "" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: no baseline (first run) → '$r' (want na)"; fail=1; }
  # This one asserts the CONTRACT (na on a backwards counter), not a particular line: compute()'s own
  # negative-delta check catches the same fixture, so deleting interval_res's explicit reset guard
  # ALONE leaves this green — measured. It goes red when both are gone (the reading then clamps to
  # idle=0.0%, a fabricated BUSY). Recorded rather than hidden: a gate that overlaps another guard
  # pins behaviour, not that guard.
  r="$(interval_res "0 999999999 0 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: counter went BACKWARDS (reboot resets cpuidle) → '$r' (want na)"; fail=1; }
  r="$(interval_res "0 0 0 2" 99999 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: stale baseline past max-age → '$r' (want na — never average across an unobserved gap)"; fail=1; }
  r="$(interval_res "0 0 garbage 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: garbage state field → '$r' (want na)"; fail=1; }
  r="$(interval_res "100 0 0 2" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: dt=0 → '$r' (want na)"; fail=1; }
  # ncpu CHANGED (hotplug) moves the denominator avail=ncpu×dt — the same delta then means something
  # else, so the baseline is not comparable. Without this guard the reading is silently rescaled.
  r="$(interval_res "0 0 0 4" 100 150000000 100000000 2 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL: ncpu changed 4→2 (hotplug) → '$r' (want na — the denominator moved)"; fail=1; }
  # ---- REAL-READ GATE: a live sample must yield finite 0-100 idle% or honestly exit 2 (no fake green) ----
  if ! s1=$(snapshot); then
    echo "smoke-test: n/a — no readable cpuidle state*/time on this node (cpuidle hidden — VM/container)"
    exit 2
  fi
  t1=$(date +%s%N); sleep 1; s2=$(snapshot) || { echo "  FAIL: second live snapshot failed after first succeeded"; fail=1; s2=$s1; }
  t2=$(date +%s%N)
  set -- $s1; a1=$1 d1=$2 n1=$3; set -- $s2; a2=$1 d2=$2
  live=$(compute "$a1" "$a2" "$d1" "$d2" "$n1" $(( (t2 - t1) / 1000 ))) || live=""
  case "$live" in
    ('') echo "  FAIL: live-read gate — idle% not finite (hollow sense)"; fail=1;;
    (*)  set -- $live; echo "  live read: idle=$1% deep=$2% ratio=$3 ($(classify "$1" "$3")) — real hardware produced data";;
  esac

  # ---- STATE ROUND-TRIP: the interval exists only if run N's counters reach run N+1 -------------
  # The pure functions cannot prove the carry happens. Drive two real runs against a sandboxed
  # state/log (a --test must NEVER write the artifact a watchdog reads for liveness) and assert the
  # coverage WIDENS: run 1 has no baseline (window=inst, idle_pct_iv=null), run 2 must read run 1's
  # counters (window=inst+iv, numeric). A gate that only checked run 1 passes with the carry deleted.
  _sd=$(mktemp -d)
  _c1=$(MESH_CSTATE_STATE="$_sd/s" MESH_CSTATE_LOG="$_sd/l" MESH_CSTATE_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  _c2=$(MESH_CSTATE_STATE="$_sd/s" MESH_CSTATE_LOG="$_sd/l" MESH_CSTATE_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  _w1=$(printf '%s' "$_c1" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _w2=$(printf '%s' "$_c2" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _iv2=$(printf '%s' "$_c2" | sed -n 's/.*"idle_pct_iv":\([a-z0-9.]*\).*/\1/p')
  _raw2=$(sed -n 's/.* raw=\([0-9 ]*\)$/\1/p' "$_sd/s" 2>/dev/null | tail -1)
  rm -rf "$_sd"
  [ "$_w1" = inst ] || { echo "smoke-test: FAIL (run 1 has no baseline but reported window=$_w1 — an interval was invented from nothing)"; exit 1; }
  [ "$_w2" = "inst+iv" ] || { echo "smoke-test: FAIL (run 2 reported window=$_w2 — the accumulator is NOT carried across runs, coverage is still ${SECS}s/300s)"; exit 1; }
  case "$_iv2" in ''|null) echo "smoke-test: FAIL (run 2 idle_pct_iv=$_iv2 — the interval window produced no reading)"; exit 1;; esac
  [ -n "$_raw2" ] || { echo "smoke-test: FAIL (state carries no raw= counters — the next run cannot compute an interval)"; exit 1; }

  # ---- CONSUMING the interval is not COMPUTING it ----------------------------------------------
  # Seed a baseline 100s old holding the CURRENT counters: the interval then sees ~no idle time
  # accumulated over 100s of wall — idle≈0%, unambiguously BUSY and unambiguously the busier window.
  # Assert the fold NAMES it and the published LEVEL rides on it. Without this the tool can compute a
  # perfect interval, print it, and still classify off the 2s sample.
  _fd=$(mktemp -d)
  _snap=$(snapshot) || { echo "smoke-test: FAIL (snapshot failed while seeding the fold gate)"; exit 1; }
  set -- $_snap
  printf 'SEED raw=%s %s %s %s\n' "$(( $(date +%s) - 100 ))" "$1" "$2" "$3" > "$_fd/s"
  _cf=$(MESH_CSTATE_STATE="$_fd/s" MESH_CSTATE_LOG="$_fd/l" MESH_CSTATE_SAMPLE_SECS=1 "$0" --json 2>/dev/null)
  rm -rf "$_fd"
  _fwon=$(printf '%s' "$_cf" | sed -n 's/.*"won":"\([a-z]*\)".*/\1/p')
  _flvl=$(printf '%s' "$_cf" | sed -n 's/.*"level":"\([A-Z-]*\)".*/\1/p')
  _fidle=$(printf '%s' "$_cf" | sed -n 's/.*"idle_pct":\([0-9.]*\).*/\1/p')
  [ "$_fwon" = iv ] || { echo "smoke-test: FAIL (seeded a ~0%-idle interval but the fold named won=$_fwon — the interval window loses to the ${SECS}s sample)"; exit 1; }
  awk -v v="${_fidle:-100}" 'BEGIN{exit !(v+0 < 40)}' || { echo "smoke-test: FAIL (interval won but idle_pct=$_fidle — the published axis is not the fold's value)"; exit 1; }
  [ "$_flvl" = BUSY ] || { echo "smoke-test: FAIL (fused idle=$_fidle% but level=$_flvl — the verdict does not ride on the fused axis)"; exit 1; }

  [ "$fail" = 0 ] && { echo "smoke-test: ok (fixture math + 12 coverage asserts + real cpuidle read + across-run carry inst→inst+iv + seeded interval drives the verdict)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

# ---- --status : READ-ONLY, no new sample, no mutation ----
if [ "$MODE" = "--status" ]; then
  if [ -s "$STATE" ]; then
    printf '[cstate] %s (as of %s)\n' "$(cat "$STATE")" "$(date -u -r "$STATE" +%FT%TZ 2>/dev/null || echo '?')"
    exit 0
  fi
  echo "[cstate] no state yet — run mesh-cstate for a sample"; exit 2
fi

# ============================== live sample ==============================
s1=$(snapshot) || { echo "mesh-cstate: no readable cpuidle state*/time (cpuidle hidden — VM/container) — UNREACHABLE" >&2; exit 2; }
t1=$(date +%s%N)
# The PREVIOUS run's raw counters, read before the state file is overwritten. Absent (first run, or
# a state line predating this field) => the interval window renders na, never a fabricated reading.
prev_raw="$(sed -n 's/.* raw=\([0-9 ]*\)$/\1/p' "$STATE" 2>/dev/null | tail -1)"
sleep "$SECS"
s2=$(snapshot) || { echo "mesh-cstate: second cpuidle snapshot failed — UNREACHABLE" >&2; exit 2; }
t2=$(date +%s%N)
set -- $s1; A1=$1 D1=$2 N=$3
set -- $s2; A2=$1 D2=$2
dt_us=$(( (t2 - t1) / 1000 ))
res=$(compute "$A1" "$A2" "$D1" "$D2" "$N" "$dt_us") \
  || { echo "mesh-cstate: bad sample (dt=${dt_us}us n=$N) — UNREACHABLE" >&2; exit 2; }
set -- $res; I_IDLE=$1 I_DEEP=$2 I_DR=$3
level_inst=$(classify "$I_IDLE" "$I_DR")

# --- INTERVAL window: the same counters delta'd against the PREVIOUS run (100% coverage) ---
now_s=$(( t2 / 1000000000 ))
read -r V_IDLE V_DEEP V_DR <<< "$(interval_res "$prev_raw" "$now_s" "$A2" "$D2" "$N" "$MAX_IV_AGE")"
if [ "$V_IDLE" = na ]; then level_iv=na; else level_iv=$(classify "$V_IDLE" "$V_DR"); fi

# --- Fold: the busier window wins and is NAMED; deep%/ratio come from the SAME window ---
read -r IDLE won <<< "$(fold_idle "$I_IDLE" "$V_IDLE")"
if [ "$won" = iv ]; then DEEP="$V_DEEP"; DR="$V_DR"; else DEEP="$I_DEEP"; DR="$I_DR"; fi
if [ "$V_IDLE" = na ]; then window="inst"; else window="inst+iv"; fi

level=$(classify "$IDLE" "$DR")
ts=$(date -u +%FT%TZ)
# ONE quantity, ONE rendering: a percentage carries its % and an absent reading is a bare `na`.
# `iv=na%` would read as "na percent" and `idle_iv=75.1` as a different unit from idle_inst=75.1%.
V_IDLE_R="$V_IDLE"; [ "$V_IDLE" = na ] || V_IDLE_R="${V_IDLE}%"

mkdir -p "$(dirname "$STATE")" 2>/dev/null
# Leading token stays the LEVEL and idle=/deep=/ratio= keep their names (existing consumers read
# those); the coverage fields and the trailing raw= carry — which is what makes the interval window
# possible at all — are appended. Unconditional write: mtime = liveness.
printf '%s idle=%s%% deep=%s%% ratio=%s window=%s idle_inst=%s%% idle_iv=%s won=%s level_inst=%s level_iv=%s raw=%s %s %s %s\n' \
  "$level" "$IDLE" "$DEEP" "$DR" "$window" "$I_IDLE" "$V_IDLE_R" "$won" "$level_inst" "$level_iv" \
  "$now_s" "$A2" "$D2" "$N" >"$STATE"
printf '%s %s %s %s %s %s %s %s %s\n' "$ts" "$level" "$IDLE" "$DEEP" "$DR" "$N" "$window" "$won" "$level_inst" >>"$LOG"
if [ "$(wc -l <"$LOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

if [ "$MODE" = "--json" ]; then
  # level/idle_pct/deep_ratio are the FUSED reading; the *_inst fields are the in-run sample alone.
  # A consumer pairing cstate with another instantaneous read (mesh-wakeup-attrib's irq correlation)
  # must use the _inst fields — correlating a 5-minute mean with a 2-second irq sample is a claim
  # about two different windows wearing one sentence.
  printf '{"level":"%s","idle_pct":%s,"deep_pct":%s,"deep_ratio":%s,"ncpu":%s,"elapsed_ms":%s,"window":"%s","won":"%s","level_inst":"%s","idle_pct_inst":%s,"deep_pct_inst":%s,"deep_ratio_inst":%s,"level_iv":"%s","idle_pct_iv":%s,"ts":"%s"}\n' \
    "$level" "$IDLE" "$DEEP" "$DR" "$N" "$(( dt_us / 1000 ))" "$window" "$won" \
    "$level_inst" "$I_IDLE" "$I_DEEP" "$I_DR" "$level_iv" \
    "$([ "$V_IDLE" = na ] && echo null || echo "$V_IDLE")" "$ts"
else
  printf '[cstate] %s — idle=%s%% (deep=%s%%, deep-of-idle=%s) across %s cpus | window=%s inst=%s%%(%s) iv=%s(%s) won=%s (sample %ss) | thresholds idle>=%s busy<%s deep>=%s\n' \
    "$level" "$IDLE" "$DEEP" "$DR" "$N" "$window" "$I_IDLE" "$level_inst" "$V_IDLE_R" "$level_iv" "$won" \
    "$(awk -v u="$dt_us" 'BEGIN{printf "%.1f", u/1000000}')" "$IDLE_HI" "$BUSY_LO" "$DEEP_RATIO"
fi
