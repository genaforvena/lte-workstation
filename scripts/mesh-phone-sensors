#!/usr/bin/env bash
# mesh-phone-sensors — live sensor dump from the phone body. SSHes the phone and reads
# battery, light, accelerometer, location, camera list, WiFi scan, volume/DND profile, and
# SMS API in one shot.
# Output: one labeled JSON block per sensor on stdout.
#
# The `volume` block reads termux-volume (audio stream LEVELS — the one phone read this dump
# was missing) and derives an interruption-preference verdict: ring=0 means incoming calls
# won't ring audibly (silent OR vibrate — a real do-not-disturb signal no other organ reports).
# Honest: termux exposes levels, not ringer_mode, so ring=0 is silent-or-vibrate, stated as such.
#
#   mesh-phone-sensors             full sensor dump
#   mesh-phone-sensors --test      smoke test (deps + volume-profile classifier unit + phone reachability)
#
# Registry-resolved phone (~/.mesh/nodes / PHONE_IP env var / LAN fallback).
# Honest-organ: phone-unreachable exits 2 (n/a), not a false empty-or-success.
# Each sensor is attempted independently; a failed sensor prints an error label and
# continues — one dead sensor does not suppress the others.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
# source phone_reachable_ip from canonical patterns lib
. "${MESH_PATTERNS:-$HOME/.local/bin/mesh-patterns.sh}" 2>/dev/null || \
  . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true

PHONE_PORT="${PHONE_SSH_PORT:-8022}"

# classify_volume — PURE (no SSH): read termux-volume JSON on stdin, emit a one-line profile
# verdict. Volume-only signal (termux exposes stream LEVELS, not ringer_mode) → ring=0 is
# silent-OR-vibrate, stated honestly. AUDIBLE = ring>0; SILENCED = every alerting stream
# (ring/notification/system) muted AND media off; RING-OFF = ring muted but another stream
# still audible; UNKNOWN = unparseable / no alerting streams (honest, never a faked verdict).
classify_volume(){
  python3 -c '
import json,sys
def out(d): print(json.dumps(d)); sys.exit(0)
try:
    data=json.load(sys.stdin)
except Exception:
    out({"profile":"UNKNOWN","error":"unparseable volume read"})
v={d.get("stream"):d.get("volume") for d in data if isinstance(d,dict)}
ring=v.get("ring"); notif=v.get("notification"); system=v.get("system"); music=v.get("music")
if ring is None and notif is None and system is None:
    out({"profile":"UNKNOWN","error":"no alerting streams in read"})
ring_audible=(ring or 0)>0
alerts=[x for x in (ring,notif,system) if x is not None]
media_off = music in (0,None)
if ring_audible: profile="AUDIBLE"
elif all(x==0 for x in alerts) and media_off: profile="SILENCED"
else: profile="RING-OFF"
out({"profile":profile,"ring_audible":ring_audible,"ring":ring,"notification":notif,
     "system":system,"music":music,
     "note":"volume-only; ring=0 is silent-or-vibrate (ringer_mode not exposed)"})
'
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # pure volume-profile classifier unit asserts (offline — no SSH, fire nothing):
  s="$(printf '[{"stream":"ring","volume":0},{"stream":"notification","volume":0},{"stream":"system","volume":0},{"stream":"music","volume":0},{"stream":"alarm","volume":10},{"stream":"call","volume":11}]' | classify_volume)"
  echo "$s" | grep -q '"profile": "SILENCED"' || { echo "smoke-test: FAIL (silenced classify: $s)"; exit 1; }
  a="$(printf '[{"stream":"ring","volume":5},{"stream":"notification","volume":5}]' | classify_volume)"
  echo "$a" | grep -q '"profile": "AUDIBLE"' || { echo "smoke-test: FAIL (audible classify: $a)"; exit 1; }
  r="$(printf '[{"stream":"ring","volume":0},{"stream":"notification","volume":0},{"stream":"system","volume":0},{"stream":"music","volume":8}]' | classify_volume)"
  echo "$r" | grep -q '"profile": "RING-OFF"' || { echo "smoke-test: FAIL (ring-off classify: $r)"; exit 1; }
  u="$(printf 'not json' | classify_volume)"
  echo "$u" | grep -q '"profile": "UNKNOWN"' || { echo "smoke-test: FAIL (unparseable→UNKNOWN: $u)"; exit 1; }
  pip="$(phone_reachable_ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — all IPs tried; classifier unit ok)"; exit 2; }
  timeout 10 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
    'command -v termux-battery-status && command -v termux-sensor && command -v termux-volume' </dev/null >/dev/null 2>&1 \
    || { echo "smoke-test: n/a (phone unreachable or Termux:API missing)"; exit 2; }
  echo "smoke-test: ok (deps + volume-profile classifier + phone reachability)"; exit 0
fi

# resolve phone IP via canonical function (TS→LAN probe)
if type phone_reachable_ip >/dev/null 2>&1; then
  pip="$(phone_reachable_ip 2>/dev/null)" || { echo "phone unreachable — no sensor read (n/a)" >&2; exit 2; }
else
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "phone unreachable — no sensor read (n/a)" >&2; exit 2; }
fi

PUSER="${PHONE_USER:-u0_a380}"
SSH_OPTS=(-p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new)

# run a command on the phone; print the output or an error sentinel on failure
phone_cmd(){
  local label="$1" cmd="$2" timeout_s="${3:-12}"
  printf '\n=== %s ===\n' "$label"
  local out
  if out="$(timeout "$timeout_s" ssh "${SSH_OPTS[@]}" "${PUSER}@${pip}" "$cmd" </dev/null 2>/dev/null)"; then
    printf '%s\n' "$out"
  else
    printf '{"error":"command failed or timed out","label":"%s"}\n' "$label"
  fi
}

printf '{"phone":"%s","user":"%s","timestamp":"%s"}\n' \
  "$pip" "$PUSER" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

phone_cmd "battery" "termux-battery-status" 10

# volume / DND profile: audio stream levels + a derived interruption-preference verdict.
# The raw read is printed like every other block; classify_volume adds the one-line profile
# (SILENCED/RING-OFF/AUDIBLE) so a consumer can gate on the operator's do-not-disturb state.
printf '\n=== volume ===\n'
vol_raw="$(timeout 12 ssh "${SSH_OPTS[@]}" "${PUSER}@${pip}" "termux-volume" </dev/null 2>/dev/null)"
if [ -n "$vol_raw" ]; then
  printf '%s\n' "$vol_raw"
  printf '%s\n' "$vol_raw" | classify_volume
else
  printf '{"error":"command failed or timed out","label":"volume"}\n'
fi

# light sensor: try known name first, fall back to first available light sensor
phone_cmd "light" \
  "termux-sensor -s tmd2755_l -n 1 2>/dev/null || termux-sensor -s light -n 1 2>/dev/null || echo '{\"error\":\"no light sensor\"}'" \
  14

# accelerometer: try known model first, fall back to generic
phone_cmd "accelerometer" \
  "termux-sensor -s bma420 -n 1 2>/dev/null || termux-sensor -s accelerometer -n 1 2>/dev/null || echo '{\"error\":\"no accel sensor\"}'" \
  14

# location via network provider (fast; GPS takes too long for a one-shot dump)
phone_cmd "location" "timeout 12 termux-location -p network" 16

phone_cmd "camera_info" "termux-camera-info" 10

# WiFi scan — top 5 networks (avoid flooding; SSIDs may be numerous)
phone_cmd "wifi_scan_top5" \
  "termux-wifi-scaninfo 2>/dev/null | python3 -c 'import json,sys; nets=json.load(sys.stdin); print(json.dumps(nets[:5], indent=2))' 2>/dev/null || echo '{\"error\":\"wifi scan failed\"}'" \
  18

# SMS: read latest 1 to confirm Termux:API SMS permission is working
phone_cmd "sms_latest" "termux-sms-list -l 1" 12

printf '\n=== done ===\n'
