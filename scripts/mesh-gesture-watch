#!/usr/bin/env bash
# mesh-gesture-watch — gesture REFLEX: watch the camera's latest frame, detect a THUMBS-UP via a
# local MediaPipe model, and on detection say "Меш слышит" on the Bose. Pure reflex — no minds
# (operator 2026-06-19: "большой палец детектируем и тогда говорим 'Меш слышит' в колонку Bose").
#
# Runs on the node with the camera + Bose (default-string). It does NOT open the camera itself —
# it reads the fresh frame that mesh-cam-watch already captures (~/.mesh/cam-prev.jpg), so the two
# reflexes coexist without fighting over /dev/video0. MediaPipe GestureRecognizer runs locally on CPU
# (no cloud). On a debounced Thumb_Up it plays a pre-rendered phrase on the Bose (the node's default
# pw-play sink).
#
#   mesh-gesture-watch --daemon   run the watch loop (the service ExecStart)
#   mesh-gesture-watch --once     recognize the current frame, print the gesture (no Bose)
#   mesh-gesture-watch --test     load model + run recognizer on the current frame (no Bose, no loop)
#
# Tunables (env): GEST_IMG=~/.mesh/cam-prev.jpg · GEST_MODEL=~/.mesh/models/gesture_recognizer.task
#   GEST_WAV=~/.mesh/mesh-slyshit.wav · GEST_POLL=1.0 · GEST_THRESH=0.55 · GEST_COOLDOWN=8
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire/Bose sink
MESH="${MESH_DIR:-$HOME/.mesh}"
export GEST_IMG="${GEST_IMG:-$MESH/cam-prev.jpg}"
export GEST_MODEL="${GEST_MODEL:-$MESH/models/gesture_recognizer.task}"
export GEST_WAV="${GEST_WAV:-$MESH/mesh-slyshit.wav}"
export GEST_POLL="${GEST_POLL:-1.0}"
export GEST_THRESH="${GEST_THRESH:-0.55}"
export GEST_COOLDOWN="${GEST_COOLDOWN:-8}"
export GEST_LOG="${GEST_LOG:-$MESH/gesture-events.log}"
export GEST_TARGET="${GEST_TARGET:-Thumb_Up}"

PY="$(mktemp /tmp/gest-XXXXXX.py)"; trap 'rm -f "$PY"' EXIT
cat > "$PY" <<'PYEOF'
import os, sys, time, subprocess
import cv2, mediapipe as mp
from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision

MODEL=os.environ["GEST_MODEL"]; IMG=os.environ["GEST_IMG"]; WAV=os.environ["GEST_WAV"]
POLL=float(os.environ.get("GEST_POLL","1.0")); THRESH=float(os.environ.get("GEST_THRESH","0.55"))
COOLDOWN=float(os.environ.get("GEST_COOLDOWN","8")); LOG=os.environ["GEST_LOG"]
TARGET=os.environ.get("GEST_TARGET","Thumb_Up")
mode=sys.argv[1] if len(sys.argv)>1 else "daemon"

def logln(s):
    try:
        with open(LOG,"a") as f: f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ",time.gmtime())+s+"\n")
    except Exception: pass

rec=vision.GestureRecognizer.create_from_options(
    vision.GestureRecognizerOptions(base_options=mp_python.BaseOptions(model_asset_path=MODEL)))

def top_gesture(path):
    img=cv2.imread(path)
    if img is None: return None,0.0
    mpimg=mp.Image(image_format=mp.ImageFormat.SRGB, data=cv2.cvtColor(img,cv2.COLOR_BGR2RGB))
    res=rec.recognize(mpimg)
    best=None; sc=0.0
    for hand in (res.gestures or []):
        if hand and hand[0].category_name not in ("None",""):
            if hand[0].score>sc: best=hand[0].category_name; sc=hand[0].score
    return best,sc

def play_bose():
    try: subprocess.Popen(["pw-play",WAV], env=dict(os.environ),
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e: logln("BOSE-ERR "+str(e))

if mode in ("once","test"):
    g,s=top_gesture(IMG)
    print(f"gesture={g or 'None'} score={s:.2f}  target={TARGET}")
    sys.exit(0)

# daemon
logln(f"gesture-watch START (target={TARGET} thresh={THRESH} poll={POLL}s cooldown={COOLDOWN}s)")
last=0.0; last_mtime=-1.0
while True:
    try:
        try: mt=os.path.getmtime(IMG)
        except OSError: time.sleep(POLL); continue
        if mt!=last_mtime:
            last_mtime=mt
            g,s=top_gesture(IMG)
            if g==TARGET and s>=THRESH:
                now=time.time()
                if now-last>=COOLDOWN:
                    last=now; logln(f"{TARGET} score={s:.2f} -> Bose"); play_bose()
    except Exception as e:
        logln("ERR "+str(e))
    time.sleep(POLL)
PYEOF

case "${1:-}" in
  --test)
    command -v python3 >/dev/null && python3 -c 'import mediapipe,cv2' 2>/dev/null || { echo "smoke-test: n/a (mediapipe/opencv not installed)"; exit 2; }
    [ -f "$GEST_MODEL" ] || { echo "smoke-test: FAIL (model missing: $GEST_MODEL)"; exit 1; }
    [ -f "$GEST_IMG" ]   || { echo "smoke-test: WARN (no frame yet at $GEST_IMG — is mesh-cam-watch running?)"; exit 0; }
    out="$(python3 "$PY" test 2>&1 | tail -1)"; echo "  recognizer ran on current frame: $out"
    case "$out" in *gesture=*) echo "smoke-test: ok (model loads + recognizer runs on a live frame)";; *) echo "smoke-test: FAIL ($out)"; exit 1;; esac
    ;;
  --once)   python3 "$PY" once ;;
  --daemon) exec python3 "$PY" daemon ;;
  *) sed -n '2,17p' "$0" ;;
esac
