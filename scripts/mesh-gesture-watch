#!/usr/bin/env bash
# orphan-ok: experiment (gesture reflex, unwired — needs camera setup + wiring)
# mesh-gesture-watch — gesture REFLEX: watch the camera's latest frame, detect a THUMBS-UP via a
# local MediaPipe model, and on detection say "Меш слышит" on the Bose. Pure reflex — no minds
# (operator 2026-06-19: "большой палец детектируем и тогда говорим 'Меш слышит' в колонку Bose").
#
# Runs on the node with the camera + Bose (default-string). It does NOT open the camera itself —
# it reads the fresh frame that mesh-cam-watch already captures (~/.mesh/cam-prev.jpg), so the two
# reflexes coexist without fighting over /dev/video0. MediaPipe GestureRecognizer runs locally on CPU
# (no cloud). On a debounced Thumb_Up it plays a pre-rendered phrase on the Bose (the node's default
# pw-play sink).
#
#   mesh-gesture-watch --daemon   run the watch loop (the service ExecStart)
#   mesh-gesture-watch --once     recognize the current frame, print the gesture (no Bose)
#   mesh-gesture-watch --test     load model + run recognizer on the current frame (no Bose, no loop)
#
# Tunables (env): GEST_IMG=~/.mesh/cam-prev.jpg · GEST_MODEL=~/.mesh/models/gesture_recognizer.task
#   GEST_WAV=~/.mesh/mesh-slyshit.wav · GEST_POLL=1.0 · GEST_THRESH=0.55 · GEST_COOLDOWN=8
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire/Bose sink
MESH="${MESH_DIR:-$HOME/.mesh}"
export GEST_IMG="${GEST_IMG:-$MESH/cam-prev.jpg}"
export GEST_MODEL="${GEST_MODEL:-$MESH/models/gesture_recognizer.task}"
export GEST_WAV="${GEST_WAV:-$MESH/mesh-slyshit.wav}"
export GEST_POLL="${GEST_POLL:-1.0}"
export GEST_THRESH="${GEST_THRESH:-0.55}"
export GEST_COOLDOWN="${GEST_COOLDOWN:-8}"
export GEST_LOG="${GEST_LOG:-$MESH/gesture-events.log}"
export GEST_TARGET="${GEST_TARGET:-Thumb_Up}"
# What a confirmed thumbs-up DOES:
#   bose          → just play the pre-rendered "Меш слышит" wav (the original simple reflex)
#   conversation  → start a continuous voice session (mesh-conversation --session): ack → listen,
#                   answer on each pause, keep listening until a quiet gap ends it
#   comment       → "third party weighs in" (mesh-overhear --comment): analyze the rolling ~15-min
#                   room transcript and speak one observation. The current operator default on ds.
export GEST_ACTION="${GEST_ACTION:-bose}"

PY="$(mktemp /tmp/gest-XXXXXX.py)"; trap 'rm -f "$PY"' EXIT
cat > "$PY" <<'PYEOF'
import os, sys, time, subprocess

MODEL=os.environ["GEST_MODEL"]; IMG=os.environ["GEST_IMG"]; WAV=os.environ["GEST_WAV"]
POLL=float(os.environ.get("GEST_POLL","1.0")); THRESH=float(os.environ.get("GEST_THRESH","0.55"))
COOLDOWN=float(os.environ.get("GEST_COOLDOWN","8")); LOG=os.environ["GEST_LOG"]
TARGET=os.environ.get("GEST_TARGET","Thumb_Up")
mode=sys.argv[1] if len(sys.argv)>1 else "daemon"

def logln(s):
    try:
        with open(LOG,"a") as f: f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ",time.gmtime())+s+"\n")
    except Exception: pass

def play_bose():
    # voice gate (operator 2026-06-24): the room silence/thermal-auto-mute applies to the thumbs-up
    # reflex too. Fail-OPEN on a missing gate binary.
    try:
        if subprocess.run(["mesh-voice-gate"],capture_output=True,timeout=6).returncode!=0: return
    except Exception as e: logln("GATE-ERR "+str(e))
    try: subprocess.Popen(["pw-play",WAV], env=dict(os.environ),
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e: logln("BOSE-ERR "+str(e))

def launch_conversation():
    # Operator 2026-06-20: thumbs-up STARTS a continuous listening session (not a fixed window).
    # mesh-conversation --session plays its own "Меш слышит" ack, then VAD turn-takes: listen → on a
    # pause answer → keep listening, until a long quiet gap ends the session.
    try:
        subprocess.Popen(
            ["mesh-conversation","--session"],
            env=dict(os.environ),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        logln("Thumb_Up -> mesh-conversation --session")
    except Exception as e:
        logln("CONV-ERR "+str(e))
        play_bose()

def launch_comment():
    # Operator 2026-06-20: thumbs-up = "weigh in as a third party" — analyze the rolling ~15-min
    # transcript that mesh-overhear keeps and SPEAK a comment. (Live dialogue was too slow; this is
    # after-the-fact commentary, so latency is fine.)
    try:
        subprocess.Popen(["mesh-overhear","--comment"], env=dict(os.environ),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        logln("Thumb_Up -> mesh-overhear --comment")
    except Exception as e:
        logln("COMMENT-ERR "+str(e)); play_bose()

def launch_room_mind():
    # Operator 2026-06-20: the room CHANNEL has a claude MIND ("навесим клода"). A thumbs-up pokes that
    # mind (on the mind node) instead of the local cheap relay — it reads the rolling transcript and
    # speaks a richer third-party comment back on the Bose. Cross-node poke via mesh-tell.
    # Delegate to the shared trigger mesh-overhear --poke-mind (instant ack on the Bose + freshness-aware
    # poke of the room claude mind). Motion uses the same trigger with --motion, so both behave the same.
    try:
        subprocess.Popen(["mesh-overhear","--poke-mind"], env=dict(os.environ),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        logln("Thumb_Up -> mesh-overhear --poke-mind")
    except Exception as e:
        logln("ROOM-ERR "+str(e)); play_bose()

def dispatch_hit():
    act=os.environ.get("GEST_ACTION","bose")
    if act=="room":           launch_room_mind()   # the operator default on ds: claude mind comments
    elif act=="comment":      launch_comment()     # ds-local relay comment (no mind)
    elif act=="conversation": launch_conversation()
    else:                     play_bose()

if mode == "probe":
    dispatch_hit()
    sys.exit(0)

import cv2, mediapipe as mp
from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision

rec=vision.GestureRecognizer.create_from_options(
    vision.GestureRecognizerOptions(base_options=mp_python.BaseOptions(model_asset_path=MODEL)))

def top_gesture(path):
    img=cv2.imread(path)
    if img is None: return None,0.0
    mpimg=mp.Image(image_format=mp.ImageFormat.SRGB, data=cv2.cvtColor(img,cv2.COLOR_BGR2RGB))
    res=rec.recognize(mpimg)
    best=None; sc=0.0
    for hand in (res.gestures or []):
        if hand and hand[0].category_name not in ("None",""):
            if hand[0].score>sc: best=hand[0].category_name; sc=hand[0].score
    return best,sc

if mode in ("once","test"):
    g,s=top_gesture(IMG)
    print(f"gesture={g or 'None'} score={s:.2f}  target={TARGET}")
    sys.exit(0)

# daemon
logln(f"gesture-watch START (target={TARGET} thresh={THRESH} poll={POLL}s cooldown={COOLDOWN}s)")
last=0.0; last_mtime=-1.0
while True:
    try:
        try: mt=os.path.getmtime(IMG)
        except OSError: time.sleep(POLL); continue
        if mt!=last_mtime:
            last_mtime=mt
            g,s=top_gesture(IMG)
            if g==TARGET and s>=THRESH:
                now=time.time()
                if now-last>=COOLDOWN:
                    last=now; logln(f"{TARGET} score={s:.2f} -> action={os.environ.get('GEST_ACTION','bose')}"); dispatch_hit()
    except Exception as e:
        logln("ERR "+str(e))
    time.sleep(POLL)
PYEOF

case "${1:-}" in
  --test)
    td="$(mktemp -d /tmp/mesh-gesture-watch-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$td"' EXIT
    mkdir -p "$td/bin" "$td/log"
    cat > "$td/bin/pw-play" <<'EOF'
#!/usr/bin/env bash
printf 'PW:%s\n' "$*" >> "${GEST_TEST_LOG:?missing}"
exit 0
EOF
    cat > "$td/bin/mesh-conversation" <<'EOF'
#!/usr/bin/env bash
printf 'CONV:%s\n' "$*" >> "${GEST_TEST_LOG:?missing}"
exit 0
EOF
    chmod +x "$td/bin/pw-play" "$td/bin/mesh-conversation"
    export PATH="$td/bin:$PATH"
    export GEST_TEST_LOG="$td/log/action.log"
    export GEST_ACTION=bose
    python3 "$PY" probe >/dev/null 2>&1 || { echo "smoke-test: FAIL (bose action probe)"; exit 1; }
    grep -q '^PW:' "$GEST_TEST_LOG" || { echo "smoke-test: FAIL (bose action did not call pw-play)"; exit 1; }
    : > "$GEST_TEST_LOG"
    export GEST_ACTION=conversation
    python3 "$PY" probe >/dev/null 2>&1 || { echo "smoke-test: FAIL (conversation action probe)"; exit 1; }
    grep -q '^CONV:--session$' "$GEST_TEST_LOG" || { echo "smoke-test: FAIL (conversation action did not call mesh-conversation --session)"; exit 1; }
    if command -v python3 >/dev/null && python3 -c 'import mediapipe,cv2' 2>/dev/null && [ -f "$GEST_MODEL" ] && [ -f "$GEST_IMG" ]; then
      out="$(python3 "$PY" test 2>&1 | tail -1)"; echo "  recognizer ran on current frame: $out"
      case "$out" in *gesture=*) echo "smoke-test: ok (recognizer + bose/conversation dispatch verified via stubs)";; *) echo "smoke-test: FAIL ($out)"; exit 1;; esac
    else
      echo "smoke-test: n/a (mediapipe/opencv/model/frame unavailable; bose/conversation dispatch verified via stubs)"
    fi
    ;;
  --once)   python3 "$PY" once ;;
  --daemon) exec python3 "$PY" daemon ;;
  *) sed -n '2,17p' "$0" ;;
esac
