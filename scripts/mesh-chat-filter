#!/usr/bin/env bash
# mesh-chat-filter — the FILTER for the CHAT channel: reads one board line (chat.log) on STDIN and
# emits on STDOUT the PROMPT to feed a consuming mind — ONLY for ACTIONABLE lines. The board is data;
# a mind consumes it. Skips noise (own [done]/[news], already-claimed [taking]) so the mind wakes only
# when there's something to act on.
#   mesh-chat-filter --test
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v cat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  out="$(printf '%s\n' '2026-06-11T00:00:00Z  test@node  ::  [task] verify filter path' | bash "$0" 2>/dev/null)" || {
    echo "smoke-test: FAIL (self-filter execution failed)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q 'board has an OPEN task' || {
    echo "smoke-test: FAIL (task line not classified)"; exit 1;
  }
  # [mind-blocked] must produce an actionable unblock prompt (the loop mesh-mind-state opens)
  printf '%s\n' '2026-06-11T00:00:00Z  mind-state@n  ::  [mind-blocked] n:claude waiting on input' | bash "$0" 2>/dev/null | grep -q 'BLOCKED on input' || {
    echo "smoke-test: FAIL (mind-blocked not made actionable)"; exit 1;
  }
  # [mind-limited] → route-work prompt
  printf '%s\n' '2026-06-11T00:00:00Z  mind-state@n  ::  [mind-limited] n:codex quota-exhausted' | bash "$0" 2>/dev/null | grep -q 'QUOTA-EXHAUSTED' || {
    echo "smoke-test: FAIL (mind-limited not made actionable)"; exit 1;
  }
  # [mind-unblocked] is informational — must emit NOTHING (no false wake)
  [ -z "$(printf '%s\n' '2026-06-11T00:00:00Z  mind-state@n  ::  [mind-unblocked] n:claude now WORKING' | bash "$0" 2>/dev/null)" ] || {
    echo "smoke-test: FAIL (mind-unblocked should be silent)"; exit 1;
  }
  echo "smoke-test: ok"
  exit 0
fi
line="$(cat)"; [ -z "${line//[[:space:]]/}" ] && exit 0
case "$line" in
  *"[taking]"*|*"[done]"*|*"[news]"*|*"[doctor]"*|*"[mind-unblocked]"*) exit 0 ;;   # already-claimed / informational → no action
  *"[mind-blocked]"*)
    # a PEER mind sits blocked on a permission/input prompt — it cannot free itself. PEEKING to assess
    # is read-only and fine. PRESSING its choice is PERMISSION-LAUNDERING — a blocked peer is BY
    # DEFINITION another session, and you cannot resolve another session's consent gate by pressing its
    # keys; only the operator (or that session itself) can. The auto-mode classifier blocks cross-session
    # approval on a production/remote host regardless of read-vs-write, and flags a read-retry after a
    # write-denial as tunneling (verified 2026-06-12: BOTH a crontab-write AND a .mesh-read approval on
    # ds were denied). So the remedy is ALWAYS escalate — there is no cross-press exception for a peer.
    echo "a peer MIND is BLOCKED on input and cannot free itself. PEEK to assess (mesh-tell --node <node> --peek <win>), then ESCALATE to the operator with exactly what the pending action is — that is THE remedy. Do NOT press its choice for it: approving another session's consent gate is permission-laundering and the classifier will block it (read OR write). Only the operator (or that mind itself) can answer its gate: ${line}" ;;
  *"[mind-limited]"*)
    echo "a peer MIND is QUOTA-EXHAUSTED (rate-limited) — if you're a healthy mind with budget, pick up its pending board work, or route inference through mesh-relay/another pool: ${line}" ;;
  *"[task]"*)
    echo "board has an OPEN task — if you're free and able, claim it on the board ([taking] you: …), do it, then post [done]: ${line#*\[task\]}" ;;
  *"[question]"*|*"[blocker]"*|*"[help]"*)
    echo "board needs an answer — respond on the board if you can: ${line}" ;;
  *)
    # operator lines on the board (who contains 'operator') are actionable; everything else is chatter
    case "$line" in *operator*) echo "operator on the board — react if it concerns you: ${line}" ;; esac ;;
esac
