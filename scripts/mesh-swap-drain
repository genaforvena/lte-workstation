#!/usr/bin/env bash
# mesh-swap-drain — the post-storm swap-RESIDUE ACTUATOR: repatriate parked swap pages back to RAM
# (swapoff -a && swapon -a) so the NEXT memory spike meets a full swap buffer, not a cliff.
#
# WHY (discover/health task swap-drain-actuator, 2026-07-06): after a memory storm the kernel leaves
# swap FULL long after RAM recovers — nobody resets it. Live at 13:02Z: MemAvailable 3.4GB, psi 0.00,
# node healthy, yet swap parked 3.8G/4G (residue of the 02:04/03:45 storms) → the next spike hit a
# 168MB swap cliff instead of a 4GB buffer (why 12:04 ran so close to OOM). mesh-swap / mesh-swap-rate
# are SENSES only (0 swapoff refs in the genome; swap-rate's header even calls FULL-but-STABLE "fine" —
# true for THROUGHPUT, false for RESILIENCE). This is the missing ACTUATOR that resets the buffer.
#
#   mesh-swap-drain               read-only verdict (DRAIN/REFUSE/NA) — NO actuation (safe to run bare)
#   mesh-swap-drain --status      alias for the read-only verdict + state metadata
#   mesh-swap-drain --drain       the GATED actuate: swapoff -a && swapon -a IFF every safety gate holds
#   mesh-swap-drain --sweep       cron backstop == --drain (the reflex entry point)
#   mesh-swap-drain --test        pure gate logic (falsified both ways) + real-read gate; exit 2 if no swap
#
# SAFETY — the GATE is the safety. swapoff -a pulls ALL swapped pages back into RAM at once; firing it
# blind is an OOM trigger. Actuate ONLY when EVERY condition holds (checked in decide_drain, falsifiable):
#   1. swap is heavily USED   (SwapFree < FREE_PCT_MAX% of total)   — else there's no residue to reclaim.
#   2. memory NOT under stall  (psi memory `full` avg300 <= PSI_MAX ≈ 0) — never fight the kernel mid-stall.
#   3. REPATRIATION MARGIN     (MemAvailable > SwapUsed + MARGIN_MB) — the LOAD-BEARING gate (health
#      2026-07-06): swapoff -a moves SwapUsed into RAM; if it doesn't fit, INSTANT OOM. RIGHT NOW this
#      gate correctly REFUSES (MemAvail 3.1GB !> SwapUsed 4.0GB + 1.5GB) — the actuator's window only
#      opens once the minds quiesce and headroom exists. Narrow but honest.
#   4. no heavy job in flight  (mesh-heavy-run / mesh-whisper-run flock free) — a job about to allocate
#      isn't yet visible in psi/MemAvail; don't drain out from under it.
# When any gate fails it REFUSES trace-only (state file + stderr, NO board alarm — a safe wait is not an
# incident). Only an actual drain posts the [swap-drained] edge + a mesh-trace substrate mark.
#
# NOT mesh-dms: dms schedules a rollback for a HELD change (turbo-lid's open lid). This op is ATOMIC —
# swapon -a restores swap in the SAME invocation, nothing stays "held" to roll back. The only failure of
# concern is swapoff-ok-but-swapon-FAILS (node left with no swap); handled inline (retry + loud alarm),
# which is a better fit than a detached dead-man for a self-completing op.
#
# HONEST DEGRADE: no swap configured → exit 2 (n/a, never a fake "drained"); passwordless sudo absent →
# exit 2 (n/a — other nodes can't actuate, they don't pretend to). state-touch every run (no false-STALE).
#
# FIX (chat-review/swapdrain-unsatisfiable-post-swap2, 2026-07-06): after swap2.img raised SwapTotal
# 4095→8191MB, gate 1's percentage trigger (SwapFree < FREE_PCT_MAX%) only fires past SwapUsed>6962MB,
# but gate 3's margin then demands MemAvail > SwapUsed+MARGIN_MB > 8498MB — impossible on this 7496MB-
# RAM node, so DRAIN was unreachable for EVERY input since 17:50Z (residue sat at 6890MB, unreclaimed,
# while the reflex kept reporting a healthy no-op REFUSE). Two independent fixes:
#   (a) MIN_RESIDUE_MB — an absolute floor, independent of SwapTotal, that ALSO marks swap "worth
#       draining" (gate 1 now fires on pct-full OR absolute-residue). Gate 3's margin math is
#       UNCHANGED (still the real safety limiter) — this only widens WHEN a drain is considered,
#       never loosens WHETHER one is safe.
#   (b) warn_if_unsatisfiable() — boards ONE [swap-drain-unreachable] line (rate-limited per
#       SwapTotal:MemTotal pair, not every cron tick) whenever the pure percentage trigger is
#       structurally impossible on this node's MemTotal, so the next SwapTotal bump can't silently
#       re-kill the actuator without anyone noticing for hours.
#
# reflex-cadence: 17 * * * *
# reflex-args: --drain
# reflex-state: $HOME/.mesh/.swap-drain.state
# reflex-verdict-field: 2
# ^ cadence WITHOUT a declared state file is not derived by mesh-reflex-health, so this reflex had no
# liveness row; and the line leads with a clock, which leaves both freeze axes green (see the same
# header on mesh-device-churn). Field 2 is the verdict word ONLY because write_state was changed to
# emit it as its own whitespace field: the old `<ts> | VERDICT|reason` put a constant `|` in field 2
# and `VERDICT|reason-head` in field 3, so there was no verdict COLUMN to point a declaration at --
# field 3 would have moved whenever only the refusal REASON changed, which is a reset toward silence.
set -uo pipefail
# cron's minimal PATH lacks ~/.local/bin — without it the [swap-drained] post + mesh-trace mark silently
# drop while the actuation fires fine (a drain with no board record). Export it (mesh-turbo-lid precedent).
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_SWAPDRAIN_STATE:-$MESH/.swap-drain.state}"
LOCK="${MESH_SWAPDRAIN_LOCK:-$MESH/.swap-drain.lock}"
MEMINFO="${MESH_SWAPDRAIN_MEMINFO:-/proc/meminfo}"
PSI="${MESH_SWAPDRAIN_PSI:-/proc/pressure/memory}"
HEAVY_LOCK="${MESH_SWAPDRAIN_HEAVY_LOCK:-$MESH/.heavy.lock}"
WHISPER_LOCK="${MESH_SWAPDRAIN_WHISPER_LOCK:-$MESH/.whisper.lock}"
FREE_PCT_MAX="${MESH_SWAPDRAIN_FREE_PCT:-15}"   # drain only when SwapFree < this % of total (swap full)
PSI_MAX="${MESH_SWAPDRAIN_PSI_MAX:-1.0}"        # memory `full` avg300 must be <= this (≈ no stall)
MARGIN_MB="${MESH_SWAPDRAIN_MARGIN_MB:-1536}"   # repatriation headroom over SwapUsed (1.5GB) — LOAD-BEARING
# Absolute residue floor (independent of SwapTotal) — swap is ALSO "worth draining" once SwapUsed
# crosses this, even if SwapFree% hasn't crossed FREE_PCT_MAX. Keeps the actuator reachable when
# SwapTotal grows (swap2.img etc) faster than MemTotal — see FIX note above.
MIN_RESIDUE_MB="${MESH_SWAPDRAIN_MIN_RESIDUE_MB:-2048}"
NICE="${MESH_SWAPDRAIN_NICE:-19}"
DRYRUN="${MESH_SWAPDRAIN_DRYRUN:-0}"            # 1 = never fire a real swapoff/swapon (used by --test)
CONFIG_WARN_STATE="${MESH_SWAPDRAIN_CONFIG_WARN_STATE:-$MESH/.swap-drain-config-warn}"
# TREADMILL breadcrumb (chat-review/swap-drain-treadmill-detection, 2026-07-16): "<epoch> DRAINED|TREADMILL",
# written ONLY by do_drain — deliberately NOT the one-line $STATE, which do_status rewrites on every bare
# run and would clobber the drain history (the selfcare-once class, 086b420). Live treadmill 2026-07-16:
# back-to-back hourly DRAINED 21:17+22:17, ~2.3GB/h refill vs prior ~0.3GB/h — gigaam's 1531MB warm-model
# VmSwap re-evicted after every forced re-ingest; swap-rate's THRASHING in= spikes were the drain itself.
TREADF="${MESH_SWAPDRAIN_TREADMILL_STATE:-$MESH/.swap-drain.treadmill}"
TREADMILL_WINDOW_S="${MESH_SWAPDRAIN_TREADMILL_WINDOW_S:-7500}"   # 2 hourly cadences + slack
PROCDIR="${MESH_SWAPDRAIN_PROCDIR:-/proc}"       # injectable so --test names a fixture proc, not a live one

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- readers (inject-overridable so --test drives them with fixtures) ----------------------
read_meminfo_kb(){ # $1 key → value in kB ('' if absent)
  awk -v k="$1:" '$1==k{print $2; exit}' "$MEMINFO" 2>/dev/null
}
read_psi_full300(){ # memory `full` avg300 (float; '0' if unreadable — treated as no-stall only if file present)
  awk '/^full /{for(i=1;i<=NF;i++){n=index($i,"="); if(n>0 && substr($i,1,n-1)=="avg300"){print substr($i,n+1); exit}}}' "$PSI" 2>/dev/null
}

# heavy_busy → 0 (busy) if a heavy-run/whisper flock is HELD by another proc. Injectable for --test via
# MESH_SWAPDRAIN_HEAVY_BUSY=0|1; else a real non-blocking flock probe (append-open so we never truncate
# the lock file; the subshell releases the fd on exit).
heavy_busy(){
  if [ -n "${MESH_SWAPDRAIN_HEAVY_BUSY:-}" ]; then
    [ "$MESH_SWAPDRAIN_HEAVY_BUSY" = 1 ] && return 0 || return 1
  fi
  command -v flock >/dev/null 2>&1 || return 1
  local p
  for p in "$HEAVY_LOCK" "$WHISPER_LOCK"; do
    [ -e "$p" ] || continue
    ( exec 9>>"$p" 2>/dev/null || exit 0; flock -n 9 ) || return 0   # couldn't acquire = held = busy
  done
  return 1
}

# --- decide_drain — the PURE gate (falsifiable via --test). Echoes "VERDICT|reason".
#     Args: swaptotal_kb swapfree_kb memavail_kb psi_full300 heavy_busy(0|1)
#     VERDICT ∈ NA (no swap) | REFUSE (unsafe/nothing to do) | DRAIN (all gates pass).
decide_drain(){
  local st="$1" sf="$2" ma="$3" psi="$4" busy="$5"
  { [ -n "$st" ] && printf '%d' "$st" >/dev/null 2>&1 && [ "$st" -gt 0 ] 2>/dev/null; } \
    || { echo "NA|no swap configured (SwapTotal=${st:-?}) — actuator not applicable"; return; }
  local su=$(( st - sf ))                          # SwapUsed kB
  local free_pct=$(( sf * 100 / st ))
  local su_mb=$(( su / 1024 )) ma_mb=$(( ma / 1024 )) margin_kb=$(( MARGIN_MB * 1024 ))
  # 2. never drain under an active memory stall
  if awk -v p="${psi:-0}" -v m="$PSI_MAX" 'BEGIN{exit !(p+0 > m+0)}'; then
    echo "REFUSE|memory under active stall (psi full avg300=${psi} > ${PSI_MAX}) — will not fight the kernel"; return
  fi
  # 1. only worth draining when swap is heavily used BY PERCENTAGE, OR carries an absolute residue
  #    over MIN_RESIDUE_MB. The pct-only gate was dead-by-config after swap2.img (see FIX note above):
  #    its own crossing point (SwapUsed at (100-FREE_PCT_MAX)% of SwapTotal) plus MARGIN_MB can exceed
  #    MemTotal, so it could structurally never co-fire with gate 3 below. The absolute floor is
  #    independent of SwapTotal and stays reachable as long as MemTotal comfortably exceeds
  #    MIN_RESIDUE_MB+MARGIN_MB (true for any node sized to run this actuator).
  if [ "$free_pct" -ge "$FREE_PCT_MAX" ] && [ "$su_mb" -lt "$MIN_RESIDUE_MB" ]; then
    echo "REFUSE|swap not full (SwapFree ${free_pct}% >= ${FREE_PCT_MAX}%, SwapUsed ${su_mb}MB < ${MIN_RESIDUE_MB}MB floor) — no residue to reclaim"; return
  fi
  # 3. LOAD-BEARING: SwapUsed must fit in RAM with margin, or swapoff -a OOMs
  if [ "$ma" -le $(( su + margin_kb )) ]; then
    echo "REFUSE|insufficient repatriation margin (MemAvail ${ma_mb}MB <= SwapUsed ${su_mb}MB + ${MARGIN_MB}MB) — swapoff would OOM"; return
  fi
  # 4. don't drain out from under an in-flight heavy job
  if [ "$busy" = 1 ]; then
    echo "REFUSE|a heavy-run/whisper job holds the lock — defer until it completes"; return
  fi
  echo "DRAIN|safe: SwapFree ${free_pct}% (SwapUsed ${su_mb}MB), psi ${psi}, MemAvail ${ma_mb}MB > SwapUsed+${MARGIN_MB}MB"
}

# --- config-satisfiability assert: is the PURE PERCENTAGE trigger even reachable on this MemTotal? ---
# Independent of MIN_RESIDUE_MB above — this names the ORIGINAL defect explicitly so a future
# SwapTotal bump (another swap*.img) can't silently re-kill the pct trigger without anyone noticing.
check_pct_satisfiable(){ # $1=swaptotal_kb $2=memtotal_kb -> "OK" or "UNREACHABLE|reason"
  local st="$1" mt="$2"
  { [ -n "$st" ] && [ "$st" -gt 0 ]; } 2>/dev/null || { echo "OK"; return; }   # no swap — n/a
  { [ -n "$mt" ] && [ "$mt" -gt 0 ]; } 2>/dev/null || { echo "OK"; return; }   # MemTotal unreadable — can't assert
  local trig_su_kb=$(( st * (100 - FREE_PCT_MAX) / 100 ))   # SwapUsed at which the pct gate first trips
  local need_kb=$(( trig_su_kb + MARGIN_MB * 1024 ))
  if [ "$need_kb" -gt "$mt" ]; then
    echo "UNREACHABLE|pct-trigger (SwapFree<${FREE_PCT_MAX}%) needs MemAvail>$(( need_kb/1024 ))MB but MemTotal=$(( mt/1024 ))MB — structurally impossible regardless of load"
  else
    echo "OK"
  fi
}

# warn_if_unsatisfiable: boards ONE [swap-drain-unreachable] line per distinct STRUCTURAL VERDICT —
# not every cron tick — so a misconfig is loud exactly once, not spam.
#
# THE KEY IS THE CONFIGURATION, NOT THE READING (2026-08-27, task {#66dfeb0e}). It used to be
# "${st}:${mt}" — SwapTotal and MemTotal in raw kB — while the message this dedups prints MB. MemTotal
# is not a constant: the kernel's own accounting moves it by a few MB across boots (crashkernel,
# reserved regions, hotplug), and a once-only structural alarm keyed on the raw kB re-arms on a wobble
# far below its own printed resolution. Measured on the live board the same day: TWO
# [swap-drain-unreachable] posts from imozerov-IdeaPad-3-15IIL05, 17:17:02Z and 18:17:01Z, IDENTICAL
# in every word except MemTotal=7496MB -> 7493MB. Nothing about the configuration changed; the alarm
# simply re-fired about the same unchanged fact.
#
# THE OBVIOUS FIX IS THE WRONG ONE, AND THE TEST BELOW PROVES IT. "Key on the MB figures the message
# actually prints" does not work: 7496MB and 7493MB ARE different at MB granularity, so the rendered
# sentence differs too and keying on it re-arms exactly as the raw kB did. The granularity was never
# the defect — the KIND of term was. MemTotal is a READING of the machine; the thing this line warns
# about is a CONFIGURATION that cannot be satisfied on it. So the key carries the configuration
# exactly (swap size, the two gate constants, the floor the board line quotes) and the reading only
# COARSELY, bucketed to GiB — small enough that a boot-to-boot wobble cannot move it, large enough
# that adding RAM does.
#
# Both directions are asserted, because a dedup key has two ways to be wrong and only one of them is
# noisy: too fine re-arms on nothing (the live defect), too coarse SWALLOWS a real change and the
# operator never hears the corrected claim. [[a-coarsening-is-safe-only-up-to-the-response-signature]]:
# coarsen to the granularity the consumer responds to, never past it.
warn_if_unsatisfiable(){ # $1=swaptotal_kb $2=memtotal_kb
  local st="$1" mt="$2" res marker
  res="$(check_pct_satisfiable "$st" "$mt")"
  case "$res" in
    UNREACHABLE\|*)
      marker="pct-unsat|swap=$(( st/1024 ))MB|pct=${FREE_PCT_MAX}|margin=${MARGIN_MB}|floor=${MIN_RESIDUE_MB}|memGiB=$(( mt/1048576 ))"
      if [ "$(cat "$CONFIG_WARN_STATE" 2>/dev/null || echo '')" != "$marker" ]; then
        board "[swap-drain-unreachable] $(hostname) ${res#*|} (MIN_RESIDUE_MB=${MIN_RESIDUE_MB} floor covers this gap)"
        printf '%s\n' "$marker" > "$CONFIG_WARN_STATE" 2>/dev/null || true
      fi
      ;;
  esac
}

board(){ # edge posts only; a swallowed post is non-fatal (drain still happened, state records it)
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="swap-drain@$(hostname)" mesh-chat "$1" >/dev/null 2>&1 || true
}
write_state(){ # $1 verdict-line ("VERDICT|reason")
  # THE VERDICT GETS ITS OWN WHITESPACE FIELD (field 2), which is what `# reflex-verdict-field: 2` up
  # top points at. The old shape was `<ts> | VERDICT|reason`: field 2 was a constant `|` and field 3
  # was `VERDICT|reason-head`, so this file had no verdict COLUMN at all -- pointing the declaration
  # at field 3 would have digested the refusal REASON too (five distinct REFUSE reasons here), and a
  # label that moves when only the reason moved resets the frozen clock, which fails toward silence.
  # A line with no `|` prints its verdict alone rather than duplicating itself into both halves.
  local _v="${1%%|*}" _r=""
  case "$1" in *'|'*) _r="${1#*|}";; esac
  printf '%s %s%s\n' "$(ts)" "$_v" "${_r:+ | $_r}" > "$STATE" 2>/dev/null || true
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null || true
}

# do_swap <swapoff|swapon> -a … : niced/ioniced sudo, DRYRUN-gated so --test never fires / needs sudo.
do_swap(){
  if [ "$DRYRUN" = 1 ]; then echo "DRYRUN sudo $*"; return 0; fi
  local pre=(); command -v nice >/dev/null 2>&1 && pre+=(nice -n "$NICE")
  command -v ionice >/dev/null 2>&1 && pre+=(ionice -c3)
  "${pre[@]}" sudo -n "$@"
}

# top_vmswap — the process holding the most VmSwap: "name(pid N) NNNMB", or "?" if unreadable.
# cat (not awk-on-glob) so a PID that exits mid-scan skips with a warning instead of aborting
# the whole read (gawk treats an unopenable command-line file as fatal and drops END).
top_vmswap(){
  local out
  out="$(cat "$PROCDIR"/[0-9]*/status 2>/dev/null | awk '
    /^Name:/  {name=$2}
    /^Pid:/   {pid=$2}
    /^VmSwap:/{if ($2+0 > best) {best=$2+0; bn=name; bp=pid}}
    END{if (bn != "") printf "%s(pid %s) %dMB\n", bn, bp, int(best/1024)}')"
  printf '%s\n' "${out:-?}"
}

swap_used_mb(){ # current SwapUsed in MB from live MEMINFO
  local st sf; st="$(read_meminfo_kb SwapTotal)"; sf="$(read_meminfo_kb SwapFree)"
  [ -n "$st" ] && [ -n "$sf" ] || { echo "?"; return; }
  echo $(( (st - sf) / 1024 ))
}

live_verdict(){ # echoes the decide_drain verdict from live /proc
  local st sf ma mt psi busy
  st="$(read_meminfo_kb SwapTotal)"; sf="$(read_meminfo_kb SwapFree)"; ma="$(read_meminfo_kb MemAvailable)"
  mt="$(read_meminfo_kb MemTotal)"
  psi="$(read_psi_full300)"; [ -n "$psi" ] || psi=0
  st="${st:-0}"; sf="${sf:-0}"; ma="${ma:-0}"
  warn_if_unsatisfiable "$st" "${mt:-0}"
  if heavy_busy; then busy=1; else busy=0; fi
  decide_drain "$st" "$sf" "$ma" "$psi" "$busy"
}

do_drain(){ # the gated actuate
  local verdict label reason; verdict="$(live_verdict)"; label="${verdict%%|*}"; reason="${verdict#*|}"
  # TREADMILL gate: a drain whose reclaim refills within TREADMILL_WINDOW_S is not reclaiming residue,
  # it is forcing a warm process's pages on a re-ingest/re-evict loop — the drain IS the thrash. Skip
  # it (and keep skipping while the refill persists) UNLESS the pct emergency (SwapFree < FREE_PCT_MAX%)
  # coincides with REAL memory pressure. First-time-above-floor is unchanged.
  # PRESSURE-GATED EMERGENCY (chat-review/swap-drain-emergency-treadmill-bypass): the bypass used to be
  # unconditional — "swap pct-full always drains" — but a near-full swap with RAM ample is COSMETIC
  # (the parked pages are cold; RAM headroom is the spike buffer), and an active treadmill kept
  # re-crossing the pct line hourly, so the emergency lane re-drained straight through the announced
  # treadmill every cron tick (live 2026-07-20: [swap-treadmill] 16:17Z, [swap-drained] 17:17:40Z at
  # SwapFree 12%, psi 0.00, MemAvail 14049MB — the drain WAS the thrash). Real pressure = psi>0.
  # The task's other half (MemAvail < SwapUsed+MARGIN_MB) needs no clause: that region is exactly
  # gate 3's REFUSE, so no DRAIN verdict can carry it — psi is the only pressure signal alive here.
  if [ "$label" = DRAIN ]; then
    local _tst _tsf _tfp=0 _embypass=0
    _tst="$(read_meminfo_kb SwapTotal)"; _tsf="$(read_meminfo_kb SwapFree)"
    { [ -n "$_tst" ] && [ "$_tst" -gt 0 ]; } 2>/dev/null && _tfp=$(( ${_tsf:-0} * 100 / _tst ))
    if [ "$_tfp" -lt "$FREE_PCT_MAX" ]; then      # pct emergency: bypass only under real pressure
      local _tpsi; _tpsi="$(read_psi_full300)"
      awk -v p="${_tpsi:-0}" 'BEGIN{exit !(p+0 > 0)}' && _embypass=1
    fi
    if [ "$_embypass" = 0 ]; then                 # floor-triggered drain, or a CALM pct emergency
      local _tread _pepoch _plabel _page
      _tread="$(cat "$TREADF" 2>/dev/null || echo)"
      _pepoch="${_tread%% *}"; _plabel="${_tread#* }"
      case "$_pepoch" in ''|*[!0-9]*) _pepoch=0 ;; esac
      if [ "$_pepoch" -gt 0 ] && { _page=$(( $(date -u +%s) - _pepoch )); [ "$_page" -le "$TREADMILL_WINDOW_S" ]; }; then
        case "$_plabel" in
          DRAINED|TREADMILL)
            local _top; _top="$(top_vmswap)"
            # board ONCE, on the DRAINED→TREADMILL edge only — a persisting treadmill renews quietly
            [ "$_plabel" = DRAINED ] && board "[swap-treadmill] $(hostname) swap back above floor ${_page}s after a drain — draining forces re-ingest and the kernel re-evicts (top VmSwap: ${_top}); skipping drains until the treadmill breaks (SwapFree<${FREE_PCT_MAX}% emergency still drains under real pressure, psi>0)"
            printf '%s TREADMILL\n' "$(date -u +%s)" > "$TREADF" 2>/dev/null || true
            write_state "TREADMILL|refilled above floor ${_page}s after ${_plabel} (top VmSwap: ${_top}) — drain skipped, would thrash"
            echo "swap-drain: TREADMILL — skip (top VmSwap: ${_top})" >&2
            return 0 ;;
        esac
      fi
    fi
  fi
  write_state "$verdict"
  case "$label" in
    NA)     echo "swap-drain: n/a — $reason" >&2; return 2 ;;
    REFUSE) echo "swap-drain: REFUSE — $reason" >&2; return 0 ;;   # trace-only (state file), safe wait, NOT an alarm
  esac
  # DRAIN. Passwordless sudo is required to actuate (unless DRYRUN); a node without it is honest-n/a.
  if [ "$DRYRUN" != 1 ] && ! sudo -n true 2>/dev/null; then
    write_state "NA|passwordless sudo unavailable — cannot actuate swapoff (sense-only on this node)"
    echo "swap-drain: n/a — no passwordless sudo (cannot swapoff on this node)" >&2; return 2
  fi
  # single-writer: two drains must never interleave swapoff/swapon
  exec 8>>"$LOCK" 2>/dev/null || true
  if command -v flock >/dev/null 2>&1; then flock -n 8 2>/dev/null || { echo "swap-drain: another drain in progress — skip" >&2; return 0; }; fi
  local before after; before="$(swap_used_mb)"
  command -v mesh-trace >/dev/null 2>&1 && mesh-trace "swap-drain: swapoff -a && swapon -a (repatriate ${before}MB residue; margin verified $reason)" >/dev/null 2>&1 || true
  if ! do_swap swapoff -a; then
    echo "swap-drain: swapoff -a failed — swap UNCHANGED (safe no-op)" >&2
    write_state "REFUSE|swapoff -a failed (busy pages?) — swap unchanged, no harm"; return 0
  fi
  if ! do_swap swapon -a; then
    # CRITICAL: swap is OFF and did not come back. Retry once, then escalate loudly.
    do_swap swapon -a || true
    board "[swap-drain-FAILED] $(hostname) swapon -a FAILED after swapoff — swap may be OFF; MANUAL 'sudo swapon -a' NEEDED"
    write_state "FAILED|swapon -a failed after swapoff — swap may be OFF, operator action needed"
    echo "swap-drain: CRITICAL — swapon -a failed after swapoff; escalated" >&2; return 1
  fi
  after="$(swap_used_mb)"
  printf '%s DRAINED\n' "$(date -u +%s)" > "$TREADF" 2>/dev/null || true   # the treadmill gate's clock
  board "[swap-drained] $(hostname) swap residue reclaimed: SwapUsed ${before}→${after}MB — buffer reset ($reason)"
  write_state "DRAINED|SwapUsed ${before}→${after}MB reclaimed ($reason)"
  echo "swap-drain: DRAINED (SwapUsed ${before}→${after}MB)"
}

do_status(){
  local verdict; verdict="$(live_verdict)"; write_state "$verdict"
  echo "swap-drain status @ $(hostname) $(ts)"
  echo "  verdict: $verdict"
  echo "  live:    $(free -m 2>/dev/null | awk '/Swap:/{printf "Swap used=%sMB free=%sMB total=%sMB",$3,$4,$2} /Mem:/{printf "  MemAvail~%sMB  ",$7}')"
  case "${verdict%%|*}" in NA) return 2 ;; *) return 0 ;; esac
}

case "${1:---status}" in
  --status|"") do_status ;;
  --drain|--sweep) do_drain ;;
  --test)
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    # ---- decide_drain: PURE gate logic, every branch falsified both ways ----
    # ST=4194304 kB (4GB) swap. Fixtures in kB. psi 0 = no stall. busy 0 = free.
    _ST=4194304
    # NA: no swap
    case "$(decide_drain 0 0 8000000 0 0)"        in NA\|*) : ;; *) fail "SwapTotal=0 must be NA";; esac
    case "$(decide_drain '' '' 8000000 0 0)"      in NA\|*) : ;; *) fail "empty SwapTotal must be NA";; esac
    # DRAIN: swap 98% used (SwapFree 80000kB≈2%), MemAvail 7GB >> SwapUsed ~4GB+1.5GB, psi 0, not busy
    case "$(decide_drain $_ST 80000 7340032 0 0)" in DRAIN\|*) : ;; *) fail "full swap + ample RAM + calm + free must DRAIN";; esac
    # REFUSE(stall): same DRAIN inputs but psi full avg300 = 5.0 > 1.0
    case "$(decide_drain $_ST 80000 7340032 5.0 0)" in REFUSE\|memory\ under*) : ;; *) fail "psi stall must REFUSE (never drain under stall)";; esac
    # falsify the stall gate: psi exactly at PSI_MAX (1.0) is NOT a stall → must still DRAIN
    case "$(decide_drain $_ST 80000 7340032 1.0 0)" in DRAIN\|*) : ;; *) fail "psi==PSI_MAX must NOT trip the stall gate (guards the > boundary)";; esac
    # REFUSE(not full): SwapFree 71% (3000000kB) >= FREE_PCT_MAX 15 AND SwapUsed 1166MB < MIN_RESIDUE_MB
    # floor (2048MB) → truly nothing worth reclaiming by EITHER trigger
    case "$(decide_drain $_ST 3000000 7340032 0 0)" in REFUSE\|swap\ not\ full*) : ;; *) fail "swap lightly used (below both pct and floor) must REFUSE (no residue)";; esac
    # REFUSE(margin) — THE LOAD-BEARING gate: full swap, calm, free, but MemAvail 4GB !> SwapUsed ~4GB+1.5GB
    case "$(decide_drain $_ST 80000 4194304 0 0)" in REFUSE\|insufficient\ repatriation*) : ;; *) fail "MemAvail<=SwapUsed+margin must REFUSE (else swapoff OOMs)";; esac
    # falsify the margin gate: give exactly +1kB over (SwapUsed+margin) → must flip to DRAIN
    #   SwapUsed = 4194304-80000 = 4114304 kB; +margin(1572864) = 5687168; MemAvail 5687169 > that → DRAIN
    case "$(decide_drain $_ST 80000 5687169 0 0)" in DRAIN\|*) : ;; *) fail "MemAvail just over SwapUsed+margin must DRAIN (guards the <= boundary)";; esac
    case "$(decide_drain $_ST 80000 5687168 0 0)" in REFUSE\|insufficient*) : ;; *) fail "MemAvail == SwapUsed+margin must still REFUSE (boundary is strict >)";; esac
    # REFUSE(heavy): all gates pass but a heavy job holds the lock
    case "$(decide_drain $_ST 80000 7340032 0 1)" in REFUSE\|a\ heavy*) : ;; *) fail "heavy job in flight must REFUSE";; esac

    # ---- MIN_RESIDUE_MB absolute-floor gate: swapdrain-unsatisfiable-post-swap2 fix ----
    # Not full BY PERCENTAGE (SwapFree 1122304kB ≈ 27% >= 15%) but SwapUsed 3000MB >= floor(2048MB),
    # with a repatriable margin (ma 5000000kB=4883MB > su_kb 3072000+margin_kb 1572864=4644864kB) →
    # the floor alone must make this DRAIN, proving the fix: the OLD pct-only gate would have REFUSEd
    # "not full" here and left a real 3GB residue unreclaimed forever.
    case "$(decide_drain $_ST 1122304 5000000 0 0)" in DRAIN\|*) : ;; *) fail "SwapUsed>=MIN_RESIDUE_MB floor with repatriable margin must DRAIN even when not full by pct";; esac
    # falsify the floor's own boundary: 1MB below it (SwapUsed 2047MB, SwapFree 2098176kB≈50%) must
    # still REFUSE not-full (worth-it is false on BOTH triggers)
    case "$(decide_drain $_ST 2098176 8000000 0 0)" in REFUSE\|swap\ not\ full*) : ;; *) fail "SwapUsed 1MB under MIN_RESIDUE_MB must still REFUSE (floor is a strict < boundary)";; esac
    # exactly AT the floor (SwapUsed 2048MB, SwapFree 2097152kB=50%) must DRAIN (floor is inclusive)
    case "$(decide_drain $_ST 2097152 8000000 0 0)" in DRAIN\|*) : ;; *) fail "SwapUsed == MIN_RESIDUE_MB must DRAIN (floor boundary inclusive)";; esac

    # ---- config-satisfiability assert: check_pct_satisfiable + warn_if_unsatisfiable ----
    # Reproduce the live post-swap2.img config: SwapTotal 8191MB, MemTotal 7496MB. The pct trigger's
    # own crossing point (85% of SwapTotal) plus MARGIN_MB structurally exceeds MemTotal — no live
    # value of MemAvailable (bounded by MemTotal) could ever satisfy gate 3 once gate 1 fires by pct
    # alone. This is the ORIGINAL defect, independent of the MIN_RESIDUE_MB floor added above.
    _ST8191=8387584; _MT7496=7675904   # 8191MB, 7496MB in kB
    case "$(check_pct_satisfiable $_ST8191 $_MT7496)" in UNREACHABLE\|*) : ;; *) fail "post-swap2.img config (8191MB swap / 7496MB RAM) must assert UNREACHABLE";; esac
    # falsify: a modest SwapTotal (4GB) on the same 7496MB RAM stays satisfiable → OK
    case "$(check_pct_satisfiable $_ST $_MT7496)" in OK) : ;; *) fail "4GB swap on 7496MB RAM must be satisfiable (OK)";; esac
    # sweep proof — old %-only trigger (floor disabled) provably NEVER drains under this config, for
    # every SwapUsed at/above its own crossing point, because MemAvailable is capped at MemTotal:
    # su+margin_kb always exceeds MT once su crosses the pct threshold, so the maximal possible
    # MemAvail (== MemTotal) still can't clear gate 3.
    _fl=0
    for _su_mb in 6963 7000 7500 8000 8191; do
      _su_kb=$(( _su_mb * 1024 )); _sf_kb=$(( _ST8191 - _su_kb ))
      [ "$_sf_kb" -lt 0 ] && _sf_kb=0
      _v="$(MIN_RESIDUE_MB=999999 decide_drain $_ST8191 $_sf_kb $_MT7496 0 0)"
      case "$_v" in DRAIN\|*) _fl=1; echo "  (sweep leak: su=${_su_mb}MB unexpectedly DRAINed with floor disabled)";; esac
    done
    [ "$_fl" = 0 ] || fail "pct-only trigger (floor disabled) must NEVER drain on the 8191MB-swap/7496MB-RAM config"
    # warn_if_unsatisfiable rate-limiting: first call for a config boards once, second call (same
    # config) must NOT board again — proves "ONE loud line", not spam every tick.
    _wtd="$(mktemp -d)"; _wcap="$_wtd/board"; mesh-chat(){ printf '%s\n' "$*" >> "$_wcap"; return 0; }
    ( CONFIG_WARN_STATE="$_wtd/warn" warn_if_unsatisfiable "$_ST8191" "$_MT7496" )
    ( CONFIG_WARN_STATE="$_wtd/warn" warn_if_unsatisfiable "$_ST8191" "$_MT7496" )
    [ "$(grep -c '\[swap-drain-unreachable\]' "$_wcap" 2>/dev/null || echo 0)" = 1 ] || fail "warn_if_unsatisfiable must board exactly ONCE per structural verdict, not every call"
    # A SUB-RESOLUTION WOBBLE MUST NOT RE-ARM IT (task {#66dfeb0e}). MemTotal moves a few MB across
    # boots on a real machine; the message this dedups prints MB, so a change the reader cannot even
    # see must not re-fire a once-only STRUCTURAL alarm. Measured live 2026-08-27: two posts from
    # imozerov-IdeaPad-3-15IIL05 an hour apart, identical in every word except MemTotal 7496 -> 7493MB.
    # 3072 kB = 3MB, i.e. it changes the raw reading and NOT the rendered sentence.
    ( CONFIG_WARN_STATE="$_wtd/warn" warn_if_unsatisfiable "$_ST8191" "$(( _MT7496 - 3072 ))" )
    [ "$(grep -c '\[swap-drain-unreachable\]' "$_wcap" 2>/dev/null || echo 0)" = 1 ] \
      || fail "a 3MB MemTotal wobble re-armed the once-only structural warning — the dedup key is finer than the message it dedups ($(tr '\n' '|' < "$_wcap"))"
    # ...and it must NOT go blanket: a genuinely DIFFERENT structural situation still speaks. DOUBLE
    # the swap — chosen because it keeps the verdict UNREACHABLE (halving it makes the config
    # SATISFIABLE, so there is no second post to count and the arm would pass for the wrong reason).
    ( CONFIG_WARN_STATE="$_wtd/warn" warn_if_unsatisfiable "$(( _ST8191 * 2 ))" "$_MT7496" )
    [ "$(grep -c '\[swap-drain-unreachable\]' "$_wcap" 2>/dev/null || echo 0)" = 2 ] \
      || fail "a REAL config change (double the swap) did not re-arm the warning — the dedup is now coarser than the reader's own response ($(tr '\n' '|' < "$_wcap"))"
    unset -f mesh-chat; rm -rf "$_wtd"

    # ---- heavy_busy: real non-blocking flock probe (not just the env inject) ----
    _lk="$(mktemp)"; ( exec 9>>"$_lk"; flock 9; sleep 3 ) &   # hold the lock 3s in the background
    _bgpid=$!; sleep 0.4
    # override the GLOBALS heavy_busy reads (the top-level MESH_SWAPDRAIN_* assignment already ran)
    HEAVY_LOCK="$_lk" WHISPER_LOCK="$_lk" heavy_busy \
      || { kill "$_bgpid" 2>/dev/null; rm -f "$_lk"; fail "heavy_busy must see a HELD flock as busy"; }
    wait "$_bgpid" 2>/dev/null
    HEAVY_LOCK="$_lk" WHISPER_LOCK="$_lk" heavy_busy \
      && { rm -f "$_lk"; fail "heavy_busy must see a FREE flock as not-busy"; }
    rm -f "$_lk"

    # ---- do_drain actuation path (DRYRUN — never a real swapoff): a DRAIN verdict must call
    #      swapoff+swapon (dry) and post [swap-drained]; a REFUSE must NOT actuate. Inject via fixtures.
    _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
    # ---- THE `# reflex-state:` DECLARATION, checked against the live default. It is what gives this
    # reflex a liveness ROW at all: mesh-reflex-health derives its table from cadence AND state
    # TOGETHER, and a cadence alone is not derived — which is why this tool had no row anywhere until
    # 2026-08-29. Rename the state file and the header keeps naming the old one, forever, with no
    # error anywhere: the watcher then ages a file nobody writes and reports a permanent false-STALE.
    _hs="$(sed -n 's/^# reflex-state:[[:space:]]*//p' "${BASH_SOURCE[0]}" | head -n1)"
    _hv="$(sed -n 's/^# reflex-verdict-field:[[:space:]]*//p' "${BASH_SOURCE[0]}" | head -n1)"
    [ -n "$_hs" ] || fail "no '# reflex-state:' declaration — mesh-reflex-health derives NO ROW for a tool that declares only a cadence, so nothing anywhere would age this reflex"
    [ -n "$_hv" ] || fail "no '# reflex-verdict-field:' declaration — this state line leads with a clock, so BOTH freeze axes read green forever"
    [ -z "${MESH_SWAPDRAIN_STATE:-}" ] \
      || fail "MESH_SWAPDRAIN_STATE is set in the --test environment: \$STATE is then an override, not the default the header declares, and this arm would pass vacuously"
    [ "$(eval "printf '%s' \"$_hs\"" 2>/dev/null)" = "$STATE" ] \
      || fail "'# reflex-state:' declares '$(eval "printf '%s' \"$_hs\"" 2>/dev/null)' but this tool writes '$STATE' — the watcher would age a file nobody writes, forever, with no error anywhere"
    [ "$_hv" = 2 ] || fail "the arms below read field 2 as the verdict column but the header declares field $_hv — two readers of one row disagreeing about which field is the verdict is exactly the lint-vs-parser trap"
    _cap="$_td/board"; mesh-chat(){ printf '%s\n' "$*" >> "$_cap"; return 0; }
    _drainmi="$_td/mi-drain"; _refusemi="$_td/mi-refuse"
    printf 'MemAvailable: 7340032 kB\nSwapTotal: 4194304 kB\nSwapFree: 80000 kB\n' > "$_drainmi"   # DRAIN inputs
    printf 'MemAvailable: 4194304 kB\nSwapTotal: 4194304 kB\nSwapFree: 80000 kB\n' > "$_refusemi"  # margin REFUSE
    printf 'full avg10=0.00 avg60=0.00 avg300=0.00 total=1\n' > "$_td/psi"
    _stf="$_td/state"
    # DRAIN: DRYRUN so do_swap only echoes; heavy free; must post [swap-drained] + write DRAINED state.
    # TREADF is sandboxed: a fixture drain must never stamp the LIVE treadmill breadcrumb (a test that
    # writes a live artifact forges the evidence it checks) nor read it (a real drain <2h ago would
    # flip this fixture to TREADMILL and flake the assert).
    ( DRYRUN=1 MEMINFO="$_drainmi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk" TREADF="$_td/tread0" \
      MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain >/dev/null 2>&1 )
    grep -q '\[swap-drained\]' "$_cap" || fail "a DRAIN verdict must post [swap-drained] (DRYRUN)"
    grep -qE '^[0-9T:Z-]+ DRAINED \| ' "$_stf" || fail "a DRAIN must record DRAINED in the state file"
    # THE DECLARED COLUMN, asserted as a column. `# reflex-verdict-field: 2` up top is a promise to
    # mesh-reflex-health about THIS file's shape, and nothing outside this suite can check it: a
    # reformat of write_state would leave the header pointing at whatever now sits in field 2 and the
    # watcher would digest that forever without erroring. awk splits on whitespace exactly as
    # mesh-reflex-health's ow_label does.
    [ "$(awk '{print $2}' "$_stf")" = DRAINED ] \
      || fail "field 2 of the state line MUST be the bare verdict word — that is the column '# reflex-verdict-field: 2' declares to mesh-reflex-health (got '$(awk '{print $2}' "$_stf")')"
    : > "$_cap"
    # REFUSE(margin): must NOT actuate, must NOT post, state records REFUSE
    ( DRYRUN=1 MEMINFO="$_refusemi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk2" TREADF="$_td/tread0" \
      MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain >/dev/null 2>&1 )
    [ -s "$_cap" ] && fail "a REFUSE verdict must NOT post any board edge"
    # THE REASON, asserted WITHOUT quoting the separator: a `REFUSE | insufficient` literal here would
    # also gate the verdict/reason split, and then the column arms below could never be reached by a
    # mutant that fuses the two — a red on an earlier arm is not a red on this one.
    grep -q 'insufficient repatriation margin' "$_stf" || fail "a REFUSE must record the refusal reason in the state file"
    # …the declared column must NOT move when only the REASON does. This is why field 3 of the OLD
    # shape was refused as the declaration target: `REFUSE|swap` -> `REFUSE|insufficient` is one
    # verdict wearing two labels, and a label that moves on a reason change resets the frozen clock —
    # a reset toward silence, which is the one direction a freeze watcher must never fail in.
    _v1="$(awk '{print $2}' "$_stf")"; _r1="$(cut -d'|' -f2- < "$_stf")"
    printf 'full avg10=0.00 avg60=0.00 avg300=9.00 total=1\n' > "$_td/psi-stall"   # a DIFFERENT refusal gate
    ( DRYRUN=1 MEMINFO="$_refusemi" PSI="$_td/psi-stall" STATE="$_stf" LOCK="$_td/lkvf" TREADF="$_td/tread0" \
      MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain >/dev/null 2>&1 )
    grep -q 'memory under active stall' "$_stf" \
      || fail "the psi-stall fixture must produce a SECOND, different REFUSE reason — without that this arm compares a reading to itself and can never discriminate"
    [ "$(cut -d'|' -f2- < "$_stf")" != "$_r1" ] \
      || fail "the two REFUSE readings carry the same reason — the arm cannot see a reason-driven reset"
    [ "$(awk '{print $2}' "$_stf")" = "$_v1" ] \
      || fail "the declared verdict column moved between two REFUSE readings with DIFFERENT reasons ('$_v1' -> '$(awk '{print $2}' "$_stf")') — the column is digesting the reason, not the verdict, and every reason change would reset the frozen clock"
    [ "$_v1" = REFUSE ] \
      || fail "field 2 must be the bare verdict word on a REFUSE too (got '$_v1') — the reason belongs after the separator, never fused into the declared column"
    unset -f mesh-chat

    # ---- TREADMILL: consecutive-DRAINED awareness (chat-review/swap-drain-treadmill-detection) ----
    # Live 2026-07-16: hourly DRAINED 21:17+22:17 back-to-back, swap back at 1558MB by 22:43 — all of
    # it a warm model the kernel re-evicts after every forced re-ingest; the drain WAS the thrash.
    # prior=DRAINED within the window + above-floor again via the FLOOR trigger (not pct-emergency)
    # must SKIP the drain (no swapoff, even DRYRUN-echoed), post ONE [swap-treadmill] naming the
    # top-VmSwap process, and renew the breadcrumb; TREADMILL→TREADMILL must not re-post; fresh or
    # aged-out state must still DRAIN; pct-emergency must drain THROUGH a treadmill.
    _cap2="$_td/board2"; mesh-chat(){ printf '%s\n' "$*" >> "$_cap2"; return 0; }
    _floormi="$_td/mi-floor"   # SwapUsed 3000MB >= floor, SwapFree 27% >= 15% (not emergency), margin OK
    printf 'MemAvailable: 7340032 kB\nSwapTotal: 4194304 kB\nSwapFree: 1122304 kB\n' > "$_floormi"
    mkdir -p "$_td/proc/101" "$_td/proc/202"
    printf 'Name:\tgigaam-fixture\nPid:\t101\nVmSwap:\t1567744 kB\n' > "$_td/proc/101/status"
    printf 'Name:\tsmallfry\nPid:\t202\nVmSwap:\t8192 kB\n'          > "$_td/proc/202/status"
    _tf="$_td/tread"; printf '%s DRAINED\n' "$(( $(date -u +%s) - 3600 ))" > "$_tf"  # drained 1 cadence ago
    _out="$(DRYRUN=1 MEMINFO="$_floormi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk3" TREADF="$_tf" \
            PROCDIR="$_td/proc" MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain 2>&1)"
    case "$_out" in *"DRYRUN sudo swapoff"*) fail "prior-DRAINED + above-floor-again must SKIP the drain (treadmill), not swapoff";; esac
    grep -q '\[swap-treadmill\]' "$_cap2" || fail "a treadmill must post ONE [swap-treadmill] board line"
    grep -q 'gigaam-fixture' "$_cap2"     || fail "the [swap-treadmill] line must name the top-VmSwap process"
    grep -q 'TREADMILL | ' "$_stf"        || fail "a treadmill skip must record TREADMILL in the state file"
    grep -q ' TREADMILL$' "$_tf"          || fail "a treadmill skip must renew the breadcrumb to TREADMILL"
    # TREADMILL→TREADMILL: keep skipping, but NO re-post (one loud line per treadmill, not per tick)
    : > "$_cap2"
    _out="$(DRYRUN=1 MEMINFO="$_floormi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk3" TREADF="$_tf" \
            PROCDIR="$_td/proc" MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain 2>&1)"
    case "$_out" in *"DRYRUN sudo swapoff"*) fail "an ongoing treadmill must keep skipping";; esac
    [ -s "$_cap2" ] && fail "TREADMILL→TREADMILL must NOT re-post the board line every tick"
    # fresh state (no breadcrumb) + above-floor: first-time drain unchanged, and it stamps DRAINED
    : > "$_cap2"; rm -f "$_tf"
    _out="$(DRYRUN=1 MEMINFO="$_floormi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk4" TREADF="$_tf" \
            PROCDIR="$_td/proc" MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain 2>&1)"
    case "$_out" in *"DRYRUN sudo swapoff"*) : ;; *) fail "fresh state + above-floor must still DRAIN";; esac
    grep -q '\[swap-drained\]' "$_cap2" || fail "a fresh drain must still post [swap-drained]"
    grep -q ' DRAINED$' "$_tf"          || fail "a real drain must stamp the DRAINED breadcrumb"
    # aged-out breadcrumb (3h > window) + above-floor: not a treadmill, must DRAIN
    : > "$_cap2"; printf '%s DRAINED\n' "$(( $(date -u +%s) - 10800 ))" > "$_tf"
    _out="$(DRYRUN=1 MEMINFO="$_floormi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk5" TREADF="$_tf" \
            PROCDIR="$_td/proc" MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain 2>&1)"
    case "$_out" in *"DRYRUN sudo swapoff"*) : ;; *) fail "a breadcrumb older than the window must still DRAIN (treadmill broke)";; esac
    # pct-EMERGENCY under a treadmill, CALM (chat-review/swap-drain-emergency-treadmill-bypass):
    # SwapFree 2% < 15% BUT psi 0.00 and MemAvail 7GB — a near-full swap is COSMETIC while RAM has
    # headroom (the parked pages are cold; RAM headroom IS the spike buffer). The old unconditional
    # bypass re-drained hourly straight through an announced treadmill (live 2026-07-20: 16:17Z
    # [swap-treadmill], then 17:17:40Z [swap-drained] at SwapFree 12%, psi 0.00, MemAvail 14049MB —
    # the drain forcing a warm process's 1.5GB back onto the re-ingest/re-evict wheel every hour).
    # A CALM pct-emergency must now SKIP like any other treadmill tick.
    : > "$_cap2"; printf '%s DRAINED\n' "$(( $(date -u +%s) - 3600 ))" > "$_tf"
    _out="$(DRYRUN=1 MEMINFO="$_drainmi" PSI="$_td/psi" STATE="$_stf" LOCK="$_td/lk6" TREADF="$_tf" \
            PROCDIR="$_td/proc" MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain 2>&1)"
    case "$_out" in *"DRYRUN sudo swapoff"*) fail "a CALM pct-emergency (psi 0, ample MemAvail) must SKIP through a treadmill, not drain hourly";; esac
    grep -q 'TREADMILL | ' "$_stf" || fail "a calm-emergency treadmill skip must record TREADMILL in the state file"
    # …but REAL pressure still bypasses: psi 0.5 (>0 yet <= PSI_MAX, so the verdict stays DRAIN) +
    # the same emergency + fresh treadmill → drains THROUGH (the emergency lane survives, gated on
    # pressure). The MemAvail<SwapUsed+margin half of "real pressure" needs no leg of its own: that
    # region is gate 3's REFUSE — no DRAIN verdict can exist inside it (asserted at the margin
    # boundary cases above), so psi is the only pressure signal reachable here.
    printf 'full avg10=0.00 avg60=0.00 avg300=0.50 total=1\n' > "$_td/psi-pressure"
    : > "$_cap2"; printf '%s DRAINED\n' "$(( $(date -u +%s) - 3600 ))" > "$_tf"
    _out="$(DRYRUN=1 MEMINFO="$_drainmi" PSI="$_td/psi-pressure" STATE="$_stf" LOCK="$_td/lk7" TREADF="$_tf" \
            PROCDIR="$_td/proc" MESH_SWAPDRAIN_HEAVY_BUSY=0 do_drain 2>&1)"
    case "$_out" in *"DRYRUN sudo swapoff"*) : ;; *) fail "a pct-emergency under REAL pressure (psi>0) must still drain THROUGH a treadmill";; esac
    unset -f mesh-chat

    # ---- REAL-READ GATE: live /proc must yield a real verdict, or honest n/a exit 2 if no swap ----
    _st="$(read_meminfo_kb SwapTotal)"
    if [ -z "$_st" ] || [ "$_st" = 0 ]; then
      echo "smoke-test: n/a (no swap configured on this host — actuator not applicable); gate logic ok"; exit 2
    fi
    _lv="$(live_verdict)"
    case "$_lv" in DRAIN\|*|REFUSE\|*|NA\|*) : ;; *) fail "live verdict malformed: '$_lv'";; esac
    echo "smoke-test: ok (decide gate 10 cases both-ways + real flock heavy_busy + do_drain DRYRUN drain/refuse + treadmill skip/renew/fresh/aged/emergency asserts + live verdict: $_lv)"
    exit 0 ;;
  *) echo "usage: mesh-swap-drain [--status] | --drain | --sweep | --test" >&2; exit 64 ;;
esac
