#!/usr/bin/env python3
"""test-overhear-classifier — verifiable artifact for mesh-overhear's audio classifier.

Synthesizes wavs with KNOWN acoustic features (no mic, no whisper) and asserts the
4-state verdict from `mesh-overhear --classify-wav`. The bug being fixed (operator
2026-06-24, "Misha hears music everywhere"): steady ambient hum tripped the old
qf<0.10 -> 'sound' bucket and got labeled 'музыка'. The retuned classifier must read
ambient hum (quiet OR broadband) as `ambient`/`silence`, and only call it `music`
when it's actually tonal+loud+continuous.

Exit 0 = all assertions passed. Exit 1 = one or more failed (prints which).
"""
import subprocess, sys, wave, struct, math, os, tempfile, random

import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes — and the signal is routine here, not hypothetical:
# GNU `timeout` without --foreground signals the whole PROCESS GROUP, which is how mesh-doctor's
# hourly --test sweep reaches this process. sys.exit() from a handler raises SystemExit in the MAIN
# THREAD, and that is what makes try/finally unwind. SIGKILL stays uncatchable — that half is
# mesh-tmp-guard's age sweep, never this. Class + population: mesh-tmp-guard --unwind-scan.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))


TOOL = os.path.expanduser("~/.local/bin/mesh-overhear")
RATE = 16000

# ── wav generators (s16 mono) ─────────────────────────────────────────────────

def write_wav(path, samples):
    with wave.open(path, "wb") as wf:
        wf.setnchannels(1); wf.setsampwidth(2); wf.setframerate(RATE)
        wf.writeframes(struct.pack(f"<{len(samples)}h", *samples))

def clamp(s):
    return max(-32768, min(32767, int(s)))

def silence(dur=3.0):
    return [0] * int(dur * RATE)

def white_noise(dur, rms, seed=42):
    """Broadband Gaussian noise at target RMS — flat spectrum (high flatness)."""
    rng = random.Random(seed); n = int(dur * RATE)
    return [clamp(rng.gauss(0, rms)) for _ in range(n)]

def harmonic_stack(dur, freqs, rms):
    """Sum of equal-amplitude sines — concentrated spectrum (low flatness = tonal)."""
    n = int(dur * RATE); amp = rms / math.sqrt(len(freqs) / 2.0)
    return [clamp(sum(amp * math.sin(2 * math.pi * f * i / RATE) for f in freqs))
            for i in range(n)]

def bursty_tone(dur, freq, rms, on_ms=250, off_ms=250):
    """Tone bursts with gaps — intermittent energy (speech-like)."""
    n = int(dur * RATE); amp = rms * math.sqrt(2)
    on = int(on_ms / 1000 * RATE); off = int(off_ms / 1000 * RATE)
    out = []
    i = 0
    while i < n:
        for j in range(on):
            if i >= n: break
            out.append(clamp(amp * math.sin(2 * math.pi * freq * i / RATE))); i += 1
        for j in range(off):
            if i >= n: break
            out.append(0); i += 1
    return out

# ── runner ────────────────────────────────────────────────────────────────────

def classify(path):
    r = subprocess.run([TOOL, "--classify-wav", path], capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        return f"<err rc={r.returncode}: {r.stderr.strip()}>"
    return r.stdout.strip()

passed = failed = 0

def expect(name, wav_samples, want):
    global passed, failed
    # the temp file is minted INSIDE the try, not before it: a with-statement arms its cleanup only
    # once __enter__ has RETURNED, so a TERM landing in the create-then-try gap strands the file
    # with the finally not yet reachable. Measured, not reasoned — a 6-delay process-group SIGTERM
    # sweep stranded 5 wavs with the handler armed and the creation still outside.
    path = None
    try:
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
            path = tf.name
        write_wav(path, wav_samples)
        got = classify(path)
        ok = got == want
        print(f"  [{'PASS' if ok else 'FAIL'}] {name}: want={want} got={got}")
        if ok: passed += 1
        else: failed += 1
    finally:
        if path:
            try: os.unlink(path)
            except OSError: pass

print("=== mesh-overhear audio-classifier suite (Misha music false-positive fix) ===\n")

print("Regression — ambient hum must NOT read as music/sound:")
# THE BUG: quiet steady hum (RMS 700, below AMB_LEVEL=1000) → was 'sound' → 'музыка'.
expect("quiet HVAC hum (rms~700, continuous)",
       white_noise(3.0, rms=700), "ambient")
# Loud broadband noise: still NOT music (flatness high → ambient), even though loud.
expect("loud white noise (rms~3000, continuous)",
       white_noise(3.0, rms=3000), "ambient")
# Fridge compressor: tonal BUT low-level → level gate catches it → ambient.
expect("fridge compressor (100Hz tone, rms~700)",
       harmonic_stack(3.0, [100], rms=700), "ambient")
# Near-silence: almost nothing above onset → silence.
expect("near-silent noise floor (rms~50)",
       white_noise(3.0, rms=50), "silence")

print("\nReal music — tonal + loud + continuous → music:")
expect("harmonic stack (A4+A5+octaves, rms~5000)",
       harmonic_stack(3.0, [440, 880, 1320, 1760], rms=5000), "music")

print("\nSpeech — intermittent energy with pauses → speech-like:")
expect("tone bursts (440Hz, 250ms on/off)",
       bursty_tone(3.0, 440, rms=4000), "speech-like")

print("\nTrue silence:")
expect("all-zero wav", silence(3.0), "silence")

print(f"\n=== {passed} passed, {failed} failed ===")
sys.exit(0 if failed == 0 else 1)
