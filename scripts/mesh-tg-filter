#!/usr/bin/env bash
# mesh-tg-filter — reads a ~/.mesh/voice-in.log line on stdin; if it's an operator TEXT/VOICE message,
# emits it framed as a prompt for the channel's mind; else emits nothing (skip). The CONDITION + SHAPING.
# The frame carries an EXPLICIT reply directive: the mind that receives this MUST answer the operator
# over Telegram (mesh-tg) — without it the mind treats the line as passive context and stays silent,
# which is exactly the "you never reply in TG" failure. Mirrors mesh-roz-channel's reply instruction.
# Extract just the operator's message text. The stamp class MUST allow the FULL ISO-8601 form
# voice-rx actually writes — `2026-06-17T12:36:26Z` (date + `T`), NOT only a time-only `12:36:26Z`.
# The old `[0-9:]+Z` matched ONLY time-only stamps, so EVERY real voice-in.log line failed to match
# → mesh-tg-filter emitted nothing → channel-tg injected nothing → the operator's messages never
# reached the mind ("i have to ping you on each tg message", 2026-06-17). The --test passed anyway
# because it fed a fake `12:34:56Z` stamp — test-vs-reality drift. `[0-9T:-]+Z` matches BOTH forms.
RX='s/^[0-9T:-]+Z[[:space:]]+(TEXT|VOICE)[[:space:]]+(.*)$/\2/p'

frame() {   # $1 = message text -> the reply-instructed prompt
  cat <<EOF
operator (Telegram): $1

^ This is a LIVE message from the operator over Telegram and it REQUIRES a reply. Answer them NOW,
in the same language they used. Operator preference (2026-06-17): reply by VOICE, always duplicated
as text. Run:  mesh-voice-tx "your reply here"
  (mesh-voice-tx sends a voice note AND the same text to the operator's Telegram in one call —
   the format they asked for. Fallback to  mesh-tg "your reply here"  only if voice synthesis fails.)
Replying only in this pane is INVISIBLE to them — you must send via one of those tools.
EOF
}

if [ "${1:-}" = --test ]; then
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  # golden lines through the PRODUCTION path — assert BEHAVIOR: the operator's message text is
  # carried AND the mesh-tg reply directive is present (a regression on either silently breaks the
  # operator's only reply channel), and non-operator lines emit nothing.
  # CRITICAL: the golden stamp is the FULL ISO-8601 form voice-rx actually writes (2026-...T...Z).
  # Testing only a time-only stamp is what hid the regex bug that dropped every real message.
  out=$(printf '2026-06-17T12:34:56Z  TEXT  hello world\n' | "$0")
  printf '%s' "$out" | grep -q 'operator (Telegram): hello world' || { echo "smoke-test: FAIL (full-ISO TEXT dropped — the real-format regression: '$out')"; exit 1; }
  printf '%s' "$out" | grep -q 'mesh-voice-tx "your reply here"' || { echo "smoke-test: FAIL (TEXT missing voice reply directive)"; exit 1; }
  printf '%s' "$out" | grep -q 'mesh-tg "your reply here"' || { echo "smoke-test: FAIL (TEXT missing text-fallback directive)"; exit 1; }
  out=$(printf '2026-06-17T12:34:56Z  VOICE  do the thing\n' | "$0")
  printf '%s' "$out" | grep -q 'operator (Telegram): do the thing' || { echo "smoke-test: FAIL (full-ISO VOICE dropped: '$out')"; exit 1; }
  printf '%s' "$out" | grep -q 'mesh-tg ' || { echo "smoke-test: FAIL (VOICE missing reply directive)"; exit 1; }
  # back-compat: a legacy time-only stamp must still work
  printf '12:34:56Z  TEXT  legacy stamp\n' | "$0" | grep -q 'operator (Telegram): legacy stamp' || { echo "smoke-test: FAIL (legacy time-only stamp dropped)"; exit 1; }
  out=$(printf '2026-06-17T12:34:56Z  SENT  ack\nnot a log line\n' | "$0")
  [ -z "$out" ] || { echo "smoke-test: FAIL (non-operator line leaked: '$out')"; exit 1; }
  # /mesh-tv suppression (double-cast fix): a /mesh-tv line the mesh-url-watch reflex handles must
  # NOT reach the mind — else the mind casts the same URL again and restarts the video. Assert the
  # URL form and the control-verb form emit NOTHING, while a bare /mesh-tv (reflex can't act) DOES
  # still reach the mind. These FAIL if the suppression is removed or scoped wrong.
  out=$(printf '2026-07-17T11:33:08Z  TEXT  /mesh-tv https://youtu.be/ruJFGGSArEk\n' | "$0")
  [ -z "$out" ] || { echo "smoke-test: FAIL (/mesh-tv URL reached the mind — double-cast/restart hazard: '$out')"; exit 1; }
  out=$(printf '2026-07-17T11:33:08Z  TEXT  /mesh-tv pause\n' | "$0")
  [ -z "$out" ] || { echo "smoke-test: FAIL (/mesh-tv control verb reached the mind: '$out')"; exit 1; }
  out=$(printf '2026-07-17T11:33:08Z  TEXT  /mesh-tv what can you play\n' | "$0")
  printf '%s' "$out" | grep -q 'operator (Telegram): /mesh-tv what can you play' || { echo "smoke-test: FAIL (bare /mesh-tv with no URL/verb was wrongly suppressed — the mind should still answer)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

msg="$(sed -nE "$RX")"
[ -z "${msg//[[:space:]]/}" ] && exit 0   # not an operator message -> skip (emit nothing)

# /mesh-tv command → handled LLM-free by the mesh-url-watch reflex (casts to the Bravia via
# mesh-tv-dlna, cron * * * * *). Suppress it from the mind so the mind never ALSO casts the same
# URL — the DOUBLE-CAST that restarts the operator's video (operator 2026-07-17: reflex fired at
# 11:33:08Z, the woken mind cast the identical URL again → "рестарт был видео"; his ask: run the
# reflex WITHOUT waking a mind). Suppress ONLY the forms the reflex actually ACTS on — mirroring
# mesh-url-watch's trigger: a pause/resume/stop/play verb, OR a /mesh-tv line carrying an http URL.
# A bare/garbled /mesh-tv (no URL, no verb) is NOT suppressed → it still reaches the mind so the
# mind can answer instead of the message silently vanishing.
if printf '%s' "$msg" | grep -qiE '/mesh-?tv[[:space:]]+(pause|resume|stop|play)\b' \
   || { printf '%s' "$msg" | grep -qiE '/mesh-?tv' && printf '%s' "$msg" | grep -qiE 'https?://'; }; then
  exit 0
fi

frame "$msg"
