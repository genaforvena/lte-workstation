#!/usr/bin/env bash
# mesh-tg-filter — reads a ~/.mesh/voice-in.log line on stdin; if it's an operator TEXT/VOICE message,
# emits it framed as a prompt for the channel's mind; else emits nothing (skip). The CONDITION + SHAPING.
RX='s/^[0-9:]+Z  (TEXT|VOICE)  (.*)$/operator (Telegram): \2/p'

if [ "${1:-}" = --test ]; then
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  # golden lines through the PRODUCTION regex — a regex regression silently drops the
  # operator's Telegram channel, so the smoke must assert behavior, not just deps
  out=$(printf '12:34:56Z  TEXT  hello world\n' | sed -nE "$RX")
  [ "$out" = "operator (Telegram): hello world" ] || { echo "smoke-test: FAIL (TEXT not framed: '$out')"; exit 1; }
  out=$(printf '12:34:56Z  VOICE  do the thing\n' | sed -nE "$RX")
  [ "$out" = "operator (Telegram): do the thing" ] || { echo "smoke-test: FAIL (VOICE not framed: '$out')"; exit 1; }
  out=$(printf '12:34:56Z  SENT  ack\nnot a log line\n' | sed -nE "$RX")
  [ -z "$out" ] || { echo "smoke-test: FAIL (non-operator line leaked: '$out')"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

sed -nE "$RX"
