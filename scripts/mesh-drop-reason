#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# mesh-drop-reason — the NETDEV DROP-ATTRIBUTION sense: the kernel names WHY and WHERE every
# dropped frame died (`skb:kfree_skb`, tracefs, root).
#
# THE AXIS NOBODY WAS READING. Before this, the whole mesh's drop signal was `ethtool -S` —
# `rx_dropped: 90`, ONE CUMULATIVE INTEGER with no reason, no site and no window. It cannot be
# decomposed. `skb:kfree_skb` carries three fields nothing here read: `reason` (a named enum),
# `location` (the kernel symbol that dropped the frame, %pS) and `protocol`. On mesh-home,
# 2026-08-22, a 10s capture found 162 drops of which 81 were `ieee80211_iface_work [mac80211]` —
# HALF the node's drop rate on the sole RTL8822BU uplink that has been wedging since 2026-08-11,
# plus a NEIGH_FAILED + arp_error_report ARP-failure family. That is the attribution
# `mesh-link-heal` did not have when it rendered n/a for all 55 minutes of the 2026-08-17 outage.
# prior art: `mesh-prior-art kfree_skb` = CLEAN (NOT the-sole-uplinks-queue-is-invisible-above-usb,
# which is BELOW the netdev; NOT urb-balance; NOT tracefs-exempt-from-lockdown, which only
# establishes tracefs is reachable).
# filing: ~/.mesh/knowledge/capability-kfree-skb-drop-reason-tracepoint-...-mesh-home-20260822.md
#
# ---- MECHANISM: a standing IN-KERNEL ACCUMULATOR, not a 10-second peek -------------------
# A sense whose window is narrower than its cadence reports a SAMPLE, not a state
# (a-senses-coverage-is-window-over-cadence). A 10s capture on a 10min cadence is 1.6% coverage.
# So the default mode ARMS A HIST TRIGGER AND LEAVES IT ARMED:
#     hist:keys=location.sym,reason:vals=hitcount
# The hitcounts are a monotonic accumulator; each run DELTAS them against the previous sample, so
# the reading covers 100% of the interval no matter what the cadence is. Two consequences that are
# the whole reason to prefer this over `cat trace`:
#   * `tracing_on=0` — MEASURED: the hist keeps counting with the ring buffer switched off (42 -> 65
#     hits across a 5s window with tracing_on=0). No trace records are written at all, so the
#     ring-buffer `overrun` loss channel that a `cat trace` sense must read STRUCTURALLY CANNOT
#     OCCUR here. It is not that we check overrun and find it zero; there is no buffer path.
#   * the hist's own loss channel is the hashmap filling (`size=2048`). That IS read and published
#     as `dropped=` — a sense that publishes neither is reporting its instrument, not the drops.
# Instance-scoped (`instances/<name>`) so global tracing and any other tracer on the node are
# untouched; enabling on the top-level `tracing/` dir would collide with them.
#
# ---- WHAT THE READING SAYS ---------------------------------------------------------------
#   link=   mac80211 + neigh/arp drops per second — the UPLINK-FAULT family, and the ranked axis
#   total=  every drop site per second, including the local-socket noise floor
#   family= mac80211 / neigh-arp / l3-l4 / socket / driver / other
#   top=    the location histogram, which is the axis that carries the information (see trap 1)
#
# Verdict, ranked against THIS NODE'S OWN corpus (~/.mesh/drop-reason.log), never a constant
# (calibrate-a-derived-axis-against-the-live-corpus):
#   quiet     — no drops in the interval
#   normal    — link rate at or below the corpus p90
#   elevated  — link rate above the corpus p90 AND above 2x the corpus median (exit 1)
#   unranked  — fewer than MIN_CORPUS accum samples OF THE CURRENT AXIS STRUCTURE on the ledger.
#               A row is only comparable to rows produced by the same causal structure, so every
#               row carries `struct=` (a hash of the functions that DEFINE the ranked axis) and
#               the corpus admits only its own. corpus_retired= names how many rows an axis edit
#               put out of comparison — so a structure change never renders as a young node.
#               (CSH 2.0 Boundary III, Goede & Goede 2025 — see the axis_struct block.)
#               The VALUE is still published;
#               what is withheld is the RANK. A fallback that cannot read the corpus must not
#               carry a constant and must not go blind either.
#   baseline  — first sample, or a re-arm/reboot reset the accumulator: no delta exists yet
#
# ---- THE TRAPS, all of them load-bearing --------------------------------------------------
# 1. THE `reason` ENUM IS NEARLY RAILED — 83% NOT_SPECIFIED on the founding capture. A sense that
#    ranks or alarms on `reason` measures almost nothing. LOCATION is the discriminating axis, and
#    it is the axis this tool ranks and families on; reason is kept as a secondary label.
#    (a-drop-reason-enum-is-railed-the-location-symbol-carries-the-signal.)
# 2. `reason` IS NOT ALWAYS A NAME, AND NOT ONLY BECAUSE OF 0/1. The filing's trap was that the
#    __print_symbolic table starts at 2, so reasons 0 and 1 render as bare integers and a `[A-Z_]+`
#    parser eats them silently. Measured here, the trap is WIDER: the upper 16 bits are a SUBSYSTEM
#    id (include/net/dropreason.h, SKB_DROP_REASON_SUBSYS_SHIFT=16), so a mac80211 drop arrives as
#    `reason: 65540` = 0x10004 = MAC80211_UNUSABLE sub-reason 4 — also a bare integer, also eaten,
#    and it is precisely the wifi family this node cares about. This tool therefore keys the hist on
#    the RAW INTEGER (never on __print_symbolic output), decodes the subsystem itself, and looks the
#    core names up from the running kernel's OWN format file — never a hardcoded 94-name table,
#    which is kernel-version-specific. A sub-reason whose name the kernel does not export (every
#    non-core subsystem: mac80211's drop.h is not in the headers package) is rendered
#    `MAC80211_UNUSABLE:4`, an honest ordinal, never a guessed name.
# 3. A COUNT WITH NO WINDOW IS NOT A RATE. Every published figure carries `interval=` and every
#    ledger row carries the window it was measured over (a-one-event-window-rate-is-the-window-itself).
# 4. THE TRACEPOINT NAMES THE CODE SITE, NOT THE DEVICE. kfree_skb has no ifindex. On a node with
#    exactly one wifi netdev the mac80211 family IS that interface; with two or more it is NOT
#    separable, and the reading publishes `dev-ambiguous=yes` so nobody reads a per-uplink claim out
#    of a node-wide number.
# 5. A GLOB IN A PRIVILEGED READ EXPANDS IN THE UNPRIVILEGED SHELL. Every tracefs path here is
#    globbed INSIDE `sudo sh -c`, never outside it.
#
# Exit 2 (honest n/a, never a fake quiet): tracefs absent, skb:kfree_skb absent, or no passwordless
#   root. mesh-land treats exit 2 as a pass and mesh-autowire SKIPs the reflex, so this stays off
#   every node that cannot produce the artifact — by the ARTIFACT, not by a node name.
# Exit 3 (BLIND — a DIFFERENT claim than exit 2): armed, but the hist could not be read or its
#   hashmap overflowed (dropped>0), so the counts under-report by an unknown amount.
# Exit 1: the link-fault family is ELEVATED against this node's own corpus.
#
# Usage:
#   mesh-drop-reason              accumulator read (arms on first run), delta over the interval
#   mesh-drop-reason --window N   on-demand: a FRESH N-second sample; marked mode=window, no ledger
#   mesh-drop-reason --raw        machine-readable key=value fields
#   mesh-drop-reason --disarm     remove the trigger and the instance
#   mesh-drop-reason --test       fixture gates (both directions) + a real hardware read

set -uo pipefail

TRACEFS="${MESH_DROP_TRACEFS:-/sys/kernel/tracing}"
INSTANCE="${MESH_DROP_INSTANCE:-meshdrop}"
STATE="${MESH_DROP_STATE:-$HOME/.mesh/.drop-reason-state}"
LEDGER="${MESH_DROP_LEDGER:-$HOME/.mesh/drop-reason.log}"
BOOTID_FILE="${MESH_DROP_BOOTID:-/proc/sys/kernel/random/boot_id}"
TRIG='hist:keys=location.sym,reason:vals=hitcount'
# the shape of a state `key` line. Bumped whenever parse_hist changes what a key IS, so a state
# file from the old shape re-baselines instead of being diffed against keys it cannot match.
KEYFMT=addr
MIN_CORPUS="${MESH_DROP_MIN_CORPUS:-12}"
CORPUS_MAX=200

I="$TRACEFS/instances/$INSTANCE"
EV="$I/events/skb/kfree_skb"

RAW=0; MODE=accum; WINDOW=0

# ---- privileged tracefs access (globs expand INSIDE the privileged shell) ------------------
tr_sh() { sudo -n sh -c "$1" 2>/dev/null; }

have_root() { sudo -n true 2>/dev/null; }

# is skb:kfree_skb present on this kernel at all?
tp_present() { tr_sh "test -r '$TRACEFS/events/skb/kfree_skb/format'"; }

armed() { tr_sh "grep -qF 'keys=location.sym,reason' '$EV/trigger'"; }

arm() {
  tr_sh "mkdir -p '$I'" || return 1
  # no ring buffer at all: the hist counts regardless, and nothing can then be lost to overrun
  tr_sh "echo 0 > '$I/tracing_on'"
  tr_sh "echo '$TRIG' > '$EV/trigger'"
}

disarm() {
  tr_sh "echo '!$TRIG' > '$EV/trigger'"
  tr_sh "rmdir '$I'"
}

read_hist() { tr_sh "cat '$EV/hist'"; }

# ---- reason naming: from the RUNNING kernel's own format file, never a hardcoded table -----
# emits "<int> <NAME>" for the core (subsys 0) enum this kernel actually exports
reason_table() {
  tr_sh "cat '$TRACEFS/events/skb/kfree_skb/format'" |
    sed -n 's/.*__print_symbolic(REC->reason,//p' |
    tr '{' '\n' | sed -n 's/^ *\([0-9][0-9]*\), *"\([A-Z0-9_]*\)".*/\1 \2/p'
}

SUBSYS_0=CORE; SUBSYS_1=MAC80211_UNUSABLE; SUBSYS_2=MAC80211_MONITOR; SUBSYS_3=OPENVSWITCH

# ---- hist parse: "<addr>|<symbol>|<reason_int> <count>" -----------------------------------
# a hist line looks like
#   { location: [ffffffffc0e0ea8f] ieee80211_iface_work [mac80211]   , reason:  65540 } hitcount:  23
# the symbol itself may contain " [module]", so the split is on the LAST ", reason:" — and the
# space before the module bracket is CLOSED UP, because every downstream reader of this stream
# (the delta awk, the `read key cnt` loop) is whitespace-delimited and a symbol carrying a space
# lands its module suffix in the COUNT field.
#
# THE RAW ADDRESS IS PART OF THE KEY, and it is not decoration. The hist key is the raw
# `location` value; `.sym` is only how it is DISPLAYED, so ONE function holds as many rows as it
# has call sites — live here 2026-08-22: 61 rows, 57 distinct symbols, hci_event_packet[bluetooth]
# alone occupying FOUR ([ffffffffc0adf147] [ffffffffc0adf326] [ffffffffc0adf333] [ffffffffc0adf465],
# 635/1/635/25 hits). Keyed on the symbol, those four rows collapse onto one key and the delta
# compares every one of them against a single last-wins prior: the same interval then yields a
# spurious RESET or a silent undercount depending purely on ROW ORDER — and the hist is sorted BY
# HITCOUNT, so the order moves with the counts. The address is the unique call-site id; the
# aggregation back to a symbol happens AFTER the delta, so TOP/FAM/link read per-symbol as before.
parse_hist() {
  sed -n 's/^{ location: \[\([0-9a-f]*\)\] *\(.*\), reason: *\([0-9][0-9]*\) *} hitcount: *\([0-9][0-9]*\) *$/\1|\2|\3 \4/p' |
    sed 's/  *|/|/g; s/ *\[/[/'
}

# ---- delta: a prior/current accumulator pair on stdin, separated by a bare "--" ---------------
# Emits "<key> <grown-by>" for every key that MOVED, or the single word RESET if any key FELL
# (a re-arm/reboot zeroed the accumulator — a genuine counter fall, and the only way out of here).
#
# Duplicate keys are SUMMED on both sides, never last-wins. That is defence in depth behind the
# address in the key above: a duplicate must be arithmetic, never a phantom counter fall, because
# a spurious RESET discards the WHOLE interval (mode=baseline, no durable row) and the sense then
# goes blind for a full cadence without complaining. RESET is decided over the COMPLETE union
# before a single row is emitted — the old shape printed rows as it went and only then printed
# RESET, so the caller's `case "$delta" in RESET*)` could not even see it behind a mover.
delta_calc() {
  awk '
    $1=="--" { s=1; next }
    !s { p[$1]+=$2; next }
    { if (!($1 in c)) ord[++n]=$1; c[$1]+=$2 }
    END {
      for (i=1;i<=n;i++) { k=ord[i]; d[i]=c[k]-((k in p)?p[k]:0); if (d[i]<0) { print "RESET"; exit } }
      for (i=1;i<=n;i++) if (d[i]>0) printf "%s %d\n", ord[i], d[i]
    }'
}

hist_field() { sed -n "s/^ *$1: *\([0-9][0-9]*\).*/\1/p" | tail -1; }
hist_size()  { sed -n 's/.*:size=\([0-9][0-9]*\).*/\1/p' | tail -1; }

# ---- location -> family --------------------------------------------------------------------
# The families the operator can ACT on are separated; the local noise floor is not smeared into
# them. `link` (the ranked axis) = mac80211 + neigh-arp.
family_of() {
  case "$1" in
    *'[mac80211]'*|ieee80211_*|*'[cfg80211]'*)      echo mac80211 ;;
    *'[bluetooth]'*|hci_*|l2cap_*|rfcomm_*)         echo bluetooth ;;
    neigh_*|__neigh*|arp_*|ndisc_*|*neigh_failed*)  echo neigh-arp ;;
    ip_rcv*|ip6_*|ip_forward*|__udp*|udp_*|tcp_v4_*|tcp_v6_*|icmp*|__ip*) echo l3-l4 ;;
    unix_*|sock_*|__sk_*|skb_queue*|packet_*)       echo socket ;;
    dev_kfree_skb*|__netif*|netif_*|*_xmit*|qdisc*|__dev_*) echo driver ;;
    *)                                              echo other ;;
  esac
}

# WHICH families constitute the ranked axis. This used to be an anonymous inline `case` in the
# counting loop; it is a NAMED function so it can be pointed at, hashed and given a custodian
# (CSH 2.0 Boundary III, Goede & Goede 2025 — see the axis_struct block below). A rule with no
# name has no custodian, and a rule with no custodian silently changes what a corpus MEANS.
link_families() { printf 'mac80211\nneigh-arp\n'; }

# ---- Boundary III: the causal structure behind the ranked axis ------------------------------
# Critical Systems Heuristics 2.0 (Goede & Goede, Systems Research and Behavioral Science, 2025,
# doi:10.1002/sres.3187) extends Ulrich's boundary critique — itself THE critique of Beer's
# cybernetics (Ulrich 1981, "A critique of pure cybernetic reason: the Chilean experience with
# cybernetics", JASA 8:33-59) — with a THIRD boundary: causal structures vs phenomena. Its Q11 is
# "what causal structures are responsible for phenomena, and how do they evolve?"
#
# This ledger records PHENOMENA (a linkrate per interval) and nothing about the structure that
# produced them. The corpus reader then pools every row ever written into one median/p90. But the
# structure evolves: this tool's subsystem decode was widened the same day it was wired (274 of
# 5131 reason values had been eaten by a [A-Z_]+ scrape), and `link` membership is one edit away
# from meaning a different population. Rows either side of such an edit are counts of DIFFERENT
# things, and a percentile over the pooled set compares today against a mechanism that no longer
# exists — while looking exactly like a longer, better corpus.
#
# So each row is stamped with the identity of the structure that computed it, and the corpus
# admits only rows whose structure is the CURRENT one. `declare -f` prints the PARSED body, so
# comments and reformatting are invisible here and only executable structure moves the hash.
# KNOWN false-positive direction: bash's pretty-printer is version-dependent, so a bash upgrade
# retires the corpus. That errs toward withholding a rank, never toward pooling two mechanisms —
# and it is LOUD (corpus_retired= is published and printed), never a silent shrink.
AXIS_FNS='parse_hist delta_calc family_of link_families'
axis_struct() {
  local f body=''
  for f in $AXIS_FNS; do body+="$(declare -f "$f" 2>/dev/null)"$'\n'; done
  local h; h="$(printf '%s' "$body" | sha256sum 2>/dev/null | cut -c1-12)"
  # a missing function or a missing sha256sum must not collapse to "matches everything"
  case "${h:-}" in ''|*[!0-9a-f]*) printf 'nostruct' ;; *) printf '%s' "$h" ;; esac
}

# "a=1 b=2 " -> "a=1,b=2" for the ledger row. Empty renders `na`, never an empty field: a blank
# value between two spaces is indistinguishable from a missing field to a whitespace reader, and a
# consumer must be able to tell "this producer had nothing to say" from "this producer is older
# than the field".
csv_fields() {
  local s; s="$(printf '%s' "${1:-}" | tr -s ' \t' ',' | sed 's/^,//; s/,$//')"
  printf '%s' "${s:-na}"
}

# The ledger row, as ONE function both the live path and --test call. A row assembled a second
# time inside the test grades a duplicate of the code, not the code — the same defect this file's
# delta gate already had to fix. Reads its inputs from the caller's scope (bash is dynamically
# scoped), so the test drives it by setting exactly the variables run() sets.
ledger_line() {
  printf '%s mode=%s interval=%ss total=%s rate=%s/s link=%s linkrate=%s/s verdict=%s entries=%s dropped=%s devamb=%s struct=%s top=%s family=%s topn=%s\n' \
    "${row_ts:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" "$MODE" "$interval" "$total" "$rate" "$link" "$linkrate" \
    "$verdict" "$entries" "$dropped" "$amb" "$struct" "$(printf '%s' "$topstr" | awk '{print $1}')" \
    "$(csv_fields "$famstr")" "$(csv_fields "$topstr")"
}

# how many wifi netdevs does this node have? >1 makes the mac80211 family un-attributable
wifi_devs() {
  local n=0 d
  shopt -s nullglob
  for d in /sys/class/net/*/wireless /sys/class/net/*/phy80211; do n=$((n+1)); done
  shopt -u nullglob
  # a device with both dirs must not count twice
  local seen=0
  seen=$(ls -d /sys/class/net/*/wireless /sys/class/net/*/phy80211 2>/dev/null |
           sed 's|/sys/class/net/||; s|/.*||' | sort -u | grep -c . )
  printf '%s' "${seen:-0}"
}

# ---- corpus ranking (this node's own ledger, never a constant) ------------------------------
# stdin: one linkrate per line. args: <value>. echoes "<verdict> <median> <p90> <n>"
rank_against_corpus() {
  awk -v v="$1" -v need="$MIN_CORPUS" '
    /^[0-9.]+$/ { a[n++]=$1+0 }
    END {
      if (n < need) { printf "unranked na na %d\n", n; exit }
      for (i=0;i<n;i++) for (j=i+1;j<n;j++) if (a[j]<a[i]) { t=a[i]; a[i]=a[j]; a[j]=t }
      med = (n%2) ? a[int(n/2)] : (a[n/2-1]+a[n/2])/2
      p90 = a[int(0.9*(n-1))+0]
      verdict = (v > 0 && v > p90 && v > 2*med) ? "elevated" : "normal"
      printf "%s %.4f %.4f %d\n", verdict, med, p90, n
    }'
}

# args: <axis-struct>. Only rows produced by the SAME causal structure are comparable.
# An unstamped legacy row is not "probably fine" — its structure is unknown, so it is excluded.
corpus() {
  [ -r "$LEDGER" ] || return 0
  grep -F 'mode=accum' "$LEDGER" 2>/dev/null | grep -F "struct=$1" |
    sed -n 's/.*[[:space:]]linkrate=\([0-9.]*\)\/s.*/\1/p' | tail -n "$CORPUS_MAX"
}

# how many accum rows on the ledger belong to a RETIRED structure (or carry no stamp at all).
# This is the number that must never be silent: without it, an axis edit and a fresh install
# render identically as "unranked", and the operator cannot tell a young corpus from a dead one.
corpus_retired() {
  [ -r "$LEDGER" ] || { printf '0'; return 0; }
  local n; n="$(grep -F 'mode=accum' "$LEDGER" 2>/dev/null | grep -cvF "struct=$1")"
  printf '%s' "${n:-0}"
}

# ---- state ---------------------------------------------------------------------------------
boot_id() { cat "$BOOTID_FILE" 2>/dev/null || echo unknown; }

# =============================== main ========================================================
run() {
  local now bid
  now="$(date +%s)"; bid="$(boot_id)"

  have_root   || { echo "drop-reason: n/a (no passwordless root — tracefs is root-only)"; return 2; }
  tp_present  || { echo "drop-reason: n/a (skb:kfree_skb not present at $TRACEFS)";        return 2; }

  local fresh=0
  if [ "$MODE" = window ]; then
    # A window sample gets its OWN instance. Re-arming the accumulator's instance to get a fresh
    # hist would zero the standing counters, and the next scheduled read would see a fallen
    # counter, re-baseline, and silently lose that whole interval: an on-demand call must not cost
    # the reflex a reading.
    INSTANCE="${INSTANCE}-win"; I="$TRACEFS/instances/$INSTANCE"; EV="$I/events/skb/kfree_skb"
    armed && tr_sh "echo '!$TRIG' > '$EV/trigger'"   # a fresh hist for an on-demand sample
    arm || { echo "drop-reason: n/a (cannot arm instance $INSTANCE)"; return 2; }
    sleep "$WINDOW"
    fresh=1
  elif ! armed; then
    arm || { echo "drop-reason: n/a (cannot arm instance $INSTANCE)"; return 2; }
    fresh=1
  fi

  local hist; hist="$(read_hist)"
  [ "$MODE" = window ] && { tr_sh "echo '!$TRIG' > '$EV/trigger'"; tr_sh "rmdir '$I'"; }
  [ -n "$hist" ] || { echo "drop-reason: BLIND (armed but the hist could not be read)"; return 3; }

  local dropped entries size
  dropped="$(printf '%s\n' "$hist" | hist_field 'Dropped')"; dropped="${dropped:-0}"
  entries="$(printf '%s\n' "$hist" | hist_field 'Entries')"; entries="${entries:-0}"
  size="$(printf '%s\n' "$hist" | hist_size)";               size="${size:-0}"

  local cur; cur="$(printf '%s\n' "$hist" | parse_hist)"

  # ---- delta against the previous sample (the accumulator IS the coverage) ------------------
  local prior_boot="" prior_at="" interval=0 baseline=0 delta=""
  if [ "$MODE" = window ]; then
    interval="$WINDOW"; delta="$cur"
  else
    local prior_fmt=""
    if [ -r "$STATE" ]; then
      prior_boot="$(sed -n 's/^boot_id //p' "$STATE" | head -1)"
      prior_at="$(sed -n 's/^sampled_at //p' "$STATE" | head -1)"
      prior_fmt="$(sed -n 's/^keyfmt //p' "$STATE" | head -1)"
    fi
    # A state file written by an older KEY FORMAT is not a prior — every key would read as new and
    # count WHOLE, publishing the accumulator's whole life as one interval's drops. It is not a
    # counter fall either, so nothing would catch it. One baseline is the honest cost of the
    # format change; a silent spike is not.
    if [ "$fresh" = 1 ] || [ -z "$prior_at" ] || [ "$prior_boot" != "$bid" ] || [ "$prior_fmt" != "$KEYFMT" ]; then
      baseline=1
    else
      interval=$(( now - prior_at ))
      [ "$interval" -gt 0 ] || interval=1
      delta="$(
        { sed -n 's/^key //p' "$STATE"; echo '--'; printf '%s\n' "$cur"; } | delta_calc
      )"
      case "$delta" in RESET*) baseline=1; delta="" ;; esac
    fi
  fi

  # ---- families + reason labels --------------------------------------------------------------
  local total=0 link=0
  declare -A FAM=() TOP=() RSN=() LINKFAM=()
  local lf; while read -r lf; do [ -n "$lf" ] && LINKFAM[$lf]=1; done < <(link_families)
  local key sym rint cnt fam krest
  while read -r key cnt; do
    [ -n "${key:-}" ] || continue
    # <addr>|<symbol>|<reason> — the address is dropped HERE, after the delta, so several call
    # sites in one function aggregate into that function's row exactly as before.
    krest="${key#*|}"; sym="${krest%|*}"; rint="${krest##*|}"
    fam="$(family_of "$sym")"
    total=$(( total + cnt ))
    FAM[$fam]=$(( ${FAM[$fam]:-0} + cnt ))
    TOP[$sym]=$(( ${TOP[$sym]:-0} + cnt ))
    RSN[$rint]=$(( ${RSN[$rint]:-0} + cnt ))
    [ -n "${LINKFAM[$fam]:-}" ] && link=$(( link + cnt ))
  done <<< "$delta"

  # name the reasons off the running kernel's own table; decode the subsystem ourselves
  local rtab; rtab="$(reason_table)"
  reason_label() {
    local v="$1" sub core name
    sub=$(( v >> 16 )); core=$(( v & 0xffff ))
    if [ "$sub" = 0 ]; then
      name="$(printf '%s\n' "$rtab" | awk -v k="$core" '$1==k{print $2; exit}')"
      # reasons 0 and 1 have NO entry in the print table — they are honest bare integers, not a
      # parse failure, and must not be silently dropped
      [ -n "$name" ] && printf '%s' "$name" || printf 'UNNAMED:%s' "$core"
    else
      local sname; sname="$(eval "printf '%s' \"\${SUBSYS_$sub:-}\"")"
      [ -n "$sname" ] || sname="SUBSYS$sub"
      printf '%s:%s' "$sname" "$core"     # non-core sub-reason names are not exported by the kernel
    fi
  }

  # ---- rate + verdict --------------------------------------------------------------------------
  local rate linkrate verdict med p90 ncorp struct retired
  struct="$(axis_struct)"; retired="$(corpus_retired "$struct")"
  if [ "$baseline" = 1 ]; then
    verdict=baseline; rate=na; linkrate=na; med=na; p90=na; ncorp=0
  else
    rate="$(awk -v c="$total" -v w="$interval" 'BEGIN{printf "%.3f", c/w}')"
    linkrate="$(awk -v c="$link" -v w="$interval" 'BEGIN{printf "%.3f", c/w}')"
    if [ "$total" = 0 ]; then
      verdict=quiet; med=na; p90=na; ncorp="$(corpus "$struct" | grep -c . )"
    else
      read -r verdict med p90 ncorp <<< "$(corpus "$struct" | rank_against_corpus "$linkrate")"
    fi
  fi

  local ndev amb; ndev="$(wifi_devs)"; amb=no
  [ "${ndev:-0}" -gt 1 ] && amb=yes

  # ---- publish ----------------------------------------------------------------------------------
  local topstr famstr rsnstr
  topstr="$(for key in "${!TOP[@]}"; do printf '%s %s\n' "${TOP[$key]}" "$key"; done |
            sort -rn | head -6 | awk '{c=$1; $1=""; sub(/^ /,""); gsub(/ /,""); printf "%s=%s ", $0, c}')"
  famstr="$(for key in "${!FAM[@]}"; do printf '%s=%s ' "$key" "${FAM[$key]}"; done)"
  rsnstr="$(for key in "${!RSN[@]}"; do printf '%s %s\n' "${RSN[$key]}" "$key"; done |
            sort -rn | head -6 | while read -r cnt key; do printf '%s=%s ' "$(reason_label "$key")" "$cnt"; done)"

  local cov
  if [ "$MODE" = window ]; then cov="sample(${WINDOW}s)"; else cov=full; fi

  if [ "$RAW" = 1 ]; then
    echo "verdict=$verdict"
    echo "mode=$MODE"
    echo "interval=$interval"
    echo "coverage=$cov"
    echo "total=$total"
    echo "rate=$rate"
    echo "link=$link"
    echo "linkrate=$linkrate"
    echo "corpus_n=$ncorp"
    echo "corpus_struct=$struct"
    echo "corpus_retired=$retired"
    echo "corpus_median=$med"
    echo "corpus_p90=$p90"
    echo "hist_entries=$entries"
    echo "hist_size=$size"
    echo "hist_dropped=$dropped"
    echo "wifi_devs=$ndev"
    echo "dev_ambiguous=$amb"
    echo "family=${famstr% }"
    echo "top=${topstr% }"
    echo "reason=${rsnstr% }"
  else
    echo "drop-reason: $verdict link=${linkrate}/s total=${rate}/s interval=${interval}s coverage=$cov (corpus n=$ncorp med=$med p90=$p90 struct=$struct)"
    if [ "${retired:-0}" -gt 0 ]; then
      echo "  STRUCTURE: $retired ledger row(s) were produced by a DIFFERENT axis structure (or carry"
      echo "             no stamp) and are EXCLUDED from the corpus — they are not lost, they are"
      echo "             un-comparable. Current axis struct=$struct over [$AXIS_FNS]."
      [ "$verdict" = unranked ] && echo "             unranked here is a STRUCTURE CHANGE, not a young node."
    fi
    [ -n "$famstr" ] && echo "  family: ${famstr% }"
    [ -n "$topstr" ] && echo "  top:    ${topstr% }"
    [ -n "$rsnstr" ] && echo "  reason: ${rsnstr% }"
    echo "  hist:   entries=$entries/$size dropped=$dropped · wifi-netdevs=$ndev dev-ambiguous=$amb"
  fi

  # ---- persist (accumulator mode only; a window sample must not move the accumulator's state) ---
  if [ "$MODE" = accum ]; then
    mkdir -p "$(dirname "$STATE")"
    { echo "boot_id $bid"; echo "sampled_at $now"; echo "keyfmt $KEYFMT"
      printf '%s\n' "$cur" | awk 'NF==2{print "key",$1,$2}' | sed 's/^key key/key/'
    } > "$STATE.tmp$$" && mv -f "$STATE.tmp$$" "$STATE"
    if [ "$baseline" != 1 ]; then
      mkdir -p "$(dirname "$LEDGER")"
      # `family=` and `topn=` exist for a CONSUMER (mesh-drop-stages' naming leg), which must read
      # this tape and must never invoke this tool: an accum run DELTAS the hist against the state
      # file and rewrites it, so a second caller silently steals the */10 reflex's interval — the
      # same shape as a bare `nstat` stealing every reader's history. The tape is the door.
      # Both fields are COMMA-joined: every existing reader of this row (the corpus sed, the
      # `grep -F struct=`) is whitespace-delimited, so a space inside a value would split the row.
      # A one-symbol `top=` is kept for the rows already on disk and is NOT enough for a citation:
      # this node's global top is `unix_stream_connect` (a local-socket noise floor), while the
      # information is in the family census.
      ledger_line >> "$LEDGER"
    fi
  fi

  [ "${dropped:-0}" -gt 0 ] && { echo "  BLIND: the hist hashmap overflowed (dropped=$dropped) — counts under-report"; return 3; }
  [ "$verdict" = elevated ] && return 1
  return 0
}

# =============================== --test =======================================================
# Fixtures drive BOTH directions of every gate. The real-hardware gate at the end asserts an
# actual kernel symbol came back — reachability is not producing. Nothing here writes the durable
# ledger or state (a-dry-run-that-writes-the-liveness-log-forges-its-own-evidence).
selftest() {
  local fails=0
  t() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fails=$((fails+1)); fi; }

  # --- parser: the symbol carries a " [module]" suffix and the split is on the LAST ", reason:"
  local fx got
  fx='{ location: [ffffffffc0e0ea8f] ieee80211_iface_work [mac80211]              , reason:      65540 } hitcount:         23'
  got="$(printf '%s\n' "$fx" | parse_hist)"
  t "parse: module-suffixed symbol + subsys reason" "$got" "ffffffffc0e0ea8f|ieee80211_iface_work[mac80211]|65540 23"
  local fx2='{ location: [ffffffffc0e0ea8f] ieee80211_iface_work [mac80211]              , reason:      65540 } hitcount:         23'
  fx='{ location: [ffffffff983e5617] ip_rcv_finish_core.isra.0                    , reason:          2 } hitcount:          2'
  t "parse: plain symbol" "$(printf '%s\n' "$fx" | parse_hist)" "ffffffff983e5617|ip_rcv_finish_core.isra.0|2 2"
  # the RAW ADDRESS must survive the parse: it is the only thing separating two call sites that
  # live inside the SAME function, and dropping it is what collapsed 61 live rows onto 57 keys.
  t "parse: the raw call-site address is KEPT, not discarded" \
    "$(printf '%s\n' "$fx" | parse_hist | cut -d'|' -f1)" "ffffffff983e5617"
  t "parse: a non-hist line yields nothing" "$(printf 'Totals:\n' | parse_hist)" ""

  # --- reason labelling: the trap is BOTH directions of the naming boundary
  local rtab; rtab="$(printf '2 NOT_SPECIFIED\n3 NO_SOCKET\n48 NEIGH_FAILED\n')"
  reason_label() {
    local v="$1" sub core name
    sub=$(( v >> 16 )); core=$(( v & 0xffff ))
    if [ "$sub" = 0 ]; then
      name="$(printf '%s\n' "$rtab" | awk -v k="$core" '$1==k{print $2; exit}')"
      [ -n "$name" ] && printf '%s' "$name" || printf 'UNNAMED:%s' "$core"
    else
      local sname; sname="$(eval "printf '%s' \"\${SUBSYS_$sub:-}\"")"
      [ -n "$sname" ] || sname="SUBSYS$sub"
      printf '%s:%s' "$sname" "$core"
    fi
  }
  t "reason: a named core reason"          "$(reason_label 2)"     "NOT_SPECIFIED"
  t "reason: 0 is NOT eaten"               "$(reason_label 0)"     "UNNAMED:0"
  t "reason: 1 is NOT eaten"               "$(reason_label 1)"     "UNNAMED:1"
  t "reason: subsystem-namespaced mac80211" "$(reason_label 65540)" "MAC80211_UNUSABLE:4"
  t "reason: an unknown subsystem is an ordinal, never a guessed name" "$(reason_label 458752)" "SUBSYS7:0"

  # --- families: the ranked axis must pick up wifi and arp, and must NOT pick up local sockets
  t "family: mac80211 module suffix" "$(family_of 'ieee80211_iface_work[mac80211]')" "mac80211"
  t "parse: a symbol with a space cannot leak into the count field" \
    "$(printf '%s\n' "$fx2" | parse_hist | awk '{print NF}')" "2"
  t "family: arp error report"       "$(family_of 'arp_error_report')"                "neigh-arp"
  t "family: unix socket is NOT link" "$(family_of 'unix_stream_connect')"             "socket"
  t "family: udp receive"            "$(family_of '__udp4_lib_rcv')"                   "l3-l4"
  t "family: unknown symbol"         "$(family_of 'some_future_symbol')"               "other"
  # the BT half of this node's combo chip shares silicon with the sole uplink, so it must be
  # VISIBLE as its own family — but it is not the uplink, so it must NOT join the ranked axis
  t "family: bluetooth is its own family" "$(family_of 'hci_event_packet[bluetooth]')" "bluetooth"

  # --- corpus ranking: under-corpus must WITHHOLD THE RANK, not invent a constant
  t "rank: too few samples -> unranked" "$(printf '1\n2\n3\n' | rank_against_corpus 99 | awk '{print $1}')" "unranked"
  local big; big="$(for i in $(seq 1 40); do echo 0.5; done)"
  t "rank: a value at the corpus centre is normal"  "$(printf '%s\n' "$big" | rank_against_corpus 0.5  | awk '{print $1}')" "normal"
  t "rank: a 20x outlier is elevated"               "$(printf '%s\n' "$big" | rank_against_corpus 10   | awk '{print $1}')" "elevated"
  t "rank: an all-zero corpus cannot manufacture an alarm from 0" \
    "$(for i in $(seq 1 40); do echo 0; done | rank_against_corpus 0 | awk '{print $1}')" "normal"

  # --- Boundary III: the corpus must be scoped to the causal structure that produced it -------
  local s1 s2 s3
  s1="$(axis_struct)"; s2="$(axis_struct)"
  t "struct: the same axis hashes the same twice" "$s1" "$s2"
  case "$s1" in nostruct|'') echo "FAIL struct: no hash available"; fails=$((fails+1)) ;;
    *) echo "ok   struct: current axis struct=$s1 over [$AXIS_FNS]" ;; esac
  # a COMMENT-only edit must NOT retire the corpus (declare -f prints the parsed body)
  eval "link_families() { # a comment that changes nothing executable
    printf 'mac80211\nneigh-arp\n'; }"
  s2="$(axis_struct)"
  t "struct: a comment-only edit does NOT retire the corpus" "$s2" "$s1"
  # a real change to WHAT COUNTS AS link MUST retire it — this is the whole mechanism claim
  eval "link_families() { printf 'mac80211\nneigh-arp\nbluetooth\n'; }"
  s3="$(axis_struct)"
  if [ "$s3" != "$s1" ]; then echo "ok   struct: widening the ranked axis changes struct ($s1 -> $s3)"
  else echo "FAIL struct: axis widened but struct did not move"; fails=$((fails+1)); fi
  eval "link_families() { printf 'mac80211\nneigh-arp\n'; }"
  t "struct: restoring the axis restores the hash" "$(axis_struct)" "$s1"

  # --- corpus scoping, on a fixture ledger (never the durable one) ----------------------------
  ( set +u
    local LEDGER; LEDGER="$(mktemp -t drop-corpus.XXXXXX)"
    local i
    for i in $(seq 1 5); do echo "T mode=accum linkrate=0.5/s struct=aaaaaaaaaaaa top=x" >> "$LEDGER"; done
    for i in $(seq 1 6); do echo "T mode=accum linkrate=9.9/s struct=bbbbbbbbbbbb top=x" >> "$LEDGER"; done
    echo "T mode=accum linkrate=7.7/s top=x" >> "$LEDGER"     # legacy, unstamped
    echo "T mode=window linkrate=4.4/s struct=aaaaaaaaaaaa top=x" >> "$LEDGER"  # not an accum row
    t "corpus: only rows of the CURRENT structure are admitted" \
      "$(corpus aaaaaaaaaaaa | tr '\n' ',')" "0.5,0.5,0.5,0.5,0.5,"
    t "corpus: rows of a retired structure + unstamped rows are counted, not silent" \
      "$(corpus_retired aaaaaaaaaaaa)" "7"
    t "corpus: an unstamped legacy row is NOT admitted as 'probably ours'" \
      "$(corpus aaaaaaaaaaaa | grep -c 7.7)" "0"
    # the failure this exists to stop: 40 foreign rows must NOT be pooled into a rank
    local j; for j in $(seq 1 40); do echo "T mode=accum linkrate=0.5/s struct=cccccccccccc top=x" >> "$LEDGER"; done
    t "corpus: a full corpus of a RETIRED structure ranks nothing (would have been 'elevated' pooled)" \
      "$(corpus aaaaaaaaaaaa | rank_against_corpus 10 | awk '{print $1}')" "unranked"
    rm -f "$LEDGER"
  ) || fails=$((fails+1))

  # the named rule and the family classifier must agree about what the ranked axis contains
  t "axis: link_families is exactly mac80211 + neigh-arp" "$(link_families | sort | tr '\n' ',')" "mac80211,neigh-arp,"
  t "axis: bluetooth is NOT in the ranked axis" "$(link_families | grep -c '^bluetooth$')" "0"

  # --- THE CONSUMER CONTRACT: the ledger row is mesh-drop-stages' naming leg's ONLY door -------
  # (it must not invoke this tool — an accum run consumes the interval). Two things are gated:
  # the row still parses field-per-space, and the two new values carry no whitespace.
  t "csv: a space-separated census becomes one comma field" "$(csv_fields 'mac80211=24 socket=19 ')" "mac80211=24,socket=19"
  t "csv: nothing to say renders na, never an empty field" "$(csv_fields '')" "na"
  t "csv: tabs collapse too" "$(csv_fields "$(printf 'a=1\tb=2')")" "a=1,b=2"
  ( set +u
    local MODE=accum interval=600 total=99 rate=1.1 link=9 linkrate=0.9 verdict=normal
    local entries=110 dropped=0 amb=no struct=deadbeefcafe row_ts=2026-01-01T00:00:00Z
    local famstr='mac80211=24 socket=19 ' topstr='ieee80211_iface_work[mac80211]=18 unix_stream_connect=9 '
    local row; row="$(ledger_line)"
    t "ledger: the row is 15 whitespace fields (a value with a space would split it)" "$(awk '{print NF}' <<<"$row")" "15"
    t "ledger: family= is the whole census, comma-joined" \
      "$(awk '{for(i=1;i<=NF;i++) if($i ~ /^family=/) print $i}' <<<"$row")" "family=mac80211=24,socket=19"
    t "ledger: topn= carries more than the single top symbol" \
      "$(awk '{for(i=1;i<=NF;i++) if($i ~ /^topn=/) print $i}' <<<"$row")" \
      "topn=ieee80211_iface_work[mac80211]=18,unix_stream_connect=9"
    t "ledger: the legacy one-symbol top= is unchanged for rows already on disk" \
      "$(awk '{for(i=1;i<=NF;i++) if($i ~ /^top=/) print $i}' <<<"$row")" "top=ieee80211_iface_work[mac80211]=18"
    # and the corpus reader must still find linkrate on the widened row — the field that ranks
    t "ledger: the widened row is still readable by the corpus sed" \
      "$(sed -n 's/.*[[:space:]]linkrate=\([0-9.]*\)\/s.*/\1/p' <<<"$row")" "0.9"
    famstr=''; topstr=''
    row="$(ledger_line)"
    t "ledger: an empty census renders family=na, not a blank field" \
      "$(awk '{print NF}' <<<"$row")" "15"
  ) || fails=$((fails+1))

  # --- delta arithmetic: a FALLEN counter is a re-arm, never a negative rate
  # These drive delta_calc ITSELF. The previous version of this gate carried an inline COPY of the
  # awk, so it graded a duplicate of the code rather than the code (a mutant in run() passed it).
  local d
  d="$(printf 'a|2 10\nb|3 5\n--\na|2 14\nb|3 5\nc|4 2\n' | delta_calc)"
  t "delta: only movers survive, a new key counts whole" "$(printf '%s' "$d" | tr '\n' ';')" "a|2 4;c|4 2"
  d="$(printf 'a|2 10\n--\na|2 3\n' | delta_calc)"
  t "delta: a fallen counter is RESET, not a negative" "$d" "RESET"
  # a RESET must arrive ALONE — the old shape emitted movers first and RESET last, where the
  # caller's `case "$delta" in RESET*)` could not see it, so a re-arm silently published a rate
  d="$(printf 'a|2 10\nb|3 5\n--\na|2 99\nb|3 1\n' | delta_calc)"
  t "delta: a RESET is the WHOLE output, never trailing behind a mover" "$d" "RESET"

  # --- THE COLLAPSE GATE: many call sites in one function must not share one row ---------------
  # Four REAL sites of hci_event_packet[bluetooth] read off this node's live hist 2026-08-22.
  # Every site grows by exactly +5 over the interval, so the honest answer is 20 — and it must be
  # 20 in BOTH row orders, because the hist is sorted by hitcount and the order moves with the
  # counts. On the symbol-keyed code this returned RESET one way and 10 the other: same interval,
  # same truth, two different wrong answers picked by a coin flip.
  local hist_lo hist_hi ord h
  hist_lo='{ location: [ffffffffc0adf147] hci_event_packet [bluetooth]   , reason:          2 } hitcount:        635
{ location: [ffffffffc0adf326] hci_event_packet [bluetooth]   , reason:          2 } hitcount:          1
{ location: [ffffffffc0adf333] hci_event_packet [bluetooth]   , reason:          2 } hitcount:        635
{ location: [ffffffffc0adf465] hci_event_packet [bluetooth]   , reason:          2 } hitcount:         25'
  hist_hi="$(printf '%s\n' "$hist_lo" | sort -t: -k4 -rn)"
  # the +5-per-site "later" sample, in each row order
  bump() { parse_hist | awk -v b="$1" '{printf "%s %d\n", $1, $2+b}'; }
  local sum
  for ord in lo hi; do
    [ "$ord" = lo ] && h="$hist_lo" || h="$hist_hi"
    d="$( { printf '%s\n' "$h" | bump 0; echo '--'; printf '%s\n' "$h" | bump 5; } | delta_calc )"
    case "$d" in *RESET*) sum=RESET ;; *) sum="$(printf '%s\n' "$d" | awk '{s+=$2} END{print s+0}')" ;; esac
    t "collapse: 4 call sites in one function, each +5, row order=$ord -> 20" "$sum" "20"
  done
  # and the same fault fed as a literal REPEATED key (which is exactly what the state file on this
  # node contains today): summed, never last-wins, in both orders
  d="$(printf 'k 635\nk 1\nk 635\nk 25\n--\nk 640\nk 6\nk 640\nk 30\n' | delta_calc)"
  t "collapse: a literally repeated key is SUMMED, ascending" "$d" "k 20"
  d="$(printf 'k 635\nk 25\nk 1\nk 635\n--\nk 640\nk 30\nk 6\nk 640\n' | delta_calc)"
  t "collapse: a literally repeated key is SUMMED, descending" "$d" "k 20"
  unset -f bump
  # Summing duplicates alone is NOT the fix — it makes the arithmetic honest but HIDES a genuine
  # counter fall inside a collapsed key: one site re-arming to 0 while its siblings grow nets out
  # positive and the re-arm is silently absorbed. Only the ADDRESS in the key can see it.
  local histA histB
  histA='{ location: [ffffffffc0adf147] hci_event_packet [bluetooth]   , reason:          2 } hitcount:        635
{ location: [ffffffffc0adf333] hci_event_packet [bluetooth]   , reason:          2 } hitcount:        600'
  histB='{ location: [ffffffffc0adf147] hci_event_packet [bluetooth]   , reason:          2 } hitcount:          3
{ location: [ffffffffc0adf333] hci_event_packet [bluetooth]   , reason:          2 } hitcount:       1400'
  d="$( { printf '%s\n' "$histA" | parse_hist; echo '--'; printf '%s\n' "$histB" | parse_hist; } | delta_calc )"
  t "collapse: one call site falling to 0 is a RESET, not netted away by its siblings" "$d" "RESET"


  # the aggregation back to a symbol happens AFTER the delta — an addressed key still yields the
  # bare symbol and the bare reason that TOP/FAM/RSN are keyed on
  local kk krest2
  kk='ffffffffc0adf147|hci_event_packet[bluetooth]|2'
  krest2="${kk#*|}"
  t "aggregate: the symbol is recovered from an addressed key" "${krest2%|*}" "hci_event_packet[bluetooth]"
  t "aggregate: the reason is recovered from an addressed key" "${krest2##*|}" "2"
  t "aggregate: family_of still classifies the recovered symbol" "$(family_of "${krest2%|*}")" "bluetooth"

  # --- the KEY-FORMAT boundary, driven through run() itself (both directions) -----------------
  # A state file from the old key shape must force ONE baseline. Without this, every key reads as
  # new, counts WHOLE, and the accumulator's entire life is published as a single interval's drops
  # — a spike no RESET arm can see. Both legs redirect STATE and LEDGER to temp files: nothing
  # here touches the durable ones.
  if have_root && tp_present && armed; then
    local tst tld tout
    tst="$(mktemp -t drop-state.XXXXXX)"; tld="$(mktemp -t drop-ledger.XXXXXX)"
    { echo "boot_id $(boot_id)"; echo "sampled_at $(( $(date +%s) - 60 ))"
      echo "key ip_rcv_finish_core.isra.0|2 1"; } > "$tst"          # LEGACY shape: no keyfmt line
    tout="$(MESH_DROP_STATE="$tst" MESH_DROP_LEDGER="$tld" bash "$0" --raw 2>/dev/null |
            sed -n 's/^verdict=//p')"
    t "keyfmt: a legacy state file re-baselines instead of counting every key whole" "$tout" "baseline"
    t "keyfmt: that baseline wrote NO durable ledger row" "$(grep -c . "$tld" 2>/dev/null)" "0"
    # and the state it left behind carries the current format, so the NEXT run is a real delta
    t "keyfmt: the re-baseline stamped the current key format" \
      "$(sed -n 's/^keyfmt //p' "$tst" | head -1)" "$KEYFMT"
    tout="$(MESH_DROP_STATE="$tst" MESH_DROP_LEDGER="$tld" bash "$0" --raw 2>/dev/null |
            sed -n 's/^verdict=//p')"
    case "$tout" in baseline|'') echo "FAIL keyfmt: a same-format prior still re-baselined [$tout]"; fails=$((fails+1)) ;;
      *) echo "ok   keyfmt: a same-format prior yields a real delta (verdict=$tout)" ;; esac
    rm -f "$tst" "$tld"
  else
    echo "skip keyfmt gate: accumulator instance not armed (needs root + a live hist)"
  fi

  # --- the honesty fields must be READ, not assumed
  local hfx; hfx="$(printf '# trigger info: hist:keys=location.sym,reason:vals=hitcount:sort=hitcount:size=2048 [active]\nTotals:\n    Hits: 42\n    Entries: 6\n    Dropped: 3\n')"
  t "hist: dropped is read"  "$(printf '%s\n' "$hfx" | hist_field 'Dropped')" "3"
  t "hist: entries is read"  "$(printf '%s\n' "$hfx" | hist_field 'Entries')" "6"
  t "hist: size is read"     "$(printf '%s\n' "$hfx" | hist_size)"            "2048"

  # --- the reason table must come from the RUNNING kernel, not the fixture above ---------------
  if have_root && tp_present; then
    local live; live="$(reason_table)"
    t "reason table: read from this kernel's own format file" \
      "$(printf '%s\n' "$live" | awk '$1==2{print $2; exit}')" "NOT_SPECIFIED"
    t "reason table: it has NO entry for 0 (which is why 0 must not be eaten)" \
      "$(printf '%s\n' "$live" | awk '$1==0{print "present"}')" ""
  else
    echo "skip reason-table gate: tracepoint unreachable"
  fi

  # --- REAL HARDWARE GATE: reachability is not producing --------------------------------------
  if ! have_root; then
    echo "skip real-read gate: no passwordless root (the tool exits 2 here, honest n/a)"
  elif ! tp_present; then
    echo "skip real-read gate: skb:kfree_skb absent on this kernel (the tool exits 2 here)"
  else
    local tinst="${INSTANCE}-test$$" saveI="$I" saveEV="$EV" saveINST="$INSTANCE"
    INSTANCE="$tinst"; I="$TRACEFS/instances/$INSTANCE"; EV="$I/events/skb/kfree_skb"
    if arm; then
      # generate a guaranteed drop: a connect to a closed unix socket / an unbound UDP port
      (exec 3<>/dev/udp/127.0.0.1/9 && printf x >&3) 2>/dev/null
      sleep 3
      local h; h="$(read_hist)"
      local rows; rows="$(printf '%s\n' "$h" | parse_hist | grep -c . )"
      local tot; tot="$(printf '%s\n' "$h" | hist_field 'Hits')"
      if [ "${rows:-0}" -ge 1 ] && [ "${tot:-0}" -ge 1 ]; then
        echo "ok   real read: $rows location/reason row(s), $tot hit(s) from the live kernel"
        printf '%s\n' "$h" | parse_hist | head -3 | sed 's/^/       /'
        # field 1 is the raw call-site ADDRESS and field 2 the symbol — assert both, because a
        # gate reading only field 1 would grade the address and pass on an empty symbol
        local first addr sym
        first="$(printf '%s\n' "$h" | parse_hist | head -1 | awk '{print $1}')"
        addr="$(printf '%s' "$first" | cut -d'|' -f1)"
        sym="$(printf '%s' "$first" | cut -d'|' -f2)"
        case "$addr" in ''|*[!0-9a-f]*) echo "FAIL real read: field 1 is not a raw hex address [$addr]"; fails=$((fails+1)) ;;
          *) echo "ok   real read: call-site address is a raw hex value [$addr]" ;; esac
        case "$sym" in ''|' ') echo "FAIL real read: empty symbol"; fails=$((fails+1)) ;;
          *) echo "ok   real read: symbol is non-empty [$sym]" ;; esac
      else
        echo "FAIL real read: armed but produced no rows (rows=$rows hits=$tot)"; fails=$((fails+1))
      fi
      # tracing_on=0 must NOT have stopped the hist — that is the whole mechanism claim
      local ton; ton="$(tr_sh "cat '$I/tracing_on'")"
      t "real read: ring buffer is off while the hist counts" "$ton" "0"
      disarm
    else
      echo "FAIL real read: could not arm test instance"; fails=$((fails+1))
    fi
    INSTANCE="$saveINST"; I="$saveI"; EV="$saveEV"
  fi

  echo
  if [ "$fails" = 0 ]; then echo "mesh-drop-reason --test: PASS"; return 0
  else echo "mesh-drop-reason --test: $fails FAILURE(S)"; return 1; fi
}

# =============================== args =========================================================
while [ $# -gt 0 ]; do
  case "$1" in
    --raw)     RAW=1; shift ;;
    --window)  MODE=window; WINDOW="${2:-10}"; shift 2 ;;
    --disarm)  have_root || { echo "drop-reason: n/a (no passwordless root)"; exit 2; }
               disarm; rm -f "$STATE"; echo "drop-reason: disarmed ($INSTANCE)"; exit 0 ;;
    --test)    selftest; exit $? ;;
    -h|--help) sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         echo "drop-reason: unknown argument $1" >&2; exit 64 ;;
  esac
done

case "$MODE" in
  window) case "$WINDOW" in ''|*[!0-9]*) echo "drop-reason: --window needs an integer seconds" >&2; exit 64 ;; esac ;;
esac

run
