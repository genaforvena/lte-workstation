#!/usr/bin/env bash
# mesh-claude-deepseek — Claude Code backed by DeepSeek (operator 2026-09-03 "lets use claude
# code with deepseek api set instead of anthropic").
#
# WHY: opencode+deepseek sessions showed unreliable context clearing (/clear seemingly not taking,
# so minds sat on stale context); Claude Code's /clear is client-side and provider-independent,
# and DeepSeek publishes an official Anthropic-compatible endpoint, so the Claude harness runs
# unchanged against the DeepSeek backend — same TUI, same mesh clear tooling, different bill.
#
# The mapping is DeepSeek's own (api-docs.deepseek.com "Integrate with Claude Code"):
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic  (NOT api.deepseek.com/v1 — that one
#     speaks OpenAI protocol and Claude Code cannot call it directly)
#   ANTHROPIC_AUTH_TOKEN=<DeepSeek key>  (claude honors AUTH_TOKEN over API_KEY for routing)
#   main = deepseek-v4-flash[1m] (operator 2026-09-03 "use flash instead of pro";
#     flash is ALSO 1M context — api-docs pricing page — so the [1m] suffix stays truthful;
#     subagents/cheap = deepseek-v4-flash (bare, per official doc)) · effort=max ·
#   auto-compact window 786432
# Server-side fallback mapping also exists (claude-opus* → v4-pro, claude-sonnet/haiku* → v4-flash),
# so a bare --model opus/sonnet/haiku still resolves even if these vars are dropped.
#
# SECRET DISCIPLINE: the key lives ONLY in ~/.mesh/deepseek.env (mode 600, gitignored, node-local)
# — never in this file (genome, committed) and never on any argv. The wrapper sources it when
# DEEPSEEK_API_KEY is not already exported (e.g. mesh-tell-injected env wins).
#
#   mesh-claude-deepseek [claude args...]   interactive or -p, passthrough to claude
#   mesh-claude-deepseek --test             smoke: env resolves + DeepSeek answers a pinned probe
#   mesh-claude-deepseek --help             this text
#
# orphan-ok: on-demand launcher — minds run it as their engine via MESH_*_CMD, never cron-wired itself.
set -uo pipefail

_keyfile="$HOME/.mesh/deepseek.env"
if [ -z "${DEEPSEEK_API_KEY:-}" ] && [ -f "$_keyfile" ]; then
  # shellcheck disable=SC1090
  . "$_keyfile" 2>/dev/null || true
fi

if [ "${1:-}" = --help ]; then sed -n '2,30p' "$0"; exit 0; fi

_have_key=0; [ -n "${DEEPSEEK_API_KEY:-}" ] && _have_key=1
if [ "${1:-}" = --test ]; then
  [ "$_have_key" = 1 ] || { echo "ds-claude-test: FAIL (no DEEPSEEK_API_KEY — neither exported nor in $_keyfile)" >&2; exit 1; }
  [ -x "$HOME/.local/bin/claude" ] || { echo "ds-claude-test: FAIL (no executable $HOME/.local/bin/claude)" >&2; exit 1; }
  out="$("$0" -p "reply with exactly: deepseek-ok" 2>/tmp/ds-claude-test.err)"; rc=$?
  [ "$rc" = 0 ] || { echo "ds-claude-test: FAIL (claude rc=$rc: $(head -c 300 /tmp/ds-claude-test.err))" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'deepseek-ok' || { echo "ds-claude-test: FAIL (probe text not echoed back: $(printf '%s' "$out" | head -c 200))" >&2; exit 1; }
  echo "ds-claude-test: ok (DeepSeek answers through the Claude harness: deepseek-ok)"
  exit 0
fi

if [ "$_have_key" != 1 ]; then
  echo "mesh-claude-deepseek: DEEPSEEK_API_KEY not set and $_keyfile missing — refusing (would fall back to Anthropic billing silently)" >&2
  exit 2
fi

export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-https://api.deepseek.com/anthropic}"
export ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY"
unset ANTHROPIC_API_KEY
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-deepseek-v4-flash[1m]}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-deepseek-v4-flash[1m]}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-deepseek-v4-flash[1m]}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-deepseek-v4-flash}"
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-deepseek-v4-flash}"
export CLAUDE_CODE_EFFORT_LEVEL="${CLAUDE_CODE_EFFORT_LEVEL:-max}"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-786432}"
# claude.ai connectors (OAuth login extras) cannot ride a third-party auth token — the harness warns
# about it on every invocation; say so once here instead of per-turn noise in mind panes.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"

exec "$HOME/.local/bin/claude" --permission-mode bypassPermissions "$@"
