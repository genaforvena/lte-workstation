#!/usr/bin/env bash
# mesh-review — INDEPENDENT verification. Feeds an artifact + criterion to FRESH-context agents
# (no steward context, no shared bias) and collects their independent verdicts. The operator's
# "independent reviewer side": a separate stage beyond the steward's own review. Diverse/adversarial
# by running more than one engine, each blind to the others and to the steward's reasoning.
#
#   mesh-review <file>  "<what to verify / criterion>"
#   echo "<text>" | mesh-review -  "<criterion>"
# Engines are one-shot commands (free pools first; claude is the limited budget, used sparingly).
#   mesh-review --test   smoke test (exit 0 ok / 2 n/a-no-engine-provisioned / 1 broken)
set -uo pipefail

if [ "${1:-}" = "--test" ]; then
  # Real dependency check: engine errors are swallowed (2>/dev/null) at run time, so a node
  # with zero working engines would emit hollow empty verdicts — catch that here instead.
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout — every engine call needs it)"; exit 1; }
  avail=""
  for e in claude opencode gemini; do command -v "$e" >/dev/null 2>&1 && avail="$avail $e"; done
  [ -n "$avail" ] || { echo "smoke-test: n/a (no review engine provisioned: gemini/opencode/claude)"; exit 2; }
  for e in $avail; do   # fastest-first order above; one responsive engine = reviews can run
    timeout 5 "$e" --version >/dev/null 2>&1 && { echo "smoke-test: ok (engines:$avail; verified: $e)"; exit 0; }
  done
  echo "smoke-test: FAIL (engines present but NONE responds to --version:$avail — reviews would be hollow)"; exit 1
fi

SRC="${1:?usage: mesh-review <file|-> <criterion>}"; shift; CRIT="$*"
[ -n "${CRIT// /}" ] || { echo "mesh-review: need a criterion" >&2; exit 1; }
if [ "$SRC" = - ]; then ART="$(cat)"; else [ -f "$SRC" ] || { echo "no file: $SRC" >&2; exit 1; }; ART="$(cat "$SRC")"; fi
PROMPT="Ты НЕЗАВИСИМЫЙ верификатор. У тебя НЕТ никакого контекста, кроме того, что ниже — оценивай ТОЛЬКО по нему, не додумывай. Будь строг и краток (максимум 6 строк): что верно; что НЕ так / сломано / упущено / опасно; и итоговый ВЕРДИКТ: ОК или НЕ-ОК (с одной фразой почему). Не доверяй на слово — ищи проблемы.

КРИТЕРИЙ ПРОВЕРКИ: ${CRIT}

=== АРТЕФАКТ ===
${ART}"
run_engine(){ # $1 label
  echo "── независимый верификатор: $1 ──"
  case "$1" in
    gemini)   timeout 160 gemini -p "$PROMPT" 2>/dev/null | grep -vaiE 'true color|warning' ;;
    opencode) timeout 160 opencode run "$PROMPT" 2>/dev/null | grep -vaE 'build ·|deepseek|^\s*$' | sed 's/\x1b\[[0-9;]*m//g' ;;
    claude)   timeout 200 claude -p "$PROMPT" 2>/dev/null ;;   # strongest reviewer; fresh context (separate process). Max plan = 5h-window limit, ample headroom.
  esac
  echo
}
run_engine gemini
run_engine opencode
run_engine claude
echo "(стюард: сверь вердикты независимых с собственным ревью; расхождение = копай.)"
