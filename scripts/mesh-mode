#!/usr/bin/env bash
# mesh-mode — set the mesh's operating mode (controls which minds run)
#
#   mesh-mode lean    steward only (Telegram + board; max quota savings)
#   mesh-mode normal  lean + health (recommended default)
#   mesh-mode full    all channels (operator-requested only)
#   mesh-mode status  show current mode
#
# Writes ~/.mesh/mode; mesh-restore + channel-keepalive read it.
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MODE_FILE="$HOME/.mesh/mode"
mkdir -p "$HOME/.mesh"

LEAN_WINS=(tg shell)
NORMAL_WINS=(tg shell health)
FULL_WINS=(tg shell health plan verify work dev discover sense)

stop_win() {
  local w="$1"
  tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$w" || return 0
  local pidx; pidx=$(tmux list-panes -t "$(hostname):$w" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
  tmux send-keys -t "$(hostname):${w}.${pidx}" "" 2>/dev/null || true
  echo "  stopped: $w"
}

case "${1:-status}" in
  lean)
    echo "lean" > "$MODE_FILE"
    echo "[mesh-mode] → LEAN (steward only)"
    for w in plan health verify work dev discover sense; do stop_win "$w"; done
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[mode] lean — only steward running; all other minds off" >/dev/null 2>&1 || true
    ;;
  normal)
    echo "normal" > "$MODE_FILE"
    echo "[mesh-mode] → NORMAL (steward + health)"
    for w in plan verify work dev discover sense; do stop_win "$w"; done
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[mode] normal — steward + health only" >/dev/null 2>&1 || true
    ;;
  full)
    echo "full" > "$MODE_FILE"
    echo "[mesh-mode] → FULL (all minds)"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[mode] full — all minds active" >/dev/null 2>&1 || true
    ;;
  status)
    mode="$(cat "$MODE_FILE" 2>/dev/null || echo lean)"
    echo "current mode: $mode"
    echo "active windows:"
    tmux list-windows -t "$(hostname)" -F '  #{window_name}' 2>/dev/null || echo "  (no session)"
    ;;
  *)
    echo "usage: mesh-mode lean|normal|full|status" >&2; exit 1;;
esac
