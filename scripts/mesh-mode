#!/usr/bin/env bash
# mesh-mode — genome-defined mind-set modes (dormant/focus/normal/sprint)
# Switches the crontab tick-set per mode to control burn (the operator's budget control).
# Mode table is GENOME-DEFINED (embedded in this tool, versioned with the genome).
#
#   mesh-mode               show current mode + status
#   mesh-mode <name>        switch to mode
#   mesh-mode --help        mode table + usage
#   mesh-mode --test        deps + dry-run switch test
#   mesh-mode --list        list available modes
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MODE_FILE="$HOME/.mesh/mode"
CRONTAB_BAK="$HOME/.mesh/crontab-pre-switch.bak"
STAMP(){ date -u +%FT%TZ; }

[ "${1:-}" = --test ] && {
  command -v crontab >/dev/null 2>&1 || { echo "smoke-test: FAIL (no crontab)"; exit 1; }
  command -v flock  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no flock)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  HOME="$tmp" mkdir -p "$tmp/.mesh"
  echo dormant > "$tmp/.mesh/mode"
  self="$(command -v "$0" 2>/dev/null)"; [ -x "$self" ] || self="$0"
  out="$(HOME="$tmp" timeout 10 "$self" 2>&1)" || { echo "smoke-test: FAIL (show mode failed: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'dormant' || { echo "smoke-test: FAIL (no dormant in output: $out)"; exit 1; }
  # dry-run: populates crontab with one tick line
  self="$(command -v "$0" 2>/dev/null)"; [ -x "$self" ] || self="$0"
  cat > "$tmp/crontab.dry" <<'EOF'
*/4 * * * * $HOME/.local/bin/mesh-tick-gate health 60 local health check
*/10 * * * * $HOME/.local/bin/mesh-mind-state --watch
2-59/7 * * * * $HOME/.local/bin/mesh-tick local work general
1-59/5 * * * * $HOME/.local/bin/mesh-generate
EOF
  # SAVE + INSTALL test crontab (must restore before exit to avoid wiping user's crontab)
  test_cron_orig="$(crontab -l 2>/dev/null || true)"
  crontab "$tmp/crontab.dry" 2>/dev/null
  dry_out="$(HOME="$tmp" DRY_RUN=1 timeout 10 "$self" dormant 2>&1)" || true
  printf '%s\n' "$dry_out" | grep -q 'MODE=dormant' || {
    printf '%s\n' "$test_cron_orig" | crontab -
    printf 'FAIL: output was:\n%s\n' "$dry_out"; echo "smoke-test: FAIL (switch dormant dry-run failed)"; exit 1
  }
  # Restore original crontab
  printf '%s\n' "$test_cron_orig" | crontab -
  echo "smoke-test: ok"; exit 0
}

# ── Mode table ──────────────────────────────────────────────────
# GENOME-DEFINED. Each mode lists the tick PATTERNS (grep -E) that stay ACTIVE.
# All other tick lines are COMMENTED OUT (preserved as comments, not deleted).
# Lines that don't match any tick pattern (custom crontab entries) pass through unchanged.
declare -A MODE_LABEL
MODE_LABEL[dormant]="plan(15min) + health + compact + generate + keepalive + mind-state + reflexes"
MODE_LABEL[focus]="dormant + work"
MODE_LABEL[normal]="dormant + work + dev + plan + minds(general)"
MODE_LABEL[sprint]="all minds at accelerated cadence"

# Patterns: grep -E match against each crontab LINE (not just the command).
# A line matches if the pattern appears ANYWHERE (in comment, command, schedule).
# dormant: only essential infrastructure ticks
DORMANT_PAT='tick-gate|mind-state|mind-compact|mesh-generate|mesh-reflexes|mesh-cell-info|mesh-immune-watcher|mesh-window-repair|mesh-mind-keepalive|mesh-tick\s+local\s+plan\s+plan|mesh-tick\s+imozerov@.*\s+plan'

# focus: dormant + ONE worker (work)
FOCUS_PAT="${DORMANT_PAT}|mesh-tick\s+local\s+work"

# normal: full production set
NORMAL_PAT="${DORMANT_PAT}|mesh-tick\s+local\s+work|mesh-tick\s+local\s+dev|mesh-tick\s+local\s+minds|mesh-tick\s+imozerov@.*\s+plan"

# sprint: everything (pass-all)
SPRINT_PAT='.'

declare -A MODE_PAT
MODE_PAT[dormant]="$DORMANT_PAT"
MODE_PAT[focus]="$FOCUS_PAT"
MODE_PAT[normal]="$NORMAL_PAT"
MODE_PAT[sprint]="$SPRINT_PAT"

VALID_MODES=(dormant focus normal sprint)
# ────────────────────────────────────────────────────────────────

show_mode(){
  local cur="" cur_mode="" status=""
  cur=$(cat "$MODE_FILE" 2>/dev/null || echo "unknown")
  # normalize: if MODE_FILE content matches a valid mode
  for m in "${VALID_MODES[@]}"; do [ "$cur" = "$m" ] && cur_mode="$m"; done
  [ -z "$cur_mode" ] && cur_mode="unknown (file: $cur)"
  if [ -f "$MODE_FILE" ]; then
    status="$(cat "$MODE_FILE")"
  else
    status="no mode file — defaulting to dormant"
  fi
  printf 'MODE=%s\n' "$status"
  printf 'LABEL=%s\n' "${MODE_LABEL[$status]:-unknown}"
  if [ "${DRY_RUN:-0}" = 1 ]; then
    printf '[dry-run] mode would switch: %s\n' "${1:-}"
  fi
}

list_modes(){
  echo "Available modes (genome-defined):"
  for m in "${VALID_MODES[@]}"; do
    printf '  %-10s %s\n' "$m" "${MODE_LABEL[$m]}"
  done
}

switch_mode(){
  local target="$1"
  local valid=0
  for m in "${VALID_MODES[@]}"; do [ "$target" = "$m" ] && valid=1; done
  [ "$valid" = 1 ] || { echo "ERROR: unknown mode '$target'. Valid: ${VALID_MODES[*]}" >&2; exit 1; }

  lock="$HOME/.mesh/.mode-switch.lock"; exec 9>"$lock"
  flock -n 9 || { echo "$(STAMP) SKIP: another mode switch in progress" >&2; exit 0; }

  # Backup current crontab
  crontab -l > "$CRONTAB_BAK" 2>/dev/null || { echo "WARN: no crontab to back up" >&2; CRONTAB_BAK=/dev/null; }
  local pat="${MODE_PAT[$target]}"
  local tmp_file filtered_file
  tmp_file=$(mktemp) || { echo "ERROR: mktemp failed" >&2; exit 1; }
  filtered_file=$(mktemp) || { echo "ERROR: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$tmp_file" "$filtered_file"' RETURN

  [ "${DRY_RUN:-0}" = 1 ] && {
    crontab -l 2>/dev/null || true
  } > "$tmp_file"
  [ "${DRY_RUN:-0}" != 1 ] && {
    crontab -l 2>/dev/null || true
  } > "$tmp_file"

  # Process each line:
  # - Empty/comment lines pass through unchanged
  # - Tick lines (matching known tools) are kept only if pattern matches
  # - Non-tick lines pass through unchanged (user's custom crontab entries)
  while IFS= read -r line || [ -n "$line" ]; do
    local trimmed
    trimmed="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    # pass empty, pure-comment lines
    case "$trimmed" in ''|'#'*) printf '%s\n' "$line"; continue;; esac
    # check if it's a tick-like line (contains mesh-tick or mesh-mind or mesh-generate)
    case "$line" in
      *mesh-tick*|*mesh-mind-*|*mesh-generate*|*mesh-reflexes*|*mesh-cell-info*|*mesh-immune-watcher*|*mesh-window-repair*|*mesh-mind-compact*)
        if printf '%s' "$line" | grep -qE "$pat"; then
          # Ensure it's NOT commented
          case "$trimmed" in '#') printf '%s\n' "$line"; continue;; esac
          printf '%s\n' "$line"
        else
          # Comment out (or keep if already commented)
          case "$trimmed" in '#') printf '%s\n' "$line";; *) printf '# (inactive in mode %s) %s\n' "$target" "$line";; esac
        fi
        ;;
      *)
        # Non-tick line — pass through unchanged
        printf '%s\n' "$line"
        ;;
    esac
  done < "$tmp_file" > "$filtered_file"

  if [ "${DRY_RUN:-0}" = 1 ]; then
    printf 'MODE=%s (dry-run, crontab not modified)\n' "$target"
    printf '[dry-run] crontab after switch to %s:\n' "$target"
    cat "$filtered_file"
  else
    # Install filtered crontab
    crontab "$filtered_file" 2>/dev/null || { echo "ERROR: crontab install failed" >&2; exit 1; }
    # Write mode state
    printf '%s' "$target" > "$MODE_FILE"
    echo "$(STAMP) MODE=$target (active minds: ${MODE_LABEL[$target]})" >> "$HOME/.mesh/mode.log"
    printf 'MODE=%s (%s)\n' "$target" "${MODE_LABEL[$target]}"
  fi
}

# ── main ──
case "${1:-}" in
  --help|help|'')
    echo "usage: mesh-mode [<mode>]"
    echo "       mesh-mode --list"
    echo "       mesh-mode --help"
    echo
    echo "Genome-defined modes control which tick minds are active."
    echo "Default (no arg): show current mode."
    echo
    echo "Modes:"
    list_modes
    echo
    echo "File: $MODE_FILE"
    echo "Backup: $CRONTAB_BAK"
    [ -n "${1:-}" ] || show_mode
    ;;
  --list|-l)
    list_modes
    ;;
  dormant|focus|normal|sprint)
    switch_mode "${1}"
    ;;
  *)
    show_mode
    ;;
esac
