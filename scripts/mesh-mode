#!/usr/bin/env bash
# mesh-mode — durable quota-budget mode switch: dormant / focus / normal / sprint
#
#   mesh-mode dormant   plan-slow only (DEFAULT — conserve quota; overnight)
#   mesh-mode focus     dormant + 1 worker (one directed task)
#   mesh-mode normal    work + plan + dev at balanced cadence
#   mesh-mode sprint    all minds at fastest (knowingly fast burn)
#   mesh-mode status    show current mode + active tick lines
#   mesh-mode --test    smoke test
#
# Edits ~/.mesh/reflexes.cron (durable) AND the live crontab.
# mesh-restore (runs */5) heals crontab FROM reflexes.cron — a crontab-only edit reverts
# within 5 minutes, so we always write reflexes.cron first.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

RCRON="$HOME/.mesh/reflexes.cron"
MODE_FILE="$HOME/.mesh/mode"
mkdir -p "$HOME/.mesh"

# cron tick lines per mode — $HOME is literal (cron expands it via the crontab PATH)
# shellcheck disable=SC2016
tick_lines() {
  case "${1:?mode required}" in
    dormant)
      printf '%s\n' \
        '5-59/30 * * * * $HOME/.local/bin/mesh-tick local plan plan >> $HOME/.mesh/tick.log 2>&1'
      ;;
    focus)
      printf '%s\n' \
        '5-59/30 * * * * $HOME/.local/bin/mesh-tick local plan plan >> $HOME/.mesh/tick.log 2>&1' \
        '2-59/20 * * * * $HOME/.local/bin/mesh-tick local work general >> $HOME/.mesh/tick.log 2>&1'
      ;;
    normal)
      printf '%s\n' \
        '2-59/7 * * * * $HOME/.local/bin/mesh-tick local work general >> $HOME/.mesh/tick.log 2>&1' \
        '5-59/15 * * * * $HOME/.local/bin/mesh-tick local plan plan >> $HOME/.mesh/tick.log 2>&1' \
        '7-59/11 * * * * $HOME/.local/bin/mesh-tick local dev general >> $HOME/.mesh/tick.log 2>&1'
      ;;
    sprint)
      printf '%s\n' \
        '2-59/5 * * * * $HOME/.local/bin/mesh-tick local work general >> $HOME/.mesh/tick.log 2>&1' \
        '3-59/7 * * * * $HOME/.local/bin/mesh-tick local plan plan >> $HOME/.mesh/tick.log 2>&1' \
        '4-59/5 * * * * $HOME/.local/bin/mesh-tick local dev general >> $HOME/.mesh/tick.log 2>&1'
      ;;
    *) echo "unknown mode: $1" >&2; return 1 ;;
  esac
}

# Derive mode from active (uncommented) mesh-tick lines in reflexes.cron
detect_mode() {
  [ -f "$RCRON" ] || { echo "no-cron"; return; }
  local active; active=$(grep -v '^[[:space:]]*#' "$RCRON" | grep 'mesh-tick local' || true)
  local nw np nd
  nw=$(printf '%s\n' "$active" | grep -c 'mesh-tick local work' || true)
  np=$(printf '%s\n' "$active" | grep -c 'mesh-tick local plan' || true)
  nd=$(printf '%s\n' "$active" | grep -c 'mesh-tick local dev'  || true)
  if   [ "$nw" -eq 0 ] && [ "$nd" -eq 0 ] && [ "$np" -le 1 ]; then
    echo "dormant"
  elif [ "$nw" -ge 1 ] && [ "$nd" -eq 0 ]; then
    echo "focus"
  elif [ "$nw" -ge 1 ] && [ "$nd" -ge 1 ]; then
    local sprint_w; sprint_w=$(printf '%s\n' "$active" | grep 'mesh-tick local work' | grep -c '/5' || true)
    [ "$sprint_w" -ge 1 ] && echo "sprint" || echo "normal"
  else
    echo "custom"
  fi
}

apply_mode() {
  local mode="$1"
  [ -f "$RCRON" ] || { echo "mesh-mode: no reflexes.cron at $RCRON" >&2; exit 1; }
  local tmp; tmp=$(mktemp "${RCRON}.XXXXXX")
  # Strip all mesh-tick local lines (active or commented: [DORMANT], [mesh-mode:], etc.)
  # and the mesh-mode section-header comments we add
  grep -v 'mesh-tick local' "$RCRON" | grep -v '^# \[mesh-mode:' > "$tmp"
  # Append new section
  printf '# [mesh-mode: %s — %s]\n' "$mode" "$(date -u +%Y-%m-%dT%H:%MZ)" >> "$tmp"
  tick_lines "$mode" >> "$tmp"
  mv "$tmp" "$RCRON"
  # Apply to live crontab (mesh-reflexes --apply if available, else direct)
  if command -v mesh-reflexes >/dev/null 2>&1; then
    mesh-reflexes --apply 2>/dev/null || crontab "$RCRON"
  else
    crontab "$RCRON"
  fi
  printf '%s\n' "$mode" > "$MODE_FILE"
}

case "${1:-status}" in
  dormant|focus|normal|sprint)
    mode="$1"
    printf '[mesh-mode] → %s\n' "${mode^^}"
    apply_mode "$mode"
    command -v mesh-chat >/dev/null 2>&1 && \
      mesh-chat "[mode] ${mode} — $(tick_lines "$mode" | wc -l) tick line(s) active" >/dev/null 2>&1 || true
    echo "applied — verify: crontab -l | grep mesh-tick"
    ;;
  status)
    mode="$(cat "$MODE_FILE" 2>/dev/null || detect_mode)"
    echo "current mode: $mode"
    echo "active tick lines:"
    if [ -f "$RCRON" ]; then
      grep -v '^[[:space:]]*#' "$RCRON" | grep 'mesh-tick local' | sed 's/^/  /' || echo "  (none)"
    else echo "  (no reflexes.cron)"; fi
    ;;
  --test)
    errs=0
    [ -f "$RCRON" ] || { echo "smoke-test: n/a (no reflexes.cron at $RCRON)"; exit 2; }
    command -v crontab >/dev/null 2>&1 || { echo "smoke-test: FAIL (no crontab)"; errs=$((errs+1)); }
    for m in dormant focus normal sprint; do
      tick_lines "$m" >/dev/null 2>&1 || { echo "smoke-test: FAIL (tick_lines $m broken)"; errs=$((errs+1)); }
    done
    [ "$errs" -eq 0 ] && echo "smoke-test: ok" && exit 0
    exit 1
    ;;
  *)
    echo "usage: mesh-mode dormant|focus|normal|sprint|status" >&2; exit 1 ;;
esac
