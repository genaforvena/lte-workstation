#!/usr/bin/env bash
# mesh-blessyou-rec — record a REAL person saying "bless you" into the clip library.
# Run it for each person so the reflex has different voices to draw from.
#   mesh-blessyou-rec alice       # 3s clip -> ~/.mesh/blessyou/alice.wav
#   mesh-blessyou-rec bob 4       # 4-second clip
set -uo pipefail
NAME="${1:-voice-$(date +%s)}"
DUR="${2:-3}"
DIR="$HOME/.mesh/blessyou"; mkdir -p "$DIR"
OUT="$DIR/$NAME.wav"
echo "Recording ${DUR}s into $OUT — say 'bless you' now..."
arecord -q -f S16_LE -r 22050 -c 1 -d "$DUR" "$OUT"
echo "saved: $OUT ($(stat -c%s "$OUT" 2>/dev/null) bytes). Play back: aplay '$OUT'"
