#!/usr/bin/env bash
# mesh-blessyou-rec — record a REAL person saying "bless you" into the clip library.
# Run it for each person so the reflex has different voices to draw from.
#   mesh-blessyou-rec alice       # 3s clip -> ~/.mesh/blessyou/alice.wav
#   mesh-blessyou-rec bob 4       # 4-second clip
set -uo pipefail
[ "${1:-}" = --test ] && { command -v arecord >/dev/null 2>&1 || { echo "smoke-test: n/a (no arecord on this node)"; exit 2; }; echo "smoke-test: ok"; exit 0; }
NAME="${1:-voice-$(date +%s)}"
DUR="${2:-3}"
DIR="$HOME/.mesh/blessyou"; mkdir -p "$DIR"
OUT="$DIR/$NAME.wav"
echo "Recording ${DUR}s into $OUT — say 'bless you' now..."
MESH_TRACE="$HOME/.local/bin/mesh-trace"
[ -x "$MESH_TRACE" ] && MESH_WHO="mesh-blessyou-rec@$(hostname)" "$MESH_TRACE" "[sense] START: recording blessing clip '$NAME'" >/dev/null 2>&1 || true
arecord -q -f S16_LE -r 22050 -c 1 -d "$DUR" "$OUT"
SZ=$(stat -c%s "$OUT" 2>/dev/null || echo 0)
[ -x "$MESH_TRACE" ] && MESH_WHO="mesh-blessyou-rec@$(hostname)" "$MESH_TRACE" "[sense] STOP: recorded blessing clip '$NAME' (${SZ}B)" >/dev/null 2>&1 || true
echo "saved: $OUT (${SZ} bytes). Play back: aplay '$OUT'"
