#!/usr/bin/env bash
# mesh-phone-collect — drain the phone BODY's roaming capture log into the mesh.
#
# The phone runs mesh-phone-capture (a reboot-safe Termux:Boot loop) which writes append-only
# JSON rows to ~/.mesh/away-track.log ON THE PHONE — capture survives even when the phone is
# unreachable (away on LTE, WG flapping). This is the COLLECTION half: it reaches the phone the
# best way available and pulls the new rows into ~/.mesh/phone-track.log on the mind node.
#
# Reach order (the phone roams, so the path changes):
#   1) LAN  — u0_a380@<lan-ip>:8022           (home: phone on the home wifi)
#   2) WG   — u0_a380@10.66.66.10:8022 via phaedra jump  (away: phone on LTE, in the mesh by WG)
# Honest: if BOTH paths fail, log [phone-unreachable] and exit 2 — never fake a silent success.
#
# Offset-tracked by line count (~/.mesh/.phone-track.offset) so each run pulls only NEW rows.
#
# reflex-cadence: */10 * * * *
set -u
export PATH="$HOME/.local/bin:$PATH"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v wc >/dev/null 2>&1 || { echo "smoke-test: FAIL (no wc)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  # dry-run: synthetic fixtures exercise the probe()→fetch()→offset pipeline for each path
  _f=0; _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  # mock ssh: swallow all args, interpret last argument as the command
  cat > "$_td/ssh" <<'MOCK'
#!/usr/bin/env bash
# Extract the final positional arg (the actual remote command) by consuming flag→value pairs
while [ $# -gt 0 ]; do
  case "$1" in
    -o) shift 2;;            # -o Option=Value → consume 2
    -p) shift 2;;            # -p PORT → consume 2
    -J) shift 2;;            # -J jump → consume 2
    -*) shift;;              # any other flag → consume 1
    *@*) shift;;             # user@host → consume 1
    *)  break;;              # first non-flag/non-host arg → the command
  esac
done
cmd="$*"
case "$cmd" in
  "echo ok") echo ok; exit 0;;
  *wc\ -l*) [ -n "${TEST_FIXTURE:-}" ] && wc -l < "$TEST_FIXTURE" || echo 0; exit 0;;
  *tail*)   [ -n "${TEST_FIXTURE:-}" ] && cat "$TEST_FIXTURE"; exit 0;;
esac
exit 1
MOCK
  chmod +x "$_td/ssh"
  # mock adb: always responds as connected
  cat > "$_td/adb" <<'MOCKA'
#!/usr/bin/env bash
case "${1:-}" in
  get-state) echo device; exit 0;;
  forward) exit 0;;
  *) exit 1;;
esac
MOCKA
  chmod +x "$_td/adb"
  # 3-row synthetic phone log
  cat > "$_td/phone.log" <<'FIX'
{"t":"2026-06-18T10:00:00Z","mode":"home","bat":85}
{"t":"2026-06-18T11:00:00Z","mode":"away","bat":72}
{"t":"2026-06-18T12:00:00Z","mode":"home","bat":90}
FIX
  # run sandboxed — HOME points into tmp so offset/OUT are clean
  _sandbox() { PATH="$_td:$PATH" HOME="$_td" TEST_FIXTURE="$_td/phone.log" MESH_PHONE_LAN_IP=127.0.0.1 MESH_PHONE_ADB_LPORT=9999 "$@"; }
  # Test 1: ADB path succeeds → collect all 3 rows
  _out="$(_sandbox "${BASH_SOURCE[0]}" 2>/dev/null)" || { echo "  FAIL: ADB path errored"; _f=1; }
  echo "$_out" | grep -q 'collected 3 new rows via ADB' || { echo "  FAIL: ADB collection (got: $_out)"; _f=1; }
  [ -f "$_td/.mesh/phone-track.log" ] || { echo "  FAIL: ADB no output log"; _f=1; }
  [ "$(wc -l < "$_td/.mesh/phone-track.log")" -eq 3 ] || { echo "  FAIL: ADB wrong row count"; _f=1; }
  # Test 2: Offset tracking — offset at 3 → collect 0 new rows
  printf 3 > "$_td/.mesh/.phone-track.offset"
  _out2="$(_sandbox "${BASH_SOURCE[0]}" 2>/dev/null)" || { echo "  FAIL: offset path errored"; _f=1; }
  echo "$_out2" | grep -q 'no new rows' || { echo "  FAIL: offset tracking (got: $_out2)"; _f=1; }
  # Test 3: All paths fail → exit 2
  cat > "$_td/adb" <<'MOCKB'
#!/usr/bin/env bash
exit 1
MOCKB
  cat > "$_td/ssh" <<'MOCKC'
#!/usr/bin/env bash
exit 1
MOCKC
  chmod +x "$_td/adb" "$_td/ssh"
  _sandbox "${BASH_SOURCE[0]}" 2>/dev/null; _ec=$?
  [ "$_ec" = 2 ] || { echo "  FAIL: all-paths-down should exit 2 (got $_ec)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (phone-collect pipeline drifted)"; exit 1; }
  echo "smoke-test: ok (ADB path + offset + all-down: 3 scenarios)"; exit 0
fi

LAN_IP="${MESH_PHONE_LAN_IP:-192.168.8.203}"
WG_IP="${MESH_PHONE_WG_IP:-10.66.66.10}"
JUMP="${MESH_PHONE_JUMP:-root@100.94.116.17}"
PORT="${MESH_PHONE_SSH_PORT:-8022}"
ADB_LP="${MESH_PHONE_ADB_LPORT:-8023}"     # local port forwarded → phone:8022 via adb
USER_="${MESH_PHONE_USER:-u0_a380}"
REMOTE_LOG="${MESH_PHONE_REMOTE_LOG:-.mesh/away-track.log}"
OUT="$HOME/.mesh/phone-track.log"
OFF="$HOME/.mesh/.phone-track.offset"
SSHO="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
mkdir -p "$HOME/.mesh"

# Candidate transports (the phone roams + its reachability changed with the full-tunnel WG):
#   ADB — adb-over-wifi forward → phone:8022. THE home path now: the WG full-tunnel routes the
#         phone's TCP SYN-ACK out the tunnel, so direct LAN-TCP to :8022 TIMES OUT (ICMP still
#         works). adbd is a system daemon, NOT subject to the per-app VPN → reliable at home.
#   LAN — direct (works only if WG is OFF / not full-tunnel); kept as a fallback.
#   WG  — via phaedra jump (away). NOTE: Android blocks INBOUND TCP over the full-tunnel, so this
#         usually fails; left in so away rows drain whenever inbound ever does work.
ensure_adb(){
  command -v adb >/dev/null 2>&1 || return 1
  adb get-state >/dev/null 2>&1 || return 1
  adb forward tcp:"$ADB_LP" tcp:"$PORT" >/dev/null 2>&1 || return 1
  return 0
}
try_adb(){ timeout 25 ssh $SSHO -p "$ADB_LP" "${USER_}@127.0.0.1" "$1"; }
try_lan(){ timeout 20 ssh $SSHO -p "$PORT" "${USER_}@${LAN_IP}" "$1"; }
try_wg(){  timeout 30 ssh $SSHO -J "$JUMP" -p "$PORT" "${USER_}@${WG_IP}" "$1"; }

PATHTAG=""
probe(){
  # returns 0 + sets PATHTAG when a path answers (cheapest/most-reliable first)
  if ensure_adb && try_adb 'echo ok' >/dev/null 2>&1; then PATHTAG=ADB; return 0; fi
  if try_lan 'echo ok' >/dev/null 2>&1; then PATHTAG=LAN; return 0; fi
  if try_wg  'echo ok' >/dev/null 2>&1; then PATHTAG=WG;  return 0; fi
  return 1
}
fetch(){
  case "$PATHTAG" in
    ADB) try_adb "$1";;
    LAN) try_lan "$1";;
    *)   try_wg  "$1";;
  esac
}

if ! probe; then
  echo "$(ts) [phone-unreachable] no ADB, LAN or WG path" >> "$HOME/.mesh/phone-collect.log"
  command -v mesh-chat >/dev/null 2>&1 && : # silent — unreachable phone is routine, no board spam
  exit 2
fi

# total rows on the phone now
total=$(fetch "wc -l < $REMOTE_LOG 2>/dev/null" | tr -dc '0-9')
[ -z "$total" ] && { echo "$(ts) [collect] no remote log yet ($PATHTAG)" >> "$HOME/.mesh/phone-collect.log"; exit 0; }
last=$(cat "$OFF" 2>/dev/null | tr -dc '0-9'); last=${last:-0}
# phone rebooted / log rotated => offset past end => reset
[ "$total" -lt "$last" ] && last=0

if [ "$total" -gt "$last" ]; then
  new=$(fetch "tail -n +$((last+1)) $REMOTE_LOG 2>/dev/null")
  if [ -n "$new" ]; then
    printf '%s\n' "$new" >> "$OUT"
    printf '%s' "$total" > "$OFF"
    n=$(( total - last ))
    echo "$(ts) [collect] +$n rows via $PATHTAG (total $total)" >> "$HOME/.mesh/phone-collect.log"
    echo "collected $n new rows via $PATHTAG"
  fi
else
  echo "no new rows (total $total) via $PATHTAG"
fi
