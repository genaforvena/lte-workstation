#!/usr/bin/env bash
# mesh-phone-collect — drain the phone BODY's roaming capture log into the mesh.
#
# The phone runs mesh-phone-capture (a reboot-safe Termux:Boot loop) which writes append-only
# JSON rows to ~/.mesh/away-track.log ON THE PHONE — capture survives even when the phone is
# unreachable (away on LTE, WG flapping). This is the COLLECTION half: it reaches the phone the
# best way available and pulls the new rows into ~/.mesh/phone-track.log on the mind node.
#
# THE VERDICT IS ABOUT THE CANDIDATE LIST, NEVER ABOUT "THE PHONE" (fixed 2026-08-21, incident
# phone-collect-blind-to-the-working-path). For 37.3 days this tool logged "[phone-unreachable] no
# ADB, LAN or WG path" on 3056 of 3061 runs (99.84%) — one single successful collect in its whole
# life — while the phone answered ssh over TAILSCALE in half a second. The tailscale address was
# never in the candidate list at all: the LAN failure had been diagnosed (see the full-tunnel note
# below) and TWO workarounds bolted on, and the one path that works WITHOUT a workaround was never
# added. The probe answered "these three transports are down" and printed it as a claim about the
# PHONE — our own a-probe-that-answers-a-different-question-in-the-same-type, and downstream
# (mesh-presence / mesh-operator-context) read the log as "the phone is away".
#
# Two structural consequences, both load-bearing — do not undo either:
#   1. The candidate ladder is NOT a private list here. The ts/lan rungs come from
#      phone_reach_candidates (mesh-patterns.sh), the mesh's ONE deduped phone-address ladder,
#      which already knew the tailnet address. A new phone address added to ~/.mesh/nodes flows in
#      by itself; a private constant here would rot exactly the way the old three-transport list did.
#   2. The refusal line ENUMERATES every candidate by name with its own outcome word, and it is
#      RENDERED FROM THE SAME ARRAY that was probed — so "unreachable" structurally means "all
#      known paths tried", a missing transport is visible by eye in the log itself, and refused
#      (host up, sshd not running — needs a tap) never again collapses into timeout (no path).
#
# Reach order (the phone roams, so the path changes) — TS first, measured 2026-08-21 as the only
# path that answers without a workaround; ADB/LAN/WG follow. See the transport notes at CANDIDATES.
#
# Offset-tracked by line count (~/.mesh/.phone-track.offset) so each run pulls only NEW rows.
#
# reflex-cadence: */10 * * * *
set -u
export PATH="$HOME/.local/bin:$PATH"

# ── THE TAPE'S OWN INTEGRITY — corruption here is SILENT and it hides the FUTURE, not the past ──
# ~/.mesh/phone-collect.log is this tool's tape and this tool is its only writer, so nobody else can
# notice it going bad. It has twice acquired a NUL span (ext4 delayed-alloc crash loss on a
# power-cycling node — the mechanism in [[nul-spans-in-an-append-log-are-crash-loss-not-a-race]]),
# and the CONSEQUENCE is this tape's own: the corruption does not break a row, it HIDES EVERY ROW
# AFTER IT. GNU grep declares the file binary at the first NUL and stops printing, and the
# "binary file matches" notice does not survive a pipe. Measured 2026-08-29 on a 273897-byte tape
# whose newest row was 20:50:12Z: `grep phone-unreachable log | tail -1` answered
# 2026-07-29T02:10:12Z — rc 0, well-formed timestamp, intact row, 29 DAYS STALE, and nothing in the
# answer looks broken. A bare `tail -1` is unaffected, so one reader of this tape can be right while
# the reader beside it is a month behind. A hand hits it too: the first grep of the investigation
# window did.
# This check is a SENSE, never a repair: it never rewrites the tape. A repair must go RECORD BY
# RECORD (a lost record has to read as an ABSENT row, never be glued to its neighbour, which is
# exactly what `tr -d '\0'` would do). It runs BEFORE the path ladder branches, so it fires on
# every cadence whatever this run's outcome turns out to be.
tape_nul_check(){   # <tape> → 0 clean / 1 corrupt (loud); never modifies the file
  local tape="${1:-$HOME/.mesh/phone-collect.log}" raw stripped off
  [ -r "$tape" ] || return 0
  raw="$(wc -c < "$tape" 2>/dev/null || echo 0)"
  stripped="$(tr -d '\0' < "$tape" 2>/dev/null | wc -c || echo "$raw")"
  [ "$raw" = "$stripped" ] && return 0
  off="$(LC_ALL=C python3 -c 'import sys;b=open(sys.argv[1],"rb").read();print(b.find(b"\x00"))' "$tape" 2>/dev/null || echo '?')"
  local msg="mesh-phone-collect: TAPE IS BINARY — $((raw - stripped)) NUL byte(s), first at offset $off in $tape. Every default grep of this tape stops printing THERE and silently answers with a row from before the span (rc 0, intact, arbitrarily stale). Readers must use grep -a; repair RECORD BY RECORD, never tr -d."
  echo "$msg" >&2
  command -v mesh-trace >/dev/null 2>&1 && mesh-trace "$msg" >/dev/null 2>&1 || true
  return 1
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v wc >/dev/null 2>&1 || { echo "smoke-test: FAIL (no wc)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  _f=0; _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  # mock ssh: swallow all args, interpret last argument as the command.
  # It RECORDS the host so a scenario can make exactly one transport answer — the old mock said "ok"
  # to every host, which is precisely the shape that cannot see a missing transport.
  cat > "$_td/ssh" <<'MOCK'
#!/usr/bin/env bash
# Extract the final positional arg (the actual remote command) by consuming flag→value pairs
host=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) shift 2;;            # -o Option=Value → consume 2
    -p) shift 2;;            # -p PORT → consume 2
    -J) shift 2;;            # -J jump → consume 2
    -*) shift;;              # any other flag → consume 1
    *@*) host="${1#*@}"; shift;;   # user@host → consume 1, remember the host
    *)  break;;              # first non-flag/non-host arg → the command
  esac
done
# TEST_OK_HOST unset = answer for any host (scenarios 1-2). Set = only that host answers.
if [ -n "${TEST_OK_HOST:-}" ] && [ "$host" != "$TEST_OK_HOST" ]; then
  if [ "$host" = 127.0.0.1 ]; then echo "Connection closed by 127.0.0.1 port 9999" >&2   # adb-forward dialect
  else echo "ssh: connect to host $host port 8022: Connection timed out" >&2; fi
  exit 255
fi
cmd="$*"
case "$cmd" in
  "echo ok") echo ok; exit 0;;
  *wc\ -l*) [ -n "${TEST_FIXTURE:-}" ] && wc -l < "$TEST_FIXTURE" || echo 0; exit 0;;
  *tail*)   [ -n "${TEST_FIXTURE:-}" ] && cat "$TEST_FIXTURE"; exit 0;;
esac
exit 1
MOCK
  chmod +x "$_td/ssh"
  # mock adb: always responds as connected
  cat > "$_td/adb" <<'MOCKA'
#!/usr/bin/env bash
case "${1:-}" in
  get-state) echo device; exit 0;;
  forward) exit 0;;
  *) exit 1;;
esac
MOCKA
  chmod +x "$_td/adb"
  # Stub the two REAL inputs of the shared ladder (mesh-peer-addr + tailscale) rather than injecting
  # a candidate list: the assembly code under test is phone_reach_candidates itself. Default = both
  # silent, so scenarios 1-3 see no ts rung; scenario 4 makes mesh-peer-addr yield one.
  cat > "$_td/mesh-peer-addr" <<'MOCKP'
#!/usr/bin/env bash
[ -n "${TEST_TS_SLOT:-}" ] && { echo "$TEST_TS_SLOT"; exit 0; }
exit 1
MOCKP
  printf '#!/usr/bin/env bash\nexit 1\n' > "$_td/tailscale"
  chmod +x "$_td/mesh-peer-addr" "$_td/tailscale"
  # 3-row synthetic phone log
  cat > "$_td/phone.log" <<'FIX'
{"t":"2026-06-18T10:00:00Z","mode":"home","bat":85}
{"t":"2026-06-18T11:00:00Z","mode":"away","bat":72}
{"t":"2026-06-18T12:00:00Z","mode":"home","bat":90}
FIX
  # run sandboxed — HOME points into tmp so offset/OUT are clean
  _self="${BASH_SOURCE[0]}"; _pat="$(dirname "$_self")/mesh-patterns.sh"
  _sandbox() { PATH="$_td:$PATH" HOME="$_td" TEST_FIXTURE="$_td/phone.log" MESH_PATTERNS="$_pat" \
      PHONE_LAN_IPS="" MESH_PHONE_LAN_IP=10.7.7.7 MESH_PHONE_ADB_LPORT=9999 "$@"; }
  # Test 1: ADB path succeeds → collect all 3 rows
  _out="$(_sandbox "$_self" 2>/dev/null)" || { echo "  FAIL: ADB path errored"; _f=1; }
  echo "$_out" | grep -q 'collected 3 new rows via adb' || { echo "  FAIL: ADB collection (got: $_out)"; _f=1; }
  [ -f "$_td/.mesh/phone-track.log" ] || { echo "  FAIL: ADB no output log"; _f=1; }
  [ "$(wc -l < "$_td/.mesh/phone-track.log")" -eq 3 ] || { echo "  FAIL: ADB wrong row count"; _f=1; }
  # Test 2: Offset tracking — offset at 3 → collect 0 new rows
  printf 3 > "$_td/.mesh/.phone-track.offset"
  _out2="$(_sandbox "$_self" 2>/dev/null)" || { echo "  FAIL: offset path errored"; _f=1; }
  echo "$_out2" | grep -q 'no new rows' || { echo "  FAIL: offset tracking (got: $_out2)"; _f=1; }
  # Test 4 (before the all-down teardown, which destroys the mocks): THE INCIDENT GATE.
  # A phone that answers on a transport the tool does not try is declared unreachable. adb is down,
  # LAN and WG time out, and ONLY the tailnet address answers — exactly the live 2026-08-21 state.
  # Against the pre-fix three-transport list this arm exits 2 (RED): there was no ts candidate at all.
  cat > "$_td/adb" <<'MOCKB'
#!/usr/bin/env bash
exit 1
MOCKB
  chmod +x "$_td/adb"
  rm -f "$_td/.mesh/.phone-track.offset"
  _out4="$(TEST_TS_SLOT=100.100.100.100 TEST_OK_HOST=100.100.100.100 \
      _sandbox "$_self" 2>/dev/null)"; _ec4=$?
  [ "$_ec4" = 0 ] || { echo "  FAIL: reachable-only-over-ts declared unreachable (rc=$_ec4)"; _f=1; }
  echo "$_out4" | grep -q 'via ts' || { echo "  FAIL: ts transport not used (got: $_out4)"; _f=1; }
  # TAPE-INTEGRITY ARM — both directions, or the check cannot tell "clean" from "never looked".
  # The corrupt fixture is built the way the real fault arrives: a zero-filled record at a line
  # boundary followed by an intact row, so a naive reader still sees well-formed text either side.
  _tn="$_td/tape-nul"
  printf '2026-01-01T00:00:00Z [collect] a\n2026-01-02T00:00:00Z [collect] b\n' > "$_tn"
  tape_nul_check "$_tn" >/dev/null 2>&1 \
    || { echo "  FAIL: a clean tape must pass tape_nul_check"; exit 1; }
  printf '2026-01-01T00:00:00Z [collect] a\n' > "$_tn"
  # the expected offset is DERIVED, never a literal — a hardcoded one silently stops testing the
  # offset the day the fixture text changes by a character
  _tnoff="$(wc -c < "$_tn")"
  head -c 64 /dev/zero >> "$_tn"
  printf '2026-01-02T00:00:00Z [collect] b\n' >> "$_tn"
  _tnsz="$(wc -c < "$_tn")"
  _tno="$(tape_nul_check "$_tn" 2>&1 >/dev/null)"; _tnr=$?
  [ "$_tnr" = 1 ] || { echo "  FAIL: a NUL-bearing tape must be reported corrupt (got rc=$_tnr)"; exit 1; }
  case "$_tno" in *"first at offset $_tnoff"*) : ;; *) echo "  FAIL: the report must name the first NUL's OFFSET ($_tnoff) so a hand can act (got: $_tno)"; exit 1 ;; esac
  case "$_tno" in *"64 NUL byte"*) : ;; *) echo "  FAIL: the report must name HOW MANY bytes were lost (got: $_tno)"; exit 1 ;; esac
  # and it must be a SENSE, never a repair — the tape it just condemned must be byte-identical
  [ "$(wc -c < "$_tn")" = "$_tnsz" ] \
    || { echo "  FAIL: tape_nul_check must NEVER modify the tape (size moved $_tnsz -> $(wc -c < "$_tn"))"; exit 1; }
  # THE SYMPTOM ITSELF — assert on what grep PRINTS, never on what it COUNTS. Measured here
  # 2026-08-30: on the corrupt tape `grep -c` answers 2 with rc 0, exactly like `grep -ac`; the
  # blindness is in LINE OUTPUT alone. An arm written against the count passes on a tape that is
  # lying to every reader, which is the vacuous-gate shape one ring out — this arm was written that
  # way first and went red, which is the only reason the distinction was measured at all.
  _gd="$(grep '\[collect\]' "$_tn" 2>/dev/null | tail -1)"
  _ga="$(grep -a '\[collect\]' "$_tn" | tail -1)"
  [ "$_gd" != "$_ga" ] \
    || { echo "  FAIL: the corrupt fixture must actually reproduce the grep-blindness it is a fixture for (default and -a both printed '$_ga')"; exit 1; }
  [ -n "$_ga" ] || { echo "  FAIL: grep -a must still read the row AFTER the NUL span — that is the whole remedy"; exit 1; }
  rm -f "$_tn"

  grep -q 'phone-unreachable' "$_td/.mesh/phone-collect.log" 2>/dev/null && \
    { echo "  FAIL: logged unreachable while a transport answered"; _f=1; }
  # Test 5: the refusal line is RENDERED FROM the probed list, not hand-written — an env-added
  # transport must appear in it by itself. Hand-write the message and this goes red.
  rm -f "$_td/.mesh/phone-collect.log"
  cat > "$_td/adb" <<'MOCKD'
#!/usr/bin/env bash
case "${1:-}" in get-state) echo device; exit 0;; forward) exit 0;; *) exit 1;; esac
MOCKD
  chmod +x "$_td/adb"
  TEST_OK_HOST=no.such.host MESH_PHONE_TS_IP=10.9.9.9 _sandbox "$_self" >/dev/null 2>&1; _ec5=$?
  _line="$(tail -1 "$_td/.mesh/phone-collect.log" 2>/dev/null)"
  [ "$_ec5" = 2 ] || { echo "  FAIL: all-down should exit 2 (got $_ec5)"; _f=1; }
  for _t in 'ts:10.9.9.9=' 'adb:' 'lan:10.7.7.7=' 'wg:'; do
    case "$_line" in *"$_t"*) ;; *) echo "  FAIL: refusal line omits $_t (got: $_line)"; _f=1;; esac
  done
  # two DIFFERENT mechanisms must keep two different words — collapsing them is the whole defect
  case "$_line" in *"lan:10.7.7.7=timeout"*) ;; *) echo "  FAIL: timeout not classified (got: $_line)"; _f=1;; esac
  case "$_line" in *"adb:127.0.0.1:9999=closed"*) ;; *) echo "  FAIL: adb-forward refusal not classified (got: $_line)"; _f=1;; esac
  # Test 3: All paths fail, mocks torn down entirely → exit 2
  printf '#!/usr/bin/env bash\nexit 1\n' > "$_td/adb"; chmod +x "$_td/adb"
  cat > "$_td/ssh" <<'MOCKC'
#!/usr/bin/env bash
exit 1
MOCKC
  chmod +x "$_td/ssh"
  _sandbox "$_self" 2>/dev/null; _ec=$?
  [ "$_ec" = 2 ] || { echo "  FAIL: all-paths-down should exit 2 (got $_ec)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (phone-collect pipeline drifted)"; exit 1; }
  echo "smoke-test: ok (ADB path + offset + ts-only-reachable + refusal-line-enumerates + all-down: 5 scenarios)"; exit 0
fi

# The shared phone-address ladder (ts-slot / ts-live / lan rungs). Sourced, never re-implemented.
. "${MESH_PATTERNS:-$HOME/.local/bin/mesh-patterns.sh}" 2>/dev/null || \
  . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true

LAN_IP="${MESH_PHONE_LAN_IP:-192.168.8.203}"
WG_IP="${MESH_PHONE_WG_IP:-10.66.66.10}"
JUMP="${MESH_PHONE_JUMP:-root@100.94.116.17}"
PORT="${MESH_PHONE_SSH_PORT:-8022}"
ADB_LP="${MESH_PHONE_ADB_LPORT:-8023}"     # local port forwarded → phone:8022 via adb
USER_="${MESH_PHONE_USER:-u0_a380}"
REMOTE_LOG="${MESH_PHONE_REMOTE_LOG:-.mesh/away-track.log}"
OUT="$HOME/.mesh/phone-track.log"
OFF="$HOME/.mesh/.phone-track.offset"
SSHO="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
mkdir -p "$HOME/.mesh"

tape_nul_check "$HOME/.mesh/phone-collect.log" || true

# ---- CANDIDATES ---------------------------------------------------------------------------------
#   TS  — the phone's tailnet address, from the SHARED ladder (phone_reach_candidates). Measured
#         2026-08-21 as the only path that answers with no workaround; first, not last.
#   ADB — adb-over-wifi forward → phone:8022. adbd is a system daemon, NOT subject to the per-app
#         VPN, so it survives the full tunnel — but it needs wireless debugging paired and up.
#   LAN — direct. The WG full-tunnel routes the phone's TCP SYN-ACK out the tunnel, so direct
#         LAN-TCP to :8022 TIMES OUT (ICMP still works). Kept: it works when WG is off.
#   WG  — via phaedra jump (away). Android blocks INBOUND TCP over the full tunnel, so this usually
#         fails; left in so away rows drain whenever inbound ever does work.
# Every rung goes through _cand so the probe order, the dedup and the refusal line share ONE array.
CAND_TAG=(); CAND_KIND=(); CAND_ADDR=(); CAND_DISP=(); CAND_OUT=()
_cand(){  # <tag> <kind:direct|adb|jump> <addr> [display]
  local i
  [ -n "${3:-}" ] || return 0
  for i in "${!CAND_ADDR[@]}"; do
    [ "${CAND_KIND[$i]}" = "$2" ] && [ "${CAND_ADDR[$i]}" = "$3" ] && return 0
  done
  CAND_TAG+=("$1"); CAND_KIND+=("$2"); CAND_ADDR+=("$3"); CAND_DISP+=("${4:-$3}"); CAND_OUT+=("untried")
}
LADDER=""
command -v phone_reach_candidates >/dev/null 2>&1 && LADDER="$(phone_reach_candidates 2>/dev/null)"
_cand ts direct "${MESH_PHONE_TS_IP:-}"
while read -r _rung _ip; do case "$_rung" in ts-*) _cand ts direct "$_ip";; esac; done <<< "$LADDER"
_cand adb adb 127.0.0.1 "127.0.0.1:$ADB_LP"
while read -r _rung _ip; do case "$_rung" in lan) _cand lan direct "$_ip";; esac; done <<< "$LADDER"
_cand lan direct "$LAN_IP"
_cand wg jump "$WG_IP"

ensure_adb(){
  command -v adb >/dev/null 2>&1 || return 1
  adb get-state >/dev/null 2>&1 || return 1
  adb forward tcp:"$ADB_LP" tcp:"$PORT" >/dev/null 2>&1 || return 1
  return 0
}
_reach(){  # <kind> <addr> <remote-cmd>
  case "$1" in
    adb)  timeout 25 ssh $SSHO -p "$ADB_LP" "${USER_}@127.0.0.1" "$3";;
    jump) timeout 30 ssh $SSHO -J "$JUMP" -p "$PORT" "${USER_}@${2}" "$3";;
    *)    timeout 20 ssh $SSHO -p "$PORT" "${USER_}@${2}" "$3";;
  esac
}
# A collapsed reason makes 'host up, sshd down' and 'no path at all' identical — they are different
# incidents with different fixes (tap Termux vs chase the network), so each candidate keeps its own word.
_why(){  # <rc> <stderr>
  case "$2" in
    *"Connection refused"*)     echo refused;;
    *"Connection closed by"*|*"Connection reset by"*) echo closed;;   # far end hung up. Through the
                            # adb forward this is how a refusal surfaces: the LOCAL forward accepts,
                            # then adbd finds nothing listening on phone:8022 (measured 2026-08-21).
    *"onnection timed out"*|*"peration timed out"*) echo timeout;;
    *"No route to host"*)       echo no-route;;
    *"Network is unreachable"*) echo no-route;;
    *"Permission denied"*)      echo auth-rejected;;
    *"not known"*|*"resolve"*)  echo dns;;
    *) [ "$1" = 124 ] && echo timeout || echo "fail-rc$1";;
  esac
}
PATHTAG=""; PATHIDX=-1
probe(){
  local i err rc
  for i in "${!CAND_TAG[@]}"; do
    if [ "${CAND_KIND[$i]}" = adb ]; then
      ensure_adb || { CAND_OUT[$i]=no-adbd; continue; }
    fi
    err="$(_reach "${CAND_KIND[$i]}" "${CAND_ADDR[$i]}" 'echo ok' </dev/null 2>&1 >/dev/null)"; rc=$?
    if [ "$rc" = 0 ]; then
      CAND_OUT[$i]=ok; PATHTAG="${CAND_TAG[$i]}"; PATHIDX="$i"; return 0
    fi
    CAND_OUT[$i]="$(_why "$rc" "$err")"
  done
  return 1
}
tried_summary(){ local i s=""; for i in "${!CAND_TAG[@]}"; do s+=" ${CAND_TAG[$i]}:${CAND_DISP[$i]}=${CAND_OUT[$i]}"; done; printf '%s' "${s# }"; }
fetch(){ _reach "${CAND_KIND[$PATHIDX]}" "${CAND_ADDR[$PATHIDX]}" "$1"; }

if ! probe; then
  # NOT "the phone is unreachable" — that is a claim we did not measure. This says exactly what was
  # measured: every candidate we know of, named, with its own outcome. A transport missing from this
  # line is a transport missing from the tool.
  echo "$(ts) [phone-unreachable] no path answered — tried ${#CAND_TAG[@]}: $(tried_summary)" >> "$HOME/.mesh/phone-collect.log"
  command -v mesh-chat >/dev/null 2>&1 && : # silent — unreachable phone is routine, no board spam
  exit 2
fi

# total rows on the phone now
total=$(fetch "wc -l < $REMOTE_LOG 2>/dev/null" | tr -dc '0-9')
[ -z "$total" ] && { echo "$(ts) [collect] no remote log yet ($PATHTAG via ${CAND_DISP[$PATHIDX]})" >> "$HOME/.mesh/phone-collect.log"; exit 0; }
last=$(cat "$OFF" 2>/dev/null | tr -dc '0-9'); last=${last:-0}
# phone rebooted / log rotated => offset past end => reset
[ "$total" -lt "$last" ] && last=0

if [ "$total" -gt "$last" ]; then
  new=$(fetch "tail -n +$((last+1)) $REMOTE_LOG 2>/dev/null")
  if [ -n "$new" ]; then
    printf '%s\n' "$new" >> "$OUT"
    printf '%s' "$total" > "$OFF"
    n=$(( total - last ))
    echo "$(ts) [collect] +$n rows via $PATHTAG (${CAND_DISP[$PATHIDX]}) (total $total)" >> "$HOME/.mesh/phone-collect.log"
    echo "collected $n new rows via $PATHTAG"
  fi
else
  echo "no new rows (total $total) via $PATHTAG"
fi
