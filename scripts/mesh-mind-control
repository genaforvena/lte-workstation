              MESH_AUTHDEAD_STATE="$_adf" MESH_AUTHDEAD_COOLDOWN=99999 _auth_dead_alert_once genome
              MESH_AUTHDEAD_STATE="$_adf" MESH_AUTHDEAD_COOLDOWN=99999 _auth_dead_alert_once genome
