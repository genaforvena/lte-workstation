              rm -f "$orph_state"
              printf '%s  chat@node  ::  [design] propose new fusion gate (owner: mesh-resource-guard/genome)\n' "$old_ts" > "$orph_log"
              o6="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ "$(printf '%s\n' "$o6" | grep -c '^\[task\] route-orphan/')" = 1 ] \
                || { echo "  orphan-scan FAIL: owner-tagged [design] must nudge like the other 3 classes, got: $o6"; fails=$((fails+1)); }
              printf '%s' "$o6" | grep -q 'owner: mesh-resource-guard/genome' \
                || { echo "  orphan-scan FAIL: [design] nudge missing owner tag: $o6"; fails=$((fails+1)); }
              # (g) chat-review/scanorphans-crossnode-dup: another host already minted+posted the
              # route-orphan [task] for this exact finding to the shared board — a FRESH node-local
              # state (this node's own, so far empty) must NOT re-mint a duplicate; it silently
              # adopts the id. The board [task]'s own timestamp is placed OUTSIDE the existing
