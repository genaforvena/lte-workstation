#!/usr/bin/env bash
# mesh-mind-control — ONE live surface for every MIND + DISPATCH work to an available one.
# The operator's "mind control window" (2026-06-14): see at a glance which minds are WORKING / IDLE /
# NEEDS-INPUT(blocked) / RATE-LIMITED / DEAD, and hand a task to whichever is free. Reuses
# mesh-mind-state (per-window classification) + mesh-claude-check (global Claude-access truth).
# Operator decision 2026-06-14: Claude minds carry the autonomous work (opencode/codex kept as-is),
# so DISPATCH targets the claude worker pool.
#
#   mesh-mind-control                  print the mind table once
#   mesh-mind-control --watch          live dashboard (refresh loop) — for a dedicated tmux window
#   mesh-mind-control --dispatch "..." route the task to the best AVAILABLE claude worker (mesh-tell)
#   mesh-mind-control --allocate "..." SMART route: classify text-vs-agentic, then send text→cheapest
#                                      pool (mesh-relay), agentic→idle claude worker else free-agentic
#                                      fallback (codex) when claude is WALLED. The "squeeze every
#                                      subscription" router — agentic work no longer stalls on a walled
#                                      claude. On a forecast thermal_day=1 (this node's own weather
#                                      sense, weather-consumers-phase2), tries phaedra (weather-
#                                      independent DC node) FIRST, before the local pick. Prints the
#                                      routing decision + result/handle.
#   mesh-mind-control --classify "..." print just the text|agentic verdict + why (for testing/inspection)
#   mesh-mind-control --scan-orphans   board scan (chat-review/orphan-owner-finding-detector-restale):
#                                      a finding posted as [fyi]/[verify]/[chat-review] that names
#                                      'owner: <tool>/<window>' in prose but ships no [task] never
#                                      routes (mesh-dispatch is [task]-keyed) — chat re-discovered +
#                                      hand-filed this exact pattern 7+ times on 2026-07-07 alone.
#                                      Surfaces each such orphan (age>=30min, no matching [task] within
#                                      30min of it) as ONE routable '[task] route-orphan/...' nudge;
#                                      does NOT auto-write the fix. State-deduped (fires once per
#                                      finding, cleared once a real [task] resolves it).
#   mesh-mind-control --test           smoke (incl. classifier assertions)
#
# reflex-cadence: 12,42 * * * *
# reflex-args: --scan-orphans
#
# Env: MESH_MIND_WORKERS (agentic dispatch pool, default "genome") · MESH_AGENTIC_FALLBACK
#      (free-agentic minds tried when claude is walled, default "work" = codex) · MESH_MIND_REFRESH (watch secs)
#      MESH_RESURFACE_TTL/GRACE/COOLDOWN (resume-resurface of a picked window's open [taking] claim,
#      defaults 14400/600/1800s — see the RESUME-RESURFACE block in dispatch())
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# shared freshness idiom (render-layer lease, PART 3). Source the one lib; inline fallback so a missing
# lib never blanks the pane (UNKNOWN-not-silent is the whole point — degrade visibly, never to blank).
_mf="$(command -v mesh-freshness 2>/dev/null)"; [ -n "$_mf" ] && . "$_mf" 2>/dev/null || true
command -v fresh_mark >/dev/null 2>&1 || fresh_mark(){ local f="$1" v="$2" ttl="${3:-1800}" a; [ -e "$f" ] || { echo "UNKNOWN (no data)"; return; }; a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); [ -n "$v" ] || { echo "UNKNOWN (empty)"; return; }; [ "$a" -gt "$ttl" ] && echo "$v (${a}s STALE)" || echo "$v (${a}s)"; }
# weather_field (weather-consumers-phase2) — same source+inline-fallback idiom as fresh_mark above.
. "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
command -v weather_field >/dev/null 2>&1 || weather_field(){ echo UNKNOWN; }
SESS="$(hostname)"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
DISPATCH_ACKED="$MESH_DIR/.dispatch-acked"
DISPATCH_ACK_TIMEOUT="${DISPATCH_ACK_TIMEOUT:-1800}"  # 30min suppress re-dispatch of same task
ALLOC_BLOCKED="$MESH_DIR/.allocate-blocked"            # accumulator for BLOCKED tasks (aggregate per cycle)
ALLOC_BLOCKED_TS="$MESH_DIR/.allocate-blocked.ts"      # last-flush timestamp
AGGREGATE_WINDOW="${AGGREGATE_WINDOW:-30}"             # seconds: batch BLOCKED lines into one message
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

# AUTHORITATIVE-CARD/ROLE GATE (chat-review/compute-node-dispatchers-bypass-the-governor): the
# work-creation arms below (--dispatch/--scan-orphans) wake PAID minds on the SHARED OAuth window, but
# this tool carried no card/role gate (the keepalives do) while mesh-pace's governor state is per-node
# — so compute-role phaedra's autowired crons paid-dispatched into a checkout-less local genome while
# mesh-home's governor HELD 19 tasks. Same authoritative-card doctrine as mesh-mind-keepalive: the card
# is THE switch; only a mind node creates paid work. Twin definition lives in mesh-dispatch — each site
# carries its own behavioural fixtures (--test), so drift dies red per tool, not silently.
# dispatch_gate <card-file> <roles> <host> → rc=0 (silent): may create paid mind work; rc=1 + WHY on
# stdout: must not. Pure (all inputs are args) — --test drives it with fixtures.
dispatch_gate(){
  local card="$1" roles="${2:-}" host="${3:-}" tok role=""
  for tok in $roles; do case "$tok" in "$host":*) role="${tok#*:}";; esac; done
  # an explicit non-mind MESH_ROLES entry for THIS host wins over the card (operator rule 2026-06-19:
  # role overrides card capability); unset/absent host defaults to mind — the card decides below.
  case "$role" in ''|mind) :;; *) printf 'role=%s in MESH_ROLES — a non-mind node never creates paid mind work' "$role"; return 1;; esac
  [ -f "$card" ] || { printf 'no card (%s) — an undeclared node never creates paid mind work' "$card"; return 1; }
  grep -iE '^[[:space:]]*minds:' "$card" | grep -qwE 'claude|opencode|gemini|codex' \
    || { printf 'card declares no mind engine — HANDS-OFF node never creates paid mind work'; return 1; }
  return 0
}
# live-input wrapper for the CLI arms: "" on stdout = may proceed; else the why. MESH_ROLES from the
# env (restore.env, sourced above) else the node registry — a subshell so nothing else leaks in.
dispatch_gate_why(){
  local roles
  roles="${MESH_ROLES:-$( [ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null; printf '%s' "${MESH_ROLES:-}" )}"
  dispatch_gate "$HOME/.mesh-card" "$roles" "$(hostname)" || true
}

# mind window -> engine HINT (a stale snapshot of the mesh-restore manifest). This is ONLY a fallback
# label for engine_of()'s "unknown" case — it is NOT the window set. It listed 6 windows while tmux ran
# 14 (chat-review/minds-manifest-hardcodes-6-of-14-windows, 2026-07-16), so as a ROW SOURCE it hid 8 live
# minds from the pane; mind_windows() below reads tmux instead. Its own :70-72 comment always said the
# manifest is only a hint — the rows just never listened. Windows absent here simply get no hint.
minds_manifest() {
  printf '%s\n' \
    "minds claude" "genome claude" "tg claude" \
    "senses opencode" "health opencode" "chat opencode"
}
# mind_windows — the LIVE mind-window set, from tmux, which is the authority (same doctrine as
# engine_of(): "an honest allocator + an honest minds pane must read reality", :70-72). A mind channel is
# a 2-PANE window by definition (CLAUDE.md: "every channel is a 2-pane window (top = data, bottom =
# mind)"); the session's only 1-pane window is the bare `bash` shell. Deriving the exclusion from that
# structural fact — rather than a hardcoded name blacklist — is the whole point: a literal list is what
# just failed, and a new channel must appear in the pane the moment mesh-restore plants it, with no edit
# here. Fallback to the manifest's window column when tmux is unreachable (no session / hermetic --test)
# so the pane degrades to a stale-but-visible set, never to BLANK (the :40-43 UNKNOWN-not-silent idiom).
mind_windows() {
  local w
  w="$(tmux list-windows -t "$SESS" -F '#{window_panes} #{window_name}' 2>/dev/null \
       | awk '$1 >= 2 {print $2}')"
  [ -n "$w" ] || w="$(minds_manifest | awk '{print $1}')"
  printf '%s\n' "$w"
}
# engine_hint <win> — the manifest's expected engine for a window, or "" when it lists none.
engine_hint() { minds_manifest | awk -v w="$1" '$1 == w { print $2; exit }'; }
WORKERS="${MESH_MIND_WORKERS:-genome}"   # general-work pool (operator 2026-06-17: genome lane owns code)
# Free-agentic fallback pool: real tool-using minds on FREE/cheap engines, tried ONLY when the primary
# worker is walled/busy. On the 6-channel set, chat/health are the default cheap fallbacks; a manually
# running Codex pane is still visible through engine_of() below and can be added via restore.env.
AGENTIC_FALLBACK="${MESH_AGENTIC_FALLBACK:-chat health}"

state_of() { mesh-mind-state "$1" 2>/dev/null | head -1 || printf 'ABSENT\t(no classify)\n'; }
# engine_of <win> — detect the LIVE engine from the mind pane's footer chrome, NOT a hardcoded manifest
# (the windows drift: a 'claude' window gets restarted as opencode, etc. — verified 2026-06-15 dev was
# OpenCode while the manifest said claude). An honest allocator + an honest minds pane must read reality.
descendants(){ local p; for p in $(pgrep -P "$1" 2>/dev/null); do echo "$p"; descendants "$p"; done; }
engine_of() {
  local win="$1" pidx foot pp p c panes=""
  panes="$(tmux list-panes -t "$SESS:$win" -F '#{pane_index}' 2>/dev/null | sort -n)"
  # Pass 1: prefer real live processes. This avoids footer text in a data pane (e.g. opencode prompt
  # text echoed into the checker stream) from winning over the actual mind pane.
  for pidx in $panes; do
    [ -n "$pidx" ] || continue
    pp="$(tmux display-message -p -t "$SESS:$win.$pidx" '#{pane_pid}' 2>/dev/null || true)"
    if [ -n "$pp" ]; then
      for p in "$pp" $(descendants "$pp"); do
        c="$(ps -o comm= -p "$p" 2>/dev/null)"
        case "$c" in claude|codex|opencode|gemini|agy) echo "$c"; return;; esac
      done
    fi
  done
  # Pass 2: footer heuristics only if no live process was recognized.
  for pidx in $panes; do
    [ -n "$pidx" ] || continue
    foot="$(tmux capture-pane -t "$SESS:$win.$pidx" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -6)"
    case "$foot" in
      *OpenCode*|*"opencode"*)                 echo "opencode";;
      *Codex*|*codex*|*"OpenAI"*)              echo "codex";;
      *"auto mode on"*|*"shift+tab to cycle"*|*"for agents"*|*"to manage"*|*"bypass permissions"*) echo "claude";;
      *"Gemini"*)                              echo "agy";;
    esac && return
  done
  echo "unknown"
}
# ── INSTRUMENTAL EMPOWERMENT / INTENDED COOPERATION VALUES (recent: ECAI 2025) ──────────────────
# LITERATURE — information theory of agency (empowerment), a RECENT RESULT (2023-2026), 2026-06-21:
# Selmonaj, Štrupl, Szehr & Antonucci, "Understanding Action Effects through Instrumental Empowerment
# in Multi-Agent Reinforcement Learning", ECAI 2025 (arXiv:2508.15652). Classic empowerment is an
# agent's control over its OWN future (channel capacity action→future-state). The multi-agent extension
# is INSTRUMENTAL empowerment — an agent's influence routed THROUGH other agents — and the paper's
# operational contribution, INTENDED COOPERATION VALUES (ICVs): an information-theoretic Shapley-value
# attribution, computed FROM THE POLICY/BEHAVIOUR DISTRIBUTION ALONE (no reward signal, no value
# feedback), of how much each agent's actions RAISE (cooperative) or LOWER (adversarial/noise) other
# agents' decision certainty. The key move: per-agent CONTRIBUTION inferred from behaviour when success
# is not explicitly measurable.
# WHY IT FITS THE MESH UNIQUELY: the mesh is a multi-agent system with NO explicit reward — "success"
# is the diffuse "self-production", and per-mind contribution has no value feedback. Minds coordinate
# stigmergically: one mind's board acts ([task]/[taking]/[done]/[fyi], a --dispatch) directly shape
# OTHER minds' decisions. That inter-mind influence is exactly instrumental empowerment.
# WHERE THIS REFLEX COMMITS THE GAP: mesh-mind-control picks dispatch targets by AVAILABILITY (state_of:
# idle/busy/walled) and RELIABILITY (health_of below: is the worker BROKEN — a terminal-error banner).
# NEITHER is CONTRIBUTION. health_of asks "can this worker execute?"; it cannot ask "does this worker's
# output HELP or HARM its peers' decisions?" A worker can be idle + healthy (maximally dispatchable here)
# yet have NEGATIVE instrumental empowerment over the fleet — its board output mis-triggers peers. This
# is not hypothetical: the operator-msg board-broadcast flood (one input → many minds confabulate replies
# in another's name, [[operator-msg-board-broadcast-floods-responders]]) and the phantom-[taking]
# re-dispatch ([[board-marker-grep-must-anchor-to-body]]) are both HIGH-instrumental-empowerment actions
# with the WRONG SIGN — a mind strongly shaping peers' decisions toward error. The mesh catches these
# only by hand-coded per-case patches (anchored-grep, a do-NOT-reply directive), never as the general
# quantity "how much, and with what sign, does mind X's behaviour move its peers' decisions?"
# HELD FIX (instrument-first, steward/operator-gated — behavioral): an ICV-style cooperation signal for
# the picker — estimate, from board behaviour alone, whether a mind's recent posts INCREASED peer
# decision-certainty (peers acted cleanly on them: a [task] it posted got a clean [taking]→[done]) vs
# DECREASED it (its posts preceded peer confabulation / phantom re-dispatch / withdrawals), and let the
# picker prefer high-cooperation workers (and flag negative-contribution ones) — a contribution axis
# beside availability + reliability. WHY HELD: attributing influence from co-occurring board text is
# confound-prone (correlation≠causal influence — the Shapley framing exists precisely to apportion it
# honestly), and a naive version would punish a mind for posting a hard problem others legitimately
# struggle with. Needs a causal/counterfactual estimate validated against chat.log history before it
# can gate dispatch (the work-routing actuator). NOT shipped.
# DISTINCT: NOT classic empowerment (review-empowerment-metric, mesh-ideate — single-agent option value
# over own future). NOT noisy-TV (this session, mesh-novelty — the surprise/curiosity-reward failure).
# NOT the stigmergy reviews (sematectonic / repellent-no-entry — the coordination MECHANISM); ICV is a
# MEASURE of per-agent contribution TO that coordination. NOT health_of below — reliability ("can it
# run?") is orthogonal to contribution ("does its output help peers?"); a healthy worker can be net-
# negative. The recent-result novelty: contribution inferred from behaviour with NO reward signal.
# ────────────────────────────────────────────────────────────────────────────────────────────────
# health_of — WORKER RELIABILITY probe for the dispatch picker (chat-review/delegation-worker-health).
# An IDLE worker can be at its prompt yet ACTIVELY BROKEN: the agy/Gemini geo-block fails every task
# with "Agent execution terminated due to error" + an "Error ID", then returns to idle — so the picker
# would keep handing real work to an engine that can't execute (the failure the operator's 2026-06-20
# VPN-Canada delegation test hit). Cheap, deterministic pane grep for that terminal-failure banner; a
# match → UNHEALTHY (the picker prefers a healthy worker, uses this one only as a last resort). Tight
# signature (terminal banners, not the bare word "error") to avoid condemning a worker mid-legit-output.
# Unreadable pane → OK (never falsely condemn). Overridable in --test via the same stub pattern as
# state_of/engine_of.
health_of() {
  local win="$1" pane
  pane="$(tmux capture-pane -t "$SESS:$win.1" -p 2>/dev/null; tmux capture-pane -t "$SESS:$win.0" -p 2>/dev/null)"
  [ -n "$pane" ] || { printf 'OK\n'; return; }
  if printf '%s\n' "$pane" | tail -14 | grep -qiE 'execution terminated due to error|Error ID:'; then
    printf 'UNHEALTHY\n'
  else
    printf 'OK\n'
  fi
}
# backlog + spend footer — this surface is FOR orchestration, so its data shows where work waits and
# where compute goes. Both THROTTLED to a 60s cache so the --watch loop stays cheap regardless of refresh.
backlog_line() { local td; td="$(date -u +%F)"; local c="$HOME/.mesh/chat.log"
  printf '[task] %s  [taking] %s  [done] %s' \
    "$(grep -c "$td.*\[task\]"   "$c" 2>/dev/null || echo 0)" \
    "$(grep -c "$td.*\[taking\]" "$c" 2>/dev/null || echo 0)" \
    "$(grep -c "$td.*\[done\]"   "$c" 2>/dev/null || echo 0)"; }
spend_line() { local cache="$HOME/.mesh/.spend-summary" age=999 now v
  now="$(date +%s)"; [ -f "$cache" ] && age=$(( now - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
  if [ "$age" -gt 60 ]; then
    { timeout 6 mesh-spend --by-provider 2>/dev/null | grep -E '^[[:space:]]*PAID' | sed 's/^[[:space:]]*//'; } >"$cache" 2>/dev/null || true
  fi
  # render-layer lease (PART 3): if the refresh keeps failing the cache goes STALE — show its age + a
  # STALE/UNKNOWN marker, NEVER a silent last-good number that reads as current. TTL 300s (refresh=60s).
  v="$(cat "$cache" 2>/dev/null | head -1)"
  fresh_mark "$cache" "$v" 300
}
icon() { case "$1" in
  WORKING) printf '●';; IDLE) printf '○';; NEEDS-INPUT) printf '⚠';;
  RATE-LIMITED) printf '⏳';; DEAD) printf '✗';; *) printf '·';; esac; }

# _orphan_owner_of <text> — same owner-tag extraction as _owner_target above (slash form honored),
# reused so the two never drift apart on what counts as an "owner:" tag.
_orphan_owner_of(){ printf '%s' "$1" | sed -nE 's/.*[oO][wW][nN][eE][rR]:[[:space:]]*([A-Za-z][A-Za-z0-9/_+-]*).*/\1/p' | head -1; }

# _orphan_resolved <log> <start_ts> <end_ts> <owner_lower> [self_line] [tool] — 0 iff a [task]/[fyi]/[done]
# board line naming the SAME owner tag lands within [start_ts,end_ts] (fixed-width ISO ts → lexical
# compare, same idiom fitness_leaderboard uses for its cutoff window above). [task] alone used to
# gate this — but a same-owner [fyi]/[done] closing/declining a finding in prose (never filed as a
# formal [task]) IS a real resolution too; the narrower alternation kept re-minting a route-orphan
# every scan for that shape (chat-review/scanorphans-decline-not-recognized, live:
# route-orphan/health-907346 vs the 17:47:51Z [fyi] downgrade that had already closed it,
# 2026-07-08). Mirrors mesh-dispatch's _route_orphan_resolved_after() (5308231). Widening the
# alternation to [fyi]/[done] means the FINDING ITSELF (often posted as [fyi]) now falls inside its
# own symmetric ±30min window and same-owner-matches against its own line — self_line (the finding's
# raw board line, when passed) is excluded so a lone unanswered finding still orphans correctly.
#
# chat-review/orphanresolved-owner-tag-not-toolname (2026-07-10): a real [done] closing the finding
# almost never restates the literal "owner: <tag>" string — it just describes the fix+commit — so
# the old index(low, "owner: " own) check missed it (live: health's 19:47:08Z fyi resolved by
# genome's 20:07:24Z [done] a263361 20min later, zero "owner:" occurrences in that line, re-minted
# route-orphan/mesh-mind-state-431668 anyway). Matches _route_orphan_resolved_after()'s idiom
# instead: grep -iF the bare TOOL NAME (owner's first path segment) anywhere in the line body.
_orphan_resolved(){
  awk -v a="$2" -v b="$3" -v tool="$(printf '%s' "${6:-$4}" | tr 'A-Z' 'a-z')" -v self="$5" '
    $0 == self { next }
    $1 >= a && $1 <= b && $0 ~ /:: +\[(task|fyi|done)\]/ {
      low = tolower($0)
      if (index(low, tool) > 0) { found=1; exit }
    }
    END { exit !found }
  ' "$1"
}

# scan_orphans — chat-review/orphan-owner-finding-detector-restale: a finding posted as a NON-[task]
# marker ([fyi]/[verify]/[chat-review]) that names an "owner: <tool>/<window>" tag in prose never
# routes (mesh-dispatch is [task]-keyed) and silently strands until a mind hand-files the real [task]
# — chat did exactly that 7+ times on 2026-07-07 alone (11:41/15:58/16:45/17:42Z…), each a manual
# rediscovery of the SAME missing-[task] gap. This is a PURE function (log path in, nudge lines out on
# stdout) so --test never touches the real board or calls mesh-chat; the --scan-orphans CLI case below
# is the only thing that posts.
#
# Orphan = a qualifying finding whose age >= 30min AND no [task] naming the same owner tag landed
# within 30min of it. Nudge once per finding (state-deduped on a hash of the finding's own line, so
# re-running the scan doesn't re-post); cleared from state the run it resolves, so a FUTURE orphan
# under the same owner tag can nudge again.
#
# chat-review/scanorphans-design-marker-gap (2026-07-08): an owner-tagged [design] proposal is
# structurally identical to an owner-tagged [fyi]/[verify]/[chat-review] — it names concrete work
# for a specific tool/window and can strand exactly the same way — but the marker alternation below
# omitted it, so a stalled [design] could never age into a route-orphan nudge (live: dragon-king-
# precursor and node-def-any-transport [design] posts both went unrouted by scan_orphans and needed
# a mind to notice by hand). Added "design" to the alternation; the 3 existing classes are unchanged.
#
# chat-review/scanorphans-race-single-minter (2026-07-08): the cross-node dedup below only re-checks
# the shared board ONCE, right before printing — under near-simultaneous cron ticks on 2+ hosts this
# is a check-then-act race, not a real dedup (live: route-orphan/mesh-doctor-{122898@phaedra,
# 287023@IdeaPad}, both 11:12:0[78]Z, 1s apart — same finding, both hosts saw "not yet posted" and
# both minted). Matches CLAUDE.md's own substrate single-writer doctrine: don't try to out-race
# concurrent writers, designate ONE. _orphan_is_minter() below gates the mint branch on a minter
# election — every host that is NOT the minter skips minting entirely and only ever adopts via the
# match_key grep above, converging onto whatever the minter posts once gossip lands it.
#
# chat-review/scanorphans-minter-unconfigured (2026-07-08): MESH_ORPHAN_MINTER (node-local env) was
# DEAD CODE — unset on every real node, since nothing ever hand-set it — so the "every host may
# still mint" fallback fired unconditionally and the 3x-dup race this section exists to fix kept
# firing. Fixed with ZERO required config, mirroring the substrate single-writer convention: the
# minter is derived by electing the lexically-lowest hostname that has posted to the shared board
# within the last 24h (same $cutoff window scan_orphans already computes) — no operator hand-set
# env needed, and every live host derives the SAME answer from the SAME shared log so they converge
# without talking to each other. MESH_ORPHAN_MINTER, if still set, is an explicit override that
# wins over the derived election (kept for an operator who wants to pin a minter by hand). A board
# scan_orphans can't read at all (unreadable/empty log) has nothing to elect from -> mint anyway
# (documented racy fallback for that edge, not a silent drop of the orphan).
#
# chat-review/scanorphans-propagates-dead-owner-tag (2026-07-08): the owner tag MUST be extracted
# the same way _owner_target resolves it at dispatch time — via _orphan_owner_of's rightmost-match
# sed (a meta finding that QUOTES an earlier tag before stating its own trailing "owner: X" is common
# on this board, e.g. "...tagged 'owner: mesh-fix-ds-sshd/genome' — ... owner: mesh-mind-control/genome").
# The old inline awk used match(), which is LEFTMOST — it grabbed the quoted historical tag instead
# of the line's real trailing assignment, so a chat-review discussing a stale/broken tag became a NEW
# source that re-minted the SAME stale tag forever (10x for mesh-fix-ds-sshd, live 2026-07-07→08,
# never dispatchable since it names no real tool/window). Falsify: feed a line with two owner: tags —
# the nudge must carry the LAST one, matching what _owner_target would independently resolve.
# _orphan_is_minter — see chat-review/scanorphans-minter-unconfigured above scan_orphans.
# MESH_ORPHAN_MINTER, if set, is an explicit pin and wins outright. Otherwise the minter is elected
# with zero config: the lexically-lowest hostname that posted to $log within $cutoff (every live
# host scans the SAME shared log, so they all derive the SAME winner without coordinating).
# MESH_MC_HOSTNAME overrides the real hostname for hermetic multi-host fixtures.
_orphan_is_minter() {
  local log="$1" cutoff="$2" host="${MESH_MC_HOSTNAME:-$(hostname)}" minter="${MESH_ORPHAN_MINTER:-}"
  [ -n "$minter" ] && { [ "$host" = "$minter" ]; return; }
  [ -r "$log" ] || return 0   # nothing to elect from -> mint anyway (racy edge, never a silent drop)
  minter="$(awk -v cut="$cutoff" '$1 >= cut { n = split($2, a, "@"); if (n > 1) print a[n] }' "$log" 2>/dev/null | sort -u | head -1)"
  [ -n "$minter" ] || return 0
  [ "$host" = "$minter" ]
}

scan_orphans(){
  local log="${MESH_MC_CHATLOG:-$MESH_DIR/chat.log}" state="${MESH_MC_ORPHAN_STATE:-$MESH_DIR/.orphan-nudged}"
  [ -r "$log" ] || return 0
  local now cutoff; now="$(date +%s)"
  cutoff="$(date -u -d '24 hours ago' +%FT%TZ 2>/dev/null)" || cutoff=""
  mkdir -p "$(dirname "$state")" 2>/dev/null || true; touch "$state" 2>/dev/null || true
  # chat-review/orphan-oneliner-is-the-lede-not-the-owner-tag (2026-07-16): the minted [task]
  # ONELINER used to be a naive head-140 of the finding body — but the owner: tag that ROUTES the
  # mint is extracted RIGHTMOST (_orphan_owner_of / _owner_target, per the quoted-tag comment at
  # scanorphans-propagates-dead-owner-tag) and sits a median ~1327 chars into the body, so on the
  # live board 140 of 141 owner-tagged findings had the tag PAST char 140. The head cut therefore
  # minted the finding's LEDE and essentially never the sentence the task was routed by — a worker
  # dispatched on it got prose, not the ask. Window the oneliner around the RIGHTMOST owner: tag
  # instead (same rightmost rule the routing uses): the clause carrying the tag is the actionable
  # ask. Snap the window start to the nearest sentence delimiter within budget, mark a dropped
  # lede with a leading '…'. Gated by fixture (a2) below (tag >140 chars in must appear in the mint).
  awk -v cut="$cutoff" '
    # 1-based start of the LAST occurrence of needle in hay (0 if absent).
    function rightmost(hay, needle,   k, off, pos) {
      pos = 0; off = 0
      while ((k = index(substr(hay, off + 1), needle)) > 0) { pos = off + k; off = pos }
      return pos
    }
    # 1-based start of the last occurrence of needle whose position is in [lo, hi) (0 if none).
    function last_between(hay, needle, lo, hi,   k, off, p, pos) {
      pos = 0; off = 0
      while ((k = index(substr(hay, off + 1), needle)) > 0) {
        p = off + k
        if (p >= hi) break
        if (p >= lo) pos = p
        off = p
      }
      return pos
    }
    # last byte (1-based) of the owner: clause that begins at op — through its value token (same
    # alphabet _orphan_owner_of consumes) and a single trailing ) if the tag is parenthesized.
    function tag_end(s, op,   i, n) {
      i = op + 6; n = length(s)                                  # past "owner:"
      while (i <= n && substr(s, i, 1) == " ") i++
      while (i <= n && substr(s, i, 1) ~ /[A-Za-z0-9\/_+-]/) i++
      if (i <= n && substr(s, i, 1) == ")") i++
      return i - 1
    }
    $1 >= cut && $0 ~ /:: +\[(fyi|verify|chat-review|design)\]/ && $0 ~ /[Oo][Ww][Nn][Ee][Rr]:[ \t]*[A-Za-z]/ {
      p = index($0, "] "); body = (p > 0) ? substr($0, p + 2) : $0
      gsub(/\t/, " ", body)
      op = rightmost(tolower(body), "owner:")                    # the ROUTING (rightmost) tag
      if (op == 0) {                                             # defensive; the filter guarantees a tag
        oneliner = (length(body) > 140) ? substr(body, 1, 140) "…" : body
      } else {
        te = tag_end(body, op)
        BUD = 150; desired = te - BUD; if (desired < 1) desired = 1
        cs = last_between(body, ". ", desired, op)               # snap to a sentence boundary in budget
        x  = last_between(body, "; ", desired, op); if (x > cs) cs = x
        start = (cs > 0) ? cs + 2 : desired                      # +2: step past the ". "/"; " delimiter
        # route-orphan-window-empties-to-bare-tag (2026-07-16): every real finding trails its tag as
        # "<ask-sentence>. owner: X", so the boundary NEAREST the tag is the ask/tag SEPARATOR and
        # start snaps onto "owner:" itself, dropping the whole ask — 10/10 of the 08:12 live mints
        # were a bare "…owner: <tag>". When no ask word survives before the tag, back the boundary
        # search BELOW that separator (cs) to the PRIOR sentence boundary so the ask-sentence lives.
        if (cs > 0 && substr(body, start, op - start) !~ /[A-Za-z0-9]/) {
          lo = te - 2 * BUD; if (lo < 1) lo = 1                  # widen budget to fit the ask-sentence
          ps = last_between(body, ". ", lo, cs)
          y  = last_between(body, "; ", lo, cs); if (y > ps) ps = y
          start = (ps > 0) ? ps + 2 : lo
        }
        oneliner = substr(body, start, te - start + 1)
        # route-orphan-window-empties-to-bare-tag, LEADING-tag shape (2026-07-16): a finding that
        # OPENS with its tag ("owner: X — <ask>") has no ask BEFORE the tag at all — cs is 0, the
        # cs>0 rescue above can never fire, and no backward window can recover an ask that sits
        # AFTER the tag. When nothing alnum survives ahead of the tag, extend FORWARD past tag_end
        # so the ask the tag introduces rides the mint.
        if (substr(body, start, op - start) !~ /[A-Za-z0-9]/ && te < length(body)) {
          fe = te + BUD; if (fe > length(body)) fe = length(body)
          oneliner = substr(body, start, fe - start + 1)
          if (fe < length(body)) oneliner = oneliner "…"
        }
        if (start > 1) oneliner = "…" oneliner                   # a lede was dropped ahead of the clause
      }
      print $1 "\t" oneliner "\t" $0
    }
  ' "$log" | while IFS="$(printf '\t')" read -r ts oneliner rawline; do
    [ -n "$ts" ] || continue
    local owner; owner="$(_orphan_owner_of "$rawline")"
    [ -n "$owner" ] || continue
    local epoch age; epoch="$(date -d "$ts" +%s 2>/dev/null)" || continue
    age=$(( now - epoch )); [ "$age" -ge 1800 ] || continue     # not orphaned yet — no nudge this run
    # route-orphan-dedup-keys-on-mutable-oneliner (2026-07-16): BOTH dedups — this node-local state
    # id and the cross-node board match below — used to key off $oneliner, the ONE input that CHANGES
    # when the oneliner-RENDERING code changes. ts + the source finding are FIXED; the oneliner is
    # merely DERIVED from the rawline. So every rendering edit made both keys miss and re-minted every
    # already-nudged orphan under a fresh id (live: 11c442d then 3152d30 changed the window and
    # route-orphan re-minted the SAME 10 closed nudges at 08:12 AND 09:12, provable same-ts+owner dups
    # mesh-overhear-254875==675107, mesh-access-probe-252411==120327). Derive both keys from STABLE
    # finding identity — the rawline ($0, the source board line, never re-rendered) — and keep the
    # oneliner display-only. id6 (the minted slug's short id) is now stable too, which is what lets the
    # cross-node consult below grep for the slug instead of the mutable oneliner substring.
    local id id6
    id="$(printf '%s' "$rawline" | cksum | tr ' ' '-')"
    id6="$(printf '%s' "$id" | tr -dc '0-9' | cut -c1-6)"
    # window is SYMMETRIC (±30min), not just forward: a finding that CONFIRMS an already-open task
    # filed shortly BEFORE it (e.g. "[verify] ... (discover's task stands)") must not read as orphaned
    # just because the matching [task] predates it — live false-positive caught testing against the
    # real board (health's 23:13:05Z fitness-false-revert [verify] vs. discover's 22:59Z task).
    local win_start win_end owner_l tool
    win_start="$(date -u -d "@$((epoch - 1800))" +%FT%TZ 2>/dev/null)"
    win_end="$(date -u -d "@$((epoch + 1800))" +%FT%TZ 2>/dev/null)"
    owner_l="$(printf '%s' "$owner" | tr 'A-Z' 'a-z')"
    tool="${owner%%/*}"; [ "$tool" = "$owner" ] && tool="$owner"
    if _orphan_resolved "$log" "$win_start" "$win_end" "$owner_l" "$rawline" "$tool"; then
      grep -qxF "$id" "$state" 2>/dev/null && sed -i "\|^${id}\$|d" "$state" 2>/dev/null
      continue
    fi
    grep -qxF "$id" "$state" 2>/dev/null && continue            # already nudged once — state-dedup
    # CROSS-NODE DEDUP (chat-review/scanorphans-crossnode-dup, 2026-07-08): $state is node-local
    # while $log is the fleet-SHARED board (gossiped from every host) — every mind node runs its
    # own scan against its own (so-far-empty) local state, so the SAME orphaned finding gets an
    # independent route-orphan [task] minted by each host (live dups: discover-218843=173328;
    # mesh-doctor-{136239,318428}; genome-{383093,155084}). The existing _orphan_resolved window
    # above (±30min of the finding's OWN timestamp) doesn't reliably catch this: a route-orphan
    # task can only be minted once the finding is already >=30min old, so its own timestamp lands
    # right at or past win_end — a few seconds/minutes of cross-node cron-scan skew is enough to
    # push it outside that window. Mirrors mesh-sweep-rollcall-proposes' board-consult fix
    # (d357653) and dispatch()'s own cross-node check (d407968): before minting, grep the SAME
    # $log for an existing route-orphan [task] for this finding — if ANY host already filed it, adopt
    # that id into local state instead of re-minting. Falsify by removing this block: the cross-node
    # fixture below must then start re-minting. The shared match key is the minted task's OWN slug,
    # 'route-orphan/<tool>-<id6>', where id6 is the STABLE per-rawline id computed above (was the
    # mutable first-60-of-oneliner — the very key that re-minted every closed nudge on each rendering
    # change, route-orphan-dedup-keys-on-mutable-oneliner). Every host derives the same id6 from the
    # same gossiped rawline, so the prior mint is found regardless of how its oneliner was rendered.
    if grep -qF -- "route-orphan/${tool}-${id6}" "$log" 2>/dev/null; then
      printf '%s\n' "$id" >> "$state"
      continue
    fi
    _orphan_is_minter "$log" "$cutoff" || continue   # not the elected minter -> never mint; adopt once the minter's post gossips in
    printf '[task] route-orphan/%s-%s: %s (owner: %s)\n' "$tool" "$id6" "$oneliner" "$owner"
    printf '%s\n' "$id" >> "$state"
  done
}

render() {
  echo "=== mesh minds · $SESS · $(date -u +%H:%M:%SZ) ==="
  printf '  %-9s %-9s  %-13s %s\n' WINDOW ENGINE STATE EVIDENCE
  # ROWS COME FROM TMUX, NOT THE MANIFEST (chat-review/minds-manifest-hardcodes-6-of-14-windows,
  # 2026-07-16): this loop used to read minds_manifest's fixed 6 rows, so room/pub/discover/sound/vpn/
  # bruno/witness/models — 8 live minds — were INVISIBLE in the minds pane no matter their state.
  # SCOPE, stated because the filed task claimed more: this fixes the ROW TABLE only. It does NOT and
  # cannot change the "Idle & ready to take work" line below, which is gated by BOTH the row set and
  # $WORKERS (default 'genome', operator 2026-06-17 "genome lane owns code"); the newly-visible windows
  # are not in WORKERS, so they could never have appeared there. render() was driven live at 03:1x and
  # printed 'genome', not the 'none' the task cited — that 'none' was genome legitimately BUSY at 02:41,
  # a different fact entirely. Widening WORKERS is an operator doctrine call, not this fix.
  local avail="" line st ev win eng leng
  while read -r win; do
    [ -n "$win" ] || continue
    eng="$(engine_hint "$win")"
    line="$(state_of "$win")"; st="${line%%	*}"; ev="${line#*	}"
    [ "$st" = "$line" ] && ev=""
    leng="$(engine_of "$win")"                       # LIVE engine (manifest is only a hint)
    [ "$leng" = unknown ] && leng="${eng:+$eng?}"    # no live read → manifest hint if it has one…
    [ -n "$leng" ] || leng="?"                       # …and a bare '?' for a window the manifest never knew
    printf '  %-9s %-9s  %s %-11s %s\n' "$win" "$leng" "$(icon "$st")" "$st" "$(printf '%s' "$ev" | cut -c1-58)"
    case " $WORKERS " in *" $win "*) [ "$st" = IDLE ] && avail="$avail $win";; esac
  done <<EOF
$(mind_windows)
EOF
  # home state (fast, from cache)
  # render-layer lease (PART 3): the old '|| echo ?' never fired (sed exits 0 on empty) → a dead
  # home-state rendered BLANK. Detect empty → visible UNKNOWN, never a silent blank.
  local hs; hs="$(mesh-home-state 2>/dev/null | sed 's/\[home-state\] //')"; [ -n "$hs" ] || hs="UNKNOWN (home-state unreachable)"
  echo "  ────────────────────────────────────────────────────────"
  printf '  Home: %s\n' "$hs"
  printf '  Claude access: %s   ·   pool (WORKING/IDLE): %s\n' \
    "$(mesh-claude-check --quiet 2>/dev/null || echo '?')" \
    "$(for w in $WORKERS; do l="$(state_of "$w")"; s="${l%%	*}"; printf '%s(%s) ' "$w" "$s"; done)"
  printf '  Idle & ready to take work: %s\n' "${avail:-none (all busy/blocked)}"
  printf '  Board today: %s   (mesh-dispatch auto-routes open [task]→idle hand)\n' "$(backlog_line)"
  printf '  Spend(5h): %s\n' "$(spend_line | head -1)"
}

# _pick_agentic — the ENGINE-AWARE worker picker shared by --dispatch (board reflex) and --allocate's
# agentic branch. Scans WORKERS ∪ AGENTIC_FALLBACK by LIVE engine + state; prints "win<TAB>tier" for the
# best target, "" if none. Preference: idle CLAUDE (operator: rely on claude) → idle FREE-engine
# (opencode/codex — squeeze the free subs when claude is walled) → busy claude (queue) → nothing.
_pick_agentic() {
  local idle_claude="" idle_free="" free_eng="" busyc="" blocked="" blocked_eng="" win st eng
  local un_idle="" un_eng=""   # an IDLE-but-UNHEALTHY worker (actively erroring) — last resort only
  for win in $WORKERS $AGENTIC_FALLBACK; do
    st="$(state_of "$win")"; st="${st%%	*}"; eng="$(engine_of "$win")"
    if [ "$st" = IDLE ]; then
      # RELIABILITY GATE (chat-review/delegation-worker-health): an idle worker actively failing every
      # task (agy/Gemini geo-block banner) is demoted to last-resort so a HEALTHY worker wins — never
      # silently dispatch real work into a broken engine. Still kept (un_idle) so a sole broken worker
      # doesn't dead-end the task; the tier label exposes that we knowingly used a degraded worker.
      if [ "$(health_of "$win")" = UNHEALTHY ]; then
        [ -z "$un_idle" ] && { un_idle="$win"; un_eng="$eng"; }
        continue
      fi
      case "$eng" in
        claude)          [ -z "$idle_claude" ] && idle_claude="$win";;
        opencode|codex)  [ -z "$idle_free" ] && { idle_free="$win"; free_eng="$eng"; };;
        *)               [ -z "$idle_free" ] && { idle_free="$win"; free_eng="$eng"; };;
      esac
    elif [ "$st" = WORKING ] && [ "$eng" = claude ] && [ -z "$busyc" ]; then busyc="$win"
    elif { [ "$st" = NEEDS-INPUT ] || [ "$st" = WEDGED-INPUT ]; } && [ -z "$blocked" ]; then
      # WEDGED-INPUT (chat-review/dispatch-picker-blind-to-wedge) ranks with NEEDS-INPUT, NOT top-tier
      # idle: a pane stuck on an un-submitted input line ('/clear' harness-eats-Enter) must never outrank
      # a genuinely-idle worker. mesh-tell's C-u still clears+delivers into it, so it stays a dispatchable
      # last resort (never a top pick) — the exact cure for Default-string's genome re-target loop where
      # dispatch kept picking the wedged window and its own '/clear' got discarded every cycle.
      # LAST-RESORT tier: a blocked mind is still dispatchable — mesh-tell submits the task into its
      # pane, which both answers the pending prompt and hands it the work (the self-feed mechanic the
      # whole node runs on). Scoped to the deliberate $WORKERS pool ONLY (never auto-answer a fallback
      # free-mind's confirm) and ranked BELOW every free/queueable mind, so a genuinely available
      # worker always wins. Prevents a single blocked sole-worker from dead-ending every dispatch —
      # the exact failure the operator's 2026-06-20 VPN-delegation test hit (pool=genome, genome
      # NEEDS-INPUT → 'NO available worker' → task dropped on the floor). Same-task re-dispatch is
      # still suppressed by DISPATCH_ACKED, so this can't spam a busy worker with its own pending task.
      case " $WORKERS " in *" $win "*) blocked="$win"; blocked_eng="$eng";; esac
    fi
  done
  if   [ -n "$idle_claude" ]; then printf '%s\tclaude\n' "$idle_claude"
  elif [ -n "$idle_free" ];   then printf '%s\tfree:%s\n' "$idle_free" "$free_eng"
  elif [ -n "$busyc" ];       then printf '%s\tclaude-queued\n' "$busyc"
  elif [ -n "$blocked" ];     then printf '%s\tblocked-unblock:%s\n' "$blocked" "$blocked_eng"
  elif [ -n "$un_idle" ];     then printf '%s\tunhealthy:%s\n' "$un_idle" "$un_eng"
  fi
}

# _owner_target — honor an "owner: <win>" tag on a board [task] (chat-review/owner-task-autodispatch).
# An explicit owner-tagged task is a DELIBERATE assignment to a specific window's role (genome=codebase,
# minds=allocation, …); it must not sit unclaimed while its idle owner rests on the diff-gated generate-
# feed, NOR be handed to a stranger that defeats the tag. Decision (mirrors _pick_agentic's contract —
# prints "win<TAB>tier", uses the same state_of/health_of so it's unit-testable):
#   prints "<owner><TAB>owner-direct"  → owner is IDLE + healthy: route straight to it (tag HONORED).
#   prints "<win><TAB>owner-redirect:<displaced>" (rc 0)
#                                      → the slash form named a NON-code-capable window for a CODE fix:
#                                        routed to the first idle CODE_WINS window instead. A DISTINCT
#                                        reason from owner-direct (2026-07-16) — this path SUBSTITUTES a
#                                        window, and a substitution reported as 'direct' is the tape
#                                        lying about the tag it defeated. Names who was displaced.
#   prints "" (rc 0)                   → no owner tag: caller falls back to _pick_agentic.
#   prints "" (rc 4)                   → owner window ABSENT (no such pane — likely a mis-tag: tool name
#                                        vs window name): caller emits a visible [fyi] THEN falls back to
#                                        _pick_agentic (a generic hand beats nobody); the [fyi] surfaces the
#                                        mis-tag at dispatch, not after a manual nudge.
#   returns 3 (HOLD, no output)        → owner present but BUSY/blocked/idle-unhealthy: reassigning
#                                        elsewhere would defeat the tag, so hold; the next scan re-checks
#                                        (no DISPATCH_ACKED record on hold → re-evaluated until owner frees).
#   returns 5 (HUMAN-OWNED, no output) → owner is the human (steward/operator), NOT a mind window: the
#                                        task needs MANUAL action (land a substrate strand, ssh+paste a
#                                        remote cron, an operator decision) — no mind can do it. Caller
#                                        must NOT generic-pick (dumping human-only work on a mind → the
#                                        mind can only [done] reject/redirect, burning a dispatch cycle
#                                        every scan) and must NOT emit the rc4 "mis-tag ABSENT" [fyi]
#                                        (steward is the INTENDED owner, not a mis-tag). The filing
#                                        channel owns operator escalation (e.g. mesh-land's [escalate]);
#                                        here we quietly hold. Plain form only — a "<tool>/steward" slash
#                                        form is a CODE fix, still redirected to the coder below.
#                                        (chat-review/owner-steward-alias-absent, LIVE-REPRODUCED: chat's
#                                        own 'owner: steward' phaedra-self-health-v2 got dumped on genome.)
#
# OWNER VALUE may be the canonical chat-review "<tool>/<window>" form (e.g. "owner: mesh-organ-keepalive/
# genome") — NOT just a bare window (chat-review/owner-toolslash-window-parse). The old regex stopped at
# the '/' and captured the TOOL name ("mesh-organ-keepalive"), which is NEVER a window → ALWAYS rc4 ABSENT
# → generic-pick LUCK (it lands genome only because the picker often does). We now parse the slash form:
#   * NO slash  → a plain role assignment ("owner: health"): honor that window as-is (covers non-code work).
#   * "<tool>/<window>" → the LEFT is the TOOL being fixed (a code artifact), the right names a conceptual
#     home. A tool/code fix is WRITTEN by the coder, so route to the post-slash window ONLY when it is
#     CODE-CAPABLE ($CODE_WINS, default "genome senses"); any non-code segment (minds/health/chat/…) is
#     REDIRECTED to the first IDLE+healthy window in $CODE_WINS, declared order (HOLD only when every
#     CODE_WINS window is busy/unhealthy — chat-review/ownertarget-codewins-fallback, live 2026-07-06:
#     hard-redirecting to a single $CODE_WIN=genome starved 4 code tasks 4-5h behind a busy genome while
#     senses sat idle — CODE_WINS declared TWO code-capable windows but only one was ever dispatchable).
#     This is still the 18:40 caveat: a "mesh-mind-control/minds" CODE fix must reach a coder, never the
#     non-coding minds window — the naive "split on / → dispatch the window-segment" would REGRESS this
#     very task's own dispatch. Deterministic, never generic-pick luck. (CODE_WIN/CODE_WINS overridable
#     per node via env.)
# _first_idle_code_win <code_wins> — first window, in declared order, that is IDLE and not
# UNHEALTHY. Used by the non-code-segment redirect branch below (chat-review/ownertarget-
# codewins-fallback): a hardcoded single code_win starves every OTHER declared code-capable
# window when that one mind is busy, even though CODE_WINS names more than one.
_first_idle_code_win() {
  local wins="$1" w ost
  for w in $wins; do
    ost="$(state_of "$w")"; ost="${ost%%	*}"
    [ "$ost" = IDLE ] || continue
    [ "$(health_of "$w")" = UNHEALTHY ] && continue
    printf '%s' "$w"; return 0
  done
  return 1
}

_owner_target() {
  local owner ost raw code_win code_wins human_owners
  code_win="${MESH_CODE_WIN:-genome}"               # the codebase-writing mind a tool/code fix lands on
  code_wins="${MESH_CODE_WINS:-genome senses}"      # windows that CAN write code (post-slash segment honored)
  human_owners="${MESH_HUMAN_OWNERS:-steward operator}"  # non-window owners = the human; manual-action, not mind-dispatchable
  raw="$(printf '%s' "$1" | sed -nE 's/.*[oO][wW][nN][eE][rR]:[[:space:]]*([A-Za-z][A-Za-z0-9/_+-]*).*/\1/p' | head -1 | tr 'A-Z' 'a-z')"
  [ -n "$raw" ] || { printf ''; return 0; }         # no owner tag → generic pick
  case "$raw" in
    */*) owner="${raw##*/}"                          # "<tool>/<window>" → window = post-LAST-slash segment
         case " $code_wins " in
           *" $owner "*) : ;;                        # segment is code-capable → honor it (e.g. .../genome)
           *) # SUBSTITUTION MUST BE LEGIBLE (chat-review/ownertag-stolen-from-non-codewins, 2026-07-16):
              # this branch DISPLACES the named owner onto a CODE_WINS window, and it used to print the
              # SAME 'owner-direct' reason as the honored path at the bottom of this function — so the
              # board line ('[dispatch] → senses (owner-direct): …') actively CLAIMED the tag was honored
              # for a task yanked off health and handed to senses. That is why the filter reads "silent":
              # the tape says direct. The redirect gets its OWN reason, naming the DISPLACED owner, so a
              # mind reading the board sees the substitution and can dispute the code_wins membership.
              # (The filter itself is coherent with CLAUDE.md — slash = code fix, so restricting the
              # slash form to code-capable windows is the documented intent, not a bug. Only the LABEL
              # lied.) Reason shape mirrors this file's existing 'free:opencode'/'blocked-unblock:agy'
              # colon-suffix idiom; mesh-dispatch's strip_dispatch_routing_prefix() '\([^()]*\): ' is
              # colon-tolerant inside the parenthetical (fixture-gated in its own --test).
              local displaced="$owner"
              if owner="$(_first_idle_code_win "$code_wins")"; then
                printf '%s\towner-redirect:%s\n' "$owner" "$displaced"; return 0   # first IDLE+healthy CODE_WINS window, declared order
              else
                printf ''; return 3                              # every CODE_WINS window busy/unhealthy → HOLD
              fi ;;
         esac ;;
    *)   owner="$raw"                                # plain "owner: <window>" → honor as the home window
         case " $human_owners " in                   # …unless it names the HUMAN (steward/operator):
           *" $owner "*) printf ''; return 5 ;;       # manual-action task, no mind window — hold, never dispatch
         esac ;;
  esac
  ost="$(state_of "$owner")"; ost="${ost%%	*}"
  case "$ost" in
    IDLE)   [ "$(health_of "$owner")" = UNHEALTHY ] && return 3   # idle but broken engine → hold, don't feed
            printf '%s\towner-direct\n' "$owner"; return 0 ;;
    AUTH-DEAD) printf '%s\tauth-dead\n' "$owner"; return 9 ;;     # owner LOGGED OUT (chat-review/mindstate-loggedout-not-idle) → distinct rc9 so dispatch HOLDs + alerts ONCE (not the silent busy-HOLD rc3, not a blind route→NOACK loop); prints the window so dispatch can name it in the alert
    ABSENT) printf ''; return 4 ;;                   # no such window → warn + generic pick (better than nobody); rc=4 lets dispatch emit a visible [fyi] so a mis-tagged owner (tool vs window name) is caught at dispatch, not after a manual nudge
    *)      return 3 ;;                              # owner busy/blocked → HOLD for the owner
  esac
}

# dispatch_echo_summary <task> — the SLUG-FIRST body of a [dispatch] board line.
# mesh-dispatch wraps the real task in a generic "Board task assigned... TASK: <task>" preamble
# (mesh-dispatch:330). Echoing the raw head (cut -c1-90) truncated the IDENTIFYING slug away, so
# every wrapped dispatch read as the same boilerplate and the board couldn't tell WHICH task was
# routed (chat-review/dispatch-echo-slug-first). Strip the preamble (up to & incl. the FIRST
# "TASK: ") so the echo leads with the real task — which itself leads with its slug
# ("chat-review/<slug>: ..." / "owner: <win>"). Unwrapped tasks (mesh-failover, no "TASK: ") pass
# through unchanged. COSMETIC ONLY — the worker still receives the full framed prompt via mesh-tell.
# DELIMITER-INJECTABLE (chat-review/mindcontrol-posts-wrapper-not-task ADDENDUM, 2026-07-05,
# live-reproduced): the frame ALSO embeds $task a second, EARLIER time (inside its own "stale:"
# example prose), so a task whose OWN text happens to contain the literal substring "TASK: " (a
# self-referential audit task quoting this very delimiter did, live 07:33Z) makes the shortest-match
# strip below latch onto that earlier, WRONG occurrence — board line starts mid-task, slug gone.
# No purely textual anchor is safe here (the frame's own preamble has a variable-length hole where
# the first $task copy sits, so there is no fixed constant prefix to anchor on either). The robust
# fix: mesh-dispatch now ALSO passes the raw, unwrapped task via $MESH_DISPATCH_RAW_TASK alongside
# the framed string — when present, use it directly (exact, zero parsing, no ambiguity possible).
# The heuristic strip below is now only the FALLBACK for callers that don't set it (tests, or any
# future direct caller passing an already-framed string with no raw sibling).
dispatch_echo_summary() {
  local t="$1" src
  if [ -n "${MESH_DISPATCH_RAW_TASK:-}" ]; then
    src="$MESH_DISPATCH_RAW_TASK"
  else
    case "$t" in *"TASK: "*) t="${t#*TASK: }" ;; esac
    src="$t"
  fi
  local cut
  cut=$(printf '%s' "$src" | cut -c1-90)
  # mark the cut so a truncated line reads as truncated, not as a corrupted-looking
  # bare mid-word ending indistinguishable from an intentionally short complete one
  # (chat-review/dispatch-echo-truncation-marker)
  if [ "${#src}" -gt 90 ]; then
    printf '%s…' "$cut"
  else
    printf '%s' "$cut"
  fi
}

# claim_id_of / claim_body_if — KEEP IN SYNC with mesh-dispatch's own definitions (~mesh-dispatch:349,
# :362). Reused here (not sourced — mesh-dispatch is a full reflex script with its own cron-triggered
# side effects, not a library) for the cross-node board-consult in dispatch() below
# (chat-review/dispatch-cross-node-dedup). claim_id_of resolves a claim line to its OWN SUBJECT id
# (first slug/shouty token), never a slug merely CITED in prose — the same phantom-match guard
# mesh-dispatch's is_open() needed (chat-review/dispatch-claim-match-unanchored): a claim about task A
# that quotes task B's slug must never be read as B's claim. claim_body_if gates which marker a line
# actually IS (body-START discipline) so a [taking] whose prose quotes "[dispatch]" is never misread
# as a real [dispatch].
claim_id_of(){
  local s
  s="$(printf '%s' "$1" | grep -oE '([a-z0-9]+(-[a-z0-9]+)*/)+[a-z0-9]+(-[a-z0-9]+)+|[a-z0-9]+(-[a-z0-9]+)+' | head -1)"
  s="${s##*/}"
  if [ -n "$s" ] && [ "${#s}" -ge 6 ]; then printf '%s' "$s"; return; fi
  printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1
}
claim_body_if(){
  local rest="${1#*:: }"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  case "$rest" in "[$2] "*) printf '%s' "$rest" ;; *) return 1 ;; esac
}

# _open_taking_of <win> [now] — print "<claim-id>\t<age-secs>\t<taking-body>" for the OLDEST still-OPEN
# [taking] posted by THIS node's <win> mind (poster <win>@$SESS), rc=1 when none. Open = the [taking] is
# younger than MESH_RESURFACE_TTL (default 4h — past that, mesh-dispatch's STALE_TTL evaporation owns the
# lifecycle) AND no body-anchored [done]/[yield] line carrying its claim-id was posted AT-OR-AFTER the
# [taking]'s own timestamp. The at-or-after gate is 20ac380's mint-ordering discipline: a [done] from an
# EARLIER lifecycle of the same slug (posted before this [taking]) cannot close this claim — without it a
# re-taken task whose first attempt was [done]'d reads permanently closed and can never resurface. Oldest
# first = most-starved first (FIFO, matches dispatch's own priority-then-oldest ethos). Any poster may
# close (a sibling legitimately [done]s another mind's claim). Board via MESH_MC_CHATLOG (hermetic --test).
_open_taking_of() {
  local win="$1" now="${2:-$(date +%s)}"
  local log="${MESH_MC_CHATLOG:-$MESH_DIR/chat.log}"; [ -r "$log" ] || return 1
  local ttl="${MESH_RESURFACE_TTL:-14400}"
  local takings closers
  takings="$(grep -E "^[^[:space:]]+[[:space:]]+${win}@${SESS}[[:space:]]+::[[:space:]]+\[taking\]" "$log" 2>/dev/null || true)"
  [ -n "$takings" ] || return 1
  closers="$(grep -E '::[[:space:]]+\[(done|yield)\]' "$log" 2>/dev/null || true)"
  local best_ts="" best_cid="" best_body=""
  local tline tbody cid tts
  while IFS= read -r tline; do
    [ -n "$tline" ] || continue
    tbody="$(claim_body_if "$tline" taking 2>/dev/null)" || continue
    cid="$(claim_id_of "$tbody")"; [ -n "$cid" ] || continue
    tts="$(date -u -d "$(printf '%s' "$tline" | cut -d' ' -f1 | sed 's/T/ /; s/Z$//')" +%s 2>/dev/null)" || continue
    [ $(( now - tts )) -ge 0 ] && [ $(( now - tts )) -lt "$ttl" ] || continue
    local closed="" cline cbody cts
    while IFS= read -r cline; do
      [ -n "$cline" ] || continue
      case "$cline" in *"$cid"*) ;; *) continue ;; esac
      cbody="$(claim_body_if "$cline" done 2>/dev/null)" || cbody="$(claim_body_if "$cline" yield 2>/dev/null)" || continue
      cts="$(date -u -d "$(printf '%s' "$cline" | cut -d' ' -f1 | sed 's/T/ /; s/Z$//')" +%s 2>/dev/null)" || continue
      [ "$cts" -ge "$tts" ] && { closed=1; break; }
    done <<< "$closers"
    [ -n "$closed" ] && continue
    if [ -z "$best_ts" ] || [ "$tts" -lt "$best_ts" ]; then best_ts="$tts"; best_cid="$cid"; best_body="$tbody"; fi
  done <<< "$takings"
  [ -n "$best_cid" ] || return 1
  printf '%s\t%s\t%s\n' "$best_cid" "$(( now - best_ts ))" "$best_body"
}

# _ack_timeout_for_load — echo a WIDENED MESH_TELL_ACK_TIMEOUT (12s) when this node is under measured
# CPU/thermal stress, else echo NOTHING (caller leaves the env untouched → mesh-tell's fast 4s default).
# (chat-review/acktimeout-thermal-blind 2026-07-10): ack_probe's fixed 4s window is load-blind — a claude
# engine CPU-starved at load>nproc (or a thermally-throttled node) can take several seconds JUST to paint
# its working-counter footer, so a genuinely-ACCEPTED prompt reads NO-ACK and the dispatcher discards a
# real hand-off. Live: 4 consecutive [dispatch-noack] for route-orphan/mesh-mind-state-431668
# (00:18/00:38/00:58/01:18Z) across this node's own logged CRITICAL (temp=99C) → HOT (load=9.34/8c) window
# before it finally delivered at 01:33Z. Widen the ACK poll ONLY under stress; normal load keeps today's
# fast stall-detection unchanged. Reads the canonical bare-HOT/OK .therm-state (mesh-therm-watch consumer
# contract) + 1-min loadavg vs nproc — both cheap, always-local. All inputs overridable for --test.
_ack_timeout_for_load() {
  local wide="${MESH_DISPATCH_ACK_WIDE:-12}"
  local tstate; tstate="$(cat "${MESH_THERM_STATE:-$HOME/.mesh/.therm-state}" 2>/dev/null)"
  case "$tstate" in HOT|CRITICAL) echo "$wide"; return;; esac
  local la nc; la="$(cut -d' ' -f1 "${MESH_LOADAVG_SRC:-/proc/loadavg}" 2>/dev/null)"
  nc="${MESH_NPROC_OVERRIDE:-$(nproc 2>/dev/null || echo 1)}"
  # widen when 1-min loadavg exceeds core count (ratio > 1.0); awk for the float compare (no bc dep).
  if [ -n "$la" ] && awk -v l="$la" -v n="$nc" 'BEGIN{exit !(n>0 && l/n > 1.0)}'; then
    echo "$wide"
  fi
}

dispatch() { # board-reflex entry: ENGINE-AWARE agentic route (claude→free→queue), no text path
  local task="$1"; [ -n "$task" ] || { echo "usage: mesh-mind-control --dispatch \"<task>\""; return 1; }
  # FLAG-INJECTION GUARD (chat-review/dispatch-flag-injection-no-dryrun, live 02:57Z: a CLI typo
  # 'mesh-mind-control --dispatch --dry-run' — no such flag exists — silently mesh-tell'd the
  # literal '--dry-run' into chat's live pane as if it were real task text, needing manual genome
  # cleanup). A real task is always a free-text sentence, never bare '--flag' token(s); reject
  # ONLY a task that IS JUST one or more '--flag' tokens, never one that merely MENTIONS a
  # hyphenated word mid-sentence (e.g. "fix --edge hang in mesh-ss-test" must keep dispatching).
  if printf '%s' "$task" | grep -qE '^--[A-Za-z0-9][A-Za-z0-9-]*([[:space:]]+--[A-Za-z0-9][A-Za-z0-9-]*)*$'; then
    echo "usage: mesh-mind-control --dispatch \"<task>\" (got flag-shaped input, not a task: '$task')" >&2
    return 1
  fi
  local fp now task_safe; fp=$(printf '%s' "$task" | md5sum | cut -d' ' -f1)
  now=$(date +%s)
  task_safe="$(printf '%s' "$task" | tr -d '|' | cut -c1-80)"
  # CITED CODE TARGET (chat-review/dispatch-dedup-target-not-text): extract the first mesh-tool source
  # citation 'mesh-<tool>:<N>(-<M>)?' from the task body (the `mesh-` anchor avoids matching HH:MM
  # timestamps / 'exit 7'; any scripts/ or ~/.local/bin/ path prefix is ignored — we key on tool+range).
  local cite cite_file="" cite_lo="" cite_hi="" cite_norm=""
  cite="$(printf '%s' "$task" | grep -oiE 'mesh-[a-z0-9-]+:[0-9]+(-[0-9]+)?' | head -1)"
  if [ -n "$cite" ]; then
    cite_file="${cite%%:*}"; local cite_ln="${cite##*:}"
    cite_lo="${cite_ln%%-*}"; cite_hi="${cite_ln##*-}"       # hi==lo when no '-range'
    cite_norm="${cite_file}:${cite_lo}-${cite_hi}"
  fi
  # prune stale entries (older than TIMEOUT) AND entries matching [done] on today's board
  if [ -f "$DISPATCH_ACKED" ]; then
    local today; today="$(date -u +%F)"
    local done_f; done_f="$(mktemp)"
    grep -h "$today.*\[done\]" "$HOME/.mesh/chat.log" 2>/dev/null | tr 'A-Z' 'a-z' > "$done_f" || true
    awk -F'|' -v now="$now" -v to="$DISPATCH_ACK_TIMEOUT" -v done_f="$done_f" '
      function is_done(t, line) {
        t = tolower(t)
        while((getline line < done_f) > 0) { if(index(line, t)) { close(done_f); return 1 } }
        close(done_f)
        return 0
      }
      $2 + to >= now && !is_done($5)
    ' "$DISPATCH_ACKED" > "${DISPATCH_ACKED}.tmp" 2>/dev/null && \
    mv -f "${DISPATCH_ACKED}.tmp" "$DISPATCH_ACKED" 2>/dev/null
    rm -f "$done_f"
    [ -s "$DISPATCH_ACKED" ] 2>/dev/null || rm -f "$DISPATCH_ACKED"
  fi
  # suppress re-dispatch of same task within TIMEOUT window
  if [ -f "$DISPATCH_ACKED" ] && grep -qF "$fp" "$DISPATCH_ACKED" 2>/dev/null; then
    echo "already dispatched (suppressed): $task"
    return 0
  fi
  # SAME-TARGET DEDUP (chat-review/dispatch-dedup-target-not-text): fp (exact text) and xid (author-
  # chosen slug) both MISS a same-file + overlapping-line-range task worded/slugged differently — live
  # collision 2026-07-09 19:04:30Z/19:05:13Z: two [task]s both citing mesh-mind-state:176-182 with
  # different slugs, neither key caught it → mind-control dispatched the same bug twice. Node-local and
  # deadlock-free: the fp check above already returned for exact re-dispatch, so ANY DISPATCH_ACKED
  # record whose field-6 citation hits the SAME file with an OVERLAPPING range is necessarily a
  # DIFFERENT task on the same target that ALREADY dispatched (and recorded its citation first) →
  # suppress this one. Distinct bugs at NON-overlapping ranges in the same file both still dispatch; a
  # task citing no mesh-tool line has cite_file empty and falls through to the fp/xid keys only.
  if [ -n "$cite_file" ] && [ -f "$DISPATCH_ACKED" ]; then
    if awk -F'|' -v f="$cite_file" -v lo="$cite_lo" -v hi="$cite_hi" '
        { c=$6; if(c=="") next
          ci=index(c,":"); if(ci==0) next
          cf=substr(c,1,ci-1); cr=substr(c,ci+1)
          di=index(cr,"-"); if(di){ clo=substr(cr,1,di-1)+0; chi=substr(cr,di+1)+0 } else { clo=cr+0; chi=clo }
          if(cf==f && lo+0<=chi && clo<=hi+0){ found=1; exit } }
        END{ exit !found }' "$DISPATCH_ACKED" 2>/dev/null; then
      echo "already dispatched (same target ${cite_norm}, different wording): $task"
      return 0
    fi
  fi
  # CROSS-NODE DEDUP (chat-review/dispatch-cross-node-dedup 2026-07-07): DISPATCH_ACKED above is
  # NODE-LOCAL — two nodes' mind-controls each pass their OWN (so-far-empty) ACKED file and both
  # dispatch the SAME board task independently (live: groq-stt 21:43 ds + 21:48 IdeaPad → duplicate
  # parallel fixes → shared-checkout divergence). Before committing to mesh-tell, scan the board
  # (gossiped from every host) for a body-anchored [dispatch]/[taking] of this task's OWN claim-id,
  # posted by ANY host, still within DISPATCH_ACK_TIMEOUT — visible even when THIS node's
  # DISPATCH_ACKED has never heard of the task. Deliberately NOT day-string-scoped (unlike the
  # DISPATCH_ACKED prune above) — mirrors is_open()'s own full-board rationale (~mesh-dispatch:387):
  # a day-scoped scan can miss a claim that's still fresh in wall-clock terms near a UTC-midnight
  # boundary; a plain now-minus-timestamp compare is exact regardless of the calendar date.
  # CROSS-NODE FRESHNESS GUARD (chat-review/dispatch-gossip-lag-recur 2026-07-09): the scan below only
  # sees peer [dispatch]/[taking] lines that mesh-chat-sync has ALREADY gossiped into our local board.
  # That gossip runs on a */25 cron — up to ~25min stale — while mesh-dispatch cycles every 5-15min, so
  # a peer's just-posted claim can be invisible here and BOTH nodes double-dispatch the same slug (live
  # 2026-07-09T20:03Z: mind-control@IdeaPad + mind-control@phaedra dispatched a byte-identical slug 4s
  # apart, exactly the race the 07-07 cross-node-dedup fix could not catch because its board was stale).
  # Close the window: if the last successful gossip round is older than one dispatch cycle, pull the
  # board synchronously NOW (hard-timeout so a slow/partitioned peer can never wedge dispatch), rate-
  # limited by a stamp so a multi-task tick pulls at most once. The sync command is $MESH_MC_PRESYNC_CMD;
  # on the real board it defaults to mesh-chat-sync, and hermetic --tests (MESH_MC_CHATLOG set) leave it
  # unset → no network. A test may set MESH_MC_PRESYNC_CMD="" to disable, or to a fixture to exercise it.
  local _presync_cmd=""
  if [ -n "${MESH_MC_PRESYNC_CMD+x}" ]; then _presync_cmd="$MESH_MC_PRESYNC_CMD"
  elif [ -z "${MESH_MC_CHATLOG:-}" ]; then _presync_cmd="mesh-chat-sync"; fi
  if [ -n "$_presync_cmd" ]; then
    local _syncstamp="${MESH_MC_PRESYNC_STAMP:-$MESH_DIR/.dispatch-presync}" _stampage=999999
    [ -f "$_syncstamp" ] && _stampage=$(( now - $(stat -c %Y "$_syncstamp" 2>/dev/null || echo 0) ))
    if [ "$_stampage" -ge "${DISPATCH_PRESYNC_MIN:-300}" ]; then
      timeout "${DISPATCH_PRESYNC_TIMEOUT:-25}" $_presync_cmd >/dev/null 2>&1 || true
      touch "$_syncstamp" 2>/dev/null || true
    fi
  fi
  local xid; xid="$(claim_id_of "$task")"
  if [ -n "$xid" ]; then
    local xlog; xlog="${MESH_MC_CHATLOG:-$MESH_DIR/chat.log}"
    if [ -r "$xlog" ]; then
      local xclaims xhit=""
      xclaims="$(grep -E '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[(taking|dispatch)\]' "$xlog" 2>/dev/null || true)"
      while IFS= read -r xline; do
        [ -z "$xline" ] && continue
        case "$xline" in *"$xid"*) ;; *) continue ;; esac
        local xbody=""
        xbody="$(claim_body_if "$xline" dispatch 2>/dev/null)"
        [ -n "$xbody" ] || xbody="$(claim_body_if "$xline" taking 2>/dev/null)"
        [ -n "$xbody" ] || continue
        [ "$(claim_id_of "$xbody")" = "$xid" ] || continue
        local xts; xts="$(date -u -d "$(printf '%s' "$xline" | cut -d' ' -f1 | sed 's/T/ /; s/Z$//')" +%s 2>/dev/null)" || continue
        if [ $(( now - xts )) -ge 0 ] && [ $(( now - xts )) -lt "$DISPATCH_ACK_TIMEOUT" ]; then
          xhit="$xline"; break
        fi
      done <<< "$xclaims"
      if [ -n "$xhit" ]; then
        echo "already dispatched (board [taking]/[dispatch] within ${DISPATCH_ACK_TIMEOUT}s, cross-node): $task"
        return 0
      fi
      # BOARD-[done] SCAN (chat-review/dispatch-consult-omits-done): the [taking]/[dispatch] scan above
      # closes the cross-node race for an IN-FLIGHT claim, but a [done] that lands AFTER the picker read
      # the board yet BEFORE this pre-tell consult is invisible to it — so the pick→tell race re-fires an
      # already-RESOLVED task (live 2026-07-09: stale-propose-2beae1bb [done] 08:19:01Z re-dispatched
      # 08:19:32Z → a duplicate [done] 08:19:37Z). Mirror _route_orphan_resolved_after's discipline
      # (~mesh-dispatch:103-112): a body-anchored [done] line containing this task's claim-id as an EXACT
      # substring, still within DISPATCH_ACK_TIMEOUT, means the work is already done → suppress. Substring
      # match — deliberately NOT claim_id_of on the [done] body: an operator's framed "[done] stale: <whole
      # task text>" re-post is exactly what must be caught, and it need not parse to a clean subject slug.
      local xdone xdhit=""
      xdone="$(grep -E '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[done\]' "$xlog" 2>/dev/null || true)"
      while IFS= read -r xdline; do
        [ -z "$xdline" ] && continue
        case "$xdline" in *"$xid"*) ;; *) continue ;; esac
        local xdts; xdts="$(date -u -d "$(printf '%s' "$xdline" | cut -d' ' -f1 | sed 's/T/ /; s/Z$//')" +%s 2>/dev/null)" || continue
        if [ $(( now - xdts )) -ge 0 ] && [ $(( now - xdts )) -lt "$DISPATCH_ACK_TIMEOUT" ]; then
          xdhit="$xdline"; break
        fi
      done <<< "$xdone"
      if [ -n "$xdhit" ]; then
        echo "already resolved (board [done]): $task"
        return 0
      fi
    fi
  fi
  # OWNER-FIRST: an "owner: <win>" tag routes to that window when it's the right home (idle+healthy);
  # only a tag-less or owner-ABSENT task falls through to the generic availability picker.
  local p win tier ot otrc remote_win=""; ot="$(_owner_target "$task")"; otrc=$?
  if [ "$otrc" = 3 ]; then
    echo "owner-tagged task HELD (owner busy/unhealthy — not reassigning, re-checks next scan): $task"; return 0
  fi
  if [ "$otrc" = 9 ]; then
    # owner window is LOGGED OUT (AUTH-DEAD, chat-review/mindstate-loggedout-not-idle): the old path
    # read it IDLE, routed, and looped route→NOACK→[dispatch-noack] for hours. HOLD the task and post a
    # ONE-SHOT human-actionable alert (re-login + engine restart) instead of a silent hold or blind retry.
    _auth_dead_alert_once "${ot%%	*}"
    echo "owner-tagged task HELD (owner LOGGED OUT — needs re-login+restart, not re-dispatched): $task"; return 0
  fi
  if [ "$otrc" = 5 ]; then
    # chat-review/human-owned-hold-silent: a human-owned (steward/operator) task returns rc=0 here, so
    # mesh-dispatch consumes its dedup sig (mesh-dispatch:436 — sig→$STATE only on rc=0) and NEVER
    # re-surfaces it: this ONE pass is the task's only announcement chance. Mirror the rc=4 [fyi] (same
    # one-shot cost — rc=5 always returns 0 so it can never re-fire) so the HELD task is VISIBLE on the
    # board for the human, not only echoed to local stdout/dispatch.log where it silently sinks.
    # UNIFIED with owner_hold_announce() (chat-review/mindcontrol-posts-wrapper-not-task, 2026-07-05):
    # this branch used to post its OWN separate mesh-chat line from the raw (often FRAMED, "Board task
    # assigned to you..." wrapped) $task, with no shared dedup against owner_hold_announce()'s
    # unconditional per-pass hook — the SAME human-owned task could announce TWICE (once garbled via
    # this framed path, once readable via the other), each keyed on a different text representation.
    # Delegating here converges on ONE announce mechanism, ONE dedup store, and ONE stripped-text
    # representation regardless of which path reaches it first.
    owner_hold_announce "$task" >/dev/null 2>&1 || true
    echo "owner-tagged task is HUMAN-OWNED (steward/operator) — manual action, not mind-dispatchable, not generic-picked: $task"; return 0
  fi
  if [ "$otrc" = 4 ]; then
    MESH_WHO="mind-control@$SESS" mesh-chat "[fyi] owner window ABSENT — mis-tag (tool name vs window name?) caught at dispatch, falling through to generic pick: $(dispatch_echo_summary "$task")" >/dev/null 2>&1 || true
    ot=""
  fi
  if [ -n "$ot" ]; then
    win="${ot%%	*}"; tier="${ot#*	}"
  else
    p="$(_pick_agentic)"; win="${p%%	*}"; tier="${p#*	}"
    # REMOTE-PHAEDRA FALLBACK (chat-review/dispatch-blind-to-phaedra): _pick_agentic() only scans
    # THIS node's local WORKERS/AGENTIC_FALLBACK, so a task either drops on the floor (win empty)
    # or queues behind a busy local claude ("claude-queued") even when phaedra sits IDLE right
    # next door. Probe phaedra ONLY in those two cases — a genuinely idle local worker (claude or
    # free-engine) always wins locally; phaedra is last-resort overflow capacity, not a race with
    # the local pick. Reuses allocate()'s own PHAEDRA_ALLOC_NODE/PHAEDRA_ALLOC_WIN/remote_state_of
    # primitives (:749-751) — deliberately NOT _phaedra_agentic_pref (that one is weather-gated for
    # allocate()'s thermal-day preference, a different policy than this floor-avoidance fallback).
    if [ -z "$win" ] || [ "$tier" = claude-queued ]; then
      local rst; rst="$(remote_state_of "$PHAEDRA_ALLOC_NODE" "$PHAEDRA_ALLOC_WIN" 2>/dev/null)"; rst="${rst%%	*}"
      if [ "$rst" = IDLE ]; then
        remote_win="$PHAEDRA_ALLOC_WIN"; win="$PHAEDRA_ALLOC_NODE:$PHAEDRA_ALLOC_WIN"; tier="remote-phaedra"
      fi
    fi
  fi
  [ -n "$win" ] || { echo "NO available worker (all blocked/limited/dead) — NOT dispatched: $task"; return 2; }
  # RESUME-RESURFACE (chat-review/claim-no-resume-resurface 2026-07-20): a [taking] claim had NO
  # resume-resurface and NO auto-yield-on-shed — nothing re-offers a claimed task (":12 errs toward
  # already-claimed"), mesh-claim --yield is manual-only, so a shed-and-resumed claimer's unfinished
  # work starved up to the 4h STALE_TTL while dispatch fed it NEWER unclaimed tasks (live: genome
  # claimed selfcare+swap-drain 14:50Z, got rate-limit-shed, and on each resume took 4 other tasks
  # over 2.5h — the #1-board-noise fix sat untouched). An IDLE window WITH an open [taking] is
  # exactly that shed-orphan shape (an actively-working claimer reads BUSY and never gets here), so
  # before delivering new work: re-surface the mind's OLDEST open claim (finish-or-yield prompt into
  # its own pane) and HOLD the new task (rc=2 → no ACKED record, mesh-dispatch keeps it
  # re-dispatchable). Three deliberate reliefs so the claim loop can't become its own starvation:
  # a claim younger than MESH_RESURFACE_GRACE holds SILENTLY (a just-posted [taking] in a turn-gap —
  # resurfacing it would inject into a mind that's about to work); intra-MESH_RESURFACE_COOLDOWN the
  # hold LIFTS entirely (the mind already had its resurface this window and idled again without
  # closing — fresh work must not starve behind a claim it visibly isn't resuming); past
  # MESH_RESURFACE_TTL the evaporation lane owns it. LOCAL windows only: a remote pick's claims post
  # under the peer's own hostname and its own mind-control runs this same check there.
  if [ -z "$remote_win" ]; then
    local rsf; rsf="$(_open_taking_of "$win" "$now")" || rsf=""
    if [ -n "$rsf" ]; then
      local rsf_cid="${rsf%%	*}" rsf_rest="${rsf#*	}"
      local rsf_age="${rsf_rest%%	*}" rsf_body="${rsf_rest#*	}"
      if [ "$rsf_age" -lt "${MESH_RESURFACE_GRACE:-600}" ]; then
        echo "task HELD (target $win posted [taking] '$rsf_cid' ${rsf_age}s ago — likely mid-turn-gap, not resurfacing yet): $task"
        return 2
      fi
      local rcool="${MESH_RESURFACE_COOLDOWN:-1800}" rlast=0
      local rf="${MESH_RESURFACE_STATE_DIR:-$MESH_DIR}/.resurfaced-${win}-${rsf_cid}"
      [ -f "$rf" ] && rlast=$(cat "$rf" 2>/dev/null || echo 0)
      case "$rlast" in ''|*[!0-9]*) rlast=0 ;; esac
      if [ $(( now - rlast )) -ge "$rcool" ]; then
        local rmins=$(( rsf_age / 60 )) rtell_err rtell_rc
        local rtell="RESUME your open [taking] claim '$rsf_cid' (posted ${rmins}m ago, still OPEN on the board): $(printf '%s' "$rsf_body" | cut -c1-220) — finish it and post [done] $rsf_cid: <result+cite>, or release it (mesh-chat \"[yield] $rsf_cid — <why>\") if you can't. New board work is HELD behind this claim."
        rtell_err="$(mesh-tell --ack "$win" "$rtell" 2>&1 1>/dev/null)"; rtell_rc=$?
        if [ "$rtell_rc" = 0 ] && ! printf '%s' "$rtell_err" | grep -q 'NO-ACK'; then
          echo "$now" > "$rf" 2>/dev/null
          echo "task HELD — resurfaced open claim '$rsf_cid' (${rmins}m) to $win, finish-or-yield: $task"
          MESH_WHO="mind-control@$SESS" mesh-chat "[resurface] → $win: open [taking] '$rsf_cid' (${rmins}m) re-surfaced (finish-or-yield); new task HELD: $(dispatch_echo_summary "$task")" >/dev/null 2>&1 || true
          return 2
        fi
        # resurface delivery itself failed/NO-ACK: don't stamp (retry next pass), don't hold new work
        # hostage to a pane that isn't accepting prompts — fall through to the normal delivery path,
        # whose own --ack machinery will surface the pane problem visibly ([dispatch-noack]).
        echo "resurface delivery FAILED/NO-ACK ($win, claim '$rsf_cid') — falling through to normal dispatch: $task"
      fi
    fi
  fi
  # DELIVERY-VERIFIED SEND (chat-review/dispatch-tell-no-ackcheck 2026-07-09): a bare 'mesh-tell; tell_rc=$?'
  # only reflects whether tmux send-keys RAN, not whether the target pane actually SUBMITTED the prompt.
  # A stalled/unsubmitted paste (the exact NOACK class mesh-tell's --ack + ack_probe were built to catch,
  # 2026-06-24) was silently recorded as a successful hand-off (DISPATCH_ACKED write + a [dispatch] board
  # line CLAIMING delivery) — the live cause of 3+ owner-direct tasks stranding for hours with genome IDLE
  # and never re-engaging (board 2026-07-09 18:42:29Z / 20:41:09Z). Now: send with --ack and read the
  # '[ack …: NO-ACK …]' stderr line. On NO-ACK, retry ONCE (a paste-burst/doze composer stall is usually
  # transient); if STILL NO-ACK, do NOT record DISPATCH_ACKED and do NOT post the delivery-claiming
  # [dispatch] line — surface a visible [dispatch-noack] so mind-control's own delivery failures stop
  # masquerading as successful hand-offs, and the task stays re-dispatchable next pass.
  # LOAD-AWARE ACK WINDOW (chat-review/acktimeout-thermal-blind 2026-07-10): widen the ACK poll fed to
  # mesh-tell under measured CPU/thermal stress so a slow-to-render (starved) engine still reads RECEIVED
  # instead of being discarded as a false NO-ACK. Empty under normal load → mesh-tell's fast 4s default.
  # Scoped INSIDE the command substitution (the prefix assignment dies with that subshell) so it never
  # leaks into dispatch()'s scope or clobbers an externally-set MESH_TELL_ACK_TIMEOUT on the next pass.
  local tell_rc tell_err ack_try=0 ackto
  ackto="$(_ack_timeout_for_load)"
  while : ; do
    if [ -n "$remote_win" ]; then
      tell_err="$( [ -n "$ackto" ] && export MESH_TELL_ACK_TIMEOUT="$ackto"; mesh-tell --ack --node "$PHAEDRA_ALLOC_NODE" "$remote_win" "$task" 2>&1 1>/dev/null )"; tell_rc=$?
    else
      tell_err="$( [ -n "$ackto" ] && export MESH_TELL_ACK_TIMEOUT="$ackto"; mesh-tell --ack "$win" "$task" 2>&1 1>/dev/null )"; tell_rc=$?
    fi
    if [ "$tell_rc" != 0 ]; then
      echo "dispatch FAILED (mesh-tell $win — pane gone / refused?): $task"; return 1
    fi
    case "$tell_err" in
      *NO-ACK*)
        ack_try=$((ack_try+1))
        if [ "$ack_try" -lt 2 ]; then sleep 1; continue; fi
        # persistent NO-ACK: delivery unverified — do NOT claim success, leave the task re-dispatchable.
        # Carry mesh-tell's final pane-tail snapshot (chat-review/ack-noack-is-an-absence-verdict) so
        # the verdict brings its evidence instead of the bare guess "(stalled composer?)" — the two
        # 2026-07-16 [dispatch-noack] lines were both FALSE and undiagnosable post-hoc without it.
        local noack_tail; noack_tail="$(printf '%s\n' "$tell_err" | grep -o 'pane-tail: .*' | tail -1 | cut -c1-140)"
        echo "dispatch NO-ACK ($win — prompt stalled unsubmitted in pane?): $task"
        _dispatch_noack_announce_once "$win" "$tier" "$task" "$noack_tail"
        return 1 ;;
    esac
    break
  done
  printf '%s|%s|%s|%s|%s|%s\n' "$fp" "$now" "$win" "$tier" "$task_safe" "$cite_norm" >> "$DISPATCH_ACKED"
  echo "dispatched → $win ($tier): $task"
  MESH_WHO="mind-control@$SESS" mesh-chat "[dispatch] → $win ($tier): $(dispatch_echo_summary "$task")" >/dev/null 2>&1 || true
}

# owner_hold_announce <task> — one-shot board [fyi] for a human-owned (steward/operator) task,
# OUTSIDE the paced dispatch() path (chat-review/human-owned-announce-pace-starved). A board post
# wakes no mind and costs no paid tokens (the spend-governor's own reasoning gates PAID dispatch,
# never board text) — but the ONLY place this announce lived was dispatch()'s otrc=5 branch,
# reachable ONLY via mesh-mind-control --dispatch, which mesh-dispatch calls ONLY after mesh-pace
# clears (chat-review/pace-noop-consumes-slot's gate). A human-owned task that wasn't the pass's
# single pick, or whose pass PACE-SKIPped, went unannounced for hours (restore-router-reach-operator,
# 2h+ live). rc=5 (human-owned) → announce once, return 0; anything else (not human-owned, or
# already announced) → return 1, so the caller's unconditional per-pass scan stays silent for those.
# Dedup is OWN persistent state (HOLD_STATE), independent of mesh-dispatch's paced $STATE sig (never
# reached when this is the ONLY thing that ran on a PACE-SKIPped pass) and of dispatch()'s
# DISPATCH_ACKED (TIMEOUT-pruned, a different re-dispatch-suppression job).
# _auth_dead_alert_once <win> — ONE-SHOT (per-window, cooldown-gated) board alert that a mind window is
# LOGGED OUT (mesh-mind-state AUTH-DEAD, exit 9). Replaces the old blind route→NOACK→[dispatch-noack]
# retry loop (2 owner-tagged tasks stranded for hours on phaedra's logged-out genome, 2026-07-10) with a
# human-actionable signal: re-copy creds + restart the engine (memory mind-401-needs-engine-restart),
# after which the pane re-classifies IDLE and dispatch resumes on its own. Deduped per window so a
# persistently logged-out pane doesn't re-alert every scan; re-fires only after MESH_AUTHDEAD_COOLDOWN
# (default 4h) so a long-unfixed outage resurfaces instead of going permanently silent.
_auth_dead_alert_once() {
  local win="$1"; [ -n "$win" ] || return 0
  local cool="${MESH_AUTHDEAD_COOLDOWN:-14400}" now last=0
  local f="${MESH_AUTHDEAD_STATE:-$MESH_DIR/.authdead-alert-$win}"
  now=$(date +%s)
  [ -f "$f" ] && last=$(cat "$f" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $(( now - last )) -ge "$cool" ] || return 0
  echo "$now" > "$f" 2>/dev/null
  MESH_WHO="mind-control@$SESS" mesh-chat "[auth-dead] mind window '$win' is LOGGED OUT ('Not logged in' / 'Please run /login') — owner-tagged work is HELD, not dispatched. Fix: re-copy creds + restart the engine (memory mind-401-needs-engine-restart); it then re-classifies IDLE and dispatch resumes." >/dev/null 2>&1 || true
}

# _dispatch_noack_announce_once <win> <tier> <task> — ONE board [dispatch-noack] per (win,claim_id)
# episode, cooldown-gated (chat-review/dispatch-noack-board-undeduped 2026-07-10). The persistent-NO-ACK
# path returns 1 so mesh-dispatch never consumes its dedup sig (sig→STATE only on rc=0) → the task stays
# re-dispatchable → re-picked → this post fired on EVERY cycle for the residual live-but-busy composer-stall
# subclass (window reads IDLE at pick, stalls at submit): 14 [dispatch-noack] lines/300 observed, one window
# re-announcing "deploy-heal … mesh-fitness" ×5 and "quotareact-test…" ×4. fafca25 deduped the AUTH-DEAD
# subclass UPSTREAM (otrc=9 HOLD) but this board post stayed undeduped. Mirror the two sibling dedups in
# this same function — _auth_dead_alert_once (per-window cooldown) and owner_hold_announce (HOLD_STATE):
# post to chat on the first failure + past-cooldown, route intra-cooldown repeats to mesh-trace (the
# [expected-down] once/episode idiom) so the signal survives without spamming the room every cycle.
_dispatch_noack_announce_once() {
  local win="$1" tier="$2" task="$3" evidence="${4:-}"; [ -n "$win" ] || return 0
  local cid; cid="$(claim_id_of "$task")"
  [ -n "$cid" ] || cid="$(printf '%s' "$task" | md5sum | cut -d' ' -f1 | cut -c1-12)"
  local cool="${MESH_NOACK_COOLDOWN:-14400}" now last=0
  local f="${MESH_NOACK_STATE_DIR:-$MESH_DIR}/.noack-announced-${win}-${cid}"
  now=$(date +%s)
  [ -f "$f" ] && last=$(cat "$f" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  local line="[dispatch-noack] → $win ($tier): prompt did NOT submit (composer held text / pane unchanged) — NOT recorded, will re-dispatch: $(dispatch_echo_summary "$task")${evidence:+ [$evidence]}"
  if [ $(( now - last )) -ge "$cool" ]; then
    echo "$now" > "$f" 2>/dev/null
    MESH_WHO="mind-control@$SESS" mesh-chat "$line" >/dev/null 2>&1 || true
  else
    mesh-trace "$line (intra-cooldown, chat-suppressed)" >/dev/null 2>&1 || true
  fi
}

owner_hold_announce() {
  local task="$1"; [ -n "$task" ] || return 1
  local ot otrc; ot="$(_owner_target "$task")"; otrc=$?
  [ "$otrc" = 5 ] || return 1
  # STRIP-BEFORE-HASH (chat-review/mindcontrol-posts-wrapper-not-task, 2026-07-05): dedup+display both
  # key on the FRAME-STRIPPED text, not the raw $task — a FRAMED call (dispatch()'s otrc=5, wrapped in
  # "Board task assigned to you... TASK: <task>") and a RAW call (mesh-dispatch's unconditional
  # --owner-hold-announce scan, unwrapped) are the SAME underlying task but previously hashed
  # differently, so they announced TWICE (once unreadable). dispatch_echo_summary is a no-op on
  # already-unwrapped text, so the raw-call path is unaffected.
  local stripped; stripped="$(dispatch_echo_summary "$task")"
  local sig; sig="$(printf '%s' "$stripped" | md5sum | cut -d' ' -f1)"
  local HOLD_STATE="${MESH_OWNER_HOLD_STATE:-$MESH_DIR/.owner-hold-announced}"
  [ -f "$HOLD_STATE" ] && grep -qF "$sig" "$HOLD_STATE" 2>/dev/null && return 1
  MESH_WHO="mind-control@$SESS" mesh-chat "[fyi] human-owned task HELD for steward/operator (manual action — not mind-dispatchable): $stripped" >/dev/null 2>&1 || true
  echo "$sig" >> "$HOLD_STATE" 2>/dev/null
  echo "HELD (announced, deduped): $task"
}

# classify_task <task> -> prints "agentic <reason>" or "text <reason>" on stdout.
# HONEST heuristic, zero-cost + deterministic (so it's testable + has no inference dependency):
#  - AGENTIC = needs tools / side-effects / multi-step (edit a file, run a command, verify against
#    reality, git/ssh/tmux, a path or filename). Routing this to a text pool returns a USELESS non-answer
#    (it describes what it WOULD do, doesn't do it) — so AGENTIC is also the conservative default on a tie.
#  - TEXT = a pure transform with no side-effect (summarize / translate / explain / classify / draft).
classify_task() {
  local t; t="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  # 1. a file path / filename / code-ish token → agentic even with "summarize": a text pool has no
  #    filesystem, so "summarize scripts/mesh-tick" needs a tool to READ the file first.
  if printf '%s' "$t" | grep -qE '(^|[[:space:]])/[a-z]|\.(sh|py|md|json|conf|service|timer|ya?ml)([[:space:]]|$)|scripts/|~/\.mesh|\.local/bin'; then
    echo "agentic file/path token"; return; fi
  # 2. LEADING pure-transform verb → text, even if an agentic NOUN appears later in the subject
  #    ("draft a tg update about the pane FIX" = write text, not perform a fix). The lead verb wins.
  if printf '%s' "$t" | grep -qE '^[[:space:]]*(please[[:space:]]+|can you[[:space:]]+|could you[[:space:]]+)?(summari[sz]e|translate|explain|describe|answer|draft|rephrase|reword|compose|paraphrase|define|tell me|what is|who is)\b'; then
    echo "text leading transform verb"; return; fi
  # 3. action verbs implying tools / mutation / execution / reality-checking
  if printf '%s' "$t" | grep -qwE 'edit|write|create|add|append|fix|repair|build|implement|code|refactor|rename|move|delete|remove|chmod|patch|chang(e|ing)|run|execute|exec|commit|push|deploy|install|wire|configure|set\s?up|restart|verify|reality-check|investigate|debug|diagnose|reproduce|test|smoke|probe|scan|measure|capture|record|ssh|git|tmux|cron|provision'; then
    echo "agentic action verb"; return; fi
  # 4. pure-transform verb anywhere (no agentic signal above) = text
  if printf '%s' "$t" | grep -qwE 'summari[sz]e|translate|explain|describe|classify|answer|draft|rephrase|reword|rewrite|compose|tldr|summary|paraphrase|define|what is|who is|list (the )?(pros|cons)'; then
    echo "text pure-transform verb"; return; fi
  echo "agentic default (ambiguous → safe side: a misrouted agentic-as-text gives a non-answer)"
}

# _flush_blocked — aggregate accumulated BLOCKED tasks into one board message.
_flush_blocked() {
  [ -s "$ALLOC_BLOCKED" ] || return 0  # nothing to flush
  local now; now=$(date +%s)
  local last=0
  [ -f "$ALLOC_BLOCKED_TS" ] && last=$(cat "$ALLOC_BLOCKED_TS" 2>/dev/null || echo 0)
  # Only flush if enough time has passed since last flush
  [ $(( now - last )) -lt "$AGGREGATE_WINDOW" ] && return 0
  echo "$now" > "$ALLOC_BLOCKED_TS"
  local count samples
  count=$(sort -u "$ALLOC_BLOCKED" 2>/dev/null | wc -l)
  samples=$(sort -u "$ALLOC_BLOCKED" 2>/dev/null | head -3 | while IFS= read -r t; do
    printf '• %s ' "${t:0:60}"
  done)
  [ "$count" -gt 3 ] && samples="${samples}(+$((count-3)) more) "
  MESH_WHO="mind-control@$SESS" mesh-chat "[allocate] BLOCKED — no agentic capacity ($count tasks queued): $samples" >/dev/null 2>&1 || true
  : > "$ALLOC_BLOCKED"
}
# PREFER-PHAEDRA on a forecast thermal day (weather-consumers-phase2, 2026-07-07,
# capability-weather-thermal-forecast-20260705.md): phaedra is a DC VPS, weather-independent by
# design (its own card carries no cam/mic/thermal senses — see CLAUDE.local.md), so it is the
# natural place to shift agentic work OFF a node under anticipated thermal pressure. Gated on THIS
# node's OWN local weather-state (never phaedra's — phaedra has no local weather sense and none is
# claimed for it); honest-fusion: UNKNOWN thermal_day (absent/stale sense) → NO preference, the
# unmodified existing local pick, never a fabricated "prefer phaedra" from a sense we don't have.
# remote_state_of mirrors state_of but targets a peer via mesh-mind-state's own --node support
# (ssh, bounded ConnectTimeout=8s inside mesh-mind-state's peek_win) — unreachable/busy/unhealthy
# phaedra must fall through to the ordinary local pick, never block or fail allocate() outright.
PHAEDRA_ALLOC_NODE="${MESH_ALLOC_PHAEDRA_NODE:-phaedra}"
PHAEDRA_ALLOC_WIN="${MESH_ALLOC_PHAEDRA_WIN:-genome}"
remote_state_of() { mesh-mind-state "$2" --node "$1" 2>/dev/null | head -1 || printf 'ABSENT\t(no classify)\n'; }
_phaedra_agentic_pref() {
  [ "$(weather_field thermal_day)" = 1 ] || return 1
  local st; st="$(remote_state_of "$PHAEDRA_ALLOC_NODE" "$PHAEDRA_ALLOC_WIN")"; st="${st%%	*}"
  [ "$st" = IDLE ] || return 1
  printf '%s\n' "$PHAEDRA_ALLOC_WIN"
}
# allocate <task> — the smart router. text→cheapest inference pool; agentic→best available agentic mind.
allocate() {
  local task="$1"; [ -n "$task" ] || { echo "usage: mesh-mind-control --allocate \"<task>\""; return 1; }
  local verdict reason; verdict="$(classify_task "$task")"; reason="${verdict#* }"; verdict="${verdict%% *}"
  if [ "$verdict" = text ]; then
    echo "route: TEXT ($reason) → mesh-relay (cheapest available pool)"
    if command -v mesh-relay >/dev/null 2>&1; then
      MESH_WHO="mind-control@$SESS" mesh-chat "[allocate] TEXT→relay: $(printf '%s' "$task" | cut -c1-80)" >/dev/null 2>&1 || true
      mesh-relay "$task"; return $?
    fi
    echo "mesh-relay unavailable — cannot serve text task"; return 2
  fi
  # AGENTIC: PREFER-PHAEDRA on a forecast thermal day, before the ordinary engine-aware local pick.
  local phw; phw="$(_phaedra_agentic_pref 2>/dev/null)"
  if [ -n "$phw" ]; then
    echo "route: AGENTIC ($reason) → phaedra:$phw (thermal_day=1 on $(hostname) — weather-independent DC node preferred)"
    if mesh-tell --node "$PHAEDRA_ALLOC_NODE" "$phw" "$task" >/dev/null 2>&1; then
      echo "  dispatched → phaedra:$phw"
      MESH_WHO="mind-control@$SESS" mesh-chat "[allocate] AGENTIC→phaedra:$phw (thermal-day-prefer): $(printf '%s' "$task" | cut -c1-80)" >/dev/null 2>&1 || true
      return 0
    fi
    echo "  phaedra dispatch FAILED — falling back to the local pick"
  fi
  # AGENTIC: engine-aware pick (claude → free → queue), shared with the board reflex.
  local claude_ok; claude_ok="$(mesh-claude-check --quiet 2>/dev/null || echo '?')"
  local p win tier; p="$(_pick_agentic)"; win="${p%%	*}"; tier="${p#*	}"
  if [ -z "$win" ]; then
    echo "route: AGENTIC ($reason) → NO available agentic capacity (all workers busy/blocked) — NOT dispatched"
    echo "$task" >> "$ALLOC_BLOCKED"
    _flush_blocked
    return 2
  fi
  # Successful dispatch — clear stale blocked accumulator
  [ -s "$ALLOC_BLOCKED" ] && : > "$ALLOC_BLOCKED"
  case "$tier" in
    claude)        echo "route: AGENTIC ($reason) → claude worker '$win' (idle, preferred)";;
    free:*)        echo "route: AGENTIC ($reason) → FREE-agentic '$win' (${tier#free:}, idle — claude busy/walled: claude-access=$claude_ok)";;
    claude-queued) echo "route: AGENTIC ($reason) → queued to busy claude worker '$win' (no idle claude or free worker)";;
  esac
  _send_agentic "$win" "$task" "$tier"; return $?
}
_send_agentic() { # <win> <task> <tier-label>
  if mesh-tell "$1" "$2" >/dev/null 2>&1; then
    echo "  dispatched → $1"
    MESH_WHO="mind-control@$SESS" mesh-chat "[allocate] AGENTIC→$1 ($3): $(printf '%s' "$2" | cut -c1-80)" >/dev/null 2>&1 || true
  else echo "  dispatch FAILED (mesh-tell $1 — pane gone?)"; return 1; fi
}

# ── DARWINIAN AGENT SELECTION (study: autopoiesis-alife 2026-07-06) ────────────────────────────────
# A simple digital Darwinian competition among the mesh's agents, favouring those that optimize the
# COMMON GOAL. The common goal of this fleet is the metabolic loop's verified output — self-produced
# changes that actually advance the codebase. So an agent's FITNESS = the count of its own cited [done]
# posts in a window (a [done] carrying a commit hash / scripts/<file> / landed|FIXED|UNCOMMITTED|cite:
# = work that demonstrably moved the goal, NOT a bare/empty [done] and NOT a [heartbeat]/[idle]). The
# SELECTION WEIGHT is a softmax over fitness — the differential-reproduction signal: the share of the
# shared dispatch resource a fitter agent WOULD win. Agents that post but ship nothing appear at
# fitness 0, so the competition is visible, not just a winners' list.
#   This is deliberately the INSTRUMENT-FIRST step of the header's HELD ICV fix: it MEASURES contribution
# from an UNAMBIGUOUS success signal (cited [done]) — sidestepping the confound-prone causal-influence
# attribution that keeps the ICV picker-gate un-shipped — and it is strictly READ-ONLY. It does NOT gate
# _pick_agentic; wiring a fitness axis into the work-routing actuator needs the causal validation +
# operator/steward sign-off the ICV note demands (and must respect card-authority — never shed a mind).
#   LITERATURE — a NEW concrete failure-mode grounding for staying READ-ONLY (2026-07-07 live review):
# Shah, Nemenman, Polani & Tiomkin, "Multi-Agent Empowerment and Emergence of Complex Behavior in
# Groups", arXiv:2604.21155 (Apr 2026, fetched + read in full). They extend single-agent empowerment
# to multi-agent settings by modelling coupled dynamics as a multi-user INTERFERENCE CHANNEL: each
# agent's empowerment ℰ⁽ⁿ⁾ is computed against a noise term that INCLUDES the other agents' actions as
# structured interference, resolved via Nash equilibrium (iterative water-filling) — the opposite of
# computing each agent's score independently. Their flocking experiment is the load-bearing finding:
# when agents maximise their OWN empowerment egoistically (independent per-agent optimisation, no
# interference term), the emergent group behaviour is COUNTER-PROPAGATING BANDS, not the consensus
# alignment real flocks show — individually-rational empowerment-maximisation is collectively
# incoherent unless the mutual-interference coupling between agents is explicitly modelled.
#   THE SELECTION WEIGHT BELOW IS EXACTLY THIS EGOISTIC SHAPE: softmax(fitness) is computed per-mind,
# independently, from each mind's OWN cited-[done] count — it has no term for how one mind's work
# depends on or is enabled by another's (a mind that unblocks 4 others' starved tasks, this session's
# `chat-review/ownertarget-codewins-fallback`, scores identically to 4 isolated one-off fixes; nothing
# here would catch two minds racing the SAME goal in [[parallel-minds-same-goal-different-file]] and
# scoring it as 2x fitness instead of 1 coordinated success). This is a genuinely NEW, concrete reason
# (not just the ICV note's qualitative "confound-prone" caution) that wiring this softmax straight into
# dispatch risks the SAME class of failure the paper demonstrates empirically: a competition that looks
# individually sound producing group-level pathology instead of the coordination the mesh actually
# wants. If this axis is ever unheld, the fix implied by the paper is not just a causal-influence
# estimate (the existing ICV requirement) but an INTERFERENCE/COUPLING term — crediting joint outcomes
# jointly, not summing isolated per-mind counts — before the weight may touch _pick_agentic.
fitness_leaderboard() {
  local win_h="${1:-24}"; case "$win_h" in ''|*[!0-9]*) win_h=24;; esac
  local log="${MESH_MC_CHATLOG:-$MESH_DIR/chat.log}"
  [ -r "$log" ] || { echo "mesh-mind-control --fitness: no readable chat.log at $log"; return 0; }
  local cutoff temp; cutoff=$(date -u -d "$win_h hours ago" +%FT%TZ 2>/dev/null) || cutoff=""
  # Temperature = SELECTION PRESSURE on MAX-NORMALISED fitness (softmax over fit/maxfit, not raw fit —
  # a raw softmax saturates to winner-take-all once counts reach the tens: exp(41-28) ≈ 4e5). Lower T =
  # sharper (more winner-take-all); default keeps the top agents graded and distinguishable at any scale.
  temp="${MESH_MC_FITNESS_TEMP:-0.4}"
  echo "=== mesh minds · fitness (Darwinian selection · INSTRUMENT-ONLY) · window ${win_h}h ==="
  awk -v cut="$cutoff" -v temp="$temp" '
    # board line: <ISO-ts>  <who>@<host>  ::  [marker] ...   (ISO ts fixed-width → lexical window compare)
    $1 >= cut {
      who = $2; a = index(who, "@"); if (a > 0) who = substr(who, 1, a-1)
      if (who == "") next
      if ($0 ~ /\[done\]/ && $0 ~ /[0-9a-f]{7,40}|scripts\//) { if (!(who in fit)) fit[who]=0; fit[who]++; seen[who]=1 }
      else if ($0 ~ /\[done\]/ && $0 ~ /UNCOMMITTED|landed|FIXED|[Cc]ite:/) { if (!(who in fit)) fit[who]=0; fit[who]++; seen[who]=1 }
      else if ($0 ~ /\[(taking|done|heartbeat|idle|fyi|verify|design)\]/) { if (!(who in fit)) fit[who]=0; seen[who]=1 }
    }
    END {
      maxfit=0; for (w in seen) if (fit[w]>maxfit) maxfit=fit[w]
      Z=0; for (w in seen) { nf=(maxfit>0)?fit[w]/maxfit:0; e[w]=exp(nf/temp); Z+=e[w] }
      printf "  %-11s %7s  %10s   %s\n", "AGENT","FITNESS","SEL-WEIGHT","(cited [done] = common-goal advance)"
      if (Z==0) { print "  (no agents active in window)"; exit }
      n=0; for (w in seen) { n++; name[n]=w; val[n]=fit[w] }
      for (i=1;i<=n;i++) for (j=i+1;j<=n;j++) if (val[j]>val[i]) { t=val[i];val[i]=val[j];val[j]=t; s=name[i];name[i]=name[j];name[j]=s }
      for (i=1;i<=n;i++) { w=name[i]; wt=e[w]/Z; bars=int(wt*20+0.5); bar=""; for (k=0;k<bars;k++) bar=bar"#"
        printf "  %-11s %7d  %10.3f   %s\n", w, fit[w], wt, bar }
    }
  ' "$log"
  echo "  weight = softmax(fitness) share IF this fed the picker (differential reproduction toward the goal)."
  echo "  READ-ONLY: does NOT gate dispatch — the held ICV contribution-axis (see header) needs a causal"
  echo "  estimate + operator/steward sign-off before a fitness signal may actuate work-routing."
}

case "${1:-}" in
  --test)     # smoke + classifier assertions (a router that misroutes is worse than none)
              fails=0
              assert(){ local got; got="$(classify_task "$1")"; got="${got%% *}"
                [ "$got" = "$2" ] || { echo "  classify FAIL: '$1' → $got (want $2)"; fails=$((fails+1)); }; }
              assert "fix the syntax error in scripts/mesh-tick" agentic
              assert "summarize the last 10 board posts" text
              assert "translate this message to english" text
              assert "verify mesh-act fires the phone vibrate" agentic
              assert "run mesh-doctor and report FAILs" agentic
              assert "explain what a reflex is" text
              assert "commit and push the change" agentic
              assert "draft a telegram update about the pane fix" text
              assert "summarize scripts/mesh-tick" agentic
              # _pick_agentic tier assertions — stub state_of/engine_of so picks are deterministic.
              # State/engine are read from "$PK_STATE"/"$PK_ENG" maps set per case (win=state, win=engine).
              state_of(){ printf '%s\t-\n' "$(printf '%s\n' "$PK_STATE" | grep "^$1=" | cut -d= -f2)"; }
              engine_of(){ printf '%s\n' "$(printf '%s\n' "$PK_ENG" | grep "^$1=" | cut -d= -f2)"; }
              # health stub: a win listed UNHEALTHY in $PK_HEALTH is unhealthy; absent/empty = OK (so the
              # pre-existing picker cases, which don't set it, all read healthy and stay unchanged).
              PK_HEALTH=""
              health_of(){ local h; h="$(printf '%s\n' "$PK_HEALTH" | grep "^$1=" | cut -d= -f2)"; printf '%s\n' "${h:-OK}"; }
              pkassert(){ local got; got="$(_pick_agentic)"; [ "$got" = "$2" ] || { echo "  pick FAIL: [$1] → '$got' (want '$2')"; fails=$((fails+1)); }; }
              # (a) sole worker blocked, nothing else free → unblock it (last-resort), not dropped
              WORKERS="genome"; AGENTIC_FALLBACK=""
              PK_STATE=$'genome=NEEDS-INPUT'; PK_ENG=$'genome=agy'
              pkassert "sole genome blocked" $'genome\tblocked-unblock:agy'
              # (b) an idle free mind present → it wins; blocked worker is NOT preferred
              WORKERS="genome"; AGENTIC_FALLBACK="chat"
              PK_STATE=$'genome=NEEDS-INPUT\nchat=IDLE'; PK_ENG=$'genome=agy\nchat=opencode'
              pkassert "idle-free beats blocked" $'chat\tfree:opencode'
              # (c) a blocked mind that's only in the FALLBACK pool is never auto-answered → empty
              WORKERS="genome"; AGENTIC_FALLBACK="chat"
              PK_STATE=$'genome=WORKING\nchat=NEEDS-INPUT'; PK_ENG=$'genome=opencode\nchat=opencode'; PK_HEALTH=""
              pkassert "fallback-only blocked ignored" ""
              # (d) WORKER RELIABILITY: idle claude but UNHEALTHY (erroring) + idle healthy free → free wins,
              #     the broken engine is NOT handed real work (the VPN-Canada delegation failure).
              WORKERS="genome chat"; AGENTIC_FALLBACK=""
              PK_STATE=$'genome=IDLE\nchat=IDLE'; PK_ENG=$'genome=claude\nchat=opencode'; PK_HEALTH=$'genome=UNHEALTHY'
              pkassert "unhealthy claude skipped for healthy free" $'chat\tfree:opencode'
              # (e) sole worker idle-but-UNHEALTHY, nothing else → still dispatched (last-resort), NOT dropped
              WORKERS="genome"; AGENTIC_FALLBACK=""
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=$'genome=UNHEALTHY'
              pkassert "sole unhealthy worker is last-resort, not dropped" $'genome\tunhealthy:claude'
              # (f) regression: a HEALTHY idle claude still wins outright when present
              WORKERS="genome"; AGENTIC_FALLBACK=""
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              pkassert "healthy idle claude still wins" $'genome\tclaude'
              # (g) WEDGE BLINDNESS (chat-review/dispatch-picker-blind-to-wedge): a WEDGED-INPUT claude
              #     worker + an idle free worker → the free one wins; the wedged claude must NOT be picked
              #     top-tier. Before the fix state_of never emitted WEDGED-INPUT so this read IDLE→top pick,
              #     and dispatch re-targeted the same wedged '/clear' window every tick (Default-string loop).
              WORKERS="genome chat"; AGENTIC_FALLBACK=""
              PK_STATE=$'genome=WEDGED-INPUT\nchat=IDLE'; PK_ENG=$'genome=claude\nchat=opencode'; PK_HEALTH=""
              pkassert "wedged claude loses to idle free" $'chat\tfree:opencode'
              # (h) sole WEDGED-INPUT worker, nothing else free → still dispatchable last-resort (mesh-tell's
              #     C-u clears+delivers), NOT dropped — ranks in the blocked tier like NEEDS-INPUT.
              WORKERS="genome"; AGENTIC_FALLBACK=""
              PK_STATE=$'genome=WEDGED-INPUT'; PK_ENG=$'genome=claude'; PK_HEALTH=""
