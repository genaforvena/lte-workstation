              long_task="chat-review/dispatch-echo-truncation-marker-selftest: this task text is intentionally longer than ninety characters so it must truncate"
              deassert "$long_task" "chat-review/dispatch-echo-truncation-marker-selftest: this task text is intentionally long…"
              # DELIMITER-INJECTABLE regression (chat-review/mindcontrol-posts-wrapper-not-task ADDENDUM,
              # live-reproduced 2026-07-05 07:33Z): a self-referential task whose OWN text contains the
