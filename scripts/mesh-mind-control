              [ "$got_noenv" != "$self_ref_task" ] || echo "  NOTE: heuristic happened to survive this fixture (fine, not required — env var is the real guarantee)"
              got_env="$(MESH_DISPATCH_RAW_TASK="$self_ref_task" dispatch_echo_summary "$self_ref_framed")"
              [ "$got_env" = "$self_ref_task" ] || { echo "  echo FAIL: MESH_DISPATCH_RAW_TASK did not override the frame-parse heuristic (got '$got_env')"; fails=$((fails+1)); }
              # --owner-route wrapper (chat-review/dispatch-idle-gate-starves-owner-direct): mirrors the
