              # tag-less print NOTHING so mesh-dispatch never wakes a mind mind-control would only HOLD.
              orassert(){ local ot rc out; ot="$(_owner_target "$1")"; rc=$?; out=""; { [ "$rc" = 0 ] && [ -n "$ot" ] && out="${ot%%	*}"; }; [ "$out" = "$2" ] || { echo "  owner-route FAIL: [$3] → '$out' (want '$2')"; fails=$((fails+1)); }; }
              PK_STATE=$'pub=IDLE'; PK_HEALTH=""
