              # falls through past rc=4 to the generic picker, which has a "busyc"/"blocked" LAST-RESORT
              # tier that still picks a WORKING or NEEDS-INPUT worker via the REAL (unmocked) engine_of()
              # — a first attempt at this test set genome=WORKING assuming that alone would starve the
              # picker, but engine_of("genome") truthfully reports the REAL live engine (claude) for this
              # very session, so busyc fired and dispatch() called the REAL mesh-tell, injecting this
              # test's fixture text into this session's own live pane. mesh-tell is now UNCONDITIONALLY
              # stubbed for every dispatch()-calling test in this file (never just relying on picker
              # starvation) so no assertion can ever reach a real pane, regardless of picker outcome.
              oa_cap="$(mktemp)"; oa_tell="$(mktemp)"
              mesh-chat(){ printf '%s\n' "$*" >>"$oa_cap"; }
              mesh-tell(){ printf '%s\t%s\n' "$1" "$2" >>"$oa_tell"; return 0; }
              PK_STATE=$'genome=WORKING\nnonexistent-window=ABSENT'; PK_HEALTH=""
              framed_oa="Board task assigned to you. FIRST verify it is still live. TASK: wire-oa-selftest: fix it (owner: nonexistent-window)"
              DISPATCH_ACKED="$(mktemp -u)" dispatch "$framed_oa" >/dev/null 2>&1
              grep -qF 'Board task assigned to you' "$oa_cap" && { echo "  owner-ABSENT FAIL: board line leaked the dispatch frame verbatim"; fails=$((fails+1)); }
              grep -qF 'wire-oa-selftest' "$oa_cap" || { echo "  owner-ABSENT FAIL: board line lost the real task's slug"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$oa_cap" "$oa_tell"
              # owner_hold_announce() (chat-review/human-owned-announce-pace-starved): the pace-exempt
              # unconditional-scan hook. Assert (1) a human-owned task announces + returns 0, (2) a
              # normal owner-tagged task (idle, owner-direct) is NOT announced (returns 1, no board post
              # — it belongs to the paced dispatch path, not this hook), (3) a repeat call on the SAME
              # human-owned task is deduped (no 2nd board line, still returns 1 per the "already
              # announced" contract). HERMETIC: stub mesh-chat, point HOLD_STATE at a temp file.
              oh_cap="$(mktemp)"; oh_state="$(mktemp -u)"
              mesh-chat(){ printf '%s\n' "$*" >>"$oh_cap"; }
              MESH_OWNER_HOLD_STATE="$oh_state" owner_hold_announce "restore-router-reach-operator: re-run (owner: operator)"
              oh_rc1=$?
              [ "$oh_rc1" = 0 ] || { echo "  owner-hold-announce FAIL: human-owned task did not return 0"; fails=$((fails+1)); }
              grep -qi '\[fyi\].*human-owned task HELD' "$oh_cap" || { echo "  owner-hold-announce FAIL: no board [fyi] for human-owned task"; fails=$((fails+1)); }
              PK_STATE=$'pub=IDLE'; PK_HEALTH=""
              : > "$oh_cap"
              MESH_OWNER_HOLD_STATE="$oh_state" owner_hold_announce "push a retrigger commit (owner: pub)"
              oh_rc2=$?
              [ "$oh_rc2" = 1 ] || { echo "  owner-hold-announce FAIL: normal owner-direct task should return 1 (not this hook's job)"; fails=$((fails+1)); }
              [ -s "$oh_cap" ] && { echo "  owner-hold-announce FAIL: normal owner-direct task should not board-post"; fails=$((fails+1)); }
              : > "$oh_cap"
              MESH_OWNER_HOLD_STATE="$oh_state" owner_hold_announce "restore-router-reach-operator: re-run (owner: operator)"
              oh_rc3=$?
              [ "$oh_rc3" = 1 ] || { echo "  owner-hold-announce FAIL: repeat call on same task should return 1 (deduped)"; fails=$((fails+1)); }
              [ -s "$oh_cap" ] && { echo "  owner-hold-announce FAIL: repeat call re-posted (dedup broken)"; fails=$((fails+1)); }
              unset -f mesh-chat; rm -f "$oh_cap" "$oh_state"
              # fitness_leaderboard (study autopoiesis-alife/darwinian-agent-selection): the read-only
              # competition. Fixture board: genome ships 2 in-window cited [done], land 1, chat only a
              # [heartbeat] (fitness 0), + a 48h-old genome [done] that must fall OUTSIDE the 24h window.
              # Assert: exact fitness (genome=2 not 3, land=1, chat=0-and-VISIBLE) + fitness-desc ranking
              # + softmax weights sum≈1 & are strictly monotone with fitness. HERMETIC via MESH_MC_CHATLOG.
              fit_log="$(mktemp)"; fit_host="$(hostname)"
              fit_recent="$(date -u -d '1 hour ago' +%FT%TZ)"; fit_old="$(date -u -d '48 hours ago' +%FT%TZ)"
              {
                echo "$fit_recent  genome@$fit_host  ::  [done] genome: fixA landed scripts/mesh-foo (abc1234)"
                echo "$fit_recent  genome@$fit_host  ::  [done] genome: fixB FIXED in tree scripts/mesh-bar UNCOMMITTED"
                echo "$fit_recent  land@$fit_host  ::  [done] land: landed 1 fix scripts/mesh-baz"
                echo "$fit_recent  chat@$fit_host  ::  [heartbeat] chat: alive, orienting"
                echo "$fit_old     genome@$fit_host  ::  [done] genome: OLD landed scripts/mesh-old (deadbeef)"
              } > "$fit_log"
              fit_out="$(MESH_MC_CHATLOG="$fit_log" MESH_MC_FITNESS_TEMP=1 fitness_leaderboard 24)"
              printf '%s\n' "$fit_out" | grep -qE '^[[:space:]]*genome[[:space:]]+2[[:space:]]' || { echo "  fitness FAIL: genome must score EXACTLY 2 in-window cited-done (the 48h-old one is out of window)"; fails=$((fails+1)); }
              printf '%s\n' "$fit_out" | grep -qE '^[[:space:]]*land[[:space:]]+1[[:space:]]'   || { echo "  fitness FAIL: land must score 1"; fails=$((fails+1)); }
              printf '%s\n' "$fit_out" | grep -qE '^[[:space:]]*chat[[:space:]]+0[[:space:]]'    || { echo "  fitness FAIL: chat (heartbeat only) must appear at fitness 0 — the competition must be VISIBLE, not a winners-only list"; fails=$((fails+1)); }
              fgpos=$(printf '%s\n' "$fit_out" | grep -nE '^[[:space:]]*genome[[:space:]]' | head -1 | cut -d: -f1)
              flpos=$(printf '%s\n' "$fit_out" | grep -nE '^[[:space:]]*land[[:space:]]'   | head -1 | cut -d: -f1)
              fcpos=$(printf '%s\n' "$fit_out" | grep -nE '^[[:space:]]*chat[[:space:]]'   | head -1 | cut -d: -f1)
              { [ -n "$fgpos" ] && [ -n "$flpos" ] && [ -n "$fcpos" ] && [ "$fgpos" -lt "$flpos" ] && [ "$flpos" -lt "$fcpos" ]; } || { echo "  fitness FAIL: leaderboard must rank fitter agents first (genome<land<chat by line pos); got g=$fgpos l=$flpos c=$fcpos"; fails=$((fails+1)); }
              # softmax weights: strictly monotone with fitness (genome_wt > land_wt > chat_wt), share in (0,1)
              fgw=$(printf '%s\n' "$fit_out" | awk '/^[[:space:]]*genome[[:space:]]/{print $3; exit}')
              flw=$(printf '%s\n' "$fit_out" | awk '/^[[:space:]]*land[[:space:]]/{print $3; exit}')
              fcw=$(printf '%s\n' "$fit_out" | awk '/^[[:space:]]*chat[[:space:]]/{print $3; exit}')
              awk -v g="$fgw" -v l="$flw" -v c="$fcw" 'BEGIN{exit !(g>l && l>c && c>0 && g<1)}' || { echo "  fitness FAIL: softmax weights must be strictly monotone with fitness and a valid share (0<c<l<g<1); got g=$fgw l=$flw c=$fcw"; fails=$((fails+1)); }
              rm -f "$fit_log"
              # weather-consumers-phase2 (2026-07-07): --allocate PREFER-PHAEDRA on thermal_day=1.
              # HERMETIC: stub weather_field (never reads the real .weather-state), remote_state_of
              # (never SSHes), mesh-tell + mesh-chat (never touches a real pane/board).
              wa_cap="$(mktemp)"; wa_tell="$(mktemp)"
              mesh-chat(){ printf '%s\n' "$*" >>"$wa_cap"; }
              mesh-tell(){ printf '%s\n' "$*" >>"$wa_tell"; return 0; }
              # (a) thermal_day=0 → phaedra never even probed, falls straight to the ordinary local pick.
              weather_field(){ echo 0; }
              remote_state_of(){ echo "SHOULD-NOT-BE-CALLED"; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              wa_out="$(allocate "wa-mild-day: agentic test task" 2>&1)"
              printf '%s\n' "$wa_out" | grep -qF phaedra && { echo "  phaedra-pref FAIL: thermal_day=0 must never prefer phaedra (got: $wa_out)"; fails=$((fails+1)); }
              printf '%s\n' "$wa_out" | grep -qF "worker 'genome'" || { echo "  phaedra-pref FAIL: thermal_day=0 must still route to the local idle worker (got: $wa_out)"; fails=$((fails+1)); }
              : > "$wa_cap"; : > "$wa_tell"
              # (b) thermal_day UNKNOWN (absent weather sense) → same as (a): honest-fusion, no preference.
              weather_field(){ echo UNKNOWN; }
              wa_out="$(allocate "wa-unknown-day: agentic test task" 2>&1)"
              printf '%s\n' "$wa_out" | grep -qF phaedra && { echo "  phaedra-pref FAIL: UNKNOWN thermal_day must NOT be treated as thermal_day=1 (got: $wa_out)"; fails=$((fails+1)); }
              : > "$wa_cap"; : > "$wa_tell"
              # (c) thermal_day=1 + phaedra IDLE → routes to phaedra, dispatches via mesh-tell --node,
              # and never falls through to the local picker (PK_STATE genome=IDLE would happily accept
              # it too, so this also proves phaedra is tried FIRST, not merely as an empty-picker fallback).
              weather_field(){ echo 1; }
              remote_state_of(){ printf 'IDLE\t-\n'; }
              wa_out="$(allocate "wa-thermal-day: agentic test task" 2>&1)"
              printf '%s\n' "$wa_out" | grep -qF 'phaedra:genome' || { echo "  phaedra-pref FAIL: thermal_day=1 + phaedra IDLE must route to phaedra:genome (got: $wa_out)"; fails=$((fails+1)); }
              grep -qF -- '--node phaedra genome' "$wa_tell" || { echo "  phaedra-pref FAIL: mesh-tell must be called with --node phaedra's window (tell log: $(cat "$wa_tell"))"; fails=$((fails+1)); }
              grep -qF 'wa-thermal-day' "$wa_tell" || { echo "  phaedra-pref FAIL: mesh-tell must carry the real task text (tell log: $(cat "$wa_tell"))"; fails=$((fails+1)); }
              grep -qF 'thermal-day-prefer' "$wa_cap" || { echo "  phaedra-pref FAIL: board post must name the thermal-day-prefer route"; fails=$((fails+1)); }
              : > "$wa_cap"; : > "$wa_tell"
              # (d) thermal_day=1 but phaedra BUSY (not IDLE) → falls through to the local pick, never blocks.
              remote_state_of(){ printf 'WORKING\t-\n'; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              wa_out="$(allocate "wa-phaedra-busy: agentic test task" 2>&1)"
              printf '%s\n' "$wa_out" | grep -qF phaedra && { echo "  phaedra-pref FAIL: busy phaedra must fall through, not be reported as the route (got: $wa_out)"; fails=$((fails+1)); }
              printf '%s\n' "$wa_out" | grep -qF "worker 'genome'" || { echo "  phaedra-pref FAIL: busy phaedra must still fall through to the local idle worker (got: $wa_out)"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell weather_field remote_state_of; rm -f "$wa_cap" "$wa_tell"
              # REMOTE-PHAEDRA FALLBACK (chat-review/dispatch-blind-to-phaedra): dispatch()'s own picker
              # (unlike allocate()'s weather-gated _phaedra_agentic_pref) must not strand a task behind
              # a busy local worker — or drop it — when phaedra sits IDLE right next door. HERMETIC:
              # stub mesh-tell/mesh-chat + remote_state_of (never SSHes) + local state/engine via
              # PK_STATE/PK_ENG/PK_HEALTH (stubbed globally above).
              rp_cap="$(mktemp)"; rp_tell="$(mktemp)"
              mesh-chat(){ printf '%s\n' "$*" >>"$rp_cap"; }
              mesh-tell(){ printf '%s\n' "$*" >>"$rp_tell"; return 0; }
              # (a) every local worker BUSY (claude-queued tier) + phaedra IDLE → route to phaedra:genome
              # via 'mesh-tell --node phaedra genome', board line names phaedra:genome/remote-phaedra.
              PK_STATE=$'genome=WORKING\nchat=WORKING\nhealth=WORKING'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              remote_state_of(){ printf 'IDLE\t-\n'; }
              rp_out="$(DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/dispatch-blind-to-phaedra-selftest: fix the picker" 2>&1)"
              printf '%s\n' "$rp_out" | grep -qF 'phaedra:genome' || { echo "  remote-phaedra FAIL: busy-local + idle-phaedra must route to phaedra:genome (got: $rp_out)"; fails=$((fails+1)); }
              grep -qF 'phaedra:genome' "$rp_cap" || { echo "  remote-phaedra FAIL: board [dispatch] line missing phaedra:genome (cap: $(cat "$rp_cap"))"; fails=$((fails+1)); }
              grep -qF 'remote-phaedra' "$rp_cap" || { echo "  remote-phaedra FAIL: board [dispatch] line missing the remote-phaedra tier tag (cap: $(cat "$rp_cap"))"; fails=$((fails+1)); }
              grep -qF -- '--node phaedra genome' "$rp_tell" || { echo "  remote-phaedra FAIL: mesh-tell must be called with --node phaedra genome (tell log: $(cat "$rp_tell"))"; fails=$((fails+1)); }
              grep -qF 'dispatch-blind-to-phaedra-selftest' "$rp_tell" || { echo "  remote-phaedra FAIL: mesh-tell must carry the real task text (tell log: $(cat "$rp_tell"))"; fails=$((fails+1)); }
              : > "$rp_cap"; : > "$rp_tell"
              # (b) a genuinely idle LOCAL worker exists → unchanged, remote_state_of must never even be
              # queried (poison stub fails loudly if the local-idle path calls it at all).
              remote_state_of(){ echo "SHOULD-NOT-BE-CALLED"; return 1; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              rp_out2="$(DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/dispatch-blind-to-phaedra-selftest2: idle local worker" 2>&1)"
              printf '%s\n' "$rp_out2" | grep -qF '→ phaedra' && { echo "  remote-phaedra FAIL: an idle LOCAL worker must win outright, phaedra must not be probed (got: $rp_out2)"; fails=$((fails+1)); }
              printf '%s\n' "$rp_out2" | grep -qF 'genome (claude)' || { echo "  remote-phaedra FAIL: idle local worker 'genome' must still be dispatched normally (got: $rp_out2)"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell remote_state_of; rm -f "$rp_cap" "$rp_tell"
              # DELIVERY-ACK GATE (chat-review/dispatch-tell-no-ackcheck 2026-07-09): dispatch() must treat
              # a mesh-tell '[ack …: NO-ACK …]' stderr line (send RAN, pane never SUBMITTED) as a FAILED
              # hand-off — no DISPATCH_ACKED record, no delivery-claiming [dispatch] board line — and post a
              # visible [dispatch-noack] so the task stays re-dispatchable. Root cause of 3+ owner-direct
              # tasks stranding for hours with genome IDLE (board 2026-07-09 18:42:29Z/20:41:09Z). HERMETIC:
              # stub mesh-tell to emit the NO-ACK stderr shape with rc=0 (the exact 'send succeeded, pane
              # never processed it' failure). Falsifiable: reverting dispatch() to the bare
              # 'mesh-tell; tell_rc=$?' send makes the ACKED file non-empty + posts [dispatch] (both asserts trip).
              na_cap="$(mktemp)"; na_tell="$(mktemp)"; na_ack="$(mktemp -u)"
              na_noackdir="$(mktemp -d)"   # fresh per-run so the (win,cid) cooldown never suppresses this assert on a re-run
              mesh-chat(){ printf '%s\n' "$*" >>"$na_cap"; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              # (a) NO-ACK on the send AND its one retry → dispatch must NOT record, must post [dispatch-noack],
              # and the board line must CARRY mesh-tell's pane-tail snapshot (chat-review/ack-noack-is-an-
              # absence-verdict: a snapshot-less verdict is undiagnosable post-hoc). Stub emits the live
              # NO-ACK stderr shape incl. 'pane-tail: …'; falsify: drop the evidence extraction/append in
              # dispatch()/_dispatch_noack_announce_once → the pane-tail assert trips.
              mesh-tell(){ printf '%s\n' "$*" >>"$na_tell"; echo "[ack genome @ local]: NO-ACK — composer holds text / pane unchanged after 4s; prompt may be UNSUBMITTED (re-peek) pane-tail: ❯ fix the ack ga… ⏎ paste again to expand" >&2; return 0; }
              na_out="$(DISPATCH_ACKED="$na_ack" MESH_OWNER_HOLD_STATE="$(mktemp -u)" MESH_NOACK_STATE_DIR="$na_noackdir" dispatch "chat-review/dispatch-noack-selftest: fix the ack gate" 2>&1)"
              [ -s "$na_ack" ] && { echo "  dispatch-ack FAIL: a NO-ACK send must NOT be recorded in DISPATCH_ACKED (got: $(cat "$na_ack"))"; fails=$((fails+1)); }
              grep -qF '[dispatch-noack]' "$na_cap" || { echo "  dispatch-ack FAIL: persistent NO-ACK must post a [dispatch-noack] board line (cap: $(cat "$na_cap"))"; fails=$((fails+1)); }
              grep -qF 'pane-tail: ❯ fix the ack ga' "$na_cap" || { echo "  dispatch-ack FAIL: [dispatch-noack] board line must carry mesh-tell's pane-tail evidence (cap: $(cat "$na_cap"))"; fails=$((fails+1)); }
              grep -qF '[dispatch] →' "$na_cap" && { echo "  dispatch-ack FAIL: a NO-ACK send must NOT post a delivery-claiming [dispatch] line"; fails=$((fails+1)); }
              [ "$(grep -c . "$na_tell")" -ge 2 ] || { echo "  dispatch-ack FAIL: a NO-ACK send must be RETRIED once (>=2 mesh-tell calls, got $(grep -c . "$na_tell"))"; fails=$((fails+1)); }
              grep -qF -- '--ack' "$na_tell" || { echo "  dispatch-ack FAIL: dispatch() must call mesh-tell with --ack (tell log: $(cat "$na_tell"))"; fails=$((fails+1)); }
              : > "$na_cap"; : > "$na_tell"; na_ack2="$(mktemp -u)"
              # (b) RECEIVED (no NO-ACK line) → unchanged: recorded + normal [dispatch] board line, no retry (regression guard).
              mesh-tell(){ printf '%s\n' "$*" >>"$na_tell"; return 0; }
              na_out2="$(DISPATCH_ACKED="$na_ack2" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/dispatch-ack-ok-selftest: normal delivery" 2>&1)"
              [ -s "$na_ack2" ] || { echo "  dispatch-ack FAIL: a RECEIVED send must be recorded in DISPATCH_ACKED (regression)"; fails=$((fails+1)); }
              grep -qF '[dispatch] →' "$na_cap" || { echo "  dispatch-ack FAIL: a RECEIVED send must post the normal [dispatch] board line (regression; cap: $(cat "$na_cap"))"; fails=$((fails+1)); }
              grep -qF '[dispatch-noack]' "$na_cap" && { echo "  dispatch-ack FAIL: a RECEIVED send must NOT post [dispatch-noack]"; fails=$((fails+1)); }
              [ "$(grep -c . "$na_tell")" = 1 ] || { echo "  dispatch-ack FAIL: a RECEIVED send must NOT retry (exactly 1 mesh-tell call, got $(grep -c . "$na_tell"))"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$na_cap" "$na_tell"
              # NO-ACK BOARD-POST DEDUP (chat-review/dispatch-noack-board-undeduped 2026-07-10): the persistent
              # NO-ACK path returns 1 so mesh-dispatch never consumes its dedup sig → the SAME (win,slug) is
              # re-picked and re-fired every cycle. _dispatch_noack_announce_once must post to chat ONCE per
              # (win,claim_id) episode and route intra-cooldown repeats to mesh-trace; a DIFFERENT slug (or a
              # past-cooldown re-fire) still posts. HERMETIC: capture chat vs trace to separate files, drive the
              # persistent-NO-ACK path (mesh-tell emits the NO-ACK stderr shape rc=0), share ONE fresh
              # MESH_NOACK_STATE_DIR across two same-slug dispatches. Falsifiable: reverting the post to the bare
              # unconditional mesh-chat makes the 2nd same-slug dispatch post a SECOND chat line (dd1 trips).
              dd_chat="$(mktemp)"; dd_trace="$(mktemp)"; dd_dir="$(mktemp -d)"
              mesh-chat(){ printf '%s\n' "$*" >>"$dd_chat"; }
              mesh-trace(){ printf '%s\n' "$*" >>"$dd_trace"; }
              mesh-tell(){ echo "[ack genome @ local]: NO-ACK — pane still idle" >&2; return 0; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" MESH_NOACK_STATE_DIR="$dd_dir" dispatch "chat-review/dispatch-noack-dedup-selftest: stalls" >/dev/null 2>&1
              DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" MESH_NOACK_STATE_DIR="$dd_dir" dispatch "chat-review/dispatch-noack-dedup-selftest: stalls" >/dev/null 2>&1
              [ "$(grep -c '\[dispatch-noack\]' "$dd_chat")" = 1 ] || { echo "  noack-dedup FAIL: two same-(win,slug) persistent NO-ACKs must post EXACTLY ONE chat [dispatch-noack] (got $(grep -c '\[dispatch-noack\]' "$dd_chat"))"; fails=$((fails+1)); }
              [ "$(grep -c '\[dispatch-noack\]' "$dd_trace")" -ge 1 ] || { echo "  noack-dedup FAIL: the intra-cooldown repeat must route to mesh-trace (got $(cat "$dd_trace"))"; fails=$((fails+1)); }
              : > "$dd_chat"
              # a DIFFERENT slug (same win) still posts normally — dedup is per-(win,slug), not a global mute.
              DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" MESH_NOACK_STATE_DIR="$dd_dir" dispatch "chat-review/dispatch-noack-dedup-other-selftest: stalls too" >/dev/null 2>&1
              [ "$(grep -c '\[dispatch-noack\]' "$dd_chat")" = 1 ] || { echo "  noack-dedup FAIL: a DIFFERENT slug must still post its own chat [dispatch-noack] (regression; got $(grep -c '\[dispatch-noack\]' "$dd_chat"))"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-trace mesh-tell; rm -f "$dd_chat" "$dd_trace"
              # LOAD-AWARE ACK WINDOW (chat-review/acktimeout-thermal-blind 2026-07-10): dispatch() must
              # WIDEN the MESH_TELL_ACK_TIMEOUT it feeds mesh-tell under measured CPU/thermal stress (a
              # starved engine paints its footer slowly → a real hand-off would else read NO-ACK and be
              # discarded), and leave it UNSET under normal load (mesh-tell's fast default). HERMETIC: stub
              # mesh-tell to record the timeout env it saw; drive _ack_timeout_for_load via
              # MESH_THERM_STATE + MESH_LOADAVG_SRC + MESH_NPROC_OVERRIDE fixtures. Falsifiable: reverting
              # dispatch() to the bare 'mesh-tell --ack' send makes every case record ACKTO=unset (a/b trip).
              lw_tell="$(mktemp)"; lw_ok="$(mktemp)"; echo OK  >"$lw_ok"
              lw_hot="$(mktemp)"; echo HOT >"$lw_hot"
              lw_lo="$(mktemp)";  echo "0.50 0.40 0.30 1/99 1"  >"$lw_lo"
              lw_hi="$(mktemp)";  echo "20.0 18.0 15.0 9/99 1"  >"$lw_hi"
              mesh-chat(){ :; }
              mesh-tell(){ printf 'ACKTO=%s\n' "${MESH_TELL_ACK_TIMEOUT:-unset}" >>"$lw_tell"; return 0; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              # (a) thermal HOT (loadavg low) → widened to 12
              : >"$lw_tell"
              MESH_THERM_STATE="$lw_hot" MESH_LOADAVG_SRC="$lw_lo" MESH_NPROC_OVERRIDE=8 \
                DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/lw-hot-selftest: x" >/dev/null 2>&1
              grep -qF 'ACKTO=12' "$lw_tell" || { echo "  ack-load FAIL: thermal HOT must widen MESH_TELL_ACK_TIMEOUT to 12 (got: $(cat "$lw_tell"))"; fails=$((fails+1)); }
              # (b) high loadavg (>nproc), thermal OK → widened to 12
              : >"$lw_tell"
              MESH_THERM_STATE="$lw_ok" MESH_LOADAVG_SRC="$lw_hi" MESH_NPROC_OVERRIDE=8 \
                DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/lw-hiload-selftest: x" >/dev/null 2>&1
              grep -qF 'ACKTO=12' "$lw_tell" || { echo "  ack-load FAIL: loadavg>nproc must widen the ACK timeout (got: $(cat "$lw_tell"))"; fails=$((fails+1)); }
              # (c) low load + thermal OK → NOT widened (mesh-tell sees no override; regression guard)
              : >"$lw_tell"
              MESH_THERM_STATE="$lw_ok" MESH_LOADAVG_SRC="$lw_lo" MESH_NPROC_OVERRIDE=8 \
                DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/lw-lowload-selftest: x" >/dev/null 2>&1
              grep -qF 'ACKTO=unset' "$lw_tell" || { echo "  ack-load FAIL: low load + OK thermal must NOT widen (leave mesh-tell's default; got: $(cat "$lw_tell"))"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$lw_tell" "$lw_ok" "$lw_hot" "$lw_lo" "$lw_hi"
              # CROSS-NODE DEDUP (chat-review/dispatch-cross-node-dedup 2026-07-07): a sibling host's
              # [dispatch]/[taking] of the SAME claim-id, still fresh, must suppress a local dispatch()
              # even though THIS node's OWN DISPATCH_ACKED has never heard of the task — the live
              # incident: ds dispatched groq-stt at 21:43, IdeaPad independently dispatched it AGAIN at
              # 21:48 (each node's local ACKED file was empty for it) → duplicate parallel fixes →
              # shared-checkout divergence. HERMETIC via MESH_MC_CHATLOG (mirrors the fitness_leaderboard
              # fixture above) + stubbed mesh-chat/mesh-tell + a throwaway DISPATCH_ACKED/OWNER_HOLD_STATE
              # per call so no assertion ever touches the real board or a real pane. Falsifiable:
              # removing the board-consult block from dispatch() makes assertion (a) fail (mesh-tell
              # would get called despite the fresh foreign-host [dispatch] of the same slug).
              xn_log="$(mktemp)"; xn_cap="$(mktemp)"; xn_tell="$(mktemp)"
              mesh-chat(){ printf '%s\n' "$*" >>"$xn_cap"; }
              mesh-tell(){ printf '%s\t%s\n' "$1" "$2" >>"$xn_tell"; return 0; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              xn_now=$(date +%s)
              xn_fresh="$(date -u -d "@$((xn_now - 300))" +%FT%TZ)"   # 5min ago — within default 1800s TIMEOUT
              xn_stale="$(date -u -d "@$((xn_now - 3600))" +%FT%TZ)"  # 1h ago — past default 1800s TIMEOUT
              # (a) foreign-host [dispatch] of the SAME slug, fresh → local dispatch SUPPRESSED, mesh-tell NEVER called
              echo "$xn_fresh  land@some-other-host  ::  [dispatch] → sense (claude): chat-review/xnode-dedup-selftest: fix the race" > "$xn_log"
              xn_out="$(MESH_MC_CHATLOG="$xn_log" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/xnode-dedup-selftest: fix the race" 2>&1)"
              printf '%s\n' "$xn_out" | grep -qi 'already dispatched.*cross-node' || { echo "  cross-node-dedup FAIL: same-slug fresh board [dispatch] from another host did not suppress (got: $xn_out)"; fails=$((fails+1)); }
              [ -s "$xn_tell" ] && { echo "  cross-node-dedup FAIL: mesh-tell was called despite a fresh foreign-host [dispatch] of the same slug"; fails=$((fails+1)); }
              : > "$xn_tell"; : > "$xn_cap"
              # (b) foreign-host [dispatch] of a DIFFERENT slug → dispatches normally (mesh-tell IS called)
              xn_out="$(MESH_MC_CHATLOG="$xn_log" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/totally-different-selftest: unrelated fix" 2>&1)"
              [ -s "$xn_tell" ] || { echo "  cross-node-dedup FAIL: a DIFFERENT slug must still dispatch (mesh-tell never called; got: $xn_out)"; fails=$((fails+1)); }
              : > "$xn_tell"; : > "$xn_cap"
              # (c) foreign-host [dispatch] of the SAME slug but STALE (past DISPATCH_ACK_TIMEOUT) → dispatches anyway
              echo "$xn_stale  land@some-other-host  ::  [dispatch] → sense (claude): chat-review/xnode-dedup-selftest: fix the race" > "$xn_log"
              xn_out="$(MESH_MC_CHATLOG="$xn_log" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/xnode-dedup-selftest: fix the race" 2>&1)"
              [ -s "$xn_tell" ] || { echo "  cross-node-dedup FAIL: a STALE (>TIMEOUT) foreign-host [dispatch] must not suppress (mesh-tell never called; got: $xn_out)"; fails=$((fails+1)); }
              : > "$xn_tell"; : > "$xn_cap"
              # BOARD-[done] SCAN (chat-review/dispatch-consult-omits-done): a [done] landing after the
              # picker read the board but before the pre-tell consult is invisible to the [taking]/[dispatch]
              # scan → the pick→tell race re-fires an already-resolved task. The [done] branch suppresses it.
              # Falsifiable: revert the [done] branch → (a) slips through (mesh-tell called on a done task).
              xd_fresh="$(date -u -d "@$((xn_now - 300))" +%FT%TZ)"   # 5min ago — within TIMEOUT
              xd_stale="$(date -u -d "@$((xn_now - 3600))" +%FT%TZ)"  # 1h ago — past TIMEOUT
              # (a) a FRESH [done] for this slug → SUPPRESSED, mesh-tell NEVER called (reproduces the bug when reverted)
              echo "$xd_fresh  genome@some-host  ::  [done] stale: chat-review/done-race-selftest: already resolved (abc1234)" > "$xn_log"
              xd_out="$(MESH_MC_CHATLOG="$xn_log" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/done-race-selftest: fix the race" 2>&1)"
              printf '%s\n' "$xd_out" | grep -qi 'already resolved.*board \[done\]' || { echo "  done-consult FAIL: a fresh board [done] for this slug did not suppress (got: $xd_out)"; fails=$((fails+1)); }
              [ -s "$xn_tell" ] && { echo "  done-consult FAIL: mesh-tell was called despite a fresh board [done] of the same slug"; fails=$((fails+1)); }
              : > "$xn_tell"; : > "$xn_cap"
              # (b) only a STALE [done] (past TIMEOUT) → still dispatches (mesh-tell IS called)
              echo "$xd_stale  genome@some-host  ::  [done] stale: chat-review/done-race-selftest: already resolved (abc1234)" > "$xn_log"
              xd_out="$(MESH_MC_CHATLOG="$xn_log" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/done-race-selftest: fix the race" 2>&1)"
              [ -s "$xn_tell" ] || { echo "  done-consult FAIL: a STALE (>TIMEOUT) board [done] must not suppress (mesh-tell never called; got: $xd_out)"; fails=$((fails+1)); }
              : > "$xn_tell"; : > "$xn_cap"
              # (c) no [done] at all → unchanged (dispatches normally)
              : > "$xn_log"
              xd_out="$(MESH_MC_CHATLOG="$xn_log" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/done-race-selftest: fix the race" 2>&1)"
              [ -s "$xn_tell" ] || { echo "  done-consult FAIL: no board [done] must dispatch normally (mesh-tell never called; got: $xd_out)"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$xn_log" "$xn_cap" "$xn_tell"
              # ── CROSS-NODE FRESHNESS PRE-SYNC (chat-review/dispatch-gossip-lag-recur 2026-07-09) ───
              # The cross-node dedup above only catches a peer's claim once mesh-chat-sync has gossiped
              # it into the local board. On a */25 gossip cron the peer's fresh [dispatch] can be absent
              # at scan-time → double-dispatch (live 20:03Z: two mind-controls, byte-identical slug, 4s
              # apart). The presync guard pulls the board synchronously before the scan when gossip is
              # stale. HERMETIC: MESH_MC_PRESYNC_CMD points at a fixture that APPENDS the peer's fresh
              # [dispatch] line to the same MESH_MC_CHATLOG the scan reads — simulating the just-arrived
              # gossip. Stamp forced stale (MESH_MC_PRESYNC_STAMP → nonexistent path). Falsifiable:
              # with the presync (a) suppresses (peer claim pulled in); disabling it (b) slips through.
              ps_log="$(mktemp)"; ps_cap="$(mktemp)"; ps_tell="$(mktemp)"; ps_sync="$(mktemp)"; ps_stamp="$(mktemp -u)"
              mesh-chat(){ printf '%s\n' "$*" >>"$ps_cap"; }
              mesh-tell(){ printf '%s\t%s\n' "$1" "$2" >>"$ps_tell"; return 0; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              ps_now=$(date +%s); ps_fresh="$(date -u -d "@$((ps_now - 120))" +%FT%TZ)"
              # the fixture sync command: writes the peer's fresh same-slug [dispatch] into the board file
              cat > "$ps_sync" <<PSY
#!/usr/bin/env bash
echo "$ps_fresh  land@some-other-host  ::  [dispatch] → sense (claude): chat-review/gossip-lag-selftest: fix the race" >> "$ps_log"
PSY
              chmod +x "$ps_sync"
              # (a) board initially EMPTY of the peer claim, but presync pulls it in → SUPPRESSED
              : > "$ps_log"
              ps_out="$(MESH_MC_CHATLOG="$ps_log" MESH_MC_PRESYNC_CMD="$ps_sync" MESH_MC_PRESYNC_STAMP="$ps_stamp" DISPATCH_PRESYNC_MIN=0 DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/gossip-lag-selftest: fix the race" 2>&1)"
              printf '%s\n' "$ps_out" | grep -qi 'already dispatched.*cross-node' || { echo "  gossip-lag-presync FAIL: presync did not pull the peer's fresh claim before the scan → not suppressed (got: $ps_out)"; fails=$((fails+1)); }
              [ -s "$ps_tell" ] && { echo "  gossip-lag-presync FAIL: mesh-tell was called despite presync surfacing a fresh foreign-host [dispatch]"; fails=$((fails+1)); }
              : > "$ps_tell"; : > "$ps_cap"; rm -f "$ps_stamp"
              # (b) DISABLED presync (MESH_MC_PRESYNC_CMD="") with the same empty board → claim never pulled → SLIPS THROUGH (dispatches)
              : > "$ps_log"
              ps_out="$(MESH_MC_CHATLOG="$ps_log" MESH_MC_PRESYNC_CMD="" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/gossip-lag-selftest: fix the race" 2>&1)"
              [ -s "$ps_tell" ] || { echo "  gossip-lag-presync FAIL: with presync DISABLED and a stale board the same slug must slip through (mesh-tell never called; got: $ps_out)"; fails=$((fails+1)); }
              : > "$ps_tell"; : > "$ps_cap"
              # (c) FRESH stamp (within DISPATCH_PRESYNC_MIN) → presync SKIPPED, so an empty board is NOT refreshed → dispatches (rate-limit works)
              : > "$ps_log"; touch "$ps_stamp"
              ps_out="$(MESH_MC_CHATLOG="$ps_log" MESH_MC_PRESYNC_CMD="$ps_sync" MESH_MC_PRESYNC_STAMP="$ps_stamp" DISPATCH_PRESYNC_MIN=300 DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/gossip-lag-selftest: fix the race" 2>&1)"
              [ -s "$ps_tell" ] || { echo "  gossip-lag-presync FAIL: a FRESH presync stamp must skip the pull (rate-limit) so an empty board dispatches (mesh-tell never called; got: $ps_out)"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$ps_log" "$ps_cap" "$ps_tell" "$ps_sync" "$ps_stamp"
              # ── SAME-TARGET DEDUP (chat-review/dispatch-dedup-target-not-text) ─────────────────────
              # fp(exact text) + xid(author slug) both miss a same-file + overlapping-line-range task
              # worded differently — live 19:04:30Z/19:05:13Z: two [task]s citing mesh-mind-state:176-182
              # with different slugs, neither key caught it. Field-6 citation dedup catches it. SHARED
              # DISPATCH_ACKED across calls so the 2nd dispatch sees the 1st's recorded citation; empty
              # MESH_MC_CHATLOG so the xid cross-node scan finds nothing and the node-local citation path
              # is what's exercised; synthetic tool name so nothing touches the real board. Falsifiable:
              # revert dispatch()'s citation-overlap block → (b) stops suppressing.
              st_cap="$(mktemp)"; st_tell="$(mktemp)"; st_ack="$(mktemp)"; st_log="$(mktemp)"
              mesh-chat(){ printf '%s\n' "$*" >>"$st_cap"; }
              mesh-tell(){ printf '%s\t%s\n' "$1" "$2" >>"$st_tell"; return 0; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              # (a) first task citing mesh-sttgt-fixture:176-182 → dispatches + records the citation
              st1="$(MESH_MC_CHATLOG="$st_log" DISPATCH_ACKED="$st_ack" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/sttgt-selftest-a: pane_comms (scripts/mesh-sttgt-fixture:176-182) trusts display-message to error on a bogus window" 2>&1)"
              [ -s "$st_tell" ] || { echo "  same-target FAIL: first cited task must dispatch (got: $st1)"; fails=$((fails+1)); }
              grep -q 'mesh-sttgt-fixture:176-182' "$st_ack" || { echo "  same-target FAIL: DISPATCH_ACKED did not record the citation (ack: $(cat "$st_ack"))"; fails=$((fails+1)); }
              : > "$st_tell"
              # (b) DIFFERENT wording+slug, SAME file + OVERLAPPING range (180-190 ∩ 176-182) → SUPPRESSED, mesh-tell NEVER called
              st2="$(MESH_MC_CHATLOG="$st_log" DISPATCH_ACKED="$st_ack" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/sttgt-selftest-b: display-message resolves a nonexistent window to a real tty (mesh-sttgt-fixture:180-190) so classify emits DEAD-SHELL" 2>&1)"
              printf '%s\n' "$st2" | grep -qi 'already dispatched.*same target' || { echo "  same-target FAIL: overlapping-range diff-wording task must suppress (got: $st2)"; fails=$((fails+1)); }
              [ -s "$st_tell" ] && { echo "  same-target FAIL: mesh-tell called despite same-target overlap suppression"; fails=$((fails+1)); }
              : > "$st_tell"
              # (c) SAME file but NON-overlapping range (:400-410 vs recorded :176-182) → distinct bug, MUST dispatch
              st3="$(MESH_MC_CHATLOG="$st_log" DISPATCH_ACKED="$st_ack" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/sttgt-selftest-c: an unrelated bug in mesh-sttgt-fixture:400-410 entirely" 2>&1)"
              [ -s "$st_tell" ] || { echo "  same-target FAIL: NON-overlapping range in same file must still dispatch (got: $st3)"; fails=$((fails+1)); }
              : > "$st_tell"
              # (d) a task citing NO mesh-tool line → cite_file empty → falls through to fp/xid, dispatches normally
              st4="$(MESH_MC_CHATLOG="$st_log" DISPATCH_ACKED="$st_ack" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/sttgt-selftest-d: a pure-prose coordination task with no source citation at all" 2>&1)"
              [ -s "$st_tell" ] || { echo "  same-target FAIL: a no-citation task must fall through and dispatch (got: $st4)"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$st_cap" "$st_tell" "$st_ack" "$st_log"
              # ── RESUME-RESURFACE (chat-review/claim-no-resume-resurface 2026-07-20) ────────────────
              # A [taking] claim had no resume-resurface: a shed-and-resumed claimer reads IDLE and
              # dispatch offered it NEWER unclaimed work while its own open claim starved to the 4h
              # STALE_TTL (live: genome claimed selfcare+swap-drain 14:50Z, got rate-limit-shed, and
              # did 4 other tasks over 2.5h while the #1-noise selfcare fix sat untouched). dispatch()
              # now, before delivering NEW work to a picked local window, scans the board for that
              # window's own OPEN [taking] (posted by <win>@$SESS, past MESH_RESURFACE_GRACE, inside
              # MESH_RESURFACE_TTL, no LATER body-anchored [done]/[yield] carrying its claim-id) and
              # re-surfaces it (finish-or-yield prompt to the pane + one [resurface] board line),
              # HOLDING the new task (rc=2, no ACKED record → stays re-dispatchable). Intra-cooldown
              # the hold lifts (escape valve: a mind visibly not resuming its claim must not starve
              # fresh work). Falsifiable: revert the dispatch() block → (a) delivers the NEW task
              # despite the open claim.
              rr_td="$(mktemp -d)"; rr_log="$rr_td/chat.log"; rr_tell="$rr_td/tell"; rr_cap="$rr_td/cap"
              mesh-chat(){ printf '%s\n' "$*" >>"$rr_cap"; }
              mesh-tell(){ printf '%s\n' "$*" >>"$rr_tell"; return 0; }
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              rr_now=$(date +%s)
              rr_open="$(date -u -d "@$((rr_now - 2400))" +%FT%TZ)"    # 40min ago: past grace, inside TTL
              rr_young="$(date -u -d "@$((rr_now - 60))" +%FT%TZ)"     # 1min ago: inside grace
              rr_stale="$(date -u -d "@$((rr_now - 20000))" +%FT%TZ)"  # 5.5h ago: past the 4h TTL
              rr_pre="$(date -u -d "@$((rr_now - 9000))" +%FT%TZ)"     # 2.5h ago: BEFORE the taking (mint-ordering)
              rr_post="$(date -u -d "@$((rr_now - 600))" +%FT%TZ)"     # 10min ago: AFTER the taking
              # (a) open claim (40min, no [done]) → RESUME framing sent to the pane, NEW task HELD rc=2,
              #     one [resurface] board line. This is the leg that reproduces the live starvation when reverted.
              echo "$rr_open  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture" > "$rr_log"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"; rr_rc=$?
              grep -q 'RESUME' "$rr_tell" 2>/dev/null && grep -q 'rr-selftest-open-claim' "$rr_tell" 2>/dev/null \
                || { echo "  resurface FAIL: (a) open [taking] must send a RESUME framing carrying the claim id (tell: $(cat "$rr_tell" 2>/dev/null))"; fails=$((fails+1)); }
              grep -q 'rr-selftest-newwork' "$rr_tell" 2>/dev/null && { echo "  resurface FAIL: (a) the NEW task was delivered despite the open claim (the live starvation shape)"; fails=$((fails+1)); }
              [ "$rr_rc" = 2 ] || { echo "  resurface FAIL: (a) want rc=2 (task stays re-dispatchable), got rc=$rr_rc (out: $rr_out)"; fails=$((fails+1)); }
              grep -q '^\[resurface\]' "$rr_cap" 2>/dev/null || { echo "  resurface FAIL: (a) no [resurface] board line posted (cap: $(cat "$rr_cap" 2>/dev/null))"; fails=$((fails+1)); }
              : > "$rr_tell"; : > "$rr_cap"; rm -f "$rr_td"/.resurfaced-*
              # (b) claim CLOSED by a LATER [done] → normal dispatch (new task delivered)
              { echo "$rr_open  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture"
                echo "$rr_post  genome@$SESS  ::  [done] rr-selftest-open-claim: fixed abc1234"; } > "$rr_log"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"
              grep -q 'rr-selftest-newwork' "$rr_tell" 2>/dev/null || { echo "  resurface FAIL: (b) a [done]-closed claim must not hold new work (got: $rr_out)"; fails=$((fails+1)); }
              : > "$rr_tell"; : > "$rr_cap"; rm -f "$rr_td"/.resurfaced-*
              # (c) MINT-ORDERING: a [done] posted BEFORE the [taking] cannot close it (20ac380 doctrine) → still resurfaces
              { echo "$rr_pre  genome@$SESS  ::  [done] rr-selftest-open-claim: an earlier lifecycle entirely"
                echo "$rr_open  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture"; } > "$rr_log"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"
              grep -q 'RESUME' "$rr_tell" 2>/dev/null || { echo "  resurface FAIL: (c) a PRE-taking [done] must not close the claim (mint-ordering) — no resurface sent (got: $rr_out)"; fails=$((fails+1)); }
              : > "$rr_tell"; : > "$rr_cap"; rm -f "$rr_td"/.resurfaced-*
              # (d) YOUNG claim (inside grace) → silent HOLD: no tell at all, rc=2 (likely mid-turn-gap, don't disturb)
              echo "$rr_young  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture" > "$rr_log"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"; rr_rc=$?
              [ -s "$rr_tell" ] && { echo "  resurface FAIL: (d) a claim inside MESH_RESURFACE_GRACE must hold SILENTLY (no tell; got: $(cat "$rr_tell"))"; fails=$((fails+1)); }
              [ "$rr_rc" = 2 ] || { echo "  resurface FAIL: (d) young-claim hold wants rc=2, got rc=$rr_rc (out: $rr_out)"; fails=$((fails+1)); }
              : > "$rr_tell"; : > "$rr_cap"; rm -f "$rr_td"/.resurfaced-*
              # (e) COOLDOWN escape valve: already resurfaced recently (fresh stamp) → new work flows normally
              echo "$rr_open  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture" > "$rr_log"
              echo "$rr_now" > "$rr_td/.resurfaced-genome-rr-selftest-open-claim"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"
              grep -q 'rr-selftest-newwork' "$rr_tell" 2>/dev/null || { echo "  resurface FAIL: (e) intra-cooldown the hold must lift (escape valve) and dispatch new work (got: $rr_out)"; fails=$((fails+1)); }
              grep -q 'RESUME' "$rr_tell" 2>/dev/null && { echo "  resurface FAIL: (e) intra-cooldown must not re-send the RESUME framing"; fails=$((fails+1)); }
              : > "$rr_tell"; : > "$rr_cap"; rm -f "$rr_td"/.resurfaced-*
              # (f) STALE claim (past MESH_RESURFACE_TTL) → evaporation lane owns it; new work flows normally
              echo "$rr_stale  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture" > "$rr_log"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"
              grep -q 'rr-selftest-newwork' "$rr_tell" 2>/dev/null || { echo "  resurface FAIL: (f) a past-TTL claim must not hold new work (got: $rr_out)"; fails=$((fails+1)); }
              : > "$rr_tell"; : > "$rr_cap"; rm -f "$rr_td"/.resurfaced-*
              # (g) claim released by a LATER [yield] → normal dispatch
              { echo "$rr_open  genome@$SESS  ::  [taking] genome: rr-selftest-open-claim (task 14:42Z) — fixing the fixture"
                echo "$rr_post  genome@$SESS  ::  [yield] rr-selftest-open-claim — can't finish, releasing"; } > "$rr_log"
              rr_out="$(MESH_MC_CHATLOG="$rr_log" MESH_RESURFACE_STATE_DIR="$rr_td" DISPATCH_ACKED="$(mktemp -u)" MESH_OWNER_HOLD_STATE="$(mktemp -u)" dispatch "chat-review/rr-selftest-newwork: fresh unrelated task" 2>&1)"
              grep -q 'rr-selftest-newwork' "$rr_tell" 2>/dev/null || { echo "  resurface FAIL: (g) a [yield]-released claim must not hold new work (got: $rr_out)"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -rf "$rr_td"
              # ── orphan-owner-finding detector (chat-review/orphan-owner-finding-detector-restale) ──
              # scan_orphans() is a pure function (log path in, nudge lines out) — never touches the
              # real board or calls mesh-chat, so these fixtures are fully hermetic.
              td_orph="$(mktemp -d)"; orph_log="$td_orph/chat.log"; orph_state="$td_orph/.orphan-nudged"
              now_o=$(date +%s)
              old_ts=$(date -u -d "@$((now_o-2100))" +%FT%TZ 2>/dev/null)   # 35min ago -> orphan-eligible
              fresh_ts=$(date -u -d "@$((now_o-300))" +%FT%TZ 2>/dev/null)  # 5min ago -> too young
              task_ts=$(date -u -d "@$((now_o-2000))" +%FT%TZ 2>/dev/null)  # 33min ago, within 30min of old_ts
              decline_ts=$(date -u -d "@$((now_o-1000))" +%FT%TZ 2>/dev/null)  # 16.7min ago: inside old_ts's ±30min window, but itself too young (<30min) to be its own orphan candidate
              # (a) orphaned: [fyi] owner tag, age>=30min, no matching [task] -> exactly one routable nudge
              printf '%s  chat@node  ::  [fyi] mesh-x is broken (owner: mesh-x/genome)\n' "$old_ts" > "$orph_log"
              o1="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ "$(printf '%s\n' "$o1" | grep -c '^\[task\] route-orphan/')" = 1 ] \
                || { echo "  orphan-scan FAIL: want exactly 1 nudge, got: $o1"; fails=$((fails+1)); }
              printf '%s' "$o1" | grep -q 'owner: mesh-x/genome' \
                || { echo "  orphan-scan FAIL: nudge missing owner tag: $o1"; fails=$((fails+1)); }
              # state-dedup: re-scanning the SAME still-orphaned log must not re-nudge
              o1b="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ -z "$o1b" ] || { echo "  orphan-scan FAIL: state-dedup didn't hold, re-nudged: $o1b"; fails=$((fails+1)); }
              # (a2) chat-review/orphan-oneliner-is-the-lede-not-the-owner-tag (2026-07-16): when the
              # owner: tag sits PAST char 140 of the body (median ~1327 on the live board), the minted
              # oneliner must carry the tag's own sentence — the ACTIONABLE ask — not a head-140 LEDE.
              # The finding below buries its ask ("REWINDOWTHEASK ...") behind a >140-char preamble
              # ("LEADINGPREAMBLE ..."); the printf trailer always appends the routed tag, so asserting
              # the tag alone would be VACUOUS — instead assert the oneliner carries the ask token and
              # NOT the lede token. Head-140 (the bug) mints the lede: this goes RED on it.
              rm -f "$orph_state"
              a2_lede="LEADINGPREAMBLE the review lane instrument defines substantive as a residual so it cannot see the board's biggest noise source and this whole preamble runs comfortably past one hundred and forty characters before naming any ask at all"
              a2_ask="REWINDOWTHEASK window the oneliner around the rightmost owner match (owner: mesh-mind-control/genome)"
              printf '%s  chat@node  ::  [chat-review] %s. %s\n' "$old_ts" "$a2_lede" "$a2_ask" > "$orph_log"
              oA2="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              case "$oA2" in *REWINDOWTHEASK*) : ;; *) echo "  orphan-scan FAIL: minted oneliner dropped the owner clause — the ask token is missing (head-140 regression): $oA2"; fails=$((fails+1)) ;; esac
              case "$oA2" in *LEADINGPREAMBLE*) echo "  orphan-scan FAIL: minted oneliner is the LEDE, not the tag's ask sentence: $oA2"; fails=$((fails+1)) ;; esac
              # and it still routes by the rightmost tag, exactly as before
              printf '%s' "$oA2" | grep -q '^\[task\] route-orphan/mesh-mind-control-' \
                || { echo "  orphan-scan FAIL: (a2) must still mint+route by the rightmost owner tag: $oA2"; fails=$((fails+1)); }
              # (a3) chat-review/route-orphan-window-empties-to-bare-tag (2026-07-16): the REAL board
              # shape a2 missed — a2 writes "...owner match (owner: X)" (an ask word survives right
              # before the tag), but every live finding trails its tag as "<ask-sentence>. owner: X",
              # so the ". " NEAREST the tag is the ask/tag separator. The old snap-to-nearest-boundary
              # landed start ON "owner:" -> 10/10 of the 08:12 mints were a bare "…owner: <tag>". This
              # fixture reproduces that: preamble(>140) . ASKWORD-sentence . owner: mesh-act/discover.
              # It goes RED on the pre-fix code (oneliner == "owner: mesh-act/discover", no ASKWORD).
              rm -f "$orph_state"
              a3_lede="LEADINGPREAMBLE the mesh act organ has never emitted a single frame on this node and this whole preamble runs comfortably past one hundred and forty characters before the finding ever names its actual ask which follows next"
              a3_ask="ASKWORD its first-ever frame should be emitted by whoever owns it with him watching"
              printf '%s  chat@node  ::  [fyi] %s. %s. owner: mesh-act/discover\n' "$old_ts" "$a3_lede" "$a3_ask" > "$orph_log"
              oA3="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              case "$oA3" in *ASKWORD*) : ;; *) echo "  orphan-scan FAIL: (a3) window emptied to the bare tag — the ask-sentence was dropped ('<ask>. owner: X' regression): $oA3"; fails=$((fails+1)) ;; esac
              case "$oA3" in *LEADINGPREAMBLE*) echo "  orphan-scan FAIL: (a3) minted the LEDE, not the tag's ask sentence: $oA3"; fails=$((fails+1)) ;; esac
              printf '%s' "$oA3" | grep -qE '\(owner: mesh-act/discover\)$' \
                || { echo "  orphan-scan FAIL: (a3) must still route by the trailing owner tag: $oA3"; fails=$((fails+1)); }
              # (a4) route-orphan-window-empties-to-bare-tag, LEADING-tag shape (2026-07-16): a3
              # covers only "<ask>. owner: X" — but a [design] that OPENS with its tag
              # ("owner: X — <ask>", genome's own house style) has NO ask before the tag anywhere,
              # so cs=0, the cs>0 backward rescue can never fire, and no backward window could
              # recover an ask that sits AFTER the tag (live: route-orphan/mesh-model-autoselect-324058
              # minted with zero ask, 4h after the trailing-tag fix deployed). The window must extend
              # FORWARD past tag_end. RED pre-fix: oneliner is the bare tag, no FORWARDASK.
              rm -f "$orph_state"
              a4_ask="FORWARDASK the actuator that closes the model loop must bench wake and stt then auto-switch arithmetic pins under dominance plus margin"
              printf '%s  chat@node  ::  [design] owner: mesh-fwd/genome — %s\n' "$old_ts" "$a4_ask" > "$orph_log"
              oA4="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              case "$oA4" in *FORWARDASK*) : ;; *) echo "  orphan-scan FAIL: (a4) leading-tag finding minted the bare tag — the ask AFTER the tag was dropped ('owner: X — <ask>' shape): $oA4"; fails=$((fails+1)) ;; esac
              printf '%s' "$oA4" | grep -qE '\(owner: mesh-fwd/genome\)$' \
                || { echo "  orphan-scan FAIL: (a4) must still route by the leading owner tag: $oA4"; fails=$((fails+1)); }
              # (b) resolved: same orphan PLUS a [task] naming the same owner within 30min -> no nudge
              rm -f "$orph_state"
              printf '%s  chat@node  ::  [fyi] mesh-x is broken (owner: mesh-x/genome)\n' "$old_ts" > "$orph_log"
              printf '%s  genome@node  ::  [task] chat-review/mesh-x-fix: fix it (owner: mesh-x/genome)\n' "$task_ts" >> "$orph_log"
              o2="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
