              # this host silent and mask the dedup path entirely (a mutant would pass for the wrong
              # reason — a-mutant-can-go-red-for-the-wrong-reason).
              z_raw="$old_ts  chat@node  ::  [fyi] mesh-z is broken (owner: mesh-z/health)"
              z_id6="$(printf '%s' "$z_raw" | cksum | tr ' ' '-' | tr -dc '0-9' | cut -c1-6)"
              printf '%s\n' "$z_raw" > "$orph_log"
              printf '%s  other-node@genome  ::  [task] route-orphan/mesh-z-%s: mesh-z is broken (owner: mesh-z/health)\n' "$recent_task_ts" "$z_id6" >> "$orph_log"
              o7="$(MESH_ORPHAN_MINTER=node MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ -z "$o7" ] || { echo "  orphan-scan FAIL: cross-node dedup — board already carries a route-orphan for this finding, must not re-mint: $o7"; fails=$((fails+1)); }
              # (g2) chat-review/route-orphan-dedup-keys-on-mutable-oneliner (2026-07-16): the SAME
              # finding, already minted by another host, but that prior task's body carries a
              # DIFFERENTLY-RENDERED oneliner (exactly what a rendering-code change like 11c442d/3152d30
              # produces). Cross-node dedup must STILL find it — because the key is the stable id6 slug,
              # not the oneliner substring. Goes RED on the pre-fix code (match_key = first-60-of-
              # oneliner): the prior task's scrambled body doesn't contain the current oneliner, so it
              # re-mints — the live 08:12/09:12 re-mint flood in one hermetic assertion. Minter PINNED
              # (see o7) so the dedup path is the only suppressor.
              rm -f "$orph_state"
              g2_raw="$old_ts  chat@node  ::  [fyi] mesh-p renders its oneliner differently across code versions (owner: mesh-p/genome)"
              g2_id6="$(printf '%s' "$g2_raw" | cksum | tr ' ' '-' | tr -dc '0-9' | cut -c1-6)"
              printf '%s\n' "$g2_raw" > "$orph_log"
              printf '%s  other-node@genome  ::  [task] route-orphan/mesh-p-%s: A COMPLETELY DIFFERENT RENDERING of the very same finding (owner: mesh-p/genome)\n' "$recent_task_ts" "$g2_id6" >> "$orph_log"
              o7b="$(MESH_ORPHAN_MINTER=node MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ -z "$o7b" ] || { echo "  orphan-scan FAIL: cross-node dedup keyed on the MUTABLE oneliner — a re-rendered prior mint re-minted (the 08:12/09:12 flood): $o7b"; fails=$((fails+1)); }
              # (h) no prior board route-orphan for this finding -> first-poster path unchanged, still mints
              rm -f "$orph_state"
              printf '%s  chat@node  ::  [fyi] mesh-w is broken (owner: mesh-w/senses)\n' "$old_ts" > "$orph_log"
              o8="$(MESH_MC_HOSTNAME=node MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ "$(printf '%s\n' "$o8" | grep -c '^\[task\] route-orphan/')" = 1 ] \
                || { echo "  orphan-scan FAIL: no prior board route-orphan should still mint (first-poster), got: $o8"; fails=$((fails+1)); }
              # (i) chat-review/scanorphans-race-single-minter: MESH_ORPHAN_MINTER designated + this
              # host IS the minter -> mints exactly as before.
              rm -f "$orph_state"
              printf '%s  chat@node  ::  [fyi] mesh-v is broken (owner: mesh-v/senses)\n' "$old_ts" > "$orph_log"
              o9="$(MESH_ORPHAN_MINTER=host-a MESH_MC_HOSTNAME=host-a MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ "$(printf '%s\n' "$o9" | grep -c '^\[task\] route-orphan/')" = 1 ] \
                || { echo "  orphan-scan FAIL: designated minter must still mint, got: $o9"; fails=$((fails+1)); }
              # (j) same finding, this host is NOT the designated minter -> must stay silent (no mint,
