              # owner-routing assertions (_owner_target) — the owner tag is honored ONLY when the named
              # owner window is idle+healthy; busy/unhealthy holds (rc3); tag-less falls through silently
              # (rc0,""); absent owner falls through with a warning rc (rc4,"") so dispatch can [fyi] it.
              otassert(){ local got rc; got="$(_owner_target "$1")"; rc=$?; [ "$got|$rc" = "$2" ] || { echo "  owner FAIL: [$3] → '$got|$rc' (want '$2')"; fails=$((fails+1)); }; }
