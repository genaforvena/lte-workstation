              [ "$_rd" != "$_hd" ] || { echo "  owner-honesty FAIL: redirect and honored print the SAME reason '$_rd' — the board cannot tell a substituted owner from an honored one"; fails=$((fails+1)); }
              [ "$_hd" = "owner-direct" ] || { echo "  owner-honesty FAIL: honored path reason is '$_hd' (want owner-direct)"; fails=$((fails+1)); }
