              [ "$(grep -c 'auth-dead' "$_adlog" 2>/dev/null)" = 1 ] || { echo "  auth-dead FAIL: alert not one-shot (posts=$(grep -c auth-dead "$_adlog" 2>/dev/null), want 1)"; fails=$((fails+1)); }
              grep -q "genome' is LOGGED OUT" "$_adlog" 2>/dev/null || { echo "  auth-dead FAIL: alert missing window name / logged-out text"; fails=$((fails+1)); }
              rm -f "$_adlog" "$_adf"
              PK_STATE=$'genome=IDLE'; PK_HEALTH=$'genome=UNHEALTHY'
              otassert "land the fix (owner: genome)"   "|3"                      "idle-but-unhealthy owner → HOLD rc3"
              PK_STATE=$'genome=IDLE'; PK_HEALTH=""
