              sr_cap="$(mktemp)"; sr_state="$(mktemp -u)"
              mesh-chat(){ printf '%s\n' "$*" >>"$sr_cap"; }
              mesh-tell(){ return 0; }
              sr_task="chat-review/self-ref-e2e: strips before the literal 'TASK: ' marker prior to the cut (owner: operator)"
              sr_framed="Board task assigned to you. If already done: post '[done] stale: $sr_task — already resolved' and STOP. TASK: $sr_task"
              MESH_DISPATCH_RAW_TASK="$sr_task" MESH_OWNER_HOLD_STATE="$sr_state" DISPATCH_ACKED="$(mktemp -u)" dispatch "$sr_framed" >/dev/null 2>&1
              grep -qF "chat-review/self-ref-e2e" "$sr_cap" || { echo "  human-owned FAIL: self-referential task's slug lost even through the full dispatch() call"; fails=$((fails+1)); }
              grep -qF "Board task assigned to you" "$sr_cap" && { echo "  human-owned FAIL: self-referential task leaked the frame preamble through dispatch()"; fails=$((fails+1)); }
              unset -f mesh-chat mesh-tell; rm -f "$sr_cap" "$sr_state"
              # OWNER-ABSENT wrapper-strip (chat-review/mindcontrol-posts-wrapper-not-task): the rc=4
