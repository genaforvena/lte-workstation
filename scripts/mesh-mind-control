              rm -rf "$td_orph"
              # FLAG-INJECTION GUARD (chat-review/dispatch-flag-injection-no-dryrun): a bare
              # '--flag'-shaped task (CLI typo, e.g. an imagined '--dry-run' that doesn't exist) must
              # be rejected BEFORE any picker/mesh-tell call — never silently dispatched as real task
              # text into a live pane. HERMETIC: stub mesh-tell/mesh-chat so a guard regression can't
              # inject into a real pane.
              fg_tell="$(mktemp)"; fg_cap="$(mktemp)"
              mesh-tell(){ printf '%s\t%s\n' "$1" "$2" >>"$fg_tell"; return 0; }
              mesh-chat(){ printf '%s\n' "$*" >>"$fg_cap"; }
              fg_err="$(DISPATCH_ACKED="$(mktemp -u)" dispatch "--dry-run" 2>&1 1>/dev/null)"; fg_rc=$?
              [ "$fg_rc" != 0 ] || { echo "  flag-guard FAIL: bare '--dry-run' task must return non-zero, got rc=0"; fails=$((fails+1)); }
              [ -n "$fg_err" ] || { echo "  flag-guard FAIL: bare '--dry-run' task must print a usage/error (stderr was empty)"; fails=$((fails+1)); }
              [ -s "$fg_tell" ] && { echo "  flag-guard FAIL: mesh-tell was called for a bare flag-shaped task (injection not blocked): $(cat "$fg_tell")"; fails=$((fails+1)); }
              : > "$fg_tell"; : > "$fg_cap"
              # multi-flag variant (e.g. the literal CLI typo 'mesh-mind-control --dispatch --dry-run'
              # after the outer --dispatch case-arm's own shift, this is what dispatch() actually sees)
              fg_err2="$(DISPATCH_ACKED="$(mktemp -u)" dispatch "--dispatch --dry-run" 2>&1 1>/dev/null)"; fg_rc2=$?
              [ "$fg_rc2" != 0 ] || { echo "  flag-guard FAIL: bare multi-flag task must return non-zero, got rc=0"; fails=$((fails+1)); }
              [ -s "$fg_tell" ] && { echo "  flag-guard FAIL: mesh-tell was called for a bare multi-flag task: $(cat "$fg_tell")"; fails=$((fails+1)); }
              : > "$fg_tell"; : > "$fg_cap"
              # regression: a normal free-text task that merely MENTIONS a hyphenated flag-like word
              # mid-sentence must still dispatch normally — only a task that IS JUST bare flags is caught.
              PK_STATE=$'genome=IDLE'; PK_ENG=$'genome=claude'; PK_HEALTH=""
              fg_out3="$(DISPATCH_ACKED="$(mktemp -u)" dispatch "fix --edge hang in mesh-ss-test" 2>&1)"
              printf '%s\n' "$fg_out3" | grep -qF 'genome (claude)' || { echo "  flag-guard FAIL: a real task mentioning a hyphenated word mid-sentence must still dispatch normally (got: $fg_out3)"; fails=$((fails+1)); }
              [ -s "$fg_tell" ] || { echo "  flag-guard FAIL: regression task should have called mesh-tell (got none)"; fails=$((fails+1)); }
              unset -f mesh-tell mesh-chat; rm -f "$fg_tell" "$fg_cap"
              # chat-review/minds-manifest-hardcodes-6-of-14-windows (2026-07-16) — THE ROW-TABLE GATE.
              # Drives REAL tmux in a THROWAWAY session (never $(hostname) — the shared session is
              # append-only doctrine, and a scratch session I create is mine to remove). Stubbing
              # `tmux list-windows` here would assert nothing: reading LIVE tmux instead of a literal IS
              # the fix, so the enumeration is the one thing that must not be faked (the drives-only-stubs
              # trap, 974d864). state_of/engine_of ARE stubbed — they are unrelated collaborators here.
              # SCOPE: rows only. Deliberately NO assertion on "Idle & ready to take work" — that line is
              # gated by $WORKERS as well as the row set, so a scratch window can never reach it and an
              # assertion there would pass on the row fix while the line it names never moves.
              if command -v tmux >/dev/null 2>&1; then
                _mw_sess="mc-rowgate-$$"
                tmux kill-session -t "$_mw_sess" 2>/dev/null
                if tmux new-session -d -s "$_mw_sess" -n zzrowgate 2>/dev/null; then
                  tmux split-window -t "$_mw_sess:zzrowgate" 2>/dev/null   # 2 panes = a mind channel
                  tmux new-window  -d -t "$_mw_sess" -n bash 2>/dev/null   # 1 pane  = the bare shell
                  _sess_real="$SESS"; SESS="$_mw_sess"
                  _mw="$(mind_windows)"
                  printf '%s\n' "$_mw" | grep -qx zzrowgate || { echo "  row-table FAIL: a live 2-pane window ('zzrowgate') is missing from mind_windows (got: $(printf '%s' "$_mw" | tr '\n' ' ')) — rows are not reading tmux"; fails=$((fails+1)); }
                  printf '%s\n' "$_mw" | grep -qx bash && { echo "  row-table FAIL: the 1-pane 'bash' shell must NOT be a mind row (got: $(printf '%s' "$_mw" | tr '\n' ' '))"; fails=$((fails+1)); }
                  # and the row must actually REACH the rendered table (chat's gate, scoped to rows).
                  state_of(){ printf 'IDLE\tstub\n'; }; engine_of(){ echo unknown; }
                  icon(){ printf '○'; }
                  _rows="$(render 2>/dev/null | sed -n '/WINDOW/,/────/p')"
                  printf '%s' "$_rows" | grep -q '^  zzrowgate' || { echo "  row-table FAIL: render's row table omits the live window (a manifest-driven render cannot list it) — got rows: $(printf '%s' "$_rows" | tr '\n' '|')"; fails=$((fails+1)); }
                  # a window the manifest never knew must render a visible '?', never an empty engine cell.
                  printf '%s' "$_rows" | grep -qE '^  zzrowgate +\?' || { echo "  row-table FAIL: unknown-engine window must show '?' (UNKNOWN-not-blank), got: $(printf '%s' "$_rows" | grep zzrowgate)"; fails=$((fails+1)); }
                  SESS="$_sess_real"; unset -f icon
                  tmux kill-session -t "$_mw_sess" 2>/dev/null
                else
                  echo "  row-table SKIP: could not create a scratch tmux session (no server?) — gate not run"
                fi
                unset _mw_sess _mw _rows _sess_real
              else
                echo "  row-table SKIP: tmux absent — gate not run"
              fi
              # AUTHORITATIVE-CARD/ROLE GATE (chat-review/compute-node-dispatchers-bypass-the-governor):
              # work-creation arms (--dispatch/--scan-orphans) are mind-node-only — compute-role phaedra's
              # autowired crons paid-dispatched into a checkout-less local genome while mesh-home's governor
              # HELD 19 tasks (the pace state is per-node, the paid OAuth window is shared). Fixtures drive
              # the REAL dispatch_gate + the REAL CLI arms under a sandbox HOME; asserts key on the REASON
              # STRING, never bare rc (command-not-found is also nonzero → rc-only stays green gate-less).
              _dg_td=$(mktemp -d)
              printf 'host: n\nminds: claude opencode\n' >"$_dg_td/card-minds"
              printf 'host: n\nminds:\n' >"$_dg_td/card-nominds"
              _dg_out=$(dispatch_gate "$_dg_td/card-minds" "" node 2>/dev/null) && [ -z "$_dg_out" ] || { echo "  dispatch-gate FAIL: blocked a minds-declaring card (must dispatch unchanged, got '$_dg_out')"; fails=$((fails+1)); }
              _dg_out=$(dispatch_gate "$_dg_td/card-nominds" "" node 2>/dev/null); case "$_dg_out" in *"no mind engine"*) :;; *) echo "  dispatch-gate FAIL: passed a card with no mind engine (got '$_dg_out')"; fails=$((fails+1));; esac
              _dg_out=$(dispatch_gate "$_dg_td/absent-card" "" node 2>/dev/null); case "$_dg_out" in *"no card"*) :;; *) echo "  dispatch-gate FAIL: passed with no card at all (got '$_dg_out')"; fails=$((fails+1));; esac
              _dg_out=$(dispatch_gate "$_dg_td/card-minds" "node:compute other:mind" node 2>/dev/null); case "$_dg_out" in *"role=compute"*) :;; *) echo "  dispatch-gate FAIL: passed a compute-role node (got '$_dg_out')"; fails=$((fails+1));; esac
              _dg_out=$(dispatch_gate "$_dg_td/card-minds" "other:compute" node 2>/dev/null) || { echo "  dispatch-gate FAIL: misread ANOTHER node's compute role as ours"; fails=$((fails+1)); }
              _dg_out=$(dispatch_gate "$_dg_td/card-minds" "node:mind" node 2>/dev/null) || { echo "  dispatch-gate FAIL: blocked an explicit mind role"; fails=$((fails+1)); }
              # artifact: the REAL CLI arms under sandbox HOMEs (env -u MESH_ROLES — a test child
              # inherits exported node-local tuning; sandbox has no restore.env/nodes so the card is
              # the only live input). --scan-orphans on an empty sandbox board is side-effect-free;
              # --dispatch is driven with a FLAG-SHAPED task so even gate-less code stops at its own
              # flag-injection guard (usage, rc1) instead of routing anything — contained both ways.
              mkdir -p "$_dg_td/h1" "$_dg_td/h2"
              cp "$_dg_td/card-nominds" "$_dg_td/h1/.mesh-card"; cp "$_dg_td/card-minds" "$_dg_td/h2/.mesh-card"
              _dg_o=$(env -u MESH_ROLES HOME="$_dg_td/h1" "$0" --scan-orphans 2>/dev/null)
              case "$_dg_o" in *"dispatch-gate skip"*) :;; *) echo "  dispatch-gate FAIL: --scan-orphans did not skip on a no-minds card (got '$_dg_o')"; fails=$((fails+1));; esac
              _dg_o=$(env -u MESH_ROLES HOME="$_dg_td/h2" "$0" --scan-orphans 2>/dev/null)
              case "$_dg_o" in *"dispatch-gate skip"*) echo "  dispatch-gate FAIL: --scan-orphans skipped on a minds-declaring card (got '$_dg_o')"; fails=$((fails+1));; esac
              _dg_o=$(env -u MESH_ROLES HOME="$_dg_td/h1" "$0" --dispatch --dg-gate-selftest 2>&1)
              case "$_dg_o" in *"dispatch-gate skip"*) :;; *) echo "  dispatch-gate FAIL: --dispatch did not skip on a no-minds card (got '$_dg_o')"; fails=$((fails+1));; esac
              _dg_o=$(env -u MESH_ROLES HOME="$_dg_td/h2" "$0" --dispatch --dg-gate-selftest 2>&1)
              case "$_dg_o" in *"dispatch-gate skip"*) echo "  dispatch-gate FAIL: --dispatch skipped on a minds-declaring card (got '$_dg_o')"; fails=$((fails+1));; *usage*) :;; *) echo "  dispatch-gate FAIL: minds-card --dispatch control did not reach the flag guard (got '$_dg_o')"; fails=$((fails+1));; esac
              rm -rf "$_dg_td"
              [ "$fails" = 0 ] && echo "smoke-test: ok (9 classifier + 8 picker + 11 owner-routing + 3 owner-route-wrapper + 3 dispatch-echo + 1 human-owned-announce + 3 owner-hold-announce + 5 darwinian-fitness + 4 phaedra-thermal-prefer + 6 dispatch-remote-phaedra + 9 dispatch-ack-gate + 3 noack-board-dedup + 3 ack-load-window + 3 cross-node-dedup + 3 gossip-lag-presync + 5 same-target-dedup + 10 resume-resurface + 18 orphan-owner-finding-detector + 4 dispatch-flag-injection-guard + 3 owner-honesty + 4 row-table + 10 dispatch-gate assertions pass)" || { echo "smoke-test: FAIL ($fails assertion miss)"; exit 1; }
              exit 0;;
  --classify) shift; v="$(classify_task "$*")"; echo "${v%% *}: ${v#* }"; exit 0;;
  --fitness)  shift; fitness_leaderboard "${1:-}"; exit 0;;   # Darwinian agent-selection leaderboard (read-only)
  --allocate) shift; allocate "$*";;
  --watch)    # self-reexec on code update so a long-lived pane never renders stale layout (see mesh-dash)
              _S="$(command -v "$0" 2>/dev/null || echo "$0")"; _SM="$(stat -c %Y "$_S" 2>/dev/null || echo 0)"
              while true; do
                [ "$(stat -c %Y "$_S" 2>/dev/null || echo 0)" != "$_SM" ] && exec "$_S" --watch
                clear; render; sleep "${MESH_MIND_REFRESH:-15}"
              done;;
  --dispatch) # dispatch_gate first (see its WHY above): a non-mind node must not create paid work,
              # whatever the task text — the gate outranks even argument validation.
              _dg_why="$(dispatch_gate_why)"
              [ -z "$_dg_why" ] || { echo "mesh-mind-control --dispatch: dispatch-gate skip — $_dg_why"; exit 0; }
              shift; dispatch "$*";;
  --owner-route) # print the idle+healthy owner window for an owner-tagged task, else nothing (rc0).
              # mesh-dispatch uses this to route an owner-tagged [task] straight to its OWN idle owner
              # window (pub/room/senses/health/discover) even when the generic WORKER pool is busy,
              # WITHOUT re-implementing _owner_target's slash/code_wins owner resolution here (single
              # source of truth — chat-review/dispatch-idle-gate-starves-owner-direct). Prints a window
              # ONLY when _owner_target says owner-direct (idle+healthy → rc0, non-empty); busy/unhealthy
              # (rc3), absent owner (rc4), human-owned (rc5) and tag-less (rc0,"") all print NOTHING — so the
              # caller does not wake a mind that mesh-mind-control would only HOLD (no pace-noop on a to-be-HELD task).
              shift; ot="$(_owner_target "$*")"; otrc=$?
              [ "$otrc" = 0 ] && [ -n "$ot" ] && printf '%s\n' "${ot%%	*}"
              exit 0;;
  --owner-hold-announce) # unconditional per-pass hook (see owner_hold_announce() above for the WHY):
              # mesh-dispatch calls this for EVERY owner-tagged OPEN task, every pass, before pace/idle
              # gating — rc=1 (silent) unless the task is human-owned AND not yet announced.
              shift; owner_hold_announce "$*"; exit $?;;
  --scan-orphans) # chat-review/orphan-owner-finding-detector-restale — post each new orphan nudge to
              # the board (scan_orphans() above is the pure detector; this is the only side-effecting caller).
              # dispatch_gate first (see its WHY above): every nudge posted here becomes dispatched paid
              # work — a non-mind node must not mint it.
              _dg_why="$(dispatch_gate_why)"
              [ -z "$_dg_why" ] || { echo "mesh-mind-control --scan-orphans: dispatch-gate skip — $_dg_why"; exit 0; }
              out="$(scan_orphans)"
              [ -n "$out" ] || { echo "mesh-mind-control --scan-orphans: no new orphans"; exit 0; }
              printf '%s\n' "$out" | while IFS= read -r nudge; do
                [ -n "$nudge" ] || continue
                MESH_WHO="mind-control@$SESS" mesh-chat "$nudge" >/dev/null 2>&1 || true
                echo "$nudge"
              done
              exit 0;;
  *)          render;;
esac
