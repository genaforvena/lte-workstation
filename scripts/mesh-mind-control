              [ -z "$o10" ] \
                || { echo "  orphan-scan FAIL: non-minter host must not mint, got: $o10"; fails=$((fails+1)); }
              [ -s "$orph_state" ] \
                && { echo "  orphan-scan FAIL: non-minter host must not record state either (would block a later adopt)"; fails=$((fails+1)); }
              # (k) no MESH_ORPHAN_MINTER designated, single live host -> zero-config election still
              # derives that host from the board (it's the only poster) and mints. Not a silent drop.
              rm -f "$orph_state"
              printf '%s  chat@host-b  ::  [fyi] mesh-t is broken (owner: mesh-t/senses)\n' "$old_ts" > "$orph_log"
              o11="$(MESH_MC_HOSTNAME=host-b MESH_MC_CHATLOG="$orph_log" MESH_MC_ORPHAN_STATE="$orph_state" scan_orphans)"
              [ "$(printf '%s\n' "$o11" | grep -c '^\[task\] route-orphan/')" = 1 ] \
                || { echo "  orphan-scan FAIL: unset minter, single live host must still self-elect+mint, got: $o11"; fails=$((fails+1)); }
              # (k2) chat-review/scanorphans-minter-unconfigured (2026-07-08, the actual reported bug):
              # MESH_ORPHAN_MINTER unset (true of every real node — it was dead code) + 3 hosts see the
              # SAME finding on the SAME shared board via their OWN (separate, node-local) state ->
              # the live-cited race was route-orphan/mesh-doctor minted by both {phaedra,IdeaPad} 1s
              # apart. Zero-config election must converge all 3 hosts onto exactly ONE minter (the
              # lexically-lowest live poster, host-a) without any of them coordinating directly.
              rm -f "$orph_state"
              td_orph3="$(mktemp -d)"; orph_log3="$td_orph3/chat.log"
              printf '%s  chat@host-c  ::  [fyi] mesh-3host is broken (owner: mesh-3host/senses)\n' "$old_ts" > "$orph_log3"
