              rm -f "$orph_state"
              recent_task_ts=$(date -u -d "@$((now_o-60))" +%FT%TZ 2>/dev/null)
              # the prior mint's slug carries the STABLE per-rawline id6 (route-orphan-dedup-keys-on-
