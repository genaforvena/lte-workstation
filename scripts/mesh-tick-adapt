#!/usr/bin/env bash
# mesh-tick-adapt — P-controller: skip tick when activity is low to save quota
# Usage: mesh-tick-adapt [TGT] [WIN] [ROLE]
# Wraps mesh-tick. Skips if activity rate is low and adaptive interval hasn't elapsed.
# Design: knowledge/control-theory-application.md (P-controller on tick cadence)
set -uo pipefail
PATH="$HOME/.local/bin:$PATH"

BASE=600        # 10 min base
K=0.15          # gain
MIN=180         # 3 min min
MAX=1800        # 30 min max
STATE="$HOME/.mesh/.tick-adapt-state"

_compute_interval() {
  local rate=$1
  local i
  i=$(awk -v base="$BASE" -v k="$K" -v r="$rate" 'BEGIN { v=base/(1+k*r); if(v<180)v=180; if(v>1800)v=1800; print int(v) }')
  printf '%s' "$i"
}

_activity_rate() {
  local commits chat_msgs rate=0
  commits=$(git -C "$HOME/lte-workstation" log --since='1 hour ago' --oneline 2>/dev/null | wc -l)
  : $((commits+0))
  chat_msgs=$(grep -cE "^$(date -u +%Y-%m-%d)T[0-9]{2}:" "$HOME/.mesh/chat.log" 2>/dev/null) || chat_msgs=0
  : $((chat_msgs+0))
  rate=$((commits * 3 + chat_msgs / 5))
  printf '%d' "$rate"
}

if [ "${1:-}" = "--test" ]; then
  _f=0
  # P-controller: v = base/(1 + k * r), clamped to [MIN, MAX]
  # base=600, k=0.15, MIN=180, MAX=1800
  v=$(_compute_interval 0);   [ "$v" = 600  ] || { echo "  FAIL: _compute_interval 0 = $v (want 600)"; _f=1; }
  v=$(_compute_interval 10);  [ "$v" = 240  ] || { echo "  FAIL: _compute_interval 10 = $v (want 240)"; _f=1; }
  v=$(_compute_interval 30);  [ "$v" = 180  ] || { echo "  FAIL: _compute_interval 30 = $v (want 180 — MIN clamp)"; _f=1; }
  v=$(_compute_interval -1);  [ "$v" = 705  ] || { echo "  FAIL: _compute_interval -1 = $v (want 705 — negative rate)"; _f=1; }
  v=$(_compute_interval 9999);[ "$v" = 180  ] || { echo "  FAIL: _compute_interval 9999 = $v (want 180 — MIN clamp at extreme)"; _f=1; }
  command -v mesh-tick >/dev/null 2>&1 || { echo "FAIL: no mesh-tick"; exit 1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (P-controller formula drifted — rate→interval mapping wrong)"; exit 1; }
  echo "smoke-test: ok (P-controller verified: base=600, k=0.15, MIN=180, MAX=1800)"; exit 0
fi

ACTIVITY=$(_activity_rate)
INTERVAL=$(_compute_interval "$ACTIVITY")

mkdir -p "$(dirname "$STATE")"
WIN="${2:-plan}"
window_state="$STATE-$WIN"
last_tick=0
[ -f "$window_state" ] && last_tick=$(cat "$window_state" 2>/dev/null) || true
: $((last_tick+0))
now=$(date +%s)
elapsed=$((now - last_tick))

echo "$(date -u +%Y-%m-%dT%H:%MZ) tick-adapt[$WIN]: activity=$ACTIVITY interval=${INTERVAL}s elapsed=${elapsed}s"

if [ "$elapsed" -lt "$INTERVAL" ]; then
  echo "$(date -u +%Y-%m-%dT%H:%MZ) tick-adapt[$WIN]: skip (${elapsed}s < ${INTERVAL}s)"
  exit 0
fi

echo "$now" > "$window_state"
exec mesh-tick "$@"
