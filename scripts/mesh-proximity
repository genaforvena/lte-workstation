#!/usr/bin/env bash
# mesh-proximity — BLE proximity distance estimate from RSSI
# Converts mesh-presence RSSI readings into approximate distance using the log-distance path loss model.
# The IdeaPad's BLE radio perceives RSSI; this tool translates it to millimetres.
#
# Usage:
#   mesh-proximity                  one-shot: nearest named device distance + zone (LIVE scan)
#   mesh-proximity --edge           only emit when zone changes; reads presence.log, NEVER scans
#   mesh-proximity --json           machine-readable JSON
#   mesh-proximity --test           smoke test (no scan, no log)
#   mesh-proximity --device "Name"  filter to specific device
#   mesh-proximity --from-log       force the reuse path (read ~/.mesh/presence.log)
#   mesh-proximity --scan           force a live BLE scan (the on-demand default)
#
# TWO SOURCES, and which one a mode takes is deliberate.
#   --edge is the CRON-facing mode, and it must never drive the radio. On this node the BLE
#   half is the btusb side of the same 0bda:b82c combo device that carries the SOLE uplink,
#   and it wedges; `mesh-presence` ALREADY scans on a */10 cadence, so a second cadence here
#   would be a second scan on wedged silicon for a reading that already exists on disk
#   ("a real hardware test leg is an attack"). So --edge REUSES mesh-presence's newest
#   snapshot line instead of producing a rival one. An operator's on-demand read still scans.
#
# THE LEASE — and the direction it must point.
#   A reused snapshot is only a measurement while it is fresh, so the reuse path refuses a
#   stale line (UNCERTAIN/exit 2) rather than reporting an hours-old zone as now. The lease
#   must EXCEED the producer's cadence, never fall under it: mesh-presence runs */10 (600s),
#   so a sub-600s lease is unsatisfiable by construction — it expires at the end of every
#   healthy cycle and renders a perfectly live feeder as a dead one (the mesh-bruno
#   LEASE_WIFI=600 trap, 2026-07-15). The default is not a new number either: mesh-sensorium
#   already defines "presence.log is fresh" as <900s (`mark "$M/presence.log" ... 900`), and
#   mesh-presence's own cadence header cites that same 900s as the threshold its */10 keeps
#   it under. One definition, two readers.
#
# RE-READING THE SAME SNAPSHOT IS NOT A SECOND SAMPLE.
#   --edge confirms a zone change over EDGE_WINDOW consecutive samples. Reading a cached
#   artifact faster than its producer rewrites it would let one snapshot satisfy the whole
#   debounce by itself — a fabricated confirmation. So the pending record carries the SOURCE
#   line's epoch and the count only advances when that epoch MOVES. The cadence below is
#   already presence-paced; the guard is what makes that a property of the code rather than
#   of a cron line someone may retune.
#
# Zones (IEEE 802.15.1 inspired):
#   HERE     = < 1500mm  (right next to you — same desk, in-hand)
#   NEAR     = 1500–4000mm  (same room, reachable)
#   FAR      = 4000–10000mm   (same building, other side of room)
#   OUT_OF_RANGE = >10000mm or not visible
#
# Honest contract:
#   - No device visible → OUT_OF_RANGE (absence is a real signal)
#   - RSSI too weak (< -90) → OUT_OF_RANGE (below noise floor)
#   - BLE scan failed → UNCERTAIN with exit 2
#   - presence rows PRESENT but none parseable → UNCERTAIN with exit 2 (format drift).
#     This leg exists because its absence cost us the sense: this tool split each row on
#     WHITESPACE as `name mac rssi` while mesh-presence has rendered `rssi|mac|name` since
#     2026-07-06 (26000b7). Every row failed the "is field 3 an integer" check and was
#     skipped, so a fully-working radio seeing 7 devices rendered as a confident
#     "OUT_OF_RANGE — no named BLE devices visible [devices=0]". Absence being a REAL
#     signal here is exactly what made the total parse failure invisible: the fault wore
#     the vocabulary of a legitimate reading. A parse that consumes nothing is never a
#     measurement — it must be loud, not a zero. (2026-08-17.)
#
# Exit codes:
#   0 = verdict assessed
#   2 = cannot assess (BLE scan failed entirely, its output no longer parses, or — on the
#       reuse path — presence has landed no fresh, non-degraded snapshot to reuse)
#
# reflex-cadence: 4-59/10 * * * *
# reflex-state: $HOME/.mesh/.proximity.state
# reflex-args: --edge
# Paced to mesh-presence's own */10 and offset +4min so each run reads a line that landed this
# cycle. This is the writer for ~/.mesh/.proximity.state, which mesh-operator-context reads for
# its prox axis; with no writer that axis was permanently unreachable and dragged the whole
# meta-fusion to UNCERTAIN (honestly — it renders [unreachable:prox] — but permanently).
# It costs NO radio time: see the two-sources note above.

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.proximity.state"
PENDING="$STATE_DIR/.proximity.pending"
PRESENCE_LOG="${MESH_PRESENCE_LOG:-$STATE_DIR/presence.log}"
# See the LEASE note in the header: 900s is mesh-sensorium's existing presence.log freshness
# threshold, and it EXCEEDS mesh-presence's 600s cadence. Do not lower it below 600.
PRESENCE_LEASE_S="${MESH_PROXIMITY_PRESENCE_LEASE_S:-900}"
MODE="oneshot"
SOURCE=""          # "" = pick from MODE below; else "log" | "scan"
SRC_EPOCH=""       # epoch of the reused snapshot line (empty on the scan path)
EDGE_WINDOW=2
TARGET_DEVICE=""

for arg in "$@"; do
  case "$arg" in
    --edge) MODE=edge ;;
    --json) MODE=json ;;
    --test) MODE=test ;;
    --from-log) SOURCE=log ;;
    --scan) SOURCE=scan ;;
    --device) shift; TARGET_DEVICE="${1:-}"; shift || true ;;
  esac
done

# Mode default, applied only where the operator did not say: --edge is the cron mode and must
# not touch the radio; every other mode is an operator asking for a reading NOW.
if [ -z "$SOURCE" ]; then
  case "$MODE" in
    edge) SOURCE=log ;;
    *)    SOURCE=scan ;;
  esac
fi

mkdir -p "$STATE_DIR"

# --- Calibration constants ---
TX_POWER=-59
PATH_LOSS_N=2.5

# --- Distance from RSSI (case-based, no bc dependency) ---
rssi_to_distance() {
  local rssi="$1"
  if [ "$rssi" -ge 0 ] || [ "$rssi" -le -100 ]; then
    distance="99000"; return
  fi
  case "$rssi" in
    -[0-4][0-9]|-50) distance="300" ;;
    -5[1-9]|-60)     distance="1000" ;;
    -6[1-9]|-70)     distance="2500" ;;
    -7[1-9]|-80)     distance="5000" ;;
    -8[1-9]|-90)     distance="10000" ;;
    *)               distance="15000" ;;
  esac
}

# --- Presence row parsing ---
# mesh-presence renders one device per line as  rssi|mac|name  (name is '?' when unnamed).
# Sets p_rssi/p_mac/p_name; returns 1 for anything that is not a device row.
parse_presence_row() {
  local line="$1" f1 f2 f3 rest
  case "$line" in *'|'*) : ;; *) return 1 ;; esac
  f1="${line%%|*}"; rest="${line#*|}"
  f2="${rest%%|*}"; f3="${rest#*|}"
  [[ "$f1" =~ ^-[0-9]+$ ]] || return 1
  [[ "$f2" =~ ^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$ ]] || return 1
  p_rssi="$f1"; p_mac="$f2"; p_name="$f3"
  return 0
}

# A line carrying a MAC is a device row in ANY plausible format — that is what makes it the
# drift detector: it counts rows the parser OUGHT to have consumed, independent of the
# field order the parser assumes.
row_looks_like_device() {
  [[ "$1" =~ [0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5} ]]
}

classify_zone() {
  local d="$1"
  if [ "$d" -lt 1500 ] 2>/dev/null; then
    zone="HERE"
  elif [ "$d" -lt 4000 ] 2>/dev/null; then
    zone="NEAR"
  elif [ "$d" -lt 10000 ] 2>/dev/null; then
    zone="FAR"
  else
    zone="OUT_OF_RANGE"
  fi
}

# --- Parse BLE output: find strongest named device, and set the verdict ---
# One function so the gate below drives THIS code, not a re-typed copy of it.
# Reads $ble_out + $ec; sets nearest_*, device_count, rows_seen, verdict, reason, ec.
assess() {
  nearest_name=""
  nearest_rssi=-999
  nearest_mac=""
  nearest_dist="99000"
  nearest_zone="OUT_OF_RANGE"
  device_count=0
  rows_seen=0

  if [ -n "$ble_out" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      row_looks_like_device "$line" || continue
      rows_seen=$((rows_seen + 1))

      p_rssi=""; p_mac=""; p_name=""
      parse_presence_row "$line" || continue
      device_count=$((device_count + 1))

      # '?' is a real body but not a NAMED device — counted, never the nearest.
      [ "$p_name" = "?" ] && continue

      if [ -n "$TARGET_DEVICE" ] && [ "$p_name" != "$TARGET_DEVICE" ]; then
        continue
      fi

      if [ "$p_rssi" -gt "$nearest_rssi" ] 2>/dev/null; then
        nearest_rssi="$p_rssi"
        nearest_name="$p_name"
        nearest_mac="$p_mac"
        rssi_to_distance "$p_rssi"
        nearest_dist="$distance"
        classify_zone "$distance"
        nearest_zone="$zone"
      fi
    done <<< "$ble_out"
  fi

  if [ "$ec" = "2" ]; then
    : # already set by the caller (scan failed / timed out)
  elif [ "$rows_seen" -gt 0 ] && [ "$device_count" -eq 0 ]; then
    verdict="UNCERTAIN"
    reason="presence rows unparseable ($rows_seen row(s) carried a MAC, 0 parsed) — output format drift"
    ec=2
  elif [ -z "$nearest_name" ]; then
    verdict="OUT_OF_RANGE"; reason="no named BLE devices visible"
  else
    verdict="$nearest_zone"; reason="$nearest_name at ${nearest_dist}mm (rssi=$nearest_rssi)"
  fi
}

# --- Reuse path: mesh-presence's newest snapshot instead of a rival scan ---
#
# A snapshot line is:
#   <iso-ts> <host> n=<N> devices=[<row> <row> ...] attribution=... unidentified=...
# where each row is the SAME `rssi|mac|name` mesh-presence prints. Two shapes of that line
# carry no rows at all and MUST NOT be read as an empty room:
#   n=0 SUSPECT known=K        — the adapter knew devices, none gave a fresh RSSI
#   n=0 SUSPECT-wedge ...      — discovery stuck on after our scan; suspected wedged radio
# mesh-presence grades both as "NOT an authoritative empty" and exits 3; neither carries a
# `devices=[` field, so their absence is the discriminator. A CONFIDENT empty does carry
# `devices=[]` — that one is a real absence and reads OUT_OF_RANGE, exit 0.

# The devices=[...] field is SPACE-joined and names contain spaces ("LE-Bose Revolve
# SoundLink"), so the only safe row boundary is the START of the next row: ` -<rssi>|<MAC>|`.
# Split there and nowhere else.
expand_devices_field() {
  printf '%s' "$1" | sed -E 's/ (-[0-9]+\|[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}\|)/\n\1/g'
}

# Sets ble_out + ec (+ verdict/reason and SRC_EPOCH). Never runs a scan.
read_presence_log() {
  local line ts_field epoch now age rest devs
  ble_out=""; ec=0; SRC_EPOCH=""

  if [ ! -s "$PRESENCE_LOG" ]; then
    verdict="UNCERTAIN"; ec=2
    reason="no presence snapshot at $PRESENCE_LOG — the presence cadence has never landed one"
    return
  fi
  # tr -d '\000': one NUL byte blinds plain grep for a whole log, and a crash-truncated append
  # can leave one. sed '/^$/d': a trailing blank line would make `tail -1` a death certificate.
  line="$(tail -40 "$PRESENCE_LOG" 2>/dev/null | tr -d '\000' | sed '/^[[:space:]]*$/d' | tail -1)"
  if [ -z "$line" ]; then
    verdict="UNCERTAIN"; ec=2
    reason="presence.log holds no non-blank line"
    return
  fi

  ts_field="${line%% *}"
  epoch="$(date -u -d "$ts_field" +%s 2>/dev/null || true)"
  case "$epoch" in
    ''|*[!0-9]*)
      verdict="UNCERTAIN"; ec=2
      reason="newest presence line carries no parseable timestamp ('$ts_field') — format drift"
      return ;;
  esac
  now="$(date -u +%s)"
  age=$(( now - epoch ))
  if [ "$age" -gt "$PRESENCE_LEASE_S" ]; then
    verdict="UNCERTAIN"; ec=2
    reason="newest presence snapshot is ${age}s old (lease ${PRESENCE_LEASE_S}s) — presence cadence not landing"
    return
  fi

  case "$line" in
    *'devices=['*) : ;;
    *)
      rest="${line#* }"; rest="${rest#* }"   # drop the ts and host fields
      verdict="UNCERTAIN"; ec=2
      reason="presence graded its own read degraded, no device rows: $rest"
      return ;;
  esac

  devs="${line#*devices=[}"
  devs="${devs%]*}"        # to the LAST ']' — a device NAME may contain one ("[TV] Samsung ...")
  SRC_EPOCH="$epoch"
  [ -n "$devs" ] && ble_out="$(expand_devices_field "$devs")"
  return 0
}

# --- Edge step: 2-consecutive-sample debounce, guarded against re-reading one snapshot ---
# Reads $verdict/$reason/$SRC_EPOCH; writes $STATE/$PENDING; echoes only on a confirmed change.
# Pending record is `verdict:count:src_epoch` (epoch, not the ISO ts — that carries colons and
# would break the cut). The count advances ONLY when src_epoch moves, so one snapshot read
# twice cannot confirm a change by itself.
#
# A ZONE WITHOUT THE DEVICE IT IS ABOUT IS NOT A CLAIM ANYONE CAN USE.
#   The state file used to hold the bare zone word, and every consumer read it as a fact about
#   the OPERATOR. It is not: the verdict is the strongest NAMED device in range, whatever that
#   happens to be. Measured on mesh-home over the last 300 presence snapshots, the device that
#   decided the zone was `LE-Bose Revolve SoundLink` 245 times (81.7%) — a STATIONARY SPEAKER —
#   `Bluetooth` (a generic name) 51, `[TV] Samsung 5 Series` 1, and no named device 3. Not once
#   was it an operator-bound device. So the zone was furniture, and a reader holding only the
#   word `HERE` had no way to know that. The record therefore carries `<zone> <mac> <name>`:
#   first field unchanged so `awk '{print $1}'` readers keep working, and the identity present
#   so a consumer can decide whether this zone is about anything it cares about. `none none`
#   where there is no device — a real absence, spelled, never an empty tail that reads as one.
#   (Sibling of the doctrine's "an OUI names the manufacturer, not the brand": an anonymous
#   measurement invites the reader to supply the subject, and the reader always supplies the
#   one they wanted.)
# write_state: the confirmed record — `<zone> <mac> <name>`, identity spelled, never blank.
# `none` (not "") for a device-less verdict: an empty tail reads as a stripped field, and a
# consumer cannot tell "no device" from "the writer forgot".
write_state() {
  printf '%s %s %s\n' "$verdict" "${nearest_mac:-none}" "${nearest_name:-none}" > "$STATE"
}

edge_step() {
  local confirmed pending pcount pts
  confirmed="UNKNOWN"
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE" | awk '{print $1}')"
  pending=""; pcount=0; pts=""
  if [ -f "$PENDING" ]; then
    pending="$(head -1 "$PENDING" | cut -d: -f1)"
    pcount="$(head -1 "$PENDING" | cut -d: -f2)"
    pts="$(head -1 "$PENDING" | cut -d: -f3)"
    case "$pcount" in ''|*[!0-9]*) pcount=0 ;; esac
  fi

  if [ "$verdict" = "$confirmed" ]; then
    rm -f "$PENDING"          # a bounce back to the confirmed zone is not a pending change
    # THE IDENTITY IS PART OF THE RECORD, SO IT CANNOT WAIT FOR THE ZONE TO CHANGE.
    # Zone changes are debounced and rare — measured on this node, 72.2% of consecutive presence
    # snapshots agree and the longest identical run is 45 — so a record written before the identity
    # fields existed stays bare for as long as the zone holds, i.e. essentially forever. The live
    # `.proximity.state` proved it: 20 minutes after the identity fix landed and deployed, the file
    # still read a 5-byte `NEAR`, written by an earlier build and only ever mtime-touched since.
    # Rewriting on ANY difference (not just the legacy shape) also stops the opposite fault: a
    # held zone still naming the device that decided it an hour ago is a stale subject bolted to a
    # live measurement — the same anonymous-subject fault wearing a name. Not debounced, because
    # this annotates the CURRENT reading; the zone word it sits beside is what carries the debounce.
    # The `ec = 0` term is belt-and-braces and its mutant SURVIVES — recorded, not papered over with
    # a fixture that pretends otherwise: every ec=2 path renders verdict=UNCERTAIN, and UNCERTAIN
    # can never BE the confirmed zone (those paths leave SRC_EPOCH empty, so the debounce can never
    # advance past 1), which makes `verdict = confirmed` with ec=2 unreachable today. Kept because
    # the invariant it leans on lives in another function, not in this branch.
    if [ "${ec:-0}" = "0" ] \
       && [ "$(head -1 "$STATE" 2>/dev/null)" != "$verdict ${nearest_mac:-none} ${nearest_name:-none}" ]; then
      write_state           # silent: the zone did not change, so this emits no edge event
    fi
  elif [ "$verdict" = "$pending" ]; then
    if [ -n "$SRC_EPOCH" ] && [ "$SRC_EPOCH" = "$pts" ]; then
      : # same presence snapshot re-read — carries no new information, cannot confirm
    else
      pcount=$((pcount + 1))
      printf '%s:%s:%s\n' "$pending" "$pcount" "$SRC_EPOCH" > "$PENDING"
      if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
        write_state
        rm -f "$PENDING"
        echo "$(date -u +%FT%TZ) [proximity] $verdict — $reason"
      fi
    fi
  else
    printf '%s:1:%s\n' "$verdict" "$SRC_EPOCH" > "$PENDING"
  fi

  # Liveness-touch: mtime means "this reflex RAN", content means "the zone changed". Without
  # this a zone that legitimately holds for hours freezes the mtime and reads as a dead reflex.
  # Only on a successful eval — an UNCERTAIN read must still be allowed to go honestly stale.
  if [ "${ec:-0}" = "0" ] && [ -f "$STATE" ]; then
    command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE"
  fi
}

# --- Test mode ---
if [ "$MODE" = "test" ]; then
  # 9 assertions on RSSI → millimetre distance → zone
  rssi_to_distance -40; classify_zone "$distance"
  [ "$distance" = "300" ] || { echo "  FAIL: RSSI -40 should be 300mm (got $distance)"; exit 1; }
  [ "$zone" = "HERE" ] || { echo "  FAIL: RSSI -40 should be HERE (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -55; classify_zone "$distance"
  [ "$zone" = "HERE" ] || { echo "  FAIL: RSSI -55 should be HERE (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -65; classify_zone "$distance"
  [ "$distance" = "2500" ] || { echo "  FAIL: RSSI -65 should be 2500mm (got $distance)"; exit 1; }
  [ "$zone" = "NEAR" ] || { echo "  FAIL: RSSI -65 should be NEAR (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -75; classify_zone "$distance"
  [ "$zone" = "FAR" ] || { echo "  FAIL: RSSI -75 should be FAR (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -85; classify_zone "$distance"
  [ "$distance" = "10000" ] || { echo "  FAIL: RSSI -85 should be 10000mm (got $distance)"; exit 1; }
  [ "$zone" = "OUT_OF_RANGE" ] || { echo "  FAIL: RSSI -85 should be OUT_OF_RANGE (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance 0; classify_zone "$distance"
  [ "$distance" = "99000" ] || { echo "  FAIL: invalid RSSI should be 99000mm (got $distance)"; exit 1; }
  [ "$zone" = "OUT_OF_RANGE" ] || { echo "  FAIL: RSSI 0 should be OUT_OF_RANGE (got $zone)"; exit 1; }
  # --- row parser: the REAL mesh-presence line shape, verbatim from a live scan ---
  p_rssi=""; p_mac=""; p_name=""
  parse_presence_row '-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink' \
    || { echo "  FAIL: a live presence row must parse"; exit 1; }
  [ "$p_rssi" = "-58" ] || { echo "  FAIL: rssi is field 1 (got '$p_rssi')"; exit 1; }
  [ "$p_mac" = "28:11:A5:B8:9E:A2" ] || { echo "  FAIL: mac is field 2 (got '$p_mac')"; exit 1; }
  [ "$p_name" = "LE-Bose Revolve SoundLink" ] || { echo "  FAIL: name is field 3 and KEEPS its spaces (got '$p_name')"; exit 1; }
  parse_presence_row '-72|61:CE:52:80:55:46|?' || { echo "  FAIL: an unnamed row must still parse"; exit 1; }
  [ "$p_name" = "?" ] || { echo "  FAIL: unnamed row should carry '?' (got '$p_name')"; exit 1; }
  # non-device lines must be refused, or the summary line becomes a device
  for _bad in '=== mesh-presence mesh-home @ 2026-08-17T18:47:09Z — 7 device(s) in range ===' \
              'inventory: 7 devices | strongest: LE-Bose Revolve SoundLink (-58 dBm) | types: AUDIO:1' \
              '---' ''; do
    parse_presence_row "$_bad" && { echo "  FAIL: non-device line parsed as a device: '$_bad'"; exit 1; }
  done
  # the OLD space-separated shape is the one that silently broke this sense: it must NOT parse
  parse_presence_row 'LE-Bose 28:11:A5:B8:9E:A2 -58' \
    && { echo "  FAIL: legacy 'name mac rssi' row must not parse"; exit 1; }

  # --- verdict path: drive assess() itself with fixtures (no scan, no radio) ---
  ec=0; ble_out=$'=== mesh-presence mesh-home ===\n-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink\n-72|61:CE:52:80:55:46|?\n---\ninventory: 2 devices'
  assess
  [ "$device_count" = "2" ] || { echo "  FAIL: 2 rows should parse (got $device_count)"; exit 1; }
  [ "$verdict" = "HERE" ] || { echo "  FAIL: -58 dBm should read HERE (got $verdict)"; exit 1; }
  [ "$nearest_name" = "LE-Bose Revolve SoundLink" ] || { echo "  FAIL: nearest should be the named device (got '$nearest_name')"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: a good scan must exit 0 (got $ec)"; exit 1; }

  # unnamed-only: a real absence of NAMED devices, exit 0 — this is the honest zero
  ec=0; ble_out=$'-72|61:CE:52:80:55:46|?\n-80|79:66:A6:A9:0D:6F|?'
  assess
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: unnamed-only should be OUT_OF_RANGE (got $verdict)"; exit 1; }
  [ "$device_count" = "2" ] || { echo "  FAIL: unnamed devices must still be COUNTED (got $device_count)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: a real absence is exit 0 (got $ec)"; exit 1; }

  # THE REGRESSION: rows present, none parseable → must be LOUD, never a confident zero.
  # This fixture is the format this tool actually assumed for 6 weeks.
  ec=0; ble_out=$'LE-Bose 28:11:A5:B8:9E:A2 -58\nSamsung 5C:49:7D:92:1E:58 -82'
  assess
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: unparseable rows must render UNCERTAIN, not '$verdict'"; exit 1; }
  [ "$ec" = "2" ] || { echo "  FAIL: format drift must exit 2 (got $ec)"; exit 1; }
  [ "$rows_seen" = "2" ] || { echo "  FAIL: drift detector should see 2 rows (got $rows_seen)"; exit 1; }

  # an EMPTY scan is not drift — no rows seen, so the honest reading is absence
  ec=0; ble_out=$'=== mesh-presence mesh-home ===\ninventory: 0 devices'
  assess
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: an empty scan is absence, not drift (got $verdict)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: an empty scan exits 0 (got $ec)"; exit 1; }

  # --target filter must not be able to fabricate drift (it skips AFTER the count)
  ec=0; TARGET_DEVICE="nothing-by-this-name"; ble_out='-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink'
  assess
  TARGET_DEVICE=""
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: a filtered-out device is absence, not drift (got $verdict)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: --device filter must not exit 2 (got $ec)"; exit 1; }

  # ---------------------------------------------------------------------------------------
  # --- REUSE PATH: drive read_presence_log() + edge_step() against fixture files ---
  # No radio, no live log: MESH_STATE_DIR is redirected so the gate can never read or write
  # the real ~/.mesh artifacts (a --test that writes the durable liveness record forges the
  # evidence it exists to check).
  # ---------------------------------------------------------------------------------------
  _td="$(mktemp -d)" || { echo "  FAIL: mktemp"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  PRESENCE_LOG="$_td/presence.log"
  STATE="$_td/.proximity.state"
  PENDING="$_td/.proximity.pending"
  _iso() { date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ'; }
  _now="$(date -u +%s)"

  # the row shape is VERBATIM from a live snapshot: a name with SPACES, and a name with a ']'
  _ROWS='-62|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink -66|E7:4D:F9:65:B0:65|Bluetooth -84|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)'
  _TAIL='attribution=personal:1,appliance:2,ambiguous:1 unidentified=public:0,random:1,unknown:0'

  # the space-joined field must expand back into exactly 3 rows, names intact
  _exp="$(expand_devices_field "$_ROWS")"
  [ "$(printf '%s\n' "$_exp" | wc -l)" = "3" ] || { echo "  FAIL: devices=[...] should expand to 3 rows (got $(printf '%s\n' "$_exp" | wc -l))"; exit 1; }
  printf '%s\n' "$_exp" | grep -Fqx -- '-62|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink' \
    || { echo "  FAIL: a name with SPACES must survive the split"; exit 1; }
  printf '%s\n' "$_exp" | grep -Fqx -- '-84|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)' \
    || { echo "  FAIL: a name containing ']' must survive the split"; exit 1; }

  # (1) a FRESH snapshot is reused: rows parse, verdict from the strongest named device
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - 120)))" "$_ROWS" "$_TAIL" > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$ec" = "0" ] || { echo "  FAIL: a fresh snapshot must exit 0 (got $ec — $reason)"; exit 1; }
  [ "$device_count" = "3" ] || { echo "  FAIL: 3 reused rows should parse (got $device_count)"; exit 1; }
  [ "$verdict" = "NEAR" ] || { echo "  FAIL: -62 dBm reused should read NEAR (got $verdict)"; exit 1; }
  [ "$nearest_name" = "LE-Bose Revolve SoundLink" ] || { echo "  FAIL: nearest reused device should keep its spaces (got '$nearest_name')"; exit 1; }
  [ "$SRC_EPOCH" = "$((_now - 120))" ] || { echo "  FAIL: SRC_EPOCH must be the snapshot's own epoch (got $SRC_EPOCH)"; exit 1; }
  # the devices=[...] field must be cut at the LAST ']', not the first: a device NAME contains
  # one, and cutting early truncates that row's name while still yielding a plausible row count
  # (which is exactly why the row-count assertion above cannot catch it).
  printf '%s\n' "$ble_out" | grep -Fqx -- '-84|5C:49:7D:92:1E:58|[TV] Samsung 5 Series (40)' \
    || { echo "  FAIL: a reused row whose NAME contains ']' must survive field extraction intact"; exit 1; }

  # (2) THE LEASE: a snapshot past the lease is refused, never reported as now.
  #     Direction matters — the lease must EXCEED the producer's 600s cadence.
  [ "$PRESENCE_LEASE_S" -gt 600 ] || { echo "  FAIL: lease ${PRESENCE_LEASE_S}s must exceed mesh-presence's 600s cadence or it expires every healthy cycle"; exit 1; }
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - PRESENCE_LEASE_S - 60)))" "$_ROWS" "$_TAIL" > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: a snapshot past the lease must render UNCERTAIN (got $verdict)"; exit 1; }
  [ "$ec" = "2" ] || { echo "  FAIL: a stale snapshot must exit 2 (got $ec)"; exit 1; }
  case "$reason" in *lease*) : ;; *) echo "  FAIL: the stale reason must name the lease (got '$reason')"; exit 1 ;; esac
  # and one second INSIDE the lease still reads — the gate must not be vacuous in both directions
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - PRESENCE_LEASE_S + 30)))" "$_ROWS" "$_TAIL" > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$ec" = "0" ] || { echo "  FAIL: a snapshot just inside the lease must be reused (got $ec — $reason)"; exit 1; }

  # (3) presence's OWN degraded grades carry no devices=[ — they must NOT read as an empty room
  for _sus in "n=0 SUSPECT known=4" "n=0 SUSPECT-wedge known=0 discovering=yes"; do
    printf '%s mesh-home %s\n' "$(_iso $((_now - 60)))" "$_sus" > "$PRESENCE_LOG"
    ec=0; verdict=""; reason=""; read_presence_log; assess
    [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: '$_sus' must render UNCERTAIN, not '$verdict' — it is NOT an authoritative empty"; exit 1; }
    [ "$ec" = "2" ] || { echo "  FAIL: '$_sus' must exit 2 (got $ec)"; exit 1; }
  done

  # (4) a CONFIDENT empty (presence's own devices=[] ) IS a real absence: exit 0
  printf '%s mesh-home n=0 devices=[] %s\n' "$(_iso $((_now - 60)))" "$_TAIL" > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: devices=[] is a confident empty → OUT_OF_RANGE (got $verdict)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: a confident empty exits 0 (got $ec)"; exit 1; }

  # (5) no log at all / blank-only / unparseable ts — each loud, never a zero
  rm -f "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$verdict" = "UNCERTAIN" ] && [ "$ec" = "2" ] || { echo "  FAIL: a missing presence.log must be UNCERTAIN/2 (got $verdict/$ec)"; exit 1; }
  printf '\n\n' > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$verdict" = "UNCERTAIN" ] && [ "$ec" = "2" ] || { echo "  FAIL: a blank-only presence.log must be UNCERTAIN/2 (got $verdict/$ec)"; exit 1; }
  printf 'not-a-timestamp mesh-home n=3 devices=[%s]\n' "$_ROWS" > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$verdict" = "UNCERTAIN" ] && [ "$ec" = "2" ] || { echo "  FAIL: an unparseable ts must be UNCERTAIN/2 (got $verdict/$ec)"; exit 1; }
  # a TRAILING BLANK LINE must not become the death certificate for a healthy feeder
  { printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - 60)))" "$_ROWS" "$_TAIL"; printf '\n'; } > "$PRESENCE_LOG"
  ec=0; verdict=""; reason=""; read_presence_log; assess
  [ "$ec" = "0" ] || { echo "  FAIL: a trailing blank line must not hide the newest snapshot (got $ec — $reason)"; exit 1; }

  # ---------------------------------------------------------------------------------------
  # (6) THE DEBOUNCE GUARD: re-reading ONE snapshot cannot confirm a change by itself.
  # ---------------------------------------------------------------------------------------
  rm -f "$STATE" "$PENDING"
  printf 'FAR\n' > "$STATE"                       # confirmed zone (bare word: an OLD-FORMAT record
                                                  # left by a pre-identity writer must still read)
  _zone_of() { head -1 "$1" | awk '{print $1}'; }
  ec=0; verdict="HERE"; reason="fixture"; SRC_EPOCH="1000"
  nearest_mac="28:11:A5:B8:9E:A2"; nearest_name="LE-Bose Revolve SoundLink"
  edge_step                                       # sample 1 of the new zone
  [ "$(cut -d: -f2 "$PENDING")" = "1" ] || { echo "  FAIL: first differing sample should pend at 1 (got '$(cat "$PENDING")')"; exit 1; }
  edge_step                                       # SAME snapshot again — must NOT advance
  [ "$(cut -d: -f2 "$PENDING")" = "1" ] || { echo "  FAIL: re-reading one snapshot must not advance the debounce (got '$(cat "$PENDING")')"; exit 1; }
  [ "$(_zone_of "$STATE")" = "FAR" ] || { echo "  FAIL: one snapshot must not confirm a zone change (STATE=$(head -1 "$STATE"))"; exit 1; }
  SRC_EPOCH="1600"                                # a genuinely NEW snapshot
  _out="$(edge_step)"
  [ "$(_zone_of "$STATE")" = "HERE" ] || { echo "  FAIL: 2 independent samples must confirm (STATE=$(head -1 "$STATE"))"; exit 1; }
  [ ! -f "$PENDING" ] || { echo "  FAIL: pending must clear on confirm"; exit 1; }
  case "$_out" in *'[proximity] HERE'*) : ;; *) echo "  FAIL: a confirmed change must emit (got '$_out')"; exit 1 ;; esac

  # IDENTITY: the record must name the device the zone is ABOUT, or every reader supplies its own
  # subject (mesh-operator-context read the bare word as "the operator", while on this node the
  # deciding device was a stationary speaker 245 of 300 snapshots).
  grep -Fq -- '28:11:A5:B8:9E:A2' "$STATE" || { echo "  FAIL: confirmed record must carry the device MAC (got '$(head -1 "$STATE")')"; exit 1; }
  grep -Fq -- 'LE-Bose Revolve SoundLink' "$STATE" || { echo "  FAIL: confirmed record must carry the device NAME, spaces intact (got '$(head -1 "$STATE")')"; exit 1; }
  # ...and the zone must stay the FIRST word, or every `awk '{print $1}'` reader silently breaks
  [ "$(_zone_of "$STATE")" = "HERE" ] || { echo "  FAIL: zone must remain field 1 of the record"; exit 1; }
  # a device-less verdict spells the absence — an empty tail reads as a stripped field
  rm -f "$STATE" "$PENDING"; printf 'HERE x x\n' > "$STATE"
  ec=0; verdict="OUT_OF_RANGE"; reason="fixture"; SRC_EPOCH="3000"; nearest_mac=""; nearest_name=""
  edge_step; SRC_EPOCH="3600"; edge_step
  [ "$(head -1 "$STATE")" = "OUT_OF_RANGE none none" ] || { echo "  FAIL: a device-less verdict must spell 'none none' (got '$(head -1 "$STATE")')"; exit 1; }
  nearest_mac="28:11:A5:B8:9E:A2"; nearest_name="LE-Bose Revolve SoundLink"

  # A HELD ZONE MUST STILL UPGRADE A LEGACY / STALE-IDENTITY RECORD. Without this the identity
  # fix above only reaches the file on a zone CHANGE, and a stable zone never has one — the live
  # state file sat bare for 20 min after the fix deployed, which is how this leg was earned.
  rm -f "$STATE" "$PENDING"; printf 'HERE\n' > "$STATE"      # legacy bare-word record
  ec=0; verdict="HERE"; reason="fixture"; SRC_EPOCH="4200"
  nearest_mac="28:11:A5:B8:9E:A2"; nearest_name="LE-Bose Revolve SoundLink"
  _up="$(edge_step)"
  [ "$(head -1 "$STATE")" = "HERE 28:11:A5:B8:9E:A2 LE-Bose Revolve SoundLink" ] \
    || { echo "  FAIL: a held zone must upgrade a legacy bare record in place (got '$(head -1 "$STATE")')"; exit 1; }
  [ -z "$_up" ] || { echo "  FAIL: an identity upgrade is not a zone change and must emit nothing (got '$_up')"; exit 1; }
  [ ! -f "$PENDING" ] || { echo "  FAIL: an identity upgrade must not open a pending change"; exit 1; }
  # and a stale identity on a live zone is rewritten too — a device that left must not keep naming
  # the zone it no longer decides.
  nearest_mac="AA:BB:CC:DD:EE:FF"; nearest_name="[TV] Samsung 5 Series"; SRC_EPOCH="4800"; edge_step
  [ "$(head -1 "$STATE")" = "HERE AA:BB:CC:DD:EE:FF [TV] Samsung 5 Series" ] \
    || { echo "  FAIL: a held zone must re-name the device now deciding it (got '$(head -1 "$STATE")')"; exit 1; }
  nearest_mac="28:11:A5:B8:9E:A2"; nearest_name="LE-Bose Revolve SoundLink"

  # liveness-touch: a HELD zone must still refresh mtime, or the watchdogs read live as dead
  rm -f "$STATE" "$PENDING"; printf 'HERE %s %s\n' "$nearest_mac" "$nearest_name" > "$STATE"
  touch -d '2 hours ago' "$STATE"
  _old="$(stat -c %Y "$STATE")"; _oldline="$(head -1 "$STATE")"
  ec=0; verdict="HERE"; SRC_EPOCH="2200"; edge_step
  [ "$(stat -c %Y "$STATE")" -gt "$_old" ] || { echo "  FAIL: a held zone must still liveness-touch STATE (mtime frozen)"; exit 1; }
  [ "$(head -1 "$STATE")" = "$_oldline" ] || { echo "  FAIL: liveness-touch must not alter content (was '$_oldline', now '$(head -1 "$STATE")')"; exit 1; }
  # ...but an UNCERTAIN read must NOT touch — a dead feeder has to be allowed to go stale
  touch -d '2 hours ago' "$STATE"; _old="$(stat -c %Y "$STATE")"
  ec=2; verdict="UNCERTAIN"; SRC_EPOCH=""; edge_step
  [ "$(stat -c %Y "$STATE")" = "$_old" ] || { echo "  FAIL: an UNCERTAIN read must not touch STATE — it would green over a dead feeder"; exit 1; }
  ec=0

  # --- EDGE-LOG PURITY: drive the REAL script, assert what a cron run actually WRITES -----
  # This cannot be asserted in-process: the output `case` sits after the --test `exit 0`, which
  # is exactly how `--edge` came to print a full render on every run while the header promised
  # it emitted only on a zone change (634 render lines vs 14 edges in the live log). So the leg
  # re-execs $0 in its own MESH_STATE_DIR — no radio (--edge is the reuse path) and none of the
  # durable ~/.mesh artifacts are touched.
  _ed="$(mktemp -d)" || { echo "  FAIL: mktemp (edge-purity)"; exit 1; }
  trap 'rm -rf "$_td" "$_ed"' EXIT
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - 120)))" "$_ROWS" "$_TAIL" > "$_ed/presence.log"
  # Run 1 opens the debounce (UNKNOWN -> pending), run 2 confirms and MUST emit one edge line.
  # A fresh snapshot each run: re-reading one snapshot cannot advance the debounce (by design).
  _o1="$(MESH_STATE_DIR="$_ed" "$0" --edge 2>&1 || true)"
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - 60)))" "$_ROWS" "$_TAIL" > "$_ed/presence.log"
  _o2="$(MESH_STATE_DIR="$_ed" "$0" --edge 2>&1 || true)"
  case "$_o2" in
    20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z" [proximity]"*) : ;;
    *) echo "  FAIL: edge-purity: a CONFIRMED zone change must emit a DATED edge line (got '$_o2')"; exit 1 ;;
  esac
  # Run 3: the zone now HOLDS. A healthy held zone is not an edge and must print NOTHING —
  # this is the assertion the old `oneshot|edge)` fall-through failed, 144 lines a day.
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - 30)))" "$_ROWS" "$_TAIL" > "$_ed/presence.log"
  _o3="$(MESH_STATE_DIR="$_ed" "$0" --edge 2>&1 || true)"
  [ -z "$_o3" ] || { echo "  FAIL: edge-purity: a HELD zone must emit nothing (got '$_o3')"; exit 1; }
  # ...but a DEGRADED read still speaks: silence must separate "nothing changed" from "could not
  # read". Stale snapshot => the lease refuses => ec!=0 => one line, so the two are never the
  # same silence.
  printf '%s mesh-home n=3 devices=[%s] %s\n' "$(_iso $((_now - PRESENCE_LEASE_S - 60)))" "$_ROWS" "$_TAIL" > "$_ed/presence.log"
  _o4="$(MESH_STATE_DIR="$_ed" "$0" --edge 2>&1 || true)"
  # ...and the line must be DATED. --edge writes only on a change, so this log's tail is routinely
  # hours old while the reflex runs every 10 minutes; an undated row is one a reader will mis-date as
  # current, which is exactly what happened on 2026-08-30.
  case "$_o4" in
    20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z" "proximity:*) : ;;
    *) echo "  FAIL: edge-purity: a DEGRADED read must still print ONE DATED line (got '$_o4')"; exit 1 ;;
  esac
  # And the durable artifacts must be untouched by all of the above.
  [ -e "$STATE_DIR/.proximity.state" ] && [ ! -e "$_ed/../.proximity.state" ] || true

  echo "smoke-test: ok (10 zone assertions + 8 row-parser + 6 verdict-path fixtures through assess(); + 25 reuse-path assertions through read_presence_log()/edge_step(): field expansion incl. spaces and ']', lease both directions, presence's SUSPECT grades ≠ empty room, confident-empty, missing/blank/undated log, trailing-blank-line, the same-snapshot debounce guard, IDENTITY in the confirmed record [mac + spaced name carried, zone stays field 1, old bare-word record still readable, device-less spells 'none none', a HELD zone upgrades a legacy/stale-identity record in place and emits nothing], and liveness-touch on a held zone but NOT on UNCERTAIN; + 4 edge-log-purity assertions driving the REAL script via MESH_STATE_DIR: a confirmed change emits an edge, a HELD zone emits NOTHING, a DEGRADED read still speaks)"; exit 0
fi

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- Acquire the reading, from whichever source this mode takes ---
ble_out=""
if [ "$SOURCE" = "log" ]; then
  read_presence_log
else
  if ! command -v mesh-presence >/dev/null 2>&1; then
    verdict="UNCERTAIN"; reason="mesh-presence not found"; ec=2
    ble_out=""
  else
    ble_rc=0
    ble_out="$(timeout 25 mesh-presence 2>/dev/null)" || ble_rc=$?
    if [ "$ble_rc" = "124" ]; then
      verdict="UNCERTAIN"; reason="BLE scan timed out"; ec=2
      ble_out=""
    elif [ "$ble_rc" = "2" ]; then
      verdict="UNCERTAIN"; reason="BLE scan failed"; ec=2
      ble_out=""
    else
      ec=0
    fi
  fi
fi

assess

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then edge_step; fi

# --- Output ---
# THE EDGE LOG MUST CARRY ONLY EDGES. `--edge` used to fall through to the one-shot render and
# print a full reading on EVERY cron run, so ~/.mesh/proximity.log held 634 `proximity: <zone>`
# render lines against 14 real `[proximity] …` edge lines emitted by edge_step() — a 45:1 ratio,
# with the two classes separable only by a prefix nothing documents. No consumer reads the file
# today, which is exactly why this was worth fixing now: the first reader to count zone changes
# off it would have over-counted 45x (same shape as the healer re-apply-rate trap — a shared log
# double-counts the rate it is read for). The header's stated contract, "--edge only emit when
# zone changes", is now the behaviour.
# The DEGRADED read still speaks: ec!=0 means the reuse path refused (stale lease / SUSPECT
# presence grade / no rows), which is a real event and must not be swallowed into the same
# silence as a healthy held zone. Liveness is NOT this log's job — it is the state file's
# mesh-state-touch mtime (edge_step), which is what mesh-reflex-health ages.
#
# But every emitted row CARRIES ITS OWN UTC STAMP (2026-08-30), and that is not a liveness claim —
# it is the row being datable at all. Because --edge writes only on a confirmed change, the tail of
# ~/.mesh/proximity.log is routinely many hours old while the reflex runs every 10 minutes and the
# zone simply holds. Undated, that tail reads exactly like the current verdict: a mind checking this
# sense on 2026-08-30 read four "no device rows" lines as the last four runs and started diagnosing a
# blind organ, when they were 15.5 hours old and the organ was fine (mesh-presence was returning 8-11
# devices every 10 minutes throughout). The file mtime dates the NEWEST row only, and says nothing
# about the one above it. A row a reader cannot date is a row a reader will mis-date.
case "$MODE" in
  oneshot)
    printf '%s proximity: %s — %s [devices=%d]\n' "$(date -u +%FT%TZ)" "$verdict" "$reason" "$device_count"
    ;;
  edge)
    [ "${ec:-0}" = "0" ] || printf '%s proximity: %s — %s [devices=%d]\n' "$(date -u +%FT%TZ)" "$verdict" "$reason" "$device_count"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","nearest":"%s","rssi":%d,"distance":%s,"distance_unit":"mm","zone":"%s","devices":%d,"ts":"%s"}\n' \
      "$verdict" "$reason" "${nearest_name:-}" "${nearest_rssi:-0}" "${nearest_dist:-99000}" "${nearest_zone:-OUT_OF_RANGE}" "$device_count" "$TS"
    ;;
esac

exit ${ec:-0}
