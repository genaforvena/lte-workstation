#!/usr/bin/env bash
# mesh-proximity — BLE proximity distance estimate from RSSI
# Converts mesh-presence RSSI readings into approximate distance using the log-distance path loss model.
# The IdeaPad's BLE radio perceives RSSI; this tool translates it to millimetres.
#
# Usage:
#   mesh-proximity                  one-shot: nearest named device distance + zone
#   mesh-proximity --edge           only emit when zone changes (for cron wiring)
#   mesh-proximity --json           machine-readable JSON
#   mesh-proximity --test           smoke test (no scan)
#   mesh-proximity --device "Name"  filter to specific device
#
# Zones (IEEE 802.15.1 inspired):
#   HERE     = < 1500mm  (right next to you — same desk, in-hand)
#   NEAR     = 1500–4000mm  (same room, reachable)
#   FAR      = 4000–10000mm   (same building, other side of room)
#   OUT_OF_RANGE = >10000mm or not visible
#
# Honest contract:
#   - No device visible → OUT_OF_RANGE (absence is a real signal)
#   - RSSI too weak (< -90) → OUT_OF_RANGE (below noise floor)
#   - BLE scan failed → UNCERTAIN with exit 2
#   - presence rows PRESENT but none parseable → UNCERTAIN with exit 2 (format drift).
#     This leg exists because its absence cost us the sense: this tool split each row on
#     WHITESPACE as `name mac rssi` while mesh-presence has rendered `rssi|mac|name` since
#     2026-07-06 (26000b7). Every row failed the "is field 3 an integer" check and was
#     skipped, so a fully-working radio seeing 7 devices rendered as a confident
#     "OUT_OF_RANGE — no named BLE devices visible [devices=0]". Absence being a REAL
#     signal here is exactly what made the total parse failure invisible: the fault wore
#     the vocabulary of a legitimate reading. A parse that consumes nothing is never a
#     measurement — it must be loud, not a zero. (2026-08-17.)
#
# Exit codes:
#   0 = verdict assessed
#   2 = cannot assess (BLE scan failed entirely, or its output no longer parses)

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.proximity.state"
PENDING="$STATE_DIR/.proximity.pending"
MODE="oneshot"
EDGE_WINDOW=2
TARGET_DEVICE=""

for arg in "$@"; do
  case "$arg" in
    --edge) MODE=edge ;;
    --json) MODE=json ;;
    --test) MODE=test ;;
    --device) shift; TARGET_DEVICE="${1:-}"; shift || true ;;
  esac
done

mkdir -p "$STATE_DIR"

# --- Calibration constants ---
TX_POWER=-59
PATH_LOSS_N=2.5

# --- Distance from RSSI (case-based, no bc dependency) ---
rssi_to_distance() {
  local rssi="$1"
  if [ "$rssi" -ge 0 ] || [ "$rssi" -le -100 ]; then
    distance="99000"; return
  fi
  case "$rssi" in
    -[0-4][0-9]|-50) distance="300" ;;
    -5[1-9]|-60)     distance="1000" ;;
    -6[1-9]|-70)     distance="2500" ;;
    -7[1-9]|-80)     distance="5000" ;;
    -8[1-9]|-90)     distance="10000" ;;
    *)               distance="15000" ;;
  esac
}

# --- Presence row parsing ---
# mesh-presence renders one device per line as  rssi|mac|name  (name is '?' when unnamed).
# Sets p_rssi/p_mac/p_name; returns 1 for anything that is not a device row.
parse_presence_row() {
  local line="$1" f1 f2 f3 rest
  case "$line" in *'|'*) : ;; *) return 1 ;; esac
  f1="${line%%|*}"; rest="${line#*|}"
  f2="${rest%%|*}"; f3="${rest#*|}"
  [[ "$f1" =~ ^-[0-9]+$ ]] || return 1
  [[ "$f2" =~ ^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$ ]] || return 1
  p_rssi="$f1"; p_mac="$f2"; p_name="$f3"
  return 0
}

# A line carrying a MAC is a device row in ANY plausible format — that is what makes it the
# drift detector: it counts rows the parser OUGHT to have consumed, independent of the
# field order the parser assumes.
row_looks_like_device() {
  [[ "$1" =~ [0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5} ]]
}

classify_zone() {
  local d="$1"
  if [ "$d" -lt 1500 ] 2>/dev/null; then
    zone="HERE"
  elif [ "$d" -lt 4000 ] 2>/dev/null; then
    zone="NEAR"
  elif [ "$d" -lt 10000 ] 2>/dev/null; then
    zone="FAR"
  else
    zone="OUT_OF_RANGE"
  fi
}

# --- Parse BLE output: find strongest named device, and set the verdict ---
# One function so the gate below drives THIS code, not a re-typed copy of it.
# Reads $ble_out + $ec; sets nearest_*, device_count, rows_seen, verdict, reason, ec.
assess() {
  nearest_name=""
  nearest_rssi=-999
  nearest_mac=""
  nearest_dist="99000"
  nearest_zone="OUT_OF_RANGE"
  device_count=0
  rows_seen=0

  if [ -n "$ble_out" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      row_looks_like_device "$line" || continue
      rows_seen=$((rows_seen + 1))

      p_rssi=""; p_mac=""; p_name=""
      parse_presence_row "$line" || continue
      device_count=$((device_count + 1))

      # '?' is a real body but not a NAMED device — counted, never the nearest.
      [ "$p_name" = "?" ] && continue

      if [ -n "$TARGET_DEVICE" ] && [ "$p_name" != "$TARGET_DEVICE" ]; then
        continue
      fi

      if [ "$p_rssi" -gt "$nearest_rssi" ] 2>/dev/null; then
        nearest_rssi="$p_rssi"
        nearest_name="$p_name"
        nearest_mac="$p_mac"
        rssi_to_distance "$p_rssi"
        nearest_dist="$distance"
        classify_zone "$distance"
        nearest_zone="$zone"
      fi
    done <<< "$ble_out"
  fi

  if [ "$ec" = "2" ]; then
    : # already set by the caller (scan failed / timed out)
  elif [ "$rows_seen" -gt 0 ] && [ "$device_count" -eq 0 ]; then
    verdict="UNCERTAIN"
    reason="presence rows unparseable ($rows_seen row(s) carried a MAC, 0 parsed) — output format drift"
    ec=2
  elif [ -z "$nearest_name" ]; then
    verdict="OUT_OF_RANGE"; reason="no named BLE devices visible"
  else
    verdict="$nearest_zone"; reason="$nearest_name at ${nearest_dist}mm (rssi=$nearest_rssi)"
  fi
}

# --- Test mode ---
if [ "$MODE" = "test" ]; then
  # 9 assertions on RSSI → millimetre distance → zone
  rssi_to_distance -40; classify_zone "$distance"
  [ "$distance" = "300" ] || { echo "  FAIL: RSSI -40 should be 300mm (got $distance)"; exit 1; }
  [ "$zone" = "HERE" ] || { echo "  FAIL: RSSI -40 should be HERE (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -55; classify_zone "$distance"
  [ "$zone" = "HERE" ] || { echo "  FAIL: RSSI -55 should be HERE (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -65; classify_zone "$distance"
  [ "$distance" = "2500" ] || { echo "  FAIL: RSSI -65 should be 2500mm (got $distance)"; exit 1; }
  [ "$zone" = "NEAR" ] || { echo "  FAIL: RSSI -65 should be NEAR (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -75; classify_zone "$distance"
  [ "$zone" = "FAR" ] || { echo "  FAIL: RSSI -75 should be FAR (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance -85; classify_zone "$distance"
  [ "$distance" = "10000" ] || { echo "  FAIL: RSSI -85 should be 10000mm (got $distance)"; exit 1; }
  [ "$zone" = "OUT_OF_RANGE" ] || { echo "  FAIL: RSSI -85 should be OUT_OF_RANGE (got $zone, d=$distance)"; exit 1; }
  rssi_to_distance 0; classify_zone "$distance"
  [ "$distance" = "99000" ] || { echo "  FAIL: invalid RSSI should be 99000mm (got $distance)"; exit 1; }
  [ "$zone" = "OUT_OF_RANGE" ] || { echo "  FAIL: RSSI 0 should be OUT_OF_RANGE (got $zone)"; exit 1; }
  # --- row parser: the REAL mesh-presence line shape, verbatim from a live scan ---
  p_rssi=""; p_mac=""; p_name=""
  parse_presence_row '-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink' \
    || { echo "  FAIL: a live presence row must parse"; exit 1; }
  [ "$p_rssi" = "-58" ] || { echo "  FAIL: rssi is field 1 (got '$p_rssi')"; exit 1; }
  [ "$p_mac" = "28:11:A5:B8:9E:A2" ] || { echo "  FAIL: mac is field 2 (got '$p_mac')"; exit 1; }
  [ "$p_name" = "LE-Bose Revolve SoundLink" ] || { echo "  FAIL: name is field 3 and KEEPS its spaces (got '$p_name')"; exit 1; }
  parse_presence_row '-72|61:CE:52:80:55:46|?' || { echo "  FAIL: an unnamed row must still parse"; exit 1; }
  [ "$p_name" = "?" ] || { echo "  FAIL: unnamed row should carry '?' (got '$p_name')"; exit 1; }
  # non-device lines must be refused, or the summary line becomes a device
  for _bad in '=== mesh-presence mesh-home @ 2026-08-17T18:47:09Z — 7 device(s) in range ===' \
              'inventory: 7 devices | strongest: LE-Bose Revolve SoundLink (-58 dBm) | types: AUDIO:1' \
              '---' ''; do
    parse_presence_row "$_bad" && { echo "  FAIL: non-device line parsed as a device: '$_bad'"; exit 1; }
  done
  # the OLD space-separated shape is the one that silently broke this sense: it must NOT parse
  parse_presence_row 'LE-Bose 28:11:A5:B8:9E:A2 -58' \
    && { echo "  FAIL: legacy 'name mac rssi' row must not parse"; exit 1; }

  # --- verdict path: drive assess() itself with fixtures (no scan, no radio) ---
  ec=0; ble_out=$'=== mesh-presence mesh-home ===\n-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink\n-72|61:CE:52:80:55:46|?\n---\ninventory: 2 devices'
  assess
  [ "$device_count" = "2" ] || { echo "  FAIL: 2 rows should parse (got $device_count)"; exit 1; }
  [ "$verdict" = "HERE" ] || { echo "  FAIL: -58 dBm should read HERE (got $verdict)"; exit 1; }
  [ "$nearest_name" = "LE-Bose Revolve SoundLink" ] || { echo "  FAIL: nearest should be the named device (got '$nearest_name')"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: a good scan must exit 0 (got $ec)"; exit 1; }

  # unnamed-only: a real absence of NAMED devices, exit 0 — this is the honest zero
  ec=0; ble_out=$'-72|61:CE:52:80:55:46|?\n-80|79:66:A6:A9:0D:6F|?'
  assess
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: unnamed-only should be OUT_OF_RANGE (got $verdict)"; exit 1; }
  [ "$device_count" = "2" ] || { echo "  FAIL: unnamed devices must still be COUNTED (got $device_count)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: a real absence is exit 0 (got $ec)"; exit 1; }

  # THE REGRESSION: rows present, none parseable → must be LOUD, never a confident zero.
  # This fixture is the format this tool actually assumed for 6 weeks.
  ec=0; ble_out=$'LE-Bose 28:11:A5:B8:9E:A2 -58\nSamsung 5C:49:7D:92:1E:58 -82'
  assess
  [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: unparseable rows must render UNCERTAIN, not '$verdict'"; exit 1; }
  [ "$ec" = "2" ] || { echo "  FAIL: format drift must exit 2 (got $ec)"; exit 1; }
  [ "$rows_seen" = "2" ] || { echo "  FAIL: drift detector should see 2 rows (got $rows_seen)"; exit 1; }

  # an EMPTY scan is not drift — no rows seen, so the honest reading is absence
  ec=0; ble_out=$'=== mesh-presence mesh-home ===\ninventory: 0 devices'
  assess
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: an empty scan is absence, not drift (got $verdict)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: an empty scan exits 0 (got $ec)"; exit 1; }

  # --target filter must not be able to fabricate drift (it skips AFTER the count)
  ec=0; TARGET_DEVICE="nothing-by-this-name"; ble_out='-58|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink'
  assess
  TARGET_DEVICE=""
  [ "$verdict" = "OUT_OF_RANGE" ] || { echo "  FAIL: a filtered-out device is absence, not drift (got $verdict)"; exit 1; }
  [ "$ec" = "0" ] || { echo "  FAIL: --device filter must not exit 2 (got $ec)"; exit 1; }

  echo "smoke-test: ok (10 zone assertions + 8 row-parser + 6 verdict-path fixtures through assess(), incl. the format-drift regression: rows seen, 0 parsed → UNCERTAIN/exit 2)"; exit 0
fi

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- BLE scan: get raw output, parse in main scope ---
ble_out=""
if ! command -v mesh-presence >/dev/null 2>&1; then
  verdict="UNCERTAIN"; reason="mesh-presence not found"; ec=2
  ble_out=""
else
  ble_rc=0
  ble_out="$(timeout 25 mesh-presence 2>/dev/null)" || ble_rc=$?
  if [ "$ble_rc" = "124" ]; then
    verdict="UNCERTAIN"; reason="BLE scan timed out"; ec=2
    ble_out=""
  elif [ "$ble_rc" = "2" ]; then
    verdict="UNCERTAIN"; reason="BLE scan failed"; ec=2
    ble_out=""
  else
    ec=0
  fi
fi

assess

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed="UNKNOWN"
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""
  pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    : # stable
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[proximity] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'proximity: %s — %s [devices=%d]\n' "$verdict" "$reason" "$device_count"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","nearest":"%s","rssi":%d,"distance":%s,"distance_unit":"mm","zone":"%s","devices":%d,"ts":"%s"}\n' \
      "$verdict" "$reason" "${nearest_name:-}" "${nearest_rssi:-0}" "${nearest_dist:-99000}" "${nearest_zone:-OUT_OF_RANGE}" "$device_count" "$TS"
    ;;
esac

exit ${ec:-0}
