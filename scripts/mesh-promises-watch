#!/usr/bin/env bash
# mesh-promises-watch — event-fire `mesh-promises --feed` on every board write, so a promise/claim/
# hold crossing its leak threshold surfaces in ~seconds instead of waiting up to the hourly
# `mesh-promises --feed` cron (31 * * * *, KEPT as the slow backstop — it still catches an age-based
# crossing that matures while the board is quiet). The board already fires event-first
# (mesh-fsnotify on chat.log → mesh-dispatch in ~4ms); this puts the LEDGER side on that same
# event-over-cron shape. docs/design-hledger-coordination-2026-07-24.md — "alarm fires FROM a ledger
# event" row (was: open, no owner).
#
# WHY A PARALLEL LISTENER, NOT A CHANGE TO THE DISPATCH TRIGGER: mesh-fsnotify already rides
# chat.log → mesh-dispatch (reflexes.cron, verified-working, load-bearing). We deliberately do NOT
# fold --feed into that command — a slow/broken ledger feed must never touch the mind-waking path.
# Instead this is its OWN bounded listener on the SAME file with its OWN lock. mesh-fsnotify keys its
# default lock on the TARGET PATH, so two listeners on chat.log would collide ("listener already
# active") unless the second carries a distinct MESH_FSNOTIFY_LOCK — which is this wrapper's one job.
#
# SAFE TO RE-FIRE ON EVERY WRITE: `--feed` is idempotent — it rebuilds the journal from the board and
# commits ONLY when the journal changed, and its leak alarm dedupes via ~/.mesh/.promises-state (each
# leak posts once, on the transition into leaked). So a burst of board writes coalesces (debounce) to
# one replay, with no commit churn and no duplicate alarms. Leak-posting policy is unchanged from the
# cron (no MESH_PROMISE_POST forced here) — on a witness node the witness pane surfaces the refreshed
# leak worklist; the only thing this changes is that the refresh is prompt, not up to an hour late.
#
# reflex-cadence: */5 * * * *
# reflex-args: --window 290 --debounce 15 $HOME/.mesh/chat.log -- mesh-promises --feed
#   (--window 290 relaunched every 5min = continuous coverage with the cron as the missed-event floor,
#    exactly like the dispatch listener. --debounce 15: --feed is a full replay+commit, heavier than a
#    dispatch pass, so coalesce a board burst more; ~15s vs up-to-26min is the whole win.)
set -euo pipefail
# Resolve sibling mesh tools by name from cron/background context (no inherited PATH): mesh-fsnotify
# (execed below) and the wrapped `mesh-promises` both live here. mesh-fsnotify re-exports the same —
# harmless — but WE must set it FIRST or the bare `exec mesh-fsnotify` below is "not found" under cron
# (caught live: the --test passed on an interactive PATH, the background fire did not).
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH:-$HOME/.mesh}"

# The distinct lock: without it, this listener shares the dispatch watcher's per-file lock on
# chat.log and would exit "listener already active" forever, never firing --feed.
DISPATCH_LOCK="$MESH/.fsnotify-$(printf '%s' "$HOME/.mesh/chat.log" | cksum | cut -d' ' -f1).lock"
PROMISES_LOCK="$MESH/.fsnotify-promises.lock"

if [ "${1:-}" = --test ]; then
  fail(){ echo "mesh-promises-watch --test: FAIL ($*)"; exit 1; }
  # 1) THE contract this wrapper adds: its lock is DISTINCT from the dispatch watcher's, so both
  #    coexist on chat.log. Falsify: set PROMISES_LOCK=$DISPATCH_LOCK → this assertion goes red.
  [ "$PROMISES_LOCK" != "$DISPATCH_LOCK" ] || fail "promises lock collides with the dispatch watcher's per-file lock — the second listener would never fire"
  # 2) the listener MECHANISM is mesh-fsnotify's, whose own RED-first --test proves event→cmd,
  #    burst-coalescing, and the per-target lock. Delegate to it (honest n/a if fsnotify absent).
  command -v mesh-fsnotify >/dev/null 2>&1 || { echo "mesh-promises-watch --test: n/a (no mesh-fsnotify on this node)" >&2; exit 2; }
  mesh-fsnotify --test >/dev/null 2>&1 || { echo "mesh-promises-watch --test: n/a (mesh-fsnotify --test not green — fix the mechanism first)" >&2; exit 2; }
  # 3) end-to-end LIVE leg: arm THIS wrapper on a temp file with a short window + a stub command and
  #    prove a write fires it under its own lock (the whole point — a wrapper's test must exercise the
  #    thing it wraps, not just assert the string). Falsify: drop the lock export → collides → no fire.
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  tgt="$td/board"; ran="$td/ran"; : > "$tgt"; : > "$ran"
  MESH_PROMISES_WATCH_LOCK="$td/lk" "$0" --window 4 --debounce 0 "$tgt" -- bash -c "echo fired >> '$ran'" >/dev/null 2>&1 &
  wpid=$!
  sleep 0.4; echo "a new [task] line" >> "$tgt"; sleep 1.2
  kill "$wpid" 2>/dev/null; wait "$wpid" 2>/dev/null || true
  grep -q fired "$ran" || fail "a write to the watched board did NOT fire the wrapped command (event path dead)"
  echo "mesh-promises-watch --test: ok (distinct lock; fsnotify mechanism green; live write→fire proven)"
  exit 0
fi

# Live: run mesh-fsnotify under the promises-specific lock (override-able for the --test live leg).
export MESH_FSNOTIFY_LOCK="${MESH_PROMISES_WATCH_LOCK:-$PROMISES_LOCK}"
exec mesh-fsnotify "$@"
