#!/usr/bin/env python3
# reflex-cadence: 37 6 * * *
# reflex-args: --audit
# mesh-safe-open — the ACTUATOR for CLAUDE.md's stub-write-follows-a-symlink hazard.
#
# THE HAZARD (memory a-stub-write-follows-a-symlink-into-the-real-tool, measured 2026-08-19):
#   a `--test` puts the REAL tool on a child's PATH with `ln -sf "$real" "$tmp/bin/$name"`, then later
#   writes a stub to the SAME path with `printf … > "$tmp/bin/$name"`. The redirect does not replace
#   the link — it FOLLOWS it and truncates the genome file. It truncated scripts/mesh-song-verify to
#   130 bytes mid-run, and every leg after that asserted against the stub while its FAIL text quoted
#   the real tool. Until now the ONLY defence was a convention ("rm -f before every write"), i.e. a
#   safety knob named in prose: nothing enforces it and nothing detects a site that forgot.
#
# THE CAPABILITY (discover 2026-08-20 {#1fa56542}, CONFIRMED by health via an independent harness):
#   openat2(2) — syscall 437, live as uid 1000 on this kernel, no root / chroot / mount-ns / Landlock —
#   carries an `open_how.resolve` field that is a PER-OPEN PATH-RESOLUTION SANDBOX enforced during
#   lookup. The discriminator is entirely INSIDE the syscall: neither the path string nor the file mode
#   predicts escape, only the policy does.
#
# READ THE ERRNO — THREE POLICIES, THREE INVARIANTS, and a caller that collapses them to "denied"
# loses which one tripped (this is the find's own load-bearing point, extended by health's arm 3):
#   RESOLVE_NO_SYMLINKS 0x04 → ELOOP(40)   no symlink component AT ALL, even one staying inside
#   RESOLVE_BENEATH     0x08 → EXDEV(18)   may not leave dirfd (an INSIDE symlink is still allowed)
#   RESOLVE_IN_ROOT     0x10 → ENOENT(2)   unprivileged chroot-equiv: paths are rewritten as if
#                                          dirfd=/, so an escape resolves back to root and is ABSENT
#   BENEATH != no-symlinks. `inlink` is OK under BENEATH and ELOOP under NO_SYMLINKS.
#
# NO SILENT FALLBACK. If openat2 is not wired this exits 2 (honest n/a) and writes NOTHING. It never
# degrades to a plain open(): a "safe" write that quietly wasn't is the exact failure this closes.
#
# Verbs:
#   --write <base> <name>   stdin → base/name under NO_SYMLINKS|BENEATH (the stub-bin writer)
#   --read  <base> <name>   base/name → stdout under BENEATH
#   --check <base> <name>   report every policy's verdict + NAMED errno; decides nothing
#   --audit [dir]           STATIC sweep: shell sites that write through a path they symlinked
#   --test
# Not claimed: RESOLVE_NO_MAGICLINKS / NO_XDEV untested; single-fs only; the phaedra/Android arm of
# the find is unmeasured.

import ctypes, os, struct, errno, sys, re, glob, tempfile, shutil, subprocess

SYS_openat2 = 437
O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC, O_PATH = 0, 1, 0o100, 0o1000, 0o10000000
RESOLVE_NO_SYMLINKS, RESOLVE_BENEATH, RESOLVE_IN_ROOT = 0x04, 0x08, 0x10
POLICIES = [("NO_SYMLINKS", RESOLVE_NO_SYMLINKS, "no symlink component at all"),
            ("BENEATH",     RESOLVE_BENEATH,     "may not leave the base dir"),
            ("IN_ROOT",     RESOLVE_IN_ROOT,     "base dir acts as /")]
# The errno each policy raises on ITS OWN invariant. Kept as data so --check can say WHICH tripped.
EXPECT = {"NO_SYMLINKS": errno.ELOOP, "BENEATH": errno.EXDEV, "IN_ROOT": errno.ENOENT}

_libc = ctypes.CDLL("libc.so.6", use_errno=True)

def openat2(dirfd, path, flags, mode, resolve):
    how = ctypes.create_string_buffer(struct.pack("QQQ", flags, mode, resolve), 24)
    ctypes.set_errno(0)
    r = _libc.syscall(SYS_openat2, ctypes.c_int(dirfd), ctypes.c_char_p(path.encode()),
                      ctypes.c_void_p(ctypes.addressof(how)), ctypes.c_size_t(24))
    return r, ctypes.get_errno()

def ename(e):
    return errno.errorcode.get(e, str(e))

def wired():
    """Is openat2 actually usable here? Probe by ATTEMPTING it, never by uname/version."""
    if os.environ.get("MESH_SAFE_OPEN_FORCE_NA") == "1":
        return False           # test-only: lets --test drive the absent-organ branch on a node where
                               # the syscall works. It can only make the tool REFUSE, never bypass.
    fd, e = openat2(-100, ".", O_RDONLY | O_PATH, 0, 0)
    if fd >= 0:
        os.close(fd); return True
    return e not in (errno.ENOSYS, errno.EPERM)

def _basefd(base):
    try:
        return os.open(base, O_RDONLY | O_PATH)
    except OSError as ex:
        sys.stderr.write("[safe-open] base dir unopenable: %s: %s\n" % (base, ex.strerror)); sys.exit(1)

def _guard():
    if not wired():
        sys.stderr.write("[safe-open] n/a: openat2(437) not wired here — refusing to fall back to a "
                         "plain open(); a 'safe' write that quietly wasn't is the failure this closes\n")
        sys.exit(2)

def do_write(base, name):
    _guard()
    data = sys.stdin.buffer.read()
    dfd = _basefd(base)
    resolve = RESOLVE_NO_SYMLINKS | RESOLVE_BENEATH
    fd, e = openat2(dfd, name, O_WRONLY | O_CREAT | O_TRUNC, 0o600, resolve)
    os.close(dfd)
    if fd < 0:
        why = ("the target (or a component) is a SYMLINK — writing it would follow the link OUT of %s "
               "and truncate whatever it points at" % base) if e == errno.ELOOP else \
              ("the path escapes %s" % base) if e == errno.EXDEV else "refused"
        sys.stderr.write("[safe-open] REFUSED write %s/%s under NO_SYMLINKS|BENEATH: %s(%d) — %s\n"
                         % (base, name, ename(e), e, why))
        sys.exit(1)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    return 0

def do_read(base, name):
    _guard()
    dfd = _basefd(base)
    fd, e = openat2(dfd, name, O_RDONLY, 0, RESOLVE_BENEATH)
    os.close(dfd)
    if fd < 0:
        sys.stderr.write("[safe-open] REFUSED read %s/%s under BENEATH: %s(%d)\n" % (base, name, ename(e), e))
        sys.exit(1)
    with os.fdopen(fd, "rb") as f:
        sys.stdout.buffer.write(f.read())
    return 0

def do_check(base, name):
    _guard()
    dfd = _basefd(base)
    print("[safe-open:check] %s/%s" % (base, name))
    rc = 0
    for label, flag, what in POLICIES:
        fd, e = openat2(dfd, name, O_RDONLY, 0, flag)
        if fd >= 0:
            os.close(fd); print("  %-12s ALLOW              (%s)" % (label, what))
        else:
            mark = "" if e == EXPECT[label] else "  <- NOT this policy's own invariant"
            print("  %-12s REFUSE %-7s(%2d) (%s)%s" % (label, ename(e), e, what, mark))
            rc = 1
    os.close(dfd)
    print("  errnos are NOT interchangeable: ELOOP=a symlink existed · EXDEV=the path left the base · "
          "ENOENT=rewritten to root and absent")
    return rc

# ---- static sweep: shell sites that write THROUGH a path they themselves symlinked ----------------
_LN  = re.compile(r'\bln\s+-s\w*\s+\S+\s+("?\$[A-Za-z_{}]+[^"\s]*")')
_RM  = re.compile(r'\brm\s+-\w*f\w*\s+("?\$[A-Za-z_{}]+[^"\s]*")')
_WR  = re.compile(r'>\s*("?\$[A-Za-z_{}]+[^"\s]*")')

def _norm(tok):
    return tok.strip('"').strip("'")

def audit(root):
    hits = []
    files = sorted(f for f in glob.glob(os.path.join(root, "*")) if os.path.isfile(f))
    for path in files:
        try:
            lines = open(path, "r", errors="replace").read().splitlines()
        except OSError:
            continue
        if not lines or "sh" not in lines[0]:
            continue
        linked = {}                                   # target -> line no of the ln -s
        for i, ln in enumerate(lines, 1):
            for m in _LN.finditer(ln):
                linked[_norm(m.group(1))] = i
            for m in _RM.finditer(ln):
                linked.pop(_norm(m.group(1)), None)   # cleared: a later write is safe
            for m in _WR.finditer(ln):
                t = _norm(m.group(1))
                if t in linked and _RM.search(ln) is None:
                    hits.append((os.path.basename(path), linked[t], i, t))
                    linked.pop(t, None)               # report each site once
    for f, li, wi, t in hits:
        print("[safe-open:audit] %s: %s symlinked at line %d is WRITTEN THROUGH at line %d — the "
              "redirect follows the link and truncates the target" % (f, t, li, wi))
    print("[safe-open:audit] %d file(s) swept, %d unguarded write-through-symlink site(s)"
          % (len(files), len(hits)))
    return 1 if hits else 0

# ---- test ----------------------------------------------------------------------------------------
def _fixture():
    base = tempfile.mkdtemp(prefix="safeopen-"); outside = tempfile.mkdtemp(prefix="safeopen-out-")
    open(os.path.join(base, "real.txt"), "w").write("INSIDE")
    open(os.path.join(outside, "secret.txt"), "w").write("OUTSIDE-SECRET")
    os.symlink(os.path.join(outside, "secret.txt"), os.path.join(base, "escape"))
    os.symlink("../" + os.path.basename(outside) + "/secret.txt", os.path.join(base, "escape_rel"))
    os.symlink("real.txt", os.path.join(base, "inlink"))
    return base, outside

def test():
    fails = []
    def bad(m): fails.append(m); print("  FAIL: " + m)
    if not wired():
        print("smoke-test: n/a — openat2(437) not wired on this node (the tool is sound, the organ is absent)")
        return 2
    base, outside = _fixture()
    try:
        dfd = os.open(base, O_RDONLY | O_PATH)
        def op(nm, res):
            fd, e = openat2(dfd, nm, O_RDONLY, 0, res)
            if fd >= 0:
                d = os.read(fd, 64); os.close(fd); return ("OK", d)
            return ("DENIED", e)

        # 1. THE CONTROL MUST LEAK. If resolve=0 did not escape, every arm below would be asserting
        #    against a hazard that does not exist here — the sandbox would be free.
        for nm in ("escape", "escape_rel"):
            st, d = op(nm, 0)
            if st != "OK" or b"OUTSIDE-SECRET" not in d:
                bad("control resolve=0 did not leak via %s (%r) — without a live escape every arm "
                    "below is vacuous" % (nm, d))

        # 2. THE THREE INVARIANTS, EACH BY ITS OWN ERRNO. Collapsing any two of these to "denied"
        #    loses which one tripped — the find's load-bearing point.
        for pol, flag, _w in POLICIES:
            for nm in ("escape", "escape_rel"):
                st, e = op(nm, flag)
                if st != "DENIED":
                    bad("%s allowed the escape %s — the sandbox is not enforcing" % (pol, nm))
                elif e != EXPECT[pol]:
                    bad("%s refused %s with %s(%d), expected %s — the errno table is wrong, and a "
                        "caller reading it would name the wrong invariant"
                        % (pol, nm, ename(e), e, ename(EXPECT[pol])))
            st, _ = op("real.txt", flag)
            if st != "OK":
                bad("%s refused a plain non-symlink file — the policy is over-tight" % pol)

        # 3. BENEATH != NO_SYMLINKS. One in-staying symlink separates them; if this ever collapses,
        #    the two policies are interchangeable and choosing between them stops meaning anything.
        st_b, _ = op("inlink", RESOLVE_BENEATH)
        st_n, e_n = op("inlink", RESOLVE_NO_SYMLINKS)
        if st_b != "OK":
            bad("BENEATH refused an INSIDE symlink — it is not 'no symlinks', it is 'do not leave'")
        if st_n != "DENIED" or e_n != errno.ELOOP:
            bad("NO_SYMLINKS allowed an INSIDE symlink (%s) — then it is just BENEATH" % st_n)
        os.close(dfd)

        # 4. THE FOUNDING CASE, END TO END. A stub-bin whose entry is a symlink to a 'genome' file:
        #    the shell redirect TRUNCATES the genome; --write REFUSES with ELOOP and leaves it whole.
        tmp = tempfile.mkdtemp(prefix="safeopen-fc-")
        binp = os.path.join(tmp, "bin"); os.makedirs(binp)
        genome = os.path.join(tmp, "mesh-song-verify")
        original = "#!/bin/sh\n# the real tool, 400 bytes of it\n" + ("x" * 400) + "\n"
        open(genome, "w").write(original)
        os.symlink(genome, os.path.join(binp, "mesh-song-verify"))
        subprocess.run(["sh", "-c", 'printf "#!/bin/sh\\nexit 0\\n" > "$1/mesh-song-verify"', "_", binp],
                       check=True)
        if open(genome).read() == original:
            bad("the shell redirect did NOT truncate through the symlink — the hazard this tool "
                "exists for is not reproducing, so the arm below proves nothing")
        open(genome, "w").write(original)                     # restore, then try it the safe way
        r = subprocess.run([sys.executable, os.path.abspath(__file__), "--write", binp,
                            "mesh-song-verify"], input=b"#!/bin/sh\nexit 0\n", capture_output=True)
        if r.returncode == 0:
            bad("--write ACCEPTED a write through a symlink — the actuator is not actuating")
        if b"ELOOP" not in r.stderr:
            bad("--write refused but did not NAME the invariant (stderr=%r)" % r.stderr[:120])
        if open(genome).read() != original:
            bad("--write refused yet the genome file changed (%d bytes) — it wrote before checking"
                % len(open(genome).read()))
        shutil.rmtree(tmp, ignore_errors=True)

        # 5. …and it must still WRITE. A refuser that refuses everything passes arm 4 for free.
        r = subprocess.run([sys.executable, os.path.abspath(__file__), "--write", base, "plain.txt"],
                           input=b"hello", capture_output=True)
        if r.returncode != 0 or open(os.path.join(base, "plain.txt")).read() != "hello":
            bad("--write refused an ORDINARY write (rc=%d, stderr=%r) — the guard is a brick"
                % (r.returncode, r.stderr[:120]))

        # 5b. THE ABSENT-ORGAN BRANCH. Where openat2 is missing the tool must exit 2 and write
        #     NOTHING — never degrade to a plain open(). Without this arm that branch is unreachable
        #     on a node where the syscall works, and a `return` in place of the exit survives silently
        #     (measured: it did).
        na = os.path.join(base, "na-probe.txt")
        env = dict(os.environ, MESH_SAFE_OPEN_FORCE_NA="1")
        r = subprocess.run([sys.executable, os.path.abspath(__file__), "--write", base, "na-probe.txt"],
                           input=b"must-not-land", capture_output=True, env=env)
        if r.returncode != 2:
            bad("with openat2 absent --write exited %d, must be 2 (honest n/a)" % r.returncode)
        if os.path.exists(na):
            bad("with openat2 absent --write CREATED %s — it fell back to a plain open(), which is "
                "the silent-fallback this tool exists to refuse" % na)

        # 6. --audit must FIRE on the founding pattern and stay QUIET once rm -f guards it. A sweep
        #    that finds nothing on a planted positive is a green light with no lamp behind it.
        ad = tempfile.mkdtemp(prefix="safeopen-audit-")
        open(os.path.join(ad, "bad-tool"), "w").write(
            '#!/usr/bin/env bash\nln -sf "$real" "$tmp/bin/mesh-x"\nprintf stub > "$tmp/bin/mesh-x"\n')
        open(os.path.join(ad, "good-tool"), "w").write(
            '#!/usr/bin/env bash\nln -sf "$real" "$tmp/bin/mesh-x"\nrm -f "$tmp/bin/mesh-x"\n'
            'printf stub > "$tmp/bin/mesh-x"\n')
        out = subprocess.run([sys.executable, os.path.abspath(__file__), "--audit", ad],
                             capture_output=True, text=True).stdout
        if "bad-tool" not in out:
            bad("--audit missed the planted unguarded write-through-symlink site")
        if "good-tool" in out:
            bad("--audit flagged a site that DOES rm -f first — a false positive makes the sweep noise")
        shutil.rmtree(ad, ignore_errors=True)
    finally:
        shutil.rmtree(base, ignore_errors=True); shutil.rmtree(outside, ignore_errors=True)

    if fails:
        print("smoke-test: FAIL (%d)" % len(fails)); return 1
    print("smoke-test: ok (control-leaks + 3 policies x 2 escapes by their OWN errno + beneath!=no-symlinks"
          " + founding-case truncate-vs-refuse + a real write still lands + absent-organ exits 2 writing nothing + audit fires and stays quiet)")
    return 0

def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        sys.stderr.write(__doc__ or "")
        sys.stderr.write("usage: mesh-safe-open --write|--read|--check <base> <name> | --audit [dir] | --test\n")
        return 2
    v = a[0]
    if v == "--test":  return test()
    if v == "--audit": return audit(a[1] if len(a) > 1 else os.path.join(os.path.dirname(
                                    os.path.abspath(__file__))))
    if v in ("--write", "--read", "--check"):
        if len(a) != 3:
            sys.stderr.write("usage: mesh-safe-open %s <base> <name>\n" % v); return 2
        return {"--write": do_write, "--read": do_read, "--check": do_check}[v](a[1], a[2])
    sys.stderr.write("unknown verb %s\n" % v); return 2

if __name__ == "__main__":
    sys.exit(main())
