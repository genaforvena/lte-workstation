#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.nic-rx-loss.state 900 sys
# mesh-nic-rx-loss — NIC receive-path loss sense.
#
# The kernel exposes two hardware/driver counters that no existing mesh sense reads:
#   rx_missed_errors — packets the device could not deliver to the host
#   rx_errors        — receive errors reported by the driver
# This sense measures their monotonic deltas over a real interval and keeps the axes
# separate. MISSED, DRIVER_ERRORS, and BOTH are different joint observations; CLEAN is
# only emitted after both live counters were read and did not move. A counter reset or
# an unreadable interface is UNKNOWN (exit 2), never a fabricated zero.
#
# Usage: mesh-nic-rx-loss [--json|--edge|--test]
set -uo pipefail

ROOT="${MESH_NIC_STATS_ROOT:-/sys/class/net}"
ROOT2="${MESH_NIC_STATS_ROOT2:-$ROOT}"
STATE="${MESH_NIC_STATE:-${HOME:-/root}/.mesh/.nic-rx-loss.state}"
INTERVAL="${MESH_NIC_INTERVAL:-1}"

read_totals() {
  local root="$1" d m e count=0
  local missed=0 errors=0
  [ -d "$root" ] || return 2
  shopt -s nullglob
  for d in "$root"/*/statistics; do
    [ -r "$d/rx_missed_errors" ] && [ -r "$d/rx_errors" ] || continue
    m="$(cat "$d/rx_missed_errors" 2>/dev/null)" || continue
    e="$(cat "$d/rx_errors" 2>/dev/null)" || continue
    case "$m:$e" in *[!0-9:]*|:*) continue ;; esac
    missed=$((missed + m)); errors=$((errors + e)); count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  printf '%s %s %s\n' "$missed" "$errors" "$count"
}

classify() {
  local missed="$1" errors="$2"
  if [ "$missed" -gt 0 ] && [ "$errors" -gt 0 ]; then echo BOTH
  elif [ "$missed" -gt 0 ]; then echo MISSED
  elif [ "$errors" -gt 0 ]; then echo DRIVER_ERRORS
  else echo CLEAN
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/before/enx0/statistics" "$td/after/enx0/statistics"
  printf '0\n' >"$td/before/enx0/statistics/rx_missed_errors"
  printf '4\n' >"$td/before/enx0/statistics/rx_errors"
  printf '3\n' >"$td/after/enx0/statistics/rx_missed_errors"
  printf '9\n' >"$td/after/enx0/statistics/rx_errors"
  b="$(read_totals "$td/before")" || { echo "smoke-test: FAIL (fixture before unreadable)"; exit 1; }
  a="$(read_totals "$td/after")" || { echo "smoke-test: FAIL (fixture after unreadable)"; exit 1; }
  [ "$(classify 3 5)" = BOTH ] || { echo "smoke-test: FAIL (BOTH classifier)"; exit 1; }
  [ "$(classify 3 0)" = MISSED ] || { echo "smoke-test: FAIL (MISSED classifier)"; exit 1; }
  [ "$(classify 0 5)" = DRIVER_ERRORS ] || { echo "smoke-test: FAIL (DRIVER_ERRORS classifier)"; exit 1; }
  [ "$(classify 0 0)" = CLEAN ] || { echo "smoke-test: FAIL (CLEAN classifier)"; exit 1; }
  [ "$(read_totals "$td/no-such")" ] 2>/dev/null && { echo "smoke-test: FAIL (missing root read as success)"; exit 1; }
  live="$(read_totals "$ROOT")" || { echo "smoke-test: n/a (no readable live NIC receive counters)"; exit 2; }
  echo "smoke-test: ok (classifier + honest missing-root gate + REAL NIC read: $live)"
  exit 0
fi

before="$(read_totals "$ROOT")" || { echo "mesh-nic-rx-loss: UNKNOWN — no readable NIC receive counters under $ROOT" >&2; exit 2; }
if [ "$ROOT2" = "$ROOT" ]; then sleep "$INTERVAL"; fi
after="$(read_totals "$ROOT2")" || { echo "mesh-nic-rx-loss: UNKNOWN — second NIC receive read failed under $ROOT2" >&2; exit 2; }
read -r bmiss berr bcount <<<"$before"
read -r amiss aerr acount <<<"$after"
if [ "$amiss" -lt "$bmiss" ] || [ "$aerr" -lt "$berr" ]; then
  echo "mesh-nic-rx-loss: UNKNOWN — receive counter reset during interval" >&2
  exit 2
fi
missed=$((amiss - bmiss)); errors=$((aerr - berr)); verdict="$(classify "$missed" "$errors")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
old=""
[ -r "$STATE" ] && old="$(sed -n '1s/|.*//p' "$STATE" 2>/dev/null)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
printf '%s|missed=%s|driver_errors=%s|interfaces=%s|ts=%s\n' "$verdict" "$missed" "$errors" "$acount" "$ts" >"$STATE" || {
  echo "mesh-nic-rx-loss: UNKNOWN — could not write state artifact" >&2; exit 1;
}

line="[nic-rx-loss] $verdict — missed=${missed}/s driver-errors=${errors}/s interfaces=${acount} over ${INTERVAL}s"
if [ "${1:-}" = --edge ] && [ "$old" = "$verdict" ]; then exit 0; fi
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","rx_missed_per_s":%s,"rx_errors_per_s":%s,"interfaces":%s,"interval_s":%s,"ts":"%s"}\n' "$verdict" "$missed" "$errors" "$acount" "$INTERVAL" "$ts"
else
  printf '%s\n' "$line"
fi
