#!/usr/bin/env python3
# mesh-wifi-crossval — CROSS-DEVICE wifi-vantage validation (the operator's cross-validation frontier).
#
# Operator 2026-06-19: senses must be harvested from EVERYTHING we reach, and the real value is
# CROSS-validation — a single sensor is weak; sensors that confirm each OTHER across DEVICES are the
# signal. mesh-sense-map INVENTORIES which device has which sense (wifi ×2: IdeaPad + iMac). This tool
# COLLECTS the cross-check: it scans wifi from TWO physically-distinct nodes and proves both organs
# corroborate the same RF landscape — the shared APs (seen by BOTH) are the validation, and the per-AP
# signal-rank agreement between the two vantages is a scale-invariant corroboration score.
#
# Why wifi (not the BLE mesh-presence-fuse): the iMac has NO BLE ("Low Energy Supported: No",
# da19a97) — its real cross-validatable sense is the wifi scan (airport -s). presence-fuse is BLE-only
# and cannot consume it; this is the wifi-vantage peer to it.
#
# Honest-fusion (memory fusion-tools-distinguish-empty-from-failed): an UNREACHABLE vantage is exit 2
# with an explicit "cannot cross-validate" — never a fake all-clear. A genuine zero-overlap (both
# vantages scanned, no shared AP) is a real rc=0 NO-OVERLAP verdict, visibly different from a failure.
#
# Usage:
#   mesh-wifi-crossval            human cross-validation report (local + iMac vantage)
#   mesh-wifi-crossval --json     machine-readable {verdict,shared,agreement,vantages,aps}
#   mesh-wifi-crossval --edge     reflex: post to board ONLY when the verdict FLIPS (a flip =
#                                 a device moved or an organ broke); silent on stable; seeds quietly
#   mesh-wifi-crossval --test     fixture-backed smoke test (no network)
#
# Vantage config (env, with iMac defaults):
#   MESH_WIFI_PEER       peer ssh target for the 2nd vantage   (default ilya@192.168.8.214)
#   MESH_WIFI_PEER_CMD   scan command on the peer              (default macOS airport -s)
#
# Exit: 0 = real cross-validation artifact   2 = a vantage was unreachable (NOT an all-clear)
#
# reflex-cadence: 23 */2 * * *
# reflex-state: $HOME/.mesh/wifi-crossval.state
# reflex-args: --edge
import json, os, re, subprocess, sys, time

# cron-PATH robustness: the --edge reflex runs under cron's bare PATH (/usr/bin:/bin), which omits
# ~/.local/bin → the bare mesh-chat edge-post (a verdict FLIP = a device moved / an organ broke)
# would silently never reach the board. Prepend ~/.local/bin (cron-PATH class — same fix as
# mesh-awaydigest / mesh-sense-map 867cc04).
_LOCALBIN = os.path.expanduser("~/.local/bin")
if _LOCALBIN not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = _LOCALBIN + os.pathsep + os.environ.get("PATH", "")
os.environ["MESH_WHO"] = f"mesh-wifi-crossval@{os.uname().nodename}"

STATE = os.path.expanduser("~/.mesh/wifi-crossval.state")
PEER = os.environ.get("MESH_WIFI_PEER", "ilya@192.168.8.214")
AIRPORT = "/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport"
PEER_CMD = os.environ.get("MESH_WIFI_PEER_CMD", f"{AIRPORT} -s")
SSH_OPTS = ["-o", "ConnectTimeout=8", "-o", "StrictHostKeyChecking=no",
            "-o", "BatchMode=yes"]

# 3rd vantage (wifi-3rd-vantage 2026-06-26, discover→health→genome baton): default-string's USB-wifi
# adapter is a PROVEN distinct RSSI anchor (health 17:07: MTSRouter_904F ds=55 vs IdeaPad=22, Δ33; 5
# shared anchors, real positional discrimination). It ENRICHES the cross-validation with a 3rd
# corroborating organ but does NOT change the primary IdeaPad↔iMac verdict — a thin, sometimes-offline
# 3rd vantage must never flip the stable 2-vantage verdict (flap-safety; honest-fusion). Env-overridable;
# default-resolves ds via mesh-peer-addr (same convention as mesh-presence-fuse), and silently degrades
# to the exact 2-vantage behaviour where ds is unreachable/unresolved (back-compat on every other node).
PEER2_ENV = os.environ.get("MESH_WIFI_PEER2", "")
PEER2_CMD = os.environ.get("MESH_WIFI_PEER2_CMD", "nmcli -t -f BSSID,SIGNAL,SSID dev wifi list")


def _vantage_pair(peer=None):
    """THE one derivation of "which two boxes is this check between" (local hostname + peer host),
    never a literal node name — this binary runs wherever it's cronned (mesh-home, IdeaPad, ...)
    against whatever MESH_WIFI_PEER points at, so a hardcoded 'IdeaPad<->iMac' mislabels which
    vantage produced the verdict (chat-review wifi-crossval-label-names-a-migrated-vantage).
    `peer` param (default PEER) lets tests probe an override without rebinding the load-time global.
    The peer's HOST half is used, never the login half: a login name is not a node name, and here
    they differ (`ilya@192.168.8.214` dials an address, and `ilya` is separately a tailnet host).
    '|' is stripped because this string is embedded in STATE, whose format splits on the first '|'."""
    peer = PEER if peer is None else peer
    peer_host = peer.split("@", 1)[1] if "@" in peer else peer
    return f"{os.uname().nodename}↔{peer_host}".replace("|", "/")


def _vantage_label(peer=None):
    """Flip-post rendering of the pair. Two renderings of one value (board post + STATE tag) must
    canonicalize on a single derivation, or they drift apart exactly like the dash's copy did."""
    return f"{_vantage_pair(peer)} wifi cross-check"


def _norm_bssid(b):
    return b.replace("\\", "").strip().upper()


def parse_nmcli(text):
    """nmcli -t -f BSSID,SIGNAL,SSID dev wifi list — terse, escapes a field's internal ':' as '\\:'
    so the UNescaped ':' are the field separators. Returns {bssid: (signal_int, ssid)}."""
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        # split on ':' NOT preceded by a backslash
        parts = re.split(r"(?<!\\):", line)
        if len(parts) < 2:
            continue
        bssid = _norm_bssid(parts[0])
        if not re.match(r"^[0-9A-F]{2}(:[0-9A-F]{2}){5}$", bssid):
            continue
        try:
            sig = int(parts[1])
        except ValueError:
            continue
        ssid = parts[2] if len(parts) > 2 else ""
        out[bssid] = (sig, ssid)          # nmcli SIGNAL = 0..100 quality (higher = stronger)
    return out


def parse_airport(text):
    """macOS `airport -s` columnar output: SSID may contain spaces, but a BSSID + RSSI anchor each
    row. Returns {bssid: (rssi_int, ssid)}; rssi is negative dBm (higher/less-negative = stronger)."""
    out = {}
    bssid_re = re.compile(r"\b([0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5})\b\s+(-?\d+)\b")
    for line in text.splitlines():
        if "BSSID" in line and "RSSI" in line:      # header
            continue
        m = bssid_re.search(line)
        if not m:
            continue
        bssid = _norm_bssid(m.group(1))
        try:
            rssi = int(m.group(2))
        except ValueError:
            continue
        ssid = line[:m.start()].strip()
        out[bssid] = (rssi, ssid)
    return out


def rank_agreement(shared, a_sig, b_sig):
    """Scale-invariant corroboration: among the shared APs, for every pair count whether BOTH vantages
    agree which AP is stronger (concordant) or disagree (discordant). agreement = C/(C+D) in [0,1];
    None if <2 shared or all pairs tie. nmcli-0..100 and airport-dBm have different scales, so we
    compare ORDER, not values — independent organs that order the same RF world the same way corroborate."""
    aps = list(shared)
    c = d = 0
    for i in range(len(aps)):
        for j in range(i + 1, len(aps)):
            x, y = aps[i], aps[j]
            da = a_sig[x] - a_sig[y]
            db = b_sig[x] - b_sig[y]
            if da == 0 or db == 0:
                continue
            if (da > 0) == (db > 0):
                c += 1
            else:
                d += 1
    tot = c + d
    return (c / tot) if tot else None


def pair_agreement(a_aps, b_aps):
    """Reusable pairwise corroboration primitive → (shared_count, agreement|None) for two scans.
    The 2-vantage crossval and the 3rd-vantage enrichment both build on this single definition so they
    can never drift apart."""
    shared = set(a_aps) & set(b_aps)
    a_sig = {k: v[0] for k, v in a_aps.items()}
    b_sig = {k: v[0] for k, v in b_aps.items()}
    return len(shared), rank_agreement(shared, a_sig, b_sig)


def third_vantage(local, peer, peer2, min_aps):
    """Pure: ENRICH the 2-vantage crossval with a 3rd anchor (default: ds USB-wifi). Returns the
    additive corroboration fields, or None when peer2 is absent/sparse (honest n/a, never a fabricated
    agreement). Deliberately does NOT touch the primary local↔peer verdict — it adds the local↔peer2 and
    peer↔peer2 pairwise agreements plus the count of APs seen by ALL THREE vantages (the strongest
    triangulation anchors). A 3rd vantage that corroborates BOTH existing organs is the real value
    (sensors that confirm each other across devices)."""
    if not peer2 or len(peer2) < min_aps:
        return None
    s_lp2, a_lp2 = pair_agreement(local, peer2)
    s_pp2, a_pp2 = pair_agreement(peer, peer2)
    shared3 = set(local) & set(peer) & set(peer2)
    return {"vantages": 3, "peer2_total": len(peer2),
            "shared_lp2": s_lp2, "agreement_lp2": round(a_lp2, 2) if a_lp2 is not None else None,
            "shared_pp2": s_pp2, "agreement_pp2": round(a_pp2, 2) if a_pp2 is not None else None,
            "shared_3way": len(shared3)}


def _fmt_ag(a):
    return f"{a:.2f}" if a is not None else "n/a"


def third_summary(tv):
    """Compact one-line tag appended to the 2-vantage summary (STATE/dash/json). Uses ' · ' as the
    separator, NEVER '|' (STATE is 'verdict|summary' split on the first '|'; the edge debounce keys on
    the verdict field only, so enriching the summary can't perturb flip detection)."""
    if not tv:
        return ""
    return (f" · +3rd(ds): {tv['shared_3way']} tri-anchor(s), "
            f"agree local~ds={_fmt_ag(tv['agreement_lp2'])} peer~ds={_fmt_ag(tv['agreement_pp2'])}")


def crossval(local_aps, peer_aps):
    a_sig = {k: v[0] for k, v in local_aps.items()}
    b_sig = {k: v[0] for k, v in peer_aps.items()}
    shared = set(local_aps) & set(peer_aps)
    agree = rank_agreement(shared, a_sig, b_sig)
    if len(shared) >= 2:
        # CROSS-VALIDATED only when both organs see ≥2 common APs AND order them consistently
        verdict = "CROSS-VALIDATED" if (agree is None or agree >= 0.5) else "CONFLICTING"
    elif len(shared) == 1:
        verdict = "PARTIAL"            # one shared AP proves both organs live but no geometry
    else:
        verdict = "NO-OVERLAP"         # both scanned, nothing in common (real, not a failure)
    aps = []
    for b in sorted(shared, key=lambda x: -peer_aps[x][0]):
        aps.append({"bssid": b, "ssid": local_aps[b][1] or peer_aps[b][1],
                    "local_signal": local_aps[b][0], "peer_rssi": peer_aps[b][0]})
    return {"verdict": verdict, "shared": len(shared),
            "agreement": round(agree, 2) if agree is not None else None,
            "local_total": len(local_aps), "peer_total": len(peer_aps), "aps": aps}


UNION_F = os.environ.get("MESH_WIFISCAN_UNION", os.path.expanduser("~/.mesh/.wifiscan-union"))
UNION_TTL = int(os.environ.get("MESH_WIFI_UNION_TTL", "900"))   # ~1.5 wifiscan strides


def parse_union(text):
    """mesh-wifiscan's partial-sweep union artifact (~/.mesh/.wifiscan-union):
    bssid|ssid|freq|signal|last_seen|misses. Returns {bssid: (signal_int, ssid)} —
    the same shape/scale as parse_nmcli (nmcli 0..100 quality)."""
    out = {}
    for line in text.splitlines():
        f = line.rstrip("\n").split("|")
        if len(f) < 6:
            continue
        bssid = _norm_bssid(f[0])
        if not re.match(r"^[0-9A-F]{2}(:[0-9A-F]{2}){5}$", bssid):
            continue
        try:
            sig = int(f[3])
        except ValueError:
            continue
        out[bssid] = (sig, f[1])
    return out


def _union_local(path=None, ttl=None):
    """Local vantage from the wifiscan UNION when FRESH. The associated-STA radio's single rescan is
    a partial channel sweep (a churning 3-10-AP slice of the ~20-AP neighborhood; a live local=1 was
    seen 2026-07-03) — comparing one such slice against the iMac's full airport sweep starved the
    shared-AP overlap into chronic NO-OVERLAP / sparse-UNREACHABLE. The union reconstructs the
    neighborhood over the last ~3 sweeps with ZERO extra radio (this node is the Tailscale exit
    node — radio gentleness is a hard constraint). Stale (> UNION_TTL) or short (< 3 APs) union →
    None, caller falls back to a live scan: never a silently-stale vantage."""
    path = path or UNION_F
    ttl = UNION_TTL if ttl is None else ttl
    try:
        if time.time() - os.path.getmtime(path) > ttl:
            return None
        u = parse_union(open(path).read())
        return u if len(u) >= 3 else None
    except Exception:
        return None


def scan_local():
    u = _union_local()
    if u is not None:
        return u
    try:
        r = subprocess.run(["nmcli", "-t", "-f", "BSSID,SIGNAL,SSID", "dev", "wifi", "list"],
                           capture_output=True, text=True, timeout=25)
        if r.returncode != 0:
            return None
        return parse_nmcli(r.stdout)
    except Exception:
        return None


def _peer_parser():
    """Pick the peer parser from PEER_CMD so the 2nd vantage can be a LINUX node (nmcli), not only a
    macOS box (airport). The agreement metric is scale-invariant (order, not values), so an nmcli-0..100
    peer cross-validates cleanly against the local nmcli scan. Default stays airport for back-compat
    with the macOS-peer default. Lets us route the presence/motion cross-check onto a live Linux peer
    (e.g. default-string) when the iMac is offline — and around the defective BLE presence sense."""
    cmd = PEER_CMD.lower()
    if "nmcli" in cmd:
        return parse_nmcli            # Linux peer (terse BSSID:SIGNAL:SSID)
    return parse_airport              # macOS peer / default (back-compat)


def scan_peer():
    try:
        r = subprocess.run(["ssh", *SSH_OPTS, PEER, PEER_CMD],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        return _peer_parser()(r.stdout)
    except Exception:
        return None


def _resolve_peer2():
    """3rd-vantage ssh target: explicit MESH_WIFI_PEER2, else default-resolve ds via mesh-peer-addr
    (same convention as mesh-presence-fuse's DEFAULT_HOST). Empty → feature OFF (2-vantage). Lazy (not
    at import) so --test/--json never pay the resolve and a node that can't resolve ds just stays
    2-vantage. PEER2_CMD assumes an nmcli peer (ds is Linux); the agreement metric is scale-invariant
    so it cross-validates cleanly against the local nmcli + airport iMac scans."""
    if PEER2_ENV:
        return PEER2_ENV
    try:
        r = subprocess.run([os.path.join(_LOCALBIN, "mesh-peer-addr"), "default-string"],
                           capture_output=True, text=True, timeout=5)
        addr = r.stdout.strip()
        return f"imozerov@{addr}" if addr else ""
    except Exception:
        return ""


def scan_peer2():
    """3rd vantage scan (default ds USB-wifi). None on unset/unreachable → honest 2-vantage degrade,
    never a fabricated anchor. PEER2_CMD is nmcli-terse, so parse_nmcli reads it directly."""
    target = _resolve_peer2()
    if not target:
        return None
    try:
        r = subprocess.run(["ssh", *SSH_OPTS, target, PEER2_CMD],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        return parse_nmcli(r.stdout)
    except Exception:
        return None


def render(res):
    L = []
    v = res["verdict"]
    tv = res.get("third")
    nvant = 3 if tv else 2
    mark = {"CROSS-VALIDATED": "✅", "PARTIAL": "◑", "NO-OVERLAP": "·", "CONFLICTING": "⚠️"}.get(v, "")
    ag = f"{res['agreement']:.2f}" if res["agreement"] is not None else "n/a"
    L.append(f"[wifi-crossval] {mark} {v} — {res['shared']} shared AP(s) across {nvant} vantages "
             f"(local {res['local_total']} / peer {res['peer_total']}), rank-agreement {ag}")
    for a in res["aps"]:
        L.append(f"  {a['bssid']}  {a['ssid'][:22]:<22}  local~{a['local_signal']:<3}  peer {a['peer_rssi']} dBm")
    if not res["aps"]:
        L.append("  (no AP seen by both vantages this scan)")
    if tv:
        L.append(f"  3rd vantage (ds, {tv['peer2_total']} APs): {tv['shared_3way']} tri-anchor(s) seen by ALL three; "
                 f"local~ds agreement {_fmt_ag(tv['agreement_lp2'])} ({tv['shared_lp2']} shared), "
                 f"peer~ds agreement {_fmt_ag(tv['agreement_pp2'])} ({tv['shared_pp2']} shared)")
    return "\n".join(L)


def smoke_test():
    fails = []
    # nmcli terse parse: internal ':' escaped, field-sep ':' not.
    nm = parse_nmcli(r"A8\:63\:7D\:16\:DA\:C3:100:MTSRouter_DAC1" + "\n"
                     r"4A\:53\:FA\:DD\:FC\:97:77:GL-MT3000-765")
    if nm.get("A8:63:7D:16:DA:C3") != (100, "MTSRouter_DAC1") or len(nm) != 2:
        fails.append(f"nmcli-parse: {nm}")
    # union-artifact parse: same dict shape/scale as nmcli; junk lines skipped.
    un = parse_union("AA:BB:CC:DD:EE:01|net1|2412|70|T1|0\n"
                     "AA:BB:CC:DD:EE:02|net2|5180|40|T1|2\n"
                     "junk line\n")
    if un.get("AA:BB:CC:DD:EE:01") != (70, "net1") or len(un) != 2:
        fails.append(f"union-parse: {un}")
    # union freshness/floor gates: fresh+3 APs → used; stale → None; short → None (fallback to live)
    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".union", delete=False) as tf:
        tf.write("AA:BB:CC:DD:EE:01|net1|2412|70|T1|0\n"
                 "AA:BB:CC:DD:EE:02|net2|5180|40|T1|1\n"
                 "AA:BB:CC:DD:EE:03|net3|2462|30|T1|0\n")
        tfp = tf.name
    if not _union_local(tfp, 900):
        fails.append("union-local fresh should be used")
    os.utime(tfp, (1, 1))
    if _union_local(tfp, 900) is not None:
        fails.append("union-local stale must be None")
    with open(tfp, "w") as tf:
        tf.write("AA:BB:CC:DD:EE:01|net1|2412|70|T1|0\n")
    os.utime(tfp, None)
    if _union_local(tfp, 900) is not None:
        fails.append("union-local short (<3 APs) must be None")
    os.unlink(tfp)
    # airport parse: SSID with spaces, negative dBm.
    ap = parse_airport("            SSID BSSID             RSSI CHANNEL\n"
                       "   Wi-Fi 1202 60:a4:4c:26:36:b4 -77  1\n"
                       "GL-MT3000-765 4a:53:fa:dd:fc:97 -46  13")
    if ap.get("60:A4:4C:26:36:B4") != (-77, "Wi-Fi 1202") or ap.get("4A:53:FA:DD:FC:97") != (-46, "GL-MT3000-765"):
        fails.append(f"airport-parse: {ap}")
    # crossval: 2 shared APs, consistent ordering → CROSS-VALIDATED, agreement 1.0
    local = {"AA:AA:AA:AA:AA:AA": (90, "near"), "BB:BB:BB:BB:BB:BB": (40, "far"), "CC:CC:CC:CC:CC:CC": (50, "only-here")}
    peer = {"AA:AA:AA:AA:AA:AA": (-45, "near"), "BB:BB:BB:BB:BB:BB": (-75, "far"), "DD:DD:DD:DD:DD:DD": (-60, "only-there")}
    cv = crossval(local, peer)
    if cv["verdict"] != "CROSS-VALIDATED" or cv["shared"] != 2 or cv["agreement"] != 1.0:
        fails.append(f"crossval-agree: {cv}")
    # conflicting order → CONFLICTING (local says AA>BB, peer says BB>AA)
    peer_conf = {"AA:AA:AA:AA:AA:AA": (-80, "near"), "BB:BB:BB:BB:BB:BB": (-40, "far")}
    cc = crossval({"AA:AA:AA:AA:AA:AA": (90, "n"), "BB:BB:BB:BB:BB:BB": (40, "f")}, peer_conf)
    if cc["verdict"] != "CONFLICTING":
        fails.append(f"crossval-conflict: {cc}")
    # zero overlap is a real verdict, not a crash
    no = crossval({"11:11:11:11:11:11": (50, "a")}, {"22:22:22:22:22:22": (-50, "b")})
    if no["verdict"] != "NO-OVERLAP" or no["shared"] != 0:
        fails.append(f"crossval-nooverlap: {no}")
    # one shared AP → PARTIAL (proves organs, no geometry)
    pt = crossval({"11:11:11:11:11:11": (50, "a")}, {"11:11:11:11:11:11": (-50, "a")})
    if pt["verdict"] != "PARTIAL":
        fails.append(f"crossval-partial: {pt}")
    # plausibility FLOOR (min_aps=3): a sparse/empty vantage → honest UNREACHABLE, never a false verdict
    full_a = {"11:11:11:11:11:11": (50, "a"), "22:22:22:22:22:22": (40, "b"), "33:33:33:33:33:33": (30, "c")}
    full_b = {"44:44:44:44:44:44": (-50, "d"), "55:55:55:55:55:55": (-60, "e"), "66:66:66:66:66:66": (-70, "f")}
    if _decide({}, full_b, 3)[0] != "UNREACHABLE":            # empty peer dict no longer slips through
        fails.append(f"floor-empty-local: {_decide({}, full_b, 3)}")
    if _decide(full_a, {"44:44:44:44:44:44": (-50, "d")}, 3)[0] != "UNREACHABLE":   # sparse peer (1 AP)
        fails.append(f"floor-sparse-peer: {_decide(full_a, {'44:44:44:44:44:44': (-50, 'd')}, 3)}")
    if _decide(None, full_b, 3)[0] != "UNREACHABLE":          # genuine local failure
        fails.append("floor-none-local")
    if _decide(full_a, full_b, 3)[0] != "NO-OVERLAP":         # both plausible, disjoint → real NO-OVERLAP
        fails.append(f"floor-real-nooverlap: {_decide(full_a, full_b, 3)}")
    # DEBOUNCE hysteresis (threshold=2): a flip must persist 2 consecutive runs before it posts
    if _debounce("Y", "", "", 0, 2) != (False, "Y", "", 0):           # first run seeds quietly
        fails.append("debounce-seed")
    if _debounce("X", "X", "", 0, 2) != (False, "X", "", 0):          # unchanged → no flip
        fails.append("debounce-same")
    if _debounce("Y", "X", "", 0, 2) != (False, "X", "Y", 1):         # 1st sighting → pending, no flip
        fails.append("debounce-pend1")
    if _debounce("Y", "X", "Y", 1, 2) != (True, "Y", "", 0):          # 2nd consecutive → commit flip
        fails.append("debounce-commit")
    if _debounce("Z", "X", "Y", 1, 2) != (False, "X", "Z", 1):        # different candidate resets streak
        fails.append("debounce-reset")
    if _debounce("Y", "X", "", 0, 1) != (True, "Y", "", 0):           # threshold=1 → immediate flip
        fails.append("debounce-thresh1")
    # 3rd vantage (wifi-3rd-vantage): pairwise primitive + enrichment, PURE, no network.
    v_local = {"AA:AA:AA:AA:AA:AA": (90, "n"), "BB:BB:BB:BB:BB:BB": (40, "f"), "CC:CC:CC:CC:CC:CC": (50, "c")}
    v_peer  = {"AA:AA:AA:AA:AA:AA": (-45, "n"), "BB:BB:BB:BB:BB:BB": (-75, "f"), "DD:DD:DD:DD:DD:DD": (-60, "d")}
    v_ds    = {"AA:AA:AA:AA:AA:AA": (70, "n"), "BB:BB:BB:BB:BB:BB": (30, "f"), "EE:EE:EE:EE:EE:EE": (20, "e")}
    if pair_agreement(v_local, v_ds) != (2, 1.0):                     # local & ds agree AA>BB → 1.0, 2 shared
        fails.append(f"pair-agreement: {pair_agreement(v_local, v_ds)}")
    tv = third_vantage(v_local, v_peer, v_ds, 3)
    # AA+BB seen by all three → 2 tri-anchors; local~ds and peer~ds both order AA>BB consistently → 1.0
    if not tv or tv["vantages"] != 3 or tv["shared_3way"] != 2 or tv["agreement_lp2"] != 1.0 or tv["agreement_pp2"] != 1.0:
        fails.append(f"third-vantage: {tv}")
    if third_vantage(v_local, v_peer, None, 3) is not None:           # ds absent → honest None (2-vantage)
        fails.append("third-absent")
    if third_vantage(v_local, v_peer, {"AA:AA:AA:AA:AA:AA": (70, "n")}, 3) is not None:   # sparse ds (1<3) → None
        fails.append("third-sparse")
    if third_summary(None) != "":                                    # no 3rd vantage → empty tag (back-compat)
        fails.append("third-summary-empty")
    if "|" in third_summary(tv):                                     # tag MUST NOT contain '|' (STATE separator)
        fails.append("third-summary-pipe")
    # vantage label (chat-review wifi-crossval-label-names-a-migrated-vantage): the flip-post label
    # must name the LIVE pair, never a literal node name baked in at some prior migration.
    lbl = _vantage_label()
    if os.uname().nodename not in lbl:
        fails.append(f"vantage-label-missing-local-host: {lbl}")
    if "IdeaPad" in lbl or "iMac" in lbl:
        fails.append(f"vantage-label-literal-leak: {lbl}")
    lbl2 = _vantage_label("someone@wifi-peer-test.example")
    if "wifi-peer-test.example" not in lbl2:
        fails.append(f"vantage-label-peer-override: {lbl2}")
    if "|" in _vantage_pair("x@a|b"):                      # pair is embedded in STATE (split on '|')
        fails.append("vantage-pair-pipe-leak")

    # ARTIFACT leg: the pair must reach the FILE mesh-dash reads, not just the board post. Source
    # text is never behaviour — this drives the real _edge() write path against a temp STATE with an
    # overridden peer and asserts the bytes on disk name THAT peer. A hardcoded pair (the defect
    # this replaces) leaves the override absent and goes RED here. Peer=None ⇒ UNREACHABLE verdict,
    # so no SSH is issued; a virgin STATE ⇒ first-run seed, so nothing is posted to the board.
    import tempfile as _tf
    _real_state, _real_peer = STATE, PEER
    _td = _tf.mkdtemp(prefix="wifi-crossval-test-")
    try:
        globals()["STATE"] = os.path.join(_td, "wifi-crossval.state")
        globals()["PEER"] = "someone@wifi-peer-test.example"
        try:
            _edge({"AA:AA:AA:AA:AA:AA": (60, "n"), "BB:BB:BB:BB:BB:BB": (70, "n"),
                   "CC:CC:CC:CC:CC:CC": (80, "n")}, None)
        except SystemExit as _se:                          # _edge ends the process (2 = honest n/a)
            if _se.code != 2:
                fails.append(f"state-leg-exit: {_se.code} (UNREACHABLE must exit 2)")
        written = open(globals()["STATE"]).read()
        # Assert the TAG, not merely that the host appears somewhere: the UNREACHABLE summary
        # already prints "peer <PEER> unreachable", so a bare substring check on the peer host
        # passes with the tag deleted entirely (measured — mutant "drop the tag" went green).
        # A gate can be vacuous because a DIFFERENT field happens to agree with it.
        _tag = written.split(" · vantages ", 1)
        if len(_tag) != 2:
            fails.append(f"state-omits-vantage-tag: {written!r}")
        else:
            _pair = _tag[1]
            if "wifi-peer-test.example" not in _pair:      # a hardcoded pair leaks the override
                fails.append(f"state-vantage-tag-not-derived: {_pair!r}")
            if os.uname().nodename not in _pair:
                fails.append(f"state-vantage-tag-missing-local: {_pair!r}")
        if written.split("|", 1)[0] != "UNREACHABLE":       # summary tag must not corrupt the verdict field
            fails.append(f"state-verdict-corrupted: {written!r}")
    except Exception as e:
        fails.append(f"state-vantage-pair-leg: {e}")
    finally:
        globals()["STATE"], globals()["PEER"] = _real_state, _real_peer
        import shutil as _sh; _sh.rmtree(_td, ignore_errors=True)

    if fails:
        print("smoke-test: FAIL (" + "; ".join(fails) + ")"); sys.exit(1)
    print("smoke-test: ok (parse, verdicts, plausibility floor, debounce hysteresis, 3rd-vantage enrichment, STATE names the live vantage pair)"); sys.exit(0)


def _decide(local, peer, min_aps):
    """Pure: map two scans to (verdict, summary), applying the plausibility FLOOR. A vantage that
    returns fewer than `min_aps` APs in a populated band is an UNRELIABLE scan (macOS airport -s
    throttles to a header-only/sparse result; nmcli can return a stale near-empty list) — NOT a real
    RF-empty environment (you always see at least your own AP + neighbours). Honest-fusion: degrade
    such a scan to the UNREACHABLE pseudo-verdict, never let it masquerade as a real NO-OVERLAP /
    PARTIAL / CONFLICTING flip. This is the root fix for the every-run board flap: a sparse peer dict
    (e.g. {}) is not None, so the old `peer is None` guard let it through into crossval → shared=0 →
    false NO-OVERLAP."""
    if local is None:
        return "UNREACHABLE", "local wifi scan failed (no vantage here)"
    if peer is None:
        return "UNREACHABLE", f"peer {PEER} unreachable — only 1 vantage"
    if len(local) < min_aps or len(peer) < min_aps:
        return "UNREACHABLE", (f"sparse scan (local {len(local)}/peer {len(peer)} APs < {min_aps} "
                               f"floor) — unreliable, not RF-empty")
    res = crossval(local, peer)
    ag = f"{res['agreement']:.2f}" if res["agreement"] is not None else "n/a"
    return res["verdict"], f"{res['shared']} shared AP(s), rank-agreement {ag}"


def _debounce(verdict, committed, cand, cnt, threshold):
    """Pure: hysteresis on the verdict flip. A new verdict must persist `threshold` CONSECUTIVE runs
    before it flips the committed state — so a single flaky-scan run never posts a flip to the board
    (the 'Delta channels need --gate' doctrine). Returns (flip, new_committed, new_cand, new_cnt)."""
    if not committed:
        return False, verdict, "", 0          # first run: seed committed quietly, no post
    if verdict == committed:
        return False, committed, "", 0         # settled back on the committed verdict; clear candidate
    cnt = cnt + 1 if verdict == cand else 1     # same pending candidate streak, or a fresh one
    if cnt >= threshold:
        return True, verdict, "", 0            # candidate held long enough → commit the flip
    return False, committed, verdict, cnt       # still pending; committed unchanged


def _edge(local, peer):
    """Reflex: derive a verdict (incl. the UNREACHABLE pseudo-verdict for an absent/unreliable vantage
    — honest, never silent-clear), post to the board ONLY on a DEBOUNCED flip vs the committed state,
    seed the first run quietly. STATE holds the committed (stable) verdict in `verdict|summary` form
    (mesh-dash reads it); the debounce candidate/count live in a `.pending` sidecar."""
    min_aps = int(os.environ.get("MESH_WIFI_MIN_APS", "3"))
    threshold = max(1, int(os.environ.get("MESH_WIFI_DEBOUNCE", "2")))
    pending_path = STATE + ".pending"
    verdict, summary = _decide(local, peer, min_aps)

    # 3rd-vantage enrichment: append ds's corroboration to the SUMMARY field ONLY (never the verdict),
    # so the debounce/flip logic — which keys on the verdict field — is unchanged and a thin/offline ds
    # can't flap the board. Scan ds only on a REAL 2-vantage cycle (verdict != UNREACHABLE) so an
    # already-failed cycle adds no SSH heat. Silent 2-vantage when ds is n/a (third_summary → "").
    if verdict != "UNREACHABLE":
        summary += third_summary(third_vantage(local, peer, scan_peer2(), min_aps))

    # WHICH TWO BOXES — carried in the artifact, for EVERY verdict, because mesh-dash is the only
    # consumer of STATE and it has no other way to know. It used to print a hardcoded
    # "IdeaPad<->iMac"; both named nodes were long gone (IdeaPad last seen 2026-07-19, and there is
    # no iMac on the tailnet at all) while the real pair was mesh-home<->192.168.8.214, so a reader
    # chasing "only 1 vantage" was sent to two boxes that were not participants. The label fix
    # landed in THIS tool and was never swept to its reader — a format fix must sweep every reader.
    # Unconditional: a tag present only in some verdicts is a field older/other rows lack, and the
    # consumer then has to guess whether its absence means "same pair" or "unknown pair".
    summary += f" · vantages {_vantage_pair()}"

    committed = ""
    try:
        committed = open(STATE).read().strip().split("|", 1)[0]
    except Exception:
        pass
    cand, cnt = "", 0
    try:
        c, n = open(pending_path).read().strip().rsplit("|", 1)
        cand, cnt = c, int(n)
    except Exception:
        pass

    flip, new_committed, new_cand, new_cnt = _debounce(verdict, committed, cand, cnt, threshold)

    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        if not committed or flip:            # seed first run, or write the freshly-committed flip
            with open(STATE, "w") as f:
                f.write(f"{verdict}|{summary}")
        elif verdict == committed:
            # reason-refresh: the verdict held but the WHY may have moved (UNREACHABLE for a sparse
            # local scan vs UNREACHABLE for a down peer are different facts). The summary is part of
            # the value consumers read (mesh-dash shows it as the current reason), so a flip-gated
            # write leaves a days-stale wrong reason on the dash. Refresh it in place — same verdict,
            # no board post, debounce untouched. A pending (verdict != committed) run keeps the old
            # content: its summary describes the candidate, not the committed state.
            new_state = f"{verdict}|{summary}"
            try:
                cur_state = open(STATE).read().strip()
            except Exception:
                cur_state = ""
            if cur_state != new_state:
                with open(STATE, "w") as f:
                    f.write(new_state)
        with open(pending_path, "w") as f:
            f.write(f"{new_cand}|{new_cnt}")
    except Exception:
        pass

    # mtime = ran-live (always), content = value-changed (only on flip). Without this, a stably-
    # UNREACHABLE node (peer ilya down for hours) freezes the STATE mtime at the last commit (16h
    # ago in this run), so a reflex-health / dashboard liveness check reads a CRON-firing +
    # smoke-passing + fresh-log + fresh-pending reflex as a FALSE STALE just because the verdict
    # stopped flipping. The .pending sidecar IS touched every run — but the PRIMARY state file
    # is what consumers (mesh-dash, the sensory board) read for liveness, so it must be touched
    # too. Mesh-state-touch is the SHARED liveness primitive (mirrors mesh-net-drop's
    # chat-review/state-touch-adoption fix). --create so a fresh STATE file is created if absent
    # (defensive — should always exist after the seed write above, but the touch is independent).
    try:
        subprocess.run(
            [os.path.join(_LOCALBIN, "mesh-state-touch"), "--create", STATE],
            timeout=5, capture_output=True,
        )
    except Exception:
        # bare touch fallback if mesh-state-touch is unavailable — best-effort, never fatal
        try:
            os.utime(STATE, None)
        except Exception:
            pass

    if flip:
        msg = f"[wifi-crossval] verdict {committed} -> {verdict}: {summary} ({_vantage_label()})"
        try:
            subprocess.run([os.path.join(_LOCALBIN, "mesh-chat"), msg], timeout=10)
        except Exception:
            print(msg)
    # exit 2 only mirrors a genuine unreachable so the reflex's own health is honest
    sys.exit(2 if verdict == "UNREACHABLE" else 0)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        smoke_test()
    if "--edge" in args:
        _local = scan_local()
        _edge(_local, scan_peer() if _local else None)
        return
    local = scan_local()
    if not local:
        print("[wifi-crossval] LOCAL SCAN FAILED — no wifi vantage here (cannot cross-validate, not an all-clear)",
              file=sys.stderr)
        sys.exit(2)
    peer = scan_peer()
    if peer is None:
        print(f"[wifi-crossval] PEER UNREACHABLE ({PEER}) — only 1 vantage, CANNOT cross-validate "
              f"(NOT an all-clear). Local saw {len(local)} AP(s).", file=sys.stderr)
        sys.exit(2)
    res = crossval(local, peer)
    # Attach the 3rd-vantage (ds) enrichment for the on-demand human + --json read. None when ds is
    # unreachable → render/json honestly show 2 vantages (never a fabricated 3rd anchor).
    res["third"] = third_vantage(local, peer, scan_peer2(),
                                 int(os.environ.get("MESH_WIFI_MIN_APS", "3")))
    if "--json" in args:
        res["peer"] = PEER
        print(json.dumps(res, indent=2)); return
    print(render(res))


if __name__ == "__main__":
    main()
