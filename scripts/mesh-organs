#!/usr/bin/env bash
# mesh-organs — a node takes readings from its OWN organs, over time. Telemetry about how the
# organs live: presence + a cheap, SILENT, consent-respecting metric each (no capture, no voice,
# no indicator — liveness/counts only). A node watches ONLY itself and its own organs; the mesh
# never surveils the world or other nodes. $0.
#
#   mesh-organs              one reading -> append JSONL + print human summary
#   mesh-organs --full       also do a short BLE adapter scan (counts only, no identities)
#   mesh-organs --analyze    summarize today's readings: per-organ state + what CHANGED + repairs
#   mesh-organs --loop [s]   periodic reading (default 1800s)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; DIR="$MESH/organs"; mkdir -p "$DIR"
DAY="$(date -u +%F)"; JL="$DIR/$DAY.jsonl"; HOST="$(hostname)"
n(){ printf '%s' "${1:-0}"; }

read_organs(){
  local full="${1:-}"
  local load mem cam micc spkc bt serial brow thermal bose ble reflex crons
  load=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
  mem=$(free -m 2>/dev/null | awk '/Mem:/{print $7}')                      # available MB
  cam=$(ls /dev/video* 2>/dev/null | wc -l)
  micc=$(arecord -l 2>/dev/null | grep -c '^card')
  spkc=$(aplay -l 2>/dev/null | grep -c '^card')
  bt=$(ls /sys/class/bluetooth 2>/dev/null | wc -l)
  serial=$(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | wc -l)
  brow=$(python3 -c 'import playwright' 2>/dev/null && echo true || echo false)
  thermal=$(for z in /sys/class/thermal/thermal_zone*/temp; do cat "$z" 2>/dev/null; done | sort -n | tail -1)
  thermal=$(awk "BEGIN{print ${thermal:-0}/1000}")
  bose=$(lsusb 2>/dev/null | grep -qi bose && echo true || echo false)
  conn=$(mesh-conn --oneline 2>/dev/null | grep -o 'tg=[A-Za-z]* inet=[A-Za-z]* mesh=[A-Za-z]*')
  # reflex organs alive (loop windows in this node's tmux)
  reflex=$(tmux list-windows -t "$HOST" -F '#{window_name}' 2>/dev/null | grep -cE '^(selfcare|chat|snapshot|verifier)$')
  crons=$(crontab -l 2>/dev/null | grep -cE 'mesh-(restore|revive|report|heartbeat|plan)')
  ble=-1
  if [ "$full" = "--full" ] && command -v bluetoothctl >/dev/null 2>&1; then
    timeout 14 bluetoothctl --timeout 12 scan le >/dev/null 2>&1
    ble=$(bluetoothctl devices 2>/dev/null | grep -c '^Device')      # COUNT only, no identities
  fi
  printf '{"t":"%s","host":"%s","load":%s,"mem_avail_mb":%s,"conn":"%s","cameras":%s,"mic_cards":%s,"spk_cards":%s,"bose_spk":%s,"bt_adapters":%s,"ble_seen":%s,"serial":%s,"browser":%s,"thermal_c":%s,"reflex_windows":%s,"reflex_crons":%s}\n' \
    "$(date -u +%FT%H:%M:%SZ)" "$HOST" "$(n "$load")" "$(n "$mem")" "${conn:-?}" "$(n "$cam")" "$(n "$micc")" "$(n "$spkc")" "$bose" "$(n "$bt")" "$(n "$ble")" "$(n "$serial")" "$brow" "$(n "$thermal")" "$(n "$reflex")" "$(n "$crons")"
}

analyze(){
  [ -s "$JL" ] || { echo "no readings yet today ($JL)"; return; }
  local cnt first last; cnt=$(wc -l < "$JL"); first=$(head -1 "$JL"); last=$(tail -1 "$JL")
  echo "=== organ telemetry: $HOST — $DAY ($cnt readings) ==="
  echo "latest:"; echo "$last" | python3 -m json.tool 2>/dev/null | grep -vE '^\{|^\}' | sed 's/[",]//g;s/^ */  /'
  echo "changed since first reading today:"
  python3 - "$first" "$last" <<'PY'
import json,sys
a=json.loads(sys.argv[1]); b=json.loads(sys.argv[2]); ch=0
for k in a:
    if k in ("t","host"): continue
    if a[k]!=b[k]: print(f"  {k}: {a[k]} -> {b[k]}"); ch+=1
print("  (no organ changed)" if not ch else "")
PY
}

case "${1:-}" in
  --analyze) analyze ;;
  --loop) iv="${2:-1800}"; echo "[mesh-organs] reading own organs every ${iv}s on $HOST";
           while true; do read_organs >> "$JL"; sleep "$iv"; done ;;
  ""|--full)
    line="$(read_organs "${1:-}")"; echo "$line" >> "$JL"
    echo "$line" | python3 -m json.tool 2>/dev/null || echo "$line"
    echo "[logged -> $JL]" ;;
  *) echo "usage: mesh-organs [--full|--analyze|--loop [s]]" >&2; exit 1 ;;
esac
