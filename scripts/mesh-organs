#!/usr/bin/env bash
# mesh-organs — unified organ inventory across all lte-node peers.
# Shows senses + actuators (declared + live status) per node.
#
#   mesh-organs                     table: node | senses | actuators | live
#   mesh-organs --json              JSON output
#   mesh-organs --test              smoke test (exit 0 if tools parse)
#   mesh-organs --refresh           force re-fetch from peers (default)
#
# Reads: mesh-card (local) or SSH (remote). Read-only, best-effort.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SSH_OPTS=(-o StrictHostKeyChecking=no -o ConnectTimeout=6 -o BatchMode=yes -o LogLevel=ERROR)
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- peer name normalization ----------------------------------------------
peer_name() {
  case "$1" in
    imozerov-IdeaPad-3-15IIL05) echo "IdeaPad" ;;
    imozerov-Default-string)    echo "default-string" ;;
    "Redmi 10")                 echo "Redmi" ;;
    GL-MT3000)                  echo "router" ;;
    *)                          echo "$1" ;;
  esac
}

peer_user() {
  # registry first: ~/.mesh/nodes carries label:user@ip — topology lives there, not in code
  if [ -f "$HOME/.mesh/nodes" ]; then
    local entry
    entry=$(. "$HOME/.mesh/nodes" 2>/dev/null
            for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$entry" in *@*) echo "${entry%%@*}"; return 0 ;; esac
  fi
  case "$1" in
    Redmi|phone) echo "u0_a386" ;;
    router|GL-MT3000) echo "root" ;;
    ilya) echo "ilya" ;;
    *) echo "${SSH_USER:-$(whoami)}" ;;
  esac
}
peer_port() {
  case "$1" in
    Redmi|phone) echo "8022" ;;
    *) echo "22" ;;
  esac
}

resolve_addr() {
  local peer_name="$1" ts_fallback="$2"
  local addr
  if command -v mesh-peer-addr >/dev/null 2>&1; then
    addr=$(mesh-peer-addr "$peer_name" 2>/dev/null) && { echo "$addr"; return 0; }
  fi
  [ -n "$ts_fallback" ] && { echo "$ts_fallback"; return 0; }
  return 1
}

# --- fetch organ info from a node -----------------------------------------
fetch_remote() {
  local user="$1" ip="$2" port="$3"
  local opts=("${SSH_OPTS[@]}")
  [ "$port" != 22 ] && opts+=(-p "$port")
  ssh "${opts[@]}" "${user}@${ip}" \
'export PATH="$HOME/.local/bin:$PATH";
      c=$(mesh-card 2>/dev/null);
      s=$(echo "$c" | grep "^  senses:" | sed "s/^  senses: //" 2>/dev/null);
      a=$(echo "$c" | grep "^  actuators:" | sed "s/^  actuators: //" 2>/dev/null);
     echo "senses: $s";
     echo "actuators: $a";
     echo "---organs---";
     if command -v mesh-organ-keepalive >/dev/null 2>&1; then
       mesh-organ-keepalive --status 2>/dev/null;
     fi' 2>/dev/null < /dev/null
}

fetch_local() {
  local c
  c=$(mesh-card 2>/dev/null)
  echo "senses: $(echo "$c" | grep "^  senses:" | sed "s/^  senses: //")"
  echo "actuators: $(echo "$c" | grep "^  actuators:" | sed "s/^  actuators: //")"
  echo "---organs---"
  command -v mesh-organ-keepalive >/dev/null 2>&1 && mesh-organ-keepalive --status 2>/dev/null
}

# --- parse organ keepalive status lines ----------------------------------
parse_organ_status() {
  local line="$1"
  local name status
  name=$(echo "$line" | awk '{print $1}')
  status=$(echo "$line" | awk '{print $2}')
  echo "$name|$status"
}

# --- one row --------------------------------------------------------------
print_row() {
  local node="$1" senses="$2" actuators="$3" live="$4" total="$5"
  printf '%-25s %-30s %-25s %s/%s\n' "$node" "$senses" "$actuators" "$live" "$total"
}

# --- main -----------------------------------------------------------------
case "${1:-}" in
  --test)
    command -v mesh-card >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-card)"; exit 1; }
    command -v mesh-organ-keepalive >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-organ-keepalive)"; exit 1; }
    command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
    out=$(fetch_local 2>/dev/null) || { echo "smoke-test: FAIL (fetch_local failed)"; exit 1; }
    echo "$out" | grep -q '^senses:' || { echo "smoke-test: FAIL (no senses row)"; exit 1; }
    echo "$out" | grep -q '^actuators:' || { echo "smoke-test: FAIL (no actuators row)"; exit 1; }
    echo "$out" | grep -q '^---organs---$' || { echo "smoke-test: FAIL (no organ separator)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;
  --json) JSON=1 ;;
  ""|--refresh) JSON=0 ;;
  *) echo "usage: mesh-organs [--json | --refresh | --test]" >&2; exit 1 ;;
esac

# --- gather data ----------------------------------------------------------
RESULTS=()

# self
self_out=$(fetch_local)
self_senses=$(echo "$self_out" | grep "^senses:" | sed 's/^senses: //')
self_actuators=$(echo "$self_out" | grep "^actuators:" | sed 's/^actuators: //')
self_organs=$(echo "$self_out" | sed -n '/^---organs---/,$ p' | tail -n +2)
self_live=0; self_total=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  self_total=$((self_total + 1))
  echo "$line" | grep -q "LIVE" && self_live=$((self_live + 1))
done <<< "$self_organs"
RESULTS+=("$(hostname)|$self_senses|$self_actuators|$self_live|$self_total")

# remote peers
peers_file=$(mktemp)
tailscale status --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
peers = {}
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []):
        host = p.get('HostName','?')
        ip = p['TailscaleIPs'][0]
        online = p.get('Online', False)
        active = p.get('Active', False)
        score = (bool(online), bool(active))
        if host not in peers or score > peers[host][0]:
            peers[host] = (score, ip, online, active)
for host, (_, ip, online, active) in sorted(peers.items()):
    print(f'{host}|{ip}|{online}')
" > "$peers_file"

while IFS='|' read -r host ts_ip online; do
  [ -z "$host" ] && continue
  pname=$(peer_name "$host")
  [ "$pname" = "IdeaPad" ] && continue

  if [ "$online" != "True" ]; then
    RESULTS+=("$host|(offline)|-|0|0")
    continue
  fi

  addr=$(resolve_addr "$pname" "$ts_ip") || { RESULTS+=("$host|(unreachable)|-|0|0"); continue; }
  user=$(peer_user "$pname")
  port=$(peer_port "$pname")

  out=$(fetch_remote "$user" "$addr" "$port") || { RESULTS+=("$host|(ssh fail)|-|0|0"); continue; }
  [ -z "$out" ] && { RESULTS+=("$host|(no response)|-|0|0"); continue; }

  senses=$(echo "$out" | grep "^senses:" | sed 's/^senses: //')
  actuators=$(echo "$out" | grep "^actuators:" | sed 's/^actuators: //')
  [ -z "$senses" ] && [ -z "$actuators" ] && { RESULTS+=("$host|(no data)|-|0|0"); continue; }
  organs=$(echo "$out" | sed -n '/^---organs---/,$ p' | tail -n +2)

  live=0; total=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    total=$((total + 1))
    echo "$line" | grep -q "LIVE" && live=$((live + 1))
  done <<< "$organs"

  RESULTS+=("$host|$senses|$actuators|$live|$total")
done < "$peers_file"
rm -f "$peers_file"

# --- output ---------------------------------------------------------------
if [ "${JSON:-0}" = 1 ]; then
  echo "["
  first=1
  for r in "${RESULTS[@]}"; do
    IFS='|' read -r node senses actuators live total <<< "$r"
    [ "$first" = 0 ] && echo ","
    first=0
    printf '  {"node":"%s","senses":"%s","actuators":"%s","live":%s,"total":%s}' \
      "$node" "$senses" "$actuators" "$live" "$total"
  done
  echo ""
  echo "]"
else
  echo "=== mesh-organs $(ts) ==="
  echo
  print_row "NODE" "SENSES" "ACTUATORS" "LIVE" "TOTAL"
  print_row "-------------------------" "------------------------------" "-------------------------" "-----" "-----"
  for r in "${RESULTS[@]}"; do
    IFS='|' read -r node senses actuators live total <<< "$r"
    print_row "$node" "$senses" "$actuators" "$live" "$total"
  done
fi
