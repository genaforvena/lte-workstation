#!/usr/bin/env bash
# mesh-organs — unified organ inventory across all lte-node peers.
# Shows senses + actuators (declared + live status) per node.
#
#   mesh-organs                     table: node | senses | actuators | live
#   mesh-organs --json              JSON output
#   mesh-organs --test              smoke test (exit 0 if tools parse)
#   mesh-organs --refresh           force re-fetch from peers (default)
#   mesh-organs --align [<peer>]    CAPABILITY GRAPH ALIGNMENT: is this node's capability map the
#                                   SAME map the peer's router uses? Scored over the COMPARABLE CORE
#                                   only, with blind edges reported beside it and sub-classed.
#
# Reads: mesh-card (local) or SSH (remote). Read-only, best-effort.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SSH_OPTS=(-o StrictHostKeyChecking=no -o ConnectTimeout=6 -o BatchMode=yes -o LogLevel=ERROR)
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "mesh-organs: missing dependency: $1" >&2
    return 1
  }
}

# --- peer name normalization ----------------------------------------------
peer_name() {
  case "$1" in
    imozerov-IdeaPad-3-15IIL05) echo "IdeaPad" ;;
    imozerov-Default-string)    echo "default-string" ;;
    "Redmi 10")                 echo "Redmi" ;;
    GL-MT3000)                  echo "router" ;;
    *)                          echo "$1" ;;
  esac
}

peer_user() {
  # registry first: ~/.mesh/nodes carries label:user@ip — topology lives there, not in code
  if [ -f "$HOME/.mesh/nodes" ]; then
    local entry
    entry=$(. "$HOME/.mesh/nodes" 2>/dev/null
            for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$entry" in *@*) echo "${entry%%@*}"; return 0 ;; esac
  fi
  case "$1" in
    Redmi|phone) echo "u0_a380" ;;
    router|GL-MT3000) echo "root" ;;
    ilya) echo "ilya" ;;
    *) echo "${SSH_USER:-$(whoami)}" ;;
  esac
}
peer_port() {
  case "$1" in
    Redmi|phone) echo "8022" ;;
    *) echo "22" ;;
  esac
}

resolve_addr() {
  local peer_name="$1" ts_fallback="$2"
  local addr
  if command -v mesh-peer-addr >/dev/null 2>&1; then
    addr=$(mesh-peer-addr "$peer_name" 2>/dev/null) && { echo "$addr"; return 0; }
  fi
  [ -n "$ts_fallback" ] && { echo "$ts_fallback"; return 0; }
  return 1
}

# --- fetch organ info from a node -----------------------------------------
fetch_remote() {
  local user="$1" ip="$2" port="$3"
  local opts=("${SSH_OPTS[@]}")
  [ "$port" != 22 ] && opts+=(-p "$port")
  ssh "${opts[@]}" "${user}@${ip}" \
'export PATH="$HOME/.local/bin:$PATH";
      command -v mesh-card >/dev/null 2>&1 || { echo "mesh-organs: missing dependency: mesh-card" >&2; exit 1; }
      command -v mesh-organ-keepalive >/dev/null 2>&1 || { echo "mesh-organs: missing dependency: mesh-organ-keepalive" >&2; exit 1; }
      c=$(mesh-card 2>/dev/null);
      s=$(echo "$c" | grep "^  senses:" | sed "s/^  senses: //" 2>/dev/null);
      a=$(echo "$c" | grep "^  actuators:" | sed "s/^  actuators: //" 2>/dev/null);
     echo "senses: $s";
     echo "actuators: $a";
     echo "---organs---";
     if command -v mesh-organ-keepalive >/dev/null 2>&1; then
       mesh-organ-keepalive --status 2>/dev/null;
     fi' 2>/dev/null < /dev/null
}

fetch_local() {
  need_cmd mesh-card || return 1
  need_cmd mesh-organ-keepalive || return 1
  local c
  c=$(mesh-card 2>/dev/null)
  echo "senses: $(echo "$c" | grep "^  senses:" | sed "s/^  senses: //")"
  echo "actuators: $(echo "$c" | grep "^  actuators:" | sed "s/^  actuators: //")"
  echo "---organs---"
  command -v mesh-organ-keepalive >/dev/null 2>&1 && mesh-organ-keepalive --status 2>/dev/null
}

# --- parse organ keepalive status lines ----------------------------------
parse_organ_status() {
  local line="$1"
  local name status
  name=$(echo "$line" | awk '{print $1}')
  status=$(echo "$line" | awk '{print $2}')
  echo "$name|$status"
}

# --- count a node's organ status block → "<live>|<total>|<dark names>" -----
# ONE counter for the self and peer paths (they were duplicated inline and only the count survived —
# the DARK names, the whole point of the pair, were computed nowhere). A status line reads
# "  <host>:<organ> — LIVE|DARK|UPSTREAM-DEGRADED"; the fixture form is "<organ> <STATUS>".
count_organs() {
  local live=0 total=0 dark="" line name
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    total=$((total + 1))
    if echo "$line" | grep -q "LIVE"; then
      live=$((live + 1))
    else
      name="$(parse_organ_status "$line")"; name="${name%%|*}"; name="${name##*:}"
      dark="$dark${dark:+,}$name"
    fi
  done
  printf '%s|%s|%s' "$live" "$total" "$dark"
}

# --- one row --------------------------------------------------------------
# LIVE/TOTAL is rendered as ONE pair with the DARK names beside it: a lost organ now moves LIVE down
# while TOTAL holds (mesh-card's sticky roster), so "12/13 body-motion" is unmissable where the old
# both-shrink "12/12" was invisible (organ-roster-shrink-hides-a-dead-organ, 2026-08-17).
print_row() {
  local node="$1" senses="$2" actuators="$3" livetotal="$4" dark="$5"
  printf '%-25s %-30s %-25s %-11s %s\n' "$node" "$senses" "$actuators" "$livetotal" "$dark"
}

# --- CGA: CAPABILITY GRAPH ALIGNMENT (--align) ----------------------------------
# LIVE LITERATURE (review 2026-08-21, distributed-systems coordination / gossip-CRDT-EC, angle =
#   a concrete METRIC the field measures itself with). Khan, Habiba & Khan, "A Gossip-Enhanced
#   Communication Substrate for Agentic AI", arXiv:2512.03285v1 (2 Dec 2025), Sec 10.3 "Semantic
#   and Relational Consistency Metrics", propose CAPABILITY GRAPH ALIGNMENT — "consistency of agent
#   capability maps gossiped across peers (e.g., which agent can do what task)" — arguing that
#   classical distributed-systems metrics (latency, throughput, set convergence) "fail to capture
#   relational knowledge propagation", a requirement unique to agentic AI.
#
# WHY IT WAS A GAP HERE: every convergence metric this mesh owns measures the BOARD — a G-Set whose
#   elements are lines (mesh-converge's Merkle root + inconsistent window, chat-sync's Jaccard/J‰,
#   causal-stability frontier, PBS t-visibility, AoII). The CAPABILITY map is a different replicated
#   structure and NOBODY compared two nodes' copies of it: mesh-organs builds the fleet map from the
#   CALLING node's own vantage (local mesh-card + one SSH per peer), and mesh-organ then ROUTES on
#   that local map. Two routers can therefore answer `mesh-organ camera` differently, forever, with
#   both maps locally honest and no organ measuring the disagreement.
#
# THE CORRECTION THE PAPER'S ONE-LINE DEFINITION NEEDS (and the reason this is not just a Jaccard):
#   a single agreement number CANNOT separate "we disagree about X" from "one of us cannot SEE X".
#   In a real fleet the second dominates, and the two have opposite remedies. So the score is
#   computed ONLY over the COMPARABLE CORE (nodes both sides could actually read), and blindness is
#   reported BESIDE it, never folded in — the honest-fusion rule, one ring out from
#   an-absence-qualified-by-its-field-reads-as-absence-of-the-fact. A blind edge is then sub-classed,
#   because "blind" hides a repairable fault: STALE-ADDRESS (the blind side's ~/.mesh/nodes names an
#   address that is not the peer's live one) vs UNREACHABLE (the peer really is unreachable).
#   And a node whose key appears in only ONE map is UNPAIRED, not blind and not divergent — a
#   hostname/tailscale-name skew must never render as a capability fault.
#
# Honest-exit contract:  0 = a measurement was produced · 2 = n/a (peer unreadable, or an EMPTY
#   comparable core — never a fabricated 1000permille) · 1 = a real fault.
BLIND_RE='^\('   # mesh-organs renders every non-reading as a parenthesised marker in the senses field

# the hermetic core: two capability-map JSONs -> buckets + CGA per-mille. Pure; no network, no clock.
align_core() { # $1=map-A.json $2=map-B.json $3=label-A $4=label-B
  python3 - "$1" "$2" "$3" "$4" <<'PYALIGN'
import json,sys
def load(path):
    try:
        rows=json.load(open(path))
        if not isinstance(rows,list): return None
    except Exception:
        return None
    m={}
    for r in rows:
        if not isinstance(r,dict): return None
        node=r.get("node","?")
        s=(r.get("senses") or "").strip()
        a=(r.get("actuators") or "").strip()
        blind=s.startswith("(")          # (offline) (ssh fail) (unreachable) (no response) (no data)
        caps=set()
        if not blind:
            for tok in s.split()+(a.split() if a not in ("-","") else []):
                if tok and tok!="-": caps.add(tok)
        m[node]=(blind,caps,s if blind else "")
    return m
A=load(sys.argv[1]); B=load(sys.argv[2]); la,lb=sys.argv[3],sys.argv[4]
if A is None or B is None:
    print("ERR unreadable-map"); sys.exit(2)
agree=[]; differ=[]; blind=[]; unpaired=[]; opaque=[]
inter=0; union=0
for node in sorted(set(A)|set(B)):
    ra=A.get(node); rb=B.get(node)
    if ra is None or rb is None:
        side = la if rb is None else lb
        unpaired.append((node,side)); continue
    ba,ca,ma = ra; bb,cb,mb = rb
    if ba and bb: opaque.append((node,ma,mb)); continue
    if ba or bb:
        blindside, sightedside, marker = (la,lb,ma) if ba else (lb,la,mb)
        blind.append((node,blindside,sightedside,marker)); continue
    inter += len(ca&cb); union += len(ca|cb)
    if ca==cb: agree.append((node,len(ca)))
    else: differ.append((node,sorted(ca-cb),sorted(cb-ca)))
core=len(agree)+len(differ)
cga = -1 if union==0 else (inter*1000)//union
print("CGA %d core=%d agree=%d differ=%d blind=%d unpaired=%d opaque=%d pairs_inter=%d pairs_union=%d"
      % (cga,core,len(agree),len(differ),len(blind),len(unpaired),len(opaque),inter,union))
for n,k in agree:      print("AGREE\t%s\t%d" % (n,k))
for n,ao,bo in differ: print("DIFFER\t%s\t%s: %s\t%s: %s" % (n,la,",".join(ao) or "-",lb,",".join(bo) or "-"))
for n,bs,ss,mk in blind: print("BLIND\t%s\t%s\t%s\t%s" % (n,bs,ss,mk.strip("()").replace(" ","-") or "?"))
for n,s in unpaired:   print("UNPAIRED\t%s\t%s" % (n,s))
for n,ma,mb in opaque: print("OPAQUE\t%s\t%s/%s" % (n,ma.strip("()").replace(" ","-"),mb.strip("()").replace(" ","-")))
PYALIGN
}

# live tailscale address for a node key (empty when unknown) — used ONLY to sub-class a blind edge.
ts_ip_for() {
  tailscale status --json 2>/dev/null | python3 -c "
import json,sys
want=sys.argv[1]
d=json.load(sys.stdin)
# SELF FIRST: a blind edge is most often the peer being blind to US, and this node is in .Self,
# never in .Peer — reading only .Peer renders our own live address as 'not-in-live-tailscale' and
# misclassifies a repairable STALE-ADDRESS as an honest UNREACHABLE (seen, 2026-08-21).
cands=[d.get('Self') or {}]+list((d.get('Peer') or {}).values())
for p in cands:
    if p.get('HostName')==want and p.get('TailscaleIPs'): print(p['TailscaleIPs'][0]); break
" "$1" 2>/dev/null
}

# the registry address a given SIDE holds for a node key ('' = could not read)
registry_addr() { # $1=side-spec ('' = local, else user@ip of the side) $2=node label
  local side="$1" label="$2"
  local snippet="grep -ho \"${label}:[^ \\\"]*\" \"\$HOME/.mesh/nodes\" 2>/dev/null | head -1"
  if [ -z "$side" ]; then
    ( eval "$snippet" )
  else
    ssh "${SSH_OPTS[@]}" "$side" "$snippet" 2>/dev/null </dev/null | head -1
  fi
}

# a blind edge is not one thing: name the repairable case.
blind_cause() { # $1=node-key $2=addr-holder-side ('' local | user@ip) -> "<cause> <detail>"
  local node="$1" side="$2" entry addr live
  entry=$(registry_addr "$side" "$(peer_name "$node")")
  live=$(ts_ip_for "$node")
  addr="${entry#*@}"
  if [ -z "$entry" ]; then echo "UNDETERMINED no-registry-entry"; return 0; fi
  if [ -z "$live" ];  then echo "UNREACHABLE not-in-live-tailscale"; return 0; fi
  if [ "$addr" != "$live" ]; then echo "STALE-ADDRESS registry=$addr live=$live"; return 0; fi
  echo "UNREACHABLE registry-addr-is-current=$addr"
}

# --- main -----------------------------------------------------------------
case "${1:-}" in
  --test)
    for x in mesh-card mesh-organ-keepalive grep sed mktemp chmod cat rm; do
      command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
    done

    tmp=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$tmp"' EXIT
    neg="$tmp/neg"
    pos="$tmp/pos"
    mkdir -p "$neg" "$pos" || { echo "smoke-test: FAIL (mkdir)"; exit 1; }

    for dir in "$neg" "$pos"; do
      ln -s "$(command -v grep)" "$dir/grep" || { echo "smoke-test: FAIL (grep link)"; exit 1; }
      ln -s "$(command -v sed)" "$dir/sed" || { echo "smoke-test: FAIL (sed link)"; exit 1; }
      # fetch_local runs under PATH="$pos"/"$neg" only — the mesh-card stub below uses `cat`, so cat
      # must live in the fixture dir too, else the stub emits nothing → empty senses row (the 9334ad4 bug).
      ln -s "$(command -v cat)" "$dir/cat" || { echo "smoke-test: FAIL (cat link)"; exit 1; }
      cat >"$dir/mesh-organ-keepalive" <<'EOF'
#!/bin/sh
printf '%s\n' 'voice LIVE' 'sight DEAD'
EOF
      chmod +x "$dir/mesh-organ-keepalive" || { echo "smoke-test: FAIL (keepalive chmod)"; exit 1; }
    done
    cat >"$pos/mesh-card" <<'EOF'
#!/bin/sh
cat <<'CARD'
  senses: mic camera
  actuators: notify torch
  ---organs---
  voice LIVE
  sight DEAD
CARD
EOF
    chmod +x "$pos/mesh-card" || { echo "smoke-test: FAIL (card chmod)"; exit 1; }

    if PATH="$neg" fetch_local >/dev/null 2>&1; then
      echo "smoke-test: FAIL (passed without mesh-card)"
      exit 1
    fi

    out=$(PATH="$pos" fetch_local 2>/dev/null) || { echo "smoke-test: FAIL (fixture render failed)"; exit 1; }
    printf '%s\n' "$out" | grep -q '^senses: mic camera$' || { echo "smoke-test: FAIL (bad senses row)"; exit 1; }
    printf '%s\n' "$out" | grep -q '^actuators: notify torch$' || { echo "smoke-test: FAIL (bad actuators row)"; exit 1; }
    printf '%s\n' "$out" | grep -q '^---organs---$' || { echo "smoke-test: FAIL (no organ separator)"; exit 1; }
    printf '%s\n' "$out" | grep -q '^voice LIVE$' || { echo "smoke-test: FAIL (no live organ row)"; exit 1; }
    # --- the LIVE/TOTAL pair must NAME its dark organs (organ-roster-shrink-hides-a-dead-organ) ---
    # A bare count is what hid the find: "12/12" reads identical whether the roster is whole or an
    # organ silently left it. Both real-shaped ("  host:organ — STATUS") and fixture-shaped rows.
    got=$(printf '%s\n' '  mesh-home:mic — LIVE' '  mesh-home:body-motion — DARK' \
                        '  mesh-home:light — UPSTREAM-DEGRADED' | count_organs)
    [ "$got" = "1|3|body-motion,light" ] \
      || { echo "smoke-test: FAIL (count_organs gave '$got', want '1|3|body-motion,light' — the pair must split and NAME the dark organs)"; exit 1; }
    got=$(printf '%s\n' 'voice LIVE' 'sight DEAD' | count_organs)
    [ "$got" = "1|2|sight" ] \
      || { echo "smoke-test: FAIL (count_organs gave '$got' on the fixture form, want '1|2|sight')"; exit 1; }
    # a whole roster names nothing — the DARK column must not cry wolf
    got=$(printf '%s\n' '  h:a — LIVE' '  h:b — LIVE' | count_organs)
    [ "$got" = "2|2|" ] || { echo "smoke-test: FAIL (all-live gave '$got', want '2|2|' — no phantom dark names)"; exit 1; }
    # …and it must be WIRED INTO THE ROW. A grep of $0 for the render line would be vacuous — it
    # matches its own text, and source text is never behaviour. Drive the REAL render instead: a
    # fixture HOME (anchored, not PATH-prepended — :12 re-exports $HOME/.local/bin ahead of any
    # prepend) with a card+keepalive stub and an empty peer list, then read the printed row.
    rhome="$tmp/rhome"; mkdir -p "$rhome/.local/bin"
    cat >"$rhome/.local/bin/mesh-card" <<'EOF'
#!/bin/sh
printf '%s\n' '  senses: mic body-motion light' '  actuators: speaker'
EOF
    cat >"$rhome/.local/bin/mesh-organ-keepalive" <<'EOF'
#!/bin/sh
printf '%s\n' '  h:mic — LIVE' '  h:body-motion — DARK' '  h:light — UPSTREAM-DEGRADED' '  h:speaker — LIVE'
EOF
    printf '#!/bin/sh\necho %s\n' '{"Peer":{}}' >"$rhome/.local/bin/tailscale"
    chmod +x "$rhome/.local/bin"/*
    row=$(HOME="$rhome" bash "$0" --refresh 2>/dev/null | grep -v '^NODE\|^---\|^===\|^$')
    case "$row" in
      *"2/4"*body-motion*light*) ;;
      *) echo "smoke-test: FAIL (rendered row '$row' — must carry 2/4 and NAME body-motion,light; the counter is not wired into print_row)"; exit 1 ;;
    esac
    # --- CGA / --align: the hermetic core (no network, no clock, no durable write) -----------
    # THE CLAIM UNDER TEST: blindness is NOT divergence. A single agreement number over the whole
    # map cannot separate "we disagree about X" from "one of us cannot SEE X", and in a real fleet
    # the second dominates. These assertions pin that separation; break any one and the metric
    # silently returns to the naive Jaccard that libels a perfectly aligned fleet.
    ca="$tmp/cgaA"; cb="$tmp/cgaB"; cc="$tmp/cgaC"; cd_="$tmp/cgaD"
    cat >"$ca" <<'EOF'
[{"node":"mesh-home","senses":"ble camera mic","actuators":"speaker tv","live":5,"total":5,"dark":""},
 {"node":"phaedra","senses":"irq net-vantage","actuators":"tv wireguard-vpn","live":4,"total":4,"dark":""},
 {"node":"Redmi 10","senses":"(ssh fail)","actuators":"-","live":0,"total":0,"dark":""}]
EOF
    cat >"$cb" <<'EOF'
[{"node":"mesh-home","senses":"(ssh fail)","actuators":"-","live":0,"total":0,"dark":""},
 {"node":"phaedra","senses":"irq net-vantage","actuators":"tv wireguard-vpn","live":4,"total":4,"dark":""},
 {"node":"Redmi 10","senses":"(ssh fail)","actuators":"-","live":0,"total":0,"dark":""}]
EOF
    cat >"$cc" <<'EOF'
[{"node":"mesh-home","senses":"ble camera","actuators":"speaker tv","live":4,"total":4,"dark":""},
 {"node":"phaedra","senses":"irq net-vantage","actuators":"tv wireguard-vpn","live":4,"total":4,"dark":""}]
EOF
    cat >"$cd_" <<'EOF'
[{"node":"mesh-home","senses":"(ssh fail)","actuators":"-","live":0,"total":0,"dark":""}]
EOF
    ab=$(align_core "$ca" "$cb" mesh-home phaedra) || { echo "smoke-test: FAIL (align_core A/B errored)"; exit 1; }
    hdr=$(printf '%s\n' "$ab" | grep '^CGA ')
    # (1) a BLIND edge must not touch the score: the core still agrees perfectly
    [ "$hdr" = "CGA 1000 core=1 agree=1 differ=0 blind=1 unpaired=0 opaque=1 pairs_inter=4 pairs_union=4" ] \
      || { echo "smoke-test: FAIL (blind edge changed the score: '$hdr' — a node one side cannot SEE is not a capability difference)"; exit 1; }
    # (2) the blind edge must still be REPORTED, naming which side is blind — a score with no
    #     blind line is the fusion the whole design exists to prevent
    printf '%s\n' "$ab" | grep -q $'^BLIND\tmesh-home\tphaedra\tmesh-home\tssh-fail$' \
      || { echo "smoke-test: FAIL (blind edge not reported with blind-side/sighted-side/marker)"; exit 1; }
    # (3) a REAL capability difference must move the score and be named per-side
    ac=$(align_core "$ca" "$cc" mesh-home phaedra) || { echo "smoke-test: FAIL (align_core A/C errored)"; exit 1; }
    hdr=$(printf '%s\n' "$ac" | grep '^CGA ')
    [ "$hdr" = "CGA 888 core=2 agree=1 differ=1 blind=0 unpaired=1 opaque=0 pairs_inter=8 pairs_union=9" ] \
      || { echo "smoke-test: FAIL (real divergence mis-scored: '$hdr')"; exit 1; }
    printf '%s\n' "$ac" | grep -q $'^DIFFER\tmesh-home\tmesh-home: mic\tphaedra: -$' \
      || { echo "smoke-test: FAIL (DIFFER must name the missing cap on the side that lacks it)"; exit 1; }
    # (4) a key present in only ONE map is UNPAIRED — a hostname/tailscale-name skew must never
    #     render as a capability fault, and must not enter the score
    printf '%s\n' "$ac" | grep -q $'^UNPAIRED\tRedmi 10\tmesh-home$' \
      || { echo "smoke-test: FAIL (one-sided key not reported UNPAIRED, or the space in 'Redmi 10' shifted the tab columns)"; exit 1; }
    # (5) an EMPTY comparable core must render UNKNOWN(-1) — never a fabricated 1000permille
    dd=$(align_core "$cd_" "$cd_" a b) || { echo "smoke-test: FAIL (align_core D errored)"; exit 1; }
    printf '%s\n' "$dd" | grep -q '^CGA -1 core=0 ' \
      || { echo "smoke-test: FAIL (empty comparable core did not render UNKNOWN: '$(printf '%s\n' "$dd" | grep '^CGA ')')"; exit 1; }
    # (6) an unreadable map is n/a (rc 2), never a score
    set +e; align_core "$tmp/nope" "$cb" a b >/dev/null 2>&1; na=$?; set -e
    [ "$na" = 2 ] || { echo "smoke-test: FAIL (unreadable map gave rc=$na, want 2 — a missing map must never yield a score)"; exit 1; }

    echo "smoke-test: ok (mesh-card dependency + fixture render verified; + live/total pair splits and NAMES its dark organs, no phantom names, and a real render prints 2/4 with the dark names; + CGA core: blind!=divergence, real divergence scored, UNPAIRED name-skew, empty core=UNKNOWN, unreadable=n/a)"
    exit 0 ;;
  --align)
    # mesh-organs --align [<peer-hostname>]   CGA against one peer (default: every online lte-node)
    need_cmd python3 || exit 1; need_cmd ssh || exit 1
    ALIGN_JSON=0; case "${3:-}${2:-}" in *--json*) ALIGN_JSON=1 ;; esac
    want=""; case "${2:-}" in ""|--json) ;; *) want="$2" ;; esac
    me=$(hostname)
    lmap=$(mktemp) || { echo "mesh-organs: n/a (mktemp)" >&2; exit 2; }
    pmap=$(mktemp) || { rm -f "$lmap"; echo "mesh-organs: n/a (mktemp)" >&2; exit 2; }
    trap 'rm -f "$lmap" "$pmap"' EXIT
    bash "$0" --json > "$lmap" 2>/dev/null || { echo "mesh-organs: n/a (local map unreadable)" >&2; exit 2; }

    # the peers to compare against: online tag:lte-node, from OUR tailscale view
    plist=$(tailscale status --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []) and p.get('Online') and p.get('TailscaleIPs'):
        print(p.get('HostName','?'), p['TailscaleIPs'][0])
" 2>/dev/null)
    [ -n "$plist" ] || { echo "mesh-organs: n/a (no online tag:lte-node peer to align against)" >&2; exit 2; }

    measured=0; rc_any=2; out_all=""
    while read -r host ts_ip; do
      [ -z "$host" ] && continue
      [ -n "$want" ] && [ "$host" != "$want" ] && continue
      pname=$(peer_name "$host"); [ "$pname" = "IdeaPad" ] && continue
      addr=$(resolve_addr "$pname" "$ts_ip") || continue
      user=$(peer_user "$pname"); port=$(peer_port "$pname")
      popts=("${SSH_OPTS[@]}"); [ "$port" != 22 ] && popts+=(-p "$port")
      if ! ssh "${popts[@]}" "${user}@${addr}" \
           'export PATH="$HOME/.local/bin:$PATH"; command -v mesh-organs >/dev/null 2>&1 || exit 9; mesh-organs --json' \
           > "$pmap" 2>/dev/null </dev/null; then
        out_all="$out_all
=== CGA $me vs $host: n/a (peer map unreadable — no mesh-organs, or unreachable) ==="
        continue
      fi
      core_out=$(align_core "$lmap" "$pmap" "$me" "$host") || {
        out_all="$out_all
=== CGA $me vs $host: n/a (map parse failed) ==="; continue; }
      hdr=$(printf '%s\n' "$core_out" | grep '^CGA ')
      set -- $hdr; cga="$2"
      body=""
      # sub-class every blind edge: "blind" hides a REPAIRABLE fault (stale address) and an honest one
      while IFS=$'\t' read -r _ node bat sat marker; do
        [ -z "$node" ] && continue
        if [ "$bat" = "$me" ]; then cause=$(blind_cause "$node" "")
        else cause=$(blind_cause "$node" "${user}@${addr}"); fi
        body="$body
  BLIND    $node — unseen at $bat (marker: $marker), seen at $sat -> $cause"
      done <<< "$(printf '%s\n' "$core_out" | grep $'^BLIND\t')"
      while IFS=$'\t' read -r _ node a b; do [ -z "$node" ] && continue
        body="$body
  DIFFER   $node — only $a | only $b"; done <<< "$(printf '%s\n' "$core_out" | grep $'^DIFFER\t')"
      while IFS=$'\t' read -r _ node k; do [ -z "$node" ] && continue
        body="$body
  AGREE    $node — $k cap(s), identical"; done <<< "$(printf '%s\n' "$core_out" | grep $'^AGREE\t')"
      while IFS=$'\t' read -r _ node s; do [ -z "$node" ] && continue
        body="$body
  UNPAIRED $node — present only in $s's map (name skew, NOT a capability fault)"; done <<< "$(printf '%s\n' "$core_out" | grep $'^UNPAIRED\t')"
      while IFS=$'\t' read -r _ node m; do [ -z "$node" ] && continue
        body="$body
  OPAQUE   $node — blind at BOTH ($m); excluded from the score"; done <<< "$(printf '%s\n' "$core_out" | grep $'^OPAQUE\t')"

      if [ "$cga" = "-1" ]; then
        verdict="UNKNOWN — the comparable core is EMPTY (no node both sides could read); no score exists"
        rc_this=2
      else
        verdict="cga=${cga}permille over the comparable core"; rc_this=0; measured=1
      fi
      out_all="$out_all
=== CGA $me vs $host ===
  $hdr
  verdict: $verdict$body"
      [ "$rc_this" = 0 ] && rc_any=0
    done <<< "$plist"

    printf '%s\n' "${out_all#
}"
    [ "$measured" = 1 ] || exit 2
    exit 0 ;;
  --json) JSON=1 ;;
  ""|--refresh) JSON=0 ;;
  *) echo "usage: mesh-organs [--json | --refresh | --align [<peer>] | --test]" >&2; exit 1 ;;
esac

# --- gather data ----------------------------------------------------------
RESULTS=()

# self
self_out=$(fetch_local)
self_senses=$(echo "$self_out" | grep "^senses:" | sed 's/^senses: //')
self_actuators=$(echo "$self_out" | grep "^actuators:" | sed 's/^actuators: //')
self_organs=$(echo "$self_out" | sed -n '/^---organs---/,$ p' | tail -n +2)
IFS='|' read -r self_live self_total self_dark <<< "$(printf '%s\n' "$self_organs" | count_organs)"
RESULTS+=("$(hostname)|$self_senses|$self_actuators|$self_live|$self_total|$self_dark")

# remote peers
peers_file=$(mktemp)
tailscale status --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
peers = {}
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []):
        host = p.get('HostName','?')
        ip = p['TailscaleIPs'][0]
        online = p.get('Online', False)
        active = p.get('Active', False)
        score = (bool(online), bool(active))
        if host not in peers or score > peers[host][0]:
            peers[host] = (score, ip, online, active)
for host, (_, ip, online, active) in sorted(peers.items()):
    print(f'{host}|{ip}|{online}')
" > "$peers_file"

while IFS='|' read -r host ts_ip online; do
  [ -z "$host" ] && continue
  pname=$(peer_name "$host")
  [ "$pname" = "IdeaPad" ] && continue

  if [ "$online" != "True" ]; then
    RESULTS+=("$host|(offline)|-|0|0|")
    continue
  fi

  addr=$(resolve_addr "$pname" "$ts_ip") || { RESULTS+=("$host|(unreachable)|-|0|0|"); continue; }
  user=$(peer_user "$pname")
  port=$(peer_port "$pname")

  out=$(fetch_remote "$user" "$addr" "$port") || { RESULTS+=("$host|(ssh fail)|-|0|0|"); continue; }
  [ -z "$out" ] && { RESULTS+=("$host|(no response)|-|0|0|"); continue; }

  senses=$(echo "$out" | grep "^senses:" | sed 's/^senses: //')
  actuators=$(echo "$out" | grep "^actuators:" | sed 's/^actuators: //')
  [ -z "$senses" ] && [ -z "$actuators" ] && { RESULTS+=("$host|(no data)|-|0|0|"); continue; }
  organs=$(echo "$out" | sed -n '/^---organs---/,$ p' | tail -n +2)

  IFS='|' read -r live total dark <<< "$(printf '%s\n' "$organs" | count_organs)"

  RESULTS+=("$host|$senses|$actuators|$live|$total|$dark")
done < "$peers_file"
rm -f "$peers_file"

# --- output ---------------------------------------------------------------
if [ "${JSON:-0}" = 1 ]; then
  echo "["
  first=1
  for r in "${RESULTS[@]}"; do
    IFS='|' read -r node senses actuators live total dark <<< "$r"
    [ "$first" = 0 ] && echo ","
    first=0
    printf '  {"node":"%s","senses":"%s","actuators":"%s","live":%s,"total":%s,"dark":"%s"}' \
      "$node" "$senses" "$actuators" "$live" "$total" "$dark"
  done
  echo ""
  echo "]"
else
  echo "=== mesh-organs $(ts) ==="
  echo
  print_row "NODE" "SENSES" "ACTUATORS" "LIVE/TOTAL" "DARK"
  print_row "-------------------------" "------------------------------" "-------------------------" "-----------" "-----"
  for r in "${RESULTS[@]}"; do
    IFS='|' read -r node senses actuators live total dark <<< "$r"
    print_row "$node" "$senses" "$actuators" "$live/$total" "${dark:-—}"
  done
fi
