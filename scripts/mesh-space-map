#!/usr/bin/env bash
# mesh-space-map — one-command WHERE-IS-EVERYTHING view of the home, by fusing BLE proximity across
# the mesh's BLE-vantage nodes. The buried capability surfaced: mesh-presence-fuse already triangulates
# (each device → the node it's strongest at = its zone), but it needs fiddly user@host args and a
# 2nd live vantage, so nobody ran it. This auto-resolves the peer vantage from ~/.mesh/nodes and
# renders the live map. Read-only (sensing only). More vantages (phone up = a MOBILE vantage) → sharper.
#
#   mesh-space-map            print the live cross-node device map
#   mesh-space-map --peer u@h override the peer BLE vantage
#   mesh-space-map --test     smoke (deps + a peer resolvable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

# Resolve a peer BLE vantage: explicit --peer wins, else the first user@host in MESH_NODES that
# isn't this node and isn't a known no-BT node (router/phaedra/ilya are VMs/appliances w/o BLE).
resolve_peer() {
  [ -n "${1:-}" ] && { echo "$1"; return; }
  local self; self="$(hostname)"
  for tok in ${MESH_NODES:-}; do
    local addr="${tok#*:}"
    case "$tok" in
      ideapad:*|*:local) continue ;;                       # self
      router:*|GL-MT3000:*|phaedra:*|ilya:*) continue ;;   # no BLE adapter
    esac
    case "$addr" in *@*) echo "$addr"; return ;; esac
  done
}

if [ "${1:-}" = --test ]; then
  command -v mesh-presence-fuse >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence-fuse)"; exit 1; }
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  p="$(resolve_peer)"
  [ -n "$p" ] && echo "smoke-test: ok (peer vantage: $p)" || { echo "smoke-test: n/a (no BLE peer vantage in MESH_NODES — single-vantage, map needs >=2)"; exit 2; }
  exit 0
fi

PEER=""
[ "${1:-}" = --peer ] && { PEER="${2:-}"; shift 2 || true; }
PEER="$(resolve_peer "$PEER")"
if [ -z "$PEER" ]; then
  echo "mesh-space-map: no peer BLE vantage found (need >=2 vantages to triangulate a map)." >&2
  echo "  Single-vantage fallback — proximity to $(hostname) only:" >&2
  exec mesh-presence
fi
echo "=== mesh-space-map @ $(date -u +%FT%TZ) — fusing $(hostname) + $PEER ==="
echo "(each device shows the node it's CLOSEST to = its zone; more vantages = sharper)"
echo
exec mesh-presence-fuse "$PEER"
