#!/usr/bin/env bash
# mesh-devto-publish — publish (or draft) a markdown article to dev.to via the API.
# Ready-to-fire: needs only a DEV API key. Reads ~/.mesh/devto.env (DEVTO_API_KEY=...),
# never echoes it. Title/tags/cover come from the article's YAML front-matter.
#
# Usage:
#   mesh-devto-publish <article.md>            # publish (published:true)
#   mesh-devto-publish --draft <article.md>    # create as draft (published:false)
#   mesh-devto-publish --update <id> <article.md>   # PUT over an existing article, PRESERVING its live/draft state
#   mesh-devto-publish --publish --update <id> <article.md>   # force it live
#   mesh-devto-publish --draft --update <id> <article.md>     # force it back to draft
#   mesh-devto-publish --list                  # list my articles + drafts with their ids
#   mesh-devto-publish --list --dupes          # report LIVE byte-identical duplicates (exit 1 if any)
#   mesh-devto-publish --list --dupes --all    # ...also count drafts (audits the retention)
#   mesh-devto-publish --check                 # report readiness (key present? api reachable?)
#
# DUPLICATE GUARD (2026-09-23). dev.to has NO upsert: every POST mints a new article with a new
# URL, and its only server-side guard is a 5-minute same-title window — which an edited title
# sails past. That combination left 14 byte-identical LIVE duplicates across 4 titles on this
# account (5x the voice-path piece, 4x LoRA, 3x "written by an agent", 2x the credit-limit
# piece), with reader comments fragmented across the copies: three readers' remarks sat on
# copies no reader reaches. So the tool now does the upsert ITSELF: on POST it first GETs
# /articles/me/all and, if an existing article already has this exact title, it PUTs to that id
# instead of posting a second one. Pass --new to force a genuine second copy (a deliberate
# repost); that is the one way past the guard and it is the operator's explicit choice, never a
# default.
#
# --update PRESERVES the article's current published state when NEITHER --publish NOR --draft is
# given (it GETs the article first). This closes the OPEN item that used to sit here: an option's
# default must never be the one action you cannot undo. Pass --publish to force it live, --draft
# to force it back. Both are explicit precisely because --update used to silently publish
# (2026-07-15: revised staged draft 4145984 with a bare --update, put it LIVE for ~40s, and the
# temp-slug URL recorded on the board died permanently in those 40s).
#
# The 2026-09-23 cleanup unpublished those superseded copies rather than deleting them — dev.to
# has no merge API and their URLs had to stay recoverable — so `--list --dupes` reads /published
# only: a reader can only land on a LIVE article, and a second LIVE copy is the accident the
# guard exists to report. `--all` restores the whole-account view to audit the retention itself.
#
# LEADING BLOCKQUOTES ARE STRIPPED from the body (the `> internal note` convention) — see the
# re.sub below. That is deliberate for editorial scaffolding, but it eats ANY leading blockquote,
# including a real one: a companion link parked at the top of a draft never reached dev.to and
# the piece shipped referring to "the last piece" with no link (2026-07-15). If a blockquote is
# FOR THE READER, put it after the first paragraph, not at the top.
#
# orphan-ok: on-demand publication tool driven by the pub channel.
set -uo pipefail
ENVF="${MESH_DEVTO_ENV:-$HOME/.mesh/devto.env}"
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

api_reachable() { curl -s -o /dev/null -w '%{http_code}' --max-time 12 "https://dev.to/api/articles?per_page=1"; }

if [ "${1:-}" = "--check" ]; then
  echo -n "dev.to API: "; code=$(api_reachable); [ "$code" = 200 ] && echo "reachable (200)" || echo "UNREACHABLE ($code)"
  if [ -f "$ENVF" ] && grep -q '^DEVTO_API_KEY=' "$ENVF" 2>/dev/null; then echo "API key: present ($ENVF)"; else echo "API key: MISSING — put DEVTO_API_KEY=<key> in $ENVF"; fi
  exit 0
fi

PUBLISHED=""      # "" = preserve (GET first); --publish -> true; --draft -> false
UPDATE_ID=""
LIST=0
DUPES=0
ALL=0
FORCE_NEW=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list)    LIST=1; shift ;;
    --dupes)   DUPES=1; shift ;;
    --all)     ALL=1; shift ;;
    --draft)   PUBLISHED=false; shift ;;
    --publish) PUBLISHED=true; shift ;;
    --new)     FORCE_NEW=1; shift ;;
    --update)  UPDATE_ID="${2:-}"; [ -n "$UPDATE_ID" ] || { echo "usage: mesh-devto-publish --update <id> <article.md>  (--list for ids)" >&2; exit 1; }; shift 2 ;;
    *)         break ;;
  esac
done
ART="${1:-}"
if [ "$LIST" != 1 ] && [ "$DUPES" != 1 ]; then
  [ -n "$ART" ] && [ -r "$ART" ] || { echo "usage: mesh-devto-publish [--draft|--publish] [--update <id>] [--new] <article.md> | --list | --list --dupes | --check" >&2; exit 1; }
fi
# A bare `mesh-devto-publish article.md` (no --update) still means publish — the documented
# default, and the ONLY case where unset intent resolves to true. With --update, unset intent
# means PRESERVE (GET the article first), never publish: 2026-09-23 this very distinction
# failed once during testing and silently unpublished a live article, which is the exact class
# of accident preserve mode exists to prevent. An option's default must not be the irreversible one.
[ "$PUBLISHED" = "" ] && [ "$UPDATE_ID" = "" ] && PUBLISHED=true
[ -f "$ENVF" ] || { echo "mesh-devto-publish: no $ENVF — need DEVTO_API_KEY=<key> (get it at dev.to → Settings → Extensions → DEV Community API Keys)" >&2; exit 2; }
# shellcheck disable=SC1090
set -a; . "$ENVF"; set +a
[ -n "${DEVTO_API_KEY:-}" ] || { echo "mesh-devto-publish: DEVTO_API_KEY empty in $ENVF" >&2; exit 2; }

# The duplicate guard protects the FRONT PAGE: a reader can only land on a LIVE article, so a
# second LIVE copy is the accident it reports. Drafts that duplicate a LIVE title are the
# intentional reversible retention from the 2026-09-23 cleanup, and pooling both indices would
# report those retained drafts as standing duplicates while never being able to exit 0. The
# default therefore reads /published only; --all restores the whole-account view.
if [ "$DUPES" = 1 ]; then
  DUPES="$DUPES" ALL="$ALL" MESH_DEVTO_API="${MESH_DEVTO_API:-https://dev.to}" \
    python3 - <<'PY'
import os, json, urllib.request
from collections import defaultdict
BASE = os.environ.get("MESH_DEVTO_API", "https://dev.to") + "/api/articles/me"
def get(p):
    r = urllib.request.Request(BASE+p,
        headers={"api-key": os.environ["DEVTO_API_KEY"], "User-Agent":"mesh-pub/1.0"})
    return json.load(urllib.request.urlopen(r, timeout=25))
paths = ["/published"]
if os.environ.get("ALL") == "1":
    paths = ["/published", "/unpublished"]
by_title=defaultdict(list)
for path in paths:
    try:
        for a in get(path):
            by_title[a["title"]].append(a)
    except Exception as e:
        print(f"query failed ({path}): {e}")
# Only byte-identical bodies are reported: a shared title with different text is a revision,
# not a duplicate, and the guard is about the second kind of accident.
by_key=defaultdict(list)
for t,v in by_title.items():
    for a in v:
        by_key[(t, a.get("body_markdown",""))].append(a)
dupes={k:v for k,v in by_key.items() if len(v)>1}
if not dupes:
    what = "account-wide (LIVE+draft)" if os.environ.get("ALL")=="1" else "front page (LIVE only)"
    print("no byte-identical duplicate articles — " + what); raise SystemExit(0)
for (t,_b),v in sorted(dupes.items(), key=lambda kv: -len(kv[1])):
    print(f"== {t}  ({len(v)} identical copies)")
    for a in sorted(v, key=lambda x: x["id"]):
        print(f"   id={a['id']:<9} published={a['published_at']} comments={a.get('comments_count',0)} {a.get('url','')}")
raise SystemExit(1)
PY
  exit $?
fi
if [ "$LIST" = 1 ]; then
  MESH_DEVTO_API="${MESH_DEVTO_API:-https://dev.to}" python3 - <<'PY'
import os, json, urllib.request
BASE = os.environ.get("MESH_DEVTO_API", "https://dev.to") + "/api/articles/me"
def get(p):
    r = urllib.request.Request(BASE+p,
        headers={"api-key": os.environ["DEVTO_API_KEY"], "User-Agent":"mesh-pub/1.0"})
    return json.load(urllib.request.urlopen(r, timeout=20))
for label, path in (("LIVE ", "/published"), ("DRAFT", "/unpublished")):
    try:
        for a in get(path):
            print(f"{label} id={a['id']:<9} {a['title'][:58]:<58} {a.get('url','')}")
    except Exception as e:
        print(f"{label} — query failed: {e}")
PY
  exit 0
fi

PUBLISHED="$PUBLISHED" UPDATE_ID="$UPDATE_ID" FORCE_NEW="$FORCE_NEW" \
  MESH_DEVTO_API="${MESH_DEVTO_API:-https://dev.to}" python3 - "$ART" <<'PY'
import sys, os, json, urllib.request, re
art = sys.argv[1]
raw = open(art, encoding="utf-8").read()
# strip my internal "> ..." note lines that sit between front-matter and body
m = re.match(r"^---\n(.*?)\n---\n(.*)$", raw, re.S)
if not m:
    print("no YAML front-matter found", file=sys.stderr); sys.exit(1)
fm, body = m.group(1), m.group(2)
def fv(key, default=None):
    mm = re.search(rf"^{key}:\s*(.+)$", fm, re.M)
    if not mm: return default
    v = mm.group(1).strip()
    # Dequote ONLY a value that is FULLY wrapped in matching quotes. The old
    # .strip('"') stripped by CHARACTER, so a title that merely BEGINS with a
    # quoted phrase lost its opening quote and shipped unbalanced:
    #   "Log this once" is a tense change  ->  Log this once" is a tense change
    # (2026-08-28, article 4513388, fixed by --update). A wrapping quote is a
    # property of the whole scalar, never of its first byte.
    if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"):
        v = v[1:-1]
    return v
title = fv("title")
tags  = [t.strip() for t in (fv("tags","") or "").split(",") if t.strip()]
cover = fv("cover_image")
canon = fv("canonical_url")
# drop leading blockquote note lines (internal instructions) before the real body
body = re.sub(r"\A(?:\s*>.*\n)+", "", body).lstrip("\n")
article = {"title": title, "body_markdown": body, "tags": tags[:4]}
if cover: article["main_image"] = cover
if canon: article["canonical_url"] = canon
upd = os.environ.get("UPDATE_ID") or ""
key = os.environ["DEVTO_API_KEY"]
BASE = os.environ.get("MESH_DEVTO_API", "https://dev.to") + "/api/articles"
def api(method, url, data=None):
    r = urllib.request.Request(url,
        data=json.dumps(data).encode() if data is not None else None,
        headers={"api-key": key, "Content-Type": "application/json",
                 "User-Agent":"mesh-pub/1.0"}, method=method)
    return json.load(urllib.request.urlopen(r, timeout=30))
# One authenticated list does both jobs: the duplicate guard AND the preserve lookup.
# The by-id GET /articles/{id} is NOT a reliable source for the published flag — for drafts it
# 404s outright and the `published` field comes back absent (verified 2026-09-23, which is why
# keying on it silently unpublished two live articles during testing of this very mode).
# /articles/me/all carries a real boolean for every article I own, so both lookups read it.
_mine = None
def mine_all():
    global _mine
    if _mine is None:
        _mine = api("GET", BASE + "/me/all?per_page=1000")
    return _mine
# Duplicate guard: resolve a POST to the existing same-title article, so re-running this tool
# on the same file UPDATES it instead of minting a second live copy. dev.to's only server-side
# check is a 5-minute same-title window, which an edited title sails past; the guard is
# therefore client-side, pre-declared here, and overridable only with --new.
if not upd and os.environ.get("FORCE_NEW") != "1":
    try:
        same = [a for a in mine_all() if a.get("title") == title]
        if same:
            upd = str(min(same, key=lambda a: a["id"])["id"])
            print(f"guard: title already used by article {upd} — updating it in place (--new to post a second copy)")
    except Exception as e:
        print(f"guard: pre-check failed ({e}) — proceeding with a fresh POST", file=sys.stderr)
if upd:
    # Preserve the article's existing published state when neither --publish nor --draft is
    # given. A lookup that fails falls back to DRAFT — the safer direction, because publishing
    # can be undone by --draft --update while a surprise publish cannot be unsaid from a
    # reader's feed.
    intent = os.environ.get("PUBLISHED")
    if intent not in ("true","false"):
        try:
            cur = next((a for a in mine_all() if a["id"] == int(upd)), None)
            article["published"] = bool(cur and cur.get("published"))
        except Exception:
            article["published"] = False
    else:
        article["published"] = intent == "true"
    url, method = f"{BASE}/{upd}", "PUT"
else:
    article["published"] = os.environ["PUBLISHED"] == "true"
    url, method = BASE, "POST"
req = urllib.request.Request(url,
        data=json.dumps({"article": article}).encode(),
        headers={"api-key": key, "Content-Type": "application/json",
                 "User-Agent":"mesh-pub/1.0"}, method=method)
try:
    r = urllib.request.urlopen(req, timeout=30)
    d = json.load(r)
    verb = "UPDATED:" if upd else ("PUBLISHED:" if article["published"] else "DRAFTED:")
    print(verb, d.get("url") or d.get("id"), f"(id={d.get('id')})")
except urllib.error.HTTPError as e:
    print("dev.to API error", e.code, e.read().decode()[:400], file=sys.stderr); sys.exit(1)
PY
