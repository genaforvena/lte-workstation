#!/usr/bin/env bash
# mesh-devto-publish — publish (or draft) a markdown article to dev.to via the API.
# Ready-to-fire: needs only a DEV API key. Reads ~/.mesh/devto.env (DEVTO_API_KEY=...),
# never echoes it. Title/tags/cover come from the article's YAML front-matter.
#
# Usage:
#   mesh-devto-publish <article.md>            # publish (published:true)
#   mesh-devto-publish --draft <article.md>    # create as draft (published:false)
#   mesh-devto-publish --check                 # report readiness (key present? api reachable?)
#
# orphan-ok: on-demand publication tool driven by the pub channel.
set -uo pipefail
ENVF="${MESH_DEVTO_ENV:-$HOME/.mesh/devto.env}"

api_reachable() { curl -s -o /dev/null -w '%{http_code}' --max-time 12 "https://dev.to/api/articles?per_page=1"; }

if [ "${1:-}" = "--check" ]; then
  echo -n "dev.to API: "; code=$(api_reachable); [ "$code" = 200 ] && echo "reachable (200)" || echo "UNREACHABLE ($code)"
  if [ -f "$ENVF" ] && grep -q '^DEVTO_API_KEY=' "$ENVF" 2>/dev/null; then echo "API key: present ($ENVF)"; else echo "API key: MISSING — put DEVTO_API_KEY=<key> in $ENVF"; fi
  exit 0
fi

PUBLISHED=true
[ "${1:-}" = "--draft" ] && { PUBLISHED=false; shift; }
ART="${1:-}"
[ -n "$ART" ] && [ -r "$ART" ] || { echo "usage: mesh-devto-publish [--draft] <article.md>" >&2; exit 1; }
[ -f "$ENVF" ] || { echo "mesh-devto-publish: no $ENVF — need DEVTO_API_KEY=<key> (get it at dev.to → Settings → Extensions → DEV Community API Keys)" >&2; exit 2; }
# shellcheck disable=SC1090
set -a; . "$ENVF"; set +a
[ -n "${DEVTO_API_KEY:-}" ] || { echo "mesh-devto-publish: DEVTO_API_KEY empty in $ENVF" >&2; exit 2; }

PUBLISHED="$PUBLISHED" python3 - "$ART" <<'PY'
import sys, os, json, urllib.request, re
art = sys.argv[1]
raw = open(art, encoding="utf-8").read()
# strip my internal "> ..." note lines that sit between front-matter and body
m = re.match(r"^---\n(.*?)\n---\n(.*)$", raw, re.S)
if not m:
    print("no YAML front-matter found", file=sys.stderr); sys.exit(1)
fm, body = m.group(1), m.group(2)
def fv(key, default=None):
    mm = re.search(rf"^{key}:\s*(.+)$", fm, re.M)
    return mm.group(1).strip().strip('"') if mm else default
title = fv("title")
tags  = [t.strip() for t in (fv("tags","") or "").split(",") if t.strip()]
cover = fv("cover_image")
canon = fv("canonical_url")
# drop leading blockquote note lines (internal instructions) before the real body
body = re.sub(r"\A(?:\s*>.*\n)+", "", body).lstrip("\n")
article = {"title": title, "published": os.environ["PUBLISHED"]=="true",
           "body_markdown": body, "tags": tags[:4]}
if cover: article["main_image"] = cover
if canon: article["canonical_url"] = canon
req = urllib.request.Request("https://dev.to/api/articles",
        data=json.dumps({"article": article}).encode(),
        headers={"api-key": os.environ["DEVTO_API_KEY"], "Content-Type":"application/json",
                 "User-Agent":"mesh-pub/1.0"}, method="POST")
try:
    r = urllib.request.urlopen(req, timeout=30)
    d = json.load(r)
    print("PUBLISHED:" if article["published"] else "DRAFTED:", d.get("url") or d.get("id"))
except urllib.error.HTTPError as e:
    print("dev.to API error", e.code, e.read().decode()[:400], file=sys.stderr); sys.exit(1)
PY
