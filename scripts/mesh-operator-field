#!/usr/bin/env bash
# mesh-operator-field — collect the OPERATOR DATA FIELD, every source tagged by reliability.
# reflex-cadence: */10 * * * *
#
# Operator direction (2026-06-22): "собирать поле данных максимально хорошо, с понятной
# приватностью, помечая источники по достоверности, и искать корреляции с реальностью —
# где реальность это более достоверные источники. Не выдумываем заранее что найдём."
#
# This tool does the COLLECT half: one timestamped JSONL record per sample, fusing the
# already-existing senses, where EVERY field carries a reliability tier so a later
# correlation pass can weight ground-truth against inference. It invents nothing — it only
# records the field broadly and honestly, and lets patterns emerge from real data.
#
# Reliability tiers:
#   hard    — measured ground truth (clock, phone-on-LAN, BLE RSSI value, battery)
#   medium  — coarse real reading (mic ambient level, body-motion class, step/accel deltas)
#   soft    — derived inference (the fused operator-state label, "nearby"/daypart guesses)
#
# PRIVACY: writes ONLY to the local node ($HOME/.mesh/operator-field.jsonl). Nothing leaves
# the node, nothing is published. `mesh-operator-field --stop` documents the off switch.
#
#   mesh-operator-field            collect one record (append to log), print it
#   mesh-operator-field --json     same, machine-readable only (no log header)
#   mesh-operator-field --summary  read the log so far: distribution + reliability coverage
#   mesh-operator-field --tail [N] last N raw records (default 10)
#   mesh-operator-field --test     smoke test (no log write)
#   mesh-operator-field --stop     print how to halt collection (operator's rubillnik)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

FIELD_LOG="${MESH_OP_FIELD_LOG:-$HOME/.mesh/operator-field.jsonl}"
PRESENCE_LOG="$HOME/.mesh/presence.log"

case "${1:-}" in
  --stop)
    cat <<EOF
mesh-operator-field — off switch (operator's rubillnik):
  1. Comment the autowired line in ~/.mesh/reflexes.cron (grep operator-field), then
     mesh-reflexes --apply   (add-only; commenting halts new samples).
  2. The data is local only: $FIELD_LOG  — delete it any time to forget the field.
Nothing was ever sent off-node.
EOF
    exit 0 ;;
  --summary)
    [ -s "$FIELD_LOG" ] || { echo "operator-field: no data yet ($FIELD_LOG empty)"; exit 0; }
    python3 - "$FIELD_LOG" <<'PYEOF'
import json,sys,collections
log=sys.argv[1]
recs=[]
for ln in open(log):
    ln=ln.strip()
    if not ln: continue
    try: recs.append(json.loads(ln))
    except Exception: pass
if not recs:
    print("operator-field: log present but unparseable"); sys.exit(0)
n=len(recs)
t0=recs[0].get("ts","?"); t1=recs[-1].get("ts","?")
print(f"operator-field: {n} samples  {t0} → {t1}")
# state distribution (the soft label)
states=collections.Counter(r.get("f",{}).get("state","?") for r in recs)
print("\n  state (soft inference) distribution:")
for s,c in states.most_common():
    print(f"    {s:12s} {c:4d}  {100*c//n:3d}%")
# degraded fraction (phone SSH offline = thinner field)
deg=sum(1 for r in recs if r.get("f",{}).get("degraded"))
print(f"\n  degraded (phone SSH offline): {deg}/{n}  {100*deg//n if n else 0}%")
# reliability coverage: how often each tier had a real (non '-') value
tiers=collections.defaultdict(lambda:[0,0])
for r in recs:
    rel=r.get("rel",{}); f=r.get("f",{})
    for k,t in rel.items():
        v=f.get(k)
        tiers[t][1]+=1
        if v not in (None,"-","","UNKNOWN","UNAVAILABLE"): tiers[t][0]+=1
print("\n  reliability coverage (fields with a real value / total):")
for t in ("hard","medium","soft"):
    got,tot=tiers.get(t,[0,0])
    print(f"    {t:7s} {got}/{tot}")
# daypart x state cross-tab (first honest look at 'reality vs inference')
print("\n  daypart × state (raw counts — correlation is read here, not asserted):")
ct=collections.defaultdict(collections.Counter)
for r in recs:
    f=r.get("f",{}); ct[f.get("daypart","?")][f.get("state","?")]+=1
for dp in ("night","morning","day","evening","?"):
    if dp in ct:
        row=", ".join(f"{s}:{c}" for s,c in ct[dp].most_common())
        print(f"    {dp:8s} {row}")
PYEOF
    exit 0 ;;
  --tail)
    N="${2:-10}"; [ -s "$FIELD_LOG" ] && tail -n "$N" "$FIELD_LOG" || echo "(no data)"
    exit 0 ;;
esac

case "${1:-}" in
  --json) OF_MODE=json ;;
  --test) OF_MODE=test ;;
  ""|collect) OF_MODE=collect ;;
  *) echo "usage: mesh-operator-field [--json|--summary|--tail N|--test|--stop]" >&2; exit 2 ;;
esac

# ---- gather signals (all timeout-guarded; never block on an offline phone) ----
if [ "$OF_MODE" = test ]; then
  OPJSON='{"state":"AT-DESK","degraded":true,"ambient_level":"LOUD","phone_lan":"HOME","op_dev_name":"Quest 3","op_dev_rssi":-82,"reason":"smoke stub"}'
else
  OPJSON="$(timeout 25 mesh-operator-state --json 2>/dev/null)" || OPJSON=""
  [ -n "$OPJSON" ] || OPJSON='{}'
fi

# operator-MOOD (affective coloring — soft tier). On-demand fusion FOLDED IN here so it needs NO cron of
# its own; THIS */10 sample IS its liveness. Reuse the operator-state JSON just fetched
# (MESH_MOOD_OPSTATE_JSON) → mood adds ZERO extra SSH. Honest-degraded: valence is null unless there was
# recent operator text — we record that null as-is, never a faked all-clear.
if [ "$OF_MODE" = test ]; then
  MOODJSON='{"label":"CONTENT","valence":0.3,"arousal":-0.2,"confidence":0.7,"valence_known":true,"arousal_known":true}'
elif command -v mesh-operator-mood >/dev/null 2>&1; then
  MOODJSON="$(MESH_MOOD_OPSTATE_JSON="$OPJSON" timeout 30 mesh-operator-mood --json 2>/dev/null)" || MOODJSON=""
  [ -n "$MOODJSON" ] || MOODJSON='{}'
else
  MOODJSON='{}'
fi

# hard time context (local clock = ground truth)
HOUR="$(date +%-H)"; DOW="$(date +%u)"; ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
WEEKEND=$([ "$DOW" -ge 6 ] && echo true || echo false)
if   [ "$HOUR" -lt 6 ]; then DAYPART=night
elif [ "$HOUR" -lt 12 ]; then DAYPART=morning
elif [ "$HOUR" -lt 18 ]; then DAYPART=day
else DAYPART=evening; fi

# medium: nearby appliance BLE count (from cached presence.log — cheap, no scan)
APPL="-"
if [ -s "$PRESENCE_LOG" ]; then
  APPL="$(tail -1 "$PRESENCE_LOG" 2>/dev/null | grep -oE 'appliance:[0-9]+' | grep -oE '[0-9]+' || echo '-')"
fi

ISO="$ISO" HOUR="$HOUR" DOW="$DOW" WEEKEND="$WEEKEND" DAYPART="$DAYPART" APPL="$APPL" \
MESH_OF_MODE="$OF_MODE" FIELD_LOG="$FIELD_LOG" \
python3 - "$OPJSON" "$MOODJSON" <<'PYEOF'
import json,os,sys
try: op=json.loads(sys.argv[1])
except Exception: op={}
try: mood=json.loads(sys.argv[2]) if len(sys.argv)>2 else {}
except Exception: mood={}
f={
  # hard — measured ground truth
  "ts": os.environ["ISO"],
  "hour": int(os.environ["HOUR"]),
  "dow": int(os.environ["DOW"]),
  "weekend": os.environ["WEEKEND"]=="true",
  "phone_lan": op.get("phone_lan","-"),
  "op_dev_rssi": op.get("op_dev_rssi","-"),
  "op_dev_name": op.get("op_dev_name","-"),
  # medium — coarse real readings
  "ambient_level": op.get("ambient_level","-"),
  "body": op.get("body","-"),
  "steps_delta": op.get("steps_delta","-"),
  "linaccel": op.get("linaccel","-"),
  "lux": op.get("lux","-"),
  "appliances_near": os.environ["APPL"],
  # soft — derived inference
  "state": op.get("state","UNKNOWN"),
  "daypart": os.environ["DAYPART"],
  "degraded": op.get("degraded", None),
  "reason": op.get("reason",""),
  # soft — affective coloring (mesh-operator-mood). valence is None when no recent operator text
  # (honest-fusion: recorded as null, never faked); arousal can stand on embodied senses alone.
  "mood": mood.get("label","UNKNOWN"),
  "mood_valence": mood.get("valence", None) if mood.get("valence_known") else None,
  "mood_arousal": mood.get("arousal", None) if mood.get("arousal_known") else None,
  "mood_conf": mood.get("confidence", None),
}
rel={
  "hour":"hard","dow":"hard","weekend":"hard","phone_lan":"hard",
  "op_dev_rssi":"hard","op_dev_name":"hard",
  "ambient_level":"medium","body":"medium","steps_delta":"medium",
  "linaccel":"medium","lux":"medium","appliances_near":"medium",
  "state":"soft","daypart":"soft","reason":"soft",
  "mood":"soft","mood_valence":"soft","mood_arousal":"soft","mood_conf":"soft",
}
rec={"ts":f["ts"],"f":f,"rel":rel}
line=json.dumps(rec,ensure_ascii=False)

mode=os.environ.get("MESH_OF_MODE","collect")
if mode=="test":
    print(line); sys.exit(0)
if mode!="json":
    # write to log
    log=os.environ["FIELD_LOG"]
    try:
        with open(log,"a") as fh: fh.write(line+"\n")
    except Exception as e:
        print(f"operator-field: WARN could not write log: {e}", file=sys.stderr)
if mode=="json":
    print(line)
else:
    # human one-liner
    deg=" [degraded]" if f["degraded"] else ""
    vv = f["mood_valence"]; mv = f'{vv:+.2f}' if isinstance(vv,(int,float)) else '?'
    print(f'{f["ts"]}  {f["state"]}{deg}  {f["daypart"]} h{f["hour"]} '
          f'phone={f["phone_lan"]} mic={f["ambient_level"]} dev={f["op_dev_name"]}@{f["op_dev_rssi"]} '
          f'mood={f["mood"]}(v{mv})')
PYEOF
