  # CLAIMS ANCHOR (chat-review/dispatch-claims-source-unanchored): the CLAIMS source (line ~164) must anchor
  # [done]/[taking]/[dispatch] to the body start too — else a chat-review post that merely QUOTES a marker in
  # prose is trusted as a real claim, self-poisoning the poster's own task (live-repro 2026-07-02T20:41Z).
  claims_anchored(){ printf '%s\n' "$1" | grep -qE '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[(taking|dispatch|done)\]'; }
  claims_anchored '2026-07-02T21:48:05Z  land@host  ::  [done] chat-review/foo: landed it'  || { echo "FAIL: claims-anchor missed a real [done] body-start"; e=$((e+1)); }
  claims_anchored '2026-07-02T21:00:00Z  genome@host  ::  [taking] chat-review/bar: on it'  || { echo "FAIL: claims-anchor missed a real [taking] body-start"; e=$((e+1)); }
