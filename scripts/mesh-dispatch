  [ "$(claim_id_of '[done] DIRTY-TREE: resolved — committed mesh-backlight, mesh-body-thermal task:DIRTY-TREE')" = "DIRTY-TREE" ] || { echo "FAIL: explicit task: tag did not override prose-derived id (accounting close-key broken)"; e=$((e+1)); }
