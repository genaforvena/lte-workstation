#!/usr/bin/env bash
# mesh-dispatch — the MIND-ALLOCATION reflex: route an OPEN board [task] to an IDLE claude worker.
# (operator direction 2026-06-14: "route work reflexively across providers ... build the allocation
# as a REFLEX, not manual.") The PUSH half of the feed pair — mesh-tick has minds PULL from
# board+PLAN on their own beat; mesh-dispatch PUSHES an unclaimed [task] to a free hand so a pending
# task and an idle worker never sit side by side (the gap that left `sense` idle while [task]s
# waited). Reuses mesh-mind-state (classify) + mesh-mind-control --dispatch (route+mark+board log).
#
# Conservative by design — three guards keep it from churning or double-feeding:
#   (1) ONE dispatch per pass (race-safe; the backlog drains over a few cron cycles).
#   (2) NEVER re-dispatches: a per-task signature state file + board claim-markers
#       ([taking]/[dispatch]/[done]) — and it errs toward "already claimed" (under-dispatch, never
#       double-dispatch).
#   (3) NO manufactured busywork: no open task OR no idle hand => honest no-op (idle is fine — a
#       worker should rest when there is no real work, available for the next task).
#
#   mesh-dispatch            one allocation pass (the cron reflex)
#   mesh-dispatch --status   show idle workers + open tasks; dispatch nothing
#   mesh-dispatch --test     smoke
#
# reflex-cadence: 3-59/5 * * * *
# (work-gated PUSH half — no-op unless a real open [task] AND an idle worker coexist; never blind/
# busywork, so it honours the diff-triggered-activation doctrine. Was orphaned in the 2026-06-17 reorg
# — ran last 2026-06-17T03:44 then dropped from cron with NO cadence tag, so autowire couldn't re-pick
# it; the header makes it reorg-survivable. Bare invocation is the pass — no reflex-args.)
#
# Env: MESH_MIND_WORKERS (idle pool, default "dev discover sense") ·
#      MESH_DISPATCH_LOOKBACK (board tail lines scanned, default 400)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# node-local worker pool override (2026-06-17 autopoiesis-targeting fix — else a cron run uses the
# dead dev/discover/sense default).
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
MESH="$HOME/.mesh"; CHAT="$MESH/chat.log"; STATE="$MESH/.dispatch-state"; LOG="$MESH/dispatch.log"
WORKERS="${MESH_MIND_WORKERS:-dev discover sense}"
LOOKBACK="${MESH_DISPATCH_LOOKBACK:-400}"
ts(){ date -u +%FT%TZ; }

if [ "${1:-}" = --test ]; then
  # define internal test helpers (subset of the main file's functions)
  norm(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]' | cut -c1-48; }
  keyof(){ printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1; }
  slugof(){ local h="${1%%:*}"; h="${h##*/}"; h="$(printf '%s' "$h" | tr -cd '[:alnum:]-')"
    case "$h" in *-*) [ "${#h}" -ge 6 ] && printf '%s' "$h" ;; esac; }
  addressed_elsewhere(){ printf '%s' "$1" | grep -qiE '^(tg|tg-mind|planner|operator|steward)[: -]'; }
  e=0
  command -v mesh-mind-state   >/dev/null 2>&1 || { echo "FAIL: dep mesh-mind-state"; e=$((e+1)); }
  command -v mesh-mind-control >/dev/null 2>&1 || { echo "FAIL: dep mesh-mind-control"; e=$((e+1)); }
  r="$(norm 'Hello WORLD! 123')"; [ "$r" = "helloworld123" ] || { echo "FAIL: norm"; e=$((e+1)); }
  r="$(norm '')";                 [ "$r" = "" ]              || { echo "FAIL: norm-empty"; e=$((e+1)); }
  r="$(norm 'aBcDeFgHiJkLmNoPqRsTuVwXyZ')"; [ "${#r}" -le 48 ] || { echo "FAIL: norm-trunc"; e=$((e+1)); }
  r="$(keyof 'add HARDWARE-CARE to queue')"; [ "$r" = "HARDWARE-CARE" ] || { echo "FAIL: keyof-shout"; e=$((e+1)); }
  r="$(keyof 'done something short')";       [ -z "$r" ]               || { echo "FAIL: keyof-noshout"; e=$((e+1)); }
  # slugof: ns/slug task -> stable slug (matches a [done] that drops the namespace); no-slug -> empty
  r="$(slugof 'chat-review/delegation-worker-health: add probe')"; [ "$r" = "delegation-worker-health" ] || { echo "FAIL: slugof-ns (got '$r')"; e=$((e+1)); }
  r="$(slugof 'queue-tend/tilde-reaper: add reconcile')";          [ "$r" = "tilde-reaper" ]             || { echo "FAIL: slugof-ns2 (got '$r')"; e=$((e+1)); }
  r="$(slugof 'op-home-meta-marker: add to set')";                 [ "$r" = "op-home-meta-marker" ]      || { echo "FAIL: slugof-bare (got '$r')"; e=$((e+1)); }
  r="$(slugof 'fix the thing now')";                               [ -z "$r" ]                          || { echo "FAIL: slugof-noslug (got '$r')"; e=$((e+1)); }
  addressed_elsewhere 'steward: run plan' || { echo "FAIL: addr stew"; e=$((e+1)); }
  addressed_elsewhere 'tg-mind check'     || { echo "FAIL: addr tg"; e=$((e+1)); }
  addressed_elsewhere 'operator run'      || { echo "FAIL: addr op"; e=$((e+1)); }
  addressed_elsewhere 'normal task'       && { echo "FAIL: addr false-pos"; e=$((e+1)); } || true
  [ "$e" -eq 0 ] && echo "smoke: ok (13 assertions)" || { echo "smoke: FAIL ($e fail(s))"; exit 1; }
  exit 0
fi

mkdir -p "$MESH"; touch "$STATE"

# normalize text -> signature: lowercase, alnum-only, first 48 chars (stable per-task id)
norm(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]' | cut -c1-48; }
# a task's KEY: first SHOUTY token (>=5 of A-Z plus hyphen) — the board's de-facto task id
# (HARDWARE-CARE, MIND-ALLOCATION, TV-as-WATCHED-ORGAN ...). "" when a task has none.
keyof(){ printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1; }
# a task's SLUG: the distinctive id for modern lowercase tasks shaped "namespace/slug: desc" or
# "slug: desc" (chat-review/delegation-worker-health -> delegation-worker-health). Keyed on the
# stable hyphenated slug so a claim is matched even when its [done] DROPS the "namespace/" prefix or
# rewords the description (the 2026-06-20 re-dispatch harm: [task] "chat-review/delegation-worker-
# health" vs [done] "delegation-worker-health" — the old 30-char-prefix match included "chat-review/"
# and missed it). "" when the task has no hyphenated slug (falls back to the prefix match).
slugof(){ local h="${1%%:*}"; h="${h##*/}"; h="$(printf '%s' "$h" | tr -cd '[:alnum:]-')"
  case "$h" in *-*) [ "${#h}" -ge 6 ] && printf '%s' "$h" ;; esac; }
# tasks addressed to a non-worker role are not for the generic claude worker pool
addressed_elsewhere(){ printf '%s' "$1" | grep -qiE '^(tg|tg-mind|planner|operator|steward)[: -]'; }

idle_workers(){
  local w line st
  for w in $WORKERS; do
    line="$(mesh-mind-state "$w" 2>/dev/null | head -1)"; st="${line%%	*}"
    [ "$st" = IDLE ] && printf '%s\n' "$w"
  done
}

# claims blob: [taking]/[dispatch]/[done] lines (raw). A task is "claimed" if its KEY/SLUG (or, both
# absent, its signature prefix) shows up here, or its signature is in the state file.
# Matched against the FULL board, NOT the LOOKBACK tail: a task's [done]/[taking] can age out of the
# tail while its [task] line is still in view -> the task looks open again and gets RE-DISPATCHED
# (the 2026-06-20 board-evaporation harm — a 9h-old [done] task re-issued to genome). grep over the
# whole chat.log is cheap (~1MB, sub-10ms) and runs every 5min. [task] collection stays tail-bounded
# (we only dispatch RECENT open work), but a claim from ANY time correctly closes it.
CLAIMS="$(grep -E '\[(taking|dispatch|done)\]' "$CHAT" 2>/dev/null || true)"

is_open(){
  local task="$1" key slug sig
  sig="$(norm "$task")"; [ -n "$sig" ] || return 1
  grep -qxF "$sig" "$STATE" 2>/dev/null && return 1            # already dispatched by us
  key="$(keyof "$task")"
  if [ -n "$key" ]; then
    printf '%s\n' "$CLAIMS" | grep -qiF "$key" && return 1     # SHOUTY key appears in a claim line
  else
    slug="$(slugof "$task")"
    if [ -n "$slug" ]; then
      printf '%s\n' "$CLAIMS" | grep -qiF "$slug" && return 1  # ns/slug id appears in a claim line
    else
      printf '%s\n' "$CLAIMS" | grep -qiF "$(printf '%s' "$task" | cut -c1-30)" && return 1
    fi
  fi
  return 0
}

# collect open [task] lines, oldest first.
# ANCHOR [task] to the start of the message BODY (right after the "::" field separator) — a [task]
# appearing mid-PROSE (e.g. "...a stale [task] re-dispatch...") is NOT a real task and must never be
# scraped + re-dispatched (the 2026-06-15 phantom-task loop: a [void] post's prose was re-dispatched).
mapfile -t OPEN < <(
  tail -n "$LOOKBACK" "$CHAT" 2>/dev/null | grep -E '::[[:space:]]+\[task\][[:space:]]' | while IFS= read -r line; do
    task="${line#*\[task\] }"
    [ "$task" != "$line" ] || continue
    addressed_elsewhere "$task" && continue
    is_open "$task" && printf '%s\n' "$task"
  done
)

idle="$(idle_workers)"
n_idle=$(printf '%s' "$idle" | grep -c . || true)
n_open=${#OPEN[@]}

if [ "${1:-}" = --status ]; then
  echo "=== mesh-dispatch · $(ts) ==="
  echo "idle workers ($n_idle): $(printf '%s ' ${idle:-none})"
  echo "open tasks   ($n_open):"
  [ "$n_open" -gt 0 ] && printf '  - %s\n' "${OPEN[@]:0:8}" | cut -c1-110 || echo "  (none)"
  exit 0
fi

[ -z "$idle" ]      && { echo "$(ts) dispatch: no idle worker — no-op" >>"$LOG"; exit 0; }
[ "$n_open" -eq 0 ] && { echo "$(ts) dispatch: idle [$idle] but no open task — no-op" >>"$LOG"; exit 0; }

# one dispatch per pass: hand the OLDEST open task to a free worker (mesh-mind-control picks which)
task="${OPEN[0]}"
sig="$(norm "$task")"
# Framing requires VERIFY-FIRST, not blind compliance. A freshly-minted audit [task] can name an
# issue already resolved under a different description (the slug is new, so claim-matching can't catch
# it — the 2026-06-20 senses-launch-config phantom) OR carry a mis-specified/harmful instruction (that
# same task said add '--permission-mode auto' to opencode, which has no such flag → would crash senses).
# So the worker is told to verify the task is live + correct BEFORE acting, and to push back (a [done]
# that closes it) rather than regress a healthy system. Makes the cheap re-check the expected first
# step, not wasted ticks — and encodes honest-pushback into every dispatch.
framed="Board task assigned to you. FIRST verify it is still live AND the instruction is correct against the CURRENT code/state — audit tasks are often already resolved or mis-specified. If already done: post '[done] stale: $task — already resolved (cite where)' and STOP. If the instruction is wrong or would regress something: post '[done] rejected: <why>' and STOP (honest pushback beats blind compliance). Otherwise do it now, then post '[done] <short result>'. TASK: $task"

out="$(mesh-mind-control --dispatch "$framed" 2>&1)"; rc=$?
if [ "$rc" -eq 0 ]; then
  printf '%s\n' "$sig" >>"$STATE"
  echo "$(ts) dispatch: $out" >>"$LOG"
  echo "$out"
else
  echo "$(ts) dispatch: NOT routed (rc=$rc): $out" >>"$LOG"
  echo "$out"
fi
exit 0
