#!/usr/bin/env bash
# mesh-dispatch — the MIND-ALLOCATION reflex: route an OPEN board [task] to an IDLE claude worker.
# (operator direction 2026-06-14: "route work reflexively across providers ... build the allocation
# as a REFLEX, not manual.") The PUSH half of the feed pair — mesh-tick has minds PULL from
# board+PLAN on their own beat; mesh-dispatch PUSHES an unclaimed [task] to a free hand so a pending
# task and an idle worker never sit side by side (the gap that left `sense` idle while [task]s
# waited). Reuses mesh-mind-state (classify) + mesh-mind-control --dispatch (route+mark+board log).
#
# Conservative by design — three guards keep it from churning or double-feeding:
#   (1) ONE dispatch per pass (race-safe; the backlog drains over a few cron cycles).
#   (2) NEVER re-dispatches: a per-task signature state file + board claim-markers
#       ([taking]/[dispatch]/[done]) — and it errs toward "already claimed" (under-dispatch, never
#       double-dispatch).
#   (3) NO manufactured busywork: no open task OR no idle hand => honest no-op (idle is fine — a
#       worker should rest when there is no real work, available for the next task).
#
#   mesh-dispatch            one allocation pass (the cron reflex)
#   mesh-dispatch --status   show idle workers + open tasks; dispatch nothing
#   mesh-dispatch --test     smoke
#
# reflex-cadence: 3-59/5 * * * *
# (work-gated PUSH half — no-op unless a real open [task] AND an idle worker coexist; never blind/
# busywork, so it honours the diff-triggered-activation doctrine. Was orphaned in the 2026-06-17 reorg
# — ran last 2026-06-17T03:44 then dropped from cron with NO cadence tag, so autowire couldn't re-pick
# it; the header makes it reorg-survivable. Bare invocation is the pass — no reflex-args.)
#
# Env: MESH_MIND_WORKERS (idle pool, default "dev discover sense") ·
#      MESH_DISPATCH_LOOKBACK (board tail lines scanned, default 400)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# node-local worker pool override (2026-06-17 autopoiesis-targeting fix — else a cron run uses the
# dead dev/discover/sense default).
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
# SPEND GOVERNOR (operator 2026-06-21): dispatching wakes a paid claude worker — gate it on mesh-pace so
# we keep reserve in the 5h window. The gate is consulted DOWN at the actual dispatch (search "PACE-SKIP"),
# AFTER the --status/--test/no-idle/no-open/thermal-hold no-ops, so a NO-OP tick never burns the GAP
# (chat-review/pace-noop-consumes-slot 2026-06-22). It used to sit HERE at the top and record-consume the
# reserve even on cycles that woke no mind — mesh-pace exit-0 records "now", so a passing-but-no-op tick
# pushed the next REAL dispatch back a full GAP.
MESH="$HOME/.mesh"; CHAT="$MESH/chat.log"; STATE="$MESH/.dispatch-state"; LOG="$MESH/dispatch.log"
EVAP_STATE="$MESH/.dispatch-evaporated"
WORKERS="${MESH_MIND_WORKERS:-dev discover sense}"
LOOKBACK="${MESH_DISPATCH_LOOKBACK:-400}"
STALE_TTL="${MESH_DISPATCH_STALE:-14400}"   # a NEVER-TAKEN task is only stale once its OWN [task] post is older than this (4h)
ts(){ date -u +%FT%TZ; }
# THERMAL-HOLD predicate (shared by --test + the main path): hold a dispatch when the node's hottest
# zone is at/over the active-throttle band. Empty arg = unreadable sensor → fail-open (do NOT hold).
thermal_hold(){ [ -n "${1:-}" ] && [ "$1" -ge "$2" ]; }

if [ "${1:-}" = --test ]; then
  # define internal test helpers (subset of the main file's functions)
  norm(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]' | cut -c1-48; }
  keyof(){ printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1; }
  slugof(){ local h="${1%%:*}"; h="${h##*/}"; h="$(printf '%s' "$h" | tr -cd '[:alnum:]-')"
    case "$h" in *-*) [ "${#h}" -ge 6 ] && printf '%s' "$h" ;; esac; }
  idof(){ local s; s="$(slugof "$1")"; if [ -n "$s" ]; then printf '%s' "$s"; else keyof "$1"; fi; }
  addressed_elsewhere(){ printf '%s' "$1" | grep -qiE '^(tg|tg-mind|planner|operator|steward|room)[: ]'; }
  e=0
  command -v mesh-mind-state   >/dev/null 2>&1 || { echo "FAIL: dep mesh-mind-state"; e=$((e+1)); }
  command -v mesh-mind-control >/dev/null 2>&1 || { echo "FAIL: dep mesh-mind-control"; e=$((e+1)); }
  r="$(norm 'Hello WORLD! 123')"; [ "$r" = "helloworld123" ] || { echo "FAIL: norm"; e=$((e+1)); }
  r="$(norm '')";                 [ "$r" = "" ]              || { echo "FAIL: norm-empty"; e=$((e+1)); }
  r="$(norm 'aBcDeFgHiJkLmNoPqRsTuVwXyZ')"; [ "${#r}" -le 48 ] || { echo "FAIL: norm-trunc"; e=$((e+1)); }
  r="$(keyof 'add HARDWARE-CARE to queue')"; [ "$r" = "HARDWARE-CARE" ] || { echo "FAIL: keyof-shout"; e=$((e+1)); }
  r="$(keyof 'done something short')";       [ -z "$r" ]               || { echo "FAIL: keyof-noshout"; e=$((e+1)); }
  # slugof: ns/slug task -> stable slug (matches a [done] that drops the namespace); no-slug -> empty
  r="$(slugof 'chat-review/delegation-worker-health: add probe')"; [ "$r" = "delegation-worker-health" ] || { echo "FAIL: slugof-ns (got '$r')"; e=$((e+1)); }
  r="$(slugof 'queue-tend/tilde-reaper: add reconcile')";          [ "$r" = "tilde-reaper" ]             || { echo "FAIL: slugof-ns2 (got '$r')"; e=$((e+1)); }
  r="$(slugof 'op-home-meta-marker: add to set')";                 [ "$r" = "op-home-meta-marker" ]      || { echo "FAIL: slugof-bare (got '$r')"; e=$((e+1)); }
  r="$(slugof 'fix the thing now')";                               [ -z "$r" ]                          || { echo "FAIL: slugof-noslug (got '$r')"; e=$((e+1)); }
  # idof: SLUG-FIRST — a hyphen-slug task keys on its SLUG, never a SHOUTY word from its DESCRIPTION
  # (2026-06-22 collision regression: keyof scraped 'STATE'/'EXCLUDED' from the desc → is_open
  # false-matched unrelated old [done]s → stranded the task while genome sat idle)
  r="$(idof 'chat-review/household-edge-dwell: only post after the new STATE persists')"; [ "$r" = "household-edge-dwell" ] || { echo "FAIL: idof slug-first over desc-SHOUT (got '$r')"; e=$((e+1)); }
  r="$(idof 'chat-review/strand-autoland-eligibility: strand only autoland-EXCLUDED files')";  [ "$r" = "strand-autoland-eligibility" ] || { echo "FAIL: idof slug-first 2 (got '$r')"; e=$((e+1)); }
  r="$(idof 'NOVELTY: scan for unusual activity')";                [ "$r" = "NOVELTY" ]                  || { echo "FAIL: idof key-fallback no-slug (got '$r')"; e=$((e+1)); }
  r="$(idof 'HARDWARE-CARE: do it now')";                          [ "$r" = "HARDWARE-CARE" ]            || { echo "FAIL: idof hyphen-shouty slug (got '$r')"; e=$((e+1)); }
  addressed_elsewhere 'steward: run plan' || { echo "FAIL: addr stew"; e=$((e+1)); }
  addressed_elsewhere 'tg-mind check'     || { echo "FAIL: addr tg"; e=$((e+1)); }
  addressed_elsewhere 'operator run'      || { echo "FAIL: addr op"; e=$((e+1)); }
  # room is an actuator-only window (speaker, no code duty) — a tag-less 'room: ...' task must NOT fall
  # to the generic claude WORKERS pool (genome), which has no actuator access (the operator's spoken-ack
  # request would silently never reach room). chat-review/dispatch-addressed-elsewhere-missing-room.
  addressed_elsewhere 'room: say hello'   || { echo "FAIL: addr room"; e=$((e+1)); }
  addressed_elsewhere 'normal task'       && { echo "FAIL: addr false-pos"; e=$((e+1)); } || true
  # operator-ask is operator-REQUESTED worker work, NOT addressed-to-the-operator-window: it must be
  # dispatchable (chat-review/operator-ask-dispatch-invisible 2026-07-04 — the old [: -] charclass
  # matched '^operator-' and sank it invisibly). Exact 'operator:'/'tg-mind:' stay held.
  addressed_elsewhere 'operator-ask: camera object recognition' && { echo "FAIL: addr operator-ask must be dispatchable"; e=$((e+1)); } || true
  addressed_elsewhere 'operator: run'     || { echo "FAIL: addr operator: exact"; e=$((e+1)); }
  addressed_elsewhere 'tg-mind: check'    || { echo "FAIL: addr tg-mind: exact"; e=$((e+1)); }
  # never-taken age gate: a FRESH unclaimed task must NOT be stale (dispatchable); an OLD one is.
  STALE_TTL=14400
  posted_stale(){ [ "${1:-0}" -gt 0 ] && [ $(( $2 - $1 )) -gt "$STALE_TTL" ]; }
  posted_stale 100000 105000 && { echo "FAIL: fresh post (5000s<4h) wrongly stale"; e=$((e+1)); } || true
  posted_stale 100000 120000 || { echo "FAIL: old post (20000s>4h) not stale"; e=$((e+1)); }
  posted_stale 0       120000 && { echo "FAIL: unknown post-time (0) wrongly stale"; e=$((e+1)); } || true
  # thermal-hold gate: hold when hot (>=band), pass when cool, fail-open when sensor unreadable (empty)
  thermal_hold 95 92 || { echo "FAIL: thermal-hold 95>=92 should HOLD"; e=$((e+1)); }
  thermal_hold 92 92 || { echo "FAIL: thermal-hold 92>=92 (boundary) should HOLD"; e=$((e+1)); }
  thermal_hold 80 92 && { echo "FAIL: thermal-hold 80<92 should PASS"; e=$((e+1)); } || true
  thermal_hold "" 92 && { echo "FAIL: thermal-hold unreadable sensor must fail-open (PASS)"; e=$((e+1)); } || true
  # SCRAPE ANCHOR: [task] must be the BODY START (field <ts> <who> :: [task]), not any "::  [task]"
  # substring in prose — else a message quoting board syntax re-dispatches its own prose (the
  # 2026-06-21 live reproduction: a [done] reviewing this gap got re-fed as a task).
  anchored(){ printf '%s\n' "$1" | grep -qE '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[task\][[:space:]]'; }
  anchored '2026-06-21T04:00:00Z  genome@host  ::  [task] chat-review/foo: do it' || { echo "FAIL: anchor missed a real [task] body-start"; e=$((e+1)); }
  anchored "2026-06-21T05:10:08Z  genome@host  ::  [done] review: a mirrored ':: [task] …' line would INSTRUCT" && { echo "FAIL: anchor scraped a [task] quoted in prose (marker-in-body injection)"; e=$((e+1)); } || true
  # CLAIMS ANCHOR (chat-review/dispatch-claims-source-unanchored): the CLAIMS source (line ~164) must anchor
  # [done]/[taking]/[dispatch] to the body start too — else a chat-review post that merely QUOTES a marker in
  # prose is trusted as a real claim, self-poisoning the poster's own task (live-repro 2026-07-02T20:41Z).
  claims_anchored(){ printf '%s\n' "$1" | grep -qE '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[(taking|dispatch|done)\]'; }
  claims_anchored '2026-07-02T21:48:05Z  land@host  ::  [done] chat-review/foo: landed it'  || { echo "FAIL: claims-anchor missed a real [done] body-start"; e=$((e+1)); }
  claims_anchored '2026-07-02T21:00:00Z  genome@host  ::  [taking] chat-review/bar: on it'  || { echo "FAIL: claims-anchor missed a real [taking] body-start"; e=$((e+1)); }
  claims_anchored "2026-07-02T20:41Z  chat@host  ::  [chat-review] the unanchored grep sweeps a '[done]' quoted in prose into CLAIMS" && { echo "FAIL: claims-anchor scraped a marker quoted in prose (self-poison)"; e=$((e+1)); } || true
  # source guard (falsifiable): revert line ~164 to a bare '\[(taking' with no ::-anchor prefix → this FAILs.
  grep -F 'CLAIMS="$(grep' "$0" | grep -qF '::[[:space:]]+\[(taking' || { echo "FAIL: CLAIMS source not anchored to body-start (unanchored re-enables prose-marker self-poison)"; e=$((e+1)); }
  # CLAIM SUBJECT-ID match (chat-review/dispatch-claim-match-unanchored): the is_open [done]/[taking] scans
  # must key on a claim's OWN subject id (first slug/shouty token), NOT the id appearing ANYWHERE in the
  # line — else a real [done]/[taking] for task A whose prose CITES task B's slug false-closes B (B's task
  # silently evaporated with ZERO dispatch, the exact reproduced harm: default-string-strand-no-task).
  claim_id_of(){ local s; s="$(printf '%s' "$1" | grep -oE '([a-z0-9]+(-[a-z0-9]+)*/)+[a-z0-9]+(-[a-z0-9]+)+|[a-z0-9]+(-[a-z0-9]+)+' | head -1)"; s="${s##*/}"; if [ -n "$s" ] && [ "${#s}" -ge 6 ]; then printf '%s' "$s"; return; fi; printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1; }
  claim_body_if(){ local rest="${1#*:: }"; rest="${rest#"${rest%%[![:space:]]*}"}"; case "$rest" in "[$2] "*) printf '%s' "$rest" ;; *) return 1 ;; esac; }
  # a claim resolves to its OWN subject, robust to ns/ prefix, dropped prefix, stale:/rejected: qualifier, shouty
  [ "$(claim_id_of '[done] chat-review/foo-bar-baz: shipped')"        = "foo-bar-baz" ]  || { echo "FAIL: claim_id_of ns/slug subject"; e=$((e+1)); }
  [ "$(claim_id_of '[done] foo-bar-baz: shipped')"                    = "foo-bar-baz" ]  || { echo "FAIL: claim_id_of dropped-ns subject"; e=$((e+1)); }
  [ "$(claim_id_of '[done] stale: chat-review/foo-bar-baz: resolved')" = "foo-bar-baz" ] || { echo "FAIL: claim_id_of stale: qualifier"; e=$((e+1)); }
  [ "$(claim_id_of '[done] HARDWARE-CARE: did it')"                   = "HARDWARE-CARE" ] || { echo "FAIL: claim_id_of shouty key"; e=$((e+1)); }
  # THE FIX: a [done] about A citing B's slug resolves to A (its subject), NOT B → B is not false-closed
  [ "$(claim_id_of '[done] chat-review/watchdog-offline: shipped (supersedes chat-review/default-string-strand-no-task)')" = "watchdog-offline" ] || { echo "FAIL: claim_id_of picked a CITED slug over the subject (phantom-match re-opened)"; e=$((e+1)); }
  # claim_body_if: body-start marker discrimination (a [taking] quoting '[done]' in prose is NOT a [done])
  [ "$(claim_body_if '2026-07-03T10:00:00Z  who@host  ::  [done] chat-review/foo-bar: x' done)" = "[done] chat-review/foo-bar: x" ] || { echo "FAIL: claim_body_if missed a real [done] body-start (2-space field sep)"; e=$((e+1)); }
  claim_body_if '2026-07-03T10:00:00Z  who@host  ::  [taking] chat-review/foo-bar: earlier marked [done]' done >/dev/null && { echo "FAIL: claim_body_if read a [taking] (prose-quoting [done]) as a [done]"; e=$((e+1)); } || true
  claim_body_if "2026-07-03T10:00:00Z  who@host  ::  [chat-review] a review whose prose quotes [done] chat-review/foo-bar" done >/dev/null && { echo "FAIL: claim_body_if read a [chat-review] as a [done]"; e=$((e+1)); } || true
  # source guard (falsifiable): the is_open done-scan must run claim_id_of on the claim body, not the old
  # substring '*"[done]"*"$id"*'. Revert to that substring → this FAILs (phantom-match returns).
  grep -qF 'claim_body_if "$line" done' "$0" || { echo "FAIL: is_open [done] scan not subject-anchored (unanchored re-enables prose-citation phantom-match)"; e=$((e+1)); }
  grep -qF 'claim_body_if "$line" taking' "$0" || { echo "FAIL: is_open [taking] scan not subject-anchored"; e=$((e+1)); }
  # PACE PLACEMENT (chat-review/pace-noop-consumes-slot): the spend-governor gate must NOT sit at the top
  # (where a no-op tick records-consumes the GAP); it must live DOWN at the verified real dispatch. Top of
  # file (pre-test) must be pace-free; the gate must still exist below. Falsifiable: move it back up → FAIL.
  head -45 "$0" | grep -q 'mesh-pace dispatch' && { echo "FAIL: pace gate at top — a no-op tick burns the GAP"; e=$((e+1)); }
  grep -q 'mesh-pace dispatch' "$0" || { echo "FAIL: spend-governor gate removed entirely"; e=$((e+1)); }
  # owner-routable prefilter (chat-review/dispatch-idle-gate-starves-owner-direct): when no generic WORKER
  # is idle, an "owner:"-tagged task is a candidate for owner-direct routing to its own idle owner window;
  # a tag-less task is not. The prefilter is a cheap gate before the authoritative mesh-mind-control
  # --owner-route resolution — it must match the tag and only the tag.
  case 'chat-review/gh-pages: retrigger (owner: pub)' in *[oO][wW][nN][eE][rR]:*) ;; *) echo "FAIL: owner-tag prefilter missed a tagged task"; e=$((e+1)) ;; esac
  case 'plain task with no owner tag'                  in *[oO][wW][nN][eE][rR]:*) echo "FAIL: owner-tag prefilter false-positive"; e=$((e+1)) ;; *) ;; esac
  # the owner-direct fallback must NOT re-implement owner resolution locally — it delegates to
  # mesh-mind-control --owner-route (single source of truth). Falsifiable: drop the call → FAIL.
  grep -q 'mesh-mind-control --owner-route' "$0" || { echo "FAIL: owner-route delegation removed (owner tasks starve when pool busy)"; e=$((e+1)); }
  # HUMAN-OWNED ANNOUNCE PLACEMENT (chat-review/human-owned-announce-pace-starved): the hold-announce
  # scan must run UNCONDITIONALLY, before mesh-pace is ever consulted — a scan placed AFTER the pace
  # gate would inherit the exact starvation this fix exists to close (a PACE-SKIPped pass would never
  # reach it, same as the original otrc=5 announce buried inside the paced --dispatch call).
  # Falsifiable: move the scan below the pace gate → FAIL.
  command -v mesh-mind-control >/dev/null 2>&1 || { echo "FAIL: dep mesh-mind-control"; e=$((e+1)); }
  grep -q -- '--owner-hold-announce' "$0" || { echo "FAIL: owner-hold-announce scan removed from mesh-dispatch"; e=$((e+1)); }
  oha_line=$(grep -n -- '--owner-hold-announce' "$0" | head -1 | cut -d: -f1)
  pace_line=$(grep -n 'mesh-pace dispatch' "$0" | tail -1 | cut -d: -f1)
  { [ -n "$oha_line" ] && [ -n "$pace_line" ] && [ "$oha_line" -lt "$pace_line" ]; } \
    || { echo "FAIL: owner-hold-announce scan not positioned before the pace gate (would re-inherit the starvation)"; e=$((e+1)); }
  [ "$e" -eq 0 ] && echo "smoke: ok (48 assertions)" || { echo "smoke: FAIL ($e fail(s))"; exit 1; }
  exit 0
fi

mkdir -p "$MESH"; touch "$STATE"

# normalize text -> signature: lowercase, alnum-only, first 48 chars (stable per-task id)
norm(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]' | cut -c1-48; }
# a task's KEY: first SHOUTY token (>=5 of A-Z plus hyphen) — the board's de-facto task id
# (HARDWARE-CARE, MIND-ALLOCATION, TV-as-WATCHED-ORGAN ...). "" when a task has none.
keyof(){ printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1; }
# a task's SLUG: the distinctive id for modern lowercase tasks shaped "namespace/slug: desc" or
# "slug: desc" (chat-review/delegation-worker-health -> delegation-worker-health). Keyed on the
# stable hyphenated slug so a claim is matched even when its [done] DROPS the "namespace/" prefix or
# rewords the description (the 2026-06-20 re-dispatch harm: [task] "chat-review/delegation-worker-
# health" vs [done] "delegation-worker-health" — the old 30-char-prefix match included "chat-review/"
# and missed it). "" when the task has no hyphenated slug (falls back to the prefix match).
slugof(){ local h="${1%%:*}"; h="${h##*/}"; h="$(printf '%s' "$h" | tr -cd '[:alnum:]-')"
  case "$h" in *-*) [ "${#h}" -ge 6 ] && printf '%s' "$h" ;; esac; }
# a task's stable ID = its SLUG when it has one (collision-free, distinctive), else the SHOUTY KEY.
# SLUG-FIRST: keyof scrapes the first SHOUTY word from the WHOLE task INCL. its DESCRIPTION, which for
# a modern "ns/slug: desc" task is just an emphasized desc word that COLLIDES with any old [done]/
# [taking] merely CONTAINING it (2026-06-22: chat-review/strand-autoland-eligibility keyed on
# 'EXCLUDED', household-edge-dwell on 'STATE' — both matched unrelated 2-day-old [done]s → is_open
# false-closed them → dispatch logged "idle [genome] but no open task" while real backlog sat). The
# slug captures the id for BOTH styles (ns/slug→slug, HARDWARE-CARE→HARDWARE-CARE); key is the
# fallback ONLY for a single-word no-hyphen shouty task (NOVELTY, SMOKE).
idof(){ local s; s="$(slugof "$1")"; if [ -n "$s" ]; then printf '%s' "$s"; else keyof "$1"; fi; }
# claim_id_of <claim-body>: the id a CLAIMS line is ABOUT = its OWN SUBJECT id, taken as the FIRST
# slug-shaped token (a slashed ns/slug path — ns may itself contain hyphens like "chat-review/" — or a
# bare hyphen-slug), else the first SHOUTY key. The subject leads; any LATER slug is prose citation.
# Keying on the subject (not substring-anywhere) is what stops chat-review/dispatch-claim-match-unanchored:
# the inner is_open scans matched *"[done]"*"$id"* — a real [done]/[taking] for task A whose prose merely
# CITES task B's slug (routine in a review that compares siblings) false-registered as B's own claim and
# silently evaporated B. Robust to the [done] "stale:"/"rejected:" qualifier prefix and a dropped "ns/"
# (the slug is found wherever it FIRST appears), so it never regresses the 2026-06-20 prefix-drop match.
claim_id_of(){
  local s
  s="$(printf '%s' "$1" | grep -oE '([a-z0-9]+(-[a-z0-9]+)*/)+[a-z0-9]+(-[a-z0-9]+)+|[a-z0-9]+(-[a-z0-9]+)+' | head -1)"
  s="${s##*/}"
  if [ -n "$s" ] && [ "${#s}" -ge 6 ]; then printf '%s' "$s"; return; fi
  printf '%s' "$1" | grep -oE '[A-Z][A-Z-]{4,}' | head -1
}
# claim_body_if <line> <marker>: echo the claim BODY ("[marker] subject: …") iff LINE is a body-START
# <marker> claim, else return 1 with no output. Pure param-expansion internally (the loops pre-filter on
# the id substring first, so this runs only on the few candidate lines). Strips the "<ts>  <who>  ::  "
# field prefix (robust to the board's 1-or-2 spaces) then requires the marker at the very start. This is
# the body-START discipline the CLAIMS grep and [task] scrape use; here it gates WHICH marker a line is,
# so a [taking] whose prose quotes "[done]" can never be read as a [done].
claim_body_if(){
  local rest="${1#*:: }"                         # drop through the "::" field separator
  rest="${rest#"${rest%%[![:space:]]*}"}"        # ltrim any residual leading space
  case "$rest" in "[$2] "*) printf '%s' "$rest" ;; *) return 1 ;; esac
}
# tasks addressed to a non-worker role are not for the generic claude worker pool
# addressed_elsewhere: hold tasks explicitly addressed TO a named window (exact 'window:' / 'window '
# prefix) from the generic worker pool. The trailing charclass is [: ] and must NOT include '-'
# (chat-review/operator-ask-dispatch-invisible 2026-07-04): '^operator-' swallowed tg's 'operator-ask:'
# prefix — operator-REQUESTED work filed FOR workers — so it was skipped before is_open ever saw it:
# never dispatched, never evaporated, invisible (camera-object-recognition sat open 2h+ while the
# dispatcher logged 'no open task' 8×). 'tg-mind' stays matched via its explicit alternative.
# KEEP IN SYNC with the --test twin definition above.
addressed_elsewhere(){ printf '%s' "$1" | grep -qiE '^(tg|tg-mind|planner|operator|steward|room)[: ]'; }

idle_workers(){
  local w line st
  for w in $WORKERS; do
    line="$(mesh-mind-state "$w" 2>/dev/null | head -1)"; st="${line%%	*}"
    [ "$st" = IDLE ] && printf '%s\n' "$w"
  done
}

# claims blob: [taking]/[dispatch]/[done] lines (raw). A task is "claimed" if its KEY/SLUG (or, both
# absent, its signature prefix) shows up here, or its signature is in the state file.
# Matched against the FULL board, NOT the LOOKBACK tail: a task's [done]/[taking] can age out of the
# tail while its [task] line is still in view -> the task looks open again and gets RE-DISPATCHED
# (the 2026-06-20 board-evaporation harm — a 9h-old [done] task re-issued to genome). grep over the
# whole chat.log is cheap (~1MB, sub-10ms) and runs every 5min. [task] collection stays tail-bounded
# (we only dispatch RECENT open work), but a claim from ANY time correctly closes it.
# ANCHORED to the message-BODY start (chat-review/dispatch-claims-source-unanchored): the marker must sit
# right after the "::" field separator — mirror the OPEN [task] anchor (~line 289), NOT a bare substring
# match. Unanchored, a post whose PROSE quotes [done]/[taking]/[dispatch] (routine when a chat-review
# explains this very bug class) was swept into CLAIMS and trusted by all three consumers (done-age ~216,
# taking-age ~231, slug-first closure ~270) → the poster's own task self-poisoned and never reached OPEN.
CLAIMS="$(grep -E '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[(taking|dispatch|done)\]' "$CHAT" 2>/dev/null || true)"

# EVAPORATION: a [task] with a matching [done] >30min ago OR no [taking] >4h gets an [evaporated]
# marker (recorded to the TRACE tier) and is excluded from dispatch (chat-review/board-task-evaporation).
# Parse timestamps from CLAIMS lines: "2026-06-20T13:40:01Z  user@host  ::  [done] chat-review/..."
claim_ts(){ local line="$1"; printf '%s' "$line" | cut -d' ' -f1 | sed 's/T/ /; s/Z$//'; }
# posted_stale POST_EPOCH NOW → true only if the task's own post time is KNOWN (>0) and older than
# STALE_TTL. A fresh, never-taken task is NOT stale — it is exactly what dispatch should ROUTE.
posted_stale(){ [ "${1:-0}" -gt 0 ] && [ $(( $2 - $1 )) -gt "$STALE_TTL" ]; }

# Record an [evaporated] marker for a task that has evaporated.
# Routed to the TRACE tier (mesh-trace → traces.log), NOT the coordination board: an [evaporated] is
# pure JANITORIAL bookkeeping (a [task] expired) — no mind coordinates on it, nothing greps it from the
# board, and a stale-task sweep can burst dozens at once (37 in one second on 2026-06-20) which spammed
# the board AND false-tripped the mesh-criticality branching-ratio vital-sign supercritical (the burst
# landed in one bin). Same de-noise pattern as [autowired]→trace / [compact]→log / [sense-evolve]→trace:
# routine substrate self-tend belongs in the durable metabolism tier, not the coordination signal.
# (mesh-criticality's meta-gate also classifies [evaporated] as observer-chatter — defense in depth.)
# Dedup: only record once per task-id (in EVAP_STATE), unchanged.
evaporated_post(){
  local task="$1" id="$2" reason="$3"
  local now sig
  now=$(date -u +%s)
  sig="evap:$id"
  # Check if already recorded
  if [ -f "$EVAP_STATE" ] && grep -qxF "$sig" "$EVAP_STATE" 2>/dev/null; then
    return 0
  fi
  # Record to the durable trace tier (not the board)
  command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="dispatch@$(hostname)" \
    mesh-trace "[evaporated] $id: $reason" >/dev/null 2>&1 || true
  # Record the dedup signature
  mkdir -p "$MESH"
  printf '%s\n' "$sig" >>"$EVAP_STATE"
}

is_open(){
  local task="$1" task_post_ts="${2:-0}" key slug sig id reason now done_ts taking_ts done_seen body
  sig="$(norm "$task")"; [ -n "$sig" ] || return 1
  grep -qxF "$sig" "$STATE" 2>/dev/null && return 1            # already dispatched by us
  # Check evaporation and post marker if first time
  key="$(keyof "$task")"
  slug="$(slugof "$task")"
  id="$(idof "$task")"      # slug-first (see idof): never a SHOUTY word scraped from the description
  if [ -n "$id" ]; then
    now=$(date -u +%s)
    # Check [done] > 30min. done_seen tracks whether ANY [done] exists for this id (at any age) — it
    # guards the abandoned-claim re-open below from firing on a task that is actually COMPLETE but whose
    # [done] is still <30min fresh (recently-done + old-[taking] = done, not abandoned).
    done_seen=0
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      # a [done] for THIS task = a body-START [done] whose OWN SUBJECT id == $id — NOT a [done] about
      # another task that merely QUOTES this slug in prose (chat-review/dispatch-claim-match-unanchored).
      # Cheap id-substring pre-filter (subshell-free, as selective as the old match) → then precise check.
      case "$line" in *"$id"*) ;; *) continue ;; esac
      body="$(claim_body_if "$line" done)" || continue
      [ "$(claim_id_of "$body")" = "$id" ] || continue
      done_seen=1
      done_ts=$(date -u -d "$(claim_ts "$line")" +%s 2>/dev/null) || continue
      if [ $(( now - done_ts )) -gt 1800 ]; then
        evaporated_post "$task" "$id" "done >30min ago"
        return 1
      fi
    done <<< "$CLAIMS"
    # Check [taking] > 4h or never taken
    taking_ts=0
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      # a [taking] for THIS task = a body-START [taking] whose OWN SUBJECT id == $id (same phantom-match
      # guard as the [done] scan above — a [taking]/[done] citing this slug in prose must not count).
      case "$line" in *"$id"*) ;; *) continue ;; esac
      body="$(claim_body_if "$line" taking)" || continue
      [ "$(claim_id_of "$body")" = "$id" ] || continue
      local ts=$(date -u -d "$(claim_ts "$line")" +%s 2>/dev/null) || continue
      [ "$ts" -gt "$taking_ts" ] && taking_ts="$ts"
    done <<< "$CLAIMS"
    if [ "$taking_ts" -eq 0 ]; then
      # NEVER taken. Evaporate ONLY if the task's OWN post is genuinely stale (>STALE_TTL).
      # A FRESH unclaimed task is NOT evaporated — it is exactly what dispatch must ROUTE to an
      # idle worker. (2026-06-20 bug: the bare "never taken → evaporate" had NO age gate, so a
      # just-posted task was evaporated before it could be routed → dispatch logged "idle worker
      # but no open task" while real open tasks sat on the board, silently dropping the backlog.)
      if posted_stale "$task_post_ts" "$now"; then
        evaporated_post "$task" "$id" "never taken, posted >$(( STALE_TTL / 3600 ))h ago"
        return 1
      fi
      # fresh & unclaimed → fall through → dispatchable
    elif [ $(( now - taking_ts )) -gt "$STALE_TTL" ]; then
      if [ "$done_seen" = 1 ]; then
        # Recently-[done] (<30min) but an old [taking] — the task is COMPLETE, not abandoned. Close it as
        # before (the <30min [done] simply hasn't crossed the 30min evaporation line yet).
        evaporated_post "$task" "$id" "taking >$(( STALE_TTL / 3600 ))h ago"
        return 1
      fi
      # ABANDONED CLAIM: a real-slug [taking] >TTL with NO [done] ANYWHERE on the board = the worker
      # died / was restarted / was compacted before finishing (the mesh restarts minds often —
      # channel-keepalive */4, /compact, thermal shed), so the claim is stale and the work was silently
      # LOST. RE-OPEN it (return 0 → dispatchable) so a fresh idle worker recovers it, instead of the old
      # behaviour that EVAPORATED it (dropped the work). Storm-safe: a successful re-dispatch writes the
      # task signature to $STATE, so the `grep $STATE` at the top closes it next pass — exactly ONE
      # recovery attempt per abandoned task (if the re-dispatched worker also dies, sig-in-STATE keeps it
      # closed; no infinite re-dispatch). The verify-first dispatch framing covers the rare genuinely
      # >TTL-still-running task (the picked worker posts '[done] stale' rather than redo it).
      # (genome-mind diagnosis 2026-06-20: knowledge/stale-taking-evaporation-misdiagnosis.)
      return 0
    fi
  fi
  # SLUG-FIRST (see idof): match the collision-free slug before the noisy SHOUTY key, so a desc word
  # like EXCLUDED/STATE never false-matches an unrelated claim line and strands the task.
  if [ -n "$slug" ]; then
    printf '%s\n' "$CLAIMS" | grep -qiF "$slug" && return 1    # ns/slug id appears in a claim line
  elif [ -n "$key" ]; then
    printf '%s\n' "$CLAIMS" | grep -qiF "$key" && return 1     # single-word SHOUTY id (no hyphen-slug)
  else
    printf '%s\n' "$CLAIMS" | grep -qiF "$(printf '%s' "$task" | cut -c1-30)" && return 1
  fi
  return 0
}

# collect open [task] lines, oldest first.
# ANCHOR [task] to the start of the message BODY (right after the "::" field separator) — a [task]
# appearing mid-PROSE (e.g. "...a stale [task] re-dispatch...") is NOT a real task and must never be
# scraped + re-dispatched (the 2026-06-15 phantom-task loop: a [void] post's prose was re-dispatched).
# The anchor matches the FIELD-STRUCTURE, not just "::"+[task]: <ts> <who> :: [task]. The old
# `::[[:space:]]+\[task\]` matched ANY ":: [task]" substring — so a message whose BODY quoted the
# board syntax (e.g. a review writing "a mirrored ':: [task] …' line") was re-dispatched as its own
# prose fragment (2026-06-21: a [done] about THIS very gap got re-fed as a task — live reproduction).
# ts (single ':') and who ('user@host') never contain '::', so the first '::' here IS the separator.
mapfile -t OPEN < <(
  tail -n "$LOOKBACK" "$CHAT" 2>/dev/null | grep -E '^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::[[:space:]]+\[task\][[:space:]]' | while IFS= read -r line; do
    task="${line#*\[task\] }"
    [ "$task" != "$line" ] || continue
    addressed_elsewhere "$task" && continue
    post_ts=$(date -u -d "$(claim_ts "$line")" +%s 2>/dev/null || echo 0)
    is_open "$task" "$post_ts" && printf '%s\n' "$task"
  done
)

idle="$(idle_workers)"
n_idle=$(printf '%s' "$idle" | grep -c . || true)
n_open=${#OPEN[@]}

if [ "${1:-}" = --status ]; then
  echo "=== mesh-dispatch · $(ts) ==="
  echo "idle workers ($n_idle): $(printf '%s ' ${idle:-none})"
  echo "open tasks   ($n_open):"
  [ "$n_open" -gt 0 ] && printf '  - %s\n' "${OPEN[@]:0:8}" | cut -c1-110 || echo "  (none)"
  exit 0
fi

# HUMAN-OWNED HOLD ANNOUNCE (chat-review/human-owned-announce-pace-starved): a board [fyi] wakes no
# mind and costs no paid tokens, so it must never wait behind mesh-pace's paid-dispatch throttle nor
# consume the single per-pass pick below. Runs UNCONDITIONALLY every pass (idle-worker state, thermal
# hold, and mesh-pace are all consulted further down and are irrelevant here) — before this, the ONLY
# path to the announce was mesh-mind-control --dispatch's otrc=5 branch, reached ONLY after a task
# became THIS pass's single pick AND cleared the pace gate; a human-owned task buried behind other
# OPEN tasks, or whose pass PACE-SKIPped, sat invisible for hours (live: restore-router-reach-operator,
# 2h+). --owner-hold-announce does its own one-shot dedup, so a repeat scan of an already-announced
# task is a silent no-op (rc=1, nothing printed).
for t in "${OPEN[@]}"; do
  case "$t" in *[oO][wW][nN][eE][rR]:*) ;; *) continue ;; esac
  mesh-mind-control --owner-hold-announce "$t" >>"$LOG" 2>&1
done

# No idle GENERIC worker — but an owner-tagged [task] can still be routed straight to its OWN idle owner
# window (pub/room/senses/health/discover), which mesh-dispatch's WORKERS-only idle_workers() never sees.
# Without this, a busy genome (the sole live WORKER) starves EVERY owner-direct task for the whole pass —
# the [task] never even reaches mesh-mind-control's owner-direct routing (chat-review/dispatch-idle-gate-
# starves-owner-direct; live: gh-pages owner:pub sat 2h+ unrouted while genome was busy). Resolve the owner
# AUTHORITATIVELY via `mesh-mind-control --owner-route` (the single source of _owner_target's slash/
# code_wins logic — never re-parsed here) so we proceed ONLY when the owner is genuinely idle+healthy, i.e.
# mind-control WILL dispatch it — never a to-be-HELD task past the pace gate (chat-review/pace-noop-consumes-slot).
owner_task=""
if [ -z "$idle" ]; then
  for t in "${OPEN[@]}"; do
    case "$t" in *[oO][wW][nN][eE][rR]:*) ;; *) continue ;; esac        # cheap prefilter: owner-tagged only
    if [ -n "$(mesh-mind-control --owner-route "$t" 2>/dev/null)" ]; then owner_task="$t"; break; fi
  done
  [ -n "$owner_task" ] && echo "$(ts) dispatch: no idle WORKER but owner-routable task found → owner-direct: $(printf '%s' "$owner_task" | cut -c1-70)" >>"$LOG"
  [ -n "$owner_task" ] || { echo "$(ts) dispatch: no idle worker (+ no owner-routable task) — no-op" >>"$LOG"; exit 0; }
fi
[ "$n_open" -eq 0 ] && { echo "$(ts) dispatch: idle [$idle] but no open task — no-op" >>"$LOG"; exit 0; }

# THERMAL HOLD (mirrors mesh-tick's new-load shed). Dispatching a [task] kicks off NEW heavy inference
# on THIS CPU — exactly the load that pushes a throttling core toward the 100-102°C shutdown ceiling
# (2026-06-21: this node hit 101°C while dispatch kept PUSHING work, thermally blind). So when the
# hottest zone is in the active-throttle band, HOLD this pass: the task stays OPEN and re-dispatches
# next */5 cycle once cool. Same philosophy as tick — shed NEW load, never touch a RUNNING mind (a
# reniced/killed mind loses work + is irreversible unprivileged here). Cross-node offload is the better
# lever but is operator-gated off (minds-IdeaPad-only, 2026-06-17). Fail-open: unreadable sensor →
# dispatch normally. Peer ticks don't run this path. Threshold reuses tick's band for one knob.
THERM_MAX="${MESH_DISPATCH_THERMAL_MAX:-${MESH_TICK_THERMAL_MAX:-92}}"
t_now=""
for z in /sys/class/thermal/thermal_zone*/temp; do
  [ -r "$z" ] || continue; v=$(cat "$z" 2>/dev/null) || continue
  case "$v" in ''|*[!0-9]*) continue;; esac; v=$((v/1000))
  if [ -z "$t_now" ] || [ "$v" -gt "$t_now" ]; then t_now=$v; fi
done
if thermal_hold "$t_now" "$THERM_MAX"; then
  echo "$(ts) dispatch: THERMAL-HOLD — ${t_now}C >= ${THERM_MAX}C, defer ($n_open open task(s) stay open; retry next cycle)" >>"$LOG"
  exit 0
fi

# one dispatch per pass: hand the OLDEST open task to a free worker (mesh-mind-control picks which).
# When the generic WORKER pool was busy but an owner-routable task was found above, dispatch THAT task
# (its idle owner is the target); otherwise the oldest open task as usual.
task="${owner_task:-${OPEN[0]}}"
sig="$(norm "$task")"
# Framing requires VERIFY-FIRST, not blind compliance. A freshly-minted audit [task] can name an
# issue already resolved under a different description (the slug is new, so claim-matching can't catch
# it — the 2026-06-20 senses-launch-config phantom) OR carry a mis-specified/harmful instruction (that
# same task said add '--permission-mode auto' to opencode, which has no such flag → would crash senses).
# So the worker is told to verify the task is live + correct BEFORE acting, and to push back (a [done]
# that closes it) rather than regress a healthy system. Makes the cheap re-check the expected first
# step, not wasted ticks — and encodes honest-pushback into every dispatch.
framed="Board task assigned to you. FIRST verify it is still live AND the instruction is correct against the CURRENT code/state — audit tasks are often already resolved or mis-specified. If already done: post '[done] stale: $task — already resolved (cite where)' and STOP. If the instruction is wrong or would regress something: post '[done] rejected: <why>' and STOP (honest pushback beats blind compliance). Otherwise do it now, then post '[done] <short result>'. TASK: $task"

# SPEND GOVERNOR gate (relocated from the top — chat-review/pace-noop-consumes-slot): consult mesh-pace
# HERE, at the verified real mind-wake (past every no-op exit above), so ONLY an actual dispatch consumes
# the GAP. skip = this task stays OPEN and re-dispatches next */5 cycle; mesh-pace exit-1 does NOT record,
# so a skipped tick costs nothing. Fail-open if mesh-pace is absent.
command -v mesh-pace >/dev/null 2>&1 && { mesh-pace dispatch || { echo "$(ts) dispatch: PACE-SKIP — gap not elapsed, $n_open task(s) stay open, retry next cycle" >>"$LOG"; exit 0; }; }
out="$(mesh-mind-control --dispatch "$framed" 2>&1)"; rc=$?
if [ "$rc" -eq 0 ]; then
  printf '%s\n' "$sig" >>"$STATE"
  echo "$(ts) dispatch: $out" >>"$LOG"
  echo "$out"
else
  echo "$(ts) dispatch: NOT routed (rc=$rc): $out" >>"$LOG"
  echo "$out"
fi
exit 0
