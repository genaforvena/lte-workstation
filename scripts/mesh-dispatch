  grep -F 'CLAIMS="$(grep' "$0" | grep -qF '::[[:space:]]+\[(taking' || { echo "FAIL: CLAIMS source not anchored to body-start (unanchored re-enables prose-marker self-poison)"; e=$((e+1)); }
  # CLAIM SUBJECT-ID match (chat-review/dispatch-claim-match-unanchored): the is_open [done]/[taking] scans
  # must key on a claim's OWN subject id (first slug/shouty token), NOT the id appearing ANYWHERE in the
  # line — else a real [done]/[taking] for task A whose prose CITES task B's slug false-closes B (B's task
  # silently evaporated with ZERO dispatch, the exact reproduced harm: default-string-strand-no-task).
  claim_id_of(){ local s body lead tag; tag="$(printf '%s' "$1" | grep -oE 'task:[A-Za-z0-9][A-Za-z0-9/._-]*' | head -1)"; [ -n "$tag" ] && { tag="${tag#task:}"; tag="${tag##*/}"; printf '%s' "$tag"; return; }; body="$(printf '%s' "$1" | sed -E 's/^(\[[a-z_-]+\]) [a-z][a-z_-]*@[A-Za-z0-9._-]+: /\1 /' | sed -E 's/^(\[[a-z_-]+\]) [a-z][a-z_-]* loop-baton: /\1 /' | sed -E 's/^(\[dispatch\]) → [a-zA-Z0-9_-]+ \([^()]*\): /\1 /' | sed -E 's/^(\[[a-z_-]+\]) [a-z][a-z0-9_]*: /\1 /')"; lead="${body%%:*}"; s="$(printf '%s' "$lead" | grep -oE "$MESH_SLUG_PATH_RE" | head -1)"; [ -n "$s" ] || s="$(printf '%s' "$lead" | grep -oE "$MESH_SLUG_TOK_RE" | head -1)"; if [ -z "$s" ]; then s="$(printf '%s' "$body" | grep -oE "$MESH_SLUG_PATH_RE" | head -1)"; [ -n "$s" ] || s="$(printf '%s' "$body" | grep -oE "$MESH_SLUG_TOK_RE" | head -1)"; fi; s="${s##*/}"; if [ -n "$s" ] && [ "${#s}" -ge "$MESH_SLUG_MIN_LEN" ]; then printf '%s' "$s"; return; fi; printf '%s' "$body" | grep -oE '[A-Z][A-Z-]{4,}' | head -1; }
  claim_body_if(){ local rest="${1#*:: }"; rest="${rest#"${rest%%[![:space:]]*}"}"; case "$rest" in "[$2] "*) printf '%s' "$rest" ;; *) return 1 ;; esac; }
  # a claim resolves to its OWN subject, robust to ns/ prefix, dropped prefix, stale:/rejected: qualifier, shouty
  [ "$(claim_id_of '[done] chat-review/foo-bar-baz: shipped')"        = "foo-bar-baz" ]  || { echo "FAIL: claim_id_of ns/slug subject"; e=$((e+1)); }
