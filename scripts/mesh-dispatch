    || { echo "FAIL: the SAME board line without the window lead derives a different id — the control shape is broken, so the arm above proves nothing"; e=$((e+1)); }
  [ "$(claim_id_of "$_wl_line")" = "$(claim_id_of "${_wl_line/senses: /}")" ] \
