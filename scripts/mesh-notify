#!/usr/bin/env bash
# mesh-notify — desktop-notification actuator: pop a visual alert on the human's screen.
#
#   mesh-notify "<title>" "<body>"
#   mesh-notify --test       smoke test (check notify-send present, no notification fired)
#
# Required: notify-send + graphical DBUS session bus (/run/user/<uid>/bus).
# If the GUI/DBUS is unavailable, prints why and exits nonzero (honest capability).
set -uo pipefail

# Agents run from tmux/SSH without DISPLAY even when a graphical session is live —
# fall back to the first X socket so the notification still reaches the screen.
if [ -z "${DISPLAY-}" ] && [ -z "${WAYLAND_DISPLAY-}" ]; then
  for sock in /tmp/.X11-unix/X*; do
    [ -e "$sock" ] || continue
    DISPLAY=":${sock##*/X}"
    export DISPLAY
    break
  done
fi

if [ "${1:-}" = "--test" ]; then
  command -v notify-send >/dev/null 2>&1 || { echo "smoke-test: FAIL (notify-send not found)"; exit 1; }
  command -v id >/dev/null 2>&1 || { echo "smoke-test: FAIL (no id)"; exit 1; }
  DBUS_SOCKET="/run/user/$(id -u)/bus"
  [ -S "$DBUS_SOCKET" ] || { echo "smoke-test: FAIL (no DBUS session socket)"; exit 1; }
  [ -n "${DISPLAY-}" ] || [ -n "${WAYLAND_DISPLAY-}" ] || { echo "smoke-test: FAIL (no DISPLAY — headless node, notify useless)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

TITLE="${1:?usage: mesh-notify <title> <body>}"
BODY="${2:?usage: mesh-notify <title> <body>}"

command -v notify-send >/dev/null 2>&1 || { echo "mesh-notify: notify-send not found — no desktop notification capability" >&2; exit 1; }

DBUS_SOCKET="/run/user/$(id -u)/bus"
if [ ! -S "$DBUS_SOCKET" ]; then
  echo "mesh-notify: no DBUS session socket at $DBUS_SOCKET — no graphical session" >&2
  exit 1
fi
if [ -z "${DISPLAY-}" ] && [ -z "${WAYLAND_DISPLAY-}" ]; then
  echo "mesh-notify: no DISPLAY set — headless node, notifications cannot reach a user" >&2
  exit 1
fi

DBUS_SESSION_BUS_ADDRESS="unix:path=$DBUS_SOCKET"
export DBUS_SESSION_BUS_ADDRESS

if notify-send "$TITLE" "$BODY" --app-name=mesh --urgency=normal --expire-time=8000 2>/dev/null; then
  exit 0
else
  echo "mesh-notify: notify-send failed — notification daemon unreachable or rejected" >&2
  exit 1
fi
