#!/usr/bin/env bash
# mesh-notify — desktop-notification actuator: pop a visual alert on the human's screen.
#
#   mesh-notify "<title>" "<body>"
#
# Required: notify-send + graphical DBUS session bus (/run/user/<uid>/bus).
# If the GUI/DBUS is unavailable, prints why and exits nonzero (honest capability).
set -uo pipefail

TITLE="${1:?usage: mesh-notify <title> <body>}"
BODY="${2:?usage: mesh-notify <title> <body>}"

command -v notify-send >/dev/null 2>&1 || { echo "mesh-notify: notify-send not found — no desktop notification capability" >&2; exit 1; }

DBUS_SOCKET="/run/user/$(id -u)/bus"
if [ ! -S "$DBUS_SOCKET" ]; then
  echo "mesh-notify: no DBUS session socket at $DBUS_SOCKET — no graphical session" >&2
  exit 1
fi

DBUS_SESSION_BUS_ADDRESS="unix:path=$DBUS_SOCKET"
export DBUS_SESSION_BUS_ADDRESS

if notify-send "$TITLE" "$BODY" --app-name=mesh --urgency=normal --expire-time=8000 2>/dev/null; then
  exit 0
else
  echo "mesh-notify: notify-send failed — notification daemon unreachable or rejected" >&2
  exit 1
fi