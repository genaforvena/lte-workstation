#!/usr/bin/env bash
# mesh-ambient-level — ambient sound level sense (IdeaPad mic)
#
# Reads 1s of audio from the built-in mic, computes RMS dB, classifies level.
# Zero phone dependency — runs entirely on the IdeaPad.
#
# Output: SILENCE / QUIET / MODERATE / LOUD + dB reading
# Exit 2 = mic unreachable (no capture device, arecord fails)
#
#   mesh-ambient-level           one-shot reading, print + state file
#   mesh-ambient-level --json    machine-readable
#   mesh-ambient-level --test    smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
STATE_FILE="$MESH/.ambient-level"
SAMPLE_WAV="$MESH/.ambient-sample.wav"
DURATION=1
RATE=16000

# --- Test ---
if [ "${1:-}" = --test ]; then
  command -v arecord >/dev/null 2>&1 || { echo "smoke-test: FAIL (no arecord)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # Must produce a valid classification, or exit 2 if mic unavailable
  ec=0
  out="$("$0" --json 2>/dev/null)" || ec=$?
  if [ "$ec" -eq 2 ]; then
    echo "smoke-test: ok (mic unreachable — exit 2 is valid)"; exit 0
  fi
  [ "$ec" -eq 0 ] || { echo "smoke-test: FAIL (tool errored exit $ec)"; exit 1; }
  label="$(printf '%s' "$out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label",""))' 2>/dev/null)"
  case "$label" in
    SILENCE|QUIET|MODERATE|LOUD) : ;;
    *) echo "smoke-test: FAIL (unexpected label '${label:-empty}')"; exit 1 ;;
  esac
  echo "smoke-test: ok"; exit 0
fi

# --- Capture ---
tmp_wav="$(mktemp /tmp/ambient-XXXXXX.wav)"
trap 'rm -f "$tmp_wav"' EXIT

if ! timeout 3 arecord -f S16_LE -r "$RATE" -c 1 -d "$DURATION" "$tmp_wav" 2>/dev/null; then
  echo "mesh-ambient-level: UNREACHABLE — mic capture failed (exit 2)"
  exit 2
fi

# --- Analyze ---
read -r rms_db peak_db label <<< "$(python3 -c "
import wave, math, struct, sys
try:
    w = wave.open('$tmp_wav', 'r')
    frames = w.readframes(w.getnframes())
    w.close()
    samples = struct.unpack('<%dh' % (len(frames)//2), frames)
    if not samples:
        print('-999 -999 SILENCE')
        sys.exit(0)
    # DC offset removal
    mean = sum(samples) / len(samples)
    centered = [s - mean for s in samples]
    # RMS
    rms = math.sqrt(sum(s*s for s in centered) / len(centered))
    rms_db = 20 * math.log10(rms / 32768) if rms > 0 else -999
    # Peak
    peak = max(abs(s) for s in centered)
    peak_db = 20 * math.log10(peak / 32768) if peak > 0 else -999
    # Classify
    if rms_db < -45:
        label = 'SILENCE'
    elif rms_db < -30:
        label = 'QUIET'
    elif rms_db < -20:
        label = 'MODERATE'
    else:
        label = 'LOUD'
    print(f'{rms_db:.1f} {peak_db:.1f} {label}')
except Exception as e:
    print(f'-999 -999 SILENCE', file=sys.stderr)
    print('-999 -999 SILENCE')
" 2>/dev/null)"

rms_db="${rms_db:--999}"
peak_db="${peak_db:--999}"
label="${label:-SILENCE}"

# --- Save state ---
printf '%s\n' "$label" > "$STATE_FILE"
printf '%s %s\n' "$rms_db" "$peak_db" > "$MESH/.ambient-level-db"

# --- JSON output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","rms_db":%s,"peak_db":%s,"duration":%d,"ts":"%s"}\n' \
    "$label" "$rms_db" "$peak_db" "$DURATION" "$(date -u +%FT%TZ)"
  exit 0
fi

# --- Board post on level change ---
prev_label=""
[ -f "$STATE_FILE" ] && prev_label="$(head -1 "$STATE_FILE" 2>/dev/null)"
if [ "$label" != "$prev_label" ] && [ -n "$prev_label" ]; then
  MESH_WHO="ambient@$(hostname)" ~/.local/bin/mesh-chat "[ambient-level] ${prev_label}→${label} (rms=${rms_db}dB)" 2>/dev/null
fi

printf 'ambient-level: %s (rms=%sdB peak=%sdB)\n' "$label" "$rms_db" "$peak_db"
