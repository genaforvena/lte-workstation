#!/home/mesh-home/.venv-tg/bin/python3
"""mesh-tg-user — operator Telegram USERBOT organ (reply AS the operator).

Read + draft-and-confirm send, driven by Telethon over the operator's OWN account
(session reused from tdl, ~/.tdl/data/default -> ~/.mesh/tg-userbot.session).

  READ  (safe):  me · unread · read <chat> [N]
  ACT  (gated):  draft <chat> <text>        # stages only, NEVER sends
                 send  <chat> <text> --confirm
                 reply <chat> <msg_id> <text> --confirm
                 mark-read <chat>

DRAFT-AND-CONFIRM DOCTRINE: send/reply are outward-facing and IRREVERSIBLE — a wrong
send to a real contact cannot be unsent. They REFUSE without --confirm (exit 3), print
the draft, and every real send is appended to ~/.mesh/tg-sent.log. The `draft` verb only
stages to ~/.mesh/tg-drafts/ and prints; it can never send. A mesh MIND composes a draft,
shows it to the operator, and only then runs `send ... --confirm`.

Node-bound: needs ~/.venv-tg (telethon) + the session file — mesh-home only. orphan-ok.
"""
# orphan-ok: node-bound userbot organ (venv + operator session on mesh-home only)
import asyncio, os, sys, base64, json, time, html

HOME = os.path.expanduser("~")
SESSION = os.path.join(HOME, ".mesh", "tg-userbot.session")
TDL_STORE = os.path.join(HOME, ".tdl", "data", "default")
DRAFT_DIR = os.path.join(HOME, ".mesh", "tg-drafts")
# OUR OWN log — ~/.mesh/tg-sent.log belongs to the mesh BOT organ (mesh-tg/voice-tx); never share it
SENT_LOG = os.path.join(HOME, ".mesh", "tg-userbot-sent.log")
# tdl uses the public Telegram Desktop app credentials
API_ID = 2040
API_HASH = "b18441a1ff607e10a989891a5462e627"
DC_IP = {1: "149.154.175.53", 2: "149.154.167.51", 3: "149.154.175.100",
         4: "149.154.167.91", 5: "91.108.56.130"}

try:
    from telethon import TelegramClient
    from telethon.sessions import StringSession
    from telethon.crypto import AuthKey
except Exception as e:
    print(f"telethon unavailable: {e}", file=sys.stderr)
    sys.exit(2)


def _bootstrap_session_from_tdl():
    """Build a StringSession from the tdl bolt store (one-time, or if session missing)."""
    data = open(TDL_STORE, "rb").read()
    i = data.find(b"session")
    j = data.find(b"{", i)
    depth = 0
    end = None
    for k in range(j, len(data)):
        if data[k] == 0x7B:
            depth += 1
        elif data[k] == 0x7D:
            depth -= 1
            if depth == 0:
                end = k + 1
                break
    obj = json.loads(data[j:end])["Data"]
    ak = base64.b64decode(obj["AuthKey"])
    dc = int(obj["DC"])
    s = StringSession()
    s.set_dc(dc, DC_IP[dc], 443)
    s.auth_key = AuthKey(ak)
    return s


def _load_session():
    if os.path.exists(SESSION):
        return StringSession(open(SESSION).read().strip())
    if os.path.exists(TDL_STORE):
        s = _bootstrap_session_from_tdl()
        os.makedirs(os.path.dirname(SESSION), exist_ok=True)
        open(SESSION, "w").write(s.save())
        os.chmod(SESSION, 0o600)
        return s
    print("no session: ~/.mesh/tg-userbot.session and ~/.tdl/data/default both absent",
          file=sys.stderr)
    sys.exit(2)


async def _client():
    c = TelegramClient(_load_session(), API_ID, API_HASH)
    await c.connect()
    if not await c.is_user_authorized():
        print("session not authorized (re-login needed)", file=sys.stderr)
        await c.disconnect()
        sys.exit(2)
    return c


async def _entity(c, arg, allow_fuzzy=True):
    """Resolve a chat arg to an entity.

    'me'/'self' -> Saved Messages (InputPeerSelf); @username / numeric id -> exact.
    A bare NAME is fuzzy-matched across dialogs ONLY when allow_fuzzy (read verbs).
    send/reply pass allow_fuzzy=False: a fuzzy name must NEVER drive an outward send
    (a bare 'me' once name-matched a channel and tried to post there)."""
    if arg in ("me", "self"):
        return "me"
    if arg.startswith("@"):
        return await c.get_entity(arg)
    try:
        return await c.get_entity(int(arg))
    except ValueError:
        pass
    if not allow_fuzzy:
        raise SystemExit(f"refusing to send to fuzzy name {arg!r} — use 'me', @username, or numeric id")
    low = arg.lower()
    async for d in c.iter_dialogs():
        if low in (d.name or "").lower():
            return d.entity
    raise SystemExit(f"no dialog matching name {arg!r}")


# ---------- verbs ----------
async def v_me(c, _):
    me = await c.get_me()
    print(f"{me.first_name or ''} {me.last_name or ''} | @{me.username or '-'} | id {me.id} | {me.phone}")


async def v_unread(c, args):
    limit = int(args[0]) if args else 0
    rows = []
    async for d in c.iter_dialogs():
        if d.unread_count and d.unread_count > 0:
            rows.append((d.unread_count, d.name, getattr(d.entity, "id", "?"),
                         "@" + d.entity.username if getattr(d.entity, "username", None) else ""))
    rows.sort(reverse=True)
    if limit:
        rows = rows[:limit]
    if not rows:
        print("no unread")
        return
    for cnt, name, cid, uname in rows:
        print(f"{cnt:>4}  {name[:32]:32} {cid} {uname}")


async def v_read(c, args):
    if not args:
        raise SystemExit("usage: read <chat> [N]")
    n = int(args[1]) if len(args) > 1 else 10
    ent = await _entity(c, args[0])
    msgs = await c.get_messages(ent, limit=n)
    for m in reversed(msgs):
        who = "me" if m.out else ((m.sender and (m.sender.first_name or getattr(m.sender, "title", None))) or "?")
        t = m.date.astimezone().strftime("%m-%d %H:%M")
        txt = (m.text or ("<%s>" % (m.media and type(m.media).__name__ or "")) or "").replace("\n", " ")
        print(f"[{m.id}] {t} {who}: {txt[:120]}")


async def v_draft(c, args):
    if len(args) < 2:
        raise SystemExit("usage: draft <chat> <text>")
    chat, text = args[0], " ".join(args[1:])
    os.makedirs(DRAFT_DIR, exist_ok=True)
    p = os.path.join(DRAFT_DIR, str(chat).replace("/", "_") + ".txt")
    open(p, "w").write(text)
    print(f"DRAFT staged (NOT sent) -> {p}")
    print(f"  to: {chat}\n  text: {text}")
    print(f"  send with:  mesh-tg-user send {chat} {text!r} --confirm")


async def _do_send(c, chat, text, reply_to=None):
    ent = await _entity(c, chat, allow_fuzzy=False)
    m = await c.send_message(ent, text, reply_to=reply_to)
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}\t{chat}\treply_to={reply_to}\t{text}".replace("\n", " ")
    with open(SENT_LOG, "a") as f:
        f.write(line + "\n")
    print(f"SENT [{m.id}] -> {chat}: {text}")


async def v_send(c, args):
    confirm = "--confirm" in args
    args = [a for a in args if a != "--confirm"]
    if len(args) < 2:
        raise SystemExit("usage: send <chat> <text> --confirm")
    chat, text = args[0], " ".join(args[1:])
    if not confirm:
        print("REFUSED: send is outward-facing and irreversible — pass --confirm.", file=sys.stderr)
        print(f"  would send to {chat}: {text}", file=sys.stderr)
        sys.exit(3)
    await _do_send(c, chat, text)


async def v_reply(c, args):
    confirm = "--confirm" in args
    args = [a for a in args if a != "--confirm"]
    if len(args) < 3:
        raise SystemExit("usage: reply <chat> <msg_id> <text> --confirm")
    chat, mid, text = args[0], int(args[1]), " ".join(args[2:])
    if not confirm:
        print("REFUSED: reply is outward-facing and irreversible — pass --confirm.", file=sys.stderr)
        print(f"  would reply in {chat} to msg {mid}: {text}", file=sys.stderr)
        sys.exit(3)
    await _do_send(c, chat, text, reply_to=mid)


async def v_mark_read(c, args):
    if not args:
        raise SystemExit("usage: mark-read <chat>")
    ent = await _entity(c, args[0])
    await c.send_read_acknowledge(ent)
    print(f"marked read: {args[0]}")


async def v_test(c, _):
    # real-read gate: a live authorized session must yield the operator's own id
    me = await c.get_me()
    assert me and me.id, "get_me returned no id"
    print(f"ok: authorized as id {me.id}")


VERBS = {"me": v_me, "unread": v_unread, "read": v_read, "draft": v_draft,
         "send": v_send, "reply": v_reply, "mark-read": v_mark_read, "test": v_test}


async def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    verb = sys.argv[1].lstrip("-")
    if verb not in VERBS:
        print(f"unknown verb {verb!r}; verbs: {' '.join(VERBS)}", file=sys.stderr)
        return 1
    c = await _client()
    try:
        await VERBS[verb](c, sys.argv[2:])
    finally:
        await c.disconnect()
    return 0


if __name__ == "__main__":
    sys.exit(asyncio.run(main()) or 0)
