[Unit]
Description=mesh phaedra :80->:443 socat fallback (SS-over-80 for port-restricted friend clients)
Documentation=file:///root/lte-workstation/knowledge/capability-phaedra-port80-fallback-20260704.md
After=network.target network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:80,reuseaddr,fork TCP:127.0.0.1:443
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
