#!/usr/bin/env bash
# mesh-tick-gate — generic state-change gate for tick commands.
# Fire the tick only when any monitored state-file changed OR the gate is stale.
# Mirrors mesh-verify-gate but uses file-content hash instead of git SHA as the delta key.
#
# Usage:
#   mesh-tick-gate <name> <stale_min> <tick_node> <tick_win> <tick_role> [state_file ...]
#   mesh-tick-gate --test
#
# DUE when:
#   (a) combined hash of all state-file contents changed since last run, OR
#   (b) >= stale_min minutes since last run (drift-baseline, catches env changes)
# DUE: update hash + exec mesh-tick <node> <win> <role>   (replaces this process — one log line)
# SKIP: exit 0 silently (no quota draw, no cron noise)
#
# Example cron wiring (health mind — fire only when doctor/egress/therm state changes):
#   0-59/4 * * * * mesh-tick-gate health 60 local health check \
#     ~/.mesh/.doctor-cron-state ~/.mesh/.egress-state ~/.mesh/.therm-state ~/.mesh/.router-thermal-state
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"

[ "${1:-}" = --test ] && {
  for x in md5sum mesh-tick; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -d "$MESH_DIR" ] || { echo "smoke-test: FAIL (no $MESH_DIR)"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

[ $# -lt 5 ] && {
  echo "mesh-tick-gate: usage: <name> <stale_min> <tick_node> <tick_win> <tick_role> [state_file...]" >&2
  exit 2
}

name="$1"; stale_min="$2"; tick_node="$3"; tick_win="$4"; tick_role="$5"
shift 5
STATE="$MESH_DIR/.tick-gate-${name}.state"  # "<hash> <epoch>"

current_hash() {
  { for f in "$@"; do cat "$f" 2>/dev/null || true; done; } | md5sum | awk '{print $1}'
}

gate_due() {  # $1=statefile $2=current_hash $3=now_epoch $4=stale_min → DUE|SKIP
  local lhash lts
  [ -f "$1" ] || { echo DUE; return; }
  read -r lhash lts < "$1" 2>/dev/null || { echo DUE; return; }
  [ "$2" != "$lhash" ] && { echo DUE; return; }
  [ "$(( $3 - ${lts:-0} ))" -ge "$(( $4 * 60 ))" ] && { echo DUE; return; }
  echo SKIP
}

hash="$(current_hash "$@")"
now="$(date -u +%s)"

if [ "$(gate_due "$STATE" "$hash" "$now" "$stale_min")" = DUE ]; then
  mkdir -p "$MESH_DIR"
  printf '%s %s\n' "$hash" "$now" > "$STATE"
  exec mesh-tick "$tick_node" "$tick_win" "$tick_role"
fi
exit 0
