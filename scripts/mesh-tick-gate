#!/usr/bin/env bash
# mesh-tick-gate — generic state-change gate for tick commands.
# Fire the tick only when any monitored state-file changed OR the gate is stale.
# Mirrors mesh-verify-gate but uses file-content hash instead of git SHA as the delta key.
#
# Usage:
#   mesh-tick-gate <name> <stale_min> <tick_node> <tick_win> <tick_role> [--gate '<sed>']... [state_file ...]
#   mesh-tick-gate --test
#
# DUE when:
#   (a) combined hash of all state-file contents changed since last run, OR
#   (b) >= stale_min minutes since last run (drift-baseline, catches env changes)
# DUE: update hash + exec mesh-tick <node> <win> <role>   (replaces this process — one log line)
# SKIP: exit 0 silently (no quota draw, no cron noise)
#
# SIGNIFICANCE GATE (--gate '<sed-expr>', repeatable; mirrors mesh-delta --gate): normalize the state
# content through each sed-expr BEFORE hashing, so a VOLATILE field (a ticking timestamp, age=Ns, a
# wobbling score/temperature) is not seen as a change. Without this the gate fires every cycle on noise
# → the mind is woken on no real change = the diff-trigger flood ([[delta-channels-need-gate]]). This is
# what makes "wake the mind ONLY on a meaningful diff" (operator 2026-06-20 design) actually robust.
#
# Example cron wiring (health mind — fire only when doctor/egress/therm state changes, ignoring timestamps):
#   0-59/4 * * * * mesh-tick-gate health 60 local health check \
#     --gate 's/[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9:]+Z?//g' --gate 's/age=[0-9]+[smh]?//g' \
#     ~/.mesh/.doctor-cron-state ~/.mesh/.egress-state ~/.mesh/.therm-state ~/.mesh/.router-thermal-state
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
GATES=()   # significance-gate sed-exprs (populated from --gate; empty = hash raw content, legacy behavior)

apply_gates() {  # stdin → normalized stdout (each --gate sed applied in order). No gates = passthrough.
  [ "${#GATES[@]}" -eq 0 ] && { cat; return; }
  local out g; out="$(cat)"
  for g in "${GATES[@]}"; do out="$(printf '%s\n' "$out" | sed -E "$g")"; done
  printf '%s\n' "$out"
}

current_hash() {
  { for f in "$@"; do cat "$f" 2>/dev/null || true; done; } | apply_gates | md5sum | awk '{print $1}'
}

gate_due() {  # $1=statefile $2=current_hash $3=now_epoch $4=stale_min → DUE|SKIP
  local lhash lts
  [ -f "$1" ] || { echo DUE; return; }
  read -r lhash lts < "$1" 2>/dev/null || { echo DUE; return; }
  [ "$2" != "$lhash" ] && { echo DUE; return; }
  [ "$(( $3 - ${lts:-0} ))" -ge "$(( $4 * 60 ))" ] && { echo DUE; return; }
  echo SKIP
}

[ "${1:-}" = --test ] && {
  for x in md5sum mesh-tick; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -d "$MESH_DIR" ] || { echo "smoke-test: FAIL (no $MESH_DIR)"; exit 1; }
  # Dry-run the load-bearing decision (gate_due + current_hash) against synthetic fixtures.
  # The dep-only check above passes even if the fire/skip logic rots — and a gate that always
  # SKIPs silently starves its mind (no tick) while a gate that always fires floods it. FALSIFIABLE:
  # break gate_due's hash/staleness branches or current_hash's content-sensitivity → an assert FAILs.
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  _f=0; _sf="$_td/sf"; _st="$_td/state"; _now=1781700000
  printf 'alpha\n' > "$_sf"; _h="$(current_hash "$_sf")"
  [ "$(gate_due "$_st" "$_h" "$_now" 60)" = DUE ]  || { echo "  FAIL: first-run (no state) should be DUE"; _f=1; }
  printf '%s %s\n' "$_h" "$_now" > "$_st"
  [ "$(gate_due "$_st" "$_h" "$_now" 60)" = SKIP ] || { echo "  FAIL: unchanged+fresh should SKIP (gate fires on no-change → mind flooded)"; _f=1; }
  printf 'beta\n' > "$_sf"; _h2="$(current_hash "$_sf")"
  [ "$_h" != "$_h2" ]                              || { echo "  FAIL: current_hash blind to content change (delta key dead → gate never fires on change)"; _f=1; }
  [ "$(gate_due "$_st" "$_h2" "$_now" 60)" = DUE ] || { echo "  FAIL: content-changed should be DUE (mind starved on real change)"; _f=1; }
  [ "$(gate_due "$_st" "$_h" "$((_now+3700))" 60)" = DUE ] || { echo "  FAIL: stale (>stale_min) should be DUE (drift-baseline broken)"; _f=1; }
  # SIGNIFICANCE GATE: a volatile field normalized away must NOT change the hash (no flood); a real
  # change to the non-volatile part MUST still change it (mind not starved). FALSIFIABLE: drop apply_gates.
  GATES=('s/score=[0-9]+//g')
  printf 'score=5 body\n' > "$_sf"; _hg="$(current_hash "$_sf")"
  printf 'score=9 body\n' > "$_sf"; _hg2="$(current_hash "$_sf")"
  [ "$_hg" = "$_hg2" ]  || { echo "  FAIL: --gate must normalize the volatile field (score) → same hash (flood not suppressed)"; _f=1; }
  printf 'score=9 BODY2\n' > "$_sf"; _hg3="$(current_hash "$_sf")"
  [ "$_hg" != "$_hg3" ] || { echo "  FAIL: a real (non-volatile) change must still alter the gated hash (mind starved)"; _f=1; }
  GATES=()
  rm -rf "$_td"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (gate_due/current_hash decision drifted — the gate fires/skips wrongly)"; exit 1; }
  echo "smoke-test: ok (DUE on first-run/change/stale, SKIP on unchanged+fresh; hash content-sensitive; --gate suppresses volatile noise but not real change)"; exit 0
}

# Extract --gate '<sed>' flags from anywhere in the args (significance gate; repeatable), leaving the
# positionals untouched so the legacy call form is 100% unchanged when no --gate is given.
_pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    --gate) shift; [ $# -gt 0 ] || { echo "mesh-tick-gate: --gate needs a sed-expr" >&2; exit 2; }; GATES+=("$1");;
    *)      _pos+=("$1");;
  esac
  shift
done
set -- ${_pos[@]+"${_pos[@]}"}

[ $# -lt 5 ] && {
  echo "mesh-tick-gate: usage: <name> <stale_min> <tick_node> <tick_win> <tick_role> [--gate '<sed>']... [state_file...]" >&2
  exit 2
}

name="$1"; stale_min="$2"; tick_node="$3"; tick_win="$4"; tick_role="$5"
shift 5
STATE="$MESH_DIR/.tick-gate-${name}.state"  # "<hash> <epoch>"

hash="$(current_hash "$@")"
now="$(date -u +%s)"

if [ "$(gate_due "$STATE" "$hash" "$now" "$stale_min")" = DUE ]; then
  mkdir -p "$MESH_DIR"
  printf '%s %s\n' "$hash" "$now" > "$STATE"
  exec mesh-tick "$tick_node" "$tick_win" "$tick_role"
fi
exit 0
