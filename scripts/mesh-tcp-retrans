#!/usr/bin/env bash
# orphan-ok: on-demand live path-quality probe (mind pulls it; stateless, not scheduled)
# mesh-tcp-retrans — end-to-end network PATH QUALITY: TCP retransmission ratio, sampled live.
# Distinct axis from every existing net sense: mesh-wifi-link sees the RADIO (RSSI),
# mesh-netrate sees VOLUME (bytes/s), mesh-link-flap sees CARRIER stability — none sees
# whether the path the packets actually ride is LOSSY. A perfect-RSSI, flowing link can be
# silently dropping segments (congested router, degrading VPN tunnel, upstream loss); TCP
# retransmits are where that shows first. Source: /proc/net/snmp Tcp: RetransSegs/OutSegs,
# delta over a short window (cumulative counters — a single read is lifetime noise).
#
# Verdicts (ratio = dRetransSegs/dOutSegs over the window):
#   QUIET     — too few segments sent in the window to judge quality (dOut < 10). Honest
#               "can't tell", NOT a fake CLEAN.
#   CLEAN     — ratio < 1%
#   LOSSY     — 1% <= ratio < 5%
#   DEGRADED  — ratio >= 5%
# Exit 2: /proc/net/snmp missing/unparseable — never fake a CLEAN.
# Stateless live probe (LIVE-ONLY class, like mesh-netrate/irq-rate): no cron, no state file.
#
#   mesh-tcp-retrans            one sampled reading (default 5s window)
#   mesh-tcp-retrans --window N sample over N seconds
#   mesh-tcp-retrans --subject  the same reading WITH the flow that caused it (see below)
#   mesh-tcp-retrans --test     smoke test (parser+classifier synthetic + real-read gate)
#
# --subject: this tool's verdict is node-global and names nobody. `mesh-tcp-attrib` reads the same
# quantity PER SOCKET (netlink inet_diag) and can say which peer/flow/process. The two must not be
# run back to back and stapled together: the ratio is NONSTATIONARY over minutes (measured on this
# node — the same 60s window read 4.32% and 1.46% twenty-five minutes apart, and a 5s window read
# 0.00% in the minute a 60s window read 1.46%), so a subject sampled in the NEXT window is a subject
# for a different reading. So --subject does not sample here at all: it delegates the whole paired
# window to mesh-tcp-attrib, then classifies THAT window's global figures with the bands below.
# One window, one verdict, one subject, by construction. Verdict ownership stays here.
set -uo pipefail

SNMP=/proc/net/snmp
WIN=5
SUBJECT=0
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --window)  WIN="${2:-5}"; shift 2 ;;
    --subject) SUBJECT=1; shift ;;
    --test)    break ;;
    *)         break ;;
  esac
done

# read_tcp: print "<OutSegs> <RetransSegs>" from a snmp-format stream; nothing on parse fail
read_tcp() {
  awk '$1=="Tcp:"{ if (NR_h=="") { for(i=1;i<=NF;i++){if($i=="OutSegs")o=i; if($i=="RetransSegs")r=i}; NR_h=1 }
       else if (o&&r&&$o~/^[0-9]+$/&&$r~/^[0-9]+$/) { print $o, $r; exit } }' "$1" 2>/dev/null
}

# classify <dOut> <dRetrans> -> verdict + pct
classify() {
  local dout=$1 dre=$2
  if [ "$dout" -lt 10 ]; then echo "QUIET -"; return; fi
  # pct with one decimal, pure integer awk-free arithmetic via awk for the ratio
  local verdict pct
  pct=$(awk -v r="$dre" -v o="$dout" 'BEGIN{printf "%.1f", 100*r/o}')
  if   awk -v p="$pct" 'BEGIN{exit !(p>=5)}'; then verdict=DEGRADED
  elif awk -v p="$pct" 'BEGIN{exit !(p>=1)}'; then verdict=LOSSY
  else verdict=CLEAN; fi
  echo "$verdict $pct"
}

if [ "${1:-}" = --test ]; then
  e=0
  # parser: synthetic 2-line snmp fixture
  t=$(mktemp); trap 'rm -f "$t"' EXIT
  printf 'Tcp: RtoAlgorithm MaxConn OutSegs RetransSegs\nTcp: 1 -1 1000 25\n' > "$t"
  r="$(read_tcp "$t")"
  [ "$r" = "1000 25" ] || { echo "FAIL: parse => '$r'"; e=$((e+1)); }
  # parser rejects garbage counters
  printf 'Tcp: OutSegs RetransSegs\nTcp: abc def\n' > "$t"
  r="$(read_tcp "$t")"
  [ -z "$r" ] || { echo "FAIL: garbage accepted => '$r'"; e=$((e+1)); }
  # classifier
  [ "$(classify 5 0)"    = "QUIET -"        ] || { echo "FAIL: quiet";    e=$((e+1)); }
  [ "$(classify 1000 2)" = "CLEAN 0.2"      ] || { echo "FAIL: clean";    e=$((e+1)); }
  [ "$(classify 1000 20)" = "LOSSY 2.0"     ] || { echo "FAIL: lossy";    e=$((e+1)); }
  [ "$(classify 1000 80)" = "DEGRADED 8.0"  ] || { echo "FAIL: degraded"; e=$((e+1)); }
  # boundary: exactly 1% -> LOSSY, exactly 5% -> DEGRADED
  [ "$(classify 1000 10)" = "LOSSY 1.0"     ] || { echo "FAIL: 1pct-boundary"; e=$((e+1)); }
  [ "$(classify 1000 50)" = "DEGRADED 5.0"  ] || { echo "FAIL: 5pct-boundary"; e=$((e+1)); }
  # real-read gate: the live kernel counters must parse to two numbers (verification
  # principle — a --test that only exercises the offline classifier is a hollow green)
  r="$(read_tcp "$SNMP")"
  case "$r" in
    [0-9]*\ [0-9]*) : ;;
    *) echo "FAIL: real read from $SNMP => '$r'"; e=$((e+1)) ;;
  esac
  # ── --subject: the verdict and its subject must come from ONE window. Driven through a stub that
  # emits a known mesh-tcp-attrib --json, so the json parse, the banding of the DELEGATED counters,
  # and the coverage carry are all genuinely exercised (a stub that only proved "something was called"
  # would be a shim that changes nothing).
  st="$(mktemp -d)"
  cat > "$st/attrib" <<'STUB'
#!/bin/sh
echo '{"window_s":9,"global_segs":1000,"global_retrans":80,"attributed_retrans":30,"unattributed_retrans":50,"rows":[{"peer":"1.2.3.4:443","name":"derp9x(fra)","d_retrans":21,"d_segs":100}]}'
STUB
  chmod +x "$st/attrib"
  so="$(MESH_TCP_RETRANS_ATTRIB_CMD="$st/attrib" "$0" --window 9 --subject 2>&1)"; src=$?
  [ "$src" -eq 0 ] || { echo "FAIL: --subject rc=$src"; e=$((e+1)); }
  # 80/1000 = 8.0% — DEGRADED by THIS tool's bands, computed from the DELEGATED window's counters.
  # A wiring that re-sampled locally could not produce these digits.
  case "$so" in *"DEGRADED 8.0%"*) : ;; *) echo "FAIL: --subject must band the delegated window's own counters (got: $so)"; e=$((e+1));; esac
  case "$so" in *"80/1000 segs"*)  : ;; *) echo "FAIL: --subject must report the delegated counters: $so"; e=$((e+1));; esac
  case "$so" in *"1.2.3.4:443"*)   : ;; *) echo "FAIL: --subject must name the top flow: $so"; e=$((e+1));; esac
  case "$so" in *"attributed=30/80"*) : ;; *) echo "FAIL: the subject must travel with its coverage: $so"; e=$((e+1));; esac
  case "$so" in *"unattributed=50"*)  : ;; *) echo "FAIL: the residual must be named, never left to read as 0: $so"; e=$((e+1));; esac
  # a window with no attributable retrans → na, never a fabricated subject, and still rc=0
  cat > "$st/attrib0" <<'STUB'
#!/bin/sh
echo '{"window_s":9,"global_segs":1000,"global_retrans":80,"attributed_retrans":0,"unattributed_retrans":80,"rows":[{"peer":"1.2.3.4:443","name":"na","d_retrans":0,"d_segs":100}]}'
STUB
  chmod +x "$st/attrib0"
  so0="$(MESH_TCP_RETRANS_ATTRIB_CMD="$st/attrib0" "$0" --window 9 --subject 2>&1)"
  case "$so0" in *"subject: na"*) : ;; *) echo "FAIL: an unattributable window must render subject na: $so0"; e=$((e+1));; esac
  case "$so0" in *"not absent"*)  : ;; *) echo "FAIL: unattributable and absent are different claims: $so0"; e=$((e+1));; esac
  case "$so0" in *"1.2.3.4"*) echo "FAIL: a zero-delta flow was named as the subject: $so0"; e=$((e+1));; esac
  # a sibling that produces nothing → rc 2, never a subject-less reading dressed as complete.
  # (A scripted caller reads the EXIT CODE, not the prose.)
  sq="$(MESH_TCP_RETRANS_ATTRIB_CMD="false" "$0" --window 9 --subject 2>&1)"; sqc=$?
  [ "$sqc" -eq 2 ] || { echo "FAIL: an unusable mesh-tcp-attrib must exit 2, got rc=$sqc ($sq)"; e=$((e+1)); }
  case "$sq" in *%*) echo "FAIL: a ratio was rendered with no reading behind it: $sq"; e=$((e+1));; esac
  # the sibling must be REACHABLE for real, not only through the stub — a wire nobody can resolve
  # is not wired (this is a discovery check, not a second live sample).
  command -v mesh-tcp-attrib >/dev/null 2>&1 || [ -x "$(dirname "$0")/mesh-tcp-attrib" ] \
    || { echo "FAIL: mesh-tcp-attrib resolvable neither on PATH nor beside $0 — --subject is a dead wire"; e=$((e+1)); }
  rm -rf "$st"

  [ "$e" -eq 0 ] && { echo "smoke: ok (20 assertions incl. real kernel read + the --subject wire)"; exit 0; }
  echo "smoke: FAIL ($e fail(s))"; exit 1
fi

if [ "$SUBJECT" = 1 ]; then
  # resolve the sibling: prefer PATH, fall back to the copy beside this script, so an un-deployed
  # genome checkout works too. Absent sibling → exit 2, never a subject-less reading dressed up as one.
  ATTRIB="${MESH_TCP_RETRANS_ATTRIB_CMD:-}"
  if [ -z "$ATTRIB" ]; then
    if command -v mesh-tcp-attrib >/dev/null 2>&1; then ATTRIB="mesh-tcp-attrib"
    elif [ -x "$(dirname "$0")/mesh-tcp-attrib" ];  then ATTRIB="$(dirname "$0")/mesh-tcp-attrib"
    else echo "tcp-retrans: UNREACHABLE (--subject needs mesh-tcp-attrib; not on PATH or beside $0)" >&2; exit 2; fi
  fi
  J="$(sh -c "$ATTRIB --window $WIN --json" 2>/dev/null)"
  [ -n "$J" ] || { echo "tcp-retrans: UNREACHABLE (mesh-tcp-attrib produced no reading)" >&2; exit 2; }
  # the verdict is computed from the DELEGATED window's own counters — not from a second sample here
  jnum() { printf '%s' "$J" | sed -n 's/.*"'"$1"'":\([0-9-]*\).*/\1/p' | head -1; }
  jstr() { printf '%s' "$J" | sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p' | head -1; }
  dout="$(jnum global_segs)"; dre="$(jnum global_retrans)"
  case "${dout:-x}${dre:-x}" in *x*) echo "tcp-retrans: UNREACHABLE (mesh-tcp-attrib json carried no global counters)" >&2; exit 2;; esac
  read -r verdict pct <<<"$(classify "$dout" "$dre")"
  peer="$(printf '%s' "$J" | sed -n 's/.*"rows":\[{"peer":"\([^"]*\)".*/\1/p' | head -1)"
  name="$(printf '%s' "$J" | sed -n 's/.*"rows":\[{"peer":"[^"]*","name":"\([^"]*\)".*/\1/p' | head -1)"
  dr_top="$(printf '%s' "$J" | sed -n 's/.*"rows":\[{[^}]*"d_retrans":\([0-9]*\).*/\1/p' | head -1)"
  attr="$(jnum attributed_retrans)"; unattr="$(jnum unattributed_retrans)"
  if [ "$verdict" = QUIET ]; then
    echo "tcp-retrans: QUIET (only ${dout} segs in ${WIN}s — not enough traffic to judge)"
  else
    echo "tcp-retrans: ${verdict} ${pct}% (${dre}/${dout} segs retransmitted over ${WIN}s)"
  fi
  # the subject travels WITH its coverage, always: the top flow is the largest NAMED share of the
  # loss, never the whole of it, and a residual that reads as 0 would be a fabricated completeness.
  if [ -n "${peer:-}" ] && [ "${dr_top:-0}" -gt 0 ]; then
    echo "  subject: ${peer} (${name:-na}) Δretrans=${dr_top} — same ${WIN}s window; attributed=${attr:-na}/${dre} unattributed=${unattr:-na} (flows that opened AND closed inside the window are invisible to a delta sampler)"
  else
    echo "  subject: na — no surviving flow retransmitted in this window; the loss is unattributable at socket granularity, not absent (attributed=${attr:-na}/${dre})"
  fi
  exit 0
fi

[ -r "$SNMP" ] || { echo "tcp-retrans: UNREACHABLE (no $SNMP)" >&2; exit 2; }
a="$(read_tcp "$SNMP")"
[ -n "$a" ] || { echo "tcp-retrans: UNREACHABLE (Tcp line unparseable)" >&2; exit 2; }
sleep "$WIN"
b="$(read_tcp "$SNMP")"
[ -n "$b" ] || { echo "tcp-retrans: UNREACHABLE (Tcp line unparseable)" >&2; exit 2; }

read -r o1 r1 <<<"$a"; read -r o2 r2 <<<"$b"
dout=$((o2-o1)); dre=$((r2-r1))
# counter reset (reboot mid-window) → negative delta: honest unreachable, not a fake verdict
{ [ "$dout" -ge 0 ] && [ "$dre" -ge 0 ]; } || { echo "tcp-retrans: UNREACHABLE (counter reset mid-window)" >&2; exit 2; }

read -r verdict pct <<<"$(classify "$dout" "$dre")"
if [ "$verdict" = QUIET ]; then
  echo "tcp-retrans: QUIET (only ${dout} segs in ${WIN}s — not enough traffic to judge)"
else
  echo "tcp-retrans: ${verdict} ${pct}% (${dre}/${dout} segs retransmitted over ${WIN}s)"
fi
exit 0
