#!/usr/bin/env bash
# orphan-ok: on-demand live path-quality probe (mind pulls it; stateless, not scheduled)
# mesh-tcp-retrans — end-to-end network PATH QUALITY: TCP retransmission ratio, sampled live.
# Distinct axis from every existing net sense: mesh-wifi-link sees the RADIO (RSSI),
# mesh-netrate sees VOLUME (bytes/s), mesh-link-flap sees CARRIER stability — none sees
# whether the path the packets actually ride is LOSSY. A perfect-RSSI, flowing link can be
# silently dropping segments (congested router, degrading VPN tunnel, upstream loss); TCP
# retransmits are where that shows first. Source: /proc/net/snmp Tcp: RetransSegs/OutSegs,
# delta over a short window (cumulative counters — a single read is lifetime noise).
#
# Verdicts (ratio = dRetransSegs/dOutSegs over the window):
#   QUIET     — too few segments sent in the window to judge quality (dOut < 10). Honest
#               "can't tell", NOT a fake CLEAN.
#   CLEAN     — ratio < 1%
#   LOSSY     — 1% <= ratio < 5%
#   DEGRADED  — ratio >= 5%
# Exit 2: /proc/net/snmp missing/unparseable — never fake a CLEAN.
# Stateless live probe (LIVE-ONLY class, like mesh-netrate/irq-rate): no cron, no state file.
#
#   mesh-tcp-retrans            one sampled reading (default 5s window)
#   mesh-tcp-retrans --window N sample over N seconds
#   mesh-tcp-retrans --test     smoke test (parser+classifier synthetic + real-read gate)
set -uo pipefail

SNMP=/proc/net/snmp
WIN=5
[ "${1:-}" = --window ] && { WIN="${2:-5}"; shift 2; }

# read_tcp: print "<OutSegs> <RetransSegs>" from a snmp-format stream; nothing on parse fail
read_tcp() {
  awk '$1=="Tcp:"{ if (NR_h=="") { for(i=1;i<=NF;i++){if($i=="OutSegs")o=i; if($i=="RetransSegs")r=i}; NR_h=1 }
       else if (o&&r&&$o~/^[0-9]+$/&&$r~/^[0-9]+$/) { print $o, $r; exit } }' "$1" 2>/dev/null
}

# classify <dOut> <dRetrans> -> verdict + pct
classify() {
  local dout=$1 dre=$2
  if [ "$dout" -lt 10 ]; then echo "QUIET -"; return; fi
  # pct with one decimal, pure integer awk-free arithmetic via awk for the ratio
  local verdict pct
  pct=$(awk -v r="$dre" -v o="$dout" 'BEGIN{printf "%.1f", 100*r/o}')
  if   awk -v p="$pct" 'BEGIN{exit !(p>=5)}'; then verdict=DEGRADED
  elif awk -v p="$pct" 'BEGIN{exit !(p>=1)}'; then verdict=LOSSY
  else verdict=CLEAN; fi
  echo "$verdict $pct"
}

if [ "${1:-}" = --test ]; then
  e=0
  # parser: synthetic 2-line snmp fixture
  t=$(mktemp); trap 'rm -f "$t"' EXIT
  printf 'Tcp: RtoAlgorithm MaxConn OutSegs RetransSegs\nTcp: 1 -1 1000 25\n' > "$t"
  r="$(read_tcp "$t")"
  [ "$r" = "1000 25" ] || { echo "FAIL: parse => '$r'"; e=$((e+1)); }
  # parser rejects garbage counters
  printf 'Tcp: OutSegs RetransSegs\nTcp: abc def\n' > "$t"
  r="$(read_tcp "$t")"
  [ -z "$r" ] || { echo "FAIL: garbage accepted => '$r'"; e=$((e+1)); }
  # classifier
  [ "$(classify 5 0)"    = "QUIET -"        ] || { echo "FAIL: quiet";    e=$((e+1)); }
  [ "$(classify 1000 2)" = "CLEAN 0.2"      ] || { echo "FAIL: clean";    e=$((e+1)); }
  [ "$(classify 1000 20)" = "LOSSY 2.0"     ] || { echo "FAIL: lossy";    e=$((e+1)); }
  [ "$(classify 1000 80)" = "DEGRADED 8.0"  ] || { echo "FAIL: degraded"; e=$((e+1)); }
  # boundary: exactly 1% -> LOSSY, exactly 5% -> DEGRADED
  [ "$(classify 1000 10)" = "LOSSY 1.0"     ] || { echo "FAIL: 1pct-boundary"; e=$((e+1)); }
  [ "$(classify 1000 50)" = "DEGRADED 5.0"  ] || { echo "FAIL: 5pct-boundary"; e=$((e+1)); }
  # real-read gate: the live kernel counters must parse to two numbers (verification
  # principle — a --test that only exercises the offline classifier is a hollow green)
  r="$(read_tcp "$SNMP")"
  case "$r" in
    [0-9]*\ [0-9]*) : ;;
    *) echo "FAIL: real read from $SNMP => '$r'"; e=$((e+1)) ;;
  esac
  [ "$e" -eq 0 ] && { echo "smoke: ok (9 assertions incl. real kernel read)"; exit 0; }
  echo "smoke: FAIL ($e fail(s))"; exit 1
fi

[ -r "$SNMP" ] || { echo "tcp-retrans: UNREACHABLE (no $SNMP)" >&2; exit 2; }
a="$(read_tcp "$SNMP")"
[ -n "$a" ] || { echo "tcp-retrans: UNREACHABLE (Tcp line unparseable)" >&2; exit 2; }
sleep "$WIN"
b="$(read_tcp "$SNMP")"
[ -n "$b" ] || { echo "tcp-retrans: UNREACHABLE (Tcp line unparseable)" >&2; exit 2; }

read -r o1 r1 <<<"$a"; read -r o2 r2 <<<"$b"
dout=$((o2-o1)); dre=$((r2-r1))
# counter reset (reboot mid-window) → negative delta: honest unreachable, not a fake verdict
{ [ "$dout" -ge 0 ] && [ "$dre" -ge 0 ]; } || { echo "tcp-retrans: UNREACHABLE (counter reset mid-window)" >&2; exit 2; }

read -r verdict pct <<<"$(classify "$dout" "$dre")"
if [ "$verdict" = QUIET ]; then
  echo "tcp-retrans: QUIET (only ${dout} segs in ${WIN}s — not enough traffic to judge)"
else
  echo "tcp-retrans: ${verdict} ${pct}% (${dre}/${dout} segs retransmitted over ${WIN}s)"
fi
exit 0
