#!/usr/bin/env bash
# reflex-cadence: 6-59/10 * * * *
# reflex-args: --log
# Wired (planner 2026-06-20) to accumulate a continuous WiFi RSSI TAPE (~/.mesh/wifi.log) — the
# data layer the operator's "WiFi people-sensing" (07:15, assigned to the room mind) needs, and a
# 2nd live numeric stream for the correlation family (presence.log/BLE was the only one). GENTLE
# 10-min cadence on purpose: this node provides the Tailscale exit-node and a STA rescan can briefly
# go off-channel — 10min (≈ Android's own auto-scan cadence) keeps people-sensing trends without
# hammering the radio that carries forwarded client traffic. Read-only nmcli scan; --test gates autowire.
# mesh-wifiscan — WiFi AP proximity sensor (passive scan via nmcli).
# smoke-test: --test checks nmcli + wifi radio available
#
# Complements mesh-presence (BLE): covers access points + any device on wifi.
# Read-only (nmcli scan, no connect). Output matches mesh-presence's pipe format:
#   signal|bssid|ssid|freq_mhz
#
#   mesh-wifiscan            scan and list nearby APs (signal|bssid|ssid|freq)
#   mesh-wifiscan --log      also append a snapshot line to ~/.mesh/wifi.log
#   mesh-wifiscan --loop [s] scan + log every N sec (default 60)
#   mesh-wifiscan --test     smoke test (exit 0 if nmcli + wifi radio ready)
#
# Output sorted by signal strength (strongest first). No output if scan fails.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
WIN=10; LOGIT=0

if [ "${1:-}" = --test ]; then
  command -v nmcli >/dev/null 2>&1 || { echo "smoke-test: FAIL (no nmcli)"; exit 1; }
  nmcli -t radio wifi 2>/dev/null | grep -q enabled || { echo "smoke-test: FAIL (wifi radio disabled)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

if [ "${1:-}" = --loop ]; then
  iv="${2:-60}"
  echo "[mesh-wifiscan] continuous WiFi scan every ${iv}s on $(hostname)"
  while true; do
    : > "${HOME}/.mesh/mesh-wifiscan.beat"
    "$0" --log 2>/dev/null || true
    sleep "$iv"
  done
  exit 0
fi

for a in "$@"; do case "$a" in --log) LOGIT=1;; esac; done

HOST="$(hostname)"; MESH="$HOME/.mesh"; LOG="$MESH/wifi.log"; mkdir -p "$MESH"
ts="$(date -u +%FT%TZ)"
SANITY_MIN="${WIFISCAN_SANITY_MIN:-3}"   # below this AP count a scan is a STALE-CACHE MISS, not ground truth

# Read the AP list into rows/n (nmcli -t output: SIGNAL:BSSID\:escaped\:colons:SSID:FREQ; replace \:
# with @ for a clean : split, then restore in BSSID). `wifi list` returns NM's CACHE, not a live scan.
read_aps() {
  rows=""; n=0
  while IFS=':' read -r signal bssid_raw ssid freq junk; do
    [ -z "$ssid" ] || [ -z "$signal" ] && continue
    bssid="${bssid_raw//@/:}"; freq="${freq% MHz}"
    rows="${rows}${signal}|${bssid}|${ssid}|${freq}"$'\n'
    n=$((n+1))
  done < <(nmcli -t -f SIGNAL,BSSID,SSID,FREQ device wifi list 2>/dev/null | sed 's/\\:/@/g' || true)
}

# A single rescan + read is unreliable for the TAPE, for TWO compounding reasons:
#   (1) NM's rescan is rate-limited — a request issued soon after NM's own background scan returns rc=0
#       but is a NO-OP, and `wifi list` then returns the last cache, sometimes a quick single-band scan
#       holding only the connected AP (n=1); and
#   (2) an ACCEPTED rescan completes ASYNCHRONOUSLY (~3-5s), so even a fresh trigger needs a settle.
# Observed 2026-06-24: cron :36/:46 logged n=1 stale-cache misses (honest-skip → tape GAP) while
# interactive runs got 17-30. A re-read-only poll fixes (2) but NOT (1) — re-reading a stuck cache stays 1.
# Fix BOTH: poll up to ~10s, RE-TRIGGERING the rescan each round (a refused one is a harmless no-op; once
# NM's cooldown passes one is ACCEPTED and does a full multi-channel scan) then re-read, breaking as soon
# as the scan lands (n>=SANITY_MIN). Gentle overall: at most a few scans within one run, once per 10-min
# cadence; the common warm-cache case breaks on the first read (0-1 extra scans).
rows=""; n=0
for _try in 1 2 3 4 5; do
  timeout 8 nmcli device wifi rescan >/dev/null 2>&1 || true
  sleep 2
  read_aps
  [ "$n" -ge "$SANITY_MIN" ] && break
done

sorted="$(printf '%s' "$rows" | sed '/^$/d' | sort -t'|' -k1 -rn)"
echo "=== mesh-wifiscan $HOST @ $ts — $n AP(s) in range ==="
printf '%s' "$sorted" | head -50

# Log mode: compact one-liner. HONEST-FUSION: a count below SANITY_MIN is a failed/stale scan, not a
# real "the room emptied out" — appending it would poison the tape (the room spatial sense + correlation
# would read APs as having vanished). A failed scan produces NO tape line (honest absence, like
# presence.log skipping), so the cadence gap signals the miss rather than faking ground truth.
if [ "$LOGIT" = 1 ]; then
  if [ "$n" -lt "$SANITY_MIN" ]; then
    echo "[mesh-wifiscan] scan returned only $n AP(s) (< SANITY_MIN=$SANITY_MIN) — stale-cache miss, NOT logging (honest absence)" >&2
  else
    devices="[$(printf '%s' "$sorted" | head -20 | tr '\n' ' ' | sed 's/ $//')]"
    echo "$ts  $HOST  n=$n  aps=$devices" >> "$LOG"
  fi
fi

# Exit 0 if any AP found, 1 if none
[ "$n" -gt 0 ] && exit 0 || exit 1
