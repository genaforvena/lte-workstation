#!/usr/bin/env bash
# reflex-cadence: 6-59/10 * * * *
# reflex-args: --log
# Wired (planner 2026-06-20) to accumulate a continuous WiFi RSSI TAPE (~/.mesh/wifi.log) — the
# data layer the operator's "WiFi people-sensing" (07:15, assigned to the room mind) needs, and a
# 2nd live numeric stream for the correlation family (presence.log/BLE was the only one). GENTLE
# 10-min cadence on purpose: this node provides the Tailscale exit-node and a STA rescan can briefly
# go off-channel — 10min (≈ Android's own auto-scan cadence) keeps people-sensing trends without
# hammering the radio that carries forwarded client traffic. Read-only nmcli scan; --test gates autowire.
# mesh-wifiscan — WiFi AP proximity sensor (passive scan via nmcli).
# smoke-test: --test checks nmcli + wifi radio available
#
# Complements mesh-presence (BLE): covers access points + any device on wifi.
# Read-only (nmcli scan, no connect). Output matches mesh-presence's pipe format:
#   signal|bssid|ssid|freq_mhz
#
#   mesh-wifiscan            scan and list nearby APs (signal|bssid|ssid|freq)
#   mesh-wifiscan --log      also append a snapshot line to ~/.mesh/wifi.log
#   mesh-wifiscan --loop [s] scan + log every N sec (default 60)
#   mesh-wifiscan --test     smoke test (union-merge fixtures + nmcli + wifi radio ready)
#
# PARTIAL-SWEEP UNION (senses 2026-07-03, board [task] wifiscan-partial-sweep): this radio is an
# ASSOCIATED STA (5GHz uplink, Tailscale exit node), so each rescan covers only a channel SUBSET —
# every tape line is a churning 3-10-AP slice of the ~20-AP neighborhood (union of 2 scans ≈ full
# set). Feeder-side reconstruction, ZERO extra radio: each successful sweep merges into
# ~/.mesh/.wifiscan-union (bssid|ssid|freq|signal|last_seen|misses, signal-sorted; rewritten
# atomically every successful sweep → mtime = ran-live), and the tape line gains a trailing
# additive "union=M" field. HONEST ABSENCE stays bounded: an AP missing from WIFISCAN_UNION_K
# (default 3) consecutive successful sweeps decays out (~K×10min), so a real outage still surfaces;
# a failed sweep (n < SANITY_MIN) never touches the union (no information, not evidence of absence).
# Consumers audited 2026-07-03: wifi-motion aps=\[(.*)\] greedy-to-last-], cooscillate/leadlag
# \bn=(\d+) (no boundary before the n of union=), rhythm SSID-keyed — all blind to the new field.
#
# Output sorted by signal strength (strongest first). No output if scan fails.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
WIN=10; LOGIT=0

# union_merge <prev-artifact> <K> <ts>; stdin: current rows (signal|bssid|ssid|freq)
# → stdout: merged union (bssid|ssid|freq|signal|last_seen|misses). Pure — fixture-testable.
# Seen now: signal/ts refreshed, misses=0. Absent: misses+1, dropped when misses reaches K.
union_merge() {
  awk -v prevf="$1" -v K="$2" -v ts="$3" -F'|' '
    BEGIN {
      while ((getline line < prevf) > 0) {
        m = split(line, f, "|")
        if (m >= 6) prev[f[1]] = line
      }
      close(prevf)
    }
    NF >= 4 { seen[$2] = $2 "|" $3 "|" $4 "|" $1 "|" ts "|0" }
    END {
      for (b in seen) print seen[b]
      for (b in prev) if (!(b in seen)) {
        split(prev[b], f, "|"); m = f[6] + 1
        if (m < K) print f[1] "|" f[2] "|" f[3] "|" f[4] "|" f[5] "|" m
      }
    }
  ' -
}

if [ "${1:-}" = --test ]; then
  # union-merge fixtures (pure awk — no radio, falsifiable: each flips if the merge rules change)
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  out="$(printf '70|AA:BB:CC:DD:EE:01|net1|2412\n40|AA:BB:CC:DD:EE:02|net2|5180\n' | union_merge "$_td/none" 3 T1)"
  [ "$(printf '%s\n' "$out" | grep -c '|T1|0$')" = 2 ] || { echo "smoke-test: FAIL (union enter: $out)"; exit 1; }
  printf 'AA:BB:CC:DD:EE:02|net2|5180|40|T0|0\n' > "$_td/u"
  out="$(printf '70|AA:BB:CC:DD:EE:01|net1|2412\n' | union_merge "$_td/u" 3 T1)"
  printf '%s\n' "$out" | grep -q 'AA:BB:CC:DD:EE:02|net2|5180|40|T0|1' || { echo "smoke-test: FAIL (union persist misses=1: $out)"; exit 1; }
  printf 'AA:BB:CC:DD:EE:02|net2|5180|40|T0|2\n' > "$_td/u2"
  out="$(printf '70|AA:BB:CC:DD:EE:01|net1|2412\n' | union_merge "$_td/u2" 3 T1)"
  printf '%s\n' "$out" | grep -q 'AA:BB:CC:DD:EE:02' && { echo "smoke-test: FAIL (union must drop at K misses: $out)"; exit 1; }
  printf 'AA:BB:CC:DD:EE:01|net1|2412|40|T0|2\n' > "$_td/u3"
  out="$(printf '80|AA:BB:CC:DD:EE:01|net1|2412\n' | union_merge "$_td/u3" 3 T1)"
  printf '%s\n' "$out" | grep -q 'AA:BB:CC:DD:EE:01|net1|2412|80|T1|0' || { echo "smoke-test: FAIL (union re-sight refresh: $out)"; exit 1; }
  command -v nmcli >/dev/null 2>&1 || { echo "smoke-test: FAIL (no nmcli)"; exit 1; }
  nmcli -t radio wifi 2>/dev/null | grep -q enabled || { echo "smoke-test: FAIL (wifi radio disabled)"; exit 1; }
  echo "smoke-test: ok (4 union-merge fixtures + nmcli + radio)"; exit 0
fi

if [ "${1:-}" = --loop ]; then
  iv="${2:-60}"
  echo "[mesh-wifiscan] continuous WiFi scan every ${iv}s on $(hostname)"
  while true; do
    : > "${HOME}/.mesh/mesh-wifiscan.beat"
    "$0" --log 2>/dev/null || true
    sleep "$iv"
  done
  exit 0
fi

for a in "$@"; do case "$a" in --log) LOGIT=1;; esac; done

HOST="$(hostname)"; MESH="$HOME/.mesh"; LOG="$MESH/wifi.log"; mkdir -p "$MESH"
ts="$(date -u +%FT%TZ)"
SANITY_MIN="${WIFISCAN_SANITY_MIN:-3}"   # below this AP count a scan is a STALE-CACHE MISS, not ground truth
UNIONF="${MESH_WIFISCAN_UNION:-$MESH/.wifiscan-union}"   # partial-sweep union artifact (see header)
UNION_K="${WIFISCAN_UNION_K:-3}"         # AP absent from K consecutive successful sweeps decays out

# Read the AP list into rows/n (nmcli -t output: SIGNAL:BSSID\:escaped\:colons:SSID:FREQ; replace \:
# with @ for a clean : split, then restore in BSSID). `--rescan yes` is the AUTHORITATIVE call: it forces
# a fresh scan AND BLOCKS until the results are ready, instead of returning NM's stale cache. This is the
# fix for the TAPE GAPS — a hand-rolled `rescan; sleep N; list` races NM's ASYNCHRONOUS scan completion
# (read too early → stale single-band cache → only the connected AP, n=1) AND can no-op on rate-limit;
# both produced honest-skip gaps (observed 2026-06-24: cron :36/:46/:56 logged n=1 while interactive runs,
# which kept NM's cache warm, got 17-30). `--rescan yes` lets NM own the scan lifecycle and the wait.
read_aps() {
  rows=""; n=0
  while IFS=':' read -r signal bssid_raw ssid freq junk; do
    [ -z "$ssid" ] || [ -z "$signal" ] && continue
    bssid="${bssid_raw//@/:}"; freq="${freq% MHz}"
    rows="${rows}${signal}|${bssid}|${ssid}|${freq}"$'\n'
    n=$((n+1))
  done < <(timeout 20 nmcli -t -f SIGNAL,BSSID,SSID,FREQ device wifi list --rescan yes 2>/dev/null | sed 's/\\:/@/g' || true)
}

# --rescan yes blocks for scan completion, so one call is usually enough; a small retry is a safety net
# for the rare case NM declines the forced rescan (very recent scan) and returns a short cache. Gentle on
# the exit-node radio: at most 3 scans within one run, once per 10-min cadence; breaks on first success.
rows=""; n=0; tries=""
for _try in 1 2 3; do
  read_aps
  tries="${tries:+$tries,}$n"
  [ "$n" -ge "$SANITY_MIN" ] && break
  sleep 3
done

# LONG-TAIL RESCUE (2026-07-06, tape mode only): the quick retries span ~16s — inside a station-traffic
# burst (this radio also carries forwarded exit-node traffic) all 3 return the same partial 1-2 AP sweep
# and the whole 10-min slot dies. Measured on this tape: 349/2301 runs (15%) skipped; TWO consecutive
# dead slots = a 30-min hole > wifi-motion's 25-min GAP_LIMIT → discontinuity-UNCERTAIN, while today's
# bursts were mostly 1-2 slots long. So before surrendering the slot, wait out the burst and try twice
# more across ~75s (still ≤ ~3.5min worst-case, no cadence overlap). Interactive calls skip this (fast
# answer beats a rescued one); the tape line is unchanged on success — only the slot survival improves.
# Honesty unchanged: a rescue that still comes up short logs NOTHING, exactly as before.
if [ "$LOGIT" = 1 ] && [ "$n" -lt "$SANITY_MIN" ]; then
  for _wait in ${WIFISCAN_RESCUE_WAITS:-45 30}; do
    sleep "$_wait"
    read_aps
    tries="$tries,$n"
    [ "$n" -ge "$SANITY_MIN" ] && break
  done
fi

sorted="$(printf '%s' "$rows" | sed '/^$/d' | sort -t'|' -k1 -rn)"
echo "=== mesh-wifiscan $HOST @ $ts — $n AP(s) in range ==="
printf '%s' "$sorted" | head -50

# Log mode: compact one-liner. HONEST-FUSION: a count below SANITY_MIN is a failed/stale scan, not a
# real "the room emptied out" — appending it would poison the tape (the room spatial sense + correlation
# would read APs as having vanished). A failed scan produces NO tape line (honest absence, like
# presence.log skipping), so the cadence gap signals the miss rather than faking ground truth.
if [ "$LOGIT" = 1 ]; then
  if [ "$n" -lt "$SANITY_MIN" ]; then
    echo "[mesh-wifiscan] scan returned only $n AP(s) (< SANITY_MIN=$SANITY_MIN) after rescue — stale-cache miss, NOT logging (honest absence) tries=$tries" >&2
  else
    devices="[$(printf '%s' "$sorted" | head -20 | tr '\n' ' ' | sed 's/ $//')]"
    # partial-sweep union: merge this sweep into the artifact (atomic), tape gains trailing union=M
    merged="$(printf '%s' "$sorted" | sed '/^$/d' | union_merge "$UNIONF" "$UNION_K" "$ts" | sort -t'|' -k4,4 -rn)"
    um="$(printf '%s\n' "$merged" | grep -c '|')"
    printf '%s\n' "$merged" | sed '/^$/d' > "$UNIONF.tmp" && mv "$UNIONF.tmp" "$UNIONF"
    echo "$ts  $HOST  n=$n  aps=$devices  union=$um" >> "$LOG"
  fi
fi

# Exit 0 if any AP found, 1 if none
[ "$n" -gt 0 ] && exit 0 || exit 1
