#!/usr/bin/env bash
# mesh-gpu-activity — iGPU busy-fraction + clock sense (Intel i915 RC6 residency, self-serve 0444).
#
# Two reads of /sys/class/drm/<card>/power/rc6_residency_ms over a ~2s wall window give
# GPU busy% = (1 − Δrc6/Δwall)·100 — the ms the GPU was NOT in RC6 deep-sleep. Plus the delivered
# clock (gt_cur_freq_mhz requested, gt_act_freq_mhz actual — 0 means powered down). Two mesh uses
# (find: capability-igpu-activity-20260702.md):
#   1. PASSIVE operator presence: screen-use/video wakes the GPU with ZERO keypresses — a
#      mesh-keypresence blind spot; a BUSY/LIGHT read is presence evidence keyboards can't see.
#   2. Thermal ATTRIBUTION: the iGPU sits inside package-0 RAPL, so its draw is already in
#      mesh-package-power's watts — but RAPL can't say CPU-vs-GPU; freq/RC6 attributes it.
#
# Unlike RAPL's 0400 counter this needs NO sudo (files are world-readable). Card index differs
# per node (card0/card1) → auto-discover across MESH_GPU_CARDS, env-overridable.
#
# CONSTRAINT TIER — the ceiling the busy% is only interpretable AGAINST, and its own timescale
# (live-literature review, genome, 2026-08-25; docs/reviews/autopoiesis-constraint-decay-timescale-
# gpu-activity-2026-08-25.md). Montevil & Mossio ("Biological organisation as closure of constraints",
# J. Theor. Biol. 372:179-191, 2015) define a CONSTRAINT as what breaks the symmetry of a process
# *at a given time scale* — the constraint/process cut is not structural, it is TEMPORAL: a constraint
# is whatever is conserved over the timescale of the process it acts on. Lopez-Diaz & Gershenson,
# "A Matter of Time: Towards a General Theory of Agency" (arXiv:2606.23122v2, 22 Jun 2026, rev 30 Jul
# 2026) make that the whole point: constitutive constraints "act, decay, and are regenerated over
# distinct characteristic timescales" (Signature 7, S8), and every process-type carries a
# characteristic lag tau_g (S4, Temporally Parametrized (F,A)-systems). The mesh already embodies
# closure as TOPOLOGY (mesh-closure, review 2026-07-28 — its own header says it "measures a STATIC
# graph"); it embodied the constraint's TIMESCALE nowhere.
#
# What that names here: busy% is a PROCESS reading (fraction of wall time out of RC6). The GPU's
# frequency ceiling is the CONSTRAINT that makes two busy% readings comparable — and this tool used
# to READ gt_max_freq_mhz, print it to the terminal, and then DROP it from both durable artifacts.
# The state file (what every consumer reads) carried "LEVEL busy% actMHz"; the log carried ts/busy/
# level/cur/act. Neither carried max. So 100% busy under a 1150MHz ceiling and 100% busy after
# something lowered the ceiling to 350MHz are 3.3x different work that render as the SAME reading,
# and the corpus that would have to notice the move never recorded it. gt_max_freq_mhz is not an
# invariant: it is an RW sysfs attribute (a power daemon, a tuning script, or a hand can move it),
# unlike gt_RP0_freq_mhz which is the silicon's fixed ceiling. That is exactly a constitutive
# constraint that acts, decays and must be regenerated — with no sense able to see the decay.
#
# So the sense now publishes the constraint BESIDE the process, plus the constraint's own tau: how
# long the current ceiling has held (~/.mesh/.gpu-activity-ceiling journals max + first-seen epoch),
# and whether it MOVED on this run. A reading whose ceiling moved is still a real reading, but it is
# NOT comparable to the one before it, and it says so rather than looking like a workload change.
# headroom = max/RP0 is the decay axis: a software ceiling well under the hardware one is a
# constraint already partly decayed. Honest n/a throughout — an unreadable ceiling renders ceil=na
# held=na and NEVER a fabricated denominator (a-silent-fallback-turns-a-failure-into-a-plausible-
# constant). Fields are APPENDED to the state row, never reordered: both live consumers
# (mesh-stress read_gpu_state, mesh-operator-focus) key on field 1 only.
#
# Honest n/a: no drm card with rc6_residency_ms → exit 2 (UNREACHABLE), never a fabricated busy%.
# State artifact ~/.mesh/.gpu-activity-state written EVERY run (mtime = liveness); per-run log
# ~/.mesh/gpu.log accumulates calibration telemetry (thresholds are PROVISIONAL: 8.9% observed
# on an idle-ish desktop, deep-RC6 headless expected <5%; retune from the log). NOT named
# gpu-activity.log — that is mesh-autowire's stdout JOURNAL (>> <tool>.log), and sharing the
# name mixed human output into the telemetry (the package-power/power.log convention).
#
#   mesh-gpu-activity          one ~2s sample: busy% + IDLE/LIGHT/BUSY + freq + ceiling/tau, state + log
#   mesh-gpu-activity --ceiling  the CONSTRAINT tier alone: max/RP0 MHz, headroom, how long held
#   mesh-gpu-activity --json   same sample, JSON
#   mesh-gpu-activity --status last state-file reading, no new sample
#   mesh-gpu-activity --test   fixture math (delta, clamp, classify) + REAL-READ GATE
#                              (live sample must yield finite 0-100 busy%; exit 2 if no i915 RC6)
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# card auto-discovery: first card in MESH_GPU_CARDS exposing power/rc6_residency_ms
CARD=""
for c in ${MESH_GPU_CARDS:-card1 card0}; do
  [ -r "/sys/class/drm/$c/power/rc6_residency_ms" ] && { CARD="$c"; break; }
done
RC6="${MESH_GPU_RC6_PATH:-/sys/class/drm/${CARD:-card1}/power/rc6_residency_ms}"
RC62="${MESH_GPU_RC6_PATH2:-$RC6}"                # second fixture for deterministic --test deltas
FREQD="${MESH_GPU_FREQ_DIR:-/sys/class/drm/${CARD:-card1}}"
SECS="${MESH_GPU_SAMPLE_SECS:-2}"
BUSY_PCT="${MESH_GPU_BUSY_PCT:-30}"               # sustained media/CV work band (provisional)
IDLE_PCT="${MESH_GPU_IDLE_PCT:-5}"                # deep-RC6 headless band ceiling (provisional)
STATE="${MESH_GPU_STATE:-$HOME/.mesh/.gpu-activity-state}"
LOG="${MESH_GPU_LOG:-$HOME/.mesh/gpu.log}"
CEIL="${MESH_GPU_CEIL_STATE:-$HOME/.mesh/.gpu-activity-ceiling}"   # <max_mhz>\t<epoch first seen at this value>

read_num(){ # $1=path → non-negative integer or fail
  local v; v=$(cat "$1" 2>/dev/null)
  case "$v" in (''|*[!0-9]*) return 1;; esac
  printf '%s' "$v"
}

busy_between(){ # $1=rc6_1_ms $2=rc6_2_ms $3=dt_ms → busy% (0-100, clamped; monotonic counter, no wrap)
  awk -v a="$1" -v b="$2" -v ms="$3" \
    'BEGIN{ d=b-a; if (ms<=0 || d<0) exit 1; p=(1-d/ms)*100; if (p<0) p=0; if (p>100) p=100; printf "%.1f", p }'
}

classify(){ # $1=busy%
  awk -v p="$1" -v hi="$BUSY_PCT" -v lo="$IDLE_PCT" \
    'BEGIN{ if (p>=hi) print "BUSY"; else if (p<lo) print "IDLE"; else print "LIGHT" }'
}

# ── CONSTRAINT TIER ────────────────────────────────────────────────────────────────────────────
# tau of the ceiling: how long gt_max_freq_mhz has held its current value, and whether it moved on
# THIS run. Journal is one line, rewritten only when the value changes — so the epoch it carries is
# genuinely "first seen at this value", not "last time we looked". A missing/corrupt journal is
# treated as a FIRST SIGHTING (held=0, moved=no): we do not know it moved, and claiming it did would
# be a fabricated event. Distinct from claiming it has held forever, which would be the opposite lie —
# held=0 reads as "no history yet" to every consumer.
ceiling_tau(){ # $1=current max_mhz (integer) → "<held_s> <yes|no>"; caller must have a numeric max
  local now prev_v prev_t
  now=$(date +%s)
  if [ -s "$CEIL" ]; then
    prev_v=$(awk -F'\t' 'NR==1{print $1}' "$CEIL" 2>/dev/null)
    prev_t=$(awk -F'\t' 'NR==1{print $2}' "$CEIL" 2>/dev/null)
  fi
  case "${prev_t:-}" in (''|*[!0-9]*) prev_v=""; prev_t="" ;; esac
  if [ -n "$prev_v" ] && [ "$prev_v" = "$1" ]; then
    local held=$(( now - prev_t )); [ "$held" -ge 0 ] || held=0
    printf '%s no' "$held"
    return 0
  fi
  # changed, or never seen: (re)stamp. A change is the CONSTRAINT being regenerated at a new value —
  # the event Signature 7 says a sense must be able to witness, and the reason a reading either side
  # of it is not comparable.
  mkdir -p "$(dirname "$CEIL")" 2>/dev/null
  printf '%s\t%s\n' "$1" "$now" >"$CEIL" 2>/dev/null || true
  if [ -n "$prev_v" ]; then printf '0 yes'; else printf '0 no'; fi
}

read_ceiling(){ # → sets CEIL_MAX CEIL_RP0 CEIL_HEADROOM CEIL_HELD CEIL_MOVED (each 'na' when unknown)
  CEIL_MAX=$(read_num "$FREQD/gt_max_freq_mhz" 2>/dev/null) || CEIL_MAX=""
  CEIL_RP0=$(read_num "$FREQD/gt_RP0_freq_mhz" 2>/dev/null) || CEIL_RP0=""
  CEIL_HEADROOM=na; CEIL_HELD=na; CEIL_MOVED=na
  if [ -n "$CEIL_MAX" ] && [ "$CEIL_MAX" -gt 0 ] 2>/dev/null; then
    set -- $(ceiling_tau "$CEIL_MAX"); CEIL_HELD="$1"; CEIL_MOVED="$2"
    if [ -n "$CEIL_RP0" ] && [ "$CEIL_RP0" -gt 0 ] 2>/dev/null; then
      CEIL_HEADROOM=$(awk -v m="$CEIL_MAX" -v r="$CEIL_RP0" 'BEGIN{printf "%.2f", m/r}')
    fi
  else
    CEIL_MAX=na                                   # never a guessed denominator
  fi
  [ -n "$CEIL_RP0" ] || CEIL_RP0=na
}

if [ "${1:-}" = "--ceiling" ]; then
  read_ceiling
  printf '[gpu-ceiling] max=%sMHz rp0=%sMHz headroom=%s held=%ss moved=%s\n' \
    "$CEIL_MAX" "$CEIL_RP0" "$CEIL_HEADROOM" "$CEIL_HELD" "$CEIL_MOVED"
  [ "$CEIL_MAX" = na ] && exit 2
  exit 0
fi

if [ "${1:-}" = "--test" ]; then
  fail=0
  td=$(mktemp -d); trap 'rm -rf "$td"' EXIT
  # fixture delta: rc6 slept 1826ms of a 2004ms window = 8.9% busy (the live-proof numbers)
  p=$(busy_between 1000000 1001826 2004)
  [ "$p" = "8.9" ] || { echo "  FAIL: plain delta → $p (want 8.9)"; fail=1; }
  # fully asleep: rc6 delta == wall delta → 0.0 (and slight-overshoot clamps to 0, never negative)
  p=$(busy_between 5000 7004 2004)
  [ "$p" = "0.0" ] || { echo "  FAIL: fully-asleep → $p (want 0.0)"; fail=1; }
  p=$(busy_between 5000 7100 2004)
  [ "$p" = "0.0" ] || { echo "  FAIL: rc6-overshoot must clamp to 0.0, got $p"; fail=1; }
  # fully awake: rc6 never advanced → 100.0
  p=$(busy_between 5000 5000 2004)
  [ "$p" = "100.0" ] || { echo "  FAIL: fully-awake → $p (want 100.0)"; fail=1; }
  busy_between 1000 2000 0 >/dev/null 2>&1 && { echo "  FAIL: zero-interval must error"; fail=1; }
  busy_between 2000 1000 500 >/dev/null 2>&1 && { echo "  FAIL: negative rc6 delta must error"; fail=1; }
  [ "$(classify 3.0)"  = IDLE ]  || { echo "  FAIL: classify(3.0) != IDLE"; fail=1; }
  [ "$(classify 8.9)"  = LIGHT ] || { echo "  FAIL: classify(8.9) != LIGHT"; fail=1; }
  [ "$(classify 5.0)"  = LIGHT ] || { echo "  FAIL: classify(5.0) != LIGHT (boundary)"; fail=1; }
  [ "$(classify 30.0)" = BUSY ]  || { echo "  FAIL: classify(30.0) != BUSY (boundary)"; fail=1; }
  # fixture read path (env-path override, proves --test can run counter-free)
  printf '12345\n' >"$td/rc6"; printf 'garbage\n' >"$td/bad"
  [ "$(read_num "$td/rc6")" = 12345 ] || { echo "  FAIL: fixture read_num"; fail=1; }
  read_num "$td/bad" >/dev/null 2>&1 && { echo "  FAIL: non-numeric read must fail"; fail=1; }
  # ── CONSTRAINT TIER (the 2026-08-25 review). Every arm below runs on ANY node — the freq dir and
  # the ceiling journal are both env-overridable — so this gate is NOT hostage to i915 being present,
  # which matters because the node that authored it has none. It drives the WHOLE main path against
  # fixture files and asserts the durable artifacts, not just the helper's return value.
  cd_="$td/ceil"; mkdir -p "$cd_"
  # rc6 delta of ZERO → busy% is exactly 100.0 for ANY dt, so the process reading is deterministic
  # without a timing assumption. 100% busy is also the header's motivating case: the same reading
  # under a 1150MHz and a 350MHz ceiling is 3.3x different work.
  printf '1000000\n' >"$cd_/rc6a"; printf '1000000\n' >"$cd_/rc6b"
  printf '350\n' >"$cd_/gt_cur_freq_mhz"; printf '350\n' >"$cd_/gt_act_freq_mhz"
  printf '1150\n' >"$cd_/gt_max_freq_mhz"; printf '1300\n' >"$cd_/gt_RP0_freq_mhz"
  cenv="MESH_GPU_RC6_PATH=$cd_/rc6a MESH_GPU_RC6_PATH2=$cd_/rc6b MESH_GPU_FREQ_DIR=$cd_ \
        MESH_GPU_STATE=$cd_/state MESH_GPU_LOG=$cd_/log MESH_GPU_CEIL_STATE=$cd_/ceiljournal"
  # (1) FIRST SIGHTING: no journal yet → held=0 and moved=NO. "We have no history" must never be
  # rendered as "the ceiling just moved" (a fabricated event) nor as "it has held forever" (the
  # opposite lie). Both are silent-fallback shapes; held=0/no is the honest third thing.
  o=$(env $cenv "$0" --json 2>&1)
  printf '%s' "$o" | grep -qF '"ceiling_moved":false' \
    || { echo "  FAIL: first sighting must be moved=false, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF '"ceiling_held_s":0' \
    || { echo "  FAIL: first sighting must be held=0, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF '"ceiling_headroom":0.88' \
    || { echo "  FAIL: headroom must be max/RP0 = 1150/1300 = 0.88, got: $o"; fail=1; }
  # (2) HELD: same ceiling, and the journal's epoch backdated 600s → held must be ~600 and moved=no.
  printf '1150\t%s\n' "$(( $(date +%s) - 600 ))" >"$cd_/ceiljournal"
  o=$(env $cenv "$0" --json 2>&1)
  printf '%s' "$o" | grep -qE '"ceiling_held_s":(59[0-9]|60[0-9])' \
    || { echo "  FAIL: unchanged ceiling must report tau ~600s, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF '"ceiling_moved":false' \
    || { echo "  FAIL: unchanged ceiling must be moved=false, got: $o"; fail=1; }
  # (3) THE EVENT Signature 7 says the sense must witness: the ceiling is lowered 1150→350 while the
  # PROCESS reading is byte-identical (same rc6 fixtures, same busy%). Before this tier the two runs
  # were indistinguishable; now the second must say the constraint moved AND restamp tau to 0.
  before_busy=$(printf '%s' "$o" | grep -oE '"busy_pct":[0-9.]+')
  [ "$before_busy" = '"busy_pct":100.0' ] \
    || { echo "  FAIL: fixture must pin the process reading at 100.0 so the invariance arm has teeth, got $before_busy"; fail=1; }
  printf '350\n' >"$cd_/gt_max_freq_mhz"
  o=$(env $cenv "$0" --json 2>&1)
  printf '%s' "$o" | grep -qF '"level":"BUSY"' \
    || { echo "  FAIL: 100% busy must still classify BUSY after the ceiling move — the CLASS is a process verdict, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF '"ceiling_moved":true' \
    || { echo "  FAIL: a lowered ceiling must render moved=true, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF '"ceiling_held_s":0' \
    || { echo "  FAIL: a moved ceiling must restamp tau to 0, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF "$before_busy" \
    || { echo "  FAIL: the PROCESS reading must be unchanged across a pure CONSTRAINT move ($before_busy), got: $o"; fail=1; }
  # (4) the durable artifacts, not just stdout — a consumer reads the state row and the log, and the
  # whole defect was that both DROPPED the ceiling while the terminal line printed it.
  grep -qE 'ceil=350MHz held=0s moved=yes' "$cd_/state" \
    || { echo "  FAIL: state row must carry the constraint tier, got: $(cat "$cd_/state" 2>/dev/null)"; fail=1; }
  grep -qE '^[A-Z]+ ' "$cd_/state" \
    || { echo "  FAIL: state field 1 must still be the bare LEVEL (mesh-stress/operator-focus key on it)"; fail=1; }
  tail -1 "$cd_/log" | grep -qE ' 350 0 yes$' \
    || { echo "  FAIL: log must carry max/held/moved columns, got: $(tail -1 "$cd_/log" 2>/dev/null)"; fail=1; }
  # (5) HONEST N/A: ceiling unreadable → ceil=na, headroom null, and NEVER a fabricated denominator.
  rm -f "$cd_/gt_max_freq_mhz" "$cd_/gt_RP0_freq_mhz"
  o=$(env $cenv "$0" --json 2>&1)
  printf '%s' "$o" | grep -qF '"max_mhz":null' \
    || { echo "  FAIL: unreadable ceiling must be null, never a guessed number, got: $o"; fail=1; }
  printf '%s' "$o" | grep -qF '"ceiling_headroom":null' \
    || { echo "  FAIL: headroom with no denominator must be null, got: $o"; fail=1; }
  grep -qF 'ceil=naMHz' "$cd_/state" \
    || { echo "  FAIL: state must say ceil=na, got: $(cat "$cd_/state" 2>/dev/null)"; fail=1; }
  # (6) --ceiling exits 2 where the constraint is unreadable (organ-absent grammar, matching the
  # tool's own rc=2 UNREACHABLE convention) and 0 where it is readable.
  env $cenv "$0" --ceiling >/dev/null 2>&1 && { echo "  FAIL: --ceiling must exit 2 with no readable ceiling"; fail=1; }
  printf '1150\n' >"$cd_/gt_max_freq_mhz"
  env $cenv "$0" --ceiling >/dev/null 2>&1 || { echo "  FAIL: --ceiling must exit 0 with a readable ceiling"; fail=1; }

  # REAL-READ GATE (verification principle: a sense --test asserts real hardware produces data).
  # No i915 RC6 counter on this node = honest n/a exit 2, never fake green.
  if ! r1=$(read_num "$RC6"); then
    # A NODE-ABSENT ORGAN MUST NOT LAUNDER A LOGIC FAILURE. The fixture arms above are node-free and
    # ran to completion; if any of them went red, exiting 2 "n/a" here would render a genuine defect
    # as "no hardware" on every node without an iGPU — which is the node that authored them. rc=2 is
    # a claim about the NODE, and it is only honest when nothing else has already failed.
    # (a-red-gate-hides-every-gate-after-it / a-multi-lane-rc-is-an-and-so-one-dark-lane-is-silent.)
    [ "$fail" = 0 ] || { echo "smoke-test: FAIL (node-free fixture arms red; the missing i915 is NOT why)"; exit 1; }
    echo "smoke-test: n/a — no readable rc6_residency_ms on this node (no Intel iGPU/i915); node-free fixture arms (incl. constraint tier) PASSED"
    exit 2
  fi
  t1=$(date +%s%N); sleep 1
  r2=$(read_num "$RC62") || { echo "  FAIL: second live RC6 read failed after first succeeded"; fail=1; r2=$r1; }
  t2=$(date +%s%N)
  lp=$(busy_between "$r1" "$r2" $(( (t2 - t1) / 1000000 ))) || lp=""
  case "$lp" in
    ('') echo "  FAIL: live read gate — busy% '$lp' not finite (hollow sense)"; fail=1;;
    (*)  echo "  live read: ${lp}% busy ($(classify "$lp")) — real hardware produced data";;
  esac
  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

if [ "${1:-}" = "--status" ]; then
  if [ -s "$STATE" ]; then
    printf '[gpu-activity] %s (as of %s)\n' "$(cat "$STATE")" \
      "$(date -u -r "$STATE" +%FT%TZ 2>/dev/null || echo '?')"
    exit 0
  fi
  echo "[gpu-activity] no state yet — run mesh-gpu-activity for a sample"; exit 2
fi

r1=$(read_num "$RC6") || { echo "mesh-gpu-activity: rc6_residency_ms not readable (no Intel iGPU/i915) — UNREACHABLE" >&2; exit 2; }
t1=$(date +%s%N)
[ "$RC62" = "$RC6" ] && sleep "$SECS"
r2=$(read_num "$RC62") || { echo "mesh-gpu-activity: second RC6 read failed — UNREACHABLE" >&2; exit 2; }
t2=$(date +%s%N)
dt_ms=$(( (t2 - t1) / 1000000 ))
busy=$(busy_between "$r1" "$r2" "$dt_ms") \
  || { echo "mesh-gpu-activity: bad sample (dt=${dt_ms}ms) — UNREACHABLE" >&2; exit 2; }
level=$(classify "$busy")
cur=$(read_num "$FREQD/gt_cur_freq_mhz" 2>/dev/null) || cur=""
act=$(read_num "$FREQD/gt_act_freq_mhz" 2>/dev/null) || act=""   # 0 = powered down (itself an idle signal)
read_ceiling                                                     # → CEIL_MAX CEIL_RP0 CEIL_HEADROOM CEIL_HELD CEIL_MOVED
maxf="$CEIL_MAX"
ts=$(date -u +%FT%TZ)

mkdir -p "$(dirname "$STATE")" 2>/dev/null
# STATE: fields APPENDED, field 1 untouched — mesh-stress read_gpu_state and mesh-operator-focus both
# key on the leading token only, so the constraint tier reaches them without a format sweep. A
# consumer that wants to normalize busy% now can; one that doesn't is unaffected.
printf '%s %s%% %sMHz ceil=%sMHz held=%ss moved=%s\n' \
  "$level" "$busy" "${act:-${cur:-?}}" "$CEIL_MAX" "$CEIL_HELD" "$CEIL_MOVED" >"$STATE"  # unconditional: mtime = liveness
# LOG: max/held/moved were the columns the corpus lacked — without them no recalibration could ever
# ask "did the ceiling move under this sample?", which is the only question that separates a workload
# change from a constraint change.
printf '%s %s %s %s %s %s %s %s\n' "$ts" "$busy" "$level" "${cur:-?}" "${act:-?}" "$CEIL_MAX" "$CEIL_HELD" "$CEIL_MOVED" >>"$LOG"
if [ "$(wc -l <"$LOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

if [ "${1:-}" = "--json" ]; then
  _jnum(){ case "$1" in (''|na|'?') printf 'null';; (*) printf '%s' "$1";; esac; }
  printf '{"level":"%s","busy_pct":%s,"elapsed_ms":%s,"cur_mhz":%s,"act_mhz":%s,"max_mhz":%s,"rp0_mhz":%s,"ceiling_headroom":%s,"ceiling_held_s":%s,"ceiling_moved":%s,"ts":"%s"}\n' \
    "$level" "$busy" "$dt_ms" "$(_jnum "${cur:-}")" "$(_jnum "${act:-}")" "$(_jnum "$maxf")" \
    "$(_jnum "$CEIL_RP0")" "$(_jnum "$CEIL_HEADROOM")" "$(_jnum "$CEIL_HELD")" \
    "$([ "$CEIL_MOVED" = yes ] && printf true || { [ "$CEIL_MOVED" = no ] && printf false || printf null; })" "$ts"
else
  printf '[gpu-activity] %s — %s%% busy over %ss | freq cur=%s act=%s max=%sMHz | ceiling held %ss headroom=%s%s | thresholds idle<%s busy>=%s\n' \
    "$level" "$busy" "$(awk -v ms="$dt_ms" 'BEGIN{printf "%.1f", ms/1000}')" \
    "${cur:-?}" "${act:-?}" "${maxf:-?}" "$CEIL_HELD" "$CEIL_HEADROOM" \
    "$([ "$CEIL_MOVED" = yes ] && printf ' CEILING-MOVED (not comparable to the previous reading)' || printf '')" \
    "$IDLE_PCT" "$BUSY_PCT"
fi
