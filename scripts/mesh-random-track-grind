#!/usr/bin/env bash
# mesh-random-track-grind — once a day, draw a RANDOM track off the open internet and grind it,
# the same way the lane grinds room recordings. Operator 2026-08-29 via TG: "случайный просто вот
# трек искать какой-нибудь в интернете, раз в день, например, случайный трек, и из него делать
# этот гранюль".
#
# reflex-cadence: 23 */2 * * *
#
# CADENCE — WAS '17 9 * * *', AND IT HAD NEVER FIRED. Measured 2026-08-30: every row in the ledger
# is from the 19:44-20:22Z hand-driven run of 08-29; the tool was autowired that same day, so its
# first 09:17 slot had not yet come round. On this node a daily slot is not merely rare, it is
# LOST — CLAUDE.md measured 54% of daily fires over 7 days landing in a powered-off machine. And
# the operator asked for "по мере поступления давайте, охота послушать": one mix arriving as it
# renders, not a batch. A once-a-day draw cannot express that at all. Every 2h gives each of the
# four strata a turn roughly twice a day while staying far below any rate archive.org would mind.
#
# THE RANDOMNESS IS THE IDEA, so it is the part most worth getting right and easiest to fake.
# Two ways this silently degrades into "a chart wearing a different name", both handled:
#   · archive.org's advancedsearch caps deep paging at ~10k rows. A naive 'random offset in [0,N)'
#     over a 26k universe can only ever land in the first 10k, ordered by the default sort — a
#     silent 62% truncation. So the draw walks per-YEAR counts, builds the cumulative
#     distribution, picks k uniform in [0,N) and pages to the stratum containing k.
#   · picking a random YEAR then a random item inside it is NOT uniform over items: it
#     over-weights sparse years. Uniform-over-strata is not uniform-over-population. The
#     cumulative walk above avoids this; do not "simplify" it back to a random year.
#
# LICENCE IS A GATE, NOT A NOTE. A granular grind is a DERIVATIVE work. The universe therefore
# excludes -nd (NoDerivatives) licences and the per-item licence is re-checked after the draw
# rather than trusted from the query. This is load-bearing, not paperwork: measured 2026-08-29,
# 35972 of 62117 licensed netlabel items (58%) are ND, and the very first uniform draw landed on
# one. Renders inherit the source licence (BY-NC-SA => ShareAlike) and ship WITH attribution.
#
# REJECTION IS LOGGED. Redrawing past unusable items is legitimate sampling (uniform over the
# sub-population meeting a necessary condition) but only while the reasons are visible — a silent
# redraw loop is indistinguishable from cherry-picking. Every rejection lands in the ledger.
#
# SOURCE CLASS: external tracks carry their own organ tag, never the room ear's. A pooled statistic
# over a mixture measures the mixture WEIGHTS, not the material, so a new organ arrives with its
# own arm. MEASURE: the soundscape measure tract only — one analyzer, never a second.
set -uo pipefail
# CRON HAS NO ~/.local/bin, AND THE FAILURE LANDED IN THE ONE PLACE IT READ AS THE MATERIAL'S FAULT.
# cron's default PATH is /usr/bin:/bin and nothing sets a PATH= line in the crontab, so every bare
# call to a sibling mesh tool from a cron-launched run resolves to nothing. This tool's only sibling
# call is the measure tract — so EVERY 2-hourly fire that got as far as measuring died there, and
# before the reject verbs were split (2026-08-30) it wore the word "unmeasurable", i.e. a verdict
# about the TRACK. First fire after the split named it outright: "measure-failed … timeout: failed
# to run command 'mesh-soundscape': No such file or directory". mesh-soundscape, mesh-records,
# mesh-sound-reflex and mesh-room-music all self-heal; this one, autowired last, did not.
# /usr/bin FIRST for the same reason mesh-soundscape gives: never a snap-confined ffmpeg/ffprobe.
export PATH="/usr/bin:$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
OUTDIR="${RTG_OUTDIR:-$HOME/sound-random-daily}"
LEDGER="$MESH/random-track-grind.log"
# ── STRATA — four universes drawn SEPARATELY and mixed on delivery ────────────────────────────
# Operator 2026-08-29/30 via TG: "lets make grainneukeln mixes from lots of traditional music from
# all over the world" and, asked to pick one reading of "мировая музыка": "вообще всё — и полевые
# записи, и этнография, и изданные народные пластинки. В этом прикол."
#
# THIS IS NOT ONE WIDER QUERY, and the reason is arithmetic, not taste. Measured on archive.org
# 2026-08-30 under this same licence gate: field 64800 · netlabels ~26k · records 294 · ethno 242.
# Pooled, the two he most wants to hear would be 0.8% of draws — he would hear near-pure field
# recording, conclude the folk records are not there, and be wrong: they were simply never drawn.
# So each stratum is its OWN universe with its OWN uniform draw, selection round-robins across
# them, and the ledger carries 'stratum=' so a HUNGRY stratum reads as hungry and never as absent.
# '--status' prints the per-stratum draw counts for exactly that reason.
#
# The picker reads RTG_UNIVERSE from the environment, so swapping the universe does NOT touch the
# uniform-draw machinery: the cumulative addeddate walk and the page-not-start fix are properties
# of the SAMPLER, not of the corpus, and its own --test still guards them. That separation is why
# this change is a table edit rather than a rewrite.
#
# SUBJECT TAGS ENCODE ABOUTNESS, NOT MEMBERSHIP, so the strata are keyed on COLLECTIONS wherever a
# collection exists. Measured the same day: subject:(ethnic OR ethnographic OR indigenous) returns
# podcasts and Free Speech Radio News; subject:(traditional) returns netlabel electronica and ham
# radio. Only 'records' uses a subject term, and only to narrow a collection that is already the
# right medium (78rpm shellac) toward the world material inside it.
LICGATE='licenseurl:[* TO *] AND NOT licenseurl:*-nd*'
# THE ND EXCLUSION IS LOAD-BEARING ON EVERY STRATUM, not just the netlabel one: a granular grind is
# a DERIVATIVE work and the channel is public. It is appended here, once, so a stratum added later
# cannot forget it.
strata_names="field ethno records netlabels"
stratum_q(){ case "$1" in
  # FIELD RECORDINGS — radio aporee ::: maps, worldwide located field recordings, CC BY-SA.
  field)     echo "mediatype:audio AND collection:radio-aporee-maps AND $LICGATE" ;;
  # ETHNOGRAPHY — the Helen Hartness Flanders Ballad Collection: field-recorded traditional
  # ballads (cylinder and cassette dubs) held by Middlebury College. Small on purpose; a stratum
  # that is small draws exactly as often as a large one, which is the whole point of drawing
  # per-stratum, and its exhaustion is a fact the counters will show rather than hide.
  ethno)     echo "mediatype:audio AND collection:helenhartnessflanders AND $LICGATE" ;;
  # RELEASED FOLK RECORDS — 78rpm shellac (incl. the George Blood digitisation), narrowed toward
  # the world material. Licences here are publicdomain-mark / CC0, which permit derivatives and
  # pass the -nd gate; we attribute anyway, because the channel is public and a caption that
  # cannot name its source is not publishable whatever the licence permits.
  records)   echo "mediatype:audio AND (collection:78rpm OR collection:georgeblood) AND subject:(folk OR folklore OR traditional OR ethnic OR \"world music\") AND $LICGATE" ;;
  # The original lane, kept BESIDE the new ones (operator: рядом, не вместо).
  netlabels) echo "collection:netlabels AND $LICGATE" ;;
  *)         echo "" ;;
esac; }

# ROUND-ROBIN, persisted. A random stratum per run would re-introduce the drowning at a smaller
# scale over any short window — and short windows are all the operator sees. The cursor is written
# BEFORE the draw, never after: a run killed mid-grind must not hand its successor the same
# stratum forever (CLAUDE.md, a cursor saved at the end of a pass repeats every fire a crash
# interrupts).
CURSOR="$MESH/.random-track-stratum.cursor"
next_stratum(){
  local last i=0 n=0 names; read -ra names <<< "$strata_names"
  last="$(cat "$CURSOR" 2>/dev/null || echo)"
  for i in "${!names[@]}"; do [ "${names[$i]}" = "$last" ] && { n=$(( (i+1) % ${#names[@]} )); break; }; done
  printf '%s' "${names[$n]}"
}
STRATUM="${RTG_STRATUM:-$(next_stratum)}"
UNIVERSE="$(stratum_q "$STRATUM")"
[ -n "$UNIVERSE" ] || { echo "mesh-random-track-grind: unknown stratum '$STRATUM' (have: $strata_names)" >&2; exit 2; }
MAXTRY="${RTG_MAXTRY:-25}"
# THE PUBLIC CHANNEL, not the operator DM. 2GB userbot ceiling vs the bot organ's 20MB, so a full
# uncut track is shippable. Overridable so a node without this channel is not pinned to one target.
#
# A USERNAME, NOT A NUMERIC ID, AND THIS WAS MEASURED THE HARD WAY 2026-08-30. The lane was handed
# id 4441925563; the first delivery to it SUCCEEDED at 03:22:39Z and the second, 16 minutes later,
# died 'no dialog with id 4441925563' — and by then the id resolved to nothing at all, while the
# channel the operator was actually given (https://t.me/grainneukeln) is a DIFFERENT entity,
# 4375750494. So the first mix was posted somewhere the operator cannot see, and the ledger said
# DELIVERED. Two distinct failures share that one symptom:
#   · a numeric id resolves only out of the session's DIALOG CACHE (mesh-tg-user walks iter_dialogs
#     and matches by id), so it is a claim about this session's local state, not about the channel;
#   · a channel re-created under the same name keeps the NAME and gets a NEW id, so an id pinned in
#     a config silently addresses the corpse — the same shape as this node's tailscale identity
#     re-creation, where discovery returned a dead device and never the live one.
# A @username survives both: it takes get_entity's username path, needs no cache, and follows the
# name to whichever entity currently holds it. DELIVERED is only true of a target that resolves.
TG_CHANNEL="${RTG_TG_CHANNEL:-@grainneukeln}"
# THE LEDGER AND THE RUN LOG MUST BE DIFFERENT FILES, and the first cron fire proved why. 'say'
# writes the stamped row to $LEDGER and echoes the bare row to stdout; the autowired cron line
# redirected stdout INTO $LEDGER, so every row landed twice — once stamped, once bare — and every
# count derived from it ('--status', the per-stratum counters, the re-apply rate anyone quotes off
# it) doubled for cron runs and not for hand runs. That is worse than being wrong: it is wrong only
# in the rows nobody was watching, because until the cadence was fixed this lane had never once
# fired from cron. Same shape as mesh-exit-node-lan-heal keeping its applications ledger apart from
# its cron stdout log for exactly this reason.
#
# So REFUSE the collision rather than trusting the crontab to stay right. stdout is compared to the
# ledger by INODE, never by path — a redirect reaches the same file through $HOME, a symlink or a
# relative path, and a string compare would miss all three.
# fd 1 IS DUPLICATED FIRST, because '$(stat ... /proc/self/fd/1)' reads the COMMAND SUBSTITUTION's
# pipe, not the script's stdout — measured: inside '$( )' it returns a pipe inode every time, so the
# probe read CLEAR while stdout genuinely was the ledger. Duplicate to fd 9 before substituting.
_stdout_is_ledger(){
  local a b
  exec 9>&1 || return 1
  a="$(stat -Lc '%d:%i' /proc/self/fd/9 2>/dev/null)"
  exec 9>&-
  b="$(stat -Lc '%d:%i' "$LEDGER" 2>/dev/null)" || return 1
  [ -n "$a" ] && [ "$a" = "$b" ]
}
if _stdout_is_ledger; then
  printf '%s COLLISION stdout is the ledger itself (%s) — every row would be written TWICE and every count doubled; redirect the run to a DIFFERENT file\n' \
    "$(date -u +%FT%TZ)" "$LEDGER" >> "$LEDGER"
  echo "mesh-random-track-grind: refusing to run — stdout IS $LEDGER, so the ledger would double-count itself" >&2
  exit 2
fi
say(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LEDGER"; echo "$*"; }
nofetch(){ echo "mesh-random-track-grind: $*" >&2; }

# TWO WORLDS WORE ONE WORD, AND THE COLLAPSE INVERTED THE DIAGNOSIS. `MEASURE none` is the tract's
# VERDICT ABOUT THE MATERIAL (below the silence floor / too short / the file did not decode); an
# EMPTY capture is THE TRACT ITSELF FAILING — the 400s timeout, a missing grainneukeln venv python
# (mesh-soundscape's own exit 2), a crash. A broken toolchain therefore rendered as "this track is
# bad material", and every other REJECT in this run names its mechanism precisely (undecodable +
# ffmpeg's last line, transcode-empty, TRUNCATED-BY-TRANSCODE with both durations, unusable-audio
# dur=) while this one — the only one that can be the LANE's fault rather than the track's — said a
# single adjective. Live cost, 2026-08-30: 6 consecutive ext fires delivered nothing (4 DRAW-FAILED,
# 1 FETCH-FAILED, 2 REJECT below) and the starve census read the resulting quiet as "ext SILENT —
# the SOURCE stopped, so re-tuning the picker buys nothing", which is the opposite of true: the
# source fires every 2h and fails loudly in a ledger nothing reads.
# A FUNCTION rather than an inline block so --test drives THIS code and not a second copy of it.
# Sets the global $m on success; exits 1 with a named verb otherwise.
measure_or_reject(){  # $1 = normalised source file
  _mse="${TMPDIR:-/tmp}/.rtg-measure-err.$$"
  m=$(timeout 400 mesh-soundscape --measure "$1" 2>"$_mse" | grep '^MEASURE' | head -1)
  _mwhy="$(tail -1 "$_mse" 2>/dev/null | tr -d '\r' | cut -c1-200)"; rm -f "$_mse"
  case "$m" in
    *MEASURE\ none*) say "REJECT $ident stratum=$STRATUM unmeasurable :: ${_mwhy:-reason-unstated}"; exit 1 ;;
    "")              say "REJECT $ident stratum=$STRATUM measure-failed (no MEASURE line at all — this is the tract, NOT a verdict about this track) :: ${_mwhy:-no-stderr}"; exit 1 ;;
  esac
}

case "${1:-}" in
  --test)
    # NO NETWORK in --test: assert the invariants that can rot, not the world's availability.
    fail(){ echo "FAIL: $*" >&2; exit 1; }
    # EVERY assertion below splits its literal ("ab""cd") so the gate line does NOT contain the
    # string it searches for. 'grep -q 'X' "$0"' where the gate itself spells X matches ITSELF and
    # can never fail — measured here: the first cut of the normalise gate stayed GREEN with the
    # real ffmpeg call deleted. Vacuous by polarity, exactly the trap CLAUDE.md names. Proven by
    # mutation: delete any asserted call and its gate goes red.
    grep -q 'NOT licenseurl:\*-''nd\*' "$0" || fail "the ND exclusion left the universe — grinds would become derivative works of no-derivative sources"
    # The exclusion being PRESENT in the source is not the exclusion WORKING: a misspelled field
    # name (licenceurl vs licenseurl — a live finding in a sibling lane the same day, where the ND
    # gate had never once fired) matches nothing, errors nowhere, and simply returns more rows. That
    # can only be shown with the network, so it lives in --nd-audit; assert the audit still exists.
    grep -q '\-\-nd-''audit)' "$0" || fail "the control-vs-treatment ND audit is gone — 'the clause is in the source' cannot distinguish a working exclusion from a misspelled one, and the failure direction is publishing a NoDerivatives work"
    grep -q 'src=e''xt/%s' "$0" || fail "external renders are not STAMPED with their own organ — the repulsor files them as ambient and the starve census cannot see them as a distinct source"
    grep -q 'mesh-soundscape --''measure' "$0" || fail "the one measure tract is not invoked"
    grep -q 'cumul''ative' "$0" || fail "the uniform-draw rationale is gone; a random-year draw is not uniform over items"
    grep -q '< /dev/''null' "$0" || fail "the grind child is a REPL: without stdin protection it eats its caller's input"
    grep -q 'mkdir -p "$D/''out"' "$0" || fail "the engine does not create its own output dir — without the mkdir every run logs GRIND-EMPTY"
    grep -q 'libmp3''lame' "$0" || fail "no normalise step: the engine reads only wav/mp3/webm/m4a, so an ogg or flac draw dies with a bare 'Conversion failed!'"
    grep -q 'PROVENANCE-''COLLISION' "$0" || fail "nothing refuses to bind one archivist hash to a SECOND work — a consumer resolving it would attribute a BY/BY-SA render to the wrong author, and this ledger exists for exactly that lookup"
    grep -q '_dep_''md5' "$0" || fail "the archived record is matched by RECENCY, not content: when the sweep has not archived this deposit the newest record is the PREVIOUS track's, and the row binds that hash to this identifier — measured live, 2 of 5 rows were wrong this way and a stale newest is indistinguishable from a fresh one"
    grep -q "awk -F'\\\\t' -v h=" "$0" || fail "the provenance dedup does not split on the TAB the writer emits — the old guard grepped for a space and therefore never matched, never deduped, and let a duplicate hash through"
    grep -q 'ext-''provenance' "$0" || fail "no provenance ledger: a lane render of an archived ext record cannot name its source or licence, and BY/BY-NC/BY-SA all REQUIRE attribution"
    grep -q 'ext-''inbox' "$0" || fail "the external source is never deposited for the archivist — mesh-records cannot give ext its own arm, which was the operator's actual constraint"
    grep -q '2>"$D/pick.''err"' "$0" || fail "the picker's stderr is discarded — its rejects ledger and pool count are the only evidence separating an unreachable corpus from 25 legitimate refusals, and DRAW-FAILED would name a remedy for neither"
    # ── THE POOL CENSUS SEPARATES BLINDNESS FROM AN EMPTY CORPUS ({#ba7384ce}, 2026-08-30) ──────
    # The per-year census used to be `except: counts.append(0)`, so an unreachable or rate-limiting
    # archive.org made all 29 years read 0, pool=0, and the draw died in `random.randrange(0)` — a
    # traceback naming the one thing that was not wrong. Three fires died that way in sequence
    # (08:23 ethno, 10:23 records, 12:23 netlabels) while the same universes answered numFound
    # 12/3/1008/5108 for addeddate 2015 alone. DRIVEN against REAL sockets, both arms, because the
    # whole finding is that ONE pool=0 has two causes with opposite remedies and no fixture short of
    # a socket can produce the difference: one server that refuses the connection, one that answers
    # a well-formed empty universe. A grep for the word cannot tell those two apart either.
    # SIBLING FIRST, then PATH: --test run from the source tree must drive the source picker, or the
    # arm silently certifies the DEPLOYED copy and a fix that has not shipped yet reads as absent.
    _pk="$(dirname "$0")/mesh-random-track-pick"
    [ -x "$_pk" ] || _pk="$(command -v mesh-random-track-pick || true)"
    if [ -x "$_pk" ]; then
      # BLIND: nothing listening. Every year query raises -> pool unknown, rc 4, and it must say the
      # SEARCH API is the remedy rather than the query.
      _pe="$(RTG_BASE="http://127.0.0.1:1/x" RTG_MAXTRY=1 "$_pk" 2>&1 >/dev/null)"; _prc=$?
      case "$_pe" in
        *POOL-UNKNOWN*) : ;;
        *) fail "an unreachable search API produced '$(printf '%s' "$_pe" | tail -1)' — a failed year query must not be counted as an empty year, or 29 blind years sum to a pool of 0 and the draw dies naming randrange" ;;
      esac
      [ "$_prc" = 4 ] || fail "blindness exited rc=$_prc, want 4 — a caller cannot distinguish 'retry, the API is down' from 'fix the query' by reading a traceback"
      # EMPTY: a real server answering a well-formed universe that holds nothing. Same pool=0, and
      # it must get the OTHER word and the OTHER rc. This arm is the control: without it, an
      # abstention written wide enough to swallow the empty case passes the blind arm above.
      _ptmp="$(mktemp -d)"; _psrv="$_ptmp/zero-srv.py"
      printf '%s\n' 'import http.server,sys' \
        'class H(http.server.BaseHTTPRequestHandler):' \
        '    def do_GET(s):' \
        '        s.send_response(200); s.send_header("Content-Type","application/json"); s.end_headers()' \
        '        s.wfile.write(b"{\"response\":{\"numFound\":0,\"docs\":[]}}")' \
        '    def log_message(s,*a): pass' \
        'h=http.server.HTTPServer(("127.0.0.1",0),H)' \
        'print(h.server_address[1],flush=True)' \
        'h.serve_forever()' > "$_psrv"
      exec 9< <(python3 "$_psrv"); read -r _pport <&9
      _pe2="$(RTG_BASE="http://127.0.0.1:$_pport/x" RTG_MAXTRY=1 "$_pk" 2>&1 >/dev/null)"; _prc2=$?
      exec 9<&-; pkill -f "$_psrv" 2>/dev/null || true; rm -rf "$_ptmp"
      case "$_pe2" in
        *POOL-EMPTY*) : ;;
        *) fail "a REACHABLE server answering an empty universe produced '$(printf '%s' "$_pe2" | tail -1)' — pool=0 with every year query green is a fact about the QUERY, and calling it blindness sends the operator to retry a corpus that will still be empty" ;;
      esac
      [ "$_prc2" = 3 ] || fail "an empty universe exited rc=$_prc2, want 3 — the two causes of pool=0 must not share an exit code"
      unset _pe _pe2 _prc _prc2 _psrv _pport _ptmp
    fi
    # ── THE STRATA (task {#36900a80}) ────────────────────────────────────────────────────
    # Every assertion here still splits its literal, for the reason above: a gate that spells the
    # string it greps for matches its own line and can never fail.
    grep -q 'collection:radio-''aporee-maps' "$0" || fail "the FIELD stratum is gone — 'полевые записи' was one of the three the operator named explicitly"
    grep -q 'collection:helenhartness''flanders' "$0" || fail "the ETHNO stratum is gone — 'этнография' was one of the three the operator named explicitly"
    grep -q 'collection:george''blood' "$0" || fail "the RECORDS stratum is gone — 'изданные народные пластинки' is the RAREST of the three (294 items vs field's 64800), so it is the one a pooled query drowns and the one whose absence reads as 'there are none'"
    grep -q 'collection:net''labels' "$0" || fail "the netlabel stratum was REPLACED rather than joined — the operator said рядом, не вместо"
    # The ND exclusion must be reachable from EVERY stratum, not just the one it started on. It is
    # appended once via LICGATE precisely so a stratum added later cannot forget it; assert that
    # the shared gate is what carries it, and that no stratum builds its query without it.
    grep -q "LICGATE='licenseurl:\[\* TO \*\] AND NOT licenseurl:\*-""nd\*'" "$0" \
      || fail "the ND exclusion is no longer the SHARED gate — a stratum can now be added without it, and a -nd grind on a PUBLIC channel is a licence violation, not an untidiness"
    _nostrat=$(grep -cE '^  (field|ethno|records|netlabels)\)' "$0" 2>/dev/null || echo 0)
    _withgate=$(grep -cE '^  (field|ethno|records|netlabels)\).*\$LICGATE' "$0" 2>/dev/null || echo 0)
    [ "$_nostrat" -gt 0 ] && [ "$_nostrat" -eq "$_withgate" ] \
      || fail "$((_nostrat - _withgate)) of $_nostrat stratum quer(ies) do not append \$LICGATE — that stratum can draw a NoDerivatives item onto a public channel"
    # ROUND-ROBIN, not random-per-run: a random pick re-creates the drowning over any short window,
    # and short windows are all the operator ever sees.
    # DRIVEN, NOT GREPPED. The first cut of this arm searched for the selector by NAME and stayed
    # GREEN when the definition was renamed, because the call site still spelled the old name — a
    # string being present is not the code running. So walk the cursor through a full cycle and
    # assert it visits every declared stratum exactly once and closes the ring: that is false for a
    # random picker, for a stuck selector, and for a rotation that skips a member.
    _cyc=""; CURSOR="$(mktemp)"; printf 'field' > "$CURSOR"
    for _i in 1 2 3 4; do _n="$(next_stratum)"; _cyc="$_cyc $_n"; printf '%s' "$_n" > "$CURSOR"; done
    rm -f "$CURSOR"
    [ "$_cyc" = " ethno records netlabels field" ] \
      || fail "the stratum selector does not round-robin the declared list (from 'field' four steps gave '$_cyc', want ' ethno records netlabels field') — a per-run random stratum re-drowns the rare strata over exactly the short windows the operator actually listens across, and a stuck one starves three of the four"
    [ "$(printf '%s\n' $_cyc | sort -u | wc -l)" -eq 4 ] \
      || fail "the stratum cycle repeats a member within one rotation — some stratum is drawn twice as often as another, which is the weighting this whole split exists to remove"
    # The cursor must be written BEFORE the draw. Assert by POSITION, not by presence: a cursor
    # write that has drifted below the grind repeats the same stratum forever after any crash.
    _cw=$(grep -n '> "\$CURSOR"' "$0" | head -1 | cut -d: -f1)
    _dr=$(grep -n 'RTG_UNIVERSE="\$UNIVERSE"' "$0" | head -1 | cut -d: -f1)
    [ -n "$_cw" ] && [ -n "$_dr" ] && [ "$_cw" -lt "$_dr" ] \
      || fail "the stratum cursor is written at/after the draw (cursor line ${_cw:-none}, draw line ${_dr:-none}) — a run killed in the grind then hands its successor the SAME stratum forever"
    # PER-STRATUM COUNTERS over the DECLARED list, never over what the ledger happens to hold.
    # A ZERO MUST RENDER AS ONE LINE. 'grep -c' prints 0 and exits 1, so the obvious '|| echo 0'
    # emits it twice and the hungry stratum — the only reading this split exists to produce —
    # arrives as a mangled two-line field. Driven, not grepped: count the lines of a real --status
    # against a ledger holding one stratum, where three of the four counters are zero.
    _L="$(mktemp)"; printf '%s DREW x stratum=records licence=z\n' "2026-01-01T00:00:00Z" > "$_L"
    _so="$(LEDGER="$_L" MESH="$MESH" bash -c 'LEDGER="'"$_L"'"; strata_names="'"$strata_names"'"
      _n(){ grep -cE "$1" "$LEDGER" 2>/dev/null || true; }
      for _s in $strata_names; do printf "  %-10s drew=%s\n" "$_s" "$(_n " DREW .* stratum=$_s ")"; done')"
    rm -f "$_L"
    [ "$(printf '%s\n' "$_so" | grep -c .)" -eq 4 ] \
      || fail "the per-stratum counters do not render one line per stratum ($(printf '%s\n' "$_so" | grep -c . ) lines for 4 strata) — grep -c prints 0 AND exits 1, so a '|| echo 0' emits the zero twice and the HUNGRY stratum, the one reading this split exists to produce, arrives mangled"
    printf '%s\n' "$_so" | grep -q 'field      drew=0$' \
      || fail "a never-drawn stratum does not render a clean 'drew=0' — got: $(printf '%s\n' "$_so" | head -1)"
    # EVERY terminal row must carry stratum=, or the per-stratum reject counter silently
    # undercounts. Found live on the first cron fire: 'REJECT <id> unmeasurable' had no stratum, so
    # records showed rejected=0 while holding a reject. Counted from the source, so a new terminal
    # verb added without the tag fails here.
    _terms=$(grep -cE 'say "(REJECT|FETCH-FAILED|FETCH-EMPTY|GRIND-EMPTY|DELIVER-FAILED|DELIVERED|DRAW-FAILED)' "$0" 2>/dev/null || true)
    _tagged=$(grep -cE 'say "(REJECT|FETCH-FAILED|FETCH-EMPTY|GRIND-EMPTY|DELIVER-FAILED|DELIVERED|DRAW-FAILED) [^"]*stratum=\$STRATUM' "$0" 2>/dev/null || true)
    [ "$_terms" -gt 0 ] && [ "$_terms" -eq "$_tagged" ] \
      || fail "$((_terms - _tagged)) of $_terms terminal ledger row(s) carry no stratum= — the per-stratum counters undercount exactly the strata that are FAILING, which is the reading this split exists to produce"

    # THE TWO MEASURE OUTCOMES MUST WEAR TWO VERBS. A `MEASURE none` is the tract's verdict about
    # THE TRACK; an empty capture is THE TRACT failing (its 400s timeout, a missing grainneukeln
    # venv python, a crash). Collapsed, a broken toolchain reads as bad material — and the lane's
    # resulting quiet then reads to the starve census as "the source stopped", which sends the next
    # mind to re-tune a picker that was never the problem. Driven against a STUB tract on PATH, both
    # branches, in a subshell (the verbs exit 1) with the ledger pointed at a scratch file so the
    # drive forges no liveness row.
    _sb="$(mktemp -d)"
    printf '#!/bin/bash\necho "MEASURE none"\necho "measure-none: load-fail boom" >&2\nexit 2\n' > "$_sb/mesh-soundscape"
    printf '#!/bin/bash\necho "measure: n/a (venv python missing)" >&2\nexit 2\n' > "$_sb/tract-dead"
    chmod +x "$_sb/mesh-soundscape" "$_sb/tract-dead"
    _drive(){ ( LEDGER="$_sb/ledger"; ident=T; STRATUM=records; PATH="$_sb:$PATH"; measure_or_reject /dev/null ) 2>/dev/null; }
    _r_none="$(_drive)"
    cp "$_sb/tract-dead" "$_sb/mesh-soundscape"
    _r_dead="$(_drive)"
    rm -rf "$_sb"
    echo "  measure-verbs: verdict='$_r_none'"
    echo "  measure-verbs: tract  ='$_r_dead'"
    [ -n "$_r_none" ] && [ -n "$_r_dead" ] \
      || fail "one of the two measure outcomes emitted no ledger row at all (verdict='$_r_none' tract='$_r_dead') — a silent reject is worse than a collapsed one"
    [ "$_r_none" != "$_r_dead" ] \
      || fail "a MEASURE-none VERDICT and a DEAD TRACT produce the same ledger row ('$_r_none') — a broken toolchain is indistinguishable from bad material, and the lane's silence then reads to the starve census as 'the source stopped'"
    case "$_r_none" in *"load-fail boom"*) : ;; *) fail "the verdict row dropped the reason the tract handed it (got '$_r_none') — the collapse is only half-undone: the two verbs differ but neither says WHY" ;; esac
    case "$_r_dead" in *"venv python missing"*) : ;; *) fail "the tract-failure row dropped the tract's own stderr (got '$_r_dead') — the one row that can name a LANE fault names nothing" ;; esac

    # THE LANE MUST RESOLVE ITS TRACT UNDER CRON'S PATH, NOT UNDER A PANE'S. cron runs with
    # /usr/bin:/bin and no PATH= line exists in the crontab, so a bare sibling call resolves to
    # nothing — and this tool's ONLY sibling call is the measure tract, so every 2-hourly fire that
    # reached the measure step died there while the ledger said the track was at fault. Driven, not
    # grepped: re-exec the REAL preamble under a scrubbed environment with a scratch MESH_DIR (so
    # --status has a ledger to pass its own gate and this drive writes nothing durable), and read
    # the resolution the tool itself publishes.
    _tp="$(mktemp -d)"
    printf '2026-01-01T00:00:00Z DREW probe stratum=field licence=x title=x\n' > "$_tp/random-track-grind.log"
    _tr="$(env -i HOME="$HOME" PATH=/usr/bin:/bin MESH_DIR="$_tp" bash "$0" --status 2>/dev/null | grep '^measure tract:' | head -1)"
    rm -rf "$_tp"
    echo "  $_tr"
    _trp="${_tr#measure tract: }"
    [ -n "$_tr" ] \
      || fail "--status does not publish which measure tract it resolved — the one fact that separates 'this track is unmeasurable' from 'the analyzer was never on PATH' is unreadable"
    [ -x "$_trp" ] \
      || fail "under cron's own PATH (/usr/bin:/bin) this lane cannot resolve its measure tract (got '$_trp') — every scheduled fire would reject its draw as the TRACK's fault while the analyzer was simply not reachable"
    # The ledger must not be able to be its own stdout. Driven below, not just grepped.
    grep -q '_stdout_is_''ledger' "$0" || fail "nothing refuses stdout==ledger: a cron redirect into the ledger writes every row TWICE and doubles every count, and it does so only for cron runs, i.e. only in the rows nobody watches"
    # Driven BOTH ways: colliding stdout must say COLLIDES, and a separate stdout must say CLEAR.
    # Without the CLEAR arm a probe hardwired to true passes the collision arm and blocks every run.
    # The probe goes in a FILE, not a variable — nesting the quotes it needs inside an inline string
    # is how the first cut of this arm ended up evaluated by the OUTER shell.
    _LT="$(mktemp)"; _LO="$(mktemp)"; _PB="$(mktemp)"
    cat > "$_PB" <<'PROBE'
_stdout_is_ledger(){
  local a b
  exec 9>&1 || return 1
  a="$(stat -Lc '%d:%i' /proc/self/fd/9 2>/dev/null)"
  exec 9>&-
  b="$(stat -Lc '%d:%i' "$LEDGER" 2>/dev/null)" || return 1
  [ -n "$a" ] && [ "$a" = "$b" ]
}
if _stdout_is_ledger; then echo COLLIDES; else echo CLEAR; fi
PROBE
    LEDGER="$_LT" bash "$_PB" >>"$_LT" 2>/dev/null; _out="$(tail -1 "$_LT")"
    LEDGER="$_LT" bash "$_PB" >>"$_LO" 2>/dev/null; _oth="$(tail -1 "$_LO")"
    rm -f "$_LT" "$_LO" "$_PB"
    [ "$_oth" = "CLEAR" ] \
      || fail "the stdout==ledger probe fires even when stdout is a DIFFERENT file (got '$_oth') — a probe hardwired true would block every legitimate run while passing the collision arm"
    [ "$_out" = "COLLIDES" ] \
      || fail "the stdout==ledger probe does not fire when stdout IS the ledger (got '$_out') — it must read a DUPLICATED fd (inside \$( ) fd 1 is the substitution pipe) and compare by INODE, since a redirect reaches the same file through \$HOME, a symlink or a relative path"
    # ── VARIANTS (operator 2026-08-30: several param sets per track) ────────────────────
    # ORDER IS THE WHOLE MECHANISM. The recipes are distinct only because the params line for
    # variant k is appended BEFORE variant k+1 derives — mesh-sound-reflex repels each derive from
    # the last SR_RECENT lines of that log. Deriving N times up front would return N copies of one
    # recipe, since the repulsor would see identical history each time. Assert by POSITION.
    _dv=$(grep -n 'mesh-sound-reflex --''derive' "$0" | head -1 | cut -d: -f1)
    _ap=$(grep -n 'MESH_RMC_PARAMS_''LOG' "$0" | tail -1 | cut -d: -f1)
    _lp=$(grep -n '^for _v in \$(seq 1 "\$VARIANTS")' "$0" | head -1 | cut -d: -f1)
    [ -n "$_lp" ] && [ -n "$_dv" ] && [ -n "$_ap" ] && [ "$_lp" -lt "$_dv" ] && [ "$_dv" -lt "$_ap" ] \
      || fail "the derive and the params-log append are not both INSIDE the variant loop in that order (loop ${_lp:-none}, derive ${_dv:-none}, append ${_ap:-none}) — the repulsor only separates variant k+1 from variant k if k was written to the params log first, so out of order every variant is the SAME recipe"
    # Each variant needs its own output dir and its own filename, or variant 2 silently overwrites
    # variant 1 on disk and the channel gets the same bytes twice under different captions.
    grep -q 'rm -rf "\$D/out"; mkdir -p "\$D/''out"' "$0" || fail "the grind output dir is not cleared per variant — ls picks the FIRST mp3 in it, so every later variant would ship variant 1 again"
    grep -q '\-v\$_v-\$''tag.mp3' "$0" || fail "the render filename does not carry the variant index — variant 2 overwrites variant 1 in \$OUTDIR and the channel gets one file under two captions"
    # A failed variant must not abort the track: volume was the request, and a repelled search
    # returning one hollow grind is normal. Every terminal path inside the loop continues.
    _ex=$(awk '/^for _v in \$\(seq 1 "\$VARIANTS"\)/,/^done$/' "$0" | grep -c 'exit 1' || true)
    [ "$_ex" -eq 0 ] \
      || fail "$_ex path(s) inside the variant loop still exit 1 — one hollow grind would discard every remaining variant of a track that is otherwise fine"
    grep -q 'SR_WORN_''LOG="\$WORN"' "$0" || fail "the derive is not given this track's worn store — 'recent' is only the last SR_RECENT (default 6) lines of a params log SHARED with other lanes, so past ~6 variants the search is no longer repelled from this track's own earlier recipes and may simply return one again"
    _wa=$(grep -n '>> "\$WORN"' "$0" | head -1 | cut -d: -f1)
    # Literal SPLIT, like every other assertion here: written contiguously this grep matches its
    # OWN line and the position check passes with the real call site deleted. Third time this trap
    # has bitten in one session, and it is silent in both polarities.
    _wd=$(grep -n 'SR_WORN_''LOG="\$WORN" timeout' "$0" | grep -v 'grep -n' | head -1 | cut -d: -f1)
    [ -n "$_wa" ] && [ -n "$_wd" ] && [ "$_wd" -lt "$_wa" ] \
      || fail "the worn store is written before it is read (derive ${_wd:-none}, append ${_wa:-none}) — a variant must be recorded AFTER it derives, or it repels the search from a recipe that does not exist yet"
    grep -q 'distinct recipes=\$_''distinct' "$0" || fail "TRACK-DONE does not publish how many DISTINCT recipes came back — at large N the repulsor degrades into repeats by design (plain epsilon, preference with fallback), so 'N variants requested' silently stops meaning 'N different recipes'"
    grep -q 'TRACK-''DONE' "$0" || fail "no per-track summary row: with N variants the ledger needs shipped/failed counts, or a track that shipped 1 of 4 reads exactly like one that shipped 4 of 4"
    grep -q 'for _s in \$strata_''names' "$0" || fail "--status counts only the strata already present in the ledger, so a never-drawn stratum renders identically to one that does not exist — the exact reading the operator asked to be able to refute"
    # FIDELITY — operator: полные треки, без обрезки, частоты сохранены.
    grep -q 'TRUNCATED-BY-''TRANSCODE' "$0" || fail "the transcode is not checked for truncation against the SOURCE duration — 'a non-zero mp3' is satisfied by a file that stops halfway"
    grep -q 'NOT representable by lib''mp3lame' "$0" || fail "the sample rate is not pinned/reported: libmp3lame silently picks a supported rate, so a 96 kHz source loses its top octave with no error anywhere"
    grep -q '_ar="-ar \$s''rate"' "$0" || fail "the source sample rate is never PINNED on the encoder — reporting a rate you did not pin describes a wish"
    grep -q 'SPEC''TRUM \$ident' "$0" || fail "the render's spectral position is never compared to the source — an unreported band-limit is how 'частоты сохранены' quietly stops being true"
    # DELIVERY — the public channel via the userbot lane, and attribution IN the caption.
    # The target must be a USERNAME. A numeric id is resolvable only from this session's dialog
    # cache and does not survive the channel being re-created under the same name — measured live:
    # one delivery succeeded on an id and the next died on it, by which time the id addressed
    # nothing and the operator's channel was a different entity wearing the same name.
    grep -qE 'TG_CHANNEL="\$\{RTG_TG_CHANNEL:-@' "$0" \
      || fail "the delivery target is not a @username — a numeric id resolves only out of the session dialog cache and silently addresses the CORPSE when a channel is re-created under the same name, and the ledger writes DELIVERED either way"
    grep -q 'mesh-tg-user send-''file "\$TG_CHANNEL"' "$0" || fail "delivery is not on the userbot channel lane — mesh-tg is the BOT organ (operator DM, 20MB ceiling), and this lane must post a full uncut track to a PUBLIC channel"
    grep -q 'mesh-tg --''file' "$0" && fail "the old bot-organ DM delivery is still present — a public-channel lane must not also post to the operator privately"
    grep -q 'UNATTRIB''UTABLE' "$0" || fail "a BY-family item with no creator is not REFUSED — measured live on the first ethno draw (HHFBC_tapes_D02B, CC BY 4.0, no creator and no contributor at all), the caption would have shipped 'Источник: ?' to a PUBLIC channel with the one condition BY carries missing"
    grep -q 'attrib_''kind' "$0" || fail "the attribution does not say WHICH RUNG it came from — a holding collection is not a person, and printing it where the author goes is a different falsehood from printing nothing"
    grep -q '\*publicdomain\*|\*''zero\*' "$0" || fail "the refusal is not scoped to licences that REQUIRE attribution — a publicdomain-mark or CC0 item carries no such condition and rejecting it shrinks the corpus for nothing"
    grep -q 'Лицензия: \$''lic' "$0" || fail "the caption does not carry the licence URL — on a public channel BY/BY-SA/BY-NC attribution is a licence CONDITION, not a courtesy"
    grep -q 'Источник (\${attrib_''kind}): \${attrib}' "$0" || fail "the caption does not carry the resolved attribution — a licence URL without a credited party does not satisfy BY"
    _pick="${0%/*}/mesh-random-track-pick"
    [ -r "$_pick" ] && grep -q 'pa''ge = (start' "$_pick" \
      || fail "the picker is missing or back on the offset param archive.org IGNORES — the sampler would return the sort-first item of a random year, not a uniform draw"
    echo "random-track-grind-test: ok (4 strata drawn separately + shared ND gate · round-robin cursor written before the draw · per-stratum counters over the DECLARED list · no-truncation + pinned sample rate + spectral report · public-channel userbot delivery with creator+licence · own src class · one measure tract · cumulative uniform draw · grind stdin protected · picker stderr kept)"
    exit 0 ;;
  --nd-audit)
    # DOES THE ND EXCLUSION ACTUALLY EXCLUDE? Not a --test arm: it needs the network, and --test is
    # deliberately offline. Run it after any change to a stratum query or the licence gate.
    #
    # THE REASON THIS EXISTS IS A LIVE SIBLING FAILURE, not a hypothetical. tg reported 2026-08-30
    # ({#e33f8573}) that another lane's manifest spells the key 'licenceurl' (British) while every
    # filter spells 'licenseurl' — so its ND exclusion had NEVER ONCE FIRED, and 20 of 42 manifest
    # positions were ND. A misspelled field name does not error: the clause matches nothing, the
    # query returns MORE rows, and every one of them looks like a normal result. The failure
    # direction is toward PUBLISHING a NoDerivatives work, and on a public channel that is a licence
    # violation rather than an untidiness.
    #
    # So this is a CONTROL-vs-TREATMENT drive, per stratum, and the control arm is the whole point:
    # a gate whose control contains no ND items has not been shown to work — it is VACUOUS, and a
    # broken gate and a working one are indistinguishable there. That verdict is printed by name and
    # never folded into the passing side.
    command -v python3 >/dev/null 2>&1 || { echo "nd-audit: n/a — no python3" >&2; exit 2; }
    _rc=0
    for _s in $strata_names; do
      _t="$(stratum_q "$_s")"; _c="${_t/ AND NOT licenseurl:\*-nd\*/}"
      [ "$_c" = "$_t" ] && { echo "$_s: CANNOT FORM CONTROL — the ND clause is not in this query at all, so nothing excludes -nd here"; _rc=1; continue; }
      _o="$(RTG_Q_CTRL="$_c" RTG_Q_TRT="$_t" python3 - <<'PY'
import json,os,subprocess,urllib.parse
def q(qs):
    url=("https://archive.org/advancedsearch.php?"+urllib.parse.urlencode(
        {"q":qs,"rows":200,"output":"json"})+"&fl%5B%5D=licenseurl")
    out=subprocess.run(["env","-u","HTTP_PROXY","-u","HTTPS_PROXY","-u","ALL_PROXY","-u","http_proxy",
        "-u","https_proxy","-u","all_proxy","curl","-sL","--max-time","60",url],
        capture_output=True,text=True).stdout
    try: d=json.loads(out)["response"]
    except Exception: return None
    docs=d["docs"]
    return (d["numFound"],len(docs),
            sum(1 for x in docs if "-nd" in str(x.get("licenseurl",""))),
            sum(1 for x in docs if not x.get("licenseurl")))
c=q(os.environ["RTG_Q_CTRL"]); t=q(os.environ["RTG_Q_TRT"])
if c is None or t is None: print("UNKNOWN unreachable"); raise SystemExit(0)
cN,cs,cnd,cmiss=c; tN,ts,tnd,tmiss=t
# A row with NO licence field at all is its own failure: the gate cannot judge what it cannot read,
# and it is exactly what a misspelled key produces. Counted apart, never folded into clean.
if tnd>0:  v="LEAKS"
elif cnd==0: v="VACUOUS"
else: v="PROVEN"
print("%s ctrl_n=%d ctrl_nd=%d/%d trt_n=%d trt_nd=%d/%d excluded=%d nolic_trt=%d"
      % (v,cN,cnd,cs,tN,tnd,ts,cN-tN,tmiss))
PY
)"
      set -- $_o
      case "${1:-UNKNOWN}" in
        PROVEN)  printf '  %-10s PROVEN   %s\n' "$_s" "${_o#PROVEN }" ;;
        VACUOUS) printf '  %-10s VACUOUS  %s\n     (control holds no -nd item, so a BROKEN gate would read identically here — not a pass)\n' "$_s" "${_o#VACUOUS }" ;;
        LEAKS)   printf '  %-10s *** LEAKS *** %s\n' "$_s" "${_o#LEAKS }"; _rc=1 ;;
        *)       printf '  %-10s UNKNOWN  (corpus unreachable — never read as a pass)\n' "$_s"; [ "$_rc" -eq 0 ] && _rc=2 ;;
      esac
    done
    echo "nd-audit: PROVEN = the control arm contained -nd items and the gate removed every one."
    exit "$_rc" ;;
  --status)
    [ -s "$LEDGER" ] || { echo "random-track-grind: no draws yet (ledger absent) — UNKNOWN, never 'none'"; exit 2; }
    # 'grep -c' PRINTS 0 AND STILL EXITS 1 on no match, so '|| echo 0' appends a SECOND zero and
    # the count arrives as a two-line value — measured live here 2026-08-30, where every zero
    # stratum rendered as "drew=0\n0 delivered=0\n0". '|| true' keeps the honest single 0 and still
    # swallows the exit status under set -o pipefail.
    _n(){ grep -cE "$1" "$LEDGER" 2>/dev/null || true; }
    echo "draws: $(_n ' DREW ') · rejects: $(_n ' REJECT ') · delivered: $(_n ' DELIVERED ')"
    # PER STRATUM, and EVERY declared stratum is printed even at zero. A stratum missing from the
    # ledger is the one thing this whole split exists to make visible: printing only what the
    # ledger happens to contain would render "never drawn" and "does not exist" identically, which
    # is exactly the reading the operator predicted and asked to be able to refute.
    echo "per stratum (declared: $strata_names) — a 0 here is HUNGRY, never absent:"
    for _s in $strata_names; do
      printf '  %-10s drew=%s delivered=%s rejected=%s\n' "$_s" \
        "$(_n " DREW .* stratum=$_s ")" "$(_n " DELIVERED .* stratum=$_s ")" \
        "$(_n " (REJECT|DRAW-FAILED) .*stratum=$_s")"
    done
    echo "next stratum: $(cat "$MESH/.random-track-stratum.cursor" 2>/dev/null || echo '(none yet)') was last"
    # PUBLISH THE RESOLVED TRACT. A lane whose only sibling call cannot resolve produces rejects
    # that look like the material's fault; this line makes the resolution a readable fact and lets
    # the gate below drive this real preamble under a cron PATH instead of grepping for the fix.
    echo "measure tract: $(command -v mesh-soundscape 2>/dev/null || echo 'UNRESOLVED — every measure would die as measure-failed')"
    tail -3 "$LEDGER"; exit 0 ;;
esac

command -v ffprobe >/dev/null 2>&1 || { nofetch "n/a — no ffprobe"; exit 2; }
[ -x "$HOME/grainneukeln/.venv/bin/python" ] || { nofetch "n/a — no grind engine"; exit 2; }
mkdir -p "$OUTDIR"
D="$(mktemp -d)"; trap 'rm -rf "$D"' EXIT

# KEEP THE PICKER'S STDERR. It is not noise: on exhaustion the picker prints its whole
# 'rejects' ledger there (which identifiers were drawn and why each was refused), and on every
# run it prints 'pool=N'. Sending it to /dev/null collapsed three unrelated causes onto one
# sentence — corpus unreachable (pool=0), every draw legitimately refused (pool large, 25
# rejects), and the picker itself crashing — so DRAW-FAILED named a remedy for none of them.
# Cursor first, draw second — a run that dies in the grind must not hand its successor the same
# stratum forever. Advancing before the irreversible part is the same discipline as claiming an
# item on disk before performing it.
printf '%s' "$STRATUM" > "$CURSOR" 2>/dev/null || true
pick="$(RTG_UNIVERSE="$UNIVERSE" RTG_MAXTRY="$MAXTRY" python3 "${0%/*}/mesh-random-track-pick" 2>"$D/pick.err")"
_why="$(tail -2 "$D/pick.err" 2>/dev/null | tr '\n' ' ' | cut -c1-300)"
[ -n "$pick" ] || { say "DRAW-FAILED stratum=$STRATUM ${_why:-the picker said nothing at all — not even its pool count}"; exit 1; }
ident=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["identifier"])' <<<"$pick" 2>/dev/null)
lic=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["licence"])' <<<"$pick" 2>/dev/null)
url=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["url"])' <<<"$pick" 2>/dev/null)
ttl=$(python3 -c 'import json,sys;print(json.load(sys.stdin).get("title") or "")' <<<"$pick" 2>/dev/null)
cre=$(python3 -c 'import json,sys;print(json.load(sys.stdin).get("creator") or "")' <<<"$pick" 2>/dev/null)
[ -n "$ident" ] && [ -n "$url" ] || { say "DRAW-FAILED stratum=$STRATUM malformed pick"; exit 1; }
case "$lic" in *-nd*|"") say "REJECT $ident stratum=$STRATUM licence-forbids-derivatives ($lic)"; exit 1;; esac
# ATTRIBUTION LADDER — a BY-family licence with no creator is UNPUBLISHABLE, not a '?' in the
# caption. Measured live 2026-08-30 on the very first ethno draw: HHFBC_tapes_D02B is CC BY 4.0
# and carries NO creator and NO contributor at all — only an uploader address and its holding
# collections. That is normal for an archival collection, and shipping it as "Источник: ?" would
# have put a BY item on a PUBLIC channel with the one thing BY actually requires missing.
# So walk a ladder, and LABEL each rung for what it is: a collection is not a person, and calling
# it the author would be a different falsehood from calling it nothing.
attrib="$cre"; attrib_kind="автор"
if [ -z "$attrib" ]; then
  _md="$(env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
        timeout 60 curl -sL "https://archive.org/metadata/$ident" 2>/dev/null)"
  attrib="$(printf '%s' "$_md" | python3 -c '
import json,sys
try: m=json.load(sys.stdin).get("metadata",{})
except Exception: sys.exit(0)
def one(v): return v[0] if isinstance(v,list) and v else (v if isinstance(v,str) else "")
for k in ("creator","contributor","publisher"):
    if one(m.get(k)): print("%s\t%s"%(k,one(m[k]))); break
else:
    c=m.get("collection") or []
    c=[x for x in (c if isinstance(c,list) else [c]) if x not in ("audio_music","americana","community","opensource_audio")]
    if c: print("коллекция\t%s"%(" / ".join(c[:2])))
' 2>/dev/null | head -1)"
  attrib_kind="${attrib%%$'\t'*}"; attrib="${attrib#*$'\t'}"
  case "$attrib_kind" in creator|contributor|publisher) attrib_kind="автор" ;; esac
fi
# THE REFUSAL. Only for licences that actually require attribution — a publicdomain-mark or CC0
# item genuinely has no such condition, and rejecting it would shrink the corpus for no reason.
case "$lic" in
  *publicdomain*|*zero*) [ -n "$attrib" ] || { attrib="архив (лицензия атрибуции не требует)"; attrib_kind="источник"; } ;;
  *) [ -n "$attrib" ] || { say "REJECT $ident stratum=$STRATUM UNATTRIBUTABLE licence=$lic — BY-family licence with no creator, contributor, publisher or collection to credit; posting it to a public channel would breach the one condition the licence carries"; exit 1; } ;;
esac
say "DREW $ident stratum=$STRATUM licence=$lic title=$ttl $attrib_kind=$attrib"

src="$D/src.mp3"
env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
  timeout 300 curl -sL -o "$src" "$url" || { say "FETCH-FAILED $ident stratum=$STRATUM"; exit 1; }
[ -s "$src" ] || { say "FETCH-EMPTY $ident stratum=$STRATUM"; exit 1; }
# NORMALISE TO MP3. The picker accepts .mp3/.ogg/.flac/.wav but the grind engine reads only
# "wav or mp3 or webm or m4a" (cutter/sample_cut_tool.py) — an .ogg or .flac reaches it and dies
# with a bare "Conversion failed!". Transcoding here rather than narrowing the corpus keeps the
# draw uniform over the whole universe instead of quietly excluding every ogg-only netlabel.
# FIDELITY IS ASSERTED, NOT ASSUMED — operator 2026-08-30T00:37:51Z: "полные треки, без
# обрезки, частоты сохранены". "A non-empty mp3" is exactly the plausible-constant this lane must
# not accept: a truncated transcode and a resampled one both produce one.
#  · SAMPLE RATE. libmp3lame supports only {8,11.025,12,16,22.05,24,32,44.1,48} kHz. Left to
#    itself ffmpeg picks a supported rate, so a 96 kHz source is silently halved and its top
#    octave is gone with no error anywhere. We PIN the source rate when lame can carry it, and
#    when it cannot we say so in the ledger rather than let the loss pass unnamed.
#  · DURATION. Measured against the SOURCE, not against a floor: a transcode that stops early
#    still yields a long-enough file whenever the source was long.
srate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of csv=p=0 "$src" 2>/dev/null | head -1)
sdur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src" 2>/dev/null | head -1)
_ar=""; _arnote="rate=$srate preserved"
case "$srate" in
  8000|11025|12000|16000|22050|24000|32000|44100|48000) _ar="-ar $srate" ;;
  ""|0) _arnote="rate=UNKNOWN (ffprobe gave none) — not pinned" ;;
  *)    _arnote="rate=$srate NOT representable by libmp3lame — resampled, top octave lost" ;;
esac
if ! ffmpeg -v error -y -i "$src" -codec:a libmp3lame -q:a 0 $_ar "$D/norm.mp3" 2>"$D/ff.err"; then
  say "REJECT $ident stratum=$STRATUM undecodable :: $(tail -1 "$D/ff.err" 2>/dev/null | cut -c1-160)"; exit 1
fi
[ -s "$D/norm.mp3" ] || { say "REJECT $ident stratum=$STRATUM transcode-empty"; exit 1; }
ndur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$D/norm.mp3" 2>/dev/null | head -1)
nrate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of csv=p=0 "$D/norm.mp3" 2>/dev/null | head -1)
# NO TRUNCATION. 2% of the source duration, floor 1s, is slack for encoder-delay/frame padding —
# it can absorb a lost frame, never a lost section.
if ! awk -v a="${sdur:-0}" -v b="${ndur:-0}" 'BEGIN{tol=(a*0.02<1?1:a*0.02); exit !(a>0 && b>0 && (a-b)<tol)}'; then
  say "REJECT $ident stratum=$STRATUM TRUNCATED-BY-TRANSCODE source=${sdur:-na}s norm=${ndur:-na}s ($_arnote)"; exit 1
fi
say "FIDELITY $ident stratum=$STRATUM src ${sdur:-na}s @${srate:-na}Hz -> norm ${ndur:-na}s @${nrate:-na}Hz :: $_arnote"
src="$D/norm.mp3"
dur=$(printf '%s' "${ndur:-0}" | cut -d. -f1)
[ -n "$dur" ] && [ "$dur" -gt 20 ] 2>/dev/null || { say "REJECT $ident stratum=$STRATUM unusable-audio dur=${dur:-na}"; exit 1; }

# The measure step and its two DISTINCT reject verbs live in measure_or_reject() above, hoisted
# so the --test drives that code instead of a second copy of it. Sets $m.
measure_or_reject "$src"
g(){ grep -oE "(^| )$1=[0-9.]+" <<<"$m" | head -1 | grep -oE '[0-9.]+'; }
# derive from the WHOLE-FILE axes: the coverage ladder (SS_MEASURE_SCALES is absolute seconds)
# offers a long track only 1.000 / ~0.08 / ~0.02, so a window-derived recipe describes ~2% of it.
fb=$(g fbeats); tot=$(g total)
bms=$(awk -v b="${fb:-0}" -v d="${tot:-0}" 'BEGIN{printf "%d", (b>0 && d>0 ? d*1000/b : 500)}')
# STAMP THE RENDER INTO THE PARAMS LOG UNDER ITS OWN ORGAN. Until now this tool derived with the
# ext organ but recorded nothing, so the claim "external tracks get their own src class" was true
# of the derive call and of nothing else — a vacuous --test gate hid that for three revisions.
# Two things depend on the stamp, both measured today: parse_recent() files any line WITHOUT a
# src=<organ>/<hash> token under "ambient" and drops it from the ext lane, so the repulsor would
# never see yesterday's external render; and the starve census counts ORGANS, so an unstamped
# external render cannot register as the genuinely different physical source it is.
# FEED THE ARCHIVIST, not just the params log. The operator's constraint was about mesh-RECORDS:
# an external track is a new SOURCE CLASS there and must not land in another organ's column. The
# params-log stamp below only reaches the repulsor; every per-organ ARM (the CLAIMS block, the
# ergodic strata, the prune's per-organ floor) reads the records LEDGER, and until this deposit
# existed those censuses could not see 'ext' at all — measured: organs[drop ear note3 scape voice]
# with no ext, an hour after I had reported the source class as done. mesh-records declares
# 'ext|$MESH/ext-inbox/*.mp3' and archives + measures it itself, so this stays a single-writer
# handoff rather than a second tool writing that ledger.
mkdir -p "$MESH/ext-inbox"
cp -p "$src" "$MESH/ext-inbox/$(date -u +%Y%m%d-%H%M%S)-$(printf '%s' "$ident" | tr -cd 'A-Za-z0-9_-' | cut -c1-40).mp3" 2>/dev/null \
  || say "WARN $ident could not deposit source for the archivist — ext arm will not see this draw"
# PROVENANCE LEDGER — "a clip that cannot name its source is not publishable" (the operator's own
# words in grainneukeln 75fd397, arrived at independently the same night). The hole this closes was
# LIVE: the room lane picked the archived ext record on its own cadence, ground it, and
# grind-deliver shipped it 2026-08-29T22:00:35Z with a caption built from the REFLEX's params line,
# which carries src=ext/<hash> and NO licence. A CC BY-NC derivative went to TG with no attribution,
# and BY-NC requires attribution. My own tool's line carried the licence; the lane's did not, and
# the lane is what publishes. So bind the ARCHIVIST'S hash (not mine — it names the file every
# downstream consumer sees) to identifier + licence + creator, in a ledger anything can resolve.
# The sweep is run synchronously here because the hash does not exist until the archivist assigns it.
timeout 300 mesh-records >/dev/null 2>&1 || true
# MATCH THE ARCHIVED RECORD BY CONTENT, NEVER BY RECENCY. This used to take 'ls -t ... | head -1',
# i.e. "the newest ext record", on the assumption that the sweep above had just archived THIS
# deposit. When it had not — the sweep skips, or is still running, or the deposit failed — the
# newest record is the PREVIOUS track's, and the row bound the previous track's hash to this
# track's identifier, licence and creator. Measured live 2026-08-30, 2 of 5 rows were wrong that
# way: 9db34dce (really Liam Walsh) also wore Frank Schulte, and fc4b9ec8 (really the Flanders
# cassette) also wore a VintageSense Indian record whose deposit had not been archived at all.
# This ledger's ONE job is letting a consumer attribute a render, so a wrong row here is a licence
# breach waiting for a reader — and it fails silently, because a stale newest looks exactly like a
# fresh one. Same shape as CLAUDE.md's fresh-record-of-not-reaching-a-device.
#
# So: hash the deposited source and find the archived record with the SAME content. NO MATCH WRITES
# NO ROW — an absent provenance row is honest and a consumer can see it is missing; a wrong one is
# indistinguishable from a right one.
_dep_md5=$(md5sum "$src" 2>/dev/null | cut -d' ' -f1)
_arch=""
if [ -n "$_dep_md5" ]; then
  for _cand in $(ls -t "$MESH"/records/*-ext-*.mp3 2>/dev/null | head -40); do
    [ "$(md5sum "$_cand" 2>/dev/null | cut -d' ' -f1)" = "$_dep_md5" ] && { _arch="$_cand"; break; }
  done
fi
if [ -n "$_arch" ]; then
  _ahash=$(basename "$_arch" | sed -n 's/.*-ext-\([0-9a-f]\{1,\}\)\..*/\1/p')
  # The separator is a TAB, and the guard used to grep for a SPACE — so it never matched and never
  # deduped anything. Match on the field boundary, not on one whitespace character.
  _prior=$(awk -F'\t' -v h="$_ahash" '$1==h {print $2; exit}' "$MESH/ext-provenance.log" 2>/dev/null)
  if [ -z "$_prior" ]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$_ahash" "$ident" "$lic" "${cre:-?}" "${ttl:-?}" >> "$MESH/ext-provenance.log"
    say "PROVENANCE $_ahash <- $ident licence=$lic"
  elif [ "$_prior" = "$ident" ]; then
    say "PROVENANCE $_ahash already bound to $ident — no second row"
  else
    # One hash, two works. Loud, and it writes nothing: whichever row is wrong, a consumer
    # resolving this hash would attribute a BY/BY-SA work to the wrong author.
    say "PROVENANCE-COLLISION $_ahash is already bound to '$_prior' but this draw is '$ident' — refusing to write a second binding; one of them would misattribute"
  fi
else
  say "WARN $ident no archived ext record matches this deposit by content — provenance UNRECORDED (better than a wrong row); a lane render of it cannot attribute"
fi

# ── SEVERAL PARAM SETS PER TRACK (operator 2026-08-30: "grind a lot of them, several param
# sets for each track") ──────────────────────────────────────────────────────────────────────
# The variants are DISTINCT FOR FREE, and not because anything here randomises: mesh-sound-reflex
# repels each derive from the last SR_RECENT recipes in the params log, so appending variant k's
# line BEFORE deriving variant k+1 makes the repulsor do the work it already exists to do. Order is
# therefore load-bearing — derive, grind, ship, APPEND, then derive again. Deriving N times up front
# would return N copies of the same recipe, since the repulsor would see the same history each time.
#
# A variant that fails does NOT abort the track: the operator asked for volume, and one hollow grind
# out of four is a normal outcome of a repelled search, not a reason to discard the other three. Each
# variant ships the moment it renders ("по мере поступления"), so there is still no batching step.
VARIANTS="${RTG_VARIANTS:-1}"
# THE REPULSION WINDOW IS NOT THE VARIANT SET, and past ~6 variants that difference decides whether
# they are distinct at all. 'recent' is the last SR_RECENT (default 6) lines of the params log, and
# OTHER lanes append to that log too — so with many variants, variant 8 is no longer repelled from
# variant 1, and the search is free to return it again. Raising SR_RECENT is the wrong lever: it
# would also drag in unrelated lanes' recipes and change what every other caller is repelled from.
#
# SR_WORN_LOG is the right one, and mesh-sound-reflex already built it for exactly this question:
# it is read WHOLE, with no recency window, and its docstring is "has this source ever been here",
# which has no recency in it. So each variant appends its own recipe to a per-TRACK worn store and
# every later derive is repelled from ALL of this track's earlier variants, however many there are.
# It repels at the plain epsilon, i.e. as a preference with a fallback, so a large N degrades into
# repeats rather than into refusals — and TRACK-DONE publishes how many DISTINCT recipes actually
# came back, because "8 variants requested" and "8 different recipes" are different claims.
WORN="$D/worn.log"; : > "$WORN"
VARIANTS="${RTG_VARIANTS:-1}"
_shipped=0; _failed=0

for _v in $(seq 1 "$VARIANTS"); do
  rec=$(SR_WORN_LOG="$WORN" timeout 180 mesh-sound-reflex --derive "$(g fdyn)" "$(g fact)" "$(g frich)" "$(g fmove)" "$(g fcent)" "$bms" ext 1.000 2>/dev/null | head -1)
  case "$rec" in RECIPE*) ;; *) say "REJECT $ident stratum=$STRATUM variant=$_v/$VARIANTS no-recipe ($rec)"; _failed=$((_failed+1)); continue;; esac
  recipe="${rec#RECIPE }"; recipe="${recipe%% ~ *}"
  read -ra A <<< "$recipe"   # keeps 'c a,b;c,d' ONE token: the ';' never reaches the shell

  rm -rf "$D/out"; mkdir -p "$D/out"   # the engine SAVES into this dir and does not create it; mktemp -d made $D, not $D/out.
  # Found by driving the tool for real: --test was green and the recipe/track ground fine by hand,
  # while the wired path logged GRIND-EMPTY on every run. A passing test and a working path are
  # unrelated facts.
  # stderr to a FILE, never /dev/null: the first cut discarded it and every failure rendered as a
  # bare GRIND-EMPTY with no cause, which is a silent failure wearing an honest-looking label.
  ( cd "$HOME/grainneukeln" && timeout 900 .venv/bin/python main.py --low-memory "$src" "$D/out/" "${A[@]}" ) >"$D/grind.out" 2>"$D/grind.err" < /dev/null
  out=$(ls "$D/out"/*.mp3 2>/dev/null | head -1)
  [ -n "$out" ] || { say "GRIND-EMPTY $ident stratum=$STRATUM variant=$_v/$VARIANTS recipe=$recipe :: $(tail -2 "$D/grind.err" 2>/dev/null | tr '\n' ' ' | cut -c1-300)"; _failed=$((_failed+1)); continue; }

  verd=$(timeout 400 mesh-song-verify "$src" "$out" 2>&1 | head -1)   # tag from TEXT: rc after a pipe is head's
  case "$verd" in *"SONG ok"*) tag=OK;; *"SONG reject"*) tag=DEGENERATE;; *) tag=UNVERIFIED;; esac

  stamp=$(date -u +%Y%m%d)
  base="$stamp-ext-$(echo "$ident" | tr -cd 'A-Za-z0-9_-' | cut -c1-40)-v$_v-$tag.mp3"
  cp "$out" "$OUTDIR/$base"; cp "$src" "$OUTDIR/$stamp-ext-$(echo "$ident" | tr -cd 'A-Za-z0-9_-' | cut -c1-40)-SOURCE.mp3"
  # SPECTRAL TOP OF THE RENDER vs THE SOURCE. The duration gate above covers the transcode; this
  # covers the GRIND, which is the step that can band-limit. Reported, never gated: a granular mill
  # is entitled to change the spectrum, so a verdict here would be an opinion — but an unreported
  # loss is how "частоты сохранены" quietly stops being true. '-lavfi astats' gives no rolloff, so
  # read the top bin that carries energy off the same one measure tract the lane already uses.
  _ctop(){ timeout 200 mesh-soundscape --measure "$1" 2>/dev/null | grep '^MEASURE' | head -1 \
           | grep -oE '(^| )fcent=[0-9.]+' | grep -oE '[0-9.]+' | head -1; }
  _stop="$(_ctop "$src")"; _rtop="$(_ctop "$out")"
  say "SPECTRUM $ident stratum=$STRATUM source-centroid=${_stop:-na}Hz render-centroid=${_rtop:-na}Hz srate=${nrate:-na}Hz"

  # ATTRIBUTION IS A LICENCE CONDITION ON A PUBLIC CHANNEL, NOT A COURTESY. Every BY/BY-SA/BY-NC
  # item requires it, and the channel is public, so the caption carries creator + the licence URL
  # itself (not the word "CC") + the source page. A caption that cannot name its source is not
  # publishable whatever the licence permits.
  cap="МИРОВАЯ МУЗЫКА — помол · страта: $STRATUM · вариант $_v/$VARIANTS · $tag
  Источник (${attrib_kind}): ${attrib} — ${ttl:-?}
  https://archive.org/details/$ident
  Лицензия: $lic
    (производные разрешены; помол наследует ту же лицензию, автор указан выше)
  Оригинал: ${sdur:-?}s @ ${srate:-?}Hz — молол ЦЕЛИКОМ, без обрезки ($_arnote)
  Рецепт (из характера всего трека): $recipe
  Проверка: $verd"
  ehash=$(printf '%s' "$ident" | md5sum | cut -c1-8)
  printf '%s %s ~ src=ext/%s beat %s f 1 band ext fit na novelty na mode ext cov 1.000 licence %s\n' \
    "$(date -u +%FT%TZ)" "$recipe" "$ehash" "$bms" "$lic" >> "${MESH_RMC_PARAMS_LOG:-$MESH/room-music-params.log}"
  # The SAME line into this track's worn store, so variant k+1 is repelled from variant k no matter
  # how far back the shared params window has since rolled.
  printf '%s %s ~ src=ext/%s beat %s f 1 band ext fit na novelty na mode ext cov 1.000 licence %s\n' \
    "$(date -u +%FT%TZ)" "$recipe" "$ehash" "$bms" "$lic" >> "$WORN"
  # THE PUBLIC CHANNEL, VIA THE USERBOT LANE. The bot organ this lane used to call lands in the
  # operator DM with a 20MB ceiling; this is a public channel and a full uncut track needs the 2GB
  # userbot path. Its name is deliberately NOT spelled here: the arm below greps this file for the
  # old call, so quoting it in prose would make the guard accuse its own explanation (CLAUDE.md,
  # never quote the asserted literal beside a source-text gate — here in its inverse polarity, a
  # false RED rather than a false green, which is how it was found). Shipped the moment this one render exists — the operator asked for "по мере
  # поступления", so there is deliberately no batching step anywhere in this tool.
  if timeout 600 mesh-tg-user send-file "$TG_CHANNEL" "$OUTDIR/$base" "$cap" --confirm >"$D/tg.out" 2>&1 < /dev/null; then
    say "DELIVERED $ident stratum=$STRATUM variant=$_v/$VARIANTS $tag $base licence=$lic -> tg/$TG_CHANNEL"; _shipped=$((_shipped+1))
  else
    say "DELIVER-FAILED $ident stratum=$STRATUM variant=$_v/$VARIANTS $tag $base (render kept at $OUTDIR/$base) :: $(tail -2 "$D/tg.out" 2>/dev/null | tr '\n' ' ' | cut -c1-200)"; _failed=$((_failed+1)); continue
  fi

done
_distinct=$(awk -F' ~ ' '{print $1}' "$WORN" 2>/dev/null | sed 's/^[^ ]* //' | sort -u | wc -l)
say "TRACK-DONE $ident stratum=$STRATUM shipped=$_shipped failed=$_failed of $VARIANTS variant(s) · distinct recipes=$_distinct (requested N and N DIFFERENT recipes are different claims)"
[ "$_shipped" -gt 0 ] || exit 1