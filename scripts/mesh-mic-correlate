#!/usr/bin/env bash
# mesh-mic-correlate — the mesh's first MULTI-MICROPHONE correlation sense.
#
# Operator 2026-06-18: "у нас есть несколько микрофонов — делать интересные корреляции, что в
# квартире происходит". Mics: IdeaPad ALC236 (Intel HDA), phone Redmi (ADB), iMac-Rozalia (macOS
# AVFoundation). Default nodes include all three. Add via --nodes or MESH_MIC_NODES.
# This FIRST VERSION: capture a short, near-simultaneous sample from each mic, measure each one's
# ENERGY (loudness, dBFS via ffmpeg volumedetect), and COMPARE across mics → infer WHERE the
# activity is (which mic hears it loudest = nearest that zone) and whether the place is quiet.
#
# HONEST first-version scope (what I told the operator): this is ENERGY/loudness comparison, NOT
# time-of-arrival source localization (that needs synchronized clocks + calibration — a later
# version). "Which mic is loudest / who's closer" is robust and cheap; precise triangulation is not.
# A mic that fails to capture is marked UNREACHABLE — never silently dropped into a fake "quiet"
# (a hollow all-clear is the failure mode we refuse; see memory fusion-tools-distinguish-empty).
#
# Reuses mesh-hear for the actual consent-gated capture (mic_always=yes required) — no new mic path.
#
# ON-DEMAND by design (NOT auto-wired to cron): a microphone is sensitive; continuous correlation
# needs its own explicit operator opt-in. Run it when you want a read. (A future --edge reflex could
# feed mesh-home-state, but only behind a deliberate consent gate.)
#
# SELF-CAUSED ATTENUATION (LITERATURE 2026-07-07): the enactive account of *sensory attenuation for
# self-caused stimuli* — Garner & Egbert, "Embodiment Enables Non-Predictive Ways of Coping with
# Self-Caused Sensory Stimuli" (arXiv:2205.06446), and its free-energy formulation, Idei et al.
# "Emergence of sensory attenuation based upon the free-energy principle" (Sci. Rep. 2022, arXiv:
# 2111.02666) — holds that an embodied agent must down-weight sensory input its OWN action best
# explains, else a self-generated signal collapses into just another correlated observation. The
# area is live 2023-2026 (Frontiers enactive-robotics editorial 2023; tactile TaSA robotics 2026,
# arXiv:2602.05468; N1/P2 corollary-discharge dissociation, PLOS ONE Dec-2025). The mesh already
# embodies this in ONE sense — mesh-overhear gates its mic on ~/.mesh/mesh-speaking (set by mesh-say
# / voice-tx / room-music --play) so it never self-transcribes the mesh's own voice — but the marker
# has only that one consumer, so it is a one-off fix, not the reusable mechanism the literature
# describes. THIS multi-mic sense had NO self-caused gate: when the mesh plays audio on a node, that
# node's mic goes loudest and mic-correlate localizes a FALSE external event (TV-MUSIC / ACTIVITY /
# even PERSON-TALKING — the mesh's own TTS classifies as speech) to wherever the mesh is emitting.
# Fix: make mic-correlate the SECOND consumer of the efference marker — when a self-action overlaps
# the capture window, tag the read SELF-CAUSED and refuse to localize activity to the self-heard mic
# (self-caused ≠ a room event, exactly as UNREACHABLE ≠ fake-quiet already is here).
#
# Usage:
#   mesh-mic-correlate [--nodes "IdeaPad phone"] [-d SECONDS] [--json] [--test]
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

NODES="${MESH_MIC_NODES:-IdeaPad phone mac}"
DUR="${MESH_MIC_DUR:-3}"
QUIET_DB="${MESH_MIC_QUIET_DB:--55}"     # mean_volume below this = quiet (per-mic gain varies; -55dB catches iMac's quieter mic while still detecting real hush)
JSON=0
TMP="${TMPDIR:-/tmp}"

while [ $# -gt 0 ]; do
  case "$1" in
    --nodes) NODES="$2"; shift 2;;
    -d) DUR="$2"; shift 2;;
    --json) JSON=1; shift;;
    --test) shift; MODE_TEST=1;;
    -h|--help) echo "usage: mesh-mic-correlate [--nodes \"IdeaPad phone\"] [-d SECONDS] [--json]"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

# energy(file) → "mean max" in dB (e.g. "-23.5 -12.3"), empty on failure/no-audio.
energy(){
  command -v ffmpeg >/dev/null 2>&1 || return 1
  ffmpeg -hide_banner -nostdin -i "$1" -af volumedetect -f null /dev/null 2>&1 \
    | awk -F': ' '/mean_volume/{m=$2} /max_volume/{x=$2}
                  END{ if(m!=""){gsub(/ dB/,"",m); gsub(/ dB/,"",x); print m" "x} }'
}

# _self_caused_now → 0 (true) iff the mesh is emitting audio right now (efference marker present).
# Same contract mesh-overhear watches; MESH_MIC_MUTE_FLAG overridable so --test can stub it.
_MUTE="${MESH_MIC_MUTE_FLAG:-$HOME/.mesh/mesh-speaking}"
_self_caused_now(){ [ -e "$_MUTE" ]; }

# --- smoke test: deps + logic, NO real capture (mic untouched) ---------------
if [ "${MODE_TEST:-0}" = 1 ]; then
  fail=0
  for d in ffmpeg awk; do command -v $d >/dev/null 2>&1 \
    && echo "  ok: $d present" || { echo "  FAIL: $d missing"; fail=1; }; done
  command -v mesh-hear >/dev/null 2>&1 && echo "  ok: mesh-hear present (capture path)" \
    || { echo "  FAIL: mesh-hear missing — no capture path"; fail=1; }
  command -v mesh-speech-classify >/dev/null 2>&1 && echo "  ok: mesh-speech-classify present (speech gate)" \
    || { echo "  FAIL: mesh-speech-classify missing — no speech classification"; fail=1; }
  # self-caused (efference) gate: the REAL helper must read the marker's presence, and a self-action
  # must OUTRANK a SPEECH read (the mesh's own TTS classifies as speech — the exact mislocalization).
  _sc_tmp="$TMP/.mic-corr-selftest-$$"; rm -f "$_sc_tmp"
  _MUTE="$_sc_tmp"
  _self_caused_now && { echo "  FAIL: _self_caused_now true with no marker"; fail=1; } \
    || echo "  ok: no marker → not self-caused"
  : > "$_sc_tmp"
  _self_caused_now && echo "  ok: marker present → self-caused" \
    || { echo "  FAIL: _self_caused_now false with marker present"; fail=1; }
  # precedence: SELF_ACTIVE=1 wins even when SPEECH_CLASS=SPEECH
  SELF_ACTIVE=1; SPEECH_CLASS=SPEECH
  if [ "$SELF_ACTIVE" = 1 ]; then _v=SELF-CAUSED; elif [ "$SPEECH_CLASS" = SPEECH ]; then _v=PERSON-TALKING; fi
  [ "$_v" = SELF-CAUSED ] && echo "  ok: self-caused outranks SPEECH (no false PERSON-TALKING)" \
    || { echo "  FAIL: self-caused did not outrank SPEECH"; fail=1; }
  rm -f "$_sc_tmp"; unset SELF_ACTIVE SPEECH_CLASS _v
  # logic check: synth two levels, assert the louder is picked as the activity zone
  a="-22.0"; b="-41.0"
  louder=$(awk -v a="$a" -v b="$b" 'BEGIN{print (a>b)?"A":"B"}')
  [ "$louder" = A ] && echo "  ok: louder-mic selection logic (−22dB > −41dB → A)" \
    || { echo "  FAIL: comparison logic wrong"; fail=1; }
  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

command -v mesh-hear >/dev/null 2>&1 || { echo "mesh-mic-correlate: mesh-hear not found" >&2; exit 1; }
command -v ffmpeg   >/dev/null 2>&1 || { echo "mesh-mic-correlate: ffmpeg not found" >&2; exit 1; }

# --- capture each mic near-simultaneously (local first to avoid ALSA contention, then remotes) ---
declare -A WAV
ts="$(date -u +%H%M%S)"
# Efference sample: the mesh may act during the capture window; sample the marker before AND after
# (the flag is touched at speak-start, cleared on speak-EXIT — either edge means the window overlapped
# a self-action). SELF_ACTIVE gates the verdict below; MESH_MIC_NO_SELFGATE=1 disables (debug only).
SELF_ACTIVE=0
if [ "${MESH_MIC_NO_SELFGATE:-0}" != 1 ] && _self_caused_now; then SELF_ACTIVE=1; fi
capture_mic(){
  local n="$1" f="$2" d="$3"; local tries=0
  while [ $tries -lt 2 ]; do
    rm -f "$f"
    mesh-hear "$n" -d "$d" -o "$f" >/dev/null 2>&1
    [ -s "$f" ] && return 0
    tries=$((tries + 1))
    sleep 1
  done
  return 1
}
# Local first (avoids ALSA contention with background captures), then remotes in parallel
for n in $NODES; do
  f="$TMP/.mic-corr-${n}-${ts}.wav"
  WAV[$n]="$f"
done
# IdeaPad capture runs first (foreground) if in node list; remotes in background after
has_ideapad=0; for n in $NODES; do [ "$n" = "IdeaPad" ] && has_ideapad=1; done
if [ "$has_ideapad" = 1 ]; then capture_mic "IdeaPad" "${WAV[IdeaPad]}" "$DUR" || true; fi
for n in $NODES; do
  [ "$n" = "IdeaPad" ] && continue
  capture_mic "$n" "${WAV[$n]}" "$DUR" &
done
wait
# second efference edge: catch a self-action that STARTED mid-capture (e.g. a mesh-say fired after
# the pre-sample). Either edge set → the window is contaminated by the mesh's own output.
if [ "${MESH_MIC_NO_SELFGATE:-0}" != 1 ] && _self_caused_now; then SELF_ACTIVE=1; fi

# --- measure energy per mic, classify reachable vs unreachable ---------------
declare -A MEAN MAX
reach=(); unreach=()
for n in $NODES; do
  f="${WAV[$n]}"
  if [ -s "$f" ] && e="$(energy "$f")" && [ -n "$e" ]; then
    MEAN[$n]="${e%% *}"; MAX[$n]="${e##* }"
    reach+=("$n")
  else
    unreach+=("$n")
  fi
done

# --- speech classification on IdeaPad's capture (enriches verdict) ------
SPEECH=""; SPEECH_CLASS=""; SPEECH_DETAIL=""
if [ -n "${WAV[IdeaPad]:-}" ] && [ -s "${WAV[IdeaPad]}" ]; then
  SPEECH="$(mesh-speech-classify --source "${WAV[IdeaPad]}" --json 2>/dev/null || true)"
  if [ -n "$SPEECH" ]; then
    SPEECH_CLASS="$(printf '%s' "$SPEECH" | sed -n 's/.*"class":"\([^"]*\)".*/\1/p')"
    SPEECH_DETAIL="$(printf '%s' "$SPEECH" | sed -n 's/.*"full_db":\([0-9.-]*\).*/speech classification: \1dB/p')"
  fi
fi

# --- cleanup WAVs (after speech classification which needs IdeaPad's) ----
for n in $NODES; do rm -f "${WAV[$n]}"; done

# --- correlate: loudest mic = where activity is; speech-aware verdict ------
verdict="UNKNOWN"; zone=""; loud_db=""; quiet=0; detail=""
if [ "${#reach[@]}" -eq 0 ]; then
  verdict="NO-MICS"; detail="no microphone reachable — cannot assess"
else
  # find loudest + quietest by mean
  loud="${reach[0]}"; soft="${reach[0]}"
  for n in "${reach[@]}"; do
    awk -v x="${MEAN[$n]}" -v y="${MEAN[$loud]}" 'BEGIN{exit !(x>y)}' && loud="$n"
    awk -v x="${MEAN[$n]}" -v y="${MEAN[$soft]}" 'BEGIN{exit !(x<y)}' && soft="$n"
  done
  loud_db="${MEAN[$loud]}"; zone="$loud"
  # Self-caused attenuation FIRST — outranks even SPEECH, because the mesh's own TTS/media classifies
  # as speech/broadband and would otherwise be mislocalized to the emitting node as a room event.
  if [ "$SELF_ACTIVE" = 1 ]; then
    verdict="SELF-CAUSED"; zone=""
    detail="mesh emitting audio during capture (loudest ${loud} ${loud_db}dB is self-heard, not a room event) — attenuated"
  # Speech-aware verdict hierarchy: SPEECH > single-mic > QUIET > known-noise > ACTIVITY
  elif [ "$SPEECH_CLASS" = "SPEECH" ]; then
    verdict="PERSON-TALKING"
    spread=$(awk -v a="${MEAN[$loud]}" -v b="${MEAN[$soft]}" 'BEGIN{printf "%.1f", a-b}')
    detail="speech detected near ${loud} (${loud_db}dB), spread ${spread}dB"
  elif [ "${#reach[@]}" -eq 1 ] && [ -z "$SPEECH_CLASS" ]; then
    verdict="SINGLE-MIC"
    detail="only ${loud} reachable (${loud_db}dB) — level read, no correlation (need ≥2 mics)"
  elif [ "${#reach[@]}" -eq 1 ]; then
    # Single mic but we have speech classification — use it
    case "$SPEECH_CLASS" in
      SILENCE) verdict="QUIET"; quiet=1; detail="single mic quiet (${loud_db}dB)";;
      LOWFREQ) verdict="FAN-RUNNING"; detail="low-frequency energy on single mic (${loud_db}dB) — likely fan/AC";;
      HISS)    verdict="HISS"; detail="high-frequency energy on single mic — likely fan hiss";;
      BROADBAND) verdict="ACTIVITY"; detail="broadband activity on single mic (${loud_db}dB)";;
      *)       verdict="SINGLE-MIC"; detail="only ${loud} reachable (${loud_db}dB), class=${SPEECH_CLASS}";;
    esac
  elif awk -v m="$loud_db" -v q="$QUIET_DB" 'BEGIN{exit !(m<q)}'; then
    verdict="QUIET"; quiet=1
    detail="all mics below ${QUIET_DB}dB — place is quiet (loudest ${loud} ${loud_db}dB)"
  elif [ "$SPEECH_CLASS" = "LOWFREQ" ]; then
    spread=$(awk -v a="${MEAN[$loud]}" -v b="${MEAN[$soft]}" 'BEGIN{printf "%.1f", a-b}')
    verdict="FAN-RUNNING"
    detail="consistent low-frequency energy (fan/AC), spread ${spread}dB"
  elif [ "$SPEECH_CLASS" = "HISS" ]; then
    spread=$(awk -v a="${MEAN[$loud]}" -v b="${MEAN[$soft]}" 'BEGIN{printf "%.1f", a-b}')
    verdict="HISS"
    detail="high-frequency dominant near ${loud}, spread ${spread}dB"
  elif [ "$SPEECH_CLASS" = "BROADBAND" ]; then
    spread=$(awk -v a="${MEAN[$loud]}" -v b="${MEAN[$soft]}" 'BEGIN{printf "%.1f", a-b}')
    verdict="TV-MUSIC"
    detail="broadband activity near ${loud} (${loud_db}dB) — likely TV/music, spread ${spread}dB"
  else
    spread=$(awk -v a="${MEAN[$loud]}" -v b="${MEAN[$soft]}" 'BEGIN{printf "%.1f", a-b}')
    verdict="ACTIVITY"
    detail="activity near ${loud} (${loud_db}dB), faintest ${soft} (${MEAN[$soft]}dB), spread ${spread}dB"
  fi
fi

# --- output -----------------------------------------------------------------
if [ "$JSON" = 1 ]; then
  printf '{"verdict":"%s","zone":"%s","speech":"%s","self_caused":%s,"quiet":%s,"mics":{' "$verdict" "$zone" "${SPEECH_CLASS:-}" "$SELF_ACTIVE" "$quiet"
  first=1
  for n in $NODES; do
    [ "$first" = 1 ] || printf ','; first=0
    if [ -n "${MEAN[$n]:-}" ]; then printf '"%s":{"mean":%s,"max":%s}' "$n" "${MEAN[$n]}" "${MAX[$n]}"
    else printf '"%s":null' "$n"; fi
  done
  printf '},"unreachable":"%s","detail":"%s"}\n' "${unreach[*]:-}" "$detail"
else
  echo "mesh-mic-correlate :: $verdict"
  [ "$SELF_ACTIVE" = 1 ] && echo "  (self-caused: mesh was emitting audio — external-event read suppressed)"
  for n in $NODES; do
    if [ -n "${MEAN[$n]:-}" ]; then printf "  %-14s mean %sdB  max %sdB\n" "$n" "${MEAN[$n]}" "${MAX[$n]}"
    else printf "  %-14s UNREACHABLE (no capture)\n" "$n"; fi
  done
  echo "  → $detail"
fi

[ "$verdict" = NO-MICS ] && exit 2 || exit 0
