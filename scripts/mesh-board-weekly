#!/usr/bin/env bash
# mesh-board-weekly — ship the last 7 days of the BOARD to the operator as one file (Telegram).
# Operator ask 2026-08-21: "можете скинуть чат-лог за последнюю неделю ... и типа рефлексами раз в
# неделю было бы круто". $0.
#
#   mesh-board-weekly            build the week's export and SEND it (mesh-tg --file)
#   mesh-board-weekly --print    build only; print the path (no send)
#   mesh-board-weekly --test     smoke test (fenced HOME, stubbed mesh-chat/mesh-tg, nothing sent)
#
# reflex-cadence: 0 9 * * 1
#
# ── why this is not `tail ~/.mesh/chat.log` ───────────────────────────────────────────────────────
# The live board is a `tail -3000` WINDOW, not a week: measured the day this landed it held 3 days
# (2026-08-18 -> 08-21) on a node whose archive went back to 06-12. Reading only chat.log would ship
# a file captioned "за неделю" that is four days short, and nothing in it would say so. The
# eviction-proof tier is `board-store.db`, read through `mesh-chat --history`
# (memory chat-overflow-log-is-not-the-eviction-tier; chat-overflow.log is NOT that tier — it holds
# over-cap [idle] bodies only).
#
# ── the archive is allowed to be absent, never silently ───────────────────────────────────────────
# `mesh-chat --history` exits 2 when the store is not answering. That is an honest n/a and this tool
# still ships — but the export's own header and the caption then say `archive: n/a (live window
# only)` and name the oldest line actually present. A week-shaped filename over a 3-day file is
# exactly CLAUDE.md's silent fallback: a total failure rendered as a plausible artifact.
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
export PATH="$HOME/.local/bin:$PATH"

LOG="${MESH_BOARD_WEEKLY_LOG:-$HOME/.mesh/board-weekly.log}"
BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
DAYS="${MESH_BOARD_WEEKLY_DAYS:-7}"
OUTDIR="${MESH_BOARD_WEEKLY_DIR:-$HOME/.mesh/board-weekly}"

usage(){ sed -n '2,20p' "$0"; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# ── build_export <outfile> — the whole pipeline, pure except for the file it writes ───────────────
# Prints one status word on stdout: `full` (archive answered) or `live-only` (archive n/a).
build_export(){
  local out="$1" i d dates="" arch rc=0 status=full
  for ((i=DAYS-1; i>=0; i--)); do
    d="$(date -u -d "-$i days" +%Y-%m-%d)" || return 1
    dates="${dates:+$dates|}$d"
  done
  arch="$(mktemp)" || return 1
  # 200000 rows: the archive is the WHOLE fleet's board history, and a cap smaller than it silently
  # truncates the OLD end — which is precisely the end the live board cannot supply.
  mesh-chat --history '' 200000 > "$arch" 2>/dev/null || rc=$?
  [ "$rc" -eq 0 ] && [ -s "$arch" ] || { status=live-only; : > "$arch"; }
  local body; body="$(mktemp)" || { rm -f "$arch"; return 1; }
  cat "$arch" "$BOARD" 2>/dev/null | grep -E "^(${dates})T" | LC_ALL=C sort -u > "$body"
  rm -f "$arch"
  local n oldest newest
  n="$(wc -l < "$body")"
  oldest="$(head -n1 "$body" | cut -c1-20)"; newest="$(tail -n1 "$body" | cut -c1-20)"
  {
    echo "# board export — $(hostname) — last $DAYS days (UTC), generated $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# lines: $n   first: ${oldest:-none}   last: ${newest:-none}"
    if [ "$status" = full ]; then
      echo "# sources: board-store.db (eviction-proof archive, via mesh-chat --history) + live chat.log, deduped"
    else
      echo "# sources: LIVE chat.log ONLY — the archive did not answer (mesh-chat --history rc=$rc)."
      echo "#          the live board is a tail-3000 window, so days older than the first line above"
      echo "#          are MISSING from this file, not absent from the week."
    fi
    echo
    cat "$body"
  } > "$out"
  rm -f "$body"
  echo "$status"
}

if [ "${1:-}" = "--test" ]; then
  for x in date mktemp grep sort wc hostname; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  command -v mesh-tg >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tg)"; exit 1; }
  command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat)"; exit 1; }
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  t="$(mktemp -d)"; mkdir -p "$t/.local/bin" "$t/.mesh"
  # FENCE: stubs live INSIDE the fake HOME, because every mesh tool re-prepends $HOME/.local/bin to
  # PATH at load — a PATH-prefixed stub outside it is re-shadowed by the real bin and the live
  # artifact gets written (memory path-stub-cannot-shadow-a-mesh-tool). Each leg asserts its stub was
  # REACHED; an unreached fence is indistinguishable from a broken one.
  inwin="$(date -u -d '-2 days' +%Y-%m-%d)"; outwin="$(date -u -d '-40 days' +%Y-%m-%d)"
  rm -f "$t/.local/bin/mesh-chat" "$t/.local/bin/mesh-tg"
  cat > "$t/.local/bin/mesh-chat" <<EOF
#!/bin/sh
echo "\$@" >> "$t/chat.argv"
[ -f "$t/chat.rc2" ] && exit 2
echo "${inwin}T00:00:00Z  ARCHIVE-ONLY-LINE"
echo "${outwin}T00:00:00Z  TOO-OLD-LINE"
EOF
  cat > "$t/.local/bin/mesh-tg" <<EOF
#!/bin/sh
echo "\$@" >> "$t/tg.argv"
[ "\$1" = "--file" ] && wc -c < "\$2" >> "$t/tg.size"
exit 0
EOF
  chmod +x "$t/.local/bin/mesh-chat" "$t/.local/bin/mesh-tg"
  printf '%sT01:00:00Z  LIVE-BOARD-LINE\n%sT01:00:00Z  LIVE-TOO-OLD\n' "$inwin" "$outwin" > "$t/.mesh/chat.log"

  # leg 1: full path — archive line + live line land, out-of-window line does not, and the SEND runs.
  out="$(HOME="$t" MESH_CHAT_LOG="$t/.mesh/chat.log" "$self" 2>&1)"; rc1=$?
  f="$(ls "$t"/.mesh/board-weekly/*.txt 2>/dev/null | head -n1)"
  [ "$rc1" -eq 0 ] || { echo "smoke-test: FAIL (send path exited $rc1: $out)"; rm -rf "$t"; exit 1; }
  [ -s "$t/chat.argv" ] || { echo "smoke-test: FAIL (mesh-chat stub never reached — the archive tier was not read)"; rm -rf "$t"; exit 1; }
  [ -n "$f" ] || { echo "smoke-test: FAIL (no export written)"; rm -rf "$t"; exit 1; }
  grep -q 'ARCHIVE-ONLY-LINE' "$f" || { echo "smoke-test: FAIL (a line present ONLY in the archive is missing — the export is the tail-3000 window, not the week)"; rm -rf "$t"; exit 1; }
  grep -q 'LIVE-BOARD-LINE' "$f" || { echo "smoke-test: FAIL (live board line missing from export)"; rm -rf "$t"; exit 1; }
  grep -q 'TOO-OLD-LINE' "$f" && { echo "smoke-test: FAIL (out-of-window line leaked into the week)"; rm -rf "$t"; exit 1; }
  grep -q -- '--file' "$t/tg.argv" 2>/dev/null || { echo "smoke-test: FAIL (mesh-tg stub not reached with --file — nothing was shipped)"; rm -rf "$t"; exit 1; }
  [ "$(head -n1 "$t/tg.size" 2>/dev/null || echo 0)" -gt 0 ] || { echo "smoke-test: FAIL (shipped file was empty at send time)"; rm -rf "$t"; exit 1; }
  grep -q 'board-store.db' "$f" || { echo "smoke-test: FAIL (export header does not name its sources)"; rm -rf "$t"; exit 1; }

  # leg 2: archive n/a — still ships, but the artifact must SAY it is the live window only.
  touch "$t/chat.rc2"; rm -f "$t/tg.argv" "$t/tg.size"; rm -rf "$t/.mesh/board-weekly"
  out2="$(HOME="$t" MESH_CHAT_LOG="$t/.mesh/chat.log" "$self" 2>&1)"; rc2=$?
  f2="$(ls "$t"/.mesh/board-weekly/*.txt 2>/dev/null | head -n1)"
  [ "$rc2" -eq 0 ] || { echo "smoke-test: FAIL (archive-n/a path exited $rc2: $out2)"; rm -rf "$t"; exit 1; }
  [ -n "$f2" ] || { echo "smoke-test: FAIL (archive n/a produced no export at all)"; rm -rf "$t"; exit 1; }
  grep -q 'LIVE chat.log ONLY' "$f2" || { echo "smoke-test: FAIL (archive n/a rendered as a complete week — the silent fallback)"; rm -rf "$t"; exit 1; }
  grep -q 'ARCHIVE-ONLY-LINE' "$f2" && { echo "smoke-test: FAIL (archive line present while the archive was refusing — the fence leaked to the real store)"; rm -rf "$t"; exit 1; }
  grep -q 'live-only' "$t/.mesh/board-weekly.log" || { echo "smoke-test: FAIL (log does not record the degraded coverage)"; rm -rf "$t"; exit 1; }
  # the real log must be untouched by all of the above
  [ ! -s "$t/../board-weekly.log" ] 2>/dev/null
  rm -rf "$t"
  echo "smoke-test: ok (archive line lands, out-of-window excluded, send reached, archive-n/a says so)"
  exit 0
fi

mkdir -p "$OUTDIR" || exit 1
STAMP="$(date -u +%Y-%m-%d)"
OUT="$OUTDIR/board-week-$STAMP.txt"
STATUS="$(build_export "$OUT")" || { echo "board-weekly: build failed" >&2; exit 1; }
N="$(( $(wc -l < "$OUT") - 4 ))"; [ "$N" -lt 0 ] && N=0
SZ="$(du -h "$OUT" | cut -f1)"
FIRST="$(grep -m1 -E '^2[0-9]{3}-' "$OUT" | cut -c1-10)"

if [ "${1:-}" = "--print" ]; then
  echo "$OUT ($N lines, $SZ, coverage=$STATUS)"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) board-weekly: built $OUT lines=$N coverage=$STATUS (--print, not sent)" >> "$LOG"
  exit 0
fi

if [ "$STATUS" = full ]; then
  CAP="Доска за неделю ($FIRST → $STAMP, UTC): $N строк, $SZ. Живой chat.log — это окно tail -3000 (сейчас в нём меньше недели), поэтому склеено с архивом board-store.db и дедуплицировано."
else
  CAP="Доска за неделю ($FIRST → $STAMP, UTC): $N строк, $SZ. ⚠️ архив (board-store.db) не ответил — здесь ТОЛЬКО живое окно chat.log, всё, что старше $FIRST, в файл не попало."
fi
if mesh-tg --file "$OUT" "$CAP" >/dev/null 2>&1; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) board-weekly: sent $OUT lines=$N coverage=$STATUS" >> "$LOG"
  echo "board-weekly: sent $OUT ($N lines, coverage=$STATUS)"
else
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) board-weekly: SEND FAILED $OUT lines=$N coverage=$STATUS" >> "$LOG"
  echo "board-weekly: send FAILED (file kept at $OUT)" >&2
  exit 1
fi
