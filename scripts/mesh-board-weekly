#!/usr/bin/env bash
# mesh-board-weekly — ship the last 7 days of the BOARD to the operator as one file (Telegram).
# Operator ask 2026-08-21: "можете скинуть чат-лог за последнюю неделю ... и типа рефлексами раз в
# неделю было бы круто". $0.
#
#   mesh-board-weekly            build the week's export and SEND it (mesh-tg --file)
#   mesh-board-weekly --print    build only; print the path (no send)
#   mesh-board-weekly --test     smoke test (fenced HOME, stubbed mesh-chat/mesh-tg, nothing sent)
#
# reflex-cadence: 0 9 * * 1
#
# chat.log is the sole retained source. Select by date, not a line-count tail.
# A successful read does not prove complete cross-node delivery; label that limit.
# Missing/unreadable text refuses export instead of sending a plausible empty week.
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
export PATH="$HOME/.local/bin:$PATH"

LOG="${MESH_BOARD_WEEKLY_LOG:-$HOME/.mesh/board-weekly.log}"
BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
DAYS="${MESH_BOARD_WEEKLY_DAYS:-7}"
OUTDIR="${MESH_BOARD_WEEKLY_DIR:-$HOME/.mesh/board-weekly}"

usage(){ sed -n '2,20p' "$0"; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# ── build_export <outfile> — the whole pipeline, pure except for the file it writes ───────────────
# Prints `text`: a successful dated selection, not proof of cross-node completeness.
build_export(){
  local out="$1" i d dates=""
  [ -r "$BOARD" ] || { echo "board-weekly: chat.log unreadable: $BOARD" >&2; return 1; }
  for ((i=DAYS-1; i>=0; i--)); do
    d="$(date -u -d "-$i days" +%Y-%m-%d)" || return 1
    dates="${dates:+$dates|}$d"
  done
  local body; body="$(mktemp)" || return 1
  if ! awk -v dates="^(${dates})T" '$0 ~ dates' "$BOARD" | LC_ALL=C sort -u > "$body"; then
    rm -f "$body"; return 1
  fi
  local n oldest newest
  n="$(wc -l < "$body")"
  oldest="$(head -n1 "$body" | cut -c1-20)"; newest="$(tail -n1 "$body" | cut -c1-20)"
  if ! {
    echo "# board export — $(hostname) — last $DAYS days (UTC), generated $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# lines: $n   first: ${oldest:-none}   last: ${newest:-none}"
    echo "# source: chat.log (append-only text), date-filtered and deduplicated"
    echo "# coverage: retained local text; cross-node completeness is not asserted"
    echo
    cat "$body"
  } > "$out"; then
    rm -f "$body"; return 1
  fi
  rm -f "$body"
  echo text
}

if [ "${1:-}" = "--test" ]; then
  self="$(readlink -f "$0")"
  t="$(mktemp -d)"; mkdir -p "$t/.local/bin" "$t/.mesh"
  inwin="$(date -u -d '-2 days' +%Y-%m-%d)"
  outwin="$(date -u -d '-40 days' +%Y-%m-%d)"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "$HOME/sends"\n' > "$t/.local/bin/mesh-tg"
  chmod +x "$t/.local/bin/mesh-tg"
  printf '%sT01:00:00Z  RETAINED-LINE\n%sT01:00:00Z  TOO-OLD-LINE\n' "$inwin" "$outwin" > "$t/.mesh/chat.log"
  HOME="$t" MESH_CHAT_LOG="$t/.mesh/chat.log" "$self" > "$t/out" 2>&1
  rc=$?
  f="$(find "$t/.mesh/board-weekly" -name '*.txt' -print -quit)"
  if [ "$rc" != 0 ] || [ ! -s "$t/sends" ] || [ ! -s "$f" ]; then
    echo "smoke-test: FAIL (isolated export/send)"; rm -rf "$t"; exit 1
  fi
  grep -q 'RETAINED-LINE' "$f" && grep -q 'source: chat.log' "$f" &&
    ! grep -q 'TOO-OLD-LINE' "$f" || { echo "smoke-test: FAIL (text selection/header)"; rm -rf "$t"; exit 1; }
  rm -f "$t/sends" "$t/.mesh/chat.log"
  if HOME="$t" MESH_CHAT_LOG="$t/.mesh/chat.log" "$self" > "$t/out" 2>&1 || [ -s "$t/sends" ]; then
    echo "smoke-test: FAIL (missing source sent as success)"; rm -rf "$t"; exit 1
  fi
  rm -rf "$t"
  echo "smoke-test: ok (text source, dated selection, isolated send, missing-source refusal)"
  exit 0
fi

mkdir -p "$OUTDIR" || exit 1
STAMP="$(date -u +%Y-%m-%d)"
OUT="$OUTDIR/board-week-$STAMP.txt"
STATUS="$(build_export "$OUT")" || { echo "board-weekly: build failed" >&2; exit 1; }
N="$(awk '/^[0-9][0-9][0-9][0-9]-/ {n++} END {print n+0}' "$OUT")"
SZ="$(du -h "$OUT" | cut -f1)"
FIRST="$(grep -m1 -E '^2[0-9]{3}-' "$OUT" | cut -c1-10)"

if [ "${1:-}" = "--print" ]; then
  echo "$OUT ($N lines, $SZ, coverage=$STATUS)"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) board-weekly: built $OUT lines=$N coverage=$STATUS (--print, not sent)" >> "$LOG"
  exit 0
fi

CAP="Доска за неделю (${FIRST:-нет строк} → $STAMP, UTC): $N строк, $SZ. Источник: append-only chat.log; отбор по дате без лимита строк. Полнота межузловой синхронизации не утверждается."
if mesh-tg --file "$OUT" "$CAP" >/dev/null 2>&1; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) board-weekly: sent $OUT lines=$N coverage=$STATUS" >> "$LOG"
  echo "board-weekly: sent $OUT ($N lines, coverage=$STATUS)"
else
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) board-weekly: SEND FAILED $OUT lines=$N coverage=$STATUS" >> "$LOG"
  echo "board-weekly: send FAILED (file kept at $OUT)" >&2
  exit 1
fi
