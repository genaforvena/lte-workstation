#!/usr/bin/env bash
# mesh-sensorium — unified one-shot snapshot of everything this node perceives.
# smoke-test: --test checks required tools are in PATH
#
# Runs each sensor tool and compiles a timestamped report to stdout.
# Each tool is best-effort (skips silently if missing or fails).
#
#   mesh-sensorium            full sensorium snapshot (LIVE — probes every sense, heavy)
#   mesh-sensorium --cached   ALL senses, categorized roll-call read from the reflexes' CACHED
#                             state artifacts (CHEAP — no live probe, no phone SSH; each value
#                             carries its age + STALE marker). The live-vs-cached split mirrors
#                             mesh-situation: --cached is for a refresh loop / pane; the full
#                             (default) live dump is for the mind. Answers "what can the mesh
#                             perceive right now?" — every sense it has, honestly aged.
#   mesh-sensorium --compact  one-line per sensor (live, the 5 node-local sensors)
#   mesh-sensorium --test     smoke test (exit 0 if PATH has mesh-tools)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
NL='
'
run(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -5 | tr '\n' ';')"
  else
    echo "[$label] (unavailable)"
  fi
}
run_compact(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -1)"
  else
    echo "[$label] (unavailable)"
  fi
}

if [ "${1:-}" = --test ]; then
  for t in mesh-health mesh-therm mesh-presence mesh-wifiscan mesh-audio; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing $t)"; exit 1; }
    "$t" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL ($t --test failed)"; exit 1; }
  done
  echo "smoke-test: ok"; exit 0
fi

case "${1:-}" in --cached|--roll) : ;; *) echo "=== mesh-sensorium @ $ts — $HOST ===" ;; esac

if [ "${1:-}" = --cached ] || [ "${1:-}" = --roll ]; then
  # ALL senses the mesh has, read from the reflexes' CACHED artifacts (cheap — no live probe).
  # Each value is aged from its file mtime; STALE if older than the sense's refresh budget so an
  # unreachable/dead sense never reads as a fresh all-clear (honest-degraded, the fusion rule).
  M="$HOME/.mesh"; now="$(date +%s)"
  agei(){ local f="$1" m d; [ -e "$f" ] || { printf '—'; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -lt 90 ];   then printf '%ss' "$d"
    elif [ "$d" -lt 5400 ]; then printf '%sm' "$((d/60))"
    else printf '%sh' "$((d/3600))"; fi; }
  mark(){ # $1=file $2=value $3=stale-limit-sec(default 1800) -> "value (BUCKET)"
    # COARSE freshness bucket, NOT an exact (Ns)/(Nm): an exact age re-renders every frame and re-wakes
    # the consuming top-pane mind on pure chrome (operator 2026-06-25: top-pane liveness is the block's
    # own job — bucket the age, keep the pane full but byte-stable between refreshes). Buckets span
    # minutes so the line doesn't churn, yet still carry signal: fresh(<2m)/recent(<10m)/aging(<limit)
    # + the honest STALE past the per-sense limit (the only state that matters for the fusion rule).
    local f="$1" v="$2" lim="${3:-1800}" m d
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -gt "$lim" ]; then printf '%s (STALE)' "$v"
    elif [ "$d" -lt 120 ];    then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ];    then printf '%s (recent)' "$v"
    else                           printf '%s (aging)' "$v"; fi; }
  fst(){ head -1 "$1" 2>/dev/null; }   # first line of a state file

  echo "=== mesh sensorium (CACHED state — the mind runs the live probes) @ $ts ==="
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle (same bug
  # fixed for situation/perimeter, 1135d62). These senses are autowired at /30 (max gap 30m=1800s):
  # body-motion :07/37, light :09/39, body-power :05/35, activity-tempo :08/38, ambient-clock :06/36
  # → use 2100s(35m) = cadence + grace. room-sense is /15 (max gap 900s) → 1200s(20m). Phone offline
  # still surfaces: an unreachable sense ages PAST cadence+grace and goes honest-STALE.
  bm="$(fst "$M/.body-motion-state" | grep -oE '\[body-[a-z]+\]' | head -1)"
  echo "BODY       motion=$(mark "$M/.body-motion-state" "$bm" 2100) · light=$(mark "$M/.light-state" "$(fst "$M/.light-state")" 2100) · power=$(mark "$M/.body-power-state" "$(fst "$M/.body-power-state")" 2100)"
  # ROOM / activity
  echo "ROOM       room=$(mark "$M/.room-sense.state" "$(fst "$M/.room-sense.state")" 1200) · tempo=$(mark "$M/.activity-tempo.state" "$(fst "$M/.activity-tempo.state")" 2100) · ambient=$(mark "$M/.ambient-clock.state" "$(fst "$M/.ambient-clock.state")" 2100)"
  # PRESENCE / who is physically around
  pl="$(tail -1 "$M/presence.log" 2>/dev/null)"
  pn="$(printf '%s\n' "$pl" | sed -nE 's/.*(n=[0-9]+).*/\1/p')"
  ptop="$(printf '%s\n' "$pl" | sed -nE 's/.*devices=\[[^|]*\|[^|]*\|([^|]*)\|.*/\1/p' | sed -E 's/ *-[0-9]+ *$//')"
  # Person-vs-appliance attribution split (mesh-presence enrichment 2026-06-21): a raw count/top can't
  # tell "a human is here" from "appliances are on" (top=[TV] is the trap, live). mesh-presence now emits
  # attribution=personal:P,appliance:A,ambiguous:M as a trailing field on the SAME presence.log line as
  # n/devices — single-source, so the split is ALWAYS the same scan as the n/top shown (no cross-file
  # guard, no intermittent omission). Older lines lacking the field → sed prints nothing → suffix omitted
  # (honest: shows no split until the next --log run writes one).
  pattr="$(printf '%s\n' "$pl" | sed -nE 's/.*attribution=personal:([0-9]+),appliance:([0-9]+),ambiguous:([0-9]+).*/ pers:\1 appl:\2 amb:\3/p')"
  arr="$(grep -iE ':: *\[(arrived|left)' "$M/chat.log" 2>/dev/null | tail -1 | sed -E 's/.*:: *//' | cut -c1-40)"
  echo "PRESENCE   $(mark "$M/presence.log" "${pn:-n=?} top=${ptop:-?}${pattr}" 900)${arr:+ · last: $arr}"
  # HOUSEHOLD / operator
  hs="$(tail -1 "$M/home-state.log" 2>/dev/null | sed -E 's/^\[home-state\] ([A-Z_]+):.*/\1/')"
  echo "HOUSEHOLD  mode=$(mark "$M/.household.state" "$(fst "$M/.household.state")" 1200) · home-state=$(mark "$M/home-state.log" "$hs" 1200) · operator-home=$(mark "$M/.op-home.state" "$(fst "$M/.op-home.state")" 1200)"
  # SITUATION / SECURITY (fused) + watchtower (the eye on the net)
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle:
  # mesh-{perimeter,situation} --edge are autowired at /45 (max gap 45m=2700s), so 2400s(40m)
  # showed STALE in the 40-45m window of EVERY cycle. 3000s(50m) clears the cadence + grace,
  # while a genuinely missed cycle (age climbs past 50m toward the 90m double-gap) still trips.
  per="$(fst "$M/.perimeter.state" | cut -f2)"
  wtr="$([ "$(fst "$M/.watchtower-state.reach")" = 1 ] && echo reach-ok || echo reach-BLIND)"
  echo "SITUATION  situation=$(mark "$M/.situation.state" "$(fst "$M/.situation.state")" 3000) · perimeter=$(mark "$M/.perimeter.state" "$per" 3000) · watchtower=$(mark "$M/.watchtower-state.reach" "$wtr" 3600)"
  # NODE (this body's own hardware sense)
  echo "NODE       $(mark "$M/.hw-health.state" "$(fst "$M/.hw-health.state")" 7200)"
  # the senses with NO persistent cache — listed so the roll-call is honestly COMPLETE; the mind
  # probes these live (mesh-sensorium with no flag, or the individual tool).
  echo "LIVE-ONLY (mind probes, no cache): body-context · tamper · operator-state · wifi-motion · location · lan-health · lan-newdevice · find · keypresence · audio-active · netrate"
  exit 0
fi

if [ "${1:-}" = --compact ]; then
  run_compact "mesh-health" "mesh-health 2>&1 | sed -n '3p'"
  run_compact "mesh-therm" "mesh-therm 2>&1"
  run_compact "mesh-presence" "mesh-presence 2>&1 | head -1"
  run_compact "mesh-wifiscan" "mesh-wifiscan 2>&1 | head -1"
  run_compact "mesh-audio" "mesh-audio 2>&1"
  run_compact "mesh-card" "grep -E '^(hostname|tailscale-ip|as-of)' ~/.mesh-card 2>/dev/null | tr '\n' ' ' || echo '(no card)'"
else
  echo ""
  echo "--- health ---"
  mesh-health 2>&1 || true
  echo ""
  echo "--- thermal ---"
  mesh-therm --verbose 2>&1 || true
  echo ""
  echo "--- BLE presence ---"
  mesh-presence 2>&1 || true
  echo ""
  echo "--- WiFi proximity ---"
  mesh-wifiscan 2>&1 || true
  echo ""
  echo "--- audio hardware ---"
  mesh-audio --verbose 2>&1 || true
  echo ""
  echo "--- card ---"
  head -10 ~/.mesh-card 2>/dev/null || echo "(no card)"
fi

echo ""
echo "=== end sensorium ==="
