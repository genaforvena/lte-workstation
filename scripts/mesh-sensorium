#!/usr/bin/env bash
# mesh-sensorium — unified one-shot snapshot of everything this node perceives.
# smoke-test: --test checks required tools are in PATH
#
# Runs each sensor tool and compiles a timestamped report to stdout.
# Each tool is best-effort (skips silently if missing or fails).
#
#   mesh-sensorium            full sensorium snapshot (LIVE — probes every sense, heavy)
#   mesh-sensorium --cached   ALL senses, categorized roll-call read from the reflexes' CACHED
#                             state artifacts (CHEAP — no live probe, no phone SSH; each value
#                             carries its age + STALE marker). The live-vs-cached split mirrors
#                             mesh-situation: --cached is for a refresh loop / pane; the full
#                             (default) live dump is for the mind. Answers "what can the mesh
#                             perceive right now?" — every sense it has, honestly aged.
#   mesh-sensorium --compact  one-line per sensor (live, the 5 node-local sensors)
#   mesh-sensorium --balance  RR efficiency<->resiliency report over the cached roll-call (read-only)
#   mesh-sensorium --exteriority  relations-of-exteriority report: per cached stream, how many OTHER
#                             tools re-plug it (consumer fan-out) — detachable(EXTERIOR) vs welded /
#                             expressive-only(INTERIORITY). read-only. (Deleuze&Guattari/DeLanda)
#   mesh-sensorium --test     smoke test (exit 0 if PATH has mesh-tools)
#
# ── RELEVANCE REALIZATION: efficiency<->resiliency opponent processing (live review 2026-07-28) ──────
# LITERATURE (cross-domain transfer to a distributed sensor mesh). Vervaeke's relevance realization
# solves the frame problem not with a fixed relevance function but with OPPONENT PROCESSING — antagonist
# drives held in dynamic tension, self-organized to the agent's own economy. The GENERAL opposition that
# subsumes the rest (exploration<->exploitation, generality<->specialization, focusing<->diversifying) is
# EFFICIENCY <-> RESILIENCY: "resiliency entails increased variation while efficiency involves selection,
# a culling of unnecessary structures" — a cognitive system must stay efficient WHILE remaining resilient.
#   refs: Vervaeke, Lillicrap & Richards, "Relevance realization and the emerging framework in cognitive
#   science", J. Logic & Computation 22(1):79-99 (2012, sites.utoronto.ca/jvcourses/jolc.pdf); re-affirmed
#   as self-organizing/bioeconomic in Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing relevance
#   realization", Frontiers in Psychology 15:1362658 (2024, PMC11231436).
# WHERE WE'D BEEN: precision-weighting (mesh-precision), the large-world frame limit (mesh-precision
# frame_coverage), goal-relativity (mesh-novelty), and the SPECIFIC explore<->exploit opponent balance
# (mesh-needs). NOT embodied: the GENERAL efficiency<->resiliency opposition read over the SENSORIUM.
# THE TRANSFER: a sensorium where each percept-category rests on ONE cached stream is maximally EFFICIENT
# but BRITTLE — that one stream dying blinds the whole category (a single point of sensory failure);
# a category backed by SEVERAL independent live streams is RESILIENT (redundant variation) but costs more
# to keep warm. --balance measures this balance so the mesh can watch it, exactly as mesh-needs makes the
# explore<->exploit balance visible. Read-only; artifact: docs/reviews/rr-efficiency-resiliency-sensorium-2026-07-28.md
#
# ── ASSEMBLAGE: relations of exteriority (--exteriority — live review 2026-07-28) ─────────────────────
# LITERATURE (Deleuze & Guattari, cross-domain transfer to a distributed sensor mesh). The DEFINING
# formal property of an assemblage (agencement) is that its components stand in RELATIONS OF EXTERIORITY:
# a part "may be detached from it and plugged into a different assemblage in which its interactions are
# different" — its identity is NOT constituted by its current links. The contrary is a relation of
# INTERIORITY, where a part is co-constituted by the whole and cannot be removed without both collapsing.
#   refs: Deleuze & Guattari, A Thousand Plateaus (1980); Manuel DeLanda, "A New Philosophy of Society:
#   Assemblage Theory and Social Complexity" (2006) — relations of exteriority vs interiority, the two
#   axes (material<->expressive · territorializing<->deterritorializing); DeLanda, "Assemblage Theory"
#   (Edinburgh UP 2016). Re-surveyed via grokipedia.com/page/Assemblage_(philosophy) + Parrhesia 29
#   (Ball, parrhesiajournal.org/parrhesia29/parrhesia29_ball.pdf), current 2025-26.
# WHERE WE'D BEEN: deterritorialization coefficient (mesh-novelty --territory), inclusive disjunction
# (mesh-situation), order-word redundancy (board), smooth/striated (mesh). And --balance above measures
# resiliency = streams-per-category (redundancy of PRODUCERS feeding ONE fusion). NOT embodied: the
# CONSUMER-side dual — how detachable each stream is, i.e. how many OTHER assemblages re-plug it.
# THE TRANSFER: --balance looks INTO the sensorium (producers per percept); relations of exteriority look
# OUT (consumers per stream). A cached stream re-plugged by many tools is EXTERIOR — detachable, robust to
# any one consumer dying, assemblage-mobile. A stream re-plugged by exactly ONE is a relation of
# INTERIORITY (WELDED): a 1:1 coupling that LOOKS modular but is co-constituted — either end dying orphans
# the other. A stream NO other tool reads is EXPRESSIVE-ONLY: a pure sign that drives nothing downstream.
# GRANULARITY CAVEAT (honest, the --balance-caveat spirit): this measures coupling of the CACHED ARTIFACT
# at FILE granularity — a consumer that re-invokes the SENSE LIVE (calls mesh-<x>) instead of reading its
# cache is deliberately NOT counted. That is not a blind spot, it is the point: a cache classed
# EXPRESSIVE-ONLY whose sense is nonetheless live-consumed is the interiority finding sharpened — the
# cached component is welded to the pane while functional consumers PAY to re-probe live (the efficiency
# loss --balance's RR frame cares about). Report-only, no verdict touched; artifact:
# docs/reviews/deleuze-assemblage-relations-of-exteriority-sensorium-2026-07-28.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
NL='
'
run(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -5 | tr '\n' ';')"
  else
    echo "[$label] (unavailable)"
  fi
}
run_compact(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -1)"
  else
    echo "[$label] (unavailable)"
  fi
}

if [ "${1:-}" = --test ]; then
  # Gate the --cached roll-call's perimeter field by DRIVING it against a crafted state artifact,
  # not by grepping this source. Two cases, because one alone asserts nothing: the ALERT case pins
  # which FIELD is read (f2=out is CALM there, so a sub-axis read renders a false all-clear and this
  # fails), the CALM control pins that we still track the verdict down (a hardcoded "ALERT" passes
  # case 1 and fails here). Pure file reads under a throwaway HOME — no organ needed, so no exit 2.
  _s="$(mktemp -d)"; mkdir -p "$_s/.mesh"
  _roll(){ printf '%s\t%s\n' "$(date -u +%FT%TZ)" "$1" > "$_s/.mesh/.perimeter.state"
           HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^SITUATION .*perimeter=\([A-Za-z-]*\).*/\1/p'; }
  # out=CALM net=ALERT phy=CALM verdict=ALERT — the unknown-MAC-on-LAN shape that hid behind cut -f2
  _got="$(_roll "$(printf 'CALM\tALERT\tCALM\tALERT')")"
  [ "$_got" = ALERT ] || { echo "smoke-test: FAIL (perimeter verdict ALERT rendered as '${_got:-<empty>}' — reading the wrong field of .perimeter.state?)"; rm -rf "$_s"; exit 1; }
  _got="$(_roll "$(printf 'CALM\tCALM\tCALM\tCALM')")"
  [ "$_got" = CALM ] || { echo "smoke-test: FAIL (perimeter verdict CALM rendered as '${_got:-<empty>}')"; rm -rf "$_s"; exit 1; }

  # Gate the BODY motion= field the same way: drive the roll-call against a real .body-motion-state
  # in each of the WRITER's two shapes (mesh-body-motion:580 live / :128 offline). One case alone
  # asserts nothing -- the OFFLINE case pins that we extract the TAG (a whole-record read renders
  # `|OFFLINE||||` and fails here), the live control pins that the [body-xxx] path still wins (a
  # blanket `cut -f2` that dropped the regex would print `[body-still]` and pass case 1 alone).
  _bm(){ printf '%s\n' "$1" > "$_s/.mesh/.body-motion-state"
         HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^BODY  *motion=\([^ ]*\).*/\1/p'; }
  _got="$(_bm '|OFFLINE||||')"
  [ "$_got" = OFFLINE ] || { echo "smoke-test: FAIL (offline body-motion rendered as '${_got:-<empty>}', want OFFLINE — reading the raw record instead of the writer's field-2 tag?)"; rm -rf "$_s"; exit 1; }
  _got="$(_bm '4213|[body-still]|0|[body-still]|1800|3')"
  [ "$_got" = '[body-still]' ] || { echo "smoke-test: FAIL (live body-motion rendered as '${_got:-<empty>}', want [body-still])"; rm -rf "$_s"; exit 1; }
  echo "  ok: BODY motion= renders the tag for both writer shapes (live + OFFLINE pipe schema)"
  rm -rf "$_s"

  # RR efficiency<->resiliency (--balance): drive the REAL --balance black-box against crafted cached
  # state under a throwaway HOME (a fresh file = a LIVE stream, absent = a dead one). Three fixtures pin
  # the three verdict branches so no single hardcoded verdict passes: BLIND (nothing cached → exit 4),
  # BRITTLE (one live stream per category → exit 3), balanced (multi-stream categories filled → exit 0).
  # Falsify: flip the `brittle*2 >= cats` threshold or drop the live/dead counting → a branch goes RED.
  _b="$(mktemp -d)"; mkdir -p "$_b/.mesh"
  _bal(){ HOME="$_b" bash "$0" --balance 2>/dev/null; }   # prints report, exits with the posture code
  _fresh(){ printf 'x\n' > "$_b/.mesh/$1"; }              # a live cached stream (mtime = now)
  # (1) BLIND — empty .mesh: every category renders all-(—), zero live → BLIND-SPOTS, exit 4.
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: BLIND-SPOTS' && [ "$_rc" -eq 4 ]; } \
    || { echo "smoke-test: FAIL (--balance on an empty roll-call must be BLIND-SPOTS/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  # (2) BRITTLE — exactly ONE live stream per category (each category depth 1 → single-source).
  _fresh .body-motion-state; _fresh .room-sense.state; _fresh presence.log
  _fresh .household.state;   _fresh .situation.state;  _fresh .interruptibility.state; _fresh .hw-health.state
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: BRITTLE' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--balance with one live stream/category must be BRITTLE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  # (3) balanced — fill the multi-field categories to depth>=2 so <half are single-source → exit 0.
  _fresh .light-state; _fresh .body-power-state             # BODY -> 3/4
  _fresh .activity-tempo.state; _fresh .ambient-clock.state # ROOM -> 3/6
  _fresh home-state.log                                     # HOUSEHOLD -> 2/3
  _fresh .perimeter.state                                   # SITUATION -> 2/3
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: balanced' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--balance with redundant streams must be balanced/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  echo "  ok: --balance efficiency<->resiliency posture tracks stream depth (BLIND/BRITTLE/balanced)"
  rm -rf "$_b"

  # ASSEMBLAGE relations of exteriority (--exteriority): drive the REAL black-box against a CRAFTED
  # toolset (MESH_BINDIR) with KNOWN reference counts, so the classify bands are asserted on data, not
  # on the live graph. Three fake tools reference .perimeter.state (=> refs 3 EXTERIOR); two reference
  # .interruptibility.state (=> refs 2 WELDED); the branch pins on the posture + exit code.
  _e="$(mktemp -d)"; mkdir -p "$_e/bin"
  _tool(){ printf '#!/bin/sh\n# refs: %s\n' "$2" > "$_e/bin/$1"; }   # $1=name $2=stream-basename it reads
  _ext(){ MESH_BINDIR="$_e/bin" HOME="$_e" bash "$0" --exteriority 2>/dev/null; }
  # (1) EXPRESSIVE-DEADENDS — empty toolset: every stream refs 0 => not-produced => exit 4.
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: EXPRESSIVE-DEADENDS' && [ "$_rc" -eq 4 ]; } \
    || { echo "smoke-test: FAIL (--exteriority empty toolset must be EXPRESSIVE-DEADENDS/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  _allstreams=".body-motion-state .light-state .body-power-state .phone-prox.state \
.room-sense.state .activity-tempo.state .ambient-clock.state .audio-path-state .room-context.state .media-scene.state \
presence.log .household.state home-state.log .op-home.state \
.perimeter.state .situation.state .watchtower-state.reach .interruptibility.state .hw-health.state"
  _consumer(){ { printf '#!/bin/sh\n'; for s in $_allstreams; do printf '# reads %s\n' "$s"; done; } > "$_e/bin/$1"; }
  # (2) EXTERIOR — 3 tools each referencing EVERY stream => refs=3 for all => none welded/expr => exit0.
  _consumer mesh-consumer1; _consumer mesh-consumer2; _consumer mesh-consumer3
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: EXTERIOR' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--exteriority all-streams-refs3 must be EXTERIOR/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # (3) INTERIORITY-PINNED — drop to exactly TWO referencing tools => every stream refs 2 => all WELDED.
  rm -f "$_e/bin/mesh-consumer3"
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: INTERIORITY-PINNED' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--exteriority all-streams-refs2 must be INTERIORITY-PINNED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # (4) per-line classify on a fresh fixture: .perimeter.state read by 3 tools => EXTERIOR; .op-home.state
  #     read by 1 => EXPRESSIVE-ONLY. (posture is EXPRESSIVE-DEADENDS here; only the per-line bands asserted.)
  rm -f "$_e"/bin/*
  for i in 1 2 3; do echo '# reads .perimeter.state' > "$_e/bin/mesh-per$i"; done
  echo '# reads .op-home.state' > "$_e/bin/mesh-solo"
  _out="$(_ext)"
  { printf '%s' "$_out" | grep -qE '\.perimeter\.state +refs 3 +EXTERIOR'; } \
    || { echo "smoke-test: FAIL (--exteriority per-line: .perimeter.state at refs 3 must read EXTERIOR)"; printf '%s\n' "$_out" | grep -E 'perimeter|op-home'; rm -rf "$_e"; exit 1; }
  { printf '%s' "$_out" | grep -qE '\.op-home\.state +refs 1 +EXPRESSIVE-ONLY'; } \
    || { echo "smoke-test: FAIL (--exteriority per-line: .op-home.state at refs 1 must read EXPRESSIVE-ONLY)"; printf '%s\n' "$_out" | grep -E 'op-home'; rm -rf "$_e"; exit 1; }
  echo "  ok: --exteriority relations-of-exteriority bands track consumer fan-out (EXTERIOR/WELDED/EXPRESSIVE/exit)"
  rm -rf "$_e"

  for t in mesh-health mesh-therm mesh-presence mesh-wifiscan mesh-audio; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing $t)"; exit 1; }
    "$t" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL ($t --test failed)"; exit 1; }
  done
  echo "smoke-test: ok"; exit 0
fi

case "${1:-}" in --cached|--roll|--balance|--exteriority) : ;; *) echo "=== mesh-sensorium @ $ts — $HOST ===" ;; esac

if [ "${1:-}" = --cached ] || [ "${1:-}" = --roll ]; then
  # ALL senses the mesh has, read from the reflexes' CACHED artifacts (cheap — no live probe).
  # Each value is aged from its file mtime; STALE if older than the sense's refresh budget so an
  # unreachable/dead sense never reads as a fresh all-clear (honest-degraded, the fusion rule).
  M="$HOME/.mesh"; now="$(date +%s)"
  agei(){ local f="$1" m d; [ -e "$f" ] || { printf '—'; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -lt 90 ];   then printf '%ss' "$d"
    elif [ "$d" -lt 5400 ]; then printf '%sm' "$((d/60))"
    else printf '%sh' "$((d/3600))"; fi; }
  mark(){ # $1=file $2=value $3=stale-limit-sec(default 1800) -> "value (BUCKET)"
    # COARSE freshness bucket, NOT an exact (Ns)/(Nm): an exact age re-renders every frame and re-wakes
    # the consuming top-pane mind on pure chrome (operator 2026-06-25: top-pane liveness is the block's
    # own job — bucket the age, keep the pane full but byte-stable between refreshes). Buckets span
    # minutes so the line doesn't churn, yet still carry signal: fresh(<2m)/recent(<10m)/aging(<limit)
    # + the honest STALE past the per-sense limit (the only state that matters for the fusion rule).
    local f="$1" v="$2" lim="${3:-1800}" m d
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -gt "$lim" ]; then printf '%s (STALE)' "$v"
    elif [ "$d" -lt 120 ];    then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ];    then printf '%s (recent)' "$v"
    else                           printf '%s (aging)' "$v"; fi; }
  fst(){ head -1 "$1" 2>/dev/null; }   # first line of a state file
  bodymark(){ # $1=state-file $2=value $3=stale-limit $4=companion-reflex-log
    # Like mark(), but for the phone-BODY senses: when the state goes STALE, peek the companion reflex
    # LOG. If that log is still FRESH (the cron is firing) and its last line says the organ is
    # unreachable, this is an OFFLINE ORGAN (honest n/a — the phone body is gone, operator's hands),
    # NOT a dead reflex to fix. A frozen state + a frozen log = a genuinely dead reflex → keep STALE.
    # Distinguishing the two stops the consuming mind chasing a non-bug (the failed-vs-empty rule).
    local f="$1" v="$2" lim="${3:-1800}" log="$4" m d lm
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if [ "$d" -gt "$lim" ]; then
      if [ -n "$log" ] && [ -e "$log" ]; then
        lm="$(stat -c %Y "$log" 2>/dev/null || echo 0)"
        if [ "$((now-lm))" -le "$lim" ] && tail -1 "$log" 2>/dev/null | grep -qi 'unreachable'; then
          printf 'OFFLINE(phone)'; return
        fi
      fi
      printf '%s (STALE)' "$v"; return
    fi
    if   [ "$d" -lt 120 ]; then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ]; then printf '%s (recent)' "$v"
    else                        printf '%s (aging)' "$v"; fi; }

  echo "=== mesh sensorium (CACHED state — the mind runs the live probes) @ $ts ==="
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle (same bug
  # fixed for situation/perimeter, 1135d62). These senses are autowired at /30 (max gap 30m=1800s):
  # body-motion :07/37, light :09/39, body-power :05/35, activity-tempo :08/38, ambient-clock :06/36
  # → use 2100s(35m) = cadence + grace. room-sense is /15 (max gap 900s) → 1200s(20m). phone-prox
  # declares 19-59/45 which fires at :19 ONLY (45-step from 19 exceeds 59) → real stride 3600s →
  # 4200s(70m); a 3000s TTL false-STALEd it every hour from :09 to :19. Phone offline still
  # surfaces: an unreachable sense ages PAST cadence+grace and goes honest-STALE.
  bm="$(fst "$M/.body-motion-state" | grep -oE '\[body-[a-z]+\]' | head -1)"
  # Fallback for the honest-degraded OFFLINE marker (mesh-body-motion writes it when the phone is
  # unreachable): the [body-xxx] regex never matches it, so bm blanks to empty -> bodymark's '?'
  # default, reading as an ambiguous/broken sense while the sibling light=/power= fields on the SAME
  # line show their marker verbatim. Take the TAG (field 2 of the writer's 6-field pipe schema,
  # mesh-body-motion:580 `steps|tag|hyst|pending|dwell_s|changes_24h`), which is where the writer
  # puts OFFLINE (:128 `|OFFLINE||||`, steps deliberately empty = unknown, not a fabricated 0).
  # The 2026-07-05 fallback took the first WHITESPACE token, matching the writer's then-current
  # pipe-less `OFFLINE <ts>` line; the 2026-07-10 fidelity fix moved to the pipe schema and no
  # consumer followed, so an offline phone has rendered as the raw record `motion=|OFFLINE||||`
  # since. Anchor on the writer's printf, never on a token position that outlives its format.
  [ -n "$bm" ] || bm="$(fst "$M/.body-motion-state" | cut -d'|' -f2)"
  # last resort: a state in NEITHER shape still renders its own first token, never a silent blank
  [ -n "$bm" ] || bm="$(fst "$M/.body-motion-state" | awk '{print $1}')"
  echo "BODY       motion=$(bodymark "$M/.body-motion-state" "$bm" 2100 "$M/body-motion.log") · light=$(bodymark "$M/.light-state" "$(fst "$M/.light-state")" 2100 "$M/light.log") · power=$(bodymark "$M/.body-power-state" "$(fst "$M/.body-power-state")" 2100 "$M/body-power.log") · prox=$(mark "$M/.phone-prox.state" "$(fst "$M/.phone-prox.state" | cut -d'|' -f1)" 4200)"
  # ROOM / activity
  # audio-path is /10 (mesh-audio-path fusion: emit×mic — is our own playback audible?) → 2100s TTL
  echo "ROOM       room=$(mark "$M/.room-sense.state" "$(fst "$M/.room-sense.state")" 1200) · tempo=$(mark "$M/.activity-tempo.state" "$(fst "$M/.activity-tempo.state")" 2100) · ambient=$(mark "$M/.ambient-clock.state" "$(fst "$M/.ambient-clock.state")" 2100) · audio-path=$(mark "$M/.audio-path-state" "$(fst "$M/.audio-path-state" | cut -d'|' -f1)" 2100) · context=$(mark "$M/.room-context.state" "$(fst "$M/.room-context.state")" 600) · media=$(mark "$M/.media-scene.state" "$(fst "$M/.media-scene.state")" 600)"
  # PRESENCE / who is physically around
  pl="$(tail -1 "$M/presence.log" 2>/dev/null)"
  pn="$(printf '%s\n' "$pl" | sed -nE 's/.*(n=[0-9]+).*/\1/p')"
  ptop="$(printf '%s\n' "$pl" | sed -nE 's/.*devices=\[[^|]*\|[^|]*\|([^|]*)\|.*/\1/p' | sed -E 's/ *-[0-9]+ *$//')"
  # Person-vs-appliance attribution split (mesh-presence enrichment 2026-06-21): a raw count/top can't
  # tell "a human is here" from "appliances are on" (top=[TV] is the trap, live). mesh-presence now emits
  # attribution=personal:P,appliance:A,ambiguous:M as a trailing field on the SAME presence.log line as
  # n/devices — single-source, so the split is ALWAYS the same scan as the n/top shown (no cross-file
  # guard, no intermittent omission). Older lines lacking the field → sed prints nothing → suffix omitted
  # (honest: shows no split until the next --log run writes one).
  pattr="$(printf '%s\n' "$pl" | sed -nE 's/.*attribution=personal:([0-9]+),appliance:([0-9]+),ambiguous:([0-9]+).*/ pers:\1 appl:\2 amb:\3/p')"
  arr="$(grep -iE ':: *\[(arrived|left)' "$M/chat.log" 2>/dev/null | tail -1 | sed -E 's/.*:: *//' | cut -c1-40)"
  echo "PRESENCE   $(mark "$M/presence.log" "${pn:-n=?} top=${ptop:-?}${pattr}" 900)${arr:+ · last: $arr}"
  # HOUSEHOLD / operator
  hs="$(tail -1 "$M/home-state.log" 2>/dev/null | sed -E 's/^\[home-state\] ([A-Z_]+):.*/\1/')"
  echo "HOUSEHOLD  mode=$(mark "$M/.household.state" "$(fst "$M/.household.state")" 1200) · home-state=$(mark "$M/home-state.log" "$hs" 1200) · operator-home=$(mark "$M/.op-home.state" "$(fst "$M/.op-home.state")" 1200)"
  # SITUATION / SECURITY (fused) + watchtower (the eye on the net)
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle:
  # mesh-{perimeter,situation} --edge are autowired at /45 (max gap 45m=2700s), so 2400s(40m)
  # showed STALE in the 40-45m window of EVERY cycle. 3000s(50m) clears the cadence + grace,
  # while a genuinely missed cycle (age climbs past 50m toward the 90m double-gap) still trips.
  # mesh-perimeter:587 writes: ts \t out \t net \t phy \t VERDICT — the fused verdict is f5, and f2 is
  # only the OUTSIDE sub-axis. cut -f2 rendered perimeter=CALM on a live ALERT whenever the alert came
  # from NETWORK or PHYSICAL (an unknown MAC on the LAN is exactly that shape) — the sub-axis it named
  # was genuinely calm, so the pane read as an all-clear with no staleness tell. mesh-situation:227
  # reads the same file positionally and got ALERT; the two panes disagreed. Take the verdict (f5).
  per="$(fst "$M/.perimeter.state" | cut -f5)"
  wtr="$([ "$(fst "$M/.watchtower-state.reach")" = 1 ] && echo reach-ok || echo reach-BLIND)"
  echo "SITUATION  situation=$(mark "$M/.situation.state" "$(fst "$M/.situation.state")" 3000) · perimeter=$(mark "$M/.perimeter.state" "$per" 3000) · watchtower=$(mark "$M/.watchtower-state.reach" "$wtr" 3600)"
  # COORDINATION — when may the mesh speak/alert? (mesh-interruptibility fuses kbd+screen+room+
  # ambient+tempo+light+operator-awake+time → band). /12 cadence (max gap 12m=720s) → 1500s(25m) clears
  # cadence + grace; a dead reflex ages past it to honest STALE so the mind never trusts a stale band.
  echo "COORDINATION interruptibility=$(mark "$M/.interruptibility.state" "$(fst "$M/.interruptibility.state")" 1500)"
  # NODE (this body's own hardware sense)
  echo "NODE       $(mark "$M/.hw-health.state" "$(fst "$M/.hw-health.state")" 7200)"
  # the senses with NO persistent cache — listed so the roll-call is honestly COMPLETE; the mind
  # probes these live (mesh-sensorium with no flag, or the individual tool).
  echo "LIVE-ONLY (mind probes, no cache): body-context · tamper · operator-state · wifi-motion · location · lan-health · lan-newdevice · find · keypresence · audio-active · jack · netrate · irq-rate · proc-churn · wake"
  exit 0
fi

if [ "${1:-}" = --balance ]; then
  # RR efficiency<->resiliency report (see the header). READ-ONLY: reuses --cached's roll-call (the ONE
  # source of truth for what's live) and counts, per percept-category, how many cached streams are LIVE
  # (fresh/recent/aging) vs dead (STALE / absent(—) / OFFLINE). DEPTH = live streams; depth 1 = single
  # point of sensory failure (over-efficient/brittle), depth 0 = blind, depth>=2 = resilient (redundant).
  # GRANULARITY CAVEAT (honest, in the mesh-precision frame_coverage spirit): depth is measured at
  # CACHED-STREAM granularity — a category rendered as one fused field (e.g. PRESENCE fuses many organs
  # into presence.log) reads single-source even so, because at the sensorium level that ONE stream dying
  # blinds the category regardless of how many organs feed it. That is a real brittleness, not an artifact.
  echo "=== sensorium efficiency<->resiliency balance @ $ts — $HOST ==="
  echo "(RR opponent processing — Vervaeke 2012/2024: resiliency=redundant independent live streams,"
  echo " efficiency=fewest streams per percept. depth=LIVE cached streams; 1=single point of failure, 0=blind.)"
  roll="$(bash "$0" --cached 2>/dev/null)"
  printf '%s\n' "$roll" | awk '
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1
      l=$0; live =gsub(/\((fresh|recent|aging)\)/,"",l)
      s=$0; stale=gsub(/\(STALE\)/,"",s)
      d=$0; dash =gsub(/\(—\)/,"",d)
      # count ONLY the offline MARKER bodymark emits (OFFLINE(phone)), never the value-word "OFFLINE"
      # (motion=OFFLINE / power=OFFLINE are live values carrying their own freshness bucket — the bucket
      # above already counted them; matching bare OFFLINE double-counted them into total, the /6-not-/4 bug)
      o=$0; off  =gsub(/OFFLINE\(phone\)/,"",o)
      total=live+stale+dash+off
      if(total==0) next
      cats++
      tag=""
      if(live==0){ tag=" ⚠ BLIND (no live stream)"; blind++ }
      else if(live==1){ tag=" ⚠ single-source (single point of sensory failure)"; single++ }
      else resilient++
      printf "  %-12s depth %d/%d live%s\n", cat, live, total, tag
    }
    END{
      brittle=blind+single
      printf "\n  streams: %d resilient (depth>=2) · %d single-source · %d blind  (of %d categories)\n", \
        resilient, single, blind, cats
      if(cats==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      if(blind>0){
        printf "  posture: BLIND-SPOTS — %d categor%s have no live stream; resiliency has failed there, not just thinned\n", blind, (blind==1?"y":"ies")
        exit 4
      }
      if(brittle*2 >= cats){
        printf "  posture: BRITTLE (efficiency-pinned) — %d of %d categories rest on a single stream; the opponent balance has collapsed toward efficiency, one death from a blind spot\n", brittle, cats
        exit 3
      }
      print  "  posture: balanced — most categories carry redundant live streams (resiliency intact)"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --exteriority ]; then
  # ASSEMBLAGE relations of exteriority (see the header). READ-ONLY. The CONSUMER-side dual of --balance:
  # for each CACHED stream the roll-call knows, count how many DISTINCT tools re-plug it (reference its
  # basename), so a stream's DETACHABILITY is visible. BINDIR overridable (default ~/.local/bin) so the
  # --test can drive a crafted toolset. AGGREGATOR EXCLUSION: mesh-sensorium + mesh-dash read ~every
  # stream (this tool and the pane) — counting them would mask every stream as EXTERIOR, so both are
  # named-excluded (honest, stated in the header, not a fuzzy heuristic).
  BINDIR="${MESH_BINDIR:-$HOME/.local/bin}"
  # canonical cached-stream set — the SAME file-backed senses the --cached roll-call renders (kept in
  # step with that block: BODY/ROOM/PRESENCE/HOUSEHOLD/SITUATION/COORDINATION/NODE).
  STREAMS=".body-motion-state .light-state .body-power-state .phone-prox.state \
.room-sense.state .activity-tempo.state .ambient-clock.state .audio-path-state .room-context.state .media-scene.state \
presence.log .household.state home-state.log .op-home.state \
.perimeter.state .situation.state .watchtower-state.reach .interruptibility.state .hw-health.state"
  echo "=== sensorium relations-of-exteriority @ $ts — $HOST ==="
  echo "(Deleuze&Guattari/DeLanda: an assemblage's parts are DETACHABLE — re-pluggable into other"
  echo " assemblages. refs=distinct OTHER tools re-plugging the cached stream (aggregators sensorium/dash"
  echo " excluded). >=2 EXTERIOR(detachable) · 1 WELDED(interiority,1:1) · 0 EXPRESSIVE-ONLY(drives nothing).)"
  ext=0; welded=0; expr=0; np=0; total=0
  for s in $STREAMS; do
    # distinct tool FILES (mesh-*) referencing the basename as a FIXED string, minus the two aggregators.
    # producer is counted among refs (it writes its own file); the classify below subtracts it implicitly
    # by banding on the CONSUMER floor: refs>=3 => producer+>=2 consumers, ==2 => producer+1, ==1 =>
    # producer only, ==0 => no tool references it (external/absent producer).
    n=$(grep -lF "$s" "$BINDIR"/mesh-* 2>/dev/null | sed 's#.*/##' | grep -vxE 'mesh-sensorium|mesh-dash' | sort -u | wc -l)
    total=$((total+1))
    if   [ "$n" -ge 3 ]; then cls="EXTERIOR"; tag=""; ext=$((ext+1))
    elif [ "$n" -eq 2 ]; then cls="WELDED"; tag=" ⚠ interiority (1:1 coupling — modular-looking, co-constituted)"; welded=$((welded+1))
    elif [ "$n" -eq 1 ]; then cls="EXPRESSIVE-ONLY"; tag=" ⚠ drives nothing downstream (cache re-plugged by no other tool)"; expr=$((expr+1))
    else cls="NOT-PRODUCED"; tag=" ⚠ no tool references it — pane reads a stream with no visible producer"; np=$((np+1)); fi
    printf "  %-24s refs %-2d %-14s%s\n" "$s" "$n" "$cls" "$tag"
  done
  echo ""
  printf "  streams: %d exterior (detachable) · %d welded · %d expressive-only · %d not-produced  (of %d)\n" \
    "$ext" "$welded" "$expr" "${np:-0}" "$total"
  if [ "$total" -eq 0 ]; then echo "  posture: NO STREAMS"; exit 2; fi
  if [ "${np:-0}" -gt 0 ] || [ "$expr" -gt 0 ]; then
    printf "  posture: EXPRESSIVE-DEADENDS — %d stream(s) re-plugged by no other tool; the sensorium caches signs that drive nothing (or have no producer)\n" "$((expr+${np:-0}))"
    exit 4
  fi
  if [ $((welded*2)) -ge "$total" ]; then
    printf "  posture: INTERIORITY-PINNED — %d of %d streams are welded 1:1; the sensory graph is co-constituted, not assemblage-mobile\n" "$welded" "$total"
    exit 3
  fi
  echo "  posture: EXTERIOR — most streams are detachable / re-plugged across assemblages (relations of exteriority intact)"
  exit 0
fi

if [ "${1:-}" = --compact ]; then
  run_compact "mesh-health" "mesh-health 2>&1 | sed -n '3p'"
  run_compact "mesh-therm" "mesh-therm 2>&1"
  run_compact "mesh-presence" "mesh-presence 2>&1 | head -1"
  run_compact "mesh-wifiscan" "mesh-wifiscan 2>&1 | head -1"
  run_compact "mesh-audio" "mesh-audio 2>&1"
  run_compact "mesh-card" "grep -E '^(hostname|tailscale-ip|as-of)' ~/.mesh-card 2>/dev/null | tr '\n' ' ' || echo '(no card)'"
else
  echo ""
  echo "--- health ---"
  mesh-health 2>&1 || true
  echo ""
  echo "--- thermal ---"
  mesh-therm --verbose 2>&1 || true
  echo ""
  echo "--- BLE presence ---"
  mesh-presence 2>&1 || true
  echo ""
  echo "--- WiFi proximity ---"
  mesh-wifiscan 2>&1 || true
  echo ""
  echo "--- audio hardware ---"
  mesh-audio --verbose 2>&1 || true
  echo ""
  echo "--- card ---"
  head -10 ~/.mesh-card 2>/dev/null || echo "(no card)"
fi

echo ""
echo "=== end sensorium ==="
