#!/usr/bin/env bash
# mesh-sensorium — unified one-shot snapshot of everything this node perceives.
# smoke-test: --test checks required tools are in PATH
#
# Runs each sensor tool and compiles a timestamped report to stdout.
# Each tool is best-effort (skips silently if missing or fails).
#
#   mesh-sensorium            full sensorium snapshot (LIVE — probes every sense, heavy)
#   mesh-sensorium --cached   ALL senses, categorized roll-call read from the reflexes' CACHED
#                             state artifacts (CHEAP — no live probe, no phone SSH; each value
#                             carries its age + STALE marker). The live-vs-cached split mirrors
#                             mesh-situation: --cached is for a refresh loop / pane; the full
#                             (default) live dump is for the mind. Answers "what can the mesh
#                             perceive right now?" — every sense it has, honestly aged.
#   mesh-sensorium --compact  one-line per sensor (live, the 5 node-local sensors)
#   mesh-sensorium --balance  RR efficiency<->resiliency report over the cached roll-call (read-only)
#   mesh-sensorium --impasse  RR insight / reframe-at-impasse: cached percept-categories that are FED
#                             (a live stream) yet UNRESOLVED (value UNKNOWN/?) — the frame can't carve
#                             them, a candidate for RESTRUCTURING (vs a dead producer). read-only.
#   mesh-sensorium --exteriority  relations-of-exteriority report: per cached stream, how many OTHER
#                             tools re-plug it (consumer fan-out) — detachable(EXTERIOR) vs welded /
#                             expressive-only(INTERIORITY). read-only. (Deleuze&Guattari/DeLanda)
#   mesh-sensorium --amplification  joint-failure report: remove substrate classes in PAIRS and price what
#                             goes blind — A(i,j)=L(i,j)/(L(i)+L(j)). SUPERADDITIVE = the joint loss beats
#                             the sum of the parts (substitutability breaks); PURE-JOINT = costs nothing
#                             apart, blinds together — invisible to any single-point rank. read-only.
#   mesh-sensorium --articulation  double-articulation report: per PAIRED sense, check its CONTENT plane
#                             (the producer's reading LOG) against its EXPRESSION plane (the .state sign
#                             consumers act on) — MUTE = content fresh but the sign went stale (a live
#                             sense the sensorium is blind to). read-only. (Deleuze&Guattari/Hjelmslev)
#   mesh-sensorium --footholds  ecological-rationality/orientation report: per reading LOG, does the
#                             emitted SIGN still move with the categorical SITUATION it abbreviates?
#                             DEAD-HOLD = sign frozen while the situation moves (and it moved before);
#                             FALSE-HOLD = sign makes more distinctions than its inputs offer. read-only.
#   mesh-sensorium --test     smoke test (exit 0 if PATH has mesh-tools)
#
# ── RELEVANCE REALIZATION: efficiency<->resiliency opponent processing (live review 2026-07-28) ──────
# LITERATURE (cross-domain transfer to a distributed sensor mesh). Vervaeke's relevance realization
# solves the frame problem not with a fixed relevance function but with OPPONENT PROCESSING — antagonist
# drives held in dynamic tension, self-organized to the agent's own economy. The GENERAL opposition that
# subsumes the rest (exploration<->exploitation, generality<->specialization, focusing<->diversifying) is
# EFFICIENCY <-> RESILIENCY: "resiliency entails increased variation while efficiency involves selection,
# a culling of unnecessary structures" — a cognitive system must stay efficient WHILE remaining resilient.
#   refs: Vervaeke, Lillicrap & Richards, "Relevance realization and the emerging framework in cognitive
#   science", J. Logic & Computation 22(1):79-99 (2012, sites.utoronto.ca/jvcourses/jolc.pdf); re-affirmed
#   as self-organizing/bioeconomic in Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing relevance
#   realization", Frontiers in Psychology 15:1362658 (2024, PMC11231436).
# WHERE WE'D BEEN: precision-weighting (mesh-precision), the large-world frame limit (mesh-precision
# frame_coverage), goal-relativity (mesh-novelty), and the SPECIFIC explore<->exploit opponent balance
# (mesh-needs). NOT embodied: the GENERAL efficiency<->resiliency opposition read over the SENSORIUM.
# THE TRANSFER: a sensorium where each percept-category rests on ONE cached stream is maximally EFFICIENT
# but BRITTLE — that one stream dying blinds the whole category (a single point of sensory failure);
# a category backed by SEVERAL independent live streams is RESILIENT (redundant variation) but costs more
# to keep warm. --balance measures this balance so the mesh can watch it, exactly as mesh-needs makes the
# explore<->exploit balance visible. Read-only; artifact: docs/reviews/rr-efficiency-resiliency-sensorium-2026-07-28.md
#
# ── RELEVANCE REALIZATION: insight / reframe-at-impasse (--impasse — live review 2026-07-28) ──────────
# LITERATURE (Vervaeke, cross-domain transfer). RR has two sides: FRAME-TRACKING (weight what's relevant
# WITHIN the current frame) and FRAME-BREAKING (realize the frame ITSELF is wrong and RESTRUCTURE it) —
# "the ability to reframe how we find things relevant is sometimes experienced as the 'aha' moment called
# INSIGHT", and its precondition is an IMPASSE: the current frame persistently FAILS to resolve.
#   refs: Andersen, Miller & Vervaeke, "Predictive processing and relevance realization: exploring
#   convergent solutions to the frame problem", Phenomenology and the Cognitive Sciences (2025,
#   doi:10.1007/s11097-022-09850-6); Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing relevance
#   realization", Frontiers in Psychology 15:1362658 (2024, PMC11231436).
# WHERE WE'D BEEN: mesh-precision names the STATIC large-world frame limit (frame_coverage — a signal
# outside the catalog can't be weighted); mesh-sense-evolve GROWS the frame on a blind timed ROTATION;
# --balance/--exteriority read the frame's shape. NONE detect the DYNAMIC impasse — a percept the frame
# is actively FED but cannot carve — which is exactly the insight-trigger (reframe HERE, not on a timer).
# THE TRANSFER: a cached sense that is FRESH (its producer ran, mtime moving) yet whose value is UNKNOWN/?
# is the frame fed-but-uncarving — an IMPASSE. This is the mesh's own HOLLOW SENSE (CLAUDE.md: "a reachable
# phone whose driver returns empty is a hollow sense, cron-green while its artifact goes stale") seen from
# the RR side: mtime-liveness (reflex-health) is BLIND to it (mtime is fresh!), and it is DISTINCT from a
# STALE producer (dead → restart, a liveness fix) — an impasse wants RESTRUCTURING (a new/cross sense),
# not a restart. --impasse surfaces it as the reframe-candidate; read-only, feeds the mind / sense-evolve.
#
# ── ASSEMBLAGE: relations of exteriority (--exteriority — live review 2026-07-28) ─────────────────────
# LITERATURE (Deleuze & Guattari, cross-domain transfer to a distributed sensor mesh). The DEFINING
# formal property of an assemblage (agencement) is that its components stand in RELATIONS OF EXTERIORITY:
# a part "may be detached from it and plugged into a different assemblage in which its interactions are
# different" — its identity is NOT constituted by its current links. The contrary is a relation of
# INTERIORITY, where a part is co-constituted by the whole and cannot be removed without both collapsing.
#   refs: Deleuze & Guattari, A Thousand Plateaus (1980); Manuel DeLanda, "A New Philosophy of Society:
#   Assemblage Theory and Social Complexity" (2006) — relations of exteriority vs interiority, the two
#   axes (material<->expressive · territorializing<->deterritorializing); DeLanda, "Assemblage Theory"
#   (Edinburgh UP 2016). Re-surveyed via grokipedia.com/page/Assemblage_(philosophy) + Parrhesia 29
#   (Ball, parrhesiajournal.org/parrhesia29/parrhesia29_ball.pdf), current 2025-26.
# WHERE WE'D BEEN: deterritorialization coefficient (mesh-novelty --territory), inclusive disjunction
# (mesh-situation), order-word redundancy (board), smooth/striated (mesh). And --balance above measures
# resiliency = streams-per-category (redundancy of PRODUCERS feeding ONE fusion). NOT embodied: the
# CONSUMER-side dual — how detachable each stream is, i.e. how many OTHER assemblages re-plug it.
# THE TRANSFER: --balance looks INTO the sensorium (producers per percept); relations of exteriority look
# OUT (consumers per stream). A cached stream re-plugged by many tools is EXTERIOR — detachable, robust to
# any one consumer dying, assemblage-mobile. A stream re-plugged by exactly ONE is a relation of
# INTERIORITY (WELDED): a 1:1 coupling that LOOKS modular but is co-constituted — either end dying orphans
# the other. A stream NO other tool reads is EXPRESSIVE-ONLY: a pure sign that drives nothing downstream.
# GRANULARITY CAVEAT (honest, the --balance-caveat spirit): this measures coupling of the CACHED ARTIFACT
# at FILE granularity — a consumer that re-invokes the SENSE LIVE (calls mesh-<x>) instead of reading its
# cache is deliberately NOT counted. That is not a blind spot, it is the point: a cache classed
# EXPRESSIVE-ONLY whose sense is nonetheless live-consumed is the interiority finding sharpened — the
# cached component is welded to the pane while functional consumers PAY to re-probe live (the efficiency
# loss --balance's RR frame cares about). Report-only, no verdict touched; artifact:
# docs/reviews/deleuze-assemblage-relations-of-exteriority-sensorium-2026-07-28.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
NL='
'
run(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -5 | tr '\n' ';')"
  else
    echo "[$label] (unavailable)"
  fi
}
run_compact(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -1)"
  else
    echo "[$label] (unavailable)"
  fi
}

if [ "${1:-}" = --test ]; then
  # Gate the --cached roll-call's perimeter field by DRIVING it against a crafted state artifact,
  # not by grepping this source. Two cases, because one alone asserts nothing: the ALERT case pins
  # which FIELD is read (f2=out is CALM there, so a sub-axis read renders a false all-clear and this
  # fails), the CALM control pins that we still track the verdict down (a hardcoded "ALERT" passes
  # case 1 and fails here). Pure file reads under a throwaway HOME — no organ needed, so no exit 2.
  _s="$(mktemp -d)"; mkdir -p "$_s/.mesh"
  _roll(){ printf '%s\t%s\n' "$(date -u +%FT%TZ)" "$1" > "$_s/.mesh/.perimeter.state"
           HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^SITUATION .*perimeter=\([A-Za-z-]*\).*/\1/p'; }
  # out=CALM net=ALERT phy=CALM verdict=ALERT — the unknown-MAC-on-LAN shape that hid behind cut -f2
  _got="$(_roll "$(printf 'CALM\tALERT\tCALM\tALERT')")"
  [ "$_got" = ALERT ] || { echo "smoke-test: FAIL (perimeter verdict ALERT rendered as '${_got:-<empty>}' — reading the wrong field of .perimeter.state?)"; rm -rf "$_s"; exit 1; }
  _got="$(_roll "$(printf 'CALM\tCALM\tCALM\tCALM')")"
  [ "$_got" = CALM ] || { echo "smoke-test: FAIL (perimeter verdict CALM rendered as '${_got:-<empty>}')"; rm -rf "$_s"; exit 1; }

  # Gate the BODY motion= field the same way: drive the roll-call against a real .body-motion-state
  # in each of the WRITER's two shapes (mesh-body-motion:580 live / :128 offline). One case alone
  # asserts nothing -- the OFFLINE case pins that we extract the TAG (a whole-record read renders
  # `|OFFLINE||||` and fails here), the live control pins that the [body-xxx] path still wins (a
  # blanket `cut -f2` that dropped the regex would print `[body-still]` and pass case 1 alone).
  _bm(){ printf '%s\n' "$1" > "$_s/.mesh/.body-motion-state"
         HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^BODY  *motion=\([^ ]*\).*/\1/p'; }
  _got="$(_bm '|OFFLINE||||')"
  [ "$_got" = OFFLINE ] || { echo "smoke-test: FAIL (offline body-motion rendered as '${_got:-<empty>}', want OFFLINE — reading the raw record instead of the writer's field-2 tag?)"; rm -rf "$_s"; exit 1; }
  _got="$(_bm '4213|[body-still]|0|[body-still]|1800|3')"
  [ "$_got" = '[body-still]' ] || { echo "smoke-test: FAIL (live body-motion rendered as '${_got:-<empty>}', want [body-still])"; rm -rf "$_s"; exit 1; }
  echo "  ok: BODY motion= renders the tag for both writer shapes (live + OFFLINE pipe schema)"
  rm -rf "$_s"

  # RR efficiency<->resiliency (--balance): drive the REAL --balance black-box against crafted cached
  # state under a throwaway HOME (a fresh file = a LIVE stream, absent = a dead one). Three fixtures pin
  # the three verdict branches so no single hardcoded verdict passes: BLIND (nothing cached → exit 4),
  # BRITTLE (one live stream per category → exit 3), balanced (multi-stream categories filled → exit 0).
  # Falsify: flip the `brittle*2 >= cats` threshold or drop the live/dead counting → a branch goes RED.
  _b="$(mktemp -d)"; mkdir -p "$_b/.mesh"
  _bal(){ HOME="$_b" bash "$0" --balance 2>/dev/null; }   # prints report, exits with the posture code
  _fresh(){ printf 'x\n' > "$_b/.mesh/$1"; }              # a live cached stream (mtime = now)
  # (1) BLIND — empty .mesh: every category renders all-(—), zero live → BLIND-SPOTS, exit 4.
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: BLIND-SPOTS' && [ "$_rc" -eq 4 ]; } \
    || { echo "smoke-test: FAIL (--balance on an empty roll-call must be BLIND-SPOTS/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  # (2) BRITTLE — exactly ONE live stream per category (each category depth 1 → single-source).
  _fresh .body-motion-state; _fresh .room-sense.state; _fresh presence.log
  _fresh .household.state;   _fresh .situation.state;  _fresh .interruptibility.state; _fresh .hw-health.state
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: BRITTLE' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--balance with one live stream/category must be BRITTLE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  # (3) balanced — fill the multi-field categories to depth>=2 so <half are single-source → exit 0.
  _fresh .light-state; _fresh .body-power-state             # BODY -> 3/4
  _fresh .activity-tempo.state; _fresh .ambient-clock.state # ROOM -> 3/6
  _fresh home-state.log                                     # HOUSEHOLD -> 2/3
  _fresh .perimeter.state                                   # SITUATION -> 2/3
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: balanced' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--balance with redundant streams must be balanced/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  echo "  ok: --balance efficiency<->resiliency posture tracks stream depth (BLIND/BRITTLE/balanced)"
  rm -rf "$_b"

  # RR insight (--impasse): drive the REAL --impasse black-box against crafted cached state under a
  # throwaway HOME. Three fixtures pin the load-bearing distinction — a LIVE field with an UNRESOLVED
  # value is an IMPASSE (reframe), a live field with a determinate value is FRAMED, and a STALE (dead)
  # unresolved field is NOT an impasse (liveness, not reframe). Falsify: dropping the `?` alternative
  # from the impasse regex, or counting stale as live, turns a branch RED.
  _i="$(mktemp -d)"; mkdir -p "$_i/.mesh"
  _imp(){ HOME="$_i" bash "$0" --impasse 2>/dev/null; }
  # (1) FRAMED — one live field with a DETERMINATE value: interruptibility=AVAILABLE (fresh) → exit 0.
  printf 'AVAILABLE\n' > "$_i/.mesh/.interruptibility.state"
  _out="$(_imp)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: FRAMED' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--impasse with a resolved live field must be FRAMED/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_i"; exit 1; }
  # (2) IMPASSE — same field but EMPTY content (fresh mtime): renders `? (fresh)` = fed-but-uncarving → exit 3.
  : > "$_i/.mesh/.interruptibility.state"
  _out="$(_imp)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: IMPASSE' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--impasse on a live-but-empty field must be IMPASSE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_i"; exit 1; }
  # (3) NOT-impasse when STALE — an empty field with an OLD mtime is a DEAD producer (liveness), not an
  # impasse; it must NOT be IMPASSE (the distinction the whole read exists to make).
  touch -d '2 hours ago' "$_i/.mesh/.interruptibility.state"
  _out="$(_imp)"; _rc=$?
  if printf '%s' "$_out" | grep -q 'posture: IMPASSE' || [ "$_rc" -eq 3 ]; then
    echo "smoke-test: FAIL (--impasse must NOT flag a STALE/dead field as impasse, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_i"; exit 1
  fi
  echo "  ok: --impasse separates fed-but-uncarving (IMPASSE) from resolved (FRAMED) and dead (STALE)"
  rm -rf "$_i"

  # ASSEMBLAGE relations of exteriority (--exteriority): drive the REAL black-box against a CRAFTED
  # toolset (MESH_BINDIR) with KNOWN reference counts, so the classify bands are asserted on data, not
  # on the live graph. Three fake tools reference .perimeter.state (=> refs 3 EXTERIOR); two reference
  # .interruptibility.state (=> refs 2 WELDED); the branch pins on the posture + exit code.
  _e="$(mktemp -d)"; mkdir -p "$_e/bin"
  _tool(){ printf '#!/bin/sh\n# refs: %s\n' "$2" > "$_e/bin/$1"; }   # $1=name $2=stream-basename it reads
  _ext(){ MESH_BINDIR="$_e/bin" HOME="$_e" bash "$0" --exteriority 2>/dev/null; }
  # (1) EXPRESSIVE-DEADENDS — empty toolset: every stream refs 0 => not-produced => exit 4.
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: EXPRESSIVE-DEADENDS' && [ "$_rc" -eq 4 ]; } \
    || { echo "smoke-test: FAIL (--exteriority empty toolset must be EXPRESSIVE-DEADENDS/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  _allstreams=".body-motion-state .light-state .body-power-state .phone-prox.state \
.room-sense.state .activity-tempo.state .ambient-clock.state .audio-path-state .room-context.state .media-scene.state \
presence.log .household.state home-state.log .op-home.state \
.perimeter.state .situation.state .watchtower-state.reach .interruptibility.state .hw-health.state"
  _consumer(){ { printf '#!/bin/sh\n'; for s in $_allstreams; do printf '# reads %s\n' "$s"; done; } > "$_e/bin/$1"; }
  # (2) EXTERIOR — 3 tools each referencing EVERY stream => refs=3 for all => none welded/expr => exit0.
  _consumer mesh-consumer1; _consumer mesh-consumer2; _consumer mesh-consumer3
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: EXTERIOR' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--exteriority all-streams-refs3 must be EXTERIOR/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # (3) INTERIORITY-PINNED — drop to exactly TWO referencing tools => every stream refs 2 => all WELDED.
  rm -f "$_e/bin/mesh-consumer3"
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: INTERIORITY-PINNED' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--exteriority all-streams-refs2 must be INTERIORITY-PINNED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # (4) per-line classify on a fresh fixture: .perimeter.state read by 3 tools => EXTERIOR; .op-home.state
  #     read by 1 => EXPRESSIVE-ONLY. (posture is EXPRESSIVE-DEADENDS here; only the per-line bands asserted.)
  rm -f "$_e"/bin/*
  for i in 1 2 3; do echo '# reads .perimeter.state' > "$_e/bin/mesh-per$i"; done
  echo '# reads .op-home.state' > "$_e/bin/mesh-solo"
  _out="$(_ext)"
  { printf '%s' "$_out" | grep -qE '\.perimeter\.state +refs 3 +EXTERIOR'; } \
    || { echo "smoke-test: FAIL (--exteriority per-line: .perimeter.state at refs 3 must read EXTERIOR)"; printf '%s\n' "$_out" | grep -E 'perimeter|op-home'; rm -rf "$_e"; exit 1; }
  { printf '%s' "$_out" | grep -qE '\.op-home\.state +refs 1 +EXPRESSIVE-ONLY'; } \
    || { echo "smoke-test: FAIL (--exteriority per-line: .op-home.state at refs 1 must read EXPRESSIVE-ONLY)"; printf '%s\n' "$_out" | grep -E 'op-home'; rm -rf "$_e"; exit 1; }
  echo "  ok: --exteriority relations-of-exteriority bands track consumer fan-out (EXTERIOR/WELDED/EXPRESSIVE/exit)"
  rm -rf "$_e"

  # ANTIFRAGILITY degeneracy vs redundancy (--degeneracy): drive the REAL black-box against CRAFTED
  # roll-call files (the readable-$2 path), so the substrate-class map is asserted on data. Three fixtures
  # pin the load-bearing claim — a depth>=2 category on ONE class is a MONOCULTURE (redundancy overstates
  # resiliency, exit 3), the SAME depth on >=2 classes is truly-degenerate (exit 0), and the per-line degen
  # count reflects the MAP. Falsify: collapse the map (all fields -> one class) and the degenerate fixture
  # goes RED; explode it (every field its own class) and the monoculture fixture goes RED. Both map
  # directions are therefore gated — the classifier must actually discriminate, not just always-flag.
  _d="$(mktemp -d)"
  _deg(){ bash "$0" --degeneracy "$1" 2>/dev/null; }   # prints report, exits with the posture code
  # (1) MONOCULTURE — BODY depth 3 all 'phone' class => REDUNDANCY-OVERESTIMATE, exit 3.
  printf 'BODY       motion=STILL (fresh) · light=DARK (fresh) · power=OK (recent)\n' > "$_d/mono"
  _out="$(_deg "$_d/mono")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: REDUNDANCY-OVERESTIMATE' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -qE 'BODY .*degen 1 \[phone\].*MONOCULTURE'; } \
    || { echo "smoke-test: FAIL (--degeneracy: a depth>=2 single-substrate category must read MONOCULTURE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_d"; exit 1; }
  # (2) degenerate — every depth>=2 category spans >=2 classes => posture degenerate, exit 0. This is the
  # falsifier for a COLLAPSED map: if motion/room mapped to the same class, BODY would read degen 1 and flag.
  printf 'BODY       motion=STILL (fresh) · room=CALM (recent)\nSITUATION  situation=WATCH (aging) · watchtower=reach-ok (aging)\n' > "$_d/degen"
  _out="$(_deg "$_d/degen")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: degenerate' && [ "$_rc" -eq 0 ] \
    && printf '%s' "$_out" | grep -qE 'BODY .*degen 2 \[phone audio\].*FSS 1\.00'; } \
    || { echo "smoke-test: FAIL (--degeneracy: a depth>=2 cross-substrate category must read degen>=2/FSS1.00 and NOT flag, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_d"; exit 1; }
  echo "  ok: --degeneracy separates a common-mode MONOCULTURE from a truly-degenerate (structurally-distinct) category"
  rm -rf "$_d"

  # ANTIFRAGILITY joint-failure amplification (--amplification): drive the REAL black-box against CRAFTED
  # rolls. The load-bearing claim is that the axis actually REMOVES TWO substrate classes AT ONCE and
  # prices what dies — NOT that it re-adds single-point losses. Three fixtures pin the three branches, and
  # the arithmetic is pinned at an exact ratio, not just a flag. Falsify (both seen RED before landing):
  # replace the joint loss lossOf(i,j) with the sum L(i)+L(j) — the pure-joint and superadditive fixtures
  # both go RED (they are the whole content of the axis); collapse the substrate map to one class — the
  # pure-joint fixture goes RED (no cross-class pair left to remove). The additive fixture is the falsifier
  # for an ALWAYS-FLAG detector: two categories on two distinct classes cost exactly the sum, and a
  # superadditive verdict there would be a lie.
  _a="$(mktemp -d)"
  _amp(){ bash "$0" --amplification "$1" 2>/dev/null; }
  # (1) PURE-JOINT — ONE category on two classes: neither class alone blinds anything (L=0+0), together
  # they blind it. Unbounded amplification, and INVISIBLE to the single-point ranking above it. This is
  # exactly the category --degeneracy retires as "truly-degenerate / common-mode resilient".
  printf 'ROOM       room=CALM (fresh) · context=SOLO (recent)\n' > "$_a/pure"
  _out="$(_amp "$_a/pure")"; _rc=$?
  { [ "$_rc" -eq 3 ] && printf '%s' "$_out" | grep -qE 'audio \+ phone|phone \+ audio' \
    && printf '%s' "$_out" | grep -q 'amp UNBOUNDED' && printf '%s' "$_out" | grep -q 'PURE-JOINT — costs NOTHING apart, blinds ROOM' \
    && printf '%s' "$_out" | grep -q 'posture: SUPERADDITIVE' && printf '%s' "$_out" | grep -q '(1 PURE-JOINT'; } \
    || { echo "smoke-test: FAIL (--amplification: a category whose two classes each cost 0 alone must read PURE-JOINT/UNBOUNDED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  # (2) SUPERADDITIVE with a NON-ZERO base — pins the RATIO, not just the flag: phone alone blinds BODY
  # (L=1), audio alone blinds nothing (L=0), together they blind BODY *and* ROOM (2) => exactly 2.00x.
  printf 'BODY       motion=STILL (fresh)\nROOM       room=CALM (fresh) · context=SOLO (recent)\n' > "$_a/super"
  _out="$(_amp "$_a/super")"; _rc=$?
  { [ "$_rc" -eq 3 ] && printf '%s' "$_out" | grep -qE 'amp 2\.00x .*SUPERADDITIVE .*breaks on ROOM' \
    && printf '%s' "$_out" | grep -q '(0 PURE-JOINT'; } \
    || { echo "smoke-test: FAIL (--amplification: L 1+0 -> 2 must read exactly amp 2.00x SUPERADDITIVE/exit3, got rc=$_rc: $(printf '%s' "$_out" | grep -E 'amp ' | tr '\n' ';'))"; rm -rf "$_a"; exit 1; }
  # (3) ADDITIVE — two categories, one distinct class each: the joint loss IS the sum (2 = 1+1), so amp is
  # exactly 1.00x and the posture must NOT flag. Falsifier for an always-superadditive detector.
  printf 'BODY       motion=STILL (fresh)\nPRESENCE   n=3 (recent)\n' > "$_a/add"
  _out="$(_amp "$_a/add")"; _rc=$?
  { [ "$_rc" -eq 0 ] && printf '%s' "$_out" | grep -q 'posture: additive' \
    && printf '%s' "$_out" | grep -qE 'amp 1\.00x .*additive' \
    && ! printf '%s' "$_out" | grep -q 'SUPERADDITIVE'; } \
    || { echo "smoke-test: FAIL (--amplification: substitutable classes (joint loss == sum) must read additive/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  echo "  ok: --amplification prices JOINT substrate failure (pure-joint unbounded · 2.00x superadditive · additive) — not the sum of single points"
  rm -rf "$_a"

  # ASSEMBLAGE double articulation (--articulation): drive the REAL black-box against crafted CONTENT(log)
  # + EXPRESSION(state) artifacts with KNOWN mtimes under a throwaway HOME. The load-bearing claim is that
  # the TWO planes are checked against EACH OTHER, not the clock alone: a fresh LOG with a STALE STATE is
  # MUTE (a live sense whose sign the sensorium dropped), while the REVERSE (fresh state, stale log) is the
  # honest liveness-touch shape and must NOT fault. Falsify: drop the state-staleness check and MUTE
  # collapses into ARTICULATED (case 1 RED); flag the sign-ahead direction and case 3 goes RED. A single
  # hardcoded verdict can pass at most one of the three cases.
  _a="$(mktemp -d)"; mkdir -p "$_a/.mesh"
  _art(){ HOME="$_a" bash "$0" --articulation 2>/dev/null; }
  _fresh_a(){ printf 'x\n' > "$_a/.mesh/$1"; }                                   # mtime = now
  _stale_a(){ printf 'x\n' > "$_a/.mesh/$1"; touch -d '1 hour ago' "$_a/.mesh/$1"; }  # age 3600s > ttl 2100s
  # (1) MUTE — content plane (log) fresh, expression plane (state) stale => DECOUPLED/exit3.
  _fresh_a body-power.log; _stale_a .body-power-state
  _out="$(_art)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: DECOUPLED' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -qE 'body-power .*MUTE'; } \
    || { echo "smoke-test: FAIL (--articulation fresh-log/stale-state must read MUTE/DECOUPLED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  # (2) coupled — BOTH planes fresh => ARTICULATED/exit0 (the falsifier for an always-DECOUPLED verdict).
  _fresh_a body-power.log; _fresh_a .body-power-state
  _out="$(_art)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: coupled' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--articulation both-planes-fresh must read coupled/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  # (3) SIGN-AHEAD must NOT fault — fresh state, STALE log is the honest change-gated liveness-touch shape.
  _fresh_a .body-power-state; _stale_a body-power.log
  _out="$(_art)"; _rc=$?
  if printf '%s' "$_out" | grep -q 'posture: DECOUPLED' || [ "$_rc" -eq 3 ]; then
    echo "smoke-test: FAIL (--articulation must NOT fault the fresh-state/stale-log liveness-touch shape as MUTE, got rc=$_rc)"; rm -rf "$_a"; exit 1
  fi
  echo "  ok: --articulation checks content(log) vs expression(state) planes — MUTE only when live content leads a stale sign"
  rm -rf "$_a"

  # ORIENTATION footholds (--footholds): drive the REAL black box against crafted reading LOGS under a
  # throwaway HOME. The load-bearing claim is a RELATION between two counts on the same record — the sign's
  # transitions vs the situation's — so every case below moves exactly ONE of them and every clause of the
  # verdict is asserted ALONE. Falsify: drop the hist>=1 clause and (5) goes RED; drop the MINMOVE/still-world
  # guard and (4) goes RED; test FALSE-HOLD against the categorical count instead of the all-axis count and
  # (6) goes RED; let a unit-suffixed number read as categorical and (6) goes RED as DEAD-HOLD. No single
  # hardcoded verdict passes more than one case. Window is the DEFAULT 60 (env unset for hermeticity —
  # a test child must not inherit node-local tuning), so fixtures carry 60 history + 60 window lines.
  _f_new(){ _f="$(mktemp -d)"; mkdir -p "$_f/.mesh"; }
  _f_hist(){ local n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] %s k1=q k2=y\n' "$1"; fi
      n=$((n+1)); done; }                                  # $1=BBB -> responsive history; AAA -> flat history
  _fh(){ env -u MESH_FOOTHOLD_WINDOW HOME="$_f" bash "$0" --footholds 2>/dev/null; }
  _f_case(){ # $1=label $2=want-posture $3=want-rc $4=want-class
    _out="$(_fh)"; _rc=$?
    { printf '%s' "$_out" | grep -q "posture: $2" && [ "$_rc" -eq "$3" ] \
      && { [ -z "$4" ] || printf '%s' "$_out" | grep -qE "t\.log +$4"; }; } \
      || { echo "smoke-test: FAIL (--footholds $1: want posture=$2 rc=$3 class=$4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_f"; exit 1; }
    rm -rf "$_f"; }
  # (1) DEAD-HOLD — sign frozen across the window while the categorical situation moves, and the sign DID
  #     move in the history before it. The whole point of the mode.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] AAA k1=q k2=y\n'; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "frozen sign under a moving situation" "DISORIENTED" 3 "DEAD-HOLD"
  # (2) HOLDING — same moving situation, but the sign moves with it (falsifier for an always-DEAD verdict).
  _f_new; { _f_hist BBB; _f_hist BBB; } > "$_f/.mesh/t.log"
  _f_case "sign moving with the situation" "oriented" 0 "HOLDING"
  # (3) FALSE-HOLD — situation frozen (categorical AND numeric), sign alternates: more distinctions than
  #     the inputs offer.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] BBB k1=p k2=x\n'; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "sign carving finer than its inputs" "CHATTERING" 4 "FALSE-HOLD"
  # (3b) NUMERIC-DRIVEN SIGN — categorical axes frozen, a NUMERIC axis moving every line, sign alternating.
  #     This is the only case where the conservative (categorical) and liberal (all-axis) motion counts
  #     DISAGREE, so it is the sole guard on FALSE-HOLD being tested against the liberal one. It is
  #     light.log's real shape (verdict rides `mean=`/`stddev=`, only categorical field is `via=direct`):
  #     the sign is tracking a recorded input, not inventing distinctions. Without this case the
  #     st>ct mutant survives all seven others — measured, not assumed.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x mean=%s.1\n' "$n"; else printf '[t] BBB k1=p k2=x mean=%s.7\n' "$n"; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "sign tracking a numeric axis the log records" "oriented" 0 "HOLDING"
  # (4) QUIET — a STILL world legitimately gets a still sign; must NOT read DEAD-HOLD.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do printf '[t] AAA k1=p k2=x\n'; n=$((n+1)); done; } > "$_f/.mesh/t.log"
  _f_case "still world, still sign" "oriented" 0 "QUIET"
  # (5) FLAT-NO-BASELINE — same frozen sign + moving situation as (1), but the record NEVER shows this sign
  #     moving: unauditable, must be NAMED and must NOT be faulted as DEAD-HOLD.
  _f_new; { _f_hist AAA; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] AAA k1=q k2=y\n'; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "frozen sign with no responsive history" "oriented" 0 "FLAT-NO-BASELINE"
  # (6) UNIT-SUFFIXED NUMERIC is not a categorical move — a wattage/temperature drifting every line under a
  #     frozen sign is package-power's shape, not a dead hold; and the sign is not chattering either.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do printf '[t] AAA k1=p k2=x core=%s.%sW\n' "$n" "$n"; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "unit-suffixed numeric drift under a frozen sign" "oriented" 0 "QUIET"
  # (7) NO ASSESSABLE HOLDS — never faked as 'oriented'; honest n/a exits 2.
  _f_new; printf 'phone unreachable — not an alarm\n' > "$_f/.mesh/t.log"
  _f_case "no log records a sign with >=2 categorical axes" "NO ASSESSABLE HOLDS" 2 ""
  echo "  ok: --footholds separates a DEAD hold from a moving one, a chattering sign from a numeric-driven one, and never fakes an unauditable or absent record as oriented"

  for t in mesh-health mesh-therm mesh-presence mesh-wifiscan mesh-audio; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing $t)"; exit 1; }
    "$t" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL ($t --test failed)"; exit 1; }
  done
  echo "smoke-test: ok"; exit 0
fi

case "${1:-}" in --cached|--roll|--balance|--exteriority|--degeneracy|--amplification|--articulation|--footholds) : ;; *) echo "=== mesh-sensorium @ $ts — $HOST ===" ;; esac

if [ "${1:-}" = --cached ] || [ "${1:-}" = --roll ]; then
  # ALL senses the mesh has, read from the reflexes' CACHED artifacts (cheap — no live probe).
  # Each value is aged from its file mtime; STALE if older than the sense's refresh budget so an
  # unreachable/dead sense never reads as a fresh all-clear (honest-degraded, the fusion rule).
  M="$HOME/.mesh"; now="$(date +%s)"
  agei(){ local f="$1" m d; [ -e "$f" ] || { printf '—'; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -lt 90 ];   then printf '%ss' "$d"
    elif [ "$d" -lt 5400 ]; then printf '%sm' "$((d/60))"
    else printf '%sh' "$((d/3600))"; fi; }
  mark(){ # $1=file $2=value $3=stale-limit-sec(default 1800) -> "value (BUCKET)"
    # COARSE freshness bucket, NOT an exact (Ns)/(Nm): an exact age re-renders every frame and re-wakes
    # the consuming top-pane mind on pure chrome (operator 2026-06-25: top-pane liveness is the block's
    # own job — bucket the age, keep the pane full but byte-stable between refreshes). Buckets span
    # minutes so the line doesn't churn, yet still carry signal: fresh(<2m)/recent(<10m)/aging(<limit)
    # + the honest STALE past the per-sense limit (the only state that matters for the fusion rule).
    local f="$1" v="$2" lim="${3:-1800}" m d
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -gt "$lim" ]; then printf '%s (STALE)' "$v"
    elif [ "$d" -lt 120 ];    then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ];    then printf '%s (recent)' "$v"
    else                           printf '%s (aging)' "$v"; fi; }
  fst(){ head -1 "$1" 2>/dev/null; }   # first line of a state file
  bodymark(){ # $1=state-file $2=value $3=stale-limit $4=companion-reflex-log
    # Like mark(), but for the phone-BODY senses: when the state goes STALE, peek the companion reflex
    # LOG. If that log is still FRESH (the cron is firing) and its last line says the organ is
    # unreachable, this is an OFFLINE ORGAN (honest n/a — the phone body is gone, operator's hands),
    # NOT a dead reflex to fix. A frozen state + a frozen log = a genuinely dead reflex → keep STALE.
    # Distinguishing the two stops the consuming mind chasing a non-bug (the failed-vs-empty rule).
    local f="$1" v="$2" lim="${3:-1800}" log="$4" m d lm
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if [ "$d" -gt "$lim" ]; then
      if [ -n "$log" ] && [ -e "$log" ]; then
        lm="$(stat -c %Y "$log" 2>/dev/null || echo 0)"
        if [ "$((now-lm))" -le "$lim" ] && tail -1 "$log" 2>/dev/null | grep -qi 'unreachable'; then
          printf 'OFFLINE(phone)'; return
        fi
      fi
      printf '%s (STALE)' "$v"; return
    fi
    if   [ "$d" -lt 120 ]; then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ]; then printf '%s (recent)' "$v"
    else                        printf '%s (aging)' "$v"; fi; }

  echo "=== mesh sensorium (CACHED state — the mind runs the live probes) @ $ts ==="
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle (same bug
  # fixed for situation/perimeter, 1135d62). These senses are autowired at /30 (max gap 30m=1800s):
  # body-motion :07/37, light :09/39, body-power :05/35, activity-tempo :08/38, ambient-clock :06/36
  # → use 2100s(35m) = cadence + grace. room-sense is /15 (max gap 900s) → 1200s(20m). phone-prox
  # declares 19-59/45 which fires at :19 ONLY (45-step from 19 exceeds 59) → real stride 3600s →
  # 4200s(70m); a 3000s TTL false-STALEd it every hour from :09 to :19. Phone offline still
  # surfaces: an unreachable sense ages PAST cadence+grace and goes honest-STALE.
  bm="$(fst "$M/.body-motion-state" | grep -oE '\[body-[a-z]+\]' | head -1)"
  # Fallback for the honest-degraded OFFLINE marker (mesh-body-motion writes it when the phone is
  # unreachable): the [body-xxx] regex never matches it, so bm blanks to empty -> bodymark's '?'
  # default, reading as an ambiguous/broken sense while the sibling light=/power= fields on the SAME
  # line show their marker verbatim. Take the TAG (field 2 of the writer's 6-field pipe schema,
  # mesh-body-motion:580 `steps|tag|hyst|pending|dwell_s|changes_24h`), which is where the writer
  # puts OFFLINE (:128 `|OFFLINE||||`, steps deliberately empty = unknown, not a fabricated 0).
  # The 2026-07-05 fallback took the first WHITESPACE token, matching the writer's then-current
  # pipe-less `OFFLINE <ts>` line; the 2026-07-10 fidelity fix moved to the pipe schema and no
  # consumer followed, so an offline phone has rendered as the raw record `motion=|OFFLINE||||`
  # since. Anchor on the writer's printf, never on a token position that outlives its format.
  [ -n "$bm" ] || bm="$(fst "$M/.body-motion-state" | cut -d'|' -f2)"
  # last resort: a state in NEITHER shape still renders its own first token, never a silent blank
  [ -n "$bm" ] || bm="$(fst "$M/.body-motion-state" | awk '{print $1}')"
  echo "BODY       motion=$(bodymark "$M/.body-motion-state" "$bm" 2100 "$M/body-motion.log") · light=$(bodymark "$M/.light-state" "$(fst "$M/.light-state")" 2100 "$M/light.log") · power=$(bodymark "$M/.body-power-state" "$(fst "$M/.body-power-state")" 2100 "$M/body-power.log") · prox=$(mark "$M/.phone-prox.state" "$(fst "$M/.phone-prox.state" | cut -d'|' -f1)" 4200)"
  # ROOM / activity
  # audio-path is /10 (mesh-audio-path fusion: emit×mic — is our own playback audible?) → 2100s TTL
  echo "ROOM       room=$(mark "$M/.room-sense.state" "$(fst "$M/.room-sense.state")" 1200) · tempo=$(mark "$M/.activity-tempo.state" "$(fst "$M/.activity-tempo.state")" 2100) · ambient=$(mark "$M/.ambient-clock.state" "$(fst "$M/.ambient-clock.state")" 2100) · audio-path=$(mark "$M/.audio-path-state" "$(fst "$M/.audio-path-state" | cut -d'|' -f1)" 2100) · context=$(mark "$M/.room-context.state" "$(fst "$M/.room-context.state")" 600) · media=$(mark "$M/.media-scene.state" "$(fst "$M/.media-scene.state")" 600)"
  # PRESENCE / who is physically around
  pl="$(tail -1 "$M/presence.log" 2>/dev/null)"
  pn="$(printf '%s\n' "$pl" | sed -nE 's/.*(n=[0-9]+).*/\1/p')"
  ptop="$(printf '%s\n' "$pl" | sed -nE 's/.*devices=\[[^|]*\|[^|]*\|([^|]*)\|.*/\1/p' | sed -E 's/ *-[0-9]+ *$//')"
  # Person-vs-appliance attribution split (mesh-presence enrichment 2026-06-21): a raw count/top can't
  # tell "a human is here" from "appliances are on" (top=[TV] is the trap, live). mesh-presence now emits
  # attribution=personal:P,appliance:A,ambiguous:M as a trailing field on the SAME presence.log line as
  # n/devices — single-source, so the split is ALWAYS the same scan as the n/top shown (no cross-file
  # guard, no intermittent omission). Older lines lacking the field → sed prints nothing → suffix omitted
  # (honest: shows no split until the next --log run writes one).
  pattr="$(printf '%s\n' "$pl" | sed -nE 's/.*attribution=personal:([0-9]+),appliance:([0-9]+),ambiguous:([0-9]+).*/ pers:\1 appl:\2 amb:\3/p')"
  arr="$(grep -iE ':: *\[(arrived|left)' "$M/chat.log" 2>/dev/null | tail -1 | sed -E 's/.*:: *//' | cut -c1-40)"
  echo "PRESENCE   $(mark "$M/presence.log" "${pn:-n=?} top=${ptop:-?}${pattr}" 900)${arr:+ · last: $arr}"
  # HOUSEHOLD / operator
  hs="$(tail -1 "$M/home-state.log" 2>/dev/null | sed -E 's/^\[home-state\] ([A-Z_]+):.*/\1/')"
  echo "HOUSEHOLD  mode=$(mark "$M/.household.state" "$(fst "$M/.household.state")" 1200) · home-state=$(mark "$M/home-state.log" "$hs" 1200) · operator-home=$(mark "$M/.op-home.state" "$(fst "$M/.op-home.state")" 1200)"
  # SITUATION / SECURITY (fused) + watchtower (the eye on the net)
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle:
  # mesh-{perimeter,situation} --edge are autowired at /45 (max gap 45m=2700s), so 2400s(40m)
  # showed STALE in the 40-45m window of EVERY cycle. 3000s(50m) clears the cadence + grace,
  # while a genuinely missed cycle (age climbs past 50m toward the 90m double-gap) still trips.
  # mesh-perimeter:587 writes: ts \t out \t net \t phy \t VERDICT — the fused verdict is f5, and f2 is
  # only the OUTSIDE sub-axis. cut -f2 rendered perimeter=CALM on a live ALERT whenever the alert came
  # from NETWORK or PHYSICAL (an unknown MAC on the LAN is exactly that shape) — the sub-axis it named
  # was genuinely calm, so the pane read as an all-clear with no staleness tell. mesh-situation:227
  # reads the same file positionally and got ALERT; the two panes disagreed. Take the verdict (f5).
  per="$(fst "$M/.perimeter.state" | cut -f5)"
  wtr="$([ "$(fst "$M/.watchtower-state.reach")" = 1 ] && echo reach-ok || echo reach-BLIND)"
  echo "SITUATION  situation=$(mark "$M/.situation.state" "$(fst "$M/.situation.state")" 3000) · perimeter=$(mark "$M/.perimeter.state" "$per" 3000) · watchtower=$(mark "$M/.watchtower-state.reach" "$wtr" 3600)"
  # COORDINATION — when may the mesh speak/alert? (mesh-interruptibility fuses kbd+screen+room+
  # ambient+tempo+light+operator-awake+time → band). /12 cadence (max gap 12m=720s) → 1500s(25m) clears
  # cadence + grace; a dead reflex ages past it to honest STALE so the mind never trusts a stale band.
  echo "COORDINATION interruptibility=$(mark "$M/.interruptibility.state" "$(fst "$M/.interruptibility.state")" 1500)"
  # NODE (this body's own hardware sense)
  echo "NODE       $(mark "$M/.hw-health.state" "$(fst "$M/.hw-health.state")" 7200)"
  # the senses with NO persistent cache — listed so the roll-call is honestly COMPLETE; the mind
  # probes these live (mesh-sensorium with no flag, or the individual tool).
  echo "LIVE-ONLY (mind probes, no cache): body-context · tamper · operator-state · wifi-motion · location · lan-health · lan-newdevice · find · keypresence · audio-active · jack · netrate · irq-rate · proc-churn · wake"
  exit 0
fi

if [ "${1:-}" = --balance ]; then
  # RR efficiency<->resiliency report (see the header). READ-ONLY: reuses --cached's roll-call (the ONE
  # source of truth for what's live) and counts, per percept-category, how many cached streams are LIVE
  # (fresh/recent/aging) vs dead (STALE / absent(—) / OFFLINE). DEPTH = live streams; depth 1 = single
  # point of sensory failure (over-efficient/brittle), depth 0 = blind, depth>=2 = resilient (redundant).
  # GRANULARITY CAVEAT (honest, in the mesh-precision frame_coverage spirit): depth is measured at
  # CACHED-STREAM granularity — a category rendered as one fused field (e.g. PRESENCE fuses many organs
  # into presence.log) reads single-source even so, because at the sensorium level that ONE stream dying
  # blinds the category regardless of how many organs feed it. That is a real brittleness, not an artifact.
  echo "=== sensorium efficiency<->resiliency balance @ $ts — $HOST ==="
  echo "(RR opponent processing — Vervaeke 2012/2024: resiliency=redundant independent live streams,"
  echo " efficiency=fewest streams per percept. depth=LIVE cached streams; 1=single point of failure, 0=blind.)"
  roll="$(bash "$0" --cached 2>/dev/null)"
  printf '%s\n' "$roll" | awk '
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1
      l=$0; live =gsub(/\((fresh|recent|aging)\)/,"",l)
      s=$0; stale=gsub(/\(STALE\)/,"",s)
      d=$0; dash =gsub(/\(—\)/,"",d)
      # count ONLY the offline MARKER bodymark emits (OFFLINE(phone)), never the value-word "OFFLINE"
      # (motion=OFFLINE / power=OFFLINE are live values carrying their own freshness bucket — the bucket
      # above already counted them; matching bare OFFLINE double-counted them into total, the /6-not-/4 bug)
      o=$0; off  =gsub(/OFFLINE\(phone\)/,"",o)
      total=live+stale+dash+off
      if(total==0) next
      cats++
      tag=""
      if(live==0){ tag=" ⚠ BLIND (no live stream)"; blind++ }
      else if(live==1){ tag=" ⚠ single-source (single point of sensory failure)"; single++ }
      else resilient++
      printf "  %-12s depth %d/%d live%s\n", cat, live, total, tag
    }
    END{
      brittle=blind+single
      printf "\n  streams: %d resilient (depth>=2) · %d single-source · %d blind  (of %d categories)\n", \
        resilient, single, blind, cats
      if(cats==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      if(blind>0){
        printf "  posture: BLIND-SPOTS — %d categor%s have no live stream; resiliency has failed there, not just thinned\n", blind, (blind==1?"y":"ies")
        exit 4
      }
      if(brittle*2 >= cats){
        printf "  posture: BRITTLE (efficiency-pinned) — %d of %d categories rest on a single stream; the opponent balance has collapsed toward efficiency, one death from a blind spot\n", brittle, cats
        exit 3
      }
      print  "  posture: balanced — most categories carry redundant live streams (resiliency intact)"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --impasse ]; then
  # RR insight / reframe-at-impasse report (see the header). READ-ONLY: reuses --cached's roll-call (the
  # ONE source of truth for what's live) and flags each percept-category with a field that is LIVE
  # (fresh/recent/aging bucket) yet UNRESOLVED (value renders as `?` or UNKNOWN — mark() writes `?` when a
  # fresh producer's state is empty/unparseable). That is the frame FED-but-uncarving = an IMPASSE, the
  # insight-trigger: restructure HERE (a new/cross sense, mesh-sense-evolve) rather than restart. It is
  # DISTINCT from a STALE field (dead producer → liveness, --balance/reflex-health) and from an ABSENT one.
  # GRANULARITY CAVEAT (honest, the frame_coverage/--balance spirit): impasse is detected only where the
  # WHOLE field value is unresolved (`name=? (fresh)`); a compound field (e.g. PRESENCE `n=? top=?`) whose
  # `?` sits mid-value is a conservative MISS, never a false alarm — this under-reports, it never over-reports.
  echo "=== sensorium insight: reframe-at-impasse @ $ts — $HOST ==="
  echo "(RR frame-BREAKING — Vervaeke: insight = reframe at an IMPASSE. impasse = a percept the frame is"
  echo " FED (live stream) but cannot CARVE (value UNKNOWN/?) — the hollow sense seen from the RR side,"
  echo " a candidate for RESTRUCTURING, not a restart. A dead/stale producer is liveness, not impasse.)"
  roll="$(bash "$0" --cached 2>/dev/null)"
  printf '%s\n' "$roll" | awk '
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1
      l=$0; live=gsub(/\((fresh|recent|aging)\)/,"",l)
      # a LIVE field whose entire value is unresolved (`?` or UNKNOWN) right before its freshness bucket
      c=$0; imp=gsub(/=[[:space:]]*(\?|[Uu][Nn][Kk][Nn][Oo][Ww][Nn])[[:space:]]*\((fresh|recent|aging)\)/,"",c)
      livetotal+=live
      if(imp>0){ impcats++; imptotal+=imp; printf "  %-12s IMPASSE — %d live field(s) fed but unresolved (reframe candidate)\n", cat, imp }
      else if(live>0) printf "  %-12s framed — %d live field(s) resolve\n", cat, live
    }
    END{
      if(livetotal==0){ print "\n  posture: NO LIVE STREAMS — nothing to frame (liveness is --balance/reflex-health'"'"'s concern, not impasse)"; exit 0 }
      printf "\n  %d live field(s); %d in IMPASSE across %d categor%s\n", livetotal, imptotal+0, impcats+0, (impcats==1?"y":"ies")
      if(imptotal>0){ print "  posture: IMPASSE — the frame is fed but cannot carve these percepts; the insight-trigger. Restructure (mesh-sense-evolve: enrich/cross/new-sense targeting the category above), do not restart."; exit 3 }
      print "  posture: FRAMED — every live percept resolves to a determinate value (no reframe warranted)"; exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --exteriority ]; then
  # ASSEMBLAGE relations of exteriority (see the header). READ-ONLY. The CONSUMER-side dual of --balance:
  # for each CACHED stream the roll-call knows, count how many DISTINCT tools re-plug it (reference its
  # basename), so a stream's DETACHABILITY is visible. BINDIR overridable (default ~/.local/bin) so the
  # --test can drive a crafted toolset. AGGREGATOR EXCLUSION: mesh-sensorium + mesh-dash read ~every
  # stream (this tool and the pane) — counting them would mask every stream as EXTERIOR, so both are
  # named-excluded (honest, stated in the header, not a fuzzy heuristic).
  BINDIR="${MESH_BINDIR:-$HOME/.local/bin}"
  # canonical cached-stream set — the SAME file-backed senses the --cached roll-call renders (kept in
  # step with that block: BODY/ROOM/PRESENCE/HOUSEHOLD/SITUATION/COORDINATION/NODE).
  STREAMS=".body-motion-state .light-state .body-power-state .phone-prox.state \
.room-sense.state .activity-tempo.state .ambient-clock.state .audio-path-state .room-context.state .media-scene.state \
presence.log .household.state home-state.log .op-home.state \
.perimeter.state .situation.state .watchtower-state.reach .interruptibility.state .hw-health.state"
  echo "=== sensorium relations-of-exteriority @ $ts — $HOST ==="
  echo "(Deleuze&Guattari/DeLanda: an assemblage's parts are DETACHABLE — re-pluggable into other"
  echo " assemblages. refs=distinct OTHER tools re-plugging the cached stream (aggregators sensorium/dash"
  echo " excluded). >=2 EXTERIOR(detachable) · 1 WELDED(interiority,1:1) · 0 EXPRESSIVE-ONLY(drives nothing).)"
  ext=0; welded=0; expr=0; np=0; total=0
  for s in $STREAMS; do
    # distinct tool FILES (mesh-*) referencing the basename as a FIXED string, minus the two aggregators.
    # producer is counted among refs (it writes its own file); the classify below subtracts it implicitly
    # by banding on the CONSUMER floor: refs>=3 => producer+>=2 consumers, ==2 => producer+1, ==1 =>
    # producer only, ==0 => no tool references it (external/absent producer).
    n=$(grep -lF "$s" "$BINDIR"/mesh-* 2>/dev/null | sed 's#.*/##' | grep -vxE 'mesh-sensorium|mesh-dash' | sort -u | wc -l)
    total=$((total+1))
    if   [ "$n" -ge 3 ]; then cls="EXTERIOR"; tag=""; ext=$((ext+1))
    elif [ "$n" -eq 2 ]; then cls="WELDED"; tag=" ⚠ interiority (1:1 coupling — modular-looking, co-constituted)"; welded=$((welded+1))
    elif [ "$n" -eq 1 ]; then cls="EXPRESSIVE-ONLY"; tag=" ⚠ drives nothing downstream (cache re-plugged by no other tool)"; expr=$((expr+1))
    else cls="NOT-PRODUCED"; tag=" ⚠ no tool references it — pane reads a stream with no visible producer"; np=$((np+1)); fi
    printf "  %-24s refs %-2d %-14s%s\n" "$s" "$n" "$cls" "$tag"
  done
  echo ""
  printf "  streams: %d exterior (detachable) · %d welded · %d expressive-only · %d not-produced  (of %d)\n" \
    "$ext" "$welded" "$expr" "${np:-0}" "$total"
  if [ "$total" -eq 0 ]; then echo "  posture: NO STREAMS"; exit 2; fi
  if [ "${np:-0}" -gt 0 ] || [ "$expr" -gt 0 ]; then
    printf "  posture: EXPRESSIVE-DEADENDS — %d stream(s) re-plugged by no other tool; the sensorium caches signs that drive nothing (or have no producer)\n" "$((expr+${np:-0}))"
    exit 4
  fi
  if [ $((welded*2)) -ge "$total" ]; then
    printf "  posture: INTERIORITY-PINNED — %d of %d streams are welded 1:1; the sensory graph is co-constituted, not assemblage-mobile\n" "$welded" "$total"
    exit 3
  fi
  echo "  posture: EXTERIOR — most streams are detachable / re-plugged across assemblages (relations of exteriority intact)"
  exit 0
fi

# ── SUBSTRATE-CLASS MAP — ONE definition, TWO readers (--degeneracy · --amplification) ───────────────
# Grounded in each field's VERIFIED producer inputs, not guessed. The common-mode is the dependency whose
# single death degrades every stream in the class together:
#   phone  = phone reachable over SSH/termux: motion,light,power,prox (direct phone sensors) + tempo
#            (mesh-activity-tempo fuses tamper+body-motion+light — phone axes; "axes-dark" == phone down)
#            + context (mesh-body-context = body-motion + ambient light — phone)
#   audio  = mic + STT/audio stack: room,ambient,audio-path,media
#   ble    = BLE radio scan: presence (n/top — one fused stream anyway)
#   net    = network reachability: watchtower
#   derived= on-node fusion of OTHER categories (shares its upstreams' fate): mode,home-state,
#            operator-home,situation,perimeter,interruptibility
#   node   = on-node procfs/hw: HW
# An unmapped field falls to its OWN class ("other:<name>") — conservative: it can only ADD degeneracy,
# never manufacture a false monoculture.
# It lives HERE, above both readers, because a second copy would rot out of agreement with the first and
# each axis would then be measuring a different mesh (a rule asserted at one call site is not asserted).
SUBSTRATE_CLASS_MAP="motion=phone light=phone power=phone prox=phone tempo=phone context=phone
room=audio ambient=audio audio-path=audio media=audio
n=ble top=ble
watchtower=net
mode=derived home-state=derived operator-home=derived situation=derived perimeter=derived interruptibility=derived
HW=node"

if [ "${1:-}" = --degeneracy ]; then
  # ── ANTIFRAGILITY: DEGENERACY vs REDUNDANCY (--degeneracy — live review 2026-07-31) ─────────────────
  # LITERATURE (cross-domain transfer to a distributed sensor mesh). Redundancy = the SAME function by
  # IDENTICAL elements; DEGENERACY = the same function by STRUCTURALLY DIFFERENT elements (Edelman & Gally,
  # "Degeneracy and complexity in biological systems", PNAS 98:13763-68, 2001). The distinction is the
  # whole game under CORRELATED / common-mode failure: Hassan & Dey, "Degeneracy-Aware Functional and
  # Algorithmic Resilience in Virtualized 6G Networks Under Correlated Failures" (arXiv:2605.03035, 2026)
  # show "redundancy counts alone OVERESTIMATE resilience because replicas share platforms, software
  # stacks, and dependencies — a single disruption invalidates several apparent backups at once", and give
  # the Functional Substitution Score FSS(f)=fraction of realization PAIRS that are structurally distinct.
  # WHERE WE'D BEEN: --balance already reads efficiency<->resiliency, calling a percept-category with
  # depth>=2 LIVE streams "resilient (redundant)". NOT embodied: whether those >=2 streams are
  # structurally DISTINCT (degenerate — survive a common-mode event) or a MONOCULTURE (all riding the ONE
  # substrate, so one death takes them together). BODY reads depth 3 (motion+light+power) — "resilient" —
  # yet all three ride the ONE phone over the ONE SSH transport (memory: mesh-home-eyes-loss-usb-webcam-
  # wedge, note3 adb SIGABRT): one phone-unreachable event blinds the whole "resilient" category at once.
  # THE TRANSFER: group each category's LIVE streams into COMMON-MODE CLASSES by the failure-carrying
  # substrate they share, then report DEGENERACY = number of distinct classes (vs --balance's raw depth =
  # redundancy) and FSS = cross-class pairs / all pairs. depth>=2 but 1 class => MONOCULTURE: --balance's
  # "resilient" is an overestimate. Report-only; artifact: docs/reviews/antifragility-degeneracy-vs-
  # redundancy-mesh-sensorium-2026-07-31.md
  # (Substrate-class map: the shared SUBSTRATE_CLASS_MAP defined above this block.)
  echo "=== sensorium degeneracy vs redundancy @ $ts — $HOST ==="
  echo "(Edelman&Gally PNAS 2001 / Hassan&Dey arXiv:2605.03035 2026: redundancy=identical replicas,"
  echo " degeneracy=structurally-distinct pathways. depth=LIVE streams (redundancy, --balance's axis);"
  echo " degen=distinct common-mode classes; FSS=cross-class pairs/all pairs. depth>=2 & degen 1=MONOCULTURE.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  printf '%s\n' "$roll" | awk -v map="$SUBSTRATE_CLASS_MAP" '
    BEGIN{ _n=split(map,_m," "); for(_i=1;_i<=_n;_i++){ split(_m[_i],_kv,"="); c[_kv[1]]=_kv[2] } }
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1; line=$0; sub(/^[A-Za-z]+[[:space:]]+/,"",line)
      depth=0; delete cls_here; ncls=0; classes=""
      s=line
      while (match(s, /[A-Za-z][A-Za-z_-]*=[^()]*\((fresh|recent|aging)\)/)) {
        tok=substr(s,RSTART,RLENGTH); eq=index(tok,"="); name=substr(tok,1,eq-1)
        k=(name in c)? c[name] : ("other:" name)
        depth++
        if(!(k in cls_here)){ cls_here[k]=1; ncls++; classes=(classes==""?k:classes" "k) }
        cls_count[k]++
        s=substr(s, RSTART+RLENGTH)
      }
      if(depth==0) next
      cats++
      # FSS = 1 - sum(m_i*(m_i-1)) / (depth*(depth-1)); m_i = streams in class i (over classes seen HERE)
      pairs=depth*(depth-1); same=0
      for(k in cls_here){ m=cls_count[k]; same+=m*(m-1) }
      # (cls_count is global; recompute per-category counts locally instead)
      fss=(pairs>0)?(1-(same/pairs)):0
      tag=""
      if(depth>=2 && ncls==1){ tag=sprintf(" ⚠ MONOCULTURE (%s) — --balance calls this resilient; one common-mode event blinds all %d", classes, depth); mono++ }
      else if(depth>=2 && ncls>=2){ resilient++ }
      printf "  %-12s depth %d  degen %d [%s]  FSS %.2f%s\n", cat, depth, ncls, classes, fss, tag
      delete cls_count
    }
    END{
      if(cats==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      printf "\n  categories: %d truly-degenerate (depth>=2, >=2 classes) · %d MONOCULTURE (depth>=2, 1 class)  (of %d)\n", resilient+0, mono+0, cats
      if(mono>0){
        printf "  posture: REDUNDANCY-OVERESTIMATE — %d categor%s read redundant (depth>=2) but rest on a SINGLE substrate; --balance overstates their resiliency (Hassan&Dey 2026)\n", mono, (mono==1?"y":"ies")
        exit 3
      }
      print "  posture: degenerate — redundant categories draw on structurally-distinct substrates (common-mode resilient)"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --amplification ]; then
  # ── ANTIFRAGILITY: THE NONLINEARITY OF JOINT FAILURE (--amplification — live review 2026-08-04) ─────
  # LITERATURE (cross-domain transfer to a distributed sensor mesh). Fialkowski, Havlin & Thurner,
  # "Catastrophic disruption cascades driven by the nonlinearity of systemic risk", arXiv:2607.20068
  # (submitted 22 Jul 2026, econ.GN) — building on the single-node ESRI of Diem, Borsos, Reisch, Kertesz &
  # Thurner, "Quantifying firm-level economic systemic risk from nation-wide supply networks", Sci Rep
  # 12:7719 (2022, arXiv:2104.07260). Their result, verbatim from the abstract: "the systemic risk
  # contributions of COMBINATIONS of firm failures can be drastically larger than the sum of the damage
  # caused by the firms individually ... combined failures can produce systemic risk amplifications of up
  # to a factor of 257. However, only a tiny fraction of 0.14% of pairs exhibit a more than 4-fold
  # amplification ... The origin of these amplifications is a BREAKDOWN OF THE SUBSTITUTABILITY of
  # defaulted suppliers." Two things make this load-bearing and not just "cascades are bad": (a) the
  # amplification is superadditive and extremely heavy-tailed — nearly every pair is harmless and a
  # handful are catastrophic; (b) an individually-harmless node is NOT safe, so a ranking of SINGLE-point
  # impacts — however careful — cannot find the dangerous combinations at all. Exactly the situations the
  # paper names (a disaster, a war) are the ones that take several nodes at once.
  # WHERE WE HAD BEEN: --balance counts LIVE streams per percept-category (redundancy). --degeneracy (above)
  # asks whether those streams are structurally DISTINCT, and calls a category with >=2 substrate classes
  # "truly-degenerate (common-mode resilient)". BOTH are SINGLE-failure readings: --degeneracy retires a
  # category from worry the moment TWO classes back it, because no ONE class death blinds it. NOTHING in
  # the mesh ever removes TWO substrates at once and prices what dies. That is precisely the blind spot the
  # 2026 result names: our own live roll has ROOM at degen 2 [audio phone] — "resilient", and it IS
  # resilient to either death alone — yet phone-down + audio-down together blinds the whole room percept,
  # and every derived sense that fuses it. Neither single-point loss predicts that; the joint one is not
  # the sum, it is the substitutability running out.
  # THE TRANSFER: treat each substrate class as a "firm" and define the systemic loss of a failure set S as
  #   L(S) = number of percept-categories BLINDED (every live stream in the category belongs to a class in
  #          S — the category has no surviving pathway).
  # Then, for each PAIR of classes, the amplification A(i,j) = L({i,j}) / (L(i) + L(j)) — the paper's ratio,
  # joint damage over the sum of individual damages. A == 1: substitutable/additive. A > 1: SUPERADDITIVE.
  # L(i)=L(j)=0 while L({i,j})>0: a PURE-JOINT pair, amplification unbounded — costs nothing apart, blinds
  # categories together, and is INVISIBLE to every single-point ranking the mesh already runs. Report-only.
  # HONEST BOUNDARIES (the point, not omissions): (1) the loss UNIT is percept-categories blinded — coarse,
  # and deliberately so, because it needs nothing beyond the roll --degeneracy already parses; a finer unit
  # (consumers downstream, which --exteriority already counts per stream) would sharpen the ratio and is the
  # obvious next refinement, HELD until the fan-out map is worth wiring in. (2) blinding is FIRST-ORDER: a
  # `derived` category whose upstream classes all died still reads live here as long as its own .state file
  # is fresh, so this UNDERSTATES the cascade — the true amplification is at least what is printed, never
  # less. Naming the direction of the error is the whole obligation; a second-order cascade needs a VERIFIED
  # per-derived-sense upstream map, not a guessed one. (3) A is a ratio of small integers on a 6-category
  # sensorium — the paper's 257x lives on a national supply network; do not quote a magnitude here as if it
  # were theirs. Artifact: docs/reviews/antifragility-joint-failure-amplification-mesh-sensorium-2026-08-04.md
  echo "=== sensorium joint-failure amplification @ $ts — $HOST ==="
  echo "(Fialkowski, Havlin & Thurner arXiv:2607.20068 2026: the systemic damage of COMBINED failures can"
  echo " far exceed the SUM of the individual damages — substitutability breaks down — and the pairs that"
  echo " do it are invisible to any single-point ranking. L(S)=percept-categories blinded when the substrate"
  echo " classes S die together; A(i,j)=L(i,j)/(L(i)+L(j)). A>1 superadditive; L(i)=L(j)=0 & L(i,j)>0 PURE-JOINT.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  printf '%s\n' "$roll" | awk -v map="$SUBSTRATE_CLASS_MAP" '
    BEGIN{ _n=split(map,_m," "); for(_i=1;_i<=_n;_i++){ split(_m[_i],_kv,"="); c[_kv[1]]=_kv[2] } }
    # a category is BLINDED by the failure set S iff every class it rests on is in S (no surviving pathway)
    function blinded(i,S,   n,a,j){ n=split(catcls[i],a," "); for(j=1;j<=n;j++){ if(index(S," " a[j] " ")==0) return 0 } return 1 }
    function lossOf(S,   i,t){ t=0; for(i=1;i<=ncat;i++) if(blinded(i,S)) t++; return t }
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1; line=$0; sub(/^[A-Za-z]+[[:space:]]+/,"",line)
      s=line; depth=0; cls=""; delete here
      while (match(s, /[A-Za-z][A-Za-z_-]*=[^()]*\((fresh|recent|aging)\)/)) {
        tok=substr(s,RSTART,RLENGTH); eq=index(tok,"="); name=substr(tok,1,eq-1)
        k=(name in c)? c[name] : ("other:" name)
        depth++
        if(!(k in here)){ here[k]=1; cls=cls " " k
          if(!(k in allcls)){ allcls[k]=1; nc++; clsname[nc]=k } }
        s=substr(s, RSTART+RLENGTH)
      }
      if(depth==0) next
      ncat++; catname[ncat]=cat; catcls[ncat]=cls
    }
    END{
      if(ncat==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      print ""
      print "  single-point loss — what the mesh can already see (one substrate class dies alone):"
      for(i=1;i<=nc;i++){
        L[i]=lossOf(" " clsname[i] " ")
        vic=""
        for(k=1;k<=ncat;k++) if(blinded(k," " clsname[i] " ")) vic=vic " " catname[k]
        printf "    %-10s blinds %d categor%s%s\n", clsname[i], L[i], (L[i]==1?"y":"ies"), (vic==""?"":" —" vic)
      }
      print ""
      print "  joint-failure amplification — class PAIRS, worst first (only pairs that blind something):"
      np=0
      for(i=1;i<=nc;i++) for(j=i+1;j<=nc;j++){
        S=" " clsname[i] " " clsname[j] " "
        lij=lossOf(S)
        if(lij==0) continue
        base=L[i]+L[j]
        only=""
        for(k=1;k<=ncat;k++) if(blinded(k,S) && !blinded(k," " clsname[i] " ") && !blinded(k," " clsname[j] " ")) only=only " " catname[k]
        np++
        amp=(base>0)? lij/base : -1          # -1 encodes unbounded (pure-joint): nothing dies apart
        pamp[np]=amp; ppair[np]=clsname[i] " + " clsname[j]
        pnum[np]=sprintf("L %d + %d -> %d", L[i], L[j], lij); ponly[np]=only
        if(amp<0){ pure++; super++ } else if(amp>1){ super++ }
      }
      if(np==0){ print "    (no pair of substrate classes blinds any category)" }
      # sort by amplification desc; unbounded (-1) first
      for(i=1;i<=np;i++) for(j=i+1;j<=np;j++){
        ai=(pamp[i]<0)?1e18:pamp[i]; aj=(pamp[j]<0)?1e18:pamp[j]
        if(aj>ai){ t=pamp[i];pamp[i]=pamp[j];pamp[j]=t; t=ppair[i];ppair[i]=ppair[j];ppair[j]=t;
                   t=pnum[i];pnum[i]=pnum[j];pnum[j]=t; t=ponly[i];ponly[i]=ponly[j];ponly[j]=t }
      }
      for(i=1;i<=np;i++){
        if(pamp[i]<0)
          printf "    %-22s %-18s amp UNBOUNDED  ⚠ PURE-JOINT — costs NOTHING apart, blinds%s together (no single-point rank can see this pair)\n", ppair[i], pnum[i], ponly[i]
        else if(pamp[i]>1)
          printf "    %-22s %-18s amp %.2fx      ⚠ SUPERADDITIVE — joint loss exceeds the sum; substitutability breaks on%s\n", ppair[i], pnum[i], pamp[i], ponly[i]
        else
          printf "    %-22s %-18s amp %.2fx      additive (substitutable — the parts already account for the whole)\n", ppair[i], pnum[i], pamp[i]
      }
      print ""
      if(super>0){
        printf "  posture: SUPERADDITIVE — %d of %d blinding pair%s cost more together than apart (%d PURE-JOINT, invisible to single-point analysis). --degeneracy calls those categories common-mode RESILIENT: true of either death alone, false of both (Fialkowski/Havlin/Thurner 2026)\n", super, np, (np==1?"":"s"), pure+0
        exit 3
      }
      print "  posture: additive — every joint substrate failure costs exactly the sum of its parts; substitutability holds across classes"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --articulation ]; then
  # ── ASSEMBLAGE: double articulation — content plane vs expression plane (--articulation — live review 2026-07-31)
  # LITERATURE (Deleuze & Guattari, cross-domain transfer to a distributed sensor mesh). Every assemblage
  # is DOUBLY ARTICULATED (borrowed from Hjelmslev): a first articulation on the plane of CONTENT (the
  # "machinic assemblage of bodies" — matter actually coupled and formed: here, the producer's own reading
  # LOG, the record that the body coupled to the world) and a second on the plane of EXPRESSION (the
  # "collective assemblage of enunciation" — the regime of SIGNS attributed to those bodies: here, the
  # .state cache the sensorium/pane/consumers act on). D&G's load-bearing claim: the two articulations are
  # RELATIVELY INDEPENDENT and their relation is NOT CAUSAL — "there is a continual passage from one to the
  # other" only under RECIPROCAL PRESUPPOSITION; nothing guarantees a fresh sign presupposes a live content.
  #   refs: Deleuze & Guattari, A Thousand Plateaus (1980), "10,000 BC: The Geology of Morals" (double
  #   articulation, form/substance of content vs expression) + the tetravalence of the assemblage (machinic
  #   assemblage of bodies ↔ collective assemblage of enunciation), via Hjelmslev, "Prolegomena to a Theory
  #   of Language". Verified current across the Purdue Deleuze dictionary (deleuze.cla.purdue.edu) and the
  #   assemblage encyclopedia entry (2025-26). LIVE, continuously-published cross-domain transfer of double
  #   articulation INTO sensor/signal time-series: Taniguchi et al., "Nonparametric Bayesian Double
  #   Articulation Analyzer for Direct Language Acquisition from Continuous Speech Signals" (arXiv:1506.06646;
  #   IEEE TASLP 24(9), 2016) + the Kyoto Symbol Emergence Systems Group's ongoing work (2024-25,
  #   ses.ist.i.kyoto-u.ac.jp/publication). HONEST DISTINCTION: they operationalize the LINGUISTIC
  #   (Martinet/Hjelmslev) reading — unsupervised two-LAYER segmentation of the signal (letters→words) — a
  #   heavy nonparametric-Bayesian pipeline, NOT a mesh-scale analyzer; this transfers the ASSEMBLAGE reading
  #   (content-plane vs expression-plane reciprocal presupposition), which IS a cheap file-stat read.
  # WHERE WE'D BEEN: --impasse already reads the HOLLOW quadrant — a live sign (fresh mtime) whose value is
  # UNRESOLVED (`?`) — but it reads a SINGLE plane (the .state cache) against the clock. --balance /
  # --exteriority / --degeneracy ALSO read only the .state cache. NONE reads the CONTENT plane (the
  # producer's LOG) as a SEPARATE artifact and checks the two planes AGAINST EACH OTHER. --articulation is
  # the first TWO-PLANE check, and it catches exactly the quadrant --impasse cannot: a sense actively
  # WRITING content (log fresh) whose SIGN (.state) has gone stale — the value is perfectly valid (not `?`),
  # so --impasse is silent and --balance counts the stale sign as its live stream. That is the mesh's own
  # driver-races-the-cache failure (memory: mesh-mag/mesh-gyro raced the `-n 1` driver, 5 days stale, --test
  # green) seen as an articulation break: the body still couples, but the sign the mesh acts on has fallen
  # out of reciprocal presupposition with it. CALIBRATION BOUNDARY (the point, not an omission): the REVERSE
  # direction — fresh .state, stale LOG — is the HONEST liveness-touch shape (mtime=liveness, content=change-
  # gated write; CLAUDE.md), so it is reported as SIGN-AHEAD and NEVER faulted; faulting it would re-break
  # the false-STALE fix state-touch exists to prevent. Report-only; artifact:
  # docs/reviews/deleuze-double-articulation-content-expression-sensorium-2026-07-31.md
  M="$HOME/.mesh"; now="$(date +%s)"
  echo "=== sensorium double-articulation @ $ts — $HOST ==="
  echo "(Deleuze&Guattari ATP 'Geology of Morals'/Hjelmslev: an assemblage is TWO articulations —"
  echo " CONTENT (the body's read = the producer's LOG) and EXPRESSION (the sign consumers act on = the"
  echo " .state cache) — relatively INDEPENDENT, non-causal, held only in reciprocal presupposition."
  echo " MUTE = content fresh but the sign went stale: a live sense the sensorium/pane is blind to.)"
  # PAIRS: name | state-cache(EXPRESSION) | companion reading-log(CONTENT) | ttl — ttl reuses the --cached
  # staleness limits. Only senses that keep BOTH a current-value .state AND an append-only reading LOG can
  # be assessed: the two planes must be DISTINCT artifacts to check their reciprocal presupposition.
  PAIRS="body-power|.body-power-state|body-power.log|2100
light|.light-state|light.log|2100
activity-tempo|.activity-tempo.state|activity-tempo.log|2100
room-sense|.room-sense.state|room-sense.log|1200
ambient-clock|.ambient-clock.state|ambient-clock.log|2100"
  agef(){ local f="$1"; [ -e "$f" ] || { printf '%s' -1; return; }
    local m; m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; printf '%s' $((now-m)); }
  agestr(){ local d="$1"; [ "$d" -lt 0 ] && { printf '—'; return; }
    if   [ "$d" -lt 90 ];   then printf '%ss' "$d"
    elif [ "$d" -lt 5400 ]; then printf '%sm' "$((d/60))"
    else printf '%sh' "$((d/3600))"; fi; }
  mute=0; artic=0; ahead=0; dormant=0; unpaired=0; total=0
  while IFS='|' read -r name st lg ttl; do
    [ -n "$name" ] || continue
    sa="$(agef "$M/$st")"; la="$(agef "$M/$lg")"
    # present on this node only if at least ONE plane exists (a sense absent here is not a fault)
    [ "$sa" -lt 0 ] && [ "$la" -lt 0 ] && continue
    total=$((total+1))
    if [ "$sa" -lt 0 ] || [ "$la" -lt 0 ]; then
      cls="UNPAIRED"; tag=" (only one plane present — reciprocal presupposition not assessable)"; unpaired=$((unpaired+1))
    else
      sf=$([ "$sa" -le "$ttl" ] && echo 1 || echo 0)   # expression (sign) fresh?
      lf=$([ "$la" -le "$ttl" ] && echo 1 || echo 0)   # content (reading) fresh?
      if   [ "$lf" = 1 ] && [ "$sf" = 1 ]; then cls="ARTICULATED"; tag=""; artic=$((artic+1))
      elif [ "$lf" = 1 ] && [ "$sf" = 0 ]; then cls="MUTE"; tag=" ⚠ content plane LIVE (log fresh) but the SIGN is stale — a reading sense the sensorium/pane is blind to"; mute=$((mute+1))
      elif [ "$lf" = 0 ] && [ "$sf" = 1 ]; then cls="SIGN-AHEAD"; tag=" (change-gated content — the honest liveness-touch shape; NOT a fault)"; ahead=$((ahead+1))
      else cls="DORMANT"; tag=" (both planes quiet — liveness/reflex-health's concern, not articulation)"; dormant=$((dormant+1)); fi
    fi
    printf "  %-16s content=%-4s expression=%-4s  %-12s%s\n" "$name" "$(agestr "$la")" "$(agestr "$sa")" "$cls" "$tag"
  done <<EOF
$PAIRS
EOF
  echo ""
  printf "  pairs: %d articulated · %d MUTE · %d sign-ahead · %d dormant · %d unpaired  (of %d)\n" \
    "$artic" "$mute" "$ahead" "$dormant" "$unpaired" "$total"
  if [ "$total" -eq 0 ]; then echo "  posture: NO PAIRS — no sense keeps both a content log and an expression cache here"; exit 2; fi
  if [ "$mute" -gt 0 ]; then
    printf "  posture: DECOUPLED — %d sense(s) produce content the sign no longer carries; the two articulations fell out of reciprocal presupposition (the sensorium acts on a stale sign for a live sense)\n" "$mute"
    exit 3
  fi
  echo "  posture: coupled — every paired sense's sign presupposes its live content (or is honestly dormant / change-gated)"
  exit 0
fi

if [ "${1:-}" = --footholds ]; then
  # ── ECOLOGICAL RATIONALITY / ORIENTATION: the FOOTHOLD and its decay (--footholds — live review 2026-08-01)
  # LITERATURE (live 2026 result in the Vervaeke relevance-realization stream). Chiappe & Vervaeke,
  # "Ecological rationality and the philosophy of orientation", Phenomenology and the Cognitive Sciences
  # (published 2026-06-12, doi:10.1007/s11097-026-10177-9). Their claim: ecological rationality — human
  # rationality as the application of FAST-AND-FRUGAL heuristics fitted to an environment — PRESUPPOSES more
  # fundamental ORIENTATION processes it never thematizes, and Stegmaier's philosophy of orientation
  # (Philosophie der Orientierung 2008 / What is Orientation? 2019) supplies them: standpoint, horizon,
  # FOOTHOLDS, and the structuring of orientation into routines and orientation worlds. The load-bearing
  # primitive is the FOOTHOLD (Anhaltspunkt): "an ABBREVIATION of a situation where the relevant matters of
  # this situation SEEM TO CONVERGE — in this way orientation can, for the moment, NEGLECT other matters and
  # gain an overview of what is relevant" (orientation-philosophy.com glossary, Stegmaier's own gloss). And
  # relevance is defined NEGATIVELY: "the relevance is, in turn, a function of the constantly possible
  # DISORIENTATION, which is always to be avoided."
  # WHERE WE'D BEEN (RR coverage map): precision-weighting + the large-world frame limit (mesh-precision),
  # goal-relativity (mesh-novelty), the three opponent pairs — explore<->exploit (mesh-needs), efficiency<->
  # resiliency (--balance), focusing<->diversifying (mesh-novelty --tempering) — the fourth, compression<->
  # particularization (mesh-journal-watch --scope), insight/impasse (--impasse), and the interventional
  # per-sensor semantic load (mesh-home-state --semantic). ALL of those weight, balance, or ablate an INPUT.
  # NONE asks the orientation question, which is about the OUTPUT SIGN: is the abbreviation still an
  # abbreviation OF anything? A foothold is not legitimate because it is fresh, precise or widely read —
  # it is legitimate only while the matters it stands for still converge on it. That is a claim no freshness
  # or fan-out measure can make: --articulation checks the two planes' CLOCKS (content log vs .state mtime),
  # --exteriority counts consumers, --impasse catches a value that is absent (`?`). A DEAD HOLD is fresh,
  # definite, and widely read — and no longer carves. Every consumer that reads it INSTEAD of surveying is
  # neglecting the rest on the strength of a hold that holds nothing: Stegmaier's disorientation, arriving
  # silently and green.
  # THE TRANSFER (mechanical, no new sensor): a reading LOG records both planes on one line — the emitted
  # SIGN (the abbreviation: the verdict token a consumer acts on) and the k=v SUB-AXES (the matters it
  # abbreviates). Over a WINDOW of recent lines, count sign transitions against situation transitions:
  #   DEAD-HOLD   sign_tr == 0, categorical situation moved >= MINMOVE, AND the sign moved in the HISTORY
  #               before the window (so flatness is a CHANGE in the sign's behaviour, not its nature).
  #   FALSE-HOLD  sign_tr > all-axis transitions — the sign makes MORE distinctions than its own recorded
  #               inputs offer; the surplus is invented (chatter, not orientation). Information-theoretic,
  #               no tuned constant.
  #   FLAT-NO-BASELINE  frozen sign, moving situation, but the record NEVER shows the sign moving — the log
  #               cannot witness its own sign's variation, so decay is UNAUDITABLE here. Named, never faulted
  #               and never folded into "holding": an honest n/a is not a pass.
  #   QUIET       neither moved — a still world legitimately gets a still sign. Not a fault.
  # CALIBRATION (the trap this walked into, kept as the reason for the asymmetry): a numeric axis under-
  # witnesses categorical motion and over-witnesses it by jitter, so EACH POLE IS TESTED AGAINST THE AXIS
  # MEASURE THAT MAKES THAT POLE HARDER TO DECLARE — DEAD-HOLD against the CONSERVATIVE categorical count
  # (numerics dropped: a drifting float must not be counted as "the situation moved"), FALSE-HOLD against the
  # LIBERAL all-axis count (numerics kept: a sign driven by a numeric the log records must not read as
  # inventing distinctions). Dropping numerics on BOTH sides made light.log — whose only categorical field is
  # `via=direct` while its verdict rides `mean=`/`stddev=` — read FALSE-HOLD with sign_tr 74 vs cat_tr 0.
  # Units count as numeric (`4.62W`, `41.9°C`), or package-power's every-line wattage reads as a moving
  # situation under a frozen HIGH. Clock-derived keys are dropped entirely (a label that embeds the clock
  # correlates with the sun, not with the situation). >=2 categorical keys required, else UNASSESSABLE — one
  # key cannot distinguish a still situation from an unrecorded one. Report-only; artifact:
  # docs/reviews/rr-ecological-rationality-foothold-decay-sensorium-2026-08-01.md
  M="$HOME/.mesh"
  echo "=== sensorium footholds @ $ts — $HOST ==="
  echo "(Chiappe&Vervaeke 2026 / Stegmaier: a FOOTHOLD is an abbreviation of a situation where the relevant"
  echo " matters seem to CONVERGE, letting orientation neglect the rest. A hold is legitimate only while they"
  echo " still converge on it — DEAD-HOLD = sign frozen while the situation it abbreviates keeps moving.)"
  FH_DIR="$M" FH_WINDOW="${MESH_FOOTHOLD_WINDOW:-60}" python3 - <<'FHPY'
import os, re, sys, glob
D = os.environ["FH_DIR"]; W = max(8, int(os.environ.get("FH_WINDOW") or 60))
MINKEYS, MINLINES, MINMOVE, TAILBYTES = 2, 8, 3, 262144
NUM  = re.compile(r'^[<>~+-]?\d+(\.\d+)?\s*(°?[a-zA-Z%/]{0,4})$')   # 41.9°C / 4.62W / -78 are NOT categorical
KV   = re.compile(r'([A-Za-z_][A-Za-z0-9_-]*)=([^\s;,)|]+)')
SIGN = re.compile(r'\]\s+([A-Z][A-Z0-9_-]{1,})\b')                  # "[room-sense] PRESENT ..." -> PRESENT
CLK  = re.compile(r'(hour|time|clock|dwell|age|since|uptime|_s$|secs?$|ts$)', re.I)

def tail_lines(p):
    try:
        with open(p, 'rb') as f:
            f.seek(0, 2); sz = f.tell(); f.seek(max(0, sz - TAILBYTES))
            return f.read().decode('utf-8', 'replace').splitlines()
    except OSError:
        return []

def assess(path):
    rows = []
    for ln in tail_lines(path):
        m = SIGN.search(ln)
        if not m: continue
        cat = []; alla = []
        for k, v in KV.findall(ln):
            if CLK.search(k): continue
            alla.append((k, v))
            if not NUM.match(v): cat.append((k, v))
        if not cat: continue
        rows.append((m.group(1), tuple(sorted(cat)), tuple(sorted(alla))))
    if not rows: return None
    win, hist = rows[-W:], rows[:-W]
    tr = lambda s: sum(1 for a, b in zip(s, s[1:]) if a != b)
    signs = [r[0] for r in win]
    st, ct, at = tr(signs), tr([r[1] for r in win]), tr([r[2] for r in win])
    hst = tr([r[0] for r in hist])
    keys = len({k for r in win for k, _ in r[1]})
    d = dict(n=len(win), keys=keys, sign_tr=st, cat_tr=ct, all_tr=at, hist_sign_tr=hst,
             sign=signs[-1] if signs else '?')
    if len(win) < MINLINES or keys < MINKEYS:      d['v'] = 'UNASSESSABLE'
    elif st > at:                                  d['v'] = 'FALSE-HOLD'
    elif st == 0 and ct >= MINMOVE and hst >= 1:   d['v'] = 'DEAD-HOLD'
    elif st == 0 and ct >= MINMOVE:                d['v'] = 'FLAT-NO-BASELINE'
    elif st == 0:                                  d['v'] = 'QUIET'
    else:                                          d['v'] = 'HOLDING'
    return d

TAG = {
 'DEAD-HOLD':        '⚠ sign FROZEN while the situation it abbreviates kept moving — and this sign HAS moved before: consumers neglect the rest on a hold that no longer carves',
 'FALSE-HOLD':       '⚠ sign makes MORE distinctions than its own recorded inputs offer — the surplus is invented (chatter, not orientation)',
 'FLAT-NO-BASELINE': '(frozen sign, moving situation, but the record never shows this sign moving — decay is UNAUDITABLE here, not absent)',
 'QUIET':            '(still situation, still sign — a legitimate hold on a quiet world)',
 'HOLDING':          '',
}
res = []
for p in sorted(glob.glob(os.path.join(D, '*.log'))):
    a = assess(p)
    if a: res.append((os.path.basename(p), a))
skipped = sum(1 for _, a in res if a['v'] == 'UNASSESSABLE')
shown = [(n, a) for n, a in res if a['v'] != 'UNASSESSABLE']
order = {'DEAD-HOLD': 0, 'FALSE-HOLD': 1, 'FLAT-NO-BASELINE': 2, 'HOLDING': 3, 'QUIET': 4}
for n, a in sorted(shown, key=lambda x: (order[x[1]['v']], x[0])):
    print("  %-24s %-17s sign=%-14s tr sign=%-4d cat=%-4d all=%-4d hist=%-5d n=%-4d keys=%d%s"
          % (n, a['v'], a['sign'], a['sign_tr'], a['cat_tr'], a['all_tr'], a['hist_sign_tr'],
             a['n'], a['keys'], (" " + TAG[a['v']]) if TAG[a['v']] else ""))
dead = [n for n, a in shown if a['v'] == 'DEAD-HOLD']
false_ = [n for n, a in shown if a['v'] == 'FALSE-HOLD']
flat = [n for n, a in shown if a['v'] == 'FLAT-NO-BASELINE']
print("")
print("  holds: %d assessable · %d DEAD · %d FALSE · %d flat-no-baseline · %d unassessable (window=%d lines)"
      % (len(shown), len(dead), len(false_), len(flat), skipped, W))
if not shown:
    print("  posture: NO ASSESSABLE HOLDS — no reading log here records a sign together with >=2 categorical"
          " sub-axes; foothold decay cannot be measured on this node (honest n/a, not 'oriented')")
    sys.exit(2)
if dead:
    print("  posture: DISORIENTED — %d hold(s) frozen under a moving situation: %s" % (len(dead), " ".join(dead)))
    sys.exit(3)
if false_:
    print("  posture: CHATTERING — %d hold(s) carve finer than their inputs: %s" % (len(false_), " ".join(false_)))
    sys.exit(4)
print("  posture: oriented — every assessable hold still moves with the situation it abbreviates"
      + (" (%d unauditable by its own record)" % len(flat) if flat else ""))
sys.exit(0)
FHPY
  exit $?
fi

if [ "${1:-}" = --compact ]; then
  run_compact "mesh-health" "mesh-health 2>&1 | sed -n '3p'"
  run_compact "mesh-therm" "mesh-therm 2>&1"
  run_compact "mesh-presence" "mesh-presence 2>&1 | head -1"
  run_compact "mesh-wifiscan" "mesh-wifiscan 2>&1 | head -1"
  run_compact "mesh-audio" "mesh-audio 2>&1"
  run_compact "mesh-card" "grep -E '^(hostname|tailscale-ip|as-of)' ~/.mesh-card 2>/dev/null | tr '\n' ' ' || echo '(no card)'"
else
  echo ""
  echo "--- health ---"
  mesh-health 2>&1 || true
  echo ""
  echo "--- thermal ---"
  mesh-therm --verbose 2>&1 || true
  echo ""
  echo "--- BLE presence ---"
  mesh-presence 2>&1 || true
  echo ""
  echo "--- WiFi proximity ---"
  mesh-wifiscan 2>&1 || true
  echo ""
  echo "--- audio hardware ---"
  mesh-audio --verbose 2>&1 || true
  echo ""
  echo "--- card ---"
  head -10 ~/.mesh-card 2>/dev/null || echo "(no card)"
fi

echo ""
echo "=== end sensorium ==="
