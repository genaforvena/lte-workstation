#!/usr/bin/env bash
# reflex-cadence: 8,28,48 * * * *
# reflex-args: --self-prior
#   ^ ONLY the --self-prior mode is scheduled (see --reflex-args): it reads the CACHED roll-call, so
#     it raises no live probe and no phone SSH. A self-prior that is only sampled when a mind happens
#     to ask is a capability at zero adoption — the density has to be LIVED to exist. 3/h across the
#     clock reaches the 30-distinct-hour floor in ~1.5 days. Minute offsets 8/28/48 are clear of the
#     heavily-squatted */5, */10 and :17/:23/:41 phases on this node.
# mesh-sensorium — unified one-shot snapshot of everything this node perceives.
# smoke-test: --test checks required tools are in PATH
#
# Runs each sensor tool and compiles a timestamped report to stdout.
# Each tool is best-effort (skips silently if missing or fails).
#
#   mesh-sensorium            full sensorium snapshot (LIVE — probes every sense, heavy)
#   mesh-sensorium --cached   ALL senses, categorized roll-call read from the reflexes' CACHED
#                             state artifacts (CHEAP — no live probe, no phone SSH; each value
#                             carries its age + STALE marker). The live-vs-cached split mirrors
#                             mesh-situation: --cached is for a refresh loop / pane; the full
#                             (default) live dump is for the mind. Answers "what can the mesh
#                             perceive right now?" — every sense it has, honestly aged.
#   mesh-sensorium --compact  one-line per sensor (live, the 5 node-local sensors)
#   mesh-sensorium --balance  RR efficiency<->resiliency report over the cached roll-call (read-only)
#   mesh-sensorium --impasse  RR insight / reframe-at-impasse: cached percept-categories that are FED
#                             (a live stream) yet UNRESOLVED (value UNKNOWN/?) — the frame can't carve
#                             them, a candidate for RESTRUCTURING (vs a dead producer). read-only.
#   mesh-sensorium --exteriority  relations-of-exteriority report: per cached stream, how many OTHER
#                             tools re-plug it (consumer fan-out) — detachable(EXTERIOR) vs welded /
#                             expressive-only(INTERIORITY). read-only. (Deleuze&Guattari/DeLanda)
#   mesh-sensorium --amplification  joint-failure report: remove substrate classes in PAIRS and price what
#                             goes blind — A(i,j)=L(i,j)/(L(i)+L(j)). SUPERADDITIVE = the joint loss beats
#                             the sum of the parts (substitutability breaks); PURE-JOINT = costs nothing
#                             apart, blinds together — invisible to any single-point rank. read-only.
#   mesh-sensorium --damage-response  SIGNED damage-response report: build the live substrate-class <-> percept-
#                             category coupling graph and, per coupling, take the derivative of the normalized-
#                             Laplacian spectral gap under a PARTIAL weight reduction (1-beta). L>0 ANTIFRAGILE
#                             (weakening it IMPROVES the fabric), L<0 FRAGILE (a bridge), ~0 NEUTRAL. Also names
#                             components the fabric has ALREADY severed into. read-only. (Riascos et al.)
#   mesh-sensorium --articulation  double-articulation report: per PAIRED sense, check its CONTENT plane
#                             (the producer's reading LOG) against its EXPRESSION plane (the .state sign
#                             consumers act on) — MUTE = content fresh but the sign went stale (a live
#                             sense the sensorium is blind to). read-only. (Deleuze&Guattari/Hjelmslev)
#   mesh-sensorium --footholds  ecological-rationality/orientation report: per reading LOG, does the
#                             emitted SIGN still move with the categorical SITUATION it abbreviates?
#                             DEAD-HOLD = sign frozen while the situation moves (and it moved before);
#                             FALSE-HOLD = sign makes more distinctions than its inputs offer. read-only.
#   mesh-sensorium --viability  triferential relational-viability report (Lavanderos, Kybernetes 2026):
#                             per percept-category, how much of the DEPTH the other axes count survives
#                             POSITION ∧ FUNCTION ∧ SENSE, NON-compensatorily — a fresh stream reporting
#                             its own organ OFFLINE, or read by nobody, is present but not viable. read-only.
#   mesh-sensorium --self-prior  the SELF-PRIOR / body-schema mode: a learned density over this node's
#                             OWN multi-modal state, and the MARK — a pair of axis values each of which
#                             is deeply familiar and which have NEVER been observed together. Every
#                             per-axis check is silent on it by construction. Coverage (rows, hours,
#                             axes kept/dropped) prints with every verdict; below the sample floor it
#                             refuses to name a mark. exit 0 none / 2 insufficient / 3 mark(s).
#                             (Kim/Kanazawa/Kuniyoshi arXiv:2604.09673 2026 — see the section below)
#   mesh-sensorium --test     smoke test (exit 0 if PATH has mesh-tools)
#
# ── RELEVANCE REALIZATION: efficiency<->resiliency opponent processing (live review 2026-07-28) ──────
# LITERATURE (cross-domain transfer to a distributed sensor mesh). Vervaeke's relevance realization
# solves the frame problem not with a fixed relevance function but with OPPONENT PROCESSING — antagonist
# drives held in dynamic tension, self-organized to the agent's own economy. The GENERAL opposition that
# subsumes the rest (exploration<->exploitation, generality<->specialization, focusing<->diversifying) is
# EFFICIENCY <-> RESILIENCY: "resiliency entails increased variation while efficiency involves selection,
# a culling of unnecessary structures" — a cognitive system must stay efficient WHILE remaining resilient.
#   refs: Vervaeke, Lillicrap & Richards, "Relevance realization and the emerging framework in cognitive
#   science", J. Logic & Computation 22(1):79-99 (2012, sites.utoronto.ca/jvcourses/jolc.pdf); re-affirmed
#   as self-organizing/bioeconomic in Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing relevance
#   realization", Frontiers in Psychology 15:1362658 (2024, PMC11231436).
# WHERE WE'D BEEN: precision-weighting (mesh-precision), the large-world frame limit (mesh-precision
# frame_coverage), goal-relativity (mesh-novelty), and the SPECIFIC explore<->exploit opponent balance
# (mesh-needs). NOT embodied: the GENERAL efficiency<->resiliency opposition read over the SENSORIUM.
# THE TRANSFER: a sensorium where each percept-category rests on ONE cached stream is maximally EFFICIENT
# but BRITTLE — that one stream dying blinds the whole category (a single point of sensory failure);
# a category backed by SEVERAL independent live streams is RESILIENT (redundant variation) but costs more
# to keep warm. --balance measures this balance so the mesh can watch it, exactly as mesh-needs makes the
# explore<->exploit balance visible. Read-only; artifact: docs/reviews/rr-efficiency-resiliency-sensorium-2026-07-28.md
#
# ── RELEVANCE REALIZATION: insight / reframe-at-impasse (--impasse — live review 2026-07-28) ──────────
# LITERATURE (Vervaeke, cross-domain transfer). RR has two sides: FRAME-TRACKING (weight what's relevant
# WITHIN the current frame) and FRAME-BREAKING (realize the frame ITSELF is wrong and RESTRUCTURE it) —
# "the ability to reframe how we find things relevant is sometimes experienced as the 'aha' moment called
# INSIGHT", and its precondition is an IMPASSE: the current frame persistently FAILS to resolve.
#   refs: Andersen, Miller & Vervaeke, "Predictive processing and relevance realization: exploring
#   convergent solutions to the frame problem", Phenomenology and the Cognitive Sciences (2025,
#   doi:10.1007/s11097-022-09850-6); Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing relevance
#   realization", Frontiers in Psychology 15:1362658 (2024, PMC11231436).
# WHERE WE'D BEEN: mesh-precision names the STATIC large-world frame limit (frame_coverage — a signal
# outside the catalog can't be weighted); mesh-sense-evolve GROWS the frame on a blind timed ROTATION;
# --balance/--exteriority read the frame's shape. NONE detect the DYNAMIC impasse — a percept the frame
# is actively FED but cannot carve — which is exactly the insight-trigger (reframe HERE, not on a timer).
# THE TRANSFER: a cached sense that is FRESH (its producer ran, mtime moving) yet whose value is UNKNOWN/?
# is the frame fed-but-uncarving — an IMPASSE. This is the mesh's own HOLLOW SENSE (CLAUDE.md: "a reachable
# phone whose driver returns empty is a hollow sense, cron-green while its artifact goes stale") seen from
# the RR side: mtime-liveness (reflex-health) is BLIND to it (mtime is fresh!), and it is DISTINCT from a
# STALE producer (dead → restart, a liveness fix) — an impasse wants RESTRUCTURING (a new/cross sense),
# not a restart. --impasse surfaces it as the reframe-candidate; read-only, feeds the mind / sense-evolve.
#
# ── ASSEMBLAGE: relations of exteriority (--exteriority — live review 2026-07-28) ─────────────────────
# LITERATURE (Deleuze & Guattari, cross-domain transfer to a distributed sensor mesh). The DEFINING
# formal property of an assemblage (agencement) is that its components stand in RELATIONS OF EXTERIORITY:
# a part "may be detached from it and plugged into a different assemblage in which its interactions are
# different" — its identity is NOT constituted by its current links. The contrary is a relation of
# INTERIORITY, where a part is co-constituted by the whole and cannot be removed without both collapsing.
#   refs: Deleuze & Guattari, A Thousand Plateaus (1980); Manuel DeLanda, "A New Philosophy of Society:
#   Assemblage Theory and Social Complexity" (2006) — relations of exteriority vs interiority, the two
#   axes (material<->expressive · territorializing<->deterritorializing); DeLanda, "Assemblage Theory"
#   (Edinburgh UP 2016). Re-surveyed via grokipedia.com/page/Assemblage_(philosophy) + Parrhesia 29
#   (Ball, parrhesiajournal.org/parrhesia29/parrhesia29_ball.pdf), current 2025-26.
# WHERE WE'D BEEN: deterritorialization coefficient (mesh-novelty --territory), inclusive disjunction
# (mesh-situation), order-word redundancy (board), smooth/striated (mesh). And --balance above measures
# resiliency = streams-per-category (redundancy of PRODUCERS feeding ONE fusion). NOT embodied: the
# CONSUMER-side dual — how detachable each stream is, i.e. how many OTHER assemblages re-plug it.
# THE TRANSFER: --balance looks INTO the sensorium (producers per percept); relations of exteriority look
# OUT (consumers per stream). A cached stream re-plugged by many tools is EXTERIOR — detachable, robust to
# any one consumer dying, assemblage-mobile. A stream re-plugged by exactly ONE is a relation of
# INTERIORITY (WELDED): a 1:1 coupling that LOOKS modular but is co-constituted — either end dying orphans
# the other. A stream NO other tool reads is EXPRESSIVE-ONLY: a pure sign that drives nothing downstream.
# GRANULARITY CAVEAT (honest, the --balance-caveat spirit): this measures coupling of the CACHED ARTIFACT
# at FILE granularity — a consumer that re-invokes the SENSE LIVE (calls mesh-<x>) instead of reading its
# cache is deliberately NOT counted. That is not a blind spot, it is the point: a cache classed
# EXPRESSIVE-ONLY whose sense is nonetheless live-consumed is the interiority finding sharpened — the
# cached component is welded to the pane while functional consumers PAY to re-probe live (the efficiency
# loss --balance's RR frame cares about). Report-only, no verdict touched; artifact:
# docs/reviews/deleuze-assemblage-relations-of-exteriority-sensorium-2026-07-28.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
NL='
'


# ── ROLL-FIELD → CACHED-FILE MAP — ONE definition, THREE readers (--exteriority · --viability · --test) ─
# The roll-call renders each cached sense as `<field>=<value> (<bucket>)`; this names the ARTIFACT behind
# each field, so a consumer-side read (who re-plugs this stream?) can be keyed by the roll's own field
# name. It lives here, above both readers, for the same reason SUBSTRATE_CLASS_MAP does: a second copy
# would rot out of agreement and each axis would then be measuring a different mesh. `n` and `top` are two
# It sits ABOVE --test as well (2026-08-21): the --exteriority fixture used to hand-copy this roster
# into its own `_allstreams` list, so adding a stream to the map left the fixture short of it and the
# EXTERIOR arm failed on a stream nothing in the crafted toolset referenced — the roster-beside-the-
# roster failure, in a TEST, where it reads as the feature being broken. The fixture derives it now.
# fields of the ONE presence.log stream (deliberate — the file dedups below; the fields do not).
STREAM_FILE_MAP="motion=.body-motion-state light=.light-state power=.body-power-state prox=.phone-prox.state
room=.room-sense.state tempo=.activity-tempo.state ambient=.ambient-clock.state audio-path=.audio-path-state context=.room-context.state media=.media-scene.state wifi-motion=.wifi-motion-state
n=presence.log top=presence.log
mode=.household.state home-state=home-state.log operator-home=.op-home.state
situation=.situation.state perimeter=.perimeter.state watchtower=.watchtower-state
interruptibility=.interruptibility.state
HW=.hw-health.state"
# ── _ptop_render — presence.log line → the PRESENCE row's `top=` value ───────────────────────────
# Defined here, above BOTH readers (the --cached row and --test), because a function defined below
# its caller is silently empty.
#
# WHY IT IS A FUNCTION AND NOT A SED: the old one-liner
#   sed -nE 's/.*devices=\[[^|]*\|[^|]*\|([^|]*)\|.*/\1/p' | sed -E 's/ *-[0-9]+ *$//'
# rendered `?` — the SAME string the `${ptop:-?}` fallback writes for an unreadable log — in FOUR
# different worlds, three of which are determinate readings, not unresolved ones:
#   1. the top contact's advertised name is literally `?` (mesh-presence's UNNAMED sentinel).
#      Measured on this node's own presence.log: 987 of 2735 lines (36%). The pane was therefore
#      saying "no reading" about the CLOSEST device in the room, at -48 dBm, whose MAC we hold.
#   2. `devices=[]` — the scan RAN and the room was empty (30 lines here). An empty room is a
#      determinate percept; rendering it as `?` makes an answer look like a failure to answer.
#   3. n=1 — the positional sed needed a trailing `|` from the NEXT entry, so a scan with exactly
#      ONE contact discarded a name it had parsed (`LE-Bose` → `?`). LATENT here (0 such lines in
#      this corpus), a wrong reading the moment the room quiets down to a single device.
#   4. no `devices=` field at all (schema drift / unreadable log) — the only genuinely unresolved
#      world, and the only one that should still render `?`.
# --sensorium --impasse keys on `?` to mean "fed but cannot carve", so the collapse does not just
# mislead a human: worlds 1-3 are frames that carve fine and would be filed as reframe candidates.
#
# The identity we DO hold for an unnamed contact is its MAC, and mesh-presence already built the
# enrichment for exactly this ("puts a vendor on an otherwise-nameless '?' contact", resolve_oui) —
# it was never swept to this reader. `--vendor` is a pure offline IEEE-OUI lookup, NO BLE scan and
# no D-Bus (~0.1s), so it is safe in a 30s render loop and MUST NOT be swapped for --addrtype,
# which needs a live scan window on the BT half of the combo chip carrying this node's sole uplink.
# Honest-degrade: a random/privacy MAC has no IEEE OUI → empty → we print the MAC alone, never a
# guessed vendor. Do NOT derive public-vs-random from the MAC bytes here (that rule is a coin flip
# on BLE — see mesh-presence's classify_addrtype).
#
# Contract: prints the value, or NOTHING when the line carries no `devices=` field (world 4) — the
# caller's `${ptop:-?}` then renders the unresolved sentinel, which now means only that.
_ptop_render() { # $1 = a presence.log line
  local _line="$1" _inner _first _mac _name _vend
  case "$_line" in *"devices=["*) : ;; *) return 0 ;; esac      # world 4: no field → caller renders ?
  _inner="$(printf '%s\n' "$_line" | sed -nE 's/.*devices=\[(.*)\].*/\1/p')"   # greedy: last ] closes it
  [ -n "${_inner//[[:space:]]/}" ] || { printf 'none'; return 0; }             # world 2: empty scan
  # entries are "<rssi>|<MAC>|<name>" joined by a space; split BEFORE the next entry's rssi|MAC| so a
  # name containing spaces (or a '|') stays whole and a single-entry list still parses (world 3).
  _first="$(printf '%s\n' "$_inner" | sed -E 's/ (-?[0-9]+\|[0-9A-Fa-f:]{17}\|)/\n\1/g' | head -1)"
  _mac="$(printf '%s' "$_first" | cut -d'|' -f2)"
  _name="$(printf '%s' "$_first" | cut -d'|' -f3-)"
  case "$_mac" in [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:*) : ;; *) return 0 ;; esac
  if [ -z "$_name" ] || [ "$_name" = "?" ]; then                               # world 1: unnamed
    _vend="$(timeout 3 mesh-presence --vendor "$_mac" 2>/dev/null | head -1)"
    printf 'unnamed:%s%s' "$_mac" "${_vend:+ ($_vend)}"
  else
    printf '%s' "$_name"
  fi
}
run(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -5 | tr '\n' ';')"
  else
    echo "[$label] (unavailable)"
  fi
}
run_compact(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    echo "[$label] $(printf '%s' "$out" | head -1)"
  else
    echo "[$label] (unavailable)"
  fi
}

if [ "${1:-}" = --test ]; then
  # Gate the --cached roll-call's perimeter field by DRIVING it against a crafted state artifact,
  # not by grepping this source. Two cases, because one alone asserts nothing: the ALERT case pins
  # which FIELD is read (f2=out is CALM there, so a sub-axis read renders a false all-clear and this
  # fails), the CALM control pins that we still track the verdict down (a hardcoded "ALERT" passes
  # case 1 and fails here). Pure file reads under a throwaway HOME — no organ needed, so no exit 2.
  _s="$(mktemp -d)"; mkdir -p "$_s/.mesh"
  _roll(){ printf '%s\t%s\n' "$(date -u +%FT%TZ)" "$1" > "$_s/.mesh/.perimeter.state"
           HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^SITUATION .*perimeter=\([A-Za-z-]*\).*/\1/p'; }
  # out=CALM net=ALERT phy=CALM verdict=ALERT — the unknown-MAC-on-LAN shape that hid behind cut -f2
  _got="$(_roll "$(printf 'CALM\tALERT\tCALM\tALERT')")"
  [ "$_got" = ALERT ] || { echo "smoke-test: FAIL (perimeter verdict ALERT rendered as '${_got:-<empty>}' — reading the wrong field of .perimeter.state?)"; rm -rf "$_s"; exit 1; }
  _got="$(_roll "$(printf 'CALM\tCALM\tCALM\tCALM')")"
  [ "$_got" = CALM ] || { echo "smoke-test: FAIL (perimeter verdict CALM rendered as '${_got:-<empty>}')"; rm -rf "$_s"; exit 1; }

  # BODY provenance: a value produced by a FALLBACK tier must not render as a plain live reading.
  # Three cases, because any two alone are passable by a cheat: (1) derived-with-age pins that we
  # read the substitute datum's OWN age, (2) the direct control pins that we did not just hardcode
  # a tag onto everything, (3) derived-without-age pins that a tier stating no age still surfaces
  # as derived instead of silently falling back to (fresh). All three states are FRESH by mtime —
  # that is the whole point: the old code only consulted the log once the state went STALE, so a
  # gracefully-degrading sense (the one that keeps writing) was the one that never got checked.
  _lite(){ printf 'DIM\n' > "$_s/.mesh/.light-state"; printf '%s\n' "$1" > "$_s/.mesh/light.log"
           HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^BODY .*light=\(.*\) . power=.*/\1/p'; }
  _got="$(_lite '[room-dim] DIM (beacon-derived — phone SSH down; push-beacon lux=19 age=2265s via phaedra)')"
  [ "$_got" = "DIM (beacon-derived 37m)" ] || { echo "smoke-test: FAIL (beacon-derived light rendered as '${_got:-<empty>}', want 'DIM (beacon-derived 37m)' — a fallback-sourced value is wearing a live mark)"; rm -rf "$_s"; exit 1; }
  # a SECOND age, because one aged fixture is passable by hardcoding its minute count (mutant seen
  # green doing exactly that) — two different ages force the digits to come from the record.
  _got="$(_lite '[room-dim] DIM (beacon-derived — phone SSH down; push-beacon lux=19 age=605s via phaedra)')"
  [ "$_got" = "DIM (beacon-derived 10m)" ] || { echo "smoke-test: FAIL (beacon age rendered as '${_got:-<empty>}', want 'DIM (beacon-derived 10m)' — the age is not being read from the record)"; rm -rf "$_s"; exit 1; }
  _got="$(_lite '[room-dim] DIM (lux=19 via phone)')"
  [ "$_got" = "DIM (fresh)" ] || { echo "smoke-test: FAIL (direct light rendered as '${_got:-<empty>}', want 'DIM (fresh)' — provenance tag applied to a non-derived read?)"; rm -rf "$_s"; exit 1; }
  _got="$(_lite '[room-dim] DIM (webcam-derived, coarse — phone offline; mean=48.4 via=direct)')"
  [ "$_got" = "DIM (webcam-derived)" ] || { echo "smoke-test: FAIL (ageless derived tier rendered as '${_got:-<empty>}', want 'DIM (webcam-derived)')"; rm -rf "$_s"; exit 1; }
  rm -f "$_s/.mesh/.light-state" "$_s/.mesh/light.log"

  # Gate the BODY motion= field the same way: drive the roll-call against a real .body-motion-state
  # in each of the WRITER's two shapes (mesh-body-motion:580 live / :128 offline). One case alone
  # asserts nothing -- the OFFLINE case pins that we extract the TAG (a whole-record read renders
  # `|OFFLINE||||` and fails here), the live control pins that the [body-xxx] path still wins (a
  # blanket `cut -f2` that dropped the regex would print `[body-still]` and pass case 1 alone).
  _bm(){ printf '%s\n' "$1" > "$_s/.mesh/.body-motion-state"
         HOME="$_s" bash "$0" --cached 2>/dev/null | sed -n 's/^BODY  *motion=\([^ ]*\).*/\1/p'; }
  _got="$(_bm '|OFFLINE||||')"
  [ "$_got" = OFFLINE ] || { echo "smoke-test: FAIL (offline body-motion rendered as '${_got:-<empty>}', want OFFLINE — reading the raw record instead of the writer's field-2 tag?)"; rm -rf "$_s"; exit 1; }
  _got="$(_bm '4213|[body-still]|0|[body-still]|1800|3')"
  [ "$_got" = '[body-still]' ] || { echo "smoke-test: FAIL (live body-motion rendered as '${_got:-<empty>}', want [body-still])"; rm -rf "$_s"; exit 1; }
  # THE TRANSITION SHAPE, which neither case above can catch: tag=OFFLINE while `pending` (field 4)
  # still carries the last live tag. Observed on this node 2026-08-19 as `|OFFLINE|1|[body-still]|
  # 327909|0`, rendered `motion=[body-still] (fresh)` -- the blindness sentinel published as a live
  # reading. The two clean shapes agree under BOTH a field-2 read and a whole-line regex, so they
  # were green throughout; only a fixture where the two fields DISAGREE separates them. Falsify:
  # restore the whole-line `grep -oE '\[body-[a-z]+\]'` as the primary and this leg goes RED.
  _got="$(_bm '|OFFLINE|1|[body-still]|327909|0')"
  [ "$_got" = OFFLINE ] || { echo "smoke-test: FAIL (offline body-motion with a stale pending tag rendered as '${_got:-<empty>}', want OFFLINE -- a whole-line regex is taking field 4 (pending) over field 2 (tag))"; rm -rf "$_s"; exit 1; }
  echo "  ok: BODY motion= renders the committed tag for all three writer shapes (live + OFFLINE + OFFLINE-with-stale-pending)"
  rm -rf "$_s"

  # WATCHTOWER reach=: the reading must come from `.watchtower-state` (written by EVERY mesh-watchtower
  # invocation, incl. the child call mesh-perimeter still makes) and NOT from `.watchtower-state.reach`
  # (written only on the retired `--edge` path). The two files agree on the BIT and differ only in AGE,
  # so a fixture where both exist with the same value separates them ONLY through the freshness bucket
  # — which is exactly how this hid on the live node for 3h. Falsify: point either the value read or the
  # mark() file back at `.reach` and leg (1) goes RED with (STALE).
  _w="$(mktemp -d)"; mkdir -p "$_w/.mesh"
  _wt(){ HOME="$_w" bash "$0" --cached 2>/dev/null | sed -n 's/.*watchtower=//p'; }
  # (1) THE MEASURED SHAPE: live organ (fresh .watchtower-state) + frozen edge memory (old .reach).
  printf '76622 1\n' > "$_w/.mesh/.watchtower-state"
  printf '1\n'       > "$_w/.mesh/.watchtower-state.reach"; touch -d '3 hours ago' "$_w/.mesh/.watchtower-state.reach"
  _got="$(_wt)"
  [ "$_got" = "reach-ok (fresh)" ] \
    || { echo "smoke-test: FAIL (live watchtower with a frozen edge-memory file rendered '${_got:-<empty>}', want 'reach-ok (fresh)' — the reach bit is being read from the --edge-only .reach side file instead of the .watchtower-state every invocation writes)"; rm -rf "$_w"; exit 1; }
  # (2) CONTROL — a genuinely dead producer must still age to STALE (the fix must not make this axis
  #     unfalsifiable by simply pointing at a file that some other path keeps warm).
  touch -d '3 hours ago' "$_w/.mesh/.watchtower-state"
  _got="$(_wt)"
  [ "$_got" = "reach-ok (STALE)" ] \
    || { echo "smoke-test: FAIL (a stale .watchtower-state rendered '${_got:-<empty>}', want 'reach-ok (STALE)' — a dead producer must still surface)"; rm -rf "$_w"; exit 1; }
  # (3) the three reach states are three states: 1=ok, 0=BLIND, absent/garbage=UNREADABLE. The old
  #     `!= 1 -> reach-BLIND` collapsed a real blind read with an unreadable file.
  printf '76622 0\n' > "$_w/.mesh/.watchtower-state"
  _got="$(_wt)"
  case "$_got" in reach-BLIND*) : ;; *) echo "smoke-test: FAIL (reach_up=0 rendered '${_got:-<empty>}', want reach-BLIND)"; rm -rf "$_w"; exit 1 ;; esac
  printf 'garbage\n' > "$_w/.mesh/.watchtower-state"
  _got="$(_wt)"
  case "$_got" in reach-UNREADABLE*) : ;; *) echo "smoke-test: FAIL (an unparseable .watchtower-state rendered '${_got:-<empty>}', want reach-UNREADABLE — blind and unreadable must not collapse)"; rm -rf "$_w"; exit 1 ;; esac
  echo "  ok: SITUATION watchtower= reads the artifact the SURVIVING writer writes (not the retired --edge side file), still ages to STALE, and keeps ok/BLIND/UNREADABLE distinct"
  rm -rf "$_w"

  # ROOM wifi-motion= — the DECLARED-CACHELESS trap (2026-08-21). `~/.mesh/.wifi-motion-state` is
  # rewritten unconditionally on every mesh-wifi-motion run and driven every ~5min by two cron parents,
  # yet the roll-call rendered no row for it AND named it on the LIVE-ONLY (no cache) line — a declared
  # absence, which unlike a stale row is not something any consumer re-checks. Three arms, and the third
  # is the one that matters: a row alone would leave the false claim standing beside it.
  _wm="$(mktemp -d)"; mkdir -p "$_wm/.mesh"
  _wmrow(){ HOME="$_wm" bash "$0" --cached 2>/dev/null | sed -n 's/.*wifi-motion=\([^ ]* ([a-zA-Z—]*)\).*/\1/p'; }
  # (1) a fresh state renders the FIRST field only — the vocab contract's verdict token, payload dropped.
  printf 'MOTION|dwell_s=301|changes_24h=64|sub_changes_24h=16|sub_dwell_s=2697\n' > "$_wm/.mesh/.wifi-motion-state"
  _got="$(_wmrow)"
  [ "$_got" = "MOTION (fresh)" ] \
    || { echo "smoke-test: FAIL (ROOM wifi-motion= rendered '${_got:-<absent>}', want 'MOTION (fresh)' — the cached device-free motion verdict must appear in the roll-call, first field only)"; rm -rf "$_wm"; exit 1; }
  # (2) CONTROL — a genuinely dead producer must still age to STALE past the 1200s TTL, so the row can
  #     never be an unfalsifiable green riding its co-driven neighbours' liveness.
  touch -d '2 hours ago' "$_wm/.mesh/.wifi-motion-state"
  _got="$(_wmrow)"
  [ "$_got" = "MOTION (STALE)" ] \
    || { echo "smoke-test: FAIL (a 2h-old .wifi-motion-state rendered '${_got:-<absent>}', want 'MOTION (STALE)')"; rm -rf "$_wm"; exit 1; }
  # (3) the completeness line must NOT still book it as cacheless — the roll-call would then contradict
  #     its own row, and the LIVE-ONLY list is exactly what makes a missing sense read as deliberate.
  if HOME="$_wm" bash "$0" --cached 2>/dev/null | grep '^LIVE-ONLY' | grep -q 'wifi-motion'; then
    echo "smoke-test: FAIL (wifi-motion is still named on the LIVE-ONLY (no cache) line while the ROOM row reads its cache — a declared absence beside a live reading)"; rm -rf "$_wm"; exit 1
  fi
  echo "  ok: ROOM wifi-motion= reads the cached device-free verdict, ages to STALE on a dead producer, and is no longer booked as cacheless"
  rm -rf "$_wm"

  # RR efficiency<->resiliency (--balance): drive the REAL --balance black-box against crafted cached
  # state under a throwaway HOME (a fresh file = a LIVE stream, absent = a dead one). Three fixtures pin
  # the three verdict branches so no single hardcoded verdict passes: BLIND (nothing cached → exit 4),
  # BRITTLE (one live stream per category → exit 3), balanced (multi-stream categories filled → exit 0).
  # Falsify: flip the `brittle*2 >= cats` threshold or drop the live/dead counting → a branch goes RED.
  _b="$(mktemp -d)"; mkdir -p "$_b/.mesh"
  _bal(){ HOME="$_b" bash "$0" --balance 2>/dev/null; }   # prints report, exits with the posture code
  _fresh(){ printf 'x\n' > "$_b/.mesh/$1"; }              # a live cached stream (mtime = now)
  # (1) BLIND — empty .mesh: every category renders all-(—), zero live → BLIND-SPOTS, exit 4.
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: BLIND-SPOTS' && [ "$_rc" -eq 4 ]; } \
    || { echo "smoke-test: FAIL (--balance on an empty roll-call must be BLIND-SPOTS/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  # (2) BRITTLE — exactly ONE live stream per category (each category depth 1 → single-source).
  _fresh .body-motion-state; _fresh .room-sense.state; _fresh presence.log
  _fresh .household.state;   _fresh .situation.state;  _fresh .interruptibility.state; _fresh .hw-health.state
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: BRITTLE' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--balance with one live stream/category must be BRITTLE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  # (3) balanced — fill the multi-field categories to depth>=2 so <half are single-source → exit 0.
  _fresh .light-state; _fresh .body-power-state             # BODY -> 3/4
  _fresh .activity-tempo.state; _fresh .ambient-clock.state # ROOM -> 3/6
  _fresh home-state.log                                     # HOUSEHOLD -> 2/3
  _fresh .perimeter.state                                   # SITUATION -> 2/3
  _out="$(_bal)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: balanced' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--balance with redundant streams must be balanced/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_b"; exit 1; }
  echo "  ok: --balance efficiency<->resiliency posture tracks stream depth (BLIND/BRITTLE/balanced)"
  rm -rf "$_b"

  # RR insight (--impasse): drive the REAL --impasse black-box against crafted cached state under a
  # throwaway HOME. Three fixtures pin the load-bearing distinction — a LIVE field with an UNRESOLVED
  # value is an IMPASSE (reframe), a live field with a determinate value is FRAMED, and a STALE (dead)
  # unresolved field is NOT an impasse (liveness, not reframe). Falsify: dropping the `?` alternative
  # from the impasse regex, or counting stale as live, turns a branch RED.
  _i="$(mktemp -d)"; mkdir -p "$_i/.mesh"
  _imp(){ HOME="$_i" bash "$0" --impasse 2>/dev/null; }
  # (1) FRAMED — one live field with a DETERMINATE value: interruptibility=AVAILABLE (fresh) → exit 0.
  printf 'AVAILABLE\n' > "$_i/.mesh/.interruptibility.state"
  _out="$(_imp)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: FRAMED' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--impasse with a resolved live field must be FRAMED/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_i"; exit 1; }
  # (2) IMPASSE — same field but EMPTY content (fresh mtime): renders `? (fresh)` = fed-but-uncarving → exit 3.
  : > "$_i/.mesh/.interruptibility.state"
  _out="$(_imp)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: IMPASSE' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--impasse on a live-but-empty field must be IMPASSE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_i"; exit 1; }
  # (3) NOT-impasse when STALE — an empty field with an OLD mtime is a DEAD producer (liveness), not an
  # impasse; it must NOT be IMPASSE (the distinction the whole read exists to make).
  touch -d '2 hours ago' "$_i/.mesh/.interruptibility.state"
  _out="$(_imp)"; _rc=$?
  if printf '%s' "$_out" | grep -q 'posture: IMPASSE' || [ "$_rc" -eq 3 ]; then
    echo "smoke-test: FAIL (--impasse must NOT flag a STALE/dead field as impasse, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_i"; exit 1
  fi
  echo "  ok: --impasse separates fed-but-uncarving (IMPASSE) from resolved (FRAMED) and dead (STALE)"
  rm -rf "$_i"

  # ASSEMBLAGE relations of exteriority (--exteriority): drive the REAL black-box against a CRAFTED
  # toolset (MESH_BINDIR) with KNOWN reference counts, so the classify bands are asserted on data, not
  # on the live graph. Three fake tools reference .perimeter.state (=> refs 3 EXTERIOR); two reference
  # .interruptibility.state (=> refs 2 WELDED); the branch pins on the posture + exit code.
  _e="$(mktemp -d)"; mkdir -p "$_e/bin"
  _tool(){ printf '#!/bin/sh\n# refs: %s\n' "$2" > "$_e/bin/$1"; }   # $1=name $2=stream-basename it reads
  _ext(){ MESH_BINDIR="$_e/bin" HOME="$_e" bash "$0" --exteriority 2>/dev/null; }
  # (1) EXPRESSIVE-DEADENDS — empty toolset: every stream refs 0 => not-produced => exit 4.
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: EXPRESSIVE-DEADENDS' && [ "$_rc" -eq 4 ]; } \
    || { echo "smoke-test: FAIL (--exteriority empty toolset must be EXPRESSIVE-DEADENDS/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # DERIVED from STREAM_FILE_MAP (moved above --test for exactly this), never hand-copied: this list has
  # to be the SAME roster the tool renders, and a second copy silently under-covers the moment a stream is
  # added — the added stream is then the one stream no crafted consumer references, and the EXTERIOR arm
  # fails naming a posture, not the drift. Same dedup as the --exteriority body's own STREAMS derivation.
  _allstreams="$(printf '%s\n' $STREAM_FILE_MAP | sed 's/^[^=]*=//' | awk 'NF&&!seen[$0]++' | tr '\n' ' ')"
  [ -n "$_allstreams" ] || { echo "smoke-test: FAIL (--exteriority fixture derived an EMPTY stream roster from STREAM_FILE_MAP — the map moved or changed shape)"; rm -rf "$_e"; exit 1; }
  _consumer(){ { printf '#!/bin/sh\n'; for s in $_allstreams; do printf '# reads %s\n' "$s"; done; } > "$_e/bin/$1"; }
  # (2) EXTERIOR — 3 tools each referencing EVERY stream => refs=3 for all => none welded/expr => exit0.
  _consumer mesh-consumer1; _consumer mesh-consumer2; _consumer mesh-consumer3
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: EXTERIOR' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--exteriority all-streams-refs3 must be EXTERIOR/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # (3) INTERIORITY-PINNED — drop to exactly TWO referencing tools => every stream refs 2 => all WELDED.
  rm -f "$_e/bin/mesh-consumer3"
  _out="$(_ext)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: INTERIORITY-PINNED' && [ "$_rc" -eq 3 ]; } \
    || { echo "smoke-test: FAIL (--exteriority all-streams-refs2 must be INTERIORITY-PINNED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_e"; exit 1; }
  # (4) per-line classify on a fresh fixture: .perimeter.state read by 3 tools => EXTERIOR; .op-home.state
  #     read by 1 => EXPRESSIVE-ONLY. (posture is EXPRESSIVE-DEADENDS here; only the per-line bands asserted.)
  rm -f "$_e"/bin/*
  for i in 1 2 3; do echo '# reads .perimeter.state' > "$_e/bin/mesh-per$i"; done
  echo '# reads .op-home.state' > "$_e/bin/mesh-solo"
  _out="$(_ext)"
  { printf '%s' "$_out" | grep -qE '\.perimeter\.state +refs 3 +EXTERIOR'; } \
    || { echo "smoke-test: FAIL (--exteriority per-line: .perimeter.state at refs 3 must read EXTERIOR)"; printf '%s\n' "$_out" | grep -E 'perimeter|op-home'; rm -rf "$_e"; exit 1; }
  { printf '%s' "$_out" | grep -qE '\.op-home\.state +refs 1 +EXPRESSIVE-ONLY'; } \
    || { echo "smoke-test: FAIL (--exteriority per-line: .op-home.state at refs 1 must read EXPRESSIVE-ONLY)"; printf '%s\n' "$_out" | grep -E 'op-home'; rm -rf "$_e"; exit 1; }
  echo "  ok: --exteriority relations-of-exteriority bands track consumer fan-out (EXTERIOR/WELDED/EXPRESSIVE/exit)"
  rm -rf "$_e"

  # ANTIFRAGILITY degeneracy vs redundancy (--degeneracy): drive the REAL black-box against CRAFTED
  # roll-call files (the readable-$2 path), so the substrate-class map is asserted on data. Three fixtures
  # pin the load-bearing claim — a depth>=2 category on ONE class is a MONOCULTURE (redundancy overstates
  # resiliency, exit 3), the SAME depth on >=2 classes is truly-degenerate (exit 0), and the per-line degen
  # count reflects the MAP. Falsify: collapse the map (all fields -> one class) and the degenerate fixture
  # goes RED; explode it (every field its own class) and the monoculture fixture goes RED. Both map
  # directions are therefore gated — the classifier must actually discriminate, not just always-flag.
  _d="$(mktemp -d)"
  _deg(){ bash "$0" --degeneracy "$1" 2>/dev/null; }   # prints report, exits with the posture code
  # (1) MONOCULTURE — BODY depth 3 all 'phone' class => REDUNDANCY-OVERESTIMATE, exit 3.
  printf 'BODY       motion=STILL (fresh) · light=DARK (fresh) · power=OK (recent)\n' > "$_d/mono"
  _out="$(_deg "$_d/mono")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: REDUNDANCY-OVERESTIMATE' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -qE 'BODY .*degen 1 \[phone\].*MONOCULTURE'; } \
    || { echo "smoke-test: FAIL (--degeneracy: a depth>=2 single-substrate category must read MONOCULTURE/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_d"; exit 1; }
  # (2) degenerate — every depth>=2 category spans >=2 classes => posture degenerate, exit 0. This is the
  # falsifier for a COLLAPSED map: if motion/room mapped to the same class, BODY would read degen 1 and flag.
  printf 'BODY       motion=STILL (fresh) · room=CALM (recent)\nSITUATION  situation=WATCH (aging) · watchtower=reach-ok (aging)\n' > "$_d/degen"
  _out="$(_deg "$_d/degen")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: degenerate' && [ "$_rc" -eq 0 ] \
    && printf '%s' "$_out" | grep -qE 'BODY .*degen 2 \[phone audio\].*FSS 1\.00'; } \
    || { echo "smoke-test: FAIL (--degeneracy: a depth>=2 cross-substrate category must read degen>=2/FSS1.00 and NOT flag, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_d"; exit 1; }
  echo "  ok: --degeneracy separates a common-mode MONOCULTURE from a truly-degenerate (structurally-distinct) category"
  rm -rf "$_d"

  # ANTIFRAGILITY joint-failure amplification (--amplification): drive the REAL black-box against CRAFTED
  # rolls. The load-bearing claim is that the axis actually REMOVES TWO substrate classes AT ONCE and
  # prices what dies — NOT that it re-adds single-point losses. Three fixtures pin the three branches, and
  # the arithmetic is pinned at an exact ratio, not just a flag. Falsify (both seen RED before landing):
  # replace the joint loss lossOf(i,j) with the sum L(i)+L(j) — the pure-joint and superadditive fixtures
  # both go RED (they are the whole content of the axis); collapse the substrate map to one class — the
  # pure-joint fixture goes RED (no cross-class pair left to remove). The additive fixture is the falsifier
  # for an ALWAYS-FLAG detector: two categories on two distinct classes cost exactly the sum, and a
  # superadditive verdict there would be a lie.
  _a="$(mktemp -d)"
  _amp(){ bash "$0" --amplification "$1" 2>/dev/null; }
  # (1) PURE-JOINT — ONE category on two classes: neither class alone blinds anything (L=0+0), together
  # they blind it. Unbounded amplification, and INVISIBLE to the single-point ranking above it. This is
  # exactly the category --degeneracy retires as "truly-degenerate / common-mode resilient".
  printf 'ROOM       room=CALM (fresh) · context=SOLO (recent)\n' > "$_a/pure"
  _out="$(_amp "$_a/pure")"; _rc=$?
  { [ "$_rc" -eq 3 ] && printf '%s' "$_out" | grep -qE 'audio \+ phone|phone \+ audio' \
    && printf '%s' "$_out" | grep -q 'amp UNBOUNDED' && printf '%s' "$_out" | grep -q 'PURE-JOINT — costs NOTHING apart, blinds ROOM' \
    && printf '%s' "$_out" | grep -q 'posture: SUPERADDITIVE' && printf '%s' "$_out" | grep -q '(1 PURE-JOINT'; } \
    || { echo "smoke-test: FAIL (--amplification: a category whose two classes each cost 0 alone must read PURE-JOINT/UNBOUNDED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  # (2) SUPERADDITIVE with a NON-ZERO base — pins the RATIO, not just the flag: phone alone blinds BODY
  # (L=1), audio alone blinds nothing (L=0), together they blind BODY *and* ROOM (2) => exactly 2.00x.
  printf 'BODY       motion=STILL (fresh)\nROOM       room=CALM (fresh) · context=SOLO (recent)\n' > "$_a/super"
  _out="$(_amp "$_a/super")"; _rc=$?
  { [ "$_rc" -eq 3 ] && printf '%s' "$_out" | grep -qE 'amp 2\.00x .*SUPERADDITIVE .*breaks on ROOM' \
    && printf '%s' "$_out" | grep -q '(0 PURE-JOINT'; } \
    || { echo "smoke-test: FAIL (--amplification: L 1+0 -> 2 must read exactly amp 2.00x SUPERADDITIVE/exit3, got rc=$_rc: $(printf '%s' "$_out" | grep -E 'amp ' | tr '\n' ';'))"; rm -rf "$_a"; exit 1; }
  # (3) ADDITIVE — two categories, one distinct class each: the joint loss IS the sum (2 = 1+1), so amp is
  # exactly 1.00x and the posture must NOT flag. Falsifier for an always-superadditive detector.
  printf 'BODY       motion=STILL (fresh)\nPRESENCE   n=3 (recent)\n' > "$_a/add"
  _out="$(_amp "$_a/add")"; _rc=$?
  { [ "$_rc" -eq 0 ] && printf '%s' "$_out" | grep -q 'posture: additive' \
    && printf '%s' "$_out" | grep -qE 'amp 1\.00x .*additive' \
    && ! printf '%s' "$_out" | grep -q 'SUPERADDITIVE'; } \
    || { echo "smoke-test: FAIL (--amplification: substitutable classes (joint loss == sum) must read additive/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  echo "  ok: --amplification prices JOINT substrate failure (pure-joint unbounded · 2.00x superadditive · additive) — not the sum of single points"
  rm -rf "$_a"

  # ANTIFRAGILITY signed damage response (--damage-response): drive the REAL black-box against crafted
  # rolls. The load-bearing claim is that the response has a SIGN — that a coupling can be antifragile
  # (partial damage RAISES the fabric's spectral gap), which no loss-shaped axis above can express. Three
  # fixtures pin the three postures and the arithmetic is pinned at exact derivatives, not just flags.
  # Falsifiers, ALL seen RED before landing: (a) the MUTANT MESH_SENS_LAP=combinatorial swaps the
  # normalized Laplacian for L=D-A, whose eigenvalues are MONOTONE in the weights — the antifragile
  # verdict must then VANISH from the identical fixture, which is the whole reason the normalization is
  # load-bearing rather than a modelling detail; (b) the cross-coupled fixture is the falsifier for an
  # always-antifragile detector (every coupling there is FRAGILE at exactly -0.25); (c) the 2-node fixture
  # is the falsifier for a spectral reading taken where there is no gap to read (honest n/a, exit 2).
  # STATED, NOT HIDDEN: the UNSTABLE branch (the two betas disagree in sign) is NOT gated by a fixture —
  # no fabric this small produces a sign flip. Measured on the live fabric across beta = 1e-4 .. 0.9 (i.e.
  # from the derivative limit right up to near-total severance) every coupling holds its sign, so the
  # verdicts are not an artefact of the beta knob. By this file's own doctrine an ungated branch is not a
  # gate; it is kept because it is CONSERVATIVE (it withholds a verdict, never invents one).
  # The non-mutant calls run with MESH_SENS_LAP *UNSET* rather than pinned to "normalized": pinning it
  # would leave the DEFAULT untested, and the default is the only thing the LIVE path ever uses — a
  # fixture that supplies the very setting it is asserting cannot cover the live path (measured: flipping
  # the default to "combinatorial" left a pinned --test green). `env -u` also makes the fixtures immune to
  # an exported node-local value, which is the reason pinning was tempting in the first place.
  _r="$(mktemp -d)"
  _dmg(){ if [ -n "${2:-}" ]; then MESH_SENS_LAP="$2" bash "$0" --damage-response "$1" 2>/dev/null
          else env -u MESH_SENS_LAP bash "$0" --damage-response "$1" 2>/dev/null; fi; }
  # (1) ANTIFRAGILE — a 4-node PATH fabric (audio-ROOM-phone-BODY): the two pendant couplings are traps
  # (cutting them raises the gap, L=+0.25) and the middle one is the bridge (L=-0.50); PRESENCE/ble hangs
  # off as an ALREADY-SEVERED island, which no other axis in this file reports at all.
  printf 'BODY       motion=STILL (fresh)\nROOM       context=SOLO (fresh) · room=CALM (fresh)\nPRESENCE   n=3 (fresh)\n' > "$_r/anti"
  _out="$(_dmg "$_r/anti")"; _rc=$?
  { [ "$_rc" -eq 3 ] && printf '%s' "$_out" | grep -q 'posture: ANTIFRAGILE-COUPLING' \
    && printf '%s' "$_out" | grep -qE 'audio +-> ROOM +w 1 +L \+0\.2501[0-9] +. ANTIFRAGILE' \
    && printf '%s' "$_out" | grep -qE 'phone +-> ROOM +w 1 +L -0\.5002[0-9] +FRAGILE' \
    && printf '%s' "$_out" | grep -qE 'island +PRESENCE ble .* SEVERED'; } \
    || { echo "smoke-test: FAIL (--damage-response: a pendant coupling on a path fabric must read ANTIFRAGILE +0.250 with the middle one FRAGILE -0.500 and the disjoint category SEVERED, got rc=$_rc: $(printf '%s' "$_out" | grep -E '^ +(net|phone|audio|derived|island)' | tr '\n' ';'))"; rm -rf "$_r"; exit 1; }
  # (2) MUTANT — the SAME fixture read through the COMBINATORIAL Laplacian: monotone in the weights, so
  # every Lambda <= 0 and the antifragile posture is unreachable. If this ever passes as ANTIFRAGILE the
  # axis is not measuring what it says it measures.
  _out="$(_dmg "$_r/anti" combinatorial)"; _rc=$?
  { [ "$_rc" -eq 0 ] && printf '%s' "$_out" | grep -q 'posture: monotone' \
    && ! printf '%s' "$_out" | grep -E '^ +[a-z]+ +->' | grep -q 'ANTIFRAGILE'; } \
    || { echo "smoke-test: FAIL (--damage-response MUTANT: under the combinatorial Laplacian damage cannot raise the gap, so the antifragile verdict must vanish — got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_r"; exit 1; }
  # (3) MONOTONE — a fully cross-coupled fabric (both classes feed both categories): no trap, every
  # coupling FRAGILE at exactly -0.25, posture must NOT flag. Falsifier for an always-antifragile verdict.
  printf 'BODY       motion=STILL (fresh) · room=CALM (fresh)\nROOM       context=SOLO (fresh) · ambient=X (fresh)\n' > "$_r/cyc"
  _out="$(_dmg "$_r/cyc")"; _rc=$?
  { [ "$_rc" -eq 0 ] && printf '%s' "$_out" | grep -q 'posture: monotone' \
    && printf '%s' "$_out" | grep -qE 'phone +-> ROOM +w 1 +L -0\.2501[0-9] +FRAGILE' \
    && printf '%s' "$_out" | grep -q 'fabric components: 1' \
    && ! printf '%s' "$_out" | grep -E '^ +[a-z]+ +->' | grep -q 'ANTIFRAGILE'; } \
    || { echo "smoke-test: FAIL (--damage-response: a fully cross-coupled fabric has no trap — every coupling must read FRAGILE -0.250/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_r"; exit 1; }
  # (4) n/a — one category on one class is a 2-node fabric: no gap to read. Honest exit 2, never a verdict.
  printf 'BODY       motion=STILL (fresh)\n' > "$_r/tiny"
  _out="$(_dmg "$_r/tiny")"; _rc=$?
  { [ "$_rc" -eq 2 ] && printf '%s' "$_out" | grep -q 'posture: n/a'; } \
    || { echo "smoke-test: FAIL (--damage-response: a 2-node fabric has no spectral gap and must render n/a exit 2, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_r"; exit 1; }
  echo "  ok: --damage-response reads the SIGN of a PARTIAL damage (antifragile trap +0.250 · fragile bridge -0.500 · monotone fabric · n/a) — and dies under the combinatorial-Laplacian mutant"
  rm -rf "$_r"

  # ASSEMBLAGE double articulation (--articulation): drive the REAL black-box against crafted CONTENT(log)
  # + EXPRESSION(state) artifacts with KNOWN mtimes under a throwaway HOME. The load-bearing claim is that
  # the TWO planes are checked against EACH OTHER, not the clock alone: a fresh LOG with a STALE STATE is
  # MUTE (a live sense whose sign the sensorium dropped), while the REVERSE (fresh state, stale log) is the
  # honest liveness-touch shape and must NOT fault. Falsify: drop the state-staleness check and MUTE
  # collapses into ARTICULATED (case 1 RED); flag the sign-ahead direction and case 3 goes RED. A single
  # hardcoded verdict can pass at most one of the three cases.
  _a="$(mktemp -d)"; mkdir -p "$_a/.mesh"
  _art(){ HOME="$_a" bash "$0" --articulation 2>/dev/null; }
  _fresh_a(){ printf 'x\n' > "$_a/.mesh/$1"; }                                   # mtime = now
  _stale_a(){ printf 'x\n' > "$_a/.mesh/$1"; touch -d '1 hour ago' "$_a/.mesh/$1"; }  # age 3600s > ttl 2100s
  # (1) MUTE — content plane (log) fresh, expression plane (state) stale => DECOUPLED/exit3.
  _fresh_a body-power.log; _stale_a .body-power-state
  _out="$(_art)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: DECOUPLED' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -qE 'body-power .*MUTE'; } \
    || { echo "smoke-test: FAIL (--articulation fresh-log/stale-state must read MUTE/DECOUPLED/exit3, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  # (2) coupled — BOTH planes fresh => ARTICULATED/exit0 (the falsifier for an always-DECOUPLED verdict).
  _fresh_a body-power.log; _fresh_a .body-power-state
  _out="$(_art)"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: coupled' && [ "$_rc" -eq 0 ]; } \
    || { echo "smoke-test: FAIL (--articulation both-planes-fresh must read coupled/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_a"; exit 1; }
  # (3) SIGN-AHEAD must NOT fault — fresh state, STALE log is the honest change-gated liveness-touch shape.
  _fresh_a .body-power-state; _stale_a body-power.log
  _out="$(_art)"; _rc=$?
  if printf '%s' "$_out" | grep -q 'posture: DECOUPLED' || [ "$_rc" -eq 3 ]; then
    echo "smoke-test: FAIL (--articulation must NOT fault the fresh-state/stale-log liveness-touch shape as MUTE, got rc=$_rc)"; rm -rf "$_a"; exit 1
  fi
  echo "  ok: --articulation checks content(log) vs expression(state) planes — MUTE only when live content leads a stale sign"
  rm -rf "$_a"

  # ORIENTATION footholds (--footholds): drive the REAL black box against crafted reading LOGS under a
  # throwaway HOME. The load-bearing claim is a RELATION between two counts on the same record — the sign's
  # transitions vs the situation's — so every case below moves exactly ONE of them and every clause of the
  # verdict is asserted ALONE. Falsify: drop the hist>=1 clause and (5) goes RED; drop the MINMOVE/still-world
  # guard and (4) goes RED; test FALSE-HOLD against the categorical count instead of the all-axis count and
  # (6) goes RED; let a unit-suffixed number read as categorical and (6) goes RED as DEAD-HOLD. No single
  # hardcoded verdict passes more than one case. Window is the DEFAULT 60 (env unset for hermeticity —
  # a test child must not inherit node-local tuning), so fixtures carry 60 history + 60 window lines.
  _f_new(){ _f="$(mktemp -d)"; mkdir -p "$_f/.mesh"; }
  _f_hist(){ local n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] %s k1=q k2=y\n' "$1"; fi
      n=$((n+1)); done; }                                  # $1=BBB -> responsive history; AAA -> flat history
  _fh(){ env -u MESH_FOOTHOLD_WINDOW HOME="$_f" bash "$0" --footholds 2>/dev/null; }
  _f_case(){ # $1=label $2=want-posture $3=want-rc $4=want-class
    _out="$(_fh)"; _rc=$?
    { printf '%s' "$_out" | grep -q "posture: $2" && [ "$_rc" -eq "$3" ] \
      && { [ -z "$4" ] || printf '%s' "$_out" | grep -qE "t\.log +$4"; }; } \
      || { echo "smoke-test: FAIL (--footholds $1: want posture=$2 rc=$3 class=$4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_f"; exit 1; }
    rm -rf "$_f"; }
  # (1) DEAD-HOLD — sign frozen across the window while the categorical situation moves, and the sign DID
  #     move in the history before it. The whole point of the mode.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] AAA k1=q k2=y\n'; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "frozen sign under a moving situation" "DISORIENTED" 3 "DEAD-HOLD"
  # (2) HOLDING — same moving situation, but the sign moves with it (falsifier for an always-DEAD verdict).
  _f_new; { _f_hist BBB; _f_hist BBB; } > "$_f/.mesh/t.log"
  _f_case "sign moving with the situation" "oriented" 0 "HOLDING"
  # (3) FALSE-HOLD — situation frozen (categorical AND numeric), sign alternates: more distinctions than
  #     the inputs offer.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] BBB k1=p k2=x\n'; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "sign carving finer than its inputs" "CHATTERING" 4 "FALSE-HOLD"
  # (3b) NUMERIC-DRIVEN SIGN — categorical axes frozen, a NUMERIC axis moving every line, sign alternating.
  #     This is the only case where the conservative (categorical) and liberal (all-axis) motion counts
  #     DISAGREE, so it is the sole guard on FALSE-HOLD being tested against the liberal one. It is
  #     light.log's real shape (verdict rides `mean=`/`stddev=`, only categorical field is `via=direct`):
  #     the sign is tracking a recorded input, not inventing distinctions. Without this case the
  #     st>ct mutant survives all seven others — measured, not assumed.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x mean=%s.1\n' "$n"; else printf '[t] BBB k1=p k2=x mean=%s.7\n' "$n"; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "sign tracking a numeric axis the log records" "oriented" 0 "HOLDING"
  # (4) QUIET — a STILL world legitimately gets a still sign; must NOT read DEAD-HOLD.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do printf '[t] AAA k1=p k2=x\n'; n=$((n+1)); done; } > "$_f/.mesh/t.log"
  _f_case "still world, still sign" "oriented" 0 "QUIET"
  # (5) FLAT-NO-BASELINE — same frozen sign + moving situation as (1), but the record NEVER shows this sign
  #     moving: unauditable, must be NAMED and must NOT be faulted as DEAD-HOLD.
  _f_new; { _f_hist AAA; n=0; while [ "$n" -lt 60 ]; do
      if [ $((n%2)) -eq 0 ]; then printf '[t] AAA k1=p k2=x\n'; else printf '[t] AAA k1=q k2=y\n'; fi; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "frozen sign with no responsive history" "oriented" 0 "FLAT-NO-BASELINE"
  # (6) UNIT-SUFFIXED NUMERIC is not a categorical move — a wattage/temperature drifting every line under a
  #     frozen sign is package-power's shape, not a dead hold; and the sign is not chattering either.
  _f_new; { _f_hist BBB; n=0; while [ "$n" -lt 60 ]; do printf '[t] AAA k1=p k2=x core=%s.%sW\n' "$n" "$n"; n=$((n+1)); done
    } > "$_f/.mesh/t.log"
  _f_case "unit-suffixed numeric drift under a frozen sign" "oriented" 0 "QUIET"
  # (7) NO ASSESSABLE HOLDS — never faked as 'oriented'; honest n/a exits 2.
  _f_new; printf 'phone unreachable — not an alarm\n' > "$_f/.mesh/t.log"
  _f_case "no log records a sign with >=2 categorical axes" "NO ASSESSABLE HOLDS" 2 ""
  echo "  ok: --footholds separates a DEAD hold from a moving one, a chattering sign from a numeric-driven one, and never fakes an unauditable or absent record as oriented"

  # SECOND-ORDER relational viability (--viability): drive the REAL black box against CRAFTED rolls (the
  # readable-$2 path) AND a CRAFTED toolset (MESH_BINDIR), so both the value alphabet and the consumer
  # fan-out are asserted on data. The load-bearing claim is NON-COMPENSATION — each dimension must be able
  # to sink a stream ON ITS OWN, with the other two at full strength — so every case below fails exactly
  # ONE dimension and no single hardcoded verdict passes more than one case. Falsify (each seen RED before
  # landing): drop the FUNCTION test and (2)+(4)+(5) go green-wrong; drop the SENSE test and (3) does;
  # count an unassessed field as non-viable and (6) fires a false VIABILITY-BLIND; make viability a
  # 2-of-3 majority instead of a conjunction and (2)+(3) both go RED (that IS the compensation the axis
  # exists to refuse).
  _v="$(mktemp -d)"; mkdir -p "$_v/bin"
  _vtool(){ local n="$1"; shift; { printf '#!/bin/sh\n'; for s in "$@"; do printf '# reads %s\n' "$s"; done; } > "$_v/bin/$n"; }
  _via(){ MESH_BINDIR="$_v/bin" HOME="$_v" bash "$0" --viability "$1" 2>/dev/null; }
  # (1) viable — two determinate streams, both read downstream (refs 2 => >=1 consumer): richness == viability.
  #     The falsifier for an always-flag detector.
  printf 'BODY       motion=STILL (fresh) · light=DARK (fresh)\n' > "$_v/roll"
  _vtool mesh-c1 .body-motion-state .light-state; _vtool mesh-c2 .body-motion-state .light-state
  _out="$(_via "$_v/roll")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: viable' && [ "$_rc" -eq 0 ] \
    && printf '%s' "$_out" | grep -qE 'BODY +depth 2 → viable 2'; } \
    || { echo "smoke-test: FAIL (--viability: two determinate, downstream-read streams must be viable/exit0, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_v"; exit 1; }
  # (2) FUNCTION alone sinks it — SAME roll but the value self-reports the organ OFFLINE, while SENSE is at
  #     FULL strength (5 tools re-plug it). This is the non-compensation assertion: no amount of downstream
  #     readership rescues a stream that determines nothing about the world.
  printf 'BODY       motion=OFFLINE (fresh) · light=DARK (fresh)\n' > "$_v/roll"
  for i in 1 2 3 4 5; do _vtool "mesh-c$i" .body-motion-state .light-state; done
  _out="$(_via "$_v/roll")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: RICHNESS-INFLATED' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -qE 'BODY +depth 2 → viable 1' \
    && printf '%s' "$_out" | grep -q 'motion=OFFLINE .*FUNCTION ✗'; } \
    || { echo "smoke-test: FAIL (--viability: a fresh, widely-read stream reporting its organ OFFLINE must still be non-viable (FUNCTION), got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_v"; exit 1; }
  # (3) SENSE alone sinks it — determinate value, but only the producer references the artifact (refs 1).
  #     Mirror of (2): full FUNCTION, absent SENSE. Pins the reason string too, so a right-verdict/wrong-
  #     dimension read (e.g. flagging it as FUNCTION) goes RED.
  printf 'BODY       motion=STILL (fresh) · light=DARK (fresh)\n' > "$_v/roll"
  rm -f "$_v"/bin/*; _vtool mesh-producer .body-motion-state .light-state; _vtool mesh-c2 .light-state
  _out="$(_via "$_v/roll")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: RICHNESS-INFLATED' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -qE 'BODY +depth 2 → viable 1' \
    && printf '%s' "$_out" | grep -qE 'motion=STILL .*SENSE ✗ no other tool re-plugs this stream \(refs 1\)'; } \
    || { echo "smoke-test: FAIL (--viability: a determinate stream nothing downstream reads must be non-viable (SENSE), got rc=$_rc: $(printf '%s' "$_out" | grep -E 'motion=|posture' | tr '\n' ';'))"; rm -rf "$_v"; exit 1; }
  # (4) VIABILITY-BLIND — a single-stream category whose only field is UNKNOWN, SENSE fine: viable 0 => exit 4.
  #     Pins the worse-verdict precedence (blind beats inflated) and the `?`/UNKNOWN cell of the alphabet.
  printf 'COORDINATION interruptibility=UNKNOWN (recent)\n' > "$_v/roll"
  rm -f "$_v"/bin/*; _vtool mesh-c1 .interruptibility.state; _vtool mesh-c2 .interruptibility.state
  _out="$(_via "$_v/roll")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: VIABILITY-BLIND' && [ "$_rc" -eq 4 ] \
    && printf '%s' "$_out" | grep -qE 'COORDINATION depth 1 → viable 0'; } \
    || { echo "smoke-test: FAIL (--viability: a live category whose only field is UNKNOWN must be VIABILITY-BLIND/exit4, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_v"; exit 1; }
  # (5) the self-declared-dark clause — a fusion whose value LOOKS determinate (DEGRADED) but says its own
  #     input axes are out. Distinct from (4): the first token passes the alphabet, so dropping this clause
  #     alone turns the case RED while every other case stays green.
  printf 'ROOM       tempo=DEGRADED|reason=axes-dark (recent) · room=PRESENT|dwell_s=301 (fresh)\n' > "$_v/roll"
  rm -f "$_v"/bin/*; _vtool mesh-c1 .activity-tempo.state .room-sense.state; _vtool mesh-c2 .activity-tempo.state .room-sense.state
  _out="$(_via "$_v/roll")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: RICHNESS-INFLATED' && [ "$_rc" -eq 3 ] \
    && printf '%s' "$_out" | grep -q 'fusion self-declares its input axes dark'; } \
    || { echo "smoke-test: FAIL (--viability: a DEGRADED|reason=axes-dark fusion must fail FUNCTION, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_v"; exit 1; }
  # (6) HONEST N/A — a roll field with no artifact mapped cannot be scored on SENSE; it must be reported as
  #     unassessed and must NOT fire a verdict (a viable-0 category here would be a fabricated alarm).
  printf 'PRESENCE   madeupfield=OK (fresh)\n' > "$_v/roll"
  _out="$(_via "$_v/roll")"; _rc=$?
  if printf '%s' "$_out" | grep -qE 'posture: (VIABILITY-BLIND|RICHNESS-INFLATED)' || [ "$_rc" -ne 0 ]; then
    echo "smoke-test: FAIL (--viability must not fault a field it cannot key to an artifact — honest n/a, got rc=$_rc: $(printf '%s' "$_out" | sed -n 's/.*posture: //p'))"; rm -rf "$_v"; exit 1
  fi
  printf '%s' "$_out" | grep -q 'unassessed on SENSE' \
    || { echo "smoke-test: FAIL (--viability: an unmapped field must be REPORTED as unassessed, not silently dropped)"; rm -rf "$_v"; exit 1; }
  # (7) empty roll -> honest n/a, exit 2 (never a fabricated 'viable').
  : > "$_v/roll"
  _out="$(_via "$_v/roll")"; _rc=$?
  { printf '%s' "$_out" | grep -q 'posture: NO CATEGORIES' && [ "$_rc" -eq 2 ]; } \
    || { echo "smoke-test: FAIL (--viability on an empty roll must be NO CATEGORIES/exit2, got rc=$_rc)"; rm -rf "$_v"; exit 1; }
  echo "  ok: --viability scores POSITION∧FUNCTION∧SENSE non-compensatorily (each dimension sinks a stream alone; unassessed and empty stay honest n/a)"
  rm -rf "$_v"

  # ── PRESENCE `top=` — the four worlds must render four DIFFERENT strings ────────────────────────
  # Drives the real _ptop_render against real presence.log shapes. The point of the gate is not that
  # it parses; it is that `?` is reserved for the ONE unresolved world, so no determinate reading can
  # wear it. Each leg names the world it pins; drop any branch of _ptop_render and exactly its leg
  # goes red. `${x:-?}` is applied here the way the caller applies it, so the leg asserts the string
  # a READER actually sees, not the function's bare stdout.
  _pt(){ local _v; _v="$(_ptop_render "$1")"; printf '%s' "${_v:-?}"; }
  _pl_named='2026-08-18T06:40:10Z mesh-home n=8 devices=[-48|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink -62|E7:4D:F9:65:B0:65|Bluetooth] attribution=personal:5,appliance:2,ambiguous:1'
  _pl_unnamed='2026-08-18T06:40:10Z mesh-home n=8 devices=[-48|79:90:DB:95:0B:EE|? -62|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink] attribution=personal:5,appliance:2,ambiguous:1'
  _pl_one='2026-08-18T06:40:10Z mesh-home n=1 devices=[-48|28:11:A5:B8:9E:A2|LE-Bose Revolve SoundLink] attribution=personal:1,appliance:0,ambiguous:0'
  _pl_empty='2026-08-04T02:10:10Z mesh-home n=0 devices=[] attribution=personal:0,appliance:0,ambiguous:0'
  _pl_drift='2026-08-18T06:40:10Z mesh-home n=8 top=[TV] Samsung'
  # world 4 — the ONLY `?`: no devices= field at all.
  [ "$(_pt "$_pl_drift")" = '?' ] \
    || { echo "smoke-test: FAIL (--cached top=: a line with no devices= field must render the unresolved sentinel '?', got '$(_pt "$_pl_drift")')"; exit 1; }
  # world 1 — unnamed top contact: must NOT be '?', must carry the MAC (the identity we DO hold).
  _u="$(_pt "$_pl_unnamed")"
  case "$_u" in
    '?') echo "smoke-test: FAIL (--cached top=: an UNNAMED top contact is a determinate reading and must not render as '?' — that is the unreadable-log sentinel)"; exit 1 ;;
    *79:90:DB:95:0B:EE*) : ;;
    *) echo "smoke-test: FAIL (--cached top=: an unnamed contact must be named by its MAC, got '$_u')"; exit 1 ;;
  esac
  # ...and a vendor, when the offline OUI registry has one — the enrichment mesh-presence built for
  # exactly this case. Asserted against a REGISTERED OUI (Bose), so a --vendor that silently stopped
  # resolving goes red here; skipped where the registry is absent (a plantable node), never faked.
  if [ -n "$(timeout 3 mesh-presence --vendor 28:11:A5:B8:9E:A2 2>/dev/null)" ]; then
    _u2="$(_pt '2026-08-18T06:40:10Z mesh-home n=1 devices=[-48|28:11:A5:B8:9E:A2|?] attribution=personal:1,appliance:0,ambiguous:0')"
    case "$_u2" in *'(Bose'*) : ;; *) echo "smoke-test: FAIL (--cached top=: an unnamed contact on a REGISTERED OUI must carry its vendor, got '$_u2')"; exit 1 ;; esac
  fi
  # world 2 — the scan ran and the room was empty. A determinate percept, distinct from unreadable.
  [ "$(_pt "$_pl_empty")" = 'none' ] \
    || { echo "smoke-test: FAIL (--cached top=: an EMPTY scan (devices=[]) must render 'none', not the unresolved '?' — an answer must not look like a failure to answer, got '$(_pt "$_pl_empty")')"; exit 1; }
  # world 3 — exactly ONE contact: the old positional parse needed the NEXT entry's '|' and threw a
  # name it had already parsed. Latent (0 such lines in this node's corpus) and wrong when it fires.
  [ "$(_pt "$_pl_one")" = 'LE-Bose Revolve SoundLink' ] \
    || { echo "smoke-test: FAIL (--cached top=: a single-contact scan must render that contact's NAME, got '$(_pt "$_pl_one")')"; exit 1; }
  # a multi-entry list must still take the FIRST (strongest) entry, whole — the name has spaces, and
  # the next entry's rssi must not be smuggled onto the end of it.
  [ "$(_pt "$_pl_named")" = 'LE-Bose Revolve SoundLink' ] \
    || { echo "smoke-test: FAIL (--cached top=: multi-entry list must render the first entry's full name, got '$(_pt "$_pl_named")')"; exit 1; }
  # the four worlds must be four DISTINCT strings — the defect itself, asserted directly, so a future
  # 'simplification' that re-collapses any pair goes red even if each leg above still passes.
  [ "$(printf '%s\n%s\n%s\n%s\n' "$(_pt "$_pl_drift")" "$_u" "$(_pt "$_pl_empty")" "$(_pt "$_pl_one")" | sort -u | wc -l)" -eq 4 ] \
    || { echo "smoke-test: FAIL (--cached top=: unreadable / unnamed / empty-scan / single-contact must render four DISTINCT strings)"; exit 1; }
  echo "  ok: PRESENCE top= renders unreadable('?'), unnamed(MAC+vendor), empty-scan('none') and single-contact as four distinct strings"

  # --- BODY light PROVENANCE from the state file's own source= field (2026-08-18, task
  # light-state-drops-its-own-provenance). mesh-light appends |source=<phone|beacon|webcam> to every
  # value-bearing write; bodymark must read THAT (same artifact, same cycle) in preference to the
  # companion log's prose (a DIFFERENT cycle — measured disagreeing by 21 min on 2026-08-18, which
  # made a real phone read render as "webcam-derived"). Driven end-to-end through --cached against a
  # SANDBOXED HOME so the assertion is on the RENDERED line, not on this file's source text.
  # Each fixture pairs its state with a log line naming the WRONG tier, so a leg that regressed to
  # the log prose is caught by CONTENT, not merely by absence. FALSIFIABLE: delete the source= branch
  # in bodymark, or drop the `cut -d'|' -f1` from the light= value → the matching leg goes red.
  _bpf=0
  _bpself="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
  _bp_render(){ # $1=state-line → the light= field of the BODY row
    local _t; _t="$(mktemp -d)"; mkdir -p "$_t/.mesh"
    printf '%s\n' "$1" > "$_t/.mesh/.light-state"
    printf '[room-dark] DARK (webcam-derived, coarse — a DIFFERENT, older cycle)\n' > "$_t/.mesh/light.log"
    HOME="$_t" "$_bpself" --cached 2>/dev/null | grep -E '^BODY' | sed -E 's/.*light=([^·]*).*/\1/; s/ +$//'
    rm -rf "$_t"
  }
  # phone tier: the organ itself — no -derived annotation, and the stale log must NOT win
  _bpr="$(_bp_render 'LIT|dwell_s=9|changes_24h=2|source=phone')"
  [ "$_bpr" = "LIT (fresh)" ] \
    || { echo "smoke-test: FAIL (BODY light: source=phone must render 'LIT (fresh)', not the log's tier — got '$_bpr')"; _bpf=1; }
  # beacon tier: named, WITH the substitute datum's own age (the state mtime is this cycle, the lux is not)
  _bpr="$(_bp_render 'DIM|source=beacon|source_age_s=855')"
  [ "$_bpr" = "DIM (beacon-derived 14m)" ] \
    || { echo "smoke-test: FAIL (BODY light: source=beacon should render 'DIM (beacon-derived 14m)' — got '$_bpr')"; _bpf=1; }
  # webcam tier: named, no age (the frame is this cycle's)
  _bpr="$(_bp_render 'DIM|source=webcam')"
  [ "$_bpr" = "DIM (webcam-derived)" ] \
    || { echo "smoke-test: FAIL (BODY light: source=webcam should render 'DIM (webcam-derived)' — got '$_bpr')"; _bpf=1; }
  # a state with NO source= (a legacy/other body sense) still falls back to the log prose — the
  # fallback the sibling motion/power axes depend on must survive the new branch.
  _bpr="$(_bp_render 'MODERATE|dwell_s=183|changes_24h=54')"
  [ "$_bpr" = "MODERATE (webcam-derived)" ] \
    || { echo "smoke-test: FAIL (BODY light: sourceless state must still fall back to the log prose — got '$_bpr')"; _bpf=1; }
  # and the VALUE is the level word alone: the enriched record must never leak into the pane
  # (it did — "light=MODERATE|dwell_s=183|changes_24h=54 (webcam-derived)", measured 2026-08-18).
  case "$_bpr" in *'|'*) echo "smoke-test: FAIL (BODY light value leaked the enriched record: '$_bpr')"; _bpf=1 ;; esac
  [ "$_bpf" = 0 ] || exit 1
  echo "  ok: BODY light provenance reads the state's own source= (phone/beacon/webcam), falls back to the log when absent, and renders the level word alone"

  # --- ROOM media= must age the READING, not the writer's heartbeat (2026-08-26, live review
  # swarm-freshness-non-liftability / arXiv:2608.02619 Thm 7.9A). mesh-media-scene fuses two live
  # probes with two TAPE reads, so its verdict can rest on evidence up to its own WIN_S old — while
  # its state file's mtime is stamped by mesh-state-touch on EVERY tick (mtime=ran-live, by the
  # liveness-touch convention). Marking that verdict from mtime therefore answers a different
  # question than the one the freshness guard is asking, and always answers it (fresh). The producer
  # now publishes `evidence-age=` on line 2; this leg is the reader half. FALSIFIABLE: drop the 4th
  # arg at the media= call site, or the $4 branch in mark() → the first two cases collapse to (fresh).
  _evf=0
  _evself="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
  _ev_render(){ # $1..=lines of .media-scene.state → the media= field of the ROOM row
    local _t; _t="$(mktemp -d)"; mkdir -p "$_t/.mesh"
    printf '%s\n' "$@" > "$_t/.mesh/.media-scene.state"
    HOME="$_t" "$_evself" --cached 2>/dev/null | grep -E '^ROOM' | sed -E 's/.*media=([^·]*).*/\1/; s/ +$//'
    rm -rf "$_t"
  }
  # the file is written NOW (mtime age ~0) but the evidence behind it is 537s old → (recent), and
  # the skew is named so the pane shows WHY the attribution is weak, not just that it is old.
  _evr="$(_ev_render 'TV-LIKELY' 'attrib=skewed skew=471 evidence-age=537 ages=local:0,imac:0,tv:537,mic:66')"
  [ "$_evr" = "TV-LIKELY (recent) [skewed-attrib]" ] \
    || { echo "smoke-test: FAIL (ROOM media: a 537s-old reading in a just-written file must render '(recent) [skewed-attrib]' — got '$_evr')"; _evf=1; }
  # past the sense's own 600s budget the reading is honestly STALE even though the reflex just ran
  _evr="$(_ev_render 'TV-LIKELY' 'attrib=skewed skew=590 evidence-age=1200 ages=local:0,imac:0,tv:1200,mic:10')"
  [ "$_evr" = "TV-LIKELY (STALE) [skewed-attrib]" ] \
    || { echo "smoke-test: FAIL (ROOM media: evidence past the 600s budget must render STALE — got '$_evr')"; _evf=1; }
  # a timely attribution keeps (fresh) and carries no skew clause — the class must be able to say ok
  _evr="$(_ev_render 'TV-LIKELY' 'attrib=fresh skew=4 evidence-age=9 ages=local:0,imac:0,tv:9,mic:5')"
  [ "$_evr" = "TV-LIKELY (fresh)" ] \
    || { echo "smoke-test: FAIL (ROOM media: a fresh attribution must render '(fresh)' with no clause — got '$_evr')"; _evf=1; }
  # a producer that publishes NO line 2 (an older deploy, another node) falls back to mtime unchanged
  _evr="$(_ev_render 'QUIET')"
  [ "$_evr" = "QUIET (fresh)" ] \
    || { echo "smoke-test: FAIL (ROOM media: a state with no evidence-age must fall back to mtime — got '$_evr')"; _evf=1; }
  [ "$_evf" = 0 ] || exit 1
  echo "  ok: ROOM media= ages the READING via the producer's evidence-age (mtime is the writer's heartbeat, not the evidence's age), names a skewed attribution, and falls back to mtime when unpublished"

  # --- The SUBSTITUTE-TIER render must not fall out of the readers' OWN TOTALS (2026-08-22, task
  # sensorium-internal-tag-readers-drop-the-derived-tier-from-their-own-totals). The leg above pins that
  # mark() RENDERS provenance as `(<tier>-derived)` / `(<tier>-derived <N>m)`. That is a FOURTH shape, and
  # every internal reader of the roll matched the freshness alphabet as a CLOSED set — `(fresh|recent|aging)`
  # plus `(STALE)` plus `(—)` — so a sense running on a fallback tier matched no bucket at all and was
  # dropped from BOTH sides: not counted live (correct: a substitute is not the organ) and not counted in
  # the TOTAL either (wrong: no bucket then said "alive only via a fallback", and a category whose fields
  # were ALL derived vanished from the report entirely, total==0 -> next). Measured on this node's live
  # cache: live=19 stale=0 dash=0 -> total=19 while a fourth pattern matched 1 more.
  # POLARITY leg, not a parse-only green: ONE roll rendered TWICE, differing only in whether a field is
  # direct or on a substitute tier — once where the derived field is one of several (BODY light) and once
  # where it is its category's ONLY field (NODE HW, the vanishing-category case). What must HOLD across
  # the pair is the TOTAL each reader publishes; what may legitimately move is the LIVE count.
  # Driven RED against the pre-fix build: --viability read 9 present/4 categories direct vs 7/3 on the
  # fallback, and --degeneracy/--amplification/--damage-response all changed verdict. Falsify: drop any
  # reader's fourth alternative (or the `+deriv` from --balance's total) and its leg goes red.
  _pt=0; _ptd="$(mktemp -d)"
  cat > "$_ptd/direct.roll" <<'PTROLL'
BODY       motion=MOTION (fresh) · light=MODERATE (fresh) · power=OK (fresh)
ROOM       room=PRESENT (fresh) · media=TV (fresh) · context=CALM (fresh)
SITUATION  situation=WATCH (fresh) · watchtower=reach-ok (fresh)
NODE       HW=OK (fresh)
PTROLL
  sed -e 's/light=MODERATE (fresh)/light=MODERATE (beacon-derived 14m)/' \
      -e 's/HW=OK (fresh)/HW=OK (webcam-derived)/' "$_ptd/direct.roll" > "$_ptd/fallback.roll"
  _pt_get(){ bash "$0" "$1" "$_ptd/$2.roll" 2>/dev/null | sed -n "$3" | head -1; }
  # (1) --balance — the per-category TOTAL (the /N) holds; the one that falls back is NOT counted live,
  # and a category left with no direct stream reads FALLBACK-ONLY rather than silently disappearing.
  for _c in BODY NODE; do
    _a="$(_pt_get --balance direct   "s|^  $_c  *depth [0-9]*/\([0-9]*\) live.*|\1|p")"
    _b="$(_pt_get --balance fallback "s|^  $_c  *depth [0-9]*/\([0-9]*\) live.*|\1|p")"
    { [ -n "$_a" ] && [ "$_a" = "$_b" ]; } \
      || { echo "smoke-test: FAIL (--balance $_c total '${_a:-<no line>}' direct vs '${_b:-<no line>}' on a fallback tier — the -derived render is falling out of the TOTAL)"; _pt=1; }
  done
  _pt_get --balance fallback '/NODE .*FALLBACK-ONLY/p' | grep -q . \
    || { echo "smoke-test: FAIL (--balance: a category whose only stream is on a substitute tier must read FALLBACK-ONLY, not vanish)"; _pt=1; }
  # (2) --impasse — live + fallback-tier fields must sum to the same field count either way.
  for _v in direct fallback; do
    eval "_s_$_v=\$(_pt_get --impasse $_v 's|^  \([0-9]*\) live field(s) (+\([0-9]*\) on a fallback tier).*|\1 \2|p' | awk '{print \$1+\$2}')"
  done
  { [ -n "$_s_direct" ] && [ "$_s_direct" = "$_s_fallback" ]; } \
    || { echo "smoke-test: FAIL (--impasse field total '${_s_direct:-<no line>}' direct vs '${_s_fallback:-<no line>}' on a fallback tier)"; _pt=1; }
  # (3) --viability — POSITION holds for a field on a substitute tier: it still occupies its place in the roll.
  _a="$(_pt_get --viability direct   's|^  streams: \([0-9]*\) present.*|\1|p')"
  _b="$(_pt_get --viability fallback 's|^  streams: \([0-9]*\) present.*|\1|p')"
  { [ -n "$_a" ] && [ "$_a" = "$_b" ]; } \
    || { echo "smoke-test: FAIL (--viability present/POSITION count '${_a:-<no line>}' direct vs '${_b:-<no line>}' on a fallback tier)"; _pt=1; }
  # (4) the three SUBSTRATE-CLASS readers — a fallback tier is a substitute TRANSPORT, not an independent
  # organ, so the field keeps its mapped class and these reports must be IDENTICAL across the pair. This
  # asserts both halves at once: the field is not dropped, and it does not manufacture a new class (which
  # would break BODY's phone MONOCULTURE finding on exactly the node where the phone is what died).
  for _m in --degeneracy --amplification --damage-response; do
    _a="$(bash "$0" "$_m" "$_ptd/direct.roll" 2>/dev/null | tail -n +4)"
    _b="$(bash "$0" "$_m" "$_ptd/fallback.roll" 2>/dev/null | tail -n +4)"
    { [ -n "$_a" ] && [ "$_a" = "$_b" ]; } \
      || { echo "smoke-test: FAIL ($_m changed when one field fell back to a substitute tier of the SAME class — the -derived render is not being read)"; _pt=1; }
  done
  rm -rf "$_ptd"
  [ "$_pt" = 0 ] || exit 1
  echo "  ok: --balance/--impasse/--viability/--degeneracy/--amplification/--damage-response all keep a (<tier>-derived) field in their TOTALS (FALLBACK-ONLY, never a vanished category)"

  # --- BODY value fields carry the VERDICT ALONE, whatever delimiter the producer chose (2026-08-19,
  # task phone-prox-collapses-four-causes-into-the-link-down-word). Producers are not consistent about
  # the separator between the verdict and its payload: mesh-phone-prox wrote `FAR|raw=5` for a value
  # and `UNREACHABLE <iso-ts>` for its n/a line; mesh-body-power writes a bare `OK` but `OFFLINE <ts>`.
  # A '|'-only cut (or no cut at all) put the timestamp in the VALUE slot of the live pane — measured
  # on this node the same day: `prox=UNREACHABLE 2026-08-19T08:19:01Z (aging)` and
  # `power=OFFLINE 2026-08-19T08:57:04Z (fresh)`. Driven end-to-end through --cached in a sandboxed
  # HOME, so the assertion is on the RENDERED field. The LEGACY space-delimited fixtures are the point:
  # they keep the READER honest even after a producer is fixed, which is the only half that still holds
  # when the next producer drifts. FALSIFIABLE: drop either `cut` from the prox= or power= value.
  _bvf=0
  _bp_field(){ # $1=state-basename $2=state-line $3=BODY field → the rendered field value
    local _t; _t="$(mktemp -d)"; mkdir -p "$_t/.mesh"
    printf '%s\n' "$2" > "$_t/.mesh/$1"
    HOME="$_t" "$_bpself" --cached 2>/dev/null | grep -E '^BODY' \
      | sed -E "s/.*$3=([^·]*).*/\1/; s/ +$//"
    rm -rf "$_t"
  }
  _bv_assert(){ # $1=file $2=line $3=field $4=expected
    local got; got="$(_bp_field "$1" "$2" "$3")"
    [ "$got" = "$4" ] || { echo "smoke-test: FAIL (BODY $3 from '$2' → '$got', expected '$4')"; _bvf=1; }
  }
  _bv_assert .phone-prox.state 'UNREACHABLE|why=ssh|ts=2026-08-19T08:19:01Z' prox  'UNREACHABLE (fresh)'
  _bv_assert .phone-prox.state 'SENSOR-DARK|why=empty-read|ts=2026-08-19T08:48:01Z' prox 'SENSOR-DARK (fresh)'
  _bv_assert .phone-prox.state 'UNREACHABLE 2026-08-19T08:19:01Z' prox 'UNREACHABLE (fresh)'
  _bv_assert .phone-prox.state 'FAR|raw=5' prox 'FAR (fresh)'
  _bv_assert .body-power-state 'OFFLINE 2026-08-19T08:57:04Z' power 'OFFLINE (fresh)'
  _bv_assert .body-power-state 'OK' power 'OK (fresh)'
  [ "$_bvf" = 0 ] || exit 1
  echo "  ok: BODY prox/power render the verdict alone from BOTH record shapes (pipe payload and the legacy space-delimited timestamp)"

  # --- COORDINATION carries the band AND its COVERAGE (2026-08-19). The producer distinguishes an
  # UNKNOWN over real reads from an UNKNOWN whose load-bearing axes are dead; this reader printed the
  # band alone, so both rendered `interruptibility=UNKNOWN` and the blindness was invisible to the one
  # pane that shows it. Assert all three record shapes end-to-end through --cached: clean → bare band,
  # blind → the dead axes named, legacy (no payload) → bare band, and the raw record never leaks.
  # FALSIFIABLE: drop the `(blind:...)` branch, or the `%%|*` cut, and one of these goes red.
  _cvf=0
  _cv_field(){ # $1=state-line → the rendered COORDINATION interruptibility= value
    local _t; _t="$(mktemp -d)"; mkdir -p "$_t/.mesh"
    printf '%s\n' "$1" > "$_t/.mesh/.interruptibility.state"
    HOME="$_t" "$_bpself" --cached 2>/dev/null | grep -E '^COORDINATION' \
      | sed -E 's/.*interruptibility=([^·]*).*/\1/; s/ +$//'
    rm -rf "$_t"
  }
  _cv_assert(){ local got; got="$(_cv_field "$1")"
    [ "$got" = "$2" ] || { echo "smoke-test: FAIL (COORDINATION from '$1' → '$got', expected '$2')"; _cvf=1; }; }
  _cv_assert 'UNKNOWN|degraded=kbd-unreachable,screen-unreachable' 'UNKNOWN(blind:kbd,screen) (fresh)'
  _cv_assert 'UNKNOWN|degraded='  'UNKNOWN (fresh)'      # clean diffuse posterior — no blind marker
  _cv_assert 'AVAILABLE|degraded=' 'AVAILABLE (fresh)'
  _cv_assert 'AVAILABLE'          'AVAILABLE (fresh)'    # legacy payload-less record still renders
  # the two UNKNOWNs must be DISTINGUISHABLE in the pane — the whole point of the payload
  [ "$(_cv_field 'UNKNOWN|degraded=kbd-unreachable')" != "$(_cv_field 'UNKNOWN|degraded=')" ] \
    || { echo "smoke-test: FAIL (a blind UNKNOWN and a clean UNKNOWN render identically)"; _cvf=1; }
  # ...and so must BLIND vs N/A. The record grew `na=` 2026-08-20 because those two were rendering as
  # one word: `blind:` says a sense that should be producing is dead (the organ is the fix, and the
  # band withholds its all-clear until it returns), `n/a:` says this body HAS no such organ (nothing
  # is coming back — the band is a real verdict on a narrower axis set). On this node the second is
  # the permanent case and wearing the first word made a structural property read as a live fault.
  _cv_assert 'UNKNOWN|na=kbd,screen|degraded=' 'UNKNOWN(n/a:kbd,screen) (fresh)'
  _cv_assert 'AVAILABLE|na=kbd,screen|degraded=' 'AVAILABLE(n/a:kbd,screen) (fresh)'
  # a record carrying BOTH must render BOTH clauses, and the na= field must NOT be swallowed into the
  # blind clause — field order on the wire is what keeps the legacy `#*|degraded=` extraction exact.
  _cv_assert 'UNKNOWN|na=kbd,screen|degraded=room-unreachable' 'UNKNOWN(blind:room)(n/a:kbd,screen) (fresh)'
  [ "$(_cv_field 'UNKNOWN|na=kbd|degraded=')" != "$(_cv_field 'UNKNOWN|degraded=kbd-unreachable')" ] \
    || { echo "smoke-test: FAIL (an ABSENT organ and a DEAD one render identically — the collapsed-reason bug this field exists to fix)"; _cvf=1; }
  [ "$_cvf" = 0 ] || exit 1
  echo "  ok: COORDINATION renders the band plus (blind:<axes>) and (n/a:<axes>) as SEPARATE clauses"

  # ── SELF-PRIOR (--self-prior): the MARK must come from the LEDGER, not from novelty-by-default.
  # Five cases, and none of them is passable alone. (1) plants a pair each member of which is deeply
  # familiar and which has NEVER co-occurred — the mark. (2) is the same fixture with the pair
  # co-occurring in 4 hours: a tool that reports "unseen" for anything it did not just see passes (1)
  # and fails here. (3) a young ledger must REFUSE to name a mark rather than naming the newest thing
  # it saw. (4) a pair whose members are individually RARE is not a mark — otherwise every transient
  # is one. (5) an (aging) axis and a bracketed blindness SENTINEL are absences, not body states
  # ([[a-blindness-sentinel-fused-as-a-reading]]): they must be dropped and NAMED in coverage.
  _sp="$(mktemp -d)"
  printf 'BODY       motion=STILL (fresh) · light=LIT (recent)\nROOM       room=PRESENT|dwell_s=100 (recent) · tempo=SPRINTING (recent)\nHOUSEHOLD  mode=ACTIVE (recent)\nSITUATION  situation=WATCH (aging)\nNODE       HW: OK (recent)\n' > "$_sp/roll"
  python3 - "$_sp" <<'SPFIX'
import sys
d = sys.argv[1]
def w(name, rows): open("%s/%s" % (d, name), "w").write("\n".join(rows) + "\n")
def hb(h): return "2026-08-%02dT%02d:00:00Z" % (1 + h // 24, h % 24)
A = "motion=STILL light=LIT mode=ACTIVE hw=OK room=PRESENT tempo=RESTING"
B = "motion=STILL light=LIT mode=ACTIVE hw=OK room=ABSENT tempo=SPRINTING"
C = "motion=STILL light=LIT mode=ACTIVE hw=OK room=PRESENT tempo=SPRINTING"
w("mark",    ["%s\t%s" % (hb(h), A if h < 20 else B) for h in range(40)])
w("control", ["%s\t%s" % (hb(h), A if h < 20 else (C if h < 24 else B)) for h in range(40)])
w("short",   ["%s\t%s" % (hb(h), A) for h in range(5)])
# rare: 40 hours of history, but room=PRESENT and tempo=SPRINTING each appear in only 2 hours
D = "motion=STILL light=LIT mode=ACTIVE hw=OK room=ELSEWHERE tempo=IDLING"
rare = []
for h in range(40):
    if h < 2:    rare.append("%s\t%s" % (hb(h), "motion=STILL light=LIT mode=ACTIVE hw=OK room=PRESENT tempo=IDLING"))
    elif h < 4:  rare.append("%s\t%s" % (hb(h), "motion=STILL light=LIT mode=ACTIVE hw=OK room=ELSEWHERE tempo=SPRINTING"))
    else:        rare.append("%s\t%s" % (hb(h), D))
w("rare", rare)
SPFIX
  _spf=0
  _sp_run(){ MESH_SELF_PRIOR_NOWRITE=1 bash "$0" --self-prior "$1" "$2" 2>&1; }

  _out="$(_sp_run "$_sp/roll" "$_sp/mark")"; _rc=$?
  { [ "$_rc" = 3 ] && printf '%s' "$_out" | grep -q 'room=PRESENT.*tempo=SPRINTING'; } \
    || { echo "  FAIL: self-prior missed the planted mark (rc=$_rc): $(printf '%s' "$_out" | tail -2)"; _spf=1; }
  _out="$(_sp_run "$_sp/roll" "$_sp/control")"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_out" | grep -q 'no mark'; } \
    || { echo "  FAIL: self-prior marked a pair that HAS co-occurred (rc=$_rc) — it is reporting novelty, not the ledger"; _spf=1; }
  _out="$(_sp_run "$_sp/roll" "$_sp/short")"; _rc=$?
  { [ "$_rc" = 2 ] && printf '%s' "$_out" | grep -q INSUFFICIENT && ! printf '%s' "$_out" | grep -q 'verdict: MARK'; } \
    || { echo "  FAIL: self-prior named a mark on a 5-hour ledger (rc=$_rc) — below the floor everything is unseen"; _spf=1; }
  _out="$(_sp_run "$_sp/roll" "$_sp/rare")"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_out" | grep -q 'no mark'; } \
    || { echo "  FAIL: self-prior marked a pair whose members are individually RARE (rc=$_rc) — the support floor is not binding"; _spf=1; }
  printf 'BODY       motion=[body-covered] (fresh) · light=LIT (recent)\nROOM       room=PRESENT|dwell_s=100 (recent) · tempo=SPRINTING (recent)\nHOUSEHOLD  mode=ACTIVE (recent)\nSITUATION  situation=WATCH (aging)\nNODE       HW: OK (recent)\n' > "$_sp/roll2"
  _out="$(_sp_run "$_sp/roll2" "$_sp/mark")"
  { printf '%s' "$_out" | grep -q 'motion\[sentinel:body-covered\]' && printf '%s' "$_out" | grep -q 'situation\[aging\]' \
      && ! printf '%s' "$_out" | grep -qE 'observation:.*(motion=|situation=)'; } \
    || { echo "  FAIL: self-prior read a blindness sentinel and/or an aging axis as a body state: $(printf '%s' "$_out" | grep -E 'coverage|observation')"; _spf=1; }
  rm -rf "$_sp"
  [ "$_spf" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: --self-prior names the planted mark, stays silent on a co-occurring pair, refuses a young ledger, holds the rare-member floor, and drops sentinel/aging axes"

  for t in mesh-health mesh-therm mesh-presence mesh-wifiscan mesh-audio; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing $t)"; exit 1; }
    "$t" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL ($t --test failed)"; exit 1; }
  done
  echo "smoke-test: ok"; exit 0
fi

case "${1:-}" in --cached|--roll|--balance|--exteriority|--degeneracy|--amplification|--damage-response|--articulation|--footholds|--viability|--self-prior) : ;; *) echo "=== mesh-sensorium @ $ts — $HOST ===" ;; esac

if [ "${1:-}" = --cached ] || [ "${1:-}" = --roll ]; then
  # ALL senses the mesh has, read from the reflexes' CACHED artifacts (cheap — no live probe).
  # Each value is aged from its file mtime; STALE if older than the sense's refresh budget so an
  # unreachable/dead sense never reads as a fresh all-clear (honest-degraded, the fusion rule).
  M="$HOME/.mesh"; now="$(date +%s)"
  agei(){ local f="$1" m d; [ -e "$f" ] || { printf '—'; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    if   [ "$d" -lt 90 ];   then printf '%ss' "$d"
    elif [ "$d" -lt 5400 ]; then printf '%sm' "$((d/60))"
    else printf '%sh' "$((d/3600))"; fi; }
  mark(){ # $1=file $2=value $3=stale-limit-sec(default 1800) -> "value (BUCKET)"
    # COARSE freshness bucket, NOT an exact (Ns)/(Nm): an exact age re-renders every frame and re-wakes
    # the consuming top-pane mind on pure chrome (operator 2026-06-25: top-pane liveness is the block's
    # own job — bucket the age, keep the pane full but byte-stable between refreshes). Buckets span
    # minutes so the line doesn't churn, yet still carry signal: fresh(<2m)/recent(<10m)/aging(<limit)
    # + the honest STALE past the per-sense limit (the only state that matters for the fusion rule).
    # $4 = EXPLICIT AGE (seconds) overriding the mtime-derived one. mtime answers "when did the
    # writer last run", which mesh-state-touch stamps on EVERY tick by the liveness-touch convention
    # — so for any producer that fuses tape-read axes, mtime is a different quantity from "how old
    # is the evidence this verdict rests on", and marking a 9-minute-old reading (fresh) because the
    # cron fired 30s ago is a freshness guard reading the wrong clock. A producer that publishes its
    # own evidence age passes it here; everyone else keeps the mtime path unchanged.
    local f="$1" v="$2" lim="${3:-1800}" ev="${4:-}" m d
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    case "$ev" in
      ''|*[!0-9]*) m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m)) ;;
      *) d="$ev" ;;
    esac
    if   [ "$d" -gt "$lim" ]; then printf '%s (STALE)' "$v"
    elif [ "$d" -lt 120 ];    then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ];    then printf '%s (recent)' "$v"
    else                           printf '%s (aging)' "$v"; fi; }
  # EVIDENCE AGE published by a producer on line 2 of its state file (`evidence-age=<seconds>`).
  # Empty when the producer publishes none — mark() then falls back to mtime exactly as before.
  evage(){ sed -n '2p' "$1" 2>/dev/null | sed -n 's/.*evidence-age=\([0-9][0-9]*\).*/\1/p'; }
  fst(){ head -1 "$1" 2>/dev/null; }   # first line of a state file
  # VERDICT EXTRACTION: a mesh state file is one line whose FIRST field is the verdict; the remainder
  # is payload. The BODY renders cut at '|' AND at the first space, because the two delimiters are not
  # interchangeable across producers and a reader must not depend on which one a given writer chose.
  # This is not hypothetical: mesh-phone-prox wrote its value line pipe-delimited (`FAR|raw=5`) and its
  # n/a line space-delimited (`UNREACHABLE <iso-ts>`), so a '|'-only cut rendered
  # `prox=UNREACHABLE 2026-08-19T08:19:01Z (aging)` — the timestamp sitting in the VALUE slot, where a
  # reader takes it for part of the reading. The producer was fixed to one record shape the same day;
  # cutting on both is the reader-side half, so the next producer to drift cannot reopen it.
  # It is a CLASS, not one producer: the SAME frame rendered `power=OFFLINE <iso-ts>` from
  # `.body-power-state` (mesh-body-power writes a bare `OK`/`LOW` but `OFFLINE <ts>`), and that
  # render passed `fst` through no cut at all. Every BODY value now goes through both cuts.
  # `.body-motion-state` is deliberately NOT one of them — it leads with an EMPTY field
  # (`|OFFLINE||||`), so a field-1 cut yields '' there; its value is precomputed upstream.
  bodymark(){ # $1=state-file $2=value $3=stale-limit $4=companion-reflex-log
    # Like mark(), but for the phone-BODY senses: when the state goes STALE, peek the companion reflex
    # LOG. If that log is still FRESH (the cron is firing) and its last line says the organ is
    # unreachable, this is an OFFLINE ORGAN (honest n/a — the phone body is gone, operator's hands),
    # NOT a dead reflex to fix. A frozen state + a frozen log = a genuinely dead reflex → keep STALE.
    # Distinguishing the two stops the consuming mind chasing a non-bug (the failed-vs-empty rule).
    local f="$1" v="$2" lim="${3:-1800}" log="$4" m d lm lline src sage
    [ -n "$v" ] || v='?'
    [ -e "$f" ] || { printf '%s (—)' "$v"; return; }
    m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; d=$((now-m))
    # Companion-log peek. Read it ONCE, for BOTH questions below — the organ-offline question
    # (state stale) and the DERIVATION question (state fresh). Gating the peek on staleness, as
    # this did until 2026-08-18, is exactly backwards for a sense that degrades GRACEFULLY: a
    # fallback tier keeps writing the state every cycle, so the state never goes stale, so the log
    # was never consulted, so a substitute-sourced reading rendered as a plain live one. Measured:
    # the phone body was gone, motion/power/prox all rendered OFFLINE/UNREACHABLE, and light
    # rendered "DIM (fresh)" off a beacon relayed via phaedra — the one axis with a working
    # fallback was the one axis that looked healthy, and a mind reading the pane would conclude
    # the phone's light sensor was alive and its motion sensor broken. Both were the same dead
    # SSH path. mesh-light publishes source=/source_age_s in JSON and names the tier in its log
    # prose; .light-state carries only the level word, so this render is where it can be recovered.
    if [ -n "$log" ] && [ -e "$log" ]; then
      lm="$(stat -c %Y "$log" 2>/dev/null || echo 0)"
      if [ "$((now-lm))" -le "$lim" ]; then lline="$(tail -1 "$log" 2>/dev/null)"; fi
    fi
    if [ "$d" -gt "$lim" ]; then
      case "$lline" in *[Uu]nreachable*) printf 'OFFLINE(phone)'; return ;; esac
      printf '%s (STALE)' "$v"; return
    fi
    # PROVENANCE, FIRST FROM THE STATE FILE ITSELF (2026-08-18). mesh-light now appends
    # `|source=<phone|beacon|webcam>` (+ `|source_age_s=` on the beacon tier) to every value-bearing
    # write, so the answer lives in the SAME artifact as the value, written by the SAME cycle.
    # That ordering is not cosmetic — the log tail is a DIFFERENT cycle and can disagree. Measured
    # 09:41Z this wake: .light-state held MODERATE|dwell_s=183|changes_24h=54 (the phone shape,
    # written 09:40) while light.log's last line was still 09:19's "webcam-derived" — so the
    # log-prose recovery shipped in eb1bde1 rendered a REAL phone read as webcam-derived. It fixed
    # the substitute-looks-live direction and opened the live-looks-substitute one; a per-cycle
    # value can only be sourced by a per-cycle field. The log stays as the fallback for the sibling
    # body senses (motion/power), which publish no source field.
    local sline ssrc ssage
    src=""   # set -u: the source=phone branch below returns without assigning it
    sline="$(head -1 "$f" 2>/dev/null)"
    ssrc="$(printf '%s' "$sline" | grep -oE 'source=[a-z]+' | head -1 | cut -d= -f2)"
    if [ -n "$ssrc" ]; then
      # source=phone is the organ itself — no annotation, fall through to the freshness bucket.
      if [ "$ssrc" != phone ]; then
        ssage="$(printf '%s' "$sline" | grep -oE 'source_age_s=[0-9]+' | head -1 | tr -dc '0-9')"
        if [ -n "$ssage" ]; then printf '%s (%s-derived %dm)' "$v" "$ssrc" "$((ssage/60))"
        else                     printf '%s (%s-derived)' "$v" "$ssrc"; fi
        return
      fi
    else
      # <tier>-derived is the writer's own vocabulary for "this value did NOT come from the organ"
      # (mesh-light: beacon-derived / webcam-derived). Anchor on that suffix, not on a tier name
      # list, so a fallback added later is surfaced instead of silently wearing (fresh).
      src="$(printf '%s' "$lline" | grep -oE '[a-z]+-derived' | head -1)"
    fi
    if [ -n "$src" ]; then
      # the SUBSTITUTE datum's own age when the writer states it (mesh-light: "age=NNNs"); the
      # freshness bucket describes the writer, and in this branch the writer is live by
      # construction (the stale branch returned above), so replacing the bucket loses nothing.
      sage="$(printf '%s' "$lline" | grep -oE 'age=[0-9]+s' | head -1 | tr -dc '0-9')"
      if [ -n "$sage" ]; then printf '%s (%s %dm)' "$v" "$src" "$((sage/60))"
      else                    printf '%s (%s)' "$v" "$src"; fi
      return
    fi
    if   [ "$d" -lt 120 ]; then printf '%s (fresh)' "$v"
    elif [ "$d" -lt 600 ]; then printf '%s (recent)' "$v"
    else                        printf '%s (aging)' "$v"; fi; }

  echo "=== mesh sensorium (CACHED state — the mind runs the live probes) @ $ts ==="
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle (same bug
  # fixed for situation/perimeter, 1135d62). These senses are autowired at /30 (max gap 30m=1800s):
  # body-motion :07/37, light :09/39, body-power :05/35, activity-tempo :08/38, ambient-clock :06/36
  # → use 2100s(35m) = cadence + grace. room-sense is /15 (max gap 900s) → 1200s(20m). phone-prox
  # declares 19-59/45 which fires at :19 ONLY (45-step from 19 exceeds 59) → real stride 3600s →
  # 4200s(70m); a 3000s TTL false-STALEd it every hour from :09 to :19. Phone offline still
  # surfaces: an unreachable sense ages PAST cadence+grace and goes honest-STALE.
  # ── READ THE TAG FIELD, NOT THE WHOLE LINE (2026-08-19) ──
  # `pending` (field 4) holds a [body-xxx] token too, so a whole-line regex takes the UNCOMMITTED
  # candidate whenever it disagrees with the committed tag. Observed live: the phone went unreachable
  # mid-cycle and the state read `|OFFLINE|1|[body-still]|327909|0` — tag=OFFLINE, pending still
  # carrying the last live tag — and the pane rendered `motion=[body-still] (fresh)`. That is a
  # blindness sentinel published as a live reading, on the ONE axis whose whole job is to say the
  # body is gone; the `|OFFLINE||||` shape (all other fields empty) renders correctly, which is why
  # this hid: it only appears on the transition cycle. Field 2 first, the regex only as the fallback
  # for a line that is not the pipe schema at all.
  _bmline="$(fst "$M/.body-motion-state")"
  case "$_bmline" in *'|'*) bm="$(printf '%s' "$_bmline" | cut -d'|' -f2)" ;; *) bm="" ;; esac
  [ -n "$bm" ] || bm="$(printf '%s' "$_bmline" | grep -oE '\[body-[a-z]+\]' | head -1)"
  # Fallback for the honest-degraded OFFLINE marker (mesh-body-motion writes it when the phone is
  # unreachable): the [body-xxx] regex never matches it, so bm blanks to empty -> bodymark's '?'
  # default, reading as an ambiguous/broken sense while the sibling light=/power= fields on the SAME
  # line show their marker verbatim. Take the TAG (field 2 of the writer's 6-field pipe schema,
  # mesh-body-motion:580 `steps|tag|hyst|pending|dwell_s|changes_24h`), which is where the writer
  # puts OFFLINE (:128 `|OFFLINE||||`, steps deliberately empty = unknown, not a fabricated 0).
  # The 2026-07-05 fallback took the first WHITESPACE token, matching the writer's then-current
  # pipe-less `OFFLINE <ts>` line; the 2026-07-10 fidelity fix moved to the pipe schema and no
  # consumer followed, so an offline phone has rendered as the raw record `motion=|OFFLINE||||`
  # since. Anchor on the writer's printf, never on a token position that outlives its format.
  # last resort: a state in NEITHER shape still renders its own first token, never a silent blank
  [ -n "$bm" ] || bm="$(printf '%s' "$_bmline" | awk '{print $1}')"
  echo "BODY       motion=$(bodymark "$M/.body-motion-state" "$bm" 2100 "$M/body-motion.log") · light=$(bodymark "$M/.light-state" "$(fst "$M/.light-state" | cut -d'|' -f1)" 2100 "$M/light.log") · power=$(bodymark "$M/.body-power-state" "$(fst "$M/.body-power-state" | cut -d'|' -f1 | cut -d' ' -f1)" 2100 "$M/body-power.log") · prox=$(mark "$M/.phone-prox.state" "$(fst "$M/.phone-prox.state" | cut -d'|' -f1 | cut -d' ' -f1)" 4200)"
  # ROOM / activity
  # audio-path is /10 (mesh-audio-path fusion: emit×mic — is our own playback audible?) → 2100s TTL
  # wifi-motion: DEVICE-FREE motion, and it was declared "LIVE-ONLY (mind probes, no cache)" on the
  # completeness line below while `~/.mesh/.wifi-motion-state` was being rewritten every ~5 minutes.
  # The write is UNCONDITIONAL (mesh-wifi-motion:1144 — outside the --edge block, so even a suppressed
  # edge run rewrites it, followed by mesh-state-touch), and TWO cron parents drive it unconditionally:
  # mesh-room-sense (2-59/5, its wifi axis) and mesh-room-activity (3-58/5, _sample_wifi) — neither
  # passes --edge, both call it straight. So the stream is real, cached, and refreshed on a 300s stride;
  # only the ROLL-CALL was blind to it. Same shape as the watchtower row above (a reading bound to the
  # wrong file), inverted: here the artifact was never bound at all, and the sense was BOOKED as having
  # none — which is worse than a stale row, because a declared absence is not something a consumer
  # re-checks. Every derived report reads this roll-call as the one source of truth for what is live
  # (--balance depth, --impasse, --exteriority, --articulation, --viability, --amplification), so ROOM
  # was priced one live stream short in all of them.
  # NOT independent redundancy — say so plainly: mesh-room-sense and mesh-activity-tempo CONSUME
  # mesh-wifi-motion, so room= and tempo= already carry its influence FUSED. What the row adds is the
  # raw verdict token (MOTION/STILL/UNCERTAIN), which no other cached field spells out — a pane or
  # refresh loop on --cached currently cannot read device-free motion at all without a live probe.
  # Its exteriority (many consumers re-plug it) is what --exteriority is for; depth counts the stream.
  # Value = FIRST field only (the vocab contract: first token is MOTION|STILL|UNCERTAIN); the payload
  # after '|' is dwell/changes and deliberately not rendered — the producer's own header warns that raw
  # changes_24h is mostly partial-sweep churn, so surfacing it here would read as room activity.
  # TTL 1200s = 4x the 300s parent stride, matching room= (its co-driven sibling, same writers): a
  # genuinely dead producer still ages honestly to STALE instead of riding the neighbours' liveness.
  echo "ROOM       room=$(mark "$M/.room-sense.state" "$(fst "$M/.room-sense.state")" 1200) · tempo=$(mark "$M/.activity-tempo.state" "$(fst "$M/.activity-tempo.state")" 2100) · ambient=$(mark "$M/.ambient-clock.state" "$(fst "$M/.ambient-clock.state")" 2100) · audio-path=$(mark "$M/.audio-path-state" "$(fst "$M/.audio-path-state" | cut -d'|' -f1)" 2100) · context=$(mark "$M/.room-context.state" "$(fst "$M/.room-context.state")" 600) · media=$(mark "$M/.media-scene.state" "$(fst "$M/.media-scene.state")" 600 "$(evage "$M/.media-scene.state")")$(sed -n '2p' "$M/.media-scene.state" 2>/dev/null | sed -n 's/.*\(attrib=skewed\).*/ [skewed-attrib]/p') · wifi-motion=$(mark "$M/.wifi-motion-state" "$(fst "$M/.wifi-motion-state" | cut -d'|' -f1)" 1200)"
  # PRESENCE / who is physically around
  pl="$(tail -1 "$M/presence.log" 2>/dev/null)"
  pn="$(printf '%s\n' "$pl" | sed -nE 's/.*(n=[0-9]+).*/\1/p')"
  ptop="$(_ptop_render "$pl")"   # see _ptop_render above: `?` now means UNREADABLE only
  # Person-vs-appliance attribution split (mesh-presence enrichment 2026-06-21): a raw count/top can't
  # tell "a human is here" from "appliances are on" (top=[TV] is the trap, live). mesh-presence now emits
  # attribution=personal:P,appliance:A,ambiguous:M as a trailing field on the SAME presence.log line as
  # n/devices — single-source, so the split is ALWAYS the same scan as the n/top shown (no cross-file
  # guard, no intermittent omission). Older lines lacking the field → sed prints nothing → suffix omitted
  # (honest: shows no split until the next --log run writes one).
  pattr="$(printf '%s\n' "$pl" | sed -nE 's/.*attribution=personal:([0-9]+),appliance:([0-9]+),ambiguous:([0-9]+).*/ pers:\1 appl:\2 amb:\3/p')"
  arr="$(grep -iE ':: *\[(arrived|left)' "$M/chat.log" 2>/dev/null | tail -1 | sed -E 's/.*:: *//' | cut -c1-40)"
  echo "PRESENCE   $(mark "$M/presence.log" "${pn:-n=?} top=${ptop:-?}${pattr}" 900)${arr:+ · last: $arr}"
  # HOUSEHOLD / operator
  hs="$(tail -1 "$M/home-state.log" 2>/dev/null | sed -E 's/^\[home-state\] ([A-Z_]+):.*/\1/')"
  echo "HOUSEHOLD  mode=$(mark "$M/.household.state" "$(fst "$M/.household.state")" 1200) · home-state=$(mark "$M/home-state.log" "$hs" 1200) · operator-home=$(mark "$M/.op-home.state" "$(fst "$M/.op-home.state")" 1200)"
  # SITUATION / SECURITY (fused) + watchtower (the eye on the net)
  # stale-limit MUST exceed the reflex cadence or a healthy reflex false-flags every cycle:
  # mesh-{perimeter,situation} --edge are autowired at /45 (max gap 45m=2700s), so 2400s(40m)
  # showed STALE in the 40-45m window of EVERY cycle. 3000s(50m) clears the cadence + grace,
  # while a genuinely missed cycle (age climbs past 50m toward the 90m double-gap) still trips.
  # mesh-perimeter:587 writes: ts \t out \t net \t phy \t VERDICT — the fused verdict is f5, and f2 is
  # only the OUTSIDE sub-axis. cut -f2 rendered perimeter=CALM on a live ALERT whenever the alert came
  # from NETWORK or PHYSICAL (an unknown MAC on the LAN is exactly that shape) — the sub-axis it named
  # was genuinely calm, so the pane read as an all-clear with no staleness tell. mesh-situation:227
  # reads the same file positionally and got ALERT; the two panes disagreed. Take the verdict (f5).
  per="$(fst "$M/.perimeter.state" | cut -f5)"
  # WATCHTOWER: read the reach bit from `.watchtower-state` (field 2), NEVER from `.watchtower-state.reach`.
  # `.reach` is mesh-watchtower's EDGE MEMORY — the previous value the flip-detector compares against,
  # written ONLY on the `--edge --summary` path (mesh-watchtower:369). It is not a published reading and
  # nothing else in the mesh reads it. When the 2026-07-24 GPU-QUIESCE retired watchtower's OWN cron line
  # (`# reflex-cadence: off` → DECLINED-BY-HEADER, reflexes.cron:202) that edge path stopped firing and
  # `.reach` froze at 16:13:03 — so this pane printed `watchtower=reach-ok (STALE)` and would have printed
  # it FOREVER, a 3h-old sample under a name a reader takes as current-ish.
  # But the ORGAN never stopped. mesh-perimeter (cron 9-59/15, LIVE) invokes `mesh-watchtower` as a CHILD
  # every 15m (mesh-perimeter:578), and EVERY invocation writes `.watchtower-state` — since 2026-08-28
  # `<external_knock_total> <reach_up:0|1> v2` (field 1 was every sshd line, our own tailnet logins
  # included; the trailing `v2` is mesh-watchtower's own format gate), OUTSIDE the edge block. The bit
  # this reader wants is field 2 and it did not move. Measured 2026-08-20: `.watchtower-state`
  # mtime 19:09:03 (the :09 perimeter tick, 30s old) against `.reach` 16:13:03, same bit `1` in both.
  # THE SHAPE: a retired INVOCATION PATH is not a retired ORGAN. Retiring one path freezes exactly the
  # artifacts only that path wrote, while the organ keeps running under a parent and keeps its value fresh
  # somewhere else — and the frozen file still holds a plausible constant (`reach-ok`), so nothing looks
  # broken. Bind a reading to the artifact the SURVIVING writer writes, never to a path-scoped side file.
  # TTL from the PARENT's stride (perimeter /15 → max gap 900s) + grace = 2100s, so if mesh-perimeter
  # itself dies this ages honestly to STALE instead of inheriting watchtower's own retired cadence.
  # Also: `!= 1 → reach-BLIND` collapsed a REAL blind read with an absent/unparseable file. Three states.
  _wtbit="$(fst "$M/.watchtower-state" | awk '{print $2}')"
  case "$_wtbit" in 1) wtr=reach-ok ;; 0) wtr=reach-BLIND ;; *) wtr=reach-UNREADABLE ;; esac
  echo "SITUATION  situation=$(mark "$M/.situation.state" "$(fst "$M/.situation.state")" 3000) · perimeter=$(mark "$M/.perimeter.state" "$per" 3000) · watchtower=$(mark "$M/.watchtower-state" "$wtr" 2100)"
  # COORDINATION — when may the mesh speak/alert? (mesh-interruptibility fuses kbd+screen+room+
  # ambient+tempo+light+operator-awake+time → band). /12 cadence (max gap 12m=720s) → 1500s(25m) clears
  # cadence + grace; a dead reflex ages past it to honest STALE so the mind never trusts a stale band.
  # The record is `<BAND>|degraded=<csv>` (mesh-interruptibility --edge). The band alone was all this
  # row ever showed, which made the producer's two DIFFERENT UNKNOWNs render as one word: a diffuse
  # posterior over REAL reads (nothing to fix — a refresh would not help) and a blind fusion whose
  # kbd/screen axes are dead (the organ IS the fix) both printed `interruptibility=UNKNOWN`. On this
  # node the second is the permanent case, so the row was a blindness sentinel wearing a reading's
  # clothes. Render the dead axes inline — `UNKNOWN(blind:kbd,screen)` — so the consuming mind reads
  # the band AND its coverage in one glance. Empty degraded → no marker (the clean claim stays clean).
  # The record grew a THIRD field 2026-08-20: `<BAND>|na=<csv>|degraded=<csv>`. blind and n/a are
  # NOT the same clause and must not render as one word. `blind:` = a sense that should be producing
  # and is not — the organ is the fix, and the band is withholding an all-clear until it returns.
  # `n/a:` = a sense this body does not have (the organ's own --test exits 2); nothing is coming
  # back, so the band is a REAL verdict resting on a NARROWER axis set, and the set is named so a
  # consumer can never mistake it for a full-evidence one. Rendering absence as blindness is what let
  # this row sit at UNKNOWN(blind:kbd,screen) for 240 runs while reading as a fault someone could fix.
  _ib_rec="$(fst "$M/.interruptibility.state")"; _ib_v="${_ib_rec%%|*}"
  _ib_deg="${_ib_rec#*|degraded=}"; [ "$_ib_deg" = "$_ib_rec" ] && _ib_deg=""   # no payload → old/clean record
  _ib_na="${_ib_rec#*|na=}"; [ "$_ib_na" = "$_ib_rec" ] && _ib_na="" || _ib_na="${_ib_na%%|*}"
  [ -n "$_ib_deg" ] && _ib_v="${_ib_v}(blind:$(printf '%s' "$_ib_deg" | sed 's/-unreachable//g; s/-unknown//g'))"
  [ -n "$_ib_na" ]  && _ib_v="${_ib_v}(n/a:${_ib_na})"
  echo "COORDINATION interruptibility=$(mark "$M/.interruptibility.state" "$_ib_v" 1500)"
  # NODE (this body's own hardware sense)
  echo "NODE       $(mark "$M/.hw-health.state" "$(fst "$M/.hw-health.state")" 7200)"
  # the senses with NO persistent cache — listed so the roll-call is honestly COMPLETE; the mind
  # probes these live (mesh-sensorium with no flag, or the individual tool).
  echo "LIVE-ONLY (mind probes, no cache): body-context · tamper · operator-state · location · lan-health · lan-newdevice · find · keypresence · audio-active · jack · netrate · irq-rate · proc-churn · wake"
  exit 0
fi

if [ "${1:-}" = --balance ]; then
  # RR efficiency<->resiliency report (see the header). READ-ONLY: reuses --cached's roll-call (the ONE
  # source of truth for what's live) and counts, per percept-category, how many cached streams are LIVE
  # (fresh/recent/aging) vs dead (STALE / absent(—) / OFFLINE). DEPTH = live streams; depth 1 = single
  # point of sensory failure (over-efficient/brittle), depth 0 = blind, depth>=2 = resilient (redundant).
  # GRANULARITY CAVEAT (honest, in the mesh-precision frame_coverage spirit): depth is measured at
  # CACHED-STREAM granularity — a category rendered as one fused field (e.g. PRESENCE fuses many organs
  # into presence.log) reads single-source even so, because at the sensorium level that ONE stream dying
  # blinds the category regardless of how many organs feed it. That is a real brittleness, not an artifact.
  echo "=== sensorium efficiency<->resiliency balance @ $ts — $HOST ==="
  echo "(RR opponent processing — Vervaeke 2012/2024: resiliency=redundant independent live streams,"
  echo " efficiency=fewest streams per percept. depth=LIVE cached streams; 1=single point of failure, 0=blind.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  printf '%s\n' "$roll" | awk '
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1
      l=$0; live =gsub(/\((fresh|recent|aging)\)/,"",l)
      s=$0; stale=gsub(/\(STALE\)/,"",s)
      d=$0; dash =gsub(/\(—\)/,"",d)
      # count ONLY the offline MARKER bodymark emits (OFFLINE(phone)), never the value-word "OFFLINE"
      # (motion=OFFLINE / power=OFFLINE are live values carrying their own freshness bucket — the bucket
      # above already counted them; matching bare OFFLINE double-counted them into total, the /6-not-/4 bug)
      o=$0; off  =gsub(/OFFLINE\(phone\)/,"",o)
      # FOURTH bucket — a stream alive only on a SUBSTITUTE tier, which mark() renders `(<tier>-derived)`
      # / `(<tier>-derived <N>m)`. It matched NONE of the three buckets above, so a sense that fell back
      # dropped out of `live` AND out of `total` — the category silently shrank by exactly its DEGRADED
      # streams, and a category with only derived fields vanished from the report entirely (total==0 →
      # next). Excluding a substitute from LIVE is the right polarity (a fallback is not the organ); what
      # was wrong is that nothing then counted it at all. Keep it in the TOTAL and name it.
      v=$0; deriv =gsub(/\([a-z]+-derived([[:space:]][0-9]+m)?\)/,"",v)
      total=live+stale+dash+off+deriv
      if(total==0) next
      cats++
      tag=""; dtag=(deriv>0? sprintf(" · %d on a fallback tier", deriv) : "")
      if(live==0 && deriv>0){ tag=" ⚠ FALLBACK-ONLY (no direct stream — every reading is a substitute tier)"; fallback++ }
      else if(live==0){ tag=" ⚠ BLIND (no live stream)"; blind++ }
      else if(live==1){ tag=" ⚠ single-source (single point of sensory failure)"; single++ }
      else resilient++
      printf "  %-12s depth %d/%d live%s%s\n", cat, live, total, dtag, tag
    }
    END{
      brittle=blind+single+fallback
      printf "\n  streams: %d resilient (depth>=2) · %d single-source · %d fallback-only · %d blind  (of %d categories)\n", \
        resilient, single, fallback+0, blind, cats
      if(cats==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      if(blind>0){
        printf "  posture: BLIND-SPOTS — %d categor%s have no live stream; resiliency has failed there, not just thinned\n", blind, (blind==1?"y":"ies")
        exit 4
      }
      if(brittle*2 >= cats){
        printf "  posture: BRITTLE (efficiency-pinned) — %d of %d categories rest on a single stream; the opponent balance has collapsed toward efficiency, one death from a blind spot\n", brittle, cats
        exit 3
      }
      print  "  posture: balanced — most categories carry redundant live streams (resiliency intact)"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --impasse ]; then
  # RR insight / reframe-at-impasse report (see the header). READ-ONLY: reuses --cached's roll-call (the
  # ONE source of truth for what's live) and flags each percept-category with a field that is LIVE
  # (fresh/recent/aging bucket) yet UNRESOLVED (value renders as `?` or UNKNOWN — mark() writes `?` when a
  # fresh producer's state is empty/unparseable). That is the frame FED-but-uncarving = an IMPASSE, the
  # insight-trigger: restructure HERE (a new/cross sense, mesh-sense-evolve) rather than restart. It is
  # DISTINCT from a STALE field (dead producer → liveness, --balance/reflex-health) and from an ABSENT one.
  # GRANULARITY CAVEAT (honest, the frame_coverage/--balance spirit): impasse is detected only where the
  # WHOLE field value is unresolved (`name=? (fresh)`); a compound field (e.g. PRESENCE `n=? top=?`) whose
  # `?` sits mid-value is a conservative MISS, never a false alarm — this under-reports, it never over-reports.
  echo "=== sensorium insight: reframe-at-impasse @ $ts — $HOST ==="
  echo "(RR frame-BREAKING — Vervaeke: insight = reframe at an IMPASSE. impasse = a percept the frame is"
  echo " FED (live stream) but cannot CARVE (value UNKNOWN/?) — the hollow sense seen from the RR side,"
  echo " a candidate for RESTRUCTURING, not a restart. A dead/stale producer is liveness, not impasse.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  printf '%s\n' "$roll" | awk '
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1
      l=$0; live=gsub(/\((fresh|recent|aging)\)/,"",l)
      # a field alive only on a SUBSTITUTE tier — `(<tier>-derived[ <N>m])`, mark()'"'"'s FOURTH render shape,
      # which matches none of the freshness words. It is FED (by a fallback), so it belongs in this view'"'"'s
      # totals; before this the frame silently shed exactly the degraded senses from both sides.
      v=$0; deriv=gsub(/\([a-z]+-derived([[:space:]][0-9]+m)?\)/,"",v)
      # a LIVE field whose entire value is unresolved (`?` or UNKNOWN) right before its freshness bucket —
      # a derived field that carries no determination is fed-but-uncarving too, so it counts here as well.
      c=$0; imp=gsub(/=[[:space:]]*(\?|[Uu][Nn][Kk][Nn][Oo][Ww][Nn])[[:space:]]*\((fresh|recent|aging|[a-z]+-derived([[:space:]][0-9]+m)?)\)/,"",c)
      livetotal+=live; derivtotal+=deriv
      dtag=(deriv>0? sprintf(" (+%d on a fallback tier)", deriv) : "")
      if(imp>0){ impcats++; imptotal+=imp; printf "  %-12s IMPASSE — %d live field(s) fed but unresolved (reframe candidate)%s\n", cat, imp, dtag }
      else if(live+deriv>0) printf "  %-12s framed — %d live field(s) resolve%s\n", cat, live, dtag
    }
    END{
      if(livetotal+derivtotal==0){ print "\n  posture: NO LIVE STREAMS — nothing to frame (liveness is --balance/reflex-health'"'"'s concern, not impasse)"; exit 0 }
      printf "\n  %d live field(s) (+%d on a fallback tier); %d in IMPASSE across %d categor%s\n", livetotal, derivtotal+0, imptotal+0, impcats+0, (impcats==1?"y":"ies")
      if(imptotal>0){ print "  posture: IMPASSE — the frame is fed but cannot carve these percepts; the insight-trigger. Restructure (mesh-sense-evolve: enrich/cross/new-sense targeting the category above), do not restart."; exit 3 }
      print "  posture: FRAMED — every live percept resolves to a determinate value (no reframe warranted)"; exit 0
    }'
  exit $?
fi


if [ "${1:-}" = --exteriority ]; then
  # ASSEMBLAGE relations of exteriority (see the header). READ-ONLY. The CONSUMER-side dual of --balance:
  # for each CACHED stream the roll-call knows, count how many DISTINCT tools re-plug it (reference its
  # basename), so a stream's DETACHABILITY is visible. BINDIR overridable (default ~/.local/bin) so the
  # --test can drive a crafted toolset. AGGREGATOR EXCLUSION: mesh-sensorium + mesh-dash read ~every
  # stream (this tool and the pane) — counting them would mask every stream as EXTERIOR, so both are
  # named-excluded (honest, stated in the header, not a fuzzy heuristic).
  BINDIR="${MESH_BINDIR:-$HOME/.local/bin}"
  # canonical cached-stream set — the SAME file-backed senses the --cached roll-call renders, DERIVED from
  # the shared STREAM_FILE_MAP above (dedup, first-appearance order) so the two readers cannot drift.
  STREAMS="$(printf '%s\n' $STREAM_FILE_MAP | sed 's/^[^=]*=//' | awk '!seen[$0]++' | tr '\n' ' ')"
  echo "=== sensorium relations-of-exteriority @ $ts — $HOST ==="
  echo "(Deleuze&Guattari/DeLanda: an assemblage's parts are DETACHABLE — re-pluggable into other"
  echo " assemblages. refs=distinct OTHER tools re-plugging the cached stream (aggregators sensorium/dash"
  echo " excluded). >=2 EXTERIOR(detachable) · 1 WELDED(interiority,1:1) · 0 EXPRESSIVE-ONLY(drives nothing).)"
  ext=0; welded=0; expr=0; np=0; total=0
  for s in $STREAMS; do
    # distinct tool FILES (mesh-*) referencing the basename as a FIXED string, minus the two aggregators.
    # producer is counted among refs (it writes its own file); the classify below subtracts it implicitly
    # by banding on the CONSUMER floor: refs>=3 => producer+>=2 consumers, ==2 => producer+1, ==1 =>
    # producer only, ==0 => no tool references it (external/absent producer).
    n=$(grep -lF "$s" "$BINDIR"/mesh-* 2>/dev/null | sed 's#.*/##' | grep -vxE 'mesh-sensorium|mesh-dash' | sort -u | wc -l)
    total=$((total+1))
    if   [ "$n" -ge 3 ]; then cls="EXTERIOR"; tag=""; ext=$((ext+1))
    elif [ "$n" -eq 2 ]; then cls="WELDED"; tag=" ⚠ interiority (1:1 coupling — modular-looking, co-constituted)"; welded=$((welded+1))
    elif [ "$n" -eq 1 ]; then cls="EXPRESSIVE-ONLY"; tag=" ⚠ drives nothing downstream (cache re-plugged by no other tool)"; expr=$((expr+1))
    else cls="NOT-PRODUCED"; tag=" ⚠ no tool references it — pane reads a stream with no visible producer"; np=$((np+1)); fi
    printf "  %-24s refs %-2d %-14s%s\n" "$s" "$n" "$cls" "$tag"
  done
  echo ""
  printf "  streams: %d exterior (detachable) · %d welded · %d expressive-only · %d not-produced  (of %d)\n" \
    "$ext" "$welded" "$expr" "${np:-0}" "$total"
  if [ "$total" -eq 0 ]; then echo "  posture: NO STREAMS"; exit 2; fi
  if [ "${np:-0}" -gt 0 ] || [ "$expr" -gt 0 ]; then
    printf "  posture: EXPRESSIVE-DEADENDS — %d stream(s) re-plugged by no other tool; the sensorium caches signs that drive nothing (or have no producer)\n" "$((expr+${np:-0}))"
    exit 4
  fi
  if [ $((welded*2)) -ge "$total" ]; then
    printf "  posture: INTERIORITY-PINNED — %d of %d streams are welded 1:1; the sensory graph is co-constituted, not assemblage-mobile\n" "$welded" "$total"
    exit 3
  fi
  echo "  posture: EXTERIOR — most streams are detachable / re-plugged across assemblages (relations of exteriority intact)"
  exit 0
fi

if [ "${1:-}" = --viability ]; then
  # ── SECOND-ORDER CYBERNETICS: RELATIONAL VIABILITY, NON-COMPENSATORY (--viability, live review 2026-08-11)
  # LITERATURE (cross-domain transfer to a distributed sensor mesh). Leonardo Lavanderos (Corporación
  # Sintesys, Santiago), two 2026 Kybernetes papers in the live von-Foerster line:
  #   · "Beyond recursive observation: relational viability in von Foerster's cybernetics", Kybernetes,
  #     ahead-of-print 23 Jun 2026, doi:10.1108/K-12-2025-3181 — the finding, verbatim from the abstract:
  #     "interactional density, informational throughput and recursive closure are insufficient to
  #     discriminate between configurations that remain STABLE and those that remain VIABLE". The answer is
  #     NOT another recursive level; it is a minimal relational differentiation — triferential relational
  #     logic (TRL) — over three invariants: POSITION, FUNCTION, SENSE.
  #   · "Biovariety (BV): a new relational indicator of ecological viability based on position, function and
  #     meaning", Kybernetes, 4 May 2026, doi:10.1108/K-11-2025-2749 — the same logic made into a metric,
  #     against biodiversity indices: three "non-substitutable dimensions" (Position = structural adequacy ·
  #     Function = processual contribution · Stability/Meaning = legitimacy) combined NON-COMPENSATORILY, so
  #     "high scores in one dimension" cannot "mask deficiencies in others". A COUNT OF WHAT IS PRESENT IS
  #     NOT A MEASURE OF VIABILITY. (Abstracts + publisher metadata read; both full texts are paywalled —
  #     BV's formula, its V_req threshold and VNRe reserves are NOT reproduced here, and nothing below
  #     quotes a number of theirs. What transfers is the non-compensatory RULE, which the abstracts state
  #     outright.)
  # WHERE WE HAD BEEN: --balance counts LIVE streams per percept-category (depth = richness) and calls
  # depth>=2 "resilient"; --degeneracy asks whether those streams are structurally DISTINCT; --amplification
  # removes substrate classes in pairs. ALL THREE COUNT THE SAME UNIT — a roll-call field carrying a
  # freshness bucket — i.e. PRESENCE ALONE. That is exactly the insufficiency the 2026 paper names: our
  # resiliency reading is a species count. --impasse is the nearest neighbour and covers ONE cell of the
  # grid (a live field whose value is `?`/UNKNOWN) but it never re-prices depth, never sees a stream that
  # reports its own organ OFFLINE (a determinate-looking value that determines nothing about the world),
  # and never asks whether anything downstream reads the stream at all.
  # THE TRANSFER: a stream contributes to its category only if all three invariants hold, with NO trade-off
  # between them (the whole content of TRL — a mean or a weighted sum would re-admit exactly the masking
  # the paper is about):
  #   POSITION  structural adequacy   — the field occupies its place in the roll: fresh|recent|aging.
  #                                     THIS IS THE ONLY TEST --balance/--degeneracy/--amplification APPLY.
  #   FUNCTION  processual contribution— its value carries a determination ABOUT THE WORLD: not ?/UNKNOWN
  #                                     (the --impasse cell), not a self-report that the organ is
  #                                     OFFLINE/DOWN/DEAD/ABSENT/BLIND/n-a, and not a fusion self-declaring
  #                                     its inputs dark (`axes-dark`). A fresh reflex writing "the phone is
  #                                     unreachable" is a live PRODUCER and a null PERCEPT.
  #   SENSE     legitimacy/meaning     — some tool OTHER than the producer re-plugs the stream (consumer
  #                                     fan-out >=1, --exteriority's refs>=2 band, same aggregator
  #                                     exclusion). A reading nothing reads means nothing to the mesh.
  # Then vdepth = streams passing P AND F AND S, printed BESIDE the depth the other axes publish, so the
  # gap between richness and viability is the artifact. Report-only: it changes no other mode's verdict.
  # HONEST BOUNDARIES: (1) a roll field this build cannot key to an artifact is UNASSESSED on SENSE and is
  # never counted as non-viable — the verdicts fire on CONFIRMED failures only, so this under-reports and
  # cannot manufacture an alarm. (2) FUNCTION reads the value's FIRST token against a NAMED alphabet
  # (below) — a value that lies about its own organ still passes, which is the hollow-sense problem and is
  # not this axis's job. (3) `n` and `top` are two fields of ONE presence.log stream: they share a SENSE
  # score by construction (the map says so), they are not independent evidence. Artifact:
  # docs/reviews/second-order-cyb-relational-viability-noncompensatory-sensorium-2026-08-11.md
  BINDIR="${MESH_BINDIR:-$HOME/.local/bin}"
  echo "=== sensorium relational viability (triferential, non-compensatory) @ $ts — $HOST ==="
  echo "(Lavanderos, Kybernetes 2026 — K-12-2025-3181 / K-11-2025-2749: presence, throughput and closure"
  echo " cannot tell a STABLE configuration from a VIABLE one. A stream counts only if POSITION(fresh) AND"
  echo " FUNCTION(value determines something) AND SENSE(some other tool reads it) — no dimension compensates"
  echo " another. depth = what --balance/--degeneracy count; viable = what survives all three.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  # SENSE dimension, computed once per roll FIELD from the shared map (same counting rule as --exteriority:
  # distinct mesh-* tools referencing the artifact basename, aggregators excluded; refs>=2 => >=1 consumer
  # besides the producer).
  _fan=""
  for kv in $STREAM_FILE_MAP; do
    _nm="${kv%%=*}"; _f="${kv#*=}"
    _n=$(grep -lF "$_f" "$BINDIR"/mesh-* 2>/dev/null | sed 's#.*/##' | grep -vxE 'mesh-sensorium|mesh-dash' | sort -u | wc -l)
    _fan="$_fan $_nm=$_n"
  done
  printf '%s\n' "$roll" | awk -v fanmap="$_fan" '
    BEGIN{
      _n=split(fanmap,_r," "); for(_i=1;_i<=_n;_i++){ split(_r[_i],_kv,"="); fan[_kv[1]]=_kv[2]+0; known[_kv[1]]=1 }
      # NAMED alphabet of values that carry no determination about the world (FUNCTION fails). Stated, not
      # fuzzy: matched against the value first token, case-folded, whole-token.
      _m=split("? UNKNOWN OFFLINE DOWN DEAD ABSENT BLIND UNREACH UNREACHABLE N/A NA NONE - —", _a, " ")
      for(_i=1;_i<=_m;_i++) nullv[toupper(_a[_i])]=1
    }
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1; line=$0; sub(/^[A-Za-z]+[[:space:]]+/,"",line)
      s=line; depth=0; vdepth=0; unassessed=0; derived=0; det=""
      # POSITION also holds for a field alive on a SUBSTITUTE tier (`(<tier>-derived[ <N>m])`): it occupies
      # its place in the roll. Matching only the three freshness words made every degraded sense invisible
      # to this axis — dropped from depth AND from viable, so the gap this report exists to show closed by
      # deletion rather than by repair. Enumerate it, then name how many are on a fallback.
      while (match(s, /[A-Za-z][A-Za-z_-]*=[^()]*\((fresh|recent|aging|[a-z]+-derived([[:space:]][0-9]+m)?)\)/)) {
        tok=substr(s,RSTART,RLENGTH); eq=index(tok,"="); name=substr(tok,1,eq-1)
        val=substr(tok,eq+1); if(val ~ /\([a-z]+-derived([[:space:]][0-9]+m)?\)[[:space:]]*$/) derived++
        sub(/[[:space:]]*\((fresh|recent|aging|[a-z]+-derived([[:space:]][0-9]+m)?)\)[[:space:]]*$/,"",val)
        s=substr(s, RSTART+RLENGTH)
        depth++                                   # POSITION holds: it is what put the field in this roll
        head=val; sub(/[ |].*$/,"",head)          # value first token (fields are `V|k=v|k=v` or `V extra`)
        F=1; why=""
        if(head=="" || (toupper(head) in nullv)){ F=0; why="FUNCTION ✗ value carries no determination (" (head==""?"<empty>":head) ")" }
        else if(val ~ /axes-dark/){ F=0; why="FUNCTION ✗ fusion self-declares its input axes dark" }
        # SENSE unassessable (no artifact mapped for this field): counted as NEITHER viable nor non-viable,
        # and it SUPPRESSES the category verdicts below — an unknown is not evidence in either direction.
        if(!(name in known)){ unassessed++
                              det=det sprintf("\n      %-22s %s[SENSE unassessed: no artifact mapped for this field]", name "=" val, (F?"":why " · "))
                              continue }
        S=(fan[name]>=2)
        if(F && S){ vdepth++; continue }
        if(!F && !S) why=why sprintf(" · SENSE ✗ no other tool reads it (refs %d)", fan[name])
        else if(!S)  why=sprintf("SENSE ✗ no other tool re-plugs this stream (refs %d)", fan[name])
        det=det sprintf("\n      %-22s %s", name "=" val, why)
        nonviable++
      }
      if(depth==0) next
      cats++
      tag=""
      if(unassessed>0){ tag=sprintf("  (%d field(s) unassessed on SENSE — no verdict)", unassessed) }
      else if(vdepth==0){ tag="  ⚠ VIABILITY-BLIND — reads live, contributes nothing"; blind++ }
      else if(depth>=2 && vdepth<=1){ tag=sprintf("  ⚠ RICHNESS-INFLATED — the redundancy the other axes price (depth %d) is carried by %d viable stream", depth, vdepth); infl++ }
      printf "  %-12s depth %d → viable %d%s%s%s\n", cat, depth, vdepth, (derived>0? sprintf("  (%d on a fallback tier)", derived) : ""), tag, det
      totd+=depth; totv+=vdepth; totu+=unassessed; totdv+=derived
    }
    END{
      if(cats==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      printf "\n  streams: %d present (POSITION) → %d viable (P∧F∧S) · %d non-viable · %d unassessed on SENSE · %d on a fallback tier  (across %d categories)\n", \
        totd+0, totv+0, nonviable+0, totu+0, totdv+0, cats
      if(blind>0){
        printf "  posture: VIABILITY-BLIND — %d categor%s carr%s live stream(s) that contribute nothing; presence is masking a dead percept (Lavanderos 2026: stable, not viable)\n", \
          blind, (blind==1?"y":"ies"), (blind==1?"ies":"y"); exit 4
      }
      if(infl>0){
        printf "  posture: RICHNESS-INFLATED — %d categor%s read redundant by stream COUNT but hold <=1 viable stream; --balance/--degeneracy/--amplification are pricing presence, not contribution\n", \
          infl, (infl==1?"y":"ies"); exit 3
      }
      print "  posture: viable — every category'"'"'s live streams also carry a determination and are read downstream (richness == viability here)"
      exit 0
    }'
  exit $?
fi

# ── SUBSTRATE-CLASS MAP — ONE definition, TWO readers (--degeneracy · --amplification) ───────────────
# Grounded in each field's VERIFIED producer inputs, not guessed. The common-mode is the dependency whose
# single death degrades every stream in the class together:
#   phone  = phone reachable over SSH/termux: motion,light,power,prox (direct phone sensors) + tempo
#            (mesh-activity-tempo fuses tamper+body-motion+light — phone axes; "axes-dark" == phone down)
#            + context (mesh-body-context = body-motion + ambient light — phone)
#   audio  = mic + STT/audio stack: room,ambient,audio-path,media
#   ble    = BLE radio scan: presence (n/top — one fused stream anyway)
#   net    = network reachability: watchtower
#   derived= on-node fusion of OTHER categories (shares its upstreams' fate): mode,home-state,
#            operator-home,situation,perimeter,interruptibility
#   node   = on-node procfs/hw: HW
# An unmapped field falls to its OWN class ("other:<name>") — conservative: it can only ADD degeneracy,
# never manufacture a false monoculture.
# It lives HERE, above both readers, because a second copy would rot out of agreement with the first and
# each axis would then be measuring a different mesh (a rule asserted at one call site is not asserted).
SUBSTRATE_CLASS_MAP="motion=phone light=phone power=phone prox=phone tempo=phone context=phone
room=audio ambient=audio audio-path=audio media=audio
n=ble top=ble
watchtower=net
mode=derived home-state=derived operator-home=derived situation=derived perimeter=derived interruptibility=derived
HW=node"

if [ "${1:-}" = --degeneracy ]; then
  # ── ANTIFRAGILITY: DEGENERACY vs REDUNDANCY (--degeneracy — live review 2026-07-31) ─────────────────
  # LITERATURE (cross-domain transfer to a distributed sensor mesh). Redundancy = the SAME function by
  # IDENTICAL elements; DEGENERACY = the same function by STRUCTURALLY DIFFERENT elements (Edelman & Gally,
  # "Degeneracy and complexity in biological systems", PNAS 98:13763-68, 2001). The distinction is the
  # whole game under CORRELATED / common-mode failure: Hassan & Dey, "Degeneracy-Aware Functional and
  # Algorithmic Resilience in Virtualized 6G Networks Under Correlated Failures" (arXiv:2605.03035, 2026)
  # show "redundancy counts alone OVERESTIMATE resilience because replicas share platforms, software
  # stacks, and dependencies — a single disruption invalidates several apparent backups at once", and give
  # the Functional Substitution Score FSS(f)=fraction of realization PAIRS that are structurally distinct.
  # WHERE WE'D BEEN: --balance already reads efficiency<->resiliency, calling a percept-category with
  # depth>=2 LIVE streams "resilient (redundant)". NOT embodied: whether those >=2 streams are
  # structurally DISTINCT (degenerate — survive a common-mode event) or a MONOCULTURE (all riding the ONE
  # substrate, so one death takes them together). BODY reads depth 3 (motion+light+power) — "resilient" —
  # yet all three ride the ONE phone over the ONE SSH transport (memory: mesh-home-eyes-loss-usb-webcam-
  # wedge, note3 adb SIGABRT): one phone-unreachable event blinds the whole "resilient" category at once.
  # THE TRANSFER: group each category's LIVE streams into COMMON-MODE CLASSES by the failure-carrying
  # substrate they share, then report DEGENERACY = number of distinct classes (vs --balance's raw depth =
  # redundancy) and FSS = cross-class pairs / all pairs. depth>=2 but 1 class => MONOCULTURE: --balance's
  # "resilient" is an overestimate. Report-only; artifact: docs/reviews/antifragility-degeneracy-vs-
  # redundancy-mesh-sensorium-2026-07-31.md
  # (Substrate-class map: the shared SUBSTRATE_CLASS_MAP defined above this block.)
  echo "=== sensorium degeneracy vs redundancy @ $ts — $HOST ==="
  echo "(Edelman&Gally PNAS 2001 / Hassan&Dey arXiv:2605.03035 2026: redundancy=identical replicas,"
  echo " degeneracy=structurally-distinct pathways. depth=LIVE streams (redundancy, --balance's axis);"
  echo " degen=distinct common-mode classes; FSS=cross-class pairs/all pairs. depth>=2 & degen 1=MONOCULTURE.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  printf '%s\n' "$roll" | awk -v map="$SUBSTRATE_CLASS_MAP" '
    BEGIN{ _n=split(map,_m," "); for(_i=1;_i<=_n;_i++){ split(_m[_i],_kv,"="); c[_kv[1]]=_kv[2] } }
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1; line=$0; sub(/^[A-Za-z]+[[:space:]]+/,"",line)
      depth=0; delete cls_here; ncls=0; classes=""
      s=line
      # the freshness alphabet is FOUR shapes, not three: a stream on a substitute tier renders
      # `(<tier>-derived[ <N>m])`. It still rests on its mapped substrate class (the tier is a fallback
      # TRANSPORT, not an independent organ — classing it separately would manufacture degeneracy this
      # node does not have), so it keeps its class and simply stops falling out of the depth.
      while (match(s, /[A-Za-z][A-Za-z_-]*=[^()]*\((fresh|recent|aging|[a-z]+-derived([[:space:]][0-9]+m)?)\)/)) {
        tok=substr(s,RSTART,RLENGTH); eq=index(tok,"="); name=substr(tok,1,eq-1)
        k=(name in c)? c[name] : ("other:" name)
        depth++
        if(!(k in cls_here)){ cls_here[k]=1; ncls++; classes=(classes==""?k:classes" "k) }
        cls_count[k]++
        s=substr(s, RSTART+RLENGTH)
      }
      if(depth==0) next
      cats++
      # FSS = 1 - sum(m_i*(m_i-1)) / (depth*(depth-1)); m_i = streams in class i (over classes seen HERE)
      pairs=depth*(depth-1); same=0
      for(k in cls_here){ m=cls_count[k]; same+=m*(m-1) }
      # (cls_count is global; recompute per-category counts locally instead)
      fss=(pairs>0)?(1-(same/pairs)):0
      tag=""
      if(depth>=2 && ncls==1){ tag=sprintf(" ⚠ MONOCULTURE (%s) — --balance calls this resilient; one common-mode event blinds all %d", classes, depth); mono++ }
      else if(depth>=2 && ncls>=2){ resilient++ }
      printf "  %-12s depth %d  degen %d [%s]  FSS %.2f%s\n", cat, depth, ncls, classes, fss, tag
      delete cls_count
    }
    END{
      if(cats==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      printf "\n  categories: %d truly-degenerate (depth>=2, >=2 classes) · %d MONOCULTURE (depth>=2, 1 class)  (of %d)\n", resilient+0, mono+0, cats
      if(mono>0){
        printf "  posture: REDUNDANCY-OVERESTIMATE — %d categor%s read redundant (depth>=2) but rest on a SINGLE substrate; --balance overstates their resiliency (Hassan&Dey 2026)\n", mono, (mono==1?"y":"ies")
        exit 3
      }
      print "  posture: degenerate — redundant categories draw on structurally-distinct substrates (common-mode resilient)"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --amplification ]; then
  # ── ANTIFRAGILITY: THE NONLINEARITY OF JOINT FAILURE (--amplification — live review 2026-08-04) ─────
  # LITERATURE (cross-domain transfer to a distributed sensor mesh). Fialkowski, Havlin & Thurner,
  # "Catastrophic disruption cascades driven by the nonlinearity of systemic risk", arXiv:2607.20068
  # (submitted 22 Jul 2026, econ.GN) — building on the single-node ESRI of Diem, Borsos, Reisch, Kertesz &
  # Thurner, "Quantifying firm-level economic systemic risk from nation-wide supply networks", Sci Rep
  # 12:7719 (2022, arXiv:2104.07260). Their result, verbatim from the abstract: "the systemic risk
  # contributions of COMBINATIONS of firm failures can be drastically larger than the sum of the damage
  # caused by the firms individually ... combined failures can produce systemic risk amplifications of up
  # to a factor of 257. However, only a tiny fraction of 0.14% of pairs exhibit a more than 4-fold
  # amplification ... The origin of these amplifications is a BREAKDOWN OF THE SUBSTITUTABILITY of
  # defaulted suppliers." Two things make this load-bearing and not just "cascades are bad": (a) the
  # amplification is superadditive and extremely heavy-tailed — nearly every pair is harmless and a
  # handful are catastrophic; (b) an individually-harmless node is NOT safe, so a ranking of SINGLE-point
  # impacts — however careful — cannot find the dangerous combinations at all. Exactly the situations the
  # paper names (a disaster, a war) are the ones that take several nodes at once.
  # WHERE WE HAD BEEN: --balance counts LIVE streams per percept-category (redundancy). --degeneracy (above)
  # asks whether those streams are structurally DISTINCT, and calls a category with >=2 substrate classes
  # "truly-degenerate (common-mode resilient)". BOTH are SINGLE-failure readings: --degeneracy retires a
  # category from worry the moment TWO classes back it, because no ONE class death blinds it. NOTHING in
  # the mesh ever removes TWO substrates at once and prices what dies. That is precisely the blind spot the
  # 2026 result names: our own live roll has ROOM at degen 2 [audio phone] — "resilient", and it IS
  # resilient to either death alone — yet phone-down + audio-down together blinds the whole room percept,
  # and every derived sense that fuses it. Neither single-point loss predicts that; the joint one is not
  # the sum, it is the substitutability running out.
  # THE TRANSFER: treat each substrate class as a "firm" and define the systemic loss of a failure set S as
  #   L(S) = number of percept-categories BLINDED (every live stream in the category belongs to a class in
  #          S — the category has no surviving pathway).
  # Then, for each PAIR of classes, the amplification A(i,j) = L({i,j}) / (L(i) + L(j)) — the paper's ratio,
  # joint damage over the sum of individual damages. A == 1: substitutable/additive. A > 1: SUPERADDITIVE.
  # L(i)=L(j)=0 while L({i,j})>0: a PURE-JOINT pair, amplification unbounded — costs nothing apart, blinds
  # categories together, and is INVISIBLE to every single-point ranking the mesh already runs. Report-only.
  # HONEST BOUNDARIES (the point, not omissions): (1) the loss UNIT is percept-categories blinded — coarse,
  # and deliberately so, because it needs nothing beyond the roll --degeneracy already parses; a finer unit
  # (consumers downstream, which --exteriority already counts per stream) would sharpen the ratio and is the
  # obvious next refinement, HELD until the fan-out map is worth wiring in. (2) blinding is FIRST-ORDER: a
  # `derived` category whose upstream classes all died still reads live here as long as its own .state file
  # is fresh, so this UNDERSTATES the cascade — the true amplification is at least what is printed, never
  # less. Naming the direction of the error is the whole obligation; a second-order cascade needs a VERIFIED
  # per-derived-sense upstream map, not a guessed one. (3) A is a ratio of small integers on a 6-category
  # sensorium — the paper's 257x lives on a national supply network; do not quote a magnitude here as if it
  # were theirs. Artifact: docs/reviews/antifragility-joint-failure-amplification-mesh-sensorium-2026-08-04.md
  echo "=== sensorium joint-failure amplification @ $ts — $HOST ==="
  echo "(Fialkowski, Havlin & Thurner arXiv:2607.20068 2026: the systemic damage of COMBINED failures can"
  echo " far exceed the SUM of the individual damages — substitutability breaks down — and the pairs that"
  echo " do it are invisible to any single-point ranking. L(S)=percept-categories blinded when the substrate"
  echo " classes S die together; A(i,j)=L(i,j)/(L(i)+L(j)). A>1 superadditive; L(i)=L(j)=0 & L(i,j)>0 PURE-JOINT.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  printf '%s\n' "$roll" | awk -v map="$SUBSTRATE_CLASS_MAP" '
    BEGIN{ _n=split(map,_m," "); for(_i=1;_i<=_n;_i++){ split(_m[_i],_kv,"="); c[_kv[1]]=_kv[2] } }
    # a category is BLINDED by the failure set S iff every class it rests on is in S (no surviving pathway)
    function blinded(i,S,   n,a,j){ n=split(catcls[i],a," "); for(j=1;j<=n;j++){ if(index(S," " a[j] " ")==0) return 0 } return 1 }
    function lossOf(S,   i,t){ t=0; for(i=1;i<=ncat;i++) if(blinded(i,S)) t++; return t }
    /^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)[[:space:]]/{
      cat=$1; line=$0; sub(/^[A-Za-z]+[[:space:]]+/,"",line)
      s=line; depth=0; cls=""; delete here
      # the freshness alphabet is FOUR shapes, not three: a stream on a substitute tier renders
      # `(<tier>-derived[ <N>m])`. It still rests on its mapped substrate class (the tier is a fallback
      # TRANSPORT, not an independent organ — classing it separately would manufacture degeneracy this
      # node does not have), so it keeps its class and simply stops falling out of the depth.
      while (match(s, /[A-Za-z][A-Za-z_-]*=[^()]*\((fresh|recent|aging|[a-z]+-derived([[:space:]][0-9]+m)?)\)/)) {
        tok=substr(s,RSTART,RLENGTH); eq=index(tok,"="); name=substr(tok,1,eq-1)
        k=(name in c)? c[name] : ("other:" name)
        depth++
        if(!(k in here)){ here[k]=1; cls=cls " " k
          if(!(k in allcls)){ allcls[k]=1; nc++; clsname[nc]=k } }
        s=substr(s, RSTART+RLENGTH)
      }
      if(depth==0) next
      ncat++; catname[ncat]=cat; catcls[ncat]=cls
    }
    END{
      if(ncat==0){ print "  posture: NO CATEGORIES — roll-call empty (nothing cached)"; exit 2 }
      print ""
      print "  single-point loss — what the mesh can already see (one substrate class dies alone):"
      for(i=1;i<=nc;i++){
        L[i]=lossOf(" " clsname[i] " ")
        vic=""
        for(k=1;k<=ncat;k++) if(blinded(k," " clsname[i] " ")) vic=vic " " catname[k]
        printf "    %-10s blinds %d categor%s%s\n", clsname[i], L[i], (L[i]==1?"y":"ies"), (vic==""?"":" —" vic)
      }
      print ""
      print "  joint-failure amplification — class PAIRS, worst first (only pairs that blind something):"
      np=0
      for(i=1;i<=nc;i++) for(j=i+1;j<=nc;j++){
        S=" " clsname[i] " " clsname[j] " "
        lij=lossOf(S)
        if(lij==0) continue
        base=L[i]+L[j]
        only=""
        for(k=1;k<=ncat;k++) if(blinded(k,S) && !blinded(k," " clsname[i] " ") && !blinded(k," " clsname[j] " ")) only=only " " catname[k]
        np++
        amp=(base>0)? lij/base : -1          # -1 encodes unbounded (pure-joint): nothing dies apart
        pamp[np]=amp; ppair[np]=clsname[i] " + " clsname[j]
        pnum[np]=sprintf("L %d + %d -> %d", L[i], L[j], lij); ponly[np]=only
        if(amp<0){ pure++; super++ } else if(amp>1){ super++ }
      }
      if(np==0){ print "    (no pair of substrate classes blinds any category)" }
      # sort by amplification desc; unbounded (-1) first
      for(i=1;i<=np;i++) for(j=i+1;j<=np;j++){
        ai=(pamp[i]<0)?1e18:pamp[i]; aj=(pamp[j]<0)?1e18:pamp[j]
        if(aj>ai){ t=pamp[i];pamp[i]=pamp[j];pamp[j]=t; t=ppair[i];ppair[i]=ppair[j];ppair[j]=t;
                   t=pnum[i];pnum[i]=pnum[j];pnum[j]=t; t=ponly[i];ponly[i]=ponly[j];ponly[j]=t }
      }
      for(i=1;i<=np;i++){
        if(pamp[i]<0)
          printf "    %-22s %-18s amp UNBOUNDED  ⚠ PURE-JOINT — costs NOTHING apart, blinds%s together (no single-point rank can see this pair)\n", ppair[i], pnum[i], ponly[i]
        else if(pamp[i]>1)
          printf "    %-22s %-18s amp %.2fx      ⚠ SUPERADDITIVE — joint loss exceeds the sum; substitutability breaks on%s\n", ppair[i], pnum[i], pamp[i], ponly[i]
        else
          printf "    %-22s %-18s amp %.2fx      additive (substitutable — the parts already account for the whole)\n", ppair[i], pnum[i], pamp[i]
      }
      print ""
      if(super>0){
        printf "  posture: SUPERADDITIVE — %d of %d blinding pair%s cost more together than apart (%d PURE-JOINT, invisible to single-point analysis). --degeneracy calls those categories common-mode RESILIENT: true of either death alone, false of both (Fialkowski/Havlin/Thurner 2026)\n", super, np, (np==1?"":"s"), pure+0
        exit 3
      }
      print "  posture: additive — every joint substrate failure costs exactly the sum of its parts; substitutability holds across classes"
      exit 0
    }'
  exit $?
fi

if [ "${1:-}" = --damage-response ]; then
  # ── ANTIFRAGILITY: THE SIGNED DAMAGE RESPONSE — spectral, PARTIAL, per-coupling (--damage-response,
  #    live review 2026-08-15) ─────────────────────────────────────────────────────────────────────────
  # LITERATURE (cross-domain transfer to a distributed sensor mesh). L. K. Eraso-Hernandez, A. P. Riascos &
  # J. L. Mateos, "Antifragility in the synchronization of oscillators on networks with communities",
  # J. Phys. Complexity 7(2), doi 10.1088/2632-072X/ae6ea9, published 9 Jun 2026 — the LIVE end of this
  # line; its formalism is set out in full in the predecessor, M. A. Polo-González, A. P. Riascos &
  # L. K. Eraso-Hernandez, "Antifragility and response to damage in the synchronization of oscillators on
  # networks", arXiv:2502.15148 (v3 30 May 2025) = J. Phys. A: Math. Theor. 58, 225002 (2025). Same group's
  # transport-side result: Eraso-Hernandez & Riascos, Phys. Rev. E 110, 044309 (2024), arXiv:2405.17228.
  # (The 2026 IOP page is bot-blocked to us — title/authors/date/abstract read off the publisher listing;
  # every FORMULA below is taken from the openly-readable arXiv:2502.15148v3, which is what we implement.)
  # THEIR MECHANISM, verbatim in shape: damage to a link is NOT death but a partial weight reduction,
  # Omega*_ab = (1-beta) A_ab with beta in [0,1) — beta=0 undamaged, beta->1 total failure. A global
  # function F_beta is defined (their case: synchronization rate of the Kuramoto model), and antifragility
  # is the DERIVATIVE OF THE GLOBAL FUNCTION IN THE DAMAGE, Lambda = dF_beta/dbeta at beta->0, with the
  # sign carrying the whole verdict: Lambda > 0 ANTIFRAGILE (damage IMPROVES the global function),
  # Lambda < 0 FRAGILE, Lambda = 0 neutral. Their 2026 contribution is the SPECTRAL form of it,
  # Lambda^(xi2) = d/dbeta [ xi2(Omega*)/xi2(A) ], where xi2 is the second-smallest eigenvalue of the
  # NORMALIZED Laplacian — the spectral gap that governs how fast the network reaches a common state.
  # WHY THE NORMALIZATION IS THE WHOLE POINT (and not a detail): for the COMBINATORIAL Laplacian L=D-A,
  # eigenvalues are monotone in the edge weights, so reducing a weight can never raise the gap and
  # Lambda <= 0 ALWAYS — an antifragile response is not even representable. It is the degree normalization
  # that breaks the monotonicity, so the same coupling can be knitting the network or trapping it. This is
  # gated in --test by the MESH_SENS_LAP=combinatorial mutant, which must make the antifragile verdict
  # DISAPPEAR (seen RED before landing).
  # WHERE WE HAD BEEN — and the exact shape of the gap. Every structural axis in this file prices damage as
  # a LOSS: --balance counts live streams per category, --degeneracy counts distinct common-mode classes,
  # --amplification prices L(S) = categories BLINDED when a set S of classes dies. All three are (a)
  # SIGN-CONSTRAINED — L is a non-negative monotone set function, so no reading can ever come out saying a
  # coupling is COSTING us, only how much its death would cost — and (b) BINARY: a class is alive or dead,
  # there is no beta. Both restrictions are exactly what the 2026 result lifts. The mesh's real failure mode
  # is not binary either: a phone answering one SSH probe in five is a partially-damaged coupling, and the
  # whole loss lane must round it to alive or dead.
  # THE TRANSFER. Nodes = the substrate classes and the percept categories of the live roll; an edge
  # (class k, category c) carries weight = the number of LIVE streams of class k feeding c — the same
  # incidence --degeneracy and --amplification already parse, kept as a WEIGHT instead of collapsed to a
  # set. The global function is the normalized-Laplacian spectral gap xi2 of that fabric: how tightly the
  # perception fabric is knit, i.e. how far corroboration reaches across categories through shared
  # substrate. (The identical edge carries BOTH corroboration reach and common-mode risk — which is why the
  # sign is a real question and not a foregone conclusion.) Damage = (1-beta) on ONE coupling; the measure
  # is Lambda = [xi2(beta)/xi2(0) - 1]/beta, computed at TWO betas whose SIGNS must agree (a verdict read
  # off a single arbitrary knob is the threshold-fishing trap this file's sibling landing already paid for
  # — see mesh-convexity threshold-stability, 2026-08-10); disagreement renders UNSTABLE, never a verdict.
  # READING: Lambda < 0 = a BRIDGE — the coupling whose PARTIAL degradation most damages the fabric, which
  # no existing axis produces (--amplification prices only the TOTAL death of class PAIRS). Lambda > 0 = a
  # TRAP — a pendant coupling that absorbs corroboration weight without passing it on; more streams of the
  # SAME class into that category buy no reach and lower the gap. The trap reading CONVERGES on
  # --degeneracy's advice (give the category a second class) from a completely different direction, and
  # that convergence is worth stating plainly rather than claiming novelty for it; what is new here is the
  # SIGN, the PARTIAL damage, and the bridge rank.
  # HONEST BOUNDARIES. (1) xi2 is a property of the coupling GRAPH, not a measurement of fusion accuracy:
  # "weakening this improves the gap" is a statement about corroboration reach, not a promise that any
  # sense reads better. Report-only for exactly that reason. (2) The fabric is small (single digits of
  # nodes); these are honest readings of a small graph, never the paper's regime. (3) If the fabric is
  # DISCONNECTED, xi2 = 0 identically and every Lambda would be a vacuous 0 — so the gap is computed on the
  # GIANT COMPONENT and the other components are named as ALREADY-SEVERED islands, which is itself a
  # finding no other axis reports. Artifact: docs/reviews/antifragility-signed-damage-response-spectral-gap-
  # mesh-sensorium-2026-08-15.md
  echo "=== sensorium signed damage-response @ $ts — $HOST ==="
  echo "(Eraso-Hernandez, Riascos & Mateos, J.Phys.Complexity 7(2) 2026 / arXiv:2502.15148: damage is a PARTIAL"
  echo " weight cut (1-beta), and antifragility is the SIGN of dF/dbeta. F = xi2, the NORMALIZED-Laplacian"
  echo " spectral gap of the live substrate-class <-> percept-category fabric. L>0 ANTIFRAGILE (a trap: cutting"
  echo " it knits the fabric) · L<0 FRAGILE (a bridge) · ~0 NEUTRAL. Report-only — a graph property, not accuracy.)"
  # roll source: an existing readable file arg drives a crafted roll (the --test path); else the live cache.
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  # NB: `python3 - <<PY` takes stdin for the SCRIPT, so roll and map travel in the ENV, never on stdin.
  MESH_SENS_ROLL="$roll" MESH_SENS_MAP="$SUBSTRATE_CLASS_MAP" python3 - <<'PY'
import os, re, sys, math

# MESH_SENS_LAP: 'normalized' (the paper's, and the only one in which an antifragile response EXISTS) or
# 'combinatorial' (L=D-A, monotone in the weights => Lambda<=0 always). The combinatorial setting is the
# --test MUTANT and has no other caller; it is the falsifier for the load-bearing claim of this axis.
LAPMODE = os.environ.get("MESH_SENS_LAP", "normalized")

MAP = {}
for tok in os.environ.get("MESH_SENS_MAP", "").split():
    if "=" in tok:
        k, v = tok.split("=", 1)
        MAP[k] = v

CATRE = re.compile(r'^(BODY|ROOM|PRESENCE|HOUSEHOLD|SITUATION|COORDINATION|NODE)\s')
# FOUR shapes, not three — a stream on a substitute tier renders `(<tier>-derived[ <N>m])` and was
# dropped from every weight here, so the fabric silently lost exactly the degraded couplings.
TOKRE = re.compile(r'[A-Za-z][A-Za-z_-]*=[^()]*\((?:fresh|recent|aging|[a-z]+-derived(?: \d+m)?)\)')

W = {}                                       # (class, category) -> weight = live streams of that class
for line in os.environ.get("MESH_SENS_ROLL", "").splitlines():
    if not CATRE.match(line):
        continue
    cat = line.split()[0]
    rest = re.sub(r'^[A-Za-z]+\s+', '', line)
    for tok in TOKRE.findall(rest):
        name = tok.split("=", 1)[0]
        cls = MAP.get(name, "other:" + name)      # unmapped field -> its own class (same rule as --degeneracy)
        W[(cls, cat)] = W.get((cls, cat), 0) + 1

if not W:
    print("  posture: NO CATEGORIES — roll-call empty (nothing cached)")
    sys.exit(2)

def jacobi_eigenvalues(M, sweeps=200, tol=1e-13):
    """Cyclic-by-largest Jacobi rotation on a small dense SYMMETRIC matrix. Pure stdlib on purpose:
    there is no numpy in the system python on this node (memory: numpy-only-in-venvs-on-mesh-home), and a
    sensorium axis that silently needs a venv is a silent fallback waiting to happen."""
    k = len(M)
    a = [row[:] for row in M]
    for _ in range(sweeps):
        mx = 0.0; p = q = 0
        for i in range(k):
            for j in range(i + 1, k):
                v = abs(a[i][j])
                if v > mx:
                    mx = v; p, q = i, j
        if mx < tol:
            break
        app, aqq, apq = a[p][p], a[q][q], a[p][q]
        theta = (aqq - app) / (2 * apq)
        t = (1.0 if theta >= 0 else -1.0) / (abs(theta) + math.sqrt(theta * theta + 1))
        c = 1 / math.sqrt(t * t + 1); s = t * c
        for i in range(k):
            aip, aiq = a[i][p], a[i][q]
            a[i][p] = c * aip - s * aiq; a[i][q] = s * aip + c * aiq
        for i in range(k):
            api, aqi = a[p][i], a[q][i]
            a[p][i] = c * api - s * aqi; a[q][i] = s * api + c * aqi
    return [a[i][i] for i in range(k)]

def xi2(wmap, memb):
    """Second-smallest eigenvalue of the Laplacian of the sub-fabric induced on `memb`."""
    ns = sorted(memb); k = len(ns); ix = {n: i for i, n in enumerate(ns)}
    A = [[0.0] * k for _ in range(k)]
    for (a, b), w in wmap.items():
        if a in memb and b in memb and w > 0:
            A[ix[a]][ix[b]] += w; A[ix[b]][ix[a]] += w
    d = [sum(r) for r in A]
    L = [[0.0] * k for _ in range(k)]
    for i in range(k):
        for j in range(k):
            if LAPMODE == "combinatorial":
                L[i][j] = (d[i] - A[i][j]) if i == j else -A[i][j]
            elif d[i] <= 0 or d[j] <= 0:
                L[i][j] = 1.0 if i == j else 0.0
            else:
                L[i][j] = (1.0 if i == j else 0.0) - A[i][j] / math.sqrt(d[i] * d[j])
    ev = sorted(jacobi_eigenvalues(L))
    return ev[1] if k >= 2 else 0.0

# ── components: xi2 == 0 on a disconnected fabric, so read the gap on the GIANT and NAME the islands ──
nodes = sorted({c for c, _ in W} | {t for _, t in W})
adj = {n: set() for n in nodes}
for (a, b) in W:
    adj[a].add(b); adj[b].add(a)
seen = set(); comps = []
for n in nodes:
    if n in seen:
        continue
    st = [n]; comp = set()
    while st:
        x = st.pop()
        if x in comp:
            continue
        comp.add(x); seen.add(x); st.extend(adj[x] - comp)
    comps.append(sorted(comp))
comps.sort(key=lambda c: (-len(c), c))
giant = set(comps[0]); islands = comps[1:]
gcats = sorted(n for n in giant if CATRE.match(n + " "))

print("")
if islands:
    print("  fabric components: %d — the perception fabric is ALREADY severed; no substrate is shared across a cut," % len(comps))
    print("  so nothing in one island can corroborate anything in another (xi2 is read on the giant only):")
    print("    giant    %s" % " ".join(sorted(giant)))
    for isl in islands:
        print("    island   %s   ⚠ SEVERED — shares no substrate class with the giant" % " ".join(isl))
    print("")
else:
    print("  fabric components: 1 — the whole perception fabric is one connected piece")
    print("")

if len(giant) < 3 or len(gcats) < 2:
    print("  posture: n/a — giant component is %d node(s)/%d categor%s; a spectral gap needs >=2 coupled categories"
          % (len(giant), len(gcats), "y" if len(gcats) == 1 else "ies"))
    sys.exit(2)

base = xi2(W, giant)
if base <= 1e-12:
    print("  posture: n/a — giant component gap is 0 (degenerate fabric); no damage response to read")
    sys.exit(2)

EPS = 1e-6
BETAS = (1e-3, 1e-2)
rows = []
for (a, b), w in sorted(W.items()):
    if a not in giant:
        continue
    lam = []
    for beta in BETAS:
        w2 = dict(W); w2[(a, b)] = w * (1.0 - beta)
        lam.append(((xi2(w2, giant) / base) - 1.0) / beta)
    l1, l2 = lam
    if (l1 > EPS) != (l2 > EPS) or (l1 < -EPS) != (l2 < -EPS):
        verdict = "UNSTABLE"                       # sign flips between the two betas — no verdict is honest
    elif l1 > EPS:
        verdict = "ANTIFRAGILE"
    elif l1 < -EPS:
        verdict = "FRAGILE"
    else:
        verdict = "NEUTRAL"
    rows.append((l1, l2, a, b, w, verdict))

rows.sort(key=lambda r: -r[0])                     # antifragile first — the reading the loss lane cannot make
print("  per-coupling damage response (xi2 base %.4f on %d nodes · beta %g and %g, signs must agree):"
      % (base, len(giant), BETAS[0], BETAS[1]))
nanti = nfrag = nunst = 0
for l1, l2, a, b, w, verdict in rows:
    if verdict == "ANTIFRAGILE":
        nanti += 1
        note = "⚠ ANTIFRAGILE — cutting it RAISES the gap: a trap, not a tie (more %s streams into %s buy no reach)" % (a, b)
    elif verdict == "FRAGILE":
        nfrag += 1
        note = "FRAGILE — a bridge; even PARTIAL degradation costs the fabric"
    elif verdict == "UNSTABLE":
        nunst += 1
        note = "UNSTABLE — sign flips between betas (L=%+.5f at %g); no verdict" % (l2, BETAS[1])
    else:
        note = "neutral — the gap does not move with this coupling"
    print("    %-10s -> %-13s w %-3d L %+.5f  %s" % (a, b, w, l1, note))

print("")
if nanti > 0:
    print("  posture: ANTIFRAGILE-COUPLING — %d of %d live coupling%s IMPROVE%s the fabric's spectral gap when partially"
          % (nanti, len(rows), "" if nanti == 1 else "s", "s" if nanti == 1 else "")
          + " cut; %d fragile (bridge), %d unstable. Damage is not a monotone loss here — the sign is the finding, and" % (nfrag, nunst))
    print("  --balance/--degeneracy/--amplification cannot express it: every one of them prices damage as loss >= 0"
          " (Eraso-Hernandez/Riascos/Mateos 2026).")
    sys.exit(3)
print("  posture: monotone — no live coupling improves the fabric under partial damage (%d fragile, %d neutral, %d unstable);"
      % (nfrag, len(rows) - nfrag - nunst, nunst))
print("  every coupling earns its keep, so the loss-shaped axes above lose nothing by being sign-constrained here.")
sys.exit(0)
PY
  exit $?
fi

if [ "${1:-}" = --articulation ]; then
  # ── ASSEMBLAGE: double articulation — content plane vs expression plane (--articulation — live review 2026-07-31)
  # LITERATURE (Deleuze & Guattari, cross-domain transfer to a distributed sensor mesh). Every assemblage
  # is DOUBLY ARTICULATED (borrowed from Hjelmslev): a first articulation on the plane of CONTENT (the
  # "machinic assemblage of bodies" — matter actually coupled and formed: here, the producer's own reading
  # LOG, the record that the body coupled to the world) and a second on the plane of EXPRESSION (the
  # "collective assemblage of enunciation" — the regime of SIGNS attributed to those bodies: here, the
  # .state cache the sensorium/pane/consumers act on). D&G's load-bearing claim: the two articulations are
  # RELATIVELY INDEPENDENT and their relation is NOT CAUSAL — "there is a continual passage from one to the
  # other" only under RECIPROCAL PRESUPPOSITION; nothing guarantees a fresh sign presupposes a live content.
  #   refs: Deleuze & Guattari, A Thousand Plateaus (1980), "10,000 BC: The Geology of Morals" (double
  #   articulation, form/substance of content vs expression) + the tetravalence of the assemblage (machinic
  #   assemblage of bodies ↔ collective assemblage of enunciation), via Hjelmslev, "Prolegomena to a Theory
  #   of Language". Verified current across the Purdue Deleuze dictionary (deleuze.cla.purdue.edu) and the
  #   assemblage encyclopedia entry (2025-26). LIVE, continuously-published cross-domain transfer of double
  #   articulation INTO sensor/signal time-series: Taniguchi et al., "Nonparametric Bayesian Double
  #   Articulation Analyzer for Direct Language Acquisition from Continuous Speech Signals" (arXiv:1506.06646;
  #   IEEE TASLP 24(9), 2016) + the Kyoto Symbol Emergence Systems Group's ongoing work (2024-25,
  #   ses.ist.i.kyoto-u.ac.jp/publication). HONEST DISTINCTION: they operationalize the LINGUISTIC
  #   (Martinet/Hjelmslev) reading — unsupervised two-LAYER segmentation of the signal (letters→words) — a
  #   heavy nonparametric-Bayesian pipeline, NOT a mesh-scale analyzer; this transfers the ASSEMBLAGE reading
  #   (content-plane vs expression-plane reciprocal presupposition), which IS a cheap file-stat read.
  # WHERE WE'D BEEN: --impasse already reads the HOLLOW quadrant — a live sign (fresh mtime) whose value is
  # UNRESOLVED (`?`) — but it reads a SINGLE plane (the .state cache) against the clock. --balance /
  # --exteriority / --degeneracy ALSO read only the .state cache. NONE reads the CONTENT plane (the
  # producer's LOG) as a SEPARATE artifact and checks the two planes AGAINST EACH OTHER. --articulation is
  # the first TWO-PLANE check, and it catches exactly the quadrant --impasse cannot: a sense actively
  # WRITING content (log fresh) whose SIGN (.state) has gone stale — the value is perfectly valid (not `?`),
  # so --impasse is silent and --balance counts the stale sign as its live stream. That is the mesh's own
  # driver-races-the-cache failure (memory: mesh-mag/mesh-gyro raced the `-n 1` driver, 5 days stale, --test
  # green) seen as an articulation break: the body still couples, but the sign the mesh acts on has fallen
  # out of reciprocal presupposition with it. CALIBRATION BOUNDARY (the point, not an omission): the REVERSE
  # direction — fresh .state, stale LOG — is the HONEST liveness-touch shape (mtime=liveness, content=change-
  # gated write; CLAUDE.md), so it is reported as SIGN-AHEAD and NEVER faulted; faulting it would re-break
  # the false-STALE fix state-touch exists to prevent. Report-only; artifact:
  # docs/reviews/deleuze-double-articulation-content-expression-sensorium-2026-07-31.md
  M="$HOME/.mesh"; now="$(date +%s)"
  echo "=== sensorium double-articulation @ $ts — $HOST ==="
  echo "(Deleuze&Guattari ATP 'Geology of Morals'/Hjelmslev: an assemblage is TWO articulations —"
  echo " CONTENT (the body's read = the producer's LOG) and EXPRESSION (the sign consumers act on = the"
  echo " .state cache) — relatively INDEPENDENT, non-causal, held only in reciprocal presupposition."
  echo " MUTE = content fresh but the sign went stale: a live sense the sensorium/pane is blind to.)"
  # PAIRS: name | state-cache(EXPRESSION) | companion reading-log(CONTENT) | ttl — ttl reuses the --cached
  # staleness limits. Only senses that keep BOTH a current-value .state AND an append-only reading LOG can
  # be assessed: the two planes must be DISTINCT artifacts to check their reciprocal presupposition.
  PAIRS="body-power|.body-power-state|body-power.log|2100
light|.light-state|light.log|2100
activity-tempo|.activity-tempo.state|activity-tempo.log|2100
room-sense|.room-sense.state|room-sense.log|1200
ambient-clock|.ambient-clock.state|ambient-clock.log|2100"
  agef(){ local f="$1"; [ -e "$f" ] || { printf '%s' -1; return; }
    local m; m="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"; printf '%s' $((now-m)); }
  agestr(){ local d="$1"; [ "$d" -lt 0 ] && { printf '—'; return; }
    if   [ "$d" -lt 90 ];   then printf '%ss' "$d"
    elif [ "$d" -lt 5400 ]; then printf '%sm' "$((d/60))"
    else printf '%sh' "$((d/3600))"; fi; }
  mute=0; artic=0; ahead=0; dormant=0; unpaired=0; total=0
  while IFS='|' read -r name st lg ttl; do
    [ -n "$name" ] || continue
    sa="$(agef "$M/$st")"; la="$(agef "$M/$lg")"
    # present on this node only if at least ONE plane exists (a sense absent here is not a fault)
    [ "$sa" -lt 0 ] && [ "$la" -lt 0 ] && continue
    total=$((total+1))
    if [ "$sa" -lt 0 ] || [ "$la" -lt 0 ]; then
      cls="UNPAIRED"; tag=" (only one plane present — reciprocal presupposition not assessable)"; unpaired=$((unpaired+1))
    else
      sf=$([ "$sa" -le "$ttl" ] && echo 1 || echo 0)   # expression (sign) fresh?
      lf=$([ "$la" -le "$ttl" ] && echo 1 || echo 0)   # content (reading) fresh?
      if   [ "$lf" = 1 ] && [ "$sf" = 1 ]; then cls="ARTICULATED"; tag=""; artic=$((artic+1))
      elif [ "$lf" = 1 ] && [ "$sf" = 0 ]; then cls="MUTE"; tag=" ⚠ content plane LIVE (log fresh) but the SIGN is stale — a reading sense the sensorium/pane is blind to"; mute=$((mute+1))
      elif [ "$lf" = 0 ] && [ "$sf" = 1 ]; then cls="SIGN-AHEAD"; tag=" (change-gated content — the honest liveness-touch shape; NOT a fault)"; ahead=$((ahead+1))
      else cls="DORMANT"; tag=" (both planes quiet — liveness/reflex-health's concern, not articulation)"; dormant=$((dormant+1)); fi
    fi
    printf "  %-16s content=%-4s expression=%-4s  %-12s%s\n" "$name" "$(agestr "$la")" "$(agestr "$sa")" "$cls" "$tag"
  done <<EOF
$PAIRS
EOF
  echo ""
  printf "  pairs: %d articulated · %d MUTE · %d sign-ahead · %d dormant · %d unpaired  (of %d)\n" \
    "$artic" "$mute" "$ahead" "$dormant" "$unpaired" "$total"
  if [ "$total" -eq 0 ]; then echo "  posture: NO PAIRS — no sense keeps both a content log and an expression cache here"; exit 2; fi
  if [ "$mute" -gt 0 ]; then
    printf "  posture: DECOUPLED — %d sense(s) produce content the sign no longer carries; the two articulations fell out of reciprocal presupposition (the sensorium acts on a stale sign for a live sense)\n" "$mute"
    exit 3
  fi
  echo "  posture: coupled — every paired sense's sign presupposes its live content (or is honestly dormant / change-gated)"
  exit 0
fi

if [ "${1:-}" = --footholds ]; then
  # ── ECOLOGICAL RATIONALITY / ORIENTATION: the FOOTHOLD and its decay (--footholds — live review 2026-08-01)
  # LITERATURE (live 2026 result in the Vervaeke relevance-realization stream). Chiappe & Vervaeke,
  # "Ecological rationality and the philosophy of orientation", Phenomenology and the Cognitive Sciences
  # (published 2026-06-12, doi:10.1007/s11097-026-10177-9). Their claim: ecological rationality — human
  # rationality as the application of FAST-AND-FRUGAL heuristics fitted to an environment — PRESUPPOSES more
  # fundamental ORIENTATION processes it never thematizes, and Stegmaier's philosophy of orientation
  # (Philosophie der Orientierung 2008 / What is Orientation? 2019) supplies them: standpoint, horizon,
  # FOOTHOLDS, and the structuring of orientation into routines and orientation worlds. The load-bearing
  # primitive is the FOOTHOLD (Anhaltspunkt): "an ABBREVIATION of a situation where the relevant matters of
  # this situation SEEM TO CONVERGE — in this way orientation can, for the moment, NEGLECT other matters and
  # gain an overview of what is relevant" (orientation-philosophy.com glossary, Stegmaier's own gloss). And
  # relevance is defined NEGATIVELY: "the relevance is, in turn, a function of the constantly possible
  # DISORIENTATION, which is always to be avoided."
  # WHERE WE'D BEEN (RR coverage map): precision-weighting + the large-world frame limit (mesh-precision),
  # goal-relativity (mesh-novelty), the three opponent pairs — explore<->exploit (mesh-needs), efficiency<->
  # resiliency (--balance), focusing<->diversifying (mesh-novelty --tempering) — the fourth, compression<->
  # particularization (mesh-journal-watch --scope), insight/impasse (--impasse), and the interventional
  # per-sensor semantic load (mesh-home-state --semantic). ALL of those weight, balance, or ablate an INPUT.
  # NONE asks the orientation question, which is about the OUTPUT SIGN: is the abbreviation still an
  # abbreviation OF anything? A foothold is not legitimate because it is fresh, precise or widely read —
  # it is legitimate only while the matters it stands for still converge on it. That is a claim no freshness
  # or fan-out measure can make: --articulation checks the two planes' CLOCKS (content log vs .state mtime),
  # --exteriority counts consumers, --impasse catches a value that is absent (`?`). A DEAD HOLD is fresh,
  # definite, and widely read — and no longer carves. Every consumer that reads it INSTEAD of surveying is
  # neglecting the rest on the strength of a hold that holds nothing: Stegmaier's disorientation, arriving
  # silently and green.
  # THE TRANSFER (mechanical, no new sensor): a reading LOG records both planes on one line — the emitted
  # SIGN (the abbreviation: the verdict token a consumer acts on) and the k=v SUB-AXES (the matters it
  # abbreviates). Over a WINDOW of recent lines, count sign transitions against situation transitions:
  #   DEAD-HOLD   sign_tr == 0, categorical situation moved >= MINMOVE, AND the sign moved in the HISTORY
  #               before the window (so flatness is a CHANGE in the sign's behaviour, not its nature).
  #   FALSE-HOLD  sign_tr > all-axis transitions — the sign makes MORE distinctions than its own recorded
  #               inputs offer; the surplus is invented (chatter, not orientation). Information-theoretic,
  #               no tuned constant.
  #   FLAT-NO-BASELINE  frozen sign, moving situation, but the record NEVER shows the sign moving — the log
  #               cannot witness its own sign's variation, so decay is UNAUDITABLE here. Named, never faulted
  #               and never folded into "holding": an honest n/a is not a pass.
  #   QUIET       neither moved — a still world legitimately gets a still sign. Not a fault.
  # CALIBRATION (the trap this walked into, kept as the reason for the asymmetry): a numeric axis under-
  # witnesses categorical motion and over-witnesses it by jitter, so EACH POLE IS TESTED AGAINST THE AXIS
  # MEASURE THAT MAKES THAT POLE HARDER TO DECLARE — DEAD-HOLD against the CONSERVATIVE categorical count
  # (numerics dropped: a drifting float must not be counted as "the situation moved"), FALSE-HOLD against the
  # LIBERAL all-axis count (numerics kept: a sign driven by a numeric the log records must not read as
  # inventing distinctions). Dropping numerics on BOTH sides made light.log — whose only categorical field is
  # `via=direct` while its verdict rides `mean=`/`stddev=` — read FALSE-HOLD with sign_tr 74 vs cat_tr 0.
  # Units count as numeric (`4.62W`, `41.9°C`), or package-power's every-line wattage reads as a moving
  # situation under a frozen HIGH. Clock-derived keys are dropped entirely (a label that embeds the clock
  # correlates with the sun, not with the situation). >=2 categorical keys required, else UNASSESSABLE — one
  # key cannot distinguish a still situation from an unrecorded one. Report-only; artifact:
  # docs/reviews/rr-ecological-rationality-foothold-decay-sensorium-2026-08-01.md
  M="$HOME/.mesh"
  echo "=== sensorium footholds @ $ts — $HOST ==="
  echo "(Chiappe&Vervaeke 2026 / Stegmaier: a FOOTHOLD is an abbreviation of a situation where the relevant"
  echo " matters seem to CONVERGE, letting orientation neglect the rest. A hold is legitimate only while they"
  echo " still converge on it — DEAD-HOLD = sign frozen while the situation it abbreviates keeps moving.)"
  FH_DIR="$M" FH_WINDOW="${MESH_FOOTHOLD_WINDOW:-60}" python3 - <<'FHPY'
import os, re, sys, glob
D = os.environ["FH_DIR"]; W = max(8, int(os.environ.get("FH_WINDOW") or 60))
MINKEYS, MINLINES, MINMOVE, TAILBYTES = 2, 8, 3, 262144
NUM  = re.compile(r'^[<>~+-]?\d+(\.\d+)?\s*(°?[a-zA-Z%/]{0,4})$')   # 41.9°C / 4.62W / -78 are NOT categorical
KV   = re.compile(r'([A-Za-z_][A-Za-z0-9_-]*)=([^\s;,)|]+)')
SIGN = re.compile(r'\]\s+([A-Z][A-Z0-9_-]{1,})\b')                  # "[room-sense] PRESENT ..." -> PRESENT
CLK  = re.compile(r'(hour|time|clock|dwell|age|since|uptime|_s$|secs?$|ts$)', re.I)

def tail_lines(p):
    try:
        with open(p, 'rb') as f:
            f.seek(0, 2); sz = f.tell(); f.seek(max(0, sz - TAILBYTES))
            return f.read().decode('utf-8', 'replace').splitlines()
    except OSError:
        return []

def assess(path):
    rows = []
    for ln in tail_lines(path):
        m = SIGN.search(ln)
        if not m: continue
        cat = []; alla = []
        for k, v in KV.findall(ln):
            if CLK.search(k): continue
            alla.append((k, v))
            if not NUM.match(v): cat.append((k, v))
        if not cat: continue
        rows.append((m.group(1), tuple(sorted(cat)), tuple(sorted(alla))))
    if not rows: return None
    win, hist = rows[-W:], rows[:-W]
    tr = lambda s: sum(1 for a, b in zip(s, s[1:]) if a != b)
    signs = [r[0] for r in win]
    st, ct, at = tr(signs), tr([r[1] for r in win]), tr([r[2] for r in win])
    hst = tr([r[0] for r in hist])
    keys = len({k for r in win for k, _ in r[1]})
    d = dict(n=len(win), keys=keys, sign_tr=st, cat_tr=ct, all_tr=at, hist_sign_tr=hst,
             sign=signs[-1] if signs else '?')
    if len(win) < MINLINES or keys < MINKEYS:      d['v'] = 'UNASSESSABLE'
    elif st > at:                                  d['v'] = 'FALSE-HOLD'
    elif st == 0 and ct >= MINMOVE and hst >= 1:   d['v'] = 'DEAD-HOLD'
    elif st == 0 and ct >= MINMOVE:                d['v'] = 'FLAT-NO-BASELINE'
    elif st == 0:                                  d['v'] = 'QUIET'
    else:                                          d['v'] = 'HOLDING'
    return d

TAG = {
 'DEAD-HOLD':        '⚠ sign FROZEN while the situation it abbreviates kept moving — and this sign HAS moved before: consumers neglect the rest on a hold that no longer carves',
 'FALSE-HOLD':       '⚠ sign makes MORE distinctions than its own recorded inputs offer — the surplus is invented (chatter, not orientation)',
 'FLAT-NO-BASELINE': '(frozen sign, moving situation, but the record never shows this sign moving — decay is UNAUDITABLE here, not absent)',
 'QUIET':            '(still situation, still sign — a legitimate hold on a quiet world)',
 'HOLDING':          '',
}
res = []
for p in sorted(glob.glob(os.path.join(D, '*.log'))):
    a = assess(p)
    if a: res.append((os.path.basename(p), a))
skipped = sum(1 for _, a in res if a['v'] == 'UNASSESSABLE')
shown = [(n, a) for n, a in res if a['v'] != 'UNASSESSABLE']
order = {'DEAD-HOLD': 0, 'FALSE-HOLD': 1, 'FLAT-NO-BASELINE': 2, 'HOLDING': 3, 'QUIET': 4}
for n, a in sorted(shown, key=lambda x: (order[x[1]['v']], x[0])):
    print("  %-24s %-17s sign=%-14s tr sign=%-4d cat=%-4d all=%-4d hist=%-5d n=%-4d keys=%d%s"
          % (n, a['v'], a['sign'], a['sign_tr'], a['cat_tr'], a['all_tr'], a['hist_sign_tr'],
             a['n'], a['keys'], (" " + TAG[a['v']]) if TAG[a['v']] else ""))
dead = [n for n, a in shown if a['v'] == 'DEAD-HOLD']
false_ = [n for n, a in shown if a['v'] == 'FALSE-HOLD']
flat = [n for n, a in shown if a['v'] == 'FLAT-NO-BASELINE']
print("")
print("  holds: %d assessable · %d DEAD · %d FALSE · %d flat-no-baseline · %d unassessable (window=%d lines)"
      % (len(shown), len(dead), len(false_), len(flat), skipped, W))
if not shown:
    print("  posture: NO ASSESSABLE HOLDS — no reading log here records a sign together with >=2 categorical"
          " sub-axes; foothold decay cannot be measured on this node (honest n/a, not 'oriented')")
    sys.exit(2)
if dead:
    print("  posture: DISORIENTED — %d hold(s) frozen under a moving situation: %s" % (len(dead), " ".join(dead)))
    sys.exit(3)
if false_:
    print("  posture: CHATTERING — %d hold(s) carve finer than their inputs: %s" % (len(false_), " ".join(false_)))
    sys.exit(4)
print("  posture: oriented — every assessable hold still moves with the situation it abbreviates"
      + (" (%d unauditable by its own record)" % len(flat) if flat else ""))
sys.exit(0)
FHPY
  exit $?
fi

if [ "${1:-}" = --self-prior ]; then
  # ── FEP / ACTIVE INFERENCE: the SELF-PRIOR and the MARK (--self-prior — live review 2026-08-22)
  # LITERATURE. Kim, Kanazawa & Kuniyoshi, "Active Inference with a Self-Prior in the Mirror-Mark
  # Task", arXiv:2604.09673 (2 Apr 2026). Their claim: mirror self-recognition needs no reward and no
  # extra sense — a single mechanism suffices. The agent learns "the density of familiar multisensory
  # experiences" (the SELF-PRIOR, a probabilistic body schema over vision × proprioception jointly);
  # when a mark appears, "the discrepancy from this learned distribution drives mark-directed
  # behaviour through active inference". A simulated infant with NO tactile input removed a sticker
  # from its own face in ~70% of trials. Expected free energy fell after removal, so the self-prior
  # is what separates self from non-self.
  #
  # WHAT WE DID NOT EMBODY. Every self-check in this mesh is PER-AXIS against that axis's own declared
  # contract: mesh-health, mesh-reflex-health and mesh-doctor each ask "is this organ within ITS
  # range?", and mesh-novelty scores MARGINAL surprisal over one modality (board event types). Nothing
  # holds a density over the node's own MULTI-MODAL state, so the mesh cannot see the mark: a
  # configuration in which every axis is individually familiar and the COMBINATION has never occurred.
  # That is exactly the sticker — no single modality reports anything abnormal.
  #
  # This mode is the smallest honest form of that: read the cached roll-call (the mesh already
  # publishes its own body as discrete words), keep a ledger of joint configurations, and name the
  # pair that is familiar in each member and unseen together.
  #
  # THREE HONESTY CONSTRAINTS, each a place this could have lied:
  #  1. SUPPORT IS COUNTED IN DISTINCT HOURS, NOT ROWS. The roll is sampled far faster than the state
  #     changes, so consecutive rows are near-copies; counting rows would let pure DWELL manufacture
  #     "familiar", and every transition would mint a fresh "never co-occurred" pair. Hour buckets
  #     deflate that autocorrelation — the marginal floor is distinct hours in which the token was
  #     seen, and the joint count is distinct hours in which BOTH were seen.
  #  2. ONLY (fresh)/(recent) AXES ARE EVIDENCE. An (aging)/(STALE) field, and a value carrying a
  #     fallback provenance instead of a freshness word, is DROPPED and counted in coverage — it is
  #     absence of evidence, and a self-prior that eats stale axes learns a body it no longer has.
  #  3. A NULL WORD IS NOT A VALUE. UNKNOWN/OFFLINE/? and friends are the sense saying it cannot
  #     tell; pairing on them would make blindness look like a body configuration.
  # Coverage (rows, span, axes kept/dropped) is printed with EVERY verdict, and below the sample
  # floor the mode refuses to name a mark at all rather than naming the newest thing it saw.
  #
  # exit 0 = no mark · 2 = insufficient evidence (honest n/a) · 3 = mark(s) named
  # usage: mesh-sensorium --self-prior [rollfile] [ledgerfile]   (both --test paths)
  echo "=== sensorium self-prior (multi-modal body schema — the MARK) @ $ts — $HOST ==="
  echo "(Kim, Kanazawa & Kuniyoshi, arXiv:2604.09673 2026 — a self-prior is a density over FAMILIAR"
  echo " multisensory experience; the mark is the discrepancy from it. Every axis normal, the joint"
  echo " never seen. Per-axis health checks are structurally blind to this.)"
  if [ -n "${2:-}" ] && [ -r "$2" ]; then roll="$(cat "$2")"; else roll="$(bash "$0" --cached 2>/dev/null)"; fi
  SP_LEDGER="${3:-$HOME/.mesh/self-prior.log}"
  SP_ROLL="$roll" SP_LEDGER="$SP_LEDGER" python3 - <<'SPPY'
import os, re, sys, time, collections

LEDGER = os.environ["SP_LEDGER"]
FLOOR  = int(os.environ.get("MESH_SELF_PRIOR_FLOOR", "6"))    # distinct hours a token needs to be "familiar"
NMIN   = int(os.environ.get("MESH_SELF_PRIOR_NMIN",  "30"))   # distinct hours the ledger needs at all
TOPN   = int(os.environ.get("MESH_SELF_PRIOR_TOP",   "5"))
WINDOW = int(os.environ.get("MESH_SELF_PRIOR_WINDOW","20000"))# ledger rows read back

# A value that carries no determination about the world — the same alphabet --viability uses.
NULLV = set("? UNKNOWN OFFLINE DOWN DEAD ABSENT BLIND UNREACH UNREACHABLE N/A NA NONE - —".split())
CATS  = ("BODY", "ROOM", "HOUSEHOLD", "SITUATION", "COORDINATION", "NODE")

def parse_roll(text):
    """-> (tokens, dropped) ; tokens are 'axis=VALUE' for FRESH/RECENT categorical axes only."""
    toks, dropped = [], []
    for line in text.splitlines():
        m = re.match(r'^(%s)\s+(.*)$' % "|".join(CATS), line)
        if not m:
            continue
        cat, body = m.group(1), m.group(2)
        for field in body.split(" · "):
            field = field.strip()
            if not field:
                continue
            fm = re.match(r'^([A-Za-z0-9_-]+)\s*[=:]\s*(.*)$', field)
            if not fm:
                continue
            name, rest = fm.group(1).lower(), fm.group(2).strip()
            qm = re.search(r'\(([^()]*)\)\s*$', rest)
            qual = qm.group(1).strip() if qm else ""
            val = rest[:qm.start()].strip() if qm else rest
            val = val.split("|")[0].split("(")[0].strip()          # PRESENT|dwell_s=… ; AVAILABLE(n/a:…)
            val = val.split()[0].upper() if val.split() else ""
            # A BRACKETED value is a blindness/status SENTINEL the producer emits in place of a
            # reading (live here: `motion=[body-covered]`). Learning it as a body configuration is
            # the [[a-blindness-sentinel-fused-as-a-reading]] failure — it is an absence.
            if val.startswith("["):
                dropped.append("%s[sentinel:%s]" % (name, val.strip("[]").lower()))
                continue
            qw = qual.split()[0].lower() if qual.split() else ""
            if qw not in ("fresh", "recent"):
                # (aging)/(STALE), or a fallback provenance where a freshness word should be
                dropped.append("%s[%s]" % (name, qual if qual else "no-freshness"))
                continue
            if not val or val in NULLV:
                dropped.append("%s[null:%s]" % (name, val or "empty"))
                continue
            toks.append("%s=%s" % (name, val))
    return sorted(set(toks)), dropped

def read_ledger(path, limit):
    rows = []
    try:
        with open(path) as fh:
            lines = fh.readlines()[-limit:]
    except OSError:
        return rows
    for ln in lines:
        parts = ln.rstrip("\n").split("\t")
        if len(parts) < 2:
            continue
        rows.append((parts[0][:13], parts[1].split()))   # hour bucket = YYYY-MM-DDTHH
    return rows

now  = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
toks, dropped = parse_roll(os.environ.get("SP_ROLL", ""))
rows = read_ledger(LEDGER, WINDOW)                       # scored BEFORE this observation is appended

hours = collections.defaultdict(set)                     # hour -> set(tokens seen in it)
for hb, ts in rows:
    hours[hb].update(ts)
n_hours = len(hours)
marg  = collections.Counter()
for hb, ts in hours.items():
    for t in ts:
        marg[t] += 1

def joint_hours(a, b):
    return sum(1 for ts in hours.values() if a in ts and b in ts)

span_h = 0
if rows:
    try:
        t0 = time.mktime(time.strptime(rows[0][0], "%Y-%m-%dT%H"))
        t1 = time.mktime(time.strptime(rows[-1][0], "%Y-%m-%dT%H"))
        span_h = int((t1 - t0) / 3600)
    except ValueError:
        span_h = 0

print("  coverage: %d ledger row(s) over %d distinct hour(s) / %dh span · %d axis/axes read · %d dropped%s"
      % (len(rows), n_hours, span_h, len(toks), len(dropped),
         (" (" + " ".join(dropped) + ")") if dropped else ""))
print("  observation: " + (" ".join(toks) if toks else "(no fresh categorical axis — nothing to score)"))

# Append AFTER scoring, and only if this observation carries evidence.
if toks and os.environ.get("MESH_SELF_PRIOR_NOWRITE", "") != "1":
    try:
        os.makedirs(os.path.dirname(LEDGER) or ".", exist_ok=True)
        with open(LEDGER, "a") as fh:
            fh.write("%s\t%s\n" % (now, " ".join(toks)))
    except OSError as e:
        print("  note: ledger not written (%s)" % e)

if n_hours < NMIN:
    print("  verdict: INSUFFICIENT — %d distinct hour(s) of body history, floor is %d. No mark is named:"
          " below the floor every unseen combination is unseen because the ledger is young, not because"
          " the body is marked." % (n_hours, NMIN))
    sys.exit(2)
if len(toks) < 2:
    print("  verdict: INSUFFICIENT — fewer than two fresh axes; a mark is a relation between two.")
    sys.exit(2)

marks = []
for i in range(len(toks)):
    for j in range(i + 1, len(toks)):
        a, b = toks[i], toks[j]
        if a.split("=")[0] == b.split("=")[0]:
            continue
        if marg[a] < FLOOR or marg[b] < FLOOR:
            continue
        if joint_hours(a, b) == 0:
            marks.append((min(marg[a], marg[b]), a, b))
marks.sort(reverse=True)

if not marks:
    print("  verdict: no mark — every familiar pair in this configuration has been lived through before"
          " (floor: each member seen in >=%dh, pair in 0h)" % FLOOR)
    sys.exit(0)

print("  verdict: MARK — %d pair(s) familiar in each member, never seen together:" % len(marks))
for sup, a, b in marks[:TOPN]:
    print("    %-34s x %-34s   (%dh x %dh apart, 0h together)" % (a, b, marg[a], marg[b]))
if len(marks) > TOPN:
    print("    … %d more not listed" % (len(marks) - TOPN))
print("  read as: a discrepancy from the learned body schema, NOT an alarm — no axis is out of range,")
print("  which is precisely why every per-axis check is silent here.")
sys.exit(3)
SPPY
  exit $?
fi

if [ "${1:-}" = --compact ]; then
  run_compact "mesh-health" "mesh-health 2>&1 | sed -n '3p'"
  run_compact "mesh-therm" "mesh-therm 2>&1"
  run_compact "mesh-presence" "mesh-presence 2>&1 | head -1"
  run_compact "mesh-wifiscan" "mesh-wifiscan 2>&1 | head -1"
  run_compact "mesh-audio" "mesh-audio 2>&1"
  run_compact "mesh-card" "grep -E '^(hostname|tailscale-ip|as-of)' ~/.mesh-card 2>/dev/null | tr '\n' ' ' || echo '(no card)'"
else
  echo ""
  echo "--- health ---"
  mesh-health 2>&1 || true
  echo ""
  echo "--- thermal ---"
  mesh-therm --verbose 2>&1 || true
  echo ""
  echo "--- BLE presence ---"
  mesh-presence 2>&1 || true
  echo ""
  echo "--- WiFi proximity ---"
  mesh-wifiscan 2>&1 || true
  echo ""
  echo "--- audio hardware ---"
  mesh-audio --verbose 2>&1 || true
  echo ""
  echo "--- card ---"
  head -10 ~/.mesh-card 2>/dev/null || echo "(no card)"
fi

echo ""
echo "=== end sensorium ==="
