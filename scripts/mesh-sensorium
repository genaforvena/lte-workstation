#!/usr/bin/env bash
# mesh-sensorium — unified one-shot snapshot of everything this node perceives.
# smoke-test: --test checks required tools are in PATH
#
# Runs each sensor tool and compiles a timestamped report to stdout.
# Each tool is best-effort (skips silently if missing or fails).
#
#   mesh-sensorium            full sensorium snapshot
#   mesh-sensorium --compact  one-line per sensor
#   mesh-sensorium --test     smoke test (exit 0 if PATH has mesh-tools)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
NL='
'
run(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)" && [ -n "$out" ] && echo "[$label] $(printf '%s' "$out" | head -5 | tr '\n' ';')" || echo "[$label] (unavailable)"
}
run_compact(){ local label="$1" cmd="$2"
  out="$(eval "$cmd" 2>/dev/null)" && echo "[$label] $(printf '%s' "$out" | head -1)" || echo "[$label] (unavailable)"
}

if [ "${1:-}" = --test ]; then
  for t in mesh-health mesh-therm mesh-presence mesh-wifiscan mesh-audio; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (missing $t)"; exit 1; }
    "$t" --test >/dev/null 2>&1 || { echo "smoke-test: FAIL ($t --test failed)"; exit 1; }
  done
  echo "smoke-test: ok"; exit 0
fi

echo "=== mesh-sensorium @ $ts — $HOST ==="

if [ "${1:-}" = --compact ]; then
  run_compact "mesh-health" "mesh-health 2>&1 | head -3 | tail -1"
  run_compact "mesh-therm" "mesh-therm 2>&1"
  run_compact "mesh-presence" "mesh-presence 2>&1 | head -1"
  run_compact "mesh-wifiscan" "mesh-wifiscan 2>&1 | head -1"
  run_compact "mesh-audio" "mesh-audio 2>&1"
  run_compact "mesh-card" "grep -E '^(hostname|tailscale-ip|as-of)' ~/.mesh-card 2>/dev/null | tr '\n' ' ' || echo '(no card)'"
else
  echo ""
  echo "--- health ---"
  mesh-health 2>&1 || true
  echo ""
  echo "--- thermal ---"
  mesh-therm --verbose 2>&1 || true
  echo ""
  echo "--- BLE presence ---"
  mesh-presence 2>&1 || true
  echo ""
  echo "--- WiFi proximity ---"
  mesh-wifiscan 2>&1 || true
  echo ""
  echo "--- audio hardware ---"
  mesh-audio --verbose 2>&1 || true
  echo ""
  echo "--- card ---"
  head -10 ~/.mesh-card 2>/dev/null || echo "(no card)"
fi

echo ""
echo "=== end sensorium ==="
