#!/usr/bin/env python3
"""mesh-blessyou — a no-LLM reflex: hear a sneeze, say "bless you" in a real human voice.

Listens to a mic, detects a sudden loud burst (a sneeze — or a clap; false positives are
fine, by design), and plays a PRE-RECORDED "bless you" clip (a real person's voice) on a
ROTATING output node, so each blessing is a different voice from a different speaker. No LLM,
no API, no network beyond the LAN — energy detection + wav playback. Low latency, with a
cooldown so it never spams.

Clips: drop real-people recordings into ~/.mesh/blessyou/*.wav (capture with mesh-blessyou-rec).
Run in a tmux window:  tmux new-window -n blessyou 'mesh-blessyou'

CONSENT: always-on mic requires mic_always = yes in ~/.mesh/consent. See docs/consent.md.

Config (env):
  BY_MIC default          arecord device           BY_RATE 16000
  BY_FACTOR 6             spike = this x ambient     BY_FLOOR 700   absolute min rms to ever fire
  BY_COOLDOWN 8           seconds enforced quiet after a blessing
  BY_OUTPUTS "local"   rotating outputs (local = this node; others are ssh hosts)
  BY_USER imozerov        ssh user for remote outputs        BY_CLIPS ~/.mesh/blessyou
"""
import os, subprocess, time, random, glob, struct, socket, sys

def _source_nodes():
    """Source ~/.mesh/nodes into os.environ."""
    p = os.path.expanduser("~/.mesh/nodes")
    if not os.path.exists(p): return
    with open(p) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"): continue
            if "=" in line:
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip().strip('"').strip("'")
                if k and k not in os.environ: os.environ[k] = v

_source_nodes()
try:
    import audioop
    def rms(b): return audioop.rms(b, 2)
except Exception:
    def rms(b):
        n = len(b)//2
        if n == 0: return 0
        s = sum(v*v for v in struct.unpack("<%dh" % n, b[:n*2]))
        return int((s/n) ** 0.5)

RATE     = int(os.environ.get("BY_RATE", "16000"))
FACTOR   = float(os.environ.get("BY_FACTOR", "6"))
FLOOR    = int(os.environ.get("BY_FLOOR", "700"))
COOLDOWN = float(os.environ.get("BY_COOLDOWN", "8"))
DRAIN    = float(os.environ.get("BY_DRAIN", "2.5"))   # ignore the mic this long after playing — don't hear ourselves
MIC      = os.environ.get("BY_MIC", "default")
USER     = os.environ.get("BY_USER", "imozerov")
CLIPS    = os.path.expanduser(os.environ.get("BY_CLIPS", "~/.mesh/blessyou"))
OUTPUTS  = [o.strip() for o in os.environ.get("BY_OUTPUTS", "local").split(",") if o.strip()]
UID      = os.getuid()
AENV     = f"export XDG_RUNTIME_DIR=/run/user/{UID}; export PULSE_SERVER=unix:/run/user/{UID}/pulse/native; "
HOST     = socket.gethostname()
MESH_DIR = os.path.expanduser("~/.mesh")
CONSENT  = os.path.join(MESH_DIR, "consent")
PHONE    = os.environ.get("BY_PHONE", "")  # user@ip for torch indicator, e.g. u0_a386@<ts-ip>

# --- consent, announce, indicator, trace (docs/consent.md) ------------------
def _consent_always():
    if not os.path.exists(CONSENT): return False
    with open(CONSENT) as f:
        for line in f:
            if "mic_always" in line and "=" in line:
                val = line.split("=", 1)[1].split("#", 1)[0].strip().lower()  # strip inline comment
                if val in ("yes", "true", "1"):
                    return True
    return False

def _trace(msg):
    t = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = f"{t}  mesh-blessyou@{HOST}  ::  {msg}"
    os.makedirs(MESH_DIR, exist_ok=True)
    with open(os.path.join(MESH_DIR, "traces.log"), "a") as f:
        f.write(line + "\n")
    print(line, flush=True)

def _announce():
    say = os.path.expanduser("~/.local/bin/mesh-say")
    if os.path.exists(say):
        subprocess.Popen([say, "mic is listening for sneezes in this room"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def _torch_indicator(flashes=3):
    if not PHONE: return
    ssh_base = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4", "-p",
                os.environ.get("BY_PHONE_PORT", "8022"), PHONE]
    for _ in range(flashes):
        subprocess.run([*ssh_base, "termux-torch", "on"], capture_output=True, timeout=6)
        time.sleep(0.5)
        subprocess.run([*ssh_base, "termux-torch", "off"], capture_output=True, timeout=6)
        time.sleep(0.5)

def clips(): return sorted(glob.glob(os.path.join(CLIPS, "*.wav")))

PLAYER = os.environ.get("BY_PLAYER", "aplay -q")   # e.g. "paplay --device=<bose-sink>" to reach a pipewire sink
def play(clip, output):
    if output == "local":
        env = {**os.environ, "XDG_RUNTIME_DIR": f"/run/user/{UID}", "PULSE_SERVER": f"unix:/run/user/{UID}/pulse/native"}
        subprocess.Popen([*PLAYER.split(), clip], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        cmd = AENV + f"{PLAYER} ~/.mesh/blessyou/{os.path.basename(clip)}"
        subprocess.Popen(["ssh","-o","BatchMode=yes","-o","ConnectTimeout=6", f"{USER}@{output}", cmd],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def sync_remote(output):
    cs = clips()
    if not cs: return
    subprocess.run(["ssh","-o","BatchMode=yes","-o","ConnectTimeout=6", f"{USER}@{output}", "mkdir -p ~/.mesh/blessyou"], capture_output=True)
    subprocess.run(["scp","-q","-o","BatchMode=yes","-o","ConnectTimeout=6", *cs, f"{USER}@{output}:.mesh/blessyou/"], capture_output=True)

def main():
    if not _consent_always():
        print(f"[blessyou] REFUSED — always-on mic requires mic_always = yes in {CONSENT}", flush=True)
        print(f"[blessyou] See docs/consent.md", flush=True)
        sys.exit(3)
    for o in OUTPUTS:
        if o != "local": sync_remote(o)
    _trace("START: always-on mic energy detection")
    _announce()
    _torch_indicator()
    cs = clips()
    if not cs:
        print(f"[blessyou] no clips yet in {CLIPS} — record real voices: mesh-blessyou-rec <name>", flush=True)
    print(f"[blessyou] listening (mic={MIC}, {len(cs)} clips, outputs={OUTPUTS}) — a sneeze becomes a blessing", flush=True)
    p = subprocess.Popen(["arecord","-q","-D",MIC,"-f","S16_LE","-r",str(RATE),"-c","1","-t","raw"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    win = int(RATE * 0.05) * 2
    baseline, last, rot = float(FLOOR), 0.0, 0
    while True:
        data = p.stdout.read(win)
        if not data:
            time.sleep(0.3); continue
        level = rms(data); now = time.time()
        thresh = max(FLOOR, baseline * FACTOR)
        if level > thresh and (now - last) > COOLDOWN:
            cs = clips()
            if cs:
                clip = random.choice(cs); out = OUTPUTS[rot % len(OUTPUTS)]; rot += 1
                play(clip, out); last = now
                print(f"[blessyou] *burst* {level} (>{int(thresh)}) -> {os.path.basename(clip)} @ {out}", flush=True)
                # don't listen to our own playback: drain & discard the mic while it plays
                for _ in range(int(DRAIN / 0.05)):
                    p.stdout.read(win)
                baseline = float(FLOOR)   # reset ambient after the burst+playback
        else:
            baseline = 0.95 * baseline + 0.05 * level

if __name__ == "__main__":
    main()
