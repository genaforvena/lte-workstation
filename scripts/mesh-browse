#!/usr/bin/env python3
"""mesh-browse — the agent's BROWSER ORGAN. Loads a real (JS-rendered) page with Playwright and
returns it as TEXT (our air), so the mind can read and VERIFY the web itself — not guess. The web
becomes a sense: text-in -> text-out. (A real browser, so JS-heavy pages work, unlike curl.)

  mesh-browse <url>             readable text (title + body, trimmed)
  mesh-browse <url> --links     also list the page's links
  mesh-browse <url> --query SEL inner_text of a CSS selector only
  mesh-browse <url> --shot FILE also save a full-page screenshot (pixels, optional)
  mesh-browse <url> --json      machine-readable {title,url,text,links}
"""
import sys, re, json

def arg(flag, default=None):
    a = sys.argv
    return a[a.index(flag) + 1] if flag in a and a.index(flag) + 1 < len(a) else default

def main():
    a = sys.argv[1:]
    if not a or a[0].startswith("-"):
        print("usage: mesh-browse <url> [--links] [--query SEL] [--shot FILE] [--json] [--wait MS]")
        sys.exit(1)
    url = a[0]
    if "://" not in url:
        url = "https://" + url
    want_links = "--links" in a
    as_json = "--json" in a
    query = arg("--query")
    shot = arg("--shot")
    wait_ms = int(arg("--wait", "1200"))
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        print("mesh-browse: playwright not installed (pip3 install --user --break-system-packages playwright"
              " && python3 -m playwright install chromium)", file=sys.stderr)
        sys.exit(2)
    out = {"title": "", "url": url, "text": "", "links": []}
    with sync_playwright() as p:
        b = p.chromium.launch(headless=True, args=["--no-sandbox"])
        pg = b.new_page(user_agent="Mozilla/5.0 (X11; Linux x86_64) mesh-browse")
        try:
            pg.goto(url, timeout=30000, wait_until="domcontentloaded")
            pg.wait_for_timeout(wait_ms)
        except Exception as e:
            print(f"[nav warning] {e}", file=sys.stderr)
        out["title"] = pg.title()
        out["url"] = pg.url
        try:
            body = pg.inner_text(query) if query else pg.inner_text("body")
        except Exception as e:
            body = ""
            print(f"[text failed] {e}", file=sys.stderr)
        out["text"] = re.sub(r"\n{3,}", "\n\n", body).strip()
        if want_links or as_json:
            try:
                out["links"] = pg.eval_on_selector_all(
                    "a", "els => els.map(e => (e.innerText.trim()+' -> '+e.href)).filter(s => s.length>4)")
            except Exception:
                out["links"] = []
        if shot:
            try:
                pg.screenshot(path=shot, full_page=True)
                print(f"[screenshot -> {shot}]", file=sys.stderr)
            except Exception as e:
                print(f"[shot failed] {e}", file=sys.stderr)
        b.close()
    if as_json:
        print(json.dumps(out, ensure_ascii=False)); return
    print(f"# {out['title']}\n<{out['url']}>\n")
    print(out["text"][:6000])
    if want_links:
        print("\n## links")
        seen = set()
        for l in out["links"]:
            if l not in seen and len(seen) < 40:
                seen.add(l); print("• " + l[:160])

if __name__ == "__main__":
    main()
