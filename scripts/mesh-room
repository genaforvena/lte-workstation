#!/usr/bin/env bash
# mesh-room — thin verbs for the ROOM mind (runs on the mind node) to reach the room's mic+Bose node
# (default-string), where mesh-overhear keeps the rolling transcript and owns the speaker. Keeps the
# mind's workflow trivial — `mesh-room read` to see what's been said, `mesh-room say "…"` to speak a
# comment on the Bose — instead of hand-quoting nested ssh+bash -lc each time.
#
#   mesh-room read              LIVE read — re-transcribe the recent window, then print it (mesh-overhear --hear)
#   mesh-room show              cheap stale view — last-computed transcript + freshness header (no STT)
#   mesh-room say <text|stdin>  speak text on the room's Bose (third-party comment)
#   mesh-room --test            smoke: ssh dep + dispatch dry-run (no network, no Bose)
#
# Node is ROOM_NODE (default the default-string mic+Bose node). FOOTGUN GUARD: mesh-room hops to
# ROOM_NODE over ssh — but if it is itself RUN ON the room node (e.g. a mind wraps it in
# `ssh ds 'mesh-room say …'`, not realising mesh-room already hops), the naive form would ssh ds→ds
# to ITSELF and fail "Permission denied (publickey)" (no loopback key). So detect "ROOM_NODE is me"
# and run the inner command LOCALLY instead of self-hopping. (Observed 2026-06-21: the room mind
# burned minutes mis-reading this self-hop denial as a "tailscale-SSH auth flap".)
set -uo pipefail
NODE="${ROOM_NODE:-imozerov@100.125.157.75}"
HOST="${NODE#*@}"
SSH=(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$NODE")

# Am I the room node? (compare ROOM_NODE host against my own addresses)
LOCAL=0
if [ "$HOST" = localhost ] || [ "$HOST" = 127.0.0.1 ]; then
  LOCAL=1
else
  for ip in $(tailscale ip -4 2>/dev/null) $(hostname -I 2>/dev/null); do
    [ "$ip" = "$HOST" ] && { LOCAL=1; break; }
  done
fi

# Run an inner login-shell command on the room node — locally if that node is me, else one ssh hop.
# stdin passes through either way (needed for `say` to stream text to --say-stdin).
room_run() {
  if [ "$LOCAL" = 1 ]; then bash -lc "$1"; else "${SSH[@]}" "bash -lc '$1'"; fi
}

# ---- contact-attempt backoff (chat-review/room-voice-backoff) -------------------------------------
# The room mind's standing task is to keep LIVING CONTACT with the operator and post a [room-try] line
# every turn (mesh-dash room prompt). With no backoff that floods the board (8 near-identical "voiced X,
# no reply" posts in 7h, 2026-06-26). These verbs make the flood-control DETERMINISTIC (a counter the
# tool owns, not mind self-discipline): routine attempts go to the durable TRACE tier; the BOARD only
# sees a state change — backing off after N unanswered, or a reply/contact. Backoff is TIME-HEALED: after
# N unanswered the room goes quiet for COOLDOWN, then a fresh burst resumes (never permanent silence,
# never a flood). The mind calls `mesh-room replied` when it sees a response → counter resets + one board
# contact line. ROOM_CONTACT_SINK_ONLY=1 forces the file-append fallback (no real mesh-chat/mesh-trace)
# so --test never spams the board (reflex-test-must-sandbox-outbound).
MESH="${MESH_DIR:-$HOME/.mesh}"
CONTACT_STATE="$MESH/.room-contact.state"          # "count last_epoch" (last = epoch backoff was reached)
BACKOFF_N="${ROOM_CONTACT_BACKOFF_N:-3}"
COOLDOWN="${ROOM_CONTACT_COOLDOWN_SEC:-1800}"      # quiet span after backing off, before a fresh burst
_ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
_contact_trace(){  # routine attempt → durable trace tier, NEVER the board
  if [ -z "${ROOM_CONTACT_SINK_ONLY:-}" ] && command -v mesh-trace >/dev/null 2>&1; then
    mesh-trace "$1" >/dev/null 2>&1 || true
  else mkdir -p "$MESH"; printf '%s  mesh-room@%s  ::  %s\n' "$(_ts)" "$(hostname)" "$1" >> "$MESH/traces.log"; fi
}
_contact_board(){  # state change ONLY (give-up / reply) → the board
  if [ -z "${ROOM_CONTACT_SINK_ONLY:-}" ] && command -v mesh-chat >/dev/null 2>&1; then
    mesh-chat "$1" >/dev/null 2>&1 || true
  else mkdir -p "$MESH"; printf '%s  mesh-room@%s  ::  %s\n' "$(_ts)" "$(hostname)" "$1" >> "$MESH/chat.log"; fi
}
_contact_read(){ local c=0 e=0; [ -r "$CONTACT_STATE" ] && read -r c e < "$CONTACT_STATE" 2>/dev/null; printf '%s %s' "${c:-0}" "${e:-0}"; }
_contact_write(){ mkdir -p "$MESH"; printf '%s %s\n' "$1" "$2" > "$CONTACT_STATE"; }

# ---- visual identity gate (face-recognize × room) -------------------------------------------------
# The contact loop above keeps LIVING CONTACT with the OPERATOR but is identity-BLIND: mesh-misha-gate
# / mesh-room-sense already gate `say` on PRESENCE (someone is here) yet cannot tell the operator (Ilya,
# the contact TARGET) from his partner (Rozalia) or a STRANGER. `mesh-room who` adds that missing layer
# by running mesh-face-recognize on the freshest desk frame. FACE_MAX_AGE bounds trust: a stale frame is
# a DEAD camera, not a real "Nobody" — past it we answer UNKNOWN (can't see), never a faked presence.
FACE_FRAME="${FACE_FRAME:-$MESH/cam-prev.jpg}"   # freshest desk frame (mesh-cam-watch writes it)
FACE_MAX_AGE="${FACE_MAX_AGE:-300}"              # secs; older frame ⇒ camera not live ⇒ UNKNOWN

case "${1:-}" in
  --test)
    # Real check (not echo-ok): mesh-room is useless without ssh, so gate on it (FAILs when ssh is
    # absent). Then DRY-RUN the dispatch with no side-effect — an unknown verb must print usage and
    # exit 1 — proving the arg parser routes correctly without touching the network or speaking on
    # the Bose. (read/say are deliberately NOT exercised: they would hit the real remote.)
    command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh — mesh-room cannot reach the room node)"; exit 1; }
    [ -n "$NODE" ] || { echo "smoke-test: FAIL (ROOM_NODE is empty)"; exit 1; }
    out="$("$0" __smoke_badverb__ 2>&1)"; rc=$?
    if [ "$rc" -ne 1 ] || ! grep -q 'usage: mesh-room' <<<"$out"; then
      echo "smoke-test: FAIL (unknown-verb dispatch broken: rc=$rc, out=[$out])"; exit 1
    fi
    # ---- contact-backoff behaviour, fully sandboxed (temp state dir + SINK_ONLY → no real board/trace) ----
    td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
    drv(){ MESH_DIR="$td" ROOM_CONTACT_SINK_ONLY=1 ROOM_CONTACT_BACKOFF_N=3 ROOM_CONTACT_COOLDOWN_SEC=1800 "$0" "$@" >/dev/null 2>&1; }
    drv try "a1"; drv try "a2"        # attempts 1,2 — routine, board MUST stay silent
    if [ -s "$td/chat.log" ]; then echo "smoke-test: FAIL (backoff: routine attempts 1-2 leaked to the board)"; exit 1; fi
    [ "$(grep -c room-contact "$td/traces.log" 2>/dev/null)" -ge 2 ] || { echo "smoke-test: FAIL (backoff: routine attempts not routed to trace)"; exit 1; }
    drv try "a3"                       # attempt 3 == N — backoff REACHED → exactly one board line
    [ "$(grep -c 'backing off' "$td/chat.log" 2>/dev/null)" -eq 1 ] || { echo "smoke-test: FAIL (backoff: give-up board line not posted once at N)"; exit 1; }
    drv try "a4"                       # backed off → board MUST NOT grow
    [ "$(grep -c '\[room-try\]' "$td/chat.log" 2>/dev/null)" -eq 1 ] || { echo "smoke-test: FAIL (backoff: board grew while backed off)"; exit 1; }
    drv replied "operator answered"    # state change → reset + one CONTACT board line
    grep -q 'CONTACT' "$td/chat.log" || { echo "smoke-test: FAIL (replied: no CONTACT board line on state change)"; exit 1; }
    read -r c _ < "$td/.room-contact.state"; [ "$c" = 0 ] || { echo "smoke-test: FAIL (replied: counter not reset, c=$c)"; exit 1; }
    # cooldown self-heal: backed-off state older than COOLDOWN → next try resumes a fresh burst (no board)
    printf '3 %s\n' "$(( $(date +%s) - 4000 ))" > "$td/.room-contact.state"; : > "$td/chat.log"
    drv try "after-cooldown"
    [ -s "$td/chat.log" ] && { echo "smoke-test: FAIL (cooldown: fresh burst after COOLDOWN should not hit the board)"; exit 1; }
    read -r c _ < "$td/.room-contact.state"; [ "$c" = 1 ] || { echo "smoke-test: FAIL (cooldown: counter not reset to a fresh burst, c=$c)"; exit 1; }
    # ---- who (visual identity gate) honest-degrade, fully sandboxed (no real Groq / camera) ----------
    wt="$td/who"; mkdir -p "$wt/bin"
    [ "$(FACE_FRAME="$wt/none.jpg" "$0" who 2>/dev/null)" = UNKNOWN ] || { echo "smoke-test: FAIL (who: missing frame not UNKNOWN)"; exit 1; }
    : > "$wt/stale.jpg"; touch -d '@1' "$wt/stale.jpg" 2>/dev/null || touch -t 200001010000 "$wt/stale.jpg"
    [ "$(FACE_FRAME="$wt/stale.jpg" FACE_MAX_AGE=60 "$0" who 2>/dev/null)" = UNKNOWN ] || { echo "smoke-test: FAIL (who: STALE frame not UNKNOWN — a dead camera would read as presence)"; exit 1; }
    printf '#!/bin/sh\necho Ilya\n' > "$wt/bin/mesh-face-recognize"; chmod +x "$wt/bin/mesh-face-recognize"; : > "$wt/fresh.jpg"
    [ "$(PATH="$wt/bin:$PATH" FACE_FRAME="$wt/fresh.jpg" FACE_MAX_AGE=300 "$0" who 2>/dev/null)" = Ilya ] || { echo "smoke-test: FAIL (who: fresh frame + classifier did not pass the identity through)"; exit 1; }
    [ "$(PATH=/usr/bin:/bin FACE_FRAME="$wt/fresh.jpg" "$0" who 2>/dev/null)" = UNKNOWN ] || { echo "smoke-test: FAIL (who: missing face tool not UNKNOWN — stranded instead of honest-degraded)"; exit 1; }
    rm -rf "$td"; trap - EXIT
    echo "smoke-test: ok (ssh present; ROOM_NODE=$NODE; local=$LOCAL; unknown verb → usage+exit1; contact-backoff: routine→trace, board only on backoff/reply, cooldown self-heals; who: honest-UNKNOWN on no/stale-frame & no-tool, passes a fresh identity through)"
    exit 0 ;;
  read)
    # LIVE: re-transcribe the recent window on the room node so a thumbs-up reflects what's being said NOW
    # (not the last-trigger transcript). mesh-overhear --hear is flock-guarded → a burst can't pile up STT.
    room_run 'mesh-overhear --hear 2>/dev/null' ;;
  show|transcript)
    # cheap stale view — last-computed transcript + freshness header, no whisper run
    room_run 'mesh-overhear --show 2>/dev/null' ;;
  say|comment)
    shift
    # Misha dormant-by-default (operator 2026-06-24, tier-1): speak ONLY on CONFIRMED room occupancy
    # (camera/kbd/body/BLE/wifi — NEVER the audio classifier's sound/music false-positive). mesh-misha-gate
    # runs mesh-room-sense and requires verdict=PRESENT + confidence=high (which by fusion is non-audio
    # only). Fail-OPEN if the gate tool is missing so Misha isn't stranded on a not-yet-deployed node.
    if [ "${MISHA_CONFIRMED_ONLY:-1}" = 1 ] && command -v mesh-misha-gate >/dev/null 2>&1; then
      mesh-misha-gate || { echo "mesh-room say: suppressed — room not confirmed-occupied (Misha dormant)" >&2; exit 0; }
    fi
    { [ -n "${*:-}" ] && printf '%s' "$*" || cat; } | room_run 'mesh-overhear --say-stdin' ;;
  try|attempt)
    # Record ONE contact attempt. Routine → trace; board only when backoff is REACHED. Self-heals via COOLDOWN.
    shift; note="${*:-contact attempt}"
    read -r count last <<<"$(_contact_read)"; now="$(date +%s)"
    # cooldown reset: once backed off, after COOLDOWN secs a fresh burst is allowed
    if [ "$count" -ge "$BACKOFF_N" ] && [ "$last" -gt 0 ] && [ $((now - last)) -ge "$COOLDOWN" ]; then count=0; last=0; fi
    newcount=$((count + 1))
    if [ "$newcount" -lt "$BACKOFF_N" ]; then
      _contact_trace "[room-contact] attempt #$newcount (no reply yet): $note"
      _contact_write "$newcount" "$now"
      echo "room-contact: attempt #$newcount logged to trace — board stays quiet until a state change. Keep trying."
    elif [ "$newcount" -eq "$BACKOFF_N" ]; then
      _contact_board "[room-try] backing off — $BACKOFF_N contact attempts unanswered; going quiet, watching for a state change (reply / transcript change). Last: $note"
      _contact_trace "[room-contact] attempt #$newcount → BACKOFF reached: $note"
      _contact_write "$newcount" "$now"   # clock starts now (backoff-reached epoch)
      echo "room-contact: BACKOFF reached ($BACKOFF_N unanswered) — STOP actively trying, just watch. Resumes in ~${COOLDOWN}s, or call 'mesh-room replied' on a response."
    else
      _contact_trace "[room-contact] backed-off attempt #$newcount (suppressed from board): $note"
      _contact_write "$newcount" "$last"  # keep the backoff clock (do NOT push it forward)
      rem=$(( COOLDOWN - (now - last) )); [ "$rem" -lt 0 ] && rem=0
      echo "room-contact: still backed off (#$newcount) — watch only; resumes in ~${rem}s."
    fi ;;
  replied|heard|contact)
    # A state change (the room responded / transcript changed) — reset the counter + ONE board contact line.
    shift; note="${*:-}"
    read -r count last <<<"$(_contact_read)"
    if [ "${count:-0}" -gt 0 ]; then
      _contact_board "[room-try] CONTACT — room responded after $count attempt(s): ${note:-state change detected}"
    else
      _contact_board "[room-try] CONTACT — room state change: ${note:-response detected}"
    fi
    _contact_write 0 "$(date +%s)"
    echo "room-contact: counter reset on state change — resume the normal contact loop." ;;
  contact-status)
    read -r count last <<<"$(_contact_read)"; now="$(date +%s)"
    if [ "${count:-0}" -ge "$BACKOFF_N" ]; then
      rem=$(( COOLDOWN - (now - last) )); [ "$rem" -lt 0 ] && rem=0
      echo "room-contact: BACKED OFF (${count} unanswered) — resumes in ~${rem}s (or on 'mesh-room replied')"
    else
      echo "room-contact: ${count:-0} unanswered attempt(s) this burst (backoff at $BACKOFF_N)"
    fi ;;
  who|identity)
    # VISUAL IDENTITY at the desk → Ilya | Rozalia | Nobody | Stranger | UNKNOWN. The IDENTITY layer the
    # contact loop lacks (mesh-room-sense gates PRESENCE only). The room mind consults this to (a) not run
    # the operator-contact backoff when the present person is NOT the operator, and (b) NOT voice operator-
    # directed context to a Stranger (privacy). HONEST-DEGRADE everywhere → UNKNOWN, never a faked label:
    # no face tool, no frame, a STALE frame (dead camera ≠ real "Nobody"), or a classifier/API error.
    command -v mesh-face-recognize >/dev/null 2>&1 || { echo UNKNOWN; exit 0; }
    [ -f "$FACE_FRAME" ] || { echo UNKNOWN; exit 0; }
    fnow=$(date +%s); fmt=$(stat -c %Y "$FACE_FRAME" 2>/dev/null || echo 0)
    [ $((fnow - fmt)) -le "$FACE_MAX_AGE" ] || { echo UNKNOWN; exit 0; }   # stale frame ⇒ can't see
    flabel="$(mesh-face-recognize "$FACE_FRAME" 2>/dev/null)" || { echo UNKNOWN; exit 0; }
    case "$flabel" in
      Ilya|Rozalia|Nobody|Stranger) echo "$flabel" ;;
      *) echo UNKNOWN ;;
    esac ;;
  *)
    echo "usage: mesh-room read | show | say <text|stdin> | who | try <note> | replied [note] | contact-status"; exit 1 ;;
esac
