#!/usr/bin/env bash
# mesh-ats-keepalive — keep an IDLE browser-drive session alive so a half-finished ATS form is not
# lost to the drive's own idle timeout (HH_IDLE_LIMIT, 45 min). Replaces a mind poking the drives by
# hand every 25 minutes, which cost a paid turn per poke (roll-call PROPOSE keepalive-в-cron,
# 2026-08-15T15:00:58Z; operator approved).
#
# THE ONE RULE THAT MAKES THIS SAFE TO RUN UNATTENDED: it pokes only drives that NOBODY IS USING.
# A browser drive is a single-writer resource — commands are appended to <name>-cmd.txt and executed
# in order, so a blind poker's `js` line lands BETWEEN another writer's `fill` and `click` steps.
# That is not hypothetical: on 2026-08-15 the job mind poked ats/ats3 every 25 min for 7.5h while tg
# took the same two forms over (operator-approved email swap, 17:19Z) — two writers, one drive, and
# the interleaving was visible in the drive log. Hence the idle floor below: an ACTIVE driver appends
# commands constantly, which keeps <name>-cmd.txt's mtime fresh, and a fresh mtime means the drive is
# in use and needs no keeping alive. Silence is the correct output whenever anyone is working.
#
# Poke = one read-only `js` line carrying a UNIQUE marker, then assert that exact marker comes back in
# <name>-drive.log. The marker is what makes the check real: the drive log already holds the previous
# poke's reply, so grepping for a constant string would pass against a stale line from a dead drive
# (a cached sample re-read is not a fresh confirmation).
#
# THE POKE CARRIES PAGE IDENTITY, AND A FINISHED PAGE STOPS IT. The first version asked one boolean —
# does the text contain "Security code" — and printed WAITING/GONE. On 2026-08-15 tg SUBMITTED both
# forms (17:32Z Kayzen, 17:40Z RTB House); from 17:24:43Z every poke read GONE, and the reflex went on
# keeping two CONFIRMATION pages alive every 20 min for hours. The word was not wrong, it was
# undiscriminating: one absent substring reads the same for "submitted", "session expired" and
# "navigated elsewhere", and a keepalive whose only verdict cannot say DONE has no reason to ever
# stop. So the poke now reports page=DONE|CODE|FORM plus title+url, a DONE writes <name>-drive.done
# and every later run skips that drive by name — until someone drives it again (a fresh cmd-file write
# clears the flag, since an active writer means the session is back in use).
#
#   mesh-ats-keepalive              poke every idle+live drive under $ATS_KA_ROOT
#   mesh-ats-keepalive --list       report each drive's state, poke nothing
#   mesh-ats-keepalive --test       smoke test (drives a REAL fake drive end-to-end)
#
# Exit 0 = evaluated (including "everything skipped"); 2 = no drive on this node (honest n/a, so
# mesh-autowire SKIPs it everywhere the job lane is absent); 1 = a live drive failed to answer.
#
# reflex-cadence: */20 * * * *
set -uo pipefail

ROOT="${ATS_KA_ROOT:-$HOME/.mesh/job}"
STATE="$ROOT/ats-keepalive.state"
IDLE_FLOOR="${ATS_KA_IDLE_FLOOR:-900}"   # s of quiet on the cmd file before we call a drive idle
ECHO_WAIT="${ATS_KA_ECHO_WAIT:-30}"      # s to wait for the marker to come back

now() { date -u +%s; }
stamp() { date -u +%FT%TZ; }

# poke_one <name> -> prints "<name> <verdict> <detail>"; returns 0 ok/skip, 1 live-but-mute
poke_one() {
  # NB: separate `local` statements — in one multi-assign, $name is still unbound when cmd/log/pidf
  # are expanded, which under `set -u` aborts the function (memory: local-multiassign-set-u-trap).
  local name="$1"
  local cmd="$ROOT/$name-cmd.txt"
  local log="$ROOT/$name-drive.log"
  local pidf="$ROOT/$name-drive.pid"
  local donef="$ROOT/$name-drive.done"
  local pid age marker waited reply

  pid="$(cat "$pidf" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) echo "$name skipped-nopid -"; return 0 ;; esac
  kill -0 "$pid" 2>/dev/null || { echo "$name skipped-dead pid=$pid"; return 0; }
  [ -f "$cmd" ] || { echo "$name skipped-nocmd -"; return 0; }

  age=$(( $(now) - $(stat -c %Y "$cmd") ))
  if [ "$age" -lt "$IDLE_FLOOR" ]; then
    # Someone is driving it (possibly another mind). Not ours to touch, and it cannot go idle-stale
    # while its own writer is active. An active writer also means the session is IN USE again, so a
    # "done" left by an earlier, finished form must not outlive it — but OUR OWN poke freshens that
    # same mtime, and a reflex that reads its own write as "somebody is working here" would erase the
    # verdict it just recorded and poke the finished page again on the next cycle.
    case "$(tail -1 "$cmd" 2>/dev/null)" in
      "js '"*"| page='"*) ;;   # our own keepalive poke — not a new writer
      *) rm -f "$donef" ;;
    esac
    echo "$name skipped-active quiet=${age}s<${IDLE_FLOOR}s"
    return 0
  fi

  if [ -s "$donef" ]; then
    # The form this session carried was submitted. Keeping a confirmation page alive keeps nothing.
    echo "$name skipped-done $(cat "$donef")"
    return 0
  fi

  marker="ka$(now)$$"
  # page=DONE (submitted — nothing left to keep alive) | CODE (waiting on a security code) | FORM.
  # Title+url ride along so a verdict names the page it came from instead of one anonymous boolean.
  printf "js '%s | page='+((/confirmation/.test(location.href)||/application has been received|Thank you for applying/i.test(document.body.innerText))?'DONE':(/[Ss]ecurity code/.test(document.body.innerText)?'CODE':'FORM'))+' | t='+document.title.slice(0,40)+' | u='+location.href.slice(-60)\n" "$marker" >> "$cmd" || {
    echo "$name FAIL-append -"; return 1; }

  waited=0
  while [ "$waited" -lt "$ECHO_WAIT" ]; do
    if grep -q "$marker" "$log" 2>/dev/null; then
      reply="$(grep "$marker" "$log" | tail -1 | sed 's/^\[js\] //')"
      # NB: matched as the contiguous "page=DONE". The drive log ALSO holds the echoed `>>> js …`
      # source line, where DONE appears only as the quoted literal 'DONE' after `page='+(` — so this
      # cannot match its own command text (source text is never behaviour).
      case "$reply" in
        *"page=DONE"*)
          printf '%s %s\n' "$(stamp)" "$reply" > "$donef"
          echo "$name poked-done $reply"
          return 0 ;;
      esac
      echo "$name poked $reply"
      return 0
    fi
    sleep 2; waited=$(( waited + 2 ))
  done
  echo "$name FAIL-mute marker=$marker unanswered ${ECHO_WAIT}s (drive alive but not executing)"
  return 1
}

drives() {
  local f n
  for f in "$ROOT"/*-drive.pid; do
    [ -e "$f" ] || continue
    n="$(basename "$f")"; n="${n%-drive.pid}"
    printf '%s\n' "$n"
  done
}

# ---------------------------------------------------------------- test
if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$d"; [ -n "${fakepid:-}" ] && kill "$fakepid" 2>/dev/null' EXIT

  # no drive at all -> honest n/a, exit 2 (this is what makes autowire SKIP the reflex off-lane)
  ATS_KA_ROOT="$d" "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || { echo "smoke-test: FAIL (empty root must exit 2, honest n/a)"; exit 1; }

  # a REAL fake drive: consumes each new cmd line and ANSWERS it the way the browser drive does —
  # a `js` line comes back as `[js] <marker> | page=… | t=… | u=…`, with the page state taken from
  # $d/x-page. It must ANSWER rather than echo the source: a drive that merely echoed the command
  # back would leave the DONE branch untestable (and would "match" only its own text).
  # COVERAGE LIMIT, stated so green is not misread: no browser runs here, so the fixture asserts the
  # REFLEX's handling of a page verdict — never the `js` classifier that produces it. Whether a real
  # confirmation page reads DONE is a claim only a live drive can settle (it did, on ats/ats3
  # 2026-08-15: both replied page=DONE, u=…/confirmation).
  ( n=0
    while :; do
      total="$(wc -l < "$d/x-cmd.txt" 2>/dev/null || echo 0)"
      while [ "$n" -lt "$total" ]; do
        n=$(( n + 1 ))
        line="$(sed -n "${n}p" "$d/x-cmd.txt")"
        case "$line" in
          "js '"*)
            m="${line#js \'}"; m="${m%% *}"
            page="$(cat "$d/x-page" 2>/dev/null || echo FORM)"
            u="https://example.test/jobs/1"; [ "$page" = DONE ] && u="$u/confirmation"
            printf '[js] %s | page=%s | t=Job Application for X | u=%s\n' "$m" "$page" "$u" >> "$d/x-drive.log" ;;
          *) printf '[cmd] %s\n' "$line" >> "$d/x-drive.log" ;;
        esac
      done
      sleep 0.3
    done ) & fakepid=$!
  echo $fakepid > "$d/x-drive.pid"
  : > "$d/x-cmd.txt"; : > "$d/x-drive.log"; echo FORM > "$d/x-page"
  touch -d '2 hours ago' "$d/x-cmd.txt"

  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"; rc=$?
  [ $rc -eq 0 ] || { echo "smoke-test: FAIL (idle live drive: rc=$rc)"; echo "$out"; exit 1; }
  case "$out" in *"x poked"*) ;; *) echo "smoke-test: FAIL (idle live drive not poked): $out"; exit 1 ;; esac
  # the poke must be a FRESH marker echoed back, not a re-read: two runs must differ
  first="$(grep -c 'ka[0-9]' "$d/x-drive.log")"
  [ "$first" -eq 1 ] || { echo "smoke-test: FAIL (expected exactly 1 marker, got $first)"; exit 1; }

  # ACTIVE drive (someone else just wrote a command) must be SKIPPED — the single-writer guard
  printf 'fill #email someone-else\n' >> "$d/x-cmd.txt"
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"
  case "$out" in *"x skipped-active"*) ;; *) echo "smoke-test: FAIL (active drive must be skipped, got): $out"; exit 1 ;; esac
  [ "$(grep -c 'ka[0-9]' "$d/x-drive.log")" -eq 1 ] || { echo "smoke-test: FAIL (poked an ACTIVE drive — second writer)"; exit 1; }

  # A SUBMITTED form (confirmation page) must be recognised and must STOP the poking — the failure
  # this reflex shipped with: two applications submitted 2026-08-15, poked every 20 min regardless.
  echo DONE > "$d/x-page"
  touch -d '2 hours ago' "$d/x-cmd.txt"
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"; rc=$?
  [ $rc -eq 0 ] || { echo "smoke-test: FAIL (done page: rc=$rc): $out"; exit 1; }
  case "$out" in *"x poked-done"*"page=DONE"*) ;; *) echo "smoke-test: FAIL (submitted page not read as DONE): $out"; exit 1 ;; esac
  [ -s "$d/x-drive.done" ] || { echo "smoke-test: FAIL (DONE reply left no done-flag — next run pokes again)"; exit 1; }
  [ "$(grep -c 'ka[0-9]' "$d/x-drive.log")" -eq 2 ] || { echo "smoke-test: FAIL (expected 2 markers after the DONE poke)"; exit 1; }

  # our own poke left the cmd file fresh: the very next run sees "active" — and must NOT read its own
  # write as a new writer and delete the verdict it just recorded
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"
  case "$out" in *"x skipped-active"*) ;; *) echo "smoke-test: FAIL (own fresh poke should read active): $out"; exit 1 ;; esac
  [ -s "$d/x-drive.done" ] || { echo "smoke-test: FAIL (the reflex erased its own DONE verdict, reading its own poke as a new writer)"; exit 1; }

  # and the NEXT run must not touch that drive at all
  touch -d '2 hours ago' "$d/x-cmd.txt"
  before="$(wc -c < "$d/x-cmd.txt")"
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"
  case "$out" in *"x skipped-done"*) ;; *) echo "smoke-test: FAIL (finished drive poked again, got): $out"; exit 1 ;; esac
  [ "$(wc -c < "$d/x-cmd.txt")" -eq "$before" ] || { echo "smoke-test: FAIL (wrote to a FINISHED drive's cmd file)"; exit 1; }
  [ "$(grep -c 'ka[0-9]' "$d/x-drive.log")" -eq 2 ] || { echo "smoke-test: FAIL (poked a drive already read as DONE)"; exit 1; }

  # ...until someone drives the session again: a fresh write clears the done-flag, so a REUSED
  # session is kept alive like any other (a done that outlived its form would kill the reflex)
  printf 'fill #email next-form\n' >> "$d/x-cmd.txt"
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"
  case "$out" in *"x skipped-active"*) ;; *) echo "smoke-test: FAIL (reused drive must be skipped-active): $out"; exit 1 ;; esac
  [ ! -e "$d/x-drive.done" ] || { echo "smoke-test: FAIL (done-flag survived a new writer — session reuse is never kept alive again)"; exit 1; }
  echo FORM > "$d/x-page"
  touch -d '2 hours ago' "$d/x-cmd.txt"
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"
  case "$out" in *"x poked"*) ;; *) echo "smoke-test: FAIL (reused idle drive not poked): $out"; exit 1 ;; esac
  [ "$(grep -c 'ka[0-9]' "$d/x-drive.log")" -eq 3 ] || { echo "smoke-test: FAIL (expected a 3rd marker on the reused drive)"; exit 1; }

  # DEAD pid must be skipped, never resurrected
  kill "$fakepid" 2>/dev/null; wait "$fakepid" 2>/dev/null; fakepid=
  touch -d '2 hours ago' "$d/x-cmd.txt"
  before="$(wc -c < "$d/x-cmd.txt")"
  out="$(ATS_KA_ROOT="$d" "$0" 2>&1)"
  case "$out" in *"x skipped-dead"*) ;; *) echo "smoke-test: FAIL (dead drive must be skipped, got): $out"; exit 1 ;; esac
  [ "$(wc -c < "$d/x-cmd.txt")" -eq "$before" ] || { echo "smoke-test: FAIL (wrote to a DEAD drive's cmd file)"; exit 1; }

  # a live-but-mute drive must FAIL, not pass quietly
  sleep 999 & fakepid=$!; echo $fakepid > "$d/x-drive.pid"
  touch -d '2 hours ago' "$d/x-cmd.txt"
  out="$(ATS_KA_ROOT="$d" ATS_KA_ECHO_WAIT=4 "$0" 2>&1)"; rc=$?
  [ $rc -eq 1 ] || { echo "smoke-test: FAIL (mute drive must exit 1, got rc=$rc): $out"; exit 1; }
  case "$out" in *"FAIL-mute"*) ;; *) echo "smoke-test: FAIL (mute drive not named): $out"; exit 1 ;; esac

  # the test must never have written the REAL state artifact
  [ ! -e "$d/../ats-keepalive.state" ] || true
  echo "smoke-test: ok (n/a exit2 + fresh-marker poke + active-skip + DONE-stops-poking + reuse-clears-done + dead-skip + mute-fails)"
  exit 0
fi

# ---------------------------------------------------------------- main
[ -d "$ROOT" ] || { echo "mesh-ats-keepalive: n/a (no $ROOT)"; exit 2; }
names="$(drives)"
[ -n "$names" ] || { echo "mesh-ats-keepalive: n/a (no *-drive.pid under $ROOT)"; exit 2; }

if [ "${1:-}" = --list ]; then
  for n in $names; do
    pid="$(cat "$ROOT/$n-drive.pid" 2>/dev/null)"
    alive=no; kill -0 "$pid" 2>/dev/null && alive=yes
    q=$(( $(now) - $(stat -c %Y "$ROOT/$n-cmd.txt" 2>/dev/null || now) ))
    done_="no"; [ -s "$ROOT/$n-drive.done" ] && done_="yes ($(cat "$ROOT/$n-drive.done"))"
    echo "$n pid=$pid alive=$alive quiet=${q}s floor=${IDLE_FLOOR}s done=$done_"
  done
  exit 0
fi

rc=0
for n in $names; do
  poke_one "$n" || rc=1
done

# liveness = ran, independent of whether anything needed poking (the change-gated content is the log
# line above; this artifact carries "the reflex evaluated")
{ printf '%s ' "$(stamp)"; for n in $names; do printf '%s ' "$n"; done; printf 'rc=%s\n' "$rc"; } >> "$STATE.log" 2>/dev/null
mesh-state-touch --create "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null
exit $rc
