#!/usr/bin/env bash
# mesh-hn-watch — watch a Hacker News thread (Show HN post) for new comments.
#
# Read-only: uses the public HN Algolia API (no auth). Posting a reply still needs the
# operator's HN login (HN has no write API) — this tool surfaces the thread + flags NEW
# comments so the pub mind can DRAFT replies from the pane; the operator pastes them.
#
# Usage:
#   mesh-hn-watch <id|url>            # one-shot render of the thread (points + all comments)
#   mesh-hn-watch <id|url> --watch    # live data-pane loop (refreshes, highlights NEW)
#   mesh-hn-watch <id|url> --new      # print ONLY unseen comments + mark them seen (mind feed)
#   mesh-hn-watch --test              # deterministic self-test (fixture, no network)
#
# <id|url> accepts a bare item id, a news.ycombinator.com/item?id=N url, or anything with id=N.
# State (seen comment ids) per thread: ~/.mesh/hn-watch-<id>.seen
#
# orphan-ok: on-demand publication helper, driven by the pub channel, not wired to cron.
set -euo pipefail

INTERVAL="${MESH_HN_INTERVAL:-90}"

extract_id() { printf '%s' "$1" | grep -oE '[0-9]{4,}' | head -1; }

# emit: read an HN Algolia item JSON on stdin, render it. env: MESH_HN_MODE, MESH_HN_SEEN.
# Pure (no network) so --test can drive it with a fixture.
emit() {
  MESH_HN_MODE="$1" MESH_HN_SEEN="$2" python3 -c '
import json, sys, os, time, re, html
d = json.loads(sys.stdin.read())
mode = os.environ["MESH_HN_MODE"]; seen_f = os.environ["MESH_HN_SEEN"]
seen = set(l.strip() for l in open(seen_f) if l.strip()) if os.path.exists(seen_f) else set()

rows = []
def walk(n, depth):
    if n.get("type") == "comment" and n.get("text"):
        rows.append((n.get("created_at_i") or 0, depth, str(n.get("id")), n.get("author") or "?", n.get("text")))
    for k in (n.get("children") or []):
        walk(k, depth + (0 if n.get("type") != "comment" else 1))
walk(d, 0)
rows.sort(key=lambda r: r[0])

def clean(t):
    t = re.sub(r"<p>", "\n", t); t = re.sub(r"<[^>]+>", "", t)
    return html.unescape(t).strip()

now = int(time.time())
def age(ts):
    s = max(0, now - ts)
    if s < 3600: return str(s//60)+"m"
    if s < 86400: return str(s//3600)+"h"
    return str(s//86400)+"d"

new = [r for r in rows if r[2] not in seen]
if mode != "new":
    title = d.get("title") or "(Show HN)"; pts = d.get("points"); iid = d.get("id")
    sys.stdout.write("\033[1m"+str(title)+"\033[0m\n")
    sys.stdout.write("points="+str(pts)+"  comments="+str(len(rows))+"  NEW="+str(len(new))+"  id="+str(iid)+"  https://news.ycombinator.com/item?id="+str(iid)+"\n")
    sys.stdout.write("-"*78+"\n")

show = new if mode == "new" else rows
if mode == "new" and not new:
    print("(no new comments)")
for ts, depth, cid, author, text in show:
    indent = "  " * min(depth, 6)
    flag = "\033[33m[NEW]\033[0m " if (cid not in seen and mode != "new") else ""
    print(indent+flag+"\033[36m"+author+"\033[0m  "+age(ts)+" ago  ·  id="+cid)
    for line in clean(text).splitlines():
        print(indent+"  "+line)
    print()

if mode in ("watch", "new") and rows:
    with open(seen_f, "w") as fh:
        fh.write("\n".join(r[2] for r in rows) + "\n")
'
}

fetch() {  # <id> → JSON on stdout, or empty + rc2 (honest: never fake-empty). 404 = fail fast.
  local id="$1" try resp code json
  for try in 1 2 3; do
    resp=$(curl -s -w $'\n%{http_code}' --max-time 20 "https://hn.algolia.com/api/v1/items/$id" 2>/dev/null) || true
    code="${resp##*$'\n'}"; json="${resp%$'\n'*}"
    [ "$code" = 404 ] && return 2
    if [ -n "$json" ] && printf '%s' "$json" | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("id") and d.get("type") else 1)' 2>/dev/null; then
      printf '%s' "$json"; return 0
    fi
    [ "$try" -lt 3 ] && sleep 2
  done
  return 2
}

render() {  # <id> <mode>
  local id="$1" mode="$2" json
  if ! json=$(fetch "$id"); then
    echo "mesh-hn-watch: UNREACHABLE or invalid thread id=$id (HN API down / no egress / bad id) — NOT an empty thread" >&2
    return 2
  fi
  printf '%s' "$json" | emit "$mode" "$HOME/.mesh/hn-watch-$id.seen"
}

if [ "${1:-}" = "--test" ]; then
  fail=0
  fixture='{"id":111,"type":"story","title":"Show HN: test","points":42,"children":[
    {"id":201,"type":"comment","author":"alice","created_at_i":1,"text":"first <i>comment</i>","children":[
      {"id":202,"type":"comment","author":"bob","created_at_i":2,"text":"a reply&#x27;s text","children":[]}]}]}'
  seen=$(mktemp)
  out=$(printf '%s' "$fixture" | emit full "$seen")
  printf '%s' "$out" | grep -qE 'points=42' || { echo "FAIL: points not parsed"; fail=1; }
  printf '%s' "$out" | grep -qE 'comments=2' || { echo "FAIL: comment count wrong"; fail=1; }
  printf '%s' "$out" | grep -qE 'id=201' || { echo "FAIL: comment id missing"; fail=1; }
  printf '%s' "$out" | grep -qF "a reply's text" || { echo "FAIL: html-unescape/clean broke"; fail=1; }
  printf '%s' "$out" | grep -qE 'NEW=2' || { echo "FAIL: NEW count wrong on fresh seen"; fail=1; }
  # offset consume: --new marks seen; a 2nd --new sees nothing new
  printf '%s' "$fixture" | emit new "$seen" >/dev/null
  out2=$(printf '%s' "$fixture" | emit new "$seen")
  printf '%s' "$out2" | grep -qF '(no new comments)' || { echo "FAIL: seen-offset not consumed"; fail=1; }
  rm -f "$seen"
  # honest-failure shape: a 404 id must error (rc2), never print an empty thread
  if render 999999999999 full >/dev/null 2>&1; then echo "FAIL: bad id did not error"; fail=1; fi
  [ "$fail" = 0 ] && echo "smoke-test: ok (fixture parses points/comments/ids; clean+unescape; seen-offset consumes; bad id → honest error)"
  exit $fail
fi

ITEM_FILE="${MESH_HN_ITEM:-$HOME/.mesh/hn-item}"

# --arm <id|url>: record the live thread id so an --armed pane starts watching it.
if [ "${1:-}" = "--arm" ]; then
  [ $# -ge 2 ] || { echo "usage: mesh-hn-watch --arm <id|url>" >&2; exit 1; }
  aid=$(extract_id "$2"); [ -n "$aid" ] || { echo "mesh-hn-watch: no id in '$2'" >&2; exit 1; }
  printf '%s\n' "$aid" > "$ITEM_FILE"
  echo "armed: pub pane will now watch https://news.ycombinator.com/item?id=$aid"
  exit 0
fi

# --armed: data-pane loop that waits (un-armed) then auto-watches once --arm sets the id.
if [ "${1:-}" = "--armed" ]; then
  while :; do
    clear 2>/dev/null || true
    echo "=== mesh-hn-watch (pub) · $(date -u +%H:%M:%SZ) ==="
    aid=$(head -1 "$ITEM_FILE" 2>/dev/null | tr -dc '0-9' || true)
    if [ -n "$aid" ]; then
      render "$aid" watch || echo "(thread unreachable this cycle — will retry)"
    else
      echo
      echo "  WAITING — no HN item armed yet."
      echo "  When the Show HN post is live, arm it with:"
      echo "      mesh-hn-watch --arm <hn-url-or-id>"
      echo "  This pane then auto-watches the thread + flags [NEW] comments to draft replies for."
    fi
    sleep "$INTERVAL"
  done
fi

[ $# -ge 1 ] || { echo "usage: mesh-hn-watch <id|url> [--watch|--new] | --arm <id|url> | --armed" >&2; exit 1; }
ID=$(extract_id "$1"); shift || true
[ -n "$ID" ] || { echo "mesh-hn-watch: could not extract an HN item id" >&2; exit 1; }
MODE="full"; [ "${1:-}" = "--watch" ] && MODE="watch"; [ "${1:-}" = "--new" ] && MODE="new"

if [ "$MODE" = "watch" ]; then
  while :; do
    clear 2>/dev/null || true
    echo "=== mesh-hn-watch (refresh ${INTERVAL}s · $(date -u +%H:%M:%SZ)) ==="
    render "$ID" watch || echo "(thread unreachable this cycle — will retry)"
    sleep "$INTERVAL"
  done
else
  render "$ID" "$MODE"
fi
