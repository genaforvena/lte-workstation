#!/usr/bin/env bash
# reflex-cadence: */11 * * * *
# mesh-psi-io — local I/O pressure sense from /proc/pressure/io.
#
# Why this is new:
#   The tree already has battery, thermal, and cooling-load senses, but not PSI
#   (pressure stall information). /proc/pressure/io is a real kernel signal that
#   tells us when storage-backed work is stalling. This sense reports the current
#   I/O pressure level honestly and exits 2 if the file is unreachable.
#
# Contract:
#   no readable /proc/pressure/io -> exit 2, never fabricate a reading
#
#   mesh-psi-io          one compact line
#   mesh-psi-io --json   machine-readable JSON
#   mesh-psi-io --test   fixture smoke test + real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.psi-io.state"
OFFLINEFILE="$MESH/.psi-io-offline"
PRESSURE_IO_FILE="${MESH_PRESSURE_IO_FILE:-/proc/pressure/io}"
mkdir -p "$MESH" 2>/dev/null || true

classify() {
  awk -v some="${1:-}" 'BEGIN{
    if (some == "" || some !~ /^[0-9]+([.][0-9]+)?$/) { print "UNKNOWN"; exit }
    if (some >= 50.0) { print "SATURATED"; exit }
    if (some >= 10.0) { print "PRESSURED"; exit }
    if (some > 0.5) { print "BUSY"; exit }
    print "QUIET"
  }'
}

read_pressure() {
  awk '
    $1 == "some" {
      for (i = 2; i <= NF; i++) {
        split($i, kv, "=")
        if (kv[1] == "avg10") some10 = kv[2]
        else if (kv[1] == "avg60") some60 = kv[2]
        else if (kv[1] == "avg300") some300 = kv[2]
        else if (kv[1] == "total") some_total = kv[2]
      }
    }
    $1 == "full" {
      for (i = 2; i <= NF; i++) {
        split($i, kv, "=")
        if (kv[1] == "avg10") full10 = kv[2]
        else if (kv[1] == "avg60") full60 = kv[2]
        else if (kv[1] == "avg300") full300 = kv[2]
        else if (kv[1] == "total") full_total = kv[2]
      }
    }
    END {
      if (some10 == "") exit 1
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", some10, some60, some300, some_total, full10, full60, full300, full_total
    }
  ' "$1"
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT

  cat >"$td/io" <<'EOF'
some avg10=0.00 avg60=0.10 avg300=0.20 total=12
full avg10=0.00 avg60=0.00 avg300=0.00 total=0
EOF
  got="$(MESH_PRESSURE_IO_FILE="$td/io" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (quiet fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"QUIET"' || { echo "smoke-test: FAIL (quiet fixture -> QUIET: $got)"; exit 1; }

  cat >"$td/io" <<'EOF'
some avg10=12.34 avg60=8.00 avg300=3.00 total=99
full avg10=0.01 avg60=0.00 avg300=0.00 total=1
EOF
  got="$(MESH_PRESSURE_IO_FILE="$td/io" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (pressured fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"PRESSURED"' || { echo "smoke-test: FAIL (pressured fixture -> PRESSURED: $got)"; exit 1; }

  cat >"$td/io" <<'EOF'
some avg10=77.00 avg60=70.00 avg300=65.00 total=1234
full avg10=61.00 avg60=50.00 avg300=40.00 total=567
EOF
  got="$(MESH_PRESSURE_IO_FILE="$td/io" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (saturated fixture read)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"label":"SATURATED"' || { echo "smoke-test: FAIL (saturated fixture -> SATURATED: $got)"; exit 1; }

  [ -r "$PRESSURE_IO_FILE" ] || { echo "smoke-test: n/a (no readable PSI io source on this node)"; exit 2; }
  real="$(MESH_PRESSURE_IO_FILE="$PRESSURE_IO_FILE" "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (real read failed)"; exit 1; }
  printf '%s\n' "$real" | grep -q '"source":"/proc/pressure/io"' || {
    printf '%s\n' "$real" | grep -q '"source":"'"$PRESSURE_IO_FILE"'"' || {
      echo "smoke-test: FAIL (real read missing source tag: $real)"; exit 1;
    }
  }
  echo "smoke-test: ok (fixture classifier + live /proc/pressure/io read)"
  exit 0
fi

JSON=0
for a in "$@"; do
  [ "$a" = --json ] && JSON=1
done

[ -r "$PRESSURE_IO_FILE" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "psi-io: UNREACHABLE — no readable $PRESSURE_IO_FILE" >&2; : > "$OFFLINEFILE"; }
  exit 2
}

readout="$(read_pressure "$PRESSURE_IO_FILE" 2>/dev/null)" || {
  [ -f "$OFFLINEFILE" ] || { echo "psi-io: UNREACHABLE — unreadable $PRESSURE_IO_FILE" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

IFS=$'\t' read -r some10 some60 some300 some_total full10 full60 full300 full_total <<EOF
$readout
EOF

label="$(classify "$some10")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
host="$(hostname)"
printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
  "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$ts" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","some_avg10":%s,"some_avg60":%s,"some_avg300":%s,"some_total":%s,"full_avg10":%s,"full_avg60":%s,"full_avg300":%s,"full_total":%s,"source":"%s","host":"%s","ts":"%s"}\n' \
    "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$PRESSURE_IO_FILE" "$host" "$ts"
else
  printf '[psi-io] %s — some avg10=%s avg60=%s avg300=%s total=%s | full avg10=%s avg60=%s avg300=%s total=%s @ %s %s\n' \
    "$label" "$some10" "$some60" "$some300" "$some_total" "$full10" "$full60" "$full300" "$full_total" "$host" "$ts"
fi
