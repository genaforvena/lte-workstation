#!/usr/bin/env bash
# mesh-tuner — instrument tuner REFLEX. Listens to the room mic, detects the pitch of a played
# note (guitar / cello / any monophonic instrument), finds the NEAREST chromatic note and how many
# cents off it is, and SAYS it on the Bose: "<нота> выше / ниже / чисто". Pure local DSP (numpy YIN
# pitch detection) — NO speech recognition, NO cloud — so it is fast enough to be a real tuner.
# Operator 2026-06-20: "тюнер чисто на рефлексе … какую ноту определил и выше/ниже".
#
# Runs on the node with the mic + Bose (default-string). Reuses the piper voice + Bose-sink
# targeting that mesh-overhear uses, so the voice comes out the Bose like everything else.
#
#   mesh-tuner --autoarm   HANDS-FREE daemon: continuously sample the mic cheaply, ARM + announce
#                          ONLY when a SUSTAINED MUSICAL pitch is held (stable f0 ~>=0.4s, periodic
#                          /harmonic) → ignores speech, transients, silence so it can share the mic
#                          with the always-on mesh-overhear daemon. Honors the MUTE_FLAG. This is the
#                          mode the systemd --user unit (mesh-tuner.service) runs on default-string.
#   mesh-tuner --loop      continuous tuner: keep listening, announce note + выше/ниже as you tune
#   mesh-tuner --once      one capture → detect → say once (and print the reading)
#   mesh-tuner --detect    print freq/note/cents only, no audio out — for tuning TUNER_RMS / debug
#   mesh-tuner --render    (re)render the spoken note/direction phrase cache (idempotent)
#   mesh-tuner --test      synthetic self-test (no mic, no Bose) — pitch math + the autoarm gate
#
# Tunables (env): TUNER_RMS=350 (s16 RMS gate below which a frame is "silence") · TUNER_WIN=0.45
#   (capture seconds per reading) · TUNER_GAP=1.0 (min seconds between spoken readings) ·
#   TUNER_IN_CENTS=6 ("чисто" band) · TUNER_NEAR_CENTS=22 ("чуть выше/ниже" band).
#   Autoarm gate: TUNER_FRAME=0.18 (cheap sample frame seconds) · TUNER_ARM_HOLD=0.4 (seconds a
#   stable f0 must be held to ARM) · TUNER_ARM_CENTS=40 (max f0 spread within the hold to count as
#   "the same sustained note" — tighter than a semitone, so speech glides/transients never arm).
#   Piper: OH_PIPER / OH_PIPERLIB / OH_VOICE (default the ruslan voice, same as mesh-overhear).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire mic + Bose sink
MESH="${MESH_DIR:-$HOME/.mesh}"
export OH_PIPER="${OH_PIPER:-$MESH/piper/piper/piper}"
export OH_PIPERLIB="${OH_PIPERLIB:-$MESH/piper/piper}"
export OH_VOICE="${OH_VOICE:-$MESH/piper/voices/ruslan.onnx}"
export TUNER_VOICE_DIR="${TUNER_VOICE_DIR:-$MESH/tuner-voice}"
export MUTE_FLAG="${MUTE_FLAG:-$MESH/mesh-speaking}"
export TUNER_RMS="${TUNER_RMS:-350}"
export TUNER_WIN="${TUNER_WIN:-0.40}"   # live-tested on ds: snappy yet still nails cello C2≈65Hz
export TUNER_GAP="${TUNER_GAP:-0.5}"    # call the note the instant a stable pitch lands (was 1.0)
export TUNER_IN_CENTS="${TUNER_IN_CENTS:-6}"
export TUNER_NEAR_CENTS="${TUNER_NEAR_CENTS:-22}"
export TUNER_FRAME="${TUNER_FRAME:-0.18}"
export TUNER_ARM_HOLD="${TUNER_ARM_HOLD:-0.4}"
export TUNER_ARM_CENTS="${TUNER_ARM_CENTS:-40}"

PY="$(mktemp /tmp/tuner-XXXXXX.py)"; trap 'rm -f "$PY"' EXIT
cat > "$PY" <<'PYEOF'
import os, sys, time, math, subprocess, signal
import numpy as np

# SIGTERM-clean: the camera trigger (mesh-tuner-eye) START/STOPs --loop via the process group, so a
# stop must exit promptly AND never leave the MUTE flag set (which would deafen mesh-overhear forever).
_TERM = {"hit": False}
def _on_term(sig, frm):
    _TERM["hit"] = True
    raise KeyboardInterrupt          # unwinds the blocking capture read → finally clears MUTE
signal.signal(signal.SIGTERM, _on_term)

RATE       = 16000
WIN        = float(os.environ.get("TUNER_WIN","0.40"))
RMS_GATE   = float(os.environ.get("TUNER_RMS","350"))
GAP        = float(os.environ.get("TUNER_GAP","0.5"))
IN_CENTS   = float(os.environ.get("TUNER_IN_CENTS","6"))
NEAR_CENTS = float(os.environ.get("TUNER_NEAR_CENTS","22"))
FRAME      = float(os.environ.get("TUNER_FRAME","0.18"))      # cheap sample frame for the autoarm loop
ARM_HOLD   = float(os.environ.get("TUNER_ARM_HOLD","0.4"))    # a stable f0 must be held this long to ARM
ARM_CENTS  = float(os.environ.get("TUNER_ARM_CENTS","40"))    # max f0 spread inside the hold (sub-semitone)
FMIN, FMAX = 60.0, 1200.0          # cello C2≈65, guitar E2≈82 … up past violin/guitar top range
PIPER   = os.environ["OH_PIPER"]; PIPERLIB = os.environ["OH_PIPERLIB"]; VOICE = os.environ["OH_VOICE"]
VOICEDIR= os.environ["TUNER_VOICE_DIR"]; MUTE = os.environ["MUTE_FLAG"]

# Operator 2026-06-20: "говорить A B C D E F G как in English". index = MIDI note number mod 12.
# NAMES  = what we PRINT (real English letter names). SPOKEN = piper-phonetic Russian spelling so the
# ruslan voice (the only one on default-string) SOUNDS the English letter (C→"си", D→"ди", … B→"би").
NAMES  = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]
SPOKEN = ["си","си-диез","ди","ди-диез","и","эф","эф-диез","джи","джи-диез","эй","эй-диез","би"]

# ---------- audio capture (raw s16 mono PCM from the mic, same stream mesh-overhear uses) ----------
def capture(dur=WIN):
    n = int(dur*RATE); need = n*2
    p = subprocess.Popen(["pw-record","--rate","16000","--channels","1","--format","s16","-"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buf = b""
    try:
        while len(buf) < need:
            chunk = p.stdout.read(need-len(buf))
            if not chunk: break
            buf += chunk
    finally:
        try: p.terminate(); p.wait(timeout=1)
        except Exception:
            try: p.kill()
            except Exception: pass
    if len(buf) < need//2: return None
    return np.frombuffer(buf[:len(buf)-(len(buf)%2)], dtype="<i2").astype(np.float64)

# ---------- persistent capture stream (autoarm) — one long-lived pw-record, read FRAME chunks from it.
# Cheaper than re-spawning per frame, and pipewire lets us capture the SAME mic concurrently with the
# always-on mesh-overhear stream (we never touch its process). ----------
def open_stream():
    return subprocess.Popen(["pw-record","--rate","16000","--channels","1","--format","s16","-"],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

def read_frame(p, dur=FRAME):
    need = int(dur*RATE)*2
    buf = b""
    while len(buf) < need:
        chunk = p.stdout.read(need-len(buf))
        if not chunk: return None            # stream died → caller reopens
        buf += chunk
    return np.frombuffer(buf, dtype="<i2").astype(np.float64)

# ---------- YIN pitch detection: returns (freq, midi_float) or None ----------
def detect_pitch(x):
    if x is None or len(x) < 2048: return None
    rms = float(np.sqrt(np.mean(x*x)))
    if rms < RMS_GATE: return ("quiet", rms)
    x = x - np.mean(x)
    N = len(x)
    tau_max = min(int(RATE/FMIN), N//2)
    tau_min = max(2, int(RATE/FMAX))
    # difference function d(tau) = sum (x[j]-x[j+tau])^2
    d = np.zeros(tau_max+1)
    for tau in range(1, tau_max+1):
        diff = x[:N-tau] - x[tau:N]
        d[tau] = float(np.dot(diff, diff))
    # cumulative mean normalised difference (CMND)
    cmnd = np.ones(tau_max+1); running = 0.0
    for tau in range(1, tau_max+1):
        running += d[tau]
        cmnd[tau] = d[tau]*tau/running if running > 0 else 1.0
    # first dip below the absolute threshold, walked to its local minimum
    thr = 0.12; tau = -1; t = tau_min
    while t <= tau_max:
        if cmnd[t] < thr:
            while t+1 <= tau_max and cmnd[t+1] < cmnd[t]: t += 1
            tau = t; break
        t += 1
    if tau == -1:
        seg = cmnd[tau_min:tau_max+1]
        tau = tau_min + int(np.argmin(seg))
        if cmnd[tau] > 0.55: return ("noisy", rms)      # no confident periodicity
    # parabolic interpolation around the dip for sub-sample period
    if 1 <= tau < tau_max:
        a,b,c = cmnd[tau-1], cmnd[tau], cmnd[tau+1]
        denom = a + c - 2*b
        shift = 0.5*(a-c)/denom if denom != 0 else 0.0
    else:
        shift = 0.0
    period = tau + shift
    if period <= 0: return ("noisy", rms)
    freq = RATE/period
    if freq < FMIN or freq > FMAX: return ("noisy", rms)
    midi = 69 + 12*math.log2(freq/440.0)
    return ("note", rms, freq, midi)

def note_of(midi):
    nearest = int(round(midi))
    cents   = (midi - nearest)*100.0
    return NAMES[nearest % 12], cents, nearest

# ---------- voice: pre-rendered phrase cache, played on the Bose ----------
def bose_id():
    try:
        out = subprocess.run(["wpctl","status"],capture_output=True,timeout=5).stdout.decode("utf-8","ignore")
        in_sinks = False
        import re
        for ln in out.splitlines():
            if "Sinks:" in ln: in_sinks=True; continue
            if "Sources:" in ln or "endpoints" in ln: in_sinks=False
            if in_sinks and ("bose" in ln.lower() or "soundlink" in ln.lower()):
                m=re.search(r'(\d+)\.', ln)
                if m: return m.group(1)
    except Exception: pass
    return None

def pwplay(wav):
    bid = bose_id()
    if bid:
        try: subprocess.run(["wpctl","set-default",bid],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
        except Exception: pass
        subprocess.run(["pw-play","--target",bid,wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["pw-play",wav],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)

def piper_render(text, outwav):
    subprocess.run([PIPER,"-m",VOICE,"-f",outwav],input=text.encode(),
        env=dict(os.environ,LD_LIBRARY_PATH=PIPERLIB),
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    return os.path.exists(outwav) and os.path.getsize(outwav) > 0

PHRASES = {**{"n%d"%i: SPOKEN[i] for i in range(12)},
           "in":"чисто", "up":"выше", "down":"ниже", "up_a":"чуть выше", "down_a":"чуть ниже"}

def render_cache(force=False):
    os.makedirs(VOICEDIR, exist_ok=True); ok=0; total=0
    for key,text in PHRASES.items():
        total += 1
        path=os.path.join(VOICEDIR, key+".wav")
        if force or not (os.path.exists(path) and os.path.getsize(path)>0):
            if piper_render(text, path): ok+=1
        else: ok+=1
    return ok, total

def ensure_cache():
    if not all(os.path.exists(os.path.join(VOICEDIR,k+".wav")) for k in PHRASES):
        render_cache()

def say_reading(nearest, cents):
    ensure_cache()
    parts=[os.path.join(VOICEDIR,"n%d.wav"%(nearest%12))]
    ac=abs(cents)
    if ac <= IN_CENTS:      parts.append(os.path.join(VOICEDIR,"in.wav"))
    elif cents < 0:         parts.append(os.path.join(VOICEDIR,("up_a" if ac<=NEAR_CENTS else "up")+".wav"))
    else:                   parts.append(os.path.join(VOICEDIR,("down_a" if ac<=NEAR_CENTS else "down")+".wav"))
    try: open(MUTE,"w").close()          # tell the overhear listener "that's me" — don't self-transcribe
    except Exception: pass
    for w in parts:
        if os.path.exists(w): pwplay(w)
    try:
        time.sleep(0.2); os.remove(MUTE)
    except Exception: pass

def fmt(nearest, cents):
    name=NAMES[nearest%12]; octv=nearest//12 - 1
    arrow = "чисто" if abs(cents)<=IN_CENTS else ("выше ↑" if cents<0 else "ниже ↓")
    return "%s%d  %+.0f cents  → %s" % (name, octv, cents, arrow)

# ---------- modes ----------
def mode_detect(say=False):
    r = detect_pitch(capture())
    if not r or r[0] != "note":
        print("(%s)" % (r[0] if r else "no-audio")); return 2
    _, rms, freq, midi = r
    name, cents, nearest = note_of(midi)
    print("%.1f Hz  rms=%.0f  %s" % (freq, rms, fmt(nearest, cents)))
    if say: say_reading(nearest, cents)
    return 0

def clear_mute():
    try: os.remove(MUTE)
    except Exception: pass

def mode_loop():
    print("tuner: play a note (Ctrl-C / SIGTERM to stop)", flush=True)
    last_key=None; last_t=0.0
    try:
        while True:
            r = detect_pitch(capture())
            if not r or r[0] != "note":
                last_key=None            # silence resets, so the next note always re-announces
                time.sleep(0.03); continue
            _, rms, freq, midi = r
            name, cents, nearest = note_of(midi)
            ac=abs(cents)
            if ac <= IN_CENTS:           key=(nearest,"in")
            else:                        key=(nearest, "up" if cents<0 else "down", "a" if ac<=NEAR_CENTS else "b")
            now=time.time()
            print("\r%-34s" % fmt(nearest,cents), end="", flush=True)
            if key != last_key and now-last_t >= GAP:
                say_reading(nearest, cents); last_key=key; last_t=now
            time.sleep(0.03)
    except KeyboardInterrupt:
        pass
    finally:
        clear_mute()                     # never strand the MUTE flag (would deafen mesh-overhear)
        print("\ntuner: stopped", flush=True)
    return 0

# ---------- the ARM gate: a run of consecutive 'note' frames whose f0 stays within ARM_CENTS for
# >= ARM_HOLD seconds. Speech glides (f0 jumps a semitone+ per phoneme) reset the run; transients are
# too short to reach ARM_HOLD; silence/'noisy' frames break the run. Pure function over a frame list so
# --test can assert it with synthetic audio (no mic). Returns (armed, median_midi, spread_cents). ----------
def _spread_cents(run):
    return (max(run)-min(run))*100.0 if run else 0.0

def arm_step(state, x):
    """Advance the arm state machine by one frame. state = {"run":[midi...], "secs":float}.
    Returns (armed_now, reading_midi_or_None)."""
    r = detect_pitch(x)
    if not r or r[0] != "note":
        state["run"]=[]; state["secs"]=0.0
        return (False, None)
    midi = r[3]
    run = state["run"]
    if run and _spread_cents(run+[midi]) > ARM_CENTS:
        state["run"]=[midi]; state["secs"]=FRAME     # f0 jumped off the held note → restart the run here
    else:
        run.append(midi); state["secs"] += FRAME
    if state["secs"] >= ARM_HOLD - 1e-9:
        return (True, float(np.median(state["run"])))
    return (False, None)

def arm_scan(frames):
    """Run arm_step over a list of frames; True iff the run ever ARMS. For --test only."""
    state={"run":[],"secs":0.0}
    for x in frames:
        armed,_ = arm_step(state, x)
        if armed: return True
    return False

def mode_autoarm():
    sys.stdout.write("tuner autoarm: listening for a sustained musical note "
                     "(hold>=%.2fs, gate %.0f cents)\n"%(ARM_HOLD, ARM_CENTS)); sys.stdout.flush()
    p=None; state={"run":[],"secs":0.0}; last_key=None; last_t=0.0
    try:
      while True:
        # mesh-overhear (or we) is speaking on the Bose → DRAIN, don't capture self, disarm.
        if os.path.exists(MUTE):
            state={"run":[],"secs":0.0}; last_key=None
            if p is not None:
                try: p.terminate(); p.wait(timeout=1)
                except Exception:
                    try: p.kill()
                    except Exception: pass
                p=None
            time.sleep(0.1); continue
        if p is None:
            p=open_stream(); state={"run":[],"secs":0.0}; last_key=None
        x=read_frame(p)
        if x is None:                       # stream died → reopen next loop
            try: p.kill()
            except Exception: pass
            p=None; time.sleep(0.2); continue
        armed, reading = arm_step(state, x)
        if not armed:
            if not state["run"]: last_key=None   # lost the note → next sustained note re-announces
            continue
        name, cents, nearest = note_of(reading)
        ac=abs(cents)
        if ac <= IN_CENTS: key=(nearest,"in")
        else:              key=(nearest, "up" if cents<0 else "down", "a" if ac<=NEAR_CENTS else "b")
        now=time.time()
        if key != last_key and now-last_t >= GAP:
            say_reading(nearest, cents); last_key=key; last_t=now
            # while say_reading held MUTE the stream backed up — reopen for a fresh, current read.
            try: p.kill()
            except Exception: pass
            p=None
        # keep the run alive but don't let it grow unbounded across a long held note
        if len(state["run"]) > 64: state["run"]=state["run"][-8:]
    except KeyboardInterrupt:
        pass
    finally:
        if p is not None:
            try: p.kill()
            except Exception: pass
        clear_mute()
        sys.stdout.write("tuner autoarm: stopped\n"); sys.stdout.flush()
    return 0

def mode_test():
    def synth(freq, secs=0.45, amp=6000):
        t=np.arange(int(secs*RATE))/RATE
        # fundamental + a couple of harmonics, like a real string
        return amp*(np.sin(2*math.pi*freq*t)+0.4*np.sin(4*math.pi*freq*t)+0.2*np.sin(6*math.pi*freq*t))
    cases=[("ля (A4)",440.0,9),("ля (A3)",220.0,9),("ми (E2 guitar)",82.41,4),
           ("до (C2 cello)",65.41,0),("ре (D3)",146.83,2)]
    ok=True
    for label,f,exp_idx in cases:
        r=detect_pitch(synth(f))
        if not r or r[0]!="note": print("  %-18s FAIL (%s)"%(label, r[0] if r else "none")); ok=False; continue
        name,cents,nearest=note_of(r[3])
        good = (nearest%12==exp_idx) and abs(cents)<15
        print("  %-18s → %-9s %+.1f cents  %s"%(label, NAMES[nearest%12], cents, "ok" if good else "FAIL"))
        ok = ok and good
    # a silent buffer must read as quiet, not hallucinate a note
    q=detect_pitch(np.zeros(int(0.45*RATE)))
    qok = (q is not None and q[0]=="quiet"); print("  silence            → %s  %s"%(q[0] if q else "none","ok" if qok else "FAIL"))

    # ---- the ARM gate: sustained sine ARMS; speech-shaped glide / transient / silence do NOT ----
    nfr  = int(FRAME*RATE)
    def sine(freq, n, amp=6000):
        t=np.arange(n)/RATE
        return amp*(np.sin(2*math.pi*freq*t)+0.4*np.sin(4*math.pi*freq*t)+0.2*np.sin(6*math.pi*freq*t))
    nframes = int(math.ceil((ARM_HOLD/FRAME))) + 2     # enough frames to clear the hold
    # (a) a steady note held > ARM_HOLD must ARM
    sustained = [sine(220.0, nfr) for _ in range(nframes)]
    a1 = arm_scan(sustained)
    # (b) speech-shaped: f0 glides a semitone+ every frame (like vowels) → run keeps resetting → no arm
    glide = [sine(140.0*(2**((i*1.5)/12.0)), nfr) for i in range(nframes)]
    a2 = arm_scan(glide)
    # (c) a transient: one short burst, then silence → too short to hold → no arm
    transient = [sine(220.0, nfr)] + [np.zeros(nfr) for _ in range(nframes)]
    a3 = arm_scan(transient)
    # (d) pure silence never arms
    a4 = arm_scan([np.zeros(nfr) for _ in range(nframes)])
    g1 = a1 is True;  g2 = a2 is False;  g3 = a3 is False;  g4 = a4 is False
    print("  arm: sustained     → %s  %s"%("ARM" if a1 else "no-arm","ok" if g1 else "FAIL"))
    print("  arm: speech-glide  → %s  %s"%("ARM" if a2 else "no-arm","ok" if g2 else "FAIL"))
    print("  arm: transient     → %s  %s"%("ARM" if a3 else "no-arm","ok" if g3 else "FAIL"))
    print("  arm: silence       → %s  %s"%("ARM" if a4 else "no-arm","ok" if g4 else "FAIL"))
    gate_ok = g1 and g2 and g3 and g4
    allok = ok and qok and gate_ok
    print("smoke-test: %s"%("ok (pitch math + arm gate sound)" if allok else "FAIL")); return 0 if allok else 1

mode = sys.argv[1] if len(sys.argv)>1 else "detect"
if   mode=="autoarm": sys.exit(mode_autoarm() or 0)
elif mode=="loop":    sys.exit(mode_loop() or 0)
elif mode=="once":    sys.exit(mode_detect(say=True))
elif mode=="detect":  sys.exit(mode_detect(say=False))
elif mode=="render":  ok,total=render_cache(force=True); print("rendered %d/%d phrases → %s"%(ok,total,VOICEDIR)); sys.exit(0 if ok==total else 1)
elif mode=="test":    sys.exit(mode_test())
else: print("unknown mode: %s"%mode); sys.exit(2)
PYEOF

case "${1:-}" in
  --autoarm)
    # single-flight: the systemd unit + a stray manual run must not both drive the Bose.
    exec 7>"$MESH/.tuner-autoarm.lock"
    flock -n 7 || { echo "mesh-tuner: another --autoarm holds the lock — exiting"; exit 0; }
    exec python3 "$PY" autoarm ;;
  --loop)    exec python3 "$PY" loop ;;
  --once)    python3 "$PY" once ;;
  --detect)  python3 "$PY" detect ;;
  --render)  python3 "$PY" render ;;
  --test)
    command -v python3 >/dev/null && python3 -c 'import numpy' 2>/dev/null || { echo "smoke-test: n/a (no numpy)"; exit 2; }
    python3 "$PY" test ;;
  *) sed -n '2,24p' "$0" ;;
esac
