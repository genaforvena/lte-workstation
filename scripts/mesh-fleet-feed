#!/usr/bin/env bash
# mesh-fleet-feed — cross-posted, replicated mesh-wide data feed. No aggregator, no SPOF:
# each node's REFLEX posts ONLY its own slice and ships it to every peer; every node converges
# to the same one-file-per-node picture. A node going silent = its slice goes stale = DOWN,
# for free (liveness falls out of the replication; no separate probe). Generalizes
# mesh-heartbeat (push-beacon-to-neighbour) to all-peers + full-slice, and mesh-beacon-watch
# (stale = down) to every node at once.
#
#   mesh-fleet-feed post     write THIS node's slice + ship to all peers (the reflex)
#   mesh-fleet-feed view     render the converged feed; stale slices marked DOWN
#   mesh-fleet-feed --test   smoke test (deps + dir writable)
#
# Data model: ~/.mesh/fleet/<node>.slice — single-writer (origin node only), no relay.
# Absence semantics: a slice older than STALE_SECS = that node is DOWN/unreachable from here.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
FLEET="$HOME/.mesh/fleet"; mkdir -p "$FLEET"
SELF="$(hostname)"
STALE_SECS="${MESH_FLEET_STALE:-360}"   # > the post cadence; silence beyond this = DOWN
NODES_FILE="$HOME/.mesh/nodes"
now(){ date -u +%s; }
ts_iso(){ date -u +%FT%TZ; }

# peers: "label user@ip" from MESH_NODES, skipping local
peers(){
  [ -f "$NODES_FILE" ] || return 0
  awk -F= '/^MESH_NODES(_INNER)?=/{gsub(/"/,"",$2); print $2}' "$NODES_FILE" | tr ' ' '\n' | while IFS= read -r e; do
    [ -z "$e" ] && continue
    name="${e%%:*}"; rest="${e#*:}"
    [ "$rest" = "local" ] && continue
    case "$rest" in u0_a*@*) continue;; esac   # phone bodies: no fleet daemon
    printf '%s %s\n' "$name" "$rest"
  done
}

# this node's slice: one compact, greppable block. Cheap signals only (the reflex runs often).
# Carries health + what the claude MIND is doing (sync-with-claude) — the dashboard reads both.
make_slice(){
  local dsum dev xid mind
  dsum="$(mesh-doctor --quiet 2>/dev/null | tail -1 | sed 's/^mesh-doctor: //')"
  dev="$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+')"
  xid="$(tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "-")' 2>/dev/null)"
  # mind state from the local claude window (timeout-guarded; never hang the reflex)
  mind="$(timeout 8 mesh-mind-state plan 2>/dev/null | head -1 | awk '{print $1}')"   # 2026-06-13: steward channel = 'plan'
  printf 'node=%s\nepoch=%s\nts=%s\ndoctor=%s\nmind=%s\negress_dev=%s\nexit_node=%s\n' \
    "$SELF" "$(now)" "$(ts_iso)" "${dsum:-unknown}" "${mind:-?}" "${dev:-?}" "${xid:-?}"
}

post(){
  local f="$FLEET/$SELF.slice" tmp
  tmp="$(mktemp)"; make_slice > "$tmp"; mv "$tmp" "$f"
  local shipped=0 failed=0
  while read -r name rest; do
    [ -z "$name" ] && continue
    if timeout 12 scp -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new \
         "$f" "$rest:.mesh/fleet/$SELF.slice" >/dev/null 2>&1; then
      shipped=$((shipped+1))
    else
      failed=$((failed+1))
    fi
  done < <(peers)
  echo "$(ts_iso) fleet-feed: posted $SELF slice → shipped=$shipped failed=$failed"
}

view(){
  local n=0 down=0 N
  N="$(now)"
  echo "== mesh dashboard — $(ts_iso) — cross-posted, no aggregator (silence = down) =="
  printf '%-26s %-6s %-6s %-12s %-13s %s\n' NODE AGE STATE MIND DOCTOR EGRESS
  for f in "$FLEET"/*.slice; do
    [ -e "$f" ] || { echo "(no slices yet — run 'mesh-fleet-feed post' on each node)"; return 0; }
    n=$((n+1))
    local node epoch doctor mind dev age state
    node="$(sed -n 's/^node=//p' "$f")"
    epoch="$(sed -n 's/^epoch=//p' "$f")"
    doctor="$(sed -n 's/^doctor=//p' "$f")"
    mind="$(sed -n 's/^mind=//p' "$f")"
    dev="$(sed -n 's/^egress_dev=//p' "$f")"
    age=$(( N - ${epoch:-0} ))
    if [ "$age" -gt "$STALE_SECS" ]; then state="DOWN"; down=$((down+1)); mind="-"; else state="up"; fi
    printf '%-26s %-6s %-6s %-12s %-13s %s\n' "${node:-?}" "${age}s" "$state" "${mind:-?}" "${doctor:-?}" "${dev:-?}"
  done
  echo "— $n node(s), $down DOWN (stale > ${STALE_SECS}s = silent). chat: mesh-wide sync = next slice."
}

case "${1:-}" in
  --test)
    command -v scp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no scp)"; exit 1; }
    command -v mesh-doctor >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-doctor for slice)"; exit 1; }
    [ -w "$FLEET" ] || { echo "smoke-test: FAIL ($FLEET not writable)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;
  post) post ;;
  view|"") view ;;
  *) echo "usage: mesh-fleet-feed post|view|--test" >&2; exit 1 ;;
esac
