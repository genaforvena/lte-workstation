#!/usr/bin/env bash
# orphan-ok: on-demand cross-sense fusion (operator review pending — built 2026-06-24, NOT yet wired/committed).
# mesh-desk-presence — PHONE-FREE workstation occupancy: is someone ACTIVELY at THIS node's desk?
#
# WHY: mesh-operator-state derives AT-DESK/AWAY but leans on phone axes (body-motion/lux/accel) + mic +
# BLE; when the Redmi flaps offline (constant) those collapse and it falls back to mic+LAN+BLE — a
# coarse "in the area" signal, not "at the keyboard". This fuses four IdeaPad-LOCAL, phone-INDEPENDENT
# senses that together answer a question no one of them can: is a person actively working here NOW?
#   keyboard   (mesh-keypresence)     ACTIVE = physical keypress just now → definitive presence
#   cam motion (mesh-activity-tempo)  MOTION = movement in the webcam's view → physical presence
#   FOV light  (mesh-cam-light)       brightness of the webcam frame → corroborating (lit vs dark)
#   seat       (mesh-seat-presence)   logind seat0 IdleHint → covers mouse/touchpad/touch/GUI input the
#                                     keyboard-IRQ + camera BOTH miss, AND a real NO-LOCAL-PRESENCE.
# WHY the seat axis (added 2026-06-27): keyboard-IRQ + cam-motion are blind to a person reading and
# SCROLLING WITH THE MOUSE (quiet kbd, near-still cam) — logind sees that input and reads ACTIVE. And
# when the lens is privacy-capped/covered (this node's standing state) so cam→UNKNOWN AND the kbd is
# quiet, the OLD 3-axis fusion collapsed to UNCERTAIN; logind still reports the local-console state, so
# the seat axis RESCUES that all-blind case: seat ACTIVE → ACTIVE-AT-DESK (definitive, phone- AND camera-
# free); seat NO-LOCAL-PRESENCE → LIKELY-AWAY (a positive "nobody at the console", assertable THROUGH a
# blind lens where the camera alone never could); seat IDLE/INACTIVE → a coarse present-idle / away.
# Complements (does NOT duplicate) mesh-operator-state: that = operator attention via phone/BLE/mic;
# this = bodily presence at the workstation via keyboard+camera+seat, and it KEEPS WORKING phone-down.
#
# HONEST-FUSION (no silent all-clear): every axis prints its own value incl. UNREACHABLE/UNKNOWN, and
# the verdict NEVER concludes LIKELY-AWAY from a dark/still camera when the keyboard axis is unreachable
# AND the camera axis is unreachable — an unreadable sensorium renders UNCERTAIN, never a faked "away".
# A shadowed/angled lens reads DARK in a lit room, so DARK FOV only ever DOWNWEIGHTS, never asserts away.
#
#   mesh-desk-presence          fuse + print verdict
#   mesh-desk-presence --test   smoke test (synthetic axis combos — no camera/keyboard)
#
# States: ACTIVE-AT-DESK · PRESENT-IDLE · LIKELY-AWAY · UNCERTAIN
# Exit: 0 = real read · 2 = cannot assess (every input unreachable) — never faked.
# smoke-test: --test exercises the fuse() truth table incl. the unreachable-renders-UNCERTAIN guard.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# --- camera SIGHT (not just freshness): a flat/covered lens is BLIND, not a live dark room ---
# cam-light validates frame FRESHNESS, not that the lens can SEE. A privacy-capped/covered lens still
# yields a fresh frame, but a near-constant FLAT field (luma stddev≈0) carries no scene — mesh-cam-light
# reads it DARK and mesh-activity-tempo reads it STILL, so a blinded lens masquerades as a live "dark +
# still" reading and (pre-fix) drove a FALSE LIKELY-AWAY. A genuinely dark room still has sensor-noise
# variance (stddev ≳ 2–10); stddev < FLAT means covered/blank. (liveness = signal CONTENT, not mtime.)
CAM_FRAME="${CAM_LIGHT_FRAME:-$HOME/.mesh/cam-prev.jpg}"
CAM_BLIND_TTL="${MESH_CAM_BLIND_TTL:-30}"        # only judge sight on a FRESH frame (cam-watch refreshes ~1.5s)
CAM_FLAT_STDDEV="${MESH_CAM_FLAT_STDDEV:-3}"      # shared threshold w/ mesh-room-sense _cam_flat
# _cam_blind <frame> → prints 1 (flat/covered → blind), 0 (scene variance present), "" (cannot tell:
# no frame / stale / no PIL). Stale or unreadable → "" so cam-light's own UNKNOWN handling governs.
_cam_blind() {
  local f="$1" now mt age
  [ -f "$f" ] || return 0
  now="$(date +%s)"; mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"; age=$(( now - mt ))
  { [ "$age" -ge 0 ] && [ "$age" -le "$CAM_BLIND_TTL" ]; } || return 0
  MCB_FLAT="$CAM_FLAT_STDDEV" python3 - "$f" <<'PY' 2>/dev/null
import sys, os
try:
    from PIL import Image, ImageStat
    sd = ImageStat.Stat(Image.open(sys.argv[1]).convert("L")).stddev[0]
    print(1 if sd < float(os.environ["MCB_FLAT"]) else 0)
except Exception:
    pass
PY
}

# fuse <kbd> <cam_motion> <fov> [blind] [seat] → "<VERDICT>|<reason>" on stdout. Pure (no I/O) so --test can drive it.
#   kbd:        ACTIVE | QUIET | UNREACHABLE
#   cam_motion: MOTION | STILL | UNKNOWN
#   fov:        DARK|DIM|TWILIGHT|MODERATE|LIT|BRIGHT | UNKNOWN
#               (TWILIGHT is the webcam-coarse mid-luma band, 80-109 mean; it groups with the LIT
#               side per mesh-room-sense:832. Before 2026-08-18 it matched neither case below, so a
#               live mid-luma FOV silently skipped both the PRESENT-IDLE and the LIKELY-AWAY reads.)
#   blind:      OK | CAM-BLIND | UNKNOWN   (CAM-BLIND = flat/covered lens → its motion+FOV are NOT
#               trustworthy, so they are neutralized to UNKNOWN here: a covered lens can never assert away.)
#   seat:       ACTIVE | IDLE | INACTIVE | NOSEAT | UNKNOWN  (logind seat0; UNKNOWN = logind unreadable.
#               Default UNKNOWN keeps every legacy 3/4-arg call byte-identical.)
fuse() {
  local kbd="$1" mot="$2" fov="$3" blind="${4:-OK}" seat="${5:-UNKNOWN}" bnote=""
  if [ "$blind" = CAM-BLIND ]; then mot=UNKNOWN; fov=UNKNOWN; bnote=" — camera BLIND (lens flat/covered, sight unreadable)"; fi
  # how many axes can we actually read? (honest coverage)
  local cam_ok=1; [ "$mot" = UNKNOWN ] && [ "$fov" = UNKNOWN ] && cam_ok=0
  local kbd_ok=1; [ "$kbd" = UNREACHABLE ] && kbd_ok=0
  local seat_ok=1; [ "$seat" = UNKNOWN ] && seat_ok=0

  # 1) Positive presence — a single strong active signal is definitive (and phone-free). Keypress wins even
  #    through a blinded lens (a person typing in front of a covered camera is still ACTIVE-AT-DESK). The
  #    logind seat axis is the SAME class of proof: ACTIVE = real local-console input (mouse/touch/GUI)
  #    NOW — it catches a scrolling/reading body the keyboard-IRQ + camera both miss, even camera-blind.
  if [ "$kbd" = ACTIVE ]; then echo "ACTIVE-AT-DESK|keypress just now (definitive)$bnote"; return 0; fi
  if [ "$seat" = ACTIVE ]; then echo "ACTIVE-AT-DESK|local console input now — mouse/touch/keyboard/GUI (logind seat)$bnote"; return 0; fi
  if [ "$mot" = MOTION ]; then echo "ACTIVE-AT-DESK|movement in webcam view"; return 0; fi

  # 2) logind can POSITIVELY confirm console-absence even when the camera is blind/unknown: NO-LOCAL-
  #    PRESENCE is a real assessment ("nobody is logged in at the physical console"), not missing data, so
  #    it asserts away THROUGH a blind lens where the camera alone never could. Still "likely" — a person
  #    can be in the room yet not at this desk. (Reached only after the positive signals above fail.)
  if [ "$seat" = NOSEAT ]; then echo "LIKELY-AWAY|logind: no local-seat session — nobody at this node's console$bnote"; return 0; fi

  # 3) Cannot assess — blind ONLY if keyboard AND camera AND seat are all unreadable. Never guess away.
  if [ "$kbd_ok" = 0 ] && [ "$cam_ok" = 0 ] && [ "$seat_ok" = 0 ]; then
    echo "UNCERTAIN|sensorium unreadable — keyboard UNREACHABLE + camera UNKNOWN + seat UNKNOWN (NOT 'away')$bnote"; return 2
  fi

  # 4) Bright FOV + still + quiet → someone is plausibly here but idle (reading); FOV is corroborating only.
  case "$fov" in
    LIT|BRIGHT|MODERATE|TWILIGHT)
      echo "PRESENT-IDLE|workstation lit, no input/motion — present but idle, or just-left (weak)"; return 0 ;;
  esac

  # 5) LIKELY-AWAY only when the CAMERA is provably LIVE and dark-and-still. A readable DARK/DIM FOV is the
  #    honest guard — but freshness ≠ sight, so a BLIND lens is neutralized above (fov→UNKNOWN) and can never
  #    reach here. Require mot=STILL too (a genuine no-motion read). If fov is UNKNOWN the camera is DOWN →
  #    STILL is not trustworthy and a quiet keyboard alone can't claim away → UNCERTAIN, never a silent
  #    'away'. Lens may be shadowed in a lit room, so it's "likely", not certain.
  case "$fov" in
    DARK|DIM)
      [ "$mot" = STILL ] && { echo "LIKELY-AWAY|camera live + dark FOV + still + quiet keyboard (likely, not certain — lens may be shadowed)"; return 0; } ;;
  esac

  # 6) Camera unreadable / inconclusive but the SEAT axis still carries a coarse local-console verdict —
  #    the phone-free, camera-free rescue (this node's covered-lens norm): logind's idle/inactive hint.
  case "$seat" in
    IDLE)     echo "PRESENT-IDLE|logind: local console logged in but idle — present-idle or just-left (weak; camera unreadable)$bnote"; return 0 ;;
    INACTIVE) echo "LIKELY-AWAY|logind: local seat inactive (switched-away / locked) + quiet keyboard (likely; camera unreadable)$bnote"; return 0 ;;
  esac

  echo "UNCERTAIN|insufficient readable axes (kbd=$kbd cam_motion=$mot fov=$fov seat=$seat)$bnote"; return 2
}

if [ "${1:-}" = --test ]; then
  e=0; chk(){ local got="${1%%|*}"; [ "$got" = "$2" ] || { echo "  FAIL: [$3] expected $2 got $got"; e=1; }; }
  chk "$(fuse ACTIVE STILL DARK)"      ACTIVE-AT-DESK "typing wins over dark/still"
  chk "$(fuse QUIET MOTION DARK)"      ACTIVE-AT-DESK "cam motion = present even if dark"
  chk "$(fuse QUIET STILL LIT)"        PRESENT-IDLE   "lit + still + quiet = idle-present"
  chk "$(fuse QUIET STILL DARK)"       LIKELY-AWAY    "dark + still + quiet = likely away"
  chk "$(fuse QUIET STILL UNKNOWN)"    UNCERTAIN      "quiet kbd but camera UNKNOWN → cannot claim away"
  chk "$(fuse UNREACHABLE STILL LIT)"  PRESENT-IDLE   "camera carries it when kbd unreachable"
  chk "$(fuse UNREACHABLE UNKNOWN UNKNOWN)" UNCERTAIN  "all-unreachable → UNCERTAIN, never away (no silent all-clear)"
  # blind-lens guard: a flat/covered lens (CAM-BLIND) must NOT assert away — its DARK/STILL is not sight.
  chk "$(fuse QUIET STILL DARK CAM-BLIND)"  UNCERTAIN      "covered lens (flat) can NOT claim away — blind ≠ dark-empty room"
  chk "$(fuse ACTIVE STILL DARK CAM-BLIND)" ACTIVE-AT-DESK "keypress wins even through a blinded lens"
  chk "$(fuse QUIET STILL LIT  CAM-BLIND)"  UNCERTAIN      "blind lens cannot claim lit/idle-present"
  # seat axis (logind): adds mouse/touch/GUI coverage + a positive console-absence read.
  chk "$(fuse QUIET STILL DARK OK ACTIVE)"            ACTIVE-AT-DESK "seat input (mouse/GUI) wins over dark/still/quiet kbd"
  chk "$(fuse QUIET STILL DARK CAM-BLIND ACTIVE)"     ACTIVE-AT-DESK "seat input is definitive even through a blinded lens"
  chk "$(fuse UNREACHABLE UNKNOWN UNKNOWN OK ACTIVE)" ACTIVE-AT-DESK "seat rescues the all-camera-blind + kbd-unreachable case"
  chk "$(fuse QUIET STILL DARK CAM-BLIND NOSEAT)"     LIKELY-AWAY    "logind NO-LOCAL-PRESENCE asserts away THROUGH a blind lens"
  chk "$(fuse UNREACHABLE UNKNOWN UNKNOWN OK IDLE)"   PRESENT-IDLE   "seat IDLE carries a coarse present-idle when camera+kbd dark"
  chk "$(fuse UNREACHABLE UNKNOWN UNKNOWN OK INACTIVE)" LIKELY-AWAY  "seat INACTIVE (locked/switched-away) + quiet kbd → likely away"
  chk "$(fuse UNREACHABLE UNKNOWN UNKNOWN OK UNKNOWN)" UNCERTAIN     "seat UNKNOWN does NOT rescue — all three unreadable stays UNCERTAIN"
  # exit-code contract: UNCERTAIN-on-blind must be exit 2 (degraded), positive states exit 0
  fuse UNREACHABLE UNKNOWN UNKNOWN >/dev/null; [ "$?" = 2 ] || { echo "  FAIL: blind should exit 2"; e=1; }
  fuse QUIET STILL DARK CAM-BLIND >/dev/null; [ "$?" = 2 ] || { echo "  FAIL: blind+quiet should exit 2 (not away)"; e=1; }
  fuse ACTIVE STILL DARK >/dev/null; [ "$?" = 0 ] || { echo "  FAIL: active should exit 0"; e=1; }
  fuse QUIET STILL DARK CAM-BLIND NOSEAT >/dev/null; [ "$?" = 0 ] || { echo "  FAIL: seat-NOSEAT away is an assessment → exit 0"; e=1; }
  fuse UNREACHABLE UNKNOWN UNKNOWN OK UNKNOWN >/dev/null; [ "$?" = 2 ] || { echo "  FAIL: all-three-unreadable should exit 2"; e=1; }
  # VOCABULARY COVERAGE — every band mesh-light can EMIT must reach a VERDICT through the FOV cases,
  # never fall through both of them into UNCERTAIN. Founding case 2026-08-18: mesh-light emits SIX
  # bands over TWO scales (lux DARK|DIM|MODERATE|LIT|BRIGHT, webcam-coarse DARK|DIM|TWILIGHT|LIT);
  # TWILIGHT landed 2026-07-02 (8c96cb6) and matched NEITHER the LIT|BRIGHT|MODERATE case nor the
  # DARK|DIM one for 47 days, so a live mid-luma FOV was silently skipped — a readable camera
  # answering "insufficient readable axes". The vocabulary is re-derived from mesh-light's SOURCE
  # every run, so a hardcoded list cannot rot on the next band the way this one did.
  _ml="$(command -v mesh-light 2>/dev/null)"
  if [ -n "$_ml" ]; then
    _bands="$({ grep -oE 'lvl = "[A-Z]+"' "$_ml" | grep -oE '[A-Z]{3,}'
                grep -oE 'echo [A-Z]{3,9};'  "$_ml" | grep -oE '[A-Z]{3,}'; } | sort -u)"
    # A loop over an empty list asserts nothing: fail LOUD if the extraction stops matching.
    _nb="$(printf '%s\n' "$_bands" | grep -c .)"
    [ "$_nb" -ge 5 ] || { echo "  FAIL vocab-coverage: band extraction from $_ml found only $_nb level(s) — the emit sites moved, so this gate is vacuous; re-derive it"; e=1; }
    for _b in $_bands; do
      _bg="$(fuse QUIET STILL "$_b")"; _bg="${_bg%%|*}"
      [ "$_bg" != UNCERTAIN ] || { echo "  FAIL vocab-coverage: mesh-light emits the band $_b but a live FOV=$_b + still + quiet reaches no verdict ($_bg) — it matched neither FOV case"; e=1; }
    done
    # ...and an unreadable FOV must STILL be UNCERTAIN, so the gate above cannot be satisfied by
    # making every fov reach a verdict (a blind lens must never claim present or away).
    _ug="$(fuse QUIET STILL UNKNOWN)"; [ "${_ug%%|*}" = UNCERTAIN ] || { echo "  FAIL vocab-coverage: fov=UNKNOWN must stay UNCERTAIN (got ${_ug%%|*})"; e=1; }
  fi
  [ "$e" = 0 ] && echo "smoke-test: ok (17 truth-table + 5 exit-code + 7 vocab-coverage assertions, incl. logind seat axis)" || echo "smoke-test: FAIL"
  exit "$e"
fi

# --- read the four phone-free axes; each self-degrades to UNREACHABLE/UNKNOWN, never a fabricated value ---
ts="$(date -u +%FT%TZ)"; host="$(hostname)"

kbd="UNREACHABLE"
ko="$(timeout 12 mesh-keypresence 2>&1)" || true
case "$ko" in *ACTIVE*) kbd=ACTIVE ;; *QUIET*) kbd=QUIET ;; *) kbd=UNREACHABLE ;; esac

mot="UNKNOWN"
mo="$(timeout 18 mesh-activity-tempo 2>&1)" || true
case "$mo" in *cam=MOTION*) mot=MOTION ;; *cam=STILL*) mot=STILL ;; *) mot=UNKNOWN ;; esac

fov="UNKNOWN"
fo="$(timeout 14 mesh-cam-light 2>&1)" || true
for lvl in BRIGHT LIT MODERATE DIM DARK; do
  case "$fo" in *"] $lvl"*) fov="$lvl"; break ;; esac
done

blind="UNKNOWN"
case "$(_cam_blind "$CAM_FRAME")" in 1) blind=CAM-BLIND ;; 0) blind=OK ;; esac

# seat axis (logind seat0 IdleHint) — covers mouse/touch/GUI input the kbd-IRQ + camera miss, and a real
# console-absence. UNKNOWN if loginctl/logind is unreachable (honest — never a fabricated presence).
seat="UNKNOWN"
so="$(timeout 8 mesh-seat-presence 2>&1)" || true
case "$so" in
  *ACTIVE-AT-CONSOLE*)  seat=ACTIVE ;;
  *IDLE-AT-CONSOLE*)    seat=IDLE ;;
  *CONSOLE-INACTIVE*)   seat=INACTIVE ;;
  *NO-LOCAL-PRESENCE*)  seat=NOSEAT ;;
  *)                    seat=UNKNOWN ;;
esac

out="$(fuse "$kbd" "$mot" "$fov" "$blind" "$seat")"; ec=$?
verdict="${out%%|*}"; reason="${out#*|}"
echo "[desk-presence] $verdict — $reason [kbd=$kbd cam_motion=$mot fov=$fov cam=$blind seat=$seat] @ $host $ts"
exit "$ec"
