#!/usr/bin/env bash
# mesh-test-forgery — catch a `--test` that FORGES its own liveness record: the dry-run writes the
# durable log a human or a watchdog reads to answer "did this organ ever fire". Named shape
# (mesh-guardian, 09f7914; mesh-gpu-lid, 180e578 — where 100% of ~/.mesh/gpu-lid.log's 26 lines were
# written by --test, because mesh-doctor runs every --test hourly, i.e. the checker MINTS the
# evidence it checks).
#
#   mesh-test-forgery [--tool <name>]     sweep one tool (default: every mesh-* that declares --test)
#   mesh-test-forgery --sweep             the scheduled full pass (== bare invocation, cron form)
#   mesh-test-forgery --json              machine-readable verdicts
#   mesh-test-forgery --coverage          per-subject swept|na over the CURRENT lap, + its union/wrap
#   mesh-test-forgery --test              smoke test (hermetic scratch HOME; red AND green fixtures)
#
# EXIT: 0 clean · 1 forgeries found · 3 another sweep already running (skipped) · 4 truncated at the
# wall-clock bound (a PARTIAL pass — never read it as a clean one; the summary carries swept=n/N).
#
# UNION COVERAGE (chat-review {#b09b58cb}, 2026-08-30). swept=n/N in every summary is a POSITION
# within THIS pass, reset to 1 on every fire; a full pass runs ~35h against the 24h cadence, so
# EVERY pass truncates and a reader who takes swept=n/N for "how much of the corpus has been
# checked" is reading the wrong fraction on every single fire. union=D/T is the real answer: D
# distinct tools swept across as many fires as it took, since the count last reached the full
# corpus (a "lap"). wrap= says whether a lap has EVER closed — `wrap=Ns-ago(<ts>)` once one has,
# `wrap=never(open Ns, since <ts>)` while the first lap is still open (the common case here). A
# subject never swept this lap is `na` under --coverage, never silently folded into "clean" — the
# honest-absence rule this whole tool exists to apply to `--test` extends to its own coverage.
#
# WHY THE STATIC SCAN IS NOT ENOUGH (health@, board 2026-08-15T07:41Z): grepping for `>> $LOG` inside
# the `--test` arm misses every INDIRECT writer — gpu-lid's forgery went through do_off → log_event,
# a function defined far above the arm. Only running the test and watching the logs sees it. That is
# this tool: ATTRIBUTION by measurement, not by reading source.
#
# THE TWO TRAPS, both built in (both were hit while specifying this):
#
#  1. CRON NOISE MAKES A SINGLE PASS UNATTRIBUTABLE. On this node ~150 logs move on their own every
#     ten minutes. A one-pass size diff therefore attributes nothing and is NEVER reported as a
#     finding. Every candidate must survive two independent legs: it must grow AGAIN on a second run
#     of the same tool (confirm), and it must NOT grow in a CONTROL window of the same length with
#     the tool not running. A log that grows in the control too is reported `unattributable`, which
#     is an honest n/a — never folded into the finding count. (`na-must-be-a-claim-about-the-node`.)
#
#  2. THE DETECTOR MUST NOT BE THE THING IT DETECTS. This tool writes ~/.mesh/forgery-sweep.log; its
#     own `--test` diverts that to a scratch file and then ASSERTS the production log's size is
#     unchanged (the `_reallog_untouched` guard mesh-gpu-lid earned). A forgery detector that forges
#     its own liveness record would be the joke writing itself.
#
# WHAT COUNTS AS THE DEFECT — narrower than "a test wrote a file". A test may freely write a log it
# OWNS as a fixture; the fault is writing the DURABLE record. So a candidate whose basename reads as
# a dedicated dry-run sink (*test*/*dry*/*sandbox*/*fixture*) is EXEMPT by name, and the exemption is
# reported (`exempt` rows) rather than silently dropped — an exemption you cannot see is a blind spot.
#
# THE TWO BOARD EDGES (2026-08-28, {#5fc2aeae}). A digest and a route, and they are different jobs.
# The DIGEST is one [fyi] per sweep, its candidate list CAPPED, the overflow collapsed to a count
# plus the tape path — an 83-pair paragraph is not more information, it is the board's largest noise
# source and the tape holds all of them anyway. The ROUTE is one [task] per offending TOOL carrying
# that tool's own `owner: <tool>/genome`, because dispatch routes on the owner clause and this tool
# had none: 92/69/83 fresh candidates on three consecutive days went out as three unroutable
# paragraphs and 244 findings reached nobody. Tasks are filed on a per-sweep BUDGET and what does
# not fit is PARKED in $TASK_QUEUE, never dropped — a budget that silently withholds is the same
# disappearance wearing a cap. A detector with no route is a detector with no hand.
#
# SEEN RED, twice, and that is the point (`a-gate-you-have-not-seen-fail-is-not-a-gate`):
#   · in --test, against hermetic fixtures — a forger, an honest tool, and a NOISY log (a background
#     writer appending through both passes) that must come back unattributable, not as a finding;
#   · against the real instance — `git revert 180e578` in a scratch copy of mesh-gpu-lid, run under a
#     scratch HOME so the mutant cannot forge the REAL gpu-lid.log, and the sweep names
#     mesh-gpu-lid → gpu-lid.log. Reproducer in the board [done] for test-writes-production-log-detector.
#
# THE THIRD LEG: ATTRIBUTION, not inference (mesh-fswriter, f38f454). The two legs above are both
# INFERENCE FROM SIZE — they ask "did it grow while the tool ran, and not while it didn't". fanotify
# answers the question directly: WHICH pid, in WHICH session, wrote that path. So the CONFIRM run is
# now made with `mesh-fswriter` armed on the candidate and the `--test` placed in a FRESH SESSION
# (`setsid`); a row carrying that session id is the defect NAMED, not inferred.
#
# ATTRIBUTION IS BY SESSION, NOT BY CMDLINE, AND THAT IS NOT A STYLE CHOICE — the first version of
# this leg matched the writer's argv for the tool name + `--test`, and it attributed NOTHING. The
# writer here is by construction a process that appends one line and exits immediately, so by the
# time the event is dequeued the kernel has already zeroed its argv: the only row is
# `comm=bash cmd="<exiting>"` (reproduced in the fixture below before the gate went green). The
# session id survives that teardown and is INHERITED, so it also catches the write done by a CHILD
# of the run — a `touch`/`date >>` whose own argv never mentions the tool, which is precisely the
# shape of the first live find this probe produced. Three things it buys, in order of worth:
#
#  * IT RECOVERS FINDINGS TRAP 1 THROWS AWAY. `unattributable` is the honest verdict when a log moves
#    in the control window too — but a busy log (chat.log, traces.log) is unattributable FOREVER by
#    that rule, so a forger writing one is permanently invisible. A named writer settles it in one
#    window: cron noise does not run in the session this sweep just created.
#  * IT NAMES THE WRITER IN THE REPORT — pid, comm, and the argv where the writer lived long enough
#    to still have one, so the fix goes to a line instead of to a grep of the whole tool.
#  * IT SEES A WRITE THAT IS NOT A GROWTH (rewrite-in-place), which a size diff cannot see at all.
#
# It NEVER downgrades. A writer outside our session is not proof of innocence — the write may have
# landed a hair outside the listener's window, or the identity read may have lost its race with the
# writer's exit (`unnamed`, retried a bounded number of times and then reported as itself) — so any
# non-`self:` attribution leaves the size verdict exactly as it was. Only the promotion is acted
# on, because only the promotion rests on direct evidence. And if fanotify cannot be armed (no
# `sudo -n`, no `setsid --wait`), the writer field reads `na` and the tool is precisely the tool it
# was yesterday: an absent attribution is REPORTED, never a silent fallback to the weaker legs
# pretending to be the stronger one.
#
# ITS SINK IS A DOTFILE ON PURPOSE. Attribution rows go to $MESH/.forgery-attrib.log, and snapshot()
# globs `*.log`, which in bash does not match a leading dot. A visible sink would grow on every
# candidate and the detector would name ITSELF as the forger of every tool it sweeps. Gated below.
#
# COST: 2 `--test` runs per tool that produced a candidate, 1 for every other tool, plus one control
# sleep per candidate and one armed listener (a `sudo -n` re-exec) per candidate. Candidates are
# rare, so a full pass is ~one doctor-equivalent sweep. DAILY, not hourly: the thing it looks for is
# a code property, and it changes at commit rate.
#
# reflex-cadence: 41 4 * * *
# reflex-args: --sweep
#
# max-runtime: 72000
# catchup-truncatable: the cursor advances after EVERY tool, so a fire cut short mid-pass leaves
#   durable progress and the next pass opens where it closed. Read by mesh-cron-catchup: without
#   these two headers its FIRE_TIMEOUT=2700s cut every catch-up fire off and recorded rc=124 as a
#   FAILURE against a tool that was working (4 of 4 fires, 2026-08-25..29). The seconds above are
#   MAX_SECONDS below; --test asserts the two have not drifted, because a bound copied into a
#   header is a constant with a second reader and no owner.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_HOME:-$HOME/.mesh}"
BIN="${MESH_BIN_DIR:-$HOME/.local/bin}"
LOG="$MESH/forgery-sweep.log"
STATE="$MESH/.forgery-sweep.state"          # pairs already reported to the board (edge-only posting)
ATTRIB_LOG="$MESH/.forgery-attrib.log"      # DOTFILE: snapshot()'s *.log glob must never see it
PROGRESS="$MESH/.forgery-sweep.progress"    # DOTFILE, same reason — and it is written MID-sweep, so
                                            # a *.log name here would grow between a tool's before/
                                            # after snapshots and be attributed to that tool.
CURSOR="$MESH/.forgery-sweep.cursor"        # DOTFILE, same reason as PROGRESS — written MID-sweep.
                                            # Holds the NAME of the last tool swept, never an index:
                                            # the corpus grows (654->669->681 in twelve days) and an
                                            # index would silently land on a different tool.
# ---- UNION coverage, not the resume counter (chat-review {#b09b58cb}) --------------------------
# A resumed pass's own "progress 1/673" restarts at 1 every fire — it is a position within THIS
# pass, not how much of the corpus has ever been looked at — so a reader who takes swept=N/total
# for coverage is reading the wrong fraction on every truncated pass (a full pass runs ~35h against
# a 24h cadence, so EVERY pass truncates). LAP tracks the set of distinct tools swept since the
# last full lap of the corpus, across as many cron fires as it takes; WRAP records when a lap last
# actually completed. Neither is a *.log name — same reason as PROGRESS/CURSOR: written mid-sweep.
LAP="$MESH/.forgery-sweep.lap"              # distinct tool basenames swept since the last completed lap
WRAP="$MESH/.forgery-sweep.wrap"            # ISO timestamp of the last COMPLETED lap, or absent = never
LAPSTART="$MESH/.forgery-sweep.lapstart"    # ISO timestamp the CURRENT (possibly still-open) lap began
LOCKFILE="$MESH/.forgery-sweep.lock"
TEST_TIMEOUT="${MESH_TEST_FORGERY_TIMEOUT:-30}"
# `timeout` sends TERM and then WAITS for the child: a child that DEFERS TERM (a non-interactive
# bash runs no trap until its foreground command returns) leaves the wrapper hanging past its own
# bound — measured 2026-08-21, a `timeout 30` alive 3h21m. Nothing can defer KILL, so -k is the
# bound that does not need the root cause. 0/empty disables it (the --test RED arm, nothing else).
KILL_AFTER="${MESH_TEST_FORGERY_KILL_AFTER:-10}"
# Overall wall-clock bound, checked BETWEEN tools (a single wedged tool is bounded by -k above, not
# by this). THE "never truncates a healthy sweep" SIZING IS REFUTED (measured 2026-08-29, senses):
# it was derived from the 2026-08-18 pass (9h35m / 654 tools = 53s each), and the LIVE rate is
# 135-159s/tool — 302/661 in 12.5h, 328/661 in 14.5h, 454/666 in 17.0h on three consecutive days.
# A full pass now costs ~27h, so 20h truncates EVERY pass, and the daily cadence cannot fit one.
# Raising the bound is NOT the fix: 27h > the 24h cadence, so a pass would still never close and
# would lock the next fire out. The fix is the CURSOR below — a truncated pass is a WINDOW over the
# corpus, and successive windows must ADVANCE. 0 truncates before the first tool (used by --test).
MAX_SECONDS="${MESH_TEST_FORGERY_MAX_SECONDS:-72000}"
# THE CURSOR. Without it the alphabetical walk restarts at mesh-a* every pass, so N truncated passes
# re-sweep the SAME prefix forever and the tail is never swept at all — measured over the four
# passes since the progress marker landed: the high-water tool is mesh-report, and 227 of 681 tools
# (33%) have never been swept once, including the whole mesh-room-*/mesh-sense-*/mesh-wifi-*/
# mesh-voice-* block and mesh-test-forgery itself. It is advanced after EVERY tool, never at the end
# of the pass: this node power-cycles and the catch-up hand cuts the fire off at FIRE_TIMEOUT=2700s,
# so a position saved only on a clean exit is a position that is never saved
# (`a-cursor-saved-at-the-end-of-a-pass-repeats-every-fire-a-crash-interrupts`). 0 disables it.
CURSOR_ON="${MESH_TEST_FORGERY_CURSOR:-1}"
CTRL_MIN="${MESH_TEST_FORGERY_CTRL_MIN:-2}"   # control window floor, seconds
ATTRIB="${MESH_TEST_FORGERY_ATTRIB:-1}"       # 0 disables the fanotify leg (verdicts read `na`)
# ---- the BOARD edges. Until 2026-08-28 there was exactly one: an uncapped [fyi] carrying the whole
# accumulated candidate string, with no owner clause anywhere in the file. Dispatch routes on
# "owner: <tool>/<window>", so 92/69/83 fresh candidates on three consecutive days -- 244 findings --
# reached nobody ({#5fc2aeae}). A detector whose findings cannot be ROUTED has no hand.
CAP="${MESH_TEST_FORGERY_CAP:-8}"             # candidates LISTED in one [fyi]; the overflow collapses
                                              # to a count + the tape path (mesh-journal-watch:98)
TASK_CAP="${MESH_TEST_FORGERY_TASK_CAP:-5}"   # [task] lines FILED per sweep. A budget, never a drop:
                                              # what does not fit is PARKED in the queue below.
TASK_STATE="$MESH/.forgery-sweep.tasks"       # tools that already carry a [task] on the board
TASK_QUEUE="$MESH/.forgery-sweep.taskq"       # tools with an open finding still awaiting one

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ---- lap bookkeeping (PURE parsing/formatting split from the file I/O, so the arithmetic is
# testable without a real multi-day sweep) --------------------------------------------------------
# lap_note <basename> <lapfile> — record one more distinct tool as swept this lap. Idempotent: a
# basename already on the tape is not duplicated, so lap_count is a real distinct-count, not a
# per-visit tally (a tool revisited across passes before the lap completes must count once).
lap_note() {
  local b="$1" f="$2"
  grep -qxF "$b" "$f" 2>/dev/null || printf '%s\n' "$b" >> "$f" 2>/dev/null
}
# lap_count <lapfile> -> distinct entries, 0 if absent/empty. Sorted-unique rather than a bare
# `wc -l`: lap_note already dedupes on write, but a lap file surviving a crash mid-append (a
# half-written line, or two concurrent appends racing under NO OVERLAP's own lock) must not let a
# duplicate inflate the count past a real fraction of the corpus.
lap_count() { sort -u "$1" 2>/dev/null | grep -c . ; }
# wrap_age_report <now-epoch> <wrap-ts-or-empty> <lapstart-ts-or-empty> -> one line, PURE (no I/O,
# no `date` call on a wall clock the caller does not control — both timestamps and "now" are args).
# Two claims, never rendered alike: a lap that has COMPLETED at least once reports how long ago
# ("last full coverage Ns ago"); a corpus that has NEVER completed one reports how long the FIRST
# lap has been open instead — a full pass here runs ~35h against a 24h cadence, so on this node the
# second case is the common one, not an edge, and it must never be silently read as "0s ago" or
# folded into the first sentence's shape.
wrap_age_report() {
  local now="$1" wrap="$2" lapstart="$3" wep
  if [ -n "$wrap" ]; then
    wep="$(date -u -d "$wrap" +%s 2>/dev/null)" || wep=""
    if [ -n "$wep" ]; then
      printf 'wrap=%ds-ago(%s)' "$(( now - wep ))" "$wrap"
    else
      printf 'wrap=unparseable(%s)' "$wrap"
    fi
    return
  fi
  if [ -n "$lapstart" ]; then
    wep="$(date -u -d "$lapstart" +%s 2>/dev/null)" || wep=""
    if [ -n "$wep" ]; then
      printf 'wrap=never(open %ds, since %s)' "$(( now - wep ))" "$lapstart"
    else
      printf 'wrap=never(lapstart unparseable: %s)' "$lapstart"
    fi
    return
  fi
  printf 'wrap=never(no lap recorded yet)'
}

# an absolute path to THIS script, whatever form it was invoked in (used for the flock re-exec)
_self_path() {
  case "$0" in
    /*)   printf '%s\n' "$0" ;;
    */*)  printf '%s\n' "$PWD/$0" ;;
    *)    command -v -- "$0" 2>/dev/null || printf '%s\n' "$0" ;;
  esac
}

# ---- log snapshot -----------------------------------------------------------------------------
# "<path> <size>" per line. A file that does not exist yet is absent here, so its first appearance
# reads as growth from 0 — a test that CREATES the production log is the same defect.
snapshot() {
  local f
  for f in "$MESH"/*.log; do
    [ -f "$f" ] || continue
    printf '%s %s\n' "$f" "$(stat -c %s "$f" 2>/dev/null || echo 0)"
  done
}

size_of() { stat -c %s "$1" 2>/dev/null || echo 0; }

# grown <before-snapshot> <after-snapshot> → paths whose size increased (or which appeared)
grown() {
  awk -v before="$1" '
    BEGIN { while ((getline line < before) > 0) { n=split(line, a, " "); s[a[1]]=a[2] } }
    { if (!($1 in s)) { if ($2+0 > 0) print $1 } else if ($2+0 > s[$1]+0) print $1 }
  ' <<<"$2"
}

# a basename that reads as a dedicated dry-run sink — writing THAT is the fix, not the defect
is_exempt_log() {
  case "$(basename "$1")" in
    *test*|*dry*|*sandbox*|*fixture*) return 0 ;;
    *) return 1 ;;
  esac
}

# run one tool's --test the way mesh-doctor does (same env + timeout), output discarded, rc ignored:
# a FAILING test that writes the production log is still a forgery, so the verdict never reads rc.

# the timeout prefix both call sites share — built per call so a test can flip KILL_AFTER in-process
_timeout_cmd() {
  if [ -n "${KILL_AFTER:-}" ] && [ "${KILL_AFTER:-0}" != 0 ]; then
    TIMEOUT_CMD=(timeout -k "$KILL_AFTER" "$TEST_TIMEOUT")
  else
    TIMEOUT_CMD=(timeout "$TEST_TIMEOUT")     # unbounded once the child defers TERM — see KILL_AFTER
  fi
}

run_test() {
  # </dev/null: the sweep loop reads tool_list on stdin — a swept tool must never eat it
  local -a TIMEOUT_CMD; _timeout_cmd
  # The subshell is not decoration. -k signals the whole GROUP, so the wrapper dies by KILL too, and
  # the shell that waited on it — not the command — prints a bare "Killed" to ITS stderr, which cron
  # appends to the sweep log with no tool name on it. Swallow that and say it properly instead.
  # (`exit $?` also stops bash exec-optimising the subshell away, which is what makes the redirect
  # land on the right process.)
  local rc=0
  ( MESH_TEST_SANDBOX=1 "${TIMEOUT_CMD[@]}" nice -n 10 "$1" --test </dev/null >/dev/null 2>&1; exit $? ) 2>/dev/null
  rc=$?
  [ "$rc" -ge 124 ] && printf '%s bounded %s rc=%d (timeout %ss, kill-after %ss)\n' \
    "$(ts)" "$(basename "$1")" "$rc" "$TEST_TIMEOUT" "${KILL_AFTER:-0}" >&2
  return 0
}

# ---- attribution (mesh-fswriter) ---------------------------------------------------------------
# Can this node name a writer at all? Arming fanotify needs root; listening does not. Absence here
# is honest n/a, and it is carried in the verdict row — never quietly folded into the size legs.
attrib_available() {
  [ "$ATTRIB" = 1 ] || return 1
  command -v mesh-fswriter >/dev/null 2>&1 || return 1
  # --wait, because setsid FORKS when the caller is already a process-group leader: without it the
  # run returns before the test it is supposed to be watching has finished.
  setsid --wait true >/dev/null 2>&1 || return 1
  sudo -n true >/dev/null 2>&1 || return 1
}

# the same run as run_test, in a FRESH SESSION whose id (== the leader's pid) lands in $2. Every
# process the test spawns inherits it, so the session is the membership test for "our run wrote it".
run_test_sid() {
  local -a TIMEOUT_CMD; _timeout_cmd
  local rc=0
  ( setsid --wait bash -c 'echo $$ >"$1"; shift; exec env MESH_TEST_SANDBOX=1 "$@"' \
    _ "$2" "${TIMEOUT_CMD[@]}" nice -n 10 "$1" --test </dev/null >/dev/null 2>&1; exit $? ) 2>/dev/null
  rc=$?
  [ "$rc" -ge 124 ] && printf '%s bounded %s rc=%d (setsid path, timeout %ss, kill-after %ss)\n' \
    "$(ts)" "$(basename "$1")" "$rc" "$TEST_TIMEOUT" "${KILL_AFTER:-0}" >&2
  return 0
}

# attrib_once <tool> <path> <window> → ONE armed run. Prints:
#   self:<comm>   a row from OUR run's session — the defect, named (the tool or anything it spawned)
#   unnamed       a write happened and the identity read lost the race (sid=-1) — retryable
#   other:<comm>  every writer in the window was named, and none was ours (evidence, never innocence)
#   none          armed, and nothing wrote the path at all
#   na            fanotify could not be armed here (or the listener never announced)
attrib_once() {
  local tool="$1" path="$2" win="$3" errf lp mark waited=0 new selfrow row sidf sid comm
  # byte offset first: the sink is append-only and shared across candidates, so OUR window is the
  # tail past this mark. Reading the whole file would attribute an earlier candidate's writer here.
  mark="$(size_of "$ATTRIB_LOG")"
  errf="$(mktemp)"
  MESH_FSWRITER_LOG="$ATTRIB_LOG" mesh-fswriter --window "$win" "$path" >/dev/null 2>"$errf" &
  lp=$!
  # BLOCK ON THE HANDSHAKE, never on a sleep: a mark set a hair after the test starts misses the
  # very write we are here to catch, and misses it silently. Bounded — a listener that never arms
  # (or dies arming) is n/a, which is a claim about this node, not about the tool.
  while ! grep -q armed "$errf" 2>/dev/null; do
    kill -0 "$lp" 2>/dev/null || break
    sleep 0.2; waited=$((waited + 1)); [ "$waited" -gt 50 ] && break
  done
  if ! grep -q armed "$errf" 2>/dev/null; then
    wait "$lp" 2>/dev/null; rm -f "$errf"; run_test "$tool"; printf 'na'; return 0
  fi

  sidf="$(mktemp)"
  run_test_sid "$tool" "$sidf"
  wait "$lp" 2>/dev/null            # the listener owns the window; it flushes its last row at the end
  sid="$(cat "$sidf" 2>/dev/null)"; rm -f "$errf" "$sidf"

  new="$(tail -c "+$((mark + 1))" "$ATTRIB_LOG" 2>/dev/null | grep -F " path=$path cmd=" || true)"
  [ -n "$new" ] || { printf 'none'; return 0; }
  # membership, not text: a row whose session is the one we just created was written by this run or
  # by something it spawned. Guard the empty sid — a grep for " sid= " would match every row.
  selfrow=""
  [ -n "$sid" ] && selfrow="$(grep -F -- " sid=$sid " <<<"$new" | head -1)"
  if [ -n "$selfrow" ]; then
    comm="$(sed -n 's/.* comm=\([^ ]*\) .*/\1/p' <<<"$selfrow" | head -1)"
    printf 'self:%s' "${comm:-?}"; return 0
  fi
  # sid=-1 is fswriter saying "somebody wrote it and /proc was already gone" — an unnamed writer,
  # not another one. That is the retryable case, and it is why this is `unnamed` and not `other`.
  grep -qF -- ' sid=-1 ' <<<"$new" && { printf 'unnamed'; return 0; }
  row="$(head -1 <<<"$new")"
  comm="$(sed -n 's/.* comm=\([^ ]*\) .*/\1/p' <<<"$row" | head -1)"
  printf 'other:%s' "${comm:-?}"
}

# attributed_run <tool> <path> <window> → attrib_once, retried while the identity read LOST THE RACE.
# A `--test` that appends a line and exits is reaped in about the time it takes to read two files in
# /proc, so ~1 attempt in 16 records sid=-1 and names nobody (measured, mesh-fswriter leg 10). One
# lost race must not cost the finding, and a retry is cheap because it only happens when a write was
# actually seen. It is bounded, and a run that stays unnamed says so — `unnamed` never promotes.
attributed_run() {
  local tool="$1" path="$2" win="$3" attempt w
  if ! attrib_available; then run_test "$tool"; printf 'na'; return 0; fi
  for attempt in 1 2 3; do
    w="$(attrib_once "$tool" "$path" "$win")"
    case "$w" in unnamed) continue ;; *) printf '%s' "$w"; return 0 ;; esac
  done
  printf 'unnamed'
}

# ---- one tool ---------------------------------------------------------------------------------
# emits: "<verdict> <tool> <log> <writer>" for each candidate. Verdicts:
#   forgery         — grew on both runs, did NOT grow in the control window — OR fanotify named the
#                     tool's own `--test` as the writer, which no amount of cron noise can explain
#   misattributed   — fanotify NAMED a DIFFERENT process as the writer. NOT a finding: a positive
#                     identification beats a coincidence window, and filing it anyway is how five
#                     contradicted rows became five dispatched board tasks (2026-08-30).
#   unattributable  — grew in the control window too (cron noise; NOT a finding) and unnamed
#   noise           — did not reproduce on the second run (single-pass diff, discarded)
#   exempt          — a dedicated dry-run sink by name
# <writer> is self:<comm> / other:<comm> / none / na — see attributed_run. `na` is a claim about
# THIS NODE (no `sudo -n`), and it is printed rather than dropped, so a weaker sweep never reads
# like a stronger one.
sweep_tool() {
  local tool="$1" name before after cands c t0 dur ctl_before ctl_after b2 a2 w
  name="$(basename "$tool")"
  before="$(snapshot)"
  t0=$SECONDS
  run_test "$tool"
  dur=$(( SECONDS - t0 ))
  after="$(snapshot)"
  cands="$(grown <(printf '%s\n' "$before") "$after")"
  [ -n "$cands" ] || return 0

  [ "$dur" -lt "$CTRL_MIN" ] && dur="$CTRL_MIN"
  for c in $cands; do
    if is_exempt_log "$c"; then printf 'exempt %s %s %s\n' "$name" "$c" "-"; continue; fi
    # CONTROL first: same wallclock length, tool NOT running. This is the cron-noise leg.
    ctl_before="$(size_of "$c")"; sleep "$dur"; ctl_after="$(size_of "$c")"
    # CONFIRM: the same tool again, same log — this time with the candidate MARKED, so the run
    # answers "who wrote it" and not only "did it grow". The listener's window outlasts a test of
    # the length we just measured; a test that runs long past it degrades to `none`, i.e. back to
    # yesterday's two legs, never to a claim the evidence does not carry.
    b2="$(size_of "$c")"; w="$(attributed_run "$tool" "$c" "$((dur + 3))")"; a2="$(size_of "$c")"
    if [ "${w#self:}" != "$w" ]; then
      # NAMED. The tool's own `--test` argv wrote the durable log; the size legs are moot.
      printf 'forgery %s %s %s\n' "$name" "$c" "$w"
    elif [ "${w#other:}" != "$w" ]; then
      # NAMED — AS SOMEBODY ELSE. Until 2026-08-30 the attribution leg could only ever PROMOTE: a
      # `self:` short-circuited to forgery, and every other answer fell through to the two size legs,
      # so fanotify NAMING A DIFFERENT PROCESS as the writer changed nothing and the row was filed as
      # forgery anyway. An arm that can add evidence but never withdraw it is not a measurement of the
      # question — same shape as a liveness arm that can only age a claim and never veto the clock.
      # MEASURED on phaedra's own tape before this branch existed: of 1749 FORGERY rows, only 158 (9%)
      # carried `self`; 591 (34%) carried `other:` — positively contradicted by their own evidence
      # line — and 998 (57%) carried `none`. Five of those contradicted rows had already been filed as
      # board [task]s and dispatched to a mind: mesh-algedonic, mesh-attach, mesh-audio-energy,
      # mesh-ble-recut-arm, mesh-board-unstale, none of which has a single `self` row and none of which
      # even mentions the log it was accused of writing. The control window is a coincidence test on a
      # node running minute-cadence cron, and coincidence loses to a name.
      # `none` and `na` deliberately still fall through to the size legs: nobody was named, which is
      # absence of evidence, not evidence of another writer. Only a POSITIVE contradiction vetoes.
      printf 'misattributed %s %s %s\n' "$name" "$c" "$w"
    elif [ "$a2" -le "$b2" ]; then
      printf 'noise %s %s %s\n' "$name" "$c" "$w"
    elif [ "$ctl_after" -gt "$ctl_before" ]; then
      printf 'unattributable %s %s %s\n' "$name" "$c" "$w"
    else
      printf 'forgery %s %s %s\n' "$name" "$c" "$w"
    fi
  done
}

# ---- the sweep --------------------------------------------------------------------------------
tool_list() {
  local t
  if [ -n "${ONE_TOOL:-}" ]; then
    [ -x "$BIN/$ONE_TOOL" ] && printf '%s\n' "$BIN/$ONE_TOOL"
    return 0
  fi
  for t in "$BIN"/mesh-*; do
    [ -x "$t" ] || continue
    [ -f "$t" ] || continue
    # only tools that DECLARE a --test. Conservative INCLUSION filter (a match in a comment merely
    # costs one run, the same run mesh-doctor already makes hourly); the point is never to hand
    # `--test` to a tool that would read it as its default ACTION.
    grep -q -- '--test' "$t" 2>/dev/null || continue
    printf '%s\n' "$t"
  done
}

do_sweep() {
  local out t n_forge=0 n_un=0 n_mis=0 n_noise=0 n_ex=0 line verdict tool lg
  local -a new_list=()
  local -a tools; local i=0 total swept=0 truncated=0 t0=$SECONDS
  # read the list into an array first: the loop then holds no stdin of its own, so a swept tool
  # cannot eat the worklist even if the </dev/null in run_test is ever lost.
  mapfile -t tools < <(tool_list)
  total=${#tools[@]}
  # ROTATE to the cursor: a truncated pass is a WINDOW over the corpus, so the next one must open
  # where this one closed. Resolved by NAME — a stored index would drift onto a different tool as
  # the corpus grows — and a cursor naming a tool that no longer exists falls back to the head and
  # SAYS so, rather than silently restarting the walk it exists to prevent.
  local start=0 from="" wrapped=0 cur=""
  if [ "$CURSOR_ON" = 1 ] && [ -z "${ONE_TOOL:-}" ] && [ "$total" -gt 0 ]; then
    cur="$(head -n1 "$CURSOR" 2>/dev/null || true)"
    if [ -n "$cur" ]; then
      local k
      for k in "${!tools[@]}"; do
        if [ "$(basename "${tools[$k]}")" = "$cur" ]; then start=$(( (k + 1) % total )); break; fi
      done
      if [ "$start" = 0 ] && [ "$(basename "${tools[0]}")" != "$cur" ]; then
        printf '%s cursor %s no longer in the corpus — restarting at the head\n' "$(ts)" "$cur" >&2
      fi
    fi
    if [ "$start" -gt 0 ]; then tools=( "${tools[@]:$start}" "${tools[@]:0:$start}" ); fi
    from="$(basename "${tools[0]}")"
  fi
  # UNION coverage lives beside the position-based cursor, not instead of it: LAPSTART is stamped
  # once, the first time this lap opens, so a lap that never completes can still say how long it has
  # been open (chat-review {#b09b58cb}).
  [ "$CURSOR_ON" = 1 ] && [ -z "${ONE_TOOL:-}" ] && [ ! -s "$LAPSTART" ] && printf '%s\n' "$(ts)" > "$LAPSTART" 2>/dev/null
  out=""
  for t in "${tools[@]}"; do
    [ -n "$t" ] || continue
    i=$((i+1))
    # THE WALL-CLOCK BOUND, checked between tools. A single wedged tool is bounded by -k, not here;
    # this is the backstop for the whole pass, so a run can never still be alive when the next
    # cadence fires. A truncated pass is a PARTIAL one and says so — swept=n/N below, exit 4.
    if [ "$((SECONDS - t0))" -ge "$MAX_SECONDS" ]; then truncated=1; break; fi
    # PROGRESS, on stderr and to a dotfile, BEFORE the tool runs. The cron line appends stderr to
    # the same log, so a wedged sweep now reads as partial-and-stuck-on-<tool> within a minute of
    # the fire instead of as 18h of silence (2026-08-21). Never a *.log under $MESH — see PROGRESS.
    printf '%s progress %d/%d %s elapsed=%ds\n' "$(ts)" "$i" "$total" "$(basename "$t")" \
      "$((SECONDS - t0))" >&2
    # the FILE is the scheduled pass's own liveness marker (the loser of the lock reads it), so an
    # interactive --tool run must never overwrite or clear a live sweep's line.
    [ -z "${ONE_TOOL:-}" ] && printf '%s progress %d/%d %s elapsed=%ds pid=%d\n' \
      "$(ts)" "$i" "$total" "$(basename "$t")" "$((SECONDS - t0))" "$$" > "$PROGRESS" 2>/dev/null
    line="$(sweep_tool "$t")"
    swept=$((swept+1))
    # ADVANCE NOW, not at the end of the pass. A pass on this node ends by being killed far more
    # often than by finishing (catch-up cuts at FIRE_TIMEOUT=2700s; the machine power-cycles), and
    # a position written only on the clean exit is a position that is never written.
    [ "$CURSOR_ON" = 1 ] && [ -z "${ONE_TOOL:-}" ] && \
      printf '%s\n' "$(basename "$t")" > "$CURSOR" 2>/dev/null
    # the walk came back around to where this pass opened: one full cycle of the corpus is covered
    [ -n "$from" ] && [ "$swept" -ge "$total" ] && wrapped=1
    # record this tool into the UNION-across-passes lap set, independent of "wrapped" above (which
    # is position-based and only ever true within a single unbroken pass — the common case here is
    # many truncated passes, and the union must accumulate across every one of them).
    [ "$CURSOR_ON" = 1 ] && [ -z "${ONE_TOOL:-}" ] && lap_note "$(basename "$t")" "$LAP"
    [ -n "$line" ] && out="${out}${line}"$'\n'
  done
  # ---- did THIS pass complete the lap? Decided by the UNION count, never by "wrapped" above: the
  # corpus can grow mid-lap, so "the position walk came back to $from" and "every distinct tool has
  # now been seen at least once" are different claims and only the second is coverage.
  local lap_swept=0 lap_completed_now=0
  if [ "$CURSOR_ON" = 1 ] && [ -z "${ONE_TOOL:-}" ]; then
    lap_swept="$(lap_count "$LAP")"
    if [ "$total" -gt 0 ] && [ "$lap_swept" -ge "$total" ]; then
      lap_completed_now=1
      printf '%s\n' "$(ts)" > "$WRAP" 2>/dev/null
      : > "$LAP" 2>/dev/null
      printf '%s\n' "$(ts)" > "$LAPSTART" 2>/dev/null
    fi
  fi
  local wrap_line
  wrap_line="$(wrap_age_report "$(date -u +%s)" "$(head -n1 "$WRAP" 2>/dev/null || true)" "$(head -n1 "$LAPSTART" 2>/dev/null || true)")"

  while read -r verdict tool lg w; do
    [ -n "${verdict:-}" ] || continue
    case "$verdict" in
      forgery)        n_forge=$((n_forge+1)); grep -qxF "$tool $lg" "$STATE" 2>/dev/null \
                        || new_list+=("${tool}→$(basename "$lg")[writer=${w:-na}]") ;;
      unattributable) n_un=$((n_un+1)) ;;
      misattributed)  n_mis=$((n_mis+1)) ;;
      noise)          n_noise=$((n_noise+1)) ;;
      exempt)         n_ex=$((n_ex+1)) ;;
    esac
  done <<<"$out"

  if [ "${JSON:-0}" = 1 ]; then
    printf '{"ts":"%s","forgery":%d,"unattributable":%d,"misattributed":%d,"noise_discarded":%d,"exempt":%d,"swept":%d,"tools":%d,"from":"%s","wrapped":%d,"truncated":%d,"union_swept":%d,"union_wrap":"%s",' \
      "$(ts)" "$n_forge" "$n_un" "$n_mis" "$n_noise" "$n_ex" "$swept" "$total" "${from:-head}" "$wrapped" "$truncated" "$lap_swept" "$wrap_line"
    printf '"rows":['
    local first=1
    while read -r verdict tool lg w; do
      [ -n "${verdict:-}" ] || continue
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"verdict":"%s","tool":"%s","log":"%s","writer":"%s"}' "$verdict" "$tool" "$lg" "${w:-na}"
    done <<<"$out"
    printf ']}\n'
  else
    printf '%s' "$out" | sort | sed 's/^/  /'
    # coverage is printed ALWAYS, not only when short: a pass that swept 12/654 must not read like a
    # pass that swept everything (`a-senses-coverage-is-window-over-cadence`).
    # coverage carries WHERE the window opened, not just how wide it was: swept=302/669 alone cannot
    # tell a reader whether the other 367 are the NEXT window or a permanent blind spot.
    # swept=%d/%d is a POSITION within this pass, reset to 1 on every fire — it is not coverage.
    # union=%d/%d is the distinct-tools-ever-swept fraction over the CURSOR's current lap, and
    # wrap= says whether that lap has ever actually closed. The two fractions are printed side by
    # side, never one standing in for the other (chat-review {#b09b58cb}).
    printf 'test-forgery: %d forged, %d unattributable (cron noise), %d single-pass discarded, %d exempt dry-run sinks — swept=%d/%d from=%s wrapped=%d in %ds union=%d/%d %s%s\n' \
      "$n_forge" "$n_un" "$n_noise" "$n_ex" "$swept" "$total" "${from:-head}" "$wrapped" "$((SECONDS - t0))" \
      "$lap_swept" "$total" "$wrap_line" \
      "$([ "$truncated" = 1 ] && printf ' TRUNCATED at the %ss wall-clock bound (PARTIAL pass — the cursor advanced, so the next pass opens where this one closed)' "$MAX_SECONDS")"
  fi

  # durable record + edge-only board post (a pair already reported never re-posts)
  {
    printf '%s sweep forged=%d unattributable=%d noise=%d exempt=%d attrib=%s swept=%d/%d from=%s wrapped=%d dur=%ds truncated=%d union=%d/%d %s\n' \
      "$(ts)" "$n_forge" "$n_un" "$n_noise" "$n_ex" "$(attrib_available && echo fanotify || echo na)" \
      "$swept" "$total" "${from:-head}" "$wrapped" "$((SECONDS - t0))" "$truncated" "$lap_swept" "$total" "$wrap_line"
    while read -r verdict tool lg w; do
      [ "${verdict:-}" = forgery ] && printf '%s FORGERY %s -> %s writer=%s\n' "$(ts)" "$tool" "$lg" "${w:-na}"
    done <<<"$out"
  } >> "$LOG"

  # ---- (A) the DIGEST: one capped [fyi], edge-only ----------------------------------------------
  # The list is CAPPED and the overflow collapses to a count plus the tape path. An uncapped list is
  # not "more information": 83 pairs in one board line is a paragraph nobody reads and the board's
  # own largest noise source, and the tape has all of them anyway.
  local n_new=${#new_list[@]} p shown="" more="" i2=0 overflow=0 tname
  if [ "$n_new" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1; then
    for p in "${new_list[@]}"; do
      i2=$((i2+1)); [ "$i2" -le "$CAP" ] || break
      shown="${shown}${p} "
    done
    overflow=$(( n_new > CAP ? n_new - CAP : 0 ))
    [ "$overflow" -gt 0 ] && more="+${overflow} more not listed — the FULL list is the tape $LOG (grep FORGERY) "
    mesh-chat "[fyi] test-forgery: ${n_new} fresh candidate(s) — a --test is writing the durable liveness log it exists to check — ${shown}${more}(writer=self:* is fanotify NAMING the pid whose argv carries --test; writer=none/other/na means the older evidence: it grew on a re-run and did NOT grow in an equal control window). Give the dry-run its own log (mesh-gpu-lid 180e578 is the pattern); one routed job per offending tool follows." >/dev/null 2>&1
    while read -r verdict tool lg w; do
      [ "${verdict:-}" = forgery ] && printf '%s %s\n' "$tool" "$lg" >> "$STATE"
    done <<<"$out"
    # ENQUEUE before the budget is spent. Marking $STATE above closes the [fyi] edge for these pairs
    # FOREVER, so a tool whose task does not fit this sweep would never be re-detected as fresh and
    # its finding would be silently dropped — the same disappearance this whole change exists to end.
    for p in "${new_list[@]}"; do
      tname="${p%%→*}"
      grep -qxF "$tname" "$TASK_STATE" 2>/dev/null && continue
      grep -qxF "$tname" "$TASK_QUEUE" 2>/dev/null && continue
      printf '%s\n' "$tname" >> "$TASK_QUEUE"
    done
  fi

  # BACKFILL, once. $STATE carries every pair reported in the era before routing existed, and such a
  # pair can never read as fresh again — so without this the standing backlog stays exactly as
  # unrouted as it was and the fix would only ever cover findings not yet made.
  if [ ! -e "$TASK_QUEUE" ] && [ ! -e "$TASK_STATE" ] && [ -s "$STATE" ]; then
    awk '{print $1}' "$STATE" 2>/dev/null | sort -u > "$TASK_QUEUE"
  fi

  # ---- (B) the ROUTE: one [task] per offending tool, drained from the queue ----------------------
  # Deliberately NOT gated on this sweep having found something: a backlog must drain on a clean
  # pass too, or the budget above becomes the drop it was written to avoid.
  if command -v mesh-chat >/dev/null 2>&1 && [ -s "$TASK_QUEUE" ]; then
    local filed=0 pending=0 logs nlogs
    while read -r tname; do
      [ -n "$tname" ] || continue
      if [ "$filed" -ge "$TASK_CAP" ]; then pending=$((pending+1)); continue; fi
      nlogs="$(grep -F " FORGERY $tname -> " "$LOG" 2>/dev/null | awk '{print $5}' | sort -u | wc -l)"
      logs="$(grep -F " FORGERY $tname -> " "$LOG" 2>/dev/null | awk '{print $5}' | sort -u | head -6 | tr '\n' ' ')"
      [ "${nlogs:-0}" -gt 6 ] && logs="${logs}+$((nlogs - 6)) more in the tape "
      mesh-chat "[task] test-forgery/${tname}-test-writes-the-liveness-log-it-checks: ${tname} --test appends to the durable log a human or a watchdog reads to answer whether this organ ever fired, so the dry-run forges the evidence it exists to check — measured by mesh-test-forgery by ATTRIBUTION (it ran the test and watched the logs), not by a source grep: ${logs}. Give the dry-run its own sink, or name the existing sink so it reads as a dedicated dry-run log and the sweep exempts it (mesh-gpu-lid 180e578 is the pattern). Tape: $LOG. owner: ${tname}/genome" >/dev/null 2>&1
      printf '%s\n' "$tname" >> "$TASK_STATE"
      filed=$((filed+1))
    done < <(cat "$TASK_QUEUE" 2>/dev/null)
    if [ "$filed" -gt 0 ] && [ -s "$TASK_STATE" ]; then
      local qtmp; qtmp="$(mktemp "${TASK_QUEUE}.XXXXXX")" \
        && { grep -vxF -f "$TASK_STATE" "$TASK_QUEUE" > "$qtmp" 2>/dev/null; mv -f "$qtmp" "$TASK_QUEUE"; }
    fi
    [ "$pending" -gt 0 ] && mesh-chat "[fyi] test-forgery: ${pending} more offending tool(s) queued and not yet filed — the per-sweep budget is ${TASK_CAP}, so a backlog DRAINS instead of burying the board; nothing in $TASK_QUEUE is dropped and the next sweep files the next ${TASK_CAP}." >/dev/null 2>&1
  fi

  [ -z "${ONE_TOOL:-}" ] && rm -f "$PROGRESS"
  [ "$truncated" = 1 ] && return 4
  [ "$n_forge" -eq 0 ]
}

# ---- smoke test -------------------------------------------------------------------------------
# INTERRUPT SAFETY (2026-08-25, task test-forgery-and-supervise-tests-leak-across-their-longest-window).
# smoke_test carried NO trap: its sandbox `d` and its background writers were reaped only by the
# straight-line path at the end, and BOTH noise loops enclose run_detector — the longest and most
# interruptible stretch in the function (it drives child `--test`s under `timeout`). An interrupt
# there left a `while :; do echo >> $d/…; sleep 0.05; done` subshell spinning FOREVER against a
# directory that no longer exists (20 failed opens/s, no output, no owner), plus the TERM-DEAF
# `sleep 20` fixture, which ignores SIGTERM by construction and so can only be reaped by pid + -9.
# State is held in SHELL-GLOBAL vars on purpose: an EXIT trap fires after smoke_test has returned,
# where its `local d` no longer exists. bash runs the EXIT trap under SIGTERM (only SIGKILL leaks —
# `a-bash-exit-trap-does-run-under-sigterm`), so the EXIT arm is the load-bearing one and INT/TERM/HUP
# only make the exit status honest. Registered ONCE: a second `trap … EXIT` REPLACES the first.
_ST_DIR=""; _ST_PIDS=""
_st_track()   { _ST_PIDS="${_ST_PIDS} $1"; }
# untrack on the ORDERLY reap, so the trap can never -9 a recycled pid belonging to someone else.
_st_untrack() { local p out=""; for p in $_ST_PIDS; do [ "$p" = "$1" ] || out="$out $p"; done; _ST_PIDS="$out"; }
_st_clean() {
  local p
  for p in $_ST_PIDS; do kill -9 "$p" 2>/dev/null; done
  _ST_PIDS=""
  # the TERM-deaf fixture records its own pid (it survives the exec, so this IS the sleep)
  [ -n "$_ST_DIR" ] && [ -s "$_ST_DIR/deaf.pid" ] && kill -9 "$(cat "$_ST_DIR/deaf.pid" 2>/dev/null)" 2>/dev/null
  [ -n "$_ST_DIR" ] && rm -rf "$_ST_DIR"
  _ST_DIR=""
}
smoke_test() {
  local fail=0
  _f() { echo "smoke-test: FAIL ($*)"; fail=1; }

  # sandbox honesty, LOG half: this tool's own --test must not append to the record it publishes.
  local REALLOG="$LOG" REALLOG_SZ; REALLOG_SZ="$(size_of "$LOG")"

  local d; d="$(mktemp -d)"
  _ST_DIR="$d"
  trap '_st_clean' EXIT
  trap '_st_clean; trap - EXIT; exit 130' INT
  trap '_st_clean; trap - EXIT; exit 143' TERM HUP
  mkdir -p "$d/.mesh" "$d/bin"

  # (1) RED fixture — a forger: its --test appends to the durable log its real path writes.
  cat > "$d/bin/mesh-forger" <<'EOF'
#!/usr/bin/env bash
L="${MESH_HOME:-$HOME/.mesh}/forger.log"
log_event(){ echo "$(date -u +%s) event" >> "$L"; }   # INDIRECT writer, defined above the --test arm
case "${1:-}" in --test) log_event; echo "smoke-test: ok"; exit 0 ;; esac
log_event
EOF
  # (2) GREEN fixture — an honest tool: its --test writes only its own dry-run sink.
  cat > "$d/bin/mesh-honest" <<'EOF'
#!/usr/bin/env bash
L="${MESH_HOME:-$HOME/.mesh}/honest.log"
case "${1:-}" in --test) echo "dry" >> "${MESH_HOME:-$HOME/.mesh}/honest-test.log"; echo "smoke-test: ok"; exit 0 ;; esac
echo real >> "$L"
EOF
  # (3) NOISE fixture — writes nothing itself; a background writer moves noisy.log all the while.
  cat > "$d/bin/mesh-quiet" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --test) sleep 0.4; echo "smoke-test: ok"; exit 0 ;; esac   # a window wide enough for the noise writer
EOF
  # (4) MISATTRIBUTED fixture — the tool writes NOTHING itself; a writer in a FOREIGN SESSION appends
  #     only while the tool is running. So the size legs both say "forgery" — it grew on the confirm
  #     run and the control window stayed flat — while fanotify names the other process. This is the
  #     shape 591 of phaedra's 1749 FORGERY rows carried, and before the veto every one of them was
  #     filed as a finding against a tool that never touched the log.
  cat > "$d/bin/mesh-flagger" <<EOF
#!/usr/bin/env bash
case "\${1:-}" in --test) : > "$d/.flag"; sleep 0.6; rm -f "$d/.flag"; echo "smoke-test: ok"; exit 0 ;; esac
EOF
  chmod +x "$d/bin/"mesh-*

  # a stub mesh-chat EARLIER on PATH than the real one, so the post path is genuinely exercised
  # and cannot reach the board ($HOME/.local/bin is prepended by the script itself and is empty here)
  cat > "$d/bin/mesh-chat" <<EOF
#!/usr/bin/env bash
echo "\$*" >> "$d/chat.capture"
EOF
  chmod +x "$d/bin/mesh-chat"

  run_detector() {  # $1 = tool name, $2 = MESH_TEST_FORGERY_ATTRIB (default 0) → verdict rows
    HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_CTRL_MIN=2 \
      MESH_TEST_FORGERY_ATTRIB="${2:-0}" PATH="$d/bin:$PATH" bash "$0" --tool "$1" 2>/dev/null
  }

  local out
  out="$(run_detector mesh-forger)"
  grep -q "^ *forgery mesh-forger .*forger\.log" <<<"$out" \
    || _f "RED fixture: an indirect --test writer of the production log must be named — got: $(tr '\n' '|' <<<"$out")"

  grep -q 'forger.log' "$d/chat.capture" 2>/dev/null \
    || _f "RED fixture: a confirmed forgery must reach the board once — no [fyi] captured"
  # the FIRST detection now writes TWO lines: the capped [fyi] digest and the routed [task]. The
  # edge-only property is about the SECOND sweep adding nothing, so assert the DELTA, never a
  # literal count — a gate that restates the number of posts breaks on every future post.
  local cap_n1 cap_n2
  cap_n1="$(wc -l < "$d/chat.capture" 2>/dev/null || echo 0)"
  grep -qE '^\[task\] test-forgery/mesh-forger-.*owner: mesh-forger/genome' "$d/chat.capture" 2>/dev/null \
    || _f "ROUTE: a confirmed forgery must file a [task] carrying the OFFENDING tool's own owner clause \
(owner: <tool>/genome) — dispatch routes on that and 244 findings reached nobody without it; got: \
$(tr '\n' '|' < "$d/chat.capture" 2>/dev/null)"
  run_detector mesh-forger >/dev/null
  cap_n2="$(wc -l < "$d/chat.capture" 2>/dev/null || echo 0)"
  [ "$cap_n1" = "$cap_n2" ] \
    || _f "edge-only: an already-reported pair must not re-post every sweep ($cap_n1 -> $cap_n2 posts)"

  out="$(run_detector mesh-honest)"
  grep -q "forgery mesh-honest" <<<"$out" \
    && _f "GREEN fixture: a --test writing only its dedicated dry-run sink must NOT be a finding"
  grep -q "exempt mesh-honest .*honest-test\.log" <<<"$out" \
    || _f "GREEN fixture: the dry-run sink must be REPORTED as exempt, not silently dropped"

  # cron-noise leg: the log moves on its own through BOTH passes and the control window.
  ( while :; do echo noise >> "$d/.mesh/noisy.log"; sleep 0.05; done ) &
  local noisepid=$!; _st_track "$noisepid"
  out="$(run_detector mesh-quiet)"
  kill "$noisepid" 2>/dev/null; wait "$noisepid" 2>/dev/null; _st_untrack "$noisepid"
  grep -q "forgery mesh-quiet" <<<"$out" \
    && _f "NOISE leg: a log growing in the control window must never be a finding (single-pass attribution)"
  grep -q "unattributable mesh-quiet .*noisy\.log" <<<"$out" \
    || _f "NOISE leg: cron noise must render unattributable, not vanish — got: $(tr '\n' '|' <<<"$out")"

  # the exemption is by SINK name, and it must not swallow a durable log whose name merely contains
  # the tool's own word — assert the classifier both ways rather than trusting the case list.
  is_exempt_log "$d/.mesh/gpu-lid.log"     && _f "exemption: a durable log must not be exempt"
  is_exempt_log "$d/.mesh/guardian-test.log" || _f "exemption: a dedicated dry-run sink must be exempt"

  # ---- the attribution leg (mesh-fswriter) ------------------------------------------------------
  # (4) THE RECOVERED CLASS — a forger writing a BUSY log. Its --test appends to the durable record
  # AND a background writer moves the same log through every window, so the control leg is polluted
  # and the size-only verdict is `unattributable` forever. fanotify names the writer and settles it.
  cat > "$d/bin/mesh-noisyforger" <<'EOF'
#!/usr/bin/env bash
L="${MESH_HOME:-$HOME/.mesh}/noisyforger.log"
case "${1:-}" in --test) echo "dry" >> "$L"; echo "smoke-test: ok"; exit 0 ;; esac
echo real >> "$L"
EOF
  chmod +x "$d/bin/mesh-noisyforger"

  # the sink is a DOTFILE so the sweep cannot detect its own attribution writes as everyone's
  # forgery. Assert the glob, not the intention. Falsify: rename it to forgery-attrib.log → listed.
  # NEVER `snapshot | grep -q` here: `grep -q` exits on the first match and SIGPIPEs snapshot, and
  # under `set -o pipefail` the pipeline then reports 141 — so the `&& _f` could not fire and this
  # gate was VACUOUS by polarity until 2026-08-21 (`pipefail-turns-sigpipe-into-a-false-verdict`).
  local snap
  : > "$d/.mesh/$(basename "$ATTRIB_LOG")"
  snap="$( MESH="$d/.mesh"; snapshot )"
  grep -qF "$(basename "$ATTRIB_LOG")" <<<"$snap" \
    && _f "attribution sink: the dotfile sink is visible to snapshot() — the detector would report \
itself as the writer of every candidate"

  if ! attrib_available; then
    echo "  n/a: attribution legs skipped (no fanotify arm here: mesh-fswriter or \`sudo -n\` absent)"
  else
    local noisepid2
    ( while :; do echo noise >> "$d/.mesh/noisyforger.log"; sleep 0.05; done ) &
    noisepid2=$!; _st_track "$noisepid2"
    out="$(run_detector mesh-noisyforger 1)"
    grep -qE "^ *forgery mesh-noisyforger .*noisyforger\.log self:" <<<"$out" \
      || _f "attribution: a --test writing a BUSY durable log must be NAMED (writer=self:<comm>) — \
this is the class the control leg discards; got: $(tr '\n' '|' <<<"$out")"

    # …and the SAME fixture with the fanotify leg off must fall back to the honest `unattributable`,
    # which proves the promotion above came from attribution and not from the size legs agreeing
    # anyway (`a-gate-can-be-vacuous-because-the-live-reading-agrees`).
    rm -f "$d/chat.capture"
    out="$(run_detector mesh-noisyforger 0)"
    kill "$noisepid2" 2>/dev/null; wait "$noisepid2" 2>/dev/null; _st_untrack "$noisepid2"
    grep -qE "^ *unattributable mesh-noisyforger .*noisyforger\.log na$" <<<"$out" \
      || _f "attribution off: the writer field must read \`na\` and the verdict must fall back to \
unattributable — an absent attribution may never read like a present one; got: $(tr '\n' '|' <<<"$out")"
  fi

  # A NAMED OTHER WRITER MUST VETO, NOT DECORATE (2026-08-30). The attribution leg could only ever
  # PROMOTE: `self:` short-circuited to forgery and every other answer fell through to the size legs,
  # so fanotify NAMING A DIFFERENT PROCESS changed nothing. An arm that can add evidence but never
  # withdraw it is not a measurement of the question it is asked.
  if attrib_available; then
    local flagpid
    ( while :; do [ -e "$d/.flag" ] && echo x >> "$d/.mesh/flagged.log"; sleep 0.05; done ) &
    flagpid=$!; _st_track "$flagpid"
    out="$(run_detector mesh-flagger 1)"
    grep -qE "^ *misattributed mesh-flagger .*flagged\.log other:" <<<"$out" \
      || _f "veto: fanotify NAMED a different process as the writer and the row was filed anyway — a \
positive identification must beat the coincidence window, not decorate it; got: $(tr '\n' '|' <<<"$out")"
    grep -qE "^ *forgery mesh-flagger " <<<"$out" \
      && _f "veto: the same candidate ALSO came out as forgery — the veto must replace the verdict, \
not add a second row; got: $(tr '\n' '|' <<<"$out")"
    # CONTROL: the SAME fixture with the attribution leg OFF must still read `forgery`. Without this
    # the arm above passes on a fixture whose size legs never agreed in the first place — it would be
    # measuring nothing and would stay green with the veto deleted.
    out="$(run_detector mesh-flagger 0)"
    kill "$flagpid" 2>/dev/null; wait "$flagpid" 2>/dev/null; _st_untrack "$flagpid"
    grep -qE "^ *forgery mesh-flagger .*flagged\.log na$" <<<"$out" \
      || _f "veto control: with attribution OFF this fixture must still be a forgery by the size legs \
alone — otherwise the veto arm above proves nothing about attribution; got: $(tr '\n' '|' <<<"$out")"
  fi

  # grown(): a log that APPEARS (did not exist before) is growth from 0, not an absence
  local b; b="$(printf '%s\n' "/x/a.log 10")"
  [ "$(grown <(printf '%s\n' "$b") "$(printf '%s\n' "/x/a.log 10"$'\n'"/x/new.log 5")")" = "/x/new.log" ] \
    || _f "grown(): a newly created log must read as growth from 0"

  # ---- the CAP, the ROUTE and the DRAIN ({#5fc2aeae}) -------------------------------------------
  # A second, minimal sandbox: `--sweep` over exactly two forgers (one of them writing TWO durable
  # logs), so the per-post cap, the per-sweep task budget and the queue drain are driven for real
  # instead of asserted against one tool. mesh-chat here is a stub with no `--test` string in it, so
  # tool_list's inclusion filter never sweeps the capture sink itself.
  mkdir -p "$d/bin2" "$d/.mesh2"
  cat > "$d/bin2/mesh-forgerA" <<'EOF'
#!/usr/bin/env bash
M="${MESH_HOME:-$HOME/.mesh}"
case "${1:-}" in --test) echo dry >> "$M/forgerA.log"; echo dry >> "$M/forgerA2.log"; echo "smoke-test: ok"; exit 0 ;; esac
echo real >> "$M/forgerA.log"; echo real >> "$M/forgerA2.log"
EOF
  cat > "$d/bin2/mesh-forgerB" <<'EOF'
#!/usr/bin/env bash
M="${MESH_HOME:-$HOME/.mesh}"
case "${1:-}" in --test) echo dry >> "$M/forgerB.log"; echo "smoke-test: ok"; exit 0 ;; esac
echo real >> "$M/forgerB.log"
EOF
  cat > "$d/bin2/mesh-chat" <<EOF
#!/usr/bin/env bash
echo "\$*" >> "$d/chat2.capture"
EOF
  chmod +x "$d/bin2/"mesh-*

  _sweep2() {  # $1 = CAP, $2 = TASK_CAP → one full sweep of bin2 against .mesh2
    HOME="$d" MESH_HOME="$d/.mesh2" MESH_BIN_DIR="$d/bin2" MESH_TEST_FORGERY_ATTRIB=0 \
      MESH_TEST_FORGERY_CTRL_MIN=2 MESH_TEST_FORGERY_CAP="$1" MESH_TEST_FORGERY_TASK_CAP="$2" \
      PATH="$d/bin2:$PATH" bash "$0" --sweep >/dev/null 2>&1
  }

  local fyi tasks1 tasks2
  _sweep2 1 1
  fyi="$(grep -m1 '^\[fyi\] test-forgery: [0-9]* fresh' "$d/chat2.capture" 2>/dev/null)"
  [ -n "$fyi" ] \
    || _f "CAP: the digest must lead with a COUNT of fresh candidates — got: $(tr '\n' '|' < "$d/chat2.capture" 2>/dev/null)"
  grep -q '+[0-9]* more not listed' <<<"$fyi" \
    || _f "CAP: with the list capped at 1 and 3 fresh candidates, the overflow must collapse to a \
count — an uncapped 83-pair paragraph is what nobody read; got: $fyi"
  grep -qF "forgery-sweep.log" <<<"$fyi" \
    || _f "CAP: the collapsed overflow must carry the TAPE PATH, or the capped-away findings are \
unreachable; got: $fyi"
  # …and the cap must actually CUT: exactly one candidate listed, not three.
  [ "$(grep -o '→' <<<"$fyi" | wc -l)" = 1 ] \
    || _f "CAP: MESH_TEST_FORGERY_CAP=1 must list exactly one candidate (listed \
$(grep -o '→' <<<"$fyi" | wc -l))"

  # BUDGET: two offending tools, budget 1 → exactly one [task], and the other is PARKED and named.
  tasks1="$(grep -c '^\[task\] test-forgery/' "$d/chat2.capture" 2>/dev/null || echo 0)"
  [ "$tasks1" = 1 ] \
    || _f "BUDGET: MESH_TEST_FORGERY_TASK_CAP=1 must file exactly one [task] per sweep (filed $tasks1) \
— filing 60 at once buries the board, which is the failure the cap exists to avoid"
  grep -q 'queued and not yet filed' "$d/chat2.capture" 2>/dev/null \
    || _f "BUDGET: a budget that silently withholds findings is the drop it replaced — the unfiled \
count must be SAID"
  [ -s "$d/.mesh2/.forgery-sweep.taskq" ] \
    || _f "BUDGET: the unfiled tool must be PARKED on disk, not held in the pass that is exiting"

  # DRAIN — the load-bearing arm. The second sweep finds NOTHING fresh (both pairs are in $STATE, so
  # the [fyi] edge is closed for them forever), and the queued tool must STILL get its [task]. Break
  # the queue and this is exactly how the finding disappears.
  _sweep2 1 1
  tasks2="$(grep -c '^\[task\] test-forgery/' "$d/chat2.capture" 2>/dev/null || echo 0)"
  [ "$tasks2" = 2 ] \
    || _f "DRAIN: a backlog must drain on a sweep that found nothing fresh (tasks $tasks1 -> $tasks2) \
— a queued tool whose pair is already in the state file can never be re-detected"
  [ "$(grep -oE 'owner: mesh-forger[AB]/genome' "$d/chat2.capture" 2>/dev/null | sort -u | wc -l)" = 2 ] \
    || _f "DRAIN: each offending tool must carry ITS OWN owner clause, never the sweeper's — \
got: $(grep -oE 'owner: [^ ]*' "$d/chat2.capture" 2>/dev/null | sort -u | tr '\n' '|')"
  # …and a filed tool never re-files: a third sweep adds nothing.
  _sweep2 1 1
  [ "$(grep -c '^\[task\] test-forgery/' "$d/chat2.capture" 2>/dev/null || echo 0)" = 2 \
    ] || _f "DRAIN: a tool already carrying a [task] must never re-file it"

  # A NEW offender AFTER the queue file already exists. Without this arm the enqueue loop and the
  # one-shot backfill are mutually masking redundancies and BOTH read as gated: deleting the enqueue
  # entirely left this suite GREEN, because the backfill seeded the queue from $STATE on the very
  # first sweep (measured while writing this — the pair-of-redundancies trap, exactly as mesh-chat's
  # owner-clause guard records it). The backfill fires ONCE, so only a later offender discriminates.
  cat > "$d/bin2/mesh-forgerC" <<'EOF'
#!/usr/bin/env bash
M="${MESH_HOME:-$HOME/.mesh}"
case "${1:-}" in --test) echo dry >> "$M/forgerC.log"; echo "smoke-test: ok"; exit 0 ;; esac
echo real >> "$M/forgerC.log"
EOF
  chmod +x "$d/bin2/mesh-forgerC"
  [ -e "$d/.mesh2/.forgery-sweep.taskq" ] \
    || _f "DRAIN: the queue file must already exist here, or the arm below cannot tell the enqueue \
from the one-shot backfill"
  _sweep2 1 1
  grep -q 'owner: mesh-forgerC/genome' "$d/chat2.capture" 2>/dev/null \
    || _f "ENQUEUE: an offender found AFTER the queue file exists must still be routed — the backfill \
runs once and cannot cover it; got: $(grep -oE 'owner: [^ ]*' "$d/chat2.capture" 2>/dev/null | sort -u | tr '\n' '|')"

  # THE BACKFILL, driven on its own. Every pair reported before this routing existed is already in
  # $STATE (162 distinct on mesh-home at 2026-08-28) and can never read as fresh again, so a sweep
  # that only routes NEW findings leaves the whole standing backlog exactly as unrouted as it was.
  # A fresh sandbox cannot reach this path incidentally — its $STATE starts empty — so the arm
  # pre-seeds one and asserts a route out of a sweep that finds nothing at all.
  mkdir -p "$d/bin3" "$d/.mesh3"
  cat > "$d/bin3/mesh-chat" <<EOF
#!/usr/bin/env bash
echo "\$*" >> "$d/chat3.capture"
EOF
  chmod +x "$d/bin3/mesh-chat"
  printf '%s\n' "mesh-legacy $d/.mesh3/legacy.log" > "$d/.mesh3/.forgery-sweep.state"
  HOME="$d" MESH_HOME="$d/.mesh3" MESH_BIN_DIR="$d/bin3" MESH_TEST_FORGERY_ATTRIB=0 \
    PATH="$d/bin3:$PATH" bash "$0" --sweep >/dev/null 2>&1
  grep -q 'owner: mesh-legacy/genome' "$d/chat3.capture" 2>/dev/null \
    || _f "BACKFILL: a finding recorded BEFORE routing existed must still be routed once — without \
it the fix covers only findings not yet made and the standing backlog stays invisible; got: \
$(tr '\n' '|' < "$d/chat3.capture" 2>/dev/null)"

  # ---- the wedge bounds (2026-08-21: a `timeout 30` from this sweep was alive 3h21m) -------------
  # A TERM-DEFERRING fixture. `trap '' TERM` is an IGNORE disposition, and ignore IS inherited across
  # exec — so the sleep ignores it too, and `timeout` waits on it forever. $$ survives the exec, so
  # the recorded pid IS the sleep: cleanup by pid, never by `pkill -f` on a name half the node shares.
  cat > "$d/bin/mesh-deaf" <<'EOF'
#!/usr/bin/env bash
trap '' TERM
case "${1:-}" in --test) echo $$ > "$MESH_DEAF_PID"; exec sleep 20 ;; esac
EOF
  chmod +x "$d/bin/mesh-deaf"

  local pf="$d/deaf.pid" w0 wdur cpid rp shape
  # RED ARM: with the escalation off, the wrapper must OUTLIVE its own `timeout 1`. If this ever goes
  # green the fixture has stopped reproducing the wedge and the -k gate below would be vacuous.
  rm -f "$pf"
  ( export MESH_DEAF_PID="$pf"; TEST_TIMEOUT=1 KILL_AFTER=0 run_test "$d/bin/mesh-deaf" ) &
  rp=$!; _st_track "$rp"
  sleep 3
  kill -0 "$rp" 2>/dev/null \
    || _f "RED arm: a TERM-deferring child must outlive a plain \`timeout 1\` — the fixture no longer \
reproduces the wedge, so the kill-after gate proves nothing"
  cpid="$(cat "$pf" 2>/dev/null)"
  kill -9 "$rp" 2>/dev/null; [ -n "$cpid" ] && kill -9 "$cpid" 2>/dev/null
  wait "$rp" 2>/dev/null; _st_untrack "$rp"

  # GREEN: -k puts a KILL behind the deferred TERM, at BOTH call sites — the plain one and the
  # setsid one (the wedged run was the setsid path, and an asymmetry there is exactly what hid).
  for shape in run_test run_test_sid; do
    rm -f "$pf"
    w0=$SECONDS
    if [ "$shape" = run_test ]; then
      ( export MESH_DEAF_PID="$pf"; TEST_TIMEOUT=1 KILL_AFTER=1 run_test "$d/bin/mesh-deaf" )
    else
      ( export MESH_DEAF_PID="$pf"; TEST_TIMEOUT=1 KILL_AFTER=1 run_test_sid "$d/bin/mesh-deaf" "$d/sid" )
    fi
    wdur=$(( SECONDS - w0 ))
    [ "$wdur" -le 6 ] \
      || _f "$shape: kill-after must bound a TERM-deferring child (timeout 1 + kill 1 took ${wdur}s)"
    cpid="$(cat "$pf" 2>/dev/null)"
    if [ -n "$cpid" ] && kill -0 "$cpid" 2>/dev/null; then
      _f "$shape: the child SURVIVED the bound (pid $cpid still alive) — the wrapper returned but the \
work did not stop"
      kill -9 "$cpid" 2>/dev/null
    fi
  done

  # WIRING, not just mechanism. Both arms above set KILL_AFTER by hand, so they stay green with the
  # DEFAULT at 0 — measured (`passing-a-test-and-being-wired-are-unrelated-facts`). Take the
  # effective bound from a REAL run's own report, and assert the PROPERTY (non-zero), never the
  # constant — a gate that restates the default is one edit away from agreeing with anything.
  cat > "$d/bin/mesh-slow" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in --test) sleep 5 ;; esac
EOF
  chmod +x "$d/bin/mesh-slow"
  local sw
  sw="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      MESH_TEST_FORGERY_TIMEOUT=1 PATH="$d/bin:$PATH" bash "$0" --tool mesh-slow 2>&1 >/dev/null)"
  grep -qE 'bounded mesh-slow rc=[0-9]+ \(timeout 1s, kill-after [1-9][0-9]*s\)' <<<"$sw" \
    || _f "kill-after WIRING: the default bound must escalate, and a bounded run must name the tool \
it bounded — got: $(tr '\n' '|' <<<"$sw")"

  # ---- the sweep-level bounds -------------------------------------------------------------------
  local sout srct serr
  # the progress dotfile must be invisible to snapshot(), like the attribution sink: it is written
  # BETWEEN a tool's before/after snapshots, so a *.log name would name every tool as its writer.
  # …asserted through the script's OWN $PROGRESS name, never a literal: a gate that restates the
  # constant it guards goes green the moment the constant changes (measured — a literal here stayed
  # green against a mutant that renamed the sink to *.log).
  : > "$d/.mesh/$(basename "$PROGRESS")"
  snap="$( MESH="$d/.mesh"; snapshot )"      # captured, not piped — see the attribution sink above
  grep -qF "$(basename "$PROGRESS")" <<<"$snap" \
    && _f "progress sink: $(basename "$PROGRESS") is visible to snapshot() — the sweep would report \
itself as the writer of every candidate"

  # per-tool progress on stderr, BEFORE the tool runs (the cron line appends stderr to the same log)
  serr="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      PATH="$d/bin:$PATH" bash "$0" --tool mesh-quiet 2>&1 >/dev/null)"
  grep -qE 'progress 1/1 mesh-quiet' <<<"$serr" \
    || _f "progress: a sweep must emit a per-tool line while it runs, not only a report when it \
exits — 18h of work produced zero output on 2026-08-21; got: $(tr '\n' '|' <<<"$serr")"

  # wall-clock bound: a bound of 0 truncates before the first tool → PARTIAL pass, exit 4, coverage
  sout="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      MESH_TEST_FORGERY_MAX_SECONDS=0 PATH="$d/bin:$PATH" bash "$0" --sweep 2>/dev/null)"
  srct=$?
  [ "$srct" = 4 ] || _f "wall-clock bound: a truncated pass must exit 4 (got $srct) — a partial pass \
that exits 0 reads exactly like a clean one"
  grep -q 'swept=0/' <<<"$sout" \
    || _f "wall-clock bound: a pass must publish its COVERAGE (swept=n/N) — got: $sout"
  grep -q 'TRUNCATED' <<<"$sout" || _f "wall-clock bound: a partial pass must say it is partial"

  # ---- THE CURSOR: successive truncated passes must ADVANCE, not re-sweep the same prefix --------
  # Measured 2026-08-29 on mesh-home: four consecutive passes each restarted at mesh-a*, high-water
  # tool mesh-report, and 227 of 681 tools (33%) had never been swept once. The bound is honest and
  # the coverage is published — and it is the SAME 45-68% every day, which is the defect.
  local cout1 cout2 cfrom1 cfrom2 ccur
  rm -f "$d/.mesh/.forgery-sweep.cursor"
  # a clean (untruncated) pass leaves the cursor on the LAST tool of the corpus and reports wrapped=1
  cout1="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      PATH="$d/bin:$PATH" bash "$0" --sweep 2>/dev/null)"
  grep -q 'wrapped=1' <<<"$cout1" \
    || _f "cursor: a pass that swept the whole corpus must report wrapped=1 — without it a reader \
cannot tell a full cycle from a window; got: $cout1"
  ccur="$(cat "$d/.mesh/.forgery-sweep.cursor" 2>/dev/null)"
  [ -n "$ccur" ] || _f "cursor: a completed pass wrote no cursor — the next pass restarts at the \
head and the tail is never swept"

  # SEED the cursor and assert the next pass OPENS at the tool AFTER it (name-resolved, wrapping).
  # This is the arm the whole fix rests on: the rotation, not the file's existence.
  local -a ctools; mapfile -t ctools < <(MESH_BIN_DIR="$d/bin" PATH="$d/bin:$PATH" \
      HOME="$d" MESH_HOME="$d/.mesh" bash -c 'BIN="'"$d"'/bin"; for t in "$BIN"/mesh-*; do
        [ -x "$t" ] && [ -f "$t" ] && grep -q -- "--test" "$t" 2>/dev/null && basename "$t"; done')
  [ "${#ctools[@]}" -ge 2 ] || _f "cursor: fixture needs >=2 swept tools, got ${#ctools[@]}"
  printf '%s\n' "${ctools[0]}" > "$d/.mesh/.forgery-sweep.cursor"
  cout2="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      PATH="$d/bin:$PATH" bash "$0" --sweep 2>/dev/null)"
  cfrom2="$(grep -oP 'from=\K\S+' <<<"$cout2" | head -n1)"
  [ "$cfrom2" = "${ctools[1]}" ] \
    || _f "cursor: a pass must OPEN at the tool after the cursor (${ctools[1]}), got from=$cfrom2 \
— a cursor that is written but not READ leaves the walk restarting at the head forever"

  # a cursor naming a tool that has left the corpus must restart at the head and SAY so, never
  # silently resolve to index 0 (which is the same thing wearing a different word)
  printf 'mesh-gone-from-the-corpus\n' > "$d/.mesh/.forgery-sweep.cursor"
  serr="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      PATH="$d/bin:$PATH" bash "$0" --sweep 2>&1 >/dev/null)"
  grep -q 'no longer in the corpus' <<<"$serr" \
    || _f "cursor: a stale cursor naming a departed tool must say it restarted at the head; got: \
$(tr '\n' '|' <<<"$serr")"

  # TRUNCATION must still advance it: the pass on this node ends by being KILLED far more often than
  # by finishing (catch-up cuts at FIRE_TIMEOUT=2700s, and the machine power-cycles), so a cursor
  # written only on the clean exit is a cursor that is never written.
  # THE BOUND MUST BE >0. MAX_SECONDS=0 truncates before the FIRST tool, so nothing is swept and a
  # deferred-write mutant leaves the cursor untouched exactly as correct code does — a fixture whose
  # two candidates carry one value cannot discriminate, and that arm ran GREEN against the mutant it
  # was written for. 1s lets tool #1 through (elapsed 0 < 1) and truncates at #2, because the first
  # fixture tool alphabetically is mesh-deaf, which burns its whole 20s bound.
  rm -f "$d/.mesh/.forgery-sweep.cursor"
  HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      MESH_TEST_FORGERY_MAX_SECONDS=1 PATH="$d/bin:$PATH" bash "$0" --sweep >/dev/null 2>&1 || true
  ccur="$(cat "$d/.mesh/.forgery-sweep.cursor" 2>/dev/null)"
  [ "$ccur" = "${ctools[0]}" ] \
    || _f "cursor: a TRUNCATED pass that swept a tool must have advanced the cursor to it \
(${ctools[0]}), got '${ccur:-<empty>}' — a pass killed mid-way is the normal case here, and a \
position saved only at the end re-sweeps the same prefix on every fire"

  # ...and a pass truncated before it swept ANYTHING must leave the cursor where it was: advancing
  # on zero work would step the walk past a tool nobody looked at.
  printf '%s\n' "${ctools[1]}" > "$d/.mesh/.forgery-sweep.cursor"
  HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
      MESH_TEST_FORGERY_MAX_SECONDS=0 PATH="$d/bin:$PATH" bash "$0" --sweep >/dev/null 2>&1 || true
  [ "$(cat "$d/.mesh/.forgery-sweep.cursor" 2>/dev/null)" = "${ctools[1]}" ] \
    || _f "cursor: a pass truncated before its first tool must leave the cursor untouched, got: \
$(cat "$d/.mesh/.forgery-sweep.cursor" 2>/dev/null)"

  # the cursor sink must be invisible to snapshot() — it is written between a tool's before/after
  # snapshots, so a *.log name would make the sweep the recorded writer of every candidate
  : > "$d/.mesh/$(basename "$CURSOR")"
  snap="$( MESH="$d/.mesh"; snapshot )"
  grep -qF "$(basename "$CURSOR")" <<<"$snap" \
    && _f "cursor sink: $(basename "$CURSOR") is visible to snapshot() — the sweep would report \
itself as the writer of every candidate"

  # no-overlap: hold the lock and assert the next cadence SKIPS instead of stacking a second pass
  if command -v flock >/dev/null 2>&1; then
    flock -n -o "$d/.mesh/.forgery-sweep.lock" sleep 5 &
    local hp=$!; _st_track "$hp"
    sleep 0.4
    sout="$(HOME="$d" MESH_HOME="$d/.mesh" MESH_BIN_DIR="$d/bin" MESH_TEST_FORGERY_ATTRIB=0 \
        MESH_TEST_FORGERY_MAX_SECONDS=0 PATH="$d/bin:$PATH" bash "$0" --sweep 2>&1)"
    srct=$?
    kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null; _st_untrack "$hp"
    [ "$srct" = 3 ] \
      || _f "no-overlap: a sweep must SKIP (exit 3) while another holds the lock (got $srct) — the \
04:41Z run was still alive when the next 04:41Z fire would have landed on it"
    grep -q 'SKIPPED' <<<"$sout" || _f "no-overlap: the skip must be LOUD, not a silent early return"
  fi

  # THE DECLARED BOUND MUST NOT DRIFT FROM THE ONE THE CODE USES. mesh-cron-catchup reads
  # `# max-runtime:` from this header to decide whether it can fire this line at all; a header that
  # rots into a stale number is a bound with a second reader and no owner, and it fails toward the
  # exact defect this closed — an unfireable line fired anyway, or a fireable one skipped forever.
  # Both sides are read from the SOURCE, so the gate is invariant to whatever the environment sets.
  local _hdr _dflt
  _hdr="$(sed -n 's/^# max-runtime: \([0-9][0-9]*\)$/\1/p' "$0" | head -1)"
  _dflt="$(sed -n 's/^MAX_SECONDS="\${MESH_TEST_FORGERY_MAX_SECONDS:-\([0-9][0-9]*\)}"$/\1/p' "$0" | head -1)"
  [ -n "$_hdr" ] || _f "declared bound: no \`# max-runtime:\` header — mesh-cron-catchup then \
fires this 27h line under its own 2700s bound and records the kill as a failure"
  [ -n "$_dflt" ] || _f "declared bound: MAX_SECONDS default unreadable from source"
  [ -n "$_hdr" ] && [ -n "$_dflt" ] && [ "$_hdr" = "$_dflt" ] \
    || _f "declared bound: header max-runtime=$_hdr but MAX_SECONDS default=$_dflt — they have drifted"
  grep -q '^# catchup-truncatable:' "$0" \
    || _f "declared bound: this pass IS resumable (the cursor advances per tool) but does not say \
so, so every catch-up fire is skipped instead of doing its bounded work"

  # ONE reap path, orderly and interrupted alike — never a straight-line `rm -rf` the trap duplicates
  _st_clean
  [ "$(size_of "$REALLOG")" = "$REALLOG_SZ" ] \
    || _f "sandbox: --test APPENDED to the production log $REALLOG — the detector forged its own record"

  [ "$fail" = 0 ] || return 1
  echo "smoke-test: ok (red forger named · honest dry-run sink exempt · cron noise → unattributable \
· fanotify NAMES a forger of a busy log the control leg discards, and reads \`na\` with the leg off \
· attribution sink invisible to the snapshot · own log untouched)"
}

# ---- entry ------------------------------------------------------------------------------------
JSON=0; ONE_TOOL=""
ORIG_ARGS=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --test)  smoke_test; exit $? ;;
    --json)  JSON=1 ;;
    --tool)  ONE_TOOL="${2:-}"; shift ;;
    --sweep) : ;;
    --coverage)
      mkdir -p "$MESH"
      mapfile -t _cov_tools < <(tool_list)
      _cov_total=${#_cov_tools[@]}
      _cov_swept=0
      _cov_rows=()
      for _cov_t in "${_cov_tools[@]}"; do
        _cov_b="$(basename "$_cov_t")"
        # a subject not on the CURRENT lap's tape is `na` — never assumed clean, never dropped from
        # the listing (chat-review {#b09b58cb}: 33% of the corpus has never been swept once, and a
        # coverage view that only lists what WAS swept hides exactly the subjects the gap is about).
        if grep -qxF "$_cov_b" "$LAP" 2>/dev/null; then
          _cov_rows+=("$_cov_b swept"); _cov_swept=$((_cov_swept+1))
        else
          _cov_rows+=("$_cov_b na")
        fi
      done
      printf '%s\n' "${_cov_rows[@]}" | sort
      printf 'union=%d/%d %s\n' "$_cov_swept" "$_cov_total" \
        "$(wrap_age_report "$(date -u +%s)" "$(head -n1 "$WRAP" 2>/dev/null || true)" "$(head -n1 "$LAPSTART" 2>/dev/null || true)")"
      exit 0 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "mesh-test-forgery: unknown arg $1" >&2; exit 64 ;;
  esac
  shift
done

mkdir -p "$MESH"

# NO OVERLAP. A full pass takes hours (9h35m on 2026-08-18) and a wedged one took 18h+, so the next
# cadence CAN land on top of a live run. Re-exec under flock rather than locking an fd here: an fd
# opened in this shell is inherited by every tool we hand `--test` to, and a single leaked daemon
# would hold the lock forever after we exit. `-o` closes it before exec, so only this process holds
# it. `--tool` is the interactive single-shot form and is deliberately NOT gated.
if [ -z "$ONE_TOOL" ] && [ -z "${MESH_TEST_FORGERY_LOCKED:-}" ] && command -v flock >/dev/null 2>&1; then
  export MESH_TEST_FORGERY_LOCKED=1
  # `bash "$self"`, never a bare "$0": flock execs with execvp, so a $0 with no slash would be
  # PATH-searched (not found in the cwd) and a $0 that is merely readable would need the exec bit.
  flock -n -o -E 3 "$LOCKFILE" bash "$(_self_path)" "${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}"
  rc=$?
  if [ "$rc" = 3 ]; then
    printf '%s test-forgery: SKIPPED — a sweep is already running (%s); this cadence is not adding a second one\n' \
      "$(ts)" "$(cat "$PROGRESS" 2>/dev/null || echo 'no progress line yet')" >&2
  fi
  exit "$rc"
fi
# holder's identity, for the loser's message above; the lock lives on the inode, so truncating is safe
[ -z "$ONE_TOOL" ] && printf '%s holder pid=%d started\n' "$(ts)" "$$" > "$PROGRESS" 2>/dev/null

do_sweep
