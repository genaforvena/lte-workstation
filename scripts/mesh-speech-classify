#!/usr/bin/env bash
# mesh-speech-classify — frequency-band sound classifier for the IdeaPad mic
# Captures 2s of audio, splits into 3 frequency bands via ffmpeg, classifies:
#   SILENCE     all bands below -55dB
#   SPEECH      mid-band (300-4000Hz) dominant ≥6dB over bass+high average
#   DRONE       bass (0-300Hz) dominant — AC hum, fan rumble
#   HISS        high (4kHz+) dominant — fan hiss, sibilance
#   BROADBAND   all bands active but none dominant — music/TV/ambient
#   LOUD        overall RMS ≥ -25dB — close, loud source
# This is layer-2 of the ear pipeline: cheap local speech detection without API calls.
#
# Usage: mesh-speech-classify [--seconds N] [--device DEVICE] [--json]
#   --seconds N   Capture duration (default: 2)
#   --device      ALSA device (default: hw:0,0)
#   --json        Machine-readable JSON output
#   --source FILE Analyze an existing WAV instead of capturing
# --test: smoke-test deps (ffmpeg, arecord, awk)
# reflex-cadence: * * * * * (every minute is fine — local, no API cost)
# reflex-args: --json

SILENCE_DB="${MESH_SILENCE_FLOOR:--55}"      # full band RMS below this = silence
DOMINANCE_DB="${MESH_DOMINANCE:-6}"           # speech band > other bands avg by this = SPEECH
RECORD_SECONDS="${MESH_RECORD_SECONDS:-2}"
ALSA_DEVICE="${MESH_ALSA_DEVICE:-hw:0,0}"

TESTS_PASSED=0; TESTS_FAILED=0
test_ok(){ TESTS_PASSED=$((TESTS_PASSED+1)); echo "  ok: $1"; }
test_fail(){ TESTS_FAILED=$((TESTS_FAILED+1)); echo "  FAIL: $1"; }

json_escape(){ printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null || printf '"%s"' "$1"; }

rms_db(){  # file → RMS dB value (or empty)
  local f="$1" l=""
  l="$(ffmpeg -i "$f" -af "volumedetect" -f null - 2>&1 | sed -n 's/.*mean_volume: \([0-9.-]*\) dB.*/\1/p')"
  printf '%s' "$l"
}

capture_audio(){  # seconds device outfile
  local sec="$1" dev="$2" out="$3"
  arecord -D "$dev" -f cd -t wav -d "$sec" -q "$out" 2>/dev/null
}

band_rms(){  # infile lowfreq highfreq → RMS dB
  local f="$1" lo="$2" hi="$3" tf="" rms=""
  tf="$(mktemp /tmp/.mesh-band-XXXXXX.wav)"
  if [ -z "$hi" ] || [ "$hi" = "" ]; then
    # highpass only (> $lo)
    ffmpeg -i "$f" -af "highpass=f=${lo}" -y "$tf" 2>/dev/null
  elif [ -z "$lo" ] || [ "$lo" = "0" ]; then
    # lowpass only (< $hi)
    ffmpeg -i "$f" -af "lowpass=f=${hi}" -y "$tf" 2>/dev/null
  else
    # bandpass: lo < f < hi
    ffmpeg -i "$f" -af "highpass=f=${lo},lowpass=f=${hi}" -y "$tf" 2>/dev/null
  fi
  rms="$(rms_db "$tf")"
  rm -f "$tf"
  printf '%s' "$rms"
}

do_test(){
  command -v ffmpeg >/dev/null 2>&1 && test_ok "ffmpeg present" || test_fail "ffmpeg not found"
  command -v arecord >/dev/null 2>&1 && test_ok "arecord present" || test_fail "arecord not found"
  command -v awk >/dev/null 2>&1 && test_ok "awk present" || test_fail "awk not found"
  # Quick functional: classify a synthesized WAV as SPEECH (mid-band dominant)
  tmp="$(mktemp /tmp/.mesh-test-XXXXXX.wav)"
  # Generate 1s of 1kHz tone at 0dB (mid-band)
  ffmpeg -y -f lavfi -i "sine=frequency=1000:duration=1" -ac 1 "$tmp" 2>/dev/null
  class="$(bash "$0" --source "$tmp" --json 2>/dev/null)"
  rm -f "$tmp"
  if printf '%s' "$class" | grep -q '"class":"SPEECH"'; then
    test_ok "1kHz tone classified as SPEECH"
  else
    test_fail "1kHz tone NOT classified as SPEECH: $(printf '%s' "$class" | grep -o '"class":"[^"]*"')"
  fi
  if [ $TESTS_FAILED -gt 0 ]; then echo "smoke-test: FAIL"; exit 1; fi
  echo "smoke-test: ok"
  exit 0
}

JSON_MODE=0; SOURCE_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON_MODE=1; shift;;
    --seconds) RECORD_SECONDS="$2"; shift 2;;
    --device) ALSA_DEVICE="$2"; shift 2;;
    --source) SOURCE_FILE="$2"; shift 2;;
    --test) do_test;;
    *) echo "usage: $0 [--json] [--seconds N] [--device DEV] [--source FILE] [--test]"; exit 1;;
  esac
done

# Capture or use source
if [ -z "$SOURCE_FILE" ]; then
  WAV="$(mktemp /tmp/.mesh-speech-XXXXXX.wav)"
  capture_audio "$RECORD_SECONDS" "$ALSA_DEVICE" "$WAV"
else
  WAV="$SOURCE_FILE"
fi

# Analyze bands in parallel
full_rms="$(rms_db "$WAV")"
bass_rms="$(band_rms "$WAV" 0 300)"    # 0-300Hz
mid_rms="$(band_rms "$WAV" 300 4000)"  # 300-4000Hz
high_rms="$(band_rms "$WAV" 4000 "")"  # 4000Hz+

[ -z "$SOURCE_FILE" ] && rm -f "$WAV"

# Defaults if any RMS is empty (capture failed)
full_rms="${full_rms:-0}"
bass_rms="${bass_rms:-0}"
mid_rms="${mid_rms:-0}"
high_rms="${high_rms:-0}"

# Classify
CLASS="UNKNOWN"; full_ok=$(awk "BEGIN{print ($full_rms < 0) ? 1 : 0}")

if [ "$full_ok" != 1 ]; then
  CLASS="NO_AUDIO"
elif awk "BEGIN{exit ($full_rms < $SILENCE_DB) ? 0 : 1}"; then
  CLASS="SILENCE"
else
  # Relative dominance: mid vs others, bass vs mid, high vs mid
  others_avg=$(awk "BEGIN{printf \"%.1f\", ($bass_rms + $high_rms) / 2}")
  mid_dom=$(awk "BEGIN{printf \"%.1f\", $mid_rms - $others_avg}")
  bass_dom=$(awk "BEGIN{printf \"%.1f\", $bass_rms - $mid_rms}")
  high_dom=$(awk "BEGIN{printf \"%.1f\", $high_rms - $mid_rms}")

  if awk "BEGIN{exit ($mid_dom >= $DOMINANCE_DB) ? 0 : 1}"; then
    CLASS="SPEECH"
  elif awk "BEGIN{exit ($bass_dom >= $DOMINANCE_DB) ? 0 : 1}"; then
    CLASS="LOWFREQ"
  elif awk "BEGIN{exit ($high_dom >= $DOMINANCE_DB) ? 0 : 1}"; then
    CLASS="HISS"
  elif awk "BEGIN{exit ($full_rms >= -20) ? 0 : 1}"; then
    CLASS="BROADBAND"
  else
    CLASS="AMBIENT"
  fi
fi

# Output
if [ "$JSON_MODE" = 1 ]; then
cat <<JSONEOF
{
  "class":"${CLASS}",
  "full_db":${full_rms},
  "bass_db":${bass_rms},
  "mid_db":${mid_rms},
  "high_db":${high_rms},
  "duration_s":${RECORD_SECONDS},
  "device":"${ALSA_DEVICE}"
}
JSONEOF
else
  echo "${CLASS}"
  echo "  full: ${full_rms}dB  bass: ${bass_rms}dB  mid: ${mid_rms}dB  high: ${high_rms}dB"
fi

exit 0
