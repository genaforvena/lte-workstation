#!/usr/bin/env bash
# mesh-opbox — small, on-demand Opbox-shaped adapter for the append-only text board.
#
# Opbox's useful boundary is: text on disk -> immutable CRDT operations -> materialized text.
# This internal board adapter keeps that boundary without adding a daemon, package, network
# transport, or second live board. Each board line is one immutable operation; merge is G-Set
# union, so replicas converge under any order, duplication, or repeated materialization.
#
# reflex-cadence: none (on-demand study tool; intentionally not wired)
#
#   mesh-opbox export BOARD OPS.jsonl
#   mesh-opbox merge MERGED.jsonl OPS.jsonl [...]
#   mesh-opbox materialize OPS.jsonl BOARD
#   mesh-opbox sync OUTPUT BOARD [...]
#   mesh-opbox --test
set -euo pipefail

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PYF="$(mktemp "${TMPDIR:-/tmp}/mesh-opbox-XXXXXX.py")"
trap 'rm -f "$PYF"' EXIT

cat >"$PYF" <<'PY'
import hashlib
import json
import os
import sys
import tempfile

VERSION = 1

def op_for(line):
    # The line itself is the G-Set element. This is intentional: the real board already treats
    # identical timestamped lines as duplicates, and keeping the same identity preserves that law.
    digest = hashlib.sha256(line.encode("utf-8", "surrogateescape")).hexdigest()
    return {"v": VERSION, "kind": "line", "id": digest, "line": line}

def read_text(path):
    with open(path, "r", encoding="utf-8", errors="surrogateescape", newline="") as fh:
        return fh.read().splitlines()

def read_ops(path):
    out = {}
    with open(path, "r", encoding="utf-8") as fh:
        for number, raw in enumerate(fh, 1):
            if not raw.strip():
                continue
            try:
                item = json.loads(raw)
            except json.JSONDecodeError as exc:
                raise SystemExit(f"{path}:{number}: invalid operation JSON: {exc}")
            if item.get("v") != VERSION or item.get("kind") != "line":
                raise SystemExit(f"{path}:{number}: unsupported operation")
            line = item.get("line")
            ident = item.get("id")
            if not isinstance(line, str) or not isinstance(ident, str):
                raise SystemExit(f"{path}:{number}: operation needs string id and line")
            if ident != op_for(line)["id"]:
                raise SystemExit(f"{path}:{number}: id does not match line")
            out[ident] = op_for(line)
    return out

def union(paths):
    merged = {}
    for path in paths:
        merged.update(read_ops(path))
    return [merged[key] for key in sorted(merged)]

def write_ops(path, ops):
    parent = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(prefix=".mesh-opbox-", dir=parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            for item in ops:
                fh.write(json.dumps(item, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise

def materialized(ops):
    # Existing board convergence is LC_ALL=C sort -u. Python's code-point order is not identical,
    # so use byte order for the UTF-8 text and retain a final decoded string for writing.
    if isinstance(ops, dict):
        ops = list(ops.values())
    return [item["line"] for item in sorted(ops, key=lambda item: item["line"].encode("utf-8", "surrogateescape"))]

def write_text(path, lines):
    parent = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(prefix=".mesh-opbox-", dir=parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
            if lines:
                fh.write("\n".join(lines) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise

def export_board(board, ops_path):
    write_ops(ops_path, [op_for(line) for line in read_text(board)])

def sync(output, boards):
    all_lines = {}
    for board in boards:
        for line in read_text(board):
            item = op_for(line)
            all_lines[item["id"]] = item
    write_text(output, materialized(list(all_lines.values())))

def selftest():
    a = [op_for(line) for line in ["2026-09-08T00:00:01Z a", "2026-09-08T00:00:03Z c"]]
    b = [op_for(line) for line in ["2026-09-08T00:00:02Z b", "2026-09-08T00:00:03Z c"]]
    c = [op_for(line) for line in ["2026-09-08T00:00:04Z d"]]
    def m(*parts):
        seen = {}
        for part in parts:
            for item in part:
                seen[item["id"]] = item
        return [seen[key] for key in sorted(seen)]
    if m(a, a) != m(a):
        return "idempotence"
    if m(a, b) != m(b, a):
        return "commutativity"
    if m(m(a, b), c) != m(a, m(b, c)):
        return "associativity"
    if materialized(m(a, b)) != ["2026-09-08T00:00:01Z a", "2026-09-08T00:00:02Z b", "2026-09-08T00:00:03Z c"]:
        return "materialization"
    if materialized(m(m(a, b), m(b, c))) != materialized(m(a, b, c)):
        return "convergence"
    return None

if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        failure = selftest()
        if failure:
            print("FAIL: " + failure)
            raise SystemExit(1)
        print("ok: Opbox-shaped board operations (idempotent, commutative, associative, convergent)")
        raise SystemExit(0)
    if len(sys.argv) >= 4 and sys.argv[1] == "export":
        export_board(sys.argv[2], sys.argv[3])
        raise SystemExit(0)
    if len(sys.argv) >= 4 and sys.argv[1] == "merge":
        write_ops(sys.argv[2], union(sys.argv[3:]))
        raise SystemExit(0)
    if len(sys.argv) == 4 and sys.argv[1] == "materialize":
        write_text(sys.argv[3], materialized(read_ops(sys.argv[2])))
        raise SystemExit(0)
    if len(sys.argv) >= 4 and sys.argv[1] == "sync":
        sync(sys.argv[2], sys.argv[3:])
        raise SystemExit(0)
    print("usage: mesh-opbox {--test|export BOARD OPS|merge OUT OPS...|materialize OPS BOARD|sync OUT BOARD...}", file=sys.stderr)
    raise SystemExit(2)
PY

exec python3 "$PYF" "$@"
