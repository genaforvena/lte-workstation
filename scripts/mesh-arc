#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-arc — cross-sense fusion: WHAT IS THE OPERATOR'S CURRENT CONTEXT ARC?
# Combines 5 senses into a single "arc" token no single sensor gives.
#
# Inputs (all best-effort, each independently OFFLINE-able; 2+ missing → DEGRADED):
#   mesh-rhythm-state      .rhythm-state         DEEP_WORK|LIGHT_BROWSING|CONVERSATIONAL|BREAK|WINDING_DOWN|SLEEPING|INITIAL|DEGRADED|UNKNOWN
#   mesh-presence.familiarity  .presence-state   familiarity=INITIAL|STRANGER|MIXED|FAMILIAR|OFFLINE
#   mesh-presence.personal_presence  (same)     personal_presence=ACTIVE_NEAR|ACTIVE_FAR|ARRIVING|DEPARTING|AMBIGUOUS|APPLIANCE|EMPTY
#   mesh-presence-density  .presence-density-state CROWDED|BUSY|MODERATE|EMPTY|DEGRADED
#   mesh-light             .light-state          DARK|DIM|MODERATE|LIT|BRIGHT|OFFLINE
#
# Why this fusion is NEW (not duplicating existing fusions):
#   - mesh-room-context fuses ambient-clock+room-sense+activity-tempo → a TIME-OF-DAY engagement label
#   - mesh-rhythm-state fuses body+light+ambient+room-context+room-sense → a COGNITIVE state
#     (DEEP_WORK / SLEEPING / WINDING_DOWN / etc.)
#   - mesh-tempo-context fuses tempo+density+familiarity+burst → a ROOM RHYTHM (DEEP_QUIET / BUSY_SOCIAL / etc.)
#   - mesh-presence-density fuses presence+room-sense+tempo+light → an OCCUPANCY MAGNITUDE
#   - This fusion is the OPERATOR'S CONTEXT ARC: cognitive state (rhythm) + social direction
#     (personal_presence) + settledness (familiarity) + occupancy (density) + ambient brightness
#     (light) into a single token describing "what kind of moment is this?"
#
# Bands (FALSIFIABLE: change a band rule → test flips):
#   SLEEPING        rhythm=SLEEPING                                       — operator is asleep
#   WINDING         rhythm=WINDING_DOWN + density=MODERATE/BUSY          — engaged, winding down
#   SOCIAL_ENGAGED  rhythm=CONVERSATIONAL + density=CROWDED|BUSY         — talking with people
#   DEEP_FOCUSED    rhythm=DEEP_WORK + familiarity=FAMILIAR + light!=DARK — operator deep in focus
#   DEEP_FOCUSED_NIGHT rhythm=DEEP_WORK + light=DARK                    — focus but it's dark (late session)
#   DEEP_FOCUSED_NEW rhythm=DEEP_WORK + familiarity=STRANGER|MIXED        — new person deep in focus
#   RESTING         rhythm=BREAK                                          — break / pause
#   ARRIVAL         personal_presence=ARRIVING                           — fresh arrival (any cognitive state)
#   DEPARTURE       personal_presence=DEPARTING                          — leaving (any cognitive state)
#   ACTIVE_SOLO     rhythm=LIGHT_BROWSING + density=MODERATE            — solo light activity
#   NEW_PRESENCE    density=MODERATE|BUSY + familiarity=STRANGER|MIXED   — new person around
#   ALONE           density=EMPTY                                         — no one here
#   TRANSITION      rhythm=INITIAL or 1 OFFLINE (can't fully assert)     — first read or partial
#   DEGRADED        2+ OFFLINE                                            — can't tell, never faked
#   UNKNOWN         no band matched — INCLUDING rhythm=UNKNOWN (rhythm sensor LIVE but its own
#                   inputs matched no cognitive rule). This is DISTINCT from DEGRADED: the senses
#                   are reachable, the moment is just unclassifiable — never counted as OFFLINE.
#
#   mesh-arc             one-shot verdict to stdout
#   mesh-arc --edge      emit only on verdict change (for cron wiring)
#   mesh-arc --json      machine-readable {label, reason, inputs, ts}
#   mesh-arc --test      smoke test (pure classifier, no /proc reads)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.arc-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=1800  # 30min — generous for the longest-cadence input

# read_rhythm <state> → echoes DEEP_WORK|LIGHT_BROWSING|CONVERSATIONAL|BREAK|WINDING_DOWN|SLEEPING|INITIAL|DEGRADED|UNKNOWN|OFFLINE
# Honest-fusion: a STALE/absent file is OFFLINE (rhythm sensor truly unreachable). But a FRESH file
# holding UNKNOWN is a LIVE-but-inconclusive read (rhythm-state's 5 senses were all reachable, the
# pattern just matched no rule — most commonly room occupancy UNCERTAIN). UNKNOWN must pass through
# DISTINCT from OFFLINE, or a working rhythm sensor is falsely tallied as a missing input → a false
# arc=DEGRADED (verified live 2026-07-06: rhythm=UNKNOWN was rendering "[arc-degraded] missing: rhythm").
read_rhythm() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    DEEP_WORK|LIGHT_BROWSING|CONVERSATIONAL|BREAK|WINDING_DOWN|SLEEPING|INITIAL|DEGRADED|UNKNOWN) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# read_density <state> → echoes CROWDED|BUSY|MODERATE|EMPTY|DEGRADED|OFFLINE
read_density() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    CROWDED|BUSY|MODERATE|EMPTY|DEGRADED) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# read_familiarity <state> → echoes INITIAL|STRANGER|MIXED|FAMILIAR|OFFLINE
# mesh-presence writes `count=N ... familiarity=LABEL session_max_s=N` (additive).
read_familiarity() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | grep -oE 'familiarity=[A-Z]+' | head -1 | cut -d= -f2)"
  case "$v" in
    INITIAL|STRANGER|MIXED|FAMILIAR) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# read_personal_presence <state> → echoes ACTIVE_NEAR|ACTIVE_FAR|ARRIVING|DEPARTING|AMBIGUOUS|APPLIANCE|EMPTY|OFFLINE
read_personal_presence() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | grep -oE 'personal_presence=[A-Z_]+' | head -1 | cut -d= -f2)"
  case "$v" in
    ACTIVE_NEAR|ACTIVE_FAR|ARRIVING|DEPARTING|AMBIGUOUS|APPLIANCE|EMPTY) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# read_light <state> → echoes DARK|DIM|MODERATE|LIT|BRIGHT|OFFLINE
# mesh-light writes `LEVEL|dwell_s=N|changes_24h=N` (additive, 1st field is the level).
read_light() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    DARK|DIM|MODERATE|LIT|BRIGHT) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# classify_arc <rhythm> <density> <familiarity> <personal> <light> → "LABEL|reason" — pure, offline-testable
classify_arc() {
  local rhythm="$1" density="$2" fam="$3" personal="$4" light="$5"
  # DEGRADED check first (2+ OFFLINE → DEGRADED with explicit missing list)
  local missing=""
  [ "$rhythm"    = "OFFLINE" ] && missing="${missing}rhythm,"
  [ "$density"   = "OFFLINE" ] && missing="${missing}density,"
  [ "$fam"       = "OFFLINE" ] && missing="${missing}familiarity,"
  [ "$personal"  = "OFFLINE" ] && missing="${missing}personal-presence,"
  [ "$light"     = "OFFLINE" ] && missing="${missing}light,"
  missing="${missing%,}"
  local degen=0
  [ "$rhythm"    = "OFFLINE" ] && degen=$((degen+1))
  [ "$density"   = "OFFLINE" ] && degen=$((degen+1))
  [ "$fam"       = "OFFLINE" ] && degen=$((degen+1))
  [ "$personal"  = "OFFLINE" ] && degen=$((degen+1))
  [ "$light"     = "OFFLINE" ] && degen=$((degen+1))
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $missing (too many senses unreachable for confident verdict)"
    return
  fi
  if [ "$degen" -eq 1 ]; then
    echo "DEGRADED|missing: $missing (1 sense offline, can't fully assert)"
    return
  fi
  # TRANSITION gate: cold-start (rhythm=INITIAL)
  if [ "$rhythm" = "INITIAL" ]; then
    echo "TRANSITION|rhythm=INITIAL (cold-start, no cognitive baseline yet)"
    return
  fi
  # DEGRADED-rhythm (caller's own degraded) → propagate
  if [ "$rhythm" = "DEGRADED" ]; then
    echo "DEGRADED|rhythm=DEGRADED (rhythm-state itself couldn't assert)"
    return
  fi
  # Density = DEGRADED → propagate
  if [ "$density" = "DEGRADED" ]; then
    echo "DEGRADED|density=DEGRADED (presence-density itself couldn't assert)"
    return
  fi
  # Priority bands (cognitive state first, then social direction, then settledness, then occupancy)
  # 1. SLEEPING — strong, unambiguous
  if [ "$rhythm" = "SLEEPING" ]; then
    echo "SLEEPING|rhythm=SLEEPING (operator is asleep)"
    return
  fi
  # 2. WINDING — engaged but winding down
  if [ "$rhythm" = "WINDING_DOWN" ] && { [ "$density" = "MODERATE" ] || [ "$density" = "BUSY" ]; }; then
    echo "WINDING|rhythm=WINDING_DOWN + density=$density (engaged, winding down)"
    return
  fi
  # 3. SOCIAL_ENGAGED — talking with people
  if [ "$rhythm" = "CONVERSATIONAL" ] && { [ "$density" = "CROWDED" ] || [ "$density" = "BUSY" ]; }; then
    echo "SOCIAL_ENGAGED|rhythm=CONVERSATIONAL + density=$density (talking with people)"
    return
  fi
  # 4. RESTING — break / pause (priority over DEEP_FOCUSED — a break state is more informative
  # than a deep-focus steady state when both apply; deep focus during a break is contradictory)
  if [ "$rhythm" = "BREAK" ]; then
    echo "RESTING|rhythm=BREAK (operator on a break)"
    return
  fi
  # 5. ARRIVAL — fresh arrival (priority over steady-state DEEP_FOCUSED — a new person arriving
  # is a "just happened" event that overrides the steady-state cognitive context)
  if [ "$personal" = "ARRIVING" ]; then
    echo "ARRIVAL|personal_presence=ARRIVING (fresh arrival, cognitive state=$rhythm)"
    return
  fi
  # 6. DEPARTURE — leaving (priority over steady-state DEEP_FOCUSED — symmetric to ARRIVAL)
  if [ "$personal" = "DEPARTING" ]; then
    echo "DEPARTURE|personal_presence=DEPARTING (leaving, cognitive state=$rhythm)"
    return
  fi
  # 7. NEW_PRESENCE — new person around (priority over ACTIVE_SOLO — STRANGER/MIXED is a stronger
  # signal than "light activity alone", it means someone new is around)
  if { [ "$density" = "MODERATE" ] || [ "$density" = "BUSY" ]; } && { [ "$fam" = "STRANGER" ] || [ "$fam" = "MIXED" ]; }; then
    echo "NEW_PRESENCE|density=$density + familiarity=$fam (new entity, cognitive state=$rhythm)"
    return
  fi
  # 8. DEEP_FOCUSED — operator deep in focus
  if [ "$rhythm" = "DEEP_WORK" ] && [ "$fam" = "FAMILIAR" ] && [ "$light" != "DARK" ]; then
    echo "DEEP_FOCUSED|rhythm=DEEP_WORK + familiarity=FAMILIAR + light=$light (operator in deep focus)"
    return
  fi
  # 9. DEEP_FOCUSED_NIGHT — focus but it's dark
  if [ "$rhythm" = "DEEP_WORK" ] && [ "$light" = "DARK" ]; then
    echo "DEEP_FOCUSED_NIGHT|rhythm=DEEP_WORK + light=DARK (focus, late night session)"
    return
  fi
  # 10. ACTIVE_SOLO — light activity, alone-ish (only after NEW_PRESENCE — STRANGER/MIXED wins)
  if [ "$rhythm" = "LIGHT_BROWSING" ] && [ "$density" = "MODERATE" ]; then
    echo "ACTIVE_SOLO|rhythm=LIGHT_BROWSING + density=MODERATE (solo light activity)"
    return
  fi
  # 11. ALONE — no presence
  if [ "$density" = "EMPTY" ]; then
    echo "ALONE|density=EMPTY (no one here)"
    return
  fi
  # 12. UNKNOWN — fallback
  echo "UNKNOWN|unmatched (rhythm=$rhythm density=$density fam=$fam personal=$personal light=$light)"
}

# --- Test mode ---
if [ "${1:-}" = --test ]; then
  fail=0
  # SLEEPING
  r="$(classify_arc SLEEPING MODERATE FAMILIAR ACTIVE_FAR DARK)"
  echo "$r" | grep -q '^SLEEPING' || { echo "  FAIL SLEEPING: got=$r"; fail=1; }
  # WINDING
  r="$(classify_arc WINDING_DOWN MODERATE FAMILIAR ACTIVE_FAR DIM)"
  echo "$r" | grep -q '^WINDING' || { echo "  FAIL WINDING: got=$r"; fail=1; }
  # WINDING requires MODERATE/BUSY density (not EMPTY)
  r="$(classify_arc WINDING_DOWN EMPTY FAMILIAR EMPTY DARK)"
  echo "$r" | grep -q '^WINDING' && { echo "  FAIL WINDING-density-empty: got=$r (should NOT be WINDING)"; fail=1; }
  # SOCIAL_ENGAGED: CONVERSATIONAL + CROWDED
  r="$(classify_arc CONVERSATIONAL CROWDED FAMILIAR ACTIVE_NEAR MODERATE)"
  echo "$r" | grep -q '^SOCIAL_ENGAGED' || { echo "  FAIL SOCIAL_ENGAGED-crowded: got=$r"; fail=1; }
  # SOCIAL_ENGAGED: CONVERSATIONAL + BUSY
  r="$(classify_arc CONVERSATIONAL BUSY FAMILIAR ACTIVE_NEAR LIT)"
  echo "$r" | grep -q '^SOCIAL_ENGAGED' || { echo "  FAIL SOCIAL_ENGAGED-busy: got=$r"; fail=1; }
  # SOCIAL_ENGAGED boundary: CONVERSATIONAL + MODERATE → NOT social_engaged (falls through to UNKNOWN)
  r="$(classify_arc CONVERSATIONAL MODERATE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^SOCIAL_ENGAGED' && { echo "  FAIL SOCIAL_ENGAGED-boundary: moderate should NOT crowd, got=$r"; fail=1; }
  # DEEP_FOCUSED
  r="$(classify_arc DEEP_WORK MODERATE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^DEEP_FOCUSED' || { echo "  FAIL DEEP_FOCUSED: got=$r"; fail=1; }
  # DEEP_FOCUSED_NIGHT
  r="$(classify_arc DEEP_WORK MODERATE FAMILIAR ACTIVE_FAR DARK)"
  echo "$r" | grep -q '^DEEP_FOCUSED_NIGHT' || { echo "  FAIL DEEP_FOCUSED_NIGHT: got=$r"; fail=1; }
  # DEEP_FOCUSED vs SOCIAL_ENGAGED: rhythm=DEEP_WORK (not CONVERSATIONAL) + familiarity=FAMILIAR
  # → DEEP_FOCUSED, even when density=CROWDED (operator in deep focus despite crowd)
  r="$(classify_arc DEEP_WORK CROWDED FAMILIAR ACTIVE_NEAR LIT)"
  echo "$r" | grep -q '^DEEP_FOCUSED' || { echo "  FAIL DEEP_FOCUSED-priority: got=$r (should be DEEP_FOCUSED)"; fail=1; }
  # RESTING
  r="$(classify_arc BREAK MODERATE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^RESTING' || { echo "  FAIL RESTING: got=$r"; fail=1; }
  # ARRIVAL
  r="$(classify_arc LIGHT_BROWSING MODERATE FAMILIAR ARRIVING MODERATE)"
  echo "$r" | grep -q '^ARRIVAL' || { echo "  FAIL ARRIVAL: got=$r"; fail=1; }
  # ARRIVAL priority: beats DEEP_FOCUSED
  r="$(classify_arc DEEP_WORK MODERATE FAMILIAR ARRIVING MODERATE)"
  echo "$r" | grep -q '^ARRIVAL' || { echo "  FAIL ARRIVAL-priority: got=$r (should be ARRIVAL)"; fail=1; }
  # DEPARTURE
  r="$(classify_arc LIGHT_BROWSING MODERATE FAMILIAR DEPARTING MODERATE)"
  echo "$r" | grep -q '^DEPARTURE' || { echo "  FAIL DEPARTURE: got=$r"; fail=1; }
  # ACTIVE_SOLO
  r="$(classify_arc LIGHT_BROWSING MODERATE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^ACTIVE_SOLO' || { echo "  FAIL ACTIVE_SOLO: got=$r"; fail=1; }
  # NEW_PRESENCE
  r="$(classify_arc LIGHT_BROWSING MODERATE STRANGER ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^NEW_PRESENCE' || { echo "  FAIL NEW_PRESENCE: got=$r"; fail=1; }
  # ALONE
  r="$(classify_arc LIGHT_BROWSING EMPTY INITIAL EMPTY DARK)"
  echo "$r" | grep -q '^ALONE' || { echo "  FAIL ALONE: got=$r"; fail=1; }
  # TRANSITION: rhythm=INITIAL
  r="$(classify_arc INITIAL MODERATE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL TRANSITION: got=$r"; fail=1; }
  # DEGRADED: 2 OFFLINE
  r="$(classify_arc OFFLINE OFFLINE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-2: got=$r"; fail=1; }
  echo "$r" | grep -q 'rhythm' || { echo "  FAIL DEGRADED should list rhythm: got=$r"; fail=1; }
  # DEGRADED: all 5 OFFLINE
  r="$(classify_arc OFFLINE OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-5: got=$r"; fail=1; }
  # 1-missing
  r="$(classify_arc DEEP_WORK OFFLINE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL 1-missing: got=$r"; fail=1; }
  # rhythm=DEGRADED propagates
  r="$(classify_arc DEGRADED MODERATE FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL rhythm-DEGRADED-propagates: got=$r"; fail=1; }
  # density=DEGRADED propagates
  r="$(classify_arc DEEP_WORK DEGRADED FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL density-DEGRADED-propagates: got=$r"; fail=1; }
  # UNKNOWN fallback
  r="$(classify_arc LIGHT_BROWSING CROWDED FAMILIAR ACTIVE_FAR MODERATE)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL UNKNOWN: got=$r"; fail=1; }
  # --- rhythm=UNKNOWN is LIVE-but-inconclusive, NOT unreachable (honest-fusion fix 2026-07-06) ---
  # A live rhythm sensor reading UNKNOWN (its own 5 senses reachable, no cognitive rule matched —
  # commonly room occupancy UNCERTAIN) must NOT be tallied as an OFFLINE/missing input → arc must
  # NOT be DEGRADED, and must render UNKNOWN (unmatched, senses live) — visibly distinct from OFFLINE.
  r="$(classify_arc UNKNOWN MODERATE FAMILIAR ACTIVE_FAR DIM)"
  echo "$r" | grep -q '^DEGRADED' && { echo "  FAIL rhythm-UNKNOWN must NOT be DEGRADED (live≠unreachable): got=$r"; fail=1; }
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL rhythm-UNKNOWN should render UNKNOWN (unmatched, live): got=$r"; fail=1; }
  # ...and presence-driven bands STILL fire under an inconclusive rhythm (occupancy is independent):
  r="$(classify_arc UNKNOWN EMPTY INITIAL EMPTY DARK)"
  echo "$r" | grep -q '^ALONE' || { echo "  FAIL rhythm-UNKNOWN + density=EMPTY should still be ALONE: got=$r"; fail=1; }
  r="$(classify_arc UNKNOWN MODERATE FAMILIAR ARRIVING MODERATE)"
  echo "$r" | grep -q '^ARRIVAL' || { echo "  FAIL rhythm-UNKNOWN + ARRIVING should still be ARRIVAL: got=$r"; fail=1; }
  # read_rhythm mapping: a FRESH file holding UNKNOWN passes through as UNKNOWN; a STALE one → OFFLINE
  _rt="$(mktemp)"; printf 'UNKNOWN|body=body-still light=DIM amb=QUIET\n' > "$_rt"
  [ "$(read_rhythm "$_rt")" = "UNKNOWN" ] || { echo "  FAIL read_rhythm fresh UNKNOWN should pass through, got=$(read_rhythm "$_rt")"; fail=1; }
  touch -d '2 hours ago' "$_rt"
  [ "$(read_rhythm "$_rt")" = "OFFLINE" ] || { echo "  FAIL read_rhythm STALE UNKNOWN should be OFFLINE, got=$(read_rhythm "$_rt")"; fail=1; }
  rm -f "$_rt"
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (30 fusion assertions: SLEEPING×1, WINDING×2, SOCIAL_ENGAGED×3, DEEP_FOCUSED×2, RESTING×1, ARRIVAL×2, DEPARTURE×1, ACTIVE_SOLO×1, NEW_PRESENCE×1, ALONE×1, TRANSITION×1, DEGRADED×4, rhythm-DEGRADED-propagates×1, density-DEGRADED-propagates×1, UNKNOWN×1, rhythm-UNKNOWN-not-degraded×1, rhythm-UNKNOWN-renders-UNKNOWN×1, rhythm-UNKNOWN+ALONE×1, rhythm-UNKNOWN+ARRIVAL×1, read_rhythm-UNKNOWN-passthrough+STALE×2)"
  exit 0
fi

# --- Live read path ---
rhythm="$(read_rhythm "$MESH/.rhythm-state")"
density="$(read_density "$MESH/.presence-density-state")"
fam="$(read_familiarity "$MESH/.presence-state")"
personal="$(read_personal_presence "$MESH/.presence-state")"
light="$(read_light "$MESH/.light-state")"

result="$(classify_arc "$rhythm" "$density" "$fam" "$personal" "$light")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|rhythm=%s|density=%s|familiarity=%s|personal=%s|light=%s|%s\n' "$label" "$rhythm" "$density" "$fam" "$personal" "$light" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"rhythm":"%s","density":"%s","familiarity":"%s","personal_presence":"%s","light":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$rhythm" "$density" "$fam" "$personal" "$light" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
  prev_label="${prev%%|*}"
  [ "$prev_label" = "$label" ] && exit 0
  printf '[arc-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr '_' '-')" "$label" "$reason"
  exit 0
fi
printf '[arc-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr '_' '-')" "$label" "$reason"
