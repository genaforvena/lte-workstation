#!/usr/bin/env bash
# mesh-audit — VSM System 3* (three-star) channel: the SPORADIC, INDEPENDENT, PROACTIVE
# CORRECTNESS audit. It does NOT trust a reflex's own report. It goes straight to the
# operational floor — re-reads the RAW ORGAN directly — and cross-checks the reflex's
# LAST-EMITTED value against that fresh ground truth.
#
# WHY THIS IS A NEW CHANNEL (not a duplicate of what we already have):
#   Beer's VSM distinguishes three ways the centre learns about the operational floor:
#     S3  routine reporting  → the reflex's own state artifact (we age its mtime)
#     S1  self-audit         → the reflex's own `--test` (S1 grading itself → gameable/hollow)
#     S3* sporadic audit     → an INDEPENDENT observer that ignores both and re-derives truth
#   Every liveness watchdog we own (mesh-reflex-health, mesh-pulse) answers ONLY "is it
#   RUNNING?" — freshness, via mtime. And `mesh-state-touch` deliberately keeps that mtime
#   fresh on every eval EVEN WHEN THE VALUE DOESN'T CHANGE. Consequence: a reflex that is
#   alive and dutifully touching its state, but emitting a WRONG value (organ drifted, a
#   driver returns plausible-but-stale data, it reads the wrong zone), passes EVERY watchdog
#   forever. That is the "hollow sense" the doctrine already fears on the FRESHNESS side
#   (mesh-mag racing its driver) — but the VALUE-CORRECTNESS side is unguarded. A hollow
#   sense reports green, so it never raises an algedonic alarm either — the reactive
#   audit (algedonic-triggered) can't reach it. Only a PROACTIVE, UNANNOUNCED audit can.
#
# THE ANTI-GAMING PROPERTY IS THE RANDOMISATION. A fixed-cadence check is, in the limit, just
# another routine channel a degradation can hide between. S3* fires on an UNPREDICTABLE schedule
# and picks a RANDOM target, so a slow drift is surfaced in expectation without a blind spot the
# length of a fixed interval. (Beer: the audit that arrives on a timetable stops being an audit.)
#
#   mesh-audit              audit ONE randomly-chosen registered reflex (the S3* spot-check)
#   mesh-audit --all        audit every registered reflex (the reconciliation sweep)
#   mesh-audit <name>       audit a specific registered reflex by name
#   mesh-audit --list       print the audit registry
#   mesh-audit --test       smoke test (asserts a REAL organ read yields data — not just deps)
#
# orphan-ok: on-demand / would be wired as a JITTERED systemd timer, never a fixed cron stride —
#            the whole point is an unpredictable cadence, so the cron-orphan check must not flag it.
#            PROOF-OF-CONCEPT for the S3* channel (literature review 2026-07-10); one real auditor
#            (thermal), registry is the extension surface. See
#            ~/.mesh/knowledge/review-vsm-system3star-sporadic-audit-mesh-audit-2026-07-10.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="${MESH_DIR:-$HOME/.mesh}"

# ── the ORGAN auditors ─────────────────────────────────────────────────────────
# Each auditor re-derives ground truth from the raw organ and compares it to the reflex's
# last-EMITTED state. It prints one of:  OK <msg> | DIVERGE <msg> | NA <msg>  (NA = organ
# genuinely unreadable on this node → honest n/a, never a fake pass — mesh-land treats it as
# a pass, same contract as a sense's exit-2). Add a reflex by adding an audit_<name>() fn
# and a REGISTRY line.

# audit_therm — mesh-therm-watch emits bare HOT/OK to ~/.mesh/.therm-state (the consumer
# contract read by mesh-stress/mesh-health-state). Ground truth: read EVERY thermal zone in
# /sys/class/thermal directly and take the max. If the reflex says OK while a zone is truly
# hot, or says HOT while every zone is cool AND no recent throttle events justify it, the
# report has diverged from the floor.
audit_therm() {
  local state_f="$M/.therm-state" claimed maxc=-1 z t
  [ -r "$state_f" ] || { echo "NA (.therm-state absent — reflex never ran here)"; return 2; }
  claimed=$(tr -d '[:space:]' <"$state_f")
  local any=0
  for z in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$z" ] || continue; any=1
    t=$(cat "$z" 2>/dev/null); [[ "$t" =~ ^[0-9]+$ ]] || continue
    (( t > maxc )) && maxc=$t
  done
  [ "$any" = 1 ] && (( maxc >= 0 )) || { echo "NA (no readable thermal_zone*/temp — organ absent)"; return 2; }
  local maxdeg=$(( maxc / 1000 ))
  # HOT is legitimate on temp OR on recent CPU-throttle events (the reflex's second signal),
  # so we only DIVERGE on the clean, unambiguous mismatch — the direction that HIDES danger
  # (claims OK while a zone is genuinely hot) and the direction that erodes trust (claims HOT
  # while the floor is cold AND the throttle counter shows no recent action).
  #
  # CRITICAL: audit against the reflex's OWN decision boundary, never an independent one. If
  # our HOT threshold is stricter than mesh-therm-watch's (MESH_THERM_HOT, default 88°C, with
  # an HOT_N-read debounce), we'd scream DIVERGE at 80-87°C while the reflex is CORRECTLY OK
  # per its contract — the auditor itself would emit the wrong value, the exact hollow-report
  # failure it exists to catch. So: source the reflex's threshold and add a debounce margin
  # (it needs HOT_N consecutive reads to flip, so a single spike at HOT+ε is NOT yet a
  # divergence). DIVERGE on OK only when max zone is UNAMBIGUOUSLY past that (HOT + margin).
  local RHOT="${MESH_THERM_HOT:-88}" DEBOUNCE_MARGIN=5
  local HOT_C=$(( RHOT + DEBOUNCE_MARGIN ))   # OK-claim divergence needs max zone this hot
  local COLD_C=$(( RHOT - 20 ))               # HOT-claim divergence needs floor this cold (well below recover=HOT-5)
  local thr="$M/.therm-throttle-state" thr_recent=0
  if [ -r "$thr" ]; then
    # format: "<soft-count> <hard-count>"; any nonzero → throttle history exists
    read -r a b _ <"$thr" 2>/dev/null || true
    [[ "${a:-0}" =~ ^[0-9]+$ ]] && (( a > 0 )) && thr_recent=1
    [[ "${b:-0}" =~ ^[0-9]+$ ]] && (( b > 0 )) && thr_recent=1
  fi
  case "$claimed" in
    OK)
      (( maxdeg >= HOT_C )) && { echo "DIVERGE (reflex says OK but max zone ${maxdeg}C >= ${HOT_C}C — hidden heat)"; return 1; }
      echo "OK (claim=OK, max zone ${maxdeg}C consistent)"; return 0 ;;
    HOT)
      if (( maxdeg < COLD_C )) && [ "$thr_recent" = 0 ]; then
        echo "DIVERGE (reflex says HOT but max zone only ${maxdeg}C and throttle counter idle — stale/hollow claim)"; return 1
      fi
      echo "OK (claim=HOT, max zone ${maxdeg}C or throttle history justifies it)"; return 0 ;;
    *)
      echo "DIVERGE (.therm-state='$claimed' violates bare HOT/OK contract)"; return 1 ;;
  esac
}

# REGISTRY: name → auditor fn. Extend here as organs get audited.
REGISTRY=(
  "therm:audit_therm"
)

_names() { local e; for e in "${REGISTRY[@]}"; do echo "${e%%:*}"; done; }
_fn_for() { local e; for e in "${REGISTRY[@]}"; do [ "${e%%:*}" = "$1" ] && { echo "${e#*:}"; return 0; }; done; return 1; }

_run_one() {
  local name="$1" fn out rc
  fn=$(_fn_for "$name") || { echo "audit:$name UNKNOWN (not in registry)"; return 3; }
  out=$("$fn"); rc=$?
  case $rc in
    0) echo "audit:$name  OK       $out" ;;
    1) echo "audit:$name  DIVERGE  $out" ;;
    2) echo "audit:$name  n/a      $out" ;;
    *) echo "audit:$name  ERROR    $out" ;;
  esac
  return $rc
}

case "${1:-}" in
  --test)
    # Real-read gate (doctrine): the smoke test must assert the organ ACTUALLY produces data,
    # not merely that the classifier runs. We require at least one thermal zone to read a
    # parseable value here (this node has them); on a node with none, that is honest NA, not FAIL.
    got=0
    for z in /sys/class/thermal/thermal_zone*/temp; do
      t=$(cat "$z" 2>/dev/null); [[ "$t" =~ ^[0-9]+$ ]] && { got=1; break; }
    done
    if [ "$got" = 0 ]; then echo "smoke-test: ok (no thermal organ on this node — honest NA path)"; exit 0; fi
    out=$(audit_therm); rc=$?
    [ $rc -eq 2 ] && { echo "smoke-test: FAIL (organ readable but auditor returned NA: $out)"; exit 1; }
    echo "$out" | grep -qE 'zone [0-9]+C|max zone [0-9]+C' || { echo "smoke-test: FAIL (auditor produced no real temp read: $out)"; exit 1; }
    echo "smoke-test: ok (S3* thermal auditor performed a real organ read: $out)"; exit 0 ;;
  --list)
    echo "S3* audit registry:"; _names | sed 's/^/  /'; exit 0 ;;
  --all)
    rc=0; while read -r n; do _run_one "$n" || rc=1; done < <(_names); exit $rc ;;
  "")
    # THE S3* spot-check: pick ONE target at random (unannounced cadence is the caller's job —
    # a jittered timer — but the TARGET randomisation lives here so even a fixed caller can't
    # let a reflex learn "my audit slot is Tuesdays").
    mapfile -t all < <(_names)
    (( ${#all[@]} )) || { echo "audit: empty registry"; exit 0; }
    idx=$(( $(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ') % ${#all[@]} ))
    _run_one "${all[$idx]}"; exit $? ;;
  *)
    _run_one "$1"; exit $? ;;
esac
