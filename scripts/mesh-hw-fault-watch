#!/usr/bin/env bash
# mesh-hw-fault-watch — PERIPHERAL FAULT edge-watch: turn kernel device-fault lines into events.
#
# WHY (proven gap, discover 2026-07-02T13:47Z): the room went blind ~13h on a webcam USB drop
# because NOTHING edge-alerts device faults. mesh-heartbeat's dmesg alert set is the CRASH class
# (panic|oops|thermal|mce|oom|watchdog — mesh-heartbeat:107) and matches neither 'usb disconnect'
# nor 'uvcvideo ... Failed to resubmit video URB'; mesh-node-care greps usb faults but is an
# on-demand diagnostic bundle, never an edge alert. This is the FAULT side of the wired bus;
# mesh-usb-events is the enumerate side (a device can URB-fail while still enumerated).
#
#   mesh-hw-fault-watch           one delta pass: scan new dmesg lines, emit faults, advance offset
#   mesh-hw-fault-watch --status  last state reading, no new scan
#   mesh-hw-fault-watch --legs [leg...]  which fault legs can fire ON THIS NODE (INERT = aimed at
#                                 absent hardware). Naming legs restricts the report AND its cost:
#                                 the full run must prove the absent legs absent, which means one
#                                 whole-boot journal scan (~26s here); a module-backed leg is 0.01s.
#   mesh-hw-fault-watch --selfprobe [days]  SELF/OTHER: how much of the RADIO fault stream is co-incident
#                                 with this mesh's own scan reflexes (enrichment + phase-shift null p)
#   mesh-hw-fault-watch --test    fixture edge/no-replay/exclusion/BLIND/oom-pane-attribution + REAL-read gate
#
# Design constraints (each a logged mesh failure class):
#   - Offset = last-seen ISO timestamp (sudo -n dmesg --time-format=iso; dmesg_restrict=1 on this
#     node, NOPASSWD self-serve verified 2026-07-02) — lexically comparable, survives ring-buffer
#     rotation AND reboot (real-time clock, not boot-monotonic), unlike line-count offsets.
#   - FIRST RUN = baseline only, zero events — never replay the dmesg backlog as fresh faults
#     (32 historic uvcvideo URB fails live in dmesg NOW; the reviving-offset-reflex-replays trap).
#   - BLIND read (sudo/dmesg fails or empty) → exit 2, offset UNTOUCHED — a transient blind pass
#     must not skip-past or replay lines on recovery. Never a fake QUIET.
#   - EXCLUDES mesh-heartbeat's crash set (panic|oops|thermal|throttl|hardware error|mce|
#     watchdog) — that class is heartbeat's; no double-alert. OOM is a DELIBERATE EXCEPTION
#     (chat-review/oom-kill-no-edge-alert, 2026-07-05): mesh-heartbeat only reads dmesg's oom
#     lines at --rejoin (previous-boot crash forensics on RECONNECT); a mid-session mind-cull
#     (live: 10 kills observed 2026-07-04, zero reflex posts) had no owner at all. OOM lines are
#     now matched by FAULT_RE and grouped per VICTIM COMM (not per driver) so a repeatedly-killed
#     process debounces on its own name, same machinery as a chronic peripheral fault.
#   - SPEC DEVIATION (anti-noise): bare 'uvcvideo' would alert on normal enumeration ("Found UVC
#     device" on every replug — a healthy event mesh-usb-events already covers); only fault-shaped
#     uvcvideo lines (fail|error|URB|disconnect) alert here.
#   - Board post is per-DRIVER collapsed (one [hw-fault] line per driver per pass, ≤3/pass) +
#     env-gated (MESH_HW_FAULT_CHAT=0 silences; --test sandboxes) — 32 URB fails must not become
#     32 board lines. Full lines go to ~/.mesh/hw-fault.log.
#   - KNOWN-BENIGN LOG-ONLY routing (MESH_HW_FAULT_BENIGN, default 'uvcvideo…URB' + mesh-heavy-run's 32M
#     cap-PROBE OOM, see BENIGN_RE below): a fault line matching a confirmed-harmless signature is LOGGED in full (hw-fault.log stays
#     the complete record) + keeps STATE mtime-liveness, but is NEVER boarded. The uvcvideo URB-resubmit
#     churn (USB-autosuspend on the idle integrated camera) posted ~36/day, right at/above the 30-min
#     debounce so the flood-throttle barely caught it — the #1 alert-fatigue driver. This is a per-LINE
#     signature (NOT a per-driver mute): a real uvcvideo fault (disconnect/other error) still boards; only
#     the specific benign line is suppressed. Empty regex → everything boards as before (empty-guarded).
#   - CROSS-PASS same-driver DEBOUNCE (MESH_HW_FAULT_DEBOUNCE_MIN, default 30): a chronically-faulting
#     device (e.g. uvcvideo URB-failing every pass) must not re-post to the board every 5min. The 2nd+
#     board post for the same driver inside the window is suppressed (stdout marks it board-debounced);
#     LOG/STATE stay full, and a real new event after the window re-posts — flood throttled, not silenced.
#   - CROSS-DRIVER OVERFLOW summary: when >3 distinct drivers fault in ONE pass, only 3 board lines go
#     out (cap above) — a 4th "+N more driver(s)" line is appended so a multi-device storm (USB-controller
#     cascade) never silently undercounts on the board (chat-review/hw-fault-watch-driver-cap).
#   - OOM PANE ATTRIBUTION (oom-pane-attribution, discover 2026-07-06): an anonymous OOM board line
#     names the victim COMM but not WHOSE pane spawned it, so the offender can't be told to route via
#     mesh-heavy-run. The kernel scope uuid (task_memcg=…tmux-spawn-<uuid>.scope) + the pid ride the
#     'oom-kill:constraint=…' line — a DIFFERENT line from the boarded 'Killed process <pid> (comm)'
#     (health 03:59Z) — so we correlate by PID, resolve scope→'window.pane' via an append-only journal
#     ($MESH/.pane-scopes) refreshed every pass, and append 'pane=<w.p>' + a heavy-run nudge. The journal
#     (not a live-only scan) is load-bearing: a killed mind respawns with a NEW scope, so at alert time
#     the victim scope is often already gone — a prior pass's journal entry still attributes it. Honest
#     fallbacks: scope-known-but-un-journaled → unknown(respawned); no paired constraint line → unknown(no-scope).
#   - State written EVERY successful pass (mtime = liveness); line 1 token grammar for consumers:
#     FAULT | QUIET | BLIND.
#
# Exit codes: 0 = pass done (faults or quiet) · 2 = dmesg unreadable (honest BLIND, never fake)
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.hw-fault-state"
OFFSET="$STATE_DIR/.hw-fault-offset"
LOG="${MESH_HW_FAULT_LOG:-$STATE_DIR/hw-fault.log}"
CHAT="${MESH_HW_FAULT_CHAT:-1}"
SRC="${MESH_HW_FAULT_SRC:-}"          # test fixture: a file in '<iso-ts> message' shape
DEBOUNCE="$STATE_DIR/.hw-fault-debounce"          # per-driver last-BOARD-post epoch (cross-pass flood guard)
DEBOUNCE_MIN="${MESH_HW_FAULT_DEBOUNCE_MIN:-30}"  # suppress a repeat BOARD post for the SAME driver within N min
# ── RE-ENTRY (self-reference vs other-reference) — see the block above probe_annot() ──
CRONSRC="${MESH_HW_FAULT_CRONSRC:-}"              # non-empty = read the schedule from THIS file ONLY (test/audit)
PROBE_WIN="${MESH_HW_FAULT_PROBE_WIN:-30}"        # s after a reflex's start second in which it is plausibly in flight
SHIFT_STEP="${MESH_HW_FAULT_SHIFT_STEP:-7}"      # --selfprobe null resolution: 3600/step shifts (test uses a coarse step to stay under mesh-autowire's 30s --test gate)
# The radio-touching reflexes: each drives THIS node's sole-uplink combo chip (scan / BLE inquiry / link poke).
# Trailing '( |$)' is load-bearing: without it 'mesh-presence' also matches mesh-presence-density /
# mesh-presence-fuse, which read state files and never touch the radio — a self-attribution that named
# the wrong operation would be worse than none.
RADIO_TOOL_RE='(mesh-(wifiscan|wifi-rf|wifi-mimo|wifi-quality|wifi-link|wifi-crossval|wifi-motion|presence|bt-link|bt-census|ble-proximity|proximity|imac-wifi|link-heal|usb-port|uplink-usb))( |$)'
RADIO_DRV_RE='^(rtw_?[0-9a-z]*|iwlwifi|ath[0-9]*k?|mt76[0-9a-z_]*|brcmfmac|rtl[0-9a-z_]*|hci[0-9]+)$'
RADIO_SCHED=""                                    # per-run cache: crontab is read at most once per pass
# KNOWN-BENIGN signatures: fault lines matching this regex are LOGGED (full record) but NEVER boarded —
# they are confirmed-harmless churn (the uvcvideo USB-autosuspend URB-resubmit fail on the idle integrated
# camera, ~36/day, was the #1 hw-fault alert-fatigue driver). Operator/health extend it as faults are
# classified benign; empty = route everything to the board as before (see the empty-guard in pass()).
# 2nd clause — mesh-heavy-run's cap-PROBE OOMs (hw-fault-oom-libels-heavyrun-capprobe, 2026-07-17;
# knowledge capability-hwfault-boards-heavyrun-capprobe-oom-as-fault). mem_cap_available proves the
# cgroup ceiling BINDS by being killed by it, and --test's enforcement assertion requires rc=137 too,
# so both mint a real kernel OOM line by design and both used to board as a peripheral hw-fault with a
# nonsensical 'route heavy jobs via mesh-heavy-run' nudge (the victim IS heavy-run). Still LOGGED —
# the OOM did happen — just not alarmed.
#
# HOW THEY ARE RECOGNISED IS THE WHOLE HISTORY OF THIS CLAUSE. It was a VICTIM-RSS BAND: 32M for the
# probe, then a second band at 64M for the --test hog, then a third at ~2.5G for mesh-room-music's
# admission-capped grind (which mesh-room-music ALREADY self-diagnoses as skip:oom). Three widenings
# is the tell. chat-review/oom-benign-filter-keys-on-rss-size-not-on-constraint (2026-08-15) named the
# defect in the abstract — the property every band MEANS is "a cgroup CAP was enforced", never "real
# exhaustion", and size only correlates — and won a real narrowing: each clause was made to REQUIRE
# the kernel's own honest key, the 'Memory cgroup out of memory:' prefix that out_of_memory() picks
# from is_memcg_oom(), which is ON the boarded line (live census, 30d/609 kills: 607 memcg-prefixed →
# CONSTRAINT_MEMCG, 2 plain → CONSTRAINT_NONE). But the bands were KEPT as secondary narrowing, and
# the predicted harm then happened: the ~2.5G band matched the REAL 2026-08-22T13:33:14Z kill exactly
# (python, anon-rss:2551900kB), so a real cap-kill of a real job went silent. See the identity note at
# BENIGN_RE below for the fix — the probes now sign themselves at the source and no size term remains.
# --test capprobe-libel / real-oom-still-boards / global-oom-in-benign-band-still-boards gate it,
# RED-first.
# IDENTITY, NOT SIZE (2026-08-22, task capcheck-mints-the-oom-line-a-real-detector-reads). The three
# clauses below used to be RSS BANDS on (python3)/(python), and a band is a proxy for identity that
# fails in the direction that matters: the 2.4-2.5G clause matched the REAL 2026-08-22T13:33:14Z kill
# (python, anon-rss:2551900kB — the grind dying at its own declared mesh-heavy-run ceiling) exactly as
# it matched the probe it was written for, so a real kill went silent. Verified by feeding that live
# journal line through the old regex: 1 match. The bands had already been widened three times (32M,
# 64M, 2.5G), which is the tell — a-redaction-placeholder-used-as-a-key / a-guard-wider-than-its-
# readers-grammar. mesh-heavy-run now SIGNS its two probe minters at the source (comm mesh-capcheck
# for mem_cap_available's bind probe, mesh-caphog for the --test over-budget hog), so the filter keys
# on WHO was killed and carries no size term at all. Consequence, deliberate: a real cap-kill of a
# real job (the grind) now BOARDS. It is a real event with a real owner (mesh-sound-reflex renders it
# skip:oom), and "noisy, honest" is this file's own stated failure direction — silencing it by size is
# what this fix removes. A probe that ever fails to sign itself (symlink unmakeable) also boards.
BENIGN_RE="${MESH_HW_FAULT_BENIGN-uvcvideo.*Failed to resubmit video URB|Memory cgroup out of memory: Killed process [0-9]+ \((mesh-capcheck|mesh-caphog)\)}"  # '-' not ':-': explicit empty = disable the filter (board all)
PANE_SCOPES="$STATE_DIR/.pane-scopes"             # append-only scope→window.pane journal (OOM attribution; prune >7d)

# fault classes (case-insensitive). uvcvideo deliberately narrowed — see SPEC DEVIATION above.
#
# rtw88 leg (discover 2026-08-15 `rtw88-fault-leg`, health-verified behaviourally the same day).
# THE LEG THAT NAMES ABSENT HARDWARE IS NOT A LEG: the wireless clause was 'iwlwifi.*(…)' and this
# node has ZERO iwlwifi — 0 modules loaded, 0 journal lines — while its SOLE network path is
# rtw88_8822bu (wlxbcec43434a22). Health's decisive test: piping the boot's 229 prio-4 rtw lines
# through this very regex boarded ZERO. So the wireless leg read GREEN for 22h47m while ~230 real
# firmware faults (~10/h, still accruing: 118/68/40 at discover, 119/69/41 twenty minutes later)
# passed under it. Same shape as the never-wired-reflex trap — a clause that CANNOT match is
# indistinguishable from a quiet one. iwlwifi is KEPT (not deleted blind: the IdeaPad genuinely
# carries it), and `--legs` now reports which legs are INERT on THIS node so an aimed-at-nothing
# clause is visible instead of silently green. Live signature census on this boot (4, incl. the
# rarer p3 'coex request time out' health caught mis-counted as p3=0 in the original find):
#   124x failed to get tx report from firmware · 70x timed out to flush queue N
#    41x firmware failed to leave lps state    ·  1x coex request time out
# The two benign rtw lines ('Firmware version …', 'renamed from wlan0') carry no fail/error/timeout
# token and are rejected by construction — asserted in --test, not assumed.
# Cite: knowledge/capability-rtw88-lps-firmware-stall-named-mechanism-20260716.md
# 'crash' added to the radio alphabet 2026-08-21 (health, devcoredump verify). The radio clause
# read (fail|error|timed out|time out) and 'crash' was NOT in it, so rtw88's DUMP-PATH lines —
# 'firmware crash, start reset and recover' and 'Firmware Coredump Nth' — went unmatched while
# 'dump fw fifo fail' matched. That inverted this view relative to the EVIDENCE: it paged exactly
# when the firmware dump could NOT be taken, and stayed silent for the one case where a dump WAS
# taken and sits readable in /sys/class/devcoredump for 300s before the kernel deletes it (300000
# jiffies @ CONFIG_HZ=1000, read out of this kernel's own dev_coredumpm, not an upstream #define).
# Cost of the widening is measured, not assumed: 0 such lines across all 5 retained boots
# (2026-08-17..21, _TRANSPORT=kernel) against a 423-line rtw_8822bu control in the same window.
# Cite: knowledge/verify-devcoredump-fault-evidence-channel-mesh-home-20260821.md
FAULT_RE='usb [0-9.-]+.*(disconnect|reset)|uvcvideo.*(fail|error|urb|disconnect)|video urb|iwlwifi.*(fail|error|beacon)|rtw_?[0-9a-z]+.*(fail|error|timed out|time out|\bcrash)|hci[0-9].*error|i915.*(\bhang|reset)|nvrm: xid \(|ata[0-9.]*(\.[0-9]+)?:.*(error|fail)|nvme.*(error|reset)|out of memory:.*killed process [0-9]+ \('
# heartbeat's crash set (mesh-heartbeat:107) — owned there, never double-alerted here.
# 'out of memory' deliberately NOT excluded (chat-review/oom-kill-no-edge-alert, 2026-07-05):
# heartbeat only sees it at --rejoin, so it needs a LIVE owner and this is the only edge-watch
# already wired */5 with the offset/debounce/collapse machinery a live OOM alert needs.
EXCL_RE='panic|oops|thermal|throttl|hardware error|\bmce\b|watchdog'

read_dmesg(){ # full source in '<iso-ts> message' lines; rc!=0 or empty = BLIND
  if [ -n "$SRC" ]; then cat "$SRC" 2>/dev/null
  else sudo -n dmesg --time-format=iso 2>/dev/null
  fi
}

board_debounced(){ # $1=driver → exit 0 (true) if the SAME driver hit the board within DEBOUNCE_MIN
  # (suppress THIS pass's board post — a chronic fault must not re-post every 5min); exit 1 (false)
  # if OK to post now, recording this post's epoch. GENTLE by design: full lines still hit LOG/STATE
  # (PASS_NEW honest), and a genuinely new event >DEBOUNCE_MIN later re-posts — so a slow-escalating
  # fault is not silenced forever, only the flood is throttled.
  local d="$1" now last
  now="$(date +%s)"
  last="$(awk -F'\t' -v d="$d" '$1==d{print $2}' "$DEBOUNCE" 2>/dev/null | tail -1)"
  if printf '%s' "$last" | grep -qE '^[0-9]+$' && [ $(( now - last )) -lt $(( DEBOUNCE_MIN * 60 )) ]; then
    return 0   # within window → debounced
  fi
  mkdir -p "$STATE_DIR"
  { awk -F'\t' -v d="$d" '$1!=d' "$DEBOUNCE" 2>/dev/null; printf '%s\t%s\n' "$d" "$now"; } > "$DEBOUNCE.tmp" 2>/dev/null \
    && mv "$DEBOUNCE.tmp" "$DEBOUNCE" 2>/dev/null || true
  return 1     # OK to post; epoch recorded
}

# ── OOM pane attribution (oom-pane-attribution, discover 2026-07-06; health-verified 03:59Z) ──
# An anonymous 'Out of memory: Killed process <pid> (python)' names the victim COMM but not WHOSE
# pane spawned it, so the offender can't be told to route via mesh-heavy-run. The kernel already
# carries the answer — but on a DIFFERENT line: 'oom-kill:constraint=…,task_memcg=…/tmux-spawn-<uuid>.scope,
# …,pid=<pid>'. We correlate the two by PID (the join key on both), map the scope uuid → 'window.pane'
# via an append-only journal refreshed every pass, and append 'pane=<w.p>' + a heavy-run nudge to the
# board line. The journal (not just a live scan) is essential: a killed mind respawns with a NEW scope,
# so at alert time the victim scope is often already gone — the journal remembers it from a prior pass.
refresh_pane_scopes(){ # record every LIVE pane's scope→window.pane (append-only, dedup on scope, prune >7d)
  [ -n "${MESH_TEST_SANDBOX:-}" ] && return 0        # test seeds the journal directly; never scan real panes
  command -v tmux >/dev/null 2>&1 || return 0
  local sess now scope wp pid
  sess="$(hostname)"; now="$(date +%s)"; mkdir -p "$STATE_DIR"
  tmux list-panes -s -t "$sess" -F '#{window_name}.#{pane_index} #{pane_pid}' 2>/dev/null | while read -r wp pid; do
    [ -n "${pid:-}" ] || continue
    scope="$(grep -oE 'tmux-spawn-[0-9a-f-]+\.scope' "/proc/$pid/cgroup" 2>/dev/null | head -1)"
    [ -n "$scope" ] || continue
    # append-only, dedup on scope (a scope uuid is unique to one pane-process, never remaps a window);
    # a long-lived pane pruned by age self-heals — re-added here (grep-miss) with a fresh epoch next pass.
    grep -qF "$scope"$'\t' "$PANE_SCOPES" 2>/dev/null || printf '%s\t%s\t%s\n' "$scope" "$wp" "$now" >> "$PANE_SCOPES"
  done
  [ -f "$PANE_SCOPES" ] && { awk -F'\t' -v cut="$(( now - 7*86400 ))" '($3+0)>=cut' "$PANE_SCOPES" > "$PANE_SCOPES.tmp" 2>/dev/null \
    && mv "$PANE_SCOPES.tmp" "$PANE_SCOPES" 2>/dev/null; } || true
}
scope_for_pid(){ printf '%s\n' "${OOM_PIDSCOPE:-}" | awk -F'\t' -v p="$1" '$1==p{print $2}' | tail -1; }
pane_for_scope(){ awk -F'\t' -v s="$1" '$1==s{print $2}' "$PANE_SCOPES" 2>/dev/null | tail -1; }
oom_attribution(){ # $1 = 'Out of memory: Killed process <pid> (comm)' line → ' pane=<w.p|unknown(...)> [route …]'
  local pid scope pane
  pid="$(printf '%s' "$1" | grep -oE 'Killed process [0-9]+' | grep -oE '[0-9]+' | head -1)"
  scope="$(scope_for_pid "$pid")"
  if [ -n "$scope" ]; then
    pane="$(pane_for_scope "$scope")"; [ -n "$pane" ] || pane="unknown(respawned)"  # scope known but not journaled → respawned
  else
    pane="unknown(no-scope)"                                                          # no oom-kill constraint line paired
  fi
  printf ' pane=%s [route heavy jobs via mesh-heavy-run]' "$pane"
}

# ── RE-ENTRY: was this radio fault CO-INCIDENT with one of the mesh's OWN probes? ────────────────
# (literature/autopoiesis-reentry-selfreference-hw-fault-watch-2026-08-17.md — Zönnchen, Dzhimova &
# Socher 2025, Front. Commun. 10:1585321: a system that never reintroduces the system/environment
# distinction into its own operations cannot tell self-reference from other-reference, and reads what
# it did to itself as something the world did to it.)
#
# This tool already re-enters for ONE fault class: an OOM line gets `pane=<w.p>` — the kernel event is
# attributed back to the mesh's own mind that caused it (oom_attribution above). The PERIPHERAL class
# had no such cut, so every rtw firmware fault boarded as an environment-side event ("the dongle is
# faulting") on a node whose OWN reflexes drive that same radio every few minutes. Measured on this
# node's hw-fault.log (2026-08-15..17, 38333 rtw lines → 337 events de-bursted ≥60s): faults are
# 6.65x enriched in the 30s after `mesh-wifiscan` starts (33.2% of events in 5.0% of wallclock;
# phase-shift null over 599 one-second shifts, p=0.0067), while the same-geometry control minute
# (m%10==3) sits at 0.80x, p=0.455, and mesh-wifi-rf's OWN minutes (m%10==1, disjoint from wifiscan's)
# sit at 0.50x. Re-derive with `--selfprobe`; never quote the figure, it moves with the corpus.
#
# THE CUT COMES FROM THE SCHEDULE, NOT FROM THE JOURNAL. cron's own record looks joinable and is not:
# `CMD` lines and `session closed` lines carry DIFFERENT pids (317890 CMD vs 317226 closes over 14d,
# only 11810 pid-pairable and every one of those >600s, median 4.8 DAYS — pid reuse pairing a start to
# a stranger's close). A first cut built that way reported "a radio probe was in flight for 99.83% of
# wallclock", which is refuted by `pgrep` returning zero radio tools at an arbitrary moment. The
# crontab, by contrast, is exact, free, and needs no privilege: it says which minute-of-hour each
# reflex STARTS, and every mesh reflex starts at second ~01.
#
# `probe=` IS A CO-INCIDENCE, NEVER A CAUSE (reproduction-is-not-causation). It says only: at the
# second this fault was logged, one of our own radio reflexes was scheduled and plausibly still in
# flight. Deciding causation needs the intervention the mesh has never run — a radio-QUIET window with
# the scan reflexes paused, compared against an equal control window.
read_cron(){ # the ENACTED schedule (crontab), not the declared file; CRONSRC overrides EXCLUSIVELY
  if [ -n "$CRONSRC" ]; then cat "$CRONSRC" 2>/dev/null            # no crontab fallback: a test that
  else crontab -l 2>/dev/null                                      # silently read the live schedule
  fi                                                               # would assert nothing
}
radio_schedule(){ # → 'tool<TAB>m1,m2,…' per radio-touching cron line; empty = unknown, never "none"
  read_cron | awk -v re="$RADIO_TOOL_RE" '
    function expand(f,  i,n,parts,p,step,lo,hi,out,m,rng,se) {
      out=""; n=split(f, parts, ",")
      for (i=1;i<=n;i++) {
        p=parts[i]; step=1
        se=index(p,"/"); if (se) { step=substr(p,se+1)+0; p=substr(p,1,se-1); if (step<1) step=1 }
        if (p=="*") { lo=0; hi=59 }
        else if (index(p,"-")) { split(p,rng,"-"); lo=rng[1]+0; hi=rng[2]+0 }
        else { lo=p+0; hi=lo }
        if (lo<0) lo=0; if (hi>59) hi=59
        for (m=lo;m<=hi;m+=step) out = out (out==""?"":",") m
      }
      return out
    }
    /^[[:space:]]*#/ { next }
    NF < 6           { next }
    match($0, re) {
      t = substr($0, RSTART, RLENGTH); sub(/ $/, "", t)
      print t "\t" expand($1)
    }'
}
probe_annot(){ # $1 = the fault line's ISO ts → ' probe=self:<tool>+<n>s' | ' probe=none' | ' probe=na(<why>)'
  local ts min sec hits
  ts="$1"
  case "$ts" in *T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]*) : ;; *) printf ' probe=na(unparseable-ts)'; return 0 ;; esac
  min="${ts#*T}"; min="${min#*:}"; min="${min%%:*}"
  sec="${ts#*T}"; sec="${sec#*:}"; sec="${sec#*:}"; sec="${sec%%[,.+-]*}"
  [ -n "$RADIO_SCHED" ] || RADIO_SCHED="$(radio_schedule 2>/dev/null)"
  [ -n "$RADIO_SCHED" ] || { printf ' probe=na(no-schedule)'; return 0; }
  hits="$(printf '%s\n' "$RADIO_SCHED" | awk -F'\t' -v m="$((10#$min))" -v s="$((10#$sec))" -v w="$PROBE_WIN" '
      s >= w { exit }
      { n=split($2, mm, ","); for (i=1;i<=n;i++) if (mm[i]+0 == m) { print $1; break } }' \
      | sort -u | head -2 | paste -sd, -)"
  if [ -n "$hits" ]; then printf ' probe=self:%s+%ss' "$hits" "$((10#$sec))"
  else printf ' probe=none'; fi
}
selfprobe_report(){ # $1 = days back (default 7) — SECOND-ORDER: how much of what this tool boards is our own doing
  local days sched tmp rc
  days="${1:-7}"
  case "$days" in ''|*[!0-9]*) echo "usage: mesh-hw-fault-watch --selfprobe [days]"; return 2 ;; esac
  [ -r "$LOG" ] || { echo "selfprobe: na — no fault log at $LOG"; return 2; }
  sched="$(radio_schedule 2>/dev/null)"
  [ -n "$sched" ] || { echo "selfprobe: na — no schedule readable (crontab -l empty/unreadable)"; return 2; }
  tmp="$(mktemp)" || return 2
  printf '%s\n' "$sched" > "$tmp"
  awk -F'\t' -v DRV="$RADIO_DRV_RE" -v WIN="$PROBE_WIN" -v STEP="$SHIFT_STEP" -v DAYS="$days" -v NOW="$(date -u +%s)" '
    function dfc(y,m,d,  era,yoe,doy,doe) {   # days from civil (Howard Hinnant) — no gawk mktime dep
      y -= (m <= 2); era = int((y >= 0 ? y : y-399)/400); yoe = y - era*400
      doy = int((153*(m + (m > 2 ? -3 : 9)) + 2)/5) + d - 1
      doe = yoe*365 + int(yoe/4) - int(yoe/100) + doy
      return era*146097 + doe - 719468
    }
    NR==FNR { T++; tool[T]=$1; mins[T]=$2; next }
    {
      # FS is TAB (for the schedule file above), so the log line must be split on whitespace here —
      # $2 under a tab FS is the whole rest of the line and would match no driver at all.
      split($0, fld, /[ \t]+/); ts=fld[1]; drv=fld[2]; sub(/:$/,"",drv)
      if (drv !~ DRV) next
      if (ts !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/) next
      e = dfc(substr(ts,1,4)+0, substr(ts,6,2)+0, substr(ts,9,2)+0)*86400 \
          + substr(ts,12,2)*3600 + substr(ts,15,2)*60 + substr(ts,18,2)
      if (e < NOW - DAYS*86400) next
      if (n > 0 && e - last < 60) next           # de-burst: one EVENT per 60s, never per line
      last = e; ev[++n] = e
      if (n == 1) first = e
      lastev = e
    }
    # phase statistic over the CURRENT set cur[] → R_obs / R_med / R_p (globals; awk has no array return)
    function phase_stat(  sh,c,i,u,ns,ge,v,j) {
      ns = 0; R_obs = 0
      for (sh = 0; sh < 3600; sh += STEP) {       # shift 0 = observed; the rest walk every phase
        c = 0
        for (i=1; i<=n; i++) {
          u = (ev[i] + sh) % 3600
          if (((u % 60) < WIN) && (int(u/60) in cur)) c++
        }
        if (sh == 0) R_obs = c/n; else { ns++; nullv[ns] = c/n }
      }
      ge = 1
      for (i=1; i<=ns; i++) if (nullv[i] >= R_obs) ge++
      for (i=1; i<=ns; i++) srt[i] = nullv[i]
      for (i=2; i<=ns; i++) { v=srt[i]; j=i-1; while (j>0 && srt[j]>v) { srt[j+1]=srt[j]; j-- } srt[j+1]=v }
      R_med = srt[int(ns/2)+1]
      R_p   = ge/(ns+1)
      R_ns  = ns
    }
    END {
      if (n < 10) { printf "selfprobe: na — only %d radio fault event(s) in %d day(s); too few to phase-test\n", n+0, DAYS; exit 2 }
      # OVERLAPPING SCHEDULES INHERIT EACH OTHER'"'"'S ENRICHMENT and no per-tool column can undo that on
      # its own: mesh-wifi-rf fires on m%5==1, a strict SUPERSET of mesh-wifiscan'"'"'s m%10==6, and
      # mesh-link-heal fires EVERY minute — an "exclusive minutes" column is empty for everyone the
      # moment one tool covers the clock. So: rank once, then re-run the SAME statistic for every other
      # tool on its minutes MINUS THE LEADER'"'"'S. A tool that keeps its enrichment there is implicated on
      # its own; one that collapses to ~1x was only borrowing the leader'"'"'s minutes. Set ⊆ leader → na.
      for (t=1; t<=T; t++) {
        split(mins[t], mm, ","); nm = 0
        for (i in cur) delete cur[i]
        for (i=1; i<=length(mm); i++) if (mm[i] != "") cur[mm[i]+0] = 1
        for (i in cur) nm++
        fbase[t] = nm * WIN / 3600.0
        phase_stat()
        fobs[t] = R_obs; fmed[t] = R_med; fp[t] = R_p
        fen[t]  = (fbase[t] > 0 ? R_obs/fbase[t] : 0)
        if (fen[t] > bestv) { bestv = fen[t]; lead = t }
      }
      split(mins[lead], lm, ",")
      for (i=1; i<=length(lm); i++) if (lm[i] != "") ldr[lm[i]+0] = 1
      printf "=== mesh-hw-fault-watch --selfprobe — radio faults vs the mesh'"'"'s OWN scan schedule ===\n"
      printf "window %d day(s) · %d event(s) (de-bursted >=60s) · in-flight window %ds after each start\n\n", DAYS, n, WIN
      printf "%-20s %6s %6s %7s %7s %7s   %s\n", "tool", "base", "obs", "enrich", "nullmd", "p",
             "minus " tool[lead] " minutes"
      for (t=1; t<=T; t++) {
        line = sprintf("%-20s %5.1f%% %5.1f%% %6.2fx %6.1f%% %7.4f", tool[t], fbase[t]*100, fobs[t]*100,
                       fen[t], fmed[t]*100, fp[t])
        if (t == lead) { printf "%s   <- LEAD (ranked on enrich)\n", line; continue }
        split(mins[t], mm, ","); nx = 0
        for (i in cur) delete cur[i]
        for (i=1; i<=length(mm); i++) if (mm[i] != "" && !((mm[i]+0) in ldr)) { cur[mm[i]+0] = 1 }
        for (i in cur) nx++
        if (nx == 0) { printf "%s   na (schedule is a subset of the lead'"'"'s)\n", line; continue }
        xbase = nx * WIN / 3600.0
        phase_stat()
        printf "%s   %5.2fx p=%.4f (%d min/h)\n", line, (xbase > 0 ? R_obs/xbase : 0), R_p, nx
      }
      printf "\nCO-INCIDENCE, NOT CAUSE: enrichment says our probe was scheduled when the chip faulted,\n"
      printf "not that it caused the fault — settling that needs the intervention nobody has run yet\n"
      printf "(pause the implicated reflex for a window, compare against an equal control window).\n"
      printf "p is a phase-shift null (%d shifts, step %ds) — it carries the log'"'"'s own burstiness along,\n", R_ns, STEP
      printf "so an hour-clustered storm cannot manufacture it.\n"
    }' "$tmp" "$LOG"
  rc=$?
  rm -f "$tmp"
  return $rc
}

pass(){ # one delta pass; echoes fault summary lines; sets PASS_TOKEN/PASS_NEW
  local all last new faults boardable ts groups ndrv over
  PASS_BENIGN=0
  all="$(read_dmesg)" || all=""
  [ -n "$all" ] || return 2
  ts="$(printf '%s\n' "$all" | tail -1 | awk '{print $1}')"
  printf '%s' "$ts" | grep -qE '^[0-9]{4}-' || return 2   # hollow read: not ISO-shaped
  last="$(cat "$OFFSET" 2>/dev/null || true)"
  mkdir -p "$STATE_DIR"
  if [ -z "$last" ]; then
    # first run: baseline the offset, replay NOTHING
    printf '%s\n' "$ts" > "$OFFSET"
    PASS_TOKEN=QUIET; PASS_NEW=0
    return 0
  fi
  new="$(printf '%s\n' "$all" | awk -v last="$last" '$1 > last')"
  faults="$(printf '%s\n' "$new" | grep -iE "$FAULT_RE" | grep -ivE "$EXCL_RE" || true)"
  printf '%s\n' "$ts" > "$OFFSET"
  if [ -z "$faults" ]; then PASS_TOKEN=QUIET; PASS_NEW=0; return 0; fi
  # LOG the complete record FIRST (benign + boardable both land here); hw-fault.log never loses a line.
  printf '%s\n' "$faults" >> "$LOG"
  # KNOWN-BENIGN routing: drop confirmed-harmless signatures from the board set (per-LINE, not per-driver).
  # Empty-guard: an empty BENIGN_RE would make `grep -ivE ""` match all lines → invert to nothing →
  # silence EVERY fault, so treat empty as "no benign filter" and board everything.
  if [ -n "$BENIGN_RE" ]; then
    boardable="$(printf '%s\n' "$faults" | grep -ivE "$BENIGN_RE" || true)"
    PASS_BENIGN="$(printf '%s\n' "$faults" | grep -icE "$BENIGN_RE")"
  else
    boardable="$faults"
  fi
  if [ -z "$boardable" ]; then
    # every fault this pass is a known-benign signature → logged + mtime-live, but no board alert
    PASS_TOKEN=QUIET; PASS_NEW=0; return 0
  fi
  PASS_NEW="$(printf '%s\n' "$boardable" | wc -l)"
  PASS_TOKEN=FAULT
  # oom-pane-attribution: build pid→scope from THIS pass's new lines. The scope uuid + pid ride the
  # kernel 'oom-kill:constraint=…,task_memcg=…tmux-spawn-<uuid>.scope,…,pid=<pid>' line — NOT the
  # 'Out of memory: Killed process <pid> (comm)' line we board — so we correlate by pid (health 03:59Z).
  OOM_PIDSCOPE="$(printf '%s\n' "$new" | awk '
    /oom-kill:.*tmux-spawn-/ {
      s=""; p=""
      if (match($0, /tmux-spawn-[0-9a-f-]+\.scope/)) s=substr($0, RSTART, RLENGTH)
      if (match($0, /pid=[0-9]+/))                   p=substr($0, RSTART+4, RLENGTH-4)
      if (s!="" && p!="") print p"\t"s
    }')"
  # collapse per driver (first word after the timestamp, colon-stripped) — an OOM line collapses
  # per VICTIM COMM instead (chat-review/oom-kill-no-edge-alert): $2 there is just "Out"/"Memory",
  # not a useful group key, and the whole point is naming WHICH process got killed + how many times.
  groups="$(printf '%s\n' "$boardable" | awk '{
    d=$2; sub(/:$/,"",d)
    if (tolower($0) ~ /out of memory:.*killed process [0-9]+ \(/) {
      if (match($0, /\([^)]*\)/)) {
        v = substr($0, RSTART+1, RLENGTH-2)
        gsub(/[^A-Za-z0-9._-]/, "_", v)
        d = "oom-" v
      }
    }
    # NVRM Xid (dGPU hardware fault): group per Xid NUMBER, not per-driver — a repeated same-fault
    # (e.g. row-remap 63) collapses per-fault while a distinct engine exception (13) boards fresh.
    # dbkey defaults to $drv (=xid-<N>) so different Xids debounce independently. Same family as OOM
    # per-victim grouping. The number rides "Xid (PCI:....): <N>," — extract the trailing digits.
    else if (match($0, /[Xx]id \([^)]*\): [0-9]+/)) {
      s = substr($0, RSTART, RLENGTH)
      if (match(s, /[0-9]+$/)) d = "xid-" substr(s, RSTART, RLENGTH)
    }
    # rtw88 (USB wireless firmware): group per SIGNATURE TEXT, not per driver. Per-driver is the
    # wrong key here and the rate is why: ONE driver emits three distinct firmware faults at
    # 124/70/41 per boot, so a single rtw_8822bu bucket boards whichever fires first and hides the
    # other two behind its debounce for DEBOUNCE_MIN — the operator learns "wireless is faulting"
    # instead of WHICH firmware path is. Digits collapse to N so "flush queue 3" and "flush queue 5"
    # are ONE signature (else every queue index mints a fresh key and the debounce never binds —
    # the flood this tool exists to throttle). Same family as xid-<N> and oom-<victim>: the key is
    # whatever distinguishes one fault from another. Truncated to 40 chars: two signatures sharing a
    # 40-char prefix would merge buckets (throttled together, still both in LOG/STATE) — bounded and
    # visible, unlike an unbounded key in a board line.
    else if (match($0, / rtw_?[0-9a-z]+ [0-9-]+:[0-9.]+:? */)) {
      s = tolower(substr($0, RSTART + RLENGTH))
      # N is inserted AFTER tolower(), so it must survive the punctuation squeeze — a class of
      # [^a-z0-9] would eat the very placeholder that makes the signature stable across indices.
      gsub(/[0-9]+/, "N", s); gsub(/[^a-z0-9N]+/, "-", s); sub(/-+$/, "", s)
      if (s != "") d = "rtw-" substr(s, 1, 40)
    }
    n[d]++; l[d]=$0
  } END{for(d in n) printf "%s\t%d\t%s\n", d, n[d], l[d]}')"
  ndrv="$(printf '%s\n' "$groups" | grep -c .)"
  # ≤3 board lines per pass; a same-driver flood is debounced across passes (both LOG/STATE stay full).
  printf '%s\n' "$groups" | head -3 | while IFS=$'\t' read -r drv cnt sample; do
    [ -n "$drv" ] || continue
    ev="$(printf '%s' "$sample" | cut -d' ' -f2- | head -c 160)"
    # DEBOUNCE KEY vs DISPLAY KEY (chat-review/oom-debounce-class-key): every OOM victim shares ONE
    # 'oom' class debounce bucket, so an OOM storm (many distinct victim COMMs within the window)
    # boards ONCE, not per-victim — the flood this tool exists to throttle. $drv keeps the victim, so
    # the LINE TEXT still names WHO was killed; only the debounce grouping is the class. Non-OOM
    # drivers debounce per-driver as before.
    # oom lines gain 'pane=<w.p>' attribution + a heavy-run nudge (both board branches carry it).
    # RADIO drivers additionally carry ' probe=' — the self/other cut (see the re-entry block above).
    # Scoped to drivers whose silicon THIS mesh drives on a schedule; a probe= on an nvme/uvcvideo line
    # would name an operation that cannot touch it, which is a fabricated attribution, not a cautious one.
    case "$drv" in
      oom-*) dbkey=oom; attrib="$(oom_attribution "$sample")" ;;
      *) dbkey="$drv"; attrib=""
         drvtok="$(printf '%s' "$sample" | awk '{d=$2; sub(/:$/,"",d); print d}')"
         printf '%s' "$drvtok" | grep -qE "$RADIO_DRV_RE" \
           && attrib="$(probe_annot "$(printf '%s' "$sample" | awk '{print $1}')")" ;;
    esac
    if board_debounced "$dbkey"; then
      echo "[hw-fault] $drv: $ev (x$cnt new, board-debounced <${DEBOUNCE_MIN}m)$attrib"
    else
      echo "[hw-fault] $drv: $ev (x$cnt new)$attrib"
      if [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
        MESH_WHO="hw-fault-watch@$(hostname)" mesh-chat "[hw-fault] $drv: $ev (x$cnt new)$attrib — peripheral fault on $(hostname), full lines in ~/.mesh/hw-fault.log" >/dev/null 2>&1 || true
      fi
    fi
  done
  # cross-driver overflow: >3 distinct drivers faulted this pass but only 3 board lines went out —
  # never silently undercount a multi-device storm (the exact failure class this tool exists to catch).
  if [ "${ndrv:-0}" -gt 3 ]; then
    over=$(( ndrv - 3 ))
    # respect the debounce (chat-review/oom-debounce-class-key): a persistent multi-device storm must
    # not re-post the "+N more" summary every pass — debounce it under its own '+overflow' bucket.
    if board_debounced "+overflow"; then
      echo "[hw-fault] +$over more driver(s) faulted this pass (board-debounced <${DEBOUNCE_MIN}m), see ~/.mesh/hw-fault.log"
    else
      echo "[hw-fault] +$over more driver(s) faulted this pass, see ~/.mesh/hw-fault.log"
      if [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
        MESH_WHO="hw-fault-watch@$(hostname)" mesh-chat "[hw-fault] +$over more driver(s) faulted this pass on $(hostname) (board caps at 3/pass), full lines in ~/.mesh/hw-fault.log" >/dev/null 2>&1 || true
      fi
    fi
  fi
  return 0
}

write_state(){ printf '%s %s new=%s\n' "$1" "$(date -u +%FT%TZ)" "${2:-0}" > "$STATE"; }

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  # REAL-read gate (verification principle): the actual dmesg source must yield ISO-shaped lines
  real="$(sudo -n dmesg --time-format=iso 2>/dev/null | tail -1)"
  if ! printf '%s' "$real" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T'; then
    echo "smoke-test: n/a (sudo -n dmesg --time-format=iso unreadable/hollow on this node)"; exit 2
  fi
  # fixture logic in a throwaway state dir; ALL outbound sandboxed (chat off + sandbox flag)
  _td="$(mktemp -d)"; _fx="$_td/fx"
  _env="MESH_STATE_DIR=$_td MESH_HW_FAULT_SRC=$_fx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' \
    '2026-07-02T10:00:00,000000+03:00 uvcvideo 1-5:1.1: Failed to resubmit video URB (-1).' \
    '2026-07-02T10:00:01,000000+03:00 loop1: detected capacity change' > "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?   # first run: backlog fault present but must baseline silent
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (first run must baseline, not replay: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:00:02,000000+03:00 usb 1-5: USB disconnect, device number 9' >> "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?   # new fault after baseline: exactly one edge
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (new fault must fire once: rc=$rc out='$out')"; exit 1; }
  out="$(env $_env "$0" 2>&1)"; rc=$?   # unchanged rerun: silent (no replay)
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (rerun replayed: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:00:03,000000+03:00 CPU0: Package temperature above threshold, cpu clock throttled' >> "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?   # heartbeat-class line: excluded here
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (heartbeat crash-class not excluded: rc=$rc out='$out')"; exit 1; }
  off_before="$(cat "$_td/.hw-fault-offset")"
  env MESH_STATE_DIR="$_td" MESH_HW_FAULT_SRC="$_td/nonexistent" MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 "$0" >/dev/null 2>&1; rc=$?
  { [ "$rc" = 2 ] && [ "$(cat "$_td/.hw-fault-offset")" = "$off_before" ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (BLIND must exit 2 + not touch offset: rc=$rc)"; exit 1; }

  # SUBSTRING FALSE-POSITIVE (regression): 'i915.*(hang|reset)' matched "VGA decodes cHANGed"
  # (the 'hang' inside "changed") → benign vgaarb power-state line boarded as a fault. Word-boundary
  # \bhang must reject it while GPU HANG / Resetting still board.
  _sd="$(mktemp -d)"; _sfx="$_sd/fx"
  _senv="MESH_STATE_DIR=$_sd MESH_HW_FAULT_SRC=$_sfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' '2026-07-02T10:30:00,000000+03:00 boot baseline line' > "$_sfx"
  env $_senv "$0" >/dev/null 2>&1   # baseline the offset
  echo '2026-07-02T10:30:01,000000+03:00 i915 0000:00:02.0: vgaarb: VGA decodes changed: olddecodes=io+mem,decodes=io+mem:owns=io+mem' >> "$_sfx"
  out="$(env $_senv "$0" 2>&1)"; rc=$?   # benign vgaarb "changed": must NOT board
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td" "$_sd"; echo "smoke-test: FAIL (i915 vgaarb 'changed' must not match \\bhang: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:30:02,000000+03:00 i915 0000:00:02.0: [drm] GPU HANG: ecode 9:1:85dffffb' >> "$_sfx"
  out="$(env $_senv "$0" 2>&1)"; rc=$?   # real GPU HANG: must still board
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ]; } \
    || { rm -rf "$_td" "$_sd"; echo "smoke-test: FAIL (real i915 GPU HANG must still board: rc=$rc out='$out')"; exit 1; }
  rm -rf "$_sd"

  # NVRM Xid (dGPU hardware fault): the driver reports GPU faults ONLY as 'NVRM: Xid (PCI:...): <N>'
  # kernel lines — nvidia-smi query fields (vram-watch) and AER counters (pcie-health) are both blind,
  # so this dmesg scanner is the SOLE reader. Assert: benign 'NVRM: loading' boot line must NOT match;
  # a real Xid boards as its NUMBER (xid-48); a DIFFERENT Xid (13) boards fresh (per-fault dbkey), not
  # debounced under one 'nvrm' bucket. RED-first: strip 'nvrm: xid \(' from FAULT_RE and the first assert
  # goes RED (Xid line stops boarding); collapse the number in the awk branch and the third goes RED.
  _xd="$(mktemp -d)"; _xfx="$_xd/fx"
  _xenv="MESH_STATE_DIR=$_xd MESH_HW_FAULT_SRC=$_xfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 MESH_HW_FAULT_DEBOUNCE_MIN=30"
  printf '%s\n' '2026-07-02T10:31:00,000000+03:00 NVRM: loading NVIDIA UNIX Open Kernel Module 595.71.05' > "$_xfx"
  env $_xenv "$0" >/dev/null 2>&1   # baseline the offset (benign boot line already present)
  echo '2026-07-02T10:31:01,000000+03:00 NVRM: loading NVIDIA UNIX Open Kernel Module 595.71.05  Release Build' >> "$_xfx"
  out="$(env $_xenv "$0" 2>&1)"; rc=$?   # benign 'NVRM: loading' after baseline: must NOT board
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td" "$_xd"; echo "smoke-test: FAIL (benign 'NVRM: loading' must not match 'xid \\(': rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:31:02,000000+03:00 NVRM: Xid (PCI:0000:01:00): 48, pid=1234, name=gigaam, Double Bit ECC Error' >> "$_xfx"
  out="$(env $_xenv "$0" 2>&1)"; rc=$?   # real Xid 48: boards once, grouped as xid-48
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ] && printf '%s' "$out" | grep -qF 'xid-48'; } \
    || { rm -rf "$_td" "$_xd"; echo "smoke-test: FAIL (real NVRM Xid 48 must board as xid-48: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:31:03,000000+03:00 NVRM: Xid (PCI:0000:01:00): 13, pid=1234, name=ollama, Graphics Engine Exception' >> "$_xfx"
  out="$(env $_xenv "$0" 2>&1)"; rc=$?   # DIFFERENT Xid 13 within window: fresh per-fault key, NOT debounced under xid-48
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'xid-13' && ! printf '%s' "$out" | grep -qF 'board-debounced'; } \
    || { rm -rf "$_td" "$_xd"; echo "smoke-test: FAIL (distinct Xid 13 must board fresh, not debounce under xid-48: rc=$rc out='$out')"; exit 1; }
  rm -rf "$_xd"

  # rtw88 WIRELESS FIRMWARE (rtw88-fault-leg): the four texts below are REAL, copied from this
  # node's journal, not invented — a gate on a fixture the live path cannot produce asserts nothing.
  # Asserts, in order: (1) the two BENIGN rtw lines ('Firmware version', 'renamed from wlan0') must
  # NOT board — the leg must not turn every mention of the driver into a fault; (2) a real fault
  # boards under its own SIGNATURE key, not a bare driver name; (3) a DIFFERENT signature inside the
  # debounce window boards FRESH (the whole point — per-driver grouping would hide it); (4) the SAME
  # signature with a different queue NUMBER debounces (digits collapse to N, else the key never
  # repeats and the flood is never throttled); (5) the rarer p3 'coex request time out' boards too —
  # health's numeric correction to the find (it was filed as p3=0; it is 1, and 'time out' is spelt
  # differently from 'timed out', so a regex covering only the latter would miss it).
  # RED-first: drop the rtw clause from FAULT_RE → (2) goes RED. Change the rtw awk branch to
  # `d = $2` (per-driver) → (3) goes RED. Delete the gsub(/[0-9]+/,"N") → (4) goes RED.
  _rd="$(mktemp -d)"; _rfx="$_rd/fx"
  _renv="MESH_STATE_DIR=$_rd MESH_HW_FAULT_SRC=$_rfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 MESH_HW_FAULT_DEBOUNCE_MIN=30"
  printf '%s\n' '2026-08-15T09:00:00,000000+03:00 boot baseline line' > "$_rfx"
  env $_renv "$0" >/dev/null 2>&1   # baseline the offset
  printf '%s\n' \
    '2026-08-15T09:00:01,000000+03:00 rtw_8822bu 1-5:1.2: Firmware version 9.9.4, H2C version 5' \
    '2026-08-15T09:00:02,000000+03:00 rtw_8822bu 1-5:1.2 wlxbcec43434a22: renamed from wlan0' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (benign rtw firmware-version/rename lines must not board: rc=$rc out='$out')"; exit 1; }
  echo '2026-08-15T09:00:03,000000+03:00 rtw_8822bu 1-5:1.2: failed to get tx report from firmware' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'rtw-failed-to-get-tx-report-from-firmware'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (real rtw fault must board under its SIGNATURE key: rc=$rc out='$out')"; exit 1; }
  echo '2026-08-15T09:00:04,000000+03:00 rtw_8822bu 1-5:1.2: firmware failed to leave lps state' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'rtw-firmware-failed-to-leave-lps-state' \
      && ! printf '%s' "$out" | grep -qF 'board-debounced'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a DIFFERENT rtw signature must board fresh, not debounce under the first: rc=$rc out='$out')"; exit 1; }
  printf '%s\n' \
    '2026-08-15T09:00:05,000000+03:00 rtw_8822bu 1-5:1.2: timed out to flush queue 3' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'rtw-timed-out-to-flush-queue-N'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (queue signature must collapse its index to N: rc=$rc out='$out')"; exit 1; }
  echo '2026-08-15T09:00:06,000000+03:00 rtw_8822bu 1-5:1.2: timed out to flush queue 5' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'board-debounced'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a different queue index is the SAME signature and must debounce: rc=$rc out='$out')"; exit 1; }
  echo '2026-08-15T09:00:07,000000+03:00 rtw_8822bu 1-5:1.2: coex request time out' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'rtw-coex-request-time-out'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (the p3 'coex request time out' must board — 'time out' != 'timed out': rc=$rc out='$out')"; exit 1; }
  # DUMP-PATH leg (devcoredump, 2026-08-21): the two texts below are the driver's own, lifted from
  # rtw88_core.ko strings — they are the lines emitted when a firmware crash DUMP is taken, and the
  # dump then sits readable in /sys/class/devcoredump for exactly 300s. Before 'crash' entered the
  # radio alphabet neither matched, so this view paged on 'dump fw fifo fail' (dump NOT taken) and
  # was silent on the dump that WAS taken — inverted relative to the evidence. RED-first: remove
  # \bcrash from FAULT_RE's rtw clause and both asserts below go RED while every assert above stays
  # green. Cite: knowledge/verify-devcoredump-fault-evidence-channel-mesh-home-20260821.md
  echo '2026-08-15T09:00:08,000000+03:00 rtw_8822bu 1-5:1.2: firmware crash, start reset and recover' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'rtw-firmware-crash-start-reset-and-recover'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (the DUMP-TAKEN line must board — a devcoredump lives 300s and nothing else watches it: rc=$rc out='$out')"; exit 1; }
  echo '2026-08-15T09:00:09,000000+03:00 rtw_8822bu 1-5:1.2: fw crash dump length is 0' >> "$_rfx"
  out="$(env $_renv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'rtw-fw-crash-dump-length-is-N'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (an EMPTY fw crash dump must board too — it is a dump attempt that produced no evidence: rc=$rc out='$out')"; exit 1; }
  rm -rf "$_rd"

  # --legs (inert-leg report): every leg must classify itself. A leg naming absent hardware reads
  # INERT instead of sitting silently green — the failure that let iwlwifi front 230 rtw faults.
  #
  # THE FULL REPORT IS DRIVEN FROM FIXTURES, NOT THE LIVE JOURNAL, and that is a cost decision with
  # a cost: proving a leg ABSENT means scanning the whole boot journal (26.0s here), which put the
  # suite over the `timeout 30` BOTH runners impose. Fixtures make the classification deterministic
  # and free — but a fixture-driven gate cannot cover the live path, so the live read is asserted
  # separately below at its real (module-settled, 0.01s) cost. Neither leg alone is the gate.
  _ld="$(mktemp -d)"
  printf '%s\n' 'rtw88_8822bu 155648 0' 'uvcvideo 122880 0' > "$_ld/mods"
  printf '%s\n' 'rtw_8822bu: firmware failed to leave lps state' 'usb 1-2.3: reset high-speed USB device' > "$_ld/jrnl"
  legs_out="$(MESH_HW_FAULT_LEGS_MODSRC=$_ld/mods MESH_HW_FAULT_LEGS_JRNLSRC=$_ld/jrnl "$0" --legs 2>&1)"
  for _l in usb uvcvideo iwlwifi rtw hci i915 nvrm ata nvme oom; do
    [ "$(printf '%s\n' "$legs_out" | grep -cE "^  $_l +(applicable|INERT)")" = 1 ] \
      || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (--legs did not classify leg '$_l' exactly once: $legs_out)"; exit 1; }
  done
  # and the classification must be a real read, not a constant: the fixture carries rtw + uvcvideo
  # and carries NO iwlwifi/i915, so those must land on OPPOSITE sides of the same run.
  printf '%s\n' "$legs_out" | grep -q '^  rtw *applicable' \
    || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (--legs called a fixture-present driver INERT: $legs_out)"; exit 1; }
  printf '%s\n' "$legs_out" | grep -q '^  iwlwifi *INERT' \
    || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (--legs calls every leg applicable — a constant, not a read: $legs_out)"; exit 1; }
  # a module-settled leg must say its journal count was NOT READ — printing 0 there would be a
  # fabricated absence on a driver that is demonstrably present (and would hide the short-circuit
  # that keeps this report affordable). The fixture journal DOES carry an rtw line, so a build that
  # scans anyway prints journal-lines=1 and this leg goes red.
  printf '%s\n' "$legs_out" | grep -q '^  rtw .*journal-lines=not-read' \
    || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (module-settled leg reported a journal count it never read: $legs_out)"; exit 1; }
  # THE FIXTURE OVERRIDE MUST BE EXCLUSIVE. Without this leg the two above are vacuous on THIS node:
  # the live lsmod carries rtw and the live journal carries 129k rtw lines, so a fall-through to the
  # live source would produce the SAME verdict the fixture asks for and the gate would assert nothing
  # (a-gate-can-be-vacuous-because-the-live-reading-agrees). Empty fixtures ⇒ every driver-bound leg
  # INERT; anything applicable here means the live node leaked in.
  : > "$_ld/empty"
  _excl="$(MESH_HW_FAULT_LEGS_MODSRC=$_ld/empty MESH_HW_FAULT_LEGS_JRNLSRC=$_ld/empty "$0" --legs 2>&1)"
  [ "$(printf '%s\n' "$_excl" | grep -cE '^  (rtw|hci|nvme|nvrm|uvcvideo) +applicable' || true)" = 0 ] \
    || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (--legs fell through an EXCLUSIVE fixture to the live source: $_excl)"; exit 1; }
  # and the LIVE path — one leg, module-settled, so covering it costs 0.01s instead of the 26s
  # whole-boot absence scan. rtw is on this node's sole uplink; a node without it exits 2 honestly.
  #
  # `grep -c`, NOT `grep -q`, and that is load-bearing: this script runs under `set -o pipefail`, so
  # `lsmod | grep -q` returns 141 (grep exits on the first match → SIGPIPE upstream) even though the
  # module IS loaded. Written with -q, this guard read FALSE on a node with 4 rtw modules and the
  # whole live-path block was skipped in silence — the leg-filter mutant below sailed through green
  # while I was calling it live coverage. (pipefail-turns-sigpipe-into-a-false-verdict.)
  if [ "$(lsmod 2>/dev/null | grep -ciE '^rtw' || true)" -gt 0 ]; then
    _one="$("$0" --legs rtw 2>&1)"
    [ "$(printf '%s\n' "$_one" | grep -c '^  rtw *applicable' || true)" -gt 0 ] \
      || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (live --legs rtw did not read the loaded module: $_one)"; exit 1; }
    # and the filter must actually restrict — an unfiltered run here silently costs the 26s scan
    # this leg exists to avoid, and would still satisfy the assertion above.
    [ "$(printf '%s\n' "$_one" | grep -cE '^  [a-z0-9]+ +(applicable|INERT)')" = 1 ] \
      || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (--legs <leg> reported legs that were not asked for: $_one)"; exit 1; }
  fi
  # an unknown leg name is refused, never reported as absent hardware (the bare `*)` trap that let
  # mesh-link-heal silently RUN THE LADDER on a typo'd flag).
  "$0" --legs no-such-leg >/dev/null 2>&1; [ "$?" = 2 ] \
    || { rm -rf "$_td" "$_ld"; echo "smoke-test: FAIL (--legs accepted an unknown leg name)"; exit 1; }
  rm -rf "$_ld"

  # CROSS-DRIVER OVERFLOW: >3 distinct drivers in one pass → 3 driver lines + 1 "+N more" summary
  _od="$(mktemp -d)"; _ofx="$_od/fx"
  _oenv="MESH_STATE_DIR=$_od MESH_HW_FAULT_SRC=$_ofx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' '2026-07-02T11:00:00,000000+03:00 boot baseline line' > "$_ofx"
  env $_oenv "$0" >/dev/null 2>&1   # baseline the offset
  printf '%s\n' \
    '2026-07-02T11:00:01,000000+03:00 usb 1-1: USB disconnect, device number 2' \
    '2026-07-02T11:00:02,000000+03:00 uvcvideo 1-5:1.1: Failed to query (GET_DEF) UVC control 2' \
    '2026-07-02T11:00:03,000000+03:00 iwlwifi 0000:00:14.3: Microcode SW error detected' \
    '2026-07-02T11:00:04,000000+03:00 nvme nvme0: I/O error, reset controller' >> "$_ofx"
  out="$(env $_oenv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 4 ] && printf '%s' "$out" | grep -qF '+1 more driver'; } \
    || { rm -rf "$_td" "$_od"; echo "smoke-test: FAIL (4-driver pass must post 3 + overflow summary: rc=$rc out='$out')"; exit 1; }
  rm -rf "$_od"

  # CROSS-PASS DEBOUNCE: same driver faulting in consecutive passes within the window → board once, then suppressed
  _dd="$(mktemp -d)"; _dfx="$_dd/fx"
  _denv="MESH_STATE_DIR=$_dd MESH_HW_FAULT_SRC=$_dfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 MESH_HW_FAULT_DEBOUNCE_MIN=30"
  printf '%s\n' '2026-07-02T12:00:00,000000+03:00 boot baseline line' > "$_dfx"
  env $_denv "$0" >/dev/null 2>&1   # baseline
  echo '2026-07-02T12:00:01,000000+03:00 usb 1-1: USB disconnect, device number 3' >> "$_dfx"
  out1="$(env $_denv "$0" 2>&1)"    # first usb fault: posts (not debounced)
  echo '2026-07-02T12:00:02,000000+03:00 usb 1-2: USB disconnect, device number 4' >> "$_dfx"
  out2="$(env $_denv "$0" 2>&1)"    # same driver again within window: board-debounced
  { printf '%s' "$out1" | grep -qF '[hw-fault]' && ! printf '%s' "$out1" | grep -qF 'board-debounced' \
      && printf '%s' "$out2" | grep -qF 'board-debounced'; } \
    || { rm -rf "$_td" "$_dd"; echo "smoke-test: FAIL (same-driver repeat must debounce 2nd board post: out1='$out1' out2='$out2')"; exit 1; }
  rm -rf "$_dd"

  # KNOWN-BENIGN routing: a benign-signature fault is LOGGED but NEVER boarded; a real fault still boards.
  _bd="$(mktemp -d)"; _bfx="$_bd/fx"
  _benv="MESH_STATE_DIR=$_bd MESH_HW_FAULT_SRC=$_bfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' '2026-07-02T13:00:00,000000+03:00 boot baseline line' > "$_bfx"
  env $_benv "$0" >/dev/null 2>&1   # baseline the offset
  echo '2026-07-02T13:00:01,000000+03:00 uvcvideo 1-5:1.1: Failed to resubmit video URB (-1).' >> "$_bfx"
  out="$(env $_benv "$0" 2>&1)"; rc=$?   # benign signature: logged, NOT boarded, exit 0
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]' && grep -qF 'video URB' "$_bd/hw-fault.log"; } \
    || { rm -rf "$_td" "$_bd"; echo "smoke-test: FAIL (known-benign must log-not-board: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T13:00:02,000000+03:00 usb 1-1: USB disconnect, device number 5' >> "$_bfx"
  out="$(env $_benv "$0" 2>&1)"; rc=$?   # a NON-benign fault must still board
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ]; } \
    || { rm -rf "$_td" "$_bd"; echo "smoke-test: FAIL (non-benign fault must still board past a benign filter: rc=$rc out='$out')"; exit 1; }
  # empty BENIGN_RE must NOT silence everything (grep -ivE '' footgun guard)
  _ebd="$(mktemp -d)"; _ebfx="$_ebd/fx"
  printf '%s\n' '2026-07-02T14:00:00,000000+03:00 boot baseline line' > "$_ebfx"
  env MESH_STATE_DIR="$_ebd" MESH_HW_FAULT_SRC="$_ebfx" MESH_HW_FAULT_CHAT=0 MESH_HW_FAULT_BENIGN='' "$0" >/dev/null 2>&1
  echo '2026-07-02T14:00:01,000000+03:00 uvcvideo 1-5:1.1: Failed to resubmit video URB (-1).' >> "$_ebfx"
  out="$(env MESH_STATE_DIR="$_ebd" MESH_HW_FAULT_SRC="$_ebfx" MESH_HW_FAULT_CHAT=0 MESH_HW_FAULT_BENIGN='' "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ]; } \
    || { rm -rf "$_td" "$_bd" "$_ebd"; echo "smoke-test: FAIL (empty BENIGN_RE must board everything, not silence: rc=$rc out='$out')"; exit 1; }
  rm -rf "$_bd" "$_ebd"

  # OOM KILL (chat-review/oom-kill-no-edge-alert): a live mid-session mind-cull must get exactly one
  # board-shaped event NAMING THE VICTIM COMM, not be swallowed by heartbeat's rejoin-only ownership.
  _od2="$(mktemp -d)"; _ofx2="$_od2/fx"
  _oenv2="MESH_STATE_DIR=$_od2 MESH_HW_FAULT_SRC=$_ofx2 MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' \
    '2026-07-02T15:00:00,000000+03:00 boot baseline line' \
    '2026-07-02T15:00:01,000000+03:00 Out of memory: Killed process 1234 (opencode) total-vm:76000000kB' \
    > "$_ofx2"
  out="$(env $_oenv2 "$0" 2>&1)"; rc=$?   # first run: oom already in backlog must baseline, not replay
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td" "$_od2"; echo "smoke-test: FAIL (oom in first-run backlog must baseline, not replay: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T15:00:02,000000+03:00 Out of memory: Killed process 5678 (opencode) total-vm:80000000kB' >> "$_ofx2"
  out="$(env $_oenv2 "$0" 2>&1)"; rc=$?   # new oom kill: exactly one board event naming the victim
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ] && printf '%s' "$out" | grep -qF '[hw-fault] oom-opencode:'; } \
    || { rm -rf "$_td" "$_od2"; echo "smoke-test: FAIL (new OOM kill must post once, naming victim comm: rc=$rc out='$out')"; exit 1; }
  out="$(env $_oenv2 "$0" 2>&1)"; rc=$?   # unchanged rerun: silent (no replay)
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td" "$_od2"; echo "smoke-test: FAIL (oom rerun replayed: rc=$rc out='$out')"; exit 1; }
  # a benign (non-oom) pass stays silent — the oom addition must not make unrelated lines board
  echo '2026-07-02T15:00:03,000000+03:00 kernel: benign informational line, nothing wrong here' >> "$_ofx2"
  out="$(env $_oenv2 "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td" "$_od2"; echo "smoke-test: FAIL (benign non-oom line must stay silent: rc=$rc out='$out')"; exit 1; }
  rm -rf "$_od2"

  # OOM DEBOUNCE CLASS KEY (chat-review/oom-debounce-class-key): DISTINCT OOM victims within the
  # window are ONE storm → exactly one board post, debounced under the 'oom' class key — but each
  # line still NAMES its victim. Falsify: pre-fix per-victim key means victim #2 ('node') is a fresh
  # key, never debounced → posts again → the 2nd-pass board-debounced assert trips.
  _cd="$(mktemp -d)"; _cfx="$_cd/fx"
  _cenv="MESH_STATE_DIR=$_cd MESH_HW_FAULT_SRC=$_cfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 MESH_HW_FAULT_DEBOUNCE_MIN=30"
  printf '%s\n' '2026-07-02T16:00:00,000000+03:00 boot baseline line' > "$_cfx"
  env $_cenv "$0" >/dev/null 2>&1   # baseline the offset
  echo '2026-07-02T16:00:01,000000+03:00 Out of memory: Killed process 111 (chrome) total-vm:90000000kB' >> "$_cfx"
  outc1="$(env $_cenv "$0" 2>&1)"   # victim #1 chrome: posts, names chrome, records the 'oom' epoch
  echo '2026-07-02T16:00:02,000000+03:00 Out of memory: Killed process 222 (node) total-vm:70000000kB' >> "$_cfx"
  outc2="$(env $_cenv "$0" 2>&1)"   # victim #2 node, DIFFERENT victim within window: class-debounced
  { printf '%s' "$outc1" | grep -qF '[hw-fault] oom-chrome:' && ! printf '%s' "$outc1" | grep -qF 'board-debounced' \
      && printf '%s' "$outc2" | grep -qF 'board-debounced' && printf '%s' "$outc2" | grep -qF 'oom-node'; } \
    || { rm -rf "$_td" "$_cd"; echo "smoke-test: FAIL (distinct OOM victims must debounce under one 'oom' class key, victim kept in text: outc1='$outc1' outc2='$outc2')"; exit 1; }
  rm -rf "$_cd"

  # OOM PANE ATTRIBUTION (oom-pane-attribution): the scope uuid rides the 'oom-kill:constraint=…
  # task_memcg=…tmux-spawn-<uuid>.scope,…,pid=<pid>' line, a DIFFERENT line from the boarded
  # 'Killed process <pid> (comm)' — join by pid, resolve scope→window.pane via the append-only
  # journal. Known scope → pane=<w.p>; scope present but un-journaled → honest unknown(respawned).
  _ad="$(mktemp -d)"; _afx="$_ad/fx"
  _aenv="MESH_STATE_DIR=$_ad MESH_HW_FAULT_SRC=$_afx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' '2026-07-02T17:00:00,000000+03:00 boot baseline line' > "$_afx"
  # pre-seed the journal: a known scope maps to window.pane 'tg.1' (sandbox skips the live pane scan)
  printf '%s\t%s\t%s\n' 'tmux-spawn-aaaa1111-2222-3333-4444-555566667777.scope' 'tg.1' "$(date +%s)" > "$_ad/.pane-scopes"
  env $_aenv "$0" >/dev/null 2>&1   # baseline the offset
  printf '%s\n' \
    '2026-07-02T17:00:01,000000+03:00 oom-kill:constraint=CONSTRAINT_NONE,nodemask=(null),cpuset=user.slice,mems_allowed=0,global_oom,task_memcg=/user.slice/user-1000.slice/user@1000.service/app.slice/tmux-spawn-aaaa1111-2222-3333-4444-555566667777.scope,task=python,pid=4242,uid=1000' \
    '2026-07-02T17:00:01,500000+03:00 Out of memory: Killed process 4242 (python) total-vm:4000000kB, anon-rss:2000000kB' >> "$_afx"
  out="$(env $_aenv "$0" 2>&1)"; rc=$?   # known scope → pane=tg.1 + heavy-run nudge; the constraint line itself never boards
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ] \
      && printf '%s' "$out" | grep -qF 'pane=tg.1' && printf '%s' "$out" | grep -qF 'route heavy jobs via mesh-heavy-run'; } \
    || { rm -rf "$_td" "$_ad"; echo "smoke-test: FAIL (known scope must attribute pane=tg.1 + heavy-run nudge, constraint line must not board: rc=$rc out='$out')"; exit 1; }
  # unknown scope (not in journal) → honest unknown(respawned) (still carried on the class-debounced 2nd oom)
  printf '%s\n' \
    '2026-07-02T17:00:02,000000+03:00 oom-kill:constraint=CONSTRAINT_NONE,nodemask=(null),cpuset=user.slice,mems_allowed=0,global_oom,task_memcg=/user.slice/user-1000.slice/user@1000.service/app.slice/tmux-spawn-bbbb9999-0000-1111-2222-333344445555.scope,task=node,pid=4343,uid=1000' \
    '2026-07-02T17:00:02,500000+03:00 Out of memory: Killed process 4343 (node) total-vm:5000000kB, anon-rss:2500000kB' >> "$_afx"
  out="$(env $_aenv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'pane=unknown(respawned)'; } \
    || { rm -rf "$_td" "$_ad"; echo "smoke-test: FAIL (un-journaled scope must be honest unknown(respawned): rc=$rc out='$out')"; exit 1; }
  # falsify: a Killed-process line WITHOUT its paired oom-kill constraint line → no scope → unknown(no-scope)
  _nd="$(mktemp -d)"; _nfx="$_nd/fx"
  _nenv="MESH_STATE_DIR=$_nd MESH_HW_FAULT_SRC=$_nfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' '2026-07-02T18:00:00,000000+03:00 boot baseline line' > "$_nfx"
  env $_nenv "$0" >/dev/null 2>&1
  echo '2026-07-02T18:00:01,000000+03:00 Out of memory: Killed process 9999 (python) total-vm:4000000kB' >> "$_nfx"
  out="$(env $_nenv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'pane=unknown(no-scope)'; } \
    || { rm -rf "$_td" "$_ad" "$_nd"; echo "smoke-test: FAIL (unpaired Killed-process line must be honest unknown(no-scope): rc=$rc out='$out')"; exit 1; }
  rm -rf "$_ad" "$_nd"

  # HEAVY-RUN CAP-PROBE OOM LIBEL, KEYED ON IDENTITY (hw-fault-oom-libels-heavyrun-capprobe 2026-07-17;
  # re-keyed 2026-08-22, task capcheck-mints-the-oom-line-a-real-detector-reads). mesh-heavy-run's two
  # probe minters treat a cgroup-OOM as SUCCESS, so each emits a real kernel OOM line by design; they
  # must be LOGGED (the OOM happened) and NEVER boarded — the victim IS the probe. They now SIGN
  # themselves, so these fixtures assert the comm, and every size band is gone. RED-first: strip the
  # signed-comm clause from BENIGN_RE and (A)/(A2) go red; restore either old RSS band and (C)/(E) go
  # red — (C) is the exact live line that went silent, which is what this re-key exists to stop.
  _pd="$(mktemp -d)"; _pfx="$_pd/fx"
  _penv="MESH_STATE_DIR=$_pd MESH_HW_FAULT_SRC=$_pfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' '2026-07-02T19:00:00,000000+03:00 boot baseline line' > "$_pfx"
  env $_penv "$0" >/dev/null 2>&1   # baseline the offset
  # (A) the signed bind-probe (mem_cap_available) → ZERO board lines, line IS in hw-fault.log
  echo '2026-07-02T19:00:01,000000+03:00 Memory cgroup out of memory: Killed process 3993205 (mesh-capcheck) total-vm:149044kB, anon-rss:32512kB, file-rss:6528kB, shmem-rss:0kB, UID:1000 pgtables:128kB oom_score_adj:0' >> "$_pfx"
  out="$(env $_penv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]' \
      && grep -qF 'mesh-capcheck' "$_pd/hw-fault.log"; } \
    || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (signed heavy-run cap-probe OOM must be LOGGED but NOT boarded: rc=$rc out='$out')"; exit 1; }
  # (A2) the signed --test over-budget hog → same libel class, same treatment.
  echo '2026-07-02T19:00:02,000000+03:00 Memory cgroup out of memory: Killed process 3420288 (mesh-caphog) total-vm:280116kB, anon-rss:65280kB, file-rss:6528kB, shmem-rss:0kB, UID:1000 pgtables:204kB oom_score_adj:0' >> "$_pfx"
  out="$(env $_penv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]' \
      && grep -qF 'mesh-caphog' "$_pd/hw-fault.log"; } \
    || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (signed heavy-run test-hog OOM must be LOGGED but NOT boarded: rc=$rc out='$out')"; exit 1; }
  # (B) a REAL big-job python3 OOM must board — the exclusion must not over-reach.
  echo '2026-07-02T19:00:03,000000+03:00 Memory cgroup out of memory: Killed process 4000001 (python3) total-vm:2700000kB, anon-rss:2551572kB, file-rss:8000kB' >> "$_pfx"
  out="$(env $_penv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[hw-fault] oom-python3:' && printf '%s' "$out" | grep -qF 'anon-rss:2551572kB'; } \
    || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (a real 2.5GB python3 OOM must still board, exclusion over-reached: rc=$rc out='$out')"; exit 1; }
  # (C) THE LIVE REGRESSION. Verbatim kernel line from 2026-08-22T13:33:14Z on this node — the grind
  # dying at its own declared mesh-heavy-run ceiling. The retired ~2.5G band matched it exactly, so a
  # REAL cap-kill of a REAL job was suppressed board-side and aged where nobody looks. It must board.
  echo '2026-07-02T19:00:04,000000+03:00 Memory cgroup out of memory: Killed process 3526528 (python) total-vm:7454496kB, anon-rss:2551900kB, file-rss:127360kB, shmem-rss:0kB, UID:1000 pgtables:5904kB oom_score_adj:0' >> "$_pfx"
  out="$(env $_penv "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[hw-fault] oom-python:' && printf '%s' "$out" | grep -qF 'anon-rss:2551900kB'; } \
    || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (the real 2026-08-22T13:33:14Z cap-kill must board — a size band must never suppress a real OOM: rc=$rc out='$out')"; exit 1; }
  # (C2) a genuinely-large comm=python OOM must board too.
  echo '2026-07-02T19:00:05,000000+03:00 Memory cgroup out of memory: Killed process 4000002 (python) total-vm:6000000kB, anon-rss:5001234kB, file-rss:8000kB' >> "$_pfx"
  out="$(env $_penv MESH_HW_FAULT_DEBOUNCE_MIN=0 "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[hw-fault] oom-python:' && printf '%s' "$out" | grep -qF 'anon-rss:5001234kB'; } \
    || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (a real 5GB python OOM must still board: rc=$rc out='$out')"; exit 1; }
  # (E) AN UNSIGNED PROBE-SHAPED LINE MUST BOARD. Identical RSS to (A) — 32512kB, the old 32M band —
  # but comm=python3. Under the retired bands this was silent; under identity it boards, which is the
  # honest direction: if a probe ever fails to sign itself (symlink unmakeable) we hear about it
  # instead of it hiding inside a whitelist it no longer qualifies for.
  echo '2026-07-02T19:00:06,000000+03:00 Memory cgroup out of memory: Killed process 4000003 (python3) total-vm:149044kB, anon-rss:32512kB, file-rss:6528kB, shmem-rss:0kB, UID:1000 pgtables:128kB oom_score_adj:0' >> "$_pfx"
  out="$(env $_penv MESH_HW_FAULT_DEBOUNCE_MIN=0 "$0" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[hw-fault] oom-python3:' && printf '%s' "$out" | grep -qF 'anon-rss:32512kB'; } \
    || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (an UNSIGNED probe-shaped OOM must board — the filter must key on identity, not on the old 32M size band: rc=$rc out='$out')"; exit 1; }
  # (D) A GLOBAL (CONSTRAINT_NONE) OOM whose victim carries a SIGNED comm must STILL board (chat-review/
  # oom-benign-filter-keys-on-rss-size-not-on-constraint): the clause means "a cgroup cap was enforced",
  # and the kernel says which on the line — 'Memory cgroup out of memory:' vs plain 'Out of memory:'.
  # Same comm as (A)/(A2), only the constraint differs → both must reach the board. RED-first: drop the
  # 'Memory cgroup out of memory: ' prefix from the BENIGN clause and both go RED.
  _n=7
  for _comm in mesh-capcheck mesh-caphog; do
    echo "2026-07-02T19:00:0$_n,000000+03:00 Out of memory: Killed process 400001$_n (${_comm}) total-vm:149044kB, anon-rss:32512kB, file-rss:0kB, shmem-rss:0kB, UID:1000 pgtables:5200kB oom_score_adj:0" >> "$_pfx"
    out="$(env $_penv MESH_HW_FAULT_DEBOUNCE_MIN=0 "$0" 2>&1)"; rc=$?
    { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF "[hw-fault] oom-${_comm}:" \
        && ! printf '%s' "$out" | grep -qF 'board-debounced'; } \
      || { rm -rf "$_td" "$_pd"; echo "smoke-test: FAIL (a GLOBAL CONSTRAINT_NONE OOM of $_comm must still board — the benign leg must gate on the memcg constraint, not on the comm alone: rc=$rc out='$out')"; exit 1; }
    _n=$(( _n + 1 ))
  done
  rm -rf "$_pd"

  # ── RE-ENTRY / probe= (self-reference vs other-reference) ────────────────────────────────────────
  # Four legs, each red-first-checked by hand: (1) a radio fault inside a scan window names the tool,
  # (2) the same fault on a non-scan minute reads none, (3) past the in-flight window reads none,
  # (4) a NON-radio driver gets no probe= at all, and (5) an unreadable schedule renders na — never
  # 'none', which would exonerate the mesh on missing evidence.  The fixture crontab deliberately runs
  # mesh-presence-density EVERY MINUTE: it is not a radio tool, so if the RADIO_TOOL_RE word boundary
  # ever breaks, leg (2) goes RED instead of every fault silently reading 'self:mesh-presence'.
  _rd="$(mktemp -d)"; _rfx="$_rd/fx"; _rcron="$_rd/crontab"
  printf '%s\n' \
    '6-59/10 * * * * $HOME/.local/bin/mesh-wifiscan --log >> $HOME/.mesh/wifiscan.log 2>&1' \
    '* * * * * $HOME/.local/bin/mesh-presence-density --edge >> $HOME/.mesh/presence-density.log 2>&1' \
    '# 4-59/10 * * * * $HOME/.local/bin/mesh-proximity --edge  (commented: must NOT be read as scheduled)' > "$_rcron"
  _renv="MESH_STATE_DIR=$_rd MESH_HW_FAULT_SRC=$_rfx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 MESH_HW_FAULT_DEBOUNCE_MIN=0 MESH_HW_FAULT_SHIFT_STEP=60"
  printf '%s\n' '2026-08-17T13:00:00,000000+00:00 boot baseline line' > "$_rfx"
  env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" "$0" >/dev/null 2>&1   # baseline the offset
  # (Timestamps ASCEND across the legs on purpose: the offset only ever moves forward, so a leg whose
  #  fixture line predates the previous leg's would read QUIET and assert nothing.)
  # (1) NOT a scan minute → none  (and the every-minute non-radio tool must not claim it)
  echo '2026-08-17T13:13:11,134346+00:00 rtw_8822bu 1-5:1.2: timed out to flush queue 3' >> "$_rfx"
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" "$0" 2>&1)"
  { printf '%s' "$out" | grep -qF 'probe=none' && ! printf '%s' "$out" | grep -qF 'probe=self'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a radio fault on a minute nothing scans must read probe=none: out='$out')"; exit 1; }
  # (2) in a wifiscan window (minute 16, second 11 < 30)
  echo '2026-08-17T13:16:11,134346+00:00 rtw_8822bu 1-5:1.2: failed to get tx report from firmware' >> "$_rfx"
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" "$0" 2>&1)"
  printf '%s' "$out" | grep -qF 'probe=self:mesh-wifiscan+11s' \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a radio fault 11s into a mesh-wifiscan minute must annotate probe=self:mesh-wifiscan: out='$out')"; exit 1; }
  # (3) scan minute but PAST the in-flight window (second 47 > 30) → none
  echo '2026-08-17T13:26:47,134346+00:00 rtw_8822bu 1-5:1.2: firmware failed to leave lps state' >> "$_rfx"
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" "$0" 2>&1)"
  { printf '%s' "$out" | grep -qF 'probe=none' && ! printf '%s' "$out" | grep -qF 'probe=self'; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a radio fault 47s into a scan minute is past the ${PROBE_WIN}s in-flight window and must read probe=none: out='$out')"; exit 1; }
  # (4) a NON-radio driver carries no probe= token at all (no operation of ours can touch it)
  echo '2026-08-17T13:36:12,134346+00:00 nvme0n1: I/O error, dev nvme0n1, sector 12345' >> "$_rfx"
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" "$0" 2>&1)"
  { printf '%s' "$out" | grep -qF '[hw-fault] nvme0n1' && ! printf '%s' "$out" | grep -E '^\[hw-fault\] nvme0n1' | grep -qF 'probe='; } \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a non-radio driver must carry no probe= annotation: out='$out')"; exit 1; }
  # (5) schedule unreadable → na(no-schedule), NEVER none (missing evidence must not read as innocence)
  echo '2026-08-17T13:46:11,134346+00:00 rtw_8822bu 1-5:1.2: coex request time out' >> "$_rfx"
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rd/absent-crontab" "$0" 2>&1)"
  printf '%s' "$out" | grep -qF 'probe=na(no-schedule)' \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (an unreadable schedule must render probe=na(no-schedule), never probe=none: out='$out')"; exit 1; }
  # (6) --selfprobe: a log whose radio faults are PLANTED in the scan window must rank mesh-wifiscan
  #     lead with a high enrichment; a UNIFORMLY-spread control log must not.  This is the gate that
  #     keeps the report a measurement instead of a decoration.
  _slog="$_rd/planted.log"; : > "$_slog"
  _d=1; _h=0
  while [ "$_d" -le 20 ]; do
    printf '2026-08-1%dT%02d:16:0%d,000000+00:00 rtw_8822bu 1-5:1.2: failed to get tx report from firmware\n' \
      $(( _d % 10 )) "$_h" $(( _d % 9 )) >> "$_slog"
    _h=$(( (_h + 1) % 24 )); _d=$(( _d + 1 ))
  done
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" MESH_HW_FAULT_LOG="$_slog" "$0" --selfprobe 4000 2>&1)"
  printf '%s' "$out" | grep -E '^mesh-wifiscan' | grep -qF 'LEAD' \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (--selfprobe must rank mesh-wifiscan LEAD on a log planted inside its scan window: out='$out')"; exit 1; }
  _en="$(printf '%s' "$out" | awk '/^mesh-wifiscan/{gsub(/x/,"",$4); print int($4)}')"
  [ "${_en:-0}" -ge 3 ] \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (planted-in-window log must show >=3x enrichment for mesh-wifiscan, got '${_en}': out='$out')"; exit 1; }
  _clog="$_rd/control.log"; : > "$_clog"
  _d=1; _h=0
  while [ "$_d" -le 20 ]; do
    printf '2026-08-1%dT%02d:%02d:%02d,000000+00:00 rtw_8822bu 1-5:1.2: failed to get tx report from firmware\n' \
      $(( _d % 10 )) "$_h" $(( (_d * 7) % 60 )) $(( (_d * 13) % 60 )) >> "$_clog"
    _h=$(( (_h + 1) % 24 )); _d=$(( _d + 1 ))
  done
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" MESH_HW_FAULT_LOG="$_clog" "$0" --selfprobe 4000 2>&1)"
  _cen="$(printf '%s' "$out" | awk '/^mesh-wifiscan/{gsub(/x/,"",$4); print int($4)}')"
  [ "${_cen:-99}" -le 2 ] \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (a phase-uniform control log must NOT show mesh-wifiscan enrichment, got '${_cen}x': out='$out')"; exit 1; }
  # (7) THE SECONDS WINDOW IS HALF THE CLAIM, and the two logs above do not pin it: a report that
  #     dropped the `second < WIN` term still passes both (planted faults sit early in the minute
  #     either way).  Caught live — the mutant that deletes the seconds term stayed GREEN until this
  #     leg existed.  Same minutes as the planted log, but at second 45, PAST the 30s window: a
  #     correct report reads ~0x, a minute-only report reads it as a full hit.
  _llog="$_rd/late.log"; : > "$_llog"
  _d=1; _h=0
  while [ "$_d" -le 20 ]; do
    printf '2026-08-1%dT%02d:16:45,000000+00:00 rtw_8822bu 1-5:1.2: failed to get tx report from firmware\n' \
      $(( _d % 10 )) "$_h" >> "$_llog"
    _h=$(( (_h + 1) % 24 )); _d=$(( _d + 1 ))
  done
  out="$(env $_renv MESH_HW_FAULT_CRONSRC="$_rcron" MESH_HW_FAULT_LOG="$_llog" "$0" --selfprobe 4000 2>&1)"
  _len="$(printf '%s' "$out" | awk '/^mesh-wifiscan/{gsub(/x/,"",$4); print int($4)}')"
  [ "${_len:-99}" -le 1 ] \
    || { rm -rf "$_td" "$_rd"; echo "smoke-test: FAIL (faults 45s into a scan minute are PAST the ${PROBE_WIN}s window — --selfprobe must not count them (got '${_len}x'), or the seconds term is dead: out='$out')"; exit 1; }
  rm -rf "$_rd"

  rm -rf "$_td"
  echo "smoke-test: ok (real dmesg ISO read + baseline/edge/no-replay/exclusion/BLIND/overflow/debounce/known-benign/oom-kill/oom-class-debounce/oom-pane-attribution/capprobe-libel/rtw88-signature-debounce/legs-inert/probe-self-other/selfprobe-planted-vs-control fixtures)"; exit 0
fi

if [ "${1:-}" = --status ]; then
  [ -r "$STATE" ] && cat "$STATE" || echo "hw-fault-watch: no state yet"
  exit 0
fi

# ── --legs: which fault legs can fire ON THIS NODE (the inert-leg report) ────────────────────────
# A leg naming hardware the node does not have is not "quiet", it is AIMED AT NOTHING — and the two
# read identically from outside (iwlwifi's leg sat green for 22h47m over 230 unboarded rtw faults).
# This is the else-branch discover asked for: the skip SAYS WHY. Presence is decided by a real read
# (loaded module OR lines in this boot's journal), never by a name we assume — a driver present but
# silent still reads applicable, which is the honest direction. Report-only: it gates nothing and
# changes no matching, so a wrong presence read can never suppress a fault.
# COST — why this reads modules FIRST and the journal AT MOST ONCE (measured 2026-08-17, mesh-home):
# presence is `module OR journal line`, and only the JOURNAL half is expensive — `journalctl -k -b`
# is 376685 lines / 26.0s on this node, because the rtw storm this very tool watches writes ~37k
# lines a day into it. The original shape paid that read unconditionally and then re-piped the whole
# 376k-line result through `grep -c` once PER LEG: 31.7s of a 33.4s `--test`, i.e. the suite was over
# the 30s cap BOTH its runners impose (`mesh-land:288` and `mesh-autowire:273` both
# `timeout 30 <tool> --test`) — measured RED: `timeout 30 … --test` → rc=124. A tool whose own suite
# cannot finish inside the timeout its runners use is unlandable and unwirable on a fresh node, and
# nothing said so: the runners just record a failing test. Two structural facts drive the fix —
# a LOADED MODULE settles presence with no journal read at all (0.01s), and proving ABSENCE is what
# actually costs (`-g iwlwifi -n 1` still scans the whole boot: 22.5s), so the scan is worth doing
# exactly once for ALL remaining legs rather than once each.
legs_pattern(){ # leg → ERE. THE single source of truth for the presence read (--legs + its gates).
  case "$1" in
    nvrm) echo 'nvidia|nvrm' ;;
    rtw)  echo 'rtw' ;;
    hci)  echo 'bluetooth|btusb|hci' ;;
    *)    echo "$1" ;;
  esac
}
if [ "${1:-}" = --legs ]; then
  # `--legs [leg...]` — asking about ONE leg costs one lsmod when its module is loaded, so a caller
  # (or a gate) can take a LIVE reading without paying the whole-boot absence scan the other legs
  # force. Unknown names are rejected, never silently reported as absent hardware.
  shift
  _want="$*"
  for _w in $_want; do
    case " usb uvcvideo iwlwifi rtw hci i915 nvrm ata nvme oom " in
      *" $_w "*) ;;
      *) echo "hw-fault-watch --legs: unknown leg '$_w'" >&2; exit 2 ;;
    esac
  done
  legs_wanted(){ [ -z "$_want" ] && return 0; case " $_want " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
  # Fixture overrides are EXCLUSIVE (the MESH_HW_FAULT_CRONSRC precedent): set → the live source is
  # never consulted, so a gate that sets one can never silently assert against the live node.
  _modsrc="${MESH_HW_FAULT_LEGS_MODSRC:-}"; _jrnlsrc="${MESH_HW_FAULT_LEGS_JRNLSRC:-}"
  if [ -n "$_modsrc" ]; then _mods="$(cat "$_modsrc" 2>/dev/null || true)"
  else _mods="$(lsmod 2>/dev/null || true)"; fi
  printf 'hw-fault-watch legs on %s (report-only; INERT = leg names hardware absent here):\n' "$(hostname)"
  _drv_legs=''; _need_jrnl=''
  for _leg in usb uvcvideo iwlwifi rtw hci i915 nvrm ata nvme oom; do
    legs_wanted "$_leg" || continue
    case "$_leg" in oom|usb|ata) continue ;; esac
    _pat="$(legs_pattern "$_leg")"
    _nm="$(printf '%s\n' "$_mods" | grep -ciE "^($_pat)" || true)"
    _drv_legs="$_drv_legs$_leg:${_nm:-0} "
    [ "${_nm:-0}" -gt 0 ] || _need_jrnl="$_need_jrnl$_leg "   # module settles it; journal only for the rest
  done
  # ONE journal pass, counting every still-undecided leg at once. Streamed into awk (never held in a
  # shell var and re-piped), and skipped entirely when every leg already has its module.
  _jc=''
  if [ -n "$_need_jrnl" ]; then
    _prog=''
    for _leg in $_need_jrnl; do
      _prog="$_prog if (l ~ /$(legs_pattern "$_leg")/) c[\"$_leg\"]++;"
    done
    # tolower() not gawk's IGNORECASE — this node's awk is mawk, which does not carry it.
    _awk="{ l=tolower(\$0);$_prog } END{ for (k in c) print k \"=\" c[k] }"
    if [ -n "$_jrnlsrc" ]; then _jc="$(cat "$_jrnlsrc" 2>/dev/null | awk "$_awk" || true)"
    else _jc="$(journalctl -k -b -o cat 2>/dev/null | awk "$_awk" || true)"; fi
  fi
  for _leg in usb uvcvideo iwlwifi rtw hci i915 nvrm ata nvme oom; do
    legs_wanted "$_leg" || continue
    case "$_leg" in
      oom|usb|ata) printf '  %-9s applicable (generic class, not driver-bound)\n' "$_leg"; continue ;;
    esac
    _pat="$(legs_pattern "$_leg")"
    _nm="$(printf '%s ' $_drv_legs | tr ' ' '\n' | sed -n "s/^$_leg://p")"; _nm="${_nm:-0}"
    _nj="$(printf '%s\n' "$_jc" | sed -n "s/^$_leg=//p")"; _nj="${_nj:-0}"
    if [ "$_nm" -gt 0 ] || [ "$_nj" -gt 0 ]; then
      # journal-lines is 'not read' (not 0) where the module already settled presence — a 0 there
      # would be a fabricated absence on a driver that is demonstrably present.
      if [ "$_nm" -gt 0 ] && [ -z "$(printf '%s\n' "$_jc" | sed -n "s/^$_leg=//p")" ]; then
        printf '  %-9s applicable (modules=%s journal-lines=not-read[module settles presence])\n' "$_leg" "$_nm"
      else
        printf '  %-9s applicable (modules=%s journal-lines=%s)\n' "$_leg" "$_nm" "$_nj"
      fi
    else
      printf '  %-9s INERT — no module and no journal line matches /%s/ on this node; the leg cannot fire here (kept: another node may carry it)\n' "$_leg" "$_pat"
    fi
  done
  exit 0
fi

if [ "${1:-}" = --selfprobe ]; then
  selfprobe_report "${2:-7}"; exit $?
fi

refresh_pane_scopes            # keep the scope→pane journal current so a post-respawn OOM still attributes
pass; prc=$?
if [ "$prc" = 2 ]; then
  write_state BLIND 0
  echo "hw-fault-watch: BLIND (dmesg unreadable — sudo -n dmesg failed or hollow)" >&2
  exit 2
fi
write_state "$PASS_TOKEN" "$PASS_NEW"
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
if [ "$PASS_TOKEN" = QUIET ]; then
  if [ "${PASS_BENIGN:-0}" -gt 0 ]; then
    echo "hw-fault-watch: QUIET (${PASS_BENIGN} known-benign fault(s) logged, board-suppressed)"
  else
    echo "hw-fault-watch: QUIET (no new fault lines)"
  fi
fi
exit 0
