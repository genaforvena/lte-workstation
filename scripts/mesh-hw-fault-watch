#!/usr/bin/env bash
# mesh-hw-fault-watch — PERIPHERAL FAULT edge-watch: turn kernel device-fault lines into events.
#
# WHY (proven gap, discover 2026-07-02T13:47Z): the room went blind ~13h on a webcam USB drop
# because NOTHING edge-alerts device faults. mesh-heartbeat's dmesg alert set is the CRASH class
# (panic|oops|thermal|mce|oom|watchdog — mesh-heartbeat:107) and matches neither 'usb disconnect'
# nor 'uvcvideo ... Failed to resubmit video URB'; mesh-node-care greps usb faults but is an
# on-demand diagnostic bundle, never an edge alert. This is the FAULT side of the wired bus;
# mesh-usb-events is the enumerate side (a device can URB-fail while still enumerated).
#
#   mesh-hw-fault-watch           one delta pass: scan new dmesg lines, emit faults, advance offset
#   mesh-hw-fault-watch --status  last state reading, no new scan
#   mesh-hw-fault-watch --test    fixture edge/no-replay/exclusion/BLIND + REAL-read gate
#
# Design constraints (each a logged mesh failure class):
#   - Offset = last-seen ISO timestamp (sudo -n dmesg --time-format=iso; dmesg_restrict=1 on this
#     node, NOPASSWD self-serve verified 2026-07-02) — lexically comparable, survives ring-buffer
#     rotation AND reboot (real-time clock, not boot-monotonic), unlike line-count offsets.
#   - FIRST RUN = baseline only, zero events — never replay the dmesg backlog as fresh faults
#     (32 historic uvcvideo URB fails live in dmesg NOW; the reviving-offset-reflex-replays trap).
#   - BLIND read (sudo/dmesg fails or empty) → exit 2, offset UNTOUCHED — a transient blind pass
#     must not skip-past or replay lines on recovery. Never a fake QUIET.
#   - EXCLUDES mesh-heartbeat's crash set (panic|oops|thermal|throttl|hardware error|mce|
#     out of memory|watchdog) — that class is heartbeat's; no double-alert.
#   - SPEC DEVIATION (anti-noise): bare 'uvcvideo' would alert on normal enumeration ("Found UVC
#     device" on every replug — a healthy event mesh-usb-events already covers); only fault-shaped
#     uvcvideo lines (fail|error|URB|disconnect) alert here.
#   - Board post is per-DRIVER collapsed (one [hw-fault] line per driver per pass, ≤3/pass) +
#     env-gated (MESH_HW_FAULT_CHAT=0 silences; --test sandboxes) — 32 URB fails must not become
#     32 board lines. Full lines go to ~/.mesh/hw-fault.log.
#   - State written EVERY successful pass (mtime = liveness); line 1 token grammar for consumers:
#     FAULT | QUIET | BLIND.
#
# Exit codes: 0 = pass done (faults or quiet) · 2 = dmesg unreadable (honest BLIND, never fake)
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.hw-fault-state"
OFFSET="$STATE_DIR/.hw-fault-offset"
LOG="${MESH_HW_FAULT_LOG:-$STATE_DIR/hw-fault.log}"
CHAT="${MESH_HW_FAULT_CHAT:-1}"
SRC="${MESH_HW_FAULT_SRC:-}"          # test fixture: a file in '<iso-ts> message' shape

# fault classes (case-insensitive). uvcvideo deliberately narrowed — see SPEC DEVIATION above.
FAULT_RE='usb [0-9.-]+.*(disconnect|reset)|uvcvideo.*(fail|error|urb|disconnect)|video urb|iwlwifi.*(fail|error|beacon)|hci[0-9].*error|i915.*(hang|reset)|ata[0-9.]*(\.[0-9]+)?:.*(error|fail)|nvme.*(error|reset)'
# heartbeat's crash set (mesh-heartbeat:107) — owned there, never double-alerted here
EXCL_RE='panic|oops|thermal|throttl|hardware error|\bmce\b|out of memory|watchdog'

read_dmesg(){ # full source in '<iso-ts> message' lines; rc!=0 or empty = BLIND
  if [ -n "$SRC" ]; then cat "$SRC" 2>/dev/null
  else sudo -n dmesg --time-format=iso 2>/dev/null
  fi
}

pass(){ # one delta pass; echoes fault summary lines; sets PASS_TOKEN/PASS_NEW
  local all last new faults ts
  all="$(read_dmesg)" || all=""
  [ -n "$all" ] || return 2
  ts="$(printf '%s\n' "$all" | tail -1 | awk '{print $1}')"
  printf '%s' "$ts" | grep -qE '^[0-9]{4}-' || return 2   # hollow read: not ISO-shaped
  last="$(cat "$OFFSET" 2>/dev/null || true)"
  mkdir -p "$STATE_DIR"
  if [ -z "$last" ]; then
    # first run: baseline the offset, replay NOTHING
    printf '%s\n' "$ts" > "$OFFSET"
    PASS_TOKEN=QUIET; PASS_NEW=0
    return 0
  fi
  new="$(printf '%s\n' "$all" | awk -v last="$last" '$1 > last')"
  faults="$(printf '%s\n' "$new" | grep -iE "$FAULT_RE" | grep -ivE "$EXCL_RE" || true)"
  printf '%s\n' "$ts" > "$OFFSET"
  if [ -z "$faults" ]; then PASS_TOKEN=QUIET; PASS_NEW=0; return 0; fi
  PASS_NEW="$(printf '%s\n' "$faults" | wc -l)"
  PASS_TOKEN=FAULT
  printf '%s\n' "$faults" >> "$LOG"
  # collapse per driver (first word after the timestamp, colon-stripped); ≤3 board lines per pass
  printf '%s\n' "$faults" | awk '{d=$2; sub(/:$/,"",d); n[d]++; l[d]=$0} END{for(d in n) printf "%s\t%d\t%s\n", d, n[d], l[d]}' \
    | head -3 | while IFS=$'\t' read -r drv cnt sample; do
    ev="$(printf '%s' "$sample" | cut -d' ' -f2- | head -c 160)"
    echo "[hw-fault] $drv: $ev (x$cnt new)"
    if [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
      mesh-chat "[hw-fault] $drv: $ev (x$cnt new) — peripheral fault on $(hostname), full lines in ~/.mesh/hw-fault.log" >/dev/null 2>&1 || true
    fi
  done
  return 0
}

write_state(){ printf '%s %s new=%s\n' "$1" "$(date -u +%FT%TZ)" "${2:-0}" > "$STATE"; }

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  # REAL-read gate (verification principle): the actual dmesg source must yield ISO-shaped lines
  real="$(sudo -n dmesg --time-format=iso 2>/dev/null | tail -1)"
  if ! printf '%s' "$real" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T'; then
    echo "smoke-test: n/a (sudo -n dmesg --time-format=iso unreadable/hollow on this node)"; exit 2
  fi
  # fixture logic in a throwaway state dir; ALL outbound sandboxed (chat off + sandbox flag)
  _td="$(mktemp -d)"; _fx="$_td/fx"
  _env="MESH_STATE_DIR=$_td MESH_HW_FAULT_SRC=$_fx MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1"
  printf '%s\n' \
    '2026-07-02T10:00:00,000000+03:00 uvcvideo 1-5:1.1: Failed to resubmit video URB (-1).' \
    '2026-07-02T10:00:01,000000+03:00 loop1: detected capacity change' > "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?   # first run: backlog fault present but must baseline silent
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (first run must baseline, not replay: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:00:02,000000+03:00 usb 1-5: USB disconnect, device number 9' >> "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?   # new fault after baseline: exactly one edge
  { [ "$rc" = 0 ] && [ "$(printf '%s\n' "$out" | grep -cF '[hw-fault]')" = 1 ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (new fault must fire once: rc=$rc out='$out')"; exit 1; }
  out="$(env $_env "$0" 2>&1)"; rc=$?   # unchanged rerun: silent (no replay)
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (rerun replayed: rc=$rc out='$out')"; exit 1; }
  echo '2026-07-02T10:00:03,000000+03:00 CPU0: Package temperature above threshold, cpu clock throttled' >> "$_fx"
  out="$(env $_env "$0" 2>&1)"; rc=$?   # heartbeat-class line: excluded here
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[hw-fault]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (heartbeat crash-class not excluded: rc=$rc out='$out')"; exit 1; }
  off_before="$(cat "$_td/.hw-fault-offset")"
  env MESH_STATE_DIR="$_td" MESH_HW_FAULT_SRC="$_td/nonexistent" MESH_HW_FAULT_CHAT=0 MESH_TEST_SANDBOX=1 "$0" >/dev/null 2>&1; rc=$?
  { [ "$rc" = 2 ] && [ "$(cat "$_td/.hw-fault-offset")" = "$off_before" ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (BLIND must exit 2 + not touch offset: rc=$rc)"; exit 1; }
  rm -rf "$_td"
  echo "smoke-test: ok (real dmesg ISO read + baseline/edge/no-replay/exclusion/BLIND fixtures)"; exit 0
fi

if [ "${1:-}" = --status ]; then
  [ -r "$STATE" ] && cat "$STATE" || echo "hw-fault-watch: no state yet"
  exit 0
fi

pass; prc=$?
if [ "$prc" = 2 ]; then
  write_state BLIND 0
  echo "hw-fault-watch: BLIND (dmesg unreadable — sudo -n dmesg failed or hollow)" >&2
  exit 2
fi
write_state "$PASS_TOKEN" "$PASS_NEW"
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
[ "$PASS_TOKEN" = QUIET ] && echo "hw-fault-watch: QUIET (no new fault lines)"
exit 0
