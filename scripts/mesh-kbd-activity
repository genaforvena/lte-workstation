#!/usr/bin/env bash
# reflex-cadence: 3-59/5 * * * *
# reflex-args: --edge
# mesh-kbd-activity — KEYBOARD ACTIVITY sense: counts i8042 (AT keyboard controller)
# interrupt events from /proc/interrupts over a sampling window. Where i8042 is absent
# (USB keyboards — desktops like default-string), falls back to counting evdev input_event
# bytes read from /dev/input/by-id/*-event-kbd during the window (needs the `input` group).
# Privacy-safe: event COUNT only — never reads keystrokes or their content.
# Local only: /proc/interrupts + /dev/input, zero SSH, zero external deps.
#
#   mesh-kbd-activity           one-shot: events in window + verdict
#   mesh-kbd-activity --json    machine-readable
#   mesh-kbd-activity --edge    emit only on verdict change (2-consecutive debounce)
#   mesh-kbd-activity --test    smoke test (exit 2 = i8042 absent, sense unavailable)
#
# Verdicts:
#   IDLE     0 events in window                   (keyboard untouched)
#   LIGHT    1 – MESH_KBD_THR-1 (default <10)    (occasional taps / shortcuts)
#   TYPING   ≥ MESH_KBD_THR (default 10)          (sustained input)
#
# i8042 is the AT keyboard controller; on this IdeaPad it is IRQ 1 and covers the
# built-in keyboard.  The touchpad (I2C HID) uses a separate IRQ and is not counted.
#
# Exit codes:
#   0  = verdict assessed (IDLE is a real assessment, not an error)
#   2  = no source: i8042 absent AND no readable *-event-kbd device (VM / container /
#        user not in the input group) — sense unavailable, honest n/a
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
STATE="${MESH_KBD_STATE:-$MESH/.kbd-activity.state}"
WINDOW="${MESH_KBD_WINDOW:-3}"
THR="${MESH_KBD_THR:-10}"
# Sum per-CPU interrupt counts for the i8042 line.
# /proc/interrupts: "  N: count0 count1 ... type name"  — numeric fields after label, then strings.
# Reads MESH_KBD_INTERRUPTS at call time (not bind time) so --test can override per-call.
kbd_count() {
  awk '/i8042/{s=0;for(i=2;i<=NF;i++){if($i~/^[0-9]+$/)s+=$i;else break};print s;exit}' \
    "${MESH_KBD_INTERRUPTS:-/proc/interrupts}" 2>/dev/null
}

classify() {
  local delta="$1" thr="$2"
  if   [ "$delta" -eq 0 ] 2>/dev/null; then echo IDLE
  elif [ "$delta" -lt "$thr" ] 2>/dev/null; then echo LIGHT
  else echo TYPING; fi
}

# evdev fallback (no i8042): keyboards enumerated by stable by-id symlinks. A device counts
# only if readable — root:input perms mean the user must be in the `input` group.
# MESH_KBD_EVDEV_GLOB is a test seam (points the glob at synthetic files).
evdev_devs() {
  local d
  for d in ${MESH_KBD_EVDEV_GLOB:-/dev/input/by-id/*-event-kbd}; do
    [ -r "$d" ] && printf '%s\n' "$d"
  done
}

# One input_event struct is 24 bytes on 64-bit (timeval 16 + type 2 + code 2 + value 4).
evdev_bytes_to_events() { echo $(( ${1:-0} / 24 )); }

# Read all keyboard devices in parallel for the window; total events across them.
# A regular file (test seam) EOFs immediately — same math, no wait.
evdev_window_events() {
  local win="$1" d i=0 f n total=0 tdir
  tdir="$(mktemp -d)"
  while IFS= read -r d; do
    ( timeout "$win" cat "$d" 2>/dev/null | wc -c > "$tdir/$i" ) &
    i=$(( i + 1 ))
  done < <(evdev_devs)
  wait
  for f in "$tdir"/*; do
    [ -f "$f" ] || continue
    n="$(cat "$f" 2>/dev/null)"; total=$(( total + ${n:-0} ))
  done
  rm -rf "$tdir"
  evdev_bytes_to_events "$total"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # Classification assertions (FALSIFIABLE: change a threshold → assertion fails)
  [ "$(classify 0  10)" = IDLE   ] || { echo "  FAIL: 0 events→IDLE";    fail=1; }
  [ "$(classify 1  10)" = LIGHT  ] || { echo "  FAIL: 1 events→LIGHT";   fail=1; }
  [ "$(classify 9  10)" = LIGHT  ] || { echo "  FAIL: 9 events→LIGHT";   fail=1; }
  [ "$(classify 10 10)" = TYPING ] || { echo "  FAIL: 10 events→TYPING"; fail=1; }
  [ "$(classify 50 10)" = TYPING ] || { echo "  FAIL: 50 events→TYPING"; fail=1; }
  # awk-sum assertion: synthetic /proc/interrupts with 2 CPUs, two i8042 lines (only first matched)
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  printf '   1:       4000       2000  IR-IO-APIC   1-edge  i8042\n  12:        100        200  IR-IO-APIC  12-edge  i8042\n' \
    > "$td/interrupts"
  MESH_KBD_INTERRUPTS="$td/interrupts" sum=$(kbd_count)
  [ "$sum" = "6000" ] || { echo "  FAIL: awk sum expected 6000 got '$sum'"; fail=1; }
  # Empty file → no i8042 → kbd_count returns empty (→ exit 2 in live path)
  printf '' > "$td/empty"
  empty_sum="$(MESH_KBD_INTERRUPTS="$td/empty" kbd_count)"
  [ -z "$empty_sum" ] || { echo "  FAIL: empty interrupts should return '' got '$empty_sum'"; fail=1; }
  # evdev fallback assertions: byte→event math + windowed read over synthetic "devices"
  # (regular files EOF instantly, so no real 3s wait). 48+24 bytes across 2 devices = 3 events.
  [ "$(evdev_bytes_to_events 48)" = 2 ] || { echo "  FAIL: 48 bytes→2 events"; fail=1; }
  [ "$(evdev_bytes_to_events 23)" = 0 ] || { echo "  FAIL: 23 bytes→0 events (partial struct)"; fail=1; }
  head -c 48 /dev/zero > "$td/kbd-a-event-kbd"; head -c 24 /dev/zero > "$td/kbd-b-event-kbd"
  ev_sum="$(MESH_KBD_EVDEV_GLOB="$td/kbd-*-event-kbd" evdev_window_events 1)"
  [ "$ev_sum" = 3 ] || { echo "  FAIL: evdev window sum expected 3 events got '$ev_sum'"; fail=1; }
  # unreadable device excluded (a perm-denied keyboard must not count as a live source).
  # Skipped as root: root reads through 000 perms, so the exclusion can't be observed there.
  if [ "$(id -u)" != 0 ]; then
    chmod 000 "$td/kbd-a-event-kbd"
    ev_devs="$(MESH_KBD_EVDEV_GLOB="$td/kbd-*-event-kbd" evdev_devs)"
    [ "$ev_devs" = "$td/kbd-b-event-kbd" ] || { echo "  FAIL: unreadable device not excluded (got '$ev_devs')"; fail=1; }
  fi
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  unset MESH_KBD_INTERRUPTS   # bash persists VAR=val sum=$(...) into current shell; clear before live check
  # Live availability check: either source makes the sense LIVE here
  if [ -n "$(kbd_count)" ]; then
    echo "smoke-test: ok (classify:5 + awk-sum:2 + evdev:4 assertions; sense LIVE via i8042 — current total=$(kbd_count) events)"; exit 0
  fi
  live_devs="$(evdev_devs)"
  if [ -n "$live_devs" ]; then
    echo "smoke-test: ok (classify:5 + awk-sum:2 + evdev:4 assertions; sense LIVE via evdev — $(printf '%s\n' "$live_devs" | wc -l) readable kbd device(s))"; exit 0
  fi
  echo "smoke-test: n/a (no i8042 in /proc/interrupts and no readable *-event-kbd device — keyboard sense unavailable here)"; exit 2
fi

# Availability gate: i8042 counter first; else readable evdev keyboards; else exit 2.
s0="$(kbd_count)"
if [ -n "$s0" ]; then SRC=i8042
elif [ -n "$(evdev_devs)" ]; then SRC=evdev
else exit 2; fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0;    [ "${1:-}" = --edge ] && EDGE=1
TS=$(date -u +%H:%M:%SZ)

if [ "$SRC" = i8042 ]; then
  sleep "$WINDOW"
  s1="$(kbd_count)"
  delta=$(( ${s1:-0} - ${s0:-0} ))
  [ "$delta" -lt 0 ] && delta=0   # guard against rare counter reset on reboot race
else
  delta="$(evdev_window_events "$WINDOW")"
fi
rate=$(( delta / WINDOW ))
verdict="$(classify "$delta" "$THR")"

mkdir -p "$MESH" 2>/dev/null || true

if [ "$MODE" = json ]; then
  printf '{"verdict":"%s","events":%d,"rate_per_s":%d,"window_s":%s,"ts":"%s"}\n' \
    "$verdict" "$delta" "$rate" "$WINDOW" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
  elif [ "$verdict" = "$confirmed" ]; then
    rm -f "$PENDING"
  elif [ "$verdict" = "$pending" ]; then
    pcount=$(( pcount + 1 ))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
      printf '[kbd-activity] %s — %d events in %ss (%d/s)\n' "$verdict" "$delta" "$WINDOW" "$rate"
    else
      printf '%s:%d\n' "$verdict" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$verdict" > "$PENDING"
  fi
  # Liveness heartbeat: refresh STATE mtime every run so a STEADY verdict (e.g. hours of
  # IDLE while the operator is away) is NOT read as UNREACHABLE by a freshness-gated consumer
  # (mesh-operator-focus's 10-min staleness gate). Content is only rewritten on a confirmed
  # CHANGE above; this only bumps the mtime — the on-change board/log emit stays change-gated.
  # (Same class as the mesh-stress rewire 51207cd: mtime = liveness; an edge-only writer looks
  # dead to a fresh-gated consumer even when the steady reading is a valid IDLE.)
  [ -s "$STATE" ] && touch "$STATE" 2>/dev/null || true
  exit 0
fi

printf '[kbd-activity] %s — %d events in %ss (%d/s)\n' "$verdict" "$delta" "$WINDOW" "$rate"
