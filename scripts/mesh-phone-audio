#!/usr/bin/env bash
# reflex-cadence: 0 */1 * * *
# doctor-artifact: $HOME/.mesh/.audio-state 3600 phone
# mesh-phone-audio — read the phone's active audio route (speaker, microphone, headset).
# Uses termux-audio-info to query ALSA/audio subsystem state, parses LINADEL control names
# to classify the current audio path (where sound plays, where input is captured).
#
# Output: one-line JSON {audio_route: "speaker"|"mic"|"headset", ...} or error on failure.
# Audio routes (state precedence):
#   "headset"  = headphone/BT output is active (audio plays to headphones, not speaker)
#   "mic"      = external mic is active (input captured from external, not phone speaker mic)
#   "speaker"  = default: internal speaker + phone mic (no headphone or ext mic plugged)
#
#   mesh-phone-audio             one audio-route snapshot
#   mesh-phone-audio --test      smoke test (deps + termux-audio-info callable)
#
# Registry-resolved phone (~/.mesh/nodes / PHONE_IP env var / LAN fallback).
# Honest-organ: phone-unreachable exits 2 (n/a), not a false empty-or-success.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
. "${MESH_PATTERNS:-$HOME/.local/bin/mesh-patterns.sh}" 2>/dev/null || \
  . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
STATE="$HOME/.mesh/.audio-state"
OFFLINEFILE="$HOME/.mesh/.audio-offline"

# classify_audio — PURE (no SSH): parse termux-audio-info JSON on stdin, emit audio-route.
# Scans the `controls` array for LINADEL entries (the ALSA control names that represent
# output/input paths). Precedence: if any headphone/BT output is detected → "headset";
# if external mic is detected → "mic"; else → "speaker" (default internal path).
classify_audio() {
  python3 -c '
import json, sys
def out(d): print(json.dumps(d)); sys.exit(0)
try:
    data = json.load(sys.stdin)
except Exception as e:
    out({"audio_route": "UNKNOWN", "error": "unparseable audio read", "detail": str(e)})

controls = data.get("controls", [])
if not controls:
    out({"audio_route": "speaker", "note": "no controls in audio info, default speaker"})

# Scan for LINADEL control names that indicate active audio paths
# Common patterns: "Headphone", "Speaker", "Microphone", "Line Out", etc.
headphone_active = False
mic_active = False
for ctrl in controls:
    if not isinstance(ctrl, dict):
        continue
    name = ctrl.get("name", "").lower()
    value = ctrl.get("value", 0)

    # Headphone/headset detection (output)
    if any(x in name for x in ["headphone", "headset", "bluetooth", "jack", "aux out", "line out"]):
        if value != 0:
            headphone_active = True

    # External microphone detection (input)
    if any(x in name for x in ["microphone", "ext mic", "line in", "aux in"]) and "headphone" not in name:
        if value != 0:
            mic_active = True

# Precedence: headset > mic > speaker
if headphone_active:
    route = "headset"
elif mic_active:
    route = "mic"
else:
    route = "speaker"

out({"audio_route": route, "controls_count": len(controls), "timestamp": ""})
'
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }

  # Pure classifier unit test (offline)
  s="$(printf '{"controls":[{"name":"Headphone Volume","value":100}]}' | classify_audio)"
  echo "$s" | grep -q '"audio_route": "headset"' || { echo "smoke-test: FAIL (headset classify: $s)"; exit 1; }

  m="$(printf '{"controls":[{"name":"Microphone","value":1}]}' | classify_audio)"
  echo "$m" | grep -q '"audio_route": "mic"' || { echo "smoke-test: FAIL (mic classify: $m)"; exit 1; }

  sp="$(printf '{"controls":[{"name":"Speaker Volume","value":50}]}' | classify_audio)"
  echo "$sp" | grep -q '"audio_route": "speaker"' || { echo "smoke-test: FAIL (speaker classify: $sp)"; exit 1; }

  # Phone reachability + termux-audio-info callable
  pip="$(phone_reachable_ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — audio sense unavailable)"; exit 2; }

  # Retry-once pattern: first SSH may drop in doze window; retry once
  timeout 10 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
    'command -v termux-audio-info' </dev/null >/dev/null 2>&1 \
    || timeout 10 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
    'command -v termux-audio-info' </dev/null >/dev/null 2>&1 \
    || { echo "smoke-test: n/a (termux-audio-info not available on phone)"; exit 2; }

  echo "smoke-test: ok (deps + audio classifier unit + phone reachability)"; exit 0
fi

# Resolve phone IP via canonical function (TS→LAN probe)
# Liveness-touch (mesh-mag/grip pattern): write an honest OFFLINE marker + refresh mtime on every
# unreachable run so $STATE's mtime = reflex-alive (a dead cron never touches → still honest-STALE),
# while the source-down fact lives in the CONTENT. Still exit 2 (honest n/a preserved for mesh-land).
if type phone_reachable_ip >/dev/null 2>&1; then
  pip="$(phone_reachable_ip 2>/dev/null)" || {
    echo "phone unreachable — no audio read (n/a)" >&2
    printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true
    exit 2
  }
else
  pip="$(mesh-phone-ip 2>/dev/null)" || {
    echo "phone unreachable — no audio read (n/a)" >&2
    printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true
    exit 2
  }
fi

PUSER="${PHONE_USER:-u0_a380}"
SSH_OPTS=(-p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new)

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Read termux-audio-info; retry once on first SSH drop (doze window pattern)
audio_json="$(timeout 12 ssh "${SSH_OPTS[@]}" "${PUSER}@${pip}" \
  'termux-audio-info 2>/dev/null' </dev/null 2>/dev/null)" || \
audio_json="$(timeout 12 ssh "${SSH_OPTS[@]}" "${PUSER}@${pip}" \
  'termux-audio-info 2>/dev/null' </dev/null 2>/dev/null)"

if [ -z "$audio_json" ]; then
  if [ ! -f "$OFFLINEFILE" ]; then
    echo "phone unreachable / termux-audio-info failed (not an alarm)" >&2
    touch "$OFFLINEFILE"
  fi
  printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true
  exit 2
fi
rm -f "$OFFLINEFILE"

# Parse and classify
result="$(printf '%s' "$audio_json" | classify_audio 2>/dev/null)" || {
  out="$(printf '{"audio_route":"UNKNOWN","error":"classifier failed","timestamp":"%s"}\n' "$TS")"
  printf '%s' "$out" | tee "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true
  exit 0
}

# Emit with timestamp, and persist the same reading as the doctor-artifact freshness signal.
out="$(printf '%s' "$result" | python3 -c '
import json, sys
from datetime import datetime
try:
    d = json.load(sys.stdin)
    d["timestamp"] = "'$TS'"
    print(json.dumps(d))
except Exception:
    print(json.dumps({"audio_route": "UNKNOWN", "error": "output formatting failed", "timestamp": "'$TS'"}))
')"
printf '%s\n' "$out" | tee "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true
