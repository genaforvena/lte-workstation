#!/usr/bin/env bash
# orphan-ok: on-demand/corroborating sense — read by callers, not cron-wired. Intentionally NOT fused
#   into room-sense's light axis: the webcam measures FIELD-OF-VIEW brightness, which a shadowed/angled
#   lens makes a poor room-ambient proxy (verified 2026-06-24: reads DARK in a lit room), so feeding it
#   as ambient would inject a misleading EMPTY-ward signal. Build-block for explicit FOV-brightness use.
# mesh-cam-light — PHONE-FREE ambient-light sense from the webcam field-of-view.
#
# WHY: mesh-light is phone-only (Termux ambient sensor) and mesh-activity-light is also phone-dependent,
# so when the Redmi is offline the mesh has NO light sense at all (gap found 2026-06-24). This fills it
# with a node-local signal: the mean luminance of the laptop webcam's current frame.
#
# HOW (zero new camera access): mesh-cam-watch --daemon already grabs a frame every ~1.5s and keeps the
# latest at ~/.mesh/cam-prev.jpg for its motion diff. This tool just reads THAT frame and computes its
# mean grayscale — it never opens the camera itself, so there is no device contention and no new privacy
# surface (it reuses a capture the consented motion reflex already made; the frame is never sent or kept
# by this tool). If the daemon is down / the frame is stale, it honestly degrades to UNKNOWN (exit 2) —
# never a faked reading.
#
# NOT a drop-in for mesh-light: the webcam measures FIELD-OF-VIEW brightness (lens may face a wall, be
# shuttered, or sit in shadow), not true room ambient. It is a DISTINCT phone-independent signal. It
# shares mesh-light's 5-level vocab (DARK/DIM/MODERATE/LIT/BRIGHT) so existing grep-consumers can read it,
# but a consumer should treat it as corroborating, not authoritative.
#
#   mesh-cam-light            print the FOV light level (DARK/DIM/MODERATE/LIT/BRIGHT)
#   mesh-cam-light --status   same, one line, no exit-2 noise file
#   mesh-cam-light --test     smoke test (synthetic frames — no camera, no network)
#
# A FLAT frame (luma stddev≈0) means the lens is covered/capped — it reads DARK but is BLIND, not a dark
# room. That is routed to UNKNOWN (exit 2), never a faked DARK (freshness proves the daemon writes, not
# that the lens can see). A genuinely dark room still carries sensor-noise variance (stddev ≳ 2–10).
#
# RESOLVING POWER IS A SECOND CLAIM, AND THE STDDEV GUARD IS NOT IT (info-theory-of-agency, 2026-08-19).
# The flat-field guard above asks "does the frame carry variance?". It does NOT ask "how many scene states
# could this frame tell apart?" — and those come apart on real frames. R. Csaky, "Prediction and Empowerment:
# A Theory of Agency through Bridge Interfaces", arXiv:2605.06346 (7 May 2026), Thm 5: for a deterministic
# experiment I(Z,O_eta) = H(O_eta) — the OBSERVATION'S OWN ENTROPY is the ceiling on what the read can say
# about the latent. Proposition 4 is the operational half: if the informative channel state lies off the
# uncontrolled trajectory, then ANY design that resolves the latent must have nonzero INTERFACE EMPOWERMENT
# (log2 of the distinct channel states the agent can reach). Contrapositive, which is what binds here:
# a sense with ZERO interface empowerment cannot lift its own ceiling — resampling is not refinement.
#
# mesh-cam-light has zero interface empowerment BY CONSTRUCTION: it never opens the camera (see WHY above),
# so it owns no exposure, gain, or illumination parameter. When its read is at the resolving floor the honest
# report is therefore not "retry" but "I am at my floor and no action of MINE lifts it" — naming who owns the
# channel. So every read now publishes `bits=` (the per-frame luma-histogram entropy, 0..8) and a `refine=`
# token. REPORT-ONLY: exit codes and the DARK/DIM/MODERATE/LIT/BRIGHT vocab are untouched; the fields are
# APPENDED at the tail so existing grep-consumers of the level are unaffected.
#
# `bits` is a PROXY, and its limit is stated so nobody quotes it as the paper's quantity: it is the entropy of
# THIS frame's own histogram, an upper bound on what one observation can distinguish — not H(O_eta) over the
# latent ensemble, which needs a corpus of frames across scene states. It is a ceiling, never an achieved I(Z;O).
#
# Measured on this node's real frame corpus 2026-08-19 (n=40 jpgs under ~/.mesh): scene frames cluster
# 5.5-7.6 bits; the degenerate ones sit at 1.76 / 2.39 / 3.56. The live cam-prev.jpg read DARK, exit 0,
# stddev 5.13 (PASSES the flat guard) and carried 3.56 bits. The counterexample that proves the two axes are
# independent: diary-pages/page-...1828460.jpg has stddev 53.90 — seventeen times the FLAT_STDDEV floor — and
# 2.39 bits, i.e. a frame the stddev guard calls richly readable while it can separate almost nothing.
# The 4.5-bit floor is PROVISIONAL, drawn from that gap and env-overridable; it gates NOTHING (report-only),
# so it cannot rot into a behaviour. Re-derive against the live corpus before ever letting it decide anything.
#
# Exit: 0 = real reading · 2 = cannot assess (no/stale frame — daemon down — OR covered/flat lens) — never faked.
# smoke-test: --test checks the classifier (numeric), the flat-field/blind-lens guard, and the staleness guard.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
FRAME="${CAM_LIGHT_FRAME:-$MESH/cam-prev.jpg}"
STALE_LIMIT="${CAM_LIGHT_STALE:-30}"   # seconds; cam-watch refreshes ~every 1.5s, so >30s = daemon down
FLAT_STDDEV="${CAM_LIGHT_FLAT:-3}"     # luma stddev below this = FLAT field → covered/capped lens (BLIND),
REFINE_BITS="${CAM_LIGHT_REFINE_BITS:-4.5}"   # luma-histogram entropy below this = at the RESOLVING FLOOR (report-only)
CHANNEL_OWNERS="${CAM_LIGHT_CHANNEL_OWNERS:-mesh-cam-watch:capture-params,mesh-act:illumination}"  # who owns the world-side channel state we cannot reach
                                       # not a real scene. Conservative low edge: a genuinely dark room
                                       # still carries sensor-noise variance (stddev ≳ 2–10); stddev≈0 =
                                       # blank/covered. Override up if a very-dark room false-flags BLIND.

# Classify a 0-255 mean-grayscale value into mesh-light's 5-level vocab. Thresholds chosen so a covered/
# shadowed lens reads DARK/DIM and a normally-lit room reads MODERATE/LIT (cross-sense-vocab contract).
classify() { awk -v m="$1" 'BEGIN{
  if (m<25) print "DARK"; else if (m<60) print "DIM"; else if (m<120) print "MODERATE";
  else if (m<190) print "LIT"; else print "BRIGHT" }'; }

stat_gray() {  # <jpg> -> "<mean> <stddev> <bits>" on stdout, or empty if unreadable
  # <bits> = entropy of the frame's own 256-bin luma histogram (0..8). Same decode as mean/stddev, so it is
  # free; it is a CEILING on what this one observation can distinguish (arXiv:2605.06346 Thm 5), never an
  # achieved I(Z;O). Third field APPENDED — `read -r m sd` callers keep working.
  python3 - "$1" <<'PYSTAT' 2>/dev/null
import sys, math
try:
    from PIL import Image, ImageStat
    im = Image.open(sys.argv[1]).convert("L")
    st = ImageStat.Stat(im)
    h = im.histogram(); n = sum(h)
    bits = -sum((c/n) * math.log2(c/n) for c in h if c) if n else 0.0
    print("%.1f %.2f %.2f" % (st.mean[0], st.stddev[0], bits))
except Exception:
    pass
PYSTAT
}

# refine_token <bits> -> the Proposition-4 report. This organ reaches NO channel state (it never opens the
# camera), so a floor read can only ever be `none-reachable` here; the owners are named so the caller knows
# where a refinement would have to come from. If this tool ever gains a channel parameter, that branch is
# where a reachable-state count (interface empowerment) would go — and it must be MEASURED, not asserted.
refine_token() {
  awk -v b="$1" -v f="$REFINE_BITS" -v own="$CHANNEL_OWNERS" 'BEGIN{
    if (b+0 >= f+0) print "refine=ok";
    else printf "refine=floor:none-reachable(owner=%s)\n", own }'
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  python3 -c "import PIL" 2>/dev/null || { echo "smoke-test: FAIL (no PIL)"; exit 1; }
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT; e=0
  # classify thresholds — pure/numeric (no frame; decoupled from the flat-field guard below)
  [ "$(classify 5)" = DARK ]      || { echo "FAIL: 5->DARK"; e=1; }
  [ "$(classify 90)" = MODERATE ] || { echo "FAIL: 90->MODERATE"; e=1; }
  [ "$(classify 230)" = BRIGHT ]  || { echo "FAIL: 230->BRIGHT"; e=1; }
  # flat-field (blind-lens) guard: a CONSTANT frame (covered lens) → stddev≈0 → BLIND; a frame with scene
  # variance → stddev>FLAT → readable. (The black/grey/white frames above are constant, so they are also
  # flat — the live path routes them to UNKNOWN; we assert classify() separately on numbers, as above.)
  python3 - "$d" <<'PY'
import sys
from PIL import Image
d=sys.argv[1]
Image.new("L",(64,48),90).save(d+"/flat.jpg")                 # constant → covered lens
im=Image.new("L",(64,48)); px=im.load()
for y in range(48):
    for x in range(64):
        px[x,y]=(x*4+y*3)%200+10                               # gradient bands → real scene variance
im.save(d+"/noisy.jpg")
PY
  fsd="$(stat_gray "$d/flat.jpg"  | awk '{print $2}')"
  nsd="$(stat_gray "$d/noisy.jpg" | awk '{print $2}')"
  awk -v s="$fsd" -v f=3 'BEGIN{exit !(s<f)}'   || { echo "FAIL: flat frame stddev should be <3 (got $fsd)";  e=1; }
  awk -v s="$nsd" -v f=3 'BEGIN{exit !(s>=f)}'  || { echo "FAIL: noisy frame stddev should be >=3 (got $nsd)"; e=1; }
  # staleness guard: a missing frame must yield empty (→ caller UNKNOWN), never a faked value
  [ -z "$(stat_gray "$d/nope.jpg")" ]           || { echo "FAIL: missing-frame should be empty"; e=1; }
  # --- resolving-power axis (arXiv:2605.06346 Thm 5 / Prop 4) ---
  # Gate 1: the entropy is really COMPUTED — a rich scene frame must clear the floor. (Seen red by setting
  # CAM_LIGHT_REFINE_BITS=8: the gradient frame drops to `floor`, so this assertion is not vacuous.)
  nbits="$(stat_gray "$d/noisy.jpg" | awk '{print $3}')"
  [ -n "$nbits" ] || { echo "FAIL: stat_gray must emit a third field (bits)"; e=1; }
  awk -v b="$nbits" 'BEGIN{exit !(b+0 >= 4.5)}' \
    || { echo "FAIL: gradient scene frame should clear the 4.5-bit floor (got $nbits)"; e=1; }
  [ "$(refine_token "$nbits")" = "refine=ok" ] || { echo "FAIL: $nbits bits should be refine=ok"; e=1; }
  # Gate 2 — THE COUNTEREXAMPLE, and the reason this axis is not a restatement of the flat-field guard:
  # a BIMODAL frame (half black, half white) has a HUGE stddev (~127, forty times FLAT_STDDEV) yet carries
  # ~1 bit. The stddev guard calls it richly readable; the entropy floor catches it. This mirrors a real
  # frame on this node (diary-pages/page-...1828460.jpg: stddev 53.90, 2.39 bits). If the two axes were
  # redundant this assertion could not be written.
  python3 - "$d" <<'PYBIMODAL'
import sys
from PIL import Image
d = sys.argv[1]
im = Image.new("L", (64, 48)); px = im.load()
for y in range(48):
    for x in range(64):
        px[x, y] = 0 if x < 32 else 255
im.save(d + "/bimodal.png")          # PNG: JPEG ringing would smear the two levels into a fake histogram
PYBIMODAL
  read -r _bm bsd bbits <<<"$(stat_gray "$d/bimodal.png")"
  awk -v s="$bsd" -v f=3 'BEGIN{exit !(s > 10*f)}' \
    || { echo "FAIL: bimodal frame should have stddev >> FLAT_STDDEV (got $bsd) — counterexample is void"; e=1; }
  awk -v b="$bbits" 'BEGIN{exit !(b+0 < 4.5)}' \
    || { echo "FAIL: bimodal frame should sit BELOW the bit floor (got $bbits)"; e=1; }
  case "$(refine_token "$bbits")" in
    refine=floor:none-reachable*) ;;
    *) echo "FAIL: a floor read must report none-reachable, not ok (bits=$bbits)"; e=1 ;;
  esac
  # Gate 3: REPORT-ONLY — the token names an owner (so a floor read is actionable by SOMEONE), and no floor
  # read may change an exit code. The exit paths are asserted above; here we assert the owner is not empty.
  case "$(refine_token 0)" in
    *"owner=mesh-cam-watch"*) ;;
    *) echo "FAIL: floor token must name the channel owner"; e=1 ;;
  esac
  [ "$e" = 0 ] && echo "smoke-test: ok (3 classify + 2 flat-field + 1 staleness + 7 resolving-power assertions)" || echo "smoke-test: FAIL"
  exit "$e"
fi

status=0; [ "${1:-}" = --status ] && status=1
OFFLINEFILE="$MESH/.cam-light-offline"

# Honest degradation: no frame, or a frame older than STALE_LIMIT, means the motion daemon isn't feeding
# us — we CANNOT see, so say UNKNOWN (exit 2). Never reuse a stale frame as if it were current light.
if [ ! -f "$FRAME" ]; then
  echo "[cam-light] UNKNOWN — no webcam frame ($FRAME); is mesh-cam-watch --daemon running?" >&2
  exit 2
fi
age=$(( $(date +%s) - $(stat -c %Y "$FRAME" 2>/dev/null || echo 0) ))
if [ "$age" -gt "$STALE_LIMIT" ]; then
  echo "[cam-light] UNKNOWN — webcam frame STALE (${age}s > ${STALE_LIMIT}s; cam-watch daemon likely down → cannot read FOV brightness, NOT dark)" >&2
  exit 2
fi

read -r m sd bits <<<"$(stat_gray "$FRAME")"
[ -n "$m" ] || { echo "[cam-light] UNKNOWN — frame unreadable (corrupt/torn JPEG)" >&2; exit 2; }
# flat-field guard: a covered/capped lens still yields a FRESH frame, but a near-constant FLAT field
# (stddev≈0) carries no scene — it reads DARK yet is BLIND, not a dark room. Route to the honest UNKNOWN
# path (exit 2), never a faked DARK. (Freshness proves the daemon writes, not that the lens can see.)
if awk -v s="$sd" -v f="$FLAT_STDDEV" 'BEGIN{exit !(s<f)}'; then
  echo "[cam-light] UNKNOWN — webcam BLIND (lens covered/capped: luma stddev ${sd} < ${FLAT_STDDEV}; mean ${m}/255 is a flat field, NOT a dark room)" >&2
  exit 2
fi
lvl="$(classify "$m")"
[ "$status" = 1 ] || rm -f "$OFFLINEFILE"
# APPEND-ONLY: the level and its existing prose are untouched; `bits=`/`refine=` ride at the tail so a
# consumer grepping the level cannot be shifted by them. A level quoted WITHOUT its resolving ceiling
# invites the reader to treat a 3.5-bit read as if it were a 6.5-bit one — that is the whole point.
echo "[cam-light] $lvl — webcam FOV mean ${m}/255 (phone-free, reuses cam-watch frame ${age}s old) bits=${bits} $(refine_token "$bits")"
exit 0
