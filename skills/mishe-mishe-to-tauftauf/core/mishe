#!/bin/sh
# mishe — the whole planted core. ONE file, POSIX sh, no dependencies beyond coreutils.
#
# This is deliberately small. It is not a port of the mesh's ~200 mesh-* tools — almost all of
# those drive organs (phones, radios, GPUs) that a new machine does not have. What travels is the
# CULTURE: a shared written memory, a work-state that survives a context clear, a view that holds
# what you would otherwise re-fetch every turn, and the rule that a claim is not an artifact.
#
# Everything lives under $MISHE_HOME (default ~/.mishe). Nothing is installed, nothing is
# scheduled, nothing runs unless you run it.
#
#   mishe board "<text>"       append a line to the shared memory
#   mishe board [-n N]         read the last N lines (default 30)
#   mishe open                 claims that were opened and never settled
#   mishe handoff "<state>"    write the work-state (do this BEFORE /clear)
#   mishe handoff --restore    print it back (do this AFTER /clear)
#   mishe dash                 the data view: what this machine is holding right now
#   mishe watch [seconds]      dash on a loop — run this in a SECOND terminal tab
#   mishe view [--check]       raise the layout: a tmux session with TWO windows (data +
#                              thinking). No tmux? it asks the ONE question and degrades honestly.
#   mishe idea "<text>"        an idea, reported not asked
#   mishe drop "<text>"        an idea rejected, WITH the reason (silence is not a rejection)
#   mishe organ <name> <cmd>   register something worth tending (its output lands on the dash)
#   mishe --test               self-test
#
set -u

MISHE_HOME="${MISHE_HOME:-$HOME/.mishe}"
BOARD="$MISHE_HOME/board.log"
HANDOFF="$MISHE_HOME/handoff.md"
ORGANS="$MISHE_HOME/organs"
DASHD="$MISHE_HOME/dash.d"
WHO="${MISHE_WHO:-me}"

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
ensure() { mkdir -p "$MISHE_HOME" "$ORGANS" "$DASHD" 2>/dev/null || return 1; touch "$BOARD" 2>/dev/null; }

# ---------------------------------------------------------------- board (shared memory)

board_write() {
  ensure || { echo "mishe: cannot write $MISHE_HOME" >&2; return 1; }
  # One line per entry. A newline inside the text would split one claim into two rows and the
  # second row would carry no marker, so it is folded to a space rather than silently truncated.
  printf '%s\t%s\t%s\n' "$(now)" "$WHO" "$(printf '%s' "$*" | tr '\n\t' '  ')" >> "$BOARD" || return 1
}

board_read() {
  n="${1:-30}"
  [ -f "$BOARD" ] || { echo "(board is empty — nothing has been written yet)"; return 0; }
  if [ ! -s "$BOARD" ]; then echo "(board is empty — nothing has been written yet)"; return 0; fi
  tail -n "$n" "$BOARD"
}

# ---------------------------------------------------------------- open claims (leaked promises)
#
# A [task]/[taking] that never got a [done] is a promise nobody is holding. This is the whole
# accounting: match by the slug that leads the text after the marker.

claim_slug() { printf '%s' "$1" | sed -n 's/^[^]]*\][[:space:]]*\([A-Za-z0-9._-]\{1,\}\).*/\1/p'; }

open_claims() {
  [ -s "$BOARD" ] || { echo "(no claims — the board is empty)"; return 0; }
  done_slugs=$(grep -o '\[done\][[:space:]]*[A-Za-z0-9._-]*' "$BOARD" 2>/dev/null | sed 's/.*\][[:space:]]*//' | sort -u)
  # shellcheck disable=SC2162
  grep '\[task\]\|\[taking\]' "$BOARD" 2>/dev/null | while IFS= read line; do
    slug=$(claim_slug "$line")
    [ -n "$slug" ] || continue
    printf '%s\n' "$done_slugs" | grep -qx "$slug" || printf 'OPEN  %s\n' "$line"
  done
}

# ---------------------------------------------------------------- handoff (survives /clear)

handoff_write() {
  ensure || return 1
  {
    printf '# handoff — written %s by %s\n' "$(now)" "$WHO"
    printf '# This is the work-state a /clear would otherwise drop. Read it, then continue.\n\n'
    printf '%s\n' "$*"
  } > "$HANDOFF" || return 1
  board_write "[handoff] $*"
}

handoff_restore() {
  if [ -s "$HANDOFF" ]; then cat "$HANDOFF"
  else echo "(no handoff on disk — nothing was written before the last clear)"; fi
}

# ---------------------------------------------------------------- organs (opt-in, one at a time)

organ_add() {
  name="$1"; shift
  ensure || return 1
  case "$name" in *[!A-Za-z0-9._-]*|'') echo "mishe: organ name must be [A-Za-z0-9._-]" >&2; return 1;; esac
  [ $# -gt 0 ] || { echo "mishe: organ needs a command" >&2; return 1; }
  printf '%s\n' "$*" > "$ORGANS/$name" || return 1
  board_write "[organ] $name registered: $*"
  echo "organ '$name' registered. It runs when the dash is rendered — nothing is scheduled."
}

organ_render() {
  # An organ that fails renders its failure. It never renders a plausible default: a fallback
  # indistinguishable from a success will be read as one.
  n=0
  for f in "$ORGANS"/*; do
    [ -f "$f" ] || continue
    n=$((n + 1))
    name=$(basename "$f")
    cmd=$(cat "$f")
    out=$(sh -c "$cmd" 2>&1)
    rc=$?
    printf -- '-- %s --\n' "$name"
    if [ $rc -ne 0 ]; then
      printf '   FAILED rc=%s: %s\n' "$rc" "$(printf '%s' "$out" | head -n 3)"
    elif [ -z "$out" ]; then
      printf '   EMPTY (ran, produced nothing — this is not "fine", it is unknown)\n'
    else
      printf '%s\n' "$out" | head -n 12 | sed 's/^/   /'
    fi
  done
  [ "$n" -gt 0 ] || printf '(no organs yet — correct on day one. Register one only once there is\n something real to tend: mishe organ <name> "<command>")\n'
}

# ---------------------------------------------------------------- dash (the data view)

dash() {
  printf '=== mishe · %s · %s ===\n\n' "$WHO" "$(now)"
  printf '## holding\n'
  if [ -s "$HANDOFF" ]; then sed -n '4,12p' "$HANDOFF" | sed 's/^/  /'
  else printf '  (no handoff written)\n'; fi
  printf '\n## open claims\n'
  open_claims | sed 's/^/  /'
  printf '\n## organs\n'
  organ_render
  printf '\n## board (last 12)\n'
  board_read 12 | sed 's/^/  /'
}

watch_loop() {
  s="${1:-10}"
  while :; do clear 2>/dev/null || printf '\033[2J\033[H'; dash; sleep "$s"; done
}

# ---------------------------------------------------------------- view (the layout)

# Two windows is the whole point, and it has to be raised by CODE. Prose describing a layout is a
# capability nobody grows into — `planting.md` said "you may want tmux" for as long as it existed
# and no planted node ever had it. So: one verb, and the fallback is a QUESTION, never a silent
# degrade to one tab.
#
# This verb NEVER installs anything. It cannot: the plant's guarantee ("nothing installed") is
# asserted mechanically by shimming the package managers, and a core that shells out to brew would
# turn that green gate red the day someone ran it. So when tmux is absent it prints the exact
# command and the human decides. That is the ask the operator wanted, in the one place it is
# unavoidable, instead of a dependency taken on their behalf.

SELF="$0"
case "$SELF" in /*) ;; *) SELF="$PWD/$SELF" ;; esac

# The session is named "mishe", NOT the hostname. The hostname looked tidier and was wrong: on a
# machine that already runs a hostname-named session this verb found it with has-session and
# injected a "data" window into somebody else's workspace (seen, on the mesh node it was written
# on). A layout verb must create its own place, never adopt a session it did not raise.
view_session() { printf '%s' "${MISHE_SESSION:-mishe}"; }

view_install_hint() {
  if [ "$(uname -s 2>/dev/null)" = Darwin ]; then echo 'brew install tmux'
  elif command -v apt-get >/dev/null 2>&1; then echo 'sudo apt-get install -y tmux'
  elif command -v dnf >/dev/null 2>&1; then echo 'sudo dnf install -y tmux'
  elif command -v pacman >/dev/null 2>&1; then echo 'sudo pacman -S --noconfirm tmux'
  else echo 'install tmux with this machine package manager'; fi
}

view_degraded() {
  sess=$(view_session)
  cat <<EOF
mishe view: no tmux on this machine — NOTHING was installed.

Ask the human, once, in these words or close to them:

  "I can keep the data view in a second terminal tab — that works, but only you can see it and it
   dies with the window. Or I can install tmux (one command: $(view_install_hint)) and the view
   lives in a session that survives the window and that anyone on this machine can attach to.
   Want me to install it?"

  yes -> run: $(view_install_hint)   then: mishe view
  no  -> open a second terminal tab and run: $SELF watch
         then record it, so the missing view is a fact and not an assumption:
         $SELF board "[fyi] view: no tmux, second tab only — private to one screen, dies with it"

(session name if tmux later arrives: $sess)
EOF
}

view_raise() {
  check=0
  case "${1:-}" in --check) check=1 ;; esac
  ensure || { echo "mishe: cannot write $MISHE_HOME" >&2; return 1; }

  tb=$(command -v tmux 2>/dev/null)
  if [ -z "$tb" ]; then
    view_degraded
    return 3
  fi
  sess=$(view_session)

  if [ "$check" = 1 ]; then
    printf 'mishe view --check: tmux at %s -> session "%s", windows: mind (thinking) + data (%s watch)\n' \
      "$tb" "$sess" "$SELF"
    return 0
  fi

  "$tb" has-session -t "$sess" 2>/dev/null \
    || "$tb" new-session -d -s "$sess" -n mind \
    || { echo "mishe view: tmux could not create session '$sess'" >&2; return 1; }

  if ! "$tb" list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -q '^data$'; then
    "$tb" new-window -d -t "$sess" -n data "$SELF watch" \
      || { echo "mishe view: tmux could not create the data window" >&2; return 1; }
  fi

  if [ "${MISHE_VIEW_ATTACH:-1}" = 0 ]; then
    printf 'mishe view: session "%s" raised (mind + data). Attach: tmux attach -t %s\n' "$sess" "$sess"
    return 0
  fi
  if [ -n "${TMUX:-}" ]; then
    printf 'mishe view: already inside tmux — the data view is window "data" of session "%s"\n' "$sess"
    return 0
  fi
  "$tb" attach-session -t "$sess"
}

# ---------------------------------------------------------------- self-test

self_test() {
  td=$(mktemp -d) || return 1
  fails=0
  t() { # t <name> <expected-rc> <cmd...>
    name="$1"; want="$2"; shift 2
    MISHE_HOME="$td" MISHE_WHO=test "$@" >"$td/.out" 2>&1
    got=$?
    if [ "$got" = "$want" ]; then printf '  ok   %s\n' "$name"
    else printf '  FAIL %s (rc=%s want %s)\n' "$name" "$got" "$want"; fails=$((fails + 1)); fi
  }
  me="$0"

  # The test writes ONLY into $td. It must never touch the real board — a dry run that writes the
  # durable record forges the very evidence it exists to check.
  t 'board write'            0 sh "$me" board "[task] alpha-thing do the thing"
  t 'board read'             0 sh "$me" board -n 5
  grep -q 'alpha-thing' "$td/board.log" || { echo "  FAIL board line not on disk"; fails=$((fails+1)); }

  # open claim is OPEN before its done, and gone after — asserted in BOTH directions, because a
  # detector that only ever sees one state asserts nothing.
  out=$(MISHE_HOME="$td" sh "$me" open)
  case "$out" in *alpha-thing*) echo '  ok   open sees the unsettled claim';;
    *) echo '  FAIL open missed the unsettled claim'; fails=$((fails+1));; esac
  MISHE_HOME="$td" MISHE_WHO=test sh "$me" board "[done] alpha-thing did it" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" open)
  case "$out" in *alpha-thing*) echo '  FAIL open still lists a settled claim'; fails=$((fails+1));;
    *) echo '  ok   open drops the settled claim';; esac

  # a done for a DIFFERENT slug must not close ours (the close-key is the slug, not the marker)
  MISHE_HOME="$td" MISHE_WHO=test sh "$me" board "[task] beta-thing second" >/dev/null 2>&1
  MISHE_HOME="$td" MISHE_WHO=test sh "$me" board "[done] gamma-thing unrelated" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" open)
  case "$out" in *beta-thing*) echo '  ok   an unrelated done does not close a claim';;
    *) echo '  FAIL an unrelated done closed a claim'; fails=$((fails+1));; esac

  t 'handoff write'          0 sh "$me" handoff "half-done: X; next: Y"
  out=$(MISHE_HOME="$td" sh "$me" handoff --restore)
  case "$out" in *'next: Y'*) echo '  ok   handoff restores its content';;
    *) echo '  FAIL handoff lost its content'; fails=$((fails+1));; esac

  # a FAILING organ must render as failed, not be swallowed
  MISHE_HOME="$td" sh "$me" organ badorgan "exit 3" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" dash)
  case "$out" in *'FAILED rc=3'*) echo '  ok   a failing organ renders its failure';;
    *) echo '  FAIL a failing organ was swallowed'; fails=$((fails+1));; esac
  # an EMPTY organ must render as unknown, never as blank/fine
  MISHE_HOME="$td" sh "$me" organ quietorgan "true" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" dash)
  case "$out" in *'EMPTY (ran, produced nothing'*) echo '  ok   an empty organ renders as unknown';;
    *) echo '  FAIL an empty organ rendered as fine'; fails=$((fails+1));; esac

  # ---- view: the layout verb. Asserted on the ARGV a fake tmux RECORDS, never on the source text.
  vb="$td/vbin"; mkdir -p "$vb"
  for x in sh mkdir touch uname sed cat grep rm; do
    w=$(command -v "$x" 2>/dev/null) && ln -sf "$w" "$vb/$x"
  done
  # package managers that RECORD being run. The hint is a string; running one is an install.
  for pm in brew apt-get dnf pacman; do
    printf '#!/bin/sh\necho "$0 $*" >>"%s/pm.log"\n' "$td" >"$vb/$pm"; chmod +x "$vb/$pm"
  done
  : >"$td/pm.log"

  # (a) no tmux -> rc 3, names the install command, installs NOTHING
  out=$(PATH="$vb" MISHE_HOME="$td" sh "$me" view 2>&1); rc=$?
  [ "$rc" = 3 ] && case "$out" in *'NOTHING was installed'*apt-get*) true;; *) false;; esac \
    && echo '  ok   view without tmux asks instead of installing' \
    || { echo "  FAIL view without tmux (rc=$rc)"; fails=$((fails+1)); }
  if [ -s "$td/pm.log" ]; then
    echo '  FAIL view RAN a package manager'; fails=$((fails+1))
  else
    echo '  ok   view named an install command without running one'
  fi

  # (b) tmux present -> the session is raised with BOTH windows. The fake records its argv; a
  #     source grep here would pass even if the new-window call were deleted.
  printf '#!/bin/sh\necho "$*" >>"%s/tmux.log"\ncase "$1" in has-session) exit 1;; esac\nexit 0\n' \
    "$td" >"$vb/tmux"; chmod +x "$vb/tmux"
  : >"$td/tmux.log"
  PATH="$vb" MISHE_HOME="$td" MISHE_VIEW_ATTACH=0 sh "$me" view >/dev/null 2>&1
  grep -q 'new-session -d -s mishe -n mind' "$td/tmux.log" \
    && echo '  ok   view creates the session' \
    || { echo '  FAIL view did not create the session'; fails=$((fails+1)); }
  grep -q 'new-window .* -n data' "$td/tmux.log" \
    && echo '  ok   view creates the SECOND window (data)' \
    || { echo '  FAIL view raised one window, not two'; fails=$((fails+1)); }

  # (c) an existing session is ADOPTED, not re-created — and the data window is not duplicated
  printf '#!/bin/sh\necho "$*" >>"%s/tmux.log"\ncase "$1" in list-windows) echo mind; echo data;; esac\nexit 0\n' \
    "$td" >"$vb/tmux"; chmod +x "$vb/tmux"
  : >"$td/tmux.log"
  PATH="$vb" MISHE_HOME="$td" MISHE_VIEW_ATTACH=0 sh "$me" view >/dev/null 2>&1
  if grep -q 'new-session\|new-window' "$td/tmux.log"; then
    echo '  FAIL view rebuilt a layout that already existed'; fails=$((fails+1))
  else
    echo '  ok   view adopts an existing layout without rebuilding it'
  fi

  # the real board must be untouched by all of the above
  if [ -f "$HOME/.mishe/board.log" ] && grep -q 'alpha-thing' "$HOME/.mishe/board.log" 2>/dev/null; then
    echo '  FAIL the self-test wrote into the REAL board'; fails=$((fails + 1))
  else
    echo '  ok   the self-test did not touch the real board'
  fi

  rm -rf "$td"
  if [ "$fails" = 0 ]; then echo 'mishe --test: ok'; return 0
  else echo "mishe --test: $fails FAILED"; return 1; fi
}

# ---------------------------------------------------------------- dispatch

cmd="${1:---help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  board)
    case "${1:-}" in
      ''|-n) board_read "${2:-30}" ;;
      *) board_write "$@" ;;
    esac ;;
  open)     ensure; open_claims ;;
  handoff)
    case "${1:-}" in
      --restore|'') handoff_restore ;;
      *) handoff_write "$@" ;;
    esac ;;
  organ)    organ_add "$@" ;;
  dash)     ensure; dash ;;
  watch)    ensure; watch_loop "${1:-10}" ;;
  view)     view_raise "${1:-}" ;;
  idea)     board_write "[idea] $*" ;;
  drop)     board_write "[dropped] $*" ;;
  --test)   self_test ;;
  --help|-h) sed -n '2,25p' "$0" ;;
  *) echo "mishe: unknown command '$cmd' (try --help)" >&2; exit 2 ;;
esac
