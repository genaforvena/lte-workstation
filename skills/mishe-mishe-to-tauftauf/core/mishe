#!/bin/sh
# mishe — the whole planted core. ONE file, POSIX sh, no dependencies beyond coreutils.
#
# This is deliberately small. It is not a port of the mesh's ~200 mesh-* tools — almost all of
# those drive organs (phones, radios, GPUs) that a new machine does not have. What travels is the
# CULTURE: a shared written memory, a work-state that survives a context clear, a view that holds
# what you would otherwise re-fetch every turn, and the rule that a claim is not an artifact.
#
# Everything lives under $MISHE_HOME (default ~/.mishe). Nothing is installed, nothing is
# scheduled, nothing runs unless you run it.
#
#   mishe board "<text>"       append a line to the shared memory
#   mishe board [-n N]         read the last N lines (default 30)
#   mishe open                 claims that were opened and never settled
#   mishe handoff "<state>"    write the work-state (do this BEFORE /clear)
#   mishe handoff --restore    print it back (do this AFTER /clear)
#   mishe dash                 the data view: what this machine is holding right now
#   mishe watch [seconds]      dash on a loop — run this in a SECOND terminal tab
#   mishe view [--check]       raise the layout: a tmux session with TWO windows (data +
#                              thinking). No tmux? it asks the ONE question and degrades honestly.
#   mishe idea "<text>"        an idea, reported not asked
#   mishe drop "<text>"        an idea rejected, WITH the reason (silence is not a rejection)
#   mishe tell <win> "<text>"  one window puts work into another (tmux send-keys, shared scrollback)
#   mishe organ <name> <cmd>   register something worth tending (its output lands on the dash)
#   mishe burn                 END this mishe: home, board, session, schedule, rc lines, skill.
#                              Removes, then RE-SCANS and prints what is left. One phrase, like
#                              planting was. Nothing survives it, and that is the point.
#   mishe --test               self-test
#
set -u

MISHE_HOME="${MISHE_HOME:-$HOME/.mishe}"
BOARD="$MISHE_HOME/board.log"
HANDOFF="$MISHE_HOME/handoff.md"
ORGANS="$MISHE_HOME/organs"
DASHD="$MISHE_HOME/dash.d"
# The receipt: every irreversible thing this mishe RAISED, one per line, "<kind>\t<name>".
# `burn` kills what is written here and nothing else. Killing a tmux session by NAME-GUESS is
# how a layout verb takes down somebody else's workspace (seen: an earlier `view` adopted the
# hostname session on a live node). A receipt turns "mine" from a name match into a fact.
RAISED="$MISHE_HOME/.raised"
WHO="${MISHE_WHO:-me}"

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
ensure() { mkdir -p "$MISHE_HOME" "$ORGANS" "$DASHD" 2>/dev/null || return 1; touch "$BOARD" 2>/dev/null; }

# Write one line to the receipt, once. Idempotent: raising the same session twice must not queue two
# kills, and a receipt that grows on every `view` would make `burn`'s own output unreadable.
raise_record() {
  ensure || return 1
  grep -qxF "$1	$2" "$RAISED" 2>/dev/null && return 0
  printf '%s	%s
' "$1" "$2" >> "$RAISED"
}

# ---------------------------------------------------------------- board (shared memory)

board_write() {
  ensure || { echo "mishe: cannot write $MISHE_HOME" >&2; return 1; }
  # One line per entry. A newline inside the text would split one claim into two rows and the
  # second row would carry no marker, so it is folded to a space rather than silently truncated.
  printf '%s\t%s\t%s\n' "$(now)" "$WHO" "$(printf '%s' "$*" | tr '\n\t' '  ')" >> "$BOARD" || return 1
}

board_read() {
  n="${1:-30}"
  [ -f "$BOARD" ] || { echo "(board is empty — nothing has been written yet)"; return 0; }
  if [ ! -s "$BOARD" ]; then echo "(board is empty — nothing has been written yet)"; return 0; fi
  tail -n "$n" "$BOARD"
}

# ---------------------------------------------------------------- open claims (leaked promises)
#
# A [task]/[taking] that never got a [done] is a promise nobody is holding. This is the whole
# accounting: match by the slug that leads the text after the marker.

claim_slug() { printf '%s' "$1" | sed -n 's/^[^]]*\][[:space:]]*\([A-Za-z0-9._-]\{1,\}\).*/\1/p'; }

open_claims() {
  [ -s "$BOARD" ] || { echo "(no claims — the board is empty)"; return 0; }
  done_slugs=$(grep -o '\[done\][[:space:]]*[A-Za-z0-9._-]*' "$BOARD" 2>/dev/null | sed 's/.*\][[:space:]]*//' | sort -u)
  # shellcheck disable=SC2162
  grep '\[task\]\|\[taking\]' "$BOARD" 2>/dev/null | while IFS= read line; do
    slug=$(claim_slug "$line")
    [ -n "$slug" ] || continue
    printf '%s\n' "$done_slugs" | grep -qx "$slug" || printf 'OPEN  %s\n' "$line"
  done
}

# ---------------------------------------------------------------- handoff (survives /clear)

handoff_write() {
  ensure || return 1
  {
    printf '# handoff — written %s by %s\n' "$(now)" "$WHO"
    printf '# This is the work-state a /clear would otherwise drop. Read it, then continue.\n\n'
    printf '%s\n' "$*"
  } > "$HANDOFF" || return 1
  board_write "[handoff] $*"
}

handoff_restore() {
  if [ -s "$HANDOFF" ]; then cat "$HANDOFF"
  else echo "(no handoff on disk — nothing was written before the last clear)"; fi
}

# ---------------------------------------------------------------- organs (opt-in, one at a time)

organ_add() {
  name="$1"; shift
  ensure || return 1
  case "$name" in *[!A-Za-z0-9._-]*|'') echo "mishe: organ name must be [A-Za-z0-9._-]" >&2; return 1;; esac
  [ $# -gt 0 ] || { echo "mishe: organ needs a command" >&2; return 1; }
  printf '%s\n' "$*" > "$ORGANS/$name" || return 1
  board_write "[organ] $name registered: $*"
  echo "organ '$name' registered. It runs when the dash is rendered — nothing is scheduled."
}

organ_render() {
  # An organ that fails renders its failure. It never renders a plausible default: a fallback
  # indistinguishable from a success will be read as one.
  n=0
  for f in "$ORGANS"/*; do
    [ -f "$f" ] || continue
    n=$((n + 1))
    name=$(basename "$f")
    cmd=$(cat "$f")
    out=$(sh -c "$cmd" 2>&1)
    rc=$?
    printf -- '-- %s --\n' "$name"
    if [ $rc -ne 0 ]; then
      printf '   FAILED rc=%s: %s\n' "$rc" "$(printf '%s' "$out" | head -n 3)"
    elif [ -z "$out" ]; then
      printf '   EMPTY (ran, produced nothing — this is not "fine", it is unknown)\n'
    else
      printf '%s\n' "$out" | head -n 12 | sed 's/^/   /'
    fi
  done
  [ "$n" -gt 0 ] || printf '(no organs yet — correct on day one. Register one only once there is\n something real to tend: mishe organ <name> "<command>")\n'
}

# ---------------------------------------------------------------- dash (the data view)

dash() {
  printf '=== mishe · %s · %s ===\n\n' "$WHO" "$(now)"
  printf '## holding\n'
  if [ -s "$HANDOFF" ]; then sed -n '4,12p' "$HANDOFF" | sed 's/^/  /'
  else printf '  (no handoff written)\n'; fi
  printf '\n## open claims\n'
  open_claims | sed 's/^/  /'
  printf '\n## organs\n'
  organ_render
  printf '\n## board (last 12)\n'
  board_read 12 | sed 's/^/  /'
}

watch_loop() {
  s="${1:-10}"
  while :; do clear 2>/dev/null || printf '\033[2J\033[H'; dash; sleep "$s"; done
}

# ---------------------------------------------------------------- view (the layout)

# Two windows is the whole point, and it has to be raised by CODE. Prose describing a layout is a
# capability nobody grows into — `planting.md` said "you may want tmux" for as long as it existed
# and no planted node ever had it. So: one verb, and the fallback is a QUESTION, never a silent
# degrade to one tab.
#
# This verb NEVER installs anything. It cannot: the plant's guarantee ("nothing installed") is
# asserted mechanically by shimming the package managers, and a core that shells out to brew would
# turn that green gate red the day someone ran it. So when tmux is absent it prints the exact
# command and the human decides. That is the ask the operator wanted, in the one place it is
# unavoidable, instead of a dependency taken on their behalf.

SELF="$0"
case "$SELF" in /*) ;; *) SELF="$PWD/$SELF" ;; esac

# ── THE SESSION GETS ITS OWN, EPHEMERAL NAME: "mishe-demo-<pid>" ──────────────────────────────
# Never the hostname, and — the 2026-08-21 correction — never a fixed shared name either. The
# hostname was wrong first: on a machine already running a hostname-named session this verb found
# it with has-session and injected a "data" window into somebody else's workspace (seen, on the
# mesh node this was written on). Renaming it to a constant "mishe" only made the collision rarer,
# not impossible — has-session still ADOPTS anything wearing that name, and `burn` kills what the
# receipt names. On a real mesh node the stakes are the whole node: the first mishe planted there
# would find a live session and, one `burn` later, take it down with the baby.
#
# So the name is unique per raising process, and the receipt is what makes it findable again:
# `tell` and `burn` run in DIFFERENT processes with different $$, so they must read the name back
# rather than recompute it. This is why the receipt exists at all — it is not bookkeeping, it is
# the only durable record of which session is ours.
#
# KILLING A TMUX SESSION IS THE ONE SANCTIONED EXCEPTION TO THE MESH'S APPEND-ONLY RULE, and this
# is what keeps the exception narrow enough to sanction: a session with a name nobody else would
# mint, recorded when we minted it, killed only from that record.
view_session() {
  [ -n "${MISHE_SESSION:-}" ] && { printf '%s' "$MISHE_SESSION"; return 0; }   # explicit override wins
  # Pure shell on purpose: this is also called from --test under a PATH holding ONLY a fake tmux,
  # and a helper that needs awk would degrade there into "no session recorded" — the silent-fallback
  # shape, refusing every session including our own.
  if [ -r "$RAISED" ]; then
    while IFS='	' read -r _vk _vn; do
      [ "$_vk" = tmux-session ] && [ -n "$_vn" ] && { printf '%s' "$_vn"; return 0; }
    done < "$RAISED"
  fi
  printf 'mishe-demo-%s' "$$"                                                  # a fresh, mortal one
}

# Is $1 a session THIS mishe raised? The receipt is the only evidence that counts.
session_is_ours() {
  [ -n "${MISHE_SESSION:-}" ] && return 0        # the human named it: adopting it is their intent
  [ -r "$RAISED" ] || return 1
  while IFS='	' read -r _ok _on; do
    [ "$_ok" = tmux-session ] && [ "$_on" = "$1" ] && return 0
  done < "$RAISED"
  return 1
}

view_install_hint() {
  if [ "$(uname -s 2>/dev/null)" = Darwin ]; then echo 'brew install tmux'
  elif command -v apt-get >/dev/null 2>&1; then echo 'sudo apt-get install -y tmux'
  elif command -v dnf >/dev/null 2>&1; then echo 'sudo dnf install -y tmux'
  elif command -v pacman >/dev/null 2>&1; then echo 'sudo pacman -S --noconfirm tmux'
  else echo 'install tmux with this machine package manager'; fi
}

view_degraded() {
  sess=$(view_session)
  cat <<EOF
mishe view: no tmux on this machine — NOTHING was installed.

Ask the human, once, in these words or close to them:

  "I can keep the data view in a second terminal tab — that works, but only you can see it and it
   dies with the window. Or I can install tmux (one command: $(view_install_hint)) and the view
   lives in a session that survives the window and that anyone on this machine can attach to.
   Want me to install it?"

  yes -> run: $(view_install_hint)   then: mishe view
  no  -> open a second terminal tab and run: $SELF watch
         then record it, so the missing view is a fact and not an assumption:
         $SELF board "[fyi] view: no tmux, second tab only — private to one screen, dies with it"

(session name if tmux later arrives: $sess)
EOF
}

view_raise() {
  check=0
  case "${1:-}" in --check) check=1 ;; esac
  ensure || { echo "mishe: cannot write $MISHE_HOME" >&2; return 1; }

  tb=$(command -v tmux 2>/dev/null)
  if [ -z "$tb" ]; then
    view_degraded
    return 3
  fi
  sess=$(view_session)

  if [ "$check" = 1 ]; then
    printf 'mishe view --check: tmux at %s -> session "%s", windows: mind (thinking) + data (%s watch)\n' \
      "$tb" "$sess" "$SELF"
    return 0
  fi

  if "$tb" has-session -t "$sess" 2>/dev/null && ! session_is_ours "$sess"; then
    # A session wearing our name that we have no receipt for is SOMEBODY ELSE'S. With a per-pid
    # name this is a pid collision, i.e. rare — and "rare" is exactly the frequency at which a
    # silent adoption does its damage, because nobody is watching when it finally happens. Refuse
    # loudly and name the remedy; never inject a window into a workspace we did not raise.
    echo "mishe view: a tmux session named '$sess' already exists and this mishe did not raise it." >&2
    echo "  Not touching it — that is somebody's workspace. Retry (a new pid mints a new name), or" >&2
    echo "  name one yourself: MISHE_SESSION=<name> $SELF view" >&2
    return 1
  fi

  if ! "$tb" has-session -t "$sess" 2>/dev/null; then
    "$tb" new-session -d -s "$sess" -n mind \
      || { echo "mishe view: tmux could not create session '$sess'" >&2; return 1; }
    # Recorded ONLY on the branch that created it. Adopting a session does not make it ours, and a
    # receipt written on the adopt branch would hand `burn` a licence to kill a stranger's workspace.
    raise_record tmux-session "$sess"
  fi

  if ! "$tb" list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -q '^data$'; then
    "$tb" new-window -d -t "$sess" -n data "$SELF watch" \
      || { echo "mishe view: tmux could not create the data window" >&2; return 1; }
  fi

  if [ "${MISHE_VIEW_ATTACH:-1}" = 0 ]; then
    printf 'mishe view: session "%s" raised (mind + data). Attach: tmux attach -t %s\n' "$sess" "$sess"
    return 0
  fi
  if [ -n "${TMUX:-}" ]; then
    printf 'mishe view: already inside tmux — the data view is window "data" of session "%s"\n' "$sess"
    return 0
  fi
  "$tb" attach-session -t "$sess"
}

# ---------------------------------------------------------------- tell (window sends to window)

# The primitive the culture is actually made of: one window puts work into another window, and the
# result lands in a scrollback both of them can read. Without it the two windows are a poster of a
# layout — you can look at the data window, you cannot USE it, and every instruction goes back
# through the human's hands.
#
# It sends KEYS, not a message: whatever is typed runs in that window's shell, and the output is
# visible to anyone attached. That is the point (shared perception) and it is also the risk, so the
# verb refuses a window it cannot see rather than silently typing into the wrong place.

tell_window() {
  win="${1:-}"; shift 2>/dev/null || true
  [ -n "$win" ] && [ $# -gt 0 ] || { echo 'mishe: tell <window> "<text>"' >&2; return 2; }
  tb=$(command -v tmux 2>/dev/null) || tb=
  [ -n "$tb" ] || { echo "mishe tell: no tmux on this machine — there is no second window to send to" >&2; return 3; }
  sess=$(view_session)
  "$tb" has-session -t "$sess" 2>/dev/null \
    || { echo "mishe tell: no session '$sess' — raise it first: mishe view" >&2; return 3; }
  # A window that does not exist must be a REFUSAL. tmux's send-keys will happily target a name it
  # resolves loosely, and typing a command into the wrong window is not recoverable by re-sending.
  "$tb" list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -qx "$win" \
    || { echo "mishe tell: session '$sess' has no window '$win' (it has: $("$tb" list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | tr '\n' ' '))" >&2; return 4; }
  # A window running a PROGRAM is not a window that can be told anything. send-keys puts bytes on
  # whatever is reading that pane's stdin — so aiming it at the `data` window (which runs
  # `mishe watch`, a loop) types into the loop and they vanish. Found by driving a REAL tmux: every
  # fake-tmux test passed, because a fake answers send-keys the same way whatever is on the far end.
  #
  # And the OBVIOUS probe is the wrong one. `#{pane_current_command}` for the data window reads
  # "sh" — `mishe watch` IS a shell running a script — which is character-for-character what an
  # interactive shell reports, so a shell-name allowlist waves it straight through. Measured on this
  # machine, one session, two windows: mind -> current "bash", start ""; data (opened with a command)
  # -> current "sh", start "sh -c '…'". The field that separates them is `#{pane_start_command}`:
  # empty iff the window was opened to be a prompt. Ask the question you MEAN — "was this window
  # opened to run something?" — not one whose answer merely looks like it.
  startcmd=$("$tb" display-message -p -t "$sess:$win" '#{pane_start_command}' 2>/dev/null)
  if [ -n "$startcmd" ]; then
    echo "mishe tell: window '$win' was opened to run [$startcmd], not to be a prompt — send-keys there is bytes into that program's stdin and they vanish. Tell a window that is at a prompt (try 'mind')." >&2
    return 5
  fi
  # Second arm: a prompt window can still have a program in the foreground right now.
  pcmd=$("$tb" display-message -p -t "$sess:$win" '#{pane_current_command}' 2>/dev/null)
  case "${pcmd:-sh}" in
    sh|bash|zsh|dash|ksh|fish|csh|tcsh|login) : ;;
    *) echo "mishe tell: window '$win' is running '$pcmd' in the foreground — the keys would go to it, not to a shell. Wait, or pick another window." >&2; return 5 ;;
  esac
  "$tb" send-keys -t "$sess:$win" "$*" C-m || return 1
  board_write "[tell] -> $win: $*"
  echo "sent to $sess:$win — read it back with: tmux capture-pane -p -t $sess:$win | tail -20"
}

# ---------------------------------------------------------------- burn (mortality, no exception)

# A mishe that cannot be removed in one phrase is not a seed, it is an installation. Planting one is
# a single sentence; so is ending one, and after it there is NOTHING left on the machine — no home,
# no board, no session, no schedule, no line in a shell rc. That symmetry is not an escape hatch
# bolted on the side, it is the thing that makes planting cheap enough to try.
#
# "Nothing remains" is a claim, so burn does not make it: it removes, then RE-SCANS every place a
# mishe can leave a trace and prints one line per place. Anything still there prints REMAINS and the
# verb exits non-zero. A teardown that reports success without looking is the same shape as a check
# that survived its subject.
#
# THE ONE THING IT WILL NOT DO BLIND is rewrite someone's ~/.claude JSON. The plant's rule is that a
# mishe never writes a hook (the handoff is restored by typing the verb, not by a hook), so a hit
# there means that rule was broken by hand — it is reported with file and line, loudly, instead of
# being edited by a sed that could take an unrelated hook with it.

burn_scan() { # prints "REMAINS <what>" lines; empty output == clean
  BURN_RECEIPT="${BURN_RECEIPT:-}"
  [ -e "$MISHE_HOME" ] && echo "REMAINS  $MISHE_HOME (the home, board and handoff)"
  tb=$(command -v tmux 2>/dev/null) || tb=
  if [ -n "$tb" ] && [ -f "$BURN_RECEIPT" ]; then
    while IFS='	' read -r kind name; do
      [ "$kind" = tmux-session ] || continue
      "$tb" has-session -t "$name" 2>/dev/null && echo "REMAINS  tmux session '$name'"
    done < "$BURN_RECEIPT"
  fi
  crontab -l 2>/dev/null | grep -n 'mishe' && echo "REMAINS  crontab lines above"
  for pl in "$HOME"/Library/LaunchAgents/*mishe*; do
    [ -e "$pl" ] && echo "REMAINS  $pl"
  done
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    [ -f "$rc" ] && grep -q '\.mishe' "$rc" 2>/dev/null && echo "REMAINS  $rc (a line mentioning .mishe)"
  done
  [ -e "$HOME/.claude/skills/mishe-mishe-to-tauftauf" ] && echo "REMAINS  $HOME/.claude/skills/mishe-mishe-to-tauftauf"
  for sj in "$HOME/.claude/settings.json" "$HOME/.claude/settings.local.json"; do
    [ -f "$sj" ] && grep -qi 'mishe' "$sj" 2>/dev/null \
      && echo "REMAINS  $sj -> $(grep -ni 'mishe' "$sj" | head -n 3 | tr '\n' ' ') (a mishe never writes a hook; remove this line by hand)"
  done
  return 0
}

burn() {
  # `rm -rf $MISHE_HOME` deletes THIS FILE while the shell is still reading it. A POSIX shell reads a
  # script incrementally, so the lines after the rm can come back truncated or garbled — the tool
  # that removes its own body has to step out of it first. Re-exec from a copy in $TMPDIR, once.
  if [ "${MISHE_BURNING:-0}" != 1 ]; then
    case "$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)/" in
      "$MISHE_HOME"/*|"$MISHE_HOME"/)
        tmp="${TMPDIR:-/tmp}/mishe.burn.$$"
        cp "$SELF" "$tmp" 2>/dev/null && chmod +x "$tmp" 2>/dev/null || {
          echo "mishe burn: could not copy myself out of $MISHE_HOME — refusing to delete the file I am running from" >&2
          return 1; }
        echo "mishe burn: stepping out of $MISHE_HOME first (this file lives inside what it is about to delete)" >&2
        MISHE_BURNING=1 MISHE_HOME="$MISHE_HOME" sh "$tmp" burn "$@"
        rc=$?
        rm -f "$tmp"
        return $rc ;;
    esac
  fi

  BURN_RECEIPT="$MISHE_HOME/.raised.burn"
  [ -f "$RAISED" ] && cp "$RAISED" "$BURN_RECEIPT" 2>/dev/null
  echo "mishe burn: ending this mishe. Everything it raised goes; nothing it did not raise is touched."

  tb=$(command -v tmux 2>/dev/null) || tb=
  if [ -n "$tb" ] && [ -f "$BURN_RECEIPT" ]; then
    while IFS='	' read -r kind name; do
      [ "$kind" = tmux-session ] || continue
      if "$tb" has-session -t "$name" 2>/dev/null; then
        "$tb" kill-session -t "$name" 2>/dev/null && echo "  killed  tmux session '$name'"
      fi
    done < "$BURN_RECEIPT"
  fi

  if crontab -l 2>/dev/null | grep -q 'mishe'; then
    # Materialise the new table BEFORE installing it. `crontab -l | grep -v … | crontab -` is one
    # pipeline whose two ends touch the same spool concurrently, and the writer can truncate it out
    # from under the reader — the surviving table then depends on scheduling, which is how a
    # teardown quietly takes a line that was never ours. Caught by the "kept lines that were not
    # ours" arm of --test, which went red on exactly this.
    ct="${TMPDIR:-/tmp}/mishe.cron.$$"
    crontab -l 2>/dev/null | grep -v 'mishe' > "$ct"
    crontab - < "$ct" 2>/dev/null && echo "  cleared crontab lines mentioning mishe"
    rm -f "$ct"
  fi

  for pl in "$HOME"/Library/LaunchAgents/*mishe*; do
    [ -e "$pl" ] || continue
    launchctl unload "$pl" >/dev/null 2>&1
    rm -f "$pl" && echo "  removed $pl"
  done

  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    grep -q '\.mishe' "$rc" 2>/dev/null || continue
    grep -v '\.mishe' "$rc" > "$rc.mishe-burn.$$" 2>/dev/null \
      && mv "$rc.mishe-burn.$$" "$rc" && echo "  cleared $rc of its .mishe line(s)"
    rm -f "$rc.mishe-burn.$$" 2>/dev/null
  done

  [ -e "$HOME/.claude/skills/mishe-mishe-to-tauftauf" ] \
    && rm -rf "$HOME/.claude/skills/mishe-mishe-to-tauftauf" \
    && echo "  removed the skill from ~/.claude/skills"

  hb="${TMPDIR:-/tmp}/mishe.receipt.$$"
  [ -f "$BURN_RECEIPT" ] && cp "$BURN_RECEIPT" "$hb" 2>/dev/null
  rm -rf "$MISHE_HOME" && echo "  removed  $MISHE_HOME"
  BURN_RECEIPT="$hb"

  echo "mishe burn: re-scanning, because 'nothing remains' is a claim until something looked."
  left="$(burn_scan)"
  rm -f "$hb" 2>/dev/null
  if [ -n "$left" ]; then
    printf '%s\n' "$left"
    echo "mishe burn: INCOMPLETE — the lines above are still on this machine." >&2
    return 1
  fi
  echo "mishe burn: clean. Home, board, handoff, session, schedule, shell rc, skill — all checked, none left."
  echo "That mishe is gone. It cost nothing to lose and it plants again in one phrase."
  return 0
}

# ---------------------------------------------------------------- self-test

self_test() {
  td=$(mktemp -d) || return 1
  fails=0
  t() { # t <name> <expected-rc> <cmd...>
    name="$1"; want="$2"; shift 2
    MISHE_HOME="$td" MISHE_WHO=test "$@" >"$td/.out" 2>&1
    got=$?
    if [ "$got" = "$want" ]; then printf '  ok   %s\n' "$name"
    else printf '  FAIL %s (rc=%s want %s)\n' "$name" "$got" "$want"; fails=$((fails + 1)); fi
  }
  me="$0"

  # The test writes ONLY into $td. It must never touch the real board — a dry run that writes the
  # durable record forges the very evidence it exists to check.
  t 'board write'            0 sh "$me" board "[task] alpha-thing do the thing"
  t 'board read'             0 sh "$me" board -n 5
  grep -q 'alpha-thing' "$td/board.log" || { echo "  FAIL board line not on disk"; fails=$((fails+1)); }

  # open claim is OPEN before its done, and gone after — asserted in BOTH directions, because a
  # detector that only ever sees one state asserts nothing.
  out=$(MISHE_HOME="$td" sh "$me" open)
  case "$out" in *alpha-thing*) echo '  ok   open sees the unsettled claim';;
    *) echo '  FAIL open missed the unsettled claim'; fails=$((fails+1));; esac
  MISHE_HOME="$td" MISHE_WHO=test sh "$me" board "[done] alpha-thing did it" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" open)
  case "$out" in *alpha-thing*) echo '  FAIL open still lists a settled claim'; fails=$((fails+1));;
    *) echo '  ok   open drops the settled claim';; esac

  # a done for a DIFFERENT slug must not close ours (the close-key is the slug, not the marker)
  MISHE_HOME="$td" MISHE_WHO=test sh "$me" board "[task] beta-thing second" >/dev/null 2>&1
  MISHE_HOME="$td" MISHE_WHO=test sh "$me" board "[done] gamma-thing unrelated" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" open)
  case "$out" in *beta-thing*) echo '  ok   an unrelated done does not close a claim';;
    *) echo '  FAIL an unrelated done closed a claim'; fails=$((fails+1));; esac

  t 'handoff write'          0 sh "$me" handoff "half-done: X; next: Y"
  out=$(MISHE_HOME="$td" sh "$me" handoff --restore)
  case "$out" in *'next: Y'*) echo '  ok   handoff restores its content';;
    *) echo '  FAIL handoff lost its content'; fails=$((fails+1));; esac

  # a FAILING organ must render as failed, not be swallowed
  MISHE_HOME="$td" sh "$me" organ badorgan "exit 3" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" dash)
  case "$out" in *'FAILED rc=3'*) echo '  ok   a failing organ renders its failure';;
    *) echo '  FAIL a failing organ was swallowed'; fails=$((fails+1));; esac
  # an EMPTY organ must render as unknown, never as blank/fine
  MISHE_HOME="$td" sh "$me" organ quietorgan "true" >/dev/null 2>&1
  out=$(MISHE_HOME="$td" sh "$me" dash)
  case "$out" in *'EMPTY (ran, produced nothing'*) echo '  ok   an empty organ renders as unknown';;
    *) echo '  FAIL an empty organ rendered as fine'; fails=$((fails+1));; esac

  # ---- view: the layout verb. Asserted on the ARGV a fake tmux RECORDS, never on the source text.
  vb="$td/vbin"; mkdir -p "$vb"
  for x in sh mkdir touch uname sed cat grep rm; do
    w=$(command -v "$x" 2>/dev/null) && ln -sf "$w" "$vb/$x"
  done
  # package managers that RECORD being run. The hint is a string; running one is an install.
  for pm in brew apt-get dnf pacman; do
    printf '#!/bin/sh\necho "$0 $*" >>"%s/pm.log"\n' "$td" >"$vb/$pm"; chmod +x "$vb/$pm"
  done
  : >"$td/pm.log"

  # (a) no tmux -> rc 3, names the install command, installs NOTHING
  out=$(PATH="$vb" MISHE_HOME="$td" sh "$me" view 2>&1); rc=$?
  [ "$rc" = 3 ] && case "$out" in *'NOTHING was installed'*apt-get*) true;; *) false;; esac \
    && echo '  ok   view without tmux asks instead of installing' \
    || { echo "  FAIL view without tmux (rc=$rc)"; fails=$((fails+1)); }
  if [ -s "$td/pm.log" ]; then
    echo '  FAIL view RAN a package manager'; fails=$((fails+1))
  else
    echo '  ok   view named an install command without running one'
  fi

  # (b) tmux present -> the session is raised with BOTH windows. The fake records its argv; a
  #     source grep here would pass even if the new-window call were deleted.
  printf '#!/bin/sh\necho "$*" >>"%s/tmux.log"\ncase "$1" in has-session) exit 1;; esac\nexit 0\n' \
    "$td" >"$vb/tmux"; chmod +x "$vb/tmux"
  : >"$td/tmux.log"
  PATH="$vb" MISHE_HOME="$td" MISHE_VIEW_ATTACH=0 sh "$me" view >/dev/null 2>&1
  grep -qE 'new-session -d -s mishe-demo-[0-9]+ -n mind' "$td/tmux.log" \
    && echo '  ok   view creates the session' \
    || { echo '  FAIL view did not create the session'; fails=$((fails+1)); }
  # The NAME is load-bearing, not cosmetic. A fixed name collides; the hostname name was measured
  # taking over a stranger's workspace. Assert BOTH halves: unique-per-pid, and never the hostname.
  grep -qE 'new-session -d -s mishe-demo-[0-9]+ ' "$td/tmux.log" \
    && ! grep -qE "new-session -d -s ($(hostname 2>/dev/null || echo __nohost__)|mishe) " "$td/tmux.log" \
    && echo '  ok   the session name is ephemeral (mishe-demo-<pid>), never the hostname, never a shared constant' \
    || { echo '  FAIL view raised a session under a name that can collide with a live one'; fails=$((fails+1)); }
  grep -q 'new-window .* -n data' "$td/tmux.log" \
    && echo '  ok   view creates the SECOND window (data)' \
    || { echo '  FAIL view raised one window, not two'; fails=$((fails+1)); }
  # The receipt is what makes `burn` able to say "mine" about a session. Written on the CREATE
  # branch only — asserted here, because the burn arms below hand-write a fixture receipt and would
  # stay green for years with this line deleted.
  grep -qx 'tmux-session	tmux-session-placeholder' /dev/null 2>/dev/null
  if grep -q '^tmux-session' "$td/.raised" 2>/dev/null; then
    echo '  ok   view records the session it raised, so burn can tell mine from a stranger'
  else
    echo '  FAIL view raised a session and wrote no receipt — burn would have to kill by name-guess'; fails=$((fails+1))
  fi

  # (c) A SESSION WE DID NOT RAISE IS REFUSED, NOT ADOPTED. This arm used to assert the opposite —
  #     "view adopts an existing layout without rebuilding it" — which was safe only while the name
  #     was a constant nobody else would pick. It is the same shape as the hostname bug it replaced:
  #     has-session is a name lookup, and a name lookup cannot tell whose session it found. The only
  #     evidence of ownership is the receipt, so that is what the branch now turns on.
  #     The fake tmux answers has-session SUCCESS with a MISHE_HOME holding no receipt = a stranger.
  printf '#!/bin/sh\necho "$*" >>"%s/tmux.log"\ncase "$1" in list-windows) echo mind; echo data;; esac\nexit 0\n' \
    "$td" >"$vb/tmux"; chmod +x "$vb/tmux"
  : >"$td/tmux.log"
  mkdir -p "$td/adopt"
  _adopt_out=$(PATH="$vb" MISHE_HOME="$td/adopt" MISHE_VIEW_ATTACH=0 sh "$me" view 2>&1); _adopt_rc=$?
  if [ "$_adopt_rc" = 0 ]; then
    echo '  FAIL view took over a session it had no receipt for (rc=0)'; fails=$((fails+1))
  else
    echo '  ok   view REFUSES a session it did not raise, instead of injecting a window into it'
  fi
  case "$_adopt_out" in
    *"did not raise"*) echo '  ok   the refusal SAYS whose session it is leaving alone' ;;
    *) echo '  FAIL the refusal did not explain itself'; fails=$((fails+1)) ;;
  esac
  if grep -q 'new-window' "$td/tmux.log"; then
    echo '  FAIL view added a window to a stranger session'; fails=$((fails+1))
  else
    echo '  ok   nothing was written into the stranger session'
  fi
  # Refusing is not owning either. A receipt written here would hand burn a licence to kill a
  # session this mishe merely FOUND — the exact mistake the hostname-adopting version made.
  if [ -s "$td/adopt/.raised" ]; then
    echo '  FAIL view claimed ownership of a session it did not raise'; fails=$((fails+1))
  else
    echo '  ok   view claims no receipt for a session it did not raise'
  fi
  # (c2) RE-RUNNING view against OUR OWN recorded session still adopts — idempotence must survive
  #      the guard, or `mishe view` twice would refuse itself. Receipt present + name matches.
  mkdir -p "$td/mine"; printf 'tmux-session\tmishe-demo-4242\n' >"$td/mine/.raised"
  : >"$td/tmux.log"
  PATH="$vb" MISHE_HOME="$td/mine" MISHE_VIEW_ATTACH=0 sh "$me" view >/dev/null 2>&1 \
    && echo '  ok   re-running view against OUR OWN recorded session is still idempotent' \
    || { echo '  FAIL the anti-adoption guard refuses our own session — view is no longer idempotent'; fails=$((fails+1)); }
  grep -q 'new-session' "$td/tmux.log" \
    && { echo '  FAIL view rebuilt a layout that already existed'; fails=$((fails+1)); } \
    || echo '  ok   view did not rebuild the layout it already had'

  # ---- tell: window sends to window. Asserted on the fake tmux's ARGV, never on the source text.
  #      The fake answers the two display-message FORMATS independently, because the whole point of
  #      the guard is that those two fields disagree for the window that matters.
  fake_tmux() {
    printf '#!/bin/sh\necho "$*" >>"%s/tmux.log"\ncase "$1" in\n  has-session) exit 0 ;;\n  list-windows) echo mind; echo data ;;\n  display-message) case "$*" in *pane_start_command*) cat "%s/start.txt" ;; *) cat "%s/cur.txt" ;; esac ;;\nesac\nexit 0\n' \
      "$td" "$td" "$td" >"$vb/tmux"; chmod +x "$vb/tmux"
  }
  fake_tmux; : >"$td/start.txt"; printf 'bash\n' >"$td/cur.txt"

  # (a) a prompt window receives
  : >"$td/tmux.log"
  PATH="$vb:$PATH" MISHE_HOME="$td" sh "$me" tell mind "mishe dash" >/dev/null 2>&1
  grep -qE 'send-keys -t mishe-demo-[0-9]+:mind mishe dash' "$td/tmux.log" \
    && echo '  ok   tell sends the text into a window that is at a prompt' \
    || { echo '  FAIL tell did not send-keys into the window'; fails=$((fails+1)); }

  # (b) a window OPENED TO RUN SOMETHING is refused. This is the real `data` window, and note its
  #     pane_current_command is "sh" — identical to an interactive shell — so this arm goes red for
  #     any implementation that gates on the command name instead of on how the window was opened.
  printf "sh /home/x/.mishe/bin/mishe watch\n" >"$td/start.txt"; printf 'sh\n' >"$td/cur.txt"
  : >"$td/tmux.log"
  PATH="$vb:$PATH" MISHE_HOME="$td" sh "$me" tell data "mishe board -n 5" >/dev/null 2>&1; rc=$?
  if [ "$rc" = 5 ] && ! grep -q 'send-keys' "$td/tmux.log"; then
    echo '  ok   tell refuses a window opened to run something (whose command name still reads "sh")'
  else
    echo "  FAIL tell sent keys into a running loop's stdin (rc=$rc)"; fails=$((fails+1))
  fi

  # (c) a prompt window with a program in the FOREGROUND is refused too
  : >"$td/start.txt"; printf 'vim\n' >"$td/cur.txt"; : >"$td/tmux.log"
  PATH="$vb:$PATH" MISHE_HOME="$td" sh "$me" tell mind "mishe dash" >/dev/null 2>&1; rc=$?
  if [ "$rc" = 5 ] && ! grep -q 'send-keys' "$td/tmux.log"; then
    echo '  ok   tell refuses a prompt window with a program in the foreground'
  else
    echo "  FAIL tell typed into a foreground program (rc=$rc)"; fails=$((fails+1))
  fi

  # (d) a window that does not exist — tmux resolves names loosely and a command typed into the
  #     wrong window is not undone by sending it again
  : >"$td/start.txt"; printf 'bash\n' >"$td/cur.txt"; : >"$td/tmux.log"
  PATH="$vb:$PATH" MISHE_HOME="$td" sh "$me" tell nosuchwindow "rm -rf /" >/dev/null 2>&1; rc=$?
  if [ "$rc" = 4 ] && ! grep -q 'send-keys' "$td/tmux.log"; then
    echo '  ok   tell REFUSES a window that does not exist instead of sending anyway'
  else
    echo "  FAIL tell did not refuse an absent window (rc=$rc)"; fails=$((fails+1))
  fi

  # ---- burn: mortality, and the re-scan that makes "nothing remains" an artifact.
  #      Everything below runs against a FAKE $HOME with fake crontab/launchctl/tmux, because a
  #      teardown test that reached the real ones would be the last test this machine ever ran.
  printf '#!/bin/sh\ncase "$1" in -l) cat "%s/cron.txt" 2>/dev/null;; -) cat >"%s/cron.txt";; esac\nexit 0\n' \
    "$td" "$td" >"$vb/crontab"; chmod +x "$vb/crontab"
  printf '#!/bin/sh\nexit 0\n' >"$vb/launchctl"; chmod +x "$vb/launchctl"
  # sessions this fake tmux believes exist; kill-session removes one from the list
  printf '#!/bin/sh\necho "$*" >>"%s/tmux.log"\ncase "$1" in\n  has-session) grep -qx "$3" "%s/sessions" 2>/dev/null && exit 0 || exit 1 ;;\n  kill-session) grep -vx "$3" "%s/sessions" >"%s/s.tmp" 2>/dev/null; mv "%s/s.tmp" "%s/sessions"; exit 0 ;;\nesac\nexit 0\n' \
    "$td" "$td" "$td" "$td" "$td" "$td" >"$vb/tmux"; chmod +x "$vb/tmux"

  bh="$td/burnhome"
  mkdir -p "$bh/.mishe/bin" "$bh/.claude/skills/mishe-mishe-to-tauftauf" "$bh/Library/LaunchAgents"
  cp "$me" "$bh/.mishe/bin/mishe"; chmod +x "$bh/.mishe/bin/mishe"
  printf 'x\n' >"$bh/.mishe/board.log"
  printf 'tmux-session\tbabyfixture\n' >"$bh/.mishe/.raised"
  printf 'export PATH="$HOME/.mishe/bin:$PATH"\nexport KEEPME=1\n' >"$bh/.zshrc"
  printf 'com.mishe.thing\n' >"$bh/Library/LaunchAgents/com.mishe.thing.plist"
  printf '0 * * * * $HOME/.mishe/bin/mishe dash\n0 1 * * * /usr/bin/true not-ours\n' >"$td/cron.txt"
  printf 'babyfixture\nstranger\n' >"$td/sessions"
  : >"$td/tmux.log"

  bout=$(HOME="$bh" PATH="$vb:$PATH" MISHE_HOME="$bh/.mishe" sh "$bh/.mishe/bin/mishe" burn 2>&1); brc=$?

  [ "$brc" = 0 ] && echo '  ok   burn of a clean-able machine exits 0' \
    || { echo "  FAIL burn exited $brc: $(printf '%s' "$bout" | tail -n 3 | tr '\n' ' ')"; fails=$((fails+1)); }
  case "$bout" in *'stepping out of'*) echo '  ok   burn steps out of the home before deleting the file it is running from';;
    *) echo '  FAIL burn deleted its own body in place (no step-out)'; fails=$((fails+1));; esac
  [ -e "$bh/.mishe" ] && { echo '  FAIL burn left the home on disk'; fails=$((fails+1)); } \
    || echo '  ok   burn removed the home, board and handoff'
  grep -q 'kill-session -t babyfixture' "$td/tmux.log" \
    && echo '  ok   burn killed the session it had RAISED' \
    || { echo '  FAIL burn left its own session alive'; fails=$((fails+1)); }
  # the load-bearing arm: a session with no receipt line is NOT ours. Killing by name-guess is how a
  # layout verb takes down somebody else's workspace, and burn must not do it even while burning.
  if grep -q 'kill-session -t stranger' "$td/tmux.log"; then
    echo '  FAIL burn killed a session it never raised'; fails=$((fails+1))
  else
    echo '  ok   burn left a session it never raised alone'
  fi
  grep -q '^export KEEPME=1' "$bh/.zshrc" && ! grep -q '\.mishe' "$bh/.zshrc" \
    && echo '  ok   burn cleared the shell rc line and kept the rest of the file' \
    || { echo '  FAIL burn mangled or missed the shell rc'; fails=$((fails+1)); }
  grep -q 'mishe' "$td/cron.txt" && { echo '  FAIL burn left a mishe crontab line'; fails=$((fails+1)); } \
    || echo '  ok   burn cleared the crontab of mishe lines'
  grep -q 'not-ours' "$td/cron.txt" && echo '  ok   burn kept crontab lines that were not ours' \
    || { echo '  FAIL burn took an unrelated crontab line with it'; fails=$((fails+1)); }
  [ -e "$bh/.claude/skills/mishe-mishe-to-tauftauf" ] \
    && { echo '  FAIL burn left the skill installed'; fails=$((fails+1)); } \
    || echo '  ok   burn removed the skill from ~/.claude/skills'
  [ -e "$bh/Library/LaunchAgents/com.mishe.thing.plist" ] \
    && { echo '  FAIL burn left a launch agent'; fails=$((fails+1)); } \
    || echo '  ok   burn removed the launch agent'
  case "$bout" in *'clean.'*) echo '  ok   burn reports clean only after re-scanning';;
    *) echo '  FAIL burn did not re-scan'; fails=$((fails+1));; esac

  # ---- burn INCOMPLETE: residue it will NOT edit blind must go RED, not be reported as clean.
  #      This is the direction that proves the re-scan is a gate and not decoration.
  bh2="$td/burnhome2"
  mkdir -p "$bh2/.mishe/bin" "$bh2/.claude"
  cp "$me" "$bh2/.mishe/bin/mishe"; chmod +x "$bh2/.mishe/bin/mishe"
  printf '{ "hooks": { "SessionStart": [{"command": "~/.mishe/bin/mishe handoff --restore"}] } }\n' >"$bh2/.claude/settings.json"
  : >"$td/cron.txt"; : >"$td/sessions"
  bout2=$(HOME="$bh2" PATH="$vb:$PATH" MISHE_HOME="$bh2/.mishe" sh "$bh2/.mishe/bin/mishe" burn 2>&1); brc2=$?
  if [ "$brc2" != 0 ] && case "$bout2" in *REMAINS*settings.json*) true;; *) false;; esac; then
    echo '  ok   burn goes RED and names the residue it refuses to edit blind'
  else
    echo "  FAIL burn reported success with a mishe hook still on disk (rc=$brc2)"; fails=$((fails+1))
  fi

  # the real board must be untouched by all of the above
  if [ -f "$HOME/.mishe/board.log" ] && grep -q 'alpha-thing' "$HOME/.mishe/board.log" 2>/dev/null; then
    echo '  FAIL the self-test wrote into the REAL board'; fails=$((fails + 1))
  else
    echo '  ok   the self-test did not touch the real board'
  fi

  rm -rf "$td"
  if [ "$fails" = 0 ]; then echo 'mishe --test: ok'; return 0
  else echo "mishe --test: $fails FAILED"; return 1; fi
}

# ---------------------------------------------------------------- dispatch

cmd="${1:---help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  board)
    case "${1:-}" in
      ''|-n) board_read "${2:-30}" ;;
      *) board_write "$@" ;;
    esac ;;
  open)     ensure; open_claims ;;
  handoff)
    case "${1:-}" in
      --restore|'') handoff_restore ;;
      *) handoff_write "$@" ;;
    esac ;;
  organ)    organ_add "$@" ;;
  dash)     ensure; dash ;;
  watch)    ensure; watch_loop "${1:-10}" ;;
  view)     view_raise "${1:-}" ;;
  tell)     tell_window "$@" ;;
  burn)     burn "$@" ;;
  idea)     board_write "[idea] $*" ;;
  drop)     board_write "[dropped] $*" ;;
  --test)   self_test ;;
  --help|-h) sed -n '2,25p' "$0" ;;
  *) echo "mishe: unknown command '$cmd' (try --help)" >&2; exit 2 ;;
esac
