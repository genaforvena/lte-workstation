{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lte-workstation.local/mesh-manifest.schema.json",
  "title": "lte-workstation source manifest row",
  "type": "object",
  "required": [
    "source_path",
    "installed_basename",
    "domain",
    "kind",
    "deploy_policy",
    "cadence_policy",
    "compatibility_owner"
  ],
  "properties": {
    "source_path": {"type": "string", "minLength": 1},
    "installed_basename": {"type": "string"},
    "domain": {"enum": ["core", "communication", "integrations", "operations", "tests", "ux"]},
    "kind": {"enum": ["tool", "unit", "asset", "fixture", "library"]},
    "deploy_policy": {"enum": ["install", "systemd", "none"]},
    "cadence_policy": {"enum": ["header", "unit", "none"]},
    "compatibility_owner": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
