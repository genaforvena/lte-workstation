# ~/.mesh/capabilities.conf — self-describing capability contracts (node-local, gitignored).
# Copy to ~/.mesh/capabilities.conf and declare what THIS node offers as invocable.
#
# Format:  <name>: <command>
#
# Operator design (2026-06-21): a mesh-card capability is not just a label — it is a
# self-describing COMMAND INVOCATION. Each line below declares a capability this node
# OFFERS plus the command that provides it. The command runs HERE (the provider) with
# THIS node's own secrets/env (variant-1: secrets never leave the node). A consumer on
# any other node invokes it with:
#
#     mesh-organ <name> [text args]          # auto-resolves which node offers <name>
#     mesh-organ --node <thisnode> <name>    # force this provider
#
# and NEVER sees the command or the credentials — only <name> + text args cross the wire
# (encapsulation). Provider-side resolution happens in `mesh-organ --run <name>`.
#
# Declared names auto-surface onto this node's mesh-card actuators, so peers discover and
# may invoke them (card-declared = public). Adding a capability = one line here + a card
# refresh; no mesh-organ code change.

# voice: speak to the operator (Telegram voice note); the bot token stays on this node.
voice: mesh-voice-tx
