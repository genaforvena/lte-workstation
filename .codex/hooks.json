{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "$HOME/.local/bin/mesh-codex-lifecycle --start",
        "timeout": 15
      }]
    }],
    "SessionEnd": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "$HOME/.local/bin/mesh-codex-lifecycle --end",
        "timeout": 30
      }]
    }]
  }
}
