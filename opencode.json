{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "mesh-*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "tmux *": "allow",
      "crontab *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "{env:HOME}/.mesh/*": "allow",
      "{env:HOME}/.mesh/**": "allow",
      "{env:HOME}/.local/bin/*": "allow",
      "{env:HOME}/.local/bin/**": "allow",
      "{env:HOME}/.config/systemd/user/*": "allow",
      "{env:HOME}/.config/systemd/user/**": "allow",
      "/proc/*": "allow",
      "/proc/**": "allow",
      "/sys/**": "allow",
      "/tmp/**": "allow",
      "/etc/shadowsocks-libev/**": "allow",
      "/etc/wireguard/**": "allow"
    }
  }
}
