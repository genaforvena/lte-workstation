{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "tmux display-message *": "allow",
      "crontab *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/sys/class/thermal/**": "allow",
      "/sys/class/power_supply/BAT0/**": "allow",
      "/tmp/**": "allow",
      "/etc/shadowsocks-libev/**": "allow",
      "/etc/wireguard/**": "allow"
    }
  }
}
