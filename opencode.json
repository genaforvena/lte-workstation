{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md", "charter/*.md"],
  "compaction": { "auto": true },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": {
      "*": "allow",
      "{env:HOME}/.mesh/*": "allow",
      "{env:HOME}/.mesh/**": "allow",
      "{env:HOME}/.local/bin/*": "allow",
      "{env:HOME}/.local/bin/**": "allow",
      "{env:HOME}/.config/opencode/*": "allow",
      "{env:HOME}/.config/opencode/**": "allow",
      "{env:HOME}/.config/systemd/user/*": "allow",
      "{env:HOME}/.config/systemd/user/**": "allow",
      "{env:HOME}/lte-workstation/**": "allow",
      "/proc/*": "allow",
      "/proc/**": "allow",
      "/sys/**": "allow",
      "/tmp/**": "allow",
      "/etc/shadowsocks-libev/**": "allow",
      "/etc/wireguard/**": "allow"
    },
    "webfetch": "allow"
  }
}