UNCONFIRMED = MESH / "job/unconfirmed"
# The employment history the blacklist is populated FROM — his own CV files, his own words.
# Globbed, not listed: cv-source carries a date in its name and a new one must not silently
# stop being read. Non-history cv-* notes contribute nothing because EMPLOYER_HEAD matches only
