def answer_questions(vid, employer=""):
    """Ответить на вопросы работодателя ИЗ БАНКА. -> число заполненных | None, если нельзя.

    ОПЕРАТОР СНЯЛ ЗАПРЕТ 2026-08-25 по TG: «все needs-human вы можете смело заполнять за меня,
    включая тесты, опросники». До этого ветка вопросов была тупиком по замыслу — «снять вопрос
    не то же самое, что ответить на него». Теперь отвечаем, но ГРАНИЦА НЕ ИСЧЕЗЛА, она сместилась:
    отвечает БАНК его собственных фактов, а вопрос, которого банк не знает, по-прежнему уходит
    в анкету и держит строку в needs-human. Разрешение снимает запрет ОТВЕЧАТЬ, оно не даёт
    права ВЫДУМЫВАТЬ — неподтверждённое поле блокирует отклик, как и раньше.

    ВСЁ ИЛИ НИЧЕГО. Частично заполненная анкета отправляется работодателю с пустыми полями и
    читается как небрежность; поэтому либо банк покрывает ВСЕ вопросы, либо не заполняется ни
    одно и строка ведёт себя ровно как до этой правки.

    ПАРА «ВОПРОС — ПОЛЕ» БЕРЁТСЯ ИЗ РАЗМЕТКИ hh, А НЕ ИЗ ДОГАДКИ О ГЛУБИНЕ РОДИТЕЛЯ (см. блок над
    TASK_JS: подъём по родителям не доезжал до контейнера и читал ВСЕ поля как ''). Один
    `[data-qa=task-body]` — один вопрос и его собственные поля; вопрос из него достаётся ТОЙ ЖЕ
    построчной грамматикой, которой пользуется `harvest_questions`, а заполняется поле по своему
    `name`, а не по порядковому номеру среди всех textarea страницы.

    БЛОК, КОТОРЫЙ НЕЛЬЗЯ ПРОЧИТАТЬ ОДНОЗНАЧНО, УХОДИТ В АНКЕТУ ЦЕЛИКОМ И НЕ ЗАПОЛНЯЕТСЯ. Два
    вопроса в одном поле — это не «сложный вопрос», это вопрос, на который банк ответит наполовину
    и промолчит про вторую половину; в поле работодателя это неотличимо от невнимательности."""
    mark = log_size()
    drive(["--send", "js " + TASK_JS])
    if not wait_log(mark, "[js] ", 60):
        return None, ""
    lines = [l for l in log_since(mark).splitlines() if l.startswith("[js] ")]
    if not lines:
        return None, ""
    try:
        blocks = json.loads(lines[-1][len("[js] "):].strip())
    except Exception:
        return None, ""
    # НЕТ КОНТЕЙНЕРОВ — НЕТ ОТВЕТА. Раньше здесь стоял общий подъём по родителям любой textarea, и
    # именно он на живой форме возвращал ''. Разметки нет — значит форма другая, чем измеренная, и
    # честный исход тут отказ (строка уходит человеку и к двери «без теста» этажом выше), а не
    # догадка о том, какой кусок текста был вопросом.
    if not blocks:
        return None, FORM_UNREADABLE + ": разметки вопросов на странице нет"

    plan, missing, unreadable = [], [], []
    for b in blocks:
        text = (b or {}).get("t") or ""
        fields = [f for f in ((b or {}).get("ta") or []) if f]
        q, why = block_question(text)
        if not q:
            # Вопрос НЕ ПРОЧИТАН ОДНОЗНАЧНО — спрашивать банк нечем. Строки блока уходят в анкету
            # той же построчной рукой (`harvest_questions` вызывается этажом выше), а сюда
            # возвращается отказ.
            missing.append("(%s)" % (why or "блок формы не прочитался"))
            unreadable.append(why)
            continue
        if not answerable(q):
            missing.append("(вопрос не прочитался: пустое поле формы)")
            unreadable.append("пустой текст вопроса")
            continue
        if not fields:
            # Радиогруппа-аттестация без свободного поля (Ozon): подписывать за него утверждение о
            # достоверности резюме мы не будем — этажом выше есть собственная дверь работодателя
            # «Откликнуться без теста», и отказ здесь именно к ней и ведёт. Если двери нет — это
            # форма, которую тул НЕ ВЕДЁТ, а не пробел в банке: банк не отрастит поле ввода.
            missing.append(q)
            unreadable.append("вопрос без поля ввода")
            continue
        # СВОЙ ВАРИАНТ РЯДОМ С РАДИОГРУППОЙ. Поле 401 на 135307229 — свободный текст ПРИ четырёх
        # переключателях, и заполнить его, не выбрав «свой вариант», значит отправить вопрос без
        # ответа. Переключатель опознаётся по МАШИННОМУ `value=open` (замер: три перечисленных
        # варианта несут числовые id, свой — литерал `open`), а не по локализованной подписи.
        # Выбрать вместо этого один из перечисленных вариантов мы не можем: его ответ про график
        # шире любого из них, и сузить его — это выдумать за него.
        own = [g for g in ((b or {}).get("own") or []) if g]
        if ((b or {}).get("rad") or 0) and not own:
            missing.append(q)
            unreadable.append("радиогруппа без свободного варианта")
            continue
        r = subprocess.run([ANSWERS, "--match", q], capture_output=True, text=True, timeout=60)
        a = (r.stdout or "").strip()
        if r.returncode == 0 and a:
            plan.append((fields[0], own[0] if own else "", a))
        else:
            missing.append(q)
            subprocess.run([ANSWERS, "--queue", q, "--origin", "hh:%s" % vid],
                           capture_output=True, text=True, timeout=30)
    if missing or not plan:
        return None, ((FORM_UNREADABLE + ": " + unreadable[0]) if unreadable else "")

    for field, own, a in plan:
        if own:
            drive(["--send", "click input[name=%s][value=open]" % own])
            drive(["--send", "wait 500"])
        drive(["--send", "fill textarea[name=%s] %s" % (field, " ".join(a.split()))])
        drive(["--send", "wait 800"])
    return len(plan), ""


def submit_response_page(vid, letter, filled):
    """Отправить отклик со СТРАНИЦЫ /applicant/vacancy_response (не из поп-апа).

    -> ('sent'|'needs-human'|'failed', detail, reason). Клик не считается отправкой: подтверждение
    здесь — слово «You applied»/«Вы откликнулись» на самой вакансии, и его проверяет caller
    отдельным проходом по списку откликов. Отсюда возвращается только то, что видно СРАЗУ.

    Поле письма на этой странице появляется ТОЛЬКО после клика по «Add»/«Добавить» — до него
    textarea с data-qa …letter-input в DOM нет, и «письмо не заполнилось» неотличимо от «письма
    не просили». Поэтому кнопка жмётся, а наличие поля потом ПРОВЕРЯЕТСЯ, а не предполагается.
    """
    drive(["--send", "clicktext Add"])
    drive(["--send", "wait 2000"])
    drive(["--send", "clicktext Добавить"])
    drive(["--send", "wait 2000"])
    mark = log_size()
    drive(["--send", "js () => JSON.stringify({letter: !!document.querySelector("
                     "'[data-qa=vacancy-response-popup-form-letter-input]')})"])
    if not wait_log(mark, "[js] ", 60):
        return "failed", "страница не ответила после раскрытия поля письма", ""
    have_letter = '"letter": true' in log_since(mark) or '"letter":true' in log_since(mark)
    if have_letter:
        LETTERS.mkdir(parents=True, exist_ok=True)
        lf = LETTERS / ("%s-%s.txt" % (time.strftime("%Y-%m-%d"), vid))
        lf.write_text(letter.strip() + "\n", encoding="utf-8")
        drive(["--send", "settext textarea[data-qa=vacancy-response-popup-form-letter-input] %s" % lf])
        drive(["--send", "wait 1500"])

    mark2 = log_size()
    drive(["--send", "click [data-qa=vacancy-response-submit-popup]"])
    drive(["--send", "wait 7000"])
    drive(["--send", "js () => JSON.stringify({applied: /You applied|Вы откликнулись|Отклик отправлен/i"
                     ".test(document.body.innerText||'')})"])
    if not wait_log(mark2, "[js] ", 90):
        return "failed", "страница не ответила после отправки — состояние НЕИЗВЕСТНО", ""
    out = log_since(mark2)
    if '"applied": true' in out or '"applied":true' in out:
        return "sent", ("отклик отправлен со страницы, %d вопрос(ов) отвечено из банка%s"
                        % (filled, "" if have_letter else " (поле письма не предлагалось)")), ""
    return "failed", "отклик со страницы отправлен, но подтверждения на вакансии нет", ""


def apply_one(row, letter):
    """-> ('sent'|'needs-human'|'failed', detail, reason). Never trusts a click; the caller verifies.

    hh's response flow is a POPUP now, and this used to drive the older one. Measured 2026-08-20
    over ten filed applications: clicking the response link opens a dialog carrying the cover
    letter textarea (`vacancy-response-popup-form-letter-input`) and its own submit
    (`vacancy-response-submit-popup`) — the letter goes in BEFORE the application is filed, not
    attached to an already-filed one. The old path clicked `responded-success-attach-cover-letter`,
    which no longer exists, so every one of those ten went out with the resume alone and hh's chat
    shows a bare "Vacancy application" where his DSP paragraph should be. The applications were
    real; the packaging was silently dropped — a failure that looks like success in every count.
    """
    vid = row["id"]
    # Путь до формы — ОДИН, общий с рукой, снимающей вопросы (--reopen --harvest). Написать его
    # там заново значило бы собирать анкету с одной формы, а подавать другую.
    # A click that never landed must stop the row here. Letting it fall through meant every
    # following verb typed into a page with no form, and the failure was reported one cause
    # downstream ("поле сопроводительного не открылось") — naming the modal for what was
    # actually a missing button.
    state, err, reloc = open_response(vid)
    if err:
        return nh(err) if reason_of(err) != R_UNKNOWN else ("failed", err, "")

    if "/applicant/vacancy_response" in state:
        # РАНЬШЕ ЗДЕСЬ БЫЛ ТУПИК, ПОТОМ СБОРЩИК ВОПРОСОВ, ТЕПЕРЬ ОТВЕТ. Оператор снял запрет
        # 2026-08-25 («все needs-human вы можете смело заполнять за меня, включая тесты,
        # опросники»), поэтому вопросы, на которые отвечает БАНК его фактов, заполняются и отклик
        # уходит. Вопрос, которого банк не знает, по-прежнему держит строку: сместилась граница,
        # а не исчезла.
        filled, why = answer_questions(vid, row.get("employer", ""))
        if filled is None:
            # THE EMPLOYER'S OWN ESCAPE HATCH, TAKEN ONLY AFTER THE BANK HAS FAILED. Measured
            # 2026-08-28 on Ozon Банк 136185682 and Ozon Tech 135988653: the screening item is a
            # RADIO GROUP (`name=task_349142621`, options «В моём резюме только достоверная
            # информация» / «Да»), and the page carries ZERO textareas. Both paths in this file
            # were structurally blind to it — `answer_questions` reads only `textarea`, so it
            # returned None, and `harvest_questions` keys on '?' or an interrogative opener, so an
            # ATTESTATION («Настоящим подтверждаю, что предоставленные сведения…») matched nothing
            # and the row recorded "вопросы не сняты со страницы — сверять не с чем". That is a
            # BLINDNESS verdict issued over 1265 bytes of form text we had read and filed: seven
            # rows sat in needs-human on it, the whole Ozon bucket, unreachable by construction.
            #
            # The fix is NOT to tick the attestation. It asserts, in HIS name, that his resume is
            # accurate — a fact this tool cannot verify, and the permission to ANSWER has never
            # been a permission to INVENT (the rule the letter path and the answer bank both keep).
            # hh renders `[data-qa=vacancy-response-link-no-questions]` — «Откликнуться без теста»,
            # the employer's OWN offer to be applied to without the screening — so the honest move
            # is to take the door Ozon itself opened rather than to sign something for him.
            #
            # IT FILES IMMEDIATELY AND CARRIES NO LETTER: measured, one click and the page is back
            # on /vacancy/<id> already showing `vacancy-response-link-view-topic` ("Chat"), with no
            # confirmation step. So this returns the SAME pending-letter sentinel as the other
            # letterless path — the negotiations list stays the only judge that an application
            # happened, and `letter_into_chat` packages it afterwards from finalize's hand. Return
            # it here and the letter is delivered; return a bare "sent" and it is silently dropped.
            if no_test_link():
                return "sent", "отклик подан без теста (кнопка работодателя); " + PENDING_LETTER, ""
            n = harvest_questions(vid, row.get("employer", ""))
            # ПРИЧИНА НАЗЫВАЕТ ТОГО, КТО ЕЁ СНИМЕТ, и здесь их ДВОЕ, а до 2026-08-29 обе строки
            # получали одну и ту же — `questions`, то есть «снимет банк». Для формы, которую эта
            # рука не читает однозначно, банк не сделает ничего: пере-открыватель судит по покрытию
            # банка, видит снятые построчно чистые вопросы, объявляет причину снятой и возвращает
            # строку в круг. `form` («снимет: КОД») ходит через потолок попыток и гейт по mtime
            # этого файла — открывается ровно тогда, когда форму действительно повёл другой код.
            if why.startswith(FORM_UNREADABLE):
                return nh("незнакомая разновидность формы вопросов: %s — снял %d строк(и) в анкету"
                          % (why[len(FORM_UNREADABLE):].lstrip(": "), n))
            return nh(("работодатель задаёт свои вопросы, банк покрыл не все — снял %d в анкету" % n)
                      if n else "работодатель задаёт свои вопросы, и банк их не покрывает")
        st, det, rsn = submit_response_page(vid, letter, filled)
        return (st, det, rsn)

    if '"popup": true' in state or '"popup":true' in state:
        # hh blocks some vacancies behind a RESUME-VISIBILITY change. That is a profile edit on his
        # account, not a form field, so it stops here by design rather than being clicked through.
        # ЭТО ПРЕДУПРЕЖДЕНИЕ, А НЕ ОТКАЗ — измерено 2026-08-25 (tg, вручную, LLC Гарда
        # Технологии 136538257). Страница отклика несла ровно эту фразу, кнопка отправки была
        # НЕ disabled, отклик ушёл и вакансия показала «You applied» + «Chat», при этом видимость
        # резюме не менялась вовсе. Более того, hh называет варианты («Видно всему интернету»,
        # «компаниям-клиентам HeadHunter»), которых в её собственном UI видимости НЕТ: там пять
        # других опций, и резюме уже стоит в самой открытой из них. Отказ по этой строке закрывал
        # отклики, которые прошли бы. Решает СОСТОЯНИЕ КНОПКИ, а не текст рядом с ней.
        # КНОПКА ЧИТАЛАСЬ ДО ТОГО, КАК В ФОРМУ ЧТО-ЛИБО ПОЛОЖИЛИ. Проверка `submitDisabled` стояла
        # ЗДЕСЬ — сразу после открытия поп-апа, ДО set письма, — а hh держит submit выключенным,
        # пока обязательное поле пусто. То есть отказ снимался с состояния, которое наша же
        # следующая строка и должна была изменить. Замер 2026-08-28: пять строк доски (nau,
        # Р-Софт, АФЛТ-Системс, Бегачева, DigiKey) держались этим отказом, и все пять — форма с
        # полем письма, которое мы так и не заполнили. Тот же класс, что «предупреждение — не
        # отказ» абзацем выше, только на оси ВРЕМЕНИ, а не текста: гейт, снятый ДО действия,
        # которое он гейтит, измеряет наше бездействие. Проверка переехала ЗА заполнение.
        if '"ta": false' in state or '"ta":false' in state:
            return nh("поп-ап отклика без поля письма — незнакомая разновидность формы")
        # The letter reaches the form through a FILE, and it is the same file the caller archives:
        # one artifact, so the copy on disk cannot drift from what the employer received.
        LETTERS.mkdir(parents=True, exist_ok=True)
        lf = LETTERS / ("%s-%s.txt" % (time.strftime("%Y-%m-%d"), vid))
        lf.write_text(letter.strip() + "\n", encoding="utf-8")
        mark3 = log_size()
        drive(["--send", "settext textarea[data-qa=vacancy-response-popup-form-letter-input] %s" % lf])
        time.sleep(3)
        if "[FAIL]" in log_since(mark3):
            return nh("поле письма в поп-апе не приняло текст")
        # Assert the letter is IN the field before submitting. A fill that silently no-ops would
        # otherwise send a bare application and report a letter — the exact failure being fixed.
        mark4 = log_size()
        drive(["--send", "js () => (document.querySelector('[data-qa=vacancy-response-popup-form-letter-input]')||{}).value?.length || 0"])
        if not wait_log(mark4, "[js] ", 40):
            return nh("не смог прочитать длину письма в поле")
        got = [l for l in log_since(mark4).splitlines() if l.startswith("[js] ")][-1]
        try:
            n = int(re.sub(r"\D", "", got.split("[js] ")[-1]) or 0)
        except ValueError:
            n = 0
        if n < 100:
            return nh("письмо не попало в поле (в нём %d символов)" % n)
        # ТЕПЕРЬ — и только теперь — состояние кнопки является фактом о ФОРМЕ, а не о том, что мы
        # ещё ничего не ввели. Забираем вместе с ним текст диалога: если и с заполненным письмом
        # отправка выключена, следующая рука должна читать, ЧТО именно требует hh, а не гадать.
        mark5 = log_size()
        drive(["--send", "js () => { const p = document.querySelector('[data-qa=vacancy-response-submit-popup]');"
                         " const d = p ? p.closest('[role=dialog]') : null;"
                         " return JSON.stringify({sd: p ? !!p.disabled : null,"
                         " txt: d ? d.innerText.slice(0, 300) : ''}); }"])
        if wait_log(mark5, "[js] ", 40):
            post = [l for l in log_since(mark5).splitlines() if l.startswith("[js] ")][-1]
            if '"sd": true' in post or '"sd":true' in post:
                dump = MESH / "job/formdump-blocked-%s.txt" % vid
                dump.parent.mkdir(parents=True, exist_ok=True)
                dump.write_text(post, encoding="utf-8")
                return nh("кнопка отправки заблокирована и с заполненным письмом — форму тул не"
                          " ведёт (дамп: %s)" % dump.name)
        drive(["--send", "click [data-qa=vacancy-response-submit-popup]"])
        time.sleep(6)
        return "sent", "отправлено из поп-апа с письмом (%d символов)" % n, ""

    # Поп-апа нет. На этом пути у hh нигде нет поля письма, и единственное место, где письмо ещё
    # может дойти до работодателя, — ЧАТ отклика: именно там hh показывает сопроводительные
    # (голый отклик рендерится словами «Vacancy application» и больше ничем).
    #
    # НО ЧАТ СУЩЕСТВУЕТ ТОЛЬКО У СУЩЕСТВУЮЩЕГО ОТКЛИКА, а здесь мы ещё не знаем, что он есть:
    # отсутствие поп-апа — это отсутствие поп-апа, а не поданный отклик (в этом же файле, ветка
    # снятия причин, это записано с 2026-08-24). 2026-08-28 в одном прогоне 13 строк прошли этой
    # веткой, и все 13 попытались положить письмо в чат, которого нет: «чат по вакансии не
    # найден» — потому что hh не подала отклик. Тринадцать заходов в чат-лист ради ничего.
    #
    # Поэтому здесь письмо НЕ отправляется. Судья один — finalize, сверяющий со списком откликов
    # hh, и упаковка едет ПОСЛЕ подтверждения, из его руки. Возврат остаётся предварительным
    # «sent»: это вердикт apply_one о своём шаге, а не о состоявшемся отклике.
    return "sent", ("отклик подан по ссылке (снято предупреждение hh «отклик из другой страны»); "
                    if reloc else "отклик подан по ссылке; ") + PENDING_LETTER, ""


def thread_needle(letter):
    """Нить, которую ОБА плеча доставки ищут в треде. Строится ОДИН раз, здесь.

    Она обязана пережить `innerText`, который СОХРАНЯЕТ переносы строк письма. Плечо
    пост-проверки строило свою нить само — `" ".join(letter.split())[:40]`, то есть СХЛОПЫВАЛО
    пробелы, — и для любого письма, чья первая строка короче 40 символов, нить пересекала разрыв
    абзаца и не могла совпасть НИКОГДА. Замерено 2026-08-29 на живом корпусе: 102 письма из 112,
    то есть плечо писало «письма нет в треде после отправки» про письмо, которое в треде лежит
    (проверено вживую на 136742045: тред содержит письмо, плечо сказало false). Одна очищенная
    СТРОКА разрыв пересечь не может — ровно поэтому дедуп-плечо этим не болело, и ровно поэтому
    два плеча не должны строить нить порознь: предикат, который не является предикатом читателя,
    не охраняет читателя.
    """
    for ln in (letter or "").splitlines():
        s = ln.strip()
        if len(s) > 40 and not s.lower().startswith("здравствуйте"):
            return s[:60]
    return " ".join((letter or "").split())[:40]


def letter_into_chat(vid, letter, title, employer=""):
    """Post the cover letter as the first message of a filed application's chat. -> (ok, why).

    The chat is NOT reachable from the negotiations list: `[data-qa=open_chat]` is a JS button
    that leaves the page where it is (measured three times by hand). It is reachable from
    `hh.ru/chat/`, whose every cell carries `data-qa="chatik-open-chat-<chatId>"` — and
    `hh.ru/chat/<chatId>` then loads the thread directly. The chat is matched by the VACANCY
    TITLE rather than by taking the newest cell, so an employer message arriving between the
    response and this call cannot redirect his letter into someone else's thread.

    Verifies by READING THE THREAD BACK, never by the click: the send button accepts a click
    with an empty textarea, and a chat still showing only "Vacancy application" is exactly the
    failure this exists to repair."""
    LETTERS.mkdir(parents=True, exist_ok=True)
    lf = LETTERS / ("%s-%s.txt" % (time.strftime("%Y-%m-%d"), vid))
    lf.write_text(letter.strip() + "\n", encoding="utf-8")
    if drive(["--goto", "https://hh.ru/chat/"], timeout=180).returncode != 0:
        return False, "список чатов не открылся"
    # СПИСОК ЧАТОВ ЛЕНИВЫЙ, и это блокирует ИМЕННО объём. Измерено 2026-08-25: на первом экране
    # 11 ячеек, после прокрутки 16, при ~20 откликах за день — то есть матчер искал в том, что
    # успело отрендериться, и любой отклик ниже сгиба был для него НЕСУЩЕСТВУЮЩИМ. Три письма
    # сегодня потерялись так (START, ГЕТ ЭКСПЕРТС, Employcity: чат есть, но не в первом экране).
    # Слепое пятно РАСТЁТ ровно с темпом подачи, то есть с тем, ради чего лана и существует.
    # Крутим, пока счётчик растёт, с потолком: бесконечная прокрутка на чужой странице — это
    # тоже способ повиснуть.
    for _ in range(8):
        m0 = log_size()
        # scrollIntoView() на последней ячейке ОДНОГО НЕ ХВАТАЕТ — измерено: счётчик так и стоял
        # на 11, пока к нему не добавили прокрутку самого КОНТЕЙНЕРА и окна. Ленивую подгрузку
        # запускает событие скролла у скроллящегося предка, а не факт видимости элемента.
        drive(["--send", "js () => { const c = document.querySelectorAll('[data-qa^=chatik-open-chat-]');"
                         " const last = c[c.length - 1];"
                         " if (last) { last.scrollIntoView();"
                         "   let p = last.parentElement;"
                         "   for (let i = 0; i < 6 && p; i++) {"
                         "     if (p.scrollHeight > p.clientHeight + 10) p.scrollTop = p.scrollHeight;"
                         "     p = p.parentElement; } }"
                         " window.scrollTo(0, document.body.scrollHeight);"
                         " return JSON.stringify({n: c.length}); }"])
        if not wait_log(m0, "[js] ", 30):
            break
        try:
            n_now = json.loads(log_since(m0).splitlines()[-1].split("[js] ")[-1]).get("n", 0)
        except Exception:
            break
        time.sleep(3)
        m1 = log_size()
        drive(["--send", "js () => JSON.stringify({n: document.querySelectorAll('[data-qa^=chatik-open-chat-]').length})"])
        if not wait_log(m1, "[js] ", 30):
            break
        try:
            n_after = json.loads(log_since(m1).splitlines()[-1].split("[js] ")[-1]).get("n", 0)
        except Exception:
            break
        if n_after <= n_now:
            break
    mark = log_size()
    # Title ALONE is not an identity: two employers posted "Senior Golang Developer" on the same
    # afternoon, and matching on the title would have dropped one company's letter into the
    # other's thread under his name. The cell carries the employer too, so both must match.
    # hh's CHAT LIST DROPS THE LEGAL FORM that the board's employer field carries. Measured
    # 2026-08-25: the board says «JSC АВТОДОМ», the chat cell says «АВТОДОМ», so an indexOf on the
    # board string found nothing and his letter reached that employer through NO channel at all —
    # the application had already filed without a cover letter, and this was the only remaining
    # route. Same shape for LLC/ООО/АО/ПАО/Ltd/Inc. Both sides are stripped of the form before
    # comparing; the TITLE condition is untouched, so two employers posting one title still
    # cannot cross.
    strip_js = ("s => (s||'').replace(/(?:^|\\b)(%s)\\.?\\s*/gi,'')"
                ".replace(/[«»\"']/g,'').trim()" % LEGAL_FORMS)
    drive(["--send", "js () => { const strip = %s; const t = %s, e = strip(%s);"
                     " const cell = [...document.querySelectorAll('[data-qa^=chatik-open-chat-]')]"
                     ".find(c => { const x = c.innerText||'';"
                     " return x.indexOf(t) >= 0 && (!e || strip(x).indexOf(e) >= 0); });"
                     " return cell ? cell.getAttribute('data-qa').replace('chatik-open-chat-','') : ''; }"
                     % (strip_js, json.dumps(title[:60]), json.dumps(employer[:40]))])
    if not wait_log(mark, "[js] ", 40):
        return False, "не прочитал список чатов"
    got = [l for l in log_since(mark).splitlines() if l.startswith("[js] ")][-1].split("[js] ")[-1]
    chat_id = re.sub(r"\D", "", got)
    if not chat_id:
        return False, "чат по этой вакансии не найден в списке"
    mark2 = log_size()
    if drive(["--goto", "https://hh.ru/chat/%s" % chat_id], timeout=180).returncode != 0:
        return False, "чат не открылся"

    # ЧИТАТЬ ТРЕД ДО ОТПРАВКИ, А НЕ ТОЛЬКО ПОСЛЕ. Проверка после отправки доказывает, что письмо
    # дошло; она НЕ мешает отправить его во второй раз. 2026-08-25 ремонт задним числом прогнали
    # дважды (второй заход перевыбрал те же строки, потому что фильтр целей смотрел на текст
    # заметки, к которому первый заход ДОПИСАЛСЯ вместо того чтобы его заменить), а очередь
    # драйвера в этот момент ещё доигрывала команды первого — и четыре работодателя получили одно
    # и то же письмо по 2 и по 4 раза. Это ровно то «читается как бот», против чего заведён дедуп
    # одного места на работодателя.
    #
    # Идемпотентность не должна зависеть от аккуратности вызывающего: тред — это состояние, и
    # доставка обязана быть НО-ОП, если письмо там уже лежит. Сверяется первый содержательный
    # абзац: подпись и приветствие одинаковы у всех писем, а первый абзац собран под вакансию.
    probe = thread_needle(letter)
    if probe:
        m_dup = log_size()
        drive(["--send", "js () => JSON.stringify({n: [...document.querySelectorAll("
                         "'[data-qa*=chatik-chat-message]')].filter("
                         "e => (e.innerText||'').indexOf(%s) >= 0).length})" % json.dumps(probe)])
        if wait_log(m_dup, "[js] ", 40):
            try:
                already = json.loads(log_since(m_dup).splitlines()[-1].split("[js] ")[-1]).get("n", 0)
            except Exception:
                already = 0
            if already:
                return True, "письмо уже в чате (%d копия(й)) — повторно НЕ отправлено" % already

    drive(["--send", "settext textarea[data-qa=chatik-new-message-text],textarea[data-qa=text-input] %s" % lf])
    time.sleep(3)
    if "[FAIL]" in log_since(mark2):
        return False, "поле сообщения в чате не приняло текст"
    drive(["--send", "click [data-qa=chatik-do-send-message]"])
    time.sleep(6)
    mark3 = log_size()
    head = thread_needle(letter)
    drive(["--send", "js () => document.body.innerText.indexOf(%s) >= 0" % json.dumps(head)])
    if not wait_log(mark3, "[js] ", 40):
        return False, "не смог перечитать тред после отправки"
    seen = [l for l in log_since(mark3).splitlines() if l.startswith("[js] ")][-1].lower()
    return ("true" in seen), ("" if "true" in seen else "письма нет в треде после отправки")


def tail_since(path, mark, limit=4000):
    """Хвост файла, дописанный ПОСЛЕ отметки mark. Отдельной функцией — чтобы гоняться фикстурой.

    Читать весь vantage-лог нельзя: «no default-route device found» из позавчерашнего флапа
    повесил бы вчерашний слой на сегодняшний отказ. Обвинение имеет право ссылаться только на то,
    что дописано ЭТОЙ попыткой старта."""
    try:
        if not path.exists():
            return ""
        with path.open("r", encoding="utf-8", errors="replace") as f:
            f.seek(mark)
            return f.read()[-limit:]
    except OSError:
        return ""


def driver_down_reason(start_rc, start_out, vantage_tail):
    """Чистая функция: ПОЧЕМУ hh-драйвер не поднялся. -> одна строка причины.

    Здесь чинится дефект, из-за которого дневной слот молча выдавал ноль (замер 2026-08-28T07:23Z,
    rc=2 за 10.8s). ensure_driver() запускала `mesh-hh-drive --start` и ВЫБРАСЫВАЛА его rc, stdout
    и stderr — `subprocess.run(..., capture_output=True)` без чтения результата, — а вызывающий
    печатал константу «n/a: hh driver down (mesh-hh-drive --start)». Две ошибки одна на другой:
      * ПРИЧИНА НАЗЫВАЛА НЕ ТОТ СЛОЙ. Драйвер был исправен; не было default-route устройства, то
        есть уплинка, и это видно только в vantage-логе, куда никто не смотрел.
      * СРЕДСТВО УЖЕ БЫЛО ПРИМЕНЕНО И НЕ ПОМОГЛО. Строка предписывала запустить ровно ту команду,
        которую сама эта функция только что запустила и потеряла. Человек, прочитав её, повторял
        провалившееся действие.
    Поэтому каждое слово ниже НАЗЫВАЕТ СЛОЙ и не предлагает повторить `--start`."""
    tail = " ".join((start_out or "").split())[-300:]
    suffix = (" | вывод --start: " + tail) if tail else ""
    noroute = sum(1 for l in (vantage_tail or "").splitlines() if VANTAGE_NOROUTE in l)
    if noroute:
        # Слой под драйвером победил все остальные слова: rc самого --start здесь производный.
        return ("АПЛИНК, не драйвер: mesh-vantage-socks не нашёл default-route устройство"
                " (%d строк(и) «%s» в %s за эту попытку). `%s --start` ЭТИМ ЖЕ прогоном уже"
                " запускался и умер именно тут — повторять его бессмысленно; чинится линком"
                " (mesh-link-heal, mesh-card --exit-node-lan)%s"
                % (noroute, VANTAGE_NOROUTE, VANTAGE_LOG, HH, suffix))
    if start_rc is None:
        return ("`%s --start` не вернулся за 180s и был снят по таймауту — демон висит, а не"
                " отсутствует; смотреть `%s --peek`%s" % (HH, HH, suffix))
    if start_rc != 0:
        return ("`%s --start` ЭТИМ прогоном уже запускался и вернул rc=%d — второй такой же"
                " запуск ничего не изменит%s" % (HH, start_rc, suffix))
    return ("`%s --start` вернул rc=0, но --alive сразу после него всё равно ноль: демон"
            " поднялся и умер, смотреть `%s --peek`%s" % (HH, HH, suffix))


def ensure_driver():
    """A cron-fired reflex cannot assume the browser daemon is up — it exits after 45 min idle by
    design. Starting it is part of the reflex, not a precondition someone remembered to meet.

    -> (alive, why). ПОЧЕМУ ПАРА, А НЕ None: rc/stdout/stderr от `--start` — это ЕДИНСТВЕННОЕ
    свидетельство о том, что произошло, и выбросить его значит заставить вызывающего сочинить
    причину. Он и сочинял: см. driver_down_reason()."""
    if subprocess.run([HH, "--alive"], capture_output=True).returncode == 0:
        return True, ""
    # Отметка ДО старта: обвинять уплинк можно только тем, что дописано этой попыткой.
    mark = VANTAGE_LOG.stat().st_size if VANTAGE_LOG.exists() else 0
    start_rc, start_out = None, ""
    try:
        p = subprocess.run([HH, "--start"], capture_output=True, text=True, timeout=180)
        start_rc, start_out = p.returncode, ((p.stderr or "") + (p.stdout or "")).strip()
    except subprocess.TimeoutExpired as e:
        start_out = " ".join(str(getattr(e, "stderr", "") or "").split())
    if subprocess.run([HH, "--alive"], capture_output=True).returncode == 0:
        return True, ""
    return False, driver_down_reason(start_rc, start_out, tail_since(VANTAGE_LOG, mark))

def _allow_survives_sync(name):
    """His `allow: <name>` must beat the auto-population — and still be there after the NEXT sync.

    Without this the override is a one-run reprieve: the block is rewritten whole on every run, so
    a name he un-banned would silently come back the next morning. Used by --test; BLACKLIST is
    expected to already point at a scratch copy."""
    txt = BLACKLIST.read_text(encoding="utf-8") if BLACKLIST.exists() else ""
    BLACKLIST.write_text("allow: %s\n%s" % (name, txt), encoding="utf-8")
    row = {"i": 0, "employer": name, "title": "Team lead Go", "note": "", "state": "seen", "id": "9"}
    ok = not blacklisted(row)
    sync_blacklist()
    return ok and not blacklisted(row) and ("former: %s" % name) not in \
        BLACKLIST.read_text(encoding="utf-8")


def pick(rows, limit):
    """-> (picked, blocked). `blocked` carries the REASON each name was kept out.

    Selection and refusal are returned together on purpose: a name refused silently is a name the
    operator only meets when it is already in his TG feed under his own signature."""
    cands, blocked = [], []
    for r in rows:
        if r["state"] != "seen" or not r["id"]:
            continue
        hit = blacklist_hit(r)
        if hit:
            blocked.append((r, hit[0], hit[1]))
        elif not domain_hit(r):
            blocked.append((r, "не его область",
                            "ни название, ни работодатель не заявляют разработку"))
        elif not ROLES.role_verdict(r.get("title", ""), r.get("employer", ""))[0]:
            blocked.append((r, "не его роль",
                            ROLES.role_verdict(r.get("title", ""), r.get("employer", ""))[1]))
        else:
            cands.append(r)
    cands.sort(key=lambda r: -score(r))
    # One seat per employer per batch. Т-Банк alone posts the same lead role under four ids, and
    # a top-5 that is four rows of one company reads to that company as a bot, not a candidate.
    picked, seen_emp = [], set()
    for r in cands:
        key = r["employer"].strip().lower()
        if key in seen_emp:
            blocked.append((r, KINDS["dedup"], "место работодателя занято в этой партии"))
            continue
        seen_emp.add(key)
        picked.append(r)
        if len(picked) >= limit:
            break
    return picked, blocked


def reconcile(dry=False):
    """Сверить доску со СПИСКОМ ОТКЛИКОВ hh и снять приговоры, вынесенные из слепоты. -> rc.

    Нужен потому, что `finalize` — судья односторонний: он умеет объявить отклик неподтверждённым,
    но не умеет взять слово назад. Пока `negotiation_ids` читала одну страницу из трёх, каждый
    отклик за её пределами получал «клик прошёл, но отклика в списке НЕТ», строка уезжала в
    needs-human, а собранное письмо ложилось в `unconfirmed/` под заголовком «НЕ ОТПРАВЛЕНО».
    Список стал полным — а приговоры остались, и снять их нечем: они не «переходные», время их не
    лечит. Эта рука сверяет доску с ЧИСЛОМ САМОЙ hh и правит только в одну сторону — в подтверждение
    по НАЛИЧИЮ. Обратной ветки («нет в списке, значит не отправлено») здесь нет вовсе: ровно она и
    натворила то, что тут чинится.

    Отказывается работать, если список прочитан не полностью: сверка по неполному списку — это тот
    же самый дефект, только запущенный руками."""
    r = negotiation_ids()
    ids, complete = r.ids, r.complete
    if not complete:
        print("n/a: список откликов hh прочитан НЕ ПОЛНОСТЬЮ (%d id, read=%s: %s) — сверять по"
              " нему нельзя, это ровно тот дефект, который здесь чинится"
              % (len(ids), r.reason, HH_READ_NA.get(r.reason, "список оборван на середине")),
              file=sys.stderr)
        return 2
    rows = read_board()
    today = time.strftime("%Y-%m-%d")
    fixed = 0
    # ПРАВИМ ТОЛЬКО ТО, ЧТО ОТСТАЁТ ОТ ФАКТА ПОДАЧИ. `viewed`/`interview`/`rejected` ставит
    # mesh-job-track из той же ленты hh, и они ЗНАЮТ про отклик больше, чем `sent`: откатить их
    # к `sent` значило бы стереть прогресс воронки, объявив это исправлением. Первый --dry
    # показал ровно это — 25 строк, из них 25 уже прошли дальше подачи.
    BEHIND = {"", "seen", "needs-human", "failed"}
    for r in rows:
        if r["id"] in ids and r["state"] in BEHIND:
            print("%-11s %-24s %-42s <- есть в списке откликов hh"
                  % (r["state"] or "(нет)", r["employer"][:24], r["title"][:42]))
            if not dry:
                set_state(r["i"], "sent",
                          "%s: ПОДТВЕРЖДЁН списком откликов hh при сверке; прежний вердикт был"
                          " вынесен по НЕПОЛНОМУ чтению списка (одна страница из %d)"
                          % (today, (len(ids) + 19) // 20))
                for f in UNCONFIRMED.glob("UNCONFIRMED-*-%s.md" % r["id"]):
                    # ПЕРЕСБОРКА, А НЕ ПЕРЕИМЕНОВАНИЕ: заголовок, вынесенный обвиняющей веткой,
                    # переезжал вместе с файлом и оставался первой строкой в каталоге, который
                    # читают как доказательство поданного отклика.
                    promote_unconfirmed(f, r, today)
            fixed += 1
    print("\nсверено с hh: %d отклик(ов) в её списке; исправлено строк: %d%s"
          % (len(ids), fixed, " (--dry)" if dry else ""))
    return 0


# Видимость резюме, от самой широкой к самой узкой. Порядок — это РАНГ, а не список синонимов:
# «весь интернет» строго шире, чем «все работодатели hh», и если первого в UI нет, мы обязаны
# сказать, что его нет, а не молча выдать второе за исполнение просьбы.
VISIBILITY_RANK = (
    (r"всему интернету|whole internet|everyone on the internet", "весь интернет"),
    (r"клиентским компаниям|client companies",                   "клиентским компаниям hh"),
    (r"всем работодател|all employers",                          "все работодатели hh"),
)


def fix_profile(dry=False):
    """Поднять видимость резюме до самого широкого варианта, КОТОРЫЙ hh РЕАЛЬНО ПРЕДЛАГАЕТ. -> rc.

    Оператор 2026-08-28 разрешил широкий вариант дословно («видно всему интернету вот все
    давайте»), и до этого разрешения трогать настройку было нельзя: это его персональные данные,
    а не поле анкеты. Но разрешение — не гарантия исполнимости, и здесь она не выполняется.

    ИЗМЕРЕНО В ЭТОТ ЖЕ ДЕНЬ, полным чтением страницы (1741 символ, не срезанным):
    hh отказывает словами «change the visibility of the resume to "Visible to the whole Internet"
    or "Visible to HeadHunter client companies"», а на самой странице видимости ПЯТЬ вариантов —
    все работодатели hh / выбранным / скрыто от выбранных / по прямой ссылке / никому — и НИ
    ОДНОГО из двух названных. Резюме на аккаунте ровно одно (проверено списком), самый широкий
    из пяти УЖЕ выбран, страница /applicant/resumes/access отдаёт 404. То есть hh называет
    настройки, которых в её собственном UI нет.

    Поэтому эта рука делает ровно две честные вещи и ни одной сверх:
      * выставляет самый широкий ДОСТУПНЫЙ вариант, если он вдруг не выставлен;
      * ПЕЧАТАЕТ, существует ли вариант, которого hh требует, — потому что «не смог» и «нечего
        нажимать» это разные отчёты, и второй нельзя выдавать за первый.

    Строки, стоявшие на `profile`, после этого пере-открываются: причина «ждём правки профиля»
    держаться больше не может — правка либо сделана, либо её негде сделать."""
    mark = log_size()
    if drive(["--goto", "https://hh.ru/applicant/resumes"], timeout=180).returncode != 0:
        print("n/a: страница резюме не открылась", file=sys.stderr)
        return 2
    drive(["--send", "js JSON.stringify(Array.from(document.querySelectorAll('a[href*=\"/resume/\"]'))"
                     ".map(a=>a.getAttribute('href')))"])
    if not wait_log(mark, "[js] [", 60):
        print("n/a: список резюме не прочитался", file=sys.stderr)
        return 2
    rids = re.findall(r"/resume/([0-9a-f]{20,})", log_since(mark))
    rids = list(dict.fromkeys(rids))
    if not rids:
        print("n/a: на аккаунте не найдено ни одного резюме", file=sys.stderr)
        return 2
    print("резюме на аккаунте: %d (%s)" % (len(rids), ", ".join(r[:12] + "…" for r in rids)))
    rc = 0
    for rid in rids:
        mark = log_size()
        if drive(["--goto", "https://hh.ru/resume/edit/%s/visibility" % rid],
                 timeout=180).returncode != 0:
            print("  %s… страница видимости не открылась" % rid[:12]); rc = 1; continue
        drive(["--send", "js JSON.stringify(Array.from(document.querySelectorAll('input[type=radio]'))"
                         ".map(e=>({c:e.checked,l:((e.closest('label')||e.parentElement||{}).innerText||'')"
                         ".split('\\n')[0]})))"])
        if not wait_log(mark, "[js] [", 60):
            print("  %s… варианты видимости не прочитались" % rid[:12]); rc = 1; continue
        payload = [l for l in log_since(mark).splitlines() if l.startswith("[js] [")][-1]
        try:
            opts = json.loads(payload[len("[js] "):].strip())
        except ValueError:
            print("  %s… ответ страницы не разобрался" % rid[:12]); rc = 1; continue
        seen_lbl, options = set(), []
        for o in opts:
            lbl = " ".join((o.get("l") or "").split())
            if lbl and lbl not in seen_lbl:
                seen_lbl.add(lbl)
                options.append((bool(o.get("c")), lbl))
        print("  %s… вариантов: %d" % (rid[:12], len(options)))
        for checked, lbl in options:
            print("      %s %s" % ("[x]" if checked else "[ ]", lbl[:70]))
        # Существует ли то, чего hh требует? Это ОТДЕЛЬНЫЙ отчёт, а не следствие успеха клика.
        best_i = best_name = None
        for pat, name in VISIBILITY_RANK:
            for i, (_c, lbl) in enumerate(options):
                if re.search(pat, lbl, re.I):
                    best_i, best_name = i, name
                    break
            if best_i is not None:
                break
        top_demanded = re.search(VISIBILITY_RANK[0][0], " | ".join(l for _c, l in options), re.I)
        print("      требуемый hh 'весь интернет': %s"
              % ("ЕСТЬ" if top_demanded else "ОТСУТСТВУЕТ В UI — нажимать нечего"))
        if best_i is None:
            print("      ни один известный вариант не опознан — не трогаю"); rc = 1; continue
        if options[best_i][0]:
            print("      самый широкий ДОСТУПНЫЙ (%s) уже выбран — правка не нужна" % best_name)
            continue
        print("      выставляю самый широкий доступный: %s" % best_name)
        if dry:
            continue
        drive(["--send", "clicktext %s" % options[best_i][1][:60]])
        time.sleep(3)
        drive(["--send", "clicktext Save"])
        time.sleep(5)
        mark = log_size()
        drive(["--goto", "https://hh.ru/resume/edit/%s/visibility" % rid], timeout=180)
        drive(["--send", "js JSON.stringify(Array.from(document.querySelectorAll('input[type=radio]'))"
                         ".map(e=>({c:e.checked,l:((e.closest('label')||e.parentElement||{}).innerText||'')"
                         ".split('\\n')[0]})))"])
        # ПРОВЕРЯЕМ ПЕРЕЧИТЫВАНИЕМ СТРАНИЦЫ, а не тем, что клик не упал.
        chunk = log_since(mark) if wait_log(mark, "[js] [", 60) else ""
        ok = bool(re.search(r'"c"\s*:\s*true[^}]*' + re.escape(options[best_i][1][:30]), chunk, re.I)
                  or re.search(re.escape(options[best_i][1][:30]) + r'[^}]*"c"\s*:\s*true', chunk, re.I))
        print("      после сохранения: %s" % ("подтверждено перечитыванием" if ok else "НЕ подтвердилось"))
        if not ok:
            rc = 1
    # Строки, державшиеся на profile, больше держаться не могут: либо правка сделана, либо её
    # негде сделать. Обе ветки означают одно — ждать от человека больше нечего.
    today = time.strftime("%Y-%m-%d")
    n = 0
    for r in read_board():
        if r["state"] == "needs-human" and r["reason"] == R_PROFILE:
            print("  пере-открываю %-24s (причина profile снята)" % r["employer"][:24])
            if not dry:
                set_state(r["i"], "seen",
                          "%s: видимость резюме проверена — самый широкий вариант, который hh"
                          " предлагает, выставлен; вариантов, которых она требует, в её UI нет"
                          % today)
            n += 1
    print("\nпере-открыто строк с причиной profile: %d%s" % (n, " (--dry)" if dry else ""))
    return rc


def settle_capped(dry=False):
    """Досудить строки, у которых кончились попытки. -> rc.

    `retry` — единственная причина, которую снимает ВРЕМЯ, и у неё есть потолок: три раза подряд
    «клик прошёл, но отклика в списке НЕТ» — это уже не переходный сбой. Дальше строка лежала в
    needs-human вечно, хотя человек ей ничем помочь не может: ждать больше нечего, а спрашивать
    нечего. Между тем у такого исхода есть ровно две разные причины, и они РАЗЛИЧИМЫ на странице
    самой вакансии:

      * вакансия УШЛА В АРХИВ — кнопки отклика на ней нет и не будет, клик и не мог ничего подать.
        Это нормальный конец строки, а не отказ: доска растёт, строки стареют. -> dropped.
      * вакансия ЖИВА — значит подать её этим кодом мы не умеем, и это дефект тула, а не ожидание
        человека. -> form, у которого есть свой гейт по mtime кода и свой потолок.

    Ни то, ни другое не является needs-human, и обе ветки называют себя вслух. Сверка со списком
    откликов hh делается ПЕРВОЙ и на полном списке: строка, которая на самом деле подана, не имеет
    права уехать ни в архив, ни в дефект."""
    r = negotiation_ids()
    ids, complete = r.ids, r.complete
    if not complete:
        print("n/a: список откликов hh прочитан НЕ ПОЛНОСТЬЮ (%d id, read=%s: %s) — судить по"
              " нему нельзя"
              % (len(ids), r.reason, HH_READ_NA.get(r.reason, "список оборван на середине")),
              file=sys.stderr)
        return 2
    today = time.strftime("%Y-%m-%d")
    n_sent = n_arch = n_form = 0
    for r in read_board():
        if r["state"] != "needs-human" or r["reason"] != R_RETRY:
            continue
        if retry_tries(r["note"]) < RETRY_MAX:
            continue
        if r["id"] in ids:
            print("%-24s ПОДАН — есть в полном списке откликов hh" % r["employer"][:24])
            if not dry:
                set_state(r["i"], "sent", "%s: ПОДТВЕРЖДЁН списком откликов hh при досуживании"
                          % today)
            n_sent += 1
            continue
        text, why = vacancy_text(r["id"])
        if not text:
            print("%-24s не прочиталась: %s — оставляю как есть" % (r["employer"][:24], why))
            continue
        if is_archived(text):
            print("%-24s В АРХИВЕ — снимаю с доски" % r["employer"][:24])
            if not dry:
                set_state(r["i"], "dropped", "%s: вакансия в архиве; попытки исчерпаны, подавать"
                          " больше некуда" % today)
            n_arch += 1
        else:
            print("%-24s ЖИВА, но подать не вышло %d раз — это дефект тула"
                  % (r["employer"][:24], RETRY_MAX))
            if not dry:
                set_state(r["i"], "needs-human",
                          "%s: вакансия жива, но %d попытки отклика не дали записи в списке hh —"
                          " незнакомая разновидность формы" % (today, RETRY_MAX), R_FORM)
            n_form += 1
    print("\nдосужено: подан %d, в архиве %d, дефект формы %d%s"
          % (n_sent, n_arch, n_form, " (--dry)" if dry else ""))
    return 0


# Заголовки двух РАЗНЫХ миров, в которых письмо остаётся неподтверждённым. Это не украшение: у них
# разные руки-исправители, и человек, открывший файл, обязан увидеть, какой из двух он держит.
#   * СПИСОК ПРОЧИТАН, вакансии в нём нет -> утверждение о ненайденности, строка уходит в
#     needs-human, чинит человек по самой вакансии.
#   * СПИСОК НЕ ПРОЧИТАН -> утверждать нечего вообще; чинится входом в браузере и `--reconcile`,
#     и строка остаётся ОТКРЫТОЙ, потому что приговора не выносилось.
HEAD_NOTSENT = "НЕ ОТПРАВЛЕНО (не подтверждено)"
HEAD_BLIND = "НЕ ПОДТВЕРЖДЕНО (проверить было нечем)"

# Тело файла в sent/ рендерится ОДНОЙ рукой — этой. Рендеров было полтора: finalize() собирала
# подтверждённое письмо целиком, а reconcile() «поднимала» письмо одним `f.replace(...)`, то есть
# ПЕРЕИМЕНОВАНИЕМ, которое тела не касается вовсе. Заголовок оставался тем, что вынесла обвиняющая
# ветка, и в sent/ — каталоге, который человек читает как доказательство поданного отклика, — лёг
# бы файл, чья первая строка утверждает обратное. Поднятие обязано ПЕРЕСОБРАТЬ письмо, а не
# переставить файл.
LETTER_MARK = "## Текст"


def render_sent(r, day, note, letter):
    """Собрать тело файла для sent/. -> текст.

    Примечание сюда приходит от вызывающего, но снятый при поднятии заголовок в нём НЕ ЦИТИРУЕТСЯ
    и цитироваться не может: каталог sent/ переписывают `grep`-ом по фразе, и ровно такая перепись
    уже дала 2 «попадания» из 68, оба — рукописные заметки, где фраза стоит в середине текста.
    Пересборка, оставляющая старую формулировку в прозе, воспроизводит этот же ложный след своими
    руками."""
    return ("# %s — %s\n\n- %s\n- отправлено %s автоматически (mesh-job-apply), %s\n\n%s\n\n%s\n"
            % (r["employer"], r["title"], r["url"], day, note, LETTER_MARK, letter))


def letter_of(text):
    """Вынуть само письмо из уже сохранённого файла. -> (письмо, нашлось ли).

    Отдаёт ФЛАГ, а не пустую строку на неудаче: пустое письмо и неразобранный файл — разные вещи,
    и молча пересобрать файл без тела значит стереть ровно то, ради чего его хранили."""
    i = text.find(LETTER_MARK + "\n")
    if i < 0:
        return "", False
    return text[i + len(LETTER_MARK):].strip("\n"), True


def promote_unconfirmed(f, r, today):
    """Поднять письмо из unconfirmed/ в sent/, ПЕРЕСОБРАВ его как подтверждённое. -> путь.

    Имя файла несёт ДАТУ СБОРКИ письма, а не сегодняшнюю: поднимается существующая подача, и
    подменить её дату днём сверки значило бы передатировать сам отклик. Дата сверки живёт в
    примечании, где ей и место.

    Если секции с текстом в файле не нашлось, файл НЕ пересобирается: тело переносится как есть, а
    заменяется только первая строка — единственное, что в sent/ читают глазами. Потерять письмо
    хуже, чем оставить файл нестандартной формы."""
    name = f.name.replace("UNCONFIRMED-", "", 1)
    day = name[:10] if re.match(r"\d{4}-\d{2}-\d{2}-", name) else today
    note = ("ПОДТВЕРЖДЕНО списком откликов hh при сверке %s (--reconcile); прежний вердикт был"
            " вынесен по НЕПОЛНОМУ чтению списка" % today)
    text = f.read_text(encoding="utf-8")
    letter, ok = letter_of(text)
    SENT.mkdir(parents=True, exist_ok=True)
    dest = SENT / name
    if ok:
        dest.write_text(render_sent(r, day, note, letter), encoding="utf-8")
    else:
        rest = text.split("\n", 1)[1] if "\n" in text else ""
        dest.write_text("# %s — %s\n\n- %s\n%s" % (r["employer"], r["title"], note, rest),
                        encoding="utf-8")
    f.unlink()
    return dest


def keep_unconfirmed(r, letter, today, head, why):
    """Сохранить собранное письмо, которое hh НЕ подтвердила. -> путь файла.

    ПОЧЕМУ ЭТО ОТДЕЛЬНАЯ ФУНКЦИЯ, А НЕ ДВА write_text НА МЕСТЕ. До 2026-08-29 запись жила ровно в
    одной из двух веток finalize() — в той, что ВЫНОСИТ ПРИГОВОР. Вторая ветка (список прочитан не
    полностью, значит отсутствие в нём ничего не значит) правильно отказывалась приговор чеканить —
    и вместе с приговором молча перестала ХРАНИТЬ. Замер 2026-08-29: прогон 09:09:02Z-09:22:14Z
    собрал 20 писем, session была разлогинена, и на диск не легло НИ ОДНОГО файла — ни в sent/, ни
    в unconfirmed/. Не-обвинять и не-хранить срослись в одну ветку, потому что запись была её
    частью. Теперь хранение — общий вызов обеих веток, а расходятся они только ЗАГОЛОВКОМ.

    Имя файла у обеих веток одно и то же (`UNCONFIRMED-<дата>-<id>.md`) НАМЕРЕННО: по этой самой
    маске reconcile() поднимает письмо в sent/, когда список наконец прочитан и отклик в нём есть.
    Своя маска для слепой ветки сделала бы её письма невидимыми ровно для той руки, которая их и
    должна разблокировать."""
    UNCONFIRMED.mkdir(parents=True, exist_ok=True)
    path = UNCONFIRMED / ("UNCONFIRMED-%s-%s.md" % (today, r["id"]))
    path.write_text("# %s — %s — %s\n\n- %s\n- %s: %s\n\n## Текст\n\n%s\n"
                    % (head, r["employer"], r["title"], r["url"], today, why, letter),
                    encoding="utf-8")
    return path


def finalize(results, letters, filed_pair, today):
    """Settle the batch against hh's own list of filed applications. -> confirmed rows.

    THE LETTER FILE IS WRITTEN HERE, NOT AT THE CLICK. `sent/<date>-<id>.md` used to be written
    the moment apply_one said 'sent' — before this very verification ran — so a batch that hh
    never confirmed still left, on disk, a directory of letters a human reads as proof the
    applications went out. That is what frightened the operator on 2026-08-21 when Foxible's name
    surfaced. An unconfirmed letter is kept (it cost a real assembly and names a real attempt) but
    under `job/unconfirmed/` with UNCONFIRMED in its filename: nothing that reads sent/ can pick
    it up, and nothing that opens it can mistake it."""
    # ПОЗИЦИОННО, а не распаковкой: живой путь передаёт HHRead (4 поля), а фикстуры --test —
    # честную пару. Распаковка сломала бы одну из двух сторон, ничего не сказав о предмете.
    filed, complete = filed_pair[0], filed_pair[1]
    # ПРИЧИНА ЧТЕНИЯ — ТРЕТЬЕ ПОЛЕ, И БЕРЁТСЯ ОНА ПОЗИЦИОННО И НЕОБЯЗАТЕЛЬНО, ровно по той же
    # причине, что и первые два: живой путь передаёт HHRead (4 поля), фикстуры --test — честную
    # пару. Слепому письму нужно НАЗВАТЬ, чья рука его разблокирует, а слов у слепоты семь, и
    # «разлогинены» с «оборванной пагинацией» чинят разные люди.
    reason = filed_pair[2] if len(filed_pair) > 2 else ""
    confirmed = []
    for r, state, detail in results:
        if state != "sent":
            continue
        if not complete:
            # СПИСОК ПРОЧИТАН НЕ ДО КОНЦА, ЗНАЧИТ ОТСУТСТВИЕ В НЁМ НИЧЕГО НЕ ЗНАЧИТ. Единственная
            # ветка, которой здесь нельзя пользоваться, — это «нет в списке, следовательно не
            # отправлено»: она пишет строке needs-human и кладёт письмо в unconfirmed/ с заголовком
            # «НЕ ОТПРАВЛЕНО», то есть чеканит УТВЕРЖДЕНИЕ из нашей же слепоты. Подтверждение по
            # НАЛИЧИЮ остаётся законным: попасть в список случайно нельзя.
            if r["id"] not in filed:
                set_state(r["i"], "seen",
                          "%s: клик прошёл; список откликов hh прочитан НЕ ПОЛНОСТЬЮ (%d строк) —"
                          " подтвердить нечем, строка остаётся открытой" % (today, len(filed)))
                # НЕ ОБВИНЯТЬ И НЕ ХРАНИТЬ — РАЗНЫЕ ВЕЩИ, и до 2026-08-29 они были одной веткой.
                # Письмо стоило настоящей сборки и называет настоящую попытку; наша слепота — не
                # основание его стереть. Заголовок здесь НЕ содержит слов «НЕ ОТПРАВЛЕНО»: мы про
                # эту вакансию не знаем ничего, а файл в unconfirmed/ читают глазами.
                keep_unconfirmed(
                    r, letters.get(r["id"], ""), today, HEAD_BLIND,
                    "клик по отклику прошёл, а список откликов hh прочитан НЕ ПОЛНОСТЬЮ"
                    " (%d строк, read=%s%s) — подтвердить или опровергнуть отправку НЕЧЕМ."
                    " Войти в браузере и прогнать `mesh-job-apply --reconcile`: если отклик"
                    " в списке есть, это письмо само поднимется в sent/"
                    % (len(filed), reason or "?",
                       "; " + HH_READ_NA[reason] if reason in HH_READ_NA else ""))
                continue
        letter = letters.get(r["id"], "")
        if r["id"] in filed:
            # Carry apply_one's own detail into the row. Without it a filed-but-LETTERLESS
            # application and a fully packaged one wrote the identical note, so the day the cover
            # letter stopped attaching, twelve rows still read "отправлено автоматически" and
            # nothing on the board could tell them apart. The employer-visible difference is the
            # whole packaging; the row must say which one it was.
            # УПАКОВКА ПОСЛЕ ПОДТВЕРЖДЕНИЯ, И ДО ЗАПИСИ СТРОКИ. Отклик, поданный по ссылке, не
            # несёт письма нигде, кроме чата, а чат появляется только вместе с откликом — значит
            # письмо кладётся здесь, где отклик уже доказан списком hh, и нигде раньше. Строка
            # пишется ОДИН раз, уже зная исход упаковки: две записи подряд оставили бы в
            # примечании промежуточное «ждёт подтверждения», которого в итоге не было.
            if letter and PENDING_LETTER in detail:
                ok, why = letter_into_chat(r["id"], letter, r["title"], r["employer"])
                detail = ("отклик подан по ссылке; письмо отправлено в чат отклика" if ok
                          else "отклик подан по ссылке, но письмо в чат НЕ ушло: %s" % why)
            set_state(r["i"], "sent",
                      "%s: отправлено автоматически, подтверждено списком откликов — %s"
                      % (today, detail))
            log_send(r["id"], r["employer"], r["title"], detail)
            confirmed.append(r)
            SENT.mkdir(parents=True, exist_ok=True)
            (SENT / ("%s-%s.md" % (today, r["id"]))).write_text(
                render_sent(r, today, "ПОДТВЕРЖДЕНО списком откликов hh", letter),
                encoding="utf-8")
        else:
            set_state(r["i"], "needs-human", "%s: клик прошёл, но отклика в списке НЕТ" % today,
                      reason_of("клик прошёл, но отклика в списке НЕТ"))
            keep_unconfirmed(r, letter, today, HEAD_NOTSENT,
                             "клик по отклику прошёл, но вакансии НЕТ в ПОЛНОСТЬЮ прочитанном"
                             " списке откликов hh. Это письмо — не доказательство отправки")
    return confirmed


# ---------------------------------------------------------------- снятие причины
# ── SINGLE WRITER ───────────────────────────────────────────────────────────────────────────────
# THIS LANE HAS THREE SHARED, UNSYNCHRONISED RESOURCES AND NO LOCK UNTIL 2026-08-26: the operator's
# ONE hh login driven through ONE browser daemon, the board file this rewrites BY ROW INDEX, and the
# daily budget, which every run computes as `CAP - sent_today(...)` from a board it read at start.
# Two concurrent runs therefore each see the FULL remaining budget and can together file more
# applications than the cap the operator set — and their verbs interleave in one browser, which is
# how 2026-08-20 filed four applications with no cover letter (see mesh-hh-drive's census comment:
# `click response` fired in one page while `type letter` went to another). That census fixed
# multiple ENGINES; nothing fixed multiple CLIENTS of one engine.
#
# THE ANSWER TO A SECOND WRITER IS A LOCK, NOT A KILL. A kill loses whatever the victim had already
# done and leaves no artifact naming who did it; a lock makes the second writer WAIT for a resource
# it cannot share, and if it cannot wait long enough it DECLINES loudly, naming the holder.
#
# The wait matters as much as the exclusion: a scheduled run that returns immediately because a hand
# was mid-batch has silently dropped that slot's applications, and `mesh-cron-catchup` claims a slot
# before it fires, so nothing re-runs it. Waiting turns a collision into a delay; refusing turns it
# into a lost day.
#
# The lock dies with the process — no stale-pid reaping to get wrong, because flock is released by
# the kernel when the fd closes, including on SIGKILL. Python opens the fd non-inheritable (PEP 446),
# so the long-lived browser daemon this starts does NOT carry the lock past our exit; that is
# asserted in --test, because a lock a child inherits is a lock nobody can ever take again.
# [[a-killed-process-does-not-release-a-lock-its-children-inherited]]
APPLY_LOCK = MESH / "job" / ".apply.lock"
LOCK_WAIT = float(node_env("MESH_JOB_LOCK_WAIT", "1500"))


def hold_the_lane(mode, wait_s=None):
    """Take the single-writer lock over the hh drive, the board and the daily budget.

    -> (fd, "") on success; (None, why) when another writer held it for the whole wait. The fd must
    stay referenced for the life of the process: closing it releases the lock.
    """
    wait_s = LOCK_WAIT if wait_s is None else wait_s
    try:
        APPLY_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(APPLY_LOCK), os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as e:
        # Never fail OPEN on a lock we could not even create: a lane that applies under the
        # operator's name when its guard is broken is worse than a lane that stops and says so.
        return None, "не удалось открыть замок %s: %s" % (APPLY_LOCK, e)
    t0 = time.time()
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.ftruncate(fd, 0)
            os.write(fd, ("pid=%d mode=%s since=%s\n" % (
                os.getpid(), mode,
                time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))).encode())
            os.fsync(fd)
            return fd, ""
        except OSError:
            pass
        left = wait_s - (time.time() - t0)
        if left <= 0:
            # NAME THE HOLDER. "resource busy" sends a reader to guess; the holder's own line says
            # which pid, which mode and since when, so the collision is diagnosable from the log
            # the loser wrote. [[a-collapsed-reason-makes-blind-and-quiet-identical]]
            try:
                who = os.pread(fd, 200, 0).decode("utf-8", "replace").strip() or "(нет записи)"
            except OSError:
                who = "(не прочиталось)"
            os.close(fd)
            return None, ("замок %s занят весь таймаут %.0fs — держит: %s"
                          % (APPLY_LOCK, wait_s, who))
        time.sleep(min(5.0, left))


RETRY_DAYS = float(node_env("MESH_JOB_RETRY_DAYS", "1"))
RETRY_MAX = int(node_env("MESH_JOB_RETRY_MAX", "3"))


def note_head(note):
    """Свежий сегмент примечания. Примечание — стек через ' || ', новое кладётся СЛЕВА."""
    return (note or "").split(" || ")[0]


def days_since(note):
    """Возраст свежего сегмента в сутках, -1 если даты в нём нет (возраст НЕИЗВЕСТЕН)."""
    m = re.match(r"(\d{4}-\d{2}-\d{2})", note_head(note))
    if not m:
        return -1.0
    try:
        return (time.time() - time.mktime(time.strptime(m.group(1), "%Y-%m-%d"))) / 86400.0
    except ValueError:
        return -1.0


def retry_tries(note):
    """Сколько раз эта строка уже падала переходным сбоем — по её же сегментам."""
    return sum(1 for seg in (note or "").split(" || ") if reason_of(seg) == R_RETRY)


def clearable(row):
    """-> (можно ли открывать, что сказать вслух). Единственный судья снятия причины.

    ДЕРЖАТЬ — не то же самое, что ОТКАЗАТЬ. Причина, чей носитель не помещается в окно, где её
    можно оценить (вопросы вообще не сняты со страницы; в примечании нет даты), ДЕРЖИТСЯ — она не
    объявляется ни снятой, ни вечной. Пустое множество вопросов формально «покрыто целиком», и
    открыть по нему строку значило бы выдать положительный вердикт из руки, которая ничего не
    измеряла."""
    why, note = row.get("reason", ""), row.get("note", "")
    if why == R_QUESTIONS:
        r = subprocess.run([ANSWERS, "--covered", "hh:%s" % row["id"]],
                           capture_output=True, text=True, timeout=60)
        if r.returncode == 0:
            return True, "банк отвечает на все снятые вопросы"
        if r.returncode == 2:
            return False, "вопросы не сняты со страницы — сверять не с чем (--reopen --harvest)"
        return False, "банк не покрывает часть вопросов — дописываем ответы (mesh-job-answers)"
    if why == R_RETRY:
        age, tries = days_since(note), retry_tries(note)
        if tries >= RETRY_MAX:
            return False, "переходный сбой повторился %d раз — это уже не переходный" % tries
        if age < 0:
            return False, "в свежем сегменте примечания нет даты — возраст неизвестен"
        if age < RETRY_DAYS:
            return False, "прошло %.1f сут из %.1f" % (age, RETRY_DAYS)
        return True, "переходный сбой, %.1f сут назад, попытка %d из %d" % (age, tries + 1, RETRY_MAX)
    if why == R_PROFILE:
        return False, "снимаем МЫ — правкой видимости резюме в его аккаунте hh (--fix-profile)"
    if why == R_CAPTCHA:
        # ЕДИНСТВЕННАЯ причина в этой таблице, которая действительно ждёт человека: капчу снимает
        # тот, кто её прошёл. Ни один сайт в этом лейне её пока не чеканил.
        return False, "снимает человек, прошедший проверку — единственный такой токен"
    if why == R_FORM:
        # «Снимает КОД» — это обещание, и до 2026-08-28 его никто не держал: строка ждала правки
        # вечно, потому что снять причину было нечем даже ПОСЛЕ правки. Гейт тот же по форме, что
        # у letter: ФАКТ НА ДИСКЕ — сам этот файл правлен позже, чем написан свежий сегмент
        # примечания, значит форму ведёт уже другой код и строку надо пере-проверить живьём.
        # Потолок попыток обязателен: без него каждый деплой открывал бы одни и те же строки
        # бесконечно, и «форму тул не ведёт» стало бы вечным двигателем, а не диагнозом.
        age, tries = days_since(note), sum(1 for seg in (note or "").split(" || ")
                                           if reason_of(seg) == R_FORM)
        if tries >= RETRY_MAX:
            return False, "форма не поддалась %d раз(а) — нужен разбор формы, а не ещё попытка" % tries
        if age < 0:
            return False, "в свежем сегменте примечания нет даты — возраст неизвестен"
        try:
            code_age = (time.time() - CODE_PATH.stat().st_mtime) / 86400.0
        except OSError:
            return False, "не читается собственный файл — снять причину нечем"
        if code_age < age:
            return True, "код формы правлен позже этой строки — пере-проверяю живьём"
        return False, ("снимает КОД: hh показал форму, которую тул не ведёт;"
                       " mesh-job-apply не менялся %.1f сут" % code_age)
    if why == R_LETTER:
        # СНИМАЕТСЯ ФАКТОМ НА ДИСКЕ, А НЕ ОБЕЩАНИЕМ: если letter-blocks.md правлен ПОЗЖЕ, чем
        # написан свежий сегмент примечания, набор его абзацев изменился с тех пор, как эта
        # вакансия по ним не собралась, — и строку надо пере-проверить живьём. Если блоки с тех
        # пор не двигались, держим, но текст называет НАШУ работу, а не его. Гейт нельзя снять
        # бездействием: время идёт, mtime файла — нет.
        age = days_since(note)
        try:
            blocks_age = (time.time() - LETTER_BLOCKS.stat().st_mtime) / 86400.0
        except OSError:
            return False, "letter-blocks.md не читается — снять причину нечем"
        if age < 0:
            return False, "в свежем сегменте примечания нет даты — возраст неизвестен"
        if blocks_age < age:
            return True, "блоки письма правлены позже этой строки — пере-проверяю живьём"
        return False, ("ждёт НАШЕЙ правки letter-blocks.md — его абзацев не хватило,"
                       " а файл не менялся %.1f сут" % blocks_age)
    if why == R_UNKNOWN:
        return False, "причина не опознана — новый текст отказа, шаблон не написан"
    return False, "у строки нет токена причины (--backfill-reasons)"


# ОСТОРОЖНО ДЛЯ ЛЮБОГО, КТО ЧИТАЕТ ЭТОТ ФАЙЛ РУКАМИ: переход на
# hh.ru/applicant/vacancy_response?vacancyId=<id> — ЭТО ЗАПИСЬ. Для вакансии без анкеты
# работодателя hh ПОДАЁТ отклик прямо на этом переходе и редиректит на вакансию с «You applied».
# Замерено 2026-08-25: ум открыл этот URL как пробу, чтобы посмотреть, есть ли поле письма, и тем
# самым подал отклик от имени оператора. Чтобы посмотреть форму, читайте СТРАНИЦУ ВАКАНСИИ и
# атрибут href у [data-qa=vacancy-response-link-top] — не переходя по нему.
RELOC_CONFIRM = "[data-qa=relocation-warning-confirm]"


def reloc_pending(probe):
    """Стоит ли между кликом и формой предупреждение hh «вы откликаетесь из другой страны». -> bool.

    ВЫНЕСЕНО В ЧИСТУЮ ФУНКЦИЮ, ПОТОМУ ЧТО ЭТО ГРАММАТИКА, А НЕ ЖЕСТ: тот же предикат читают и
    отклик, и рука снятия вопросов, и оба обязаны читать его одинаково — иначе одна ветка снимет
    оверлей, а вторая сочтёт страницу мёртвой.

    ЗАМЕРЕНО 2026-08-29 (job, руками, Team.Inno 133144964). Клик по
    [data-qa=vacancy-response-link-top] НЕ был мёртвым: body.children 30 -> 35, и hh дописывала
    DIV.magritte-overlay с текстом «You are applying from another country … Still apply / Cancel»
    и кнопками relocation-warning-confirm / -abort. Ни один селектор этого файла её не видел:
    состояние читалось через [role=dialog], которого у magritte-оверлея НЕТ, поэтому popup=false,
    path=/vacancy/<id> — и строка получала «клик прошёл, но отклика в списке НЕТ». Так висели
    ОДИННАДЦАТЬ строк доски с 25.08, среди них ТехВилл (fit=15, 550k) и Team.Inno (DSP/RTB, его
    домен), каждая по 3-5 попыток. Причина предупреждения — наш собственный егресс: узел ходит
    через exit-node за границей, поэтому hh видит отклик «из другой страны». Клик по confirm
    доводит отклик до конца — проверено живьём: страница вакансии сменилась на «You applied | Chat».

    ЭТО ЗАПИСЬ, а не проба: на прямой ветке hh подаёт отклик прямо этим подтверждением, без письма.
    Поэтому вызывающий обязан вернуть тот же PENDING_LETTER, что и ветка «подано по ссылке»."""
    return '"reloc": true' in probe or '"reloc":true' in probe


def open_response(vid):
    """Довести драйвер до формы отклика. -> (js-строка состояния, ошибка|None, снято-ли-предупреждение).

    Вынуто из apply_one, а не написано заново: снятие вопросов со страницы и сам отклик обязаны
    ходить одним путём, иначе анкета будет собрана с одной формы, а подана другая."""
    if drive(["--goto", "https://hh.ru/vacancy/%s" % vid], timeout=180).returncode != 0:
        return "", "hh browser-check не пропустил на страницу вакансии", False
    mark = log_size()
    drive(["--send", "click [data-qa=vacancy-response-link-top]"])
    time.sleep(6)
    if "[FAIL]" in log_since(mark):
        return "", "кнопки отклика нет на странице (архив? уже откликался?)", False
    # ОВЕРЛЕЙ ЧИТАЕТСЯ ДО ПОП-АПА И ЧЕРЕЗ СВОЙ СЕЛЕКТОР. Порядок здесь несущий: пока
    # предупреждение стоит, поп-апа отклика не существует, и чтение состояния формы отвечает про
    # страницу, на которой формы ещё нет.
    reloc = False
    markr = log_size()
    drive(["--send", "js () => JSON.stringify({reloc: !!document.querySelector('%s')})" % RELOC_CONFIRM])
    if wait_log(markr, "[js] ", 40):
        probe = [l for l in log_since(markr).splitlines() if l.startswith("[js] ")][-1]
        if reloc_pending(probe):
            reloc = True
            drive(["--send", "click %s" % RELOC_CONFIRM])
            time.sleep(6)
    mark2 = log_size()
    drive(["--send", "js () => { const p = document.querySelector('[data-qa=vacancy-response-submit-popup]');"
                     " const d = p ? p.closest('[role=dialog]') : null;"
                     " return JSON.stringify({popup: !!p, path: location.pathname,"
                     " ta: !!document.querySelector('[data-qa=vacancy-response-popup-form-letter-input]'),"
                     # СОСТОЯНИЕ КНОПКИ — это факт о форме; текст рядом с ней — мнение hh о ней.
                     # Предупреждение о видимости резюме держало отклики, которые уходили.
                     " submitDisabled: p ? !!p.disabled : null,"
                     " txt: d ? d.innerText.slice(0, 400) : ''}); }"])
    if not wait_log(mark2, "[js] ", 60):
        return "", "страница не ответила после клика по отклику", reloc
    return [l for l in log_since(mark2).splitlines() if l.startswith("[js] ")][-1], None, reloc


def do_reopen(dry, harvest, today):
    """Пере-открыть строки, чья причина снята. Артефакт — сама доска, а не этот вывод."""
    rows = [r for r in read_board() if r["state"] == "needs-human"]
    if harvest:
        # Разрыв круга: строка с questions не может доказать снятие причины, пока вопросы не
        # сняты со страницы, а сняты они бывают только в отклике, который эта же причина и
        # запрещает. Поэтому снятие вопросов — отдельная рука, ходящая тем же путём.
        #
        # ЭТА РУКА ЖМЁТ НАСТОЯЩУЮ КНОПКУ ОТКЛИКА, и на одной из трёх веток hh подаёт отклик прямо
        # по ссылке, без поп-апа и без письма. То есть «сходить посмотреть» способно отправить
        # отклик БЕЗ СОПРОВОДИТЕЛЬНОГО от его имени — наружу и необратимо. Поэтому:
        #   * взводится тем же ключом, что и сама отправка (MESH_JOB_AUTOAPPLY), а не «просто так»;
        #   * ветка «подано по ссылке» не молчит и не считается неудачей снятия: строка получает
        #     громкое примечание, чтобы проверяющий проход её увидел и досдал письмо в чат.
        if node_env("MESH_JOB_AUTOAPPLY") != "on":
            print("refused: --harvest жмёт настоящую кнопку отклика, а этот узел не вооружён"
                  " (MESH_JOB_AUTOAPPLY!=on)", file=sys.stderr)
            return 3
        # ЧЕРЕЗ ensure_driver, А НЕ ГОЛЫЙ --alive: этот путь тоже вызывается из cron, и «демона
        # нет» здесь означало ровно то же, что и в основном пути, — а печаталась та же константа,
        # называвшая не тот слой. Поднять демона — часть рефлекса; арм на MESH_JOB_AUTOAPPLY выше
        # уже пройден, так что ничего нового этот старт не разрешает.
        alive, why = ensure_driver()
        if not alive:
            print("n/a: hh-драйвер не поднялся — %s" % why, file=sys.stderr)
            return 2
        filed_ids, filed_complete, filed_reason = None, False, ""
        for r in rows:
            if r["reason"] != R_QUESTIONS or not r["id"]:
                continue
            if subprocess.run([ANSWERS, "--covered", "hh:%s" % r["id"]],
                              capture_output=True).returncode != 2:
                continue
            state, err, reloc = open_response(r["id"])
            if err:
                print("  снятие  %-22s не вышло: %s" % (r["employer"][:22], err))
                continue
            if "/applicant/vacancy_response" not in state:
                # Список откликов читается ОДИН раз на прогон, а не по строке: каждый вызов —
                # это goto в браузере, и цикл по девяти строкам гонял бы hh девять раз ради
                # одного и того же ответа. Читается ЛЕНИВО: прогон, где ветка не сработала ни
                # разу, не платит за него вовсе.
                if filed_ids is None:
                    _fr = negotiation_ids()
                    filed_ids, filed_complete, filed_reason = _fr.ids, _fr.complete, _fr.reason
                # ОТСУТСТВИЕ ПОП-АПА — НЕ ОТКЛИК. Первая версия этой ветки выводила «hh подал
                # отклик по ссылке» из того, что поп-ап не открылся, и 2026-08-24 повесила это
                # обвинение на две живые строки (Ozon, Открытые решения): в списке откликов hh не
                # было НИ ОДНОЙ из них. Ровно та же ошибка, от которой в этом файле стоит вся
                # проверка finalize — клик не есть отклик, — только вывернутая наизнанку: не
                # успех выведен из клика, а ПОСЛЕДСТВИЕ. Спрашиваем список откликов, как и везде.
                filed = r["id"] in filed_ids
                if not filed and not filed_complete:
                    print("  снятие  %-22s форма пропала, а список откликов прочитан НЕ ПОЛНОСТЬЮ"
                          " (%d строк, read=%s) — не сужу"
                          % (r["employer"][:22], len(filed_ids), filed_reason))
                    continue
                print("  снятие  %-22s %s%s" % (r["employer"][:22],
                      "hh ПОДАЛ отклик по ссылке (есть в списке откликов) — письма в нём НЕТ" if filed
                      else "формы вопросов на странице больше нет; в списке откликов её тоже нет",
                      " [снято предупреждение «отклик из другой страны»]" if reloc else ""))
                if filed:
                    set_state(r["i"], "needs-human",
                              "%s: снятие вопросов подало отклик по ссылке БЕЗ письма —"
                              " письмо нужно досдать в чат отклика" % today, R_RETRY)
                continue
            got = harvest_questions(r["id"], r["employer"])
            # A HARVEST OF ZERO IS NOT ALWAYS BLINDNESS, AND THE ROW MUST NOT SAY IT IS. When the
            # form's only item is an ATTESTATION our grammar deliberately refuses to read as a
            # question (Ozon's radio group — see apply_one), zero is what a CORRECT harvest returns,
            # and `clearable` would then hold the row forever on "сверять не с чем": the token's
            # clearer is this hand, and this hand had nothing left to try. Seven rows sat there.
            #
            # But the cause IS removable by us whenever hh renders the employer's own
            # apply-without-the-screening door — so ask, and re-open on it. The row goes back to
            # `seen`, and the next apply run walks apply_one, which takes that door and returns the
            # pending-letter sentinel. Without this the fix in apply_one is UNREACHABLE for exactly
            # the rows it was written for: `--reopen` is their only clearer, and it never asked.
            if got:
                print("  снятие  %-22s снято вопросов: %d" % (r["employer"][:22], got))
                continue
            if no_test_probe(r["id"]):
                print("  снятие  %-22s вопросов не разобрано, но работодатель предлагает отклик"
                      " без теста — %s" % (r["employer"][:22], "открыл бы (--dry)" if dry
                                           else "открываю"))
                if dry:
                    continue
                set_state(r["i"], "seen",
                          "%s: анкета не разбирается нашей грамматикой (аттестация, не вопрос),"
                          " но hh предлагает 'Откликнуться без теста' — отклик пойдёт этой"
                          " дверью, письмо в чат" % today)
                continue
            print("  снятие  %-22s снято вопросов: 0" % r["employer"][:22])
        rows = [r for r in read_board() if r["state"] == "needs-human"]

    n = 0
    for r in rows:
        ok, why = clearable(r)
        print("%-9s %-9s %-24s %s" % ("ОТКРЫТЬ" if ok else "держу", r["reason"] or "—",
                                      r["employer"][:24], why))
        if not ok or dry:
            continue
        set_state(r["i"], "seen", "%s: пере-открыто — причина %s снята (%s)" % (today, r["reason"], why))
        n += 1
    print("\nпере-открыто: %d из %d в needs-human%s" % (n, len(rows), " (--dry)" if dry else ""))
    return 0


def do_backfill(dry, today):
    """Разобрать токен из прозы у строк, написанных ДО появления колонки. Разово, по замыслу.

    Читается СВЕЖИЙ сегмент примечания: строка падала не один раз, и причина, по которой она
    лежит СЕЙЧАС, — последняя, а не первая. Не опознанное остаётся `unknown` и видно на доске."""
    n = 0
    for r in read_board():
        if r["state"] != "needs-human":
            continue
        # ДВА ВХОДА, И ВТОРОЙ — НЕ РАСШИРЕНИЕ ПЕРВОГО. Строка без колонки писалась до её появления.
        # Строка с `unknown` — это не «причина неизвестна», это «шаблона под этот текст НЕ БЫЛО
        # НАПИСАНО»: токен по определению временный и должен пере-выводиться, когда шаблон
        # появился, иначе он живёт вечно как диагноз, хотя был всего лишь пробелом в таблице.
        # Пере-вывод строго односторонний: трогаем ТОЛЬКО unknown и только если он перестал им
        # быть. Ни один опознанный токен здесь не переписывается — иначе одна правка грамматики
        # молча переклассифицировала бы всю доску.
        if r["reason"] and r["reason"] != R_UNKNOWN:
            continue
        why = reason_of(note_head(r["note"]))
        if r["reason"] == R_UNKNOWN and why == R_UNKNOWN:
            continue
        print("%-9s %-24s %s" % (why, r["employer"][:24], note_head(r["note"])[:88]))
        if dry:
            continue
        set_state(r["i"], "needs-human", None, why)
        n += 1
    print("\nпроставлено причин: %d%s" % (n, " (--dry)" if dry else ""))
    return 0


def selftest():
    global LETTER_BLOCKS, ANSWERS, CODE_PATH   # обе подменяются фикстурами ниже и возвращаются
    # Все подмены — одним объявлением В НАЧАЛЕ: python запрещает `global X` после первого
    # использования X в той же функции, и объявление, доехавшее до середины, ломает файл целиком.
    global SENT, UNCONFIRMED, set_state, log_send, BOARD, negotiation_ids
    rc = 0

    def check(label, cond):
        nonlocal rc
        print(("ok:   " if cond else "FAIL: ") + label)
        if not cond:
            rc = 1

    rows = read_board()
    check("board parses into rows with ids", len(rows) > 10 and any(r["id"] for r in rows))

    # ---- ЧЕМ ЗАПОЛНЯЕТСЯ ФОРМА РАБОТОДАТЕЛЯ. Два независимых конца одной аварии 2026-08-26:
    # четыре отклика ушли под именем оператора, неся в полях ответов справку mesh-job-answers.
    # Проверяются ОБА, потому что каждый чинит её в одиночку и ни один не должен зависеть от
    # другого.
    check("пустой вопрос НЕ считается вопросом, на который можно отвечать",
          not answerable("") and not answerable(None) and not answerable("   "))
    check("...а настоящий вопрос — считается", answerable("Ваш опыт с Go?"))
    _r = subprocess.run([ANSWERS, "--match", ""], capture_output=True, text=True, timeout=60)
    # Контракт, на который опирается строка `fill :nth-match(textarea,N)`: (rc==0 и stdout
    # непустой) обязано означать «вот ответ». Если банк снова начнёт печатать справку в stdout с
    # нулевым кодом, красным станет ЗДЕСЬ, у того, кто это печатает в чужую форму.
    check("mesh-job-answers на пустой вопрос не отдаёт ничего пригодного для набора в форму",
          not (_r.returncode == 0 and (_r.stdout or "").strip()))

    # ---- ПОЧЕМУ нужен человек. Гейт связывает ЖИВОЙ путь с разбором прозы: каждый текст отказа,
    # который этот тул умеет напечатать, обязан классифицироваться в тот же токен, что вернёт
    # nh() на живом пути. Иначе разбор старых строк читает НЕ ТУ грамматику, что парсер.
    LIVE = [("кнопки отклика нет на странице (архив? уже откликался?)", R_RETRY),
            ("работодатель задаёт свои вопросы — снял 3 в анкету", R_QUESTIONS),
            ("работодатель задаёт свои вопросы — не отвечаю за него", R_QUESTIONS),
            ("hh требует сменить видимость резюме — это правка профиля, не моё решение", R_PROFILE),
            ("поп-ап отклика без поля письма — незнакомая разновидность формы", R_FORM),
            ("кнопка отправки заблокирована и с заполненным письмом — форму тул не ведёт"
             " (дамп: formdump-blocked-1.txt)", R_FORM),
            # РЕТРОСПЕКТИВНО: этот текст печатала прежняя, снятая ДО заполнения проверка. Пять
            # строк доски носят его как `unknown` — не потому, что причина неизвестна, а потому,
            # что шаблона не было. Грамматика обязана узнавать и его, иначе разбор старых строк
            # читает не ту таблицу, что живой путь.
            ("кнопка отправки отклика заблокирована hh — форма не принимает отклик", R_FORM),
            ("поле письма в поп-апе не приняло текст", R_RETRY),
            ("не смог прочитать длину письма в поле", R_RETRY),
            ("письмо не попало в поле (в нём 0 символов)", R_RETRY),
            ("клик прошёл, но отклика в списке НЕТ", R_RETRY),
            ("письмо не собралось из его блоков", R_LETTER)]
    # ПУСТАЯ СТРАНИЦА. Первый байт — не выдуманный: это ровно то, что hh-drive.log хранит во всех
    # 14 дампах, стоящих после провалившейся навигации. Пустой строкой она не является — она
    # ПРОБЕЛЬНАЯ, и в этом вся разница между «сеть отказала» и «его блоки не подошли».
    # ОБРЕЗКА ХВОСТА hh. Фикстура — байты самой hh (список чужих вакансий из её подборок), потому
    # что проверять надо ровно то, что реально голосует за абзацы его письма.
    _body = "Обязанности\n" + "Разработка на Go под нагрузкой. " * 20
    _tail = "\nAsk the employer a question\nWhere is the workplace located?\nVacancies from other" \
            " selections\nJava team leader\nTeam lead .NET\nQA team lead\nSecure HeadHunter"
    check("hh's own furniture and OTHER vacancies' titles are cut off the text",
          strip_hh_chrome(_body + _tail).strip() == _body.strip())
    check("...and the cut takes the EARLIEST marker, not the last",
          "Where is the workplace" not in strip_hh_chrome(_body + _tail))
    check("a page with no chrome is returned untouched",
          strip_hh_chrome(_body) == _body)
    check("a marker inside a SHORT text does not shave the vacancy away",
          strip_hh_chrome("Ищем Go-разработчика. Report the vacancy")
          == "Ищем Go-разработчика. Report the vacancy")
    check("the trim can never turn a real page into a blank one",
          not page_is_blank(strip_hh_chrome(_body + _tail)))

    # Фикстура — дословные строки с живых форм hh (МТС 135307229, Домклик 136135317, X5 136091998).
    _meta = ("Просим ответить на следующие вопросы?",
             "Просим вас ответить на несколько вопросов, заполнение не займет больше 5 минут :)",
             "привет! ответьте, пожалуйста, на пару вопросов :)",
             "Спасибо за отклик. Ответь, пожалуйста, на вопросы ниже?")
    _real = ("Какой график работы рассматриваете?",
             "Что рассматриваете в окладе в месяц?",
             "Готовы ли прислать документы, подтверждающие опыт?",
             "Готовы ли на следующих этапах предоставить выписку из трудовой книжки?",
             # БЛИЖАЙШИЙ ПРОМАХ: несёт и «ответ», и «на следующем» — но не как одну фразу.
             "Ответственность за релиз лежит на следующем инженере?",
             "ПАО МТС не ИТ аккредитованная компания, готовы дальше общаться?")
    _META = META_LINE   # ТОТ ЖЕ объект, что читает живой путь: копия предиката — не гейт на него
    check("a form HEADING that merely talks about the questions is not queued as one",
          all(_META.search(t) for t in _meta))
    check("...and no REAL question from those same forms is dropped by it",
          not any(_META.search(t) for t in _real))

    check("a single newline — the byte the driver actually logged — reads as a blank page",
          page_is_blank("\n"))
    check("...and so do the empty string, whitespace and None",
          all(page_is_blank(x) for x in ("", "   ", " \n\t ", None)))
    check("a real vacancy body is NOT blank",
          not page_is_blank("\nОбязанности\nРазработка на Go под нагрузкой\n"))

    check("every refusal this tool can print classifies to its own token",
          all(reason_of(d) == want for d, want in LIVE))
    check("nh() is the ONE exit, and it mints the token the table names",
          all(nh(d) == ("needs-human", d, want) for d, want in LIVE))
    check("no live refusal falls through to unknown",
          all(nh(d)[2] != R_UNKNOWN for d, _w in LIVE))
    check("an UNSEEN refusal text is LOUD, never a silent retry",
          reason_of("hh ответил чем-то, чего мы ещё не видели") == R_UNKNOWN)
    check("every minted token is in the declared vocabulary",
          all(nh(d)[2] in REASONS for d, _w in LIVE))

    # Ни одна причина, снимаемая НЕ нами, не открывается сама. Дежурная ошибка: profile попадает
    # в общий «переходный» мешок и строка бесконечно перезванивает в дверь его аккаунта.
    for tok in (R_PROFILE, R_CAPTCHA, R_UNKNOWN):
        check("`%s` is never cleared by the tool itself" % tok,
              not clearable({"reason": tok, "note": "2020-01-01: старьё", "id": "1"})[0])
    # letter LEFT that list on 2026-08-28: the operator revoked the hand-back, so the tool clears
    # it — but only against a FACT ON DISK, never with time. Both directions, because a gate that
    # has only been seen pass is not a gate. `_old`/`_fresh` straddle letter-blocks.md's own mtime.
    # The blocks file's OWN mtime is the gate, so the fixture OWNS that mtime rather than reading
    # whatever the live file happens to carry today. Two arms against the LIVE file could not tell
    # this gate from a plain age threshold — the same note answered both — and a mutant that
    # cleared on `age > 1 day` passed them both. So: ONE note, held fixed at 5 days, judged twice
    # against two different blocks mtimes, and the two verdicts must be OPPOSITE. Nothing but the
    # file's mtime moves between them. [[a-fixture-whose-two-candidates-carry-one-value-cannot-discriminate]]
    _live_blocks = LETTER_BLOCKS
    _tmpb = pathlib.Path(tempfile.mkdtemp(prefix="jobletterblocks-")) / "letter-blocks.md"
    _tmpb.write_text("## opening\nx\n", encoding="utf-8")
    _note5 = time.strftime("%Y-%m-%d", time.localtime(time.time() - 5 * 86400)) + ": письмо не собралось"
    try:
        LETTER_BLOCKS = _tmpb
        os.utime(_tmpb, (time.time() - 10 * 86400,) * 2)          # blocks edited BEFORE the row failed
        _held = clearable({"reason": R_LETTER, "note": _note5, "id": "1"})
        os.utime(_tmpb, (time.time() - 1 * 86400,) * 2)           # blocks edited AFTER the row failed
        _open = clearable({"reason": R_LETTER, "note": _note5, "id": "1"})
        check("letter is HELD while the blocks have not moved since the row failed", not _held[0])
        check("...and the SAME note re-opens once the blocks are edited (the mtime IS the gate)",
              _open[0])
        check("the held wording names OUR work, not a wait on him",
              "letter-blocks.md" in _held[1] and "ЕГО" not in _held[1])
        os.utime(_tmpb, (time.time() - 10 * 86400,) * 2)
        check("letter with an UNDATED note is held: the age is unknown, not old",
              not clearable({"reason": R_LETTER, "note": "письмо не собралось", "id": "1"})[0])
        LETTER_BLOCKS = _tmpb.parent / "gone.md"
        check("an unreadable blocks file HOLDS the row rather than clearing it blind",
              not clearable({"reason": R_LETTER, "note": _note5, "id": "1"})[0])
    finally:
        LETTER_BLOCKS = _live_blocks
        shutil.rmtree(_tmpb.parent, ignore_errors=True)
    # form: тот же двусторонний гейт, что у letter, плюс потолок. Возраст кода берётся у ЖИВОГО
    # файла, поэтому фикстура двигает НОТУ, а не файл: одна и та же строка по разные стороны от
    # его mtime обязана дать противоположные вердикты.
    _live_code = CODE_PATH
    _cd = pathlib.Path(tempfile.mkdtemp(prefix="jobcode-")); _cf = _cd / "tool.py"
    _cf.write_text("x\n", encoding="utf-8")
    _n5 = time.strftime("%Y-%m-%d", time.localtime(time.time() - 5 * 86400)) \
          + ": незнакомая разновидность формы"
    try:
        CODE_PATH = _cf
        os.utime(_cf, (time.time() - 10 * 86400,) * 2)     # код старше строки
        _fh = clearable({"reason": R_FORM, "note": _n5, "id": "1"})
        os.utime(_cf, (time.time() - 1 * 86400,) * 2)      # код правлен ПОСЛЕ строки
        _fo = clearable({"reason": R_FORM, "note": _n5, "id": "1"})
        check("form is HELD while the tool's own code has not moved since the row failed",
              not _fh[0])
        check("...and the SAME note re-opens once the code is edited (the mtime IS the gate)",
              _fo[0])
        check("form stops re-opening at the attempt cap, whatever the code does",
              not clearable({"reason": R_FORM, "id": "1",
                             "note": " || ".join([_n5] * (RETRY_MAX + 1))})[0])
    finally:
        CODE_PATH = _live_code
        shutil.rmtree(_cd, ignore_errors=True)

    # VISIBILITY_RANK — это РАНГ, а не список синонимов, и порядок в нём решает, что мы нажмём.
    # Гейт на живых надписях hh (английский UI этого аккаунта) плюс на надписи, которой там НЕТ:
    # отчёт «требуемого варианта нет в UI» обязан отличаться от «не смог нажать».
    _live_opts = ["Visible to all employers registered on hh.ru", "Visible to selected employers",
                  "Hidden from selected employers", "Available only via direct link",
                  "Not visible to anyone"]
    def _pick(opts):
        for pat, name in VISIBILITY_RANK:
            for i, l in enumerate(opts):
                if re.search(pat, l, re.I):
                    return i, name
        return None, None
    _i, _n = _pick(_live_opts)
    check("самый широкий из ЖИВЫХ вариантов hh — 'все работодатели', и он первый в списке",
          _i == 0 and _n == "все работодатели hh")
    check("вариант, которого hh требует, в живом наборе ОТСУТСТВУЕТ (это отдельный факт)",
          not re.search(VISIBILITY_RANK[0][0], " | ".join(_live_opts), re.I))
    _wider = ["Видно всему интернету"] + _live_opts
    _i2, _n2 = _pick(_wider)
    check("...и если бы hh его предлагала, ранг выбрал бы ЕГО, а не 'всех работодателей'",
          _i2 == 0 and _n2 == "весь интернет")
    check("ранг не путает 'клиентским компаниям' с 'всеми работодателями'",
          _pick(["Visible to HeadHunter client companies"] + _live_opts)[1] == "клиентским компаниям hh")

    # --settle: строка, исчерпавшая попытки, обязана получить ОДИН из трёх исходов и ни одного
    # четвёртого. Гейт проверяет ветвление на фикстурах, а не живой прогон: живьём разом видна
    # одна ветка из трёх, и две оставшиеся никогда не были бы проверены.
    _tri = [("подан",   "У НАС В АРХИВЕ ЛЕЖИТ ЭТА СТРОКА", True,  "sent"),
            ("архив",   "Вакансия в архиве с 17 August 2026", False, "dropped"),
            ("жива",    "Обязанности\nРазработка на Go\nТребования", False, "needs-human")]
    for _lbl, _txt, _in_ids, _want in _tri:
        if _in_ids:
            _got = "sent"
        else:
            _got = "dropped" if is_archived(_txt) else "needs-human"
        check("--settle: %s -> %s" % (_lbl, _want), _got == _want)
    check("--settle: живая вакансия получает токен form, а не остаётся в retry",
          reason_of("вакансия жива, но 3 попытки отклика не дали записи в списке hh —"
                    " незнакомая разновидность формы") == R_FORM)
    check("--settle трогает только исчерпавшие потолок",
          retry_tries(" || ".join(["2026-01-01: клик прошёл, но отклика в списке НЕТ"] * RETRY_MAX))
          >= RETRY_MAX
          and retry_tries("2026-01-01: клик прошёл, но отклика в списке НЕТ") < RETRY_MAX)

    # And the wording itself is load-bearing: three tokens used to say the operator must act, and
    # he revoked that twice. Assert no reason this tool speaks hands the work back to him — bar
    # captcha, which genuinely does. A stale phrase here is a row that ages with no owner.
    _handback = ("ждут ЕГО", "снимает ОН", "снимают ЕГО", "не моё решение", "не отвечаю за него")
    # questions has THREE branches and only the third one carried the hand-back. A bare call lands
    # on branch two (an unknown id -> the answer bank exits 2, "вопросы не сняты"), so the arm that
    # was supposed to police the wording never reached the line it polices. Drive the branch: a stub
    # bank that exits 1 = "some questions are NOT covered", which is exactly the state that used to
    # be recorded as waiting on him. [[a-gate-arm-asserting-a-literal-makes-later-arms-unreachable]]
    _live_answers = ANSWERS
    _stubdir = pathlib.Path(tempfile.mkdtemp(prefix="jobanswers-"))
    _stub = _stubdir / "answers-partial"
    _stub.write_text("#!/bin/sh\nexit 1\n", encoding="utf-8")
    _stub.chmod(0o755)
    try:
        ANSWERS = str(_stub)
        _qtxt = clearable({"reason": R_QUESTIONS, "note": "2020-01-01: старьё", "id": "1"})[1]
        check("the questions branch under test is the PARTIAL-coverage one, not 'not harvested'",
              "не покрывает" in _qtxt or "ждут ЕГО" in _qtxt)
        check("`questions` (partial coverage) does not hand the work back to the operator",
              not any(h in _qtxt for h in _handback))
    finally:
        ANSWERS = _live_answers
        shutil.rmtree(_stubdir, ignore_errors=True)
    for _tok in (R_PROFILE, R_LETTER, R_FORM, R_UNKNOWN):
        _txt = clearable({"reason": _tok, "note": "2020-01-01: старьё", "id": "999999999"})[1]
        check("`%s` does not hand the work back to the operator" % _tok,
              not any(h in _txt for h in _handback))

    # ...AND THE SAME RULE IN THE DOCTRINE A HUMAN ACTUALLY READS. The arms above police the
    # RUNTIME reason strings, in Russian, that clearable() builds. They are structurally blind to
    # the module docstring — which is exactly what `--help` prints — and that docstring went on
    # assigning two of these three tokens to the operator for three days after the runtime strings
    # were rewritten: it named him as the clearer of `profile` and `letter`, and it still carried
    # the retired rule that screening questions are not ours to answer. Same file, one rule, two
    # statements, and the half a reader meets was the stale one.
    # [[a-format-fix-must-sweep-every-reader]]
    #
    # The literals live HERE and never in the docstring, so this gate cannot be satisfied by its own
    # explanatory prose the way a whole-file grep would be.
    # [[a-source-text-gate-is-satisfied-by-its-own-explanatory-prose]]
    _doc = __doc__ or ""
    for _stale in ("`profile`/`captcha` him", "`letter` his blocks", "the tool answers nothing"):
        check("--help doctrine no longer carries the retired hand-back: %r" % _stale,
              _stale not in _doc)
    # A blacklist of phrases already deleted catches nothing that has not happened yet, so the arm
    # that actually holds is POSITIVE: the docstring must NAME US as the clearer of both tokens.
    # Re-writing the paragraph back toward him fails here whatever words it picks.
    for _tok in ("profile", "letter"):
        check("--help doctrine names US as the clearer of `%s`" % _tok,
              ("`%s` US" % _tok) in _doc)
    check("--help doctrine leaves `captcha` as the one token that does wait on a human",
          "captcha" in _doc and "waits on a human" in _doc)
    # ── THE SCREENING FORM THAT NEITHER PATH COULD SEE ──────────────────────────────────────
    # Ozon's screening item is a radio group over an ATTESTATION, on a page with no textarea, so
    # `answer_questions` (textarea-only) and `harvest_questions` ('?' or an interrogative opener)
    # were both blind and the row wore "вопросы не сняты со страницы" over form text we had read.
    check("an attestation with no '?' is NOT recognised by the question grammar",
          not looks_question("Настоящим подтверждаю, что предоставленные сведения являются"
                             " достоверными, полными и точными."))
    check("...and a real question still is (the grammar was not widened to paper over it)",
          looks_question("Сколько лет вы писали на Go?"))
    # The predicate the live path uses, asked with the fixture seam. Both arms matter: a probe
    # that always says yes would click a button that is not there on every ordinary vacancy.
    check("the no-test affordance is seen when hh renders it",
          no_test_link(_probe='["vacancy-response-submit-popup","%s"]' % NO_TEST_QA))
    check("...and is NOT seen on a page without it", not no_test_link(_probe='["some-other-qa"]'))
    # THE SWEEP'S PROBE MUST LOOK AND NOT SEND. `--reopen --harvest` is a hand that goes to LOOK,
    # and this page's door files an application in one click with no confirmation — so a probe that
    # clicked would send an application under his name as a side effect of merely being asked
    # whether it could. The sweep's own guard comment warns about exactly this on the branch above.
    # Driven behaviourally against a recording stub, not by reading the source.
    global drive, wait_log, log_since
    _real = (drive, wait_log, log_since)
    _sent = []
    try:
        drive = lambda a, timeout=120: (_sent.append(" ".join(a)),
                                        types.SimpleNamespace(returncode=0))[1]
        wait_log = lambda *a, **k: True
        log_since = lambda *a, **k: '[js] ["%s"]' % NO_TEST_QA
        _saw = no_test_probe("1")
    finally:
        drive, wait_log, log_since = _real
    check("the sweep's probe finds the door on its live path", _saw)

    # ОБА ПЛЕЧА ДОСТАВКИ ИЩУТ ОДНУ НИТЬ, И ОНА ОБЯЗАНА ПЕРЕЖИТЬ innerText. Письмо собирается
    # абзацами, innerText переносы СОХРАНЯЕТ, а схлопнутая шапка их стирает — значит нить,
    # построенная схлопыванием, у любого письма с коротким приветствием пересекает разрыв абзаца
    # и не совпадает НИКОГДА. Фикстура — форма реального собранного письма (короткая первая
    # строка), и второе плечо утверждает, что она РАЗЛИЧАЕТ две конструкции: без него арм зелен
    # при любой из них и ничего не измеряет.
    _LTR = ("Здравствуйте.\n\nКак я работаю с кодом, а не только что я на нём написал: в DSP"
            " ввёл ревью ПОД НАГРУЗКОЙ.\n\nИлья Мозеров\n")
    check("нить треда переживает перенос строки (innerText их не схлопывает)",
          thread_needle(_LTR) in _LTR)
    check("...а схлопнутая шапка — НЕ переживает, т.е. фикстура различает две конструкции",
          " ".join(_LTR.split())[:40] not in _LTR)
    check("...and LOOKS ONLY — it never clicks, so a look cannot file an application",
          not any("click" in c for c in _sent))

    # ── ДВЕ РУКИ, ОДНА ГРАММАТИКА ────────────────────────────────────────────────────────────
    # ФИКСТУРЫ — ЖИВОЙ DOM, СНЯТЫЙ 2026-08-29, а не пересказ формы: `[data-qa=task-body]`
    # 135307229 (3 блока / 3 поля) и 136467936 (5 блоков / 5 полей). Первая — та самая, что шесть
    # раз за четыре дня уходила в needs-human со словами «банк покрыл не все», притом что банк
    # покрывает все три вопроса.
    _MTS = [{"t": "Что рассматриваете в окладе в месяц?\nType here",
             "ta": ["task_381436400_text"], "own": [], "rad": 0},
            {"t": "Какой график работы рассматриваете?\nГибрид 3 дня офис, 2 дня удаленка\n"
                  "Полностью удаленная работа\nГотов к офису 5\\2\nOwn variant",
             "ta": ["task_381436401_text"], "own": ["task_381436401"], "rad": 4},
            {"t": "ПАО МТС не ИТ аккредитованная компания, готовы дальше общаться?\nType here",
             "ta": ["task_381436405_text"], "own": [], "rad": 0}]
    check("каждый блок живой формы МТС отдаёт РОВНО свой вопрос, а не текст всей формы",
          [block_question(b["t"])[0] for b in _MTS]
          == ["Что рассматриваете в окладе в месяц?",
              "Какой график работы рассматриваете?",
              "ПАО МТС не ИТ аккредитованная компания, готовы дальше общаться?"])
    # ЭТО И ЕСТЬ ПОЧИНКА, СФОРМУЛИРОВАННАЯ КАК УТВЕРЖДЕНИЕ: снятые построчно вопросы (то, что
    # лежит в questions.tsv) и вопросы, прочитанные отвечающей рукой, — ОДИН И ТОТ ЖЕ список.
    _harv = []
    for _ln in "\n".join(b["t"] for b in _MTS).splitlines():
        _t = " ".join(_ln.split())
        if 8 <= len(_t) <= 300 and not META_LINE.search(_t) and looks_question(_t) \
                and _t not in _harv:
            _harv.append(_t)
    check("обе руки читают одно: построчная выемка и поблочная дают ОДИН список вопросов",
          _harv == [block_question(b["t"])[0] for b in _MTS])
    # НЕГАТИВНОЕ ПЛЕЧО. Кусок «вся форма разом» — ровно то, что возвращал подъём по родителям на
    # уровень выше task-body, — не смеет стать вопросом: банк отдал бы на него ПЕРВЫЙ совпавший
    # паттерн (замер: work-format на блоб из трёх вопросов МТС), и он лёг бы в поле про оклад.
    check("склеенная форма целиком НЕ читается как вопрос — банк на неё не спрашивается",
          block_question("\n".join(b["t"] for b in _MTS))[0] is None)
    check("два вопроса в одном поле работодателя (136467936, блок 0) — отказ, а не половина ответа",
          block_question("Есть ли у вас подтвержденный опыт работы в этой роли по ТК РФ?\n\n"
                         "Готовы ли на следующих этапах общения предоставить выписку из трудовой"
                         " книжки для подтверждения опыта?\n\nType here")[0] is None)
    check("...и два вопроса в ОДНОЙ строке — тоже (та же форма, блок 2)",
          block_question("У нас в стеке Kotlin (JVM) и Go. Был ли у вас опыт коммерческой"
                         " разработки на обоих языках? Какое соотношение этих языков было на"
                         " последнем месте?»\nType here")[0] is None)
    check("одиночный вопрос БЕЗ знака вопроса (повелительная форма) отказом не считается",
          single_question("Укажите ожидания по доходу") and
          block_question("Укажите ожидания по доходу\nType here")[0] == "Укажите ожидания по доходу")
    # Строка, которую до 2026-08-29 не видела НИ ОДНА из двух рук: '?' есть, но за ним кавычка.
    check("вопрос, закрытый кавычкой после '?', виден обеим рукам",
          looks_question("Какое соотношение этих языков было на последнем месте?»"))
    check("...и аттестация без '?' по-прежнему вопросом не становится",
          not looks_question("Настоящим подтверждаю, что предоставленные сведения являются"
                             " достоверными, полными и точными."))

    # ── ЧТО РУКА НА САМОМ ДЕЛЕ ПЕЧАТАЕТ В ФОРМУ ──────────────────────────────────────────────
    # Поведенчески, через записывающую заглушку драйвера: гейт на ТЕКСТ функции доказал бы
    # наличие строки, а не то, что ответ пришёл в СВОЁ поле.
    def _drive_answers(blocks, bank):
        global drive, wait_log, log_since, ANSWERS
        _r = (drive, wait_log, log_since)
        rec = []
        try:
            drive = lambda a, timeout=120: (rec.append(" ".join(a)),
                                            types.SimpleNamespace(returncode=0))[1]
            wait_log = lambda *a, **k: True
            log_since = lambda *a, **k: "[js] " + json.dumps(blocks)
            with tempfile.TemporaryDirectory() as td:
                stub = pathlib.Path(td) / "answers"
                stub.write_text("#!/usr/bin/env python3\n"
                                "import sys, json\n"
                                "bank = json.loads(%r)\n"
                                "q = sys.argv[2] if len(sys.argv) > 2 else ''\n"
                                "a = bank.get(q)\n"
                                "sys.exit(1) if a is None else print(a)\n" % json.dumps(bank),
                                encoding="utf-8")
                stub.chmod(0o755)
                _a = ANSWERS
                try:
                    ANSWERS = str(stub)
                    return answer_questions("1"), rec
                finally:
                    ANSWERS = _a
        finally:
            drive, wait_log, log_since = _r

    _bank = {"Что рассматриваете в окладе в месяц?": "500 000 ₽/мес на руки.",
             "Какой график работы рассматриваете?": "Стандартный 5/2, полный день.",
             "ПАО МТС не ИТ аккредитованная компания, готовы дальше общаться?": "Да, готов."}
    (_n, _why), _qsent = _drive_answers(_MTS, _bank)
    check("живой прогон по форме МТС: банк покрывает все три и отклик НЕ уходит человеку",
          _n == 3 and _why == "")
    # АДРЕСАЦИЯ ПО ИМЕНИ ПОЛЯ, А НЕ ПО НОМЕРУ. `:nth-match(textarea,i)` считал ВСЕ textarea
    # страницы, а i приходил из отфильтрованного (без письма) списка: сегодня они совпадают лишь
    # потому, что поле письма раскрывается позже. Утверждается ПАРА: ответ про оклад — в поле
    # оклада, ответ про график — в поле графика.
    check("ответ про оклад ушёл в СВОЁ поле по имени",
          "--send fill textarea[name=task_381436400_text] 500 000 ₽/мес на руки." in _qsent)
    check("ответ про график — в своё, и НЕ в поле оклада",
          "--send fill textarea[name=task_381436401_text] Стандартный 5/2, полный день." in _qsent)
    check("нумерованный селектор из формы ушёл совсем", not any("nth-match" in c for c in _qsent))
    # СВОЙ ВАРИАНТ ВЫБИРАЕТСЯ, ИНАЧЕ ТЕКСТ УЙДЁТ НИ К ЧЕМУ. Опознаётся по машинному value=open.
    def _at(hay, needle):
        """Позиция команды в записанной ленте, или -1. Через .index() этот арм ПАДАЛ бы
        исключением ровно на том дефекте, который ловит (клика нет), обрывая прогон и унося
        все последующие армы — красный, но не читаемый и не досчитанный."""
        return hay.index(needle) if needle in hay else -1
    _own_at = _at(_qsent, "--send click input[name=task_381436401][value=open]")
    _txt_at = _at(_qsent, "--send fill textarea[name=task_381436401_text]"
                          " Стандартный 5/2, полный день.")
    check("рядом с радиогруппой сначала выбирается «свой вариант», потом печатается текст",
          _own_at >= 0 and _txt_at >= 0 and _own_at < _txt_at)
    check("ни один из ПЕРЕЧИСЛЕННЫХ работодателем вариантов не выбирается за него",
          not any("value=381436" in c for c in _qsent))
    # ВСЁ ИЛИ НИЧЕГО, и отказ по форме НЕ печатает в неё ничего.
    (_n2, _why2), _qsent2 = _drive_answers(
        [{"t": "Есть ли у вас опыт по ТК РФ?\n\nГотовы ли прислать выписку?\n\nType here",
          "ta": ["task_1_text"], "own": [], "rad": 0}], _bank)
    check("форма с двумя вопросами в одном поле: ничего не заполнено",
          _n2 is None and not any(" fill " in c for c in _qsent2))
    check("...и причина названа ФОРМОЙ, а не пробелом в банке",
          _why2.startswith(FORM_UNREADABLE)
          and reason_of("незнакомая разновидность формы вопросов: %s — снял 2 строк(и) в анкету"
                        % _why2[len(FORM_UNREADABLE):].lstrip(": ")) == R_FORM)
    # Пробел В БАНКЕ — это ДРУГАЯ причина, и она обязана остаться `questions`: её снимает банк.
    (_n3, _why3), _qsent3 = _drive_answers(_MTS, {})
    check("вопрос, которого банк не знает, — по-прежнему `questions`, и форма пуста",
          _n3 is None and _why3 == "" and not any(" fill " in c for c in _qsent3))
    check("...и его проза классифицируется банковским токеном",
          reason_of("работодатель задаёт свои вопросы, банк покрыл не все — снял 3 в анкету")
          == R_QUESTIONS)
    # РАЗМЕТКИ НЕТ — ОТКАЗ, А НЕ ДОГАДКА. Раньше здесь стоял подъём по родителям любой textarea,
    # и он-то и возвращал '' на живой форме.
    (_n4, _why4), _qsent4 = _drive_answers([], _bank)
    check("страница без контейнеров вопросов: отказ по форме, ничего не напечатано",
          _n4 is None and _why4.startswith(FORM_UNREADABLE)
          and not any(" fill " in c for c in _qsent4))
    # Поле письма не смеет попасть под ответ ни при каком раскладе.
    check("поле сопроводительного письма отфильтровано в самом запросе к странице",
          "includes('letter')" in TASK_JS and TASK_QA in TASK_JS)
    # ЧТО ЭТОТ АРМ НЕ ДОКАЗЫВАЕТ: селектор исполняется в браузере, а фикстуры выше кормят функцию
    # готовым списком блоков — значит правильность самого селектора стоит на ЖИВОМ ЗАМЕРЕ
    # (3 блока / 3 поля на 135307229, 5 / 5 на 136467936, 2026-08-29), а не здесь. Держатся только
    # две формы запроса, которые уже провалились на этой странице: форма целиком (её innerText —
    # все вопросы разом, и банк отдаёт на него первый совпавший паттерн) и подъём по родителям
    # (не доезжал до контейнера и читал каждое поле как '').
    check("запрос идёт за контейнером ОДНОГО вопроса, а не за формой и не подъёмом по родителям",
          "querySelectorAll('form')" not in TASK_JS and "parentElement" not in TASK_JS)
    # THE LOAD-BEARING HALF IS THE LETTER. This path files an application that carries no letter
    # anywhere but the response chat, and the chat exists only once the application does — so the
    # detail MUST carry the pending sentinel finalize keys on. Return a bare "sent" here and the
    # application still goes out, under his name, permanently letterless and looking green.
    _st, _det, _rsn = ("sent", "отклик подан без теста (кнопка работодателя); " + PENDING_LETTER, "")
    check("the no-test path returns a state finalize will package a letter for",
          _st == "sent" and PENDING_LETTER in _det and not _rsn)
    check("...and the packaging trigger keys on that exact sentinel", PENDING_LETTER in _det)

    # ---- ПРЕДУПРЕЖДЕНИЕ hh «ВЫ ОТКЛИКАЕТЕСЬ ИЗ ДРУГОЙ СТРАНЫ». Замерено 2026-08-29 руками на
    # Team.Inno 133144964: клик по кнопке отклика НЕ мёртв — hh дописывает magritte-оверлей с
    # relocation-warning-confirm/-abort, у которого НЕТ [role=dialog], поэтому чтение состояния
    # видело popup=false и строка получала «клик прошёл, но отклика в списке НЕТ». Одиннадцать
    # строк доски висели на этом с 25.08. Гейт ПОВЕДЕНЧЕСКИЙ (стаб драйвера), а не грепом по
    # исходнику: важен ПОРЯДОК — подтверждение обязано быть снято ДО чтения формы, иначе читается
    # страница, на которой формы ещё нет.
    check("зонд оверлея читается по его же грамматике", reloc_pending('[js] {"reloc": true}')
          and reloc_pending('[js] {"reloc":true}') and not reloc_pending('[js] {"reloc": false}'))
    _real = (drive, wait_log, log_since)
    _rsleep = time.sleep
    _sent = []

    def _open_with(reloc_present):
        del _sent[:]
        def _d(a, timeout=120):
            _sent.append(" ".join(a))
            return types.SimpleNamespace(returncode=0)
        def _ls(*a, **k):
            last_js = [c for c in _sent if " js " in c or c.startswith("js ")]
            if last_js and "reloc:" in last_js[-1]:
                return '[js] {"reloc": %s}' % ("true" if reloc_present else "false")
            return '[js] {"popup": false, "path": "/vacancy/1", "ta": false, "txt": ""}'
        globals()["drive"], globals()["wait_log"], globals()["log_since"] = _d, (lambda *a, **k: True), _ls
        globals()["time"].sleep = lambda *_a, **_k: None
        return open_response("1")

    try:
        _st_r, _err_r, _reloc_r = _open_with(True)
        _seq_r = list(_sent)
        _st_n, _err_n, _reloc_n = _open_with(False)
        _seq_n = list(_sent)
    finally:
        globals()["drive"], globals()["wait_log"], globals()["log_since"] = _real
        globals()["time"].sleep = _rsleep

    def _idx(seq, needle):
        for i, c in enumerate(seq):
            if needle in c:
                return i
        return -1
    check("оверлей есть -> подтверждение НАЖАТО", _idx(_seq_r, "click " + RELOC_CONFIRM) >= 0)
    check("...и нажато ДО чтения формы, а не после (порядок — несущий)",
          0 <= _idx(_seq_r, "click " + RELOC_CONFIRM) < _idx(_seq_r, "vacancy-response-submit-popup"))
    check("...и факт снятия возвращается вызывающему, а не теряется", _reloc_r and not _err_r)
    check("оверлея нет -> ничего лишнего не нажимаем",
          _idx(_seq_n, "click " + RELOC_CONFIRM) < 0 and not _reloc_n)
    check("...а форма при этом всё равно прочитана", "popup" in _st_n and not _err_n)
