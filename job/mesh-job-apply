CV_GLOB = "cv*.md"
EMPLOYER_HEAD = re.compile(r"^###\s+(.+?)\s+[\u2014\u2013-]\s+.*?[\u00b7].*?(?:19|20)\d\d")
SYNC_BEGIN = "# >>> АВТО (mesh-job-apply --sync-blacklist): бывшие работодатели из его CV"
SYNC_END = "# <<< АВТО. Правь не здесь: allow: <имя> ниже снимает запрет и переживает пересинк."

# His profile, weighted. Positive terms are what he actually did; negatives are roles that share
# vocabulary with his but are not his job (a "1C developer" ad says разработка and Go-adjacent
# nothing). Weights are small integers on purpose — this is a sort key, not a model.
WEIGHTS = {
    "go": 6, "golang": 6, "highload": 4, "хайлоад": 4, "нагруз": 3, "распределён": 3,
    "kafka": 3, "clickhouse": 3, "terraform": 2, "kubernetes": 2, "микросервис": 2,
    "тимлид": 5, "team lead": 5, "teamlead": 5, "руководител": 5, "engineering manager": 5,
    "tech lead": 5, "head of": 4, "лидер": 2,
    "rtb": 5, "dsp": 5, "programmatic": 4, "adtech": 4, "реклам": 2, "openrtb": 5,
    "backend": 3, "бэкенд": 3, "архитект": 2, "sla": 2, "latency": 2,
    "1с": -8, "1c": -8, "продаж": -6, "курьер": -9, "оператор call": -9, "python": -1,
    "java": -1, "php": -1, "стажёр": -8, "junior": -8, "младший": -8,
}



# ЕГО РОЛЬ — ПРЕДИКАТ, А НЕ ВЕС. WEIGHTS выше — сортировочный ключ; ключ решает ПОРЯДОК, а не
# ДОПУСК, и пока потолок был 5, порядка хватало: шум оставался ниже среза. 2026-08-25 оператор
# поставил темп 2 собеседования в день, потолок подач подняли 5 -> 20, и в тот же день замер
# показал, что 73% свежих строк доски — не про разработку вовсе (Head of QA, Head of Legal,
# Младший юрист, Руководитель отдела ХоРеКа, Бригадир участка FBS, Team Lead Media Buying):
# hh ищет нестрого, и запрос про должность возвращает ДОЛЖНОСТЬ, а не роль. Веса этого не
# ловят — «head of» даёт +4, а за QA/юриста/логистику штрафа нет вообще, так что «Head of QA»
# обгоняет живую инженерную вакансию без зарплаты. Поднять срез, не поставив допуск, значит
# отправить эти строки работодателям ПОД ЕГО ИМЕНЕМ.
#
# Полярность выбрана по правилу «список исключений отказывает в сторону молчания»: перечислять
# чужие профессии бесполезно — их бесконечно много и каждый новый приходит молча. Гейт требует,
# чтобы строка САМА заявила предметную область, и незаявленная не проходит ГРОМКО, счётчиком.
DOMAIN_RE = re.compile(
    r"разработ|develop|инженер|engineer|программист|backend|бэкенд|fullstack|"
    r"golang|(?<!\w)go(?!\w)|(?<!\w)cto(?!\w)|технический директор|"
    r"архитектор|architect|devops|sre|платформ|platform|"
    r"engineering|software|программн", re.I)


def domain_hit(row):
    """-> True если строка заявляет инженерную предметную область в НАЗВАНИИ или employer.

    Смотрим title + employer, но НЕ note: note несёт нашу же служебную приписку («ru-adtech»,
    текст запроса, по которому строка нашлась), и запрос — это то, что спросили МЫ, а не то,
    что вакансия про себя говорит. Гейт, читающий собственный запрос, пропускает всё."""
    return DOMAIN_RE.search((row.get("title") or "") + " " + (row.get("employer") or "")) is not None


# Юридические формы, которые hh печатает в ОДНОМ месте и не печатает в другом. Строка ОДНА, и из
# неё строится и JS для списка чатов, и питоновский `strip_legal` ниже — иначе у одного факта
# («какая часть имени работодателя служебная») будет два расходящихся ответа, ровно как было с
# грамматикой ролей.
LEGAL_FORMS = "LLC|JSC|LLP|Ltd|Inc|GmbH|ООО|ОАО|ЗАО|АО|ПАО|ИП"
_LEGAL_RE = re.compile(r"(?:^|\b)(?:%s)\.?\s*" % LEGAL_FORMS, re.I)


def strip_legal(s):
    """Имя работодателя без юридической формы и кавычек. Питоновская половина той же нормализации,
    что уходит в JS: тестируется здесь, применяется там."""
    return re.sub(r"[«»\"']", "", _LEGAL_RE.sub("", s or "")).strip()


def _load_roles():
    """Импорт ОДНОЙ грамматики ролей — той же, что читает mesh-job-apply-getmatch.

    До 2026-08-25 у этого тула гейта роли НЕ БЫЛО ВООБЩЕ: были только веса, а вес решает ПОРЯДОК,
    не ДОПУСК. В тот же день, когда getmatch-лана отсеивала «Senior SRE Engineer», «Системный
    архитектор» и «Senior Go R&D Engineer» как снятый оператором IC-лейн, эта лана на них ПОДАЛА —
    три из девяти сегодняшних hh-откликов ушли на роли, которых он больше не ищет, с аккаунта,
    у которого есть лимит. Предикат теперь один и импортируется, а не копируется."""
    import importlib.util
    for c in (pathlib.Path(__file__).resolve().parent / "mesh-job-roles.py",
              pathlib.Path.home() / ".local/bin/mesh-job-roles.py"):
        if c.is_file():
            spec = importlib.util.spec_from_file_location("mesh_job_roles", c)
            m = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(m)
            return m
    raise SystemExit("mesh-job-roles.py не найден рядом со скриптом и в ~/.local/bin — "
                     "гейт роли не может решить молча, поэтому тул не стартует")


ROLES = _load_roles()


def node_env(key, default="off"):
    """Read a node-local switch from ~/.mesh/nodes WITHOUT sourcing it.

    cron gives a reflex an environment with nothing in it — no BASH_ENV, no login shell — so a
    gate that reads `os.environ` alone is armed only in a mind's pane. `mesh-job-apply` refused
    on every scheduled run for exactly that reason (4 of 4 in ~/.mesh/job-apply.log) while it
    worked by hand, which reads as "the node is not armed" rather than "the reflex cannot see
    the arming". Process env still wins, so a caller can override for one run."""
    v = os.environ.get(key)
    if v is not None:
        return v
    try:
        txt = (pathlib.Path.home() / ".mesh" / "nodes").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return default
    hit = None
    for line in txt.splitlines():
        m = re.match(r"\s*(?:export\s+)?%s=[\"']?([^\"'#\s]*)" % re.escape(key), line)
        if m:
            hit = m.group(1)
    return hit if hit is not None else default

def drive(args, timeout=120):
    return subprocess.run([HH] + args, capture_output=True, text=True, timeout=timeout)
# EVERY node-local knob goes through node_env(), not os.environ — see its docstring, which was
# written for exactly this trap and then guarded only the arming switch. cron hands a reflex an
# empty environment and never sources ~/.mesh/nodes, so a knob read from os.environ carries its
# DEFAULT on every scheduled run while showing the operator's value in a mind's pane. Measured
# 2026-08-25 with two arms: the cap was raised 5 -> 20 in ~/.mesh/nodes at 10:11Z and, under
# `env -i HOME PATH SHELL`, this tool still printed "Бюджет на сегодня: 5 из 5"; the same call with
# the variable in the process env printed 20. The raise was live in the pane and inert in the
# reflex — a config edit that reads as applied and is not.
# They sit BELOW node_env's definition on purpose: at module scope a name is not yet bound above
# its own def, and the first version of this fix put them at the old os.environ line 30 lines
# higher, where the whole tool died on import with NameError. ast.parse called that file good —
# parseable and runnable are different claims.
FLOOR = int(node_env("MESH_JOB_SALARY_FLOOR", "400000"))
CAP = int(node_env("MESH_JOB_DAILY_CAP", "5"))


def log_size():
    return LOG.stat().st_size if LOG.exists() else 0


def log_since(mark):
    with LOG.open("r", encoding="utf-8", errors="replace") as f:
        f.seek(mark)
        return f.read()


def wait_log(mark, needle, secs=90):
    for _ in range(secs // 2):
        time.sleep(2)
        if needle in log_since(mark):
            return True
    return False


def read_board():
    if not BOARD.exists():
        return []
    rows = []
    for i, l in enumerate(BOARD.read_text(encoding="utf-8").splitlines()):
        f = l.split("\t")
        if len(f) < 6:
            continue
        m = re.search(r"/vacancy/(\d+)", f[3])
        rows.append({"i": i, "date": f[0], "employer": f[1], "title": f[2], "url": f[3],
                     "state": f[4], "note": f[5], "id": m.group(1) if m else None,
                     "reason": f[6] if len(f) > 6 else ""})
    return rows


def set_state(idx, state, note_prefix=None, reason=""):
    """Седьмая колонка пишется на КАЖДОЙ смене статуса, не только на needs-human.

    Строка, уходящая ИЗ needs-human, обязана унести токен с собой — иначе пере-открытая строка
    продолжает предъявлять причину, которой уже нет, и следующий проход снова её «снимает».
    Ширина добивается до 7 здесь: доску дописывают четыре сканера, они кладут по 6 полей, и
    рваная строка не должна становиться заботой каждого читателя."""
    lines = BOARD.read_text(encoding="utf-8").splitlines()
    f = lines[idx].split("\t")
    while len(f) < 7:
        f.append("")
    f[4] = state
    f[6] = reason if state == "needs-human" else ""
    if note_prefix:
        f[5] = note_prefix + " || " + f[5]
    lines[idx] = "\t".join(f)
    BOARD.write_text("\n".join(lines) + "\n", encoding="utf-8")


def parse_salary(note):
    m = re.search(r"от (\d+) ₽", note)
    return int(m.group(1)) if m else None


def score(row):
    hay = (row["title"] + " " + row["employer"] + " " + row["note"]).lower()
    s = sum(w for k, w in WEIGHTS.items() if k in hay)
    sal = parse_salary(row["note"])
    if sal is None:
        s -= 2                      # unknown pay is not disqualifying (Ozon's was blank) but ranks below a stated one
    elif sal < FLOOR:
        s -= 20                     # below his floor: effectively out, without hiding it from --json
    else:
        s += min(6, (sal - FLOOR) // 100000 + 2)
    return s


# What a blacklist line MEANS, not just that it matches. `дедуп` (one seat per employer) and
# `бывший работодатель` (his own employment history) are opposite kinds of refusal — the first is
# etiquette and expires, the second is his life and does not — and a flat list of names could not
# tell them apart, so nothing printed before a run said WHY a name was out.
KINDS = {"former": "бывший работодатель", "dedup": "дедуп",
         "operator": "прямой запрет оператора", "rule": "правило из blacklist.txt"}


def blacklist_entries():
    """-> [(kind, pattern)]. A bare line stays a bare substring rule: the file predates this
    format and a re-read that silently stopped honouring т-банк would be a regression."""
    if not BLACKLIST.exists():
        return []
    out = []
    for l in BLACKLIST.read_text(encoding="utf-8").splitlines():
        l = l.strip()
        if not l or l.startswith("#"):
            continue
        kind, _, rest = l.partition(":")
        if rest.strip() and (kind.strip().lower() in KINDS or kind.strip().lower() == "allow"):
            out.append((kind.strip().lower(), rest.strip().lower()))
        else:
            out.append(("rule", l.lower()))
    return out


def _word_hit(pat, hay):
    """Whole-word match. A former employer is matched on his EMPLOYER field by word, never by
    substring: MERA as a substring blocks «премьера» and «камера», i.e. an auto-populated list
    would have quietly eaten unrelated vacancies — the auto-population's own failure mode."""
    return re.search(r"(?<!\w)%s(?!\w)" % re.escape(pat), hay) is not None


def blacklist_hit(row):
    """-> (reason, pattern) | None."""
    emp = (row.get("employer") or "").lower()
    hay = (emp + " " + (row.get("title") or "")).lower()
    ents = blacklist_entries()
    # His word first: an `allow:` line is the operator overriding the auto-population, so it must
    # beat every kind below it AND survive the next sync (see sync_blacklist).
    for kind, pat in ents:
        if kind == "allow" and pat in hay:
            return None
    # EVERY matching kind is collected, not the first one. Foxible is both a former employer and
    # his direct word, and the file's own line order decided which of the two the operator got to
    # read — the auto-populated `former:` block appends last, so the label «бывший работодатель»
    # (the whole point of populating it) lost to a hand-written bare line every time.
    hits = []
    for kind, pat in ents:
        if kind == "allow":
            continue
        if _word_hit(pat, emp) if kind == "former" else pat in hay:
            hits.append((kind, pat))
    if not hits:
        return None
    order = ["former", "operator", "dedup", "rule"]
    hits.sort(key=lambda kp: order.index(kp[0]))
    seen, labels = set(), []
    for kind, _ in hits:
        if KINDS[kind] not in seen:
            seen.add(KINDS[kind])
            labels.append(KINDS[kind])
    return " + ".join(labels), hits[0][1]


def blacklisted(row):
    return blacklist_hit(row) is not None


def cv_employers():
    """Every employer in his CV history, from the CV files themselves.

    The point of the whole exercise: the ban list must be full BEFORE a run, not after he reads a
    name in TG. On 2026-08-21 the ranker put Foxible — the employer he is in a dispute with — into
    a batch, and what stopped it was not a gate but a page that failed to load. Nothing in the
    scoring knows he ever had a job."""
    names, seen = [], set()
    for f in sorted((MESH / "job").glob(CV_GLOB)):
        if "SUPERSEDED" in f.name:
            continue
        try:
            txt = f.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for l in txt.splitlines():
            m = EMPLOYER_HEAD.match(l)
            if not m:
                continue
            n = m.group(1).strip()
            if len(n) < 3 or n.lower() in seen:
                continue
            seen.add(n.lower())
            names.append(n)
    return names


def sync_blacklist(write=True):
    """Refresh the managed `former:` block in blacklist.txt. -> (added, names).

    Idempotent: the block is rewritten whole between its markers, so a name he removed by hand
    comes back (that is the point) — unless he wrote `allow: <name>`, which suppresses it here and
    at match time both. Hand-written lines outside the markers are never touched."""
    names = cv_employers()
    txt = BLACKLIST.read_text(encoding="utf-8") if BLACKLIST.exists() else ""
    allow = [p for k, p in blacklist_entries() if k == "allow"]
    keep = [n for n in names if not any(a in n.lower() for a in allow)]
    body = "\n".join("former: %s" % n for n in keep)
    block = "%s\n%s\n%s\n" % (SYNC_BEGIN, body, SYNC_END)
    lines, out, inside = txt.splitlines(True), [], False
    had = set()
    for l in lines:
        if l.startswith(SYNC_BEGIN):
            inside = True
            continue
        if inside:
            if l.startswith("# <<< АВТО"):
                inside = False
            elif l.strip():
                had.add(l.strip().partition(":")[2].strip().lower())
            continue
        out.append(l)
    base = "".join(out).rstrip("\n")
    added = [n for n in keep if n.lower() not in had]
    new = (base + "\n\n" if base else "") + block
    if write and new != txt:
        BLACKLIST.parent.mkdir(parents=True, exist_ok=True)
        BLACKLIST.write_text(new, encoding="utf-8")
    return added, keep


SENDLOG = MESH / "job" / "sent-log.tsv"


# ИСХОД ДОСТАВКИ ПИСЬМА — пятая колонка ледждера. Раньше «отправлено» писалось ОДИНАКОВО для
# отклика с письмом и для отклика без него: 2026-08-25 в ледждере 12 строк за день, и 7 из них
# сопровождались в логе словами «письмо в чат НЕ ушло». Ледждер был ЧИСЛИТЕЛЕМ БЕЗ ЗНАМЕНАТЕЛЯ
# ДОСТАВКИ — а именно он считает дневной кап, так что кап тратился на отклики, до которых письмо
# не дошло, и никакой запрос не мог их отличить. Доска различала (в прозе note), ледждер нет.
#
# Неузнанная формулировка выходит как `unknown`, а НЕ как `delivered`: классификатор, чей
# fall-through совпадает с хорошим исходом, врёт в льстивую сторону ровно тогда, когда появляется
# новая формулировка — то есть когда он нужнее всего.
DELIVERY = [
    ("no-chat", ("письмо в чат НЕ ушло", "чат по этой вакансии не найден", "чат не открылся",
                 "поле сообщения в чате не приняло текст", "поле письма не предлагалось")),
    ("delivered", ("письмо отправлено в чат", "из поп-апа с письмом", "вопрос(ов) отвечено из банка",
                   "отклик отправлен со страницы")),
]


def delivery_of(detail):
    """-> 'delivered' | 'no-chat' | 'unknown'. Порядок важен: строка «отклик подан по ссылке, но
    письмо в чат НЕ ушло» содержит и утверждение о подаче, и опровержение доставки, поэтому
    ОТРИЦАНИЕ проверяется первым."""
    d = detail or ""
    for verdict, needles in DELIVERY:
        if any(n in d for n in needles):
            return verdict
    return "unknown"


def log_send(vid, employer, title, detail=""):
    """One line per CONFIRMED application, stamped with the day it was sent AND with whether the
    letter actually reached the employer."""
    SENDLOG.parent.mkdir(parents=True, exist_ok=True)
    with SENDLOG.open("a", encoding="utf-8") as f:
        f.write("%s\t%s\t%s\t%s\t%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), vid,
                                            employer.replace("\t", " "), title.replace("\t", " "),
                                            delivery_of(detail)))


def sent_today(rows, today):
    """How many applications went out TODAY — the number the daily cap is about.

    The board's first column is the day the vacancy was SCANNED, not the day it was answered,
    so counting `r["date"] == today` undercounts every application filed against an older scan
    row — which is most of them — and the cap that protects his name from a carpet-bomb was
    quietly larger than 5. The send ledger stamps the send. The board count is kept as a floor
    so a hand-sent row that never reached the ledger still consumes budget."""
    board = sum(1 for r in rows if r["state"] in ("sent", "viewed", "invited", "interview", "replied")
                and r["date"] == today)
    ledger = 0
    try:
        for line in SENDLOG.read_text(encoding="utf-8").splitlines():
            if line.startswith(today):
                ledger += 1
    except Exception:
        pass
    return max(board, ledger)


# hh's vacancy page carries, BELOW the employer's own text, a block of its own furniture and —
# worse — a list of OTHER people's vacancy titles ("Java team leader", "Team lead .NET", "QA team
# lead"). The letter picks his paragraphs by keyword overlap with this text, so that list votes on
# which of HIS facts an employer is told about. Measured 2026-08-28 over the 181 real page dumps in
# hh-drive.log: 64 carry "Vacancies from other selections", 59 carry the footer "Secure HeadHunter"
# — and that footer alone accounted for 59 of the 61 pages whose text contained the word "secure".
# A tag matching the page's CHROME is a tag matching every vacancy equally, which is the same as
# matching none: it adds a constant to the score and moves the ranking without carrying a signal.
CHROME_MARKS = ("Ask the employer a question", "Задайте вопрос работодателю",
                "Vacancies from other selections", "Вакансии из подборок",
                "Report the vacancy", "Пожаловаться на вакансию",
                "Похожие вакансии", "Similar vacancies")
CHROME_MIN = 400   # ниже этого обрезка съела бы саму вакансию — тогда лучше не резать вовсе


def strip_hh_chrome(text):
    """Отрезать хвост страницы hh, который принадлежит hh, а не работодателю.

    Режем по САМОМУ РАННЕМУ маркеру, а не по последнему: между ними лежат «Отзывы о компании» и
    «Курсы по профессии», которые тоже не про эту вакансию. Если обрезок короче CHROME_MIN — маркер
    попался в теле вакансии (или страница и так короткая), и текст возвращается целиком: обрезка,
    способная выдать пустоту, опаснее хвоста, который она убирает."""
    cut = min((text.find(m) for m in CHROME_MARKS if m in text), default=-1)
    if cut < 0:
        return text
    head = text[:cut]
    return head if len(head.strip()) >= CHROME_MIN else text


def page_is_blank(text):
    """Прочитали ли мы ПУСТУЮ страницу. Вынесено отдельно, потому что это и есть решающая
    грамматика этого отказа: маркер `[text]` в логе драйвера доказывает, что доехала КОМАНДА, а
    не что под ней была СТРАНИЦА. Провалившийся goto оставляет about:blank, `text body` печатает
    маркер и ОДИН перевод строки, и охранник `if not text` пропускает его как истину — ровно так
    14 отказов сети записались в доску как дефект писем оператора (замер 2026-08-28)."""
    return not (text or "").strip()


def vacancy_text(vid):
    """-> (текст вакансии, причина неудачи|None). Причина НАЗЫВАЕТ СЛОЙ, который отказал.

    ЗАЧЕМ ПАРА, А НЕ СТРОКА. Пока эта функция возвращала одну строку, отказ СЕТИ приезжал к
    вызывающему неотличимо от прочитанной страницы, и вся дальнейшая цепочка обвиняла в нём
    ПИСЬМО ОПЕРАТОРА. Замерено 2026-08-28 по тапе самого драйвера: из 195 дампов `text body` в
    hh-drive.log ровно 14 пустых (один \n) — и это РОВНО те 14 строк доски, что лежали в
    needs-human с причиной `letter`, «письмо не собралось из его блоков». Каждый из 14 стоит
    непосредственно после ПРОВАЛИВШЕЙСЯ навигации (10x net::ERR_SOCKS_CONNECTION_FAILED, 4x
    net::ERR_NETWORK_CHANGED). Обратная проверка: захваченный НЕПУСТОЙ текст тех же вакансий даёт
    по 4 блока каждой — блоки были ни при чём.

    Две ошибки стояли одна на другой, и правятся обе:
      * `--goto` возвращал 0 на упавшей навигации (у mesh-hh-drive wall_of было три слова
        ok/check/vpn, и «[FAIL] Error Page.goto: net::ERR_...» падало в ветку ok). Теперь есть
        четвёртое слово `neterr` и свой код возврата 3.
      * МАРКЕР `[text]` В ЛОГЕ ДОКАЗЫВАЕТ, ЧТО ДОЕХАЛА КОМАНДА, А НЕ ЧТО БЫЛА СТРАНИЦА. Команда
        доезжала — до about:blank. Пустой текст здесь ПРОБЕЛЬНЫЙ, а не пустой, поэтому охранник
        `if not text` у вызывающего пропускал его как истину. Судим по .strip().

    Строка, упавшая здесь, НЕ уходит в needs-human: сеть не является дефектом вакансии и не
    является дефектом его резюме. Она остаётся открытой и будет взята следующим прогоном."""
    rc = drive(["--goto", "https://hh.ru/vacancy/%s" % vid], timeout=180).returncode
    if rc == 3:
        return None, "страница вакансии НЕ ЗАГРУЗИЛАСЬ — отказ сети, навигация не завершилась"
    if rc != 0:
        return None, "страница вакансии не открылась (драйвер вернул %d)" % rc
    mark = log_size()
    drive(["--send", "text body"])
    if not wait_log(mark, "[text]", 60):
        return None, "страница вакансии не прочиталась — драйвер не ответил на text body"
    chunk = log_since(mark)
    i = chunk.find("[text]")
    text = chunk[i + 6:] if i >= 0 else ""
    text = strip_hh_chrome(text)
    if page_is_blank(text):
        return None, ("страница вакансии ПУСТАЯ — читали не вакансию, а предыдущую страницу"
                      " (отказ сети); блоки письма тут ни при чём")
    return text, None


def type_letter(letter):
    """Queue the letter as type/press verbs. hh's textarea is typed, not filled: a paste-shaped
    fill leaves the React state empty on this form and the send button stays disabled."""
    import textwrap
    cmds = ["mouse 640 320", "wait 600"]
    paras = [p.strip() for p in letter.split("\n\n") if p.strip()]
    for i, p in enumerate(paras):
        chunks = textwrap.wrap(" ".join(p.split()), 130, break_long_words=False)
        for j, c in enumerate(chunks):
            if j:
                cmds.append("press Space")
            cmds.append("type textarea " + c)
        if i != len(paras) - 1:
            cmds += ["press Enter", "press Enter"]
    return cmds


NEGOTIATIONS_MAX_PAGES = 12   # 20 на страницу; выше — hh, которую мы больше не понимаем

# ЧТЕНИЕ СПИСКА ОТКЛИКОВ — ЭТО НЕ ОДИН БИТ. Пока negotiation_ids() возвращала (ids, complete),
# ЧЕТЫРЕ разных мира давали один и тот же ответ (пустое множество, complete=False), и --test
# красил их одним словом: «список прочитан ЧАСТИЧНО» + FAIL про пагинацию. Замер 2026-08-29
# (health {#e3b82eb5} -> genome): арм упал rc=1, а живой причиной было то, что СЕССИЯ РАЗЛОГИНЕНА —
# страница отрендерилась полностью (1420 символов, [data-qa=account-login-form], «Войти с
# паролем»), никакая стена и никакая пагинация тут ни при чём. Обвинение уехало в пагинацию,
# то есть в код, который был исправен.
#
# Хуже промаха: ветка `if not ids` объявляла ЛЮБОЙ нуль слепотой и возвращала n/a. Значит
# РАЗЪЕХАВШИЙСЯ СЕЛЕКТОР — hh переименовала data-qa, счётчик «Все N» на месте, элементов ноль —
# навсегда молчал бы как «нас не пустили». Направление отказа — тишина, ровно то, что этот файл
# запрещает в пяти других местах.
#
# Поэтому чтение публикует ПРИЧИНУ, и у каждого мира своё слово и свой вердикт:
#   ok             — список дочитан до конца (число hh сошлось)
#   partial        — элементы есть, но число самой hh больше -> ДЕФЕКТ ЧТЕНИЯ (red)
#   selector-drift — hh считает N>0, а на первой странице ноль элементов -> ДЕФЕКТ ПАРСЕРА (red)
#   empty          — hh своим же числом говорит 0: список честно пуст (полный)
#   logged-out     — на странице форма входа: чинится ЧЕЛОВЕКОМ, не этим кодом (n/a)
#   blind          — страница ответила, но ни элементов, ни счётчика, ни формы входа (стена) (n/a)
#   nav-failed     — навигация/js не ответили вовсе: драйвер или аплинк (n/a)
# Порядок в hh_read_reason() значим: положительный ответ (есть элементы) бьёт всё остальное,
# иначе один залётный логин-виджет объявил бы слепым прогон, который на самом деле прочитал список.
HHRead = collections.namedtuple("HHRead", "ids complete reason declared")

# ЗАПРОС К СТРАНИЦЕ — КОНСТАНТА, А НЕ ЛОКАЛЬНАЯ СТРОКА, чтобы --test мог УБЕДИТЬСЯ, ЧТО МЫ ВООБЩЕ
# СПРАШИВАЕМ про форму входа. Уберите `login:` из этого запроса — и разлогиненная сессия начнёт
# честно классифицироваться как `blind`, то есть как стена: слово поменяется, вердикт (n/a)
# нет, а человек пойдёт чинить не то. Это ПРОВОДКА, а не поведение: арм утверждает, что вопрос
# задан, и НЕ утверждает, что hh на него отвечает — второе может сказать только живой прогон на
# залогиненной сессии.
NEGOTIATIONS_JS = (
    "JSON.stringify({ids:Array.from(document.querySelectorAll('[data-qa=negotiations-item] a'))"
    ".map(a=>a.getAttribute('href')).filter(x=>x&&x.indexOf('vacancy')>=0),"
    "all:((document.body.innerText||'').match(/\\b(?:All|Все)\\s+(\\d+)/)||[])[1]||null,"
    "login:!!document.querySelector('[data-qa=account-login-form],[data-qa=applicant-login-card]'),"
    "url:location.href})")


def hh_read_reason(first, ids, declared, complete):
    """Чистая функция: по ПЕРВОЙ странице (dict от js, либо None) и итогу -> слово причины.

    Вынесена отдельно и без браузера именно для того, чтобы --test гонял её мутациями, а не
    ловил один живой мир, который сегодня случился."""
    if first is None:
        return "nav-failed"
    if ids:
        return "ok" if complete else "partial"
    if first.get("login"):
        return "logged-out"
    if declared == 0:
        return "empty"
    if declared:
        return "selector-drift"
    return "blind"


# Что читатель должен сделать с каждым словом. n/a — это НЕ «всё хорошо»: это «здесь нечего
# утверждать», и оно обязано назвать, чья рука чинит.
HH_READ_NA = {
    "nav-failed": "драйвер/аплинк: страница или js не ответили за две попытки"
                  " — см. `mesh-hh-drive --peek`",
    "logged-out": "СЕССИЯ РАЗЛОГИНЕНА: hh отдала форму входа ([data-qa=account-login-form])."
                  " Это чинится входом в браузере (`mesh-hh-drive --shot login`), а не этим кодом",
    "blind":      "стена/неизвестный рендер: ни элементов, ни счётчика hh, ни формы входа"
                  " — см. `mesh-hh-drive --peek`",
    "empty":      "hh своим же числом говорит 0 откликов — сверять и нечего",
}


def hh_live_arms(read):
    """Что --test ИМЕЕТ ПРАВО утверждать про живое чтение. -> (na_reason|None, [(label, ok)...]).

    Вынесено из тела --test отдельной функцией ровно затем, чтобы ПОРЯДОК («сначала причина,
    потом утверждение») гонялся мутацией, а не глазами. Пока это были две соседние строки в
    --test, единственным свидетелем порядка был тот мир, который сегодня случился, — и он был
    неправильный: арм про пагинацию стоял ПЕРВЫМ и красил слепое чтение в FAIL.

    С n/a-причиной список арм ПУСТ. Не «зелёный» — пустой: утверждать нечего, и это разные вещи."""
    if read.reason in HH_READ_NA:
        return read.reason, []
    arms = [("the filed-applications list is read to the END, not one page of it", bool(read.complete))]
    # Многостраничность утверждается только там, где у hh больше одной страницы. Старый предикат
    # `len(ids) > 20` был привязан к РАЗМЕРУ растущего списка и на аккаунте с 15 откликами красил
    # честно дочитанный список — тот же дефект, что сгноил зашитую фикстуру из двух id.
    if (read.declared or 0) > 20:
        arms.append(("...and hh's own count says more than one page, so the multi-page walk really ran",
                     len(read.ids) > 20))
    return None, arms


def negotiation_ids():
    """Список откликов hh. -> (ids, complete).

    ОТСУТСТВИЕ В НЕПОЛНОМ СПИСКЕ — ЭТО НЕИЗВЕСТНОСТЬ, А НЕ «ОТКЛИКА НЕТ». Эта функция читала
    ПЕРВУЮ страницу и возвращала голое множество, а `finalize` — единственный судья, имеющий право
    объявить отклик состоявшимся, — трактовал отсутствие в нём как доказательство, что отклик не
    ушёл: строка уезжала в needs-human «клик прошёл, но отклика в списке НЕТ», а собранное письмо
    ложилось в `unconfirmed/` под заголовком «НЕ ОТПРАВЛЕНО». Замер 2026-08-28, в одном чтении:
    hh пишет над списком «All 49», страница отдаёт 20 элементов, и функция возвращала 20 — то есть
    знаменатель был 41% истины, а 29 реальных откликов были неотличимы от неподанных. В том же
    прогоне 12 строк из 20 получили ровно этот приговор, при том что счётчик самой hh за прогон
    вырос с 5 до 14.

    Факт про страницы В ЭТОМ ЖЕ ФАЙЛЕ БЫЛ — «hh отдаёт список откликов СТРАНИЦАМИ по 20», записан
    2026-08-25 в комментарии к --test, когда об это разбилась зашитая фикстура. Знание осталось
    рядом с фикстурой и не дошло до функции, которая на нём стоит.

    Поэтому: страницы читаются до конца, а полнота ПУБЛИКУЕТСЯ вместе со списком и сверяется с
    ЧИСЛОМ САМОЙ hh («All N» / «Все N»), а не с тем, что страница вернула меньше двадцати.

    -> HHRead(ids, complete, reason, declared). ПРИЧИНА — не украшение: пустое множество раньше
    означало сразу четыре разных мира (см. блок над hh_read_reason), и читатель не мог отличить
    «нас разлогинило» от «парсер разъехался». `login` берётся СТРУКТУРНО, по data-qa формы входа,
    а не по слову «Войти»: текст у hh двуязычный и A/B-шный, а форма входа — нет."""
    js = NEGOTIATIONS_JS
    ids, declared, complete, first = set(), None, False, None
    for page in range(NEGOTIATIONS_MAX_PAGES):
        url = "https://hh.ru/applicant/negotiations" + ("?page=%d" % page if page else "")
        # ОДНА СТРАНИЦА — ОДИН ФЛАП ДОНГЛА. Единственный аплинк этого узла — USB-донгл, который
        # регулярно отваливается, и с тех пор как nav() перестал врать про net::ERR (сегодня же),
        # неудачная навигация ЧЕСТНО возвращает ненулевой код — то есть весь список объявляется
        # прочитанным не полностью из-за одной неудачной страницы. Направление отказа безопасное
        # (строка остаётся открытой), но если это норма, finalize перестаёт подтверждать вообще
        # что-либо, и лейн копит «seen» вечно. Поэтому страница пере-читается: флап короче, чем
        # пауза между попытками. Сдаёмся ЯВНО и с публикацией неполноты, а не тихо.
        payload = None
        for attempt in range(2):
            if drive(["--goto", url], timeout=180).returncode != 0:
                time.sleep(4)
                continue
            mark = log_size()
            drive(["--send", "js " + js])
            if not wait_log(mark, "[js] {", 60):
                time.sleep(4)
                continue
            payload = [l for l in log_since(mark).splitlines() if l.startswith("[js] {")][-1]
            break
        if payload is None:
            # Первая страница не ответила — это слепота драйвера/аплинка, и её нельзя путать с
            # прочитанным пустым списком. Дальние страницы: список неполон, но ПРИЧИНА уже
            # известна из первой (мы её видели), поэтому она и публикуется.
            return HHRead(ids, False, hh_read_reason(first, ids, declared, False), declared)
        if page == 0:
            try:
                first = json.loads(payload[len("[js] "):]) if payload.startswith("[js] ") \
                    else json.loads(payload)
            except Exception:
                # Полезная нагрузка есть, но не разбирается — это НЕ «страница не ответила».
                # Пустой dict честно доедет до hh_read_reason как «ни элементов, ни счётчика,
                # ни формы входа» -> blind, а не как nav-failed.
                first = {}
        if declared is None:
            m = re.search(r'"all"\s*:\s*"?(\d+)"?', payload)
            declared = int(m.group(1)) if m else None
        got = set(re.findall(r"/vacancy/(\d+)", payload))
        if not got:
            # Пустая страница ЗА пределами списка — законный конец. Пустая ПЕРВАЯ — это слепота.
            complete = page > 0
            break
        before = len(ids)
        ids |= got
        if len(ids) == before:
            # Страница не добавила ничего нового: hh отдала ту же страницу (за концом пагинации
            # она повторяет последнюю). Это конец списка, а не бесконечная лента.
            complete = True
            break
        if declared is not None and len(ids) >= declared:
            complete = True
            break
    if declared is not None:
        complete = complete and len(ids) >= declared
    return HHRead(ids, complete, hh_read_reason(first, ids, declared, complete), declared)


ARCHIVE_MARKS = ("В архиве с", "Вакансия в архиве", "The vacancy is archived",
                 "no longer accepting applications")


def is_archived(text):
    """hh renders the archive banner in the page language, and this session reads English while
    the vacancy body stays Russian — so both alphabets are checked. Substring, not a data-qa:
    the banner's qa attribute is not stable across hh's A/B renders, the words are."""
    return any(m in text for m in ARCHIVE_MARKS)



ANSWERS = "mesh-job-answers"


def answerable(q):
    """Is this scraped form question something we may ask the анкета about at all?

    An unlabelled textarea scrapes as "" and an empty question has no answer — but it used to be
    ASKED anyway, and `mesh-job-answers --match ""` answered with its own usage block on stdout at
    rc 0, which is exactly the (rc == 0 and non-empty) shape the caller types into the employer's
    field. Four откликов were submitted under the operator's name carrying that text on 2026-08-26.
    Kept as one named predicate so the gate the caller uses is the gate the test drives."""
    return bool((q or "").strip())

# ---------------------------------------------------------------- ПОЧЕМУ нужен человек
# `needs-human` помнил, ЧТО человек нужен, и не помнил ЗАЧЕМ: девять строк лежали в нём с
# причиной только в прозе примечания, поэтому спросить «причина уже снята?» было НЕЧЕМ, и строка
# не была пере-открываема ни тулом, ни человеком. Седьмая колонка доски несёт МАШИННЫЙ токен
# рядом со статусом.
#
# Токен чеканится ТАМ, ГДЕ СЛУЧИЛСЯ ОТКАЗ, и не выводится задним числом из напечатанной прозы —
# ровно один вход, `nh()`, через который проходит каждый выход в needs-human. Поэтому пере-
# открыватель и разбор старых строк читают ОДНУ грамматику: разойтись им не на чем.
#
# Каждый токен — это ИМЯ ТОГО, КТО ЕГО СНИМЕТ. Токен, который нечем снять, — это тупик под другим
# именем, а `unknown` намеренно ГРОМКИЙ: не совпало ничего, и молча стать `retry` он не может.
# КОМУ ПРИНАДЛЕЖИТ ПРИЧИНА (оператор, 2026-08-25 и повторно 2026-08-28). Три токена ниже —
# questions, profile, letter — были СФОРМУЛИРОВАНЫ как «снимает ОН»: анкету ждали от него, правку
# аккаунта от него, абзацы письма от него. Оператор этот возврат отменил дважды, второй раз
# дословно: «у вас есть всё, чтобы доводить до интервью самим» и «все needs-human можете смело
# заполнять за меня, включая тесты». Значит правится не только доска, но и ТЕКСТ причины: строка
# «потому что нужен человек» по этим трём больше не пишется. Формулировка причины — это адрес
# работы; пока она указывала на оператора, работа не была ничьей и строка старела на доске.
# Остаётся ровно один токен, который действительно ждёт человека, — captcha: её снимает тот, кто
# её прошёл, и ни один сайт в этом лейне её пока не чеканил.
R_QUESTIONS = "questions"   # снимаем МЫ, наполняя банк ответов (mesh-job-answers) под эту форму
R_RETRY     = "retry"       # снимет: ВРЕМЯ. переходный сбой клика/сверки, с потолком попыток
R_PROFILE   = "profile"     # снимаем МЫ, правкой видимости резюме в его аккаунте hh (см. ниже)
R_CAPTCHA   = "captcha"     # снимет: человек, прошедший проверку. ни один сайт пока его не чеканит
R_FORM      = "form"        # снимет: КОД. hh показал форму, которую этот тул не умеет вести
R_LETTER    = "letter"      # снимаем МЫ, дописав его собственный абзац в letter-blocks.md
R_UNKNOWN   = "unknown"     # не совпало ничего. громко по замыслу — молчаливым retry не станет
REASONS = (R_QUESTIONS, R_RETRY, R_PROFILE, R_CAPTCHA, R_FORM, R_LETTER, R_UNKNOWN)

REASON_PATTERNS = (
    (R_QUESTIONS, r"зада[её]т свои вопросы|вопрос\w* работодател"),
    (R_PROFILE,   r"видимост\w* резюме"),
    (R_CAPTCHA,   r"капч|captcha"),
    (R_LETTER,    r"письмо не собралось|нет блоков"),
    (R_FORM,      r"незнакомая разновидность формы|кнопка отправки .*заблокирован"),
    (R_RETRY,     r"клик прош[её]л|кнопки отклика нет|не приняло текст|"
                  r"не смог прочитать длину|письмо не попало в поле"),
)


def reason_of(detail):
    """Проза отказа -> токен. Единственная решающая грамматика в этом файле."""
    for tok, pat in REASON_PATTERNS:
        if re.search(pat, detail or "", re.I):
            return tok
    return R_UNKNOWN


def nh(detail):
    """Единственный выход в needs-human. -> (state, detail, reason).

    Существует именно ради того, чтобы у причины не появилось двух парсеров: живой путь и разбор
    старых строк вызывают одну функцию. Новый текст отказа, не попавший ни в один шаблон, выйдет
    отсюда как `unknown` — и это видно на доске, а не растворяется в `retry`."""
    return "needs-human", detail, reason_of(detail)


QUESTION_OPENER = re.compile(r"^(укажите|расскажите|опишите|есть ли|готовы ли|"
                             r"сколько|какой|какая|какие|почему|назовите|"
                             r"please|do you|are you|how many|what|why|describe)", re.I)


# ЗАКРЫВАЮЩАЯ ПУНКТУАЦИЯ ПОСЛЕ ЗНАКА ВОПРОСА. Работодатель 136467936 кончил вопрос кавычкой —
# «…Какое соотношение этих языков было на последнем месте?»` — и `endswith('?')` его не увидел:
# строка была невидима ОБЕИМ рукам разом, и в анкету он тоже не попадал. Направление отказа этого
# предиката выбрано в самом файле («лишний вопрос в анкете стоит одной строки, пропущенный —
# целого отклика»), так что здесь он расширяется, а не сужается.
QUESTION_TAIL = "»\"'’”)]›"


def looks_question(t):
    """Does this line ASK something? One predicate, so the gate tests the parser's own grammar
    and not a re-typed copy of it. [[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]"""
    t = " ".join((t or "").split())
    return bool(t.rstrip(QUESTION_TAIL).endswith("?") or QUESTION_OPENER.match(t))


def harvest_questions(vid, employer=""):
    """Снять вопросы работодателя со страницы /applicant/vacancy_response в очередь анкеты.

    -> число поставленных в очередь (0 = не смогли прочитать; тогда строка ведёт себя как раньше).

    ЧЕСТНАЯ ГРАНИЦА: hh не даёт стабильного data-qa под пользовательские вопросы, поэтому берётся
    ТЕКСТ формы, а не селектор поля, и сырой дамп кладётся рядом (`questions-raw/<vid>.txt`) —
    неверный фильтр тогда чинится по артефакту, а не переоткрытием страницы. Фильтр намеренно
    жадный к '?' и к строкам-меткам: лишний вопрос в анкете стоит одной строки, пропущенный стоит
    целого отклика."""
    # `document.querySelector('form')` — ПЕРВАЯ форма документа, а первая форма на любой странице
    # hh — это поисковая строка в шапке. Её innerText — слово «Search», ровно 6 байт, и именно это
    # лежало в questions-raw/*.txt под каждым vid с тех пор, как эта функция написана: снятие
    # вопросов не отработало НИ РАЗУ, а причина `questions` была неснимаемой не по замыслу, а
    # потому что тул смотрел в другую форму. Берётся форма с НАИБОЛЬШИМ текстом (анкета — самый
    # длинный блок на этой странице), а если ни одна не набирает порога — тело документа.
    mark = log_size()
    drive(["--send", "js () => { const fs = Array.from(document.querySelectorAll('form'));"
                     " let f = fs.sort((a, b) => (b.innerText||'').length - (a.innerText||'').length)[0];"
                     " if (!f || (f.innerText||'').length < 60) f = document.body;"
                     " return JSON.stringify({t: f.innerText.slice(0, 4000),"
                     " forms: fs.map(x => (x.innerText||'').length)}); }"])
    if not wait_log(mark, "[js] ", 60):
        return 0
    lines = [l for l in log_since(mark).splitlines() if l.startswith("[js] ")]
    if not lines:
        return 0
    try:
        raw = json.loads(lines[-1][len("[js] "):].strip()).get("t", "")
    except Exception:
        return 0
    if not raw.strip():
        return 0
    d = pathlib.Path.home() / ".mesh/job/questions-raw"
    d.mkdir(parents=True, exist_ok=True)
    (d / ("%s.txt" % vid)).write_text(raw, encoding="utf-8")
    seen, n = set(), 0
    for ln in raw.splitlines():
        t = " ".join(ln.split())
        if not (8 <= len(t) <= 300) or t in seen:
            continue
        looks_q = looks_question(t)
        # МЕТА-СТРОКА, А НЕ ВОПРОС. Фильтр жадный к '?', и работодательские шапки вида «Просим
        # ответить на следующие вопросы?» проходят его, потому что кончаются знаком вопроса. Такая
        # строка попадает в анкету, банк никогда её не покрывает, и ОДНА шапка держит строку доски
        # в needs-human навсегда — при том, что в самой форме поля под неё нет (замер 2026-08-28:
        # ровно это держало МТС 135307229, у которого все ЧЕТЫРЕ настоящих вопроса покрыты).
        # Предикат УЗКИЙ и сформулирован по признаку «строка ГОВОРИТ О вопросах, а не задаёт их»:
        # его направление отказа — оставить вопрос, а не потерять его.
        if META_LINE.search(t):
            continue
        if not looks_q:
            continue
        seen.add(t)
        r = subprocess.run([ANSWERS, "--queue", t, "--origin", "hh:%s" % vid],
                           capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            n += 1
    return n

# Строка, которая ГОВОРИТ О вопросах, а не задаёт их. Ровно один экземпляр на весь файл: живой
# путь и гейт обязаны спрашивать ОДИН предикат, иначе гейт проверяет не ту грамматику, что парсер.
# «ответьте, пожалуйста, на пару вопросов» — вежливость встаёт МЕЖДУ глаголом и предлогом, и
# первая версия предиката её не пропускала. Допуск ограничен 20 символами без знака конца
# предложения: он растягивает ОДНУ фразу, а не сшивает две.
META_LINE = re.compile(r"ответ(ить|ьте|ь)[^?!.]{0,20}на\s+(следующ|эти|данн|нескольк|пар[уы]|вопрос)", re.I)

# ДВЕ РУКИ ЧИТАЛИ ОДНУ ФОРМУ РАЗНОЙ ГРАММАТИКОЙ, И ИМЕННО ЭТО ДЕРЖАЛО ЛЕЙН.
# `harvest_questions` режет текст формы ПОСТРОЧНО и кладёт в анкету чистые одиночные вопросы —
# в questions.tsv они именно такие, и банк на них отвечает (замер 2026-08-29, три вопроса МТС
# 135307229 дословно из его же очереди: rc=0 на каждом). А отвечающая рука поднималась от каждой
# textarea вверх по родителям и брала innerText первого, что длиннее 15 символов. На живой форме
# hh это РАЗНЫЕ вопросы к одному тексту, и мерить надо было DOM, а не догадываться:
#
#   textarea[name=task_381436400_text]
#     k=0 [data-qa=textarea-native-wrapper]  "Type here"   (9)
#     k=1 div                                "Type here"   (9)
#     k=2 div                                "Type here"   (9)
#     k=3 [data-qa=textarea-wrapper]         "Type here"   (9)
#     k=4 [data-qa=task-body]                "Что рассматриваете в окладе в месяц?\nType here"  (46)
#
# Подъём кончался на i<4, то есть на k=3, ровно ОДНИМ уровнем НЕ ДОЙДЯ до контейнера с вопросом:
# все три поля читались как '', `answerable('')` их отбрасывал, и строка уходила в needs-human с
# причиной «банк покрыл не все» — при том, что банк покрывал ВСЕ. МТС пере-открывался и падал
# обратно шесть раз за четыре дня по этому кругу. У поля 401 (свой вариант рядом с радиогруппой)
# вся цепочка вообще несёт U+200B — метки в предках нет ни на каком уровне, так что «поднять
# лимит с 4 до 5» чинит один случай из двух и вводит второй, худший: на уровень выше task-body
# лежит ВСЯ форма, то есть все вопросы разом. Прогон такого куска через банк: rc=0 и ответ НЕ ТОТ
# — на блоб из трёх вопросов МТС приходит work-format, потому что выигрывает первый совпавший
# паттерн, и он лёг бы в поле про оклад. Ровно класс аварии 26.08.
#
# Поэтому пара «вопрос — поле» берётся не из догадки о глубине, а из СОБСТВЕННОЙ РАЗМЕТКИ hh:
# `[data-qa=task-body]` — контейнер ОДНОГО вопроса работодателя вместе с его же полями (замерено
# на 135307229: 3 поля / 3 контейнера, и на 136467936: 5 / 5). Поле адресуется своим `name`
# (`task_<id>_text`), а не порядковым номером: `:nth-match(textarea,i)` считал ВСЕ textarea
# страницы, тогда как i приходил из УЖЕ ОТФИЛЬТРОВАННОГО (без письма) списка — сегодня это
# совпадает только потому, что поле письма появляется позже, после клика «Add».
# ОТКАЗ, КОТОРЫЙ БАНК НЕ СНИМЕТ НИКОГДА. Форма, которую эта рука не читает однозначно, — это
# работа КОДА (токен `form`, «снимет: КОД», с потолком попыток и гейтом по mtime самого файла), а
# не пробел в банке ответов. Пометив такую строку как `questions`, мы бы отдали её пере-открывателю,
# который судит по покрытию банка: он видит снятые построчно чистые вопросы, объявляет их
# покрытыми, открывает строку, и она падает обратно тем же местом — ровно тот круг, в котором МТС
# 135307229 провёл шесть заходов за четыре дня. Ровно один литерал на файл: разъехавшись, живой
# путь и классификатор перестали бы называть одно и то же.
FORM_UNREADABLE = "форму вопросов не прочитать однозначно"

TASK_QA = "task-body"
TASK_JS = ("() => JSON.stringify(Array.from(document.querySelectorAll('[data-qa=%s]'))"
           ".map(b => ({t: (b.innerText||'').trim().slice(0, 1200),"
           " ta: Array.from(b.querySelectorAll('textarea'))"
           ".filter(e => !(e.getAttribute('data-qa')||'').includes('letter'))"
           ".map(e => e.getAttribute('name')).filter(Boolean),"
           " own: Array.from(b.querySelectorAll('input[type=radio]'))"
           ".filter(r => r.getAttribute('value') === 'open')"
           ".map(r => r.getAttribute('name')).filter(Boolean),"
           " rad: b.querySelectorAll('input[type=radio]').length})))" % TASK_QA)


def single_question(t):
    """Does this line ask exactly ONE thing? -> bool.

    Отдельный предикат рядом с `looks_question`, потому что вопросов у строки может быть больше
    одного, а ответ у банка ровно один: `mesh-job-answers --match` отдаёт ПЕРВЫЙ совпавший
    паттерн, так что на «Был ли опыт на обоих языках? Какое соотношение?» (136467936, дословно)
    он ответит про один из них и промолчит про второй — и это будет напечатано в поле под его
    именем. Отказ здесь стоит одной строки в анкете; согласие стоит половинчатого ответа
    работодателю. Ноль знаков вопроса допустим: `looks_question` намеренно берёт и повелительные
    формы («Укажите ожидания по доходу»), у которых '?' нет вовсе."""
    return (t or "").count("?") <= 1


def block_question(text):
    """ЧИСТАЯ. Текст ОДНОГО контейнера hh -> (вопрос|None, почему-нет).

    Грамматика здесь ТА ЖЕ, что у `harvest_questions`: те же `looks_question` и `META_LINE`, те же
    границы длины. Это и есть починка — раньше сборщик анкеты и отвечающая рука спрашивали у одной
    страницы разное, и ответ приходил на вопрос, которого в поле не было."""
    qs = []
    for ln in (text or "").splitlines():
        t = " ".join(ln.split())
        if not (8 <= len(t) <= 300):
            continue
        if META_LINE.search(t) or not looks_question(t):
            continue
        if t not in qs:
            qs.append(t)
    if not qs:
        return None, "в блоке формы не нашлось вопроса"
    if len(qs) > 1:
        # Работодатель написал два вопроса в одно поле (136467936, блок 0). Банк ответит на один.
        return None, "в одном поле %d вопроса — банк отвечает на один" % len(qs)
    if not single_question(qs[0]):
        return None, "в одной строке больше одного вопроса — банк отвечает на первый"
    return qs[0], ""


NO_TEST_QA = "vacancy-response-link-no-questions"


