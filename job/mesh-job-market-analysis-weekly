#!/usr/bin/env bash
# Weekly observation point for the same reproducible generator.
# reflex-cadence: 29 5 * * 1
# reflex-state: $HOME/.mesh/job/market-analysis/runs.tsv
# max-runtime: 120
set -eu
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
[ "${1:-}" = "--test" ] && exec "$here/mesh-job-market-analysis" --test
exec "$here/mesh-job-market-analysis" --weekly "$@"
