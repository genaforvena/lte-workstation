# без него разъехавшийся селектор (hh переименовала data-qa) молчал бы вечно, а это ДЕФЕКТ
# ЭТОГО кода, а не стена.
NEG_JS = ('JSON.stringify({items:Array.from(document.querySelectorAll("[data-qa=negotiations-item], '
          '[data-qa^=negotiations-item]")).map(e=>({t:e.innerText.split("\\n").map(s=>s.trim())'
          '.filter(Boolean),h:(e.querySelector("a[href*=vacancy]")||{}).getAttribute'
          '&&e.querySelector("a[href*=vacancy]").getAttribute("href")})),'
          'login:!!document.querySelector("[data-qa=account-login-form],[data-qa=applicant-login-card]"),'
          'all:((document.body.innerText||"").match(/\\b(?:All|Все)\\s+(\\d+)/)||[])[1]||null,'
          'url:location.href})')

CHATS_JS = ('Array.from(document.querySelectorAll("[data-qa^=chatik-open-chat-]")).map('
            'e=>e.getAttribute("data-qa").replace("chatik-open-chat-","")+"|"+'
            'e.innerText.replace(/\\s+/g," ").slice(0,150)).join(" ;; ")')


# ОТКРЫЛСЯ ЛИ ТРЕД И ЕСТЬ ЛИ КУДА ПИСАТЬ — ОДИН ЗАПРОС, ТРИ ФАКТА, ТРИ РАЗНЫХ СЛОВА.
# Замерено 2026-08-29 на ЕДИНСТВЕННОМ живом приглашении лейна — Сбер.IT «Team lead golang
# (GigaChat)», чат 5586545131. Там ДВА независимых отказа сразу: hh уводит прямую ссылку
# /chat/<id> обратно на список откликов (location.href = .../applicant/negotiations), а в самом
# треде НЕТ поля ввода — работодатель отвечает только через своего AI-рекрутера. Поэтому settext
# не нашёл textarea, кнопка отправки в DOM не появилась (её там нет, пока поле пусто), и обе
# половины пути молча свалились в ОДНУ строку «клик прошёл, но тред не подтвердил отправку» —
# предложение на слой дальше правды: клик не проходил, а писать было НЕКУДА. Хуже того, при
# уводе на список откликов blockers_in() читает хвост ЧУЖОЙ страницы, то есть стоп-темы могут
# сработать по тексту соседнего работодателя.
#
# Отдельно: пустой тред — это НЕ «нет поля ввода». Первый — «мы на месте, но говорить не с чем»,
# второй — «нам закрыли рот». Их лечат разные руки, поэтому и слова разные.
# Селектор поля ввода — ОДНА КОНСТАНТА, которую и спрашивает страница, и чинит правка hh. Старое
# имя оставлено первым в списке, чтобы откат переименования hh не требовал редактирования.
COMPOSER_SEL = ("textarea[data-qa=chatik-new-message-text],textarea[data-qa=text-input]")
# Имена полей объявлены ОДИН раз и подставляются И в запрос, И в читателя ниже: пока грамматику
# знают два места, запрос может перестать спрашивать то, что читатель спрашивает, и тогда КАЖДЫЙ
# чат прочитается как «рот закрыт» — отказ в сторону тишины, ровно тот, что этот файл ловит в
# пяти других местах.
K_URL, K_COMPOSER, K_TEXT = "url", "composer", "text"
THREAD_JS = ('JSON.stringify({%s:location.href,'
             '%s:!!document.querySelector("%s"),'
             'bubbles:document.querySelectorAll("[data-qa=chat-bubble-wrapper]").length,'
             '%s:(document.body.innerText||"").replace(/\\s+/g," ").slice(-2500)})'
             % (K_URL, K_COMPOSER, COMPOSER_SEL, K_TEXT))


def thread_state(cid):
    """Что на самом деле открылось по прямой ссылке на чат <cid>.

    Возвращает (state, payload). state — одно из:
      ok            — мы В ЭТОМ чате и есть поле ввода
      not-open      — hh увёл со ссылки (обычно на список откликов): читать хвост НЕЛЬЗЯ,
                      он принадлежит другой странице
      no-composer   — чат открыт, но поля ввода нет: работодатель отключил ответы
      unreadable    — js не ответил вовсе (драйвер/страница)"""
    raw = js(THREAD_JS)
    if not raw:
        return "unreadable", {}
    try:
        d = json.loads(raw)
    except ValueError:
        return "unreadable", {}
    if ("/chat/" + str(cid)) not in (d.get(K_URL) or ""):
        return "not-open", d
    if not d.get(K_COMPOSER):
        return "no-composer", d
    return "ok", d


def ensure_driver():
    """Bring the browser daemon UP; a cron reflex may not assume someone else left it running.

    The daemon exits after 45 min of idle BY DESIGN and this reflex fires every two hours, so on
    nearly every tick it wakes into a dead browser. Measured 2026-08-26: 10 of 10 runs in
    ~/.mesh/job-reply.log read «драйвер hh не отвечает» and answered nobody, while mesh-job-track
    and mesh-job-apply — which do start it — worked all along against the same login. The lane's
    ONE tool that speaks to an employer was the one tool that never woke its own transport, and
    the failure was silent because it looked exactly like hh being unreachable."""
    if drive(["--alive"]).returncode != 0:
        drive(["--start"], timeout=180)


# Why a read failed, for the caller to print. THREE different failures — a daemon that would not
# start, a navigation that never arrived, a page that answered something other than the list — used
# to share one sentence, and six days of a never-started daemon were indistinguishable from hh being
# down. A collapsed reason makes blind and quiet identical.
LAST_FAIL = ""


NEG_URL = "https://hh.ru/applicant/negotiations"
# hh paginates отклики at 20 per page, and page 1 is the ONLY thing this lane ever read. An
# приглашение on an older отклик was therefore invisible FOREVER, and every batch of new откликов
# pushes more history off the one page we look at — the blindness grows with the lane's own
# throughput. Bounded so a page parameter hh decides to ignore cannot spin here.
MAX_PAGES = int(node_env("MESH_JOB_REPLY_PAGES", "8"))


# ЧТЕНИЕ СПИСКА ОТКЛИКОВ — ЭТО НЕ ОДИН БИТ. Пока read_page отдавал (rows, err), НУЛЬ УЗЛОВ был
# успехом: на форме входа селектор [data-qa=negotiations-item] честно даёт ноль элементов, js
# возвращает валидный ответ, read_page отдаёт ([], "") = «прочитано, пусто», invited() делает
# `if not page: break` и возвращает [] = «приглашений нет». Замерено 2026-08-29 (senses,
# {#0c3f1982}): `mesh-job-reply --dry --json` -> answered=[] skipped=[] на РАЗЛОГИНЕННОЙ сессии,
# то есть уверенный успех там, где не было прочитано вообще ничего. Ветка ошибки существовала
# (None + LAST_FAIL), но пустая нулевая страница в неё не попадала — направление отказа было
# ТИШИНА, ровно то, что запрещено в пяти других местах этого лейна.
#
# Словарь взят из mesh-job-apply (c7b59a6b) СЛОВО В СЛОВО, чтобы два инструмента одного лейна
# не называли один и тот же мир по-разному:
#   ok             — элементы есть, список прочитан
#   logged-out     — на странице форма входа: чинится ЧЕЛОВЕКОМ (вход в браузере), не этим кодом (n/a)
#   empty          — hh своим же числом говорит 0 откликов: список честно пуст
#   selector-drift — hh считает N>0, а элементов ноль -> ДЕФЕКТ ПАРСЕРА (красный, НЕ n/a)
#   blind          — страница ответила, но ни элементов, ни счётчика, ни формы входа (стена) (n/a)
#   nav-failed     — навигация/js не ответили вовсе: драйвер или аплинк (n/a)
# Порядок в hh_read_reason() значим: положительный ответ (есть элементы) бьёт всё остальное,
# иначе один залётный логин-виджет объявил бы слепым прогон, который список ПРОЧИТАЛ.
PageRead = collections.namedtuple("PageRead", "rows err reason declared")


def hh_read_reason(first, items, declared):
    """Чистая функция: по разобранной ПЕРВОЙ странице (dict от js, либо None) -> слово причины.

    Вынесена без браузера именно затем, чтобы --test гонял её мутациями, а не ловил один живой
    мир, который сегодня случился."""
    if first is None:
        return "nav-failed"
    if items:
        return "ok"
    if first.get("login"):
        return "logged-out"
    if declared == 0:
        return "empty"
    if declared:
        return "selector-drift"
    return "blind"


# Что читатель обязан сделать с каждым словом. n/a — это НЕ «всё хорошо»: это «здесь нечего
# утверждать», и оно обязано назвать, чья рука чинит. selector-drift и partial сюда НЕ ПОПАДАЮТ:
# это дефекты нашего кода, и они обязаны быть красными, а не тихими.
HH_READ_NA = {
    "nav-failed": "драйвер/аплинк: страница откликов или js не ответили — см. `mesh-hh-drive --peek`",
    "logged-out": "СЕССИЯ РАЗЛОГИНЕНА: hh отдала форму входа ([data-qa=account-login-form])."
                  " Это чинится входом в браузере (`mesh-hh-drive --shot login`), а не этим кодом",
    "blind":      "стена/неизвестный рендер: ни откликов, ни счётчика hh, ни формы входа"
                  " — см. `mesh-hh-drive --peek`",
}

# Дефект ЭТОГО кода: молчать про него нельзя, но и «приглашений нет» отвечать нельзя тем более.
HH_READ_DEFECT = {
    "selector-drift": "ДЕФЕКТ ПАРСЕРА: hh своим числом говорит, что отклики есть, а"
                      " [data-qa=negotiations-item] даёт ноль узлов — селектор разъехался",
}


def hh_live_arms(read):
    """Что --test ИМЕЕТ ПРАВО утверждать про живое чтение. -> (na_reason|None, [(label, ok)...]).

    Вынесено отдельной функцией ровно затем, чтобы ПОРЯДОК («сначала причина, потом утверждение»)
    гонялся мутацией, а не глазами. С n/a-причиной список арм ПУСТ. Не «зелёный» — пустой:
    утверждать нечего, и это разные вещи."""
    if read.reason in HH_READ_NA:
        return read.reason, []
    return None, [("список откликов hh ПРОЧИТАН (не пустой успех на форме входа): read=%s"
                   % read.reason, read.reason in ("ok", "empty"))]


def read_page(n):
    """One page of hh's negotiations -> PageRead. rows None means UNREAD; reason names WHICH world.

    rows == [] is no longer an answer on its own: см. блок над hh_read_reason — пустая страница
    означала сразу четыре разных мира, и три из них были не «приглашений нет»."""
    url = NEG_URL if n == 0 else (NEG_URL + "?page=%d" % n)
    if drive(["--goto", url], timeout=180).returncode != 0:
        return PageRead(None, "драйвер не дошёл до страницы откликов (стр. %d)" % n, "nav-failed", None)
    payload = js(NEG_JS)
    first = None
    if payload:
        try:
            first = json.loads(payload[len("[js] "):] if payload.startswith("[js] ") else payload)
        except Exception:
            first = None
    if not isinstance(first, dict):
        # Полезная нагрузка есть, но это не наш объект — это НЕ «страница ответила пустым списком».
        return PageRead(None, ("страница %d ответила не списком откликов (браузер занят другим"
                               " писателем?): %s" % (n, (payload or "пусто")[:80])), "nav-failed", None)
    declared = first.get("all")
    try:
        declared = int(declared) if declared is not None else None
    except (TypeError, ValueError):
        declared = None
    out = []
    for it in (first.get("items") or []):
        t = [x for x in (it.get("t") or []) if x]
        if len(t) < 3 or not it.get("h"):
            continue
        m = re.search(r"/vacancy/(\d+)", it["h"])
        if not m:
            continue
        out.append({"vacancy_id": m.group(1), "status": t[0].strip().lower(),
                    "title": t[1], "employer": t[2]})
    # СЛОВАРЬ ПРИЧИН РЕШАЕТ ТОЛЬКО ПЕРВУЮ СТРАНИЦУ. На ДАЛЬНЕЙ странице ноль элементов — это
    # нормальный конец списка, а счётчик «Все N» hh рисует на каждой странице, так что наивный
    # перенос объявил бы КОНЕЦ ПАГИНАЦИИ дефектом парсера на каждом втором прогоне: слово, ставшее
    # красным всегда, перестают читать.
    if n:
        return PageRead(out, "", "ok" if out else "end-of-list", declared)
    reason = hh_read_reason(first, out, declared)
    err = HH_READ_NA.get(reason, "") or HH_READ_DEFECT.get(reason, "")
    return PageRead(out, err, reason, declared)


# Слово, которым кончилось последнее чтение списка. Отдельно от LAST_FAIL: LAST_FAIL — это
# ФРАЗА для человека, а LAST_REASON — КЛАСС, по которому судит --test и который едет в лог.
LAST_REASON = ""


def invited():
    """-> [{vacancy_id, title, employer}] for negotiations hh marks as приглашение, ALL pages.

    None is "could not read" and is NOT "no invitations"; the why lands in LAST_FAIL/LAST_REASON.
    И ПУСТАЯ ПЕРВАЯ СТРАНИЦА ТОЖЕ МОЖЕТ БЫТЬ None: форма входа отдаёт ноль узлов и валидный
    ответ, и до 2026-08-29 это возвращалось как «приглашений нет»."""
    global LAST_FAIL, LAST_REASON
    LAST_REASON = ""
    ensure_driver()
    if drive(["--alive"]).returncode != 0:
        LAST_FAIL = "браузерный драйвер не поднялся (mesh-hh-drive --start)"
        LAST_REASON = "nav-failed"
        return None
    rows, seen_ids, prev_first = [], set(), None
    for n in range(MAX_PAGES):
        pr = read_page(n)
        page, err = pr.rows, pr.err
        if n == 0:
            LAST_REASON = pr.reason
            # ЧЕТЫРЕ МИРА, ТРИ ИЗ КОТОРЫХ НЕ «ПРИГЛАШЕНИЙ НЕТ». n/a (разлогинены / стена /
            # драйвер) и дефект парсера одинаково НЕ ИМЕЮТ ПРАВА доехать до вызывающего как
            # пустой список: пустой список тут — утверждение о мире, а мы его не измерили.
            if pr.reason in HH_READ_NA or pr.reason in HH_READ_DEFECT:
                LAST_FAIL = err or pr.reason
                return None
        if page is None:
            if n == 0:
                LAST_FAIL = err
                return None
            # A later page that will not read is a COVERAGE hole, not an empty result: answer what
            # we did read and say how far we got, never silently render the rest as "no invitations".
            LAST_FAIL = err
            LAST_REASON = "partial"
            break
        if not page:
            break
        # A `?page=` hh chooses to IGNORE hands back page 1 again, and a loop that trusts the
        # parameter would then read the same twenty rows MAX_PAGES times and call it full coverage —
        # the pagination equivalent of a silent fallback. Stop on a repeated head.
        first = page[0]["vacancy_id"]
        if n and first == prev_first:
            break
        prev_first = first
        fresh = 0
        for r in page:
            if r["vacancy_id"] in seen_ids:
                continue
            seen_ids.add(r["vacancy_id"])
            fresh += 1
            if r["status"] in ("interview", "приглашение"):
                rows.append({k: r[k] for k in ("vacancy_id", "title", "employer")})
        if not fresh:
            break
    return rows


SCROLL_JS = ('(function(){var l=document.querySelectorAll("[data-qa^=chatik-open-chat-]");'
             'if(!l.length)return "0";var c=l[0].parentElement;'
             'while(c&&c.scrollHeight<=c.clientHeight)c=c.parentElement;'
             'if(c)c.scrollTop=c.scrollHeight;return ""+l.length;})()')

CHAT_SCROLLS = int(node_env("MESH_JOB_REPLY_CHAT_SCROLLS", "12"))


def chat_id_for(employer, title):
    """The chat list is VIRTUALISED — it renders about eleven rows whatever its true length, and
    the rest do not exist in the DOM until something scrolls them into view. A single read of
    `[data-qa^=chatik-open-chat-]` therefore answers about the newest eleven conversations and
    returns None for every older one, which the caller records as «чат не найден в списке» — a
    sentence that reads like hh having no such chat. Seen live 2026-08-26 in
    job-apply-widened-2026-08-26.log ("отклик подан по ссылке, но письмо в чат НЕ ушло: чат по
    этой вакансии не найден в списке") and again by hand: the Future Focus chat needed one scroll
    pass to appear at all.

    Scrolling must be its OWN driver command per pass — the list re-renders asynchronously, so a
    JS loop that scrolls and re-queries inside one expression sees the same eleven rows every
    iteration (measured: such a loop returned "notfound" while a stepped one found it on pass 1)."""
    # And it must be ON the chat page: invited() leaves the browser on the negotiations list, where
    # no [data-qa^=chatik-open-chat-] node exists at all, so a lookup made from there answers None
    # for EVERY chat — indistinguishable from the chat being absent.
    if drive(["--goto", "https://hh.ru/chat"], timeout=180).returncode != 0:
        return None
    time.sleep(5)
    seen_len = -1
    for _ in range(CHAT_SCROLLS):
        payload = js(CHATS_JS)
        if payload:
            for cell in payload.split(" ;; "):
                cid, _, txt = cell.partition("|")
                if employer[:18].lower() in txt.lower() and title[:22].lower() in txt.lower():
                    return cid.strip()
        grew = js(SCROLL_JS)
        try:
            n = int((grew or "0").strip())
        except ValueError:
            n = -1
        # The window stays ~11 rows wide, so its LENGTH cannot say whether more loaded; a list that
        # has hit its end simply stops handing back new ids, which the loop above notices by not
        # matching. Only a hard failure to render anything ends the walk early.
        if n == 0 and seen_len == 0:
            break
        seen_len = n
    return None


