    check("НОВАЯ причина по той же вакансии — это новость, и она уходит сразу",
          _m3 == 0 and any("свободных слотов нет" in x for x in _p3))
    _p4, _m4 = tg_parts([(_r, "текст письма", "sent")], [(_r, "свободных слотов нет")], dict(_st))
    check("отправленный ответ не дедупится НИКОГДА (молчать про ушедшее письмо нельзя)",
          any(x.startswith("✅") for x in _p4))
    check("подавление НЕ считается поводом писать оператору (только оно -> тишина)",
          not [x for x in _p2 if not x.startswith(MUTED_LEAD)])

    # ── ФИКСТУРА РАЗЛОГИНЕННОГО DOM, ГОНЯЕМАЯ ЧЕРЕЗ ВЕСЬ ИНСТРУМЕНТ ────────────────────────────
    # Чистых функций мало: дефект был не в классификаторе (его не было), а в ПУТИ — read_page
    # отдавал ([], ""), invited() делал `if not page: break`. Поэтому фикстура подаётся туда, куда
    # придёт живая страница: в stdout драйвера. Три арма с РАЗНЫМИ DOM, так что инструмент,
    # который всегда говорит n/a, падает на контрольном, а вчерашний — на разлогиненном.
    # (Мутанты, увиденные красными: `logged-out` -> `empty` в hh_read_reason; снятие ветки
    # `if pr.reason in HH_READ_NA` в invited(); `login:` убран из NEG_JS.)
    import tempfile as _tf
    # Статус в контрольной фикстуре — «Отклик», а НЕ «Приглашение»: контроль обязан доказать, что
    # чтение СОСТОЯЛОСЬ, и ничего больше. Приглашение утащило бы прогон в chat_id_for/mesh-job-cal,
    # то есть в органы, которых под `env -i` нет, и арм измерял бы их отсутствие.
    _ITEM = ('{"t":["Отклик","Team Lead Go","Ромашка"],"h":"/vacancy/111?query=1"}')
    _DOM = (
        ("logged-out", '{"items":[],"login":true,"all":null,"url":"https://hh.ru/account/login"}',
         True,  "РАЗЛОГИНЕНА"),
        ("selector-drift", '{"items":[],"login":false,"all":"56","url":"https://hh.ru/applicant/negotiations"}',
         True,  "ДЕФЕКТ ПАРСЕРА"),
        ("ok", '{"items":[' + _ITEM + '],"login":false,"all":"1","url":"https://hh.ru/applicant/negotiations"}',
         False, ""),
    )
    for _word, _payload, _want_na, _want_txt in _DOM:
        _h = _tf.mkdtemp(prefix="reply-dom-" + _word + "-")
        os.makedirs(os.path.join(_h, ".local", "bin"), exist_ok=True)
        os.makedirs(os.path.join(_h, ".mesh", "job"), exist_ok=True)
        with open(os.path.join(_h, ".mesh", "nodes"), "w") as _f:
            _f.write("export MESH_JOB_REPLY_PAGES=2\nexport MESH_JOB_REPLY_CHAT_SCROLLS=1\n")
        _stub = os.path.join(_h, ".local", "bin", "mesh-hh-drive")
        with open(_stub, "w") as _f:
            _f.write("#!/bin/sh\n"
                     'case "$1" in\n'
                     "  --alive) exit 0 ;;\n"
                     '  --send) printf \'[js] %s\\n\' >> "$HOME/.mesh/job/hh-drive.log" ;;\n'
                     "esac\nexit 0\n" % _payload)
        os.chmod(_stub, 0o755)
        _p = subprocess.run(["/usr/bin/env", "-i", "HOME=" + _h, "PATH=/usr/bin:/bin",
                             "SHELL=/bin/sh", sys.executable, os.path.abspath(__file__),
                             "--dry", "--json"], capture_output=True, text=True, timeout=180)
        _err, _out = (_p.stderr or ""), (_p.stdout or "")
        if _want_na:
            check("DOM[%s]: инструмент отвечает n/a (rc=2), а НЕ пустым успехом" % _word,
                  _p.returncode == 2 and "n/a" in _err,
                  "rc=%s out=%s err=%s" % (_p.returncode, _out.replace("\n", " ")[:60],
                                           _err.strip()[:80]))
            check("...и называет ИМЕННО этот мир словом read=%s" % _word,
                  ("read=" + _word) in _err and _want_txt in _err, _err.strip()[:110])
            check("...и НЕ печатает ни одного отчёта об отвеченных/пропущенных приглашениях",
                  "answered" not in _out and "skipped" not in _out, _out.replace("\n", " ")[:80])
        else:
            # КОНТРОЛЬ. Без него инструмент, который на ЛЮБОЙ странице говорит n/a, прошёл бы
            # оба арма выше — а это ровно тот же дефект зеркально: тишина вместо измерения.
            check("DOM[%s]: залогиненная страница со ЧИТАЕМЫМ списком -> УСПЕХ, не n/a (контроль)"
                  % _word,
                  _p.returncode == 0 and "answered" in _out and "read=" not in _err,
                  "rc=%s out=%s err=%s" % (_p.returncode, _out.replace("\n", " ")[:70],
                                           _err.strip()[:70]))

    st = load()
    check("состояние читается", isinstance(st, dict), "%d записей" % len(st))

    if drive(["--alive"]).returncode != 0:
        print("  n/a  живой драйвер hh не запущен — нечего утверждать против")
        print("mesh-job-reply --test: " + ("n/a" if ok else "FAILED"))
        return 2 if ok else 1
    rows = invited()
    # СНАЧАЛА ПРИЧИНА, ПОТОМ УТВЕРЖДЕНИЕ. Предикат `is not None` правильный, но он не различал
    # МИРЫ: до 2026-08-29 разлогиненная сессия вообще не доходила до него — она приезжала сюда
    # как пустой УСПЕХ и печаталась как «0 приглашений». Теперь причина читается первой, и при
    # n/a-слове список арм ПУСТ: утверждать нечего, и это не то же самое, что «зелено».
    _na, _arms = hh_live_arms(PageRead(rows, LAST_FAIL, LAST_REASON or "nav-failed", None))
    if _na:
        print("  n/a  живое чтение откликов: read=%s — %s" % (_na, HH_READ_NA[_na]))
    for _label, _got in _arms:
        check(_label, _got,
              "ЧТЕНИЕ НЕ УДАЛОСЬ — это НЕ «0 приглашений»" if rows is None
              else "%d приглашений" % len(rows))
    print("mesh-job-reply --test: " + ("ok" if ok else "FAILED"))
    return 0 if ok else 1


MUTED_LEAD = "(без изменений, не повторяю:"


def tg_parts(did, skipped, st):
    """Что уходит оператору в TG, и что НЕ уходит повторно.

    ОДНА ПРИЧИНА — ОДНО УВЕДОМЛЕНИЕ, А НЕ ОДНО НА КАЖДЫЙ ТИК. Рефлекс ходит раз в два часа, и
    приглашение, на которое НЕЛЬЗЯ ответить (у Сбер.IT «Team lead golang (GigaChat)» в треде нет
    поля ввода — там AI-рекрутер), будило оператора двенадцать раз в сутки одной и той же
    строкой. Это тревога, повешенная на ФАКТ, а не на его ИЗМЕНЕНИЕ; починить её человек не
    может, значит повтор не несёт ни бита. Дедуп идёт по (вакансия, ПРИЧИНА) — новая причина по
    той же вакансии это НОВОСТЬ и уходит сразу, а не тонет в подавлении.

    Отправленные ответы не дедупятся НИКОГДА: их всего один на приглашение, и молчание про
    ушедшее под его именем сообщение было бы худшим багом, чем повтор.

    Подавление ВСЕГДА называет себя числом: тишина, о которой не сказано, неотличима от рефлекса,
    который перестал ходить."""
    parts = ["✅ ответил %s (%s):\n%s" % (r["employer"], r["title"], body) for r, body, _ in did]
    muted = 0
    for r, why in skipped:
        vid = r["vacancy_id"]
        if (st.get(vid) or {}).get("told") == why:
            muted += 1
            continue
        st[vid] = {**st.get(vid, {}), "told": why}
        parts.append("⚠️ НЕ ответил %s (%s) — %s" % (r["employer"], r["title"], why))
    if muted:
        parts.append("%s %d)" % (MUTED_LEAD, muted))
    return parts, muted


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry", action="store_true")
    ap.add_argument("--tg", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max", type=int, default=CAP)
    ap.add_argument("--test", action="store_true")
    ap.add_argument("--print-knobs", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    # Internal leg of --test: prints the node knobs AS BOUND AT IMPORT. Binding happens at import,
    # so only a real subprocess under `env -i` can show which value a cron environment actually got.
    if a.print_knobs:
        print("MESH_JOB_REPLY_CAP=%s" % (CAP,))
        print("MESH_JOB_AUTOREPLY=%s" % (node_env("MESH_JOB_AUTOREPLY"),))
        return 0
    if a.test:
        sys.exit(selftest())

    if node_env("MESH_JOB_AUTOREPLY") != "on" and not a.dry:
        print("mesh-job-reply: n/a — не вооружён (MESH_JOB_AUTOREPLY=on в ~/.mesh/nodes)", file=sys.stderr)
        sys.exit(2)

    rows = invited()
    if rows is None:
        print("mesh-job-reply: n/a — read=%s: %s" % (LAST_REASON or "unknown",
              LAST_FAIL or "чтение откликов не удалось"), file=sys.stderr)
        sys.exit(2)

    st = load()
    did, skipped = [], []
    for r in rows[:a.max]:
        vid = r["vacancy_id"]
        if st.get(vid, {}).get("confirmed"):
            continue
        cid = chat_id_for(r["employer"], r["title"])
        if not cid:
            skipped.append((r, "чат не найден в списке"))
            continue
        drive(["--send", "goto https://hh.ru/chat/%s" % cid])
        time.sleep(8)
        tstate, tpayload = thread_state(cid)
        if tstate != "ok":
            why = {"not-open": "чат не открывается по прямой ссылке — hh увёл на %s"
                               % (tpayload.get("url") or "другую страницу"),
                   "no-composer": "в чате НЕТ поля ввода: работодатель отключил ответы "
                                  "(отвечать только по его собственной ссылке из треда)",
                   "unreadable": "тред не ответил на запрос (драйвер/страница)"}[tstate]
            skipped.append((r, why))
            st[vid] = {**st.get(vid, {}), "employer": r["employer"], "title": r["title"],
                       "chat": cid, "blocked": tstate,
                       "seen": time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime())}
            save(st)
            continue
        thread = tpayload.get(K_TEXT) or ""
        tail = thread[-1200:]
        stops = blockers_in(tail)
        extra = ""
        if stops:
            # Банк спрашивается ПО КАЖДОЙ сработавшей теме отдельно, а не одним куском хвоста.
            # Передавая весь хвост, мы отдавали банку строку, в которой его паттерны матчатся
            # по чему угодно, и получали ответ на ПЕРВУЮ подошедшую тему — то есть, возможно,
            # не на ту, из-за которой лана остановилась. Ответ не на заданный вопрос хуже
            # молчания: он выглядит как ответ.
            parts, missing = [], []
            for s in stops:
                a = bank_answer(s)
                (parts.append(a) if a else missing.append(s))
            if missing:
                skipped.append((r, "вопрос(ы) требуют его самого: %s"
                                % ", ".join("«%s»" % m for m in missing)))
                st[vid] = {**st.get(vid, {}), "needs_human": "; ".join(missing),
                           "seen": time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime())}
                continue
            extra = "\n\n".join(parts)
        slots = free_slots_text()
        if not slots:
            skipped.append((r, "свободных слотов нет"))
            continue
        body = compose(slots, extra)
        if a.dry:
            did.append((r, body, "dry"))
            continue
        LETTERS.mkdir(parents=True, exist_ok=True)
        path = LETTERS / ("reply-%s.txt" % vid)
        path.write_text(body, encoding="utf-8")
        # hh RENAMED the composer: measured live 2026-08-29 on chat 5564800285 the box is
        # `textarea[data-qa=text-input]` (placeholder "Message") and the old
        # `chatik-new-message-text` matches NOTHING — so settext filled nothing, and
        # `chatik-do-send-message` is not even in the DOM until the box has text, which is why
        # the click found no button either. Both halves of the send path failed on ONE renamed
        # attribute, and the row said "драйвер"/"страница не список откликов" — a cause one
        # layer away from the truth. The selector LIST keeps the old name so a revert needs no
        # edit; the comma carries no space because settext is shlex-split, not raw-tail.
        drive(["--send", "settext textarea[data-qa=chatik-new-message-text],textarea[data-qa=text-input] %s" % path])
        time.sleep(4)
        drive(["--send", "click [data-qa=chatik-do-send-message]"])
        time.sleep(7)
        # The artifact: our own sentence, read back off the thread. A click is not a message.
        drive(["--send", "goto https://hh.ru/chat/%s" % cid])
        time.sleep(8)
        probe = "Ближайшие свободные окна"
        landed = probe in thread_text()
        st[vid] = {"employer": r["employer"], "title": r["title"], "chat": cid,
                   "sent": time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime()),
                   "slots": slots, "confirmed": landed}
        if landed:
            SENT.mkdir(parents=True, exist_ok=True)
            (SENT / (time.strftime("%Y-%m-%d") + "-hh-chat-%s-slots.txt" % vid)).write_text(body, encoding="utf-8")
            subprocess.run([CAL, "--add", "%s | %s | %s | приглашение, ждём подтверждения | hh-чат %s | | предложено: %s"
                            % (slots.split(",")[0].replace("(МСК)", "").strip().split(" ", 1)[1],
                               r["employer"], r["title"], cid, slots), "--state", "proposed"],
                           capture_output=True, text=True)
            did.append((r, body, "sent"))
        else:
            skipped.append((r, "клик прошёл, но тред не подтвердил отправку"))
        save(st)
    save(st)

    if a.json:
        print(json.dumps({"answered": [{"vacancy": r["vacancy_id"], "employer": r["employer"],
                                        "how": how} for r, _, how in did],
                          "skipped": [{"vacancy": r["vacancy_id"], "employer": r["employer"],
                                       "why": why} for r, why in skipped]}, ensure_ascii=False, indent=1))
    else:
        for r, body, how in did:
            print("%-8s %s — %s" % (how, r["employer"], r["title"]))
        for r, why in skipped:
            print("skip     %s — %s (%s)" % (r["employer"], r["title"], why))

    # ОДНА ПРИЧИНА — ОДНО УВЕДОМЛЕНИЕ, А НЕ ОДНО НА КАЖДЫЙ ТИК. Рефлекс ходит раз в два часа, и
    # приглашение, которое НЕЛЬЗЯ ответить (у Сбер.IT в треде нет поля ввода — там AI-рекрутер),
    # будило оператора двенадцать раз в сутки одной и той же строкой. Это тревога, повешенная на
    # ФАКТ, а не на его ИЗМЕНЕНИЕ: чинить её человек не может, значит повтор не несёт ни бита.
    # Дедуп идёт по (вакансия, ПРИЧИНА): новая причина по той же вакансии — это новость и уходит
    # сразу, а не тонет в подавлении. Отправленные ответы не дедупятся НИКОГДА — их всего один на
    # приглашение, и молчание про ушедшее под его именем сообщение было бы худшим из багов.
    if a.tg:
        parts, muted = tg_parts(did, skipped, st)
        save(st)
        if [x for x in parts if not x.startswith(MUTED_LEAD)]:
            subprocess.run([TG, "[job] приглашения:\n\n" + "\n\n".join(parts)], check=False)
    sys.exit(0)


if __name__ == "__main__":
    main()
