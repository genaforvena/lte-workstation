#!/usr/bin/env bash
# mesh-job-funnel — the job lane's PROGRESS, derived from the board and never hand-maintained.
#
# WHY IT EXISTS (operator task job-lane-own-folder-and-funnel {#62d615cf}, 2026-08-29). The audit of
# 322 operator messages over 14 days (~/.mesh/audit-tg-2026-08-15-29.md) found that the single most
# load-bearing fact of the fortnight — "работа нужна до 5 сентября" — was written in NO file: it lived
# only in the context of the window that heard it, and every /clear erased it. The same shape applies
# to PROGRESS: "where does the funnel actually stand" was a thing a mind re-derived by hand each time
# it was asked, so two windows could answer it differently and neither answer survived a clear.
# This tool is the single derivation, and `--line` is what the job window's charter names as its
# `progress:` so the pane's first row carries it every frame.
#
# NEVER HAND-MAINTAINED. Every number is counted from ~/.mesh/job-board.tsv at read time. A funnel
# figure typed into a document is wrong by the next application, and the doctrine this codebase
# already carries ("never hand-maintain a roster count beside the roster") is exactly this case.
#
#   mesh-job-funnel           the full funnel with conversions
#   mesh-job-funnel --line    ONE line, for a charter's progress: / a data pane
#   mesh-job-funnel --write   (re)generate the FUNNEL.md progress file in the lane's folder
#   mesh-job-funnel --test    smoke test
#
# orphan-ok: on-demand + called from the job charter's progress: line; not a cron reflex.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
BOARD="${MESH_JOB_BOARD:-$MESH/job-board.tsv}"
LANE_DIR="${MESH_JOB_LANE_DIR:-${MESH_GENOME:-$HOME/lte-workstation}/job}"

# THE DECLARED FUNNEL ORDER. A candidate moves down this list; the ORDER is the funnel and it is
# declared here once so the report, the one-liner and the file can never disagree about it.
# Measured against the live board 2026-08-29: field 5 carries exactly seen/sent/viewed/needs-human/
# interview plus the two exits. `questions` was in this list on the first draft and is NOT a state —
# the word appears in a DIFFERENT column, and a phantom stage prints a permanent 0 that reads as a
# real collapse between two real stages. Anything a job tool starts writing that is not named here is
# caught and NAMED by the undeclared-state arm below, which is why this list may be short.
STAGES="seen sent viewed needs-human interview"
# Terminal states are NOT funnel stages — they are exits. Counting them in the descent would make the
# funnel widen at the bottom, which is not a funnel.
EXITS="dropped rejected"

_counts() { # emits "state<TAB>count" for every state PRESENT in the board, plus a TOTAL line.
  awk -F'\t' 'NR>1 && $0 !~ /^#/ && $5 != "" { c[$5]++; n++ } END { for (s in c) printf "%s\t%d\n", s, c[s]; printf "__total__\t%d\n", n }' "$BOARD" 2>/dev/null
}

_board_age() { # seconds since the board was last written, or empty if unreadable
  [ -r "$BOARD" ] || return 1
  echo $(( $(date +%s) - $(stat -c %Y "$BOARD" 2>/dev/null || echo 0) ))
}

_human_age() { # $1=seconds -> compact
  local s="$1"
  if   [ "$s" -lt 3600 ]  ; then echo "$(( s / 60 ))м"
  elif [ "$s" -lt 86400 ] ; then echo "$(( s / 3600 ))ч"
  else                           echo "$(( s / 86400 ))д"; fi
}

# THE ABSENT BOARD RENDERS UNKNOWN, NEVER ZEROS. A funnel of all-zeros is a readable, plausible
# sentence — "nothing has been applied to" — and it is the sentence a missing file would produce.
# Those are opposite facts and they must not share a rendering.
_render() { # $1=line|full
  local mode="$1" age agestr line out total=0 s c known=0 unknown_names="" unknown_n=0
  if [ ! -r "$BOARD" ]; then
    echo "ВОРОНКА НЕИЗВЕСТНА — доска $BOARD не читается (это НЕ пустая воронка: ноль откликов и отсутствующий файл читаются одинаково, и это разные факты)"
    return 0
  fi
  age="$(_board_age)"; agestr="$(_human_age "${age:-0}")"
  declare -A C=()
  while IFS=$'\t' read -r s c; do
    [ -n "$s" ] || continue
    if [ "$s" = "__total__" ]; then total="$c"; continue; fi
    C["$s"]="$c"
  done < <(_counts)
  if [ "$total" = 0 ]; then
    echo "ВОРОНКА ПУСТА — доска $BOARD читается, но не содержит ни одной строки с состоянием (возраст доски: $agestr)"
    return 0
  fi
  # AN UNRECOGNISED STATE IS NAMED, NOT DROPPED. The stage list above is an allowlist, and an
  # allowlist's failure direction is silence: a new state introduced by any job tool would simply
  # vanish from the funnel while every number still added up to something plausible.
  for s in "${!C[@]}"; do
    case " $STAGES $EXITS " in *" $s "*) known=$(( known + ${C[$s]} )) ;;
      *) unknown_n=$(( unknown_n + ${C[$s]} )); unknown_names="${unknown_names:+$unknown_names,}$s" ;;
    esac
  done
  if [ "$mode" = line ]; then
    # NUMBERS FIRST, LEGEND SECOND. This line is rendered into a pane that clips at its width, so
    # whatever sits at the end is what disappears. The counts are the payload; the words naming the
    # stages are recoverable from `mesh-job-funnel` in full. Ordering them the other way put the
    # interview count — the lane's whole metric — past the clip.
    out=""
    for s in $STAGES; do out="${out:+$out→}${C[$s]:-0}"; done
    line="воронка $out (найдено→отклик→просмотр→вопрос→ИНТЕРВЬЮ)"
    for s in $EXITS; do [ -n "${C[$s]:-}" ] && line="$line · $s ${C[$s]}"; done
    [ "$unknown_n" -gt 0 ] && line="$line · ⚠ $unknown_n в необъявленных состояниях [$unknown_names]"
    echo "$line · доска $agestr"
    return 0
  fi
  printf 'ВОРОНКА ЛАНА job — выведена из %s (возраст: %s), всего строк: %s\n\n' "$BOARD" "$agestr" "$total"
  local prev=""
  for s in $STAGES; do
    c="${C[$s]:-0}"
    if [ -n "$prev" ] && [ "$prev" -gt 0 ]; then
      printf '  %-12s %6s   %s%% от предыдущей ступени\n' "$s" "$c" "$(awk -v a="$c" -v b="$prev" 'BEGIN{printf "%.1f", 100*a/b}')"
    else
      printf '  %-12s %6s\n' "$s" "$c"
    fi
    prev="$c"
  done
  printf '\n  выходы:\n'
  for s in $EXITS; do printf '  %-12s %6s\n' "$s" "${C[$s]:-0}"; done
  if [ "$unknown_n" -gt 0 ]; then
    printf '\n  ⚠ %s строк в НЕОБЪЯВЛЕННЫХ состояниях [%s] — они не входят ни в одну ступень выше;\n' "$unknown_n" "$unknown_names"
    printf '    добавьте их в STAGES/EXITS этого инструмента, иначе воронка молча их теряет.\n'
  fi
  printf '\n  МЕТРИКА ЛАНА — ИНТЕРВЬЮ: %s. Всё, что не двигает это число, накладные расходы (charter/job.md).\n' "${C[interview]:-0}"
}

case "${1:-}" in
  --line) _render line ;;
  --write)
    mkdir -p "$LANE_DIR" || { echo "mesh-job-funnel: cannot create $LANE_DIR" >&2; exit 1; }
    { printf '<!-- СГЕНЕРИРОВАНО mesh-job-funnel --write. Не редактировать руками: любая цифра\n'
      printf '     здесь выводится из доски при каждом запуске, а вписанная руками устаревает\n'
      printf '     на следующем же отклике. Файл в .gitignore: репозиторий ПУБЛИЧНЫЙ, а это\n'
      printf '     статистика поиска работы живого человека (решение оператора 2026-08-29). -->\n'
      printf '# Воронка лана job\n\n_снято: %s_\n\n```\n' "$(date -u +%FT%TZ)"
      _render full
      printf '```\n'; } > "$LANE_DIR/FUNNEL.md"
    echo "mesh-job-funnel: записано $LANE_DIR/FUNNEL.md"
    ;;
  --test)
    td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$td"' EXIT
    trap 'rm -rf "$td"; trap - EXIT; exit 143' INT TERM HUP
    f=0
    # (1) AN ABSENT BOARD IS UNKNOWN, NOT AN EMPTY FUNNEL. These are opposite facts and the whole
    #     value of the line is destroyed if they render the same. Mutant: return zeros -> red.
    o="$(MESH_JOB_BOARD="$td/nope.tsv" "$0" --line)"
    case "$o" in *"ВОРОНКА НЕИЗВЕСТНА"*) :;;
      *) echo "  FAIL: an unreadable board must render UNKNOWN, never a funnel of zeros (got: $o)"; f=1;; esac
    [ -n "$o" ] || { echo "  FAIL: an unreadable board rendered an EMPTY line — a pane would show a blank row"; f=1; }
    # (2) a real board counts every declared stage
    printf '# date\tcompany\trole\tlink\tstate\tnote\n' > "$td/b.tsv"
    for i in 1 2 3 4 5; do printf 'd\tc\tr\tl\tseen\tn\n' >> "$td/b.tsv"; done
    printf 'd\tc\tr\tl\tsent\tn\n'      >> "$td/b.tsv"
    printf 'd\tc\tr\tl\tsent\tn\n'      >> "$td/b.tsv"
    printf 'd\tc\tr\tl\tinterview\tn\n' >> "$td/b.tsv"
    printf 'd\tc\tr\tl\trejected\tn\n'  >> "$td/b.tsv"
    o="$(MESH_JOB_BOARD="$td/b.tsv" "$0" --line)"
    # POSITIONAL, because the line is now positional: `5→2→0→0→1` says seen=5, sent=2, viewed=0,
    # needs-human=0, interview=1 purely by ORDER. Asserting the whole sequence catches a reordered or
    # dropped stage, which a per-count assertion cannot — with counts checked one at a time, silently
    # swapping two stages leaves every individual number still present and still true.
    case "$o" in *"воронка 5→2→0→0→1 "*) :;;
      *) echo "  FAIL: the funnel sequence must be seen→sent→viewed→needs-human→interview = 5→2→0→0→1 (got: $o)"; f=1;; esac
    case "$o" in *"(найдено→отклик→просмотр→вопрос→ИНТЕРВЬЮ)"*) :;;
      *) echo "  FAIL: the legend naming what those positions MEAN is gone — a bare number sequence is unreadable (got: $o)"; f=1;; esac
    case "$o" in *"rejected 1"*) :;; *) echo "  FAIL: an exit state not reported (got: $o)"; f=1;; esac
    # (3) AN UNDECLARED STATE IS NAMED, NEVER SILENTLY DROPPED. This is the exclusion-allowlist trap:
    #     a new state added by any job tool would vanish while every printed number stayed plausible.
    printf 'd\tc\tr\tl\tbrand-new-state\tn\n' >> "$td/b.tsv"
    o="$(MESH_JOB_BOARD="$td/b.tsv" "$0" --line)"
    case "$o" in *"brand-new-state"*) :;;
      *) echo "  FAIL: a state outside the declared funnel was dropped silently — the allowlist fails toward silence (got: $o)"; f=1;; esac
    # (4) the full report must not contradict the one-liner about the metric
    o="$(MESH_JOB_BOARD="$td/b.tsv" "$0")"
    case "$o" in *"ИНТЕРВЬЮ: 1"*) :;; *) echo "  FAIL: the full report does not carry the lane metric (got: $o)"; f=1;; esac
    # (5) --write produces a file that says it is generated, so nobody edits it by hand
    MESH_JOB_BOARD="$td/b.tsv" MESH_JOB_LANE_DIR="$td/lane" "$0" --write >/dev/null
    grep -q 'СГЕНЕРИРОВАНО mesh-job-funnel' "$td/lane/FUNNEL.md" \
      || { echo "  FAIL: the generated funnel file does not declare itself generated — the next hand edits it and it rots"; f=1; }
    grep -q 'interview *1' "$td/lane/FUNNEL.md" \
      || { echo "  FAIL: the generated file carries no funnel"; f=1; }
    # (6) an EMPTY but readable board is a third state, distinct from both above
    printf '# date\tcompany\trole\tlink\tstate\tnote\n' > "$td/e.tsv"
    o="$(MESH_JOB_BOARD="$td/e.tsv" "$0" --line)"
    case "$o" in *"ВОРОНКА ПУСТА"*) :;;
      *) echo "  FAIL: a readable-but-empty board must be its own word, not UNKNOWN and not zeros (got: $o)"; f=1;; esac
    [ "$f" = 0 ] || { echo "smoke-test: FAIL (job funnel drifted)"; exit 1; }
    echo "smoke-test: ok (funnel derived from the board at read time, never hand-maintained: an unreadable board renders UNKNOWN and an empty one renders EMPTY — neither collapses into a funnel of zeros · every declared stage and exit counted · a state OUTSIDE the declared funnel is NAMED rather than silently dropped · the generated file declares itself generated)"
    exit 0
    ;;
  ""|--full) _render full ;;
  -h|--help) sed -n '2,24p' "$0" ;;
  *) echo "mesh-job-funnel: unknown option '$1' (see --help)" >&2; exit 2 ;;
esac
