#!/usr/bin/env python3
"""mesh-job-letter — assemble a cover letter for one vacancy from HIS OWN facts. No invention.

  mesh-job-letter --vacancy <file|-> [--max-blocks N] [--blocks <path>]
  mesh-job-letter --test

Why not an LLM: every number in this lane is the operator's own, and a generated letter goes out
under his name. A model asked to "write a cover letter" will smooth a 50 000 HTTP req/s into
"50k QPS", invent a year, or promise a skill — and the failure is unrecoverable, because the
employer already read it. So the letter is ASSEMBLED, never written: fixed paragraphs he has
approved, selected by keyword overlap with the vacancy text, in a fixed order. The only freedom
the tool has is WHICH of his true paragraphs to include.

Blocks live in ~/.mesh/job/letter-blocks.md:

    ## opening
    Здравствуйте.

    ## dsp-go | tags: go, golang, highload, rps, нагрузк, backend
    Go в проде под нагрузкой: ...

`opening` and `closing` are always emitted, first and last. Everything else competes: a block
scores by how many of its tags appear in the vacancy text (case-folded substring), ties broken by
the order in the file, and the top --max-blocks (default 4) are emitted in FILE order, not score
order — so the letter's argument keeps its shape whichever blocks win.

A block whose tags match nothing is never emitted. If fewer than two blocks match, the tool exits 3
rather than send a generic letter: a vacancy this tool cannot speak to specifically is one a human
should look at.
"""
import argparse, os, pathlib, re, sys

BLOCKS = pathlib.Path(os.path.expanduser("~/.mesh/job/letter-blocks.md"))


def parse_blocks(path):
    """-> [(name, tags[], text)] in file order."""
    out, name, tags, buf = [], None, [], []
    for line in path.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^##\s+([a-z0-9-]+)\s*(?:\|\s*tags:\s*(.*))?$", line.strip())
        if m:
            if name:
                out.append((name, tags, "\n".join(buf).strip()))
            name = m.group(1)
            tags = [t.strip().lower() for t in (m.group(2) or "").split(",") if t.strip()]
            buf = []
        elif name:
            buf.append(line)
    if name:
        out.append((name, tags, "\n".join(buf).strip()))
    return [b for b in out if b[2]]


def pick(blocks, vacancy, max_blocks):
    low = vacancy.lower()
    fixed = {n: t for n, _, t in blocks if n in ("opening", "closing")}
    body = [(n, tg, t) for n, tg, t in blocks if n not in ("opening", "closing")]
    scored = [(sum(1 for tag in tg if tag in low), i, n, t) for i, (n, tg, t) in enumerate(body)]
    hits = [s for s in scored if s[0] > 0]
    hits.sort(key=lambda s: (-s[0], s[1]))
    chosen = sorted(hits[:max_blocks], key=lambda s: s[1])
    return fixed, chosen


def build(vacancy, max_blocks=4, blocks_path=BLOCKS):
    blocks = parse_blocks(blocks_path)
    fixed, chosen = pick(blocks, vacancy, max_blocks)
    if len(chosen) < 2:
        return None, [n for _, _, n, _ in chosen]
    parts = ([fixed["opening"]] if "opening" in fixed else [])
    parts += [t for _, _, _, t in chosen]
    parts += ([fixed["closing"]] if "closing" in fixed else [])
    return "\n\n".join(parts), [n for _, _, n, _ in chosen]


def selftest():
    import tempfile
    src = """## opening
Здравствуйте.

## go | tags: go, golang
Go в проде: 50 000 HTTP-запросов в секунду.

## lead | tags: тимлид, руководитель, команд
Вёл команду девять инженеров.

## video | tags: vast, vpaid, видеореклам
Видеостек: VAST 2/3/4.

## closing
Илья Мозеров
"""
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8") as f:
        f.write(src)
        p = pathlib.Path(f.name)
    rc = 0

    def check(label, cond):
        nonlocal rc
        print(("ok:   " if cond else "FAIL: ") + label)
        if not cond:
            rc = 1

    txt, names = build("Ищем руководителя команды Go", 4, p)
    check("matching vacancy selects go+lead, not video", names == ["go", "lead"])
    check("opening and closing always present",
          txt.startswith("Здравствуйте.") and txt.endswith("Илья Мозеров"))
    check("unmatched block is never emitted", "VAST" not in txt)

    # File order, not score order: 'lead' scores 2 and 'go' 1, but 'go' is written first.
    txt2, names2 = build("тимлид, руководитель команды, Go, golang", 4, p)
    check("blocks keep FILE order even when scores invert", names2 == ["go", "lead"])

    # The refusal is the load-bearing branch — a lane that silently sends a generic letter is
    # worse than one that stops. Assert it FAILS, not that the happy path passes.
    txt3, names3 = build("Ищем повара в столовую", 4, p)
    check("vacancy matching nothing refuses to build a letter", txt3 is None)
    txt4, _ = build("Ищем Go-разработчика", 4, p)
    check("a single matching block also refuses (one paragraph is not a letter)", txt4 is None)

    check("live blocks file exists and parses", BLOCKS.exists() and len(parse_blocks(BLOCKS)) >= 4)
    if BLOCKS.exists():
        names = [n for n, _, _ in parse_blocks(BLOCKS)]
        check("live blocks carry an opening and a closing",
              "opening" in names and "closing" in names)
    p.unlink()
    return rc


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--vacancy")
    ap.add_argument("--max-blocks", type=int, default=4)
    ap.add_argument("--blocks", default=str(BLOCKS))
    ap.add_argument("--test", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help or (not a.test and not a.vacancy):
        print(__doc__)
        return 0
    if a.test:
        return selftest()
    text = sys.stdin.read() if a.vacancy == "-" else pathlib.Path(a.vacancy).read_text(encoding="utf-8")
    letter, names = build(text, a.max_blocks, pathlib.Path(a.blocks))
    if letter is None:
        print("refused: vacancy matched %d block(s), need 2+ — look at it by hand" % len(names),
              file=sys.stderr)
        return 3
    print(letter)
    print("[blocks] " + ", ".join(names), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
