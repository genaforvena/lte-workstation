#!/usr/bin/env bash
# mesh-job-states — ОДНО объявление словаря состояний лана job. Читают все писатели и все читатели.
#
#   mesh-job-states              полная таблица (state<TAB>kind<TAB>movable<TAB>gloss)
#   mesh-job-states --stages     ступени воронки, В ПОРЯДКЕ спуска
#   mesh-job-states --exits      выходы (НЕ ступени: воронка не расширяется книзу)
#   mesh-job-states --glosses    человеческие имена ступеней, в том же порядке
#   mesh-job-states --rungs      ступени СПУСКА (ветки исключены: конверсия на ветке бессмысленна)
#   mesh-job-states --movable    состояния, поверх которых письмо от работодателя вправе писать
#   mesh-job-states --all        stages + exits
#   mesh-job-states --check W... rc 0 если каждое W объявлено; иначе НАЗЫВАЕТ незнакомые, rc 1
#   mesh-job-states --test       smoke test
#
# WHY IT EXISTS (доска, task:mesh-job-funnel {#e4071343}, 2026-08-29). Про ОДИН факт — «работодатель
# ответил» — лан говорил ТРЕМЯ словами: ладдер в job-mission.md писал `reply`, mesh-job-mail кладёт в
# поле состояния `replied`, а в STAGES воронки стадии ответа не было ВООБЩЕ. Замер того дня: три
# строки, выставленные в `reply` руками в 18:26Z, к 18:37Z были переписаны mesh-job-mail обратно в
# `sent` — слово из документа проиграло слову из кода МОЛЧА. Слово `replied` в воронку добавили тем же
# днём, и это лечило симптом, а не форму: списки так и остались ТРЕМЯ независимыми константами в трёх
# файлах, сойтись которым не мешает и не помогает ничто, кроме руки.
#
# И расхождение никуда не делось, оно просто переехало: mesh-job-track пишет в то же поле `invited`
# и `offer` (STATUS/RANK, mesh-job-track:40-50) — ДВА слова живого писателя, которых нет ни в одном
# списке воронки. Сегодня воронка честно называет их «⚠ в необъявленных состояниях», то есть самая
# сильная ступень лана (приглашение) рендерится как аномалия.
#
# Поэтому объявление здесь ОДНО, и порядок строк НИЖЕ — это и есть порядок воронки. Правило чтения:
# отсутствие этого объявления — ГРОМКАЯ ошибка у каждого читателя, никогда не тихая подстановка
# константы (иначе разошедшийся словарь снова станет правдоподобной константой, ровно как 18:26Z).
#
# orphan-ok: не рефлекс и не самостоятельный инструмент — это объявление, которое ЗАПУСКАЮТ как
#   подпроцесс три конкретных вызывающих, и каждый проверяется грепом: mesh-job-funnel (--stages,
#   --exits, --glosses, --rungs), mesh-job-mail (--movable в movable_states()), mesh-job-track
#   (--all в declared_states()). Никакой кроновой каденции у него нет и быть не должно.
set -uo pipefail

# ПОРЯДОК СТРОК = ПОРЯДОК ВОРОНКИ. Колонки: state / kind(stage|exit) / movable(yes|no) / gloss / rung(yes|no).
#
# rung=no — состояние, в котором строка СТОИТ, но которое не является ступенью спуска. `needs-human`
# такой: это ветка «работодатель ответил, и ответ требует руки оператора», а не рунг между ответом и
# интервью. Разница не косметическая — воронка печатает конверсию «% от предыдущей ступени», и на
# ветке эта арифметика бессмысленна в обе стороны: живой прогон 2026-08-29 дал `needs-human 15 —
# 1500.0% от предыдущей ступени` и тут же СЪЕЛ конверсию интервью, поделив его на ветку. Ветка
# считается и печатается, но не получает процента и не становится знаменателем следующего рунга.
#
# movable=yes — состояние, поверх которого прямое письмо от работодателя (без ссылки на вакансию)
# вправе переписать строку. Это НЕ «известное состояние»: набор нарочно уже словаря, потому что
# письмо, опознанное только по именам компании и вакансии, не должно двигать строку, которая уже
# ушла в интервью или в отказ. Ровно тот кортеж, что жил в mesh-job-mail:464 до этого файла.
#
# `offer` — ступень, а не выход: воронка сужается книзу, и её дно — выигрыш, а не отсев. В EXITS
# лежит только то, чем кандидат ВЫБЫВАЕТ (снят нами / отказ работодателя).
_TABLE() { cat <<'EOF'
seen	stage	no	найдено	yes
sent	stage	yes	отклик	yes
viewed	stage	yes	просмотр	yes
replied	stage	yes	ОТВЕТ	yes
needs-human	stage	no	вопрос	no
invited	stage	no	приглашение	yes
interview	stage	no	ИНТЕРВЬЮ	yes
offer	stage	no	оффер	yes
dropped	exit	no	снято	no
rejected	exit	no	отказ	no
EOF
}

_col() { # $1=kind filter (stage|exit|any) $2=field to print (1=state 4=gloss)
  _TABLE | awk -F'\t' -v k="$1" -v f="$2" '($0 !~ /^#/) && NF>=5 && (k=="any" || $2==k) { printf "%s%s", (n++?" ":""), $f } END { if (n) printf "\n" }'
}

case "${1:-}" in
  "")         _TABLE ;;
  --stages)   _col stage 1 ;;
  --exits)    _col exit 1 ;;
  --glosses)  _col stage 4 ;;
  --all)      printf '%s %s\n' "$(_col stage 1)" "$(_col exit 1)" ;;
  --rungs)    _TABLE | awk -F'\t' 'NF>=5 && $2=="stage" && $5=="yes" { printf "%s%s", (n++?" ":""), $1 } END { if (n) printf "\n" }' ;;
  --movable)  _TABLE | awk -F'\t' 'NF>=5 && $3=="yes" { printf "%s%s", (n++?" ":""), $1 } END { if (n) printf "\n" }' ;;
  --check)
    shift
    [ "$#" -gt 0 ] || { echo "mesh-job-states --check: нечего проверять (передайте состояния)" >&2; exit 2; }
    known=" $(_col stage 1) $(_col exit 1) "; bad=""
    for w in "$@"; do case "$known" in *" $w "*) :;; *) bad="${bad:+$bad, }$w";; esac; done
    [ -z "$bad" ] || { echo "НЕОБЪЯВЛЕННЫЕ состояния: $bad (объяви их в mesh-job-states или не пиши их на доску)" >&2; exit 1; }
    ;;
  --test)
    f=0
    # (1) ПОРЯДОК — ЭТО СОДЕРЖАНИЕ. Воронка печатает голую последовательность чисел, и её смысл
    #     несёт только порядок; перестановка двух ступеней не ломает ни одну поштучную проверку.
    o="$("$0" --stages)"
    [ "$o" = "seen sent viewed replied needs-human invited interview offer" ] \
      || { echo "  FAIL: порядок ступеней изменился или ступень пропала (got: $o)"; f=1; }
    # (2) ГЛОССЫ ИДУТ ОДИН-К-ОДНОМУ СО СТУПЕНЯМИ. Легенда воронки печатается отдельным списком, и
    #     сдвиг на одну позицию переименовывает КАЖДУЮ ступень, не меняя ни одного числа.
    ns="$("$0" --stages | wc -w)"; ng="$("$0" --glosses | wc -w)"
    [ "$ns" = "$ng" ] || { echo "  FAIL: ступеней $ns, глоссов $ng — легенда сдвинется и переименует все ступени"; f=1; }
    # (3) ВЫХОД — НЕ СТУПЕНЬ. Слово в обоих списках сделало бы воронку шире книзу.
    for e in $("$0" --exits); do
      case " $("$0" --stages) " in *" $e "*) echo "  FAIL: '$e' объявлен и ступенью, и выходом"; f=1;; esac
    done
    [ -n "$("$0" --exits)" ] || { echo "  FAIL: выходов нет вообще"; f=1; }
    # (4) MOVABLE — ПОДМНОЖЕСТВО, И ОНО НЕ ПУСТО. Пустой набор молча запретил бы письму двигать
    #     что-либо; набор, вылезший за словарь, разрешил бы двигать необъявленное.
    mv="$("$0" --movable)"
    [ -n "$mv" ] || { echo "  FAIL: movable пуст — прямое письмо от работодателя перестанет двигать строки, молча"; f=1; }
    for m in $mv; do
      case " $("$0" --all) " in *" $m "*) :;; *) echo "  FAIL: movable '$m' не объявлен в словаре"; f=1;; esac
    done
    # КАЖДОЕ movable-СЛОВО НАЗВАНО ПОИМЁННО, а не только «набор непуст»: снятие одного из трёх
    # оставляет набор непустым, и проверка на непустоту такую потерю не видит. `sent` — состояние
    # подавляющего большинства строк доски, и молча выпав из набора, оно остановило бы разметку
    # почти всех писем от работодателей.
    for m in sent viewed replied; do
      case " $mv " in *" $m "*) :;; *) echo "  FAIL: '$m' не movable — письмо от работодателя перестанет двигать строки в этом состоянии"; f=1;; esac
    done
    case " $mv " in *" interview "*|*" rejected "*|*" dropped "*)
      echo "  FAIL: терминальное состояние объявлено movable — письмо, опознанное лишь по именам, отбросит строку назад"; f=1;; esac
    # (5) --check НАЗЫВАЕТ незнакомое и МОЛЧИТ на знакомом. Обе полярности: гейт, который никогда не
    #     краснеет, и гейт, который всегда красный, одинаково бесполезны.
    "$0" --check seen replied offer rejected >/dev/null 2>&1 \
      || { echo "  FAIL: --check отверг объявленные состояния"; f=1; }
    if "$0" --check replied совершенно-новое >/dev/null 2>&1; then
      echo "  FAIL: --check пропустил НЕобъявленное состояние — словарь-аллоулист падает в тишину"; f=1
    else
      o="$("$0" --check replied совершенно-новое 2>&1)"
      case "$o" in *"совершенно-новое"*) :;; *) echo "  FAIL: --check отверг, но НЕ НАЗВАЛ незнакомое слово (got: $o)"; f=1;; esac
    fi
    # (6) РУНГИ — ПОДМНОЖЕСТВО СТУПЕНЕЙ, И ХОТЯ БЫ ОДНА СТУПЕНЬ ОБЪЯВЛЕНА ВЕТКОЙ. Пустой набор
    #     веток вернул бы ту самую конверсию через ветку (живой прогон: `needs-human 1500.0%`), а
    #     рунг вне списка ступеней делил бы на состояние, которого воронка не печатает.
    rg="$("$0" --rungs)"; st="$("$0" --stages)"
    [ -n "$rg" ] || { echo "  FAIL: рунгов нет вообще — воронка останется без единой конверсии"; f=1; }
    for r in $rg; do
      case " $st " in *" $r "*) :;; *) echo "  FAIL: рунг '$r' не объявлен ступенью — конверсия делила бы на непечатаемое состояние"; f=1;; esac
    done
    [ "$(echo "$rg" | wc -w)" -lt "$(echo "$st" | wc -w)" ] \
      || { echo "  FAIL: ни одна ступень не объявлена веткой — конверсия снова пойдёт ЧЕРЕЗ ветку (замер: needs-human 1500.0%)"; f=1; }
    case " $rg " in *" needs-human "*) echo "  FAIL: 'needs-human' объявлен рунгом — это ветка ответа, а не ступень спуска"; f=1;; esac
    # (7) НИ ОДНО СОСТОЯНИЕ НЕ ОБЪЯВЛЕНО ДВАЖДЫ — дубль тихо удвоил бы ступень в воронке.
    d="$("$0" --all | tr ' ' '\n' | sort | uniq -d | tr '\n' ' ')"
    [ -z "$(echo "$d" | tr -d ' ')" ] || { echo "  FAIL: состояние объявлено дважды: $d"; f=1; }
    [ "$f" = 0 ] || { echo "smoke-test: FAIL (словарь состояний лана job разъехался)"; exit 1; }
    echo "smoke-test: ok (одно объявление: порядок ступеней = порядок воронки · глоссов ровно столько же, сколько ступеней · выход не может быть ступенью · movable — непустое подмножество без терминальных · --check называет незнакомое и молчит на знакомом · ни одного дубля)"
    exit 0
    ;;
  -h|--help) sed -n '2,12p' "$0" ;;
  *) echo "mesh-job-states: неизвестная опция '$1' (см. --help)" >&2; exit 2 ;;
esac
