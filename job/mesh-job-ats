#!/usr/bin/env python3
"""mesh-job-ats — find an employer's OWN job board and the posting on it, without any account.

  mesh-job-ats --employer "Acme Corp" [--title "Go team lead"] [--json]
  mesh-job-ats --measure N        # take N linkedin rows off the board and report the hit rate
  mesh-job-ats --test

Greenhouse, Lever and Ashby all expose a PUBLIC json board per company — no key, no login, no
scraping. So a vacancy discovered on LinkedIn can usually be applied to in the employer's own ATS
instead: the application reaches the recruiter directly, the form has a real cover-letter field
instead of an Easy Apply funnel, and no LinkedIn account is put at risk. That makes LinkedIn a
DISCOVERY layer and the ATS the delivery layer.

The honest limits, which this tool measures rather than assumes:
  * some postings exist only on LinkedIn — reported as `linkedin-only`, kept, never discarded;
  * Workday is deliberately NOT probed: it wants an account per employer, which is N registrations
    rather than one login, and that cost belongs in a decision, not in a silent retry loop;
  * the LinkedIn title and the careers title often differ, so the match is company-first and the
    title only ranks candidates within a board that was already found.

`--measure` answers the only question worth asking before building on this: of the vacancies we
actually discovered, what FRACTION are reachable this way. Everything else follows from that
number.
"""
import argparse, json, os, pathlib, re, sys, time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

BOARD = pathlib.Path(os.path.expanduser("~/.mesh/job-board.tsv"))
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/128.0.0.0 Safari/537.36")

ATS = [
    ("greenhouse", "https://boards-api.greenhouse.io/v1/boards/%s/jobs",
     lambda d: [(j.get("title", ""), j.get("absolute_url", "")) for j in d.get("jobs", [])]),
    ("lever", "https://api.lever.co/v0/postings/%s?mode=json",
     lambda d: [(j.get("text", ""), j.get("hostedUrl", "")) for j in d]),
    ("ashby", "https://api.ashbyhq.com/posting-api/job-board/%s",
     lambda d: [(j.get("title", ""), j.get("jobUrl", "")) for j in d.get("jobs", [])]),
]


def slugs(name):
    """Company name -> the handful of slugs an ATS is likely to use. Ordered most-likely first."""
    base = re.sub(r"[^\w\s-]", " ", name.lower())
    base = re.sub(r"\b(inc|llc|ltd|gmbh|bv|b\.v|corp|corporation|technologies|technology|"
                  r"tech|software|solutions|labs|group|company|co|ооо|ao|пао)\b", " ", base)
    words = [w for w in re.split(r"[\s_-]+", base) if w]
    if not words:
        return []
    out = ["".join(words), "-".join(words), words[0]]
    seen, uniq = set(), []
    for s in out:
        if s and s not in seen:
            seen.add(s)
            uniq.append(s)
    return uniq


def get_json(url, timeout=12):
    try:
        with urlopen(Request(url, headers={"User-Agent": UA}), timeout=timeout) as r:
            if r.status != 200:
                return None
            return json.loads(r.read().decode("utf-8", "replace"))
    except (HTTPError, URLError, ValueError, TimeoutError, OSError):
        return None


def find_board(employer, pause=1.0):
    """-> (ats_name, slug, [(title, url)]) or None."""
    for slug in slugs(employer):
        for name, tmpl, extract in ATS:
            d = get_json(tmpl % slug)
            time.sleep(pause)
            if d is None:
                continue
            try:
                jobs = extract(d)
            except Exception:
                continue
            if jobs:
                return name, slug, jobs
    return None


STOP = {"the", "and", "for", "with", "of", "in", "a", "to", "и", "по", "на", "с", "в"}


def rank_jobs(jobs, title):
    """Postings from THIS board that plausibly are the same role.

    One shared word is not a match: "Marketing Lead" and "Go Team Lead" share `lead`, and a
    one-word threshold turns every board with a manager on it into a hit — which would inflate
    exactly the number --measure exists to report honestly. So a title with three or more
    meaningful tokens must match at least two. Tokens of length 2 are KEPT: `go` is the most
    distinctive word in half of his searches and a >2 filter silently dropped it.
    """
    if not title:
        return jobs[:5]
    words = [w for w in re.split(r"[^\w]+", title.lower()) if len(w) >= 2 and w not in STOP]
    if not words:
        return jobs[:5]
    need = 2 if len(words) >= 3 else 1
    scored = [(sum(1 for w in words if w in (t or "").lower()), t, u) for t, u in jobs]
    scored.sort(key=lambda x: -x[0])
    return [(t, u) for s, t, u in scored if s >= need][:5]


def linkedin_rows(limit, where=""):
    """Board rows discovered on LinkedIn. `where` filters on the note (locations live there), so a
    measurement can be taken over the population we would actually apply to — a hit rate measured
    over Indian IT-services firms says nothing about European product companies, and quoting it as
    "the" rate would be the wrong number honestly computed."""
    if not BOARD.exists():
        return []
    out = []
    for l in BOARD.read_text(encoding="utf-8").splitlines():
        f = l.split("\t")
        if len(f) >= 6 and "linkedin.com/jobs/view" in f[3] and f[4] == "seen" and f[1].strip():
            if where and where.lower() not in f[5].lower():
                continue
            out.append({"employer": f[1], "title": f[2], "url": f[3]})
        if len(out) >= limit:
            break
    return out


def selftest():
    rc = 0

    def check(label, cond):
        nonlocal rc
        print(("ok:   " if cond else "FAIL: ") + label)
        if not cond:
            rc = 1

    s = slugs("Acme Technologies Inc")
    check("legal and generic suffixes are stripped from the slug", "acme" in s)
    check("slug variants include the joined and hyphenated forms",
          any("-" in x for x in slugs("Point Wild Labs")) and "pointwild" in slugs("Point Wild Labs"))
    check("a name that is only a suffix does not produce an empty slug", slugs("Inc") == [] or all(slugs("Inc")))

    jobs = [("Senior Go Engineer", "u1"), ("Marketing Lead", "u2"), ("Go Team Lead", "u3")]
    ranked = rank_jobs(jobs, "Go team lead")
    check("title ranking puts the closest posting first", ranked and ranked[0][1] == "u3")
    check("a posting sharing no words is dropped, not ranked last",
          all(u != "u2" for _, u in ranked))
    check("no title returns the board head rather than nothing", len(rank_jobs(jobs, "")) == 3)

    # Live: a board that certainly exists, and one that certainly does not. Both directions,
    # because a prober that says "found" for everything is as useless as one that never does.
    live = find_board("Stripe", pause=0.3)
    check("live probe finds a real public board (Stripe)", live is not None)
    if live:
        print("      live: Stripe -> %s/%s, %d postings" % (live[0], live[1], len(live[2])))
    junk = find_board("Zzqx Nonexistent Company 91731", pause=0.3)
    check("live probe returns nothing for a company with no board", junk is None)
    return rc


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--employer")
    ap.add_argument("--title", default="")
    ap.add_argument("--measure", type=int)
    ap.add_argument("--where", default="",
                    help="подстрока по заметке строки (локация), чтобы мерить нужную популяцию")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--test", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help or (not a.employer and not a.measure and not a.test):
        print(__doc__)
        return 0
    if a.test:
        return selftest()

    if a.employer:
        found = find_board(a.employer)
        if not found:
            print(json.dumps({"employer": a.employer, "result": "linkedin-only"},
                             ensure_ascii=False) if a.json else
                  "linkedin-only: публичной доски Greenhouse/Lever/Ashby у «%s» не найдено" % a.employer)
            return 1
        ats, slug, jobs = found
        matches = rank_jobs(jobs, a.title)
        if a.json:
            print(json.dumps({"employer": a.employer, "ats": ats, "slug": slug,
                              "postings": len(jobs), "matches": matches}, ensure_ascii=False, indent=1))
        else:
            print("%s: %s/%s, %d вакансий на доске" % (a.employer, ats, slug, len(jobs)))
            for t, u in matches:
                print("   %s\n     %s" % (t, u))
        return 0

    rows = linkedin_rows(a.measure, a.where)
    hits, results = 0, []
    for r in rows:
        found = find_board(r["employer"])
        if found:
            ats, slug, jobs = found
            m = rank_jobs(jobs, r["title"])
            hits += 1 if m else 0
            results.append({**r, "ats": ats, "slug": slug, "postings": len(jobs),
                            "matches": m, "verdict": "ats" if m else "board-no-match"})
        else:
            results.append({**r, "verdict": "linkedin-only"})
    if a.json:
        print(json.dumps(results, ensure_ascii=False, indent=1))
    else:
        for r in results:
            print("%-14s %-26s %s" % (r["verdict"], r["employer"][:26], r["title"][:40]))
        print("\n%d из %d нашлись в собственном ATS работодателя с подходящей вакансией"
              % (hits, len(rows)))
        print("Это число решает, нужен ли LinkedIn-логин вообще.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
