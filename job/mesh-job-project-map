#!/usr/bin/env python3
"""Build a conservative project map from complete posting descriptions.

Usage: mesh-job-project-map [--input FILE] [--json] [--test]

The input is either a JSON list of postings or ``{"inputs": [...]}``.  This
tool never treats an employer, title, stack, or missing description as a
project name.  It is deliberately offline: callers own acquisition of full
posting descriptions and this tool only normalizes and joins them.
"""
import argparse
import datetime as dt
import hashlib
import json
import re
import sys
from pathlib import Path

VERSION = "project-map-v1"
GENERIC = {
    "ai", "backend", "cloud", "data", "engineering", "infrastructure",
    "platform", "project", "service", "system", "team", "product", "auction",
}
TOKEN_RE = re.compile(r"[A-Za-z][A-Za-z0-9+.#/-]{1,}|[А-Яа-яЁё][А-Яа-яЁё0-9-]{2,}")
NAME_RE = re.compile(
    r"\b([A-Z][A-Za-z0-9]*[A-Z][A-Za-z0-9]*|[A-Z][a-z]{2,})\s+"
    r"(?:project|platform|service|system|product|initiative)\b",
)
EXPLICIT_RE = re.compile(
    r"\b(?:project|platform|service|system|product|initiative)\s+"
    r"([A-Z][A-Za-z0-9]*[A-Z][A-Za-z0-9]*|[A-Z][a-z]{2,})\b"
)
CAMEL_RE = re.compile(r"\b[A-Z][a-z]+[A-Z][A-Za-z0-9]*\b")
DOMAIN_PATTERNS = {
    "go": r"(?<!\w)go(?!\w)|golang",
    "kafka": r"(?<!\w)kafka(?!\w)",
    "rtb": r"(?<!\w)rtb(?!\w)|real[- ]time bidding",
    "auction": r"auction|торг(?:и|ов)",
    "backend": r"backend|back-end|бэкенд|бекенд",
    "platform": r"platform|платформ",
    "distributed": r"distributed|распредел",
}


def normalize(value):
    value = value.casefold().replace("ё", "е")
    return re.sub(r"[^\w]+", " ", value, flags=re.UNICODE).strip()


def source_id(url):
    return hashlib.sha256(url.encode("utf-8")).hexdigest()


def parse_date(value):
    if not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def technical_tokens(description):
    text = description or ""
    return sorted(k for k, pattern in DOMAIN_PATTERNS.items() if re.search(pattern, text, re.I))


def named_objects(description):
    """Return distinctive names only when the body explicitly names the object."""
    if not description:
        return []
    found = []
    matches = [(match.group(1), match.start()) for match in NAME_RE.finditer(description)]
    matches += [(match.group(1), match.start()) for match in EXPLICIT_RE.finditer(description)]
    matches += [(match.group(0), match.start()) for match in CAMEL_RE.finditer(description)]
    for raw_name, _ in matches:
        name = " ".join(raw_name.split()).strip(" ,;:.()[]")
        if normalize(name) and normalize(name) not in GENERIC:
            if not any(normalize(name) == normalize(old) for old in found):
                found.append(name)
    return found


def posting(row):
    if not isinstance(row, dict):
        raise ValueError("posting must be an object")
    url = str(row.get("source_url") or row.get("url") or "").strip()
    if not url:
        raise ValueError("posting source_url is required")
    description = row.get("description")
    if description is not None and not isinstance(description, str):
        raise ValueError("posting description must be a string or null")
    names = named_objects(description)
    employer = str(row.get("employer") or "").strip()
    employer_key = normalize(employer)
    names = [name for name in names if normalize(name) != employer_key]
    return {
        "posting_id": str(row.get("posting_id") or source_id(url)),
        "source": str(row.get("source") or "other"),
        "source_url": url,
        "employer": employer,
        "role_title": str(row.get("role_title") or row.get("role") or ""),
        "description": description,
        "description_evidence": (["full-description"] if description else ["description-unavailable"]),
        "named_objects": names,
        "technical_tokens": technical_tokens(description),
        "observed_at": str(row.get("observed_at") or ""),
    }


def build(rows):
    records = [posting(row) for row in rows]
    by_name = {}
    rejected = []
    for record in records:
        if not record["description"]:
            continue
        if not record["named_objects"]:
            employer = record["employer"]
            if employer:
                rejected.append({"posting_id": record["posting_id"], "employer": employer,
                                 "source_url": record["source_url"], "reason": "company-only"})
            continue
        for name in record["named_objects"]:
            by_name.setdefault(normalize(name), {"name": name, "records": []})["records"].append(record)

    projects = []
    for key, candidate in sorted(by_name.items()):
        joined = []
        for record in candidate["records"]:
            if not joined:
                joined.append(record)
                continue
            overlap = set(record["technical_tokens"]) & set(joined[0]["technical_tokens"])
            if overlap:
                joined.append(record)
            else:
                rejected.append({"posting_id": record["posting_id"], "employer": record["employer"],
                                 "source_url": record["source_url"], "reason": "insufficient-overlap"})
        if not joined:
            continue
        dates = [parse_date(r["observed_at"]) for r in joined]
        valid_dates = [d for d in dates if d]
        span = (max(valid_dates) - min(valid_dates)).days if len(valid_dates) >= 2 else None
        if len(joined) >= 2 and span is not None and span <= 30:
            state = "active"
        elif len(joined) >= 2 and span is not None and span > 30:
            state = "recurring"
        else:
            state = "unclear"
        source_urls = sorted({r["source_url"] for r in joined})
        projects.append({
            "project_id": hashlib.sha256(key.encode("utf-8")).hexdigest(),
            "project_name": candidate["name"],
            "project_aliases": sorted({n for r in joined for n in r["named_objects"]}),
            "posting_ids": [r["posting_id"] for r in joined],
            "source_urls": source_urls,
            "employers": sorted({r["employer"] for r in joined}),
            "role_titles": [r["role_title"] for r in joined],
            "descriptions": [r["description"] for r in joined],
            "description_evidence": [
                {"source_url": r["source_url"], "named_objects": r["named_objects"],
                 "technical_tokens": r["technical_tokens"], "observed_at": r["observed_at"]}
                for r in joined
            ],
            "technical_tokens": sorted({t for r in joined for t in r["technical_tokens"]}),
            "confidence": "named" if len(joined) >= 2 else "probable",
            "project_state": state,
            "state_evidence": [r["observed_at"] for r in joined],
            "observed_at": max((r["observed_at"] for r in joined), default=""),
        })
    return {"parser_version": VERSION, "projects": projects, "rejected_project_candidates": rejected}


def fixture():
    return {
        "inputs": [
            {"source": "hh", "source_url": "https://hh.example/vacancy/101", "employer": "Acme Ads",
             "role_title": "Go Team Lead", "description": "Lead the RTB BidStream project; Go, Kafka, auction service.",
             "observed_at": "2026-09-01T10:00:00Z"},
            {"source": "ashby", "source_url": "https://jobs.example/acme/202", "employer": "Acme Ads",
             "role_title": "Engineering Manager, BidStream", "description": "Own BidStream, the RTB auction platform; Go and Kafka.",
             "observed_at": "2026-09-10T10:00:00Z"},
            {"source": "hh", "source_url": "https://hh.example/vacancy/303", "employer": "Ozon",
             "role_title": "Head of Backend", "description": "Build backend services for several teams.",
             "observed_at": "2026-09-10T10:00:00Z"},
        ]
    }


def selftest():
    result = build(fixture()["inputs"])
    assert len(result["projects"]) == 1
    project = result["projects"][0]
    assert project["project_name"] == "BidStream"
    assert project["confidence"] == "named" and project["project_state"] == "active"
    assert project["source_urls"] == ["https://hh.example/vacancy/101", "https://jobs.example/acme/202"]
    assert len(project["descriptions"]) == 2
    assert "Ozon" not in {p["project_name"] for p in result["projects"]}
    assert any(r["employer"] == "Ozon" and r["reason"] == "company-only" for r in result["rejected_project_candidates"])
    missing = build([{**fixture()["inputs"][0], "description": None}])
    assert not missing["projects"]
    print("mesh-job-project-map --test: ok (named join, active state, source preservation, company rejection, missing-description fail-closed)")
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--input", type=Path)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        try:
            return selftest()
        except AssertionError as exc:
            print("mesh-job-project-map --test: FAIL", exc, file=sys.stderr)
            return 1
    if not args.input:
        ap.error("--input is required unless --test is used")
    try:
        data = json.loads(args.input.read_text(encoding="utf-8"))
        rows = data.get("inputs") if isinstance(data, dict) else data
        if not isinstance(rows, list):
            raise ValueError("input must be a JSON list or object with inputs[]")
        output = build(rows)
        print(json.dumps(output, ensure_ascii=False, indent=2) if args.json else
              "mesh-job-project-map: %d project(s), %d rejected candidate(s)" %
              (len(output["projects"]), len(output["rejected_project_candidates"])))
        return 0
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print("mesh-job-project-map: %s" % exc, file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
