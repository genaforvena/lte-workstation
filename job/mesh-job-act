FAILED = []


def check(name, cond, extra=""):
    print("%s %s%s" % ("ok  " if cond else "FAIL", name, ("  <- " + str(extra)) if extra and not cond else ""))
    if not cond:
        FAILED.append(name)


def selftest():
    import tempfile
    H = 3600.0
    now = calendar.timegm(time.strptime("2026-08-29T18:00:00Z", "%Y-%m-%dT%H:%M:%SZ"))
    # a boot record that covers the whole fixture span, so up-hours is exercised for real
    windows = [(now - 400 * H, now)]

    def L(ts, uid, lvl, kind, co, role, subj, gist=""):
        return "\t".join([ts, uid, lvl, kind, co, role, subj, gist])

    tmp = tempfile.TemporaryDirectory()
    try:
        d = pathlib.Path(tmp.name)
        led = d / "job-mail.log"
        led.write_text("\n".join([
            # the live corpus's own shape: the same uid re-read minutes later
            L("2026-08-20T15:13:28Z", "17825", "act", "employer", "Acme Robotics", "Head of Eng", "Сообщение"),
            L("2026-08-20T15:17:12Z", "17825", "act", "employer", "Acme Robotics", "Head of Eng", "Сообщение"),
            L("2026-08-26T11:07:03Z", "17886", "act", "employer", "Beta Systems", "Lead ML", "Вам написали"),
            L("2026-08-21T09:07:05Z", "17862", "act", "employer", "-", "-", "Новое сообщение"),
            L("2026-08-29T17:55:00Z", "17917", "act", "code", "-", "-", "Код подтверждения", "8575"),
            L("2026-08-20T15:13:28Z", "17802", "act", "code", "-", "-", "Код подтверждения", "1111"),
            L("2026-08-25T15:07:04Z", "17882", "act", "employer", "Gamma Labs", "Team Lead", "Вам написали"),
            L("2026-08-27T16:07:04Z", "17902", "act", "boarding-pass", "-", "Senior Go", "Новый вид"),
            L("2026-08-28T12:07:02Z", "17910", "info", "autoreply", "-", "-", "Спасибо"),
        ]) + "\n")
        rows, err = act_rows(led)
        check("an info row is not an act row", [r["uid"] for r in rows].count("17910") == 0)
        check("a re-read uid is ONE row, dated to its EARLIEST sighting",
              len([r for r in rows if r["uid"] == "17825"]) == 1 and
              iso([r for r in rows if r["uid"] == "17825"][0]["seen"]) == "2026-08-20T15:13:28Z",
              [r["key"] for r in rows if r["uid"] == "17825"])
        check("the key carries the first sighting, so a rolled UIDVALIDITY cannot collide",
              [r for r in rows if r["uid"] == "17825"][0]["key"] == "17825@2026-08-20T15:13:28Z")

        rs = d / "reply-state.json"
        rs.write_text(json.dumps({
            "135728677": {"employer": "Acme Robotics", "title": "Head of Eng",
                          "sent": "2026-08-20T15:33Z", "confirmed": True},
            "999": {"employer": "Beta Systems", "title": "Lead ML",
                    "sent": "2026-08-26T12:00Z", "confirmed": False},
        }))
        ridx = reply_index(rs)
        dis_p = d / "act-discharge.tsv"
        dis = discharges(dis_p)
        A = {r["uid"]: assess(r, dis, ridx, now, windows) for r in rows}

        check("a confirmed reply after the row DISCHARGES it", A["17825"]["state"] == "discharged",
              A["17825"]["state"])
        check("a SENT-but-unconfirmed reply does NOT discharge — a click is not an answer",
              A["17886"]["state"] == "sent-unconfirmed" and "never confirmed" in A["17886"]["why"],
              A["17886"]["state"])
        check("a row with no company is OVER, never quietly joined",
              A["17862"]["state"] == "over" and "cannot be joined" in A["17862"]["why"],
              A["17862"])
        check("a fresh code is open, an old code EXPIRES rather than ageing as a liability",
              A["17917"]["state"] == "open" and A["17802"]["state"] == "expired",
              (A["17917"]["state"], A["17802"]["state"]))
        check("an UNRECOGNISED act kind gets the tightest bound and says so",
              A["17902"]["state"] == "over" and A["17902"]["bound_h"] == UNKNOWN_KIND_BOUND
              and "UNRECOGNISED" in A["17902"]["bound_src"], A["17902"]["bound_src"])
        check("both ages are carried, and neither substitutes for the other",
              A["17862"]["age_h"] > 200 and A["17862"]["up_h"] is not None
              and "cal" in age_str(A["17862"]) and "up-h" in age_str(A["17862"]),
              age_str(A["17862"]))

        # up-hours must render `na`, never 0, when the boot record cannot be read
        na = assess(rows[0], dis, ridx, now, None)
        check("an unreadable boot record renders up-h `na`, never 0",
              na["up_h"] is None and "up-h na" in age_str(na), age_str(na))

        cov = coverage(rows, ridx)
        check("the machine leg publishes its own coverage over the corpus",
              (cov["non_code"], cov["named"], cov["joinable"]) == (5, 3, 2), cov)

        # the explicit lane
        rc = do_discharge("17862", "operator-handling", "он ведёт в TG", "genome@test", now,
                          rows_path=led, dis_path=dis_p)
        check("an explicit discharge writes an attributed row", rc == 0 and dis_p.exists())
        A2 = {r["uid"]: assess(r, discharges(dis_p), ridx, now, windows) for r in rows}
        check("and it clears the row it names, carrying who and why",
              A2["17862"]["state"] == "discharged" and "genome@test" in A2["17862"]["why"],
              A2["17862"])
        hand = d / "hand-edited.tsv"
        hand.write_text("2026-08-29T00:00:00Z\t17862\tsomeone\tanswered\tby hand\n")
        check("a hand-written BARE uid does not silence a row — only the full key discharges",
              assess([r for r in rows if r["uid"] == "17862"][0], discharges(hand), ridx, now,
                     windows)["state"] == "over")
        check("an unknown uid is REFUSED, never guessed at",
              do_discharge("40404", "answered", "", "t", now, led, dis_p) == 2)
        check("a bad verb is refused", do_discharge("17862", "handled-ish", "", "t", now, led, dis_p) == 2)

        # the loud line
        posts = []
        vals = list(A.values())
        txt = speak(vals, now, False, state_path=d / "alarm.json", emit=posts.append)
        check("an over-bound row is LOUD", txt is not None and len(posts) == 1)
        check("the loud line names WHICH row and HOW LONG, never a bare count",
              txt and "17862" in txt and "cal" in txt and "up-h" in txt, txt)
        check("the loud line never carries an expired code as a liability",
              txt and "17802" not in txt, txt)
        check("the loud line names how to discharge", txt and "--discharge" in txt)
        _real_run = subprocess.run
        try:
            subprocess.run = lambda *a, **k: (_ for _ in ()).throw(FileNotFoundError("no mesh-chat"))
            gone = speak(vals, now + 99 * H, True, state_path=d / "alarm-nochat.json")
            check("a missing mesh-chat does not kill the pass, and the cursor still advances",
                  gone is not None and (d / "alarm-nochat.json").exists())
        finally:
            subprocess.run = _real_run
        txt2 = speak(vals, now + 60, False, state_path=d / "alarm.json", emit=posts.append)
        check("a still-open row does not repost inside the throttle", txt2 is None and len(posts) == 1)
        txt3 = speak(vals, now + (THROTTLE_H + 0.1) * H, False, state_path=d / "alarm.json",
                     emit=posts.append)
        check("but it DOES repost after it — the defect was a push that scrolled away once",
              txt3 is not None and len(posts) == 2)

        # the denominator
        tape = d / "job-act.log"
        run_row(tape, vals, cov, None, now)
        check("a RUN row is written on a pass that had something open", tape.read_text().count("\tRUN\t") == 1)
        run_row(tape, [], {"non_code": 0, "named": 0, "joinable": 0}, None, now)
        check("and on a pass with NOTHING open — the silences are the denominator",
              tape.read_text().count("\tRUN\t") == 2)

        # honest blindness
        rows_b, err_b = act_rows(d / "does-not-exist.log")
        check("an unreadable ledger is an ERROR, not an empty corpus", rows_b is None and err_b)
        out = render(rows_b, cov, err_b, now)
        check("and it renders UNKNOWN, explicitly refusing the words «no incoming»",
              "UNKNOWN" in out and "NOT «no incoming»" in out, out)
        run_row(tape, [], cov, err_b, now)
        check("the blind pass still writes a row, marked UNKNOWN",
              "\tUNKNOWN\t" in tape.read_text())

        # a reply sent BEFORE the message cannot answer it
        rs.write_text(json.dumps({"1": {"employer": "Beta Systems",
                                        "sent": "2026-08-01T10:00Z", "confirmed": True}}))
        early = assess([r for r in rows if r["uid"] == "17886"][0], {}, reply_index(rs), now, windows)
        check("a reply sent BEFORE the row does not discharge it", early["state"] == "over",
              early["state"])

        # ---- THE DENOMINATOR. Everything above is about rows that ARE in the corpus; these are
        # about the corpus being short a leg, which is how one unplugged phone made eight days of
        # employer mail read as an empty inbox on 2026-08-29.
        class P:
            def __init__(self, rc=0, out="", err=""):
                self.returncode, self.stdout, self.stderr = rc, out, err
        clean = {"tape_present": True, "stale": False, "age_up_h": 0.1, "stale_bound_uph": 2.0,
                 "stale_bound_src": "tape-run-gaps(n=9)",
                 "lanes": {"yandex": {"state": "live"},
                           "gmail": {"state": "live"}}}
        dark = json.loads(json.dumps(clean))
        dark["lanes"]["gmail"] = {"state": "dark", "dark_uph": 87.2, "uph_is_floor": False,
                                  "dark_runs": 111, "last_live": now - 87.2 * 3600}
        check("two live legs are the ONLY thing that clears the intake",
              lane_degradation(lambda: P(0, json.dumps(clean)))[0] == [])
        dg = lane_degradation(lambda: P(0, json.dumps(dark)))[0]
        check("a dark leg names itself and how long it has been dark",
              len(dg) == 1 and dg[0].startswith("gmail DARK 87.2 up-h") and "111 run(s)" in dg[0],
              str(dg))
        # EVERY way of failing to establish the lane state must degrade, never clear: an empty
        # list is itself the assertion «both legs are delivering», and that is the assertion this
        # whole tract exists because nobody could make honestly.
        for label, runner in (
                ("the producer is not on PATH", lambda: (_ for _ in ()).throw(FileNotFoundError("x"))),
                ("the producer exits non-zero", lambda: P(2, "", "unrecognized arguments: --lanes")),
                ("the producer prints garbage", lambda: P(0, "not json")),
                ("there is no lane tape", lambda: P(0, json.dumps(dict(clean, tape_present=False)))),
                ("the reading is stale", lambda: P(0, json.dumps(dict(clean, stale=True, age_up_h=9.0)))),
                ("freshness is unmeasured", lambda: P(0, json.dumps(dict(clean, stale=None)))),
        ):
            got = lane_degradation(runner)[0]
            check("intake is UNKNOWN, never clear, when " + label,
                  len(got) == 1 and "UNKNOWN" in got[0], str(got))

        check("--quiet stops meaning silence the moment a leg is down — a silent pass is itself "
              "the claim that there was nothing to report",
              should_print(True, None, [], dg) and not should_print(True, None, [], []))
        check("and --quiet still speaks for the reasons it always did",
              should_print(True, "boom", [], []) and should_print(True, None, [{"state": "over"}], [])
              and should_print(False, None, [], []))
        check("a dark leg is NOT allowed to render as «nothing awaiting a hand»",
              "nothing awaiting a hand." not in render([], cov, None, now, dg)
              and "NOT «nothing came in»" in render([], cov, None, now, dg),
              render([], cov, None, now, dg).splitlines()[-1])
        check("with every leg delivering, the plain sentence is still the plain sentence",
              render([], cov, None, now, []).endswith("nothing awaiting a hand."))
        check("even an UNREADABLE ledger carries the leg that was down beside it",
              "INTAKE DEGRADED" in render(None, cov, "boom", now, dg))
        # the pane reads the TAPE, so the tape is where the degradation has to land — appended,
        # because mesh-dash cuts fields 4/5/6 off this row by position.
        rt = d / "intake-runtape.log"
        run_row(rt, [], cov, None, now, dg)
        f = rt.read_text().rstrip("\n").split("\t")
        check("the run row carries the intake as its LAST field, leaving 4/5/6 where they were",
              f[1] == "RUN" and f[4].startswith("oldest_over_h=") and f[5].startswith("join_cov=")
              and f[6].startswith("intake=gmail DARK"), str(f))
        run_row(rt, [], cov, None, now, [])
        check("and a clean intake is written explicitly, so a MISSING field 7 means an old row"
              " rather than a healthy one",
              rt.read_text().splitlines()[-1].split("\t")[6] == "intake=ok")

        r_out = render(vals, cov, None, now)
        check("a NAMED company absent from the reply tape counts as reachable-but-unanswered, "
              "never as discharged", A["17882"]["state"] == "over", A["17882"])
        check("the report leads with the join coverage, so a 2-of-5 leg cannot read as full",
              "reaches 2/5 non-code rows" in r_out and "(3 carry a company at all)" in r_out,
              r_out.splitlines()[:3])
    finally:
        tmp.cleanup()

    check("mesh-chat resolvable", __import__("shutil").which(CHAT) is not None)
    print("\n%d check(s), %d failed" % (
        len(FAILED) + sum(1 for _ in []) or 0, len(FAILED)) if False else
        ("smoke-test: ok — every act row is a standing liability that ages in the open until "
         "something EXPLICITLY discharges it; codes expire in their own family, an unknown kind "
         "fails LOUD, the one machine discharge leg publishes its own coverage, an unreadable "
         "ledger renders UNKNOWN and never «no incoming», and the RUN row is unconditional"
         if not FAILED else "FAILED: " + ", ".join(FAILED)))
    return 1 if FAILED else 0


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description="consumer of job-mail.log act rows")
    ap.add_argument("--tg", action="store_true", help="also push the loud line to the operator")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--quiet", action="store_true", help="print only when something is over its bound")
    ap.add_argument("--discharge", metavar="UID")
    ap.add_argument("--verb", choices=VERBS)
    ap.add_argument("--why", default="")
    ap.add_argument("--who", default=os.environ.get("MESH_WINDOW", "") or "hand@%s" % os.uname().nodename)
    ap.add_argument("--test", action="store_true")
    a = ap.parse_args()
    if a.test:
        return selftest()
    now = time.time()
    if a.discharge:
        if not a.verb:
            print("--discharge needs --verb (%s)" % "|".join(VERBS), file=sys.stderr)
            return 2
        return do_discharge(a.discharge, a.verb, a.why, a.who, now)

    rows, err = act_rows()
    windows = up_windows()
    ridx = reply_index()
    dis = discharges()
    assessed = [] if err else [assess(r, dis, ridx, now, windows) for r in rows]
    cov = coverage(rows or [], ridx) if not err else {"non_code": 0, "named": 0, "joinable": 0}
    degraded, _lane_err = lane_degradation()
    run_row(RUNTAPE, assessed, cov, err, now, degraded)
    if not err:
        # The dark-LEG line is mesh-job-mail's to speak — one owner per fact, or the operator gets
        # the same leg announced twice by two throttles that cannot see each other. What this tool
        # owes is that its own verdict can never be read as «nothing came in» while that is true.
        speak(assessed, now, a.tg)
    if a.json:
        print(json.dumps({"error": err, "coverage": cov, "intake_degraded": degraded,
                          "rows": [{k: v for k, v in r.items() if k != "gist"} for r in assessed]},
                         ensure_ascii=False, indent=1, default=str))
    elif should_print(a.quiet, err, assessed, degraded):
        print(render(assessed if not err else None, cov, err, now, degraded))
    return 2 if err else 0


if __name__ == "__main__":
    sys.exit(main())
