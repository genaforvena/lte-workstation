#!/usr/bin/env bash
# reflex-cadence: 23 */4 * * *
# reflex-args: --edge
# mesh-job-calls — the job lane's VOICE channel: unknown-number inbound calls on the resume phone.
#
# WHY THIS EXISTS. The job lane's inbound channel set was {hh.ru chat, mail, SMS} and voice was not
# in it, while the Redmi body carries the operator's RESUME number (+7 910 ..., senses 2026-08-29 —
# proven by an hh.ru confirmation code in that phone's own SMS corpus, not by the number's prefix).
# A recruiter who calls instead of writing was invisible to every organ the lane had.
#
# PRICED BEFORE IT WAS BUILT (discover 2026-08-29, {#4e22c884}), which is the only reason it is worth
# wiring: in the job window there were 3 unknown-number inbound events, and all three numbers
# cross-checked against the SAME device's 400-row SMS corpus gave ZERO matches. So this plane is
# INDEPENDENT of the SMS plane the mesh already reads — it is not a re-dating of it.
#
#   mesh-job-calls          human-readable verdict
#   mesh-job-calls --json   machine-readable
#   mesh-job-calls --edge   post to the board only when the verdict changes (the cron arm)
#   mesh-job-calls --test   smoke test (exit 2 = honest n/a: no ssh path to the body)
#
# FIVE TRAPS, all measured, all load-bearing here:
#
# TRAP-1  `-l N` BINDS SILENTLY. `-l 500` returned exactly 500 rows and looked like a full read; only
#         `-l 5000` showed the true 518-row horizon. A hardcoded `-l 50` renders a 9.7-month plane as
#         a two-week one with rc=0 and no error. So: ASK ABOVE THE CAP, and if the row count comes
#         back EQUAL to what we asked for, the horizon is OUR OWN ASK and the reading says so.
# TRAP-2  518 is the DEVICE's cap. Past that horizon, absence is UNKNOWN — never "no call". Every
#         reading publishes the window it stands for so no consumer can read it as all time.
# TRAP-3  THE REDMI's sshd FLAPS ON A MINUTES SCALE. Unreachable must render UNKNOWN, never an empty
#         call list — an empty list is a claim that nobody called. A REFUSAL (host up, daemon down)
#         and a TIMEOUT (path dead) are different facts and are reported as different words.
# TRAP-4  MISSED IS 51% OF THE PLANE (267/518 measured). A sense built on INCOMING alone sees about a
#         third of it, so every non-outgoing inbound type is counted and the split is published.
# TRAP-5  ATTRIBUTION IS NOT IN THE DATA. "unknown number" means "not in this phone's contacts", NOT
#         "a recruiter". The verdict publishes the SHAPE and the COUNT; numbers and names never reach
#         the board or the log. Where a number must be tracked across runs it is SALTED-HASHED, never
#         replaced by a constant placeholder — one placeholder for many numbers collapses them onto a
#         single key and one close would discharge them all.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no"
ASK="${MESH_JOB_CALLS_ASK:-5000}"; export ASK          # deliberately ABOVE the device cap — see TRAP-1
SINCE="${MESH_JOB_CALLS_SINCE:-${MESH_JOB_SINCE:-2026-08-15}}"; export SINCE
STATE="${MESH_DIR:-$HOME/.mesh}/.job-calls.state"
LEDGER="${MESH_DIR:-$HOME/.mesh}/job-calls.log"
MODE="${1:---plain}"

# The salt makes the per-number key node-local and non-reversible. Generated once; if it cannot be
# written the run still works, it just cannot correlate across runs — which it says rather than
# silently reusing a constant.
SALTFILE="${MESH_DIR:-$HOME/.mesh}/.job-calls.salt"
[ -s "$SALTFILE" ] || { mkdir -p "${SALTFILE%/*}" 2>/dev/null; head -c 32 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n' > "$SALTFILE" 2>/dev/null; }
SALT="$(cat "$SALTFILE" 2>/dev/null || echo NOSALT)"; export SALT

phone_addr(){
  local ip=""
  command -v mesh-phone-ip >/dev/null 2>&1 && ip="$(timeout 10 mesh-phone-ip 2>/dev/null)" || true
  [ -n "$ip" ] || ip="${MESH_PHONE_LAN_IP:-}"
  if [ -z "$ip" ]; then
    ip="$(printf '%s' "${MESH_NODES:-}" | tr ' ' '\n' | sed -n 's/^Redmi:.*@//p' | head -1)"
  fi
  printf '%s' "$ip"
}

# fetch: returns the raw JSON on stdout, and an EXPLAINED failure word on stderr. Never invents rows.
REACH=""; RAW=""
fetch(){
  local ip="$1" err rc
  err="$(mktemp)" || { REACH="unknown:no-tmp"; return 1; }
  RAW="$(timeout 45 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${ip}" \
         "termux-call-log -l $ASK" 2>"$err")"; rc=$?
  local e; e="$(tr -d '\r' < "$err" | tr '\n' ' ' | cut -c1-160)"; rm -f "$err"
  if [ $rc -eq 0 ] && [ -n "$RAW" ]; then REACH="ok"; return 0; fi
  case "$e$rc" in
    *"Connection refused"*) REACH="unknown:sshd-down (host answered, Termux sshd is not listening — the body is present, the daemon is not)";;
    *"timed out"*|*124)     REACH="unknown:path-dead (no answer on this path — a different claim from a refusal, and it is PER-PATH)";;
    *"Permission denied"*)  REACH="unknown:auth (our key is not accepted by the body)";;
    *)                      REACH="unknown:ssh-rc=$rc ${e:-no stderr}";;
  esac
  [ $rc -eq 0 ] && [ -z "$RAW" ] && REACH="unknown:empty-stdout (ssh succeeded and the organ printed nothing — NOT an empty call log)"
  return 1
}

IP="$(phone_addr)"
if [ -z "$IP" ]; then
  REACH="unknown:no-address (no Redmi address in mesh-phone-ip, MESH_PHONE_LAN_IP or MESH_NODES)"
elif [ "$MODE" != "--test" ]; then
  fetch "$IP" || true
fi

# classify: the whole judgement, fed the RAW json on stdin. Prints `k=v` lines. It never prints a
# number or a name — only counts, shapes and salted keys.
# The source lives in a VARIABLE and runs under `python3 -c`. It must NOT be a `python3 - <<EOF`
# heredoc: that form feeds the SCRIPT on stdin, so the piped call-log JSON never reaches
# sys.stdin.read() and every reading renders UNKNOWN — a tool that can only ever answer "I cannot
# read the organ", which is exactly the blindness this sense exists to prevent. Caught by its own
# TRAP-4 arm on the first run.
PY_CLASSIFY="$(cat <<'PY'
import json, os, sys, hashlib, re, datetime
ask   = int(os.environ.get("ASK", "5000"))
since = os.environ.get("SINCE", "2026-08-15")
salt  = os.environ.get("SALT", "NOSALT")
raw = sys.stdin.read()
def out(**kv):
    for k, v in kv.items():
        print("%s=%s" % (k, v))
try:
    rows = json.loads(raw)
    if not isinstance(rows, list):
        raise ValueError("not a list")
except Exception as e:
    # A SCHEMA WE CANNOT PARSE IS UNKNOWN, NEVER ZERO. The one thing this must never do is render an
    # unreadable organ as a quiet "no calls" — that is the plausible-constant failure this file's
    # whole trap list is about.
    out(state="UNKNOWN", reason="unparseable-json (%s)" % str(e)[:60], rows="na",
        window="na", inbound_unknown="na", missed="na", incoming="na", horizon="na")
    sys.exit(0)

def field(r, *names):
    for n in names:
        if n in r and r[n] not in (None, ""):
            return r[n]
    return ""

def parse_ts(s):
    s = str(s).strip()
    for f in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M"):
        try: return datetime.datetime.strptime(s[:19], f)
        except Exception: pass
    return None

n = len(rows)
# TRAP-1: the cap that BINDS SILENTLY. If we got back exactly what we asked for, the horizon is our
# own ask and not the device's — say so, because that reading looks identical to a complete one.
capped_by_us = (n == ask)
stamps = [t for t in (parse_ts(field(r, "date", "timestamp", "time")) for r in rows) if t]
oldest = min(stamps).isoformat() if stamps else "na"
newest = max(stamps).isoformat() if stamps else "na"
try:
    since_dt = datetime.datetime.strptime(since[:10], "%Y-%m-%d")
except Exception:
    since_dt = None

INBOUND = ("INCOMING", "MISSED", "REJECTED", "BLOCKED", "VOICEMAIL")
def typ(r): return str(field(r, "type", "call_type")).upper()

def is_unknown_number(r):
    # the SHAPE, and the ONLY shape the data supports: not in this phone's contacts. It is NOT
    # "a recruiter" — that attribution is not in the record and is never claimed. (TRAP-5)
    nm = str(field(r, "name", "display_name")).strip()
    return nm == "" or nm.lower() in ("unknown", "null", "none", "(unknown)")

win = [r for r in rows if (since_dt is None or (parse_ts(field(r, "date", "timestamp", "time")) or datetime.datetime.min) >= since_dt)]
inb = [r for r in win if typ(r) in INBOUND]
unk = [r for r in inb if is_unknown_number(r)]
# TRAP-4: MISSED is the majority of this plane, so the split is published, never folded into one
# "inbound" number that a reader would assume means answered.
missed   = len([r for r in unk if typ(r) == "MISSED"])
incoming = len([r for r in unk if typ(r) == "INCOMING"])
other    = len(unk) - missed - incoming
keys = []
for r in unk:
    num = str(field(r, "phone_number", "number")).strip()
    # salted hash, never a constant placeholder: one placeholder for many numbers collapses them
    # onto a single key and one close would discharge them all.
    keys.append(hashlib.sha256((salt + num).encode()).hexdigest()[:10] if num else "no-number")
distinct = len(set(keys))
if not rows:
    # An organ that answered with an EMPTY list is a real zero only if it really answered. That is
    # decided upstream by reachability; here it is reported as a zero WITH its window, so a reader
    # can see the window is empty too.
    out(state="EMPTY", reason="the organ returned zero rows", rows=0, window="na",
        inbound_unknown=0, missed=0, incoming=0, other=0, distinct=0, horizon="na",
        capped_by_our_ask="na")
    sys.exit(0)
state = "CALLS" if unk else "QUIET"
out(state=state,
    rows=n,
    capped_by_our_ask=("YES-ask=%d-THE-HORIZON-IS-OURS-NOT-THE-DEVICES" % ask) if capped_by_us else "no",
    horizon="%s..%s" % (oldest, newest),
    window="since=%s (absence BEFORE %s is UNKNOWN, not 'no call' — the device cap is a horizon)" % (since, oldest),
    inbound_unknown=len(unk), missed=missed, incoming=incoming, other=other,
    distinct=distinct,
    shape="unknown-number inbound = not in this phone's contacts; attribution is NOT in the data")
PY
)"
classify(){ python3 -c "$PY_CLASSIFY"; }

emit(){   # $1 = kv text
  local kv="$1" st
  st="$(printf '%s\n' "$kv" | sed -n 's/^state=//p' | head -1)"
  case "$MODE" in
    --json)
      printf '%s\n' "$kv" | python3 -c 'import sys,json; print(json.dumps(dict(l.split("=",1) for l in sys.stdin.read().splitlines() if "=" in l)))'
      ;;
    *)
      echo "mesh-job-calls: $st"
      printf '%s\n' "$kv" | sed 's/^/  /'
      ;;
  esac
}

# ---------------------------------------------------------------- smoke test
if [ "$MODE" = "--test" ]; then
  fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
  t="$(mktemp -d)" || fail "no scratch dir"
  trap 'rm -rf "$t"' EXIT INT TERM

  # 1) THE TRAP-4 ARM: MISSED is the majority of this plane. A classifier that counts INCOMING only
  #    sees a third of it, so a fixture whose unknown-number inbound is mostly MISSED must count them.
  cat > "$t/a.json" <<'EOF'
[{"name":"","phone_number":"+79990000001","type":"MISSED","date":"2026-08-21 00:26:00"},
 {"name":"","phone_number":"+79990000002","type":"INCOMING","date":"2026-08-24 03:21:00"},
 {"name":"","phone_number":"+79990000003","type":"MISSED","date":"2026-08-29 00:40:00"},
 {"name":"Мама","phone_number":"+79990000004","type":"INCOMING","date":"2026-08-25 10:00:00"},
 {"name":"","phone_number":"+79990000005","type":"OUTGOING","date":"2026-08-24 00:39:00"}]
EOF
  a="$(SINCE=2026-08-15 classify < "$t/a.json")"
  echo "$a" | grep -qx 'inbound_unknown=3' || fail "TRAP-4: unknown-number inbound is not 3 — a named contact, an OUTGOING, or the MISSED rows were miscounted: $(echo "$a"|tr '\n' ' ')"
  echo "$a" | grep -qx 'missed=2'   || fail "TRAP-4: MISSED is 51% of this plane and the split is not published — a sense built on INCOMING alone sees a third of it: $(echo "$a"|tr '\n' ' ')"
  echo "$a" | grep -qx 'incoming=1' || fail "TRAP-4: the INCOMING/MISSED split is wrong: $(echo "$a"|tr '\n' ' ')"
  # …and the CONTROL for that arm: a named contact must NOT be counted, or 'unknown number' means
  # nothing and every call the operator's mother makes reads as a recruiter.
  echo "$a" | grep -q 'inbound_unknown=4' && fail "TRAP-5 control: a NAMED contact was counted as an unknown number"

  # 2) TRAP-5: no number and no name may reach the output. This is the arm that keeps the organ
  #    publishable to a shared board.
  echo "$a" | grep -q '79990000' && fail "TRAP-5: a phone NUMBER reached the output — this verdict goes to a shared board"
  echo "$a" | grep -qi 'Мама'    && fail "TRAP-5: a contact NAME reached the output"
  echo "$a" | grep -qx 'distinct=3' || fail "distinct unknown callers not counted: $(echo "$a"|tr '\n' ' ')"

  # 3) TRAP-1: a read that returns exactly what we asked for is CAPPED BY OUR OWN ASK and must say
  #    so. It is byte-identical to a complete read otherwise, which is how -l 500 passed as full.
  python3 -c '
import json
print(json.dumps([{"name":"","phone_number":"+7999%07d"%i,"type":"MISSED","date":"2026-08-2%d 00:0%d:00"%(i%9,i%9)} for i in range(3)]))' > "$t/cap.json"
  c="$(MESH_JOB_CALLS_ASK=3 ASK=3 SINCE=2026-08-15 classify < "$t/cap.json")"
  echo "$c" | grep -q 'capped_by_our_ask=YES' || fail "TRAP-1: rows==ask and the reading does NOT say the horizon is our own ask — this is exactly how '-l 500 returned 500' read as a full 9.7-month plane: $(echo "$c"|tr '\n' ' ')"
  # CONTROL: under-cap must NOT claim capped, or the warning is unconditional and means nothing
  u="$(ASK=5000 SINCE=2026-08-15 classify < "$t/cap.json")"
  echo "$u" | grep -q 'capped_by_our_ask=no' || fail "TRAP-1 control: an UNDER-cap read claimed it was capped — the warning fires unconditionally and carries no information"

  # 4) TRAP-2: the window the reading stands for must travel WITH it, or a consumer reads a 2-week
  #    plane as all time and 'no call' becomes a claim the data cannot support.
  echo "$a" | grep -q '^horizon=' || fail "TRAP-2: no horizon published — absence past the device cap would read as 'no call'"
  echo "$a" | grep -q '^window=' || fail "TRAP-2: no window published"

  # 5) UNPARSEABLE MUST BE UNKNOWN, NEVER ZERO. The plausible-constant failure.
  b="$(printf 'not json at all' | classify)"
  echo "$b" | grep -qx 'state=UNKNOWN' || fail "an unparseable organ answer did not render UNKNOWN: $(echo "$b"|tr '\n' ' ')"
  echo "$b" | grep -q 'inbound_unknown=na' || fail "an unparseable answer rendered a NUMBER for inbound_unknown — a broken read must never wear a count: $(echo "$b"|tr '\n' ' ')"
  echo "$b" | grep -qx 'inbound_unknown=0' && fail "an unparseable answer rendered 0 calls — the plausible constant this whole tool is built against"

  # 6) TRAP-3, driven against the REAL body: unreachable must be UNKNOWN with a REASON, and a
  #    refusal must be worded differently from a timeout. This arm runs live.
  ip="$(phone_addr)"
  if [ -n "$ip" ]; then
    if fetch "$ip"; then
      # THE BODY ANSWERED — assert a REAL hardware read, not just the offline classifier.
      # Reachability is not producing (a sensor's --test must assert a real read).
      r="$(printf '%s' "$RAW" | classify)"
      echo "$r" | grep -q '^state=' || fail "live read: the organ answered but produced no state"
      echo "$r" | grep -qx 'state=UNKNOWN' && fail "live read: the body answered and the classifier could not parse it — schema drift: $(echo "$r"|tr '\n' ' ')"
      echo "smoke-test: ok (live read from the body: $(echo "$r" | sed -n 's/^rows=//p') rows)"
      exit 0
    fi
    case "$REACH" in
      unknown:*) : ;;
      *) fail "TRAP-3: an unreachable body did not render an unknown:* word (got '$REACH') — an empty call list is a claim that nobody called" ;;
    esac
    case "$REACH" in
      *sshd-down*|*path-dead*|*auth*|*ssh-rc=*) : ;;
      *) fail "TRAP-3: the unreachable word carries no REASON ('$REACH') — a refusal and a timeout are different facts with different remedies" ;;
    esac
    echo "smoke-test: ok (offline arms green; body unreachable — $REACH)"
    exit 2   # honest n/a: no ssh path to the body, so autowire SKIPs this node
  fi
  echo "smoke-test: ok (offline arms green; no body address on this node)"
  exit 2
fi

# ---------------------------------------------------------------- live path
if [ "$REACH" != "ok" ]; then
  KV="state=UNKNOWN
reason=$REACH
rows=na
inbound_unknown=na
missed=na
incoming=na
horizon=na
window=na"
else
  KV="$(printf '%s' "$RAW" | classify)"
fi
emit "$KV"

ST="$(printf '%s\n' "$KV" | sed -n 's/^state=//p' | head -1)"
SIG="$(printf '%s\n' "$KV" | sed -n 's/^inbound_unknown=//p;s/^state=//p' | tr '\n' '/')"
printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$ST" "$(printf '%s\n' "$KV" | tr '\n' ' ')" >> "$LEDGER" 2>/dev/null
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1

if [ "$MODE" = "--edge" ]; then
  PREV="$(cat "$STATE" 2>/dev/null || echo)"
  if [ "$SIG" != "$PREV" ]; then
    printf '%s' "$SIG" > "$STATE" 2>/dev/null
    if command -v mesh-chat >/dev/null 2>&1 && [ "$ST" = "CALLS" ]; then
      MESH_WHO="job-calls@$(hostname)" mesh-chat "[fyi] mesh-job-calls: $(printf '%s\n' "$KV" | sed -n 's/^inbound_unknown=/unknown-number inbound /p') in the job window ($(printf '%s\n' "$KV" | sed -n 's/^missed=/missed /p'), $(printf '%s\n' "$KV" | sed -n 's/^incoming=/answered /p')) on the resume phone — SHAPE only, attribution is not in the data; $(printf '%s\n' "$KV" | sed -n 's/^window=//p')" >/dev/null 2>&1 || true
    fi
  fi
fi
case "$ST" in UNKNOWN) exit 2;; *) exit 0;; esac
