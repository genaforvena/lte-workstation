#!/usr/bin/env python3
"""Deterministic CV visibility and incoming-message policy gate.

The HH browser leg supplies probe JSON; this tool decides only what the evidence permits.
It never treats a login redirect as hidden/visible and never sends employer messages.
"""
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


def fail(message):
    print("REFUSED: " + message)
    return 2


def iso(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def check_probe(path):
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    state = data.get("state")
    if state == "LOGGED_OUT" or data.get("redirect"):
        print("status=UNKNOWN timestamp=%s route=%s reason=%s ranking_claim=none" %
              (data.get("timestamp", "missing"), data.get("route", "missing"), data.get("reason", "login redirect")))
        return 0
    if state != "AUTHENTICATED":
        print("status=UNKNOWN timestamp=%s route=%s reason=%s ranking_claim=none" %
              (data.get("timestamp", "missing"), data.get("route", "missing"), data.get("reason", "unclassified probe")))
        return 0
    required = ("timestamp", "route", "options", "evidence", "sha256")
    missing = [key for key in required if key not in data]
    if missing or not isinstance(data["options"], list):
        return fail("authenticated probe missing " + ",".join(missing or ["options"]))
    digest = data["sha256"]
    if len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest.lower()):
        return fail("evidence sha256 is not a digest")
    selected = [o.get("label", "") for o in data["options"] if o.get("selected")]
    print("status=AUTHENTICATED timestamp=%s route=%s setting=%s options=%d evidence=%s sha256=%s ranking_claim=none" %
          (data["timestamp"], data["route"], selected[0] if selected else "UNKNOWN",
           len(data["options"]), data["evidence"], data["sha256"]))
    return 0


def maintenance(args):
    if args.state != "AUTHENTICATED":
        return fail("maintenance requires AUTHENTICATED state; UNKNOWN cannot authorize an edit")
    if args.before != args.after:
        return fail("before/after mismatch: reread did not prove the requested setting")
    if args.after != args.target:
        return fail("rendered target option is absent or was not selected")
    now = iso(args.now)
    rows = []
    if Path(args.history).exists():
        rows = [json.loads(line) for line in Path(args.history).read_text(encoding="utf-8").splitlines() if line.strip()]
    reads = [r for r in rows if r.get("resume") == args.resume and r.get("action") == "read"
             and r.get("state") == "AUTHENTICATED" and r.get("setting") == args.before]
    if len(reads) < 2:
        return fail("two-read baseline is not established")
    actions = [r for r in rows if r.get("resume") == args.resume and r.get("action") == "visibility"]
    if actions:
        age = now - max(iso(r["at"]) for r in actions)
        if age.total_seconds() < 7 * 24 * 3600:
            return fail("7-day maintenance limit is active")
    print("ALLOW maintenance resume=%s target=%s baseline_reads=%d" % (args.resume, args.target, len(reads)))
    return 0


def track_messages(args):
    incoming = json.loads(Path(args.input).read_text(encoding="utf-8"))
    existing = []
    if Path(args.ledger).exists():
        existing = [json.loads(line) for line in Path(args.ledger).read_text(encoding="utf-8").splitlines() if line.strip()]
    seen = {r.get("id") for r in existing}
    batch = set()
    bad = []
    for row in incoming:
        mid = row.get("id")
        if not mid or mid in seen or mid in batch:
            bad.append("duplicate=" + str(mid))
            continue
        batch.add(mid)
        if row.get("actionable") and row.get("disposition") == "retry" and not row.get("retry_at"):
            bad.append("retryable message %s missing retry_at" % mid)
    if bad:
        print("; ".join(bad))
        for row in incoming:
            if row.get("disposition") == "retry" and row.get("retry_at"):
                print("retry_at=%s" % row["retry_at"])
        return 2
    with Path(args.ledger).open("a", encoding="utf-8") as out:
        for row in incoming:
            out.write(json.dumps(row, ensure_ascii=False) + "\n")
    print("recorded=%d duplicate=none" % len(incoming))
    return 0


def selftest():
    print("PASS: cv visibility policy executable loaded")
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check")
    ap.add_argument("--maintenance-check", action="store_true")
    ap.add_argument("--track-messages", action="store_true")
    ap.add_argument("--history")
    ap.add_argument("--input")
    ap.add_argument("--ledger")
    ap.add_argument("--resume")
    ap.add_argument("--now")
    ap.add_argument("--state")
    ap.add_argument("--target")
    ap.add_argument("--before")
    ap.add_argument("--after")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()
    if args.check:
        return check_probe(args.check)
    if args.maintenance_check:
        return maintenance(args)
    if args.track_messages:
        return track_messages(args)
    ap.error("choose --check, --maintenance-check, --track-messages, or --test")


if __name__ == "__main__":
    sys.exit(main())
