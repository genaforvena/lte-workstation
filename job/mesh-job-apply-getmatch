def parse_daily_cap(raw):
    """Return an integer cap or None for the explicit unlimited mode."""
    value = (raw or "").strip().lower()
    if value in ("unlimited", "none", "off"):
        return None
    try:
        cap = int(value)
    except ValueError:
        raise ValueError("MESH_JOB_DAILY_CAP must be a non-negative integer or unlimited")
    if cap < 0:
        raise ValueError("MESH_JOB_DAILY_CAP must be a non-negative integer or unlimited")
    return cap


