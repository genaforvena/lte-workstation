VAC_RE = re.compile(r"getmatch\.ru/vacancies/(\d+)")

# Маленькие целые, а не модель: это сортировочный ключ, и он ничего не ДОПУСКАЕТ.
FIT = [(re.compile(r"(?<!\w)go(?!\w)|golang", re.I), 6),
       (re.compile(r"rtb|dsp|programmatic|adtech|реклам|adblogger", re.I), 5),
       (re.compile(r"backend|бэкенд|платформ|platform|highload|нагруз", re.I), 3),
       (re.compile(r"kafka|clickhouse|dwh|биллинг", re.I), 2),
       (re.compile(r"android|ios|frontend|фронт|php|1c|1с|qa|тестирован", re.I), -4)]


def fit(title):
    return sum(w for rx, w in FIT if rx.search(title or ""))


def getmatch_auth_state(url, text):
    """Classify the page before any irreversible getmatch submission click."""
    if "/applications" not in (url or ""):
        return "logged-out"
    if re.search(r"\b(?:Войти|Зарегистрироваться)\b", text or "") and not re.search(
            r"\b(?:Выйти|Мои отклики|Отклики)\b", text or "", re.I):
        return "logged-out"
    return "ok"


def vacancy_page_state(text):
    """Classify a vacancy page before filling or clicking an application form."""
    text = text or ""
    if re.search(r"Вакансия\s+в\s+архиве|Компания\s+больше\s+не\s+ищет", text, re.I):
        return "closed"
    if re.search(r"Откликнуться", text, re.I):
        return "open"
    return "unknown"


def preflight_outcome(page_state):
    """Classify a vacancy page without turning machine-verifiable closure into a handoff."""
    if page_state == "closed":
        return "dropped", "вакансия уже в архиве — отклик не отправлялся"
    if page_state != "open":
        return "error", "vacancy page has no confirmed Откликнуться control — no form click made"
    return "open", ""


def location_fill_command(city):
    # Typing the city only renders a suggestion; the form keeps locationId empty until the
    # suggestion is selected, and Getmatch silently ignores the submit in that state.
    return ("fill input[placeholder^='Укажите'] %s\n"
            "clicktext %s, Россия") % (city, city)




def sh(args, timeout=120, inp=None):
    return subprocess.run(args, capture_output=True, text=True, timeout=timeout, input=inp)


def drive(lines, timeout=180):
    env = dict(os.environ, HH_PROFILE=PROFILE)
    command = [DRIVE, "--run", "\n".join(lines)]
    p = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, env=env, start_new_session=True)
    try:
        out, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        out, err = p.communicate()
        return subprocess.CompletedProcess(command, 124, out, err or "timed out")
    return subprocess.CompletedProcess(command, p.returncode, out, err)


def drive_wait(marker, secs=180):
    """mesh-hh-drive --wait greps the WHOLE log, and the log is APPEND-ONLY.

    So a marker that appeared during ANY earlier run is already there, and the wait returns
    instantly without the current command having run at all. On this tool's own first real batch
    application #1 wrote '"done":1', so from #2 onward every wait was satisfied by #1's line and
    the code then read whatever happened to be in the log tail.

    (The failure is the MARKER, not a backlog: the daemon tracks a line INDEX into an append-only
    command file, so a 196-line file is history, not a queue — a first reading of it as a backlog
    was wrong and is recorded here so the next reader does not re-derive it. The race is small but
    real, and its direction is toward a false 'not confirmed' rather than a false 'sent', because
    a stale applications dump cannot contain a title that was only just submitted.)

    The cure is the caller's, not the driver's: every marker must be UNIQUE TO THIS CALL. An
    ever-happened indicator is monotone, so waiting alone eventually satisfies it —
    [[an-ever-happened-indicator-is-monotone-so-its-p-is-reached-by-waiting]]."""
    env = dict(os.environ, HH_PROFILE=PROFILE)
    return subprocess.run([DRIVE, "--wait", marker, str(secs)], capture_output=True, text=True,
                          timeout=secs + 30, env=env)


# Cron starts a fresh process on every run. A per-process counter alone therefore repeats after
# every invocation, and `mesh-hh-drive --wait` can satisfy a new verification with an old log line.
# Include process and monotonic-start entropy so a marker is unique across all runs sharing the
# append-only driver log.
_TOKEN = [0]
_TOKEN_NAMESPACE = "%d-%d" % (os.getpid(), time.time_ns())


def token(kind, vid):
    """A marker no earlier run can carry, including runs from older cron processes."""
    _TOKEN[0] += 1
    return "MJAG-%s-%s-%s-%d" % (_TOKEN_NAMESPACE, kind, vid, _TOKEN[0])


DRIVE_LOG = MESH / "job" / ("%s-drive.log" % PROFILE)


def log_size():
    try:
        return DRIVE_LOG.stat().st_size
    except OSError:
        return 0


def log_since(mark):
    """Хвост лога драйвера ОТ ЗАПИСАННОГО СМЕЩЕНИЯ, а не последние N строк.

    `--peek 6` было на грани: одна лишняя строка драйвера (`>>> goto`, `[url]`, `>>> wait`,
    `>>> js`, `[js] ...` — уже пять) выталкивала токен проверки из окна, и вердикт «маркер
    проверки не в хвосте лога» получали прогоны, чей токен в логе БЫЛ. Окно, размер которого
    выбран на глаз, измеряет болтливость драйвера, а не факт. Смещение — измеряет факт."""
    try:
        with DRIVE_LOG.open("rb") as f:
            f.seek(mark)
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def getmatch_auth_preflight():
    """Read the applications page and refuse all submission clicks when it redirects."""
    env = dict(os.environ, HH_PROFILE=PROFILE)
    alive = subprocess.run([DRIVE, "--alive"], capture_output=True, text=True,
                           timeout=10, env=env)
    if alive.returncode != 0:
        try:
            started = subprocess.run([DRIVE, "--start"], capture_output=True, text=True,
                                     timeout=30, env=env, start_new_session=True)
        except subprocess.TimeoutExpired:
            return "unknown", "getmatch driver start timed out"
        if started.returncode != 0:
            return "unknown", "getmatch driver did not start"
    marker = token("auth", "preflight")
    mark = log_size()
    result = drive([
        "goto https://getmatch.ru/applications",
        "wait 6000",
        "js JSON.stringify({t:'%s',url:location.href,text:(document.body.innerText||'').slice(0,4000)})" % marker,
    ], timeout=45)
    if result.returncode != 0:
        return "unknown", "getmatch auth preflight driver failed"
    deadline = time.monotonic() + 45
    while time.monotonic() < deadline:
        for line in log_since(mark).splitlines():
            if not line.startswith("[js] "):
                continue
            try:
                payload = json.loads(line[5:])
            except json.JSONDecodeError:
                continue
            if payload.get("t") != marker:
                continue
            state = getmatch_auth_state(payload.get("url", ""), payload.get("text", ""))
            if state == "logged-out":
                return state, "getmatch redirected from /applications; no submission clicks made"
            return state, "getmatch applications page read successfully"
        time.sleep(0.5)
    return "unknown", "getmatch auth payload not found in fresh driver log"


def fresh_log_marker(mark, marker, timeout=90):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if marker in log_since(mark):
            return True
        time.sleep(0.5)
    return False


def applications_has_id(payload, vacancy_id):
    """Accept a submission only when the applications DOM contains the exact vacancy href."""
    if not isinstance(payload, dict):
        return False
    wanted = str(vacancy_id)
    for href in payload.get("hrefs", []) or []:
        # Live application links are canonicalized with a slug after the numeric ID.
        match = re.search(r"/vacancies/(\d+)(?:[-/?#]|$)", href or "")
        if match and match.group(1) == wanted:
            return True
    return False


def drive_log_tail(n=40):
    env = dict(os.environ, HH_PROFILE=PROFILE)
    r = subprocess.run([DRIVE, "--peek", str(n)], capture_output=True, text=True, timeout=120, env=env)
    return r.stdout or ""


def blacklisted(employer, title):
    """Тонкая обёртка над файлом чёрного списка. Полная семантика (kind, allow:, слово-vs-подстрока)
    живёт в mesh-job-apply; здесь нужен только ОТВЕТ да/нет, и он обязан ошибаться в сторону ОТКАЗА:
    Foxible — прямой запрет оператора («ни в коем случае, я только что там работал»)."""
    if not BLACKLIST.exists():
        return None
    hay = (employer + " " + title).lower()
    allows, hits = [], []
    for l in BLACKLIST.read_text(encoding="utf-8").splitlines():
        l = l.strip()
        if not l or l.startswith("#"):
            continue
        kind, _, rest = l.partition(":")
        kind, pat = kind.strip().lower(), rest.strip().lower()
        if not pat:
            kind, pat = "rule", l.lower()
        (allows if kind == "allow" else hits).append((kind, pat))
    for _, pat in allows:
        if pat in hay:
            return None
    for kind, pat in hits:
        if kind == "former":
            if re.search(r"(?<!\w)%s(?!\w)" % re.escape(pat), employer.lower()):
                return "бывший работодатель (%s)" % pat
        elif pat in hay:
            return "%s (%s)" % (kind, pat)
    return None


def bank(question):
    """-> строка ответа | None. rc 2 = банк не знает, и это БЛОКИРУЕТ отклик, а не подставляет
    умолчание: поле, которого мы не знаем, — его факт, а не наша догадка."""
    r = sh([ANSWERS, "--match", question], timeout=60)
    return (r.stdout or "").strip() if r.returncode == 0 and (r.stdout or "").strip() else None


def sent_today():
    if not LEDGER.exists():
        return 0
    today = time.strftime("%Y-%m-%d")
    return sum(1 for l in LEDGER.read_text(encoding="utf-8").splitlines() if l.startswith(today))


def rows():
    """-> [row dict] строк getmatch в состоянии seen. Индекс строки несётся с собой: состояние
    правится ПО НОМЕРУ, а не поиском по тексту, иначе две вакансии с одним названием сольются."""
    if not BOARD.exists():
        return []
    out = []
    for i, l in enumerate(BOARD.read_text(encoding="utf-8").splitlines()):
        f = l.split("\t")
        if len(f) < 6 or f[4] != "seen":
            continue
        # A timeout or an unconfirmed post-submit click is not permission to click again: the
        # first attempt may have reached the employer even when verification could not read it.
        # Keep that row visible for exact-ID reconciliation, but remove it from autonomous retry.
        if retry_blocked(f[5]):
            continue
        m = VAC_RE.search(f[3])
        if not m:
            continue
        out.append({"i": i, "date": f[0], "employer": f[1], "title": f[2], "url": f[3],
                    "note": f[5], "id": m.group(1)})
    return out


def retry_blocked(note):
    """Unknown post-submit state is reconciliation work, never an automatic second click."""
    note_lower = (note or "").lower()
    return "состояние неизвестно" in note_lower or "отправка не подтверждена" in note_lower


def eligible(rs):
    """-> (picked, blocked). Отказ возвращается ВМЕСТЕ с выбором: имя, отсеянное молча, оператор
    встречает только тогда, когда оно уже ушло работодателю под его подписью."""
    # ПОРЯДОК — здесь и только здесь вес уместен: допуск уже решён предикатами выше, а место
    # работодателя в партии ОДНО, и без сортировки его занимает та строка, которая раньше легла на
    # доску. Замерено: у Сбера так выигрывал «Tech lead в Центр Робототехники», а «Team Lead Go
    # (GigaChat)» — его стек буквально — не подавался вовсе. Порядок доски не есть порядок
    # соответствия.
    # Fresh scans must outrank stale board rows: an older high-fit vacancy is often already
    # archived by the time the browser reaches it. Fit still breaks ties within the same scan.
    rs = sorted(rs, key=lambda r: (r.get("date", ""), fit(r["title"])), reverse=True)
    picked, blocked, seen_emp = [], [], set()
    for r in rs:
        bl = blacklisted(r["employer"], r["title"])
        if bl:
            blocked.append((r, bl)); continue
        okrole, why = ROLES.role_verdict(r["title"], r["employer"])
        if not okrole:
            blocked.append((r, why)); continue
        key = r["employer"].strip().lower()
        if key in seen_emp:
            blocked.append((r, "место работодателя занято в этой партии")); continue
        seen_emp.add(key)
        picked.append(r)
    return picked, blocked


def letter_for(r):
    """-> текст | None. mesh-job-letter выходит с 3, когда вакансия ему не по зубам — это НЕ
    ошибка, это отказ отправить общее письмо, и он обязан остаться отказом."""
    vac = "%s @ %s\n%s" % (r["title"], r["employer"], r["note"])
    p = subprocess.run([LETTER, "--vacancy", "-"], capture_output=True, text=True,
                       timeout=120, input=vac)
    if p.returncode != 0:
        return None
    body = [l for l in (p.stdout or "").splitlines() if not l.startswith("[blocks]")]
    return "\n".join(body).strip() or None


def paragraphs(text):
    return [x.strip() for x in re.split(r"\n\s*\n", text) if x.strip()]


def letter_outcome(text):
    """A missing verified letter is a machine-side fit rejection, not an operator handoff."""
    if not text:
        return "dropped", "проверенное письмо не собралось — вакансия не подходит профилю"
    return "open", ""


def apply_one(r, floor, city, dry=False):
    """-> (state, detail). Состояний три и третье не 'нет': sent | needs-human | error."""
    text = letter_for(r)
    letter_state, letter_detail = letter_outcome(text)
    if letter_state != "open":
        return letter_state, letter_detail
    if dry:
        return "dry-run", "письмо готово (%d абзац(ев)), ничего не отправлено" % len(paragraphs(text))

    paras = paragraphs(text)
    probe = token("page", r["id"])
    mark = log_size()
    probe_run = drive(["goto %s" % r["url"], "wait 5000",
                       "js JSON.stringify({t:'%s',text:(document.body.innerText||'').slice(0,8000)})" % probe],
                      timeout=90)
    if probe_run.returncode != 0 or not fresh_log_marker(mark, probe, 90):
        return "error", "vacancy page preflight did not complete — no form click made"
    payload = None
    for line in log_since(mark).splitlines():
        if line.startswith("[js] ") and probe in line:
            try:
                payload = json.loads(line[5:])
            except json.JSONDecodeError:
                pass
            break
    if not payload:
        return "error", "vacancy page preflight marker was not readable — no form click made"
    page_state = vacancy_page_state(payload.get("text", ""))
    preflight_state, preflight_detail = preflight_outcome(page_state)
    if preflight_state != "open":
        return preflight_state, preflight_detail
    cmds = ["clicktext Откликнуться", "wait 4000",
            "fill input[placeholder='От'] %s" % floor, "wait 1000"]
    if city:
        cmds += [location_fill_command(city), "wait 1500"]
    cmds += ["fill textarea %s" % paras[0].replace("\n", " ")]
    for p in paras[1:]:
        cmds += ["press Enter", "press Enter", "type textarea %s" % p.replace("\n", " ")]
    sub_tok = token("sub", r["id"])
    cmds += ["wait 1500", "clicktext Отправить отклик", "wait 6000",
             "js JSON.stringify({t:'%s',url:location.href})" % sub_tok]
    drive(cmds, timeout=300)
    if drive_wait(sub_tok, 300).returncode != 0:
        return "error", "драйвер не дошёл до отправки за 300s — состояние НЕИЗВЕСТНО, не 'не отправлено'"

    # КЛИК — НЕ ОТПРАВКА. Засчитываем только то, что видно в ЕГО списке откликов.
    ver_tok = token("ver", r["id"])
    mark_v = log_size()
    drive(["goto https://getmatch.ru/applications", "wait 6000",
           "js JSON.stringify({t:'%s',apps:(document.body.innerText||'').slice(0,4000),hrefs:Array.from(document.querySelectorAll('a[href*=\"/vacancies/\"]')).map(a=>a.href)})" % ver_tok],
          timeout=200)
    if drive_wait(ver_tok, 300).returncode != 0:
        return "error", "список откликов не прочитан за 300s — состояние НЕИЗВЕСТНО, не 'не отправлено'"
    tail = log_since(mark_v)
    if ver_tok not in tail:
        return "error", "маркер проверки не в логе после нашей же команды — читаю не ту запись, отказываюсь судить"
    payload_v = None
    for line in tail.splitlines():
        if line.startswith("[js] ") and ver_tok in line:
            try:
                payload_v = json.loads(line[5:])
            except json.JSONDecodeError:
                pass
            break
    if applications_has_id(payload_v, r["id"]):
        return "sent", "подтверждено списком откликов на getmatch"
    return "error", "клик прошёл, но exact ID вакансии НЕТ в списке откликов — отправка НЕ подтверждена"


def record(r, state, detail, text):
    lines = BOARD.read_text(encoding="utf-8").split("\n")
    f = lines[r["i"]].split("\t")
    if len(f) >= 6:
        f[4] = state if state in ("sent", "needs-human", "dropped") else f[4]
        f[5] = "%s: %s || %s" % (time.strftime("%Y-%m-%d"), detail, f[5])
        lines[r["i"]] = "\t".join(f)
        BOARD.write_text("\n".join(lines), encoding="utf-8")
    if state != "sent":
        return
    with LEDGER.open("a", encoding="utf-8") as fh:
        fh.write("%s\t%s\t%s\t%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                       r["id"], r["employer"], r["title"]))
    SENT.mkdir(parents=True, exist_ok=True)
    (SENT / ("%s-getmatch-%s.md" % (time.strftime("%Y-%m-%d"), r["id"]))).write_text(
        "# %s — %s\n\n- %s\n- отправлено %s через getmatch, ПОДТВЕРЖДЕНО списком откликов\n\n"
        "## Текст\n\n%s\n" % (r["employer"], r["title"], r["url"],
                              time.strftime("%Y-%m-%d"), text or ""), encoding="utf-8")


def selftest():
    fails = []

    def check(name, ok, extra=""):
        print("%s %s%s" % ("ok:  " if ok else "FAIL:", name, ("  <- " + extra) if extra and not ok else ""))
        if not ok:
            fails.append(name)

    mk = lambda i, e, t: {"i": i, "date": "d", "employer": e, "title": t,
                          "url": "https://getmatch.ru/vacancies/%d" % i, "note": "", "id": str(i)}

    # ДОПУСК — предикат, и обе половины обязаны совпасть В НАЗВАНИИ.
    got, blk = eligible([mk(1, "LLC ОпенМайГейм", "Head of QA"),
                         mk(2, "LLC MOLLIS", "Руководитель отдела продаж / Head of Sales"),
                         mk(3, "VK", "Senior Go Developer"),
                         mk(4, "UNIREST", "Руководитель группы разработки")])
    # НЕ Т-Банк в этой фикстуре, и это не косметика: он лежит в blacklist.txt строкой
    # `dedup: т-банк`, поэтому проходил бы отбор ПО ДРУГОЙ причине и нога стала бы вакуумной —
    # зелёной независимо от того, работает ли предметный гейт.
    check("руководящая роль без предметной области НЕ проходит",
          [r["id"] for r in got] == ["3", "4"], repr([r["id"] for r in got]))
    check("...и чёрный список НЕ участвовал в этом решении (нога не вакуумна)",
          blacklisted("UNIREST", "Руководитель группы разработки") is None)
    # IC-лейн ОТКРЫТ обратно (оператор 2026-08-26, «как минимум на позиции сеньора»). Эта нога
    # раньше утверждала обратное — и утверждала верно для своего дня; менять её здесь обязательно,
    # иначе гейт остался бы зелёным ровно на том, что оператор велел перестать резать.
    check("...и инженерная роль БЕЗ руководящего слова ПРОХОДИТ (IC-лейн открыт, не ниже сеньора)",
          any(r["id"] == "3" for r in got))
    check("...а грейд ниже сеньора не проходит и на IC-ветке",
          ROLES.role_verdict("Junior Go-разработчик")[1] == "грейд ниже сеньора")
    check("...и отказ несёт ПРИЧИНУ, а не просто отсутствие в выборе",
          all(reason for _, reason in blk))

    old = mk(30, "Old", "Senior Go Developer highload RTB")
    old["date"] = "2026-08-25"
    fresh = mk(31, "Fresh", "Team Lead Go")
    fresh["date"] = "2026-09-07"
    got_recent, _ = eligible([old, fresh])
    check("свежая вакансия опережает старую даже при большем fit старой",
          got_recent and got_recent[0]["id"] == "31", repr([r["id"] for r in got_recent]))

    # ПОРЯДОК внутри одного работодателя: место одно, и его должна занять подходящая строка,
    # а не та, что раньше легла на доску.
    gotf, _ = eligible([mk(20, "Сбер", "Tech lead в Центр Робототехники"),
                        mk(21, "Сбер", "Team Lead Go (GigaChat)")])
    check("внутри одного работодателя место занимает БОЛЕЕ подходящая строка, не более ранняя",
          [r["id"] for r in gotf] == ["21"], repr([r["id"] for r in gotf]))

    # Одно место на работодателя за партию.
    got2, blk2 = eligible([mk(5, "Сбер", "Team Lead Go (GigaChat)"),
                           mk(6, "Сбер", "Team Lead команды RAG-платформы")])
    check("одно место на работодателя за партию", [r["id"] for r in got2] == ["5"])
    check("...и второй отсеян именно как дедуп",
          any("место работодателя" in reason for _, reason in blk2))

    # Чёрный список: прямой запрет оператора обязан пережить любой регистр.
    for spell in ("Foxible", "foxible ltd", "FOXIBLE"):
        check("Foxible НЕ проходит (%s)" % spell,
              blacklisted(spell, "Team Lead Go") is not None)
    check("контрольная компания проходит", blacklisted("Ozon Банк", "Team Lead Go") is None)
    got3, _ = eligible([mk(7, "Foxible", "Руководитель группы разработки")])
    check("...и в выбор он не попадает даже с идеальным названием", got3 == [])

    # КРАСНАЯ половина допуска: строка, несущая ОБЕ половины, обязана пройти.
    got4, _ = eligible([mk(8, "Yadda", "Head of Engineering")])
    check("роль с обеими половинами ПРОХОДИТ (gate seen open)", [r["id"] for r in got4] == ["8"])

    # РАЗДЕЛЕНИЕ КЛАССОВ. Инженерный титул несёт область в себе; голый ранг — нет.
    got5, blk5 = eligible([mk(9, "Крупный банк", "Principal Tech Lead, домен Retail"),
                           mk(10, "Сбер", "Tech lead в Центр Робототехники"),
                           mk(11, "LLC Суперлига", "Head of Legal"),
                           mk(12, "IE Магер", "Руководитель отдела продаж (РОП) d2d")])
    check("инженерный титул проходит БЕЗ отдельного предметного слова",
          sorted(r["id"] for r in got5) == ["10", "9"], repr([r["id"] for r in got5]))
    check("...а голый ранг без области по-прежнему НЕ проходит",
          all("голый ранг" in reason for r, reason in blk5 if r["id"] in ("11", "12")),
          repr([(r["id"], reason) for r, reason in blk5]))

    # МАРКЕР ОЖИДАНИЯ обязан быть уникален для ВЫЗОВА: лог драйвера append-only, и --wait грепает
    # его целиком, поэтому маркер из прошлого прогона удовлетворяет ожидание мгновенно.
    a, b = token("sub", "111"), token("sub", "111")
    check("два маркера подряд для ОДНОЙ вакансии различаются", a != b, "%s == %s" % (a, b))
    check("маркер несёт id вакансии", "111" in a)
    check("маркер не является подстрокой ранее выданного", a not in b and b not in a)
    check("unknown submission is excluded from autonomous retry",
          retry_blocked("клик прошёл — состояние НЕИЗВЕСТНО"))
    check("ordinary seen row remains retry-eligible", not retry_blocked("новая вакансия"))
    check("applications verifier accepts exact vacancy href",
          applications_has_id({"hrefs": ["https://getmatch.ru/vacancies/36113"]}, "36113"))
    check("applications verifier accepts exact vacancy href with slug",
          applications_has_id({"hrefs": ["https://getmatch.ru/vacancies/36085-vedushchii-go-razrabotchik?s=my-applications-v"]}, "36085"))
    check("applications verifier rejects title-only body",
          not applications_has_id({"apps": "Java-разработчик (Единые облачные технологии)"}, "36113"))
    check("applications verifier rejects a neighbouring vacancy ID",
          not applications_has_id({"hrefs": ["https://getmatch.ru/vacancies/361130"]}, "36113"))

    # ЧТЕНИЕ ЛОГА ОТ СМЕЩЕНИЯ, а не последними N строками. Окно в 6 строк стояло на грани и
    # выталкивало собственный токен: 2026-08-26 плановый прогон отдал 4 вердикта «маркер проверки
    # не в хвосте лога» на откликах, чей токен в логе БЫЛ. Проверяется на РЕАЛЬНОМ файле, а не на
    # моке: смещение — свойство файла, и мок его не проверяет.
    import tempfile as _tf3
    global DRIVE_LOG
    _dl = DRIVE_LOG
    _td = pathlib.Path(_tf3.mkdtemp(prefix="mesh-getmatch-log-"))
    try:
        DRIVE_LOG = _td / "drive.log"
        DRIVE_LOG.write_text("старая строка\n" * 50, encoding="utf-8")
        mk = log_size()
        with DRIVE_LOG.open("a", encoding="utf-8") as fh:
            fh.write("шум\n" * 20 + "MJAG-ver-999-1 вот он\n" + "ещё шум\n" * 20)
        check("токен виден от смещения даже под 40 строками шума", "MJAG-ver-999-1" in log_since(mk))
        check("...и НЕ виден в окне последних 6 строк (та самая хрупкость)",
              "MJAG-ver-999-1" not in "\n".join(
                  DRIVE_LOG.read_text(encoding="utf-8").splitlines()[-6:]))
        check("строки ДО смещения в чтение не попадают", "старая строка" not in log_since(mk))
    finally:
        DRIVE_LOG = _dl
        import shutil as _sh3
        _sh3.rmtree(_td, ignore_errors=True)

    check("абзацы режутся по пустой строке, а не по переводу строки",
          paragraphs("а\nб\n\nв") == ["а\nб", "в"], repr(paragraphs("а\nб\n\nв")))

    check("getmatch auth preflight rejects redirect from applications",
          getmatch_auth_state("https://getmatch.ru/vacancies", "... Войти ...") == "logged-out")
    check("getmatch auth preflight accepts applications page",
          getmatch_auth_state("https://getmatch.ru/applications", "Мои отклики Выйти") == "ok")
    check("archived vacancy is rejected before the form",
          vacancy_page_state("Вакансия в архиве Компания больше не ищет сотрудника") == "closed")
    check("archived vacancy is machine-dropped, not handed to the operator",
          preflight_outcome("closed") == ("dropped", "вакансия уже в архиве — отклик не отправлялся"))
    check("missing verified letter is machine-dropped, not handed to the operator",
          letter_outcome("") == ("dropped", "проверенное письмо не собралось — вакансия не подходит профилю"))
    check("live vacancy page remains eligible for form probing",
          vacancy_page_state("Откликнуться Senior Go-разработчик") == "open")
    check("city selector with spaces is quoted for the driver parser",
          location_fill_command("Нижний Новгород") ==
          "fill input[placeholder^='Укажите'] Нижний Новгород\nclicktext Нижний Новгород, Россия")

    # Несочиняемые поля: банк молчит -> None, и вызывающий обязан заблокировать отклик.
    #
    # ОЧЕРЕДЬ УВОДИТСЯ В /tmp НА ВРЕМЯ ЭТОЙ НОГИ. `mesh-job-answers --match` на НЕИЗВЕСТНОМ
    # вопросе не только молчит — он ПИШЕТ вопрос в очередь анкеты, и до этой правки моя же
    # тестовая строка «какого цвета ваш зонт в четверг?» оседала в живой questions.tsv при каждом
    # прогоне suite (а suite гоняет mesh-doctor ежечасно) и ушла бы оператору в анкете как
    # настоящий вопрос работодателя. Тест не имеет права писать в артефакт, который человек потом
    # читает как рабочий, — тот же класс, что --test, пишущий durable liveness-лог.
    import tempfile as _tf
    _qd = _tf.mkdtemp(prefix="mesh-getmatch-q-")
    _old_q = os.environ.get("MESH_JOB_QUESTIONS")
    os.environ["MESH_JOB_QUESTIONS"] = os.path.join(_qd, "questions.tsv")
    try:
        check("банк на бессмысленный вопрос отвечает None, а не догадкой",
              bank("какого цвета ваш зонт в четверг?") is None)
        _live_q = pathlib.Path.home() / ".mesh/job/questions.tsv"
        _live_txt = _live_q.read_text(encoding="utf-8") if _live_q.exists() else ""
        check("...и живая очередь анкеты тестом НЕ засорена",
              "зонт в четверг" not in _live_txt)
    finally:
        if _old_q is None:
            os.environ.pop("MESH_JOB_QUESTIONS", None)
        else:
            os.environ["MESH_JOB_QUESTIONS"] = _old_q
        import shutil as _sh2
        _sh2.rmtree(_qd, ignore_errors=True)
    fl = bank("минимальная зарплата")
    print("      живой банк: пол=%s" % (repr(fl)[:60]))

    # РЫЧАГИ ЧИТАЮТСЯ ИЗ ~/.mesh/nodes, а не из os.environ: под кроном окружение пустое, и
    # os.environ-рычаг несёт КОДОВОЕ умолчание в бою и настроенное — в панели ума. Проверяется
    # ПЕРЕ-ЗАПУСКОМ этого же файла в кроновском окружении, а не чтением его текста: проверка,
    # читающая исходник, останется зелёной на туле, который под кроном не стартует вовсе.
    import subprocess as _sp
    probe = _sp.run([sys.executable, os.path.abspath(__file__), "--nodeenv-probe"],
                    env={"HOME": os.path.expanduser("~"), "PATH": "/usr/bin:/bin"},
                    capture_output=True, text=True, timeout=30)
    got = (probe.stdout or "").strip()
    # Утверждается ровно то, что можно: ключ, КОТОРЫЙ ЕСТЬ в ~/.mesh/nodes, обязан быть виден с
    # непустым значением. Ключ, которого там нет, обязан вернуть свой ЯВНЫЙ умолчание — не пустую
    # строку: пустое значение прошло бы «is not None» и тихо стало бы нулевым потолком.
    cap_seen = re.search(r"MESH_JOB_DAILY_CAP=(\S*)", got)
    check("рычаг ИЗ ~/.mesh/nodes виден при ПУСТОМ окружении, как у крона",
          probe.returncode == 0 and cap_seen is not None
          and cap_seen.group(1) not in ("", "MISSING"),
          repr(got[:90]) + " " + (probe.stderr or "")[-120:])
    check("...а ключ, которого в nodes НЕТ, отдаёт свой умолчание, а не пустую строку",
          "MESH_GETMATCH_PROFILE=MISSING" in got, repr(got[:90]))
    print("      cron-env probe: %s" % got[:100])

    import shutil
    for tool in (DRIVE, LETTER, ANSWERS):
        check("сиблинг %s резолвится под PATH крона" % tool, shutil.which(tool) is not None)

    print("smoke-test: %s" % ("ok" if not fails else "FAIL (%s)" % ", ".join(fails)))
    return 1 if fails else 0


def _main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--top", type=int, default=None)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--tg", action="store_true")
    ap.add_argument("--test", action="store_true")
    ap.add_argument("--nodeenv-probe", action="store_true",
                    help="печатает узловые рычаги как их видит этот процесс (для --test под кроновским env)")
    a = ap.parse_args()
    if a.nodeenv_probe:
        print("MESH_JOB_DAILY_CAP=%s MESH_GETMATCH_PROFILE=%s"
              % (node_env("MESH_JOB_DAILY_CAP", "MISSING"), node_env("MESH_GETMATCH_PROFILE", "MISSING")))
        return 0
    if a.test:
        return selftest()
    if not a.dry_run:
        auth_state, auth_detail = getmatch_auth_preflight()
        if auth_state != "ok":
            print("mesh-job-apply-getmatch: n/a — %s" % auth_detail, file=sys.stderr)
            return 2

    floor = bank("минимальная зарплата")
    city = bank("в каком городе вы живете?")
    if not floor:
        print("БЛОКИРОВАНО: банк не знает зарплатный пол — это его факт, не наша догадка. "
              "mesh-job-answers --ask", file=sys.stderr)
        return 2
    floor_n = re.sub(r"[^\d]", "", floor.split("—")[0])[:9] or None
    if not floor_n:
        print("БЛОКИРОВАНО: ответ банка про пол не содержит числа: %r" % floor, file=sys.stderr)
        return 2
    city_s = (city or "").split(",")[0].strip() or None

    sent = sent_today()
    left = None if CAP is None else CAP - sent
    if left is not None and left <= 0:
        print("дневной потолок исчерпан (%d за сегодня, MESH_JOB_DAILY_CAP=%d)" % (sent, CAP))
        return 0

    picked, blocked = eligible(rows())
    limit = a.top if a.top is not None else (len(rows()) if left is None else left)
    picked = picked[:limit]
    print("кандидатов: %d, отсеяно: %d, потолок оставляет: %s" %
          (len(picked), len(blocked), "unlimited" if left is None else left))
    for r, why in blocked[:12]:
        print("  — %-26s %-46s %s" % (r["employer"][:26], r["title"][:46], why))

    results = []
    for r in picked:
        text = letter_for(r)
        state, detail = apply_one(r, floor_n, city_s, dry=a.dry_run)
        print("  %-12s %-24s %s — %s" % (state, r["employer"][:24], r["title"][:44], detail))
        if not a.dry_run:
            record(r, state, detail, text)
        results.append({"id": r["id"], "employer": r["employer"], "title": r["title"],
                        "state": state, "detail": detail})

    ok = [x for x in results if x["state"] == "sent"]
    # Числитель И знаменатель: «0 отправлено» из 6 попыток и из 0 кандидатов — разные предложения.
    print("\nотправлено и ПОДТВЕРЖДЕНО: %d из %d попыток%s"
          % (len(ok), len(results), " (dry-run)" if a.dry_run else ""))
    if a.json:
        print(json.dumps(results, ensure_ascii=False, indent=1))
    if a.tg and ok:
        sh([TG, "getmatch: подано и подтверждено %d — %s" %
            (len(ok), "; ".join("%s / %s" % (x["employer"], x["title"][:40]) for x in ok))], timeout=90)
    return 0


def main():
    # Diagnostics do not drive HH and should not wait behind a live batch.
    if "--test" in sys.argv or "--nodeenv-probe" in sys.argv:
        return _main()
    with hh_driver_lock(HH_LOCK, wait=HH_LOCK_WAIT, mode="getmatch") as (ok, why):
        if not ok:
            print("mesh-job-apply-getmatch: n/a — %s" % why, file=sys.stderr)
            return 2
        return _main()


if __name__ == "__main__":
    sys.exit(main())
