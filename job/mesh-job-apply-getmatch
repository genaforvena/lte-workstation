import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes. The signal is routine here, not hypothetical: GNU
# `timeout` without --foreground puts its child in its OWN PROCESS GROUP and signals the GROUP, so
# every timeout-wrapped call site -- mesh-doctor's hourly --test sweep, mesh-autowire's `timeout 30`
# -- delivers TERM to this process. That is how 950MB of stranded snapshots filled phaedra's /tmp on
# 2026-08-16 with a `finally: rmtree` sitting right there in the source (first fixed in mesh-spend,
# d2fd7c9b). sys.exit() from a handler raises SystemExit in the MAIN THREAD, which is what makes
# try/finally unwind. SIGKILL stays uncatchable -- that half is mesh-tmp-guard's sweep, never this.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))


