def node_env(key, default=""):
    """Читать узловой рычаг из ~/.mesh/nodes, НЕ сорся его.

    cron отдаёт рефлексу пустое окружение — ни BASH_ENV, ни логин-шелла — и никогда не сорсит
    ~/.mesh/nodes. Рычаг, прочитанный из os.environ, поэтому несёт свой КОДОВЫЙ умолчание под
    кроном и настроенное значение в панели ума: два разных поведения под одним именем, и то,
    которое видит человек, — не то, которое работает. mesh-job-apply отказывал на всех 4 из 4
    плановых запусков ровно по этой причине, и e5e1512f прошёлся этим по job-лане; этот тул был
    написан ПОСЛЕ и повторил ту же ошибку, потому что копировал форму os.environ.get.
    Процессное окружение всё ещё побеждает, чтобы вызывающий мог переопределить на один прогон."""
    v = os.environ.get(key)
    if v is not None:
        return v
    try:
        txt = (pathlib.Path.home() / ".mesh" / "nodes").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return default
    hit = None
    for line in txt.splitlines():
        m = re.match(r"\s*(?:export\s+)?%s=[\"']?([^\"'#\s]*)" % re.escape(key), line)
        if m:
            hit = m.group(1)
    return hit if hit is not None else default


