#!/usr/bin/env python3
"""mesh-job-scan-ashby — sweep the Ashby job boards of known orgs and append new seats to the board.

  mesh-job-scan-ashby [--orgs <file>] [--json] [--quiet] [--all-titles]
  mesh-job-scan-ashby --test

# reflex-cadence: 53 6 * * *

Why this exists: Ashby is the ONE application channel measured working end-to-end from this node —
Railway's form took a full application on 2026-08-15 with no login and no mailbox, while every
Greenhouse form parks on an 8-character code mailed to an account the mesh cannot read. Yet the 55
Ashby rows already on the board were fetched by hand, one agent sweep, never repeated — and
demonstrably INCOMPLETE: fal's `Senior/Staff Kubernetes Infrastructure Engineer` (location=Remote,
isRemote=true, a top-4 match) was never on the board at all. A channel that carries the lane deserves
a scanner, not a memory of a sweep.

Reads `https://api.ashbyhq.com/posting-api/job-board/<org>` — the employer's own public feed, no key,
no session. Orgs live in ~/.mesh/job/ashby-orgs.txt, one slug per line, `#` comments ignored.

TWO LOCATION FIELDS, NEVER FOLDED INTO ONE. Ashby publishes `location` (free text) and `isRemote`
(tri-state true/false/absent) and they routinely DISAGREE — the board already carries that trap in
its Stream/Amsterdam row. This scanner writes BOTH verbatim plus a `geo=` verdict that NAMES which
way it was decided:

    AGREE-REMOTE          both say remote AND NO field names a geography — not `location`, not
                          `address.postalAddress.addressCountry`, not `secondaryLocations`
    AGREE-REMOTE-SCOPED   both say remote BUT some field still names a country/region, and the
                          detail says WHICH field named it
    AGREE-ONSITE          both read onsite
    DISAGREE              they contradict — the row is a QUESTION, not a location
    UNSET                 `isRemote` absent; `location` alone. NOT a synonym for false.

An absent `isRemote` rendered as "not remote" would be a fabricated fact about an employer, and the
symmetric error — reading `location="Remote"` as authorisation to work anywhere — is what puts an
application into a seat the candidate cannot legally take. Neither collapse is available here.

REMOTE AND REMOTE-WHERE ARE TWO CLAIMS, and the first production sweep proved how easily they merge:
84 seats came back "both fields agree on remote", and the overwhelming majority of them read
`USA | Remote`, `Remote (US)`, `Remote, Ontario, Canada` — US/Canada-scoped seats, useless to a
candidate in Nizhny Novgorod. The verdict had matched the word `Remote` inside the string and thrown
the country away: the same collapse this tool exists to refuse, committed one level up by the tool
itself. Hence the SCOPED verdict, and hence the geography riding inside the verdict string rather
than in a footnote — a consumer filtering on the verdict alone must not be able to read a US-only
seat as an open one.

An org whose feed does not answer is reported LOUDLY and counted; it never contributes a silent zero
that reads as "this employer has no openings".

Appends to ~/.mesh/job-board.tsv with state `seen`, deduped by the Ashby job UUID — a job already on
the board in ANY state (including one already rejected or applied to) is never resurfaced.
"""
import argparse, json, os, pathlib, re, sys, time, urllib.error, urllib.request

MESH = pathlib.Path(os.path.expanduser("~/.mesh"))
BOARD = MESH / "job-board.tsv"
ORGS = MESH / "job/ashby-orgs.txt"
API = "https://api.ashbyhq.com/posting-api/job-board/%s?includeCompensation=true"
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/126.0.0.0 Safari/537.36")

# Titles worth his time. Deliberately a POSITIVE filter: an Ashby board carries sales, recruiting and
# support seats, and dumping them on the board buries the engineering rows under noise.
TITLE_RE = re.compile(
    r"(engineer|engineering|developer|architect|sre|infrastructure|platform|backend|"
    r"distributed|systems|inference|reliability|tech(nical)? lead|team lead|staff|principal)", re.I)
# ...but never these, whatever else the title says.
TITLE_NOT_RE = re.compile(r"(sales|account executive|recruit|marketing|support engineer|"
                          r"customer|solutions architect|program manager|vendor)", re.I)

DEFAULT_ORGS = ["railway", "primeintellect", "fal-ai", "braintrust", "langfuse", "langchain",
                "modal", "baseten", "temporal", "confluent", "livekit", "e2b", "runpod",
                "openrouter", "restate", "turbopuffer", "lancedb", "inngest", "ollama"]


class FeedError(Exception):
    """An org feed that did not answer. Raised, never swallowed — see the module docstring."""


def fetch(org, timeout=30):
    req = urllib.request.Request(API % org, headers={"User-Agent": UA, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        raise FeedError("HTTP %s" % e.code)
    except Exception as e:                                    # DNS, TLS, timeout, reset
        raise FeedError(type(e).__name__ + ": " + str(e)[:80])
    try:
        return json.loads(body).get("jobs") or []
    except ValueError:
        raise FeedError("feed is not JSON (%d bytes)" % len(body))


REMOTE_WORD_RE = re.compile(r"\b(remote|global|anywhere|worldwide)\b", re.I)


def scope(loc):
    """What GEOGRAPHY does the location string still name once the word 'remote' is removed?

    `remote` and `remote WHERE` are different claims, and the first sweep of this tool proved how
    easily they merge: 84 seats came back "both fields agree on remote", of which the overwhelming
    majority read `USA | Remote`, `Remote (US)`, `Remote, Ontario, Canada` — US/CA-scoped seats a
    candidate in Nizhny Novgorod cannot take. The verdict had matched the word `Remote` inside the
    string and thrown the country away — the SAME collapse this tool exists to refuse, one level up.

    Returns the surviving geography, or "" when the employer named none.
    """
    rest = REMOTE_WORD_RE.sub(" ", loc or "")
    rest = re.sub(r"[(),|/\-–—]+", " ", rest)
    return re.sub(r"\s+", " ", rest).strip()


def elsewhere(job):
    """Every geography the posting names OUTSIDE `location` — the fields this tool used not to read.

    The verdict AGREE-REMOTE is defined as "the location names no geography at all", and consumers
    filter on that verdict alone. But Ashby names the country in two more places, and a seat can be
    `location="Remote"` while `address.postalAddress.addressCountry` says United States. Measured on
    the live board 2026-08-19: of the 11 rows carrying AGREE-REMOTE — the mesh's ONLY "open from
    anywhere" verdict — EIGHT had addressCountry=United States (cursor x4, oscilar x4). The tool was
    not lying: it says "НЕ НАЗВАНА В LOCATION" and that was true. It was reading the wrong field to
    answer the question the verdict is used for, which is the same collapse the docstring above
    refuses one level up.

    Returns a list of (source, geography) pairs; empty when no other field names one.
    """
    out = []
    ac = (((job.get("address") or {}).get("postalAddress") or {}).get("addressCountry") or "").strip()
    if ac:
        out.append(("address", ac))
    for sl in (job.get("secondaryLocations") or []):
        txt = (sl.get("location") or "").strip()
        if not txt:
            txt = (((sl.get("address") or {}).get("postalAddress") or {}).get("addressCountry") or "").strip()
        rest = scope(txt)                       # a secondary "Remote - Canada" names Canada too
        if rest:
            out.append(("secondaryLocations", rest))
    return out


def geo(job):
    """Read EVERY location field and name how the verdict was reached. Never returns a bare bool."""
    loc = (job.get("location") or "").strip()
    rem = job.get("isRemote")                                 # True / False / None(absent)
    loc_says_remote = bool(REMOTE_WORD_RE.search(loc))
    sc = scope(loc)
    other = elsewhere(job)
    if sc:
        where = "география: %s" % sc
    elif other:
        # NOT "не названа" — it was named, just not where this tool used to look. Say which field,
        # so a reader can weigh an HQ-boilerplate country differently from a stated location.
        where = "география НЕ в location, но НАЗВАНА: " + ", ".join(
            "%s (%s)" % (g, src) for src, g in other)
    else:
        where = "география НЕ НАЗВАНА НИ В ОДНОМ поле (location/address/secondaryLocations)"
    if sc and other:
        where += "; ещё: " + ", ".join("%s (%s)" % (g, src) for src, g in other)
    sc = sc or ("|".join(g for _, g in other) if other else "")
    if rem is None:
        return "UNSET", 'location="%s" (%s), isRemote не заполнено' % (loc or "—", where)
    if rem and loc_says_remote:
        # The scope rides IN the verdict, not in a footnote: a consumer filtering on the verdict
        # string alone must not be able to read a US-only seat as an open one.
        return ("AGREE-REMOTE" if not sc else "AGREE-REMOTE-SCOPED",
                'location="%s" + isRemote=true, %s' % (loc, where))
    if (not rem) and (not loc_says_remote):
        return "AGREE-ONSITE", 'location="%s" + isRemote=false, %s' % (loc, where)
    return "DISAGREE", 'location="%s" ПРОТИВ isRemote=%s, %s' % (loc or "—", str(rem).lower(), where)


AUTH_RE = re.compile(r"(visa sponsorship|sponsor\w*|work authoriz\w+|right to work|"
                     r"time ?zone|US only|United States only|EMEA|must be located)", re.I)


def auth_notes(job):
    """Quote what the posting itself says about visa / timezone / location eligibility.

    Silence here is reported as silence — 'ничего не сказано' — never as permission. Absence of a
    stated restriction is not a confirmed right to work, and the two must not read alike.
    """
    text = job.get("descriptionPlain") or ""
    if not text:
        return "тело вакансии пустое в фиде"
    hits = []
    for m in AUTH_RE.finditer(text):
        s = max(0, m.start() - 40)
        frag = re.sub(r"\s+", " ", text[s:m.end() + 60]).strip()
        if frag not in hits:
            hits.append(frag)
    if not hits:
        return "про визу/таймзону/право на работу НЕ СКАЗАНО НИЧЕГО (это не разрешение)"
    return "в тексте: " + " ; ".join(hits[:3])


def money(job):
    c = job.get("compensation") or {}
    for tier in (c.get("compensationTierSummary"), c.get("summaryComponents")):
        if isinstance(tier, str) and tier.strip():
            return tier.strip()
    return "компенсация не опубликована"


def board_ids():
    if not BOARD.exists():
        return set()
    return set(re.findall(r"ashbyhq\.com/[^/\s]+/([0-9a-f-]{16,})",
                          BOARD.read_text(encoding="utf-8"), re.I))


def read_orgs(path):
    p = pathlib.Path(path)
    if not p.exists():
        return list(DEFAULT_ORGS)
    got = [l.strip() for l in p.read_text(encoding="utf-8").splitlines()
           if l.strip() and not l.startswith("#")]
    return got or list(DEFAULT_ORGS)


def sweep(orgs, all_titles=False):
    seen, rows, failed = board_ids(), [], []
    for org in orgs:
        try:
            jobs = fetch(org)
        except FeedError as e:
            failed.append((org, str(e)))
            continue
        for j in jobs:
            url = j.get("jobUrl") or ""
            m = re.search(r"/([0-9a-f-]{16,})\s*$", url, re.I)
            if not m:
                continue
            jid = m.group(1)
            title = (j.get("title") or "").strip()
            if jid in seen:
                continue
            if not all_titles and (not TITLE_RE.search(title) or TITLE_NOT_RE.search(title)):
                continue
            seen.add(jid)
            verdict, detail = geo(j)
            rows.append({"id": jid, "org": org, "company": (j.get("companyName") or org).strip(),
                         "title": title, "url": url, "geo": verdict, "geo_detail": detail,
                         "auth": auth_notes(j), "pay": money(j),
                         "posted": (j.get("publishedAt") or "")[:10]})
    return rows, failed


def append(rows, today):
    lines = []
    for r in rows:
        note = "ashby-scan %s | geo=%s (%s) | %s | %s%s" % (
            today, r["geo"], r["geo_detail"], r["pay"], r["auth"],
            (" | опубликовано " + r["posted"]) if r["posted"] else "")
        lines.append("\t".join([today, r["company"], r["title"], r["url"], "seen",
                                note.replace("\t", " ")]))
    if lines:
        with BOARD.open("a", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    return len(lines)


def selftest():
    rc = 0

    def check(label, cond):
        nonlocal rc
        print(("ok:   " if cond else "FAIL: ") + label)
        if not cond:
            rc = 1

    # --- the whole point of the tool: an absent isRemote is not a false one ---------------------
    v, d = geo({"location": "Remote", "isRemote": None})
    check("absent isRemote renders UNSET, never onsite and never remote", v == "UNSET")
    check("UNSET says out loud that the field was not filled", "не заполнено" in d)
    check("UNSET still carries the location it DOES have", 'location="Remote"' in d)
    v, _ = geo({"location": "Remote", "isRemote": True})
    check("both fields agreeing on remote reads AGREE-REMOTE", v == "AGREE-REMOTE")

    # --- remote and remote-WHERE are two claims (the tool's own first-sweep bug) -----------------
    for loc in ("USA | Remote", "Remote (US)", "Remote, United States", "Remote, Ontario, Canada",
                "Remote - APAC", "Remote, Ireland", "Brazil - Remote", "US - Remote"):
        v, d = geo({"location": loc, "isRemote": True})
        check("a country-scoped remote seat (%r) is SCOPED, not open" % loc,
              v == "AGREE-REMOTE-SCOPED")
        check("...and the verdict itself carries the geography, not a footnote (%r)" % loc,
              "география:" in d and "НЕ НАЗВАНА" not in d)
    v, d = geo({"location": "Remote", "isRemote": True})
    check("a bare 'Remote' names no geography and says so", "НЕ НАЗВАНА" in d)

    # --- the geography Ashby names OUTSIDE `location` (live shape, 2026-08-19) ------------------
    # 8 of the 11 rows on the board wearing AGREE-REMOTE — the ONE verdict meaning "open from
    # anywhere" — carried address.postalAddress.addressCountry="United States" (cursor x4,
    # oscilar x4). The old verdict read `location` alone and rendered that as "НЕ НАЗВАНА".
    v, d = geo({"location": "Remote", "isRemote": True,
                "address": {"postalAddress": {"addressCountry": "United States"}}})
    check("a country named ONLY in address still SCOPES the seat", v == "AGREE-REMOTE-SCOPED")
    check("...and the detail names the FIELD that named it, not just the country",
          "United States" in d and "address" in d and "НЕ НАЗВАНА" not in d)
    v, d = geo({"location": "Remote", "isRemote": True,
                "secondaryLocations": [{"location": "Australia"}]})
    check("a secondary location scopes the seat too", v == "AGREE-REMOTE-SCOPED"
          and "Australia" in d and "secondaryLocations" in d)
    v, d = geo({"location": "Remote", "isRemote": True,
                "secondaryLocations": [{"address": {"postalAddress": {"addressCountry": "Canada"}}}]})
    check("a secondary that carries only an address country is read as well",
          v == "AGREE-REMOTE-SCOPED" and "Canada" in d)
    v, d = geo({"location": "Remote", "isRemote": True})
    check("with NO field naming a geography the seat is still open, and the absence names all "
          "three fields it checked",
          v == "AGREE-REMOTE" and "location/address/secondaryLocations" in d)
    v, d = geo({"location": "USA | Remote", "isRemote": True,
                "address": {"postalAddress": {"addressCountry": "United States"}}})
    check("a location-scoped seat keeps its own geography first and appends the other field",
          v == "AGREE-REMOTE-SCOPED" and d.index("USA") < d.index("United States"))
    check("elsewhere() of a posting with none of those fields is empty, never a guessed country",
          elsewhere({"location": "Remote", "isRemote": True}) == []
          and elsewhere({"address": {}, "secondaryLocations": []}) == [])
    check("scope() strips the remote wording and keeps the country",
          scope("USA | Remote") == "USA" and scope("Remote, Ontario, Canada") == "Ontario Canada")
    check("scope() of a bare remote string is empty, never a guessed country",
          scope("Remote") == "" and scope("Global") == "" and scope("") == "")
    v, _ = geo({"location": "San Francisco", "isRemote": False})
    check("both fields agreeing on onsite reads AGREE-ONSITE", v == "AGREE-ONSITE")
    v, d = geo({"location": "San Francisco", "isRemote": True})
    check("the real Ashby trap (onsite text + isRemote=true) reads DISAGREE", v == "DISAGREE")
    check("DISAGREE prints both sides, so nobody re-derives the fold", "San Francisco" in d and "true" in d)
    v, _ = geo({"location": "Global", "isRemote": True})
    check("'Global' counts as remote wording, like Railway's own postings", v == "AGREE-REMOTE")
    v, _ = geo({"location": "", "isRemote": None})
    check("no location and no flag is still UNSET, not a guess", v == "UNSET")

    # --- silence about work authorisation must not read as permission --------------------------
    check("a posting that says nothing about visas says so explicitly",
          "НЕ СКАЗАНО НИЧЕГО" in auth_notes({"descriptionPlain": "We build things. Go, K8s."}))
    check("an empty body is reported as empty, not as silence about visas",
          auth_notes({"descriptionPlain": ""}) == "тело вакансии пустое в фиде")
    check("a stated sponsorship is quoted back",
          "sponsorship" in auth_notes({"descriptionPlain":
                                       "Perks: Full visa sponsorship and relocation support."}).lower())

    # --- dedupe reads the LIVE board ------------------------------------------------------------
    ids = board_ids()
    check("ashby job ids are parsed out of the live board", len(ids) > 0)
    check("the already-sent Railway application is in the dedupe set",
          "b8072f95-043f-404d-a313-f0bdf8dd3c81" in ids)

    # --- title filter --------------------------------------------------------------------------
    check("an engineering title passes the filter", bool(TITLE_RE.search("Senior Platform Engineer")))
    check("a sales title is rejected even though it says 'Engineer'",
          bool(TITLE_NOT_RE.search("Sales Engineer")))

    # --- a feed that does not answer must RAISE, never return an empty list ---------------------
    try:
        fetch("this-org-does-not-exist-mesh-probe", timeout=15)
        check("a missing org feed raises instead of returning zero jobs", False)
    except FeedError:
        check("a missing org feed raises instead of returning zero jobs", True)
    except Exception:
        print("n/a: no egress — cannot assert the failure path")
        return 2 if rc == 0 else rc

    # --- and the real thing: a live feed with real seats ----------------------------------------
    try:
        jobs = fetch("railway")
    except FeedError as e:
        print("n/a: railway feed unreachable (%s) — live leg not asserted" % e)
        return 2 if rc == 0 else rc
    check("a live Ashby feed returns jobs", len(jobs) > 0)
    check("every live job carries a jobUrl with a uuid",
          all(re.search(r"/[0-9a-f-]{16,}$", j.get("jobUrl") or "") for j in jobs))
    verdicts = {geo(j)[0] for j in jobs}
    check("live feed verdicts are all from the named set, never a bare bool",
          verdicts <= {"AGREE-REMOTE", "AGREE-REMOTE-SCOPED", "AGREE-ONSITE", "DISAGREE", "UNSET"})
    print("      live: %d seat(s) at railway, verdicts %s" % (len(jobs), ",".join(sorted(verdicts))))

    # --- and the population that MOTIVATED the address fix, on the employer's own live feed -----
    try:
        cur = fetch("cursor")
    except FeedError as e:
        print("n/a: cursor feed unreachable (%s) — address leg not asserted live" % e)
        return 2 if rc == 0 else rc
    anchored = [j for j in cur
                if j.get("isRemote") and REMOTE_WORD_RE.search(j.get("location") or "")
                and not scope(j.get("location") or "") and elsewhere(j)]
    check("cursor's live feed still carries remote-looking seats anchored by another field "
          "(the fixture is not the only witness)", len(anchored) > 0)
    check("...and NONE of them wears the open-from-anywhere verdict",
          all(geo(j)[0] == "AGREE-REMOTE-SCOPED" for j in anchored))
    print("      live: %d cursor seat(s) location=Remote but anchored elsewhere, e.g. %s"
          % (len(anchored), (elsewhere(anchored[0])[0][1] if anchored else "—")))
    return rc


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--orgs", default=str(ORGS))
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--all-titles", action="store_true")
    ap.add_argument("--test", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__)
        return 0
    if a.test:
        return selftest()

    orgs = read_orgs(a.orgs)
    rows, failed = sweep(orgs, a.all_titles)
    today = time.strftime("%Y-%m-%d")
    n = append(rows, today)

    if a.json:
        print(json.dumps({"rows": rows, "failed": failed}, ensure_ascii=False, indent=1))
    elif not a.quiet:
        for r in rows:
            print("%-13s %-22s %s" % (r["geo"], r["company"][:22], r["title"][:50]))
        print("\n%d new seat(s) appended from %d org feed(s)" % (n, len(orgs) - len(failed)))
    # Loud, always — a feed that did not answer is not an employer without openings.
    for org, why in failed:
        print("FEED FAILED: %s — %s (counted as UNKNOWN, not as zero openings)" % (org, why),
              file=sys.stderr)
    if failed and not rows:
        return 2                                              # honest n/a: nothing was actually read
    return 0


if __name__ == "__main__":
    sys.exit(main())
