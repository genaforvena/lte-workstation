#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
tool="$repo/scripts/mesh-body-motion"
td=$(mktemp -d)
trap 'rm -rf "$td"' EXIT

mkdir -p "$td/.mesh"
printf '104|[body-still]|2||42|1\n' > "$td/.mesh/.body-motion-state"

fresh=$(HOME="$td" "$tool" --status)
grep -Fqx '104|[body-still]|2||42|1' <<<"$fresh"

printf '|OFFLINE||||\n' > "$td/.mesh/.body-motion-state"
set +e
HOME="$td" "$tool" --status >"$td/offline.out" 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ]
grep -q 'OFFLINE' "$td/offline.out"

printf '104|[body-still]|2||42|1\n' > "$td/.mesh/.body-motion-state"
touch -d '@1' "$td/.mesh/.body-motion-state"
set +e
HOME="$td" "$tool" --status >"$td/stale.out" 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ]
grep -q 'STALE' "$td/stale.out"

echo 'mesh-body-motion status freshness: PASS'
