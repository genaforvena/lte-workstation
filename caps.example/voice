#!/usr/bin/env bash
# EXAMPLE capability — copy to ~/.mesh/caps/<name> on a node that offers it.
#
# voice — speak to the operator (a Telegram voice note + text).
# cap-scope: fungible
#
# A capability is an executable whose FILENAME is its name (operator design 2026-06-21): no
# name->command mapping table — the name IS the command. Invoked via `mesh-organ voice "<text>"`
# from any node; mesh-organ is a PURE router (find the offerer, run this file by its path). The
# secrets/env are sourced HERE, on the provider, and never cross the wire — a consumer sends
# only the name + text args (encapsulation). Drop an executable here + `mesh-card --refresh` and
# the name auto-surfaces onto this node's card (card-declared = any node may invoke).
#
# SCOPE (the `# cap-scope:` header, read passively by the router — never by running this file):
#   bound     (default if header absent) — place-bound: the effect depends on WHICH node runs it
#             (camera/mic/speaker-aloud/light). Address it explicitly as `voice@<node>`.
#   fungible  — placeless: the effect is identical regardless of node (pure compute, egress, or a
#             bridge to ONE external sink like the operator's Telegram chat). The router may pick
#             any offerer / fail over. `voice` is fungible because Telegram is one placeless sink.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
exec mesh-voice-tx "$@"
